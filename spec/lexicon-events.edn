{:kotoba.lexicon-events/version 1
 :status :accepted-design
 :implementation :not-implemented
 :id-profile :kotoba.project-dotted-id/v1
 :naming-spec "kotoba/spec/naming.kotoba"
 :atproto-lexicon-compatible? false
 :authority {:names :kotoba-project
             :schema :content-addressed-contract
             :code :checked-definition-cid
             :admission :existing-grant-and-host
             :canonical-bytes-owner "kotoba-lang/kotoba-protocol"}
 :operations
 {:publish {:effect :event/publish :subject :concrete-only
            :requires [:declared-event :pinned-schema-cid :scope :producer-grant
                       :resource-key :payload-validation :request-id]
            :durable-success :committed-receipt
            :idempotency-key [:scope :producer :request-id]
            :key-content-conflict :reject}
  :subscribe {:effect :event/subscribe
              :requires [:declared-events :pinned-contract-cid :scope :consumer-grant
                         :bounded-filter :bounded-lifetime :bounded-buffer]
              :returns :scoped-subscription-handle}
  :ack {:effect :event/ack :requires [:subscription-grant :committed-processing]}
  :unsubscribe {:effect :event/unsubscribe :requires [:subscription-grant]}}
 :subjects {:separator "." :case-sensitive? true
            :single-token "*" :terminal-one-or-more ">"
            :publish-wildcards? false
            :selection :declared-subjects-intersect-current-grants
            :resource-id :separate-field :field-path :separate-field
            :field-path-profile :kotoba.field-path/v1
            :scope :separate-bound-field}
 :event-envelope
 {:identity [:contract-cid :schema-cid :subject :scope :producer :resource-key
             :payload-cid :causal-parents :action-id]
  :excluded-from-identity [:transport-sequence :cursor :delivery-attempt :signatures]
  :encoding :existing-versioned-canonical-boundary
  :signature-policy :existing-classical-plus-pq-admission
  :value-storage :immutable-content-addressed
  :private-content :existing-owner-scoped-encryption}
 :commit {:derived-events :atomic-state-and-journal-outbox
          :notification :after-commit-retryable
          :transient :explicit-no-durable-claim}
 :delivery {:durable :at-least-once
            :deduplicate-by [:event-cid :action-id]
            :ack-after :consumer-commit
            :business-exactly-once? false
            :order :per-declared-journal-partition
            :global-order? false
            :causality :explicit-parent-cids}
 :resume {:cursor-binds [:stream-epoch :scope :contract-cid :filter-digest :position]
          :authorization :current-grants-including-revocation
          :snapshot :atomic-journal-watermark
          :catch-up :strictly-after-watermark
          :expired :cursor-expired
          :incompatible :cursor-incompatible
          :silent-from-now-fallback? false}
 :limits {:required [:max-payload-bytes :max-buffer-bytes :max-buffer-messages
                     :max-inflight :max-replay-batch :ack-timeout-ms :max-deliveries
                     :subscription-ttl-ms :retention-bytes :retention-ms]
          :overflow :explicit-refusal-or-declared-quarantine
          :silent-durable-drop? false}
 :hosts {:default :local-or-browser
         :nats-jetstream :optional-adapter
         :remote-consent :each-operation
         :remote-operations [:publish :subscribe :reconnect :replay :ack :unsubscribe
                             :create-stream :create-consumer]
         :broker "kotoba.app.client-runtime.v1"
         :broker-source "kotoba-lang/wasm-webcomponent/src/kotoba-client-runtime.js"
         :unsupported-broker-operation :blocked
         :app-origin :static-only}
 :example
 {:id "kotoba.docs.document.changed" :kind :event
  :subject "kotoba.docs.document.changed"
  :field-path ["body" "display.name"]
  :payload-schema {:id "kotoba.docs.documentChange" :cid :required-at-admission}
  :scope-kind :cell :resource-key-type :string
  :publish {:operation-id "kotoba.docs.document.changed.publish" :mode :durable}
  :subscribe {:operation-id "kotoba.docs.document.changed.subscribe"
              :pattern "kotoba.docs.*.changed"
              :filters [:resource-key] :delivery :at-least-once}}
 :open-gates [:signed-subtree-package-release :lexicon-compiler :typed-codegen
              :journal-implementation :host-implementation :canonical-broker-support
              :browser-qualification :transport-qualification :retention-and-replay-soak]}
