;; nbb reads this file. It does NOT read deps.edn, and the
;; .cljs here are run as bare `nbb <file>`, so a coordinate declared only
;; there is invisible to them.
;;
;; :paths and every sha below are COPIED from deps.edn, not chosen here.
{:paths ["src" "resources"]
 :deps {
        io.github.kotoba-lang/lsp {:local/root "lib/kotoba.lsp"}
        io.github.kotoba-lang/lsp-rpc {:local/root "lib/kotoba.lsp.rpc"}
        io.github.kotoba-lang/lint {:local/root "lib/kotoba.lint"}
        io.github.kotoba-lang/lint-kotoba {:local/root "lib/kotoba.lint.kotoba"}
        io.github.kotoba-lang/edn {:local/root "lib/kotoba.edn"}
        io.github.kotoba-lang/async {:local/root "lib/kotoba.async"}
        io.github.kotoba-lang/scheduler {:local/root "lib/kotoba.scheduler"}
        io.github.kotoba-lang/store {:local/root "lib/kotoba.store"}
        io.github.kotoba-lang/fmt {:local/root "lib/kotoba.fmt"}
        io.github.kotoba-lang/log {:local/root "lib/kotoba.log"}
        io.github.kotoba-lang/fs {:local/root "lib/kotoba.fs"}
        io.github.kotoba-lang/time {:local/root "lib/kotoba.time"}
        io.github.kotoba-lang/string {:local/root "lib/kotoba.string"}
        io.github.kotoba-lang/walk {:local/root "lib/kotoba.walk"}
        io.github.kotoba-lang/set {:local/root "lib/kotoba.set"}
        ;; Same portable authority coordinate as deps.edn; no repository-root/JVM graph.
        io.github.kotoba-lang/kotoba-library-import
        {:git/url "https://github.com/kotoba-lang/kotoba-lang.git"
         :deps/root "lib/library-import"
         :git/sha "2c85aa78cacd89301e01bd4816f10932a6a683c8"}
        ;; Standard libraries now live in this repository (kotoba.* IDs).
        io.github.kotoba-lang/spec {:local/root "lib/kotoba.spec"}
        io.github.kotoba-lang/json {:local/root "lib/kotoba.json"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:local/root "lib/kotoba.test"}
        ;; Bundled kotoba.lang.error retains the host exception API.
        io.github.kotoba-lang/error {:local/root "lib/kotoba.error"}
        ;; kotoba.http.form-urlencoded replaced java.net.URLEncoder/URLDecoder here
        ;; (2026-09-24). An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/http-parse-url {:git/sha "8ad2f9680111e50168b4078a64601dc9296158d7"}
        ;; Bundled kotoba.bytes retains the existing host bytes API.
        io.github.kotoba-lang/bytes {:local/root "lib/kotoba.bytes"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:local/root "lib/kotoba.io"}
        ;; kotoba.process replaced clojure.java.shell here (2026-09-24). An explicit
        ;; floor: kotoba.process/sh parses clojure.java.shell's options from db49ea9,
        ;; and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/process {:local/root "lib/kotoba.process"}
        ;; Bundled kotoba.pprint retains the existing printing API.
        io.github.kotoba-lang/pprint {:local/root "lib/kotoba.pprint"}
        ;; Legacy tools.deps coordinate, bundled canonical ID kotoba.coll.
        io.github.kotoba-lang/coll {:local/root "lib/kotoba.coll"}
        ;; Declared HERE and not only in deps.edn: nbb reads nbb.edn and does NOT
        ;; read deps.edn or bb.edn, and the .cljs in this repo are run as
        ;; bare `nbb <file>`. A coordinate they cannot see is not a
        ;; declaration. sha and :paths are COPIED from deps.edn.
        io.github.kotoba-lang/text {:local/root "lib/kotoba.text"}}}
