#!/usr/bin/env nbb
;; bin/kbb_deps.cljk — the tools.deps-shaped door of kbb (ADR-2609112000).
;; kbb-cutover: keep  (this file names the old spellings on purpose)
;;
;; `bin/kbb` execs this on the kbb ENGINE (kotoba-lang/org-babashka-nbb: SCI on
;; Node with `.cljk` classpath resolution) whenever argv looks like a Clojure
;; CLI invocation rather than a `.kotoba` guest:
;;
;;   kbb -M:dev:test [args]      kbb -A:dev -m ns      kbb -X:fmt :k v
;;   kbb -Sdeps '{…}' -M …       kbb -Spath            kbb -Saliases
;;   kbb -m ns | -e expr | -i file | <script.cljk> [args]
;;   #!/usr/bin/env kbb   (a launcher; its project is the nearest deps.edn
;;                         above the script's real path, not the cwd)
;;
;; The owner decision of 2026-09-11 rewrote every `clojure -M…`,
;; `clj -M…`, `bb <task>` and `nbb <script>` in the workspace to `kbb …`
;; textually. This file is what makes those strings name something that RUNS:
;; it reads the repository's `deps.edn` exactly as tools.deps would for the
;; classpath-and-main-opts subset, and hands the result to the engine. It is
;; NOT tools.deps: :git/sha coordinates resolve into the tools.deps ~/.gitlibs
;; cache, but there is no Maven resolution, no JVM, no `-Stree`. The kotoba
;; stdlib is on every classpath implicitly (see `stdlib-deps`). What it cannot answer it
;; refuses BY NAME with exit 64, never by running something else.
;;
;; Resolution, in tools.deps order:
;;   classpath  = :paths (default ["src"]) ∪ every alias's :extra-paths
;;                ∪ the :paths of every :local/root and :git/sha dependency
;;                (recursively) ∪ the implicit kotoba stdlib, last,
;;                an alias's :paths REPLACING the root :paths when present.
;;   versions   = one coordinate per lib, chosen as tools.deps chooses it:
;;                top-level deps win, otherwise the NEWEST (the descendant
;;                sha); see "version selection" below.
;;   main opts  = concatenation of the aliases' :main-opts, then the trailing
;;                command-line args (exactly `clojure -M:alias args`).
;;   -X/-T      = the alias's :exec-fn called with :exec-args merged with the
;;                trailing `:k v` pairs.
;;   test alias = when the main ns is a JVM test runner (cognitect.test-runner,
;;                kaocha.runner, eftest) or the exec-fn is its API, kbb runs
;;                its own: every `*_test.cljk` under the alias's test dirs is
;;                required and `cljs.test/run-tests` decides the exit code.
;;                Those runners do not exist on this engine; this is the
;;                one substitution, and it is named on stderr when it happens.
;;
;; Maven deps, and git deps that could not be resolved, are listed on stderr once (they are not on
;; the classpath) so a later `Could not find namespace` has its cause printed
;; ABOVE it rather than being a mystery.
;;
;; Exit codes: the child's | 64 usage / unsupported flag / unknown alias
;; | 65 a deps.edn that does not read, or two versions of a lib with no
;; ancestor relationship (tools.deps refuses the same graph)
;; | 66 no deps.edn where one was needed.
(ns kbb-deps
  (:require [clojure.edn :as edn]
            [edamame.core :as edamame]
            [kotoba.lang.text :as str]))

(def fs (js/require "fs"))
(def path (js/require "path"))
(def os (js/require "os"))
(def cp (js/require "child_process"))

(defn- die! [code & msg]
  (binding [*print-fn* *print-err-fn*] (apply println "kbb:" msg))
  (.exit js/process code))

(defn- warn! [& msg] (binding [*print-fn* *print-err-fn*] (apply println "kbb:" msg)))

(def engine
  (or (.-KBB_ENGINE (.-env js/process))
      (die! 3 "KBB_ENGINE is not set; run through bin/kbb.")))

(defn- read-edn-file [f]
  (when (.existsSync fs f)
    (try (edn/read-string {:default (fn [_ v] v)} (.readFileSync fs f "utf8"))
         (catch :default e (die! 65 (str f " does not read as EDN: " (.-message e)))))))

;; ---- argv --------------------------------------------------------------

(defn- alias-kws
  "\"-M:dev:test\" -> [:dev :test]; \"-M\" -> []."
  [tok]
  (->> (str/split (subs tok 2) #":") (remove str/blank?) (map keyword) vec))

(defn parse-argv
  "tools.deps flag grammar, the subset kbb answers. Returns
  {:mode :main|:exec|:script|:path|:aliases :aliases [...] :sdeps {...}
   :classpath str|nil :args [...]}."
  [argv]
  ;; -Spath is a flag like the other -S options: `kbb -Spath -M:test` prints
  ;; the :test classpath, as `clojure -Spath -M:test` does. Until 2026-09-24
  ;; it ended parsing, so the aliases after it were silently dropped (the
  ;; amu measurement of that day printed the alias-less classpath).
  (let [r (loop [[a & more :as all] argv acc {:mode nil :aliases [] :args []}]
    (cond
      (nil? a) acc
      (:mode acc) (assoc acc :args (vec all))
      (= a "-Sdeps") (recur (rest more) (assoc acc :sdeps (try (edn/read-string (first more))
                                                                 (catch :default e (die! 64 "-Sdeps is not EDN:" (.-message e))))))
      (= a "-Spath") (recur more (assoc acc :spath? true))
      (= a "-Saliases") (assoc acc :mode :aliases)
      (contains? #{"-Sforce" "-Srepro" "-Sverbose" "-Strace"} a) (recur more acc)
      (= a "-Sthreads") (recur (rest more) acc)
      (contains? #{"-Stree" "-Sdescribe" "-Spom" "-Scp"} a)
      (die! 64 a "is a tools.deps operation with no kbb equivalent (kbb resolves :paths, :local/root and :git/sha; no Maven).")
      (str/starts-with? a "-J") (recur more acc)
      (or (str/starts-with? a "-M") (str/starts-with? a "-A"))
      (recur more (-> acc (assoc :mode :main) (update :aliases into (alias-kws a))))
      (or (str/starts-with? a "-X") (str/starts-with? a "-T"))
      (recur more (-> acc (assoc :mode :exec :tool? (str/starts-with? a "-T")) (update :aliases into (alias-kws a))))
      (contains? #{"-cp" "--classpath"} a) (recur (rest more) (assoc acc :classpath (first more)))
      (contains? #{"-m" "--main" "-e" "-i" "-r"} a) (assoc acc :mode :main :args (vec all))
      (= a "-f") (assoc acc :mode :script :args (vec more))
      (= a "-h") (assoc acc :mode :help)
      (= a "--help") (assoc acc :mode :help)
      (str/starts-with? a "-") (die! 64 "unknown flag" a)
      :else (assoc acc :mode :script :args (vec all))))]
    (if (:spath? r) (assoc r :mode :path) r)))

;; ---- deps.edn ----------------------------------------------------------

(defn- merge-sdeps [deps sdeps]
  (cond-> deps
    (:paths sdeps) (assoc :paths (:paths sdeps))
    (:deps sdeps) (update :deps merge (:deps sdeps))
    (:aliases sdeps) (update :aliases (fn [a] (merge-with merge a (:aliases sdeps))))))

(defn- project-dir-of-script
  "The nearest ancestor of a script's real path that carries a deps.edn --
  the project a `#!/usr/bin/env kbb` launcher belongs to, whatever the
  caller's cwd is. `itonami status` run from $HOME resolves the CLI
  repository's :paths, not $HOME's (measured 2026-09-15: with cwd as the
  project, the launcher's own siblings were off the classpath and the
  sibling repository's deps.edn was read instead). nil when the script
  does not exist or no ancestor carries a deps.edn."
  [script]
  (when (and script (.existsSync fs script))
    (loop [d (.dirname path (.realpathSync fs script))]
      (cond (.existsSync fs (.join path d "deps.edn")) d
            (= d (.dirname path d)) nil
            :else (recur (.dirname path d))))))

;; ---- git coordinates ---------------------------------------------------
;;
;; A `:git/sha` coordinate is resolved the way tools.deps resolves it, into the
;; SAME cache tools.deps uses, so a JVM run and a kbb run of one repository
;; share checkouts instead of fetching twice:
;;
;;   ~/.gitlibs/_repos/<https|ssh>/<host>/<org>/<repo>   mirror clone
;;   ~/.gitlibs/libs/<group>/<artifact>/<full-sha>       detached worktree
;;
;; ($GITLIBS overrides the root, as it does for tools.deps.) An existing
;; `libs/…/<sha>` directory is used without touching git or the network, so a
;; warm cache works offline. A coordinate that cannot be resolved (no sha, no
;; derivable url, clone/fetch failed, sha not in the repository) is reported
;; with its reason on stderr and left off the classpath -- never silently.
;;
;; Until 2026-09-23 this door resolved :local/root only and told every repo to
;; declare git deps in nbb.edn, where the engine resolves them by shelling out
;; to babashka. Measured that day: kotoba-lang/shinkansen's suite was green
;; (174 tests) and went red with `Could not find namespace: kotoba.lang.text`
;; after its deps.edn gained the kotoba-lang/text coordinate -- the
;; declaration was correct and this door could not see it.

(def gitlibs (or (.-GITLIBS (.-env js/process)) (.join path (.homedir os) ".gitlibs")))

(defn- git [& args]
  (let [r (.spawnSync cp "git" (clj->js args) #js {:encoding "utf8"})]
    {:exit (.-status r) :out (str/trim (or (.-stdout r) "")) :err (str/trim (or (.-stderr r) ""))}))

(defn- git-url
  "The coordinate's :git/url, or the one tools.deps infers from an
  io.github / com.github / io.gitlab / com.gitlab lib name."
  [lib coord]
  (or (:git/url coord)
      (let [g (namespace lib) a (name lib)]
        (some (fn [[prefix host]]
                (when (and g (str/starts-with? g prefix))
                  (str "https://" host "/" (subs g (count prefix)) "/" a ".git")))
              [["io.github." "github.com"] ["com.github." "github.com"]
               ["io.gitlab." "gitlab.com"] ["com.gitlab." "gitlab.com"]]))))

(defn- mirror-dir
  "tools.deps' _repos path for a url: https://h/o/r(.git) and git@h:o/r(.git)."
  [url]
  (let [u (str/replace url #"\.git$" "")]
    (if-let [[_ host p] (re-find #"^git@([^:]+):(.+)$" u)]
      (.join path gitlibs "_repos" "ssh" host p)
      (if-let [[_ proto more] (re-find #"^([a-z]+)://(.+)$" u)]
        (.join path gitlibs "_repos" proto more)
        (.join path gitlibs "_repos" "file" (str/replace u #"^/" ""))))))

(defn- full-sha [repo sha]
  (let [r (git "--git-dir" repo "rev-parse" "--verify" "--quiet" (str sha "^{commit}"))]
    (when (and (zero? (:exit r)) (re-find #"^[0-9a-f]{40}$" (:out r))) (:out r))))

(defn- coord-sha
  "The coordinate's sha: :git/sha, or the unqualified :sha that tools.deps
  still accepts as its deprecated spelling (tools.gitlibs reads both).
  Until 2026-09-24 this door read :git/sha only, so a deps.edn written as
  `io.github.kotoba-lang/ed25519 {:sha \"fdcefb9f...\"}` -- valid for
  `clojure -M:test` -- left the lib off the classpath, and the run died as
  `Could not find namespace: ed25519.core` (measured that day on
  kotoba-lang/denrei, teian and goyoukiki in a 120-repository sample)."
  [coord]
  (or (:git/sha coord) (:sha coord)))

(defn- mirror-with!
  "The mirror clone of url holding every sha in shas (full or abbreviated),
  cloned / fetched once when needed: {:repo r :fulls [full…]} or {:error reason}."
  [url shas]
  (let [repo (mirror-dir url)
        cloned (or (.existsSync fs repo)
                   (do (.mkdirSync fs (.dirname path repo) #js {:recursive true})
                       (zero? (:exit (git "clone" "--quiet" "--mirror" url repo)))))
        fulls (fn [] (mapv #(full-sha repo %) shas))
        fs1 (when cloned (fulls))
        fs2 (if (and cloned (some nil? fs1))
              (do (git "--git-dir" repo "fetch" "--quiet" "origin") (fulls))
              fs1)]
    (cond
      (not cloned) {:error (str "could not clone " url)}
      (some nil? fs2) {:error (str "sha " (first (keep (fn [[s f]] (when-not f s)) (map vector shas fs2)))
                                   " is not in " url)}
      :else {:repo repo :fulls fs2})))

(defn- git-lib-dir
  "{:dir d :sha full-sha} for a git coordinate, or {:error reason}."
  [lib coord]
  (let [sha (coord-sha coord)
        url (git-url lib coord)
        libs-dir (fn [s] (.join path gitlibs "libs" (or (namespace lib) (name lib)) (name lib) s))
        sub (fn [d] (if-let [r (:deps/root coord)] (.join path d r) d))]
    (cond
      (not (string? sha)) {:error "no :git/sha"}
      (and (= 40 (count sha)) (.existsSync fs (libs-dir sha))) {:dir (sub (libs-dir sha)) :sha sha}
      (nil? url) {:error "no :git/url, and the lib name implies none"}
      :else
      (let [{:keys [repo fulls error]} (mirror-with! url [sha])
            full (first fulls)]
        (cond
          error {:error error}
          :else
          (let [d (libs-dir full)]
            (when-not (.existsSync fs d)
              (.mkdirSync fs (.dirname path d) #js {:recursive true})
              (git "--git-dir" repo "worktree" "add" "--force" "--detach" d full))
            (if (.existsSync fs d)
              {:dir (sub d) :sha full}
              {:error (str "could not check out " full " of " url)})))))))

;; ---- :local/root coordinates -------------------------------------------
;;
;; Workspace repositories name their siblings as `:local/root
;; "../../kotoba-lang/langgraph"`: correct inside the west checkout
;; (orgs/<org>/<repo>/../../kotoba-lang/langgraph), absent in a fresh clone made
;; anywhere else. Until 2026-09-24 this door put the nonexistent directory on
;; the classpath without a word, and the run died later as
;; `Could not find namespace: langgraph.graph` -- measured that day on 30 of a
;; 150-repository random sample of the suites the clojure.test codemod refused
;; as red-before (fresh clones outside the superproject).
;;
;; A :local/root that does not exist is now answered the way the directory
;; would have been inside the workspace: the west sibling checkout next to this
;; kbb (see `west-siblings`: the declared ../../<org>/<repo> re-anchored under
;; orgs/, then orgs/<org>/<name> for an io.github.<org>/<name> lib) --
;; the same place the implicit stdlib and the engine come from -- and that
;; substitution is named on stderr. When there is no such sibling it is an
;; error with its reason (left off the classpath, printed), never silence.

(def workspace-orgs
  "orgs/ of the west checkout this kbb lives in (KBB_STDLIB_ROOT's parent when set)."
  ;; resolved: bin/kbb hands over KBB_STDLIB_ROOT as "<kbb home>/..", and the
  ;; dirname of an unnormalised path is not its parent
  (.dirname path (.resolve path (or (.-KBB_STDLIB_ROOT (.-env js/process))
                                    (.resolve path (.dirname path (.realpathSync fs *file*)) ".." "..")))))

(defn west-siblings
  "Candidate west sibling directories for a :local/root, in order:
  1. the declared path re-anchored at a repository inside orgs/ -- a
     `../../<org>/<repo>` path names orgs/<org>/<repo> whatever the lib is
     called (renamed libs keep old names: io.github.com-junkawasaki/langgraph-clj
     still points at ../../kotoba-lang/langgraph);
  2. orgs/<org>/<name> for an io.github.<org>/<name> or com.github.<org>/<name> lib.
  Only directories under orgs/ are candidates."
  [lib local-root]
  (let [g (namespace lib)
        anchored (.resolve path workspace-orgs "_org" "_repo" local-root)
        by-name (when-let [org (some #(when (and g (str/starts-with? g %)) (subs g (count %))) ["io.github." "com.github."])]
                  (.join path workspace-orgs org (name lib)))]
    (vec (distinct (filter #(and % (str/starts-with? % (str workspace-orgs "/"))
                                 (not (str/includes? % "/_org/")))
                           [anchored by-name])))))

(defn- local-root-dir
  "{:dir d} or {:error reason} for a :local/root coordinate (see above)."
  [lib coord base seen]
  (let [d (.resolve path base (:local/root coord))
        sibs (west-siblings lib (:local/root coord))
        sib (some #(when (.existsSync fs %) %) sibs)]
    (cond
      (.existsSync fs d) {:dir d}
      sib (do (swap! seen update :substituted conj [lib (:local/root coord) sib]) {:dir sib})
      :else {:error (str ":local/root " (pr-str (:local/root coord)) " does not exist (" d ")"
                         (if (seq sibs) (str " and no west sibling at " (str/join " or " sibs)) ", and no west sibling is implied"))})))

;; ---- version selection: newest wins, as in tools.deps ------------------
;;
;; Until 2026-09-24 the FIRST coordinate this door met for a lib won, depth
;; first, and every later one was dropped (KBB_DEPS_VERBOSE=1 listed them).
;; tools.deps does not do that, and the two disagreed where it hurts: measured
;; that day, amu's `kbb -Spath -M:test` put osaho a54916bc (met first, deep in
;; a transitive subtree; it lacks kotoba.kir.alpha-normalization) on the
;; classpath and dropped the 85ed11be amu itself declares.
;;
;; The expansion below is tools.deps' `expand-deps` / `include-coord?`
;; (clojure/tools.deps src/main/clojure/clojure/tools/deps.clj), breadth first:
;;   - a top-level dep (the project's :deps merged with the aliases'
;;     :extra-deps / :deps / :replace-deps, a later alias winning, as
;;     tools.deps merges them) is selected and every transitive coordinate
;;     of that lib is omitted (:use-top);
;;   - a transitive lib takes the NEWER of two coordinates. For :git/sha that
;;     is the descendant: `git merge-base --is-ancestor` in the ~/.gitlibs
;;     mirror (extensions/git.clj `compare-versions`, via tools.gitlibs
;;     `descendant`). When neither sha is an ancestor of the other tools.deps
;;     throws "No known ancestor relationship between git versions for <lib>";
;;     so does this door (exit 65, both shas and urls named) -- the fix is
;;     the one tools.deps asks for: pin the lib at top level;
;;   - switching a lib to a newer version deselects the children only the old
;;     version brought in, and a lib whose parent path is no longer selected
;;     is not considered (`deselect-orphans`, `parent-missing?`);
;;   - :override-deps replaces a lib's coordinate wherever it appears.
;; Where kbb differs, on purpose (tools.deps would throw "Unable to compare
;; versions" for mixed coordinate types):
;;   - a :local/root is a working copy and dominates any :git/sha or Maven
;;     coordinate of the same lib; two DIFFERENT :local/root directories are
;;     ambiguous (tools.deps' local.clj throws there too) and exit 65;
;;   - a :git/sha dominates a Maven coordinate (a jar cannot load here);
;;   - a coordinate that cannot be resolved never displaces one that was.
;; Ancestry answers are facts about two immutable commits, so they are cached
;; in $GITLIBS/_kbb/ancestry/<sha>-<sha> (the warm path is an existsSync, no
;; git spawn). KBB_DEPS_VERBOSE=1 prints every choice: "<lib> kept <coord>
;; ignored <coord> (<reason>)".
;;
;; The classpath ORDER is unchanged: the project's paths, then each selected
;; lib depth first in declaration order, then the implicit stdlib.

(defn- ident
  "The identity of a coordinate, cheap: no checkout. {:lib :coord :type :id
  :url [:sha] [:dir] [:error]}. A 40-character :git/sha is its own identity;
  an abbreviated one is resolved (and checked out) the way it always was."
  [lib coord base seen]
  (let [sha (coord-sha coord)]
    (cond
      (:local/root coord)
      (let [{:keys [dir error]} (local-root-dir lib coord base seen)]
        {:lib lib :coord coord :type :local :id (if dir [:local dir] [:error (pr-str coord)]) :dir dir :error error})

      (string? sha)
      (let [url (git-url lib coord)
            r (when-not (= 40 (count sha)) (git-lib-dir lib coord))
            full (if (= 40 (count sha)) sha (:sha r))]
        (cond-> {:lib lib :coord coord :type :git :url url :sha full
                 :id (if full [:git full (:deps/root coord)] [:error (pr-str coord)])}
          (:dir r) (assoc :dir (:dir r))
          (:error r) (assoc :error (:error r))))

      (:mvn/version coord) {:lib lib :coord coord :type :mvn :id [:mvn (:mvn/version coord)]}
      :else {:lib lib :coord coord :type :other :id [:other (pr-str coord)]})))

(defn- realize!
  "The node with its checkout, :paths and :children ([lib coord] in declaration
  order, relative to its own directory), memoized by identity."
  [node seen]
  (or (get-in @seen [:realized (:id node)])
      (let [{:keys [dir error]} (cond
                                  (or (:dir node) (:error node)) node
                                  (= :git (:type node)) (git-lib-dir (:lib node) (:coord node))
                                  :else nil)
            d (when dir (read-edn-file (.join path dir "deps.edn")))
            n (cond-> (assoc node :dir dir :error error)
                dir (assoc :paths (or (:paths d) ["src"]) :children (vec (:deps d))))]
        (swap! seen assoc-in [:realized (:id node)] n)
        n)))

(def ^:private ancestry-dir (.join path gitlibs "_kbb" "ancestry"))

(defn- descendant
  "Which of shas a, b (full) descends from the other in url's repository:
  a | b | :none (neither), or {:error reason} when it could not be measured."
  [url a b]
  (let [cache (.join path ancestry-dir (str/join "-" (sort [a b])))]
    (if (.existsSync fs cache)
      (let [v (str/trim (.readFileSync fs cache "utf8"))] (if (= v "none") :none v))
      (let [{:keys [repo error]} (mirror-with! url [a b])
            anc? (fn [x y] (:exit (git "--git-dir" repo "merge-base" "--is-ancestor" x y)))]
        (if error
          {:error error}
          (let [ab (anc? a b)
                ba (when (= 1 ab) (anc? b a))
                v (cond (zero? ab) b
                        (and (= 1 ab) (zero? ba)) a
                        (and (= 1 ab) (= 1 ba)) :none
                        :else nil)]
            (if (nil? v)
              {:error (str "git merge-base --is-ancestor failed in " repo)}
              (do (.mkdirSync fs ancestry-dir #js {:recursive true})
                  (.writeFileSync fs cache (if (= v :none) "none" v))
                  v))))))))

(defn- compare-nodes
  "Is `new` newer than `old` (the selected one)? :newer | :older | :same |
  {:ambiguous msg} | {:unmeasured msg}. See the rules above."
  [lib new old]
  (let [tn (:type new) to (:type old)]
    (cond
      (= (:id new) (:id old)) :same
      (:error new) :older
      (:error old) :newer
      (and (= :git tn) (= :git to))
      (if (= (:sha new) (:sha old))
        :same
        (let [urls (distinct (remove nil? [(:url old) (:url new)]))
              answers (map #(descendant % (:sha new) (:sha old)) urls)
              answer (cond (empty? urls) {:error "no :git/url to compare in"}
                           (some map? answers) (first (filter map? answers))
                           (apply = answers) (first answers)
                           :else :none)]
          (cond
            (map? answer) {:unmeasured (str "cannot compare git versions of " lib ": " (:error answer))}
            (= answer :none)
            {:ambiguous (str "No known ancestor relationship between git versions for " lib "\n"
                             "  " (:url old) " at " (:sha old) "\n"
                             "  " (:url new) " at " (:sha new))}
            (= answer (:sha new)) :newer
            :else :older)))
      (and (= :local tn) (= :local to))
      {:ambiguous (str "No known ancestor relationship between local versions for " lib ": "
                       (:dir old) " and " (:dir new))}
      (= :local tn) :newer
      (= :local to) :older
      (and (= :git tn) (= :mvn to)) :newer
      :else :older)))

(defn- parent-missing?
  "tools.deps `parent-missing?`: is any lib on this parent path no longer
  selected by the path it was reached through?"
  [vmap parent-path]
  (loop [p parent-path more nil]
    (if (seq p)
      (let [lib (peek p)
            check (pop p)
            {:keys [paths select]} (get vmap lib)
            to-selected (get paths select)]
        (if (contains? to-selected check)
          (recur check (concat more (remove #(= % check) to-selected)))
          (if (seq more) (recur (first more) (rest more)) true)))
      false)))

(defn- deselect-orphans
  "tools.deps `deselect-orphans`: deselect every lib whose selected version is
  reached only through the omitted paths."
  [vmap omitted]
  (reduce-kv (fn [ret lib {:keys [select paths]}]
               (let [lib-paths (get paths select)]
                 (if (and select (every? (fn [p] (some #(= (seq %) (seq (take (count %) p))) omitted)) lib-paths))
                   (update ret lib dissoc :select)
                   ret)))
             vmap vmap))

(defn- add-version [vmap node parents]
  (-> vmap
      (assoc-in [(:lib node) :versions (:id node)] node)
      (update-in [(:lib node) :paths (:id node)] (fnil conj #{}) parents)))

(defn- selected [vmap lib] (get-in vmap [lib :versions (get-in vmap [lib :select])]))

(defn- expand!
  "tools.deps' breadth-first expansion. tops: [[lib coord base]…], all
  top-level. Returns the version map {lib {:select id :versions {id node}
  :paths {id #{parent-path}} :top bool}}; choices go to (:conflicts @seen),
  ambiguities to (:ambiguous @seen)."
  [tops overrides seen]
  (loop [q (mapv (fn [[lib coord base]] [[] lib coord base]) tops)
         i 0
         vmap {}]
    (if (>= i (count q))
      vmap
      (let [[parents lib coord base] (nth q i)
            coord (get overrides lib coord)
            k [lib coord base]
            node (or (get-in @seen [:idents k])
                     (let [nd (ident lib coord base seen)] (swap! seen assoc-in [:idents k] nd) nd))
            sel (selected vmap lib)
            conflict! (fn [kept ignored why]
                        (swap! seen update :conflicts (fnil conj []) [lib (:coord kept) (:coord ignored) why]))
            [include vmap']
            (cond
              (empty? parents)
              [true (-> vmap (add-version node parents) (update lib assoc :select (:id node) :top true))]

              (get-in vmap [lib :top])
              (do (when (and sel (not= (:id sel) (:id node))) (conflict! sel node "top-level"))
                  [false vmap])

              (parent-missing? vmap parents) [false vmap]

              (nil? sel)
              [true (-> vmap (add-version node parents) (update lib assoc :select (:id node)))]

              (= (:id sel) (:id node)) [false (add-version vmap node parents)]

              :else
              (let [c (compare-nodes lib node sel)]
                (cond
                  (= c :newer)
                  (do (conflict! node sel "newer")
                      [true (-> vmap
                                (add-version node parents)
                                (deselect-orphans (set (map #(conj % lib) (get-in vmap [lib :paths (:id sel)]))))
                                (update lib assoc :select (:id node)))])
                  (= c :same) [false vmap]
                  (:ambiguous c) (do (swap! seen update :ambiguous (fnil conj []) (:ambiguous c)) [false vmap])
                  (:unmeasured c) (do (swap! seen update :unmeasured (fnil conj []) [lib (:unmeasured c)])
                                      (conflict! sel node "kept: newer-ness could not be measured")
                                      [false vmap])
                  :else (do (conflict! sel node "older") [false vmap]))))
            q' (if include
                 (let [n (realize! node seen)]
                   (into q (map (fn [[l c]] [(conj parents lib) l c (:dir n)]) (:children n))))
                 q)]
        (recur q' (inc i) vmap')))))

(defn- dep-paths
  "Classpath contribution of the selected libs, relative to cwd, depth first
  from `tops` in order (each [lib coord base]). Records on `seen`:
  :dirs/:order (checkout directories, in order), :missing (Maven and other
  unloadable coordinates, [lib phase]), :errors ([lib reason], for selected
  coordinates that did not resolve). `phases` tags each top so the caller can
  tell the project's missing deps from the stdlib's."
  [vmap tops phases seen]
  (let [visited (atom #{})
        acc (atom [])]
    (letfn [(visit [lib phase]
              (when-let [sel (and (not (contains? @visited lib)) (selected vmap lib))]
                (swap! visited conj lib)
                (let [n (realize! sel seen)]
                  (cond
                    (:error n) (swap! seen update :errors conj [lib (:error n)])
                    (nil? (:dir n)) (swap! seen update :missing conj [lib phase])
                    (contains? (:dirs @seen) (:dir n)) nil
                    :else
                    (do (swap! seen #(-> % (update :dirs conj (:dir n)) (update :order (fnil conj []) (:dir n))))
                        (swap! acc into (map #(.relative path (.cwd js/process) (.join path (:dir n) %)) (:paths n)))
                        (doseq [[l _] (:children n)] (visit l phase)))))))]
      (doseq [[[lib] phase] (map vector tops phases)] (visit lib phase))
      @acc)))

(defn- ordered-merge
  "Merge [lib coord] maps left to right, a later coordinate replacing an
  earlier one in place (the order of first appearance is kept)."
  [maps]
  (reduce (fn [acc [lib coord]]
            (if-let [i (first (keep-indexed (fn [i [l]] (when (= l lib) i)) acc))]
              (assoc acc i [lib coord])
              (conj acc [lib coord])))
          [] (apply concat maps)))

;; ---- the kotoba standard library, on every classpath -------------------
;;
;; `clojure.string` needs no declaration: it is part of the host. Its
;; replacement `kotoba.lang.text` did, so every repository that moved off
;; clojure.* had to name a coordinate, and a repository with no project file
;; at all (run as bare `kbb run_tests.cljk`) had nowhere to name it. Measured
;; 2026-09-23: 249 of 381 repositories still requiring clojure.string were
;; refused by the migration for exactly that reason. The stdlib is therefore
;; IMPLICIT, the way the host's own namespaces are: each repository below is
;; appended to the END of the classpath from the west sibling checkout next to
;; this kbb (orgs/kotoba-lang/<repo>, the same place the engine is found), with
;; its own deps resolved as above. The stdlib libs are TOP-level deps of the
;; expansion (see `stdlib-deps`): a sibling beats any transitive coordinate
;; of the same lib, a project that declares one of them itself keeps its own
;; pin -- the implicit entry is skipped for that lib -- and anything the
;; project puts on the classpath is found first.
;;
;; KBB_NO_STDLIB=1 turns it off; KBB_STDLIB_ROOT points at another directory
;; holding the same sibling layout. A sibling that is not checked out is named
;; on stderr, never skipped silently.

(def stdlib-repos
  "orgs/kotoba-lang/<repo> for the namespaces the stdlib router (ADR-2609040930)
  routes clojure.* / java.* to."
  ;; dependency order: a lib is listed before the stdlib libs that depend on it
  ;; (the classpath order of the tail; which VERSION resolves is `stdlib-deps`)
  ["text" "edn" "spec" "coll" "test" "io" "fs" "process" "bytes" "json" "http" "pprint"])

(def stdlib-root
  (.resolve path (or (.-KBB_STDLIB_ROOT (.-env js/process))
                     (.resolve path (.dirname path (.realpathSync fs *file*)) ".." ".."))))

(defn- stdlib-deps
  "The implicit deps, as ordered [lib coord] pairs (a map would lose the
  order above), minus libs the project names at TOP level (`project-tops`,
  a set of libs). They join the expansion as top-level deps themselves, so a
  stdlib sibling wins over any TRANSITIVE coordinate of the same lib (tools.deps'
  :use-top) -- decided 2026-09-24: the sibling is the west-pinned working copy
  every other stdlib namespace was checked out against, and a stale transitive
  pin of kotoba-lang/text must not replace it. A project that wants another
  version pins it in its own :deps, and that pin wins."
  [project-tops seen]
  (when-not (= "1" (.-KBB_NO_STDLIB (.-env js/process)))
    (vec (keep (fn [r]
                 (let [lib (symbol "io.github.kotoba-lang" r)
                       dir (.join path stdlib-root r)]
                   (cond
                     (contains? project-tops lib) nil
                     (.existsSync fs dir) [lib {:local/root dir}]
                     :else (do (swap! seen update :errors conj [lib (str "stdlib sibling not checked out at " dir)]) nil))))
               stdlib-repos))))

(defn- new-seen [] (atom {:dirs #{} :missing [] :errors [] :conflicts [] :ambiguous [] :unmeasured []}))

;; ---- the other two doors: `kbb --classpath cp` and `kbb --backend sci` ----
;;
;; Until 2026-09-24 the stdlib reached only the deps.edn door: `kbb --classpath
;; cp script` (the -cp branch below) took the caller's classpath verbatim, and
;; `kbb --backend sci [--classpath cp] script` -- bin/kbb execs the engine
;; directly, hundreds of root hooks use it -- never came through this file.
;; Both now get the same implicit stdlib, AFTER everything the caller names:
;; it is handed to the engine as KBB_CLASSPATH_TAIL, which the engine appends
;; after --classpath, the cwd default and nbb.edn (org-babashka-nbb api.cljs).
;;
;; The sci door must stay cheap, so bin/kbb does not resolve it per run: it
;; asks `kbb_deps.cljk --stdlib-path` once and caches the answer (see bin/kbb
;; `stdlib_tail`). That answer is five lines:
;;   1 the KBB_STDLIB_ROOT it was computed for, verbatim
;;   2 the absolute classpath entries, ':'-joined
;;   3 the stdlib repositories that were present
;;   4 the stdlib repositories that were absent
;;   5 the resolution problems, '; '-joined (bin/kbb prints them every run)

(defn- stdlib-classpath
  "[absolute-entries errors] for the implicit stdlib alone. An ambiguity
  inside the stdlib's own closure is an error line here, not an exit: this
  answer is cached for hundreds of hooks, which keep the version met first."
  []
  (let [seen (new-seen)
        tops (mapv (fn [[l c]] [l c stdlib-root]) (stdlib-deps #{} seen))
        vmap (expand! tops {} seen)
        entries (dep-paths vmap tops (repeat :stdlib) seen)]
    [(vec (distinct (map #(.resolve path %) entries)))
     (vec (distinct (concat (:errors @seen)
                            (map (fn [m] ['stdlib m]) (:ambiguous @seen))
                            (:unmeasured @seen))))]))

(defn- print-stdlib-path!
  "The `--stdlib-path` answer described above."
  []
  (let [[entries errors] (stdlib-classpath)
        present (filter #(.existsSync fs (.join path stdlib-root %)) stdlib-repos)
        absent (remove (set present) stdlib-repos)]
    (println (or (.-KBB_STDLIB_ROOT (.-env js/process)) stdlib-root))
    (println (str/join ":" entries))
    (println (str/join " " present))
    (println (str/join " " absent))
    (println (str/join "; " (map (fn [[lib why]] (str lib " is NOT on the classpath: " (str/replace (str why) #"\n\s*" " "))) errors)))
    (.exit js/process 0)))

(defn resolve-classpath
  "[classpath-vector missing-libs root-dirs]. root-dirs is every directory a
  classpath root came from -- the project, then each :local/root / :git/sha /
  stdlib dependency in resolution order (see `npm-node-path!`). Every
  classpath entry is relative to cwd (what the
  engine's --classpath takes); `project` is the directory deps.edn's own
  relative paths are relative to -- cwd for the CLI-shaped doors, the
  script's project for a launcher (see `project-dir-of-script`)."
  ([deps aliases] (resolve-classpath deps aliases (.cwd js/process)))
  ([deps aliases project]
   (let [cwd (.cwd js/process)
         alias-maps (map #(get-in deps [:aliases %]) aliases)
         root-paths (or (some :paths (reverse alias-maps)) (:paths deps) ["src"])
         extra (mapcat :extra-paths alias-maps)
         seen (new-seen)
         project-tops (ordered-merge (cons (:deps deps) (map #(merge (:extra-deps %) (:deps %) (:replace-deps %)) alias-maps)))
         overrides (apply merge (map :override-deps alias-maps))
         std (stdlib-deps (set (map first project-tops)) seen)
         tops (vec (concat (map (fn [[l c]] [l c project]) project-tops)
                           (map (fn [[l c]] [l c stdlib-root]) std)))
         vmap (expand! tops overrides seen)
         entries (dep-paths vmap tops (concat (repeat (count project-tops) :project) (repeat :stdlib)) seen)]
     (doseq [[lib why] (distinct (:errors @seen))]
       (warn! (str lib) "is NOT on the classpath:" why))
     (doseq [[lib declared sib] (distinct (:substituted @seen))]
       (warn! (str lib) ":local/root" (pr-str declared) "does not exist here; using the west sibling checkout" sib))
     (doseq [[_ why] (distinct (:unmeasured @seen))]
       (warn! why))
     (when (= "1" (.-KBB_DEPS_VERBOSE (.-env js/process)))
       (doseq [[lib kept ignored why] (distinct (:conflicts @seen))]
         (warn! (str lib) "kept" (pr-str kept) "ignored" (pr-str ignored) (str "(" why ")"))))
     (when-let [amb (seq (distinct (:ambiguous @seen)))]
       (doseq [m amb] (warn! m))
       (die! 65 (count amb) "lib(s) have versions with no ancestor relationship; tools.deps refuses the same graph. Pin each at top level in deps.edn."))
     [(vec (distinct (concat (map #(.relative path cwd (.join path project %)) (concat root-paths extra))
                             entries)))
      ;; the stdlib's own Maven coordinates (http-kit behind kotoba.http's
      ;; :clj branch) are not the project's missing deps
      (vec (distinct (keep (fn [[lib phase]] (when (= phase :project) lib)) (:missing @seen))))
      (vec (distinct (cons (.resolve path project) (map #(.resolve path %) (:order @seen)))))])))

;; ---- npm modules of the classpath roots ---------------------------------
;;
;; A .cljk namespace may `(:require ["@noble/hashes/sha2.js" …])`, and the
;; repository that holds it declares that module in its own package.json
;; (kotoba-lang/io-multiformats declares @noble/hashes). Until 2026-09-24
;; nothing installed a DEPENDENCY's npm modules -- a :git/sha dep lands in
;; ~/.gitlibs/libs/<lib>/<sha> with no node_modules -- and the engine resolves
;; a module name upward from the file it was started on, which for the test
;; substitution is a runner in the temp dir, so not even the project's own
;; node_modules was found. Measured that day: 77 of the suites the clojure.test
;; codemod refused as red-before died with `Cannot find module '@noble/…'` in
;; a fresh clone.
;;
;; So, before the engine starts, every classpath root directory whose
;; package.json declares "dependencies" gets its node_modules:
;;   ~/.gitlibs/libs/<lib>/<sha>  immutable: installed once, remembered by
;;                                node_modules/.kbb-npm-installed (the warm
;;                                path is an existsSync, never an npm spawn)
;;   anything else (the project,  installed only when node_modules is ABSENT;
;;   :local/root, west siblings)  a present one is the owner's and is used as is
;; with `npm ci` when the directory has its own lockfile (ci never rewrites
;; it), else `npm install --no-package-lock` (no lockfile is created), both
;; --omit=dev --no-audit --no-fund --ignore-scripts. An npm failure is printed
;; with its reason and the run continues -- the module error, if any, follows
;; with its cause printed above it. Every root's existing node_modules is then
;; put on NODE_PATH (after any NODE_PATH the caller set), which the engine's
;; CommonJS fallback resolver honours whatever file it was started on.
;; KBB_NO_NPM=1 turns off both the install and the NODE_PATH entries.

(def npm-marker ".kbb-npm-installed")

(defn- npm-dependencies
  "The \"dependencies\" map of dir/package.json, or nil."
  [dir]
  (let [pj (.join path dir "package.json")]
    (when (.existsSync fs pj)
      (try (let [d (.-dependencies (js/JSON.parse (.readFileSync fs pj "utf8")))]
             (when (and d (pos? (.-length (js/Object.keys d)))) d))
           (catch :default e
             (warn! "npm:" pj "is not readable JSON:" (.-message e) "-- not installing its modules")
             nil)))))

(defn- gitlib-dir? [dir]
  (str/starts-with? dir (str (.resolve path gitlibs "libs") "/")))

(defn- npm! [dir args]
  (let [t0 (js/Date.now)
        r (.spawnSync cp "npm" (clj->js args) #js {:cwd dir :encoding "utf8" :stdio #js ["ignore" "pipe" "pipe"]})]
    {:ok? (zero? (.-status r))
     :ms (- (js/Date.now) t0)
     :why (or (some-> (.-error r) .-message)
              (let [lines (remove str/blank? (str/split (str (.-stderr r)) #"\n"))]
                (str/join " | " (take-last 3 lines))))}))

(defn- npm-install!
  "Installs dir's npm dependencies if this door owns doing so (see above)."
  [dir]
  (when-let [ds (npm-dependencies dir)]
    (let [nm (.join path dir "node_modules")
          marker (.join path nm npm-marker)
          immutable? (gitlib-dir? dir)]
      (when (if immutable? (not (.existsSync fs marker)) (not (.existsSync fs nm)))
        (let [flags ["--omit=dev" "--no-audit" "--no-fund" "--ignore-scripts"]
              lock? (some #(.existsSync fs (.join path dir %)) ["package-lock.json" "npm-shrinkwrap.json"])
              r (or (when lock?
                      (let [r (npm! dir (into ["ci"] flags))]
                        (when (:ok? r) r)))
                    (npm! dir (into ["install" "--no-package-lock"] flags)))]
          (if (:ok? r)
            (do (when immutable? (.writeFileSync fs marker (str (js/JSON.stringify ds) "\n")))
                (warn! "npm: installed" (.-length (js/Object.keys ds)) "dependenc(ies) of" dir "in" (str (:ms r) " ms")))
            (warn! "npm: install FAILED in" dir (str "(" (:why r) ");") "continuing without its modules")))))))

(defn npm-node-path!
  "The NODE_PATH for the engine: the caller's, then every root's node_modules,
  after installing what `npm-install!` owns. nil when KBB_NO_NPM=1."
  [roots]
  (when-not (= "1" (.-KBB_NO_NPM (.-env js/process)))
    (doseq [d roots] (npm-install! d))
    (let [ours (filter #(.existsSync fs %) (map #(.join path % "node_modules") roots))
          theirs (remove str/blank? (str/split (or (.-NODE_PATH (.-env js/process)) "") #":"))]
      (when (seq ours) (str/join ":" (distinct (concat theirs ours)))))))

(defn- unknown-aliases [deps aliases]
  (remove #(contains? (:aliases deps) %) aliases))

;; ---- test runner substitution -----------------------------------------

(def jvm-test-runners
  #{"cognitect.test-runner" "kaocha.runner" "eftest.runner" "lambdaisland.kaocha"
    "clojure.test.runner" "circleci.test"})

(def jvm-test-exec-fns
  #{"cognitect.test-runner.api/test" "kaocha.runner/exec-fn" "kaocha.runner/run"})

;; The namespace a test file is required as is the one its `(ns …)` form
;; DECLARES. Until 2026-09-24 it was derived from the path (dirs -> dots,
;; `_` -> `-`), which is only the munge convention, not a law: a file at
;; test/ntp_time/main_test.cljk declaring `(ns ntp_time.main-test …)` (several
;; com-* repositories) was required as ntp-time.main-test; the engine found the
;; same file by munging, loaded it, and the run died with
;; "No namespace: ntp-time.main-test found". The path is now only the
;; fallback for a file with no readable ns form, and that is named on stderr.

(defn declared-ns
  "The symbol a file's first form `(ns <sym> …)` declares, or nil when the
  file does not read or does not start with an ns form."
  [f]
  (try
    (let [src (str/replace (.readFileSync fs f "utf8") #"^#![^\n]*" "")
          form (edamame/parse-string src {:all true :read-cond :allow :features #{:cljs}
                                          :auto-resolve (fn [a] (if (= :current a) 'user a))})]
      (when (and (seq? form) (= 'ns (first form)) (symbol? (second form)))
        (second form)))
    (catch :default _ nil)))

(defn- ns-of-file [dir f]
  (or (declared-ns f)
      (let [derived (-> (.relative path dir f)
                        (str/replace #"\.(cljk|cljc|cljs|clj)$" "")
                        (str/replace "/" ".")
                        (str/replace "_" "-"))]
        (warn! f "has no readable (ns …) form; requiring it as" derived "(derived from its path)")
        derived)))

(defn- test-files [dir]
  (let [out (atom [])]
    (letfn [(walk [d]
              (doseq [e (.readdirSync fs d #js {:withFileTypes true})]
                (let [p (.join path d (.-name e))]
                  (cond (.isDirectory e) (when-not (contains? #{"node_modules" ".git" "target"} (.-name e)) (walk p))
                        (re-find #"_test\.(cljk|cljc|cljs|clj)$" (.-name e)) (swap! out conj p)))))]
      (when (.existsSync fs dir) (walk dir)))
    @out))

(defn- test-runner-source
  "A script that requires every test ns and lets cljs.test decide the exit."
  [nses]
  (str "(ns kbb-test-run (:require [cljs.test]))\n"
       "(defmethod cljs.test/report [:cljs.test/default :end-run-tests] [m]\n"
       "  (println (str \"kbb test: \" (:test m) \" test(s), \" (:pass m) \" pass, \" (:fail m) \" fail, \" (:error m) \" error\"))\n"
       "  (.exit js/process (if (cljs.test/successful? m) 0 1)))\n"
       (str/join "\n" (map #(str "(require '" % ")") nses)) "\n"
       (if (seq nses)
         (str "(cljs.test/run-tests " (str/join " " (map #(str "'" %) nses)) ")\n")
         "(println \"kbb test: 0 test namespace(s) found\") (.exit js/process 1)\n")))

(defn- test-run-plan
  "Given the alias maps, the test dirs and -n / -d options, the namespaces to run."
  [alias-maps args]
  (let [opts (loop [[a & more] args m {:dirs [] :nses []}]
               (cond (nil? a) m
                     (= a "-d") (recur (rest more) (update m :dirs conj (first more)))
                     (= a "-n") (recur (rest more) (update m :nses conj (first more)))
                     :else (recur more m)))
        dirs (or (seq (:dirs opts))
                 (seq (filter #(.existsSync fs %) (mapcat :extra-paths alias-maps)))
                 ["test"])
        nses (or (seq (:nses opts))
                 (for [d dirs f (test-files d)] (ns-of-file d f)))]
    {:dirs dirs :nses (vec (distinct nses))}))

;; ---- run ---------------------------------------------------------------

(defn- exec-engine!
  "Runs the engine and exits with its status. `config?` points the engine at
  the project's nbb.edn explicitly: the engine finds nbb.edn by walking UP
  FROM THE SCRIPT PATH, so a runner written to the temp dir would otherwise
  see none of the project's :deps (measured 2026-09-11)."
  [classpath engine-args & [{:keys [config? tail node-path]}]]
  (let [nbb-edn (.join path (.cwd js/process) "nbb.edn")
        env (doto (js/Object.assign #js {} (.-env js/process) #js {:KBB_CLASSPATH_TAIL (str/join ":" tail)})
              ;; bin/kbb's hand-over to THIS process; not the script's to inherit
              (js-delete "KBB_STDLIB_PRECOMPUTED")
              (js-delete "KBB_STDLIB_CLASSPATH"))
        _ (when node-path (aset env "NODE_PATH" node-path))
        r (.spawnSync cp "node" (clj->js (concat [engine]
                                                 (when (seq classpath) ["--classpath" (str/join ":" classpath)])
                                                 (when (and config? (.existsSync fs nbb-edn)) ["--config" nbb-edn])
                                                 engine-args))
                      #js {:stdio "inherit" :env env})]
    (.exit js/process (or (.-status r) 1))))

(defn- run-test-substitute!
  "`exec!` is -main's engine launcher (it carries the stdlib tail and NODE_PATH)."
  [exec! classpath alias-maps args]
  (let [{:keys [dirs nses]} (test-run-plan alias-maps args)
        tmp (.join path (.tmpdir os) (str "kbb-test-" (.-pid js/process) ".cljk"))]
    (warn! "test runner substitution: running" (count nses) "namespace(s) under" (pr-str dirs) "with cljs.test (the JVM runner named by the alias does not exist on this engine)")
    (.writeFileSync fs tmp (test-runner-source nses))
    (exec! (vec (distinct (concat classpath dirs))) [tmp] {:config? true})))

(defn -main [argv]
  (when (= "--stdlib-path" (first argv)) (print-stdlib-path!))
  (let [{:keys [mode aliases sdeps classpath args tool?]} (parse-argv argv)
        cwd (.cwd js/process)
        project (or (when (= mode :script) (project-dir-of-script (first args))) cwd)
        deps-file (.join path project "deps.edn")
        deps (merge-sdeps (or (read-edn-file deps-file) {}) sdeps)]
    (when (= mode :help)
      (println "kbb -M[:alias…] [args] | -X[:alias] [:k v…] | -Spath | -Saliases | -Sdeps '{…}' | -m ns | -e expr | <script.cljk> [args]")
      (.exit js/process 0))
    (when (and (seq aliases) (not (.existsSync fs deps-file)) (nil? sdeps))
      (die! 66 "no deps.edn in" cwd "— aliases" (pr-str aliases) "cannot be resolved here."))
    (when-let [u (seq (unknown-aliases deps aliases))]
      (die! 64 "alias" (pr-str (vec u)) "is not declared in" deps-file
            (str "(declared: " (pr-str (vec (keys (:aliases deps)))) ")")))
    (let [alias-maps (map #(get-in deps [:aliases %]) aliases)
          [cp-vec missing roots] (if classpath [(str/split classpath #":") [] [(.resolve path project)]] (resolve-classpath deps aliases project))
          ;; -cp: the caller's classpath verbatim, the stdlib after it (see
          ;; `stdlib-classpath`); the deps.edn door already carries it in cp-vec
          ;; bin/kbb hands over its cached answer (already warned about) as
          ;; KBB_STDLIB_CLASSPATH; resolved here only when called some other way
          tail (when classpath
                 (if (= "1" (.-KBB_STDLIB_PRECOMPUTED (.-env js/process)))
                   (vec (remove str/blank? (str/split (or (.-KBB_STDLIB_CLASSPATH (.-env js/process)) "") #":")))
                   (let [[entries errors] (stdlib-classpath)]
                     (doseq [[lib why] errors] (warn! (str lib) "is NOT on the classpath:" why))
                     entries)))
          exec-engine! (fn [cpv args & [opts]] (exec-engine! cpv args (assoc opts :tail tail :node-path (npm-node-path! roots))))]
      ;; org.clojure/clojure and clojurescript are the engine itself, not a
      ;; coordinate it could be missing; naming them warned on every run of
      ;; every launcher whose deps.edn pins Clojure for the linter.
      (when-let [missing (seq (remove (into #{'org.clojure/clojure 'org.clojure/clojurescript}
                                            (keys (:deps (read-edn-file (.join path project "nbb.edn")))))
                                      missing))]
        (warn! (count missing) "dep(s) are not :local/root and are NOT on the classpath (kbb resolves :local/root and :git/sha coordinates, not Maven; a jar cannot load on this engine):" (str/join ", " (map str missing))))
      (case mode
        :path (do (println (str/join ":" cp-vec)) (.exit js/process 0))
        :aliases (do (doseq [[k v] (sort-by key (:aliases deps))]
                       (println (name k) (cond (:main-opts v) (str "-M " (str/join " " (:main-opts v)))
                                               (:exec-fn v) (str "-X " (:exec-fn v))
                                               :else "(paths/deps only)")))
                     (.exit js/process 0))
        :script (exec-engine! cp-vec args)
        :exec (let [exec-fn (some :exec-fn (reverse alias-maps))
                    exec-args (apply merge (map :exec-args alias-maps))
                    kv (apply hash-map (map edn/read-string args))]
                (when-not exec-fn (die! 64 "-X/-T: no :exec-fn in aliases" (pr-str aliases)))
                (if (contains? jvm-test-exec-fns (str exec-fn))
                  (run-test-substitute! exec-engine! cp-vec alias-maps (mapcat (fn [[k v]] (case k :dirs (mapcat #(vector "-d" (str %)) v) :nses (mapcat #(vector "-n" (str %)) v) [])) (merge exec-args kv)))
                  (let [ns-sym (symbol (namespace exec-fn))
                        form (str "(require '" ns-sym ") (" exec-fn " " (pr-str (merge exec-args kv)) ")")]
                    (exec-engine! cp-vec ["-e" form]))))
        :main (let [main-opts (vec (concat (mapcat :main-opts alias-maps) args))
                    [flag v & rest-opts] main-opts]
                (cond
                  (and (contains? #{"-m" "--main"} flag) (contains? jvm-test-runners v))
                  (run-test-substitute! exec-engine! cp-vec alias-maps rest-opts)

                  (empty? main-opts)
                  (if (seq aliases)
                    (die! 64 "aliases" (pr-str aliases) "declare no :main-opts; nothing to run (this is a classpath-only alias — pass -m <ns> or a script).")
                    (exec-engine! cp-vec []))

                  (= flag "-i") (exec-engine! cp-vec (into [v] rest-opts))
                  (= flag "-r") (exec-engine! cp-vec [])
                  :else (exec-engine! cp-vec main-opts)))
        (die! 64 "nothing to run; see kbb --help")))))

(-main (vec *command-line-args*))
