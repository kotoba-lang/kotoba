#!/usr/bin/env nbb
;; bin/kbb_deps.cljk — the tools.deps-shaped door of kbb (ADR-2609112000).
;; kbb-cutover: keep  (this file names the old spellings on purpose)
;;
;; `bin/kbb` execs this on the kbb ENGINE (kotoba-lang/org-babashka-nbb: SCI on
;; Node with `.cljk` classpath resolution) whenever argv looks like a Clojure
;; CLI invocation rather than a `.kotoba` guest:
;;
;;   kbb -M:dev:test [args]      kbb -A:dev -m ns      kbb -X:fmt :k v
;;   kbb -Sdeps '{…}' -M …       kbb -Spath            kbb -Saliases
;;   kbb -m ns | -e expr | -i file | <script.cljk> [args]
;;   #!/usr/bin/env kbb   (a launcher; its project is the nearest deps.edn
;;                         above the script's real path, not the cwd)
;;
;; The owner decision of 2026-09-11 rewrote every `clojure -M…`,
;; `clj -M…`, `bb <task>` and `nbb <script>` in the workspace to `kbb …`
;; textually. This file is what makes those strings name something that RUNS:
;; it reads the repository's `deps.edn` exactly as tools.deps would for the
;; classpath-and-main-opts subset, and hands the result to the engine. It is
;; NOT tools.deps: :git/sha coordinates resolve into the tools.deps ~/.gitlibs
;; cache, but there is no Maven resolution, no JVM, no `-Stree`. The kotoba
;; stdlib is on every classpath implicitly (see `stdlib-deps`). What it cannot answer it
;; refuses BY NAME with exit 64, never by running something else.
;;
;; Resolution, in tools.deps order:
;;   classpath  = :paths (default ["src"]) ∪ every alias's :extra-paths
;;                ∪ the :paths of every :local/root and :git/sha dependency
;;                (recursively) ∪ the implicit kotoba stdlib, last,
;;                an alias's :paths REPLACING the root :paths when present.
;;   main opts  = concatenation of the aliases' :main-opts, then the trailing
;;                command-line args (exactly `clojure -M:alias args`).
;;   -X/-T      = the alias's :exec-fn called with :exec-args merged with the
;;                trailing `:k v` pairs.
;;   test alias = when the main ns is a JVM test runner (cognitect.test-runner,
;;                kaocha.runner, eftest) or the exec-fn is its API, kbb runs
;;                its own: every `*_test.cljk` under the alias's test dirs is
;;                required and `cljs.test/run-tests` decides the exit code.
;;                Those runners do not exist on this engine; this is the
;;                one substitution, and it is named on stderr when it happens.
;;
;; Maven deps, and git deps that could not be resolved, are listed on stderr once (they are not on
;; the classpath) so a later `Could not find namespace` has its cause printed
;; ABOVE it rather than being a mystery.
;;
;; Exit codes: the child's | 64 usage / unsupported flag / unknown alias
;; | 66 no deps.edn where one was needed.
(ns kbb-deps
  (:require [clojure.edn :as edn]
            [kotoba.lang.text :as str]))

(def fs (js/require "fs"))
(def path (js/require "path"))
(def os (js/require "os"))
(def cp (js/require "child_process"))

(defn- die! [code & msg]
  (binding [*print-fn* *print-err-fn*] (apply println "kbb:" msg))
  (.exit js/process code))

(defn- warn! [& msg] (binding [*print-fn* *print-err-fn*] (apply println "kbb:" msg)))

(def engine
  (or (.-KBB_ENGINE (.-env js/process))
      (die! 3 "KBB_ENGINE is not set; run through bin/kbb.")))

(defn- read-edn-file [f]
  (when (.existsSync fs f)
    (try (edn/read-string {:default (fn [_ v] v)} (.readFileSync fs f "utf8"))
         (catch :default e (die! 65 (str f " does not read as EDN: " (.-message e)))))))

;; ---- argv --------------------------------------------------------------

(defn- alias-kws
  "\"-M:dev:test\" -> [:dev :test]; \"-M\" -> []."
  [tok]
  (->> (str/split (subs tok 2) #":") (remove str/blank?) (map keyword) vec))

(defn parse-argv
  "tools.deps flag grammar, the subset kbb answers. Returns
  {:mode :main|:exec|:script|:path|:aliases :aliases [...] :sdeps {...}
   :classpath str|nil :args [...]}."
  [argv]
  (loop [[a & more :as all] argv acc {:mode nil :aliases [] :args []}]
    (cond
      (nil? a) acc
      (:mode acc) (assoc acc :args (vec all))
      (= a "-Sdeps") (recur (rest more) (assoc acc :sdeps (try (edn/read-string (first more))
                                                                 (catch :default e (die! 64 "-Sdeps is not EDN:" (.-message e))))))
      (= a "-Spath") (assoc acc :mode :path :args (vec more))
      (= a "-Saliases") (assoc acc :mode :aliases)
      (contains? #{"-Sforce" "-Srepro" "-Sverbose" "-Strace"} a) (recur more acc)
      (= a "-Sthreads") (recur (rest more) acc)
      (contains? #{"-Stree" "-Sdescribe" "-Spom" "-Scp"} a)
      (die! 64 a "is a tools.deps operation with no kbb equivalent (kbb resolves :paths, :local/root and :git/sha; no Maven).")
      (str/starts-with? a "-J") (recur more acc)
      (or (str/starts-with? a "-M") (str/starts-with? a "-A"))
      (recur more (-> acc (assoc :mode :main) (update :aliases into (alias-kws a))))
      (or (str/starts-with? a "-X") (str/starts-with? a "-T"))
      (recur more (-> acc (assoc :mode :exec :tool? (str/starts-with? a "-T")) (update :aliases into (alias-kws a))))
      (contains? #{"-cp" "--classpath"} a) (recur (rest more) (assoc acc :classpath (first more)))
      (contains? #{"-m" "--main" "-e" "-i" "-r"} a) (assoc acc :mode :main :args (vec all))
      (= a "-f") (assoc acc :mode :script :args (vec more))
      (= a "-h") (assoc acc :mode :help)
      (= a "--help") (assoc acc :mode :help)
      (str/starts-with? a "-") (die! 64 "unknown flag" a)
      :else (assoc acc :mode :script :args (vec all)))))

;; ---- deps.edn ----------------------------------------------------------

(defn- merge-sdeps [deps sdeps]
  (cond-> deps
    (:paths sdeps) (assoc :paths (:paths sdeps))
    (:deps sdeps) (update :deps merge (:deps sdeps))
    (:aliases sdeps) (update :aliases (fn [a] (merge-with merge a (:aliases sdeps))))))

(defn- project-dir-of-script
  "The nearest ancestor of a script's real path that carries a deps.edn --
  the project a `#!/usr/bin/env kbb` launcher belongs to, whatever the
  caller's cwd is. `itonami status` run from $HOME resolves the CLI
  repository's :paths, not $HOME's (measured 2026-09-15: with cwd as the
  project, the launcher's own siblings were off the classpath and the
  sibling repository's deps.edn was read instead). nil when the script
  does not exist or no ancestor carries a deps.edn."
  [script]
  (when (and script (.existsSync fs script))
    (loop [d (.dirname path (.realpathSync fs script))]
      (cond (.existsSync fs (.join path d "deps.edn")) d
            (= d (.dirname path d)) nil
            :else (recur (.dirname path d))))))

;; ---- git coordinates ---------------------------------------------------
;;
;; A `:git/sha` coordinate is resolved the way tools.deps resolves it, into the
;; SAME cache tools.deps uses, so a JVM run and a kbb run of one repository
;; share checkouts instead of fetching twice:
;;
;;   ~/.gitlibs/_repos/<https|ssh>/<host>/<org>/<repo>   mirror clone
;;   ~/.gitlibs/libs/<group>/<artifact>/<full-sha>       detached worktree
;;
;; ($GITLIBS overrides the root, as it does for tools.deps.) An existing
;; `libs/…/<sha>` directory is used without touching git or the network, so a
;; warm cache works offline. A coordinate that cannot be resolved (no sha, no
;; derivable url, clone/fetch failed, sha not in the repository) is reported
;; with its reason on stderr and left off the classpath -- never silently.
;;
;; Until 2026-09-23 this door resolved :local/root only and told every repo to
;; declare git deps in nbb.edn, where the engine resolves them by shelling out
;; to babashka. Measured that day: kotoba-lang/shinkansen's suite was green
;; (174 tests) and went red with `Could not find namespace: kotoba.lang.text`
;; after its deps.edn gained the kotoba-lang/text coordinate -- the
;; declaration was correct and this door could not see it.

(def gitlibs (or (.-GITLIBS (.-env js/process)) (.join path (.homedir os) ".gitlibs")))

(defn- git [& args]
  (let [r (.spawnSync cp "git" (clj->js args) #js {:encoding "utf8"})]
    {:exit (.-status r) :out (str/trim (or (.-stdout r) "")) :err (str/trim (or (.-stderr r) ""))}))

(defn- git-url
  "The coordinate's :git/url, or the one tools.deps infers from an
  io.github / com.github / io.gitlab / com.gitlab lib name."
  [lib coord]
  (or (:git/url coord)
      (let [g (namespace lib) a (name lib)]
        (some (fn [[prefix host]]
                (when (and g (str/starts-with? g prefix))
                  (str "https://" host "/" (subs g (count prefix)) "/" a ".git")))
              [["io.github." "github.com"] ["com.github." "github.com"]
               ["io.gitlab." "gitlab.com"] ["com.gitlab." "gitlab.com"]]))))

(defn- mirror-dir
  "tools.deps' _repos path for a url: https://h/o/r(.git) and git@h:o/r(.git)."
  [url]
  (let [u (str/replace url #"\.git$" "")]
    (if-let [[_ host p] (re-find #"^git@([^:]+):(.+)$" u)]
      (.join path gitlibs "_repos" "ssh" host p)
      (if-let [[_ proto more] (re-find #"^([a-z]+)://(.+)$" u)]
        (.join path gitlibs "_repos" proto more)
        (.join path gitlibs "_repos" "file" (str/replace u #"^/" ""))))))

(defn- full-sha [repo sha]
  (let [r (git "--git-dir" repo "rev-parse" "--verify" "--quiet" (str sha "^{commit}"))]
    (when (and (zero? (:exit r)) (re-find #"^[0-9a-f]{40}$" (:out r))) (:out r))))

(defn- git-lib-dir
  "{:dir d} for a git coordinate, or {:error reason}."
  [lib coord]
  (let [sha (:git/sha coord)
        url (git-url lib coord)
        libs-dir (fn [s] (.join path gitlibs "libs" (or (namespace lib) (name lib)) (name lib) s))
        sub (fn [d] (if-let [r (:deps/root coord)] (.join path d r) d))]
    (cond
      (not (string? sha)) {:error "no :git/sha"}
      (and (= 40 (count sha)) (.existsSync fs (libs-dir sha))) {:dir (sub (libs-dir sha))}
      (nil? url) {:error "no :git/url, and the lib name implies none"}
      :else
      (let [repo (mirror-dir url)
            cloned (or (.existsSync fs repo)
                       (do (.mkdirSync fs (.dirname path repo) #js {:recursive true})
                           (zero? (:exit (git "clone" "--quiet" "--mirror" url repo)))))
            full (when cloned (or (full-sha repo sha)
                                  (do (git "--git-dir" repo "fetch" "--quiet" "origin")
                                      (full-sha repo sha))))]
        (cond
          (not cloned) {:error (str "could not clone " url)}
          (nil? full) {:error (str "sha " sha " is not in " url)}
          :else
          (let [d (libs-dir full)]
            (when-not (.existsSync fs d)
              (.mkdirSync fs (.dirname path d) #js {:recursive true})
              (git "--git-dir" repo "worktree" "add" "--force" "--detach" d full))
            (if (.existsSync fs d)
              {:dir (sub d)}
              {:error (str "could not check out " full " of " url)})))))))

;; ---- :local/root coordinates -------------------------------------------
;;
;; Workspace repositories name their siblings as `:local/root
;; "../../kotoba-lang/langgraph"`: correct inside the west checkout
;; (orgs/<org>/<repo>/../../kotoba-lang/langgraph), absent in a fresh clone made
;; anywhere else. Until 2026-09-24 this door put the nonexistent directory on
;; the classpath without a word, and the run died later as
;; `Could not find namespace: langgraph.graph` -- measured that day on 30 of a
;; 150-repository random sample of the suites the clojure.test codemod refused
;; as red-before (fresh clones outside the superproject).
;;
;; A :local/root that does not exist is now answered the way the directory
;; would have been inside the workspace: the west sibling checkout next to this
;; kbb, orgs/<org>/<name> for an io.github.<org>/<name> (or com.github.) lib --
;; the same place the implicit stdlib and the engine come from -- and that
;; substitution is named on stderr. When there is no such sibling it is an
;; error with its reason (left off the classpath, printed), never silence.

(def workspace-orgs
  "orgs/ of the west checkout this kbb lives in (KBB_STDLIB_ROOT's parent when set)."
  (.dirname path (or (.-KBB_STDLIB_ROOT (.-env js/process))
                     (.resolve path (.dirname path (.realpathSync fs *file*)) ".." ".."))))

(defn west-sibling
  "orgs/<org>/<name> for io.github.<org>/<name> or com.github.<org>/<name>, else nil."
  [lib]
  (let [g (namespace lib)]
    (when-let [org (some #(when (and g (str/starts-with? g %)) (subs g (count %))) ["io.github." "com.github."])]
      (.join path workspace-orgs org (name lib)))))

(defn- local-root-dir
  "{:dir d} or {:error reason} for a :local/root coordinate (see above)."
  [lib coord base seen]
  (let [d (.resolve path base (:local/root coord))
        sib (west-sibling lib)]
    (cond
      (.existsSync fs d) {:dir d}
      (and sib (.existsSync fs sib))
      (do (swap! seen update :substituted conj [lib (:local/root coord) sib]) {:dir sib})
      :else {:error (str ":local/root " (pr-str (:local/root coord)) " does not exist (" d ")"
                         (if sib (str " and no west sibling at " sib) ", and the lib name implies no west sibling"))})))

(defn- dep-paths
  "Classpath contribution of :local/root and :git/sha deps, recursively,
  relative to cwd. The first coordinate seen for a lib wins (the project's own
  deps.edn is read first, so its pins win over transitive ones); a later,
  different coordinate for the same lib is recorded under :conflicts
  (printed with KBB_DEPS_VERBOSE=1), not merged. Maven coordinates are
  collected as :missing -- the engine cannot load a jar.
  `seen` is an atom {:dirs #{} :libs {} :missing [] :errors [] :conflicts []}."
  [deps-map base seen]
  (reduce (fn [acc [lib coord]]
            (let [prior (get-in @seen [:libs lib])]
              (cond
                (and prior (not= prior coord)) (do (swap! seen update :conflicts conj [lib prior coord]) acc)
                prior acc
                :else
                (let [_ (swap! seen assoc-in [:libs lib] coord)
                      {:keys [dir error]} (cond
                                            (:local/root coord) (local-root-dir lib coord base seen)
                                            (:git/sha coord) (git-lib-dir lib coord)
                                            :else nil)]
                  (cond
                    error (do (swap! seen update :errors conj [lib error]) acc)
                    (nil? dir) (do (swap! seen update :missing conj lib) acc)
                    (contains? (:dirs @seen) dir) acc
                    :else
                    (do (swap! seen update :dirs conj dir)
                        (let [d (read-edn-file (.join path dir "deps.edn"))
                              ps (or (:paths d) ["src"])]
                          (into (into acc (map #(.relative path (.cwd js/process) (.join path dir %)) ps))
                                (dep-paths (:deps d) dir seen)))))))))
          [] deps-map))

;; ---- the kotoba standard library, on every classpath -------------------
;;
;; `clojure.string` needs no declaration: it is part of the host. Its
;; replacement `kotoba.lang.text` did, so every repository that moved off
;; clojure.* had to name a coordinate, and a repository with no project file
;; at all (run as bare `kbb run_tests.cljk`) had nowhere to name it. Measured
;; 2026-09-23: 249 of 381 repositories still requiring clojure.string were
;; refused by the migration for exactly that reason. The stdlib is therefore
;; IMPLICIT, the way the host's own namespaces are: each repository below is
;; appended to the END of the classpath from the west sibling checkout next to
;; this kbb (orgs/kotoba-lang/<repo>, the same place the engine is found), with
;; its own deps resolved as above. A project that declares one of them itself
;; keeps its own pin -- the implicit entry is skipped for that lib -- and
;; anything the project puts on the classpath is found first.
;;
;; KBB_NO_STDLIB=1 turns it off; KBB_STDLIB_ROOT points at another directory
;; holding the same sibling layout. A sibling that is not checked out is named
;; on stderr, never skipped silently.

(def stdlib-repos
  "orgs/kotoba-lang/<repo> for the namespaces the stdlib router (ADR-2609040930)
  routes clojure.* / java.* to."
  ;; dependency order: a lib is listed before the stdlib libs that depend on it,
  ;; so its sibling checkout -- not an older transitive pin -- is what resolves
  ["text" "edn" "spec" "coll" "test" "io" "fs" "process" "bytes" "json" "http"])

(def stdlib-root
  (or (.-KBB_STDLIB_ROOT (.-env js/process))
      (.resolve path (.dirname path (.realpathSync fs *file*)) ".." "..")))

(defn- stdlib-deps
  "The implicit deps, as ordered [lib coord] pairs (a map would lose the
  order above), minus libs the project already resolved."
  [seen]
  (when-not (= "1" (.-KBB_NO_STDLIB (.-env js/process)))
    (vec (keep (fn [r]
                 (let [lib (symbol "io.github.kotoba-lang" r)
                       dir (.join path stdlib-root r)]
                   (cond
                     (contains? (:libs @seen) lib) nil
                     (.existsSync fs dir) [lib {:local/root dir}]
                     :else (do (swap! seen update :errors conj [lib (str "stdlib sibling not checked out at " dir)]) nil))))
               stdlib-repos))))

(defn resolve-classpath
  "[classpath-vector missing-libs]. Every entry is relative to cwd (what the
  engine's --classpath takes); `project` is the directory deps.edn's own
  relative paths are relative to -- cwd for the CLI-shaped doors, the
  script's project for a launcher (see `project-dir-of-script`)."
  ([deps aliases] (resolve-classpath deps aliases (.cwd js/process)))
  ([deps aliases project]
   (let [cwd (.cwd js/process)
         alias-maps (map #(get-in deps [:aliases %]) aliases)
         root-paths (or (some :paths (reverse alias-maps)) (:paths deps) ["src"])
         extra (mapcat :extra-paths alias-maps)
         seen (atom {:dirs #{} :libs {} :missing [] :errors []})
         dep-maps (cons (:deps deps) (map #(merge (:extra-deps %) (:deps %) (:replace-deps %)) alias-maps))
         locals (vec (mapcat #(dep-paths % project seen) dep-maps))
         project-missing (:missing @seen)
         stdlib (dep-paths (stdlib-deps seen) project seen)
         ;; the stdlib's own Maven coordinates (http-kit behind kotoba.http's
         ;; :clj branch) are not the project's missing deps
         _ (swap! seen assoc :missing project-missing)]
     (doseq [[lib why] (distinct (:errors @seen))]
       (warn! (str lib) "is NOT on the classpath:" why))
     (doseq [[lib declared sib] (distinct (:substituted @seen))]
       (warn! (str lib) ":local/root" (pr-str declared) "does not exist here; using the west sibling checkout" sib))
     (when (= "1" (.-KBB_DEPS_VERBOSE (.-env js/process)))
       (doseq [[lib kept ignored] (:conflicts @seen)]
         (warn! (str lib) "kept" (pr-str kept) "ignored" (pr-str ignored))))
     [(vec (distinct (concat (map #(.relative path cwd (.join path project %)) (concat root-paths extra))
                             locals
                             stdlib)))
      (vec (distinct (:missing @seen)))])))

(defn- unknown-aliases [deps aliases]
  (remove #(contains? (:aliases deps) %) aliases))

;; ---- test runner substitution -----------------------------------------

(def jvm-test-runners
  #{"cognitect.test-runner" "kaocha.runner" "eftest.runner" "lambdaisland.kaocha"
    "clojure.test.runner" "circleci.test"})

(def jvm-test-exec-fns
  #{"cognitect.test-runner.api/test" "kaocha.runner/exec-fn" "kaocha.runner/run"})

(defn- ns-of-file [dir f]
  (-> (.relative path dir f)
      (str/replace #"\.(cljk|cljc|cljs|clj)$" "")
      (str/replace "/" ".")
      (str/replace "_" "-")))

(defn- test-files [dir]
  (let [out (atom [])]
    (letfn [(walk [d]
              (doseq [e (.readdirSync fs d #js {:withFileTypes true})]
                (let [p (.join path d (.-name e))]
                  (cond (.isDirectory e) (when-not (contains? #{"node_modules" ".git" "target"} (.-name e)) (walk p))
                        (re-find #"_test\.(cljk|cljc|cljs|clj)$" (.-name e)) (swap! out conj p)))))]
      (when (.existsSync fs dir) (walk dir)))
    @out))

(defn- test-runner-source
  "A script that requires every test ns and lets cljs.test decide the exit."
  [nses]
  (str "(ns kbb-test-run (:require [cljs.test]))\n"
       "(defmethod cljs.test/report [:cljs.test/default :end-run-tests] [m]\n"
       "  (println (str \"kbb test: \" (:test m) \" test(s), \" (:pass m) \" pass, \" (:fail m) \" fail, \" (:error m) \" error\"))\n"
       "  (.exit js/process (if (cljs.test/successful? m) 0 1)))\n"
       (str/join "\n" (map #(str "(require '" % ")") nses)) "\n"
       (if (seq nses)
         (str "(cljs.test/run-tests " (str/join " " (map #(str "'" %) nses)) ")\n")
         "(println \"kbb test: 0 test namespace(s) found\") (.exit js/process 1)\n")))

(defn- test-run-plan
  "Given the alias maps, the test dirs and -n / -d options, the namespaces to run."
  [alias-maps args]
  (let [opts (loop [[a & more] args m {:dirs [] :nses []}]
               (cond (nil? a) m
                     (= a "-d") (recur (rest more) (update m :dirs conj (first more)))
                     (= a "-n") (recur (rest more) (update m :nses conj (first more)))
                     :else (recur more m)))
        dirs (or (seq (:dirs opts))
                 (seq (filter #(.existsSync fs %) (mapcat :extra-paths alias-maps)))
                 ["test"])
        nses (or (seq (:nses opts))
                 (for [d dirs f (test-files d)] (ns-of-file d f)))]
    {:dirs dirs :nses (vec (distinct nses))}))

;; ---- run ---------------------------------------------------------------

(defn- exec-engine!
  "Runs the engine and exits with its status. `config?` points the engine at
  the project's nbb.edn explicitly: the engine finds nbb.edn by walking UP
  FROM THE SCRIPT PATH, so a runner written to the temp dir would otherwise
  see none of the project's :deps (measured 2026-09-11)."
  [classpath engine-args & [{:keys [config?]}]]
  (let [nbb-edn (.join path (.cwd js/process) "nbb.edn")
        r (.spawnSync cp "node" (clj->js (concat [engine]
                                                 (when (seq classpath) ["--classpath" (str/join ":" classpath)])
                                                 (when (and config? (.existsSync fs nbb-edn)) ["--config" nbb-edn])
                                                 engine-args))
                      #js {:stdio "inherit"})]
    (.exit js/process (or (.-status r) 1))))

(defn- run-test-substitute! [classpath alias-maps args]
  (let [{:keys [dirs nses]} (test-run-plan alias-maps args)
        tmp (.join path (.tmpdir os) (str "kbb-test-" (.-pid js/process) ".cljk"))]
    (warn! "test runner substitution: running" (count nses) "namespace(s) under" (pr-str dirs) "with cljs.test (the JVM runner named by the alias does not exist on this engine)")
    (.writeFileSync fs tmp (test-runner-source nses))
    (exec-engine! (vec (distinct (concat classpath dirs))) [tmp] {:config? true})))

(defn -main [argv]
  (let [{:keys [mode aliases sdeps classpath args tool?]} (parse-argv argv)
        cwd (.cwd js/process)
        project (or (when (= mode :script) (project-dir-of-script (first args))) cwd)
        deps-file (.join path project "deps.edn")
        deps (merge-sdeps (or (read-edn-file deps-file) {}) sdeps)]
    (when (= mode :help)
      (println "kbb -M[:alias…] [args] | -X[:alias] [:k v…] | -Spath | -Saliases | -Sdeps '{…}' | -m ns | -e expr | <script.cljk> [args]")
      (.exit js/process 0))
    (when (and (seq aliases) (not (.existsSync fs deps-file)) (nil? sdeps))
      (die! 66 "no deps.edn in" cwd "— aliases" (pr-str aliases) "cannot be resolved here."))
    (when-let [u (seq (unknown-aliases deps aliases))]
      (die! 64 "alias" (pr-str (vec u)) "is not declared in" deps-file
            (str "(declared: " (pr-str (vec (keys (:aliases deps)))) ")")))
    (let [alias-maps (map #(get-in deps [:aliases %]) aliases)
          [cp-vec missing] (if classpath [(str/split classpath #":") []] (resolve-classpath deps aliases project))]
      ;; org.clojure/clojure and clojurescript are the engine itself, not a
      ;; coordinate it could be missing; naming them warned on every run of
      ;; every launcher whose deps.edn pins Clojure for the linter.
      (when-let [missing (seq (remove (into #{'org.clojure/clojure 'org.clojure/clojurescript}
                                            (keys (:deps (read-edn-file (.join path project "nbb.edn")))))
                                      missing))]
        (warn! (count missing) "dep(s) are not :local/root and are NOT on the classpath (kbb resolves :local/root and :git/sha coordinates, not Maven; a jar cannot load on this engine):" (str/join ", " (map str missing))))
      (case mode
        :path (do (println (str/join ":" cp-vec)) (.exit js/process 0))
        :aliases (do (doseq [[k v] (sort-by key (:aliases deps))]
                       (println (name k) (cond (:main-opts v) (str "-M " (str/join " " (:main-opts v)))
                                               (:exec-fn v) (str "-X " (:exec-fn v))
                                               :else "(paths/deps only)")))
                     (.exit js/process 0))
        :script (exec-engine! cp-vec args)
        :exec (let [exec-fn (some :exec-fn (reverse alias-maps))
                    exec-args (apply merge (map :exec-args alias-maps))
                    kv (apply hash-map (map edn/read-string args))]
                (when-not exec-fn (die! 64 "-X/-T: no :exec-fn in aliases" (pr-str aliases)))
                (if (contains? jvm-test-exec-fns (str exec-fn))
                  (run-test-substitute! cp-vec alias-maps (mapcat (fn [[k v]] (case k :dirs (mapcat #(vector "-d" (str %)) v) :nses (mapcat #(vector "-n" (str %)) v) [])) (merge exec-args kv)))
                  (let [ns-sym (symbol (namespace exec-fn))
                        form (str "(require '" ns-sym ") (" exec-fn " " (pr-str (merge exec-args kv)) ")")]
                    (exec-engine! cp-vec ["-e" form]))))
        :main (let [main-opts (vec (concat (mapcat :main-opts alias-maps) args))
                    [flag v & rest-opts] main-opts]
                (cond
                  (and (contains? #{"-m" "--main"} flag) (contains? jvm-test-runners v))
                  (run-test-substitute! cp-vec alias-maps rest-opts)

                  (empty? main-opts)
                  (if (seq aliases)
                    (die! 64 "aliases" (pr-str aliases) "declare no :main-opts; nothing to run (this is a classpath-only alias — pass -m <ns> or a script).")
                    (exec-engine! cp-vec []))

                  (= flag "-i") (exec-engine! cp-vec (into [v] rest-opts))
                  (= flag "-r") (exec-engine! cp-vec [])
                  :else (exec-engine! cp-vec main-opts)))
        (die! 64 "nothing to run; see kbb --help")))))

(-main (vec *command-line-args*))
