#!/usr/bin/env sh
set -eu

PRG="$0"
while [ -L "$PRG" ]; do
  LINK=$(readlink "$PRG")
  case "$LINK" in
    /*) PRG="$LINK" ;;
    *) PRG="$(dirname -- "$PRG")/$LINK" ;;
  esac
done

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$PRG")" && pwd)
KBB_HOME=${KBB_HOME:-"$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"}

# kbb v2 (JVM-free). Two kinds of script come through this door:
#
#   kbb <script.kotoba> --policy p.edn [--backend native|js|interpreter] ...
#       amu-compiled guests, routed by bin/kbb_shim.cljk (native KEXE / js
#       restricted ESM / the JVM interpreter when asked by name).
#
#   kbb --backend sci [--classpath <cp>] <script.cljk> [args...]
#       Clojure-shaped .cljk scripts — the operational surface that predates
#       amu admission (hooks, gates, bots; ADR-2609111500 fix-forward). They
#       run directly on the kbb ENGINE, a SCI-on-Node host whose classpath
#       resolver finds `.cljk` (kotoba-lang/org-babashka-nbb). Stock nbb
#       cannot: its probe list is `.cljs .cljc .clj`, so every `require` of a
#       renamed namespace dies with `Could not find namespace` (measured
#       2026-09-11 on 9 root PreToolUse hooks).
#
# The shim itself is a .cljk that requires .cljk namespaces, so it runs on
# the same engine. Neither path starts a JVM; only `--backend interpreter`
# does, and it says so by name.
#
# Engine resolution — an explicit path, then the west sibling checkout; no
# silent fallback to `nbb` on PATH (that is exactly the host that cannot
# resolve .cljk, and a hook that "ran" on it would fail-open for the wrong
# reason):
#   1. $KBB_ENGINE            path to the engine's cli.js
#   2. $KBB_HOME/../org-babashka-nbb/cli.js   (orgs/kotoba-lang/ layout)
# Exit 3 (the shim's "no backend hosts this" code) with the two paths tried
# when neither exists.
if [ -n "${KBB_ENGINE:-}" ]; then
  ENGINE="$KBB_ENGINE"
else
  ENGINE="$KBB_HOME/../org-babashka-nbb/cli.js"
fi
if [ ! -f "$ENGINE" ]; then
  printf 'kbb: engine not found (tried KBB_ENGINE=%s and %s/../org-babashka-nbb/cli.js).\n' \
    "${KBB_ENGINE:-<unset>}" "$KBB_HOME" >&2
  printf 'kbb: the engine is kotoba-lang/org-babashka-nbb (west project org-babashka-nbb); check it out or set KBB_ENGINE.\n' >&2
  exit 3
fi

# The implicit kotoba stdlib for the sci door (2026-09-24). The deps door
# (bin/kbb_deps.cljk) resolves it per run; this door is on the latency path of
# hundreds of root hooks, so it asks `kbb_deps.cljk --stdlib-path` ONCE and
# reuses the answer from ${XDG_CACHE_HOME:-~/.cache}/kbb/stdlib-classpath.
# The fast path is shell builtins only (read, test -nt / -d): no node, no git.
# The answer is recomputed when it was made for another KBB_STDLIB_ROOT, when
# kbb_deps.cljk (which owns the stdlib list) or any present stdlib repository's
# deps.edn is newer than it, or when a repository it recorded as absent has
# appeared. Resolution problems (a sibling not checked out, a git dep that did
# not resolve) are part of the answer and printed on EVERY run, never cached
# into silence. The entries reach the engine as KBB_CLASSPATH_TAIL, which it
# appends after --classpath, the cwd default and nbb.edn, so anything the
# caller names is found first. KBB_NO_STDLIB=1 turns it off.
stdlib_tail() {
  STDLIB_TAIL=""
  [ "${KBB_NO_STDLIB:-}" = "1" ] && return 0
  s_root=${KBB_STDLIB_ROOT:-"$KBB_HOME/.."}
  s_cache="${XDG_CACHE_HOME:-$HOME/.cache}/kbb/stdlib-classpath"
  if [ -f "$s_cache" ] && [ ! "$SCRIPT_DIR/kbb_deps.cljk" -nt "$s_cache" ]; then
    c_root=""; c_cp=""; c_present=""; c_absent=""; c_warn=""
    { IFS= read -r c_root; IFS= read -r c_cp; IFS= read -r c_present
      IFS= read -r c_absent; IFS= read -r c_warn; } < "$s_cache" || true
    if [ "$c_root" = "$s_root" ]; then
      s_fresh=1
      for r in $c_present; do
        if [ ! -d "$s_root/$r" ] || [ "$s_root/$r/deps.edn" -nt "$s_cache" ]; then s_fresh=0; break; fi
      done
      for r in $c_absent; do
        if [ -d "$s_root/$r" ]; then s_fresh=0; break; fi
      done
      if [ "$s_fresh" = 1 ]; then
        [ -n "$c_warn" ] && printf 'kbb: implicit stdlib: %s\n' "$c_warn" >&2
        STDLIB_TAIL=$c_cp
        return 0
      fi
    fi
  fi
  mkdir -p "${s_cache%/*}" 2>/dev/null || true
  s_tmp="$s_cache.$$"
  if KBB_STDLIB_ROOT="$s_root" KBB_ENGINE="$ENGINE" node "$ENGINE" "$SCRIPT_DIR/kbb_deps.cljk" --stdlib-path > "$s_tmp"; then
    c_root=""; c_cp=""; c_present=""; c_absent=""; c_warn=""
    { IFS= read -r c_root; IFS= read -r c_cp; IFS= read -r c_present
      IFS= read -r c_absent; IFS= read -r c_warn; } < "$s_tmp" || true
    mv -f "$s_tmp" "$s_cache" 2>/dev/null || rm -f "$s_tmp"
    [ -n "$c_warn" ] && printf 'kbb: implicit stdlib: %s\n' "$c_warn" >&2
    STDLIB_TAIL=$c_cp
  else
    rm -f "$s_tmp"
    printf 'kbb: implicit stdlib: could not be resolved (kbb_deps.cljk --stdlib-path failed); running without it\n' >&2
  fi
  return 0
}

if [ "${1:-}" = "--backend" ] && [ "${2:-}" = "sci" ]; then
  shift 2
  stdlib_tail
  KBB_CLASSPATH_TAIL="$STDLIB_TAIL" exec node "$ENGINE" "$@"
fi

# Third door (ADR-2609112000): argv shaped like the Clojure CLI, babashka or a
# bare `.cljk` script -- `kbb -M:test`, `kbb -X:fmt`, `kbb -Spath`, `kbb -m ns`,
# `kbb -e '…'`, `kbb script.cljk args`, `#!/usr/bin/env kbb` (including an
# extension-less launcher whose first line is that shebang) -- goes to
# bin/kbb_deps.cljk, which resolves deps.edn aliases (:paths / :extra-paths /
# :local/root / :main-opts / :exec-fn) onto the same engine. Nothing here is a
# JVM. The `.kotoba` guest route below is untouched: it is selected by the
# script's extension, never by default.
case "${1:-}" in
  -cp|--classpath)
    # `kbb --classpath cp script`: the caller's classpath verbatim, then the
    # implicit stdlib -- taken from the same cache as the sci door, so this
    # door does not re-resolve ~200 stdlib deps.edn files per run either.
    stdlib_tail
    KBB_STDLIB_PRECOMPUTED=1 KBB_STDLIB_CLASSPATH="$STDLIB_TAIL" KBB_ENGINE="$ENGINE" \
      exec node "$ENGINE" "$SCRIPT_DIR/kbb_deps.cljk" "$@" ;;
  -M*|-A*|-X*|-T*|-S*|-J*|-m|--main|-e|-i|-r|-f|-h|--help)
    KBB_ENGINE="$ENGINE" exec node "$ENGINE" "$SCRIPT_DIR/kbb_deps.cljk" "$@" ;;
  *.cljk|*.cljc|*.cljs|*.clj)
    KBB_ENGINE="$ENGINE" exec node "$ENGINE" "$SCRIPT_DIR/kbb_deps.cljk" "$@" ;;
  *.kotoba|-*|"")
    ;;
  *)
    # An extension-less launcher: `#!/usr/bin/env kbb` puts the file's own
    # path in $1 with no extension to route on (`bin/itonami`, `bin/misogi`).
    # Its first line says what it is. Until 2026-09-15 this fell through to
    # the `.kotoba` guest shim below and every such launcher answered
    # `:kbb/policy-required` -- a policy question asked of a script that is
    # not a guest. A regular file whose first line is a shebang is a
    # Clojure-shaped script and goes through the deps door; anything else
    # still reaches the shim, which refuses it by name.
    if [ -f "$1" ]; then
      IFS= read -r first_line < "$1" || first_line=""
      case "$first_line" in
        '#!'*) KBB_ENGINE="$ENGINE" exec node "$ENGINE" "$SCRIPT_DIR/kbb_deps.cljk" "$@" ;;
      esac
    fi ;;
esac

exec node "$ENGINE" "$SCRIPT_DIR/kbb_shim.cljk" "$@"
