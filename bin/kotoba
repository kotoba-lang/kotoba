#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
KOTOBA_HOME=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

# `--help` is answered here, before any engine starts: the launcher in
# kotoba.launcher has no usage text of its own. The CLI is Kotoba (.cljk) on the
# nbb-hosted kbb engine; there is no Rust binary behind this script.
case "${1:-}" in
  -h|--help|help)
    cat <<'EOF_HELP'
usage: kotoba <command> [args...]

Kotoba CLI (Kotoba .cljk on the nbb-hosted kbb engine; no Rust).

  adl <encode|decode|verify|convert> <paths...> [--apply]
  doctor [--amu <path>] ...
  selfhost | check | compile | wasm | cljs | package | codebase | library |
  pq-key | crypto | identity | id          (dispatched to kotoba.launcher)
EOF_HELP
    exit 0 ;;
esac

# `adl` is JVM-free: the codec is portable .cljc and the driver runs on nbb.
# Dispatch it before falling through to the JVM launcher, the same way
# bin/amu keeps its JVM-free targets off the clojure path.
if [ "${1:-}" = "adl" ]; then
  shift
  exec kbb --backend sci --classpath "$KOTOBA_HOME/src" "$SCRIPT_DIR/kotoba_adl.cljk" "$@"
fi

# `doctor` is JVM-free for the same reason: the repairs are portable .cljc in
# kotoba.doctor and only the driver -- walking a tree and running `amu check`
# as a subprocess -- is nbb-specific. Not shifted: the driver dispatches on
# its own first argument.
if [ "${1:-}" = "doctor" ]; then
  exec kbb --backend sci --classpath "$KOTOBA_HOME/src" "$SCRIPT_DIR/kotoba_doctor.cljk" "$@"
fi

exec "$SCRIPT_DIR/kotoba-clj" "$@"
