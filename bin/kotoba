#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
KOTOBA_HOME=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

# `adl` is JVM-free: the codec is portable .cljc and the driver runs on nbb.
# Dispatch it before falling through to the JVM launcher, the same way
# bin/amu keeps its JVM-free targets off the clojure path.
if [ "${1:-}" = "adl" ]; then
  shift
  exec nbb --classpath "$KOTOBA_HOME/src" "$SCRIPT_DIR/kotoba_adl.cljs" "$@"
fi

# `doctor` is JVM-free for the same reason: the repairs are portable .cljc in
# kotoba.doctor and only the driver -- walking a tree and running `amu check`
# as a subprocess -- is nbb-specific. Not shifted: the driver dispatches on
# its own first argument.
if [ "${1:-}" = "doctor" ]; then
  exec nbb --classpath "$KOTOBA_HOME/src" "$SCRIPT_DIR/kotoba_doctor.cljs" "$@"
fi

exec "$SCRIPT_DIR/kotoba-clj" "$@"
