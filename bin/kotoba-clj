#!/usr/bin/env sh
set -eu
PRG="$0"
while [ -L "$PRG" ]; do
  LINK=$(readlink "$PRG")
  case "$LINK" in
    /*) PRG="$LINK" ;;
    *) PRG="$(dirname -- "$PRG")/$LINK" ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$PRG")" && pwd)
KOTOBA_CLJ_HOME=${KOTOBA_CLJ_HOME:-"$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"}
cd "$KOTOBA_CLJ_HOME"
# Resolve kbb beside this script first (CI has no global kbb on PATH), then fall
# back to whatever kbb the caller's PATH provides. Measured: CI run 34745103296
# "CLJ launcher gates" fails with `exec: kbb: not found` (exit 127) because only
# the bare name is used while bin/kbb exists in-tree.
if [ -x "$SCRIPT_DIR/kbb" ]; then
  exec "$SCRIPT_DIR/kbb" -M -m kotoba.launcher "$@"
else
  exec kbb -M -m kotoba.launcher "$@"
fi
