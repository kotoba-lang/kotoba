#!/usr/bin/env sh
set -eu
PRG="$0"
while [ -L "$PRG" ]; do
  LINK=$(readlink "$PRG")
  case "$LINK" in
    /*) PRG="$LINK" ;;
    *) PRG="$(dirname -- "$PRG")/$LINK" ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$PRG")" && pwd)
KOTOBA_CLJ_HOME=${KOTOBA_CLJ_HOME:-"$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"}
cd "$KOTOBA_CLJ_HOME"
# This is the explicitly selected JVM compatibility launcher, not the native
# bin/kotoba or a fallback from refused native/SCI admission.
exec clojure -M -i "$KOTOBA_CLJ_HOME/tools/cljk_loader.cljk" -m kotoba.launcher "$@"
