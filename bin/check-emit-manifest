#!/usr/bin/env sh
# check-emit-manifest — pre-merge guard for the reproducible-emit gate (issue #594).
# Run from the kotoba repo root (or any worktree) BEFORE a server-side merge to main:
#   bin/check-emit-manifest  # exit 0 = every src/*.kotoba is registered; exit 1 = unlisted
# A server-side `gh api .../merges` never runs CI, so the :unlisted-source failure only
# appears after main is red (3x on 2026-09-07). This script runs the same check the
# reproducible-emit gate runs, at the moment the operator can still fix the PR branch.
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
cd "$REPO_ROOT"
exec clojure -M -e "
(require '[kotoba.reproducible-emit :as repro])
(let [r (repro/verify)
      unlisted (filter #(= :unlisted-source (:kind %)) (:errors r))]
  (if (and (:valid? r) (empty? unlisted))
    (println \"emit-manifest OK:\" (:sources r) \"sources\")
    (do (println \"EMIT-MANIFEST UNLISTED:\" (pr-str unlisted))
        (System/exit 1))))"
