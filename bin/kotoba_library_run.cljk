(ns kotoba.library-source-driver
  "SCI-only process boundary. The parent validates IDs and the public request;
  this driver loads the explicit local source and invokes its declared entry."
  (:require [clojure.edn :as edn]
            [nbb.core :as nbb]
            ["fs" :as fs]))

(let [{:keys [source function arguments output]}
      (edn/read-string (fs/readFileSync (first *command-line-args*) "utf8"))
      write! (fn [value] (fs/writeFileSync output (pr-str value)))
      failure! (fn [error]
                 (write! {:ok? false :problem (or (:problem (ex-data error))
                                                :library/source-run-failed)
                          :message (ex-message error)})
                 (set! (.-exitCode js/process) 1))]
  (try
    (let [declaration (read-string {:read-cond :allow :features #{:cljs}}
                                   (fs/readFileSync source "utf8"))
          ns-name (when (and (seq? declaration) (= 'ns (first declaration))
                             (simple-symbol? (second declaration)))
                    (second declaration))]
      (when-not ns-name
        (throw (ex-info "SCI source must begin with a declared namespace"
                        {:problem :library/source-namespace-required})))
      (-> (nbb/load-file source)
          (.then (fn [_]
                   (nbb/load-string
                     (str "(let [entry (ns-resolve '" ns-name " '" function ")]"
                          " (when-not (and entry (ifn? @entry))"
                          "   (throw (ex-info \"entry function is not defined\""
                          "                   {:problem :library/function-not-found})))"
                          " (apply @entry '" (pr-str arguments) "))"))))
          (.then (fn [value] (write! {:ok? true :value value})))
          (.catch failure!)))
    (catch :default error (failure! error))))
