(ns check-library-design
  (:require [clojure.edn :as edn]
            [clojure.string :as str]
            [kotoba.adl :as adl]
            [kotoba.io :as io]
            [kotoba.lang.naming :as naming]
            [kotoba.library-catalog :as catalog]
            ["fs" :as fs]
            ["path" :as path]))

(defn ensure! [condition message]
  (when-not condition (throw (ex-info message {}))))

(let [libraries (edn/read-string (fs/readFileSync "lib/catalog.edn" "utf8"))
      events (edn/read-string (fs/readFileSync "spec/lexicon-events.edn" "utf8"))
      example (:example events)]
  (let [resource (io/resource "kotoba/spec/naming.kotoba")]
    (ensure! resource "Missing language-owned Kotoba naming spec")
    (let [spec (adl/read-string (fs/readFileSync resource "utf8"))]
      (ensure! (:ok? (naming/validate-spec spec)) "Naming spec/validator conformance drift")
      (ensure! (:ok? (naming/validate-source-whitespace (fs/readFileSync resource "utf8")))
               "The naming spec itself must follow canonical whitespace")))
  (ensure! (:ok? (catalog/validate libraries)) "Invalid checked-in source catalog")
  (ensure! (and (map? events) (= 1 (:kotoba.lexicon-events/version events))
                (= :accepted-design (:status events))
                (= :not-implemented (:implementation events)))
           "Event design must be a versioned map and state its implementation limit")
  (ensure! (every? keyword? (keys events)) "Event design has a malformed top-level key")
  (ensure! (:ok? (naming/validate-event-names example)) "Event example has invalid names/paths/selectors")
  (ensure! (= "kotoba/spec/naming.kotoba" (:naming-spec events)) "Event design must bind the naming spec")
  (ensure! (= {:separator "." :case-sensitive? true :single-token "*"
              :terminal-one-or-more ">" :publish-wildcards? false
              :selection :declared-subjects-intersect-current-grants
              :resource-id :separate-field :field-path :separate-field
              :field-path-profile :kotoba.field-path/v1 :scope :separate-bound-field}
             (:subjects events))
           "Event subject/path grammar drifted from the naming contract")
  (ensure! (= #{:publish :subscribe :ack :unsubscribe} (set (keys (:operations events))))
           "Event operation declarations incomplete")
  (ensure! (= :each-operation (get-in events [:hosts :remote-consent]))
           "Remote event operations must retain the canonical consent boundary")
  (doseq [document ["lib/README.md" "docs/ADR-kotoba-library-monorepo-and-lexicon-events.md"]
          [_ target] (re-seq #"\[[^\]]*\]\(([^)]+)\)" (fs/readFileSync document "utf8"))
          :when (not (re-find #"^[a-zA-Z][a-zA-Z0-9+.-]*:|^#" target))]
    (let [file (path/resolve (path/dirname document) (first (str/split target #"#" 2)))]
      (ensure! (fs/existsSync file) (str "Broken documentation link: " document " -> " target))))
  (println "library catalog, Lexicon event design and local documentation links: passed"))

(doseq [file *command-line-args*]
  ;; Decode through the notation's real owner. Reading a list with an EDN
  ;; reader alone is not evidence that it contains a valid ADR map.
  (let [forms (adl/read-all (fs/readFileSync file "utf8"))
        tx (first forms)
        entity (first tx)]
    (ensure! (and (= 1 (count forms)) (vector? tx) (= 1 (count tx)) (map? entity))
             (str "ADR must decode to one map transaction: " file))
    (ensure! (every? keyword? (keys entity)) (str "Malformed ADR attribute: " file))
    (doseq [key [:adr/id :adr/title :adr/status :adr/date :adr/authority :adr/body]]
      (ensure! (and (string? (get entity key)) (seq (get entity key)))
               (str "ADR field is not a nonempty string: " file " " key)))
    (ensure! (re-matches #"adr-[0-9]+-[a-z0-9-]+" (:adr/id entity)) (str "ADR ID is not a slug: " file))
    (ensure! (= "accepted" (:adr/status entity)) (str "Owner decision not recorded as accepted: " file))
    (ensure! (> (count (:adr/body entity)) 500) (str "ADR body truncated: " file))
    (println (:adr/id entity) ": decoded ADR field types and identity passed")))
