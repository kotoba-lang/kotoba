            [json.lines-test]
            [kotoba.json-facade-test]
            [kotoba.lang.json-test]
            [kotoba.lang.log-test]
            [kotoba.pprint-test]
            [kotoba.lang.process-test]
            [kotoba.process-test]
            [kotoba.lang.scheduler.driver-test]
            [kotoba.lang.scheduler-test]
            [kotoba.lang.spec-test]
            [kotoba.spec-test]
            [kotoba.lang.store-test]
            [kotoba.string-parity-test]
            [kotoba.lang.test-test]
