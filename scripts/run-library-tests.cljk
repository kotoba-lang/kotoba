            [mlkem.mlkem-test]
            [mlkem.acvp-test]
            [x25519.core-test]
            [ed25519.sign-test]
))

(defmethod t/report [:cljs.test/default :end-run-tests] [result]
  (when-not (t/successful? result) (set! (.-exitCode js/process) 1)))

(t/run-tests 'kotoba.library-derivations-test 'kotoba.tooling-monorepo-test
