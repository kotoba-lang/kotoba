(ns run-library-tests
  "The portable suites of all three complete source imports, including the
  definition facades their old standalone runners could not load. The sole
  excluded suite, json.core-test, is JVM-only in its cljk-origin.edn."
  (:require [cljs.test :as t]
            [kotoba.library-catalog-test]
            [kotoba.naming-spec-test]
            [kotoba.lang.coll-test]
            [kotoba.lang.coll-clojure-oracle-test]
            [kotoba.set-walk-coll-test]
            [kotoba.lang.spec-test]
            [kotoba.spec-test]
            [json.compat-test]
            [json.data-json-test]
            [json.escape-test]
            [json.jsonista-test]
            [json.lines-test]
            [kotoba.lang.json-test]
            [json.clojure-data-json-test]
            [kotoba.json-facade-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [result]
  (when-not (t/successful? result) (set! (.-exitCode js/process) 1)))

(t/run-tests 'kotoba.library-catalog-test
             'kotoba.naming-spec-test
             'kotoba.lang.coll-test 'kotoba.lang.coll-clojure-oracle-test
             'kotoba.set-walk-coll-test
             'kotoba.lang.spec-test 'kotoba.spec-test
             'json.compat-test 'json.data-json-test 'json.escape-test
             'json.jsonista-test 'json.lines-test 'kotoba.lang.json-test
             'json.clojure-data-json-test 'kotoba.json-facade-test)
