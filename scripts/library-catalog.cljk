(ns library-catalog-cli
  (:require [cljs.reader :as edn]
            [kotoba.library-catalog :as catalog]
            ["fs" :as fs]))

;; Developer tooling, not a new public `kotoba` command. Run from repo root:
;; KBB_NO_STDLIB=1 kbb --backend sci --config lib/nbb.edn --classpath src \
;;   scripts/library-catalog.cljk resolve kotoba-lang/json
(let [[command & names] *command-line-args*
      data (edn/read-string (fs/readFileSync "lib/catalog.edn" "utf8"))
      result (case command
               "list" (let [checked (catalog/validate data)]
                        (if (:ok? checked)
                          {:ok? true :packages (:packages data)} checked))
               "resolve" (if (= 1 (count names))
                           (catalog/resolve-library data (first names))
                           {:ok? false :problems [{:problem :library/one-name-required}]})
               "classpath" (catalog/source-paths data names)
               {:ok? false :problems [{:problem :library/usage
                                      :usage "list | resolve NAME | classpath NAME..."}]})]
  (println (js/JSON.stringify (clj->js result)))
  (when-not (:ok? result) (set! (.-exitCode js/process) 1)))
