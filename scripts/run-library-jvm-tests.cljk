(ns run-library-jvm-tests
  (:require [clojure.test :as t]
            [kotoba.library-native-branch-test]
            [json.core-test]
            [kotoba.lang.format-parity-test]))

(let [result (t/run-tests 'kotoba.library-native-branch-test 'json.core-test 'kotoba.lang.format-parity-test)]
  (System/exit (if (t/successful? result) 0 1)))
