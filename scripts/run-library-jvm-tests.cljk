(ns run-library-jvm-tests
  (:require [kotoba.library-derivations-test] [kotoba.tooling-monorepo-test]
            [kotoba.lang.lsp-test] [kotoba.lang.lsp-rpc-test] [kotoba.lang.lint-test] [kotoba.lang.lint-kotoba-test]
            [clojure.test :as t]
            [kotoba.process-definition-completion-test]
            [kotoba.string-byte-index-test]
            [kotoba.test.split-definitions-test]
            [kotoba.library-native-branch-test]
            [kotoba.lang.async-test]
            [kotoba.lang.async-parity-test]
            [json.core-test]
            [kotoba.lang.format-parity-test]
            [kotoba.lang.text-alias-test]
            [sha2.sha2-oracle-test]
            [sha2.sha512-oracle-test]
            [hash.subpath-dispatch-kotoba-parity-test]
            [ed25519.core-test]
            [chacha20.aead-params-kotoba-parity-test]
            [jcs.core-test]
            [deflate.core-test]
            [deflate.jvm-interop-test]
            [zstd.oracle-test]
            [mime.framing-artifact-test]
            [mime.framing-kotoba-test]
            [brotli.oracle-test]
            [sip.reader-kotoba-parity-test]
            [opus.celt-test]
            [opus.mdct-test]
            [opus.packet-test]
            [opus.pvq-test]
            [opus.range-decoder-test]
            [opus.toc-test]))

(let [result (t/run-tests 'kotoba.library-derivations-test 'kotoba.tooling-monorepo-test
             'kotoba.lang.lsp-test 'kotoba.lang.lsp-rpc-test 'kotoba.lang.lint-test 'kotoba.lang.lint-kotoba-test
             'kotoba.process-definition-completion-test 'kotoba.string-byte-index-test 'kotoba.test.split-definitions-test 'kotoba.library-native-branch-test 'kotoba.lang.async-test 'kotoba.lang.async-parity-test 'json.core-test 'kotoba.lang.format-parity-test 'kotoba.lang.text-alias-test 'sha2.sha2-oracle-test 'sha2.sha512-oracle-test 'hash.subpath-dispatch-kotoba-parity-test 'ed25519.core-test 'chacha20.aead-params-kotoba-parity-test 'jcs.core-test 'deflate.core-test 'deflate.jvm-interop-test 'zstd.oracle-test 'mime.framing-artifact-test 'mime.framing-kotoba-test 'brotli.oracle-test 'sip.reader-kotoba-parity-test 'opus.celt-test 'opus.mdct-test 'opus.packet-test 'opus.pvq-test 'opus.range-decoder-test 'opus.toc-test)]
  (System/exit (if (t/successful? result) 0 1)))
