;; Port of systemverilog.interface (interface.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from interface.cljk:
;;   - signal-names returns a deduplicated :document vector in first-seen order,
;;     not a set. Membership, which is its only use, is identical.
;;   - dangling-refs returns a :document vector of [modport signal-name] pairs
;;     (the lazy seq realised), in modport and key order.
;;   - (or modports {}): only a null modports becomes an empty map.

(ns systemverilog.interface
  (:export [make-interface signal-names dangling-refs valid?]))

(defn- field [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn- entry-key [m :document i :i64] :document
  (option-or (document-vector-at (option-or (document-map-entry-at m i) (document-vector)) 0) (document-null)))

(defn- entry-val [m :document i :i64] :document
  (option-or (document-vector-at (option-or (document-map-entry-at m i) (document-vector)) 1) (document-null)))

(defn- contains-doc? [xs :document x :document] :bool
  (loop [i 0]
    (cond (>= i (document-count xs)) false
          (document-equal? (option-or (document-vector-at xs i) (document-null)) x) true
          :else (recur (+ i 1)))))

(defn make-interface [name :document signals :document modports :document] :document
  (document-map :name name
                :signals (if (= (document-kind signals) :null) (document-vector) signals)
                :modports (if (= (document-kind modports) :null) (document-map) modports)))

(defn signal-names [iface :document] :document
  (let [sigs (field iface :signals)]
    (loop [i 0 acc (document-vector)]
      (if (>= i (document-count sigs))
        acc
        (let [nm (field (option-or (document-vector-at sigs i) (document-null)) :name)]
          (recur (+ i 1) (if (contains-doc? acc nm) acc (document-vector-conj acc nm))))))))

(defn- dangling-in [known :document modport :document dirs :document acc :document] :document
  (loop [j 0 out acc]
    (if (>= j (document-count dirs))
      out
      (let [sig (entry-key dirs j)]
        (recur (+ j 1)
               (if (contains-doc? known sig)
                 out
                 (document-vector-conj out (document-vector modport sig))))))))

(defn dangling-refs [iface :document] :document
  (let [known (signal-names iface)
        modports (field iface :modports)]
    (loop [i 0 acc (document-vector)]
      (if (>= i (document-count modports))
        acc
        (recur (+ i 1) (dangling-in known (entry-key modports i) (entry-val modports i) acc))))))

(defn valid? [iface :document] :bool
  (= (document-count (dangling-refs iface)) 0))
