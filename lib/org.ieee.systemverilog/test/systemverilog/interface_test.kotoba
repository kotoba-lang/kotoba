(ns systemverilog.interface-test
  (:export [main])
  (:require [systemverilog.interface :as i]))

(defn- expect [got :bool want :bool] :i64
  (if (= got want) 0 1))

(defn- edn-is [got :document want :string] :i64
  (if (string=? (document-edn-print got) want) 0 1))

(defn- sig [nm :string] :document
  (document-map :name (document-string nm)))

(defn main [] :i64
  (let [sigs (document-vector (sig "clk") (sig "data"))
        good (i/make-interface (document-string "bus") sigs
                               (document-map (document-string "master")
                                             (document-map (document-string "clk") (document-keyword :input)
                                                           (document-string "data") (document-keyword :output))))
        bad (i/make-interface (document-string "bus") sigs
                              (document-map (document-string "slave")
                                            (document-map (document-string "ghost") (document-keyword :input))))
        none (i/make-interface (document-string "empty") (document-vector) (document-null))]
    (+ (expect (i/valid? good) true)
       (expect (i/valid? bad) false)
       (expect (i/valid? none) true)
       (edn-is (i/signal-names good) "[\"clk\" \"data\"]")
       (edn-is (i/dangling-refs good) "[]")
       (edn-is (i/dangling-refs bad) "[[\"slave\" \"ghost\"]]")
       (edn-is (i/signal-names none) "[]")
       (expect (= (document-count (i/dangling-refs bad)) 1) true))))
