(ns png.grammar-test
  "png.grammar/grammar is resources/png/grammar.edn, on both runtimes."
  (:require [kotoba.lang.edn :as edn]
            [kotoba.test :refer [deftest is]]
            [png.core :as png]
            [png.encode :as encode]
            [png.grammar :as g]
            #?(:clj [kotoba.io :as io])
            #?(:cljs ["fs" :as fs])))

(def resource-text
  #?(:clj (slurp (io/resource "png/grammar.edn"))
     ;; kbb -M:test runs from the repository root.
     :cljs (fs/readFileSync "lib/org.w3.png/resources/png/grammar.edn" "utf8")))

(deftest the-value-is-the-resource
  (is (= (edn/read-string resource-text) g/grammar)))

(deftest the-value-parses-what-the-encoder-writes
  (let [px [1 2 3 4 5 6]
        back (png/parse g/grammar (encode/encode px {:width 2 :height 1 :color :rgb}))]
    (is (= px (vec (:pixels back))))
    (is (= :rgb (:color-type (:ihdr back))))))

(deftest a-changed-value-is-not-the-resource
  ;; the equality above can fail: a grammar with one field renamed is unequal.
  (is (not= (edn/read-string resource-text)
            (assoc-in g/grammar [:types :ihdr 0 :id] :w))))
