(ns png.encode-test
  "What a written PNG has to be true of, on every runtime that can write one.

  These assertions used to live in a `.clj` file, so the ClojureScript half of
  a repository whose README promises portable `.cljc` was never run. What that
  hid: `ascii` produced four zero bytes for every chunk type there, and the
  file it wrote still had a signature, a plausible length and a correct CRC
  over the zeroed type. A JVM-only suite cannot see that, however thorough it
  is, because the defect is not in the code path it takes.

  The oracle that needs a JVM -- `javax.imageio` reading what we wrote -- is
  still worth having and still lives in `png.encode-jvm-test`."
  (:require [kotoba.lang.edn :as edn]
            [kotoba.test :refer [deftest is testing]]
            [png.core :as png]
            [png.encode :as encode]
            #?(:clj [kotoba.io :as io])
            #?(:cljs ["fs" :as fs])))

(def grammar
  (edn/read-string
   #?(:clj (slurp (io/resource "png/grammar.edn"))
      ;; Run from the repository root: `kbb --backend sci --classpath src:test run-tests.cljk`.
      :cljs (fs/readFileSync "lib/org.w3.png/resources/png/grammar.edn" "utf8"))))

(defn- refusal [f]
  (try (f) nil
       (catch #?(:clj Exception :cljs js/Error) e (:type (ex-data e)))))

;; ── the chunk type is ASCII, on every runtime ────────────────────────────────

(deftest chunk-types-are-written-as-their-ascii-bytes
  ;; The regression guard. Nothing downstream states the type in a form a test
  ;; can read back -- `png.core` fails on the NEXT chunk, as a truncated read,
  ;; several hundred bytes later -- so it is asserted here, at the byte.
  (is (= [73 72 68 82] (vec (take 4 (drop 4 (encode/chunk-bytes "IHDR" [])))))
      "IHDR")
  (is (= [73 68 65 84] (vec (take 4 (drop 4 (encode/chunk-bytes "IDAT" [])))))
      "IDAT")
  (is (= [73 69 78 68] (vec (take 4 (drop 4 (encode/chunk-bytes "IEND" [])))))
      "IEND"))

;; ── round trip ───────────────────────────────────────────────────────────────

(deftest what-is-written-is-what-comes-back
  (let [pixels (vec (for [y (range 4) x (range 6) c (range 3)]
                      (mod (+ (* y 7) (* x 3) c) 256)))
        out (encode/encode pixels {:width 6 :height 4 :color :rgb})
        back (png/parse grammar out)]
    (is (= png/signature (take 8 out)))
    (is (= 6 (:width (:ihdr back))))
    (is (= 4 (:height (:ihdr back))))
    (is (= 8 (:bit-depth (:ihdr back))))
    (is (= :rgb (:color-type (:ihdr back))))
    (is (= 0 (:interlace (:ihdr back))))
    (is (= pixels (vec (:pixels back))) "every sample, unchanged")))

(deftest every-colour-type-round-trips
  (doseq [[color n] {:gray 1 :gray-alpha 2 :rgb 3 :rgba 4}]
    (testing (name color)
      (let [pixels (vec (for [i (range (* 3 2 n))] (mod (* i 11) 256)))
            back (png/parse grammar (encode/encode pixels {:width 3 :height 2
                                                           :color color}))]
        (is (= pixels (vec (:pixels back))))))))

;; ── the CRC is over the type as well as the data ─────────────────────────────

(deftest the-chunk-crc-covers-the-type
  ;; Easy to get wrong because the LENGTH field deliberately excludes the
  ;; type. A CRC that did too would validate a chunk whose type had been
  ;; changed, which is the one thing the field exists to catch.
  (let [a (encode/chunk-bytes "IEND" [])
        b (encode/chunk-bytes "IDAT" [])]
    (is (= 12 (count a)))
    (is (not= (take-last 4 a) (take-last 4 b))
        "same (empty) data, different type, different CRC")))

;; ── refusals ─────────────────────────────────────────────────────────────────

(deftest a-sample-count-that-does-not-fit-the-geometry-is-refused
  ;; Padding or truncating produces a file that opens and is wrong — the
  ;; image skewed diagonally, which is what a row-length error always looks
  ;; like and never says.
  (is (= :png/sample-count-mismatch
         (refusal #(encode/encode [1 2 3] {:width 2 :height 2 :color :rgb})))))

(deftest an-unwritable-colour-type-is-refused-by-name
  (is (= :png/unsupported-color
         (refusal #(encode/encode [1] {:width 1 :height 1 :color :indexed}))))
  (is (= :png/bad-geometry
         (refusal #(encode/encode [] {:width 0 :height 1 :color :gray})))))

;; ── size ─────────────────────────────────────────────────────────────────────

(deftest a-flat-image-compresses
  ;; Filter type 0 everywhere still leaves deflate something to do, and an
  ;; encoder whose output was larger than its input would be one nobody
  ;; should use over a network.
  (let [pixels (vec (repeat (* 64 64 3) 200))
        out (encode/encode pixels {:width 64 :height 64 :color :rgb})]
    (is (< (count out) (/ (count pixels) 10))
        "one colour, so this should be tiny")))
