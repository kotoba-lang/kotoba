(ns kotoba.image.pngs
  "Hand-built PNGs for the tests: any colour type, any bit depth, any chunk
  order, with filter 0 on every row. Built from org-w3-png's chunk writer and
  org-ietf-deflate's zlib, so they are the same on both runtimes."
  (:require [deflate.zlib :as zlib]
            [png.core :as png]
            [png.encode :as encode]))

(def color-code {:gray 0 :rgb 2 :indexed 3 :gray-alpha 4 :rgba 6})
(def channels {:gray 1 :rgb 3 :indexed 1 :gray-alpha 2 :rgba 4})

(defn- u32 [n]
  [(bit-and (bit-shift-right n 24) 0xff) (bit-and (bit-shift-right n 16) 0xff)
   (bit-and (bit-shift-right n 8) 0xff) (bit-and n 0xff)])

(defn pack-row
  "Samples of one row -> the row's bytes at `bits` per sample."
  [bits samples]
  (case (long bits)
    16 (vec (mapcat (fn [s] [(bit-and (bit-shift-right s 8) 0xff) (bit-and s 0xff)]) samples))
    8 (vec samples)
    (let [per (quot 8 bits)]
      (vec (for [grp (partition-all per samples)]
             (reduce (fn [acc [i s]] (bit-or acc (bit-shift-left s (- 8 (* bits (inc i))))))
                     0 (map-indexed vector grp)))))))

(defn png-bytes
  "PNG bytes (a vector of 0..255). `rows` is a seq of rows, each a flat seq
  of samples (channels interleaved). `before` / `after` are [type data]
  chunks placed before the first IDAT / after it. :interlace sets the IHDR
  field only (the data is still written sequentially)."
  [{:keys [width height color bits rows before after interlace]
    :or {interlace 0 before [] after []}}]
  (let [ihdr (vec (concat (u32 width) (u32 height) [bits (color-code color) 0 0 interlace]))
        raw (vec (mapcat (fn [row] (cons 0 (pack-row bits row))) rows))]
    (vec (concat png/signature
                 (encode/chunk-bytes "IHDR" ihdr)
                 (mapcat (fn [[t d]] (encode/chunk-bytes t (vec d))) before)
                 (encode/chunk-bytes "IDAT" (zlib/wrap raw))
                 (mapcat (fn [[t d]] (encode/chunk-bytes t (vec d))) after)
                 (encode/chunk-bytes "IEND" [])))))

(defn u16be [n] [(bit-and (bit-shift-right n 8) 0xff) (bit-and n 0xff)])
