(ns identify.datom-test (:export [main]) (:require [identify.datom :as p]))

(defn- ident [] :document
  (document-map :identify.identifier/type (document-keyword :email)
                :identify.identifier/value (document-string "a@x")
                :identify.identifier/source (document-string "src")
                :identify.identifier/observed-at (document-i64 5)))

(defn- cand [] :document
  (document-map :identify.candidate/subject (document-string "subj")
                :identify.candidate/confidence (document-i64 90)
                :identify.candidate/conflict? (document-bool false)
                :identify/non-adjudicating (document-bool true)))

(defn- first-of [v :document] :document
  (option-or (document-vector-at v 0) (document-null)))

(defn- show [d :document k :keyword] :string
  (document-edn-print (option-or (document-get d k) (document-null))))

(defn main [] :i64
  (let [ds (p/identifier-datoms (ident))
        d0 (first-of ds)
        cs (p/candidate-datoms (ident) (cand))
        c0 (first-of cs)]
    (+ (if (= (document-count ds) 1) 0 1)
       (if (string=? (show d0 :db/id) "\"identify::email:a@x\"") 0 1)
       (if (string=? (show d0 :identify.identifier/value) "\"a@x\"") 0 1)
       (if (= (document-count cs) 1) 0 1)
       (if (string=? (show c0 :db/id) "\"identify:candidate::email:a@x:subj\"") 0 1)
       (if (string=? (show c0 :identify.candidate/confidence) "90") 0 1)
       (if (string=? (show c0 :identify.candidate/evidence-ref) "nil") 0 1)
       (if (string=? (show c0 :identify/non-adjudicating) "true") 0 1))))
