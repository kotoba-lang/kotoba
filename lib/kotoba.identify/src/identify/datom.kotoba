;; Port of identify.datom (datom.cljk), Kotoba-native, :document maps.
;;
;; identifier-datoms and candidate-datoms return a :document vector holding one
;; datom map, as the source returns a one-element vector.
;;
;; Named divergences from datom.cljk:
;;   - (str x) on a value: a string is used as-is, a nil is "", and any other
;;     value is its EDN text (a keyword is ":ns/name"), as str prints it.
;;   - an absent field and a null field are both stored as document-null.

(ns identify.datom
  (:export [identifier-datoms candidate-datoms]))

(defn- opt [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn- as-text [d :document] :string
  (if (nil? d)
    ""
    (let [s (document-string-value d)]
      (if (option-some?-of [:option :string] s)
        (option-value-of [:option :string] s "")
        (document-edn-print d)))))

(defn identifier-datoms [identifier :document] :document
  (let [ty (opt identifier :identify.identifier/type)
        va (opt identifier :identify.identifier/value)]
    (document-vector
     (document-map :db/id (document-string (string-concat "identify:" (string-concat (as-text ty) (string-concat ":" (as-text va)))))
                   :identify.identifier/type ty
                   :identify.identifier/value va
                   :identify.identifier/source (opt identifier :identify.identifier/source)
                   :identify.identifier/observed-at (opt identifier :identify.identifier/observed-at)))))

(defn candidate-datoms [identifier :document candidate :document] :document
  (let [ty (opt identifier :identify.identifier/type)
        va (opt identifier :identify.identifier/value)
        subj (opt candidate :identify.candidate/subject)]
    (document-vector
     (document-map :db/id (document-string (string-concat "identify:candidate:"
                                                          (string-concat (as-text ty)
                                                                         (string-concat ":"
                                                                                        (string-concat (as-text va)
                                                                                                       (string-concat ":" (as-text subj)))))))
                   :identify.candidate/identifier-value va
                   :identify.candidate/identifier-type ty
                   :identify.candidate/subject subj
                   :identify.candidate/confidence (opt candidate :identify.candidate/confidence)
                   :identify.candidate/evidence-ref (opt candidate :identify.candidate/evidence-ref)
                   :identify.candidate/evidence-refs (opt candidate :identify.candidate/evidence-refs)
                   :identify.candidate/asserter (opt candidate :identify.candidate/asserter)
                   :identify.candidate/source (opt candidate :identify.candidate/source)
                   :identify.candidate/conflict? (opt candidate :identify.candidate/conflict?)
                   :identify/non-adjudicating (opt candidate :identify/non-adjudicating)))))
