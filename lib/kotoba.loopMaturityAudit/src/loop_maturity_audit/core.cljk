;; kotoba-lang/loop-maturity-audit — manifest/repo-maturity.edn freshness owner.
;; JVM-only (java.time). Propose-only: audits and proposes, never regenerates.
(ns loop-maturity-audit.core
  (:require [kotoba.io :as kio] [clojure.edn :as edn]
            [kotoba.lang.text :as str]))

(def stale-after-days 30)

(defn- file-exists? [p]
  (kio/exists? (kio/file p)))

(defn maturity-freshness
  "Measure repo-maturity.edn freshness against west.yml.
   root: superproject root.
   Returns {:status :fresh|:stale-by-age|:stale-by-drift|:unmeasured
            :computed-at s :age-days n :west-projects n :maturity-entities n
            :missing n :generated-by s}"
  [root]
  (let [mat-path (str root "/manifest/repo-maturity.edn")
        west-path (str root "/manifest/west.yml")]
    (if-not (and (file-exists? mat-path) (file-exists? west-path))
      {:status :unmeasured :reason "manifest files missing"}
      (try
        (let [mat-text (slurp mat-path)
              computed-at (second (re-find #"computed-at\s+\"([^\"]+)\"" mat-text))
              ;; count entities by counting :maturity/composite occurrences
              entities (count (re-seq #":maturity/composite" mat-text))
              west-text (slurp west-path)
              west-projects (count (re-seq #"- name:" west-text))
              gen-by (or (second (re-find #"generated by ([^\n]+)" mat-text)) "scripts/repo-maturity.cljk")
              computed-inst (some-> computed-at (java.time.Instant/parse))
              age-days (some-> computed-inst
                               (.until (java.time.Instant/now) java.time.temporal.ChronoUnit/DAYS)
                               Math/abs)
              missing (max 0 (- west-projects entities))
              status (cond
                       (nil? computed-inst) :unmeasured
                       (> missing 0) :stale-by-drift
                       (> age-days stale-after-days) :stale-by-age
                       :else :fresh)]
          {:status status
           :computed-at computed-at
           :age-days (some-> age-days int)
           :west-projects west-projects
           :maturity-entities entities
           :missing missing
           :generated-by gen-by})
        (catch Exception e
          {:status :unmeasured :reason (.getMessage e)})))))

(defn proposed-action
  "decide: what the superproject should do about the current state.
   Propose-only — returns the command text, does not run it."
  [{:keys [status missing]}]
  (case status
    :fresh "no action — repo-maturity.edn is fresh"
    :stale-by-age (str "propose: kbb --backend sci scripts/repo-maturity.cljk  (full regeneration, ~214 GraphQL batches, run as a dedicated task)")
    :stale-by-drift (str "propose: kbb --backend sci scripts/repo-maturity.cljk  (" missing
                         " west projects missing from the maturity file — full regeneration covers them; "
                         "--paths-from can rescore a subset first)")
    :unmeasured "propose: fix the audit itself — maturity file unreadable, see audit reason"))

(defn run-cycle!
  "observe -> evaluate -> decide -> act(propose) -> record-evidence."
  [{:keys [root ledger-path] :or {root "." ledger-path "ledger/maturity-audit-ledger.edn"}}]
  (let [audit (maturity-freshness root)
        proposal (proposed-action audit)
        entry {:event/type :maturity-audit-cycle
               :event/at (str (java.time.Instant/now))
               :audit audit
               :proposal proposal}]
    (let [f (kio/file (if (.startsWith ledger-path "/")
                             ledger-path
                             (str root "/" ledger-path)))
          _ (when-let [parent (kio/parent-file f)]
              (kio/mkdirs parent))]
      (spit f (str (pr-str entry) "\n") :append true))
    {:audit audit :proposal proposal :ledger-path ledger-path}))
