// svelte-to-cljs migration (2026-09-08): the SvelteKit frontend under
// svelte/ was removed and replaced by appview/.../cljs (reagent + re-frame +
// jp-go-dds, built with shadow-cljs to ./cljs/public). The `main` key that
// pointed at svelte/.svelte-kit/cloudflare/_worker.js has been deleted
// rather than repointed at src/app.ts — src/app.ts does not call
// `env.ASSETS.fetch()`, so pointing `main` at it would put a Worker in
// front of the assets with nothing to serve them; this Worker is
// assets-only for now. `assets.directory` now points at ./cljs/public.
//
// ⚠ UNVERIFIED: this edit has not been exercised with `wrangler deploy` or
// `wrangler dev` — deployment verification is a separate job. Do not treat
// this config as confirmed-working until that has been run.
{
  "name": "kotodama-cfbr0w53",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_CAPABILITIES": "[\"cf-browser-render\",\"render-html\",\"render-png\",\"render-pdf\",\"session-do\"]",
    "APP_DEPLOY_AT": "2026-04-20T09:11:09Z",
    "APP_DEPLOY_SHA": "b1d34be9146",
    "APP_DESCRIPTION": "Serverless Playwright backend using CF Workers 'browser' binding + @cloudflare/playwright. Session affinity via Durable Object. Invoked by com.etzhayyim.apps.playwright as target=cf-browser substrate.",
    "APP_DISPLAY_NAME": "Cloudflare Browser Render",
    "APP_EMBED_URL": "https://cfbr0w53.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "cfbr0w53",
    "APP_PERFORMER_TYPE": "service",
    "APP_SOURCE": "custom",
    "APP_TEMPLATE": "",
    "APP_UI_TYPE": "appview",
    "APP_VERSION": "0.1.0",
    "INTERFACES_REQUIRES": "[\"etzhayyim:collection/collection@1.0.0\",\"kotodama:browser/automation@1.0.0\"]",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "cfbr0w53.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "cloudflare-browser-render.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
