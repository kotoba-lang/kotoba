;; Cloudflare Browser Render (cfbr0w53) appview frontend — reagent + re-frame,
;; rendered with jp-go-dds (デジタル庁デザインシステム). Migrated from
;; appview/etzhayyim-wasm-cloudflare-browser-render-cfbr0w53/svelte (Svelte 5 +
;; SvelteKit + @sveltejs/adapter-cloudflare — a single `src/routes/+page.svelte`
;; that rendered static facts about this app surface: title, project, kind,
;; route count, declared routes, runtime vars, xrpc flag, source path).
;;
;; reagent/re-frame/clojurescript/shadow-cljs live under the :cljs alias
;; rather than top-level :deps (workspace convention — top-level :deps is
;; reserved for JVM deps a PreToolUse hook, jvm-new-surface-guard, checks on
;; new top-level entries; see orgs/cloud-itonami/okaimono's
;; appview/okaimono-shopping-mcp-component/cljs/deps.edn for the same shape).
;; jp-go-dds is a workspace git dep and stays top-level.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ;; Pinned to the sha okaimono's landed, building cljs migration uses —
        ;; an explicit floor proven by a repo that already builds, not an
        ;; arbitrary choice. See AGENTS.md's "kotoba-uiux" skill for the
        ;; jp-go-dds bridge/token contract this floor keeps working.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system.git"
         :git/sha "dc4602dc17bce8f6e9ba038e92b3e95fcc411b49"}}
 :aliases {:cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                                thheller/shadow-cljs {:mvn/version "2.28.20"}
                                reagent/reagent {:mvn/version "1.2.0"}
                                re-frame/re-frame {:mvn/version "1.4.3"}}}
           :test {:extra-paths ["test"]}}}
