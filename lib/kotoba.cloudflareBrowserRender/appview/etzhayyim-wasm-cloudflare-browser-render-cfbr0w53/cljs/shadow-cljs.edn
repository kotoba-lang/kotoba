;; :asset-path is relative ("js", not "/js") — this app is served under a
;; path prefix (cfbr0w53.etzhayyim.com/* and
;; cloudflare-browser-render.etzhayyim.com/*, see ../wrangler.jsonc), and an
;; absolute asset-path breaks under a prefix.
{:deps   {:aliases [:cljs :test]}
 :builds {:app  {:target :browser
                 :output-dir "public/js"
                 :asset-path "js"
                 :modules {:app {:init-fn etzhayyim.wasm.cfbr.app/main}}}
          :test {:target :node-test
                 :output-to "out/tests.js"
                 :ns-regexp "-test$"}}}
