(ns mrz.glyph
  "Classical (non-neural) glyph segmentation + template correlation matching,
   running on kotoba-lang/num's tensor backend — R1 EXPERIMENTAL (see this
   repo's MATURITY.md and ADR-2607198200).

   HONESTY NOTE (do not remove): this namespace implements a real, tested
   SEGMENTATION + MATCHING ALGORITHM — fixed-pitch cell slicing (legitimate
   because MRZ's OCR-B font is fixed-width by spec) and cosine-similarity
   correlation against a caller-supplied template bank. It does NOT bundle
   real OCR-B glyph bitmap data: hand-authoring accurate pixel templates for
   a real font, by hand, with no font-rendering pipeline available in this
   workspace, would produce data that LOOKS like it works but was never
   actually derived from OCR-B — exactly the false-confidence failure mode
   ADR-2607198200 is written to avoid. A caller must supply real templates
   (e.g. rendered from an actual OCR-B font file) via `opts`. This
   namespace's own tests exercise the algorithm with synthetic template
   vectors, which proves the MATCHING LOGIC is correct — it says nothing
   about real-photograph OCR accuracy, which remains unvalidated.

   No zone localization / perspective correction here either — `segment-row`
   assumes the input is already a straightened, tightly-cropped MRZ line at
   a known fixed pitch; finding and straightening that zone in a full
   document photo is a separate, harder, unsolved problem in this repo.")

(defn segment-row
  "Slice one line-image (a seq of equal-length pixel-rows) into `glyph-count`
   equal-width cells, each flattened to a single pixel vector (row-major:
   all of row 0's cell pixels, then row 1's, ...). Throws ex-info if the row
   width doesn't evenly divide into `glyph-count` cells — a silent
   off-by-one truncation would corrupt every glyph after it, so this fails
   loudly instead."
  [line-image glyph-count]
  (let [rows (mapv vec line-image)
        width (count (first rows))]
    (when (zero? width) (throw (ex-info "mrz.glyph: empty line image" {})))
    (when-not (zero? (mod width glyph-count))
      (throw (ex-info "mrz.glyph: row width does not evenly divide glyph-count"
                       {:width width :glyph-count glyph-count})))
    (let [cell-width (quot width glyph-count)]
      (mapv (fn [i]
              (let [start (* i cell-width) end (+ start cell-width)]
                (vec (mapcat #(subvec % start end) rows))))
            (range glyph-count)))))

(defn cosine-similarity
  "Correlation score in [-1.0, 1.0] between two equal-length pixel vectors,
   computed via num-clj (dot product / product-of-norms) so the same code
   path can later swap in a GPU backend without changing this function.
   `backend` is a num.protocol/IBackend (e.g. `(num.cpu/cpu-backend)`)."
  [backend a-fns b-fns u v]
  (let [{:keys [from-vec]} a-fns
        {:keys [dot nrm2]} b-fns
        x (from-vec backend u [(count u)])
        y (from-vec backend v [(count v)])
        denom (* (nrm2 x) (nrm2 y))]
    (if (zero? denom) 0.0 (/ (dot x y) denom))))

(defn best-match
  "`templates` is a map of {char pixel-vector}, every vector the same length
   as `cell`. Returns [char score] for the highest-scoring template, or nil
   if `templates` is empty. `a-fns`/`b-fns` are the num.array/num.core
   function maps `cosine-similarity` needs (kept as explicit params, not a
   direct require, so this pure-.cljc namespace has zero hard dependency on
   num-clj's own namespaces for callers who only want the segmentation half)."
  [backend a-fns b-fns cell templates]
  (when (seq templates)
    (apply max-key second
           (map (fn [[ch tmpl]] [ch (cosine-similarity backend a-fns b-fns cell tmpl)])
                templates))))

(defn decode-line
  "Segment `line-image` into `(:glyph-count opts)` cells and best-match each
   against `(:template-bank opts)` (a {char pixel-vector} map — see this
   namespace's honesty note: NOT bundled, caller-supplied). Returns
   {:text \"...\" :scores [...]} — `:scores` lets a caller threshold on
   confidence per character rather than trust a flat string blindly."
  [backend a-fns b-fns line-image opts]
  (let [{:keys [glyph-count template-bank]} opts
        cells (segment-row line-image glyph-count)
        matches (map #(best-match backend a-fns b-fns % template-bank) cells)]
    {:text (apply str (map first matches))
     :scores (mapv second matches)}))
