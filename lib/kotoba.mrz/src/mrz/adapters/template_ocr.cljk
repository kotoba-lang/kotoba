(ns mrz.adapters.template-ocr
  "R1-experimental mrz.ports/IZoneOcr implementation: mrz.glyph's
   segmentation + correlation matching, wired to a caller-injected num-clj
   backend. See mrz.glyph's module doc for the honesty caveat this adapter
   inherits in full — no bundled template data, no zone-localization, no
   validated real-photograph accuracy."
  (:require [mrz.ports :as ports]
            [mrz.glyph :as glyph]))

(defn template-ocr
  "`backend` is a num.protocol/IBackend (e.g. `(num.cpu/cpu-backend)`).
   `array-fns`/`core-fns` are `{:from-vec num.array/from-vec}` /
   `{:dot num.core/dot :nrm2 num.core/nrm2}` — passed in rather than
   required directly so mrz.glyph/mrz.adapters.template-ocr stay buildable
   without num-clj on the classpath for callers who only need mrz.core's
   decode/checksum surface."
  [backend array-fns core-fns]
  (reify ports/IZoneOcr
    (read-zone [_ line-images opts]
      (mapv (fn [line-image]
              (:text (glyph/decode-line backend array-fns core-fns line-image opts)))
            line-images))))
