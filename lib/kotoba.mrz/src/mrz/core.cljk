(ns mrz.core
  "Decode + validate already-read MRZ text (ICAO Doc 9303 TD1/TD2/TD3). This
   is the R2-target, load-bearing surface: given MRZ characters (however
   they were read — typed, OCR'd by a caller, or by mrz.glyph), decoding and
   checksum-validating them is a deterministic, fully-specified operation,
   verifiable against ICAO's own published worked example (see mrz.checksum
   and the TD3 conformance test). This namespace does no image processing —
   see mrz.ports/IZoneOcr for that seam."
  (:require [mrz.model :as model]
            [mrz.checksum :as checksum]))

(defn- field-check
  "Slice `value-range` and `check-range` out of `line`, and validate. Returns
   {:value ... :check-digit \\c :valid? bool}."
  [line value-range check-range]
  (let [value (model/field line value-range)
        check-char (first (model/field line check-range))]
    {:value value :check-digit check-char :valid? (checksum/valid? value check-char)}))

(defn- composite [& parts] (apply str parts))

(defn parse-td3
  "line1/line2 must each be 44 chars (ICAO 9303 Part 4, TD3 — passports)."
  [line1 line2]
  (let [{l1 :line1 l2 :line2} model/td3
        doc-num   (field-check line2 (:doc-number l2) (:doc-number-check l2))
        birth     (field-check line2 (:birth-date l2) (:birth-date-check l2))
        expiry    (field-check line2 (:expiry-date l2) (:expiry-date-check l2))
        personal  (field-check line2 (:personal-number l2) (:personal-number-check l2))
        composite-input (composite (:value doc-num) (:check-digit doc-num)
                                    (:value birth) (:check-digit birth)
                                    (:value expiry) (:check-digit expiry)
                                    (:value personal) (:check-digit personal))
        composite-char (first (model/field line2 (:composite-check l2)))]
    {:format :td3
     :doc-type (model/field line1 (:doc-type l1))
     :issuing-state (model/field line1 (:issuing-state l1))
     :name (model/split-name (model/field line1 (:name l1)))
     :doc-number (:value doc-num)
     :nationality (model/field line2 (:nationality l2))
     :birth-date (:value birth)
     :sex (model/field line2 (:sex l2))
     :expiry-date (:value expiry)
     :personal-number (:value personal)
     :checks {:doc-number (:valid? doc-num)
              :birth-date (:valid? birth)
              :expiry-date (:valid? expiry)
              :personal-number (:valid? personal)
              :composite (checksum/valid? composite-input composite-char)}}))

(defn parse-td2
  "line1/line2 must each be 36 chars (ICAO 9303 Part 5, TD2)."
  [line1 line2]
  (let [{l1 :line1 l2 :line2} model/td2
        doc-num  (field-check line2 (:doc-number l2) (:doc-number-check l2))
        birth    (field-check line2 (:birth-date l2) (:birth-date-check l2))
        expiry   (field-check line2 (:expiry-date l2) (:expiry-date-check l2))
        optional (model/field line2 (:optional-data l2))
        composite-input (composite (:value doc-num) (:check-digit doc-num)
                                    (:value birth) (:check-digit birth)
                                    (:value expiry) (:check-digit expiry)
                                    optional)
        composite-char (first (model/field line2 (:composite-check l2)))]
    {:format :td2
     :doc-type (model/field line1 (:doc-type l1))
     :issuing-state (model/field line1 (:issuing-state l1))
     :name (model/split-name (model/field line1 (:name l1)))
     :doc-number (:value doc-num)
     :nationality (model/field line2 (:nationality l2))
     :birth-date (:value birth)
     :sex (model/field line2 (:sex l2))
     :expiry-date (:value expiry)
     :optional-data optional
     :checks {:doc-number (:valid? doc-num)
              :birth-date (:valid? birth)
              :expiry-date (:valid? expiry)
              :composite (checksum/valid? composite-input composite-char)}}))

(defn parse-td1
  "line1/line2/line3 must each be 30 chars (ICAO 9303 Part 5, TD1 — ID cards).
   Unlike TD2/TD3, TD1's composite check digit spans both line1 and line2."
  [line1 line2 line3]
  (let [{l1 :line1 l2 :line2} model/td1
        doc-num  (field-check line1 (:doc-number l1) (:doc-number-check l1))
        optional1 (model/field line1 (:optional-data-1 l1))
        birth    (field-check line2 (:birth-date l2) (:birth-date-check l2))
        expiry   (field-check line2 (:expiry-date l2) (:expiry-date-check l2))
        optional2 (model/field line2 (:optional-data-2 l2))
        composite-input (composite (:value doc-num) (:check-digit doc-num)
                                    optional1
                                    (:value birth) (:check-digit birth)
                                    (:value expiry) (:check-digit expiry)
                                    optional2)
        composite-char (first (model/field line2 (:composite-check l2)))]
    {:format :td1
     :doc-type (model/field line1 (:doc-type l1))
     :issuing-state (model/field line1 (:issuing-state l1))
     :name (model/split-name (model/field line3 (:name (:line3 model/td1))))
     :doc-number (:value doc-num)
     :nationality (model/field line2 (:nationality l2))
     :birth-date (:value birth)
     :sex (model/field line2 (:sex l2))
     :expiry-date (:value expiry)
     :optional-data-1 optional1
     :optional-data-2 optional2
     :checks {:doc-number (:valid? doc-num)
              :birth-date (:valid? birth)
              :expiry-date (:valid? expiry)
              :composite (checksum/valid? composite-input composite-char)}}))

(defn parse
  "Dispatch on line count + width. `lines` is a seq of 2 or 3 already-split
   strings (the caller owns splitting raw MRZ text into lines — this ns
   never guesses a line boundary from a blob). Throws ex-info on unrecognized
   shape rather than silently guessing a format."
  [lines]
  (let [lines (vec lines)
        n (count lines)
        widths (set (map count lines))]
    (cond
      (and (= n 2) (= widths #{44})) (apply parse-td3 lines)
      (and (= n 2) (= widths #{36})) (apply parse-td2 lines)
      (and (= n 3) (= widths #{30})) (apply parse-td1 lines)
      :else (throw (ex-info "mrz: unrecognized line shape (expected 2x44 TD3, 2x36 TD2, or 3x30 TD1)"
                             {:line-count n :widths widths})))))

(defn valid?
  "Whether every check in a parsed record passed."
  [parsed] (every? true? (vals (:checks parsed))))
