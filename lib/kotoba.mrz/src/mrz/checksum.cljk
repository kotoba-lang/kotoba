(ns mrz.checksum
  "ICAO Doc 9303 Part 3 §4.9 check-digit algorithm — pure, portable, no I/O.

   Character values: digits '0'-'9' -> 0-9, letters 'A'-'Z' -> 10-35 (A=10, ..., Z=35),
   filler '<' -> 0. Weights cycle 7, 3, 1 over the string, left to right. The check
   digit is (sum mod 10), always itself a plain digit character.

   Verified against ICAO Doc 9303's own published TD3 worked example
   (`L898902C36UTO7408122F1204159ZE184226B<<<<<10`): document number
   \"L898902C3\" -> 6, DOB \"740812\" -> 2, expiry \"120415\" -> 9, personal
   number \"ZE184226B<<<<<\" -> 1 — each hand-computed against this algorithm
   before landing (see mrz.core-test for the full conformance test).")

(defn char->value
  "One MRZ character's numeric value per ICAO 9303 Part 3 §4.9. Non-MRZ
   characters (anything not 0-9, A-Z, or '<') have no defined value —
   returns nil so a caller can detect malformed input rather than silently
   miscomputing a checksum."
  [c]
  (cond
    (= c \<)                 0
    (and (>= (int c) (int \0)) (<= (int c) (int \9))) (- (int c) (int \0))
    (and (>= (int c) (int \A)) (<= (int c) (int \Z))) (+ 10 (- (int c) (int \A)))
    :else                     nil))

(def ^:private weights [7 3 1])

(defn compute
  "The check digit (0-9) for `s`, or nil if `s` contains a character outside
   the MRZ alphabet (0-9, A-Z, '<')."
  [s]
  (let [values (map char->value s)]
    (when (every? some? values)
      (mod (reduce + (map * values (cycle weights))) 10))))

(defn valid?
  "Whether `check-char` (a single digit character, or '<' — ICAO 9303 permits
   '<' in place of a computed 0 for an all-filler optional field) is the
   correct check digit for `s`."
  [s check-char]
  (let [computed (compute s)]
    (and (some? computed)
         (or (= check-char (char (+ (int \0) computed)))
             (and (= computed 0) (= check-char \<))))))
