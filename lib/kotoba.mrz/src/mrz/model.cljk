(ns mrz.model
  "ICAO Doc 9303 field layouts (TD1/TD2/TD3) and the shared name-field
   convention — pure data + pure parsing helpers, no checksum logic (that's
   mrz.checksum) and no line-assembly logic (that's mrz.core)."
  (:require [kotoba.lang.text :as str]))

(def line-lengths
  "Fixed line width per format, per ICAO 9303 Part 3/4."
  {:td1 30 :td2 36 :td3 44})

(def formats (set (keys line-lengths)))

(defn- ->range
  "1-indexed inclusive [a b] from the ICAO spec -> 0-indexed [start end)
   exclusive, the shape clojure.core/subs wants."
  [a b] [(dec a) b])

;; Field position tables, straight from ICAO 9303 Part 3 §4.2 (TD1), §4.3
;; (TD2), Part 4 §4.2 (TD3, 2-line). Values are [start end) 0-indexed ranges
;; into the relevant line string.
(def td3
  {:line1 {:doc-type (->range 1 2) :issuing-state (->range 3 5) :name (->range 6 44)}
   :line2 {:doc-number (->range 1 9) :doc-number-check (->range 10 10)
           :nationality (->range 11 13) :birth-date (->range 14 19)
           :birth-date-check (->range 20 20) :sex (->range 21 21)
           :expiry-date (->range 22 27) :expiry-date-check (->range 28 28)
           :personal-number (->range 29 42) :personal-number-check (->range 43 43)
           :composite-check (->range 44 44)}})

(def td2
  {:line1 {:doc-type (->range 1 2) :issuing-state (->range 3 5) :name (->range 6 36)}
   :line2 {:doc-number (->range 1 9) :doc-number-check (->range 10 10)
           :nationality (->range 11 13) :birth-date (->range 14 19)
           :birth-date-check (->range 20 20) :sex (->range 21 21)
           :expiry-date (->range 22 27) :expiry-date-check (->range 28 28)
           :optional-data (->range 29 35) :composite-check (->range 36 36)}})

(def td1
  {:line1 {:doc-type (->range 1 2) :issuing-state (->range 3 5)
           :doc-number (->range 6 14) :doc-number-check (->range 15 15)
           :optional-data-1 (->range 16 30)}
   :line2 {:birth-date (->range 1 6) :birth-date-check (->range 7 7)
           :sex (->range 8 8) :expiry-date (->range 9 14)
           :expiry-date-check (->range 15 15) :nationality (->range 16 18)
           :optional-data-2 (->range 19 29) :composite-check (->range 30 30)}
   :line3 {:name (->range 1 30)}})

(defn field
  "Slice `line` per a [start end) range from one of the tables above."
  [line [start end]] (subs line start end))

(defn split-name
  "'SURNAME<<GIVEN<NAMES<<<<' -> {:primary \"SURNAME\" :secondary [\"GIVEN\" \"NAMES\"]}.
   '<' within a name component becomes a space (compound surnames); a run of
   '<' separates surname from given names; trailing filler is dropped."
  [name-field]
  (let [parts (str/split name-field #"<<" 2)
        clean (fn [s] (str/trim (str/replace s #"<" " ")))
        primary (clean (first parts))
        secondary (when (second parts)
                    (->> (str/split (second parts) #"<+")
                         (remove str/blank?)
                         (mapv clean)))]
    {:primary primary :secondary (or secondary [])}))
