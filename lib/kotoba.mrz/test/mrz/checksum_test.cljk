(ns mrz.checksum-test
  (:require [kotoba.test :refer [deftest is]]
            [mrz.checksum :as checksum]))

(deftest char-values-per-icao-9303-part-3
  (is (= 0 (checksum/char->value \0)))
  (is (= 9 (checksum/char->value \9)))
  (is (= 10 (checksum/char->value \A)))
  (is (= 35 (checksum/char->value \Z)))
  (is (= 0 (checksum/char->value \<)))
  (is (nil? (checksum/char->value \space)))
  (is (nil? (checksum/char->value \-))))

;; ICAO Doc 9303's own published TD3 worked example
;; (L898902C36UTO7408122F1204159ZE184226B<<<<<10). Each check digit here is
;; independently hand-computed against the 7-3-1 weighted mod-10 algorithm
;; before landing (see this ns's own doc comment for the full derivation).
(deftest icao-9303-td3-worked-example-check-digits
  (is (= 6 (checksum/compute "L898902C3")) "document number check digit")
  (is (= 2 (checksum/compute "740812")) "date of birth check digit")
  (is (= 9 (checksum/compute "120415")) "date of expiry check digit")
  (is (= 1 (checksum/compute "ZE184226B<<<<<")) "personal number check digit")
  (is (= 0 (checksum/compute (str "L898902C36" "7408122" "1204159" "ZE184226B<<<<<1")))
      "composite check digit over doc-number+check, dob+check, expiry+check, personal-number+check"))

(deftest valid?-accepts-correct-digit-and-<-for-all-filler
  (is (checksum/valid? "L898902C3" \6))
  (is (not (checksum/valid? "L898902C3" \5)))
  (is (checksum/valid? "<<<<<<<<<<<<<<" \<) "an all-filler field's computed 0 may be printed as '<'")
  (is (checksum/valid? "<<<<<<<<<<<<<<" \0) "or as a literal 0")
  (is (not (checksum/valid? "<<<<<<<<<<<<<<" \1))))

(deftest compute-returns-nil-on-out-of-alphabet-input
  (is (nil? (checksum/compute "AB-12")))
  (is (false? (checksum/valid? "AB-12" \0)) "out-of-alphabet input is never silently 'valid'"))
