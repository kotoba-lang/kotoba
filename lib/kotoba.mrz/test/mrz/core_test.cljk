(ns mrz.core-test
  (:require [kotoba.test :refer [deftest is testing]]
            [mrz.core :as mrz]
            [mrz.checksum :as checksum]))

;; ICAO Doc 9303's own published TD3 (passport) worked example — the single
;; most-reproduced MRZ conformance vector (also used by Wikipedia's
;; "Machine-readable passport" article and multiple independent open-source
;; MRZ parsers). Both lines are exactly 44 characters; asserted explicitly
;; below so a typo here fails loudly instead of silently mis-parsing.
(def td3-line1 "P<UTOERIKSSON<<ANNA<MARIA<<<<<<<<<<<<<<<<<<<")
(def td3-line2 "L898902C36UTO7408122F1204159ZE184226B<<<<<10")

(deftest icao-fixture-line-lengths
  (is (= 44 (count td3-line1)))
  (is (= 44 (count td3-line2))))

(deftest td3-icao-worked-example-parses-and-validates
  (let [parsed (mrz/parse-td3 td3-line1 td3-line2)]
    (is (= :td3 (:format parsed)))
    (is (= "P<" (:doc-type parsed)))
    (is (= "UTO" (:issuing-state parsed)))
    (is (= "ERIKSSON" (get-in parsed [:name :primary])))
    (is (= ["ANNA" "MARIA"] (get-in parsed [:name :secondary])))
    (is (= "L898902C3" (:doc-number parsed)))
    (is (= "UTO" (:nationality parsed)))
    (is (= "740812" (:birth-date parsed)))
    (is (= "F" (:sex parsed)))
    (is (= "120415" (:expiry-date parsed)))
    (is (= "ZE184226B<<<<<" (:personal-number parsed)))
    (is (every? true? (vals (:checks parsed))) (str "all checks: " (:checks parsed)))
    (is (mrz/valid? parsed))))

(deftest td3-tamper-detection-is-per-field-not-global
  (testing "corrupting the document number flips only that check"
    (let [tampered "L898902C46UTO7408122F1204159ZE184226B<<<<<10" ;; 3->4 in doc number
          parsed (mrz/parse-td3 td3-line1 tampered)]
      (is (false? (get-in parsed [:checks :doc-number])))
      (is (true? (get-in parsed [:checks :birth-date])))
      (is (true? (get-in parsed [:checks :expiry-date])))
      (is (false? (mrz/valid? parsed)))))
  (testing "corrupting only the date of birth flips only that check, and the composite"
    (let [tampered "L898902C36UTO7408132F1204159ZE184226B<<<<<10" ;; 12->13 in DOB
          parsed (mrz/parse-td3 td3-line1 tampered)]
      (is (true? (get-in parsed [:checks :doc-number])))
      (is (false? (get-in parsed [:checks :birth-date])))
      (is (false? (get-in parsed [:checks :composite]))
          "composite covers dob+check, so a corrupted dob (which still matches its OWN check digit here) still breaks composite"))))

;; --- TD2 / TD1 round-trip: build a self-consistent line using this repo's
;; OWN checksum function, then assert parse+validate agrees. This proves
;; internal consistency of the TD2/TD1 field-range tables (a real risk given
;; TD1's composite spans two lines) but is NOT a substitute for an
;; independently-sourced third-party test vector — see MATURITY.md.

(defn- pad-to [s width]
  (if (>= (count s) width)
    (subs s 0 width)
    (str s (apply str (repeat (- width (count s)) \<)))))

(defn- build-name-line [doc-type issuing-state name-field width]
  (pad-to (str doc-type issuing-state name-field) width))

(defn- build-td2-line2 [doc-number nationality birth-date sex expiry-date optional-data]
  (let [doc-check (checksum/compute doc-number)
        birth-check (checksum/compute birth-date)
        expiry-check (checksum/compute expiry-date)
        composite-input (str doc-number doc-check birth-date birth-check
                              expiry-date expiry-check optional-data)
        composite-check (checksum/compute composite-input)]
    (str doc-number doc-check nationality birth-date birth-check sex
         expiry-date expiry-check optional-data composite-check)))

(deftest td2-self-consistent-round-trip
  (let [line1 (build-name-line "I<" "UTO" "ERIKSSON<<ANNA<MARIA" 36)
        line2 (build-td2-line2 "D23145890" "UTO" "740812" "F" "120415" "<<<<<<<")]
    (is (= 36 (count line1)))
    (is (= 36 (count line2)))
    (let [parsed (mrz/parse-td2 line1 line2)]
      (is (= :td2 (:format parsed)))
      (is (every? true? (vals (:checks parsed))))
      (is (mrz/valid? parsed)))))

(defn- build-td1-lines [doc-number optional-data-1 birth-date sex expiry-date nationality optional-data-2]
  (let [doc-check (checksum/compute doc-number)
        line1 (str "I<UTO" doc-number doc-check optional-data-1)
        birth-check (checksum/compute birth-date)
        expiry-check (checksum/compute expiry-date)
        composite-input (str doc-number doc-check optional-data-1
                              birth-date birth-check expiry-date expiry-check optional-data-2)
        composite-check (checksum/compute composite-input)
        line2 (str birth-date birth-check sex expiry-date expiry-check
                    nationality optional-data-2 composite-check)]
    [line1 line2]))

(deftest td1-self-consistent-round-trip-composite-spans-both-lines
  (let [[line1 line2] (build-td1-lines "D23145890" "<<<<<<<<<<<<<<<"
                                        "740812" "F" "120415" "UTO" "<<<<<<<<<<<")
        line3 (pad-to "ERIKSSON<<ANNA<MARIA" 30)]
    (is (= 30 (count line1)))
    (is (= 30 (count line2)))
    (is (= 30 (count line3)))
    (let [parsed (mrz/parse-td1 line1 line2 line3)]
      (is (= :td1 (:format parsed)))
      (is (= "ERIKSSON" (get-in parsed [:name :primary])))
      (is (every? true? (vals (:checks parsed))))
      (is (mrz/valid? parsed))))
  (testing "corrupting line1's optional-data-1 still breaks the (two-line-spanning) composite"
    (let [[line1 line2] (build-td1-lines "D23145890" "<<<<<<<<<<<<<<<"
                                          "740812" "F" "120415" "UTO" "<<<<<<<<<<<")
          tampered-line1 (str (subs line1 0 15) "X" (subs line1 16))
          parsed (mrz/parse-td1 tampered-line1 line2 "ERIKSSON<<ANNA<MARIA<<<<<<<<<<")]
      (is (false? (get-in parsed [:checks :composite]))))))

(deftest parse-dispatches-on-line-shape
  (is (= :td3 (:format (mrz/parse [td3-line1 td3-line2]))))
  (is (thrown? #?(:clj Exception :cljs js/Error) (mrz/parse ["short" "lines"]))))
