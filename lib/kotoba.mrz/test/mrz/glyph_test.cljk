(ns mrz.glyph-test
  "Algorithm-correctness tests for mrz.glyph, using SYNTHETIC template
   vectors (never real OCR-B pixel data — see mrz.glyph's module doc). These
   prove the segmentation/matching LOGIC is correct; they say nothing about
   real-photograph OCR accuracy, which remains unvalidated (MATURITY.md)."
  (:require [kotoba.test :refer [deftest is testing]]
            [mrz.glyph :as glyph]
            [num.cpu :as cpu]
            [num.array :as arr]
            [num.core :as nm]))

(def backend (cpu/cpu-backend))
(def a-fns {:from-vec arr/from-vec})
(def b-fns {:dot nm/dot :nrm2 nm/nrm2})

(deftest segment-row-slices-equal-width-cells-row-major
  (let [line-image [[0.0 0.1 1.0 0.9]   ;; row 0: two 2-wide cells
                     [0.2 0.3 0.8 0.7]]  ;; row 1
        cells (glyph/segment-row line-image 2)]
    (is (= 2 (count cells)))
    (is (= [0.0 0.1 0.2 0.3] (nth cells 0)))
    (is (= [1.0 0.9 0.8 0.7] (nth cells 1)))))

(deftest segment-row-throws-on-non-dividing-width
  (is (thrown? #?(:clj Exception :cljs js/Error)
               (glyph/segment-row [[0.0 0.1 0.2]] 2))))

(deftest cosine-similarity-identical-vectors-is-one-orthogonal-is-zero
  (is (< 0.999 (glyph/cosine-similarity backend a-fns b-fns [1.0 0.0] [1.0 0.0])))
  (is (< (Math/abs (glyph/cosine-similarity backend a-fns b-fns [1.0 0.0] [0.0 1.0])) 1e-9)))

(deftest best-match-picks-the-closer-template-under-noise
  (let [templates {\A [1.0 0.0 0.0 0.0]
                    \B [0.0 1.0 0.0 0.0]
                    \C [0.0 0.0 1.0 0.0]}
        ;; a noisy near-copy of the \B template
        noisy-b [0.05 0.9 0.05 0.0]]
    (is (= \B (first (glyph/best-match backend a-fns b-fns noisy-b templates))))))

(deftest best-match-nil-on-empty-template-bank
  (is (nil? (glyph/best-match backend a-fns b-fns [1.0 0.0] {}))))

(deftest decode-line-end-to-end-with-synthetic-glyphs
  (testing "two synthetic 'characters', each a distinct 2x2 pattern, decode correctly"
    (let [template-bank {\X [1.0 1.0 1.0 1.0]
                          \Y [1.0 0.0 1.0 0.0]}
          ;; line-image: 2 rows x 4 cols = two 2x2 cells: cell0 ~ X, cell1 ~ Y
          line-image [[0.95 1.0 1.0 0.05]
                      [0.9  1.0 1.0 0.0]]
          out (glyph/decode-line backend a-fns b-fns line-image
                                  {:glyph-count 2 :template-bank template-bank})]
      (is (= "XY" (:text out)))
      (is (= 2 (count (:scores out))))
      (is (every? #(< 0.9 %) (:scores out)) "both cells should score a high-confidence match"))))
