(ns mrz.model-test
  (:require [kotoba.test :refer [deftest is]]
            [mrz.model :as model]))

(deftest split-name-primary-and-secondary
  (is (= {:primary "ERIKSSON" :secondary ["ANNA" "MARIA"]}
         (model/split-name "ERIKSSON<<ANNA<MARIA<<<<<<<<<<<<<<<<<<<<<<<"))))

(deftest split-name-compound-surname-and-no-given-names
  (is (= {:primary "VAN DER BERG" :secondary []}
         (model/split-name "VAN<DER<BERG<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<"))))

(deftest field-slices-1-indexed-icao-range-into-0-indexed-subs
  (is (= "P<" (model/field "P<UTOERIKSSON" (:doc-type (:line1 model/td3)))))
  (is (= "UTO" (model/field "P<UTOERIKSSON" (:issuing-state (:line1 model/td3))))))
