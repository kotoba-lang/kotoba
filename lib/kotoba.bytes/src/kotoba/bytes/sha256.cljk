;; kotoba.bytes.sha256 — pure SHA-256 (FIPS 180-4) + HMAC-SHA256 (RFC 2104),
;; portable across JVM Clojure and ClojureScript. Same shape as
;; `kotoba.bytes.sha1`: no platform crypto API, bytes in and bytes out as
;; `kotoba.bytes` byte-vectors (vector<int 0..255>).
;;
;; Why this exists rather than a wrapper over MessageDigest / crypto.subtle:
;; those two disagree on more than spelling. `MessageDigest` returns a value;
;; `crypto.subtle.digest` returns a Promise. Every consumer that wanted one
;; digest function across both runtimes had to either fork its own code path or
;; make the whole call chain async — so instead of doing that once, this
;; workspace did it 112 times, each repo hand-rolling its own `sha256` and its
;; own `hmac`. A pure implementation is **synchronous on both runtimes**, which
;; removes the reason those forks existed.
;;
;; The trade is speed: this is Clojure arithmetic, not a native digest. It is
;; the right choice for signatures, identifiers, checksums and canonical hashes
;; — kilobytes at a time. For hashing large payloads, keep using the platform
;; primitive behind whatever seam you already have (e.g. `sigv4.protocols`).
(ns kotoba.bytes.sha256
  {:kotoba/export [sha256-bytes hmac-sha256 sha256-hex hmac-sha256-hex]}
  (:require [kotoba.bytes :as b]))

;; Dual-runtime reading (see kotoba.bytes): `#?(:kotoba A :default B)` is A in
;; the Kotoba module and B on the JVM / ClojureScript, so the host bodies below
;; are the operations they always were. Bytes and words are `:vector-i64` on
;; Kotoba; the leaves below are the only places the two hosts differ.

(def ^:private mask32 0xffffffff)

;; ---- leaves: one per primitive that differs between the hosts ----

(defn- shl [#?@(:kotoba [x :i64 n :i64] :default [x n])] #?@(:kotoba [:i64])
  #?(:kotoba (i64-shift-left x n) :default (bit-shift-left x n)))

;; logical right shift; every operand is a non-negative 32-bit value
(defn- shr [#?@(:kotoba [x :i64 n :i64] :default [x n])] #?@(:kotoba [:i64])
  #?(:kotoba (i64-shift-right x n) :default (unsigned-bit-shift-right x n)))

(defn- vnew [] #?@(:kotoba [:vector-i64])
  #?(:kotoba (vector-i64) :default []))

(defn- vpush [#?@(:kotoba [v :vector-i64 x :i64] :default [v x])] #?@(:kotoba [:vector-i64])
  #?(:kotoba (vector-conj v x) :default (conj v x)))

(defn- vat [#?@(:kotoba [v :vector-i64 i :i64] :default [v i])] #?@(:kotoba [:i64])
  #?(:kotoba (vector-at v i) :default (nth v i)))

(defn- vlen [#?@(:kotoba [v :vector-i64] :default [v])] #?@(:kotoba [:i64])
  #?(:kotoba (vector-count v) :default (count v)))

(defn- as-vec [#?@(:kotoba [v :vector-i64] :default [v])] #?@(:kotoba [:vector-i64])
  #?(:kotoba v :default (vec v)))

(defn- vcat [#?@(:kotoba [a :vector-i64 b :vector-i64] :default [a b])] #?@(:kotoba [:vector-i64])
  #?(:kotoba
     (let [n (vector-count b)]
       (loop [i 0 out a]
         (if (>= i n) out (recur (+ i 1) (vector-conj out (vector-at b i))))))
     :default (into a b)))

;; ---- 32-bit arithmetic ----

(defn- m32 [#?@(:kotoba [x :i64] :default [x])] #?@(:kotoba [:i64])
  (bit-and x mask32))

(defn- rotr32 [#?@(:kotoba [x :i64 n :i64] :default [x n])] #?@(:kotoba [:i64])
  (m32 (bit-or (shr x n) (shl x (- 32 n)))))

(defn- not32 [#?@(:kotoba [x :i64] :default [x])] #?@(:kotoba [:i64])
  #?(:kotoba (bit-xor x mask32) :default (bit-not x)))

(defn- add32 [#?@(:kotoba [a :i64 b :i64] :default [a b])] #?@(:kotoba [:i64])
  (m32 (+ a b)))

(defn- xor3 [#?@(:kotoba [a :i64 b :i64 c :i64] :default [a b c])] #?@(:kotoba [:i64])
  (bit-xor (bit-xor a b) c))

;; FIPS 180-4 §5.3.3 — the first 32 bits of the fractional parts of the square
;; roots of the first eight primes.
(def ^:private h-init-const
  [0x6a09e667 0xbb67ae85 0x3c6ef372 0xa54ff53a
   0x510e527f 0x9b05688c 0x1f83d9ab 0x5be0cd19])

;; §4.2.2 — cube roots of the first sixty-four primes.
(def ^:private k-const
  [0x428a2f98 0x71374491 0xb5c0fbcf 0xe9b5dba5 0x3956c25b 0x59f111f1 0x923f82a4 0xab1c5ed5
   0xd807aa98 0x12835b01 0x243185be 0x550c7dc3 0x72be5d74 0x80deb1fe 0x9bdc06a7 0xc19bf174
   0xe49b69c1 0xefbe4786 0x0fc19dc6 0x240ca1cc 0x2de92c6f 0x4a7484aa 0x5cb0a9dc 0x76f988da
   0x983e5152 0xa831c66d 0xb00327c8 0xbf597fc7 0xc6e00bf3 0xd5a79147 0x06ca6351 0x14292967
   0x27b70a85 0x2e1b2138 0x4d2c6dfc 0x53380d13 0x650a7354 0x766a0abb 0x81c2c92e 0x92722c85
   0xa2bfe8a1 0xa81a664b 0xc24b8b70 0xc76c51a3 0xd192e819 0xd6990624 0xf40e3585 0x106aa070
   0x19a4c116 0x1e376c08 0x2748774c 0x34b0bcb5 0x391c0cb3 0x4ed8aa4a 0x5b9cca4f 0x682e6ff3
   0x748f82ee 0x78a5636f 0x84c87814 0x8cc70208 0x90befffa 0xa4506ceb 0xbef9a3f7 0xc67178f2])


(defn- h-init [] #?@(:kotoba [:vector-i64])
  (as-vec h-init-const))

(defn- k [#?@(:kotoba [t :i64] :default [t])] #?@(:kotoba [:i64])
  (vat k-const t))

(defn- pad-zeros [#?@(:kotoba [v :vector-i64 n :i64] :default [v n])] #?@(:kotoba [:vector-i64])
  (loop [i 0 out v]
    (if (>= i n) out (recur (+ i 1) (vpush out 0)))))

(defn- word32-bytes
  "The four big-endian bytes of the 32-bit word X."
  [#?@(:kotoba [x :i64] :default [x])] #?@(:kotoba [:vector-i64])
  (vpush (vpush (vpush (vpush (vnew) (bit-and (shr x 24) 0xff))
                       (bit-and (shr x 16) 0xff))
                (bit-and (shr x 8) 0xff))
         (bit-and x 0xff)))

(defn- pad-message
  "FIPS 180-4 §5.1.1: append 0x80, zero-pad to 56 mod 64, then the original
   bit-length as a big-endian 64-bit integer — written as two 32-bit words,
   since a single 64-bit shift is not cljs-safe."
  [#?@(:kotoba [msg :vector-i64] :default [msg])] #?@(:kotoba [:vector-i64])
  (let [byte-len (vlen msg)
        bit-len (* byte-len 8)
        with-marker (vpush (as-vec msg) 0x80)
        rem64 (bit-and (vlen with-marker) 63)
        pad-len (bit-and (- 56 rem64) 63)
        padded (pad-zeros with-marker pad-len)
        hi (m32 (quot bit-len 0x100000000))
        lo (m32 bit-len)]
    (vcat (vcat padded (word32-bytes hi)) (word32-bytes lo))))

(defn- block-word
  "The big-endian 32-bit word at byte offset O of PADDED."
  [#?@(:kotoba [padded :vector-i64 o :i64] :default [padded o])] #?@(:kotoba [:i64])
  (m32 (bit-or (bit-or (shl (vat padded o) 24) (shl (vat padded (+ o 1)) 16))
               (bit-or (shl (vat padded (+ o 2)) 8) (vat padded (+ o 3))))))

(defn- schedule
  "§6.2.2 step 1: the 64-word message schedule for the 512-bit block of
   PADDED at OFFSET."
  [#?@(:kotoba [padded :vector-i64 offset :i64] :default [padded offset])] #?@(:kotoba [:vector-i64])
  (loop [w (vnew) t 0]
    (if (= t 64)
      w
      (recur (vpush w (if (< t 16)
                        (block-word padded (+ offset (* t 4)))
                        (let [w15 (vat w (- t 15))
                              w2  (vat w (- t 2))
                              s0 (xor3 (rotr32 w15 7) (rotr32 w15 18) (shr w15 3))
                              s1 (xor3 (rotr32 w2 17) (rotr32 w2 19) (shr w2 10))]
                          (add32 (add32 (add32 (vat w (- t 16)) s0) (vat w (- t 7))) s1))))
             (inc t)))))

(defn- vec8 [#?@(:kotoba [a :i64 b :i64 c :i64 d :i64 e :i64 f :i64 g :i64 h :i64] :default [a b c d e f g h])]
  #?@(:kotoba [:vector-i64])
  (vpush (vpush (vpush (vpush (vpush (vpush (vpush (vpush (vnew) a) b) c) d) e) f) g) h))

(defn- compress
  "§6.2.2 steps 2-4: one block's (at OFFSET of PADDED) contribution to the running hash H."
  [#?@(:kotoba [h :vector-i64 padded :vector-i64 offset :i64] :default [h padded offset])] #?@(:kotoba [:vector-i64])
  (let [w (schedule padded offset)
        h0 (vat h 0) h1 (vat h 1) h2 (vat h 2) h3 (vat h 3)
        h4 (vat h 4) h5 (vat h 5) h6 (vat h 6) h7 (vat h 7)]
    (loop [t 0 a h0 b h1 c h2 d h3 e h4 f h5 g h6 hh h7]
      (if (= t 64)
        (vec8 (add32 h0 a) (add32 h1 b) (add32 h2 c) (add32 h3 d)
              (add32 h4 e) (add32 h5 f) (add32 h6 g) (add32 h7 hh))
        (let [s1 (xor3 (rotr32 e 6) (rotr32 e 11) (rotr32 e 25))
              ch (bit-xor (bit-and e f) (bit-and (not32 e) g))
              t1 (add32 (add32 (add32 (add32 hh s1) (m32 ch)) (k t)) (vat w t))
              s0 (xor3 (rotr32 a 2) (rotr32 a 13) (rotr32 a 22))
              maj (xor3 (bit-and a b) (bit-and a c) (bit-and b c))
              t2 (add32 s0 (m32 maj))]
          (recur (inc t) (add32 t1 t2) a b c (add32 d t1) e f g))))))

(defn- run-blocks
  "The running hash after every 64-byte block of PADDED."
  [#?@(:kotoba [padded :vector-i64] :default [padded])] #?@(:kotoba [:vector-i64])
  (let [n (vlen padded)]
    (loop [h (h-init) off 0]
      (if (>= off n) h (recur (compress h padded off) (+ off 64))))))

(defn- digest-bytes
  "The 32 big-endian bytes of the eight hash words H."
  [#?@(:kotoba [h :vector-i64] :default [h])] #?@(:kotoba [:vector-i64])
  (loop [i 0 out (vnew)]
    (if (= i 8)
      out
      (recur (+ i 1) (vcat out (word32-bytes (vat h i)))))))

(defn sha256-bytes
  "SHA-256 of a byte-vector → a 32-byte vector."
  [#?@(:kotoba [msg :vector-i64] :default [msg])] #?@(:kotoba [:vector-i64])
  (digest-bytes (run-blocks (pad-message msg))))

(def ^:private block-size 64)

(defn- xor-each [#?@(:kotoba [v :vector-i64 x :i64] :default [v x])] #?@(:kotoba [:vector-i64])
  (let [n (vlen v)]
    (loop [i 0 out (vnew)]
      (if (>= i n) out (recur (+ i 1) (vpush out (bit-xor (vat v i) x)))))))

(defn hmac-sha256
  "HMAC-SHA256 (RFC 2104) of a byte-vector under a byte-vector key → 32 bytes.
   Keys longer than the 64-byte block are hashed first, shorter ones zero-padded."
  [#?@(:kotoba [key :vector-i64 msg :vector-i64] :default [key msg])] #?@(:kotoba [:vector-i64])
  (let [k0 (as-vec (if (> (vlen key) block-size) (sha256-bytes (as-vec key)) key))
        k1 (pad-zeros k0 (- block-size (vlen k0)))
        ipad (xor-each k1 0x36)
        opad (xor-each k1 0x5c)]
    (sha256-bytes (vcat opad (sha256-bytes (vcat ipad (as-vec msg)))))))

;; ── string-in / hex-out conveniences ─────────────────────────────────────────
;;
;; The overwhelmingly common shape at the call sites this replaces is
;; "UTF-8 string in, lowercase hex out", so it is worth not making every caller
;; spell the conversion out.

(defn sha256-hex
  "Lowercase hex SHA-256 of a UTF-8 string or a byte-vector. Kotoba has no run-time
   type to dispatch on: there X is the byte vector (`kotoba.bytes/utf8-encode`
   of a string, made by the caller), as in `kotoba.bytes/->bytes`."
  [#?@(:kotoba [x :vector-i64] :default [x])] #?@(:kotoba [:string])
  #?(:kotoba (b/hex (sha256-bytes x))
     :default (b/hex (sha256-bytes (if (string? x) (b/utf8-encode x) x)))))

(defn hmac-sha256-hex
  "Lowercase hex HMAC-SHA256. `key` and `msg` may each be a UTF-8 string or a
   byte-vector."
  [#?@(:kotoba [key :vector-i64 msg :vector-i64] :default [key msg])] #?@(:kotoba [:string])
  #?(:kotoba (b/hex (hmac-sha256 key msg))
     :default (b/hex (hmac-sha256 (if (string? key) (b/utf8-encode key) key)
                                  (if (string? msg) (b/utf8-encode msg) msg)))))
