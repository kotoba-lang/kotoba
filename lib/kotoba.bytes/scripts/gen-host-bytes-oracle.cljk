;; The ORACLE for kotoba.bytes' host-bytes functions: JDK 21 itself.
;;
;; This file is JVM-only on purpose -- the expected answers have to come from
;; java.util.Base64 and java.lang.String, not from a second transcription of
;; them. It writes test/kotoba/bytes/host_bytes_oracle.edn, which
;; test/kotoba/bytes/host_bytes_test.cljk replays on every host.
;;
;; Run from the repository root with a JDK 21 and a Clojure jar on the
;; classpath, e.g.
;;   java -cp <clojure.jar>:<spec.alpha.jar>:<core.specs.alpha.jar> clojure.main scripts/gen-host-bytes-oracle.cljk
;; The corpus is seeded (java.util.Random 20260924): regenerating it on the same
;; JDK gives the same file.
;;
;; Strings are written as vectors of UTF-16 code units, never as EDN strings:
;; a lone surrogate does not survive every reader/printer, and the lone
;; surrogates are the point of half the corpus.
(ns gen-host-bytes-oracle
  (:import (java.util Base64 Random)
           (java.nio.charset StandardCharsets)))

(def rnd (Random. 20260924))
(defn ri [n] (.nextInt rnd n))
(defn pick [xs] (nth xs (ri (count xs))))

(defn units [^String s] (mapv int s))
(defn ubytes [^bytes b] (mapv #(bit-and % 0xff) b))
(defn rand-bytes [n] (let [b (byte-array n)] (.nextBytes rnd b) b))

(def decoders {:std (Base64/getDecoder) :url (Base64/getUrlDecoder) :mime (Base64/getMimeDecoder)})

(defn b64-case [dec x]
  (let [^java.util.Base64$Decoder d (decoders dec)
        r (try (ubytes (if (string? x) (.decode d ^String x) (.decode d ^bytes x)))
               (catch IllegalArgumentException _ :throws))]
    (cond-> {:f dec :out r}
      (string? x) (assoc :in-units (units x))
      (not (string? x)) (assoc :in-bytes (ubytes x)))))

(def noise ["=" "==" "\n" "\r\n" " " "\t" "!" "-" "_" "+" "/" "." "é" "ÿ"
            "Ā" "あ" "😀" "\ud800" "\udc00" "A" "Q" "w" "0" "9"])

(defn mutate [^String s]
  (let [n (count s)]
    (case (int (ri 5))
      0 (let [i (ri (inc n))] (str (subs s 0 i) (pick noise) (subs s i)))
      1 (if (pos? n) (let [i (ri n)] (str (subs s 0 i) (subs s (inc i)))) s)
      2 (subs s 0 (ri (inc n)))
      3 (let [i (ri (inc n))] (str (subs s 0 i) (pick noise) (pick noise) (subs s i)))
      4 (str s (pick noise)))))

(defn encodings [^bytes b]
  [(.encodeToString (Base64/getEncoder) b)
   (.encodeToString (.withoutPadding (Base64/getEncoder)) b)
   (.encodeToString (Base64/getUrlEncoder) b)
   (.encodeToString (.withoutPadding (Base64/getUrlEncoder)) b)
   (.encodeToString (Base64/getMimeEncoder) b)
   (.encodeToString (Base64/getMimeEncoder 8 (.getBytes " \n" StandardCharsets/ISO_8859_1)) b)])

(defn base64-corpus []
  (let [small-alpha ["A" "Q" "=" "-" "_" "+" "/" "\n" " " "!" "é" "😀"]
        exhaustive (for [n (range 0 4)
                         combo (loop [acc [""] k n]
                                 (if (zero? k) acc (recur (for [a acc c small-alpha] (str a c)) (dec k))))]
                     combo)
        valid (for [n (concat (range 0 64) (repeatedly 40 #(ri 120)))
                    s (encodings (rand-bytes n))]
                s)
        mutated (for [s (take 900 (cycle valid)) :let [k (inc (ri 3))]]
                  (nth (iterate mutate s) k))
        random-junk (repeatedly 200 #(apply str (repeatedly (ri 12) (fn [] (pick noise)))))
        byte-inputs (concat (for [s (take 120 valid)] (.getBytes ^String s StandardCharsets/ISO_8859_1))
                            (repeatedly 120 #(rand-bytes (ri 16)))
                            (for [s (take 120 mutated)] (.getBytes ^String s StandardCharsets/UTF_8)))]
    (vec (for [x (concat exhaustive valid mutated random-junk byte-inputs)
               dec [:std :url :mime]]
           (b64-case dec x)))))

(def unit-pool
  [0x41 0x7A 0x00 0x7F 0x80 0xE9 0x7FF 0x800 0x3042 0xFFFD 0xFFFF
   0xD800 0xDBFF 0xDC00 0xDFFF 0xD83D 0xDE00])

(defn rand-units-string []
  (let [n (ri 10)]
    (String. (char-array (repeatedly n #(char (if (zero? (ri 4)) (ri 0x10000) (pick unit-pool)))))))
  )

(defn utf8-bytes-corpus []
  (vec (for [s (concat ["" "hi" "日本語" "😀" "\ud800" "\udc00" "\udc00\ud800"
                        "a\ud800" "\ud800a" "\ud83d" "\ude00😀"]
                       (repeatedly 1500 rand-units-string))]
         {:f :utf8-bytes :in-units (units s) :out (ubytes (.getBytes ^String s StandardCharsets/UTF_8))})))

(def byte-pool
  [0x00 0x41 0x7F 0x80 0x8F 0x90 0x9F 0xA0 0xBF 0xC0 0xC1 0xC2 0xDF 0xE0 0xE1
   0xEC 0xED 0xEE 0xEF 0xF0 0xF1 0xF3 0xF4 0xF5 0xF7 0xF8 0xFB 0xFC 0xFE 0xFF])

(defn utf8-string-case [^bytes b]
  {:f :utf8-string :in-bytes (ubytes b) :out (units (String. b StandardCharsets/UTF_8))})

(defn utf8-string-corpus []
  (let [bs (fn [xs] (byte-array (map unchecked-byte xs)))
        leads (filter #(>= % 0xC0) byte-pool)
        conts [0x80 0x8F 0x90 0x9F 0xA0 0xBF 0x41 0xC2]
        exhaustive (concat
                    (for [a (range 256)] [a])
                    (for [a leads b conts] [a b])
                    (for [a leads b conts c conts] [a b c])
                    (for [a (filter #(>= % 0xF0) leads) b conts c [0x80 0x41] d [0x80 0x41]] [a b c d]))
        valid (for [_ (range 300)] (vec (.getBytes ^String (rand-units-string) StandardCharsets/UTF_8)))
        rand-pool (repeatedly 1500 (fn [] (vec (repeatedly (ri 14) #(if (zero? (ri 5)) (ri 256) (pick byte-pool))))))]
    (vec (for [xs (concat exhaustive valid rand-pool)]
           (utf8-string-case (bs xs))))))

(let [cases (vec (concat (base64-corpus) (utf8-bytes-corpus) (utf8-string-corpus)))
      path "test/kotoba/bytes/host_bytes_oracle.edn"]
  (binding [*print-length* nil *print-level* nil]
    (spit path
          (str ";; GENERATED by scripts/gen-host-bytes-oracle.cljk from "
               (System/getProperty "java.vendor") " " (System/getProperty "java.version")
               " -- do not edit. Each entry: {:f fn :in-units|:in-bytes input :out expected}.\n"
               ";; :out :throws = the JDK threw IllegalArgumentException. Strings are UTF-16 code-unit vectors.\n"
               "[\n"
               (apply str (map #(str (pr-str %) "\n") cases))
               "]\n")))
  (println "wrote" path (count cases) "cases"
           (frequencies (map :f cases))
           "throws:" (count (filter #(= :throws (:out %)) cases))))
