(ns kotoba.bytes.host-bytes-test
  "The host-bytes functions claim the JDK's exact answers. The claim is tested
   against the JDK itself: host_bytes_oracle.edn is what JDK 21 answered for a
   seeded random + adversarial corpus (scripts/gen-host-bytes-oracle.cljk), and
   every entry is replayed here on whichever host runs this suite."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.bytes :as b]
            #?(:clj [clojure.edn :as edn] :cljs [cljs.reader :as edn])))

(def ^:private oracle-path "lib/kotoba.bytes/test/kotoba/bytes/host_bytes_oracle.edn")

(defn- read-oracle []
  (edn/read-string #?(:clj (slurp oracle-path)
                      :cljs (.readFileSync (js/require "fs") oracle-path "utf8"))))

(defn- units->string [us]
  #?(:clj (String. (char-array (map char us)))
     :cljs (apply str (map #(js/String.fromCharCode %) us))))

(defn- string->units [s]
  #?(:clj (mapv int s)
     :cljs (mapv #(.charCodeAt s %) (range (count s)))))

(defn- host-bytes? [x]
  #?(:clj (bytes? x) :cljs (instance? js/Int8Array x)))

(defn- unsigned [x] (mapv #(bit-and % 0xff) x))

(def ^:private fns
  {:std b/base64-decode-bytes :url b/base64url-decode-bytes :mime b/base64mime-decode-bytes})

(defn- actual [{:keys [f in-units in-bytes]}]
  (let [in (if in-units (units->string in-units) (b/->host-bytes in-bytes))]
    (try
      (case f
        (:std :url :mime) (let [r ((fns f) in)]
                            (if (host-bytes? r) (unsigned r) [:not-host-bytes r]))
        :utf8-bytes (let [r (b/utf8-bytes in)]
                      (if (host-bytes? r) (unsigned r) [:not-host-bytes r]))
        :utf8-string (string->units (b/utf8-string in)))
      (catch :default e
        (if (= :illegal-base64 (:kotoba.bytes/error (ex-data e)))
          :throws
          [:other-error (ex-message e)])))))

(deftest every-oracle-entry-matches-the-jdk
  (let [cases (read-oracle)
        bad (remove #(= (:out %) (actual %)) cases)]
    (println (str "SCANNED\t" (count cases) "\tmismatches\t" (count bad)))
    (testing "the corpus was read (0 entries is not a pass)"
      (is (< 17000 (count cases)))
      (is (= #{:std :url :mime :utf8-bytes :utf8-string} (set (map :f cases))))
      (is (< 1000 (count (filter #(= :throws (:out %)) cases))) "the corpus exercises the throwing paths"))
    (doseq [c (take 5 bad)]
      (println "MISMATCH" (pr-str c) "got" (pr-str (actual c))))
    (is (= 0 (count bad)))))

(deftest literal-cases
  (testing "decoders answer host bytes"
    (is (host-bytes? (b/base64-decode-bytes "aGk=")))
    (is (= [104 105] (unsigned (b/base64-decode-bytes "aGk="))))
    (is (= [104 105] (unsigned (b/base64-decode-bytes "aGk"))) "padding is optional")
    (is (= [0xfb 0xff] (unsigned (b/base64url-decode-bytes "-_8"))))
    (is (= [104 105] (unsigned (b/base64mime-decode-bytes "aG\r\nk=")))))
  (testing "bytes in, as the JDK's decode(byte[]) overload"
    (is (= [104 105] (unsigned (b/base64-decode-bytes (b/utf8-bytes "aGk="))))))
  (testing "bad input throws ex-info naming :illegal-base64, with the JDK's message"
    (doseq [[f s msg] [[b/base64-decode-bytes "a!Gk" "Illegal base64 character 21"]
                       [b/base64-decode-bytes "-_8" "Illegal base64 character 2d"]
                       [b/base64url-decode-bytes "+/8=" "Illegal base64 character 2b"]
                       [b/base64-decode-bytes "Q" "Input byte[] should at least have 2 bytes for base64 bytes"]
                       [b/base64-decode-bytes "QQ=" "Input byte array has wrong 4-byte ending unit"]
                       [b/base64-decode-bytes "QUFBQ" "Last unit does not have enough valid bits"]
                       [b/base64mime-decode-bytes "QQ==QQ" "Input byte array has incorrect ending byte at 5"]]]
      (let [e (try (f s) nil (catch :default e e))]
        (is (= :illegal-base64 (:kotoba.bytes/error (ex-data e))) s)
        (is (= msg (ex-message e)) s))))
  (testing "utf8-bytes: host bytes, a lone surrogate is `?`"
    (is (host-bytes? (b/utf8-bytes "hi")))
    (is (= [0x61 0x3F 0x62] (unsigned (b/utf8-bytes (str "a" (units->string [0xD800]) "b")))))
    (is (= [0xF0 0x9F 0x98 0x80] (unsigned (b/utf8-bytes (units->string [0xD83D 0xDE00]))))))
  (testing "utf8-string: the JDK's U+FFFD granularity"
    (is (= "hé" (b/utf8-string (b/utf8-bytes "hé"))))
    (is (= [0xFFFD] (string->units (b/utf8-string [0xED 0xA0 0x80]))) "an encoded surrogate is one U+FFFD")
    (is (= [0xFFFD 0xFFFD 0xFFFD] (string->units (b/utf8-string [0xE0 0x80 0x80]))) "an overlong 3-byte form is three")
    (is (= [0xFFFD 0x41] (string->units (b/utf8-string [0xC2 0x41])))))
  (testing "the encoders read every host container (a Uint8Array / Buffer is not ICounted on cljs)"
    (doseq [x [#?(:clj (byte-array [104 105]) :cljs (js/Uint8Array.from #js [104 105]))
               #?(:clj (byte-array [104 105]) :cljs (js/Int8Array.from #js [104 105]))
               #?(:clj (byte-array [104 105]) :cljs (.from (.-Buffer (js/require "buffer")) #js [104 105]))
               (b/utf8-bytes "hi")]]
      (is (= "aGk=" (b/base64-encode x)))
      (is (= "aGk" (b/base64url-encode x {:pad? false})))))
  (testing "nil is refused, not answered (the JDK threw NullPointerException)"
    (doseq [f [b/base64-decode-bytes b/utf8-bytes b/utf8-string]]
      (is (thrown? :default (f nil))))))
