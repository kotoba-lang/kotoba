(ns kotoba.securities.isin-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.securities.isin :as isin]))

;; Published ISINs of listed securities (public identifiers, no account data).
(deftest valid-isins-test
  (doseq [s ["US0378331005" "DE0007164600" "JP3633400001" "GB0002634946" "XS2021832634" "US5949181045"]]
    (testing s (is (isin/isin-valid? s)))))

(deftest check-digit-test
  (is (= 5 (isin/check-digit "US037833100")))
  (is (= 0 (isin/check-digit "DE000716460")))
  (is (= 1 (isin/check-digit "JP363340000")))
  (is (nil? (isin/check-digit "us037833100")))
  (is (nil? (isin/check-digit "US03783310"))))

(deftest invalid-isins-test
  (testing "a wrong check digit"
    (is (not (isin/isin-valid? "US0378331006"))))
  (testing "transposed digits change the check"
    (is (not (isin/isin-valid? "US0378313005"))))
  (testing "shape"
    (doseq [s ["" "US037833100" "US03783310055" "us0378331005" "1S0378331005" "US037833100X" nil 12]]
      (is (not (isin/isin-valid? s)) (pr-str s)))))
