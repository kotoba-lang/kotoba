(ns kotoba.securities.isin
  "ISIN (ISO 6166) validation: shape and check digit. No network, no I/O.

  Shape is the ISO 20022 ISINOct2015Identifier pattern
  [A-Z]{2}[A-Z0-9]{9}[0-9]: a two-letter prefix (a country code or an
  issuing-agency prefix such as XS), nine alphanumerics and a check digit.
  The check digit: letters become two digits (A=10 .. Z=35), then the Luhn
  algorithm runs over the resulting digit string, doubling every second
  digit from the right of the payload. The prefix is not checked against a
  list of country codes."
  (:require [kotoba.lang.text :as str]))

(def ^:private letter-values
  (zipmap "ABCDEFGHIJKLMNOPQRSTUVWXYZ" (range 10 36)))
(def ^:private digit-values
  (zipmap "0123456789" (range 10)))

(defn- expand
  "The payload's characters as a digit vector, letters as two digits."
  [s]
  (vec (mapcat (fn [c]
                 (if-let [d (digit-values c)]
                   [d]
                   (let [v (letter-values c)] [(quot v 10) (rem v 10)])))
               s)))

(defn check-digit
  "The ISIN check digit (0-9) for an 11-character payload, or nil when the
  payload is not [A-Z]{2}[A-Z0-9]{9}."
  [payload]
  (when (and (string? payload) (re-matches #"[A-Z]{2}[A-Z0-9]{9}" payload))
    (let [digits (rseq (expand payload))
          total (reduce + (map-indexed (fn [i d]
                                         (if (even? i)
                                           (let [x (* 2 d)] (if (> x 9) (- x 9) x))
                                           d))
                                       digits))]
      (rem (- 10 (rem total 10)) 10))))

(defn isin-valid?
  "True for a 12-character ISIN with the right shape and check digit."
  [s]
  (boolean
   (when (and (string? s) (re-matches #"[A-Z]{2}[A-Z0-9]{9}[0-9]" s))
     (= (check-digit (subs s 0 11)) (digit-values (last s))))))
