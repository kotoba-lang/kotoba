;; No dependencies. RTSP (RFC 2326) is an HTTP-shaped text header grammar
;; plus one small binary frame format (interleaved data: a marker byte, a
;; channel byte, a 16-bit length) — string splitting and
;; bit-and/bit-or/bit-shift-left/unsigned-bit-shift-right on plain
;; integers, nothing a library would improve on.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
