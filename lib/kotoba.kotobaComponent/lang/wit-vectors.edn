;; Frozen WIT emission vectors (CI6, WIT layer).
;;
;; kotoba.component.wit is now .cljc, so ClojureScript can emit a world
;; from the same checked KIR. scripts/verify_wit_cljs.cljk recomputes
;; every :source and :sha256 below and fails on any difference.
;;
;; The WIT text is the cross-implementation contract; the digest is a
;; digest OF that text, so identical text implies an identical digest.
;; Both are frozen anyway, because a digest that agreed while the text
;; differed would mean the hashing input was not what it claims.
;;
;; DO NOT hand-edit a digest to make a run pass.
;; Regenerate: kbb -M -e "(load-file \"scripts/gen_wit_vectors.cljk\")"

{:kotoba.component.wit-vectors/version 1
 :vectors
 [
  {:id :pure-export, :note "No effects: a world with one export and no imports.", :kir {:format :kotoba.kir/v3, :schemas {}, :exports [main], :functions [{:name main, :params [], :param-types [], :result :i64, :body [1]}]}, :source "package kotoba:application@1.0.0;\n\nworld application {\n  export main: func() -> s64;\n}\n", :sha256 "b1c8a7fe253842ca9e820f5164504ba2aa2444941d8a7cf989dada6ea1454427", :imports [], :exports [main], :target :wasm-component-kotoba-v1}

  {:id :single-capability, :note "One effectful import; exercises the capability interface grouping.", :kir {:format :kotoba.kir/v3, :schemas {}, :exports [main], :functions [{:name main, :params [], :param-types [], :result :i64, :body [(typed-cap-call 7 :i64 :i64)]}]}, :source "package kotoba:application@1.0.0;\n\ninterface clock {\n  now: func(request: s64) -> s64;\n}\n\nworld application {\n  import clock;\n  export main: func() -> s64;\n}\n", :sha256 "f3d392d54e1d875257c390aeba42138025082676b2382a3dfb6750a90f811426", :imports [:clock/now], :exports [main], :target :wasm-component-kotoba-v1}

  {:id :two-capabilities-one-interface, :note "Two capabilities in the same interface must group deterministically.", :kir {:format :kotoba.kir/v3, :schemas {}, :exports [main], :functions [{:name main, :params [], :param-types [], :result :i64, :body [(typed-cap-call 5 :i64 :i64) (typed-cap-call 6 :i64 :i64)]}]}, :source "package kotoba:application@1.0.0;\n\ninterface log {\n  read: func(request: s64) -> s64;\n  append: func(request: s64) -> s64;\n}\n\nworld application {\n  import log;\n  export main: func() -> s64;\n}\n", :sha256 "724e24e0f8baaf53e27e09f6950efa00f613c2dfad73b4ba66f04c38e92b677a", :imports [:log/read :log/append], :exports [main], :target :wasm-component-kotoba-v1}

  {:id :capabilities-across-interfaces, :note "Interfaces are emitted in sorted order regardless of call order.", :kir {:format :kotoba.kir/v3, :schemas {}, :exports [main], :functions [{:name main, :params [], :param-types [], :result :i64, :body [(typed-cap-call 9 :i64 :i64) (typed-cap-call 7 :i64 :i64) (typed-cap-call 4 :i64 :i64)]}]}, :source "package kotoba:application@1.0.0;\n\ninterface clock {\n  now: func(request: s64) -> s64;\n}\n\ninterface http-post {\n  post: func(request: s64) -> s64;\n}\n\ninterface ui {\n  commit: func(request: s64) -> s64;\n}\n\nworld application {\n  import clock;\n  import http-post;\n  import ui;\n  export main: func() -> s64;\n}\n", :sha256 "204a51b77894cf92e7d17e1218fae1b5666f76d004d5fc5a2145aefc0530ab35", :imports [:http/post :clock/now :ui/commit], :exports [main], :target :wasm-component-kotoba-v1}

  {:id :string-and-scalar-types, :note "Type mapping: the Kotoba->WIT table is where two implementations\n           could silently disagree.", :kir {:format :kotoba.kir/v3, :schemas {}, :exports [main], :functions [{:name main, :params [a b c], :param-types [:string :f64 :bool], :result :i64, :body [(typed-cap-call 7 :i64 :i64)]}]}, :source "package kotoba:application@1.0.0;\n\ninterface clock {\n  now: func(request: s64) -> s64;\n}\n\nworld application {\n  import clock;\n  export main: func(a: string, b: f64, c: bool) -> s64;\n}\n", :sha256 "e11a228e920b8a408775732a7cfc9b685984f463ed5f6df84ad77049c57add5e", :imports [:clock/now], :exports [main], :target :wasm-component-kotoba-v1}]}
