;; kbb --backend sci --classpath "src:test:$(kbb -Spath -M:test)" run-tests.cljk
;;
;; The portable side of this suite -- the first one this repository has.
;; Until 2026-09-11 every test here was JVM-only and `kotoba.component.*` was
;; the last JVM-only family amu's Node route stood on
;; (amu docs/jvm-route-topology.edn). Namespaces listed here must load on
;; nbb; anything added to test/ as portable belongs in BOTH lists below --
;; being required is not being run.
(ns run-tests
  (:require [cljs.test :as t]
            [kotoba.component.admission-portable-test]
            [kotoba.component.core-portable-test]
            [kotoba.component.embedded-resources-portable-test]
            [kotoba.component.resource-classpath-portable-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println (str "\nnbb: " (:test m) " tests, " (:pass m) " passed, "
                (:fail m) " failed, " (:error m) " errors"))
  (when-not (pos? (or (:test m) 0))
    (println "nbb: no tests ran -- that is a failure, not a pass")
    (set! (.-exitCode js/process) 1))
  (when (pos? (+ (or (:fail m) 0) (or (:error m) 0)))
    (set! (.-exitCode js/process) 1)))

(t/run-tests 'kotoba.component.admission-portable-test
             'kotoba.component.core-portable-test
             'kotoba.component.embedded-resources-portable-test
             'kotoba.component.resource-classpath-portable-test)
