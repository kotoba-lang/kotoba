;; kbb --backend sci scripts/gen_embedded_resources.cljk [--check]
;;
;; Writes src/kotoba/component/embedded_resources.cljk: the text of every
;; resource this repository's source reads, as string constants (superproject
;; adr-2609242330 S3, decision (b'): a classpath resource becomes compile-time
;; data, so reading it needs no ability and the text is part of the defining
;; module's identity). resources/ stays the authority; this file is its copy.
;;
;; --check  exit 0 when the committed module equals what would be written,
;;          exit 1 (and name the file) when it does not, exit 2 when a source
;;          resource is missing. Without --check the module is rewritten.
(ns gen-embedded-resources
  (:require ["node:fs" :as fs]
            ["node:path" :as path]))

(def root (path/resolve (path/dirname *file*) ".."))

(def resource-paths
  "Every resource path the source reads (kotoba.component.wit, .wasi-contract,
  .doctor, .composition). Sorted; the order is the order written."
  ["kotoba/lang/component-model-v1.edn"
   "wasi/0.3.0/clocks/monotonic-clock.wit"
   "wasi/0.3.0/clocks/system-clock.wit"
   "wasi/0.3.0/clocks/timezone.wit"
   "wasi/0.3.0/clocks/types.wit"
   "wasi/0.3.0/clocks/world.wit"
   "wasi/0.3.0/http/types.wit"
   "wasi/0.3.0/http/worlds.wit"])

(def target (path/join root "src" "kotoba" "component" "embedded_resources.cljk"))

(defn- read-resource [p]
  (let [f (path/join root "resources" p)]
    (when-not (fs/existsSync f)
      (binding [*print-fn* *print-err-fn*] (println "MISSING resource" f))
      (js/process.exit 2))
    (fs/readFileSync f "utf8")))

(defn- module-text []
  (str ";; GENERATED by scripts/gen_embedded_resources.cljk from resources/ -- do not edit.\n"
       ";; To change a text: edit the resource, then run the script. The portable test\n"
       ";; kotoba.component.embedded-resources-portable-test refuses a stale copy.\n"
       "(ns kotoba.component.embedded-resources\n"
       "  \"The resources this repository's source reads, as compile-time text\n"
       "  (superproject adr-2609242330 S3, decision (b')). `resource-text` answers\n"
       "  what `(slurp (io/resource path))` answered for these paths, and nil for\n"
       "  any other path, as io/resource did for a path not on the classpath.\"\n"
       "  {:kotoba/export [resource-text]})\n\n"
       ;; One private function per text, each literal spelled once: the
       ;; frontend counts the string literals of every function body against
       ;; the module's 65,536-byte budget, and a shared def is inlined into
       ;; each function that names it.
       (apply str
              (map-indexed
               (fn [i p]
                 (str "(defn- text-" i "\n  " (pr-str (str "resources/" p)) "\n  [] #?@(:kotoba [:string])\n  "
                      (pr-str (read-resource p)) ")\n\n"))
               resource-paths))
       "(defn resource-text\n  \"The embedded text of `path`, or nil (none) for a path not embedded.\"\n"
       "  [#?@(:kotoba [path :string] :default [path])] #?@(:kotoba [[:option :string]])\n"
       "  (cond\n    "
       (apply str
              (interpose "\n    "
                         (map-indexed
                          (fn [i p]
                            (str "#?(:kotoba (string=? path " (pr-str p) ") :default (= path " (pr-str p) "))\n"
                                 "    #?(:kotoba (option-some-of [:option :string] (text-" i ")) :default (text-" i "))"))
                          resource-paths)))
       "\n    :else #?(:kotoba (option-none-of [:option :string]) :default nil)))\n"))

(let [text (module-text)
      check? (some #{"--check"} *command-line-args*)]
  (if check?
    (if (and (fs/existsSync target) (= text (fs/readFileSync target "utf8")))
      (println "embedded resources: current" (count resource-paths) "texts")
      (do (println "STALE" target "-- run scripts/gen_embedded_resources.cljk")
          (js/process.exit 1)))
    (do (fs/writeFileSync target text "utf8")
        (println "wrote" target (count resource-paths) "texts"))))
