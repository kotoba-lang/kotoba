(def https-url-ok-kir
  {:format :kotoba.kir/v4
   :exports ['http-url-ok]
   :schemas {}
   :effects #{}
   :functions
   [{:name 'http-url-ok
     :params ['url]
     :param-types [:string]
     :result :i64
     :effects #{}
     :body '(if (<= (string-length url) 0)
               -1
               (if (> (string-length url) 4096)
                 -2
                 (if (< (string-length url) 8)
                   -3
                   (if (string=? (string-substring url 0 8) "https://")
                     0
                     -3))))}]})

