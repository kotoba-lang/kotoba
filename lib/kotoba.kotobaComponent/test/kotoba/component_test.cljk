     :effects #{}
     :body '(let [n (string-byte-length url)]
              (if (<= n 0) -1
                (if (> n 4096) -2
                  (if (< n 8) -3
                    (if (string=? (string-substring url 0 8) "https://")
                      0 -3)))))}
    {:name 'main
     :params []
     :param-types []
     :result :i64
     :effects #{}
     :body '(let [a (http_url_ok "https://x")
                  b (http_url_ok "")
                  c (http_url_ok "http://x")
                  d (http_url_ok "https://ok.example/a")]
              (+ (* a 1000) (* b 100) (* c 10) d))}]})

