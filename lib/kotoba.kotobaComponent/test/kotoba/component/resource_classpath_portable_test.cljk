(ns kotoba.component.resource-classpath-portable-test
  "kotoba.component.wit's contract (kotoba/lang/component-model-v1.edn), read
  from a CONSUMER's working directory. Since 2026-09-25 it is compile-time
  text (kotoba.component.embedded-resources, superproject adr-2609242330 S3
  (b')): neither the consumer's classpath nor its cwd can change it.

  The fixture is a consumer: a temp directory that is not this repository,
  where a fresh engine is started with this repository's classpath and asked
  for the contract. Measured failures this pins, each on the code before it:
    - until 2026-09-11 the Node branch opened `resources/<resource>` relative
      to the cwd: from a consumer root, ENOENT (cloud-itonami-isic-3812, via
      kotoba-component 35fb4d59) -- case 1;
    - until 2026-09-24 it kept that cwd path as a fallback: a consumer whose
      classpath lacked this repository's resources/ read the consumer's own
      file of the same name, silently -- case 2 (a decoy is planted there).
  Node only: on the JVM io/resource was always the classpath."
  (:require [kotoba.test :refer [deftest is testing]]
            #?@(:cljs [["node:child_process" :as cp]
                       ["node:fs" :as fs]
                       ["node:os" :as os]
                       ["node:path" :as path]
                       [nbb.classpath :as classpath]])))

#?(:cljs
   (defn- run-consumer
     "Start the engine in `cwd` with `entries` as its classpath and print the
     contract's :version (or the error message)."
     [cwd entries]
     (let [engine (aget (.-argv js/process) 1)
           env (js/Object.assign #js {} (.-env js/process) #js {"KBB_CLASSPATH_TAIL" ""})
           ;; a load failure is printed by the engine on stderr, which is returned too
           form (str "(require 'kotoba.component.wit)"
                     " (prn [:ok (some? (:capabilities kotoba.component.wit/contract)) (:decoy kotoba.component.wit/contract)])")
           r (.spawnSync cp "node" #js [engine "--classpath" (.join entries ":") "-e" form]
                         #js {:cwd cwd :encoding "utf8" :env env})]
       (str (.-stdout r) (.-stderr r)))))

(deftest contract-is-read-from-the-classpath-not-the-cwd
  #?(:clj (is true "JVM: io/resource is the classpath")
     :cljs
     (let [root (.cwd js/process)
           abs (->> (.split (classpath/get-classpath) ":")
                    (remove #(= "" %))
                    (map #(.resolve path root %))
                    (into-array))
           resources (.resolve path root "resources")
           consumer (.mkdtempSync fs (.join path (.tmpdir os) "component-consumer-"))]
       (testing "1: from a consumer root with no resources/ at all, the contract resolves"
         (let [out (run-consumer consumer abs)]
           (is (.includes out "[:ok true nil]") out)))
       (testing "2: this repository's resources/ NOT on the classpath, a decoy under the consumer's cwd -> the embedded contract, never the decoy"
         ;; Until 2026-09-25 this case was a named error ("not on the
         ;; classpath"); the contract no longer comes from the classpath.
         (.mkdirSync fs (.join path consumer "resources" "kotoba" "lang") #js {:recursive true})
         (.writeFileSync fs (.join path consumer "resources" "kotoba" "lang" "component-model-v1.edn") "{:decoy true}")
         (let [out (run-consumer consumer (.filter abs #(not= % resources)))]
           ;; [:ok <has :capabilities> <:decoy>] -- the decoy read is [:ok false true]
           (is (not (.includes out "[:ok false true]")) out)
           (is (.includes out "[:ok true nil]") out)))
       (testing "boundary: the same decoy present, the classpath complete -> the real contract wins"
         (let [out (run-consumer consumer abs)]
           (is (.includes out "[:ok true nil]") out)))
       (.rmSync fs consumer #js {:recursive true :force true}))))
