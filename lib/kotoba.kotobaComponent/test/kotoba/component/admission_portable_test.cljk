(ns kotoba.component.admission-portable-test
  "`kotoba.component.admission` on whichever host runs this suite.

  The CID vectors below were produced by the JVM implementation before the
  port (kotoba-component `0129c988`, the `.clj` file), so both hosts are
  checked against the same bytes rather than against each other. The third
  vector carries a 0xff octet, the signed/unsigned boundary the JVM walk
  crosses through `bit-and 0xff` and the Node walk never sees."
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.component.admission :as admission]))

(defn- bytes-of [octets]
  #?(:clj (byte-array (map unchecked-byte octets))
     :cljs (js/Buffer.from (clj->js octets))))

(deftest cid-of-text-matches-the-jvm-vectors
  (is (= "bafkreicnuildx5ikmcnvjysnovfhyugdrify5pcqttujnygvkymwer2ssy"
         (admission/cid-of-text "kotoba admission")))
  (is (= "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
         (admission/cid-of-text ""))))

(deftest cid-of-bytes-crosses-the-signed-boundary
  (is (= "bafkreib5d5l4tbexr34yugbxrsawnqolr3pafqb65nvo47rpcio753r6ky"
         (admission/cid (bytes-of [0 1 2 255])))))

(deftest a-request-is-not-a-grant
  (is (= #{:grants :provider-bindings} admission/composer-supplied-keys))
  (is (empty? (filter admission/composer-supplied-keys admission/request-keys))))
