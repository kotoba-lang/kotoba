(ns kotoba.component.core-portable-test
  "The Component Model encoder end to end on whichever host runs this suite:
  KIR -> WIT -> core module (`core/emit`, through the pinned `wasm-tools`
  parser) -> component binary (`artifact/package`, through
  `wasm-tools component embed` / `new`). The two cases are the first two of
  `component-test` (the `.clj` original), with the same KIR literals and the
  same assertions, so the Node host is held to the JVM's answers -- down to
  the eight preamble octets of the component.

  Until 2026-09-11 nothing had ever run this encoder on Node; it was the last
  JVM-only family amu's route stood on."
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.component.core :as core]
            [kotoba.component.artifact :as artifact]
            [kotoba.component.wit :as wit]))

(defn- octets [bytes n]
  #?(:clj (mapv #(bit-and (int %) 0xff) (take n bytes))
     :cljs (vec (js/Array.from (.subarray bytes 0 n)))))

(defn- byte-count [bytes]
  #?(:clj (alength ^bytes bytes) :cljs (.-length bytes)))

(deftest typed-v03-clock-lowering-produces-a-standard-component
  (let [kir {:format :kotoba.kir/v4
             :exports ['main]
             :schemas {}
             :effects #{[:cap/call 7]}
             :functions [{:name 'main :params [] :param-types []
                          :result :i64 :effects #{[:cap/call 7]}
                          :body '(typed-cap-call 7 :i64 :i64 0)}]}
        opts {:typed-capability-v3? true}
        wit (wit/emit kir opts)
        core-bytes (core/emit kir :wasm32-wasi-kotoba-v1 opts)
        packaged (artifact/package core-bytes kir wit)]
    (is (= :wasm-component-kotoba-v2 (:target wit)))
    (is (= "aiueos:capability/application@0.3.0" (:world wit)))
    (is (= ["aiueos-clock-now"] (:imports wit)))
    (is (= [:poll :cancel]
           (get-in wit [:capability-transport :bytes-task :operations])))
    (is (false? (get-in wit [:capability-transport :ambient-executor])))
    (is (= [0 97 115 109 1 0 0 0] (octets core-bytes 8)) "the core module carries the wasm magic")
    (is (= :wasm-component-kotoba-v2 (:target packaged)))
    (is (= "aiueos:capability/application@0.3.0" (:component-world packaged)))
    (is (= [0 97 115 109 13 0 1 0] (octets (:bytes packaged) 8)))
    (is (re-matches #"[0-9a-f]{64}" (:sha256 packaged)))))

(deftest typed-v03-log-append-lowers-bytes-request-and-unit-result
  (let [kir {:format :kotoba.kir/v4
             :exports ['main]
             :schemas {}
             :effects #{[:cap/call 6]}
             :functions [{:name 'main :params [] :param-types []
                          :result :i64 :effects #{[:cap/call 6]}
                          :body '(typed-cap-call 6 :string :i64 "安全")}]}
        opts {:typed-capability-v3? true}
        wit (wit/emit kir opts)
        core-bytes (core/emit kir :wasm32-wasi-kotoba-v1 opts)
        packaged (artifact/package core-bytes kir wit)]
    (is (= ["aiueos-log-append"] (:imports wit)))
    (is (= :string-literal-unit-capability-call (:canonical-lowering packaged)))
    (is (= :wasm-component-kotoba-v2 (:target packaged)))
    (is (pos? (byte-count (:bytes packaged))))))

(deftest a-wit-with-imports-and-no-provider-lowering-is-refused-by-name
  ;; `artifact/package` refuses before it spawns anything: a WIT that names
  ;; imports for a lowering that carries none is the caller's contradiction,
  ;; and the message says so on both hosts.
  (let [kir {:format :kotoba.kir/v4 :exports ['main] :schemas {} :effects #{}
             :functions [{:name 'main :params [] :param-types [] :result :i64
                          :effects #{} :body 42}]}
        wit (assoc (wit/emit kir {}) :imports ["aiueos-clock-now"])
        e (try (artifact/package #?(:clj (byte-array 0) :cljs (js/Buffer.alloc 0)) kir wit) nil
               (catch :default e e))]
    (is (some? e))
    (is (= "component capability imports require Canonical provider lowering" (ex-message e)))
    (is (= :component-artifact (:phase (ex-data e))))))
