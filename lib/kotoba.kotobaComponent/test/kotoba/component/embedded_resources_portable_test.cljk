(ns kotoba.component.embedded-resources-portable-test
  "kotoba.component.embedded-resources is a COPY of resources/ (superproject
  adr-2609242330 S3 (b')). This refuses a copy that is not byte-equal to the
  file it was written from, and a resource the source reads that the copy
  lacks. Runs from this repository's root on both hosts."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.component.embedded-resources :as embedded-resources]
            #?@(:cljs [["node:fs" :as fs]])))

(defn- resource-file-text [p]
  (let [f (str "lib/kotoba.kotobaComponent/resources/" p)]
    #?(:clj (slurp f)
       :cljs (.readFileSync fs f "utf8"))))

(def ^:private embedded-paths
  "The paths scripts/gen_embedded_resources.cljk writes (its --check refuses a module that
  holds any other set)."
  ["kotoba/lang/component-model-v1.edn"
   "wasi/0.3.0/clocks/monotonic-clock.wit"
   "wasi/0.3.0/clocks/system-clock.wit"
   "wasi/0.3.0/clocks/timezone.wit"
   "wasi/0.3.0/clocks/types.wit"
   "wasi/0.3.0/clocks/world.wit"
   "wasi/0.3.0/http/types.wit"
   "wasi/0.3.0/http/worlds.wit"])

(deftest every-embedded-text-equals-its-resource
  (testing "the generator wrote eight texts (component contract + seven WASI WIT)"
    (is (= 8 (count embedded-paths))))
  (doseq [p embedded-paths]
    (is (= (resource-file-text p) (embedded-resources/resource-text p))
        (str "stale embedded copy of " p " -- run scripts/gen_embedded_resources.cljk"))))

(deftest resource-text-answers-nil-off-the-list
  (is (nil? (embedded-resources/resource-text "kotoba/lang/no-such.edn")))
  (is (string? (embedded-resources/resource-text "kotoba/lang/component-model-v1.edn"))))
