;; date -- POSIX date (IEEE Std 1003.1) as a Kotoba command, in UTC.
;;
;;   date -u                     Wed Sep 16 10:35:12 UTC 2026
;;   date -u +FORMAT             strftime-style FORMAT, the conversions below
;;   date -u -r SECONDS [+FMT]   the same for a given epoch (BSD)
;;
;; ## Measured, 2026-09-16
;;
;; 1,451 invocations in 1,268,018 agent Bash calls (superproject
;; ADR-2609161710), and the ones with arguments are UTC: `-u +%H:%M:%SZ` 69,
;; `-u` 57, `-u +%FT%TZ` 52, `-u +%Y-%m-%dT%H:%M:%SZ` 38, `-u +%H:%MZ` 26,
;; `-u +%s` 20 (and 49 `-u -d`, GNU, which fails on this system anyway). So
;; this speaks UTC only: the LOCAL default (`date` with no -u) needs the
;; zone database, which no capability supplies, and is refused with a
;; message rather than answered in the wrong zone.
;;
;; ## Where the time comes from
;;
;; `:clock/now` (wire 7) in its text form: the request "wall" answers
;; milliseconds since 1970 as decimal text. Seconds since 1970 become a civil
;; date with the days-from-civil inverse (Howard Hinnant's algorithm, the
;; one every libc uses), so there is no table of month lengths to get wrong
;; -- leap years fall out of the arithmetic, and the suite pins 2000-02-29,
;; 1969-12-31 (negative epoch) and 2100-01-01 against /bin/date -r.
;;
;; ## Conversions
;;
;; %Y %m %d %H %M %S %F %T %s %Z %z %a %b %e %j %u %w %y %I %p %% %n, and a
;; literal for anything else -- measured on /bin/date: `+%Q` prints `Q`.
;;
;; Capabilities: :cli/args (38), :clock/now (7), :io/write (37),
;; :io/write-error (39).
(ns date.core (:export [main]) (:capabilities #{:clock/now :cli/args :io/write :io/write-error}))

(defn arg [i :string] :string
  (typed-cap-call :cli/args :string :string i))

(defn emit [s :string] :string
  (typed-cap-call :io/write :string :string s))

(defn emit-error [s :string] :string
  (typed-cap-call :io/write-error :string :string s))

(defn nl [] :string "\n")

;; Milliseconds since 1970 from the wall clock: wire 7's TEXT form (the
;; clock-v1 record codec is not admitted on the JVM-free native route a
;; command is built by). Decimal text, folded here.
(defn- clock [s :string] :string
  (typed-cap-call :clock/now :string :string s))

(defn digit-text [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn decimal-of [n :i64] :string
  (if (< n 0)
    (string-concat "-" (decimal-of (- 0 n)))
    (if (< n 10)
      (digit-text n)
      (string-concat (decimal-of (quot n 10)) (digit-text (- n (* 10 (quot n 10))))))))

;; Two digits, zero-padded; WIDTH 2 with a space pad for %e.
(defn- pad2 [n :i64 pad :string] :string
  (if (< n 10) (string-concat pad (digit-text n)) (decimal-of n)))

(defn- pad3 [n :i64] :string
  (if (< n 10) (string-concat "00" (digit-text n)) (if (< n 100) (string-concat "0" (decimal-of n)) (decimal-of n))))

(defn argc-from [k :i64 total :string] :i64
  (if (string=? (decimal-of k) total) k (argc-from (+ k 1) total)))

(defn argc [] :i64 (argc-from 0 (arg "")))

(defn- digit-value [s :string i :i64] :i64
  (let [c (string-code-point-at s i)]
    (if (< c 48) -1 (if (> c 57) -1 (- c 48)))))

(defn- text->i64 [s :string i :i64 n :i64 acc :i64] :i64
  (if (>= i n)
    acc
    (let [d (digit-value s i)]
      (if (< d 0) -1 (text->i64 s (+ i 1) n (+ (* acc 10) d))))))

;; A decimal, optionally negative; the sentinel for "not a number" is
;; -9223372036854775807 (an epoch no clock reaches).
(defn- now-millis [] :i64
  (let [t (clock "wall")]
    (text->i64 t 0 (string-byte-length t) 0)))

(defn- parse-seconds [s :string] :i64
  (let [n (string-byte-length s)]
    (if (= n 0)
      -9223372036854775807
      (if (= (string-code-point-at s 0) 45)
        (let [v (text->i64 s 1 n 0)] (if (< v 0) -9223372036854775807 (- 0 v)))
        (let [v (text->i64 s 0 n 0)] (if (< v 0) -9223372036854775807 v))))))

;; --- civil time --------------------------------------------------------------
;;
;; Floor division and modulo for negative epochs (before 1970).
(defn- fdiv [a :i64 b :i64] :i64
  (let [q (quot a b)] (if (< (- a (* q b)) 0) (- q 1) q)))
(defn- fmod [a :i64 b :i64] :i64 (- a (* b (fdiv a b))))

;; Days since 1970-01-01 -> year * 10000 + month * 100 + day (civil-from-days).
(defn- civil [z0 :i64] :i64
  (let [z (+ z0 719468)
        era (fdiv z 146097)
        doe (- z (* era 146097))
        yoe (quot (- (+ (- doe (quot doe 1460)) (quot doe 36524)) (quot doe 146096)) 365)
        y (+ yoe (* era 400))
        doy (- doe (- (+ (* 365 yoe) (quot yoe 4)) (quot yoe 100)))
        mp (quot (+ (* 5 doy) 2) 153)
        d (+ (- doy (quot (+ (* 153 mp) 2) 5)) 1)
        m (if (< mp 10) (+ mp 3) (- mp 9))
        yy (if (<= m 2) (+ y 1) y)]
    (+ (* yy 10000) (+ (* m 100) d))))

(defn- year-of [ymd :i64] :i64 (quot ymd 10000))
(defn- month-of [ymd :i64] :i64 (quot (- ymd (* 10000 (quot ymd 10000))) 100))
(defn- day-of [ymd :i64] :i64 (- ymd (* 100 (quot ymd 100))))

(defn- leap? [y :i64] :bool
  (if (= 0 (fmod y 400)) true (if (= 0 (fmod y 100)) false (= 0 (fmod y 4)))))

;; Day of the year, 1-based, from the month and day.
(defn- yday [y :i64 m :i64 d :i64] :i64
  (let [before (if (= m 1) 0 (if (= m 2) 31 (if (= m 3) 59 (if (= m 4) 90 (if (= m 5) 120 (if (= m 6) 151
                (if (= m 7) 181 (if (= m 8) 212 (if (= m 9) 243 (if (= m 10) 273 (if (= m 11) 304 334)))))))))))]
    (+ (+ before d) (if (if (> m 2) (leap? y) false) 1 0))))

(defn- weekday-name [w :i64] :string
  (string-substring "SunMonTueWedThuFriSat" (* w 3) (+ (* w 3) 3)))

(defn- month-name [m :i64] :string
  (string-substring "JanFebMarAprMayJunJulAugSepOctNovDec" (* (- m 1) 3) (+ (* (- m 1) 3) 3)))

;; --- formatting ----------------------------------------------------------------
;;
;; One conversion character for the epoch SECS. DAYS, YMD and SOD (seconds
;; of the day) are derived once by the caller.
(defn- conv [c :i64 secs :i64 days :i64 ymd :i64 sod :i64] :string
  (let [y (year-of ymd) m (month-of ymd) d (day-of ymd)
        hh (quot sod 3600) mm (quot (- sod (* 3600 (quot sod 3600))) 60) ss (- sod (* 60 (quot sod 60)))
        wd (fmod (+ days 4) 7)]
    (if (= c 89) (decimal-of y)
      (if (= c 109) (pad2 m "0")
        (if (= c 100) (pad2 d "0")
          (if (= c 72) (pad2 hh "0")
            (if (= c 77) (pad2 mm "0")
              (if (= c 83) (pad2 ss "0")
                (if (= c 70) (string-concat (decimal-of y) (string-concat "-" (string-concat (pad2 m "0") (string-concat "-" (pad2 d "0")))))
                  (if (= c 84) (string-concat (pad2 hh "0") (string-concat ":" (string-concat (pad2 mm "0") (string-concat ":" (pad2 ss "0")))))
                    (if (= c 115) (decimal-of secs)
                      (if (= c 90) "UTC"
                        (if (= c 122) "+0000"
                          (if (= c 97) (weekday-name wd)
                            (if (= c 98) (month-name m)
                              (if (= c 101) (pad2 d " ")
                                (if (= c 106) (pad3 (yday y m d))
                                  (if (= c 117) (decimal-of (if (= wd 0) 7 wd))
                                    (if (= c 119) (decimal-of wd)
                                      (if (= c 121) (pad2 (fmod y 100) "0")
                                        (if (= c 73) (pad2 (let [h (fmod hh 12)] (if (= h 0) 12 h)) "0")
                                          (if (= c 112) (if (< hh 12) "AM" "PM")
                                            (if (= c 37) "%"
                                              (if (= c 110) (nl)
                                                ;; Unknown: the character itself, as /bin/date does.
                                                (string-substring "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ" 0 0)))))))))))))))))))))))))

;; The format walked from I; a `%` takes the next byte as a conversion.
(defn- render [fmt :string i :i64 secs :i64 acc :string] :string
  (let [n (string-byte-length fmt)]
    (if (>= i n)
      acc
      (let [c (string-code-point-at fmt i)]
        (if (if (= c 37) (< (+ i 1) n) false)
          (let [k (string-code-point-at fmt (+ i 1))
                days (fdiv secs 86400)
                piece (conv k secs days (civil days) (- secs (* 86400 days)))]
            ;; An unknown conversion answers the empty string above; then
            ;; the character itself is what /bin/date prints.
            (render fmt (+ i 2) secs
                    (string-concat acc (if (= 0 (string-byte-length piece))
                                         (if (= k 110) (nl) (string-substring fmt (+ i 1) (+ i 2)))
                                         piece))))
          (render fmt (+ i 1) secs (string-append-range acc fmt i (+ i 1))))))))

(defn- print-line [secs :i64 fmt :string] :i64
  (do (emit (render fmt 0 secs "")) (emit (nl)) 0))

;; `date -u` with no format: `Wed Sep 16 10:35:12 UTC 2026`.
(defn- default-format [] :string "%a %b %e %T %Z %Y")

(defn- usage [] :i64
  (do (emit-error "usage: date -u [-r seconds] [+format]") (emit-error (nl)) 1))

(defn- refuse-local [] :i64
  (do (emit-error "date: local time needs the zone database, which this build cannot read; use -u")
      (emit-error (nl))
      1))

;; Argument shapes: -u [-r SECS] [+FMT], in that order.
(defn- run-utc [i :i64 n :i64 secs :i64] :i64
  (if (>= i n)
    (print-line secs (default-format))
    (let [a (arg (decimal-of i))]
      (if (string=? a "-r")
        (if (>= (+ i 1) n)
          (usage)
          (let [s (parse-seconds (arg (decimal-of (+ i 1))))]
            (if (= s -9223372036854775807)
              (do (emit-error "date: illegal seconds") (emit-error (nl)) 1)
              (run-utc (+ i 2) n s))))
        (if (if (> (string-byte-length a) 0) (= (string-code-point-at a 0) 43) false)
          (if (= (+ i 1) n)
            (print-line secs (string-substring a 1 (string-byte-length a)))
            (usage))
          (usage))))))

(defn main [] :i64
  (let [n (argc)]
    (if (= n 0)
      (refuse-local)
      (if (string=? (arg "0") "-u")
        (let [ms (now-millis)]
          (if (< ms 0)
            (do (emit-error "date: clock unavailable") (emit-error (nl)) 1)
            (run-utc 1 n (fdiv ms 1000))))
        (if (= (string-code-point-at (arg "0") 0) 43)
          (refuse-local)
          (usage))))))
