;; test/date_test.cljk -- build the command and compare it with the system
;; date, byte for byte, on stdout, stderr AND exit status.
;;
;; Every compared case names its epoch with `-r SECONDS` (BSD), so the two
;; implementations answer the same instant and the comparison is exact. One
;; LIVE case runs `date -u` on both and accepts the guest's answer when it
;; equals the system's read just before OR just after it -- a second may
;; tick between the three reads, and a suite that pretended otherwise would
;; be red once a minute.
;;
;;   AMU_HOME=<amu checkout> kbb --backend sci test/date_test.cljk
;;
;; Exits 0 when every case matches, 1 on any difference, 2 when it could not
;; run at all.
(ns date-test
  (:require [clojure.string :as str] ["fs" :as fs] ["path" :as path] ["os" :as os]))

(def cp (js/require "node:child_process"))

(defn- run [cmd args opts]
  (let [r (.spawnSync cp cmd (clj->js args) (clj->js (merge {:encoding "buffer"} opts)))]
    {:status (.-status r) :out (.-stdout r) :err (.-stderr r)}))

(defn- refuse [message]
  (println (pr-str {:ok false :phase :setup :message message}))
  (.exit js/process 2))

(def amu-home
  (or (.-AMU_HOME js/process.env)
      (let [guess (.resolve path (.cwd js/process) ".." ".." "kotoba-lang" "amu")]
        (when (.existsSync fs (.join path guess "bin" "amu")) guess))))

(def system-date "/bin/date")

;; The measured shapes first, at the epochs that separate a right calendar
;; from a wrong one: 0 (Thursday), a leap day, the day before 1970
;; (negative epoch, floor division), 2100-01-01 (a century that is not a
;; leap year), the last second of a day, and a modern instant.
(def epochs ["0" "951782400" "-86400" "4102444800" "86399" "1700000000" "1234567890" "-1" "2145916800"])
(def formats ["+%H:%M:%SZ" "+%FT%TZ" "+%Y-%m-%dT%H:%M:%SZ" "+%H:%MZ" "+%s" "+%F" "+%T" "+%Z" "+%z"
              "+%a %b %e" "+%j %u %w" "+%y %I %p" "+%%|%n|%Q" "+%d/%m/%Y" "+literal text" "+"])

(def cases
  (into (vec (for [e epochs] ["-u" "-r" e]))
        (for [e epochs f formats] ["-u" "-r" e f])))

;; Not compared: written-out expectations for what this refuses.
(def divergences
  [{:argv [] :out "" :exit 1
    :err "date: local time needs the zone database, which this build cannot read; use -u\n"}
   {:argv ["+%F"] :out "" :exit 1
    :err "date: local time needs the zone database, which this build cannot read; use -u\n"}
   {:argv ["-u" "-r"] :out "" :exit 1 :err "usage: date -u [-r seconds] [+format]\n"}
   {:argv ["-u" "-r" "x"] :out "" :exit 1 :err "date: illegal seconds\n"}
   {:argv ["-u" "+%F" "extra"] :out "" :exit 1 :err "usage: date -u [-r seconds] [+format]\n"}
   {:argv ["-x"] :out "" :exit 1 :err "usage: date -u [-r seconds] [+format]\n"}])

(when-not amu-home (refuse "set AMU_HOME to an amu checkout"))
(let [amu (.join path amu-home "bin" "amu")
      packager (.join path amu-home "scripts" "package-command.cljk")
      kbb (.join path amu-home "bin" "kbb")]
  (when-not (.existsSync fs amu) (refuse (str "no amu at " amu)))
  (when-not (.existsSync fs system-date) (refuse (str "no " system-date)))
  (let [tmp (.mkdtempSync fs (.join path (.tmpdir os) "org-ieee-date-"))
        src (.resolve path (.cwd js/process) "date" "core.kotoba")
        policy (.join path tmp "policy.edn")
        kexe (.join path tmp "date.kexe")
        blob (.join path tmp "date.bin")
        exe (.join path tmp "date")]
    (.writeFileSync fs policy "{:allow #{[:cap/call 7] [:cap/call 37] [:cap/call 38] [:cap/call 39]}}" "utf8")
    (let [c (run "node" [amu "compile" src "--target" "aarch64-macos" "--jvm-free" "--policy" policy "--output" kexe] {})]
      (when (not= 0 (:status c)) (refuse (str "compile failed: " (str (:err c)) (str (:out c))))))
    (let [e (run "node" [amu "extract-native" kexe "--symbol" "main" "--output" blob] {})
          _ (when (not= 0 (:status e)) (refuse (str "extract failed: " (str (:err e)))))
          offset (second (re-find #":offset (\d+)" (str (:out e))))]
      (when-not offset (refuse "no :offset in the extract report"))
      (let [p (run "node" [kbb "--backend" "sci" packager "--code" blob "--offset" offset "--isa" "aarch64"
                           "--allow" "7,37,38,39" "--output" exe] {})]
        (when (not= 0 (:status p)) (refuse (str "package failed: " (str (:err p)))))))
    (let [b64 (fn [buf] (.toString buf "base64"))
          results
          (for [argv cases]
            (let [k (run exe argv {})
                  s (run system-date argv {})
                  same? (and (= (b64 (:out k)) (b64 (:out s))) (= (b64 (:err k)) (b64 (:err s)))
                             (= (:status k) (:status s)))]
              {:argv argv :ok same? :kotoba (.toString (:out k) "utf8") :system (.toString (:out s) "utf8")
               :kotoba-err (.toString (:err k) "utf8") :system-err (.toString (:err s) "utf8")
               :exit [(:status k) (:status s)]}))
          ;; The live case: the guest's own clock, between two system reads.
          live (let [before (run system-date ["-u"] {})
                     k (run exe ["-u"] {})
                     after (run system-date ["-u"] {})
                     out (.toString (:out k) "utf8")
                     ok? (and (= 0 (:status k))
                              (or (= out (.toString (:out before) "utf8"))
                                  (= out (.toString (:out after) "utf8"))))]
                 {:argv ["-u" :live] :ok ok? :kotoba out
                  :system (str (.toString (:out before) "utf8") " .. " (.toString (:out after) "utf8"))
                  :kotoba-err (.toString (:err k) "utf8") :system-err "" :exit [(:status k) 0]})
          div-results
          (for [d divergences]
            (let [k (run exe (:argv d) {})
                  ok? (and (= (.toString (:out k) "utf8") (:out d)) (= (.toString (:err k) "utf8") (:err d))
                           (= (:status k) (:exit d)))]
              {:argv [(:argv d) :divergence] :ok ok? :kotoba (.toString (:out k) "utf8") :system "(not compared)"
               :kotoba-err (.toString (:err k) "utf8") :system-err (:err d) :exit [(:status k) (:exit d)]}))
          all (concat results [live] div-results)
          bad (remove :ok all)]
      (doseq [r all]
        (println (str (if (:ok r) "  ok   " "  FAIL ") (pr-str (:argv r)) " -> " (pr-str (:kotoba r))
                      (when-not (:ok r) (str " but " system-date " says " (pr-str (:system r))
                                             " exits " (pr-str (:exit r))
                                             " stderr " (pr-str (:kotoba-err r)) " vs " (pr-str (:system-err r)))))))
      (println (pr-str {:ok (empty? bad) :cases (count all) :compared (inc (count results))
                        :divergences (count div-results) :failed (count bad)}))
      (.exit js/process (if (seq bad) 1 0)))))
