{:paths ["src"]
 :version "0.1.0"
 ;; kotoba-lang/wit — Layer 2 (cap/effect) of the kotoba foundational stdlib.
 ;; WIT interface as EDN + capability-token data model. The user-facing face of
 ;; the existing deny-by-default effects.rs/policy.rs boundary — invents no new
 ;; enforcement gate. Zero third-party runtime deps; .cljc.
 ;; See ADR-kotoba-lang-foundational-stdlib.md.
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        io.github.kotoba-lang/wit-allows
        {:git/url "https://github.com/kotoba-lang/wit-allows.git"
         :git/sha "3c726fc45688f7b4344b1b8e1fcf23494c4e8143"}
        io.github.kotoba-lang/wit-capabilities
        {:git/url "https://github.com/kotoba-lang/wit-capabilities.git"
         :git/sha "ed54bf540fd47b4923826854bc4b58a03c51e1af"}
        io.github.kotoba-lang/wit-capability
        {:git/url "https://github.com/kotoba-lang/wit-capability.git"
         :git/sha "3e86b77074fc7afc1dad4958f13884a975bbfdbc"}
        io.github.kotoba-lang/wit-function
        {:git/url "https://github.com/kotoba-lang/wit-function.git"
         :git/sha "48bb945347b140631489fb809d9a8e329a6fe1b5"}
        io.github.kotoba-lang/wit-grant
        {:git/url "https://github.com/kotoba-lang/wit-grant.git"
         :git/sha "18a75780893237291adb87aecc01306d072763cf"}
        io.github.kotoba-lang/wit-interface
        {:git/url "https://github.com/kotoba-lang/wit-interface.git"
         :git/sha "f9f7edc1ac8a3e0ee1ed9d9aefebf0a15ed197b5"}
        io.github.kotoba-lang/wit-policy
        {:git/url "https://github.com/kotoba-lang/wit-policy.git"
         :git/sha "55929a5ba83d534f9b8146460aa47c5486608c84"}
        io.github.kotoba-lang/wit-revoke
        {:git/url "https://github.com/kotoba-lang/wit-revoke.git"
         :git/sha "5a38c92d363182575089cb890802f7b285e30daa"}
        io.github.kotoba-lang/wit-validate-interface
        {:git/url "https://github.com/kotoba-lang/wit-validate-interface.git"
         :git/sha "b34f6c9099de1734e17140b362a3366e09b66464"}
}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
