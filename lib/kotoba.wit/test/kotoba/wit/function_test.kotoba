(ns kotoba.wit.function-test (:export [main]) (:require [kotoba.wit.function :as p]))

(defn main [] :i64
  (+ (if (p/function? (document-map :name (document-string "f") :params (document-vector))) 0 1)
     (if (p/function? (document-map :name (document-string "f"))) 0 1)
     (if (p/function? (document-map :name (document-string "f") :params (document-null))) 0 1)
     (if (p/function? (document-map :name (document-i64 3))) 1 0)
     (if (p/function? (document-map :name (document-string "f") :params (document-string "x"))) 1 0)
     (if (p/function? (document-vector)) 1 0)
     (if (p/function? (document-string "f")) 1 0)))
