;; Test for kotoba.wit.policy. main returns the number of failed cases.
(ns kotoba.wit.policy-test
  (:export [main])
  (:require [kotoba.wit.policy :as w]))

(defn- chk [ok :bool] :i64
  (if ok 0 1))

(defn main [] :i64
  (let [p (w/policy)]
    (+ (chk (= (document-kind p) :set))
       (+ (chk (= (document-count p) 0))
          (+ (chk (document-equal? p (document-edn-read "#{}")))
             (chk (not (document-set-contains? p (document-keyword :read)))))))))
