(ns kotoba.wit.interface-test (:export [main]) (:require [kotoba.wit.interface :as p]))

(defn main [] :i64
  (+ (if (p/interface? (document-map :wit/interface (document-string "i"))) 0 1)
     (if (p/interface? (document-map :wit/interface (document-string "i") :wit/functions (document-vector) :wit/types (document-map))) 0 1)
     (if (p/interface? (document-map :wit/interface (document-string "i") :wit/functions (document-null))) 0 1)
     (if (p/interface? (document-map)) 1 0)
     (if (p/interface? (document-map :wit/interface (document-i64 3))) 1 0)
     (if (p/interface? (document-map :wit/interface (document-string "i") :wit/functions (document-string "x"))) 1 0)
     (if (p/interface? (document-map :wit/interface (document-string "i") :wit/types (document-vector))) 1 0)
     (if (p/interface? (document-string "i")) 1 0)))
