(ns kotoba.wit
  "Assembled from one repo per definition.

  This namespace holds no implementation. It re-exports the definitions
  that each live in their own repo, so a call site can require one name
  and a library can require only the definitions it actually uses."
  (:require [kotoba.wit.allows :as allows-ns]
            [kotoba.wit.capabilities :as capabilities-ns]
            [kotoba.wit.capability :as capability-ns]
            [kotoba.wit.function :as function-ns]
            [kotoba.wit.grant :as grant-ns]
            [kotoba.wit.interface :as interface-ns]
            [kotoba.wit.policy :as policy-ns]
            [kotoba.wit.revoke :as revoke-ns]
            [kotoba.wit.validate-interface :as validate-interface-ns]))

(def allows? "See kotoba.wit.allows/allows?." allows-ns/allows?)
(def capabilities "See kotoba.wit.capabilities/capabilities." capabilities-ns/capabilities)
(def capability "See kotoba.wit.capability/capability." capability-ns/capability)
(def function? "See kotoba.wit.function/function?." function-ns/function?)
(def grant "See kotoba.wit.grant/grant." grant-ns/grant)
(def interface? "See kotoba.wit.interface/interface?." interface-ns/interface?)
(def policy "See kotoba.wit.policy/policy." policy-ns/policy)
(def revoke "See kotoba.wit.revoke/revoke." revoke-ns/revoke)
(def validate-interface "See kotoba.wit.validate-interface/validate-interface." validate-interface-ns/validate-interface)
