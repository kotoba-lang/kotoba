(ns kotoba.wit.interface
  "interface? -- addressed on its own.

  Split out of kotoba.lang.wit on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  )

(defn interface? [x]
  (and (map? x)
       (string? (:wit/interface x))
       (or (nil? (:wit/functions x)) (vector? (:wit/functions x)))
       (or (nil? (:wit/types x))     (map? (:wit/types x)))))
