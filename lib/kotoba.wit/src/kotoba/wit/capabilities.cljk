(ns kotoba.wit.capabilities
  "capabilities -- addressed on its own.

  Split out of kotoba.lang.wit on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.wit.capability :refer [capability]]))

(defn capabilities
  "Return the seq of capability tokens an interface exposes — one per function.
  Functions may declare `:wit/effects` to override name-based inference."
  [iface]
  (eduction (comp (map (fn [f]
                         (capability (:wit/interface iface)
                                     (:name f)
                                     {:effects (:wit/effects f)})))
                  (distinct))
            (:wit/functions iface)))
