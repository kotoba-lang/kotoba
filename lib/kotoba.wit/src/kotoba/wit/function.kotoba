;; Port of kotoba.wit.function (function.cljk), Kotoba-native.
;;
;; A function is a :document map {:name string :params vector-or-nil}.
;;
;; Named divergences from function.cljk:
;;   - an absent :params and a null :params are the same (both nil in the
;;     source, both document-null here).

(ns kotoba.wit.function
  (:export [function?]))

(defn function? [x :document] :bool
  (and (map? x)
       (option-some?-of [:option :string] (document-string-value (option-or (document-get x :name) (document-null))))
       (let [p (option-or (document-get x :params) (document-null))]
         (or (nil? p) (vector? p)))))
