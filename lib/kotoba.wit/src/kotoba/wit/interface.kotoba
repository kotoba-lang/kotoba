;; Port of kotoba.wit.interface (interface.cljk), Kotoba-native.
;;
;; A WIT interface is a :document map. interface? is true when :wit/interface
;; is a string, :wit/functions is absent/null or a vector, and :wit/types is
;; absent/null or a map.
;;
;; Named divergences from interface.cljk:
;;   - an absent key and a null value are the same (both nil in the source,
;;     both document-null here).

(ns kotoba.wit.interface
  (:export [interface?]))

(defn interface? [x :document] :bool
  (and (map? x)
       (option-some?-of [:option :string] (document-string-value (option-or (document-get x :wit/interface) (document-null))))
       (let [fs (option-or (document-get x :wit/functions) (document-null))]
         (or (nil? fs) (vector? fs)))
       (let [ts (option-or (document-get x :wit/types) (document-null))]
         (or (nil? ts) (map? ts)))))
