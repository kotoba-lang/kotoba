;; Port of kotoba.set.map-invert (map_invert.cljk), Kotoba-native.
;; Maps are :document values. Returns m with each value mapped back to its key;
;; a later entry wins on a value collision (as in the source).
;; Named divergences: none in behaviour. The source's `(defn ...)` is public
;; here too, so it is exported as map-invert.
(ns kotoba.set.map-invert
  (:export [map-invert]))

(defn- entry-part [m :document i :i64 j :i64] :document
  (option-value-of [:option :document]
                   (document-vector-at
                    (option-value-of [:option :document] (document-map-entry-at m i) (document-vector))
                    j)
                   (document-null)))

(defn map-invert [m :document] :document
  (let [n (document-count m)]
    (loop [i 0 out (document-map)]
      (if (>= i n)
        out
        (recur (+ i 1) (document-assoc out (entry-part m i 1) (entry-part m i 0)))))))
