;; Port of kotoba.set.index (index.cljk), Kotoba-native.
;;
;; index maps each distinct projection (select-keys x ks) of the maps in
;; xrel to the set of maps in xrel with that projection.
;; Named divergences:
;;   - sets are built by set-of (below): the items are sorted and joined into
;;     canonical EDN text. Kotoba has no public set-add primitive.
;;   - ks and xrel may be a vector, list or set; a non-collection is an empty
;;     collection (the source's seq of a scalar would throw or yield chars).
;;   - a non-map element of xrel projects to the empty map (select-keys of nil).
(ns kotoba.set.index
  (:export [index]))

(defn- lookup [m :document k :document] :document
  (if (= (document-kind m) :map)
    (option-value-of [:option :document] (document-get m k) (document-null))
    (document-null)))

(defn- item [v :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at v i) (document-null)))

;; The items of a :set or :list as a :vector, read from its canonical text.
(defn- coll-items [v :document] :document
  (let [t (document-edn-print v)
        n (string-length t)]
    (if (= (document-kind v) :set)
      (document-edn-read (string-concat "[" (string-concat (string-substring t 2 (- n 1)) "]")))
      (document-edn-read (string-concat "[" (string-concat (string-substring t 1 (- n 1)) "]"))))))

(defn- items-of [v :document] :document
  (let [k (document-kind v)]
    (cond (= k :vector) v
          (or (= k :set) (= k :list)) (coll-items v)
          :else (document-vector))))

;; Canonical set of the items of vector xs. Map keys are kept in canonical
;; text order and deduplicated by document-assoc, so the keys read back in
;; order give the set's canonical text.
(defn- key-at [m :document i :i64] :document
  (option-value-of [:option :document]
                   (document-vector-at (option-value-of [:option :document] (document-map-entry-at m i) (document-null)) 0)
                   (document-null)))

(defn- set-of [xs :document] :document
  (let [n (document-count xs)
        m (loop [i 0 acc (document-map)]
            (if (>= i n)
              acc
              (recur (+ i 1) (document-assoc acc (option-value-of [:option :document] (document-vector-at xs i) (document-null)) (document-null)))))
        k (document-count m)]
    (document-edn-read
     (loop [i 0 acc "#{"]
       (if (>= i k)
         (string-concat acc "}")
         (let [t (document-edn-print (key-at m i))]
           (recur (+ i 1) (if (string=? acc "#{")
                            (string-concat acc t)
                            (string-concat (string-concat acc " ") t)))))))))

;; select-keys: the entries of x whose keys are in kvec (absent keys skipped).
(defn- project [x :document kvec :document] :document
  (let [n (document-count kvec)]
    (if (= (document-kind x) :map)
      (loop [i 0 out (document-map)]
        (if (>= i n)
          out
          (let [k (item kvec i)]
            (recur (+ i 1)
                   (if (document-contains x k)
                     (document-assoc out k (lookup x k))
                     out)))))
      (document-map))))

(defn index [xrel :document ks :document] :document
  (let [elems (items-of xrel)
        kvec (items-of ks)
        n (document-count elems)]
    (loop [i 0 m (document-map)]
      (if (>= i n)
        m
        (let [x (item elems i)
              ik (project x kvec)
              g (lookup m ik)
              members (if (= (document-kind g) :set) (coll-items g) (document-vector))]
          (recur (+ i 1)
                 (document-assoc m ik (set-of (document-vector-conj members x)))))))))
