;; Test for kotoba.set.map-invert. main returns the number of failed cases.
(ns kotoba.set.map-invert-test
  (:export [main])
  (:require [kotoba.set.map-invert :as mi]))

(defn- sget [m :document k :string] :string
  (option-value-of [:option :string]
                   (document-string-value
                    (option-value-of [:option :document] (document-get m (document-string k)) (document-null)))
                   "<none>"))

(defn- chk-str [got :string want :string] :i64
  (if (string=? got want) 0 1))

(defn- chk-i64 [got :i64 want :i64] :i64
  (if (= got want) 0 1))

(defn main [] :i64
  (let [m (document-map (document-string "x") (document-string "a")
                        (document-string "y") (document-string "b"))
        inv (mi/map-invert m)
        c1 (chk-i64 (document-count inv) 2)
        c2 (chk-str (sget inv "a") "x")
        c3 (chk-str (sget inv "b") "y")
        coll (mi/map-invert (document-map (document-string "x") (document-string "a")
                                          (document-string "y") (document-string "a")))
        c4 (chk-i64 (document-count coll) 1)
        c5 (chk-str (sget coll "a") "y")
        e (mi/map-invert (document-map))
        c6 (chk-i64 (document-count e) 0)]
    (+ c1 (+ c2 (+ c3 (+ c4 (+ c5 c6)))))))
