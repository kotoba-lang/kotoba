;; Test for kotoba.set.index. main returns the number of failed cases.
(ns kotoba.set.index-test
  (:export [main])
  (:require [kotoba.set.index :as s]))

(defn- chk [ok :bool] :i64
  (if ok 0 1))

(defn- row [a :i64 b :i64] :document
  (document-map :a (document-i64 a) :b (document-i64 b)))

(defn- item [v :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at v i) (document-null)))

(defn- rel-set [] :document
  (document-edn-read "#{{:a 1 :b 1} {:a 2 :b 1} {:a 1 :b 2}}"))

(defn- group [idx :document a :i64] :document
  (option-value-of [:option :document] (document-get idx (document-map :a (document-i64 a))) (document-null)))

(defn- groups [] :i64
  (let [idx (s/index (rel-set) (document-vector (document-keyword :a)))]
    (+ (chk (= (document-count idx) 2))
       (+ (chk (= (document-count (group idx 1)) 2))
          (+ (chk (document-set-contains? (group idx 1) (row 1 2)))
             (+ (chk (= (document-count (group idx 2)) 1))
                (chk (document-set-contains? (group idx 2) (row 2 1)))))))))

(defn- empty-and-keyless [] :i64
  (+ (chk (= (document-count (s/index (document-set) (document-vector (document-keyword :a)))) 0))
     (chk (= (document-count (s/index (rel-set) (document-vector))) 1))))

(defn main [] :i64
  (+ (groups) (empty-and-keyless)))
