;; This repository's entry in the kotoba.repository-role-rules taxonomy.
;; ADR-2607266000 / ADR-2607299000.
{:schema "kotoba.repository-role-rules.v0"
 :this-repo
 {:name "ioplan"
  :tier :t5
  :role :library
  ;; The device decides whether reordering is worth anything. Applying a
  ;; rotating-disk optimization to flash by inheritance is the specific
  ;; failure this repo exists to make impossible.
  :must-not [:perform-io :reorder-a-zero-seek-device :assume-a-device-class]
  :depends-on ["kotoba-lang/machine"]}}
