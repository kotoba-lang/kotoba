;; filecoin.cloud.clock — the two clocks of Filecoin Onchain Cloud.
;;
;; PURE. Onchain Cloud's deadlines are counted in Filecoin EPOCHS, 30
;; seconds each since a genesis instant that differs by network, while
;; the world outside speaks Unix seconds. An epoch computed with the
;; wrong genesis is out by two years and the arithmetic gives no sign
;; of it -- so the two genesis constants are THE content of this
;; module, and the golden vectors pin them as literals.
;;
;; Oracle: filecoin.cloud.chain (.cljc), which carries the same two
;; timestamps alongside the deployed contract addresses.

(ns filecoin.cloud.clock
  (:export [mainnet-genesis calibration-genesis epoch-seconds
            epoch->unix-mainnet epoch->unix-calibration
            unix->epoch-mainnet unix->epoch-calibration
            chain-id-mainnet chain-id-calibration
            epochs-in epochs-per-day epochs-per-month
            deadline-epoch]))

;; 2020-08-24 22:00:00 UTC.
(def mainnet-genesis-const 1598306400)

;; 2022-11-01 18:13:00 UTC.
(def calibration-genesis-const 1667326380)

;; Filecoin's block time: builtin.EpochDurationSeconds.
(def epoch-seconds-const 30)

;; EIP-155 chain ids, for callers that only have a number.
(def chain-id-mainnet-const 314)
(def chain-id-calibration-const 314159)

(defn mainnet-genesis [] :i64
  ;; Mainnet genesis, Unix seconds.
  mainnet-genesis-const)

(defn calibration-genesis [] :i64
  ;; Calibration genesis, Unix seconds.
  calibration-genesis-const)

(defn epoch-seconds [] :i64
  ;; One epoch, in seconds.
  epoch-seconds-const)

(defn chain-id-mainnet [] :i64
  ;; EIP-155 chain id of mainnet.
  chain-id-mainnet-const)

(defn chain-id-calibration [] :i64
  ;; EIP-155 chain id of calibration.
  chain-id-calibration-const)

(defn epoch->unix-mainnet [epoch :i64] :i64
  ;; When an epoch begins on mainnet, in Unix seconds.
  (+ mainnet-genesis-const (* epoch epoch-seconds-const)))

(defn epoch->unix-calibration [epoch :i64] :i64
  ;; When an epoch begins on calibration.
  (+ calibration-genesis-const (* epoch epoch-seconds-const)))

(defn unix->epoch-mainnet [unix :i64] :i64
  ;; Floored, not rounded: an epoch is the one that has STARTED, and
  ;; rounding up names a deadline that has not happened yet. Times
  ;; before genesis are not meaningful and are not handled specially.
  (quot (- unix mainnet-genesis-const) epoch-seconds-const))

(defn unix->epoch-calibration [unix :i64] :i64
  (quot (- unix calibration-genesis-const) epoch-seconds-const))

(defn epochs-in [seconds :i64] :i64
  ;; Epochs in a number of seconds -- for turning a human duration
  ;; into the units a lockup or a proving period is denominated in.
  (quot seconds epoch-seconds-const))

(defn epochs-per-day [] :i64
  ;; 86400 / 30.
  2880)

(defn epochs-per-month [] :i64
  ;; 30 days of epochs.
  86400)

(defn deadline-epoch [chain-code :i64 from-unix :i64 duration-seconds :i64] :i64
  ;; The epoch a deadline of `duration-seconds` starting at `from-unix`
  ;; lands on: 0 = mainnet, anything else = calibration. The one
  ;; decision this module makes, and the one with a two-year failure
  ;; mode when the network is guessed wrong.
  (if (= chain-code 0)
    (+ (unix->epoch-mainnet from-unix) (epochs-in duration-seconds))
    (+ (unix->epoch-calibration from-unix) (epochs-in duration-seconds))))
