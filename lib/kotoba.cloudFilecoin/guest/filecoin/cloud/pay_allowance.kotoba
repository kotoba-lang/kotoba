;; filecoin.cloud.pay-allowance — the funding decision for Filecoin Pay.
;;
;; PURE. filecoin.cloud.pay (.cljc oracle) builds the calldata that
;; grants an operator an approval; THIS module is the decision that
;; precedes the calldata: does this rate, over this term, fit inside
;; this allowance ceiling? It refuses to bless an approval whose
;; committed spend exceeds the lockup the payer intends, because an
;; approved operator can start rails WITHOUT ASKING AGAIN -- the
;; approval is where a client decides how much a service may spend on
;; their behalf.
;;
;; Amounts are i64 here: the per-epoch RATES a bot's storage actually
;; costs fit comfortably, while whole-balance arithmetic (18-decimal
;; USDFC strings) stays in the oracle. The judgment shape is what the
;; guest owns, not the bignum.

(ns filecoin.cloud.pay-allowance
  (:export [epochs-per-month committed-per-month
            allowance-fits? monthly-rate-ok?
            rate-for-budget approval-rate]))

(def epochs-per-month-const 86400)

(defn epochs-per-month [] :i64
  ;; 30 days of epochs -- the term a month of storage is bought in.
  epochs-per-month-const)

(defn committed-per-month [rate-per-epoch :i64] :i64
  ;; What a rail paying rate-per-epoch commits over a 30-day month.
  (* rate-per-epoch epochs-per-month-const))

(defn allowance-fits? [rate-per-epoch :i64 lockup-allowance :i64] :bool
  ;; True when one month of the rate fits inside the lockup ceiling
  ;; the payer intends to grant. The ceil on the operator: an approval
  ;; with rate N and lockup below N x epochs-per-month cannot sustain
  ;; a month of storage and will strand the rail mid-term.
  (if (= rate-per-epoch 0) true
    (if (> (* rate-per-epoch epochs-per-month-const) lockup-allowance) false
      true)))

(defn monthly-rate-ok? [rate-per-epoch :i64 max-rate :i64] :bool
  ;; The policy ceiling on the rate itself, before any lockup check:
  ;; a negative or oversized rate is refused outright.
  (if (< rate-per-epoch 0) false
    (if (> rate-per-epoch max-rate) false
      true)))

(defn rate-for-budget [budget :i64] :i64
  ;; The largest whole-attoUSDFC per-epoch rate a `budget` (in
  ;; attoUSDFC) sustains for one month. Floor by truncation.
  (quot budget epochs-per-month-const))

(defn approval-rate [budget :i64 max-rate :i64] :i64
  ;; The rate to put in set-operator-approval: min(rate-for-budget,
  ;; max-rate), 0 when either check refuses. The caller then re-asks
  ;; allowance-fits? with the lockup it will grant; the split keeps
  ;; the two ceilings legible.
  (if (> (rate-for-budget budget) max-rate) 0
    (rate-for-budget budget)))
