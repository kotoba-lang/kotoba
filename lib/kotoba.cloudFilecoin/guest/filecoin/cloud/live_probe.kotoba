;; filecoin.cloud.live-probe — a runner the host drives against a REAL chain.
;;
;; The host fetches one calibration block header over RPC, hands the guest
;; the chain's own claimed height and the block's Unix timestamp as scalars,
;; and the guest JUDGES the pair with pure arithmetic:
;;
;;   claimed-unix   = calibration-genesis + height x 30
;;   drift          = block-timestamp - claimed-unix
;;   clock-consistent when -300 <= drift <= 300   (10 epochs of slack)
;;
;; and packs a verdict word: 1e12 + (height-delta<<20) + clock-ok
;; (height-delta = |unix->epoch(block-timestamp) - claimed height|, must
;; be <= 4095 to fit). The host compares the verdict against the chain.
;; Everything the guest needs crosses the 5-argument ABI.

(ns filecoin.cloud.live-probe
  (:require [filecoin.cloud.clock :as clock])
  (:export [judge-block]))

(defn judge-block [claimed-height :i64 block-timestamp :i64] :i64
  (let [claimed-unix (clock/epoch->unix-calibration claimed-height)
        drift (- block-timestamp claimed-unix)
        drift-ok (if (< drift 0) (if (< drift (- 0 300)) 0 1)
                   (if (> drift 300) 0 1))
        recomputed (clock/unix->epoch-calibration block-timestamp)
        delta (- recomputed claimed-height)
        abs-delta (if (< delta 0) (- 0 delta) delta)]
    (+ 1000000000000
       (* abs-delta 1048576)
       drift-ok)))
