;; filecoin.cloud.test — golden vectors for the filecoin.cloud guest layer.
;;
;; One i64 sum: every `(if (…) 1 0)` is an assertion, and the expected
;; total is exactly 30. The expectations are LITERALS a reader can check
;; against the pure modules without running anything, and they come from
;; two sources:
;;
;;   1. test/filecoin/cloud/vectors.cljk — the 20 PieceCID geometry
;;      vectors generated by @filoz/synapse-core (SDK ground truth, do
;;      not edit by hand). Every height-for / padding-for /
;;      expanded-size triple below quotes one of them.
;;   2. filecoin.cloud.chain / filecoin.cloud.pay (.cljc oracles) —
;;      the two genesis timestamps and the epoch arithmetic, and the
;;      allowance policy the oracle's calldata builders implement.
;;
;; The runner (host/verify.cljk) compiles this closed graph with
;; kotoba.compiler/compile-project and executes it through
;; kototama.native.executor/execute (signed artifact, measured loader,
;; aarch64).

(ns filecoin.cloud.test
  (:require [filecoin.cloud.piece-plan :as plan]
            [filecoin.cloud.clock :as clock]
            [filecoin.cloud.pay-allowance :as pay])
  (:export [run]))

(defn run [] :i64
  (+ ;; piece-plan: zero-padded-size at the quad boundaries (3)
   (if (= (plan/zero-padded-size 1) 127) 1 0)
   (if (= (plan/zero-padded-size 128) 254) 1 0)
   (if (= (plan/zero-padded-size 4096) 8128) 1 0)
   ;; piece-plan: height-for — SDK vectors, heights 2/3/4/5/6/8 (5)
   (if (= (plan/height-for 64) 2) 1 0)
   (if (= (plan/height-for 128) 3) 1 0)
   (if (= (plan/height-for 255) 4) 1 0)
   (if (= (plan/height-for 1000) 5) 1 0)
   (if (= (plan/height-for 4096) 8) 1 0)
   ;; piece-plan: padding-for — SDK vectors (3)
   (if (= (plan/padding-for 1) 126) 1 0)
   (if (= (plan/padding-for 100) 27) 1 0)
   (if (= (plan/padding-for 4096) 4032) 1 0)
   ;; piece-plan: expanded-size vs padded-size, the 1/128 trap (2)
   (if (= (plan/expanded-size 2) 128) 1 0)
   (if (= (plan/padded-size 3) 254) 1 0)
   ;; piece-plan: the quota gate (3)
   (if (plan/plan-ok? 100) 1 0)
   (if (plan/plan-ok? 64) 0 1)
   (if (plan/plan-ok? 4194305) 0 1)
   ;; plan-fields: pack + unpack round-trip, via a helper that binds
   ;; the packed word ONCE (each plan-fields call re-walks the
   ;; geometry recursion, and the native budget is the loader's fixed
   ;; 512 -- measured :trap exit 120 otherwise).
   (if (= (plan/plan-fields-unpacks 131072) 1) 1 0)
   ;; clock: the two genesis constants, as literals (3)
   (if (= (clock/mainnet-genesis) 1598306400) 1 0)
   (if (= (clock/calibration-genesis) 1667326380) 1 0)
   (if (= (clock/epoch->unix-mainnet 1000) 1598336400) 1 0)
   ;; clock: floor semantics and deadline chaining (4)
   (if (= (clock/unix->epoch-mainnet 1598306429) 0) 1 0)
   (if (= (clock/unix->epoch-mainnet 1598306430) 1) 1 0)
   (if (= (clock/deadline-epoch 0 1598306400 86400) 2880) 1 0)
   (if (= (clock/deadline-epoch 1 1667326380 86400) 2880) 1 0)
   ;; pay-allowance: the funding decision (6)
   (if (pay/allowance-fits? 1000 86400000) 1 0)
   (if (pay/allowance-fits? 1000 86399999) 0 1)
   (if (= (pay/committed-per-month 7) 604800) 1 0)
   (if (pay/monthly-rate-ok? 500 500) 1 0)
   (if (= (pay/rate-for-budget 86400000) 1000) 1 0)
   (if (= (pay/approval-rate 5000 2) 0) 1 0)))
