;; No runtime dependencies. SigV4 is string manipulation plus SHA-256 and
;; HMAC-SHA-256, and both are on every target runtime already (javax.crypto /
;; crypto.subtle) — so depending on an AWS SDK would trade a portable library
;; for a JVM-or-Node-only one, and this library exists precisely to be shared
;; across Workers, peers, and JVM clients. See README "Why no AWS SDK".
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
