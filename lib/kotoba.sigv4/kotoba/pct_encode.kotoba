;; RFC 3986 percent-encoding — the byte layer of AWS SigV4 canonicalization,
;; written in Kotoba and compiled to WebAssembly by the released native CLI.
;;
;; Why this function: it is the single most failure-prone step in SigV4 (S3
;; does not exempt the characters `encodeURIComponent` exempts, and it demands
;; uppercase hex), and it is pure byte-to-byte work — no maps, no sorting, no
;; host capability. That makes it the part of the signer that Kotoba can own
;; today, and `scripts/verify-kotoba.cljs` holds it to byte-equality with the
;; `.cljc` implementation across every input byte 0-255.
;;
;; Single module by necessity, not by taste: the wasm emitter rejects `:require`
;; across modules (`internal-error` on v0.6.29), while the `web`/ESM target that
;; does support multi-module has no admitted lowering for `alloc` /
;; `mem-byte-at` / `byte-store!`. So the classifier is inlined here rather than
;; split out the way io-ipfs's ESM pilot splits its bounds module.
;; `:kotoba/raw-memory` is required as of the T1 memory-safety gate: raw
;; linear-memory access (`mem-byte-at`, `byte-store!`) is denied in user source
;; unless the module declares why it needs it. This one is a wire protocol —
;; the encoder walks input bytes and writes output bytes into a scratch region,
;; which is the case the gate's own hint names as admissible.
;;
;; Added 2026-08-17. The gate landed some time before that and this file did
;; not follow, so `kotoba wasm emit` had been failing `check-failed` and the
;; Kotoba/Clojure parity check could not run at all. Nothing noticed because
;; nothing ran it: this repo's Actions are off (ADR-2607300900) and it had no
;; fleet gate until today.
(ns sigv4.pct-encode
  {:kotoba/raw-memory "byte-for-byte wire encoding into a scratch region"}
  (:export [scratch encode main]))

;; A-Z a-z 0-9 - _ . ~  → 1, everything else → 0.
(defn unreserved? [b]
  (if (and (>= b 65) (<= b 90))
    1
    (if (and (>= b 97) (<= b 122))
      1
      (if (and (>= b 48) (<= b 57))
        1
        (if (or (= b 45) (or (= b 95) (or (= b 46) (= b 126))))
          1
          0)))))

;; 0-15 → the ASCII code of its UPPERCASE hex digit (S3 requires uppercase).
(defn hex-digit [n]
  (if (< n 10) (+ 48 n) (+ 55 n)))

;; Hand the host a buffer it can write input into and read output from.
(defn scratch [n] (alloc n))

;; Encode src[i..len) into dst starting at out; returns total bytes written.
;; Self-recursive because Kotoba has no loop form — one frame per input byte.
(defn encode [src len i dst out]
  (if (>= i len)
    out
    (let [b (mem-byte-at src i)]
      (if (= (unreserved? b) 1)
        (do (byte-store! dst out b)
            (encode src len (+ i 1) dst (+ out 1)))
        (do (byte-store! dst out 37)                                  ; '%'
            (byte-store! dst (+ out 1) (hex-digit (/ b 16)))
            (byte-store! dst (+ out 2) (hex-digit (- b (* 16 (/ b 16)))))
            (encode src len (+ i 1) dst (+ out 3)))))))

;; `main` must return an integer, so the built-in self-test encodes the five
;; characters encodeURIComponent wrongly exempts and returns the output length.
;; 5 reserved characters x 3 bytes = 15.
(defn main []
  (encode (str-ptr "!'()*") (str-len "!'()*") 0 (alloc 64) 0))
