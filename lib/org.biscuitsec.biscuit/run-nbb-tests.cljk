(ns run-nbb-tests
  (:require [kotoba.test :as t]
            [biscuit.datalog-test]
            [biscuit.token-test]
            [biscuit.authority-test]
            [biscuit.kotoba-test]
            [biscuit.effective-test]
            [biscuit.kotoba-logic-test]
            [biscuit.real-crypto-test]
            [biscuit.wire-test]
            [biscuit.rootkey-test]))

(def namespaces '[biscuit.datalog-test biscuit.token-test biscuit.authority-test biscuit.kotoba-test biscuit.effective-test biscuit.kotoba-logic-test biscuit.real-crypto-test biscuit.wire-test biscuit.rootkey-test])

;; The exit code is taken from the summary the reporter is handed, not from
;; `run-tests`' return value: on this runtime `run-tests` returns nil, and
;; destructuring nil made every run -- including one with failures -- exit 0
;; (measured 2026-09-24: 14 failures, exit 0). A run that ran nothing is 2,
;; never 0 (root ADR-2608136000).
(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println (str "SUMMARY\ttests=" (:test m) "\tassertions=" (+ (:pass m) (:fail m) (:error m))
                "\tfail=" (:fail m) "\terror=" (:error m)))
  (js/process.exit (cond (zero? (:test m)) 2
                         (pos? (+ (:fail m) (:error m))) 1
                         :else 0)))

(apply t/run-tests namespaces)
