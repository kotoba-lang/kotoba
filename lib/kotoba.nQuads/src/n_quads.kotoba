(ns n-quads
  (:export [main esc iri-ref term quad n-quads render]))

(defn main [] :i64 0)

(defn fail-document [] :document
  (document-vector-assoc (document-vector) 0 (document-null)))

(defn fail-string [] :string
  (option-or (document-string-value (fail-document)) ""))

(defn required-document [value :document key :keyword] :document
  (option-or (document-get value key) (fail-document)))

(defn required-string [value :document] :string
  (option-or (document-string-value value) (fail-string)))

(defn required-keyword [value :document] :keyword
  (option-or (document-keyword-value value) :invalid))

(defn concat3 [a :string b :string c :string] :string
  (string-concat (string-concat a b) c))

(defn esc [value :string] :string
  (string-replace-all
    (string-replace-all
      (string-replace-all
        (string-replace-all value "\\" "\\\\")
        "\"" "\\\"")
      "\n" "\\n")
    "\r" "\\r"))

(defn iri-ref [value :string] :string
  (concat3 "<" value ">"))

(defn literal-suffix [value :document] :string
  (if (document-contains value :language)
    (string-concat "@" (required-string (required-document value :language)))
    (if (document-contains value :datatype)
      (string-concat "^^"
        (iri-ref
          (required-string
            (required-document (required-document value :datatype) :value))))
      "")))

(defn term [value :document] :string
  (let [kind (required-keyword (required-document value :rdf/type))]
    (case kind
      :iri (iri-ref (required-string (required-document value :value)))
      :blank (string-concat "_:" (required-string (required-document value :id)))
      :literal (string-concat
                 (concat3 "\"" (esc (required-string (required-document value :value))) "\"")
                 (literal-suffix value))
      (fail-string))))

(defn quad [value :document] :string
  (let [base (string-concat
               (string-concat
                 (string-concat
                   (string-concat (term (required-document value :subject)) " ")
                   (term (required-document value :predicate)))
                 " ")
               (term (required-document value :object)))
        with-graph (if (document-contains value :graph)
                     (string-concat
                       (string-concat base " ")
                       (term (required-document value :graph)))
                     base)]
    (string-concat with-graph " .")))

(defn render-from [quads :document index :i64] :string
  (if (< index (document-count quads))
    (string-concat
      (string-concat
        (quad (option-or (document-vector-at quads index) (fail-document)))
        "\n")
      (render-from quads (+ index 1)))
    ""))

(defn n-quads [quads :document] :string
  (render-from quads 0))

(defn render [quads :document] :string
  (n-quads quads))
