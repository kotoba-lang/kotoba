#!/usr/bin/env kbb
;; kbb --backend sci --classpath src:test run-tests.cljk
;;
;; 両ホストで回すのは、消費側が JVM（cloud-itonami-app）と Cloudflare Worker
;; （cloud-itonami）に分かれているため。JVM で通ることは Worker で同じ答えを
;; 出す証拠にならない（整数と文字比較の扱い）。
(ns run-tests
  (:require [cljs.test :as t]
            [one-time-link.core-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println)
  (println (str "Ran " (:test m) " tests, " (:pass m) " assertions passed, "
                (:fail m) " failures, " (:error m) " errors."))
  (when-not (t/successful? m) (js/process.exit 1)))

(t/run-tests 'one-time-link.core-test)
