;; Acceptance test for kotoba.spec.problem (port of problem.cljk).
;; main returns the number of failed cases (0 = all pass).
(ns kotoba.spec.problem-test
  (:export [main])
  (:require [kotoba.spec.problem :as sp]))

(defn- chk [ok :bool] :i64 (if ok 0 1))
(defn- fget [m :document k :keyword] :document
  (option-or (document-get m (document-keyword k)) (document-null)))

(defn main [] :i64
  (let [path (document-vector-conj (document-vector) (document-string "a"))
        p (sp/problem path (document-string "x") (document-i64 3) (document-keyword :too-small))
        a (chk (document-equal? (fget p :path) path))
        b (chk (document-equal? (fget p :in) (document-string "x")))
        c (chk (document-equal? (fget p :val) (document-i64 3)))
        d (chk (document-equal? (fget p :reason) (document-keyword :too-small)))
        e (chk (not (document-contains p (document-keyword :spec))))
        q (sp/problem-with-spec path (document-string "x") (document-i64 3)
                                (document-keyword :too-small) (document-keyword :spec-x))
        f (chk (document-equal? (fget q :spec) (document-keyword :spec-x)))
        g (chk (document-equal? (fget q :reason) (document-keyword :too-small)))
        h (chk (document-equal? (fget q :path) path))
        i (chk (= (document-count q) 5))]
    (+ a (+ b (+ c (+ d (+ e (+ f (+ g (+ h i))))))))))
