;; Port of kotoba.spec.problem (problem.cljk), Kotoba-native.
;;
;; A problem is a :document map with :path, :in, :val and :reason, plus :spec
;; when a spec is given.
;;
;; Named divergences from problem.cljk:
;;   - The source's 5-arity `problem` cannot be exported (amu E2138: a
;;     multi-arity function cannot be exported). The 4-arity keeps the name
;;     `problem`; the 5-arity is `problem-with-spec`.
;;   - All arguments are :document. A source nil is document-null.

(ns kotoba.spec.problem
  (:export [problem problem-with-spec]))

(defn problem [path :document input :document value :document reason :document] :document
  (document-assoc
   (document-assoc
    (document-assoc (document-assoc (document-map) :path path) :in input)
    :val value)
   :reason reason))

(defn problem-with-spec [path :document input :document value :document reason :document spec :document] :document
  (document-assoc (problem path input value reason) :spec spec))
