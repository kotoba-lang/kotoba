(ns kotoba.spec.invalid
  (:export [invalid invalid-kind?]))

;; Kotoba port of lib/kotoba.spec/src/kotoba/spec/invalid.cljk.
;; Named divergence: the Clojure `def` of the keyword is the zero-arg fn
;; `invalid`, because a def cannot be exported (E2005). A library module also
;; needs a public fn (E6009), so invalid-kind? is added: the equality test that
;; spec consumers compare against, not new semantics.

(defn invalid [] :keyword :kotoba.lang.spec/invalid)

(defn invalid-kind? [k :keyword] :bool
  (= k :kotoba.lang.spec/invalid))
