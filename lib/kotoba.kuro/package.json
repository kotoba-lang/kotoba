{
  "name": "@kotoba-lang/kuro",
  "private": true,
  "description": "nbb harness for kuro's Node host provider. The portable model needs no npm.",
  "scripts": {
    "build:browser-tools": "node scripts/build-browser-tools.mjs",
    "serve:browser-tools": "node scripts/serve-browser-tools.mjs",
    "test:browser-tools": "npm run build:browser-tools && node test/browser/verify_tools.mjs",
    "test:tool-adapter": "kbb --backend sci --classpath src:test:test/cljs-shims test/browser/verify_tool_adapter.cljk",
    "test:host": "kbb --backend sci --classpath src:test:test/cljs-shims test/run_host_tests.cljk",
    "test:parity": "kbb --backend sci --classpath src:test:test/cljs-shims test/run_parity_tests.cljk",
    "prepare:hermes-browser": "node scripts/prepare-hermes-browser.mjs",
    "test:hermes-browser": "npm run build:browser-tools && node scripts/verify-hermes-adapter.mjs",
    "test:hermes-streaming": "npm run build:browser-tools && node scripts/verify-hermes-streaming.mjs",
    "test:hermes-live": "npm run build:browser-tools && node scripts/verify-hermes-live.mjs",
    "serve:hermes-hf": "node scripts/serve-hermes-hf.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "nbb": "1.4.208",
    "playwright": "^1.62.1",
    "shadow-cljs": "^3.5.0"
  },
  "dependencies": {
    "pyodide": "314.0.7",
    "quickjs-emscripten": "0.32.0"
  }
}
