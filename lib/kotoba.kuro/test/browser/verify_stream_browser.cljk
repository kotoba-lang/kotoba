;; verify_stream_browser.cljs — E2E for kuro.host.stream-browser through the
;; REAL host + REAL Worker (issue #63 step 2).
;;
;; What this replaced: the page used to hand-roll the kuro.stream wire — it
;; instantiated the guest in the page itself, read its memory there, and
;; assembled results.streamChunks by hand. That proved a WASM module can run
;; in Chromium, but NOT that kuro.host.stream-browser produces the isolated
;; receipt the README claims: the host (the thing that turns worker
;; chunk/exit messages into a kuro.stream receipt) was never in the path.
;;
;; Now the page loads a shadow-cljs-compiled kuro.host.stream-browser (via
;; kuro.stream-browser-demo in the fs-browser build's :stream-browser
;; module) and drives it against the REAL kuro-stream-worker.js
;; (src/kuro/host/stream_worker.js). The host posts the start request, the
;; Worker fetches and instantiates a real .wasm guest, streams a stdout
;; chunk, and exits — and the receipt must carry
;; :kuro/isolation :browser-origin.
;;
;; What must be REAL for this to count:
;;   - kuro.host.stream-browser/start (compiled from src, not a JS port)
;;   - a real Worker running stream_worker.js (fetch + instantiate the wasm)
;;   - a real .wasm guest assembled from a WAT fixture (wasm-tools CLI)
;;   - the receipt carrying :kuro/isolation :browser-origin
;;
;; Build:  amu compile --target wasm32-browser fs-browser   (emits js/stream-browser.js)
;; Run:    kbb --backend sci -cp test/browser test/browser/verify_stream_browser.cljk

(ns verify-stream-browser
  (:require ["node:path" :as path]
            ["node:fs" :as fs]
            ["node:child_process" :as child-process]
            ["node:http" :as http]
            [kotoba.lang.text :as str]
            ["playwright" :refer [chromium]]
))

(def repo-root (.cwd js/process))
(def tmp-dir (.join path repo-root "test" "browser" ".tmp"))

(defn- report! [m]
  (println (js/JSON.stringify (clj->js m) nil 2)))

(defn- start-static-server
  [root-dir]
  (js/Promise.
   (fn [resolve reject]
     (let [server
           (http/createServer
            (fn [req res]
              (let [url-path (js/decodeURIComponent (first (.split (.-url req) "?")))
                    file-path (.join path root-dir url-path)]
                (if-not (.startsWith file-path root-dir)
                  (do (.writeHead res 403) (.end res "forbidden"))
                  (-> (fs/readFile file-path
                                   (fn [err data]
                                     (if err
                                       (do (.writeHead res 404)
                                           (.end res (str "not found: " (.-message err))))
                                       (let [ext (.extname path file-path)
                                             mime (get {".html" "text/html; charset=utf-8"
                                                        ".js" "text/javascript"
                                                        ".mjs" "text/javascript"
                                                        ".wasm" "application/wasm"}
                                                       ext "application/octet-stream")]
                                         (.writeHead res 200 #js {"Content-Type" mime})
                                         (.end res data))))))))))]
       (.on server "error" reject)
       (.listen server 0 "127.0.0.1"
                (fn []
                  (let [port (.-port (.address server))]
                    (resolve #js {:baseUrl (str "http://127.0.0.1:" port)
                                  :close (fn [] (js/Promise. (fn [r] (.close server r))))}))))))))

(def page-html
  "The page under test: loads the shadow-compiled kuro.host.stream-browser
  (base.js + stream-browser.js) and drives the REAL host through
  window.streamBrowserE2E, which posts the start request to the REAL
  stream_worker.js. The host's on-exit callback yields the receipt; the page
  reports it (plus the chunks) back to the Node driver."
  "<!doctype html>
<html><head>
<script src='/js/base.js'></script>
<script src='/js/stream-browser.js'></script>
</head><body><script type='module'>
window.addEventListener('error', (e) => { window.__failed = 'top: ' + e.message; });
window.addEventListener('unhandledrejection', (e) => { window.__failed = 'rej: ' + (e.reason && e.reason.message || String(e.reason)); });
try {
  const guest = {
    'kuro.browser/guest': './stream-guest.wasm',
    'kuro.browser/export': 'run',
    'kuro.browser/args': [40, 2],
  };
  window.streamBrowserE2E(guest).then((r) => {
    window.__results = r; window.__done = true;
  }).catch((e) => { window.__failed = 'e2e: ' + (e && e.message || String(e)); });
} catch (err) { window.__failed = 'caught: ' + err.message; }
</script></body></html>")

(defn- compile-guest!
  "Assemble a tiny WAT guest conforming to stream_worker.js's contract: it
  exports run(a, b) -> i32 (a+b) and writes 'sum=NN' into linear memory at
  offset 2048 (the Worker's CHUNK_OFFSET), which the Worker reads back as a
  stdout chunk. Compiles via wasm-tools CLI, the same technique the other
  browser E2Es use."
  []
  (let [fs (js/require "fs")
        wat (str "(module\n"
                 "  (memory (export \"memory\") 1)\n"
                 "  (func (export \"run\") (param $a i32) (param $b i32) (result i32)\n"
                 "    (local $sum i32)\n"
                 "    (local.set $sum (i32.add (local.get $a) (local.get $b)))\n"
                 "    ;; write \"sum=<n>\" at 2048 for the Worker to read\n"
                 "    (i32.store8 (i32.const 2048) (i32.const 115)) ;; s\n"
                 "    (i32.store8 (i32.const 2049) (i32.const 117)) ;; u\n"
                 "    (i32.store8 (i32.const 2050) (i32.const 109)) ;; m\n"
                 "    (i32.store8 (i32.const 2051) (i32.const 61))  ;; =\n"
                 "    (i32.store8 (i32.const 2052) (i32.add (i32.const 48)\n"
                 "                 (i32.div_u (local.get $sum) (i32.const 10))))\n"
                 "    (i32.store8 (i32.const 2053) (i32.add (i32.const 48)\n"
                 "                 (i32.rem_u (local.get $sum) (i32.const 10))))\n"
                 "    (local.get $sum)))\n")
        wat-path (.join path tmp-dir "stream-guest.wat")
        wasm-path (.join path tmp-dir "stream-guest.wasm")]
    (.writeFileSync fs wat-path wat)
    (let [r (.spawnSync child-process "wasm-tools" #js ["parse" wat-path "-o" wasm-path])]
      (when (not= 0 (.-status r))
        (throw (js/Error. (str "wasm-tools parse failed: "
                               (or (some-> r .-stderr (.toString)) (.-error r))))))
      wasm-path)))

(defn- check-result [r]
  (let [chunks (or (:chunks r) [])
        stdout-chunks (filter #(= "stdout" (:stream %)) chunks)
        first-chunk (first stdout-chunks)
        denial (:denial r)]
    (report! {:stream-host-e2e r})
    (let [ok? (and (nil? denial)
                   (= "browser-origin" (:isolation r))
                   (= "receipt" (:receiptType r))
                   (= 42 (:exitCode r))
                   (= "sum=42" (:stdout r))
                   (:stdout r)
                   (pos? (count chunks))
                   (= "sum=42" (:text first-chunk))
                   (not (str/blank? (:guest r))))]
      (report! {:verdict (if ok? "PASS" "FAIL")})
      (when-not ok? (set! (.-exitCode js/process) 1)))))

(defn- prepare-tmp []
  (let [fs (js/require "fs")]
    (do (.mkdirSync fs tmp-dir #js {:recursive true})
        ;; the shadow-cljs build already emitted the stream-browser module
        (when-not (.existsSync fs (.join path tmp-dir "js" "stream-browser.js"))
          (throw (js/Error. "stream-browser.js not built - run: amu compile --target wasm32-browser fs-browser")))
        (.writeFileSync fs (.join path tmp-dir "index.html") page-html)
        (.writeFileSync fs
                        (.join path tmp-dir "kuro-stream-worker.js")
                        (.readFileSync fs
                                       (.join path repo-root "src" "kuro" "host" "stream_worker.js")
                                       "utf8"))
        (compile-guest!)
        nil)))

(defn- check-page [page srv]
  (.on page "console" (fn [msg] (report! {:console (.-text msg)})))
  (.on page "pageerror" (fn [err] (report! {:pageerror (.-message err)})))
  (-> (.goto page (str (.-baseUrl srv) "/index.html"))
      (.then (fn []
               (.evaluate page
                          "(async function(){ const t0 = Date.now(); while (Date.now() - t0 < 15000) { if (window.__done) { return JSON.stringify(window.__results); } if (window.__failed) { return JSON.stringify({failed: window.__failed}); } await new Promise(r => setTimeout(r, 100)); } return JSON.stringify({failed: 'timeout'}); })()")))
      (.then (fn [raw]
               (let [parsed (js/JSON.parse raw)]
                 (if (:failed parsed)
                   (do (report! {:page-failed (:failed parsed)})
                       (report! {:verdict "FAIL"})
                       (set! (.-exitCode js/process) 1))
                   (check-result (js->clj parsed :keywordize-keys true))))))))

(defn- -main []
  (-> (js/Promise.resolve (prepare-tmp))
      (.then (fn [_] (start-static-server tmp-dir)))
      (.then (fn [srv]
               (-> (.launch chromium #js {:headless true})
                   (.then (fn [browser]
                            (-> (.newPage browser)
                                (.then (fn [page] (check-page page srv)))
                                (.then (fn [_] (.close browser))))))
                   (.then (fn [_] ((.-close srv)))))))
      (.catch (fn [e]
                (report! {:fatal (.-message e)})
                (set! (.-exitCode js/process) 1)))))

(-main)
