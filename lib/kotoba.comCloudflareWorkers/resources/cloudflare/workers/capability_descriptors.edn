;; Typed capability descriptors for the Cloudflare Workers storage family.
;;
;; Completion-gate item 1 ("typed descriptors in the closed capability
;; contract") from kotoba-lang/kotoba's docs/lang/application-profile.md.
;;
;; These are EFFECT-COMMAND capabilities, not synchronous Wasm host imports.
;; They deliberately do NOT appear in kotoba-core-contracts' :host-imports
;; table: D1/KV/R2 are asynchronous and a Cloudflare Worker cannot block a
;; guest (no Atomics.wait on the request thread, no JSPI), so a synchronous
;; i32-shaped import for these operations could not be honestly implemented.
;; See ADR-2607253500.
;;
;; Shape follows kotoba-lang/kotoba-lang lang/capability-semantics.edn:
;; capabilities are identified by :cap/kind + :cap/resource, grants intersect
;; policy ∩ delegated ∩ requested, and every attempt is receipted.

{:kotoba.capability-descriptors/version 1
 :kotoba.capability-descriptors/family :cloudflare/workers-storage
 :kotoba.capability-descriptors/authority "kotoba-lang/com-cloudflare-workers"
 :kotoba.capability-descriptors/adr "adr-2607253500-kotoba-cloudflare-workers-storage-capabilities"
 :kotoba.capability-descriptors/profile :kotoba/app
 :kotoba.capability-descriptors/plane :effect-command

 :kinds
 {:cf/kv-read
  {:effect :cf/kv-read
   :binding-kind :kv
   :resource-grammar "kv:<BINDING>/<key>"
   :scope-key :key-prefixes
   :commands #{:cf.kv/get}
   :note "Observes one key. Scope is a key-prefix set; an absent set reaches nothing."}

  :cf/kv-write
  {:effect :cf/kv-write
   :binding-kind :kv
   :resource-grammar "kv:<BINDING>/<key>"
   :scope-key :key-prefixes
   :commands #{:cf.kv/put :cf.kv/delete}
   :bounded-by #{:max-value-bytes :min-ttl :max-ttl}}

  :cf/d1-read
  {:effect :cf/d1-read
   :binding-kind :d1
   :resource-grammar "d1:<BINDING>#<statement-id>"
   :scope-key :statements
   :commands #{:cf.d1/exec}
   :derivation :statement-mode
   :note "Required capability comes from the REGISTERED statement's :mode, never from the command. A guest names a statement id; SQL text is host-side only."}

  :cf/d1-write
  {:effect :cf/d1-write
   :binding-kind :d1
   :resource-grammar "d1:<BINDING>#<statement-id>"
   :scope-key :statements
   :commands #{:cf.d1/exec}
   :derivation :statement-mode}

  :cf/r2-read
  {:effect :cf/r2-read
   :binding-kind :r2
   :resource-grammar "r2:<BINDING>/<key>"
   :scope-key :key-prefixes
   :commands #{:cf.r2/get}
   :note "Bodies are returned as {:b64 ...}: lossless for binary and one shape for callers."}

  :cf/r2-write
  {:effect :cf/r2-write
   :binding-kind :r2
   :resource-grammar "r2:<BINDING>/<key>"
   :scope-key :key-prefixes
   :commands #{:cf.r2/put :cf.r2/delete}
   :bounded-by #{:max-value-bytes}}}

 :denial-reasons
 #{;; structural (cloudflare.workers.command)
   :malformed-command :unknown-command :unknown-command-key
   :missing-required-field :malformed-binding-name :malformed-key
   :key-too-long :malformed-value :malformed-ttl :malformed-statement-id
   :malformed-params :too-many-params :malformed-content-type
   :raw-sql-forbidden
   ;; authority (cloudflare.workers.admission)
   :unknown-binding :binding-kind-mismatch :capability-not-granted
   :key-outside-prefix-scope :unknown-statement :statement-arity-mismatch
   :invalid-statement-mode :wildcard-forbidden
   ;; bounds
   :value-too-large :ttl-out-of-range
   :quota-commands-exceeded :quota-write-bytes-exceeded
   :quota-d1-statements-exceeded :quota-reads-exceeded
   :malformed-batch
   ;; provider (cloudflare.workers.provider) -- :failed, not :denied
   :binding-absent :binding-shape-mismatch :provider-error}

 :receipt-requirements
 [:receipt/cap :receipt/at :receipt/call :receipt/outcome]

 :rules
 {:unknown-binding :deny
  :missing-grant :deny
  :absent-scope-is-empty true
  :guest-authored-sql :unrepresentable
  :batch-partial-application :forbidden-by-default
  :production-effective-wildcard :forbidden
  :attempt-always-receipted true
  :ambient-fallback :forbidden
  :clock-in-pure-core :forbidden
  :note "Batch admission defaults to :on-deny :abort. Executing the prefix of a plan whose tail was denied leaves storage in a state the guest never reasoned about."}

 ;; Honest status against application-profile.md's six-item completion gate.
 :completion-gate
 {1 {:item "Typed descriptors in the closed capability contract"
     :status :partial
     :detail "Descriptors are typed and closed HERE; they are not registered in kotoba-core-contracts' :host-imports because this family is not a synchronous import surface. Registering the KINDS in kotoba-lang/kotoba-lang capability-semantics.edn is a follow-up."}
  2 {:item "Effect inference and compiler admission"
     :status :not-started
     :detail "Requires effect-for-kind entries in kotoba-lang/kotoba-lang and op->kind entries in kotoba-lang/kotoba. Deferred deliberately: cross-repo core-language change."}
  3 {:item "Policy-gated provider with no ambient fallback"
     :status :done
     :detail "cloudflare.workers.provider; binding absence and shape mismatch both deny."}
  4 {:item "Positive and denial conformance fixtures"
     :status :done
     :detail "test/cloudflare/workers/conformance_test.kotoba, one fixture per denial reason."}
  5 {:item "Quota, cancellation, fuel/memory, and audit"
     :status :partial
     :detail "Quota and audit done. Cancellation is the Worker's request abort signal and is not yet threaded through execute!."}
  6 {:item "Parity evidence across at least two applicable runtimes"
     :status :partial
     :detail "Pure core is .cljc and runs under nbb and JVM Clojure. The provider has one applicable runtime (workerd); a miniflare-backed live test is the follow-up."}}}
