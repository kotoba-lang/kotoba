;; Guest-side planning, in the admitted `.kotoba` grammar.
;;
;; STATUS: this file shows the *shape* a guest planner takes. The frame ABI
;; that carries these records across the Wasm boundary into
;; `cloudflare.workers.provider` is completion-gate item 2 and is NOT built
;; yet (see resources/cloudflare/workers/capability_descriptors.edn). Today the
;; host-side gate is driven from ClojureScript callers. Do not read this file
;; as evidence of a working guest->provider path.
;;
;; What it does illustrate is the property that matters: a command is DATA.
;; Constructing `(->KvPut "SESSIONS" k v 300)` grants nothing and reaches
;; nothing. There is no binding in scope, no `env`, no capability handle to
;; leak -- the guest cannot express "write to KV", only "I propose this write".
;; Whether it happens is decided host-side by policy it cannot read or reach.
;;
;; Grammar notes: string building uses `string-concat` (`str` is not an
;; admitted head), and `0` is the empty list, matching kotoba-lang's
;; stdlib/core.kotoba convention where `(= items 0)` tests for empty.

(ns session-planner)

(defrecord KvGet [binding key])
(defrecord KvPut [binding key value ttl])
(defrecord D1Exec [binding statement params])

(defn session-key [user-id]
  (string-concat "user:" user-id))

;; One command: refresh this user's cached session.
;; The TTL is a proposal too -- policy declares the band it must fall in
;; (SESSIONS is :min-ttl 60 :max-ttl 3600 in the fixture policy), and a plan
;; outside that band is denied rather than clamped, so a guest bug surfaces as
;; a receipt instead of as silently different behaviour.
(defn refresh-session [user-id token]
  (pair (->KvPut "SESSIONS" (session-key user-id) token 300) 0))

;; Read the cached session. Reads are proposals as well: the host executes
;; them and returns a typed result event.
(defn read-session [user-id]
  (pair (->KvGet "SESSIONS" (session-key user-id)) 0))

;; D1 by registered statement id. The guest names "order-by-id"; the SQL text
;; lives in host policy and never crosses this boundary in either direction.
;; This is why guest-authored SQL injection is not mitigated here -- it is
;; unrepresentable.
(defn lookup-order [order-id]
  (pair (->D1Exec "APP_DB" "order-by-id" (pair order-id 0)) 0))

;; A whole plan: decide, then propose. Pure -- same inputs, same plan.
(defn plan [user-id token cached]
  (if (= cached 1)
    (read-session user-id)
    (refresh-session user-id token)))
