{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc → portable to JVM / SCI / ClojureScript / GraalVM). Same runtime
 ;; robotaxi-actor / vehicle-design-actor / itonami / kekkai ride on; a meeting-
 ;; recording actor is just another sealed-intelligence ⊣ independent-governor
 ;; StateGraph.
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/langgraph {:local/root "../kotoba.langgraph"}}
 :aliases
 {;; offline workspace dev — pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain {:local/root "../langchain"}}}
  ;; gijiroku.bot-join (headless-browser meeting join, no OAuth app needed) —
  ;; NOT a core dep, so the OAuth-API path (gijiroku.zoom/google-meet/teams)
  ;; stays lightweight for consumers that don't need bot-join.
  :bot-join {:extra-deps {io.github.kotoba-lang/playwright {:local/root "../playwright"}}}
  :test {:extra-paths ["test"]}}}
