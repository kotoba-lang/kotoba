;; No dependencies. BACnet/IP is a header, a network layer, an application
;; layer of tags and services — none of it needs a socket to encode or
;; decode, and a dependency here would defeat the point of getting this
;; protocol layer off the JVM.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
