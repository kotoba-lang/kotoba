{
  "name": "kotobase-checkpoint-anchor-runtime",
  "private": true,
  "scripts": {
    "test:cljs": "kbb --backend sci --classpath \"$(kbb -Spath)\" test/run.cljk",
    "test:runtime": "node --test runtime/test/*.test.mjs",
    "test:contract": "forge test",
    "build:contract": "forge build",
    "credentials:calibration": "node scripts/provision-calibration-credentials.mjs",
    "deploy:calibration": "node scripts/deploy-calibration.mjs",
    "deploy:calibration:keychain": "node scripts/run-calibration-with-keychain.mjs deploy",
    "qualify:reorg": "node scripts/qualify-local-reorg.mjs",
    "qualify:transparency": "node scripts/qualify-transparency.mjs",
    "qualify:calibration": "node scripts/qualify-calibration.mjs",
    "qualify:calibration:keychain": "node scripts/run-calibration-with-keychain.mjs qualify"
  },
  "dependencies": {
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "nbb": "1.5.211"
  }
}
