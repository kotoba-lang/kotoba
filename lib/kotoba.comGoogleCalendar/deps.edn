{:paths ["src"]
 ;; The connector kernel is the only dependency. It carries the descriptor
 ;; model, the OAuth flow and the invoke path; this repository carries the two
 ;; things that are specific to one service -- how a tool call becomes a
 ;; request, and how a response becomes a result.
 :deps {
        io.github.kotoba-lang/pprint {:local/root "../kotoba.pprint"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/connector {:local/root "../kotoba.connector"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
