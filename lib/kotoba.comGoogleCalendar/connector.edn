{:schema "kotoba.connector.repository.v1",
 :connector/docs-url
 "https://developers.google.com/calendar/api/v3/reference",
 :connector/origin-domain "google.com",
 :connector/base-scopes ["openid" "email"],
 :connector/id "com.google.calendar",
 :connector/var "provider",
 :connector/scopes
 ["email"
  "https://www.googleapis.com/auth/calendar.events"
  "https://www.googleapis.com/auth/calendar.readonly"
  "openid"],
 :authority
 "90-docs/adr/2608097000-connector-plane-one-repo-per-connector.edn",
 :connector/namespace "google-calendar.connector",
 :connector/auth-kind :oauth2,
 :connector/auth-pkce? true,
 :connector/summary "Calendars, events and free/busy windows.",
 :connector/name "Google Calendar",
 :connector/client-id-env "GOOGLE_CLIENT_ID",
 :connector/tools
 [{:connector/name "google_calendar_create_event",
   :connector/effect :write,
   :connector/scopes
   ["https://www.googleapis.com/auth/calendar.events"],
   :connector/description "Create an event on a calendar."}
  {:connector/name "google_calendar_freebusy",
   :connector/effect :read,
   :connector/scopes
   ["https://www.googleapis.com/auth/calendar.readonly"],
   :connector/description
   "Busy windows for one or more calendars. Returns times only — no titles, attendees or descriptions."}
  {:connector/name "google_calendar_get_event",
   :connector/effect :read,
   :connector/scopes
   ["https://www.googleapis.com/auth/calendar.readonly"],
   :connector/description "One event, in full."}
  {:connector/name "google_calendar_list_calendars",
   :connector/effect :read,
   :connector/scopes
   ["https://www.googleapis.com/auth/calendar.readonly"],
   :connector/description "List the calendars this account can see."}
  {:connector/name "google_calendar_list_events",
   :connector/effect :read,
   :connector/scopes
   ["https://www.googleapis.com/auth/calendar.readonly"],
   :connector/description
   "List events on a calendar within a time window."}]}
