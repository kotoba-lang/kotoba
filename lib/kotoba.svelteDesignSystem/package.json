{
  "name": "@etzhayyim/design-system",
  "version": "0.1.0",
  "description": "Svelte 5 + Tailwind CSS design system for etzhayyim apps — 50+ UI components (BottomNav, SnapFeed, Toast, etc.), headless builders, motion utilities, Tailwind plugin, audio feedback",
  "type": "module",
  "main": "dist/index.cjs.js",
  "typings": "dist/index.d.ts",
  "module": "dist/index.es.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./builders": {
      "types": "./dist/builders/index.d.ts",
      "svelte": "./dist/builders/index.js",
      "default": "./dist/builders/index.js"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "svelte": "./dist/motion/index.js",
      "default": "./dist/motion/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/tailwind.d.ts",
      "svelte": "./dist/plugin/tailwind.js",
      "default": "./dist/plugin/tailwind.js"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "default": "./dist/audio/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/etzhayyim/com-etzhayyim-svelte-design-system.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "svelte-package",
    "test": "pnpm --dir motion-test-island test",
    "prepublishOnly": "npm run build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@digital-go-jp/design-tokens": "^1.1.9",
    "@digital-go-jp/tailwind-theme-plugin": "^0.3.4",
    "@internationalized/date": "^3.12.0",
    "tailwindcss": "^3.4.19"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/addon-links": "^9.1.20",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^24.12.2",
    "autoprefixer": "^10.4.27",
    "bits-ui": "^2.17.3",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.562.0",
    "markuplint": "^4.14.1",
    "postcss": "^8.5.9",
    "storybook": "^9.1.20",
    "svelte": "^5.55.3",
    "svelte-check": "^4.4.6",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  },
  "engines": {
    "node": ">=20"
  },
  "engineStrict": true
}
