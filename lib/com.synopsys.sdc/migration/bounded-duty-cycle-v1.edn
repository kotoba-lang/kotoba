{:schema "kotoba-org-synopsys-sdc-migration/v1"
 :profile :sdc/bounded-duty-cycle-v1
 :legacy {:source "src/sdc/clock.cljk"
          :status :retained-general-oracle}
 :canonical {:engine-and-conformance "src/sdc/bounded_duty_cycle.kotoba"}
 :domain
 {:function :duty-cycle
  :formula "percentage of the clock period during which the clock is
           high, derived from waveform edges [rise fall]; an inverted
           waveform (fall < rise, clock starts high) wraps the high
           interval around the period; a non-positive period is invalid"
  :representation "{:valid :bool :percent :f64} record instead of the
                   legacy nilable-f64 (Option<f64>) return -- kotoba-lang/
                   compiler's [:option :f64] payload does not currently
                   type-check (same gap already found for kotoba-lang/
                   face-match, kotoba-lang/compiler#206), and unlike
                   face-match's always-absent case this function
                   legitimately needs to report a present value, so a
                   bool flag alongside the value is used instead of
                   forcing an Option"}
 :excluded [:sdc.create-clock :sdc.io-delay :sdc.path-exception :sdc.parser]
 :exclusion-reason "create-clock is a plain map constructor with string
                    name/source-port fields (low value to port alone);
                    io-delay/path-exception operate on open-ended pin
                    identifiers and sets (same bounded-arbitrary-
                    collection gap as search/sheets/atprotocol);
                    parser.cljc is a TCL-subset text parser (regex-driven,
                    same missing-primitive gap as search/cron/org-ibis).
                    duty-cycle alone is a clean, dependency-free f64
                    formula and was the only tractable target this pass."
 :verification
 {:legacy {:tests 14 :assertions 69 :failures 0 :errors 0}
  :hand-verified-cases
  "all cases cross-checked directly against sdc.clock-test/
   duty-cycle-computation and duty-cycle-invalid-period before
   compiling: default 50% waveform, two asymmetric waveforms (30%/70%),
   an inverted waveform wrapping around the period (40%), and two
   invalid-period cases (0 and negative) -- that test file is the
   ground truth, not independently re-derived"
  :web {:main 42 :required-capabilities []}
  :wasm {:main 42}
  :required-capabilities []
  :local-verification
  {:clojure-test {:tests 14 :assertions 69 :failures 0 :errors 0}
   :lint {:errors 0 :warnings 0}
   :kotoba-compile [:js-browser :wasm32-browser]
   :kotoba-conformance :passed-both-targets}}
 :operational-note
 "CI workflow file not updated in this PR -- pushing token lacks the
  workflow OAuth scope (same constraint as kotoba-lang/ic-packaging).
  Verification run in full locally; existing unmodified CI still ran
  the full legacy suite."
 :cutover {:bounded-profile-authorized true :general-cljc-oracle-retained true}}
