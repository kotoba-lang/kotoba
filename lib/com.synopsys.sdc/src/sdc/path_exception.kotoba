;; Port of sdc.path-exception (path_exception.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from path_exception.cljk:
;;   - The source's destructured map argument is a single :document map here.
;;   - multicycle-path's :multiplier default (1) applies only when the key is
;;     absent, as Clojure `:or` does; a present null multiplier is kept.
;;   - endpoint-matches?: a set spec uses set membership; a vector or list spec
;;     is searched by document-equal?. A map spec never matches (the source's
;;     (set map) holds map entries, which no pin equals).

(ns sdc.path-exception
  (:export [false-path multicycle-path applies-to?]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- or-default [m :document k :keyword d :document] :document
  (if (map? m)
    (option-or (document-get m k) d)
    d))

(defn- null-doc? [d :document] :bool
  (document-equal? d (document-null)))

(defn false-path [entry :document] :document
  (document-map :type (document-keyword :false-path)
                :from (field entry :from)
                :to (field entry :to)
                :multiplier (document-null)))

(defn multicycle-path [entry :document] :document
  (document-map :type (document-keyword :multicycle-path)
                :from (field entry :from)
                :to (field entry :to)
                :multiplier (or-default entry :multiplier (document-i64 1))))

(defn- seq-has? [v :document pin :document i :i64] :bool
  (if (>= i (document-count v))
    false
    (if (document-equal? (option-or (document-vector-at v i) (document-null)) pin)
      true
      (seq-has? v pin (+ i 1)))))

(defn- list-has? [v :document pin :document i :i64] :bool
  (if (>= i (document-count v))
    false
    (if (document-equal? (option-or (document-list-at v i) (document-null)) pin)
      true
      (list-has? v pin (+ i 1)))))

(defn- endpoint-matches? [spec :document pin :document] :bool
  (cond (null-doc? spec) true
        (document-equal? spec pin) true
        (string=? (keyword-name (document-kind spec)) "set") (document-set-contains? spec pin)
        (string=? (keyword-name (document-kind spec)) "vector") (seq-has? spec pin 0)
        (string=? (keyword-name (document-kind spec)) "list") (list-has? spec pin 0)
        :else false))

(defn applies-to? [entry :document from-pin :document to-pin :document] :bool
  (and (endpoint-matches? (field entry :from) from-pin)
       (endpoint-matches? (field entry :to) to-pin)))
