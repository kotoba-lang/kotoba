(ns sdc.bounded-duty-cycle
  (:export [duty-cycle duty-cycle-valid duty-cycle-percent
            check-invalid main]))

;; Capability-free port of sdc.clock/duty-cycle: percentage of the clock
;; period during which the clock is high, derived from waveform edges
;; [rise fall]. Handles an inverted waveform (fall < rise, clock starts
;; high) by wrapping the high interval around the period. Modeled as a
;; {:valid :bool :percent :f64} record instead of an Option<f64> --
;; kotoba-lang/compiler's [:option :f64] payload does not currently
;; type-check (same gap already found for face-match's confidence field,
;; kotoba-lang/compiler#206) -- and unlike face-match's always-absent
;; case, duty-cycle legitimately needs to report a present value, so a
;; bool flag alongside the value is used instead of trying to force an
;; Option.

(def duty-cycle-result-type
  [:record :sdc/duty-cycle-result [[:valid :bool] [:percent :f64]]])

(defn duty-cycle [period :f64 rise :f64 fall :f64] [:alias duty-cycle-result-type]
  (if (f64-le period 0.0)
    (record duty-cycle-result-type false 0.0)
    (let [high (if (f64-ge fall rise) (f64-sub fall rise)
                 (f64-add (f64-sub fall rise) period))]
      (record duty-cycle-result-type true
        (f64-mul 100.0 (f64-div high period))))))

(defn duty-cycle-valid [r [:alias duty-cycle-result-type]] :bool
  (record-get duty-cycle-result-type r :valid))
(defn duty-cycle-percent [r [:alias duty-cycle-result-type]] :f64
  (record-get duty-cycle-result-type r :percent))

;; --- self-conformance, cross-checked directly against
;; sdc.clock-test/duty-cycle-computation and duty-cycle-invalid-period
;; before compiling ---

(defn check-invalid [] :i64
  (let [r1 (duty-cycle 0.0 0.0 5.0)
        r2 (duty-cycle -1.0 0.0 5.0)]
    (if (duty-cycle-valid r1) 1
      (if (duty-cycle-valid r2) 2 42))))

(defn main [] :i64
  (let [a (duty-cycle 10.0 0.0 5.0)
        b (duty-cycle 10.0 0.0 3.0)
        c (duty-cycle 10.0 2.0 9.0)
        d (duty-cycle 10.0 8.0 2.0)]
    (if (duty-cycle-valid a)
      (if (= (f64-to-bits (duty-cycle-percent a)) (f64-to-bits 50.0))
        (if (duty-cycle-valid b)
          (if (= (f64-to-bits (duty-cycle-percent b)) (f64-to-bits 30.0))
            (if (duty-cycle-valid c)
              (if (= (f64-to-bits (duty-cycle-percent c)) (f64-to-bits 70.0))
                (if (duty-cycle-valid d)
                  (if (= (f64-to-bits (duty-cycle-percent d)) (f64-to-bits 40.0))
                    (if (= 42 (check-invalid)) 42 9)
                    8)
                  7)
                6)
              5)
            4)
          3)
        2)
      1)))
