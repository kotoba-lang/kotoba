(ns sdc.path-exception-test (:export [main]) (:require [sdc.path-exception :as p]))

(defn- ok [b :bool] :i64
  (if b 0 1))

(defn- ab [] :document
  (document-map :from (document-string "a") :to (document-string "b")))

(defn- entry-checks [] :i64
  (+ (ok (document-equal? (p/false-path (ab))
                          (document-map :type (document-keyword :false-path)
                                        :from (document-string "a") :to (document-string "b")
                                        :multiplier (document-null))))
     (ok (document-equal? (p/multicycle-path (ab))
                          (document-map :type (document-keyword :multicycle-path)
                                        :from (document-string "a") :to (document-string "b")
                                        :multiplier (document-i64 1))))
     (ok (document-equal? (p/multicycle-path (document-map :from (document-string "a")
                                                           :to (document-string "b")
                                                           :multiplier (document-i64 3)))
                          (document-map :type (document-keyword :multicycle-path)
                                        :from (document-string "a") :to (document-string "b")
                                        :multiplier (document-i64 3))))))

(defn- match-checks [] :i64
  (+ (ok (p/applies-to? (p/false-path (ab)) (document-string "a") (document-string "b")))
     (ok (not (p/applies-to? (p/false-path (ab)) (document-string "a") (document-string "c"))))
     (ok (p/applies-to? (document-map) (document-string "x") (document-string "y")))
     (ok (p/applies-to? (document-map :from (document-vector (document-string "p") (document-string "q")))
                        (document-string "q") (document-string "z")))
     (ok (p/applies-to? (document-map :to (document-set (document-keyword :k1) (document-keyword :k2)))
                        (document-string "a") (document-keyword :k2)))
     (ok (not (p/applies-to? (document-map :to (document-set (document-keyword :k1)))
                             (document-string "a") (document-keyword :k2))))))

(defn main [] :i64
  (+ (entry-checks) (match-checks)))
