(ns face-match.model
  (:export [compare-result main]))

;; Parity port of face_match.model/compare-result (the .cljc oracle beside
;; this file). The original builds the non-adjudicating result record from an
;; opts map with defaults: status :review, reason :not-implemented,
;; :face-match/non-adjudicating always true (hardcoded in the original).
;;
;; Value-shape notes, following the precedent documented in
;; bounded_no_matcher.kotoba in this same directory:
;;  - the original's :face-match/confidence is Option<f64> (nil on every
;;    path reachable in this repo -- no IFaceMatcher implementation exists).
;;    This compiler's bare :option-i64 fails typed Wasm lowering and its
;;    parametric [:option :f64] does not type-check (reproduced and
;;    documented in bounded_no_matcher.kotoba), so confidence is carried as
;;    a :confidence-present :bool. Nothing is lost on the reachable path:
;;    there has never been a value to represent. Removal condition: when a
;;    real, validated matcher lands behind face-match.ports/IFaceMatcher,
;;    re-admit the confidence value.
;;  - the matcher path's nil :face-match/reason is likewise not reachable
;;    (it only arises when an injected matcher returns nil); the record
;;    carries a :keyword reason, matching every reachable outcome.
(def compare-result-type
  [:record :face-match/compare-result
   [[:status :keyword] [:confidence-present :bool]
    [:reason :keyword] [:non-adjudicating :bool]]])

;; status/reason/confidence-presence are the caller-supplied opts of the
;; original (defaulted by the callers, exactly as the cljc callers do);
;; :non-adjudicating is hardcoded true in the original and stays true here.
(defn compare-result [status :keyword reason :keyword confidence-present :bool]
  [:alias compare-result-type]
  (record compare-result-type status confidence-present reason true))

;; Marker driver over the record: 42 = the reachable no-matcher outcome
;; (:review / :not-implemented / confidence absent / non-adjudicating),
;; 1..3/4 isolate a wrong status / reason / non-adjudicating / other.
(defn main [] :i64
  (let [r (compare-result :review :not-implemented false)]
    (if (= (record-get compare-result-type r :status) :review)
      (if (= (record-get compare-result-type r :reason) :not-implemented)
        (if (record-get compare-result-type r :non-adjudicating)
          (if (record-get compare-result-type r :confidence-present) 1 42)
          2)
        3)
      4)))
