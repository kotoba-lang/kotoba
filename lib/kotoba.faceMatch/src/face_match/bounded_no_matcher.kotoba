(ns face-match.bounded-no-matcher
  (:export [match-without-matcher main]))

;; :confidence-present is a :bool standing in for the original's
;; Option<f64> :face-match/confidence -- this compiler's bare :option-i64
;; fails Wasm typed lowering ("typed Wasm operation is not qualified",
;; reproduced with a minimal option-none/option-some? repro independent of
;; this record; see the migration record) and its parametric
;; [:option :f64]/[:option :string] payload does not type-check against
;; option-some?/option-none-of the way finra/jsda's [:option :string]
;; usage suggested it might. Since the no-matcher path this profile covers
;; never has a real confidence value anyway, :confidence-present is always
;; false here -- not a workaround that loses information, since there was
;; never a value to represent on this path.
(def compare-result-type
  [:record :face-match/compare-result
   [[:status :keyword] [:confidence-present :bool]
    [:reason :keyword] [:non-adjudicating :bool]]])

(defn match-without-matcher [] [:alias compare-result-type]
  (record compare-result-type :review false :not-implemented true))

(defn main [] :i64
  (let [r (match-without-matcher)]
    (if (= (record-get compare-result-type r :status) :review)
      (if (= (record-get compare-result-type r :reason) :not-implemented)
        (if (record-get compare-result-type r :non-adjudicating)
          (if (record-get compare-result-type r :confidence-present) 1 42)
          2)
        3)
      4)))
