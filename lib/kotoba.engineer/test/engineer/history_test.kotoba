;; Test for engineer.history. main returns the number of failed cases.
(ns engineer.history-test
  (:export [main])
  (:require [engineer.history :as hs]))

(defn- g [m :document k :keyword] :document
  (option-value-of [:option :document] (document-get m k) (document-null)))
(defn- i64v [m :document k :keyword] :i64
  (option-value-of [:option :i64] (document-i64-value (g m k)) -1))
(defn- at [v :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at v i) (document-null)))
(defn- chk-i64 [got :i64 want :i64] :i64
  (if (= got want) 0 1))
(defn- chk-bool [got :bool want :bool] :i64
  (if (= got want) 0 1))

(defn- case-push [] :i64
  (let [h0 (hs/history)
        r1 (hs/push h0 (document-string "draw") (document-string "d1"))
        h1 (at r1 1)]
    (+ (chk-i64 (i64v h0 :next-id) 1)
       (+ (chk-i64 (option-value-of [:option :i64] (document-i64-value (at r1 0)) -1) 1)
          (+ (chk-i64 (document-count (hs/stack h1)) 1)
             (+ (chk-bool (hs/can-undo? h1) true)
                (chk-bool (hs/can-redo? h1) false)))))))

(defn- case-undo-redo [] :i64
  (let [h1 (at (hs/push (hs/history) (document-string "draw") (document-string "d1")) 1)
        u (hs/undo h1)
        h2 (at u 1)
        rd (hs/redo h2)
        h3 (at rd 1)]
    (+ (chk-i64 (i64v (at u 0) :id) 1)
       (+ (chk-bool (hs/can-redo? h2) true)
          (+ (chk-bool (hs/can-undo? h2) false)
             (+ (chk-i64 (i64v (at rd 0) :id) 1)
                (chk-bool (hs/can-undo? h3) true)))))))

(defn- case-empty-and-clear [] :i64
  (let [h1 (at (hs/push (hs/history) (document-string "draw") (document-string "d1")) 1)
        h2 (at (hs/undo h1) 1)
        u2 (hs/undo (at (hs/undo h2) 1))
        r2 (hs/push h2 (document-string "move") (document-string "d2"))]
    (+ (chk-bool (document-equal? (at u2 0) (document-null)) true)
       (+ (chk-bool (hs/can-redo? (at r2 1)) false)
          (chk-i64 (i64v (at r2 1) :next-id) 3)))))

(defn main [] :i64
  (+ (case-push) (+ (case-undo-redo) (case-empty-and-clear))))
