;; Port of engineer.history (history.cljk), Kotoba-native.
;;
;; The history is a :document map {:undo-stack [] :redo-stack [] :next-id 1}.
;; Entries are {:id :action :timestamp 0 :data} documents.
;; Named divergences:
;;   - the source returns Clojure tuples [id history'] and [entry history'].
;;     A tuple is a 2-element :document vector here. An absent entry (nothing
;;     to undo or redo) is the document null in position 0.
;;   - :data is an opaque document (the source accepts any value).
(ns engineer.history
  (:export [history push undo redo can-undo? can-redo? stack]))

(defn- field [h :document k :keyword] :document
  (option-value-of [:option :document] (document-get h k) (document-null)))

(defn- next-id [h :document] :i64
  (option-value-of [:option :i64] (document-i64-value (field h :next-id)) 1))

(defn history [] :document
  (document-map :undo-stack (document-vector)
                :redo-stack (document-vector)
                :next-id (document-i64 1)))

(defn push [h :document action :document data :document] :document
  (let [id (next-id h)
        entry (document-map :id (document-i64 id)
                            :action action
                            :timestamp (document-i64 0)
                            :data data)
        undo-stack (document-vector-conj (field h :undo-stack) entry)
        h1 (document-assoc h :undo-stack undo-stack)
        h2 (document-assoc h1 :redo-stack (document-vector))
        h3 (document-assoc h2 :next-id (document-i64 (+ id 1)))]
    (document-vector (document-i64 id) h3)))

(defn undo [h :document] :document
  (let [from (field h :undo-stack)
        n (document-count from)]
    (if (= n 0)
      (document-vector (document-null) h)
      (let [entry (option-value-of [:option :document] (document-vector-at from (- n 1)) (document-null))
            h1 (document-assoc h :undo-stack (document-vector-remove from (- n 1)))
            h2 (document-assoc h1 :redo-stack (document-vector-conj (field h :redo-stack) entry))]
        (document-vector entry h2)))))

(defn redo [h :document] :document
  (let [from (field h :redo-stack)
        n (document-count from)]
    (if (= n 0)
      (document-vector (document-null) h)
      (let [entry (option-value-of [:option :document] (document-vector-at from (- n 1)) (document-null))
            h1 (document-assoc h :redo-stack (document-vector-remove from (- n 1)))
            h2 (document-assoc h1 :undo-stack (document-vector-conj (field h :undo-stack) entry))]
        (document-vector entry h2)))))

(defn can-undo? [h :document] :bool
  (> (document-count (field h :undo-stack)) 0))

(defn can-redo? [h :document] :bool
  (> (document-count (field h :redo-stack)) 0))

(defn stack [h :document] :document
  (field h :undo-stack))
