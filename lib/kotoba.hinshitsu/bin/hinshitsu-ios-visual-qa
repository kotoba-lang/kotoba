#!/usr/bin/env bash
set -euo pipefail

bundle_id=""
baseline=""
candidate=""
device="booted"
threshold="0.02"
black_threshold="0.03"
launch_timeout="20"
capture_timeout="20"
settle_seconds="2"

json_escape() { sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' ' '; }

receipt() {
  local ok="$1" code="$2" detail="${3:-}"
  printf '{"schema":"hinshitsu.ios-visual.v0","ok":%s,"code":"%s","target":"ios","bundleId":"%s","device":"%s","detail":"%s"}\n' \
    "$ok" "$code" "$bundle_id" "$device" "$(printf '%s' "$detail" | json_escape)"
}

run_with_timeout() {
  local seconds="$1"; shift
  "$@" & local command_pid=$!
  (sleep "$seconds"; kill -TERM "$command_pid" 2>/dev/null || true; sleep 2; kill -KILL "$command_pid" 2>/dev/null || true) & local watcher_pid=$!
  local status=0
  wait "$command_pid" || status=$?
  kill "$watcher_pid" 2>/dev/null || true
  wait "$watcher_pid" 2>/dev/null || true
  return "$status"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --bundle-id) bundle_id="${2:-}"; shift 2 ;;
    --baseline) baseline="${2:-}"; shift 2 ;;
    --candidate) candidate="${2:-}"; shift 2 ;;
    --device) device="${2:-booted}"; shift 2 ;;
    --threshold) threshold="${2:-0.02}"; shift 2 ;;
    --black-threshold) black_threshold="${2:-0.03}"; shift 2 ;;
    --launch-timeout) launch_timeout="${2:-20}"; shift 2 ;;
    --capture-timeout) capture_timeout="${2:-20}"; shift 2 ;;
    --settle-seconds) settle_seconds="${2:-2}"; shift 2 ;;
    --help)
      printf 'usage: hinshitsu-ios-visual-qa --bundle-id ID --baseline FILE --candidate FILE [--device UDID|booted] [--threshold RMSE] [--black-threshold LUMA]\n'
      exit 0 ;;
    *) receipt false invalid-argument "$1"; exit 64 ;;
  esac
done

if [[ -z "$bundle_id" || -z "$candidate" ]]; then
  receipt false invalid-config "--bundle-id and --candidate are required"
  exit 64
fi
if ! command -v xcrun >/dev/null 2>&1; then receipt false xcrun-missing; exit 69; fi
if ! command -v magick >/dev/null 2>&1; then receipt false imagemagick-missing; exit 69; fi
mkdir -p "$(dirname "$candidate")"

launch_log="$(mktemp -t hinshitsu-ios-launch.XXXXXX)"
trap 'rm -f "$launch_log"' EXIT
if ! run_with_timeout "$launch_timeout" xcrun simctl launch --terminate-running-process "$device" "$bundle_id" >"$launch_log" 2>&1; then
  receipt false app-launch-failed "$(<"$launch_log")"
  exit 1
fi
sleep "$settle_seconds"

if ! run_with_timeout "$capture_timeout" xcrun simctl io "$device" screenshot "$candidate" >"$launch_log" 2>&1; then
  receipt false capture-failed "$(<"$launch_log")"
  exit 1
fi

mean="$(magick "$candidate" -colorspace Gray -format '%[fx:mean]' info:)"
if awk -v value="$mean" -v limit="$black_threshold" 'BEGIN {exit !(value < limit)}'; then
  receipt false black-screen "meanLuma=$mean threshold=$black_threshold candidate=$candidate"
  exit 1
fi

difference="baseline-missing"
distortion=""
if [[ -n "$baseline" && -f "$baseline" ]]; then
  difference="$(magick compare -metric RMSE "$baseline" "$candidate" null: 2>&1 || true)"
  distortion="$(printf '%s' "$difference" | sed -n 's/.*(\([0-9.eE+-]*\)).*/\1/p')"
  if [[ -z "$distortion" ]]; then receipt false diff-invalid "$difference"; exit 1; fi
  if ! awk -v value="$distortion" -v limit="$threshold" 'BEGIN {exit !(value <= limit)}'; then
    receipt false visual-regression "distortion=$distortion threshold=$threshold candidate=$candidate baseline=$baseline"
    exit 1
  fi
fi

receipt true visual-ready "meanLuma=$mean distortion=${distortion:-none} candidate=$candidate baseline=${baseline:-none}"
