;; This repository's entry in the kotoba.repository-role-rules taxonomy.
;; Declared here (not merely inherited) so a reader of THIS repo alone can
;; verify which contract it claims to satisfy. ADR-2607266000 / ADR-2607299000.
{:schema "kotoba.repository-role-rules.v0"
 :this-repo
 {:name "machine"
  :tier :t0
  :role :contract
  ;; A contract that probes is not a contract: reading sysctl / cpuid /
  ;; navigator.gpu.limits is a host effect and belongs to whoever builds the
  ;; descriptor. Planning is likewise somebody else's tier.
  :must-not [:probe-hardware :perform-effects :plan-layout-or-order :decide-policy]
  :depends-on []}}
