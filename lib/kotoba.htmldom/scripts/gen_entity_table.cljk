#!/usr/bin/env kbb
;; Generates `kotoba/entity_data.kotoba` from `src/htmldom/core.cljk`.
;;
;; The named-character-reference table is 83 entries. A Kotoba typed map holds
;; 31 and a document container holds 32, so the table cannot be a map value --
;; it is a fixed-width STRING, the same shape `pattern-vm` carries its program
;; and `dom-table` carries its nodes in, for the same reason.
;;
;;   header  "E" count(4 hex)                    5 chars
;;   entry   name(6, space-padded) cp(4 hex)    10 chars
;;
;; Every replacement in this table is exactly one code point and the largest is
;; U+2717, so four hex digits are enough and a record is addressed by
;; arithmetic. Both facts are asserted below rather than assumed -- if a future
;; entry breaks either, this refuses instead of emitting a table that lies.
;;
;; ⚠ GENERATED. Do not hand-edit `kotoba/entity_data.kotoba`. `--check` fails
;; when it is stale, which is the same discipline `manifest/west.yml` is under.
;;
;;   kbb --backend sci scripts/gen_entity_table.cljk [--check]

(ns gen-entity-table
  (:require ["node:fs" :as fs]
            ["node:process" :as process]))

(def source "src/htmldom/core.cljk")
(def target "kotoba/entity_data.kotoba")
(def name-width 6)

(defn- pairs []
  (let [s (fs/readFileSync source "utf8")
        start (.indexOf s "  {\"amp\" \"&\"")
        end (.indexOf s "(def ^:private windows-1252")]
    (when (or (neg? start) (neg? end))
      (println "REFUSED: could not find named-char-refs in" source)
      (process/exit 2))
    (let [body (.replace (.slice s start end) (js/RegExp. ";;[^\\n]*" "g") "")
          re (js/RegExp. "\"((?:[^\"\\\\]|\\\\.)*)\"\\s+\"((?:[^\"\\\\]|\\\\.)*)\"" "g")]
      (loop [out []]
        (if-let [m (.exec re body)]
          (recur (conj out [(aget m 1) (aget m 2)]))
          out)))))

(defn- unescape [x]
  ;; the .cljc writes \u00A0 and \" -- read them the way the reader would
  (-> x
      (.replace (js/RegExp. "\\\\u([0-9a-fA-F]{4})" "g")
                (fn [_ h] (js/String.fromCharCode (js/parseInt h 16))))
      (.replace (js/RegExp. "\\\\\"" "g") "\"")
      (.replace (js/RegExp. "\\\\\\\\" "g") "\\")))

(defn- hex4 [n]
  (let [h (.toString n 16)]
    (str (apply str (repeat (- 4 (count h)) "0")) h)))

(defn- pad [s w]
  (str s (apply str (repeat (- w (count s)) " "))))

(defn- table []
  (let [ps (sort-by first (map (fn [[k v]] [k (unescape v)]) (pairs)))]
    (when (empty? ps)
      (println "REFUSED: the scrape found no entries") (process/exit 2))
    (doseq [[k v] ps]
      (when (> (count k) name-width)
        (println "REFUSED: entity name longer than" name-width ":" k) (process/exit 2))
      (when-not (= 1 (count v))
        (println "REFUSED: replacement is not one code point:" k (pr-str v)) (process/exit 2))
      (when (> (.charCodeAt v 0) 0xffff)
        (println "REFUSED: code point past four hex digits:" k) (process/exit 2)))
    [(count ps)
     (apply str (map (fn [[k v]] (str (pad k name-width) (hex4 (.charCodeAt v 0)))) ps))]))

(defn- render [n body]
  (str ";; GENERATED by scripts/gen_entity_table.cljk -- do not hand-edit.\n"
       ";;\n"
       ";; The named character references of `htmldom.core`, as a fixed-width\n"
       ";; string. A Kotoba typed map holds 31 entries and this table has " n ";\n"
       ";; the string is what `pattern-vm` and `dom-table` already do for the\n"
       ";; same reason.\n"
       ";;\n"
       ";;   header  \"E\" count(4 hex)                    5 chars\n"
       ";;   entry   name(" name-width ", space-padded) cp(4 hex)   " (+ name-width 4) " chars\n"
       ";;\n"
       ";; Sorted by name, so a reader may binary-search rather than scan.\n"
       "(ns entity-data (:export [main table entry-count]))\n\n"
       "(defn table [] :string\n  \"E" (hex4 n) body "\")\n\n"
       "(defn entry-count [] :i64\n  " n ")\n\n"
       "(defn main [] :i64\n  (app (ref entry-count)))\n"))

(let [[n body] (table)
      out (render n body)
      check? (some #{"--check"} (js->clj (.slice process/argv 2)))]
  (if check?
    (let [cur (try (fs/readFileSync target "utf8") (catch :default _ nil))]
      (if (= cur out)
        (do (println (str "SCANNED\t" n))
            (println "entity table is current")
            (process/exit 0))
        (do (println (str "SCANNED\t" n))
            (println "STALE:" target "does not match the source -- regenerate")
            (process/exit 1))))
    (do (fs/writeFileSync target out)
        (println (str "SCANNED\t" n))
        (println "wrote" target (str "(" (count out) " bytes, table " (count body) " chars)")))))
