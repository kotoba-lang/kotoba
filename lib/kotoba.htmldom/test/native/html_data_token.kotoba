(ns html-data-token-test
  (:require [htmldom-data :as data])
  (:export [main]))
(defn field [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))
(defn check [s :string kind :keyword consumed :i64 text :string value :i64 status :keyword error :keyword] :bool
  (let [t (data/next-token s)]
    (and (= (option-or (document-keyword-value (field t :kind)) :bad) kind)
         (= (option-or (document-i64-value (field t :consumed)) -1) consumed)
         (string=? (option-or (document-string-value (field t :text)) "bad") text)
         (= (option-or (document-i64-value (field t :value)) -2) value)
         (= (option-or (document-keyword-value (field t :status)) :bad) status)
         (= (option-or (document-keyword-value (field t :character-error)) :bad) error))))
(defn main [] :i64
  (if (and (check "" :data/eof 0 "" -1 :numeric/none :numeric/none)
           (check "猫😀&amp;" :data/text 7 "猫😀" -1 :numeric/none :numeric/none)
           (check "<p>" :data/tag-open 0 "" -1 :numeric/none :numeric/none)
           (check "&amp;" :data/named-reference 0 "" -1 :numeric/none :numeric/none)
           (check "&!" :data/text 1 "&" -1 :numeric/none :numeric/none)
           (check "&" :data/text 1 "&" -1 :numeric/none :numeric/none)
           (check "&#65;tail" :data/character 5 "" 65 :numeric/terminated :numeric/none)
           (check "&#x1f4a9z" :data/character 8 "" 128169 :numeric/missing-semicolon :numeric/none)
           (check "&#1114112!" :data/character 9 "" 65533 :numeric/missing-semicolon :numeric/outside-unicode)
           (check "&#x;" :data/text 3 "&#x" -1 :numeric/no-digits :numeric/none)
           (check "&#;" :data/text 2 "&#" -1 :numeric/no-digits :numeric/none)
           (check "&#146;" :data/character 6 "" 8217 :numeric/terminated :numeric/control)) 42 0))
