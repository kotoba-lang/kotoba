(ns html-comment-test
  (:require [htmldom-tokens :as tok] [htmldom-fragment :as frag] [htmldom-fragment-wire :as wire]
            [kotoba.wasm.dom :as dom]) (:export [main]))
(defn f [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn at [d :document i :i64] :document (option-or (document-vector-at d i) (document-null)))
(defn k [d :document] :keyword (option-or (document-keyword-value d) :bad))
(defn s [d :document] :string (option-or (document-string-value d) "?"))
(defn denied? [src :string] :bool
  (let [r (frag/parse src)] (and (= (k (f r :kind)) :fragment/unsupported) (= (document-kind (f r :document)) :null))))
(defn main [] :i64
  (let [r (frag/parse "<p>before<!--猫 & < -->after<!----></p>") d (f r :document)
        p (dom/node-by-id d 2) a (dom/node-by-id d 3) c (dom/node-by-id d 4)
        b (dom/node-by-id d 5) empty (dom/node-by-id d 6)
        parsed (tok/tokenize "x<!--猫-->y") ts (f parsed :tokens)
        encoded (wire/encode "<p>before<!--猫-->after</p>")]
    (if (and (= (k (f r :kind)) :fragment/ok) (= (document-count (f p :children)) 4)
             (string=? (s (f a :text)) "before") (= (k (f c :node/type)) :comment)
             (string=? (s (f c :text)) "猫 & < ") (string=? (s (f b :text)) "after")
             (= (k (f empty :node/type)) :comment) (string=? (s (f empty :text)) "")
             (= (k (f parsed :kind)) :html/done) (= (k (f (at ts 1) :kind)) :html/comment)
             (string=? (s (f (at ts 1) :text)) "猫")
             (option-some?-of [:option :string] encoded) (string-contains? (option-or encoded "") ":dom/create-comment")
             (denied? "x<!--unfinished") (denied? "x<!--bad--!>rest-->")
             (denied? "x<!-->wrong-->") (denied? "x<!--->wrong-->")
             (denied? "x<!--nested<!--x-->") (denied? "x<!--bad\u0000data-->")) 42 0)))
