(ns html-named-ref-test
  (:require [html-named-ref :as named])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn check [s :string attr :bool length :i64 first :i64 second :i64 status :keyword] :bool
  (let [d (named/consume s attr)]
    (and (= (option-or (document-i64-value (field d :consumed)) -1) length)
         (= (option-or (document-i64-value (field d :value)) -2) first)
         (= (option-or (document-i64-value (field d :value2)) -2) second)
         (= (option-or (document-keyword-value (field d :status)) :bad) status))))
(defn main [] :i64
  (if (and (check "amp;tail" false 4 38 -1 :named/terminated)
           (check "amp=1" false 3 38 -1 :named/missing-semicolon)
           (check "amp=1" true 0 -1 -1 :named/ambiguous-attribute)
           (check "amp!" true 3 38 -1 :named/missing-semicolon)
           (check "notit;" false 3 172 -1 :named/missing-semicolon)
           (check "notit;" true 0 -1 -1 :named/ambiguous-attribute)
           (check "notin;" false 6 8713 -1 :named/terminated)
           (check "NotEqualTilde;" false 14 8770 824 :named/terminated)
           (check "acE;" false 4 8766 819 :named/terminated)
           (check "xyzzy;" false 0 -1 -1 :named/unknown)
           (check "" false 0 -1 -1 :named/unknown)
           (= (named/lookup "猫") -1)
           (check "amp猫" false 3 38 -1 :named/missing-semicolon)) 42 0))
