(ns html-fragment-bounds-test
  (:require [htmldom-fragment :as fragment] [kotoba.wasm.dom :as dom])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn kind [d :document] :keyword (option-or (document-keyword-value (field d :kind)) :bad))
(defn many [text :string n :i64] :string
  (loop [i 0 out ""] (if (= i n) out (recur (+ i 1) (string-concat out text)))))
(defn limit? [r :document] :bool
  (and (= (kind r) :fragment/limit) (= (document-kind (field r :document)) :null)))
(defn nested [n :i64] :string
  (string-concat (many "<span>" n) (many "</span>" n)))
(defn main [] :i64
  (let [ok (fragment/parse (many "<br>" 32)) root (dom/node-by-id (field ok :document) 1)
        too-many (fragment/parse (many "<br>" 33))
        extra-text (fragment/parse (string-concat (many "<br>" 32) "x"))
        deep-ok (fragment/parse (nested 31)) deep-bad (fragment/parse (nested 32))]
    (if (and (= (kind ok) :fragment/ok) (= (document-count (field root :children)) 32)
             (limit? too-many) (limit? extra-text) (= (kind deep-ok) :fragment/ok) (limit? deep-bad)) 42 0)))
