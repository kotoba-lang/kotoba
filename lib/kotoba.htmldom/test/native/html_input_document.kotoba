(ns html-input-document-test
  (:require [htmldom-document :as doc] [htmldom-fragment-wire :as wire])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn text [d :document] :string (option-or (document-string-value d) ""))
(defn main [] :i64
  (let [source "<!doctype html>\r\n<html><head><title>猫\r\n犬\r鳥</title></head><body><p>一\r二</p></body></html>"
        r (doc/unwrap source) result (wire/encode-page source) page (option-or result (document-null))]
    (if (and (string=? (text (field r :title)) "猫\n犬\n鳥")
             (string=? (text (field r :body)) "<p>一\n二</p>")
             (option-some?-of [:option :document] result)
             (string=? (text (field page :title)) "猫\n犬\n鳥")
             (> (string-length (text (field page :wire))) 0)) 42 0)))
