(ns html-list-test
  (:require [htmldom-fragment :as fragment] [kotoba.wasm.dom :as dom])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn kval [d :document] :keyword (option-or (document-keyword-value d) :bad))
(defn number [d :document] :i64 (option-or (document-i64-value d) -1))
(defn text [d :document] :string (option-or (document-string-value d) ""))
(defn at [d :document i :i64] :document (option-or (document-vector-at d i) (document-null)))
(defn main [] :i64
  (let [result (fragment/parse "<ol><li>a<ul><li>b<li>c</ul><li>d</ol>")
        d (field result :document) ol (dom/node-by-id d 2) li (dom/node-by-id d 3)
        ul (dom/node-by-id d 5) b (dom/node-by-id d 6) c (dom/node-by-id d 8) last (dom/node-by-id d 10)]
    (if (and (= (kval (field result :kind)) :fragment/ok)
             (= (kval (field ol :tag)) :ol) (= (kval (field li :tag)) :li)
             (= (kval (field ul :tag)) :ul) (= (kval (field b :tag)) :li)
             (= (kval (field c :tag)) :li) (= (kval (field last :tag)) :li)
             (= (number (at (field ol :children) 0)) 3) (= (number (at (field ol :children) 1)) 10)
             (= (number (at (field li :children) 1)) 5)
             (= (number (at (field ul :children) 0)) 6) (= (number (at (field ul :children) 1)) 8)
             (string=? (text (field (dom/node-by-id d 4) :text)) "a")
             (string=? (text (field (dom/node-by-id d 7) :text)) "b")
             (string=? (text (field (dom/node-by-id d 9) :text)) "c")
             (string=? (text (field (dom/node-by-id d 11) :text)) "d")) 42 0)))
