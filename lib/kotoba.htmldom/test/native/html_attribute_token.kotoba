(ns html-attribute-token-test
  (:require [htmldom-attribute :as attr])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn check [s :string mode :keyword kind :keyword consumed :i64 text :string value :i64 status :keyword] :bool
  (let [d (attr/next-token s mode)]
    (and (= (option-or (document-keyword-value (field d :kind)) :bad) kind)
         (= (option-or (document-i64-value (field d :consumed)) -1) consumed)
         (string=? (option-or (document-string-value (field d :text)) "bad") text)
         (= (option-or (document-i64-value (field d :value)) -2) value)
         (= (option-or (document-keyword-value (field d :status)) :bad) status))))
(defn main [] :i64
  (if (and (check "猫😀&amp;" :attribute/double :attribute/text 7 "猫😀" -1 :none)
           (check "\"rest" :attribute/double :attribute/quote-end 1 "" -1 :none)
           (check "'rest" :attribute/single :attribute/quote-end 1 "" -1 :none)
           (check " space" :attribute/unquoted :attribute/space-end 1 "" -1 :none)
           (check ">rest" :attribute/unquoted :attribute/tag-end 1 "" -1 :none)
           (check "<rest" :attribute/unquoted :attribute/text 1 "<" -1 :attribute/unexpected-character)
           (check "&amp=1" :attribute/double :attribute/text 1 "&" -1 :named/ambiguous-attribute)
           (check "&notit;" :attribute/single :attribute/text 1 "&" -1 :named/ambiguous-attribute)
           (check "&amp!" :attribute/unquoted :attribute/character 4 "" 38 :named/missing-semicolon)
           (check "&amp;" :attribute/double :attribute/character 5 "" 38 :named/terminated)
           (check "&#65;" :attribute/double :attribute/character 5 "" 65 :numeric/terminated)
           (check "&#x;" :attribute/double :attribute/text 3 "&#x" -1 :numeric/no-digits)
           (check "" :attribute/double :attribute/eof 0 "" -1 :attribute/eof-in-tag)
           (check "" :attribute/unquoted :attribute/eof 0 "" -1 :attribute/eof-in-tag)
           (check "x" :attribute/bad :attribute/invalid-mode 0 "" -1 :none)
           (= (option-or (document-i64-value (field (attr/next-token "&NotEqualTilde;" :attribute/double) :value2)) -1) 824)) 42 0))
