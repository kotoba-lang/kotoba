(ns html-chunk-budget-test
  (:require [htmldom-tokens :as tokens])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn kind [d :document] :keyword (option-or (document-keyword-value (field d :kind)) :bad))
(defn many [n :i64] :string
  (loop [i 0 out ""] (if (= i n) out (recur (+ i 1) (string-concat out "<br a b c d e>")))))
(defn main [] :i64
  (let [r (tokens/tokenize-chunks (many 190))]
    (if (and (= (kind r) :html/limit)
             (= (option-or (document-i64-value (field r :offset)) -1) (* 184 14))
             (= (document-count (field r :chunks)) 6)
             (= (document-count (option-or (document-vector-at (field r :chunks) 5) (document-null))) 29)) 42 0)))
