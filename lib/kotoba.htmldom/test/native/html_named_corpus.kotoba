(ns html-named-corpus-test
  (:require [html-entities-data :as data] [html-named-ref :as named])
  (:export [main]))
(defn name-end [table :string at :i64] :i64
  (loop [n 0]
    (if (or (= n 32) (= (string-code-point-at table (+ at n)) 32)) n (recur (+ n 1)))))
(defn main [] :i64
  (loop [i 0]
    (if (= i (data/entry-count)) 42
      (let [table (data/chunk (quot i 300))
            at (* (- i (* 300 (quot i 300))) 44)
            name (string-substring table at (+ at (name-end table at)))]
        (if (= (named/lookup name) i) (recur (+ i 1)) 0)))))
