(ns html-input-test
  (:require [htmldom-input :as input] [htmldom-fragment :as fragment] [kotoba.wasm.dom :as dom])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn text [d :document] :string (option-or (document-string-value d) ""))
(defn kind [d :document] :keyword (option-or (document-keyword-value d) :bad))
(defn prefix [n :i64] :string
  (loop [i 0 out ""] (if (= i n) out (recur (+ i 1) (string-concat out "a")))))
(defn main [] :i64
  (let [source "<p title='a\r\nb'>一\r\n二\r三</p>" normalized (input/preprocess source)
        parsed (fragment/parse source) d (field parsed :document) p (dom/node-by-id d 2) t (dom/node-by-id d 3)
        reference (fragment/parse "<p>a&#13;b</p>") ref-text (dom/node-by-id (field reference :document) 3)
        pre (prefix 255) boundary (input/preprocess (string-concat pre "\r\n猫\r"))
        unicode-boundary (input/preprocess (string-concat pre "猫\r\n終"))]
    (if (and (option-some?-of [:option :string] normalized)
             (string=? (option-or normalized "") "<p title='a\nb'>一\n二\n三</p>")
             (= (kind (field parsed :kind)) :fragment/ok)
             (string=? (text (field (field p :attrs) :title)) "a\nb")
             (string=? (text (field t :text)) "一\n二\n三")
             (string=? (text (field ref-text :text)) "a\rb")
             (string=? (option-or boundary "") (string-concat pre "\n猫\n"))
             (string=? (option-or unicode-boundary "") (string-concat pre "猫\n終"))) 42 0)))
