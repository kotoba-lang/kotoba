(ns html-link-test
  (:require [htmldom-fragment :as f] [kotoba.wasm.dom :as dom])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn kind [d :document] :keyword (option-or (document-keyword-value d) :bad))
(defn text [d :document] :string (option-or (document-string-value d) ""))
(defn main [] :i64
  (let [r (f/parse "<p><a href='../next?x=1&amp;y=2' title='go'>Next</a></p>")
        d (field r :document) a (dom/node-by-id d 3) attrs (field a :attrs)
        invalid (f/parse "<div href='x'>bad</div>")]
    (if (and (= (kind (field r :kind)) :fragment/ok) (= (kind (field a :tag)) :a)
             (string=? (text (field attrs :href)) "../next?x=1&y=2")
             (string=? (text (field attrs :title)) "go")
             (= (kind (field invalid :kind)) :fragment/unsupported)) 42 0)))
