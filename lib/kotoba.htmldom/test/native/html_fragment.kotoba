(ns html-fragment-test
  (:require [htmldom-fragment :as frag] [kotoba.wasm.dom :as dom])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn kval [d :document] :keyword (option-or (document-keyword-value d) :bad))
(defn sval [d :document] :string (option-or (document-string-value d) "?"))
(defn ival [d :document] :i64 (option-or (document-i64-value d) -1))
(defn at [d :document i :i64] :document (option-or (document-vector-at d i) (document-null)))
(defn refused? [s :string] :bool
  (let [r (frag/parse s)] (and (= (kval (field r :kind)) :fragment/unsupported) (= (document-kind (field r :document)) :null))))
(defn same-tree? [input :string closed :string] :bool
  (let [a (frag/parse input) b (frag/parse closed)]
    (and (= (kval (field a :kind)) :fragment/ok) (= (kval (field b :kind)) :fragment/ok)
         (document-equal? (dom/tree (field a :document)) (dom/tree (field b :document))))))
(defn many [n :i64] :string (loop [i 0 out ""] (if (= i n) out (recur (+ i 1) (string-concat out "&amp;")))))
(defn main [] :i64
  (let [r (frag/parse "<div title='猫&amp;犬'>Hi &NotEqualTilde;<span>世界</span><br></div>")
        d (field r :document) root (dom/node-by-id d 1) outer (dom/node-by-id d 2)
        long (frag/parse (string-concat "<div>" (string-concat (many 63) "</div>")))
        long-text (dom/node-by-id (field long :document) 3)
        t (dom/node-by-id d 3) inner (dom/node-by-id d 4) inner-text (dom/node-by-id d 5) line (dom/node-by-id d 6)]
    (if (and (= (kval (field r :kind)) :fragment/ok)
             (= (kval (field root :tag)) :div) (= (ival (at (field root :children) 0)) 2)
             (= (kval (field outer :tag)) :div) (string=? (sval (field (field outer :attrs) :title)) "猫&犬")
             (= (document-count (field outer :children)) 3)
             (string=? (sval (field t :text)) "Hi ≂̸")
             (= (kval (field inner :tag)) :span) (= (ival (at (field inner :children) 0)) 5)
             (string=? (sval (field inner-text :text)) "世界") (= (kval (field line :tag)) :br)
             (= (kval (field long :kind)) :fragment/ok) (string=? (sval (field long-text :text)) "&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&")
             (same-tree? "<p>one<p>two" "<p>one</p><p>two</p>")
             (same-tree? "<div><p>one<p>two</div>" "<div><p>one</p><p>two</p></div>")
             (same-tree? "<p>one<section>two</section>" "<p>one</p><section>two</section>")
             (same-tree? "<p>one<h2>two</h2>" "<p>one</p><h2>two</h2>")
             (refused? "<p><em>one<div>two</div>")
             (refused? "<script>bad</script>") (refused? "<div><span></div>")
             (refused? "<p><div>x</div></p>") (refused? "<span/>")
             (refused? "<a href='https://example.com'>x</a>") (refused? "<div onclick='x'>x</div>")) 42 0)))
