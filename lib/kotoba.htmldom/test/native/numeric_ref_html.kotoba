(ns numeric-ref-html-test
  (:require [numeric-ref :as nr])
  (:export [main]))

;; HTML numeric end-state cases plus legacy contract and invalid digit inputs.
(defn field [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))
(defn token? [s :string length :i64 value :i64 status :keyword] :bool
  (let [d (nr/consume-html s)]
    (and (= (option-or (document-i64-value (field d :consumed)) -1) length)
         (= (option-or (document-i64-value (field d :value)) -2) value)
         (= (option-or (document-keyword-value (field d :status)) :bad) status))))
(defn error? [s :string error :keyword status :keyword] :bool
  (let [d (nr/consume-html s)]
    (and (= (option-or (document-keyword-value (field d :character-error)) :bad) error)
         (= (option-or (document-keyword-value (field d :status)) :bad) status))))
(defn main [] :i64
  (if (and (= (nr/decode-html "65" 10) 65)
           (= (nr/decode-html "1f4a9" 16) 128169)
           (= (nr/decode-html "0" 10) 65533)
           (= (nr/decode-html "1114111" 10) 1114111)
           (= (nr/decode-html "1114112" 10) 65533)
           (= (nr/decode-html "999999999999999999999999999" 10) 65533)
           (= (nr/decode-html "00000000000000000065" 10) 65)
           (= (nr/decode-html "d800" 16) 65533)
           (= (nr/decode-html "dfff" 16) 65533)
           (= (nr/decode-html "d7ff" 16) 55295)
           (= (nr/decode-html "e000" 16) 57344)
           (= (nr/decode-html "146" 10) 8217)
           (= (nr/decode-html "129" 10) 129)
           (= (nr/decode-html "" 10) -1)
           (= (nr/decode-html "999999999999z" 10) -1)
           (= (nr/decode-html "12x" 10) -1)
           (= (nr/decode-html "10" 8) -1)
           (nr/test-decimal) (nr/test-hex) (nr/test-range)
           (nr/test-c1) (nr/test-zero) (nr/test-invalid)
           (token? "65;tail" 3 65 :numeric/terminated)
           (token? "x1f4a9z" 6 128169 :numeric/missing-semicolon)
           (token? "X80;z" 4 8364 :numeric/terminated)
           (token? "1114112!" 7 65533 :numeric/missing-semicolon)
           (token? "999999999999999999;" 19 65533 :numeric/terminated)
           (token? "x;" 1 -1 :numeric/no-digits)
           (token? "" 0 -1 :numeric/no-digits)
           (token? "a" 0 -1 :numeric/no-digits)
           (token? "65😀" 2 65 :numeric/missing-semicolon)
           (error? "0;" :numeric/null-character :numeric/terminated)
           (error? "1114112!" :numeric/outside-unicode :numeric/missing-semicolon)
           (error? "xd800;" :numeric/surrogate :numeric/terminated)
           (error? "xfdd0;" :numeric/noncharacter :numeric/terminated)
           (error? "x10ffff;" :numeric/noncharacter :numeric/terminated)
           (error? "xfdef;" :numeric/noncharacter :numeric/terminated)
           (error? "xfddc;" :numeric/noncharacter :numeric/terminated)
           (error? "xfdd0z" :numeric/noncharacter :numeric/missing-semicolon)
           (error? "xfdf0;" :numeric/none :numeric/terminated)
           (error? "13;" :numeric/control :numeric/terminated)
           (error? "11;" :numeric/control :numeric/terminated)
           (error? "146;" :numeric/control :numeric/terminated)
           (error? "9;" :numeric/none :numeric/terminated)
           (error? "10;" :numeric/none :numeric/terminated)
           (error? "12;" :numeric/none :numeric/terminated)
           (error? "x;" :numeric/none :numeric/no-digits)
           (= (nr/decode "1114112" 10) -1)
           (= (nr/decode "d800" 16) -1)) 42 0))
