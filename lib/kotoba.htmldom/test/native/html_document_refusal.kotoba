(ns html-document-refusal-test
  (:require [htmldom-document :as doc] [htmldom-fragment-wire :as wire])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn kind [d :document] :keyword (option-or (document-keyword-value (field d :kind)) :bad))
(defn refused? [s :string] :bool (= (kind (doc/unwrap s)) :document/unsupported))
(defn main [] :i64
  (if (and (refused? "<!doctype html public 'x'><html><head></head><body>x</body></html>")
           (refused? "<!doctype html><html><head><meta http-equiv='refresh' content='0'></head><body>x</body></html>")
           (refused? "<!doctype html><html><head><title>x</title><title>y</title></head><body>x</body></html>")
           (refused? "<!doctype html><html><head></head><body>x</body></html>猫")
           (not (option-some?-of [:option :document] (wire/encode-page "<!doctype html><html><head></head><body><script>x</script></body></html>")))) 42 0))
