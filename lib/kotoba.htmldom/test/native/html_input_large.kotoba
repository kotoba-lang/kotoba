(ns html-input-large-test (:require [htmldom-input :as input]) (:export [main]))
(defn main [] :i64
  ;; 59,904 CR bytes stay within the Browser response limit and previously
  ;; exhausted the native string pool when normalized in one growing string.
  (let [source (loop [n 0 out ""]
                 (if (= n 234) out (recur (+ n 1) (string-concat out "\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r\r"))))
        result (input/preprocess source)]
    (if (and (option-some?-of [:option :string] result)
             (= (string-length (option-or result "")) 59904)
             (= (string-index-of (option-or result "") "\r") -1)
             (= (string-index-of (option-or result "") "\n") 0)) 42 0)))
