(ns html-tag-test
  (:require [htmldom-tag :as tag])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn kval [d :document] :keyword (option-or (document-keyword-value d) :bad))
(defn sval [d :document] :string (option-or (document-string-value d) "?"))
(defn ival [d :document] :i64 (option-or (document-i64-value d) -1))
(defn bval [d :document] :bool (option-or (document-bool-value d) false))
(defn at [d :document i :i64] :document (option-or (document-vector-at d i) (document-null)))
(defn long-input [] :string
  (loop [i 0 s "x"]
    (if (= i 16) (string-concat s "x") (recur (+ i 1) (string-concat s s)))))
(defn main [] :i64
  (let [a (tag/parse "<DiV TITLE='猫&amp;犬' enabled Data-X=&#65;>")
        attrs (field a :attributes) first (at attrs 0) second (at attrs 1) third (at attrs 2)
        b (tag/parse "<p a='&NotEqualTilde;' A=wrong />")
        ba (field b :attributes) c (tag/parse "</DIV>")
        incomplete (tag/parse "<p title='unfinished")
        unknown (tag/parse "<!-- hi -->")
        unsupported (tag/parse "<p x=a<b>")
        many (tag/parse "<p a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 a21 a22 a23 a24 a25 a26 a27 a28 a29 a30 a31>")
        huge (tag/parse (long-input))]
    (if (and (= (kval (field a :kind)) :tag/start) (string=? (sval (field a :name)) "div")
             (= (ival (field a :consumed)) 46) (= (document-count attrs) 3)
             (string=? (sval (field first :name)) "title") (string=? (sval (field first :value)) "猫&犬")
             (string=? (sval (field second :name)) "enabled") (string=? (sval (field second :value)) "")
             (string=? (sval (field third :name)) "data-x") (string=? (sval (field third :value)) "A")
             (= (kval (field b :kind)) :tag/start) (bval (field b :self-closing)) (= (document-count ba) 1)
             (string=? (sval (field (at ba 0) :value)) "≂̸")
             (= (kval (field c :kind)) :tag/end) (string=? (sval (field c :name)) "div")
             (= (kval (field incomplete :kind)) :tag/incomplete)
             (= (kval (field unknown :kind)) :tag/handoff)
             (= (kval (field unsupported :kind)) :tag/unsupported)
             (= (kval (field many :kind)) :tag/limit)
             (= (kval (field huge :kind)) :tag/limit)) 42 0)))
