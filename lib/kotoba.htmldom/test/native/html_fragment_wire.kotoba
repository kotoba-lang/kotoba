(ns html-fragment-wire-test
  (:require [htmldom-fragment-wire :as wire])
  (:capabilities [:io/write])
  (:export [main]))
(defn main [] :i64
  (let [x (wire/encode "<div title='猫&amp;犬'>Hi &NotEqualTilde;<span>世界</span><br></div>")
        escaped (wire/encode "<span title='&quot;'>\"\\\n猫</span>")
        semantic (wire/encode "<section><h1>Hi <em>世界</em></h1><p><strong>重要</strong> <code>x</code></p></section>")
        reject (wire/encode "<script>alert(1)</script>")]
    (if (or (not (option-some?-of [:option :string] x)) (not (option-some?-of [:option :string] escaped)) (not (option-some?-of [:option :string] semantic))
            (option-some?-of [:option :string] reject)) 0
      (let [w (typed-cap-call :io/write :string :string (string-concat "WIRE " (string-concat (option-or x "") "\n")))
            w2 (typed-cap-call :io/write :string :string (string-concat "WIRE_ESC " (string-concat (option-or escaped "") "\n")))
            w3 (typed-cap-call :io/write :string :string (string-concat "WIRE_SEM " (string-concat (option-or semantic "") "\n")))] 42))))
