(ns html-document-test
  (:require [htmldom-document :as doc] [htmldom-fragment-wire :as wire])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn key [d :document] :keyword (option-or (document-keyword-value d) :bad))
(defn text [d :document] :string (option-or (document-string-value d) ""))
(defn main [] :i64
  (let [html " \n<!DOCTYPE html><HTML><HEAD><meta charset='utf-8'><TITLE>猫 &amp; 犬 &lt; x</TITLE></HEAD><BODY><h1>Hello</h1><p>World</p></BODY></HTML> \n"
        r (doc/unwrap html) page (wire/encode-page html) value (option-or page (document-null))]
    (if (and (= (key (field r :kind)) :document/ok)
             (string=? (text (field r :body)) "<h1>Hello</h1><p>World</p>")
             (string=? (text (field r :title)) "猫 & 犬 < x")
             (option-some?-of [:option :document] page)
             (string=? (text (field value :title)) "猫 & 犬 < x")
             (> (string-length (text (field value :wire))) 0)) 42 0)))
