(ns html-list-eof-test
  (:require [htmldom-fragment :as fragment] [kotoba.wasm.dom :as dom])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn kval [d :document] :keyword (option-or (document-keyword-value d) :bad))
(defn number [d :document] :i64 (option-or (document-i64-value d) -1))
(defn at [d :document i :i64] :document (option-or (document-vector-at d i) (document-null)))
(defn main [] :i64
  (let [result (fragment/parse "<div><p>x<ul><li>y</ul>") d (field result :document)
        outer (dom/node-by-id d 2) p (dom/node-by-id d 3) ul (dom/node-by-id d 5) li (dom/node-by-id d 6)]
    (if (and (= (kval (field result :kind)) :fragment/ok) (= (kval (field outer :tag)) :div)
             (= (kval (field p :tag)) :p) (= (kval (field ul :tag)) :ul) (= (kval (field li :tag)) :li)
             (= (number (at (field outer :children) 0)) 3) (= (number (at (field outer :children) 1)) 5)
             (= (number (at (field ul :children) 0)) 6)) 42 0)))
