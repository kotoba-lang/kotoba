(ns html-title-test (:require [htmldom-document :as doc]) (:export [main]))
(defn prefix [n :i64] :string
  (loop [i 0 out ""] (if (= i n) out (recur (+ i 1) (string-concat out "a")))))
(defn main [] :i64
  (let [p (prefix 255) boundary (string-concat p "\r\n猫  犬\t")]
    (if (and (string=? (doc/display-title "  猫\n犬\t鳥  ") "猫 犬 鳥")
             (string=? (doc/display-title " \t\r\n ") "")
             (string=? (doc/display-title "猫 犬　鳥") "猫 犬　鳥")
             (string=? (doc/display-title boundary) (string-concat p " 猫 犬"))) 42 0)))
