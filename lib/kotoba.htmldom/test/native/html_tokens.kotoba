(ns html-tokens-test
  (:require [htmldom-tokens :as html])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn at [d :document i :i64] :document (option-or (document-vector-at d i) (document-null)))
(defn kval [d :document] :keyword (option-or (document-keyword-value d) :bad))
(defn sval [d :document] :string (option-or (document-string-value d) "?"))
(defn ival [d :document] :i64 (option-or (document-i64-value d) -1))
(defn many [] :string (loop [i 0 out ""] (if (= i 32) out (recur (+ i 1) (string-concat out "&amp;")))))
(defn main [] :i64
  (let [r (html/tokenize "<p title='猫&amp;犬'>Hi &amp;猫</p>")
        ts (field r :tokens) a (at ts 0) b (at ts 1) c (at ts 2) d (at ts 3) e (at ts 4)
        attrs (field a :attributes) attr (at attrs 0)
        unsupported (html/tokenize "<p>ok<!--x-->")
        raw (html/tokenize "hello<script>if(a<b){}</script>")
        foreign (html/tokenize "<svg><path/></svg>")
        incomplete (html/tokenize "a<p title='x")
        limited (html/tokenize (many))]
    (if (and (= (kval (field r :kind)) :html/done) (= (document-count ts) 5)
             (= (kval (field a :kind)) :tag/start) (string=? (sval (field a :name)) "p")
             (string=? (sval (field attr :value)) "猫&犬")
             (string=? (sval (field b :text)) "Hi ")
             (= (ival (field c :value)) 38) (string=? (sval (field d :text)) "猫")
             (= (ival (field b :offset)) 23) (= (ival (field c :offset)) 26)
             (= (ival (field d :offset)) 31) (= (ival (field e :offset)) 34)
             (= (kval (field e :kind)) :tag/end) (string=? (sval (field e :name)) "p")
             (= (kval (field unsupported :kind)) :html/unsupported) (= (ival (field unsupported :offset)) 5)
             (= (document-count (field unsupported :tokens)) 2)
             (= (kval (field raw :kind)) :html/unsupported-state) (= (ival (field raw :offset)) 5)
             (= (kval (field foreign :kind)) :html/unsupported-state) (= (ival (field foreign :offset)) 0)
             (= (kval (field incomplete :kind)) :html/incomplete) (= (ival (field incomplete :offset)) 1)
             (= (kval (field limited :kind)) :html/limit) (= (document-count (field limited :tokens)) 31)
             (= (ival (field limited :offset)) 155)) 42 0)))
