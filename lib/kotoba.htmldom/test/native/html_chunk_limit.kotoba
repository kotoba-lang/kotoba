(ns html-chunk-limit-test
  (:require [htmldom-tokens :as tokens] [htmldom-fragment :as fragment])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn kind [d :document] :keyword (option-or (document-keyword-value (field d :kind)) :bad))
(defn many [n :i64] :string (loop [i 0 out ""] (if (= i n) out (recur (+ i 1) (string-concat out "<br>")))))
(defn main [] :i64
  (let [a (tokens/tokenize-chunks (many 248)) b (tokens/tokenize-chunks (many 249)) c (fragment/parse (many 249))]
    (if (and (= (kind a) :html/done) (= (document-count (field a :chunks)) 8)
             (= (kind b) :html/limit) (= (option-or (document-i64-value (field b :offset)) -1) 992)
             (= (kind c) :fragment/limit) (= (document-kind (field c :document)) :null)) 42 0)))
