(ns html-list-refusal-test
  (:require [htmldom-fragment :as fragment])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn main [] :i64
  (let [result (fragment/parse "<ul><li><em>x<li>y</ul>")]
    (if (and (= (option-or (document-keyword-value (field result :kind)) :bad) :fragment/unsupported)
             (= (document-kind (field result :document)) :null)) 42 0)))
