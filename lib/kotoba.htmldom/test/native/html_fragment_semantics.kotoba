(ns html-fragment-semantics-test
  (:require [htmldom-fragment :as fragment] [kotoba.wasm.dom :as dom])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn kind [d :document] :keyword (option-or (document-keyword-value (field d :kind)) :bad))
(defn kval [d :document] :keyword (option-or (document-keyword-value d) :bad))
(defn at [d :document i :i64] :document (option-or (document-vector-at d i) (document-null)))
(defn number [d :document] :i64 (option-or (document-i64-value d) -1))
(defn text [d :document] :string (option-or (document-string-value d) ""))
(defn refused? [s :string] :bool (let [r (fragment/parse s)] (and (= (kind r) :fragment/unsupported) (= (document-kind (field r :document)) :null))))
(defn tagged? [name :string tag :keyword] :bool
  (let [r (fragment/parse (string-concat "<" (string-concat name (string-concat "></" (string-concat name ">")))))
        node (dom/node-by-id (field r :document) 2)]
    (and (= (kind r) :fragment/ok) (= (kval (field node :tag)) tag))))
(defn same-tree? [a :string b :string] :bool
  (let [x (fragment/parse a) y (fragment/parse b)]
    (and (= (kind x) :fragment/ok) (= (kind y) :fragment/ok)
         (document-equal? (dom/tree (field x :document)) (dom/tree (field y :document))))))
(defn main [] :i64
  (let [r (fragment/parse "<section><h1>Hi <em>世界</em></h1><p><strong>重要</strong> <code>x</code></p></section>")
        d (field r :document) section (dom/node-by-id d 2) h (dom/node-by-id d 3)
        em (dom/node-by-id d 5) em-text (dom/node-by-id d 6) p (dom/node-by-id d 7)
        strong (dom/node-by-id d 8) code (dom/node-by-id d 11)]
    (if (and (= (kind r) :fragment/ok) (= (kval (field section :tag)) :section)
             (= (kval (field h :tag)) :h1) (= (kval (field em :tag)) :em)
             (string=? (text (field em-text :text)) "世界") (= (kval (field p :tag)) :p)
             (= (kval (field strong :tag)) :strong) (= (kval (field code :tag)) :code)
             (= (number (at (field section :children) 0)) 3) (= (number (at (field section :children) 1)) 7)
             (= (number (at (field h :children) 0)) 4) (= (number (at (field h :children) 1)) 5)
             (= (number (at (field em :children) 0)) 6)
             (= (number (at (field p :children) 0)) 8) (= (number (at (field p :children) 1)) 10)
             (= (number (at (field p :children) 2)) 11)
             (string=? (text (field (dom/node-by-id d 4) :text)) "Hi ")
             (string=? (text (field (dom/node-by-id d 9) :text)) "重要")
             (string=? (text (field (dom/node-by-id d 10) :text)) " ")
             (string=? (text (field (dom/node-by-id d 12) :text)) "x")
             (tagged? "article" :article) (tagged? "header" :header) (tagged? "footer" :footer)
             (tagged? "main" :main) (tagged? "h2" :h2) (tagged? "h3" :h3) (tagged? "h4" :h4)
             (tagged? "h5" :h5) (tagged? "h6" :h6) (tagged? "b" :b) (tagged? "i" :i)
             (tagged? "pre" :pre)
             (same-tree? "<pre>\nabc</pre>" "<pre>abc</pre>")
             (same-tree? "<pre>&#10;abc</pre>" "<pre>abc</pre>")
             (same-tree? "<pre>\r\nabc</pre>" "<pre>abc</pre>")
             (same-tree? "<pre>\n\nabc</pre>" "<pre>&#10;&#10;abc</pre>")
             (same-tree? "<pre><!--c-->\nabc</pre>" "<pre><!--c-->&#10;abc</pre>")
             (same-tree? "<pre><span></span>\nabc</pre>" "<pre><span></span>&#10;abc</pre>")
             (same-tree? "<p>one<pre>two</pre>" "<p>one</p><pre>two</pre>")
             (tagged? "blockquote" :blockquote) (tagged? "small" :small) (tagged? "s" :s)
             (tagged? "mark" :mark) (tagged? "sub" :sub) (tagged? "sup" :sup) (tagged? "q" :q)
             (same-tree? "<p>one<hr>two" "<p>one</p><hr>two")
             (same-tree? "<p>one<blockquote>two</blockquote>" "<p>one</p><blockquote>two</blockquote>")
             (same-tree? "<blockquote><p>one</blockquote>" "<blockquote><p>one</p></blockquote>")
             (refused? "<small/>") (refused? "<p><em>one<hr>two")
             (refused? "<p><section>bad</section></p>")
             (refused? "<h1><h2>bad</h2></h1>")
             (refused? "<em><strong>bad</em></strong>")) 42 0)))
