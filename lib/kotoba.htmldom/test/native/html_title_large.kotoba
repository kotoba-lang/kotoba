(ns html-title-large-test (:require [htmldom-document :as doc]) (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn main [] :i64
  ;; 59,904 bytes of alternating text and spaces within the 65,536-byte
  ;; document limit. Exercise both envelope decoding and title display.
  (let [source (loop [n 0 out ""]
                 (if (= n 234) out (recur (+ n 1) (string-concat out "a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a "))))
        html (string-concat "<html><head><title>" (string-concat source "</title></head><body>x</body></html>"))
        document (doc/unwrap html)
        raw (option-or (document-string-value (field document :title)) "")
        title (doc/display-title raw)]
    (if (and (= (option-or (document-keyword-value (field document :kind)) :bad) :document/ok)
             (string=? raw source)
             (string=? (option-or (document-string-value (field document :body)) "") "x")
             (string=? title (string-substring source 0 59903))) 42 0)))
