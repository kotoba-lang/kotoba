  :html "<table><b>bold</b><tr><td>x</td></tr></table>"}

 ;; Foster parenting again, at the three places the four cases above do
 ;; not reach: a table that is not at the top level (the foster parent is
 ;; the TABLE's parent, not the document root), a row rather than the
 ;; table itself as the current node, and -- the one that still fails --
 ;; a formatting element the author never closed, which needs the scope
 ;; MARKERS this parser's list of active formatting elements does not
 ;; have. See the SCOPE CUT comment in htmldom.core; the browser leaves
 ;; the cell holding a bare text node, this parser reconstructs the <b>
 ;; inside it.

 {:id :table/foster-parent-into-the-tables-own-parent
  :group :table
  :html "<div><table>stray<tr><td>x</td></tr></table></div>"}

 {:id :table/foster-parent-from-a-row
  :group :table
  :html "<table><tr>stray<td>x</td></tr></table>"}

 {:id :table/foster-parent-unclosed-formatting
  :group :table
  :html "<table><b>bold<tr><td>x</td></tr></table>y"}

 ;; The scope marker a cell pushes, measured from both sides. Forward: the
 ;; still-open <b> is foster-parented out but not recreated inside the
 ;; cell. Backward ("clear the list of active formatting elements up to the
 ;; last marker"): formatting opened INSIDE a cell does not leak into the
 ;; next cell or out past the table, and both of those cells are closed
 ;; implicitly, which is the path with no end tag to hang the clearing on.
 ;; The last case pins the marker's POSITION -- <b> is pushed before the
 ;; table and <i> inside the first cell, so clearing must drop the <i> and
 ;; keep the <b>; a marker that empties the list or keeps everything fails
 ;; one half each.

 {:id :table/caption-blocks-outside-formatting
  :group :table
  :html "<table><b>bold<caption>cap</caption><tr><td>x"}

 {:id :table/cell-close-clears-formatting-opened-inside
  :group :table
  :html "<table><tr><td><b>in<td>next"}

 {:id :table/table-close-clears-formatting-opened-in-a-cell
  :group :table
  :html "<table><tr><td><b>in</td></tr></table>after"}

 {:id :table/clearing-keeps-formatting-from-before-the-marker
  :group :table
  :html "<b>a<table><tr><td><i>b</td><td>c</table>d"}

 {:id :table/hidden-input-stays-in-the-table
  :group :table
  :html "<table><input type=\"hidden\"><tr><td>x</td></tr></table>"}

 {:id :table/nested-table-closes-the-open-one
  :group :table
  :html "<table><table><tr><td>x</td></tr></table>"}

 {:id :table/nested-table
  :group :table
  :html "<table><tr><td><table><tr><td>in</td></tr></table></td></tr></table>"}

 {:id :table/unclosed-at-eof
  :group :table
  :html "<table><tr><td>x"}

 {:id :table/whitespace-between-rows
  :group :table
  :html "<table>\n<tr><td>a</td></tr>\n</table>"}

