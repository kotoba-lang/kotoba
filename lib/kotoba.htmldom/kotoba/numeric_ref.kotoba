(ns numeric-ref
  ;; Numeric character references: `&#65;` and `&#x41;` to a code point.
  ;;
  ;; The WHATWG "numeric character reference end state" algorithm, as
  ;; `htmldom.core/numeric-char-ref->str` already implements it. Three rules
  ;; beyond parsing the digits, and none of them is this port's invention:
  ;;
  ;;   * a code point outside 0..0x10FFFF, or inside the surrogate range
  ;;     0xD800..0xDFFF, is not a scalar value and does not decode;
  ;;   * code point 0 becomes U+FFFD;
  ;;   * a code point in the C1 control range 0x80..0x9F is reinterpreted
  ;;     through a fixed Windows-1252 remap -- the textbook "smart quotes
  ;;     turn into garbage" case, where `&#146;` from a Word export means a
  ;;     right single quote and never the invisible control character.
  ;;
  ;; Answers -1 rather than a replacement character when the digits do not
  ;; decode, because `htmldom.core` leaves such a reference as literal text
  ;; rather than guessing, and a sentinel is what lets the caller do that.
  ;;
  ;; ⚠ The C1 table is 27 entries over the CONTIGUOUS range 0x80..0x9F, so it
  ;; is not searched at all: 32 fixed-width slots indexed by `cp - 0x80`, with
  ;; `ffff` marking the five code points the spec deliberately leaves out
  ;; (0x81 0x8D 0x8F 0x90 0x9D). Those five fall through to the raw code
  ;; point, which is the spec's behaviour and not a gap.
  ;;
  ;; This table is small enough for a typed map (27 < the 31-entry limit), so
  ;; unlike `entity-data` it is a string for a different reason: a contiguous
  ;; key range makes arithmetic strictly better than any lookup.
  (:export [main decode decode-html consume-html remap-c1 c1-table parse-digits
            test-decimal test-hex test-range test-c1 test-zero test-invalid])
  (:schemas {:nr/scan [:record :nr/scan
                       [[:s :string] [:i :i64] [:n :i64]
                        [:radix :i64] [:acc :i64]]]}))

(defn c1-table [] :string
  "20acffff201a0192201e20262020202102c62030016020390152ffff017dffffffff20182019201c201d20222013201402dc21220161203a0153ffff017e0178")

;; --- digits ---------------------------------------------------------------

(defn digit-value [cp :i64 radix :i64] :i64
  ;; -1 when the character is not a digit of this radix, which is how a
  ;; malformed reference is refused rather than silently truncated.
  (let [d (if (if (>= cp 48) (<= cp 57) false)
            (- cp 48)
            (if (if (>= cp 97) (<= cp 102) false)
              (+ 10 (- cp 97))
              (if (if (>= cp 65) (<= cp 70) false)
                (+ 10 (- cp 65))
                -1)))]
    (if (< d 0) -1 (if (>= d radix) -1 d))))

(defn scan [x [:ref :nr/scan]] :i64
  (let [s (record-get [:ref :nr/scan] x :s)
        i (record-get [:ref :nr/scan] x :i)
        n (record-get [:ref :nr/scan] x :n)
        radix (record-get [:ref :nr/scan] x :radix)
        acc (record-get [:ref :nr/scan] x :acc)]
    (if (>= i n)
      acc
      (let [d (digit-value (string-code-point-at s i) radix)]
        (if (< d 0)
          -1
          ;; ⚠ Refuse past the largest scalar value rather than overflowing.
          ;; `&#99999999999;` is a real thing to find in a document, and an
          ;; i64 that wraps would answer a plausible code point for it.
          (let [next (+ (* acc radix) d)]
            (if (> next 1114111)
              -1
              (scan
                   (record [:ref :nr/scan] s (+ i 1) n radix next)))))))))

(defn parse-digits [digits :string radix :i64] :i64
  (if (= 0 (string-length digits))
    -1
    (scan
         (record [:ref :nr/scan] digits 0 (string-length digits) radix 0))))

;; --- the C1 remap ---------------------------------------------------------

(defn hex-run [s :string i :i64 n :i64] :i64
  (if (<= n 0)
    0
    (+ (* (hex-run s i (- n 1)) 16)
       (digit-value (string-code-point-at s (+ i (- n 1))) 16))))

(defn remap-c1 [cp :i64] :i64
  ;; the code point this one is reinterpreted as, or the code point itself
  (if (if (>= cp 128) (<= cp 159) false)
    (let [v (hex-run (c1-table) (* (- cp 128) 4) 4)]
      (if (= v 65535) cp v))
    cp))

;; --- the whole rule -------------------------------------------------------

(defn decode [digits :string radix :i64] :i64
  (let [cp (parse-digits digits radix)]
    (if (< cp 0)
      -1
      (if (if (>= cp 55296) (<= cp 57343) false)
        -1
        (if (= cp 0)
          65533
          (remap-c1 cp))))))

;; HTML tokenization consumes the complete digit run before applying the
;; numeric-character-reference end state. Saturate at one past Unicode's
;; limit, but keep validating later digits: overflow must not hide malformed
;; input. This separate entry preserves decode's legacy -1 contract.
(defn html-scan [digits :string radix :i64 i :i64 value :i64] :i64
  (if (>= i (string-length digits)) value
    (let [d (digit-value (string-code-point-at digits i) radix)]
      (if (< d 0) -1
        (let [next (if (> value 1114111) 1114112 (+ (* value radix) d))
              bounded (if (> next 1114111) 1114112 next)]
          (html-scan digits radix (+ i 1) bounded))))))

(defn html-value [cp :i64] :i64
  (cond (< cp 0) -1
        (or (= cp 0) (> cp 1114111) (and (>= cp 55296) (<= cp 57343))) 65533
        :else (remap-c1 cp)))

(defn decode-html [digits :string radix :i64] :i64
  (if (or (= (string-length digits) 0) (not (or (= radix 10) (= radix 16)))) -1
    (html-value (html-scan digits radix 0 0))))

;; The missing-semicolon diagnostic is independent of this end-state error.
;; Noncharacters remain their original code point; controls are remapped only
;; where the C1 table specifies it.
(defn html-character-error [cp :i64] :keyword
  (cond (< cp 0) :numeric/none
        (= cp 0) :numeric/null-character
        (> cp 1114111) :numeric/outside-unicode
        (and (>= cp 55296) (<= cp 57343)) :numeric/surrogate
        (or (and (>= cp 64976) (<= cp 65007))
            (= (bit-and cp 65535) 65534) (= (bit-and cp 65535) 65535)) :numeric/noncharacter
        (or (= cp 13) (and (>= cp 1) (<= cp 8)) (= cp 11)
            (and (>= cp 14) (<= cp 31)) (and (>= cp 127) (<= cp 159))) :numeric/control
        :else :numeric/none))

;; Input starts immediately after "&#". :consumed counts UTF-8 bytes in that
;; suffix, including x/X and a semicolon when present. Consumed syntax is
;; ASCII, so the same number also equals its UTF-16 length. The caller
;; emits the literal prefix on :no-digits and reconsumes the next character.
;; :status reports the terminator error; :character-error separately records
;; the numeric end-state error, so both can be present at the same time.
(defn html-digit-end [s :string radix :i64 i :i64] :i64
  (if (>= i (string-length s)) i
    (if (< (digit-value (string-code-point-at s i) radix) 0) i
      (html-digit-end s radix (+ i 1)))))

(defn consume-html [s :string] :document
  (let [n (string-length s)
        hex (and (> n 0) (or (= (string-code-point-at s 0) 120) (= (string-code-point-at s 0) 88)))
        begin (if hex 1 0) radix (if hex 16 10)
        end (html-digit-end s radix begin)
        has-digits (> end begin)
        semicolon (and has-digits (< end n) (= (string-code-point-at s end) 59))
        consumed (if semicolon (+ end 1) end)
        raw (if has-digits (html-scan (string-substring s begin end) radix 0 0) -1)
        value (html-value raw)
        status (if has-digits (if semicolon :numeric/terminated :numeric/missing-semicolon) :numeric/no-digits)]
    (document-map :consumed (document-i64 consumed)
                  :value (document-i64 value)
                  :status (document-keyword status)
                  :character-error (document-keyword (html-character-error raw)))))

;; --- self-checks ----------------------------------------------------------

(defn test-decimal [] :bool
  (and (= 65 (decode "65" 10))
       (and (= 8212 (decode "8212" 10))
            (and (= 1114111 (decode "1114111" 10))
                 (= 32 (decode "32" 10))))))

(defn test-hex [] :bool
  ;; both cases, since `&#X41;` is as valid as `&#x41;`
  (and (= 65 (decode "41" 16))
       (and (= 65 (decode "0041" 16))
            (and (= 128169 (decode "1f4a9" 16))
                 (= 128169 (decode "1F4A9" 16))))))

(defn test-range [] :bool
  ;; past the largest scalar value, and the surrogate hole
  (and (= -1 (decode "1114112" 10))
       (and (= -1 (decode "99999999999" 10))
            (and (= -1 (decode "d800" 16))
                 (and (= -1 (decode "dfff" 16))
                      ;; either side of the surrogate range still decodes
                      (and (= 55295 (decode "d7ff" 16))
                           (= 57344 (decode "e000" 16))))))))

(defn test-c1 [] :bool
  ;; the smart-quote case, the two ends, and one of the five holes
  (and (= 8217 (decode "146" 10))
       (and (= 8364 (decode "128" 10))
            (and (= 376 (decode "159" 10))
                 ;; 0x81 has no mapping and stays itself
                 (and (= 129 (decode "129" 10))
                      (and (= 141 (decode "141" 10))
                           ;; and just outside the range is untouched
                           (= 160 (decode "160" 10))))))))

(defn test-zero [] :bool
  (and (= 65533 (decode "0" 10))
       (= 65533 (decode "0" 16))))

(defn test-invalid [] :bool
  ;; a non-digit refuses the whole reference rather than truncating it
  (and (= -1 (decode "" 10))
       (and (= -1 (decode "12x" 10))
            (and (= -1 (decode "ff" 10))
                 (= -1 (decode "xyz" 16))))))

(defn main [] :i64
  (decode "65" 10))
