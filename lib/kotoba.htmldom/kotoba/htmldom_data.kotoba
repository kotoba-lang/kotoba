(ns htmldom-data
  (:require [numeric-ref :as numeric]
            [html-named-ref :as named])
  (:export [next-token]))

;; HTML data-state step over already decoded/preprocessed UTF-8. Offsets are
;; bytes at scalar boundaries, matching the selfhost string primitives. This
;; is one tokenizer state, not a complete HTML parser: tag-open and null
;; characters are handed back to the owning state machine.
(defn field [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))
(defn number [d :document] :i64
  (option-or (document-i64-value d) -1))
(defn keyword-value [d :document] :keyword
  (option-or (document-keyword-value d) :numeric/none))
(defn width [cp :i64] :i64
  (cond (< cp 128) 1 (< cp 2048) 2 (< cp 65536) 3 :else 4))
(defn ascii-alnum? [cp :i64] :bool
  (or (and (>= cp 48) (<= cp 57)) (and (>= cp 65) (<= cp 90))
      (and (>= cp 97) (<= cp 122))))
(defn text-end [s :string] :i64
  (loop [i 0]
    (if (>= i (string-length s)) i
      (let [cp (string-code-point-at s i)]
        (if (or (= cp 38) (= cp 60) (= cp 0)) i
          (recur (+ i (width cp))))))))
(defn token [kind :keyword consumed :i64 text :string value :i64 status :keyword error :keyword] :document
  (document-map :kind (document-keyword kind) :consumed (document-i64 consumed)
                :text (document-string text) :value (document-i64 value)
                :value2 (document-i64 -1)
                :status (document-keyword status) :character-error (document-keyword error)))
(defn named-token [result :document] :document
  (document-map :kind (document-keyword :data/character)
                :consumed (document-i64 (+ 1 (number (field result :consumed))))
                :text (document-string "") :value (field result :value) :value2 (field result :value2)
                :status (field result :status) :character-error (document-keyword :numeric/none)))
(defn next-token [s :string] :document
  (let [n (string-length s)]
    (if (= n 0) (token :data/eof 0 "" -1 :numeric/none :numeric/none)
      (let [cp (string-code-point-at s 0)]
        (cond (= cp 60) (token :data/tag-open 0 "" -1 :numeric/none :numeric/none)
              (= cp 0) (token :data/null 1 "" 0 :numeric/none :numeric/none)
              (= cp 38)
                (if (and (> n 1) (= (string-code-point-at s 1) 35))
                  (let [result (numeric/consume-html (string-substring s 2 n))
                        consumed (+ 2 (number (field result :consumed)))
                        value (number (field result :value))
                        status (keyword-value (field result :status))
                        error (keyword-value (field result :character-error))]
                    (if (= status :numeric/no-digits)
                      (token :data/text consumed (string-substring s 0 consumed) -1 status error)
                      (token :data/character consumed "" value status error)))
                  (if (and (> n 1) (ascii-alnum? (string-code-point-at s 1)))
                    (let [result (named/consume (string-substring s 1 n) false)]
                      (if (> (number (field result :consumed)) 0) (named-token result)
                        (token :data/text 1 "&" -1 :named/unknown :numeric/none)))
                    (token :data/text 1 "&" -1 :numeric/none :numeric/none)))
              :else (let [end (text-end s)]
                      (token :data/text end (string-substring s 0 end) -1 :numeric/none :numeric/none)))))))
