(ns entity-table
  ;; Named character reference lookup, over the generated table.
  ;;
  ;; `htmldom.core` resolves `&amp;` through a Clojure map. A Kotoba typed map
  ;; holds 31 entries and this table has 83, so the table is a fixed-width
  ;; string -- the third value in this workspace to take that shape, after
  ;; `pattern-vm`'s program and `dom-table`'s nodes, and for the same reason
  ;; each time: the bound that binds is the CONTAINER, not the bytes.
  ;;
  ;; The table is generated from the `.cljc` by
  ;; `scripts/gen_entity_table.cljk`, so the two cannot drift; `--check` fails
  ;; when it is stale. It is required rather than inlined, which is only
  ;; possible since kotoba-lang/amu#912 -- before that a module could be
  ;; required but this one would have had to be pasted in.
  ;;
  ;; Sorted by name, so this binary-searches: 7 probes rather than 83. Fuel is
  ;; charged per function ENTRY, so that is the difference between about 7 and
  ;; about 83 charges per entity in a document, and fuel is the budget the
  ;; caller chooses.
  (:require [entity-data :as data])
  (:export [main lookup name-at cp-at entry-count width
            test-ends test-middle test-absent test-padding test-order
            name-compare sorted-from])
  (:schemas {:et/probe [:record :et/probe
                        [[:name :string] [:lo :i64] [:hi :i64]]]}))

;; ⚠ An imported function is called DIRECTLY -- `(data/table)` -- while a
;; function of this module goes through `(app (ref f) ...)`. Writing
;; `(app (ref data/table))` is refused as "ref names one definition this
;; module defines", because every other shape of `ref` is Clojure's STM
;; constructor and state must not be ambient. Measured 2026-09-10 by getting
;; it wrong.
(defn width [] :i64 10)

(defn name-width [] :i64 6)

(defn header-width [] :i64 5)

(defn entry-count [] :i64
  (data/entry-count))

;; --- fields ---------------------------------------------------------------

(defn entry-at [i :i64] :i64
  (+ (app (ref header-width)) (* i (app (ref width)))))

(defn name-at [i :i64] :string
  ;; the stored field is space-padded to `name-width`
  (let [t (data/table)
        at (app (ref entry-at) i)]
    (string-substring t at (+ at (app (ref name-width))))))

(defn hex-digit [cp :i64] :i64
  (if (if (>= cp 48) (<= cp 57) false)
    (- cp 48)
    (if (if (>= cp 97) (<= cp 102) false) (+ 10 (- cp 97)) -1)))

(defn hex-run [s :string i :i64 n :i64] :i64
  (if (<= n 0)
    0
    (+ (* (app (ref hex-run) s i (- n 1)) 16)
       (app (ref hex-digit) (string-code-point-at s (+ i (- n 1)))))))

(defn cp-at [i :i64] :i64
  (let [t (data/table)
        at (+ (app (ref entry-at) i) (app (ref name-width)))]
    (app (ref hex-run) t at 4)))

;; --- ordering -------------------------------------------------------------
;;
;; ⚠ There is no `string<?` ("not a builtin, a sugar head, or a function of
;; this module; nearest defined: string=?", measured 2026-09-10). A binary
;; search needs one, so this is it: both operands are the fixed-width padded
;; field, every name in the table is ASCII, and the pad is a space, so a
;; code-point walk is exact rather than an approximation of a collation.
;;
;; -1 a before b, 0 equal, 1 a after b.
(defn compare-from [a :string b :string i :i64 n :i64] :i64
  (if (>= i n)
    0
    (let [x (string-code-point-at a i)
          y (string-code-point-at b i)]
      (if (< x y) -1 (if (> x y) 1 (app (ref compare-from) a b (+ i 1) n))))))

(defn name-compare [a :string b :string] :i64
  (app (ref compare-from) a b 0 (app (ref name-width))))

;; --- lookup ---------------------------------------------------------------

(defn pad-to [s :string n :i64] :string
  (if (>= (string-length s) n)
    s
    (app (ref pad-to) (string-concat s " ") n)))

;; ⚠ Compares the PADDED query against the stored field, rather than trimming
;; the stored one. Trimming would allocate per probe and charge fuel for it;
;; padding the query happens once.
(defn probe [x [:ref :et/probe]] :i64
  (let [name (record-get x :name)
        lo (record-get x :lo)
        hi (record-get x :hi)]
    (if (> lo hi)
      -1
      (let [mid (quot (+ lo hi) 2)
            here (app (ref name-at) mid)]
        (let [c (app (ref name-compare) here name)]
          (if (= c 0)
            mid
            (if (< c 0)
              (app (ref probe) (record-new [:ref :et/probe] name (+ mid 1) hi))
              (app (ref probe) (record-new [:ref :et/probe] name lo (- mid 1))))))))))

;; The code point for a named reference, or -1 when the table does not carry
;; it. -1 rather than a replacement character on purpose: `htmldom.core`
;; leaves an unknown `&foo;` as literal text rather than guessing, and a
;; sentinel is what lets the caller do that.
(defn lookup [name :string] :i64
  (if (> (string-length name) (app (ref name-width)))
    -1
    (let [i (app (ref probe)
                 (record-new [:ref :et/probe]
                             (app (ref pad-to) name (app (ref name-width)))
                             0 (- (app (ref entry-count)) 1)))]
      (if (< i 0) -1 (app (ref cp-at) i)))))

;; --- self-checks ----------------------------------------------------------

(defn test-ends [] :bool
  ;; the first and last entries, which a binary search reaches only if its
  ;; bounds are right
  (and (= 38 (app (ref lookup) "amp"))
       (and (= 60 (app (ref lookup) "lt"))
            (and (= 62 (app (ref lookup) "gt"))
                 (= 83 (app (ref entry-count)))))))

(defn test-middle [] :bool
  (and (= 160 (app (ref lookup) "nbsp"))
       (and (= 169 (app (ref lookup) "copy"))
            (and (= 8212 (app (ref lookup) "mdash"))
                 (= 8230 (app (ref lookup) "hellip"))))))

(defn test-absent [] :bool
  ;; degrade-don't-guess: an unknown name answers -1, not a replacement
  (and (= -1 (app (ref lookup) "foo"))
       (and (= -1 (app (ref lookup) "zzzzzz"))
            (and (= -1 (app (ref lookup) ""))
                 ;; and a name longer than the field cannot collide with a
                 ;; padded short one
                 (= -1 (app (ref lookup) "amplify"))))))

(defn test-padding [] :bool
  ;; the stored field is padded, so a short name must not match a longer one
  ;; that shares its prefix
  (and (string=? "amp   " (app (ref pad-to) "amp" 6))
       (and (= 6 (string-length (app (ref name-at) 0)))
            (not (= (app (ref lookup) "am") (app (ref lookup) "amp"))))))

(defn test-order [] :bool
  ;; the generator sorts, and the search depends on it: every name is strictly
  ;; greater than the one before it
  (and (app (ref sorted-from) 1)
       (< (app (ref name-compare) (app (ref name-at) 0) (app (ref name-at) 1)) 0)))

(defn sorted-from [i :i64] :bool
  (if (>= i (app (ref entry-count)))
    true
    (if (< (app (ref name-compare) (app (ref name-at) (- i 1)) (app (ref name-at) i)) 0)
      (app (ref sorted-from) (+ i 1))
      false)))

(defn main [] :i64
  (app (ref lookup) "amp"))
