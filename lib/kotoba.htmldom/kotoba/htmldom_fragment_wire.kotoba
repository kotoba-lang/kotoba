(ns htmldom-fragment-wire
  (:require [htmldom-fragment :as fragment] [kotoba.wasm.dom :as dom])
  (:export [encode]))

;; Bounded JSON serialization of a successful local fragment's DOM operation
;; transaction. It does not authenticate the producer, grant capabilities, or
;; validate a consumer's host policy; the caller owns those boundaries.
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn at [d :document i :i64] :document (option-or (document-vector-at d i) (document-null)))
(defn scalar [d :document] [:option :string]
  (let [k (document-kind d)]
    (cond (= k :keyword) (option-some-of [:option :string] (document-edn-print (document-string (document-edn-print d))))
          (= k :string) (if (> (string-byte-length (option-or (document-string-value d) "")) 1048576)
                          (option-none-of [:option :string]) (option-some-of [:option :string] (document-edn-print d)))
          (= k :bool) (option-some-of [:option :string] (document-edn-print d))
          (= k :i64) (let [n (option-or (document-i64-value d) 0)]
                       (if (or (< n -9007199254740991) (> n 9007199254740991))
                         (option-none-of [:option :string]) (option-some-of [:option :string] (document-edn-print d))))
          :else (option-none-of [:option :string]))))
(defn value [d :document depth :i64] [:option :string]
  (if (= (document-kind d) :vector)
    (if (or (>= depth 3) (> (document-count d) 32)) (option-none-of [:option :string])
      (loop [i 0 out "["]
        (if (= i (document-count d)) (option-some-of [:option :string] (string-concat out "]"))
          (let [part (value (at d i) (+ depth 1))
                next (string-concat out (string-concat (if (= i 0) "" ",") (option-or part "")))]
            (if (or (not (option-some?-of [:option :string] part)) (> (string-byte-length next) 1048575))
              (option-none-of [:option :string]) (recur (+ i 1) next))))))
    (scalar d)))
(defn encode [html :string] [:option :string]
  (let [parsed (fragment/parse html) kind (option-or (document-keyword-value (field parsed :kind)) :bad)]
    (if (not= kind :fragment/ok) (option-none-of [:option :string])
      (let [tx (dom/consume-op-transaction (field parsed :document)) ops (at tx 0)]
        (if (not= (document-kind ops) :vector) (option-none-of [:option :string])
          (value ops 0))))))
