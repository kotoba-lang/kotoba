(ns htmldom-tokens
  (:require [htmldom-data :as data] [htmldom-tag :as tag])
  (:export [tokenize tokenize-chunks]))

;; Bounded token pump for already preprocessed UTF-8. It refuses states that
;; require a different tokenizer (raw text, script, RCDATA and plaintext)
;; and markup not yet implemented, returning the verified prefix and byte
;; offset. This is not a tree builder or a full HTML tokenizer.
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn key [d :document] :keyword (option-or (document-keyword-value d) :bad))
(defn num [d :document] :i64 (option-or (document-i64-value d) -1))
(defn text [d :document] :string (option-or (document-string-value d) ""))
(defn special-text? [s :string] :bool
  (or (string=? s "script") (string=? s "style") (string=? s "title")
      (string=? s "textarea") (string=? s "xmp") (string=? s "iframe")
      (string=? s "noembed") (string=? s "noframes") (string=? s "plaintext")
      (string=? s "noscript") (string=? s "svg") (string=? s "math")))
(defn result [kind :keyword offset :i64 tokens :document] :document
  (document-map :kind (document-keyword kind) :offset (document-i64 offset) :tokens tokens))
(defn tokenize [s :string] :document
  (let [n (string-length s)]
    (if (> n 65536) (result :html/limit 0 (document-vector))
      (loop [i 0 tokens (document-vector)]
        (cond (= i n) (result :html/done i tokens)
              (>= (document-count tokens) 31) (result :html/limit i tokens)
              :else (let [remaining (string-substring s i n)
                          first (data/next-token remaining)
                          first-kind (key (field first :kind))
                          t (if (= first-kind :data/tag-open) (tag/parse remaining) first)
                          kind (key (field t :kind)) consumed (num (field t :consumed))]
                (cond (or (= kind :tag/handoff) (= kind :tag/unsupported)) (result :html/unsupported i tokens)
                      (= kind :tag/incomplete) (result :html/incomplete i tokens)
                      (= kind :tag/limit) (result :html/limit i tokens)
                      (and (= kind :tag/start) (special-text? (text (field t :name))))
                        (result :html/unsupported-state i tokens)
                      (or (<= consumed 0) (> (+ i consumed) n)) (result :html/invalid i tokens)
                      :else (recur (+ i consumed) (document-vector-conj tokens (document-assoc t :offset (document-i64 i)))))))))))

;; Chunked token stream for the incremental tree builder. Each vector stays
;; below the selfhost document collection bound. A maximum of 248 tokens is
;; an interim resource limit, not HTML conformance. Offsets and refusal kinds
;; have the same meaning as tokenize; consumers must check :kind first.
(defn chunk-result [kind :keyword offset :i64 chunks :document current :document] :document
  (document-map :kind (document-keyword kind) :offset (document-i64 offset)
                :chunks (if (= (document-count current) 0) chunks (document-vector-conj chunks current))))
(defn tokenize-chunks [s :string] :document
  (let [n (string-length s)]
    (if (> n 65536) (chunk-result :html/limit 0 (document-vector) (document-vector))
      (loop [i 0 chunks (document-vector) current (document-vector)]
        (cond (= i n) (chunk-result :html/done i chunks current)
              (and (= (document-count chunks) 7) (= (document-count current) 31))
                (chunk-result :html/limit i chunks current)
              (= (document-count current) 31)
                (recur i (document-vector-conj chunks current) (document-vector))
              :else (let [remaining (string-substring s i n)
                          first (data/next-token remaining)
                          first-kind (key (field first :kind))
                          t (if (= first-kind :data/tag-open) (tag/parse remaining) first)
                          kind (key (field t :kind)) consumed (num (field t :consumed))]
                (cond (or (= kind :tag/handoff) (= kind :tag/unsupported)) (chunk-result :html/unsupported i chunks current)
                      (= kind :tag/incomplete) (chunk-result :html/incomplete i chunks current)
                      (= kind :tag/limit) (chunk-result :html/limit i chunks current)
                      (and (= kind :tag/start) (special-text? (text (field t :name))))
                        (chunk-result :html/unsupported-state i chunks current)
                      (or (<= consumed 0) (> (+ i consumed) n)) (chunk-result :html/invalid i chunks current)
                      :else (recur (+ i consumed) chunks (document-vector-conj current (document-assoc t :offset (document-i64 i)))))))))))
