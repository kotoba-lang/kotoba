(ns html-named-ref
  (:require [html-entities-data :as data])
  (:export [consume lookup]))

;; WHATWG table includes both terminated names and the permitted legacy
;; unterminated spellings. Each result may contain two Unicode code points.
(defn alnum? [c :i64] :bool
  (or (and (>= c 48) (<= c 57)) (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122))))
(defn field-offset [index :i64] :i64 (* (- index (* 300 (quot index 300))) 44))
(defn field-table [index :i64] :string (data/chunk (quot index 300)))
(defn compare-name [query :string table :string base :i64] :i64
  (loop [i 0]
    (if (= i 32) 0
      (let [a (if (< i (string-length query)) (string-code-point-at query i) 32)
            b (string-code-point-at table (+ base i))]
        (cond (< a b) -1 (> a b) 1 :else (recur (+ i 1)))))))
(defn ascii-name? [name :string i :i64] :bool
  (if (= i (string-length name)) true
    (let [cp (string-code-point-at name i)]
      (if (or (alnum? cp) (= cp 59)) (ascii-name? name (+ i 1)) false))))
(defn lookup [name :string] :i64
  (if (or (= (string-length name) 0) (> (string-length name) 32) (not (ascii-name? name 0))) -1
    (loop [lo 0 hi (- (data/entry-count) 1)]
      (if (> lo hi) -1
        (let [mid (quot (+ lo hi) 2)
              cmp (compare-name name (field-table mid) (field-offset mid))]
          (cond (= cmp 0) mid (< cmp 0) (recur lo (- mid 1)) :else (recur (+ mid 1) hi)))))))
(defn hex-digit [c :i64] :i64
  (if (<= c 57) (- c 48) (+ 10 (- c 97))))
(defn hex-value [s :string at :i64] :i64
  (loop [i 0 value 0]
    (if (= i 6) value (recur (+ i 1) (+ (* value 16) (hex-digit (string-code-point-at s (+ at i))))))))
(defn codepoint [index :i64 offset :i64] :i64
  (hex-value (field-table index) (+ (field-offset index) offset)))
(defn candidate-end [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (cond (or (= i n) (= i 32)) i
            (= (string-code-point-at s i) 59) (+ i 1)
            (alnum? (string-code-point-at s i)) (recur (+ i 1))
            :else i))))
(defn longest [s :string end :i64] :i64
  (if (= end 0) 0
    (if (>= (lookup (string-substring s 0 end)) 0) end (longest s (- end 1)))))
(defn result [length :i64 first :i64 second :i64 status :keyword] :document
  (document-map :consumed (document-i64 length) :value (document-i64 first)
                :value2 (document-i64 second) :status (document-keyword status)))
(defn consume [s :string attribute :bool] :document
  (let [n (string-length s) end (longest s (candidate-end s))]
    (if (= end 0) (result 0 -1 -1 :named/unknown)
      (let [semicolon (= (string-code-point-at s (- end 1)) 59)
            next (if (< end n) (string-code-point-at s end) -1)
            ambiguous (and attribute (not semicolon) (or (= next 61) (alnum? next)))]
        (if ambiguous (result 0 -1 -1 :named/ambiguous-attribute)
          (let [index (lookup (string-substring s 0 end))
                first (codepoint index 32) second (codepoint index 38)]
            (result end first (if (= second 0) -1 second)
                    (if semicolon :named/terminated :named/missing-semicolon))))))))
