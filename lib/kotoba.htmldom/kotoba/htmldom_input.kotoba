(ns htmldom-input
  (:export [preprocess chunk-end width]))

;; HTML input-stream newline preprocessing on already decoded UTF-8. Offsets
;; in subsequent tokenization refer to the normalized byte sequence. Nulls
;; are not silently changed here; unsupported tokenizer states still refuse.
(defn width [c :i64] :i64
  (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4))
(defn chunk-end [s :string start :i64 n :i64] :i64
  ;; Bound copying work while never splitting a UTF-8 scalar or a CRLF pair.
  (loop [i start last-start start last-c -1]
    (if (or (>= i n) (>= i (+ start 256)))
      (if (and (= last-c 13) (< i n) (= (string-code-point-at s i) 10)) last-start i)
      (let [c (string-code-point-at s i) next (+ i (width c))]
        (if (> next (+ start 256)) i
          (recur next i c))))))
(defn normalize-chunk [s :string] :string
  (let [n (string-length s)]
    (loop [i 0 out ""]
      (let [relative (string-index-of (string-substring s i n) "\r")]
        (if (< relative 0) (string-concat out (string-substring s i n))
          (let [pos (+ i relative) after (+ pos 1)
                next (if (and (< after n) (= (string-code-point-at s after) 10)) (+ after 1) after)]
            (recur next (string-concat out (string-concat (string-substring s i pos) "\n")))))))))
(defn preprocess [s :string] [:option :string]
  (let [n (string-length s)]
    (if (> n 65536) (option-none-of [:option :string])
      (if (< (string-index-of s "\r") 0) (option-some-of [:option :string] s)
        (loop [i 0 out ""]
          (if (= i n) (option-some-of [:option :string] out)
            (let [end (chunk-end s i n)]
              (if (<= end i) (option-none-of [:option :string])
                (recur end (string-concat out (normalize-chunk (string-substring s i end))))))))))))
