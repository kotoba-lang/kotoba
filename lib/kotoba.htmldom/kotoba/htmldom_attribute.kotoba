(ns htmldom-attribute
  (:require [numeric-ref :as numeric] [html-named-ref :as named])
  (:export [next-token]))

;; One attribute-value state step over already preprocessed UTF-8. The caller
;; chooses :attribute/double, :attribute/single, or :attribute/unquoted after
;; consuming the opening quote, and owns tag construction and subsequent state.
;; :consumed is a byte count. The tokens preserve numeric and named-reference
;; diagnostics for the owning tokenizer rather than granting any host effects.
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn number [d :document] :i64 (option-or (document-i64-value d) -1))
(defn keyword-value [d :document] :keyword (option-or (document-keyword-value d) :none))
(defn width [cp :i64] :i64 (cond (< cp 128) 1 (< cp 2048) 2 (< cp 65536) 3 :else 4))
(defn space? [cp :i64] :bool (or (= cp 9) (= cp 10) (= cp 12) (= cp 13) (= cp 32)))
(defn alnum? [cp :i64] :bool
  (or (and (>= cp 48) (<= cp 57)) (and (>= cp 65) (<= cp 90)) (and (>= cp 97) (<= cp 122))))
(defn special-unquoted? [cp :i64] :bool
  (or (= cp 34) (= cp 39) (= cp 60) (= cp 61) (= cp 96)))
(defn boundary? [mode :keyword cp :i64] :bool
  (or (= cp 38) (= cp 0)
      (and (= mode :attribute/double) (= cp 34))
      (and (= mode :attribute/single) (= cp 39))
      (and (= mode :attribute/unquoted) (or (space? cp) (= cp 62) (special-unquoted? cp)))))
(defn text-end [s :string mode :keyword] :i64
  (loop [i 0]
    (if (>= i (string-length s)) i
      (let [cp (string-code-point-at s i)]
        (if (boundary? mode cp) i (recur (+ i (width cp))))))))
(defn token [kind :keyword consumed :i64 text :string value :i64 value2 :i64 status :keyword error :keyword] :document
  (document-map :kind (document-keyword kind) :consumed (document-i64 consumed) :text (document-string text)
                :value (document-i64 value) :value2 (document-i64 value2)
                :status (document-keyword status) :character-error (document-keyword error)))
(defn next-token [s :string mode :keyword] :document
  (let [n (string-length s)]
    (cond (not (or (= mode :attribute/double) (= mode :attribute/single) (= mode :attribute/unquoted)))
            (token :attribute/invalid-mode 0 "" -1 -1 :none :none)
          (= n 0) (token :attribute/eof 0 "" -1 -1 :attribute/eof-in-tag :none)
          :else (let [cp (string-code-point-at s 0)]
            (cond (or (and (= mode :attribute/double) (= cp 34)) (and (= mode :attribute/single) (= cp 39)))
                    (token :attribute/quote-end 1 "" -1 -1 :none :none)
                  (and (= mode :attribute/unquoted) (space? cp))
                    (token :attribute/space-end 1 "" -1 -1 :none :none)
                  (and (= mode :attribute/unquoted) (= cp 62))
                    (token :attribute/tag-end 1 "" -1 -1 :none :none)
                  (= cp 0) (token :attribute/character 1 "" 65533 -1 :attribute/unexpected-null :none)
                  (and (= mode :attribute/unquoted) (special-unquoted? cp))
                    (token :attribute/text 1 (string-substring s 0 1) -1 -1 :attribute/unexpected-character :none)
                  (= cp 38)
                    (if (and (> n 1) (= (string-code-point-at s 1) 35))
                      (let [r (numeric/consume-html (string-substring s 2 n))
                            count (+ 2 (number (field r :consumed)))
                            status (keyword-value (field r :status)) error (keyword-value (field r :character-error))]
                        (if (= status :numeric/no-digits)
                          (token :attribute/text count (string-substring s 0 count) -1 -1 status error)
                          (token :attribute/character count "" (number (field r :value)) -1 status error)))
                      (if (and (> n 1) (alnum? (string-code-point-at s 1)))
                        (let [r (named/consume (string-substring s 1 n) true) count (number (field r :consumed))
                              status (keyword-value (field r :status))]
                          (if (> count 0)
                            (token :attribute/character (+ count 1) "" (number (field r :value))
                                   (number (field r :value2)) status :none)
                            (token :attribute/text 1 "&" -1 -1 status :none)))
                        (token :attribute/text 1 "&" -1 -1 :none :none)))
                  :else (let [end (text-end s mode)]
                          (token :attribute/text end (string-substring s 0 end) -1 -1 :none :none)))))))
