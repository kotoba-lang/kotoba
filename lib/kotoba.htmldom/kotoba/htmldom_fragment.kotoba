(ns htmldom-fragment
  (:require [htmldom-tokens :as tokens] [htmldom-tag :as tag] [kotoba.wasm.dom :as dom])
  (:export [parse]))

;; Explicitly bounded fragment projection, not the HTML tree-construction
;; algorithm. Accept only balanced div/span/p/br and id/class/title. A
;; synthetic div is the fragment container; all other elements, attributes,
;; rawtext, comments, mismatched tags and HTML repair cases refuse. The caller
;; must check :kind before using :document. There are no network capabilities.
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn at [d :document i :i64] :document (option-or (document-vector-at d i) (document-null)))
(defn kval [d :document] :keyword (option-or (document-keyword-value d) :bad))
(defn sval [d :document] :string (option-or (document-string-value d) ""))
(defn ival [d :document] :i64 (option-or (document-i64-value d) -1))
(defn bval [d :document] :bool (option-or (document-bool-value d) false))
(defn tag-key [name :string] :keyword
  (cond (string=? name "div") :div (string=? name "span") :span
        (string=? name "p") :p (string=? name "br") :br :else :unknown))
(defn attr-key [name :string] :keyword
  (cond (string=? name "id") :id (string=? name "class") :class
        (string=? name "title") :title :else :unknown))
(defn has-p? [stack :document i :i64] :bool
  (if (>= i (document-count stack)) false
    (if (= (kval (field (at stack i) :tag)) :p) true (has-p? stack (+ i 1)))))
(defn result [kind :keyword doc :document] :document
  (document-map :kind (document-keyword kind) :document doc))
(defn failed? [d :document] :bool
  (or (bval (field d :op-overflow)) (bval (field d :node-overflow))))
(defn attributes [d :document id :i64 attrs :document i :i64] :document
  (if (>= i (document-count attrs)) d
    (let [a (at attrs i) k (attr-key (sval (field a :name)))]
      (if (= k :unknown) (document-null)
        (attributes (dom/set-attribute d id k (document-string (sval (field a :value)))) id attrs (+ i 1))))))
(defn flush [d :document parent :i64 pending :string] :document
  (if (= (string-length pending) 0) d
    (let [made (dom/create-text-node d pending) id (ival (at made 0)) next (at made 1)]
      (if (<= id 0) (document-null) (dom/append-child next parent id)))))
(defn text-of [t :document] :string
  (let [kind (kval (field t :kind)) a (ival (field t :value)) b (ival (field t :value2))]
    (if (= kind :data/text) (sval (field t :text))
      (if (= kind :data/character) (string-concat (tag/scalar a) (if (< b 0) "" (tag/scalar b))) ""))))
(defn build [ts :document start :document] :document
  (loop [i 0 d start stack (document-vector (document-map :id (document-i64 1) :tag (document-keyword :root))) pending ""]
    (let [depth (document-count stack) top (at stack (- depth 1)) parent (ival (field top :id))]
      (if (>= i (document-count ts))
        (if (not= depth 1) (result :fragment/unsupported (document-null))
          (let [done (flush d parent pending)]
            (if (or (= (document-kind done) :null) (failed? done)) (result :fragment/limit (document-null))
              (result :fragment/ok done))))
        (let [t (at ts i) kind (kval (field t :kind)) tk (tag-key (sval (field t :name)))]
          (cond (or (= kind :data/text) (= kind :data/character))
                  (recur (+ i 1) d stack (string-concat pending (text-of t)))
                (= kind :tag/start)
                  (if (or (= tk :unknown) (and (not= tk :br) (bval (field t :self-closing)))
                          (and (or (= tk :p) (= tk :div)) (has-p? stack 0)))
                    (result :fragment/unsupported (document-null))
                    (let [flushed (flush d parent pending)
                          made (if (= (document-kind flushed) :null) (document-vector) (dom/create-element flushed tk))
                          id (ival (at made 0)) next (at made 1)
                          with-attrs (if (<= id 0) (document-null) (attributes next id (field t :attributes) 0))]
                      (if (or (= (document-kind with-attrs) :null) (failed? with-attrs))
                        (result :fragment/unsupported (document-null))
                        (let [joined (dom/append-child with-attrs parent id)]
                          (if (failed? joined) (result :fragment/limit (document-null))
                            (recur (+ i 1) joined (if (= tk :br) stack
                              (document-vector-conj stack (document-map :id (document-i64 id) :tag (document-keyword tk)))) ""))))))
                (= kind :tag/end)
                  (if (or (= depth 1) (= tk :unknown) (not= tk (kval (field top :tag))))
                    (result :fragment/unsupported (document-null))
                    (let [next (flush d parent pending)]
                      (if (or (= (document-kind next) :null) (failed? next)) (result :fragment/limit (document-null))
                        (recur (+ i 1) next (document-vector-remove stack (- depth 1)) ""))))
                :else (result :fragment/unsupported (document-null))))))))
(defn parse [html :string] :document
  (let [parsed (tokens/tokenize html)]
    (if (not= (kval (field parsed :kind)) :html/done) (result :fragment/unsupported (document-null))
      (let [root (dom/create-element (dom/empty-document) :div) id (ival (at root 0)) d (at root 1)]
        (if (not= id 1) (result :fragment/limit (document-null))
          (build (field parsed :tokens) (dom/set-root d id)))))))
