;; The EVM plane's standing declaration.
;;
;; kototama's spec sets :floating-evm-claim-forbidden true and
;; :core-is-not-automatically-evm-compatible true. Shipping an EVM tender
;; therefore obliges this file: a claim must name its profile, level,
;; version, implementation and evidence, and a :partial one must list its
;; omissions. This is that value, not a summary of it.
{:schema :kototama.vm/implementation-profile-v1
 :spec {:schema :kototama.vm/spec-v1
        :version 1
        :repository "https://github.com/kotoba-lang/kototama"}

 :implementation
 {:name :kototama.evm-tender
  :repository "https://github.com/kotoba-lang/kototama"
  :namespace "kototama.evm-tender"
  :kind :tender
  :engine {:name :kotoba.vm.evm
           :repository "https://github.com/kotoba-lang/kotoba-vm"
           :pin "1412270b84b23882429b4614381d2f5a1b24f7c3"}
  :runtimes [:jvm :nbb]
  :note (str "The tender role discharged over EVM bytecode, beside "
             "kototama.tender's Wasm/Chicory. Portable .cljc with no host "
             "imports, so unlike the Wasm tender it is not pinned to the JVM.")}

 :profiles
 {:evm/v1
  {:status :partial
   ;; Empty, and it stays empty until the suites the spec names have run.
   ;; A tender existing is not a level; a level is earned by
   ;; :ethereum-general-state-tests and :differential-execution, and neither
   ;; has been run against this engine.
   :levels []
   :implemented [:tender-role-discharged-over-evm-bytecode
                 :kototama-vm-receipt-v1-emission
                 :overlay-commit-on-success
                 :overlay-discard-on-revert-and-exhaustion
                 :resource-exhaustion-as-a-value
                 :named-versioned-gas-mapping
                 :fip-0054-exit-code-mapping
                 :contract-authority-vocabulary-reused-unforked
                 :unknown-grant-rejected-pre-flight]
   :evidence ["test/kototama/evm_tender_test.cljk"
              "src/kototama/evm_tender.cljk"]
   :omissions [:ethereum-general-state-tests
               :differential-execution-suite
               :evm-message-level
               :ethereum-state-root
               :precompiled-contracts
               :selfdestruct
               :opcode-coverage-audit
               :gas-schedule-equality-with-ethereum
               :chain-spec-pin
               :hardfork-pin
               :precompile-set-pin
               :deployment]}

  :fevm/v1
  {:status :shape-only
   :levels []
   :implemented [:fip-0054-exit-code-mapping]
   :evidence ["test/kototama/evm_tender_test.cljk"]
   :omissions [:filecoin-network-version-pin
               :fevm-actor-version-pin
               :gas-mapping-to-filecoin-meter
               :delegated-address-mapping
               :ethereum-address-manager
               :evm-calldata-in-fvm-message
               :event-log-mapping
               :ethereum-json-rpc
               :system-actor-boundary
               :fevm-message-vectors
               :fvm-evm-differential-execution]}}

 :non-claims
 [:evm-compatibility
  :fevm-compatibility
  :ethereum-gas-equality
  :mainnet-deployability
  :canonical-ethereum-receipt
  :trie-root
  :revm-parity
  :consensus]

 :notes
 {:gas-mapping
  (str "kototama.evm-tender/gas-mapping, :kototama.evm/gas-is-budget-v1. "
       "The relation is the identity -- a caller's budget IS EVM gas on the "
       "Paris schedule -- but it is named and versioned because the spec "
       "requires a mapping to be identified rather than implied, and because "
       "kototama.tender's :fuel is a Wasm INSTRUCTION COUNT. Two different "
       "quantities answer to the word budget in this repository.")

  :why-the-receipt-is-new
  (str "No :kototama.vm/receipt-v1 existed in code before this. The Wasm "
       "tender's run-report returns {:ok? :result :fuel-used :limits ...}, "
       "which is an outcome map and not the spec's receipt. This plane emits "
       "the spec shape, so the two planes are not yet symmetric in what they "
       "report -- the Wasm side is the one that owes a receipt.")

  :exhaustion
  (str "The spec says :resource-exhaustion {:outcome :value :must-not "
       ":uncatchable-host-trap}. kototama.tender satisfies this only at the "
       "run-report boundary: its fuel listener throws from inside execution "
       "and an outer catch converts it. This plane never throws for it -- "
       "kotoba.vm.evm returns {:status :invalid :invalid-reason \"out of "
       "gas\"} as an ordinary value.")

  :ambient-authority
  (str "EVM bytecode has no import section, so a contract has no ambient "
       "authority to subtract. kototama.contract is still the authority "
       "vocabulary here, reused unforked; for a pure EVM execution the "
       "granted set is empty by construction rather than by configuration.")}}
