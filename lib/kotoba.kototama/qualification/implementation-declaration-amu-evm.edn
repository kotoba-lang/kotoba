    ;; NOT run; required-suites for :evm/v1 are unmet
    :conformance-suites
    ;; no deploy/creation flow, only artifact verification of emitted bytes
    :deployment
    ;; no keccak256/address/chain pins; :pins list unexercised
    :pins-unexercised]}}
 
