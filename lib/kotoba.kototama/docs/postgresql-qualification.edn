 [{:os :macos :arch :arm64 :runner :local
   :jdk [21]
   :postgresql [{:major 14 :observed "14.19" :status :pass}
                {:major 15 :observed "15.13" :status :pass}
                {:major 17 :observed "17.9" :status :pass}]}
  {:os :linux :arch :x86_64 :runner :orbstack-amd64-container
   :jdk [{:major 21 :observed "21.0.11"}]
   :postgresql [{:major 14 :observed "14.23" :status :pass}
                {:major 15 :observed "15.18" :status :pass}
                {:major 17 :observed "17.10" :status :pass}]
   :github-actions :required-freshness}
