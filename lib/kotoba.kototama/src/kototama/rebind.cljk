(ns kototama.rebind
  "Live redefinition is rebind, not mutation.

  D4 of kotoba-lang/kotoba-lang
  docs/adr/ADR-kotoba-lisp-machine-contract-decisions.md: the 紋 (rule Form /
  logic Form) of a running cell is immutable, as a Holochain DNA is. The live
  operation is a versioned rebinding of ONE code-environment slot:

    (rebind env env-slot old-defcid new-defcid) -> {env' receipt}

  Running continuations keep the old DefCID to completion; the new binding
  takes effect from the next call. This namespace operates on the code
  environment alone -- it structurally cannot touch a rule Form, and it never
  rewrites another slot. Attempts are always receipted (kototama
  :attempt-always-receipted), including refusals.

  The receipt here is the rebind record; the runtime host wraps it into a
  full :kototama.vm/receipt-v1 (machine-spec, implementation, profile,
  message-cid, fuel and the rest are the host's fields, not this module's).")

(def ^:private refusal-reasons
  #{:slot-missing :binding-mismatch :no-change :invalid-binding})

(defn- text? [x]
  (and (string? x) (pos? (count x))))

(defn- receipt [env-slot old-defcid new-defcid env-version outcome reason]
  (cond-> {:rebind/env-slot env-slot
           :rebind/old-defcid old-defcid
           :rebind/new-defcid new-defcid
           :rebind/env-version env-version
           :rebind/outcome outcome
           :rebind/attempt-always-receipted true}
    reason (assoc :rebind/reason reason)))

(defn rebind
  "Versioned rebinding of ENV's ENV-SLOT from OLD-DEFCID to NEW-DEFCID.

  ENV is a map of slot -> DefCID (the image's code environment; see
  kotoba-lang/kotoba-lang docs/kotoba-lisp-machine-design.ja.md section 5.1).
  Returns {:ok? true :environment env' :previous defcid :receipt r} or
  {:ok? false :reason why :receipt r} -- refused attempts are receipted too.

  Optimistic check: the caller names the binding it believes is live. A
  mismatch refuses rather than silently rebinding over someone else's change."
  [env env-slot old-defcid new-defcid]
  (let [version (inc (long (or (:rebind/env-version (meta env)) 0)))
        refuse (fn [reason]
                 {:ok? false
                  :reason reason
                  :receipt (receipt env-slot old-defcid new-defcid version
                                    :refused reason)})]
    (cond
      (not (map? env))
      (refuse :invalid-binding)

      (not (contains? env env-slot))
      (refuse :slot-missing)

      (not (and (text? old-defcid) (text? new-defcid)))
      (refuse :invalid-binding)

      (= old-defcid new-defcid)
      (refuse :no-change)

      (not= (get env env-slot) old-defcid)
      (refuse :binding-mismatch)

      :else
      {:ok? true
       :previous old-defcid
       :environment (with-meta (assoc env env-slot new-defcid)
                      {:rebind/env-version version})
       :receipt (receipt env-slot old-defcid new-defcid version :rebound nil)})))

(defn rebind?
  "True when X is a rebind record (this module's receipt shape)."
  [x]
  (and (map? x)
       (contains? x :rebind/env-slot)
       (contains? x :rebind/old-defcid)
       (contains? x :rebind/new-defcid)
       (contains? x :rebind/env-version)
       (contains? x :rebind/outcome)
       (true? (:rebind/attempt-always-receipted x))))

(def refusal-reasons
  "Every reason this module can refuse with. Refusal is fail-closed and
  recorded; it is never a silent no-op."
  refusal-reasons)
