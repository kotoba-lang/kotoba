(ns kototama.receipt-debug
  "Receipt debugger（D3 of kotoba-lang/kotoba-lang
  docs/adr/ADR-kotoba-lisp-machine-contract-decisions.md）.

  A consumer of :kototama.vm/receipt-v1 records: diagnosis reconstructed from
  recorded evidence -- state-before/after, fuel-used, events, child receipts.
  **No live heap inspection.** This namespace is pure: it reads the receipt
  map and answers; it performs no I/O, no re-execution, no host calls.

  What a record alone proves and what needs the host to replay are kept
  separate (`evidence`), because the repo rule is that a link proves a symbol,
  not that the machine code ran: only the host can re-execute. This module
  never claims a replay happened.")

(def receipt-v1-required
  "spec/kototama-vm-v1.edn の :receipt :required（順序も spec どおり）。"
  [:machine-spec :implementation :profile :message-cid :program-cid
   :state-before :state-after :outcome :fuel-used :events :authority-decision])

(def receipt-v1-forbidden
  "同 spec の :forbidden。ここが出た receipt は記録してはいけない。"
  #{:raw-biscuit :private-key :ambient-host-handle})

(def authority-decision-keys
  "同 spec の :authority-decision。"
  [:manifest-cid :grant-ids :policy-id :world :epoch])

(defn problems
  "receipt-v1 がこの receipt を拒否する理由。空 = shape としては受け取れる。
  throw せず報告する。"
  [receipt]
  (cond-> []
    (not (map? receipt))
    (conj {:problem :receipt-not-a-map})

    (map? receipt)
    (into
     (concat
      (for [k receipt-v1-required
            :when (not (contains? receipt k))]
        {:problem :missing-required :key k})
      (for [k (filter #(contains? receipt %) receipt-v1-forbidden)]
        {:problem :forbidden-key :key k})
      (when-not (or (nil? (:events receipt)) (sequential? (:events receipt)))
        [{:problem :events-not-sequential}])
      (when-not (or (nil? (:child-receipts receipt))
                    (sequential? (:child-receipts receipt)))
        [{:problem :child-receipts-not-sequential}])))))

(defn timeline
  "events を index つきで直列化し、child-receipts を深さつきで畳む。
  実行順の記録を並べ直すだけで、実行はしない。"
  [receipt]
  (letfn [(walk [r depth]
            (concat
             (map-indexed
              (fn [i e] {:depth depth :index i :event e})
              (:events r))
             (mapcat #(walk % (inc depth)) (:child-receipts r))))]
    (vec (walk receipt 0))))

(defn failure-point
  "outcome が失敗（:revert / 資源枯渇 / trap など success 以外）なら、
  記録から分かる失敗点を返す: 最後の event の index と、あれば revert-data。
  success なら nil。記録に無い場所を推測しない。"
  [receipt]
  (let [outcome (:outcome receipt)
        events (:events receipt)]
    (when (and (map? receipt) (not= :success outcome))
      (cond-> {:outcome outcome
               :at-event-index (when (sequential? events)
                                 (max 0 (dec (count events))))}
        (contains? receipt :revert-data)
        (assoc :revert-data (:revert-data receipt))))))

(defn evidence
  "この記録だけが証明することと、host の replay が要ることを分けて返す。
  この ns は replay しない。再実行を主張する記録はここから出さない。"
  [receipt]
  (let [probs (problems receipt)]
    {:proves (vec (concat
                   [:outcome-recorded :fuel-accounted]
                   (when (contains? receipt :state-before) [:state-before-recorded])
                   (when (contains? receipt :state-after) [:state-after-recorded])
                   (when (sequential? (:events receipt)) [:event-order-recorded])
                   (when (sequential? (:child-receipts receipt)) [:child-links-recorded])))
     :needs-host [:re-execution :state-transition-verification :fuel-schedule-verification]
     :problems (vec probs)}))
