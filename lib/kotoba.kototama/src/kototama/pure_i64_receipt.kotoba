;; Receipt/v2 framing and consistency only. This does not authenticate the
;; producer, admit a program, grant authority, or validate the VM state.
(ns kototama.pure-i64-receipt (:export [valid?]))

(defn- octets? [data :vector-i64] :bool
  (loop [i 0]
    (if (= i (vector-count data)) true
      (let [n (vector-at data i)]
        (and (>= n 0) (<= n 255) (recur (inc i)))))))

(defn- word [data :vector-i64 offset :i64] :i64
  (loop [i 0 value 0]
    (if (= i 8) value
      (recur (inc i)
             (bit-or value (i64-shift-left (vector-at data (+ offset i)) (* i 8)))))))

(defn valid?
  "Check a complete receipt against the host's independently admitted invocation.
   exit is the normal process exit code; signals and transport errors must be
   represented by a different value. expected-stack is the exact admitted bound."
  [data :vector-i64 exit :i64 budget :i64 expected-stack :i64] :bool
  (if (or (not= (vector-count data) 64) (not (octets? data))
          (< budget 0) (> budget 9007199254740991)
          (< expected-stack 64) (> expected-stack 262144)
          (not= (bit-and expected-stack 15) 0))
    false
    (let [magic (word data 0) status (word data 8) value (word data 16)
          claimed-budget (word data 24) spent (word data 32)
          remaining (word data 40) arena (word data 48) stack (word data 56)]
      (and (= magic 14164133038085195)
           (>= status 0) (<= status 3)
           (= exit (if (= status 0) 0 70))
           (= claimed-budget budget) (= arena 0) (= stack expected-stack)
           (or (= status 0) (= value 0))
           (> spent 0) (<= spent (+ budget 1))
           (>= remaining -1) (<= remaining budget)
           (= spent (- budget remaining))
           (if (= status 1)
             (= remaining -1)
             (>= remaining 0))))))
