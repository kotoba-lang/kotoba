;; kototama.admission -- the invocation admission core, as pure Kotoba (src/kototama/admission.kotoba).
;;
;; root ADR-2610082200 (P2): the call-permission core holds no Datalog and no
;; Biscuit. It is a closed predicate over six origins, written in Kotoba Form
;; and compiled by amu, so it runs inside kototama on every qualified target
;; and has a DefCID like any other definition.
;;
;; A capability exists only for the intersection
;;
;;   amu static effect  ∩ vm requested intent  ∩ capability-chain grant
;;   ∩ local policy allow  ∩ runtime availability   (and amu world = runtime world)
;;
;; Every origin arrives already resolved by its own owner, as a closed set of
;; keys -- the predicate does not derive facts, run rules, recurse or reach the
;; host:
;;   effect key   "<kind>"                    amu's static effects of the definition
;;   intent key   "<kind> <resource>"         what the VM was asked to do
;;   grant key    "<kind> <resource>"         dango's meet over the chain (authority.chain/fold)
;;   policy key   "<kind> <resource>"         the local policy's allow set
;;   avail key    "<kind> <resource>"         what the runtime can provide now
;;
;; Datalog and Biscuit are lifted out of this core:
;;   Biscuit  -> an adapter at the Authn boundary; it is transcoded into a
;;               capability chain before anything here sees it
;;   Datalog  -> a query library for logic Forms over the datom index, and a
;;               policy authoring language whose output is the allow set above
;;
;; Missing origin denies: an empty set contains nothing. An effect outside the
;; closed catalog denies even when every origin lists it.

(ns kototama.admission
  (:require [authority.lattice :as lat]
            [authority.delegation :as del]
            [kotoba.lang.bounded-text :as bt])
  (:export [main pair-key eligible? cap-scope admit
            test-cap-scope test-admit-granted test-admit-chain-reasons
            test-admit-origin-reasons test-all-origins-admit test-missing-grant-denies
            test-missing-policy-denies test-unavailable-denies test-world-mismatch-denies
            test-unknown-effect-denies test-intent-not-requested-denies
            test-other-resource-denies test-empty-origins-deny]))

(defn pair-key [kind :string resource :string] :string
  (string-concat (string-concat kind " ") resource))

(defn eligible?
  [catalog [:set :string]
   effects [:set :string]
   definition-world :string
   intents [:set :string]
   grants [:set :string]
   policy [:set :string]
   runtime-world :string
   available [:set :string]
   kind :string
   resource :string] :bool
  (let [k (pair-key kind resource)]
    (and (typed-set-contains [:set :string] catalog kind)
         (typed-set-contains [:set :string] effects kind)
         (string=? definition-world runtime-world)
         (typed-set-contains [:set :string] intents k)
         (typed-set-contains [:set :string] grants k)
         (typed-set-contains [:set :string] policy k)
         (typed-set-contains [:set :string] available k))))

;; --- the grant origin from a delegation chain -------------------------------
;;
;; eligible? takes the grant origin as a set already resolved. admit resolves it
;; itself, from the presented chain, with authority.delegation (kotoba-lang/
;; authority, pure Kotoba): the request covers when every link of the chain has a
;; scope covering the request's scope, the chain is live at now, and the holder
;; is the leaf's. The other five origins are the same closed sets as eligible?.
;;
;; A cap [kind resource] becomes a scope the way dango.chain/cap->scope does:
;; kind "ns/name" and resource "scheme://path" give "ns://name/scheme/path"; an
;; unqualified kind, an invalid resource, or a result that is not a valid scope
;; gives "" (which is never a scope, so it covers nothing).
;;
;; admit answers a reason code, so a receipt can say which origin refused:
;;   1  admitted
;;   2..7 the chain's own reason (authority.delegation: 2 escalation-attempted,
;;        3 empty-chain, 4 expired-or-no-trusted-time, 5 wrong-holder,
;;        6 out-of-scope, 7 malformed-chain)
;;   10 the kind is not in the closed effect catalog
;;   11 amu did not declare the effect for this definition
;;   12 the definition's world is not the runtime's
;;   13 the VM did not request this kind and resource
;;   14 local policy does not allow it
;;   15 the runtime cannot provide it now
;;   16 the cap is not a scope (kind not "ns/name", or resource not a scope)
;; Static origins (10-13, 16) are checked before the chain, the chain before
;; policy and availability, so the cheapest certain refusal is the one reported.

(defn- scheme-slash-path [resource :string] :string
  ;; "scheme://path" -> "scheme/path"; only called on a valid scope
  (let [i (bt/index-of-text resource "://")]
    (string-concat (string-concat (string-substring resource 0 i) "/")
                   (string-substring resource (+ i 3) (string-byte-length resource)))))

(defn cap-scope [kind :string resource :string] :string
  (let [i (bt/index-of-text kind "/")]
    (if (<= i 0)
      ""
      (let [ns (string-substring kind 0 i)
            name (string-substring kind (+ i 1) (string-byte-length kind))]
        (if (or (= (string-byte-length name) 0) (bt/contains-text? name "/") (not (lat/valid? resource)))
          ""
          (let [s (string-concat (string-concat (string-concat ns "://") (string-concat name "/"))
                                 (scheme-slash-path resource))]
            (if (lat/valid? s) s "")))))))

(defn admit
  [catalog [:set :string]
   effects [:set :string]
   definition-world :string
   intents [:set :string]
   chain-scopes [:map :i64 [:set :string]]
   chain-holders [:map :i64 :string]
   chain-expires [:map :i64 :string]
   policy [:set :string]
   runtime-world :string
   available [:set :string]
   kind :string
   resource :string
   now :string
   holder :string
   strict :bool] :i64
  (let [k (pair-key kind resource)
        scope (cap-scope kind resource)]
    (if (not (typed-set-contains [:set :string] catalog kind)) 10
      (if (not (typed-set-contains [:set :string] effects kind)) 11
        (if (not (string=? definition-world runtime-world)) 12
          (if (not (typed-set-contains [:set :string] intents k)) 13
            (if (= (string-byte-length scope) 0) 16
              (let [d (del/authorize chain-scopes chain-holders chain-expires scope now holder strict)]
                (if (not (= d 1)) d
                  (if (not (typed-set-contains [:set :string] policy k)) 14
                    (if (not (typed-set-contains [:set :string] available k)) 15
                      1)))))))))))

;; --- tests: exported zero-arity test-* return i64 1 on pass -----------------

(def catalog (typed-set-new [:set :string] "http.get-stream" "log.append" "object-store.put-block"))
(def effects (typed-set-new [:set :string] "http.get-stream" "log.append"))
(def granted (typed-set-new [:set :string] "http.get-stream https://a.example" "log.append audit"))
(def none (typed-set-new [:set :string]))

(defn- admit-set [grants [:set :string] policy [:set :string] available [:set :string]
              runtime-world :string kind :string resource :string] :bool
  (eligible? catalog effects "kotoba:app/v0.2" granted grants policy runtime-world available kind resource))

(defn- pass [b :bool] :i64 (if b 1 0))

(defn test-all-origins-admit [] :i64
  (pass (admit-set granted granted granted "kotoba:app/v0.2" "http.get-stream" "https://a.example")))

(defn test-missing-grant-denies [] :i64
  (pass (not (admit-set none granted granted "kotoba:app/v0.2" "http.get-stream" "https://a.example"))))

(defn test-missing-policy-denies [] :i64
  (pass (not (admit-set granted none granted "kotoba:app/v0.2" "http.get-stream" "https://a.example"))))

(defn test-unavailable-denies [] :i64
  (pass (not (admit-set granted granted none "kotoba:app/v0.2" "http.get-stream" "https://a.example"))))

(defn test-world-mismatch-denies [] :i64
  (pass (not (admit-set granted granted granted "kotoba:app/v0.1" "http.get-stream" "https://a.example"))))

(defn test-unknown-effect-denies [] :i64
  (let [g (typed-set-new [:set :string] "clock.now -")]
    (pass (not (eligible? catalog (typed-set-new [:set :string] "clock.now") "w" g g g "w" g "clock.now" "-")))))

(defn test-intent-not-requested-denies [] :i64
  (pass (not (eligible? catalog effects "w" none granted granted "w" granted "log.append" "audit"))))

(defn test-other-resource-denies [] :i64
  (pass (not (admit-set granted granted granted "kotoba:app/v0.2" "http.get-stream" "https://b.example"))))

(defn test-empty-origins-deny [] :i64
  (pass (not (eligible? none none "w" none none none "w" none "log.append" "audit"))))


;; cap-scope against dango.chain/cap->scope (rendered with authority.scope),
;; asked 2026-10-09 on kotoba-lang/dango#1: these ten rows are its answers.
(defn test-cap-scope [] :i64
  (pass (and (string=? (cap-scope "data/read" "kotoba://graph/g1") "data://read/kotoba/graph/g1")
             (string=? (cap-scope "data/read" "kotoba://graph/*") "data://read/kotoba/graph/*")
             (string=? (cap-scope "read" "kotoba://graph/g1") "")
             (string=? (cap-scope "a.b/c" "k://x") "a.b://c/k/x")
             (string=? (cap-scope "data/*" "k://x") "")
             (string=? (cap-scope "data/read" "nonsense") "")
             (string=? (cap-scope "data/" "k://x") "")
             (string=? (cap-scope "/read" "k://x") "")
             (string=? (cap-scope "http/get-stream" "https://a.example/feed")
                       "http://get-stream/https/a.example/feed")
             (string=? (cap-scope "data/read" "k://graph/*/x") ""))))

(def now "2026-06-01T00:00:00Z")
(def kinds (typed-set-new [:set :string] "data/read" "data/write"))
(def asked (typed-set-new [:set :string] "data/read kotoba://graph/g1" "data/write kotoba://graph/g1"))

(defn- one-link [scope :string holder :string expires :string] [:map :i64 [:set :string]]
  (typed-map-new [:map :i64 [:set :string]] 0 (typed-set-new [:set :string] scope)))

(defn- run [scopes [:map :i64 [:set :string]] holders [:map :i64 :string] expires [:map :i64 :string]
            kind :string strict :bool] :i64
  (admit kinds kinds "w" asked scopes holders expires asked "w" asked
         kind "kotoba://graph/g1" now "did:a" strict))

(defn- col [x :string] [:map :i64 :string] (typed-map-new [:map :i64 :string] 0 x))

(defn test-admit-granted [] :i64
  (pass (and (= 1 (run (one-link "data://read/kotoba/graph/*" "" "") (col "") (col "") "data/read" false))
             (= 1 (run (one-link "data://read/kotoba/graph/g1" "" "") (col "did:a") (col "2027-01-01T00:00:00Z")
                       "data/read" false)))))

(defn test-admit-chain-reasons [] :i64
  (let [two (typed-map-new [:map :i64 [:set :string]]
                           0 (typed-set-new [:set :string] "data://read/kotoba/graph/*")
                           1 (typed-set-new [:set :string] "data://read/kotoba/graph/*" "data://write/kotoba/graph/*"))
        two-col (typed-map-new [:map :i64 :string] 0 "" 1 "")]
    (pass (and (= 6 (run (one-link "data://read/kotoba/graph/*" "" "") (col "") (col "") "data/write" false))
               (= 3 (run (typed-map-new [:map :i64 [:set :string]]) (typed-map-new [:map :i64 :string])
                         (typed-map-new [:map :i64 :string]) "data/read" false))
               (= 4 (run (one-link "data://read/kotoba/graph/*" "" "") (col "") (col "2026-01-01T00:00:00Z")
                         "data/read" false))
               (= 5 (run (one-link "data://read/kotoba/graph/*" "" "") (col "did:b") (col "") "data/read" false))
               (= 1 (admit kinds kinds "w" asked two two-col two-col asked "w" asked
                           "data/read" "kotoba://graph/g1" now "did:a" false))
               (= 2 (admit kinds kinds "w" asked two two-col two-col asked "w" asked
                           "data/read" "kotoba://graph/g1" now "did:a" true))
               (= 7 (run (one-link "data://read/kotoba/graph/*" "" "") (typed-map-new [:map :i64 :string]) (col "")
                         "data/read" false))))))

(defn test-admit-origin-reasons [] :i64
  (let [link (one-link "data://read/kotoba/graph/*" "" "")
        none (typed-set-new [:set :string])]
    (pass (and (= 10 (admit none kinds "w" asked link (col "") (col "") asked "w" asked
                            "data/read" "kotoba://graph/g1" now "did:a" false))
               (= 11 (admit kinds none "w" asked link (col "") (col "") asked "w" asked
                            "data/read" "kotoba://graph/g1" now "did:a" false))
               (= 12 (admit kinds kinds "w" asked link (col "") (col "") asked "v" asked
                            "data/read" "kotoba://graph/g1" now "did:a" false))
               (= 13 (admit kinds kinds "w" none link (col "") (col "") asked "w" asked
                            "data/read" "kotoba://graph/g1" now "did:a" false))
               (= 14 (admit kinds kinds "w" asked link (col "") (col "") none "w" asked
                            "data/read" "kotoba://graph/g1" now "did:a" false))
               (= 15 (admit kinds kinds "w" asked link (col "") (col "") asked "w" none
                            "data/read" "kotoba://graph/g1" now "did:a" false))
               (= 16 (admit (typed-set-new [:set :string] "read") (typed-set-new [:set :string] "read") "w"
                            (typed-set-new [:set :string] "read kotoba://graph/g1") link (col "") (col "")
                            asked "w" asked "read" "kotoba://graph/g1" now "did:a" false))))))

;; main: the number of test-* that pass (13 when all do). The browser host
;; admits a module only with a main export.
(defn main [] :i64
  (+ (test-all-origins-admit) (test-missing-grant-denies) (test-missing-policy-denies)
     (test-unavailable-denies) (test-world-mismatch-denies) (test-unknown-effect-denies)
     (test-intent-not-requested-denies) (test-other-resource-denies) (test-empty-origins-deny)
     (test-cap-scope) (test-admit-granted) (test-admit-chain-reasons) (test-admit-origin-reasons)))

;; Check and run (linked, JVM-free; measured 2026-10-09 on amu a1da8afee +
;; kotoba-lang/amu#1253). The module requires authority.lattice,
;; authority.delegation (kotoba-lang/authority#1) and kotoba.lang.bounded-text
;; (kotoba-lang/text), so each needs a --source-path:
;;   kotoba -M check src/kototama/admission.kotoba --source-path src \
;;     --source-path <authority>/src --source-path <text>/src
;;   kotoba -M compile ... --unpinned --target wasm32-browser --fuel 5000000 --output admission.wasm
;; then each test-* in a fresh instance through runtime/browser-host.mjs: 13 of 13.
