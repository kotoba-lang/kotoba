(ns kototama.repl
  "REPL = typed eval の上の対話ループ（D3 of kotoba-lang/kotoba-lang
  docs/adr/ADR-kotoba-lisp-machine-contract-decisions.md、本文は
  docs/kotoba-lisp-machine-design.ja.md section 5.2）.

  `eval` は DefCID で checked code を選び、AdmissionCID が interface・effect・
  allowance・limit を束縛する（kotoba-lang/kotoba-lang lang/typed-eval.edn）。
  **host-eval は無い。reflection は無い。** source を直接評価する入力は拒否する。

  対話は「新しい DefCID を環境に束縛する操作」であって、機械の内部を覗く窓ではない:
  このループの唯一の変更操作は D4 の rebind（kototama.rebind）である。実行そのものは
  注入された eval-fn（宿 = kototama-native / kototama-component / wasm-webcomponent）
  に委ね、この ns は入力の形・束縛・記録だけを持つ。pure な .cljk、I/O なし。"
  (:require [kototama.rebind :as rebind]))

(def ops
  "このループが受け付ける操作。:eval-source 等の host-eval 入力はここに無い。"
  #{:eval :rebind})

(def state-keys
  "ループの状態。code environment は image のそれ（slot -> DefCID）。"
  [:code-environment :history])

(defn problems
  "command がこのループに載らない理由。空 = 形としては受け付ける。"
  [command]
  (cond-> []
    (not (map? command))
    (conj {:problem :command-not-a-map})

    (map? command)
    (into
     (concat
      (when (= :eval-source (:repl/op command))
        [{:problem :no-host-eval}])
      (when (= :reflection (:repl/op command))
        [{:problem :no-reflection}])
      (when-not (contains? ops (:repl/op command))
        [{:problem :unknown-op :value (:repl/op command)}])
      (when (= :eval (:repl/op command))
        (cond-> []
          (not (and (string? (:repl/defcid command))
                    (pos? (count (:repl/defcid command)))))
          (conj {:problem :no-defcid})
          (not (and (string? (:repl/admission-cid command))
                    (pos? (count (:repl/admission-cid command)))))
          (conj {:problem :no-admission-cid})))
      (when (= :rebind (:repl/op command))
        (cond-> []
          (not (keyword? (:repl/slot command)))
          (conj {:problem :bad-slot :value (:repl/slot command)})
          (not (and (string? (:repl/old-defcid command))
                    (pos? (count (:repl/old-defcid command)))))
          (conj {:problem :missing-rebind-field :key :repl/old-defcid})
          (not (and (string? (:repl/new-defcid command))
                    (pos? (count (:repl/new-defcid command)))))
          (conj {:problem :missing-rebind-field :key :repl/new-defcid})))))))

(defn init
  "空の対話状態。code environment は束縛ごと渡す（image の code environment）。"
  ([] (init {}))
  ([code-environment]
   {:code-environment (or code-environment {}) :history []}))

(defn step
  "1 コマンドを 1 ステップ進める。戻りは
  {:ok? bool :state state' :output out :attempt attempt}。
  実行は注入 eval-fn に委ねる。失敗も含め attempt は history に残す
  （kototama :attempt-always-receipted）。変更操作は :rebind だけ。"
  [state command {:keys [eval-fn] :as seams}]
  (let [attempt {:repl/op (:repl/op command) :repl/command command}
        record (fn [ok? state' output]
                 {:ok? ok?
                  :state (update state' :history (fnil conj []) (assoc attempt :repl/ok? ok?))
                  :output output
                  :attempt (assoc attempt :repl/ok? ok?)})]
    (cond
      (seq (problems command))
      (record false state {:refused (vec (problems command))})

      (= :rebind (:repl/op command))
      (let [r (rebind/rebind (:code-environment state)
                             (:repl/slot command)
                             (:repl/old-defcid command)
                             (:repl/new-defcid command))]
        (if (:ok? r)
          (record true (assoc state :code-environment (:environment r))
                  {:receipt (:receipt r)})
          (record false state {:refused [(:reason r)] :receipt (:receipt r)})))

      (= :eval (:repl/op command))
      (if (ifn? eval-fn)
        (let [result (eval-fn {:defcid (:repl/defcid command)
                               :admission-cid (:repl/admission-cid command)
                               :input (:repl/input command)
                               :code-environment (:code-environment state)})]
          (record (not= :error (:outcome result)) state {:result result}))
        (record false state {:refused [:no-eval-host]}))

      :else
      (record false state {:refused [:unknown-op]}))))
