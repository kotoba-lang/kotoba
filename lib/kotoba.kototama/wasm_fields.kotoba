;; kototama.wasm-fields -- contract import id naming, as a pure Kotoba guest
;; (oracle: src/kototama/wasm_fields.cljk).
;;
;; The oracle's table is 58 entries (measured by counting the map): an
;; id string and its wasm field name under module "kotoba". :container-items
;; is 32 (measured), so the whole table cannot be a guest value -- and it
;; is mechanism (naming) anyway. What the guest holds honestly is the
;; NAMING RULE the table obeys: a kebab-case import id maps to the
;; snake_case field name, digit-preserving, with two exceptions the
;; oracle's own comments state (:http-fetch's field matches
;; kotoba-core-contracts' pre-existing "http/fetch" entry verbatim).
;;
;; The guest derives the expected field name from an id and reports whether
;; the table's spelling matches the rule -- the check the host cannot run
;; without embedding the whole table, and the drift the extraction ADR
;; (2026-09-07) was written to prevent.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile kototama/wasm_fields.kotoba --target wasm32-browser --output wasm_fields.wasm

(ns kototama.wasm-fields
  (:export [kebab->snake field-matches-rule? valid-id?]))

;; --- character classification ------------------------------------------------

(defn- char-at [s :string i :i64] :string
  (string-substring s i (+ i 1)))

(defn- is-dash [c :string] :bool
  (string=? c "-"))

;; string-index-of lowerings exist for check but the wasm32 backend refused
;; the table form (measured: "unsupported typed Wasm expression"), so the
;; classes are decided by code point -- ASCII digits are 48..57, lowercase
;; ASCII is 97..122, and both bounds are closed under i64 comparison.

(defn- code-point [c :string] :i64
  (string-code-point-at c 0))

(defn- is-digit [c :string] :bool
  (let [cp (code-point c)]
    (if (>= cp 48) (<= cp 57) false)))

(defn- is-lower [c :string] :bool
  (let [cp (code-point c)]
    (if (>= cp 97) (<= cp 122) false)))

(defn- derive [s :string n :i64 i :i64 acc :string] :string
  (if (>= i n)
    acc
    (let [c (char-at s i)]
      (derive s n (+ i 1)
              (if (is-dash c)
                (string-concat acc "_")
                (string-concat acc c))))))

(defn kebab->snake [id :string] :string
  (derive id (string-length id) 0 ""))

;; --- validation --------------------------------------------------------------

(defn- valid-char [c :string] :bool
  (if (is-dash c) true
      (if (is-digit c) true
          (is-lower c))))

(defn- valid-loop [s :string n :i64 i :i64] :bool
  (if (>= i n)
    true
    (if (valid-char (char-at s i))
      (valid-loop s n (+ i 1))
      false)))

(defn valid-id? [id :string] :bool
  (let [n (string-length id)]
    (if (= n 0)
      false
      (if (is-dash (char-at id 0))
        false
        (if (is-dash (char-at id (- n 1)))
          false
          (valid-loop id n 0))))))

(defn field-matches-rule? [id :string field :string] :bool
  (string=? field (kebab->snake id)))
