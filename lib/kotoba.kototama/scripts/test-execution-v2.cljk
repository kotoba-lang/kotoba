(ns test-execution-v2
  (:require [cljs.test :as t] [kototama.execution-v2-test]))
(defmethod t/report [:cljs.test/default :end-run-tests] [result]
  (println (select-keys result [:test :pass :fail :error]))
  (when (or (zero? (:test result)) (pos? (+ (:fail result) (:error result))))
    (set! (.-exitCode js/process) 1)))
(t/run-tests 'kototama.execution-v2-test)
