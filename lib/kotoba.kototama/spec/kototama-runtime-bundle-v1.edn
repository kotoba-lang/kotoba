{:format :kototama.runtime-bundle/v1
 :artifacts [:component-cid :guest-cid :model-cid]
 :identity :bundle-id
 :admission [:publisher-signature :content-cid :runtime-abi :exact-capabilities]
 :lifecycle [:empty :staged :starting :ready :running :degraded :stopped]
 :failure {:scope :runtime :clear :volatile-workspace
           :preserve [:aiueos-kernel :network :device-identity]
           :kernel-reboot? false}
 :update {:class :blue-green :active-slot-write? false
          :switch-after [:runtime-admission :model-bind :murakumo-result]}
 :management {:commands [:status :restart-runtime]
              :root-shell? false}}
