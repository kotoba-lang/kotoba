{:schema :kototama.vm/spec-v1
 :name :kototama
 :version 1
 :status :normative
 :definition
 {:kind :content-addressed-abstract-machine
  :statement
  "Kototama is the deterministic Kotoba virtual-machine contract. Engines, hosts, bytecode interpreters and JITs implement Kototama; none of them defines it."
  :not [:consensus-protocol
        :compiler
        :ambient-host-api
        :grant-authority
        :evm-opcode-set
        :filecoin-network]
  :implementation-independent true}

 :stack-composition
 {:contract "https://github.com/kotoba-lang/kotoba-lang/blob/main/lang/stack-architecture.edn"
  :architecture-direction "https://github.com/kotoba-lang/kotoba-lang/blob/main/lang/stack-architecture-target-neutral.edn"
  :target-abi-defines-vm false
  :compiler-target-implies-vm-conformance false
  :runtime-transition-changed false
  :presentation-role :evm-like-vm-platform-contract
  :execution-platform-is-kototama true
  :system-presentation-owner :kototama
  :operating-system-owner :aiueos
  :engine-priority :none
  :native-wasm-is-a-profile-not-the-vm-definition true
  :support-requires-target-host-os-operation-and-effect-evidence true
  :evm-analogy-implies-ethereum-compatibility false
  :vm-requires-aiueos false
  :permission-decision-owner :grant
  :readiness-claim :none}

 :transition
 {:notation "K |- <program,message,state,authority,budget> => <outcome,state',events,receipt>"
  :inputs [:program :message :state :authority :budget]
  :outputs [:outcome :state :events :receipt]
  :success {:state :commit-overlay}
  :revert {:state :discard-overlay
           :outcome :value}
  :resource-exhaustion {:state :discard-overlay
                        :outcome :value
                        :must-not :uncatchable-host-trap}
  :storage-integrity-fault {:class :host-fault
                            :state :discard-overlay}
  :attempt-always-receipted true}

 :planes
 {:reduction
  {:language :closed-s-expression
   :semantics [:lexical-scope
               :immutable-persistent-values
               :structural-equality
               :explicit-continuations
               :bounded-recursion]
   :host-eval false
   :reflection false
   :ambient-ffi false}
  :state
  {:model :ipld-actor-world
   :identity :cid
   :mutation :message-local-overlay
   :nested-calls :snapshot-and-revert
   :transport :carv2
   :car-is-authority false}
  ;; root ADR-2610082200 (P2): the admission core is a closed predicate in
  ;; Kotoba Form, compiled by amu. No Datalog and no Biscuit in the core.
  :logic
  {:language :closed-s-expression-predicate
   :source "src/kototama/admission.kotoba"
   :compiled-by :amu
   :effects #{}
   :datalog false
   :user-rules false
   :recursion false
   :host-predicates false
   :provenance-required true
   :token-facts-may-impersonate-trusted-origins false}
  :authority
  {:grant-format :capability-chain
   :grant-encoding :ipld-s-expression-blocks
   :grant-meet :authority-chain-fold
   :allow-decision :local-authorizer-only
   :capability-materialization :successful-five-origin-join
   :raw-bearer-in-car false
   :raw-bearer-in-receipt false}
  :evidence
  {:artifact :ipld
   :receipt :ipld
   :archive :carv2
   :signature :executor
   :content-addressed true}}

 :program
 {:source-form :lisp-list
  :source-dialects [:kotoba :clojure :clojurescript]
  :canonical-form :tagged-dag-cbor-vector
  ;; The canonical top-level artifact contains closed expression data, not
  ;; engine bytecode, host function pointers, or a source-reader payload.
  :artifact-envelope
  {:tag "kototama.vm/program"
   :version 1
   :shape ["kototama.vm/program" 1 :program-map]
   :program-map {:field-keys :text
                 :entry :text-or-nil
                 :value-profile :text
                 :methods :method-map}
   :method-map {:keys :text
                :values :method-definition}
   :method-definition {:field-keys :text
                       :fields {"params" :text-vector
                                "param-types" :type-vector
                                "result" :type-tag
                                "effects" {:type :effect-vector
                                           :order :canonical-dag-cbor-byte-order}
                                "body" :expression}}
   :expression
   {:literal ["const" :portable-value]
    :variable ["var" :text]
    :let ["let" :binding-vector :expression]
    :loop ["loop" :binding-vector :expression]
    :recur ["recur" :expression-vector]
    :if ["if" :expression :expression :expression]
    :do ["do" :expression-vector]
    :call ["call" :text :expression-vector]
    :builtin ["builtin" :builtin-name :expression-vector]
    :arithmetic ["arith" :arithmetic-op :expression-vector]
    :compare ["compare" :comparison-op :expression-vector]
    :hash ["hash" :expression]
    :vector ["vector" :expression-vector]
    :list ["list" :expression-vector]
    :map ["map" :expression-pair-vector]
    :set ["set" :expression-vector]
    :get ["get" :expression :expression]
    :assoc ["assoc" :expression :expression :expression]
    :dissoc ["dissoc" :expression :expression]
    :match ["match" :expression :case-vector]
    :actor ["actor" :actor-operation :expression-vector]
    :state ["state" :state-operation :expression-vector]
    :authorize ["authorize" :expression-vector]
    :effect ["effect" :effect-operation :expression-vector]}
   :expression-values-are-data true
   :symbols-are-text-names true
   :portable-value-encoding
   {:integer ["integer" :canonical-decimal-text]
    :keyword ["keyword" :qualified-name]
    :symbol ["symbol" :qualified-name]
    :bytes ["bytes" :byte-vector]}
   :evaluation-order :left-to-right
   :branch-condition :zero-is-false
   :canonical-encoding :dag-cbor
   :content-identity :cid-of-canonical-dag-cbor
   :host-eval false
   :unknown-form :reject
   :unknown-builtin :reject
   :unknown-actor-operation :reject
   :unknown-state-operation :reject
   :unknown-field :reject
   :map-keys :canonical-dag-cbor-order}
  :value-profiles
  {"kotoba.i64-wrap/v1"
   {:integer :signed-64
    :add-sub-mul :twos-complement-wrap
    :division :signed-truncate-toward-zero
    :remainder :dividend-sign
    :division-by-zero :trap
    :signed-division-overflow :trap
    :comparison-result :integer-zero-or-one}}
  :macros :compile-time-only
  :symbols :compile-time-resolved
  :closures {:representation [:code-cid :environment]
             :environment :bounded-value-map}
  :instructions
  {:pure [:const :let :if :loop :recur :call :return
          :list :vector :map :set :get :assoc :dissoc :match
          :add :sub :mul :div :quot :mod :compare :hash]
   :actor [:self :caller :address :method :params :value
           :call :static-call :delegate-call :create :emit]
   :state [:root :open :read :write :link :stat :set-state]
   :logic [:authorize]
   :effect [:request-capability :invoke-capability]}}

 :values
  {:portable [:nil :boolean :integer :bytes :text :keyword
             :list :vector :map :set :cid :address :result]
  :integer {:core :arbitrary-precision-bounded-by-budget
            :evm-profile :unsigned-256-modular}
  :canonical-equality :value
  :canonical-order :dag-cbor-byte-order
  :host-object false}

 :message
 {:required [:chain-id :sender :recipient :method :params
             :value :nonce :fuel-limit :epoch]
  :optional [:intent :parent-receipt :profile]
  :identity :cid-of-canonical-message
  :nested-call-depth-bounded true}

 ;; root ADR-2610082200: a rule Form (integrity) is called with :validate and
 ;; holds no capability; a logic Form (coordinator) is called with :invoke.
 :call-kinds
 {:invoke {:form :logic-form
           :capabilities :admitted-by-eligibility}
  :validate {:form :rule-form
             :capabilities #{}
             :effects #{:abort}
             :inputs [:action :entry :cid-fetched-dependencies :author-chain-prefix]
             :outcomes [:valid :invalid :unresolved]
             :unresolved-is-not-invalid true}}

 :authority
 {:effective-capability
  [:intersection
   :amu-static-effect
   :vm-requested-intent
   :capability-chain-delegated-grant
   :local-policy-allow
   :runtime-availability]
 :trusted-origins
  {:amu ["amu:requires" "amu:world"]
   :vm ["vm:runs" "vm:requests"]
   :grant ["grant:right"]
   :policy ["policy:allows"]
   :runtime ["runtime:world" "runtime:available"]}
  ;; Each origin is resolved by its owner into a closed set of keys before
  ;; admission; the core only intersects them. grant:right is the meet over the
  ;; capability chain (kotoba-lang/authority authority.chain/fold, dango blocks).
  :eligibility
  {:source "src/kototama/admission.kotoba"
   :entry eligible?
   :language :kotoba-form
   :compiled-by :amu
   :effects #{}
   :all-of [["catalog" ?kind]
            ["amu:requires" ?definition ?kind]
            ["amu:world" ?definition ?world]
            ["vm:requests" ?actor ?kind ?resource]
            ["grant:right" ?actor ?kind ?resource]
            ["policy:allows" ?actor ?kind ?resource]
            ["runtime:world" ?world]
            ["runtime:available" ?kind ?resource]]
   :evaluation :conjunction-of-closed-set-membership
   ;; payload-v2 DefCID of eligible?, measured with the module linked against
   ;; its dependencies (`kotoba -M check --source-path`, amu a1da8afee +
   ;; kotoba-lang/amu#1253). The same source checked as a single file answered
   ;; bafyreieoadznepkgmaojyzo6q24pvdv5golsy56pvxuzzbw5h4xwurjvla on 2026-10-09:
   ;; the two modes disagree, which is an amu question, not a change here. Since
   ;; admission.kotoba now requires authority.*, only the linked mode applies.
   :definition-cid-at-adoption "bafyreif5rsipgosiqz24l6y3nnmjqua2mhzd3bhkr4myb5txkxaqkoehzu"
   ;; admit: the grant origin resolved from the presented delegation chain by
   ;; authority.delegation/authorize (kotoba-lang/authority, pure Kotoba), the
   ;; cap mapped to a scope by dango.chain/cap->scope's rule
   ;; ("ns/name" + "scheme://path" -> "ns://name/scheme/path").
   :admit {:entry admit
           :grant-origin :authority.delegation/authorize
           :cap-scope :dango.chain/cap->scope
           :order [:catalog :amu-effect :world :vm-intent :cap-scope :chain :policy :runtime]
           :reasons {1 :admitted
                     2 :escalation-attempted 3 :empty-chain 4 :expired-or-no-trusted-time
                     5 :wrong-holder 6 :out-of-scope 7 :malformed-chain
                     10 :not-in-catalog 11 :effect-not-declared 12 :world-mismatch
                     13 :not-requested 14 :policy-denies 15 :unavailable
                     16 :cap-not-a-scope}
           :definition-cid-at-adoption "bafyreihu2ow6mzc4bdan422sojcvg5mfdf5pd4juvc43unvaoy2ieos7ca"}}
  ;; Lifted out of the core (root ADR-2610082200). None of these may decide
  ;; admission; each only produces one of the origin sets above or a chain.
  :lifted
  {:biscuit {:where :authn-boundary-adapter
             :transcodes-to :capability-chain}
   :ucan {:where :authn-boundary-adapter
          :transcodes-to :capability-chain}
   :datalog {:where [:logic-form-query-library
                     :policy-authoring-language]
             :output :policy-allow-set
             :rule-form-use :bounded-over-cid-fixed-facts-only}}
  :missing-origin :deny
  :unknown-effect :deny
  :revocation :runtime-check
  :capability {:kind :invocation-local-unforgeable-value
               :serializable false}}

 :state
 {:world-root :cid
  :actor-record [:address :code-cid :state-cid :nonce :balance]
  :code :content-addressed
  :read :verify-cid-before-decode
  :write :canonical-bytes-before-cid
  :commit :atomic-root-replacement
  :revert :original-world-root}

 :receipt
 {:schema :kototama.vm/receipt-v1
  :required [:machine-spec
             :implementation
             :profile
             :message-cid
             :program-cid
             :state-before
             :state-after
             :outcome
             :fuel-used
             :events
             :authority-decision]
  :authority-decision [:manifest-cid :grant-ids :policy-id :world :epoch]
  :optional [:return :revert-data :parent-receipt :child-receipts]
  :forbidden [:raw-bearer-token :raw-biscuit :private-key :ambient-host-handle]
  :failed-attempts-included true}

 :profiles
 {:core/v1
  {:purpose :canonical-kotoba-execution
   :requires [:closed-s-expression
              :ipld-state
              :closed-admission-predicate
              :five-origin-authority
              :deterministic-receipt]
   :does-not-require [:wasm :jvm :evm-bytecode :filecoin-protocol]}

  :fvm-actor/v1
  {:purpose :fvm-shaped-actor-compatibility
   :pins [:fvm-network-version :actor-abi-version :gas-schedule]
   :requires [:actor-address
              :numeric-method
              :ipld-blockstore
              :actor-state-root
              :send
              :exit-code
              :gas-accounting
              :message-overlay]
   :levels [:message :actor-abi :state]
   :does-not-imply [:filecoin-consensus :proof-of-replication :proof-of-spacetime]}

  :evm/v1
  {:purpose :ethereum-virtual-machine-compatibility
   :pins [:chain-spec :hardfork :gas-schedule :precompile-set]
   :requires [:u256
              :twenty-byte-address
              :calldata-returndata
              :stack-depth-1024
              :byte-addressed-memory
              :separate-code
              :account-code-storage-nonce-balance
              :call-staticcall-delegatecall
              :create-create2
              :return-revert
              :logs
              :keccak256]
   :levels
   {:message [:transaction-and-abi-projection]
    :semantic [:observable-result :state-delta :logs :gas]
    :bytecode [:accepts-valid-evm-bytecode]
    :state [:canonical-ethereum-receipt :trie-root]}}

  :fevm/v1
  {:purpose :evm-over-fvm-actor-compatibility
   :composes [{:profile :fvm-actor/v1
               :levels [:message :actor-abi :state]}
              {:profile :evm/v1
               :levels [:message :bytecode]}]
   :pins [:filecoin-network-version
          :fevm-actor-version
          :ethereum-hardfork
          :gas-mapping
          :precompile-set]
   :requires [:delegated-address-mapping
              :ethereum-address-manager
              :evm-calldata-in-fvm-message
              :fvm-exit-to-evm-status
              :event-log-mapping
              :ethereum-json-rpc
              :system-actor-boundary
              :documented-ethereum-divergences]
   :gas {:meter :filecoin
         :ethereum-gas-equality false
         :mapping-version-required true}}}

 :compatibility
 {:claim-must-name [:profile :level :version :implementation :evidence]
  :floating-evm-claim-forbidden true
  :floating-fvm-claim-forbidden true
  :differential-tests-required [:semantic :bytecode :state]
  :reference-vectors-content-addressed true
  :core-is-not-automatically-evm-compatible true
  :core-is-not-automatically-fvm-compatible true}

 :conformance
 {:implementation-declaration-schema :kototama.vm/implementation-profile-v1
  :implementation-declaration
  {:required [:spec :implementation :profiles :non-claims]
   ;; shape pinned 2026-09-08 (seq-9 tightening): :profiles MUST be a
   ;; profile-keyed map (one :evm/v1 :fevm/v1 etc. key, no duplicate
   ;; entries possible), :spec MUST be a spec-reference map naming the
   ;; schema + version + repository. Both wild vector/keyword shapes
   ;; observed in the past are now non-conformant.
   :profiles-shape :keyed-map
   :spec-shape :reference-map
   :profile-required [:status :omissions]
   :evidence-required-for [:conformant :partial :shape-only]
   :statuses [:conformant :partial :shape-only :not-implemented]
   :empty-levels-required-for [:shape-only :not-implemented]}
  :required-suites [:transition
                    :determinism
                    :fuel
                    :overlay-revert
                    :ipld-integrity
                    :authority-provenance
                    :receipt]
  :profile-suites
  {:fvm-actor/v1 [:fvm-message-vectors :actor-abi-vectors]
   :evm/v1 [:ethereum-general-state-tests :differential-execution]
   :fevm/v1 [:fevm-message-vectors :fvm-evm-differential-execution]}
  :partial-conformance-must-list-omissions true}}
