{;; the common organism/cell library lives in ../lib (lib/kototama/*.cljc, the
 ;; runtime's portable lib); this clj subtree adds the UNSPSC fleet on top.
 :paths ["src" "resources" "../lib"]
 ;; UNSPSC organism actors on the Clojure substrate:
 ;;   langgraph  — StateGraph orchestration (the agent graph)
 ;;   langchain  — model adapter (Murakumo), Datomic-shaped EAV + kotoba_db backend
 ;; Workspace-local roots. This clj subtree lives at orgs/kotoba-lang/kototama/clj;
 ;; the clj libs are siblings of kototama under orgs/kotoba-lang/ (../../<lib>).
 ;; The langchain :local/root overrides langgraph's transitive git dep so the
 ;; whole stack resolves offline against the local checkouts.
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "72dde04b4c32854d70d17a670b277f8f7957a784"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph {:local/root "../../langgraph"}
        io.github.kotoba-lang/langchain {:local/root "../../langchain"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      ;; kototama.unspsc.prior-shortcut-kotoba (+ its test)
                      ;; hosts resources/prior_shortcut.wasm via a real
                      ;; Chicory Instance -- kept out of the main :deps
                      ;; (same isolation pattern langchain.jvm/
                      ;; langchain.kotobase-persist use for optional
                      ;; backends) so requiring kototama.unspsc.life or
                      ;; .organism never forces Chicory on a consumer that
                      ;; doesn't want the WASM-backed variant.
                      com.dylibso.chicory/wasm {:mvn/version "1.4.0"}
                      com.dylibso.chicory/runtime {:mvn/version "1.4.0"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; taxonomy EDN builder (kbb -M:or clojure): joins the UNSPSC registry + enrichment
  :build-taxonomy {:extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}
                   :main-opts ["-m" "kototama.unspsc.build-taxonomy"]}
  ;; Phase 2 enrichment: dump codes needing spec, merge generated overlays
  :enrich {:extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}
           :main-opts ["-m" "kototama.unspsc.enrich"]}
  ;; Phase 3: full-fleet sweep on one kotoba-Datom log
  :fleet {:main-opts ["-m" "kototama.unspsc.fleet"]}}}
