#!/usr/bin/env bash
set -euo pipefail

CONFIG="${KOTOTAMA_AUTHORITY_CONFIG:-/etc/kototama/component-authority.edn}"
HOME_DIR="${KOTOTAMA_HOME:-/opt/kototama}"

if [[ "${1:-}" == "--help" ]]; then
  echo "usage: kototama-authority-daemon [CONFIG.edn]"
  exit 0
fi
if [[ $# -gt 1 ]]; then
  echo "usage: kototama-authority-daemon [CONFIG.edn]" >&2
  exit 2
fi
if [[ $# -eq 1 ]]; then CONFIG="$1"; fi
if [[ ! -r "$CONFIG" ]]; then
  echo "kototama-authority-daemon: unreadable config: $CONFIG" >&2
  exit 2
fi

cd "$HOME_DIR"
exec kbb -M:authority-daemon "$CONFIG"
