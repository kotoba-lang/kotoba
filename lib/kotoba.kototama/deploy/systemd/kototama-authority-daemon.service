[Unit]
Description=Kototama signed Component authority receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=KOTOTAMA_HOME=/opt/kototama
Environment=KOTOTAMA_AUTHORITY_CONFIG=/etc/kototama/component-authority.edn
EnvironmentFile=-/etc/kototama/component-authority.secret
WorkingDirectory=${KOTOTAMA_HOME}
ExecStart=/usr/local/bin/kototama-authority-daemon
Restart=on-failure
RestartSec=2
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/etc/kototama

[Install]
WantedBy=multi-user.target
