{:paths ["src" "test" "lib"]
 ;; kototama.tender (ADR-2607022400 names the "tender" ROLE; ADR-2607022900
 ;; separately decided THIS implementation of that role is JVM/Clojure via
 ;; Chicory, not Rust/wasmtime -- other tenders in other host languages
 ;; exist, e.g. aiueos's own JVM-FFM ADR-0014 hvt-tender) is the only
 ;; namespace here needing real deps -- kototama.contract and lib/* stay
 ;; zero-dep/portable.
 :deps {
        io.github.kotoba-lang/artifact {:local/root "../kotoba.artifact"}
        io.github.kotoba-lang/kotoba-verifier {:local/root "../kotoba.kotobaVerifier"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/process {:local/root "../kotoba.process"}
        io.github.kotoba-lang/pprint {:local/root "../kotoba.pprint"}
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/authority {:local/root "../kotoba.authority"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/org-ietf-ed25519 {:local/root "../org.ietf.ed25519"}
        io.github.kotoba-lang/json {:local/root "../kotoba.json"}
        io.github.kotoba-lang/security {:local/root "../kotoba.security"}
        io.github.kotoba-lang/kotoba-core-contracts
        {:git/url "https://github.com/kotoba-lang/kotoba-core-contracts.git"
         :git/sha "00cfa8e29aaa3408e6594c6a55fd46867acc8bfd"}
        io.github.kotoba-lang/abi {:git/url "https://github.com/kotoba-lang/abi.git"
                                   :git/sha "4e67b6fabc9e8584cb127fdb71b3fc47e2eadc59"}
        io.github.kotoba-lang/io-multiformats {:local/root "../kotoba.ioMultiformats"}
        io.github.kotoba-lang/grant {:local/root "../kotoba.grant"}
        io.github.kotoba-lang/kotoba-vm {:local/root "../kotoba.kotobaVm"}}
 :aliases
 {
  ;; ADR-2607266000 Phase B: the PostgreSQL pool is a Chicory-tender plugin,
  ;; not part of the runtime core. It lives in kotoba-lang/provider-postgres
  ;; and its interop harness went with it. A deployment that wants it adds
  ;; that dependency itself; the tender does not ship a database pool.
  :postgresql-interop
  {:extra-deps {io.github.kotoba-lang/kotoba {:local/root "../kotoba"}
                io.github.kotoba-lang/amu {:local/root "../amu"}
                io.github.kotoba-lang/kotoba-core-contracts
                {:local/root "../kotoba-core-contracts"}
                io.github.kotoba-lang/kotoba-lang {:local/root "../kotoba-lang"}}
   :main-opts ["-m" "kototama.postgresql-interop"]}

  :test {:extra-paths ["test"]
         :extra-deps {
                      io.github.kotoba-lang/kotoba
                      {:local/root "../kotoba"}
                      ;; The repo was renamed `compiler` -> `amu` (2026-08-10).
                      ;; The coordinate now says `amu` too. It used to say
                      ;; `compiler` on purpose, because sibling `kotoba`
                      ;; declared that coordinate transitively and an override
                      ;; only wins when the key matches -- but `kotoba` main
                      ;; now declares `io.github.kotoba-lang/amu`, so holding
                      ;; the legacy key here stopped overriding anything and
                      ;; started putting two copies of the same repository on
                      ;; one classpath. `../amu` is unchanged; `../compiler`
                      ;; is not in west.yml at all.
                      io.github.kotoba-lang/amu
                      {:local/root "../amu"}
                      io.github.kotoba-lang/kotoba-core-contracts
                      {:local/root "../kotoba-core-contracts"}
                      io.github.kotoba-lang/kotoba-lang
                      {:local/root "../kotoba-lang"}}
         ;; A sibling kotoba checkout may itself pin an unpublished
         ;; kotoba-lang commit.  extra-deps does not reliably win that
         ;; transitive coordinate; the workspace test profile must.
         :override-deps {io.github.kotoba-lang/kotoba-lang
                         {:local/root "../kotoba-lang"}
                         io.github.kotoba-lang/kotoba-core-contracts
                         {:local/root "../kotoba-core-contracts"}
                         io.github.kotoba-lang/kotoba-selfhost-contracts
                         {:local/root "../kotoba-selfhost-contracts"}
                         io.github.kotoba-lang/org-chainagnostic-cacao
                         {:local/root "../org-chainagnostic-cacao"}
                         io.github.kotoba-lang/datom
                         {:local/root "../datom"}
                         io.github.kotoba-lang/org-w3-did
                         {:local/root "../org-w3-did"}}}
       ;; T3 hosts — extra-deps, not core. Product name is kototama
       ;; (ADR-2608139980). Old GitHub names tender-* still redirect.
       :native-host
       {:extra-deps {io.github.kotoba-lang/kototama-native
                     {:git/url "https://github.com/kotoba-lang/kototama-native.git"
                      :git/sha "e52b41a68481033f40a511185e3347633612169a"}}}
       :component-host
       {:extra-deps {io.github.kotoba-lang/kototama-component
                     {:git/url "https://github.com/kotoba-lang/kototama-component.git"
                      :git/sha "168243580797987e71a310792fe98a86e6eed675"}}}}}
