;; Test-only scoped FS2 consumer. No production host or admission claim.
(ns kototama.pure-i64-receipt-fs-gate
  (:export [main])
  (:capabilities [:fs/app-data :cli/args])
  (:require [kototama.pure-i64-receipt :as r]))
(defn- number [value :string] :i64
  (let [parsed (string-parse-i64 value)]
    (if (result-ok?-of [:result :i64 :keyword] parsed)
      (result-value-of [:result :i64 :keyword] parsed -1)
      -1)))
(defn main [] :i64
  (let [path (typed-cap-call :cli/args :string :string "0")
        exit (number (typed-cap-call :cli/args :string :string "1"))
        budget (number (typed-cap-call :cli/args :string :string "2"))
        stack (number (typed-cap-call :cli/args :string :string "3"))
        chunks (typed-cap-call :fs/app-data :string [:list :bytes]
                 (string-concat "\u0000FS2\u0000A" (string-concat path "\u0000")))]
    (if (not= (vector-count chunks) 1) 0
      (let [reply (vector-i64-from-bytes (typed-list-nth [:list :bytes] chunks 0))]
        (if (not (and (= (vector-count reply) 69)
                      (= (vector-at reply 0) 0) (= (vector-at reply 1) 70)
                      (= (vector-at reply 2) 83) (= (vector-at reply 3) 50)
                      (= (vector-at reply 4) 0))) 0
          (let [data (loop [i 0 out (vector-alloc 64)]
                       (if (= i 64) out
                         (recur (inc i) (vector-assoc! out i (vector-at reply (+ i 5))))))]
            (if (r/valid? data exit budget stack) 1 0)))))))
