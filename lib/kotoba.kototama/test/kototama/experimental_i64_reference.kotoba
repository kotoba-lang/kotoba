(ns reference (:export [evaluate]))
;; Experimental expression evaluator for trusted, pre-decoded test trees.
;; Node stride: tag, a, b, literal/else-index. Tags: 0 const; 1 add;
;; 2 quotient; 3 if (a condition, b true branch, final field false branch);
;; 4 subtraction; 5 multiplication; 6 signed remainder; 7/8 do; 10 unary
;; negation; 11/12/13 uncharged synthetic add/subtract/multiply folds;
;; 14 comparison and 15 a non-executed comparison-operand link;
;; 16 lexical variable; 17 let; 18 a binding link; 19 loop; 20 recur;
;; 21 a recur-argument link. Links are metadata and are not executed.
;; Return [status value spent]: 0 success; 1 exhaustion; 2 divide-by-zero;
;; 3 signed overflow; 4 malformed/unsupported or frame limit. Not admission.
(defn- result [status :i64 value :i64 spent :i64] :vector-i64
  (vector-conj (vector-conj (vector-conj (vector-alloc 0) status) value) spent))
(defn- compare-pair [op :i64 a :i64 b :i64] :bool
 (cond (= op 0) (= a b) (= op 1) (< a b) (= op 2) (> a b)
       (= op 3) (<= a b) (= op 4) (>= a b) :else false))
;; Each active control frame has 16 private temporary slots so loop/recur
;; operands are all evaluated before their lexical slots are overwritten.
(defn- find-loop [frames :vector-i64 nodes :vector-i64 i :i64] :i64
 (if (< i 0) -1
  (let [node (vector-at frames (* i 5))]
   (if (= (vector-at nodes (* node 4)) 19) i (find-loop frames nodes (- i 1))))))
(defn- install [frames :vector-i64 nodes :vector-i64 link :i64 temp-base :i64 i :i64] :vector-i64
 (if (= link -1) frames
  (let [base (* link 4) slot (vector-at nodes (+ base 3)) next (vector-at nodes (+ base 2))]
   (if (or (< slot 0) (>= slot 64) (>= i 16)) frames
    (install (vector-assoc! frames (+ 320 slot) (vector-at frames (+ temp-base i))) nodes next temp-base (+ i 1))))))
(defn evaluate [nodes :vector-i64 budget :i64] :vector-i64
  (if (or (< budget 0) (> budget 9007199254740991)
          (= (vector-count nodes) 0) (not= (rem (vector-count nodes) 4) 0))
    (result 4 0 0)
    (loop [frames (vector-alloc 1408) top 0 spent 0 value 0 returning false]
      (if returning
        (if (= top -1) (result 0 value spent)
          (let [base (* top 5) phase (vector-at frames (+ base 1))
                node (vector-at frames base) op (vector-at nodes (* node 4))]
            (if (= phase 7)
              (recur frames (- top 1) spent value true)
            (if (or (= phase 6) (= phase 8))
              (let [link (vector-at frames (+ base 3)) lb (* link 4)
                    following (vector-at nodes (+ lb 2)) index (vector-at frames (+ base 2))
                    temp-base (+ 384 (* top 16))]
                (if (or (>= index 16) (>= top 63)) (result 4 0 spent)
                 (let [saved (vector-assoc! frames (+ temp-base index) value)]
                  (if (not= following -1)
                   (let [next (-> saved (vector-assoc! (+ base 2) (+ index 1)) (vector-assoc! (+ base 3) following))
                         child (vector-at nodes (+ (* following 4) 1))]
                    (recur (vector-assoc! next (+ base 5) child) (+ top 1) spent 0 false))
                   (let [target (if (= phase 6) top (find-loop frames nodes (- top 1)))]
                    (if (< target 0) (result 4 0 spent)
                     (let [root-link (vector-at nodes (+ (* node 4) 1))
                           applied (install saved nodes root-link temp-base 0)
                           target-base (* target 5) loop-node (vector-at applied target-base)
                           body (vector-at nodes (+ (* loop-node 4) 2))
                           next (vector-assoc! applied (+ target-base 1) 7)]
                      (recur (vector-assoc! next (+ target-base 5) body) (+ target 1) spent 0 false))))))))
            (if (= phase 5)
              (let [link (vector-at frames (+ base 3)) lb (* link 4)
                    slot (vector-at nodes (+ lb 3)) following (vector-at nodes (+ lb 2))]
                (if (or (< slot 0) (>= slot 64) (>= top 63)) (result 4 0 spent)
                  (let [saved (vector-assoc! frames (+ 320 slot) value)
                        child (if (= following -1) (vector-at nodes (+ (* node 4) 2))
                                (vector-at nodes (+ (* following 4) 1)))
                        next (-> saved (vector-assoc! (+ base 1) (if (= following -1) 3 5))
                                 (vector-assoc! (+ base 3) following))]
                    (recur (vector-assoc! next (+ base 5) child) (+ top 1) spent 0 false))))
            (if (= phase 4)
              (let [prev (vector-at frames (+ base 2)) next-link (vector-at frames (+ base 3))
                    good (and (= (vector-at frames (+ base 4)) 1)
                              (compare-pair (vector-at nodes (+ (* node 4) 3)) prev value))]
                (if (= next-link -1) (recur frames (- top 1) spent (if good 1 0) true)
                  (if (>= top 63) (result 4 0 spent)
                    (let [link-base (* next-link 4) child (vector-at nodes (+ link-base 1))
                          link-after (vector-at nodes (+ link-base 2))
                          next (-> frames (vector-assoc! (+ base 2) value)
                                   (vector-assoc! (+ base 3) link-after)
                                   (vector-assoc! (+ base 4) (if good 1 0)))]
                      (recur (vector-assoc! next (+ base 5) child) (+ top 1) spent 0 false)))))
            (if (and (= phase 1) (= op 14))
              (if (>= top 63) (result 4 0 spent)
                (let [link (vector-at nodes (+ (* node 4) 2)) link-base (* link 4)
                      child (vector-at nodes (+ link-base 1)) link-after (vector-at nodes (+ link-base 2))
                      next (-> frames (vector-assoc! (+ base 1) 4) (vector-assoc! (+ base 2) value)
                               (vector-assoc! (+ base 3) link-after) (vector-assoc! (+ base 4) 1))]
                  (recur (vector-assoc! next (+ base 5) child) (+ top 1) spent 0 false)))
            (if (= phase 3)
              (recur frames (- top 1) spent value true)
              (if (and (= phase 1) (= op 10))
                (recur frames (- top 1) spent (- 0 value) true)
              (if (and (= phase 1) (or (= op 7) (= op 8)))
                (let [next-child (vector-at nodes (+ (* node 4) 2))]
                  (if (= next-child -1) (recur frames (- top 1) spent value true)
                    (if (>= top 63) (result 4 0 spent)
                      (recur (vector-assoc! (vector-assoc! frames (+ base 1) 3) (+ base 5) next-child)
                             (+ top 1) spent 0 false))))
              (if (and (= phase 1) (= op 3))
                (let [next (vector-assoc! frames (+ base 1) 3)
                      child (vector-at nodes (+ (* node 4) (if (= value 0) 3 2)))]
                  (if (>= top 63) (result 4 0 spent)
                    (recur (vector-assoc! next (+ base 5) child) (+ top 1) spent 0 false)))
                (if (= phase 1)
              (let [saved (vector-assoc! frames (+ base 2) value)
                    next (vector-assoc! saved (+ base 1) 2)
                    child (vector-at nodes (+ (* node 4) 2))]
                (if (>= top 63) (result 4 0 spent)
                  (recur (vector-assoc! next (+ base 5) child) (+ top 1) spent 0 false)))
              (let [left (vector-at frames (+ base 2))]
                (cond
                  (or (= op 1) (= op 11)) (recur frames (- top 1) spent (+ left value) true)
                  (or (= op 4) (= op 12)) (recur frames (- top 1) spent (- left value) true)
                  (or (= op 5) (= op 13)) (recur frames (- top 1) spent (* left value) true)
                  (= op 6) (cond (= value 0) (result 2 0 spent)
                                 (and (= left -9223372036854775808) (= value -1))
                                   (recur frames (- top 1) spent 0 true)
                                 :else (recur frames (- top 1) spent (rem left value) true))
                  (= op 2) (cond (= value 0) (result 2 0 spent)
                                 (and (= left -9223372036854775808) (= value -1)) (result 3 0 spent)
                                 :else (recur frames (- top 1) spent (quot left value) true))
                  :else (result 4 0 spent)))))))))))))))
        (let [base (* top 5) node (vector-at frames base)]
          (if (or (< node 0) (>= node (quot (vector-count nodes) 4)))
            (result 4 0 spent)
            (let [idx (* node 4) op (vector-at nodes idx) spent2 (if (or (= op 8) (= op 11) (= op 12) (= op 13)) spent (+ spent 1))]
              (if (> spent2 budget) (result 1 0 spent2)
                (cond (= op 0) (recur frames (- top 1) spent2 (vector-at nodes (+ idx 3)) true)
                      (= op 16) (let [slot (vector-at nodes (+ idx 3))]
                                   (if (or (< slot 0) (>= slot 64)) (result 4 0 spent2)
                                     (recur frames (- top 1) spent2 (vector-at frames (+ 320 slot)) true)))
                      (= op 19) (if (>= top 63) (result 4 0 spent2)
                                  (let [link (vector-at nodes (+ idx 1))
                                        child (if (= link -1) (vector-at nodes (+ idx 2))
                                                (vector-at nodes (+ (* link 4) 1)))
                                        next (-> frames (vector-assoc! (+ base 1) (if (= link -1) 7 6))
                                                 (vector-assoc! (+ base 2) 0) (vector-assoc! (+ base 3) link))]
                                    (recur (vector-assoc! next (+ base 5) child) (+ top 1) spent2 0 false)))
                      (= op 20) (let [link (vector-at nodes (+ idx 1))]
                                  (if (= link -1)
                                   (let [target (find-loop frames nodes (- top 1))]
                                    (if (or (< target 0) (>= target 63)) (result 4 0 spent2)
                                     (let [tb (* target 5) loop-node (vector-at frames tb)
                                           body (vector-at nodes (+ (* loop-node 4) 2))]
                                      (recur (vector-assoc! (vector-assoc! frames (+ tb 1) 7) (+ tb 5) body)
                                             (+ target 1) spent2 0 false))))
                                   (if (>= top 63) (result 4 0 spent2)
                                    (let [child (vector-at nodes (+ (* link 4) 1))
                                          next (-> frames (vector-assoc! (+ base 1) 8) (vector-assoc! (+ base 2) 0)
                                                   (vector-assoc! (+ base 3) link))]
                                     (recur (vector-assoc! next (+ base 5) child) (+ top 1) spent2 0 false)))))
                      (= op 17) (if (>= top 63) (result 4 0 spent2)
                                  (let [link (vector-at nodes (+ idx 1))
                                        child (if (= link -1) (vector-at nodes (+ idx 2))
                                                (vector-at nodes (+ (* link 4) 1)))
                                        next (-> frames (vector-assoc! (+ base 1) (if (= link -1) 3 5))
                                                 (vector-assoc! (+ base 3) link))]
                                    (recur (vector-assoc! next (+ base 5) child) (+ top 1) spent2 0 false)))
                      (or (= op 1) (= op 2) (= op 3) (= op 4) (= op 5) (= op 6) (= op 7) (= op 8) (= op 10) (= op 11) (= op 12) (= op 13) (= op 14))
                      (if (>= top 63) (result 4 0 spent2)
                        (let [next (vector-assoc! frames (+ base 1) 1)
                              child (vector-at nodes (+ idx 1))]
                          (recur (vector-assoc! next (+ base 5) child) (+ top 1) spent2 0 false)))
                      :else (result 4 0 spent2))))))))))
