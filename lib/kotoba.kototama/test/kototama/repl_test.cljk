(ns kototama.repl-test
  "D3 REPL: typed eval の上の対話ループ。host-eval と reflection の入力は拒否、
  変更操作は rebind のみ、実行は注入 eval-fn に委ね、attempt は history に残る。"
  (:require [kotoba.test :refer [deftest is testing]]
            [kototama.repl :as repl]))

(def eval-cmd
  {:repl/op :eval
   :repl/defcid "bafyreigprogram0000000000000000000000000000000000000"
   :repl/admission-cid "bafyreigadmission0000000000000000000000000000000000"
   :repl/input 7})

(def rebind-cmd
  {:repl/op :rebind
   :repl/slot :main
   :repl/old-defcid "bafyreigmain000000000000000000000000000000000000000"
   :repl/new-defcid "bafyreigmain111111111111111111111111111111111111111"})

(def eval-fn
  (fn [{:keys [defcid input]}]
    {:outcome :success :value (str defcid ":" input) :receipt {:fuel-used 1}}))

(deftest eval-delegates-to-the-host-and-records-the-attempt
  (let [s (repl/init {:main (:repl/old-defcid rebind-cmd)})
        r (repl/step s eval-cmd {:eval-fn eval-fn})]
    (is (true? (:ok? r)))
    (is (= (str (:repl/defcid eval-cmd) ":7")
           (get-in r [:output :result :value]))
        "the loop never evaluates anything itself: the injected host does")
    (testing "the attempt is recorded (attempt-always-receipted)"
      (is (= 1 (count (-> r :state :history))))
      (is (true? (-> r :state :history first :repl/ok?))))
    (testing "evaluation does not change the code environment"
      (is (= (:code-environment s) (-> r :state :code-environment))))))

(deftest typed-eval-requires-both-pins
  (doseq [[why cmd] [[:no-defcid (dissoc eval-cmd :repl/defcid)]
                     [:no-admission-cid (dissoc eval-cmd :repl/admission-cid)]]]
    (testing (str why)
      (let [r (repl/step (repl/init) cmd {:eval-fn eval-fn})]
        (is (false? (:ok? r)))
        (is (some #(= why (:problem %)) (-> r :output :refused)))
        (testing "a refused attempt is still recorded"
          (is (= 1 (count (-> r :state :history)))))))))

(deftest host-eval-and-reflection-are-refused
  (testing "eval-source is refused as :no-host-eval, not merely as some refusal"
    (let [r (repl/step (repl/init) {:repl/op :eval-source :repl/source "(+ 1 2)"}
                       {:eval-fn eval-fn})]
      (is (false? (:ok? r)))
      (is (some #(= :no-host-eval (:problem %)) (-> r :output :refused))
          "the literal reason is pinned: a catch-all refusal is not this test")))
  (testing "reflection is refused as :no-reflection"
    (let [r (repl/step (repl/init) {:repl/op :reflection :repl/target :heap}
                       {:eval-fn eval-fn})]
      (is (false? (:ok? r)))
      (is (some #(= :no-reflection (:problem %)) (-> r :output :refused))))))

(deftest rebind-is-the-only-mutating-op
  (let [s (repl/init {:main (:repl/old-defcid rebind-cmd)
                      :util "bafyreigutil00000000000000000000000000000000000000"})
        r (repl/step s rebind-cmd {:eval-fn eval-fn})]
    (is (true? (:ok? r)))
    (is (= (:repl/new-defcid rebind-cmd) (get-in r [:state :code-environment :main])))
    (is (= (-> s :code-environment :util) (get-in r [:state :code-environment :util]))
        "only the named slot moves")
    (testing "the rebind receipt comes from kototama.rebind (D4), not from the loop"
      (is (= :rebound (get-in r [:output :receipt :rebind/outcome]))))
    (testing "a failed rebind refuses and records"
      (let [bad (assoc rebind-cmd :repl/old-defcid "bafyreinotthecurrentbinding00000000000000000000000000")
            r2 (repl/step (:state r) bad {:eval-fn eval-fn})]
        (is (false? (:ok? r2)))
        (is (= [:binding-mismatch] (-> r2 :output :refused)))))))

(deftest unknown-ops-do-not-slip-through
  (let [r (repl/step (repl/init) {:repl/op :peek-at-heap} {:eval-fn eval-fn})]
    (is (false? (:ok? r)))
    (is (some #(= :unknown-op (:problem %)) (-> r :output :refused)))))

(deftest without-an-eval-host-eval-refuses
  (let [r (repl/step (repl/init) eval-cmd {})]
    (is (false? (:ok? r)))
    (is (= [:no-eval-host] (-> r :output :refused)))))
