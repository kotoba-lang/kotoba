(ns gate (:export [main]) (:require [reference :as r]))
(defn- is [x :vector-i64 status :i64 value :i64 spent :i64] :bool
  (and (= (vector-at x 0) status) (= (vector-at x 1) value) (= (vector-at x 2) spent)))
(defn- order [nodes :vector-i64 status :i64] :bool
 (loop [b 0] (if (= b 6) true
  (and (is (r/evaluate nodes b) (if (< b 4) 1 status) 0 (if (< b 4) (+ b 1) 4))
       (recur (+ b 1))))))
(defn main [] :i64
 (if (and
  (is (r/evaluate [0 0 0 42] 1) 0 42 1)
  (is (r/evaluate [0 0 0 42] 0) 1 0 1)
  (is (r/evaluate [1 1 2 0 0 0 0 20 0 0 0 22] 3) 0 42 3)
  (is (r/evaluate [1 1 2 0 0 0 0 9223372036854775807 0 0 0 1] 3) 0 -9223372036854775808 3)
  (is (r/evaluate [2 1 2 0 0 0 0 -85 0 0 0 2] 3) 0 -42 3)
  (is (r/evaluate [2 1 2 0 0 0 0 1 0 0 0 0] 3) 2 0 3)
  (is (r/evaluate [2 1 2 0 0 0 0 -9223372036854775808 0 0 0 -1] 3) 3 0 3)
  (is (r/evaluate [2 1 2 0 0 0 0 1 0 0 0 0] 2) 1 0 3)
  (is (r/evaluate [9 0 0 0] 2) 4 0 1)
  (order [1 1 4 0 2 2 3 0 0 0 0 1 0 0 0 0 2 5 6 0 0 0 0 -9223372036854775808 0 0 0 -1] 2)
  (order [1 1 4 0 2 2 3 0 0 0 0 -9223372036854775808 0 0 0 -1 2 5 6 0 0 0 0 1 0 0 0 0] 3)) 42 0))
