;; The exact retained oversized CBOR input, constructed in a single allocation.
;; Amu input SHA-256: 15668e63c7c894a87a3db550b830ffc3b2fc635e432bec76deff176684234308
(ns comparison (:export [main]) (:require [bridge :as b] [reference :as r]))
(defn- build [prefix :vector-i64] :vector-i64
 (loop [data (vector-alloc 65694) i 0]
  (if (= i (vector-count prefix)) data
   (recur (vector-assoc! data i (vector-at prefix i)) (+ i 1)))))
(defn- exact? [data :vector-i64 prefix :vector-i64] :bool
 (and (= (vector-count data) 65694) (= (vector-count prefix) 158)
  (loop [i 0]
   (if (= i 65694) true
    (and (= (vector-at data i) (if (< i 158) (vector-at prefix i) 0))
         (recur (+ i 1)))))))
(defn main [] :i64
 (let [prefix (into (into (into [131 115 107 111 116 111 116 97 109 97 46 118 109 47 112 114 111 103 114 97 109 1 164 101 101 110 116 114 121 99 114 117 110 103 101 120 112 111 114 116 115 129 99 114 117 110 103 109] [101 116 104 111 100 115 161 99 114 117 110 165 100 98 111 100 121 130 101 99 111 110 115 116 130 103 105 110 116 101 103 101 114 98 52 50 102 112 97 114 97 109 115 128 102 114 101 115]) [117 108 116 99 105 54 52 103 101 102 102 101 99 116 115 128 107 112 97 114 97 109 45 116 121 112 101 115 128 109 118 97 108 117 101 45 112 114 111 102 105 108 101 114 107 111 116 111]) [98 97 46 105 54 52 45 119 114 97 112 47 118 49]) data (build prefix)]
  (if (and (exact? data prefix) (= (vector-at (b/nodes data) 0) -1)) 42 0)))
