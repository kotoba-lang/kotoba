(ns kototama.rebind-test
  "D4 invariants: rebind is versioned and receipted, it never touches another
  slot (the 紋's immutability is structural -- this module only ever sees the
  code environment), refusals are fail-closed and recorded, and the old
  binding stays citeable for running continuations."
  (:require [kotoba.test :refer [deftest is testing]]
            [kototama.rebind :as rebind]))

(def env {:main "bafyreigmaindefcid00000000000000000000000000000000000000"
          :util "bafyreigutildefcid00000000000000000000000000000000000000"})

(def old-cid (:main env))
(def new-cid "bafyreigmaindefcid11111111111111111111111111111111111111")

(deftest rebind-swaps-one-slot-and-receipts-it
  (let [r (rebind/rebind env :main old-cid new-cid)]
    (is (true? (:ok? r)))
    (is (= new-cid (get-in r [:environment :main])))
    (testing "every other slot is untouched (the operation cannot reach a rule Form)"
      (is (= (:util env) (get-in r [:environment :util])))
      (is (= (set (keys env)) (set (keys (:environment r))))))
    (testing "the receipt names the slot and both bindings"
      (let [rc (:receipt r)]
        (is (rebind/rebind? rc))
        (is (= :main (:rebind/env-slot rc)))
        (is (= old-cid (:rebind/old-defcid rc))
            "a running continuation keeps the old DefCID citeable")
        (is (= new-cid (:rebind/new-defcid rc)))
        (is (= :rebound (:rebind/outcome rc)))
        (is (true? (:rebind/attempt-always-receipted rc)))))))

(deftest the-old-binding-is-preserved-for-running-continuations
  (let [r (rebind/rebind env :main old-cid new-cid)]
    (is (= old-cid (:previous r))
        "the pre-rebind binding is returned, not discarded")
    (testing "the environment is a new map: no in-place mutation"
      (is (= old-cid (:main env))))))

(deftest refusals-are-fail-closed-and-receipted
  (doseq [[why args] [[:slot-missing [env :absent old-cid new-cid]]
                      [:binding-mismatch [env :main "bafyreiother" new-cid]]
                      [:no-change [env :main old-cid old-cid]]
                      [:invalid-binding [env :main "" new-cid]]
                      [:invalid-binding [(assoc env :main 7) :main 7 new-cid]]]]
    (testing (str why)
      (let [r (apply rebind/rebind args)]
        (is (false? (:ok? r)))
        (is (= why (:reason r)))
        (is (contains? rebind/refusal-reasons why))
        (testing "even a refused attempt is receipted (kototama :attempt-always-receipted)"
          (let [rc (:receipt r)]
            (is (rebind/rebind? rc))
            (is (= :refused (:rebind/outcome rc)))
            (is (= why (:rebind/reason rc)))))))))

(deftest rebind-is-versioned
  (let [r1 (rebind/rebind env :main old-cid new-cid)
        env1 (:environment r1)
        newer "bafyreigmaindefcid22222222222222222222222222222222222222"
        r2 (rebind/rebind env1 :main new-cid newer)]
    (is (= 1 (-> r1 :receipt :rebind/env-version)))
    (is (= 2 (-> r2 :receipt :rebind/env-version))
        "successive rebinds advance the version: the new binding applies from the next call")
    (is (= new-cid (-> r2 :receipt :rebind/old-defcid)))))

(deftest rebind-predicate-does-not-accept-foreign-maps
  (is (not (rebind/rebind? {:rebind/env-slot :main})))
  (is (not (rebind/rebind? nil)))
  (is (rebind/rebind? (:receipt (rebind/rebind env :main old-cid new-cid)))))
