(ns kototama.receipt-debug-test
  "D3: the receipt debugger reconstructs from records only. These assertions
  keep the boundary honest: shape refusals name their reason, the timeline is
  a re-ordering of recorded events (never an execution), failure points come
  from the record and are not guessed, and `evidence` keeps 'proved by the
  record' separate from 'needs the host to replay'."
  (:require [kotoba.test :refer [deftest is testing]]
            [kototama.receipt-debug :as dbg]))

(def ok-receipt
  {:machine-spec :kototama.vm/spec-v1
   :implementation "test-engine"
   :profile :core/v1
   :message-cid "bafyreigmessage0000000000000000000000000000000000000"
   :program-cid "bafyreigprogram0000000000000000000000000000000000000"
   :state-before "bafyreigstate00000000000000000000000000000000000000"
   :state-after "bafyreigstate11111111111111111111111111111111111111"
   :outcome :success
   :fuel-used 42
   :events [{:event :call} {:event :write}]
   :authority-decision {:manifest-cid "bafyreigmanifest000000000000000000000000000000000000"
                        :grant-ids ["g1"]
                        :policy-id "p1"
                        :world "bafyreigworld00000000000000000000000000000000000000"
                        :epoch 1}})

(deftest shape-problems-name-their-reason
  (is (empty? (dbg/problems ok-receipt)))
  (testing "missing required keys are listed, not silently accepted"
    (let [probs (dbg/problems (dissoc ok-receipt :fuel-used :events))]
      (is (= #{:fuel-used :events}
             (set (map :key (filter #(= :missing-required (:problem %)) probs)))))))
  (testing "forbidden keys are refused (no-secrets)"
    (doseq [k dbg/receipt-v1-forbidden]
      (let [probs (dbg/problems (assoc ok-receipt k "leaked"))]
        (is (some #(and (= :forbidden-key (:problem %)) (= k (:key %))) probs)))))
  (testing "non-maps and wrong shapes are named"
    (is (= [:receipt-not-a-map] (map :problem (dbg/problems 7))))
    (is (some #(= :events-not-sequential (:problem %))
              (dbg/problems (assoc ok-receipt :events 3))))))

(deftest timeline-reorders-records-and-does-not-execute
  (let [child (assoc ok-receipt :events [{:event :child-call}])
        r (assoc ok-receipt
                 :events [{:event :call} {:event :write}]
                 :child-receipts [child])
        tl (dbg/timeline r)]
    (is (= [{:depth 0 :index 0 :event {:event :call}}
            {:depth 0 :index 1 :event {:event :write}}
            {:depth 1 :index 0 :event {:event :child-call}}]
           tl))
    (testing "the timeline is derived from :events only"
      (is (= 3 (count tl))))))

(deftest failure-points-come-from-the-record
  (is (nil? (dbg/failure-point ok-receipt)) "success has no failure point")
  (let [failed (-> ok-receipt
                   (assoc :outcome :revert :revert-data "boom")
                   (assoc :events [{:event :call} {:event :trap}]))
        fp (dbg/failure-point failed)]
    (is (= :revert (:outcome fp)))
    (is (= 1 (:at-event-index fp)) "the last recorded event, not a guess")
    (is (= "boom" (:revert-data fp))))
  (testing "a failure receipt without events records no invented index"
    (let [fp (dbg/failure-point (-> ok-receipt (assoc :outcome :resource-exhaustion)
                                    (dissoc :events)))]
      (is (= :resource-exhaustion (:outcome fp)))
      (is (nil? (:at-event-index fp))))))

(deftest evidence-separates-record-from-replay
  (let [e (dbg/evidence ok-receipt)]
    (is (some #{:event-order-recorded} (:proves e)))
    (is (some #{:re-execution} (:needs-host e))
        "this namespace never claims a replay happened")
    (is (empty? (:problems e))))
  (let [e (dbg/evidence (dissoc ok-receipt :state-after))]
    (is (not (some #{:state-after-recorded} (:proves e))))
    (is (some #(= :missing-required (:problem %)) (:problems e)))))
