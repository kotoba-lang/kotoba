;; Provenance for amu-compiled-clock-now.wasm.
;; amu elaborates `(clock/now seed)` to `(typed-cap-call 7 :i64 :i64 seed)`.
;; kotoba-wasm lowers that to import `kotoba:cap`/`call` (i64, i64)->i64.
;; This is the i64 seed ABI the compiler actually emits, not the variant
;; request/result in clock-v1.edn (`:wasm-aot` on that kit stays pending).
(ns demo-amu-clock-now
  (:capabilities #{:clock/now}))

(defn main []
  (clock/now 0))
