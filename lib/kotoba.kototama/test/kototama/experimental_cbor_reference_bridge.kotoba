;; Test-only bridge from exact, re-encoded CBOR bytes to a bounded expression
;; tree. It is not program admission and supports only this experiment's forms.
(ns bridge (:export [nodes within-limits?]) (:require [cbor.codec :as c] [cbor.value :as v]))
(defn- fail [] :vector-i64 [-1])
;; Structural resource preflight for this bounded experiment. This does not
;; prove full admission or bound the generic codec's total CPU/allocations.
(defn- arg [bytes :vector-i64 pos :i64 ai :i64] :vector-i64
 (let [width (cond (< ai 24) 0 (= ai 24) 1 (= ai 25) 2 (= ai 26) 4 :else -1)]
  (if (or (< width 0) (> (+ pos width) (vector-count bytes))) [-1 0]
   (let [value (if (= width 0) ai
                 (loop [i 0 n 0]
                  (if (= i width) n
                   (recur (+ i 1) (+ (* n 256) (vector-at bytes (+ pos i)))))))
         minimum (cond (= width 0) 0 (= width 1) 24 (= width 2) 256 :else 65536)]
    (if (or (< value minimum) (> value 65536)) [-1 0] [value (+ pos width)])))))
(defn- ascii? [bytes :vector-i64 start :i64 size :i64] :bool
 (loop [i start end (+ start size)]
  (if (= i end) true
   (let [v (vector-at bytes i)]
    (and (>= v 32) (<= v 126) (recur (+ i 1) end))))))
(defn within-limits? [bytes :vector-i64] :bool
 (let [size (vector-count bytes)]
  (if (or (= size 0) (> size 65536)
          (not (loop [i 0] (if (= i size) true
            (let [v (vector-at bytes i)]
             (and (>= v 0) (<= v 255) (recur (+ i 1)))))))) false
   (loop [stack (vector-assoc! (vector-alloc 65) 0 1) top 0 pos 0 count 0]
    (if (= (vector-at stack top) 0)
     (if (= top 0) (= pos size) (recur stack (- top 1) pos count))
     (if (or (>= pos size) (>= count 4095)) false
      (let [b (vector-at bytes pos) major (quot b 32) ai (bit-and b 31)
            a (if (= b 246) [0 (+ pos 1)] (arg bytes (+ pos 1) ai))
            n (vector-at a 0) next (vector-at a 1)
            pending (vector-assoc! stack top (- (vector-at stack top) 1))]
       (cond
        (< n 0) false
        (or (= major 0) (= b 246)) (recur pending top next (+ count 1))
        (= major 3) (if (or (> n 128) (> (+ next n) size) (not (ascii? bytes next n))) false
                      (recur pending top (+ next n) (+ count 1)))
        (or (= major 4) (= major 5))
        (let [children (if (= major 5) (* n 2) n)]
         (if (= children 0) (recur pending top next (+ count 1))
          (if (>= top 64) false
           (recur (vector-assoc! pending (+ top 1) children) (+ top 1) next (+ count 1)))))
        :else false))))))))
(defn- child [x [:ref :cbor/value] i :i64] [:ref :cbor/value]
 (let [children (v/children x)]
  (if (or (< i 0) (>= i (vector-count children))) (throw :bad)
   (typed-list-nth [:list [:ref :cbor/value]] children i))))
(defn- find-at [x [:ref :cbor/value] key :string i :i64] [:ref :cbor/value]
 (if (>= i (vector-count (v/children x))) (throw :bad)
  (let [k (child x i)]
   (if (and (= (v/kind k) :text) (string=? (v/text k) key))
    (child x (+ i 1)) (find-at x key (+ i 2))))))
(defn- find-key [x [:ref :cbor/value] key :string] [:ref :cbor/value]
 (if (not= (v/kind x) :map) (throw :bad) (find-at x key 0)))
(defn- int-text [s :string] :i64
 (let [n (string-length s) neg (and (> n 0) (= (string-code-point-at s 0) 45)) start (if neg 1 0)]
  (if (or (= n start) (> n 20)) (throw :bad)
   (let [value (loop [i start out 0]
     (if (= i n) (if neg (- 0 out) out)
      (let [d (- (string-code-point-at s i) 48)]
       (if (or (< d 0) (> d 9)) (throw :bad)
        (recur (+ i 1) (+ (* out 10) d))))))]
    (if (string=? s (string-from-i64 value)) value (throw :bad))))))
(defn- arr? [x [:ref :cbor/value] size :i64] :bool
 (and (= (v/kind x) :array) (= (vector-count (v/children x)) size)))
(defn- text? [x [:ref :cbor/value] s :string] :bool
 (and (= (v/kind x) :text) (string=? (v/text x) s)))
;; Synthetic nodes model a fold/sequence without adding guest charges.
(defn- fold-node [methods [:ref :cbor/value] args [:ref :cbor/value] n :i64 out :vector-i64 depth :i64 env [:list :string] ls :i64 lc :i64 kind :i64] :vector-i64
 (if (or (< n 2) (> depth 63) (>= (vector-count out) 252)) (throw :bad)
  (let [idx (quot (vector-count out) 4) base (* idx 4) expanded (into out [0 0 0 0])
        left (quot (vector-count expanded) 4)
        lout (if (= n 2) (emit methods (child args 0) expanded (+ depth 1) env false ls lc)
               (fold-node methods args (- n 1) expanded (+ depth 1) env ls lc kind))
        right (quot (vector-count lout) 4) rout (emit methods (child args (- n 1)) lout (+ depth 1) env false ls lc)]
   (-> rout (vector-assoc! base (+ kind 10)) (vector-assoc! (+ base 1) left) (vector-assoc! (+ base 2) right)))))
(defn- seq-node [methods [:ref :cbor/value] args [:ref :cbor/value] i :i64 out :vector-i64 depth :i64 env [:list :string] tail :bool ls :i64 lc :i64] :vector-i64
 (if (or (> depth 63) (>= (vector-count out) 252)) (throw :bad)
  (let [idx (quot (vector-count out) 4) base (* idx 4) expanded (into out [0 0 0 0])
        more (< (+ i 1) (vector-count (v/children args)))
        left (quot (vector-count expanded) 4) lout (emit methods (child args i) expanded (+ depth 1) env (and tail (not more)) ls lc)
        right (if more (quot (vector-count lout) 4) -1)
        rout (if more (seq-node methods args (+ i 1) lout (+ depth 1) env tail ls lc) lout)]
   (-> rout (vector-assoc! base 8) (vector-assoc! (+ base 1) left) (vector-assoc! (+ base 2) right)))))
(defn- compare-link [methods [:ref :cbor/value] args [:ref :cbor/value] i :i64 out :vector-i64 depth :i64 env [:list :string] tail :bool ls :i64 lc :i64] :vector-i64
 (if (or (> depth 63) (>= (vector-count out) 252)) (throw :bad)
  (let [idx (quot (vector-count out) 4) base (* idx 4) expanded (into out [0 0 0 0])
        left (quot (vector-count expanded) 4) lout (emit methods (child args i) expanded (+ depth 1) env false ls lc)
        more (< (+ i 1) (vector-count (v/children args)))
        right (if more (quot (vector-count lout) 4) -1)
        rout (if more (compare-link methods args (+ i 1) lout (+ depth 1) env false ls lc) lout)]
   (-> rout (vector-assoc! base 15) (vector-assoc! (+ base 1) left) (vector-assoc! (+ base 2) right)))))
;; Slots are lexical indices. Sibling scopes can reuse slots; loops use
;; frame-private temporaries before parallel rebinding.
(defn- lookup [env [:list :string] name :string i :i64] :i64
 (if (< i 0) -1
  (if (string=? (typed-list-nth [:list :string] env i) name) i
   (lookup env name (- i 1)))))
(defn- binding-env [args [:ref :cbor/value] i :i64 env [:list :string]] [:list :string]
 (if (= i (vector-count (v/children args))) env
  (let [one (child args i) name (child one 0)]
   (if (or (not (arr? one 2)) (not (name? name)) (>= (vector-count env) 64)) (throw :bad)
    (binding-env args (+ i 1) (typed-list-conj [:list :string] env (v/text name)))))))
(defn- binding-link [methods [:ref :cbor/value] args [:ref :cbor/value] i :i64 out :vector-i64 depth :i64 env [:list :string] tail :bool ls :i64 lc :i64] :vector-i64
 (if (or (> depth 63) (>= (vector-count out) 252) (>= (vector-count env) 64)) (throw :bad)
  (let [one (child args i) name (child one 0) idx (quot (vector-count out) 4) base (* idx 4)
        expanded (into out [0 0 0 0]) init (quot (vector-count expanded) 4)
        first-out (emit methods (child one 1) expanded (+ depth 1) env false ls lc)
        more (< (+ i 1) (vector-count (v/children args)))
        next (if more (quot (vector-count first-out) 4) -1)
        env2 (typed-list-conj [:list :string] env (v/text name))
        final (if more (binding-link methods args (+ i 1) first-out (+ depth 1) env2 false ls lc) first-out)]
   (-> final (vector-assoc! base 18) (vector-assoc! (+ base 1) init)
       (vector-assoc! (+ base 2) next) (vector-assoc! (+ base 3) (vector-count env))))))
(defn- loop-unique [args [:ref :cbor/value] i :i64 names [:list :string]] :bool
 (if (= i (vector-count (v/children args))) true
  (let [one (child args i) name (child one 0)]
   (and (arr? one 2) (name? name)
        (< (lookup names (v/text name) (- (vector-count names) 1)) 0)
        (loop-unique args (+ i 1) (typed-list-conj [:list :string] names (v/text name)))))))
(defn- loop-link [methods [:ref :cbor/value] args [:ref :cbor/value] i :i64 out :vector-i64 depth :i64 env [:list :string]] :vector-i64
 (if (or (> depth 63) (>= (vector-count out) 252)) (throw :bad)
  (let [one (child args i) idx (quot (vector-count out) 4) base (* idx 4)
        expanded (into out [0 0 0 0]) init (quot (vector-count expanded) 4)
        first-out (emit methods (child one 1) expanded (+ depth 1) env false -1 0)
        more (< (+ i 1) (vector-count (v/children args)))
        next (if more (quot (vector-count first-out) 4) -1)
        final (if more (loop-link methods args (+ i 1) first-out (+ depth 1) env) first-out)]
   (-> final (vector-assoc! base 18) (vector-assoc! (+ base 1) init)
       (vector-assoc! (+ base 2) next) (vector-assoc! (+ base 3) (+ (vector-count env) i))))))
(defn- recur-link [methods [:ref :cbor/value] args [:ref :cbor/value] i :i64 out :vector-i64 depth :i64 env [:list :string] ls :i64 lc :i64] :vector-i64
 (if (or (> depth 63) (>= (vector-count out) 252)) (throw :bad)
  (let [idx (quot (vector-count out) 4) base (* idx 4) expanded (into out [0 0 0 0])
        init (quot (vector-count expanded) 4) first-out (emit methods (child args i) expanded (+ depth 1) env false ls lc)
        more (< (+ i 1) (vector-count (v/children args)))
        next (if more (quot (vector-count first-out) 4) -1)
        final (if more (recur-link methods args (+ i 1) first-out (+ depth 1) env ls lc) first-out)]
   (-> final (vector-assoc! base 21) (vector-assoc! (+ base 1) init)
       (vector-assoc! (+ base 2) next) (vector-assoc! (+ base 3) (+ ls i))))))
(defn- method-index [methods [:ref :cbor/value] name :string i :i64] :i64
 (if (>= i (vector-count (v/children methods))) -1
  (if (text? (child methods i) name) (quot i 2) (method-index methods name (+ i 2)))))
(defn- call-link [methods [:ref :cbor/value] args [:ref :cbor/value] i :i64 out :vector-i64 depth :i64 env [:list :string] ls :i64 lc :i64] :vector-i64
 (if (or (> depth 63) (>= (vector-count out) 252)) (throw :bad)
  (let [idx (quot (vector-count out) 4) base (* idx 4) expanded (into out [0 0 0 0])
        init (quot (vector-count expanded) 4) first-out (emit methods (child args i) expanded (+ depth 1) env false ls lc)
        more (< (+ i 1) (vector-count (v/children args)))
        next (if more (quot (vector-count first-out) 4) -1)
        final (if more (call-link methods args (+ i 1) first-out (+ depth 1) env ls lc) first-out)]
   (-> final (vector-assoc! base 21) (vector-assoc! (+ base 1) init)
       (vector-assoc! (+ base 2) next) (vector-assoc! (+ base 3) i)))))
(defn- emit [methods [:ref :cbor/value] x [:ref :cbor/value] out :vector-i64 depth :i64 env [:list :string] tail :bool ls :i64 lc :i64] :vector-i64
 (if (or (> depth 63) (not= (v/kind x) :array) (< (vector-count (v/children x)) 2) (>= (vector-count out) 252)) (throw :bad)
  (let [tag (child x 0) idx (quot (vector-count out) 4) expanded (into out [0 0 0 0]) base (* idx 4)]
   (cond
    (text? tag "const")
    (let [x1 (child x 1)]
     (if (and (arr? x 2) (arr? x1 2) (text? (child x1 0) "integer") (= (v/kind (child x1 1)) :text))
      (vector-assoc! expanded (+ base 3) (int-text (v/text (child x1 1)))) (throw :bad)))
    (text? tag "var")
    (if (or (not (arr? x 2)) (not (name? (child x 1)))) (throw :bad)
      (let [slot (lookup env (v/text (child x 1)) (- (vector-count env) 1))]
       (if (< slot 0) (throw :bad)
        (-> expanded (vector-assoc! base 16) (vector-assoc! (+ base 3) slot)))))
    (text? tag "let")
    (if (or (not (arr? x 3)) (not= (v/kind (child x 1)) :array)
            (> (vector-count (v/children (child x 1))) 16)) (throw :bad)
      (let [args (child x 1) n (vector-count (v/children args)) env2 (binding-env args 0 env)
            first-link (if (= n 0) -1 (quot (vector-count expanded) 4))
            links (if (= n 0) expanded (binding-link methods args 0 expanded (+ depth 1) env false ls lc))
            body (quot (vector-count links) 4) result (emit methods (child x 2) links (+ depth 1) env2 tail ls lc)]
       (-> result (vector-assoc! base 17) (vector-assoc! (+ base 1) first-link)
           (vector-assoc! (+ base 2) body))))
    (text? tag "loop")
    (if (or (not (arr? x 3)) (not= (v/kind (child x 1)) :array)
            (> (vector-count (v/children (child x 1))) 16)) (throw :bad)
      (let [args (child x 1) n (vector-count (v/children args))
            unique (loop-unique args 0 (typed-list-new [:list :string]))
            env2 (binding-env args 0 env) first-link (if (= n 0) -1 (quot (vector-count expanded) 4))
            links (if (= n 0) expanded (loop-link methods args 0 expanded (+ depth 1) env))
            body (quot (vector-count links) 4)
            result (if unique (emit methods (child x 2) links (+ depth 1) env2 true (vector-count env) n) (throw :bad))]
       (-> result (vector-assoc! base 19) (vector-assoc! (+ base 1) first-link) (vector-assoc! (+ base 2) body))))
    (text? tag "recur")
    (if (or (not (arr? x 2)) (not tail) (< ls 0) (not= (v/kind (child x 1)) :array)
            (not= (vector-count (v/children (child x 1))) lc)) (throw :bad)
      (let [args (child x 1) first-link (if (= lc 0) -1 (quot (vector-count expanded) 4))
            result (if (= lc 0) expanded (recur-link methods args 0 expanded (+ depth 1) env ls lc))]
       (-> result (vector-assoc! base 20) (vector-assoc! (+ base 1) first-link))))
    (text? tag "call")
    (if (or (not (arr? x 3)) (not (name? (child x 1))) (not= (v/kind (child x 2)) :array)) (throw :bad)
     (let [name (v/text (child x 1)) args (child x 2) n (vector-count (v/children args))
           target (method-index methods name 0)]
      (if (or (< target 0) (> n 5) (not= n (vector-count (v/children (find-key (child methods (+ (* target 2) 1)) "params"))))) (throw :bad)
       (let [first-link (if (= n 0) -1 (quot (vector-count expanded) 4))
             result (if (= n 0) expanded (call-link methods args 0 expanded (+ depth 1) env ls lc))]
        (-> result (vector-assoc! base 22) (vector-assoc! (+ base 1) first-link)
            (vector-assoc! (+ base 2) target) (vector-assoc! (+ base 3) n))))))
    (text? tag "if")
    (if (not (arr? x 4)) (throw :bad)
     (let [a (quot (vector-count expanded) 4) aout (emit methods (child x 1) expanded (+ depth 1) env false ls lc)
           b (quot (vector-count aout) 4) bout (emit methods (child x 2) aout (+ depth 1) env tail ls lc)
           d (quot (vector-count bout) 4) dout (emit methods (child x 3) bout (+ depth 1) env tail ls lc)]
      (-> dout (vector-assoc! base 3) (vector-assoc! (+ base 1) a) (vector-assoc! (+ base 2) b) (vector-assoc! (+ base 3) d))))
    (text? tag "compare")
    (if (not (arr? x 3)) (throw :bad)
     (let [op (child x 1) args (child x 2) n (vector-count (v/children args))
           kind (cond (text? op "=") 0 (text? op "<") 1 (text? op ">") 2
                      (text? op "<=") 3 (text? op ">=") 4 :else -1)]
      (if (or (= kind -1) (not= (v/kind args) :array) (< n 2) (> n 16)) (throw :bad)
       (let [left (quot (vector-count expanded) 4) lout (emit methods (child args 0) expanded (+ depth 1) env false ls lc)
             right (quot (vector-count lout) 4) rout (compare-link methods args 1 lout (+ depth 1) env false ls lc)]
        (-> rout (vector-assoc! base 14) (vector-assoc! (+ base 1) left)
            (vector-assoc! (+ base 2) right) (vector-assoc! (+ base 3) kind))))))
    (text? tag "do")
    (if (or (not (arr? x 2)) (not= (v/kind (child x 1)) :array)
            (= (vector-count (v/children (child x 1))) 0) (> (vector-count (v/children (child x 1))) 16)) (throw :bad)
     (let [args (child x 1) n (vector-count (v/children args)) left (quot (vector-count expanded) 4)
           lout (emit methods (child args 0) expanded (+ depth 1) env (and tail (= n 1)) ls lc) right (if (> n 1) (quot (vector-count lout) 4) -1)
           rout (if (> n 1) (seq-node methods args 1 lout (+ depth 1) env tail ls lc) lout)]
      (-> rout (vector-assoc! base 7) (vector-assoc! (+ base 1) left) (vector-assoc! (+ base 2) right))))
    (text? tag "arith")
    (if (not (arr? x 3)) (throw :bad)
     (let [op (child x 1) args (child x 2) n (vector-count (v/children args))
           kind (cond (text? op "add") 1 (text? op "div") 2 (text? op "quot") 2
                      (text? op "sub") 4 (text? op "mul") 5 (text? op "mod") 6 :else -1)]
      (cond (or (= kind -1) (not= (v/kind args) :array) (> n 16)
                (and (or (= kind 2) (= kind 6)) (not= n 2)) (and (= kind 4) (= n 0))) (throw :bad)
            (= n 0) (vector-assoc! expanded (+ base 3) (if (= kind 5) 1 0))
            (= n 1) (let [left (quot (vector-count expanded) 4) lout (emit methods (child args 0) expanded (+ depth 1) env false ls lc)]
                       (-> lout (vector-assoc! base (if (= kind 4) 10 7)) (vector-assoc! (+ base 1) left) (vector-assoc! (+ base 2) -1)))
            :else
            (let [left (quot (vector-count expanded) 4)
                  lout (if (= n 2) (emit methods (child args 0) expanded (+ depth 1) env false ls lc)
                         (fold-node methods args (- n 1) expanded (+ depth 1) env ls lc (if (= kind 1) 1 (if (= kind 4) 2 3))))
                  right (quot (vector-count lout) 4) rout (emit methods (child args (- n 1)) lout (+ depth 1) env false ls lc)]
              (-> rout (vector-assoc! base kind) (vector-assoc! (+ base 1) left) (vector-assoc! (+ base 2) right))))))
    :else (throw :bad)))))
(defn- same [a :vector-i64 b :vector-i64] :bool
 (and (= (vector-count a) (vector-count b))
  (loop [i 0] (cond (= i (vector-count a)) true (not= (vector-at a i) (vector-at b i)) false :else (recur (+ i 1))))))
;; These checks bound this test subset to effect-free i64 methods; not admission.
(defn- name-at [s :string i :i64 n :i64] :bool
 (if (= i n) true
  (let [c (string-code-point-at s i)]
   (and (>= c 32) (<= c 126) (name-at s (+ i 1) n)))))
(defn- name? [x [:ref :cbor/value]] :bool
 (if (not= (v/kind x) :text) false
  (let [s (v/text x) n (string-length s)]
   (and (> n 0) (<= n 64) (name-at s 0 n)))))
(defn- params-env [params [:ref :cbor/value] types [:ref :cbor/value] i :i64 env [:list :string]] [:list :string]
 (if (= i (vector-count (v/children params))) env
  (let [name (child params i)]
   (if (or (not (name? name)) (not (text? (child types i) "i64"))
           (>= (lookup env (v/text name) (- (vector-count env) 1)) 0)) (throw :bad)
    (params-env params types (+ i 1) (typed-list-conj [:list :string] env (v/text name)))))))
(defn- valid-methods [methods [:ref :cbor/value] i :i64] :bool
 (let [xs (v/children methods) n (vector-count xs)]
  (if (= i n) true
   (let [name (child methods i) m (child methods (+ i 1))
         params (find-key m "params") types (find-key m "param-types")
         effects (find-key m "effects") result (find-key m "result") body (find-key m "body")]
    (and (name? name) (= (v/kind m) :map) (= (vector-count (v/children m)) 10)
         (= (v/kind params) :array) (<= (vector-count (v/children params)) 5)
         (arr? types (vector-count (v/children params))) (arr? effects 0) (text? result "i64")
         (> (vector-count (emit methods body [] 0 (params-env params types 0 (typed-list-new [:list :string])) true -1 0)) 0)
         (valid-methods methods (+ i 2)))))))
;; Every method contributes graph edges, even when unreachable from entry.
(defn- edges [out :vector-i64 i :i64 end :i64 mask :i64] :i64
 (if (= i end) mask
  (let [base (* i 4) op (vector-at out base)]
   (edges out (+ i 1) end (if (= op 22) (bit-or mask (i64-shift-left 1 (vector-at out (+ base 2)))) mask)))))
(defn- acyclic? [graph :vector-i64 count :i64] :bool
 (loop [round 0 done 0]
  (if (= round count) (= done (- (i64-shift-left 1 count) 1))
   (let [next (loop [i 0 mask done]
                (if (= i count) mask
                 (let [e (vector-at graph i)]
                  (recur (+ i 1) (if (= (bit-and e done) e) (bit-or mask (i64-shift-left 1 i)) mask)))))]
    (recur (+ round 1) next)))))
(defn- all-methods [methods [:ref :cbor/value] entry :i64 i :i64 out :vector-i64 offsets :vector-i64 graph :vector-i64] :vector-i64
 (let [count (quot (vector-count (v/children methods)) 2)]
  (if (= i count)
   (if (not (acyclic? graph count)) (throw :bad)
    (loop [n 0 result out]
     (if (= n (quot (vector-count result) 4)) result
      (let [base (* n 4)]
       (recur (+ n 1) (if (= (vector-at result base) 22)
         (vector-assoc! result (+ base 2) (vector-at offsets (vector-at result (+ base 2)))) result))))))
   (if (= i entry) (all-methods methods entry (+ i 1) out offsets graph)
    (let [m (child methods (+ (* i 2) 1)) params (find-key m "params") types (find-key m "param-types")
          start (quot (vector-count out) 4) result (emit methods (find-key m "body") out 0 (params-env params types 0 (typed-list-new [:list :string])) true -1 0)
          end (quot (vector-count result) 4)]
     (all-methods methods entry (+ i 1) result (vector-assoc! offsets i start)
                  (vector-assoc! graph i (edges result start end 0))))))))
(defn- compile-methods [methods [:ref :cbor/value] entry :i64] :vector-i64
 (let [m (child methods (+ (* entry 2) 1)) body (find-key m "body")
       out (emit methods body [] 0 (typed-list-new [:list :string]) true -1 0)
       graph (vector-assoc! (vector-alloc 32) entry (edges out 0 (quot (vector-count out) 4) 0))]
  (all-methods methods entry 0 out (vector-alloc 32) graph)))
(defn- unique-before [exports [:ref :cbor/value] name :string i :i64 end :i64] :bool
 (if (= i end) true
  (and (not (string=? name (v/text (child exports i)))) (unique-before exports name (+ i 1) end))))
(defn- exports-valid [exports [:ref :cbor/value] methods [:ref :cbor/value] entry :string i :i64 found :bool] :bool
 (if (= i (vector-count (v/children exports))) found
  (let [name (child exports i)]
   (and (name? name) (unique-before exports (v/text name) 0 i)
        (= (v/kind (find-key methods (v/text name))) :map)
        (exports-valid exports methods entry (+ i 1) (or found (text? name entry)))))))
(defn nodes [bytes :vector-i64] :vector-i64
 (try
  (if (not (within-limits? bytes)) (throw :bad)
  (let [root (c/decode bytes)]
   (if (not (same bytes (c/encode root))) (throw :bad)
    (let [p (child root 2) entry (find-key p "entry") methods (find-key p "methods")
          exports (find-key p "exports") profile (find-key p "value-profile")
          method (find-key methods (v/text entry)) body (find-key method "body")]
     (if (and (arr? root 3) (text? (child root 0) "kototama.vm/program")
              (= (v/kind (child root 1)) :int) (= (v/number (child root 1)) 1)
              (= (v/kind p) :map) (= (vector-count (v/children p)) 8)
              (name? entry) (text? profile "kotoba.i64-wrap/v1")
              (= (v/kind methods) :map) (> (vector-count (v/children methods)) 0)
              (<= (vector-count (v/children methods)) 64)
              (= (v/kind exports) :array) (<= (vector-count (v/children exports)) 32)
              (exports-valid exports methods (v/text entry) 0 false)
              (valid-methods methods 0)
              (arr? (find-key method "params") 0))
      (compile-methods methods (method-index methods (v/text entry) 0)) (throw :bad))))))
  (catch :keyword e (fail))))
