;; Test-only bridge from exact, re-encoded CBOR bytes to a bounded expression
;; tree. It is not program admission and supports only this experiment's forms.
(ns bridge (:export [nodes within-limits?]) (:require [cbor.codec :as c] [cbor.value :as v]))
(defn- fail [] :vector-i64 [-1])
;; Structural resource preflight for this bounded experiment. This does not
;; prove full admission or bound the generic codec's total CPU/allocations.
(defn- arg [bytes :vector-i64 pos :i64 ai :i64] :vector-i64
 (let [width (cond (< ai 24) 0 (= ai 24) 1 (= ai 25) 2 (= ai 26) 4 :else -1)]
  (if (or (< width 0) (> (+ pos width) (vector-count bytes))) [-1 0]
   (let [value (if (= width 0) ai
                 (loop [i 0 n 0]
                  (if (= i width) n
                   (recur (+ i 1) (+ (* n 256) (vector-at bytes (+ pos i)))))))
         minimum (cond (= width 0) 0 (= width 1) 24 (= width 2) 256 :else 65536)]
    (if (or (< value minimum) (> value 65536)) [-1 0] [value (+ pos width)])))))
(defn- ascii? [bytes :vector-i64 start :i64 size :i64] :bool
 (loop [i start end (+ start size)]
  (if (= i end) true
   (let [v (vector-at bytes i)]
    (and (>= v 32) (<= v 126) (recur (+ i 1) end))))))
(defn within-limits? [bytes :vector-i64] :bool
 (let [size (vector-count bytes)]
  (if (or (= size 0) (> size 65536)
          (not (loop [i 0] (if (= i size) true
            (let [v (vector-at bytes i)]
             (and (>= v 0) (<= v 255) (recur (+ i 1)))))))) false
   (loop [stack (vector-assoc! (vector-alloc 65) 0 1) top 0 pos 0 count 0]
    (if (= (vector-at stack top) 0)
     (if (= top 0) (= pos size) (recur stack (- top 1) pos count))
     (if (or (>= pos size) (>= count 4095)) false
      (let [b (vector-at bytes pos) major (quot b 32) ai (bit-and b 31)
            a (if (= b 246) [0 (+ pos 1)] (arg bytes (+ pos 1) ai))
            n (vector-at a 0) next (vector-at a 1)
            pending (vector-assoc! stack top (- (vector-at stack top) 1))]
       (cond
        (< n 0) false
        (or (= major 0) (= b 246)) (recur pending top next (+ count 1))
        (= major 3) (if (or (> n 128) (> (+ next n) size) (not (ascii? bytes next n))) false
                      (recur pending top (+ next n) (+ count 1)))
        (or (= major 4) (= major 5))
        (let [children (if (= major 5) (* n 2) n)]
         (if (= children 0) (recur pending top next (+ count 1))
          (if (>= top 64) false
           (recur (vector-assoc! pending (+ top 1) children) (+ top 1) next (+ count 1)))))
        :else false))))))))
(defn- child [x [:ref :cbor/value] i :i64] [:ref :cbor/value]
 (let [children (v/children x)]
  (if (or (< i 0) (>= i (vector-count children))) (throw :bad)
   (typed-list-nth [:list [:ref :cbor/value]] children i))))
(defn- find-at [x [:ref :cbor/value] key :string i :i64] [:ref :cbor/value]
 (if (>= i (vector-count (v/children x))) (throw :bad)
  (let [k (child x i)]
   (if (and (= (v/kind k) :text) (string=? (v/text k) key))
    (child x (+ i 1)) (find-at x key (+ i 2))))))
(defn- find-key [x [:ref :cbor/value] key :string] [:ref :cbor/value]
 (if (not= (v/kind x) :map) (throw :bad) (find-at x key 0)))
(defn- int-text [s :string] :i64
 (let [n (string-length s) neg (and (> n 0) (= (string-code-point-at s 0) 45)) start (if neg 1 0)]
  (if (or (= n start) (> n 20)) (throw :bad)
   (let [value (loop [i start out 0]
     (if (= i n) (if neg (- 0 out) out)
      (let [d (- (string-code-point-at s i) 48)]
       (if (or (< d 0) (> d 9)) (throw :bad)
        (recur (+ i 1) (+ (* out 10) d))))))]
    (if (string=? s (string-from-i64 value)) value (throw :bad))))))
(defn- arr? [x [:ref :cbor/value] size :i64] :bool
 (and (= (v/kind x) :array) (= (vector-count (v/children x)) size)))
(defn- text? [x [:ref :cbor/value] s :string] :bool
 (and (= (v/kind x) :text) (string=? (v/text x) s)))
;; Synthetic nodes model a fold/sequence without adding guest charges.
(defn- fold-node [args [:ref :cbor/value] n :i64 out :vector-i64 depth :i64 kind :i64] :vector-i64
 (if (or (< n 2) (> depth 63) (>= (vector-count out) 252)) (throw :bad)
  (let [idx (quot (vector-count out) 4) base (* idx 4) expanded (into out [0 0 0 0])
        left (quot (vector-count expanded) 4)
        lout (if (= n 2) (emit (child args 0) expanded (+ depth 1))
               (fold-node args (- n 1) expanded (+ depth 1) kind))
        right (quot (vector-count lout) 4) rout (emit (child args (- n 1)) lout (+ depth 1))]
   (-> rout (vector-assoc! base (+ kind 10)) (vector-assoc! (+ base 1) left) (vector-assoc! (+ base 2) right)))))
(defn- seq-node [args [:ref :cbor/value] i :i64 out :vector-i64 depth :i64] :vector-i64
 (if (or (> depth 63) (>= (vector-count out) 252)) (throw :bad)
  (let [idx (quot (vector-count out) 4) base (* idx 4) expanded (into out [0 0 0 0])
        left (quot (vector-count expanded) 4) lout (emit (child args i) expanded (+ depth 1))
        more (< (+ i 1) (vector-count (v/children args)))
        right (if more (quot (vector-count lout) 4) -1)
        rout (if more (seq-node args (+ i 1) lout (+ depth 1)) lout)]
   (-> rout (vector-assoc! base 8) (vector-assoc! (+ base 1) left) (vector-assoc! (+ base 2) right)))))
(defn- emit [x [:ref :cbor/value] out :vector-i64 depth :i64] :vector-i64
 (if (or (> depth 63) (not= (v/kind x) :array) (< (vector-count (v/children x)) 2) (>= (vector-count out) 252)) (throw :bad)
  (let [tag (child x 0) idx (quot (vector-count out) 4) expanded (into out [0 0 0 0]) base (* idx 4)]
   (cond
    (text? tag "const")
    (let [x1 (child x 1)]
     (if (and (arr? x 2) (arr? x1 2) (text? (child x1 0) "integer") (= (v/kind (child x1 1)) :text))
      (vector-assoc! expanded (+ base 3) (int-text (v/text (child x1 1)))) (throw :bad)))
    (text? tag "if")
    (if (not (arr? x 4)) (throw :bad)
     (let [a (quot (vector-count expanded) 4) aout (emit (child x 1) expanded (+ depth 1))
           b (quot (vector-count aout) 4) bout (emit (child x 2) aout (+ depth 1))
           d (quot (vector-count bout) 4) dout (emit (child x 3) bout (+ depth 1))]
      (-> dout (vector-assoc! base 3) (vector-assoc! (+ base 1) a) (vector-assoc! (+ base 2) b) (vector-assoc! (+ base 3) d))))
    (text? tag "do")
    (if (or (not (arr? x 2)) (not= (v/kind (child x 1)) :array)
            (= (vector-count (v/children (child x 1))) 0) (> (vector-count (v/children (child x 1))) 16)) (throw :bad)
     (let [args (child x 1) n (vector-count (v/children args)) left (quot (vector-count expanded) 4)
           lout (emit (child args 0) expanded (+ depth 1)) right (if (> n 1) (quot (vector-count lout) 4) -1)
           rout (if (> n 1) (seq-node args 1 lout (+ depth 1)) lout)]
      (-> rout (vector-assoc! base 7) (vector-assoc! (+ base 1) left) (vector-assoc! (+ base 2) right))))
    (text? tag "arith")
    (if (not (arr? x 3)) (throw :bad)
     (let [op (child x 1) args (child x 2) n (vector-count (v/children args))
           kind (cond (text? op "add") 1 (text? op "div") 2 (text? op "quot") 2
                      (text? op "sub") 4 (text? op "mul") 5 (text? op "mod") 6 :else -1)]
      (cond (or (= kind -1) (not= (v/kind args) :array) (> n 16)
                (and (or (= kind 2) (= kind 6)) (not= n 2)) (and (= kind 4) (= n 0))) (throw :bad)
            (= n 0) (vector-assoc! expanded (+ base 3) (if (= kind 5) 1 0))
            (= n 1) (let [left (quot (vector-count expanded) 4) lout (emit (child args 0) expanded (+ depth 1))]
                       (-> lout (vector-assoc! base (if (= kind 4) 10 7)) (vector-assoc! (+ base 1) left) (vector-assoc! (+ base 2) -1)))
            :else
            (let [left (quot (vector-count expanded) 4)
                  lout (if (= n 2) (emit (child args 0) expanded (+ depth 1))
                         (fold-node args (- n 1) expanded (+ depth 1) (if (= kind 1) 1 (if (= kind 4) 2 3))))
                  right (quot (vector-count lout) 4) rout (emit (child args (- n 1)) lout (+ depth 1))]
              (-> rout (vector-assoc! base kind) (vector-assoc! (+ base 1) left) (vector-assoc! (+ base 2) right))))))
    :else (throw :bad)))))
(defn- same [a :vector-i64 b :vector-i64] :bool
 (and (= (vector-count a) (vector-count b))
  (loop [i 0] (cond (= i (vector-count a)) true (not= (vector-at a i) (vector-at b i)) false :else (recur (+ i 1))))))
;; These checks bound this *test subset* to zero-argument, effect-free
;; methods with bodies expressible by emit. They are not the full VM profile.
(defn- name-at [s :string i :i64 n :i64] :bool
 (if (= i n) true
  (let [c (string-code-point-at s i)]
   (and (>= c 32) (<= c 126) (name-at s (+ i 1) n)))))
(defn- name? [x [:ref :cbor/value]] :bool
 (if (not= (v/kind x) :text) false
  (let [s (v/text x) n (string-length s)]
   (and (> n 0) (<= n 64) (name-at s 0 n)))))
(defn- valid-methods [methods [:ref :cbor/value] i :i64] :bool
 (let [xs (v/children methods) n (vector-count xs)]
  (if (= i n) true
   (let [name (child methods i) m (child methods (+ i 1))
         params (find-key m "params") types (find-key m "param-types")
         effects (find-key m "effects") result (find-key m "result") body (find-key m "body")]
    (and (name? name) (= (v/kind m) :map) (= (vector-count (v/children m)) 10)
         (arr? params 0) (arr? types 0) (arr? effects 0) (text? result "i64")
         (> (vector-count (emit body [] 0)) 0)
         (valid-methods methods (+ i 2)))))))
(defn- unique-before [exports [:ref :cbor/value] name :string i :i64 end :i64] :bool
 (if (= i end) true
  (and (not (string=? name (v/text (child exports i)))) (unique-before exports name (+ i 1) end))))
(defn- exports-valid [exports [:ref :cbor/value] methods [:ref :cbor/value] entry :string i :i64 found :bool] :bool
 (if (= i (vector-count (v/children exports))) found
  (let [name (child exports i)]
   (and (name? name) (unique-before exports (v/text name) 0 i)
        (= (v/kind (find-key methods (v/text name))) :map)
        (exports-valid exports methods entry (+ i 1) (or found (text? name entry)))))))
(defn nodes [bytes :vector-i64] :vector-i64
 (try
  (if (not (within-limits? bytes)) (throw :bad)
  (let [root (c/decode bytes)]
   (if (not (same bytes (c/encode root))) (throw :bad)
    (let [p (child root 2) entry (find-key p "entry") methods (find-key p "methods")
          exports (find-key p "exports") profile (find-key p "value-profile")
          method (find-key methods (v/text entry)) body (find-key method "body")]
     (if (and (arr? root 3) (text? (child root 0) "kototama.vm/program")
              (= (v/kind (child root 1)) :int) (= (v/number (child root 1)) 1)
              (= (v/kind p) :map) (= (vector-count (v/children p)) 8)
              (name? entry) (text? profile "kotoba.i64-wrap/v1")
              (= (v/kind methods) :map) (> (vector-count (v/children methods)) 0)
              (<= (vector-count (v/children methods)) 64)
              (= (v/kind exports) :array) (<= (vector-count (v/children exports)) 32)
              (exports-valid exports methods (v/text entry) 0 false)
              (valid-methods methods 0))
      (emit body [] 0) (throw :bad))))))
  (catch :keyword e (fail))))
