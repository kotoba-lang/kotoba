(ns run-e2e
  "Real-pixel-data browser proof that kami.eizo.grade's ASC CDL primary
   correction produces correct output on REAL pixel data, not just
   synthetic numbers in a unit test. Builds directly on
   `kotoba-lang/org-w3-webcodecs`'s own real-browser WebCodecs E2E
   (`org-w3-webcodecs` `test/e2e/run_e2e.cljk`, commit `b14dc397e248`) and
   mirrors the harness `kami-eizo-timeline` established on top of it
   (`kami-eizo-timeline` `test/e2e/run_e2e.cljk`, commit `c0116940f19e`):
   nbb + Playwright, local HTTP server for the secure-context requirement,
   real headless Chromium, same `avc1.42001f` H.264 baseline codec.

   What makes this proof different from a unit test: the CDL transform
   under test (`kami.eizo.grade.cdl/apply-cdl`, via the shared
   `kami.eizo.grade.e2e.grade-proof` node) never runs on hand-picked
   synthetic RGB triples here. It runs on REAL decoded H.264 pixel
   values -- the actual output of a real `VideoEncoder` -> `VideoDecoder`
   round-trip in a real browser, including the small lossy-compression
   deltas that real codec produces. Three checks, all against real
   captured data:

   1. `decodedBeforeGrading` -- real decoded pixel averages per quadrant,
      close to (but not exactly) the painted input, proving a real codec
      round-trip happened.
   2. `gradedByBrowser` vs. this script's own OFFLINE computation of the
      SAME `kami.eizo.grade.e2e.grade-proof/grade-rgb255` function (this
      script requires the identical .cljc source via nbb -- a different
      runtime/execution path than the browser's compiled bundle -- and
      applies it to the exact `decodedBeforeGrading` values the browser
      captured) -- verifies the browser-compiled grading math agrees with
      an independently-executed reference on real input.
   3. `decodedAfterRegrade` -- the graded quadrant colors re-encoded and
      decoded a second real time, proving the full real round-trip
      (encode -> decode -> grade -> encode -> decode) survives, not just
      the arithmetic.

   Requires: `bash scripts/build-e2e-bundle.sh` run first, and
   `npm install` inside test/e2e/ for the Playwright dependency.

   Run from the repo root (needs BOTH classpath roots -- src for
   kami.eizo.grade.cdl, test/e2e/src for the shared e2e grade-proof
   namespace):
   `kbb --backend sci -cp \"src:test/e2e/src\" test/e2e/run_e2e.cljk`"
  (:require ["playwright" :refer [chromium]]
            ["http" :as http]
            ["fs" :as fs]
            ["path" :as path]
            [kami.eizo.grade.e2e.grade-proof :as gp]))

(def site-dir (path/join (js/process.cwd) "test" "e2e" "page"))
(def port 8938)

(def content-types
  {".html" "text/html" ".js" "application/javascript"})

(defn start-server []
  (js/Promise.
    (fn [resolve _reject]
      (let [server (http/createServer
                     (fn [req res]
                       (let [url (if (= (.-url req) "/") "/index.html" (.-url req))
                             fpath (path/join site-dir url)
                             ext (path/extname fpath)
                             ctype (get content-types ext "application/octet-stream")]
                         (if (fs/existsSync fpath)
                           (do (.writeHead res 200 #js {"Content-Type" ctype})
                               (.end res (fs/readFileSync fpath)))
                           (do (.writeHead res 404) (.end res "not found"))))))]
        (.listen server port (fn [] (resolve server)))))))

(defn close? [[ar ag ab] [br bg bb] tol]
  (and (<= (js/Math.abs (- ar br)) tol)
       (<= (js/Math.abs (- ag bg)) tol)
       (<= (js/Math.abs (- ab bb)) tol)))

(defn cross-verify
  "Independently recompute the expected graded value for each quadrant's
   real decodedBeforeGrading pixels, using this script's own nbb-executed
   copy of kami.eizo.grade.e2e.grade-proof/grade-rgb255 (same .cljc
   source the browser bundle compiled, different runtime), and compare
   against what the browser itself computed. Both JS result objects are
   converted to Clojure data (js->clj turns the nested JS [r g b] arrays
   into plain Clojure vectors) up front, so no further JS-interop (aget/
   get-on-a-raw-JS-object) is needed below."
  [decoded-before-grading-js graded-by-browser-js]
  (let [decoded (js->clj decoded-before-grading-js :keywordize-keys true)
        graded (js->clj graded-by-browser-js :keywordize-keys true)]
    (into {}
          (map (fn [[k px]]
                 (let [expected (gp/grade-rgb255 px)
                       actual (get graded k)
                       ok (close? expected actual 1)] ;; integer 8-bit rounding tolerance only -- no codec lossy step in this comparison
                   [k {:expected expected :actual actual :ok ok}])))
          decoded)))

(defn -main []
  (when-not (fs/existsSync (path/join site-dir "grade-proof-bundle.js"))
    (println "ERROR: test/e2e/page/grade-proof-bundle.js not found.")
    (println "Run scripts/build-e2e-bundle.sh first.")
    (js/process.exit 1))
  (-> (start-server)
      (.then
        (fn [server]
          (-> (.launch chromium)
              (.then
                (fn [browser]
                  (-> (.newPage browser)
                      (.then
                        (fn [page]
                          (-> (.goto page (str "http://localhost:" port "/"))
                              (.then #(.evaluate page "window.runGradeProof()"))
                              (.then
                                (fn [result]
                                  (let [decoded-before (.-decodedBeforeGrading result)
                                        graded-by-browser (.-gradedByBrowser result)
                                        cross (cross-verify decoded-before graded-by-browser)
                                        cross-pass (every? (comp :ok val) cross)
                                        overall-pass (and (.-regradePass result) cross-pass)]
                                    (println "=== kami-eizo-grade real-pixel-data E2E result ===")
                                    (println (js/JSON.stringify result nil 2))
                                    (println "=== offline (nbb) cross-verification of browser-computed CDL grading ===")
                                    (println (pr-str cross))
                                    (println (str "cross-verify pass: " cross-pass))
                                    (println (str "overall pass: " overall-pass))
                                    (.close browser)
                                    (.close server)
                                    (if overall-pass
                                      (js/process.exit 0)
                                      (js/process.exit 1)))))
                              (.catch
                                (fn [e]
                                  (println "ERROR:" (.-message e))
                                  (.close browser)
                                  (.close server)
                                  (js/process.exit 1))))))))))))))

(-main)
