{:paths ["src"]
 ;; ipld supplies the DAG-PB codec (the two framing rules a protobuf
 ;; encoder cannot express); multiformats supplies raw CIDv1 and sha2-256;
 ;; dev-protobuf supplies the UnixFS Data message, which — unlike the node
 ;; around it — is exactly what a deterministic protobuf encoder emits.
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/io-ipld {:local/root "../kotoba.ioIpld"}
        io.github.kotoba-lang/io-multiformats {:local/root "../kotoba.ioMultiformats"}
        io.github.kotoba-lang/dev-protobuf {:local/root "../kotoba.devProtobuf"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {
                      ;; TEST-ONLY. Parity compiles kotoba/unixfs/shape.kotoba
                      ;; and runs it against unixfs.file. Nothing in :paths
                      ;; depends on either. Pins are the west pair (amu +
                      ;; kotoba-kir) as of this commit; advanced together.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "35e8a18f2842762bedbf88b32f22e1128ad95cf0"}
                      io.github.kotoba-lang/osaho
                      {:git/url "https://github.com/kotoba-lang/osaho.git"
                       :git/sha "099c627609ad506babf05f2d5e9a73b95c1b026b"}}}}}
