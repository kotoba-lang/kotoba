{:paths ["src"]
 ;; Zero third-party runtime deps — every namespace is portable .cljc (JVM, CLJS, SCI).
 ;; SQL I/O has a built-in minimal tokeniser/emitter; parse-str handles CREATE TABLE
 ;; with column defs, NOT NULL, PRIMARY KEY, DEFAULT, and table-level FK constraints.
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :kotoba {:replace-deps {io.github.kotoba-lang/amu
                          {:git/url "https://github.com/kotoba-lang/amu.git"
                           :git/sha "b3a29de4d0e525e6bacd4b66dafc755a2f68536e"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}}}
