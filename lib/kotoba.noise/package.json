{
  "name": "kotoba-noise",
  "private": true,
  "description": "npm deps for the ClojureScript primitive provider (noise.provider.noble). JVM consumers need none of this.",
  "dependencies": {
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1"
  },
  "devDependencies": {
    "nbb": "^1.4.208"
  },
  "scripts": {
    "test": "kbb --backend sci --classpath \"src:test:../bytes/src\" run-tests.cljk",
    "test:reference": "kbb --backend sci --classpath \"src:test:../bytes/src:../org-ietf-chacha20-poly1305/src\" -m noise.provider.reference-aead-test",
    "test:reference-hashes": "kbb --backend sci --classpath \"src:test:../bytes/src:../org-nist-sha2/src:../org-ietf-chacha20-poly1305/src\" -m noise.provider.reference-hash-test"
  }
}
