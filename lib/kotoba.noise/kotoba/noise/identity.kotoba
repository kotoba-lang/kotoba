;; noise.identity -- the post-quantum identity payload of ADR-0001 (AWAI-102), in native
;; .kotoba on the native Ed25519 (org.ietf.ed25519 ed25519.selfhost) and ML-DSA-65
;; (gov.nist.mlDsa). Bytes are :vector-i64 of 0..255.
;;   identity ed-seed xi      -> Ed25519 public (32) ++ ML-DSA-65 public (1952) = 1984;
;;                               ed-seed and xi are the 32-byte key seeds
;;   payload ed-seed xi h     -> identity ++ Ed25519 signature (64) ++ ML-DSA-65
;;                               signature (3309) = 5357, both over
;;                               "kotoba-noise-pq-identity/v1\n" ++ h
;;   verify-payload p h want  -> true only when p is 5357 bytes, its identity equals want
;;                               (the roster member the host expects for this peer, never
;;                               a value the peer chose) and both signatures verify over h
;; h is the handshake hash after the message's tokens and before its payload is
;; encrypted (noise.native write-tokens / read-tokens, then handshake-hash-now). ML-DSA
;; signs deterministically (rnd all zero, empty context). A wrong length or a value that
;; is not a byte gives an empty vector or false. Not constant time: see the README.
(ns noise.identity
  (:require [ed25519.selfhost :as ed] [mldsa.core :as dsa])
  (:export [identity payload verify-payload payload-size]))

(defn payload-size [] :i64 5357)
(defn- label [] :vector-i64 (vector-i64 107 111 116 111 98 97 45 110 111 105 115 101 45 112 113 45 105 100 101 110 116 105 116 121 47 118 49 10))
(defn- cat [a :vector-i64 b :vector-i64] :vector-i64
  (let [na (vector-count a) out (vector-alloc (+ na (vector-count b)))]
    (loop [i 0] (if (= i (vector-count out)) out
      (let [z (vector-assoc! out i (if (< i na) (vector-at a i) (vector-at b (- i na))))] (recur (+ i 1)))))))
(defn- slice [v :vector-i64 start :i64 n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ start i)))))))
(defn- bytes? [v :vector-i64 n :i64] :bool
  (and (= (vector-count v) n)
       (loop [i 0] (if (= i n) true (if (and (>= (vector-at v i) 0) (<= (vector-at v i) 255)) (recur (+ i 1)) false)))))
(defn- same? [a :vector-i64 b :vector-i64] :bool
  (and (= (vector-count a) (vector-count b))
       (loop [i 0] (if (= i (vector-count a)) true (if (= (vector-at a i) (vector-at b i)) (recur (+ i 1)) false)))))
(defn- zeros [n :i64] :vector-i64 (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i 0)))))

(defn identity [ed-seed :vector-i64 xi :vector-i64] :vector-i64
  (if (or (not (bytes? ed-seed 32)) (not (bytes? xi 32))) (vector-i64)
    (cat (ed/public-from-seed ed-seed) (slice (dsa/keygen xi) 0 1952))))

(defn payload [ed-seed :vector-i64 xi :vector-i64 h :vector-i64] :vector-i64
  (if (or (not (bytes? ed-seed 32)) (not (bytes? xi 32)) (not (bytes? h 32))) (vector-i64)
    (let [kp (dsa/keygen xi) msg (cat (label) h)
          id (cat (ed/public-from-seed ed-seed) (slice kp 0 1952))
          s1 (ed/sign ed-seed msg)
          s2 (dsa/sign (slice kp 1952 4032) msg (vector-i64) (zeros 32))]
      (if (or (not (= (vector-count s1) 64)) (not (= (vector-count s2) 3309))) (vector-i64)
        (cat (cat id s1) s2)))))

(defn verify-payload [p :vector-i64 h :vector-i64 want :vector-i64] :bool
  (and (bytes? p 5357) (bytes? h 32) (bytes? want 1984)
       (same? (slice p 0 1984) want)
       (let [msg (cat (label) h)]
         (and (ed/verify? (slice p 0 32) msg (slice p 1984 64))
              (dsa/verify (slice p 32 1952) msg (vector-i64) (slice p 2048 3309))))))
