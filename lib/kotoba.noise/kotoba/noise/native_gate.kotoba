(defn group-nn-i [] :i64
  (let [st0 (n/initialize 0 true (vector-i64) (g-nn-init-eph) (vector-i64) (g-nn-prologue))
        bad-turn (g-empty? (n/read-message st0 (g-nn-c0)))
        o0 (n/write-message st0 (g-nn-p0))
        st1 (g-head o0)
        o1 (n/read-message st1 (g-nn-c1))
        st2 (g-head o1)
        o2 (n/transport-encrypt st2 (g-nn-p2))
        st3 (g-head o2)
        o3 (n/transport-decrypt st3 (g-nn-c3))
        st4 (g-head o3)
        o4 (n/transport-encrypt st4 (g-nn-p4))
        st5 (g-head o4)
        o5 (n/transport-decrypt st5 (g-nn-c5))
        st6 (g-head o5)]
    (+ (if (and (= (vector-count o0) (+ (n/state-size) (vector-count (g-nn-c0)))) (same? (g-tail o0) (g-nn-c0)) (= (vector-count o1) (+ (n/state-size) (vector-count (g-nn-p1)))) (same? (g-tail o1) (g-nn-p1))) 1 0)
       (if (same? (n/handshake-hash st2) (g-nn-hh)) 2 0)
       (if (and (= (vector-count o2) (+ (n/state-size) (vector-count (g-nn-c2)))) (same? (g-tail o2) (g-nn-c2)) (= (vector-count o3) (+ (n/state-size) (vector-count (g-nn-p3)))) (same? (g-tail o3) (g-nn-p3)) (= (vector-count o4) (+ (n/state-size) (vector-count (g-nn-c4)))) (same? (g-tail o4) (g-nn-c4)) (= (vector-count o5) (+ (n/state-size) (vector-count (g-nn-p5)))) (same? (g-tail o5) (g-nn-p5))) 4 0)
       (if (g-empty? (n/read-message st1 (g-flip (g-nn-c1) (- (vector-count (g-nn-c1)) 1)))) 8 0)
       (if bad-turn 16 0))))

(defn group-nn-r [] :i64
  (let [st0 (n/initialize 0 false (vector-i64) (g-nn-resp-eph) (vector-i64) (g-nn-prologue))
