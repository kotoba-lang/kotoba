       (if (same? (n/handshake-hash st2) (g-nn-hh)) 2 0)
       (if (and (= (vector-count o2) (+ (n/state-size) (vector-count (g-nn-p2)))) (same? (g-tail o2) (g-nn-p2)) (= (vector-count o3) (+ (n/state-size) (vector-count (g-nn-c3)))) (same? (g-tail o3) (g-nn-c3)) (= (vector-count o4) (+ (n/state-size) (vector-count (g-nn-p4)))) (same? (g-tail o4) (g-nn-p4)) (= (vector-count o5) (+ (n/state-size) (vector-count (g-nn-c5)))) (same? (g-tail o5) (g-nn-c5))) 4 0)
