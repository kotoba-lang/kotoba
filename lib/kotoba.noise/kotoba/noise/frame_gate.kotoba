;; noise.frame-gate -- the framing of noise.frame (AWAI-102). main returns 63:
;;   1 frame / unframe round trips at 0, 1, 255, 256 and 65535 bytes
;;   2 the length prefix is big-endian (256 bytes -> 0x01 0x00)
;;   4 a 65536-byte message and a non-byte value are refused
;;   8 an incomplete buffer (no length, or fewer bytes than the length) gives -1 / [-1]
;;  16 two frames back to back: the first is read and frame-end says where the next starts
;;  32 the largest frame is exactly 65537 bytes
(ns noise.frame-gate
  (:require [noise.frame :as f])
  (:export [main]))

(defn- pat [n :i64] :vector-i64 (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (rem (+ (* 7 i) 3) 256))))))
(defn- slice [v :vector-i64 start :i64 n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ start i)))))))
(defn- cat [a :vector-i64 b :vector-i64] :vector-i64
  (let [na (vector-count a) out (vector-alloc (+ na (vector-count b)))]
    (loop [i 0] (if (= i (vector-count out)) out
      (let [z (vector-assoc! out i (if (< i na) (vector-at a i) (vector-at b (- i na))))] (recur (+ i 1)))))))
(defn- same? [a :vector-i64 b :vector-i64] :bool
  (and (= (vector-count a) (vector-count b))
       (loop [i 0] (if (= i (vector-count a)) true (if (= (vector-at a i) (vector-at b i)) (recur (+ i 1)) false)))))
(defn- round? [n :i64] :bool (same? (f/unframe (f/frame (pat n))) (pat n)))
(defn- incomplete? [v :vector-i64] :bool (and (= (vector-count v) 1) (= (vector-at v 0) -1)))

(defn main [] :i64
  (let [two (cat (f/frame (pat 5)) (f/frame (pat 9)))
        big (f/frame (pat 65535))
        bad (let [v (pat 3)] (vector-assoc! v 1 256))]
    (+ (if (and (round? 0) (round? 1) (round? 255) (round? 256) (round? 65535)) 1 0)
       (if (and (= (vector-at (f/frame (pat 256)) 0) 1) (= (vector-at (f/frame (pat 256)) 1) 0)
                (= (vector-at (f/frame (pat 255)) 0) 0) (= (vector-at (f/frame (pat 255)) 1) 255)) 2 0)
       (if (and (= (vector-count (f/frame (pat 65536))) 0) (= (vector-count (f/frame bad)) 0)) 4 0)
       (if (and (= (f/frame-end (vector-i64 0)) -1) (incomplete? (f/unframe (vector-i64)))
                (incomplete? (f/unframe (slice (f/frame (pat 10)) 0 11)))) 8 0)
       (if (and (same? (f/unframe two) (pat 5)) (= (f/frame-end two) 7)
                (same? (f/unframe (slice two 7 11)) (pat 9))) 16 0)
       (if (= (vector-count big) 65537) 32 0))))
