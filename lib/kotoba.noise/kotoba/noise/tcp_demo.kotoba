;; noise.tcp-demo -- the XXhfs handshake with ADR-0001 identities over native loopback TCP
;; (AWAI-102). Generated by tools/gen_identity_gate.py with the identity gate's inputs, so
;; every frame on the wire must equal the oracle's message byte for byte. One Linux static
;; image is both sides: it listens on 127.0.0.1:47011, dials it and accepts. main returns
;; 63: 1 the five frames received equal the oracle's messages, 2 both sides reach the
;; oracle's handshake hash, 4 each side verifies the other's identity against the expected
;; one, 8 every payload arrives, 16 a 65536-byte message is refused by send-frame, 32
;; after the dialer closes, the next recv-frame reports the end of the stream.
;; Grants: KEXE_ALLOW=43,44,45,46,47, KEXE_CAP_RESOURCES_43 and _45 = 127.0.0.1:47011.
(ns noise.tcp-demo
  (:require [noise.native :as n] [noise.identity :as id] [noise.tcp :as t])
  (:export [main]))

(defn- cat [p :vector-i64 q :vector-i64] :vector-i64
  (let [np (vector-count p) out (vector-alloc (+ np (vector-count q)))]
    (loop [i 0] (if (= i (vector-count out)) out
      (let [z (vector-assoc! out i (if (< i np) (vector-at p i) (vector-at q (- i np))))] (recur (+ i 1)))))))
(defn- g-slice [v :vector-i64 start :i64 n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ start i)))))))
(defn- g-head [o :vector-i64] :vector-i64 (if (< (vector-count o) (n/state-size)) (vector-i64) (g-slice o 0 (n/state-size))))
(defn- g-tail [o :vector-i64] :vector-i64
  (if (< (vector-count o) (n/state-size)) (vector-i64 -1) (g-slice o (n/state-size) (- (vector-count o) (n/state-size)))))
(defn- same? [p :vector-i64 q :vector-i64] :bool
  (and (= (vector-count p) (vector-count q))
       (loop [i 0] (if (= i (vector-count p)) true (if (= (vector-at p i) (vector-at q i)) (recur (+ i 1)) false)))))
(defn- incomplete? [v :vector-i64] :bool (and (= (vector-count v) 1) (= (vector-at v 0) -1)))

