(defn- g-c3 [] :vector-i64 (vector-i64 174 30 202 10 37 78 80 180 101 252 217 127 114 71 8 148 159 191 216 113 249 16 165 139 5 27 118))
(defn- g-c4 [] :vector-i64 (vector-i64 7 104 236 13 151 241 218 115 111 129 108 61 197 14 106 88 42 67 37 101 232 215 183 157 39 221 252 235 197 25 224 37 89))

(defn main [] :i64
  (let [l (t/listen "127.0.0.1:47011") c (t/dial "127.0.0.1:47011" 2000) s (t/accept l 2000)
        i0 (n/set-kem (n/initialize 3 true (g-is) (g-ie) (vector-i64) (g-prologue)) (g-dz) (vector-i64))
        r0 (n/set-kem (n/initialize 3 false (g-rs) (g-re) (vector-i64) (g-prologue)) (vector-i64) (g-m))
        ;; message 1: initiator -> responder
        o0 (n/write-message i0 (g-p0)) i1 (g-head o0) x0 (t/send-frame c (g-tail o0))
        f0 (t/recv-frame s 2000) q0 (n/read-message r0 f0) r1 (g-head q0)
        ;; message 2: responder -> initiator, with the responder's identity
        t1 (n/write-tokens r1) pl1 (id/payload (g-id-r-ed) (g-id-r-xi) (n/handshake-hash-now (g-head t1)))
        o1 (n/write-payload (g-head t1) (g-tail t1) pl1) r2 (g-head o1) x1 (t/send-frame s (g-tail o1))
        f1 (t/recv-frame c 2000) u1 (n/read-tokens i1 f1) h1 (n/handshake-hash-now (g-head u1))
        v1 (n/read-payload (g-head u1) (g-tail u1)) i2 (g-head v1)
        ok1 (id/verify-payload (g-tail v1) h1 (g-want-r))
        ;; message 3: initiator -> responder, with the initiator's identity
        t2 (n/write-tokens i2) pl2 (id/payload (g-id-i-ed) (g-id-i-xi) (n/handshake-hash-now (g-head t2)))
        o2 (n/write-payload (g-head t2) (g-tail t2) pl2) i3 (g-head o2) x2 (t/send-frame c (g-tail o2))
        f2 (t/recv-frame s 2000) u2 (n/read-tokens r2 f2) h2 (n/handshake-hash-now (g-head u2))
        v2 (n/read-payload (g-head u2) (g-tail u2)) r3 (g-head v2)
        ok2 (id/verify-payload (g-tail v2) h2 (g-want-i))
        ;; transport: responder -> initiator, then initiator -> responder
        o3 (n/transport-encrypt r3 (g-p3)) x3 (t/send-frame s (g-tail o3))
        f3 (t/recv-frame c 2000) q3 (n/transport-decrypt i3 f3) i4 (g-head q3)
        o4 (n/transport-encrypt i4 (g-p4)) x4 (t/send-frame c (g-tail o4))
        f4 (t/recv-frame s 2000) q4 (n/transport-decrypt (g-head o3) f4)
        big (t/send-frame c (vector-alloc 65536))
        cl (t/close c) eof (t/recv-frame s 500)]
    (+ (if (and (same? f0 (g-c0)) (same? f1 (g-c1)) (same? f2 (g-c2)) (same? f3 (g-c3)) (same? f4 (g-c4))) 1 0)
       (if (and (same? (n/handshake-hash i3) (g-hh)) (same? (n/handshake-hash r3) (g-hh))) 2 0)
       (if (and ok1 ok2) 4 0)
       (if (and (same? (g-tail q0) (g-p0)) (same? (g-tail q3) (g-p3)) (same? (g-tail q4) (g-p4))) 8 0)
       (if (= big -1) 16 0)
       (if (incomplete? eof) 32 0))))
