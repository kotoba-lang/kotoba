;; noise.frame -- the length-prefixed framing of ADR-0001 (AWAI-102): a 2-byte big-endian
;; length, then that many bytes, at most 65535 (the Noise maximum message length). libp2p
;; frames Noise handshake messages the same way. Bytes are :vector-i64 of 0..255.
;;   frame msg       -> length (2) ++ msg; empty when msg is over 65535 bytes or holds a
;;                      value that is not a byte
;;   frame-end buf   -> the byte count of the first complete frame in buf (2 + length),
;;                      or -1 while it is incomplete
;;   unframe buf     -> the first frame's body, or [-1] while it is incomplete (an empty
;;                      body is a valid frame, so incomplete cannot be the empty vector)
(ns noise.frame
  (:export [frame frame-end unframe max-message]))

(defn max-message [] :i64 65535)
(defn- bytes? [v :vector-i64] :bool
  (loop [i 0] (if (= i (vector-count v)) true (if (and (>= (vector-at v i) 0) (<= (vector-at v i) 255)) (recur (+ i 1)) false))))

(defn frame [msg :vector-i64] :vector-i64
  (let [n (vector-count msg)]
    (if (or (> n 65535) (not (bytes? msg))) (vector-i64)
      (let [out (vector-alloc (+ n 2))
            a (vector-assoc! out 0 (quot n 256))
            b (vector-assoc! out 1 (rem n 256))]
        (loop [i 0] (if (= i n) out (let [x (vector-assoc! out (+ i 2) (vector-at msg i))] (recur (+ i 1)))))))))

(defn frame-end [buf :vector-i64] :i64
  (if (< (vector-count buf) 2) -1
    (let [n (+ (* 256 (vector-at buf 0)) (vector-at buf 1))]
      (if (< (vector-count buf) (+ n 2)) -1 (+ n 2)))))

(defn unframe [buf :vector-i64] :vector-i64
  (let [end (frame-end buf)]
    (if (< end 0) (vector-i64 -1)
      (loop [i 2 out (vector-alloc (- end 2))]
        (if (= i end) out (recur (+ i 1) (vector-assoc! out (- i 2) (vector-at buf i))))))))
