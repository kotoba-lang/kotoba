))) (cat (cat (vector-i64 251 135 78 68 201 239 98 196 42 212 95 5 85 10 141 163 23 5 93 55 71 254 159 220 255 168 69 194 20 65 23 83 100 93 154 26 108 105 12 141 142 240 175 36 152 177 70 151 126 96 53 78 141 79 234 142 126 83 111 175 203 235 173 11) (vector-i64 196 91 103 77 58 173 89 149 83 16 255 138 46 125 228 3 134 122 65 61 106 163 199 91 253 0 4 254 120 246 64 72 189 181 235 180 141 248 142 26 137 227 54 154 193 209 201 223 4 83 27 100 171 36 242 1 134 137 231 126 137 15 188 154)) (vector-i64 19 253 226 244 116 148 151 207 242 75 21 74 250 224 178 81 95 112 119 24 24 119 98 54 39 220 219 83 25 56 11 217 146 124 24 40 0 40 97 77 131 58 7 193 225 172 50 136 8 93 192 248 246 117 221 114 233 241 8 146 23 20 7))))
(defn- g-c2 [] :vector-i64 (cat (vector-i64 120 10 160 168 37 170 56 93 84 91 180 95 88 1 57 229 63 222 234 223 221 120 45 21 98 17 81 232 73 193 72 52 22 75 85 253 174 89 135 159 65 211 228 85 220 175 243 2 127 71 146 147 251 74 75 1 208 144 254 65 99 63 232 40) (vector-i64 112 124 118 145 125 170 102 196 196 185 240)))
(defn- g-c3 [] :vector-i64 (vector-i64 174 30 202 10 37 78 80 180 101 252 217 127 114 71 8 148 159 191 216 113 249 16 165 139 5 27 118))
(defn- g-c4 [] :vector-i64 (vector-i64 7 104 236 13 151 241 218 115 111 129 108 61 197 14 106 88 42 67 37 101 232 215 183 157 39 221 252 235 197 25 224 37 89))

(defn group-i [] :i64
  (let [st0 (n/set-kem (n/initialize 3 true (g-is) (g-ie) (vector-i64) (g-prologue)) (g-dz) (vector-i64))
        bad-turn (g-empty? (n/read-message st0 (g-c0)))
        no-kem (g-empty? (n/write-message (n/initialize 3 true (g-is) (g-ie) (vector-i64) (g-prologue)) (g-p0)))
        o0 (n/write-message st0 (g-p0))
        st1 (g-head o0)
        o1 (n/read-message st1 (g-c1))
        st2 (g-head o1)
        o2 (n/write-message st2 (g-p2))
        st3 (g-head o2)
        o3 (n/transport-decrypt st3 (g-c3))
        st4 (g-head o3)
        o4 (n/transport-encrypt st4 (g-p4))
        st5 (g-head o4)]
    (+ (if (and (same? (g-tail o0) (g-c0)) (same? (g-tail o1) (g-p1)) (same? (g-tail o2) (g-c2))) 1 0)
       (if (same? (n/handshake-hash st3) (g-hh)) 2 0)
       (if (and (same? (g-tail o3) (g-p3)) (same? (g-tail o4) (g-c4))) 4 0)
       (if (g-empty? (n/read-message st1 (g-flip (g-c1) 40))) 8 0)
       (if bad-turn 16 0)
       (if no-kem 32 0))))

(defn group-r [] :i64
  (let [st0 (n/set-kem (n/initialize 3 false (g-rs) (g-re) (vector-i64) (g-prologue)) (vector-i64) (g-m))
        bad-turn (g-empty? (n/write-message st0 (g-c0)))
        no-kem (g-empty? (n/write-message (g-head (n/read-message (n/initialize 3 false (g-rs) (g-re) (vector-i64) (g-prologue)) (g-c0))) (g-p1)))
        o0 (n/read-message st0 (g-c0))
        st1 (g-head o0)
        o1 (n/write-message st1 (g-p1))
        st2 (g-head o1)
        o2 (n/read-message st2 (g-c2))
        st3 (g-head o2)
        o3 (n/transport-encrypt st3 (g-p3))
        st4 (g-head o3)
        o4 (n/transport-decrypt st4 (g-c4))
        st5 (g-head o4)]
    (+ (if (and (same? (g-tail o0) (g-p0)) (same? (g-tail o1) (g-c1)) (same? (g-tail o2) (g-p2))) 1 0)
       (if (same? (n/handshake-hash st3) (g-hh)) 2 0)
       (if (and (same? (g-tail o3) (g-c3)) (same? (g-tail o4) (g-p4))) 4 0)
       (if (g-empty? (n/read-message st2 (g-flip (g-c2) 40))) 8 0)
       (if bad-turn 16 0)
       (if no-kem 32 0))))
