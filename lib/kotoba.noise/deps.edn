{:paths ["src"]
 :version "0.1.0"
 ;; kotoba.bytes supplies the portable byte-vector primitives (hex, base64,
 ;; constant-time-eq, SHA-256 for the SHA256 suite). Nothing else — the two
 ;; primitives that must be constant-time are injected by the caller's provider,
 ;; not depended on here (see noise.suite).
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}}
 :aliases
 {:test {:extra-paths ["test"]}
}}
