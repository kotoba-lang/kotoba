;; Public fixtures only. Native output corpus plus independent fixed KATs.
;; Invoked from the retained OS ValueRuntime export root; no user/app claim.
(ns noise.blake2s-region-gate
  (:require [noise.blake2s-region :as hash])
  (:export [run]))
(defn p [i v] (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0 v))
(defn word [i] (kernel-load-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0))
(defn context-byte [i] (kernel-load-u8-4k (kernel-subregion (kernel-browser-context) 8192 0 4096) 4096 i))
(defn context-put [i value] (kernel-store-u8-4k (kernel-subregion (kernel-browser-context) 8192 0 4096) 4096 i value))
(defn result-byte [i] (kernel-load-u8-16k (kernel-desktop-effects) 16384 i))
(defn result-put [i x] (kernel-store-u8-16k (kernel-desktop-effects) 16384 i x))
(defn err [result]
  (if (= result 1) 1 (do (p 75 (+ (word 75) 1)) 0)))
(defn pattern [i] (mod (+ (* i 17) 3) 256))
(defn absorb [st n i]
  (if (>= i n) 1
    (if (= (hash/update-byte st 512 (pattern i)) 1) (absorb st n (+ i 1)) (err 0))))
(defn save [st which i]
  (if (>= i 32) 1
    (do (result-put (+ (* which 32) i) (hash/digest-byte st 512 i)) (save st which (+ i 1)))))
(defn one [st n which]
  (do (err (hash/init st 512)) (err (absorb st n 0)) (err (hash/finish st 512)) (save st which 0)))
(defn corpus [st n]
  (if (>= n 258) 1 (do (p 72 (+ 1000 n)) (one st n n) (corpus st (+ n 1)))))
(defn key-length [i] (case i 0 0 1 32 2 64 3 65 4 100 4096))
(defn message-length [i] (case i 0 0 1 1 2 63 3 64 4 65 5 257 4096))
(defn hmac-key [st n i]
  (if (>= i n) 1
    (if (= (hash/hmac-key-byte st 512 (mod (+ (* i 29) 11) 256)) 1)
      (hmac-key st n (+ i 1)) (err 0))))
(defn hmac-message [st n i]
  (if (>= i n) 1
    (if (= (hash/hmac-update-byte st 512 (pattern i)) 1)
      (hmac-message st n (+ i 1)) (err 0))))
(defn hmacs [st key message]
  (if (>= key 6) 1
    (if (>= message 7) (hmacs st (+ key 1) 0)
      (do (p 72 (+ 2000 (* key 7) message)) (err (hash/hmac-key-init st 512)) (err (hmac-key st (key-length key) 0))
          (err (hash/hmac-key-finish st 512)) (err (hmac-message st (message-length message) 0))
          (err (hash/hmac-finish st 512)) (save st (+ 261 (* key 7) message) 0)
          (hmacs st key (+ message 1))))))
(defn expected [which i]
  (bit-and (u64-shift-right
    (if (= which 0)
      (case (quot i 8) 0 -2155961765058409392 1 3406387416153171937 2 2970922878843438391 -9054091749343127219)
      (case (quot i 8) 0 2327674444576453866 1 -676812367973701913 2 6612185248318360636 -3667506787413956645))
    (* (mod i 8) 8)) 255))
(defn known [at which i]
  (if (>= i 32) 1
    (if (= (result-byte (+ at i)) (expected which i)) (known at which (+ i 1)) 0)))
(defn snapshot [st i]
  (if (>= i 512) 1
    (do (result-put (+ 12000 i) (kernel-load-u8 st 512 i)) (snapshot st (+ i 1)))))
(defn unchanged [st i]
  (if (>= i 512) 1
    (if (= (result-byte (+ 12000 i)) (kernel-load-u8 st 512 i)) (unchanged st (+ i 1)) 0)))
(defn zero [st i]
  (if (>= i 512) 1
    (if (= (kernel-load-u8 st 512 i) 0) (zero st (+ i 1)) 0)))
(defn bit [ok :bool value :i64] :i64 (if ok value 0))
(defn guards [st]
  (do (hash/wipe st 512) (snapshot st 0)
      (p 76 (bit (and (= (hash/update-byte st 512 1) 0) (= (hash/finish st 512) 0)
                      (= (hash/digest-byte st 512 0) -1) (= (unchanged st 0) 1)) 1))
      (hash/init st 512) (hash/update-byte st 512 7) (snapshot st 0)
      (p 76 (+ (word 76) (bit (and (= (hash/init st 511) 0) (= (hash/wipe st -1) 0) (= (hash/wipe st 511) 0)
        (= (hash/hmac-key-init st 511) 0)
        (= (hash/update-byte st 511 1) 0) (= (hash/update-byte st 512 -1) 0)
        (= (hash/update-byte st 512 256) 0) (= (hash/finish st 511) 0)
        (= (hash/digest-byte st 511 0) -1) (= (unchanged st 0) 1)) 2)))
      (hash/finish st 512) (snapshot st 0)
      (p 76 (+ (word 76) (bit (and (= (hash/update-byte st 512 1) 0) (= (hash/finish st 512) 0)
        (= (hash/digest-byte st 512 -1) -1) (= (hash/digest-byte st 512 32) -1)
        (= (hash/hmac-update-byte st 512 1) 0) (= (unchanged st 0) 1)) 4)))
      (hash/hmac-key-init st 512) (hash/hmac-key-byte st 512 11) (snapshot st 0)
      (p 76 (+ (word 76) (bit (and (= (hash/update-byte st 512 1) 0) (= (hash/finish st 512) 0)
        (= (hash/hmac-update-byte st 512 1) 0) (= (hash/hmac-finish st 512) 0)
        (= (hash/hmac-key-byte st 512 -1) 0) (= (hash/hmac-key-byte st 512 256) 0)
        (= (hash/hmac-key-byte st 511 1) 0)
        (= (hash/hmac-key-finish st 511) 0) (= (hash/digest-byte st 512 0) -1) (= (unchanged st 0) 1)) 8)))
      (hash/hmac-key-finish st 512) (snapshot st 0)
      (p 76 (+ (word 76) (bit (and (= (hash/hmac-key-byte st 512 1) 0) (= (hash/hmac-key-finish st 512) 0)
        (= (hash/update-byte st 512 1) 0) (= (hash/finish st 512) 0)
        (= (hash/hmac-update-byte st 512 256) 0) (= (hash/hmac-update-byte st 511 1) 0)
        (= (hash/hmac-finish st 511) 0) (= (unchanged st 0) 1)) 16)))
      (hash/hmac-finish st 512) (snapshot st 0)
      (p 76 (+ (word 76) (bit (and (= (hash/hmac-update-byte st 512 1) 0) (= (hash/hmac-finish st 512) 0)
        (= (hash/hmac-key-byte st 512 1) 0) (>= (hash/digest-byte st 512 0) 0) (= (unchanged st 0) 1)) 32)))
      (hash/init st 512) (kernel-store-u32 st 512 224 4294967295)
      (kernel-store-u32 st 512 228 4294967295) (kernel-store-u32 st 512 232 63) (snapshot st 0)
      (p 76 (+ (word 76) (bit (and (= (hash/update-byte st 512 1) 0) (= (unchanged st 0) 1)) 64)))
      (hash/init st 512) (kernel-store-u32 st 512 224 4294967295)
      (kernel-store-u32 st 512 228 1) (kernel-store-u32 st 512 232 63)
      (p 76 (+ (word 76) (bit (and (= (hash/update-byte st 512 170) 1)
        (= (kernel-load-u32 st 512 224) 0) (= (kernel-load-u32 st 512 228) 2)
        (= (kernel-load-u32 st 512 232) 64) (= (kernel-load-u8 st 512 223) 170)) 128)))
      (hash/wipe st 512)
      (p 76 (+ (word 76) (bit (and (= (zero st 0) 1) (= (hash/digest-byte st 512 0) -1)) 256)))
      (hash/init st 512) (kernel-store-u32 st 512 232 65) (snapshot st 0)
      (p 76 (+ (word 76) (bit (and (= (hash/update-byte st 512 1) 0) (= (hash/finish st 512) 0)
        (= (unchanged st 0) 1)) 512))) (hash/wipe st 512)))
(defn park [] (do (kernel-pause) (park)))
(defn run [] :i64
  (let [st (kernel-subregion (kernel-browser-context) 8192 1024 512)
        irq (kernel-cli)]
    (do (p 72 1) (p 75 0) (p 76 0)
        (context-put 1023 165) (context-put 1536 90)
        (corpus st 0)
        (hash/init st 512) (hash/update-byte st 512 97) (hash/update-byte st 512 98)
        (hash/update-byte st 512 99) (hash/finish st 512) (save st 258 0)
        (p 72 65536) (one st 65536 259) (p 72 1048576) (one st 1048576 260) (hmacs st 0 0)
        (p 74 (+ (known (* 258 32) 0 0) (* 2 (known (* 261 32) 1 0))))
        (p 72 3000) (guards st)
        (p 77 (bit (and (= (context-byte 1023) 165) (= (context-byte 1536) 90)) 1))
        (p 78 303) (p 79 (+ 1 (* irq 0))) (park))))
