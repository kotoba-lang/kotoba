      (check (= (d/seal st (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 65536) 65536 101) -1))
      (check (= (unchanged st 0) 1)) (check (= (same-wire-sentinel 0) 1))
      (d/set-length st 17408 1) (snapshot st 0)
      (check (= (d/seal st (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 0) 0
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 25) 25 101) -1))
      (check (= (d/seal st (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 1) 1
