;; CPU-only real IK -> region datagram fixtures, public keys only.
(ns noise.datagram-region-gate
  (:require [noise.datagram-region :as d] [noise.ik-region :as n] [noise.blake2s-region :as h])
  (:export [run]))
(defn p [i v] (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0 v))
(defn word [i] (kernel-load-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0))
(defn check [yes :bool] :i64 (if yes 1 (do (p 75 (+ (word 75) 1)) 0)))
(defn data [i] (kernel-load-u8 (kernel-subregion (kernel-native-font) 524288 393280 512) 512 i))
(defn sb [st i] (kernel-load-u8-64k st 17408 i))
(defn sp [st i v] (kernel-store-u8-64k st 17408 i v))
(defn ld [st i] (kernel-load-u64 (kernel-subregion st 17408 i 8) 8 0))
(defn put [st i v] (kernel-store-u64 (kernel-subregion st 17408 i 8) 8 0 v))
(defn ib [i] (kernel-load-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536 i))
(defn ip [i v] (kernel-store-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536 i v))
(defn wb [i] (kernel-load-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 65536) 65536 i))
(defn wp [i v] (kernel-store-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 65536) 65536 i v))
(defn ob [i] (kernel-load-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 65536) 65536 i))
(defn op [i v] (kernel-store-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 65536) 65536 i v))
(defn sentinel [i]
  (if (>= i 65536) 1 (do (op i 165) (sentinel (+ i 1)))))
(defn same-sentinel [i]
  (if (>= i 65536) 1 (if (= (ob i) 165) (same-sentinel (+ i 1)) 0)))
(defn wire-sentinel [i]
  (if (>= i 65536) 1 (do (wp i 165) (wire-sentinel (+ i 1)))))
(defn same-wire-sentinel [i]
  (if (>= i 65536) 1 (if (= (wb i) 165) (same-wire-sentinel (+ i 1)) 0)))
(defn snapshot [st i]
  (if (>= i 17408) 1
    (do (kernel-store-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 34816 17408) 17408 i (sb st i))
        (snapshot st (+ i 1)))))
(defn unchanged [st i]
  (if (>= i 17408) 1
    (if (= (sb st i) (kernel-load-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 34816 17408) 17408 i))
      (unchanged st (+ i 1)) 0)))
(defn zero [st i end]
  (if (>= i end) 1 (if (= (sb st i) 0) (zero st (+ i 1) end) 0)))
(defn hash-start [] (h/init (kernel-subregion (kernel-browser-context) 8192 2048 512) 512))
(defn hash-feed [i end]
  (if (>= i end) 1
    (do (h/update-byte (kernel-subregion (kernel-browser-context) 8192 2048 512) 512 (wb i)) (hash-feed (+ i 1) end))))
(defn hash-save [slot i]
  (if (>= i 32) (p 78 (+ (word 78) 1))
    (do (kernel-store-u8 (kernel-subregion (kernel-browser-context) 8192 (+ 4096 (* slot 32) i) 1) 1 0
          (h/digest-byte (kernel-subregion (kernel-browser-context) 8192 2048 512) 512 i)) (hash-save slot (+ i 1)))))
(defn log-wire [slot count]
  (do (hash-start) (hash-feed 0 count) (h/finish (kernel-subregion (kernel-browser-context) 8192 2048 512) 512) (hash-save slot 0)))
(defn log-field [st kind slot i]
  (if (>= i 32) (p 78 (+ (word 78) 1))
    (do (kernel-store-u8 (kernel-subregion (kernel-browser-context) 8192 (+ 4096 (* slot 32) i) 1) 1 0
          (n/get-byte st 8192 kind i)) (log-field st kind slot (+ i 1)))))
(defn seed [st side i]
  (if (>= i 32) 1
    (do (kernel-store-u8-16k st 8192 (+ 160 i) (data (+ (* side 64) i)))
        (kernel-store-u8-16k st 8192 (+ 224 i) (data (+ (* side 64) 32 i)))
        (kernel-store-u8-16k st 8192 (+ 288 i) (if (= side 0) (data (+ 128 i)) 0)) (seed st side (+ i 1)))))
(defn prologue [st i]
  (if (>= i 9) 1
    (do (check (= (n/prologue-byte st 8192 (case i 0 74 1 111 2 104 3 110 4 32 5 71 6 97 7 108 116)) 1)) (prologue st (+ i 1)))))
(defn init-hs [st side]
  (do (seed st side 0) (check (= (n/initialize st 8192 (- 1 side) (- 1 side)) 1))
      (prologue st 0) (check (= (n/prologue-finish st 8192) 1))))
(defn hs-plain [side i]
  (if (>= i (if (= side 0) 16 15)) 1
    (do (ip i (data (+ 448 (* side 32) i))) (hs-plain side (+ i 1)))))
(defn save-token [st i]
  (if (>= i 80) 1
    (do (kernel-store-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 (+ 52224 i) 1) 1 0
          (n/token-byte st 8192 i)) (save-token st (+ i 1)))))
(defn same-token [i]
  (if (>= i 80) 1
    (if (= (kernel-load-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 (+ 52224 i) 1) 1 0) (wb i))
      (same-token (+ i 1)) 0)))
(defn cache-hs [st at i]
  (if (>= i 8192) 1
    (do (kernel-store-u8-16k (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 8192) 8192 i
          (kernel-load-u8-16k st 8192 i)) (cache-hs st at (+ i 1)))))
(defn same-hs-field [st kind at i]
  (if (>= i 32) 1 (if (= (n/get-byte st 8192 kind i) (data (+ at i))) (same-hs-field st kind at (+ i 1)) 0)))
(defn handshake [a r]
  (do (init-hs a 0) (init-hs r 1) (hs-plain 0 0)
      (check (= (n/set-length a 8192 16) 1)) (check (= (n/prepare-write a 8192) 1)) (save-token a 0)
      (check (= (n/write-message a (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 65536) 65536) 112))
      (check (= (same-token 0) 1)) (check (= (n/token-byte a 8192 0) -1))
      (log-wire 0 112)
      (check (= (n/set-length r 8192 80) 1))
      (check (= (n/prepare-read r (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 80) 80) 1))
      (check (= (n/set-length r 8192 112) 1))
      (check (= (n/read-message r (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 112) 112
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 65536) 65536) 16))
      (hs-plain 1 0) (check (= (n/set-length r 8192 15) 1))
      (check (= (n/write-message r (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 65536) 65536) 63))
      (log-wire 1 63) (check (= (n/set-length a 8192 63) 1))
      (check (= (n/read-message a (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 63) 63
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 65536) 65536) 15))
      (check (= (n/status a 8192) 3)) (check (= (n/status r 8192) 3))
      (check (= (same-hs-field a 0 192 0) 1)) (check (= (same-hs-field r 0 192 0) 1))
      (check (= (same-hs-field r 1 160 0) 1))
      (log-field a 0 2 0) (log-field a 2 3 0) (log-field a 3 4 0)
      (p 74 (same-hs-field a 0 192 0))
      (cache-hs a 98304 0) (cache-hs r 106496 0)
      (n/wipe a 8192) (n/wipe r 8192)))
(defn reset [st hs side now]
  (check (= (d/from-handshake st 17408 hs 8192 (kernel-subregion (kernel-native-font) 524288 (+ 393408 (* side 32)) 32) 32 now) 1)))
(defn fresh []
  (do (reset (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 17408)
         (kernel-subregion (kernel-value-domain-request-page 73) 262144 98304 8192) 0 100)
      (reset (kernel-subregion (kernel-value-domain-request-page 73) 262144 17408 17408)
         (kernel-subregion (kernel-value-domain-request-page 73) 262144 106496 8192) 1 100)))
(defn size [index] (case index 0 0 1 1 2 15 3 16 4 17 5 63 6 64 7 65 8 257 9 1024 10 4096 65511))
(defn plain [side count i]
  (if (>= i count) 1 (do (ip i (mod (+ (* i 17) (* side 13) 3) 256)) (plain side count (+ i 1)))))
(defn same-plain [side count i]
  (if (>= i count) 1 (if (= (ob i) (mod (+ (* i 17) (* side 13) 3) 256)) (same-plain side count (+ i 1)) 0)))
(defn payload-case [sender receiver index side]
  (do (plain side (size index) 0) (check (= (d/set-length sender 17408 (size index)) 1))
      (check (= (d/seal sender (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 65536) 65536 101) (+ (size index) 24)))
      (check (= (zero sender 16512 17024) 1)) (log-wire (+ 5 (* index 2) side) (+ (size index) 24))
      (check (= (d/set-length receiver 17408 (+ (size index) 24)) 1)) (sentinel 0)
      (check (= (d/open receiver (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 65536) 65536 101) (size index)))
      (check (= (same-plain side (size index) 0) 1)) (check (= (zero receiver 16512 17024) 1))))
(defn payloads [index]
  (if (>= index 11) 1
    (do (fresh) (payload-case (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 17408)
                 (kernel-subregion (kernel-value-domain-request-page 73) 262144 17408 17408) index 0)
        (fresh) (payload-case (kernel-subregion (kernel-value-domain-request-page 73) 262144 17408 17408)
                 (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 17408) index 1) (payloads (+ index 1)))))
(defn max-payload [sender receiver side]
  (do (plain side 65511 0) (d/set-length sender 17408 65511)
      (check (= (d/seal sender (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65511) 65511
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 65535) 65535 101) 65535))
      (log-wire (+ 27 side) 65535) (d/set-length receiver 17408 65535) (sentinel 0)
      (check (= (d/open receiver (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 65535) 65535
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 65511) 65511 101) 65511))
      (check (= (same-plain side 65511 0) 1)) (check (= (ob 65511) 165))
      (check (= (zero sender 16512 17024) 1)) (check (= (zero receiver 16512 17024) 1))))
(defn window-seal [st i]
  (if (>= i 2048) 1
    (do (check (= (d/seal st (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 0) 0
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 (+ 131072 (* i 24)) 24) 24 101) 24))
        (window-seal st (+ i 1)))))
(defn window-open [st i duplicate]
  (if (< i 0) 1
    (do (check (= (d/open st (kernel-subregion (kernel-value-domain-request-page 73) 262144 (+ 131072 (* i 24)) 24) 24
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 0) 0 102) (if (= duplicate 0) 0 -1)))
        (window-open st (- i 1) duplicate))))
(defn marker-check [st i]
  (if (>= i 2048) 1 (if (= (ld st (+ 128 (* i 8))) (+ i 1)) (marker-check st (+ i 1)) 0)))
(defn open-at [st at now expected]
  (check (= (d/open st (kernel-subregion (kernel-value-domain-request-page 73) 262144 (+ 131072 at) 24) 24
              (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 0) 0 now) expected)))
(defn window [a r]
  (do (fresh) (check (= (d/set-length a 17408 0) 1)) (check (= (d/set-length r 17408 24) 1))
      (window-seal a 0) (log-wire 29 49152) (window-open r 2047 0)
      (check (= (ld r 16) 2047)) (check (= (ld r 40) 2048)) (check (= (marker-check r 0) 1))
      (snapshot r 0) (sentinel 0) (window-open r 2047 1)
      (check (= (unchanged r 0) 1)) (check (= (same-sentinel 0) 1))
      (check (= (d/seal a (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 0) 0
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 180224 24) 24 102) 24))
      (reset r (kernel-subregion (kernel-value-domain-request-page 73) 262144 106496 8192) 1 100)
      (d/set-length r 17408 24) (open-at r 49152 102 0) (open-at r 24 103 0) (open-at r 49128 104 0)
      (snapshot r 0) (open-at r 0 105 -1) (check (= (unchanged r 0) 1))
      (open-at r 49152 106 -1) (check (= (unchanged r 0) 1)) (open-at r 48 104 0)
      (check (= (ld r 16) 2048)) (check (= (ld r 40) 4))))
(defn synthetic [index]
  (case index 0 0 1 1 2 2047 3 2048 4 4095 5 65535 6 281474976710655 7 281474976710656 9007199254740989))
(defn counter-case [a r index]
  (do (fresh) (put a 8 (synthetic index)) (ip 0 42) (d/set-length a 17408 1)
      (check (= (d/seal a (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 1) 1
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 25) 25 101) 25))
      (log-wire (+ 30 index) 25) (d/set-length r 17408 25) (sentinel 0)
      (check (= (d/open r (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 25) 25
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 1) 1 101) 1))
      (check (= (ob 0) 42)) (check (= (ob 1) 165)) (check (= (ld r 16) (synthetic index)))
      (check (= (ld a 8) (+ (synthetic index) 1)))))
(defn counters [a r i]
  (if (>= i 9) 1 (do (counter-case a r i) (counters a r (+ i 1)))))
(defn reject [st now]
  (do (snapshot st 0) (sentinel 0)
      (check (= (d/open st (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 65536) 65536 now) -1))
      (check (= (unchanged st 0) 1)) (check (= (same-sentinel 0) 1))))
(defn tag-tests [st i]
  (if (>= i 16) 1
    (do (wp (+ 73 i) (bit-xor (wb (+ 73 i)) 1)) (reject st 110)
        (wp (+ 73 i) (bit-xor (wb (+ 73 i)) 1)) (tag-tests st (+ i 1)))))
(defn tamper [a r]
  (do (fresh) (plain 0 65 0) (d/set-length a 17408 65)
      (check (= (d/seal a (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 65536) 65536 101) 89))
      (d/set-length r 17408 89) (tag-tests r 0)
      (wp 8 (bit-xor (wb 8) 1)) (reject r 110) (wp 8 (bit-xor (wb 8) 1))
      (wp 0 1) (reject r 110) (wp 0 0)
      (wp 6 32) (reject r 110) (wp 6 0) (wp 7 128) (reject r 110) (wp 7 0)
      (sp r 96 (bit-xor (sb r 96) 1)) (reject r 110) (sp r 96 (bit-xor (sb r 96) 1))
      (check (= (ld r 16) -1)) (check (= (ld r 32) 100)) (check (= (ld r 40) 0))
      (check (= (d/open r (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 89) 89
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 65) 65 102) 65))
      (check (= (same-plain 0 65 0) 1)) (check (= (ld r 32) 102))
      (reject r 103) (check (= (ld r 32) 102))))
(defn init-refusals [st hs]
  (do (fresh) (snapshot st 0)
      (check (= (d/from-handshake (kernel-subregion st 17408 0 17407) 17407 hs 8192 (kernel-subregion (kernel-native-font) 524288 393408 32) 32 100) 0))
      (check (= (d/from-handshake st 17408 (kernel-subregion hs 8192 0 8191) 8191 (kernel-subregion (kernel-native-font) 524288 393408 32) 32 100) 0))
      (check (= (d/from-handshake st 17408 hs 8192 (kernel-subregion (kernel-native-font) 524288 393408 31) 31 100) 0))
      (check (= (d/from-handshake st 17408 hs 8192 (kernel-subregion (kernel-native-font) 524288 393408 33) 33 100) 0))
      (check (= (d/from-handshake st 17408 hs 8192 (kernel-subregion (kernel-native-font) 524288 393408 32) 32 -1) 0))
      (check (= (d/from-handshake st 17408 hs 8192 (kernel-subregion (kernel-native-font) 524288 393440 32) 32 100) 0))
      (check (= (d/from-handshake st 17408 (kernel-subregion st 17408 0 8192) 8192
                  (kernel-subregion (kernel-native-font) 524288 393408 32) 32 100) 0))
      (check (= (d/from-handshake st 17408 hs 8192 (kernel-subregion st 17408 64 32) 32 100) 0))
      (check (= (unchanged st 0) 1))
      (kernel-store-u32 (kernel-subregion hs 8192 8 4) 4 0 2)
      (check (= (d/from-handshake st 17408 hs 8192 (kernel-subregion (kernel-native-font) 524288 393408 32) 32 100) 0))
      (check (= (unchanged st 0) 1)) (kernel-store-u32 (kernel-subregion hs 8192 8 4) 4 0 3)
      (check (= (d/from-handshake st 17408 hs 8192 (kernel-subregion hs 8192 288 32) 32 100) 1))
      (check (= (zero st 16512 17024) 1))))
(defn clock-tests [st hs]
  (do (fresh) (snapshot st 0)
      (check (= (d/advice st 17408 99) 2)) (check (= (d/advice st 17408 219) 0))
      (check (= (d/advice st 17408 220) 1)) (check (= (d/advice st 17408 279) 1))
      (check (= (d/advice st 17408 280) 2)) (check (= (d/advice (kernel-subregion st 17408 0 17407) 17407 101) 2))
      (check (= (unchanged st 0) 1))
      (put st 8 281474976710655) (check (= (d/advice st 17408 101) 0))
      (put st 8 281474976710656) (check (= (d/advice st 17408 101) 1))
      (put st 8 9007199254740990) (check (= (d/advice st 17408 101) 2))
      (put st 8 -1) (check (= (d/advice st 17408 101) 2)) (put st 8 0)
      (put st 40 9007199254740990) (check (= (d/advice st 17408 101) 2)) (put st 40 0)
      (reset st hs 0 9223372036854775628) (check (= (d/advice st 17408 9223372036854775807) 1))
      (reset st hs 0 9223372036854775627) (check (= (d/advice st 17408 9223372036854775807) 2))
      (reset st hs 0 100) (d/set-length st 17408 0) (wire-sentinel 0) (snapshot st 0)
      (check (= (d/seal st (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 0) 0
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 65536) 65536 280) -1))
      (check (= (unchanged st 0) 1)) (check (= (same-wire-sentinel 0) 1))
      (check (= (d/seal st (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 0) 0
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 24) 24 279) 24))
      (check (= (ld st 32) 279)) (snapshot st 0) (wire-sentinel 0)
      (check (= (d/seal st (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 0) 0
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 65536) 65536 278) -1))
      (check (= (unchanged st 0) 1)) (check (= (same-wire-sentinel 0) 1))))
(defn receive-boundaries [a r]
  (do (fresh) (d/set-length a 17408 0) (d/set-length r 17408 24)
      (check (= (d/seal a (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 0) 0
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 24) 24 101) 24))
      (reject r 280)
      (check (= (d/open r (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 24) 24
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 0) 0 279) 0))
      (check (= (d/seal a (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 0) 0
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 24) 24 102) 24))
      (reject r 278)
      (check (= (d/open r (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 24) 24
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 0) 0 279) 0))
      (fresh) (put r 40 9007199254740989) (ip 0 42) (d/set-length a 17408 1) (d/set-length r 17408 25)
      (check (= (d/seal a (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 1) 1
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 25) 25 101) 25))
      (check (= (d/open r (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 25) 25
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 1) 1 101) 1))
      (check (= (ob 0) 42)) (check (= (ld r 40) 9007199254740990)) (check (= (d/advice r 17408 101) 2))
      (check (= (d/seal a (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 1) 1
