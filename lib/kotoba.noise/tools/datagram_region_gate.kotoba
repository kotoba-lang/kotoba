      (check (= (d/set-length (kernel-subregion st 17408 0 17407) 17407 0) 0)) (check (= (d/set-length st 17408 -1) 0))
      (check (= (d/set-length st 17408 65536) 0)) (check (= (unchanged st 0) 1))
