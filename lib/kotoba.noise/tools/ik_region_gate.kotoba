(defn setup [st test side wrong]
  (do (seed st test side 0) (if (= wrong 1) (st-put st 288 (bit-xor (st-byte st 288) 1)) 0)
      (if (and (= side 1) (= (number test 436) 0)) (clear-rs st 0) 0)
