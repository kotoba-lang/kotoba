;; Generated public Cacophony + independent datagram oracle fixture.
(ns noise.datagram-gate
  (:require [noise.datagram :as d] [noise.native :as n]) (:export [main]))
(defn- slice [v :vector-i64 off :i64 size :i64] :vector-i64
  (loop [i 0 out (vector-alloc size)] (if (= i size) out
    (recur (+ i 1) (vector-assoc! out i (vector-at v (+ off i)))))))
(defn- cat [v :vector-i64 w :vector-i64] :vector-i64
  (let [nv (vector-count v)]
    (loop [i 0 out (vector-alloc (+ nv (vector-count w)))] (if (= i (vector-count out)) out
      (recur (+ i 1) (vector-assoc! out i (if (< i nv) (vector-at v i) (vector-at w (- i nv)))))))))
(defn- same? [v :vector-i64 w :vector-i64] :bool
  (and (= (vector-count v) (vector-count w))
    (loop [i 0] (if (= i (vector-count v)) true
      (if (= (vector-at v i) (vector-at w i)) (recur (+ i 1)) false)))))
(defn- at [v :vector-i64 i :i64 value :i64] :vector-i64
  (vector-assoc! (slice v 0 (vector-count v)) i value))
(defn- empty? [v :vector-i64] :bool (= (vector-count v) 0))
(defn- hs [v :vector-i64] :vector-i64 (slice v 0 (n/state-size)))
(defn- ht [v :vector-i64] :vector-i64 (slice v (n/state-size) (- (vector-count v) (n/state-size))))
(defn- st [v :vector-i64] :vector-i64 (slice v 0 (d/state-size)))
(defn- tail [v :vector-i64] :vector-i64 (slice v (d/state-size) (- (vector-count v) (d/state-size))))
(defn main [] :i64
  (let [i0 (n/initialize 4 true @SI@ @EI@ @RP@ @PROLOGUE@)
        r0 (n/initialize 4 false @SR@ @ER@ (vector-i64) @PROLOGUE@)
        m1 (n/write-message i0 @P0@) r1 (n/read-message r0 (ht m1))
        m2 (n/write-message (hs r1) @P1@) i2 (n/read-message (hs m1) (ht m2))
        s (d/from-handshake (hs i2) @RP@ 100) r (d/from-handshake (hs m2) @SP@ 100)
        s-copy (slice s 0 (d/state-size)) r-copy (slice r 0 (d/state-size))
        a (d/seal s (vector-i64 1 104 105) 101)
        b (d/seal (st a) (vector-i64) 102)
        c (d/seal (st b) (vector-i64 3) 103)
        rc (d/open r (tail c) 104) ra (d/open (st rc) (tail a) 105)
        rb (d/open (st ra) (tail b) 106)
        backwards (d/seal r (vector-i64 7) 101)
        back (d/open s (tail backwards) 102)
        far (d/seal (at s 64 2048) (vector-i64 9) 101)
        rf (d/open r (tail far) 102)
        within (d/open (st rf) (tail b) 103)
        changed (at (tail a) (- (vector-count (tail a)) 1) (bit-xor (vector-at (tail a) (- (vector-count (tail a)) 1)) 1))]
    (+ (if (same? (tail a) @WIRE@) 1 0)
       (if (and (same? (tail rc) (vector-i64 3)) (same? (tail ra) (vector-i64 1 104 105))
                (= (vector-count rb) (d/state-size)) (same? (tail back) (vector-i64 7))) 2 0)
       (if (and (empty? (d/open (st rb) (tail c) 107))
                (empty? (d/open (st rf) (tail a) 103))
                (= (vector-count within) (d/state-size))
                (empty? (d/open (st within) (tail b) 104))) 4 0)
       (if (and (empty? (d/open r changed 101))
                (empty? (d/open r (at (tail a) 0 1) 101))
                (empty? (d/open r (at (tail a) 7 1) 101))
                (empty? (d/open r (at (tail a) 0 256) 101))
                (empty? (d/open r (slice (tail a) 0 23) 101))) 8 0)
       (if (and (= (d/advice s 219) 0) (= (d/advice s 220) 1)
                (= (d/advice s 280) 2) (= (d/advice s 99) 2)
                (empty? (d/seal s (vector-i64) 280))
                (empty? (d/open (st rb) (tail far) 105))
                (not (empty? (d/seal s (vector-i64) 279)))) 16 0)
       (if (and (empty? (d/from-handshake (hs i2) @SP@ 100))
                (empty? (d/from-handshake i0 @RP@ 100))
                (empty? (d/from-handshake (at (hs i2) 294 2) @RP@ 100))) 32 0)
       (if (and (same? s s-copy) (same? r r-copy)
                (not (empty? (d/open r (tail a) 101)))
                (empty? (d/seal s (vector-i64 -1) 101))) 64 0)
       (if (and (empty? (d/seal (at s 64 9007199254740990) (vector-i64) 101))
                (empty? (d/open r (vector-alloc 65536) 101))
                (empty? (d/seal s (vector-alloc 65512) 101))
                (empty? (d/open (vector-i64) (tail a) 101))) 128 0))))
