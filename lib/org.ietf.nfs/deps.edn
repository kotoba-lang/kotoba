{:paths ["src"]
 ;; The envelope and the codec. No transport dependency: nfs.tcp is a :clj
 ;; namespace that owns a socket and nothing else, and a different host can
 ;; replace it without touching a byte of protocol.
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/org-ietf-oncrpc {:local/root "../org.ietf.oncrpc"}
        io.github.kotoba-lang/org-ietf-xdr {:local/root "../org.ietf.xdr"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
