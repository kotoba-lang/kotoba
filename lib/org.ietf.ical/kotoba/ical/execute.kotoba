;; ical.execute -- Howard Hinnant day-number arithmetic as a pure Kotoba
;; guest (oracle: src/ical/execute.cljk).
;;
;; The oracle's date arithmetic is pure integer math -- days_from_civil /
;; civil_from_days / weekday-from-days -- which is exactly the slice a
;; Kotoba guest holds honestly: no strings, no collections, no I/O. The
;; string parsing (parse-str) and emission (emit-str) stay in the host --
;; mechanism over a value plane :container-items 32 cannot hold (a calendar
;; body is unbounded, the same boundary org-ietf-pop3 states for its body).
;;
;; The guest's date is a :document map {:y :m :d} (document-i64 fields);
;; occurrence expansion walks [from, to) in the host and calls the guest
;; per date -- one call per date is the unit the oracle's pure functions
;; already are.
;;
;; rem/mod have no admitted lowering (measured); weekday's mod is spelled
;; quot-and-subtract. The two negative branches are kept verbatim from the
;; oracle (Hinnant's era adjustment).
;;
;; Compile (single file, JVM-free):
;;   kotoba compile kotoba/ical/execute.kotoba --target wasm32-browser --output execute.wasm

(ns ical.execute
  (:export [days-from-civil civil-from-days weekday-from-days
            add-days days-between]))

;; --- days-from-civil --------------------------------------------------------

(defn- rem-7 [x :i64] :i64
  (- x (* 7 (quot x 7))))

(defn days-from-civil [y :i64 m :i64 d :i64] :i64
  (let [y2 (if (<= m 2) (- y 1) y)
        era (quot (if (>= y2 0) y2 (- y2 399)) 400)
        yoe (- y2 (* era 400))
        doy (+ (quot (+ (* 153 (if (> m 2) (- m 3) (+ m 9))) 2) 5) (- d 1))
        doe (+ (* yoe 365) (quot yoe 4) (- (quot yoe 100)) doy)]
    (+ (* era 146097) doe (- 719468))))

;; --- civil-from-days --------------------------------------------------------

(defn- at [d :document k :keyword] :i64
  (option-value-of [:option :i64]
    (document-i64-value (option-value-of [:option :document] (document-get d k) (document-null)))
    0))

(defn civil-from-days [z :i64] :document
  (let [z2 (+ z 719468)
        era (quot (if (>= z2 0) z2 (- z2 146096)) 146097)
        doe (- z2 (* era 146097))
        yoe (quot (- doe (quot doe 1460) (- (quot doe 36524)) (quot doe 146096)) 365)
        y (+ yoe (* era 400))
        doy (- doe (+ (* 365 yoe) (quot yoe 4) (- (quot yoe 100))))
        mp (quot (+ (* 5 doy) 2) 153)
        d (+ (- doy (quot (+ (* 153 mp) 2) 5)) 1)
        m (if (< mp 10) (+ mp 3) (- mp 9))
        y2 (if (<= m 2) (+ y 1) y)]
    (document-map
     :y (document-i64 y2)
     :m (document-i64 m)
     :d (document-i64 d))))

;; --- weekday ----------------------------------------------------------------

(defn weekday-from-days [z :i64] :i64
  (if (>= z (- 0 4))
    (rem-7 (+ z 4))
    (+ (rem-7 (+ z 5)) 6)))

;; --- composition ------------------------------------------------------------

(defn add-days [dt :document n :i64] :document
  (civil-from-days (+ (days-from-civil (at dt :y) (at dt :m) (at dt :d)) n)))

(defn days-between [a :document b :document] :i64
  (- (days-from-civil (at b :y) (at b :m) (at b :d))
     (days-from-civil (at a :y) (at a :m) (at a :d))))
