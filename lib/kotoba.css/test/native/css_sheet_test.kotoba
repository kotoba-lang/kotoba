(ns css-sheet-test (:export [main]) (:require [css-sheet :as css]))
(defn main [] :i64
 (let [valid (document-edn-read "[\".test\" {:height 12 :line-height 1.7 :opacity 0 :display \"grid\"}]")
       bad (document-edn-read "[\".test\" {:color \"red; color: blue\"}]")
       selector-bad (document-edn-read "[\".x {}\" {:color \"red\"}]")
       valid-result (css/rule valid)]
  (if (and (option-some?-of [:option :string] valid-result)
           (string=? (option-value-of [:option :string] valid-result "") ".test { height: 12px; line-height: 1.7; opacity: 0; display: grid; }")
           (not (option-some?-of [:option :string] (css/rule bad)))
           (not (option-some?-of [:option :string] (css/rule selector-bad)))) 42 7)))
