(ns ui-components-sheet-test (:export [main]) (:require [ui-components-sheet :as ui]))
;; Every class the shared components emit must have a rule, and the sheet must
;; render in declaration order with px units.
(defn has? [s :string needle :string] :bool (string-contains? s needle))
(defn main [] :i64
 (let [r (ui/styles) out (option-value-of [:option :string] r "")]
  (if (and (option-some?-of [:option :string] r)
  (has? out ".chip {")
  (has? out ".chip-ok {")
  (has? out ".chip-warn {")
  (has? out ".chip-error {")
  (has? out ".btn {")
  (has? out ".row {")
  (has? out ".row-title {")
  (has? out ".row-detail {")
  (has? out ".card {")
  (has? out ".panel {")
  (has? out ".tabs {")
  (has? out ".tab {")
  (has? out ".tab-selected {")
  (has? out ".field {")
  (has? out ".field-label {")
  (has? out ".btn { padding: 6px 12px; border: 0; border-radius: 6px; background: #e4e8ef; color: #111111; font-size: 14px; }")
  (has? out ".tab-selected { background: #111111; color: #ffffff; }")) 42 7)))
