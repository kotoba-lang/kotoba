(ns css-sheet (:export [rule rules media sheet]))
;; Native CSS rule streaming from [selector declaration-map] pairs. Unknown
;; values are refused; this is the source-data subset needed by DDS, not all
;; css.core features (keyframes and arbitrary expressions are separate).
(defn- val [x [:option :document]] :document (option-value-of [:option :document] x (document-null)))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- text [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- keyword [d :document] :keyword (option-value-of [:option :keyword] (document-keyword-value d) :missing))
(defn- safe? [s :string] :bool
 (not (or (string-contains? s "{") (string-contains? s "}") (string-contains? s ";") (string-contains? s "/*"))))
(defn- unitless? [p :keyword] :bool
 (or (= p :animation-iteration-count) (= p :border-image-outset) (= p :border-image-slice) (= p :border-image-width) (= p :box-flex) (= p :box-flex-group) (= p :box-ordinal-group) (= p :column-count) (= p :columns) (= p :flex) (= p :flex-grow) (= p :flex-positive) (= p :flex-shrink) (= p :flex-negative) (= p :flex-order) (= p :grid-column) (= p :grid-row) (= p :font-weight) (= p :line-clamp) (= p :line-height) (= p :opacity) (= p :order) (= p :orphans) (= p :scale) (= p :tab-size) (= p :widows) (= p :z-index) (= p :zoom)))
(defn- concat-form [d :document] [:option :string]
 (let [head (val (document-list-at d 0))]
  (if (or (not (= (document-kind head) :symbol)) (not (string=? (document-edn-print head) "str"))) (none)
   (loop [i 1 out ""]
    (if (>= i (document-count d)) (some out)
     (let [v (val (document-list-at d i))]
      (if (= (document-kind v) :string) (recur (+ i 1) (string-concat out (text v))) (none))))))))
(defn- value [p :keyword d :document] [:option :string]
 (let [kind (document-kind d)]
  (cond (= kind :string) (if (safe? (text d)) (some (text d)) (none))
        (= kind :keyword) (let [s (keyword-name (keyword d))] (if (safe? s) (some s) (none)))
        (= kind :list) (let [s (concat-form d)]
          (if (and (option-some?-of [:option :string] s) (safe? (option-value-of [:option :string] s ""))) s (none)))
        (= kind :i64) (let [i (option-value-of [:option :i64] (document-i64-value d) 0) s (string-from-i64 i)]
          (some (if (or (= i 0) (unitless? p)) s (string-concat s "px"))))
        (= kind :f64) (let [s (document-edn-print d)] (if (unitless? p) (some s) (none)))
        :else (none))))
(defn- decls [m :document] [:option :string]
 (if (not (= (document-kind m) :map)) (none)
  (loop [i 0 out ""]
   (if (>= i (document-count m)) (some out)
    (let [pair (val (document-map-entry-at m i)) key (val (document-vector-at pair 0)) v (val (document-vector-at pair 1))
          prop (keyword key) rendered (value prop v)]
     (if (or (not (= (document-kind key) :keyword)) (not (option-some?-of [:option :string] rendered))) (none)
      (recur (+ i 1) (string-concat out (string-concat (if (= i 0) "" " ") (string-concat (keyword-name prop)
       (string-concat ": " (string-concat (option-value-of [:option :string] rendered "") ";"))))))))))))
(defn rule [d :document] [:option :string]
 (if (or (not (= (document-kind d) :vector)) (not (= (document-count d) 2))) (none)
  (let [selector (val (document-vector-at d 0)) declarations (decls (val (document-vector-at d 1))) s (text selector)]
   (if (and (= (document-kind selector) :string) (safe? s) (option-some?-of [:option :string] declarations))
    (some (string-concat s (string-concat " { " (string-concat (option-value-of [:option :string] declarations "") " }")))) (none)))))
(defn- render-rules [xs :document separator :string] [:option :string]
 (if (not (= (document-kind xs) :vector)) (none)
  (loop [i 0 out ""]
   (if (>= i (document-count xs)) (some out)
    (let [r (rule (val (document-vector-at xs i)))]
     (if (option-some?-of [:option :string] r)
      (recur (+ i 1) (string-concat out (string-concat (if (= i 0) "" separator) (option-value-of [:option :string] r "")))) (none)))))))
(defn rules [xs :document] [:option :string] (render-rules xs "\n"))
(defn media [m :document] [:option :string]
 (if (not (= (document-kind m) :map)) (none)
  (loop [i 0 out ""]
   (if (>= i (document-count m)) (some out)
    (let [pair (val (document-map-entry-at m i)) q (val (document-vector-at pair 0)) r (render-rules (val (document-vector-at pair 1)) " ")]
     (if (and (= (document-kind q) :string) (safe? (text q)) (option-some?-of [:option :string] r))
      (recur (+ i 1) (string-concat out (string-concat (if (= i 0) "" "\n") (string-concat "@media "
        (string-concat (text q) (string-concat " { " (string-concat (option-value-of [:option :string] r "") " }"))))))) (none)))))))
(defn sheet [r :document m :document] [:option :string]
 (let [a (rules r) b (media m)]
  (if (and (option-some?-of [:option :string] a) (option-some?-of [:option :string] b))
   (let [x (option-value-of [:option :string] a "") y (option-value-of [:option :string] b "")]
    (some (string-concat x (string-concat (if (or (string=? x "") (string=? y "")) "" "\n") y)))) (none))))
