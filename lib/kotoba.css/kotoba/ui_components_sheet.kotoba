(ns ui-components-sheet (:export [styles]) (:require [css-sheet :as css]))
;; Stylesheet for the shared dapp UI components (JUN-856). Colours follow the
;; browser.surface default theme (fg #111111, bg #f5f6f8, button #e4e8ef).
(defn styles [] [:option :string]
 (css/sheet (document-edn-read "[[\".chip\" {:display \"inline-block\" :padding \"2px 8px\" :border-radius 10 :font-size 12 :background \"#e4e8ef\" :color \"#111111\"}] [\".chip-ok\" {:background \"#d8f0dc\"}] [\".chip-warn\" {:background \"#fdf0c8\"}] [\".chip-error\" {:background \"#f8d7d7\"}] [\".btn\" {:padding \"6px 12px\" :border \"0\" :border-radius 6 :background \"#e4e8ef\" :color \"#111111\" :font-size 14}] [\".row\" {:display \"flex\" :justify-content \"space-between\" :padding \"6px 0\"}] [\".row-title\" {:color \"#111111\"}] [\".row-detail\" {:color \"#52514e\"}] [\".card\" {:padding 12 :border-radius 8 :background \"#ffffff\"}] [\".panel\" {:padding 6 :background \"#f5f6f8\"}] [\".tabs\" {:display \"flex\" :gap 6}] [\".tab\" {:padding \"6px 12px\" :border \"0\" :background \"#e4e8ef\" :color \"#111111\"}] [\".tab-selected\" {:background \"#111111\" :color \"#ffffff\"}] [\".field\" {:display \"block\"}] [\".field-label\" {:display \"block\" :font-size 12}]]") (document-edn-read "{}")))
