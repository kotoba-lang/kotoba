{:paths ["src"]
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; kotoba-lang/amu is a TEST-ONLY dependency, for the parity
         ;; gates that compile kotoba/css_core.kotoba, kotoba/css_document.kotoba
         ;; and kotoba/css_utility.kotoba and require each to emit
         ;; byte-identical text to its .cljc original (ADR-2607270100
         ;; section 10). The library itself has no runtime dependency on it,
         ;; and no .cljc under src/ is removed or changed by the port.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       ;; inferred option fallback and contextual document keys
                       :git/sha "c3be07fb38bf457a159a2b304152e18693f9b0b6"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
