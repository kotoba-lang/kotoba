;; Port of ichiran.model (model.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from model.cljk:
;;   - Multi-arity constructors are split. draft and artifact take the
;;     three-argument form; draft-with and artifact-with take the four-argument
;;     form with attrs. The three-argument forms pass an empty attrs map.
;;   - (merge defaults attrs): document-merge, where attrs wins, as in Clojure.
;;   - confidence 0.0 is an :f64 document.
;;   - nil defaults are document-null.

(ns ichiran.model
  (:export [draft draft-with artifact artifact-with]))

(defn draft-with [activity-id :document workbook-id :document content :document attrs :document] :document
  (document-merge (document-map :activity-id activity-id
                                :workbook-id workbook-id
                                :content content
                                :confidence (document-f64 0.0)
                                :cites (document-vector)
                                :redactions (document-vector)
                                :tenant (document-null)
                                :status (document-keyword :proposed))
                  attrs))

(defn draft [activity-id :document workbook-id :document content :document] :document
  (draft-with activity-id workbook-id content (document-map)))

(defn artifact-with [id :document repo :document title :document attrs :document] :document
  (document-merge (document-map :id id :repo repo :title title :status (document-keyword :open))
                  attrs))

(defn artifact [id :document repo :document title :document] :document
  (artifact-with id repo title (document-map)))
