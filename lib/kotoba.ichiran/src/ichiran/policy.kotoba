(ns ichiran.policy
  (:export [sensitive-cite? missing-redactions tenant-mismatch?]))

;; Kotoba port of lib/kotoba.ichiran/src/ichiran/policy.cljk (ns ichiran.policy).
;; Named divergences:
;;   * #{:financial :legal :personnel} is the disjunction in sensitive-cite?
;;     (set literals are not constants; same as the mmio precedent).
;;   * missing-redactions takes cites as a list of keywords and redactions as a
;;     keyword set; it returns the missing sensitive cites as a list, order kept.
;;   * tenant-mismatch? takes the artifact's :repo as a presence flag plus a
;;     string, and the tenant likewise, instead of nilable map values.

(defn sensitive-cite? [cite :keyword] :bool
  (if (= cite :financial) true
      (if (= cite :legal) true
          (= cite :personnel))))

(defn missing-redactions [cites [:list :keyword] redactions [:set :keyword]] [:list :keyword]
  (loop [i 0 out (typed-list-new [:list :keyword])]
    (if (>= i (count cites))
      out
      (let [c (typed-list-nth [:list :keyword] cites i)]
        (recur (+ i 1)
               (if (sensitive-cite? c)
                 (if (typed-set-contains [:set :keyword] redactions c)
                   out
                   (typed-list-conj [:list :keyword] out c))
                 out))))))

(defn tenant-mismatch? [has-tenant :bool tenant :string has-repo :bool artifact-repo :string] :bool
  (if has-tenant
    (if has-repo (not (string=? tenant artifact-repo)) true)
    has-repo))
