(ns ichiran.policy-test
  (:require [ichiran.policy :as p])
  (:export [main]))

;; Returns the number of failed cases (0 = pass).
(defn main [] :i64
  (let [cites (typed-list-conj [:list :keyword]
                (typed-list-conj [:list :keyword]
                  (typed-list-conj [:list :keyword] (typed-list-new [:list :keyword]) :financial)
                  :legal)
                :public)
        red (typed-set-conj [:set :keyword] (typed-set-new [:set :keyword]) :financial)
        miss (p/missing-redactions cites red)
        f1 (if (p/sensitive-cite? :financial) 0 1)
        f2 (if (p/sensitive-cite? :public) 1 0)
        f3 (if (= (count miss) 1) 0 1)
        f4 (if (= (typed-list-nth [:list :keyword] miss 0) :legal) 0 1)
        f5 (if (p/tenant-mismatch? true "a" true "a") 1 0)
        f6 (if (p/tenant-mismatch? true "b" true "a") 0 1)
        f7 (if (p/tenant-mismatch? false "" true "a") 0 1)
        f8 (if (p/tenant-mismatch? true "a" false "") 0 1)
        f9 (if (p/tenant-mismatch? false "" false "") 1 0)]
    (+ (+ (+ f1 f2) (+ f3 f4)) (+ (+ f5 f6) (+ (+ f7 f8) f9)))))
