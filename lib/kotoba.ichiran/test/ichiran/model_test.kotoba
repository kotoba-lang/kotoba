(ns ichiran.model-test
  (:export [main])
  (:require [ichiran.model :as m]))

(defn- edn-is [got :document want :string] :i64
  (if (string=? (document-edn-print got) want) 0 1))

(defn- field [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn main [] :i64
  (let [wb (document-map :sheets/id (document-string "wb-1"))
        d (m/draft (document-string "act-1") (document-string "wb-1") wb)
        d2 (m/draft-with (document-string "act-2") (document-string "wb-2") wb
                         (document-map :tenant (document-string "t1") :status (document-keyword :accepted)))
        a (m/artifact (document-string "act-1") (document-string "org/repo") (document-string "Tally"))
        a2 (m/artifact-with (document-string "act-2") (document-string "org/repo") (document-string "Tally2")
                            (document-map :status (document-keyword :closed)))]
    (+ (edn-is (field d :activity-id) "\"act-1\"")
       (edn-is (field d :workbook-id) "\"wb-1\"")
       (edn-is (field d :content) "{:sheets/id \"wb-1\"}")
       (edn-is (field d :confidence) "0.0")
       (edn-is (field d :cites) "[]")
       (edn-is (field d :redactions) "[]")
       (edn-is (field d :status) ":proposed")
       (edn-is (field d2 :tenant) "\"t1\"")
       (edn-is (field d2 :status) ":accepted")
       (edn-is (field a :repo) "\"org/repo\"")
       (edn-is (field a :status) ":open")
       (edn-is (field a2 :status) ":closed")
       (edn-is (field a2 :title) "\"Tally2\""))))
