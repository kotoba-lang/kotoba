(ns kotoba.teleop.ros
  "The one ROS 2/rosbridge topic teleop cares about: `/cmd_vel`, the
  standard ROS 2 topic a differential-drive robot listens to for teleop
  velocity commands (`geometry_msgs/msg/Twist`) — real ROS 2 convention,
  not invented here. A thin naming layer over `kotoba.ros.rosbridge`; no
  new protocol logic, no other topics. Pure data in, pure data out — no
  socket I/O (that stays host-side, per `kotoba.ros.rosbridge`)."
  (:require [kotoba.ros.rosbridge :as rosbridge]))

(def cmd-vel-topic
  "The standard ROS 2 differential-drive teleop velocity topic."
  "/cmd_vel")

(defn cmd-vel-advertise-op
  "rosbridge `advertise` op declaring this client will publish
  `cmd-vel-topic` as `geometry_msgs/msg/Twist`."
  []
  (rosbridge/advertise-op cmd-vel-topic rosbridge/type-geometry-msgs-twist))

(defn cmd-vel-publish-op
  "rosbridge `publish` op sending `twist` (a
  `geometry_msgs/msg/Twist`-shaped EDN map, e.g. from
  `kotoba.teleop/->twist`) to `cmd-vel-topic`."
  [twist]
  (rosbridge/publish-op cmd-vel-topic twist))
