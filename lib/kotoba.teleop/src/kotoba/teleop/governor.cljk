(ns kotoba.teleop.governor
  "Teleop mission/action helpers layered on kotoba-lang/robotics' generic
  mission/action/governor contract (ADR-2607011000). This library never
  drives hardware — it only shapes teleop-specific missions and actions
  into the safety classes `kotoba.robotics/gate` checks. Mirrors
  `kotoba.giemon.governor`'s shape exactly: a thin, product-specific
  wrapper that supplies default safety classes to `kotoba.robotics`'
  constructors. Does **not** redefine `gate` — callers call
  `kotoba.robotics/gate` directly."
  (:require [kotoba.robotics :as rob]
            [kotoba.teleop :as teleop]))

(defn teleop-mission
  "A teleop mission for `robot` (any robot identifier) with `objective`."
  [id robot objective & opts]
  (apply rob/mission id robot objective opts))

(defn teleop-action
  "A teleop action of `kind`. Defaults `:safety` from `speed-mode`'s
  posture in `kotoba.teleop/speed-modes` (via `speed-mode`'s
  `:safety`, default `:medium` when `speed-mode` is unknown/omitted)
  unless explicitly given — mirrors `kotoba.giemon.governor/kaigo-action`'s
  `(or safety (get-in kaigo-roles [product :default-safety] :medium))`
  pattern."
  [id mission-id kind & {:keys [safety params speed-mode]}]
  (rob/action id mission-id kind
              (or safety (get-in teleop/speed-modes [speed-mode :safety] :medium))
              :params params))
