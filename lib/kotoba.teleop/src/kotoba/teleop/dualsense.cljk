(ns kotoba.teleop.dualsense
  "Sony DualSense -> generic teleop axis-state adapter. The *only* file
  in this library that knows about a specific controller brand;
  `kotoba.teleop`'s core is controller-agnostic by design so a future
  Xbox/generic-HID adapter can reuse it unchanged, by adding its own
  `decoded->axis-state` analogue here.

  Maps `kotoba.dualsense.input`'s decoded HID report shape
  (`decode-usb-report`/`decode-bt-report`) onto `kotoba.teleop`'s generic
  axis-state shape:

  ```
  {:left-stick [<x -1..1> <y -1..1>] :right-stick [<x -1..1> <y -1..1>]
   :l2 <0..1> :r2 <0..1> :buttons #{...} :dpad <keyword>}
  ```

  Pure data in, pure data out — no USB/Bluetooth I/O (that stays in
  `kotoba.dualsense.input`'s host-side caller).")

(defn decoded->axis-state
  "Map a `kotoba.dualsense.input`-decoded report `d` (from
  `decode-usb-report`/`decode-bt-report`) to the generic teleop
  axis-state shape `kotoba.teleop/step` and `kotoba.teleop/->twist`
  consume."
  [d]
  {:left-stick  [(-> d :sticks :lx) (-> d :sticks :ly)]
   :right-stick [(-> d :sticks :rx) (-> d :sticks :ry)]
   :l2 (-> d :triggers :l2)
   :r2 (-> d :triggers :r2)
   :buttons (:buttons d)
   :dpad (:dpad d)})
