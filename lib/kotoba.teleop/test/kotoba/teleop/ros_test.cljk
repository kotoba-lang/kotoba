(ns kotoba.teleop.ros-test
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.ros.rosbridge :as rosbridge]
            [kotoba.teleop.ros :as tros]))

(deftest cmd-vel-advertise-op-test
  (is (= {:op "advertise" :topic "/cmd_vel" :type rosbridge/type-geometry-msgs-twist}
         (tros/cmd-vel-advertise-op))))

(deftest cmd-vel-publish-op-test
  (let [twist {:linear {:x 1.0 :y 0.0 :z 0.0} :angular {:x 0.0 :y 0.0 :z 0.5}}]
    (is (= {:op "publish" :topic "/cmd_vel" :msg twist}
           (tros/cmd-vel-publish-op twist)))))
