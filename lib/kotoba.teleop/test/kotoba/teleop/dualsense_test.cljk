(ns kotoba.teleop.dualsense-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.dualsense.input :as input]
            [kotoba.teleop.dualsense :as ds]))

(defn- usb-report
  "A minimal 64-byte USB report vector with sticks/triggers/buttons at
  their real byte offsets (report ID + 1), everything else zeroed.
  `buttons-a`'s low nibble is the D-pad hat switch; 0x08 (default) is one
  of the 8-15 values the kernel uses for D-pad neutral/released (0-7 are
  the 8 compass directions)."
  [{:keys [lx ly rx ry l2 r2 buttons-a buttons-b]
    :or {lx 127 ly 127 rx 127 ry 127 l2 0 r2 0 buttons-a 0x08 buttons-b 0}}]
  (-> (vec (repeat 64 0))
      (assoc 1 lx) (assoc 2 ly) (assoc 3 rx) (assoc 4 ry)
      (assoc 5 l2) (assoc 6 r2)
      (assoc 8 buttons-a) (assoc 9 buttons-b)))

(deftest decoded->axis-state-test
  (testing "shape and passthrough from a real decoded report"
    (let [decoded (input/decode-usb-report (usb-report {:l2 255 :buttons-b 0x04}))
          axis-state (ds/decoded->axis-state decoded)]
      (is (= (get-in decoded [:sticks :lx]) (first (:left-stick axis-state))))
      (is (= (get-in decoded [:sticks :ly]) (second (:left-stick axis-state))))
      (is (= (get-in decoded [:sticks :rx]) (first (:right-stick axis-state))))
      (is (= (get-in decoded [:sticks :ry]) (second (:right-stick axis-state))))
      (is (= (get-in decoded [:triggers :l2]) (:l2 axis-state)))
      (is (= (get-in decoded [:triggers :r2]) (:r2 axis-state)))
      (is (= (:buttons decoded) (:buttons axis-state)))
      (is (= (:dpad decoded) (:dpad axis-state)))
      (is (contains? (:buttons axis-state) :l2))
      (is (= 1.0 (:l2 axis-state)))))
  (testing "neutral report decodes to a neutral axis-state"
    (let [decoded (input/decode-usb-report (usb-report {}))
          axis-state (ds/decoded->axis-state decoded)]
      (is (= [0.0 0.0] (:left-stick axis-state)))
      (is (= [0.0 0.0] (:right-stick axis-state)))
      (is (= 0.0 (:l2 axis-state)))
      (is (= 0.0 (:r2 axis-state)))
      (is (= :neutral (:dpad axis-state))))))
