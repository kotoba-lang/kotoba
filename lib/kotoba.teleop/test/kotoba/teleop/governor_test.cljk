(ns kotoba.teleop.governor-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.robotics :as rob]
            [kotoba.teleop.governor :as gov]))

(deftest teleop-mission-test
  (let [m (gov/teleop-mission "M1" "robot-1" "patrol perimeter")]
    (is (= "robot-1" (:mission/robot m)))
    (is (= :planned (:mission/status m)))))

(deftest teleop-action-defaults-test
  (testing "normal speed-mode defaults to :medium safety"
    (let [a (gov/teleop-action "A1" "M1" :move :speed-mode :normal)]
      (is (= :medium (:action/safety a)))))
  (testing "crawl speed-mode defaults to :low safety"
    (let [a (gov/teleop-action "A1" "M1" :move :speed-mode :crawl)]
      (is (= :low (:action/safety a)))))
  (testing "turbo speed-mode defaults to :high safety"
    (let [a (gov/teleop-action "A1" "M1" :move :speed-mode :turbo)]
      (is (= :high (:action/safety a)))
      (is (rob/requires-sign-off? a))))
  (testing "explicit safety overrides speed-mode default"
    (let [a (gov/teleop-action "A1" "M1" :move :speed-mode :crawl :safety :high)]
      (is (= :high (:action/safety a)))))
  (testing "no speed-mode given falls back to :medium"
    (let [a (gov/teleop-action "A1" "M1" :sense)]
      (is (= :medium (:action/safety a))))))
