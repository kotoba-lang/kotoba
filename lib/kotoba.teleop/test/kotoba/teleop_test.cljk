(ns kotoba.teleop-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.robotics :as rob]
            [kotoba.teleop :as teleop]))

(def neutral-axis-state
  {:left-stick [0.0 0.0] :right-stick [0.0 0.0]
   :l2 0.0 :r2 0.0 :buttons #{} :dpad :neutral})

(defn- with-deadman [axis-state held?]
  (assoc axis-state :l2 (if held? 0.8 0.0)))

;; ---------------------------------------------------------------------------
;; Deadman release -> immediate :operator safety-stop
;; ---------------------------------------------------------------------------

(deftest deadman-release-test
  (testing "holding the deadman produces a move-action, not a stop"
    (let [state (teleop/initial-state "M1")
          axis-state (with-deadman neutral-axis-state true)
          {:keys [emit state']} (teleop/step state axis-state 0.1)]
      (is (true? (:deadman-held? state')))
      (is (= 1 (count emit)))
      (is (= :move (:action/kind (first emit))))))
  (testing "releasing the deadman after holding it emits an immediate :operator safety-stop"
    (let [state0 (teleop/initial-state "M1")
          held-axis (with-deadman neutral-axis-state true)
          {state1 :state'} (teleop/step state0 held-axis 0.1)
          released-axis (with-deadman neutral-axis-state false)
          {:keys [emit state']} (teleop/step state1 released-axis 0.1)]
      (is (false? (:deadman-held? state')))
      (is (= 1 (count emit)))
      (is (= "M1" (:stop/mission (first emit))))
      (is (= :operator (:stop/reason (first emit))))))
  (testing "never holding the deadman emits nothing"
    (let [state (teleop/initial-state "M1")
          {:keys [emit]} (teleop/step state neutral-axis-state 0.1)]
      (is (= [] emit)))))

;; ---------------------------------------------------------------------------
;; E-stop chord -> immediate :e-stop safety-stop, unconditionally
;; ---------------------------------------------------------------------------

(deftest estop-chord-test
  (testing "the e-stop chord immediately stops even while the deadman is held"
    (let [state (teleop/initial-state "M1")
          axis-state (-> neutral-axis-state
                         (with-deadman true)
                         (assoc :buttons #{:ps :options}))
          {:keys [emit state']} (teleop/step state axis-state 0.1)]
      (is (= 1 (count emit)))
      (is (= :e-stop (:stop/reason (first emit))))
      (is (= "M1" (:stop/mission (first emit))))
      ;; the e-stop always wins, even though the deadman was held --
      ;; deadman-held? resets to false on any stop.
      (is (false? (:deadman-held? state')))))
  (testing "a partial chord (only one button) does not trigger e-stop"
    (let [state (teleop/initial-state "M1")
          axis-state (-> neutral-axis-state (with-deadman true) (assoc :buttons #{:ps}))
          {:keys [emit]} (teleop/step state axis-state 0.1)]
      (is (= :move (:action/kind (first emit)))))))

;; ---------------------------------------------------------------------------
;; Speed-mode safety classes + gate behaviour
;; ---------------------------------------------------------------------------

(deftest turbo-mode-requires-sign-off-test
  (let [state (teleop/initial-state "M1" :speed-mode :turbo)
        axis-state (with-deadman neutral-axis-state true)
        {:keys [emit]} (teleop/step state axis-state 0.1)
        a (first emit)]
    (is (= :move (:action/kind a)))
    (is (= :high (:action/safety a)))
    (is (= :require-sign-off (:gate/decision (rob/gate a #{:high}))))
    (is (not= :permit (:gate/decision (rob/gate a #{:high}))))))

(deftest normal-mode-permits-test
  (let [state (teleop/initial-state "M1" :speed-mode :normal)
        axis-state (with-deadman neutral-axis-state true)
        {:keys [emit]} (teleop/step state axis-state 0.1)
        a (first emit)]
    (is (= :move (:action/kind a)))
    (is (= :medium (:action/safety a)))
    (is (= :permit (:gate/decision (rob/gate a #{:medium}))))))

;; ---------------------------------------------------------------------------
;; ->twist mapping
;; ---------------------------------------------------------------------------

(deftest twist-mapping-test
  (testing "neutral sticks -> zero twist"
    (let [t (teleop/->twist neutral-axis-state :normal)]
      (is (= {:x 0.0 :y 0.0 :z 0.0} (:linear t)))
      (is (= {:x 0.0 :y 0.0 :z 0.0} (:angular t)))))
  (testing "left-stick forward (+y) -> positive linear.x, scaled by mode"
    (let [axis-state (assoc neutral-axis-state :left-stick [0.0 1.0])]
      (is (= 1.0 (get-in (teleop/->twist axis-state :normal) [:linear :x])))
      (is (= 0.25 (get-in (teleop/->twist axis-state :crawl) [:linear :x])))
      (is (= 2.0 (get-in (teleop/->twist axis-state :turbo) [:linear :x])))))
  (testing "right-stick x -> angular.z, scaled by mode"
    (let [axis-state (assoc neutral-axis-state :right-stick [0.5 0.0])]
      (is (= 0.5 (get-in (teleop/->twist axis-state :normal) [:angular :z])))
      (is (= 1.0 (get-in (teleop/->twist axis-state :turbo) [:angular :z])))))
  (testing "unused axes stay pinned to 0.0"
    (let [axis-state (assoc neutral-axis-state :left-stick [1.0 1.0] :right-stick [1.0 1.0])
          t (teleop/->twist axis-state :normal)]
      (is (= 0.0 (get-in t [:linear :y])))
      (is (= 0.0 (get-in t [:linear :z])))
      (is (= 0.0 (get-in t [:angular :x])))
      (is (= 0.0 (get-in t [:angular :y]))))))

;; ---------------------------------------------------------------------------
;; deadman-held? / estop-chord-held? predicates directly
;; ---------------------------------------------------------------------------

(deftest deadman-held?-test
  (is (not (teleop/deadman-held? neutral-axis-state)))
  (is (teleop/deadman-held? (assoc neutral-axis-state :l2 0.8)))
  (is (not (teleop/deadman-held? (assoc neutral-axis-state :l2 0.5))))
  (testing "custom axis/threshold"
    (is (teleop/deadman-held? (assoc neutral-axis-state :r2 0.9) :axis :r2 :threshold 0.7))))

(deftest estop-chord-held?-test
  (is (teleop/estop-chord-held? (assoc neutral-axis-state :buttons #{:ps :options :cross})))
  (is (not (teleop/estop-chord-held? (assoc neutral-axis-state :buttons #{:ps}))))
  (testing "custom chord"
    (is (teleop/estop-chord-held? (assoc neutral-axis-state :buttons #{:l1 :r1})
                                   :chord #{:l1 :r1}))))
