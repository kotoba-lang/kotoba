{:schema "kotoba-sigma-migration/v1"
 :profile :sigma/bounded-vocabulary-and-selection-registry-v1
 :legacy {:source "src/sigma/model.cljk" :status :retained-general-oracle}
 :canonical {:kernel-and-conformance "src/sigma/bounded_vocabulary.kotoba"}
 :domain
 {:functions [:known-level? :known-modifier? :empty-registry :add-selection
              :selection-count :has-selection? :selection-criteria-count-or]
  :scope "the CLOSED detection-rule vocabulary -- sigma.model/known-levels
          (5 severity keywords) and known-modifiers (7 field-key pipe
          modifiers) -- plus a name-keyed selection registry
          (selection-name -> its criteria count)."
  :representation "closed keyword/string membership for the two vocabularies;
                   [:map :string :i64] canonical bounded typed-map for the
                   registry, the same primitive already qualified by
                   kotoba-lang/crdt / states / sheets / atprotocol / spice."}
 :excluded [:sigma.model/criteria-maps :sigma.model/condition-string
            :sigma.validate :sigma.execute :sigma.yaml]
 :exclusion-reason "the open, nested criteria maps ({\"EventID\" [4625]
                    \"User|contains\" [\"adm\"]}), the condition-string parser
                    (and/or/not, quantifiers, glob matching), and the
                    JSON/YAML I/O remain the CLJC oracle -- only the closed
                    vocabulary and the name registry are bounded here."
 :compiler-findings
 {:equality-and-string-equal-type-as-i64-not-bool
  {:description "= and string=? type as :i64, so a :bool predicate's if-leaves
                 must be explicit true/false, e.g. (if (= level :critical)
                 true false), not a bare (= level :critical). Working as
                 designed."}}
 :verification
 {:hand-verified-cases
  "main replays sigma.core-test's fixture vocabulary: level :high/:critical
   known and :bogus rejected; modifier \"contains\" known and \"regex\"
   rejected; selections \"sel\" (2 criteria) and \"filt\" (1) registered,
   count 2, membership, criteria-count read-back, and missing-selection
   fallback. Returns 42 iff all hold."
  :web {:main 42 :required-capabilities []}
  :wasm {:main 42}
  :required-capabilities []}
 :cutover {:bounded-profile-authorized true :general-cljc-oracle-retained true}}
