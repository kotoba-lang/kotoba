(ns sigma.bounded-vocabulary
  (:export [main known-level? known-modifier?
            empty-registry add-selection selection-count has-selection?
            selection-criteria-count-or]))

;; Bounded-profile port of sigma.model's CLOSED detection-rule vocabulary --
;; the five severity levels and the seven field-key pipe-modifiers -- plus a
;; name-keyed selection registry (selection-name -> its criteria count). The
;; open, nested criteria maps ({"EventID" [4625] "User|contains" ["adm"]}),
;; the condition-string parser (and/or/not, quantifiers, glob matching), and
;; the JSON/YAML I/O stay the CLJC oracle (sigma.model / sigma.validate /
;; sigma.execute / sigma.yaml) -- only the closed vocabulary and the
;; name registry are bounded here.
;;
;; Uses kotoba-lang/compiler's canonical bounded typed-map ([:map :string
;; :i64], <= 31 entries) for the registry, plus closed keyword/string
;; membership for the two vocabularies (sigma.model/known-levels /
;; known-modifiers).

;; sigma.model/known-levels: #{:informational :low :medium :high :critical}.
;; = types as :i64 (not :bool), so every leaf is an explicit bool.
(defn known-level? [level :keyword] :bool
  (if (= level :informational) true
    (if (= level :low) true
      (if (= level :medium) true
        (if (= level :high) true
          (if (= level :critical) true false))))))

;; sigma.model/known-modifiers: #{"contains" "startswith" "endswith" "re"
;; "all" "gt" "lt"}. string=? likewise types as :i64.
(defn known-modifier? [m :string] :bool
  (if (string=? m "contains") true
    (if (string=? m "startswith") true
      (if (string=? m "endswith") true
        (if (string=? m "re") true
          (if (string=? m "all") true
            (if (string=? m "gt") true
              (if (string=? m "lt") true false))))))))

(defn empty-registry [] [:map :string :i64]
  (typed-map-new [:map :string :i64]))

;; Register selection NAME with its criteria COUNT (last-write-wins, like
;; sigma.model/add-selection's assoc-in).
(defn add-selection [reg [:map :string :i64] name :string criteria-count :i64]
    [:map :string :i64]
  (typed-map-assoc [:map :string :i64] reg name criteria-count))

(defn selection-count [reg [:map :string :i64]] :i64
  (typed-map-count [:map :string :i64] reg))

(defn has-selection? [reg [:map :string :i64] name :string] :bool
  (typed-map-contains [:map :string :i64] reg name))

(defn selection-criteria-count-or [reg [:map :string :i64] name :string fallback :i64] :i64
  (match-option
   (typed-map-get [:map :string :i64] reg name)
   [:option :i64]
   (none fallback)
   (some n n)))

;; Self-conformance: replays sigma.core-test's fixture vocabulary -- rule
;; :level :high (known), selections "sel" (2 criteria) and "filt" (1),
;; modifier "contains" (known) -- and rejects out-of-vocabulary values.
(defn main [] :i64
  (let [reg (add-selection (add-selection (empty-registry) "sel" 2) "filt" 1)]
    (if (known-level? :high)
      (if (known-level? :critical)
        (if (known-level? :bogus)
          1
          (if (known-modifier? "contains")
            (if (known-modifier? "regex")
              1
              (if (= 2 (selection-count reg))
                (if (has-selection? reg "sel")
                  (if (has-selection? reg "missing")
                    1
                    (if (= 2 (selection-criteria-count-or reg "sel" 0))
                      (if (= 0 (selection-criteria-count-or reg "missing" 0))
                        42
                        1)
                      1))
                  1)
                1))
            1))
        1)
      1)))
