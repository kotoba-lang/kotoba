(ns kyoninka.human-gate-conformance
  (:require [kyoninka.human-gate :as gate])
  (:export [main transition-kind transition-allowed]))

(defn transition-kind [from :i64 to :i64] :i64
  (gate/transition-kind from to))

(defn transition-allowed [from :i64 to :i64 human-approved :i64] :i64
  (gate/transition-allowed from to human-approved))

(defn main [] :i64 42)
