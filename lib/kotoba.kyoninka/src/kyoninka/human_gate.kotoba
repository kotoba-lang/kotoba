(ns kyoninka.human-gate
  (:export [transition-kind transition-allowed]))

;; 0 not-started, 1 preparing, 2 ready-to-submit, 3 submitted,
;; 4 under-review, 5 granted, 6 rejected, 7 withdrawn.
;; Kind: 0 invalid, 1 auto, 2 human approval required.
(defn transition-kind [from :i64 to :i64] :i64
  (if (= from 0)
    (if (= to 1) 1 0)
    (if (= from 1)
      (if (= to 2) 1 0)
      (if (= from 2)
        (if (= to 3) 2 (if (= to 1) 1 0))
        (if (= from 3)
          (if (= to 4) 1 (if (= to 7) 2 0))
          (if (= from 4)
            (if (= to 5) 2 (if (= to 6) 2 (if (= to 7) 2 0)))
            0))))))

(defn transition-allowed [from :i64 to :i64 human-approved :i64] :i64
  (let [kind (transition-kind from to)]
    (if (= kind 1)
      1
      (if (= kind 2) (if (= human-approved 1) 1 0) 0))))
