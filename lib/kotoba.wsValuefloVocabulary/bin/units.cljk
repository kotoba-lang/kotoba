#!/usr/bin/env kbb
;; The unit registry: hand-written EDN -> portable inlined source.
;;
;;   kbb --backend sci bin/units.cljk                    ; write src/valueflows/unit_data.cljk
;;   kbb --backend sci bin/units.cljk --check            ; compare, write nothing
;;   kbb --backend sci bin/units.cljk --verify-om2 <om-2.0.rdf>
;;                                         ; check every :om-2 name against the
;;                                         ; authoritative RDF distribution
;;
;; Exit codes, three-valued for the same reason as bin/ingest.cljk:
;;   0  written / identical / verified
;;   1  STALE, or a name is missing from om-2
;;   2  COULD NOT ANSWER — registry unreadable, below the evidence floor, or
;;      --verify-om2 asked for without a readable file. NOT 0: a check that
;;      could not look must not report a pass.
;;
;; Why --verify-om2 takes a path rather than fetching: the om-2 website was
;; returning 500 on 2026-08-15 and every /resource/om-2/<name> 404'd, so a
;; network check would fail for reasons that have nothing to do with the
;; registry. The caller supplies the RDF distribution; without it the answer is
;; "could not answer", not "fine".

(ns units
  (:require ["fs" :as fs]
            ["crypto" :as crypto]
            [kotoba.lang.text :as str]
            [kotoba.pprint :as pprint]
            [kotoba.lang.edn :as edn]))

(def registry-path "resources/valueflows/units.edn")
(def out-path "src/valueflows/unit_data.cljk")

;; Measured, not guessed: the registry has 19 units and 17 distinct om-2 names
;; (:en and :micro-en have none). A reader that returns fewer has broken.
(def floor {:units 19 :om-2-names 17})

(defn- die [code msg]
  (println msg)
  (js/process.exit code))

(defn- read-registry []
  (when-not (fs/existsSync registry-path)
    (die 2 (str "CANNOT ANSWER: " registry-path " is absent.")))
  (let [r (edn/read-string (str (fs/readFileSync registry-path "utf8")))
        units (:units r)
        om-names (into (sorted-set) (keep :om-2) (vals units))]
    (when (< (count units) (:units floor))
      (die 2 (str "CANNOT ANSWER: read " (count units) " units, floor is "
                  (:units floor) " — the registry shrank or the reader broke.")))
    (when (< (count om-names) (:om-2-names floor))
      (die 2 (str "CANNOT ANSWER: read " (count om-names) " om-2 names, floor is "
                  (:om-2-names floor) ".")))
    ;; every alias must be unique across units, or `canonical` becomes
    ;; ambiguous and silently picks whichever the map iterated first
    (let [pairs (for [[k v] units a (:aliases v)] [a k])
          dupes (->> pairs (group-by first) (filter #(> (count (val %)) 1)) (map key))]
      (when (seq dupes)
        (die 2 (str "CANNOT ANSWER: aliases claimed by more than one unit: "
                    (pr-str (vec dupes))
                    " — canonicalisation would depend on map order."))))
    ;; an alias may not collide with a canonical name of a DIFFERENT unit
    (let [bad (for [[k v] units a (:aliases v)
                    :when (and (contains? units a) (not= a k))]
                [a k])]
      (when (seq bad)
        (die 2 (str "CANNOT ANSWER: alias also a canonical unit: " (pr-str (vec bad))))))
    r))

(defn- verify-om2! [registry path]
  (when-not (and path (fs/existsSync path))
    (die 2 (str "CANNOT ANSWER: --verify-om2 needs a readable om-2 RDF file"
                (when path (str "; " path " is not readable"))
                ". Not fetching: the om-2 site returned 500 on 2026-08-15, so a"
                " network failure would be indistinguishable from a bad name.")))
  (let [rdf (str (fs/readFileSync path "utf8"))
        sha (-> (crypto/createHash "sha256") (.update rdf "utf8") (.digest "hex"))
        pinned (get-in registry [:om-2 :sha256])
        names (keep :om-2 (vals (:units registry)))
        missing (vec (remove #(str/includes? rdf (str "about=\"&om;" % "\"")) names))
        ;; the counter-check: names the registry exists to warn about
        traps (filter #(str/includes? rdf (str "about=\"&om;" % "\"")) ["each" "second" "minute"])]
    (println (str "om-2 file sha256 " sha
                  (if (= sha pinned) " (matches the pin)" (str " (PIN IS " pinned ")"))))
    (println (str "checked " (count names) " names"))
    (when (seq traps)
      (println (str "NOTE: om-2 now defines " (pr-str traps)
                    " — the registry's notes about their absence need revisiting.")))
    (if (seq missing)
      (die 1 (str "MISSING from om-2: " (pr-str missing)))
      (println "OK: every :om-2 name in the registry exists in that file"))))

(defn- render [registry]
  (str ";; GENERATED by bin/units.cljk from resources/valueflows/units.edn.\n"
       ";; DO NOT EDIT BY HAND. Regenerate: kbb --backend sci bin/units.cljk\n"
       ";;\n"
       ";; Inlined so a portable `.cljc` needs no host I/O to read the registry.\n\n"
       "(ns valueflows.unit-data)\n\n"
       "(def registry\n"
       (with-out-str
         (pprint/pprint
          (into (sorted-map)
                (map (fn [[k v]] [k (into (sorted-map) v)]))
                (:units registry))))
       ")\n\n"
       "(def om-2\n"
       (with-out-str (pprint/pprint (into (sorted-map) (:om-2 registry))))
       ")\n\n"
       ";; alias -> canonical, precomputed so lookup is not a scan\n"
       "(def alias-index\n"
       (with-out-str
         (pprint/pprint
          (into (sorted-map)
                (concat (for [k (keys (:units registry))] [k k])
                        (for [[k v] (:units registry) a (:aliases v)] [a k])))))
       ")\n"))

(let [args (vec (drop 2 (js->clj js/process.argv)))
      registry (read-registry)]
  (cond
    (some #{"--verify-om2"} args)
    (verify-om2! registry (second (drop-while #(not= "--verify-om2" %) args)))

    (some #{"--check"} args)
    (let [want (render registry)
          have (when (fs/existsSync out-path) (str (fs/readFileSync out-path "utf8")))]
      (cond
        (nil? have) (die 1 (str "STALE: " out-path " is absent"))
        (not= have want) (die 1 (str "STALE: " out-path " disagrees with " registry-path))
        :else (println (str "OK: " out-path " matches the registry ("
                            (count (:units registry)) " units)"))))

    :else
    (let [content (render registry)]
      (fs/writeFileSync out-path content)
      (println (str "wrote " out-path " (" (count content) " bytes, "
                    (count (:units registry)) " units)")))))
