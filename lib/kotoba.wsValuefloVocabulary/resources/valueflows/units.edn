;; The unit registry. HAND-WRITTEN, and small on purpose.
;;
;; ## Why by hand
;;
;; "kg and kilogram are the same unit" cannot be derived from anything in this
;; workspace, the same reason manifest/concept-vocabulary.edn is hand-written
;; while the concept index is generated. What IS mechanical -- that every
;; :om-2 name below actually exists in the om-2 vocabulary -- is checked by
;; bin/units.cljk --verify-om2.
;;
;; ## Why small
;;
;; There is no divergent unit corpus here to reconcile. Measured 2026-08-15:
;; `kotoba-lang/plm` DECLARES :plm.item/uom and :plm.bom/uom and populates
;; neither -- no test, no resource, no fixture sets a value. Every unit in
;; actual use is in this library's own fixtures plus ENGI's EN and micro-EN.
;; So this file is
;; not a migration; it is the convention written down before divergence, and a
;; place for plm's empty field to point.
;;
;; Adding a unit is one entry. Do not add one speculatively: an unused entry
;; makes the registry look like coverage.
;;
;; ## Two traps this file exists to hold
;;
;; 1. om-2 HAS NO `each`. A count of things is `piece`; `one` is the
;;    dimensionless ratio. Writing "each" as an om-2 name would be an
;;    identifier that resolves to nothing.
;; 2. om-2 HAS NO bare `second`. Time is `second-Time`, because `second-Angle`
;;    also exists. Same for `minute-Time`.
;;
;; And one inconsistency that is upstream's, not ours: om-2 capitalises
;; `JapaneseYen` and `UnitedStatesDollar` but not `euro`. Copied as-is,
;; because an identifier is not ours to tidy.
;;
;; ## IRIs do not dereference, and that is fine
;;
;; vf:omUnitIdentifier is an xsd:anyURI -- an identifier, not a promise of a
;; live page. Measured 2026-08-15: the om-2 website returns 500 for
;; /data/om-2.ttl and every /resource/om-2/<name> returned 404 or failed to
;; connect. The names were therefore verified against the authoritative RDF
;; distribution instead, whose sha256 is recorded below. A registry that
;; treated the 404s as "these units do not exist" would have been wrong.

{:schema "valueflows.units.v1"

 :om-2
 {:namespace "http://www.ontology-of-units-of-measure.org/resource/om-2/"
  :source "https://raw.githubusercontent.com/HajoRijgersberg/OM/master/om-2.0.rdf"
  :sha256 "74b1d65d502852de80be6d71ce1603de686c8807228d5319fadc15e71d040b6e"
  :bytes 2008552
  :verified-at "2026-08-15"
  :verified-by "every :om-2 name below matched about=\"&om;<name>\" in that file"
  :website-status "500 / 404 on 2026-08-15 — the IRIs are identifiers, not live pages"}

 ;; :quantity-kind is OUR classification, not om-2's. It exists so
 ;; `unit/compatible?` can answer "may these two be added" without pulling a
 ;; 2 MB ontology into a portable library. Labelled as ours so nobody cites it
 ;; as a standard.
 :quantity-kind-authority :this-registry

 :units
 {:kg    {:label "kilogram" :symbol "kg" :quantity-kind :mass
          :authority :om-2 :om-2 "kilogram"
          :aliases #{:kilogram :kilograms :kgs}}
  :g     {:label "gram" :symbol "g" :quantity-kind :mass
          :authority :om-2 :om-2 "gram"
          :aliases #{:gram :grams}}
  :t     {:label "tonne" :symbol "t" :quantity-kind :mass
          :authority :om-2 :om-2 "tonne"
          :aliases #{:tonne :tonnes :metric-ton}}

  :hour  {:label "hour" :symbol "h" :quantity-kind :time
          :authority :om-2 :om-2 "hour"
          :aliases #{:hours :hr :hrs :h}}
  :minute {:label "minute" :symbol "min" :quantity-kind :time
           :authority :om-2 :om-2 "minute-Time"
           :aliases #{:minutes :min}
           :note "om-2 name is minute-Time; a bare `minute` does not exist there"}
  :second {:label "second" :symbol "s" :quantity-kind :time
           :authority :om-2 :om-2 "second-Time"
           :aliases #{:seconds :sec :s}
           :note "om-2 name is second-Time, because second-Angle also exists"}
  :day   {:label "day" :symbol "d" :quantity-kind :time
          :authority :om-2 :om-2 "day"
          :aliases #{:days}}
  :week  {:label "week" :symbol "wk" :quantity-kind :time
          :authority :om-2 :om-2 "week"
          :aliases #{:weeks}}

  :litre {:label "litre" :symbol "L" :quantity-kind :volume
          :authority :om-2 :om-2 "litre"
          :aliases #{:liter :liters :litres :l}}
  ;; Added 2026-08-15 because something started using it: cloud-itonami/uchiwake
  ;; records a 330 ml product net content. The registry's own rule is that an
  ;; entry arrives when a real value needs it, never speculatively.
  :ml    {:label "millilitre" :symbol "mL" :quantity-kind :volume
          :authority :om-2 :om-2 "millilitre"
          :aliases #{:millilitre :milliliter :millilitres :milliliters}}
  :metre {:label "metre" :symbol "m" :quantity-kind :length
          :authority :om-2 :om-2 "metre"
          :aliases #{:meter :meters :metres :m}}

  :each  {:label "piece" :symbol "ea" :quantity-kind :count
          :authority :om-2 :om-2 "piece"
          :aliases #{:piece :pieces :pcs :ea :unit :units}
          :note "om-2 has no `each`. A count of things is `piece`; `one` is the
                 dimensionless ratio, which is a different quantity kind."}
  :ratio {:label "one" :symbol "1" :quantity-kind :ratio
          :authority :om-2 :om-2 "one"
          :aliases #{:one :dimensionless}}
  :percent {:label "percent" :symbol "%" :quantity-kind :ratio
            :authority :om-2 :om-2 "percent"
            :aliases #{:pct}}

  :jpy   {:label "Japanese yen" :symbol "¥" :quantity-kind :currency
          :authority :om-2 :om-2 "JapaneseYen" :iso-4217 "JPY"
          :aliases #{:yen :JPY}}
  :usd   {:label "United States dollar" :symbol "$" :quantity-kind :currency
          :authority :om-2 :om-2 "UnitedStatesDollar" :iso-4217 "USD"
          :aliases #{:dollar :USD}}
  :eur   {:label "euro" :symbol "€" :quantity-kind :currency
          :authority :om-2 :om-2 "euro" :iso-4217 "EUR"
          :aliases #{:euro :EUR}
          :note "om-2 spells this one lowercase while it capitalises the others"}

  ;; Two community units with no external authority. Recorded with
  ;; :authority :none rather than given plausible-looking IRIs, because
  ;; inventing one would make an unbacked identifier look backed.
  ;;
  ;; The ledger's own unit first. ENGI amounts are INTEGER micro-EN, and this is
  ;; registered as its own unit rather than converted: dividing by a million to
  ;; present EN would make the value a fraction, and integer exactness is what
  ;; ENGI's zero-net-supply invariant rests on. Compatible with :en (same
  ;; quantity kind) but not the same unit, so nothing adds them by accident.
  :micro-en {:label "micro-EN" :symbol "µEN" :quantity-kind :mutual-credit
             :authority :none
             :aliases #{:uen :μEN :microEN}
             :note "1 EN = 1,000,000 micro-EN. Conversion is the caller's
                    decision, made where the rounding can be seen."}

  :en    {:label "EN" :symbol "EN" :quantity-kind :mutual-credit
          :authority :none
          :aliases #{:EN}
          :note "ENGI mutual-credit unit (cloud-itonami/credits). Integer
                 micro-EN in the ledger; net supply is zero by construction.
                 Deliberately NOT :currency — it is not purchased, has no
                 issuer, and pays no interest, so treating it as money would
                 let it be added to yen."}}}
