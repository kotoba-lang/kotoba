;; Intel Xe2/Battlemage device admission and bring-up plan.
;;
;; This object owns the fail-closed decisions before mechanism receives PCI,
;; MMIO, DMA, and IRQ authority.  It deliberately performs no port or MMIO I/O:
;; capability-pci-config, capability-mmio-map, capability-dma-map, and
;; capability-irq-subscribe remain the atomic authority owners.

(defn intel-xe-device-admit
  [vendor-id device-id class-code bar0-bytes bar2-bytes]
  (if (and (= vendor-id 32902)
           (= device-id 57891)
           (= class-code 196608)
           (>= bar0-bytes 16777216)
           (>= bar2-bytes 34359738368))
    1
    0))

(defn intel-xe-authority-admit
  [memory-enabled bus-master-enabled iommu-granted dma-granted irq-granted]
  (if (and (= memory-enabled 1)
           (= bus-master-enabled 1)
           (= iommu-granted 1)
           (= dma-granted 1)
           (= irq-granted 1))
    1
    0))

;; 0 = invalid link, 1 = admitted but performance-degraded, 2 = full-width.
;; Link quality is not an authority decision: a slow but valid link may still
;; run compute workloads whose hot weights stay in device-local memory.
(defn intel-xe-link-grade [width speed-mtps]
  (if (or (<= width 0) (<= speed-mtps 0))
    0
    (if (or (< width 16) (< speed-mtps 32000)) 1 2)))

;; On admission the host mechanism executes these four bounded steps in order:
;; bit 0 map BAR0, bit 1 map BAR2, bit 2 establish DMA, bit 3 subscribe IRQ.
(defn intel-xe-bringup-plan [device-admitted authority-admitted]
  (if (and (= device-admitted 1) (= authority-admitted 1))
    15
    0))

;; Executable conformance vectors.  Zero means every vector passed.
(defn test-observed-b70-admitted []
  (= 1 (intel-xe-device-admit 32902 57891 196608 16777216 34359738368)))

(defn test-authorities-admitted []
  (= 1 (intel-xe-authority-admit 1 1 1 1 1)))

(defn test-plan-has-four-bounded-steps []
  (= 15 (intel-xe-bringup-plan 1 1)))

(defn test-wrong-vendor-refused []
  (= 0 (intel-xe-device-admit 4098 57891 196608 16777216 34359738368)))

(defn test-small-resizable-bar-refused []
  (= 0 (intel-xe-device-admit 32902 57891 196608 16777216 8589934592)))

(defn test-missing-iommu-refused []
  (= 0 (intel-xe-authority-admit 1 1 0 1 1)))

(defn test-observed-link-is-degraded []
  (= 1 (intel-xe-link-grade 1 2500)))

(defn test-full-link-is-ready []
  (= 2 (intel-xe-link-grade 16 32000)))

(defn main []
  (if (not (= 1 (intel-xe-device-admit
                  32902 57891 196608 16777216 34359738368)))
    1
    (if (not (= 1 (intel-xe-authority-admit 1 1 1 1 1)))
      2
      (if (not (= 15 (intel-xe-bringup-plan 1 1)))
        3
        (if (not (= 0 (intel-xe-device-admit
                        4098 57891 196608 16777216 34359738368)))
          4
          (if (not (= 0 (intel-xe-device-admit
                          32902 57891 196608 16777216 8589934592)))
            5
            (if (not (= 0 (intel-xe-authority-admit 1 1 0 1 1)))
              6
              (if (not (= 1 (intel-xe-link-grade 1 2500)))
                7
                (if (not (= 2 (intel-xe-link-grade 16 32000)))
                  8
                  0)))))))))
