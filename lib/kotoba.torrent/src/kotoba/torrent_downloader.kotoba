(ns kotoba.torrent-downloader)

(defn bt-tracker-get [host-ptr host-length port path-ptr path-length
                      response-ptr response-cap]
  (http-get host-ptr host-length port path-ptr path-length
            response-ptr response-cap))

(defn bt-read-exact [^:i64 channel out-ptr expected offset]
  (if (>= offset expected)
    offset
    (let [read (transport-read channel (+ out-ptr offset) (- expected offset))]
      (if (<= read 0)
        -1
        (bt-read-exact channel out-ptr expected (+ offset read))))))

(defn bt-verify-and-save-piece! [piece-ptr piece-length expected-sha1-ptr
                                 path-ptr path-length workspace workspace-cap]
  (if (= (sha1-equal? piece-ptr piece-length expected-sha1-ptr
                      workspace workspace-cap) 0)
    -2
    (fs-write-atomic path-ptr path-length piece-ptr piece-length)))

(defn bt-download-block-from-unchoked-peer!
  [host-ptr host-length port info-hash-ptr peer-id-ptr
   piece-index piece-begin piece-length expected-sha1-ptr
   path-ptr path-length io-ptr io-cap workspace workspace-cap]
  (if (or (> piece-length 16384) (< io-cap (+ piece-length 269)))
    -1
    (let [channel (transport-connect host-ptr host-length port)]
      (if (= channel 0)
        -1
        (let [handshake-size (bt-handshake! io-ptr io-cap info-hash-ptr peer-id-ptr)
              handshake-written (if (= handshake-size 68)
                                  (transport-write channel io-ptr 68)
                                  -1)
              peer-handshake-ptr (+ io-ptr 96)
              handshake-read (if (= handshake-written 68)
                               (bt-read-exact channel peer-handshake-ptr 68 0)
                               -1)]
          (if (or (not (= handshake-read 68))
                  (= (bt-handshake-valid? peer-handshake-ptr 68 info-hash-ptr) 0))
            (let [closed (transport-close channel)] -1)
            (let [request-size (bt-request! io-ptr io-cap piece-index
                                            piece-begin piece-length)
                  request-written (if (= request-size 17)
                                    (transport-write channel io-ptr 17)
                                    -1)
                  response-ptr (+ io-ptr 192)
                  response-size (+ piece-length 13)
                  response-read (if (= request-written 17)
                                  (bt-read-exact channel response-ptr response-size 0)
                                  -1)
                  payload-length (if (= response-read response-size)
                                   (bt-piece-valid? response-ptr response-size
                                                    piece-index piece-begin 16384)
                                   -1)
                  saved (if (= payload-length piece-length)
                          (bt-verify-and-save-piece!
                           (+ response-ptr 13) piece-length expected-sha1-ptr
                           path-ptr path-length workspace workspace-cap)
                          -1)
                  closed (transport-close channel)]
              saved)))))))

(defn main [] 1)
