;; Port of kotoba.netcap.surface-to-cap (surface_to_cap.cljk), Kotoba-native.
;;
;; surface->cap maps a surface keyword to the net capability string "net:<name>".
;;
;; Named divergences from surface_to_cap.cljk:
;;   - the surface is a :keyword; (name s) is keyword-name.

(ns kotoba.netcap.surface-to-cap
  (:export [surface->cap]))

(defn surface->cap [s :keyword] :string
  (string-concat "net:" (keyword-name s)))
