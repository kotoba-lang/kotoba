;; Port of kotoba.netcap.make-net-manager (make_net_manager.cljk), Kotoba-native.
;;
;; Returns the :document map {:policy p :drivers d :opts o}. The three inputs
;; are kept as given (documents, nil is document-null).

(ns kotoba.netcap.make-net-manager
  (:export [make-net-manager]))

(defn make-net-manager [policy :document drivers :document opts :document] :document
  (document-map :policy policy :drivers drivers :opts opts))
