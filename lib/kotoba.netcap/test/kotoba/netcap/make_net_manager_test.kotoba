(ns kotoba.netcap.make-net-manager-test (:export [main]) (:require [kotoba.netcap.make-net-manager :as p]))

(defn- g [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))

(defn- same [a :document b :document] :bool
  (string=? (document-edn-print a) (document-edn-print b)))

(defn main [] :i64
  (let [pol (document-map :net (document-string "deny"))
        drv (document-vector (document-string "tcp"))
        opt (document-map :timeout (document-i64 5))
        m (p/make-net-manager pol drv opt)]
    (+ (if (same (g m :policy) pol) 0 1)
       (if (same (g m :drivers) drv) 0 1)
       (if (same (g m :opts) opt) 0 1)
       (if (document-contains m :policy) 0 1))))
