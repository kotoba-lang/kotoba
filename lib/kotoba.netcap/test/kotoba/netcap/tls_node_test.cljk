(ns kotoba.netcap.tls-node-test
  "kotoba.netcap.tls-host on kbb (node:tls): the same loopback cases as the
  JVM oracle (tls_jvm_test), against a node:tls server holding the test PKI.
  kbb only; the JVM has its own file."
  (:require #?(:clj [kotoba.test :refer [deftest is testing]] :cljs [kotoba.test :refer [deftest is testing async]])
            #?(:cljs [kotoba.netcap.tls-host :as host])
            #?(:cljs [kotoba.netcap.tls-fixtures :as fx])))

#?(:cljs
   (do
     (def ^:private node-tls (js/require "node:tls"))

     (defn- server!
       "A node:tls echo server on 127.0.0.1; resolves {:port :close}."
       [cert key client-auth?]
       (js/Promise.
        (fn [resolve _]
          (let [srv (.createServer node-tls
                                   (clj->js (cond-> {:cert cert :key key}
                                              client-auth? (assoc :ca fx/ca-pem :requestCert true :rejectUnauthorized true)))
                                   (fn [s]
                                     (.on s "error" (fn [_] nil))
                                     (.on s "data" (fn [b] (.write s b) (.end s)))))]
            (.on srv "tlsClientError" (fn [_ _] nil))
            (.listen srv 0 "127.0.0.1"
                     (fn [] (resolve {:port (.-port (.address srv)) :close #(.close srv)})))))))

     (defn- echo!
       "Resolves [:ok byte] / [:refused code message] for one connect + echo."
       [req]
       (-> (host/connect req)
           (.then (fn [s]
                    (js/Promise.
                     (fn [resolve _]
                       (let [info (host/session-info s)]
                         (.once s "data" (fn [b] (.destroy s) (resolve [:ok (aget b 0) info])))
                         (.once s "error" (fn [e] (resolve [:refused (.-code e) (.-message e)])))
                         (.write s (js/Buffer.from #js [42])))))))
           (.catch (fn [e] [:refused (.-code e) (.-message e)]))))))

(deftest node-loopback-cases
  #?(:cljs
     (async done
       (let [servers (atom [])]
       (-> (js/Promise.all #js [(server! fx/server-pem fx/server-key-pem false)
                                (server! fx/other-pem fx/other-key-pem false)
                                (server! fx/server-pem fx/server-key-pem true)])
           (.then
            (fn [[good other mtls]]
              (reset! servers [good other mtls])
              (let [anchors {:anchors-pem fx/ca-pem}]
                (-> (js/Promise.all
                     #js [(echo! {:host "localhost" :port (:port good) :timeout-ms 5000 :trust anchors})
                          (echo! {:host "127.0.0.1" :port (:port good) :timeout-ms 5000 :trust anchors})
                          (echo! {:host "localhost" :port (:port other) :timeout-ms 5000 :trust anchors})
                          (echo! {:host "localhost" :port (:port other) :timeout-ms 5000})
                          (echo! {:host "127.0.0.1" :port (:port other) :timeout-ms 5000
                                  :trust {:pin-spki-sha256 #{fx/other-spki-sha256}}})
                          (echo! {:host "localhost" :port (:port other) :timeout-ms 5000
                                  :trust {:pin-spki-sha256 #{fx/server-spki-sha256}}})
                          (echo! {:host "localhost" :port (:port mtls) :timeout-ms 5000 :trust anchors
                                  :identity {:cert-chain-pem fx/client-pem :key-pem fx/client-key-pem}})
                          (echo! {:host "localhost" :port (:port mtls) :timeout-ms 5000 :trust anchors})
                          (echo! {:host "localhost" :port (:port good) :timeout-ms 5000 :trust anchors
                                  :protocols #{"TLSv1.2"}})])
                    (.then
                     (fn [rs]
                       (let [[trusted mismatch untrusted system pin-ok pin-bad mtls-ok mtls-none tls12] (vec rs)]
                         (testing "trusted name: accepted, and the peer key is the server's"
                           (is (= [:ok 42] (take 2 trusted)))
                           (is (= fx/server-spki-sha256 (:peer-spki-sha256 (nth trusted 2)))))
                         (testing "name mismatch (certificate says localhost, socket to 127.0.0.1): refused"
                           (is (= [:refused "ERR_TLS_CERT_ALTNAME_INVALID"] (take 2 mismatch))))
                         (testing "untrusted issuer: refused with anchors and with :system"
                           (is (= :refused (first untrusted)))
                           (is (= :refused (first system)))
                           (is (true? (host/tls-exception? #js {:code (second untrusted)}))))
                         (testing "SPKI pin: the right pin reaches even an address; the wrong one names the key seen"
                           (is (= [:ok 42] (take 2 pin-ok)))
                           (is (= [:refused "ERR_TLS_SPKI_PIN_MISMATCH"] (take 2 pin-bad)))
                           (is (re-find (re-pattern fx/other-spki-sha256) (str (nth pin-bad 2)))))
                         (testing "mutual TLS"
                           (is (= [:ok 42] (take 2 mtls-ok)))
                           (is (= :refused (first mtls-none))))
                         (testing "protocols are applied"
                           (is (= "TLSv1.2" (:protocol (nth tls12 2))))))))))))
           (.catch (fn [e] (is (nil? e) "the loopback servers did not start")))
           (.finally (fn []
                       (doseq [server @servers] ((:close server)))
                       (done))))))))
