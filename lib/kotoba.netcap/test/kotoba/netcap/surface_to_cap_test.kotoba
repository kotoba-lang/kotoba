(ns kotoba.netcap.surface-to-cap-test
  (:export [main])
  (:require [kotoba.netcap.surface-to-cap :as s]))

(defn main [] :i64
  (+ (if (string=? (s/surface->cap :http) "net:http") 0 1)
     (if (string=? (s/surface->cap :tcp) "net:tcp") 0 1)
     (if (string=? (s/surface->cap :dns) "net:tcp") 1 0)))
