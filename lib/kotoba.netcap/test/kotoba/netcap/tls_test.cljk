(ns kotoba.netcap.tls-test
  "kotoba.netcap.tls, the pure half, on both hosts: every refusal by its
  literal keyword, the boundaries of every bound, the grant, and that a
  refused request never reaches the driver."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.netcap.tls :as tls]
            [kotoba.netcap.tls-host :as host]
            [kotoba.netcap.tls-fixtures :as fx]))

(defn- refusal [f]
  (try (f) nil
       (catch #?(:clj clojure.lang.ExceptionInfo :cljs :default) e
         (::tls/error (ex-data e)))))

(def ok {:host "imap.example.com" :port 993})

(deftest validate-accepts-the-plain-request
  (is (nil? (tls/validate-connect ok)))
  (is (nil? (tls/validate-connect (assoc ok :host "127.0.0.1"))))
  (is (nil? (tls/validate-connect (assoc ok :host "::1"))))
  (is (nil? (tls/validate-connect (assoc ok :host "[2001:db8::1]"))))
  (is (nil? (tls/validate-connect (assoc ok :host "example.com."))))
  (is (nil? (tls/validate-connect (assoc ok :trust {:anchors-pem fx/ca-pem}))))
  (is (nil? (tls/validate-connect (assoc ok :trust {:pin-spki-sha256 #{fx/server-spki-sha256}}))))
  (is (nil? (tls/validate-connect (assoc ok :identity {:cert-chain-pem fx/client-pem :key-pem fx/client-key-pem}))))
  (is (nil? (tls/validate-connect (assoc ok :protocols #{"TLSv1.3"})))))

(deftest validate-refuses-by-name
  (testing "host"
    (is (= :host-missing (tls/validate-connect (dissoc ok :host))))
    (is (= :host-missing (tls/validate-connect (assoc ok :host "  "))))
    (is (= :host-invalid (tls/validate-connect (assoc ok :host "bad host"))))
    (is (= :host-invalid (tls/validate-connect (assoc ok :host "under_score.example"))))
    (is (= :host-invalid (tls/validate-connect (assoc ok :host "-lead.example"))))
    (is (= :host-invalid (tls/validate-connect (assoc ok :host "exämple.com"))))
    (is (= :host-invalid (tls/validate-connect (assoc ok :host "256.1.1.1"))))
    (is (= :host-invalid (tls/validate-connect (assoc ok :host 42)))))
  (testing "port: 1 and 65535 are the edges"
    (is (nil? (tls/validate-connect (assoc ok :port 1))))
    (is (nil? (tls/validate-connect (assoc ok :port 65535))))
    (is (= :port-invalid (tls/validate-connect (assoc ok :port 0))))
    (is (= :port-invalid (tls/validate-connect (assoc ok :port 65536))))
    (is (= :port-invalid (tls/validate-connect (assoc ok :port "993"))))
    (is (= :port-invalid (tls/validate-connect (dissoc ok :port)))))
  (testing "timeouts: 1 and max are the edges"
    (is (nil? (tls/validate-connect (assoc ok :timeout-ms 1))))
    (is (nil? (tls/validate-connect (assoc ok :timeout-ms tls/max-timeout-ms))))
    (is (= :timeout-invalid (tls/validate-connect (assoc ok :timeout-ms 0))))
    (is (= :timeout-invalid (tls/validate-connect (assoc ok :timeout-ms (inc tls/max-timeout-ms)))))
    (is (= :timeout-invalid (tls/validate-connect (assoc ok :timeout-ms nil))))
    (is (= :connect-timeout-invalid (tls/validate-connect (assoc ok :connect-timeout-ms -1)))))
  (testing "server name, trust, identity, protocols"
    (is (= :server-name-invalid (tls/validate-connect (assoc ok :server-name "10.0.0.1:x"))))
    (is (= :trust-invalid (tls/validate-connect (assoc ok :trust :none))))
    (is (= :trust-invalid (tls/validate-connect (assoc ok :trust {:anchors-pem "not a pem"}))))
    (is (= :trust-invalid (tls/validate-connect (assoc ok :trust {:pin-spki-sha256 #{"ABC"}}))))
    (is (= :trust-invalid (tls/validate-connect (assoc ok :trust {:pin-spki-sha256 #{}}))))
    (is (= :trust-invalid (tls/validate-connect (assoc ok :trust {:anchors-pem fx/ca-pem :pin-spki-sha256 #{fx/server-spki-sha256}}))))
    (is (= :identity-invalid (tls/validate-connect (assoc ok :identity {:cert-chain-pem fx/client-pem}))))
    (is (= :identity-invalid (tls/validate-connect (assoc ok :identity {:cert-chain-pem fx/client-pem :key-pem fx/client-pem}))))
    (is (= :protocols-invalid (tls/validate-connect (assoc ok :protocols #{"SSLv3"}))))
    (is (= :protocols-invalid (tls/validate-connect (assoc ok :protocols #{}))))
    (is (= :request-invalid (tls/validate-connect "imap.example.com:993")))))

(deftest server-name-and-defaults
  (is (= "imap.example.com" (tls/server-name ok)))
  (is (nil? (tls/server-name (assoc ok :host "127.0.0.1"))) "no SNI for an address")
  (is (= "localhost" (tls/server-name (assoc ok :host "127.0.0.1" :server-name "localhost"))))
  (is (= "example.com" (tls/server-name (assoc ok :host "example.com."))))
  (let [n (tls/normalize ok)]
    (is (= 20000 (:timeout-ms n)))
    (is (= 20000 (:connect-timeout-ms n)))
    (is (= :system (:trust n)))
    (is (true? (:verify-hostname? n))))
  (is (= 5 (:connect-timeout-ms (tls/normalize (assoc ok :timeout-ms 5)))))
  (is (false? (:verify-hostname? (tls/normalize (assoc ok :trust {:pin-spki-sha256 #{fx/server-spki-sha256}}))))
      "a pin is the identity: the name is not checked"))

(deftest the-grant
  (let [calls (atom [])
        d (tls/recording-driver calls (fn [r] [:stream (:host r)]))]
    (testing "a connector nobody granted anything reaches nothing"
      (is (= :not-granted (refusal #(tls/connect! (tls/connector d) ok))))
      (is (= [] @calls)))
    (testing "host strings grant any port; [host port] grants one port"
      (let [c (tls/connector d {:allow #{"IMAP.example.com." ["smtp.example.com" 465]}})]
        (is (= [:stream "imap.example.com"] (tls/connect! c ok)))
        (is (= [:stream "smtp.example.com"] (tls/connect! c {:host "smtp.example.com" :port 465})))
        (is (= :not-granted (refusal #(tls/connect! c {:host "smtp.example.com" :port 587}))))
        (is (= :not-granted (refusal #(tls/connect! c {:host "pop.example.com" :port 995}))))))
    (testing "a refused request never reaches the driver"
      (reset! calls [])
      (is (= :port-invalid (refusal #(tls/connect! (tls/connector d {:allow :any}) (assoc ok :port 0)))))
      (is (= [] @calls)))
    (testing "the driver receives the normalized request"
      (reset! calls [])
      (tls/connect! (tls/connector d {:allow :any}) ok)
      (is (= [(tls/normalize ok)] @calls)))
    (testing "connector refuses a non-driver and a malformed grant"
      (is (= :request-invalid (refusal #(tls/connector {} {:allow :any}))))
      (is (= :request-invalid (refusal #(tls/connector d {:allow "everything"}))))
      (is (= :request-invalid (refusal #(tls/connect! {:not :a-connector} ok)))))))

(deftest identity-never-in-ex-data
  (let [req (assoc ok :port 0 :identity {:cert-chain-pem fx/client-pem :key-pem fx/client-key-pem})
        data (try (tls/connect! (tls/connector (tls/recording-driver (atom []) identity) {:allow :any}) req) nil
                  (catch #?(:clj clojure.lang.ExceptionInfo :cljs :default) e (ex-data e)))]
    (is (= :port-invalid (::tls/error data)))
    (is (= :redacted (get-in data [:request :identity])))
    (is (not (re-find #"PRIVATE KEY" (pr-str data))))))

(deftest host-door-validates-before-any-socket
  (is (= :host-invalid (refusal #(host/connect {:host "bad host" :port 443}))))
  (is (= :port-invalid (refusal #(host/connect {:host "localhost" :port 70000}))))
  (is (= :trust-invalid (refusal #(host/connect {:host "localhost" :port 443 :trust :none})))))

(deftest tls-exception-classification
  (is (false? (host/tls-exception? (ex-info "x" {}))))
  (is (false? (host/tls-exception? nil)))
  #?(:clj (is (true? (host/tls-exception? (javax.net.ssl.SSLHandshakeException. "x")))))
  #?(:clj (is (false? (host/tls-exception? (java.io.IOException. "x")))))
  #?(:cljs (is (true? (host/tls-exception? (doto (js/Error. "x") (aset "code" "ERR_TLS_CERT_ALTNAME_INVALID"))))))
  #?(:cljs (is (true? (host/tls-exception? (doto (js/Error. "x") (aset "code" "UNABLE_TO_VERIFY_LEAF_SIGNATURE"))))))
  #?(:cljs (is (false? (host/tls-exception? (doto (js/Error. "x") (aset "code" "ECONNREFUSED")))))))
