{:paths ["src"]
 :version "0.1.0"
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        io.github.kotoba-lang/netcap-net
        {:git/url "https://github.com/kotoba-lang/netcap-net.git"
         :git/sha "fd8008183d55a2cdf0304694b42c44f58e4263c0"}
        io.github.kotoba-lang/netcap-call
        {:git/url "https://github.com/kotoba-lang/netcap-call.git"
         :git/sha "daaae0fb8fb40e455b250f5257ecaa082b1a3850"}
        io.github.kotoba-lang/netcap-discover
        {:git/url "https://github.com/kotoba-lang/netcap-discover.git"
         :git/sha "2f17ef8ebacd24389262777c80df875c37f88c37"}
        io.github.kotoba-lang/netcap-make-net-manager
        {:git/url "https://github.com/kotoba-lang/netcap-make-net-manager.git"
         :git/sha "6f0da28e4936c3a2e0ab07181cc4261eb5a14c1a"}
        io.github.kotoba-lang/netcap-mock-net
        {:git/url "https://github.com/kotoba-lang/netcap-mock-net.git"
         :git/sha "e71fd552bf9b0078a78e987705763c3dc30f86ba"}
        io.github.kotoba-lang/netcap-surface-cap
        {:git/url "https://github.com/kotoba-lang/netcap-surface-cap.git"
         :git/sha "fdf4e70b43a1462a91356be56ef6865613cd788f"}
        io.github.kotoba-lang/netcap-surfaces
        {:git/url "https://github.com/kotoba-lang/netcap-surfaces.git"
         :git/sha "d2f1dff156450eaff8d0010f2d1480f3068d6537"}
io.github.kotoba-lang/wit  {:git/sha "5708fb98c9e25f233c5e44afe155328b29982cb2"}
        io.github.kotoba-lang/coll {:git/sha "9740cc2dc43a192077d77374b869a37940c801e4"}
        ;; kotoba.netcap.tls / tls-host use kotoba.lang.text, not clojure.string.
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
