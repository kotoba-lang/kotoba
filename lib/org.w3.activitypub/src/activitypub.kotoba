(ns activitypub
  (:export [main context-key as-context public actor collection ordered-collection
            ordered-page endpoints activity-request errors validate]))

(defn context-key [] :keyword (keyword-from-string "@context"))
(defn as-context [] :string "https://www.w3.org/ns/activitystreams")
(defn public [] :string "https://www.w3.org/ns/activitystreams#Public")

(defn fail-document [] :document
  (document-vector-assoc (document-vector) 0 (document-null)))

(defn field [value :document key :keyword] :document
  (option-or (document-get value key) (fail-document)))

(defn doc-bool [value :document] :bool
  (option-or (document-bool-value value) false))

(defn keyword-equal? [left :keyword right :keyword] :bool
  (if (= left right) true false))

(defn present? [value :document] :bool
  (case (document-kind value)
    :null false
    :bool (doc-bool value)
    true))

(defn optional-field [output :document options :document source :keyword target :keyword] :document
  (if (document-contains options source)
    (let [value (field options source)]
      (if (present? value) (document-assoc output target value) output))
    output))

(defn default-type [options :document fallback :string] :document
  (if (document-contains options :type)
    (let [candidate (field options :type)]
      (if (present? candidate) candidate (document-string fallback)))
    (document-string fallback)))

(defn actor [options :document] :document
  (let [base (document-map
               (context-key) (document-string (as-context))
               :id (if (document-contains options :id)
                     (field options :id) (document-null))
               :type (default-type options "Person")
               :inbox (if (document-contains options :inbox)
                        (field options :inbox) (document-null))
               :outbox (if (document-contains options :outbox)
                         (field options :outbox) (document-null)))
        a (optional-field base options :followers :followers)
        b (optional-field a options :following :following)
        c (optional-field b options :liked :liked)
        d (optional-field c options :preferred-username :preferredUsername)
        e (optional-field d options :name :name)
        f (optional-field e options :summary :summary)]
    (optional-field f options :public-key :publicKey)))

(defn collection-items [options :document output :document] :document
  (if (document-contains options :items)
    (let [items (field options :items)]
      (if (present? items)
        (if (keyword-equal? (document-kind items) :vector)
          (document-assoc output :items items)
          (fail-document))
        output))
    output))

(defn collection [options :document] :document
  (let [base (document-map
               (context-key) (document-string (as-context))
               :id (if (document-contains options :id)
                     (field options :id) (document-null))
               :type (default-type options "Collection"))
        a (optional-field base options :total-items :totalItems)
        b (collection-items options a)
        c (optional-field b options :first :first)
        d (optional-field c options :last :last)
        e (optional-field d options :current :current)
        f (optional-field e options :next :next)]
    (optional-field f options :prev :prev)))

(defn ordered-collection [options :document] :document
  (collection (document-assoc options :type (document-string "OrderedCollection"))))

(defn ordered-page [options :document] :document
  (collection (document-assoc options :type (document-string "OrderedCollectionPage"))))

(defn endpoints [base :string] :document
  (document-map
    :inbox (document-string (string-concat base "/inbox"))
    :outbox (document-string (string-concat base "/outbox"))
    :followers (document-string (string-concat base "/followers"))
    :following (document-string (string-concat base "/following"))
    :liked (document-string (string-concat base "/liked"))))

(defn required-or-null [options :document key :keyword] :document
  (if (document-contains options key) (field options key) (document-null)))

(defn headers-or-empty [options :document] :document
  (if (document-contains options :headers)
    (let [headers (field options :headers)]
      (if (present? headers) headers (document-map)))
    (document-map)))

(defn activity-request [options :document] :document
  (document-map
    :method (required-or-null options :method)
    :url (required-or-null options :url)
    :actor (required-or-null options :actor)
    :object (required-or-null options :object)
    :headers (headers-or-empty options)
    :body (required-or-null options :body)))

(defn error [code :keyword] :document
  (document-map :error (document-keyword code)))

(defn null-or-missing? [value :document key :keyword] :bool
  (if (document-contains value key)
    (keyword-equal? (document-kind (field value key)) :null)
    true))

(defn errors [value :document] :document
  (if (keyword-equal? (document-kind value) :map)
    (let [after-id (if (null-or-missing? value :id)
                     (document-vector (error :activitypub/missing-id))
                     (document-vector))]
      (if (null-or-missing? value :type)
        (document-vector-conj after-id (error :activitypub/missing-type))
        after-id))
    (document-vector (error :activitypub/document-must-be-map))))

(defn validate [value :document] :document
  (let [found (errors value)]
    (document-map
      :valid? (document-bool (if (= (document-count found) 0) true false))
      :errors found)))

(defn main [] :i64 0)
