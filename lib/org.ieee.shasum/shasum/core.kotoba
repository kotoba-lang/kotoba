;; shasum -- the SHA-256 form of shasum(1), as a Kotoba command.
;;
;;   shasum -a 256 FILE...    `<64 hex>  FILE` per operand
;;   ... | shasum -a 256      `<64 hex>  -` over standard input
;;
;; ## Measured, 2026-09-16
;;
;; 832 invocations in 1,268,018 agent Bash calls (superproject
;; ADR-2609161710): `shasum -a 256` 612, bare `shasum` (SHA-1) 211. Only
;; SHA-256 is here: `:hash/sha256` (wire 3) is the digest the capability
;; catalog names, and the loader gained a real provider for it the same day
;; (amu #1016). `-a 1` and every other algorithm are refused with a message,
;; exit 1 -- named divergences, since /usr/bin/shasum answers them.
;;
;; The digest itself is the host's: the request is the file's bytes (or
;; stdin's), the answer 64 hex characters. An unreadable operand is reported
;; as shasum reports it, the walk continues, and the exit status is 1.
;;
;; Capabilities: :cli/args (38), :fs/app-data (35), :io/read (41),
;; :hash/sha256 (3), :io/write (37), :io/write-error (39).
(ns shasum.core (:export [main]))

(defn arg [i :string] :string
  (typed-cap-call :cli/args :string :string i))

(defn emit [s :string] :string
  (typed-cap-call :io/write :string :string s))

(defn emit-error [s :string] :string
  (typed-cap-call :io/write-error :string :string s))

(defn slurp-file [path :string] :string
  (typed-cap-call :fs/app-data :string :string path))

(defn stdin [n :string] :string
  (typed-cap-call :io/read :string :string n))

(defn sha256 [s :string] :string
  (typed-cap-call :hash/sha256 :string :string s))

(defn readable? [path :string] :bool
  (string=? (typed-cap-call :fs/app-data :string :string
                            (string-concat path "EXISTS_SEP"))
            "1"))

(defn nl [] :string "\n")

(defn digit-text [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn decimal-of [n :i64] :string
  (if (< n 10)
    (digit-text n)
    (string-concat (decimal-of (quot n 10)) (digit-text (- n (* 10 (quot n 10)))))))

(defn argc-from [k :i64 total :string] :i64
  (if (string=? (decimal-of k) total) k (argc-from (+ k 1) total)))

(defn argc [] :i64 (argc-from 0 (arg "")))

(defn- line [text :string label :string] :i64
  (do (emit (sha256 text)) (emit "  ") (emit label) (emit (nl)) 0))

(defn- complain [path :string] :i64
  (do (emit-error "shasum: ") (emit-error path) (emit-error ": No such file or directory") (emit-error (nl)) 1))

;; Each operand from I; answers 1 when any was unreadable.
(defn- each [i :i64 n :i64 worst :i64] :i64
  (if (>= i n)
    worst
    (let [path (arg (decimal-of i))]
      (if (readable? path)
        (do (line (slurp-file path) path) (each (+ i 1) n worst))
        (do (complain path) (each (+ i 1) n 1))))))

(defn- refuse-algorithm [] :i64
  (do (emit-error "shasum: only -a 256 is supported here (Unrecognized algorithm)")
      (emit-error (nl))
      1))

(defn main [] :i64
  (let [n (argc)]
    (if (< n 2)
      (refuse-algorithm)
      (if (if (string=? (arg "0") "-a") (string=? (arg "1") "256") false)
        (if (= n 2)
          (line (stdin "") "-")
          (each 2 n 0))
        (refuse-algorithm)))))
