{:paths ["src"]
 ;; No runtime dependencies. Transport and JSON are injected (:http-fn,
 ;; :json-write, :json-read), the same DI shape as kotoba-lang/com-x and
 ;; tayori.channel.slack. A client that carries its own HTTP stack cannot be
 ;; tested without one.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
