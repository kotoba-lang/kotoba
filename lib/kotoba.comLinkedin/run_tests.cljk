(ns run-tests
  "nbb test runner (primary path; `kbb -M:test` is the JVM secondary)."
  (:require [cljs.test :as t]
            [linkedin.client-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println (if (t/successful? m) "\ncom-linkedin: OK" "\ncom-linkedin: FAILED"))
  (when-not (t/successful? m) (js/process.exit 1)))

(t/run-tests 'linkedin.client-test)
