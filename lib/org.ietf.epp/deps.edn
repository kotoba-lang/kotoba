{:paths ["src"]
 ;; kotoba-lang/xml supplies both directions of the XML boundary (hiccup emit +
 ;; a zero-dependency parser); kotoba-lang/srs supplies the lifecycle this
 ;; protocol is a front end for. Both are .cljc with no third-party deps, so
 ;; this library stays portable.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/xml {:local/root "../kotoba.xml"}
        io.github.kotoba-lang/srs {:local/root "../kotoba.srs"}}
 :aliases
 {:test {:extra-paths ["test"]}
  ;; local checkouts for workspace development (orgs/kotoba-lang/*)
  :dev {:override-deps {io.github.kotoba-lang/xml {:local/root "../xml"}
                        io.github.kotoba-lang/srs {:local/root "../srs"}}}}}
