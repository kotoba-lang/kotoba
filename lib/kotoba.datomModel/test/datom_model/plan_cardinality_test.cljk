(ns datom-model.plan-cardinality-test
  "Ported from `kotoba-lang/kotobase-peer`'s `kotobase-peer.plan-cardinality-test`
  (@ ea4a8e8b0f757a5f15a28cc3a0ac42406b65ffde).

  ADR-2608021000 §6-4-1: the planner already measures each clause's
  cardinality to choose an order, and used to throw those numbers away. It now
  hands them to the executor, which uses them to choose a STRATEGY per clause
  -- one broad scan plus a hash join when a clause's relation is small
  relative to the number of keyed scans a step would issue for it.

  What is asserted here is that the hint is emitted, is keyed the way the
  executor looks it up, and matches the estimates the plan itself used. That
  the hint cannot change an ANSWER is `datalog`'s own equivalence suite; this
  side only has to not lie about the numbers.

  The one porting change, the same one that runs through `core-test`: `ref?`
  is a required argument here, so `transact` gains an explicit predicate where
  the source relied on `ipld.core/link?` by default. This db has no reference
  values, so that predicate is `no-refs`."
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [datom-model.core :as m]))

(def ^:private everything (constantly true))
(def ^:private no-refs (constantly false))

(defn- db []
  (m/transact (m/empty-db)
              (concat
               (for [i (range 30)] {:s (str "m" i) :p "creator" :o (str "p" (mod i 5))})
               (for [i (range 30)] {:s (str "m" i) :p "date" :o (str i)})
               (for [i (range 5)] {:s (str "p" i) :p "role" :o "author"}))
              no-refs))

(deftest the-plan-hands-its-own-estimates-to-the-executor
  (let [query '{:find [?m ?d]
                :where [[?m "creator" ?p] [?m "date" ?d] [?p "role" "author"]]}
        plan (m/datalog-query-plan (db) query everything)
        hint (get-in plan [:query :clause-cardinality])]
    (is (:optimized? plan))
    (testing "keyed by the clause itself -- how datalog.core looks it up"
      (is (= (set (:where query)) (set (keys hint)))))
    (testing "the numbers are the ones the plan ordered on, not a second guess"
      (is (= (into {} (map (juxt :clause :estimated-rows)) (:plan plan)) hint)))
    (is (= 30 (get hint '[?m "creator" ?p])))
    (is (= 5 (get hint '[?p "role" "author"])))))

(deftest an-unoptimized-plan-emits-no-hint
  ;; Queries with functions/negation keep source order and are not estimated,
  ;; so there is nothing to hand over. A hint that is absent leaves the
  ;; executor on the keyed path, which is the safe default.
  (let [query '{:find [?s] :where [[?s "date" ?d] [(> ?d 18)]]}
        plan (m/datalog-query-plan (db) query everything)]
    (is (false? (:optimized? plan)))
    (is (nil? (get-in plan [:query :clause-cardinality])))))

(deftest the-hint-does-not-change-what-query-returns
  ;; End to end through `datom-model.core/query`, which is what actually
  ;; threads the hint into `datalog.core/q`.
  (let [d (db)
        query '{:find [?m] :where [[?m "creator" ?p] [?p "role" "author"]]}]
    (is (= 30 (count (m/query d query everything))))))

(deftest cardinality-agrees-with-counting-the-query
  ;; The estimate swapped `(count (dq/query ...))` for `dq/cardinality`. That
  ;; is only a safe swap if the two agree under the SAME `visible?`, including
  ;; a restrictive one -- a count that reported rows a read would not return
  ;; would order the plan on a number the executor can never realize.
  (let [d (db)
        only-m1 (fn [{:keys [s]}] (= "m1" s))
        query '{:find [?m ?p] :where [[?m "creator" ?p]]}]
    (doseq [visible? [everything only-m1]]
      (let [plan (m/datalog-query-plan d query visible?)
            hint (get-in plan [:query :clause-cardinality])]
        (is (= (count (m/query d query visible?))
               (get hint '[?m "creator" ?p])))))))
