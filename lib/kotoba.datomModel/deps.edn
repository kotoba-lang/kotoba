{:paths ["src"]
 ;; Two runtime dependencies, both storage-free:
 ;;   datalog -- the four covering indexes, triple-pattern routing, and the
 ;;              semi-naive Datalog evaluator (its own closure is datom-source)
 ;;   datom   -- the canonical `[e a v]` datom representation (zero deps)
 ;;
 ;; Deliberately absent, and this is the point of the extraction:
 ;; arrangement, prolly-tree, chain, io-ipld, io-multiformats, org-ietf-cbor,
 ;; block-cache, sigv4. Nothing here stores, hashes, addresses, chains, or
 ;; encrypts anything. The two places kotobase-peer's model half still touched
 ;; IPLD (`ipld/link?` as the default `ref?`, and `link->edn` inside `datoms`'
 ;; wire encoder) are injected parameters here instead -- see the README.
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/datalog {:local/root "../kotoba.datalog"}
        io.github.kotoba-lang/datom {:local/root "../kotoba.datom"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
