;; denwa — portable .cljk; every dependency is first-party kotoba-lang.
;; Every dependency is pinned by a sha reachable from its upstream main.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/nafuda {:local/root "../kotoba.nafuda"}
        io.github.kotoba-lang/tsunagi {:local/root "../kotoba.tsunagi"}
        io.github.kotoba-lang/shamir {:local/root "../kotoba.shamir"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/org-ietf-ed25519 {:local/root "../org.ietf.ed25519"}
        io.github.kotoba-lang/org-ietf-x25519 {:local/root "../org.ietf.x25519"}
        io.github.kotoba-lang/org-nist-sha2 {:local/root "../gov.nist.sha2"}
        io.github.kotoba-lang/org-ietf-chacha20-poly1305 {:local/root "../org.ietf.chacha20Poly1305"}
        io.github.kotoba-lang/org-ietf-hpke {:local/root "../org.ietf.hpke"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
