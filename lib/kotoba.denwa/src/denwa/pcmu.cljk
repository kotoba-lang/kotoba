(ns denwa.pcmu
  "G.711 μ-law (ITU-T G.711), the 64 kbit/s baseline every bearer faster than
  LoRa can carry and every gateway to the telephone network speaks.

  Samples are signed 16-bit integers; each becomes one byte. The encoder is
  the classic segment/mantissa form with the 0x84 bias, the decoder its exact
  inverse, so `decode (encode x)` is within one quantisation step of `x`.")

(def ^:private bias 0x84)
(def ^:private clip 32635)

(defn- segment [v]
  ;; position of the highest set bit above bit 7, 0..7
  (loop [seg 0 m (bit-shift-right v 8)]
    (if (or (zero? m) (= seg 7)) seg (recur (inc seg) (bit-shift-right m 1)))))

(defn encode-sample [s]
  (let [sign (if (neg? s) 0x80 0)
        mag (min clip (if (neg? s) (- s) s))
        v (+ mag bias)
        seg (segment v)
        mant (bit-and (bit-shift-right v (+ seg 3)) 0x0f)]
    (bit-and (bit-xor (bit-or sign (bit-shift-left seg 4) mant) 0xff) 0xff)))

(defn decode-sample [u]
  (let [u (bit-xor u 0xff)
        sign (bit-and u 0x80)
        seg (bit-and (bit-shift-right u 4) 0x07)
        mant (bit-and u 0x0f)
        mag (- (bit-shift-left (+ (bit-shift-left mant 3) bias) seg) bias)]
    (if (pos? sign) (- mag) mag)))

(defn encode [samples] (mapv encode-sample samples))
(defn decode [bs] (mapv decode-sample bs))
