(ns denwa.bearer
  "Choosing what to send over which radio.

  A call can run over any bearer tsunagi has a path on. They differ by orders
  of magnitude, so the codec, the frame length and the call *mode* follow the
  bearer rather than being fixed:

  | bearer    | usable kbit/s | duplex      | voice                         |
  |-----------|---------------|-------------|-------------------------------|
  | lora      | 5.5 at SF7/125 kHz, duty-limited | half | push-to-talk, LPC 1200, 200 ms frames |
  | mesh/wifi | 1 000+        | full        | PCMU, 20–40 ms frames         |
  | lte       | 1 000+        | full        | PCMU                          |
  | internet  | varies        | full        | PCMU                          |

  Japanese 920 MHz rules (ARIB STD-T108) bound transmit time per hour, so a
  LoRa call is push-to-talk with a per-hour airtime budget, not a phone call.
  `airtime-ms` and `budget-left` let the UI show that budget honestly."
  (:require [denwa.signal :as sig]))

(def bearers
  {:lora {:kbps 5.4 :duplex :half :latency-ms 800}      ; SF7 / 125 kHz
   :mesh {:kbps 2000 :duplex :full :latency-ms 60}
   :wifi {:kbps 10000 :duplex :full :latency-ms 30}
   :lte {:kbps 5000 :duplex :full :latency-ms 60}
   :internet {:kbps 1000 :duplex :full :latency-ms 120}})

(def ^:private overhead-bytes
  "tsunagi header (19) + link counter (6) + AEAD tag (16) + frame header (7)."
  48)

(defn required-kbps [codec frame-ms]
  (let [payload-bytes (/ (* (get-in sig/codecs [codec :bitrate]) frame-ms) 8000)]
    (/ (* 8 (+ payload-bytes overhead-bytes)) frame-ms)))

(defn plan
  "The best mode for the bearers available, best first. Each plan:
  `{:bearer … :codec … :frame-ms … :mode :duplex|:push-to-talk}`."
  [available supported-codecs]
  (let [supported (set supported-codecs)
        options (for [b [:wifi :mesh :lte :internet :lora]
                      :when (contains? (set available) b)
                      [codec frame-ms] [[:pcmu 20] [:pcmu 40] [:lpc-2400 40] [:lpc-1200 200]]
                      :when (contains? supported codec)
                      :when (<= (required-kbps codec frame-ms) (* 0.7 (get-in bearers [b :kbps])))]
                  {:bearer b :codec codec :frame-ms frame-ms
                   :mode (if (= :half (get-in bearers [b :duplex])) :push-to-talk :duplex)})]
    (vec options)))

(defn choose [available supported-codecs]
  (first (plan available supported-codecs)))

;; ---------------------------------------------------------------------------
;; LoRa airtime (Semtech AN1200.13 time-on-air)

(defn airtime-ms
  "Time on air of one LoRa frame of `payload-bytes` (explicit header, CRC on,
  coding rate 4/5, 8-symbol preamble)."
  [payload-bytes {:keys [sf bw-khz] :or {sf 9 bw-khz 125}}]
  (let [t-sym (/ (Math/pow 2 sf) bw-khz)                      ; ms
        de (if (and (>= sf 11) (<= bw-khz 125)) 1 0)
        num (+ (- (* 8 payload-bytes) (* 4 sf)) 28 16)
        n-payload (+ 8 (max 0 (* 5 (Math/ceil (/ num (* 4 (- sf (* 2 de)))))))) ]
    (+ (* (+ 8 4.25) t-sym) (* n-payload t-sym))))

(defn budget-left
  "Seconds of transmit time left in this hour under a per-hour budget
  (default 360 s), given transmissions already made `[{:at-ms … :airtime-ms …}]`."
  ([sent now-ms] (budget-left sent now-ms 360))
  ([sent now-ms budget-s]
   (let [used (transduce (comp (filter #(> (:at-ms %) (- now-ms 3600000))) (map :airtime-ms)) + 0 sent)]
     (max 0 (- budget-s (/ used 1000))))))
