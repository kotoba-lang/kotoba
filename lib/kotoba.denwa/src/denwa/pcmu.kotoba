;; Port of denwa.pcmu (pcmu.cljk), Kotoba-native. G.711 mu-law, integer only.
;;
;; Samples are signed 16-bit integers (i64 here); each becomes one byte.
;; encode/decode take and return :document vectors of i64 values.
;;
;; Named divergences from pcmu.cljk:
;;   - bit-shift-left / bit-shift-right are not in the Kotoba builtins; the
;;     shifts are written as multiplication and quot by powers of two. The
;;     inputs to every shift are non-negative, so quot equals the arithmetic shift.
;;   - encode/decode read a non-integer element as 0 (the source would throw).
;;   - `def` constants are zero-arg fns (E2005), so bias and clip are fns.

(ns denwa.pcmu
  (:export [encode-sample decode-sample encode decode]))

(defn- bias [] :i64 132)
(defn- clip [] :i64 32635)

(defn- pow2 [n :i64] :i64
  (loop [i 0 p 1]
    (if (= i n) p (recur (+ i 1) (* p 2)))))

;; position of the highest set bit above bit 7, 0..7
(defn- segment [v :i64] :i64
  (loop [seg 0 m (quot v 256)]
    (if (= m 0)
      seg
      (if (= seg 7) seg (recur (+ seg 1) (quot m 2))))))

(defn encode-sample [s :i64] :i64
  (let [sign (if (< s 0) 128 0)
        abs-s (if (< s 0) (- 0 s) s)
        mag (if (> abs-s (clip)) (clip) abs-s)
        v (+ mag (bias))
        seg (segment v)
        mant (bit-and (quot v (pow2 (+ seg 3))) 15)]
    (bit-and (bit-xor (bit-or (bit-or sign (* seg 16)) mant) 255) 255)))

(defn decode-sample [u :i64] :i64
  (let [x (bit-xor u 255)
        sign (bit-and x 128)
        seg (bit-and (quot x 16) 7)
        mant (bit-and x 15)
        mag (- (* (+ (* mant 8) (bias)) (pow2 seg)) (bias))]
    (if (> sign 0) (- 0 mag) mag)))

(defn- nil-doc? [d :document] :bool
  (string=? (document-edn-print d) "nil"))

(defn- elem-i64 [v :document i :i64] :i64
  (option-or (document-i64-value (option-or (document-vector-at v i) (document-null))) 0))

(defn encode [samples :document] :document
  (let [n (if (nil-doc? samples) 0 (document-count samples))]
    (loop [i 0 out (document-vector)]
      (if (= i n)
        out
        (recur (+ i 1) (document-vector-conj out (document-i64 (encode-sample (elem-i64 samples i)))))))))

(defn decode [bs :document] :document
  (let [n (if (nil-doc? bs) 0 (document-count bs))]
    (loop [i 0 out (document-vector)]
      (if (= i n)
        out
        (recur (+ i 1) (document-vector-conj out (document-i64 (decode-sample (elem-i64 bs i)))))))))
