(ns denwa.signal
  "Call signalling messages, carried inside a tsunagi link (context :call).

      message = type (u8) ++ call id (8) ++ body

      1 ANSWER   the callee picked up       body = codec count (u8) ++ codec ids … ++ frame ms (u8)
      2 ACCEPT   the caller chose a codec   body = codec id (u8) ++ frame ms (u8)
      3 BYE      either side hangs up       body = reason (u8)
      4 HOLD     media paused / resumed     body = 0 resume · 1 hold
      5 PING     liveness                   body = —

  The link already authenticates and encrypts; these messages only need to
  be small. Nothing here is negotiated in text — a radio link pays for every
  byte."
  (:require [tsunagi.wire :as w]))

(def types {:answer 1 :accept 2 :bye 3 :hold 4 :ping 5})
(def type-of (into {} (map (fn [[k v]] [v k])) types))

(def codecs
  "Codec ids. Bitrates are payload bits per second."
  {:pcmu {:id 0 :bitrate 64000 :sample-rate 8000}
   :lpc-2400 {:id 10 :bitrate 2400 :sample-rate 8000}
   :lpc-1200 {:id 11 :bitrate 1200 :sample-rate 8000}})

(def codec-of (into {} (map (fn [[k v]] [(:id v) k])) codecs))

(def bye-reasons {:normal 0 :busy 1 :declined 2 :failure 3 :timeout 4})
(def bye-reason-of (into {} (map (fn [[k v]] [v k])) bye-reasons))

(defn encode [{:keys [type call-id] :as m}]
  (w/cat-bytes [(get types type)] call-id
               (case type
                 :answer (w/cat-bytes [(count (:codecs m))] (map #(get-in codecs [% :id]) (:codecs m))
                                      [(:frame-ms m 40)])
                 :accept [(get-in codecs [(:codec m) :id]) (:frame-ms m 40)]
                 :bye [(get bye-reasons (:reason m :normal))]
                 :hold [(if (:hold? m) 1 0)]
                 :ping [])))

(defn decode [bs]
  (let [c (w/cursor bs)]
    (when-let [[t c] (w/take-u8 c)]
      (when-let [[call-id c] (w/take-bytes c 8)]
        (let [type (type-of t)
              base {:type type :call-id call-id}]
          (case type
            :answer (when-let [[n c] (w/take-u8 c)]
                      (when-let [[ids c] (w/take-bytes c n)]
                        (when-let [[ms c] (w/take-u8 c)]
                          (when (w/done? c)
                            (assoc base :codecs (vec (keep codec-of ids)) :frame-ms ms)))))
            :accept (when-let [[[id ms] c] (w/take-bytes c 2)]
                      (when (and (w/done? c) (codec-of id))
                        (assoc base :codec (codec-of id) :frame-ms ms)))
            :bye (when-let [[r c] (w/take-u8 c)]
                   (when (w/done? c) (assoc base :reason (bye-reason-of r :failure))))
            :hold (when-let [[h c] (w/take-u8 c)]
                    (when (w/done? c) (assoc base :hold? (= 1 h))))
            :ping (when (w/done? c) base)
            nil))))))
