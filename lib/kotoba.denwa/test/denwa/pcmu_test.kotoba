(ns denwa.pcmu-test (:export [main]) (:require [denwa.pcmu :as p]))

(defn- case-known [] :i64
  ;; G.711 mu-law reference points; values cross-checked against the JVM oracle of pcmu.cljk
  (+ (if (= (p/encode-sample 0) 255) 0 1)
     (if (= (p/encode-sample 1) 255) 0 1)
     (if (= (p/encode-sample 132) 239) 0 1)
     (if (= (p/encode-sample -1) 127) 0 1)
     (if (= (p/encode-sample 32767) 128) 0 1)
     (if (= (p/encode-sample -32768) 0) 0 1)
     (if (= (p/encode-sample 1000) 206) 0 1)
     (if (= (p/encode-sample -1000) 78) 0 1)))

(defn- case-decode [] :i64
  (+ (if (= (p/decode-sample 255) 0) 0 1)
     (if (= (p/decode-sample 128) 32124) 0 1)
     (if (= (p/decode-sample 0) -32124) 0 1)
     (if (= (p/decode-sample 206) 988) 0 1)
     (if (= (p/decode-sample 78) -988) 0 1)))

(defn- case-vectors [] :i64
  (let [enc (p/encode (document-vector (document-i64 0) (document-i64 1000) (document-i64 -1000)))
        dec (p/decode enc)]
    (+ (if (document-equal? enc (document-vector (document-i64 255) (document-i64 206) (document-i64 78))) 0 1)
       (if (document-equal? dec (document-vector (document-i64 0) (document-i64 988) (document-i64 -988))) 0 1)
       (if (document-equal? (p/encode (document-null)) (document-vector)) 0 1))))

(defn main [] :i64
  (+ (case-known) (case-decode) (case-vectors)))
