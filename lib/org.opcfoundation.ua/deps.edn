;; No dependencies. OPC UA's binary encoding is integers, strings, and a
;; handful of structured records — none of it needs a socket to encode or
;; decode, and a dependency here would defeat the point of getting this
;; protocol layer off the JVM.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
