;; orgbrain BPMN — 危機対応プロセス: インシデントエスカレーション ライフサイクル
;; (BPMN 2.0 意味論の EDN ダイアグラム)。検知 → 指揮掌握 (重大度ゲート) → 封じ込め →
;; 復旧 → 報告・事後審査を分離する。:actor-role / :authority-required は
;; docs/orgbrain/org-ontology.schema.edn と照合される.
;; gateways: xor | and ; events: start | end | timer
{:orgbrain.bpmn/process-id :incident-escalation
 :orgbrain.bpmn/name "インシデントエスカレーションライフサイクル"
 :orgbrain.bpmn/elements
 [{:id :start :type :event :event :start}
  {:id :detect-triage :type :task :name "インシデント検知・トリアージ" :actor-role :it-admin :sla-days 1}
  {:id :severity-gate :type :gateway :gateway :xor :name "重大インシデント?"}
  {:id :activate-command :type :task :name "指揮本部設立・指揮官任命" :actor-role :coo :authority-required :compliance :sla-days 1}
  {:id :contain :type :task :name "封じ込め措置" :actor-role :it-admin :authority-required :it-admin :sla-days 1}
  {:id :ceo-notify :type :task :name "CEO・board 報告" :actor-role :coo :authority-required :compliance :sla-days 1}
  {:id :resolve-contain :type :task :name "封じ込め措置" :actor-role :it-admin :authority-required :it-admin :sla-days 1}
  {:id :recover :type :task :name "復旧・恒久対策" :actor-role :cto :authority-required :it-admin :sla-days 7}
  {:id :post-incident-review :type :task :name "事後レビュー" :actor-role :coo :authority-required :compliance :sla-days 7}
  {:id :regulatory-report :type :task :name "規制当局報告" :actor-role :coo :authority-required :compliance :sla-days 7}
  {:id :end :type :event :event :end}]
 :orgbrain.bpmn/flows
 [[:start :detect-triage]
  [:detect-triage :severity-gate]
  [:severity-gate :activate-command]  ;; yes (重大 — 指揮本部を設立)
  [:severity-gate :resolve-contain]   ;; no (通常 — IT 封じ込めへ直行)
  [:activate-command :contain]
  [:contain :ceo-notify]
  [:ceo-notify :recover]
  [:resolve-contain :recover]
  [:recover :post-incident-review]
  [:post-incident-review :regulatory-report]
  [:regulatory-report :end]]}
