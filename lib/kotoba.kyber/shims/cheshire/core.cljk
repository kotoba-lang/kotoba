;; cheshire.core shim for the kbb engine (SCI-on-Node).
;; The lg-kyber graphs were written against the JVM json lib; on the kbb engine
;; we delegate to js/JSON. Only the two call shapes used by this repo:
;;   (json/parse-string s true)  -> keywordized clj
;;   (json/generate-string m)    -> JSON text
(ns cheshire.core)

(defn- kw
  "Deep keywordize (cheshire :keywordize? true semantics)."
  [x]
  (cond
    (map? x) (into {} (map (fn [[k v]] [(if (string? k) (keyword k) k) (kw v)]) x))
    (vector? x) (mapv kw x)
    :else x))

(defn parse-string
  ([s] (kw (js->clj (js/JSON.parse s))))
  ([s keywordize?]
   (let [v (js->clj (js/JSON.parse s))]
     (if keywordize? (kw v) v))))

(defn generate-string [m]
  (str (js/JSON.stringify (clj->js m))))
