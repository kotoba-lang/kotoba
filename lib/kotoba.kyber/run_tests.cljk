#!/usr/bin/env kbb
;; lg-kyber — kbb-native test runner (Clojure-shaped .cljk; NOT shell, per repo
;; rule "New actors ship run_tests.cljk, not run_tests.sh"). Run from the app dir:
;;
;;   cd <kyber app dir> && kbb --backend sci --classpath . run_tests.cljk
;;
;; kbb-engine notes (ADR-2609112000 cut the repo to .cljk):
;; - the engine resolves .cljk namespaces from --classpath, so this runner adds
;;   its own dir (and $KBB_CLASSPATH entries) before requiring the suites;
;; - babashka.classpath / babashka.http-client are NOT exposed by the engine,
;;   so classpath and env access go through nbb.classpath / js/process.
(require '[kotoba.test :as t])

(def ^:private root-dir
  (let [f (str *file*)
        i (clojure.string/last-index-of f "/")]
    (if (and i (pos? i)) (subs f 0 i) ".")))

(def ^:private cp-entries
  (let [env-cp (or (try (aget js/process "env" "KBB_CLASSPATH") (catch :default _ nil)) ".")]
    (clojure.string/split env-cp #":")))

(doseq [e (distinct (conj cp-entries root-dir))]
  (nbb.classpath/add-classpath e))

(defn- getenv [name default]
  (or (try (aget js/process "env" name) (catch :default _ nil)) default))

(def ^:private http
  {:get (fn [url opts] (js/fetch url))
   :post (fn [url opts] (js/fetch url (clj->js {:method "POST" :body (:body opts)})))})

(def suites '[lg.lg-kyber.tests.test-graphs
              lg.lg-kyber.tests.test-org-risk])

(apply require suites)

(def live-llm
  ((resolve 'lg.lg-kyber.graphs.llm/http-llm)
   (:get http) (:post http)
   {:murakumo-base-url (getenv "MURAKUMO_BASE_URL" "https://murakumo.etzhayyim.com")
    :openrouter-key (getenv "OPENROUTER_API_KEY" nil)}))

(defn live-notify [args]
  (let [webhook (getenv "TEAMS_KYBER_WEBHOOK_URL" nil)
        notify-with (resolve 'lg.lg-kyber.graphs.business-operating-react/notify-with)]
    (notify-with (:post http) webhook args)))

(defn- exit! [code] (js/process.exit code))

(let [{:keys [fail error]} (apply t/run-tests suites)]
  (if (zero? (+ fail error))
    (println "── lg-kyber: ALL suites green ──")
    (do (println "── lg-kyber: FAILURES above ──")
        (exit! 1))))
