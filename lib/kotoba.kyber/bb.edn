{;; Scoped babashka project for the lg-kyber LangGraph app, ported python → clj
 ;; per ADR-2606280030 (langgraph-python → langgraph-clj). This bb.edn is the
 ;; APP-LOCAL runner; it does NOT touch the repo-root bb.edn.
 ;;
 ;; Classpath root = this app dir, so a co-located .cljc at
 ;;   lg/lg_kyber/graphs/<x>.cljc  ⇒  ns  lg.lg-kyber.graphs.<x>
 ;; (the porter-tool convention already used by business_operating_react.cljc).
 ;;
 ;;   kbb run_tests.cljk        # green = the ported graphs load + invoke under bb
 :paths ["."]
 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error {:git/sha "838dec56c9a5b74f9eec825a2fb28bda157f8cd3"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}
        com-junkawasaki/langchain-clj
        {:git/url "https://github.com/com-junkawasaki/langchain-clj"
         :git/sha "2b03859c3ee722b64f3eddd0b615a54019b17c81"}
        com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/com-junkawasaki/langgraph-clj"
         :git/sha "c7daa07d4e50f55d7e2a02e4b89dbeb2b200961d"}}
 :tasks
 {test {:doc "Run the lg-kyber clj graph test-suite (clojure.test, bb)."
        :task (load-file "run_tests.cljk")}}}
