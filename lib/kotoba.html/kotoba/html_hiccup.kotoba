(ns html-hiccup (:export [render]) (:require [html-core :as html]))
;; Experimental bounded Hiccup document-tree renderer. Unsupported document
;; shapes return none. Map attributes use document canonical order, not the
;; insertion order of html.core. Full public Hiccup parity remains unqualified.
(defn- val [o [:option :document]] :document
 (option-value-of [:option :document] o (document-null)))
(defn- item [n :document i :i64] :document
 (if (= (document-kind n) :list) (val (document-list-at n i)) (val (document-vector-at n i))))
(defn- text [n :document] :string
 (option-value-of [:option :string] (document-string-value n) ""))
(defn- kw [n :document] :keyword
 (option-value-of [:option :keyword] (document-keyword-value n) :missing))
(defn- some [s :string] [:option :string] (option-some-of [:option :string] s))
(defn- none [] [:option :string] (option-none-of [:option :string]))
(defn- strval [n :document] :string
 (let [k (document-kind n)]
  (cond (= k :string) (text n) (= k :null) "" :else (document-edn-print n))))
(defn- truthy? [n :document] :bool
 (let [k (document-kind n)]
  (cond (= k :null) false (= k :bool) (option-value-of [:option :bool] (document-bool-value n) false) :else true)))
(defn- void? [s :string] :bool
 (or (string=? s "area") (string=? s "base") (string=? s "br") (string=? s "col") (string=? s "embed") (string=? s "hr") (string=? s "img") (string=? s "input") (string=? s "link") (string=? s "meta") (string=? s "param") (string=? s "source") (string=? s "track") (string=? s "wbr")))
(defn- children [n :document from :i64 depth :i64] [:option :string]
 (loop [i from out ""]
  (if (>= i (document-count n)) (some out)
   (let [part (render (item n i) depth)]
    (if (option-some?-of [:option :string] part)
     (recur (+ i 1) (string-concat out (option-value-of [:option :string] part ""))) (none))))))
(defn- class-value [node :document] [:option :string]
 (let [k (document-kind node)]
  (if (or (= k :vector) (= k :list))
   (loop [i 0 out "" any false]
    (if (>= i (document-count node)) (some out)
     (let [item (item node i)]
      (if (not (truthy? item)) (recur (+ i 1) out any)
       (let [part (class-value item)]
        (if (option-some?-of [:option :string] part)
         (recur (+ i 1) (string-concat out (string-concat (if any " " "") (option-value-of [:option :string] part ""))) true)
         (none)))))))
   (if (or (= k :string) (= k :keyword) (= k :i64) (= k :bool) (= k :null))
    (some (if (= k :keyword) (keyword-name (kw node)) (strval node))) (none)))))
(defn- style-value [node :document] [:option :string]
 (loop [i 0 out ""]
  (if (>= i (document-count node)) (some out)
   (let [pair (val (document-map-entry-at node i)) k (item pair 0) v (item pair 1)]
    (if (not (= (document-kind k) :keyword)) (none)
     (if (not (truthy? v)) (recur (+ i 1) out)
      (if (or (= (document-kind v) :string) (= (document-kind v) :keyword) (= (document-kind v) :i64) (= (document-kind v) :bool))
       (recur (+ i 1) (string-concat out (string-concat (keyword-name (kw k)) (string-concat ":" (string-concat (strval v) ";"))))) (none))))))))
(defn- attr-value [name :string node :document] [:option :string]
 (cond (string=? name "class") (class-value node)
       (and (string=? name "style") (= (document-kind node) :map)) (style-value node)
       (or (= (document-kind node) :string) (= (document-kind node) :keyword) (= (document-kind node) :i64)) (some (strval node))
       :else (none)))
(defn- attrs [a :document] [:option :string]
 (loop [i 0 out ""]
  (if (>= i (document-count a)) (some out)
   (let [pair (val (document-map-entry-at a i)) k (item pair 0) v (item pair 1)
         kind (document-kind k)]
    (if (not (= kind :keyword)) (none)
     (let [name (keyword-name (kw k)) vk (document-kind v)]
      (cond (not (truthy? v)) (recur (+ i 1) out)
            (and (= vk :bool) (not (string=? name "class"))) (recur (+ i 1) (string-concat out (string-concat " " name)))
            :else (let [value (attr-value name v)]
             (if (option-some?-of [:option :string] value)
              (recur (+ i 1) (string-concat out (string-concat " " (string-concat name (string-concat "=\"" (string-concat (html/esc (option-value-of [:option :string] value "")) "\""))))))
              (none))))))))))
(defn- indent [n :i64] :string
 (loop [i 0 out ""] (if (>= i n) out (recur (+ i 1) (string-concat out "  ")))))
(defn- block? [n :document start :i64] :bool
 (if (>= start (document-count n)) false
  (loop [i start]
   (if (>= i (document-count n)) true
    (let [node (item n i)]
     (if (not (= (document-kind node) :vector)) false
      (let [first (item node 0) k (kw first)]
       (if (and (= (document-kind first) :keyword)
                (not (= k :hiccup/raw)) (not (void? (html/tag-name (keyword-name k)))))
        (recur (+ i 1)) false))))))))
(defn- block-children [n :document start :i64 depth :i64] [:option :string]
 (loop [i start out ""]
  (if (>= i (document-count n)) (some (string-concat out (string-concat "\n" (indent depth))))
   (let [part (render (item n i) (+ depth 1))]
    (if (option-some?-of [:option :string] part)
     (recur (+ i 1) (string-concat out (string-concat "\n" (string-concat (indent (+ depth 1)) (option-value-of [:option :string] part "")))))
     (none))))))
(defn- raw-children [n :document start :i64 tag :string] [:option :string]
 (loop [i start out ""]
  (if (>= i (document-count n))
   (if (string-contains? (string-fold-case out) (string-concat "</" tag)) (none) (some out))
   (let [node (item n i) raw (and (= (document-kind node) :vector) (= (kw (item node 0)) :hiccup/raw))
         v (if raw (item node 1) node) kind (document-kind v)]
    (if (or (= kind :string) (= kind :i64) (= kind :bool) (= kind :null) (= kind :keyword))
     (recur (+ i 1) (string-concat out (strval v))) (none))))))

(defn- render-vector [n :document depth :i64] [:option :string]
 (let [first (item n 0) k (document-kind first) tag (kw first)]
  (cond (= tag :hiccup/raw) (some (strval (item n 1)))
        (= tag :<>) (children n 1 depth)
        (= k :vector) (children n 0 depth)
        (not (= k :keyword)) (none)
        :else
        (let [raw (keyword-name tag) name (html/tag-name raw) second (item n 1)
              has-attrs (= (document-kind second) :map)
              attr (if has-attrs second (document-map))
              sugar-class (html/tag-classes raw) sugar-id (html/tag-id raw)
              ;; Merge-with class-str applies to every conflicting key, including id.
              class-prev (val (document-get attr :class)) id-prev (val (document-get attr :id))
              class-v (class-value class-prev) id-v (class-value id-prev)
              attr1 (if (string=? sugar-class "") attr
                (document-assoc attr :class (document-string (if (document-contains attr :class)
                  (string-concat sugar-class (string-concat " " (option-value-of [:option :string] class-v ""))) sugar-class))))
              attr2 (if (string=? sugar-id "") attr1
                (document-assoc attr1 :id (document-string (if (document-contains attr1 :id)
                  (string-concat sugar-id (string-concat " " (option-value-of [:option :string] id-v ""))) sugar-id))))
              rendered-attrs (attrs attr2)]
          (if (and (option-some?-of [:option :string] rendered-attrs)
                   (or (string=? sugar-class "") (not (document-contains attr :class)) (option-some?-of [:option :string] class-v))
                   (or (string=? sugar-id "") (not (document-contains attr :id)) (option-some?-of [:option :string] id-v)))
           (let [open (string-concat "<" (string-concat name (string-concat (option-value-of [:option :string] rendered-attrs "") ">")))]
            (if (void? name) (some open)
             (let [start (if has-attrs 2 1)
                   body (cond (or (string=? name "script") (string=? name "style")) (raw-children n start name)
                              (and (block? n start) (not (or (string=? name "pre") (string=? name "textarea")))) (block-children n start depth)
                              :else (children n start (+ depth 1)))]
               (if (option-some?-of [:option :string] body)
                (some (string-concat open (string-concat (option-value-of [:option :string] body "") (string-concat "</" (string-concat name ">"))))) (none)))))
           (none))))))
(defn render [node :document depth :i64] [:option :string]
 (let [k (document-kind node)]
  (cond (= k :null) (some "")
        (= k :string) (some (html/esc (text node)))
        (or (= k :i64) (= k :bool) (= k :keyword) (= k :symbol)) (some (html/esc (document-edn-print node)))
        (= k :vector) (render-vector node depth)
        (= k :list) (children node 0 depth)
        :else (none))))
