(ns ui-components (:export [chip button row card panel tab tab-bar3 text-field launcher-tile dock-link dock-tile dock-divider menubar welcome app-grid dock-bar desktop-footer desktop-view compositor-view slot session-head session-chrome session-document app-window heading empty-state pre-out result-slot request-button note-line pin-row mode-radio status-body action-button out-pre code-span rich-line region app-frame view-section lede-line ext-card kotoba-button qr-image link-out details-box input-field approval-sheet tk-button tk-tab tk-input tk-check tk-stat tk-box tk-heading tk-cols tk-slot tk-panel tk-badge tk-endpoint tk-status-text tk-side tk-seg tk-submit tk-link tk-note tk-chart-host tk-span-choice tk-spans tk-app tk-tabs data-slot]))
;; Shared dapp UI components as document trees (JUN-856). Each returns a
;; Hiccup-shaped :document for html-hiccup/render. Behaviour is declarative:
;; data-action names an action, data-bind names a state key; the host decides
;; what they do, so the same tree serves a browser and a native host.
(defn- kw [s :keyword] :document (document-keyword s))
(defn- str [s :string] :document (document-string s))
(defn chip [label :string state :string] :document
 (document-vector (kw :span) (document-map :class (str (string-concat "chip chip-" state))) (str label)))
(defn button [label :string action :string] :document
 (document-vector (kw :button) (document-map :class (str "btn") :type (str "button") :data-action (str action)) (str label)))
(defn row [title :string detail :string] :document
 (document-vector (kw :li) (document-map :class (str "row"))
  (document-vector (kw :span) (document-map :class (str "row-title")) (str title))
  (document-vector (kw :span) (document-map :class (str "row-detail")) (str detail))))
(defn card [title :string body :document] :document
 (document-vector (kw :section) (document-map :class (str "card"))
  (document-vector (kw :h2) (str title)) body))
(defn panel [id :string body :document] :document
 (document-vector (kw :div) (document-map :class (str "panel") :id (str id)) body))
(defn tab [label :string target :string selected :bool] :document
 (document-vector (kw :button) (document-map :class (str (if selected "tab tab-selected" "tab")) :type (str "button") :data-action (str (string-concat "select:" target)) :aria-selected (str (if selected "true" "false"))) (str label)))
(defn tab-bar3 [a :document b :document c :document] :document
 (document-vector (kw :nav) (document-map :class (str "tabs") :role (str "tablist")) a b c))
(defn text-field [name :string label :string bind :string] :document
 (document-vector (kw :label) (document-map :class (str "field"))
  (document-vector (kw :span) (document-map :class (str "field-label")) (str label))
  (document-vector (kw :input) (document-map :type (str "text") :name (str name) :data-bind (str bind)))))
(defn- opt [v :string] :document
 (if (= v "") (document-bool false) (str v)))
;; launcher-tile: cat "" leaves data-cat out (tile and icon), for the tiles without a category.
(defn launcher-tile [id :string title :string icon :string cat :string] :document
 (document-vector (kw :a) (document-map :class (str "desktop-app") :href (str (string-concat "#" id)) :data-app (str id) :data-cat (opt cat) :aria-label (str title))
  (document-vector (kw :span) (document-map :class (str "desktop-app-icon") :aria-hidden (str "true") :data-cat (opt cat)) (str icon))
  (document-vector (kw :span) (document-map :class (str "desktop-app-label")) (str title))))
;; dock-link: a dock entry. app, cat and default of "" leave data-app, data-cat and data-dock-default out; hide adds the hidden attribute.
(defn dock-link [href :string app :string title :string icon :string cat :string default :string hide :bool] :document
 (document-vector (kw :a) (document-map :class (str "dock-app") :href (str href) :data-app (opt app) :data-cat (opt cat) :data-dock-default (opt default) :aria-label (str title) :hidden (document-bool hide))
  (document-vector (kw :span) (document-map :class (str "dock-app-icon") :aria-hidden (str "true") :data-cat (opt cat)) (str icon))
  (document-vector (kw :span) (document-map :class (str "dock-app-label")) (str title))))
(defn dock-tile [id :string title :string icon :string cat :string default :string] :document
 (dock-link (string-concat "#" id) id title icon cat default true))
(defn dock-divider [] :document
 (document-vector (kw :span) (document-map :class (str "dock-divider") :aria-hidden (str "true")) (str "")))
(defn- menu-link [href :string cls :string text :string] :document
 (document-vector (kw :a) (document-map :href (str href) :class (str cls)) (str text)))
(defn menubar [] :document
 (document-vector (kw :div) (document-map :class (str "desktop-menubar"))
  (menu-link "#desktop" "desktop-brand" "AIUEOS")
  (document-vector (kw :span) (document-map :class (str "desktop-menubar-app")) (str "Kotoba Browser"))
  (document-vector (kw :span) (document-map :class (str "desktop-menubar-spacer")) (str ""))
  (menu-link "#session" "desktop-menu-link" "Session")
  (menu-link "#compositor" "desktop-menu-link" "Window Lab")
  (menu-link "#manage" "desktop-menu-link" "Settings")))
(defn welcome [title :string lede :string] :document
 (document-vector (kw :div) (document-map :class (str "desktop-welcome"))
  (document-vector (kw :h1) (document-map :class (str "dads-heading") :data-size (str "32")) (str title))
  (document-vector (kw :p) (document-map :class (str "session-lede")) (str lede))))
;; app-grid / dock-bar take already-rendered tile markup.
(defn app-grid [tiles :string] :document
 (document-vector (kw :nav) (document-map :class (str "desktop-app-grid") :aria-label (str "Applications")) (document-vector (kw :hiccup/raw) (str tiles))))
(defn dock-bar [tiles :string] :document
 (document-vector (kw :div) (document-map :class (str "desktop-dock-wrap"))
  (document-vector (kw :nav) (document-map :class (str "desktop-dock") :aria-label (str "Dock")) (document-vector (kw :hiccup/raw) (str tiles)))))
(defn desktop-footer [text :string] :document
 (document-vector (kw :footer) (document-map :class (str "desktop-footer")) (str text)))
;; desktop-view: the desktop section (menubar, welcome, launcher grid, dock, footer).
(defn desktop-view [grid :string dock :string] :document
 (document-vector (kw :section) (document-map :id (str "desktop") :class (str "dds-ext-section session-view") :data-view (str "desktop"))
  (document-vector (kw :div) (document-map :class (str "desktop-surface"))
   (menubar) (welcome "AIUEOS" "Kotoba Browser からアプリを開く") (app-grid grid) (dock-bar dock) (desktop-footer "Kotoba · Amu · AIUEOS"))))
(defn- chip-label [text :string] :document
 (document-vector (kw :span) (document-map :class (str "dads-chip-label") :data-style (str "filled-1") :data-color (str "blue")) (str text)))
(defn- sm-heading [id :string text :string] :document
 (document-vector (kw :h2) (document-map :class (str "dads-heading") :data-size (str "16") :id (str id)) (str text)))
(defn- lede-slot [id :string live :string] :document
 (document-vector (kw :p) (document-map :id (str id) :class (str "session-lede") :aria-live (if (= live "") (document-bool false) (str live))) (str "")))
(defn- ime-bar [] :document
 (document-vector (kw :div) (document-map :id (str "ime-bar") :class (str "ime-bar dds-ext-row") :data-ime (str "on") :aria-label (str "input method"))
  (chip-label "かな") (sm-heading "ime-preedit-label" "変換中") (lede-slot "ime-preedit" "polite") (lede-slot "ime-buf" "")
  (document-vector (kw :div) (document-map :id (str "ime-candidates") :aria-label (str "kanji candidates")) (str ""))
  (document-vector (kw :button) (document-map :class (str "dads-button") :data-type (str "outline") :data-size (str "sm") :id (str "ime-toggle") :type (str "button")) (str "IME 切"))))
(defn- wm-titlebar [n :string title :string] :document
 (document-vector (kw :header) (document-map :class (str "wm-titlebar dds-ext-row") :data-raise (str n))
  (sm-heading (string-concat "wm-title-" n) title) (chip-label "フォーカス")
  (document-vector (kw :button) (document-map :data-raise (str n) :class (str "dads-button") :data-type (str "outline") :data-size (str "sm") :id (str (string-concat "wm-raise-" n)) :type (str "button")) (str "前面へ"))))
(defn- wm-window [n :string guest :string body :document] :document
 (document-vector (kw :article) (document-map :class (str "wm-window") :id (str (string-concat "wm-window-" n)) :data-window-id (str n) :data-guest (str guest))
  (wm-titlebar n (if (= n "1") "session" "guest-surface"))
  (document-vector (kw :div) (document-map :class (str "wm-body")) body)))
(defn- session-guest [] :document
 (document-vector (kw :div) (document-map :class (str "wm-guest") :id (str "wm-guest-1") :tabindex (str "0") :data-src (str "/#session") :aria-label (str "session"))
  (document-vector (kw :p) (document-map :class (str "session-lede")) (str "guest ") (document-vector (kw :code) (str "/#session")))))
(defn- kami-canvas [] :document
 (document-vector (kw :canvas) (document-map :id (str "kami-viewport") :class (str "kami-viewport wm-guest") :width (str "640") :height (str "360") :data-engine (str "kami.webgpu.ir") :data-executor (str "kami.webgpu") :tabindex (str "0") :aria-label (str "kami WebGPU guest surface")) (str "")))
(defn- out-slot [id :string hide :bool] :document
 (document-vector (kw :pre) (document-map :id (str id) :class (str "session-out") :hidden (document-bool hide)) (str "")))
;; compositor-view: the Window Lab section (IME bar, two windows, outputs); lede is its introduction.
(defn compositor-view [lede :string] :document
 (document-vector (kw :section) (document-map :id (str "compositor") :class (str "dds-ext-section session-view") :data-view (str "compositor") :hidden (document-bool true))
  (document-vector (kw :h1) (document-map :class (str "dads-heading") :data-size (str "32")) (str "Window Lab"))
  (document-vector (kw :p) (document-map :class (str "session-lede")) (str lede))
  (ime-bar)
  (document-vector (kw :div) (document-map :id (str "wm-stage") :class (str "wm-stage") :tabindex (str "0") :aria-label (str "window-session-state"))
   (wm-window "1" "session" (session-guest)) (wm-window "2" "kami" (kami-canvas)))
  (out-slot "compositor-out" true) (out-slot "guest-desktop-out" false) (out-slot "kami-out" false) (out-slot "wm-input-out" false)))
(defn- meta-named [name :string content :string] :document
 (document-vector (kw :meta) (document-map :name (str name) :content (str content))))
(defn- nav-link [href :string text :string] :document
 (document-vector (kw :a) (document-map :href (str href)) (str text)))
;; Large exact-text constants (stylesheet, scripts, the page main) are not passed through the document tree:
;; the native runtime traps or exceeds its time budget when ~190KB of non-ASCII text goes through
;; the renderer's string checks. The tree carries a fixed ASCII slot token instead and the caller
;; substitutes the text into the rendered string (string-replace-all).
(defn slot [name :string] :string (string-concat "@@aiueos-slot:" (string-concat name "@@")))
(defn- slot-text [name :string] :document
 (document-vector (kw :hiccup/raw) (str (slot name))))
;; session-head: head/meta/title; the stylesheet text goes in slot "css".
(defn session-head [] :document
 (document-vector (kw :head)
  (document-vector (kw :meta) (document-map :charset (str "utf-8")))
  (meta-named "viewport" "width=device-width, initial-scale=1, viewport-fit=cover")
  (meta-named "color-scheme" "light")
  (meta-named "theme-color" "#ffffff")
  (document-vector (kw :title) (str "AIUEOS Desktop"))
  (meta-named "description" "AIUEOS app desktop rendered through Kotoba Browser.")
  (document-vector (kw :style) (slot-text "css"))
  (meta-named "aiueos-design" "jp-go-dds")
  (meta-named "aiueos-ui-engine" "kotoba-lang/browser")
  (meta-named "aiueos-hosted-adapter" "html-js-verification-only")))
(defn session-chrome [] :document
 (document-vector (kw :header) (document-map :class (str "session-chrome"))
  (document-vector (kw :a) (document-map :href (str "#desktop") :class (str "session-brand") :id (str "session-brand")) (str "AIUEOS"))
  (document-vector (kw :nav) (document-map :class (str "session-nav") :aria-label (str "System apps"))
   (nav-link "#desktop" "Desktop") (nav-link "#session" "Session") (nav-link "#compositor" "Window Lab") (nav-link "#setup" "Setup") (nav-link "#manage" "Settings"))))
(defn- script-slot [name :string] :document
 (document-vector (kw :script) (slot-text name)))
;; session-document: the <html> element of the hosted session page, with slots css, main, js1, js2 and js3.
;; The doctype is not an element, so the caller writes it as a plain string before this tree.
(defn session-document [] :document
 (document-vector (kw :html) (document-map :lang (str "ja"))
  (session-head)
  (document-vector (kw :body)
   (document-vector (kw :div) (document-map :class (str "session-shell"))
    (session-chrome)
    (document-vector (kw :main) (document-map :class (str "session-main")) (slot-text "main")))
   (document-vector (kw :script) (document-map :src (str "/kami-presenter.js")) (str ""))
   (script-slot "js1") (script-slot "js2") (script-slot "js3"))))
(defn app-frame [id :string title :string state :string lede :string inner :document] :document
 (document-vector (kw :section) (document-map :id (str id) :class (str "dds-ext-section session-view") :data-view (str id) :hidden (document-bool true))
  (document-vector (kw :article) (document-map :class (str "app-window"))
   (document-vector (kw :header) (document-map :class (str "app-window-head"))
    (document-vector (kw :a) (document-map :class (str "window-close") :href (str "#desktop") :aria-label (str "Close app")) (str "×"))
    (document-vector (kw :span) (document-map :class (str "app-window-title")) (str title))
    (document-vector (kw :span) (document-map :class (str "window-spacer")) (str ""))
    (document-vector (kw :span) (document-map :class (str "app-window-state")) (str state)))
   (document-vector (kw :div) (document-map :class (str "app-window-body"))
    (document-vector (kw :h1) (document-map :class (str "dads-heading") :data-size (str "32")) (str title))
    (document-vector (kw :p) (document-map :class (str "session-lede")) (str lede))
    inner
    (document-vector (kw :a) (document-map :class (str "app-return") :href (str "#desktop")) (str "デスクトップへ"))))))
(defn app-window [id :string title :string state :string lede :string body :string] :document
 (app-frame id title state lede (document-vector (kw :div) (document-map :class (str "dds-ext-card")) (document-vector (kw :hiccup/raw) (str body)))))
(defn heading [level :i64 text :string] :document
 (if (= level 1)
  (document-vector (kw :h1) (document-map :class (str "dads-heading") :data-size (str "32")) (str text))
  (document-vector (kw :h2) (document-map :class (str "dads-heading") :data-size (str "24")) (str text))))
(defn empty-state [text :string] :document
 (document-vector (kw :p) (document-map :class (str "app-empty-state")) (str text)))
;; pre-out: bind and slot are the optional data-bind / data-slot attribute values; "" leaves the attribute out.
(defn pre-out [bind :string slot :string text :string] :document
 (document-vector (kw :pre) (document-map :class (str "session-out") :data-bind (if (= bind "") (document-bool false) (str bind)) :data-slot (if (= slot "") (document-bool false) (str slot))) (str text)))
(defn result-slot [] :document
 (document-vector (kw :div) (document-map :data-slot (str "result")) (str "")))
(defn request-button [label :string op :string service :string] :document
 (document-vector (kw :button) (document-map :class (str "dads-button") :type (str "button") :data-type (str "solid-fill") :data-size (str "md") :data-action (str "request") :data-op (str op) :data-service (str service)) (str label)))
(defn note-line [text :string] :document
 (document-vector (kw :p) (str text)))
(defn pin-row [title :string id :string] :document
 (document-vector (kw :p) (str (string-concat title " "))
  (document-vector (kw :button) (document-map :class (str "dads-button") :type (str "button") :data-type (str "outline") :data-action (str "pin") :data-app (str id)) (str "Dock に置く"))))
(defn mode-radio [value :string label :string] :document
 (document-vector (kw :label)
  (document-vector (kw :input) (document-map :type (str "radio") :name (str "update-mode") :value (str value) :data-action (str "set-update-mode")))
  (str (string-concat " " label))))
;; status-body: a bound read-out followed by an empty-state note, as a fragment.
(defn status-body [bind :string note :string] :document
 (document-vector (kw :<>) (pre-out bind "" "") (empty-state note)))
(defn action-button [id :string label :string kind :string] :document
 (document-vector (kw :button) (document-map :class (str "dads-button") :data-type (str kind) :data-size (str "md") :id (str id) :type (str "button")) (str label)))
;; out-pre: a session-out <pre> with an id; live "" leaves aria-live out.
(defn out-pre [id :string live :string] :document
 (document-vector (kw :pre) (document-map :id (str id) :class (str "session-out") :aria-live (if (= live "") (document-bool false) (str live))) (str "")))
(defn code-span [text :string] :document
 (document-vector (kw :code) (str text)))
;; rich-line / region take already-rendered inner markup (escaped text plus other components' output).
(defn rich-line [html :string] :document
 (document-vector (kw :p) (document-vector (kw :hiccup/raw) (str html))))
(defn region [cls :string label :string body :string] :document
 (document-vector (kw :section) (document-map :class (str cls) :aria-label (str label)) (document-vector (kw :hiccup/raw) (str body))))
(defn view-section [id :string hide :bool body :string] :document
 (document-vector (kw :section) (document-map :id (str id) :class (str "dds-ext-section session-view") :data-view (str id) :hidden (document-bool hide)) (document-vector (kw :hiccup/raw) (str body))))
(defn lede-line [html :string] :document
 (document-vector (kw :p) (document-map :class (str "session-lede")) (document-vector (kw :hiccup/raw) (str html))))
(defn ext-card [body :string] :document
 (document-vector (kw :div) (document-map :class (str "dds-ext-card")) (document-vector (kw :hiccup/raw) (str body))))
(defn kotoba-button [id :string label :string action :string] :document
 (document-vector (kw :button) (document-map :data-kotoba-action (str action) :class (str "dads-button") :data-type (str "solid-fill") :data-size (str "md") :id (str id) :type (str "button")) (str label)))
(defn qr-image [id :string alt :string] :document
 (document-vector (kw :img) (document-map :id (str id) :class (str "device-auth-qr") :alt (str alt) :hidden (document-bool true))))
(defn link-out [id :string label :string] :document
 (document-vector (kw :a) (document-map :id (str id) :class (str "dads-link") :href (str "#") :target (str "_blank") :rel (str "noopener noreferrer") :hidden (document-bool true)) (str label)))
(defn details-box [summary :string body :string] :document
 (document-vector (kw :details) (document-map :class (str "session-details")) (document-vector (kw :summary) (str summary)) (document-vector (kw :hiccup/raw) (str body))))
(defn input-field [id :string label :string value :string autocomplete :string] :document
 (document-vector (kw :div) (document-map :class (str "dads-form-control-label") :data-size (str "md"))
  (document-vector (kw :label) (document-map :class (str "dads-form-control-label__label") :for (str id)) (str label))
  (document-vector (kw :div)
   (document-vector (kw :span) (document-map :class (str "dads-input-text"))
    (document-vector (kw :input) (document-map :id (str id) :name (str id) :value (str value) :autocomplete (str autocomplete) :class (str "dads-input-text__input") :data-size (str "md") :type (str "text")))))))
(defn- bound-line [bind :string] :document
 (document-vector (kw :p) (document-map :data-bind (str bind)) (str "")))
(defn- choice-button [label :string kind :string act :string] :document
 (document-vector (kw :button) (document-map :class (str "dads-button") :type (str "button") :data-type (str kind) :data-action (str act)) (str label)))
;; approval-sheet: the operation approval template; the host fills the bound lines and wires Allow/Deny.
(defn approval-sheet [] :document
 (document-vector (kw :template) (document-map :id (str "dapp-approval"))
  (document-vector (kw :div) (document-map :class (str "app-empty-state") :role (str "alertdialog"))
   (bound-line "approval-title") (bound-line "approval-detail")
   (choice-button "許可" "solid-fill" "approve") (choice-button "拒否" "outline" "deny"))))
;; Torihiki toolkit primitives (devnet / demo only); data-tk names a click handled by assets/torihiki.js.
(defn tk-button [kind :string tk :string label :string] :document
 (document-vector (kw :button) (document-map :class (str "dads-button") :type (str "button") :data-type (str kind) :data-size (str "md") :data-tk (str tk)) (str label)))
(defn tk-tab [id :string label :string] :document
 (document-vector (kw :button) (document-map :class (str "tk-tab") :type (str "button") :data-tk-tab (str id) :role (str "tab")) (str label)))
(defn tk-input [id :string label :string value :string mode :string] :document
 (document-vector (kw :label) (document-map :class (str "tk-field"))
  (document-vector (kw :span) (document-map :class (str "tk-field-label")) (str label))
  (document-vector (kw :input) (document-map :id (str id) :type (str "text") :inputmode (str mode) :value (str value) :autocomplete (str "off") :spellcheck (str "false")))))
(defn tk-check [id :string label :string] :document
 (document-vector (kw :label) (document-map :class (str "tk-check"))
  (document-vector (kw :input) (document-map :id (str id) :type (str "checkbox")))
  (document-vector (kw :span) (str label))))
(defn tk-stat [label :string bind :string] :document
 (document-vector (kw :div) (document-map :class (str "tk-stat"))
  (document-vector (kw :span) (document-map :class (str "tk-stat-label")) (str label))
  (document-vector (kw :strong) (document-map :data-bind (str bind)) (str "—"))))
(defn- raw [html :string] :document
 (document-vector (kw :hiccup/raw) (str html)))
(defn tk-box [cls :string body :string] :document
 (document-vector (kw :div) (document-map :class (str cls)) (raw body)))
(defn tk-app [body :string] :document
 (document-vector (kw :div) (document-map :id (str "tk-app") :class (str "tk-app")) (raw body)))
(defn tk-tabs [body :string] :document
 (document-vector (kw :div) (document-map :class (str "tk-tabs") :role (str "tablist")) (raw body)))
(defn tk-heading [text :string] :document
 (document-vector (kw :h3) (document-map :class (str "tk-h")) (str text)))
(defn- plain-span [text :string] :document
 (document-vector (kw :span) (str text)))
(defn tk-cols [a :string b :string c :string] :document
 (document-vector (kw :div) (document-map :class (str "tk-cols")) (plain-span a) (plain-span b) (plain-span c)))
(defn tk-slot [id :string cls :string text :string] :document
 (document-vector (kw :div) (document-map :id (str id) :class (str cls)) (str text)))
(defn data-slot [name :string] :document
 (document-vector (kw :div) (document-map :data-slot (str name)) (str "")))
(defn tk-panel [name :string hide :bool body :string] :document
 (document-vector (kw :section) (document-map :class (str "tk-panel") :data-tk-panel (str name) :role (str "tabpanel") :hidden (document-bool hide)) (raw body)))
(defn tk-badge [text :string] :document
 (document-vector (kw :span) (document-map :class (str "tk-badge")) (str text)))
(defn tk-endpoint [] :document
 (document-vector (kw :label) (document-map :class (str "tk-endpoint"))
  (document-vector (kw :span) (document-map :class (str "tk-field-label")) (str "接続先"))
  (document-vector (kw :input) (document-map :id (str "tk-endpoint") :type (str "text") :placeholder (str "https://（devnet ノードのアドレス）") :autocomplete (str "off") :spellcheck (str "false")))))
(defn tk-status-text [text :string] :document
 (document-vector (kw :span) (document-map :class (str "tk-status") :data-bind (str "tk-status")) (str text)))
(defn tk-side [side :string pressed :string label :string] :document
 (document-vector (kw :button) (document-map :type (str "button") :class (str (string-concat "tk-seg-" side)) :data-tk-side (str side) :aria-pressed (str pressed)) (str label)))
(defn tk-seg [body :string] :document
 (document-vector (kw :div) (document-map :class (str "tk-seg") :role (str "group") :aria-label (str "売買")) (raw body)))
(defn tk-submit [label :string] :document
 (document-vector (kw :button) (document-map :type (str "button") :id (str "tk-submit") :class (str "tk-submit tk-submit-buy") :data-tk (str "submit")) (str label)))
(defn tk-link [tk :string label :string] :document
 (document-vector (kw :button) (document-map :type (str "button") :class (str "tk-link") :data-tk (str tk)) (str label)))
(defn tk-note [text :string] :document
 (document-vector (kw :p) (document-map :class (str "tk-note")) (str text)))
(defn tk-chart-host [] :document
 (document-vector (kw :div) (document-map :id (str "tk-chart") :class (str "tk-chart") :role (str "img") :aria-label (str "ローソク足と出来高")) (str "")))
(defn tk-span-choice [n :string pressed :string] :document
 (document-vector (kw :button) (document-map :type (str "button") :data-tk-span (str n) :aria-pressed (str pressed)) (str n)))
(defn tk-spans [label :string body :string] :document
 (document-vector (kw :div) (document-map :class (str "tk-spans"))
  (document-vector (kw :span) (document-map :class (str "tk-field-label")) (str label)) (raw body)))
