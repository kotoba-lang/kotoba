(ns html-document
  ;; No :export: parity harness appends zero-arg case defns via KIR.
  ;;
  ;; T5.2 + document-in-record (compiler ≥ 7691b1ae): multi-arg pure that
  ;; carries :document folds into guest records.
  (:schemas {:hdoc/void-attrs [:record :hdoc/void-attrs
                               [[:tag :string] [:attrs :document]]]
             :hdoc/leaf [:record :hdoc/leaf
                         [[:tag :string] [:text :string]]]
             :hdoc/leaf-attrs [:record :hdoc/leaf-attrs
                               [[:tag :string] [:attrs :document] [:text :string]]]
             :hdoc/branch [:record :hdoc/branch
                           [[:tag :string] [:children :document]]]
             :hdoc/branch-attrs [:record :hdoc/branch-attrs
                                 [[:tag :string]
                                  [:attrs :document]
                                  [:children :document]]]
             :hdoc/attr-pair [:record :hdoc/attr-pair
                              [[:name :string] [:value :string]]]
             :hdoc/render-attrs-from [:record :hdoc/render-attrs-from
                                      [[:attrs :document]
                                       [:i :i64]
                                       [:n :i64]
                                       [:acc :string]]]
             :hdoc/render-kids [:record :hdoc/render-kids
                                [[:kids :document]
                                 [:i :i64]
                                 [:n :i64]
                                 [:acc :string]]]}))

;; Delivery 6 second cutover slice (ADR-2607279200 / ADR-2607270100 §10 /
;; migration plan W6 dependency order css → **html** → …):
;;
;; A *logical UI document* is an ordinary `:document` value — the W4 UI
;; vocabulary (`:tag` / optional `:text` / optional `:attrs` / optional
;; `:children`) — not a host object and not a form-A string call graph.
;; Rendering to an HTML *stream* is pure guest recursion over that document
;; (dual-renderer stream half; DOM reconcile remains host-side W4#4).
;;
;; Form-A (`html_core.kotoba`) remains the oracle for escape / attr / void /
;; closed emission. This module must byte-agree with form-A and with a
;; key-sorted html.core run for the same flat structures. Consumer
;; `html.core` APIs are unchanged.
;;
;; Capability-free (kotoba/pure). Handles are not the application model.
;; T5.2: multi-arg pure folded into :hdoc/* guest records after document-in-record.

;; --- escape (same four replacements as html.core / form-A) ----------------

(defn esc [s :string] :string
  (string-replace-all
   (string-replace-all
    (string-replace-all
     (string-replace-all s "&" "&amp;")
     "<" "&lt;")
    ">" "&gt;")
   "\"" "&quot;"))

;; --- void-tag detection (subset used by contract corpus) ------------------

(defn void-tag? [tag :string] :bool
  (or (string=? tag "area")
      (string=? tag "base")
      (string=? tag "br")
      (string=? tag "col")
      (string=? tag "embed")
      (string=? tag "hr")
      (string=? tag "img")
      (string=? tag "input")
      (string=? tag "link")
      (string=? tag "meta")
      (string=? tag "param")
      (string=? tag "source")
      (string=? tag "track")
      (string=? tag "wbr")))

;; --- document constructors ------------------------------------------------

(defn text-node [s :string] :document
  (document-string s))

(defn void-node [tag :string] :document
  (document-map :tag (document-string tag) :void (document-bool true)))

(defn void-node-attrs [x [:ref :hdoc/void-attrs]] :document
  (let [tag (record-get x :tag)
        attrs (record-get x :attrs)]
    (document-map :tag (document-string tag)
                  :void (document-bool true)
                  :attrs attrs)))

(defn leaf [x [:ref :hdoc/leaf]] :document
  (let [tag (record-get x :tag)
        text (record-get x :text)]
    (document-map :tag (document-string tag)
                  :text (document-string text))))

(defn leaf-attrs [x [:ref :hdoc/leaf-attrs]] :document
  (let [tag (record-get x :tag)
        attrs (record-get x :attrs)
        text (record-get x :text)]
    (document-map :tag (document-string tag)
                  :attrs attrs
                  :text (document-string text))))

(defn branch [x [:ref :hdoc/branch]] :document
  (let [tag (record-get x :tag)
        children (record-get x :children)]
    (document-map :tag (document-string tag)
                  :children children)))

(defn branch-attrs [x [:ref :hdoc/branch-attrs]] :document
  (let [tag (record-get x :tag)
        attrs (record-get x :attrs)
        children (record-get x :children)]
    (document-map :tag (document-string tag)
                  :attrs attrs
                  :children children)))

(defn attrs-map [entries :document] :document
  entries)

;; --- field accessors ------------------------------------------------------

(defn tag-of [d :document] :string
  (option-or
    (document-string-value
      (option-or (document-get d :tag) (document-null)))
    "div"))

(defn text-of [d :document] :string
  (option-or
    (document-string-value
      (option-or (document-get d :text) (document-null)))
    ""))

(defn kids-of [d :document] :document
  (option-or (document-get d :children) (document-vector)))

(defn attrs-of [d :document] :document
  (option-or (document-get d :attrs) (document-map)))

(defn void-of [d :document] :bool
  (option-or
    (document-bool-value
      (option-or (document-get d :void) (document-null)))
    false))

;; --- attribute emission (key-sorted via document-map-entry-at) ------------

(defn attr-pair [x [:ref :hdoc/attr-pair]] :string
  (let [name (record-get x :name)
        value (record-get x :value)]
    (string-concat " "
                   (string-concat name
                                  (string-concat "=\""
                                                 (string-concat (esc value) "\""))))))

(defn bool-attr [name :string] :string
  (string-concat " " name))

(defn render-attr-entry [entry :document] :string
  ;; entry is a vector document [keyword-doc, value-doc]
  (let [kdoc (option-or (document-vector-at entry 0) (document-null))
        vdoc (option-or (document-vector-at entry 1) (document-null))
        name (keyword-name
              (option-or (document-keyword-value kdoc) :missing))]
    (if (= (document-kind vdoc) :bool)
      (if (option-or (document-bool-value vdoc) false)
        (bool-attr name)
        "")
      (attr-pair
       (record-new [:ref :hdoc/attr-pair]
                   name
                   (option-or (document-string-value vdoc) ""))))))

(defn render-attrs-from [x [:ref :hdoc/render-attrs-from]] :string
  (let [attrs (record-get x :attrs)
        i (record-get x :i)
        n (record-get x :n)
        acc (record-get x :acc)]
    (if (>= i n)
      acc
      (render-attrs-from
       (record-new [:ref :hdoc/render-attrs-from]
                   attrs (+ i 1) n
                   (string-concat acc
                     (render-attr-entry
                      (option-or (document-map-entry-at attrs i)
                                 (document-null)))))))))

(defn render-attrs [d :document] :string
  (let [a (attrs-of d)]
    (if (= (document-kind a) :map)
      (render-attrs-from
       (record-new [:ref :hdoc/render-attrs-from] a 0 (document-count a) ""))
      "")))

;; --- render logical UI document → HTML stream -----------------------------

(defn render-kids [x [:ref :hdoc/render-kids]] :string
  (let [kids (record-get x :kids)
        i (record-get x :i)
        n (record-get x :n)
        acc (record-get x :acc)]
    (if (>= i n)
      acc
      (render-kids
       (record-new [:ref :hdoc/render-kids]
                   kids (+ i 1) n
                   (string-concat acc
                     (render (option-or (document-vector-at kids i)
                                        (document-null)))))))))

(defn render [d :document] :string
  (if (= (document-kind d) :string)
    (esc (option-or (document-string-value d) ""))
    (if (void-of d)
      (string-concat "<"
        (string-concat (tag-of d)
          (string-concat (render-attrs d) ">")))
      (if (void-tag? (tag-of d))
        (string-concat "<"
          (string-concat (tag-of d)
            (string-concat (render-attrs d) ">")))
        (if (string=? (text-of d) "")
          (string-concat "<"
            (string-concat (tag-of d)
              (string-concat (render-attrs d)
                (string-concat ">"
                  (string-concat
                   (render-kids
                    (record-new [:ref :hdoc/render-kids]
                                (kids-of d) 0 (document-count (kids-of d)) ""))
                   (string-concat "</" (string-concat (tag-of d) ">")))))))
          (string-concat "<"
            (string-concat (tag-of d)
              (string-concat (render-attrs d)
                (string-concat ">"
                  (string-concat (esc (text-of d))
                    (string-concat "</" (string-concat (tag-of d) ">"))))))))))))

(defn html5 [body :document] :string
  (string-concat "<!DOCTYPE html>\n" (render body)))

;; --- identity (W4 print/sha256 surface) -----------------------------------

(defn node-digest [d :document] :string
  (document-sha256 d))

(defn node-print [d :document] :string
  (document-print d))

(defn node-read [s :string] :document
  (document-read s))

(defn main []
  (string-byte-length
   (render
    (branch
     (record-new [:ref :hdoc/branch]
                 "div"
                 (document-vector
                  (leaf (record-new [:ref :hdoc/leaf] "h1" "Hello"))
                  (void-node "br")))))))
