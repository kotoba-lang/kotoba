{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; kotoba-lang/amu is a TEST-ONLY dependency, for the parity gate
         ;; that compiles kotoba/html_core.kotoba and requires it to emit
         ;; byte-identical text to html.core (ADR-2607270100 section 10). The
         ;; library itself has no runtime dependency on it.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       ;; amu 1e21a1f types string=? / string-contains? as
                       ;; :bool (c3be07fb still typed them :i64).
                       :git/sha "1e21a1f56613d7d4c7628af1945ebf1cf7862ff3"}}
         :main-opts ["-m" "cognitect.test-runner"]}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
