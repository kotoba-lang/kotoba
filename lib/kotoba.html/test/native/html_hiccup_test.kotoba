(ns hiccup-test (:export [main]) (:require [html-hiccup :as h]))
(defn check [d :document expected :string] :bool
 (let [out (h/render d 0)] (and (option-some?-of [:option :string] out) (string=? (option-value-of [:option :string] out "") expected))))
(defn main [] :i64
 (if (and
 (check (document-vector (document-keyword :p) (document-map :title (document-string "a&b")) (document-string "Hello <world>")) "<p title=\"a&amp;b\">Hello &lt;world&gt;</p>")
 (check (document-vector (document-keyword :div) (document-vector (document-keyword :p) (document-string "a")) (document-vector (document-keyword :p) (document-string "b"))) "<div>\n  <p>a</p>\n  <p>b</p>\n</div>")
 (check (document-vector (document-keyword :pre) (document-vector (document-keyword :code) (document-string "x"))) "<pre><code>x</code></pre>")
 (check (document-vector (document-keyword :<>) (document-vector (document-keyword :b) (document-string "x")) (document-string "y")) "<b>x</b>y")
 (check (document-vector (document-keyword :div) (document-map :class (document-vector (document-keyword :a) (document-keyword :b)) :style (document-map :color (document-string "red")) :hidden (document-bool true) :other (document-bool false))) "<div class=\"a b\" hidden style=\"color:red;\"></div>")
 (check (document-vector (document-edn-read ":div.a#b") (document-map :class (document-string "x") :id (document-string "y")) (document-string "z")) "<div class=\"a x\" id=\"b y\">z</div>")
 (check (document-vector (document-keyword :div.a) (document-map :class (document-vector (document-keyword :x) (document-keyword :y))) (document-string "z")) "<div class=\"a x y\">z</div>")
 (check (document-vector (document-keyword :p) (document-map :title (document-keyword :hello)) (document-keyword :world)) "<p title=\":hello\">:world</p>")
 (not (option-some?-of [:option :string] (h/render (document-vector (document-keyword :div) (document-map :class (document-map :nested (document-string "x")))) 0)))
 (check (document-vector (document-keyword :script) (document-string "1<2")) "<script>1<2</script>")
 (not (option-some?-of [:option :string] (h/render (document-vector (document-keyword :script) (document-string "</ScRiPt>")) 0)))
 ) 42 7))
