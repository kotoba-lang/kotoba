(ns ui-components-test (:export [main]) (:require [html-hiccup :as h] [ui-components :as u]))
;; Bounded native check of the shared dapp UI components (JUN-856). Expected
;; strings are the renderer's canonical output: attributes in sorted order,
;; block elements indented, inline elements (span, label, button text) on one line.
(defn check [d :document expected :string] :bool
 (let [out (h/render d 0)] (and (option-some?-of [:option :string] out) (string=? (option-value-of [:option :string] out "") expected))))
(defn main [] :i64
 (if (and
 (check (u/chip "Ready" "ok")
  "<span class=\"chip chip-ok\">Ready</span>")
 (check (u/button "Open" "open:notes")
  "<button class=\"btn\" data-action=\"open:notes\" type=\"button\">Open</button>")
 (check (u/row "Notes" "3 items")
  "<li class=\"row\">\n  <span class=\"row-title\">Notes</span>\n  <span class=\"row-detail\">3 items</span>\n</li>")
 (check (u/text-field "title" "Title <x>" "note.title")
  "<label class=\"field\"><span class=\"field-label\">Title &lt;x&gt;</span><input data-bind=\"note.title\" name=\"title\" type=\"text\"></label>")
 (check (u/card "Notes" (u/chip "ok" "ok"))
  "<section class=\"card\">\n  <h2>Notes</h2>\n  <span class=\"chip chip-ok\">ok</span>\n</section>")
 (check (u/panel "p1" (u/chip "x" "warn"))
  "<div class=\"panel\" id=\"p1\">\n  <span class=\"chip chip-warn\">x</span>\n</div>")
 (check (u/tab-bar3 (u/tab "One" "one" true) (u/tab "Two" "two" false) (u/tab "Three" "three" false))
  "<nav class=\"tabs\" role=\"tablist\">\n  <button aria-selected=\"true\" class=\"tab tab-selected\" data-action=\"select:one\" type=\"button\">One</button>\n  <button aria-selected=\"false\" class=\"tab\" data-action=\"select:two\" type=\"button\">Two</button>\n  <button aria-selected=\"false\" class=\"tab\" data-action=\"select:three\" type=\"button\">Three</button>\n</nav>")
 (check (u/launcher-tile "browser" "Browser" "B" "default")
  "<a aria-label=\"Browser\" class=\"desktop-app\" data-app=\"browser\" data-cat=\"default\" href=\"#browser\">\n  <span aria-hidden=\"true\" class=\"desktop-app-icon\" data-cat=\"default\">B</span>\n  <span class=\"desktop-app-label\">Browser</span>\n</a>")
 (check (u/dock-tile "browser" "Browser" "B" "default" "true")
  "<a aria-label=\"Browser\" class=\"dock-app\" data-app=\"browser\" data-cat=\"default\" data-dock-default=\"true\" hidden href=\"#browser\">\n  <span aria-hidden=\"true\" class=\"dock-app-icon\" data-cat=\"default\">B</span>\n  <span class=\"dock-app-label\">Browser</span>\n</a>")
 (check (u/app-window "tokei" "Tokei" "Clock" "時刻" "<pre class=\"session-out\" data-bind=\"clock\"></pre>")
  "<section class=\"dds-ext-section session-view\" data-view=\"tokei\" hidden id=\"tokei\">\n  <article class=\"app-window\">\n    <header class=\"app-window-head\">\n      <a aria-label=\"Close app\" class=\"window-close\" href=\"#desktop\">×</a>\n      <span class=\"app-window-title\">Tokei</span>\n      <span class=\"window-spacer\"></span>\n      <span class=\"app-window-state\">Clock</span>\n    </header>\n    <div class=\"app-window-body\">\n      <h1 class=\"dads-heading\" data-size=\"32\">Tokei</h1>\n      <p class=\"session-lede\">時刻</p>\n      <div class=\"dds-ext-card\"><pre class=\"session-out\" data-bind=\"clock\"></pre></div>\n      <a class=\"app-return\" href=\"#desktop\">デスクトップへ</a>\n    </div>\n  </article>\n</section>")
 (check (u/heading 1 "Title")
  "<h1 class=\"dads-heading\" data-size=\"32\">Title</h1>")
 (check (u/heading 2 "Sub <&>")
  "<h2 class=\"dads-heading\" data-size=\"24\">Sub &lt;&amp;&gt;</h2>")
 (check (u/empty-state "Nothing here")
  "<p class=\"app-empty-state\">Nothing here</p>")
 (check (u/pre-out "" "" "a\nb")
  "<pre class=\"session-out\">a\nb</pre>")
 (check (u/pre-out "clock" "" "")
  "<pre class=\"session-out\" data-bind=\"clock\"></pre>")
 (check (u/pre-out "" "tk-result" "")
  "<pre class=\"session-out\" data-slot=\"tk-result\"></pre>")
 (check (u/result-slot)
  "<div data-slot=\"result\"></div>")
 (check (u/request-button "Go" "fetch-catalog" "Itonami")
  "<button class=\"dads-button\" data-action=\"request\" data-op=\"fetch-catalog\" data-service=\"Itonami\" data-size=\"md\" data-type=\"solid-fill\" type=\"button\">Go</button>")
 (check (u/note-line "Aozora: 外部操作なし")
  "<p>Aozora: 外部操作なし</p>")
 (check (u/pin-row "Browser <b>" "browser")
  "<p>Browser &lt;b&gt; <button class=\"dads-button\" data-action=\"pin\" data-app=\"browser\" data-type=\"outline\" type=\"button\">Dock に置く</button></p>")
 (check (u/mode-radio "notify" "通知のみ")
  "<label><input data-action=\"set-update-mode\" name=\"update-mode\" type=\"radio\" value=\"notify\"> 通知のみ</label>")
 (check (u/status-body "net" "承認が必要")
  "<pre class=\"session-out\" data-bind=\"net\"></pre><p class=\"app-empty-state\">承認が必要</p>")
 (check (u/action-button "run" "Go" "solid-fill")
  "<button class=\"dads-button\" data-size=\"md\" data-type=\"solid-fill\" id=\"run\" type=\"button\">Go</button>")
 (check (u/out-pre "o1" "")
  "<pre class=\"session-out\" id=\"o1\"></pre>")
 (check (u/out-pre "o2" "polite")
  "<pre aria-live=\"polite\" class=\"session-out\" id=\"o2\"></pre>")
 (check (u/code-span "a<b")
  "<code>a&lt;b</code>")
 (check (u/rich-line "x <code>y</code>")
  "<p>x <code>y</code></p>")
 (check (u/region "reader-empty" "Book shelf" "<p>z</p>")
  "<section aria-label=\"Book shelf\" class=\"reader-empty\"><p>z</p></section>")
 (check (u/app-frame "aozora" "Aozora" "Reader" "読書" (u/empty-state "e"))
  "<section class=\"dds-ext-section session-view\" data-view=\"aozora\" hidden id=\"aozora\">\n  <article class=\"app-window\">\n    <header class=\"app-window-head\">\n      <a aria-label=\"Close app\" class=\"window-close\" href=\"#desktop\">×</a>\n      <span class=\"app-window-title\">Aozora</span>\n      <span class=\"window-spacer\"></span>\n      <span class=\"app-window-state\">Reader</span>\n    </header>\n    <div class=\"app-window-body\">\n      <h1 class=\"dads-heading\" data-size=\"32\">Aozora</h1>\n      <p class=\"session-lede\">読書</p>\n      <p class=\"app-empty-state\">e</p>\n      <a class=\"app-return\" href=\"#desktop\">デスクトップへ</a>\n    </div>\n  </article>\n</section>")
 (check (u/view-section "manage" true "<p>b</p>")
  "<section class=\"dds-ext-section session-view\" data-view=\"manage\" hidden id=\"manage\"><p>b</p></section>")
 (check (u/view-section "session" false "")
  "<section class=\"dds-ext-section session-view\" data-view=\"session\" id=\"session\"></section>")
 (check (u/lede-line "a <code>b</code>")
  "<p class=\"session-lede\">a <code>b</code></p>")
 (check (u/ext-card "<p>c</p>")
  "<div class=\"dds-ext-card\"><p>c</p></div>")
 (check (u/kotoba-button "go" "Go" "device-auth/start")
  "<button class=\"dads-button\" data-kotoba-action=\"device-auth/start\" data-size=\"md\" data-type=\"solid-fill\" id=\"go\" type=\"button\">Go</button>")
 (check (u/qr-image "qr" "alt <1>")
  "<img alt=\"alt &lt;1&gt;\" class=\"device-auth-qr\" hidden id=\"qr\">")
 (check (u/link-out "lnk" "Open")
  "<a class=\"dads-link\" hidden href=\"#\" id=\"lnk\" rel=\"noopener noreferrer\" target=\"_blank\">Open</a>")
 (check (u/details-box "Sum" "<p>d</p>")
  "<details class=\"session-details\"><summary>Sum</summary><p>d</p></details>")
 (check (u/input-field "owner" "Owner" "acct:x" "username")
  "<div class=\"dads-form-control-label\" data-size=\"md\">\n  <label class=\"dads-form-control-label__label\" for=\"owner\">Owner</label>\n  <div>\n    <span class=\"dads-input-text\"><input autocomplete=\"username\" class=\"dads-input-text__input\" data-size=\"md\" id=\"owner\" name=\"owner\" type=\"text\" value=\"acct:x\"></span>\n  </div>\n</div>")
 ) 42 7))
