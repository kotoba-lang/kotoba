(ns ui-components-test (:export [main]) (:require [html-hiccup :as h] [ui-components :as u]))
;; Bounded native check of the shared dapp UI components (JUN-856). Expected
;; strings are the renderer's canonical output: attributes in sorted order,
;; block elements indented, inline elements (span, label, button text) on one line.
(defn check [d :document expected :string] :bool
 (let [out (h/render d 0)] (and (option-some?-of [:option :string] out) (string=? (option-value-of [:option :string] out "") expected))))
(defn main [] :i64
 (if (and
 (check (u/chip "Ready" "ok")
  "<span class=\"chip chip-ok\">Ready</span>")
 (check (u/button "Open" "open:notes")
  "<button class=\"btn\" data-action=\"open:notes\" type=\"button\">Open</button>")
 (check (u/row "Notes" "3 items")
  "<li class=\"row\">\n  <span class=\"row-title\">Notes</span>\n  <span class=\"row-detail\">3 items</span>\n</li>")
 (check (u/text-field "title" "Title <x>" "note.title")
  "<label class=\"field\"><span class=\"field-label\">Title &lt;x&gt;</span><input data-bind=\"note.title\" name=\"title\" type=\"text\"></label>")
 (check (u/card "Notes" (u/chip "ok" "ok"))
  "<section class=\"card\">\n  <h2>Notes</h2>\n  <span class=\"chip chip-ok\">ok</span>\n</section>")
 (check (u/panel "p1" (u/chip "x" "warn"))
  "<div class=\"panel\" id=\"p1\">\n  <span class=\"chip chip-warn\">x</span>\n</div>")
 (check (u/tab-bar3 (u/tab "One" "one" true) (u/tab "Two" "two" false) (u/tab "Three" "three" false))
  "<nav class=\"tabs\" role=\"tablist\">\n  <button aria-selected=\"true\" class=\"tab tab-selected\" data-action=\"select:one\" type=\"button\">One</button>\n  <button aria-selected=\"false\" class=\"tab\" data-action=\"select:two\" type=\"button\">Two</button>\n  <button aria-selected=\"false\" class=\"tab\" data-action=\"select:three\" type=\"button\">Three</button>\n</nav>")
 (check (u/launcher-tile "browser" "Browser" "B" "default")
  "<a aria-label=\"Browser\" class=\"desktop-app\" data-app=\"browser\" data-cat=\"default\" href=\"#browser\">\n  <span aria-hidden=\"true\" class=\"desktop-app-icon\" data-cat=\"default\">B</span>\n  <span class=\"desktop-app-label\">Browser</span>\n</a>")
 (check (u/dock-tile "browser" "Browser" "B" "default" "true")
  "<a aria-label=\"Browser\" class=\"dock-app\" data-app=\"browser\" data-cat=\"default\" data-dock-default=\"true\" hidden href=\"#browser\">\n  <span aria-hidden=\"true\" class=\"dock-app-icon\" data-cat=\"default\">B</span>\n  <span class=\"dock-app-label\">Browser</span>\n</a>")
 (check (u/launcher-tile "murakumo" "Murakumo" "M" "")
  "<a aria-label=\"Murakumo\" class=\"desktop-app\" data-app=\"murakumo\" href=\"#murakumo\">\n  <span aria-hidden=\"true\" class=\"desktop-app-icon\">M</span>\n  <span class=\"desktop-app-label\">Murakumo</span>\n</a>")
 (check (u/dock-link "#murakumo" "murakumo" "Murakumo" "M" "" "" false)
  "<a aria-label=\"Murakumo\" class=\"dock-app\" data-app=\"murakumo\" href=\"#murakumo\">\n  <span aria-hidden=\"true\" class=\"dock-app-icon\">M</span>\n  <span class=\"dock-app-label\">Murakumo</span>\n</a>")
 (check (u/dock-link "#manage" "" "Settings" "⚙" "" "" false)
  "<a aria-label=\"Settings\" class=\"dock-app\" href=\"#manage\">\n  <span aria-hidden=\"true\" class=\"dock-app-icon\">⚙</span>\n  <span class=\"dock-app-label\">Settings</span>\n</a>")
 (check (u/dock-link "#browser" "browser" "Browser" "B" "default" "true" true)
  "<a aria-label=\"Browser\" class=\"dock-app\" data-app=\"browser\" data-cat=\"default\" data-dock-default=\"true\" hidden href=\"#browser\">\n  <span aria-hidden=\"true\" class=\"dock-app-icon\" data-cat=\"default\">B</span>\n  <span class=\"dock-app-label\">Browser</span>\n</a>")
 (check (u/dock-divider)
  "<span aria-hidden=\"true\" class=\"dock-divider\"></span>")
 (check (u/menubar)
  "<div class=\"desktop-menubar\">\n  <a class=\"desktop-brand\" href=\"#desktop\">AIUEOS</a>\n  <span class=\"desktop-menubar-app\">Kotoba Browser</span>\n  <span class=\"desktop-menubar-spacer\"></span>\n  <a class=\"desktop-menu-link\" href=\"#session\">Session</a>\n  <a class=\"desktop-menu-link\" href=\"#compositor\">Window Lab</a>\n  <a class=\"desktop-menu-link\" href=\"#manage\">Settings</a>\n</div>")
 (check (u/welcome "T <1>" "L")
  "<div class=\"desktop-welcome\">\n  <h1 class=\"dads-heading\" data-size=\"32\">T &lt;1&gt;</h1>\n  <p class=\"session-lede\">L</p>\n</div>")
 (check (u/app-grid "<a>x</a>")
