 (check (u/desktop-footer "F <&>")
  "<footer class=\"desktop-footer\">F &lt;&amp;&gt;</footer>")
 (check (u/desktop-view "<a>g</a>" "<a>d</a>")
  "<section class=\"dds-ext-section session-view\" data-view=\"desktop\" id=\"desktop\">\n  <div class=\"desktop-surface\">\n    <div class=\"desktop-menubar\">\n      <a class=\"desktop-brand\" href=\"#desktop\">AIUEOS</a>\n      <span class=\"desktop-menubar-app\">Kotoba Browser</span>\n      <span class=\"desktop-menubar-spacer\"></span>\n      <a class=\"desktop-menu-link\" href=\"#session\">Session</a>\n      <a class=\"desktop-menu-link\" href=\"#compositor\">Window Lab</a>\n      <a class=\"desktop-menu-link\" href=\"#manage\">Settings</a>\n    </div>\n    <div class=\"desktop-welcome\">\n      <h1 class=\"dads-heading\" data-size=\"32\">AIUEOS</h1>\n      <p class=\"session-lede\">Kotoba Browser からアプリを開く</p>\n    </div>\n    <nav aria-label=\"Applications\" class=\"desktop-app-grid\"><a>g</a></nav>\n    <div class=\"desktop-dock-wrap\">\n      <nav aria-label=\"Dock\" class=\"desktop-dock\"><a>d</a></nav>\n    </div>\n    <footer class=\"desktop-footer\">Kotoba · Amu · AIUEOS</footer>\n  </div>\n</section>")
 (check (u/compositor-view "L")
  "<section class=\"dds-ext-section session-view\" data-view=\"compositor\" hidden id=\"compositor\">\n  <h1 class=\"dads-heading\" data-size=\"32\">Window Lab</h1>\n  <p class=\"session-lede\">L</p>\n  <div aria-label=\"input method\" class=\"ime-bar dds-ext-row\" data-ime=\"on\" id=\"ime-bar\">\n    <span class=\"dads-chip-label\" data-color=\"blue\" data-style=\"filled-1\">かな</span>\n    <h2 class=\"dads-heading\" data-size=\"16\" id=\"ime-preedit-label\">変換中</h2>\n    <p aria-live=\"polite\" class=\"session-lede\" id=\"ime-preedit\"></p>\n    <p class=\"session-lede\" id=\"ime-buf\"></p>\n    <div aria-label=\"kanji candidates\" id=\"ime-candidates\"></div>\n    <button class=\"dads-button\" data-size=\"sm\" data-type=\"outline\" id=\"ime-toggle\" type=\"button\">IME 切</button>\n  </div>\n  <div aria-label=\"window-session-state\" class=\"wm-stage\" id=\"wm-stage\" tabindex=\"0\">\n    <article class=\"wm-window\" data-guest=\"session\" data-window-id=\"1\" id=\"wm-window-1\">\n      <header class=\"wm-titlebar dds-ext-row\" data-raise=\"1\">\n        <h2 class=\"dads-heading\" data-size=\"16\" id=\"wm-title-1\">session</h2>\n        <span class=\"dads-chip-label\" data-color=\"blue\" data-style=\"filled-1\">フォーカス</span>\n        <button class=\"dads-button\" data-raise=\"1\" data-size=\"sm\" data-type=\"outline\" id=\"wm-raise-1\" type=\"button\">前面へ</button>\n      </header>\n      <div class=\"wm-body\">\n        <div aria-label=\"session\" class=\"wm-guest\" data-src=\"/#session\" id=\"wm-guest-1\" tabindex=\"0\">\n          <p class=\"session-lede\">guest <code>/#session</code></p>\n        </div>\n      </div>\n    </article>\n    <article class=\"wm-window\" data-guest=\"kami\" data-window-id=\"2\" id=\"wm-window-2\">\n      <header class=\"wm-titlebar dds-ext-row\" data-raise=\"2\">\n        <h2 class=\"dads-heading\" data-size=\"16\" id=\"wm-title-2\">guest-surface</h2>\n        <span class=\"dads-chip-label\" data-color=\"blue\" data-style=\"filled-1\">フォーカス</span>\n        <button class=\"dads-button\" data-raise=\"2\" data-size=\"sm\" data-type=\"outline\" id=\"wm-raise-2\" type=\"button\">前面へ</button>\n      </header>\n      <div class=\"wm-body\">\n        <canvas aria-label=\"kami WebGPU guest surface\" class=\"kami-viewport wm-guest\" data-engine=\"kami.webgpu.ir\" data-executor=\"kami.webgpu\" height=\"360\" id=\"kami-viewport\" tabindex=\"0\" width=\"640\"></canvas>\n      </div>\n    </article>\n  </div>\n  <pre class=\"session-out\" hidden id=\"compositor-out\"></pre>\n  <pre class=\"session-out\" id=\"guest-desktop-out\"></pre>\n  <pre class=\"session-out\" id=\"kami-out\"></pre>\n  <pre class=\"session-out\" id=\"wm-input-out\"></pre>\n</section>")
 (check (u/app-window "tokei" "Tokei" "Clock" "時刻" "<pre class=\"session-out\" data-bind=\"clock\"></pre>")
  "<section class=\"dds-ext-section session-view\" data-view=\"tokei\" hidden id=\"tokei\">\n  <article class=\"app-window\">\n    <header class=\"app-window-head\">\n      <a aria-label=\"Close app\" class=\"window-close\" href=\"#desktop\">×</a>\n      <span class=\"app-window-title\">Tokei</span>\n      <span class=\"window-spacer\"></span>\n      <span class=\"app-window-state\">Clock</span>\n    </header>\n    <div class=\"app-window-body\">\n      <h1 class=\"dads-heading\" data-size=\"32\">Tokei</h1>\n      <p class=\"session-lede\">時刻</p>\n      <div class=\"dds-ext-card\"><pre class=\"session-out\" data-bind=\"clock\"></pre></div>\n      <a class=\"app-return\" href=\"#desktop\">デスクトップへ</a>\n    </div>\n  </article>\n</section>")
 (check (u/heading 1 "Title")
