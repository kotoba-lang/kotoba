  "<div class=\"dads-form-control-label\" data-size=\"md\">\n  <label class=\"dads-form-control-label__label\" for=\"owner\">Owner</label>\n  <div>\n    <span class=\"dads-input-text\"><input autocomplete=\"username\" class=\"dads-input-text__input\" data-size=\"md\" id=\"owner\" name=\"owner\" type=\"text\" value=\"acct:x\"></span>\n  </div>\n</div>")
 (check (u/approval-sheet)
  "<template id=\"dapp-approval\">\n  <div class=\"app-empty-state\" role=\"alertdialog\">\n    <p data-bind=\"approval-title\"></p>\n    <p data-bind=\"approval-detail\"></p>\n    <button class=\"dads-button\" data-action=\"approve\" data-type=\"solid-fill\" type=\"button\">許可</button>\n    <button class=\"dads-button\" data-action=\"deny\" data-type=\"outline\" type=\"button\">拒否</button>\n  </div>\n</template>")
 (check (u/tk-button "outline" "save-endpoint" "保存")
  "<button class=\"dads-button\" data-size=\"md\" data-tk=\"save-endpoint\" data-type=\"outline\" type=\"button\">保存</button>")
