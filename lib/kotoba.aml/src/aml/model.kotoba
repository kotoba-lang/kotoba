;; Port of aml.model (model.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from model.cljk:
;;   - routes and levels are zero-arg fns (a def cannot be exported). routes is
;;     the :document vector of keywords, levels the :document set.
;;   - a null :routes value falls back to the default routes (as nil does in the source).
;;   - :aml/categories is (set categories): a set is kept as is; a vector or list
;;     is read as its members with duplicates removed through the EDN reader; a
;;     null or other value reads as the empty set.
;;   - a list or set is re-read from its EDN text as a vector before iteration,
;;     since indexing a list or set traps at run time.
;;   - :aml/non-adjudicating is the bool true.

(ns aml.model
  (:export [routes levels request result]))

(defn routes [] :document
  (document-vector (document-keyword :yabai) (document-keyword :malak)))

(defn levels [] :document
  (document-set (document-keyword :clear) (document-keyword :monitor) (document-keyword :challenge)
                (document-keyword :deny) (document-keyword :review)))

(defn- kind-of [d :document] :string
  (keyword-name (document-kind d)))

(defn- field [d :document k :keyword] :document
  (if (string=? (kind-of d) "map")
    (option-or (document-get d k) (document-null))
    (document-null)))

(defn- at [xs :document i :i64] :document
  (option-or (document-vector-at xs i) (document-null)))

(defn- as-vector [g :document] :document
  (let [k (kind-of g)]
    (if (string=? k "vector")
      g
      (let [t (document-edn-print g)
            n (string-length t)
            inner (if (string=? k "set")
                    (string-substring t 2 (- n 1))
                    (string-substring t 1 (- n 1)))]
        (document-edn-read (string-concat (string-concat "[" inner) "]"))))))

(defn- edn-set [members :document] :document
  (let [n (document-count members)]
    (loop [i 0 seen "\n" out ""]
      (if (>= i n)
        (document-edn-read (string-concat (string-concat "#{" out) "}"))
        (let [t (document-edn-print (at members i))]
          (if (string-contains? seen (string-concat (string-concat "\n" t) "\n"))
            (recur (+ i 1) seen out)
            (recur (+ i 1) (string-concat (string-concat seen t) "\n") (string-concat (string-concat out " ") t))))))))

(defn- as-set [c :document] :document
  (let [k (kind-of c)]
    (if (string=? k "set")
      c
      (if (or (string=? k "vector") (or (string=? k "list")))
        (edn-set (as-vector c))
        (document-set)))))

(defn request [id :document subject :document opts :document] :document
  (let [routes-v (field opts :routes)]
    (document-map :aml/id id
                  :aml/subject subject
                  :aml/purpose (field opts :purpose)
                  :aml/case-ref (field opts :case-ref)
                  :aml/routes (if (string=? (kind-of routes-v) "null") (routes) routes-v)
                  :aml/requested-at (field opts :requested-at))))

(defn result [req :document route :document level :document opts :document] :document
  (document-map :aml/id (field req :aml/id)
                :aml/route route
                :aml/level level
                :aml/score (field opts :score)
                :aml/categories (as-set (field opts :categories))
                :aml/evidence-ref (field opts :evidence-ref)
                :aml/asserter (field opts :asserter)
                :aml/observed-at (field opts :observed-at)
                :aml/non-adjudicating (document-bool true)))
