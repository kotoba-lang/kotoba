(ns aml.model-test
  (:export [main])
  (:require [aml.model :as m]))

(defn- str-at [d :document k :keyword] :string
  (option-or (document-string-value (option-or (document-get d k) (document-null))) "<none>"))

(defn- size-at [d :document k :keyword] :i64
  (document-count (option-or (document-get d k) (document-null))))

(defn main [] :i64
  (let [req (m/request (document-string "aml-1") (document-string "subj")
                       (document-map :purpose (document-string "kyc") :case-ref (document-string "C-9")))
        bare (m/request (document-string "aml-2") (document-string "subj") (document-map :routes (document-null)))
        res (m/result req (document-keyword :yabai) (document-keyword :review)
                      (document-map :score (document-i64 80)
                                    :categories (document-vector (document-string "pep") (document-string "pep") (document-string "sanction"))))]
    (+ (if (string=? (str-at req :aml/id) "aml-1") 0 1)
       (if (string=? (str-at req :aml/purpose) "kyc") 0 1)
       (if (= (size-at req :aml/routes) 2) 0 1)
       (if (= (size-at bare :aml/routes) 2) 0 1)
       (if (= (document-count (m/levels)) 5) 0 1)
       (if (= (document-count (m/routes)) 2) 0 1)
       (if (= (size-at res :aml/categories) 2) 0 1)
       (if (string=? (str-at res :aml/id) "aml-1") 0 1))))
