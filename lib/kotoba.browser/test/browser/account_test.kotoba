;; Acceptance test for browser.account (port of account.cljk).
;; main returns the number of failed cases (0 = all pass).
(ns browser.account-test
  (:export [main])
  (:require [browser.account :as ba]))

(defn- chk [ok :bool] :i64 (if ok 0 1))
(defn- kv [m :document k :keyword v :document] :document
  (document-assoc m (document-keyword k) v))
(defn- fget [m :document k :keyword] :document
  (option-or (document-get m (document-keyword k)) (document-null)))

(defn main [] :i64
  (let [bare (ba/new-account (document-map))
        a (chk (document-equal? (fget bare :account/id) (document-string "local")))
        b (chk (document-equal? (fget bare :account/display-name) (document-string "Local User")))
        c (chk (document-equal? (fget bare :account/trust) (document-keyword :local)))
        d (chk (document-equal? (fget bare :account/keys) (document-vector)))
        e (chk (document-equal? (fget bare :account/handle) (document-null)))
        f (chk (not (ba/verified? bare)))
        ks (document-vector-conj (document-vector) (document-string "k1"))
        opts (kv (kv (kv (kv (kv (kv (document-map)
                                     :id (document-string "u1"))
                                 :handle (document-string "alice"))
                             :trust (document-keyword :verified))
                         :keys ks)
                     :extra (document-i64 9))
                 :display-name (document-null))
        full (ba/new-account opts)
        g (chk (document-equal? (fget full :account/id) (document-string "u1")))
        h (chk (document-equal? (fget full :account/handle) (document-string "alice")))
        i (chk (document-equal? (fget full :account/display-name) (document-string "alice")))
        j (chk (document-equal? (fget full :account/trust) (document-keyword :verified)))
        k (chk (document-equal? (fget full :account/keys) ks))
        meta (fget full :account/meta)
        l (chk (document-equal? (fget meta :extra) (document-i64 9)))
        m (chk (not (document-contains meta (document-keyword :id))))
        n (chk (= (document-count meta) 1))
        o (chk (ba/verified? full))
        p (chk (ba/verified? (ba/new-account (kv (document-map) :trust (document-keyword :trusted)))))
        q (chk (not (ba/verified? (ba/new-account (kv (document-map) :trust (document-keyword :local))))))]
    (+ a (+ b (+ c (+ d (+ e (+ f (+ g (+ h (+ i (+ j (+ k (+ l (+ m (+ n (+ o (+ p q))))))))))))))))))
