(ns browser.native-text-edit-test
  (:require [browser.text-edit :as edit])
  (:export [main]))

;; Exercise the shared editing reducer, including all UTF-16/UTF-8 boundaries.
;; A native verdict of zero means every assertion passed.
(defn main [] :i64
  (let [empty (edit/empty-state)
        typed (edit/insert-text empty "あ😀")
        left (edit/move-caret typed -1 (record [:ref :browser.text-edit/options] false))
        right (edit/move-caret left 1 (record [:ref :browser.text-edit/options] false))
        inside (edit/collapse typed 2)
        deleted (edit/delete-backward typed)
        forward (edit/delete-forward inside)
        selected (edit/select typed 2 3)
        replaced (edit/insert-text selected "X")
        all (edit/select-all typed)
        cleared (edit/delete-backward all)
        composition (edit/composition-update (edit/composition-start empty) "に")
        committed (edit/composition-end composition "日本")
        extended (edit/move-to typed 0 (record [:ref :browser.text-edit/options] true))]
    (cond (not (string=? (:text/value empty) "")) 1
          (not= (:text/caret typed) 3) 2
          (not= (:text/caret left) 1) 3
          (not= (:text/caret right) 3) 4
          (not= (:text/caret inside) 1) 5
          (not (string=? (:text/value deleted) "あ")) 6
          (not (string=? (:text/value forward) "あ")) 7
          (not= (:text/selection-start selected) 1) 8
          (not (string=? (:text/value replaced) "あX")) 9
          (not (string=? (:text/value cleared) "")) 10
          (not (:text/composing composition)) 11
          (not (string=? (:text/value composition) "")) 12
          (not (string=? (:text/composition composition) "に")) 13
          (:text/composing committed) 14
          (not (string=? (:text/value committed) "日本")) 15
          (not= (:text/caret committed) 2) 16
          (not= (:text/selection-start extended) 0) 17
          (not= (:text/selection-end extended) 3) 18
          :else 0)))
