(ns browser.effects
  (:export [spring inertia sample self-check]))

;; Host-independent integer effects. Time is elapsed monotonic milliseconds;
;; no callback, frame count, wall clock, I/O or authority lives in this owner.
;; Positions use fixed-point 1/256 px. Restart from the displayed position on
;; interruption. Back easing is bounded to a small overshoot and settles at
;; exactly 200 ms; reduced motion and a long/resumed interval settle at once.
(defn spring [from target elapsed reduced]
  (if (or (= reduced 1) (>= elapsed 200) (< elapsed 0)) target
    (let [u (- elapsed 200)
          curve (+ 1000000 (quot (* 270 u u u) 800)
                   (quot (* 170 u u) 4))]
      (+ from (quot (* (- target from) curve) 1000000)))))

;; Analytic, cadence-independent displacement, velocity in px/second, with
;; linear friction over 180 ms. Clamp the initial velocity at the caller.
(defn inertia [velocity elapsed]
  (let [t (if (< elapsed 0) 180 (if (> elapsed 180) 180 elapsed))]
    (quot (* velocity t (- 360 t)) 360000)))

;; Original, asset-free signed PCM tick at 48 kHz, 1024 frames (21.3 ms).
;; event 1 selection, 2 confirm, 3 cancel, 4 notification. Silence outside the
;; declared event/frame/volume bounds. A host adapter must qualify actual output.
(defn sample [event frame volume muted]
  (if (or (= muted 1) (< volume 1) (> volume 100) (< frame 0)
          (>= frame 1024) (< event 1) (> event 4)) 0
    (let [period (if (= event 1) 64 (if (= event 2) 48 (if (= event 3) 96 80)))
          phase (mod frame period)
          triangle (if (< phase (quot period 2))
                     (- (* phase 4) period) (- (* period 3) (* phase 4)))
          attack (if (< frame 64) frame 64)
          release (- 1023 frame)]
      (quot (* triangle volume attack release 16) (* period 6400)))))

(defn self-check []
  (if (and (= (spring 0 1024 0 0) 0)
           (= (spring 0 1024 200 0) 1024)
           (> (spring 0 1024 140 0) 1024)
           (= (spring 512 0 0 0) 512)
           (= (spring 512 0 99 1) 0)
           (= (spring 512 0 -1 0) 0)
           (= (inertia 200 180) 18)
           (= (inertia -200 180) -18)
           (= (inertia 200 10000) 18)
           (= (sample 2 0 25 0) 0)
           (= (sample 2 1024 25 0) 0)
           (= (sample 2 100 25 1) 0)
           (not (= (sample 1 100 25 0) 0))) 1 0))
