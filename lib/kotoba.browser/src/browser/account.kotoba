;; Port of browser.account (account.cljk), Kotoba-native.
;; Minimal account identity model for kotoba-only browser profiles.
;;
;; Named divergences from account.cljk:
;;   - Options and the account are :document maps. nil is document-null.
;;   - `(or a b ...)` is reproduced as "first value that is neither nil nor
;;     false"; a non-boolean value counts as truthy, as in Clojure.
;;   - `(vec keys)`: a nil or absent :keys becomes an empty vector document; a
;;     vector document is kept as-is.
;;   - `verified?` compares the trust keyword by document equality.

(ns browser.account
  (:export [new-account verified?]))

(defn- fld [m :document k :keyword] :document
  (option-or (document-get m (document-keyword k)) (document-null)))

(defn- kv [m :document k :keyword v :document] :document
  (document-assoc m (document-keyword k) v))

(defn- truthy? [d :document] :bool
  (if (string=? (keyword-name (document-kind d)) "null")
    false
    (option-or (document-bool-value d) true)))

(defn- or2 [a :document b :document] :document
  (if (truthy? a) a b))

(defn new-account [opts :document] :document
  (let [id (fld opts :id)
        handle (fld opts :handle)
        display-name (fld opts :display-name)
        trust (fld opts :trust)
        ks (fld opts :keys)
        m0 (kv (document-map) :account/id (or2 id (or2 handle (document-string "local"))))
        m1 (kv m0 :account/handle handle)
        m2 (kv m1 :account/display-name
               (or2 display-name (or2 handle (document-string "Local User"))))
        m3 (kv m2 :account/trust (or2 trust (document-keyword :local)))
        m4 (kv m3 :account/keys (if (truthy? ks) ks (document-vector)))
        meta (document-dissoc
              (document-dissoc
               (document-dissoc
                (document-dissoc (document-dissoc opts :id) :handle)
                :display-name)
               :trust)
              :keys)]
    (kv m4 :account/meta meta)))

(defn verified? [account :document] :bool
  (let [t (fld account :account/trust)]
    (or (document-equal? t (document-keyword :verified))
        (document-equal? t (document-keyword :trusted)))))
