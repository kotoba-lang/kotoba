(ns browser-chrome
  ;; A `.kotoba` port of `browser.chrome` (ADR-2607270100 §10 form A: pure
  ;; functions, no capabilities, kotoba/pure profile). `browser.chrome` stays
  ;; the host-facing ns; this module carries the tab-model decision core:
  ;; opening a tab, focusing one, committing the URL bar into a navigation
  ;; intent, and finishing a navigation.
  ;;
  ;; Representation: the host ns models chrome as a plain map whose
  ;; `:chrome/tabs` is a vector of tab maps. This profile has no heterogeneous
  ;; maps keyed by runtime strings and no first-class vectors of maps, so the
  ;; same shape is carried as a DOCUMENT (the same substitution the
  ;; browser-use history port and html_document make): tab fields are
  ;; document entries (`document-string` / `document-keyword` / nested
  ;; `document-vector` for per-tab history), and the tab list is a
  ;; `document-vector` iterated by index. Nil title (fresh tab) becomes the
  ;; empty string; `:idle`/`:loading` keep their keyword form.
  ;;
  ;; What is NOT ported: `empty-chrome`'s `:chrome/next-tab-id` counter lives
  ;; here (the host's `str "tab-" id` id scheme is reproduced via
  ;; `string-from-i64`), and `set-url-input`/`finish-navigation`'s assoc-onto-
  ;; maps is document-assoc (3-arg: doc, key, value — or doc, index, value on
  ;; a vector). The host keeps nothing this module needs; parity with
  ;; test/browser/chrome_test.cljk's two fixtures is pinned in `main`:
  ;;   url-bar-commit-produces-navigation-intent
  ;;   tabs-can-be-focused-and-finished
  (:export [empty-chrome new-tab active-tab-index focus-tab set-url-input
            commit-url finish-navigation main]))

;; --- accessors (html_document.kotoba option idiom) -------------------------

(defn get-d [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))

(defn get-s [d :document k :keyword] :string
  (option-or (document-string-value (get-d d k)) ""))

(defn get-k [d :document k :keyword] :keyword
  (option-or (document-keyword-value (get-d d k)) :missing))

(defn get-i [d :document k :keyword] :i64
  (option-or (document-i64-value (get-d d k)) 0))

;; --- constructors ----------------------------------------------------------

(defn empty-chrome [] :document
  ;; {:chrome/tabs [] :chrome/active-tab-id nil :chrome/next-tab-id 1
  ;;  :chrome/url-input ""}
  (document-map :chrome/tabs (document-vector)
                :chrome/active-tab-id (document-string "")
                :chrome/next-tab-id (document-i64 1)
                :chrome/url-input (document-string "")))

(defn new-tab [chrome :document url :string] :document
  ;; (update chrome :chrome/next-tab-id inc) + conj a tab + focus it.
  ;; id = (str "tab-" next-tab-id); a nil url history seed -> empty history.
  (let [n (get-i chrome :chrome/next-tab-id)
        id (string-concat "tab-" (string-from-i64 n))
        hist (if (string=? url "")
               (document-vector)
               (document-vector-conj (document-vector) (document-string url)))
        tab (document-map :tab/id (document-string id)
                          :tab/url (document-string url)
                          :tab/title (document-string "")
                          :tab/history hist
                          :tab/status (document-keyword :idle))
        tabs (document-vector-conj (get-d chrome :chrome/tabs) tab)]
    (document-assoc
     (document-assoc
      (document-assoc
       (document-assoc chrome :chrome/tabs tabs)
       :chrome/next-tab-id (document-i64 (+ n 1)))
      :chrome/active-tab-id (document-string id))
     :chrome/url-input (document-string url))))

(defn tab-count [chrome :document] :i64
  (document-count (get-d chrome :chrome/tabs)))

(defn tab-at [chrome :document i :i64] :document
  (option-or (document-vector-at (get-d chrome :chrome/tabs) i)
             (document-null)))

(defn tab-at-doc [tabs :document i :i64] :document
  (option-or (document-vector-at tabs i) (document-null)))

(defn scan-for-id [tabs :document want :string i :i64 n :i64] :i64
  ;; Index of the first tab whose :tab/id is `want`, or -1.
  (if (>= i n) (- 0 1)
      (if (string=? (get-s (tab-at-doc tabs i) :tab/id) want)
        i
        (scan-for-id tabs want (+ i 1) n))))

(defn active-tab-index [chrome :document] :i64
  ;; (first (filter #(= (:tab/id %) (:chrome/active-tab-id chrome)) tabs)) --
  ;; index of the first tab whose id matches the active id, -1 when none.
  (scan-for-id (get-d chrome :chrome/tabs)
               (get-s chrome :chrome/active-tab-id)
               0 (tab-count chrome)))

(defn focus-tab [chrome :document tab-id :string] :document
  ;; (focus-tab chrome tab-id): focus an existing tab and load its URL into
  ;; the input; an unknown id leaves chrome unchanged (host: `chrome`).
  (let [i (scan-for-id (get-d chrome :chrome/tabs) tab-id 0 (tab-count chrome))]
    (if (< i 0)
      chrome
      (let [tab (tab-at-doc (get-d chrome :chrome/tabs) i)]
        (document-assoc
         (document-assoc chrome
                         :chrome/active-tab-id (document-string tab-id))
         :chrome/url-input (document-string (get-s tab :tab/url)))))))

(defn set-url-input [chrome :document value :string] :document
  (document-assoc chrome :chrome/url-input (document-string value)))

(defn tabs-assoc [tabs :document i :i64 tab :document k :i64 acc :document] :document
  ;; Rebuild `tabs` with index `i` replaced by `tab` (document-assoc has no
  ;; vector-index write: its 3-arg key form takes a keyword/document only).
  ;; Forward recursion carrying the built prefix in `acc`.
  (if (> k (document-count tabs))
    acc
    (if (= k i)
      (tabs-assoc tabs i tab (+ k 1) (document-vector-conj acc tab))
      (tabs-assoc tabs i tab (+ k 1)
                  (document-vector-conj acc (tab-at-doc tabs k))))))

(defn updated-tab [tab :document url :string hist :document] :document
  ;; commit-url's mapv branch for the active tab: url + :loading + history conj.
  (document-assoc
   (document-assoc
    (document-assoc tab
                    :tab/url (document-string url))
    :tab/status (document-keyword :loading))
   :tab/history (document-vector-conj hist (document-string url))))

(defn update-tab [tabs :document i :i64 tab :document url :string hist :document] :document
  (tabs-assoc tabs i (updated-tab tab url hist) 0 (document-vector)))

(defn commit-url [chrome :document] :document
  ;; The host returns {:chrome <updated> :navigation {:tab/id .. :url ..}}.
  ;; Two values cannot come back from one pure fn here, so the updated chrome
  ;; carries the navigation intent in a :chrome/last-navigation entry (the
  ;; same one-value-carrier rule the profile port documented); readers take
  ;; the intent off the chrome. Active tab flips to :loading and its history
  ;; grows by the committed URL, exactly as the host's mapv branch does.
  (let [url (get-s chrome :chrome/url-input)
        tab-id (get-s chrome :chrome/active-tab-id)
        i (scan-for-id (get-d chrome :chrome/tabs) tab-id 0 (tab-count chrome))]
    (if (< i 0)
      chrome
      (let [tab (tab-at-doc (get-d chrome :chrome/tabs) i)
            hist (get-d tab :tab/history)
            nav (document-map :tab/id (document-string tab-id)
                              :url (document-string url))
            tabs (update-tab (get-d chrome :chrome/tabs) i tab url hist)]
        (document-assoc
         (document-assoc chrome
                         :chrome/tabs tabs)
         :chrome/last-navigation nav)))))

(defn finish-navigation [chrome :document tab-id :string title :string status :keyword] :document
  ;; (finish-navigation chrome tab-id {:title t :status s}): unknown ids are
  ;; a no-op; found tabs get title + status (host defaults status to :idle;
  ;; :missing here is the accessor's not-found keyword and maps to :idle).
  (let [i (scan-for-id (get-d chrome :chrome/tabs) tab-id 0 (tab-count chrome))]
    (if (< i 0)
      chrome
      (let [tab (tab-at-doc (get-d chrome :chrome/tabs) i)
            st (if (= status :missing) :idle status)
            new-tab-doc (document-assoc
                         (document-assoc tab
                                         :tab/title (document-string title))
                         :tab/status (document-keyword st))
            tabs (tabs-assoc (get-d chrome :chrome/tabs) i new-tab-doc 0 (document-vector))]
        (document-assoc chrome :chrome/tabs tabs)))))

(defn main [] :i64
  ;; Self-check reproducing test/browser/chrome_test.cljk's two fixtures.
  ;; Returns 0 when every probe reads correctly (sum of failing probes).
  (let [;; fixture 1: url-bar-commit-produces-navigation-intent
        c1 (set-url-input (new-tab (empty-chrome) "kotoba://home")
                          "https://example.com")
        c1b (commit-url c1)
        a1 (tab-at c1b (active-tab-index c1b))
        p-url (if (string=? (get-s c1b :chrome/url-input) "https://example.com") 0 1)
        p-nav (if (string=? (get-s (get-d c1b :chrome/last-navigation) :url)
                            "https://example.com") 0 1)
        p-status (if (= (get-k a1 :tab/status) :loading) 0 1)
        p-hist (if (= (document-count (get-d a1 :tab/history)) 2) 0 1)
        p-hist0 (if (string=? (get-s (tab-at-doc (get-d a1 :tab/history) 0) :tab/none)
                              "kotoba://home") 0 1)
        ;; fixture 2: tabs-can-be-focused-and-finished
        c2 (new-tab (new-tab (empty-chrome) "kotoba://one") "kotoba://two")
        first-id (get-s (tab-at c2 0) :tab/id)
        c2b (finish-navigation (focus-tab c2 first-id) first-id "One" :idle)
        a2 (tab-at c2b (active-tab-index c2b))
        p-focus (if (string=? (get-s c2b :chrome/active-tab-id) first-id) 0 1)
        p-title (if (string=? (get-s a2 :tab/title) "One") 0 1)
        p-input (if (string=? (get-s c2b :chrome/url-input) "kotoba://one") 0 1)]
    (+ p-url (+ p-nav (+ p-status (+ p-hist (+ p-hist0
      (+ p-focus (+ p-title p-input)))))))))
