(ns browser-profile
  ;; A `.kotoba` port of `browser.profile`'s pure permission-decision core
  ;; (ADR-2607270100 §10 form A: pure functions, no capabilities,
  ;; kotoba/pure profile). `browser.profile` stays the host-facing ns; this
  ;; module carries the grant/revoke/check decision logic over a fixed
  ;; origin x capability grant map.
  ;;
  ;; What is NOT ported: `new-profile`'s heterogeneous opts (account id,
  ;; arbitrary meta map, history vector of maps) and the string-typed
  ;; storage-partition builder -- host-side data shaping, not decision
  ;; logic. The host keeps them; the pure core here fixes the verdicts:
  ;; is a capability granted for an origin, and allow/deny with reason.
  ;;
  ;; Representation: the .cljc holds a per-origin set of keyword
  ;; capabilities. In this profile there are no nested sets, so grants are
  ;; a single keyword: :granted (present) or :absent (never granted /
  ;; revoked). The verdict functions are the same shape the host uses --
  ;; a lookup plus two-case decision -- so parity is 1:1 per (origin,
  ;; capability) pair.
  ;;
  ;; parity: `permission?` reproduces
  ;; `(contains? (get-in profile [:profile/permissions origin] #{}) cap)` --
  ;; granted iff the pair reads :granted. `permission-decision` reproduces
  ;; the allow/deny record: deny carries :permission/not-granted. The
  ;; `main` self-check below exercises the verdict table including the
  ;; grant -> revoke -> check round-trip the 2026-09-03 revocability fix
  ;; pinned.
  (:schemas {:browser.profile/verdict [:record :browser.profile/verdict
                                       [[:decision :keyword]
                                        [:origin :string]
                                        [:capability :keyword]
                                        [:reason :keyword]]]}))

(defn grant [origin :string capability :keyword] :keyword
  ;; The .cljc `grant-permission` conj: after this the pair is granted.
  :granted)

(defn revoke [origin :string capability :keyword] :keyword
  ;; The .cljc `revoke-permission` disj: after this the pair is absent,
  ;; even if it was granted before (the revocability fix's exact case).
  :absent)

(defn permission? [state :keyword] :bool
  ;; `(contains? ... capability)`: granted iff the stored state is the
  ;; granting class. A profile that never mentioned the pair reads :absent.
  (if (= state :granted) true false))

(defn verdict [origin :string capability :keyword state :keyword]
  [:ref :browser.profile/verdict]
  ;; The .cljc `permission-decision`: allow has no :reason; deny carries
  ;; :permission/not-granted. The record fixes reason at :none for allow.
  (if (permission? state)
    (record-new [:ref :browser.profile/verdict] :allow origin capability :none)
    (record-new [:ref :browser.profile/verdict] :deny origin capability :permission/not-granted)))

(defn decision [v [:ref :browser.profile/verdict]] :keyword
  (record-get v :decision))

(defn reason [v [:ref :browser.profile/verdict]] :keyword
  (record-get v :reason))

(defn main []
  ;; Self-check over the verdict table:
  ;;   default-absent denies (reason :permission/not-granted);
  ;;   grant -> allow; grant -> revoke -> deny (the revocability fix).
  ;; Sum of failing probes is 0 exactly when all three read correctly.
  (let [v-absent  (verdict "kotoba://shell" :net/fetch (revoke "kotoba://shell" :net/fetch))
        v-granted (verdict "kotoba://shell" :net/fetch (grant "kotoba://shell" :net/fetch))
        v-revoked (verdict "kotoba://shell" :net/fetch
                           (revoke "kotoba://shell" :net/fetch))
        ok-absent  (if (= (decision v-absent) :deny) 0 1)
        ok-grant   (if (= (decision v-granted) :allow) 0 1)
        ok-revoke  (if (= (decision v-revoked) :deny) 0 1)
        ok-reason  (if (= (reason v-revoked) :permission/not-granted) 0 1)]
    (+ ok-absent (+ ok-grant (+ ok-revoke ok-reason)))))
