(ns browser-account
  ;; A `.kotoba` port of `browser.account` (ADR-2607270100 §10 form A: pure
  ;; functions, no capabilities, kotoba/pure profile). `browser.account` stays
  ;; the host-facing ns; this module is the pure decision core -- the trust
  ;; classes and the verified?/trust grant check -- gated JVM-free.
  ;;
  ;; What is NOT ported: `new-account`'s heterogeneous `:account/meta`
  ;; (`dissoc` of the full opts map) and arbitrary `keys` vector are host-side
  ;; data, not decision logic, and cannot be expressed in kotoba's typed
  ;; record profile. The host keeps them; the pure core here fixes the fields
  ;; the verdicts depend on (id, display-name, trust).
  ;;
  ;; parity: `verified?` reproduces the host's
  ;; `(contains? #{:verified :trusted} (:account/trust account))` -- a
  ;; :verified or :trusted account is verified; every other trust class
  ;; (default :local) is not. The `main` self-check below exercises the
  ;; verdict table.
  (:schemas {:browser.account/account [:record :browser.account/account
                                       [[:id :string]
                                        [:display-name :string]
                                        [:trust :keyword]
                                        [:verified :bool]]]}))

(defn verified?-of-trust [t :keyword] :bool
  ;; `(contains? #{:verified :trusted} t)` hand-written: no sets of keywords
  ;; in this profile, so an explicit two-case branch over the two granting
  ;; classes. Nested if, not or: or yields i64 in this profile.
  (if (= t :verified) true
      (if (= t :trusted) true false)))

(defn account
  ;; Resolved form of the host new-account's defaulting: id defaults to
  ;; "local", display-name to "Local User", trust to :local. The :verified
  ;; field is the precomputed verdict so record consumers need no re-derive.
  [id :string display-name :string trust :keyword]
  [:ref :browser.account/account]
  (let [i (if (= (string-length id) 0) "local" id)
        d (if (= (string-length display-name) 0) "Local User" display-name)]
    (record-new [:ref :browser.account/account]
                i d trust (verified?-of-trust trust))))

(defn id-of [a [:ref :browser.account/account]] :string
  (record-get a :id))

(defn display-name-of [a [:ref :browser.account/account]] :string
  (record-get a :display-name))

(defn trust-of [a [:ref :browser.account/account]] :keyword
  (record-get a :trust))

(defn verified? [a [:ref :browser.account/account]] :bool
  ;; The host's `(contains? #{:verified :trusted} (:account/trust account))`,
  ;; read off the precomputed verdict (same decision as re-deriving here).
  (record-get a :verified))

(defn main []
  ;; Self-check over the verdict table: :verified and :trusted grant (1 each),
  ;; a plain :local account does not; id falls back to "local" and
  ;; display-name to "Local User". Sum of three verdict-booleans is 2 exactly
  ;; when the two granting classes read true and :local reads false.
  (let [c-verified (account "u1" "Jun" :verified)
        c-trusted  (account "u2" "" :trusted)
        c-local    (account "" "" :local)
        a-verified (verified? c-verified)
        a-trusted  (verified? c-trusted)
        a-local    (verified? c-local)
        ok-id      (if (string=? (id-of c-local) "local") 0 1)
        ok-disp    (if (string=? (display-name-of c-local) "Local User") 0 1)]
    (if (= (+ (if a-verified 1 0)
              (if a-trusted 1 0)
              (if a-local 1 0)) 2)
      (+ ok-id ok-disp)
      99)))