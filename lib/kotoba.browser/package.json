{
  "name": "kotoba-browser",
  "private": true,
  "version": "0.1.0",
  "description": "kotoba-lang/browser QuickJS/QuickJS-NG WASM guest execution build pipeline.",
  "scripts": {
    "compile:node-test": "amu compile --target wasm32-browser node-test",
    "compile:browser-demo": "amu compile --target wasm32-browser browser-demo",
    "watch:browser-demo": "amu compile --target wasm32-browser browser-demo",
    "serve:browser-demo": "node scripts/demo-server.js",
    "demo:browser-demo": "npm run compile:browser-demo && npm run serve:browser-demo",
    "test:cljs": "npm run compile:node-test && node target/node-tests.js",
    "test:clj": "kbb -M:test",
    "test:ecma262-differential": "kbb --backend sci test/runtime-differential.cljk",
    "test:ecma262-end-to-end": "kbb --backend sci --classpath \"src:../htmldom/src:../cssom/src:../dom-gpu/src:../org-w3-aria/src\" test/dom-end-to-end.cljk",
    "compile:smoke": "amu compile --target wasm32-browser visual-smoke",
    "compile:webgpu-smoke": "amu compile --target wasm32-browser webgpu-smoke",
    "smoke:visual": "npm run compile:smoke && kbb -M:smoke visual",
    "smoke:webgpu": "npm run compile:webgpu-smoke && kbb -M:smoke webgpu",
    "check": "npm run test:clj && npm run test:cljs && npm run smoke:visual && npm run smoke:webgpu"
  },
  "dependencies": {
    "quickjs-emscripten-core": "^0.32.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0"
  },
  "devDependencies": {
    "shadow-cljs": "^2.28.20"
  }
}
