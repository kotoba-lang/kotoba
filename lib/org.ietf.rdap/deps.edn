{:paths ["src"]
 ;; kotoba-lang/json serializes the response data; kotoba-lang/srs supplies the
 ;; registry state these responses project. Both .cljc with no third-party deps.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/json {:local/root "../kotoba.json"}
        io.github.kotoba-lang/srs {:local/root "../kotoba.srs"}}
 :aliases
 {:test {:extra-paths ["test"]}
  ;; local checkouts for workspace development (orgs/kotoba-lang/*)
  :dev {:override-deps {io.github.kotoba-lang/json {:local/root "../json"}
                        io.github.kotoba-lang/srs {:local/root "../srs"}}}}}
