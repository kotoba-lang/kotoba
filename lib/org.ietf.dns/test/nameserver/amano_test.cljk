(ns nameserver.amano-test
  (:require [kotoba.test :refer [deftest is testing]]
            [nameserver.amano :as amano]
            [nameserver.resolver :as resolver]))

(deftest amano-resolver-test
  (let [fake-db {"amano/dns/app" {:cid "bafyreib2g5g55g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5"}}
        r (amano/amano-resolver (fn [ref] (get fake-db ref)) "amano." "ipfs.kotobase.net")]
    (testing "TXT query returns dnslink record"
      (let [res (resolver/-resolve r "app.amano." "TXT" "IN")]
        (is (= :ok (:status res)))
        (is (true? (:aa? res)))
        (is (= "dnslink=/ipfs/bafyreib2g5g55g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5"
               (get-in res [:answers 0 :zone/rdata :zone/text])))))

    (testing "_dnslink prefix query works"
      (let [res (resolver/-resolve r "_dnslink.app.amano." "TXT" "IN")]
        (is (= :ok (:status res)))
        (is (= "dnslink=/ipfs/bafyreib2g5g55g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5"
               (get-in res [:answers 0 :zone/rdata :zone/text])))))

    (testing "CNAME / A query returns gateway CNAME target"
      (let [res (resolver/-resolve r "app.amano." "CNAME" "IN")]
        (is (= :ok (:status res)))
        (is (= "bafyreib2g5g55g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5.ipfs.kotobase.net."
               (get-in res [:answers 0 :zone/rdata :zone/target])))))

    (testing "Unknown domain returns NXDOMAIN"
      (let [res (resolver/-resolve r "missing.amano." "TXT" "IN")]
        (is (= :nxdomain (:status res)))))

    (testing "Non-matching suffix is refused"
      (let [res (resolver/-resolve r "example.com." "TXT" "IN")]
        (is (= :refused (:status res)))))))
