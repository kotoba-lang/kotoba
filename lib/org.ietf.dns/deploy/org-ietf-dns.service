# systemd unit for running org-ietf-dns as a standalone nameserver process.
# Install: copy to /etc/systemd/system/org-ietf-dns.service, edit the paths
# below, then `systemctl daemon-reload && systemctl enable --now org-ietf-dns`.
#
# Binding UDP/TCP port 53 needs CAP_NET_BIND_SERVICE (or root). This unit
# grants the capability to the java process directly via
# AmbientCapabilities so the service can run as an unprivileged user --
# see README "Running for real" for the setcap alternative if you'd rather
# not use a systemd-managed capability.

[Unit]
Description=org-ietf-dns nameserver
After=network.target

[Service]
Type=simple
User=nameserver
Group=nameserver
WorkingDirectory=/opt/org-ietf-dns
Environment=NAMESERVER_CONFIG=/etc/org-ietf-dns/config.edn
ExecStart=/usr/bin/clojure -M -m nameserver.main
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
