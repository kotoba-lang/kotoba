;; RFC 1035 §4.1.1 DNS header flags, as safe Kotoba.
;;
;; The two flag bytes and the checks a resolver makes on a reply before
;; believing it. Name compression, the question section and the RR bodies stay
;; in .cljc -- those walk byte vectors.
;;
;; Everything here takes and returns the PACKED representation, which is also
;; the wire representation, so no `:bool` parameter appears and the module
;; reaches the native targets despite containing shifts (kotoba-lang/amu#611
;; refuses that pair). Booleans are returned, never taken; a returned `:bool`
;; is fine alongside a shift.
;;
;; `accept-reply?` is the reason this file is worth having. A resolver that
;; does not check the id and the QR bit will believe any UDP datagram that
;; reaches its port, which is off-path cache poisoning with no forgery
;; required. It is the same check `dhcp.client` makes on the transaction id,
;; for the same reason and against the same attacker.
;;
;; Checked against `nameserver.wire` in test/nameserver/header_kotoba_parity_test.cljk.

(ns nameserver.header-core
  (:export [flags-b1 flags-b2 qr-response? opcode-of authoritative? truncated?
            recursion-desired? recursion-available? rcode-of
            accept-reply? rcode-is-error?]))

(def opcode-query 0)

(def rcode-noerror 0)
(def rcode-formerr 1)
(def rcode-servfail 2)
(def rcode-nxdomain 3)
(def rcode-notimp 4)
(def rcode-refused 5)

;; ── the two flag bytes ────────────────────────────────────────────────────
;; Built from a packed request rather than from separate booleans: the caller
;; already holds them as bits, and taking them apart only to put them back is
;; a second encoding of the same layout.
;;
;;   bit 0  RD   bit 1  TC   bit 2  AA   bits 3-6  opcode   bit 7  QR
;;   bit 8  RA   bits 12-15 rcode  (in the packed i64 this file uses)

(defn flags-b1 [packed :i64] :i64
  (bit-or (i64-shift-left (bit-and (u64-shift-right packed 7) 1) 7)
          (bit-or (i64-shift-left (bit-and (u64-shift-right packed 3) 15) 3)
                  (bit-or (i64-shift-left (bit-and (u64-shift-right packed 2) 1) 2)
                          (bit-or (i64-shift-left (bit-and (u64-shift-right packed 1) 1) 1)
                                  (bit-and packed 1))))))

(defn flags-b2 [packed :i64] :i64
  (bit-or (i64-shift-left (bit-and (u64-shift-right packed 8) 1) 7)
          (bit-and (u64-shift-right packed 12) 15)))

;; ── reading them back ─────────────────────────────────────────────────────

(defn qr-response? [b1 :i64] :bool (= (bit-and (u64-shift-right b1 7) 1) 1))
(defn opcode-of [b1 :i64] :i64 (bit-and (u64-shift-right b1 3) 15))
(defn authoritative? [b1 :i64] :bool (= (bit-and (u64-shift-right b1 2) 1) 1))
(defn truncated? [b1 :i64] :bool (= (bit-and (u64-shift-right b1 1) 1) 1))
(defn recursion-desired? [b1 :i64] :bool (= (bit-and b1 1) 1))
(defn recursion-available? [b2 :i64] :bool (= (bit-and (u64-shift-right b2 7) 1) 1))
(defn rcode-of [b2 :i64] :i64 (bit-and b2 15))

;; ── what a resolver may believe ───────────────────────────────────────────

;; Three conditions, and dropping any one of them is a different vulnerability.
;;
;; The id must match the query's, or an attacker who can reach this port
;; supplies the answer without being on the path.
;;
;; QR must be set, or a query looks like its own reply.
;;
;; The opcode must match, or a reply to a different kind of request is read as
;; an answer to this one.
;;
;; Matching the question section as well is the caller's job -- it is a byte
;; comparison over the wire format, not a header decision -- and it is required
;; too. This function is necessary and not sufficient, which is why it is named
;; `accept-reply?` rather than `valid?`.
(defn accept-reply? [reply-id :i64 query-id :i64 b1 :i64 query-opcode :i64] :bool
  (and (= reply-id query-id)
       (and (qr-response? b1) (= (opcode-of b1) query-opcode))))

;; NXDOMAIN is an answer, not an error: the name does not exist and that is
;; the fact the caller asked for. A resolver that retries on it walks its whole
;; server list for every typo.
(defn rcode-is-error? [rcode :i64] :bool
  (and (not (= rcode rcode-noerror)) (not (= rcode rcode-nxdomain))))
