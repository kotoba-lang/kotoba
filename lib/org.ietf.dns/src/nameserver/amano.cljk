(ns nameserver.amano
  "Amano Sovereign App-Chain DNS resolver.
  Bridges RFC 1035 wire DNS queries directly to the live amano BFT consensus
  state (inga-node ref plane) for Content-Addressed Web resolution.
  
  Domain shape:
    `<name>.amano.` or `_dnslink.<name>.amano.`
  
  Answers:
    TXT   -> dnslink=/ipfs/{cid}
    CNAME -> {cid}.ipfs.kotobase.net. (or custom gateway host)
    A     -> Gateway IP (if configured)"
  (:require [kotoba.lang.text :as str]
            [nameserver.names :as names]
            [nameserver.resolver :as resolver]
            #?(:clj [kotoba.json :as json])))

(defn amano-name
  "Extract the target label from `<label>.amano.` or `_dnslink.<label>.amano.`."
  [qname suffix]
  (let [s (if (str/ends-with? suffix ".") suffix (str suffix "."))]
    (when (str/ends-with? qname s)
      (let [prefix (subs qname 0 (- (count qname) (count s)))
            labels (names/split-labels prefix)]
        (case (count labels)
          1 (first labels)
          2 (when (= "_dnslink" (first labels)) (second labels))
          nil)))))

(defrecord AmanoChainResolver [fetch-ref-fn suffix gateway-host]
  resolver/IResolver
  (-resolve [_ qname qtype _qclass]
    (if-let [name (amano-name qname suffix)]
      (let [ref (str "amano/dns/" name)
            head (try (fetch-ref-fn ref) (catch #?(:clj Exception :cljs :default) _ nil))]
        (if-let [cid (or (get head :cid) (get head "cid"))]
          (cond
            (= "TXT" qtype)
            {:status :ok :aa? true
             :answers [{:zone/name qname :zone/ttl 60 :zone/class "IN" :zone/type "TXT"
                        :zone/rdata {:zone/text (str "dnslink=/ipfs/" cid)}}]
             :authority [] :additional []}

            (and (#{"A" "AAAA" "CNAME"} qtype) gateway-host)
            {:status :ok :aa? true
             :answers [{:zone/name qname :zone/ttl 60 :zone/class "IN" :zone/type "CNAME"
                        :zone/rdata {:zone/target (str cid "." gateway-host ".")}}]
             :authority [] :additional []}

            :else
            {:status :nodata :aa? true :answers [] :authority [] :additional []})
          {:status :nxdomain :aa? true :answers [] :authority [] :additional []}))
      {:status :refused :aa? false :answers [] :authority [] :additional []})))

(defn amano-resolver
  "`fetch-ref-fn` — (fn [ref-name] -> {:cid \"...\"})
   `suffix` — domain suffix (default \"amano.\")
   `gateway-host` — gateway host for CNAME generation (default \"ipfs.kotobase.net\")"
  ([fetch-ref-fn]
   (amano-resolver fetch-ref-fn "amano." "ipfs.kotobase.net"))
  ([fetch-ref-fn suffix gateway-host]
   (->AmanoChainResolver fetch-ref-fn suffix gateway-host)))
