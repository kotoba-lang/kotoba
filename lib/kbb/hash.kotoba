(ns kbb.hash
  "kbb.hash — SHA-256 for kbb scripts and Kotoba commands. Wire id 3
  (:hash/sha256). A script says `(hash/sha256-string s)`; the wire id and
  the typed request/result shape live HERE, once, so a script never spells
  a `typed-cap-call` and never learns a wire id -- the same rule kbb.io and
  kbb.fs follow.

  The capability carries `:string -> :string` (one of the four generic type
  pairs the native gate admits for `typed-cap-call`): the request is the
  UTF-8 text, the result is the 64-character lowercase hex digest.

  There is no resource scope (like :io/write). The digest of any text
  crosses no boundary; the authority the grant carries is exactly \"may
  compute a digest\". The request is capped by the host at the guest
  string limit (65,536 bytes) — an over-limit request is refused with a
  :denied receipt, fail-closed.

  Consumed through the project route: `--source-path lib`."
  (:export [sha256-string self-check main]))

(defn sha256-string [s :string] :string
  (typed-cap-call :hash/sha256 :string :string s))

(defn self-check [] :i64
  (+ (if (= 64 (string-byte-length (sha256-string "kagi"))) 0 1)
     (if (= 64 (string-byte-length (sha256-string ""))) 0 1)))

(defn main [] :i64 (self-check))
