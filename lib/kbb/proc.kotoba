;; kbb.proc — run ONE granted program. Wire id 20 (:process/spawn).
;;
;; The request is the ONE wire-20 grammar every host answers (kotoba-lang
;; lang/capability-catalog.edn :process/spawn, 2026-09-25):
;;
;;   "<program>[ARG_SEP<arg>]..."
;;
;; where <program> is one of the canonical absolute paths the grant names
;; (:kotoba.policy/spawn :programs for the kbb js host, the compile policy's
;; :spawn for the Linux static ELF, KEXE_CAP_RESOURCES_20 for the kexe
;; loader), or -- when the grant says :path-lookup true -- the last segment of
;; one. $PATH is never read. Until 2026-09-25 the js host took a decimal INDEX
;; into a policy invocation table instead; that grammar is retired.
;;
;; The host answers "<exit>\n<stdout>" -- both, because a process's output is
;; information the caller asked the capability for, and the wire carries one
;; value; the exit field is -1 when a signal ended the child. A refusal
;; (program not granted, argv or output budget, the 10 s deadline, ...) is
;; the host's, by name: the guest traps. That encoding is read HERE, once, so
;; no script spells it.
(ns kbb.proc
  (:export [run exit-code stdout stdout-line-count ok? exec]))

(defn run [request :string] :string
  (typed-cap-call :process/spawn :string :string request))

(defn head-index [r :string] :i64
  (string-index-of r "\n"))

;; The exit status. Non-negative digits only; the host writes -1 when the
;; process produced no status, and that answers -1 here.
(defn digit-val [c :string] :i64
  (if (string=? c "0") 0
    (if (string=? c "1") 1
      (if (string=? c "2") 2
        (if (string=? c "3") 3
          (if (string=? c "4") 4
            (if (string=? c "5") 5
              (if (string=? c "6") 6
                (if (string=? c "7") 7
                  (if (string=? c "8") 8
                    (if (string=? c "9") 9 -1)))))))))))

(defn digits [s :string i :i64 n :i64 acc :i64] :i64
  (if (>= i n)
    acc
    (let [d (digit-val (string-substring s i (+ i 1)))]
      (if (< d 0)
        acc
        (digits s (+ i 1) n (+ (* acc 10) d))))))

(defn exit-code [r :string] :i64
  (let [h (head-index r)]
    (if (< h 0)
      -1
      (if (< (digit-val (string-substring r 0 1)) 0)
        -1
        (digits r 0 h 0)))))

(defn stdout [r :string] :string
  (let [h (head-index r)]
    (if (< h 0)
      ""
      (string-substring r (+ h 1) (string-byte-length r)))))

;; Lines in stdout, counting a trailing newline as terminating the last line
;; (so `printf 'a\nb\n'` answers 2, which is what `wc -l` answers for the
;; same bytes).
(defn count-newlines [s :string acc :i64] :i64
  (let [i (string-index-of s "\n")]
    (if (< i 0)
      acc
      (count-newlines (string-substring s (+ i 1) (string-byte-length s)) (+ acc 1)))))

(defn stdout-line-count [r :string] :i64
  (count-newlines (stdout r) 0))

;; The exit status only, for callers that do not need stdout (kept numeric so
;; arithmetic over `exec` keeps working).
(defn exec [request :string] :i64
  (exit-code (run request)))

(defn ok? [request :string] :bool
  (if (= (exec request) 0) true false))
