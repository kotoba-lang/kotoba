;; kbb.proc — run ONE allowlisted invocation by grant INDEX. Wire id 20
;; (:process/spawn). The guest supplies zero command bytes: argv, cwd and
;; timeout are policy literals (:kotoba.policy/proc-exec-invocations, the
;; kbb v1 table); the index names a row.
;;
;; The host answers "<exit>\n<stdout>" — both, because a process's output is
;; information the caller asked the capability for, and the wire carries one
;; value. This is the same encoding :git/run uses (kbb.git decodes it); it
;; landed for proc on 2026-09-07 (jvm-retire). Before that the host captured
;; stdout and discarded it, and a script could see only the exit status —
;; which is still what `exec` below answers, for the callers that only want
;; that. That encoding is read HERE, once, so no script spells it.
;;
;; Backend note (2026-09-07): the js host implements this (bin/kbb_js.cljk,
;; wire 20, "<exit>\n<stdout>"); the native loader's wire-20 provider is
;; still pending (ADR-2609051100 task 5), so a script using kbb.proc runs on
;; `--backend js`.
(ns kbb.proc
  (:export [run exit-code stdout stdout-line-count ok? exec]))

(defn run [grant-index :string] :string
  (typed-cap-call :process/spawn :string :string grant-index))

(defn head-index [r :string] :i64
  (string-index-of r "\n"))

;; The exit status. Non-negative digits only; the host writes -1 when the
;; process produced no status, and that answers -1 here.
(defn digit-val [c :string] :i64
  (if (string=? c "0") 0
    (if (string=? c "1") 1
      (if (string=? c "2") 2
        (if (string=? c "3") 3
          (if (string=? c "4") 4
            (if (string=? c "5") 5
              (if (string=? c "6") 6
                (if (string=? c "7") 7
                  (if (string=? c "8") 8
                    (if (string=? c "9") 9 -1)))))))))))

(defn digits [s :string i :i64 n :i64 acc :i64] :i64
  (if (>= i n)
    acc
    (let [d (digit-val (string-substring s i (+ i 1)))]
      (if (< d 0)
        acc
        (digits s (+ i 1) n (+ (* acc 10) d))))))

(defn exit-code [r :string] :i64
  (let [h (head-index r)]
    (if (< h 0)
      -1
      (if (< (digit-val (string-substring r 0 1)) 0)
        -1
        (digits r 0 h 0)))))

(defn stdout [r :string] :string
  (let [h (head-index r)]
    (if (< h 0)
      ""
      (string-substring r (+ h 1) (string-byte-length r)))))

;; Lines in stdout, counting a trailing newline as terminating the last line
;; (so `printf 'a\nb\n'` answers 2, which is what `wc -l` answers for the
;; same bytes).
(defn count-newlines [s :string acc :i64] :i64
  (let [i (string-index-of s "\n")]
    (if (< i 0)
      acc
      (count-newlines (string-substring s (+ i 1) (string-byte-length s)) (+ acc 1)))))

(defn stdout-line-count [r :string] :i64
  (count-newlines (stdout r) 0))

;; The exit status only, for callers that do not need stdout (kept numeric so
;; arithmetic over `exec` keeps working).
(defn exec [grant-index :string] :i64
  (exit-code (run grant-index)))

(defn ok? [grant-index :string] :bool
  (if (= (exec grant-index) 0) true false))
