;; kbb.fs — the filesystem half of the kbb script library (ADR-2607181900
;; gate item ①, js/native backends). A script says `(fs/read-file path)` or
;; `(fs/write-file path content)`; the wire id (35 = :fs/app-data,
;; kotoba-lang capability-catalog) and the typed request/result shape live
;; HERE, once, so a script never spells a `typed-cap-call` and never learns
;; a wire id.
;;
;; All three forms ride the same `:string -> :string` capability:
;;   read   request = path                     result = the file's content
;;   write  request = path ++ "WRITE_SEP" ++ content
;;                                             result = the content written back
;;   range  request = path ++ "RANGE_SEP" ++ offset ++ ":" ++ length
;;                                             result = exactly those bytes
;; `WRITE_SEP` is an ASCII token, not a control character: Kotoba source
;; cannot emit a control char and has no char-to-string builtin, so the
;; separator has to be something `string-concat` can build. The HOST finds
;; the first occurrence and refuses the request if the token occurs again
;; (i.e. content containing "WRITE_SEP" cannot be written through this
;; capability -- fail-closed, no escaping). The path is resolved by the host
;; against the policy's :fs/app-data scope; a new file is judged by its
;; parent directory, an existing one by its own realpath; outside the scope,
;; onto a directory, through a symlink, or into a missing parent the host
;; refuses before any byte is written. Size: the request is ONE guest string,
;; so path + 9 + content must fit the 65536-byte string limit -- one byte
;; over and the artifact itself refuses (`string-too-large`) before the
;; host is asked (measured on js 2026-09-07: a 137-byte path carries at
;; most 65390 bytes of content).
;;
;; Backends that implement the write form: js (bin/kbb_js.cljs, measured by
;; test/kotoba/kbb_js_write_test.clj) and native (amu tools/kexe_loader.c
;; fs_app_data_write_provider, commit 6cca3852 -- per that commit, not run
;; here). The header of this file said "read-only on purpose" until both
;; existed; a library offering write on one backend would have been a
;; portability lie.
;;
;; The range form (2026-09-07) exists because the whole-file read cannot hand
;; back a file larger than one guest string (65,536 bytes; on native the
;; loader's string pool is the same size): `read-range` answers exactly the
;; window [offset, offset+length). The host REFUSES rather than shortens --
;; a window that leaves the file, a length over the string limit, or a window
;; whose bytes are not UTF-8 (it cut a code point) -- so a caller reading a
;; file one window at a time never sees a silently short piece. Both hosts
;; implement it: js (bin/kbb_js.cljs fs-read-range!) and native
;; (kexe_loader.c fs_app_data_range_read_provider). The offset and length
;; travel as decimal text because the request is one string; `i64->text`
;; below builds that text, the guest having no number->string builtin.
;;
;; Consumed through the project route: `--source-path lib`.
(ns kbb.fs (:export [read-file read-bytes-count
                     read-range read-range-spec read-range-bytes-count i64->text
                     write-file write-ok? write-bytes-count]))

(defn read-file [path :string] :string
  (typed-cap-call :fs/app-data :string :string path))

(defn read-bytes-count [path :string] :i64
  (string-byte-length (read-file path)))

;; One decimal digit as text, cut from the digit literal: the guest has no
;; number->string builtin, so digits come from string-substring over "0..9".
(defn digit-text [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

;; Decimal text of a non-negative i64 (most-significant digit first, no sign,
;; no padding). A negative argument answers "-": that is not a decimal the
;; host accepts, so a negative offset or length is refused BY THE HOST rather
;; than silently wrapped here. Recursion depth is the digit count (<= 19).
(defn i64->text [n :i64] :string
  (if (< n 0)
    "-"
    (if (< n 10)
      (digit-text n)
      (string-concat (i64->text (quot n 10))
                     (digit-text (- n (* 10 (quot n 10))))))))

;; The range form with a preformatted "<offset>:<length>" spec -- for callers
;; whose numbers already arrive as text (an env value, a policy string); the
;; guest has no text->number builtin to go the other way.
(defn read-range-spec [path :string spec :string] :string
  (typed-cap-call :fs/app-data :string :string
                  (string-concat (string-concat path "RANGE_SEP") spec)))

;; Exactly `length` bytes of `path` starting at byte `offset`, or a host
;; refusal (see the header). `length` must be <= 65536.
(defn read-range [path :string offset :i64 length :i64] :string
  (read-range-spec path (string-concat (string-concat (i64->text offset) ":")
                                       (i64->text length))))

(defn read-range-bytes-count [path :string offset :i64 length :i64] :i64
  (string-byte-length (read-range path offset length)))

;; Writes `content` to `path` and answers the content the host wrote back.
;; `content` must not contain "WRITE_SEP" (the host refuses the whole call).
(defn write-file [path :string content :string] :string
  (typed-cap-call :fs/app-data :string :string
                  (string-concat (string-concat path "WRITE_SEP") content)))

;; True when the host handed back exactly what was sent: the contract's
;; verification (the loader returns the written content so guests can check
;; it; string=? is the byte-exact form of that check).
(defn write-ok? [path :string content :string] :bool
  (string=? (write-file path content) content))

;; The byte length the host wrote back -- the number the loader's own
;; measurement quotes (`string-byte-length (== content_length)`).
(defn write-bytes-count [path :string content :string] :i64
  (string-byte-length (write-file path content)))
