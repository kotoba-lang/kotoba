;; kbb.args — the arguments a command was invoked with. Wire id 38
;; (:cli/args). A script says `(args/count-text)` or `(args/nth i)`; the wire
;; id and the typed request/result shape live HERE, once, so a script never
;; spells a `typed-cap-call` and never learns a wire id -- the same rule
;; kbb.fs, kbb.browse and kbb.io follow.
;;
;; The capability carries `:string -> :string`, because those are the type
;; pairs kotoba.kir's native gate admits, so the index travels as decimal
;; text:
;;
;;   ""    -> the COUNT of arguments, as decimal text
;;   "<i>" -> argument i, zero-based; past the end, the empty string
;;
;; The empty request is what makes the count unambiguous: an index is a
;; non-empty decimal, so nothing can collide with it. Do NOT instead walk
;; until the first empty answer -- an empty ARGUMENT is legal and answers the
;; same thing, so that walk stops early on `cmd "" x`.
;;
;; The count comes back as TEXT and the guest has no text->number builtin, so
;; a walk counts UP and compares the RENDERED index against the rendered
;; count. `each-index?` is that comparison, named so a caller does not
;; reinvent it.
;;
;; There is no resource scope. The guest names nothing and chooses nothing;
;; the grant means exactly "may see how this process was invoked".
;;
;; Consumed through the project route: `--source-path lib`.
(ns kbb.args (:export [count-text nth-arg decimal-of at-end? first-arg]))

(defn digit-text [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

;; Decimal text of a non-negative i64, cut from a literal: the guest has no
;; number->string builtin. Recursion depth is the digit count.
(defn decimal-of [n :i64] :string
  (if (< n 10)
    (digit-text n)
    (string-concat (decimal-of (quot n 10))
                   (digit-text (- n (* 10 (quot n 10)))))))

(defn count-text [] :string
  (typed-cap-call :cli/args :string :string ""))

(defn nth-arg [i :i64] :string
  (typed-cap-call :cli/args :string :string (decimal-of i)))

;; True when index I has reached the argument count. This is the loop
;; condition: comparing rendered decimals, because the count is text.
(defn at-end? [i :i64] :bool
  (string=? (decimal-of i) (count-text)))

;; The first argument, or the empty string when there are none. Distinguish
;; those with `at-end?`, not by testing the result for emptiness -- an empty
;; first argument is legal.
(defn first-arg [] :string
  (nth-arg 0))
