;; kbb.git — run ONE allowlisted git invocation by grant INDEX. Wire id 22
;; (:git/run). The guest supplies zero git bytes: argv, cwd and timeout are
;; policy literals (:kotoba.policy/git-invocations), and the index names a
;; row. git can rewrite history and push, so the reviewable artifact is the
;; policy table, not the script.
;;
;; The host answers "<exit>\n<stdout>" -- both, because a non-zero git exit
;; is information (`git diff --quiet` says "there are changes" by exiting 1)
;; and the wire carries one value. That encoding is read HERE, once, so no
;; script spells it.
;;
;; Backend note (2026-09-07): the js host implements this; the native
;; loader has no wire-22 provider (ADR-2609051100 task 5), so a script using
;; kbb.git runs on `--backend js`.
(ns kbb.git (:export [run exit-code stdout stdout-line-count ok?]))

(defn run [grant-index :string] :string
  (typed-cap-call :git/run :string :string grant-index))

(defn head-index [r :string] :i64
  (string-index-of r "\n"))

;; The exit status. Non-negative digits only; the host writes -1 when the
;; process produced no status, and that answers -1 here.
(defn digit-val [c :string] :i64
  (if (string=? c "0") 0
    (if (string=? c "1") 1
      (if (string=? c "2") 2
        (if (string=? c "3") 3
          (if (string=? c "4") 4
            (if (string=? c "5") 5
              (if (string=? c "6") 6
                (if (string=? c "7") 7
                  (if (string=? c "8") 8
                    (if (string=? c "9") 9 -1)))))))))))

(defn digits [s :string i :i64 n :i64 acc :i64] :i64
  (if (>= i n)
    acc
    (let [d (digit-val (string-substring s i (+ i 1)))]
      (if (< d 0)
        acc
        (digits s (+ i 1) n (+ (* acc 10) d))))))

(defn exit-code [r :string] :i64
  (let [h (head-index r)]
    (if (< h 0)
      -1
      (if (< (digit-val (string-substring r 0 1)) 0)
        -1
        (digits r 0 h 0)))))

(defn stdout [r :string] :string
  (let [h (head-index r)]
    (if (< h 0)
      ""
      (string-substring r (+ h 1) (string-byte-length r)))))

;; Lines in stdout, counting a trailing newline as terminating the last line
;; (so `git status --porcelain` with three changed paths answers 3, which is
;; what `wc -l` answers for the same bytes).
(defn count-newlines [s :string acc :i64] :i64
  (let [i (string-index-of s "\n")]
    (if (< i 0)
      acc
      (count-newlines (string-substring s (+ i 1) (string-byte-length s)) (+ acc 1)))))

(defn stdout-line-count [r :string] :i64
  (count-newlines (stdout r) 0))

(defn ok? [grant-index :string] :bool
  (if (= (exit-code (run grant-index)) 0) true false))