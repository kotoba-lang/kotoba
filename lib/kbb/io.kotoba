;; kbb.io — standard output for kbb scripts and Kotoba commands. Wire id 37
;; (:io/write). A script says `(io/print s)` or `(io/println s)`; the wire id
;; and the typed request/result shape live HERE, once, so a script never
;; spells a `typed-cap-call` and never learns a wire id -- the same rule
;; kbb.fs and kbb.browse follow.
;;
;; The capability carries `:string -> :string`: the request is the bytes, the
;; result is the DECIMAL COUNT of bytes written, as text. That is not a
;; stylistic choice. `[:string :string]` is one of the four generic type
;; pairs kotoba.kir's native gate admits for `typed-cap-call` (the others are
;; i64, option-i64 and result-i64), so `:string -> :i64` would need a named
;; provider contract rather than a catalog entry. And the result has to be
;; short: a native guest's strings live in one 65,536-byte arena that is a
;; bump allocator and never reclaims, so echoing the payload back -- the
;; shape kbb.fs/write-file uses, where the echo IS the verification -- would
;; charge every write twice and halve how much a command can print.
;;
;; There is no resource scope. Every other capability here narrows to a
;; granted path or name; this one has nothing to narrow, because the guest
;; cannot name a destination, cannot open one and cannot ask which one it
;; got. The authority the grant carries is exactly "may produce output".
;;
;; Newlines: Kotoba source cannot write a control character and has no
;; char-to-string builtin, so `newline` is cut from a literal that contains
;; one, the same trick kbb.fs/digit-text uses for digits.
;;
;; Consumed through the project route: `--source-path lib`.
(ns kbb.io (:export [print println newline write-count wrote-all?]))

(defn digit-text [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

;; Decimal text of a non-negative i64. The guest has no number->string
;; builtin, so digits are cut from a literal -- the same construction
;; kbb.fs/i64->text uses. Recursion depth is the digit count.
(defn decimal-of [n :i64] :string
  (if (< n 10)
    (digit-text n)
    (string-concat (decimal-of (quot n 10))
                   (digit-text (- n (* 10 (quot n 10)))))))

(defn print [s :string] :string
  (typed-cap-call :io/write :string :string s))

;; The number of bytes the host reported writing. The host answers a decimal,
;; and the guest has no text->number builtin, so what is compared below is the
;; TEXT of the two counts rather than two numbers.
(defn write-count [s :string] :string
  (print s))

;; The one-byte string "\n", cut from a two-line literal at the byte offset
;; the first line ends at.
(defn newline [] :string
  (string-substring "a
b" 1 2))

(defn println [s :string] :string
  (print (string-concat s (newline))))

;; True when the host reported writing exactly as many bytes as were sent.
;; The host writes the whole payload or raises, so a false here means the
;; count itself disagreed -- worth having as an assertion rather than
;; assuming, since a count is the only thing the guest gets back.
(defn wrote-all? [s :string] :bool
  (string=? (print s) (decimal-of (string-byte-length s))))
