;; kbb.browse — directory listing for kbb scripts. Wire id 34 (:fs/browse).
;; The host answers one entry per line, "NAME<TAB>D", where D is "1" for a
;; directory and "0" for a file, the lines sorted by NAME and joined by a
;; single "\n" (empty string for an empty directory). The "<TAB>" is an ASCII
;; separator (Kotoba source spells it "\t"): an entry NAME must not itself
;; contain "\t" or "\n" — the same class of assumption the old names-only
;; answer already made about "\n". Scope is the policy's :fs/browse directory
;; trees.
;;
;; The is-directory flag is what a recursive scan needs: `subdirs` answers the
;; names of the subdirectories of one directory, so a guest can walk a tree
;; without guessing which entry is a directory. `entries` keeps answering the
;; plain entry names (it strips the flag), and `entry-count` the count, so
;; callers that only need the top-level listing read the same values they did
;; before the wire carried types.
;;
;; Backend note: both JVM-free hosts answer the same "NAME<TAB>D" bytes,
;; measured through bin/kbb (the nbb shim): the js host (bin/kbb_js.cljs,
;; wire 34) since 2026-09-08 (kotoba b7ab6bee2), the native loader since
;; amu a681d3f2 (loader identity 9942820b; previously it answered names only,
;; "NAME" per line — old amu pins at 55e47f90 and earlier). kbb_shim_test's wire-34 listing-byte
;; assertions pin both hosts at 12 bytes for the same three-file fixture;
;; a native answer of 6 is a regression to the names-only wire.
;;
;; `entry-count` walks the listing with string-index-of / string-substring
;; (self-recursion, fuel-bounded). An earlier reading (2026-09-06, morning)
;; said `string-split-count` was not lowered by the js emitter; measured
;; again the same day it IS (`(string-split-count "a\nb" "\n")` answers 2
;; through kbb_js.cljs), and kbb.str/line-count uses it. The walk here is
;; kept as written: it is measured on every consumer test.
(ns kbb.browse
  (:export [entries entry-count subdirs entry-name entry-dir?]))

(defn listing [dir :string] :string
  (typed-cap-call :fs/browse :string :string dir))

;; The NAME half of one "NAME<TAB>D" line. A line with no separator is
;; returned whole (the native identity stub answers that shape; the js host
;; never emits it).
(defn entry-name [line :string] :string
  (let [i (string-index-of line "\t")]
    (if (< i 0)
      line
      (string-substring line 0 i))))

;; The D half of one "NAME<TAB>D" line: is this entry a directory? The flag
;; is a single byte after the separator; a line with no separator is a file.
(defn entry-dir? [line :string] :bool
  (let [i (string-index-of line "\t")
        n (string-byte-length line)]
    (if (or (< i 0) (< n (+ i 2)))
      false
      (string=? (string-substring line (+ i 1) (+ i 2)) "1"))))

(defn count-separators [listing :string acc :i64] :i64
  (let [i (string-index-of listing "\n")]
    (if (< i 0)
      acc
      (count-separators (string-substring listing (+ i 1) (string-byte-length listing))
                        (+ acc 1)))))

(defn entry-count [dir :string] :i64
  (let [listing (listing dir)]
    (if (= (string-byte-length listing) 0)
      0
      (+ 1 (count-separators listing 0)))))

(defn append-name [acc :string name :string] :string
  (if (= (string-byte-length acc) 0)
    name
    (string-concat (string-concat acc "\n") name)))

;; entries — the plain entry names, "\n"-joined, flag stripped. Backward
;; compatible with the pre-type wire (the names are the same bytes).
(defn decode-line [line :string acc :string] :string
  (append-name acc (entry-name line)))

(defn decode-all [listing :string acc :string] :string
  (let [i (string-index-of listing "\n")]
    (if (< i 0)
      (if (= (string-byte-length listing) 0)
        acc
        (decode-line listing acc))
      (decode-all (string-substring listing (+ i 1) (string-byte-length listing))
                  (decode-line (string-substring listing 0 i) acc)))))

(defn entries [dir :string] :string
  (decode-all (listing dir) ""))

;; subdirs — the NAMES of the entries that are directories, "\n"-joined.
;; This is the recursion primitive a tree walk needs: list a directory, then
;; recurse into each name `subdirs` returned.
(defn keep-dir [line :string acc :string] :string
  (if (entry-dir? line)
    (append-name acc (entry-name line))
    acc))

(defn subdirs-walk [listing :string acc :string] :string
  (let [i (string-index-of listing "\n")]
    (if (< i 0)
      (if (= (string-byte-length listing) 0)
        acc
        (keep-dir listing acc))
      (subdirs-walk (string-substring listing (+ i 1) (string-byte-length listing))
                    (keep-dir (string-substring listing 0 i) acc)))))

(defn subdirs [dir :string] :string
  (subdirs-walk (listing dir) ""))