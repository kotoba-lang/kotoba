(ns kbb.time
  "kbb.time — the wall clock for kbb scripts and Kotoba commands. Wire id 7
  (:clock/now). A script says `(time/now)`; the wire id and the typed
  request/result shape live HERE, once, so a script never spells a
  `typed-cap-call` and never learns a wire id -- the same rule kbb.io and
  kbb.fs follow.

  The capability carries `:string -> :string` (one of the four generic type
  pairs the native gate admits for `typed-cap-call`): the request is
  ignored (the empty string is what the guest can most cheaply pass), the
  result is the ISO-8601 UTC wall clock, e.g. \"2026-09-13T04:49:19.301Z\"
  (24 chars).

  There is no resource scope (like :io/write). The guest cannot name a
  destination for the time and cannot influence it -- the authority the
  grant carries is exactly \"may read the wall clock\". Civil-date
  arithmetic over the returned string (leap years, days-in-month) lives in
  kotoba-time's kotoba.time; the READING of the clock is here and only
  here.

  Consumed through the project route: `--source-path lib`."
  (:export [now self-check main]))

(defn now [] :string
  (typed-cap-call :clock/now :string :string ""))

(defn self-check [] :i64
  (+ (if (= 24 (string-byte-length (now))) 0 1)
     (if (string=? "T" (string-substring (now) 10 11)) 0 1)))

(defn main [] :i64 (self-check))
