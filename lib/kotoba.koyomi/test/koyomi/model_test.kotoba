(ns koyomi.model-test (:export [main]) (:require [koyomi.model :as p]))

(defn- kw [k :keyword] :document (document-keyword k))
(defn- str [s :string] :document (document-string s))
(defn- get-or-null [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn- case-contact [] :i64
  (let [c (p/contact (str "a@example"))]
    (+ (if (document-equal? c (document-map :attendee (str "a@example") :consent (kw :known) :first-contact? (document-bool false))) 0 1)
       (if (document-equal? (get-or-null c :consent) (kw :known)) 0 1))))

(defn- case-contact-with [] :i64
  (let [c (p/contact-with (str "b@example") (document-map :consent (kw :blocked) :first-contact? (document-bool true)))
        d (p/contact-with (str "c@example") (document-null))]
    (+ (if (document-equal? (get-or-null c :consent) (kw :blocked)) 0 1)
       (if (document-equal? (get-or-null c :first-contact?) (document-bool true)) 0 1)
       (if (document-equal? (get-or-null c :attendee) (str "b@example")) 0 1)
       (if (document-equal? (get-or-null d :consent) (kw :known)) 0 1))))

(defn main [] :i64
  (+ (case-contact) (case-contact-with)))
