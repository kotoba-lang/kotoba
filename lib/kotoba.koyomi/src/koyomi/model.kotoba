;; Port of koyomi.model (model.cljk), Kotoba-native, :document maps. PARTIAL.
;;
;; Ported: contact.
;; NOT ported: draft. Its default :confidence is the float literal 0.0, and
;; Kotoba has no f64 :document value (document-f64 is refused by the seed),
;; so the default map cannot be built as the source builds it. Porting it with
;; an integer 0 or a string "0.0" would change the record, so it is left out.
;;
;; Named divergences from model.cljk:
;;   - contact takes its attrs as a :document map. The two arities of the
;;     source are split (E2138): contact is the one-argument form with no
;;     attrs; contact-with takes attrs.

(ns koyomi.model
  (:export [contact contact-with]))

(defn- contact-defaults [attendee :document] :document
  (document-map :attendee attendee
                :consent (document-keyword :known)
                :first-contact? (document-bool false)))

(defn contact
  "An attendee's consent record with the default consent state."
  [attendee :document] :document
  (contact-defaults attendee))

(defn contact-with
  "An attendee's consent record; attrs (a :document map) override the defaults."
  [attendee :document attrs :document] :document
  (let [base (contact-defaults attendee)]
    (if (map? attrs)
      (document-merge base attrs)
      base)))
