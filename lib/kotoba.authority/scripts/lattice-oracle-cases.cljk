;; scripts/lattice-oracle-cases.cljk -- authority.lattice (pure Kotoba) against
;; authority.scope (the .cljk oracle), case by case.
;;
;;   kbb --backend sci --classpath "src:$(kbb -Spath)" scripts/lattice-oracle-cases.cljk
;;
;; Every case below is one assertion in src/authority/lattice.kotoba's test-*
;; exports, with the answer that file expects. This script asks the oracle the
;; same question and fails on the first disagreement, so the Kotoba tests cannot
;; drift from scope.cljk without this run going red. Regenerate the list when a
;; test-* changes (the cases are copied, not parsed at run time, so a reader can
;; see exactly what was compared).

(require '[authority.scope :as scope])

(def cases
  [[:valid "kotoba://graph/g1" true]
   [:valid "kotoba://graph/*" true]
   [:valid "kotoba://op" true]
   [:valid "k://a/b/c" true]
   [:valid "" false]
   [:valid "kotoba://" false]
   [:valid "://a" false]
   [:valid "kotoba:/graph" false]
   [:valid "kotoba://graph/" false]
   [:valid "kotoba:///graph" false]
   [:valid "kotoba://a//b" false]
   [:valid "kotoba://*/g1" false]
   [:valid "*://a" false]
   [:valid "a/b://c" false]
   [:covers "k://graph/g1" "k://graph/g1" true]
   [:covers "k://graph/g1" "k://graph/g2" false]
   [:covers "k://graph" "k://graph/g1" false]
   [:covers "k://graph/g1" "k://graph" false]
   [:covers "k://graph/*" "k://graph/g1" true]
   [:covers "k://graph/*" "k://graph/g1/x" true]
   [:covers "k://graph/*" "k://graph/*" true]
   [:covers "k://graph/*" "k://graph" false]
   [:covers "k://graph/g1" "k://graph/*" false]
   [:covers "a://graph/*" "b://graph/g1" false]
   [:covers "k://graph/*" "k://graph//g1" false]
   [:covers "nonsense" "nonsense" false]
   [:covers "kotoba://can/*" "kotoba://can/read" true]
   [:covers "kotoba://can/*" "kotoba://can/read/x" true]
   [:covers "kotoba://can/*" "kotoba://can" false]
   [:covers "kotoba://org/acme" "kotoba://org/acme" true]
   [:covers "kotoba://org/acme" "kotoba://org/acme/x" false]
   [:covers "kotoba://org/*" "kotoba://graph/g1" false]
   [:covers "kotoba://graph/*" "kotoba://graph/*" true]
   [:covers "kotoba://graph/g1" "kotoba://graph/*" false]
   [:meet "k://graph/*" "k://graph/g1" "k://graph/g1"]
   [:meet "k://graph/g1" "k://graph/*" "k://graph/g1"]
   [:meet "k://graph/g1" "k://graph/g2" ""]])

(defn- oracle [[op a b]]
  (case op
    :valid (some? (scope/parse a))
    :covers (boolean (and (scope/parse a) (scope/parse b)
                          (scope/covers? (scope/parse a) (scope/parse b))))
    :meet (or (scope/render (scope/meet (scope/parse a) (scope/parse b))) "")))

(let [bad (remove (fn [c] (= (last c) (oracle c))) cases)]
  (doseq [c bad] (println "DISAGREE" (pr-str c) "oracle:" (pr-str (oracle c))))
  (println (str "SCANNED\t" (count cases) "\tcases; " (- (count cases) (count bad)) " agree"))
  (when (or (empty? cases) (seq bad)) (js/process.exit 1)))
