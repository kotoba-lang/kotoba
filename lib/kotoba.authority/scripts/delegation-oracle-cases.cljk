;; scripts/delegation-oracle-cases.cljk -- authority.delegation (pure Kotoba)
;; against authority.chain/authorize (the .cljk oracle), case by case.
;;
;;   kbb --backend sci --classpath "src:$(kbb -Spath)" scripts/delegation-oracle-cases.cljk
;;
;; Each row is [name chain requested now holder strict? expected-reason]; the
;; same rows are the test-oracle-cases-* exports of src/authority/delegation.kotoba
;; (where "" stands for an absent holder, bound or clock). This asks the oracle
;; and fails on the first disagreement, so the Kotoba tests cannot drift from
;; authority.chain without this run going red.

(require '[authority.chain :as chain]
         '[authority.grant :as grant])

(def cases
  [
   ["one grant covers" [{:scopes ["k://graph/*"]}] "k://graph/g1" "2026-06-01T00:00:00Z" "did:a" false :granted]
   ["empty chain" [] "k://graph/g1" "2026-06-01T00:00:00Z" "did:a" false :empty-chain]
   ["expired" [{:scopes ["k://graph/*"] :expires "2026-01-01T00:00:00Z"}] "k://graph/g1" "2026-06-01T00:00:00Z" "did:a" false :expired-or-no-trusted-time]
   ["no trusted time" [{:scopes ["k://graph/*"]}] "k://graph/g1" nil "did:a" false :expired-or-no-trusted-time]
   ["wrong holder" [{:scopes ["k://graph/*"] :holder "did:b"}] "k://graph/g1" "2026-06-01T00:00:00Z" "did:a" false :wrong-holder]
   ["right holder" [{:scopes ["k://graph/*"] :holder "did:a"}] "k://graph/g1" "2026-06-01T00:00:00Z" "did:a" false :granted]
   ["out of scope" [{:scopes ["k://graph/*"]}] "k://op/write" "2026-06-01T00:00:00Z" "did:a" false :out-of-scope]
   ["over-claim lenient" [{:scopes ["k://graph/*"]} {:scopes ["k://graph/*" "k://op/*"]}] "k://graph/g1" "2026-06-01T00:00:00Z" "did:a" false :granted]
   ["over-claim strict" [{:scopes ["k://graph/*"]} {:scopes ["k://graph/*" "k://op/*"]}] "k://graph/g1" "2026-06-01T00:00:00Z" "did:a" true :escalation-attempted]
   ["over-claimed scope stays out" [{:scopes ["k://graph/*"]} {:scopes ["k://graph/*" "k://op/*"]}] "k://op/read" "2026-06-01T00:00:00Z" "did:a" false :out-of-scope]
   ["child narrows" [{:scopes ["k://graph/*"]} {:scopes ["k://graph/g1"]}] "k://graph/g2" "2026-06-01T00:00:00Z" "did:a" false :out-of-scope]
   ["child narrows and covers" [{:scopes ["k://graph/*"]} {:scopes ["k://graph/g1"]}] "k://graph/g1" "2026-06-01T00:00:00Z" "did:a" false :granted]
   ["tightest expiry in the middle" [{:scopes ["k://a/*"] :expires "2027-01-01T00:00:00Z"} {:scopes ["k://a/*"] :expires "2026-01-01T00:00:00Z"} {:scopes ["k://a/*"] :expires "2028-01-01T00:00:00Z"}] "k://a/x" "2026-06-01T00:00:00Z" "did:a" false :expired-or-no-trusted-time]
   ["unbounded child lenient" [{:scopes ["k://a/*"] :expires "2027-01-01T00:00:00Z"} {:scopes ["k://a/*"]}] "k://a/x" "2026-06-01T00:00:00Z" "did:a" false :granted]
   ["unbounded child strict" [{:scopes ["k://a/*"] :expires "2027-01-01T00:00:00Z"} {:scopes ["k://a/*"]}] "k://a/x" "2026-06-01T00:00:00Z" "did:a" true :escalation-attempted]
   ["unbounded child cannot outlive" [{:scopes ["k://a/*"] :expires "2026-01-01T00:00:00Z"} {:scopes ["k://a/*"]}] "k://a/x" "2026-06-01T00:00:00Z" "did:a" false :expired-or-no-trusted-time]
   ["leaf holder decides" [{:scopes ["k://a/*"] :holder "did:b"} {:scopes ["k://a/*"]}] "k://a/x" "2026-06-01T00:00:00Z" "did:a" false :granted]
   ["leaf holder bound" [{:scopes ["k://a/*"]} {:scopes ["k://a/*"] :holder "did:b"}] "k://a/x" "2026-06-01T00:00:00Z" "did:a" false :wrong-holder]
   ["authority does not creep back" [{:scopes ["k://a/*"]} {:scopes ["k://b/*"]} {:scopes ["k://a/*"]}] "k://a/x" "2026-06-01T00:00:00Z" "did:a" false :out-of-scope]
   ["malformed request" [{:scopes ["k://a/*"]}] "nonsense" "2026-06-01T00:00:00Z" "did:a" false :out-of-scope]
   ["malformed scope ignored" [{:scopes ["bad" "k://a/*"]}] "k://a/x" "2026-06-01T00:00:00Z" "did:a" false :granted]
   ["clean chain strict" [{:scopes ["k://a/*"]} {:scopes ["k://a/b"]}] "k://a/b" "2026-06-01T00:00:00Z" "did:a" true :granted]
   ])

(defn- oracle [[_ links requested now holder strict?]]
  (:authority/reason
   (chain/authorize {:chain (mapv grant/grant links) :requested requested
                     :now now :holder holder :strict? strict?})))

(let [bad (remove (fn [c] (= (last c) (oracle c))) cases)]
  (doseq [c bad] (println "DISAGREE" (first c) "expected" (last c) "oracle" (oracle c)))
  (println (str "SCANNED\t" (count cases) "\tcases; " (- (count cases) (count bad)) " agree"))
  (when (or (empty? cases) (seq bad)) (js/process.exit 1)))
