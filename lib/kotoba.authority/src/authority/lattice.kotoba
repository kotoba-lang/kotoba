;; authority.lattice -- the capability lattice of authority.scope, as pure Kotoba.
;;
;; root ADR-2610082200 §16 (W1): everything below the kotoba app runs in pure
;; Kotoba. `authority.scope` (scope.cljk) stays as the general oracle, the way
;; kotoba-lang/text keeps text.cljk beside bounded_text.kotoba. This module is
;; the canonical form for a Kotoba guest, and it is what kototama's admission
;; core (src/kototama/admission.kotoba) needs: the grant keys it intersects are
;; strings, so the lattice is computed on the resource strings themselves.
;;
;; Why strings and not the oracle's vectors: a scope there is a vector that
;; mixes string segments with the keyword `:*`, and nil means "not a scope".
;; A Kotoba vector holds one type, and absence is a value. On the wire both are
;; the same resource string -- `parse` and `render` are inverses on every valid
;; scope -- so working on that string loses nothing and needs no new type.
;;
;; The laws are the oracle's, unchanged:
;;   valid?    scheme "://" path; no empty segment (so no leading, trailing or
;;             doubled "/"); the scheme is not "*" and has no "/"; "*" (the
;;             wildcard) appears only as the last segment.
;;   covers?   reflexive, transitive, antisymmetric. A trailing "*" covers any
;;             scope sharing the prefix whose length is at least the parent's,
;;             so k://graph/* reaches k://graph/g1 but not k://graph.
;;   meet      the narrower of two comparable scopes; "" when incomparable
;;             ("" is never a valid scope, so it cannot be read as authority).
;;   covered?  false on an empty set and on a malformed request.

(ns authority.lattice
  (:require [kotoba.lang.bounded-text :as bt])
  (:export [main valid? covers? meet covered?
            test-valid-scopes test-invalid-scopes test-covers-exact
            test-covers-wildcard test-covers-refuses test-meet
            test-covered test-oracle-parity]))

(def separator "://")

(defn- scheme-of [s :string] :string
  (string-substring s 0 (bt/index-of-text s separator)))

(defn- path-of [s :string] :string
  (string-substring s (+ (bt/index-of-text s separator) (string-byte-length separator))
                    (string-byte-length s)))

(defn- path-count [s :string] :i64
  (bt/segment-count-text (path-of s) "/"))

(defn- seg [s :string n :i64] :string
  (bt/segment-text (path-of s) "/" n))

(defn- wildcard-only-last? [s :string] :bool
  ;; no path segment before the last one is "*", and none is empty
  (let [n (path-count s)]
    (loop [i 0]
      (if (>= i n)
        true
        (let [x (seg s i)]
          (if (= (string-byte-length x) 0)
            false
            (if (and (string=? x "*") (< i (- n 1)))
              false
              (recur (+ i 1)))))))))

(defn valid? [s :string] :bool
  (let [i (bt/index-of-text s separator)]
    (if (<= i 0)
      false
      (let [scheme (scheme-of s)
            path (path-of s)]
        (and (not (string=? scheme "*"))
             (not (bt/contains-text? scheme "/"))
             (> (string-byte-length path) 0)
             (not (bt/starts-with-text? path "/"))
             (not (bt/ends-with-text? path "/"))
             (not (bt/contains-text? path "//"))
             (wildcard-only-last? s))))))

(defn- prefix-equal? [parent :string child :string n :i64] :bool
  ;; the first n path segments of parent and child are the same
  (loop [i 0]
    (if (>= i n)
      true
      (if (string=? (seg parent i) (seg child i))
        (recur (+ i 1))
        false))))

(defn covers? [parent :string child :string] :bool
  (if (and (valid? parent) (valid? child) (string=? (scheme-of parent) (scheme-of child)))
    (let [np (path-count parent)
          nc (path-count child)]
      (if (string=? (seg parent (- np 1)) "*")
        (and (>= nc np) (prefix-equal? parent child (- np 1)))
        (and (= np nc) (prefix-equal? parent child np))))
    false))

(defn meet [a :string b :string] :string
  (if (covers? a b)
    b
    (if (covers? b a) a "")))

(defn covered? [scopes [:set :string] requested :string] :bool
  (let [n (typed-set-count [:set :string] scopes)]
    (loop [i 0]
      (if (>= i n)
        false
        (if (covers? (typed-set-nth [:set :string] scopes i) requested)
          true
          (recur (+ i 1)))))))

;; --- tests: exported zero-arity test-* return i64 1 on pass ----------------

(defn- pass [b :bool] :i64 (if b 1 0))

(defn test-valid-scopes [] :i64
  (pass (and (valid? "kotoba://graph/g1") (valid? "kotoba://graph/*")
             (valid? "kotoba://op") (valid? "k://a/b/c"))))

(defn test-invalid-scopes [] :i64
  (pass (and (not (valid? "")) (not (valid? "kotoba://")) (not (valid? "://a"))
             (not (valid? "kotoba:/graph")) (not (valid? "kotoba://graph/"))
             (not (valid? "kotoba:///graph")) (not (valid? "kotoba://a//b"))
             (not (valid? "kotoba://*/g1")) (not (valid? "*://a"))
             (not (valid? "a/b://c")))))

(defn test-covers-exact [] :i64
  (pass (and (covers? "k://graph/g1" "k://graph/g1")
             (not (covers? "k://graph/g1" "k://graph/g2"))
             (not (covers? "k://graph" "k://graph/g1"))
             (not (covers? "k://graph/g1" "k://graph")))))

(defn test-covers-wildcard [] :i64
  (pass (and (covers? "k://graph/*" "k://graph/g1")
             (covers? "k://graph/*" "k://graph/g1/x")
             (covers? "k://graph/*" "k://graph/*")
             (not (covers? "k://graph/*" "k://graph"))
             (not (covers? "k://graph/g1" "k://graph/*")))))

(defn test-covers-refuses [] :i64
  (pass (and (not (covers? "a://graph/*" "b://graph/g1"))
             (not (covers? "k://graph/*" "k://graph//g1"))
             (not (covers? "nonsense" "nonsense")))))

(defn test-meet [] :i64
  (pass (and (string=? (meet "k://graph/*" "k://graph/g1") "k://graph/g1")
             (string=? (meet "k://graph/g1" "k://graph/*") "k://graph/g1")
             (string=? (meet "k://graph/g1" "k://graph/g2") ""))))

(defn test-covered [] :i64
  (let [granted (typed-set-new [:set :string] "k://graph/*" "k://op/read")
        none (typed-set-new [:set :string])]
    (pass (and (covered? granted "k://graph/g1")
               (covered? granted "k://op/read")
               (not (covered? granted "k://op/write"))
               (not (covered? granted "k://graph"))
               (not (covered? none "k://graph/g1"))
               (not (covered? granted "malformed"))))))

;; Cases whose answers were produced by the oracle (authority.scope/covers? on
;; the parsed scopes) and written here, so a divergence from scope.cljk fails
;; this module's own test. Regenerate with scripts/lattice-oracle-cases.cljk.
(defn test-oracle-parity [] :i64
  (pass (and (covers? "kotoba://can/*" "kotoba://can/read")
             (covers? "kotoba://can/*" "kotoba://can/read/x")
             (not (covers? "kotoba://can/*" "kotoba://can"))
             (covers? "kotoba://org/acme" "kotoba://org/acme")
             (not (covers? "kotoba://org/acme" "kotoba://org/acme/x"))
             (not (covers? "kotoba://org/*" "kotoba://graph/g1"))
             (covers? "kotoba://graph/*" "kotoba://graph/*")
             (not (covers? "kotoba://graph/g1" "kotoba://graph/*")))))

;; main: the number of test-* that pass (8 when all do). The browser host
;; admits a module only with a main export.
(defn main [] :i64
  (+ (test-valid-scopes) (test-invalid-scopes) (test-covers-exact)
     (test-covers-wildcard) (test-covers-refuses) (test-meet) (test-covered)
     (test-oracle-parity)))
