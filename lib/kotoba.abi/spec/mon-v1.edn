{:mon.schema/version 1
 :owner "kotoba-lang/abi"
 :entrypoint kotoba.abi.mon
 :root-adr "ADR-2610082200"
 :status :draft

 ;; 紋（mon）= DNA: 網のルールを決める内容アドレスの束。
 ;; 紋 = {:mon/rules      [<rule Form DefCID> ...]
 ;;       :mon/entry-types {<name> <Kotoba Schema の CID>}
 ;;       :mon/properties  {...}                ; 網ごとの定数
 ;;       :mon/network-seed <bytes>             ; 同じルールで別の網を作るため
 ;;       :mon/membrane    <membrane の rule Form DefCID>}
 :keys #{:mon/rules :mon/entry-types :mon/properties :mon/network-seed :mon/membrane}
 :required #{:mon/rules :mon/entry-types :mon/properties :mon/network-seed :mon/membrane}
 :unknown-keys-refused true

 :field-shapes
 {:mon/rules {:type :vector-of-cid :non-empty true
              :cid-role :rule-form-defcid :unique true}
  :mon/entry-types {:type :map-of-name-to-cid :name-type :string-or-keyword
                    :cid-role :kotoba-schema-cid}
  :mon/properties {:type :map :free-keys true}
  :mon/network-seed {:type :bytes
                     ;; EDN surface: the byte string is carried as a non-empty
                     ;; string token here. The byte-string coding belongs to the
                     ;; DAG-CBOR codec, not to this shape gate.
                     :edn-surface :non-empty-string}
  :mon/membrane {:type :cid :cid-role :membrane-rule-form-defcid}}

 ;; 紋 CID が網の身元である。rule・entry の schema・properties・seed の
 ;; どれかが変われば別の網になる（Holochain の DNA hash と同じ性質）。
 ;; logic Form は入らない。
 :cid-derivation {:input :mon
                  :dag :dag-kotoba
                  :encoding :dag-cbor
                  :cid-fn :cid
                  :formula "CID(DAG-CBOR(DAG-Kotoba(紋)))"
                  :excluded [:logic-form-cids]}

 ;; 移行は明示する: 古い紋の糸に close action（新しい紋 CID を指す）、
 ;; 新しい紋の糸に open action（古い close の CID を指す）。暗黙の移行はしない。
 :migration {:explicit true :close-action :points-to-new-mon-cid
             :open-action :points-to-old-close-cid :implicit-migration false}

 ;; membrane は入会条件。cell の genesis で membrane 証明を検査する。
 :membrane {:proof-origins [:capability-chain :kotoba-passport-stamp]
            :checked-at :cell-genesis}}
