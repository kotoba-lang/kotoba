{:kotoba.app-world/version 2
 :owner "kotoba-lang/abi"
 :entrypoint kotoba.abi.app-world
 :root-adr "ADR-2610082200"
 :status :draft
 :world "kotoba:app/kotoba-app@0.2.0"

 ;; ADR-2610082200 P1: kotoba-app world v0.2 = 名前付き import
 ;; identity.sign・hash・object-store・log・clock と export app.call・ito.append。
 ;; 名前は ADR の語を WIT の識別子（kebab、ドット無し）に写しただけで、
 ;; 対応表がこの map の正本である。
 :imports [{:contract-name "identity.sign" :wit-name "identity-sign"}
           {:contract-name "hash" :wit-name "hash"}
           {:contract-name "object-store" :wit-name "object-store"}
           {:contract-name "log" :wit-name "log"}
           {:contract-name "clock" :wit-name "clock"}]
 :exports [{:contract-name "app.call" :wit-name "app-call"}
           {:contract-name "ito.append" :wit-name "ito-append"}
           {:contract-name "main" :wit-name "main" :note "既存 v0.2 の入口。ADR は語らないが落とさない"}]

 ;; 効果はこの 5 つの名前付き import に閉じる。ambient WASI は無い
 ;; （v1/v2 と同じ規則: 各効果は個別の名前付き import、umbrella interface で束ねない）。
 :ambient-wasi false

 ;; 既存 consumer 保護: `kotoba.abi.component/world-wit-v2` の純粋 render
 ;; （export main のみ）はこの PR では変更しない。consumer の切り替えは
 ;; amu / kototama-component と協調する別 PR の仕事。
 :world-wit-v2-unchanged true}
