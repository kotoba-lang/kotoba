package aiueos:capability@0.3.0;

/// A host-owned, non-forgeable authority. There is intentionally no exported
/// constructor or serialization method. The linker creates one only after
/// admitting a descriptor and a live lease.
interface capability {
  resource grant;
  /// Every provider call can fail closed without exposing a host exception.
  enum denial {
    revoked,
    expired,
    quota,
    deadline,
    audit-unavailable,
    provider-failed,
  }
  /// A named request narrows acquisition to one operation. Selecting a name
  /// does not create authority: the host returns a grant only when that exact
  /// operation appears in the admitted descriptor.
  enum grant-request {
    identity-sign,
    identity-verify,
    hash-sha256,
    http-post,
    log-read,
    log-append,
    clock-now,
    http-get-stream,
    object-get-stream,
    object-put-block,
    object-compare-and-set-ref,
  }
  record bytes-request { bytes: list<u8>, }
  record bytes-response { bytes: list<u8>, }
  record http-post-request {
    path: string,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }
  record http-post-response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }
  record log-read-request { cursor: u64, max-bytes: u32, }
  record log-read-response { next-cursor: u64, bytes: list<u8>, }
  record stream-chunk { bytes: list<u8>, done: bool, }
  /// A pull-based byte stream. Every read is bounded by both the caller's
  /// request and the admitted grant. Dropping/cancelling closes host resources.
  resource bytes-stream {
    read: func(max-bytes: u32) -> result<stream-chunk, denial>;
    cancel: func();
  }
  variant bytes-task-state {
    pending,
    ready(own<bytes-stream>),
  }
  /// Task<Stream Bytes> without ambient executors. Poll and cancellation are
  /// explicit so every host can enforce deadline, item, and byte budgets.
  resource bytes-task {
    poll: func() -> result<bytes-task-state, denial>;
    cancel: func();
  }
  record http-get-stream-request {
    path: string,
    headers: list<tuple<string, string>>,
  }
  record object-get-stream-request { key: string, }
  record object-put-block-request { key: string, bytes: list<u8>, }
  record object-compare-and-set-ref-request {
    key: string,
    expected-etag: option<string>,
    bytes: list<u8>,
  }
  record object-compare-and-set-ref-response {
    won: bool,
    etag: option<string>,
  }

  /// The only way a guest obtains a resource representation. The host binds
  /// the returned handle to the exact admitted named operation and rejects
  /// unadmitted, cross-interface, expired, revoked, or exhausted use. This is
  /// issuance, not a constructor.
  acquire: func(request: grant-request) -> result<own<grant>, denial>;
}

interface identity {
  use capability.{grant, denial, bytes-request, bytes-response};
  sign: func(authority: borrow<grant>, request: bytes-request) -> result<bytes-response, denial>;
  verify: func(authority: borrow<grant>, request: bytes-request) -> result<bool, denial>;
}

interface hash {
  use capability.{grant, denial, bytes-request, bytes-response};
  sha256: func(authority: borrow<grant>, request: bytes-request) -> result<bytes-response, denial>;
}

interface http {
  use capability.{grant, denial, bytes-task, http-post-request, http-post-response, http-get-stream-request};
  post: func(authority: borrow<grant>, request: http-post-request) -> result<http-post-response, denial>;
  get-stream: func(authority: borrow<grant>, request: http-get-stream-request) -> result<own<bytes-task>, denial>;
}

interface object-store {
  use capability.{grant, denial, bytes-task, object-get-stream-request, object-put-block-request, object-compare-and-set-ref-request, object-compare-and-set-ref-response};
  get-stream: func(authority: borrow<grant>, request: object-get-stream-request) -> result<own<bytes-task>, denial>;
  put-block: func(authority: borrow<grant>, request: object-put-block-request) -> result<_, denial>;
  compare-and-set-ref: func(authority: borrow<grant>, request: object-compare-and-set-ref-request) -> result<object-compare-and-set-ref-response, denial>;
}

interface log {
  use capability.{grant, denial, bytes-request, log-read-request, log-read-response};
  read: func(authority: borrow<grant>, request: log-read-request) -> result<log-read-response, denial>;
  append: func(authority: borrow<grant>, request: bytes-request) -> result<_, denial>;
}

interface clock {
  use capability.{grant, denial};
  now: func(authority: borrow<grant>) -> result<u64, denial>;
}

world providers {
  export identity;
  export hash;
  export http;
  export object-store;
  export log;
  export clock;
}

/// The world imported by a Kotoba application Component. A compiler emits a
/// subset of these interfaces only when it can lower `acquire` and typed calls.
world application {
  import capability;
  import identity;
  import hash;
  import http;
  import object-store;
  import log;
  import clock;
  export main: func() -> s64;
}
