package aiueos:capability@0.4.0;

interface capability {
  resource grant;
  enum denial {
    revoked,
    expired,
    quota,
    deadline,
    audit-unavailable,
    provider-failed,
    malformed-packet,
    route-denied,
  }
  enum grant-request {
    packet-device-open,
  }
  acquire: func(request: grant-request) -> result<own<grant>, denial>;
}

interface packet-device {
  use capability.{grant, denial};

  enum family {
    ipv4,
    ipv6,
  }

  record configuration {
    mtu: u16,
    capture-ipv4-default: bool,
    capture-ipv6-default: bool,
    max-packet-bytes: u32,
    max-inflight-packets: u16,
  }

  record packet {
    family: family,
    bytes: list<u8>,
  }

  variant read-result {
    packet(packet),
    stopped,
  }

  /// A host-owned OS packet device. The guest cannot construct, serialize, or
  /// transfer the handle and receives no raw descriptor.
  resource device {
    read: func() -> result<read-result, denial>;
    write: func(value: packet) -> result<_, denial>;
    stop: func();
  }

  open: func(
    authority: borrow<grant>,
    configuration: configuration
  ) -> result<own<device>, denial>;
}

world packet-application {
  import capability;
  import packet-device;
  export main: func() -> s64;
}
