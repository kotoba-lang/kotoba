package aiueos:capability@0.1.0;

/// Named provider interfaces used by a Kototama linker after an Aiueos grant.
/// This package intentionally defines no ambient WASI surface.
interface identity {
  sign: func(value: s64) -> s64;
  verify: func(value: s64) -> s64;
}

interface hash {
  sha256: func(value: s64) -> s64;
}

interface http {
  post: func(value: s64) -> s64;
}

interface log {
  read: func(value: s64) -> s64;
  append: func(value: s64) -> s64;
}

interface clock {
  now: func(value: s64) -> s64;
}

world providers {
  export identity;
  export hash;
  export http;
  export log;
  export clock;
}
