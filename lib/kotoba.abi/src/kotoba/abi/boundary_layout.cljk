(ns kotoba.abi.boundary-layout
  "Per-target profile layout for the judgment-free boundary encoding
  (:kotoba.lisp-machine/boundary-v1). Owner decision D1 of
  kotoba-lang/kotoba-lang docs/adr/ADR-kotoba-lisp-machine-contract-decisions.md.

  LAYOUT ONLY. This namespace decides nothing: judgments stay with rule Form,
  grant and authority, the neutral shapes live in kotoba-core-contracts
  (resources/kotoba/runtime/boundary_contract.edn), and the wire codec lives
  in kotoba-protocol. It also changes no WIT, no target set and no v1 wire."
  {:kotoba/export [boundary-layout boundary-schema layout-domains layout-rules-inherited]})

(def boundary-schema :kotoba.lisp-machine/boundary-v1)

(def boundary-layout
  {:boundary.layout/version 1
   :owner "kotoba-lang/abi"
   :status :accepted
   :boundary-schema boundary-schema
   :source {:adr "kotoba-lang/kotoba-lang docs/adr/ADR-kotoba-lisp-machine-contract-decisions.md D1"
            :descriptor "kotoba-core-contracts resources/kotoba/runtime/boundary_contract.edn"}
   :scope {:domains [:host-guest]
           :what :per-target-profile-layout
           :not [:judgment :policy :implementation :wire-codec]}
   :layout {:host-guest {:shape :canonical-abi-lift-lower
                         :targets-owned-by-profiles [:wasm-component-kotoba-v1
                                                     :wasm-component-kotoba-v2]
                         :component-binding :kotoba.component-binding/v1
                         :v1-wire-and-wit-unchanged true
                         :unknown-target-profile-refused true}}
   :rules-inherited [:judgment-free
                     :unknown-shape-fail-closed
                     :canonical-bytes-before-cid
                     :versioned-wire-keys-preserved
                     :no-secrets
                     :host-object-transparent]
   :non-claims ["layout only; the boundary's judgment stays with rule Form, grant and authority"
                "no new target, no WIT change, no v1 wire change"
                "no qualification or implementation claim"]})

(defn layout-domains
  "The boundary domains whose layout this repo owns."
  []
  (-> boundary-layout :scope :domains))

(defn layout-rules-inherited
  "The boundary rules a profile layout must not contradict."
  []
  (:rules-inherited boundary-layout))
