(ns kotoba.abi.mon
  "紋（mon）の schema —— 網のルールを決める内容アドレスの束。

  root ADR-2610082200（P1）。紋 = DNA にあたり、紋 CID が網の身元になる。
  この ns は shape gate だけを持つ: 署名の検証、CID の算出、entry の検証は
  それぞれ chain / content-address / rule Form の所有者で行う。"
  {:kotoba/export [mon-keys required-mon-keys valid-mon? mon-cid-derivation]}
  (:require [kotoba.core.execution :refer [cid?]]))

(def mon-keys
  "紋 を構成する 5 つの key。これ以外は入れない（unknown-keys-refused）。"
  #{:mon/rules :mon/entry-types :mon/properties :mon/network-seed :mon/membrane})

(def required-mon-keys mon-keys)

(def mon-cid-derivation
  "紋 CID = CID(DAG-CBOR(DAG-Kotoba(紋)))。rule・entry の schema・properties・
  seed のどれかが変われば別の網になる。logic Form は入らない。"
  {:input :mon
   :dag :dag-kotoba
   :encoding :dag-cbor
   :cid-fn :cid
   :excluded [:logic-form-cids]})

(defn- entry-type-name? [name]
  (or (string? name) (keyword? name)))

(defn- entry-types? [entry-types]
  (and (map? entry-types)
       (every? (fn [[name schema-cid]]
                 (and (entry-type-name? name)
                      (string? schema-cid)
                      (cid? schema-cid)))
               entry-types)))

(defn- rules? [rules]
  (and (vector? rules)
       (seq rules)
       (= (count rules) (count (distinct rules)))
       (every? #(and (string? %) (cid? %)) rules)))

(defn- network-seed? [seed]
  ;; EDN surface では byte string を非空 string で運ぶ。byte string の
  ;; 符号化は DAG-CBOR codec の仕事で、この shape gate の仕事ではない。
  (and (string? seed) (seq seed)))

(defn valid-mon?
  "Validate the exact 紋 shape. Signature checks, CID derivation and entry
  validation are downstream owners' responsibilities; this is only the
  shared shape gate (spec/mon-v1.edn)."
  [mon]
  (and (map? mon)
       (= mon-keys (set (keys mon)))
       (rules? (:mon/rules mon))
       (entry-types? (:mon/entry-types mon))
       (map? (:mon/properties mon))
       (network-seed? (:mon/network-seed mon))
       (and (string? (:mon/membrane mon))
            (cid? (:mon/membrane mon)))))
