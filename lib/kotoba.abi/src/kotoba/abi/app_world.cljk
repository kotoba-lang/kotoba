(ns kotoba.abi.app-world
  "kotoba-app world v0.2 —— 名前付き import と app.call / ito.append。

  root ADR-2610082200（P1）: world v0.2 は identity.sign・hash・
  object-store・log・clock の名前付き import と、app.call・ito.append の
  export を持つ。対応表の正本は spec/kotoba-app-world-v2.edn。

  これは render の追加であって、`kotoba.abi.component/world-wit-v2` の
  純粋 render（export main のみ）は変えない。consumer（amu /
  kototama-component）の切り替えは別 PR で行う。"
  {:kotoba/export [app-world-v2-imports app-world-v2-exports app-world-wit-v02]})

(def app-world-v2-imports
  "世界 v0.2 が許す名前付き import。contract-name が ADR の語、
  wit-name が WIT の識別子（kebab、ドット無し）。"
  [{:contract-name "identity.sign" :wit-name "identity-sign"}
   {:contract-name "hash" :wit-name "hash"}
   {:contract-name "object-store" :wit-name "object-store"}
   {:contract-name "log" :wit-name "log"}
   {:contract-name "clock" :wit-name "clock"}])

(def app-world-v2-exports
  [{:contract-name "app.call" :wit-name "app-call"}
   {:contract-name "ito.append" :wit-name "ito-append"}
   {:contract-name "main" :wit-name "main"}])

(defn app-world-wit-v02
  "Render kotoba:app@0.2.0 with the P1 named imports and exports. Scalar
  s64 signatures follow the v1 render; typing refinements ride the v3 typed
  capability profile, not this contract surface."
  []
  (str "package kotoba:app@0.2.0;\n\nworld kotoba-app {\n"
       (apply str (map #(str "  import " (:wit-name %) ": func(value: s64) -> s64;\n")
                       app-world-v2-imports))
       "  export main: func() -> s64;\n"
       (apply str (map #(str "  export " (:wit-name %) ": func(value: s64) -> s64;\n")
                       (remove #(= "main" (:wit-name %)) app-world-v2-exports)))
       "}\n"))
