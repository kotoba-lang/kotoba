{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kotoba-lang/abi/schemas/component-admission-v1.schema.json",
  "title": "Kotoba Component admission envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "wasi-version", "profile", "imports", "exports", "grants", "provider-bindings", "abilities", "runtime-bindings", "ambient-wasi", "budgets", "identity"],
  "properties": {
    "target": {"const": "wasm-component-kotoba-v1"},
    "wasi-version": {"const": "0.3.0"},
    "profile": {"enum": ["sync", "async"]},
    "imports": {"type": "array", "uniqueItems": true, "maxItems": 256},
    "exports": {"type": "array", "uniqueItems": true, "maxItems": 256},
    "grants": {"type": "array", "uniqueItems": true, "maxItems": 256},
    "provider-bindings": {"type": "object", "maxProperties": 256},
    "abilities": {"type": "object", "maxProperties": 256},
    "runtime-bindings": {
      "type": "object", "additionalProperties": false,
      "properties": {"component-host-sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "ambient-wasi": {"const": false},
    "budgets": {"type": "object"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component-cid", "package-lock-cid", "definition-cids"],
      "properties": {
        "component-cid": {"type": "string", "pattern": "^b"},
        "package-lock-cid": {"type": "string", "pattern": "^b"},
        "definition-cids": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"type": "string", "pattern": "^b"}, "uniqueItems": true}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"imports": {"minItems": 1}}},
    "then": {"properties": {"runtime-bindings": {"required": ["component-host-sha256"]}}},
    "else": {"properties": {"runtime-bindings": {"maxProperties": 0}}}
  }]
}
