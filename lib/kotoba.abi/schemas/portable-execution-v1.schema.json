{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kotoba-lang/abi/schemas/portable-execution-v1.schema.json",
  "title": "Kotoba portable execution contract v1",
  "$defs": {
    "cid": {"type": "string", "pattern": "^b.+"},
    "cid-list": {"type": "array", "items": {"$ref": "#/$defs/cid"}, "uniqueItems": true},
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "plan-cid", "code-closure-cid", "artifact-cid", "compiler-contract", "requested-effects", "requested-resources", "input-cid", "budget"],
      "properties": {
        "format": {"const": "kotoba.plan/v1"},
        "plan-cid": {"$ref": "#/$defs/cid"}, "code-closure-cid": {"$ref": "#/$defs/cid"},
        "artifact-cid": {"$ref": "#/$defs/cid"}, "compiler-contract": {"$ref": "#/$defs/cid"},
        "requested-effects": {"type": "array", "uniqueItems": true, "maxItems": 256},
        "requested-resources": {"type": "array", "uniqueItems": true, "maxItems": 256},
        "input-cid": {"$ref": "#/$defs/cid"}, "budget": {"type": "object"}
      }
    },
    "policy-decision": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "decision-cid", "plan-cid", "policy-cid", "db-basis", "result", "reasons", "issued-at", "expires-at"],
      "properties": {
        "format": {"const": "kotoba.policy-decision/v1"},
        "decision-cid": {"$ref": "#/$defs/cid"}, "plan-cid": {"$ref": "#/$defs/cid"},
        "policy-cid": {"$ref": "#/$defs/cid"}, "db-basis": {"$ref": "#/$defs/cid"},
        "result": {"enum": ["permit", "deny"]}, "reasons": {"type": "array", "maxItems": 256},
        "issued-at": {"type": "string"}, "expires-at": {"type": "string"}
      }
    },
    "capability-lease": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "capability-cid", "execution-identity-cid", "component-cid", "resource-cid", "purpose", "expires-at", "uses", "transfer", "delegation-depth"],
      "properties": {
        "format": {"const": "kotoba.capability-lease/v1"},
        "capability-cid": {"$ref": "#/$defs/cid"}, "execution-identity-cid": {"$ref": "#/$defs/cid"},
        "component-cid": {"$ref": "#/$defs/cid"}, "resource-cid": {"$ref": "#/$defs/cid"},
        "purpose": {"type": "string"}, "expires-at": {"type": "string"},
        "uses": {"type": "integer", "minimum": 1},
        "transfer": {"enum": ["non-transferable", "same-component"]},
        "delegation-depth": {"type": "integer", "minimum": 0}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "approval-cid", "plan-cid", "policy-cid", "db-basis", "resources", "input-cid", "approver-cid", "issued-at", "expires-at"],
      "properties": {
        "format": {"const": "kotoba.approval/v1"},
        "approval-cid": {"$ref": "#/$defs/cid"}, "plan-cid": {"$ref": "#/$defs/cid"},
        "policy-cid": {"$ref": "#/$defs/cid"}, "db-basis": {"$ref": "#/$defs/cid"},
        "resources": {
          "type": "array",
          "uniqueItems": true, "minItems": 1, "maxItems": 256
        },
        "input-cid": {"$ref": "#/$defs/cid"}, "approver-cid": {"$ref": "#/$defs/cid"},
        "issued-at": {"type": "string"}, "expires-at": {"type": "string"}
      }
    },
    "execution-identity": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "plan-cid", "code-closure-cid", "artifact-cid", "compiler-contract", "component-cid", "wit-world-cid", "package-lock-cid", "policy-cid", "policy-decision-cid", "db-basis", "grant-cids", "approval-cids", "runtime-identity", "input-cid", "outcome-cid", "host-receipt-cids"],
      "properties": {
        "format": {"const": "kotoba.execution-identity/v1"},
        "plan-cid": {"oneOf": [{"$ref": "#/$defs/cid"}, {"type": "null"}]},
        "code-closure-cid": {"$ref": "#/$defs/cid"}, "artifact-cid": {"$ref": "#/$defs/cid"},
        "compiler-contract": {"$ref": "#/$defs/cid"},
        "component-cid": {"oneOf": [{"$ref": "#/$defs/cid"}, {"type": "null"}]},
        "wit-world-cid": {"oneOf": [{"$ref": "#/$defs/cid"}, {"type": "null"}]},
        "package-lock-cid": {"$ref": "#/$defs/cid"}, "policy-cid": {"$ref": "#/$defs/cid"},
        "policy-decision-cid": {"$ref": "#/$defs/cid"}, "db-basis": {"$ref": "#/$defs/cid"},
        "grant-cids": {"$ref": "#/$defs/cid-list"}, "approval-cids": {"$ref": "#/$defs/cid-list"},
        "runtime-identity": {"$ref": "#/$defs/cid"}, "input-cid": {"$ref": "#/$defs/cid"},
        "outcome-cid": {"$ref": "#/$defs/cid"}, "host-receipt-cids": {"$ref": "#/$defs/cid-list"}
      },
      "allOf": [{
        "if": {"properties": {"component-cid": {"type": "null"}}},
        "then": {"properties": {"wit-world-cid": {"type": "null"}}},
        "else": {"properties": {"wit-world-cid": {"$ref": "#/$defs/cid"}}}
      }]
    }
  }
}
