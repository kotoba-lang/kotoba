(ns kotoba.abi.boundary-layout-test
  "The boundary layout is shape-and-layout only. These assertions keep a
  judgment, a policy or an implementation note from drifting into
  kotoba.abi.boundary-layout unnoticed."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.abi.boundary-layout :as boundary-layout]))

(deftest boundary-layout-shape
  (let [c boundary-layout/boundary-layout]
    (is (= 1 (:boundary.layout/version c)))
    (is (= "kotoba-lang/abi" (:owner c)))
    (is (= :accepted (:status c)))
    (is (= :kotoba.lisp-machine/boundary-v1 (:boundary-schema c)))
    (is (= :kotoba.lisp-machine/boundary-v1 boundary-layout/boundary-schema))))

(deftest boundary-layout-is-layout-only
  (let [c boundary-layout/boundary-layout
        excluded (set (-> c :scope :not))]
    (is (every? excluded [:judgment :policy :implementation :wire-codec])
        "judgment / policy / implementation / wire codec stay outside this repo")
    (testing "no nested layout entry decides anything"
      (is (not-any? #(or (contains? % :judgment) (contains? % :policy))
                    (vals (:layout c)))))))

(deftest boundary-layout-domain
  (is (= [:host-guest] (boundary-layout/layout-domains)))
  (let [hg (-> boundary-layout/boundary-layout :layout :host-guest)]
    (is (= :canonical-abi-lift-lower (:shape hg)))
    (is (= [:wasm-component-kotoba-v1 :wasm-component-kotoba-v2]
           (:targets-owned-by-profiles hg)))
    (is (= :kotoba.component-binding/v1 (:component-binding hg)))
    (is (true? (:v1-wire-and-wit-unchanged hg)))
    (is (true? (:unknown-target-profile-refused hg)))))

(deftest boundary-layout-inherits-the-six-rules
  (is (= [:judgment-free
          :unknown-shape-fail-closed
          :canonical-bytes-before-cid
          :versioned-wire-keys-preserved
          :no-secrets
          :host-object-transparent]
         (boundary-layout/layout-rules-inherited))))
