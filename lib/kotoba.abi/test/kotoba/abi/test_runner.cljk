(ns kotoba.abi.test-runner
  (:require [kotoba.test :as test]
            [kotoba.abi.app-world-test]
            [kotoba.abi.boundary-layout-test]
            [kotoba.abi.contract-test]
            [kotoba.abi.mon-test]
            [kotoba.abi.split-test]
            [kotoba.abi.target-test]
            [kotoba.abi.wit-data-test]))

(defn -main [& _]
  (let [result (test/run-tests 'kotoba.abi.app-world-test
             'kotoba.abi.boundary-layout-test
             'kotoba.abi.contract-test
             'kotoba.abi.mon-test
             'kotoba.abi.split-test
             'kotoba.abi.target-test
                               'kotoba.abi.wit-data-test)]
    (when (pos? (+ (:fail result) (:error result)))
      (System/exit 1))))
