(ns kotoba.abi.target-test
  (:require #?(:clj [kotoba.test :refer [deftest is]]
               :cljs [cljs.test :refer [deftest is]])
            [kotoba.abi.target :as target]
            [kotoba.abi.component :as component]))

(def cid "bafkreid4qjrk54dtbrpa4zx3b2umgsvevohcm7z436igajsdd34khleu2q")

(deftest every-declared-profile-is-closed
  (is (= 23 (count target/profiles)))
  (doseq [[target-id physical] target/profiles
          profile [:sync :async]]
    (if (and (= :evm (:family physical)) (= :async profile))
      (is (nil? (target/profile-contract target-id profile)))
      (let [layout (if (= :component (:family physical))
                     {:component-cid cid :wit-world-cid cid :wasi-version component/wasi-version}
                     (cond-> (:layout physical)
                       (seq (:context-versions physical)) (assoc :context-version 11)))
            binding {:format :kotoba.target-binding/v2 :target target-id :profile profile
                     :profile-contract-cid cid :artifact-cid cid :interface-cid cid
                     :runtime-identity cid :layout layout}]
        (is (target/valid-binding? binding))
        (doseq [k (keys binding)] (is (not (target/valid-binding? (dissoc binding k)))))
        (is (not (target/valid-binding? (assoc binding :ambient true))))
        (is (not (target/valid-binding? (assoc binding :layout (assoc layout :extra true)))))
        (is (not (target/valid-binding? (assoc binding :runtime-identity "banana")))))))
  (is (nil? (target/profile-contract :unknown :sync)))
  (is (nil? (target/profile-contract :x86_64-kotoba-v1 :ambient))))

(deftest physical-metering-is-not-derived-from-wasm
  (is (= #{:fuel :memory-bytes :stack-bytes} (:budgets (target/profile-contract :aarch64-macos-kotoba-v1 :sync))))
  (is (= #{:fuel :max-frames} (:budgets (target/profile-contract :js-kotoba-v1 :sync))))
  (is (= #{:gas :step-limit} (:budgets (target/profile-contract :evm256-kotoba-v1 :sync))))
  (is (= #{:fuel :memory-pages} (:budgets (target/profile-contract :wasm32-kotoba-v1 :sync)))))
