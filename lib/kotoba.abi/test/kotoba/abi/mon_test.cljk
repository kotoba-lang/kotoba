(ns kotoba.abi.mon-test
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing]])
            [kotoba.abi.mon :as mon]))

(def cid "bafkreib76wmaln52547xmqh3f3qonsxuzujvhctwppvjxegwfyvavesgli")
(def cid2 "bafkreicawgyinhnv7dh6bgvubcbx32vls4l6z7zxegh7oyxkebzkuuaymu")

(defn- mon [& {:as overrides}]
  (merge {:mon/rules [cid]
          :mon/entry-types {"post" cid}
          :mon/properties {:title-limit 256}
          :mon/network-seed "seed-0"
          :mon/membrane cid}
         overrides))

(deftest a-complete-mon-passes-the-shape-gate
  (is (mon/valid-mon? (mon)))
  (is (mon/valid-mon? (mon :mon/rules [cid cid2]
                         :mon/entry-types {:post cid :comment cid2}
                         :mon/properties {}
                         :mon/network-seed "another-seed"))))

(deftest unknown-and-missing-keys-are-refused
  (is (not (mon/valid-mon? (dissoc (mon) :mon/membrane))))
  (is (not (mon/valid-mon? (assoc (mon) :mon/logic [cid]))))
  (is (not (mon/valid-mon? (assoc (mon) :format :kotoba.mon/v1)))))

(deftest rules-are-non-empty-unique-cids
  (is (not (mon/valid-mon? (mon :mon/rules []))))
  (is (not (mon/valid-mon? (mon :mon/rules "cid"))))
  (is (not (mon/valid-mon? (mon :mon/rules ["not-a-cid"]))))
  (is (not (mon/valid-mon? (mon :mon/rules [cid cid])))))

(deftest entry-types-map-names-to-schema-cids
  (is (not (mon/valid-mon? (mon :mon/entry-types {"post" "not-a-cid"}))))
  (is (not (mon/valid-mon? (mon :mon/entry-types {"post" nil}))))
  ;; 空の entry-types は形状として読める（網が entry を持たないのは
  ;; ポリシーの問題であって、形状 gate の拒否理由にしない）。
  (is (mon/valid-mon? (mon :mon/entry-types {}))))

(deftest membrane-and-seed-are-required-and-typed
  (is (not (mon/valid-mon? (mon :mon/membrane "not-a-cid"))))
  (is (not (mon/valid-mon? (mon :mon/membrane cid2 :mon/network-seed ""))))
  (is (not (mon/valid-mon? (mon :mon/network-seed nil))))
  (is (not (mon/valid-mon? (mon :mon/properties [])))))

(deftest mon-cid-excludes-logic-forms
  (is (= #{:logic-form-cids} (set (:excluded mon/mon-cid-derivation))))
  (is (= :dag-cbor (:encoding mon/mon-cid-derivation)))
  (is (= :dag-kotoba (:dag mon/mon-cid-derivation))))
