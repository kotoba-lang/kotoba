(ns kotoba.abi.split-test
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing]])
            [kotoba.abi.contract :as legacy]
            [kotoba.abi.component :as component]
            [kotoba.core.execution :as neutral]))

(def cid "bafkreid4qjrk54dtbrpa4zx3b2umgsvevohcm7z436igajsdd34khleu2q")
(def legacy-identity (:value (first (filter #(= :identity/valid-component (:id %))
                                          legacy/portable-execution-v1-vectors))))
(def binding {:format :kotoba.component-binding/v1
              :target :wasm-component-kotoba-v1 :profile :sync
              :profile-contract-cid cid :artifact-cid cid :interface-cid cid
              :component-cid cid :wit-world-cid cid :wasi-version "0.3.0"})

(deftest v1-facade-preserves-vectors
  (is (= 10 (count legacy/portable-execution-v1-vectors)))
  (doseq [v legacy/portable-execution-v1-vectors]
    (is (= (:expect v) (if (legacy/conformance-result v) :accept :reject)))
    (is (= (legacy/conformance-result v) (component/conformance-result v))))
  (is (= legacy/plan-keys neutral/plan-keys))
  (is (= legacy/ability-keys neutral/ability-keys))
  (is (legacy/valid-execution-identity? legacy-identity))
  (is (not (neutral/valid-execution-identity? legacy-identity))))

(deftest explicit-component-binding-and-lossless-projection
  (is (component/valid-binding? binding))
  (doseq [k (keys binding)] (is (not (component/valid-binding? (dissoc binding k)))))
  (doseq [[k v] [[:target :native] [:profile :ambient] [:wasi-version "99"]
                [:component-cid "banana"] [:ambient-wasi true]]]
    (is (not (component/valid-binding? (assoc binding k v)))))
  (let [identity (component/migrate-execution-identity legacy-identity cid binding)]
    (is (neutral/valid-execution-identity? identity))
    (is (= cid (:profile-binding-cid identity)))
    (is (not (legacy/valid-execution-identity? identity)))
    (is (= legacy-identity (component/restore-execution-identity identity cid binding)))
    (try (component/restore-execution-identity identity cid (assoc binding :artifact-cid "bafkreibm6jg3ux5qumhcn2b3flc3tyu6dmlb4xa7u5bf44yeg5ti6edjmu"))
         (is false "artifact substitution must reject")
         (catch #?(:clj Exception :cljs :default) e
           (is (= :binding-mismatch (:reason (ex-data e)))))))
  (try (component/migrate-execution-identity
        (assoc legacy-identity :component-cid nil :wit-world-cid nil) cid binding)
       (is false "nil-component compatibility is not a Component binding")
       (catch #?(:clj Exception :cljs :default) e
         (is (= :binding-mismatch (:reason (ex-data e)))))))
