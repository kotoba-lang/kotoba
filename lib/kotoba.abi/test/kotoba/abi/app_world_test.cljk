(ns kotoba.abi.app-world-test
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing]])
            [clojure.string :as str]
            [kotoba.abi.app-world :as app-world]))

(deftest the-v02-world-carries-the-adr-names
  (is (= ["identity.sign" "hash" "object-store" "log" "clock"]
         (mapv :contract-name app-world/app-world-v2-imports)))
  (is (= ["app.call" "ito.append" "main"]
         (mapv :contract-name app-world/app-world-v2-exports))))

(deftest wit-names-are-kebab-identifiers
  (doseq [entry (concat app-world/app-world-v2-imports
                        app-world/app-world-v2-exports)]
    (is (re-matches #"[a-z0-9-]+" (:wit-name entry)))))

(deftest the-render-is-a-v02-world-with-named-imports-and-the-two-exports
  (let [wit (app-world/app-world-wit-v02)]
    (is (str/includes? wit "package kotoba:app@0.2.0;"))
    (is (str/includes? wit "world kotoba-app {"))
    (doseq [entry app-world/app-world-v2-imports]
      (is (str/includes? wit (str "import " (:wit-name entry) ": func(value: s64) -> s64;"))))
    (is (str/includes? wit "export main: func() -> s64;"))
    (is (str/includes? wit "export app-call: func(value: s64) -> s64;"))
    (is (str/includes? wit "export ito-append: func(value: s64) -> s64;"))
    ;; ambient WASI は無い: import は宣言した 5 つだけ。
    (is (= (count app-world/app-world-v2-imports)
           (count (re-seq #"  import " wit))))
    (is (not (str/includes? wit "wasi")))))
