;; Canonical WIT embedding generator. Build with Amu selfhost.
;; Runtime input: an absolute repository root, optionally followed by --check.
;; The capability grant must cover only the fixed WIT input and output below.
(ns kotoba.abi.generate-wit-data
  {:kotoba/export [render-wit-data main]}
  (:capabilities #{:cli/args :fs/app-data :io/write :io/write-error}))

(defn- append [left :string right :string] :string
  (string-concat left right))

(defn- ascii [value :i64] :string
  (string-from-utf8
   (bytes-from-vector-i64
    (vector-assoc! (vector-alloc 1) 0 value))))

(defn- hex-digit [value :i64] :string
  (string-substring "0123456789abcdef" value (+ value 1)))

(defn- control-escape [value :i64] :string
  (case value
    8 "\\b"
    9 "\\t"
    10 "\\n"
    12 "\\f"
    13 "\\r"
    (append "\\u00" (append (hex-digit (quot value 16))
                            (hex-digit (mod value 16))))))

(defn- source-string [text :string] :string
  ;; Replace backslash before adding escapes, preserving all UTF-8 bytes.
  ;; The bounded 32-pass scan also handles controls not present in this WIT.
  (let [slashes (string-replace-all text "\\" "\\\\")
        quotes (string-replace-all slashes "\"" "\\\"")]
    (loop [value 0 escaped quotes]
      (if (>= value 32)
        (append "\"" (append escaped "\""))
        (recur (+ value 1)
               (string-replace-all escaped (ascii value)
                                   (control-escape value)))))))

(defn render-wit-data [text :string] :string
  (append
   "(ns kotoba.abi.wit-data\n  \"GENERATED from wit/aiueos-capability-v2/aiueos-capability.wit by scripts/gen_wit_data.kotoba.\"\n  {:kotoba/export [aiueos-capability-v2-wit files]})\n\n(defn aiueos-capability-v2-wit [] :string\n  "
   (append
    (source-string text)
    ")\n\n(defn files\n  \"Export symbol -> authoritative WIT resource path.\"\n  [] [:map :symbol :string]\n  (typed-map-new [:map :symbol :string]\n                 (symbol \"aiueos-capability-v2-wit\")\n                 \"aiueos-capability-v2/aiueos-capability.wit\"))\n")))

(defn- cli-arg [index :i64] :string
  (typed-cap-call :cli/args :string :string (string-from-i64 index)))

(defn- refuse [message :string] :i64
  (do
    (typed-cap-call :io/write-error :string :string
                    (append "WIT-GENERATOR REFUSED: " (append message "\n")))
    1))

(defn- root-path? [root :string] :bool
  ;; The provider's filesystem scope is authoritative. Reject ambiguous wire
  ;; separators in the caller's root before constructing a fixed-path request.
  (and (> (string-byte-length root) 0)
       (<= (string-byte-length root) 4096)
       (string=? (string-substring root 0 1) "/")
       (< (string-index-of root "\n") 0)
       (< (string-index-of root (ascii 0)) 0)
       (< (string-index-of root "_SEP") 0)))

(defn- joined [root :string relative :string] :string
  (let [n (string-byte-length root)]
    (if (string=? (string-substring root (- n 1) n) "/")
      (append root relative)
      (append root (append "/" relative)))))

(defn- exists? [path :string] :bool
  (string=? (typed-cap-call :fs/app-data :string :string
                            (append path "EXISTS_SEP"))
            "1"))

(defn- checked-write [path :string text :string] :i64
  (let [reply (typed-cap-call :fs/app-data :string :string
                              (append path (append "WRITE_SEP" text)))]
    (if (and (string=? reply text)
             (exists? path)
             (string=? (typed-cap-call :fs/app-data :string :string path) text))
      (do (typed-cap-call :io/write :string :string
                          "wrote src/kotoba/abi/wit_data.kotoba\n")
          0)
      (refuse "generated output write/readback failed"))))

(defn- generate [root :string check-only :bool] :i64
  (let [input (joined root "wit/aiueos-capability-v2/aiueos-capability.wit")
        output (joined root "src/kotoba/abi/wit_data.kotoba")]
    (if (not (exists? input))
      (refuse "authoritative WIT input is absent or unreadable")
      (let [text (typed-cap-call :fs/app-data :string :string input)]
        (if (or (= (string-byte-length text) 0)
                (> (string-byte-length text) 65536))
          (refuse "authoritative WIT must contain 1..65536 UTF-8 bytes")
          (let [generated (render-wit-data text)]
            (if check-only
              (if (and (exists? output)
                       (string=? (typed-cap-call :fs/app-data :string :string output)
                                 generated))
                (do (typed-cap-call :io/write :string :string
                                    "WIT-GENERATOR MATCH: embedded source is current\n")
                    0)
                (refuse "embedded source is absent, unreadable or stale"))
              (checked-write output generated))))))))

(defn main [] :i64
  (let [count-text (typed-cap-call :cli/args :string :string "")
        count (option-value-of [:option :i64] (parse-long count-text) -1)]
    (if (not (or (= count 1) (= count 2)))
      (refuse "expected ABSOLUTE_REPOSITORY_ROOT [--check]")
      (let [root (cli-arg 0)
            check-only (= count 2)]
        (if (not (root-path? root))
          (refuse "repository root must be an absolute path without NUL/newline/wire separators")
          (if (and check-only (not (string=? (cli-arg 1) "--check")))
            (refuse "unknown option; expected --check")
            (generate root check-only)))))))
