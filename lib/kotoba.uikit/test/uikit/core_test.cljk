(ns uikit.core-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.text :as str]
            [kotoba-ui.core :as ui]
            [uikit.core :as tk]))

(deftest mobile-panel-defaults-test
  (testing "uikit panel defaults to clear/floating, distinct from kotoba-ui.core's bare :regular/:raised"
    (let [html (ui/->html (tk/panel ["x"]))]
      (is (str/includes? html "liquid-glass__panel--clear"))
      (is (str/includes? html "liquid-glass__panel--floating")))))

(deftest mobile-list-view-defaults-test
  (testing "uikit list-view default matches the plain :regular surface — no modifier class, unlike appkit's :thick"
    (is (not (str/includes? (ui/->html (tk/list-view [])) "liquid-glass__list--")))))

(deftest caller-opts-win-test
  (testing "explicit opts override uikit defaults, same merge contract as every kotoba-ui wrap"
    (let [html (ui/->html (tk/panel ["x"] {:surface :thick}))]
      (is (str/includes? html "liquid-glass__panel--thick"))
      (is (not (str/includes? html "liquid-glass__panel--clear"))))))

(deftest passthrough-components-are-just-kotoba-ui-test
  (testing "components with no per-screen-shape variance point are re-exported as-is, not wrapped"
    (is (identical? ui/sheet ui/sheet))
    (is (identical? ui/alert ui/alert))))
