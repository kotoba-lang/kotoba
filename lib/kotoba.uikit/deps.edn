{:paths ["src"]
 ;; Touch/mobile/card-first platform binding on top of kotoba-ui.core —
 ;; supplies default option maps only (clear/regular surfaces, floating
 ;; elevation). Owns no tokens/CSS/component logic; never modifies
 ;; shitsuke/liquid-glass-ui/kotoba-ui. See docs/adr/0001-uikit.md.
 ;; kotoba-ui is named by GIT COORDINATE, not :local/root.
 ;;
 ;; A library whose :deps use :local/root cannot build a classpath outside a monorepo
 ;; checkout -- tools.deps resolves "../kotoba-ui" relative to the CONSUMER's gitlibs
 ;; directory, where nothing of the sort exists. So an app that follows this workspace's
 ;; own UI rule (require kotoba-ui.core plus uikit.core) could not be built by anyone
 ;; outside it. appkit, the other platform binding, already names it by coordinate; this
 ;; asymmetry meant the touch/mobile half of the pair was the unusable one.
 ;;
 ;; The :local alias below is how workspace development keeps using the checkout.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/kotoba-ui {:local/root "../kotoba.kotobaUi"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :local {:override-deps {io.github.kotoba-lang/kotoba-ui {:local/root "../kotoba-ui"}}}}}
