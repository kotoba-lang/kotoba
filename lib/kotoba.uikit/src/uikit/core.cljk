(ns uikit.core
  "Touch / mobile / card-first platform binding on top of kotoba-ui.core (see
  90-docs/adr/2607022800-kotoba-lang-default-uiux-appkit-uikit-interface-fundamentals.md).

  uikit owns no tokens/CSS/component logic. Of kotoba-ui.core's 32
  components, only `panel` (`:surface`/`:elevation`) and `list-view`
  (`:surface`) actually take a surface/elevation opt in liquid-glass-ui v1 —
  every other component (`toolbar`/`nav-bar`/`sheet`/`alert`/`button`/…) has
  a fixed glass look with no per-screen-shape variance point, so uikit wraps
  only those two and re-exports the rest as-is; there is nothing to
  differentiate. Caller-supplied opts always win over these defaults, same
  merge contract as every other kotoba-ui wrap. Mirrors Apple UIKit's role
  against SwiftUI (kotoba-ui.core): screen-shape defaults, not a new
  component catalog. Target consumers: gftd.ai chat, isekai.network game
  cards — see the superproject ADR's provisional product mapping."
  (:require [kotoba-ui.core :as ui]))

(def default-panel-opts
  "Mobile cards read as floating over content, single-column stacked — clear
  surface keeps the card light against whatever scrolls behind it, floating
  elevation gives it the lifted-card read a dense desktop pane doesn't need."
  {:surface :clear :elevation :floating})

(def default-list-view-opts
  {:surface :regular})

(defn panel
  ([body] (panel body {}))
  ([body opts] (ui/panel body (merge default-panel-opts opts))))

(defn list-view
  ([rows] (list-view rows {}))
  ([rows opts] (ui/list-view rows (merge default-list-view-opts opts))))

;; Semantic product primitives need no platform-specific defaults.
(def metric ui/metric)
(def empty-state ui/empty-state)
(def data-table ui/data-table)
