{:paths ["src"]
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/json {:local/root "../kotoba.json"}
        io.github.kotoba-lang/eth-crypto {:local/root "../kotoba.ethCrypto"}}
 :aliases
 {;; org.babashka/http-client is a TEST-only dep (the reference
  ;; kotoba.lang.base-l2.rpc/ITransport adapter under test/, exercised
  ;; against l2_test.clj's mock JSON-RPC HTTP server) -- the pure
  ;; src/ core carries zero HTTP-client dep, matching kotoba-lang/ipfs's
  ;; "zero vendor/SDK deps in the core" rule.
  :test {:extra-paths ["test" "test/resources"]
         :extra-deps {org.babashka/http-client {:mvn/version "0.4.22"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
