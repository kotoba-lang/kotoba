(ns ocio.transform-test
  "Colour transforms have published answers, so this suite is written against
  them rather than against its own output. Two matrices are reproduced to every
  digit their standards print — that is what makes the derivation, rather than
  a transcription, defensible."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.text :as str]
            [ocio.transform :as t]
            [ocio.core :as o]))

(defn- close? [a b tol] (< (Math/abs (- (double a) (double b))) tol))
(defn- mat-close? [m expected tol]
  (every? true? (map (fn [r e] (every? true? (map #(close? %1 %2 tol) r e))) m expected)))

(deftest derived-matrices-match-the-published-ones
  (testing "sRGB / Rec.709 primaries under D65 — IEC 61966-2-1"
    (is (mat-close? (t/to-xyz-matrix :linear-srgb)
                    [[0.4124564 0.3575761 0.1804375]
                     [0.2126729 0.7151522 0.0721750]
                     [0.0193339 0.1191920 0.9503041]]
                    1.0e-7)))

  (testing "ACES AP1 under D60 — the ACEScg matrix ACES publishes"
    (is (mat-close? (t/to-xyz-matrix :acescg)
                    [[0.6624542 0.1340042 0.1561877]
                     [0.2722287 0.6740818 0.0536895]
                     [-0.0055746 0.0040607 1.0103391]]
                    1.0e-7)))

  (testing "the white point form is not a detail"
    ;; Deriving sRGB from the ROUNDED chromaticities instead of the tabulated
    ;; tristimulus values misses the published matrix by ~7e-5 — small enough
    ;; to look like noise and large enough to disagree with every other tool.
    (let [rounded (t/primaries->matrix {:red [0.64 0.33] :green [0.30 0.60]
                                        :blue [0.15 0.06] :white [0.3127 0.3290]})]
      (is (not (mat-close? rounded [[0.4124564 0.3575761 0.1804375]
                                    [0.2126729 0.7151522 0.0721750]
                                    [0.0193339 0.1191920 0.9503041]]
                           1.0e-6)))
      (is (close? (get-in rounded [0 0]) 0.4124564 1.0e-4)))))

(deftest white-stays-white-across-white-points
  ;; ACES is D60 and sRGB is D65. Without chromatic adaptation a white frame
  ;; comes out tinted, and it comes out tinted by an amount small enough that
  ;; nobody notices until a client does.
  (doseq [space [:acescg :aces2065-1 :rec2020 :display-p3 :rec709]]
    (testing (str "sRGB white -> " space)
      (is (every? #(close? % 1.0 1.0e-9) (t/convert :srgb space [1.0 1.0 1.0]))))))

(deftest every-pair-round-trips
  (doseq [a (sort (t/known-spaces)) b (sort (t/known-spaces))
          :let [v [0.2 0.5 0.8]]]
    (is (every? true? (map #(close? %1 %2 1.0e-9) (t/convert b a (t/convert a b v)) v))
        (str a " -> " b " -> " a))))

(deftest transfer-functions-hit-their-published-points
  (testing "sRGB EOTF at half signal"
    (is (close? (first (t/decode :srgb [0.5 0.5 0.5])) 0.2140411 1.0e-7)))
  (testing "the sRGB curve is piecewise and the pieces meet"
    (is (close? (first (t/decode :srgb [0.04045 0 0])) (/ 0.04045 12.92) 1.0e-12))
    (is (close? (first (t/encode :srgb [0.0031308 0 0])) (* 12.92 0.0031308) 1.0e-12)))
  (testing "ACEScct maps 0.0 to its published offset, not to 0"
    (is (close? (first (t/encode :acescct [0.0 0.0 0.0])) 0.0729055341958355 1.0e-15)))
  (testing "ACEScct is invertible across its break"
    (doseq [v [0.0 0.001 0.0078125 0.05 0.18 1.0 16.0]]
      (is (close? (first (t/decode :acescct (t/encode :acescct [v v v]))) v 1.0e-9)))))

(deftest it-refuses-a-space-it-does-not-know
  ;; Silently passing an unknown space through as identity is the failure this
  ;; library exists to prevent: values arrive labelled ACES and are not ACES.
  (is (thrown? clojure.lang.ExceptionInfo (t/convert :srgb :prophoto [1 1 1])))
  (is (str/includes? (try (t/to-xyz-matrix :prophoto)
                          (catch clojure.lang.ExceptionInfo e (.getMessage e)))
                     "Known:")))

(deftest the-config-carries-the-matrix-that-was-computed
  ;; An .ocio config names transforms; this library now also performs them. If
  ;; the config held a second, pasted copy of the matrix the two could drift,
  ;; and a pipeline would grade against one and render with the other.
  (let [m (t/transform-matrix :acescg :aces2065-1)   ; the 3x3
        cfg (o/config {:version 2
                       :roles {:scene_linear "ACEScg"}
                       :colorspaces [(o/colorspace
                                      {:name "ACEScg" :family "ACES"
                                       :to_reference (o/xf "MatrixTransform"
                                                           {:matrix (t/matrix-transform
                                                                     :acescg :aces2065-1)})})]})]
    (is (= 16 (count (t/matrix-transform :acescg :aces2065-1))))
    (is (str/includes? cfg "to_reference: !<MatrixTransform>"))
    (is (str/includes? cfg (str (double (get-in m [0 0]))))
        "the emitted config contains the computed coefficient itself")
    (testing "and that matrix is the ACES AP1 -> AP0 one"
      ;; published: 0.6954522414, 0.1406786965, 0.1638690622 in the first row
      (is (close? (get-in m [0 0]) 0.6954522414 1.0e-7))
      (is (close? (get-in m [0 1]) 0.1406786965 1.0e-7))
      (is (close? (get-in m [0 2]) 0.1638690622 1.0e-7)))))
