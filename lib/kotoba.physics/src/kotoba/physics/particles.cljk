(ns kotoba.physics.particles
  "Particles: emission, forces, ageing, collision — deterministic from a seed.

  A VFX particle system is mostly bookkeeping, and the bookkeeping is where it
  goes wrong in ways a render hides:

  - **Emission rate is a rate, not a per-frame count.** Emitting
    `floor(rate * dt)` particles per step loses the fraction every step: at 30
    particles per second and 60 fps that is `floor(0.5) = 0` forever. The
    remainder has to be carried, and then the count over a given duration is
    the same whether the sim ran at 30, 60 or 240 steps per second. That
    property is asserted here, because a system that silently emits fewer
    particles at a higher frame rate looks like a tuning problem for weeks.
  - **Determinism has to survive the host.** `rand` is not reproducible and
    ClojureScript numbers are doubles, so the generator here is an explicit
    xorshift in int32 arithmetic, seeded per system and advanced per particle.
    The same seed gives the same particles on the JVM and in a browser.
  - **The integrator has a closed form and should be held to it.**
    Semi-implicit Euler under constant gravity gives exactly
    `x_n = x_0 + n dt v_0 + g dt^2 n(n+1)/2`. Not approximately.

  Not here: turbulence and curl noise fields, particle-particle interaction,
  sorting for transparent rendering, sprite/mesh instancing, GPU simulation,
  and sub-frame emission placement (particles born within a step all start at
  its end, which shows as banding at low frame rates)."
  (:require [kotoba.lang.text :as string]))

(defn- v+ [a b] (mapv + a b))
(defn- vs [a s] (mapv #(* s %) a))

;; ---------------------------------------------------------------------------
;; Deterministic randomness. Same seed, same stream, on every host.
;; ---------------------------------------------------------------------------

(defn- i32 [x] #?(:clj (unchecked-int x) :cljs (bit-or 0 x)))

(defn- shl
  "int32 left shift. On the JVM `bit-shift-left` widens to a LONG and keeps the
  bits that shift past bit 31 — bits that a 32-bit generator has thrown away.

  Measured: removing this truncation changes NOTHING, because the mask in
  `ushr` and the `i32` at the end of `xorshift32` each discard those bits
  before they can reach a result. It is kept because the invariant it states
  is the one the rest of the namespace relies on, not because it is currently
  load-bearing — and that distinction is recorded here rather than left for
  someone to rediscover by breaking it and seeing a green suite."
  [x n]
  (i32 (bit-shift-left (i32 x) n)))

(defn- ushr
  "int32 logical right shift. Same asymmetry in the other direction: on the JVM
  the value has to be masked to 32 bits BEFORE the shift, or a negative int's
  sign extension shifts back in."
  [x n]
  #?(:clj (i32 (unsigned-bit-shift-right (bit-and (long (i32 x)) 0xffffffff) n))
     :cljs (unsigned-bit-shift-right x n)))

(defn- xorshift32
  "One xorshift step in int32, identical on JVM and ClojureScript.

  A VFX shot that cannot be re-rendered identically cannot be re-rendered at
  all, and `rand` is not reproducible on either host, so the generator is
  explicit. Measured 2026-08-22 while writing this: three separate places
  where JVM long arithmetic and JavaScript int32 arithmetic disagreed, each of
  which produced entirely plausible particles on both hosts — different ones."
  [x]
  (let [x (i32 x)
        x (bit-xor x (shl x 13))
        x (bit-xor x (ushr x 17))
        x (bit-xor x (shl x 5))]
    (i32 x)))

(defn- unit
  "A double in [0, 1) from a 32-bit state. Masked before dividing for the same
  reason `ushr` masks before shifting."
  [x]
  (let [u #?(:clj (bit-and (long (i32 x)) 0xffffffff)
             :cljs (unsigned-bit-shift-right x 0))]
    (/ u 4294967296.0)))

(defn- next-rng [state] (xorshift32 (if (zero? state) 2463534242 state)))

;; ---------------------------------------------------------------------------
;; Systems
;; ---------------------------------------------------------------------------

(defn system
  "A particle system.

  `:rate` particles per second, `:lifetime` seconds, `:position` the emitter,
  `:velocity` the mean initial velocity, `:spread` the half-width of the
  uniform jitter added to it per axis, `:seed` an integer."
  [{:keys [rate lifetime position velocity spread seed]
    :or {rate 100.0 lifetime 1.0 position [0.0 0.0 0.0]
         velocity [0.0 1.0 0.0] spread 0.0 seed 12345}}]
  {:particles/particles []
   :particles/rate (double rate)
   :particles/lifetime (double lifetime)
   :particles/position (mapv double position)
   :particles/velocity (mapv double velocity)
   :particles/spread (double spread)
   :particles/rng (int seed)
   :particles/pending 0.0          ; the fraction of a particle owed
   :particles/emitted 0
   :particles/time 0.0})

(defn count-alive [sys] (count (:particles/particles sys)))

(defn- spawn-one [{:keys [particles/rng particles/spread particles/velocity
                          particles/position particles/lifetime] :as sys}]
  (let [[r v] (reduce (fn [[r acc] i]
                        (let [r' (next-rng r)]
                          [r' (conj acc (+ (nth velocity i)
                                           (* spread (- (* 2.0 (unit r')) 1.0))))]))
                      [rng []] (range 3))]
    (-> sys
        (assoc :particles/rng r)
        (update :particles/particles conj
                {:particle/position position
                 :particle/velocity v
                 :particle/age 0.0
                 :particle/lifetime lifetime})
        (update :particles/emitted inc))))

(defn step-error [sys {:keys [dt]}]
  (cond
    (not (and (number? dt) (pos? dt)))
    (str "dt must be positive, got " (pr-str dt))
    (neg? (:particles/rate sys))
    (str "emission rate cannot be negative, got " (:particles/rate sys))
    (not (pos? (:particles/lifetime sys)))
    (str "lifetime must be positive, got " (:particles/lifetime sys)
         " — a particle that dies the instant it is born is not an effect,"
         " it is an emitter that emits nothing while reporting a rate")
    (not (integer? (:particles/rng sys)))
    (str "the generator state must be an integer seed, got "
         (pr-str (:particles/rng sys)) " — an unseeded system is not"
         " reproducible, and a VFX shot that cannot be re-rendered identically"
         " cannot be re-rendered at all")))

(defn step
  "Advance one timestep. Returns `[:ok sys]` or `[:error msg]`.

  `opts`: `:dt`, `:gravity` (default [0 -9.81 0]), `:drag` (per-second linear
  damping coefficient), `:colliders`, `:emitting?` (default true)."
  [sys {:keys [dt gravity drag colliders emitting?]
        :or {gravity [0.0 -9.81 0.0] drag 0.0 emitting? true}
        :as opts}]
  (if-let [e (step-error sys opts)]
    [:error e]
    (let [;; Emission first, carrying the fractional remainder. This is what
          ;; makes the count over a duration independent of the step size.
          owed (if emitting?
                 (+ (:particles/pending sys) (* (:particles/rate sys) dt))
                 (:particles/pending sys))
          n (long (#?(:clj Math/floor :cljs js/Math.floor) owed))
          spawned (reduce (fn [s _] (spawn-one s)) sys (range n))
          spawned (assoc spawned :particles/pending (- owed n))
          ;; Semi-implicit Euler: velocity first, then position from the NEW
          ;; velocity. That ordering is what makes the closed form exact.
          advanced (mapv (fn [p]
                           (let [v (-> (:particle/velocity p)
                                       (v+ (vs gravity dt))
                                       (vs (- 1.0 (* drag dt))))]
                             (assoc p :particle/velocity v
                                      :particle/position (v+ (:particle/position p) (vs v dt))
                                      :particle/age (+ (:particle/age p) dt))))
                         (:particles/particles spawned))
          collided (reduce
                    (fn [ps collider]
                      (case (:collider/kind collider)
                        :plane (let [{:collider/keys [point normal restitution]
                                      :or {restitution 0.0}} collider]
                                 (mapv (fn [p]
                                         (let [gap (reduce + (map * (map - (:particle/position p) point) normal))]
                                           (if (neg? gap)
                                             (let [vn (reduce + (map * (:particle/velocity p) normal))]
                                               (-> p
                                                   (update :particle/position v+ (vs normal (- gap)))
                                                   (assoc :particle/velocity
                                                          (v+ (:particle/velocity p)
                                                              (vs normal (* (- (+ 1.0 restitution)) vn))))))
                                             p)))
                                       ps))
                        ps))
                    advanced (or colliders []))
          alive (vec (remove #(>= (:particle/age %) (:particle/lifetime %)) collided))]
      [:ok (assoc spawned :particles/particles alive
                  :particles/time (+ (:particles/time sys) dt))])))

(defn simulate [sys opts n]
  (loop [s sys i 0]
    (if (= i n)
      [:ok s]
      (let [[status v] (step s opts)]
        (if (= :error status) [:error (str "step " i ": " v)] (recur v (inc i)))))))

(defn ballistic-position
  "Where semi-implicit Euler puts a particle after `n` steps under constant
  acceleration — exactly, in closed form.

  Provided so a caller can check the integrator rather than trust it: this is
  the value `simulate` must produce, not an approximation of it."
  [x0 v0 g dt n]
  (v+ (v+ x0 (vs v0 (* n dt)))
      (vs g (* dt dt (/ (* n (inc n)) 2.0)))))

(defn steady-state-count
  "How many particles a constant emitter holds once it has filled up: rate
  times lifetime. Also provided as a thing to check against."
  [sys]
  (* (:particles/rate sys) (:particles/lifetime sys)))
