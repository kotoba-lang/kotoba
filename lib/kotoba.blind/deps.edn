;; Zero runtime dependencies, on purpose: this is the L1 crypto layer, and
;; it uses only what the platform already ships (`javax.crypto` on the JVM,
;; Web Crypto on ClojureScript). Nothing here should ever grow a
;; third-party dep -- if it seems to need one, that is a design smell in
;; this library, not a missing library elsewhere.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
