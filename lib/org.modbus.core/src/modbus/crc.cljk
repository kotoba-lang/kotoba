(ns modbus.crc
  "CRC-16/MODBUS and the LRC the ASCII transmission mode uses.

  Two implementations of the CRC live here on purpose. `crc16-bitwise` is the
  definition — shift and conditionally xor, sixteen times per byte — and
  `crc16` is the nibble-table form the wire actually gets. Keeping both lets
  the test suite assert they agree over every two-byte input, which is a
  stronger statement than either one matching a constant somebody remembered.

  Parameters (CRC RevEng catalogue, CRC-16/MODBUS): width 16, polynomial
  0x8005 reflected to 0xA001, init 0xFFFF, no final xor, input and output
  both reflected. The check value for the ASCII string \"123456789\" is
  0x4B37.")

(def polynomial
  "0xA001 — 0x8005 with its bits reversed, because Modbus feeds the message
  in least-significant-bit first. Writing 0x8005 here and shifting the other
  way is the classic way to produce a CRC that is self-consistent and wrong."
  0xA001)

(defn crc16-bitwise
  "The definition, one bit at a time. Slow, and the thing the table form is
  checked against."
  [bs]
  (reduce (fn [crc b]
            (loop [crc (bit-xor crc (bit-and b 0xFF)) i 0]
              (if (= i 8)
                crc
                (recur (if (odd? crc)
                         (bit-xor (unsigned-bit-shift-right crc 1) polynomial)
                         (unsigned-bit-shift-right crc 1))
                       (inc i)))))
          0xFFFF
          bs))

(def ^:private nibble-table
  (mapv (fn [n]
          (loop [crc n i 0]
            (if (= i 4)
              crc
              (recur (if (odd? crc)
                       (bit-xor (unsigned-bit-shift-right crc 1) polynomial)
                       (unsigned-bit-shift-right crc 1))
                     (inc i)))))
        (range 16)))

(defn crc16
  "CRC-16/MODBUS of `bs`, as an integer 0..65535."
  [bs]
  (reduce (fn [crc b]
            (let [crc (bit-xor crc (bit-and b 0xFF))
                  crc (bit-xor (unsigned-bit-shift-right crc 4)
                               (nth nibble-table (bit-and crc 0x0F)))]
              (bit-xor (unsigned-bit-shift-right crc 4)
                       (nth nibble-table (bit-and crc 0x0F)))))
          0xFFFF
          bs))

(defn crc16-bytes
  "The CRC as it goes on the wire: **low byte first**.

  Modbus is big-endian everywhere else — register values, addresses,
  quantities — and little-endian for exactly this field. Getting it backwards
  produces a frame that looks right and is rejected by every device."
  [bs]
  (let [c (crc16 bs)]
    [(bit-and c 0xFF) (bit-and (unsigned-bit-shift-right c 8) 0xFF)]))

(defn lrc
  "The longitudinal redundancy check the ASCII mode uses: the two's
  complement of the sum of the bytes, mod 256."
  [bs]
  (bit-and (- (reduce (fn [a b] (bit-and (+ a b) 0xFF)) 0 bs)) 0xFF))
