(ns modbus.rtu
  "Modbus RTU and ASCII framing — §2.5 of the MODBUS over Serial Line
  Specification.

      RTU    address (1) | PDU | CRC-16 (2, LOW BYTE FIRST)
      ASCII  ':' | hex(address | PDU | LRC) | CR LF

  RTU has no start or end delimiter: a frame is delimited by 3.5 character
  times of silence on the line. That is a timing property, and nothing in a
  pure library can observe it — so `decode` takes a buffer the caller has
  already delimited, and its job is to check the checksum and split off the
  address. A caller reading from a real serial port owns the silence.

  Address 0 is the broadcast address and gets no reply. 248..255 are
  reserved."
  (:require [modbus.crc :as crc]
            [modbus.pdu :as pdu]
            [kotoba.lang.text :as str]))

(def broadcast-address 0)
(def max-unit-address 247)

(defn encode
  "`address` + PDU + CRC."
  [address pdu-bytes]
  (cond
    (not (<= 0 address 0xFF))
    {:status :error :reason :address-out-of-range :address address}
    (> (count pdu-bytes) pdu/max-pdu-bytes)
    {:status :error :reason :pdu-too-long :length (count pdu-bytes)}
    :else
    (let [body (into [address] pdu-bytes)]
      {:status :ok :bytes (into body (crc/crc16-bytes body))})))

(defn decode
  "Check the CRC and split a delimited RTU frame.

  Returns `{:status :ok :frame {:address n :pdu-bytes […]}}` or an error. A
  bad CRC is `:crc-mismatch` and carries both values, because on a noisy line
  the difference between them is diagnostic."
  [buf]
  (let [buf (vec buf) n (count buf)]
    (cond
      ;; address + at least a function code + CRC
      (< n 4) {:status :error :reason :frame-too-short :length n}
      :else
      (let [body (subvec buf 0 (- n 2))
            got (+ (nth buf (- n 2)) (* 256 (nth buf (dec n))))
            want (crc/crc16 body)]
        (if (not= got want)
          {:status :error :reason :crc-mismatch :received got :computed want}
          {:status :ok :frame {:address (nth body 0) :pdu-bytes (subvec body 1)}})))))

;; ── ASCII ────────────────────────────────────────────────────────────────────

(defn- hex2 [b]
  (let [s #?(:clj (Integer/toString (bit-and b 0xFF) 16)
             :cljs (.toString (bit-and b 0xFF) 16))]
    (str/upper (if (= 1 (count s)) (str "0" s) s))))

(defn encode-ascii
  "The ASCII transmission mode: each byte as two uppercase hex digits, an LRC
  instead of a CRC, framed by ':' and CRLF."
  [address pdu-bytes]
  (let [body (into [address] pdu-bytes)
        full (conj (vec body) (crc/lrc body))]
    {:status :ok :text (str ":" (apply str (map hex2 full)) "\r\n")}))

(defn decode-ascii
  [text]
  (let [t (str/trim-newline (str text))]
    (cond
      (not (str/starts-with? t ":")) {:status :error :reason :missing-start-delimiter}
      :else
      (let [hexs (subs t 1)]
        (cond
          (odd? (count hexs)) {:status :error :reason :odd-hex-length :length (count hexs)}
          (not (re-matches #"[0-9A-Fa-f]*" hexs)) {:status :error :reason :non-hex-character}
          (< (count hexs) 6) {:status :error :reason :frame-too-short :length (count hexs)}
          :else
          (let [bs (mapv (fn [p] #?(:clj (Integer/parseInt (apply str p) 16)
                                    :cljs (js/parseInt (apply str p) 16)))
                         (partition 2 hexs))
                body (subvec bs 0 (dec (count bs)))
                got (peek bs)
                want (crc/lrc body)]
            (if (not= got want)
              {:status :error :reason :lrc-mismatch :received got :computed want}
              {:status :ok :frame {:address (nth body 0) :pdu-bytes (subvec body 1)}})))))))
