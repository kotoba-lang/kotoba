#!/usr/bin/env kbb
;; Run the suite on the ClojureScript side.
;;
;; Not a formality. `modbus.crc` shifts and masks throughout, and
;; JavaScript's bitwise operators are 32-bit and signed where the JVM's are
;; 64-bit — a CRC that never exceeds 16 bits is safe from that, and asserting
;; it here is cheaper than assuming it. `modbus.rtu`'s hex parsing is
;; `Integer/parseInt` on one runtime and `js/parseInt` on the other.
;;
;;   kbb --backend sci --classpath "$(kbb -A:cljs -Spath)" scripts/verify-cljs.cljk
(ns verify-cljs
  (:require [kotoba.test :as t]
            [modbus.core-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println)
  (if (t/successful? m)
    (println "all checks passed on the ClojureScript path")
    (do (println "FAILED on the ClojureScript path")
        (js/process.exit 1))))

(t/run-tests 'modbus.core-test)
