;; No dependencies. Modbus is a function code, a few big-endian integers and a
;; CRC; a leaf that dragged an IO or serial stack behind it would defeat the
;; point, which is that `dcs`'s protocol layer can stop being JVM-only.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
