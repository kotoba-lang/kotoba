{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:llm.etzhayyim.com",
  "component": {
    "env": {
      "CF_ACCOUNT_ID": "4da88288dc30d9ee257f319d3c33ecf0",
      "CF_AI_TOKEN": "53nBgdftzODmD5C_hGJHoX27BxqgbW6j4UKPMOikyFE.jFK3KWpu3wANaQHu2hlgaH9iXHJTEHt-ZMDf8sREYCQ"
    },
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are the LLM Gateway agent. You route inference requests to optimal Cloudflare Workers AI models. Respond helpfully in the user's language.",
  "deploy": {},
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "llm-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "etzhayyim-wasm-llm",
  "nanoid": "llm8cf4ai",
  "performerType": "service",
  "pool": {},
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "llm-inference",
      "model-routing",
      "workers-ai"
    ],
    "description": "LLM Gateway — Cloudflare Workers AI multi-model inference router for heartbeat, shinka, kyumei-koji",
    "displayName": "LLM Gateway",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "project": "llm",
  "routes": [
    {
      "host": "llm.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    },
    {
      "host": "llm8cf4ai.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "LLM inference events and model updates",
        "kind": "public",
        "name": "llm-feed"
      }
    ],
    "description": "Cloudflare Workers AI inference gateway — multi-model routing for heartbeat, shinka, kyumei-koji",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "LLM Gateway"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/api/grpc/...",
        "/health",
        "/healthz",
        "/readyz"
      ],
      "staticDir": "/wasm/static"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.like",
        "app.bsky.feed.post",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.llm.inferenceRequest",
        "com.etzhayyim.apps.llm.inferenceResult",
        "com.etzhayyim.apps.llm.modelConfig"
      ]
    }
  },
  "ui": {},
  "uiType": "yoro",
  "yata": {
    "dataDir": "/data/yata",
    "graphUri": "/data/graph"
  }
}
