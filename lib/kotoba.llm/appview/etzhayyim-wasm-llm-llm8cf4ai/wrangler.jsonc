{
  // NOTE: this app used to be built by SvelteKit's @sveltejs/adapter-cloudflare,
  // which emitted both a server-rendering Worker script (`main`, the deployed
  // XRPC handler at svelte/src/routes/xrpc/[...path]/+server.ts) and a static
  // client bundle (`assets.directory`, the +page.svelte status page). The
  // frontend was migrated to a plain ClojureScript (shadow-cljs + reagent +
  // re-frame + jp-go-dds) static bundle with no server-rendering step — see
  // cljs/ and the repo README. `main` is dropped entirely (a Cloudflare
  // Worker can be assets-only) and `assets.directory` now points at the cljs
  // build output.
  //
  // `main` is NOT repointed at either Worker source still in this repo
  // (`src/app.ts` or the moved `src/xrpc-proxy.ts`): neither calls
  // `env.ASSETS.fetch` (confirmed by reading src/app.ts before this change),
  // so putting either in front of the assets would mean nothing serves the
  // static files. With `main` dropped, this config now deploys the static
  // assets only — the XRPC/LLM-gateway surface (`src/app.ts`'s
  // /v1/chat/completions -> Murakumo proxy, and the moved
  // src/xrpc-proxy.ts's XRPC-to-MCP-router proxy) no longer deploys from
  // this config. Both remain orphaned source, same as before this migration
  // (neither was proven wired to this file's `main` prior to inspection).
  // Reviving either is an open product decision, not made by this migration.
  //
  // This edit is UNVERIFIED: `wrangler deploy`/`wrangler dev` were not run
  // against it.
  "name": "kotodama-llm8cf4ai",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"llm-routing-stub\",\"domain-knowledge-rag\",\"bpmn-sse-pass-through\"]",
    "APP_DESCRIPTION": "LLM Gateway — routes /v1/chat/completions to Murakumo fleet and /xrpc/com.etzhayyim.apps.llm.answerWithKnowledge to the BPMN LangGraph kotoba knowledge workflow with SSE pass-through.",
    "LITELLM_URL": "https://murakumo-serve.etzhayyim.com",
    "LITELLM_KEY": "sk-etzhayyim-litellm-local",
    "APP_DISPLAY_NAME": "LLM Gateway",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "llm8cf4ai",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "RUNPOD_GEMMA4_OPENAI_BASE": "https://api.runpod.ai/v2/9z9l2nzwugnqyu/openai/v1",
    "RUNPOD_GEMMA4_MODEL": "gemma-4-e4b-it",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "llm8cf4com.etzhayyim.ai/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
