(ns test.nbb.empty-records
  (:require [cljs.test :as t :refer [deftest is run-tests]]
            [kotoba.script :as script]
            ["node:fs" :as fs] ["node:os" :as os]
            ["node:path" :as path] ["node:child_process" :as child]))

(def empty-type [:record :app/Empty []])
(def other-type [:record :app/Other []])
(defn module [functions]
  {:format :kotoba.kir/v4 :entry nil :effects #{}
   :exports (mapv :name functions) :functions functions})
(defn function [name params types result body]
  {:name name :params params :param-types types :result result :body body})
(defn probe [kir text]
  (let [dir (fs/mkdtempSync (path/join (os/tmpdir) "kotoba-empty-records-"))
        file (path/join dir "library.mjs")]
    (try
      (fs/writeFileSync file (script/emit kir))
      (let [result (child/spawnSync js/process.execPath #js ["--input-type=module" "-e" text file]
                                   #js {:encoding "utf8" :timeout 20000})]
        (is (= 0 (.-status result)) (.-stderr result)))
      (finally (fs/rmSync dir #js {:recursive true :force true})))))

(deftest empty-record-constructors-and-boundary-codecs-retain-nominal-types
  (probe (module [(function 'create [] [] empty-type (list 'record-new empty-type))
                  (function 'keep ['v] [empty-type] empty-type 'v)
                  (function 'other [] [] other-type (list 'record-new other-type))])
"import assert from 'node:assert/strict';
const api=(await import(process.argv[1])).instantiateKotoba({}, {fuel:10000});
const want=[['record',':app/Empty',[]]];
const v=api.create();assert.deepEqual(v,want);assert.ok(Object.isFrozen(v));
assert.deepEqual(api.keep(v),want);assert.deepEqual(api.keep(JSON.parse(JSON.stringify(v))),want);
assert.throws(()=>api.keep(api.other()),/invalid-record/);
for(const bad of [[],[v[0],7],[['record',':app/Other',[]]]])assert.throws(()=>api.keep(bad),/invalid-record/);
for(let i=0;i<1000;i++)assert.deepEqual(api.create(),want);"))

(deftest nested-empty-records-and-typed-capability-results-use-the-same-codec
  (let [outer [:record :app/Outer [[:child empty-type]]]]
    (probe (module [(function 'create [] [] outer
                             (list 'record-new outer (list 'record-new empty-type)))])
"import assert from 'node:assert/strict';
const api=(await import(process.argv[1])).instantiateKotoba();
assert.deepEqual(api.create(),[['record',':app/Outer',[[':child',['record',':app/Empty',[]]]]],[['record',':app/Empty',[]]]]);")
    (probe (assoc (module [(function 'roundtrip [] [] empty-type
                             (list 'typed-cap-call 7 empty-type empty-type
                                   (list 'record-new empty-type)))]) :effects #{[:cap/call 7]})
"import assert from 'node:assert/strict';let calls=0;
const api=(await import(process.argv[1])).instantiateKotoba({7:v=>{calls++;assert.deepEqual(v,[['record',':app/Empty',[]]]);return v;}});
assert.deepEqual(api.roundtrip(),[['record',':app/Empty',[]]]);assert.equal(calls,1);")))

(deftest empty-record-admission-preserves-malformed-schema-refusals
  (doseq [type [[:record :Empty []] [:record :app/Empty {}]
                [:record :app/Empty [[:x :i64] [:x :i64]]]
                [:record :app/Empty (mapv #(vector (keyword (str "k" %)) :i64) (range 33))]]]
    (is (some? (try (script/emit (module [(function 'keep ['v] [type] type 'v)])) nil
                   (catch :default e (ex-message e)))))))

(defmethod t/report [::t/default :end-run-tests] [m]
  (when (or (not= 3 (:test m)) (not= 7 (:pass m)) (pos? (+ (:fail m) (:error m))))
    (js/process.exit 1)))
(run-tests 'test.nbb.empty-records)
