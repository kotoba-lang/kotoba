(ns test.nbb.document-bytes-link
  "The :bytes and :link document kinds in emitted ESM (root ADR-2610092310 S3).

  The module is emitted, run under Node, and pinned against osaho's reference
  (kotoba-lang/osaho 502b5ba, test/kotoba/kir_document_bytes_link_test.cljk):
  - canonical bytes `x<len>:<bytes>` / `c<len>:<binary CIDv1>` and their
    sha256 (digests taken outside Kotoba, Python hashlib, 2026-10-09);
  - document-read / document-print round-trips the new tags;
  - a link is ONE binary CIDv1: version 1, four minimal varints, the digest
    length exact, at most 128 bytes -- document-link answers none otherwise;
  - the readers answer none for the other kind;
  - textual EDN `#kotoba/bytes \"<hex>\"` / `#kotoba/cid \"b<base32>\"`, and
    only the canonical spelling reads;
  - the documents that existed before keep their sha256 (the S0 anchors of
    kotoba-lang lang/conformance/document/sha256_anchors.kotoba)."
  (:require [cljs.test :as t :refer [deftest is run-tests]]
            [kotoba.script :as script]
            ["node:fs" :as fs] ["node:os" :as os]
            ["node:path" :as path] ["node:child_process" :as cp]))

(def ^:private cid-items
  [1 85 18 32 227 176 196 66 152 252 28 20 154 251 244 200 153 111 185 36 39
   174 65 228 100 155 147 76 164 149 153 27 120 82 184 85])

(defn- bytes-of [items] (list 'bytes-from-vector-i64 (cons 'vector-new items)))
(defn- link-of [b]
  (list 'option-value-of [:option :document] (list 'document-link b) '(document-null)))
(defn- f [name params types result body]
  {:name name :params params :param-types types :result result :effects #{} :body body})

(def kir
  {:format :kotoba.kir/v4 :entry nil :effects #{}
   :exports '[bytesDigest emptyBytesDigest linkDigest recordDigest bytesPrint linkPrint
              bytesKind linkKind linkKindOf bytesValueCount linkValueCount
              otherReaders roundTrip ednPrint ednRead ednReadDigest nullDigest mapDigest
              stringKeyDigest bytesEqual bytesSetCount]
   :functions
   [(f 'bytesDigest [] [] :string (list 'document-sha256 (list 'document-bytes (bytes-of [0 255 16]))))
    (f 'emptyBytesDigest [] [] :string '(document-sha256 (document-bytes (bytes-empty))))
    (f 'linkDigest [] [] :string (list 'document-sha256 (link-of (bytes-of cid-items))))
    (f 'recordDigest [] [] :string
       (list 'document-sha256 (list 'document-map :cid (link-of (bytes-of cid-items))
                                    :data (list 'document-bytes (bytes-of [0 255 16])))))
    (f 'bytesPrint [] [] :string (list 'document-print (list 'document-bytes (bytes-of [0 255 16]))))
    (f 'linkPrint [] [] :string (list 'document-print (link-of (bytes-of cid-items))))
    (f 'bytesKind [] [] :keyword (list 'document-kind (list 'document-bytes (bytes-of [1]))))
    (f 'linkKind [] [] :keyword (list 'document-kind (link-of (bytes-of cid-items))))
    (f 'linkKindOf '[b] [:bytes] :keyword (list 'document-kind (link-of 'b)))
    (f 'bytesValueCount '[b] [:bytes] :i64
       '(bytes-count (option-value-of [:option :bytes] (document-bytes-value (document-bytes b))
                                      (bytes-from-vector-i64 (vector-new 9 9 9 9 9 9 9)))))
    (f 'linkValueCount [] [] :i64
       (list 'bytes-count (list 'option-value-of [:option :bytes]
                                (list 'document-link-value (link-of (bytes-of cid-items)))
                                '(bytes-empty))))
    ;; each reader of the other kind, and a reader of a non-payload kind, is none:
    ;; 7 + 7 + 7 = 21 when all three fall back
    (f 'otherReaders [] [] :i64
       (list '+ (list 'bytes-count (list 'option-value-of [:option :bytes]
                                         (list 'document-link-value (list 'document-bytes (bytes-of [1])))
                                         (bytes-of [7 7 7 7 7 7 7])))
             (list '+ (list 'bytes-count (list 'option-value-of [:option :bytes]
                                               (list 'document-bytes-value (link-of (bytes-of cid-items)))
                                               (bytes-of [7 7 7 7 7 7 7])))
                   (list 'bytes-count (list 'option-value-of [:option :bytes]
                                            '(document-bytes-value (document-string "x"))
                                            (bytes-of [7 7 7 7 7 7 7]))))))
    (f 'roundTrip [] [] :bool
       (list 'document-equal?
             (list 'document-read (list 'document-print
                                        (list 'document-map :cid (link-of (bytes-of cid-items))
                                              :data (list 'document-bytes (bytes-of [0 255 16])))))
             (list 'document-map :data (list 'document-bytes (bytes-of [0 255 16]))
                   :cid (link-of (bytes-of cid-items)))))
    (f 'ednPrint [] [] :string
       (list 'document-edn-print (list 'document-map :cid (link-of (bytes-of cid-items))
                                       :data (list 'document-bytes (bytes-of [0 255 16])))))
    (f 'ednRead '[s] [:string] :string '(document-edn-print (document-edn-read s)))
    (f 'ednReadDigest '[s] [:string] :string '(document-sha256 (document-edn-read s)))
    (f 'nullDigest [] [] :string '(document-sha256 (document-null)))
    (f 'mapDigest [] [] :string
       '(document-sha256 (document-map :zeta (document-i64 1) :a (document-vector (document-bool true))
                                       :bb (document-null))))
    (f 'stringKeyDigest [] [] :string
       '(document-sha256 (document-map (document-string "b") (document-i64 1)
                                       (document-string "aaaaaaaaaa") (document-i64 2))))
    (f 'bytesEqual [] [] :bool
       (list 'document-equal? (list 'document-bytes (bytes-of [1 2])) (list 'document-bytes (bytes-of [1 2]))))
    ;; a set orders and deduplicates by canonical bytes
    (f 'bytesSetCount [] [] :i64
       (list 'document-count (list 'document-set (list 'document-bytes (bytes-of [2]))
                                   (list 'document-bytes (bytes-of [1]))
                                   (link-of (bytes-of cid-items)))))]})

(def probe "const m=(await import(process.argv[1])).instantiateKotoba({});
const cid=[1,85,18,32,227,176,196,66,152,252,28,20,154,251,244,200,153,111,185,36,39,174,65,228,100,155,147,76,164,149,153,27,120,82,184,85];
const u=a=>new Uint8Array(a);
const rep=(n,x)=>Array.from({length:n},()=>x);
const kindOf=a=>m.linkKindOf(u(a));
const trap=f=>{try{f();return 'no-trap';}catch(e){return 'trap';}};
const cidText='bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku';
const out={
 bytesDigest:m.bytesDigest(),emptyBytesDigest:m.emptyBytesDigest(),linkDigest:m.linkDigest(),
 recordDigest:m.recordDigest(),bytesPrint:m.bytesPrint(),linkPrint:m.linkPrint(),
 bytesKind:m.bytesKind(),linkKind:m.linkKind(),
 linkValueCount:String(m.linkValueCount()),bytesValueCount:String(m.bytesValueCount(u([1,2,3]))),
 otherReaders:String(m.otherReaders()),roundTrip:m.roundTrip(),ednPrint:m.ednPrint(),
 ednReadBack:m.ednRead(m.ednPrint()),ednEmpty:m.ednRead('#kotoba/bytes \"\"'),
 ednReadDigest:m.ednReadDigest('#kotoba/bytes \"00ff10\"'),
 nullDigest:m.nullDigest(),mapDigest:m.mapDigest(),stringKeyDigest:m.stringKeyDigest(),
 bytesEqual:m.bytesEqual(),bytesSetCount:String(m.bytesSetCount()),
 cid:{ok:kindOf(cid),empty:kindOf([]),version0:kindOf([0,...cid.slice(1)]),
      short:kindOf(cid.slice(0,-1)),trailing:kindOf([...cid,0]),
      nonMinimal:kindOf([1,85,18,128,0]),nonMinimalCodec:kindOf([1,0x80+85,0,18,0]),
      at128:kindOf([1,85,18,124,...rep(124,7)]),at129:kindOf([1,85,18,125,...rep(125,7)]),
      notACid:kindOf([0,255,16])},
 ednRefused:['#kotoba/bytes \"00FF\"','#kotoba/bytes \"0\"','#kotoba/bytes 1','#kotoba/bytes  \"00\"',
   '#kotoba/blob \"00\"','#inst \"2026\"','#kotoba/cid \"'+cidText.slice(1)+'\"',
   '#kotoba/cid \"B'+cidText.slice(1)+'\"','#kotoba/cid \"bafy\"'].map(s=>trap(()=>m.ednRead(s)))};
console.log(JSON.stringify(out));")

(def expected
  {:bytesDigest "9a20ad21716d8ac7de1ab4e20a18e918538e89e094cb7561fb0abdab0f36a2b8"
   :emptyBytesDigest "5c5fc7941f031046baedb27ef5a3637fa70eb74e22892886eb516d33b84e4dba"
   :linkDigest "5b4949ac593035225cbf5f6c4137dd7771b8a4a80383633581ba30e81cd69139"
   :recordDigest "20f76498d89ac2d9470b1c23ee03935e798afecaf61a2fd3e2fc7154c080d165"
   :bytesPrint "78333a00ff10"
   :linkPrint "6333363a01551220e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
   :bytesKind ":bytes" :linkKind ":link"
   :linkValueCount "36" :bytesValueCount "3" :otherReaders "21" :roundTrip true
   :ednPrint "{:cid #kotoba/cid \"bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku\" :data #kotoba/bytes \"00ff10\"}"
   :ednReadBack "{:cid #kotoba/cid \"bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku\" :data #kotoba/bytes \"00ff10\"}"
   :ednEmpty "#kotoba/bytes \"\""
   :ednReadDigest "9a20ad21716d8ac7de1ab4e20a18e918538e89e094cb7561fb0abdab0f36a2b8"
   ;; S0 anchors: existing documents keep their identity
   :nullDigest "1b16b1df538ba12dc3f97edbb85caa7050d46c148134290feba80f8236c83db9"
   :mapDigest "dd0e557677d6f5396976dd73f789b89ded541157a6d9de65360c37c6cd1d082a"
   :stringKeyDigest "74159aad14c30e8d381601e0787fd3ce45c063d831df9ad6402df94a5d4d5796"
   :bytesEqual true :bytesSetCount "3"
   :cid {:ok ":link" :empty ":null" :version0 ":null" :short ":null" :trailing ":null"
         :nonMinimal ":null" :nonMinimalCodec ":null" :at128 ":link" :at129 ":null" :notACid ":null"}
   :ednRefused (vec (repeat 9 "trap"))})

(deftest bytes-and-link-documents-run-in-emitted-esm
  (let [dir (fs/mkdtempSync (path/join (os/tmpdir) "kotoba-document-bytes-link-"))
        file (path/join dir "library.mjs")]
    (try
      (fs/writeFileSync file (script/emit kir))
      (let [r (cp/spawnSync js/process.execPath #js ["--input-type=module" "-e" probe file]
                            #js {:encoding "utf8" :timeout 20000})]
        (is (= 0 (.-status r)) (.-stderr r))
        (when (= 0 (.-status r))
          (let [result (js->clj (js/JSON.parse (.-stdout r)) :keywordize-keys true)]
            (doseq [[k v] expected]
              (is (= v (get result k)) (str k))))))
      (finally (fs/rmSync dir #js {:recursive true :force true})))))

(deftest the-four-operations-are-typed
  (doseq [[body types result] [['(document-bytes v) [:string] :document]
                               ['(document-bytes v v) [:bytes] :document]
                               ['(document-link v) [:document] [:option :document]]
                               ['(document-bytes-value v) [:bytes] [:option :bytes]]
                               ['(document-link-value v) [:document] :bytes]]]
    (is (some? (try (script/emit (assoc kir :exports ['bad] :functions
                                        [{:name 'bad :params ['v] :param-types types :result result :body body}]))
                    nil (catch :default e (ex-message e))))
        (pr-str body))))

(defmethod t/report [::t/default :end-run-tests] [m]
  (when (or (not= 2 (:test m)) (< (:pass m) 29) (pos? (+ (:fail m) (:error m))))
    (js/process.exit 1)))
(run-tests 'test.nbb.document-bytes-link)
