(ns test.nbb.typed-set-nth
  "`typed-set-nth` in emitted ESM: the item at an index in the set's canonical
  (ascending) order.

  Every other typed-set operation was lowered; this one fell through to
  `unsupported KIR node [:set T]`, so a module that walks a set it was handed
  could not be built for :js-kotoba-v1 -- io-ipld's dag_cbor_write writes a
  map by walking its sorted key set with it. Every expected value below is what
  kotoba-lang/osaho 502b5ba `kotoba.kir/execute` answers for the same KIR
  (measured 2026-10-09): the order is the set's, not insertion order; strings
  order by UTF-16 code unit (U+1F600 before U+FFFF); conj/disj keep the order;
  an index outside [0,count) traps `set-index-out-of-bounds` -- the result is
  the item, not an option."
  (:require [cljs.test :as t :refer [deftest is run-tests]]
            [clojure.string :as str]
            [kotoba.script :as script]
            ["node:fs" :as fs] ["node:os" :as os]
            ["node:path" :as path] ["node:child_process" :as cp]))

(defn- f [name params param-types result body]
  {:name name :params params :param-types param-types :result result :effects #{} :body body})

(def kir
  {:format :kotoba.kir/v4 :entry nil :effects #{}
   :exports '[strAt intAt grownAt emojiAt]
   :functions
   [(f 'strAt '[i] [:i64] :string
       '(typed-set-nth [:set :string] (typed-set-new [:set :string] "b" "aa" "c") i))
    (f 'intAt '[i] [:i64] :i64
       (list 'typed-set-nth [:set :i64]
             (list 'typed-set-new [:set :i64] 5 -3
                   (js/BigInt "9223372036854775807") (js/BigInt "-9223372036854775808"))
             'i))
    (f 'grownAt '[i] [:i64] :i64
       '(typed-set-nth [:set :i64]
                       (typed-set-disj [:set :i64]
                                       (typed-set-conj [:set :i64]
                                                       (typed-set-conj [:set :i64] (typed-set-new [:set :i64] 5 -3) 0)
                                                       5)
                                       -3)
                       i))
    (f 'emojiAt '[i] [:i64] :string
       (list 'typed-set-nth [:set :string]
             (list 'typed-set-new [:set :string] "￿" "😀" "z") 'i))]})

(def probe "const m=(await import(process.argv[1])).instantiateKotoba({});
const show=v=>typeof v==='string'?JSON.stringify([...Array(v.length).keys()].map(i=>v.charCodeAt(i))).replaceAll(',',' '):String(v);
const at=(fn,is)=>is.map(i=>{try{return show(fn(BigInt(i)));}catch(e){return 'trap:'+e.message;}});
console.log(JSON.stringify({strAt:at(m.strAt,[0,1,2,3,-1]),intAt:at(m.intAt,[0,1,2,3,4]),
 grownAt:at(m.grownAt,[0,1,2]),emojiAt:at(m.emojiAt,[0,1,2])}));")

(def expected
  {:strAt ["[97 97]" "[98]" "[99]" "trap:set-index-out-of-bounds" "trap:set-index-out-of-bounds"]
   :intAt ["-9223372036854775808" "-3" "5" "9223372036854775807" "trap:set-index-out-of-bounds"]
   :grownAt ["0" "5" "trap:set-index-out-of-bounds"]
   :emojiAt ["[122]" "[55357 56832]" "[65535]"]})

(deftest typed-set-nth-runs-in-emitted-esm
  (let [dir (fs/mkdtempSync (path/join (os/tmpdir) "kotoba-typed-set-nth-"))
        file (path/join dir "library.mjs")]
    (try
      (fs/writeFileSync file (script/emit kir))
      (let [result (cp/spawnSync js/process.execPath
                                 #js ["--input-type=module" "-e" probe file]
                                 #js {:encoding "utf8"})]
        (is (= 0 (.-status result)) (.-stderr result))
        (is (= expected (js->clj (js/JSON.parse (.-stdout result)) :keywordize-keys true))))
      (finally (fs/rmSync dir #js {:recursive true :force true})))))

(deftest typed-set-nth-is-type-checked-at-emit
  (doseq [[label body] [["not a set type" '(typed-set-nth [:list :i64] (typed-list-new [:list :i64] 1) 0)]
                        ["a non-i64 index" '(typed-set-nth [:set :i64] (typed-set-new [:set :i64] 1) "0")]
                        ["wrong arity" '(typed-set-nth [:set :i64] (typed-set-new [:set :i64] 1))]]]
    (is (some? (try (script/emit (assoc kir :exports '[bad] :functions [(f 'bad [] [] :i64 body)]))
                    nil (catch :default e (ex-message e))))
        label)))

(deftest a-module-that-does-not-index-a-set-carries-no-helper
  ;; Every artifact emitted before this keeps its bytes.
  (let [plain (script/emit (assoc kir :exports '[n]
                                  :functions [(f 'n [] [] :i64
                                                 '(typed-set-count [:set :i64] (typed-set-new [:set :i64] 1)))]))]
    (is (not (str/includes? plain "typedSetNth")))
    (is (str/includes? (script/emit kir) "const typedSetNth="))))

(defmethod t/report [::t/default :end-run-tests] [m]
  (when (or (not= 3 (:test m)) (< (:pass m) 7) (pos? (+ (:fail m) (:error m))))
    (js/process.exit 1)))
(run-tests 'test.nbb.typed-set-nth)
