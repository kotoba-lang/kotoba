(ns test.nbb.js-branding
  (:require [cljs.test :as t :refer [deftest is run-tests]]
            [kotoba.script :as script]
            ["node:fs" :as fs] ["node:os" :as os]
            ["node:path" :as path] ["node:child_process" :as cp]))

(def functions
  [{:name 'typeName :params ['v] :param-types [:js-value] :result :string :body '(js-typeof v)}
   {:name 'array :params ['v] :param-types [:js-value] :result :bool :body '(js-array? v)}
   {:name 'box :params ['v] :param-types [:bool] :result :js-value :body '(js-bool-value v)}
   {:name 'plain :params ['v] :param-types [:js-value] :result :js-value
    :body '(if (js-truthy? v)
             (js-bool-value (if (string=? (js-typeof v) "object") (bool-not (js-array? v)) false)) v)}
   {:name 'observeType :params [] :param-types [] :result :string
    :body '(js-typeof (typed-cap-call 7 :i64 :js-value 1))}
   {:name 'observeArray :params [] :param-types [] :result :bool
    :body '(js-array? (typed-cap-call 7 :i64 :js-value 2))}
   {:name 'observeBox :params [] :param-types [] :result :js-value
    :body '(js-bool-value (typed-cap-call 7 :i64 :bool 3))}])
(def kir {:format :kotoba.kir/v4 :entry nil :exports (mapv :name functions)
          :effects #{[:cap/call 7]} :functions functions})
(def probe
  "import vm from 'node:vm';
const events=[];const foreign=vm.runInNewContext('[]');
const m=(await import(process.argv[1])).instantiateKotoba({7:r=>{events.push(String(r));return r===1n?undefined:r===2n?foreign:true;}});
let reads=0;const object={};object.self=object;const getter={};
Object.defineProperty(getter,'valueOf',{get(){reads++;throw Error('getter');}});
Object.defineProperty(getter,Symbol.toStringTag,{get(){reads++;throw Error('tag');}});
const traps={get(){reads++;throw Error('proxy');}};
const proxy=new Proxy({},traps),arrayProxy=new Proxy([],traps),callableProxy=new Proxy(()=>{},traps);
const cases=[undefined,null,false,true,0,-0,NaN,0n,1n,'','0',Infinity,object,getter,proxy,
Symbol('x'),()=>{},new Array(3),new Uint8Array(3),new Map(),Object(true),Object('x'),Object(1n),arrayProxy,callableProxy,foreign];
const baseline=v=>v&&typeof v==='object'&&!Array.isArray(v);
for(const v of cases){if(m.typeName(v)!==typeof v)throw Error('typeof');if(m.array(v)!==Array.isArray(v))throw Error('brand');if(!Object.is(m.plain(v),baseline(v)))throw Error('plain raw result');}
for(const v of [true,false])if(m.box(v)!==v)throw Error('bool injection');
const revoked=Proxy.revocable({},{});revoked.revoke();if(m.typeName(revoked.proxy)!=='object')throw Error('revoked typeof');
let revocations=0;for(const [a,b] of [[m.array,Array.isArray],[m.plain,baseline]]){let e1,e2;try{a(revoked.proxy);}catch(e){e1=e;}try{b(revoked.proxy);}catch(e){e2=e;}if(!(e1 instanceof TypeError)||!(e2 instanceof TypeError)||e1.message!==e2.message)throw Error('revoked error');revocations++;}
if(m.observeType()!=='undefined'||events.join(',')!=='1')throw Error('typeof evaluation count');
if(m.observeArray()!==true||events.join(',')!=='1,2')throw Error('array evaluation count');
if(m.observeBox()!==true||events.join(',')!=='1,2,3')throw Error('box evaluation count');
const originalArray=Array.isArray;let overrideCalls=0;const input={};
const overrides=[false,true,0,-0,NaN,0n,'',null,undefined,42,'x',getter];
try{for(const result of overrides){Array.isArray=v=>{overrideCalls++;if(v!==input)throw Error('operand identity');return result;};
if(m.array(input)!==!!result)throw Error('override bool');if(!Object.is(m.plain(input),baseline(input)))throw Error('override plain');}
const error=Error('array override');Array.isArray=()=>{overrideCalls++;throw error;};for(const f of [m.array,m.plain,baseline]){let actual;try{f(input);}catch(e){actual=e;}if(actual!==error)throw Error('override error identity');}
}finally{Array.isArray=originalArray;}
if(reads!==0)throw Error('host reads');console.log(JSON.stringify({cases:cases.length,reads,calls:events.length,revocations,boolean_cases:2,override_cases:overrides.length,override_calls:overrideCalls}));")

(deftest emitted-branding-preserves-types-errors-and-single-evaluation
  (let [dir (fs/mkdtempSync (path/join (os/tmpdir) "kotoba-js-branding-"))
        file (path/join dir "library.mjs")]
    (try
      (fs/writeFileSync file (script/emit kir))
      (let [r (cp/spawnSync js/process.execPath #js ["--input-type=module" "-e" probe file]
                           #js {:encoding "utf8" :timeout 10000})]
        (is (= 0 (.-status r)) (.-stderr r))
        (when (= 0 (.-status r))
          (let [result (js->clj (js/JSON.parse (.-stdout r)) :keywordize-keys true)]
            (is (= 26 (:cases result)))
            (is (= 0 (:reads result)))
            (is (= 3 (:calls result)))
            (is (= 2 (:revocations result)))
            (is (= 2 (:boolean_cases result)))
            (is (= 12 (:override_cases result)))
            (is (= 39 (:override_calls result))))))
      (finally (fs/rmSync dir #js {:recursive true :force true})))))

(deftest branding-and-injection-require-exact-types-and-arities
  (doseq [[body input result]
          [['(js-typeof) :js-value :string] ['(js-typeof v v) :js-value :string]
           ['(js-typeof v) :i64 :string] ['(js-typeof v) :js-value :bool]
           ['(js-array?) :js-value :bool] ['(js-array? v v) :js-value :bool]
           ['(js-array? v) :bool :bool] ['(js-array? v) :js-value :js-value]
           ['(js-bool-value) :bool :js-value] ['(js-bool-value v v) :bool :js-value]
           ['(js-bool-value v) :js-value :js-value] ['(js-bool-value v) :bool :bool]]]
    (is (some? (try (script/emit (assoc kir :exports ['bad] :effects #{} :functions
                                  [{:name 'bad :params ['v] :param-types [input] :result result :body body}]))
                   nil (catch :default e (ex-message e)))))))

(defmethod t/report [::t/default :end-run-tests] [m]
  (when (or (not= 2 (:test m)) (not= 20 (:pass m)) (pos? (+ (:fail m) (:error m))))
    (js/process.exit 1)))
(run-tests 'test.nbb.js-branding)
