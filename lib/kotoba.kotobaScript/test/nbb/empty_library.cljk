(ns test.nbb.empty-library
  (:require [cljs.test :refer [deftest is run-tests]]
            [kotoba.script :as script]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]
            ["node:child_process" :as cp]))
(def empty-kir {:format :kotoba.kir/v3 :entry nil :exports [] :effects #{} :functions []})
(deftest empty-and-private-only-libraries-instantiate-without-exports
  (doseq [kir [empty-kir (assoc empty-kir :functions [{:name 'hidden :params [] :body 7}])]]
    (let [dir (fs/mkdtempSync (path/join (os/tmpdir) "kotoba-empty-"))
          file (path/join dir "library.mjs")]
      (try
        (fs/writeFileSync file (script/emit kir))
        (let [r (cp/spawnSync js/process.execPath
                  #js ["--input-type=module" "-e"
                    (str "import {instantiateKotoba,kotobaArtifact} from " (js/JSON.stringify file)
                         ";const m=instantiateKotoba();if(kotobaArtifact.entry!==null||Object.keys(m).length!==0)process.exit(2);")]
                  #js {:encoding "utf8" :timeout 10000})]
          (is (= 0 (.-status r)) (.-stderr r)))
        (finally (fs/rmSync dir #js {:recursive true :force true}))))))
(deftest incomplete-or-invalid-exports-still-refuse
  (doseq [kir [(dissoc empty-kir :exports) (assoc empty-kir :functions nil)
               (assoc empty-kir :exports ['missing])
               (assoc empty-kir :exports ['hidden 'hidden] :functions [{:name 'hidden :params [] :body 7}])
               (assoc empty-kir :entry 'main :functions [{:name 'main :params [] :body 7}])]]
    (is (some? (try (script/emit kir) nil (catch :default e (ex-message e)))))))
(let [r (run-tests 'test.nbb.empty-library)]
  (when (pos? (+ (:fail r) (:error r))) (js/process.exit 1)))
