(ns test.nbb.linked-dispatcher
  "A module dispatcher RENAMED by amu's project linker (`kotoba_module__1__3`,
  first parameter `__kotoba_closure_i64_1`) must guard its closure word as a
  closure, not as an i64. `test/fixtures/linked/apply-twice.kir.edn` is the
  KIR amu (b2a52f48) links for

    (ns twice.core (:params [elem]) (:export [apply-twice]))
    (defn apply-twice [f [:fn [[:i64] :i64]] x :i64] :i64 (f (f x)))
    (ns root (:require [twice.core :as tw :with {elem :i64}]) (:export [main]))
    (defn- inc1 [x :i64] :i64 (+ x 1))
    (defn main [] :i64 (tw/apply-twice (fn [x] (inc1 x)) 5))

  whose `main` is 7 on the KIR interpreter, wasm32 and native, and was
  `invalid-i64` here. Both directions: the emitted text guards that
  parameter with `assertClosure(`, and the program RUNS to 7 under node.

    kbb --backend sci --classpath src test/nbb/linked_dispatcher.cljk"
  (:require [cljs.reader :as reader]
            [kotoba.script :as script]
            ["node:child_process" :as cp]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]))

(def ^:private failures (atom 0))
(defn- check! [label ok? detail]
  (if ok? (println (str "ok   " label))
      (do (swap! failures inc) (println (str "FAIL " label " -- " (pr-str detail))))))

(let [module (reader/read-string (fs/readFileSync "lib/kotoba.kotobaScript/test/fixtures/linked/apply-twice.kir.edn" "utf8"))
      emitted (script/emit module {:fuel 512})
      renamed (re-find #"function k\$kotoba_module__1__3\([^)]*\)\{[^}]*" emitted)]
  (check! "the renamed module dispatcher is emitted" (some? renamed) (count emitted))
  (check! "its closure word is guarded with assertClosure, not assertI64"
          (and renamed (.includes renamed "=assertClosure(k$__kotoba_closure_i64_1")
               (not (.includes renamed "=assertI64(k$__kotoba_closure_i64_1")))
          renamed)
  (let [dir (fs/mkdtempSync (path/join (os/tmpdir) "kotoba-script-linked-"))
        file (path/join dir "fixture.mjs")]
    (try
      (fs/writeFileSync file (str emitted "\nlet out;try{out={status:'ok',value:String(instantiateKotoba().main())};}catch(e){out={status:'trap',error:String(e.message)};}console.log(JSON.stringify(out));"))
      (let [r (cp/spawnSync js/process.execPath #js [file] #js {:encoding "utf8" :timeout 10000})
            out (when (zero? (.-status r)) (js->clj (js/JSON.parse (.-stdout r)) :keywordize-keys true))]
        (check! "main runs to 7 under node" (= {:status "ok" :value "7"} out) {:out out :stderr (.-stderr r)}))
      (finally (fs/rmSync dir #js {:recursive true :force true})))))

(println (str "SCANNED\t3\tchecks; " (- 3 @failures) " passed, " @failures " failed"))
(js/process.exit (if (zero? @failures) 0 1))
