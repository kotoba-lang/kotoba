(ns test.nbb.i64-shifts
  "The i64 bitwise family in emitted ESM: i64-shift-left, i64-shift-right,
  u64-shift-right, bit-or, bit-not.

  The emitter refused all five as \"unsupported KIR operation\", so any module
  using one -- io-ipld's dag_cbor_write writes a CBOR head with
  `(i64-shift-left major 5)` and its big-endian bytes with
  `(i64-shift-right n (* 8 i))` -- could not be built for :js-kotoba-v1, and
  `amu test` failed on its js leg. Every expected value below is what
  kotoba-lang/osaho 502b5ba `kotoba.kir/execute` answers for the same KIR
  (measured 2026-10-09): two's-complement wrapping, an arithmetic right shift,
  a logical one for u64, and a trap -- not a mask -- for a count outside [0,63],
  which may be computed (only a literal count is checked at compile time)."
  (:require [cljs.test :as t :refer [deftest is run-tests]]
            [clojure.string :as str]
            [kotoba.script :as script]
            ["node:fs" :as fs] ["node:os" :as os]
            ["node:path" :as path] ["node:child_process" :as cp]))

(defn- f [name params body]
  {:name name :params params :param-types (vec (repeat (count params) :i64))
   :result :i64 :effects #{} :body body})

(def kir
  {:format :kotoba.kir/v4 :entry nil :effects #{}
   :exports '[shl shr ushr bor bnot be3]
   :functions
   [(f 'shl '[x s] '(i64-shift-left x s))
    (f 'shr '[x s] '(i64-shift-right x s))
    (f 'ushr '[x s] '(u64-shift-right x s))
    (f 'bor '[a b] '(bit-or a b))
    (f 'bnot '[a] '(bit-not a))
    ;; dag_cbor_write's `be`: byte I of N, the count computed, = 0x0a0b0c >> 8*I
    (f 'be3 '[n i] '(bit-and (i64-shift-right n (* 8 i)) 255))]})

(def probe "const m=(await import(process.argv[1])).instantiateKotoba({});
const trap=f=>{try{return String(f());}catch(e){return 'trap:'+e.message;}};
const M=-9223372036854775808n,X=9223372036854775807n;
console.log(JSON.stringify({
 shl:[[1n,63n],[-1n,1n],[X,1n],[5n,0n],[3n,62n]].map(([x,s])=>trap(()=>m.shl(x,s))),
 shr:[[-8n,1n],[-1n,63n],[256n,8n],[M,63n],[X,62n]].map(([x,s])=>trap(()=>m.shr(x,s))),
 ushr:[[-1n,1n],[-8n,61n],[-1n,63n],[-1n,0n],[M,63n]].map(([x,s])=>trap(()=>m.ushr(x,s))),
 bor:[trap(()=>m.bor(12n,3n)),trap(()=>m.bor(M,1n))],
 bnot:[trap(()=>m.bnot(0n)),trap(()=>m.bnot(5n)),trap(()=>m.bnot(M))],
 be3:[0n,1n,2n,3n].map(i=>trap(()=>m.be3(658188n,i))),
 range:[trap(()=>m.shl(1n,64n)),trap(()=>m.shr(1n,-1n)),trap(()=>m.ushr(1n,64n))]}));")

(def expected
  {:shl ["-9223372036854775808" "-2" "-2" "5" "-4611686018427387904"]
   :shr ["-4" "-1" "1" "-1" "1"]
   :ushr ["9223372036854775807" "7" "1" "-1" "1"]
   :bor ["15" "-9223372036854775807"]
   :bnot ["-1" "-6" "9223372036854775807"]
   :be3 ["12" "11" "10" "0"]
   :range (vec (repeat 3 "trap:i64-shift-count-out-of-range"))})

(deftest i64-bitwise-family-runs-in-emitted-esm
  (let [dir (fs/mkdtempSync (path/join (os/tmpdir) "kotoba-i64-shifts-"))
        file (path/join dir "library.mjs")]
    (try
      (fs/writeFileSync file (script/emit kir))
      (let [result (cp/spawnSync js/process.execPath
                                 #js ["--input-type=module" "-e" probe file]
                                 #js {:encoding "utf8"})]
        (is (= 0 (.-status result)) (.-stderr result))
        (is (= expected (js->clj (js/JSON.parse (.-stdout result)) :keywordize-keys true))))
      (finally (fs/rmSync dir #js {:recursive true :force true})))))

(deftest a-literal-shift-count-outside-0-63-is-refused-at-emit
  (doseq [count [64 -1]]
    (let [refused (try (script/emit (assoc kir :exports '[bad]
                                           :functions [(f 'bad '[x] (list 'i64-shift-left 'x count))]))
                       nil
                       (catch :default e (ex-message e)))]
      (is (= "i64 shift count literal must be in [0,63]" refused)))))

(deftest a-module-without-i64-shifts-carries-no-shift-helpers
  ;; Every artifact emitted before this keeps its bytes.
  (let [plain (script/emit (assoc kir :exports '[bor] :functions [(f 'bor '[a b] '(bit-or a b))]))]
    (is (not (str/includes? plain "shift64")))
    (is (str/includes? (script/emit kir) "const shift64="))))

(defmethod t/report [::t/default :end-run-tests] [m]
  (when (or (not= 3 (:test m)) (< (:pass m) 6) (pos? (+ (:fail m) (:error m))))
    (js/process.exit 1)))
(run-tests 'test.nbb.i64-shifts)
