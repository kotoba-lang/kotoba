(ns test.nbb.js-operations
  (:require [cljs.test :as t :refer [deftest is run-tests]]
            [kotoba.script :as script]
            ["node:fs" :as fs] ["node:os" :as os]
            ["node:path" :as path] ["node:child_process" :as cp]))

(def functions
  [{:name 'nullable :params ['v] :param-types [:js-value] :result :bool :body '(js-nullish? v)}
   {:name 'truthy :params ['v] :param-types [:js-value] :result :bool :body '(js-truthy? v)}
   {:name 'strict :params ['a 'b] :param-types [:js-value :js-value] :result :bool :body '(js-strict-equal? a b)}])
(def kir {:format :kotoba.kir/v4 :entry nil :exports ['nullable 'truthy 'strict 'observeNullable 'observeTruthy 'observeEqual]
          :effects #{[:cap/call 7]}
          :functions (into functions
                       [{:name 'observeNullable :params [] :param-types [] :result :bool
                         :body '(js-nullish? (typed-cap-call 7 :i64 :js-value 1))}
                        {:name 'observeTruthy :params [] :param-types [] :result :bool
                         :body '(js-truthy? (typed-cap-call 7 :i64 :js-value 2))}
                        {:name 'observeEqual :params [] :param-types [] :result :bool
                         :body '(js-strict-equal? (typed-cap-call 7 :i64 :js-value 3)
                                                 (typed-cap-call 7 :i64 :js-value 4))}])})
(def probe "const events=[];const retained={};const m=(await import(process.argv[1])).instantiateKotoba({7:r=>{events.push(String(r));return r===1n?undefined:retained;}});
let reads=0;const object={};object.self=object;const getter={};
Object.defineProperty(getter,'valueOf',{get(){reads++;throw Error('getter');}});
const proxy=new Proxy({},{get(){reads++;throw Error('proxy');}});
const revoked=Proxy.revocable({},{});revoked.revoke();
const cases=[[undefined,true,false],[null,true,false],[false,false,false],[true,false,true],
[0,false,false],[-0,false,false],[NaN,false,false],[0n,false,false],[1n,false,true],
['',false,false],['0',false,true],[Infinity,false,true],[object,false,true],[getter,false,true],
[proxy,false,true],[revoked.proxy,false,true],[Symbol('x'),false,true],[()=>{},false,true],
[new Array(3),false,true],[new Uint8Array(3),false,true],[new Map(),false,true]];
for(const [v,n,t] of cases){if(m.nullable(v)!==n||m.truthy(v)!==t)throw Error('predicate');}
const pairs=[[null,undefined,false],[NaN,NaN,false],[0,-0,true],[1,1n,false],['1',1,false],
[object,object,true],[{},{},false],[proxy,proxy,true],[revoked.proxy,revoked.proxy,true]];
for(const [a,b,e] of pairs){if(m.strict(a,b)!==e)throw Error('strict');}
if(m.observeNullable()!==true||events.join(',')!=='1')throw Error('nullable eval count');
if(m.observeTruthy()!==true||events.join(',')!=='1,2')throw Error('truthy eval count');
if(m.observeEqual()!==true||events.join(',')!=='1,2,3,4')throw Error('strict eval order');
if(reads!==0)throw Error('host reads');
console.log(JSON.stringify({cases:cases.length,pairs:pairs.length,reads,calls:events.length}));")

(deftest emitted-opaque-js-predicates-preserve-native-semantics
  (let [dir (fs/mkdtempSync (path/join (os/tmpdir) "kotoba-js-operations-"))
        file (path/join dir "library.mjs")]
    (try
      (fs/writeFileSync file (script/emit kir))
      (let [r (cp/spawnSync js/process.execPath #js ["--input-type=module" "-e" probe file]
                           #js {:encoding "utf8" :timeout 10000})]
        (is (= 0 (.-status r)) (.-stderr r))
        (when (= 0 (.-status r))
          (let [result (js->clj (js/JSON.parse (.-stdout r)) :keywordize-keys true)]
            (is (= 21 (:cases result)))
            (is (= 9 (:pairs result)))
            (is (= 0 (:reads result)))
            (is (= 4 (:calls result))))))
      (finally (fs/rmSync dir #js {:recursive true :force true})))))

(deftest opaque-js-predicates-require-exact-types-and-arities
  (doseq [[body types result] [['(js-nullish?) [:js-value] :bool]
                              ['(js-nullish? v v) [:js-value] :bool]
                              ['(js-truthy? v) [:i64] :bool]
                              ['(js-strict-equal? v) [:js-value] :bool]
                              ['(js-strict-equal? v v) [:string] :bool]
                              ['(js-nullish? v) [:js-value] :js-value]]]
    (is (some? (try (script/emit (assoc kir :exports ['bad] :functions
                       [{:name 'bad :params ['v] :param-types types :result result :body body}]))
                   nil (catch :default e (ex-message e)))))))
(defmethod t/report [::t/default :end-run-tests] [m]
  (when (or (not= 2 (:test m)) (not= 11 (:pass m)) (pos? (+ (:fail m) (:error m))))
    (js/process.exit 1)))
(run-tests 'test.nbb.js-operations)
