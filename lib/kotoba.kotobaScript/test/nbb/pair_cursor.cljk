(ns test.nbb.pair-cursor
  "A loop the frontend lifts to walk a pair chain carries the chain in an
  :i64 parameter, and a pair is an Array on this target. That parameter must
  be guarded as a pair word, not as an i64. `test/fixtures/doseq/pair-walk.kir.edn`
  is the KIR amu (f97f399b, kotoba-sema 64f58ab) lowers for

    (defn main []
      (+ 7 (doseq [x (rest (list 0 1 2 3)) :while (< x 3)]
             (if (= x 3) (quot 1 0) 0))))

  whose `main` is 7 on the KIR interpreter and wasm32, and was `invalid-i64`
  here: `__kotoba_loop_1` guarded its cursor with `assertI64`.

    kbb --backend sci --classpath src test/nbb/pair_cursor.cljk"
  (:require [cljs.reader :as reader]
            [kotoba.script :as script]
            ["node:child_process" :as cp]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]))

(def ^:private failures (atom 0))
(def ^:private checks (atom 0))
(defn- check! [label ok? detail]
  (swap! checks inc)
  (if ok? (println (str "ok   " label))
      (do (swap! failures inc) (println (str "FAIL " label " -- " (pr-str detail))))))

(defn- run [emitted program]
  (let [dir (fs/mkdtempSync (path/join (os/tmpdir) "kotoba-script-pair-cursor-"))
        file (path/join dir "fixture.mjs")]
    (try
      (fs/writeFileSync file (str emitted "\n" program))
      (let [r (cp/spawnSync js/process.execPath #js [file] #js {:encoding "utf8" :timeout 10000})]
        (when (zero? (.-status r))
          (js->clj (js/JSON.parse (.-stdout r)) :keywordize-keys true)))
      (finally (fs/rmSync dir #js {:recursive true :force true})))))

(defn- call [expression]
  (str "let out;try{out={status:'ok',value:String(" expression ")};}"
       "catch(e){out={status:'trap',error:String(e.message)};}"
       "console.log(JSON.stringify(out));"))

(let [module (reader/read-string (fs/readFileSync "lib/kotoba.kotobaScript/test/fixtures/doseq/pair-walk.kir.edn" "utf8"))
      emitted (script/emit module {:fuel 512})
      loop-fn (re-find #"function k\$__kotoba_loop_1\([^)]*\)\{[^}]*" emitted)]
  (check! "the cursor is guarded with assertPairWord, not assertI64"
          (and loop-fn
               (.includes loop-fn "=assertPairWord(k$__kotoba_doseq$002dcursor_3")
               (not (.includes loop-fn "=assertI64(k$__kotoba_doseq$002dcursor_3")))
          loop-fn)
  (check! "the index stays an i64"
          (and loop-fn (.includes loop-fn "=assertI64(k$__kotoba_doseq$002dindex_4"))
          loop-fn)
  (check! "main runs to 7 under node"
          (= {:status "ok" :value "7"} (run emitted (call "instantiateKotoba().main()")))
          :main)
  (check! "the guard still refuses what is neither a pair nor an i64"
          (= [{:status "trap" :error "invalid-i64"} {:status "trap" :error "invalid-i64"}]
             [(run emitted (call "instantiateKotoba()['__kotoba_loop_1']([1n,2n,3n],0n)"))
              (run emitted (call "instantiateKotoba()['__kotoba_loop_1']('x',0n)"))])
          :refusal))

(let [plain {:format :kotoba.kir/v3 :signature {:params [] :result :i64}
             :functions [{:name 'main :params [] :result :i64 :effects #{} :body '(pair-first (pair 7 0))}]
             :exports ['main] :effects #{} :entry 'main}
      emitted (script/emit plain {:fuel 512})]
  (check! "a module without a pair-reading parameter carries no assertPairWord"
          (not (.includes emitted "assertPairWord"))
          :plain))

(println (str "SCANNED\t" @checks "\tchecks; " (- @checks @failures) " passed, " @failures " failed"))
(js/process.exit (if (zero? @failures) 0 1))
