(ns test.nbb.budgets
  "P4 of superproject adr-2609242100: the ESM profile's four budgets -- fuel,
  cells, bytes, frames -- each with its own named trap, each shown in both
  directions (a run under budget answers; one unit short it throws the
  budget's name), each set per run through `instantiateKotoba(grants,
  budgets)` over the emitted default. `npm run test-budgets`."
  (:require [cljs.test :refer [deftest is run-tests]]
            [kotoba.script :as script]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]
            ["node:child_process" :as cp]))

(def lst [:variant :app/list [[:empty :i64] [:cons [:ref :app/cell]]]])
(def cell [:record :app/cell [[:head :i64] [:tail [:ref :app/list]]]])

;; 5 list cells: one variant + one record per `kons`, plus :empty = 11 cells
;; -- the same count osaho's kir_budgets_test pins for the reference.
(def build-five
  {:format :kotoba.kir/v4 :entry 'main :exports ['main] :effects #{}
   :schemas {:app/list lst :app/cell cell}
   :functions
   [{:name 'kons :params ['h 't] :param-types [:i64 [:ref :app/list]] :result [:ref :app/list]
     :body (list 'variant-new lst :cons (list 'record-new cell 'h 't))}
    {:name 'build :params ['n 'acc] :param-types [:i64 [:ref :app/list]]
     :result [:ref :app/list]
     :body (list 'if (list '= 'n 0) 'acc
                 (list 'build (list '- 'n 1) (list 'kons 'n 'acc)))}
    {:name 'main :params [] :param-types [] :result :i64
     :body (list 'variant-match lst (list 'build 5 (list 'variant-new lst :empty 0))
                 [[:empty '_ 0] [:cons '_ 1]])}]})

(def concat-six
  {:format :kotoba.kir/v4 :entry 'main :exports ['main] :effects #{}
   :functions [{:name 'main :params [] :param-types [] :result :i64
                :body (list 'string-byte-length (list 'string-concat "abc" "def"))}]})

(def deep
  {:format :kotoba.kir/v4 :entry 'main :exports ['main] :effects #{}
   :functions [{:name 'main :params [] :param-types [] :result :i64 :body (list 'deep 4)}
               {:name 'deep :params ['n] :param-types [:i64] :result :i64
                :body (list 'if (list '<= 'n 0) 0
                            (list '+ 1 (list 'deep (list '- 'n 1))))}]})

(defn- run
  "Instantiate KIR's module with BUDGETS (a JS object literal) and call main:
  the printed value, or THREW:<message>."
  [kir budgets]
  (let [dir (fs/mkdtempSync (path/join (os/tmpdir) "kotoba-budgets-"))
        file (path/join dir "m.mjs")]
    (try
      (fs/writeFileSync file (str (script/emit kir {:fuel 100000})
                                  "\ntry{console.log(String(instantiateKotoba({}," budgets ").main()))}"
                                  "catch(e){console.log('THREW:'+e.message)}"))
      (.trim (str (.-stdout (cp/spawnSync js/process.execPath #js [file] #js {:encoding "utf8" :timeout 20000}))))
      (finally (fs/rmSync dir #js {:recursive true :force true})))))

(deftest cells
  (is (= "1" (run build-five "{cells:11}")))
  (is (= "THREW:budget/cells" (run build-five "{cells:10}")))
  (is (= "1" (run build-five "{}")) "not metered by default"))

(deftest bytes
  (is (= "6" (run concat-six "{bytes:6}")))
  (is (= "THREW:budget/bytes" (run concat-six "{bytes:5}")))
  (is (= "6" (run concat-six "{}"))))

(deftest fuel-and-frames
  (is (= "4" (run deep "{fuel:6}")))
  (is (= "THREW:budget/fuel" (run deep "{fuel:5}")))
  (is (= "4" (run deep "{frames:6}")))
  (is (= "THREW:budget/frames" (run deep "{frames:5}"))))

;; amu ADR 0353 point 7 (floor :allocation-budget-targets): a constructor
;; debits FUEL as well as a cell, as kotoba.kir does, so fuel bounds what a run
;; builds whether or not cells are metered. build-five pays 12 entries (main,
;; build x6, kons x5) and 11 constructors: 23. Before, 12 answered.
(deftest constructors-charge-fuel
  (is (= "1" (run build-five "{fuel:23}")))
  (is (= "THREW:budget/fuel" (run build-five "{fuel:22}")))
  (is (= "THREW:budget/fuel" (run build-five "{fuel:12}")))
  (is (= "THREW:budget/cells" (run build-five "{fuel:23,cells:10}"))
      "the cells ledger still traps by its own name"))

(deftest a-budget-outside-its-range-is-refused
  (is (= "THREW:budget-outside-admitted-range:cells" (run deep "{cells:0}")))
  (is (= :frames-outside-admitted-range
         (:reason (try (script/emit deep {:frames 0}) nil (catch :default e (ex-data e)))))))

(deftest the-default-frames-budget-fires-before-the-engine-stack
  ;; 2,000 deep is under Node's default stack for this body (3,967 measured)
  ;; and over the 1024 default: the budget, not RangeError, answers.
  ;; main + deep(2000..0) = 2,002 frames.
  (let [deep-n (assoc-in deep [:functions 0 :body] (list 'deep 2000))]
    (is (= "THREW:budget/frames" (run deep-n "{}")))
    (is (= "2000" (run deep-n "{frames:2002}")))))

(defmethod cljs.test/report [:cljs.test/default :end-run-tests] [m]
  (println "RESULT" (pr-str (select-keys m [:test :pass :fail :error])))
  (when-not (cljs.test/successful? m) (set! (.-exitCode js/process) 1)))
(run-tests 'test.nbb.budgets)
