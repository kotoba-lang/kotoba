(ns test.nbb.js-value
  (:require [cljs.test :as t :refer [deftest is run-tests]]
            [kotoba.script :as script]
            ["node:fs" :as fs] ["node:os" :as os]
            ["node:path" :as path] ["node:child_process" :as cp]))
(def kir {:format :kotoba.kir/v4 :entry nil :exports ['keep] :effects #{}
          :functions [{:name 'helper :params ['v] :param-types [:js-value]
                       :result :js-value :body 'v}
                      {:name 'keep :params ['v] :param-types [:js-value]
                       :result :js-value :body '(helper v)}]})
(def probe "const mod=await import(process.argv[1]);const m=mod.instantiateKotoba();\nlet reads=0;const cycle={};cycle.self=cycle;const getter={};\nObject.defineProperty(getter,'property',{get(){reads++;throw Error('getter');}});\nconst proxy=new Proxy({},{get(){reads++;throw Error('proxy');}});\nconst revoked=Proxy.revocable({},{});revoked.revoke();\nconst view=new Uint8Array(new ArrayBuffer(12),2,3);\nconst values=[undefined,null,NaN,-0,Infinity,1.5,7,7n,'foo',true,()=>{},Symbol('x'),{},getter,proxy,revoked.proxy,cycle,view,new Date(),/x/,new Map(),new Set(),new Array(5),Object.freeze([7n])];\nfor(let i=0;i<values.length;i++){if(!Object.is(m.keep(values[i]),values[i]))throw Error('identity:'+i);}\nif(reads!==0||Object.keys(m).join(',')!=='keep')throw Error('boundary');\nconsole.log(JSON.stringify({cases:values.length,reads,exports:Object.keys(m)}));\n")
(deftest raw-values-pass-export-and-private-call-with-exact-identity
  (let [dir (fs/mkdtempSync (path/join (os/tmpdir) "kotoba-js-value-"))
        file (path/join dir "library.mjs")]
    (try
      (fs/writeFileSync file (script/emit kir))
      (let [r (cp/spawnSync js/process.execPath #js ["--input-type=module" "-e" probe file]
                           #js {:encoding "utf8" :timeout 10000})]
        (is (= 0 (.-status r)) (.-stderr r))
        (when (= 0 (.-status r))
          (let [result (js->clj (js/JSON.parse (.-stdout r)) :keywordize-keys true)]
            (is (= 24 (:cases result)))
            (is (= 0 (:reads result)))
            (is (= ["keep"] (:exports result))))))
      (finally (fs/rmSync dir #js {:recursive true :force true})))))
(deftest opaque-types-do-not-weaken-static-typing-or-canonical-order
  (is (some? (try (script/emit (assoc-in kir [:functions 0 :result] :i64)) nil
                  (catch :default e (ex-message e)))))
  (doseq [type [[:set :js-value] [:set [:list :js-value]]
               [:map :js-value :i64] [:map [:option :js-value] :string]]]
    (is (some? (try (script/emit (assoc kir :exports ['keep] :functions
                      [{:name 'keep :params ['v] :param-types [type] :result type :body 'v}]))
                   nil (catch :default e (ex-message e)))))))
(defmethod t/report [::t/default :end-run-tests] [m]
  (when (or (not= 2 (:test m)) (not= 9 (:pass m)) (pos? (+ (:fail m) (:error m))))
    (js/process.exit 1)))
(run-tests 'test.nbb.js-value)
