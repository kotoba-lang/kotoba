(ns test.nbb.js-undefined
  (:require [cljs.test :as t :refer [deftest is run-tests]]
            [kotoba.script :as script]
            ["node:fs" :as fs] ["node:os" :as os]
            ["node:path" :as path] ["node:child_process" :as child]))

(def kir {:format :kotoba.kir/v4 :entry nil :exports ['noop] :effects #{}
          :functions [{:name 'noop :params [] :param-types []
                       :result :js-value :body '(js-undefined)}]})

(deftest emitted-undefined-preserves-noop-return-for-ignored-arguments
  (let [dir (fs/mkdtempSync (path/join (os/tmpdir) "kotoba-js-undefined-"))
        file (path/join dir "library.mjs")
        probe "const m=(await import(process.argv[1])).instantiateKotoba();
const revoked=Proxy.revocable({},{});revoked.revoke();
const values=[undefined,null,false,true,0,-0,NaN,'',{},revoked.proxy];
if(!Object.is(m.noop(),undefined)||m.noop.length!==0)throw Error('zero arg undefined');
for(const v of values)if(!Object.is(m.noop(v,v),undefined))throw Error('ignored argument');
console.log(JSON.stringify({values:values.length}));"]
    (try
      (fs/writeFileSync file (script/emit kir))
      (let [result (child/spawnSync js/process.execPath #js ["--input-type=module" "-e" probe file]
                                   #js {:encoding "utf8" :timeout 10000})]
        (is (= 0 (.-status result)) (.-stderr result))
        (when (= 0 (.-status result))
          (is (= 10 (:values (js->clj (js/JSON.parse (.-stdout result)) :keywordize-keys true))))))
      (finally (fs/rmSync dir #js {:recursive true :force true})))))

(deftest undefined-has-zero-arity-and-an-opaque-result
  (doseq [[body result] [['(js-undefined 0) :js-value]
                         ['(js-undefined 0 1) :js-value]
                         ['(js-undefined) :bool] ['(js-undefined) :string]]]
    (is (some? (try (script/emit (assoc-in (assoc-in kir [:functions 0 :body] body)
                                         [:functions 0 :result] result))
                   nil (catch :default e (ex-message e)))))))

(defmethod t/report [::t/default :end-run-tests] [m]
  (when (or (not= 2 (:test m)) (not= 6 (:pass m)) (pos? (+ (:fail m) (:error m))))
    (js/process.exit 1)))
(run-tests 'test.nbb.js-undefined)
