(ns kotoba.script.js-value-test
  (:require [cljs.test :refer [deftest is testing]]
            [kotoba.script.js-value :as value]))

(deftest explicit-opaque-descriptors-and-inert-labels
  (doseq [[descriptor expected]
          [[:js-value true] [:i64 false] [:string false]
           [[:ref :app/node] false]
           [[:record :app/node [[:js-value :string]]] false]
           [[:variant :app/node [[:js-value :i64]]] false]
           [[:record :app/node [[:payload :js-value]]] true]
           [[:variant :app/node [[:payload :js-value]]] true]
           [[:vector [:i64 :bool]] false]
           [[:vector [:i64 :js-value]] true]
           [[:map :i64 :js-value] true]
           [[:map :js-value :i64] true]
           [[:result :i64 :js-value] true]
           [[:result :js-value :i64] true]]]
    (is (= expected (value/contains-type? descriptor))))
  (doseq [head [:option :list :set :stream :task]]
    (is (true? (value/contains-type? [head :js-value])))
    (is (false? (value/contains-type? [head :string])))))

(deftest bounded-nested-descriptors
  (doseq [depth (range 13)
          leaf [:i64 :js-value]]
    (let [descriptor (nth (iterate #(vector :list %) leaf) depth)]
      (is (= (= leaf :js-value) (value/contains-type? descriptor)))))
  (let [fields (mapv #(vector (keyword (str "field" %)) :i64) (range 32))]
    (is (false? (value/contains-type? [:record :app/wide fields])))
    (is (true? (value/contains-type? [:record :app/wide
                                    (assoc-in fields [31 1] :js-value)])))))
