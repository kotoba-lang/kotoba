                     "for(const v of [0,-0,Math.PI/2,-Math.PI/2,Math.PI,-Math.PI,limit,-limit]){"
                     "if(Math.abs(x.sin(v)-Math.sin(v))>5e-12||Math.abs(x.cos(v)-Math.cos(v))>5e-12)process.exit(2);}"
                     "for(let i=0;i<=128;i++){const v=-limit+2*limit*i/128;"
