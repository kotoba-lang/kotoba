                     "').then(m=>{const x=m.instantiateKotoba({});"
                     "for(let i=0;i<=128;i++){const v=-0.5+i/128;"
                     "if(Math.abs(x.exp(v)-Math.exp(v))>4e-15)process.exit(2);}"
