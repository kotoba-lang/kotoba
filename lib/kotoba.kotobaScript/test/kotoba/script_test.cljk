                     "'f64-log-near-one-domain']]){for(const v of values){try{f(v);process.exit(5)}catch(e){"
                     "if(e.message!==message)process.exit(6)}}}})"
                     ".catch(e=>{console.error(e.message);process.exit(99)})"))]
