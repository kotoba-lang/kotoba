(ns kotoba.script-bytes-value-test
  "`:bytes` and the string constructor in emitted ESM (2026-09-25, superproject
  adr-2609242330): the module is emitted, executed under Node, and every
  refusal is pinned by the reference interpreter's trap name -- the ESM
  prelude's `Error.message`. Runs on nbb (the JDK-free host) as well as the
  JVM."
  (:require [kotoba.io :as kio] [kotoba.test :refer [deftest is testing]]
            [kotoba.script :as script]
            #?@(:cljs [["node:child_process" :as child]
                       ["node:fs" :as fs]
                       ["node:os" :as os]
                       ["node:path" :as path]])))

(def ^:private kir
  {:format :kotoba.kir/v4 :entry nil :exports ['text 'count3 'roundtrip 'refuse]
   :effects #{}
   :functions
   [{:name 'text :params [] :param-types [] :result :string :effects #{}
     :body '(string-from-utf8 (bytes-from-vector-i64 (vector-new 104 105 227 129 130 240 159 152 128)))}
    {:name 'count3 :params [] :param-types [] :result :i64 :effects #{}
     :body '(bytes-count (bytes-concat (bytes-slice (bytes-from-vector-i64 (vector-new 1 2 3 4)) 1 3)
                                       (bytes-from-vector-i64 (vector-new 9))))}
    {:name 'roundtrip :params [] :param-types [] :result :i64 :effects #{}
     :body '(vector-at (vector-i64-from-bytes (bytes-from-vector-i64 (vector-new 7 255))) 1)}
    {:name 'refuse :params '[a b c] :param-types [:i64 :i64 :i64] :result :string :effects #{}
     :body '(string-from-utf8 (bytes-from-vector-i64 (vector-new a b c)))}]})

(defn- run-module
  "Emit KIR, run JS against it under Node, answer {:exit :out :err}."
  [js]
  #?(:clj (let [dir (java.nio.file.Files/createTempDirectory "kotoba-script-bytes" (make-array java.nio.file.attribute.FileAttribute 0))
                module (kio/file (.toFile dir) "m.mjs")
                main (kio/file (.toFile dir) "run.mjs")]
            (spit module (script/emit kir))
            (spit main (str "import * as m from './m.mjs';" js))
            (let [p (.start (ProcessBuilder. ["node" (kio/path main)]))
                  out (slurp (.getInputStream p)) err (slurp (.getErrorStream p))]
              {:exit (.waitFor p) :out out :err err}))
     :cljs (let [dir (fs/mkdtempSync (path/join (os/tmpdir) "kotoba-script-bytes-"))
                 module (path/join dir "m.mjs")
                 main (path/join dir "run.mjs")]
             (fs/writeFileSync module (script/emit kir))
             (fs/writeFileSync main (str "import * as m from './m.mjs';" js))
             (let [r (child/spawnSync "node" #js [main] #js {:encoding "utf8"})]
               {:exit (.-status r) :out (.-stdout r) :err (.-stderr r)}))))

(deftest the-constructors-run-in-emitted-esm
  (let [{:keys [exit out err]}
        (run-module (str "const x=m.instantiateKotoba({});"
                         "console.log(JSON.stringify([x.text(),String(x.count3()),String(x.roundtrip())]));"))]
    (is (= 0 exit) err)
    (is (= "[\"hiあ😀\",\"3\",\"255\"]\n" out))))

(deftest every-refusal-carries-the-reference-name
  (let [cases [[[0xc0 0x80 0x41] "utf8/overlong"]
               [[0xed 0xa0 0x80] "utf8/surrogate"]
               [[0xf4 0x90 0x80] "utf8/above-max"]
               [[0xf5 0x41 0x41] "utf8/invalid-byte"]
               [[0x80 0x41 0x41] "utf8/unexpected-continuation"]
               [[0x41 0x41 0xe3] "utf8/truncated"]
               [[0xe3 0x41 0x82] "utf8/bad-continuation"]
               [[0x41 256 0x41] "bytes/item-out-of-range"]]
        {:keys [exit out err]}
        (run-module (str "const x=m.instantiateKotoba({});const r=[];"
                         "for(const a of [" (apply str (interpose "," (map #(str "[" (apply str (interpose "," %)) "]") (map first cases)))) "]){"
                         "try{x.refuse(...a.map(BigInt));r.push('no-trap')}catch(e){r.push(e.message)}}"
                         "console.log(r.join(','));"))]
    (is (= 0 exit) err)
    (is (= (str (apply str (interpose "," (map second cases))) "\n") out))))
