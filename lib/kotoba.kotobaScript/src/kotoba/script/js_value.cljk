(ns kotoba.script.js-value
  "Inspect validated, bounded type descriptors, never host values."
  {:kotoba/export [contains-type?]})

;; -- Kotoba reading (W3: JUN-202 selfbuild scan refused this module E2101
;; "unknown or unsupported form 'empty?'", the host-only stack walk below).
;; The host reading is kept byte-for-byte as :default.
;;
;; The oracle walks a work stack: a node is the keyword :js-value (found),
;; a Clojure vector (head rule below), or anything else (skipped). The walk
;; is an existence check, so the stack order does not matter and the port
;; spells it as recursion. The head rule is semantic ("explicitly contains"),
;; so unknown heads prune their subtree exactly as the oracle's default pop:
;;   (:option :list :set :stream :task) -> child 1
;;   (:result :map)                     -> children 1 and 2
;;   :vector                            -> the items of child 1 (the oracle's
;;                                         (into stack (second current)))
;;   (:record :variant)                 -> the second of each field of child 2
;;                                         (labels and IDs are ignored)
;;   anything else                      -> the node is skipped whole
;;
;; Two bounded divergences from the host reading, both unexercised by the
;; tree's callers (kotoba.script passes element types of :set / :map):
;; - child 1 of a :vector that is not a collection: the oracle's `into`
;;   throws on a non-seqable; the port checks it as one node.
;; - child 1 that is a map literal: the oracle splices map entries (MapEntry
;;   is a vector, so each entry runs the head rule with its key as head); the
;;   port does the same by walking the entries as pair nodes.
;; Measured (seed r6n b3f46d32a01780fe, compile --emit-module): recorded on
;; Linear AWAI-77.

#?(:kotoba
   (defn- dg [d :document i :i64] :document
     (option-value-of [:option :document] (document-list-at d i) (document-null))))

#?(:kotoba
   (defn- is-coll [d :document] :bool
     (or (= (document-kind d) :vector) (= (document-kind d) :list))))

#?(:kotoba
   (defn- node-js? [node :document] :bool
     (if (document-equal? node (document-keyword :js-value))
       true
       (if (is-coll node)
         (let [h (dg node 0)]
           (cond
             (document-equal? h (document-keyword :option)) (node-js? (dg node 1))
             (document-equal? h (document-keyword :list)) (node-js? (dg node 1))
             (document-equal? h (document-keyword :set)) (node-js? (dg node 1))
             (document-equal? h (document-keyword :stream)) (node-js? (dg node 1))
             (document-equal? h (document-keyword :task)) (node-js? (dg node 1))
             (document-equal? h (document-keyword :result)) (or (node-js? (dg node 1)) (node-js? (dg node 2)))
             (document-equal? h (document-keyword :map)) (or (node-js? (dg node 1)) (node-js? (dg node 2)))
             (document-equal? h (document-keyword :vector)) (splice-js? (dg node 1))
             (document-equal? h (document-keyword :record)) (fields-js? (dg node 2) 0 (document-count (dg node 2)))
             (document-equal? h (document-keyword :variant)) (fields-js? (dg node 2) 0 (document-count (dg node 2)))
             :else false))
         false))))

#?(:kotoba
   (defn- items-js? [d :document i :i64 n :i64] :bool
     (if (>= i n)
       false
       (if (node-js? (dg d i)) true (items-js? d (+ i 1) n)))))

#?(:kotoba
   (defn- entries-js? [m :document i :i64 n :i64] :bool
     (if (>= i n)
       false
       (if (node-js? (option-value-of [:option :document] (document-map-entry-at m i) (document-null)))
         true
         (entries-js? m (+ i 1) n)))))

#?(:kotoba
   (defn- splice-js? [c :document] :bool
     (if (is-coll c)
       (items-js? c 0 (document-count c))
       (if (= (document-kind c) :map)
         (entries-js? c 0 (document-count c))
         (node-js? c)))))

#?(:kotoba
   (defn- fields-js? [fs :document i :i64 n :i64] :bool
     (if (>= i n)
       false
       (if (node-js? (dg (dg fs i) 1)) true (fields-js? fs (+ i 1) n)))))

#?(:kotoba
   (defn contains-type? [type :document] :bool
     (node-js? type))
   :default
(defn contains-type?
  "True when a descriptor explicitly contains :js-value; ignore labels and IDs."
  [type]
  (loop [stack [type]]
    (if (empty? stack)
      false
      (let [current (peek stack)]
        (if (= :js-value current)
          true
          (if (vector? current)
            (let [head (first current)]
              (case head
                (:option :list :set :stream :task)
                (recur (conj (pop stack) (second current)))
                (:result :map)
                (recur (conj (pop stack) (second current) (nth current 2)))
                :vector
                (recur (into (pop stack) (second current)))
                (:record :variant)
                (recur (into (pop stack) (map second (nth current 2))))
                (recur (pop stack))))
            (recur (pop stack)))))))))
