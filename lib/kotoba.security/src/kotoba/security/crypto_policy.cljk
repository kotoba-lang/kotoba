;; ══════════════════════════════════════════════════════════════════════════════════════════════
;; R6QW3: the Kotoba reading (W3: the selfbuild scan refused this module E2124 at
;; inventory-entry-required's keyword vector, then E2101 at first-truthy's `seq`). The host
;; reading of every form below is kept byte-for-byte as :default.
;;
;; Port decisions (oracle semantics preserved):
;; - Every value is a :document (policy / envelope / provider / entry / register as maps).
;; - The error-or-none contract of the private checkers: an ERROR is the invalid document
;;   (the oracle's {:valid? false :message .. :data ..}); NO ERROR is (document-null), the
;;   oracle's nil. The public check-* functions unwrap to the error document or {:valid? true}.
;; - first-truthy (the oracle's clojure.core/some over a seq) is unrolled at its two call sites
;;   as document walks (missing-key-walk / entry-error-walk); the generic pred+coll iteration
;;   has no fn-value typing on this reading.
;; - (seq x) as an emptiness test is a document-null / count check; keyword access (:k/e d) is
;;   dgk; the keyword set defs stay the shared set literals and membership is
;;   typed-set-contains over the keyword value of an item document.
;; ══════════════════════════════════════════════════════════════════════════════════════════════

(ns kotoba.security.crypto-policy
  "FIPS/PQC crypto policy checks (kotoba-lang/kotoba#264).

  Deployable, testable policy over cryptographic envelopes and the crypto
  inventory register. Modes (policy/crypto-policy.edn):

  - :crypto-agile     envelopes must carry provider and algorithm metadata;
  - :hybrid-required  KEM envelopes must be hybrid classical+PQ for epochs
                      >= :hybrid-epoch-floor;
  - :fips-required    providers must be FIPS-validated and inventory entries
                      must not be :crypto/fips-status :not-claimed.

  See docs/fips-validation.md and docs/pqc-roadmap.md."
  {:kotoba/export [check-envelope check-inventory check-production-envelope classical-kems envelope-error evaluate-pq-provider hybrid-kem-components? invalid inventory-entry-error inventory-entry-required inventory-error known-modes missing-key policy-error pq-kems provider-metadata-error rotate-envelope]}
  (:require [kotoba.lang.coll :as set]))

#?(:kotoba
   (defn- dgk [d :document k :keyword] :document
     (option-value-of [:option :document] (document-get d k) (document-null))))

#?(:kotoba
   (defn- doc-i64 [d :document] :i64
     (option-value-of [:option :i64] (document-i64-value d) 0)))

#?(:kotoba
   (defn- none? [d :document] :bool
     (document-equal? d (document-null))))

#?(:kotoba
   (defn- valid-doc [] :document
     (document-map (document-keyword :valid?) (document-bool true))))

#?(:kotoba
   (defn- modes-doc [] :document
     (document-set (document-keyword :crypto-agile) (document-keyword :hybrid-required)
                   (document-keyword :fips-required))))

;; true when some item of the document list d is a keyword member of the set st
#?(:kotoba
   (defn- item-in-set? [d :document st [:set :keyword] i :i64 n :i64] :bool
     (if (>= i n)
       false
       (if (typed-set-contains [:set :keyword] st
                               (option-value-of [:option :keyword]
                                                (document-keyword-value
                                                 (option-value-of [:option :document] (document-list-at d i) (document-null)))
                                                :none))
         true
         (item-in-set? d st (+ i 1) n)))))


#?(:kotoba
   (def ^:private first-truthy-unrolled
     "the host reading's generic (some pred coll); the Kotoba reading walks documents at the
     call sites instead (missing-key-walk / the inventory walk in inventory-error)")
   :default
(defn- first-truthy [pred coll]
  (loop [s (seq coll)]
    (when s
      (or (pred (first s)) (recur (next s)))))))

#?(:kotoba
   (defn known-modes [] [:set :keyword] #{:crypto-agile :hybrid-required :fips-required})
   :default
(def known-modes
  #{:crypto-agile :hybrid-required :fips-required}))

#?(:kotoba
   (defn classical-kems [] [:set :keyword] #{:x25519 :p-256})
   :default
(def classical-kems #{:x25519 :p-256}))

#?(:kotoba
   (defn pq-kems [] [:set :keyword] #{:ml-kem-768})
   :default
(def pq-kems #{:ml-kem-768}))

#?(:kotoba
   (defn evaluate-pq-provider [evidence :document expected-module-digest :document] :document
     (let [algs (dgk evidence :provider/algorithms)
           n (document-count algs)
           v0 (if (= (document-kind (dgk evidence :provider/id)) :keyword) (document-null) (document-keyword :provider-id))
           v1 (if (= (document-kind (dgk evidence :provider/implementation-version)) :string) (document-null) (document-keyword :implementation-version))
           v2 (if (document-equal? expected-module-digest (dgk evidence :provider/module-digest)) (document-null) (document-keyword :module-binding))
           v3 (if (item-in-set? algs (pq-kems) 0 n) (document-null) (document-keyword :ml-kem-768))
           v4 (if (document-equal? (dgk evidence :provider/known-answer-tests-passed?) (document-bool true)) (document-null) (document-keyword :known-answer-tests))]
       (let [v5 (if (document-equal? (dgk evidence :provider/encapsulation-verified?) (document-bool true)) (document-null) (document-keyword :encapsulation))
             v6 (if (document-equal? (dgk evidence :provider/decapsulation-verified?) (document-bool true)) (document-null) (document-keyword :decapsulation))
             v7 (if (document-equal? (dgk evidence :provider/invalid-ciphertext-rejected?) (document-bool true)) (document-null) (document-keyword :invalid-ciphertext))
             v8 (if (document-equal? (dgk evidence :provider/module-load-failed-closed?) (document-bool true)) (document-null) (document-keyword :module-load-fail-closed))
             vs (document-edn-read
                 (str "[" (if (none? v0) "" " :provider-id") (if (none? v1) "" " :implementation-version")
                      (if (none? v2) "" " :module-binding") (if (none? v3) "" " :ml-kem-768")
                      (if (none? v4) "" " :known-answer-tests") (if (none? v5) "" " :encapsulation")
                      (if (none? v6) "" " :decapsulation") (if (none? v7) "" " :invalid-ciphertext")
                      (if (none? v8) "" " :module-load-fail-closed") "]"))]
         (document-map (document-keyword :pq-provider/qualified?) (document-bool (none? vs))
                       (document-keyword :pq-provider/id) (dgk evidence :provider/id)
                       (document-keyword :pq-provider/module-digest) (dgk evidence :provider/module-digest)
                       (document-keyword :pq-provider/violations) vs
                       (document-keyword :pq-provider/non-claims)
                       (document-set (document-keyword :fips-validation) (document-keyword :side-channel-certification))))))
   :default
(defn evaluate-pq-provider
  "Qualify the deployed ML-KEM provider identity and executable module.

  Certification is deliberately not inferred from algorithm labels or KATs."
  [evidence expected-module-digest]
  (let [algorithms (set (:provider/algorithms evidence))
        violations
        (cond-> []
          (not (keyword? (:provider/id evidence))) (conj :provider-id)
          (not (string? (:provider/implementation-version evidence)))
          (conj :implementation-version)
          (not= expected-module-digest (:provider/module-digest evidence))
          (conj :module-binding)
          (not (contains? algorithms :ml-kem-768)) (conj :ml-kem-768)
          (not= true (:provider/known-answer-tests-passed? evidence))
          (conj :known-answer-tests)
          (not= true (:provider/encapsulation-verified? evidence))
          (conj :encapsulation)
          (not= true (:provider/decapsulation-verified? evidence))
          (conj :decapsulation)
          (not= true (:provider/invalid-ciphertext-rejected? evidence))
          (conj :invalid-ciphertext)
          (not= true (:provider/module-load-failed-closed? evidence))
          (conj :module-load-fail-closed))]
    {:pq-provider/qualified? (empty? violations)
     :pq-provider/id (:provider/id evidence)
     :pq-provider/module-digest (:provider/module-digest evidence)
     :pq-provider/violations violations
     :pq-provider/non-claims #{:fips-validation :side-channel-certification}})))

#?(:kotoba
   (defn hybrid-kem-components? [algorithms :document] :bool
     (let [n (document-count algorithms)]
       (and (item-in-set? algorithms (classical-kems) 0 n)
            (item-in-set? algorithms (pq-kems) 0 n))))
   :default
(defn hybrid-kem-components? [algorithms]
  (let [algorithms (set algorithms)]
    (and (seq (set/set-intersection algorithms classical-kems))
         (seq (set/set-intersection algorithms pq-kems))))))

#?(:kotoba
   (defn invalid [message :document data :document] :document
     (document-map (document-keyword :valid?) (document-bool false)
                   (document-keyword :message) message
                   (document-keyword :data) data))
   :default
(defn invalid
  [message data]
  {:valid? false :message message :data data}))


;; the first key of ks absent from m (an error document), or null -- first-truthy unrolled
#?(:kotoba
   (defn- missing-key-walk [m :document ks :document i :i64 n :i64] :document
     (if (>= i n)
       (document-null)
       (let [k (option-value-of [:option :document] (document-list-at ks i) (document-null))]
         (if (document-contains m k)
           (missing-key-walk m ks (+ i 1) n)
           (invalid (document-string "missing required crypto inventory field")
                    (document-map (document-keyword :missing) k)))))))


#?(:kotoba
   (defn missing-key [m :document ks :document message :document] :document
     (missing-key-walk m ks 0 (document-count ks)))
   :default
(defn missing-key
  [m keys message]
  (first-truthy (fn [k] (when-not (contains? m k) (invalid message {:missing k}))) keys)))

#?(:kotoba
   (defn policy-error [policy :document] :document
     (if (not (document-equal? (dgk policy :kotoba.security/crypto-policy-version) (document-i64 1)))
       (invalid (document-string "crypto policy version 1 required")
                (document-map (document-keyword :value) (dgk policy :kotoba.security/crypto-policy-version)))
       (if (not (item-in-set? (document-map (document-keyword :x) (dgk policy :mode)) (known-modes) 0 1))
         (invalid (document-string "unknown crypto policy mode")
                  (document-map (document-keyword :mode) (dgk policy :mode)
                                (document-keyword :allowed) (modes-doc)))
         (document-null))))
   :default
(defn policy-error
  [policy]
  (or
   (when-not (= 1 (:kotoba.security/crypto-policy-version policy))
     (invalid "crypto policy version 1 required"
              {:value (:kotoba.security/crypto-policy-version policy)}))
   (when-not (contains? known-modes (:mode policy))
     (invalid "unknown crypto policy mode"
              {:mode (:mode policy) :allowed known-modes})))))

#?(:kotoba
   (defn provider-metadata-error [envelope :document] :document
     (let [provider (dgk envelope :envelope/provider)]
       (if (none? provider)
         (invalid (document-string "provider metadata required")
                  (document-map (document-keyword :envelope) envelope))
         (if (not (= (document-kind (dgk provider :provider/id)) :keyword))
           (invalid (document-string "provider id required")
                    (document-map (document-keyword :provider) provider))
           (if (not (= (document-kind (dgk provider :provider/fips-validated)) :bool))
             (invalid (document-string "provider fips-validated flag required")
                      (document-map (document-keyword :provider) provider))
             (document-null))))))
   :default
(defn provider-metadata-error
  "Envelopes missing provider metadata are rejected under any mode
  (docs/fips-validation.md: record crypto provider metadata in envelopes)."
  [envelope]
  (let [provider (:envelope/provider envelope)]
    (or
     (when (nil? provider)
       (invalid "provider metadata required" {:envelope envelope}))
     (when-not (keyword? (:provider/id provider))
       (invalid "provider id required" {:provider provider}))
     (when-not (boolean? (:provider/fips-validated provider))
       (invalid "provider fips-validated flag required" {:provider provider}))))))

#?(:kotoba
   (defn envelope-error [policy :document envelope :document] :document
     (let [pe (policy-error policy)]
       (if (none? pe)
         (let [pme (provider-metadata-error envelope)]
           (if (none? pme)
             (let [algs (dgk envelope :envelope/algorithms)]
               (if (and (= (document-kind algs) :vector) (> (document-count algs) 0))
                 (let [mode (dgk policy :mode)]
                   (if (document-equal? mode (document-keyword :fips-required))
                     (if (document-equal? (dgk (dgk envelope :envelope/provider) :provider/fips-validated) (document-bool true))
                       (document-null)
                       (invalid (document-string "fips-validated provider required")
                                (document-map (document-keyword :provider) (dgk envelope :envelope/provider))))
                     (if (document-equal? mode (document-keyword :hybrid-required))
                       (if (and (document-equal? (dgk envelope :envelope/kem?) (document-bool true))
                                (>= (doc-i64 (dgk envelope :envelope/epoch)) (doc-i64 (dgk policy :hybrid-epoch-floor)))
                                (or (not (document-equal? (dgk envelope :envelope/hybrid?) (document-bool true)))
                                    (not (hybrid-kem-components? algs))))
                         (invalid (document-string "hybrid kem required for new epochs")
                                  (document-map (document-keyword :epoch) (dgk envelope :envelope/epoch)
                                                (document-keyword :algorithms) algs
                                                (document-keyword :hybrid-epoch-floor) (dgk policy :hybrid-epoch-floor)))
                         (document-null))
                       (document-null))))
                 (invalid (document-string "envelope algorithm metadata required")
                          (document-map (document-keyword :value) algs))))
             pme))
         pe)))
   :default
(defn envelope-error
  [policy envelope]
  (or
   (policy-error policy)
   (provider-metadata-error envelope)
   (when-not (and (vector? (:envelope/algorithms envelope))
                  (seq (:envelope/algorithms envelope)))
     (invalid "envelope algorithm metadata required"
              {:value (:envelope/algorithms envelope)}))
   (case (:mode policy)
     :fips-required
     (when-not (true? (get-in envelope [:envelope/provider :provider/fips-validated]))
       (invalid "fips-validated provider required"
                {:provider (:envelope/provider envelope)}))

     :hybrid-required
     (when (and (true? (:envelope/kem? envelope))
                (>= (:envelope/epoch envelope 0)
                    (:hybrid-epoch-floor policy 0))
                (or (not (true? (:envelope/hybrid? envelope)))
                    (not (hybrid-kem-components? (:envelope/algorithms envelope)))))
       (invalid "hybrid kem required for new epochs"
                {:epoch (:envelope/epoch envelope)
                 :algorithms (:envelope/algorithms envelope)
                 :hybrid-epoch-floor (:hybrid-epoch-floor policy)}))

     :crypto-agile nil))))

#?(:kotoba
   (defn check-envelope [policy :document envelope :document] :document
     (let [error (envelope-error policy envelope)]
       (if (none? error) (valid-doc) error)))
   :default
(defn check-envelope
  "Validates envelope metadata against the crypto policy.
  Returns {:valid? true} or {:valid? false :message .. :data ..}."
  [policy envelope]
  (if-let [error (envelope-error policy envelope)]
    error
    {:valid? true})))

#?(:kotoba
   (defn check-production-envelope [policy :document envelope :document] :document
     (let [checked (check-envelope policy envelope)]
       (if (not (document-equal? (dgk checked :valid?) (document-bool true)))
         checked
         (if (not (document-equal? (dgk policy :mode) (document-keyword :hybrid-required)))
           (invalid (document-string "production boundary requires hybrid-required mode")
                    (document-map (document-keyword :mode) (dgk policy :mode)))
           (if (< (doc-i64 (dgk envelope :envelope/epoch)) (doc-i64 (dgk policy :hybrid-epoch-floor)))
             (invalid (document-string "legacy envelope epoch forbidden at production boundary")
                      (document-map (document-keyword :epoch) (dgk envelope :envelope/epoch)
                                    (document-keyword :hybrid-epoch-floor) (dgk policy :hybrid-epoch-floor)))
             (if (not (hybrid-kem-components? (dgk envelope :envelope/algorithms)))
               (invalid (document-string "production boundary requires classical plus ML-KEM-768")
                        (document-map (document-keyword :algorithms) (dgk envelope :envelope/algorithms)))
               checked))))))
   :default
(defn check-production-envelope
  "Strict production admission rejects migration-era legacy envelopes."
  [policy envelope]
  (let [checked (check-envelope policy envelope)]
    (cond
      (not (:valid? checked)) checked
      (not= :hybrid-required (:mode policy))
      (invalid "production boundary requires hybrid-required mode"
               {:mode (:mode policy)})
      (< (:envelope/epoch envelope 0) (:hybrid-epoch-floor policy 0))
      (invalid "legacy envelope epoch forbidden at production boundary"
               {:epoch (:envelope/epoch envelope)
                :hybrid-epoch-floor (:hybrid-epoch-floor policy)})
      (not (hybrid-kem-components? (:envelope/algorithms envelope)))
      (invalid "production boundary requires classical plus ML-KEM-768"
               {:algorithms (:envelope/algorithms envelope)})
      :else checked))))

#?(:kotoba
   (defn rotate-envelope [policy :document current :document next-envelope :document] :document
     (let [checked (check-envelope policy next-envelope)]
       (if (not (document-equal? (dgk checked :valid?) (document-bool true)))
         checked
         (if (<= (doc-i64 (dgk next-envelope :envelope/epoch)) (doc-i64 (dgk current :envelope/epoch)))
           (invalid (document-string "envelope epoch must increase")
                    (document-map (document-keyword :current) (dgk current :envelope/epoch)
                                  (document-keyword :next) (dgk next-envelope :envelope/epoch)))
           (document-map (document-keyword :valid?) (document-bool true)
                         (document-keyword :previous-epoch) (dgk current :envelope/epoch)
                         (document-keyword :current-epoch) (dgk next-envelope :envelope/epoch)
                         (document-keyword :algorithms) (dgk next-envelope :envelope/algorithms))))))
   :default
(defn rotate-envelope
  "Require a strictly newer epoch and a complete classical+ML-KEM envelope."
  [policy current next-envelope]
  (let [checked (check-envelope policy next-envelope)]
    (cond
      (not (:valid? checked)) checked
      (<= (:envelope/epoch next-envelope 0) (:envelope/epoch current 0))
      (invalid "envelope epoch must increase"
               {:current (:envelope/epoch current) :next (:envelope/epoch next-envelope)})
      :else {:valid? true :previous-epoch (:envelope/epoch current)
             :current-epoch (:envelope/epoch next-envelope)
             :algorithms (:envelope/algorithms next-envelope)}))))

#?(:kotoba
   (defn inventory-entry-required [] :document
     (document-list (document-keyword :crypto/use) (document-keyword :crypto/current)
                    (document-keyword :crypto/target)))
   :default
(def inventory-entry-required
  [:crypto/use
   :crypto/current
   :crypto/target
   :crypto/pq-status
   :crypto/fips-status]))

#?(:kotoba
   (defn inventory-entry-error [policy :document entry :document] :document
     (let [mk (missing-key entry (inventory-entry-required)
                            (document-string "missing required crypto inventory field"))]
       (if (none? mk)
         (if (not (= (document-kind (dgk entry :crypto/use)) :keyword))
           (invalid (document-string "crypto use keyword required")
                    (document-map (document-keyword :value) (dgk entry :crypto/use)))
           (if (none? (dgk entry :crypto/current))
             (invalid (document-string "crypto current algorithms required")
                      (document-map (document-keyword :use) (dgk entry :crypto/use)))
             (if (none? (dgk entry :crypto/target))
               (invalid (document-string "crypto target algorithms required")
                        (document-map (document-keyword :use) (dgk entry :crypto/use)))
               (if (not (= (document-kind (dgk entry :crypto/pq-status)) :keyword))
                 (invalid (document-string "crypto pq-status keyword required")
                          (document-map (document-keyword :use) (dgk entry :crypto/use)))
                 (if (not (= (document-kind (dgk entry :crypto/fips-status)) :keyword))
                   (invalid (document-string "crypto fips-status keyword required")
                            (document-map (document-keyword :use) (dgk entry :crypto/use)))
                   (if (and (document-equal? (dgk policy :mode) (document-keyword :fips-required))
                            (document-equal? (dgk entry :crypto/fips-status) (document-keyword :not-claimed)))
                     (invalid (document-string "fips status not-claimed forbidden under fips-required")
                              (document-map (document-keyword :use) (dgk entry :crypto/use)))
                     (document-null)))))))
         mk)))
   :default
(defn inventory-entry-error
  [policy entry]
  (or
   (missing-key entry inventory-entry-required
                "missing required crypto inventory field")
   (when-not (keyword? (:crypto/use entry))
     (invalid "crypto use keyword required" {:value (:crypto/use entry)}))
   (when-not (seq (:crypto/current entry))
     (invalid "crypto current algorithms required" {:use (:crypto/use entry)}))
   (when-not (seq (:crypto/target entry))
     (invalid "crypto target algorithms required" {:use (:crypto/use entry)}))
   (when-not (keyword? (:crypto/pq-status entry))
     (invalid "crypto pq-status keyword required" {:use (:crypto/use entry)}))
   (when-not (keyword? (:crypto/fips-status entry))
     (invalid "crypto fips-status keyword required" {:use (:crypto/use entry)}))
   (when (and (= :fips-required (:mode policy))
              (= :not-claimed (:crypto/fips-status entry)))
     (invalid "fips status not-claimed forbidden under fips-required"
              {:use (:crypto/use entry)})))))


;; the first entry error of the register's inventory, or null -- first-truthy unrolled
#?(:kotoba
   (defn- inventory-walk [policy :document inv :document i :i64 n :i64] :document
     (if (>= i n)
       (document-null)
       (let [e (inventory-entry-error policy (option-value-of [:option :document] (document-list-at inv i) (document-null)))]
         (if (none? e) (inventory-walk policy inv (+ i 1) n) e)))))

#?(:kotoba
   (defn inventory-error [policy :document register :document] :document
     (let [pe (policy-error policy)]
       (if (none? pe)
         (if (not (document-equal? (dgk register :register/type) (document-keyword :kotoba.security/crypto-inventory)))
           (invalid (document-string "crypto inventory register type required")
                    (document-map (document-keyword :value) (dgk register :register/type)))
           (if (not (document-equal? (dgk register :register/version) (document-i64 1)))
             (invalid (document-string "crypto inventory register version 1 required")
                      (document-map (document-keyword :value) (dgk register :register/version)))
             (let [inv (dgk register :inventory)]
               (if (none? inv)
                 (invalid (document-string "crypto inventory entries required") (document-map))
                 (inventory-walk policy inv 0 (document-count inv))))))
         pe)))
   :default
(defn inventory-error
  [policy register]
  (or
   (policy-error policy)
   (when-not (= :kotoba.security/crypto-inventory (:register/type register))
     (invalid "crypto inventory register type required"
              {:value (:register/type register)}))
   (when-not (= 1 (:register/version register))
     (invalid "crypto inventory register version 1 required"
              {:value (:register/version register)}))
   (when-not (seq (:inventory register))
     (invalid "crypto inventory entries required" {}))
   (first-truthy (fn [entry] (inventory-entry-error policy entry))
         (:inventory register)))))

#?(:kotoba
   (defn check-inventory [policy :document register :document] :document
     (let [error (inventory-error policy register)]
       (if (none? error) (valid-doc) error)))
   :default
(defn check-inventory
  "Validates a crypto-inventory register against the crypto policy.
  Structure is always enforced; FIPS strictness only under :fips-required.
  Returns {:valid? true} or {:valid? false :message .. :data ..}."
  [policy register]
  (if-let [error (inventory-error policy register)]
    error
    {:valid? true})))
