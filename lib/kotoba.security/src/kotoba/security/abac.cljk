;; ══════════════════════════════════════════════════════════════════════════════════════════════
;; R6QW3: the Kotoba reading (W3: the selfbuild scan refused this module behind its
;; information-flow dependency and then E2119 at evaluate's destructuring signature). The host
;; reading of every form is kept byte-for-byte as :default.
;;
;; Port decisions (oracle semantics preserved):
;; - classification-rank is the 0-argument exported alias of information-flow/ranks (the seed's
;;   export surface names functions only).
;; - values (the coll->set normalization) is folded into two walks: has-item? (the oracle's
;;   (contains? (values allowed) actual) with the non-empty condition) and all-in? (the oracle's
;;   (set/subset? (values actual) (values allowed))). Both treat a scalar as its singleton and
;;   null as empty, matching values exactly. Sets of documents are not annotatable, so no set
;;   value crosses a boundary.
;; - temporal-denial takes the comparison as an :i64 code (0 = not-before / >=, 1 = expired / <=)
;;   instead of the oracle's >= / <= function values.
;; - evaluate's 17 checks keep their order: each conjes its denial onto a [:list :document]
;;   accumulator (typed-list-new/conj), the oracle's (vec (remove nil? [...])); the result map is
;;   document-map. The {:keys [...]} parameter is :document with dgk pulls (the js-value /
;;   hardware / information-flow pattern).
;; ══════════════════════════════════════════════════════════════════════════════════════════════

(ns kotoba.security.abac
  "Portable, fail-closed subject/resource/action/environment policy evaluator.
  Callers normalize repository-specific manifests or requests at their trusted
  boundary and translate the returned control ids into their receipt schema."
  {:kotoba/export [classification-rank evaluate]}
  (:require [kotoba.lang.coll :as set]
            [kotoba.security.information-flow :as flow]))

#?(:kotoba
   (defn- dgk [d :document k :keyword] :document
     (option-value-of [:option :document] (document-get d k) (document-null))))

#?(:kotoba
   (defn- none? [d :document] :bool
     (document-equal? d (document-null))))

;; true when the collection d (a scalar counts as its singleton, null as empty) holds x
#?(:kotoba
   (defn- has-item? [d :document x :document] :bool
     (cond (none? d) false
           (or (= (document-kind d) :list) (= (document-kind d) :vector) (= (document-kind d) :set))
           (items-eq? d x 0 (document-count d))
           :else (document-equal? d x))))

#?(:kotoba
   (defn- items-eq? [d :document x :document i :i64 n :i64] :bool
     (if (>= i n)
       false
       (if (document-equal? (option-value-of [:option :document] (document-list-at d i) (document-null)) x)
         true
         (items-eq? d x (+ i 1) n)))))

;; true when every item of d (a scalar counts as its singleton, null as empty) is in allowed
#?(:kotoba
   (defn- all-in? [d :document allowed :document] :bool
     (cond (none? d) true
           (or (= (document-kind d) :list) (= (document-kind d) :vector) (= (document-kind d) :set))
           (all-in-walk d allowed 0 (document-count d))
           :else (has-item? allowed d))))

#?(:kotoba
   (defn- all-in-walk [d :document allowed :document i :i64 n :i64] :bool
     (if (>= i n)
       true
       (if (has-item? allowed (option-value-of [:option :document] (document-list-at d i) (document-null)))
         (all-in-walk d allowed (+ i 1) n)
         false))))

;; the non-empty condition of an allowlist (the oracle's (seq (values ...)))
#?(:kotoba
   (defn- items-n [d :document] :i64
     (cond (none? d) 0
           (or (= (document-kind d) :list) (= (document-kind d) :vector) (= (document-kind d) :set))
           (document-count d)
           :else 1)))

#?(:kotoba
   (defn classification-rank [] [:map :keyword :i64]
     (flow/ranks))
   :default
(def classification-rank
  "Alias of the one classification lattice, `kotoba.security.information-flow/ranks`.

  This namespace decides no-read-up (subject clearance vs resource
  classification); `information-flow` decides no-write-down (egress and
  declassification). Both must rank the same labels identically, so the ranks
  live in exactly one place. Kept as a var because it is part of this
  namespace's public surface."
  flow/ranks))

#?(:kotoba
   (defn- denied [control :keyword message :string] :document
     (document-map (document-keyword :abac/control) (document-keyword control)
                   (document-keyword :abac/message) (document-string message)))
   :default
(defn- denied [control message]
  {:abac/control control :abac/message message}))

#?(:kotoba
   (defn- allowlist-denial [policy-key :keyword actual :document control :keyword message :string policy :document] :document
     (let [allowed (dgk policy policy-key)]
       (if (and (> (items-n allowed) 0) (not (has-item? allowed actual)))
         (denied control message)
         (document-null))))
   :default
(defn- allowlist-denial [policy-key actual control message policy]
  (let [allowed (values (get policy policy-key))]
    (when (and (seq allowed) (not (contains? allowed actual)))
      (denied control message)))))

#?(:kotoba
   (defn- subset-denial [policy-key :keyword actual :document control :keyword message :string policy :document] :document
     (if (and (not (none? (dgk policy policy-key)))
              (not (all-in? actual (dgk policy policy-key))))
       (denied control message)
       (document-null)))
   :default
(defn- subset-denial [policy-key actual control message policy]
  (when (and (contains? policy policy-key)
             (not (set/subset? (values actual) (values (get policy policy-key)))))
    (denied control message))))

;; the oracle's temporal-denial with the comparison as a code: 0 = not-before (>=), 1 = expired (<=)
#?(:kotoba
   (defn- temporal-denial [control :keyword now :document boundary :document code :i64] :document
     (if (and (not (none? boundary))
              (or (not (= (document-kind now) :string)) (not (= (document-kind boundary) :string))
                  (if (= code 0)
                    (< (string-compare (option-value-of [:option :string] (document-string-value now) "")
                                       (option-value-of [:option :string] (document-string-value boundary) "")) 0)
                    (> (string-compare (option-value-of [:option :string] (document-string-value now) "")
                                       (option-value-of [:option :string] (document-string-value boundary) "")) 0))))
       (denied control "trusted time is missing or outside policy validity")
       (document-null)))
   :default
(defn- temporal-denial [control now boundary pred]
  (when (and boundary
             (or (not (string? now)) (not (string? boundary))
                 (not (pred (compare now boundary) 0))))
    (denied control "trusted time is missing or outside policy validity"))))

;; one check of the violations EDN text: append the denial's spelling when the condition holds
;; (the gas / information-flow pattern -- the conj order of the oracle's (vec (remove nil? ...)))
#?(:kotoba
   (defn- chkt [t :string bad :bool item :string] :string
     (if bad (string-concat t item) t)))

#?(:kotoba
   (defn evaluate [m :document policy :document] :document
     (let [policy (if (none? policy) (document-map) policy)
           subject (dgk m :subject)
           resource (dgk m :resource)
           action (dgk m :action)
           environment (dgk m :environment)
           purpose (dgk m :purpose)
           disclosure-bytes (dgk m :disclosure-bytes)
           required-rank (option-value-of [:option :i64] (typed-map-get [:map :keyword :i64] (classification-rank) (option-value-of [:option :keyword] (document-keyword-value (dgk resource :classification)) :none)) -1)
           clearance-rank (option-value-of [:option :i64] (typed-map-get [:map :keyword :i64] (classification-rank) (option-value-of [:option :keyword] (document-keyword-value (dgk subject :clearance)) :none)) -1)]
       (let [t6 (chkt (chkt (chkt (chkt (chkt (chkt ""
                                                    (and (> (items-n (dgk policy :subject/ids)) 0) (not (has-item? (dgk policy :subject/ids) (dgk subject :id))))
                                                    " {:abac/control :subject-id :abac/message \"subject identity is not allowed\"}")
                                               (and (> (items-n (dgk policy :subject/signers)) 0) (not (has-item? (dgk policy :subject/signers) (dgk subject :signer))))
                                               " {:abac/control :subject-signer :abac/message \"subject signer is not allowed\"}")
                                          (and (> (items-n (dgk policy :subject/roles)) 0) (not (has-item? (dgk policy :subject/roles) (dgk subject :role))))
                                          " {:abac/control :subject-role :abac/message \"subject role is not allowed\"}")
                                     (and (> (items-n (dgk policy :resource/ids)) 0) (not (has-item? (dgk policy :resource/ids) (dgk resource :id))))
                                     " {:abac/control :resource-id :abac/message \"resource identity is not allowed\"}")
                                (and (> (items-n (dgk policy :resource/tenants)) 0) (not (has-item? (dgk policy :resource/tenants) (dgk resource :tenant))))
                                " {:abac/control :resource-tenant :abac/message \"resource tenant is not allowed\"}")
                           (and (> (items-n (dgk policy :resource/trust)) 0) (not (has-item? (dgk policy :resource/trust) (dgk resource :trust))))
                           " {:abac/control :resource-trust :abac/message \"resource trust class is not allowed\"}")]
         (let [t12 (chkt (chkt (chkt (chkt (chkt (chkt t6
                                                       (and (not (none? (dgk policy :resource/effects))) (not (all-in? (dgk resource :effects) (dgk policy :resource/effects))))
                                                       " {:abac/control :resource-effects :abac/message \"resource effects exceed policy\"}")
                                                  (and (> (items-n (dgk policy :action/ids)) 0) (not (has-item? (dgk policy :action/ids) (dgk action :id))))
                                                  " {:abac/control :action-id :abac/message \"action is not allowed\"}")
                                             (and (not (none? (dgk policy :action/capabilities))) (not (all-in? (dgk action :capabilities) (dgk policy :action/capabilities))))
                                             " {:abac/control :action-capabilities :abac/message \"action capabilities exceed policy\"}")
                                        (and (> (items-n (dgk policy :environment/surfaces)) 0) (not (has-item? (dgk policy :environment/surfaces) (dgk environment :surface))))
                                        " {:abac/control :environment-surface :abac/message \"execution surface is not allowed\"}")
                                   (and (> (items-n (dgk policy :environment/network-zones)) 0) (not (has-item? (dgk policy :environment/network-zones) (dgk environment :network-zone))))
                                   " {:abac/control :environment-network-zone :abac/message \"network zone is not allowed\"}")
                              (and (document-equal? (dgk policy :environment/require-device-trust?) (document-bool true))
                                   (not (document-equal? (dgk environment :device-trusted?) (document-bool true))))
                              " {:abac/control :environment-device :abac/message \"trusted device is required\"}")]
           (let [t16 (chkt (chkt (chkt (chkt t12
                                             (and (> (items-n (dgk policy :purpose/allowed)) 0) (not (has-item? (dgk policy :purpose/allowed) purpose)))
                                             " {:abac/control :purpose :abac/message \"purpose is not allowed\"}")
                                        (and (document-equal? (dgk policy :tenant/isolation?) (document-bool true))
                                             (or (none? (dgk subject :tenant)) (none? (dgk resource :tenant))
                                                 (not (document-equal? (dgk subject :tenant) (dgk resource :tenant)))))
                                        " {:abac/control :tenant-isolation :abac/message \"subject and resource tenant differ\"}")
                                   (and (> required-rank -1)
                                        (or (< clearance-rank 0) (< clearance-rank required-rank)))
                                   " {:abac/control :classification :abac/message \"subject clearance is below resource classification\"}")
                              (not (none? (temporal-denial :not-before (dgk environment :now) (dgk policy :valid/not-before) 0)))
                              " {:abac/control :not-before :abac/message \"trusted time is missing or outside policy validity\"}")]
             (let [t17 (chkt (chkt t16
                                   (not (none? (temporal-denial :expired (dgk environment :now) (dgk policy :valid/expires-at) 1)))
                                   " {:abac/control :expired :abac/message \"trusted time is missing or outside policy validity\"}")
                              (and (not (none? (dgk policy :disclosure/max-bytes)))
                                   (or (not (= (document-kind disclosure-bytes) :i64))
                                       (> (option-value-of [:option :i64] (document-i64-value disclosure-bytes) -1)
                                          (option-value-of [:option :i64] (document-i64-value (dgk policy :disclosure/max-bytes)) -1))))
                              " {:abac/control :disclosure-size :abac/message \"disclosure exceeds policy bound\"}")
                   viol (document-edn-read (str "[" t17 "]"))]
               (document-map (document-keyword :abac/allowed?) (document-bool (document-equal? viol (document-list)))
                             (document-keyword :abac/policy-id) (dgk policy :policy/id)
                             (document-keyword :abac/violations) viol
                             (document-keyword :abac/attributes)
                             (document-map (document-keyword :subject) subject
                                           (document-keyword :resource) resource
                                           (document-keyword :action) action
                                           (document-keyword :environment) environment
                                           (document-keyword :purpose) purpose
                                           (document-keyword :disclosure-bytes) disclosure-bytes))))))))
   :default
(defn evaluate
  "Return `{:abac/allowed? boolean :abac/policy-id ... :abac/violations [...]}`.

  Attributes are normalized maps under :subject, :resource, :action and
  :environment. A policy condition is optional, but once declared a missing
  attribute denies. This lets language/runtime repositories share semantics
  without sharing their manifest schemas."
  [{:keys [subject resource action environment purpose disclosure-bytes]} policy]
  (let [policy (or policy {})
        required-rank (get classification-rank (:classification resource))
        clearance-rank (get classification-rank (:clearance subject))
        violations
        (vec
         (remove
          nil?
          [(allowlist-denial :subject/ids (:id subject) :subject-id
                             "subject identity is not allowed" policy)
           (allowlist-denial :subject/signers (:signer subject) :subject-signer
                             "subject signer is not allowed" policy)
           (allowlist-denial :subject/roles (:role subject) :subject-role
                             "subject role is not allowed" policy)
           (allowlist-denial :resource/ids (:id resource) :resource-id
                             "resource identity is not allowed" policy)
           (allowlist-denial :resource/tenants (:tenant resource) :resource-tenant
                             "resource tenant is not allowed" policy)
           (allowlist-denial :resource/trust (:trust resource) :resource-trust
                             "resource trust class is not allowed" policy)
           (subset-denial :resource/effects (:effects resource) :resource-effects
                          "resource effects exceed policy" policy)
           (allowlist-denial :action/ids (:id action) :action-id
                             "action is not allowed" policy)
           (subset-denial :action/capabilities (:capabilities action) :action-capabilities
                          "action capabilities exceed policy" policy)
           (allowlist-denial :environment/surfaces (:surface environment)
                             :environment-surface "execution surface is not allowed" policy)
           (allowlist-denial :environment/network-zones (:network-zone environment)
                             :environment-network-zone "network zone is not allowed" policy)
           (when (and (:environment/require-device-trust? policy)
                      (not= true (:device-trusted? environment)))
             (denied :environment-device "trusted device is required"))
           (allowlist-denial :purpose/allowed purpose :purpose
                             "purpose is not allowed" policy)
           (when (and (:tenant/isolation? policy)
                      (or (nil? (:tenant subject)) (nil? (:tenant resource))
                          (not= (:tenant subject) (:tenant resource))))
             (denied :tenant-isolation "subject and resource tenant differ"))
           (when (and required-rank
                      (or (nil? clearance-rank) (< clearance-rank required-rank)))
             (denied :classification "subject clearance is below resource classification"))
           (temporal-denial :not-before (:now environment) (:valid/not-before policy) >=)
           (temporal-denial :expired (:now environment) (:valid/expires-at policy) <=)
           (when (and (:disclosure/max-bytes policy)
                      (or (not (nat-int? disclosure-bytes))
                          (> disclosure-bytes (:disclosure/max-bytes policy))))
             (denied :disclosure-size "disclosure exceeds policy bound"))]))]
    {:abac/allowed? (empty? violations)
     :abac/policy-id (:policy/id policy)
     :abac/violations violations
     :abac/attributes {:subject subject :resource resource :action action
                       :environment environment :purpose purpose
                       :disclosure-bytes disclosure-bytes}})))
