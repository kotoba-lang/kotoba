;; ══════════════════════════════════════════════════════════════════════════════════════════════
;; R6QW3: the Kotoba reading (W3: the selfbuild scan refused this module E1005 at a '#' fn
;; literal -- the seed's R6D now reads those -- then E2119 at evaluate-egress's destructuring
;; signature). The host reading of every form is kept byte-for-byte as :default.
;;
;; Port decisions (oracle semantics preserved):
;; - The exported value defs (ranks / canonical-by-rank) are 0-argument exported functions in the
;;   Kotoba reading (the seed's export surface names functions only); ranks answers a
;;   [:map :keyword :i64] typed map (built with typed-map-new), canonical-by-rank a :document key
;;   list in order (vector types are not annotatable).
;; - canonical answers a :document keyword, (document-null) for the oracle's nil.
;; - join computes the maximum rank over the canonicalized labels (unknown becomes :restricted)
;;   and answers the canonical spelling of that rank: the same answer as the oracle's
;;   (apply max-key ranks) because one canonical spelling exists per rank.
;; - evaluate-egress's {:keys [...]} parameter is :document with dgk pulls (the js-value /
;;   hardware pattern); the violations vector (0 or 1 maps) is a document-list.
;; ══════════════════════════════════════════════════════════════════════════════════════════════

(ns kotoba.security.information-flow
  "Portable lattice and fail-closed egress/declassification decisions.

  ## Two spellings of rank 2

  `kotobase.classification` names its four classes
  `[:public :internal :personal :restricted]` — `:personal` where this
  lattice said `:confidential`, at the same position, for the same thing.
  The two vocabularies never met, so nothing broke: an attribute kotobase
  classified `:personal` reached `join` as an unknown label and was coerced
  to `:restricted`. Fail-closed, and therefore invisible — the composition
  was never wrong, it was never possible.

  `:personal` is accepted here as a spelling of rank 2. `canonical`
  normalises it, and `join` returns canonical labels only, because a
  declassification grant is matched by `(= source (:from grant))` — a join
  that answered `:personal` sometimes and `:confidential` others would make
  a correct grant fail to match half the time."
  {:kotoba/export [canonical canonical-by-rank evaluate-egress join ranks unknown-labels]})

#?(:kotoba
   (defn- dgk [d :document k :keyword] :document
     (option-value-of [:option :document] (document-get d k) (document-null))))

#?(:kotoba
   (defn- none? [d :document] :bool
     (document-equal? d (document-null))))

#?(:kotoba
   (defn ranks [] [:map :keyword :i64]
     (typed-map-new [:map :keyword :i64]
                    :public 0
                    :internal 1
                    :confidential 2
                    :personal 2
                    :restricted 3))
   :default
(def ranks
  "Classification → rank. Two keys share rank 2 on purpose (see the ns
  docstring); `canonical` picks the one spelling anything downstream sees."
  {:public 0 :internal 1 :confidential 2 :personal 2 :restricted 3}))

#?(:kotoba
   (defn canonical-by-rank [] :document
     (document-list (document-keyword :public) (document-keyword :internal)
                    (document-keyword :confidential) (document-keyword :restricted)))
   :default
(def canonical-by-rank
  "The one spelling per rank, lowest first."
  [:public :internal :confidential :restricted]))

;; the label's rank, -1 when this lattice does not rank it (the oracle's (get ranks label))
#?(:kotoba
   (defn- label-rank [label :document] :i64
     (let [k (option-value-of [:option :keyword] (document-keyword-value label) :none)]
       (if (= k :none)
         -1
         (option-value-of [:option :i64] (typed-map-get [:map :keyword :i64] (ranks) k) -1)))))

;; the canonical spelling of rank r as a document keyword
#?(:kotoba
   (defn- rank-label [r :i64] :document
     (option-value-of [:option :document] (document-list-at (canonical-by-rank) r) (document-null))))

#?(:kotoba
   (defn canonical [label :document] :document
     (let [r (label-rank label)]
       (if (< r 0) (document-null) (rank-label r))))
   :default
(defn canonical
  "LABEL's canonical spelling, or nil when this lattice does not rank it.

  nil rather than a coerced `:restricted`, so a caller can tell `I do not
  know this label` from `this label is restricted`. `join` still coerces —
  that is the safe reading — but the coercion is no longer the only thing
  that can be observed about it (see `unknown-labels`)."
  [label]
  (when-let [r (get ranks label)] (nth canonical-by-rank r))))

;; the set of the labels the lattice cannot rank (the oracle's (into #{} (remove ...) labels))
#?(:kotoba
   (defn- unknown-walk [labels :document i :i64 n :i64 acc [:set :keyword]] [:set :keyword]
     (if (>= i n)
       acc
       (let [x (option-value-of [:option :document] (document-list-at labels i) (document-null))]
         (if (< (label-rank x) 0)
           (unknown-walk labels (+ i 1) n
                         (typed-set-conj [:set :keyword] acc
                                         (option-value-of [:option :keyword] (document-keyword-value x) :none)))
           (unknown-walk labels (+ i 1) n acc))))))

#?(:kotoba
   (defn unknown-labels [labels :document] [:set :keyword]
     (unknown-walk labels 0 (document-count labels) (typed-set-new [:set :keyword])))
   :default
(defn unknown-labels
  "The labels this lattice cannot rank.

  `join` treats these as `:restricted`, which is safe and silent. A silent
  safe answer accumulates: `:personal` was over-classified by exactly this
  path for as long as both vocabularies existed, and nothing reported it.
  Callers that care whether they were understood ask here."
  [labels]
  (into #{} (remove #(contains? ranks %)) labels)))

;; the highest rank of the canonicalized labels (unknown becomes :restricted); ties cannot differ
;; in the answer because one canonical spelling exists per rank
#?(:kotoba
   (defn- join-rank [labels :document i :i64 n :i64 best :i64] :i64
     (if (>= i n)
       best
       (let [x (option-value-of [:option :document] (document-list-at labels i) (document-null))
             r (label-rank x)
             r2 (if (< r 0) 3 r)]
         (join-rank labels (+ i 1) n (if (> r2 best) r2 best))))))

#?(:kotoba
   (defn join [labels :document] :document
     (rank-label (join-rank labels 0 (document-count labels) 0)))
   :default
(defn join
  "The output of a computation inherits the highest input classification.
  Unknown or missing labels conservatively become :restricted. The result is
  always canonical, so it can be compared with a grant's `:from`."
  [labels]
  (->> labels
       (map #(or (canonical %) :restricted))
       (apply max-key ranks :public))))

#?(:kotoba
   (defn evaluate-egress [m :document] :document
     (let [subject (dgk m :subject)
           purpose (dgk m :purpose)
           now (dgk m :now)
           input-classifications (dgk m :input-classifications)
           output-classification (dgk m :output-classification)
           grant (dgk m :declassification-grant)
           source (join input-classifications)
           target (let [c (canonical output-classification)] (if (none? c) (document-keyword :restricted) c))
           s-rank (label-rank source)
           t-rank (label-rank target)]
       (let [downgrade? (< t-rank s-rank)
             valid-grant? (and (not (none? grant))
                               (document-equal? subject (dgk grant :subject))
                               (document-equal? purpose (dgk grant :purpose))
                               (document-equal? source (dgk grant :from))
                               (document-equal? target (dgk grant :to))
                               (= (document-kind now) :string)
                               (= (document-kind (dgk grant :expires-at)) :string)
                               (<= (string-compare (option-value-of [:option :string] (document-string-value now) "") (option-value-of [:option :string] (document-string-value (dgk grant :expires-at)) "")) 0))
             viol (if (and downgrade? (not valid-grant?))
                    (document-list
                     (document-map (document-keyword :information-flow/control) (document-keyword :declassification-required)
                                   (document-keyword :information-flow/message)
                                   (document-string "classification downgrade requires an exact valid grant")))
                    (document-list))]
         (document-map (document-keyword :information-flow/allowed?) (document-bool (document-equal? viol (document-list)))
                       (document-keyword :information-flow/source) source
                       (document-keyword :information-flow/target) target
                       (document-keyword :information-flow/downgrade?) (document-bool downgrade?)
                       (document-keyword :information-flow/grant-id) (dgk grant :id)
                       (document-keyword :information-flow/violations) viol))))
   :default
(defn evaluate-egress
  "Allow monotonic flows. A downgrade requires an exact, unexpired grant bound
  to subject, purpose, source and target classifications."
  [{:keys [subject purpose now input-classifications output-classification
           declassification-grant]}]
  (let [source (join input-classifications)
        target (or (canonical output-classification) :restricted)
        downgrade? (< (ranks target) (ranks source))
        grant declassification-grant
        valid-grant? (and grant
                          (= subject (:subject grant))
                          (= purpose (:purpose grant))
                          (= source (:from grant))
                          (= target (:to grant))
                          (string? now)
                          (string? (:expires-at grant))
                          (<= (compare now (:expires-at grant)) 0))
        violations (cond-> []
                     (and downgrade? (not valid-grant?))
                     (conj {:information-flow/control :declassification-required
                            :information-flow/message
                            "classification downgrade requires an exact valid grant"}))]
    {:information-flow/allowed? (empty? violations)
     :information-flow/source source
     :information-flow/target target
     :information-flow/downgrade? downgrade?
     :information-flow/grant-id (:id grant)
     :information-flow/violations violations})))
