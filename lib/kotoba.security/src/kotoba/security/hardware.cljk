(ns kotoba.security.hardware
  "Fail-closed HSM/native-keystore qualification evidence checks."
  {:kotoba/export [evaluate evaluate-signing]})

;; -- Kotoba reading (W3: JUN-202 selfbuild scan refused this module E2119
;; "malformed signature of 'evaluate'", the `{:keys [...]}` destructured map
;; parameter). The host reading below is kept byte-for-byte as :default.
;;
;; Port decisions (oracle semantics preserved exactly):
;; - Input is one :document (the evidence map) -- the oracle's absent-able map
;;   fields keep their absence semantics: every field is read as an option with
;;   a (document-null) default, so absent, explicit null, and wrong-typed values
;;   all fail the exact-value checks exactly where the oracle's `not= true` /
;;   `not= false` / `nil?` failed them.
;; - `(nil? provider-id)` <-> the field's document equals (document-null)
;;   (absent or null); the output map carries the raw field document in
;;   :hardware/provider-id, null when absent, as the oracle carries nil.
;; - :hardware/violations is the violation keywords in the oracle's cond->
;;   order. There is no admitted list-conj in the seed surface, so the vector is
;;   spelled as its EDN text and read back with document-edn-read -- same value.
;; - `evaluate-signing`'s :hardware-signing/non-claims is the same 4-keyword set.
;; Measured (seed r6n b3f46d32, `compile --emit-module`): the :document
;; parameter/result signature and every construct used here are admitted; the
;; selfbuild scan (seed OK) is recorded on Linear AWAI-77.

#?(:kotoba
   (defn- ev-eq?
     "true when the field's document (absent -> null) equals v."
     [ev :document k :keyword v :document] :bool
     (document-equal? (option-value-of [:option :document] (document-get ev k) (document-null)) v)))

#?(:kotoba
   (defn evaluate [ev :document] :document
     (let [p-nil (ev-eq? ev :provider-id (document-null))
           hw (not (ev-eq? ev :hardware-backed? (document-bool true)))
           at (not (ev-eq? ev :attestation-verified? (document-bool true)))
           px (not (ev-eq? ev :private-exported? (document-bool false)))
           sg (not (ev-eq? ev :sign-verified? (document-bool true)))
           km (not (ev-eq? ev :kem-verified? (document-bool true)))
           rd (not (ev-eq? ev :rotation-drill-passed? (document-bool true)))
           oc (not (ev-eq? ev :outage-failed-closed? (document-bool true)))]
       (document-map
        (document-keyword :hardware/qualified?)
        (document-bool (and (not p-nil) (not hw) (not at) (not px)
                            (not sg) (not km) (not rd) (not oc)))
        (document-keyword :hardware/provider-id)
        (option-value-of [:option :document] (document-get ev :provider-id) (document-null))
        (document-keyword :hardware/violations)
        (document-edn-read
         (str "["
              (if p-nil " :provider-id" "")
              (if hw " :hardware-backed" "")
              (if at " :attestation" "")
              (if px " :private-export" "")
              (if sg " :sign-operation" "")
              (if km " :kem-operation" "")
              (if rd " :rotation-drill" "")
              (if oc " :outage-fail-closed" "")
              "]")))))
   :default
(defn evaluate
  [{:keys [provider-id hardware-backed? attestation-verified?
           private-exported? sign-verified? kem-verified?
           rotation-drill-passed? outage-failed-closed?]}]
  (let [violations
        (cond-> []
          (nil? provider-id) (conj :provider-id)
          (not= true hardware-backed?) (conj :hardware-backed)
          (not= true attestation-verified?) (conj :attestation)
          (not= false private-exported?) (conj :private-export)
          (not= true sign-verified?) (conj :sign-operation)
          (not= true kem-verified?) (conj :kem-operation)
          (not= true rotation-drill-passed?) (conj :rotation-drill)
          (not= true outage-failed-closed?) (conj :outage-fail-closed))]
    {:hardware/qualified? (empty? violations)
     :hardware/provider-id provider-id
     :hardware/violations violations})))

#?(:kotoba
   (defn evaluate-signing [ev :document] :document
     (let [p-nil (ev-eq? ev :provider-id (document-null))
           hw (not (ev-eq? ev :hardware-backed? (document-bool true)))
           po (not (ev-eq? ev :provider-origin-verified? (document-bool true)))
           px (not (ev-eq? ev :private-exported? (document-bool false)))
           sg (not (ev-eq? ev :sign-verified? (document-bool true)))
           uf (not (ev-eq? ev :unavailable-failed-closed? (document-bool true)))]
       (document-map
        (document-keyword :hardware-signing/qualified?)
        (document-bool (and (not p-nil) (not hw) (not po) (not px) (not sg) (not uf)))
        (document-keyword :hardware-signing/provider-id)
        (option-value-of [:option :document] (document-get ev :provider-id) (document-null))
        (document-keyword :hardware-signing/scope)
        (document-keyword :non-exportable-signing)
        (document-keyword :hardware-signing/violations)
        (document-edn-read
         (str "["
              (if p-nil " :provider-id" "")
              (if hw " :hardware-backed" "")
              (if po " :provider-origin" "")
              (if px " :private-export" "")
              (if sg " :sign-operation" "")
              (if uf " :availability-fail-closed" "")
              "]"))
        (document-keyword :hardware-signing/non-claims)
        (document-set (document-keyword :kem) (document-keyword :pkcs11)
                      (document-keyword :cluster-ha) (document-keyword :vendor-attestation)))))
   :default
(defn evaluate-signing
  "Scoped hardware signing qualification; never claims KEM or general HSM."
  [{:keys [provider-id hardware-backed? provider-origin-verified?
           private-exported? sign-verified? unavailable-failed-closed?]}]
  (let [violations
        (cond-> []
          (nil? provider-id) (conj :provider-id)
          (not= true hardware-backed?) (conj :hardware-backed)
          (not= true provider-origin-verified?) (conj :provider-origin)
          (not= false private-exported?) (conj :private-export)
          (not= true sign-verified?) (conj :sign-operation)
          (not= true unavailable-failed-closed?) (conj :availability-fail-closed))]
    {:hardware-signing/qualified? (empty? violations)
     :hardware-signing/provider-id provider-id
     :hardware-signing/scope :non-exportable-signing
     :hardware-signing/violations violations
     :hardware-signing/non-claims #{:kem :pkcs11 :cluster-ha
                                    :vendor-attestation}})))
