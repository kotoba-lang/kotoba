{:register/type :kotoba.security/control-crosswalk
 :register/version 1
 :crosswalk/as-of "2026-08-26"

 ;; ── なぜこの register が要るのか ──────────────────────────────────────────
 ;;
 ;; この repo は NIST CSF 2.0 と SP 800-53 Rev.5 へのマッピングを持っていたが、
 ;; **SOC 2 Trust Services Criteria と ISO/IEC 27001 への対応表を 1 件も持って
 ;; いなかった**（2026-08-23 の grep で 0 件）。そのため「SOC 2 を取れるか」に
 ;; 対して、この repo が既に持っている厚い設計証拠を使って答えることが
 ;; できなかった。ADR-2608231500。
 ;;
 ;; ── 規格本文を複製しない ────────────────────────────────────────────────
 ;;
 ;; AICPA TSC も ISO/IEC 27001 も著作物である。ここが持つのは
 ;;
 ;;   (a) 条項番号（CC6.1 / A.8.5 —— これは事実であり著作物ではない）
 ;;   (b) **私たち自身の言葉による記述子**（規格本文の引用ではない）
 ;;   (c) この repo の evidence-index の claim への写像
 ;;
 ;; だけで、規格の要求事項本文は 1 文も含まない。監査に臨むときは購入した
 ;; 規格原本を正本とし、この表は「私たちの証拠がどこに当たるか」の索引として
 ;; 使う。`:control/descriptor` を規格の要求事項として引用しないこと。
 ;;
 ;; ── design と operating を混ぜない ──────────────────────────────────────
 ;;
 ;; SOC 2 Type I は「ある時点の統制の設計の適正性」、Type II は「一定期間の
 ;; 運用の有効性」に対する意見である。ISO/IEC 27001 の Stage 1 と Stage 2 も
 ;; ほぼ同じ切り方をする。したがって claim には強さの階層があり、
 ;; `:design` の claim を何本積んでも Type II の証拠にはならない。
 ;;
 ;;   :design         設計された・定義された・記録された（-designed / -defined）
 ;;   :implementation 実装され検査で強制されている（-enforced / -executable）
 ;;   :operating      本番で一定期間運用された receipt がある
 ;;
 ;; 2026-08-23 時点で `:operating` の claim は **0 本**である。
 ;; `registers/remaining-operational-gaps.edn` の
 ;; `:operational/readiness :not-qualified` と整合する。

 :crosswalk/claim-strength
 {;; -designed / -defined / -recorded / -seeded は設計まで
  :governance-designed :design
  :ir-designed :design
  :monitoring-designed :design
  :key-lifecycle-designed :design
  :sbom-slsa-designed :design
  :operational-evidence-designed :design
  :fips-non-claim-defined :design
  :architecture-review-recorded :design
  :risk-register-seeded :design
  :kagi-custody-documented :design
  :on-call-runbook :design
  :capability-values-contract :design
  :monitoring-alert-schema :design

  ;; 例・stub・fixture は「動くことを示した」であって「運用した」ではない。
  ;; 名前に -example / -stub / -fixture / -sample / -local が付くものは
  ;; ここで頭打ちにする。これを :implementation に上げない。
  :on-call-roster-example :design
  :monitoring-heartbeat-stub :design
  :pager-local-fixture :design
  :technical-alert-sample :design
  :ir-tabletop-compromised-signer :design

  ;; 実装され、検査が強制している
  :package-admission-gate-enforced :implementation
  :release-evidence-gate-executable :implementation
  :hybrid-admit-ci-gate :implementation
  :crypto-policy-modes-enforceable :implementation
  :crypto-inventory-checked :implementation
  :grant-policy-intersection-pure :implementation
  :capability-intersection-at-host-call-time :implementation
  :capability-receipt-shape :implementation
  :host-call-receipts-in-audit-trail :implementation
  :host-denial-telemetry-aggregate :implementation
  :package-signing-rotation-pure :implementation
  :package-verification :implementation
  :package-verification-receipt-emitted :implementation
  :revoked-signer-denied :implementation
  :envelope-provider-metadata-emitted :implementation
  :hybrid-kem-vectors-real :implementation
  :hybrid-required-object-encryption-consumer :implementation
  :key-lifecycle-rotation-drill :implementation
  :key-status-snapshot :implementation
  :production-public-keys-registered :implementation
  :metric-collect-file-backed :implementation
  :vendor-webhook-adapters :implementation
  :conformance-results :implementation
  :provenance :implementation
  :sbom :implementation
  :risk-review :implementation}

 ;; ⚠ `:pager-wiring` をここに書かないこと。あれは `:evidence/type` であって
 ;; `:evidence/claim` ではない（初版で取り違え、crosswalk_test の
 ;; every-required-claim-exists-in-the-evidence-vocabulary が捕まえた）。
 ;; pager の claim は `:pager-local-fixture`。

 :crosswalk/frameworks
 {:soc2-tsc-2017
  {:label "SOC 2 / AICPA Trust Services Criteria (2017, 2022 revised points of focus)"
   :encoded :common-criteria-only
   :encoded/why "Security（共通規準 CC1〜CC9）だけを符号化した。Availability /
                 Confidentiality / Processing Integrity / Privacy の追加規準は、
                 どのカテゴリを報告書に含めるかが未決なので符号化しない。
                 **未符号化は『該当なし』ではない。**"
   :criteria-encoded 33
   :attestation/type-i :design-suitability
   :attestation/type-ii :operating-effectiveness-over-a-period
   :issued-by "licensed CPA firm"}

  :iso-27001-2022
  {:label "ISO/IEC 27001:2022 + Annex A"
   :encoded :partial-annex-a
   :encoded/why "Annex A は 93 管理策（組織 37 / 人 8 / 物理 14 / 技術 34）。
                 ここに符号化したのは **この repo の証拠が実際に当たる管理策だけ**
                 で、残りは未写像として数える。93 件すべてに記述子を書けば
                 内容の裏付けが無いまま表が埋まり、`:not-yet-mapped` と
                 `:no-evidence` の区別が消える。"
   :annex-a/total 93
   :annex-a/themes {:organizational 37 :people 8 :physical 14 :technological 34}
   :certified-by "accredited certification body (Stage 1 / Stage 2)"}

  :csa-ccm-v4
  {:label "CSA Cloud Controls Matrix v4 / CAIQ"
   :encoded :not-encoded
   :encoded/why "STAR Level 1 は自己申告なので第三者審査を要しないが、CAIQ の
                 197 問に答えるには system description が先に要る。
                 scope 確定（ADR-2608231500）の後に符号化する。"}

  :ismap
  {:label "ISMAP 政府情報システムのためのセキュリティ評価制度"
   :encoded :not-encoded
   :encoded/why "管理基準は ISO/IEC 27001 / 27017 に日本政府固有の要求を重ねた
                 もので、監査機関による監査が要る。`90-docs/regulatory/permits.datoms.edn`
                 に **ガバメントクラウド申請の前提条件** として既に登録済みだが、
                 自社取得の対象としては未着手。政府調達を狙う判断が先。"}}

