(ns kotoba.wasm.dom
  "Kotoba project-link facade for the hosted DOM adapter.

   Keep the public boundary aligned with dom.cljk. The implementation lives
   in dom-core so Amu sees only Kotoba definitions and the same typed document
   representation used by native guests."
  {:kotoba/export [append-child consume-ops create-element create-text-node
                   empty-document set-attribute set-root set-style tree]}
  (:require [kotoba.wasm.dom-core :as core]))

(defn empty-document [] :document
  (core/empty-document))

(defn consume-ops [document :document] :document
  (core/consume-ops document))

(defn create-element [document :document tag :keyword] :document
  (core/create-element document tag))

(defn create-text-node [document :document text :string] :document
  (core/create-text-node document text))

(defn set-root [document :document node-id :i64] :document
  (core/set-root document node-id))

(defn set-attribute [document :document node-id :i64 key :keyword
                     value :document] :document
  (core/set-attribute document node-id key value))

(defn set-style [document :document node-id :i64 style :document] :document
  (core/set-style document node-id style))

(defn append-child [document :document parent-id :i64 child-id :i64]
  :document
  (core/append-child document parent-id child-id))

(defn tree [document :document] :document
  (core/tree document))
