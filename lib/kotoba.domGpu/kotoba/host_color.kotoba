(ns host-color
  ;; A `.kotoba` port of the HEX-COLOR core of `kotoba.wasm.host.color`
  ;; (dom-gpu src/kotoba/wasm/host/color.cljk), ADR form A: pure functions,
  ;; no capabilities, JVM-free amu admission. This is the pure decision core
  ;; of CSS hex notation (`#rgb`, `#rrggbb`, `#rgba`, `#rrggbbaa`) exactly
  ;; as the host parser defines it:
  ;;   - shorthand digits are DOUBLED (`f` in `#f00` means `ff`, value*17)
  ;;   - lengths 3/4/6/8 only; any other length is invalid
  ;;   - invalid input is a deliberate, documented `:ok false` verdict
  ;;     (the host paints fully transparent), not a crash and not a guess.
  ;;
  ;; OUT OF SCOPE for this first facade step (kept for later ticks): the
  ;; 148 named-color keywords, `rgb()`/`rgba()`/`hsl()`/`hsla()` functional
  ;; notation, and the alpha contract's multiply with cascaded CSS opacity
  ;; (the host multiplies the two alphas; this core returns the color's OWN
  ;; alpha byte 0..255, 255 = fully opaque).
  ;;
  ;; NO REGEX: the cljk's `re-matches #"[0-9a-f]+"` is a hand-written
  ;; code-point scan. Every scanned char is single-byte ASCII ('0'..'9'
  ;; 48..57, 'a'..'f' 97..102, '#' 35), so string-code-point-at /
  ;; string-substring can never trap on a split UTF-8 code point.
  ;;
  ;; parity: color.cljk's parse-hex/hex-nibble-byte/hex-pair-byte semantics,
  ;; checked in `main` against the fixtures #f00/#ff0000/#ff000080/#12345
  ;; plus the reject cases (bad digit, bad length, non-hex value).
  ;;
  ;; Channels are returned as BYTES 0..255 (:i64), not the cljk's 0..1
  ;; floats: the pure profile has no float division, and byte channels are
  ;; lossless (the host's `unit` is just byte/255 at the paint boundary).
  (:schemas {:host.color/rgba [:record :host.color/rgba
                               [[:r :i64] [:g :i64] [:b :i64] [:a :i64]
                                [:ok :bool]]]}))

;; --- char classes --------------------------------------------------------

(defn hex-digit-cp? [cp :i64] :bool
  ;; 0-9 48..57, a-f 97..102. Nested if, not or: or yields i64 here.
  (if (< cp 48) false
      (if (<= cp 57) true
          (if (< cp 97) false
              (if (<= cp 102) true false)))))

;; --- primitive scans (code-point safe) -----------------------------------

(defn hex-val [s :string i :i64] :i64
  ;; 1 hex digit at byte index i -> 0..15, or -1 if not a hex digit.
  (if (>= i (string-length s)) (- 0 1)
      (let [cp (string-code-point-at s i)]
        (if (hex-digit-cp? cp)
          (if (<= cp 57) (- cp 48) (- cp 87))
          (- 0 1)))))

(defn all-hex? [s :string i :i64] :bool
  ;; re-matches #"[0-9a-f]+" -- every char from i to end is a hex digit.
  (if (>= i (string-length s)) true
      (if (< (hex-val s i) 0) false
          (all-hex? s (+ i 1)))))

(defn hex-nibble-byte [s :string i :i64] :i64
  ;; 1 digit, DOUBLED (CSS shorthand: value*16 + value = value*17), -1 if bad.
  (let [d (hex-val s i)]
    (if (< d 0) (- 0 1) (* d 17))))

(defn hex-pair-byte [s :string i :i64] :i64
  ;; 2 digits starting at i -> 0..255, -1 if either is bad.
  (let [hi (hex-val s i)
        lo (hex-val s (+ i 1))]
    (if (if (< hi 0) true (< lo 0)) (- 0 1)
        (+ (* hi 16) lo))))

;; --- the pure decision core ----------------------------------------------

(defn parse-hex [digits :string] :i64
  ;; digits = the string WITHOUT the leading '#'. Verdict code:
  ;;   0 valid, 1 bad character, 2 bad length (not 3/4/6/8).
  ;; (The cljk returns nil vs a 4-vector; a pure profile without nil/vec
  ;; returns a small int the caller dispatches on. Byte extraction is in
  ;; the channel helpers below.)
  (if (all-hex? digits 0)
    (let [n (string-length digits)]
      (if (if (= n 3) true
            (if (= n 4) true
                (if (= n 6) true (= n 8))))
        0 2))
    1))

(defn red-byte [digits :string] :i64
  (let [n (string-length digits)]
    (if (<= n 4) (hex-nibble-byte digits 0)
        (hex-pair-byte digits 0))))

(defn green-byte [digits :string] :i64
  (let [n (string-length digits)]
    (if (<= n 4) (hex-nibble-byte digits 1)
        (hex-pair-byte digits 2))))

(defn blue-byte [digits :string] :i64
  (let [n (string-length digits)]
    (if (<= n 4) (hex-nibble-byte digits 2)
        (hex-pair-byte digits 4))))

(defn alpha-byte [digits :string] :i64
  ;; Own alpha channel: 255 (fully opaque) when the notation carries no
  ;; alpha digits (#rgb/#rrggbb); the doubled/pair alpha byte otherwise.
  (let [n (string-length digits)]
    (if (= n 3) 255
        (if (= n 4) (hex-nibble-byte digits 3)
            (if (= n 6) 255
                (hex-pair-byte digits 6))))))

(defn parse-color [color :string] [:ref :host.color/rgba]
  ;; The cljk parse-color's hex arm: `#...` -> [r g b a] byte channels,
  ;; anything else (named colors, rgb()/hsl(), out of scope here) is the
  ;; documented invalid verdict -- all-zero channels, :ok false, i.e. the
  ;; host's paint-fully-transparent fallback.
  (if (< (string-length color) 1)
    (record-new [:ref :host.color/rgba] 0 0 0 0 false)
    (if (= (string-code-point-at color 0) 35)
      (let [digits (string-substring color 1 (string-length color))]
        (if (= (parse-hex digits) 0)
          (record-new [:ref :host.color/rgba]
                      (red-byte digits)
                      (green-byte digits)
                      (blue-byte digits)
                      (alpha-byte digits)
                      true)
          (record-new [:ref :host.color/rgba] 0 0 0 0 false)))
      (record-new [:ref :host.color/rgba] 0 0 0 0 false))))

(defn main []
  ;; Self-check: color.cljk parse-hex fixtures via binary string-concat.
  ;; Returns an int sum of failing probes (0 = all pass).
  (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (+
    (if (= (red-byte "ff0000") 255) 0 1)
    (if (= (green-byte "ff0000") 0) 0 1))
    (if (= (blue-byte "ff0000") 0) 0 1))
    (if (= (alpha-byte "ff0000") 255) 0 1))
    (if (= (red-byte "f00") 255) 0 1))
    (if (= (green-byte "0f0") 255) 0 1))
    (if (= (blue-byte "00f") 255) 0 1))
    (if (= (red-byte "ff000080") 255) 0 1))
    (if (= (alpha-byte "ff000080") 128) 0 1))
    (if (= (parse-hex "12345") 2) 0 1))
    (if (= (parse-hex "gg0000") 1) 0 1))))
