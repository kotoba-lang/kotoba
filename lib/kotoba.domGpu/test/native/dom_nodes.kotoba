(ns kotoba.wasm.native-dom-nodes-test
  (:require [kotoba.wasm.dom :as dom])
  (:export [main]))

(defn item [d :document i :i64] :document
  (option-or (document-vector-at d i) (document-null)))
(defn field [d :document key :keyword] :document
  (option-or (document-get d key) (document-null)))
(defn num [d :document] :i64 (option-or (document-i64-value d) -1))

;; Drain after each creation, so the node limit is tested independently of
;; the operation transaction limit.
(defn grow [d :document n :i64] :document
  (if (= n 0) d
    (let [made (dom/create-element d :div)
          cleared (item (dom/consume-op-transaction (item made 1)) 1)]
      (grow cleared (- n 1)))))

(defn main [] :i64
  (let [d32 (grow (dom/empty-document) 32)
        d65 (grow d32 33)
        changed (dom/set-attribute d65 33 :data-test (document-string "second batch"))
        with-root (dom/append-child (dom/set-root changed 65) 65 33)
        tree (dom/tree with-root)
        child (item (field tree :children) 0)
        full (grow (item (dom/consume-op-transaction with-root) 1) 191)
        overflow (dom/create-element full :div)
        refused (item overflow 1)
        after (dom/set-attribute refused 0 :data-test (document-string "invalid"))]
    (cond (not= (num (field (dom/node-by-id d65 32) :node/id)) 32) 1
          (not= (num (field (dom/node-by-id d65 33) :node/id)) 33) 2
          (not= (num (field (dom/node-by-id d65 65) :node/id)) 65) 3
          (not= (document-kind (dom/node-by-id d65 66)) :null) 4
          (not= (num (field child :node/id)) 33) 5
          (not (string=? (option-or (document-string-value (field (field child :attrs) :data-test)) "") "second batch")) 6
          (not= (num (item overflow 0)) 0) 7
          (not= (document-kind (item (dom/consume-op-transaction refused) 0)) :null) 8
          (not (document-equal? refused after)) 9
          :else 0)))
