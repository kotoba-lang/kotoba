(ns kotoba.wasm.native-comment-test
  (:require [kotoba.wasm.dom :as dom]) (:export [main]))
(defn at [d :document i :i64] :document (option-or (document-vector-at d i) (document-null)))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn num [d :document] :i64 (option-or (document-i64-value d) 0))
(defn main [] :i64
  (let [r (dom/create-element (dom/empty-document) :div)
        a (dom/create-text-node (at r 1) "before")
        c (dom/create-comment-node (at a 1) "猫 & <")
        b (dom/create-text-node (at c 1) "after")
        d (dom/set-root (dom/append-child (dom/append-child (dom/append-child (at b 1) 1 2) 1 3) 1 4) 1)
        ops (at (dom/consume-op-transaction d) 0)
        node (dom/node-by-id d 3) tree (dom/tree d)]
    (if (and (= (num (at c 0)) 3)
             (document-equal? (field node :node/type) (document-keyword :comment))
             (string=? (option-or (document-string-value (field node :text)) "") "猫 & <")
             (document-equal? (at (at (at ops 0) 2) 0) (document-keyword :dom/create-comment))
             (document-equal? (at (at (at ops 0) 2) 2) (document-string "猫 & <"))
             (= (document-count (field tree :children)) 2)
             (document-equal? (at (field tree :children) 0) (document-string "before"))
             (document-equal? (at (field tree :children) 1) (document-string "after"))) 0 1)))
