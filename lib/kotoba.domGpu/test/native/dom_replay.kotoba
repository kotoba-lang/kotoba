(ns kotoba.wasm.native-dom-replay-test
  (:require [kotoba.wasm.dom :as dom])
  (:export [main]))

(defn item [d :document i :i64] :document
  (option-or (document-vector-at d i) (document-null)))
(defn number [d :document] :i64
  (option-or (document-i64-value d) -1))
(defn key [d :document] :keyword
  (option-or (document-keyword-value d) :invalid))
(defn add-attributes [d :document i :i64 n :i64] :document
  (if (>= i n) d
    (add-attributes (dom/set-attribute d 1 :value (document-i64 i)) (+ i 1) n)))

;; A deliberately limited, pure replay oracle for the operations emitted by
;; this fixture. This is not the browser's trusted host or an atomic commit.
(defn replay-op [d :document op :document] :document
  (let [kind (key (item op 0)) id (number (item op 1))]
    (cond (= kind :dom/create-element)
          (let [made (dom/create-element d (key (item op 2)))]
            (if (= (number (item made 0)) id) (item made 1) (document-null)))
          (= kind :dom/set-root) (dom/set-root d id)
          (= kind :dom/set-attr) (dom/set-attribute d id (key (item op 2)) (item op 3))
          :else (document-null))))

(defn replay-batch [d :document batch :document i :i64] :document
  (if (or (= (document-kind d) :null) (>= i (document-count batch))) d
    (replay-batch (replay-op d (item batch i)) batch (+ i 1))))

(defn main [] :i64
  (let [root (dom/create-element (dom/empty-document) :div)
        started (dom/set-root (item root 1) 1)
        source (add-attributes started 0 33)
        first (dom/consume-op-batch source)
        second (dom/consume-op-batch (item first 1))
        replayed (replay-batch (replay-batch (dom/empty-document) (item first 0) 0)
                               (item second 0) 0)
        expected (dom/tree source)
        actual (dom/tree replayed)]
    (if (document-equal? actual expected) 0 1)))
