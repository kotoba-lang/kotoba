(ns kotoba.wasm.native-dom-overflow-test
  (:require [kotoba.wasm.dom :as dom])
  (:export [main]))

(defn item [d :document i :i64] :document
  (option-or (document-vector-at d i) (document-null)))
(defn add-attributes [d :document i :i64 n :i64] :document
  (if (>= i n) d
    (add-attributes (dom/set-attribute d 1 :value (document-i64 i)) (+ i 1) n)))

(defn main [] :i64
  (let [root (dom/create-element (dom/empty-document) :div)
        started (dom/set-root (item root 1) 1)
        full (add-attributes started 0 254)
        full-transaction (dom/consume-op-transaction full)
        overflow (dom/set-attribute full 1 :value (document-i64 254))
        legacy (dom/consume-ops overflow)
        batch (dom/consume-op-batch overflow)
        transaction (dom/consume-op-transaction overflow)]
    (cond (not= (document-kind (item (dom/consume-op-batch full) 0)) :vector) 1
          (not= (document-kind (item legacy 0)) :null) 2
          (not= (document-kind (item batch 0)) :null) 3
          (not (document-equal? (item batch 1) overflow)) 4
          (not= (document-kind (item transaction 0)) :null) 5
          (not (document-equal? (item transaction 1) overflow)) 6
          (not= (document-count (item full-transaction 0)) 8) 7
          :else 0)))
