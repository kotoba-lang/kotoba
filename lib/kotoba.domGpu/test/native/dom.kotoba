(ns kotoba.wasm.native-dom-test
  (:require [kotoba.wasm.dom :as dom])
  (:export [main]))

(defn- item [pair :document index :i64] :document
  (option-value-of [:option :document] (document-vector-at pair index) (document-null)))

(defn main [] :i64
  (let [element (dom/create-element (dom/empty-document) :div)
        element-id (option-value-of [:option :i64] (document-i64-value (item element 0)) 0)
        text (dom/create-text-node (item element 1) "日本😀")
        text-id (option-value-of [:option :i64] (document-i64-value (item text 0)) 0)
        attached (dom/append-child (item text 1) element-id text-id)
        rooted (dom/set-root attached element-id)
        styled (dom/set-style rooted element-id (document-map :color (document-string "red")))
        attributed (dom/set-attribute styled element-id :title (document-string "共有 DOM"))
        tree (dom/tree attributed)
        consumed (dom/consume-ops attributed)
        again (dom/consume-ops (item consumed 1))]
    (cond (not= element-id 1) 1
          (not= text-id 2) 2
          (not= (document-count (item consumed 0)) 6) 3
          (not= (document-count (item again 0)) 0) 4
          (not (string-contains? (document-edn-print tree) "日本😀")) 5
          (not (string-contains? (document-edn-print tree) "共有 DOM")) 6
          (not (string-contains? (document-edn-print tree) "red")) 7
          :else 0)))
