(ns kotoba.wasm.native-dom-batches-test
  (:require [kotoba.wasm.dom :as dom])
  (:export [main]))

(defn item [d :document n :i64] :document
  (option-or (document-vector-at d n) (document-null)))
(defn number [d :document] :i64
  (option-or (document-i64-value d) -1))
(defn value [ops :document n :i64] :i64
  (number (item (item ops n) 3)))
(defn add-attributes [d :document i :i64 n :i64] :document
  (if (>= i n) d
    (add-attributes (dom/set-attribute d 1 :value (document-i64 i)) (+ i 1) n)))

(defn main [] :i64
  (let [root (dom/create-element (dom/empty-document) :div)
        started (dom/set-root (item root 1) 1)
        thirty-one (add-attributes started 0 29)
        old-shape (document-dissoc (document-dissoc thirty-one :op-tail) :op-overflow)
        old-shape-result (dom/consume-ops old-shape)
        before (add-attributes started 0 30)
        old-result (dom/consume-ops before)
        thirty-three (add-attributes before 30 31)
        first33 (dom/consume-op-batch thirty-three)
        last33 (dom/consume-op-batch (item first33 1))
        full (add-attributes before 30 63)
        transaction (dom/consume-op-transaction full)
        transaction-batches (item transaction 0)
        transaction-empty (dom/consume-op-transaction (item transaction 1))
        legacy (dom/consume-ops full)
        first (dom/consume-op-batch full)
        second (dom/consume-op-batch (item first 1))
        third (dom/consume-op-batch (item second 1))
        end (dom/consume-op-batch (item third 1))
        a (item first 0) b (item second 0) c (item third 0)]
    (cond (not= (document-count (item old-result 0)) 32) 1
          (not= (document-kind (item legacy 0)) :null) 2
          (not (document-equal? (item legacy 1) full)) 3
          (not= (document-count a) 32) 4
          (not= (document-count b) 32) 5
          (not= (document-count c) 1) 6
          (not= (value a 2) 0) 7
          (not= (value a 31) 29) 8
          (not= (value b 0) 30) 9
          (not= (value b 31) 61) 10
          (not= (value c 0) 62) 11
          (not= (document-count (item end 0)) 0) 12
          (not= (document-count (item old-shape-result 0)) 31) 13
          (not= (document-count (item first33 0)) 32) 14
          (not= (document-count (item last33 0)) 1) 15
          (not= (value (item last33 0) 0) 30) 16
          (not= (document-count transaction-batches) 3) 17
          (not= (value (item transaction-batches 0) 31) 29) 18
          (not= (value (item transaction-batches 1) 0) 30) 19
          (not= (value (item transaction-batches 2) 0) 62) 20
          (not= (document-count (item transaction-empty 0)) 0) 21
          :else 0)))
