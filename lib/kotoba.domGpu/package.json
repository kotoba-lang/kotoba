{
  "name": "kotoba-wasm-ui",
  "private": true,
  "version": "0.1.0",
  "description": "kotoba DOM-compatible WASM UI substrate with WebGL and WebGPU browser hosts.",
  "scripts": {
    "watch:wasm-ui": "amu compile --target wasm32-browser wasm-ui",
    "watch:wasm-webgpu": "amu compile --target wasm32-browser wasm-webgpu",
    "release:wasm-ui": "amu compile --target wasm32-browser wasm-ui",
    "release:wasm-webgpu": "amu compile --target wasm32-browser wasm-webgpu",
    "compile:wasm-ui": "amu compile --target wasm32-browser wasm-ui",
    "compile:wasm-webgpu": "amu compile --target wasm32-browser wasm-webgpu",
    "compile:wasm-document": "amu compile --target wasm32-browser wasm-document",
    "compile:all": "npm run compile:wasm-ui && npm run compile:wasm-webgpu && npm run compile:wasm-document",
    "test:clj": "kbb -M:test",
    "smoke:wasm-ui": "kbb -M:smoke",
    "check:wasm-ui": "npm run test:clj && npm run compile:all && npm run smoke:wasm-ui"
  },
  "dependencies": {},
  "devDependencies": {
    "shadow-cljs": "^2.28.20"
  }
}
