{:paths ["src" "resources"]
 ;; Zero runtime dependencies, on purpose.
 ;;
 ;; The catalog exists so that a consumer can ask "what backdrop, and what
 ;; does it do to my text" without pulling a renderer. A web app that wants a
 ;; plate and a legible ink must not inherit sky/atmosphere/terrain/postfx/
 ;; webgpu (and, through terrain and postfx, kotoba-lang/compiler) — so those
 ;; live in the :render alias, which only the offline poster/loop exporter
 ;; uses. Same split liquid-glass-ui keeps for reagent/re-frame/shadow-css.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {org.clojure/clojure {:mvn/version "1.11.1"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; Tier 1/2 only: binds a :byoubu/scene to the real kami stack to render a
  ;; poster or a loop. Not a runtime dependency of anything in src/.
  :render {:extra-paths ["render"]
           :extra-deps {io.github.kotoba-lang/sky        {:local/root "../sky"}
                        io.github.kotoba-lang/atmosphere {:local/root "../atmosphere"}
                        io.github.kotoba-lang/terrain    {:local/root "../terrain"}
                        io.github.kotoba-lang/postfx     {:local/root "../postfx"}}}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
