(ns test
  "nbb test entry: `kbb --backend sci bin/test.cljk` from the repo root.

  The JVM runner (`kbb -M:test`) and this one execute the same .cljc
  test namespaces. Both are run before a release because the plate emitter
  formats numbers, and number formatting is exactly where CLJ and CLJS
  quietly disagree."
  (:require [kotoba.test :as t]
            [byoubu.catalog-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (when-not (t/successful? m)
    (js/process.exit 1)))

(t/run-tests 'byoubu.catalog-test)
