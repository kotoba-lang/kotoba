(ns render
  "Writes resources/byoubu/posters/<id>.svg for every catalog backdrop, and
  regenerates src/byoubu/poster.cljk — the manifest `src/` reads so a consumer
  can resolve a poster (path, size, sha256, dimensions) without file IO and
  without this alias's dependencies.

  Run from the repo root:

    kbb --backend sci --classpath render:../terrain/src bin/render.cljk

  The terrain checkout is a sibling because the FBM that shapes the ridges is
  kotoba-lang/terrain's, not a second implementation living here.

  The sha256 is computed by node here and *recorded as data* in the generated
  namespace, so `src/` can carry the digest without carrying a hash
  implementation or a runtime dependency."
  (:require ["node:fs" :as fs]
            ["node:crypto" :as crypto]
            ["node:child_process" :as cp]
            [kotoba.lang.text :as str]
            [byoubu.core :as byoubu]
            [byoubu.render.poster :as poster]))

(def out-dir "resources/byoubu/posters")

(defn- sha256 [s]
  (-> (crypto/createHash "sha256") (.update s "utf8") (.digest "hex")))

(defn- git-sha [dir]
  (try
    (str/trim (str (cp/execSync "git rev-parse HEAD"
                                #js {:cwd dir :encoding "utf8"
                                     :stdio #js ["ignore" "pipe" "ignore"]})))
    (catch :default _ nil)))

(fs/mkdirSync out-dir #js {:recursive true})

(def entries
  (vec
   (for [id (byoubu/ids)]
     (let [svg  (poster/svg id)
           file (str out-dir "/" (name id) ".svg")]
       (fs/writeFileSync file svg)
       (println (str "  " file "  " (count svg) " bytes"))
       {:id id
        :path (str "byoubu/posters/" (name id) ".svg")
        :bytes (count svg)
        :sha256 (sha256 svg)}))))

;; --- generated manifest ----------------------------------------------------

(def pin
  ;; Only the external repo. byoubu's own sha at render time is always the
  ;; commit *before* the one that carries the artifacts, so recording it would
  ;; describe a tree that never contained these posters. What produced them on
  ;; this side is the committed source itself.
  {:terrain (git-sha "../terrain")})

(defn- entry-str [{:keys [id path bytes sha256]}]
  (str "   " id "\n"
       "   {:path " (pr-str path) "\n"
       "    :bytes " bytes "\n"
       "    :sha256 " (pr-str sha256) "}"))

(def manifest-ns
  (str ";; GENERATED by bin/render.cljk — do not edit by hand.\n"
       ";; Regenerate: kbb --backend sci --classpath render:../terrain/src bin/render.cljk\n"
       "(ns byoubu.poster\n"
       "  \"Manifest of the tier-1 poster artifacts in resources/.\n\n"
       "  Generated, so it cannot drift from the files: the digests below were\n"
       "  computed from the exact bytes written in the same run that wrote this\n"
       "  namespace. `src/` can therefore state what a poster is without doing\n"
       "  file IO (which differs between CLJ and CLJS) and without depending on\n"
       "  a hash implementation.\"\n"
       "  (:require [kotoba.lang.text :as str]))\n\n"
       "(def dimensions {:width " poster/width " :height " poster/height "})\n\n"
       "(def generated-by\n"
       "  \"Repo pins of what produced these artifacts. Unlike\n"
       "  byoubu.catalog/generator's nil pin before any render existed, these\n"
       "  are the shas that actually ran.\"\n"
       "  " (pr-str pin) ")\n\n"
       "(def posters\n"
       "  \"id -> {:path :bytes :sha256}. :path is relative to the classpath\n"
       "  resource root, i.e. resources/<path>.\"\n"
       "  {" (str/join "\n\n" (map entry-str entries)) "})\n\n"
       "(defn poster\n"
       "  \"Manifest entry for a backdrop id, or nil.\"\n"
       "  [id]\n"
       "  (get posters id))\n\n"
       "(defn url\n"
       "  \"Poster URL under a base path, e.g. (url :purple-desert \\\"/assets\\\")\n"
       "  => \\\"/assets/byoubu/posters/purple-desert.svg\\\". Returns nil for an\n"
       "  id with no rendered poster.\"\n"
       "  [id base]\n"
       "  (when-let [p (:path (poster id))]\n"
       "    (str (str/replace (or base \"\") #\"/$\" \"\") \"/\" p)))\n"))

(fs/writeFileSync "src/byoubu/poster.cljk" manifest-ns)
(println (str "wrote src/byoubu/poster.cljk — " (count entries) " posters, pin "
              (pr-str pin)))
