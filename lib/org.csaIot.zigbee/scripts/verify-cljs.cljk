#!/usr/bin/env kbb
;; Run the suite on the ClojureScript side.
;;
;; Not a formality. `ieee802154.mac`/`zigbee.nwk` build 64-bit extended
;; (EUI-64) addresses with quot/mod rather than bit-shift specifically
;; because ClojureScript's bitwise operators are 32-bit and signed
;; (JavaScript semantics) where the JVM's are effectively unbounded on
;; `long`/`BigInt` — asserting the round trip on both runtimes is cheaper
;; than assuming a 64-bit value survives `unsigned-bit-shift-right`.
;;
;;   kbb --backend sci --classpath "$(kbb -A:cljs -Spath)" scripts/verify-cljs.cljk
(ns verify-cljs
  (:require [kotoba.test :as t]
            [ieee802154.mac-test]
            [zigbee.nwk-test]
            [zigbee.aps-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println)
  (if (t/successful? m)
    (println "all checks passed on the ClojureScript path")
    (do (println "FAILED on the ClojureScript path")
        (js/process.exit 1))))

(t/run-tests 'ieee802154.mac-test 'zigbee.nwk-test 'zigbee.aps-test)
