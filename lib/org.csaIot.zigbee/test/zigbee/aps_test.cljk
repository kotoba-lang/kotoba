(ns zigbee.aps-test
  (:require [kotoba.test :refer [deftest is testing]]
            [zigbee.aps :as aps]))

;; ;; constructed, not a published spec vector — a unicast data frame
;; addressing the On/Off cluster (0x0006) under the Home Automation
;; profile (0x0104), commonly-quoted IDs from the Zigbee HA app-notes
;; ecosystem (zigpy's own `zigpy.zcl.clusters.general.OnOff`).
(def unicast-data
  {:frame-type :data :delivery-mode :unicast :ack-request? true
   :dest-endpoint 1 :cluster-id 0x0006 :profile-id 0x0104
   :src-endpoint 1 :aps-counter 0x2A :payload [0x01 0x00 0x00 0x01]})

(deftest round-trip-unicast
  (let [[st bs] (aps/encode unicast-data)]
    (is (= :ok st))
    (is (= 12 (count bs))) ;; fcf(1) endpoint(1) cluster(2) profile(2) srcep(1) counter(1) payload(4)
    (let [[dst fr] (aps/decode bs)]
      (is (= :ok dst))
      (is (= 1 (:dest-endpoint fr)))
      (is (= 0x0006 (:cluster-id fr)))
      (is (= 0x0104 (:profile-id fr)))
      (is (= 1 (:src-endpoint fr)))
      (is (= 0x2A (:aps-counter fr)))
      (is (= [0x01 0x00 0x00 0x01] (:payload fr))))))

(deftest round-trip-group
  ;; ;; constructed, not a published spec vector
  (let [f (-> unicast-data (assoc :delivery-mode :group :group-address 0xBEEF)
              (dissoc :dest-endpoint))
        [st bs] (aps/encode f)]
    (is (= :ok st))
    (let [[dst fr] (aps/decode bs)]
      (is (= :ok dst))
      (is (= 0xBEEF (:group-address fr)))
      (is (not (contains? fr :dest-endpoint))))))

(deftest round-trip-command
  ;; ;; constructed, not a published spec vector — no endpoint/cluster/
  ;; profile fields for a Command frame.
  (let [f {:frame-type :command :aps-counter 0x01 :payload [0x21 0x00 0x02]}
        [st bs] (aps/encode f)]
    (is (= :ok st))
    (is (= 5 (count bs))) ;; fcf(1) counter(1) payload(3)
    (let [[dst fr] (aps/decode bs)]
      (is (= :ok dst))
      (is (not (contains? fr :cluster-id)))
      (is (= 0x01 (:aps-counter fr)))
      (is (= [0x21 0x00 0x02] (:payload fr))))))

(deftest frame-type-and-delivery-mode-sweep
  (testing "every frame-type x delivery-mode combination round trips its fields"
    (doseq [ft (keys aps/frame-types)
            dm (keys aps/delivery-modes)]
      (let [group? (= dm :group)
            has-fields? (not= ft :command)
            f (cond-> {:frame-type ft :delivery-mode dm :aps-counter 0x10
                       :cluster-id 0x0001 :profile-id 0x0002 :src-endpoint 5
                       :payload [0xFF]}
                (and has-fields? group?) (assoc :group-address 0x4444)
                (and has-fields? (not group?)) (assoc :dest-endpoint 9))
            [st bs] (aps/encode f)]
        (is (= :ok st) (str ft "/" dm))
        (let [[dst fr] (aps/decode bs)]
          (is (= :ok dst) (str ft "/" dm))
          (is (= 0x10 (:aps-counter fr)))
          (when has-fields?
            (is (= 0x0001 (:cluster-id fr)))
            (is (= 0x0002 (:profile-id fr)))
            (is (= 5 (:src-endpoint fr))))
          (when (and has-fields? group?) (is (= 0x4444 (:group-address fr))))
          (when (and has-fields? (not group?)) (is (= 9 (:dest-endpoint fr)))))))))

(deftest negative-reserved-frame-type
  (let [[st reason] (aps/encode (assoc unicast-data :frame-type :bogus))]
    (is (= :error st))
    (is (= :zigbee.aps/reserved-frame-type reason))))

(deftest negative-endpoint-out-of-range
  (let [[st reason] (aps/encode (assoc unicast-data :dest-endpoint 999))]
    (is (= :error st))
    (is (= :zigbee.aps/endpoint-out-of-range reason))))

(deftest negative-frame-too-short
  (let [[st reason] (aps/decode [0x00])]
    (is (= :error st))
    (is (= :zigbee.aps/frame-too-short reason))))
