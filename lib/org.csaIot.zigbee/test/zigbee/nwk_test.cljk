(ns zigbee.nwk-test
  (:require [kotoba.test :refer [deftest is testing]]
            [zigbee.nwk :as nwk]))

;; ;; constructed, not a published spec vector — a plain data frame,
;; nothing but short addresses.
(def plain-data
  {:frame-type :data :protocol-version 2 :discover-route :suppress
   :dest-addr 0x1234 :src-addr 0x5678 :radius 5 :seq-num 9
   :payload [0x01 0x02 0x03]})

(deftest round-trip-plain-data
  (let [[st bs] (nwk/encode plain-data)]
    (is (= :ok st))
    (let [[dst fr] (nwk/decode bs)]
      (is (= :ok dst))
      (is (= 0x1234 (:dest-addr fr)))
      (is (= 0x5678 (:src-addr fr)))
      (is (= 5 (:radius fr)))
      (is (= 9 (:seq-num fr)))
      (is (= [0x01 0x02 0x03] (:payload fr))))))

(deftest round-trip-with-ieee-addresses
  ;; ;; constructed, not a published spec vector — `:dest-ieee` is
  ;; 2^53-1, the largest integer JavaScript represents exactly (not a
  ;; naive "top bit set" EUI-64, which would exceed cljs's precision —
  ;; see `precision-boundary-is-documented-not-silent`).
  (let [f (assoc plain-data :dest-ieee? true :src-ieee? true
                 :dest-ieee 0x1FFFFFFFFFFFFF :src-ieee 0x0011223344556677)
        [st bs] (nwk/encode f)]
    (is (= :ok st))
    (let [[dst fr] (nwk/decode bs)]
      (is (= :ok dst))
      (is (= 0x1FFFFFFFFFFFFF (:dest-ieee fr)))
      (is (= 0x0011223344556677 (:src-ieee fr))))))

(deftest precision-boundary-is-documented-not-silent
  ;; A full IEEE address with its top bit set round-trips exactly on the
  ;; JVM and does not on ClojureScript (exceeds 2^53) — asserted
  ;; explicitly per platform so the gap is measured, not accidental.
  (let [f (assoc plain-data :dest-ieee? true :dest-ieee 0xFFFFFFFFFFFFFFFF)
        [st bs] (nwk/encode f)
        [dst fr] (nwk/decode bs)]
    (is (= :ok st))
    (is (= :ok dst))
    #?(:clj (is (= 0xFFFFFFFFFFFFFFFF (:dest-ieee fr)))
       :cljs (is (not= 0xFFFFFFFFFFFFFFFF (:dest-ieee fr))))))

(deftest round-trip-multicast
  ;; ;; constructed, not a published spec vector
  (let [f (assoc plain-data :multicast? true
                 :multicast-control {:mode :member :nonmember-radius 3 :max-nonmember-radius 5})
        [st bs] (nwk/encode f)]
    (is (= :ok st))
    (let [[dst fr] (nwk/decode bs)]
      (is (= :ok dst))
      (is (= {:mode :member :nonmember-radius 3 :max-nonmember-radius 5}
             (:multicast-control fr))))))

(deftest round-trip-source-route
  ;; ;; constructed, not a published spec vector — 3-hop source route.
  (let [f (assoc plain-data :source-route? true :relay-index 1
                 :relay-list [0x1111 0x2222 0x3333])
        [st bs] (nwk/encode f)]
    (is (= :ok st))
    (let [[dst fr] (nwk/decode bs)]
      (is (= :ok dst))
      (is (= [0x1111 0x2222 0x3333] (:relay-list fr)))
      (is (= 1 (:relay-index fr))))))

(deftest presence-sweep
  (testing "every combination of the four presence flags round-trips"
    (doseq [dest-ieee? [false true]
            src-ieee? [false true]
            multicast? [false true]
            source-route? [false true]]
      (let [f (cond-> (assoc plain-data :dest-ieee? dest-ieee? :src-ieee? src-ieee?
                             :multicast? multicast? :source-route? source-route?)
                dest-ieee? (assoc :dest-ieee 0x0102030405060708)
                src-ieee? (assoc :src-ieee 0x1112131415161718)
                multicast? (assoc :multicast-control {:mode :nonmember :nonmember-radius 1 :max-nonmember-radius 2})
                source-route? (assoc :relay-index 0 :relay-list [0xAAAA]))
            [st bs] (nwk/encode f)]
        (is (= :ok st) (str dest-ieee? src-ieee? multicast? source-route?))
        (let [[dst fr] (nwk/decode bs)]
          (is (= :ok dst))
          (is (= dest-ieee? (contains? fr :dest-ieee)))
          (is (= src-ieee? (contains? fr :src-ieee)))
          (is (= multicast? (contains? fr :multicast-control)))
          (is (= source-route? (contains? fr :relay-list))))))))

(deftest negative-reserved-frame-type
  (let [[st reason] (nwk/encode (assoc plain-data :frame-type :bogus))]
    (is (= :error st))
    (is (= :zigbee.nwk/reserved-frame-type reason))))

(deftest negative-frame-too-short
  (let [[st reason] (nwk/decode [0x00 0x00 0x00])]
    (is (= :error st))
    (is (= :zigbee.nwk/frame-too-short reason))))

(deftest negative-relay-index-out-of-range
  (let [[st reason] (nwk/encode (assoc plain-data :source-route? true
                                        :relay-index 5 :relay-list [0x1111]))]
    (is (= :error st))
    (is (= :zigbee.nwk/relay-index-out-of-range reason))))
