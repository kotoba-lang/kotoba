;; No dependencies. The IEEE 802.15.4 MAC frame + Zigbee NWK/APS headers
;; are packed bitfields and big-picture arithmetic — a leaf that dragged
;; in a radio or serial stack would defeat the point, which is that
;; `org-threadgroup-thread`'s 6LoWPAN layer (and anything else in this
;; workspace that needs the shared IEEE 802.15.4 MAC frame) can depend on
;; `ieee802154.mac` here instead of re-deriving it.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
