{:paths ["src"]
 :deps
 {
        ;; kotoba.image replaced java.awt.image.BufferedImage / javax.imageio here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/image {:git/sha "ed0b4dc89268073384c9493bdc80fa72dc17500b"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"};; Real, load-bearing dependency: Marching Cubes SDF -> mesh, used as-is
  ;; (kami.gen.sdf-agent/compile-program calls mesher/sdf-to-colored-mesh
  ;; directly -- this is the one dependency this repo's compile step
  ;; actually runs through).
  io.github.kotoba-lang/mesher {:git/url "https://github.com/kotoba-lang/mesher.git"
                                     :git/sha "4eba597c2b50e1b77d256e62bc0289f1e5fb3f51"}

  ;; kotoba-lang/sdf is currently a scaffold repo with no functions (its
  ;; README says so explicitly: "Scaffold only -- the CLJC restoration is
  ;; pending"). Kept as a :local/root dependency for forward-compat and to
  ;; document intent -- this repo's own src/kami/gen/sdf_agent/sdf.cljk is
  ;; the real, load-bearing SDF primitive/combinator math for v0, and the
  ;; natural migration target once kotoba-lang/sdf grows real functions.
  ;; Not currently required by any namespace here.
  io.github.kotoba-lang/sdf {:git/url "https://github.com/kotoba-lang/sdf.git"
                                     :git/sha "b91b1147b493b04aaf0c9b399e0ab0274c0c179b"}

  ;; kotoba-lang/scad is a real, tested OpenSCAD-text CSG evaluator
  ;; (sphere/cube/cylinder, transform blocks, union/difference/intersection
  ;; groups -- though difference/intersection there are Phase-1 visual
  ;; approximations evaluated as union). Kept as a :local/root dependency
  ;; for vocabulary/interop parity with the org's other CSG work, but not
  ;; required by v0's pipeline: this repo's own EDN CSG tree (see
  ;; kami.gen.sdf-agent.sdf's grammar docstring) is a more constrained,
  ;; structured-LLM-output-friendly input than raw OpenSCAD text.
  io.github.kotoba-lang/scad {:git/url "https://github.com/kotoba-lang/scad.git"
                                     :git/sha "592c0a8647d88980fb5f82da25738eee0404276f"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}