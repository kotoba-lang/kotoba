{:paths ["src"]
 ;; Zero third-party runtime deps — every namespace is portable .cljc (JVM, CLJS, nbb).
 ;; Datoms indexing, event fold, gate evaluation, and the ledger are pure functions
 ;; over plain data maps; the only #?(:clj)/#?(:cljs) split is the file-io edge.
 :deps {
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
