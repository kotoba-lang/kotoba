{:paths ["src"]
 ;; `kotoba.reservation` — the inventory/rate engine consumers actually
 ;; depend on — is ZERO-dep and pure. Only `kotoba.reservation.ui` needs
 ;; html/css, so those live in an alias rather than in :deps.
 ;;
 ;; That is a packaging requirement, not tidiness: `:local/root` paths
 ;; only resolve inside the monorepo checkout, so any of them sitting in
 ;; :deps makes this library unusable as a git dependency —
 ;; `Local lib io.github.kotoba-lang/html not found` at classpath build
 ;; time, before a single namespace loads. cloud-itonami-isic-7990
 ;; consumes this repo by :git/sha and hit exactly that.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {;; the ui namespace and its tests
  :ui {:extra-deps {io.github.kotoba-lang/html {:local/root "../html"}
                    io.github.kotoba-lang/css  {:local/root "../css"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/html {:local/root "../html"}
                      io.github.kotoba-lang/css  {:local/root "../css"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
