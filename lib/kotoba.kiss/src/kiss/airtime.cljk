(ns kiss.airtime
  "A transmit governor for licence-free 920 MHz operation in Japan.

  ARIB STD-T108 limits each transmission's length and the total transmit time
  per hour, and requires carrier sense before sending. The exact figures
  depend on the channel and the carrier-sense time chosen, so they are
  parameters, not constants — the defaults below (4 s per transmission,
  pause ≥ 50 ms, 360 s per hour) are the commonly used setting, and the
  operator must confirm them against the standard for their configuration.

  The governor is consulted before every frame goes to the modem:

      (admit gov now-ms airtime-ms) → [gov' :send] | [gov' [:wait ms]] | [gov' :too-long]

  It never sends early; a frame it cannot admit is the caller's to queue,
  shed or downgrade (a ring outranks a voice frame)."
  )

(def defaults {:max-tx-ms 4000 :min-pause-ms 50 :hourly-budget-ms 360000 :window-ms 3600000})

(defn governor
  ([] (governor {}))
  ([opts] (merge defaults opts {:sent [] :last-end nil})))

(defn used-ms [gov now-ms]
  (transduce (comp (filter #(> (+ (:at %) (:airtime %)) (- now-ms (:window-ms gov))))
                   (map :airtime))
             + 0 (:sent gov)))

(defn admit
  [gov now-ms airtime-ms]
  (let [gov (update gov :sent (fn [s] (filterv #(> (+ (:at %) (:airtime %)) (- now-ms (:window-ms gov))) s)))
        pause-until (when-let [e (:last-end gov)] (+ e (:min-pause-ms gov)))
        used (used-ms gov now-ms)]
    (cond
      (> airtime-ms (:max-tx-ms gov)) [gov :too-long]
      (and pause-until (< now-ms pause-until)) [gov [:wait (- pause-until now-ms)]]
      (> (+ used airtime-ms) (:hourly-budget-ms gov))
      ;; wait until enough old transmissions age out of the window
      (let [need (- (+ used airtime-ms) (:hourly-budget-ms gov))
            freed (reductions + (map :airtime (:sent gov)))
            idx (count (take-while #(< % need) freed))
            oldest (nth (:sent gov) (min idx (dec (count (:sent gov)))))]
        [gov [:wait (max 1 (- (+ (:at oldest) (:airtime oldest) (:window-ms gov)) now-ms))]])
      :else [(-> gov
                 (update :sent conj {:at now-ms :airtime airtime-ms})
                 (assoc :last-end (+ now-ms airtime-ms)))
             :send])))
