(ns kiss.core-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kiss.core :as k]
            [kiss.airtime :as air]))

(deftest framing-test
  (let [data [1 0xC0 2 0xDB 3]
        f (k/frame data)]
    (is (= [0xC0 0x00 1 0xDB 0xDC 2 0xDB 0xDD 3 0xC0] f))
    (testing "a frame split across arbitrary reads decodes once"
      (let [[d1 out1] (k/feed (k/decoder) (subvec f 0 4))
            [_ out2] (k/feed d1 (subvec f 4))]
        (is (empty? out1))
        (is (= [{:port 0 :command :data :data data}] out2))))
    (testing "noise before a frame and back-to-back frames"
      (let [[_ out] (k/feed (k/decoder) (concat [7 7 7] f (k/frame 1 :data [9])))]
        (is (= [data [9]] (mapv :data out)))
        (is (= [0 1] (mapv :port out)))))
    (testing "a bad escape drops only that frame"
      (let [[_ out] (k/feed (k/decoder) (concat [0xC0 0 1 0xDB 0x01 2 0xC0] (k/frame [5])))]
        (is (= [[5]] (mapv :data out)))))))

(deftest radio-command-test
  (is (= [0xC0 0x08 0x36 0xD6 0x16 0xA0 0xC0] (k/radio-command 0 :frequency 920000160)))
  (is (= [0xC0 0x0A 9 0xC0] (k/radio-command 0 :spreading-factor 9)))
  (is (= {:rssi -97 :snr 7.5 :airtime-ms 1200} (k/parse-status [0xFF 0x9F 0 30 4 176]))))

(deftest airtime-test
  (let [gov (air/governor {:hourly-budget-ms 1000})
        [gov r1] (air/admit gov 0 400)
        [gov r2] (air/admit gov 420 400)
        [gov r2b] (air/admit gov 450 400)
        [gov r3] (air/admit gov 1000 400)
        [_ r4] (air/admit gov 1000 200)]
    (is (= :send r1))
    (is (= [:wait 30] r2) "the 50 ms pause after a transmission")
    (is (= :send r2b))
    (is (= [:wait 3599400] r3) "hourly budget exhausted until the first frame ages out")
    (is (= :too-long (second (air/admit (air/governor) 0 5000))))
    (is (= :send r4) "a smaller frame that fits the remaining budget goes")))
