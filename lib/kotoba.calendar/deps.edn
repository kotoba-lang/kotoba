{:paths ["src" "resources"]
 :deps
 {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error {:git/sha "838dec56c9a5b74f9eec825a2fb28bda157f8cd3"}
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "72dde04b4c32854d70d17a670b277f8f7957a784"}
        ;; kotoba.pprint replaced clojure.pprint here (2026-09-24): the same
        ;; bytes (cljs.pprint transcribed). An explicit floor; tools.deps takes the
        ;; NEWEST sha it is shown.
        io.github.kotoba-lang/pprint {:git/sha "5c9d4aea71d6caac529fffcf361aba0f87ee485e"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       ;; The KIR interpreter is a RUNTIME dependency: `calendar.kotoba-oracle`
  ;; executes the shipped `resources/calendar/oracle/model.kir.edn` through
  ;; it, so the decision in `src/calendar/model.kotoba` is what this library
  ;; runs rather than what a test compares against. The COMPILER stays
  ;; test-only (see the :test alias) -- it produced that artifact and never
  ;; reaches production.
  ;;
  ;; Pinned to the kir the pinned compiler emits for: `d58972da` is the sha
  ;; `compiler/806f5cef`'s own deps.edn names. They have to match. KIR is a
  ;; versioned document, and an interpreter reading a shape its emitter did
  ;; not write is exactly the failure the artifact was supposed to remove, so
  ;; advancing one of these two pins without the other is not a smaller
  ;; change than advancing neither.
  io.github.kotoba-lang/osaho
  {:git/url "https://github.com/kotoba-lang/osaho.git"
   :git/sha "d58972da61758584a5bec0e863bcb3ea6fdd6c64"}}
 :aliases
 {;; Regenerate the shipped decision-core KIR. Combine with :test, which
  :test {:extra-paths ["test"]
         ;; The compiler is TEST-ONLY: it compiles `src/calendar/model.kotoba`
         ;; for the drift check in `kotoba-oracle-test` and for the truth
         ;; table in `overlaps-parity-test`. Nothing in `src/` requires it --
         ;; `src/` requires `kotoba.kir`, which is a runtime dep above -- so
         ;; this cannot change what the library does.
         ;;
         ;; Advanced from `bef32b78` (2026-07-19) to `806f5cef` (2026-08-11,
         ;; the commit `manifest/west.yml` pins) for one reason: at `bef32b78`
         ;; the interpreter still lived INSIDE the compiler as
         ;; `kotoba.compiler.ir`, so running the shipped artifact would have
         ;; put the whole compiler on the library's runtime classpath. It
         ;; moved out to `kotoba-lang/kotoba-kir` in ADR-2607266000 Phase B,
         ;; which is what makes a runtime-interpreter/test-only-compiler split
         ;; expressible at all. Measured at `bef32b78`: `kotoba-kir` is not on
         ;; the `:test` classpath in any form.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "806f5cef7d5bc11ad8ec8514ad6121efc73be6c7"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :kotoba {:extra-deps {io.github.kotoba-lang/amu
                        {:git/url "https://github.com/kotoba-lang/amu.git"
                         ;; Same pin the :test alias uses, so the CLI compiles
                         ;; with the compiler that produced the artifact.
                         :git/sha "806f5cef7d5bc11ad8ec8514ad6121efc73be6c7"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}}}
