package kotoba:application@1.0.0;

world application {
  export headers-edn-append: func(acc: string, name: string, value: string) -> string;
  export headers-edn-empty: func() -> string;
  export headers-names-add: func(acc: string, name: string) -> string;
  export http-request-edn: func(url: string, headers: string, body: string, timeout: s64) -> string;
  export http-result-err-edn: func(code: string, retryable: s64) -> string;
  export http-result-ok-edn: func(status: s64, headers: string, body: string) -> string;
}
