(ns kotoba.secret.record-kv-edn
  ;; T8.3 / W4 sixth ops slice ADR 0251: secret kit request/reply as
  ;; nominal EdnKeyValue recursive EDN ADT (same key/value + :edn/node surface as
  ;; HTTP ADR 0250). Closes secret "W4 recursive open" residual; host-fetch
  ;; authority remains host-injected. Does NOT flip wasm-aot :implemented.
  (:schemas {:edn/node [:variant :edn/node
                         [[:atom :string]
                          [:entry [:ref :kotoba.secret.record-kv-edn/EdnKeyValue]]
                          [:pair [:vector [[:ref :edn/node]
                                           [:ref :edn/node]]]]]]})
  (:export [edn_atom
            edn_entry
            edn_pair
            edn_print
            secret_request_rec_kv_edn
            secret_reply_value_rec_kv_edn
            secret_reply_error_rec_kv_edn
            main]))

(defrecord EdnKeyValue [k :string v :string])

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- qstr [s :string] :string
  (string-concat (string-substring "\"x" 0 1)
                 (string-concat s (string-substring "\"x" 0 1))))

(defn edn_atom [s :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.secret.record-kv-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.secret.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :atom s))

(defn edn_entry [k :string v :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.secret.record-kv-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.secret.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :entry
   (->EdnKeyValue k v)))

(defn edn_pair
  [l [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.secret.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   r [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.secret.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.secret.record-kv-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.secret.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :pair
   (hetero-vector [:vector [[:ref :edn/node] [:ref :edn/node]]] l r)))

(defn edn_print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.secret.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (match-variant n
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.secret.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
    (:atom s s)
    (:entry r
      (string-concat
       (:k r)
       (string-concat " "
                      (:v r))))
    (:pair p
      (string-concat
       (edn_print (nth p 0))
       (string-concat " "
                      (edn_print (nth p 1)))))))

(defn- brace-print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.secret.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (string-concat "{" (string-concat (edn_print n) "}")))

;; {:name "…"}  — single record entry
(defn secret_request_rec_kv_edn [name :string] :string
  (if (or (= (string-length name) 0)
          (= (has-forbidden name) 1)
          (> (string-length name) 128))
    ""
    (brace-print (edn_entry ":name" (qstr name)))))

;; {:tag :value :value "…"}
(defn secret_reply_value_rec_kv_edn [value :string] :string
  (if (= (has-forbidden value) 1)
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":value")
               (edn_entry ":value" (qstr value))))))

;; {:tag :error :code "…" :message "…"}
(defn secret_reply_error_rec_kv_edn
  [code :string message :string]
  :string
  (if (or (= (string-length code) 0)
          (= (has-forbidden code) 1)
          (= (has-forbidden message) 1))
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":error")
               (edn_pair (edn_entry ":code" (qstr code))
                         (edn_entry ":message" (qstr message)))))))

(defn main [] :i64
  (let [req (secret_request_rec_kv_edn "API_TOKEN")
        bad-req (secret_request_rec_kv_edn "")
        val (secret_reply_value_rec_kv_edn "s3cr3t")
        bad-val (secret_reply_value_rec_kv_edn "a\"b")
        err (secret_reply_error_rec_kv_edn "not-found" "missing")
        bad-err (secret_reply_error_rec_kv_edn "" "m")
        good-req (if (string-contains? req ":name")
                   (if (string-contains? req "API_TOKEN") 1 0)
                   0)
        good-val (if (string-contains? val ":tag")
                   (if (string-contains? val ":value")
                     (if (string-contains? val "s3cr3t") 1 0)
                     0)
                   0)
        good-err (if (string-contains? err ":error")
                   (if (string-contains? err "not-found")
                     (if (string-contains? err "missing") 1 0)
                     0)
                   0)
        ok-bad-1 (if (= (string-length bad-req) 0) 1 0)
        ok-bad-2 (if (= (string-length bad-val) 0) 1 0)
        ok-bad-3 (if (= (string-length bad-err) 0) 1 0)
        ok-bad (if (= ok-bad-1 1)
                 (if (= ok-bad-2 1)
                   (if (= ok-bad-3 1) 1 0)
                   0)
                 0)]
    (if (= good-req 1)
      (if (= good-val 1)
        (if (= good-err 1)
          (if (= ok-bad 1) -2406 -1)
          -1)
        -1)
      -1)))
