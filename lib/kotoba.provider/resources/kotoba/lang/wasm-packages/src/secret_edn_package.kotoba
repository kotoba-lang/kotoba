(ns kotoba.secret.edn-package
  ;; T8.3 ADR 0237: multi-export secret kit EDN surface (request + reply).
  ;; Folds ADR 0236 request + ADR 0232 reply arms into one pure package.
  ;; Fixed-depth only; W4 recursive nested EDN / full host-fetch kit body open.
  (:export [secret_request_edn
            secret_reply_value_edn
            secret_reply_error_edn
            main]))

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn secret_request_edn
  [name :string]
  :string
  (if (or (= (string-length name) 0)
          (= (has-forbidden name) 1)
          (> (string-length name) 128))
    ""
    (string-concat "{:name \""
                   (string-concat name "\"}"))))

(defn secret_reply_value_edn
  [value :string]
  :string
  (if (= (has-forbidden value) 1)
    ""
    (string-concat "{:tag :value :value \""
                   (string-concat value "\"}"))))

(defn secret_reply_error_edn
  [code :string message :string]
  :string
  (if (or (= (string-length code) 0)
          (= (has-forbidden code) 1)
          (= (has-forbidden message) 1))
    ""
    (string-concat "{:tag :error :code \""
                   (string-concat code
                                  (string-concat "\" :message \""
                                                 (string-concat message "\"}"))))))

;; main → -2307: request ok + value ok + error ok + three rejects
(defn main [] :i64
  (let [req (secret_request_edn "API_TOKEN")
        val (secret_reply_value_edn "s3cr3t")
        err (secret_reply_error_edn "not-found" "missing")
        bad-req (secret_request_edn "")
        bad-val (secret_reply_value_edn "a\"b")
        bad-err (secret_reply_error_edn "" "m")]
    (if (or (= (string-length req) 0)
            (= (string-length val) 0)
            (= (string-length err) 0)
            (not= (string-length bad-req) 0)
            (not= (string-length bad-val) 0)
            (not= (string-length bad-err) 0))
      -1
      -2307)))
