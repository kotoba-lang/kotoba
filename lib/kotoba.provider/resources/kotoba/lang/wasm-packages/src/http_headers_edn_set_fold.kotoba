(ns kotoba.http.headers-edn-set-fold
  ;; T8.3 ADR 0233/0279: headers EDN from nominal Header records
  ;; via typed-set-nth fold (compiler ADR 0194 / kir ADR 0024).
  ;; Complements ADR 0231 (headers-n skeleton only). Name uniqueness via
  ;; parallel :names set. W4 recursive nested EDN / wasm-aot still open.
  (:export [http_hdr_begin
            http_hdr_add
            http_hdr_code
            http_hdr_count
            http_hdr_edn
            main]))

(defrecord Header [name :string value :string])

(defrecord HeaderBag
  [headers [:set [:ref :kotoba.http.headers-edn-set-fold/Header]]
   names [:set :string]
   code :i64])

(def header-set-type
  [:set [:ref :kotoba.http.headers-edn-set-fold/Header]])

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- header-map-edn
  [h [:ref :kotoba.http.headers-edn-set-fold/Header]]
  :string
  (string-concat "{:name \""
                 (string-concat (:name h)
                                (string-concat "\" :value \""
                                               (string-concat (:value h) "\"}")))))

(defn- fold-headers-edn
  [headers [:set [:ref :kotoba.http.headers-edn-set-fold/Header]]
   n :i64 i :i64 acc :string]
  :string
  (if (>= i n)
    acc
    (let [h (typed-set-nth header-set-type headers i)
          piece (header-map-edn h)
          acc2 (if (string=? acc "[]")
                 (string-concat "[" (string-concat piece "]"))
                 (string-concat
                  (string-substring acc 0 (- (string-length acc) 1))
                  (string-concat " " (string-concat piece "]"))))]
      (fold-headers-edn headers n (+ i 1) acc2))))

(defn http_hdr_begin []
  [:ref :kotoba.http.headers-edn-set-fold/HeaderBag]
  (->HeaderBag (typed-set-new header-set-type)
               (typed-set-new [:set :string])
               0))

(defn http_hdr_code
  [st [:ref :kotoba.http.headers-edn-set-fold/HeaderBag]]
  :i64
  (:code st))

(defn http_hdr_count
  [st [:ref :kotoba.http.headers-edn-set-fold/HeaderBag]]
  :i64
  (typed-set-count header-set-type (:headers st)))

(defn http_hdr_add
  [st [:ref :kotoba.http.headers-edn-set-fold/HeaderBag]
   name :string value :string]
  [:ref :kotoba.http.headers-edn-set-fold/HeaderBag]
  (let [{:keys [headers names code]} st]
    (if (not= code 0)
      (->HeaderBag headers names code)
      (if (= (string-length name) 0)
        (->HeaderBag headers names -1)
        (if (or (= (has-forbidden name) 1) (= (has-forbidden value) 1))
          (->HeaderBag headers names -3)
          (if (typed-set-contains [:set :string] names name)
            (->HeaderBag headers names -9)
            (if (>= (typed-set-count header-set-type headers) 32)
              (->HeaderBag headers names -4)
              (let [h (->Header name value)
                    headers2 (typed-set-conj header-set-type headers h)
                    names2 (typed-set-conj [:set :string] names name)]
                (->HeaderBag headers2 names2 0)))))))))

(defn http_hdr_edn
  [st [:ref :kotoba.http.headers-edn-set-fold/HeaderBag]]
  :string
  (let [{:keys [code headers]} st
        n (typed-set-count header-set-type headers)]
    (if (not= code 0)
      ""
      (fold-headers-edn headers n 0 "[]"))))

(defn main [] :i64
  (let [s0 (http_hdr_begin)
        s1 (http_hdr_add s0 "Host" "ex.com")
        s2 (http_hdr_add s1 "Accept" "*/*")
        e (http_hdr_edn s2)
        s3 (http_hdr_add s2 "Host" "other")
        c (http_hdr_code s3)
        n (http_hdr_count s2)
        ok (if (> (string-length e) 10)
             (if (string-contains? e "Accept")
               (if (string-contains? e "Host") 1 0)
               0)
             0)]
    (if (= c -9)
      (if (= n 2)
        (if (= ok 1) -9002 -9001)
        c)
      c)))
