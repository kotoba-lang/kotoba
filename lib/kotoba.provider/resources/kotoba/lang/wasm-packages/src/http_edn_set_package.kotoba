(ns kotoba.http.edn-set-package
  ;; T8.3 ADR 0229/0279: pure EDN kit body with true set uniqueness.
  ;; Folds ADR 0224 set-backed append into request/result encode (ADR 0209–0211
  ;; pure multi-export surface, without substring :name marker scan).
  ;; Guest record state carries EDN vector + [:set :string] names + sticky code.
  ;; Complements Component multi-export (0221–0227 element-bound / names-add).
  ;; W4 recursive nested EDN ADT open; wasm-aot stays :partial.
  (:export [http_headers_edn_set_begin
            http_headers_edn_set_append
            http_headers_edn_set_edn
            http_headers_edn_set_code
            http_headers_edn_set_count
            http_request_edn_set
            http_result_ok_edn
            http_result_err_edn
            main]))

(defrecord HeaderEdnAccumulator
  [edn :string names [:set :string] code :i64])

;; Sticky codes (headers path):
;;   0 ok
;;  -1 empty name
;;  -3 name/value contains " or \
;;  -4 set full (32 names)
;;  -9 duplicate name (typed-set-contains)

(defn- has-forbidden
  [s :string]
  :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n)
        0
        (let [c (string-code-point-at s i)]
          (if (= c 34)
            1
            (if (= c 92)
              1
              (recur (+ i 1)))))))))

(defn- header-map
  [name :string value :string]
  :string
  (string-concat "{:name \""
                 (string-concat name
                                (string-concat "\" :value \""
                                               (string-concat value "\"}")))))

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn- i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

(defn- headers-shape-ok
  [headers :string]
  :i64
  (let [n (string-length headers)]
    (if (< n 2)
      0
      (if (string=? (string-substring headers 0 1) "[")
        (if (string=? (string-substring headers (- n 1) n) "]")
          1
          0)
        0))))

(defn http_headers_edn_set_begin
  []
  [:ref :kotoba.http.edn-set-package/HeaderEdnAccumulator]
  (->HeaderEdnAccumulator "[]" (typed-set-new [:set :string]) 0))

(defn http_headers_edn_set_edn
  [st [:ref :kotoba.http.edn-set-package/HeaderEdnAccumulator]]
  :string
  (:edn st))

(defn http_headers_edn_set_code
  [st [:ref :kotoba.http.edn-set-package/HeaderEdnAccumulator]]
  :i64
  (:code st))

(defn http_headers_edn_set_count
  [st [:ref :kotoba.http.edn-set-package/HeaderEdnAccumulator]]
  :i64
  (typed-set-count [:set :string] (:names st)))

(defn http_headers_edn_set_append
  [st [:ref :kotoba.http.edn-set-package/HeaderEdnAccumulator]
   name :string value :string]
  [:ref :kotoba.http.edn-set-package/HeaderEdnAccumulator]
  (let [{:keys [edn names code]} st]
    (if (= code 0)
      (if (= (string-length name) 0)
        (->HeaderEdnAccumulator edn names -1)
        (if (= (has-forbidden name) 1)
          (->HeaderEdnAccumulator edn names -3)
          (if (= (has-forbidden value) 1)
            (->HeaderEdnAccumulator edn names -3)
            (if (typed-set-contains [:set :string] names name)
              (->HeaderEdnAccumulator edn names -9)
              (if (>= (typed-set-count [:set :string] names) 32)
                (->HeaderEdnAccumulator edn names -4)
                (let [h (header-map name value)
                      names2 (typed-set-conj [:set :string] names name)
                      edn2 (if (string=? edn "[]")
                             (string-concat "[" (string-concat h "]"))
                             (string-concat
                              (string-substring edn 0 (- (string-length edn) 1))
                              (string-concat " " (string-concat h "]"))))]
                  (->HeaderEdnAccumulator edn2 names2 0)))))))
      (->HeaderEdnAccumulator edn names code))))

(defn http_request_edn_set
  [st [:ref :kotoba.http.edn-set-package/HeaderEdnAccumulator]
   url :string body :string timeout-ms :i64]
  :string
  ;; Fail closed if sticky code set, timeout < 0, forbidden in url/body, or
  ;; headers shape broken. Uniqueness already enforced on append path.
  (let [{:keys [code edn]} st
        headers edn]
    (if (not= code 0)
      ""
      (if (< timeout-ms 0)
        ""
        (if (or (= (has-forbidden url) 1) (= (has-forbidden body) 1))
          ""
          (if (= (headers-shape-ok headers) 0)
            ""
            (string-concat "{:url \""
                           (string-concat url
                                          (string-concat "\" :headers "
                                                         (string-concat headers
                                                                        (string-concat " :body \""
                                                                                       (string-concat body
                                                                                                      (string-concat "\" :timeout-ms "
                                                                                                                     (string-concat (i64-str timeout-ms) "}"))))))))))))))

(defn http_result_ok_edn
  [status :i64 headers :string body :string]
  :string
  (if (or (< status 0) (> status 999))
    ""
    (if (= (has-forbidden body) 1)
      ""
      (if (= (headers-shape-ok headers) 0)
        ""
        (string-concat "{:tag :ok :status "
                       (string-concat (i64-str status)
                                      (string-concat " :headers "
                                                     (string-concat headers
                                                                    (string-concat " :body \""
                                                                                   (string-concat body "\"}"))))))))))

(defn http_result_err_edn
  [code :string retryable :i64]
  :string
  (if (= (string-length code) 0)
    ""
    (if (= (has-forbidden code) 1)
      ""
      (if (= retryable 0)
        (string-concat "{:tag :error :code \""
                       (string-concat code "\" :retryable false}"))
        (if (= retryable 1)
          (string-concat "{:tag :error :code \""
                         (string-concat code "\" :retryable true}"))
          "")))))

;; main → -9002: two unique headers, request non-empty, then dup → code -9
;; and count was 2. Also requires result arms produce non-empty strings.
(defn main [] :i64
  (let [s0 (http_headers_edn_set_begin)
        s1 (http_headers_edn_set_append s0 "Host" "ex.com")
        s2 (http_headers_edn_set_append s1 "Accept" "*/*")
        req (http_request_edn_set s2 "https://x.test" "{}" 1000)
        rok (http_result_ok_edn 200 (http_headers_edn_set_edn s2) "ok")
        rerr (http_result_err_edn "timeout" 1)
        s3 (http_headers_edn_set_append s2 "Host" "other")
        c (http_headers_edn_set_code s3)
        n (http_headers_edn_set_count s2)]
    (if (= c -9)
      (if (= n 2)
        (if (and (> (string-length req) 0)
                 (> (string-length rok) 0)
                 (> (string-length rerr) 0))
          -9002
          -9001)
        c)
      c)))
