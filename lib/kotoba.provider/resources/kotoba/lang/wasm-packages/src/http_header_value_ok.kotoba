(ns kotoba.http.header-value-ok
  (:export [http_header_value_ok http_header_pair_ok main]))

;; Typed-string HTTP header value policy + pair compose (ADR 0188).
;; Complements ADR 0187 name_ok. Requires kotoba:typed host.
;;
;; value: -2 >8192, -3 CTL (NUL/CR/LF), 0 ok (empty allowed)
;; pair:  name tchar len<=128 (-1/-2/-3); value -2→-5, -3→-6

(defn- name-char-ok?
  [c :i64]
  :i64
  (if (or (and (>= c 48) (<= c 57))
          (and (>= c 65) (<= c 90))
          (and (>= c 97) (<= c 122))
          (= c 33) (= c 35) (= c 36) (= c 37) (= c 38)
          (= c 39) (= c 42) (= c 43) (= c 45) (= c 46)
          (= c 94) (= c 95) (= c 96) (= c 124) (= c 126))
    1
    0))

(defn- header-name-ok
  [name :string]
  :i64
  (let [n (string-length name)]
    (if (<= n 0)
      -1
      (if (> n 128)
        -2
        (loop [i 0]
          (if (>= i n)
            0
            (let [c (string-code-point-at name i)]
              (if (= (name-char-ok? c) 0)
                -3
                (recur (+ i 1))))))))))

(defn http_header_value_ok
  [value :string]
  :i64
  (let [n (string-length value)]
    (if (> n 8192)
      -2
      (loop [i 0]
        (if (>= i n)
          0
          (let [c (string-code-point-at value i)]
            (if (or (= c 0) (= c 10) (= c 13))
              -3
              (recur (+ i 1)))))))))

(defn http_header_pair_ok
  [name :string value :string]
  :i64
  (let [nr (header-name-ok name)]
    (if (not= nr 0)
      nr
      (let [vr (http_header_value_ok value)]
        (if (not= vr 0)
          (if (= vr -2) -5
            (if (= vr -3) -6 vr))
          0)))))

;; Live: value-ok=0, value-ctl=-3, pair-ok=0, pair-bad-name=-3, pair-bad-val=-6
;; 0*10000 + (-3)*1000 + 0*100 + (-3)*10 + (-6) = -3036
(defn main []
  :i64
  (let [a (http_header_value_ok "yes")
        b (http_header_value_ok "x\ny")
        c (http_header_pair_ok "X-Ok" "yes")
        d (http_header_pair_ok "Bad Name" "yes")
        e (http_header_pair_ok "X-Ok" "x\ny")]
    (+ (* a 10000) (* b 1000) (* c 100) (* d 10) e)))
