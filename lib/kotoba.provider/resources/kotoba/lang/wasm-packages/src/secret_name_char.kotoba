(ns kotoba.secret.char
  (:export [secret_name_char_ok]))

;; Pure char-class half of secret name policy (ADR 0163 / hand WAT secret-get-v1).
;; Forbidden code points → -3; else 0. Length half is secret_name_len_ok (ADR 0173).
;; Host walks the name and calls this per byte/code unit.
(defn secret_name_char_ok
  [c :i64]
  :i64
  (if (or (= c 0)
          (= c 9)
          (= c 10)
          (= c 32)
          (= c 42)
          (= c 47)
          (= c 63)
          (= c 92))
    -3
    0))
