(ns kotoba.http.result-err-edn
  (:export [http_result_err_edn]))

;; T8.3 result error arm reject-path (ADR 0217). Composition on edn_quoted.
;; Body is admission skeleton; Canonical WAT owns quote/backslash scan and
;; retryable ∈ {0,1} gate. Full multi-export request package still open.

(defn http_result_err_edn
  [code :string retryable :i64]
  :string
  (if (= (string-byte-length code) 0)
    ""
    (if (= retryable 0)
      (string-concat "{:tag :error :code \""
                     (string-concat code "\" :retryable false}"))
      (if (= retryable 1)
        (string-concat "{:tag :error :code \""
                       (string-concat code "\" :retryable true}"))
        ""))))
