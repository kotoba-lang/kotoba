(ns kotoba.scoped-fs.record-kv-edn
  ;; T8.3 / W4 scoped-fs kit recursive ADT slice ADR 0255.
  ;; Ports nominal EdnKeyValue recursive EDN to scoped-fs request/reply
  ;; (closes scoped-fs "W4 open" residual). Path policy matches 0243.
  ;; Host store stays host-injected; does NOT flip wasm-aot.
  (:schemas {:edn/node [:variant :edn/node
                         [[:atom :string]
                          [:entry [:ref :kotoba.scoped-fs.record-kv-edn/EdnKeyValue]]
                          [:pair [:vector [[:ref :edn/node]
                                           [:ref :edn/node]]]]]]})
  (:export [edn_atom
            edn_entry
            edn_pair
            edn_print
            fs_req_read_rec_kv_edn
            fs_req_write_rec_kv_edn
            fs_reply_content_rec_kv_edn
            fs_reply_written_rec_kv_edn
            fs_reply_error_rec_kv_edn
            main]))

(defrecord EdnKeyValue [k :string v :string])

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- qstr [s :string] :string
  (string-concat (string-substring "\"x" 0 1)
                 (string-concat s (string-substring "\"x" 0 1))))

(defn- root-ok [root :string] :i64
  (let [n (string-length root)]
    (if (or (<= n 0) (> n 64)) 0
      (loop [i 0]
        (if (>= i n) 1
          (let [c (string-code-point-at root i)]
            (if (or (and (>= c 65) (<= c 90))
                    (and (>= c 97) (<= c 122))
                    (and (>= c 48) (<= c 57))
                    (= c 95)
                    (= c 45))
              (recur (+ i 1))
              0)))))))

(defn- path-has-dotdot [path :string] :i64
  (if (string=? path "..") 1
    (if (string-contains? path "/../") 1
      (if (string-contains? path "../") 1
        (if (string-contains? path "/..") 1
          0)))))

(defn- path-ok [path :string] :i64
  (let [n (string-length path)]
    (if (or (<= n 0) (> n 1024)) 0
      (if (= (has-forbidden path) 1) 0
        (if (= (string-code-point-at path 0) 47) 0
          (if (= (path-has-dotdot path) 1) 0
            1))))))

(defn edn_atom [s :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.scoped-fs.record-kv-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.scoped-fs.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :atom s))

(defn edn_entry [k :string v :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.scoped-fs.record-kv-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.scoped-fs.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :entry
   (->EdnKeyValue k v)))

(defn edn_pair
  [l [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.scoped-fs.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   r [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.scoped-fs.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.scoped-fs.record-kv-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.scoped-fs.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :pair
   (hetero-vector [:vector [[:ref :edn/node] [:ref :edn/node]]] l r)))

(defn edn_print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.scoped-fs.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (match-variant n
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.scoped-fs.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
    (:atom s s)
    (:entry r
      (string-concat
       (:k r)
       (string-concat " "
                      (:v r))))
    (:pair p
      (string-concat
       (edn_print (nth p 0))
       (string-concat " "
                      (edn_print (nth p 1)))))))

(defn- brace-print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.scoped-fs.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (string-concat "{" (string-concat (edn_print n) "}")))

;; root as keyword atom value (:workspace) without quotes
(defn- root-kw [root :string] :string
  (string-concat ":" root))

;; {:tag :read :root :… :path "…"}
(defn fs_req_read_rec_kv_edn
  [root :string path :string]
  :string
  (if (or (= (root-ok root) 0) (= (path-ok path) 0))
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":read")
               (edn_pair (edn_entry ":root" (root-kw root))
                         (edn_entry ":path" (qstr path)))))))

;; {:tag :write :root :… :path "…" :value "…"}
(defn fs_req_write_rec_kv_edn
  [root :string path :string value :string]
  :string
  (if (or (= (root-ok root) 0)
          (= (path-ok path) 0)
          (= (has-forbidden value) 1)
          (> (string-length value) 65536))
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":write")
               (edn_pair (edn_entry ":root" (root-kw root))
                         (edn_pair (edn_entry ":path" (qstr path))
                                   (edn_entry ":value" (qstr value))))))))

;; {:tag :content :content "…"}
(defn fs_reply_content_rec_kv_edn [content :string] :string
  (if (or (= (has-forbidden content) 1)
          (> (string-length content) 65536))
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":content")
               (edn_entry ":content" (qstr content))))))

;; {:tag :written :written true|false}
(defn fs_reply_written_rec_kv_edn [written :i64] :string
  (if (= written 1)
    (brace-print
     (edn_pair (edn_entry ":tag" ":written")
               (edn_entry ":written" "true")))
    (if (= written 0)
      (brace-print
       (edn_pair (edn_entry ":tag" ":written")
                 (edn_entry ":written" "false")))
      "")))

;; {:tag :error :code "…" :message "…"}
(defn fs_reply_error_rec_kv_edn
  [code :string message :string]
  :string
  (if (or (= (string-length code) 0)
          (= (has-forbidden code) 1)
          (= (has-forbidden message) 1))
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":error")
               (edn_pair (edn_entry ":code" (qstr code))
                         (edn_entry ":message" (qstr message)))))))

(defn main [] :i64
  (let [rd (fs_req_read_rec_kv_edn "workspace" "docs/a.txt")
        wr (fs_req_write_rec_kv_edn "workspace" "docs/a.txt" "hello")
        content (fs_reply_content_rec_kv_edn "hello")
        written (fs_reply_written_rec_kv_edn 1)
        err (fs_reply_error_rec_kv_edn "not-found" "missing")
        bad-root (fs_req_read_rec_kv_edn "" "a")
        bad-path (fs_req_read_rec_kv_edn "workspace" "../etc/passwd")
        bad-abs (fs_req_read_rec_kv_edn "workspace" "/abs")
        bad-val (fs_req_write_rec_kv_edn "workspace" "a" "x\"y")
        bad-written (fs_reply_written_rec_kv_edn 2)
        bad-err (fs_reply_error_rec_kv_edn "" "m")
        good-rd (if (string-contains? rd ":read")
                  (if (string-contains? rd "docs/a.txt")
                    (if (string-contains? rd ":workspace") 1 0)
                    0)
                  0)
        good-wr (if (string-contains? wr ":write")
                  (if (string-contains? wr "hello") 1 0)
                  0)
        good-c (if (string-contains? content ":content") 1 0)
        good-w (if (string-contains? written "true") 1 0)
        good-e (if (string-contains? err ":error") 1 0)
        ok-bad (if (= (string-length bad-root) 0)
                 (if (= (string-length bad-path) 0)
                   (if (= (string-length bad-abs) 0)
                     (if (= (string-length bad-val) 0)
                       (if (= (string-length bad-written) 0)
                         (if (= (string-length bad-err) 0) 1 0)
                         0)
                       0)
                     0)
                   0)
                 0)]
    (if (= good-rd 1)
      (if (= good-wr 1)
        (if (= good-c 1)
          (if (= good-w 1)
            (if (= good-e 1)
              (if (= ok-bad 1) -2505 -1)
              -1)
            -1)
          -1)
        -1)
      -1)))
