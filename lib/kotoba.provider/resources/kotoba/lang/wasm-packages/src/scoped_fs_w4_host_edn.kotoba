(ns kotoba.scoped-fs.w4-host-edn
  ;; T8.3 ADR 0267 read + ADR 0268 write: scoped-fs W4 request encode +
  ;; typed-cap-call wire 19 (fs/transact). Main pure → -2512 after write slice.
  (:schemas {:edn/node [:variant :edn/node
                         [[:atom :string]
                          [:entry [:ref :kotoba.scoped-fs.w4-host-edn/EdnKeyValue]]
                          [:pair [:vector [[:ref :edn/node]
                                           [:ref :edn/node]]]]]]})
  (:export [fs_req_read_rec_kv_edn
            fs_req_write_rec_kv_edn
            fs_reply_written_rec_kv_edn
            host_read_edn
            host_write_edn
            main]))

(defrecord EdnKeyValue [k :string v :string])

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- qstr [s :string] :string
  (string-concat (string-substring "\"x" 0 1)
                 (string-concat s (string-substring "\"x" 0 1))))

(defn- root-ok [root :string] :i64
  (let [n (string-length root)]
    (if (or (<= n 0) (> n 64)) 0
      (loop [i 0]
        (if (>= i n) 1
          (let [c (string-code-point-at root i)]
            (if (or (and (>= c 65) (<= c 90))
                    (and (>= c 97) (<= c 122))
                    (and (>= c 48) (<= c 57))
                    (= c 95)
                    (= c 45))
              (recur (+ i 1))
              0)))))))

(defn- path-ok [path :string] :i64
  (let [n (string-length path)]
    (if (or (<= n 0) (> n 1024)) 0
      (if (= (has-forbidden path) 1) 0
        (if (= (string-code-point-at path 0) 47) 0
          (if (string-contains? path "..") 0 1))))))

(defn- edn_entry [k :string v :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.scoped-fs.w4-host-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.scoped-fs.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :entry
   (->EdnKeyValue k v)))

(defn- edn_pair
  [l [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.scoped-fs.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   r [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.scoped-fs.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.scoped-fs.w4-host-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.scoped-fs.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :pair
   (hetero-vector [:vector [[:ref :edn/node] [:ref :edn/node]]] l r)))

(defn- edn_print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.scoped-fs.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (match-variant n
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.scoped-fs.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
    (:atom s s)
    (:entry r
      (string-concat
       (:k r)
       (string-concat " "
                      (:v r))))
    (:pair p
      (string-concat
       (edn_print (nth p 0))
       (string-concat " "
                      (edn_print (nth p 1)))))))

(defn- brace-print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.scoped-fs.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (string-concat "{" (string-concat (edn_print n) "}")))

(defn fs_req_read_rec_kv_edn [root :string path :string] :string
  (if (or (= (root-ok root) 0) (= (path-ok path) 0))
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":read")
               (edn_pair (edn_entry ":root" (string-concat ":" root))
                         (edn_entry ":path" (qstr path)))))))

(defn fs_req_write_rec_kv_edn
  [root :string path :string value :string]
  :string
  (if (or (= (root-ok root) 0)
          (= (path-ok path) 0)
          (= (has-forbidden value) 1)
          (> (string-length value) 65536))
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":write")
               (edn_pair (edn_entry ":root" (string-concat ":" root))
                         (edn_pair (edn_entry ":path" (qstr path))
                                   (edn_entry ":value" (qstr value))))))))

(defn fs_reply_written_rec_kv_edn [written :i64] :string
  (if (= written 1)
    (brace-print
     (edn_pair (edn_entry ":tag" ":written")
               (edn_entry ":written" "true")))
    (if (= written 0)
      (brace-print
       (edn_pair (edn_entry ":tag" ":written")
                 (edn_entry ":written" "false")))
      "")))

(defn host_read_edn [root :string path :string] :string
  (let [req (fs_req_read_rec_kv_edn root path)]
    (if (= (string-length req) 0)
      ""
      (typed-cap-call 19 :string :string req))))

(defn host_write_edn
  [root :string path :string value :string]
  :string
  (let [req (fs_req_write_rec_kv_edn root path value)]
    (if (= (string-length req) 0)
      ""
      (typed-cap-call 19 :string :string req))))

(defn main [] :i64
  (let [rd (fs_req_read_rec_kv_edn "workspace" "docs/a.txt")
        wr (fs_req_write_rec_kv_edn "workspace" "docs/a.txt" "hello")
        bad-rd (fs_req_read_rec_kv_edn "" "x")
        bad-wr (fs_req_write_rec_kv_edn "workspace" "a" "x\"y")
        written (fs_reply_written_rec_kv_edn 1)
        good-rd (if (string-contains? rd ":read")
                  (if (string-contains? rd "docs/a.txt") 1 0)
                  0)
        good-wr (if (string-contains? wr ":write")
                  (if (string-contains? wr "hello")
                    (if (string-contains? wr ":value") 1 0)
                    0)
                  0)
        good-written (if (string-contains? written ":written")
                       (if (string-contains? written "true") 1 0)
                       0)
        ok-bad (if (= (string-length bad-rd) 0)
                 (if (= (string-length bad-wr) 0) 1 0)
                 0)]
    (if (= good-rd 1)
      (if (= good-wr 1)
        (if (= good-written 1)
          (if (= ok-bad 1) -2512 -1)
          -1)
        -1)
      -1)))
