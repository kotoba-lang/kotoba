(ns kotoba.http.headers-edn-append
  (:export [headers_edn_append]))

;; T8.3 multi-header append + name uniqueness (ADR 0216 → 0227).
;; Body is admission skeleton; Canonical WAT owns dual scan,
;; map-element-bound name field uniqueness (`{` after [ / space,
;; then {:name "…"}), and vector splice. Not free substring :name
;; scan. Complements headers-names-add name-list plane (ADR 0225).
;; W4 recursive nested EDN open; wasm-aot stays partial.

(defn headers_edn_append
  [acc :string name :string value :string]
  :string
  (if (= (string-byte-length acc) 0)
    ""
    (if (string=? acc "[]")
      (string-concat "["
                     (string-concat name
                                    (string-concat value "]")))
      (string-concat acc
                     (string-concat " "
                                    (string-concat name
                                                   (string-concat value "]")))))))
