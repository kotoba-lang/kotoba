(ns kotoba.entropy.edn-package
  ;; T8.3 ADR 0244: pure entropy kit fixed-depth EDN surface.
  ;; Request: draw-bytes n in [1, 64]. Reply: hex string or error.
  ;; Dual quote/backslash scan on string leaves. CSPRNG remains host-injected.
  ;; Complements bounds 0172. W4 recursive nested EDN open; wasm-aot :partial.
  (:export [entropy_req_edn
            entropy_reply_hex_edn
            entropy_reply_error_edn
            main]))

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn- hex-char-ok [c :i64] :i64
  (if (or (and (>= c 48) (<= c 57))
          (and (>= c 97) (<= c 102)))
    1
    0))

(defn- hex-ok [hex :string] :i64
  (let [n (string-length hex)]
    (if (or (<= n 0) (> n 128) (not= n (* 2 (quot n 2)))) 0
      (if (= (has-forbidden hex) 1) 0
        (loop [i 0]
          (if (>= i n) 1
            (if (= (hex-char-ok (string-code-point-at hex i)) 0) 0
              (recur (+ i 1)))))))))

(defn entropy_req_edn
  [n :i64]
  :string
  (if (or (< n 1) (> n 64))
    ""
    (string-concat "{:n "
                   (string-concat (nat-str n) "}"))))

(defn entropy_reply_hex_edn
  [hex :string]
  :string
  (if (= (hex-ok hex) 0)
    ""
    (string-concat "{:tag :hex :hex \""
                   (string-concat hex "\"}"))))

(defn entropy_reply_error_edn
  [code :string message :string]
  :string
  (if (or (= (string-length code) 0)
          (= (has-forbidden code) 1)
          (= (has-forbidden message) 1))
    ""
    (string-concat "{:tag :error :code \""
                   (string-concat code
                                  (string-concat "\" :message \""
                                                 (string-concat message "\"}"))))))

;; main → -2315: req ok, hex ok, err ok, rejects
(defn main [] :i64
  (let [req (entropy_req_edn 16)
        hex (entropy_reply_hex_edn "deadbeefcafebabe")
        err (entropy_reply_error_edn "draw-failed" "ENOSYS")
        bad-n (entropy_req_edn 0)
        bad-n2 (entropy_req_edn 65)
        bad-hex (entropy_reply_hex_edn "zz")
        bad-hex2 (entropy_reply_hex_edn "abc")
        bad-err (entropy_reply_error_edn "" "m")
        good (if (string-contains? req ":n ")
               (if (string-contains? req "16")
                 (if (string-contains? hex ":tag :hex")
                   (if (string-contains? err ":tag :error") 1 0)
                   0)
                 0)
               0)]
    (if (and (= good 1)
             (= (string-length bad-n) 0)
             (= (string-length bad-n2) 0)
             (= (string-length bad-hex) 0)
             (= (string-length bad-hex2) 0)
             (= (string-length bad-err) 0))
      -2315
      -1)))
