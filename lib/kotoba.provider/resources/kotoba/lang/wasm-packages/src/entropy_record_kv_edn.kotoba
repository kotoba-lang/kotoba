(ns kotoba.entropy.record-kv-edn
  ;; T8.3 / W4 entropy kit first recursive ADT slice ADR 0254.
  ;; Ports nominal EdnKeyValue recursive EDN to entropy request/reply
  ;; (closes entropy "W4 open" residual). CSPRNG stays host-injected;
  ;; does NOT flip wasm-aot :implemented.
  (:schemas {:edn/node [:variant :edn/node
                         [[:atom :string]
                          [:entry [:ref :kotoba.entropy.record-kv-edn/EdnKeyValue]]
                          [:pair [:vector [[:ref :edn/node]
                                           [:ref :edn/node]]]]]]})
  (:export [edn_atom
            edn_entry
            edn_pair
            edn_print
            entropy_req_rec_kv_edn
            entropy_reply_hex_rec_kv_edn
            entropy_reply_error_rec_kv_edn
            main]))

(defrecord EdnKeyValue [k :string v :string])

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- qstr [s :string] :string
  (string-concat (string-substring "\"x" 0 1)
                 (string-concat s (string-substring "\"x" 0 1))))

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn- hex-char-ok [c :i64] :i64
  (if (or (and (>= c 48) (<= c 57))
          (and (>= c 97) (<= c 102)))
    1
    0))

(defn- hex-ok [hex :string] :i64
  (let [n (string-length hex)]
    (if (or (<= n 0) (> n 128) (not= n (* 2 (quot n 2)))) 0
      (if (= (has-forbidden hex) 1) 0
        (loop [i 0]
          (if (>= i n) 1
            (if (= (hex-char-ok (string-code-point-at hex i)) 0) 0
              (recur (+ i 1)))))))))

(defn edn_atom [s :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.entropy.record-kv-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.entropy.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :atom s))

(defn edn_entry [k :string v :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.entropy.record-kv-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.entropy.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :entry
   (->EdnKeyValue k v)))

(defn edn_pair
  [l [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.entropy.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   r [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.entropy.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.entropy.record-kv-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.entropy.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :pair
   (hetero-vector [:vector [[:ref :edn/node] [:ref :edn/node]]] l r)))

(defn edn_print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.entropy.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (match-variant n
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.entropy.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
    (:atom s s)
    (:entry r
      (string-concat
       (:k r)
       (string-concat " "
                      (:v r))))
    (:pair p
      (string-concat
       (edn_print (nth p 0))
       (string-concat " "
                      (edn_print (nth p 1)))))))

(defn- brace-print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.entropy.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (string-concat "{" (string-concat (edn_print n) "}")))

;; request: {:n N}  with n ∈ [1, 64]
(defn entropy_req_rec_kv_edn [n :i64] :string
  (if (or (< n 1) (> n 64))
    ""
    (brace-print (edn_entry ":n" (nat-str n)))))

;; reply hex: {:tag :hex :hex "…"}
(defn entropy_reply_hex_rec_kv_edn [hex :string] :string
  (if (= (hex-ok hex) 0)
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":hex")
               (edn_entry ":hex" (qstr hex))))))

;; reply error: {:tag :error :code "…" :message "…"}
(defn entropy_reply_error_rec_kv_edn
  [code :string message :string]
  :string
  (if (or (= (string-length code) 0)
          (= (has-forbidden code) 1)
          (= (has-forbidden message) 1))
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":error")
               (edn_pair (edn_entry ":code" (qstr code))
                         (edn_entry ":message" (qstr message)))))))

(defn main [] :i64
  (let [req (entropy_req_rec_kv_edn 16)
        hex (entropy_reply_hex_rec_kv_edn "deadbeefcafebabe")
        err (entropy_reply_error_rec_kv_edn "draw-failed" "ENOSYS")
        bad-n (entropy_req_rec_kv_edn 0)
        bad-n2 (entropy_req_rec_kv_edn 65)
        bad-hex (entropy_reply_hex_rec_kv_edn "zz")
        bad-hex2 (entropy_reply_hex_rec_kv_edn "abc")
        bad-err (entropy_reply_error_rec_kv_edn "" "m")
        good-req (if (string-contains? req ":n")
                   (if (string-contains? req "16") 1 0)
                   0)
        good-hex (if (string-contains? hex ":hex")
                   (if (string-contains? hex "deadbeefcafebabe") 1 0)
                   0)
        good-err (if (string-contains? err ":error")
                   (if (string-contains? err "draw-failed") 1 0)
                   0)
        ok-bad (if (= (string-length bad-n) 0)
                 (if (= (string-length bad-n2) 0)
                   (if (= (string-length bad-hex) 0)
                     (if (= (string-length bad-hex2) 0)
                       (if (= (string-length bad-err) 0) 1 0)
                       0)
                     0)
                   0)
                 0)]
    (if (= good-req 1)
      (if (= good-hex 1)
        (if (= good-err 1)
          (if (= ok-bad 1) -2504 -1)
          -1)
        -1)
      -1)))
