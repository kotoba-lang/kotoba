(ns kotoba.http.edn-trust-package
  (:export [headers_edn_empty http_header_edn_trust
            headers_edn_one http_request_edn_trust
            http_result_ok_edn_trust http_result_err_edn_trust]))

;; T8.3 multi-export EDN trust package (ADR 0213).
;; Pure nested string-concat only — admitted by kotoba-component
;; :string-expression-package (shared memory). Host pre-validates atoms
;; (no quote/backslash) and pre-renders i64 fields as decimal strings.
;; Rejecting encoder remains http-request-edn (ADR 0209–0211).

(defn headers_edn_empty [] :string
  "[]")

(defn http_header_edn_trust
  [name :string value :string]
  :string
  (string-concat "{:name \""
                 (string-concat name
                                (string-concat "\" :value \""
                                               (string-concat value "\"}")))))

(defn headers_edn_one
  [name :string value :string]
  :string
  (string-concat "[{:name \""
                 (string-concat name
                                (string-concat "\" :value \""
                                               (string-concat value "\"}]")))))

(defn http_request_edn_trust
  [url :string headers :string body :string timeout-str :string]
  :string
  (string-concat "{:url \""
                 (string-concat url
                                (string-concat "\" :headers "
                                               (string-concat headers
                                                              (string-concat " :body \""
                                                                             (string-concat body
                                                                                            (string-concat "\" :timeout-ms "
                                                                                                           (string-concat timeout-str "}")))))))))

(defn http_result_ok_edn_trust
  [status-str :string headers :string body :string]
  :string
  (string-concat "{:tag :ok :status "
                 (string-concat status-str
                                (string-concat " :headers "
                                               (string-concat headers
                                                              (string-concat " :body \""
                                                                             (string-concat body "\"}")))))))

(defn http_result_err_edn_trust
  [code :string retryable-str :string]
  :string
  (string-concat "{:tag :error :code \""
                 (string-concat code
                                (string-concat "\" :retryable "
                                               (string-concat retryable-str "}")))))
