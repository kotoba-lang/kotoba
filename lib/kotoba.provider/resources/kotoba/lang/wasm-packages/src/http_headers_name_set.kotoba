(ns kotoba.http.headers-name-set
  ;; T8.3 ADR 0223/0279: true header-name uniqueness via bounded typed-set
  ;; `[:set :string]` (max 32). Composes ADR 0187 name policy + 0188 value
  ;; policy with set membership — not substring `:name` marker scan.
  ;; Guest record state carries names + sticky error code.
  ;; W4 recursive nested EDN ADT still open; wasm-aot stays :partial.
  (:export [http_headers_names_begin
            http_headers_names_add
            http_headers_names_pair
            http_headers_names_code
            http_headers_names_count
            main]))

(defrecord HeaderNameSet [names [:set :string] code :i64])

;; Codes (sticky once non-zero):
;;   0 ok
;;  -1 empty name
;;  -2 name length > 128
;;  -3 name non-tchar
;;  -4 set full (already 32 names) / begin n∉[0,32]
;;  -5 value length > 8192
;;  -6 value has NUL/CR/LF
;;  -9 duplicate name (true set membership)

(defn- name-char-ok?
  [c :i64]
  :i64
  (if (or (and (>= c 48) (<= c 57))
          (and (>= c 65) (<= c 90))
          (and (>= c 97) (<= c 122))
          (= c 33) (= c 35) (= c 36) (= c 37) (= c 38)
          (= c 39) (= c 42) (= c 43) (= c 45) (= c 46)
          (= c 94) (= c 95) (= c 96) (= c 124) (= c 126))
    1
    0))

(defn- header-name-ok
  [name :string]
  :i64
  (let [n (string-length name)]
    (if (<= n 0)
      -1
      (if (> n 128)
        -2
        (loop [i 0]
          (if (>= i n)
            0
            (let [c (string-code-point-at name i)]
              (if (= (name-char-ok? c) 0)
                -3
                (recur (+ i 1))))))))))

(defn- header-value-ok
  [value :string]
  :i64
  (let [n (string-length value)]
    (if (> n 8192)
      -5
      (loop [i 0]
        (if (>= i n)
          0
          (let [c (string-code-point-at value i)]
            (if (or (= c 0) (= c 10) (= c 13))
              -6
              (recur (+ i 1)))))))))

(defn http_headers_names_begin
  [n :i64]
  [:ref :kotoba.http.headers-name-set/HeaderNameSet]
  (if (or (< n 0) (> n 32))
    (->HeaderNameSet (typed-set-new [:set :string]) -4)
    (->HeaderNameSet (typed-set-new [:set :string]) 0)))

(defn http_headers_names_code
  [st [:ref :kotoba.http.headers-name-set/HeaderNameSet]]
  :i64
  (:code st))

(defn http_headers_names_count
  [st [:ref :kotoba.http.headers-name-set/HeaderNameSet]]
  :i64
  (typed-set-count [:set :string] (:names st)))

(defn http_headers_names_add
  [st [:ref :kotoba.http.headers-name-set/HeaderNameSet] name :string]
  [:ref :kotoba.http.headers-name-set/HeaderNameSet]
  (let [{:keys [names code]} st]
    (if (= code 0)
      (let [nr (header-name-ok name)]
        (if (not= nr 0)
          (->HeaderNameSet names nr)
          (if (typed-set-contains [:set :string] names name)
            (->HeaderNameSet names -9)
            (if (>= (typed-set-count [:set :string] names) 32)
              (->HeaderNameSet names -4)
              (->HeaderNameSet (typed-set-conj [:set :string] names name) 0)))))
      (->HeaderNameSet names code))))

(defn http_headers_names_pair
  [st [:ref :kotoba.http.headers-name-set/HeaderNameSet]
   name :string value :string]
  [:ref :kotoba.http.headers-name-set/HeaderNameSet]
  (let [{:keys [names code]} st]
    (if (= code 0)
      (let [nr (header-name-ok name)]
        (if (not= nr 0)
          (->HeaderNameSet names nr)
          (let [vr (header-value-ok value)]
            (if (not= vr 0)
              (->HeaderNameSet names vr)
              (if (typed-set-contains [:set :string] names name)
                (->HeaderNameSet names -9)
                (if (>= (typed-set-count [:set :string] names) 32)
                  (->HeaderNameSet names -4)
                  (->HeaderNameSet
                   (typed-set-conj [:set :string] names name) 0)))))))
      (->HeaderNameSet names code))))

;; Prove: two distinct names + duplicate reject via true set membership.
;; Returns -9 * 1000 - count after successful pair path encoding, or sticky code.
;; main → -9002 means code -9 after 2 unique names (accept, host) then dup accept.
(defn main [] :i64
  (let [s0 (http_headers_names_begin 32)
        s1 (http_headers_names_pair s0 "accept" "text/html")
        s2 (http_headers_names_pair s1 "host" "example.com")
        s3 (http_headers_names_pair s2 "accept" "text/plain")
        c (http_headers_names_code s3)
        n (http_headers_names_count s2)]
    (if (= c -9)
      (if (= n 2)
        -9002
        c)
      c)))
