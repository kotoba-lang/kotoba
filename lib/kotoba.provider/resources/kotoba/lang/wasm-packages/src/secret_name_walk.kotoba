(ns kotoba.secret.walk
  (:export [secret_name_begin secret_name_next secret_name_end]))

;; Pure multi-step secret name policy (ADR 0178).
;; Composes length half (ADR 0173) + char-class half (ADR 0176) into one
;; host-walk protocol — host iterates bytes without separate len/char packages.
;;
;; secret_name_begin(len) → 0 | -1 empty | -2 too-long
;; secret_name_next(state, c) → 0 | prior error | -3 forbidden char
;; secret_name_end(state) → state (0 ok)
;;
;; Hand WAT one-shot secret_name_ok(ptr,len) retained.

(defn secret_name_begin
  [len :i64]
  :i64
  (if (<= len 0)
    -1
    (if (> len 128)
      -2
      0)))

(defn secret_name_next
  [state :i64 c :i64]
  :i64
  (if (< state 0)
    state
    (if (or (= c 0)
            (= c 9)
            (= c 10)
            (= c 32)
            (= c 42)
            (= c 47)
            (= c 63)
            (= c 92))
      -3
      0)))

(defn secret_name_end
  [state :i64]
  :i64
  state)
