(ns kotoba.http.edn-reject-package
  (:export [headers_edn_empty headers_edn_append headers_names_add
            http_request_edn http_result_ok_edn http_result_err_edn]))

;; T8.3 multi-export reject-path EDN kit (ADR 0226/0227/0230).
;; Multi-ns project body: src/http-edn-reject-project/ (Component re-emit).
;; T8.3 multi-export reject-path EDN kit (ADR 0226/0227): empty + append
;; (map-element-bound name field) + names-add (true-set name list) +
;; request + result arms.
;; Canonical :http-edn-reject-package (kotoba-component ≥ 7e017bbc).
;; Bodies are admission skeletons; WAT owns scans/shape/decimal/element
;; equality. W4 recursive nested EDN open; wasm-aot stays partial.

(defn headers_edn_empty [] :string
  "[]")

(defn headers_edn_append
  [acc :string name :string value :string]
  :string
  (if (string=? acc "[]")
    (string-concat "[" (string-concat name (string-concat value "]")))
    (string-concat acc (string-concat " " (string-concat name value)))))

(defn headers_names_add
  [acc :string name :string]
  :string
  (if (= (string-byte-length acc) 0)
    ""
    (if (= (string-byte-length name) 0)
      ""
      (if (string=? acc "[]")
        (string-concat "["
                       (string-concat "\""
                                      (string-concat name "\"]")))
        (string-concat acc
                       (string-concat " "
                                      (string-concat "\""
                                                     (string-concat name "\"]"))))))))

(defn http_request_edn
  [url :string headers :string body :string timeout :i64]
  :string
  (if (< timeout 0)
    ""
    (string-concat url (string-concat headers (string-concat body "[]")))))

(defn http_result_ok_edn
  [status :i64 headers :string body :string]
  :string
  (if (or (< status 0) (> status 999))
    ""
    (string-concat headers (string-concat body "ok"))))

(defn http_result_err_edn
  [code :string retryable :i64]
  :string
  (if (= retryable 0)
    (string-concat code "error")
    (if (= retryable 1)
      (string-concat code "error")
      "")))
