(ns kotoba.http.bounds
  (:export [http_post_bounds_ok]))

(defn http_post_bounds_ok
  [url-len :i64 headers-n :i64 body-len :i64 timeout-ms :i64]
  :i64
  (if (or (<= url-len 0) (> url-len 4096))
    -1
    (if (or (< headers-n 0) (> headers-n 32))
      -2
      (if (or (< body-len 0) (> body-len 65536))
        -3
        (if (or (< timeout-ms 1) (> timeout-ms 30000))
          -4
          0)))))
