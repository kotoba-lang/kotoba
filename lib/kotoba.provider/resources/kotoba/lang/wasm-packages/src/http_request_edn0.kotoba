(ns kotoba.http.request-edn0
  (:export [http_request_edn0]))

;; T8.3 0-header request EDN reject-path (ADR 0219). Composition on edn_quoted.
;; Body is admission skeleton; Canonical WAT owns dual scan, timeout ≥ 0, and
;; i64 decimal. Multi-header / full multi-export still open.

(defn http_request_edn0
  [url :string body :string timeout-ms :i64]
  :string
  (if (< timeout-ms 0)
    ""
    (string-concat "{:url \""
                   (string-concat url
                                  (string-concat "\" :headers [] :body \""
                                                 (string-concat body
                                                                (string-concat "\" :timeout-ms "
                                                                               (string-concat "0}"))))))))
