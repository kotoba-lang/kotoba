(ns kotoba.secret.request-edn
  ;; T8.3 Component twin of ADR 0236 (policy export only; live main stays wasm32).
  (:export [secret_request_edn]))

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn secret_request_edn
  [name :string]
  :string
  (if (or (= (string-length name) 0)
          (= (has-forbidden name) 1)
          (> (string-length name) 128))
    ""
    (string-concat "{:name \""
                   (string-concat name "\"}"))))
