(ns kotoba.http.edn-request
  (:export [http_request_edn]))

;; T8.3 multi-ns reject-path request slice (ADR 0230). Admission skeleton;
;; Canonical WAT owns dual scan / headers shape / timeout decimal.

(defn http_request_edn
  [url :string headers :string body :string timeout :i64]
  :string
  (if (< timeout 0)
    ""
    (string-concat url (string-concat headers (string-concat body "[]")))))
