(ns kotoba.http.edn-result
  (:export [http_result_ok_edn http_result_err_edn]))

;; T8.3 multi-ns reject-path result arms (ADR 0230). Admission skeletons;
;; Canonical WAT owns status decimal / body scan / retryable gate.

(defn http_result_ok_edn
  [status :i64 headers :string body :string]
  :string
  (if (< status 0)
    ""
    (if (> status 999)
      ""
      (string-concat headers (string-concat body "ok")))))

(defn http_result_err_edn
  [code :string retryable :i64]
  :string
  (if (= retryable 0)
    (string-concat code "error")
    (if (= retryable 1)
      (string-concat code "error")
      "")))
