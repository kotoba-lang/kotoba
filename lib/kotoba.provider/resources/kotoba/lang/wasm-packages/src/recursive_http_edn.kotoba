(ns kotoba.edn.recursive-http
  ;; T8.3 / W4 second ops slice ADR 0247: recursive nested EDN ADT for
  ;; HTTP kit :request and :result identity. Builds on ADR 0246 atom|pair
  ;; spine. Request/result maps are right-nested pair chains of
  ;; preformatted entry atoms (keeps ADT depth ≤8); headers list reuses
  ;; pair spine + bracket wrap. Dual quote/backslash reject.
  ;; Does NOT alone flip wasm-aot :implemented (nested records in variants
  ;; + host I/O still open).
  (:schemas {:edn/node [:variant :edn/node
                         [[:atom :string]
                          [:pair [:vector [[:ref :edn/node]
                                           [:ref :edn/node]]]]]]})
  (:export [edn_atom
            edn_pair
            edn_print
            headers_list_edn
            request_tree_edn
            result_ok_tree_edn
            result_err_tree_edn
            main]))

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- qstr [s :string] :string
  (string-concat (string-substring "\"x" 0 1)
                 (string-concat s (string-substring "\"x" 0 1))))

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn edn_atom [s :string]
  [:variant :edn/node
    [[:atom :string]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :atom s))

(defn edn_pair
  [l [:variant :edn/node
       [[:atom :string]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   r [:variant :edn/node
       [[:atom :string]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  [:variant :edn/node
    [[:atom :string]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :pair
   (hetero-vector [:vector [[:ref :edn/node] [:ref :edn/node]]] l r)))

(defn edn_print
  [n [:variant :edn/node
       [[:atom :string]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (match-variant n
   [:variant :edn/node
     [[:atom :string]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
    (:atom s s)
    (:pair p
      (string-concat
       (edn_print (nth p 0))
       (string-concat " "
                      (edn_print (nth p 1)))))))

(defn- header-atom [name :string value :string]
  [:variant :edn/node
    [[:atom :string]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (if (or (= (string-length name) 0)
          (= (has-forbidden name) 1)
          (= (has-forbidden value) 1))
    (edn_atom "")
    (edn_atom
     (string-concat "{:name "
                    (string-concat (qstr name)
                                   (string-concat " :value "
                                                  (string-concat (qstr value) "}")))))))

(defn headers_list_edn
  [name1 :string value1 :string name2 :string value2 :string]
  :string
  (let [a (header-atom name1 value1)
        b (header-atom name2 value2)
        body (edn_print (edn_pair a b))]
    (if (or (string=? (edn_print a) "")
            (string=? (edn_print b) ""))
      ""
      (string-concat "[" (string-concat body "]")))))

(defn- entry-atom [k :string v :string]
  [:variant :edn/node
    [[:atom :string]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (edn_atom (string-concat k (string-concat " " v))))

(defn- brace-print
  [n [:variant :edn/node
       [[:atom :string]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (string-concat "{" (string-concat (edn_print n) "}")))

;; Shallow right-spine of entry atoms (depth-safe under ADT limit 8):
;;   {:url "…" :headers […] :body "…" :timeout-ms N}
(defn request_tree_edn
  [url :string body :string timeout :i64 headers-edn :string]
  :string
  (if (or (= (has-forbidden url) 1)
          (= (has-forbidden body) 1)
          (< timeout 0)
          (= (string-length headers-edn) 0))
    ""
    (let [e1 (entry-atom ":url" (qstr url))
          e2 (entry-atom ":headers" headers-edn)
          e3 (entry-atom ":body" (qstr body))
          e4 (entry-atom ":timeout-ms" (nat-str timeout))
          tree (edn_pair e1 (edn_pair e2 (edn_pair e3 e4)))]
      (brace-print tree))))

;;   {:tag :ok :status N :headers […] :body "…"}
(defn result_ok_tree_edn
  [status :i64 body :string headers-edn :string]
  :string
  (if (or (< status 100)
          (> status 599)
          (= (has-forbidden body) 1)
          (= (string-length headers-edn) 0))
    ""
    (let [e1 (entry-atom ":tag" ":ok")
          e2 (entry-atom ":status" (nat-str status))
          e3 (entry-atom ":headers" headers-edn)
          e4 (entry-atom ":body" (qstr body))
          tree (edn_pair e1 (edn_pair e2 (edn_pair e3 e4)))]
      (brace-print tree))))

;;   {:tag :error :code "…" :message "…" :retryable true|false}
(defn result_err_tree_edn
  [code :string message :string retryable :i64]
  :string
  (if (or (= (string-length code) 0)
          (= (has-forbidden code) 1)
          (= (has-forbidden message) 1))
    ""
    (let [e1 (entry-atom ":tag" ":error")
          e2 (entry-atom ":code" (qstr code))
          e3 (entry-atom ":message" (qstr message))
          e4 (entry-atom ":retryable" (if (= retryable 1) "true" "false"))
          tree (edn_pair e1 (edn_pair e2 (edn_pair e3 e4)))]
      (brace-print tree))))

(defn main [] :i64
  (let [hdrs (headers_list_edn "Accept" "text/plain" "Host" "ex.com")
        bad-hdrs (headers_list_edn "" "v" "Host" "ex.com")
        req (request_tree_edn "https://ex.com/a" "hi" 30 hdrs)
        bad-req (request_tree_edn "https://ex.com" "x" 30 bad-hdrs)
        ok (result_ok_tree_edn 200 "ok" hdrs)
        bad-ok (result_ok_tree_edn 99 "ok" hdrs)
        err (result_err_tree_edn "timeout" "slow" 1)
        bad-err (result_err_tree_edn "" "m" 0)
        good-req (if (string-contains? req ":url")
                   (if (string-contains? req "https://ex.com/a")
                     (if (string-contains? req ":headers")
                       (if (string-contains? req "Accept")
                         (if (string-contains? req ":timeout-ms")
                           (if (string-contains? req "30") 1 0)
                           0)
                         0)
                       0)
                     0)
                   0)
        good-ok (if (string-contains? ok ":tag")
                  (if (string-contains? ok ":ok")
                    (if (string-contains? ok "200")
                      (if (string-contains? ok "Accept") 1 0)
                      0)
                    0)
                  0)
        good-err (if (string-contains? err ":error")
                   (if (string-contains? err "timeout")
                     (if (string-contains? err "true") 1 0)
                     0)
                   0)
        ok-bad-1 (if (= (string-length bad-req) 0) 1 0)
        ok-bad-2 (if (= (string-length bad-ok) 0) 1 0)
        ok-bad-3 (if (= (string-length bad-err) 0) 1 0)
        ok-bad (if (= ok-bad-1 1)
                 (if (= ok-bad-2 1)
                   (if (= ok-bad-3 1) 1 0)
                   0)
                 0)]
    (if (= good-req 1)
      (if (= good-ok 1)
        (if (= good-err 1)
          (if (= ok-bad 1) -2402 -1)
          -1)
        -1)
      -1)))
