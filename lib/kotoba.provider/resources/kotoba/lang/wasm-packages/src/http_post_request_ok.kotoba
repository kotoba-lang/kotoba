(ns kotoba.http.request-ok
  (:export [http_post_request_ok main]))

;; Typed-string single-call http post request policy (ADR 0186).
;; Composes https scheme (0182) + numeric bounds (0171) over real strings.
;; Requires kotoba:typed host. Not pure Component.
;; Codes:
;;   -1 url empty
;;   -2 url >4096
;;   -3 not https://
;;   -4 headers-n not in [0,32]
;;   -5 body length not in [0,65536]
;;   -6 timeout-ms not in [1,30000]
;;    0 ok

(defn http_post_request_ok
  [url :string headers-n :i64 body :string timeout-ms :i64]
  :i64
  (let [un (string-length url)
        bn (string-length body)]
    (if (<= un 0)
      -1
      (if (> un 4096)
        -2
        (if (or (< un 8)
                (not (string=? (string-substring url 0 8) "https://")))
          -3
          (if (or (< headers-n 0) (> headers-n 32))
            -4
            (if (or (< bn 0) (> bn 65536))
              -5
              (if (or (< timeout-ms 1) (> timeout-ms 30000))
                -6
                0))))))))

;; Live vector packs six sample outcomes into one i64:
;; ok=0 empty=-1 http=-3 headers=-4 body ok timeout=-6 →
;; 0*100000 + (-1)*10000 + (-3)*1000 + (-4)*100 + 0*10 + (-6) = -13406
(defn main []
  :i64
  (let [a (http_post_request_ok "https://x" 1 "{}" 1000)
        b (http_post_request_ok "" 1 "{}" 1000)
        c (http_post_request_ok "http://x" 1 "{}" 1000)
        d (http_post_request_ok "https://x" 40 "{}" 1000)
        e (http_post_request_ok "https://x" 1 "{}" 1000)
        f (http_post_request_ok "https://x" 1 "{}" 0)]
    (+ (* a 100000) (* b 10000) (* c 1000) (* d 100) (* e 10) f)))
