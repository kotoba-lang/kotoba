(ns kotoba.http.request-edn
  (:export [edn_quoted http_header_edn
            headers_edn_empty headers_edn_append headers_edn_has_name
            http_request_edn0 http_request_edn
            http_result_ok_edn http_result_err_edn
            main]))

;; T8.3 nested EDN encode -- fixed-depth (ADR 0209) + multi-header append +
;; result arms (ADR 0210) + name uniqueness scan (ADR 0211).
;; No recursive guest ADT / real set type (W4). Uniqueness is substring scan for
;; :name "…" markers in the host-sequenced vector. Rejects quote/backslash.
;; max-params <=5; pure strings; no kotoba:typed.

(defn has-dq?
  [s :string i :i64 n :i64]
  :bool
  (if (>= i n)
    false
    (if (string=? (string-substring s i (+ i 1)) "\"")
      true
      (has-dq? s (+ i 1) n))))

(defn has-bs?
  [s :string i :i64 n :i64]
  :bool
  (if (>= i n)
    false
    (if (string=? (string-substring s i (+ i 1)) "\\")
      true
      (has-bs? s (+ i 1) n))))

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

(defn edn_quoted
  [s :string]
  :string
  (let [n (string-byte-length s)]
    (if (or (has-dq? s 0 n) (has-bs? s 0 n))
      ""
      (string-concat "\"" (string-concat s "\"")))))

(defn http_header_edn
  [name :string value :string]
  :string
  (let [qn (edn_quoted name)
        qv (edn_quoted value)]
    (if (or (= (string-byte-length qn) 0)
            (= (string-byte-length qv) 0))
      ""
      (string-concat "{:name "
                     (string-concat qn
                                    (string-concat " :value "
                                                   (string-concat qv "}")))))))

(defn headers_edn_empty [] :string
  "[]")

(defn has-prefix-at?
  [s :string prefix :string i :i64]
  :bool
  (let [n (string-byte-length s)
        p (string-byte-length prefix)]
    (if (> (+ i p) n)
      false
      (if (string=? (string-substring s i (+ i p)) prefix)
        true
        false))))

(defn contains-str?
  [s :string needle :string i :i64]
  :bool
  (let [n (string-byte-length s)
        p (string-byte-length needle)]
    (if (or (= p 0) (> (+ i p) n))
      false
      (if (has-prefix-at? s needle i)
        true
        (contains-str? s needle (+ i 1))))))

(defn name_marker
  [name :string]
  :string
  ;; Marker unique to our header map encoding: :name "Name"
  (let [qn (edn_quoted name)]
    (if (= (string-byte-length qn) 0)
      ""
      (string-concat ":name " qn))))

(defn headers_edn_has_name
  [acc :string name :string]
  :bool
  ;; Substring scan for :name "…" — not a true set (W4). Case-sensitive.
  (let [m (name_marker name)]
    (if (= (string-byte-length m) 0)
      false
      (contains-str? acc m 0))))

(defn headers_edn_append
  [acc :string name :string value :string]
  :string
  ;; Host-sequenced multi-header fold. acc is "[]" or "[{...} ...]".
  ;; Duplicate name (headers_edn_has_name) => "".
  (let [h (http_header_edn name value)
        an (string-byte-length acc)
        hn (string-byte-length h)]
    (if (or (= hn 0) (= an 0))
      ""
      (if (headers_edn_has_name acc name)
        ""
        (if (string=? acc "[]")
          (string-concat "[" (string-concat h "]"))
          (let [body (string-substring acc 0 (- an 1))]
            (string-concat body
                           (string-concat " "
                                          (string-concat h "]")))))))))

(defn headers_edn_shape_ok
  [headers :string]
  :bool
  (let [n (string-byte-length headers)]
    (if (< n 2)
      false
      (if (string=? (string-substring headers 0 1) "[")
        (if (string=? (string-substring headers (- n 1) n) "]")
          true
          false)
        false))))

(defn http_request_edn
  [url :string headers :string body :string timeout-ms :i64]
  :string
  (let [qu (edn_quoted url)
        qb (edn_quoted body)]
    (if (or (= (string-byte-length qu) 0)
            (= (string-byte-length qb) 0)
            (< timeout-ms 0))
      ""
      (if (headers_edn_shape_ok headers)
        (string-concat "{:url "
                       (string-concat qu
                                      (string-concat " :headers "
                                                     (string-concat headers
                                                                    (string-concat " :body "
                                                                                   (string-concat qb
                                                                                                  (string-concat " :timeout-ms "
                                                                                                                 (string-concat (i64-str timeout-ms) "}"))))))))
        ""))))

(defn http_request_edn0
  [url :string body :string timeout-ms :i64]
  :string
  (http_request_edn url (headers_edn_empty) body timeout-ms))

(defn http_result_ok_edn
  [status :i64 headers :string body :string]
  :string
  (let [qb (edn_quoted body)]
    (if (or (= (string-byte-length qb) 0)
            (< status 0)
            (> status 999))
      ""
      (if (headers_edn_shape_ok headers)
        (string-concat "{:tag :ok :status "
                       (string-concat (i64-str status)
                                      (string-concat " :headers "
                                                     (string-concat headers
                                                                    (string-concat " :body "
                                                                                   (string-concat qb "}"))))))
        ""))))

(defn http_result_err_edn
  [code :string retryable :i64]
  :string
  ;; retryable is 0 or 1 only
  (let [qc (edn_quoted code)]
    (if (= (string-byte-length qc) 0)
      ""
      (if (= retryable 0)
        (string-concat "{:tag :error :code "
                       (string-concat qc " :retryable false}"))
        (if (= retryable 1)
          (string-concat "{:tag :error :code "
                         (string-concat qc " :retryable true}"))
          "")))))

;; Live main length fingerprint (i64):
;; a=header ok, b=header reject(0), c=request0, d=bad-timeout(0),
;; e=2-header vector, f=result-ok, g=result-err, h=bad-retry(0),
;; i=duplicate-name append (0)
(defn main []
  :i64
  (let [a (string-byte-length (http_header_edn "X-Ok" "yes"))
        b (string-byte-length (http_header_edn "X-Ok" "a\"b"))
        c (string-byte-length (http_request_edn0 "https://x" "{}" 1000))
        d (string-byte-length (http_request_edn0 "https://x" "{}" -1))
        h2 (headers_edn_append
            (headers_edn_append (headers_edn_empty) "A" "1")
            "B" "2")
        e (string-byte-length h2)
        f (string-byte-length (http_result_ok_edn 200 (headers_edn_empty) "ok"))
        g (string-byte-length (http_result_err_edn "timeout" 1))
        h (string-byte-length (http_result_err_edn "timeout" 2))
        i (string-byte-length
           (headers_edn_append
            (headers_edn_append (headers_edn_empty) "A" "1")
            "A" "2"))]
    (+ (* a 1000000000)
       (+ (* b 10000000)
          (+ (* c 100000)
             (+ (* d 10000)
                (+ (* e 1000)
                   (+ (* f 100)
                      (+ (* g 10)
                         (+ h i))))))))))
