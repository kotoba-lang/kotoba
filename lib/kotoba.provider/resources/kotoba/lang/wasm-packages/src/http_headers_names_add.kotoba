(ns kotoba.http.headers-names-add
  (:export [headers_names_add]))

;; T8.3 ADR 0225: Component twin of true-set header-name uniqueness.
;; Acc is EDN vector of quoted names ([] / ["Host" "Accept"]).
;; Admission skeleton only — Canonical WAT :headers-names-add owns
;; element-bound exact equality (not :name "…" substring scan, no
;; kotoba:typed). Complements ADR 0223 wasm32 typed-set + ADR 0224 pure
;; EDN-append-set. W4 recursive ADT open; wasm-aot stays :partial.

(defn headers_names_add
  [acc :string name :string]
  :string
  (if (= (string-byte-length acc) 0)
    ""
    (if (string=? acc "[]")
      (string-concat "["
                     (string-concat "\""
                                    (string-concat name "\"]")))
      (string-concat acc
                     (string-concat " "
                                    (string-concat "\""
                                                   (string-concat name
                                                                  "\"]")))))))
