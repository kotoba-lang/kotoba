(ns kotoba.process.walk
  (:export [process_spawn_begin process_spawn_arg process_spawn_end]))

;; Pure multi-step process spawn policy (ADR 0182).
;; Composes process-v1 :limits into a host-walk over argv lengths.
;;
;; process_spawn_begin(argc) → remaining | -1 empty | -2 argc>32
;; process_spawn_arg(state, arg_len) → remaining-1 | sticky err
;;   -5 unexpected arg (state==0), -6 arg_len not in [1,4096]
;; process_spawn_end(state, max_out, timeout-ms) → 0 | sticky | -3 max_out | -4 timeout
;;   requires state==0 (all argc args supplied)
;;
;; Single-shot process_spawn_bounds_ok (ADR 0172) retained (argc/max/timeout only).

(defn process_spawn_begin
  [argc :i64]
  :i64
  (if (<= argc 0)
    -1
    (if (> argc 32)
      -2
      argc)))

(defn process_spawn_arg
  [state :i64 arg-len :i64]
  :i64
  (if (< state 0)
    state
    (if (= state 0)
      -5
      (if (or (<= arg-len 0) (> arg-len 4096))
        -6
        (- state 1)))))

(defn process_spawn_end
  [state :i64 max-out :i64 timeout-ms :i64]
  :i64
  (if (< state 0)
    state
    (if (not= state 0)
      -7
      (if (or (<= max-out 0) (> max-out 65536))
        -3
        (if (or (<= timeout-ms 0) (> timeout-ms 600000))
          -4
          0)))))
