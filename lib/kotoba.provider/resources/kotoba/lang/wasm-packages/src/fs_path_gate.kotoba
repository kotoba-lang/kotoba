(ns kotoba.fs.gate
  (:export [fs_path_first_ok fs_path_step fs_path_finish]))

;; Pure path state-machine gates for scoped-fs (ADR 0177).
;; Host walks path bytes; packed one-shot fs_path_ok hand WAT retained.
;;
;; state = prev_slash * 4 + dots   (prev 0|1, dots 0..3)
;; Initial walk state after first-char check: 4 (prev_slash=1, dots=0)
;; Errors match hand WAT: -3 NUL, -4 backslash, -5 abs /, -6 home ~,
;;   -7 "." or ".." segment (at slash or finish).

(defn fs_path_first_ok
  [c :i64]
  :i64
  (if (= c 47)
    -5
    (if (= c 126)
      -6
      0)))

(defn fs_path_step
  [state :i64 c :i64]
  :i64
  (let [prev (quot state 4)
        dots (- state (* prev 4))]
    (if (= c 0)
      -3
      (if (= c 92)
        -4
        (if (= c 47)
          (if (or (= dots 1) (= dots 2))
            -7
            4)
          (if (= prev 1)
            (if (= c 46) 1 3)
            (if (= dots 1)
              (if (= c 46) 2 3)
              (if (= dots 2)
                3
                dots))))))))

(defn fs_path_finish
  [state :i64]
  :i64
  (let [prev (quot state 4)
        dots (- state (* prev 4))]
    (if (or (= dots 1) (= dots 2))
      -7
      0)))
