(ns kotoba.http.result-pack
  (:export [http_result_begin http_result_status http_result_headers
            http_result_body http_result_code http_result_message
            http_result_retryable http_result_end main]))

;; Typed-string HTTP **result packing walk** (ADR 0192).
;; Host sequences either :ok or :error arm after variant tag — composes
;; response_ok (0190) + error_ok/arm (0191) without nested EDN in guest
;; memory (W4 still open). Requires kotoba:typed. max-params ≤5.
;;
;; States (success path):
;;   ok:    1=need-status 2=need-headers 3=need-body 4=need-end
;;   error: 11=need-code 12=need-message 13=need-retryable 14=need-end
;; sticky negative = prior error
;;
;; Codes:
;;   begin: -1 arm∉{0,1}
;;   status: -2 status∉[100,599]; -10 wrong-phase
;;   headers: -3 n∉[0,32]; -10
;;   body: -4 len∉[0,65536]; -10
;;   code: -5 empty; -6 >128; -7 bad char; -10
;;   message: -8 >65536; -10
;;   retryable: -9 ∉{0,1}; -10
;;   end: -11 incomplete; prior; 0 ok

(defn- code-char-ok?
  [c :i64]
  :i64
  (if (or (and (>= c 48) (<= c 57))
          (and (>= c 65) (<= c 90))
          (and (>= c 97) (<= c 122))
          (= c 47) (= c 58) (= c 46) (= c 45) (= c 95))
    1
    0))

(defn- code-ok
  [code :string]
  :i64
  (let [n (string-length code)]
    (if (<= n 0)
      -5
      (if (> n 128)
        -6
        (loop [i 0]
          (if (>= i n)
            0
            (let [c (string-code-point-at code i)]
              (if (= (code-char-ok? c) 0)
                -7
                (recur (+ i 1))))))))))

(defn http_result_begin
  [arm :i64]
  :i64
  (if (= arm 0)
    1
    (if (= arm 1)
      11
      -1)))

(defn http_result_status
  [state :i64 status :i64]
  :i64
  (if (< state 0)
    state
    (if (not= state 1)
      -10
      (if (or (< status 100) (> status 599))
        -2
        2))))

(defn http_result_headers
  [state :i64 n :i64]
  :i64
  (if (< state 0)
    state
    (if (not= state 2)
      -10
      (if (or (< n 0) (> n 32))
        -3
        3))))

(defn http_result_body
  [state :i64 body :string]
  :i64
  (if (< state 0)
    state
    (if (not= state 3)
      -10
      (let [bn (string-length body)]
        (if (or (< bn 0) (> bn 65536))
          -4
          4)))))

(defn http_result_code
  [state :i64 code :string]
  :i64
  (if (< state 0)
    state
    (if (not= state 11)
      -10
      (let [cr (code-ok code)]
        (if (not= cr 0)
          cr
          12)))))

(defn http_result_message
  [state :i64 message :string]
  :i64
  (if (< state 0)
    state
    (if (not= state 12)
      -10
      (if (> (string-length message) 65536)
        -8
        13))))

(defn http_result_retryable
  [state :i64 r :i64]
  :i64
  (if (< state 0)
    state
    (if (not= state 13)
      -10
      (if (or (< r 0) (> r 1))
        -9
        14))))

(defn http_result_end
  [state :i64]
  :i64
  (if (< state 0)
    state
    (if (or (= state 4) (= state 14))
      0
      -11)))

;; Live vector (6 samples):
;; ok-pack=0, bad-arm=-1, bad-status=-2, err-pack=0, empty-code=-5, incomplete=-11
;; 0*100000 + (-1)*10000 + (-2)*1000 + 0*100 + (-5)*10 + (-11) = -12061
(defn main []
  :i64
  (let [a (http_result_end
           (http_result_body
            (http_result_headers
             (http_result_status (http_result_begin 0) 200)
             1)
            "ok"))
        b (http_result_begin 3)
        c (http_result_status (http_result_begin 0) 42)
        d (http_result_end
           (http_result_retryable
            (http_result_message
             (http_result_code (http_result_begin 1) "http/transport")
             "failed")
            0))
        e (http_result_code (http_result_begin 1) "")
        f (http_result_end (http_result_begin 0))]
    (+ (* a 100000) (* b 10000) (* c 1000) (* d 100) (* e 10) f)))
