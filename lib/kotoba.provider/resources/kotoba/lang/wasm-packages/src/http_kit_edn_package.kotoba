(ns kotoba.http.kit-edn-package
  ;; T8.3 ADR 0242/0276: multi-export HTTP kit pure EDN. ADR 0276 moves
  ;; its record surface from raw ABI primitives to nominal Kotoba records.
  ;; Folds ADR 0234 full request EDN + ADR 0235 result-variant EDN into one
  ;; pure multi-export surface for hosts. Fixed-depth / bounded sets only —
  ;; not W4 recursive nested EDN ADT. wasm-aot stays :partial.
  (:export [http_req_begin
            http_req_add_header
            http_req_code
            http_req_count
            http_req_edn
            http_res_ok_begin
            http_res_ok_add_header
            http_res_ok_code
            http_res_ok_count
            http_res_ok_edn
            http_res_err_edn
            main]))

(defrecord Header [name :string value :string])

(defrecord HttpRequest
  [url :string
   headers [:set [:ref :kotoba.http.kit-edn-package/Header]]
   names [:set :string]
   body :string
   timeout :i64
   code :i64])

(defrecord HttpResponse
  [status :i64
   headers [:set [:ref :kotoba.http.kit-edn-package/Header]]
   names [:set :string]
   body :string
   code :i64])

(def header-set-type [:set [:ref :kotoba.http.kit-edn-package/Header]])

;; Sticky codes: 0 ok; -1 empty name; -2 status OOB; -3 forbidden; -4 full; -9 dup

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn- header-map-edn
  [h [:ref :kotoba.http.kit-edn-package/Header]]
  :string
  (string-concat "{:name \""
                 (string-concat (:name h)
                                (string-concat "\" :value \""
                                               (string-concat (:value h) "\"}")))))

(defn- fold-headers-edn
  [headers [:set [:ref :kotoba.http.kit-edn-package/Header]]
   n :i64 i :i64 acc :string]
  :string
  (if (>= i n)
    acc
    (let [h (typed-set-nth header-set-type headers i)
          piece (header-map-edn h)
          acc2 (if (string=? acc "[]")
                 (string-concat "[" (string-concat piece "]"))
                 (string-concat
                  (string-substring acc 0 (- (string-length acc) 1))
                  (string-concat " " (string-concat piece "]"))))]
      (fold-headers-edn headers n (+ i 1) acc2))))

;; ---- request (ADR 0234 surface) ----

(defn http_req_begin
  [url :string body :string timeout :i64]
  [:ref :kotoba.http.kit-edn-package/HttpRequest]
  (if (or (= (has-forbidden url) 1)
          (= (has-forbidden body) 1)
          (< timeout 0))
    (map->HttpRequest
     {:url ""
      :headers (typed-set-new header-set-type)
      :names (typed-set-new [:set :string])
      :body ""
      :timeout 0
      :code -3})
    (map->HttpRequest
     {:url url
      :headers (typed-set-new header-set-type)
      :names (typed-set-new [:set :string])
      :body body
      :timeout timeout
      :code 0})))

(defn http_req_code
  [st [:ref :kotoba.http.kit-edn-package/HttpRequest]]
  :i64
  (:code st))

(defn http_req_count
  [st [:ref :kotoba.http.kit-edn-package/HttpRequest]]
  :i64
  (typed-set-count header-set-type (:headers st)))

(defn http_req_add_header
  [st [:ref :kotoba.http.kit-edn-package/HttpRequest]
   name :string value :string]
  [:ref :kotoba.http.kit-edn-package/HttpRequest]
  (let [{:keys [url headers names body timeout code]} st]
    (if (not= code 0)
      (map->HttpRequest {:url url :headers headers :names names
                         :body body :timeout timeout :code code})
      (if (= (string-length name) 0)
        (map->HttpRequest {:url url :headers headers :names names
                           :body body :timeout timeout :code -1})
        (if (or (= (has-forbidden name) 1) (= (has-forbidden value) 1))
          (map->HttpRequest {:url url :headers headers :names names
                             :body body :timeout timeout :code -3})
          (if (typed-set-contains [:set :string] names name)
            (map->HttpRequest {:url url :headers headers :names names
                               :body body :timeout timeout :code -9})
            (if (>= (typed-set-count header-set-type headers) 32)
              (map->HttpRequest {:url url :headers headers :names names
                                 :body body :timeout timeout :code -4})
              (let [h (->Header name value)
                    headers2 (typed-set-conj header-set-type headers h)
                    names2 (typed-set-conj [:set :string] names name)]
                (map->HttpRequest {:url url :headers headers2 :names names2
                                   :body body :timeout timeout :code 0})))))))))

(defn http_req_edn
  [st [:ref :kotoba.http.kit-edn-package/HttpRequest]]
  :string
  (let [{:keys [code url body timeout headers]} st
        n (typed-set-count header-set-type headers)]
    (if (not= code 0)
      ""
      (let [hv (fold-headers-edn headers n 0 "[]")]
        (string-concat "{:url \""
                       (string-concat url
                                      (string-concat "\" :headers "
                                                     (string-concat hv
                                                                    (string-concat " :body \""
                                                                                   (string-concat body
                                                                                                  (string-concat "\" :timeout-ms "
                                                                                                                 (string-concat (nat-str timeout) "}"))))))))))))

;; ---- result (ADR 0235 surface) ----

(defn http_res_ok_begin
  [status :i64 body :string]
  [:ref :kotoba.http.kit-edn-package/HttpResponse]
  (if (or (< status 0) (> status 999) (= (has-forbidden body) 1))
    (map->HttpResponse
     {:status 0
      :headers (typed-set-new header-set-type)
      :names (typed-set-new [:set :string])
      :body ""
      :code -2})
    (map->HttpResponse
     {:status status
      :headers (typed-set-new header-set-type)
      :names (typed-set-new [:set :string])
      :body body
      :code 0})))

(defn http_res_ok_code
  [st [:ref :kotoba.http.kit-edn-package/HttpResponse]]
  :i64
  (:code st))

(defn http_res_ok_count
  [st [:ref :kotoba.http.kit-edn-package/HttpResponse]]
  :i64
  (typed-set-count header-set-type (:headers st)))

(defn http_res_ok_add_header
  [st [:ref :kotoba.http.kit-edn-package/HttpResponse]
   name :string value :string]
  [:ref :kotoba.http.kit-edn-package/HttpResponse]
  (let [{:keys [status headers names body code]} st]
    (if (not= code 0)
      (map->HttpResponse {:status status :headers headers :names names
                          :body body :code code})
      (if (= (string-length name) 0)
        (map->HttpResponse {:status status :headers headers :names names
                            :body body :code -1})
        (if (or (= (has-forbidden name) 1) (= (has-forbidden value) 1))
          (map->HttpResponse {:status status :headers headers :names names
                              :body body :code -3})
          (if (typed-set-contains [:set :string] names name)
            (map->HttpResponse {:status status :headers headers :names names
                                :body body :code -9})
            (if (>= (typed-set-count header-set-type headers) 32)
              (map->HttpResponse {:status status :headers headers :names names
                                  :body body :code -4})
              (let [h (->Header name value)
                    headers2 (typed-set-conj header-set-type headers h)
                    names2 (typed-set-conj [:set :string] names name)]
                (map->HttpResponse {:status status :headers headers2 :names names2
                                    :body body :code 0})))))))))

(defn http_res_ok_edn
  [st [:ref :kotoba.http.kit-edn-package/HttpResponse]]
  :string
  (let [{:keys [code status body headers]} st
        n (typed-set-count header-set-type headers)]
    (if (not= code 0)
      ""
      (let [hv (fold-headers-edn headers n 0 "[]")]
        (string-concat "{:tag :ok :status "
                       (string-concat (nat-str status)
                                      (string-concat " :headers "
                                                     (string-concat hv
                                                                    (string-concat " :body \""
                                                                                   (string-concat body "\"}"))))))))))

(defn http_res_err_edn
  [code :string message :string retryable :i64]
  :string
  (if (or (= (string-length code) 0)
          (= (has-forbidden code) 1)
          (= (has-forbidden message) 1))
    ""
    (if (= retryable 0)
      (string-concat "{:tag :error :code \""
                     (string-concat code
                                    (string-concat "\" :message \""
                                                   (string-concat message
                                                                  "\" :retryable false}"))))
      (if (= retryable 1)
        (string-concat "{:tag :error :code \""
                       (string-concat code
                                      (string-concat "\" :message \""
                                                     (string-concat message
                                                                    "\" :retryable true}"))))
        ""))))

;; main → -9242: request EDN + result ok EDN + err EDN + request dup -9 + res bad status
(defn main [] :i64
  (let [r0 (http_req_begin "https://x.test" "{}" 1000)
        r1 (http_req_add_header r0 "Host" "ex.com")
        r2 (http_req_add_header r1 "Accept" "*/*")
        req-edn (http_req_edn r2)
        r3 (http_req_add_header r2 "Host" "other")
        rc (http_req_code r3)
        rn (http_req_count r2)
        s0 (http_res_ok_begin 200 "ok")
        s1 (http_res_ok_add_header s0 "Content-Type" "text/plain")
        s2 (http_res_ok_add_header s1 "Server" "kotoba")
        ok-edn (http_res_ok_edn s2)
        err-edn (http_res_err_edn "timeout" "upstream" 1)
        bad (http_res_ok_begin 1000 "x")
        bc (http_res_ok_code bad)
        ok (if (string-contains? req-edn "https://x.test")
             (if (string-contains? req-edn "timeout-ms")
               (if (string-contains? ok-edn ":tag :ok")
                 (if (string-contains? ok-edn "Content-Type")
                   (if (string-contains? err-edn "retryable true") 1 0)
                   0)
                 0)
               0)
             0)]
    (if (and (= rc -9) (= rn 2) (= bc -2) (= ok 1))
      -9242
      -1)))
