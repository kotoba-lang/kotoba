(ns kotoba.http.url-ok
  (:export [http_url_ok main]))

;; Typed-string single-call http URL policy (ADR 0182).
;; Enforces http-v1 :schemes #{:https} and :limits :url-bytes 4096.
;; Requires kotoba:typed host. Not pure Component.
;; Codes: -1 empty, -2 >4096, -3 not https:// prefix, 0 ok.

(defn http_url_ok
  [url :string]
  :i64
  (let [n (string-length url)]
    (if (<= n 0)
      -1
      (if (> n 4096)
        -2
        (if (< n 8)
          -3
          (if (string=? (string-substring url 0 8) "https://")
            0
            -3))))))

;; Live vector: ok=0, empty=-1, http=-3, ok2=0 → 0*1000 + (-1)*100 + (-3)*10 + 0 = -130
(defn main []
  :i64
  (let [a (http_url_ok "https://x")
        b (http_url_ok "")
        c (http_url_ok "http://x")
        d (http_url_ok "https://ok.example/a")]
    (+ (* a 1000) (* b 100) (* c 10) d)))
