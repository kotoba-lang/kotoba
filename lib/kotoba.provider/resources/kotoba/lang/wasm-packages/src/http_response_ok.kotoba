(ns kotoba.http.response-ok
  (:export [http_status_ok http_response_ok main]))

;; Typed-string HTTP **response surface** policy (ADR 0190).
;; Complements request_ok (0186) + header set packing (0189) toward result
;; EDN codec AOT. Validates status range + headers-n + body string length.
;; Requires kotoba:typed for body. Does not pack full result variant / error.
;;
;; http_status_ok(status):
;;   -1 status ∉ [100,599]
;;    0 ok
;;
;; http_response_ok(status, headers-n, body):
;;   -1 status ∉ [100,599]
;;   -2 headers-n ∉ [0,32]
;;   -3 body length ∉ [0,65536]
;;    0 ok
;;
;; Host still owns I/O; uniqueness of header names still host/W4.

(defn http_status_ok
  [status :i64]
  :i64
  (if (or (< status 100) (> status 599))
    -1
    0))

(defn http_response_ok
  [status :i64 headers-n :i64 body :string]
  :i64
  (let [bn (string-length body)]
    (if (or (< status 100) (> status 599))
      -1
      (if (or (< headers-n 0) (> headers-n 32))
        -2
        (if (or (< bn 0) (> bn 65536))
          -3
          0)))))

;; Live vector:
;; status-ok=0, status-bad=-1, response-ok=0, response-status=-1, response-headers=-2
;; 0*10000 + (-1)*1000 + 0*100 + (-1)*10 + (-2) = -1012
(defn main []
  :i64
  (let [a (http_status_ok 200)
        b (http_status_ok 99)
        c (http_response_ok 200 1 "ok")
        d (http_response_ok 42 0 "")
        e (http_response_ok 200 40 "")]
    (+ (* a 10000) (* b 1000) (* c 100) (* d 10) e)))
