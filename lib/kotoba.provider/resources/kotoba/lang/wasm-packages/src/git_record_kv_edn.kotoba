(ns kotoba.git.record-kv-edn
  ;; T8.3 / W4 git kit recursive ADT slice ADR 0253.
  ;; Ports nominal EdnKeyValue recursive EDN to git request/reply
  ;; (closes git "W4 open" residual). Args multi-step fold remains on
  ;; fixed-depth package 0240; this surface takes prebuilt args-edn string.
  ;; OS git binary stays host-injected; does NOT flip wasm-aot.
  (:schemas {:edn/node [:variant :edn/node
                         [[:atom :string]
                          [:entry [:ref :kotoba.git.record-kv-edn/EdnKeyValue]]
                          [:pair [:vector [[:ref :edn/node]
                                           [:ref :edn/node]]]]]]})
  (:export [edn_atom
            edn_entry
            edn_pair
            edn_print
            git_req_rec_kv_edn
            git_reply_ok_rec_kv_edn
            git_reply_error_rec_kv_edn
            main]))

(defrecord EdnKeyValue [k :string v :string])

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- qstr [s :string] :string
  (string-concat (string-substring "\"x" 0 1)
                 (string-concat s (string-substring "\"x" 0 1))))

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn edn_atom [s :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.git.record-kv-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.git.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :atom s))

(defn edn_entry [k :string v :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.git.record-kv-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.git.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :entry
   (->EdnKeyValue k v)))

(defn edn_pair
  [l [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.git.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   r [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.git.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.git.record-kv-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.git.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :pair
   (hetero-vector [:vector [[:ref :edn/node] [:ref :edn/node]]] l r)))

(defn edn_print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.git.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (match-variant n
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.git.record-kv-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
    (:atom s s)
    (:entry r
      (string-concat
       (:k r)
       (string-concat " "
                      (:v r))))
    (:pair p
      (string-concat
       (edn_print (nth p 0))
       (string-concat " "
                      (edn_print (nth p 1)))))))

(defn- brace-print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.git.record-kv-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (string-concat "{" (string-concat (edn_print n) "}")))

;; request: {:args […] :max-stdout-bytes N :timeout-ms N}
;; args-edn is prebuilt (e.g. "[\"status\" \"--short\"]"); bounds match 0240.
(defn git_req_rec_kv_edn
  [args-edn :string max-stdout :i64 timeout-ms :i64]
  :string
  (if (or (= (string-length args-edn) 0)
          (not (string-contains? args-edn "["))
          (<= max-stdout 0)
          (> max-stdout 65536)
          (<= timeout-ms 0)
          (> timeout-ms 600000))
    ""
    (brace-print
     (edn_pair (edn_entry ":args" args-edn)
               (edn_pair (edn_entry ":max-stdout-bytes" (nat-str max-stdout))
                         (edn_entry ":timeout-ms" (nat-str timeout-ms)))))))

;; reply ok: {:tag :ok :exit N :stdout "…" :stderr "…"}
(defn git_reply_ok_rec_kv_edn
  [exit :i64 stdout :string stderr :string]
  :string
  (if (or (< exit 0)
          (= (has-forbidden stdout) 1)
          (= (has-forbidden stderr) 1))
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":ok")
               (edn_pair (edn_entry ":exit" (nat-str exit))
                         (edn_pair (edn_entry ":stdout" (qstr stdout))
                                   (edn_entry ":stderr" (qstr stderr))))))))

;; reply error: {:tag :error :code "…" :message "…"}
(defn git_reply_error_rec_kv_edn
  [code :string message :string]
  :string
  (if (or (= (string-length code) 0)
          (= (has-forbidden code) 1)
          (= (has-forbidden message) 1))
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":error")
               (edn_pair (edn_entry ":code" (qstr code))
                         (edn_entry ":message" (qstr message)))))))

(defn main [] :i64
  (let [req (git_req_rec_kv_edn "[\"status\" \"--short\"]" 8192 30000)
        bad-req (git_req_rec_kv_edn "" 8192 30000)
        bad-max (git_req_rec_kv_edn "[\"x\"]" 0 30000)
        bad-to (git_req_rec_kv_edn "[\"x\"]" 100 0)
        ok (git_reply_ok_rec_kv_edn 0 " M foo" "")
        bad-ok (git_reply_ok_rec_kv_edn -1 "x" "")
        bad-out (git_reply_ok_rec_kv_edn 0 "a\"b" "")
        err (git_reply_error_rec_kv_edn "not-a-repo" "fatal")
        bad-err (git_reply_error_rec_kv_edn "" "m")
        good-req (if (string-contains? req ":args")
                   (if (string-contains? req "status")
                     (if (string-contains? req ":timeout-ms")
                       (if (string-contains? req "30000")
                         (if (string-contains? req ":max-stdout-bytes") 1 0)
                         0)
                       0)
                     0)
                   0)
        good-ok (if (string-contains? ok ":tag")
                  (if (string-contains? ok ":ok")
                    (if (string-contains? ok ":exit")
                      (if (string-contains? ok " M foo") 1 0)
                      0)
                    0)
                  0)
        good-err (if (string-contains? err ":error")
                   (if (string-contains? err "not-a-repo") 1 0)
                   0)
        ok-bad-1 (if (= (string-length bad-req) 0) 1 0)
        ok-bad-2 (if (= (string-length bad-max) 0) 1 0)
        ok-bad-3 (if (= (string-length bad-to) 0) 1 0)
        ok-bad-4 (if (= (string-length bad-ok) 0) 1 0)
        ok-bad-5 (if (= (string-length bad-out) 0) 1 0)
        ok-bad-6 (if (= (string-length bad-err) 0) 1 0)
        ok-bad (if (= ok-bad-1 1)
                 (if (= ok-bad-2 1)
                   (if (= ok-bad-3 1)
                     (if (= ok-bad-4 1)
                       (if (= ok-bad-5 1)
                         (if (= ok-bad-6 1) 1 0)
                         0)
                       0)
                     0)
                   0)
                 0)]
    (if (= good-req 1)
      (if (= good-ok 1)
        (if (= good-err 1)
          (if (= ok-bad 1) -2503 -1)
          -1)
        -1)
      -1)))
