(ns kotoba.secret.w4-host-edn
  ;; T8.3 ADR 0265: guest W4 secret request encode + typed-cap-call wire id 21
  ;; (provider secret/get). Main pure encode proof. Host injects cap 21 for
  ;; host_get_edn. Does NOT flip wasm-aot :implemented.
  (:schemas {:edn/node [:variant :edn/node
                         [[:atom :string]
                          [:entry [:ref :kotoba.secret.w4-host-edn/EdnKeyValue]]
                          [:pair [:vector [[:ref :edn/node]
                                           [:ref :edn/node]]]]]]})
  (:export [secret_request_rec_kv_edn
            secret_reply_value_rec_kv_edn
            host_get_edn
            main]))

(defrecord EdnKeyValue [k :string v :string])

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- qstr [s :string] :string
  (string-concat (string-substring "\"x" 0 1)
                 (string-concat s (string-substring "\"x" 0 1))))

(defn- edn_entry [k :string v :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.secret.w4-host-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.secret.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :entry
   (->EdnKeyValue k v)))

(defn- edn_pair
  [l [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.secret.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   r [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.secret.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.secret.w4-host-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.secret.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :pair
   (hetero-vector [:vector [[:ref :edn/node] [:ref :edn/node]]] l r)))

(defn- edn_print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.secret.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (match-variant n
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.secret.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
    (:atom s s)
    (:entry r
      (string-concat
       (:k r)
       (string-concat " "
                      (:v r))))
    (:pair p
      (string-concat
       (edn_print (nth p 0))
       (string-concat " "
                      (edn_print (nth p 1)))))))

(defn- brace-print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.secret.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (string-concat "{" (string-concat (edn_print n) "}")))

(defn secret_request_rec_kv_edn [name :string] :string
  (if (or (= (string-length name) 0)
          (= (has-forbidden name) 1)
          (> (string-length name) 128))
    ""
    (brace-print (edn_entry ":name" (qstr name)))))

(defn secret_reply_value_rec_kv_edn [value :string] :string
  (if (= (has-forbidden value) 1)
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":value")
               (edn_entry ":value" (qstr value))))))

;; Host inject surface: pure request EDN then typed-cap-call wire id 21
;; (provider kit secret/get). Host returns reply EDN string.
(defn host_get_edn [name :string] :string
  (let [req (secret_request_rec_kv_edn name)]
    (if (= (string-length req) 0)
      ""
      (typed-cap-call 21 :string :string req))))

(defn main [] :i64
  (let [req (secret_request_rec_kv_edn "API_TOKEN")
        bad (secret_request_rec_kv_edn "")
        val (secret_reply_value_rec_kv_edn "s3cr3t")
        good-req (if (string-contains? req ":name")
                   (if (string-contains? req "API_TOKEN") 1 0)
                   0)
        good-val (if (string-contains? val ":value")
                   (if (string-contains? val "s3cr3t") 1 0)
                   0)
        ok-bad (if (= (string-length bad) 0) 1 0)]
    (if (= good-req 1)
      (if (= good-val 1)
        (if (= ok-bad 1) -2507 -1)
        -1)
      -1)))
