(ns kotoba.fs.path-ok
  (:export [fs_path_ok main]))

;; Typed-string single-call scoped-fs path policy (ADR 0180).
;; Requires kotoba:typed host. Mirrors pure gates (0177) + hand WAT fs_path_ok.
;; Errors: -1 empty, -2 oversize, -3 NUL, -4 backslash, -5 abs slash,
;;         -6 home tilde, -7 dot or dotdot segment.

(defn- step-state
  [state :i64 c :i64]
  :i64
  (let [prev (quot state 4)
        dots (- state (* prev 4))]
    (if (= c 0)
      -3
      (if (= c 92)
        -4
        (if (= c 47)
          (if (or (= dots 1) (= dots 2))
            -7
            4)
          (if (= prev 1)
            (if (= c 46) 1 3)
            (if (= dots 1)
              (if (= c 46) 2 3)
              (if (= dots 2)
                3
                dots))))))))

(defn- finish-state
  [state :i64]
  :i64
  (let [prev (quot state 4)
        dots (- state (* prev 4))]
    (if (or (= dots 1) (= dots 2))
      -7
      0)))

(defn fs_path_ok
  [path :string]
  :i64
  (let [n (string-length path)]
    (if (<= n 0)
      -1
      (if (> n 1024)
        -2
        (let [c0 (string-code-point-at path 0)]
          (if (= c0 47)
            -5
            (if (= c0 126)
              -6
              (loop [i 0 state 4]
                (if (>= i n)
                  (finish-state state)
                  (let [c (string-code-point-at path i)
                        st (step-state state c)]
                    (if (< st 0)
                      st
                      (recur (+ i 1) st))))))))))))

;; Live vector for browser-host main proof:
;; ok=0 empty=-1 abs=-5 backslash=-4 dotdot=-7 ok2=0
;; 0*100000 + (-1)*10000 + (-5)*1000 + (-4)*100 + (-7)*10 + 0 = -15470
(defn main []
  :i64
  (let [a (fs_path_ok "a/b")
        b (fs_path_ok "")
        c (fs_path_ok "/abs")
        d (fs_path_ok "a\\b")
        e (fs_path_ok "a/../b")
        f (fs_path_ok "ok-name")]
    (+ (* a 100000) (* b 10000) (* c 1000) (* d 100) (* e 10) f)))
