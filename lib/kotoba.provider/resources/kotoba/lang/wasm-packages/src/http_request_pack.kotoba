(ns kotoba.http.request-pack
  (:export [http_request_begin http_request_url http_request_headers
            http_request_body http_request_end main]))

;; Typed-string HTTP **request packing walk** (ADR 0193).
;; Host-sequenced post-request surface — composes request_ok (0186) /
;; URL (0182) without nested EDN in guest memory. Symmetric to result
;; packing walk (0192). Requires kotoba:typed. max-params ≤5.
;; Header pair content still via 0189 set packing (separate residual).
;;
;; States: 0=need-url 1=need-headers 2=need-body 3=need-end
;; sticky negative = prior error
;;
;; Codes:
;;   url: -1 empty; -2 >4096; -3 not https://; -10 wrong-phase
;;   headers: -4 n∉[0,32]; -10
;;   body: -5 len∉[0,65536]; -10
;;   end(timeout): -6 timeout∉[1,30000]; -7 incomplete; prior; 0 ok

(defn http_request_begin
  []
  :i64
  0)

(defn http_request_url
  [state :i64 url :string]
  :i64
  (if (< state 0)
    state
    (if (not= state 0)
      -10
      (let [n (string-length url)]
        (if (<= n 0)
          -1
          (if (> n 4096)
            -2
            (if (or (< n 8)
                    (not (string=? (string-substring url 0 8) "https://")))
              -3
              1)))))))

(defn http_request_headers
  [state :i64 n :i64]
  :i64
  (if (< state 0)
    state
    (if (not= state 1)
      -10
      (if (or (< n 0) (> n 32))
        -4
        2))))

(defn http_request_body
  [state :i64 body :string]
  :i64
  (if (< state 0)
    state
    (if (not= state 2)
      -10
      (let [bn (string-length body)]
        (if (or (< bn 0) (> bn 65536))
          -5
          3)))))

(defn http_request_end
  [state :i64 timeout-ms :i64]
  :i64
  (if (< state 0)
    state
    (if (not= state 3)
      -7
      (if (or (< timeout-ms 1) (> timeout-ms 30000))
        -6
        0))))

;; Live vector:
;; ok=0, empty-url=-1, http=-3, bad-headers=-4, bad-timeout=-6, incomplete=-7
;; 0*100000 + (-1)*10000 + (-3)*1000 + (-4)*100 + (-6)*10 + (-7) = -13467
(defn main []
  :i64
  (let [a (http_request_end
           (http_request_body
            (http_request_headers
             (http_request_url (http_request_begin) "https://x")
             1)
            "{}")
           1000)
        b (http_request_url (http_request_begin) "")
        c (http_request_url (http_request_begin) "http://x")
        d (http_request_headers
           (http_request_url (http_request_begin) "https://x")
           40)
        e (http_request_end
           (http_request_body
            (http_request_headers
             (http_request_url (http_request_begin) "https://x")
             0)
            "")
           0)
        f (http_request_end (http_request_begin) 1000)]
    (+ (* a 100000) (* b 10000) (* c 1000) (* d 100) (* e 10) f)))
