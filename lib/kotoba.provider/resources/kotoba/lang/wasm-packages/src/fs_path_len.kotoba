(ns kotoba.fs.path-len
  (:export [fs_path_len_ok]))

;; Pure length half of scoped-fs path policy (ADR 0169: empty → -1, >1024 → -2).
;; Char-class / escape scan remains hand WAT scoped-fs-path-v1.
(defn fs_path_len_ok
  [len :i64]
  :i64
  (if (<= len 0)
    -1
    (if (> len 1024)
      -2
      0)))
