(ns kotoba.git.w4-host-edn
  ;; T8.3 ADR 0267: git W4 request encode + typed-cap-call wire 22
  (:schemas {:edn/node [:variant :edn/node
                         [[:atom :string]
                          [:entry [:ref :kotoba.git.w4-host-edn/EdnKeyValue]]
                          [:pair [:vector [[:ref :edn/node]
                                           [:ref :edn/node]]]]]]})
  (:export [git_req_rec_kv_edn host_run_edn main]))

(defrecord EdnKeyValue [k :string v :string])

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn- edn_entry [k :string v :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.git.w4-host-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.git.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :entry
   (->EdnKeyValue k v)))

(defn- edn_pair
  [l [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.git.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   r [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.git.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.git.w4-host-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.git.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :pair
   (hetero-vector [:vector [[:ref :edn/node] [:ref :edn/node]]] l r)))

(defn- edn_print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.git.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (match-variant n
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.git.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
    (:atom s s)
    (:entry r
      (string-concat
       (:k r)
       (string-concat " "
                      (:v r))))
    (:pair p
      (string-concat
       (edn_print (nth p 0))
       (string-concat " "
                      (edn_print (nth p 1)))))))

(defn git_req_rec_kv_edn
  [args-edn :string max-stdout :i64 timeout-ms :i64]
  :string
  (if (or (= (string-length args-edn) 0)
          (not (string-contains? args-edn "["))
          (<= max-stdout 0)
          (> max-stdout 65536)
          (<= timeout-ms 0)
          (> timeout-ms 600000))
    ""
    (string-concat
     "{"
     (string-concat
      (edn_print
       (edn_pair (edn_entry ":args" args-edn)
                 (edn_pair (edn_entry ":max-stdout-bytes" (nat-str max-stdout))
                           (edn_entry ":timeout-ms" (nat-str timeout-ms)))))
      "}"))))

(defn host_run_edn
  [args-edn :string max-stdout :i64 timeout-ms :i64]
  :string
  (let [req (git_req_rec_kv_edn args-edn max-stdout timeout-ms)]
    (if (= (string-length req) 0)
      ""
      (typed-cap-call 22 :string :string req))))

(defn main [] :i64
  (let [req (git_req_rec_kv_edn "[\"status\"]" 4096 5000)
        bad (git_req_rec_kv_edn "" 4096 5000)]
    (if (string-contains? req ":args")
      (if (string-contains? req "status")
        (if (= (string-length bad) 0) -2509 -1)
        -1)
      -1)))
