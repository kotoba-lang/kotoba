(ns kotoba.process.w4-host-edn
  ;; T8.3 ADR 0266: guest W4 process request encode + typed-cap-call wire id 20
  ;; (provider process/spawn). Main pure encode proof. Host injects cap 20 for
  ;; host_spawn_edn. Does NOT flip wasm-aot :implemented.
  (:schemas {:edn/node [:variant :edn/node
                         [[:atom :string]
                          [:entry [:ref :kotoba.process.w4-host-edn/EdnKeyValue]]
                          [:pair [:vector [[:ref :edn/node]
                                           [:ref :edn/node]]]]]]})
  (:export [process_req_rec_kv_edn
            process_reply_ok_rec_kv_edn
            host_spawn_edn
            main]))

(defrecord EdnKeyValue [k :string v :string])

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- qstr [s :string] :string
  (string-concat (string-substring "\"x" 0 1)
                 (string-concat s (string-substring "\"x" 0 1))))

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn- edn_entry [k :string v :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.process.w4-host-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.process.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :entry
   (->EdnKeyValue k v)))

(defn- edn_pair
  [l [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.process.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   r [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.process.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.process.w4-host-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.process.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :pair
   (hetero-vector [:vector [[:ref :edn/node] [:ref :edn/node]]] l r)))

(defn- edn_print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.process.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (match-variant n
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.process.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
    (:atom s s)
    (:entry r
      (string-concat
       (:k r)
       (string-concat " "
                      (:v r))))
    (:pair p
      (string-concat
       (edn_print (nth p 0))
       (string-concat " "
                      (edn_print (nth p 1)))))))

(defn- brace-print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.process.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (string-concat "{" (string-concat (edn_print n) "}")))

;; request: {:argv […] :max-stdout-bytes N :timeout-ms N}
(defn process_req_rec_kv_edn
  [argv-edn :string max-stdout :i64 timeout-ms :i64]
  :string
  (if (or (= (string-length argv-edn) 0)
          (not (string-contains? argv-edn "["))
          (<= max-stdout 0)
          (> max-stdout 65536)
          (<= timeout-ms 0)
          (> timeout-ms 600000))
    ""
    (brace-print
     (edn_pair (edn_entry ":argv" argv-edn)
               (edn_pair (edn_entry ":max-stdout-bytes" (nat-str max-stdout))
                         (edn_entry ":timeout-ms" (nat-str timeout-ms)))))))

(defn process_reply_ok_rec_kv_edn
  [exit :i64 stdout :string stderr :string]
  :string
  (if (or (< exit 0)
          (= (has-forbidden stdout) 1)
          (= (has-forbidden stderr) 1))
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":ok")
               (edn_pair (edn_entry ":exit" (nat-str exit))
                         (edn_pair (edn_entry ":stdout" (qstr stdout))
                                   (edn_entry ":stderr" (qstr stderr))))))))

;; Host inject surface: pure request EDN then typed-cap-call wire id 20
(defn host_spawn_edn
  [argv-edn :string max-stdout :i64 timeout-ms :i64]
  :string
  (let [req (process_req_rec_kv_edn argv-edn max-stdout timeout-ms)]
    (if (= (string-length req) 0)
      ""
      (typed-cap-call 20 :string :string req))))

(defn main [] :i64
  (let [req (process_req_rec_kv_edn "[\"echo\" \"hi\"]" 4096 5000)
        bad (process_req_rec_kv_edn "" 4096 5000)
        ok (process_reply_ok_rec_kv_edn 0 "hi" "")
        good-req (if (string-contains? req ":argv")
                   (if (string-contains? req "echo")
                     (if (string-contains? req ":timeout-ms")
                       (if (string-contains? req "5000") 1 0)
                       0)
                     0)
                   0)
        good-ok (if (string-contains? ok ":ok")
                  (if (string-contains? ok "hi") 1 0)
                  0)
        ok-bad (if (= (string-length bad) 0) 1 0)]
    (if (= good-req 1)
      (if (= good-ok 1)
        (if (= ok-bad 1) -2508 -1)
        -1)
      -1)))
