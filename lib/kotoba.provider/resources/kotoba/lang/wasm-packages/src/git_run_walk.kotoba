(ns kotoba.git.walk
  (:export [git_run_begin git_run_arg git_run_end]))

;; Pure multi-step git run policy (ADR 0184).
;; Composes git-v1 :limits into a host-walk over args lengths.
;;
;; git_run_begin(argc) → remaining | -1 empty | -2 argc>64
;; git_run_arg(state, arg_len) → remaining-1 | sticky err
;;   -5 unexpected arg (state==0), -6 arg_len not in [1,4096]
;; git_run_end(state, max_out, timeout-ms) → 0 | sticky | -7 missing | -3 max_out | -4 timeout
;;
;; Single-shot git_run_bounds_ok (ADR 0172) retained.

(defn git_run_begin
  [argc :i64]
  :i64
  (if (<= argc 0)
    -1
    (if (> argc 64)
      -2
      argc)))

(defn git_run_arg
  [state :i64 arg-len :i64]
  :i64
  (if (< state 0)
    state
    (if (= state 0)
      -5
      (if (or (<= arg-len 0) (> arg-len 4096))
        -6
        (- state 1)))))

(defn git_run_end
  [state :i64 max-out :i64 timeout-ms :i64]
  :i64
  (if (< state 0)
    state
    (if (not= state 0)
      -7
      (if (or (<= max-out 0) (> max-out 65536))
        -3
        (if (or (<= timeout-ms 0) (> timeout-ms 600000))
          -4
          0)))))
