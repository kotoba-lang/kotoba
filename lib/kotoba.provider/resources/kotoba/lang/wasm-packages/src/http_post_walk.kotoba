(ns kotoba.http.walk
  (:export [http_post_begin http_post_url http_post_headers
            http_post_body http_post_end]))

;; Pure multi-step http-post bounds walk (ADR 0185).
;; Phases: 0=need-url, 1=need-headers, 2=need-body, 3=need-end.
;; Errors: -1 url, -2 headers-n, -3 body, -4 timeout, -5 wrong-phase.
;; Single-shot http_post_bounds_ok (0171) and typed http_url_ok (0182) retained.

(defn http_post_begin
  []
  :i64
  0)

(defn http_post_url
  [state :i64 url-len :i64]
  :i64
  (if (< state 0)
    state
    (if (not= state 0)
      -5
      (if (or (<= url-len 0) (> url-len 4096))
        -1
        1))))

(defn http_post_headers
  [state :i64 headers-n :i64]
  :i64
  (if (< state 0)
    state
    (if (not= state 1)
      -5
      (if (or (< headers-n 0) (> headers-n 32))
        -2
        2))))

(defn http_post_body
  [state :i64 body-len :i64]
  :i64
  (if (< state 0)
    state
    (if (not= state 2)
      -5
      (if (or (< body-len 0) (> body-len 65536))
        -3
        3))))

(defn http_post_end
  [state :i64 timeout-ms :i64]
  :i64
  (if (< state 0)
    state
    (if (not= state 3)
      -5
      (if (or (< timeout-ms 1) (> timeout-ms 30000))
        -4
        0))))
