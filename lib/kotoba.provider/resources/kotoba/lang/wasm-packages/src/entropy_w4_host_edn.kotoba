(ns kotoba.entropy.w4-host-edn
  ;; T8.3 ADR 0267: entropy W4 request encode + typed-cap-call wire 23
  (:schemas {:edn/node [:variant :edn/node
                         [[:atom :string]
                          [:entry [:ref :kotoba.entropy.w4-host-edn/EdnKeyValue]]
                          [:pair [:vector [[:ref :edn/node]
                                           [:ref :edn/node]]]]]]})
  (:export [entropy_req_rec_kv_edn host_draw_edn main]))

(defrecord EdnKeyValue [k :string v :string])

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn- edn_entry [k :string v :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.entropy.w4-host-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.entropy.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :entry
   (->EdnKeyValue k v)))

(defn- edn_print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.entropy.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (match-variant n
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.entropy.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
    (:atom s s)
    (:entry r
      (string-concat
       (:k r)
       (string-concat " "
                      (:v r))))
    (:pair p
      (string-concat
       (edn_print (nth p 0))
       (string-concat " "
                      (edn_print (nth p 1)))))))

(defn entropy_req_rec_kv_edn [n :i64] :string
  (if (or (< n 1) (> n 64))
    ""
    (string-concat "{" (string-concat (edn_print (edn_entry ":n" (nat-str n))) "}"))))

(defn host_draw_edn [n :i64] :string
  (let [req (entropy_req_rec_kv_edn n)]
    (if (= (string-length req) 0)
      ""
      (typed-cap-call 23 :string :string req))))

(defn main [] :i64
  (let [req (entropy_req_rec_kv_edn 16)
        bad (entropy_req_rec_kv_edn 0)]
    (if (string-contains? req ":n")
      (if (string-contains? req "16")
        (if (= (string-length bad) 0) -2510 -1)
        -1)
      -1)))
