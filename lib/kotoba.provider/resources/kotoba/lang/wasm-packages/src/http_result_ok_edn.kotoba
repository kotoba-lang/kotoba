(ns kotoba.http.result-ok-edn
  (:export [http_result_ok_edn]))

;; T8.3 reject-path result ok arm (ADR 0218). Composition on edn_quoted.
;; Body is admission skeleton; Canonical WAT owns status 0..999 decimal,
;; headers […] shape, and body quote/backslash scan.

(defn http_result_ok_edn
  [status :i64 headers :string body :string]
  :string
  (if (or (< status 0) (> status 999))
    ""
    (string-concat "{:tag :ok :status "
                   (string-concat "0"
                                  (string-concat " :headers "
                                                 (string-concat headers
                                                                (string-concat " :body \""
                                                                               (string-concat body "\"}"))))))))
