(ns kotoba.http.edn-quoted
  (:export [edn_quoted]))

;; T8.3 reject-path first slice (ADR 0214): EDN string quote with reject
;; on quote/backslash. Body is admission skeleton; Canonical WAT owns the
;; UTF-8 scan (kotoba-component :edn-quoted). Full multi-export request-edn
;; reject path remains open.

(defn edn_quoted
  [s :string]
  :string
  (let [n (string-byte-length s)]
    (if (< n 0)
      ""
      (string-concat "\"" (string-concat s "\"")))))
