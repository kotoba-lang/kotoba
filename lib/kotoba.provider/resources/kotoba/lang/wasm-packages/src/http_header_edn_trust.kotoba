(ns kotoba.http.header-edn-trust
  (:export [http_header_edn_trust]))

;; T8.3 Component twin first slice (ADR 0212): trusted header map EDN.
;; Pure nested string-concat (string-expression). Host pre-validates atoms
;; (no quote/backslash). Rejecting encoder remains http-request-edn (ADR 0209+).

(defn http_header_edn_trust
  [name :string value :string]
  :string
  (string-concat "{:name \""
                 (string-concat name
                                (string-concat "\" :value \""
                                               (string-concat value "\"}")))))
