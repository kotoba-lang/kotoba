(ns kotoba.http.headers-set-ok
  (:export [http_headers_begin http_headers_pair http_headers_end main]))

;; Typed-string HTTP header **set packing** walk (ADR 0189).
;; Host feeds N pairs; guest enforces count + per-pair name/value policy
;; (composes ADR 0187 tchar + 0188 value/pair). Requires kotoba:typed.
;; Not a recursive header set value — host sequences pairs (W4 open).
;;
;; Codes:
;;   begin(n): -4 n∉[0,32]; else remaining = n
;;   pair(state,name,value): prior err; -8 extra when remaining=0;
;;     name -1/-2/-3; value -2→-5, -3→-6; else remaining-1
;;   end(state): prior err; -7 incomplete (remaining>0); 0 ok
;;
;; Does not check name uniqueness (needs set storage / W4).

(defn- name-char-ok?
  [c :i64]
  :i64
  (if (or (and (>= c 48) (<= c 57))
          (and (>= c 65) (<= c 90))
          (and (>= c 97) (<= c 122))
          (= c 33) (= c 35) (= c 36) (= c 37) (= c 38)
          (= c 39) (= c 42) (= c 43) (= c 45) (= c 46)
          (= c 94) (= c 95) (= c 96) (= c 124) (= c 126))
    1
    0))

(defn- header-name-ok
  [name :string]
  :i64
  (let [n (string-length name)]
    (if (<= n 0)
      -1
      (if (> n 128)
        -2
        (loop [i 0]
          (if (>= i n)
            0
            (let [c (string-code-point-at name i)]
              (if (= (name-char-ok? c) 0)
                -3
                (recur (+ i 1))))))))))

(defn- header-value-ok
  [value :string]
  :i64
  (let [n (string-length value)]
    (if (> n 8192)
      -2
      (loop [i 0]
        (if (>= i n)
          0
          (let [c (string-code-point-at value i)]
            (if (or (= c 0) (= c 10) (= c 13))
              -3
              (recur (+ i 1)))))))))

(defn- pair-ok
  [name :string value :string]
  :i64
  (let [nr (header-name-ok name)]
    (if (not= nr 0)
      nr
      (let [vr (header-value-ok value)]
        (if (not= vr 0)
          (if (= vr -2) -5
            (if (= vr -3) -6 vr))
          0)))))

(defn http_headers_begin
  [n :i64]
  :i64
  (if (or (< n 0) (> n 32))
    -4
    n))

(defn http_headers_pair
  [state :i64 name :string value :string]
  :i64
  (if (< state 0)
    state
    (if (<= state 0)
      -8
      (let [pr (pair-ok name value)]
        (if (not= pr 0)
          pr
          (- state 1))))))

(defn http_headers_end
  [state :i64]
  :i64
  (if (< state 0)
    state
    (if (not= state 0)
      -7
      0)))

;; Live vector:
;; empty ok=0, one pair ok=0, bad name=-3, bad value=-6, bad n=-4, incomplete=-7
;; 0*100000 + 0*10000 + (-3)*1000 + (-6)*100 + (-4)*10 + (-7) = -3647
(defn main []
  :i64
  (let [a (http_headers_end (http_headers_begin 0))
        b (http_headers_end
           (http_headers_pair (http_headers_begin 1) "X-Ok" "yes"))
        c (http_headers_pair (http_headers_begin 1) "Bad Name" "yes")
        d (http_headers_pair (http_headers_begin 1) "X-Ok" "x\ny")
        e (http_headers_begin 40)
        f (http_headers_end (http_headers_begin 1))]
    (+ (* a 100000) (* b 10000) (* c 1000) (* d 100) (* e 10) f)))
