(ns kotoba.edn.recursive-kv
  ;; T8.3 / W4 third ops slice ADR 0248: true nested pair(k,v) recursive
  ;; map identity (beyond ADR 0247 entry-atom preformat).
  ;; parametric-adt-depth 8 admits ≤3 true-kv map entries; 4-entry maps
  ;; exceed depth. Nested records inside recursive variants remain outside
  ;; closed schema (compiler rejects). Does NOT flip wasm-aot :implemented.
  (:schemas {:edn/node [:variant :edn/node
                         [[:atom :string]
                          [:pair [:vector [[:ref :edn/node]
                                           [:ref :edn/node]]]]]]})
  (:export [edn_atom
            edn_pair
            edn_print
            header_kv_edn
            headers_list_edn
            request_kv_edn
            result_ok_kv_edn
            result_err_kv_edn
            main]))

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- qstr [s :string] :string
  (string-concat (string-substring "\"x" 0 1)
                 (string-concat s (string-substring "\"x" 0 1))))

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn edn_atom [s :string]
  [:variant :edn/node
    [[:atom :string]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :atom s))

(defn edn_pair
  [l [:variant :edn/node
       [[:atom :string]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   r [:variant :edn/node
       [[:atom :string]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  [:variant :edn/node
    [[:atom :string]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :pair
   (hetero-vector [:vector [[:ref :edn/node] [:ref :edn/node]]] l r)))

(defn edn_print
  [n [:variant :edn/node
       [[:atom :string]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (match-variant n
   [:variant :edn/node
     [[:atom :string]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
    (:atom s s)
    (:pair p
      (string-concat
       (edn_print (nth p 0))
       (string-concat " "
                      (edn_print (nth p 1)))))))

;; True kv entry: pair(key-atom, value-atom) — not a preformatted "k v" atom.
(defn- kv
  [k :string v :string]
  [:variant :edn/node
    [[:atom :string]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (edn_pair (edn_atom k) (edn_atom v)))

(defn- brace-print
  [n [:variant :edn/node
       [[:atom :string]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (string-concat "{" (string-concat (edn_print n) "}")))

;; One header as true 2-field kv map: {:name "…" :value "…"}
(defn header_kv_edn [name :string value :string] :string
  (if (or (= (string-length name) 0)
          (= (has-forbidden name) 1)
          (= (has-forbidden value) 1))
    ""
    (brace-print
     (edn_pair (kv ":name" (qstr name))
               (kv ":value" (qstr value))))))

;; Two headers as pair spine of header-map atoms (list identity).
(defn headers_list_edn
  [name1 :string value1 :string name2 :string value2 :string]
  :string
  (let [a (header_kv_edn name1 value1)
        b (header_kv_edn name2 value2)]
    (if (or (= (string-length a) 0)
            (= (string-length b) 0))
      ""
      (let [tree (edn_pair (edn_atom a) (edn_atom b))]
        (string-concat "[" (string-concat (edn_print tree) "]"))))))

;; 3-field request as true nested kv pairs (depth-safe):
;;   {:url "…" :headers […] :body "…"}
;; timeout-ms deferred — 4th true-kv entry exceeds parametric-adt-depth 8.
(defn request_kv_edn
  [url :string body :string headers-edn :string]
  :string
  (if (or (= (has-forbidden url) 1)
          (= (has-forbidden body) 1)
          (= (string-length headers-edn) 0))
    ""
    (brace-print
     (edn_pair (kv ":url" (qstr url))
               (edn_pair (kv ":headers" headers-edn)
                         (kv ":body" (qstr body)))))))

;; 3-field ok arm: {:tag :ok :status N :body "…"}
(defn result_ok_kv_edn
  [status :i64 body :string]
  :string
  (if (or (< status 100)
          (> status 599)
          (= (has-forbidden body) 1))
    ""
    (brace-print
     (edn_pair (kv ":tag" ":ok")
               (edn_pair (kv ":status" (nat-str status))
                         (kv ":body" (qstr body)))))))

;; 3-field err arm: {:tag :error :code "…" :message "…"}
(defn result_err_kv_edn
  [code :string message :string]
  :string
  (if (or (= (string-length code) 0)
          (= (has-forbidden code) 1)
          (= (has-forbidden message) 1))
    ""
    (brace-print
     (edn_pair (kv ":tag" ":error")
               (edn_pair (kv ":code" (qstr code))
                         (kv ":message" (qstr message)))))))

(defn main [] :i64
  (let [h1 (header_kv_edn "Accept" "text/plain")
        bad-h (header_kv_edn "" "v")
        hdrs (headers_list_edn "Accept" "text/plain" "Host" "ex.com")
        bad-hdrs (headers_list_edn "" "v" "Host" "ex.com")
        req (request_kv_edn "https://ex.com/a" "hi" hdrs)
        bad-req (request_kv_edn "https://ex.com" "x" bad-hdrs)
        ok (result_ok_kv_edn 200 "ok")
        bad-ok (result_ok_kv_edn 99 "ok")
        err (result_err_kv_edn "timeout" "slow")
        bad-err (result_err_kv_edn "" "m")
        good-h1 (if (string-contains? h1 ":name")
                  (if (string-contains? h1 "Accept")
                    (if (string-contains? h1 ":value") 1 0)
                    0)
                  0)
        good-hdrs (if (string-contains? hdrs "Accept")
                    (if (string-contains? hdrs "Host") 1 0)
                    0)
        good-req (if (string-contains? req ":url")
                   (if (string-contains? req "https://ex.com/a")
                     (if (string-contains? req ":headers")
                       (if (string-contains? req ":body")
                         (if (string-contains? req "hi") 1 0)
                         0)
                       0)
                     0)
                   0)
        good-ok (if (string-contains? ok ":tag")
                  (if (string-contains? ok ":ok")
                    (if (string-contains? ok "200") 1 0)
                    0)
                  0)
        good-err (if (string-contains? err ":error")
                   (if (string-contains? err "timeout") 1 0)
                   0)
        ok-bad-1 (if (= (string-length bad-h) 0) 1 0)
        ok-bad-2 (if (= (string-length bad-hdrs) 0) 1 0)
        ok-bad-3 (if (= (string-length bad-req) 0) 1 0)
        ok-bad-4 (if (= (string-length bad-ok) 0) 1 0)
        ok-bad-5 (if (= (string-length bad-err) 0) 1 0)
        ok-bad (if (= ok-bad-1 1)
                 (if (= ok-bad-2 1)
                   (if (= ok-bad-3 1)
                     (if (= ok-bad-4 1)
                       (if (= ok-bad-5 1) 1 0)
                       0)
                     0)
                   0)
                 0)]
    (if (= good-h1 1)
      (if (= good-hdrs 1)
        (if (= good-req 1)
          (if (= good-ok 1)
            (if (= good-err 1)
              (if (= ok-bad 1) -2403 -1)
              -1)
            -1)
          -1)
        -1)
      -1)))
