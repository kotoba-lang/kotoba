(ns kotoba.git.bounds
  (:export [git_run_bounds_ok]))

(defn git_run_bounds_ok
  [argc :i64 max-out :i64 timeout-ms :i64]
  :i64
  (if (or (<= argc 0) (> argc 64))
    (if (<= argc 0) -1 -2)
    (if (or (<= max-out 0) (> max-out 65536))
      -3
      (if (or (<= timeout-ms 0) (> timeout-ms 600000))
        -4
        0))))
