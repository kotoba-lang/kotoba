(ns kotoba.secret.request-edn
  ;; T8.3 ADR 0236: fixed-depth secret get-request EDN encode.
  ;; Kit :request is [:record [[:name :string]]]. Dual quote/backslash scan.
  ;; Complements ADR 0232 reply arms. W4 / full kit project body open.
  (:export [secret_request_edn
            main]))

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn secret_request_edn
  [name :string]
  :string
  (if (or (= (string-length name) 0)
          (= (has-forbidden name) 1)
          (> (string-length name) 128))
    ""
    (string-concat "{:name \""
                   (string-concat name "\"}"))))

;; main → -2306: ok name + empty reject + quote reject + len>128 reject
(defn main [] :i64
  (let [ok (secret_request_edn "API_TOKEN")
        empty (secret_request_edn "")
        bad (secret_request_edn "a\"b")
        long (secret_request_edn
              "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")]
    (if (or (= (string-length ok) 0)
            (not= (string-length empty) 0)
            (not= (string-length bad) 0)
            (not= (string-length long) 0))
      -1
      -2306)))
