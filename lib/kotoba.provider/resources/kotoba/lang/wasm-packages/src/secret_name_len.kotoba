(ns kotoba.secret.len
  (:export [secret_name_len_ok]))

;; Pure length half of secret name policy (ADR 0163: empty → -1, >128 → -2).
;; Char-class scan remains hand WAT secret-get-v1 until typed-host free path.
(defn secret_name_len_ok
  [len :i64]
  :i64
  (if (<= len 0)
    -1
    (if (> len 128)
      -2
      0)))
