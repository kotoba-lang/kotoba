(ns kotoba.secret.reply-edn
  ;; T8.3 ADR 0232: fixed-depth secret reply EDN encode (kit :result twin of
  ;; HTTP result arms 0217/0218). Reject-path dual quote/backslash scan on
  ;; string leaves. Code is a plain string atom (not keyword) for pure codec.
  ;; W4 recursive nested EDN ADT open; wasm-aot stays :partial.
  (:export [secret_reply_value_edn
            secret_reply_error_edn
            main]))

(defn- has-forbidden
  [s :string]
  :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n)
        0
        (let [c (string-code-point-at s i)]
          (if (= c 34)
            1
            (if (= c 92)
              1
              (recur (+ i 1)))))))))

(defn secret_reply_value_edn
  [value :string]
  :string
  (if (= (has-forbidden value) 1)
    ""
    (string-concat "{:tag :value :value \""
                   (string-concat value "\"}"))))

(defn secret_reply_error_edn
  [code :string message :string]
  :string
  (if (or (= (string-length code) 0)
          (= (has-forbidden code) 1)
          (= (has-forbidden message) 1))
    ""
    (string-concat "{:tag :error :code \""
                   (string-concat code
                                  (string-concat "\" :message \""
                                                 (string-concat message "\"}"))))))

;; main → -2302: value ok + error ok + value reject quote + empty code reject
(defn main [] :i64
  (let [v (secret_reply_value_edn "s3cr3t")
        e (secret_reply_error_edn "not-found" "missing")
        bad-v (secret_reply_value_edn "a\"b")
        bad-c (secret_reply_error_edn "" "m")]
    (if (or (= (string-length v) 0)
            (= (string-length e) 0)
            (not= (string-length bad-v) 0)
            (not= (string-length bad-c) 0))
      -1
      -2302)))
