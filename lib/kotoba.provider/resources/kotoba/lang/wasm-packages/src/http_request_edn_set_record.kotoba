(ns kotoba.http.request-edn-set-record
  ;; T8.3 ADR 0234/0277: full request EDN from nominal guest records.
  ;; Composes ADR 0231 (set-of-header-records + name-set) with ADR 0233
  ;; typed-set-nth headers fold into
  ;;   {:url "…" :headers [{…} …] :body "…" :timeout-ms N}
  ;; Fixed-depth request map (not W4 recursive ADT). wasm-aot stays :partial.
  (:export [http_req_begin
            http_req_add_header
            http_req_code
            http_req_count
            http_req_edn
            main]))

(defrecord Header [name :string value :string])

(defrecord HttpRequest
  [url :string
   headers [:set [:ref :kotoba.http.request-edn-set-record/Header]]
   names [:set :string]
   body :string
   timeout :i64
   code :i64])

(def header-set-type
  [:set [:ref :kotoba.http.request-edn-set-record/Header]])

;; Sticky codes: 0 ok; -1 empty name; -3 forbidden; -4 full; -9 dup name

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn- header-map-edn
  [h [:ref :kotoba.http.request-edn-set-record/Header]]
  :string
  (string-concat "{:name \""
                 (string-concat (:name h)
                                (string-concat "\" :value \""
                                               (string-concat (:value h) "\"}")))))

(defn- fold-headers-edn
  [headers [:set [:ref :kotoba.http.request-edn-set-record/Header]]
   n :i64 i :i64 acc :string]
  :string
  (if (>= i n)
    acc
    (let [h (typed-set-nth header-set-type headers i)
          piece (header-map-edn h)
          acc2 (if (string=? acc "[]")
                 (string-concat "[" (string-concat piece "]"))
                 (string-concat
                  (string-substring acc 0 (- (string-length acc) 1))
                  (string-concat " " (string-concat piece "]"))))]
      (fold-headers-edn headers n (+ i 1) acc2))))

(defn http_req_begin
  [url :string body :string timeout :i64]
  [:ref :kotoba.http.request-edn-set-record/HttpRequest]
  (if (or (= (has-forbidden url) 1)
          (= (has-forbidden body) 1)
          (< timeout 0))
    (map->HttpRequest
     {:url ""
      :headers (typed-set-new header-set-type)
      :names (typed-set-new [:set :string])
      :body ""
      :timeout 0
      :code -3})
    (map->HttpRequest
     {:url url
      :headers (typed-set-new header-set-type)
      :names (typed-set-new [:set :string])
      :body body
      :timeout timeout
      :code 0})))

(defn http_req_code
  [st [:ref :kotoba.http.request-edn-set-record/HttpRequest]]
  :i64
  (:code st))

(defn http_req_count
  [st [:ref :kotoba.http.request-edn-set-record/HttpRequest]]
  :i64
  (typed-set-count header-set-type (:headers st)))

(defn http_req_add_header
  [st [:ref :kotoba.http.request-edn-set-record/HttpRequest]
   name :string value :string]
  [:ref :kotoba.http.request-edn-set-record/HttpRequest]
  (let [{:keys [url headers names body timeout code]} st]
    (if (not= code 0)
      (map->HttpRequest {:url url :headers headers :names names
                         :body body :timeout timeout :code code})
      (if (= (string-length name) 0)
        (map->HttpRequest {:url url :headers headers :names names
                           :body body :timeout timeout :code -1})
        (if (or (= (has-forbidden name) 1) (= (has-forbidden value) 1))
          (map->HttpRequest {:url url :headers headers :names names
                             :body body :timeout timeout :code -3})
          (if (typed-set-contains [:set :string] names name)
            (map->HttpRequest {:url url :headers headers :names names
                               :body body :timeout timeout :code -9})
            (if (>= (typed-set-count header-set-type headers) 32)
              (map->HttpRequest {:url url :headers headers :names names
                                 :body body :timeout timeout :code -4})
              (let [h (->Header name value)
                    headers2 (typed-set-conj header-set-type headers h)
                    names2 (typed-set-conj [:set :string] names name)]
                (map->HttpRequest {:url url :headers headers2 :names names2
                                   :body body :timeout timeout :code 0})))))))))

;; Full request EDN: url + folded headers vector + body + timeout-ms
(defn http_req_edn
  [st [:ref :kotoba.http.request-edn-set-record/HttpRequest]]
  :string
  (let [{:keys [code url body timeout headers]} st
        n (typed-set-count header-set-type headers)]
    (if (not= code 0)
      ""
      (let [hv (fold-headers-edn headers n 0 "[]")]
        (string-concat "{:url \""
                       (string-concat url
                                      (string-concat "\" :headers "
                                                     (string-concat hv
                                                                    (string-concat " :body \""
                                                                                   (string-concat body
                                                                                                  (string-concat "\" :timeout-ms "
                                                                                                                 (string-concat (nat-str timeout) "}"))))))))))))

;; main → -9002: two headers, full EDN has url+headers+body+timeout, dup → -9
(defn main [] :i64
  (let [s0 (http_req_begin "https://x.test" "{}" 1000)
        s1 (http_req_add_header s0 "Host" "ex.com")
        s2 (http_req_add_header s1 "Accept" "*/*")
        e (http_req_edn s2)
        s3 (http_req_add_header s2 "Host" "other")
        c (http_req_code s3)
        n (http_req_count s2)
        ok (if (string-contains? e "https://x.test")
             (if (string-contains? e "Accept")
               (if (string-contains? e "Host")
                 (if (string-contains? e "timeout-ms")
                   (if (string-contains? e ":headers") 1 0)
                   0)
                 0)
               0)
             0)]
    (if (= c -9)
      (if (= n 2)
        (if (= ok 1) -9002 -9001)
        c)
      c)))
