(ns kotoba.edn.recursive-kv4
  ;; T8.3 / W4 fourth ops slice ADR 0249: 4-field true nested pair(k,v)
  ;; maps enabled by compiler ADR 0196 / kir ADR 0025 (parametric-adt-depth 12).
  ;; Completes request {:url :headers :body :timeout-ms} and result arms with
  ;; 4 fields under true-kv (not entry-atom preformat). Nested records in
  ;; recursive variants still outside closed schema. Does NOT alone flip
  ;; wasm-aot :implemented (host I/O + record-in-variant open).
  (:schemas {:edn/node [:variant :edn/node
                         [[:atom :string]
                          [:pair [:vector [[:ref :edn/node]
                                           [:ref :edn/node]]]]]]})
  (:export [edn_atom
            edn_pair
            edn_print
            header_kv_edn
            headers_list_edn
            request_kv4_edn
            result_ok_kv4_edn
            result_err_kv4_edn
            main]))

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- qstr [s :string] :string
  (string-concat (string-substring "\"x" 0 1)
                 (string-concat s (string-substring "\"x" 0 1))))

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn edn_atom [s :string]
  [:variant :edn/node
    [[:atom :string]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :atom s))

(defn edn_pair
  [l [:variant :edn/node
       [[:atom :string]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   r [:variant :edn/node
       [[:atom :string]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  [:variant :edn/node
    [[:atom :string]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :pair
   (hetero-vector [:vector [[:ref :edn/node] [:ref :edn/node]]] l r)))

(defn edn_print
  [n [:variant :edn/node
       [[:atom :string]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (match-variant n
   [:variant :edn/node
     [[:atom :string]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
    (:atom s s)
    (:pair p
      (string-concat
       (edn_print (nth p 0))
       (string-concat " "
                      (edn_print (nth p 1)))))))

(defn- kv
  [k :string v :string]
  [:variant :edn/node
    [[:atom :string]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (edn_pair (edn_atom k) (edn_atom v)))

(defn- brace-print
  [n [:variant :edn/node
       [[:atom :string]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (string-concat "{" (string-concat (edn_print n) "}")))

(defn header_kv_edn [name :string value :string] :string
  (if (or (= (string-length name) 0)
          (= (has-forbidden name) 1)
          (= (has-forbidden value) 1))
    ""
    (brace-print
     (edn_pair (kv ":name" (qstr name))
               (kv ":value" (qstr value))))))

(defn headers_list_edn
  [name1 :string value1 :string name2 :string value2 :string]
  :string
  (let [a (header_kv_edn name1 value1)
        b (header_kv_edn name2 value2)]
    (if (or (= (string-length a) 0)
            (= (string-length b) 0))
      ""
      (let [tree (edn_pair (edn_atom a) (edn_atom b))]
        (string-concat "[" (string-concat (edn_print tree) "]"))))))

;; 4-field request (depth-12):
;;   {:url "…" :headers […] :body "…" :timeout-ms N}
(defn request_kv4_edn
  [url :string body :string timeout :i64 headers-edn :string]
  :string
  (if (or (= (has-forbidden url) 1)
          (= (has-forbidden body) 1)
          (< timeout 0)
          (= (string-length headers-edn) 0))
    ""
    (brace-print
     (edn_pair (kv ":url" (qstr url))
               (edn_pair (kv ":headers" headers-edn)
                         (edn_pair (kv ":body" (qstr body))
                                   (kv ":timeout-ms" (nat-str timeout))))))))

;; 4-field ok arm:
;;   {:tag :ok :status N :headers […] :body "…"}
(defn result_ok_kv4_edn
  [status :i64 body :string headers-edn :string]
  :string
  (if (or (< status 100)
          (> status 599)
          (= (has-forbidden body) 1)
          (= (string-length headers-edn) 0))
    ""
    (brace-print
     (edn_pair (kv ":tag" ":ok")
               (edn_pair (kv ":status" (nat-str status))
                         (edn_pair (kv ":headers" headers-edn)
                                   (kv ":body" (qstr body))))))))

;; 4-field err arm:
;;   {:tag :error :code "…" :message "…" :retryable true|false}
(defn result_err_kv4_edn
  [code :string message :string retryable :i64]
  :string
  (if (or (= (string-length code) 0)
          (= (has-forbidden code) 1)
          (= (has-forbidden message) 1))
    ""
    (brace-print
     (edn_pair (kv ":tag" ":error")
               (edn_pair (kv ":code" (qstr code))
                         (edn_pair (kv ":message" (qstr message))
                                   (kv ":retryable"
                                       (if (= retryable 1) "true" "false"))))))))

(defn main [] :i64
  (let [hdrs (headers_list_edn "Accept" "text/plain" "Host" "ex.com")
        bad-hdrs (headers_list_edn "" "v" "Host" "ex.com")
        req (request_kv4_edn "https://ex.com/a" "hi" 30 hdrs)
        bad-req (request_kv4_edn "https://ex.com" "x" 30 bad-hdrs)
        bad-to (request_kv4_edn "https://ex.com" "x" -1 hdrs)
        ok (result_ok_kv4_edn 200 "ok" hdrs)
        bad-ok (result_ok_kv4_edn 99 "ok" hdrs)
        err (result_err_kv4_edn "timeout" "slow" 1)
        bad-err (result_err_kv4_edn "" "m" 0)
        good-req (if (string-contains? req ":url")
                   (if (string-contains? req "https://ex.com/a")
                     (if (string-contains? req ":headers")
                       (if (string-contains? req ":timeout-ms")
                         (if (string-contains? req "30")
                           (if (string-contains? req ":body") 1 0)
                           0)
                         0)
                       0)
                     0)
                   0)
        good-ok (if (string-contains? ok ":tag")
                  (if (string-contains? ok ":ok")
                    (if (string-contains? ok "200")
                      (if (string-contains? ok ":headers")
                        (if (string-contains? ok "Accept") 1 0)
                        0)
                      0)
                    0)
                  0)
        good-err (if (string-contains? err ":error")
                   (if (string-contains? err "timeout")
                     (if (string-contains? err ":retryable")
                       (if (string-contains? err "true") 1 0)
                       0)
                     0)
                   0)
        ok-bad-1 (if (= (string-length bad-hdrs) 0) 1 0)
        ok-bad-2 (if (= (string-length bad-req) 0) 1 0)
        ok-bad-3 (if (= (string-length bad-to) 0) 1 0)
        ok-bad-4 (if (= (string-length bad-ok) 0) 1 0)
        ok-bad-5 (if (= (string-length bad-err) 0) 1 0)
        ok-bad (if (= ok-bad-1 1)
                 (if (= ok-bad-2 1)
                   (if (= ok-bad-3 1)
                     (if (= ok-bad-4 1)
                       (if (= ok-bad-5 1) 1 0)
                       0)
                     0)
                   0)
                 0)]
    (if (= good-req 1)
      (if (= good-ok 1)
        (if (= good-err 1)
          (if (= ok-bad 1) -2404 -1)
          -1)
        -1)
      -1)))
