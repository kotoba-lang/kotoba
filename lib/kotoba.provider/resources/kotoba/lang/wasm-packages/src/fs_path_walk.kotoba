(ns kotoba.fs.walk
  (:export [fs_path_begin fs_path_next fs_path_end]))

;; Pure multi-step scoped-fs path policy (ADR 0181).
;; Composes path-len (0174) + path gates (0177) into one host-walk protocol.
;;
;; fs_path_begin(len) → 100 (need-first) | -1 empty | -2 oversize
;; fs_path_next(state, c) → next state | sticky error
;;   PRE(100): first-char /→-5 ~→-6 else step from initial state 4
;;   state 0..7: prev_slash*4+dots (same as ADR 0177)
;; fs_path_end(state) → 0 | -7 trailing . / ..
;;
;; Hand WAT one-shot + typed-string fs_path_ok (0180) retained.

(defn fs_path_begin
  [len :i64]
  :i64
  (if (<= len 0)
    -1
    (if (> len 1024)
      -2
      100)))

(defn- step
  [state :i64 c :i64]
  :i64
  (let [prev (quot state 4)
        dots (- state (* prev 4))]
    (if (= c 0)
      -3
      (if (= c 92)
        -4
        (if (= c 47)
          (if (or (= dots 1) (= dots 2))
            -7
            4)
          (if (= prev 1)
            (if (= c 46) 1 3)
            (if (= dots 1)
              (if (= c 46) 2 3)
              (if (= dots 2)
                3
                dots))))))))

(defn fs_path_next
  [state :i64 c :i64]
  :i64
  (if (< state 0)
    state
    (if (= state 100)
      (if (= c 47)
        -5
        (if (= c 126)
          -6
          (step 4 c)))
      (step state c))))

(defn fs_path_end
  [state :i64]
  :i64
  (if (< state 0)
    state
    (if (= state 100)
      -1
      (let [prev (quot state 4)
            dots (- state (* prev 4))]
        (if (or (= dots 1) (= dots 2))
          -7
          0)))))
