(ns kotoba.secret.name-ok
  (:export [secret_name_ok main]))

;; Typed-string single-call secret name policy (ADR 0178).
;; Requires kotoba:typed host (browser-host / typed ABI). Not pure Component.

(defn- char-forbidden?
  [c :i64]
  :i64
  (if (or (= c 0) (= c 9) (= c 10) (= c 32)
          (= c 42) (= c 47) (= c 63) (= c 92))
    1
    0))

(defn secret_name_ok
  [name :string]
  :i64
  (let [n (string-length name)]
    (if (<= n 0)
      -1
      (if (> n 128)
        -2
        (loop [i 0]
          (if (>= i n)
            0
            (let [c (string-code-point-at name i)]
              (if (= (char-forbidden? c) 1)
                -3
                (recur (+ i 1))))))))))

;; Live host proof vector (browser-host requires main):
;; ok=0, empty=-1, slash=-3, ok-name=0 → 0*1000 + (-1)*100 + (-3)*10 + 0 = -130
(defn main []
  :i64
  (let [a (secret_name_ok "ok")
        b (secret_name_ok "")
        c (secret_name_ok "has/slash")
        d (secret_name_ok "ok-name")]
    (+ (* a 1000) (* b 100) (* c 10) d)))
