(ns kotoba.http.header-name-ok
  (:export [http_header_name_ok main]))

;; Typed-string single-call HTTP header-name policy (ADR 0187).
;; Enforces RFC 7230 token (tchar) + length [1,128].
;; Requires kotoba:typed host. Not pure Component.
;; Codes:
;;   -1 empty
;;   -2 name >128
;;   -3 non-tchar code point
;;    0 ok
;;
;; tchar = ALPHA / DIGIT / "!" / "#" / "$" / "%" / "&" / "'" /
;;         "*" / "+" / "-" / "." / "^" / "_" / "`" / "|" / "~"

(defn- tchar?
  [c :i64]
  :i64
  (if (or (and (>= c 48) (<= c 57))
          (and (>= c 65) (<= c 90))
          (and (>= c 97) (<= c 122))
          (= c 33)
          (= c 35)
          (= c 36)
          (= c 37)
          (= c 38)
          (= c 39)
          (= c 42)
          (= c 43)
          (= c 45)
          (= c 46)
          (= c 94)
          (= c 95)
          (= c 96)
          (= c 124)
          (= c 126))
    1
    0))

(defn http_header_name_ok
  [name :string]
  :i64
  (let [n (string-length name)]
    (if (<= n 0)
      -1
      (if (> n 128)
        -2
        (loop [i 0]
          (if (>= i n)
            0
            (let [c (string-code-point-at name i)]
              (if (= (tchar? c) 1)
                (recur (+ i 1))
                -3))))))))

;; Live vector: ok=0 empty=-1 space=-3 ok2=0 → 0*1000 + (-1)*100 + (-3)*10 + 0 = -130
(defn main []
  :i64
  (let [a (http_header_name_ok "Content-Type")
        b (http_header_name_ok "")
        c (http_header_name_ok "Bad Name")
        d (http_header_name_ok "x-request-id")]
    (+ (* a 1000) (* b 100) (* c 10) d)))
