(ns kotoba.http.header-edn
  (:export [http_header_edn]))

;; T8.3 reject-path composition on edn_quoted (ADR 0215): header map with
;; dual quote/backslash reject. Body is admission skeleton; Canonical WAT
;; owns the dual UTF-8 scan (kotoba-component :http-header-edn). Trust-path
;; pure concat twin remains http_header_edn_trust. Full multi-export
;; request-edn reject package still open.

(defn http_header_edn
  [name :string value :string]
  :string
  (string-concat "{:name \""
                 (string-concat name
                                (string-concat "\" :value \""
                                               (string-concat value "\"}")))))
