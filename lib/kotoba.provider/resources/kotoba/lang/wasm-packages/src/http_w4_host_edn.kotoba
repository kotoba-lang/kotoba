(ns kotoba.http.w4-host-edn
  ;; T8.3 / host-I/O first slice: W4 record-kv request EDN + typed-cap-call
  ;; :http/post string→string forward (host inject). Main stays pure encode
  ;; proof (no live network). Does NOT flip wasm-aot :implemented.
  (:schemas {:edn/node [:variant :edn/node
                         [[:atom :string]
                          [:entry [:ref :kotoba.http.w4-host-edn/EdnKeyValue]]
                          [:pair [:vector [[:ref :edn/node]
                                           [:ref :edn/node]]]]]]})
  (:capabilities #{:http/post})
  (:export [request_rec_kv_edn
            result_ok_rec_kv_edn
            host_post_edn
            main]))

(defrecord EdnKeyValue [k :string v :string])

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- qstr [s :string] :string
  (string-concat (string-substring "\"x" 0 1)
                 (string-concat s (string-substring "\"x" 0 1))))

(defn- digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn- nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn- edn_atom [s :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.http.w4-host-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.http.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :atom s))

(defn- edn_entry [k :string v :string]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.http.w4-host-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.http.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :entry
   (->EdnKeyValue k v)))

(defn- edn_pair
  [l [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.http.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   r [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.http.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  [:variant :edn/node
    [[:atom :string]
     [:entry [:ref :kotoba.http.w4-host-edn/EdnKeyValue]]
     [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
  (variant-new
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.http.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
   :pair
   (hetero-vector [:vector [[:ref :edn/node] [:ref :edn/node]]] l r)))

(defn- edn_print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.http.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (match-variant n
   [:variant :edn/node
     [[:atom :string]
      [:entry [:ref :kotoba.http.w4-host-edn/EdnKeyValue]]
      [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]
    (:atom s s)
    (:entry r
      (string-concat
       (:k r)
       (string-concat " "
                      (:v r))))
    (:pair p
      (string-concat
       (edn_print (nth p 0))
       (string-concat " "
                      (edn_print (nth p 1)))))))

(defn- brace-print
  [n [:variant :edn/node
       [[:atom :string]
        [:entry [:ref :kotoba.http.w4-host-edn/EdnKeyValue]]
        [:pair [:vector [[:ref :edn/node] [:ref :edn/node]]]]]]]
  :string
  (string-concat "{" (string-concat (edn_print n) "}")))

(defn request_rec_kv_edn
  [url :string body :string timeout :i64 headers-edn :string]
  :string
  (if (or (= (has-forbidden url) 1)
          (= (has-forbidden body) 1)
          (< timeout 0)
          (= (string-length headers-edn) 0))
    ""
    (brace-print
     (edn_pair (edn_entry ":url" (qstr url))
               (edn_pair (edn_entry ":headers" headers-edn)
                         (edn_pair (edn_entry ":body" (qstr body))
                                   (edn_entry ":timeout-ms" (nat-str timeout))))))))

(defn result_ok_rec_kv_edn
  [status :i64 body :string headers-edn :string]
  :string
  (if (or (< status 100)
          (> status 599)
          (= (has-forbidden body) 1)
          (= (string-length headers-edn) 0))
    ""
    (brace-print
     (edn_pair (edn_entry ":tag" ":ok")
               (edn_pair (edn_entry ":status" (nat-str status))
                         (edn_pair (edn_entry ":headers" headers-edn)
                                   (edn_entry ":body" (qstr body))))))))

;; Host inject surface: encode W4 request EDN then forward via :http/post.
(defn host_post_edn
  [url :string body :string timeout :i64 headers-edn :string]
  :string
  (let [req (request_rec_kv_edn url body timeout headers-edn)]
    (if (= (string-length req) 0)
      ""
      (typed-cap-call :http/post :string :string req))))

(defn main [] :i64
  (let [req (request_rec_kv_edn "https://ex.com/a" "hi" 30 "[]")
        bad (request_rec_kv_edn "https://ex.com" "x" -1 "[]")
        ok (result_ok_rec_kv_edn 200 "ok" "[]")
        good-req (if (string-contains? req ":url")
                   (if (string-contains? req ":timeout-ms")
                     (if (string-contains? req "30") 1 0)
                     0)
                   0)
        good-ok (if (string-contains? ok ":ok")
                  (if (string-contains? ok "200") 1 0)
                  0)
        ok-bad (if (= (string-length bad) 0) 1 0)]
    (if (= good-req 1)
      (if (= good-ok 1)
        (if (= ok-bad 1) -2506 -1)
        -1)
      -1)))
