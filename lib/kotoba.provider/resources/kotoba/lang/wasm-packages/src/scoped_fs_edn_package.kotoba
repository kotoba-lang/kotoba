(ns kotoba.scoped-fs.edn-package
  ;; T8.3 ADR 0243: pure scoped-fs kit fixed-depth EDN surface.
  ;; Request: read (root+path) and write (root+path+value).
  ;; Reply: content / written / error. Dual quote/backslash scan on string leaves.
  ;; Path policy slice: non-empty, no leading /, no ".." segment, length bounds.
  ;; Host store remains host-injected. W4 recursive nested EDN open; wasm-aot :partial.
  (:export [fs_req_read_edn
            fs_req_write_edn
            fs_reply_content_edn
            fs_reply_written_edn
            fs_reply_error_edn
            main]))

;; Sticky reject codes (not returned; empty string means reject):
;;  path/root/value empty or forbidden " \
;;  path starts with / or contains .. segment
;;  path-bytes > 1024; value-bytes > 65536
;;  root not simple keyword body [A-Za-z0-9_-]+
;;  written not in {0,1}

(defn- has-forbidden [s :string] :i64
  (let [n (string-length s)]
    (loop [i 0]
      (if (>= i n) 0
        (let [c (string-code-point-at s i)]
          (if (= c 34) 1
            (if (= c 92) 1 (recur (+ i 1)))))))))

(defn- root-ok [root :string] :i64
  (let [n (string-length root)]
    (if (or (<= n 0) (> n 64)) 0
      (loop [i 0]
        (if (>= i n) 1
          (let [c (string-code-point-at root i)]
            (if (or (and (>= c 65) (<= c 90))
                    (and (>= c 97) (<= c 122))
                    (and (>= c 48) (<= c 57))
                    (= c 95)
                    (= c 45))
              (recur (+ i 1))
              0)))))))

(defn- path-has-dotdot [path :string] :i64
  ;; true if path contains "/../" or starts with "../" or ends with "/.."
  ;; or is exactly ".."
  (if (string=? path "..") 1
    (if (string-contains? path "/../") 1
      (if (string-contains? path "../") 1
        (if (string-contains? path "/..") 1
          0)))))

(defn- path-ok [path :string] :i64
  (let [n (string-length path)]
    (if (or (<= n 0) (> n 1024)) 0
      (if (= (has-forbidden path) 1) 0
        (if (= (string-code-point-at path 0) 47) 0
          (if (= (path-has-dotdot path) 1) 0
            1))))))

(defn fs_req_read_edn
  [root :string path :string]
  :string
  (if (or (= (root-ok root) 0) (= (path-ok path) 0))
    ""
    (string-concat "{:tag :read :root :"
                   (string-concat root
                                  (string-concat " :path \""
                                                 (string-concat path "\"}"))))))

(defn fs_req_write_edn
  [root :string path :string value :string]
  :string
  (if (or (= (root-ok root) 0)
          (= (path-ok path) 0)
          (= (has-forbidden value) 1)
          (> (string-length value) 65536))
    ""
    (string-concat "{:tag :write :root :"
                   (string-concat root
                                  (string-concat " :path \""
                                                 (string-concat path
                                                                (string-concat "\" :value \""
                                                                               (string-concat value "\"}"))))))))

(defn fs_reply_content_edn
  [content :string]
  :string
  (if (or (= (has-forbidden content) 1)
          (> (string-length content) 65536))
    ""
    (string-concat "{:tag :content :content \""
                   (string-concat content "\"}"))))

(defn fs_reply_written_edn
  [written :i64]
  :string
  (if (= written 1)
    "{:tag :written :written true}"
    (if (= written 0)
      "{:tag :written :written false}"
      "")))

(defn fs_reply_error_edn
  [code :string message :string]
  :string
  (if (or (= (string-length code) 0)
          (= (has-forbidden code) 1)
          (= (has-forbidden message) 1))
    ""
    (string-concat "{:tag :error :code \""
                   (string-concat code
                                  (string-concat "\" :message \""
                                                 (string-concat message "\"}"))))))

;; main → -2313: read/write req ok, three reply arms ok, rejects
(defn main [] :i64
  (let [rd (fs_req_read_edn "workspace" "docs/a.txt")
        wr (fs_req_write_edn "workspace" "docs/a.txt" "hello")
        content (fs_reply_content_edn "hello")
        written (fs_reply_written_edn 1)
        err (fs_reply_error_edn "not-found" "missing")
        bad-root (fs_req_read_edn "" "a")
        bad-path (fs_req_read_edn "workspace" "../etc/passwd")
        bad-abs (fs_req_read_edn "workspace" "/abs")
        bad-val (fs_req_write_edn "workspace" "a" "x\"y")
        bad-written (fs_reply_written_edn 2)
        bad-err (fs_reply_error_edn "" "m")
        good (if (string-contains? rd ":tag :read")
               (if (string-contains? rd "docs/a.txt")
                 (if (string-contains? wr ":tag :write")
                   (if (string-contains? content ":tag :content")
                     (if (string-contains? written ":written true")
                       (if (string-contains? err ":tag :error") 1 0)
                       0)
                     0)
                   0)
                 0)
               0)]
    (if (and (= good 1)
             (= (string-length bad-root) 0)
             (= (string-length bad-path) 0)
             (= (string-length bad-abs) 0)
             (= (string-length bad-val) 0)
             (= (string-length bad-written) 0)
             (= (string-length bad-err) 0))
      -2313
      -1)))
