(ns kotoba.secret.value-wire
  ;; T8.3 / ADR 0285: first slice where the GUEST decides the canonical
  ;; `kotoba.value.v1` bytes of a provider ops-audit envelope, instead of the
  ;; host parsing guest EDN text and re-encoding it (`legacy-edn->audit-bytes`).
  ;;
  ;; The typed export ABI carries strings and i64 only, so the byte sequence
  ;; leaves the guest as lowercase hex. Hex is transport over that ABI, not a
  ;; second encoding: the host un-hexes byte-for-byte and makes no semantic
  ;; choice. The oracle is `provider.value-codec/encode-audit-value`, compared
  ;; byte-for-byte in `provider.value-wire-test`.
  ;;
  ;; Canonical map key order is shorter-encoding-first then bytewise unsigned
  ;; (`ipld.value` order-key). Every shape here is closed at author time, so
  ;; that order is a compile-time constant. Ordering for arbitrary
  ;; runtime-shaped maps is NOT in the guest yet — see the ADR residual.
  ;;
  ;; The keyword forms of the closed key/value names are written as literals
  ;; rather than recomputed per call: the guest arena is a bump allocator with
  ;; no reclamation, and per-character `string-concat` is quadratic. Deriving
  ;; all thirteen per call exhausted one instance after five calls; folding
  ;; them to literals and adding the hex table below took a request encode from
  ;; five to eighteen calls per instance (measured).
  ;; The literals are not magic — `provider.value-wire-test` asserts each one
  ;; equals what this module's own exported `kw_form` produces.
  ;;
  ;; Admission is deliberately identical to `kotoba.secret.record-kv-edn`
  ;; (ADR 0251): empty name rejected, name > 128 rejected, `"` and `\` rejected.
  ;; The canonical wire has no escaping problem and COULD admit quotes, but the
  ;; two audit evidence fields must not disagree about what was admitted.
  ;; Widening is a separate decision.
  ;;
  ;; Does NOT flip wasm-aot :implemented: host-fetch authority stays injected.
  (:export [hex_byte
            cbor_text
            kw_form
            str_form
            secret_request_audit_hex
            secret_reply_value_audit_hex
            secret_reply_error_audit_hex
            main]))

;; One substring per byte over a 256-entry table. The obvious two-nibble form
;; (two lookups plus a concat) costs three allocations per byte instead of one,
;; and the guest arena is a bump allocator with no reclamation, so the
;; difference is visible in how many calls one instance survives: measured
;; 10 -> 18 for `secret_request_audit_hex` and 6 -> 10 for
;; `secret_reply_error_audit_hex`.
(defn hex_byte [b :i64] :string
  (string-substring
   ""
   (* 2 b)
   (+ (* 2 b) 2)))

;; UTF-8 byte hex of an ASCII-only payload. A code point >= 128 fails closed:
;; the CBOR text header carries a BYTE length, and this slice does not encode
;; multi-byte UTF-8 yet. `"` and `\` mirror the EDN kit's forbidden set.
(defn- ascii-hex-from [s :string i :i64 n :i64 acc :string] :string
  (if (>= i n)
    acc
    (let [c (string-code-point-at s i)]
      (if (>= c 128)
        ""
        (if (= c 34)
          ""
          (if (= c 92)
            ""
            (ascii-hex-from s (+ i 1) n (string-concat acc (hex_byte c)))))))))

;; CBOR major type 3 (text) header over a BYTE length.
(defn- text-header [len :i64] :string
  (if (< len 24)
    (hex_byte (+ 96 len))
    (if (< len 256)
      (string-concat "78" (hex_byte len))
      (if (< len 65536)
        (string-concat "79"
                       (string-concat (hex_byte (quot len 256))
                                      (hex_byte (bit-and len 255))))
        ""))))

;; Every helper returns a non-empty hex string for admitted input (the shortest
;; is "60", empty text), so "" is an unambiguous fail-closed sentinel.
(defn cbor_text [s :string] :string
  (let [n (string-length s)]
    (if (= n 0)
      "60"
      (let [body (ascii-hex-from s 0 n "")
            head (text-header n)]
        (if (= (string-length body) 0)
          ""
          (if (= (string-length head) 0)
            ""
            (string-concat head body)))))))

;; [code-keyword 5, text] as a 2-element CBOR array.
(defn kw_form [name :string] :string
  (let [t (cbor_text name)]
    (if (= (string-length t) 0)
      ""
      (string-concat "8205" t))))

;; [code-string 4, text] as a 2-element CBOR array.
(defn str_form [s :string] :string
  (let [t (cbor_text s)]
    (if (= (string-length t) 0)
      ""
      (string-concat "8204" t))))

;; [19 map, array(4)] then the pair (:kit :secret) — the constant envelope head.
(defn- envelope-head [] :string
  "821384828205636b6974820566736563726574")

;; "82" then the keyword form of :value — opens the pair carrying the arm map.
(defn- value-key [] :string
  "8282056576616c7565")

;; pair (:format :provider.ops-audit/v1) then pair (:direction :request).
(defn- tail-request [] :string
  "82820566666f726d617482057570726f76696465722e6f70732d61756469742f763182820569646972656374696f6e82056772657175657374")

;; pair (:format :provider.ops-audit/v1) then pair (:direction :reply).
(defn- tail-reply [] :string
  "82820566666f726d617482057570726f76696465722e6f70732d61756469742f763182820569646972656374696f6e8205657265706c79")

(defn- envelope [arm-map :string tail :string] :string
  (if (= (string-length arm-map) 0)
    ""
    (string-concat (envelope-head)
                   (string-concat (value-key)
                                  (string-concat arm-map tail)))))

;; {:name "…"} — one pair.
(defn secret_request_audit_hex [name :string] :string
  (if (= (string-length name) 0)
    ""
    (if (> (string-length name) 128)
      ""
      (let [v (str_form name)]
        (if (= (string-length v) 0)
          ""
          (envelope (string-concat "821381828205646e616d65" v)
                    (tail-request)))))))

;; {:tag :value :value "…"} — encoded key order: tag, value.
(defn secret_reply_value_audit_hex [value :string] :string
  (let [v (str_form value)]
    (if (= (string-length v) 0)
      ""
      (envelope (string-concat "8213828282056374616782056576616c75658282056576616c7565" v)
                (tail-reply)))))

;; {:tag :error :code "…" :message "…"} — encoded key order: tag, code, message.
(defn secret_reply_error_audit_hex [code :string message :string] :string
  (if (= (string-length code) 0)
    ""
    (let [c (str_form code)
          m (str_form message)]
      (if (= (string-length c) 0)
        ""
        (if (= (string-length m) 0)
          ""
          (envelope
           (string-concat "821383828205637461678205656572726f7282820564636f6465"
                          (string-concat c
                                         (string-concat "828205676d657373616765" m)))
           (tail-reply)))))))

(defn main [] :i64
  (let [req (secret_request_audit_hex "API_TOKEN")
        bad-empty (secret_request_audit_hex "")
        bad-quote (secret_request_audit_hex "a\"b")
        good-req (if (string-contains?
                      req
                      "821384828205636b69748205667365637265748282056576616c7565821381828205646e616d658204694150495f544f4b454e82820566666f726d617482057570726f76696465722e6f70732d61756469742f763182820569646972656374696f6e82056772657175657374")
                   1 0)
        ok-bad (if (= (string-length bad-empty) 0)
                 (if (= (string-length bad-quote) 0) 1 0)
                 0)]
    (if (= good-req 1)
      (if (= ok-bad 1) -2407 -1)
      -1)))
