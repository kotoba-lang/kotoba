(ns kotoba.http.error-result-ok
  (:export [http_error_ok http_result_arm_ok main]))

;; Typed-string HTTP **error arm + result variant tag** (ADR 0191).
;; Complements response_ok (0190) toward full result EDN codec AOT.
;; Requires kotoba:typed for code/message strings.
;;
;; http_error_ok(code, message, retryable):
;;   -1 code empty
;;   -2 code length >128
;;   -3 code non-[A-Za-z0-9/_:.-]
;;   -4 message length >65536
;;   -5 retryable ∉ {0,1}
;;    0 ok
;;
;; http_result_arm_ok(arm):
;;   -1 arm ∉ {0,1}   (0=:ok, 1=:error)
;;    0 ok
;;
;; Does not pack nested response/error records or keyword intern.

(defn- code-char-ok?
  [c :i64]
  :i64
  (if (or (and (>= c 48) (<= c 57))
          (and (>= c 65) (<= c 90))
          (and (>= c 97) (<= c 122))
          (= c 47)
          (= c 58)
          (= c 46)
          (= c 45)
          (= c 95))
    1
    0))

(defn- code-ok
  [code :string]
  :i64
  (let [n (string-length code)]
    (if (<= n 0)
      -1
      (if (> n 128)
        -2
        (loop [i 0]
          (if (>= i n)
            0
            (let [c (string-code-point-at code i)]
              (if (= (code-char-ok? c) 0)
                -3
                (recur (+ i 1))))))))))

(defn http_error_ok
  [code :string message :string retryable :i64]
  :i64
  (let [cr (code-ok code)
        mn (string-length message)]
    (if (not= cr 0)
      cr
      (if (> mn 65536)
        -4
        (if (or (< retryable 0) (> retryable 1))
          -5
          0)))))

(defn http_result_arm_ok
  [arm :i64]
  :i64
  (if (or (< arm 0) (> arm 1))
    -1
    0))

;; Live vector:
;; error-ok=0, empty-code=-1, bad-char=-3, bad-retry=-5, arm-ok=0, arm-bad=-1
;; 0*100000 + (-1)*10000 + (-3)*1000 + (-5)*100 + 0*10 + (-1) = -13501
(defn main []
  :i64
  (let [a (http_error_ok "http/transport" "failed" 0)
        b (http_error_ok "" "x" 0)
        c (http_error_ok "bad name" "x" 0)
        d (http_error_ok "http/ok" "x" 2)
        e (http_result_arm_ok 1)
        f (http_result_arm_ok 3)]
    (+ (* a 100000) (* b 10000) (* c 1000) (* d 100) (* e 10) f)))
