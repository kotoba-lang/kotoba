(ns kotoba.http.request-edn-only
  (:export [http_request_edn]))

;; T8.3 multi-header request EDN reject-path (ADR 0220). Composition on
;; edn_quoted + headers shape. Body is admission skeleton; Canonical WAT owns
;; dual scan, headers […] shape, timeout ≥ 0, i64 decimal. Multi-export kit body still open.

(defn http_request_edn
  [url :string headers :string body :string timeout-ms :i64]
  :string
  (if (< timeout-ms 0)
    ""
    (string-concat "{:url \""
                   (string-concat url
                                  (string-concat "\" :headers "
                                                 (string-concat headers
                                                                (string-concat " :body \""
                                                                               (string-concat body
                                                                                              "\" :timeout-ms 0}"))))))))
