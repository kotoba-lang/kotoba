{:kotoba.capability-kit/name :dataspace
 :kotoba.capability-kit/version 1
 :capability {:name :dataspace/transact :id 24}
 :semantics {:ownership :host
             :isolation :per-provider-instance
             :ordering :synchronous-linearized
             :ambient-access false
             :resource :dataspace
             :operations [:assert :retract :observe :facet-enter :facet-leave]
             :assertions :document-inert
             :pattern-bindings "?symbol-or-:?keyword"
             :wildcard #{_ :_}
             :maps :keys-present-extra-ok
             :observe-model :host-owned-in-process-notice-delivery
             :observe-current-set :replay-matching-assertions-as-document-notices-at-observe-time
             :observe-retract :document-notice-on-matching-retract
             :facet-exit :retracts-owned-assertions-and-drops-observations-and-undelivered-notices
             :authority "Lexical/argument possession of this capability. Serializing an assertion or writing #cap does not restore authority."
             :encoding :in-process-document
             :wire :kotoba.value.v1
             :not :preserves}
 :limits {:assertions 256
          :observers 64
          :facets 32
          :assertion :document
          :pattern :document}
 :request
 [:variant :kotoba.dataspace/request
  [[:assert [:record :kotoba.dataspace/assert
             [[:assertion :document] [:facet :i64]]]]
   [:retract [:record :kotoba.dataspace/retract
              [[:assertion :document] [:facet :i64]]]]
   [:observe [:record :kotoba.dataspace/observe
              [[:pattern :document] [:facet :i64]]]]
   [:facet-enter :bool]
   [:facet-leave :i64]]]
 :result
 [:variant :kotoba.dataspace/result
  [[:asserted [:record :kotoba.dataspace/asserted
               [[:count :i64] [:notices :document]]]]
   [:retracted [:record :kotoba.dataspace/retracted [[:count :i64]]]]
   [:matches [:record :kotoba.dataspace/matches
              [[:bindings :document] [:notices :document]]]]
   [:facet [:record :kotoba.dataspace/facet [[:id :i64]]]]
   [:error [:record :kotoba.dataspace/error
            [[:code :keyword] [:message :string]]]]]]
 :qualification {:reference :implemented :wasm-aot :pending
                 :native-aot :pending :jit :pending}}
