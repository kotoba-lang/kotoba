{:kotoba.capability-kit/name :git
 :kotoba.capability-kit/version 1
 :capability {:name :git/run :id 22}
 :semantics {:operation :run-subcommand
             :ambient-path false
             :ambient-cwd false
             :subcommand-policy :allowlist-read-oriented
             :path-escape-reject true
             :destination-authority :host-injected-run
             :execution :synchronous-reference}
 :limits {:argv 64 :arg-bytes 4096 :stdout-bytes 65536 :timeout-ms [1 600000]}
 :request
 [:record :kotoba.git/run-request
  [[:args [:vector :string]]
   [:max-stdout-bytes :i64]
   [:timeout-ms :i64]]]
 :result
 [:variant :kotoba.git/reply
  [[:ok [:record :kotoba.git/run-result
          [[:exit :i64] [:stdout :string] [:stderr :string]]]]
   [:error [:record :kotoba.git/error
             [[:code :keyword] [:message :string]]]]]]
 :transports
 {:echo :test
  :os-run-jvm :landed
  :os-run-cljs :landed}
 :qualification {:reference :implemented
                 :dual-runtime-os-transport :landed
                 :tooling-cutover :landed
                 :wasm-aot :partial
                 :codec-aot :implemented
                 :native-aot :pending
                 :jit :pending
                 :signed-content-addressed-package :ready
                 :notes "ADR 0170 hand bounds Component + 0172 compiler-AOT one-shot + 0184 multi-step arg walk. Git binary host-injected. Codec AOT open (wasm-aot :partial). ADR 0240/0241 fixed-depth git request/reply EDN package (main -2311). OS git host-injected; ADR 0253 W4 record-typed recursive EDN (main -2503). OS git host-injected; codec-aot implemented (ADR 0256); host authority keeps wasm-aot :partial."}}
