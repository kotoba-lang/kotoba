{:kotoba.capability-kit/name :scoped-fs
 :kotoba.capability-kit/version 1
 :capability {:name :fs/transact :id 19}
 :semantics {:operations [:read :write]
             :ambient-filesystem false
             :path-policy :root-relative-no-escape
             :destination-authority :host-declared-roots
             :execution :synchronous-reference}
 :limits {:path-bytes 1024 :value-bytes 65536}
 :request
 [:variant :kotoba.fs/request
  [[:read [:record :kotoba.fs/read-request
            [[:root :keyword] [:path :string]]]]
   [:write [:record :kotoba.fs/write-request
             [[:root :keyword] [:path :string] [:value :string]]]]]]
 :result
 [:variant :kotoba.fs/result
  [[:content :string]
   [:written :bool]
   [:error [:record :kotoba.fs/error
             [[:code :keyword] [:message :string]]]]]]
 :transports
 {:mem :test
  :os-store-jvm :landed
  :os-store-cljs :landed}
 :qualification {:reference :implemented
                 :dual-runtime-os-transport :landed
                 :wasm-aot :partial
                 :codec-aot :implemented
                 :native-aot :pending
                 :jit :pending
                 :signed-content-addressed-package :ready
                 :notes "ADR 0169 hand scan; 0174/0175 length; 0177 gates; 0180 typed-string fs_path_ok; 0181 pure multi-step walk; 0207 fs_path_ok pure Component (path state machine). ADR 0243 fixed-depth scoped-fs request/reply EDN package (main -2313). Host store authority. ADR 0255 W4 record-kv request/reply (main -2505). Host store open; codec-aot implemented (ADR 0256); host authority keeps wasm-aot :partial."}}
