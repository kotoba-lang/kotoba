{:kotoba.capability-kit/name :http-ingress
 :kotoba.capability-kit/version 1
 :semantics {:direction :host-injects-guest-polls
             :ambient-listen false
             :listen-authority :host-only
             :pairing :accept-then-reply
             :max-queue-depth 8
             :max-pending-accept 1
             :execution :synchronous-reference}
 :limits {:path-bytes 4096 :headers 32 :body-bytes 65536
          :status [100 599] :queue-depth [1 256]}
 :capabilities
 [{:name :http/accept :id 17
   :request
   [:record :kotoba.http/accept-request [[:slot :i64]]]
   :result
   [:option
    [:record :kotoba.http/incoming-request
     [[:method :keyword] [:path :string]
      [:headers [:set [:record :kotoba.http/header
                       [[:name :keyword] [:value :string]]]]]
      [:body :string]]]]}
  {:name :http/reply :id 18
   :request
   [:record :kotoba.http/response
    [[:status :i64]
     [:headers [:set [:record :kotoba.http/header
                      [[:name :keyword] [:value :string]]]]]
     [:body :string]]]
   :result :bool}]
 :qualification {:reference :implemented :wasm-aot :pending
                 :native-aot :pending :jit :pending}}
