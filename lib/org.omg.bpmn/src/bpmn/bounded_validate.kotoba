(ns bpmn.bounded-validate
  (:export [validate]))

(def summary-type
  [:record :bpmn/bounded-validation-summary
   [[:error-count :i64] [:warning-count :i64] [:valid-flag :i64]]])
(def validation-result-type [:result [:alias summary-type] :keyword])

(defn fail [reason :keyword] [:alias validation-result-type]
  (result-err-of validation-result-type reason))

(defn node-offset [index :i64] :i64 (+ 2 (* index 3)))
(defn flow-base [node-count :i64] :i64 (+ 2 (* node-count 3)))
(defn flow-offset [node-count :i64 index :i64] :i64
  (+ (flow-base node-count) (* index 4)))
(defn node-id [data :vector-i64 index :i64] :i64
  (vector-at data (node-offset index)))
(defn node-type [data :vector-i64 index :i64] :i64
  (vector-at data (+ (node-offset index) 1)))
(defn node-default [data :vector-i64 index :i64] :i64
  (vector-at data (+ (node-offset index) 2)))
(defn flow-id [data :vector-i64 nodes :i64 index :i64] :i64
  (vector-at data (flow-offset nodes index)))
(defn flow-source [data :vector-i64 nodes :i64 index :i64] :i64
  (vector-at data (+ (flow-offset nodes index) 1)))
(defn flow-target [data :vector-i64 nodes :i64 index :i64] :i64
  (vector-at data (+ (flow-offset nodes index) 2)))
(defn flow-condition [data :vector-i64 nodes :i64 index :i64] :i64
  (vector-at data (+ (flow-offset nodes index) 3)))

(defn valid-node-encoding? [data :vector-i64 nodes :i64 index :i64] :bool
  (if (= index nodes) true
    (let [id (node-id data index)
          type (node-type data index)
          default-id (node-default data index)]
      (if (< id 0) false
        (if (or (< type 0) (> type 4)) false
          (if (< default-id -1) false
            (valid-node-encoding? data nodes (+ index 1))))))))

(defn valid-flow-encoding?
  [data :vector-i64 nodes :i64 flows :i64 index :i64] :bool
  (if (= index flows) true
    (let [id (flow-id data nodes index)
          source (flow-source data nodes index)
          target (flow-target data nodes index)
          condition (flow-condition data nodes index)]
      (if (or (< id 0) (< source 0)) false
        (if (< target 0) false
          (if (or (< condition 0) (> condition 1)) false
            (valid-flow-encoding? data nodes flows (+ index 1))))))))

(defn unique-node-ids?
  [data :vector-i64 nodes :i64 left :i64 right :i64] :bool
  (if (= left nodes) true
    (if (= right nodes)
      (unique-node-ids? data nodes (+ left 1) (+ left 2))
      (if (= (node-id data left) (node-id data right)) false
        (unique-node-ids? data nodes left (+ right 1))))))

(defn unique-flow-ids?
  [data :vector-i64 nodes :i64 flows :i64 left :i64 right :i64] :bool
  (if (= left flows) true
    (if (= right flows)
      (unique-flow-ids? data nodes flows (+ left 1) (+ left 2))
      (if (= (flow-id data nodes left) (flow-id data nodes right)) false
        (unique-flow-ids? data nodes flows left (+ right 1))))))

(defn node-exists?
  [data :vector-i64 nodes :i64 wanted :i64 index :i64] :bool
  (if (= index nodes) false
    (if (= wanted (node-id data index)) true
      (node-exists? data nodes wanted (+ index 1)))))

(defn dangling-errors
  [data :vector-i64 nodes :i64 flows :i64 index :i64] :i64
  (if (= index flows) 0
    (+ (if (node-exists? data nodes (flow-source data nodes index) 0) 0 1)
       (if (node-exists? data nodes (flow-target data nodes index) 0) 0 1)
       (dangling-errors data nodes flows (+ index 1)))))

(defn type-count
  [data :vector-i64 nodes :i64 wanted :i64 index :i64] :i64
  (if (= index nodes) 0
    (+ (if (= wanted (node-type data index)) 1 0)
       (type-count data nodes wanted (+ index 1)))))

(defn incoming-count
  [data :vector-i64 nodes :i64 flows :i64 wanted :i64 index :i64] :i64
  (if (= index flows) 0
    (+ (if (= wanted (flow-target data nodes index)) 1 0)
       (incoming-count data nodes flows wanted (+ index 1)))))

(defn outgoing-count
  [data :vector-i64 nodes :i64 flows :i64 wanted :i64 index :i64] :i64
  (if (= index flows) 0
    (+ (if (= wanted (flow-source data nodes index)) 1 0)
       (outgoing-count data nodes flows wanted (+ index 1)))))

(defn unconditioned-outgoing-count
  [data :vector-i64 nodes :i64 flows :i64 wanted :i64 index :i64] :i64
  (if (= index flows) 0
    (+ (if (= wanted (flow-source data nodes index))
         (if (= 0 (flow-condition data nodes index)) 1 0) 0)
       (unconditioned-outgoing-count data nodes flows wanted (+ index 1)))))

(defn node-warnings
  [data :vector-i64 nodes :i64 flows :i64 index :i64] :i64
  (if (= index nodes) 0
    (let [id (node-id data index)
          type (node-type data index)
          default-id (node-default data index)
          incoming (incoming-count data nodes flows id 0)
          outgoing (outgoing-count data nodes flows id 0)
          unconditioned (unconditioned-outgoing-count data nodes flows id 0)
          no-incoming (if (= type 0) 0 (if (= incoming 0) 1 0))
          no-outgoing (if (= type 1) 0 (if (= outgoing 0) 1 0))
          exclusive (if (= type 2)
                      (if (> outgoing 1)
                        (if (= default-id -1)
                          (if (> unconditioned 0) 1 0) 0) 0) 0)
          inclusive (if (= type 3)
                      (if (> outgoing 0)
                        (if (= default-id -1)
                          (if (= unconditioned 0) 1 0) 0) 0) 0)]
      (+ no-incoming no-outgoing exclusive inclusive
         (node-warnings data nodes flows (+ index 1))))))

(defn finish [data :vector-i64 nodes :i64 flows :i64]
  [:alias validation-result-type]
  (let [errors (dangling-errors data nodes flows 0)
        warnings (+ (if (= (type-count data nodes 0 0) 0) 1 0)
                    (if (= (type-count data nodes 1 0) 0) 1 0)
                    (node-warnings data nodes flows 0))]
    (result-ok-of validation-result-type
      (record summary-type errors warnings (if (= errors 0) 1 0)))))

(defn validate [data :vector-i64] [:alias validation-result-type]
  (if (< (vector-count data) 2) (fail :truncated-header)
    (let [nodes (vector-at data 0)
          flows (vector-at data 1)]
      (if (or (< nodes 0) (> nodes 4)) (fail :node-count-out-of-range)
        (if (or (< flows 0) (> flows 3)) (fail :flow-count-out-of-range)
          (if (= (vector-count data) (+ 2 (* nodes 3) (* flows 4)))
            (if (valid-node-encoding? data nodes 0)
              (if (valid-flow-encoding? data nodes flows 0)
                (if (unique-node-ids? data nodes 0 1)
                  (if (unique-flow-ids? data nodes flows 0 1)
                    (finish data nodes flows)
                    (fail :duplicate-flow-id))
                  (fail :duplicate-node-id))
                (fail :invalid-flow-encoding))
              (fail :invalid-node-encoding))
            (fail :malformed-length)))))))
