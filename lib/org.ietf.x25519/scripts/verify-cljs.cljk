#!/usr/bin/env kbb
;; Run the suite on the ClojureScript side.
;;
;; Not a formality. The field is a `long-array` on the JVM and a
;; `Float64Array` here, and the two hold intermediates differently: a JVM
;; long wraps at 2^63 while a JavaScript number stops being an exact integer
;; at 2^53. Every product and carry in `x25519.field` is sized to stay under
;; the smaller of those, and this is what checks that it does.
;;
;;   kbb --backend sci --classpath "$(kbb -A:cljs -Spath)" scripts/verify-cljs.cljk
(ns verify-cljs
  (:require [kotoba.test :as t]
            [x25519.core-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println)
  (if (t/successful? m)
    (println "all checks passed on the ClojureScript path")
    (do (println "FAILED on the ClojureScript path")
        (js/process.exit 1))))

(t/run-tests 'x25519.core-test)
