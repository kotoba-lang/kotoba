;; No dependencies. X25519 is a Montgomery ladder over one field, and the
;; field is sixteen 16-bit limbs because neither the JVM's BigInteger nor
;; ClojureScript's BigInt can be named in a portable file.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-paths ["test"]}

  ;; The differential oracle. BouncyCastle is test-scoped and never reaches
  ;; :deps: it is what this is CHECKED AGAINST, not something it builds on.
  ;; Both -d directories are named, because the runner defaults to `test`
  ;; alone and would otherwise exit 0 having never loaded the oracle suite.
  :oracle {:extra-paths ["test" "oracle"]
           :extra-deps {org.bouncycastle/bcprov-jdk18on {:mvn/version "1.78.1"}
                        io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
           :main-opts ["-m" "cognitect.test-runner" "-d" "test" "-d" "oracle"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "oracle"
                     "--fail-level" "error"]}}}
