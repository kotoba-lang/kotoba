;; btc-crypto — Bitcoin-specific crypto/encoding for Clojure/babashka.
;; RIPEMD-160 + Base58Check + Bech32/Bech32m + BIP-32/39/44 + WIF + P2PKH/
;; P2WPKH addresses + legacy/BIP-143 tx signing. Builds on kotoba-lang's
;; eth-crypto (secp256k1 EC math — same curve as Bitcoin) and crypto
;; (SHA-256) rather than re-deriving them.
{:paths ["src" "resources"]
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/eth-crypto {:local/root "../kotoba.ethCrypto"}
        io.github.kotoba-lang/crypto {:local/root "../kotoba.crypto"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
