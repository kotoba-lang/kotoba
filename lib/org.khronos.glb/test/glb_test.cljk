(ns glb-test
  (:require [kotoba.lang.text] [kotoba.test :refer [deftest is testing]]
            [glb]
            [glb.json]))

(deftest namespace-loads
  (testing "the namespace loads"
    (is (some? (find-ns 'glb)))
    (is (some? (find-ns 'glb.json)))))

;; ---------------------------------------------------------------------------
;; Header framing
;; ---------------------------------------------------------------------------

(deftest glb-header-valid
  (let [out (glb/write-glb {:json {:asset {:version "2.0"}} :bin [1 2 3 4 5 6 7]})]
    ;; magic "glTF"
    (is (= (vec (take 4 out)) (glb/u32->le-bytes glb/glb-magic)))
    ;; version 2
    (is (= (subvec (vec out) 4 8) (glb/u32->le-bytes glb/glb-version)))
    ;; total length header field matches actual byte count
    (is (= (glb/le-bytes->u32 (subvec (vec out) 8 12)) (count out)))
    ;; JSON chunk type tag ascii "JSON" right after the JSON chunk length u32
    (is (= (subvec (vec out) 16 20) [0x4A 0x53 0x4F 0x4E]))))

;; ---------------------------------------------------------------------------
;; Round trip — the property this whole repo exists to guarantee
;; ---------------------------------------------------------------------------

(def ^:private non-trivial-json
  {:asset {:version "2.0" :generator "kotoba-lang/glb-test"}
   :scene 0
   :scenes [{:nodes [0 1]}]
   :nodes [{:mesh 0 :name "root"} {:mesh 1 :translation [1.0 2.5 -3.0]}]
   :meshes [{:primitives [{:attributes {:POSITION 0 :NORMAL 1} :indices 2 :material 0}]}]
   :materials [{:pbrMetallicRoughness {:baseColorFactor [1.0 0.0 0.0 1.0]
                                        :metallicFactor 0.0
                                        :roughnessFactor 0.5}
                :doubleSided true
                :emissiveFactor nil}]
   :extras {:note "quotes \" and backslash \\ and a newline\n survive round-trip"}})

(def ^:private non-trivial-bin
  (vec (range 0 36))) ;; 36 bytes: already 4-byte aligned, so no trailing
                       ;; padding is appended and a direct `=` comparison
                       ;; against the parsed :bin is exact, not just a prefix.

(deftest round-trip-structural
  (let [out (glb/write-glb {:json non-trivial-json :bin non-trivial-bin})
        {:keys [json bin]} (glb/parse-glb out)]
    (testing "JSON survives structurally (parsed map == original map)"
      (is (= non-trivial-json json)))
    (testing "binary blob survives byte-for-byte"
      (is (= non-trivial-bin (vec bin))))))

(deftest round-trip-bin-padding-is-a-suffix
  ;; A bin length that is NOT 4-byte aligned gets zero-padded up to the next
  ;; boundary on write; parse returns the full (padded) chunk, matching the
  ;; original `vrm.glb/parse-glb` semantics — the caller compares only the
  ;; known-length prefix.
  (let [bin (vec (range 0 37)) ;; 37 bytes -> 3 bytes of zero padding
        out (glb/write-glb {:json {:a 1} :bin bin})
        parsed-bin (vec (:bin (glb/parse-glb out)))]
    (is (= 40 (count parsed-bin)))
    (is (= bin (subvec parsed-bin 0 (count bin))))
    (is (= [0 0 0] (subvec parsed-bin (count bin) (count parsed-bin))))))

(deftest round-trip-nil-bin
  (let [out (glb/write-glb {:json {:a 1} :bin nil})
        {:keys [json bin]} (glb/parse-glb out)]
    (is (= {:a 1} json))
    (is (or (nil? bin) (= [] (vec bin))))))

(deftest round-trip-pre-serialized-json-string
  ;; :json may already be a serialized JSON string (skip auto-encoding).
  (let [json-str "{\"asset\":{\"version\":\"2.0\"}}"
        out (glb/write-glb {:json json-str :bin [9 9 9]})
        {:keys [json bin]} (glb/parse-glb out)]
    (is (= {:asset {:version "2.0"}} json))
    (is (= [9 9 9] (subvec (vec bin) 0 3)))))

;; ---------------------------------------------------------------------------
;; Raw tier (bytes in/out, no JSON encode/decode) — what `vrm.glb`'s facade
;; and `kotoba-lang/gltf` (which builds its own pre-serialized JSON bytes)
;; actually call.
;; ---------------------------------------------------------------------------

(deftest raw-round-trip
  (let [json-bytes (glb/string->byte-seq "{\"asset\":{\"version\":\"2.0\"}}")
        bin-bytes [1 2 3 4 5 6 7]
        out (glb/write-glb-raw json-bytes bin-bytes)
        {:keys [json bin]} (glb/parse-glb-raw out)]
    (is (= (kotoba.lang.text/trim (glb/byte-seq->string json)) "{\"asset\":{\"version\":\"2.0\"}}"))
    (is (= bin-bytes (subvec (vec bin) 0 (count bin-bytes))))))

(deftest ergonomic-and-raw-tiers-agree
  ;; write-glb with pre-serialized bytes must produce byte-identical output to
  ;; write-glb-raw with the same bytes (no hidden re-encoding).
  (let [json-bytes (glb/string->byte-seq "{\"a\":1}")
        bin-bytes [1 2 3]]
    (is (= (glb/write-glb-raw json-bytes bin-bytes)
           (glb/write-glb {:json json-bytes :bin bin-bytes})))))

;; ---------------------------------------------------------------------------
;; Error handling — mirrors the original `vrm.glb` test coverage
;; ---------------------------------------------------------------------------

(deftest invalid-magic
  (is (thrown? #?(:clj Exception :cljs js/Error) (glb/parse-glb-raw (vec (repeat 20 0))))))

(deftest too-short
  (is (thrown? #?(:clj Exception :cljs js/Error) (glb/parse-glb-raw [])))
  (is (thrown? #?(:clj Exception :cljs js/Error) (glb/parse-glb-raw (vec (repeat 8 0))))))

;; ---------------------------------------------------------------------------
;; JSON codec
;; ---------------------------------------------------------------------------

(deftest json-round-trip-basic
  (is (= "null" (glb.json/->json nil)))
  (is (= "true" (glb.json/->json true)))
  (is (= "\"VEC3\"" (glb.json/->json "VEC3")))
  (is (= "[1,2,3]" (glb.json/->json [1 2 3])))
  (is (= "{\"a\":1}" (glb.json/->json {:a 1})))
  (is (= {:a 1} (glb.json/parse "{\"a\":1}")))
  (is (= [1 2 3] (glb.json/parse "[1,2,3]")))
  (is (= 1.5 (glb.json/parse "1.5")))
  (is (= non-trivial-json (glb.json/parse (glb.json/->json non-trivial-json)))))

(deftest le-byte-roundtrip
  (is (= 42 (glb/le-bytes->u32 (glb/u32->le-bytes 42))))
  (is (= 0x46546C67 (glb/le-bytes->u32 (glb/u32->le-bytes 0x46546C67)))))

(deftest pad-len-rounds-to-4
  (is (= 0 (glb/pad-len 0)))
  (is (= 0 (glb/pad-len 4)))
  (is (= 3 (glb/pad-len 1)))
  (is (= 2 (glb/pad-len 2)))
  (is (= 1 (glb/pad-len 3))))
