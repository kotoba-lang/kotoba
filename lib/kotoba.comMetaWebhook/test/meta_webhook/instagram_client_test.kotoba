(ns meta-webhook.instagram-client-test (:export [main]) (:require [meta-webhook.instagram-client :as p]))

(defn- fedn [d :document k :keyword] :string
  (document-edn-print (option-or (document-get d k) (document-null))))

(defn- fstr [d :document k :keyword] :string
  (option-or (document-string-value (option-or (document-get d k) (document-null))) "?"))

(defn main [] :i64
  (let [creds (document-map :ig-user-id (document-string "123") :access-token (document-string "tok"))
        req (p/send-message-request creds (document-string "IGSID1") (document-string "hi"))
        ok (p/send-message-result (document-i64 200) (document-map :message_id (document-string "m1")))
        bad (p/send-message-result (document-i64 400) (document-string "nope"))]
    (+ (if (string=? (fstr req :url) "https://graph.facebook.com/v21.0/123/messages?access_token=tok") 0 1)
       (if (string=? (fedn req :method) ":post") 0 1)
       (if (string=? (fedn (option-or (document-get req :body) (document-null)) :message) "{:text \"hi\"}") 0 1)
       (if (string=? (fedn ok :message_id) "\"m1\"") 0 1)
       (if (string=? (fedn bad :ok) "false") 0 1)
       (if (string=? (fedn bad :status) "400") 0 1))))
