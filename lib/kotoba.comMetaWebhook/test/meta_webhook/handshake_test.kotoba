(ns meta-webhook.handshake-test
  (:export [main])
  (:require [meta-webhook.handshake :as h]))

(defn- check [ok :bool] :i64 (if ok 0 1))

(defn main [] :i64
  (+ (check (h/verify-handshake-accepted? "subscribe" "tok" "tok"))
     (check (not (h/verify-handshake-accepted? "unsubscribe" "tok" "tok")))
     (check (not (h/verify-handshake-accepted? "subscribe" "bad" "tok")))
     (check (not (h/verify-handshake-accepted? "subscribe" "" "")))
     (check (not (h/verify-handshake-accepted? "subscribe" "x" "")))))
