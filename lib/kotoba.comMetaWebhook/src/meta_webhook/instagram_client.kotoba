;; Port of meta-webhook.instagram-client (instagram_client.cljk), send side only.
;;
;; Named divergences from instagram_client.cljk:
;;   - send-message! is NOT ported as a function: it takes injected
;;     :http-fn / :json-write / :json-read function values, and :fn values
;;     are not available in Kotoba (E2105). The port is split into the two
;;     pure halves: send-message-request builds the request document, and
;;     send-message-result interprets (status, body).
;;   - JSON encoding and decoding are left to the caller: the request :body is
;;     a :document map, and a 200 response returns the body document as given
;;     (the source runs json-read on it).
;;   - The URL carries access_token in its query string, as the source does.
;;     Nothing in this port performs the request.

(ns meta-webhook.instagram-client
  (:export [send-message-request send-message-result]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- str-of [v :document] :string
  (option-or (document-string-value v) ""))

(defn send-message-request [creds :document recipient-id :document text :document] :document
  (let [url (string-concat (string-concat (string-concat "https://graph.facebook.com/v21.0/"
                                                         (str-of (field creds :ig-user-id)))
                                          "/messages?access_token=")
                           (str-of (field creds :access-token)))]
    (document-map :url (document-string url)
                  :method (document-keyword :post)
                  :headers (document-map (document-string "Content-Type") (document-string "application/json"))
                  :body (document-map :recipient (document-map :id recipient-id)
                                      :message (document-map :text text)))))

(defn send-message-result [status :document body :document] :document
  (if (document-equal? status (document-i64 200))
    body
    (document-map :ok (document-bool false) :status status :error body)))
