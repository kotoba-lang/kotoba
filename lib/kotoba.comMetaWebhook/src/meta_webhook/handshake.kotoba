;; Kotoba port of lib/kotoba.comMetaWebhook/src/meta_webhook/handshake.cljk.
;;
;; Named divergence: the .cljk returns the challenge string (or nil) so the
;; caller echoes it. Kotoba has no nil, and a "" sentinel would make an empty
;; challenge indistinguishable from rejection. The port therefore returns the
;; accept/reject decision as :bool under a new name; the caller keeps its own
;; challenge and echoes it when this returns true. The three hub.* values are
;; separate arguments instead of a map. The comparison logic is unchanged.
(ns meta-webhook.handshake
  (:export [verify-handshake-accepted?]))

(defn verify-handshake-accepted? [mode :string verify-token :string expected :string] :bool
  (and (= mode "subscribe")
       (not= expected "")
       (= verify-token expected)))
