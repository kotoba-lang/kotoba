{:paths ["src"]
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/org-ietf-cbor {:local/root "../org.ietf.cbor"}
        io.github.kotoba-lang/io-multiformats {:local/root "../kotoba.ioMultiformats"}
        io.github.kotoba-lang/org-ietf-ed25519 {:local/root "../org.ietf.ed25519"}
        io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/osaho.git"
         :git/sha "afd117d2533ed0b30eb5a4848083a94e25b01b40"}
        io.github.kotoba-lang/io-ipld {:local/root "../kotoba.ioIpld"}
        io.github.kotoba-lang/kotobase-storage {:local/root "../kotoba.kotobaseStorage"}}
 :aliases
  {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :semantic-cljs
  {:extra-paths ["test-cljs"]
   :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.42"}}
   :main-opts ["-m" "cljs.main"
               "-co" "{:target :nodejs, :output-to \"target/semantic-cljs.js\", :optimizations :none}"
               "-m" "kotoba.codebase.semantic-code-portable-test"]}
  ;; The evaluation layer under ClojureScript, against an in-memory
  ;; ICodebaseStore. `:semantic-cljs` proves the two runtimes agree on a hash;
  ;; this proves the hash is RUNNABLE on the side kotobase deploys to.
  :eval-cljs
  {:extra-paths ["test-cljs"]
   :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.42"}}
   :main-opts ["-m" "cljs.main"
               "-co" "{:target :nodejs, :output-to \"target/eval-cljs.js\", :optimizations :none}"
               "-m" "kotoba.codebase.evaluation-portable-test"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
