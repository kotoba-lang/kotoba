(ns test-native-lease-transport
  "Mechanism fault cases only; actual artifact admission is tested separately."
  (:require [cljs.test :as t :refer [deftest is]]
            [kototama.native.lease-transport :as transport]))
(def node (.-execPath js/process))
(def env {})
(defn child [code callback & [options]]
  (transport/run! [node "-e" code] env
     (merge {:call! callback :timeout-ms 1000 :output-limit 4096} options)))
(def io "const fs=require('node:fs');const b=Buffer.alloc(96);")
(defn refused? [f] (try (f) false (catch :default _ true)))
(deftest synchronous-ordered-roundtrip
  (let [calls (atom [])
        r (child (str io "for(let i=1;i<=2;i++){fs.writeSync(3,'Q '+i+' 1 41\\n');const n=fs.readSync(4,b,0,96,null);if(b.subarray(0,n).toString()!=='R '+i+' 42\\n')process.exit(9);}process.stdout.write('done');")
                 (fn [id x] (swap! calls conj [id x]) (+ x (js/BigInt 1))))]
    (is (= 0 (:exit r))) (is (= "done" (:stdout r)))
    (is (= [[1 (js/BigInt 41)] [1 (js/BigInt 41)]] @calls))))
(deftest framing-refuses-before-provider
  (doseq [frame ["Q 2 1 41\n" "Q 1 0 41\n" "Q 1 1 9223372036854775808\n"
                 "Q 1 1 41\nQ 2 1 41\n" "Q 1 1 41" (apply str (repeat 200 "x"))]]
    (let [calls (atom 0)]
      (is (refused? #(child (str io "fs.writeSync(3," (js/JSON.stringify frame) ");setTimeout(()=>{},500);")
                              (fn [_ _] (swap! calls inc) (js/BigInt 42)))))
      (is (= 0 @calls)))))
(deftest provider-failure-never-falls-back
  (let [r (child (str io "fs.writeSync(3,'Q 1 1 41\\n');const n=fs.readSync(4,b,0,96,null);process.stdout.write(b.subarray(0,n));")
                 (fn [_ _] (throw (ex-info "denied" {}))))]
    (is (= "D 1\n" (:stdout r))) (is (= 0 (:exit r)))))
(deftest deadline-and-output-bounds
  (let [r (child "setTimeout(()=>{},10000)" (fn [_ _] (js/BigInt 42)) {:timeout-ms 100})]
    (is (:timed-out? r)) (is (not= 0 (:exit r))))
  (let [r (child "process.stdout.write('x'.repeat(5000));setTimeout(()=>{},1000)" (fn [_ _] (js/BigInt 42)))]
    (is (:output-exceeded? r)) (is (not= 0 (:exit r))))
  (is (refused? #(child "process.exit(0)" (fn [_ _] 42) {:timeout-ms 5001}))))
(defmethod t/report [:cljs.test/default :end-run-tests] [r]
  (println (select-keys r [:test :pass :fail :error]))
  (when (or (zero? (:test r)) (pos? (+ (:fail r) (:error r)))) (set! (.-exitCode js/process) 1)))
(t/run-tests 'test-native-lease-transport)
