{:native.lease-transport/version 2
 :owner "kotoba-lang/kototama-native" :entrypoint kototama.native.lease-transport/run!
 :host [:node :posix] :execution :synchronous :worker-role [:process-io :deadline :process-group-kill]
 :policy-owner "kotoba-lang/kototama" :callback :process-local-host-only
 :guest-authority :none :request-fd 3 :response-fd 4
 :request "Q <sequence> <wire-id> <signed-i64>\n"
 :response "R <same-sequence> <signed-i64>\n" :denial "D <same-sequence>\n"
 :bounds {:frame-bytes 96 :calls 4096 :timeout-ms 5000 :output-bytes 65536 :bindings 64}
 :scope [:capability-cid :resource-cid :purpose]
 :before-every-effect [:refresh-authority :refresh-lease :refresh-binding :durable-reserve :provider]
 :late-response :cannot-revive-child :failed-use :never-refunded
 :unsupported [:windows :jvm :aggregate-values :async :ambient-fallback]
 :qualification :bootstrap-host-not-q9}
