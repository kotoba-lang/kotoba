(ns hig-document
  ;; Delivery 6 third cutover (shitsuke HIG). Same document vocabulary as
  ;; tokens_document with prefix fixed to "hig".
  ;; T5.2 + document-in-record (compiler 7691b1ae): multi-arg pure fold.
  ;;
  ;; The entry points are exported, so a host can call them. They were not —
  ;; like tokens_document this module carried no comment about it either way.
  ;; Measured 2026-08-12, two things refuse a declared list and neither is the
  ;; parity harness: it must contain `main` ("main entrypoint must be
  ;; exported"), and `ir/execute` runs exported functions only ("function is
  ;; not exported"), so the harness names its own appended cases in it too.
  ;;
  ;; The list is narrower than tokens_document's on purpose: only the vendored
  ;; sample corpora and the renderer have a caller today, and a `:document`
  ;; crosses the entry boundary in both directions, so a host composes
  ;; `(render-group (sample-colors-doc))` across two calls. The constructors
  ;; (`entry` / `group-doc` / `nested-doc`), the folds and the field readers
  ;; stay internal until something asks for them; tokens_document is where the
  ;; construction surface is exercised.
  (:export [main render-group layer-order-css sample-root sample-colors-doc sample-body-text-doc])
  (:schemas {:higdoc/entry [:record :higdoc/entry
                            [[:name :keyword] [:value :string]]]
             :higdoc/group [:record :higdoc/group
                            [[:group :string] [:entries :document]]]
             :higdoc/nested [:record :higdoc/nested
                             [[:group :string] [:name :string] [:props :document]]]
             :higdoc/render-from [:record :higdoc/render-from
                                  [[:doc :document] [:index :i64] [:acc :string]]]
             :higdoc/line-from [:record :higdoc/line-from
                                [[:group :document] [:entry :document]]]}))

(defn entry [x [:ref :higdoc/entry]] :document
  (let [name (record-get x :name)
        value (record-get x :value)]
    (document-map :name (document-keyword name)
                  :value (document-string value))))

(defn group-doc [x [:ref :higdoc/group]] :document
  (let [group (record-get x :group)
        entries (record-get x :entries)]
    (document-map :prefix (document-string "hig")
                  :group (document-string group)
                  :entries entries)))

(defn nested-doc [x [:ref :higdoc/nested]] :document
  (let [group (record-get x :group)
        k (record-get x :name)
        props (record-get x :props)]
    (document-map :prefix (document-string "hig")
                  :group (document-string group)
                  :name (document-string k)
                  :nested (document-bool true)
                  :props props)))

(defn str-field [d :document k :keyword] :string
  (option-or
    (document-string-value
      (option-or (document-get d k) (document-null)))
    ""))

(defn name-of-entry [d :document] :string
  (keyword-name
   (option-or
     (document-keyword-value
       (option-or (document-get d :name) (document-null)))
     :missing)))

(defn value-of-entry [d :document] :string
  (str-field d :value))

(defn entries-of [d :document] :document
  (option-or (document-get d :entries) (document-vector)))

(defn props-of [d :document] :document
  (option-or (document-get d :props) (document-vector)))

(defn nested? [d :document] :bool
  (option-or
    (document-bool-value
      (option-or (document-get d :nested) (document-null)))
    false))

(defn decl [name :string value :string] :string
  (string-concat "  "
                 (string-concat name
                                (string-concat ": "
                                               (string-concat value ";")))))

(defn css-var-name2 [group :string k :string] :string
  (string-concat "--hig-"
                 (string-concat group (string-concat "-" k))))

(defn scalar-line [x [:ref :higdoc/line-from]] :string
  (let [d (record-get x :group)
        e (record-get x :entry)]
    (decl (css-var-name2 (str-field d :group) (name-of-entry e))
          (value-of-entry e))))

(defn nested-line [x [:ref :higdoc/line-from]] :string
  (let [d (record-get x :group)
        e (record-get x :entry)]
    (decl (string-concat (css-var-name2 (str-field d :group) (str-field d :name))
                         (string-concat "-" (name-of-entry e)))
          (value-of-entry e))))

(defn render-entries-from [x [:ref :higdoc/render-from]] :string
  (let [d (record-get x :doc)
        i (record-get x :index)
        acc (record-get x :acc)
        entries (entries-of d)
        n (document-count entries)]
    (if (>= i n)
      acc
      (let [line (scalar-line
                  (record-new [:ref :higdoc/line-from]
                              d
                              (option-or (document-vector-at entries i)
                                         (document-null))))
            next (if (string=? acc "") line
                     (string-concat acc (string-concat "\n" line)))]
        (render-entries-from
         (record-new [:ref :higdoc/render-from] d (+ i 1) next))))))

(defn render-props-from [x [:ref :higdoc/render-from]] :string
  (let [d (record-get x :doc)
        i (record-get x :index)
        acc (record-get x :acc)
        props (props-of d)
        n (document-count props)]
    (if (>= i n)
      acc
      (let [line (nested-line
                  (record-new [:ref :higdoc/line-from]
                              d
                              (option-or (document-vector-at props i)
                                         (document-null))))
            next (if (string=? acc "") line
                     (string-concat acc (string-concat "\n" line)))]
        (render-props-from
         (record-new [:ref :higdoc/render-from] d (+ i 1) next))))))

(defn render-group [d :document] :string
  (if (nested? d)
    (render-props-from (record-new [:ref :higdoc/render-from] d 0 ""))
    (render-entries-from (record-new [:ref :higdoc/render-from] d 0 ""))))

(defn group-scalar-decl [group :string value :string] :string
  (decl (string-concat "--hig-" group) value))

(defn root-css [body :string] :string
  (string-concat ":root {\n"
                 (string-concat body "\n}")))

(defn layer-order-css [] :string
  "@layer kotoba.hig, kotoba.glass;")

(defn join-nl [a :string b :string] :string
  (string-concat a (string-concat "\n" b)))

(defn sample-colors-doc [] :document
  (group-doc
   (record-new [:ref :higdoc/group] "color"
    (document-vector
     (entry (record-new [:ref :higdoc/entry] :label "#000000"))
     (entry (record-new [:ref :higdoc/entry] :system-background "#FFFFFF"))
     (entry (record-new [:ref :higdoc/entry] :tint "#007AFF"))))))

(defn sample-spacing-doc [] :document
  (group-doc
   (record-new [:ref :higdoc/group] "spacing"
    (document-vector
     (entry (record-new [:ref :higdoc/entry] :1 "4px"))
     (entry (record-new [:ref :higdoc/entry] :4 "16px"))
     (entry (record-new [:ref :higdoc/entry] :content-margin "16px"))))))

(defn sample-radius-doc [] :document
  (group-doc
   (record-new [:ref :higdoc/group] "radius"
    (document-vector
     (entry (record-new [:ref :higdoc/entry] :capsule "999px"))
     (entry (record-new [:ref :higdoc/entry] :xs "6px"))))))

(defn sample-body-text-doc [] :document
  (nested-doc
   (record-new [:ref :higdoc/nested] "text" "body"
    (document-vector
     (entry (record-new [:ref :higdoc/entry] :font-family "var(--hig-font-text)"))
     (entry (record-new [:ref :higdoc/entry] :font-size "17px"))
     (entry (record-new [:ref :higdoc/entry] :font-weight "400"))
     (entry (record-new [:ref :higdoc/entry] :line-height "22px"))))))

(defn sample-display3-text-doc [] :document
  (nested-doc
   (record-new [:ref :higdoc/nested] "text" "display3"
    (document-vector
     (entry (record-new [:ref :higdoc/entry] :font-family "var(--hig-font-display)"))
     (entry (record-new [:ref :higdoc/entry] :font-size "clamp(40px, 5vw + 8px, 64px)"))
     (entry (record-new [:ref :higdoc/entry] :font-weight "700"))
     (entry (record-new [:ref :higdoc/entry] :letter-spacing "-0.02em"))
     (entry (record-new [:ref :higdoc/entry] :line-height "calc(1em + 4px)"))))))

(defn sample-root [] :string
  (root-css
   (join-nl (render-group (sample-colors-doc))
            (join-nl (render-group (sample-spacing-doc))
                     (join-nl (render-group (sample-radius-doc))
                              (join-nl (group-scalar-decl "hairline" "0.5px")
                                       (join-nl (render-group (sample-body-text-doc))
                                                (render-group (sample-display3-text-doc)))))))))

(defn group-digest [d :document] :string
  (document-sha256 d))

(defn group-print [d :document] :string
  (document-print d))

(defn group-read [s :string] :document
  (document-read s))

(defn main []
  (string-byte-length (join-nl (layer-order-css) (sample-root))))
