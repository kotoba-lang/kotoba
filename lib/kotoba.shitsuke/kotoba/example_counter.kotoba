(ns example-counter
  ;; The consumer that proves the two libraries are usable as libraries.
  ;;
  ;; A counter is small on purpose: what it demonstrates is not the counter,
  ;; it is that an app module can `:require` reagent-core and reframe-core and
  ;; get all four re-frame verbs -- init, handle (event), query (subscription)
  ;; and view -- without restating the document shape.
  ;;
  ;; This is what `runtime/reframe-worker.mjs` serves on Cloudflare, and what
  ;; `shitsuke.re-frame.core/install-guest!` routes cljs dispatches into.
  (:require [reagent-core :as rg]
            [reframe-core :as rf])
  (:export [main init handle query view
            init-text handle-text step-text fx-text query-text view-text
            test-init test-handle test-query test-view test-text]))

;; --- init -----------------------------------------------------------------

(defn init [] :document
  (rf/db-assoc-i (rf/db-assoc-str (rf/db-empty) :label "clicks") :count 0))

;; --- events (re-frame's reg-event-db, spelled as one closed dispatch) ------

(defn handle [db :document ev :document] :document
  (let [id (rf/event-id ev)
        n (rf/db-i db :count)]
    (cond
      (= id :counter/inc) (rf/fx-of (rf/db-assoc-i db :count (+ n 1)))
      (= id :counter/dec) (rf/fx-of (rf/db-assoc-i db :count (- n 1)))
      (= id :counter/set) (rf/fx-of (rf/db-assoc-i db :count (rf/event-arg-i ev 0)))
      ;; a reset both changes the db and asks the host to do something: the
      ;; effect is inert data, and performing it stays the host's authority
      (= id :counter/reset) (rf/fx-dispatch (rf/fx-of (rf/db-assoc-i db :count 0))
                                            (rf/event0 :ui/focus))
      :else (rf/fx-of db))))

;; --- subscriptions (reg-sub) ----------------------------------------------

(defn query [db :document q :document] :document
  (let [id (rf/query-id q)]
    (cond
      (= id :counter/count) (document-i64 (rf/db-i db :count))
      (= id :counter/label) (document-string (rf/db-str db :label))
      (= id :counter/positive?) (document-bool (> (rf/db-i db :count) 0))
      :else (document-null))))

;; --- view -----------------------------------------------------------------

(defn label-for [n :i64] :string
  (if (> n 0) "count is positive" "count is zero or below"))

(defn view [db :document] :document
  (let [n (rf/db-i db :count)]
    (rg/el "div"
           (rg/class-attr "shitsuke__counter")
           (rg/children3
            (rg/leaf "h1" (rg/attrs-none) (rf/db-str db :label))
            (rg/leaf "button"
                     (rg/keyed (rg/class-attr "dec") "counter/dec")
                     "-")
            (rg/leaf "button"
                     (rg/keyed (rg/class-attr "inc") "counter/inc")
                     "+")))))

;; --- the text boundary ----------------------------------------------------
;;
;; These four are what an HTTP host calls. Text in, text out, so the Worker
;; that serves this app holds no opinion about events, subscriptions or
;; views -- it moves bytes and decides nothing.
;;
;; The text is EDN, so the caller writes "[:counter/set 5]" and reads the
;; answer with `read-string`. Malformed text traps inside `document-edn-read`
;; before any handler runs; the host turns that trap into a 400, which is the
;; one judgement it is allowed to make.

(defn init-text [] :string
  (rf/edn-print (init)))

(defn handle-text [db-text :string ev-text :string] :string
  (rf/edn-print (handle (rf/edn-read db-text) (rf/edn-read ev-text))))

;; `handle-text` answers the whole {:db .. :fx ..}. A host that only wants to
;; keep the state -- a Worker writing it back to a session store, say -- would
;; otherwise have to parse EDN to find `:db`, which is a decision it should
;; not be making. These two split the answer inside the guest instead.

(defn step-text [db-text :string ev-text :string] :string
  (rf/edn-print (rf/fx-db (handle (rf/edn-read db-text) (rf/edn-read ev-text)))))

(defn fx-text [db-text :string ev-text :string] :string
  (rf/edn-print (rf/fx-list (handle (rf/edn-read db-text) (rf/edn-read ev-text)))))

(defn query-text [db-text :string q-text :string] :string
  (rf/edn-print (query (rf/edn-read db-text) (rf/edn-read q-text))))

(defn view-text [db-text :string] :string
  (rf/edn-print (view (rf/edn-read db-text))))

;; --- tests ----------------------------------------------------------------

(defn test-init [] :bool
  (let [db (init)]
    (and (= 0 (rf/db-i db :count))
         (string=? "clicks" (rf/db-str db :label)))))

(defn test-handle [] :bool
  (let [db (init)
        up (rf/fx-db (handle db (rf/event0 :counter/inc)))
        down (rf/fx-db (handle up (rf/event0 :counter/dec)))
        set7 (rf/fx-db (handle db (rf/event-i :counter/set 7)))
        reset (handle set7 (rf/event0 :counter/reset))
        unknown (handle set7 (rf/event0 :nothing/here))]
    (and (= 1 (rf/db-i up :count))
         (= 0 (rf/db-i down :count))
         (= 7 (rf/db-i set7 :count))
         (= 0 (rf/db-i (rf/fx-db reset) :count))
         ;; the reset asked the host for one effect; the others asked for none
         (= 1 (rf/fx-count reset))
         (= 0 (rf/fx-count (handle db (rf/event0 :counter/inc))))
         ;; an event this module does not handle leaves the db alone
         (= 7 (rf/db-i (rf/fx-db unknown) :count)))))

(defn test-query [] :bool
  (let [db (rf/db-assoc-i (init) :count 1)
        zero (init)]
    (and (= 1 (option-value-of [:option :i64] (document-i64-value (query db (rf/event0 :counter/count))) -1))
         (string=? "clicks" (option-value-of [:option :string] (document-string-value (query db (rf/event0 :counter/label))) ""))
         (option-value-of [:option :bool] (document-bool-value (query db (rf/event0 :counter/positive?))) false)
         ;; the boundary: 0 is NOT positive, and one step either side of it
         ;; has to disagree or the comparison is not being tested at all
         (not (option-value-of [:option :bool] (document-bool-value (query zero (rf/event0 :counter/positive?))) true))
         (not (option-value-of [:option :bool]
                               (document-bool-value (query (rf/db-assoc-i zero :count -1)
                                                           (rf/event0 :counter/positive?)))
                               true)))))

(defn test-view [] :bool
  (let [v (view (init))]
    (and (string=? "div" (rg/tag-of v))
         (= 3 (rg/child-count v))
         (string=? "clicks" (rg/text-of (option-value-of [:option :document]
                                                         (document-vector-at (rg/children-of v) 0)
                                                         (document-null)))))))

(defn test-text [] :bool
  (let [db0 (init-text)
        fx (handle-text db0 (rf/edn-print (rf/event-i :counter/set 5)))
        db1 (rf/edn-print (rf/fx-db (rf/edn-read fx)))
        db1b (step-text db0 "[:counter/set 5]")
        n (rf/edn-read (query-text db1 (rf/edn-print (rf/event0 :counter/count))))]
    (and (= 5 (option-value-of [:option :i64] (document-i64-value n) -1))
         ;; step-text and the :db of handle-text are the same state, and a
         ;; hand-written event text reaches the same place as a built one
         (string=? db1 db1b)
         (= 5 (rf/db-i (rf/edn-read db1b) :count))
         (= 0 (rf/db-i (rf/edn-read db0) :count))
         (string=? "div" (rg/tag-of (rf/edn-read (view-text db1)))))))

(defn main []
  (rf/db-i (rf/fx-db (handle (init) (rf/event0 :counter/inc))) :count))
