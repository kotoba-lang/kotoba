(ns reagent-core
  ;; The view half of the reagent/re-frame pair, written in Kotoba.
  ;;
  ;; `shitsuke.reagent.core` already had a host-independent seam: views are
  ;; plain hiccup DATA, so reagent renders them in the browser and
  ;; `shitsuke.hiccup/->html` renders the identical data for SSR. What the
  ;; seam did not have is a way to write the view itself in Kotoba, and that
  ;; is the only thing missing before a `.cljs` app can move its views across
  ;; without its call sites changing: reagent keeps rendering, re-frame keeps
  ;; dispatching, and the function that produces the tree stops being cljs.
  ;;
  ;; The tree is a `:document`, which is what a Kotoba guest can return, and
  ;; `shitsuke.kotoba.bridge/document->hiccup` turns it back into the hiccup
  ;; the seam already renders. So the data crossing the boundary is inert in
  ;; both directions: no host object, no callback, no DOM name.
  ;;
  ;; These builders are amu's `examples/todo-app.kotoba` `el`/`leaf` lifted
  ;; out of that one example and given attribute and child combinators, so an
  ;; app module composes a view instead of restating the document shape.
  ;;
  ;; Bounds that are real, and named rather than hidden:
  ;;
  ;;   * a `:document` holds 256 nodes (`doc-node-limit`), which is today's
  ;;     ceiling on one Kotoba screen -- about seven todo rows, measured in
  ;;     amu's driver. It is a value budget, not something this module fixes.
  ;;   * attribute VALUES are strings here. A number or a boolean attribute
  ;;     goes through the host's hiccup, not through this builder.
  (:export [main
            el leaf text-node
            attrs-none attr class-attr keyed
            children-none child children1 children2 children3
            tag-of attrs-of children-of text-of child-count
            test-el test-leaf test-attrs test-children test-keyed]))

;; --- reading a document ---------------------------------------------------

(defn dget [d :document k :keyword] :document
  (option-value-of [:option :document] (document-get d k) (document-null)))

(defn dstr [d :document] :string
  (option-value-of [:option :string] (document-string-value d) ""))

(defn dat [v :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at v i) (document-null)))

;; --- elements -------------------------------------------------------------

(defn el [tag :string attrs :document children :document] :document
  (document-map :tag (document-string tag)
                :attrs attrs
                :children children))

(defn leaf [tag :string attrs :document text :string] :document
  (document-map :tag (document-string tag)
                :attrs attrs
                :text (document-string text)))

(defn text-node [s :string] :document
  (leaf "span" (document-map) s))

;; --- attributes -----------------------------------------------------------

(defn attrs-none [] :document
  (document-map))

(defn attr [a :document k :keyword v :string] :document
  (document-assoc a k (document-string v)))

(defn class-attr [c :string] :document
  (attr (attrs-none) :class c))

;; `data-k` is the nominal identity an event comes back on -- the guest names
;; the node, the host reports which name was acted on, and no node handle ever
;; crosses. It is reagent's `:key` in the place where reagent cannot help,
;; because the guest has no reference to the element it drew.
(defn keyed [a :document k :string] :document
  (attr a :data-k k))

;; --- children -------------------------------------------------------------

(defn children-none [] :document
  (document-vector))

(defn child [cs :document c :document] :document
  (document-vector-conj cs c))

(defn children1 [a :document] :document
  (child (children-none) a))

(defn children2 [a :document b :document] :document
  (child (children1 a) b))

(defn children3 [a :document b :document c :document] :document
  (child (children2 a b) c))

;; --- reading an element back ----------------------------------------------

(defn tag-of [e :document] :string
  (dstr (dget e :tag)))

(defn attrs-of [e :document] :document
  (dget e :attrs))

;; A leaf has no `:children` key at all, so this defaults to an EMPTY VECTOR
;; rather than to `document-null`. Measured 2026-09-09: with a null default,
;; `(document-count (children-of leaf))` fails `document-container-required`
;; on all three targets -- the module compiled and the arithmetic on a
;; childless element trapped, which is the shape the build could not show.
(defn children-of [e :document] :document
  (option-value-of [:option :document] (document-get e :children) (document-vector)))

(defn text-of [e :document] :string
  (dstr (dget e :text)))

(defn child-count [e :document] :i64
  (document-count (children-of e)))

;; --- tests ----------------------------------------------------------------

(defn test-el [] :bool
  (let [e (el "div" (class-attr "app") (children1 (text-node "hi")))]
    (and (string=? (tag-of e) "div")
         (= 1 (child-count e))
         (string=? (text-of (dat (children-of e) 0)) "hi"))))

(defn test-leaf [] :bool
  (let [e (leaf "h1" (attrs-none) "todo")]
    (and (string=? (tag-of e) "h1")
         (string=? (text-of e) "todo")
         (= 0 (document-count (children-of e))))))

(defn test-attrs [] :bool
  (let [a (attr (class-attr "row") :type "button")]
    (and (string=? (dstr (dget a :class)) "row")
         (string=? (dstr (dget a :type)) "button"))))

(defn test-children [] :bool
  (let [cs (children3 (text-node "a") (text-node "b") (text-node "c"))]
    (and (= 3 (document-count cs))
         (string=? (text-of (dat cs 2)) "c"))))

(defn test-keyed [] :bool
  (let [a (keyed (class-attr "toggle") "t3")]
    (and (string=? (dstr (dget a :data-k)) "t3")
         (string=? (dstr (dget a :class)) "toggle"))))

;; Entry point: the module is a library, so `main` exists only to satisfy the
;; compiler's entryless-library rule (same convention as tokens_core/hig_core).
(defn main []
  (child-count (el "div" (attrs-none) (children1 (text-node "x")))))
