(ns reframe-core
  ;; The event half of the reagent/re-frame pair, written in Kotoba.
  ;;
  ;; `shitsuke.re-frame.core` pins a portable contract -- reg-event-db,
  ;; reg-sub, dispatch, dispatch-sync, subscribe, clear!, app-db -- and app
  ;; code is required to stay inside it. Every one of those is already
  ;; `db + event -> db` and `db + query -> value`, which is why the contract
  ;; can move here without the call sites moving: what a handler IS in
  ;; re-frame is exactly what a Kotoba function can be.
  ;;
  ;; What does NOT move, and is not a gap:
  ;;
  ;;   * the registry. re-frame's `reg-event-db` installs a handler at
  ;;     runtime; a Kotoba guest's handlers are static, so an app module
  ;;     spells its registry as one `cond` over `event-id` -- the same
  ;;     closed dispatch `defmulti`/`defmethod` desugars to. The host keeps
  ;;     `reg-event-db` for the handlers that stay in cljs, and routes the
  ;;     ids the guest owns into the guest.
  ;;   * app-db itself. `atom` in Kotoba is `:atom-local` (lang/local-state.edn):
  ;;     a let-bound cell that may not be returned, stored or captured. So the
  ;;     db is a VALUE that comes in and goes out, and the host holds it
  ;;     between dispatches -- which is what re-frame's own handler signature
  ;;     always said, and what makes SSR and the browser share one handler.
  ;;   * the effects. A handler returns an inert `{:db .. :fx [[id value]..]}`
  ;;     document; performing them is the host's authority, so this module
  ;;     compiles with an EMPTY requiredCapabilities and is granted nothing.
  ;;
  ;; The event is a vector whose head is a keyword, i.e. re-frame's own
  ;; `[:todo/add "milk"]`, so the value crossing the boundary is the value app
  ;; code already writes.
  (:export [main
            event0 event1 event-str event-i
            event-id event-arg event-arg-str event-arg-i event-arg-count
            query-id query-arg query-arg-str
            db-empty db-get db-str db-i db-bool db-kw
            db-assoc db-assoc-str db-assoc-i db-assoc-bool db-dissoc db-has?
            fx-of fx-db fx-list fx-count fx-at fx-dispatch fx-effect
            effect-id effect-value
            wire-print wire-read edn-print edn-read
            test-event test-event-args test-db test-fx test-fx-order test-query
            test-wire test-edn]))

;; --- reading a document ---------------------------------------------------

(defn dget [d :document k :keyword] :document
  (option-value-of [:option :document] (document-get d k) (document-null)))

(defn dat [v :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at v i) (document-null)))

;; --- events ---------------------------------------------------------------
;;
;; `[:todo/add "milk"]` -- the head names the handler, the tail is its
;; arguments. `dispatch` on the host side passes this vector through
;; unchanged, so an event written in cljs and an event written here are the
;; same value.

(defn event0 [id :keyword] :document
  (document-vector (document-keyword id)))

(defn event1 [id :keyword a :document] :document
  (document-vector-conj (event0 id) a))

(defn event-str [id :keyword s :string] :document
  (event1 id (document-string s)))

(defn event-i [id :keyword n :i64] :document
  (event1 id (document-i64 n)))

;; An event whose head is missing or is not a keyword answers
;; `:re-frame/unhandled` rather than trapping: a malformed event is an
;; ordinary miss in the handler's `cond`, not a fault in the runtime that
;; carried it.
(defn event-id [ev :document] :keyword
  (option-value-of [:option :keyword]
                   (document-keyword-value (dat ev 0))
                   :re-frame/unhandled))

;; Argument 0 is the FIRST argument, not the id: `(event-arg ev 0)` on
;; `[:todo/add "milk"]` is "milk".
(defn event-arg [ev :document i :i64] :document
  (dat ev (+ i 1)))

(defn event-arg-str [ev :document i :i64] :string
  (option-value-of [:option :string] (document-string-value (event-arg ev i)) ""))

(defn event-arg-i [ev :document i :i64] :i64
  (option-value-of [:option :i64] (document-i64-value (event-arg ev i)) 0))

(defn event-arg-count [ev :document] :i64
  (- (document-count ev) 1))

;; --- subscriptions --------------------------------------------------------
;;
;; A re-frame query vector has the same shape as an event vector, and
;; `reg-sub` is `db + query -> value`. Naming them separately is for the
;; reader; the decoding is the same decoding.

(defn query-id [q :document] :keyword
  (event-id q))

(defn query-arg [q :document i :i64] :document
  (event-arg q i))

(defn query-arg-str [q :document i :i64] :string
  (event-arg-str q i))

;; --- app-db ---------------------------------------------------------------

(defn db-empty [] :document
  (document-map))

(defn db-get [db :document k :keyword] :document
  (dget db k))

(defn db-str [db :document k :keyword] :string
  (option-value-of [:option :string] (document-string-value (dget db k)) ""))

(defn db-i [db :document k :keyword] :i64
  (option-value-of [:option :i64] (document-i64-value (dget db k)) 0))

(defn db-bool [db :document k :keyword] :bool
  (option-value-of [:option :bool] (document-bool-value (dget db k)) false))

(defn db-kw [db :document k :keyword d :keyword] :keyword
  (option-value-of [:option :keyword] (document-keyword-value (dget db k)) d))

(defn db-assoc [db :document k :keyword v :document] :document
  (document-assoc db k v))

(defn db-assoc-str [db :document k :keyword v :string] :document
  (document-assoc db k (document-string v)))

(defn db-assoc-i [db :document k :keyword v :i64] :document
  (document-assoc db k (document-i64 v)))

(defn db-assoc-bool [db :document k :keyword v :bool] :document
  (document-assoc db k (document-bool v)))

(defn db-dissoc [db :document k :keyword] :document
  (document-dissoc db k))

(defn db-has? [db :document k :keyword] :bool
  ;; `document-contains` is typed :bool here, unlike `string-contains?` which
  ;; is :i64 -- the `?` is in one name and the type is in neither, so the two
  ;; are not interchangeable and comparing this one to 1 is refused
  ;; ("equality operands must have the same value type").
  (document-contains db k))

;; --- effects --------------------------------------------------------------
;;
;; re-frame's `:fx` vector: an ordered list of `[id value]` pairs the host
;; performs, in the order the handler produced them. Inert data, so a handler
;; that "sends an email" is still a pure function of db and event, and the
;; authority to send stays with the host.

(defn fx-of [db :document] :document
  (document-map :db db :fx (document-vector)))

(defn fx-db [fx :document] :document
  (dget fx :db))

(defn fx-list [fx :document] :document
  (option-value-of [:option :document] (document-get fx :fx) (document-vector)))

(defn fx-count [fx :document] :i64
  (document-count (fx-list fx)))

(defn fx-at [fx :document i :i64] :document
  (dat (fx-list fx) i))

(defn fx-effect [fx :document id :keyword v :document] :document
  (document-assoc fx :fx
                  (document-vector-conj (fx-list fx)
                                        (document-vector (document-keyword id) v))))

(defn fx-dispatch [fx :document ev :document] :document
  (fx-effect fx :dispatch ev))

(defn effect-id [e :document] :keyword
  (option-value-of [:option :keyword] (document-keyword-value (dat e 0)) :re-frame/unhandled))

(defn effect-value [e :document] :document
  (dat e 1))

;; --- the wire -------------------------------------------------------------
;;
;; A db, an event and an effect list are all documents, so the guest can
;; print and read them itself. That is what keeps a Cloudflare Worker
;; mechanism-only: the request body arrives as text, one export turns it into
;; the answer text, and no JavaScript in between has to know what a re-frame
;; event looks like. It also sidesteps JSON, which cannot carry an :i64 (the
;; ABI hands one across as a BigInt, and `JSON.stringify` refuses it).
;;
;; TWO codecs, because the two ends want different things. Measured
;; 2026-09-09 through the emitted ESM:
;;
;;   wire-print  canonical, and HEX: `(init)` prints as
;;               "6d323a4b363a3a636f756e7469303b..." -- ASCII-safe, exact,
;;               and unreadable. Malformed input traps with a named code
;;               (document-read-hex-charset / -truncated / -odd), so a host
;;               can answer 400 rather than guess.
;;   edn-print   the same document as EDN text, which is what a caller can
;;               WRITE: a browser sends "[:counter/inc]" and cljs reads the
;;               answer with `read-string` and gets ordinary data. That is
;;               the boundary `shitsuke.re-frame.core` routes through, and
;;               it is why app call sites do not change.
;;
;; Neither is JSON, and that is deliberate: JSON has no keyword and no i64.

(defn wire-print [d :document] :string
  (document-print d))

(defn wire-read [s :string] :document
  (document-read s))

(defn edn-print [d :document] :string
  (document-edn-print d))

(defn edn-read [s :string] :document
  (document-edn-read s))

;; --- tests ----------------------------------------------------------------

(defn test-event [] :bool
  (and (= :todo/add (event-id (event-str :todo/add "milk")))
       (= :ui/clear (event-id (event0 :ui/clear)))
       ;; a vector with no keyword head is a miss, not a trap
       (= :re-frame/unhandled (event-id (document-vector)))))

(defn test-event-args [] :bool
  (let [ev (event-str :todo/add "milk")]
    (and (string=? "milk" (event-arg-str ev 0))
         (= 1 (event-arg-count ev))
         (= 0 (event-arg-count (event0 :ui/clear)))
         (= 7 (event-arg-i (event-i :todo/delete 7) 0))
         ;; reading past the end answers the empty value, not a trap
         (string=? "" (event-arg-str ev 1)))))

(defn test-db [] :bool
  (let [db (db-assoc-i (db-assoc-str (db-empty) :draft "milk") :count 2)]
    (and (string=? "milk" (db-str db :draft))
         (= 2 (db-i db :count))
         (db-has? db :draft)
         (not (db-has? db :missing))
         ;; a missing key answers the empty value of its type
         (string=? "" (db-str db :missing))
         (= 0 (db-i db :missing))
         (not (db-bool db :missing))
         (= :all (db-kw db :filter :all))
         (not (db-has? (db-dissoc db :draft) :draft)))))

(defn test-fx [] :bool
  (let [fx (fx-dispatch (fx-of (db-assoc-str (db-empty) :draft "milk")) (event0 :ui/focus))]
    (and (string=? "milk" (db-str (fx-db fx) :draft))
         (= 1 (fx-count fx))
         (= :dispatch (effect-id (fx-at fx 0)))
         (= :ui/focus (event-id (effect-value (fx-at fx 0))))
         ;; a handler that changes nothing but the db carries no effects
         (= 0 (fx-count (fx-of (db-empty)))))))

;; Effects are ORDERED: the host performs them in the order the handler
;; produced them. A set would lose that, and two effects that commute today
;; are not two effects that commute tomorrow.
(defn test-fx-order [] :bool
  (let [fx (fx-effect (fx-effect (fx-of (db-empty)) :first (document-i64 1))
                      :second (document-i64 2))]
    (and (= 2 (fx-count fx))
         (= :first (effect-id (fx-at fx 0)))
         (= :second (effect-id (fx-at fx 1))))))

(defn test-wire [] :bool
  (let [fx (fx-dispatch (fx-of (db-assoc-i (db-assoc-str (db-empty) :draft "milk") :count 2))
                        (event-str :todo/add "milk"))
        back (wire-read (wire-print fx))]
    (and (string=? "milk" (db-str (fx-db back) :draft))
         ;; the i64 survives the round trip -- this is the one JSON could not
         ;; have carried
         (= 2 (db-i (fx-db back) :count))
         (= 1 (fx-count back))
         (= :dispatch (effect-id (fx-at back 0)))
         (string=? "milk" (event-arg-str (effect-value (fx-at back 0)) 0)))))

(defn test-edn [] :bool
  (let [db (db-assoc-i (db-assoc-str (db-empty) :draft "milk") :count 2)
        back (edn-read (edn-print db))
        ev (edn-read "[:todo/add \"milk\"]")]
    (and (string=? "milk" (db-str back :draft))
         (= 2 (db-i back :count))
         ;; an event a caller WROTE by hand reads as the same event the guest
         ;; would have built -- this is the boundary a browser posts through
         (= :todo/add (event-id ev))
         (string=? "milk" (event-arg-str ev 0))
         (= 1 (event-arg-count ev)))))

(defn test-query [] :bool
  (let [q (event-str :todo/visible "active")]
    (and (= :todo/visible (query-id q))
         (string=? "active" (query-arg-str q 0)))))

;; Entry point: the module is a library, so `main` exists only to satisfy the
;; compiler's entryless-library rule (same convention as tokens_core/hig_core).
(defn main []
  (fx-count (fx-dispatch (fx-of (db-empty)) (event0 :ui/focus))))
