(ns hiccup-core
  ;; The predicate is exported, so a host can call it — which for a security
  ;; judgement is the point of porting it at all.
  ;;
  ;; It was not, and the comment here named the parity harness as the reason —
  ;; it appends zero-arg case defns and runs those. That is still how the
  ;; harness works, and it was never what refused an export list. Measured
  ;; 2026-08-12: a declared list without `main` is refused with "main
  ;; entrypoint must be exported", and `ir/execute` runs exported functions
  ;; only ("function is not exported"), so the harness has to name its own
  ;; cases in the list too. See tokens_core.kotoba for the long form.
  ;;
  ;; As in style_core this list names every `defn`, because the module defines
  ;; exactly the predicate, the terminator it is built from, and `main`, and
  ;; all three already have a caller. What stays out is on the .cljc side, not
  ;; hidden here: the throw, the tree walk and the RAWTEXT child flattening.
  (:export [main rawtext-terminator rawtext-breakout?])
  (:schemas {:hic/rawtext-breakout [:record :hic/rawtext-breakout
                                    [[:tag :string] [:content :string]]]}))

;; A `.kotoba` port of the RAWTEXT breakout DECISION in `shitsuke.hiccup`
;; (ADR-2607270100 §10, form A). Data -> bool, no capabilities: kotoba/pure.
;;
;; HTML5 parses <script>/<style> content as RAWTEXT: the element terminates
;; at the FIRST literal, case-insensitive `</tag` sequence, regardless of
;; quoting or comments in the raw text. Emitting that sequence verbatim lets
;; a payload break out of the element and inject markup after it (a
;; script-context XSS vector). `shitsuke.hiccup/assert-no-rawtext-breakout!`
;; is the guard.
;;
;; What moves here is the PREDICATE, not the throw. Kotoba's permanent
;; safety invariant is `:explicit-errors` (no throw/try/catch), and the
;; host already owns the effect: `assert-no-rawtext-breakout!` keeps its
;; `ex-info`, and asks this port whether the content breaks out. That split
;; is the decision-core boundary — the security judgement is expressed in
;; the safe language, the signalling stays in the host.
;;
;; The .cljc side spells the test as `(re-find (re-pattern (str "(?i)</" tag)))`.
;; Kotoba has no regex head, and none is needed: the pattern is a literal
;; case-insensitive substring, which composes exactly from `string-fold-case`
;; + `string-contains?` (compiler ADR 0050). Folding the CONTENT is what
;; makes the match case-insensitive — dropping that fold makes the port
;; disagree with the .cljc guard on `x</STYLE>y` (measured: the parity cases
;; `upper` / `mixed` / `script_mixed` all fail). The tag is folded too so the
;; predicate does not silently depend on the host handing it a lower-cased
;; tag; today `shitsuke.hiccup` only ever reaches this decision for a tag in
;; html.core's `raw-text-tags`, which is lower-case by construction.
;;
;; The tree walk, the `[:hiccup/raw ...]` unwrapping and the RAWTEXT child
;; flattening stay on the .cljc side: they are collection folds over hiccup,
;; i.e. document-plane work, not form A.

(defn rawtext-terminator [tag :string] :string
  (string-concat "</" tag))

(defn rawtext-breakout? [x [:ref :hic/rawtext-breakout]] :bool
  (let [tag (record-get x :tag)
        content (record-get x :content)]
    ;; `string-contains?` is typed :i64 (1/0), not :bool — the `?` is in the
    ;; primitive's name, not in its type. Comparing to 1 here keeps that
    ;; encoding local: the function this module exports has a :bool result,
    ;; because bool is a type and not a number (a permanent invariant of the
    ;; language, `surface-status.edn` :bool-is-a-type-not-a-number).
    (= 1 (string-contains? (string-fold-case content)
                           (string-fold-case (rawtext-terminator tag))))))

;; Entry point: the module is a library, so `main` exists only to satisfy the
;; compiler's entryless-library rule (same convention as tokens_core/hig_core).
(defn main []
  (string-byte-length (rawtext-terminator "style")))
