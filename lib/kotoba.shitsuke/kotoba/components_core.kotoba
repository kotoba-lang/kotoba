(ns components-core
  (:export [act-attr class-join]))

;; The decision core of `shitsuke.components` (ADR-2607270100 §10, form A).
;; Ported by poolside/laguna-s-2.1 through the orbench agent loop and gated by
;; kotoba -M inspect / -M test (jvm-kir, js, wasm) / aarch64 native + the
;; byte-equality cases in test/shitsuke/kotoba_parity_test.cljk.
;;
;; What crosses: the two string rules the namespace actually decides.
;;   act-attr   — the data-act value, namespace preserved (`act->str`)
;;   class-join — the component class plus the caller's :class. This rule was
;;                written out SIX times in components.cljc (button, icon-button,
;;                field, input, textarea, select); it is one rule.
;;
;; What stays .cljc, on purpose: deciding whether `act` is nil / a string / a
;; keyword and splitting it into namespace and name (host keyword surface), the
;; :attrs merge with its nil-dropping contract (maps), and every hiccup vector.
;; Nothing here throws — :explicit-errors is permanent (ADR-2608650000).
;;
;; Word-typed throughout, so this qualifies for :aarch64-kotoba-v1 as written.

(defn act-attr [ns :string nm :string] :string
  (if (string=? ns "")
    nm
    (string-concat (string-concat ns "/") nm)))

(defn class-join [base :string extra :string] :string
  (if (string=? extra "")
    base
    (string-concat (string-concat base " ") extra)))
