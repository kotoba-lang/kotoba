(ns hig-core
  ;; The entry points are exported, so a host can call them.
  ;;
  ;; They were not, and the comment here named the parity harness as the
  ;; reason — it appends zero-arg case defns and runs those. That is still how
  ;; the harness works, and it was never what refused an export list. Measured
  ;; 2026-08-12: a declared list without `main` is refused with "main
  ;; entrypoint must be exported", and `ir/execute` runs exported functions
  ;; only ("function is not exported"), so the harness has to name its own
  ;; cases in the list too. See tokens_core.kotoba for the long form.
  ;;
  ;; The list names the functions that already have a caller. The folds
  ;; (`group-from`, `nested-from`), the per-line `decl` / `scalar-decl` /
  ;; `nested-decl` primitives they compose, and the vendored `sample-*`
  ;; corpora stay internal — reachable through `group-css`, `nested-css` and
  ;; `sample-root`.
  (:export [main group-css group-scalar-decl nested-css layer-order-css layer-wrap text-style-props text-style-props-token text-style-class sample-root])
  (:schemas {;; T5.2 native guest record: multi-arg pure → single record
             :hig/css-var-name [:record :hig/css-var-name
                                [[:group :string] [:k :string]]]
             :hig/decl [:record :hig/decl
                        [[:name :string] [:value :string]]]
             :hig/scalar-decl [:record :hig/scalar-decl
                               [[:group :string] [:k :string] [:value :string]]]
             :hig/nested-decl [:record :hig/nested-decl
                               [[:group :string] [:k :string]
                                [:prop :string] [:value :string]]]
             :hig/group-scalar-decl [:record :hig/group-scalar-decl
                                     [[:group :string] [:value :string]]]
             :hig/group-from [:record :hig/group-from
                              [[:group :string]
                               [:decls [:map :keyword :string]]
                               [:index :i64]
                               [:acc :string]]]
             :hig/group-css [:record :hig/group-css
                             [[:group :string]
                              [:decls [:map :keyword :string]]]]
             :hig/nested-from [:record :hig/nested-from
                               [[:group :string] [:k :string]
                                [:props [:map :keyword :string]]
                                [:index :i64] [:acc :string]]]
             :hig/nested-css [:record :hig/nested-css
                              [[:group :string] [:k :string]
                               [:props [:map :keyword :string]]]]
             :hig/text-style-props [:record :hig/text-style-props
                                    [[:style :string] [:weight :string]]]
             :hig/join-nl [:record :hig/join-nl
                           [[:a :string] [:b :string]]]}))

;; A `.kotoba` port of the string-producing core of `shitsuke.hig`
;; (ADR-2607270100 §10, form A). No capabilities. Dual-render seams
;; (reagent/re-frame) and recursive deep-merge stay on the .cljc host side.
;;
;; This module owns:
;;   - `--hig-*` CSS custom-property emission (scalar + nested text props)
;;   - cascade layer-order declaration
;;   - text-style-props / utility-class skeleton
;;   - :root wrapper
;;
;; Full default-hig-tokens corpus, dark appearance selection, and base-css
;; element rules remain on the .cljc side for this tranche (they are large
;; and partially recursive); the primitives here are what liquid-glass-ui /
;; kotoba-ui will compose once recursive values land (W4). Parity is gated
;; against key-sorted .cljc runs of the same primitive shapes.
;; T5.2: multi-arg pure folded into single guest records.

;; --- names + declarations -------------------------------------------------

(defn css-var-name [x [:ref :hig/css-var-name]] :string
  (let [group (record-get x :group)
        k (record-get x :k)]
    (string-concat "--hig-"
                   (string-concat group
                                  (string-concat "-" k)))))

(defn decl [x [:ref :hig/decl]] :string
  (let [name (record-get x :name)
        value (record-get x :value)]
    (string-concat "  "
                   (string-concat name
                                  (string-concat ": "
                                                 (string-concat value ";"))))))

(defn scalar-decl [x [:ref :hig/scalar-decl]] :string
  (let [group (record-get x :group)
        k (record-get x :k)
        value (record-get x :value)]
    (decl (record-new [:ref :hig/decl]
                      (css-var-name (record-new [:ref :hig/css-var-name] group k))
                      value))))

(defn nested-decl [x [:ref :hig/nested-decl]] :string
  (let [group (record-get x :group)
        k (record-get x :k)
        prop (record-get x :prop)
        value (record-get x :value)]
    (decl (record-new [:ref :hig/decl]
                      (string-concat (css-var-name (record-new [:ref :hig/css-var-name] group k))
                                     (string-concat "-" prop))
                      value))))

;; A scalar group value that is NOT a map (e.g. :hig/hairline "0.5px")
;; emits `--hig-<group>: value;` with no trailing name segment.

(defn group-scalar-decl [x [:ref :hig/group-scalar-decl]] :string
  (let [group (record-get x :group)
        value (record-get x :value)]
    (decl (record-new [:ref :hig/decl]
                      (string-concat "--hig-" group)
                      value))))

(defn group-from [x [:ref :hig/group-from]] :string
  (let [group (record-get x :group)
        decls (record-get x :decls)
        index (record-get x :index)
        acc (record-get x :acc)]
    (match-option (typed-map-entry-at [:map :keyword :string] decls index)
                  [:option [:vector [:keyword :string]]]
                  (none acc)
                  (some entry
                        (group-from
                         (record-new [:ref :hig/group-from]
                                     group decls (+ index 1)
                                     (if (string=? acc "")
                                       (scalar-decl
                                        (record-new [:ref :hig/scalar-decl]
                                                    group
                                                    (keyword-name
                                                     (hetero-vector-at [:vector [:keyword :string]] entry 0))
                                                    (hetero-vector-at [:vector [:keyword :string]] entry 1)))
                                       (string-concat acc
                                                      (string-concat "\n"
                                                                     (scalar-decl
                                                                      (record-new [:ref :hig/scalar-decl]
                                                                                  group
                                                                                  (keyword-name
                                                                                   (hetero-vector-at [:vector [:keyword :string]] entry 0))
                                                                                  (hetero-vector-at [:vector [:keyword :string]] entry 1))))))))))))

(defn group-css [x [:ref :hig/group-css]] :string
  (let [group (record-get x :group)
        decls (record-get x :decls)]
    (group-from (record-new [:ref :hig/group-from] group decls 0 ""))))

(defn root-css [body :string] :string
  (string-concat ":root {\n"
                 (string-concat body "\n}")))

;; Nested text-style expansion: one style name → N prop lines.
;; props is a flat [:map :keyword :string] of CSS properties.

(defn nested-from [x [:ref :hig/nested-from]] :string
  (let [group (record-get x :group)
        k (record-get x :k)
        props (record-get x :props)
        index (record-get x :index)
        acc (record-get x :acc)]
    (match-option (typed-map-entry-at [:map :keyword :string] props index)
                  [:option [:vector [:keyword :string]]]
                  (none acc)
                  (some entry
                        (nested-from
                         (record-new [:ref :hig/nested-from]
                                     group k props (+ index 1)
                                     (if (string=? acc "")
                                       (nested-decl
                                        (record-new [:ref :hig/nested-decl]
                                                    group k
                                                    (keyword-name
                                                     (hetero-vector-at [:vector [:keyword :string]] entry 0))
                                                    (hetero-vector-at [:vector [:keyword :string]] entry 1)))
                                       (string-concat acc
                                                      (string-concat "\n"
                                                                     (nested-decl
                                                                      (record-new [:ref :hig/nested-decl]
                                                                                  group k
                                                                                  (keyword-name
                                                                                   (hetero-vector-at [:vector [:keyword :string]] entry 0))
                                                                                  (hetero-vector-at [:vector [:keyword :string]] entry 1))))))))))))

(defn nested-css [x [:ref :hig/nested-css]] :string
  (let [group (record-get x :group)
        k (record-get x :k)
        props (record-get x :props)]
    (nested-from (record-new [:ref :hig/nested-from] group k props 0 ""))))

;; --- cascade layer --------------------------------------------------------

(defn layer-order-css [] :string
  "@layer kotoba.hig, kotoba.glass;")

;; --- text-style-props (element / utility class body) ----------------------
;; Mirrors shitsuke.hig/text-style-props. Weight is a string: either a
;; literal ("700") or a var(...) expression. letter-spacing keeps the
;; CSS fallback form `var(--hig-text-<n>-letter-spacing, normal)`.

(defn text-style-props [x [:ref :hig/text-style-props]] :string
  (let [style (record-get x :style)
        weight (record-get x :weight)]
    (string-concat
     (string-concat "  font-family: var(--hig-text-"
                    (string-concat style "-font-family);\n"))
     (string-concat
      (string-concat "  font-size: var(--hig-text-"
                     (string-concat style "-font-size);\n"))
      (string-concat
       (string-concat "  line-height: var(--hig-text-"
                      (string-concat style "-line-height);\n"))
       (string-concat
        (string-concat "  font-weight: "
                       (string-concat weight ";\n"))
        (string-concat "  letter-spacing: var(--hig-text-"
                       (string-concat style "-letter-spacing, normal);"))))))))

(defn text-style-props-token [style :string] :string
  (text-style-props
   (record-new [:ref :hig/text-style-props]
               style
               (string-concat "var(--hig-text-"
                              (string-concat style "-font-weight)")))))

(defn text-style-class [style :string] :string
  (string-concat ".hig-"
                 (string-concat style
                                (string-concat " {\n"
                                               (string-concat (text-style-props-token style)
                                                              "\n}")))))

(defn layer-wrap [body :string] :string
  (string-concat "@layer kotoba.hig {\n"
                 (string-concat body "\n}")))

;; --- light color / spacing sample corpus ----------------------------------
;; A representative slice of default-hig-tokens (light) used by the parity
;; gate. Full palette stays on the .cljc side for this tranche.

(defn sample-colors [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :label "#000000"
                 :system-background "#FFFFFF"
                 :tint "#007AFF"))

(defn sample-spacing [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :1 "4px" :4 "16px" :content-margin "16px"))

(defn sample-radius [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :capsule "999px" :xs "6px"))

(defn sample-body-text [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :font-family "var(--hig-font-text)"
                 :font-size "17px"
                 :font-weight "400"
                 :line-height "22px"))

(defn sample-display3-text [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :font-family "var(--hig-font-display)"
                 :font-size "clamp(40px, 5vw + 8px, 64px)"
                 :font-weight "700"
                 :letter-spacing "-0.02em"
                 :line-height "calc(1em + 4px)"))

(defn join-nl [x [:ref :hig/join-nl]] :string
  (let [a (record-get x :a)
        b (record-get x :b)]
    (string-concat a (string-concat "\n" b))))

(defn sample-root [] :string
  (let [colors-css (group-css (record-new [:ref :hig/group-css] "color" (sample-colors)))
        spacing-css (group-css (record-new [:ref :hig/group-css] "spacing" (sample-spacing)))
        radius-css (group-css (record-new [:ref :hig/group-css] "radius" (sample-radius)))
        hairline-css (group-scalar-decl
                      (record-new [:ref :hig/group-scalar-decl] "hairline" "0.5px"))
        body-css (nested-css (record-new [:ref :hig/nested-css]
                                         "text" "body" (sample-body-text)))
        d3-css (nested-css (record-new [:ref :hig/nested-css]
                                       "text" "display3" (sample-display3-text)))]
    (root-css
     (join-nl
      (record-new [:ref :hig/join-nl]
                  colors-css
                  (join-nl
                   (record-new [:ref :hig/join-nl]
                               spacing-css
                               (join-nl
                                (record-new [:ref :hig/join-nl]
                                            radius-css
                                            (join-nl
                                             (record-new [:ref :hig/join-nl]
                                                         hairline-css
                                                         (join-nl
                                                          (record-new [:ref :hig/join-nl]
                                                                      body-css
                                                                      d3-css)))))))))))))

(defn main []
  (string-byte-length
   (join-nl (record-new [:ref :hig/join-nl] (layer-order-css) (sample-root)))))
