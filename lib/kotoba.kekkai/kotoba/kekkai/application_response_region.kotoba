;; JUN-757: pinned authenticated completion -> native pending response.
;; One exclusive host critical section owns actual pool8MiB/pending262144/
;; managed-session262144/receiver IO. Serialize ALL calls and consumers; do
;; not mix generic assembly release/reset while an accepted input is held.
;; No allocation/copy of a1MiB message, pointer from arbitrary stored address,
;; fabricated authentication, socket/service/URL/consent grant or side effect.
;; Completed offsets are bounded relative locators from the canonical owner;
;; kernel-subregion proves actual1MiB/96B views. Namespace exports aren't ABI.
;; complete returns handle/-1/-2 busy, leaving pool untouched and still pinned.
;; release erases matching accepted record THEN canonical pinned completion.
;; discard synchronizes actual session and refuses(-2) to erase an accepted
;; input. Expiry/revoke/new channel may clear that hold; then discard is safe.
;; Caller keeps immutable response alive through all consumption and rechecks
;; current session/context after any UI/consent yield before an app effect.
(ns kekkai.application-response-region
  (:require [kekkai.application-reassembly-region :as a]
            [kekkai.application-pending-region :as p])
  (:export [complete release discard]))
(defn- separate [a al b bl] :bool (or (<= (+ a al) b) (<= (+ b bl) a)))
(defn- shape [pool length pending pending-bytes session session-bytes now] :bool
  (and (>= length 8388608) (>= pending-bytes 262144) (>= session-bytes 262144)
       (>= now 0) (<= now 9007199254740991)
       (separate pool length pending pending-bytes) (separate pool length session session-bytes)
       (separate pending pending-bytes session session-bytes)))
(defn- complete-run [pool pending session now] :i64
  (let [start (a/completed-message-start pool 8388608) binding (a/completed-channel-start pool 8388608)
        count (a/completed-size pool 8388608)]
    (if (and (>= start 0) (>= binding 0) (> count 0) (<= count 1048576))
      (p/complete-bound pending 262144 session 262144
        (kernel-subregion pool 8388608 start 1048576) count (kernel-subregion pool 8388608 binding 96) now) -1)))
(defn complete [pool length pending pending-bytes session session-bytes now] :i64
  (if (shape pool length pending pending-bytes session session-bytes now)
    (complete-run (kernel-subregion pool length 0 8388608) (kernel-subregion pending pending-bytes 0 262144)
      (kernel-subregion session session-bytes 0 262144) now) -1))
(defn- release-run [pool pending session now] :i64
  (let [start (a/completed-message-start pool 8388608) binding (a/completed-channel-start pool 8388608)]
    (if (and (>= start 0) (>= binding 0)
             (= (p/release-bound pending 262144 session 262144 (kernel-subregion pool 8388608 start 1048576)
                  (kernel-subregion pool 8388608 binding 96) now) 1))
      (a/release pool 8388608) -1)))
(defn release [pool length pending pending-bytes session session-bytes now] :i64
  (if (shape pool length pending pending-bytes session session-bytes now)
    (release-run (kernel-subregion pool length 0 8388608) (kernel-subregion pending pending-bytes 0 262144)
      (kernel-subregion session session-bytes 0 262144) now) -1))
(defn- discard-run [pool pending session now] :i64
  (let [start (a/completed-storage-start pool 8388608)]
    (if (and (>= start 0) (>= (p/synchronize pending 262144 session 262144 now) 0))
      (let [held (p/holds-input pending 262144 (kernel-subregion pool 8388608 start 1048576))]
        (if (= held 0) (a/release pool 8388608) (if (= held 1) -2 -1))) -1)))
(defn discard [pool length pending pending-bytes session session-bytes now] :i64
  (if (shape pool length pending pending-bytes session session-bytes now)
    (discard-run (kernel-subregion pool length 0 8388608) (kernel-subregion pending pending-bytes 0 262144)
      (kernel-subregion session session-bytes 0 262144) now) -1))
