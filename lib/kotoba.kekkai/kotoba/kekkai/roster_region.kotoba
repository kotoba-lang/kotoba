(defn- reap [owner now]
  (if (and (> (r owner (+ 32768 24)) 0)
           (or (not= (r64 owner (+ 32768 8)) (r64 owner 24)) (not (eligible owner (r owner (+ 32768 16)) now))))
    (zero owner 32768 65536) 1))
(defn advance-clock [owner length now]
  (if (< length 262144) 0
    (if (and (current (kernel-subregion owner length 0 262144)) (>= now (r64 (kernel-subregion owner length 0 262144) 16)))
      (do (w64 (kernel-subregion owner length 0 262144) 16 now) (reap (kernel-subregion owner length 0 262144) now) 1) 0)))
(defn sessionable [owner length expected expected-bytes now]
  (if (or (not= expected-bytes 32) (< length 262144) (not (separate owner 262144 expected 32))) 0
    (if (and (= (advance-clock owner length now) 1)
             (eligible (kernel-subregion owner length 0 262144) (peer-index owner length expected expected-bytes) now)) 1 0)))
;; Index query for an already bound, protected managed session. Callers must
;; separately compare its pinned key with peer-key-byte; indices are not
;; identities or grants. This keeps policy in this owner without passing an
;; alias of session bytes to the immutable external-key sessionable API.
(defn peer-eligible [owner length peer now]
  (if (< length 262144) 0
    (if (and (= (advance-clock owner length now) 1)
             (eligible (kernel-subregion owner length 0 262144) peer now)) 1 0)))
;; Request32: direction0(out)/1(in), port4, now8(u64), epoch16(u64).
;; Capability bytes are the operation's keyword name without colon. Caller
;; must bind direction/port/capability to the real operation and fresh consent;
;; a request record is not itself that proof or an app authorization ticket.
(defn- grant-loop [owner peer cap cap-bytes direction port index] :bool
  (if (>= index (r owner 40)) false
    (let [record (+ 8192 (* index 32))]
      (if (and (= (r owner record) (if (= direction 0) 0 peer)) (= (r owner (+ record 4)) (if (= direction 0) peer 0))
               (sequence-has (kernel-subregion owner 262144 0 32768) 32768 (r owner (+ record 8)) (r owner (+ record 12)) 3 cap cap-bytes 0)
               (sequence-has (kernel-subregion owner 262144 0 32768) 32768 (r owner (+ record 16)) (r owner (+ record 20)) 5 cap cap-bytes port)) true
        (grant-loop owner peer cap cap-bytes direction port (+ index 1))))))
(defn- permit [owner expected cap cap-bytes request]
  (let [direction (kernel-load-u32 request 32 0) port (kernel-load-u32 request 32 4)
        now (kernel-load-u64 request 32 8) epoch (kernel-load-u64 request 32 16)]
    (if (and (<= direction 1) (>= port 1) (<= port 65535) (= epoch (r64 owner 24))
             (= (advance-clock owner 262144 now) 1) (eligible owner (locate owner expected 1) now)
             (grant-loop owner (locate owner expected 1) cap cap-bytes direction port 0)) 1 0)))
(defn permitted [owner length expected expected-bytes cap cap-bytes request request-bytes]
  (if (and (>= length 262144) (= expected-bytes 32) (> cap-bytes 0) (<= cap-bytes 256) (= request-bytes 32)
           (separate owner 262144 expected 32) (separate owner 262144 cap cap-bytes) (separate owner 262144 request 32)
           (current (kernel-subregion owner length 0 262144)))
    (permit (kernel-subregion owner length 0 262144) (kernel-subregion expected expected-bytes 0 32)
      cap cap-bytes (kernel-subregion request request-bytes 0 32)) 0))
