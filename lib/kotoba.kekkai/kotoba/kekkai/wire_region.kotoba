;; JUN-757: Kekkai v1 peer framing, caller-owned regions, no IO/authority.
;; Existing peer wire:6b 01 [30 init|31 response|32 transport] || payload.
;; Inner plaintext:[1 data|2 ping|3 pong|4 call-me-maybe|5 keepalive] || body.
;; Decode returns the scalar type,0 on refusal; it does not authenticate it.
;; Wrap returns total bytes,-1 on refusal. Capacity is the actual allocation,
;; not the logical used length. Outputs and inputs must not overlap. All
;; refusals preserve output. Empty outer/inner payloads retain legacy framing;
;; the consuming protocol owns message lengths, semantics and authority.
;; Preserve65535 payload bytes: outer can be65538 bytes, inner65536.
;; Physical capacities are bounded to128KiB; this is not MTU admission.
(ns kekkai.wire-region
  (:export [outer-type inner-type outer-header wrap-outer wrap-inner]))
(defn- outer? [kind] (or (= kind 48) (= kind 49) (= kind 50)))
(defn- inner? [kind] (and (>= kind 1) (<= kind 5)))
(defn- shape [capacity used]
  (and (>= capacity 0) (<= capacity 131072) (>= used 0) (<= used capacity)))
(defn- b [input capacity i] (kernel-load-u8 (kernel-subregion input capacity i 1) 1 0))
(defn- p [output capacity i value] (kernel-store-u8 (kernel-subregion output capacity i 1) 1 0 value))
(defn outer-type [input capacity used]
  (if (and (shape capacity used) (>= used 3) (<= used 65538))
    (if (and (= (b input capacity 0) 107) (= (b input capacity 1) 1)
             (outer? (b input capacity 2))) (b input capacity 2) 0) 0))
(defn inner-type [input capacity used]
  (if (and (shape capacity used) (>= used 1) (<= used 65536))
    (if (inner? (b input capacity 0)) (b input capacity 0) 0) 0))
(defn- separate [input bytes output count]
  (or (= bytes 0) (<= (+ input bytes) output) (<= (+ output count) input)))
(defn- fits [input capacity output out-cap used header]
  (and (shape capacity used) (shape out-cap (+ used header)) (<= used 65535)
       (separate input capacity output out-cap)))
(defn- copy [input capacity output out-cap used offset i]
  (if (>= i used) (+ used offset)
    (do (p output out-cap (+ offset i) (b input capacity i))
        (copy input capacity output out-cap used offset (+ i 1)))))
(defn outer-header [kind output out-cap]
  (if (and (outer? kind) (shape out-cap 3))
    (do (p output out-cap 0 107) (p output out-cap 1 1) (p output out-cap 2 kind) 3) -1))
(defn wrap-outer [kind input capacity output out-cap used]
  (if (and (outer? kind) (fits input capacity output out-cap used 3))
    (do (outer-header kind output out-cap) (copy input capacity output out-cap used 3 0)) -1))
(defn wrap-inner [kind input capacity output out-cap used]
  (if (and (inner? kind) (fits input capacity output out-cap used 1))
    (do (p output out-cap 0 kind) (copy input capacity output out-cap used 1 0)) -1))
