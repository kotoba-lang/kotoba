        (do (p work at 92) (p work (+ at 1) v) (escape-id work input (+ at 2) size (+ index 1)))
        (if (or (= v 8) (= v 9) (= v 10) (= v 12) (= v 13))
          (do (p work at 92) (p work (+ at 1) (case v 8 98 9 116 10 110 12 102 114))
              (escape-id work input (+ at 2) size (+ index 1)))
          (if (< v 32)
            (do (p work at 92) (p work (+ at 1) 117) (p work (+ at 2) 48) (p work (+ at 3) 48)
                (p work (+ at 4) (hex-byte (quot v 16))) (p work (+ at 5) (hex-byte (mod v 16)))
                (escape-id work input (+ at 6) size (+ index 1)))
            (do (p work at v) (escape-id work input (+ at 1) size (+ index 1)))))))))
(defn- alphabet [v]
