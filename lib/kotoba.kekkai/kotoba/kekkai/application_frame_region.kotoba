    (if (< value 2048) (do (p work (+ 64 at) (+ 192 (quot value 64))) (p work (+ 65 at) (+ 128 (mod value 64))) (+ at 2))
      (if (< value 65536) (do (p work (+ 64 at) (+ 224 (quot value 4096))) (p work (+ 65 at) (+ 128 (mod (quot value 64) 64)))
                            (p work (+ 66 at) (+ 128 (mod value 64))) (+ at 3))
