(defn- record-valid [input] :bool
  (and (= (record-word input 0) 0x3146504b) (>= (record-word input 4) 1) (<= (record-word input 4) 640)
       (>= (record-word input 8) 1) (<= (record-word input 8) 160)
       (= (j/utf16-length input 2048 64 (+ 64 (record-word input 4)) true) (record-word input 8))
       (> (record-word input 16) 0) (<= (record-word input 16) 2048) (< (record-word input 12) (record-word input 16))
       (<= (record-word input 20) 700)))
(defn- encoded [work input]
