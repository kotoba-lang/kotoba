            (quartet work input count (quot step 2097152) end (+ index 1)))))))
(defn- group [work pos last :bool]
  (let [a (sextet (r work 4160)) b (sextet (r work 4164)) c (sextet (r work 4168)) d (sextet (r work 4172))]
    (if (or (< a 0) (< b 0)) -1
      (if (= (r work 4168) 61)
        (if (and last (= (r work 4172) 61) (= (mod b 16) 0) (< pos 700))
          (do (p work (+ 704 pos) (+ (* a 4) (quot b 16))) (+ pos 1)) -1)
        (if (< c 0) -1
          (if (= (r work 4172) 61)
            (if (and last (= (mod c 4) 0) (<= (+ pos 2) 700))
              (do (p work (+ 704 pos) (+ (* a 4) (quot b 16))) (p work (+ 705 pos) (+ (* (mod b 16) 16) (quot c 4))) (+ pos 2)) -1)
            (if (and (>= d 0) (<= (+ pos 3) 700))
              (do (p work (+ 704 pos) (+ (* a 4) (quot b 16))) (p work (+ 705 pos) (+ (* (mod b 16) 16) (quot c 4)))
                  (p work (+ 706 pos) (+ (* (mod c 4) 64) d)) (+ pos 3)) -1)))))))
(defn- base64-read [work input count at end pos]
  (if (>= at end) pos
    (let [next (quartet work input count at end 0)]
      (if (< next 0) -1
        (let [size (group work pos (= next end))]
          (if (< size 0) -1 (base64-read work input count next end size)))))))
(defn- payload-read [work input count start end]
  (if (and (= (b input count start) 34) (= (b input count (- end 1)) 34))
    (base64-read work input count (+ start 1) (- end 1) 0) -1))
(defn- admitted [work input count]
  (if (and (= (parse work input count) 1) (= (natural work input count 1 1) 1)
           (= (id-read work input count (r work 4112) (r work 4116)) 1))
    (let [index (natural work input count 3 2047) total (natural work input count 4 2048)
          size (payload-read work input count (r work 4136) (r work 4140))]
      (if (and (>= index 0) (> total 0) (< index total) (>= size 0))
        (do (w work 0 0x3146504b) (w work 12 index) (w work 16 total) (w work 20 size) 1) -1)) -1))
(defn- commit [work output capacity used at]
  (if (>= at used) used
    (do (kernel-store-u8 (kernel-subregion output capacity at 1) 1 0 (wb work at)) (commit work output capacity used (+ at 1)))))
(defn- decode-run [work input count output capacity]
  (do (clear work 0)
      (let [ok (admitted work input count)]
        (do (if (= ok 1) (commit work output capacity 2048 0) 0) (clear work 0) ok))))
(defn decode [work work-bytes input count output capacity]
  (if (and (shape work work-bytes input count output capacity) (>= capacity 2048))
    (decode-run (kernel-subregion work work-bytes 0 8192) input count output capacity) -1))

(defn- fixed-size [kind] (case kind 1 26 2 14 3 13 4 12 5 2 0))
(defn- fixed-byte [kind i]
  (case kind 1 (case i 0 123 1 34 2 118 3 101 4 114 5 115 6 105 7 111 8 110 9 34 10 58 11 49 12 44 13 34 14 109 15 101 16 115 17 115 18 97 19 103 20 101 21 73 22 100 23 34 24 58 25 34 -1)
    2 (case i 0 34 1 44 2 34 3 112 4 97 5 114 6 116 7 73 8 110 9 100 10 101 11 120 12 34 13 58 -1)
    3 (case i 0 44 1 34 2 112 3 97 4 114 5 116 6 67 7 111 8 117 9 110 10 116 11 34 12 58 -1)
    4 (case i 0 44 1 34 2 112 3 97 4 121 5 108 6 111 7 97 8 100 9 34 10 58 11 34 -1)
    5 (case i 0 34 1 125 -1) -1))
(defn- fixed [work at kind index]
  (if (>= index (fixed-size kind)) at
    (do (p work at (fixed-byte kind index)) (fixed work (+ at 1) kind (+ index 1)))))
(defn- decimal [work at number]
  (if (< number 10) (do (p work at (+ 48 number)) (+ at 1))
    (let [next (decimal work at (quot number 10))]
      (do (p work next (+ 48 (mod number 10))) (+ next 1)))))
(defn- record-word [input at] (kernel-load-u32 (kernel-subregion input 2048 at 4) 4 0))
(defn- hex-byte [v] (if (< v 10) (+ 48 v) (+ 87 v)))
(defn- escape-id [work input at size index]
  (if (>= index size) at
    (let [v (b input 2048 (+ 64 index))]
