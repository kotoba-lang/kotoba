;; JUN-757: native existing application/1 JSON chunk codec, not reassembly.
;; decode/encode(work,actual>=8192,input,actual-used,output,actual-capacity).
;; Caller-owned work8192 and full input/output allocations must be disjoint;
;; inputs immutable, calls serialized. Shape refusal preserves all bytes;
;; processed completion/refusal clears all8192 private bytes. Refused output
;; is unchanged. decode returns1/-1 and commits exactly2048 record bytes;
;; encode returns JSON byte count/-1 and commits only its encoded prefix.
;; Input JSON0..65536, depth64; five required names (escaped names match),
;; unknown fields syntactically checked/ignored, duplicate required names
;; rejected. version1; plain decimal indices0..<count, count1..2048;
;; messageId1..160 UTF16 units, strict UTF8 scalars (no lone surrogates);
;; canonical RFC4648 payload<=700 decoded bytes (JSON escapes allowed).
;; Stricter than legacy JS's duplicate/numeric/base64/surrogate coercions;
;; keeps canonical encoder wire, limits and all byte payloads. Not a full
;; acceptance claim for the legacy parser's permissive input language.
;; Record2048: magic0x3146504b@0, UTF8 ID length4, UTF16 units8, partIndex12,
;; partCount16, payload length20; ID64..703 (640), payload704..1403 (700).
;; Remaining record bytes zero on decode. No authentication/peer association,
;; entropy, app/port/effect/consent grant.1MiB message/128 assemblies/4MiB
;; buffered/2048 parts, out-of-order/replay and peer/epoch keyed reassembly
;; remain separate full-product requirements; they are not reduced here.
(ns kekkai.application-frame-region
  (:require [kotoba.json.region :as j])
  (:export [decode encode]))
(defn- r [work at] (kernel-load-u32 (kernel-subregion work 8192 at 4) 4 0))
(defn- w [work at value] (kernel-store-u32 (kernel-subregion work 8192 at 4) 4 0 value))
(defn- p [work at value] (kernel-store-u8 (kernel-subregion work 8192 at 1) 1 0 value))
(defn- wb [work at] (kernel-load-u8 (kernel-subregion work 8192 at 1) 1 0))
(defn- b [input count at] (if (and (>= at 0) (< at count)) (kernel-load-u8-64k input count at) -1))
(defn- clear [work at]
  (if (>= at 8192) 1 (do (kernel-store-u64 (kernel-subregion work 8192 at 8) 8 0 0) (clear work (+ at 8)))))
(defn- disjoint [a al b bl] :bool (or (= al 0) (= bl 0) (<= (+ a al) b) (<= (+ b bl) a)))
(defn- shape [work work-bytes input count output capacity] :bool
  (and (>= work-bytes 8192) (>= count 0) (<= count 65536) (>= capacity 0) (<= capacity 65536)
       (disjoint work 8192 input count) (disjoint work 8192 output capacity) (disjoint input count output capacity)))
(defn- key-byte [kind i]
  (case kind 1 (case i 0 118 1 101 2 114 3 115 4 105 5 111 110)
    2 (case i 0 109 1 101 2 115 3 115 4 97 5 103 6 101 7 73 100)
    3 (case i 0 112 1 97 2 114 3 116 4 73 5 110 6 100 7 101 120)
    4 (case i 0 112 1 97 2 114 3 116 4 67 5 111 6 117 7 110 116)
    5 (case i 0 112 1 97 2 121 3 108 4 111 5 97 100) -1))
(defn- key-same [input count at end kind index] :bool
  (if (>= at end) (= index (if (or (= kind 1) (= kind 5)) 7 9))
    (if (>= index (if (or (= kind 1) (= kind 5)) 7 9)) false
      (let [step (j/next-character input count at end)]
        (and (>= step 0) (= (mod step 2097152) (key-byte kind index))
             (key-same input count (quot step 2097152) end kind (+ index 1)))))))
(defn- key-kind [input count at end kind]
  (if (> kind 5) 0 (if (key-same input count at end kind 0) kind (key-kind input count at end (+ kind 1)))))
(defn- members [work input count at mask]
  (if (not= (b input count at) 34) -1
    (let [key-end (j/string-end input count (+ at 1))]
      (if (< key-end 0) -1
        (let [kind (key-kind input count (+ at 1) key-end 1) colon (j/skip-space input count (+ key-end 1))]
          (if (or (not= (b input count colon) 58) (and (> kind 0) (not= (bit-and mask (i64-shift-left 1 (- kind 1))) 0))) -1
            (let [start (j/skip-space input count (+ colon 1))]
              (let [end (j/value-end input count start 1)]
                (if (< end 0) -1
                  (do (if (> kind 0) (do (w work (+ 4096 (* kind 8)) start) (w work (+ 4100 (* kind 8)) end)) 0)
                      (let [next (j/skip-space input count end) bits (bit-or mask (if (> kind 0) (i64-shift-left 1 (- kind 1)) 0))]
                        (if (= (b input count next) 125)
                          (if (and (= bits 31) (= (j/skip-space input count (+ next 1)) count)) 1 -1)
                          (if (= (b input count next) 44) (members work input count (j/skip-space input count (+ next 1)) bits) -1)))))))))))))
(defn- parse [work input count]
  (let [start (j/skip-space input count 0)]
    (if (= (b input count start) 123) (members work input count (j/skip-space input count (+ start 1)) 0) -1)))
(defn- natural [work input count kind maximum]
  (j/natural-value input count (r work (+ 4096 (* kind 8))) (r work (+ 4100 (* kind 8))) maximum))
(defn- utf8-save [work value at]
