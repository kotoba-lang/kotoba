            (p work (+ 66 at) (+ 128 (mod (quot value 64) 64))) (p work (+ 67 at) (+ 128 (mod value 64))) (+ at 4))))))
(defn- id-copy [work input count at end pos]
  (if (>= at end) pos
    (let [step (j/next-character input count at end)]
      (if (or (< step 0) (> (+ pos 4) 644)) -1
