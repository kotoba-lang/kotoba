      (let [size (if (record-valid input) (encoded work input) -1)]
        (let [result (if (and (>= size 0) (<= size capacity)) (commit work output capacity size 0) -1)]
          (do (clear work 0) result)))))
(defn encode [work work-bytes input count output capacity]
  (if (and (shape work work-bytes input count output capacity) (= count 2048))
    (encode-run (kernel-subregion work work-bytes 0 8192) (kernel-subregion input count 0 2048) output capacity) -1))
