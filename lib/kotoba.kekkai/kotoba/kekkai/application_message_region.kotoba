;; JUN-757: strict application request/response schema over immutable1MiB.
;; decode(work,actual>=8192,input,actual>=1MiB,used0..1MiB,out,actual4096..65536).
;; Entire declared allocations disjoint; calls serialized. Shape refusal is
;; untouched; processed success/refusal wipes8192 work bytes. Success commits
;; exactly4096 bytes, refusal/tail unchanged. Return1(request)/2(response)/-1.
;; KPM1 record: magic0/version4/kind8/used12/inputBase(u64)16/portOrStatus24/
;; decodedBodyBytes28/headerMask32/rootMask36. Field1..9 spans@64+16*(id-1):
;; value start, exclusive end, UTF16 units(string only), reserved0.
;; Header1..8 spans@256+16*(id-1), including quotes. Rest zero.
;; Input must stay immutable for the record lifetime. Record is data only;
;; no peer/pending/service/socket/route/consent authority. Unknown root fields
;; syntax-checked/ignored; duplicate known/variant fields refused. Headers are
;; case-insensitive canonical allowlists; values strings without controls except HTAB.
;; Plain port1..65535/status100..599. Method ASCII token; path starts single/
;; and refuses controls/backslash. Consumer MUST still normalize/verify actual
;; URL origin, declared endpoint, service policy and fresh trusted consent.
;; Strict RFC4648 Base64 (escapes allowed, pad bits checked); decoded<=1MiB,
;; intersecting total JSON<=1MiB. No reduced body/field length shortcuts.
(ns kekkai.application-message-region
  (:require [kotoba.json.document-region :as j])
  (:export [decode]))
(defn- b [input count at] :i64
  (if (and (>= at 0) (< at count)) (kernel-load-u8 (kernel-subregion input 1048576 at 1) 1 0) -1))
(defn- r [work at] :i64 (kernel-load-u32 (kernel-subregion work 8192 at 4) 4 0))
(defn- w [work at v] :i64 (kernel-store-u32 (kernel-subregion work 8192 at 4) 4 0 v))
(defn- zero [work at] :i64
  (if (>= at 8192) 1 (do (kernel-store-u64 (kernel-subregion work 8192 at 8) 8 0 0) (zero work (+ at 8)))))
(defn- disjoint [a al b bl] :bool (or (<= (+ a al) b) (<= (+ b bl) a)))
(defn- name-size [kind] :i64
  (case kind 1 11 2 9 3 11 4 6 5 4 6 7 7 4 8 10 9 6 10 6 11 12 12 13 13 5 14 14 15 4 16 13 17 13 18 7 19 8 0))
(defn- name-byte [kind i] :i64
  (case kind 1 (case i 0 109 1 101 2 115 3 115 4 97 5 103 6 101 7 84 8 121 9 112 10 101 -1)
    2 (case i 0 114 1 101 2 113 3 117 4 101 5 115 6 116 7 73 8 100 -1)
    3 (case i 0 115 1 101 2 114 3 118 4 105 5 99 6 101 7 78 8 97 9 109 10 101 -1)
    4 (case i 0 109 1 101 2 116 3 104 4 111 5 100 -1)
    5 (case i 0 112 1 97 2 116 3 104 -1)
    6 (case i 0 104 1 101 2 97 3 100 4 101 5 114 6 115 -1)
    7 (case i 0 112 1 111 2 114 3 116 -1)
    8 (case i 0 98 1 111 2 100 3 121 4 66 5 97 6 115 7 101 8 54 9 52 -1)
    9 (case i 0 115 1 116 2 97 3 116 4 117 5 115 -1)
    10 (case i 0 97 1 99 2 99 3 101 4 112 5 116 -1)
    11 (case i 0 99 1 111 2 110 3 116 4 101 5 110 6 116 7 45 8 116 9 121 10 112 11 101 -1)
    12 (case i 0 105 1 102 2 45 3 110 4 111 5 110 6 101 7 45 8 109 9 97 10 116 11 99 12 104 -1)
    13 (case i 0 114 1 97 2 110 3 103 4 101 -1)
    14 (case i 0 99 1 111 2 110 3 116 4 101 5 110 6 116 7 45 8 108 9 101 10 110 11 103 12 116 13 104 -1)
    15 (case i 0 101 1 116 2 97 3 103 -1)
    16 (case i 0 108 1 97 2 115 3 116 4 45 5 109 6 111 7 100 8 105 9 102 10 105 11 101 12 100 -1)
    17 (case i 0 99 1 111 2 110 3 116 4 101 5 110 6 116 7 45 8 114 9 97 10 110 11 103 12 101 -1)
    18 (case i 0 114 1 101 2 113 3 117 4 101 5 115 6 116 -1)
    19 (case i 0 114 1 101 2 115 3 112 4 111 5 110 6 115 7 101 -1) -1))
(defn- same-name [input count at end kind index] :bool
  (if (>= at end) (= index (name-size kind))
    (if (>= index (name-size kind)) false
      (let [n (j/next-character input 1048576 count at end) v (mod n 2097152)]
        (and (>= n 0) (= (if (and (>= kind 10) (<= kind 17) (>= v 65) (<= v 90)) (+ v 32) v) (name-byte kind index))
          (same-name input count (quot n 2097152) end kind (+ index 1)))))))
(defn- name-kind [input count at end kind last] :i64
  (if (> kind last) 0 (if (same-name input count at end kind 0) kind (name-kind input count at end (+ kind 1) last))))
(defn- span [kind] :i64 (+ 64 (* (- kind 1) 16)))
(defn- save-span [work at start end units] :i64
  (do (w work at start) (w work (+ at 4) end) (w work (+ at 8) units)))
(defn- members [work input count at mask] :i64
  (if (not= (b input count at) 34) -1
    (let [key-end (j/string-end input 1048576 count (+ at 1))]
      (if (< key-end 0) -1
        (let [kind (name-kind input count (+ at 1) key-end 1 9) colon (j/skip-space input 1048576 count (+ key-end 1))]
          (if (or (not= (b input count colon) 58) (and (> kind 0) (not= (bit-and mask (i64-shift-left 1 (- kind 1))) 0))) -1
            (let [start (j/skip-space input 1048576 count (+ colon 1))]
              (let [end (j/value-end input 1048576 count start 1)]
                (if (< end 0) -1
                  (do (if (> kind 0) (save-span work (span kind) start end 0) 0)
                    (let [n (j/skip-space input 1048576 count end) bits (bit-or mask (if (> kind 0) (i64-shift-left 1 (- kind 1)) 0))]
                      (if (= (b input count n) 125)
                        (if (= (j/skip-space input 1048576 count (+ n 1)) count) (do (w work 36 bits) 1) -1)
                        (if (= (b input count n) 44) (members work input count (j/skip-space input 1048576 count (+ n 1)) bits) -1)))))))))))))
(defn- string-units [work input count kind] :i64
  (let [at (span kind) start (r work (span kind)) end (r work (+ (span kind) 4))]
    (if (and (= (b input count start) 34) (= (b input count (- end 1)) 34))
      (let [units (j/utf16-length input 1048576 count (+ start 1) (- end 1))]
        (do (if (>= units 0) (w work (+ at 8) units) 0) units)) -1)))
(defn- token [v] :bool
  (or (and (>= v 65) (<= v 90)) (and (>= v 97) (<= v 122)) (and (>= v 48) (<= v 57))
      (= v 33) (= v 35) (= v 36) (= v 37) (= v 38) (= v 39) (= v 42) (= v 43) (= v 45) (= v 46) (= v 94) (= v 95) (= v 96) (= v 124) (= v 126)))
(defn- text-safe [input count at end mode index] :bool
  (if (>= at end) true
    (let [n (j/next-character input 1048576 count at end) v (mod n 2097152)]
      (and (>= n 0)
        (if (= mode 1) (token v)
          (if (= mode 2) (and (>= v 32) (not= v 127) (not= v 92) (or (not= index 0) (= v 47)) (or (not= index 1) (not= v 47)))
            (and (or (= v 9) (>= v 32)) (not= v 127))))
        (text-safe input count (quot n 2097152) end mode (+ index 1))))))
(defn- header-members [work input count at allowed mask] :i64
  (if (not= (b input count at) 34) -1
    (let [end (j/string-end input 1048576 count (+ at 1))]
      (if (< end 0) -1
        (let [kind (name-kind input count (+ at 1) end 10 17) colon (j/skip-space input 1048576 count (+ end 1))]
          (if (or (= kind 0) (not= (b input count colon) 58)) -1
            (let [bit (i64-shift-left 1 (- kind 10)) start (j/skip-space input 1048576 count (+ colon 1))]
              (if (or (= (bit-and allowed bit) 0) (not= (bit-and mask bit) 0) (not= (b input count start) 34)) -1
                (let [finish (j/string-end input 1048576 count (+ start 1))]
                  (if (or (< finish 0) (not (text-safe input count (+ start 1) finish 0 0))) -1
                    (do (save-span work (+ 256 (* (- kind 10) 16)) start (+ finish 1) (j/utf16-length input 1048576 count (+ start 1) finish))
                      (let [n (j/skip-space input 1048576 count (+ finish 1)) bits (bit-or mask bit)]
                        (if (= (b input count n) 125) (do (w work 32 bits) (+ n 1))
                          (if (= (b input count n) 44) (header-members work input count (j/skip-space input 1048576 count (+ n 1)) allowed bits) -1))))))))))))))
(defn- headers [work input count kind] :bool
  (let [start (r work (span 6)) end (r work (+ (span 6) 4))]
    (and (= (b input count start) 123)
      (let [n (j/skip-space input 1048576 count (+ start 1))]
        (= (if (= (b input count n) 125) (+ n 1) (header-members work input count n (if (= kind 1) 15 242) 0)) end)))))
(defn- sextet [v] :i64
  (if (and (>= v 65) (<= v 90)) (- v 65)
    (if (and (>= v 97) (<= v 122)) (- v 71)
      (if (and (>= v 48) (<= v 57)) (+ v 4) (if (= v 43) 62 (if (= v 47) 63 -1))))))
(defn- body-loop [input count at end state previous size pad] :i64
  (if (> size 1048576) -1
    (if (>= at end) (if (and (= state 0) (not= pad 1)) size -1)
      (let [n (j/next-character input 1048576 count at end) v (mod n 2097152)]
        (if (or (< n 0) (= pad 2)) -1
          (if (= v 61)
            (if (and (= state 2) (= pad 0) (= (mod previous 16) 0))
              (body-loop input count (quot n 2097152) end 3 0 size 1)
              (if (and (= state 3) (or (= pad 1) (= (mod previous 4) 0)))
                (body-loop input count (quot n 2097152) end 0 0 (+ size (if (= pad 1) 1 2)) 2) -1))
            (let [value (sextet v)]
              (if (or (< value 0) (not= pad 0)) -1
                (body-loop input count (quot n 2097152) end (mod (+ state 1) 4) value (+ size (if (= state 3) 3 0)) 0)))))))))
(defn- body [work input count] :i64
  (if (< (string-units work input count 8) 0) -1
    (body-loop input count (+ (r work (span 8)) 1) (- (r work (+ (span 8) 4)) 1) 0 0 0 0)))
(defn- schema [work input count] :i64
  (if (not= (b input count (j/skip-space input 1048576 count 0)) 123) -1
    (if (< (members work input count (j/skip-space input 1048576 count (+ (j/skip-space input 1048576 count 0) 1)) 0) 0) -1
      (let [kind (if (= (r work 36) 255) 1 (if (= (r work 36) 419) 2 0))]
        (if (or (= kind 0) (< (string-units work input count 1) 0) (<= (string-units work input count 2) 0)) -1
          (if (not (same-name input count (+ (r work (span 1)) 1) (- (r work (+ (span 1) 4)) 1) (+ kind 17) 0)) -1
            (if (and (= kind 1)
              (or (<= (string-units work input count 3) 0) (<= (string-units work input count 4) 0) (<= (string-units work input count 5) 0)
                  (not (text-safe input count (+ (r work (span 4)) 1) (- (r work (+ (span 4) 4)) 1) 1 0))
                  (not (text-safe input count (+ (r work (span 5)) 1) (- (r work (+ (span 5) 4)) 1) 2 0)))) -1
              (let [field (if (= kind 1) 7 9)]
                (let [number (j/natural-value input 1048576 count (r work (span field)) (r work (+ (span field) 4)) (if (= kind 1) 65535 599))]
                  (if (or (< number (if (= kind 1) 1 100)) (not (headers work input count kind))) -1
                    (let [size (body work input count)]
                      (if (< size 0) -1 (do (w work 8 kind) (w work 24 number) (w work 28 size) kind)))))))))))))
(defn- commit [work output capacity at] :i64
  (if (>= at 4096) (r work 8)
    (do (kernel-store-u64 (kernel-subregion output capacity at 8) 8 0 (kernel-load-u64 (kernel-subregion work 8192 at 8) 8 0))
      (commit work output capacity (+ at 8)))))
(defn- decode-run [work input count output capacity] :i64
  (do (zero work 0)
    (let [kind (schema work input count)]
      (let [result (if (> kind 0)
        (do (w work 0 0x314d504b) (w work 4 1) (w work 12 count)
          (kernel-store-u64 (kernel-subregion work 8192 16 8) 8 0 input) (commit work output capacity 0)) -1)]
        (do (zero work 0) result)))))
(defn decode [work work-bytes input input-capacity count output capacity] :i64
  (if (and (>= work-bytes 8192) (>= input-capacity 1048576) (>= count 0) (<= count 1048576) (>= capacity 4096) (<= capacity 65536)
           (disjoint work work-bytes input input-capacity) (disjoint work work-bytes output capacity) (disjoint input input-capacity output capacity))
    (decode-run (kernel-subregion work work-bytes 0 8192) (kernel-subregion input input-capacity 0 1048576) count output capacity) -1))
