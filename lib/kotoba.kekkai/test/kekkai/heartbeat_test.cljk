(ns kekkai.heartbeat-test
  (:require [ed25519.core :as ed25519]
            [kotoba.test :refer [deftest is testing]]
            [kekkai.heartbeat :as heartbeat]))

(def seed (ed25519/unhex "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"))
(def did (ed25519/did-key-from-seed seed))
(def authorized-node {:did did :status "authorized"})
(def now 100000)

(deftest enrolled-node-can-sign-its-complete-candidate-set
  (let [value (heartbeat/sign "n-laptop" 1 now
                              ["203.0.113.4:41641" "[2001:db8::4]:41642"] seed)]
    (is (empty? (heartbeat/validation-problems "n-laptop" authorized-node
                                               value now 0)))
    (is (= ["203.0.113.4:41641" "[2001:db8::4]:41642"] (:endpoints value)))
    (is (not (contains? value :private-key)))
    (testing "the signature binds the node id as well as the endpoint set"
      (is (some #{:invalid-signature}
                (heartbeat/validation-problems "n-other" authorized-node
                                                value now 0))))))

(deftest heartbeat-signature-binds-candidate-withdrawal
  (let [value (heartbeat/sign "n-laptop" 2 now [] seed)]
    (is (empty? (heartbeat/validation-problems "n-laptop" authorized-node
                                               value now 1)))
    (is (some #{:invalid-signature}
              (heartbeat/validation-problems "n-laptop" authorized-node
                                              (assoc value :endpoints ["203.0.113.4:41641"])
                                              now 1)))))

(deftest replayed-sequences-and-stale-signatures-are-rejected
  (let [value (heartbeat/sign "n-laptop" 7 now ["203.0.113.4:41641"] seed)]
    (is (= [:replayed-sequence]
           (heartbeat/validation-problems "n-laptop" authorized-node value now 7)))
    (is (= [:heartbeat-outside-clock-window]
           (heartbeat/validation-problems
            "n-laptop" authorized-node
            (heartbeat/sign "n-laptop" 8 (- now 301) ["203.0.113.4:41641"] seed)
            now 7)))))

(deftest revoked-nodes-and-oversized-candidate-sets-are-rejected
  (let [revoked (assoc authorized-node :status "revoked")
        value (heartbeat/sign "n-laptop" 8 now ["203.0.113.4:41641"] seed)
        too-many (heartbeat/sign "n-laptop" 8 now (repeat 17 "host.example:41641") seed)]
    (is (= [:node-not-authorized]
           (heartbeat/validation-problems "n-laptop" revoked value now 7)))
    (is (= [:invalid-endpoint-set]
           (heartbeat/validation-problems "n-laptop" authorized-node too-many now 7)))))
