(ns kekkai.netmap-authority-keygen-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kekkai.netmap-authority-keygen :as keygen]
            [kekkai.netmap-reconciler :as reconciler]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]))

(deftest authority-keygen-writes-private-identity-once-and-returns-only-public-data
  (let [directory (.mkdtempSync fs (str (.tmpdir os) "/kekkai-authority-keygen-"))
        identity-file (.join path directory "authority.edn")]
    (try
      (let [generated (keygen/generate! identity-file)
            content (.readFileSync fs identity-file "utf8")
            stat (.lstatSync fs identity-file)
            loaded (reconciler/load-identity! identity-file)
            second-run (try (keygen/generate! identity-file) nil
                            (catch :default error error))]
        (testing "only the authority's public name and pin are returned"
          (is (= #{:authority :authority-spki-b64 :identity-file}
                 (set (keys generated))))
          (is (= (:graph loaded) (:authority generated)))
          (is (= (:authority-spki-b64 loaded)
                 (:authority-spki-b64 generated)))
          (is (string? (:private-b64 loaded)))
          (is (= 384 (bit-and (.-mode stat) 511))))
        (testing "an existing authority cannot be replaced"
          (is (some? second-run))
          (is (= content (.readFileSync fs identity-file "utf8")))))
      (finally (.rmSync fs directory #js {:recursive true :force true})))))
