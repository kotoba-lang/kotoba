(ns kekkai.desired-state-test
  (:require [kotoba.lang.edn :as edn]
            [kotoba.io :as kio] [kotoba.test :refer [deftest is]]
            [kekkai.cacao :as cacao]
            [kekkai.cli :as cli]
            [kekkai.desired-state :as desired]
            [kekkai.envelope :as envelope]
            [kekkai.netmap-distribution :as distribution]))

(defn- temp-root []
  (kio/temp-dir
            "kekkai-desired-"))

(defn- failure-type [f]
  (try
    (f)
    nil
    (catch clojure.lang.ExceptionInfo e
      (:type (ex-data e)))))

(defn- await-netmap-version! [path authority version]
  (loop [attempt 0]
    (let [file (java.io.File. path)
          current (when (.exists file)
                    (envelope/verify (edn/read-string (slurp file)) authority))
          actual (:netmap/version current)]
      (cond
        (= version actual) current
        (>= attempt 200)
        (throw (ex-info "timed out waiting for signed netmap update"
                        {:expected version :actual actual :path path}))
        :else (do (Thread/sleep 50) (recur (inc attempt)))))))

(deftest canonical-content-addressing
  (let [id (cacao/generate-identity)
        input {:kind :kekkai/netmap
               :subject "tailnet/node-a"
               :epoch 1
               :previous-cid nil
               :payload (array-map :z 1 :a {:right 2 :left 1})}
        equivalent (assoc input :payload (array-map :a {:left 1 :right 2} :z 1))
        a (desired/seal input id)
        b (desired/seal equivalent id)
        verified (desired/verify a (desired/authority-spki-b64 id))]
    (is (= (:desired/cid a) (:desired/cid b)))
    (is (= (:desired/signature-b64 a) (:desired/signature-b64 b)))
    (is (= (:graph id) (:desired/name verified)))
    (is (= (:payload input) (:desired/payload verified)))))

(deftest authority-and-integrity-fail-closed
  (let [id (cacao/generate-identity)
        other (cacao/generate-identity)
        env (desired/seal {:kind :kekkai/netmap :subject "n/a" :epoch 1
                           :previous-cid nil :payload {:ok true}}
                          id)]
    (is (= :kekkai/untrusted-desired-signer
           (failure-type #(desired/verify env (desired/authority-spki-b64 other)))))
    (is (= :kekkai/desired-cid-mismatch
           (failure-type #(desired/verify (assoc env :desired/cid "bafkbad")
                                          (desired/authority-spki-b64 id)))))))

(deftest mirrored-publish-pull-and-rollback-protection
  (let [id (cacao/generate-identity)
        authority (desired/authority-spki-b64 id)
        roots [(temp-root) (temp-root)]
        env (desired/seal {:kind :kekkai/netmap :subject "tailnet/node-a"
                           :epoch 1 :previous-cid nil :payload {:peers ["b"]}}
                          id)
        published (desired/publish! roots 2 env authority)
        pulled (desired/pull roots "tailnet/node-a" authority
                             {:kind :kekkai/netmap})]
    (is (= 2 (:desired/copies published)))
    (is (= (:desired/cid env) (:desired/cid pulled)))
    (is (= {:peers ["b"]} (:desired/payload pulled)))
    (is (= :kekkai/desired-epoch-rollback
           (failure-type #(desired/pull roots "tailnet/node-a" authority
                                        {:min-epoch 2}))))))

(deftest mirrored-netmap-pull-is-readable-by-a-resident-node
  (let [identity (cacao/generate-identity)
        authority (desired/authority-spki-b64 identity)
        root (temp-root)
        subject "tailnet/node-a"
        netmap {:netmap/version 1
                :netmap/tailnet "tailnet"
                :netmap/self {:node/id "node-a"
                              :node/key (apply str (repeat 64 "1"))}
                :netmap/peers [] :netmap/edges [] :netmap/relays []}
        output (str root "/netmap.signed.edn")
        published (distribution/publish!
                   {:roots [root] :min-copies 1 :netmap netmap
                    :subject subject :epoch 1 :previous-cid nil}
                   identity)
        pulled (distribution/pull {:roots [root] :subject subject
                                   :authority-spki-b64 authority})
        node-envelope (:desired/payload pulled)]
    (is (= (:desired/cid published) (:desired/cid pulled)))
    (is (= netmap (envelope/verify node-envelope authority)))
    (is (= (.getAbsolutePath (java.io.File. output))
           (distribution/write-node-file! output node-envelope)))
    (is (= netmap
           (envelope/verify (edn/read-string (slurp output)) authority)))))

(deftest watcher-installs-a-newer-mirrored-netmap
  (let [identity (cacao/generate-identity)
        authority (desired/authority-spki-b64 identity)
        root (temp-root)
        subject "tailnet/node-a"
        netmap (fn [version]
                 {:netmap/version version
                  :netmap/tailnet "tailnet"
                  :netmap/self {:node/id "node-a"
                                :node/key (apply str (repeat 64 "1"))}
                  :netmap/peers [] :netmap/edges [] :netmap/relays []})
        publish (fn [version previous-cid]
                  (distribution/publish!
                   {:roots [root] :min-copies 1 :netmap (netmap version)
                    :subject subject :epoch version :previous-cid previous-cid}
                   identity))
        output (str root "/watched-netmap.signed.edn")
        first-head (publish 1 nil)
        watcher (future
                  (binding [*out* (java.io.StringWriter.)]
                    (cli/-main "netmap-watch" root subject authority output "250")))]
    (try
      (is (= 1 (:netmap/version
                (await-netmap-version! output authority 1))))
      (let [second-head (publish 2 (:desired/cid first-head))
            installed (await-netmap-version! output authority 2)]
        (is (= 2 (:netmap/version installed)))
        (is (= (:desired/cid second-head)
               (:desired/cid (distribution/pull
                              {:roots [root] :subject subject
                               :authority-spki-b64 authority}))))
        (is (= (netmap 2) installed)))
      (finally
        (future-cancel watcher)))))

(deftest split-brain-is-not-resolved-by-mirror-order
  (let [id (cacao/generate-identity)
        authority (desired/authority-spki-b64 id)
        roots [(temp-root) (temp-root)]
        mk #(desired/seal {:kind :kekkai/netmap :subject "tailnet/node-a"
                           :epoch 7 :previous-cid nil :payload {:generation %}}
                          id)]
    (desired/publish! [(first roots)] 1 (mk "left") authority)
    (desired/publish! [(second roots)] 1 (mk "right") authority)
    (is (= :kekkai/desired-split-brain
           (failure-type #(desired/pull roots "tailnet/node-a" authority {}))))))

(deftest publisher-does-not-rewind-a-mirror-head
  (let [id (cacao/generate-identity)
        authority (desired/authority-spki-b64 id)
        root (temp-root)
        mk (fn [epoch payload]
             (desired/seal {:kind :kekkai/netmap :subject "tailnet/node-a"
                            :epoch epoch :previous-cid nil :payload payload}
                           id))]
    (desired/publish! [root] 1 (mk 2 {:version 2}) authority)
    (let [failure (try
                    (desired/publish! [root] 1 (mk 1 {:version 1}) authority)
                    nil
                    (catch clojure.lang.ExceptionInfo e e))]
      (is (= :kekkai/desired-mirror-quorum (:type (ex-data failure))))
      (is (= :kekkai/desired-head-rollback
             (-> failure ex-data :results first :error-type))))))

(deftest receipt-is-signed-by-node
  (let [node (cacao/generate-identity)
        env (desired/receipt {:node "node-a" :desired-cid "bafkdesired"
                              :epoch 1 :status :applied
                              :observed-at "2026-08-29T00:00:00Z"
                              :detail {:apps ["hello"]}}
                             node)
        verified (desired/verify env (desired/authority-spki-b64 node)
                                 {:kind desired/receipt-kind})]
    (is (= :applied (get-in verified [:desired/payload :receipt/status])))
    (is (= "bafkdesired" (get-in verified [:desired/payload :receipt/desired-cid])))))

(deftest ssh-mirror-roots-refuse-shell-metacharacters-and-parent-traversal
  (let [id (cacao/generate-identity)
        authority (desired/authority-spki-b64 id)
        env (desired/seal {:kind :kekkai/netmap :subject "tailnet/a"
                           :epoch 1 :previous-cid nil :payload {:ok true}}
                          id)]
    (doseq [root ["ssh://node/tmp/../escape"
                  "ssh://node;touch-pwned/tmp/kekkai"
                  "ssh://node/tmp/kekkai world"]]
      (let [failure (try
                      (desired/publish! [root] 1 env authority)
                      nil
                      (catch clojure.lang.ExceptionInfo e e))]
        (is (= :kekkai/desired-mirror-quorum (:type (ex-data failure))))
        (is (= :kekkai/invalid-ssh-mirror
               (-> failure ex-data :results first :error-type)))))))
