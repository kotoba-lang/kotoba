(ns kekkai.service-record-test
  "ADR-0145's service record: fail-closed shape checks and the client-side
  resolution rules. The digest rule is the one that matters most -- an
  artifact without a digest is unverified, and an unverified offer must not
  resolve just because everything else looks fine."
  (:require [kotoba.test :refer [deftest is testing]]
            [kekkai.service-record :as sr]))

(def ok-rec
  {:service/did "did:key:z6MktestTESTTESTTESTTESTTESTTESTTESTTEST"
   :service/multiaddr "/ip4/127.0.0.1/tcp/41643"
   :service/engine "kotoba-inference"
   :service/model-id "mishima"
   :service/digest "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
   :service/epoch 7})

(deftest valid-record-passes
  (is (:ok (sr/validate ok-rec)))
  (is (:ok (sr/make ok-rec))))

(deftest every-required-key-must-be-present
  (doseq [k sr/required-keys]
    (testing (str k " missing -> :missing-keys")
      (let [v (sr/validate (dissoc ok-rec k))]
        (is (false? (:ok v)))
        (is (= :missing-keys (:reason v)))
        (is (= [k] (:missing v)))))))

(deftest digest-absent-does-not-pass-by-omission
  ;; ADR-0145: an artifact without an expected digest stays unverified.
  (doseq [bad ["" "sha256:short" "md5:0123456789abcdef0123456789abcdef"]]
    (testing (str "digest " (pr-str bad) " -> :bad-or-missing-digest")
      (is (= :bad-or-missing-digest
             (:reason (sr/validate (assoc ok-rec :service/digest bad)))))))
  (is (:ok (sr/validate (assoc ok-rec :service/digest
                               "bafkreigffdu5573aaaaaaaaaaaaaaaaaaaaaaaaaa")))))

(deftest malformed-identity-or-endpoint-rejected
  (is (= :bad-did (:reason (sr/validate (assoc ok-rec :service/did "alice")))))
  (is (= :bad-multiaddr (:reason (sr/validate (assoc ok-rec :service/multiaddr "127.0.0.1:41643")))))
  (is (= :bad-epoch (:reason (sr/validate (assoc ok-rec :service/epoch 0)))))
  (is (= :bad-epoch (:reason (sr/validate (assoc ok-rec :service/epoch "7")))))
  (is (= :bad-model-id (:reason (sr/validate (assoc ok-rec :service/model-id ""))))))

(deftest make-never-returns-an-invalid-record
  (let [r (sr/make (dissoc ok-rec :service/digest))]
    (is (false? (:ok r)))
    (is (nil? (:record r)))))

(deftest supersedes-is-monotonic-within-the-same-offer
  (let [old (assoc ok-rec :service/epoch 7)
        new (assoc ok-rec :service/epoch 8)]
    (is (true? (sr/supersedes? new old)))
    (is (false? (sr/supersedes? old new)))
    (is (false? (sr/supersedes? new new))))
  (testing "a different model is not a revision of this one"
    (is (false? (sr/supersedes? (assoc ok-rec :service/epoch 8 :service/model-id "other")
                                (assoc ok-rec :service/epoch 7))))))

(deftest resolve-for-model-drops-invalid-and-sorts-newest-first
  (let [stale (assoc ok-rec :service/epoch 7)
        fresh (assoc ok-rec :service/epoch 9 :service/did "did:key:z6MkfreshFRESHFRESHFRESHFRES")
        other (assoc ok-rec :service/model-id "qwen3.8" :service/epoch 99)
        broken (dissoc ok-rec :service/digest)
        got (sr/resolve-for-model [stale other broken fresh] "mishima")]
    (is (= 2 (count got)))
    (is (= [fresh stale] got)))
  (testing "an invalid offer is dropped, not repaired or admitted"
    (is (= [] (sr/resolve-for-model [(dissoc ok-rec :service/digest)] "mishima")))))
