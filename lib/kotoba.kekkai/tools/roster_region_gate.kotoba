;; JUN-757: native roster/EDN assertions, public keys/synthetic time only.
(ns kekkai.roster-region-gate
  (:require [kekkai.roster-region :as r] [aiueos.native.legacy-crypto-kat :as kat]
            [kotoba.edn.region :as edn] [aiueos.sha512-stream :as h])
  (:export [run]))
(defn p [i v] (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0 v))
(defn word [i] (kernel-load-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0))
(defn check [yes :bool] :i64 (if yes 1 (do (p 75 (+ (word 75) 1)) 0)))
(defn data [i] (kernel-load-u8 (kernel-subregion (kernel-native-font) 524288 (+ 393216 i) 1) 1 0))
(defn d32 [i] (+ (data i) (* (data (+ i 1)) 256) (* (data (+ i 2)) 65536) (* (data (+ i 3)) 16777216)))
(defn d64 [i] (kernel-load-u64 (kernel-subregion (kernel-native-font) 524288 (+ 393216 i) 8) 8 0))
(defn cp [at v] (kernel-store-u8 (kernel-subregion (kernel-browser-context) 8192 at 1) 1 0 v))
(defn cw [at v] (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 at 4) 4 0 v))
(defn c64 [at v] (kernel-store-u64 (kernel-subregion (kernel-browser-context) 8192 at 8) 8 0 v))
(defn cfg-clear [i]
  (if (>= i 4096) 1 (do (cp (+ 4096 i) 0) (cfg-clear (+ i 1)))))
(defn cfg-copy [i]
  (if (>= i 32) 1
    (do (cp (+ 4096 32 i) (data (+ (d32 28) i))) (cp (+ 4096 64 i) 17) (cfg-copy (+ i 1)))))
(defn cfg-text [i]
  (if (>= i 8) 1
    (do (cp (+ 4096 128 i) (case i 0 110 1 45 2 108 3 97 4 112 5 116 6 111 112))
        (if (< i 7) (cp (+ 4096 1152 i) (case i 0 100 1 101 2 102 3 97 4 117 5 108 116)) 0) (cfg-text (+ i 1)))))
(defn setup []
  (do (cfg-clear 0) (cw 4096 0x4746434b) (cfg-copy 0) (cfg-text 0) (cw (+ 4096 104) 8) (cw (+ 4096 108) 7)
      (cp 2200 115) (cp 2201 115) (cp 2202 104) (cw 2100 0) (cw 2104 22) (c64 2108 1750000000) (c64 2116 1)))
(defn expected-key [i value]
  (if (>= i 32) 1 (do (cp (+ 2048 i) value) (expected-key (+ i 1) value))))
(defn load-map [at count]
  (r/update (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144
    (kernel-subregion (kernel-native-font) 524288 (+ 393216 at) count) count
    (kernel-subregion (kernel-browser-context) 8192 4096 4096) 4096 1750000000))
(defn permit []
  (r/permitted (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144
    (kernel-subregion (kernel-browser-context) 8192 2048 32) 32 (kernel-subregion (kernel-browser-context) 8192 2200 3) 3
    (kernel-subregion (kernel-browser-context) 8192 2100 32) 32))
(defn basic []
  (do (setup) (check (= (r/initialize (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144) 1))
      (check (= (load-map (d32 20) (d32 24)) 1))
      (check (= (r/version (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144) 42))
      (check (= (r/generation (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144) 1))
      (expected-key 0 34)
      (check (= (r/peer-index (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144
                  (kernel-subregion (kernel-browser-context) 8192 2048 32) 32) 3))
      (check (= (r/peer-key-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144 3 0) 34))
      (check (= (r/sessionable (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144
                  (kernel-subregion (kernel-browser-context) 8192 2048 32) 32 1750000000) 1))
      (check (= (permit) 1)) (cw 2100 1) (check (= (permit) 0)) (cw 2100 0) (cw 2104 80) (check (= (permit) 0))
      (cw 2104 22) (expected-key 0 85) (check (= (permit) 0))
      (check (= (r/advance-clock (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144 1749999999) 0))
      (p 84 1)))
(defn park [] (do (kernel-pause) (park)))
(defn run [] :i64
  (do (kernel-cli) (p 74 0) (p 75 0) (p 76 0) (p 77 0) (p 78 0) (p 79 0)
      (if (and (> (kernel-register-value-domain 73) 0) (= (kernel-publish-current-domain 73) 73)
               (= (kernel-value-enable-user) 1) (> (kernel-value-domain-request-page 73) 0))
        (do (p 100 (bit-and (kernel-value-domain-request-page 73) 4294967295)) (p 101 (u64-shift-right (kernel-value-domain-request-page 73) 32))
            (p 79 1) (kat/run) (execute) (p 79 2) (park))
        (do (p 75 1) (p 79 2) (park)))))

(defn rb [at] (kernel-load-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1) 1 0))
(defn rp [at v] (kernel-store-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1) 1 0 v))
(defn rw [at v] (kernel-store-u32 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 4) 4 0 v))
(defn r64 [at v] (kernel-store-u64 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 8) 8 0 v))
(defn fill [at end v]
  (if (>= at end) 1 (do (rp at v) (fill (+ at 1) end v))))
(defn filled [at end v] :bool
  (if (>= at end) true (if (= (rb at) v) (filled (+ at 1) end v) false)))
(defn copy-data [target source count i]
  (if (>= i count) 1 (do (rp (+ target i) (data (+ source i))) (copy-data target source count (+ i 1)))))
(defn same-data [target source count i] :bool
  (if (>= i count) true (if (= (rb (+ target i)) (data (+ source i))) (same-data target source count (+ i 1)) false)))
(defn authority [source i]
  (if (>= i 32) 1 (do (cp (+ 4128 i) (data (+ source i))) (authority source (+ i 1)))))
(defn load-at [at count now]
  (r/update (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144
    (kernel-subregion (kernel-native-font) 524288 (+ 393216 at) count) count
    (kernel-subregion (kernel-browser-context) 8192 4096 4096) 4096 now))
(defn hash-feed [i]
  (if (>= i 65536) 1
    (do (h/stream-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 4608) 4608 (rb i)) (hash-feed (+ i 1)))))
(defn hash-save [target i]
  (if (>= i 64) 1
    (do (cp (+ target i) (h/stream-digest-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 4608) 4608 i)) (hash-save target (+ i 1)))))
(defn state-hash [target]
  (do (h/stream-init (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 4608) 4608)
      (hash-feed 0) (h/stream-finish (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 4608) 4608)
      (hash-save target 0) (fill 65536 70144 0)))
(defn hashes-same [i] :bool
  (if (>= i 64) true
    (if (= (kernel-load-u8 (kernel-subregion (kernel-browser-context) 8192 (+ 2208 i) 1) 1 0)
           (kernel-load-u8 (kernel-subregion (kernel-browser-context) 8192 (+ 2272 i) 1) 1 0)) (hashes-same (+ i 1)) false)))
(defn baseline []
  (do (setup) (authority (d32 32) 0)
      (check (= (r/initialize (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144) 1))
      (check (= (load-at (d32 48) (d32 52) 1750000000) 1))
      ;; A deliberately populated managed-session region tests erasure and
      ;; transaction preservation. It is not a successful Noise handshake.
      (fill 32768 65536 165) (r64 (+ 32768 8) 1) (rw (+ 32768 16) 1) (rw (+ 32768 24) 2)
      (state-hash 2208)))
(defn change-config [mode]
  (case mode
    1 (cp 4224 120) 2 (cp 4160 99) 3 (cp 5248 120) 4 (c64 4192 44)
    5 (c64 4208 1750000001) 6 (cw 4096 0) 7 (cp 4224 255)
    8 (cp 4128 (bit-xor (kernel-load-u8 (kernel-subregion (kernel-browser-context) 8192 4128 1) 1 0) 1))
    9 (c64 4192 -1)
    10 (do (cw 4200 6) (cp 4224 110) (cp 4225 45) (cp 4226 240) (cp 4227 159) (cp 4228 152) (cp 4229 128)) 0))
(defn query-peer [now]
  (r/sessionable (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144
    (kernel-subregion (kernel-browser-context) 8192 2048 32) 32 now))
(defn query [row]
  (do (expected-key 0 34) (c64 2108 (if (< (d32 (+ row 20)) 1750000000) 1750000000 (d32 (+ row 20))))
      (c64 2116 (d32 (+ row 40))) (cw 2100 0) (cw 2104 22)
      (check (= (query-peer (if (< (d32 (+ row 20)) 1750000000) 1750000000 (d32 (+ row 20)))) (d32 (+ row 24))))
      (check (= (permit) (d32 (+ row 28)))) (cw 2100 1) (check (= (permit) (d32 (+ row 32))))
      (cw 2100 0) (cw 2104 80) (check (= (permit) (d32 (+ row 36))))
      (cw 2104 22) (c64 2116 99) (check (= (permit) 0)) (c64 2116 (d32 (+ row 40)))
      (expected-key 0 99) (check (= (query-peer (if (< (d32 (+ row 20)) 1750000000) 1750000000 (d32 (+ row 20)))) 0))))
(defn roster-case [index]
  (let [row (+ (d32 36) (* index 64)) before (word 75)]
    (do (p 85 index) (baseline) (change-config (d32 (+ row 16)))
        (let [result (load-at (d32 row) (d32 (+ row 4)) (d32 (+ row 20)))]
          (do (p (+ 256 index) result) (check (= result (d32 (+ row 12))))))
        (check (filled 65536 262144 0))
        (if (= (d32 (+ row 56)) 1) (check (filled 32768 65536 0))
          (do (state-hash 2272) (check (hashes-same 0))))
        (check (= (r/version (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144) (d32 (+ row 44))))
        (check (= (r/generation (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144) (d32 (+ row 40))))
        (check (= (kernel-load-u32 (kernel-subregion (kernel-value-domain-request-page 73) 262144 36 4) 4 0) (d32 (+ row 60))))
        (query row) (p (+ 768 index) (- (word 75) before)) (p 78 (+ index 1)))))
(defn roster-cases [index]
  (if (>= index (d32 8)) 1 (do (roster-case index) (roster-cases (+ index 1)))))
(defn edn-size [row]
  (case (d32 (+ row 8)) 1 (d32 (+ row 12)) 2 (+ (* (d32 (+ row 12)) 2) 1)
    3 (+ (* (d32 (+ row 12)) 2) 1) 4 (d32 (+ row 12)) (d32 (+ row 4))))
(defn generated-byte [mode n i]
  (case mode
    1 (if (or (= i 0) (= i (- n 1))) 34 65)
    2 (if (< i n) 91 (if (= i n) 48 93))
    3 (if (= i 0) 91 (if (= i (* n 2)) 93 (if (= (mod i 2) 1) 48 32)))
    4 (if (= i (- n 1)) 48 32) 0))
(defn make-edn [row count i]
  (if (>= i count) 1
    (do (rp (+ 196608 i) (if (= (d32 (+ row 8)) 0) (data (+ (d32 row) i)) (generated-byte (d32 (+ row 8)) (d32 (+ row 12)) i)))
        (make-edn row count (+ i 1)))))
(defn same-edn [row count i] :bool
  (if (>= i count) true
    (if (= (rb (+ 196608 i)) (if (= (d32 (+ row 8)) 0) (data (+ (d32 row) i)) (generated-byte (d32 (+ row 8)) (d32 (+ row 12)) i)))
      (same-edn row count (+ i 1)) false)))
(defn parse-edn [size]
  (edn/parse (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 98304) 98304
    (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 size) size))
(defn integer-edn [size]
  (edn/integer-value (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 size) size
    (edn/node-start (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 98304) 98304 0)
    (edn/node-length (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 98304) 98304 0)))
(defn edn-case [index]
  (let [row (+ (d32 44) (* index 32)) size (edn-size row) before (word 75)]
    (do (fill 0 262144 165) (make-edn row size 0)
        (let [result (parse-edn size)] (do (p (+ 384 index) result) (check (= result (d32 (+ row 16))))))
        (check (= (edn/node-count (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 98304) 98304) (d32 (+ row 20))))
        (if (= (edn/node-kind (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 98304) 98304 0) 5)
          (check (= (integer-edn size) (d64 (+ row 24)))) 0)
        (if (= (d32 (+ row 16)) 0) (check (filled 65536 163840 0)) 0)
        (check (filled 0 65536 165)) (check (filled 163840 196608 165)) (check (same-edn row size 0))
        (check (filled (+ 196608 size) 262144 165)) (p (+ 896 index) (- (word 75) before)) (p 82 (+ index 1)))))
(defn edn-cases [index]
  (if (>= index (d32 40)) 1 (do (edn-case index) (edn-cases (+ index 1)))))
(defn update-shape [length count config-size alias]
  (if (= alias 1)
    (r/update (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 length) length
      (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 count) count
      (kernel-subregion (kernel-browser-context) 8192 4096 config-size) config-size 1750000000)
    (if (= alias 2)
      (r/update (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 length) length
        (kernel-subregion (kernel-native-font) 524288 393216 count) count
        (kernel-subregion (kernel-value-domain-request-page 73) 262144 4096 config-size) config-size 1750000000)
      (r/update (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 length) length
        (kernel-subregion (kernel-native-font) 524288 393216 count) count
        (kernel-subregion (kernel-browser-context) 8192 4096 config-size) config-size 1750000000))))
(defn guard [length count config-size alias]
  (do (baseline) (fill 65536 262144 165)
      (check (= (update-shape length count config-size alias) 0))
      (check (filled 65536 262144 165)) (state-hash 2272) (check (hashes-same 0)) (p 74 (+ (word 74) 1))))
(defn edn-shape [length count alias]
  (edn/parse (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 length) length
    (kernel-subregion (kernel-value-domain-request-page 73) 262144 (if (= alias 1) 65536 163840) count) count))
(defn parser-guard [length count alias]
  (do (fill 0 262144 165) (check (= (edn-shape length count alias) 0))
      (check (filled 0 262144 165)) (p 74 (+ (word 74) 1))))
(defn guards []
  (do (guard 262143 0 4096 0) (guard 262144 98305 4096 0)
      (guard 262144 0 4095 0) (guard 262144 1 4096 1) (guard 262144 0 4096 2)
      (parser-guard 98303 1 0) (parser-guard 98304 65537 0) (parser-guard 98304 1 1) (p 76 1)))
(defn execute [] :i64
  (do (p 255 1045794751) (edn-cases 0) (roster-cases 0) (guards) (basic)
      (p 77 (if (= (word 255) 1045794751) 1 0)) (p 83 1)))
