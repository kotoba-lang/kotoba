;; JUN-757: native chunk codec data/shape tests; public bytes, no app authority.
(ns kekkai.application-frame-gate
  (:require [kekkai.application-frame-region :as a] [noise.blake2s-region :as h]
            [kotoba.json.region :as j] [kotoba.edn.region :as e])
  (:export [run]))
(defn p [i v] (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0 v))
(defn word [i] (kernel-load-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0))
(defn check [yes :bool] :i64 (if yes 1 (do (p 75 (+ (word 75) 1)) 0)))
(defn data [i] (kernel-load-u8 (kernel-subregion (kernel-native-font) 524288 (+ 393216 i) 1) 1 0))
(defn d32 [i] (kernel-load-u32 (kernel-subregion (kernel-native-font) 524288 (+ 393216 i) 4) 4 0))
(defn d64 [i] (kernel-load-u64 (kernel-subregion (kernel-native-font) 524288 (+ 393216 i) 8) 8 0))
(defn qb [at] (kernel-load-u8 (kernel-subregion (kernel-value-domain-request-page 74) 262144 at 1) 1 0))
(defn qp [at value] (kernel-store-u8 (kernel-subregion (kernel-value-domain-request-page 74) 262144 at 1) 1 0 value))
(defn rb [at] (kernel-load-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1) 1 0))
(defn rp [at value] (kernel-store-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1) 1 0 value))
(defn fill [at end value]
  (if (>= at end) 1 (do (qp at value) (fill (+ at 1) end value))))
(defn work-fill [at]
  (if (>= at 8192) 1 (do (rp at 165) (work-fill (+ at 1)))))
(defn work-matches [at value] :bool
  (if (>= at 8192) true (and (= (rb at) value) (work-matches (+ at 1) value))))
(defn same [at end value] :bool
  (if (>= at end) true (and (= (qb at) value) (same (+ at 1) end value))))
(defn row [] (+ (d32 12) (* (word 78) 80)))
(defn copy-input [source count i]
  (if (>= i count) 1 (do (qp i (data (+ source i))) (copy-input source count (+ i 1)))))
(defn array-fill [at finish]
  (if (>= at finish) at (do (qp at 48) (qp (+ at 1) 44) (array-fill (+ at 2) finish))))
(defn input [source count mode used]
  (do (fill 0 65536 32) (copy-input source count 0)
      (if (= mode 2)
        (let [end (array-fill count (+ count (* (quot (- used count 3) 2) 2)))]
          (do (qp end 48) (qp (+ end 1) 93) (qp (+ end 2) 125))) 0)))
(defn invoke-at [op work work-bytes input count output capacity]
  (if (= op 0) (a/decode work work-bytes input count output capacity) (a/encode work work-bytes input count output capacity)))
(defn invoke [op work-bytes count capacity alias]
  (if (= alias 1)
    (invoke-at op (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 work-bytes) work-bytes
      (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 count) count
      (kernel-subregion (kernel-value-domain-request-page 74) 262144 65536 capacity) capacity)
    (if (= alias 2)
      (invoke-at op (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 work-bytes) work-bytes
        (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 count) count
        (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 capacity) capacity)
      (if (= alias 3)
        (invoke-at op (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 work-bytes) work-bytes
          (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 count) count
          (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 capacity) capacity)
        (invoke-at op (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 work-bytes) work-bytes
          (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 count) count
          (kernel-subregion (kernel-value-domain-request-page 74) 262144 65536 capacity) capacity)))))
(defn hash-feed [offset count i]
  (if (>= i count) 1
    (do (h/update-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 8192 512) 512 (qb (+ offset i)))
        (hash-feed offset count (+ i 1)))))
(defn digest [offset count]
  (do (h/init (kernel-subregion (kernel-value-domain-request-page 73) 262144 8192 512) 512)
      (hash-feed offset count 0) (h/finish (kernel-subregion (kernel-value-domain-request-page 73) 262144 8192 512) 512)))
(defn hash-save [expected size at]
  (if (>= at 32) 1
    (let [value (if (> size 0) (h/digest-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 8192 512) 512 at) 0)]
      (do (qp (+ 229376 (* (word 78) 32) at) value) (check (= value (data (+ expected at)))) (hash-save expected size (+ at 1))))))
(defn input-save [i compare? :bool] :bool
  (if (>= i 32) true
    (let [v (h/digest-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 8192 512) 512 i)]
      (if compare?
        (and (= v (kernel-load-u8 (kernel-subregion (kernel-browser-context) 8192 (+ 2048 i) 1) 1 0)) (input-save (+ i 1) compare?))
        (do (kernel-store-u8 (kernel-subregion (kernel-browser-context) 8192 (+ 2048 i) 1) 1 0 v) (input-save (+ i 1) compare?))))))
(defn test [at]
  (do (p 90 (word 75)) (input (d32 (+ at 4)) (d32 (+ at 8)) (d32 (+ at 12)) (d64 (+ at 16)))
      (fill 65536 131073 165) (work-fill 0) (digest 0 (d64 (+ at 16))) (input-save 0 false)
      (let [actual (invoke (d32 at) (d32 (+ at 40)) (d64 (+ at 16)) (d64 (+ at 24)) (d32 (+ at 44)))]
        (do (kernel-store-u64 (kernel-subregion (kernel-value-domain-request-page 74) 262144 (+ 196608 (* (word 78) 16)) 8) 8 0 actual)
            (kernel-store-u64 (kernel-subregion (kernel-value-domain-request-page 74) 262144 (+ 196616 (* (word 78) 16)) 8) 8 0 (d64 (+ at 32)))
            (check (= actual (d64 (+ at 32))))
            (check (work-matches 0 (if (= (d32 (+ at 48)) 1) 0 165)))
            (check (same (+ 65536 (d32 (+ at 52))) 131073 165))
            (digest 0 (d64 (+ at 16))) (check (input-save 0 true))
            (if (> (d32 (+ at 52)) 0) (digest 65536 (d32 (+ at 52))) 0)
            (hash-save (d32 (+ at 56)) (d32 (+ at 52)) 0)
            (kernel-store-u32 (kernel-subregion (kernel-value-domain-request-page 74) 262144 (+ 163840 (* (word 78) 4)) 4) 4 0 (- (word 75) (word 90)))
            (p 74 (+ (word 74) 1)) (p 78 (+ (word 78) 1))))))
(defn cases [i]
  (if (>= i (d32 8)) 1
    (do (test (+ (d32 12) (* i 80))) (cases (+ i 1)))))
(defn work-zero [at]
  (if (>= at 8192) 1 (do (kernel-store-u64 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 8) 8 0 0) (work-zero (+ at 8)))))
(defn hmac-key [i]
  (if (>= i 20) 1
    (do (check (= (h/hmac-key-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 8192 512) 512 11) 1)) (hmac-key (+ i 1)))))
(defn hmac-text [i]
  (if (>= i 8) 1
    (do (check (= (h/hmac-update-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 8192 512) 512 (case i 0 72 1 105 2 32 3 84 4 104 5 101 6 114 101)) 1)) (hmac-text (+ i 1)))))
(defn hmac-answer [i]
  (if (>= i 32) 1
    (do (check (= (h/digest-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 8192 512) 512 i) (data (+ 16 i)))) (hmac-answer (+ i 1)))))
(defn edn-answer [source size]
  (do (check (= (e/parse (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 98304) 98304
                  (kernel-subregion (kernel-native-font) 524288 (+ 393216 source) size) size) 1))
      (check (= (e/node-count (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 98304) 98304) 3))
      (check (= (e/node-kind (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 98304) 98304 0) 1))))
(defn shared-known-answers []
  (do (edn-answer (d32 48) (d32 52))
      (check (= (h/hmac-key-init (kernel-subregion (kernel-value-domain-request-page 73) 262144 8192 512) 512) 1))
      (hmac-key 0) (check (= (h/hmac-key-finish (kernel-subregion (kernel-value-domain-request-page 73) 262144 8192 512) 512) 1))
      (hmac-text 0) (check (= (h/hmac-finish (kernel-subregion (kernel-value-domain-request-page 73) 262144 8192 512) 512) 1))
      (hmac-answer 0) (check (= (h/wipe (kernel-subregion (kernel-value-domain-request-page 73) 262144 8192 512) 512) 1)) (p 91 1)))
(defn character-call [op count at end]
  (if (= op 0)
    (j/next-character (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 count) count at end)
    (j/raw-step (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 count) count at end)))
(defn cursor-guards []
  (do (p 93 (word 75)) (qp 0 49)
      (check (= (character-call 0 65537 0 1) -1)) (check (= (character-call 1 65537 0 1) -1))
      (check (= (character-call 0 0 0 0) -1)) (check (= (character-call 1 0 0 0) -1))
      (check (= (character-call 0 1 -1 1) -1)) (check (= (character-call 1 1 1 1) -1))
      (check (= (character-call 0 1 0 2) -1)) (check (= (character-call 1 1 0 2) -1))
      (check (= (character-call 0 1 0 1) 2097201))
      (qp 0 92) (check (= (character-call 0 1 0 1) -1)) (check (= (character-call 1 1 0 1) 2097244))
      (qp 1 47) (check (= (character-call 0 2 0 2) 4194351))
      (p 93 (- (word 75) (word 93))) (p 92 12)))
(defn park [] (do (kernel-pause) (park)))
(defn run [] :i64
  (do (kernel-cli) (p 74 0) (p 75 0) (p 76 0) (p 77 0) (p 78 0) (p 79 0)
      (if (and (> (kernel-register-value-domain 73) 0) (= (kernel-publish-current-domain 73) 73) (= (kernel-value-enable-user) 1)
               (> (kernel-value-domain-request-page 73) 0) (> (kernel-register-value-domain 74) 0) (> (kernel-value-domain-request-page 74) 0)
               (or (<= (+ (kernel-value-domain-request-page 73) 262144) (kernel-value-domain-request-page 74))
                   (<= (+ (kernel-value-domain-request-page 74) 262144) (kernel-value-domain-request-page 73))))
        (do (p 100 (bit-and (kernel-value-domain-request-page 73) 4294967295)) (p 101 (u64-shift-right (kernel-value-domain-request-page 73) 32))
            (p 102 (bit-and (kernel-value-domain-request-page 74) 4294967295)) (p 103 (u64-shift-right (kernel-value-domain-request-page 74) 32))
            (p 79 1) (shared-known-answers) (cursor-guards) (rp 8704 81) (qp 131073 82) (cases 0)
            (check (= (rb 8704) 81)) (check (= (qb 131073) 82))
            (work-zero 0) (check (work-matches 0 0)) (p 76 1) (p 77 1) (p 79 2) (park))
        (do (p 75 1) (p 79 2) (park)))))
