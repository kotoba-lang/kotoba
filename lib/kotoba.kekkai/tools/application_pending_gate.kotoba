;; Public fixed-clock native fixture. No fabricated session/binding/consent.
(ns kekkai.application-pending-gate
  (:require [kekkai.application-frame-region :as codec] [kekkai.application-pending-region :as a] [kekkai.session-region :as s]
            [kekkai.roster-region :as r] [kekkai.session-region-gate :refer [canonical-ik]]
            [aiueos.native.legacy-crypto-kat :as kat])
  (:export [run]))
(defn- put [at v] :i64 (kernel-store-u64-4k (kernel-owned-page 0) 4096 at v))
(defn- get [at] :i64 (kernel-load-u64-4k (kernel-owned-page 0) 4096 at))
(defn- check [yes :bool] :i64
  (do (put 16 (+ (get 16) 1)) (if yes 1 (do (put 8 (+ (get 8) 1)) 0))))
(defn- data [i] :i64 (kernel-load-u8 (kernel-subregion (kernel-native-font) 524288 (+ 393216 i) 1) 1 0))
(defn- d32 [i] :i64 (kernel-load-u32 (kernel-subregion (kernel-native-font) 524288 (+ 393216 i) 4) 4 0))
(defn- td [i] :i64 (d32 (+ 126000 i)))
(defn- cp [at v] :i64 (kernel-store-u8 (kernel-subregion (kernel-browser-context) 8192 at 1) 1 0 v))
(defn- cw [at v] :i64 (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 at 4) 4 0 v))
(defn- qp [at v] :i64 (kernel-store-u8 (kernel-subregion (kernel-value-domain-request-page 74) 262144 at 1) 1 0 v))
(defn- qb [at] :i64 (kernel-load-u8 (kernel-subregion (kernel-value-domain-request-page 74) 262144 at 1) 1 0))
(defn- config [] :i64
  (do (loop [i 4096] (if (>= i 8192) 1 (let [p (cp i 0)] (recur (+ i 1)))))
    (cw 4096 0x4746434b)
    (loop [i 0] (if (>= i 32) 1
      (let [x (cp (+ 4128 i) (data (+ (d32 28) i))) y (cp (+ 4160 i) (data (+ (d32 32) i)))] (recur (+ i 1)))))
    (loop [i 0] (if (>= i 8) 1
      (let [x (cp (+ 4224 i) (case i 0 110 1 45 2 108 3 97 4 112 5 116 6 111 112))
            y (if (< i 7) (cp (+ 5248 i) (case i 0 100 1 101 2 102 3 97 4 117 5 108 116)) 0)] (recur (+ i 1)))))
    (cw 4200 8) (cw 4204 7)))
(defn- load-map [at count now] :i64
  (r/update (kernel-value-domain-request-page 73) 262144
    (kernel-subregion (kernel-native-font) 524288 (+ 393216 at) count) count
    (kernel-subregion (kernel-browser-context) 8192 4096 4096) 4096 (quot now 1000)))
(defn- start [secret now] :i64
  (s/start (kernel-value-domain-request-page 73) 262144
    (kernel-subregion (kernel-native-font) 524288 (+ 393216 (d32 36)) 32) 32
    (kernel-subregion (kernel-native-font) 524288 (+ 393216 secret) 64) 64 (quot now 1000) 0))
(defn- session-message [count writing now] :i64
  (s/handshake-message (kernel-value-domain-request-page 73) 262144
    (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 count) count
    (kernel-subregion (kernel-value-domain-request-page 74) 262144 65536 65536) 65536 (quot now 1000) writing))
(defn- handshake [now] :i64
  (do (loop [i 0] (if (>= i (d32 52)) 1 (let [p (qp i (data (+ (d32 48) i)))] (recur (+ i 1)))))
    (check (= (session-message (d32 52) 0 now) 0))
    (check (= (session-message 0 1 now) (d32 60)))
    (check (= (s/poll (kernel-value-domain-request-page 73) 262144 (quot now 1000)) 2))))
(defn- initialize [now] :i64
  (a/initialize (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144 now 30000))
(defn- sync [now] :i64
  (a/synchronize (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144 now))
(defn- count-is [value] :i64 (check (= (a/pending-count (kernel-value-domain-request-page 76) 262144) value)))
(defn- id [now] :i64
  (a/request-id-copy (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144
    (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 64) 64 now))
(defn- save-id [at] :i64
  (loop [i 0] (if (>= i 64) 1 (let [p (qp (+ at i) (qb i))] (recur (+ i 1))))))
(defn- load-id [at] :i64
  (loop [i 0] (if (>= i 64) 1 (let [p (qp i (qb (+ at i)))] (recur (+ i 1))))))
(defn- pp [at v] :i64 (kernel-store-u8 (kernel-subregion (kernel-application-pool) 8388608 at 1) 1 0 v))
(defn- input-clear [] :i64
  (loop [i 0] (if (>= i 1048576) (pp 1048576 90)
    (let [p (kernel-store-u64 (kernel-subregion (kernel-application-pool) 8388608 i 8) 8 0 0x2020202020202020)] (recur (+ i 8))))))
(defn- copy [source at size] :i64
  (if (<= size 0) at (do (pp at (data source)) (copy (+ source 1) (+ at 1) (- size 1)))))
(defn- wire-id [at i] :i64
  (if (>= i 64) at (do (pp at (qb i)) (wire-id (+ at 1) (+ i 1)))))
(defn- message [response :bool full :bool] :i64
  (do (input-clear)
    (let [prefix (if response 32 16) suffix (if full 48 (if response 40 24))]
      (let [at (wire-id (copy (td prefix) 0 (td (+ prefix 4))) 0)]
        (if full
          (let [end (copy (td suffix) at (- (td (+ suffix 4)) 2)) size (* (quot (- 1048576 (+ at (td (+ suffix 4)))) 4) 4)]
            (do (loop [i 0] (if (>= i size) 1 (let [p (pp (+ end i) 65)] (recur (+ i 1)))))
              (copy (+ (td suffix) (- (td (+ suffix 4)) 2)) (+ end size) 2) 1048576))
          (copy (td suffix) at (td (+ suffix 4))))))))
(defn- invoke [response :bool length session-bytes capacity used now] :i64
  (if response
    (a/complete (kernel-subregion (kernel-value-domain-request-page 76) 262144 0 length) length
      (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 session-bytes) session-bytes
      (kernel-subregion (kernel-application-pool) 8388608 0 capacity) capacity used now)
    (a/begin (kernel-subregion (kernel-value-domain-request-page 76) 262144 0 length) length
      (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 session-bytes) session-bytes
      (kernel-subregion (kernel-application-pool) 8388608 0 capacity) capacity used now)))
(defn- call [response :bool used now] :i64 (invoke response 262144 262144 1048576 used now))
(defn- shape-guards [response :bool now] :i64
  (do (check (= (invoke response 262143 262144 1048576 0 now) -1))
      (check (= (invoke response 262144 262143 1048576 0 now) -1))
      (check (= (invoke response 262144 262144 1048575 0 now) -1))
      (check (= (invoke response 262144 262144 1048576 -1 now) -1))
      (check (= (invoke response 262144 262144 1048576 1048577 now) -1))))
(defn- api-shape-call [op length session-bytes capacity now] :i64
  (if (= op 1)
    (a/initialize (kernel-subregion (kernel-value-domain-request-page 76) 262144 0 length) length
      (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 session-bytes) session-bytes now 30000)
    (if (= op 2)
      (a/synchronize (kernel-subregion (kernel-value-domain-request-page 76) 262144 0 length) length
        (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 session-bytes) session-bytes now)
      (if (= op 3)
        (a/request-id-copy (kernel-subregion (kernel-value-domain-request-page 76) 262144 0 length) length
          (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 session-bytes) session-bytes
          (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 capacity) capacity now)
        (if (= op 4)
          (a/result-copy (kernel-subregion (kernel-value-domain-request-page 76) 262144 0 length) length
            (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 session-bytes) session-bytes
            (kernel-subregion (kernel-value-domain-request-page 74) 262144 73728 capacity) capacity now)
          (a/cancel (kernel-subregion (kernel-value-domain-request-page 76) 262144 0 length) length
            (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 session-bytes) session-bytes 1 now))))))
(defn- api-shapes [op now] :i64
  (if (> op 5) 1
    (do (check (= (api-shape-call op 262143 262144 64 now) -1))
        (check (= (api-shape-call op 262144 262143 64 now) -1))
        (if (= op 3) (check (= (api-shape-call op 262144 262144 63 now) -1))
          (if (= op 4) (check (= (api-shape-call op 262144 262144 511 now) -1)) 0))
        (api-shapes (+ op 1) now))))
(defn- cancel [handle now] :i64
  (a/cancel (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144 handle now))
(defn- checkpoint [kind] :i64
  (let [phase (+ (get 40) 1)]
    (do (put 64 kind) (put 40 phase) (loop [i 0] (if (= (get 48) phase) 1 (let [p (kernel-pause)] (recur (+ i 1))))))))
(defn- result-copy [now] :i64
  (a/result-copy (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144
    (kernel-subregion (kernel-value-domain-request-page 74) 262144 73728 65536) 65536 now))
(defn- fill-all [now] :i64
  (loop [i 1] (if (> i 256) 1
    (let [x (check (= (id now) 64)) y (if (= i 1) (save-id 64) (if (= i 255) (save-id 192) (if (= i 256) (save-id 128) 0)))
          used (message false false) z (check (= (call false used now) i)) c (count-is i)] (recur (+ i 1))))))
(defn- refusal-call [op now] :i64
  (case op
    1 (invoke false 262143 262144 1048576 0 now)
    2 (invoke false 262144 262143 1048576 0 now)
    3 (invoke false 262144 262144 1048575 0 now)
    4 (invoke false 262144 262144 1048576 -1 now)
    5 (invoke false 262144 262144 1048576 1048577 now)
    6 (a/begin (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 76) 262144
        (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 1048576 0 now)
    7 (a/begin (kernel-subregion (kernel-application-pool) 8388608 0 262144) 262144 (kernel-value-domain-request-page 73) 262144
        (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 1048576 0 now)
    8 (a/result-copy (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144
        (kernel-subregion (kernel-value-domain-request-page 76) 262144 0 512) 512 now)
    9 (a/request-id-copy (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144
        (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 64) 64 now)
    10 (call false 0 (- now 1))
    11 (a/synchronize (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 74) 262144 now)
    12 (initialize now)
    (call true (get 96) now)))
(defn- refusals [op now] :i64
  (if (> op 13) 1
    (do (if (= op 13) (do (check (= (id now) 64)) (put 96 (message true false))) 0)
        (checkpoint 10) (let [v (refusal-call op now)] (do (put 56 v) (check (= v -1))))
        (checkpoint 11) (refusals (+ op 1) now))))
(defn- tests [now] :i64
  (do (api-shapes 1 now) (shape-guards false now) (shape-guards true now) (fill-all now) (checkpoint 1)
      (check (= (id now) 64)) (check (= (call false (message false false) now) -1)) (count-is 256) (refusals 1 now)
      (load-id 128) (let [used (message true false)]
        (do (check (= (call true used now) 256)) (check (= (call true used now) -2))))
      (count-is 255) (check (= (result-copy now) 512)) (checkpoint 2)
      (check (= (a/release-result (kernel-value-domain-request-page 76) 262144) 1))
      (check (= (call true (message true false) now) -1))
      (check (= (cancel 128 now) 1)) (check (= (cancel 128 now) 0)) (count-is 254)
      (load-id 64) (check (= (call false (message false false) now) -1))
      (check (= (id now) 64)) (check (= (call false (message false false) now) 257)) (count-is 255)
      (check (= (id now) 64)) (check (= (call false (message false false) now) 258)) (count-is 256)
      (load-id 192) (check (= (call true (message true false) now) 255)) (count-is 255) (checkpoint 3)
      (check (= (initialize now) -1))
      (check (= (s/stop (kernel-value-domain-request-page 73) 262144) 1))
      (check (= (start (d32 176) now) 1)) (handshake now) (check (= (sync now) 2)) (count-is 0) (checkpoint 4)
      (check (= (id now) 64)) (let [used (message false true)] (check (= (call false used now) 259))) (count-is 1) (save-id 256) (checkpoint 5)
      (check (= (id now) 64)) (check (= (call false (message false false) now) 260)) (count-is 2)
      (check (= (sync (+ now 29999)) 2)) (count-is 2)
      (load-id 256) (check (= (call true (message true false) (+ now 29999)) 259)) (count-is 1)
      (check (= (result-copy (+ now 29999)) 512)) (checkpoint 6)
      (check (= (sync (+ now 30000)) 2)) (count-is 0) (check (= (result-copy (+ now 30000)) -1)) (checkpoint 7)
      (check (= (id (+ now 30000)) 64)) (check (= (call false (message false false) (+ now 30000)) 261)) (count-is 1)
      (check (= (load-map (d32 88) (d32 92) (+ now 30000)) 1))
      (check (= (sync (+ now 30000)) 0)) (count-is 0) (checkpoint 8)
      (check (= (id (+ now 30000)) -1)) (check (= (call true (message true false) (+ now 30000)) -1))
      (check (= (a/stop (kernel-value-domain-request-page 76) 262144) 1)) (checkpoint 9)))
(defn- park [] :i64 (do (kernel-pause) (park)))
(defn run [] :i64
  (do (kernel-cli)
    (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 300 4) 4 0 0)
    (if (and (> (kernel-register-value-domain 73) 0) (= (kernel-publish-current-domain 73) 73) (= (kernel-value-enable-user) 1)
             (> (kernel-register-value-domain 74) 0) (> (kernel-register-value-domain 76) 0))
      (do (kat/run) (canonical-ik) (config)
        (put 0 0x315453504b) (put 8 0) (put 16 0) (put 24 1) (put 32 (kernel-value-domain-request-page 76)) (put 40 0) (put 48 0)
        (put 72 (kernel-value-domain-request-page 73)) (put 80 (kernel-value-domain-request-page 74)) (put 88 (kernel-application-pool))
        (check (= (codec/decode (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 8192) 8192
          (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 0) 0
          (kernel-subregion (kernel-value-domain-request-page 74) 262144 65536 2048) 2048) -1))
        (check (not (codec/valid-record (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 2048) 2048)))
        (check (= (codec/encode (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 8192) 8192
          (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 2048) 2048
          (kernel-subregion (kernel-value-domain-request-page 74) 262144 65536 2048) 2048) -1))
        (check (= (r/initialize (kernel-value-domain-request-page 73) 262144) 1)) (check (= (load-map (d32 20) (d32 24) 1750000000000) 1))
        (check (= (start (d32 40) 1750000000000) 1)) (check (= (initialize 1750000000000) 1))
        (handshake 1750000000000)
        (loop [i 0] (if (>= i 262144) 1
          (let [p (kernel-store-u64 (kernel-subregion (kernel-value-domain-request-page 74) 262144 i 8) 8 0 -6510615555426900571)] (recur (+ i 8)))))
        (tests 1750000000000) (put 24 2) (park))
      (park))))
