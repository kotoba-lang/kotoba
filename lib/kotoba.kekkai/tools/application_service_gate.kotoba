;; JUN-757: public native service/profile fixture; no endpoint or effect grant.
(ns kekkai.application-service-gate
  (:require [kekkai.application-service-region :as service]
            [kekkai.application-receive-region :as bridge]
            [kekkai.application-reassembly-region :as assembly]
            [kekkai.session-region :as s] [kekkai.roster-region :as r]
            [kekkai.session-region-gate :refer [canonical-ik]]
            [aiueos.native.legacy-crypto-kat :as kat])
  (:export [run]))
(defn- put [at v] :i64 (kernel-store-u64-4k (kernel-owned-page 0) 4096 at v))
(defn- get [at] :i64 (kernel-load-u64-4k (kernel-owned-page 0) 4096 at))
(defn- check [yes :bool] :i64
  (do (put 16 (+ (get 16) 1)) (if yes 1 (do (put 8 (+ (get 8) 1)) 0))))
(defn- data [i] :i64 (kernel-load-u8 (kernel-subregion (kernel-native-font) 524288 (+ 393216 i) 1) 1 0))
(defn- d32 [i] :i64 (kernel-load-u32 (kernel-subregion (kernel-native-font) 524288 (+ 393216 i) 4) 4 0))
(defn- td [i] :i64 (d32 (+ 126000 i)))
(defn- cp [at v] :i64 (kernel-store-u8 (kernel-subregion (kernel-browser-context) 8192 at 1) 1 0 v))
(defn- cw [at v] :i64 (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 at 4) 4 0 v))
(defn- qp [at v] :i64 (kernel-store-u8 (kernel-subregion (kernel-value-domain-request-page 74) 262144 at 1) 1 0 v))
(defn- qb [at] :i64 (kernel-load-u8 (kernel-subregion (kernel-value-domain-request-page 74) 262144 at 1) 1 0))
(defn- config [] :i64
  (do (loop [i 4096] (if (>= i 8192) 1 (let [p (cp i 0)] (recur (+ i 1)))))
    (cw 4096 0x4746434b)
    (loop [i 0] (if (>= i 32) 1
      (let [x (cp (+ 4128 i) (data (+ (d32 28) i))) y (cp (+ 4160 i) (data (+ (d32 32) i)))] (recur (+ i 1)))))
    (loop [i 0] (if (>= i 8) 1
      (let [x (cp (+ 4224 i) (case i 0 110 1 45 2 108 3 97 4 112 5 116 6 111 112))
            y (if (< i 7) (cp (+ 5248 i) (case i 0 100 1 101 2 102 3 97 4 117 5 108 116)) 0)] (recur (+ i 1)))))
    (cw 4200 8) (cw 4204 7)))
(defn- load-map [at count now] :i64
  (r/update (kernel-value-domain-request-page 73) 262144
    (kernel-subregion (kernel-native-font) 524288 (+ 393216 at) count) count
    (kernel-subregion (kernel-browser-context) 8192 4096 4096) 4096 (quot now 1000)))
(defn- start [secret now] :i64
  (s/start (kernel-value-domain-request-page 73) 262144
    (kernel-subregion (kernel-native-font) 524288 (+ 393216 (d32 36)) 32) 32
    (kernel-subregion (kernel-native-font) 524288 (+ 393216 secret) 64) 64 (quot now 1000) 0))
(defn- session-message [count writing now] :i64
  (s/handshake-message (kernel-value-domain-request-page 73) 262144
    (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 count) count
    (kernel-subregion (kernel-value-domain-request-page 74) 262144 65536 65536) 65536 (quot now 1000) writing))
(defn- handshake [now] :i64
  (do (loop [i 0] (if (>= i (d32 52)) 1 (let [p (qp i (data (+ (d32 48) i)))] (recur (+ i 1)))))
    (check (= (session-message (d32 52) 0 now) 0))
    (check (= (session-message 0 1 now) (d32 60)))
    (check (= (s/poll (kernel-value-domain-request-page 73) 262144 (quot now 1000)) 2))))

(defn- iw [at value] :i64 (kernel-store-u32 (kernel-subregion (kernel-value-domain-request-page 74) 262144 at 4) 4 0 value))
(defn- now [time] :i64 (kernel-store-u64 (kernel-subregion (kernel-value-domain-request-page 74) 262144 8 8) 8 0 time))
(defn- build [at count i] :i64
  (if (>= i count) count
    (do (kernel-store-u8 (kernel-subregion (kernel-application-transmit-pool) 1048576 i 1) 1 0 (data (+ at i)))
      (build at count (+ i 1)))))
(defn- configure [which offset count time] :i64
  (do (build offset count 0) (iw 16 count) (now time)
    (service/configure (kernel-subregion (kernel-value-domain-request-page 75) 262144 (* which 32768) 32768) 32768
      (kernel-value-domain-request-page 73) 262144 (kernel-application-transmit-pool) 1048576
      (kernel-value-domain-request-page 74) 262144)))
(defn- outgoing [which count time] :i64
  (do (iw 16 count) (iw 4 1472) (now time)
    (service/outgoing (kernel-subregion (kernel-value-domain-request-page 75) 262144 (* which 32768) 32768) 32768
      (kernel-value-domain-request-page 73) 262144 (kernel-application-transmit-pool) 1048576
      (kernel-value-domain-request-page 74) 262144)))
(defn- incoming [which time] :i64
  (do (iw 4 1472) (now time)
    (service/incoming (kernel-subregion (kernel-value-domain-request-page 75) 262144 (* which 32768) 32768) 32768
      (kernel-value-domain-request-page 73) 262144 (kernel-application-pool) 8388608
      (kernel-value-domain-request-page 74) 262144)))
(defn- park [] :i64 (do (kernel-pause) (park)))
(defn run [] :i64
  (do (kernel-cli)
    (if (and (> (kernel-register-value-domain 73) 0) (= (kernel-publish-current-domain 73) 73) (= (kernel-value-enable-user) 1)
             (> (kernel-register-value-domain 74) 0) (> (kernel-register-value-domain 75) 0) (> (kernel-register-value-domain 76) 0))
      (do (kat/run) (canonical-ik) (config)
        (put 0 0x3156534b) (put 8 0) (put 16 0) (put 24 1)
        (put 32 (kernel-value-domain-request-page 75)) (put 72 (kernel-value-domain-request-page 73))
        (put 80 (kernel-value-domain-request-page 74)) (put 88 (kernel-application-pool)) (put 112 (kernel-application-transmit-pool))
        (check (= (r/initialize (kernel-value-domain-request-page 73) 262144) 1))
        (check (= (load-map (d32 20) (d32 24) 1750000000000) 1)) (check (= (start (d32 40) 1750000000000) 1))
        (check (= (configure 0 (d32 65536) (d32 65540) 1750000000000) 1))
        (check (= (configure 1 (d32 65544) (d32 65548) 1750000000000) 1))
        (handshake 1750000000000)
        (check (= (bridge/initialize (kernel-application-pool) 8388608 (kernel-value-domain-request-page 73) 262144
          (kernel-value-domain-request-page 74) 262144 1750000000) 1))
        (build (d32 65552) (d32 65556) 0)
        (check (= (outgoing 0 (d32 65556) 1750000000000) -1))
        (check (= (incoming 1 1750000000000) -1))
        (check (= (service/stop (kernel-subregion (kernel-value-domain-request-page 75) 262144 0 32768) 32768) 1))
        (put 24 2) (park))
      (park))))
