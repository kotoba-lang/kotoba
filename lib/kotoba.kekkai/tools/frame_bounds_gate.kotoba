;; JUN-757: full-size v1 frames, both roles, real native crypto/owned buffers.
;; Public deterministic data only. No NIC, app/SSH grant, physical deployment.
(ns kekkai.frame-bounds-gate
  (:require [kekkai.frame-region :as f] [kekkai.session-region :as s] [kekkai.roster-region :as r]
            [noise.blake2s-region :as h] [kekkai.wire-region :as w] [kekkai.session-region-gate :refer [canonical-ik]]
            [aiueos.native.legacy-crypto-kat :as kat])
  (:export [run]))
(defn p [i v] (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0 v))
(defn word [i] (kernel-load-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0))
(defn check [yes :bool] :i64 (if yes 1 (do (p 75 (+ (word 75) 1)) 0)))
(defn data [i] (kernel-load-u8 (kernel-subregion (kernel-native-font) 524288 (+ 393216 i) 1) 1 0))
(defn d32 [i] (+ (data i) (* (data (+ i 1)) 256) (* (data (+ i 2)) 65536) (* (data (+ i 3)) 16777216)))
(defn cp [at v] (kernel-store-u8 (kernel-subregion (kernel-browser-context) 8192 at 1) 1 0 v))
(defn cw [at v] (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 at 4) 4 0 v))
(defn cfg-clear [i]
  (if (>= i 4096) 1 (do (cp (+ 4096 i) 0) (cfg-clear (+ i 1)))))
(defn cfg-copy [i]
  (if (>= i 32) 1
    (do (cp (+ 4128 i) (data (+ (d32 28) i))) (cp (+ 4160 i) (data (+ (d32 32) i))) (cfg-copy (+ i 1)))))
(defn cfg-text [i]
  (if (>= i 8) 1
    (do (cp (+ 4224 i) (case i 0 110 1 45 2 108 3 97 4 112 5 116 6 111 112))
        (if (< i 7) (cp (+ 5248 i) (case i 0 100 1 101 2 102 3 97 4 117 5 108 116)) 0) (cfg-text (+ i 1)))))
(defn setup []
  (do (cfg-clear 0) (cw 4096 0x4746434b) (cfg-copy 0) (cfg-text 0) (cw 4200 8) (cw 4204 7)))
(defn load-map [at count]
  (r/update (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144
    (kernel-subregion (kernel-native-font) 524288 (+ 393216 at) count) count
    (kernel-subregion (kernel-browser-context) 8192 4096 4096) 4096 1750000000))
(defn start-at [pub secret role]
  (s/start (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144
    (kernel-subregion (kernel-native-font) 524288 (+ 393216 pub) 32) 32
    (kernel-subregion (kernel-native-font) 524288 (+ 393216 secret) 64) 64 1750000000 role))
(defn qb [at] (kernel-load-u8 (kernel-subregion (kernel-value-domain-request-page 74) 262144 at 1) 1 0))
(defn qp [at value] (kernel-store-u8 (kernel-subregion (kernel-value-domain-request-page 74) 262144 at 1) 1 0 value))
(defn qw [at value] (kernel-store-u32 (kernel-subregion (kernel-value-domain-request-page 74) 262144 at 4) 4 0 value))
(defn zeros [at end] :bool
  (if (>= at end) true
    (and (= (kernel-load-u64 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 8) 8 0) 0) (zeros (+ at 8) end))))
(defn clear-io [at end]
  (if (>= at end) 1 (do (qp at 0) (clear-io (+ at 1) end))))
(defn sentinel [at end]
  (if (>= at end) 1 (do (qp at 165) (sentinel (+ at 1) end))))
(defn rb [at] (kernel-load-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1) 1 0))
(defn filled [at end value] :bool
  (if (>= at end) true (and (= (qb at) value) (filled (+ at 1) end value))))
(defn fingerprint-feed [at]
  (if (>= at 65536) 1
    (do (h/update-byte (kernel-subregion (kernel-value-domain-request-page 74) 262144 214016 512) 512 (rb at))
        (fingerprint-feed (+ at 1)))))
(defn fingerprint-bytes [mode at] :bool
  (if (>= at 32) true
    (let [value (h/digest-byte (kernel-subregion (kernel-value-domain-request-page 74) 262144 214016 512) 512 at)]
      (if (= mode 0)
        (do (cp (+ 3584 at) value) (fingerprint-bytes mode (+ at 1)))
        (and (= value (kernel-load-u8 (kernel-subregion (kernel-browser-context) 8192 (+ 3584 at) 1) 1 0))
             (fingerprint-bytes mode (+ at 1)))))))
(defn fingerprint [mode] :bool
  (do (h/init (kernel-subregion (kernel-value-domain-request-page 74) 262144 214016 512) 512)
      (fingerprint-feed 0) (h/finish (kernel-subregion (kernel-value-domain-request-page 74) 262144 214016 512) 512)
      (fingerprint-bytes mode 0)))
(defn row [] (d32 132))
(defn v [at] (d32 (+ (row) at)))
(defn result [actual expected]
  (do (kernel-store-u64 (kernel-subregion (kernel-value-domain-request-page 74) 262144 (+ 229376 (* (word 80) 16)) 8) 8 0 actual)
      (kernel-store-u64 (kernel-subregion (kernel-value-domain-request-page 74) 262144 (+ 229384 (* (word 80) 16)) 8) 8 0 expected)
      (p 80 (+ (word 80) 1)) (check (= actual expected)) actual))
(defn before [] (do (sentinel 73728 139266) (fingerprint 0)))
(defn after [actual]
  (do (result actual -1) (check (fingerprint 1)) (check (filled 73728 139266 165))
      (check (filled 147456 212992 0)) (check (zeros 65536 262144)) (p 74 (+ (word 74) 1))))
(defn raw-input [source count i]
  (if (>= i count) 1 (do (qp (+ 4099 i) (data (+ source i))) (raw-input source count (+ i 1)))))
(defn peer-input [kind source count]
  (do (qp 4096 107) (qp 4097 1) (qp 4098 kind) (raw-input source count 0) (qw 0 (+ count 3))))
(defn pattern [count start i]
  (if (>= i count) 1 (do (qp (+ 4096 i) (mod (+ (* i 17) start) 256)) (pattern count start (+ i 1)))))
(defn same-pattern [count start offset i] :bool
  (if (>= i count) true
    (and (= (qb (+ 73728 i)) (mod (+ (* (+ i offset) 17) start) 256)) (same-pattern count start offset (+ i 1)))))
(defn recv []
  (f/receive (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144
    (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 262144) 262144 1750000000))
(defn hs []
  (f/send-handshake (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144
    (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 262144) 262144 1750000000))
(defn send []
  (f/send (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144
    (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 262144) 262144 1750000000 1))
(defn hash-feed [count i]
  (if (>= i count) 1
    (do (h/update-byte (kernel-subregion (kernel-value-domain-request-page 74) 262144 214016 512) 512 (qb (+ 73731 i)))
        (hash-feed count (+ i 1)))))
(defn hash-save [expected i]
  (if (>= i 32) 1
    (let [value (h/digest-byte (kernel-subregion (kernel-value-domain-request-page 74) 262144 214016 512) 512 i)]
      (do (qp (+ 216064 (* (word 81) 32) i) value) (check (= value (data (+ expected i)))) (hash-save expected (+ i 1))))))
(defn wire-hash [count expected kind]
  (do (check (= (qb 73728) 107)) (check (= (qb 73729) 1)) (check (= (qb 73730) kind))
      (check (filled (+ 73731 count) 139266 165))
      (h/init (kernel-subregion (kernel-value-domain-request-page 74) 262144 214016 512) 512)
      (hash-feed count 0) (h/finish (kernel-subregion (kernel-value-domain-request-page 74) 262144 214016 512) 512)
      (hash-save expected 0) (p 81 (+ (word 81) 1))))
(defn write-handshake []
  (do (pattern (v 44) (+ (v 88) (if (= (v 0) 1) 0 7)) 0) (qw 0 (v 44))
      (qw 4 (+ (v 44) (if (= (v 0) 1) 98 50))) (before) (after (hs))
      (qw 4 65538) (before) (result (hs) (+ (v 44) (if (= (v 0) 1) 99 51)))
      (wire-hash (+ (v 44) (if (= (v 0) 1) 96 48)) (v 52) (if (= (v 0) 1) 48 49))))
(defn read-handshake []
  (do (peer-input (if (= (v 0) 1) 48 49) (v 36) (v 40))
      (qw 4 65538) (before) (after (recv)) (qp 4098 (if (= (v 0) 1) 49 48))
      (qw 4 (- (v 48) 1)) (before) (after (recv))
      (qw 4 65538) (before) (result (recv) (+ (* (if (= (v 0) 1) 49 48) 65536) (v 48)))
      (check (same-pattern (v 48) (+ (v 88) (if (= (v 0) 1) 7 0)) 0 0))
      (check (filled (+ 73728 (v 48)) 139266 165))))
(defn copy-body [count i]
  (if (>= i count) 1 (do (qp (+ 4096 i) (qb (+ 73728 i))) (copy-body count (+ i 1)))))
(defn transport []
  (do (peer-input 50 (v 68) (v 72)) (qw 4 (- (v 76) 2)) (before) (after (recv))
      (qw 4 65538) (before) (result (recv) (+ 65536 (- (v 76) 1)))
      (check (same-pattern (- (v 76) 1) (+ (v 88) 14) 1 0))
      (check (filled (+ 73728 (- (v 76) 1)) 139266 165))
      (copy-body (- (v 76) 1) 0) (qw 0 (- (v 76) 1)) (qw 4 (+ (v 76) 26)) (before) (after (send))
      (qw 4 65538) (before) (result (send) (+ (v 76) 27))
      (wire-hash (+ (v 76) 24) (v 80) 50)))
(defn park [] (do (kernel-pause) (park)))
(defn run [] :i64
  (do (kernel-cli) (p 74 0) (p 75 0) (p 76 0) (p 77 0) (p 78 0) (p 79 0) (p 80 0) (p 81 0)
      (if (and (> (kernel-register-value-domain 73) 0) (= (kernel-publish-current-domain 73) 73)
               (= (kernel-value-enable-user) 1) (> (kernel-value-domain-request-page 73) 0)
               (> (kernel-register-value-domain 74) 0) (> (kernel-value-domain-request-page 74) 0)
               (or (<= (+ (kernel-value-domain-request-page 73) 262144) (kernel-value-domain-request-page 74))
                   (<= (+ (kernel-value-domain-request-page 74) 262144) (kernel-value-domain-request-page 73))))
        (do (p 100 (bit-and (kernel-value-domain-request-page 73) 4294967295)) (p 101 (u64-shift-right (kernel-value-domain-request-page 73) 32))
            (p 102 (bit-and (kernel-value-domain-request-page 74) 4294967295)) (p 103 (u64-shift-right (kernel-value-domain-request-page 74) 32))
            (p 79 1) (kat/run) (canonical-ik) (clear-io 0 262144) (setup)
            (result (r/initialize (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144) 1)
            (result (load-map (v 16) (v 20)) 1) (result (start-at (d32 36) (v 32) (v 0)) 1)
            (if (= (v 0) 1) (do (write-handshake) (read-handshake)) (do (read-handshake) (write-handshake)))
            (transport) (result (s/stop (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262144) 262144) 1)
            (qw 0 0) (before) (after (recv))
            (check (zeros 32768 262144)) (p 76 1) (p 77 1) (p 78 1) (p 79 2) (park))
        (do (p 75 1) (p 79 2) (park)))))
