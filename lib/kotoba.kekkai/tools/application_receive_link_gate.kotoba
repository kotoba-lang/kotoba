(defn fingerprint-bytes [mode at] :bool
  (if (>= at 32) true
    (let [value (h/digest-byte (kernel-subregion (kernel-value-domain-request-page 74) 262144 214016 512) 512 at)]
      (if (= mode 0)
        (do (cp (+ 3584 at) value) (fingerprint-bytes mode (+ at 1)))
        (and (= value (kernel-load-u8 (kernel-subregion (kernel-browser-context) 8192 (+ 3584 at) 1) 1 0))
             (fingerprint-bytes mode (+ at 1)))))))
(defn fingerprint [mode] :bool
  (do (h/init (kernel-subregion (kernel-value-domain-request-page 74) 262144 214016 512) 512)
      (fingerprint-feed 0) (h/finish (kernel-subregion (kernel-value-domain-request-page 74) 262144 214016 512) 512)
      (fingerprint-bytes mode 0)))
(defn call-frame [op owner length io io-size]
  (if (= op 0) (f/receive owner length io io-size (clock))
    (if (= op 1) (f/send-handshake owner length io io-size (clock))
      (f/send owner length io io-size (clock) (if (= op 3) 0 (if (= op 4) 6 (if (= op 5) 5 1)))))))
(defn invoke [op length io-size alias]
  (if (= alias 1)
    (call-frame op (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 length) length
      (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 io-size) io-size)
    (call-frame op (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 length) length
      (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 io-size) io-size)))
(defn guard [op length io-size alias used capacity shape? :bool]
  (do (qw 0 used) (qw 4 capacity) (sentinel 73728 139266) (sentinel 147456 212992) (fingerprint 0)
      (check (= (invoke op length io-size alias) -1)) (check (fingerprint 1))
      (check (filled 73728 139266 165)) (check (filled 147456 212992 (if shape? 165 0)))
      (check (zeros 65536 262144)) (p 92 (+ (word 92) 1))))
(defn shape-guards [op]
  (if (> op 2) 1
    (do (guard op 262143 262144 0 0 65538 true)
        (guard op 262144 262143 0 0 65538 true)
        (guard op 262144 262144 1 0 65538 true)
        (guard op 262144 262144 0 65539 65538 true)
        (guard op 262144 262144 0 0 65539 true) (shape-guards (+ op 1)))))
(defn alias-probes [op]
