        (kernel-store-u32 (kernel-subregion (kernel-value-domain-request-page 73) 262144 4 4) 4 0 0)
        (kernel-store-u64 (kernel-subregion (kernel-value-domain-request-page 73) 262144 147456 8) 8 0 81)
        (fingerprint 0) (check (= (invoke op 262144 262144 1) -1)) (check (fingerprint 1))
        (check (= (kernel-load-u64 (kernel-subregion (kernel-value-domain-request-page 73) 262144 147456 8) 8 0) 81))
        (p 92 (+ (word 92) 1)) (alias-probes (+ op 1)))))
(defn header-probe [kind capacity expected]
  (do (sentinel 73728 204801)
      (check (= (w/outer-header kind (kernel-subregion (kernel-value-domain-request-page 74) 262144 73728 capacity) capacity) expected))
