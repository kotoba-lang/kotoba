;; JUN-757: real managed frame -> codec -> full-capacity reassembly through NIC.
;; Public fixture; fixed clock/scheduled transitions. No app/service/consent grant.
;; Test receipt checkpoints acknowledge observation only. Domain75 is solely
;; the existing-size diagnostic event log, never application message storage.
;; Public signed maps, keys and fixed clock; raw echo/pong only, no app/SSH.
;; Policy transitions come from immutable test schedule, never network bytes.
(ns kekkai.application-receive-link-gate
  (:require [aiueos.native.rtl8139-cplus :as nic] [aiueos.native.ipv4-udp :as udp]
            [kekkai.application-frame-region :as a] [kekkai.application-receive-region :as bridge] [kekkai.application-reassembly-region :as assembly] [kekkai.frame-region :as f] [kekkai.session-region :as s] [kekkai.roster-region :as r]
