;; Real pool, actual full-size calls. QMP/GDB only acknowledges observation
;; checkpoints in the dedicated test receipt; no protocol/consent is injected.
(ns kekkai.application-reassembly-gate
  (:require [kekkai.application-reassembly-region :as a]
            [kotoba.json.document-region :as j])
  (:export [run-tests]))
(defn- put [at v] :i64 (kernel-store-u64-4k (kernel-owned-page 0) 4096 at v))
(defn- receipt-word [at] :i64 (kernel-load-u64-4k (kernel-owned-page 0) 4096 at))
(defn- check [v :bool] :i64
  (do (put 16 (+ (receipt-word 16) 1)) (if v 1 (do (put 8 (+ (receipt-word 8) 1)) 0))))
(defn- p [at v] :i64 (kernel-store-u8-4k (kernel-owned-page 1) 4096 at v))
(defn- w [at v] :i64 (kernel-store-u32-4k (kernel-owned-page 1) 4096 at v))
(defn- w64 [at v] :i64 (kernel-store-u64-4k (kernel-owned-page 1) 4096 at v))
(defn- zero-input [] :i64
  (loop [i 0] (if (>= i 4096) 1 (let [z (w64 i 0)] (recur (+ i 8))))))
(defn- binding [peer key epoch] :i64
  (do (w 2048 0x3142504b) (w 2052 1) (w64 2056 epoch) (w 2064 peer) (w 2068 0)
      (w64 2072 key) (w64 2080 0) (w64 2088 0) (w64 2096 0) (w64 2104 0) 1))
(defn- hex [v] :i64 (if (< v 10) (+ 48 v) (+ 87 v)))
(defn- value-byte [at size] :i64
  (if (or (= at 0) (= at (- size 1))) 34 (+ 97 (mod at 26))))
(defn- record [id index parts size start total] :i64
  (do (w 0 0x3146504b) (w 4 2) (w 8 2) (w 12 index) (w 16 parts) (w 20 size)
      (p 64 (hex (quot id 16))) (p 65 (hex (mod id 16)))
      (loop [i 0] (if (>= i 700) 1
        (let [z (p (+ 704 i) (if (< i size) (value-byte (+ start i) total) 0))] (recur (+ i 1)))))))
(defn- call [owner bytes bind-bytes frame-bytes now] :i64
  (a/accept owner bytes (kernel-subregion (kernel-owned-page 1) 4096 2048 bind-bytes) bind-bytes
    (kernel-subregion (kernel-owned-page 1) 4096 0 frame-bytes) frame-bytes now))
(defn- accept [now] :i64 (call (kernel-application-pool) 8388608 64 2048 now))
(defn- checkpoint [kind] :i64
  (let [phase (+ (receipt-word 40) 1)]
    (do (put 64 kind) (put 40 phase)
        (loop [spin 0] (if (= (receipt-word 48) phase) 1 (let [p (kernel-pause)] (recur (+ spin 1))))))))
(defn- refusal [op now] :i64
  (do (checkpoint 1)
      (let [v (case op 1 (call (kernel-subregion (kernel-application-pool) 8388608 0 8388607) 8388607 64 2048 now)
                2 (call (kernel-application-pool) 8388608 63 2048 now)
                3 (call (kernel-application-pool) 8388608 64 2047 now)
                4 (a/advance-epoch (kernel-application-pool) 8388608 42)
                5 (a/expire (kernel-application-pool) 8388608 now 0)
                6 (a/expire (kernel-application-pool) 8388608 now 10)
                7 (a/accept (kernel-application-pool) 8388608
                    (kernel-subregion (kernel-application-pool) 8388608 0 64) 64
                    (kernel-subregion (kernel-owned-page 1) 4096 0 2048) 2048 now)
                8 (a/accept (kernel-application-pool) 8388608
                    (kernel-subregion (kernel-owned-page 1) 4096 2048 64) 64
                    (kernel-subregion (kernel-application-pool) 8388608 0 2048) 2048 now)
                9 (a/accept (kernel-application-pool) 8388608
                    (kernel-subregion (kernel-owned-page 1) 4096 0 64) 64
                    (kernel-subregion (kernel-owned-page 1) 4096 0 2048) 2048 now)
                (accept now))]
        (do (put 56 v) (check (= v -1)) (checkpoint 2)))))
(defn- fresh [] :i64 (check (= (a/initialize (kernel-application-pool) 8388608 42) 1)))
(defn- pending [count bytes] :i64
  (do (check (= (a/pending-count (kernel-application-pool) 8388608) count))
      (check (= (a/buffered-bytes (kernel-application-pool) 8388608) bytes))))
(defn- release [] :i64 (check (= (a/release (kernel-application-pool) 8388608) 1)))
(defn- small-tests [] :i64
  (do (fresh) (zero-input) (binding 1 11 42)
      (record 1 2 3 2 4 6) (check (= (accept 100) 0))
      (record 1 0 3 2 0 6) (check (= (accept 100) 0)) (pending 1 4)
      (record 1 0 3 1 0 6) (check (= (accept 100) 0)) (pending 1 3)
      (record 1 0 3 2 0 6) (check (= (accept 100) 0)) (pending 1 4)
      (record 1 1 4 2 2 6) (refusal 0 100)
      (record 1 1 3 2 2 6) (binding 2 11 42) (check (= (accept 100) 0))
      (binding 1 12 42) (check (= (accept 100) 0)) (pending 3 8)
      (binding 1 11 41) (refusal 0 100)
      (binding 0 11 42) (refusal 0 100) (binding 65 11 42) (refusal 0 100)
      (binding 1 0 42) (refusal 0 100) (binding 1 11 42)
      (w 2048 0) (refusal 0 100) (w 2048 0x3142504b)
      (w 2052 2) (refusal 0 100) (w 2052 1)
      (w 2068 1) (refusal 0 100) (w 2068 0)
      (w64 2104 1) (refusal 0 100) (w64 2104 0)
      (w 20 701) (refusal 0 100) (w 20 2)
      (refusal 0 9007199254740992)
      (binding 1 11 42) (refusal 0 99) (refusal 1 100) (refusal 2 100) (refusal 3 100)
      (refusal 7 100) (refusal 8 100) (refusal 9 100)
      (check (= (accept 100) 1)) (pending 2 4)
      (check (= (a/completed-size (kernel-application-pool) 8388608) 6)) (checkpoint 6)
      (refusal 0 100) (release)
      (binding 2 11 42)
      (check (= (a/revoke (kernel-application-pool) 8388608 (kernel-subregion (kernel-owned-page 1) 4096 2048 64) 64) 1))
      (pending 1 2) (binding 1 11 42)
      (check (= (a/revoke (kernel-application-pool) 8388608 (kernel-subregion (kernel-owned-page 1) 4096 2048 64) 64) 0))
      (binding 1 12 42)
      (check (= (a/revoke (kernel-application-pool) 8388608 (kernel-subregion (kernel-owned-page 1) 4096 2048 64) 64) 1)) (pending 0 0)
      (binding 1 11 42) (record 2 0 2 1 0 2) (check (= (accept 101) 0))
      (record 2 1 2 1 1 2) (p 704 120) (refusal 0 101) (pending 1 1)
      (p 704 34) (check (= (accept 101) 1)) (checkpoint 6)
      (check (= (a/revoke (kernel-application-pool) 8388608 (kernel-subregion (kernel-owned-page 1) 4096 2048 64) 64) 1))
      (pending 0 0) (check (= (a/completed-size (kernel-application-pool) 8388608) 0))
      (record 3 0 2 1 0 2) (check (= (accept 110) 0))
      (refusal 4 110) (refusal 5 110) (refusal 6 109)
      (check (= (a/expire (kernel-application-pool) 8388608 119 10) 0)) (pending 1 1)
      (check (= (a/expire (kernel-application-pool) 8388608 120 10) 1)) (pending 0 0)
      (record 4 0 1 2 0 2) (check (= (accept 121) 1))
      (check (= (a/expire (kernel-application-pool) 8388608 131 10) 1))
      (record 5 0 2 1 0 2) (check (= (accept 132) 0))
      (check (= (a/advance-epoch (kernel-application-pool) 8388608 43) 1))
      (checkpoint 5) (record 5 1 2 1 1 2) (refusal 0 133)))
(defn- zero-parts [] :i64
  (do (fresh) (binding 1 11 42)
      (loop [i 2046] (if (< i 0) 1
        (let [z (record 10 i 2048 0 0 2) c (check (= (accept 200) 0))] (recur (- i 1)))))
      (pending 1 0) (record 10 0 2048 0 0 2) (check (= (accept 200) 0))
      (record 10 2047 2048 2 0 2) (check (= (accept 200) 1)) (pending 0 0) (checkpoint 6) (release)))
(defn- long-id [mode] :i64
  (let [bytes (case mode 1 480 2 320 160)]
    (do (w 4 bytes) (w 8 160)
        (loop [i 0] (if (>= i bytes) 1
          (let [v (case mode 1 (case (mod i 3) 0 230 1 188 162)
                    2 (case (mod i 4) 0 240 1 159 2 152 128) 3 0 97)
                z (p (+ 64 i) v)] (recur (+ i 1)))))
        bytes)))
(defn- long-ids [] :i64
  (do (fresh) (binding 1 11 42)
      (loop [mode 0] (if (> mode 3) 1
        (let [z (record 1 0 2 1 0 2) bytes (long-id mode) c (check (= (accept 150) 0))
              a (w 12 1) b (p 704 34)
              old (case mode 1 162 2 128 3 0 97)
              changed (p (+ 63 bytes) (+ old 1))
              d (check (= (accept 150) 0)) e (pending 2 2)
              restored (p (+ 63 bytes) old) f (check (= (accept 150) 1))
              observed (checkpoint 6) released (release)
              erased (check (= (a/revoke (kernel-application-pool) 8388608
                (kernel-subregion (kernel-owned-page 1) 4096 2048 64) 64) 1)) n (pending 0 0)]
          (recur (+ mode 1)))))))
(defn- slots [] :i64
  (do (fresh) (binding 1 11 42)
      (loop [i 0] (if (>= i 128) 1
        (let [z (record i 0 2 0 0 2) c (check (= (accept 300) 0))] (recur (+ i 1)))))
      (pending 128 0) (record 128 0 2 0 0 2) (refusal 0 300)
      (record 64 1 2 2 0 2) (check (= (accept 300) 1)) (pending 127 0) (release)
      (record 128 0 2 0 0 2) (check (= (accept 300) 0)) (pending 128 0)
      (check (= (a/revoke (kernel-application-pool) 8388608 (kernel-subregion (kernel-owned-page 1) 4096 2048 64) 64) 128))
      (pending 0 0)))
(defn- all-entries [] :i64
  (do (fresh) (binding 1 11 42)
      (loop [s 0] (if (>= s 128) 1
        (let [z (record s 0 2048 0 0 2)
              c (loop [i 0] (if (>= i 2047) 1
                  (let [a (w 12 i) b (check (= (accept 500) 0))] (recur (+ i 1)))))]
          (recur (+ s 1)))))
      (pending 128 0) (checkpoint 7)
      (record 64 2047 2048 2 0 2) (check (= (accept 500) 1)) (pending 127 0)
      (release) (fresh)))
(defn- large-parts [id parts reverse :bool] :i64
  (loop [i 0]
    (if (>= i 1498) 1
      (let [index (if reverse (- 1497 i) i) start (* index 700)
            n (if (< (- 1048576 start) 700) (- 1048576 start) 700)
            z (record id index parts n start 1048576)
            c (check (= (accept 400) (if (and (= parts 1498) (= i 1497)) 1 0)))] (recur (+ i 1))))))
(defn- quotas [] :i64
  (do (fresh) (binding 1 11 42)
      (large-parts 20 2048 false) (pending 1 1048576)
      (record 20 1498 2048 1 0 2) (refusal 0 400)
      (large-parts 21 2048 false) (large-parts 22 2048 false) (large-parts 23 2048 false)
      (pending 4 4194304) (checkpoint 4)
      (record 24 0 2048 1 0 2) (refusal 0 400)
      (record 24 0 2048 0 0 2) (check (= (accept 400) 0)) (pending 5 4194304)
      (record 20 0 2048 699 0 1048576) (check (= (accept 400) 0)) (pending 5 4194303)
      (record 24 0 2048 1 0 2) (check (= (accept 400) 0)) (pending 5 4194304)
      (record 20 0 2048 700 0 1048576) (refusal 0 400)
      (record 25 0 1 2 0 2) (refusal 0 400)
      (check (= (a/revoke (kernel-application-pool) 8388608 (kernel-subregion (kernel-owned-page 1) 4096 2048 64) 64) 5)) (pending 0 0)))
(defn- dp [pool at v] :i64 (kernel-store-u8 (kernel-subregion pool 8388608 at 1) 1 0 v))
(defn- data [at] :i64 (kernel-load-u8 (kernel-subregion (kernel-native-font) 524288 (+ 475136 at) 1) 1 0))
(defn- d32 [at] :i64 (kernel-load-u32 (kernel-subregion (kernel-native-font) 524288 (+ 475136 at) 4) 4 0))
(defn- json-valid [pool capacity count] :bool (j/valid-document pool capacity count))
(defn- json-cases [pool bytes] :i64
    (loop [row 0]
      (if (>= row (d32 8)) 1
        (let [at (+ 16 (* row 32)) used (d32 (+ at 8)) mode (d32 (+ at 16))
              z (loop [i 0] (if (>= i used) 1
                  (let [v (if (= mode 1) (value-byte i used) (if (= mode 2) 32 0)) x (dp pool i v)] (recur (+ i 1)))))
              c (loop [i 0] (if (>= i (d32 (+ at 4))) 1
                  (let [x (dp pool (+ (d32 (+ at 20)) i) (data (+ (d32 at) i)))] (recur (+ i 1)))))
              n (check (= (if (json-valid (kernel-subregion pool 8388608 0 1048577) 1048577 used) 1 0) (d32 (+ at 12))))]
          (recur (+ row 1))))))
(defn- copy-case [offset capacity expected] :i64
  (do (loop [i 0] (if (>= i 4096) 1
        (let [z (kernel-store-u8-4k (kernel-owned-page 2) 4096 i 165)] (recur (+ i 1)))))
      (check (= (a/completed-copy (kernel-application-pool) 8388608 offset
        (kernel-subregion (kernel-owned-page 2) 4096 0 capacity) capacity) expected))
      (loop [i 0] (if (>= i 4096) 1
        (let [v (kernel-load-u8-4k (kernel-owned-page 2) 4096 i)
              z (check (= v (if (< i expected) (value-byte (+ offset i) 1048576) 165)))] (recur (+ i 1)))))))
(defn run-tests [] :i64
  (do (put 0 0x31545341524b) (put 8 0) (put 16 0) (put 24 1)
      (put 32 (kernel-application-pool)) (put 40 0) (put 48 0)
      (put 56 0) (put 64 0) (put 96 0x1234abcd) (json-cases (kernel-application-pool) 8388608)
      (small-tests) (long-ids) (zero-parts) (slots) (quotas) (all-entries)
      (fresh) (binding 1 11 42) (large-parts 30 1498 true)
      (pending 0 0) (check (= (a/completed-size (kernel-application-pool) 8388608) 1048576))
      (copy-case 0 4096 4096) (copy-case 65530 17 17) (copy-case 1048570 17 6)
      (copy-case 1048576 17 0) (copy-case 1048577 17 -1) (copy-case -1 17 -1) (copy-case 0 0 0)
      (checkpoint 3) (put 24 2) 1))
