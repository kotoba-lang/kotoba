;; Public immutable schema corpus. Observer only acknowledges this receipt.
(ns kekkai.application-message-gate
  (:require [kekkai.application-message-region :as a]
            [kotoba.json.document-region :as j])
  (:export [run-tests]))
(defn- put [at v] :i64 (kernel-store-u64-4k (kernel-owned-page 0) 4096 at v))
(defn- get [at] :i64 (kernel-load-u64-4k (kernel-owned-page 0) 4096 at))
(defn- check [yes :bool] :i64
  (do (put 16 (+ (get 16) 1)) (if yes 1 (do (put 8 (+ (get 8) 1)) 0))))
(defn- d [at] :i64 (kernel-load-u8 (kernel-subregion (kernel-native-font) 524288 (+ 475136 at) 1) 1 0))
(defn- d32 [at] :i64 (kernel-load-u32 (kernel-subregion (kernel-native-font) 524288 (+ 475136 at) 4) 4 0))
(defn- d64 [at] :i64 (kernel-load-u64 (kernel-subregion (kernel-native-font) 524288 (+ 475136 at) 8) 8 0))
(defn- p [at v] :i64 (kernel-store-u8 (kernel-subregion (kernel-application-pool) 8388608 at 1) 1 0 v))
(defn- fill [at] :i64
  (if (>= at 1048576) 1 (do (kernel-store-u64 (kernel-subregion (kernel-application-pool) 8388608 at 8) 8 0 0x2020202020202020) (fill (+ at 8)))))
(defn- copy [source at count] :i64
  (if (<= count 0) at (do (p at (d source)) (copy (+ source 1) (+ at 1) (- count 1)))))
(defn- repeat-byte [at count value] :i64
  (if (<= count 0) at (do (p at value) (repeat-byte (+ at 1) (- count 1) value))))
(defn- cput [at value] :i64
  (kernel-store-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1) 1 0 value))
(defn- cbyte [at] :i64
  (kernel-load-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1) 1 0))
(defn- cfill [at end] :i64
  (if (>= at end) 1 (do (cput at 165) (cfill (+ at 1) end))))
(defn- same [at end value] :bool
  (if (>= at end) true (and (= (cbyte at) value) (same (+ at 1) end value))))
(defn- invoke [work-bytes input-bytes used capacity alias] :i64
  (if (= alias 1)
    (a/decode (kernel-subregion (kernel-application-pool) 8388608 0 work-bytes) work-bytes
      (kernel-subregion (kernel-application-pool) 8388608 0 input-bytes) input-bytes used
      (kernel-subregion (kernel-value-domain-request-page 73) 262144 139264 capacity) capacity)
    (if (= alias 2)
      (a/decode (kernel-subregion (kernel-value-domain-request-page 73) 262144 122880 work-bytes) work-bytes
        (kernel-subregion (kernel-application-pool) 8388608 0 input-bytes) input-bytes used
        (kernel-subregion (kernel-application-pool) 8388608 0 capacity) capacity)
      (a/decode (kernel-subregion (kernel-value-domain-request-page 73) 262144 122880 work-bytes) work-bytes
        (kernel-subregion (kernel-application-pool) 8388608 0 input-bytes) input-bytes used
        (kernel-subregion (kernel-value-domain-request-page 73) 262144 (if (= alias 3) 122880 139264) capacity) capacity))))
(defn- checkpoint [phase] :i64
  (do (put 40 phase) (loop [i 0] (if (= (get 48) phase) 1 (let [p (kernel-pause)] (recur (+ i 1)))))))
(defn- test [index] :i64
  (let [row (+ 32 (* index 80))]
    (do (fill 0) (p 1048576 90)
      (let [at (copy (d32 row) 0 (d32 (+ row 4)))]
        (let [end (repeat-byte at (d32 (+ row 16)) (d32 (+ row 20)))] (copy (d32 (+ row 8)) end (d32 (+ row 12)))))
      (cfill 122880 131073) (cfill 139264 204801)
      (let [result (invoke (d32 (+ row 56)) (d64 (+ row 40)) (d64 (+ row 24)) (d64 (+ row 48)) (d32 (+ row 60)))]
        (do (put 56 result) (put 64 index) (check (= result (d64 (+ row 32))))
          (check (= (cbyte 131072) 165)) (check (= (cbyte 204800) 165))
          (put 72 (kernel-value-domain-request-page 73)) (checkpoint (+ index 1)))))))
(defn- cases [index count] :i64
  (if (>= index count) 1 (do (test index) (cases (+ index 1) count))))
(defn- cursor-tests [] :i64
  (do (fill 0) (p 65535 92) (p 65536 117) (p 65537 100) (p 65538 56) (p 65539 51) (p 65540 100)
      (p 65541 92) (p 65542 117) (p 65543 100) (p 65544 101) (p 65545 48) (p 65546 48)
      (check (= (j/next-character (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 1048576 1048576 65535 65547) (+ (* 65547 2097152) 128512)))
      (check (= (j/utf16-length (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 1048576 1048576 65535 65547) 2))
      (check (= (j/next-character (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 1048576 1048576 65535 65546) -1))
      (check (= (j/next-character (kernel-subregion (kernel-application-pool) 8388608 0 1048575) 1048575 1048575 0 1) -1))
      (check (= (j/skip-space (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 1048576 1048576 -1) -1))
      (check (= (j/value-end (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 1048576 1048576 0 -1) -1))
      (p 1048575 49)
      (check (= (j/natural-value (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 1048576 1048576 1048575 1048576 1) 1))
      (check (= (j/natural-value (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 1048576 1048576 1048575 1048576 0) -1))
      (check (= (j/next-character (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 1048576 1048576 1048576 1048576) -1))
      (check (= (j/string-end (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 1048576 0 0) -1))
      (check (= (j/utf16-length (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 1048576 1048576 2 1) -1))
      (check (= (j/value-end (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 1048576 1048577 0 0) -1))))
(defn run-tests [] :i64
  (do (put 0 0x3154534d4b) (put 8 0) (put 16 0) (put 24 1) (put 32 (kernel-application-pool)) (put 40 0) (put 48 0)
      (cursor-tests) (cases 0 (d32 8)) (put 24 2) 1))
