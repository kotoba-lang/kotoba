;; JUN-757: isolated RTL8139C+ diagnostic for the real managed frame adapter.
;; Public signed maps, keys and fixed clock; raw echo/pong only, no app/SSH.
;; Policy transitions come from immutable test schedule, never network bytes.
(ns kekkai.application-link-gate
  (:require [aiueos.native.rtl8139-cplus :as nic] [aiueos.native.ipv4-udp :as udp]
            [kekkai.application-frame-region :as a] [kekkai.frame-region :as f] [kekkai.session-region :as s] [kekkai.roster-region :as r]
            [noise.blake2s-region :as h] [kekkai.wire-region :as w]
            [kekkai.session-region-gate :refer [canonical-ik]] [aiueos.native.legacy-crypto-kat :as kat])
