    (let [ip-sum (- 65535 (total 14 34 count 0))
          udp-sum (- 65535 (total 34 (+ 42 count) count (+ 17 (+ count 8) (total 26 34 count 0))))]
      (do (emit 0 (if (< count 18) 60 (+ 42 count)) count ip-sum (if (= udp-sum 0) 65535 udp-sum))
          (check (= (nic/send (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 (if (< count 18) 60 (+ 42 count))) 1))
          (p 78 (+ (word 78) 1)) 1))))
(defn rb [at] (kernel-load-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1) 1 0))
(defn filled [at end value] :bool
