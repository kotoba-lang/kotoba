      (if (= mode 0)
        (do (cp (+ 3584 at) value) (fingerprint-bytes mode (+ at 1)))
        (and (= value (kernel-load-u8 (kernel-subregion (kernel-browser-context) 8192 (+ 3584 at) 1) 1 0))
             (fingerprint-bytes mode (+ at 1)))))))
(defn fingerprint [mode] :bool
  (do (h/init (kernel-subregion (kernel-value-domain-request-page 74) 262144 214016 512) 512)
      (fingerprint-feed 0) (h/finish (kernel-subregion (kernel-value-domain-request-page 74) 262144 214016 512) 512)
      (fingerprint-bytes mode 0)))
(defn call-frame [op owner length io io-size]
  (if (= op 0) (f/receive owner length io io-size 1750000000)
    (if (= op 1) (f/send-handshake owner length io io-size 1750000000)
      (f/send owner length io io-size 1750000000 (if (= op 3) 0 (if (= op 4) 6 (if (= op 5) 5 1)))))))
(defn invoke [op length io-size alias]
  (if (= alias 1)
    (call-frame op (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 length) length
      (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 io-size) io-size)
    (call-frame op (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 length) length
      (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 io-size) io-size)))
(defn guard [op length io-size alias used capacity shape? :bool]
  (do (qw 0 used) (qw 4 capacity) (sentinel 73728 139266) (sentinel 147456 212992) (fingerprint 0)
      (check (= (invoke op length io-size alias) -1)) (check (fingerprint 1))
      (check (filled 73728 139266 165)) (check (filled 147456 212992 (if shape? 165 0)))
      (check (zeros 65536 262144)) (p 92 (+ (word 92) 1))))
(defn shape-guards [op]
  (if (> op 2) 1
    (do (guard op 262143 262144 0 0 65538 true)
        (guard op 262144 262143 0 0 65538 true)
        (guard op 262144 262144 1 0 65538 true)
        (guard op 262144 262144 0 65539 65538 true)
        (guard op 262144 262144 0 0 65539 true) (shape-guards (+ op 1)))))
(defn alias-probes [op]
  (if (> op 2) 1
    (do (kernel-store-u32 (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 4) 4 0 0)
        (kernel-store-u32 (kernel-subregion (kernel-value-domain-request-page 73) 262144 4 4) 4 0 0)
        (kernel-store-u64 (kernel-subregion (kernel-value-domain-request-page 73) 262144 147456 8) 8 0 81)
        (fingerprint 0) (check (= (invoke op 262144 262144 1) -1)) (check (fingerprint 1))
        (check (= (kernel-load-u64 (kernel-subregion (kernel-value-domain-request-page 73) 262144 147456 8) 8 0) 81))
        (p 92 (+ (word 92) 1)) (alias-probes (+ op 1)))))
(defn header-probe [kind capacity expected]
  (do (sentinel 73728 204801)
      (check (= (w/outer-header kind (kernel-subregion (kernel-value-domain-request-page 74) 262144 73728 capacity) capacity) expected))
      (check (filled (+ 73728 (if (= expected 3) 3 0)) 204801 165))
      (if (= expected 3) (do (check (= (qb 73728) 107)) (check (= (qb 73729) 1)) (check (= (qb 73730) kind))) 0)
      (p 93 (+ (word 93) 1))))
(defn header-probes []
  (do (header-probe 48 3 3) (header-probe 49 3 3) (header-probe 50 3 3) (header-probe 50 131072 3)
      (header-probe 51 3 -1) (header-probe 48 2 -1) (header-probe 48 0 -1) (header-probe 48 131073 -1)))
(defn seed-input [source count i]
  (if (>= i count) 1 (do (qp (+ 4099 i) (data (+ source i))) (seed-input source count (+ i 1)))))
(defn restore-reply [i]
