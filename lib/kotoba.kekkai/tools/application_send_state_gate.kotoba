;; Public fixed-clock native fixture. No fabricated session/binding/consent.
(ns kekkai.application-send-state-gate
  (:require [kekkai.application-send-region :as sender] [kekkai.frame-region :as frame] [kekkai.application-frame-region :as codec] [kekkai.application-pending-region :as a] [kekkai.session-region :as s]
            [kekkai.roster-region :as r] [kekkai.session-region-gate :refer [canonical-ik]]
            [aiueos.native.legacy-crypto-kat :as kat])
  (:export [run]))
(defn- put [at v] :i64 (kernel-store-u64-4k (kernel-owned-page 0) 4096 at v))
(defn- get [at] :i64 (kernel-load-u64-4k (kernel-owned-page 0) 4096 at))
(defn- check [yes :bool] :i64
  (do (put 16 (+ (get 16) 1)) (if yes 1 (do (put 8 (+ (get 8) 1)) 0))))
(defn- data [i] :i64 (kernel-load-u8 (kernel-subregion (kernel-native-font) 524288 (+ 393216 i) 1) 1 0))
(defn- d32 [i] :i64 (kernel-load-u32 (kernel-subregion (kernel-native-font) 524288 (+ 393216 i) 4) 4 0))
(defn- td [i] :i64 (d32 (+ 126000 i)))
(defn- cp [at v] :i64 (kernel-store-u8 (kernel-subregion (kernel-browser-context) 8192 at 1) 1 0 v))
(defn- cw [at v] :i64 (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 at 4) 4 0 v))
(defn- qp [at v] :i64 (kernel-store-u8 (kernel-subregion (kernel-value-domain-request-page 74) 262144 at 1) 1 0 v))
(defn- qb [at] :i64 (kernel-load-u8 (kernel-subregion (kernel-value-domain-request-page 74) 262144 at 1) 1 0))
(defn- config [] :i64
  (do (loop [i 4096] (if (>= i 8192) 1 (let [p (cp i 0)] (recur (+ i 1)))))
    (cw 4096 0x4746434b)
    (loop [i 0] (if (>= i 32) 1
      (let [x (cp (+ 4128 i) (data (+ (d32 28) i))) y (cp (+ 4160 i) (data (+ (d32 32) i)))] (recur (+ i 1)))))
    (loop [i 0] (if (>= i 8) 1
      (let [x (cp (+ 4224 i) (case i 0 110 1 45 2 108 3 97 4 112 5 116 6 111 112))
            y (if (< i 7) (cp (+ 5248 i) (case i 0 100 1 101 2 102 3 97 4 117 5 108 116)) 0)] (recur (+ i 1)))))
    (cw 4200 8) (cw 4204 7)))
(defn- load-map [at count now] :i64
  (r/update (kernel-value-domain-request-page 73) 262144
    (kernel-subregion (kernel-native-font) 524288 (+ 393216 at) count) count
    (kernel-subregion (kernel-browser-context) 8192 4096 4096) 4096 (quot now 1000)))
(defn- start [secret now] :i64
  (s/start (kernel-value-domain-request-page 73) 262144
    (kernel-subregion (kernel-native-font) 524288 (+ 393216 (d32 36)) 32) 32
    (kernel-subregion (kernel-native-font) 524288 (+ 393216 secret) 64) 64 (quot now 1000) 0))
(defn- session-message [count writing now] :i64
  (s/handshake-message (kernel-value-domain-request-page 73) 262144
    (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 count) count
    (kernel-subregion (kernel-value-domain-request-page 74) 262144 65536 65536) 65536 (quot now 1000) writing))
(defn- handshake [now] :i64
  (do (loop [i 0] (if (>= i (d32 52)) 1 (let [p (qp i (data (+ (d32 48) i)))] (recur (+ i 1)))))
    (check (= (session-message (d32 52) 0 now) 0))
    (check (= (session-message 0 1 now) (d32 60)))
    (check (= (s/poll (kernel-value-domain-request-page 73) 262144 (quot now 1000)) 2))))
(defn- initialize [now] :i64
  (a/initialize (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144 now 30000))
(defn- sync [now] :i64
  (a/synchronize (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144 now))
(defn- count-is [value] :i64 (check (= (a/pending-count (kernel-value-domain-request-page 76) 262144) value)))
(defn- id [now] :i64
  (a/request-id-copy (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144
    (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 64) 64 now))
(defn- save-id [at] :i64
  (loop [i 0] (if (>= i 64) 1 (let [p (qp (+ at i) (qb i))] (recur (+ i 1))))))
(defn- load-id [at] :i64
  (loop [i 0] (if (>= i 64) 1 (let [p (qp i (qb (+ at i)))] (recur (+ i 1))))))
(defn- pp [at v] :i64 (kernel-store-u8 (kernel-subregion (kernel-application-pool) 8388608 at 1) 1 0 v))
(defn- input-clear [] :i64
  (loop [i 0] (if (>= i 1048576) (pp 1048576 90)
    (let [p (kernel-store-u64 (kernel-subregion (kernel-application-pool) 8388608 i 8) 8 0 0x2020202020202020)] (recur (+ i 8))))))
(defn- copy [source at size] :i64
  (if (<= size 0) at (do (pp at (data source)) (copy (+ source 1) (+ at 1) (- size 1)))))
(defn- wire-id [at i] :i64
  (if (>= i 64) at (do (pp at (qb (+ 243000 i))) (wire-id (+ at 1) (+ i 1)))))
(defn- message [response :bool full :bool] :i64
  (do (input-clear)
    (let [prefix (if response 32 16) suffix (if full 48 (if response 40 24))]
      (let [at (wire-id (copy (td prefix) 0 (td (+ prefix 4))) 0)]
        (if full
          (let [end (copy (td suffix) at (- (td (+ suffix 4)) 2)) size (* (quot (- 1048576 (+ at (td (+ suffix 4)))) 4) 4)]
            (do (loop [i 0] (if (>= i size) 1 (let [p (pp (+ end i) 65)] (recur (+ i 1)))))
              (copy (+ (td suffix) (- (td (+ suffix 4)) 2)) (+ end size) 2) 1048576))
          (copy (td suffix) at (td (+ suffix 4))))))))
(defn- call [response :bool used now] :i64
  (if response
    (a/complete (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144
      (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 1048576 used now)
    (a/begin (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144
      (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 1048576 used now)))
(defn- cancel [handle now] :i64
  (a/cancel (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144 handle now))
(defn- checkpoint [kind] :i64
  (let [phase (+ (get 40) 1)]
    (do (put 64 kind) (put 40 phase) (loop [i 0] (if (= (get 48) phase) 1 (let [p (kernel-pause)] (recur (+ i 1))))))))
(defn- result-copy [now] :i64
  (a/result-copy (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144
    (kernel-subregion (kernel-value-domain-request-page 74) 262144 73728 65536) 65536 now))
(defn- iw [at value] :i64
  (kernel-store-u32 (kernel-subregion (kernel-value-domain-request-page 74) 262144 at 4) 4 0 value))
(defn- command [op now] :i64
  (do (iw 24 op) (kernel-store-u64 (kernel-subregion (kernel-value-domain-request-page 74) 262144 8 8) 8 0 now)))
(defn- step [op now] :i64
  (do (command op now) (sender/step (kernel-owned-window 4 24576) 24576
    (kernel-value-domain-request-page 73) 262144 (kernel-value-domain-request-page 76) 262144
    (kernel-value-domain-request-page 74) 262144)))
(defn- wr [at] :i64 (kernel-load-u32 (kernel-subregion (kernel-owned-window 4 24576) 24576 at 4) 4 0))
(defn- lr [at] :i64 (kernel-load-u64 (kernel-subregion (kernel-owned-window 4 24576) 24576 at 8) 8 0))
(defn- prepared [now] :i64
  (do (iw 4 1472) (check (= (step 1 now) 64))
    (loop [i 0] (if (>= i 64) 1 (let [p (qp (+ 243000 i) (qb (+ 73728 i)))] (recur (+ i 1)))))
    (let [used (message false false)]
      (do (loop [i 0] (if (>= i used) 1
        (let [p (kernel-store-u8 (kernel-subregion (kernel-application-transmit-pool) 1048576 i 1) 1 0
                  (kernel-load-u8 (kernel-subregion (kernel-application-pool) 8388608 i 1) 1 0))] (recur (+ i 1)))))
        (iw 16 used) used))))
(defn- new-request [seq now] :i64
  (do (prepared now) (check (= (step 3 now) seq)) (check (= (wr 8) 2))))
(defn- outcome [value now] :i64
  (do (check (= (step 7 now) 256)) (check (= (wr 8) 4)) (check (= (wr 12) value))
    (check (= (kernel-load-u32 (kernel-subregion (kernel-value-domain-request-page 74) 262144 73736 4) 4 0) value))))
(defn- release [now] :i64 (check (= (step 8 now) 1)))
(defn- control [now] :i64
  (do (iw 0 0) (iw 4 1472)
    (check (= (frame/send (kernel-value-domain-request-page 73) 262144 (kernel-value-domain-request-page 74) 262144 (quot now 1000) 5) 28))))
(defn- refusal [variant now] :i64
  (case variant
    1 (sender/step (kernel-subregion (kernel-owned-window 4 24576) 24576 0 24575) 24575
      (kernel-value-domain-request-page 73) 262144 (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 74) 262144)
    2 (sender/step (kernel-owned-window 4 24576) 24576
      (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 262143) 262143 (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 74) 262144)
    3 (sender/step (kernel-owned-window 4 24576) 24576 (kernel-value-domain-request-page 73) 262144
      (kernel-subregion (kernel-value-domain-request-page 76) 262144 0 262143) 262143 (kernel-value-domain-request-page 74) 262144)
    4 (sender/step (kernel-owned-window 4 24576) 24576 (kernel-value-domain-request-page 73) 262144
      (kernel-value-domain-request-page 76) 262144 (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 262143) 262143)
    5 (sender/step (kernel-value-domain-request-page 73) 262144 (kernel-value-domain-request-page 73) 262144
      (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 74) 262144)
    6 (sender/step (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144
      (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 74) 262144)
    7 (sender/step (kernel-value-domain-request-page 74) 262144 (kernel-value-domain-request-page 73) 262144
      (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 74) 262144)
    8 (sender/step (kernel-owned-window 4 24576) 24576 (kernel-value-domain-request-page 76) 262144
      (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 74) 262144)
    9 (sender/step (kernel-owned-window 4 24576) 24576 (kernel-value-domain-request-page 74) 262144
      (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 74) 262144)
    10 (sender/step (kernel-owned-window 4 24576) 24576 (kernel-value-domain-request-page 73) 262144
      (kernel-value-domain-request-page 74) 262144 (kernel-value-domain-request-page 74) 262144)
    11 (sender/step (kernel-value-domain-request-page 75) 262144 (kernel-value-domain-request-page 73) 262144
      (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 74) 262144)
    12 (sender/step (kernel-application-transmit-pool) 1048576 (kernel-value-domain-request-page 73) 262144
      (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 74) 262144)
    13 (sender/step (kernel-owned-window 4 24576) 24576 (kernel-value-domain-request-page 75) 262144
      (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 74) 262144)
    14 (sender/step (kernel-owned-window 4 24576) 24576 (kernel-value-domain-request-page 73) 262144
      (kernel-value-domain-request-page 75) 262144 (kernel-value-domain-request-page 74) 262144)
    15 (sender/step (kernel-owned-window 4 24576) 24576 (kernel-value-domain-request-page 73) 262144
      (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 75) 262144)
    (sender/step (kernel-owned-window 4 24576) 24576 (kernel-value-domain-request-page 73) 262144
      (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 74) 262144)))
(defn- refusal-tests [variant now] :i64
  (if (> variant 24) 1
    (do (command 4 now) (iw 4 1472) (iw 20 0)
      (case variant
        16 (command 0 now) 17 (command 10 now) 18 (iw 4 65539)
        19 (command 4 (- now 1)) 20 (command 4 -1) 21 (command 4 9007199254740992)
        22 (do (command 5 now) (iw 20 3)) 23 (do (command 6 now) (iw 20 1))
        24 (do (command 3 now) (iw 16 1048577)) 0)
      (checkpoint 100) (check (= (refusal variant now) -1)) (checkpoint 101)
      (refusal-tests (+ variant 1) now))))
(defn- tests [now] :i64
  (do (check (= (a/complete-bound (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144
        (kernel-subregion (kernel-application-pool) 8388608 0 1048576) 0
        (kernel-subregion (kernel-value-domain-request-page 74) 262144 1024 96) now) -1))
    (check (= (a/release-bound (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 73) 262144
        (kernel-subregion (kernel-application-pool) 8388608 0 1048576)
        (kernel-subregion (kernel-value-domain-request-page 74) 262144 1024 96) now) -1))
    (check (= (a/holds-input (kernel-value-domain-request-page 76) 262144 (kernel-application-pool)) 0))
    (prepared now) (checkpoint 1) (refusal-tests 1 now)
    (iw 20 0) (check (= (step 6 now) 0)) (outcome 2 now) (checkpoint 2) (release now)
    (new-request 1 now) (check (> (step 4 now) 0)) (checkpoint 3)
    (check (= (step 9 now) -2))
    (let [wire (wr 28) counter (s/next-send-counter (kernel-value-domain-request-page 73) 262144 (quot now 1000))]
      (do (iw 20 0) (check (= (step 5 now) 0)) (check (= (step 4 now) wire))
        (check (= (s/next-send-counter (kernel-value-domain-request-page 73) 262144 (quot now 1000)) counter))))
    (iw 20 0) (check (= (step 6 now) 0)) (count-is 0) (outcome 2 now) (checkpoint 4) (release now)
    (new-request 2 now) (check (> (step 4 now) 0)) (iw 20 2) (check (= (step 5 now) 0))
    (count-is 1) (outcome 3 now) (checkpoint 5) (release now)
    (check (= (call true (message true false) now) 2)) (count-is 0)
    (check (= (result-copy now) 512)) (check (= (a/release-result (kernel-value-domain-request-page 76) 262144) 1)) (checkpoint 6)
    (new-request 3 now) (check (> (step 4 now) 0))
    (loop [i 0] (if (>= i 2047) 1 (let [p (control now)] (recur (+ i 1)))))
    (check (> (step 4 now) 0)) (checkpoint 7)
    (control now) (check (= (step 4 now) -1)) (outcome 5 now) (count-is 1) (checkpoint 8)
    (check (= (cancel 3 now) 1)) (release now)
    (new-request 4 now) (check (= (cancel 4 now) 1)) (check (= (step 4 now) -1))
    (outcome 6 now) (checkpoint 9) (release now)
    (new-request 5 now) (check (> (step 4 now) 0))
    (check (= (call true (message true false) now) 5)) (check (= (step 4 now) -1)) (outcome 6 now)
    (check (= (a/release-result (kernel-value-domain-request-page 76) 262144) 1)) (checkpoint 10) (release now)
    (prepared now) (check (= (call false (message false false) now) 6))
    (check (= (step 3 now) -1)) (check (= (wr 8) 1)) (iw 20 0) (check (= (step 6 now) 0))
    (check (= (cancel 6 now) 1)) (checkpoint 11) (release now)
    (prepared now) (kernel-store-u8 (kernel-subregion (kernel-application-transmit-pool) 1048576 0 1) 1 0 0)
    (check (= (step 3 now) -1)) (check (= (wr 8) 1)) (count-is 0)
    (kernel-store-u8 (kernel-subregion (kernel-application-transmit-pool) 1048576 0 1) 1 0 123)
    (check (= (step 3 now) 7)) (check (> (step 4 now) 0))
    (check (> (step 4 (+ now 29999)) 0)) (count-is 1) (checkpoint 12)
    (check (= (step 4 (+ now 30000)) -1)) (outcome 6 (+ now 30000)) (count-is 0) (checkpoint 13) (release (+ now 30000))
    (new-request 8 (+ now 30000)) (check (= (s/stop (kernel-value-domain-request-page 73) 262144) 1))
    (check (= (start (d32 176) (+ now 30000)) 1)) (handshake (+ now 30000)) (iw 4 1472)
    (check (= (step 4 (+ now 30000)) -1)) (outcome 4 (+ now 30000)) (count-is 0) (checkpoint 14) (release (+ now 30000))
    (new-request 9 (+ now 30000)) (check (> (step 4 (+ now 30000)) 0))
    (check (= (load-map (d32 88) (d32 92) (+ now 30000)) 1))
    (check (= (step 4 (+ now 30000)) -1)) (outcome 4 (+ now 30000)) (count-is 0) (checkpoint 15)
    (check (= (step 9 (+ now 30000)) 1)) (check (= (a/stop (kernel-value-domain-request-page 76) 262144) 1)) (checkpoint 16)))
(defn- park [] :i64 (do (kernel-pause) (park)))
(defn run [] :i64
  (do (kernel-cli)
    (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 300 4) 4 0 0)
    (if (and (> (kernel-register-value-domain 73) 0) (= (kernel-publish-current-domain 73) 73) (= (kernel-value-enable-user) 1)
             (> (kernel-register-value-domain 75) 0) (> (kernel-register-value-domain 74) 0) (> (kernel-register-value-domain 76) 0))
      (do (kat/run) (canonical-ik) (config)
        (put 0 0x315453504b) (put 8 0) (put 16 0) (put 24 1) (put 32 (kernel-value-domain-request-page 76)) (put 40 0) (put 48 0)
        (put 72 (kernel-value-domain-request-page 73)) (put 80 (kernel-value-domain-request-page 74)) (put 88 (kernel-application-pool)) (put 104 (kernel-owned-window 4 24576)) (put 112 (kernel-application-transmit-pool)) (put 120 (kernel-value-domain-request-page 75))
        (check (= (codec/decode (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 8192) 8192
          (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 0) 0
          (kernel-subregion (kernel-value-domain-request-page 74) 262144 65536 2048) 2048) -1))
        (check (not (codec/valid-record (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 2048) 2048)))
        (check (= (codec/encode (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 8192) 8192
          (kernel-subregion (kernel-value-domain-request-page 74) 262144 0 2048) 2048
          (kernel-subregion (kernel-value-domain-request-page 74) 262144 65536 2048) 2048) -1))
        (check (= (r/initialize (kernel-value-domain-request-page 73) 262144) 1)) (check (= (load-map (d32 20) (d32 24) 1750000000000) 1))
        (check (= (start (d32 40) 1750000000000) 1)) (check (= (initialize 1750000000000) 1))
        (kernel-store-u64 (kernel-subregion (kernel-value-domain-request-page 74) 262144 8 8) 8 0 1750000000000)
        (loop [i 0] (if (>= i 24576) 1
              (let [z (kernel-store-u64 (kernel-subregion (kernel-owned-window 4 24576) 24576 i 8) 8 0 0)] (recur (+ i 8)))))
            (check (= (sender/initialize (kernel-owned-window 4 24576) 24576 (kernel-value-domain-request-page 73) 262144
          (kernel-value-domain-request-page 76) 262144 (kernel-value-domain-request-page 74) 262144) 1))
        (handshake 1750000000000)
        (loop [i 0] (if (>= i 262144) 1
          (let [p (kernel-store-u64 (kernel-subregion (kernel-value-domain-request-page 74) 262144 i 8) 8 0 -6510615555426900571)] (recur (+ i 8)))))
        (tests 1750000000000) (put 24 2) (park))
      (park))))
