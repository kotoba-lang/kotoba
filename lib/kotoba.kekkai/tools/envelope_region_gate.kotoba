;; JUN-757: public raw-envelope fixture; no physical app/authority admission.
(ns kekkai.envelope-region-gate
  (:require [kekkai.envelope-region :as e]
            [aiueos.ed25519 :refer [aiueos-ed25519-pubkey aiueos-ed25519-sign aiueos-ed25519-verify]]
            [aiueos.lib.sha256-stream :refer [sha-init sha-final]])
  (:export [run]))
(defn p [i v] (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0 v))
(defn word [i] (kernel-load-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0))
(defn check [yes :bool] :i64 (if yes 1 (do (p 75 (+ (word 75) 1)) 0)))
(defn data [i] (kernel-load-u8 (kernel-subregion (kernel-native-font) 524288 (+ 393216 i) 1) 1 0))
(defn d32 [i] (+ (data i) (* (data (+ i 1)) 256) (* (data (+ i 2)) 65536) (* (data (+ i 3)) 16777216)))
(defn rbyte [at] (kernel-load-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1) 1 0))
(defn rput [at v] (kernel-store-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1) 1 0 v))
(defn fill [at count v i]
  (if (>= i count) 1 (do (rput (+ at i) v) (fill at count v (+ i 1)))))
(defn filled [at count v i] :bool
  (if (>= i count) true (if (= (rbyte (+ at i)) v) (filled at count v (+ i 1)) false)))
(defn copy-data [at start count i]
  (if (>= i count) 1 (do (rput (+ at i) (data (+ start i))) (copy-data at start count (+ i 1)))))
(defn same-data [at start count i] :bool
  (if (>= i count) true (if (= (rbyte (+ at i)) (data (+ start i))) (same-data at start count (+ i 1)) false)))
(defn public-put [i v] (kernel-store-u8 (kernel-subregion (kernel-browser-context) 8192 (+ 1024 i) 1) 1 0 v))
(defn public-byte [i] (kernel-load-u8 (kernel-subregion (kernel-browser-context) 8192 (+ 1024 i) 1) 1 0))
(defn public-copy [start i]
  (if (>= i 32) 1 (do (public-put i (data (+ start i))) (public-copy start (+ i 1)))))
(defn public-same [start i] :bool
  (if (>= i 32) true (if (= (public-byte i) (data (+ start i))) (public-same start (+ i 1)) false)))
(defn fragments [row part at]
  (if (>= part (d32 row)) at
    (do (copy-data (+ 98304 at) (d32 (+ row 32 (* part 8))) (d32 (+ row 36 (* part 8))) 0)
        (fragments row (+ part 1) (+ at (d32 (+ row 36 (* part 8))))))))
(defn fragments-same [row part at] :bool
  (if (>= part (d32 row)) true
    (if (same-data (+ 98304 at) (d32 (+ row 32 (* part 8))) (d32 (+ row 36 (* part 8))) 0)
      (fragments-same row (+ part 1) (+ at (d32 (+ row 36 (* part 8))))) false)))
(defn expected [row] (if (= (d32 (+ row 8)) 4294967295) -1 (d32 (+ row 8))))
(defn output-same [row i] :bool
  (if (>= i 65536) true
    (if (= (rbyte (+ 196608 i))
           (if (and (>= (expected row) 0) (< i (expected row)))
             (if (= (d32 (+ row 12)) 1) (mod (+ (* i 17) 3) 256) (data (+ (d32 (+ row 16)) i))) 165))
      (output-same row (+ i 1)) false)))
(defn call-case [size capacity]
    (e/verify (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 98304) 98304
      (kernel-subregion (kernel-value-domain-request-page 73) 262144 98304 size) size
      (kernel-subregion (kernel-browser-context) 8192 1024 32) 32
      (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 capacity) capacity))
(defn case-run [index]
  (let [row (+ 64 (* index 96))]
    (do (fill 0 98304 165 0) (fill 98304 98304 90 0) (fill 196608 65536 165 0)
        (check (= (fragments row 0 0) (d32 (+ row 28)))) (public-copy (d32 (+ row 4)) 0)
        (let [result (call-case (d32 (+ row 28)) (d32 (+ row 24)))] (do (p (+ 1024 index) result) (check (= result (expected row)))))
        (check (filled 0 98304 0 0)) (check (fragments-same row 0 0))
        (check (filled (+ 98304 (d32 (+ row 28))) (- 98304 (d32 (+ row 28))) 90 0))
        (check (public-same (d32 (+ row 4)) 0)) (check (output-same row 0)) (p 78 (+ index 1)))))
(defn cases [index]
  (if (>= index (d32 8)) 1 (do (case-run index) (cases (+ index 1)))))
(defn legacy-sha []
  (do (rput 1024 97) (rput 1025 98) (rput 1026 99)
      (check (= (sha-init (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 512)) 1))
      (check (= (sha-final (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 512)
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 1024 3) 3) 1))
      (check (same-data 424 (d32 16) 32 0)) (p 81 1)))
(defn legacy [slot]
  (if (>= slot 3) 1
    (let [at (+ (d32 12) (* slot 192)) size slot]
      (do (copy-data 0 at 32 0)
          (check (= (aiueos-ed25519-pubkey (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 32)
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 1024 128)
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 4096 4096)
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 2048 64)) 1))
          (check (same-data 1024 (+ at 32) 32 0)) (fill 0 1024 0 0) (copy-data 0 at 32 0) (copy-data 256 (+ at 128) size 0)
          (check (= (aiueos-ed25519-sign (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 1024) size
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 2048 64)
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 4096 4096)) 1))
          (check (same-data 2048 (+ at 64) 64 0)) (fill 0 1024 0 0) (copy-data 0 (+ at 32) 32 0) (copy-data 32 (+ at 64) 64 0)
          (copy-data 96 (+ at 128) size 0)
          (check (= (aiueos-ed25519-verify (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 1024) size
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 4096 4096)) 1))
          (rput 32 (bit-xor (rbyte 32) 1))
          (check (= (aiueos-ed25519-verify (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 1024) size
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 4096 4096)) 0))
          (p 80 (+ slot 1)) (legacy (+ slot 1))))))
(defn shape-call [work-bytes count auth-bytes capacity]
  (do (fill 0 262144 165 0)
      (check (= (e/verify (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 work-bytes) work-bytes
          (kernel-subregion (kernel-value-domain-request-page 73) 262144 98304 count) count
          (kernel-subregion (kernel-browser-context) 8192 1024 auth-bytes) auth-bytes
          (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 capacity) capacity) -1))
      (check (filled 0 262144 165 0)) (p 74 (+ (word 74) 1))))
(defn alias-call [input-at authority-at output-at]
  (do (fill 0 262144 165 0)
      (check (= (e/verify (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 98304) 98304
          (kernel-subregion (kernel-value-domain-request-page 73) 262144 input-at 1) 1
          (kernel-subregion (kernel-value-domain-request-page 73) 262144 authority-at 32) 32
          (kernel-subregion (kernel-value-domain-request-page 73) 262144 output-at 32) 32) -1))
      (check (filled 0 262144 165 0)) (p 74 (+ (word 74) 1))))
(defn guards []
  (do (shape-call 98303 0 32 0) (shape-call 98304 98305 32 0)
      (shape-call 98304 0 31 0) (shape-call 98304 0 33 0) (shape-call 98304 0 32 65537)
      (alias-call 0 98304 196608) (alias-call 98304 0 196608) (alias-call 98304 196608 0)
      (alias-call 98304 196608 98304) (alias-call 98304 196608 196608) (p 76 1)))
(defn park [] (do (kernel-pause) (park)))
(defn run [] :i64
  (do (kernel-cli) (p 74 0) (p 75 0) (p 76 0) (p 77 0) (p 78 0) (p 79 0) (p 255 1045794751)
      (if (and (> (kernel-register-value-domain 73) 0) (= (kernel-publish-current-domain 73) 73)
               (= (kernel-value-enable-user) 1) (> (kernel-value-domain-request-page 73) 0))
        (do (p 100 (bit-and (kernel-value-domain-request-page 73) 4294967295)) (p 101 (u64-shift-right (kernel-value-domain-request-page 73) 32))
            (p 79 1) (legacy-sha) (legacy 0) (guards) (cases 0) (p 77 (if (= (word 255) 1045794751) 1 0)) (p 79 2) (park))
        (do (p 75 1) (p 79 2) (park)))))
