(ns kekkai.status-cli
  "Portable read-only Kekkai membership CLI for process-boundary consumers.

  It uses the same MemStore and query/status-of implementation as the control
  plane, while avoiding netmap signing and SSH JVM-only namespaces.

  Batch: kbb -M -m kekkai.status-cli status-batch <ledger.edn> <node-id>...
  Single (compat): kbb -M -m kekkai.status-cli <ledger.edn> <node-id>"
  (:require ["node:fs" :as fs]
            [kotoba.lang.edn :as edn]
            [kekkai.query :as query]
            [kekkai.store :as store]))

(defn status-map
  "Return statuses for node IDs from a serialized Kekkai ledger snapshot."
  [ledger-path node-ids]
  (when-not (seq node-ids)
    (throw (ex-info "status query needs at least one node ID"
                    {:type :kekkai/invalid-cli-arguments})))
  (let [data (edn/read-string (.readFileSync fs ledger-path "utf8"))
        st (store/->MemStore (atom (merge {:ledger [] :assessments {}} data)))]
    (into (sorted-map)
          (map (fn [node-id] [node-id (query/status-of st node-id)]))
          node-ids)))

(defn -main [& args]
  (case (first args)
    "status-batch"
    (println (pr-str (status-map (second args) (drop 2 args))))

    ;; Backward-compatible single-node argv used by Murakumo's older gate.
    (if (= 2 (count args))
      (let [[ledger-path node-id] args
            status (get (status-map ledger-path [node-id]) node-id)]
        (println status)
        (set! (.-exitCode js/process) (if (= "authorized" status) 0 1)))
      (throw (ex-info "usage: kekkai.status-cli status-batch LEDGER NODE... | LEDGER NODE"
                      {:type :kekkai/invalid-cli-arguments :args args})))))
