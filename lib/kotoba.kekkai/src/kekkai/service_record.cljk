(ns kekkai.service-record
  "Signed service records: what a node offers, addressed by identity rather
  than by name. This is the fact shape ADR-0145 (cloud-itonami-app) adds to
  the netmap's node facts so a client can resolve `model id -> peer set`
  without a directory service: the record is content-verifiable data, the
  netmap is where it is published, and DNS is at most an entry face.

  Pure only. No store, no I/O, no crypto: the caller supplies an already
  verified did:key and an already computed artifact digest. A record whose
  digest is absent is NOT a valid offer -- an unverified artifact stays
  unverified (ADR-0145), it does not become permission by omission.

  Record shape (all keys required):

    {:service/did      \"did:key:z...\"      ; who offers it (Kotoba ID)
     :service/multiaddr \"/ip4/…/tcp/…\"    ; where to dial it (libp2p maddr)
     :service/engine   \"kotoba-inference\" ; which engine serves it
     :service/model-id \"mishima\"          ; which model
     :service/digest   \"sha256:…\" | \"b…\" ; artifact digest (CIDv1 or sha256)
     :service/epoch    7}                  ; monotonic revision")

(def required-keys
  [:service/did :service/multiaddr :service/engine :service/model-id
   :service/digest :service/epoch])

(defn- did? [x]
  (and (string? x) (re-matches #"did:key:z[1-9A-HJ-NP-Za-km-z]+" x)))

(defn- multiaddr? [x]
  (and (string? x) (re-matches #"/[0-9A-Za-z./:-]+" x)))

(defn- digest? [x]
  (and (string? x)
       (or (re-matches #"sha256:[0-9a-f]{64}" x)
           ;; CIDv1 base32 (raw or dag): the identity form of ADR-2608148200.
           (re-matches #"b[0-9a-z]{20,}" x))))

(defn- epoch? [x]
  (and (int? x) (pos? x)))

(defn validate
  "Fail-closed check of one record. Returns {:ok true} or
  {:ok false :reason <keyword> :missing [...]}. An unlisted key is allowed
  (extensible fact), but every required key must hold its own shape."
  [rec]
  (let [missing (vec (remove #(contains? rec %) required-keys))]
    (cond
      (seq missing)      {:ok false :reason :missing-keys :missing missing}
      (not (did? (:service/did rec)))
      {:ok false :reason :bad-did}
      (not (multiaddr? (:service/multiaddr rec)))
      {:ok false :reason :bad-multiaddr}
      (not (and (string? (:service/engine rec)) (seq (:service/engine rec))))
      {:ok false :reason :bad-engine}
      (not (and (string? (:service/model-id rec)) (seq (:service/model-id rec))))
      {:ok false :reason :bad-model-id}
      (not (digest? (:service/digest rec)))
      {:ok false :reason :bad-or-missing-digest}
      (not (epoch? (:service/epoch rec)))
      {:ok false :reason :bad-epoch}
      :else {:ok true})))

(defn make
  "Build and validate. Returns {:ok true :record rec} or the validate failure
  map (never an invalid record under :record)."
  [rec]
  (let [v (validate rec)]
    (if (:ok v) {:ok true :record rec} v)))

(defn supersedes?
  "True when `new` is a strictly later revision of the same offer
  (same did + model-id + engine, higher epoch). Different epochs of
  different offers are not revisions of each other."
  [new old]
  (and (= (:service/did new) (:service/did old))
       (= (:service/model-id new) (:service/model-id old))
       (= (:service/engine new) (:service/engine old))
       (int? (:service/epoch new))
       (int? (:service/epoch old))
       (> (:service/epoch new) (:service/epoch old))))

(defn resolve-for-model
  "Client-side failover set: valid records serving `model-id`, newest epoch
  first, ties broken by did so the order is deterministic. Invalid records
  are dropped, not repaired -- a malformed offer is not silently admitted."
  [records model-id]
  (->> records
       (filter (fn [r] (and (:ok (validate r))
                            (= model-id (:service/model-id r)))))
       (sort-by (juxt (comp - :service/epoch) :service/did))
       vec))
