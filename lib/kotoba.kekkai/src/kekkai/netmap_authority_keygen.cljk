(ns kekkai.netmap-authority-keygen
  "Create the owner-only Ed25519 identity that signs Kekkai desired state.

  The authority file is written exclusively with mode 0600. The CLI reports
  only the public IPNS name and SPKI pin needed by the services and nodes."
  (:require [clojure.string :as string]
            [kekkai.netmap-reconciler :as reconciler]
            ["node:crypto" :as crypto]
            ["node:fs" :as fs]))

(defn generate!
  "Generate an Ed25519 authority at PATH without replacing an existing file.

  Returns the public authority name, SPKI pin, and file path; private key
  material is never returned or printed."
  [identity-file]
  (when-not (and (string? identity-file) (not (string/blank? identity-file)))
    (throw (ex-info "authority keygen requires an output path"
                    {:type :kekkai/invalid-authority-keygen-path})))
  (let [pair (.generateKeyPairSync crypto "ed25519")
        private-der (.export (.-privateKey pair)
                             #js {:format "der" :type "pkcs8"})
        public-der (.export (.-publicKey pair)
                            #js {:format "der" :type "spki"})
        saved {:private-b64 (.toString private-der "base64")
               :public-b64 (.toString public-der "base64")}
        created? (atom false)]
    (try
      (.writeFileSync fs identity-file (str (pr-str saved) "\n")
                      #js {:encoding "utf8" :mode 384 :flag "wx"})
      (reset! created? true)
      (.chmodSync fs identity-file 384)
      (let [identity (reconciler/load-identity! identity-file)]
        {:authority (:graph identity)
         :authority-spki-b64 (:authority-spki-b64 identity)
         :identity-file identity-file})
      (catch :default error
        (when @created?
          (try (.unlinkSync fs identity-file) (catch :default _ nil)))
        (throw error)))))

(defn -main [& args]
  (let [[identity-file & more] args]
    (when (or (nil? identity-file) (seq more))
      (throw (ex-info "usage: kekkai.netmap-authority-keygen OUTPUT_IDENTITY_FILE"
                      {:type :kekkai/invalid-cli-arguments})))
    (println (pr-str (generate! identity-file)))))
