(ns openaccess.shape-test (:export [main]) (:require [openaccess.shape :as p]))

(defn- kw [k :keyword] :document (document-keyword k))
(defn- pt [x :i64 y :i64] :document (document-vector (document-i64 x) (document-i64 y)))
(defn- bb4 [x1 :i64 y1 :i64 x2 :i64 y2 :i64] :document
  (document-vector (document-i64 x1) (document-i64 y1) (document-i64 x2) (document-i64 y2)))

(defn- case-constructors [] :i64
  (let [r (p/rect (kw :m1) (bb4 0 0 10 5))
        g (p/polygon (kw :m2) (document-vector (pt 0 0) (pt 4 0) (pt 2 9)))
        w (p/path (kw :m3) (document-i64 4) (document-vector (pt 0 0) (pt 10 0)))]
    (+ (if (document-equal? (option-or (document-get r (kw :kind)) (document-null)) (kw :rect)) 0 1)
       (if (document-equal? (option-or (document-get g (kw :points)) (document-null)) (document-vector (pt 0 0) (pt 4 0) (pt 2 9))) 0 1)
       (if (document-equal? (option-or (document-get w (kw :width)) (document-null)) (document-i64 4)) 0 1)
       (if (document-equal? (option-or (document-get w (kw :layer)) (document-null)) (kw :m3)) 0 1))))

(defn- case-bbox [] :i64
  (let [r (p/rect (kw :m1) (bb4 0 0 10 5))
        g (p/polygon (kw :m2) (document-vector (pt 0 0) (pt 4 0) (pt 2 9)))
        w (p/path (kw :m3) (document-i64 4) (document-vector (pt 0 0) (pt 10 0)))
        neg (p/polygon (kw :m4) (document-vector (pt -3 2) (pt 1 -7) (pt 5 4)))
        wide (p/path (kw :m5) (document-i64 6) (document-vector (pt 2 2) (pt 2 8)))]
    (+ (if (document-equal? (p/shape-bbox r) (bb4 0 0 10 5)) 0 1)
       (if (document-equal? (p/shape-bbox g) (bb4 0 0 4 9)) 0 1)
       (if (document-equal? (p/shape-bbox w) (bb4 -2 -2 12 2)) 0 1)
       (if (document-equal? (p/shape-bbox neg) (bb4 -3 -7 5 4)) 0 1)
       (if (document-equal? (p/shape-bbox wide) (bb4 -1 -1 5 11)) 0 1))))

(defn- case-degenerate [] :i64
  (+ (if (document-equal? (p/shape-bbox (p/polygon (kw :m) (document-vector (pt 3 3)))) (bb4 3 3 3 3)) 0 1)
     (if (document-equal? (p/shape-bbox (p/polygon (kw :m) (document-vector))) (document-null)) 0 1)
     (if (document-equal? (p/shape-bbox (document-map :kind (kw :circle))) (document-null)) 0 1)))

(defn main [] :i64
  (+ (case-constructors) (case-bbox) (case-degenerate)))
