;; Port of openaccess.shape (shape.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from shape.cljk:
;;   - coordinates and width are i64 (no f64 in Kotoba). Points are
;;     :document vectors of [x y] i64 pairs; a non-integer coordinate reads as 0.
;;   - shape-bbox of a :path halves the width with integer quot. Clojure's
;;     (/ width 2) is a ratio for odd widths; here the half-width rounds
;;     toward zero, so the bbox of an odd-width path is one unit tighter on
;;     each side than the exact ratio rounds to (for even widths the result
;;     is exact).
;;   - points-bbox of an empty point list is document-null; Clojure's
;;     (apply min nil) throws.
;;   - shape-bbox of an unknown :kind is document-null; Clojure's case throws.
;;   - the destructuring argument of shape-bbox is a single :document map.

(ns openaccess.shape
  (:export [rect polygon path shape-bbox]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- vec-at [v :document i :i64] :document
  (option-or (document-vector-at v i) (document-null)))

(defn- i64-at [v :document i :i64] :i64
  (option-or (document-i64-value (vec-at v i)) 0))

(defn rect
  "Construct a `:rect` shape on `layer` with axis-aligned bounding box
  `bbox` (`[x1 y1 x2 y2]`)."
  [layer :document bbox :document] :document
  (document-map :kind (document-keyword :rect) :layer layer :bbox bbox))

(defn polygon
  "Construct a `:polygon` shape on `layer` from vertex `points`."
  [layer :document points :document] :document
  (document-map :kind (document-keyword :polygon) :layer layer :points points))

(defn path
  "Construct a `:path` (routed wire) shape on `layer` with centerline
  `points` and stroke `width`."
  [layer :document width :document points :document] :document
  (document-map :kind (document-keyword :path) :layer layer :width width :points points))

(defn- points-bbox
  "Axis-aligned bounding box [x1 y1 x2 y2] of points ([[x y] ...])."
  [points :document] :document
  (let [n (document-count points)]
    (if (= n 0)
      (document-null)
      (let [p0 (vec-at points 0)]
        (points-bbox-from points n 1 (i64-at p0 0) (i64-at p0 1) (i64-at p0 0) (i64-at p0 1))))))

(defn- points-bbox-from [points :document n :i64 i :i64 x1 :i64 y1 :i64 x2 :i64 y2 :i64] :document
  (if (= i n)
    (document-vector (document-i64 x1) (document-i64 y1) (document-i64 x2) (document-i64 y2))
    (let [p (vec-at points i)
          x (i64-at p 0)
          y (i64-at p 1)]
      (points-bbox-from points n (+ i 1)
                        (if (< x x1) x x1)
                        (if (< y y1) y y1)
                        (if (> x x2) x x2)
                        (if (> y y2) y y2)))))

(defn- is-kind? [shape :document k :keyword] :bool
  (document-equal? (field shape :kind) (document-keyword k)))

(defn shape-bbox
  "Compute the axis-aligned bounding box [x1 y1 x2 y2] of `shape`.

  - :rect    -- the shape's own :bbox.
  - :polygon -- the min/max of :points over each axis.
  - :path    -- the min/max of :points over each axis, expanded by half of
    :width on every side (integer half, see the header)."
  [shape :document] :document
  (if (is-kind? shape :rect)
    (field shape :bbox)
    (if (is-kind? shape :polygon)
      (points-bbox (field shape :points))
      (if (is-kind? shape :path)
        (let [bb (points-bbox (field shape :points))
              h (quot (option-or (document-i64-value (field shape :width)) 0) 2)]
          (if (document-equal? bb (document-null))
            (document-null)
            (document-vector (document-i64 (- (i64-at bb 0) h))
                             (document-i64 (- (i64-at bb 1) h))
                             (document-i64 (+ (i64-at bb 2) h))
                             (document-i64 (+ (i64-at bb 3) h)))))
        (document-null)))))
