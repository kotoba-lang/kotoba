{:paths ["src"]
 ;; langgraph-store — a langgraph-clj graph's two small storage primitives
 ;; that every JVM LangGraph app needed identically: a content-addressed
 ;; blob store (generated images/media, offloaded from the datom store) and
 ;; a latest-only checkpointer (bounded per-thread state, not the unbounded
 ;; per-superstep accumulation langgraph's own datomic-checkpointer does).
 ;; Extracted verbatim from mangaka.{blob,checkpoint} / animeka.{blob,
 ;; checkpoint}, which were byte-identical copies of each other, via a
 ;; short-lived kotoba-lang/genapp-clj. See
 ;; 90-docs/adr/2607011816-ghosthacker-shiropico-standalone-repo.md and
 ;; 90-docs/adr/2607011900-genapp-clj-mangaka-animeka-commons.md for the
 ;; history.
 :deps
 {
        ;; kotoba.bytes replaced java.util.Base64 here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced java.nio.file.Files here (2026-09-24). An explicit
        ;; floor: temp-dir temp-file read-all-bytes write-bytes write-string
        ;; delete-if-exists are in kotoba.io from this sha, and tools.deps takes
        ;; the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "72dde04b4c32854d70d17a670b277f8f7957a784"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph {:git/sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}
  io.github.kotoba-lang/langchain {:git/sha "c74e358c486bdbbed415261abe352ae73831bb8e"}}

 :aliases
 {:dev
  {:override-deps
   {io.github.kotoba-lang/langgraph {:local/root "../langgraph"}
    io.github.kotoba-lang/langchain {:local/root "../langchain"}}}

  :test
  {:extra-paths ["test"]}}}
