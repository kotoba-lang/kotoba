{:paths ["src" "resources"]
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {
                      ;; TEST-ONLY. Parity compiles kotoba/atproto/core.{kotoba,cljk}
                      ;; to KIR and runs it against atproto.core. Nothing in
                      ;; :paths depends on either of these, and `:test-pure`
                      ;; below runs the .cljc suite without them.
                      ;;
                      ;; Pins are the west pair (amu + osaho) as of this commit
                      ;; and are advanced together. The guest relies on the
                      ;; frontend inferring a parameter's type from its use, so
                      ;; an older pin compiles it to `expected string, got i64`.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "93c49982be32459b7671d70a308f0b8998b67477"}
                      io.github.kotoba-lang/osaho
                      {:git/url "https://github.com/kotoba-lang/osaho.git"
                       :git/sha "ff7a3ae2672f8ecdda54aa1abba3d480a2963733"}}}
}}
