;; One mutation per invariant. `:find` must occur EXACTLY ONCE in `:file` —
;; `tools/check-mutations.cljk` refuses otherwise, because a mutation that
;; landed in a comment or in a second call site produces a red suite that
;; proves nothing.
;;
;; ## SCOPE — this table does not cover the whole library
;;
;; It covers the COMPUTATION and its refusals: the method election and its
;; date boundaries, the rate-table selection, the 償却保証額 crossing, the
;; 月割, the 備忘価額 ceiling, and the four coverage states. It does NOT
;; cover `depth` / `world-coverage` (the reporting views), the citation
;; metadata, or `useful-life`'s 細目 matching beyond the table-ambiguity
;; guard. A clean run means "every invariant LISTED HERE is measured" and
;; NOT "every invariant of kotoba.shokyaku is measured". Reading it as the
;; second would be the defect the harness exists to catch: a check that did
;; not look reporting the same value as one that looked and found nothing.
;;
;; These were written from `src/kotoba/shokyaku.cljk` alone, before the
;; author re-read `test/kotoba/shokyaku_test.cljk`. That is the point: a
;; mutation chosen with the tests in view measures the tests you remember
;; writing.
[{:id :the-fixture-cutover-is-exclusive
  :invariant "構築物 acquired ON 平成28年4月1日 has already lost the 定率法 election"
  :file "src/kotoba/shokyaku.cljk"
  :find "(< (date-key d) (date-key (:before spec)))"
  :replace "(<= (date-key d) (date-key (:before spec)))"}

 {:id :intangibles-have-no-one-yen-memorandum
  :invariant "第六十一条第一項第二号ロ: 坑道 and 第八号 intangibles go to zero"
  :file "src/kotoba/shokyaku.cljk"
  :find ":intangible 0 :mine-shaft 0}"
  :replace ":intangible 1 :mine-shaft 1}"}

 {:id :the-guarantee-crossing-is-strict
  :invariant "定率法 switches when 調整前償却額 is BELOW the 償却保証額"
  :file "src/kotoba/shokyaku.cljk"
  :find "(< (:yen step1) guarantee)"
  :replace "(<= (:yen step1) guarantee)"}

 {:id :a-full-year-is-not-prorated
  :invariant "第五十九条 scales only a part year; a whole one is untouched"
  :file "src/kotoba/shokyaku.cljk"
  :find "(< used-months fy-months)"
  :replace "(<= used-months fy-months)"}

 {:id :the-ceiling-never-goes-negative
  :invariant "a fully depreciated asset yields 0, not a negative limit"
  :file "src/kotoba/shokyaku.cljk"
  :find "(max 0 (if capped? room before-cap))"
  :replace "(if capped? room before-cap)"}

 {:id :the-method-is-never-defaulted
  :invariant "法 第三十一条第一項 computes on the method SELECTED; nothing picks one"
  :file "src/kotoba/shokyaku.cljk"
  :find "(if (nil? method)"
  :replace "(if (nil? (:never method))"}

 {:id :within-limit-includes-the-limit
  :invariant "claiming exactly the 償却限度額 is within it"
  :file "src/kotoba/shokyaku.cljk"
  :find "(<= claimed-yen (:shokyaku/limit-yen res))"
  :replace "(< claimed-yen (:shokyaku/limit-yen res))"}

 {:id :a-kind-in-two-tables-is-ambiguous
  :invariant "ソフトウエア in 別表第三 and 別表第六 must not silently pick one"
  :file "src/kotoba/shokyaku.cljk"
  :find "(< 1 (count tables))"
  :replace "(< 2 (count tables))"}

 {:id :money-must-be-an-integer
  :invariant "取得価額 is integer yen; a double would not round-trip in cljs"
  :file "src/kotoba/shokyaku.cljk"
  :find "(not (integer? acquisition-cost-yen))"
  :replace "(not (some? acquisition-cost-yen))"}

 {:id :an-uncatalogued-facet-answers-none
  :invariant "absence is never sufficiency"
  :file "src/kotoba/shokyaku.cljk"
  :find "{:shokyaku/coverage :none :shokyaku/unchecked [path]}"
  :replace "{:shokyaku/coverage :checked :shokyaku/unchecked [path]}"}

 ;; RETARGETED 2026-08-18. The original mutation here forced `first-year?`
 ;; true with `(or true ...)` and SURVIVED — and it is an EQUIVALENT MUTANT,
 ;; not a gap. When 事業供用日 precedes the fiscal-year start, the months from
 ;; it to the year end are necessarily >= the months in the year, so the
 ;; second guard `(< used-months fy-months)` already refuses to prorate and
 ;; the forced flag can never change an answer. Recorded rather than deleted:
 ;; a survivor removed without its reason is indistinguishable from one
 ;; nobody ran. The invariant is retargeted below at the part that CAN
 ;; differ — which end of the period the months are counted from.
 {:id :proration-counts-from-the-service-date-not-the-year-start
  :invariant "第五十九条 counts 「その事業の用に供した日から」, not from the year start"
  :file "src/kotoba/shokyaku.cljk"
  :find "used-months (when first-year? (months-inclusive pis fye))"
  :replace "used-months (when first-year? (months-inclusive fys fye))"}

 {:id :the-declining-balance-table-is-picked-by-acquisition-date
  :invariant "二・五 before 平成24年4月1日, 二 on and after"
  :file "src/kotoba/shokyaku.cljk"
  :find "(if (< (date-key d)\n                                           (date-key (:rule/two-hundred-percent-from rule)))"
  :replace "(if (> (date-key d)\n                                           (date-key (:rule/two-hundred-percent-from rule)))"}

 {:id :a-life-outside-the-table-has-no-rate
  :invariant "別表第八 runs 2..100; nothing is extrapolated"
  :file "src/kotoba/shokyaku.cljk"
  :find "row (when tk (get-in embedded/tables [tk useful-life-years]))"
  :replace "row (when tk (or (get-in embedded/tables [tk useful-life-years]) {:straight-line {:num 1000 :scale 1000}}))"}

 {:id :an-asset-not-in-service-is-not-depreciable
  :invariant "第十三条 excludes 事業の用に供していないもの"
  :file "src/kotoba/shokyaku.cljk"
  :find "(< (date-key fye) (date-key pis))"
  :replace "(< (date-key fye) (date-key {:y 9999 :m 12 :d 31}))"}

 {:id :the-inexact-flag-tracks-real-remainders
  :invariant "an exact division must NOT be flagged, or the flag says nothing"
  :file "src/kotoba/shokyaku.cljk"
  :find "inexact (remove :exact? (remove nil? [chosen prorated]))"
  :replace "inexact (remove nil? [chosen prorated])"}]
