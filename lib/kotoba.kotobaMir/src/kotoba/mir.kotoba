;; Canonical whole-MIR source entry. Source connection does not qualify the
;; native reader, types, build, behavior, resources or selfhost closure.
(ns kotoba.mir
  {:kotoba/export [allocate-registers allocator-pool call-argument-registers capability-argument-registers capability-context-offsets
                  counted-self-recur-plan counted-self-recur-plans instruction-keysets kernel-atomic-ops kernel-dequant-dot-maximum
                  kernel-dequant-dot-operations kernel-dot-f32-maximum kernel-window-maxima kernel-window-operations leaf-registers
                  physical-registers preserved-registers privileged-argument-registers return-registers runtime-argument-registers
                  runtime-context-offsets saved-registers select-target slice-item-limit slice-operations supported-versions targets validate! version]}
  (:require [kotoba.gmir.node :as node] [kotoba.mir.catalog :as catalog] [kotoba.mir.registers :as registers]
            [kotoba.mir.validation :as validation] [kotoba.mir.selection :as selection]
            [kotoba.mir.allocator :as allocator] [kotoba.mir.counted :as counted]))
(defn version [] :i64 (catalog/version))
(defn supported-versions [] [:list :i64] (catalog/supported-versions))
(defn targets [] [:list :keyword] (catalog/targets))
(defn instruction-keysets [] [:list [:ref :mir.catalog/shape]] (catalog/instruction-keysets))
(defn physical-registers [] [:list [:ref :mir.catalog/bank]] (catalog/physical-registers))
(defn leaf-registers [] [:list [:ref :mir.catalog/bank]] (catalog/leaf-registers))
(defn preserved-registers [] [:list [:ref :mir.catalog/bank]] (catalog/preserved-registers))
(defn call-argument-registers [] [:list [:ref :mir.catalog/bank]] (catalog/call-argument-registers))
(defn runtime-argument-registers [] [:list [:ref :mir.catalog/bank]] (catalog/runtime-argument-registers))
(defn runtime-context-offsets [] [:list [:ref :mir.catalog/offset]] (catalog/runtime-context-offsets))
(defn capability-argument-registers [] [:list [:ref :mir.catalog/bank]] (catalog/capability-argument-registers))
(defn capability-context-offsets [] [:list [:ref :mir.catalog/offset]] (catalog/capability-context-offsets))
(defn return-registers [] [:list [:ref :mir.catalog/bank]] (catalog/return-registers))
(defn kernel-window-operations [] [:list :keyword] (catalog/kernel-window-operations))
(defn kernel-window-maxima [] [:list :i64] (catalog/kernel-window-maxima))
(defn kernel-atomic-ops [] [:list :keyword] (catalog/kernel-atomic-ops))
(defn kernel-dot-f32-maximum [] :i64 (catalog/kernel-dot-f32-maximum))
(defn kernel-dequant-dot-maximum [] :i64 (catalog/kernel-dequant-dot-maximum))
(defn kernel-dequant-dot-operations [] [:list :keyword] (catalog/kernel-dequant-dot-operations))
(defn slice-item-limit [] :i64 (catalog/slice-item-limit))
(defn slice-operations [] [:list :keyword] (catalog/slice-operations))
(defn allocator-pool [target :keyword options [:ref :gmir.node/value]] [:list :keyword] (catalog/allocator-pool target options))
(defn privileged-argument-registers [target :keyword] [:list :keyword] (catalog/privileged-argument-registers target))
(defn saved-registers [target :keyword instructions [:ref :gmir.node/value]] [:result [:list :keyword] [:ref :mir/refusal]]
  (registers/saved-registers target instructions))
(defn validate! [program [:ref :gmir.node/value]] [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (validation/validate! program))
(defn select-target [target [:ref :gmir.node/value] program [:ref :gmir.node/value]] [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (selection/select-target target program))
(defn allocate-registers [program [:ref :gmir.node/value]] [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (allocator/allocate-registers program))
(defn counted-self-recur-plan [function [:ref :gmir.node/value]] [:option [:ref :gmir.node/value]] (counted/counted-self-recur-plan function))
(defn counted-self-recur-plans [program [:ref :gmir.node/value]] [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (counted/counted-self-recur-plans program))
