;; Internal unbounded compiler collections. Identity and instruction sequence
;; order are preserved; none of these are generic bounded document containers.
(ns kotoba.mir.allocator-data
  {:kotoba/export [at named? op? key-at key-node present? lookup get-number put-number put-data
                  include exclude member? union intersection difference same-set? members put-members
                  slice append-all replace-at source-set instruction-def instruction-sources]}
  (:require [kotoba.gmir.node :as node] [kotoba.gmir.identity :as identity]
            [kotoba.mir.table :as table] [kotoba.mir.operands :as operands]))
(defn at [values [:ref :gmir.node/value] index :i64] [:ref :gmir.node/value]
  (option-match [:option [:ref :gmir.node/value]] (node/child values index) (node/nil-value) item item))
(defn named? [value [:ref :gmir.node/value] key :keyword] :bool (arena-scope (node/keyword-is? value key)))
(defn op? [instruction [:ref :gmir.node/value] op :keyword] :bool (arena-scope (named? (node/key instruction :mir/op) op)))
(defn key-at [values [:ref :mir.table/tree] index :i64] [:ref :mir.table/key]
  (option-match [:option [:ref :mir.table/key]] (table/key-at values index) (table/nil-key) found-value found-value))
(defn key-node [key [:ref :mir.table/key]] [:ref :gmir.node/value]
  (let [ns (record-get [:ref :mir.table/key] key :namespace) name (record-get [:ref :mir.table/key] key :name)]
    (case (record-get [:ref :mir.table/key] key :kind)
      :index (node/i64-value (record-get [:ref :mir.table/key] key :index))
      :keyword (node/keyword-parts ns name) :symbol (node/symbol-parts ns name) (node/nil-value))))
(defn present? [values [:ref :mir.table/tree] key [:ref :mir.table/key]] :bool
  (arena-scope (option-some?-of [:option [:ref :mir.table/value]] (table/get values key))))
(defn lookup [values [:ref :mir.table/tree] key [:ref :mir.table/key]] [:ref :gmir.node/value]
  (table/data (option-match [:option [:ref :mir.table/value]] (table/get values key) (table/scalar (node/nil-value)) found-value found-value)))
(defn get-number [values [:ref :mir.table/tree] key [:ref :mir.table/key] fallback :i64] :i64
  (arena-scope (if (present? values key) (node/number (lookup values key)) fallback)))
(defn put-data [values [:ref :mir.table/tree] key [:ref :mir.table/key] value [:ref :gmir.node/value]] [:ref :mir.table/tree]
  (table/put values key (table/scalar value)))
(defn put-number [values [:ref :mir.table/tree] key [:ref :mir.table/key] value :i64] [:ref :mir.table/tree]
  (put-data values key (node/i64-value value)))
(defn include [values [:ref :mir.table/tree] key [:ref :mir.table/key]] [:ref :mir.table/tree]
  (put-data values key (node/nil-value)))
(defn exclude [values [:ref :mir.table/tree] key [:ref :mir.table/key]] [:ref :mir.table/tree] (table/remove values key))
(defn member? [values [:ref :mir.table/tree] key [:ref :mir.table/key]] :bool (arena-scope (present? values key)))
(defn union [left [:ref :mir.table/tree] right [:ref :mir.table/tree]] [:ref :mir.table/tree]
  (loop [index 0 out left]
    (if (>= index (table/count right)) out (recur (+ index 1) (include out (key-at right index))))))
(defn intersection [left [:ref :mir.table/tree] right [:ref :mir.table/tree]] [:ref :mir.table/tree]
  (loop [index 0 out (table/empty)]
    (if (>= index (table/count left)) out
      (let [key (key-at left index)] (recur (+ index 1) (if (member? right key) (include out key) out))))))
(defn difference [left [:ref :mir.table/tree] right [:ref :mir.table/tree]] [:ref :mir.table/tree]
  (loop [index 0 out left]
    (if (>= index (table/count right)) out (recur (+ index 1) (exclude out (key-at right index))))))
(defn same-set? [left [:ref :mir.table/tree] right [:ref :mir.table/tree]] :bool
  (arena-scope (and (= (table/count left) (table/count right))
       (loop [index 0]
         (if (>= index (table/count left)) true
           (if (member? right (key-at left index)) (recur (+ index 1)) false))))))
(defn members [values [:ref :mir.table/tree] key [:ref :mir.table/key]] [:ref :mir.table/tree]
  (table/members (option-match [:option [:ref :mir.table/value]] (table/get values key) (table/scalar (node/nil-value)) found-value found-value)))
(defn put-members [values [:ref :mir.table/tree] key [:ref :mir.table/key] members [:ref :mir.table/tree]] [:ref :mir.table/tree]
  (table/put values key (table/members-value members)))
(defn slice [values [:ref :gmir.node/value] start :i64 end :i64] [:ref :gmir.node/value]
  (loop [index start out (node/empty-vector)]
    (if (>= index end) out (recur (+ index 1) (node/append out (at values index))))))
(defn append-all [out [:ref :gmir.node/value] values [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (loop [index 0 result out]
    (if (>= index (node/child-count values)) result (recur (+ index 1) (node/append result (at values index))))))
(defn replace-at [values [:ref :gmir.node/value] index :i64 value [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (append-all (node/append (slice values 0 index) value) (slice values (+ index 1) (node/child-count values))))
(defn instruction-sources [instruction [:ref :gmir.node/value]] [:ref :gmir.node/value] (operands/instruction-sources instruction))
(defn source-set [instruction [:ref :gmir.node/value]] [:ref :mir.table/tree]
  (let [sources (instruction-sources instruction)]
    (loop [index 0 out (table/empty)]
      (if (>= index (node/child-count sources)) out
        (let [value (at sources index)] (recur (+ index 1) (if (identity/vreg? value) (include out (operands/key-of value)) out)))))))
(defn instruction-def [instruction [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (let [value (node/key instruction :mir/dst)] (if (identity/vreg? value) value (node/nil-value))))
