;; Complete reference flat/module dispatcher source candidate. Native reader,
;; type, execution, resource and whole-component qualification remain open.
(ns kotoba.mir.validation
  {:kotoba/export [validate!]}
  (:require [kotoba.gmir.node :as node] [kotoba.gmir.identity :as identity]
            [kotoba.gmir.catalog :as gmir-catalog] [kotoba.mir.catalog :as catalog]
            [kotoba.mir.flat :as flat] [kotoba.mir.outcome :as outcome])
  (:schemas
   {:mir.validation/home [:record :mir.validation/home
      [[:location [:ref :gmir.node/value]] [:parameter :i64]]]
    :mir.validation/transport [:record :mir.validation/transport
      [[:registers [:list [:ref :mir.validation/home]]]
       [:slots [:list [:ref :mir.validation/home]]]]]}))

(defn- at [value [:ref :gmir.node/value] index :i64] [:ref :gmir.node/value]
  (option-match [:option [:ref :gmir.node/value]] (node/child value index) (node/nil-value) item item))
(defn- named? [value [:ref :gmir.node/value] expected :keyword] :bool
  (arena-scope (node/keyword-is? value expected)))
(defn- instruction? [value [:ref :gmir.node/value] op :keyword] :bool (arena-scope (named? (node/key value :mir/op) op)))
(defn- kw [values [:list :keyword] key :keyword] [:list :keyword] (typed-list-conj [:list :keyword] values key))
(defn- clean [] [:option [:ref :mir/refusal]] (option-none-of [:option [:ref :mir/refusal]]))
(defn- failure [problem :keyword data [:ref :gmir.node/value]] [:option [:ref :mir/refusal]]
  (option-some-of [:option [:ref :mir/refusal]] (outcome/refusal problem data)))
(defn- failed? [error [:option [:ref :mir/refusal]]] :bool (arena-scope (option-some?-of [:option [:ref :mir/refusal]] error)))
(defn- member? [keys [:list :keyword] value [:ref :gmir.node/value]] :bool
  (arena-scope (loop [index 0]
    (if (>= index (vector-count keys)) false
      (if (named? value (typed-list-nth [:list :keyword] keys index)) true (recur (+ index 1)))))))
(defn- fields? [value [:ref :gmir.node/value] keys [:list :keyword]] :bool
  (arena-scope (and (= (node/kind value) :map) (= (node/child-count value) (* 2 (vector-count keys)))
       (loop [index 0]
         (if (>= index (node/child-count value)) true
           (let [key (at value index)]
             (if (and (member? keys key)
                      (loop [previous 0]
                        (if (>= previous index) true
                          (if (node/same-name? key (at value previous)) false (recur (+ previous 2))))))
               (recur (+ index 2)) false)))))))
(defn- integer=? [value [:ref :gmir.node/value] expected :i64] :bool
  (arena-scope (let [n (identity/integer-i64 value)]
    (and (option-some?-of [:option :i64] n) (= (option-match [:option :i64] n 0 found-value found-value) expected)))))
(defn- same-location? [left [:ref :gmir.node/value] right [:ref :gmir.node/value]] :bool
  (arena-scope (or (node/same-name? left right) (and (= (node/kind left) :nil) (= (node/kind right) :nil))
      (let [n (identity/integer-i64 left)]
        (and (option-some?-of [:option :i64] n) (integer=? right (option-match [:option :i64] n 0 found-value found-value)))))))
(defn- sequence=? [left [:ref :gmir.node/value] right [:ref :gmir.node/value]] :bool
  (arena-scope (and (or (= (node/kind left) :vector) (= (node/kind left) :list))
       (or (= (node/kind right) :vector) (= (node/kind right) :list))
       (= (node/child-count left) (node/child-count right))
       (loop [index 0]
         (if (>= index (node/child-count left)) true
           (if (same-location? (at left index) (at right index)) (recur (+ index 1)) false))))))
(defn- unique-names? [values [:ref :gmir.node/value]] :bool
  (arena-scope (loop [index 0 previous 0]
    (cond (>= index (node/child-count values)) true
          (>= previous index) (recur (+ index 1) 0)
          (node/same-name? (at values index) (at values previous)) false
          :else (recur index (+ previous 1))))))
(defn- select [instructions [:ref :gmir.node/value] op :keyword] [:ref :gmir.node/value]
  (loop [index 0 out (node/empty-vector)]
    (if (>= index (node/child-count instructions)) out
      (let [value (at instructions index)]
        (recur (+ index 1) (if (instruction? value op) (node/append out value) out))))))
(defn- call? [value [:ref :gmir.node/value]] :bool
  (arena-scope ;; x86-privileged is intentionally absent from this owning frame-policy set.
  (or (instruction? value :mir/call) (instruction? value :mir/tail-call)
      (instruction? value :mir/runtime-call) (instruction? value :mir/capability-call))))
(defn- calls-or-recurs? [instructions [:ref :gmir.node/value]] :bool
  (arena-scope (loop [index 0]
    (if (>= index (node/child-count instructions)) false
      (let [value (at instructions index)]
        (if (or (call? value) (instruction? value :mir/recur)) true (recur (+ index 1))))))))
(defn- call-registers [target :keyword] [:list :keyword]
  (option-match [:option [:list :keyword]] (catalog/registers-for (catalog/call-argument-registers) target :all) (typed-list-new [:list :keyword]) found-value found-value))
(defn- function-index [functions [:ref :gmir.node/value] name [:ref :gmir.node/value]] :i64
  (arena-scope (loop [index 0]
    (if (>= index (node/child-count functions)) -1
      (if (node/same-name? name (node/key (at functions index) :mir/name)) index (recur (+ index 1)))))))
(defn- function-names [functions [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (loop [index 0 out (node/empty-vector)]
    (if (>= index (node/child-count functions)) out
      (recur (+ index 1) (node/append out (node/key (at functions index) :mir/name))))))
(defn- valid-names? [names [:ref :gmir.node/value]] :bool
  (arena-scope (and (unique-names? names)
       (loop [index 0]
         (if (>= index (node/child-count names)) true
           (if (identity/function-id? (at names index)) (recur (+ index 1)) false))))))
(defn- function-data [function [:ref :gmir.node/value] key :keyword data [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-map) (node/put-key :function (node/key function :mir/name)) (node/put-key key data)))

(defn- entry-error [target :keyword arity :i64 function [:ref :gmir.node/value] instructions [:ref :gmir.node/value]]
  [:option [:ref :mir/refusal]]
  (let [abi (call-registers target) n (if (< arity (vector-count abi)) arity (vector-count abi))
        arguments (select instructions :mir/argument)]
    (if (and (= (node/child-count arguments) n)
             (loop [index 0]
               (if (>= index n) true
                 (let [value (at arguments index)]
                   (if (and (integer=? (node/key value :mir/index) index)
                            (named? (node/key value :mir/dst) (typed-list-nth [:list :keyword] abi index)))
                     (recur (+ index 1)) false))))
             (loop [index 0]
               (if (>= index (node/child-count instructions)) true
                 (let [value (at instructions index)]
                   (if (and (instruction? value :mir/incoming-load)
                            (>= (option-match [:option :i64] (identity/integer-i64 (node/key value :mir/index)) arity found-value found-value) arity))
                     false (recur (+ index 1)))))))
      (clean) (failure :entry-argument-profile-violation (function-data function :arguments arguments)))))

(defn- home-parameter [homes [:list [:ref :mir.validation/home]] location [:ref :gmir.node/value]] [:option :i64]
  (loop [index 0]
    (if (>= index (vector-count homes)) (option-none-of [:option :i64])
      (let [entry (typed-list-nth [:list [:ref :mir.validation/home]] homes index)]
        (if (same-location? location (record-get [:ref :mir.validation/home] entry :location))
          (option-some-of [:option :i64] (record-get [:ref :mir.validation/home] entry :parameter)) (recur (+ index 1)))))))
(defn- put-home [homes [:list [:ref :mir.validation/home]] location [:ref :gmir.node/value] parameter :i64]
  [:list [:ref :mir.validation/home]]
  (loop [index 0 found false out (typed-list-new [:list [:ref :mir.validation/home]])]
    (if (>= index (vector-count homes))
      (if found out (typed-list-conj [:list [:ref :mir.validation/home]] out (record-new [:ref :mir.validation/home] location parameter)))
      (let [entry (typed-list-nth [:list [:ref :mir.validation/home]] homes index)
            same (same-location? location (record-get [:ref :mir.validation/home] entry :location))]
        (recur (+ index 1) (or found same) (typed-list-conj [:list [:ref :mir.validation/home]] out
          (if same (record-new [:ref :mir.validation/home] location parameter) entry)))))))
(defn- initial-homes [abi [:list :keyword] count :i64] [:list [:ref :mir.validation/home]]
  (loop [index 0 out (typed-list-new [:list [:ref :mir.validation/home]])]
    (if (>= index count) out
      (recur (+ index 1) (put-home out (node/keyword-literal (typed-list-nth [:list :keyword] abi index)) index)))))
(defn- transport [state [:ref :mir.validation/transport] instruction [:ref :gmir.node/value]]
  [:option [:ref :mir.validation/transport]]
  (let [registers (record-get [:ref :mir.validation/transport] state :registers)
        slots (record-get [:ref :mir.validation/transport] state :slots)
        load (instruction? instruction :mir/spill-load) store (instruction? instruction :mir/spill-store)
        parameter (home-parameter (if load slots registers) (node/key instruction (if load :mir/slot :mir/src)))]
    (if (and (or load store (instruction? instruction :mir/move)) (option-some?-of [:option :i64] parameter))
      (let [n (option-match [:option :i64] parameter -1 found-value found-value)]
        (option-some-of [:option [:ref :mir.validation/transport]]
          (record-new [:ref :mir.validation/transport]
            (if store registers (put-home registers (node/key instruction :mir/dst) n))
            (if store (put-home slots (node/key instruction :mir/slot) n) slots))))
      (option-none-of [:option [:ref :mir.validation/transport]]))))
(defn- canonical-prefix? [abi [:list :keyword] arity :i64 instructions [:ref :gmir.node/value]] :bool
  (arena-scope (and (>= (node/child-count instructions) arity)
       (loop [index 0]
         (if (>= index arity) true
           (let [value (at instructions index)]
             (if (and (instruction? value :mir/argument) (integer=? (node/key value :mir/index) index)
                      (named? (node/key value :mir/dst) (typed-list-nth [:list :keyword] abi index)))
               (recur (+ index 1)) false)))))))
(defn- first-reentry [instructions [:ref :gmir.node/value]] :i64
  (arena-scope (loop [index 0]
    (if (>= index (node/child-count instructions)) -1
      (if (instruction? (at instructions index) :mir/reentry) index (recur (+ index 1)))))))
(defn- prefix-transport? [target :keyword arity :i64 instructions [:ref :gmir.node/value]
                         index :i64 parameters [:ref :gmir.node/value]] :bool
  (arena-scope (let [abi (call-registers target)]
    (and (canonical-prefix? abi arity instructions) (>= index arity)
         (loop [cursor arity state (record-new [:ref :mir.validation/transport] (initial-homes abi arity) (typed-list-new [:list [:ref :mir.validation/home]]))]
           (if (>= cursor index)
             (loop [parameter 0]
               (if (>= parameter (node/child-count parameters)) true
                 (let [home (home-parameter (record-get [:ref :mir.validation/transport] state :registers) (at parameters parameter))]
                   (if (and (option-some?-of [:option :i64] home) (= (option-match [:option :i64] home -1 found-value found-value) parameter))
                     (recur (+ parameter 1)) false))))
             (let [next (transport state (at instructions cursor))]
               (if (option-some?-of [:option [:ref :mir.validation/transport]] next)
                 (recur (+ cursor 1) (option-match [:option [:ref :mir.validation/transport]] next state found-value found-value)) false))))))))
(defn- reentry-error [target :keyword arity :i64 function [:ref :gmir.node/value] instructions [:ref :gmir.node/value]]
  [:option [:ref :mir/refusal]]
  (let [abi-count (vector-count (call-registers target)) n (if (< arity abi-count) arity abi-count)
        reentries (select instructions :mir/reentry) recurs (select instructions :mir/recur)
        parameters (node/key (at reentries 0) :mir/parameters)]
    (if (if (> (node/child-count recurs) 0)
          (and (= (node/child-count reentries) 1) (= (node/child-count parameters) n) (unique-names? parameters)
               (prefix-transport? target n instructions (first-reentry instructions) parameters)
               (loop [index 0]
                 (if (>= index (node/child-count instructions)) true
                   (let [value (at instructions index) next (at instructions (+ index 1))]
                     (if (and (instruction? value :mir/recur)
                              (not (and (sequence=? parameters (node/key value :mir/arguments))
                                        (or (= (node/kind next) :nil) (instruction? next :mir/label)))))
                       false (recur (+ index 1)))))))
          (= (node/child-count reentries) 0))
      (clean) (failure :invalid-direct-reentry-contract function))))

(defn- explicit-backed-value-operations [] [:list :keyword]
  (-> (typed-list-new [:list :keyword])
          (kw :mir/argument) (kw :mir/constant) (kw :mir/add) (kw :mir/subtract)
          (kw :mir/multiply) (kw :mir/quotient) (kw :mir/quotient-constant)
          (kw :mir/bit-and) (kw :mir/bit-or) (kw :mir/bit-xor)
          (kw :mir/shift-left) (kw :mir/shift-right-signed) (kw :mir/shift-right-unsigned)
          (kw :mir/f64-add) (kw :mir/f64-subtract) (kw :mir/f64-multiply) (kw :mir/f64-divide)
          (kw :mir/f64-min) (kw :mir/f64-max) (kw :mir/f64-sqrt) (kw :mir/f64-equal)
          (kw :mir/f64-less-than) (kw :mir/f64-less-or-equal) (kw :mir/f64-greater-than) (kw :mir/f64-greater-or-equal) (kw :mir/f64-unordered)
          (kw :mir/f32-add) (kw :mir/f32-subtract) (kw :mir/f32-multiply) (kw :mir/f32-divide) (kw :mir/f32-sqrt)
          (kw :mir/f32-equal) (kw :mir/f32-less-than) (kw :mir/f32-less-or-equal) (kw :mir/f32-greater-than) (kw :mir/f32-greater-or-equal) (kw :mir/f32-unordered)
          (kw :mir/f32-to-f64) (kw :mir/f64-to-f32) (kw :mir/i64-to-f32) (kw :mir/i64-to-f64)
          (kw :mir/kernel-load-u8) (kw :mir/kernel-store-u8) (kw :mir/kernel-load-u32) (kw :mir/kernel-store-u32)
          (kw :mir/kernel-try-lock-u32) (kw :mir/kernel-unlock-u32) (kw :mir/kernel-subregion) (kw :mir/kernel-dot-f32)
          (kw :mir/kernel-dequant-dot-q8-0) (kw :mir/kernel-dequant-dot-q4-k) (kw :mir/kernel-dequant-dot-q6-k) (kw :mir/kernel-dequant-dot-iq4-xs)
          (kw :mir/kernel-dequant-dot-iq2-s) (kw :mir/kernel-dequant-dot-iq3-xxs) (kw :mir/kernel-dequant-dot-iq3-s) (kw :mir/kernel-dequant-dot-ptq1-0)
          (kw :mir/equal) (kw :mir/less-than) (kw :mir/greater-than) (kw :mir/less-or-equal) (kw :mir/greater-or-equal)
          (kw :mir/call) (kw :mir/runtime-call) (kw :mir/capability-call) (kw :mir/x86-privileged)
          (kw :mir/data-address) (kw :mir/rodata-address) (kw :mir/function-address)))
(defn- backed-value-operation? [explicit [:list :keyword] windows [:list :keyword]
                               slices [:list :keyword] atomics [:list :keyword] value [:ref :gmir.node/value]] :bool
  (arena-scope (let [op (node/key value :mir/op)]
    (or (member? explicit op) (member? windows op)
        (member? slices op) (member? atomics op)))))
(defn- backing-error [function [:ref :gmir.node/value] instructions [:ref :gmir.node/value]] [:option [:ref :mir/refusal]]
  (let [explicit (explicit-backed-value-operations) windows (catalog/kernel-window-operations)
        slices (catalog/slice-operations) atomics (catalog/kernel-atomic-ops)]
   (loop [index 0]
    (if (>= index (node/child-count instructions)) (clean)
      (let [value (at instructions index) store (at instructions (+ index 1))]
        (if (and (backed-value-operation? explicit windows slices atomics value)
                 (not (and (instruction? store :mir/spill-store) (same-location? (node/key value :mir/dst) (node/key store :mir/src)))))
          (failure :unbacked-call-frame-value (function-data function :instruction value)) (recur (+ index 1))))))))
(defn- parallel-error [function [:ref :gmir.node/value] instructions [:ref :gmir.node/value]] [:option [:ref :mir/refusal]]
  (loop [index 0]
    (if (>= index (node/child-count instructions)) (clean)
      (let [value (at instructions index) arguments (node/key value :mir/arguments) n (node/child-count arguments)]
        ;; A physical call's arguments passed flat ABI validation and are a
        ;; vector or list. Do not turn a missing load prefix into an empty one.
        (if (and (call? value)
                 (not (and (>= index n)
                           (loop [argument 0]
                             (if (>= argument n) true
                               (let [load (at instructions (+ (- index n) argument))]
                                 (if (and (instruction? load :mir/spill-load)
                                          (same-location? (node/key load :mir/dst) (at arguments argument)))
                                   (recur (+ argument 1)) false)))))))
          (failure :non-parallel-call-arguments (function-data function :call value)) (recur (+ index 1)))))))

;; The reference evaluates physical forward signatures before validating the
;; callee function. Keep numeric comparisons, including non-integral f64s, so
;; an invalid later signature cannot silently change the first refusal order.
(defn- small-positive-f64-bits [value :i64] :i64
  (arena-scope (if (= value 0) 0
    (loop [exponent 0 base 1]
      (if (> (* base 2) value)
        (+ (i64-shift-left (+ exponent 1023) 52) (i64-shift-left (- value base) (- 52 exponent)))
        (recur (+ exponent 1) (* base 2)))))))
(defn- greater-than-count [value [:ref :gmir.node/value] count :i64] [:option :bool]
  (let [n (identity/integer-i64 value)]
    (cond
      (option-some?-of [:option :i64] n) (option-some-of [:option :bool] (> (option-match [:option :i64] n 0 found-value found-value) count))
      (identity/integer-form? value) (option-some-of [:option :bool] (identity/nonnegative-integer? value))
      (= (node/kind value) :f64)
      (let [bits (node/number value)]
        (option-some-of [:option :bool] (and (>= bits 0) (<= bits 9218868437227405312) (> bits (small-positive-f64-bits count)))))
      :else (option-none-of [:option :bool]))))
(defn- stack-limit [value [:ref :gmir.node/value] register-count :i64] [:option :i64]
  (let [n (identity/integer-i64 value)]
    (cond
      (option-some?-of [:option :i64] n)
      (let [limit (option-match [:option :i64] n 0 found-value found-value)]
        (if (<= limit register-count) (option-some-of [:option :i64] register-count)
          (if (<= limit (gmir-catalog/max-arity)) (option-some-of [:option :i64] limit) (option-none-of [:option :i64]))))
      (= (node/kind value) :f64)
      (let [bits (node/number value)]
        (if (or (< bits 0) (> bits (small-positive-f64-bits (gmir-catalog/max-arity)))) (option-none-of [:option :i64])
          (loop [limit register-count]
            (if (>= (small-positive-f64-bits limit) bits) (option-some-of [:option :i64] limit) (recur (+ limit 1))))))
      :else (option-none-of [:option :i64]))))
(defn- direct-call-error [target :keyword virtual :bool function [:ref :gmir.node/value]
                         functions [:ref :gmir.node/value] instructions [:ref :gmir.node/value]] [:option [:ref :mir/refusal]]
  (loop [index 0]
    (if (>= index (node/child-count instructions)) (clean)
      (let [call (at instructions index)]
        (if (or (instruction? call :mir/call) (instruction? call :mir/tail-call))
          (let [callee (function-index functions (node/key call :mir/callee))]
            (if (< callee 0) (failure :unresolved-callee call)
              (let [expected (node/key (at functions callee) :mir/arity)
                    count (vector-count (call-registers target)) larger (greater-than-count expected count)
                    above (option-match [:option :bool] larger false found-value found-value)
                    matches (if virtual (integer=? expected (node/child-count (node/key call :mir/arguments)))
                              (and (option-some?-of [:option :bool] larger)
                                   (if above (= count (node/child-count (node/key call :mir/arguments)))
                                     (integer=? expected (node/child-count (node/key call :mir/arguments))))))]
                (if matches (recur (+ index 1))
                  (failure :call-arity-mismatch (node/put-key (function-data function :call call) :expected expected))))))
          (recur (+ index 1)))))))
(defn- stack-stores? [pending [:ref :gmir.node/value] register-count :i64 limit :i64 expected-op :keyword] :bool
  (arena-scope (and (= (node/child-count pending) (- limit register-count))
       (loop [index 0]
         (if (>= index (node/child-count pending)) true
           (let [store (at pending index) n (identity/integer-i64 (node/key store :mir/index))
                 value (option-match [:option :i64] n -1 found-value found-value)]
             (if (and (instruction? store expected-op) (option-some?-of [:option :i64] n) (>= value register-count) (< value limit)
                      (loop [previous 0]
                        (if (>= previous index) true
                          (if (integer=? (node/key (at pending previous) :mir/index) value) false (recur (+ previous 1))))))
               (recur (+ index 1)) false)))))))
(defn- stack-error [target :keyword arity :i64 function [:ref :gmir.node/value] functions [:ref :gmir.node/value]
                   instructions [:ref :gmir.node/value]] [:option [:ref :mir/refusal]]
  (let [register-count (vector-count (call-registers target))]
    (loop [index 0 pending (node/empty-vector)]
      (if (>= index (node/child-count instructions))
        (if (= (node/child-count pending) 0) (clean) (failure :stack-argument-profile-violation (function-data function :stores pending)))
        (let [value (at instructions index)]
          (cond
            (or (instruction? value :mir/outgoing-argument) (instruction? value :mir/incoming-argument-store))
            (recur (+ index 1) (node/append pending value))
            (or (call? value) (instruction? value :mir/recur))
            (let [direct (or (instruction? value :mir/call) (instruction? value :mir/tail-call))
                  callee (if direct (function-index functions (node/key value :mir/callee)) -1)
                  signature (cond direct (node/key (at functions callee) :mir/arity)
                                  (instruction? value :mir/recur) (node/i64-value arity) :else (node/i64-value 0))
                  limit (stack-limit signature register-count)
                  expected-op (if (or (instruction? value :mir/tail-call) (instruction? value :mir/recur)) :mir/incoming-argument-store :mir/outgoing-argument)]
              (if (and (option-some?-of [:option :i64] limit)
                       (stack-stores? pending register-count (option-match [:option :i64] limit register-count found-value found-value) expected-op))
                (recur (+ index 1) (node/empty-vector))
                (failure :stack-argument-profile-violation (node/put-key (function-data function :call value) :stores pending))))
            :else (recur (+ index 1) pending)))))))

(defn- function-error [target :keyword virtual :bool function [:ref :gmir.node/value] functions [:ref :gmir.node/value]]
  [:option [:ref :mir/refusal]]
  (let [keys (-> (typed-list-new [:list :keyword]) (kw :mir/name) (kw :mir/arity) (kw :mir/instructions))
        expected (if virtual keys (-> keys (kw :mir/frame-slots) (kw :mir/frame-policy)))
        n (identity/integer-i64 (node/key function :mir/arity)) arity (option-match [:option :i64] n -1 found-value found-value)
        policy (node/key function :mir/frame-policy) instructions (node/key function :mir/instructions)]
    (if (not (and (fields? function expected) (identity/function-id? (node/key function :mir/name))
                  (option-some?-of [:option :i64] n) (>= arity 0) (<= arity (gmir-catalog/max-arity))
                  (or virtual (named? policy :allocator) (named? policy :all-vregs) (named? policy :call-live))))
      (failure :non-canonical-function function)
      (let [base (-> (node/empty-map) (node/put-key :mir/version (node/i64-value 3))
                    (node/put-key :mir/target (node/keyword-literal target))
                    (node/put-key :mir/registers (node/keyword-literal (if virtual :virtual :physical)))
                    (node/put-key :mir/instructions instructions))
            flat-program (if virtual base (node/put-key base :mir/frame-slots (node/key function :mir/frame-slots)))
            flat-result (flat/validate! flat-program)]
        (if (not (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] flat-result))
          (option-some-of [:option [:ref :mir/refusal]]
            (result-error-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] flat-result (outcome/refusal :non-canonical-program flat-program)))
          (let [entry (if virtual (clean) (entry-error target arity function instructions))]
            (cond
              (failed? entry) entry
              (and (not virtual)
                   (if (calls-or-recurs? instructions) (not (or (named? policy :all-vregs) (named? policy :call-live)))
                     (not (named? policy :allocator)))) (failure :call-frame-policy-violation function)
              :else
              (let [reentry (if virtual (clean) (reentry-error target arity function instructions))
                    backing (if (or (failed? reentry) virtual (not (named? policy :all-vregs))) (clean) (backing-error function instructions))
                    parallel (if (or (failed? reentry) (failed? backing) virtual (not (named? policy :all-vregs))) (clean) (parallel-error function instructions))]
                (cond (failed? reentry) reentry (failed? backing) backing (failed? parallel) parallel
                      :else (let [direct (direct-call-error target virtual function functions instructions)]
                              (if (failed? direct) direct (if virtual (clean) (stack-error target arity function functions instructions)))))))))))))
(defn- module-error [program [:ref :gmir.node/value]] [:option [:ref :mir/refusal]]
  (let [entry (node/key program :mir/entry) functions (node/key program :mir/functions)
        profile (node/key program :mir/registers) target-value (node/key program :mir/target)
        target (if (named? target-value :x86-64) :x86-64 :aarch64) virtual (named? profile :virtual)
        keys (-> (typed-list-new [:list :keyword]) (kw :mir/version) (kw :mir/target) (kw :mir/registers) (kw :mir/entry) (kw :mir/functions))]
    (if (not (and (fields? program keys) (member? (catalog/targets) target-value)
                  (or virtual (named? profile :physical)) (identity/function-id? entry)
                  (= (node/kind functions) :vector) (> (node/child-count functions) 0)))
      (failure :non-canonical-module program)
      (let [names (function-names functions)]
        (if (not (and (valid-names? names) (>= (function-index functions entry) 0)))
          (failure :invalid-module-functions (-> (node/empty-map) (node/put-key :entry entry) (node/put-key :names names)))
          (loop [index 0]
            (if (>= index (node/child-count functions)) (clean)
              (let [error (function-error target virtual (at functions index) functions)]
                (if (failed? error) error (recur (+ index 1)))))))))))
(defn validate! [program [:ref :gmir.node/value]] [:result [:ref :gmir.node/value] [:ref :mir/refusal]]
  (if (not (integer=? (node/key program :mir/version) 3)) (flat/validate! program)
    (let [semantic (module-error program) error (if (failed? semantic) semantic (flat/representation-error program))]
      (if (failed? error)
        (result-err-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]]
          (option-match [:option [:ref :mir/refusal]] error (outcome/refusal :non-canonical-module program) found-value found-value))
        (result-ok-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] program)))))
