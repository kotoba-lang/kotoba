;; Complete saved-register scan for nominal MIR input, including map keys and
;; nested collections. No register can be omitted by scanning only operands.
(ns kotoba.mir.registers
  {:kotoba/export [saved-registers physical-register?]}
  (:require [kotoba.gmir.node :as node] [kotoba.mir.catalog :as catalog]
            [kotoba.mir.outcome :as outcome]))

(defn- named? [value [:ref :gmir.node/value] expected :keyword] :bool
  (arena-scope (node/keyword-is? value expected)))
(defn- member? [values [:list :keyword] value [:ref :gmir.node/value]] :bool
  (arena-scope (loop [index 0]
    (if (>= index (vector-count values)) false
      (if (named? value (typed-list-nth [:list :keyword] values index)) true (recur (+ index 1)))))))
(defn- bank [table [:list [:ref :mir.catalog/bank]] target :keyword] [:list :keyword]
  (option-match [:option [:list :keyword]] (catalog/registers-for table target :all) (typed-list-new [:list :keyword]) found-value found-value))
(defn physical-register? [target :keyword value [:ref :gmir.node/value]] :bool
  (arena-scope (and (= (node/kind value) :keyword)
       (or (member? (bank (catalog/physical-registers) target) value)
           (member? (bank (catalog/leaf-registers) target) value)
           (member? (bank (catalog/preserved-registers) target) value)
           (member? (bank (catalog/call-argument-registers) target) value)))))
(defn- collection? [value [:ref :gmir.node/value]] :bool
  (arena-scope (let [kind (node/kind value)]
    (or (= kind :map) (= kind :set) (= kind :vector) (= kind :list)))))
(defn- contains-register? [value [:ref :gmir.node/value] register :keyword] :bool
  (arena-scope (if (named? value register) true
    (if (not (collection? value)) false
      (loop [index 0]
        (if (>= index (node/child-count value)) false
          (let [child (option-match [:option [:ref :gmir.node/value]] (node/child value index) (node/nil-value) item item)]
            (if (contains-register? child register) true (recur (+ index 1))))))))))
(defn saved-registers [target :keyword instructions [:ref :gmir.node/value]]
  [:result [:list :keyword] [:ref :mir/refusal]]
  (let [kind (node/kind instructions)]
    (if (not (or (collection? instructions) (= kind :nil) (= kind :string) (= kind :bytes)))
      (result-err-of [:result [:list :keyword] [:ref :mir/refusal]] (outcome/refusal :non-sequential-instructions instructions))
      (let [preserved (bank (catalog/preserved-registers) target)]
        (loop [index 0 out (typed-list-new [:list :keyword])]
          (if (>= index (vector-count preserved)) (result-ok-of [:result [:list :keyword] [:ref :mir/refusal]] out)
            (let [register (typed-list-nth [:list :keyword] preserved index)]
              (recur (+ index 1) (if (contains-register? instructions register)
                (typed-list-conj [:list :keyword] out register) out)))))))))
