(ns kotoba.mir.outcome
  {:kotoba/export [refusal from-gmir phase problem message instruction]}
  (:require [kotoba.gmir.node :as node] [kotoba.gmir.outcome :as gmir])
  (:schemas
   {:mir/refusal [:record :mir/refusal
      [[:phase :keyword] [:problem :keyword] [:message :string]
       [:instruction [:ref :gmir.node/value]]]]}))

(defn refusal [problem :keyword value [:ref :gmir.node/value]] [:ref :mir/refusal]
  (record-new [:ref :mir/refusal] :mir problem
    (string-concat "MIR rejected: " (keyword-name problem)) value))
(defn from-gmir [value [:ref :gmir/refusal]] [:ref :mir/refusal]
  (record-new [:ref :mir/refusal] (gmir/phase value) (gmir/problem value) (gmir/message value) (gmir/instruction value)))
(defn phase [value [:ref :mir/refusal]] :keyword (record-get [:ref :mir/refusal] value :phase))
(defn problem [value [:ref :mir/refusal]] :keyword (record-get [:ref :mir/refusal] value :problem))
(defn message [value [:ref :mir/refusal]] :string (record-get [:ref :mir/refusal] value :message))
(defn instruction [value [:ref :mir/refusal]] [:ref :gmir.node/value] (record-get [:ref :mir/refusal] value :instruction))
