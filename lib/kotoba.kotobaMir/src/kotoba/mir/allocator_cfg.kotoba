;; Owning basic-block, dominator and fixed-point live-variable algorithms.
;; Sets are persistent AVL sets; IR/block sequences retain original indices.
(ns kotoba.mir.allocator-cfg
  {:kotoba/export [flow blocks successors predecessors dominance dominators immediate-dominators
                  dominates? liveness live-in live-out last-uses use-indexes slot-definition slot-sources
                  definition-order spill-interference spill-slots]}
  (:require [kotoba.gmir.node :as node] [kotoba.gmir.identity :as identity]
            [kotoba.mir.table :as table] [kotoba.mir.operands :as operands]
            [kotoba.mir.allocator-data :as data] [kotoba.mir.outcome :as outcome])
  (:schemas
   {:mir.cfg/flow [:record :mir.cfg/flow [[:blocks [:ref :gmir.node/value]]
      [:successors [:ref :mir.table/tree]] [:predecessors [:ref :mir.table/tree]]]]
    :mir.cfg/dominance [:record :mir.cfg/dominance [[:sets [:ref :mir.table/tree]] [:immediate [:ref :mir.table/tree]]]]
    :mir.cfg/live [:record :mir.cfg/live [[:in [:ref :mir.table/tree]] [:out [:ref :mir.table/tree]]]]}))
(defn blocks [flow [:ref :mir.cfg/flow]] [:ref :gmir.node/value] (record-get [:ref :mir.cfg/flow] flow :blocks))
(defn successors [flow [:ref :mir.cfg/flow]] [:ref :mir.table/tree] (record-get [:ref :mir.cfg/flow] flow :successors))
(defn predecessors [flow [:ref :mir.cfg/flow]] [:ref :mir.table/tree] (record-get [:ref :mir.cfg/flow] flow :predecessors))
(defn dominators [analysis [:ref :mir.cfg/dominance]] [:ref :mir.table/tree] (record-get [:ref :mir.cfg/dominance] analysis :sets))
(defn immediate-dominators [analysis [:ref :mir.cfg/dominance]] [:ref :mir.table/tree] (record-get [:ref :mir.cfg/dominance] analysis :immediate))
(defn live-in [analysis [:ref :mir.cfg/live]] [:ref :mir.table/tree] (record-get [:ref :mir.cfg/live] analysis :in))
(defn live-out [analysis [:ref :mir.cfg/live]] [:ref :mir.table/tree] (record-get [:ref :mir.cfg/live] analysis :out))
(defn- terminator? [instruction [:ref :gmir.node/value]] :bool
  (arena-scope (or (data/op? instruction :mir/jump) (data/op? instruction :mir/branch-zero)
      (data/op? instruction :mir/branch-nonzero) (data/op? instruction :mir/return))))
(defn- conditional? [instruction [:ref :gmir.node/value]] :bool
  (arena-scope (or (data/op? instruction :mir/branch-zero) (data/op? instruction :mir/branch-nonzero))))
(defn- field [value [:ref :gmir.node/value] key :keyword] :i64 (arena-scope (node/number (node/key value key))))
(defn- basic-blocks [instructions [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (let [n (node/child-count instructions)
        leaders (loop [index 0 out (data/include (table/empty) (table/index-key 0))]
                  (if (>= index n) out
                    (let [value (data/at instructions index)
                          labeled (if (data/op? value :mir/label) (data/include out (table/index-key index)) out)]
                      (recur (+ index 1) (if (and (terminator? value) (< (+ index 1) n))
                        (data/include labeled (table/index-key (+ index 1))) labeled)))))]
    (loop [index 0 out (node/empty-vector)]
      (if (>= index (table/count leaders)) out
        (let [start (node/number (data/key-node (data/key-at leaders index)))
              end (if (< (+ index 1) (table/count leaders)) (- (node/number (data/key-node (data/key-at leaders (+ index 1)))) 1) (- n 1))]
          (recur (+ index 1) (node/append out (-> (node/empty-map) (node/put-key :index (node/i64-value index))
            (node/put-key :start (node/i64-value start)) (node/put-key :end (node/i64-value end))))))))))
(defn flow [instructions [:ref :gmir.node/value]] [:ref :mir.cfg/flow]
  (let [all (basic-blocks instructions) n (node/child-count all)
        labels (loop [index 0 out (table/empty)]
                 (if (>= index n) out
                   (let [value (data/at instructions (field (data/at all index) :start))]
                     (recur (+ index 1) (if (data/op? value :mir/label)
                       (data/put-number out (operands/key-of (node/key value :mir/id)) index) out)))))
        next (loop [index 0 out (table/empty)]
               (if (>= index n) out
                 (let [instruction (data/at instructions (field (data/at all index) :end))
                       target (data/get-number labels (operands/key-of (node/key instruction :mir/target)) -1)
                       fallthrough (if (< (+ index 1) n) (data/include (table/empty) (table/index-key (+ index 1))) (table/empty))
                       edges (cond (data/op? instruction :mir/return) (table/empty)
                               (data/op? instruction :mir/jump) (data/include (table/empty) (table/index-key target))
                               (conditional? instruction) (if (< target 0) fallthrough (data/include fallthrough (table/index-key target)))
                               :else fallthrough)]
                   (recur (+ index 1) (data/put-members out (table/index-key index) edges)))))
        previous (loop [index 0 out (table/empty)]
                   (if (>= index n) out
                     (let [edges (data/members next (table/index-key index))
                           updated (loop [edge 0 result out]
                                     (if (>= edge (table/count edges)) result
                                       (let [key (data/key-at edges edge)]
                                         (recur (+ edge 1) (data/put-members result key
                                           (data/include (data/members result key) (table/index-key index)))))))]
                       (recur (+ index 1) updated))))]
    (record-new [:ref :mir.cfg/flow] all next previous)))
(defn- universe [n :i64] [:ref :mir.table/tree]
  (loop [index 0 out (table/empty)] (if (>= index n) out (recur (+ index 1) (data/include out (table/index-key index))))))
(defn- same-sets? [left [:ref :mir.table/tree] right [:ref :mir.table/tree] count :i64] :bool
  (arena-scope (loop [index 0]
    (if (>= index count) true
      (if (data/same-set? (data/members left (table/index-key index)) (data/members right (table/index-key index)))
        (recur (+ index 1)) false)))))
(defn dominates? [analysis [:ref :mir.cfg/dominance] dominator :i64 index :i64] :bool
  (arena-scope (data/member? (data/members (dominators analysis) (table/index-key index)) (table/index-key dominator))))
(defn dominance [flow [:ref :mir.cfg/flow]] [:ref :mir.cfg/dominance]
  (let [n (node/child-count (blocks flow)) all (universe n) entry (data/include (table/empty) (table/index-key 0))
        initial (loop [index 0 out (table/empty)]
                  (if (>= index n) out (recur (+ index 1) (data/put-members out (table/index-key index) (if (= index 0) entry all)))))
        fixed (loop [current initial]
                (let [next (loop [index 0 out (table/empty)]
                             (if (>= index n) out
                               (let [preds (data/members (predecessors flow) (table/index-key index))
                                     set (cond (= index 0) entry (= (table/count preds) 0) (data/members current (table/index-key index))
                                           :else (data/include
                                             (loop [edge 1 result (data/members current (data/key-at preds 0))]
                                               (if (>= edge (table/count preds)) result
                                                 (recur (+ edge 1) (data/intersection result (data/members current (data/key-at preds edge))))))
                                             (table/index-key index)))]
                                 (recur (+ index 1) (data/put-members out (table/index-key index) set)))))]
                  (if (same-sets? current next n) current (recur next))))
        immediate (loop [index 1 out (table/empty)]
                    (if (>= index n) out
                      (let [strict (data/exclude (data/members fixed (table/index-key index)) (table/index-key index))
                            candidate (loop [cursor 0]
                                        (if (>= cursor (table/count strict)) -1
                                          (let [key (data/key-at strict cursor)
                                                shadowed (loop [other 0]
                                                           (if (>= other (table/count strict)) false
                                                             (let [b (data/key-at strict other)]
                                                               (if (and (not= (table/compare-key key b) 0) (data/member? (data/members fixed b) key))
                                                                 true (recur (+ other 1))))))]
                                            (if shadowed (recur (+ cursor 1)) (node/number (data/key-node key))))))]
                        (recur (+ index 1) (if (< candidate 0) out (data/put-number out (table/index-key index) candidate))))))]
    (record-new [:ref :mir.cfg/dominance] fixed immediate)))
(defn slot-definition [instruction [:ref :gmir.node/value] merge-dst [:ref :mir.table/tree]] [:ref :gmir.node/value]
  (cond (data/op? instruction :mir/merge-store) (data/lookup merge-dst (table/index-key (field instruction :mir/slot)))
        (data/op? instruction :mir/merge-load) (node/nil-value) :else (data/instruction-def instruction)))
(defn slot-sources [instruction [:ref :gmir.node/value] frame :bool] [:ref :mir.table/tree]
  (if (and frame (data/op? instruction :mir/merge-load))
    (data/include (table/empty) (operands/key-of (node/key instruction :mir/dst))) (data/source-set instruction)))
(defn- use-def [instructions [:ref :gmir.node/value] block [:ref :gmir.node/value] frame :bool merge-dst [:ref :mir.table/tree]] [:ref :mir.cfg/live]
  ;; The two sets share the live record only as a nominal pair, not as a
  ;; fixed-point result: reads before local defs are uses, later reads are not.
  (loop [index (field block :start) uses (table/empty) defs (table/empty)]
    (if (> index (field block :end)) (record-new [:ref :mir.cfg/live] uses defs)
      (let [value (data/at instructions index) definition (if frame (slot-definition value merge-dst) (data/instruction-def value))]
        (recur (+ index 1) (data/union uses (data/difference (slot-sources value frame) defs))
          (if (identity/vreg? definition) (data/include defs (operands/key-of definition)) defs))))))
(defn liveness [instructions [:ref :gmir.node/value] flow [:ref :mir.cfg/flow] frame :bool merge-dst [:ref :mir.table/tree]] [:ref :mir.cfg/live]
  (let [all (blocks flow) n (node/child-count all)
        uses (loop [index 0 out (table/empty)]
               (if (>= index n) out (recur (+ index 1) (data/put-members out (table/index-key index)
                 (live-in (use-def instructions (data/at all index) frame merge-dst))))))
        defs (loop [index 0 out (table/empty)]
               (if (>= index n) out (recur (+ index 1) (data/put-members out (table/index-key index)
                 (live-out (use-def instructions (data/at all index) frame merge-dst))))))]
    (loop [in (table/empty) out (table/empty)]
      (let [next-out (loop [index 0 result (table/empty)]
                       (if (>= index n) result
                         (let [edges (data/members (successors flow) (table/index-key index))
                               joined (loop [cursor 0 set (table/empty)]
                                        (if (>= cursor (table/count edges)) set
                                          (recur (+ cursor 1) (data/union set (data/members in (data/key-at edges cursor))))))]
                           (recur (+ index 1) (data/put-members result (table/index-key index) joined)))))
            next-in (loop [index 0 result (table/empty)]
                      (if (>= index n) result
                        (let [key (table/index-key index)]
                          (recur (+ index 1) (data/put-members result key
                            (data/union (data/members uses key) (data/difference (data/members next-out key) (data/members defs key))))))))]
        (if (and (same-sets? in next-in n) (same-sets? out next-out n))
          (record-new [:ref :mir.cfg/live] in out) (recur next-in next-out))))))
(defn last-uses [instructions [:ref :gmir.node/value]] [:ref :mir.table/tree]
  (let [textual (loop [index 0 out (table/empty)]
                  (if (>= index (node/child-count instructions)) out
                    (let [sources (data/source-set (data/at instructions index))
                          next (loop [cursor 0 result out]
                                 (if (>= cursor (table/count sources)) result
                                   (recur (+ cursor 1) (data/put-number result (data/key-at sources cursor) index))))]
                      (recur (+ index 1) next))))
        graph (flow instructions) all (blocks graph) live (liveness instructions graph false (table/empty))]
    (loop [index 0 out textual]
      (if (>= index (node/child-count all)) out
        (let [end (field (data/at all index) :end) value (data/at instructions end)
              targets (data/members (successors graph) (table/index-key index))
              ;; Test the explicit branch target, not an arbitrary backwards
              ;; successor: the owning rule uses target-block <= block index.
              back? (and (or (data/op? value :mir/jump) (conditional? value))
                      (loop [cursor 0]
                        (if (>= cursor (table/count targets)) false
                          (if (<= (node/number (data/key-node (data/key-at targets cursor))) index) true (recur (+ cursor 1))))))
              values (data/members (live-out live) (table/index-key index))
              next (if back? (loop [cursor 0 result out]
                              (if (>= cursor (table/count values)) result
                                (let [key (data/key-at values cursor) old (data/get-number result key -1)]
                                  (recur (+ cursor 1) (data/put-number result key (if (> end old) end old)))))) out)]
          (recur (+ index 1) next))))))
(defn use-indexes [instructions [:ref :gmir.node/value]] [:ref :mir.table/tree]
  (loop [index 0 out (table/empty)]
    (if (>= index (node/child-count instructions)) out
      (let [sources (data/source-set (data/at instructions index))
            next (loop [cursor 0 result out]
                   (if (>= cursor (table/count sources)) result
                     (let [key (data/key-at sources cursor) old (data/lookup result key)
                           list (if (= (node/kind old) :nil) (node/empty-vector) old)]
                       (recur (+ cursor 1) (data/put-data result key (node/append list (node/i64-value index)))))))]
        (recur (+ index 1) next)))))
(defn definition-order [instructions [:ref :gmir.node/value]] [:result [:ref :gmir.node/value] [:ref :mir/refusal]]
  (loop [index 0 defined (table/empty) out (node/empty-vector)]
    (if (>= index (node/child-count instructions))
      (result-ok-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] out)
      (let [instruction (data/at instructions index) sources (data/source-set instruction)
            missing (not (= (table/count (data/difference sources defined)) 0))
            definition (data/instruction-def instruction)]
        (cond missing (result-err-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (outcome/refusal :use-before-definition instruction))
              (and (identity/vreg? definition) (data/present? defined (operands/key-of definition)))
              (result-err-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (outcome/refusal :multiple-definition instruction))
              :else (recur (+ index 1) (if (identity/vreg? definition) (data/include defined (operands/key-of definition)) defined)
                      (if (identity/vreg? definition) (node/append out definition) out)))))))
(defn- interfere [graph [:ref :mir.table/tree] definition [:ref :gmir.node/value] live [:ref :mir.table/tree]] [:ref :mir.table/tree]
  (if (not (identity/vreg? definition)) graph
    (let [key (operands/key-of definition) initialized (data/put-members graph key (data/members graph key))]
      (loop [index 0 out initialized]
        (if (>= index (table/count live)) out
          (let [other (data/key-at live index)]
            (recur (+ index 1) (if (= (table/compare-key key other) 0) out
              (data/put-members (data/put-members out key (data/include (data/members out key) other))
                other (data/include (data/members out other) key))))))))))
(defn spill-interference [instructions [:ref :gmir.node/value] merge-dst [:ref :mir.table/tree]] [:ref :mir.table/tree]
  (let [cfg (flow instructions) all (blocks cfg) live (liveness instructions cfg true merge-dst)]
    (loop [block-index 0 graph (table/empty)]
      (if (>= block-index (node/child-count all)) graph
        (let [block (data/at all block-index)
              result (loop [index (field block :end) out graph values (data/members (live-out live) (table/index-key block-index))]
                       (if (< index (field block :start)) out
                         (let [instruction (data/at instructions index) definition (slot-definition instruction merge-dst)]
                           (recur (- index 1) (interfere out definition values)
                             (data/union (if (identity/vreg? definition) (data/exclude values (operands/key-of definition)) values)
                               (slot-sources instruction true))))))]
          (recur (+ block-index 1) result))))))
(defn spill-slots [instructions [:ref :gmir.node/value] offset :i64 merge-dst [:ref :mir.table/tree]]
  [:result [:ref :mir.table/tree] [:ref :mir/refusal]]
  (let [checked (definition-order instructions)]
    (if (not (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] checked))
      (result-err-of [:result [:ref :mir.table/tree] [:ref :mir/refusal]]
        (result-error-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] checked (outcome/refusal :unexpected-order-result instructions)))
      (let [ordered (result-value-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] checked (node/empty-vector))
            graph (spill-interference instructions merge-dst)]
        (loop [index 0 slots (table/empty)]
          (if (>= index (node/child-count ordered)) (result-ok-of [:result [:ref :mir.table/tree] [:ref :mir/refusal]] slots)
            (let [key (operands/key-of (data/at ordered index)) neighbors (data/members graph key)
                  unavailable (loop [cursor 0 out (table/empty)]
                                (if (>= cursor (table/count neighbors)) out
                                  (let [other (data/key-at neighbors cursor)]
                                    (recur (+ cursor 1) (if (data/present? slots other)
                                      (data/include out (table/index-key (data/get-number slots other -1))) out)))))
                  slot (loop [candidate offset]
                         (cond (>= candidate 4096) -1 (data/member? unavailable (table/index-key candidate)) (recur (+ candidate 1)) :else candidate))]
              (if (< slot 0) (result-err-of [:result [:ref :mir.table/tree] [:ref :mir/refusal]]
                              (outcome/refusal :spill-frame-too-large (node/put-key (node/empty-map) :frame-slots (node/i64-value 4096))))
                (recur (+ index 1) (data/put-number slots key slot))))))))))
