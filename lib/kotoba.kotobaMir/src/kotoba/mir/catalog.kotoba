      (bank :aarch64 :all (-> (typed-list-new [:list :keyword]) (kw :aarch64/x1) (kw :aarch64/x2) (kw :aarch64/x3) (kw :aarch64/x4)))))

(defn capability-argument-registers [] [:list [:ref :mir.catalog/bank]]
  (-> (typed-list-new [:list [:ref :mir.catalog/bank]])
      (bank :x86-64 :i64 (-> (typed-list-new [:list :keyword]) (kw :x86-64/rdx)))
      (bank :x86-64 :string (-> (typed-list-new [:list :keyword]) (kw :x86-64/r8)))
      (bank :x86-64 :option-i64 (-> (typed-list-new [:list :keyword]) (kw :x86-64/r8)))
