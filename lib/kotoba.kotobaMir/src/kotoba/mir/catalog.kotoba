(defn- shape [out [:list [:ref :mir.catalog/shape]] operation :keyword keys [:list :keyword]]
  [:list [:ref :mir.catalog/shape]]
  (typed-list-conj [:list [:ref :mir.catalog/shape]] out (record-new [:ref :mir.catalog/shape] operation keys)))

