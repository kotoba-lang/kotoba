;; Owning canonical MIR contract data from 2653e5f1413812248c84c33598a67c8ea1e1a3af.
;; Full validator/selector/scheduler/allocator and all consumers remain in scope.
(ns kotoba.mir.catalog
  {:kotoba/export [version supported-versions targets physical-registers leaf-registers preserved-registers call-argument-registers runtime-argument-registers runtime-context-offsets capability-argument-registers capability-context-offsets return-registers instruction-keysets instruction-operations instruction-keys kernel-window-operations kernel-window-maxima slice-operations slice-item-limit kernel-atomic-ops kernel-dot-f32-maximum kernel-dequant-dot-operations kernel-dequant-dot-maximum registers-for offset-of shape-operation shape-keys bank-target bank-kind bank-registers offset-name offset-value privileged-argument-registers allocator-pool]}
  (:require [kotoba.gmir :as gmir] [kotoba.gmir.node :as node])
  (:schemas
   {:mir.catalog/bank [:record :mir.catalog/bank
      [[:target :keyword] [:kind :keyword] [:registers [:list :keyword]]]]
    :mir.catalog/offset [:record :mir.catalog/offset [[:name :keyword] [:offset :i64]]]
    :mir.catalog/shape [:record :mir.catalog/shape [[:operation :keyword] [:keys [:list :keyword]]]]}))

(defn version [] :i64 (arena-scope 3))
(defn slice-item-limit [] :i64 (arena-scope 1099511627776))
(defn kernel-dot-f32-maximum [] :i64 (arena-scope (gmir/kernel-dot-f32-maximum)))
(defn kernel-dequant-dot-maximum [] :i64 (arena-scope (gmir/kernel-dequant-dot-maximum)))

(defn- kw [out [:list :keyword] value :keyword] [:list :keyword]
  (typed-list-conj [:list :keyword] out value))
(defn- integer [out [:list :i64] value :i64] [:list :i64]
  (typed-list-conj [:list :i64] out value))

(defn supported-versions [] [:list :i64]
  (-> (typed-list-new [:list :i64])
      (integer 1)
      (integer 2)
      (integer 3)))

(defn targets [] [:list :keyword]
  (-> (typed-list-new [:list :keyword])
      (kw :x86-64)
      (kw :aarch64)))

(defn kernel-window-operations [] [:list :keyword]
  (-> (typed-list-new [:list :keyword])
      (kw :mir/kernel-load-u8)
      (kw :mir/kernel-store-u8)
      (kw :mir/kernel-load-u16)
      (kw :mir/kernel-store-u16)
      (kw :mir/kernel-load-u32)
      (kw :mir/kernel-store-u32)
      (kw :mir/kernel-load-u64)
      (kw :mir/kernel-store-u64)))

(defn kernel-window-maxima [] [:list :i64]
  (-> (typed-list-new [:list :i64])
      (integer 512)
      (integer 4096)
      (integer 16384)
      (integer 65536)))

(defn slice-operations [] [:list :keyword]
  (-> (typed-list-new [:list :keyword])
      (kw :mir/slice-load-u8)
      (kw :mir/slice-store-u8)
      (kw :mir/slice-load-u16)
      (kw :mir/slice-store-u16)
      (kw :mir/slice-load-u32)
      (kw :mir/slice-store-u32)
      (kw :mir/slice-load-u64)
      (kw :mir/slice-store-u64)))

(defn- bank [out [:list [:ref :mir.catalog/bank]] target :keyword kind :keyword registers [:list :keyword]]
  [:list [:ref :mir.catalog/bank]]
  (typed-list-conj [:list [:ref :mir.catalog/bank]] out (record-new [:ref :mir.catalog/bank] target kind registers)))

(defn physical-registers [] [:list [:ref :mir.catalog/bank]]
  (-> (typed-list-new [:list [:ref :mir.catalog/bank]])
      (bank :x86-64 :all (-> (typed-list-new [:list :keyword]) (kw :x86-64/rax) (kw :x86-64/rcx) (kw :x86-64/rdx) (kw :x86-64/r8)))
      (bank :aarch64 :all (-> (typed-list-new [:list :keyword]) (kw :aarch64/x0) (kw :aarch64/x1) (kw :aarch64/x2) (kw :aarch64/x3)))))

(defn leaf-registers [] [:list [:ref :mir.catalog/bank]]
  (-> (typed-list-new [:list [:ref :mir.catalog/bank]])
      (bank :x86-64 :all (-> (typed-list-new [:list :keyword]) (kw :x86-64/rdi) (kw :x86-64/rsi)))
      (bank :aarch64 :all (-> (typed-list-new [:list :keyword]) (kw :aarch64/x5) (kw :aarch64/x6) (kw :aarch64/x8) (kw :aarch64/x9) (kw :aarch64/x10) (kw :aarch64/x11) (kw :aarch64/x12)))))

(defn preserved-registers [] [:list [:ref :mir.catalog/bank]]
  (-> (typed-list-new [:list [:ref :mir.catalog/bank]])
      (bank :x86-64 :all (-> (typed-list-new [:list :keyword]) (kw :x86-64/rbx) (kw :x86-64/r12) (kw :x86-64/r13) (kw :x86-64/r14) (kw :x86-64/r15)))
      (bank :aarch64 :all (-> (typed-list-new [:list :keyword]) (kw :aarch64/x19) (kw :aarch64/x20) (kw :aarch64/x21) (kw :aarch64/x22) (kw :aarch64/x23) (kw :aarch64/x24) (kw :aarch64/x25) (kw :aarch64/x26)))))

(defn call-argument-registers [] [:list [:ref :mir.catalog/bank]]
  (-> (typed-list-new [:list [:ref :mir.catalog/bank]])
      (bank :x86-64 :all (-> (typed-list-new [:list :keyword]) (kw :x86-64/rdi) (kw :x86-64/rsi) (kw :x86-64/rdx) (kw :x86-64/rcx) (kw :x86-64/r8)))
      (bank :aarch64 :all (-> (typed-list-new [:list :keyword]) (kw :aarch64/x0) (kw :aarch64/x1) (kw :aarch64/x2) (kw :aarch64/x3) (kw :aarch64/x4)))))

(defn runtime-argument-registers [] [:list [:ref :mir.catalog/bank]]
  (-> (typed-list-new [:list [:ref :mir.catalog/bank]])
