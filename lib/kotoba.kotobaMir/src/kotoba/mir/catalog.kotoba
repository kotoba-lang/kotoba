      (bank :aarch64 :ui-event-v1 (-> (typed-list-new [:list :keyword]) (kw :aarch64/x4)))))

(defn return-registers [] [:list [:ref :mir.catalog/bank]]
  (-> (typed-list-new [:list [:ref :mir.catalog/bank]])
      (bank :x86-64 :all (-> (typed-list-new [:list :keyword]) (kw :x86-64/rax)))
      (bank :aarch64 :all (-> (typed-list-new [:list :keyword]) (kw :aarch64/x0)))))

(defn- offset [out [:list [:ref :mir.catalog/offset]] name :keyword value :i64] [:list [:ref :mir.catalog/offset]]
  (typed-list-conj [:list [:ref :mir.catalog/offset]] out (record-new [:ref :mir.catalog/offset] name value)))

(defn runtime-context-offsets [] [:list [:ref :mir.catalog/offset]]
  (-> (typed-list-new [:list [:ref :mir.catalog/offset]])
      (offset :pair 56)
      (offset :pair-first 64)
      (offset :pair-second 72)
      (offset :kgraph-assert! 80)
      (offset :kgraph-get 88)
      (offset :kgraph-count 96)
      (offset :kgraph-entity-at 104)
      (offset :string-byte-length 72)
