      (shape :mir/kernel-cmpxchg-u64 (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/index) (kw :mir/expected) (kw :mir/stored) (kw :mir/maximum)))
      (shape :mir/kernel-dot-f32 (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/second-base) (kw :mir/second-length) (kw :mir/count) (kw :mir/maximum)))
      (shape :mir/kernel-dequant-dot-q8-0 (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/second-base) (kw :mir/second-length) (kw :mir/count) (kw :mir/maximum)))
      (shape :mir/kernel-dequant-dot-q4-k (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/second-base) (kw :mir/second-length) (kw :mir/count) (kw :mir/maximum)))
      (shape :mir/kernel-dequant-dot-q6-k (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/second-base) (kw :mir/second-length) (kw :mir/count) (kw :mir/maximum)))
      (shape :mir/kernel-dequant-dot-iq4-xs (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/second-base) (kw :mir/second-length) (kw :mir/count) (kw :mir/maximum)))
      (shape :mir/kernel-dequant-dot-iq2-s (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/second-base) (kw :mir/second-length) (kw :mir/count) (kw :mir/maximum)))
      (shape :mir/kernel-dequant-dot-iq3-xxs (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/second-base) (kw :mir/second-length) (kw :mir/count) (kw :mir/maximum)))
      (shape :mir/kernel-dequant-dot-iq3-s (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/second-base) (kw :mir/second-length) (kw :mir/count) (kw :mir/maximum)))
      (shape :mir/kernel-dequant-dot-ptq1-0 (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/second-base) (kw :mir/second-length) (kw :mir/count) (kw :mir/maximum)))
      (shape :mir/kernel-subregion (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/offset) (kw :mir/size)))
      (shape :mir/equal (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right)))
      (shape :mir/less-than (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right)))
      (shape :mir/greater-than (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right)))
      (shape :mir/less-or-equal (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right)))
      (shape :mir/greater-or-equal (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right)))
      (shape :mir/spill-load (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/slot)))
      (shape :mir/spill-store (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/src) (kw :mir/slot)))
      (shape :mir/move (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/src)))
      (shape :mir/incoming-load (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/index)))
      (shape :mir/outgoing-argument (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/src) (kw :mir/index)))
      (shape :mir/incoming-argument-store (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/src) (kw :mir/index)))
      (shape :mir/reentry (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/parameters)))
      (shape :mir/recur (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/arguments)))
      (shape :mir/label (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/id)))
      (shape :mir/branch-zero (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/test) (kw :mir/target)))
      (shape :mir/branch-nonzero (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/test) (kw :mir/target)))
      (shape :mir/jump (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/target)))
      (shape :mir/phi (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/incomings)))
      (shape :mir/call (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/callee) (kw :mir/arguments)))
      (shape :mir/tail-call (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/callee) (kw :mir/arguments)))
      (shape :mir/runtime-call (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/runtime) (kw :mir/context-offset) (kw :mir/arguments)))
      (shape :mir/x86-privileged (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/action) (kw :mir/arguments)))
      (shape :mir/capability-call (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/capability) (kw :mir/kind) (kw :mir/context-offset) (kw :mir/arguments)))
      (shape :mir/return (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/value)))))

(defn bank-target [entry [:ref :mir.catalog/bank]] :keyword
  (record-get [:ref :mir.catalog/bank] entry :target))
(defn bank-kind [entry [:ref :mir.catalog/bank]] :keyword
  (record-get [:ref :mir.catalog/bank] entry :kind))
(defn bank-registers [entry [:ref :mir.catalog/bank]] [:list :keyword]
  (record-get [:ref :mir.catalog/bank] entry :registers))
(defn registers-for [table [:list [:ref :mir.catalog/bank]] target :keyword kind :keyword] [:option [:list :keyword]]
  (loop [index 0]
    (if (>= index (vector-count table)) (option-none-of [:option [:list :keyword]])
      (let [entry (typed-list-nth [:list [:ref :mir.catalog/bank]] table index)]
        (if (and (= (bank-target entry) target) (= (bank-kind entry) kind))
          (option-some-of [:option [:list :keyword]] (bank-registers entry)) (recur (+ index 1)))))))
(defn offset-name [entry [:ref :mir.catalog/offset]] :keyword
  (record-get [:ref :mir.catalog/offset] entry :name))
(defn offset-value [entry [:ref :mir.catalog/offset]] :i64
  (arena-scope (record-get [:ref :mir.catalog/offset] entry :offset)))
(defn offset-of [table [:list [:ref :mir.catalog/offset]] name :keyword] [:option :i64]
  (loop [index 0]
    (if (>= index (vector-count table)) (option-none-of [:option :i64])
      (let [entry (typed-list-nth [:list [:ref :mir.catalog/offset]] table index)]
        (if (= (offset-name entry) name) (option-some-of [:option :i64] (offset-value entry)) (recur (+ index 1)))))))
(defn shape-operation [entry [:ref :mir.catalog/shape]] :keyword
  (record-get [:ref :mir.catalog/shape] entry :operation))
(defn shape-keys [entry [:ref :mir.catalog/shape]] [:list :keyword]
  (record-get [:ref :mir.catalog/shape] entry :keys))
(defn- mir-operations [values [:list :keyword]] [:list :keyword]
  (loop [index 0 out (typed-list-new [:list :keyword])]
    (if (>= index (vector-count values)) out
      (recur (+ index 1) (kw out (keyword-from-string (string-concat "mir/"
        (keyword-name (typed-list-nth [:list :keyword] values index)))))))))
(defn kernel-atomic-ops [] [:list :keyword] (mir-operations (gmir/kernel-atomic-ops)))
(defn kernel-dequant-dot-operations [] [:list :keyword] (mir-operations (gmir/kernel-dequant-dot-operations)))
(defn- concatenate [left [:list :keyword] right [:list :keyword]] [:list :keyword]
  (loop [index 0 out left]
    (if (>= index (vector-count right)) out
      (recur (+ index 1) (kw out (typed-list-nth [:list :keyword] right index))))))
(defn- known-or-empty [table [:list [:ref :mir.catalog/bank]] target :keyword] [:list :keyword]
  (option-match [:option [:list :keyword]] (registers-for table target :all) (typed-list-new [:list :keyword]) found-value found-value))

;; These two public derived queries retain the reference's empty concatenation
;; for unknown targets. They do not admit a target/program. The whole MIR
;; validator/selector must still reject unsupported targets before codegen.
(defn privileged-argument-registers [target :keyword] [:list :keyword]
  (concatenate (known-or-empty (physical-registers) target) (known-or-empty (preserved-registers) target)))
(defn- truthy? [value [:ref :gmir.node/value]] :bool
  (arena-scope (and (not= (node/kind value) :nil) (not (and (= (node/kind value) :bool) (= (node/number value) 0))))))
(defn allocator-pool [target :keyword options [:ref :gmir.node/value]] [:list :keyword]
  (let [scratch (known-or-empty (physical-registers) target)
        leaf (if (truthy? (node/key options :leaf?)) (known-or-empty (leaf-registers) target) (typed-list-new [:list :keyword]))]
    (concatenate (concatenate scratch leaf) (known-or-empty (preserved-registers) target))))


;; Canonical names only: validators need not allocate every keyset for a lookup.
(defn instruction-operations [] [:list :keyword]
  (-> (typed-list-new [:list :keyword])
      (kw :mir/argument)
      (kw :mir/constant)
      (kw :mir/data-address)
      (kw :mir/rodata-address)
      (kw :mir/function-address)
      (kw :mir/add)
      (kw :mir/subtract)
      (kw :mir/multiply)
      (kw :mir/multiply-add)
      (kw :mir/multiply-subtract)
      (kw :mir/quotient)
      (kw :mir/quotient-constant)
      (kw :mir/bit-and)
      (kw :mir/bit-or)
      (kw :mir/bit-xor)
      (kw :mir/shift-left)
      (kw :mir/shift-right-signed)
      (kw :mir/shift-right-unsigned)
      (kw :mir/f64-add)
      (kw :mir/f64-subtract)
      (kw :mir/f64-multiply)
      (kw :mir/f64-divide)
      (kw :mir/f64-min)
      (kw :mir/f64-max)
      (kw :mir/f64-sqrt)
      (kw :mir/f64-equal)
      (kw :mir/f64-less-than)
      (kw :mir/f64-less-or-equal)
      (kw :mir/f64-greater-than)
      (kw :mir/f64-greater-or-equal)
      (kw :mir/f64-unordered)
      (kw :mir/f32-add)
      (kw :mir/f32-subtract)
      (kw :mir/f32-multiply)
      (kw :mir/f32-divide)
      (kw :mir/f32-sqrt)
      (kw :mir/f32-equal)
      (kw :mir/f32-less-than)
      (kw :mir/f32-less-or-equal)
      (kw :mir/f32-greater-than)
      (kw :mir/f32-greater-or-equal)
      (kw :mir/f32-unordered)
      (kw :mir/f32-to-f64)
      (kw :mir/f64-to-f32)
      (kw :mir/i64-to-f32)
      (kw :mir/i64-to-f64)
      (kw :mir/kernel-load-u8)
      (kw :mir/kernel-store-u8)
      (kw :mir/kernel-load-u32)
      (kw :mir/kernel-store-u32)
      (kw :mir/kernel-load-u16)
      (kw :mir/kernel-store-u16)
      (kw :mir/kernel-load-u64)
      (kw :mir/kernel-store-u64)
      (kw :mir/slice-load-u8)
      (kw :mir/slice-store-u8)
      (kw :mir/slice-load-u16)
      (kw :mir/slice-store-u16)
      (kw :mir/slice-load-u32)
      (kw :mir/slice-store-u32)
      (kw :mir/slice-load-u64)
      (kw :mir/slice-store-u64)
      (kw :mir/kernel-try-lock-u32)
      (kw :mir/kernel-unlock-u32)
      (kw :mir/kernel-atomic-add-u32)
      (kw :mir/kernel-atomic-add-u64)
      (kw :mir/kernel-xchg-u32)
      (kw :mir/kernel-xchg-u64)
      (kw :mir/kernel-cmpxchg-u32)
      (kw :mir/kernel-cmpxchg-u64)
      (kw :mir/kernel-dot-f32)
      (kw :mir/kernel-dequant-dot-q8-0)
      (kw :mir/kernel-dequant-dot-q4-k)
      (kw :mir/kernel-dequant-dot-q6-k)
      (kw :mir/kernel-dequant-dot-iq4-xs)
      (kw :mir/kernel-dequant-dot-iq2-s)
      (kw :mir/kernel-dequant-dot-iq3-xxs)
      (kw :mir/kernel-dequant-dot-iq3-s)
      (kw :mir/kernel-dequant-dot-ptq1-0)
      (kw :mir/kernel-subregion)
      (kw :mir/equal)
      (kw :mir/less-than)
      (kw :mir/greater-than)
      (kw :mir/less-or-equal)
      (kw :mir/greater-or-equal)
      (kw :mir/spill-load)
      (kw :mir/spill-store)
      (kw :mir/move)
      (kw :mir/incoming-load)
      (kw :mir/outgoing-argument)
      (kw :mir/incoming-argument-store)
      (kw :mir/reentry)
      (kw :mir/recur)
      (kw :mir/label)
      (kw :mir/branch-zero)
      (kw :mir/branch-nonzero)
      (kw :mir/jump)
      (kw :mir/phi)
      (kw :mir/call)
      (kw :mir/tail-call)
      (kw :mir/runtime-call)
      (kw :mir/x86-privileged)
      (kw :mir/capability-call)
      (kw :mir/return)
  ))
(defn instruction-keys [operation :keyword] [:list :keyword]
  (case operation
    :mir/argument (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/index))
    :mir/constant (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/value))
    :mir/data-address (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/content))
    :mir/rodata-address (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/content) (kw :mir/rodata-encoding))
    :mir/function-address (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/function))
    :mir/add (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/subtract (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/multiply (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/multiply-add (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right) (kw :mir/addend))
    :mir/multiply-subtract (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right) (kw :mir/addend))
    :mir/quotient (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/quotient-constant (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/divisor))
    :mir/bit-and (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/bit-or (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/bit-xor (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/shift-left (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/shift-right-signed (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/shift-right-unsigned (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f64-add (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f64-subtract (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f64-multiply (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f64-divide (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f64-min (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f64-max (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f64-sqrt (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/input))
    :mir/f64-equal (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f64-less-than (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f64-less-or-equal (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f64-greater-than (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f64-greater-or-equal (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f64-unordered (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f32-add (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f32-subtract (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f32-multiply (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f32-divide (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f32-sqrt (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/input))
    :mir/f32-equal (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f32-less-than (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f32-less-or-equal (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f32-greater-than (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f32-greater-or-equal (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f32-unordered (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/left) (kw :mir/right))
    :mir/f32-to-f64 (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/input))
    :mir/f64-to-f32 (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/input))
    :mir/i64-to-f32 (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/input))
    :mir/i64-to-f64 (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/input))
    :mir/kernel-load-u8 (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/index) (kw :mir/maximum))
    :mir/kernel-store-u8 (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/index) (kw :mir/stored) (kw :mir/maximum))
    :mir/kernel-load-u32 (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/index) (kw :mir/maximum))
    :mir/kernel-store-u32 (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/index) (kw :mir/stored) (kw :mir/maximum))
    :mir/kernel-load-u16 (-> (typed-list-new [:list :keyword]) (kw :mir/op) (kw :mir/dst) (kw :mir/base) (kw :mir/length) (kw :mir/index) (kw :mir/maximum))
