;; Owning all-vreg fallback. The linear scanner remains the primary policy.
;; Only the reference's explicit spill-operation families are admitted here.
(ns kotoba.mir.allocator-spill
  {:kotoba/export [allocate call-registers physicalize-call]}
  (:require [kotoba.gmir.node :as node] [kotoba.mir.table :as table]
            [kotoba.mir.allocator-data :as data] [kotoba.mir.allocator-cfg :as cfg]
            [kotoba.mir.operands :as operands] [kotoba.mir.catalog :as catalog]
            [kotoba.mir.flat :as flat] [kotoba.mir.outcome :as outcome]))
(defn- ins [op :keyword] [:ref :gmir.node/value] (node/put-key (node/empty-map) :mir/op (node/keyword-literal op)))
(defn- bank [target :keyword banks [:list [:ref :mir.catalog/bank]] kind :keyword] [:ref :gmir.node/value]
  (let [values (option-match [:option [:list :keyword]] (catalog/registers-for banks target kind) (typed-list-new [:list :keyword]) found-value found-value)]
    (loop [index 0 out (node/empty-vector)]
      (if (>= index (vector-count values)) out
        (recur (+ index 1) (node/append out (node/keyword-literal (typed-list-nth [:list :keyword] values index))))))))
(defn call-registers [target :keyword instruction [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (cond (data/op? instruction :mir/runtime-call) (bank target (catalog/runtime-argument-registers) :all)
        (data/op? instruction :mir/capability-call)
        (let [all (catalog/capability-argument-registers)]
          (loop [index 0]
            (if (>= index (vector-count all)) (node/empty-vector)
              (let [row (typed-list-nth [:list [:ref :mir.catalog/bank]] all index)]
                (if (and (= (catalog/bank-target row) target) (data/named? (node/key instruction :mir/kind) (catalog/bank-kind row)))
                  (bank target all (catalog/bank-kind row)) (recur (+ index 1)))))))
        :else (bank target (catalog/call-argument-registers) :all)))
(defn physicalize-call [instruction [:ref :gmir.node/value] registers [:ref :gmir.node/value] result [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (let [op (node/key instruction :mir/op) base (-> (node/empty-map) (node/put-key :mir/op op) (node/put-key :mir/arguments registers))
        dst (if (data/op? instruction :mir/tail-call) base (node/put-key base :mir/dst result))]
    (cond (or (data/op? instruction :mir/call) (data/op? instruction :mir/tail-call)) (node/put-key dst :mir/callee (node/key instruction :mir/callee))
          (data/op? instruction :mir/runtime-call)
          (-> dst (node/put-key :mir/runtime (node/key instruction :mir/runtime)) (node/put-key :mir/context-offset (node/key instruction :mir/context-offset)))
          :else (-> dst (node/put-key :mir/capability (node/key instruction :mir/capability)) (node/put-key :mir/kind (node/key instruction :mir/kind))
                       (node/put-key :mir/context-offset (node/key instruction :mir/context-offset))))))
(defn- binary? [op [:ref :gmir.node/value]] :bool
  (arena-scope (or (data/named? op :mir/add) (data/named? op :mir/subtract) (data/named? op :mir/multiply) (data/named? op :mir/quotient)
      (data/named? op :mir/bit-and) (data/named? op :mir/bit-or) (data/named? op :mir/bit-xor)
      (data/named? op :mir/shift-left) (data/named? op :mir/shift-right-signed) (data/named? op :mir/shift-right-unsigned)
      (data/named? op :mir/f64-add) (data/named? op :mir/f64-subtract) (data/named? op :mir/f64-multiply) (data/named? op :mir/f64-divide)
      (data/named? op :mir/f64-min) (data/named? op :mir/f64-max) (data/named? op :mir/f64-equal) (data/named? op :mir/f64-less-than)
      (data/named? op :mir/f64-less-or-equal) (data/named? op :mir/f64-greater-than) (data/named? op :mir/f64-greater-or-equal) (data/named? op :mir/f64-unordered)
      (data/named? op :mir/f32-add) (data/named? op :mir/f32-subtract) (data/named? op :mir/f32-multiply) (data/named? op :mir/f32-divide)
      (data/named? op :mir/f32-equal) (data/named? op :mir/f32-less-than) (data/named? op :mir/f32-less-or-equal)
      (data/named? op :mir/f32-greater-than) (data/named? op :mir/f32-greater-or-equal) (data/named? op :mir/f32-unordered)
      (data/named? op :mir/equal) (data/named? op :mir/less-than) (data/named? op :mir/greater-than)
      (data/named? op :mir/less-or-equal) (data/named? op :mir/greater-or-equal))))
(defn- unary? [op [:ref :gmir.node/value]] :bool
  (arena-scope (or (data/named? op :mir/f64-sqrt) (data/named? op :mir/f32-sqrt) (data/named? op :mir/f32-to-f64)
      (data/named? op :mir/f64-to-f32) (data/named? op :mir/i64-to-f32) (data/named? op :mir/i64-to-f64))))
(defn- load? [op [:ref :gmir.node/value]] :bool
  (arena-scope (or (data/named? op :mir/kernel-load-u8) (data/named? op :mir/kernel-load-u16) (data/named? op :mir/kernel-load-u32) (data/named? op :mir/kernel-load-u64)
      (data/named? op :mir/slice-load-u8) (data/named? op :mir/slice-load-u16) (data/named? op :mir/slice-load-u32) (data/named? op :mir/slice-load-u64)
      (data/named? op :mir/kernel-try-lock-u32) (data/named? op :mir/kernel-unlock-u32))))
(defn- store? [op [:ref :gmir.node/value]] :bool
  (arena-scope (or (data/named? op :mir/kernel-store-u8) (data/named? op :mir/kernel-store-u16) (data/named? op :mir/kernel-store-u32) (data/named? op :mir/kernel-store-u64)
      (data/named? op :mir/slice-store-u8) (data/named? op :mir/slice-store-u16) (data/named? op :mir/slice-store-u32) (data/named? op :mir/slice-store-u64))))
(defn- atomic? [op [:ref :gmir.node/value]] :bool
  (arena-scope (or (data/named? op :mir/kernel-atomic-add-u32) (data/named? op :mir/kernel-atomic-add-u64)
      (data/named? op :mir/kernel-xchg-u32) (data/named? op :mir/kernel-xchg-u64))))
(defn- compare-exchange? [op [:ref :gmir.node/value]] :bool (arena-scope (or (data/named? op :mir/kernel-cmpxchg-u32) (data/named? op :mir/kernel-cmpxchg-u64))))
(defn- dot? [op [:ref :gmir.node/value]] :bool
  (arena-scope (or (data/named? op :mir/kernel-dot-f32) (data/named? op :mir/kernel-dequant-dot-q8-0)
      (data/named? op :mir/kernel-dequant-dot-q4-k) (data/named? op :mir/kernel-dequant-dot-q6-k))))
(defn- fields [a :keyword b :keyword c :keyword d :keyword e :keyword count :i64] [:list :keyword]
  (loop [index 0 out (typed-list-new [:list :keyword])]
    (if (>= index count) out
      (recur (+ index 1) (typed-list-conj [:list :keyword] out (case index 0 a 1 b 2 c 3 d e))))))
(defn- mapped [instruction [:ref :gmir.node/value] keys [:list :keyword] registers [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (loop [index 0 out instruction]
    (if (>= index (vector-count keys)) out
      (recur (+ index 1) (node/put-key out (typed-list-nth [:list :keyword] keys index) (data/at registers index))))))
(defn- loads [instruction [:ref :gmir.node/value] values [:ref :gmir.node/value] registers [:ref :gmir.node/value] slots [:ref :mir.table/tree]]
  [:result [:ref :gmir.node/value] [:ref :mir/refusal]]
  (loop [index 0 out (node/empty-vector)]
    (if (>= index (node/child-count values)) (result-ok-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] out)
      (let [key (operands/key-of (data/at values index))]
        (if (not (data/present? slots key)) (result-err-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (outcome/refusal :use-before-definition instruction))
          (recur (+ index 1) (node/append out (-> (ins :mir/spill-load) (node/put-key :mir/dst (data/at registers index))
            (node/put-key :mir/slot (data/lookup slots key))))))))))
(defn- finish [instruction [:ref :gmir.node/value] prefix [:ref :gmir.node/value] allocated [:ref :gmir.node/value]
               slots [:ref :mir.table/tree] register [:ref :gmir.node/value]] [:result [:ref :gmir.node/value] [:ref :mir/refusal]]
  (let [dst (node/key instruction :mir/dst) key (operands/key-of dst)]
    (if (not (data/present? slots key)) (result-err-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (outcome/refusal :use-before-definition instruction))
      (result-ok-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]]
        (-> prefix (node/append allocated) (node/append (-> (ins :mir/spill-store) (node/put-key :mir/src register) (node/put-key :mir/slot (data/lookup slots key)))))))))
(defn- ordinary [instruction [:ref :gmir.node/value] fields [:list :keyword] registers [:ref :gmir.node/value] slots [:ref :mir.table/tree] dst [:ref :gmir.node/value]]
  [:result [:ref :gmir.node/value] [:ref :mir/refusal]]
  (let [values (loop [index 0 out (node/empty-vector)]
                 (if (>= index (vector-count fields)) out (recur (+ index 1) (node/append out (node/key instruction (typed-list-nth [:list :keyword] fields index))))))
        loaded (loads instruction values registers slots)]
    (if (not (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] loaded)) loaded
      (finish instruction (result-value-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] loaded (node/empty-vector))
        (node/put-key (mapped instruction fields registers) :mir/dst dst) slots dst))))
(defn- rewrite [target :keyword instruction [:ref :gmir.node/value] slots [:ref :mir.table/tree] merge-dst [:ref :mir.table/tree]]
  [:result [:ref :gmir.node/value] [:ref :mir/refusal]]
  (let [op (node/key instruction :mir/op) scratch (bank target (catalog/physical-registers) :all) r0 (data/at scratch 0)
        args (bank target (catalog/call-argument-registers) :all)]
    (cond
      (data/op? instruction :mir/merge-load) (result-ok-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (node/empty-vector))
      (or (data/op? instruction :mir/label) (data/op? instruction :mir/jump))
      (result-ok-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (node/append (node/empty-vector) instruction))
      (data/op? instruction :mir/argument)
      (let [index (node/number (node/key instruction :mir/index))]
        (if (or (< index 0) (>= index (node/child-count args)))
          (result-err-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (outcome/refusal :argument-index-invalid instruction))
          (finish instruction (node/empty-vector) (node/put-key instruction :mir/dst (data/at args index)) slots (data/at args index))))
      (or (data/op? instruction :mir/constant) (data/op? instruction :mir/data-address)
          (data/op? instruction :mir/rodata-address) (data/op? instruction :mir/function-address))
      (finish instruction (node/empty-vector) (node/put-key instruction :mir/dst r0) slots r0)
      (data/op? instruction :mir/merge-store)
      (let [dst (data/lookup merge-dst (table/index-key (node/number (node/key instruction :mir/slot))))
            loaded (loads instruction (node/append (node/empty-vector) (node/key instruction :mir/src)) scratch slots)]
        (cond (= (node/kind dst) :nil) (result-err-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (outcome/refusal :unknown-merge-slot instruction))
              (not (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] loaded)) loaded
              (not (data/present? slots (operands/key-of dst)))
              (result-err-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (outcome/refusal :use-before-definition instruction))
              :else (result-ok-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]]
                (node/append (result-value-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] loaded (node/empty-vector))
                  (-> (ins :mir/spill-store) (node/put-key :mir/src r0) (node/put-key :mir/slot (data/lookup slots (operands/key-of dst))))))))
      (data/op? instruction :mir/quotient-constant) (ordinary instruction (fields :mir/left :unused :unused :unused :unused 1) scratch slots r0)
      (binary? op) (ordinary instruction (fields :mir/left :mir/right :unused :unused :unused 2) scratch slots r0)
      (unary? op) (ordinary instruction (fields :mir/input :unused :unused :unused :unused 1) scratch slots r0)
      (load? op) (ordinary instruction (fields :mir/base :mir/length :mir/index :unused :unused 3) scratch slots r0)
      (or (store? op) (atomic? op)) (ordinary instruction (fields :mir/base :mir/length :mir/index :mir/stored :unused 4) scratch slots (if (store? op) (data/at scratch 3) r0))
      (compare-exchange? op) (ordinary instruction (fields :mir/base :mir/length :mir/index :mir/expected :mir/stored 5) args slots (data/at args 0))
      (dot? op) (ordinary instruction (fields :mir/base :mir/length :mir/second-base :mir/second-length :mir/count 5) args slots (data/at args 0))
      (data/op? instruction :mir/kernel-subregion) (ordinary instruction (fields :mir/base :mir/length :mir/offset :mir/size :unused 4) scratch slots r0)
      (or (data/op? instruction :mir/branch-zero) (data/op? instruction :mir/branch-nonzero) (data/op? instruction :mir/return))
      (let [key (if (data/op? instruction :mir/return) :mir/value :mir/test)
            loaded (loads instruction (node/append (node/empty-vector) (node/key instruction key)) scratch slots)]
        (if (not (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] loaded)) loaded
          (result-ok-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]]
            (node/append (result-value-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] loaded (node/empty-vector)) (node/put-key instruction key r0)))))
      (or (data/op? instruction :mir/x86-privileged) (data/op? instruction :mir/call) (data/op? instruction :mir/tail-call)
          (data/op? instruction :mir/runtime-call) (data/op? instruction :mir/capability-call))
      (let [privileged (data/op? instruction :mir/x86-privileged) arguments (node/key instruction :mir/arguments)
            available (if privileged
              (let [all (catalog/privileged-argument-registers target)]
                (loop [index 0 out (node/empty-vector)]
                  (if (>= index (vector-count all)) out (recur (+ index 1) (node/append out (node/keyword-literal (typed-list-nth [:list :keyword] all index)))))))
              (call-registers target instruction))
            registers (data/slice available 0 (node/child-count arguments)) loaded (loads instruction arguments registers slots)
            result-register (if privileged r0 (data/at (bank target (catalog/return-registers) :all) 0))]
        (if (not (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] loaded)) loaded
          (let [prefix (result-value-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] loaded (node/empty-vector))
                allocated (if privileged (-> (ins :mir/x86-privileged) (node/put-key :mir/dst r0) (node/put-key :mir/action (node/key instruction :mir/action)) (node/put-key :mir/arguments registers))
                            (physicalize-call instruction registers result-register))]
            (if (data/op? instruction :mir/tail-call) (result-ok-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (node/append prefix allocated))
              (finish instruction prefix allocated slots result-register)))))
      :else (result-err-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (outcome/refusal :unsupported-spill-operation instruction)))))
(defn allocate [program [:ref :gmir.node/value] merge-dst [:ref :mir.table/tree]] [:result [:ref :gmir.node/value] [:ref :mir/refusal]]
  (let [code (node/key program :mir/instructions) checked (cfg/spill-slots code 0 merge-dst)]
    (if (not (result-ok?-of [:result [:ref :mir.table/tree] [:ref :mir/refusal]] checked))
      (result-err-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]]
        (result-error-of [:result [:ref :mir.table/tree] [:ref :mir/refusal]] checked (outcome/refusal :unexpected-slot-result program)))
      (let [slots (result-value-of [:result [:ref :mir.table/tree] [:ref :mir/refusal]] checked (table/empty))
            slot-count (loop [index 0 maximum -1]
                         (if (>= index (table/count slots)) (+ maximum 1)
                           (let [value (data/get-number slots (data/key-at slots index) -1)]
                             (recur (+ index 1) (if (> value maximum) value maximum)))))
            target (if (data/named? (node/key program :mir/target) :x86-64) :x86-64 :aarch64)]
        (if (> slot-count 4095) (result-err-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]]
          (outcome/refusal :spill-frame-too-large (node/put-key (node/empty-map) :frame-slots (node/i64-value slot-count))))
          (loop [index 0 out (node/empty-vector)]
            (if (>= index (node/child-count code))
              (flat/validate! (-> program (node/put-key :mir/registers (node/keyword-literal :physical))
                                         (node/put-key :mir/frame-slots (node/i64-value slot-count)) (node/put-key :mir/instructions out)))
              (let [result (rewrite target (data/at code index) slots merge-dst)]
                (if (not (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result)) result
                  (recur (+ index 1) (data/append-all out (result-value-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result (node/empty-vector)))))))))))))
