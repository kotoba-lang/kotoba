(ns kotoba.mir
  "Closed target-selected Machine IR and deterministic allocation."
  {:kotoba/export [allocate-registers allocate-registers-result allocator-pool call-argument-registers capability-argument-registers capability-context-offsets counted-self-recur-plan counted-self-recur-plans counted-self-recur-plans-result instruction-keysets kernel-atomic-ops kernel-dequant-dot-maximum kernel-dequant-dot-operations kernel-dot-f32-maximum kernel-window-maxima kernel-window-operations leaf-registers physical-registers preserved-registers privileged-argument-registers return-registers runtime-argument-registers runtime-context-offsets saved-registers select-target select-target-result slice-item-limit slice-operations supported-versions targets validate! validate-problem version]}
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]}))
  (:require #?@(:kotoba [[kotoba.form :as form]] :default [[kotoba.lang.coll :as set]])
            [kotoba.gmir :as gmir]))

#?(:kotoba
   ;; keyword-keyed lookups scan the kids without building a key Form (as kotoba.native.machine-ir's kslot)
   (defn- kslot [m [:ref :form/r] k :keyword] :i64
     (let [xs (form/kids-of m) n (vector-count xs)]
       (loop [j 0]
         (if (>= (+ j 1) n) -1
           (let [x (typed-list-nth [:list [:ref :form/r]] xs j)]
             (if (and (form/is-keyword? x) (= (form/keyword-value x) k)) j (recur (+ j 2)))))))))

#?(:kotoba
   (defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r]
     (let [j (kslot m k)] (if (< j 0) (form/nil-form) (typed-list-nth [:list [:ref :form/r]] (form/kids-of m) (+ j 1))))))

#?(:kotoba
   (defn- fhas? [m [:ref :form/r] k :keyword] :bool (>= (kslot m k) 0)))

#?(:kotoba
   (defn- kw-of [f [:ref :form/r]] :keyword
     (if (form/is-keyword? f) (form/keyword-value f) :none)))

#?(:kotoba
   (defn- kw? [f [:ref :form/r] k :keyword] :bool
     (and (form/is-keyword? f) (= (form/keyword-value f) k))))

#?(:kotoba
   (defn- int-eq? [f [:ref :form/r] n :i64] :bool
     (and (form/is-int? f) (= (form/int-value f) n))))

#?(:kotoba
   (defn- int-in? [f [:ref :form/r] lo :i64 hi :i64] :bool
     (and (form/is-int? f) (<= lo (form/int-value f)) (<= (form/int-value f) hi))))

#?(:kotoba
   (defn- member-of? [xs [:ref :form/r] x [:ref :form/r]] :bool
     (let [kids (form/kids-of xs)
           n (vector-count kids)]
       (loop [i 0]
         (if (>= i n) false
           (if (form/eq (typed-list-nth [:list [:ref :form/r]] kids i) x) true (recur (inc i))))))))

#?(:kotoba
   (defn- tier [table [:ref :form/r] target [:ref :form/r]] [:list [:ref :form/r]]
     (form/kids-of (form/form-get table target))))

#?(:kotoba
   (defn- mentions? [f [:ref :form/r] r [:ref :form/r]] :bool
     (if (form/eq f r)
       true
       (let [kids (form/kids-of f)
             n (vector-count kids)]
         (loop [i 0]
           (if (>= i n) false
             (if (mentions? (typed-list-nth [:list [:ref :form/r]] kids i) r) true (recur (inc i)))))))))

#?(:kotoba
   (defn- reject! [problem :keyword] :i64
     ;; The host's error carries the offending instruction; the twin, the problem.
     (throw (ex-info "MIR rejected" {:phase :mir :problem problem}))))

#?(:kotoba
   (defn version [] :i64 3)
   :default
(def version 3))

#?(:kotoba
   (defn supported-versions [] [:ref :form/r] (form/edn-form "#{1 2 3}"))
   :default
(def supported-versions #{1 2 3}))

#?(:kotoba
   (defn targets [] [:ref :form/r] (form/edn-form "#{:x86-64 :aarch64}"))
   :default
(def targets #{:x86-64 :aarch64}))

#?(:kotoba
   (defn physical-registers [] [:ref :form/r] (form/edn-form "{:x86-64 [:x86-64/rax :x86-64/rcx :x86-64/rdx :x86-64/r8] :aarch64 [:aarch64/x0 :aarch64/x1 :aarch64/x2 :aarch64/x3]}"))
   :default
(def physical-registers
  "The always-available scratch tier. Every allocation path may use these, and
  the conservative all-vreg path uses only these."
  {:x86-64 [:x86-64/rax :x86-64/rcx :x86-64/rdx :x86-64/r8]
   :aarch64 [:aarch64/x0 :aarch64/x1 :aarch64/x2 :aarch64/x3]}))

#?(:kotoba
   (defn leaf-registers [] [:ref :form/r] (form/edn-form "{:x86-64 [:x86-64/rdi :x86-64/rsi] :aarch64 [:aarch64/x5 :aarch64/x6 :aarch64/x8 :aarch64/x9 :aarch64/x10 :aarch64/x11 :aarch64/x12]}"))
   :default
(def leaf-registers
  "Caller-saved registers a function that calls nothing may use without saving
  anything. On x86-64 these are the incoming argument registers, dead once the
  entry plan has copied the arguments out; on AArch64 they are the temporaries
  below the encoder's own scratch pair. A function that makes a call must not
  use them, so only the no-call paths are offered this tier."
  {:x86-64 [:x86-64/rdi :x86-64/rsi]
   :aarch64 [:aarch64/x5 :aarch64/x6 :aarch64/x8 :aarch64/x9
             :aarch64/x10 :aarch64/x11 :aarch64/x12]}))

#?(:kotoba
   (defn preserved-registers [] [:ref :form/r] (form/edn-form "{:x86-64 [:x86-64/rbx :x86-64/r12 :x86-64/r13 :x86-64/r14 :x86-64/r15] :aarch64 [:aarch64/x19 :aarch64/x20 :aarch64/x21 :aarch64/x22 :aarch64/x23 :aarch64/x24 :aarch64/x25 :aarch64/x26]}"))
   :default
(def preserved-registers
  "Callee-saved registers. Available on every path, at the cost of a save and a
  restore in the frame for exactly the ones a function actually assigns --
  which is why allocation reports them rather than the frame guessing."
  {:x86-64 [:x86-64/rbx :x86-64/r12 :x86-64/r13 :x86-64/r14 :x86-64/r15]
   :aarch64 [:aarch64/x19 :aarch64/x20 :aarch64/x21 :aarch64/x22
             :aarch64/x23 :aarch64/x24 :aarch64/x25 :aarch64/x26]}))

#?(:kotoba
   (defn privileged-argument-registers [target [:ref :form/r]] [:ref :form/r]
     (form/form-vec (form/append-many (tier (physical-registers) target)
                                      (tier (preserved-registers) target))))
   :default
(defn privileged-argument-registers
  "boot-lit: the registers the conservative expansion may hand a privileged
  action's operands, in order. The scratch tier first -- an action narrow
  enough to stay inside it costs no frame save -- then the preserved tier,
  which is callee-saved under Microsoft x64 as well as under the internal ABI.

  That second half is what makes `:uefi-call6` possible at all: its eight
  operands do not fit in four registers, and an operand held in a caller-saved
  register would not survive the firmware call it is an operand to.

  Derived rather than written out, so it stays as wide as the two tiers are.
  `x86-privileged-action-arities`'s widest entry has to fit; the suite asserts
  that it does rather than trusting the arithmetic."
  [target]
  (vec (concat (get physical-registers target)
               (get preserved-registers target)))))

#?(:kotoba
   (defn allocator-pool [target [:ref :form/r] options [:ref :form/r]] [:ref :form/r]
     (form/form-vec
      (form/append-many
       (if (let [lf (fget options :leaf?)] (not (or (form/is-nil? lf) (and (form/is-bool? lf) (= 0 (form/int-value lf))))))
         (form/append-many (tier (physical-registers) target) (tier (leaf-registers) target))
         (tier (physical-registers) target))
       (tier (preserved-registers) target))))
   :default
(defn allocator-pool
  "The registers an allocation path may hand out. The scratch tier comes first
  so that a function small enough to stay inside it costs no frame save; the
  preserved tier comes last for the same reason."
  [target {:keys [leaf?]}]
  (vec (concat (get physical-registers target)
               (when leaf? (get leaf-registers target))
               (get preserved-registers target)))))

#?(:kotoba
   (defn- x86-quotient-steered-pool [leaf? :bool] [:ref :form/r]
     (form/form-vec
      (form/append-many
       (form/append-many (form/two-forms (form/keyword-form :x86-64/rcx) (form/keyword-form :x86-64/r8))
                         (if leaf? (tier (leaf-registers) (form/keyword-form :x86-64)) (form/no-forms)))
       (tier (preserved-registers) (form/keyword-form :x86-64)))))
   :default
(defn- x86-quotient-steered-pool
  "The x86-64 pool with RAX and RDX removed.

  `imul r10` inside every constant division writes RDX:RAX, so a value the
  allocator parks there is saved and restored around each quotient -- four
  stack operations a time, thirty-two per narrow-kernel call, measured as the
  largest x86 mechanism behind the gcc deficit (amu
  docs/codegen-coscientist.md, iterations 40-42). An earlier version only
  DEMOTED the pair, arguing that under pressure the extra capacity was worth
  the saves; the hardware counters refuted that (iteration 48: kernel_deep
  retires at IPC 5.74 -- the retire width is the wall, and every value parked
  in RAX/RDX buys its residency with four stack operations per quotient it
  crosses, where a spill slot pays two moves once). Under exclusion the
  pressure lands on spill slots instead and every quotient's saves elide.
  Leaf functions only: the call paths split pools by POSITION in
  `rebuild-pool-lists`, and a reordered prefix would misclassify the tiers
  there."
  [leaf?]
  (vec (concat [:x86-64/rcx :x86-64/r8]
               (when leaf? (get leaf-registers :x86-64))
               (get preserved-registers :x86-64)))))

#?(:kotoba
   (defn saved-registers [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [pres (tier (preserved-registers) target)
           n (vector-count pres)]
       (form/form-vec
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (let [r (typed-list-nth [:list [:ref :form/r]] pres i)]
              (recur (inc i) (if (mentions? instructions r) (form/append-form acc r) acc))))))))
   :default
(defn saved-registers
  "Which preserved registers a physical instruction sequence names, in pool
  order, so a frame can save them in order and restore them in reverse.

  Derived rather than carried: a field saying which registers a body uses has
  to be kept equal to the body, and the two drift silently in the direction
  that omits a save. Encoders call this on the stream they are about to emit."
  [target instructions]
  (let [preserved (set (get preserved-registers target))]
    (into []
          (filter (into #{} (mapcat (fn [instruction]
                                      (filter preserved
                                              (tree-seq coll? seq instruction)))
                                    instructions)))
          (get preserved-registers target)))))

#?(:kotoba
   (defn call-argument-registers [] [:ref :form/r] (form/edn-form "{:x86-64 [:x86-64/rdi :x86-64/rsi :x86-64/rdx :x86-64/rcx :x86-64/r8] :aarch64 [:aarch64/x0 :aarch64/x1 :aarch64/x2 :aarch64/x3 :aarch64/x4]}"))
   :default
(def call-argument-registers
  {:x86-64 [:x86-64/rdi :x86-64/rsi :x86-64/rdx :x86-64/rcx :x86-64/r8]
   :aarch64 [:aarch64/x0 :aarch64/x1 :aarch64/x2 :aarch64/x3 :aarch64/x4]}))

#?(:kotoba
   (defn runtime-argument-registers [] [:ref :form/r] (form/edn-form "{:x86-64 [:x86-64/rsi :x86-64/rdx :x86-64/rcx :x86-64/r8] :aarch64 [:aarch64/x1 :aarch64/x2 :aarch64/x3 :aarch64/x4]}"))
   :default
(def runtime-argument-registers
  "The context pointer is the first C argument (rdi / x0); a runtime
  operation's own arguments follow in the next four. Three sufficed until
  ABI v8 (2026-09-16): `string-compare-lines` is the first four-argument
  runtime operation, and its fourth argument rides in the fourth C argument
  register (rcx's successor r8, x3's successor x4), which the loader's C
  signature receives as its fifth parameter."
  {:x86-64 [:x86-64/rsi :x86-64/rdx :x86-64/rcx :x86-64/r8]
   :aarch64 [:aarch64/x1 :aarch64/x2 :aarch64/x3 :aarch64/x4]}))

#?(:kotoba
   (defn runtime-context-offsets [] [:ref :form/r] (form/edn-form "{:pair 56 :pair-first 64 :pair-second 72 :kgraph-assert! 80 :kgraph-get 88 :kgraph-count 96 :kgraph-entity-at 104 :string-byte-length 72 :string=? 112 :string-concat 120 :string-substring 136 :string-code-point-at 144 :vector-new-empty 152 :vector-conj 160 :vector-count 168 :vector-at 176 :vector-assoc 184 :vector-drop 192 :vector-alloc 200 :vector-assoc-in-place 208 :string-index-of 216 :arena-enter 224 :arena-leave 232 :string-compare 240 :string-fold-ascii 248 :string-find-blank 256 :string-skip-blank 264 :string-index-of-from 272 :string-compare-lines 280 :string-find-byte 336 :string-append-range 344 :string-from-utf8 352 :bytes-from-vector 360 :bytes-slice 368 :bytes-concat 376 :fuel-charge 8 :gas-charge 384}"))
   :default
(def runtime-context-offsets
  {:pair 56 :pair-first 64 :pair-second 72
   :kgraph-assert! 80 :kgraph-get 88 :kgraph-count 96
   :kgraph-entity-at 104
   :string-byte-length 72 :string=? 112 :string-concat 120
   :string-substring 136 :string-code-point-at 144
   :vector-new-empty 152 :vector-conj 160 :vector-count 168
   :vector-at 176 :vector-assoc 184 :vector-drop 192
   ;; ABI v4 (superproject ADR-2609010200). The context struct these offsets
   ;; index is `kexe_context_v4` in amu's tools/kexe_loader.c, whose
   ;; `_Static_assert`s pin the same two numbers from the C side; the version
   ;; moved because a guest bakes an offset in, so appending to a v3 host
   ;; would have v4-compiled code jump through uninitialised memory.
   ;;
   ;; Both are past 127, so x86-64 encodes `call qword ptr [r9+disp32]` --
   ;; the same branch offsets 128 and above have taken since string-substring.
   ;; AArch64's LDR unsigned-offset imm12 reaches 8*4095, so both are ordinary
   ;; there.
   :vector-alloc 200 :vector-assoc-in-place 208
   ;; ABI v5 (2026-09-15). `string-index-of` as a host slot, appended after
   ;; the v4 pair for the same one-directional reason: a v4 host has nothing
   ;; at 216, so `kexe_context_v5` in amu's tools/kexe_loader.c refuses any
   ;; other version and pins this number with a `_Static_assert`. Past 127,
   ;; so x86-64 takes the disp32 form like every slot since string-substring.
   :string-index-of 216
   ;; ABI v6 (2026-09-16, superproject ADR-2609160044): the region reset
   ;; pair. Appended after v5's slot for the same one-directional reason; a
   ;; v5 host has nothing at 224 / 232.
   :arena-enter 224 :arena-leave 232
   ;; ABI v7 (2026-09-16): the four text slots, appended after v6's pair.
   :string-compare 240 :string-fold-ascii 248
   :string-find-blank 256 :string-skip-blank 264
   ;; ABI v8 (2026-09-16): the two line slots, appended after v7's four.
   :string-index-of-from 272 :string-compare-lines 280
   ;; ABI v9 (2026-09-16) put six DATA pointers at 288-328 (kotoba-native
   ;; ADR 0084) -- not slots, nothing calls them. ABI v10 (2026-09-16): the
   ;; two range slots, appended after those.
   :string-find-byte 336 :string-append-range 344
   ;; ABI v11 (2026-09-25, superproject adr-2609242330): the string
   ;; constructor and the three bytes slots the vector table cannot express.
   :string-from-utf8 352 :bytes-from-vector 360 :bytes-slice 368 :bytes-concat 376
   ;; amu ADR 0353 floor :allocation-budget-native (2026-09-30): the
   ;; per-constructor fuel debit. Not a slot -- 8 is the context's FUEL word
   ;; (context v2 onward), the one the entry prefix already decrements, and
   ;; kotoba-native encodes the call inline as that same decrement. No host
   ;; is asked anything, so no context version moves.
   :fuel-charge 8
   ;; Consensus gas (superproject adr-2610092340 D12, 2026-10-09): the
   ;; per-form gas debit. Not a slot either -- 384 is the context's GAS word,
   ;; appended after v11's last slot (376), so the context version moves to
   ;; 12: a v11 host has nothing at 384. kotoba-native encodes the call
   ;; inline as a decrement of that word; nothing calls through it.
   :gas-charge 384}))

#?(:kotoba
   (defn capability-argument-registers [] [:ref :form/r] (form/edn-form "{:x86-64 {:i64 [:x86-64/rdx] :string [:x86-64/r8] :option-i64 [:x86-64/r8] :result-i64 [:x86-64/r8] :clock-v1 [:x86-64/r8] :dataspace-v1 [:x86-64/r8] :ui-commit-v1 [:x86-64/r8] :ui-event-v1 [:x86-64/r8] :bytes-v1 [:x86-64/r8] :string-bytes-v1 [:x86-64/r8]} :aarch64 {:i64 [:aarch64/x2] :string [:aarch64/x4] :option-i64 [:aarch64/x4] :result-i64 [:aarch64/x4] :clock-v1 [:aarch64/x4] :dataspace-v1 [:aarch64/x4] :ui-commit-v1 [:aarch64/x4] :ui-event-v1 [:aarch64/x4] :bytes-v1 [:aarch64/x4] :string-bytes-v1 [:aarch64/x4]}}"))
   :default
(def capability-argument-registers
  {:x86-64 {:i64 [:x86-64/rdx]
            :string [:x86-64/r8]
            :option-i64 [:x86-64/r8]
            :result-i64 [:x86-64/r8]
            :clock-v1 [:x86-64/r8]
            :dataspace-v1 [:x86-64/r8]
            :ui-commit-v1 [:x86-64/r8]
            :ui-event-v1 [:x86-64/r8]
            :bytes-v1 [:x86-64/r8]
            :string-bytes-v1 [:x86-64/r8]}
   :aarch64 {:i64 [:aarch64/x2]
            :string [:aarch64/x4]
            :option-i64 [:aarch64/x4]
            :result-i64 [:aarch64/x4]
            :clock-v1 [:aarch64/x4]
            :dataspace-v1 [:aarch64/x4]
            :ui-commit-v1 [:aarch64/x4]
            :ui-event-v1 [:aarch64/x4]
            :bytes-v1 [:aarch64/x4]
            :string-bytes-v1 [:aarch64/x4]}}))

#?(:kotoba
   (defn capability-context-offsets [] [:ref :form/r] (form/edn-form "{:i64 48 :string 128 :option-i64 128 :result-i64 128 :clock-v1 128 :dataspace-v1 128 :ui-commit-v1 128 :ui-event-v1 128 :bytes-v1 128 :string-bytes-v1 128}"))
   :default
(def capability-context-offsets
  {:i64 48 :string 128 :option-i64 128 :result-i64 128 :clock-v1 128
   :dataspace-v1 128 :ui-commit-v1 128 :ui-event-v1 128
   :bytes-v1 128 :string-bytes-v1 128}))

#?(:kotoba
   (defn return-registers [] [:ref :form/r] (form/edn-form "{:x86-64 :x86-64/rax :aarch64 :aarch64/x0}"))
   :default
(def return-registers
  {:x86-64 :x86-64/rax
   :aarch64 :aarch64/x0}))

#?(:kotoba nil :default
(defn- reject! [problem instruction]
  (throw (ex-info (str "MIR rejected: " (name problem))
                  {:phase :mir :problem problem :instruction instruction}))))

#?(:kotoba nil :default (declare call-argument-registers))

#?(:kotoba
   (defn- stack-argument-ops [] [:ref :form/r] (form/edn-form "#{:mir/incoming-load :mir/outgoing-argument :mir/incoming-argument-store}"))
   :default
(def ^:private stack-argument-ops
  #{:mir/incoming-load :mir/outgoing-argument :mir/incoming-argument-store}))

#?(:kotoba
   ;; The 104-entry table exceeds the record field limit as a keyword-keyed map
   ;; literal, so on this route it is the Form of its EDN text (same table, same
   ;; sets); `instruction-op?` / `instruction-keyset` are the lookups.
   (defn instruction-keysets [] [:ref :form/r]
     (form/edn-form "{:mir/add #{:mir/dst :mir/left :mir/op :mir/right}, :mir/argument #{:mir/dst :mir/index :mir/op}, :mir/bit-and #{:mir/dst :mir/left :mir/op :mir/right}, :mir/bit-or #{:mir/dst :mir/left :mir/op :mir/right}, :mir/bit-xor #{:mir/dst :mir/left :mir/op :mir/right}, :mir/branch-nonzero #{:mir/op :mir/target :mir/test}, :mir/branch-zero #{:mir/op :mir/target :mir/test}, :mir/call #{:mir/arguments :mir/callee :mir/dst :mir/op}, :mir/capability-call #{:mir/arguments :mir/capability :mir/context-offset :mir/dst :mir/kind :mir/op}, :mir/constant #{:mir/dst :mir/op :mir/value}, :mir/data-address #{:mir/content :mir/dst :mir/op}, :mir/equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-add #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-divide #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-greater-or-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-greater-than #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-less-or-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-less-than #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-multiply #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-sqrt #{:mir/dst :mir/input :mir/op}, :mir/f32-subtract #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f32-to-f64 #{:mir/dst :mir/input :mir/op}, :mir/f32-unordered #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-add #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-divide #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-greater-or-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-greater-than #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-less-or-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-less-than #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-max #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-min #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-multiply #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-sqrt #{:mir/dst :mir/input :mir/op}, :mir/f64-subtract #{:mir/dst :mir/left :mir/op :mir/right}, :mir/f64-to-f32 #{:mir/dst :mir/input :mir/op}, :mir/f64-unordered #{:mir/dst :mir/left :mir/op :mir/right}, :mir/function-address #{:mir/dst :mir/function :mir/op}, :mir/greater-or-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/greater-than #{:mir/dst :mir/left :mir/op :mir/right}, :mir/i64-to-f32 #{:mir/dst :mir/input :mir/op}, :mir/i64-to-f64 #{:mir/dst :mir/input :mir/op}, :mir/incoming-argument-store #{:mir/index :mir/op :mir/src}, :mir/incoming-load #{:mir/dst :mir/index :mir/op}, :mir/jump #{:mir/op :mir/target}, :mir/kernel-atomic-add-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-atomic-add-u64 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-cmpxchg-u32 #{:mir/base :mir/dst :mir/expected :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-cmpxchg-u64 #{:mir/base :mir/dst :mir/expected :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-dequant-dot-iq2-s #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dequant-dot-iq3-s #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dequant-dot-ptq1-0 #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dequant-dot-iq3-xxs #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dequant-dot-iq4-xs #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dequant-dot-q4-k #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dequant-dot-q6-k #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dequant-dot-q8-0 #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-dot-f32 #{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}, :mir/kernel-load-u16 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/kernel-load-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/kernel-load-u64 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/kernel-load-u8 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/kernel-store-u16 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-store-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-store-u64 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-store-u8 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-subregion #{:mir/base :mir/dst :mir/length :mir/offset :mir/op :mir/size}, :mir/kernel-try-lock-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/kernel-unlock-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/kernel-xchg-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/kernel-xchg-u64 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/label #{:mir/id :mir/op}, :mir/less-or-equal #{:mir/dst :mir/left :mir/op :mir/right}, :mir/less-than #{:mir/dst :mir/left :mir/op :mir/right}, :mir/move #{:mir/dst :mir/op :mir/src}, :mir/multiply #{:mir/dst :mir/left :mir/op :mir/right}, :mir/multiply-add #{:mir/addend :mir/dst :mir/left :mir/op :mir/right}, :mir/multiply-subtract #{:mir/addend :mir/dst :mir/left :mir/op :mir/right}, :mir/outgoing-argument #{:mir/index :mir/op :mir/src}, :mir/phi #{:mir/dst :mir/incomings :mir/op}, :mir/quotient #{:mir/dst :mir/left :mir/op :mir/right}, :mir/quotient-constant #{:mir/divisor :mir/dst :mir/left :mir/op}, :mir/recur #{:mir/arguments :mir/op}, :mir/reentry #{:mir/op :mir/parameters}, :mir/return #{:mir/op :mir/value}, :mir/rodata-address #{:mir/content :mir/dst :mir/op :mir/rodata-encoding}, :mir/runtime-call #{:mir/arguments :mir/context-offset :mir/dst :mir/op :mir/runtime}, :mir/shift-left #{:mir/dst :mir/left :mir/op :mir/right}, :mir/shift-right-signed #{:mir/dst :mir/left :mir/op :mir/right}, :mir/shift-right-unsigned #{:mir/dst :mir/left :mir/op :mir/right}, :mir/slice-load-u16 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/slice-load-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/slice-load-u64 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/slice-load-u8 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}, :mir/slice-store-u16 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/slice-store-u32 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/slice-store-u64 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/slice-store-u8 #{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}, :mir/spill-load #{:mir/dst :mir/op :mir/slot}, :mir/spill-store #{:mir/op :mir/slot :mir/src}, :mir/subtract #{:mir/dst :mir/left :mir/op :mir/right}, :mir/tail-call #{:mir/arguments :mir/callee :mir/op}, :mir/x86-privileged #{:mir/action :mir/arguments :mir/dst :mir/op}}"))
   :default
   (def instruction-keysets
     {:mir/argument #{:mir/op :mir/dst :mir/index}
      :mir/constant #{:mir/op :mir/dst :mir/value}
      :mir/data-address #{:mir/op :mir/dst :mir/content}
      ;; boot-lit: the address of a read-only literal placed in the code image
      ;; (kotoba-gmir ADR-0011). Distinct from `:mir/data-address` above, which
      ;; is a managed string the value runtime resolves against a runtime base.
      :mir/rodata-address #{:mir/op :mir/dst :mir/content :mir/rodata-encoding}
      ;; boot-scratch: the address of a function in the same module (kotoba-gmir
      ;; ADR-0013). One destination, no sources, and a NAME -- the same shape as
      ;; the literal above, with a symbol where that one has a string.
      :mir/function-address #{:mir/op :mir/dst :mir/function}
      :mir/add #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/subtract #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/multiply #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/multiply-add #{:mir/op :mir/dst :mir/left :mir/right :mir/addend}
      :mir/multiply-subtract #{:mir/op :mir/dst :mir/left :mir/right :mir/addend}
      :mir/quotient #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/quotient-constant #{:mir/op :mir/dst :mir/left :mir/divisor}
      :mir/bit-and #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/bit-or #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/bit-xor #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/shift-left #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/shift-right-signed #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/shift-right-unsigned #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f64-add #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f64-subtract #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f64-multiply #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f64-divide #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f64-min #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f64-max #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f64-sqrt #{:mir/op :mir/dst :mir/input}
      :mir/f64-equal #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f64-less-than #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f64-less-or-equal #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f64-greater-than #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f64-greater-or-equal #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f64-unordered #{:mir/op :mir/dst :mir/left :mir/right}
      ;; f32: binary32 (kotoba-lang ADR-kotoba-floating-point-on-native). Same
      ;; operand shapes and the same one-word vreg as the f64 family above -- an
      ;; f32 travels as its binary32 pattern sign-extended from bit 31.
      ;;
      ;; No f32-min/f32-max, and the absence is the decision: x86 MINSS/MAXSS
      ;; return the SECOND operand when either input is NaN while AArch64 FMIN and
      ;; the KIR oracle return the NaN, so :mir/f64-min above already means two
      ;; things on the two targets. Recorded upstream, not inherited here.
      :mir/f32-add #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f32-subtract #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f32-multiply #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f32-divide #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f32-sqrt #{:mir/op :mir/dst :mir/input}
      :mir/f32-equal #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f32-less-than #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f32-less-or-equal #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f32-greater-than #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f32-greater-or-equal #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/f32-unordered #{:mir/op :mir/dst :mir/left :mir/right}
      ;; Width conversions -- one source in, one value out, exactly like f32-sqrt.
      :mir/f32-to-f64 #{:mir/op :mir/dst :mir/input}
      :mir/f64-to-f32 #{:mir/op :mir/dst :mir/input}
      :mir/i64-to-f32 #{:mir/op :mir/dst :mir/input}
      :mir/i64-to-f64 #{:mir/op :mir/dst :mir/input}
      :mir/kernel-load-u8 #{:mir/op :mir/dst :mir/base :mir/length
                            :mir/index :mir/maximum}
      :mir/kernel-store-u8 #{:mir/op :mir/dst :mir/base :mir/length
                             :mir/index :mir/stored :mir/maximum}
      :mir/kernel-load-u32 #{:mir/op :mir/dst :mir/base :mir/length
                             :mir/index :mir/maximum}
      :mir/kernel-store-u32 #{:mir/op :mir/dst :mir/base :mir/length
                              :mir/index :mir/stored :mir/maximum}
      ;; memwidth: the two remaining MMIO transfer widths, and the slice family.
      ;; Every one carries exactly the fields its u8/u32 sibling does -- the width
      ;; is in the operation name, and for the slice family the only other
      ;; difference is that `:mir/index` counts elements rather than bytes.
      :mir/kernel-load-u16 #{:mir/op :mir/dst :mir/base :mir/length
                             :mir/index :mir/maximum}
      :mir/kernel-store-u16 #{:mir/op :mir/dst :mir/base :mir/length
                              :mir/index :mir/stored :mir/maximum}
      :mir/kernel-load-u64 #{:mir/op :mir/dst :mir/base :mir/length
                             :mir/index :mir/maximum}
      :mir/kernel-store-u64 #{:mir/op :mir/dst :mir/base :mir/length
                              :mir/index :mir/stored :mir/maximum}
      :mir/slice-load-u8 #{:mir/op :mir/dst :mir/base :mir/length
                           :mir/index :mir/maximum}
      :mir/slice-store-u8 #{:mir/op :mir/dst :mir/base :mir/length
                            :mir/index :mir/stored :mir/maximum}
      :mir/slice-load-u16 #{:mir/op :mir/dst :mir/base :mir/length
                            :mir/index :mir/maximum}
      :mir/slice-store-u16 #{:mir/op :mir/dst :mir/base :mir/length
                             :mir/index :mir/stored :mir/maximum}
      :mir/slice-load-u32 #{:mir/op :mir/dst :mir/base :mir/length
                            :mir/index :mir/maximum}
      :mir/slice-store-u32 #{:mir/op :mir/dst :mir/base :mir/length
                             :mir/index :mir/stored :mir/maximum}
      :mir/slice-load-u64 #{:mir/op :mir/dst :mir/base :mir/length
                            :mir/index :mir/maximum}
      :mir/slice-store-u64 #{:mir/op :mir/dst :mir/base :mir/length
                             :mir/index :mir/stored :mir/maximum}
      ;; memwidth: end
      ;; The lock pair carries the load's fields: three sources in, one value
      ;; out. No `:mir/stored` -- the stored word is fixed by the operation, not
      ;; supplied by the guest.
      :mir/kernel-try-lock-u32 #{:mir/op :mir/dst :mir/base :mir/length
                                 :mir/index :mir/maximum}
      :mir/kernel-unlock-u32 #{:mir/op :mir/dst :mir/base :mir/length
                               :mir/index :mir/maximum}
      ;; sysops: the general atomic family (kotoba-gmir ADR 0007). The lock pair
      ;; fixes its comparand and replacement; these take the word from the guest,
      ;; which is what a device descriptor ring needs. `:mir/stored` is the
      ;; addend for the adds and the replacement for the swaps and the
      ;; compare-exchanges; `:mir/expected` exists only on the two
      ;; compare-exchanges and is the comparand the lock withholds. `:mir/dst` is
      ;; the word memory held BEFORE the operation, for all six.
      :mir/kernel-atomic-add-u32 #{:mir/op :mir/dst :mir/base :mir/length
                                   :mir/index :mir/stored :mir/maximum}
      :mir/kernel-atomic-add-u64 #{:mir/op :mir/dst :mir/base :mir/length
                                   :mir/index :mir/stored :mir/maximum}
      :mir/kernel-xchg-u32 #{:mir/op :mir/dst :mir/base :mir/length
                             :mir/index :mir/stored :mir/maximum}
      :mir/kernel-xchg-u64 #{:mir/op :mir/dst :mir/base :mir/length
                             :mir/index :mir/stored :mir/maximum}
      :mir/kernel-cmpxchg-u32 #{:mir/op :mir/dst :mir/base :mir/length
                                :mir/index :mir/expected :mir/stored :mir/maximum}
      :mir/kernel-cmpxchg-u64 #{:mir/op :mir/dst :mir/base :mir/length
                                :mir/index :mir/expected :mir/stored :mir/maximum}
      ;; sysops: end
      ;; simd: one dot product of two f32 regions (kotoba-gmir ADR 0010).
      ;;
      ;; The keyset is GMIR's, renamed. Two regions, so two bases and two
      ;; lengths; `:mir/base`/`:mir/length` stay the FIRST region's names so
      ;; anything reading `:mir/base` still finds a base. `:mir/count` counts
      ;; ELEMENTS while the lengths count BYTES, and `:mir/maximum` is the byte
      ;; ceiling on both, pinned to one value.
      ;;
      ;; It is deliberately NOT in `schedulable-integer-operations`: it reads
      ;; memory, branches, and clobbers registers the scheduler does not model,
      ;; so it stays a hard barrier like every other memory operation.
      :mir/kernel-dot-f32 #{:mir/op :mir/dst :mir/base :mir/length
                            :mir/second-base :mir/second-length
                            :mir/count :mir/maximum}
      ;; simd: end
      ;; dequant: the fused dequantize-and-dot family. The f32 dot product's
      ;; keyset exactly, because the operand SHAPE is the same one -- two
      ;; regions, a ceiling and a count. What the count counts differs (blocks,
      ;; not elements) and that is the format's business, not the keyset's.
      :mir/kernel-dequant-dot-q8-0 #{:mir/op :mir/dst :mir/base :mir/length
                                     :mir/second-base :mir/second-length
                                     :mir/count :mir/maximum}
      :mir/kernel-dequant-dot-q4-k #{:mir/op :mir/dst :mir/base :mir/length
                                     :mir/second-base :mir/second-length
                                     :mir/count :mir/maximum}
      :mir/kernel-dequant-dot-q6-k #{:mir/op :mir/dst :mir/base :mir/length
                                     :mir/second-base :mir/second-length
                                     :mir/count :mir/maximum}
      ;; dequant-iq: the four codebook formats (kotoba-gmir ADR 0027). Same
      ;; keyset again: their codebook is read-only data the compiler places,
      ;; not a region a caller passes, so no operand of theirs is new.
      :mir/kernel-dequant-dot-iq4-xs #{:mir/op :mir/dst :mir/base :mir/length
                                     :mir/second-base :mir/second-length
                                     :mir/count :mir/maximum}
      :mir/kernel-dequant-dot-iq2-s #{:mir/op :mir/dst :mir/base :mir/length
                                    :mir/second-base :mir/second-length
                                    :mir/count :mir/maximum}
      :mir/kernel-dequant-dot-iq3-xxs #{:mir/op :mir/dst :mir/base :mir/length
                                      :mir/second-base :mir/second-length
                                      :mir/count :mir/maximum}
      :mir/kernel-dequant-dot-iq3-s #{:mir/op :mir/dst :mir/base :mir/length
                                    :mir/second-base :mir/second-length
                                    :mir/count :mir/maximum}
      ;; dequant-ptq1: PTQ1_0 (kotoba-gmir ADR 0031), the same keyset once more.
      :mir/kernel-dequant-dot-ptq1-0 #{:mir/op :mir/dst :mir/base :mir/length
                                     :mir/second-base :mir/second-length
                                     :mir/count :mir/maximum}
      ;; dequant: end
      :mir/kernel-subregion #{:mir/op :mir/dst :mir/base :mir/length
                              :mir/offset :mir/size}
      :mir/equal #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/less-than #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/greater-than #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/less-or-equal #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/greater-or-equal #{:mir/op :mir/dst :mir/left :mir/right}
      :mir/spill-load #{:mir/op :mir/dst :mir/slot}
      :mir/spill-store #{:mir/op :mir/src :mir/slot}
      :mir/move #{:mir/op :mir/dst :mir/src}
      ;; Stack-passed arguments (2026-09-23). A call passes its first five
      ;; arguments in `call-argument-registers` and every one after that on the
      ;; stack, at the bottom of the caller's frame: argument i (i >= 5) at
      ;; [sp + 8(i - 5)]. The callee reads it from that INCOMING area, above its
      ;; own frame; where that is depends on frame sizes only the encoder knows,
      ;; so these name the argument by index, never by offset.
      ;;
      ;; They are introduced by `stack-argument-rewrite`, before allocation, and
      ;; are ordinary instructions to the allocators: `incoming-load` defines a
      ;; value, the two stores read one. All barriers to scheduling.
      :mir/incoming-load #{:mir/op :mir/dst :mir/index}
      :mir/outgoing-argument #{:mir/op :mir/src :mir/index}
      ;; A tail call writes the callee's stack arguments into its OWN incoming
      ;; area. Safe because every incoming argument was loaded at entry, before
      ;; anything in the body could run.
      :mir/incoming-argument-store #{:mir/op :mir/src :mir/index}
      ;; Physical-only AArch64 self-tail re-entry. The boundary carries the
      ;; allocator-owned parameter homes; recur edges have already performed the
      ;; simultaneous assignment into exactly those registers.
      :mir/reentry #{:mir/op :mir/parameters}
      :mir/recur #{:mir/op :mir/arguments}
      :mir/label #{:mir/op :mir/id}
      :mir/branch-zero #{:mir/op :mir/test :mir/target}
      :mir/branch-nonzero #{:mir/op :mir/test :mir/target}
      :mir/jump #{:mir/op :mir/target}
      :mir/phi #{:mir/op :mir/dst :mir/incomings}
      :mir/call #{:mir/op :mir/dst :mir/callee :mir/arguments}
      :mir/tail-call #{:mir/op :mir/callee :mir/arguments}
      :mir/runtime-call #{:mir/op :mir/dst :mir/runtime :mir/context-offset
                          :mir/arguments}
      :mir/x86-privileged #{:mir/op :mir/dst :mir/action :mir/arguments}
      :mir/capability-call #{:mir/op :mir/dst :mir/capability :mir/kind
                             :mir/context-offset :mir/arguments}
      :mir/return #{:mir/op :mir/value}}))

#?(:kotoba
   (defn kernel-window-operations [] [:ref :form/r] (form/edn-form "#{:mir/kernel-load-u8 :mir/kernel-store-u8 :mir/kernel-load-u16 :mir/kernel-store-u16 :mir/kernel-load-u32 :mir/kernel-store-u32 :mir/kernel-load-u64 :mir/kernel-store-u64}"))
   :default
(def kernel-window-operations
  #{:mir/kernel-load-u8 :mir/kernel-store-u8
    :mir/kernel-load-u16 :mir/kernel-store-u16
    :mir/kernel-load-u32 :mir/kernel-store-u32
    :mir/kernel-load-u64 :mir/kernel-store-u64}))

#?(:kotoba
   (defn kernel-window-maxima [] [:ref :form/r] (form/edn-form "#{512 4096 16384 65536}"))
   :default
(def kernel-window-maxima #{512 4096 16384 65536}))

#?(:kotoba
   (defn slice-operations [] [:ref :form/r] (form/edn-form "#{:mir/slice-load-u8 :mir/slice-store-u8 :mir/slice-load-u16 :mir/slice-store-u16 :mir/slice-load-u32 :mir/slice-store-u32 :mir/slice-load-u64 :mir/slice-store-u64}"))
   :default
(def slice-operations
  #{:mir/slice-load-u8 :mir/slice-store-u8
    :mir/slice-load-u16 :mir/slice-store-u16
    :mir/slice-load-u32 :mir/slice-store-u32
    :mir/slice-load-u64 :mir/slice-store-u64}))

#?(:kotoba
   (defn slice-item-limit [] :i64 1099511627776)
   :default
(def slice-item-limit
  "2^40 elements -- an address-space bound, not a window profile, and
  deliberately not derived from any vector arena bound. Mirrors
  `kotoba.gmir/slice-item-limit`; `kotoba.mir-test` asserts the two equal
  rather than trusting the transcription."
  1099511627776))

#?(:kotoba
   (defn kernel-atomic-ops [] [:ref :form/r]
     (form/edn-form "#{:mir/kernel-atomic-add-u32 :mir/kernel-atomic-add-u64 :mir/kernel-xchg-u32 :mir/kernel-xchg-u64 :mir/kernel-cmpxchg-u32 :mir/kernel-cmpxchg-u64}"))
   :default
   (def kernel-atomic-ops
     (into #{} (map #(keyword "mir" (name %))) gmir/kernel-atomic-ops)))

#?(:kotoba
   (defn kernel-dot-f32-maximum [] :i64 65536)
   :default
   (def kernel-dot-f32-maximum gmir/kernel-dot-f32-maximum))

#?(:kotoba
   (defn kernel-dequant-dot-operations [] [:ref :form/r]
     (form/edn-form "#{:mir/kernel-dequant-dot-q8-0 :mir/kernel-dequant-dot-q4-k :mir/kernel-dequant-dot-q6-k :mir/kernel-dequant-dot-iq4-xs :mir/kernel-dequant-dot-iq2-s :mir/kernel-dequant-dot-iq3-xxs :mir/kernel-dequant-dot-iq3-s :mir/kernel-dequant-dot-ptq1-0}"))
   :default
   (def kernel-dequant-dot-operations
     (into #{} (map #(keyword "mir" (name %))) gmir/kernel-dequant-dot-operations)))

#?(:kotoba
   (defn kernel-dequant-dot-maximum [] :i64 65536)
   :default
   (def kernel-dequant-dot-maximum gmir/kernel-dequant-dot-maximum))

#?(:kotoba
   ;; A constant is a literal on this route (a `def` value may not call a
   ;; function), so the union of the four families above is spelled out.
   (defn- indexed-memory-operations [] [:ref :form/r]
     (form/edn-form "#{:mir/kernel-try-lock-u32 :mir/kernel-unlock-u32 :mir/kernel-load-u8 :mir/kernel-store-u8 :mir/kernel-load-u16 :mir/kernel-store-u16 :mir/kernel-load-u32 :mir/kernel-store-u32 :mir/kernel-load-u64 :mir/kernel-store-u64 :mir/slice-load-u8 :mir/slice-store-u8 :mir/slice-load-u16 :mir/slice-store-u16 :mir/slice-load-u32 :mir/slice-store-u32 :mir/slice-load-u64 :mir/slice-store-u64 :mir/kernel-atomic-add-u32 :mir/kernel-atomic-add-u64 :mir/kernel-xchg-u32 :mir/kernel-xchg-u64 :mir/kernel-cmpxchg-u32 :mir/kernel-cmpxchg-u64}"))
   :default
   (def ^:private indexed-memory-operations
     (into #{:mir/kernel-try-lock-u32 :mir/kernel-unlock-u32}
           (concat kernel-window-operations slice-operations kernel-atomic-ops))))

#?(:kotoba
   (defn instruction-known-op? [op :keyword] :bool
     (form/form-has? (instruction-keysets) (form/keyword-form op))))

#?(:kotoba
   (defn- arithmetic-op-0? [op :keyword] :bool
     (or (= op :mir/add) (= op :mir/bit-and) (= op :mir/bit-or) (= op :mir/bit-xor) (= op :mir/equal) (= op :mir/f32-add) (= op :mir/f32-divide) (= op :mir/f32-equal) (= op :mir/f32-greater-or-equal) (= op :mir/f32-greater-than) (= op :mir/f32-less-or-equal) (= op :mir/f32-less-than) (= op :mir/f32-multiply) (= op :mir/f32-subtract) (= op :mir/f32-unordered) (= op :mir/f64-add) (= op :mir/f64-divide) (= op :mir/f64-equal) (= op :mir/f64-greater-or-equal) (= op :mir/f64-greater-than) (= op :mir/f64-less-or-equal) (= op :mir/f64-less-than) (= op :mir/f64-max) (= op :mir/f64-min))))

#?(:kotoba
   (defn- arithmetic-op-1? [op :keyword] :bool
     (or (= op :mir/f64-multiply) (= op :mir/f64-subtract) (= op :mir/f64-unordered) (= op :mir/greater-or-equal) (= op :mir/greater-than) (= op :mir/less-or-equal) (= op :mir/less-than) (= op :mir/multiply) (= op :mir/quotient) (= op :mir/shift-left) (= op :mir/shift-right-signed) (= op :mir/shift-right-unsigned) (= op :mir/subtract))))

#?(:kotoba
   (defn- arithmetic-op? [op :keyword] :bool
     (or (arithmetic-op-0? op) (arithmetic-op-1? op))))

#?(:kotoba
   ;; The key set an instruction of operation OP must have, as EDN text, or "" when
   ;; OP is no operation. Grouped by key set: 103 operations share 30 key sets.
   (defn- keyset-text-of [op :keyword] :string
     (cond
       (arithmetic-op? op) "#{:mir/dst :mir/left :mir/op :mir/right}"
       (or (= op :mir/argument) (= op :mir/incoming-load)) "#{:mir/dst :mir/index :mir/op}"
       (or (= op :mir/branch-nonzero) (= op :mir/branch-zero)) "#{:mir/op :mir/target :mir/test}"
       (or (= op :mir/call)) "#{:mir/arguments :mir/callee :mir/dst :mir/op}"
       (or (= op :mir/capability-call)) "#{:mir/arguments :mir/capability :mir/context-offset :mir/dst :mir/kind :mir/op}"
       (or (= op :mir/constant)) "#{:mir/dst :mir/op :mir/value}"
       (or (= op :mir/data-address)) "#{:mir/content :mir/dst :mir/op}"
       (or (= op :mir/f32-sqrt) (= op :mir/f32-to-f64) (= op :mir/f64-sqrt) (= op :mir/f64-to-f32) (= op :mir/i64-to-f32) (= op :mir/i64-to-f64)) "#{:mir/dst :mir/input :mir/op}"
       (or (= op :mir/function-address)) "#{:mir/dst :mir/function :mir/op}"
       (or (= op :mir/incoming-argument-store) (= op :mir/outgoing-argument)) "#{:mir/index :mir/op :mir/src}"
       (or (= op :mir/jump)) "#{:mir/op :mir/target}"
       (or (= op :mir/kernel-atomic-add-u32) (= op :mir/kernel-atomic-add-u64) (= op :mir/kernel-store-u16) (= op :mir/kernel-store-u32) (= op :mir/kernel-store-u64) (= op :mir/kernel-store-u8) (= op :mir/kernel-xchg-u32) (= op :mir/kernel-xchg-u64) (= op :mir/slice-store-u16) (= op :mir/slice-store-u32) (= op :mir/slice-store-u64) (= op :mir/slice-store-u8)) "#{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op :mir/stored}"
       (or (= op :mir/kernel-cmpxchg-u32) (= op :mir/kernel-cmpxchg-u64)) "#{:mir/base :mir/dst :mir/expected :mir/index :mir/length :mir/maximum :mir/op :mir/stored}"
       (or (= op :mir/kernel-dequant-dot-iq2-s) (= op :mir/kernel-dequant-dot-iq3-s) (= op :mir/kernel-dequant-dot-ptq1-0) (= op :mir/kernel-dequant-dot-iq3-xxs) (= op :mir/kernel-dequant-dot-iq4-xs) (= op :mir/kernel-dequant-dot-q4-k) (= op :mir/kernel-dequant-dot-q6-k) (= op :mir/kernel-dequant-dot-q8-0) (= op :mir/kernel-dot-f32)) "#{:mir/base :mir/count :mir/dst :mir/length :mir/maximum :mir/op :mir/second-base :mir/second-length}"
       (or (= op :mir/kernel-load-u16) (= op :mir/kernel-load-u32) (= op :mir/kernel-load-u64) (= op :mir/kernel-load-u8) (= op :mir/kernel-try-lock-u32) (= op :mir/kernel-unlock-u32) (= op :mir/slice-load-u16) (= op :mir/slice-load-u32) (= op :mir/slice-load-u64) (= op :mir/slice-load-u8)) "#{:mir/base :mir/dst :mir/index :mir/length :mir/maximum :mir/op}"
       (or (= op :mir/kernel-subregion)) "#{:mir/base :mir/dst :mir/length :mir/offset :mir/op :mir/size}"
       (or (= op :mir/label)) "#{:mir/id :mir/op}"
       (or (= op :mir/move)) "#{:mir/dst :mir/op :mir/src}"
       (or (= op :mir/multiply-add) (= op :mir/multiply-subtract)) "#{:mir/addend :mir/dst :mir/left :mir/op :mir/right}"
       (or (= op :mir/phi)) "#{:mir/dst :mir/incomings :mir/op}"
       (or (= op :mir/quotient-constant)) "#{:mir/divisor :mir/dst :mir/left :mir/op}"
       (or (= op :mir/recur)) "#{:mir/arguments :mir/op}"
       (or (= op :mir/reentry)) "#{:mir/op :mir/parameters}"
       (or (= op :mir/return)) "#{:mir/op :mir/value}"
       (or (= op :mir/rodata-address)) "#{:mir/content :mir/dst :mir/op :mir/rodata-encoding}"
       (or (= op :mir/runtime-call)) "#{:mir/arguments :mir/context-offset :mir/dst :mir/op :mir/runtime}"
       (or (= op :mir/spill-load)) "#{:mir/dst :mir/op :mir/slot}"
       (or (= op :mir/spill-store)) "#{:mir/op :mir/slot :mir/src}"
       (or (= op :mir/tail-call)) "#{:mir/arguments :mir/callee :mir/op}"
       (or (= op :mir/x86-privileged)) "#{:mir/action :mir/arguments :mir/dst :mir/op}"
       :else "")))

#?(:kotoba
   (defn- known-op? [op :keyword] :bool
     (not (string=? (keyset-text-of op) ""))))

#?(:kotoba
   (defn- keyset-matches? [op :keyword keys [:ref :form/r]] :bool
     (let [t (keyset-text-of op)]
       (and (not (string=? t "")) (form/eq (form/edn-form t) keys)))))

#?(:kotoba
   (defn instruction-keyset-of [op :keyword] [:ref :form/r]
     (form/form-get (instruction-keysets) (form/keyword-form op))))

#?(:kotoba
   (defn instruction-keyset-is? [op :keyword keys [:ref :form/r]] :bool
     (and (instruction-known-op? op)
          (form/eq (instruction-keyset-of op) keys))))

#?(:kotoba
   (defn- v2-excluded? [op :keyword] :bool
     (or (= op :mir/call) (= op :mir/tail-call) (= op :mir/quotient-constant)
         (= op :mir/branch-nonzero) (= op :mir/reentry) (= op :mir/recur))))

#?(:kotoba
   (defn- operation-allowed? [program-version :i64 op :keyword] :bool
     (and (known-op? op)
          (cond
            (= program-version 1) (and (not (= op :mir/phi)) (not (v2-excluded? op)))
            (= program-version 2) (not (v2-excluded? op))
            (= program-version 3) true
            :else false))))

#?(:kotoba nil :default
   (do (def ^:private v1-operations
     (disj (set (keys instruction-keysets)) :mir/phi :mir/call :mir/tail-call
           :mir/quotient-constant :mir/branch-nonzero :mir/reentry :mir/recur))
   
   (def ^:private v2-operations
     (disj (set (keys instruction-keysets)) :mir/call :mir/tail-call
           :mir/quotient-constant :mir/branch-nonzero :mir/reentry :mir/recur))
   
   (def ^:private v3-operations
     (set (keys instruction-keysets)))
   
   (defn- operations-for [program-version]
     (case program-version
       1 v1-operations
       2 v2-operations
       3 v3-operations
       #{}))))

#?(:kotoba
   (defn- window-op? [op :keyword] :bool
     (or (= op :mir/kernel-load-u8) (= op :mir/kernel-store-u8) (= op :mir/kernel-load-u16) (= op :mir/kernel-store-u16) (= op :mir/kernel-load-u32) (= op :mir/kernel-store-u32) (= op :mir/kernel-load-u64) (= op :mir/kernel-store-u64))))

#?(:kotoba
   (defn- slice-op? [op :keyword] :bool
     (or (= op :mir/slice-load-u8) (= op :mir/slice-store-u8) (= op :mir/slice-load-u16) (= op :mir/slice-store-u16) (= op :mir/slice-load-u32) (= op :mir/slice-store-u32) (= op :mir/slice-load-u64) (= op :mir/slice-store-u64))))

#?(:kotoba
   (defn- atomic-op? [op :keyword] :bool
     (or (= op :mir/kernel-atomic-add-u32) (= op :mir/kernel-atomic-add-u64) (= op :mir/kernel-xchg-u32) (= op :mir/kernel-xchg-u64) (= op :mir/kernel-cmpxchg-u32) (= op :mir/kernel-cmpxchg-u64))))

#?(:kotoba
   (defn- dequant-op? [op :keyword] :bool
     (or (= op :mir/kernel-dequant-dot-q8-0) (= op :mir/kernel-dequant-dot-q4-k) (= op :mir/kernel-dequant-dot-q6-k) (= op :mir/kernel-dequant-dot-iq4-xs) (= op :mir/kernel-dequant-dot-iq2-s) (= op :mir/kernel-dequant-dot-iq3-xxs) (= op :mir/kernel-dequant-dot-iq3-s) (= op :mir/kernel-dequant-dot-ptq1-0))))

#?(:kotoba
   (defn- lock-op? [op :keyword] :bool
     (or (= op :mir/kernel-try-lock-u32) (= op :mir/kernel-unlock-u32))))

#?(:kotoba
   (defn- stack-argument-op? [op :keyword] :bool
     (or (= op :mir/incoming-load) (= op :mir/outgoing-argument) (= op :mir/incoming-argument-store))))

#?(:kotoba
   (defn- value-op-listed-0? [op :keyword] :bool
     (or (= op :mir/argument) (= op :mir/constant) (= op :mir/add) (= op :mir/subtract) (= op :mir/multiply) (= op :mir/quotient) (= op :mir/quotient-constant) (= op :mir/bit-and) (= op :mir/bit-or) (= op :mir/bit-xor) (= op :mir/shift-left) (= op :mir/shift-right-signed) (= op :mir/shift-right-unsigned) (= op :mir/f64-add) (= op :mir/f64-subtract) (= op :mir/f64-multiply) (= op :mir/f64-divide) (= op :mir/f64-min) (= op :mir/f64-max) (= op :mir/f64-sqrt) (= op :mir/f64-equal) (= op :mir/f64-less-than) (= op :mir/f64-less-or-equal) (= op :mir/f64-greater-than))))

#?(:kotoba
   (defn- value-op-listed-1? [op :keyword] :bool
     (or (= op :mir/f64-greater-or-equal) (= op :mir/f64-unordered) (= op :mir/f32-add) (= op :mir/f32-subtract) (= op :mir/f32-multiply) (= op :mir/f32-divide) (= op :mir/f32-sqrt) (= op :mir/f32-equal) (= op :mir/f32-less-than) (= op :mir/f32-less-or-equal) (= op :mir/f32-greater-than) (= op :mir/f32-greater-or-equal) (= op :mir/f32-unordered) (= op :mir/f32-to-f64) (= op :mir/f64-to-f32) (= op :mir/i64-to-f32) (= op :mir/i64-to-f64) (= op :mir/kernel-load-u8) (= op :mir/kernel-store-u8) (= op :mir/kernel-load-u32) (= op :mir/kernel-store-u32) (= op :mir/kernel-try-lock-u32) (= op :mir/kernel-unlock-u32) (= op :mir/kernel-subregion))))

#?(:kotoba
   (defn- value-op-listed-2? [op :keyword] :bool
     (or (= op :mir/kernel-dot-f32) (= op :mir/kernel-dequant-dot-q8-0) (= op :mir/kernel-dequant-dot-q4-k) (= op :mir/kernel-dequant-dot-q6-k) (= op :mir/kernel-dequant-dot-iq4-xs) (= op :mir/kernel-dequant-dot-iq2-s) (= op :mir/kernel-dequant-dot-iq3-xxs) (= op :mir/kernel-dequant-dot-iq3-s) (= op :mir/kernel-dequant-dot-ptq1-0) (= op :mir/equal) (= op :mir/less-than) (= op :mir/greater-than) (= op :mir/less-or-equal) (= op :mir/greater-or-equal) (= op :mir/call) (= op :mir/runtime-call) (= op :mir/capability-call) (= op :mir/x86-privileged) (= op :mir/data-address) (= op :mir/rodata-address) (= op :mir/function-address))))

#?(:kotoba
   (defn- value-op-listed? [op :keyword] :bool
     (or (value-op-listed-0? op) (value-op-listed-1? op) (value-op-listed-2? op))))

#?(:kotoba
   (defn- indexed-memory-op? [op :keyword] :bool
     (or (lock-op? op) (window-op? op) (slice-op? op) (atomic-op? op))))

#?(:kotoba
   (defn- window-maximum? [f [:ref :form/r]] :bool
     (or (int-eq? f 512) (int-eq? f 4096) (int-eq? f 16384) (int-eq? f 65536))))

#?(:kotoba
   (defn- physical-register-kw? [target :keyword k :keyword] :bool
     (if (= target :x86-64)
       (or (= k :x86-64/rax) (= k :x86-64/rcx) (= k :x86-64/rdx) (= k :x86-64/r8)
           (= k :x86-64/rdi) (= k :x86-64/rsi)
           (= k :x86-64/rbx) (= k :x86-64/r12) (= k :x86-64/r13) (= k :x86-64/r14) (= k :x86-64/r15))
       (if (= target :aarch64)
         (or (= k :aarch64/x0) (= k :aarch64/x1) (= k :aarch64/x2) (= k :aarch64/x3) (= k :aarch64/x4)
             (= k :aarch64/x5) (= k :aarch64/x6) (= k :aarch64/x8) (= k :aarch64/x9) (= k :aarch64/x10)
             (= k :aarch64/x11) (= k :aarch64/x12)
             (= k :aarch64/x19) (= k :aarch64/x20) (= k :aarch64/x21) (= k :aarch64/x22)
             (= k :aarch64/x23) (= k :aarch64/x24) (= k :aarch64/x25) (= k :aarch64/x26))
         false))))

#?(:kotoba
   (defn- call-register-count [target :keyword] :i64
     (if (or (= target :x86-64) (= target :aarch64)) 5 0)))

#?(:kotoba
   (defn- fvec [] [:ref :form/r] (form/form-vec (form/no-forms))))

#?(:kotoba
   (defn- fmap [] [:ref :form/r] (form/form-map (form/no-forms))))

#?(:kotoba
   (defn- fset [] [:ref :form/r] (form/form-set (form/no-forms))))

#?(:kotoba
   (defn- vconj [v [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
     (form/form-vec (form/append-form (form/kids-of v) x))))

#?(:kotoba
   (defn- vinto [v [:ref :form/r] w [:ref :form/r]] [:ref :form/r]
     (form/form-vec (form/append-many (form/kids-of v) (form/kids-of w)))))

#?(:kotoba
   (defn- vrest [v [:ref :form/r]] [:ref :form/r]
     (form/form-vec (form/rest-list v))))

#?(:kotoba
   (defn- vsub [v [:ref :form/r] from :i64 to :i64] [:ref :form/r]
     (form/form-vec
      (loop [i from acc (form/no-forms)]
        (if (>= i to) acc (recur (inc i) (form/append-form acc (form/nth-of v i))))))))

#?(:kotoba
   (defn- vtake [v [:ref :form/r] n :i64] [:ref :form/r]
     (vsub v 0 (if (< n (form/count-of v)) n (form/count-of v)))))

#?(:kotoba
   (defn- vdrop [v [:ref :form/r] n :i64] [:ref :form/r]
     (vsub v (if (< n (form/count-of v)) n (form/count-of v)) (form/count-of v))))

#?(:kotoba
   (defn- vassoc [v [:ref :form/r] i :i64 x [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of v)]
       (form/form-vec
        (loop [j 0 acc (form/no-forms)]
          (if (>= j n) acc
            (recur (inc j) (form/append-form acc (if (= j i) x (form/nth-of v j))))))))))

#?(:kotoba
   (defn- vremove-at [v [:ref :form/r] i :i64] [:ref :form/r]
     (let [n (form/count-of v)]
       (form/form-vec
        (loop [j 0 acc (form/no-forms)]
          (if (>= j n) acc
            (recur (inc j) (if (= j i) acc (form/append-form acc (form/nth-of v j))))))))))

#?(:kotoba
   (defn- sconj [s [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
     (if (member-of? s x) s (form/form-set (form/append-form (form/kids-of s) x)))))

#?(:kotoba
   (defn- vremove-members [v [:ref :form/r] s [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of v)]
       (form/form-vec
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (let [x (form/nth-of v i)]
              (recur (inc i) (if (member-of? s x) acc (form/append-form acc x))))))))))

#?(:kotoba
   (defn- vkeep-members [v [:ref :form/r] s [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of v)]
       (form/form-vec
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (let [x (form/nth-of v i)]
              (recur (inc i) (if (member-of? s x) (form/append-form acc x) acc)))))))))

#?(:kotoba
   (defn- vdistinct [v [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of v)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [x (form/nth-of v i)]
             (recur (inc i) (if (member-of? acc x) acc (vconj acc x)))))))))

#?(:kotoba
   (defn- vindex-of [v [:ref :form/r] x [:ref :form/r]] :i64
     (let [n (form/count-of v)]
       (loop [i 0]
         (if (>= i n) -1
           (if (form/eq (form/nth-of v i) x) i (recur (inc i))))))))

#?(:kotoba
   (defn- mget [m [:ref :form/r] k [:ref :form/r]] [:ref :form/r] (form/form-get m k)))

#?(:kotoba
   (defn- mhas? [m [:ref :form/r] k [:ref :form/r]] :bool (form/form-has? m k)))

#?(:kotoba
   (defn- massoc [m [:ref :form/r] k [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (form/assoc-form m k v)))

#?(:kotoba
   (defn- mdissoc [m [:ref :form/r] k [:ref :form/r]] [:ref :form/r]
     (form/dissoc-form m k)))

#?(:kotoba
   (defn- kassoc [m [:ref :form/r] k :keyword v [:ref :form/r]] [:ref :form/r]
     (let [j (kslot m k)]
       (form/assoc-form m (if (< j 0) (form/keyword-form k) (typed-list-nth [:list [:ref :form/r]] (form/kids-of m) j)) v))))

#?(:kotoba
   (defn- mkeys [m [:ref :form/r]] [:ref :form/r]
     (let [xs (form/kids-of m)
           n (vector-count xs)]
       (form/form-vec
        (loop [j 0 acc (form/no-forms)]
          (if (>= j n) acc
            (recur (+ j 2) (form/append-form acc (typed-list-nth [:list [:ref :form/r]] xs j)))))))))

#?(:kotoba
   (defn- mvals [m [:ref :form/r]] [:ref :form/r]
     (let [xs (form/kids-of m)
           n (vector-count xs)]
       (form/form-vec
        (loop [j 1 acc (form/no-forms)]
          (if (>= j n) acc
            (recur (+ j 2) (form/append-form acc (typed-list-nth [:list [:ref :form/r]] xs j)))))))))

#?(:kotoba
   (defn- mmerge [m [:ref :form/r] n [:ref :form/r]] [:ref :form/r]
     (let [xs (form/kids-of n)
           c (vector-count xs)]
       (loop [j 0 acc m]
         (if (>= (+ j 1) c) acc
           (recur (+ j 2) (form/assoc-form acc (typed-list-nth [:list [:ref :form/r]] xs j)
                                           (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)))))))))

#?(:kotoba
   (defn- fint [n :i64] [:ref :form/r] (form/int-form n)))

#?(:kotoba
   (defn- ival [f [:ref :form/r]] :i64
     (if (form/is-int? f) (form/int-value f) 0)))

#?(:kotoba
   (defn- ival-or [f [:ref :form/r] default :i64] :i64
     (if (form/is-int? f) (form/int-value f) default)))

#?(:kotoba
   (defn- kwf [k :keyword] [:ref :form/r] (form/keyword-form k)))

#?(:kotoba
   (defn- kw-text [f [:ref :form/r]] :string
     (document-edn-print (document-keyword (form/keyword-value f)))))

#?(:kotoba
   (defn- physical-register? [target [:ref :form/r] value [:ref :form/r]] :bool
     (and (form/is-keyword? value)
          (physical-register-kw? (kw-of target) (form/keyword-value value)))))

#?(:kotoba
   (defn- register? [virtual? :bool target [:ref :form/r] value [:ref :form/r]] :bool
     (if virtual? (gmir/vreg? value) (physical-register? target value))))

#?(:kotoba
   (defn- call-operation? [op :keyword] :bool
     (or (= op :mir/call) (= op :mir/tail-call) (= op :mir/runtime-call) (= op :mir/capability-call))))

#?(:kotoba
   (defn- prefix-of [xs [:ref :form/r] n :i64] [:ref :form/r]
     (form/form-vec
      (loop [i 0 acc (form/no-forms)]
        (if (>= i n) acc (recur (inc i) (form/append-form acc (form/nth-of xs i))))))))

#?(:kotoba
   (defn- all-registers? [virtual? :bool target [:ref :form/r] xs [:ref :form/r]] :bool
     (let [n (form/count-of xs)]
       (loop [i 0]
         (if (>= i n) true
           (if (register? virtual? target (form/nth-of xs i)) (recur (inc i)) false))))))

#?(:kotoba
   (defn- field-register-ok? [virtual? :bool target [:ref :form/r] ins [:ref :form/r] k :keyword] :bool
     (let [v (fget ins k)]
       (or (form/is-nil? v) (register? virtual? target v)))))

#?(:kotoba
   (defn- scalar-registers-ok? [virtual? :bool target [:ref :form/r] ins [:ref :form/r]] :bool
     (and (field-register-ok? virtual? target ins :mir/dst)
          (field-register-ok? virtual? target ins :mir/src)
          (field-register-ok? virtual? target ins :mir/input)
          (field-register-ok? virtual? target ins :mir/left)
          (field-register-ok? virtual? target ins :mir/right)
          (field-register-ok? virtual? target ins :mir/addend)
          (field-register-ok? virtual? target ins :mir/test)
          (field-register-ok? virtual? target ins :mir/base)
          (field-register-ok? virtual? target ins :mir/length)
          (field-register-ok? virtual? target ins :mir/second-base)
          (field-register-ok? virtual? target ins :mir/second-length)
          (field-register-ok? virtual? target ins :mir/count)
          (field-register-ok? virtual? target ins :mir/stored)
          (field-register-ok? virtual? target ins :mir/offset)
          (field-register-ok? virtual? target ins :mir/size))))

#?(:kotoba
   (defn- registers-ok? [virtual? :bool target [:ref :form/r] ins [:ref :form/r]] :bool
     (and (scalar-registers-ok? virtual? target ins)
          (let [a (fget ins :mir/arguments)]
            (or (not (form/is-vec? a)) (all-registers? virtual? target a)))
          (let [a (fget ins :mir/parameters)]
            (or (not (form/is-vec? a)) (all-registers? virtual? target a))))))

#?(:kotoba
   (defn- phi-incomings-ok? [virtual? :bool target [:ref :form/r] incomings [:ref :form/r]] :bool
     (and (form/is-vec? incomings)
          (let [n (form/count-of incomings)]
            (loop [i 0]
              (if (>= i n) true
                (let [inc-f (form/nth-of incomings i)]
                  (if (and (form/is-map? inc-f)
                           (form/eq (form/keys-of inc-f) (form/edn-form "#{:mir/predecessor :mir/value}"))
                           (gmir/label? (fget inc-f :mir/predecessor))
                           (register? virtual? target (fget inc-f :mir/value)))
                    (recur (inc i))
                    false))))))))

#?(:kotoba
   (defn- runtime-call-ok? [ins [:ref :form/r]] :bool
     (let [runtime (fget ins :mir/runtime)
           arities (gmir/runtime-operation-arities)]
       (and (form/form-has? arities runtime)
            (int-eq? (form/form-get arities runtime) (form/count-of (fget ins :mir/arguments)))
            (form/eq (form/form-get (runtime-context-offsets) runtime) (fget ins :mir/context-offset))))))

#?(:kotoba
   (defn- runtime-call-physical-ok? [target [:ref :form/r] ins [:ref :form/r]] :bool
     (let [args (fget ins :mir/arguments)]
       (and (form/eq (fget ins :mir/dst) (form/form-get (return-registers) target))
            (form/eq args (prefix-of (form/form-get (runtime-argument-registers) target)
                                     (form/count-of args)))))))

#?(:kotoba
   (defn- x86-privileged-ok? [target [:ref :form/r] ins [:ref :form/r]] :bool
     (let [action (fget ins :mir/action)
           arities (gmir/x86-privileged-action-arities)]
       (and (kw? target :x86-64)
            (form/form-has? arities action)
            (int-eq? (form/form-get arities action) (form/count-of (fget ins :mir/arguments)))))))

#?(:kotoba
   (defn- capability-call-ok? [ins [:ref :form/r]] :bool
     (let [kind (fget ins :mir/kind)]
       (and (form/form-has? (gmir/capability-kinds) kind)
            (int-in? (fget ins :mir/capability) 0 255)
            (= 1 (form/count-of (fget ins :mir/arguments)))
            (form/eq (form/form-get (capability-context-offsets) kind) (fget ins :mir/context-offset))))))

#?(:kotoba
   (defn- capability-call-physical-ok? [target [:ref :form/r] ins [:ref :form/r]] :bool
     (and (form/eq (fget ins :mir/dst) (form/form-get (return-registers) target))
          (form/eq (fget ins :mir/arguments)
                   (form/form-get (form/form-get (capability-argument-registers) target) (fget ins :mir/kind))))))

#?(:kotoba
   (defn- direct-call-shape-ok? [version :i64 ins [:ref :form/r]] :bool
     (let [args (fget ins :mir/arguments)]
       (and (= 3 version)
            (gmir/function-id? (fget ins :mir/callee))
            (form/is-vec? args)
            (<= (form/count-of args) (gmir/max-arity))))))

#?(:kotoba
   (defn- direct-call-physical-ok? [op :keyword target [:ref :form/r] ins [:ref :form/r]] :bool
     (let [args (fget ins :mir/arguments)
           regs (form/form-get (call-argument-registers) target)]
       (and (or (= op :mir/tail-call)
                (form/eq (fget ins :mir/dst) (form/form-get (return-registers) target)))
            (<= (form/count-of args) (form/count-of regs))
            (form/eq args (prefix-of regs (form/count-of args)))))))

#?(:kotoba
   (defn- arity-vector-ok? [v [:ref :form/r]] :bool
     (and (form/is-vec? v) (<= (form/count-of v) (gmir/max-arity)))))

#?(:kotoba
   (defn- profile-problem [version :i64 virtual? :bool target [:ref :form/r] ins [:ref :form/r]] :keyword
     (let [opf (fget ins :mir/op)
           op (kw-of opf)
           maximum (fget ins :mir/maximum)]
       (cond
         (not (and (operation-allowed? version op)
                   (keyset-matches? op (form/keys-of ins)))) :non-canonical-instruction
         (and virtual? (or (= op :mir/spill-load) (= op :mir/spill-store) (= op :mir/move))) :physical-operation-in-virtual-program
         (and (or (= op :mir/reentry) (= op :mir/recur)) (or virtual? (not (= 3 version)))) :direct-reentry-profile-violation
         (and virtual? (or (= op :mir/multiply-add) (= op :mir/multiply-subtract))) :target-selected-operation-in-virtual-program
         (and (= op :mir/branch-nonzero) (not (kw? target :aarch64))) :target-selected-operation-target-mismatch
         (not (registers-ok? virtual? target ins)) :register-profile-violation
         (and (indexed-memory-op? op)
              (not (register? virtual? target (fget ins :mir/index)))) :register-profile-violation
         (and (window-op? op)
              (not (window-maximum? maximum))) :invalid-kernel-memory-maximum
         (and (slice-op? op)
              (not (int-eq? maximum (slice-item-limit)))) :invalid-kernel-memory-maximum
         (and (lock-op? op)
              (not (int-eq? maximum 4096))) :invalid-kernel-memory-maximum
         (and (atomic-op? op)
              (not (int-eq? maximum 4096))) :invalid-kernel-memory-maximum
         (and (= op :mir/kernel-dot-f32)
              (not (int-eq? maximum (kernel-dot-f32-maximum)))) :invalid-kernel-memory-maximum
         (and (dequant-op? op)
              (not (int-eq? maximum (kernel-dequant-dot-maximum)))) :invalid-kernel-memory-maximum
         (and (= op :mir/return) (not (register? virtual? target (fget ins :mir/value)))) :register-profile-violation
         :else :ok))))

#?(:kotoba
   (defn- transfer-problem [version :i64 virtual? :bool target [:ref :form/r] ins [:ref :form/r]] :keyword
     (let [op (kw-of (fget ins :mir/op))
           direct? (or (= op :mir/call) (= op :mir/tail-call))]
       (cond
         (and (= op :mir/phi) (not virtual?)) :phi-in-physical-program
         (and (= op :mir/phi)
              (not (phi-incomings-ok? virtual? target (fget ins :mir/incomings)))) :invalid-phi-incomings
         (and direct? (not (direct-call-shape-ok? version ins))) :invalid-call
         (and direct? (not virtual?)
              (not (direct-call-physical-ok? op target ins))) :physical-call-profile-violation
         (and (= op :mir/reentry) (not (arity-vector-ok? (fget ins :mir/parameters)))) :invalid-direct-reentry
         (and (= op :mir/recur) (not (arity-vector-ok? (fget ins :mir/arguments)))) :invalid-direct-recur
         (and (= op :mir/runtime-call) (not (runtime-call-ok? ins))) :invalid-runtime-call
         (and (= op :mir/runtime-call) (not virtual?)
              (not (runtime-call-physical-ok? target ins))) :physical-runtime-call-profile-violation
         (and (= op :mir/x86-privileged) (not (x86-privileged-ok? target ins))) :invalid-x86-privileged
         (and (= op :mir/capability-call) (not (capability-call-ok? ins))) :invalid-capability-call
         (and (= op :mir/capability-call) (not virtual?)
              (not (capability-call-physical-ok? target ins))) :physical-capability-call-profile-violation
         :else :ok))))

#?(:kotoba
   (defn- operand-problem [virtual? :bool target [:ref :form/r] frame-slots [:ref :form/r] ins [:ref :form/r]] :keyword
     (let [opf (fget ins :mir/op)
           op (kw-of opf)
           index (fget ins :mir/index)
           slot (fget ins :mir/slot)
           id (if (= op :mir/label) (fget ins :mir/id) (fget ins :mir/target))]
       (cond
         (and (= op :mir/constant) (not (gmir/i64-value? (fget ins :mir/value)))) :constant-not-i64
         (and (= op :mir/quotient-constant) (not (gmir/i64-value? (fget ins :mir/divisor)))) :constant-divisor-not-i64
         (and (= op :mir/data-address) (not (form/is-string? (fget ins :mir/content)))) :invalid-data-content
         (and (= op :mir/rodata-address)
              (not (gmir/rodata-content? (fget ins :mir/rodata-encoding) (fget ins :mir/content)))) :invalid-rodata-content
         (and (= op :mir/function-address) (not (gmir/function-id? (fget ins :mir/function)))) :invalid-function-address
         (and (= op :mir/argument)
              (not (and (form/is-int? index) (>= (form/int-value index) 0)))) :argument-index-invalid
         (and (or (= op :mir/spill-load) (= op :mir/spill-store))
              (not (and (form/is-int? slot)
                        (form/is-int? frame-slots)
                        (<= 0 (form/int-value slot))
                        (< (form/int-value slot) (form/int-value frame-slots))))) :spill-slot-invalid
         (and (stack-argument-op? op)
              (not (and (form/is-int? index)
                        (<= (call-register-count (kw-of target)) (form/int-value index))
                        (< (form/int-value index) (gmir/max-arity))))) :stack-argument-index-invalid
         (and (or (= op :mir/label) (= op :mir/branch-zero) (= op :mir/branch-nonzero) (= op :mir/jump))
              (not (gmir/label? id))) :invalid-label
         :else :ok))))

#?(:kotoba
   (defn- instruction-problem [version :i64 virtual? :bool target [:ref :form/r] frame-slots [:ref :form/r] ins [:ref :form/r]] :keyword
     (let [a (profile-problem version virtual? target ins)]
       (if (= a :ok)
         (let [b (transfer-problem version virtual? target ins)]
           (if (= b :ok)
             (operand-problem virtual? target frame-slots ins)
             b))
         a))))

#?(:kotoba
   (defn- each-instruction-problem [version :i64 virtual? :bool target [:ref :form/r] frame-slots [:ref :form/r] instructions [:ref :form/r]] :keyword
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) :ok
           (let [p (instruction-problem version virtual? target frame-slots (form/nth-of instructions i))]
             (if (= p :ok) (recur (inc i)) p)))))))

#?(:kotoba
   (defn- label-index [instructions [:ref :form/r] id [:ref :form/r] limit :i64] :i64
     (loop [i 0]
       (if (>= i limit) -1
         (let [ins (form/nth-of instructions i)]
           (if (and (kw? (fget ins :mir/op) :mir/label) (form/eq (fget ins :mir/id) id))
             i
             (recur (inc i))))))))

#?(:kotoba
   (defn- duplicate-label? [instructions [:ref :form/r]] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) false
           (let [ins (form/nth-of instructions i)]
             (if (and (kw? (fget ins :mir/op) :mir/label)
                      (>= (label-index instructions (fget ins :mir/id) i) 0))
               true
               (recur (inc i)))))))))

#?(:kotoba
   (defn- unresolved-target? [instructions [:ref :form/r]] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) false
           (let [t (fget (form/nth-of instructions i) :mir/target)]
             (if (and (not (form/is-nil? t)) (< (label-index instructions t n) 0))
               true
               (recur (inc i)))))))))

#?(:kotoba
   (defn- flat-shape-ok? [program [:ref :form/r]] :bool
     (let [version (fget program :mir/version)
           registers (kw-of (fget program :mir/registers))
           frame-slots (fget program :mir/frame-slots)]
       (and (form/is-map? program)
            (or (form/eq (form/keys-of program)
                         (form/edn-form "#{:mir/version :mir/target :mir/registers :mir/instructions}"))
                (form/eq (form/keys-of program)
                         (form/edn-form "#{:mir/version :mir/target :mir/registers :mir/instructions :mir/frame-slots}")))
            (int-in? version 1 3)
            (member-of? (targets) (fget program :mir/target))
            (or (= registers :virtual) (= registers :physical))
            (form/is-vec? (fget program :mir/instructions))
            (or (form/is-nil? frame-slots)
                (and (= registers :physical)
                     (int-in? frame-slots 0 4095)))))))

#?(:kotoba
   (defn- flat-parts-problem [version :i64 target [:ref :form/r] registers :keyword frame-slots [:ref :form/r] instructions [:ref :form/r]] :keyword
     (let [virtual? (= registers :virtual)
           p (each-instruction-problem version virtual? target frame-slots instructions)]
       (cond
         (not (= p :ok)) p
         (duplicate-label? instructions) :duplicate-label
         (unresolved-target? instructions) :unresolved-target
         :else :ok))))

#?(:kotoba
   (defn- flat-problem [program [:ref :form/r]] :keyword
     (if (flat-shape-ok? program)
       (flat-parts-problem (form/int-value (fget program :mir/version))
                           (fget program :mir/target)
                           (kw-of (fget program :mir/registers))
                           (fget program :mir/frame-slots)
                           (fget program :mir/instructions))
       :non-canonical-program)))

#?(:kotoba
   (defn- function-named [functions [:ref :form/r] name [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of functions)]
       (loop [i 0]
         (if (>= i n) (form/nil-form)
           (let [f (form/nth-of functions i)]
             (if (form/eq (fget f :mir/name) name) f (recur (inc i)))))))))

#?(:kotoba
   (defn- distinct-names? [names [:ref :form/r]] :bool
     (let [n (form/count-of names)]
       (loop [i 0]
         (if (>= i n) true
           (let [x (form/nth-of names i)]
             (if (loop [j 0]
                   (if (>= j i) false (if (form/eq (form/nth-of names j) x) true (recur (inc j)))))
               false
               (recur (inc i)))))))))

#?(:kotoba
   (defn- all-function-ids? [names [:ref :form/r]] :bool
     (let [n (form/count-of names)]
       (loop [i 0]
         (if (>= i n) true
           (if (gmir/function-id? (form/nth-of names i)) (recur (inc i)) false))))))

#?(:kotoba
   (defn- names-of [functions [:ref :form/r]] [:ref :form/r]
     (form/form-vec
      (let [n (form/count-of functions)]
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (recur (inc i) (form/append-form acc (fget (form/nth-of functions i) :mir/name)))))))))

#?(:kotoba
   (defn- op-matches? [kind :i64 op :keyword] :bool
     (cond
       (= kind 0) (or (call-operation? op) (= op :mir/recur))
       (= kind 1) (or (= op :mir/call) (= op :mir/tail-call))
       (= kind 2) (= op :mir/argument)
       (= kind 3) (= op :mir/incoming-load)
       (= kind 4) (= op :mir/reentry)
       (= kind 5) (= op :mir/recur)
       :else false)))

#?(:kotoba
   (defn- filter-ops [instructions [:ref :form/r] kind :i64] [:ref :form/r]
     (form/form-vec
      (let [n (form/count-of instructions)]
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (let [ins (form/nth-of instructions i)]
              (recur (inc i)
                     (if (op-matches? kind (kw-of (fget ins :mir/op))) (form/append-form acc ins) acc)))))))))

#?(:kotoba
   (defn- field-vec [xs [:ref :form/r] field :keyword] [:ref :form/r]
     (form/form-vec
      (let [n (form/count-of xs)]
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (recur (inc i) (form/append-form acc (fget (form/nth-of xs i) field)))))))))

#?(:kotoba
   (defn- range-vec [n :i64] [:ref :form/r]
     (form/form-vec
      (loop [i 0 acc (form/no-forms)]
        (if (>= i n) acc (recur (inc i) (form/append-form acc (form/int-form i))))))))

#?(:kotoba
   (defn- all-index-below? [xs [:ref :form/r] arity :i64] :bool
     (let [n (form/count-of xs)]
       (loop [i 0]
         (if (>= i n) true
           (let [x (fget (form/nth-of xs i) :mir/index)]
             (if (and (form/is-int? x) (< (form/int-value x) arity)) (recur (inc i)) false)))))))

#?(:kotoba
   (defn- entry-arguments-ok? [target [:ref :form/r] arity :i64 instructions [:ref :form/r]] :bool
     (let [regs (form/form-get (call-argument-registers) target)
           register-arity (if (< arity (form/count-of regs)) arity (form/count-of regs))
           arguments (filter-ops instructions 2)]
       (and (= register-arity (form/count-of arguments))
            (form/eq (range-vec register-arity) (field-vec arguments :mir/index))
            (form/eq (prefix-of regs register-arity) (field-vec arguments :mir/dst))
            (all-index-below? (filter-ops instructions 3) arity)))))

#?(:kotoba
   (defn- prefix-state-ok? [instructions [:ref :form/r] from :i64 to :i64 registers [:ref :form/r] slots [:ref :form/r]] [:ref :form/r]
     ;; Returns the final registers map, or a nil form when the prefix is invalid.
     (if (>= from to)
       registers
       (let [ins (form/nth-of instructions from)
             op (kw-of (fget ins :mir/op))
             src (fget ins :mir/src)
             dst (fget ins :mir/dst)
             slot (fget ins :mir/slot)]
         (cond
           (= op :mir/move)
           (if (form/form-has? registers src)
             (prefix-state-ok? instructions (inc from) to (form/assoc-form registers dst (form/form-get registers src)) slots)
             (form/nil-form))
           (= op :mir/spill-store)
           (if (form/form-has? registers src)
             (prefix-state-ok? instructions (inc from) to registers (form/assoc-form slots slot (form/form-get registers src)))
             (form/nil-form))
           (= op :mir/spill-load)
           (if (form/form-has? slots slot)
             (prefix-state-ok? instructions (inc from) to (form/assoc-form registers dst (form/form-get slots slot)) slots)
             (form/nil-form))
           :else (form/nil-form))))))

#?(:kotoba
   (defn- initial-registers [abi [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (form/count-of abi))
       acc
       (initial-registers abi (inc i) (form/assoc-form acc (form/nth-of abi i) (form/int-form i))))))

#?(:kotoba
   (defn- parameters-map-home? [registers [:ref :form/r] parameters [:ref :form/r] arity :i64] :bool
     (let [n (form/count-of parameters)]
       (and (= n arity)
            (loop [i 0]
              (if (>= i n) true
                (let [p (form/nth-of parameters i)]
                  (if (and (form/form-has? registers p) (int-eq? (form/form-get registers p) i))
                    (recur (inc i))
                    false))))))))

#?(:kotoba
   (defn- valid-direct-reentry-prefix? [target [:ref :form/r] arity :i64 instructions [:ref :form/r] reentry-index :i64 parameters [:ref :form/r]] :bool
     (let [abi (prefix-of (form/form-get (call-argument-registers) target) arity)
           n (form/count-of instructions)
           prefix-count (if (< arity n) arity n)
           prefix (prefix-of instructions prefix-count)]
       (and (= arity prefix-count)
            (form/eq (range-vec arity) (field-vec prefix :mir/index))
            (form/eq abi (field-vec prefix :mir/dst))
            (= prefix-count (form/count-of (filter-ops prefix 2)))
            (<= arity reentry-index)
            (let [result (prefix-state-ok? instructions arity reentry-index
                                           (initial-registers abi 0 (form/form-map (form/no-forms)))
                                           (form/form-map (form/no-forms)))]
              (and (form/is-map? result)
                   (parameters-map-home? result parameters arity)))))))

#?(:kotoba
   (defn- first-reentry-index [instructions [:ref :form/r]] :i64
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) -1
           (if (kw? (fget (form/nth-of instructions i) :mir/op) :mir/reentry) i (recur (inc i))))))))

#?(:kotoba
   (defn- recur-terminates? [instructions [:ref :form/r]] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) true
           (if (kw? (fget (form/nth-of instructions i) :mir/op) :mir/recur)
             (if (or (>= (inc i) n) (kw? (fget (form/nth-of instructions (inc i)) :mir/op) :mir/label))
               (recur (inc i))
               false)
             (recur (inc i))))))))

#?(:kotoba
   (defn- every-arguments-eq? [recurs [:ref :form/r] parameters [:ref :form/r]] :bool
     (let [n (form/count-of recurs)]
       (loop [i 0]
         (if (>= i n) true
           (if (form/eq parameters (fget (form/nth-of recurs i) :mir/arguments)) (recur (inc i)) false))))))

#?(:kotoba
   (defn- reentry-contract-ok? [target [:ref :form/r] arity :i64 instructions [:ref :form/r]] :bool
     (let [regs (form/form-get (call-argument-registers) target)
           register-arity (if (< arity (form/count-of regs)) arity (form/count-of regs))
           reentries (filter-ops instructions 4)
           recurs (filter-ops instructions 5)]
       (if (> (form/count-of recurs) 0)
         (let [params (fget (form/nth-of reentries 0) :mir/parameters)]
           (and (= 1 (form/count-of reentries))
                (= register-arity (form/count-of params))
                (and (= register-arity (form/count-of params)) (distinct-names? params))
                (valid-direct-reentry-prefix? target register-arity instructions
                                              (first-reentry-index instructions) params)
                (recur-terminates? instructions)
                (every-arguments-eq? recurs params)))
         (= 0 (form/count-of reentries))))))

#?(:kotoba
   (defn- value-op? [opf [:ref :form/r]] :bool
     (let [op (kw-of opf)]
       (or (window-op? op) (slice-op? op) (atomic-op? op) (value-op-listed? op)))))

#?(:kotoba
   (defn- unbacked-value? [instructions [:ref :form/r]] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) false
           (let [ins (form/nth-of instructions i)]
             (if (value-op? (fget ins :mir/op))
               (let [store (form/nth-of instructions (inc i))]
                 (if (and (kw? (fget store :mir/op) :mir/spill-store)
                          (form/eq (fget ins :mir/dst) (fget store :mir/src)))
                   (recur (inc i))
                   true))
               (recur (inc i)))))))))

#?(:kotoba
   (defn- slice-vec [xs [:ref :form/r] from :i64 n :i64] [:ref :form/r]
     (form/form-vec
      (loop [i 0 acc (form/no-forms)]
        (if (>= i n) acc (recur (inc i) (form/append-form acc (form/nth-of xs (+ from i)))))))))

#?(:kotoba
   (defn- all-spill-loads? [xs [:ref :form/r]] :bool
     (let [n (form/count-of xs)]
       (loop [i 0]
         (if (>= i n) true
           (if (kw? (fget (form/nth-of xs i) :mir/op) :mir/spill-load) (recur (inc i)) false))))))

#?(:kotoba
   (defn- call-loads-ok? [instructions [:ref :form/r] index :i64 arguments [:ref :form/r]] :bool
     (let [k (form/count-of arguments)]
       (and (>= index k)
            (let [loads (slice-vec instructions (- index k) k)]
              (and (all-spill-loads? loads)
                   (form/eq arguments (field-vec loads :mir/dst))))))))

#?(:kotoba
   (defn- non-parallel-call-arguments? [instructions [:ref :form/r]] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) false
           (let [ins (form/nth-of instructions i)]
             (if (call-operation? (kw-of (fget ins :mir/op)))
               (if (call-loads-ok? instructions i (fget ins :mir/arguments))
                 (recur (inc i))
                 true)
               (recur (inc i)))))))))

#?(:kotoba
   (defn- has-index? [pending [:list [:ref :form/r]] idx :i64] :bool
     (let [n (vector-count pending)]
       (loop [i 0]
         (if (>= i n) false
           (if (int-eq? (fget (typed-list-nth [:list [:ref :form/r]] pending i) :mir/index) idx)
             true
             (recur (inc i))))))))

#?(:kotoba
   (defn- pending-covers? [pending [:list [:ref :form/r]] from :i64 w :i64] :bool
     (loop [k 0]
       (if (>= k w) true
         (if (has-index? pending (+ from k)) (recur (inc k)) false)))))

#?(:kotoba
   (defn- pending-all-op? [pending [:list [:ref :form/r]] op :keyword] :bool
     (let [n (vector-count pending)]
       (loop [i 0]
         (if (>= i n) true
           (if (kw? (fget (typed-list-nth [:list [:ref :form/r]] pending i) :mir/op) op)
             (recur (inc i))
             false))))))

#?(:kotoba
   (defn- callee-arity-of [op :keyword ins [:ref :form/r] arity :i64 functions [:ref :form/r]] :i64
     (cond
       (or (= op :mir/call) (= op :mir/tail-call))
       (let [f (function-named functions (fget ins :mir/callee))
             a (fget f :mir/arity)]
         (if (form/is-int? a) (form/int-value a) 0))
       (= op :mir/recur) arity
       :else 0)))

#?(:kotoba
   (defn- pending-ok? [pending [:list [:ref :form/r]] op :keyword register-count :i64 callee-arity :i64] :bool
     (let [w (if (> callee-arity register-count) (- callee-arity register-count) 0)
           expected-op (if (or (= op :mir/tail-call) (= op :mir/recur))
                         :mir/incoming-argument-store
                         :mir/outgoing-argument)]
       (and (= w (vector-count pending))
            (pending-covers? pending register-count w)
            (pending-all-op? pending expected-op)))))

#?(:kotoba
   (defn- stack-arguments-ok? [target [:ref :form/r] arity :i64 functions [:ref :form/r] instructions [:ref :form/r]] :bool
     (let [register-count (call-register-count (kw-of target))
           n (form/count-of instructions)]
       (loop [i 0 pending (form/no-forms)]
         (if (>= i n)
           (= 0 (vector-count pending))
           (let [ins (form/nth-of instructions i)
                 op (kw-of (fget ins :mir/op))]
             (cond
               (or (= op :mir/outgoing-argument) (= op :mir/incoming-argument-store))
               (recur (inc i) (form/append-form pending ins))
               (or (call-operation? op) (= op :mir/recur))
               (if (pending-ok? pending op register-count (callee-arity-of op ins arity functions))
                 (recur (inc i) (form/no-forms))
                 false)
               :else (recur (inc i) pending))))))))

#?(:kotoba
   (defn- direct-calls-problem [physical? :bool target [:ref :form/r] functions [:ref :form/r] instructions [:ref :form/r]] :keyword
     (let [register-count (call-register-count (kw-of target))
           n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) :ok
           (let [ins (form/nth-of instructions i)
                 op (kw-of (fget ins :mir/op))]
             (if (or (= op :mir/call) (= op :mir/tail-call))
               (let [f (function-named functions (fget ins :mir/callee))]
                 (if (form/is-nil? f)
                   :unresolved-callee
                   (let [callee-arity (form/int-value (fget f :mir/arity))
                         expected (if (and physical? (> callee-arity register-count)) register-count callee-arity)]
                     (if (= expected (form/count-of (fget ins :mir/arguments)))
                       (recur (inc i))
                       :call-arity-mismatch))))
               (recur (inc i)))))))))

#?(:kotoba
   (defn- policy-ok? [calls? :bool policy :keyword] :bool
     (if calls?
       (or (= policy :all-vregs) (= policy :call-live))
       (= policy :allocator))))

#?(:kotoba
   (defn- function-shape-ok? [registers :keyword f [:ref :form/r]] :bool
     (let [virtual? (= registers :virtual)
           policy (kw-of (fget f :mir/frame-policy))]
       (and (form/is-map? f)
            (form/eq (form/keys-of f)
                     (if virtual?
                       (form/edn-form "#{:mir/name :mir/arity :mir/instructions}")
                       (form/edn-form "#{:mir/name :mir/arity :mir/frame-slots :mir/frame-policy :mir/instructions}")))
            (gmir/function-id? (fget f :mir/name))
            (int-in? (fget f :mir/arity) 0 (gmir/max-arity))
            (or virtual? (= policy :allocator) (= policy :all-vregs) (= policy :call-live))))))

#?(:kotoba
   (defn- function-problem [target [:ref :form/r] registers :keyword functions [:ref :form/r] f [:ref :form/r]] :keyword
     (let [physical? (= registers :physical)
           instructions (fget f :mir/instructions)
           frame-slots (fget f :mir/frame-slots)
           policy (kw-of (fget f :mir/frame-policy))
           arity (if (form/is-int? (fget f :mir/arity)) (form/int-value (fget f :mir/arity)) 0)]
       (cond
         (not (function-shape-ok? registers f)) :non-canonical-function
         (not (and (form/is-vec? instructions)
                   (or (form/is-nil? frame-slots)
                       (and physical? (int-in? frame-slots 0 4095))))) :non-canonical-program
         (not (= :ok (flat-parts-problem 3 target registers frame-slots instructions)))
         (flat-parts-problem 3 target registers frame-slots instructions)
         (and physical? (not (entry-arguments-ok? target arity instructions))) :entry-argument-profile-violation
         (and physical?
              (not (policy-ok? (> (form/count-of (filter-ops instructions 0)) 0) policy))) :call-frame-policy-violation
         (and physical? (not (reentry-contract-ok? target arity instructions))) :invalid-direct-reentry-contract
         (and physical? (= policy :all-vregs) (unbacked-value? instructions)) :unbacked-call-frame-value
         (and physical? (= policy :all-vregs) (non-parallel-call-arguments? instructions)) :non-parallel-call-arguments
         (not (= :ok (direct-calls-problem physical? target functions instructions)))
         (direct-calls-problem physical? target functions instructions)
         (and physical? (not (stack-arguments-ok? target arity functions instructions))) :stack-argument-profile-violation
         :else :ok))))

#?(:kotoba
   (defn- functions-problem [target [:ref :form/r] registers :keyword functions [:ref :form/r]] :keyword
     (let [n (form/count-of functions)]
       (loop [i 0]
         (if (>= i n) :ok
           (let [p (function-problem target registers functions (form/nth-of functions i))]
             (if (= p :ok) (recur (inc i)) p)))))))

#?(:kotoba
   (defn- module-problem [module [:ref :form/r]] :keyword
     (let [target (fget module :mir/target)
           registers (kw-of (fget module :mir/registers))
           entry (fget module :mir/entry)
           functions (fget module :mir/functions)
           names (names-of functions)]
       (cond
         (not (and (form/is-map? module)
                   (form/eq (form/keys-of module)
                            (form/edn-form "#{:mir/version :mir/target :mir/registers :mir/entry :mir/functions}"))
                   (member-of? (targets) target)
                   (or (= registers :virtual) (= registers :physical))
                   (gmir/function-id? entry)
                   (form/is-vec? functions)
                   (> (form/count-of functions) 0))) :non-canonical-module
         (not (and (all-function-ids? names)
                   (distinct-names? names)
                   (member-of? names entry))) :invalid-module-functions
         :else (functions-problem target registers functions)))))

#?(:kotoba
   (defn validate-problem [program [:ref :form/r]] :keyword
     (if (int-eq? (fget program :mir/version) 3)
       (module-problem program)
       (flat-problem program))))

#?(:kotoba
   (defn- gmir-keyword-of [k :keyword] :keyword
     (let [t (document-edn-print (document-keyword k))]
       (keyword-from-string (string-concat "gmir/" (string-substring t 5 (string-byte-length t)))))))

#?(:kotoba
   (defn- gmir-incoming [incoming [:ref :form/r]] [:ref :form/r]
     (form/form-map
      (form/append-form
       (form/append-form
        (form/append-form
         (form/append-form (form/no-forms) (form/keyword-form :gmir/predecessor))
         (fget incoming :mir/predecessor))
        (form/keyword-form :gmir/value))
       (fget incoming :mir/value)))))

#?(:kotoba
   (defn- gmir-incomings [incomings [:ref :form/r]] [:ref :form/r]
     (form/form-vec
      (let [n (form/count-of incomings)]
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (recur (inc i) (form/append-form acc (gmir-incoming (form/nth-of incomings i))))))))))

#?(:kotoba
   (defn- gmir-instruction [ins [:ref :form/r]] [:ref :form/r]
     (let [kids (form/kids-of ins)
           n (vector-count kids)]
       (form/form-map
        (loop [j 0 acc (form/no-forms)]
          (if (>= (+ j 1) n) acc
            (let [k (typed-list-nth [:list [:ref :form/r]] kids j)
                  v (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))]
              (if (kw? k :mir/context-offset)
                (recur (+ j 2) acc)
                (recur (+ j 2)
                       (form/append-form
                        (form/append-form acc (form/keyword-form (gmir-keyword-of (kw-of k))))
                        (cond
                          (kw? k :mir/op) (form/keyword-form (gmir-keyword-of (kw-of v)))
                          (kw? k :mir/incomings) (gmir-incomings v)
                          :else v)))))))))))

#?(:kotoba
   (defn- gmir-program-of [instructions [:ref :form/r]] [:ref :form/r]
     (form/form-map
      (form/append-form
       (form/append-form
        (form/append-form
         (form/append-form (form/no-forms) (form/keyword-form :gmir/version))
         (form/int-form 2))
        (form/keyword-form :gmir/instructions))
       (form/form-vec
        (let [n (form/count-of instructions)]
          (loop [i 0 acc (form/no-forms)]
            (if (>= i n) acc
              (recur (inc i) (form/append-form acc (gmir-instruction (form/nth-of instructions i))))))))))))

#?(:kotoba
   (defn validate!
     "Validate virtual or physical MIR and return it unchanged. v3 modules own
     independent function frames and a closed scalar direct-call graph. The
     Kotoba twin aborts with the first problem's keyword."
     [program [:ref :form/r]] [:ref :form/r]
     (let [p (validate-problem program)]
       (if (= p :ok)
         (if (and (int-eq? (fget program :mir/version) 2)
                  (kw? (fget program :mir/registers) :virtual))
           (do (gmir/validate! (gmir-program-of (fget program :mir/instructions))) program)
           program)
         (do (reject! p) program)))))

#?(:kotoba nil :default
(defn- physical-register? [target value]
  ;; Physical registers are namespaced keywords. Guard that closed type before
  ;; asking a hash set about VALUE: nbb cannot hash a JavaScript BigInt
  ;; primitive (it attempts to attach a closure uid), and integer immediates
  ;; legitimately flow through instruction-sources beside registers.
  (and (keyword? value)
       (contains? (set (concat (get physical-registers target)
                               (get leaf-registers target)
                               (get preserved-registers target)
                               (get call-argument-registers target)))
                  value))))

#?(:kotoba nil :default
(defn- call-operation? [op]
  (contains? #{:mir/call :mir/tail-call :mir/runtime-call
               :mir/capability-call} op)))

#?(:kotoba
   (defn- argument-registers-for-call [target [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))]
       (cond
         (= op :mir/runtime-call) (form/form-get (runtime-argument-registers) target)
         (= op :mir/capability-call)
         (form/form-get (form/form-get (capability-argument-registers) target) (fget instruction :mir/kind))
         :else (form/form-get (call-argument-registers) target)))))

#?(:kotoba nil :default
(defn- argument-registers-for-call [target {:mir/keys [op kind]}]
  (case op
    :mir/runtime-call (get runtime-argument-registers target)
    :mir/capability-call (get-in capability-argument-registers [target kind])
    (get call-argument-registers target))))

#?(:kotoba nil :default
(defn- validate-flat!
  [{:mir/keys [version target registers instructions frame-slots] :as program}]
  (when-not (and (map? program)
                 (contains? #{#{:mir/version :mir/target :mir/registers :mir/instructions}
                              #{:mir/version :mir/target :mir/registers :mir/instructions
                                :mir/frame-slots}}
                            (set (keys program)))
                 (contains? supported-versions version)
                 (contains? targets target)
                 (contains? #{:virtual :physical} registers)
                 (vector? instructions)
                 (or (nil? frame-slots)
                     (and (= :physical registers)
                          (integer? frame-slots)
                          (<= 0 frame-slots 4095))))
    (reject! :non-canonical-program program))
  (let [register? (if (= :virtual registers)
                    gmir/vreg?
                    #(physical-register? target %))]
    (doseq [instruction instructions]
      (let [op (:mir/op instruction)
            #?@(:kotoba [] :default [allowed (operations-for version)])]
        (when-not (and #?(:kotoba (operation-allowed? version op)
                          :default (contains? allowed op))
                       #?(:kotoba (instruction-keyset-is? op (form/keys-of instruction))
                          :default (= (get instruction-keysets op) (set (keys instruction)))))
          (reject! :non-canonical-instruction instruction))
        (when (and (= :virtual registers)
                   (contains? #{:mir/spill-load :mir/spill-store :mir/move} op))
          (reject! :physical-operation-in-virtual-program instruction))
        (when (and (contains? #{:mir/reentry :mir/recur} op)
                   (or (= :virtual registers) (not= 3 version)))
          (reject! :direct-reentry-profile-violation instruction))
        (when (and (= :virtual registers)
                   (contains? #{:mir/multiply-add :mir/multiply-subtract} op))
          (reject! :target-selected-operation-in-virtual-program instruction))
        (when (and (= :mir/branch-nonzero op) (not= :aarch64 target))
          (reject! :target-selected-operation-target-mismatch instruction))
        (doseq [register (concat
                          (keep instruction [:mir/dst :mir/src :mir/input
                                             :mir/left :mir/right :mir/addend :mir/test
                                             :mir/base :mir/length
                                             ;; simd: the second region's pair
                                             ;; and the element count.
                                             :mir/second-base :mir/second-length
                                             :mir/count
                                             :mir/stored :mir/offset :mir/size])
                          (when (vector? (:mir/arguments instruction))
                            (:mir/arguments instruction))
                          (when (vector? (:mir/parameters instruction))
                            (:mir/parameters instruction)))]
          (when-not (register? register)
            (reject! :register-profile-violation instruction)))
        ;; memwidth: one table for every windowed access instead of a clause
        ;; per width. The clause per width is how `kernel-store-u8` came to be
        ;; the only member of the family that could not name a 16 KiB window.
        ;; The set now also carries the sysops atomics, which index the same way.
        (when (and (contains? indexed-memory-operations op)
                   (not (register? (:mir/index instruction))))
          (reject! :register-profile-violation instruction))
        (when (contains? kernel-window-operations op)
          (when-not (contains? kernel-window-maxima (:mir/maximum instruction))
            (reject! :invalid-kernel-memory-maximum instruction)))
        (when (contains? slice-operations op)
          (when-not (= slice-item-limit (:mir/maximum instruction))
            (reject! :invalid-kernel-memory-maximum instruction)))
        ;; memwidth: end
        (when (contains? #{:mir/kernel-try-lock-u32 :mir/kernel-unlock-u32} op)
          (when-not (= 4096 (:mir/maximum instruction))
            (reject! :invalid-kernel-memory-maximum instruction)))
        ;; sysops: one spelling each, naming a page -- pinned as a single value
        ;; rather than a set, exactly as the lock pair's is.
        (when (contains? kernel-atomic-ops op)
          (when-not (= 4096 (:mir/maximum instruction))
            (reject! :invalid-kernel-memory-maximum instruction)))
        ;; sysops: end
        ;; simd: one spelling, one ceiling.
        (when (= :mir/kernel-dot-f32 op)
          (when-not (= kernel-dot-f32-maximum (:mir/maximum instruction))
            (reject! :invalid-kernel-memory-maximum instruction)))
        ;; simd: end
        ;; dequant: one ceiling for the whole family.
        (when (contains? kernel-dequant-dot-operations op)
          (when-not (= kernel-dequant-dot-maximum (:mir/maximum instruction))
            (reject! :invalid-kernel-memory-maximum instruction)))
        ;; dequant: end
        (when (and (= op :mir/return) (not (register? (:mir/value instruction))))
          (reject! :register-profile-violation instruction))
        (when (= op :mir/phi)
          (when (= :physical registers)
            (reject! :phi-in-physical-program instruction))
          (when-not (and (vector? (:mir/incomings instruction))
                         (every? (fn [incoming]
                                   (and (map? incoming)
                                        (= #{:mir/predecessor :mir/value}
                                           (set (keys incoming)))
                                        (gmir/label? (:mir/predecessor incoming))
                                        (register? (:mir/value incoming))))
                                 (:mir/incomings instruction)))
            (reject! :invalid-phi-incomings instruction)))
        (when (contains? #{:mir/call :mir/tail-call} op)
          (when-not (and (= 3 version)
                         (gmir/function-id? (:mir/callee instruction))
                         (vector? (:mir/arguments instruction))
                         (<= (count (:mir/arguments instruction)) gmir/max-arity))
            (reject! :invalid-call instruction))
          (when (= :physical registers)
            ;; A physical call names only the argument REGISTERS; arguments
            ;; past the fifth were stored into the frame before it.
            (when-not (and (or (= op :mir/tail-call)
                               (= (:mir/dst instruction)
                                  (get return-registers target)))
                           (<= (count (:mir/arguments instruction))
                               (count (get call-argument-registers target)))
                           (= (:mir/arguments instruction)
                              (subvec (get call-argument-registers target)
                                      0 (count (:mir/arguments instruction)))))
              (reject! :physical-call-profile-violation instruction))))
        (when (= :mir/reentry op)
          (when-not (and (vector? (:mir/parameters instruction))
                         (<= (count (:mir/parameters instruction)) gmir/max-arity))
            (reject! :invalid-direct-reentry instruction)))
        (when (= :mir/recur op)
          (when-not (and (vector? (:mir/arguments instruction))
                         (<= (count (:mir/arguments instruction)) gmir/max-arity))
            (reject! :invalid-direct-recur instruction)))
        (when (= op :mir/runtime-call)
          (let [runtime (:mir/runtime instruction)
                arguments (:mir/arguments instruction)
                expected (get gmir/runtime-operation-arities runtime ::missing)]
            (when-not (and (not= ::missing expected)
                           (= expected (count arguments))
                           (= (get runtime-context-offsets runtime)
                              (:mir/context-offset instruction)))
              (reject! :invalid-runtime-call instruction))
            (when (= :physical registers)
              (when-not (and (= (:mir/dst instruction)
                                (get return-registers target))
                             (= arguments
                                (subvec (get runtime-argument-registers target)
                                        0 (count arguments))))
                (reject! :physical-runtime-call-profile-violation instruction)))))
        (when (= op :mir/x86-privileged)
          (let [action (:mir/action instruction)
                arguments (:mir/arguments instruction)
                expected (get gmir/x86-privileged-action-arities action ::missing)]
            (when-not (and (= :x86-64 target)
                           (not= ::missing expected)
                           (= expected (count arguments)))
              (reject! :invalid-x86-privileged instruction))))
        (when (= op :mir/capability-call)
          (let [kind (:mir/kind instruction)
                capability (:mir/capability instruction)
                arguments (:mir/arguments instruction)]
            (when-not (and (contains? gmir/capability-kinds kind)
                           (integer? capability) (<= 0 capability 255)
                           (= 1 (count arguments))
                           (= (get capability-context-offsets kind)
                              (:mir/context-offset instruction)))
              (reject! :invalid-capability-call instruction))
            (when (= :physical registers)
              (when-not (and (= (:mir/dst instruction)
                                (get return-registers target))
                             (= arguments
                                (get-in capability-argument-registers
                                        [target kind])))
                (reject! :physical-capability-call-profile-violation
                         instruction)))))
        (when (and (= op :mir/constant)
                   (not (gmir/i64-value? (:mir/value instruction))))
          (reject! :constant-not-i64 instruction))
        (when (and (= op :mir/quotient-constant)
                   (not (gmir/i64-value? (:mir/divisor instruction))))
          (reject! :constant-divisor-not-i64 instruction))
        (when (and (= op :mir/data-address)
                   (not (string? (:mir/content instruction))))
          (reject! :invalid-data-content instruction))
        ;; boot-lit: re-derived from `kotoba.gmir` rather than trusted through
        ;; selection, for the reason every other re-derivation here exists: a
        ;; literal that arrives malformed at THIS layer still gets a pool
        ;; entry and an address, and the wrongness only appears as firmware
        ;; answering a question nobody asked.
        (when (and (= op :mir/rodata-address)
                   (not (gmir/rodata-content? (:mir/rodata-encoding instruction)
                                              (:mir/content instruction))))
          (reject! :invalid-rodata-content instruction))
        ;; boot-scratch: re-derived here for the reason above -- selection
        ;; copies the name through untouched, and a hand-built MIR program
        ;; that never passed `gmir/validate!` would otherwise reach the
        ;; backend's label table with something that is not a name.
        (when (and (= op :mir/function-address)
                   (not (gmir/function-id? (:mir/function instruction))))
          (reject! :invalid-function-address instruction))
        (when (and (= op :mir/argument)
                   (not (and (integer? (:mir/index instruction))
                             (not (neg? (:mir/index instruction))))))
          (reject! :argument-index-invalid instruction))
        (when (contains? #{:mir/spill-load :mir/spill-store} op)
          (when-not (and (integer? (:mir/slot instruction))
                         (some? frame-slots)
                         (<= 0 (:mir/slot instruction))
                         (< (:mir/slot instruction) frame-slots))
            (reject! :spill-slot-invalid instruction)))
        (when (contains? stack-argument-ops op)
          (when-not (and (integer? (:mir/index instruction))
                         (<= (count (get call-argument-registers target))
                             (:mir/index instruction))
                         (< (:mir/index instruction) gmir/max-arity))
            (reject! :stack-argument-index-invalid instruction)))
        (when (contains? #{:mir/label :mir/branch-zero :mir/branch-nonzero
                           :mir/jump} op)
          (let [id (if (= op :mir/label) (:mir/id instruction) (:mir/target instruction))]
            (when-not (gmir/label? id)
              (reject! :invalid-label instruction))))))
    (let [labels (map :mir/id (filter #(= :mir/label (:mir/op %)) instructions))
          label-set (set labels)
          targets (keep :mir/target instructions)]
      (when-not (= (count labels) (count label-set))
        (reject! :duplicate-label {:labels labels}))
      (doseq [branch-target targets]
        (when-not (contains? label-set branch-target)
          (reject! :unresolved-target {:target branch-target})))
      (when (and (= 2 version) (= :virtual registers))
        (gmir/validate!
         {:gmir/version 2
          :gmir/instructions
          (mapv (fn [instruction]
                  (reduce-kv
                   (fn [out key value]
                     (if (= key :mir/context-offset)
                       out
                       (assoc out
                              (case key
                                :mir/op :gmir/op
                                :mir/dst :gmir/dst
                                :mir/index :gmir/index
                                :mir/value :gmir/value
                                :mir/left :gmir/left
                                :mir/right :gmir/right
                                :mir/id :gmir/id
                                :mir/test :gmir/test
                                :mir/target :gmir/target
                                :mir/incomings :gmir/incomings
                                :mir/content :gmir/content
                                :mir/runtime :gmir/runtime
                                :mir/capability :gmir/capability
                                :mir/kind :gmir/kind
                                :mir/arguments :gmir/arguments)
                              (cond
                                (= key :mir/op) (keyword "gmir" (name value))
                                (= key :mir/incomings)
                                (mapv (fn [incoming]
                                        {:gmir/predecessor (:mir/predecessor incoming)
                                         :gmir/value (:mir/value incoming)})
                                      value)
                                :else value))))
                   {} instruction))
                instructions)}))))
  program))

#?(:kotoba nil :default
(defn- valid-direct-reentry-prefix?
  "The reentry marker is meaningful only after the public ABI arguments have
  been materialized into the homes it names. Symbolically execute the closed
  entry transport language so malformed external MIR cannot place the marker
  before a required move (or name a home containing another parameter)."
  [target arity instructions reentry-index parameters]
  (let [abi (subvec (get call-argument-registers target) 0 arity)
        argument-prefix (subvec instructions 0 (min arity (count instructions)))
        canonical-arguments?
        (and (= arity (count argument-prefix))
             (= (vec (range arity)) (mapv :mir/index argument-prefix))
             (= abi (mapv :mir/dst argument-prefix))
             (every? #(= :mir/argument (:mir/op %)) argument-prefix))]
    (when (and canonical-arguments? (<= arity reentry-index))
      (let [initial {:registers (zipmap abi (range arity)) :slots {}}
            result
            (reduce
             (fn [state {:mir/keys [op dst src slot]}]
               (if (= ::invalid state)
                 (reduced state)
                 (case op
                   :mir/move
                   (if (contains? (:registers state) src)
                     (assoc-in state [:registers dst] (get-in state [:registers src]))
                     (reduced ::invalid))

                   :mir/spill-store
                   (if (contains? (:registers state) src)
                     (assoc-in state [:slots slot] (get-in state [:registers src]))
                     (reduced ::invalid))

                   :mir/spill-load
                   (if (contains? (:slots state) slot)
                     (assoc-in state [:registers dst] (get-in state [:slots slot]))
                     (reduced ::invalid))

                   (reduced ::invalid))))
             initial
             (subvec instructions arity reentry-index))]
        (and (not= ::invalid result)
             (= (vec (range arity))
                (mapv #(get-in result [:registers %]) parameters))))))))

#?(:kotoba nil :default
(defn- validate-v3-module!
  [{:mir/keys [target registers entry functions] :as module}]
  (when-not (and (= #{:mir/version :mir/target :mir/registers
                      :mir/entry :mir/functions}
                    (set (keys module)))
                 (contains? targets target)
                 (contains? #{:virtual :physical} registers)
                 (gmir/function-id? entry)
                 (vector? functions)
                 (seq functions))
    (reject! :non-canonical-module module))
  (let [names (mapv :mir/name functions)
        signatures (into {} (map (juxt :mir/name :mir/arity) functions))]
    (when-not (and (every? gmir/function-id? names)
                   (= (count names) (count (distinct names)))
                   (contains? signatures entry))
      (reject! :invalid-module-functions {:entry entry :names names}))
    (doseq [{:mir/keys [name arity frame-slots frame-policy instructions]
             :as function} functions]
      (let [expected-keys (if (= :virtual registers)
                            #{:mir/name :mir/arity :mir/instructions}
                            #{:mir/name :mir/arity :mir/frame-slots
                              :mir/frame-policy :mir/instructions})
            calls (filter #(or (call-operation? (:mir/op %))
                               (= :mir/recur (:mir/op %)))
                          instructions)
            direct-calls (filter #(contains? #{:mir/call :mir/tail-call}
                                              (:mir/op %)) instructions)]
        (when-not (and (= expected-keys (set (keys function)))
                       (gmir/function-id? name)
                       (integer? arity) (<= 0 arity gmir/max-arity)
                       (or (= :virtual registers)
                           (contains? #{:allocator :all-vregs :call-live}
                                      frame-policy)))
          (reject! :non-canonical-function function))
        (validate-flat!
         (cond-> {:mir/version 3 :mir/target target :mir/registers registers
                  :mir/instructions instructions}
           (= :physical registers) (assoc :mir/frame-slots frame-slots)))
        (when (= :physical registers)
          ;; Arguments past the register count arrive on the stack and are
          ;; read by `:mir/incoming-load`, so only the register ones are
          ;; `:mir/argument` markers here.
          (let [register-arity (min arity (count (get call-argument-registers target)))
                arguments (filterv #(= :mir/argument (:mir/op %)) instructions)
                expected-registers (subvec (get call-argument-registers target)
                                           0 register-arity)]
            (when-not (and (= register-arity (count arguments))
                           (= (vec (range register-arity)) (mapv :mir/index arguments))
                           (= expected-registers (mapv :mir/dst arguments))
                           (every? #(< (:mir/index %) arity)
                                   (filter #(= :mir/incoming-load (:mir/op %))
                                           instructions)))
              (reject! :entry-argument-profile-violation
                       {:function name :arguments arguments}))))
        (when (and (= :physical registers)
                   (if (seq calls)
                     (not (contains? #{:all-vregs :call-live} frame-policy))
                     (not= :allocator frame-policy)))
          (reject! :call-frame-policy-violation function))
        (when (= :physical registers)
          (let [register-arity (min arity (count (get call-argument-registers target)))
                reentries (filterv #(= :mir/reentry (:mir/op %)) instructions)
                recurs (filterv #(= :mir/recur (:mir/op %)) instructions)
                reentry-index (first (keep-indexed
                                      #(when (= :mir/reentry (:mir/op %2)) %1)
                                      instructions))
                recur-terminates?
                (every? (fn [[index instruction]]
                          (if (= :mir/recur (:mir/op instruction))
                            (let [next-instruction (get instructions (inc index))]
                              (or (nil? next-instruction)
                                  (= :mir/label (:mir/op next-instruction))))
                            true))
                        (map-indexed vector instructions))]
            (when-not (if (seq recurs)
                        (and (= 1 (count reentries))
                             (= register-arity (count (:mir/parameters (first reentries))))
                             (= register-arity
                                (count (distinct
                                        (:mir/parameters (first reentries)))))
                             (valid-direct-reentry-prefix?
                              target register-arity instructions reentry-index
                              (:mir/parameters (first reentries)))
                             recur-terminates?
                             (every? #(= (:mir/parameters (first reentries))
                                         (:mir/arguments %))
                                     recurs))
                        (empty? reentries))
              (reject! :invalid-direct-reentry-contract function))))
        (when (and (= :physical registers) (= :all-vregs frame-policy))
          (let [value-ops (into
                           ;; memwidth: the two families join by being
                           ;; families, not by six more hand-written entries.
                           (into kernel-window-operations slice-operations)
                           #{:mir/argument :mir/constant :mir/add :mir/subtract
                            :mir/multiply :mir/quotient :mir/quotient-constant
                            :mir/bit-and :mir/bit-or
                            :mir/bit-xor :mir/shift-left :mir/shift-right-signed
                            :mir/shift-right-unsigned
                            :mir/f64-add :mir/f64-subtract :mir/f64-multiply
                            :mir/f64-divide :mir/f64-min :mir/f64-max
                            :mir/f64-sqrt :mir/f64-equal :mir/f64-less-than
                            :mir/f64-less-or-equal :mir/f64-greater-than
                            :mir/f64-greater-or-equal :mir/f64-unordered
                            ;; f32: value-producing exactly as the f64 family
                            ;; is -- one word out, no clobber the f64 twins do
                            ;; not already have.
                            :mir/f32-add :mir/f32-subtract :mir/f32-multiply
                            :mir/f32-divide :mir/f32-sqrt :mir/f32-equal
                            :mir/f32-less-than :mir/f32-less-or-equal
                            :mir/f32-greater-than :mir/f32-greater-or-equal
                            :mir/f32-unordered
                            :mir/f32-to-f64 :mir/f64-to-f32
                            :mir/i64-to-f32 :mir/i64-to-f64
                            :mir/kernel-load-u8 :mir/kernel-store-u8
                            :mir/kernel-load-u32 :mir/kernel-store-u32
                            :mir/kernel-try-lock-u32 :mir/kernel-unlock-u32
                            :mir/kernel-subregion
                            ;; simd: the dot product produces a value too.
                            :mir/kernel-dot-f32
                            ;; dequant: and so does every fused format.
                            :mir/kernel-dequant-dot-q8-0
                            :mir/kernel-dequant-dot-q4-k
                            :mir/kernel-dequant-dot-q6-k
                            :mir/kernel-dequant-dot-iq4-xs
                            :mir/kernel-dequant-dot-iq2-s
                            :mir/kernel-dequant-dot-iq3-xxs
                            :mir/kernel-dequant-dot-iq3-s
                            :mir/kernel-dequant-dot-ptq1-0
                            :mir/equal :mir/less-than
                            :mir/greater-than :mir/less-or-equal
                            :mir/greater-or-equal :mir/call :mir/runtime-call
                            :mir/capability-call :mir/x86-privileged
                            ;; sysops: every atomic produces a value too.
                            :mir/data-address
                            ;; boot-lit: so does a literal's address.
                            :mir/rodata-address
                            ;; boot-scratch: and so does a function's.
                            :mir/function-address})
                  value-ops (into value-ops kernel-atomic-ops)]
            (doseq [[index instruction] (map-indexed vector instructions)
                    :when (contains? value-ops (:mir/op instruction))]
              (let [store (get instructions (inc index))]
                (when-not (and (= :mir/spill-store (:mir/op store))
                               (= (:mir/dst instruction) (:mir/src store)))
                  (reject! :unbacked-call-frame-value
                           {:function name :instruction instruction}))))
            (doseq [[index {:mir/keys [arguments] :as call}]
                    (map-indexed vector instructions)
                    :when (call-operation? (:mir/op call))]
              (let [loads (when (>= index (count arguments))
                            (subvec instructions (- index (count arguments)) index))]
                (when-not (and (some? loads)
                               (= (count loads) (count arguments))
                               (every? #(= :mir/spill-load (:mir/op %)) loads)
                               (= arguments (mapv :mir/dst loads)))
                  (reject! :non-parallel-call-arguments
                           {:function name :call call}))))))
        (doseq [{:mir/keys [callee arguments] :as call} direct-calls]
          (let [callee-arity (get signatures callee ::missing)
                register-count (count (get call-argument-registers target))]
            (when (= ::missing callee-arity)
              (reject! :unresolved-callee call))
            ;; Virtual MIR names every argument. Physical MIR names the
            ;; register ones; the rest were stored just before the call.
            (when-not (= (if (and (= :physical registers)
                                  (> callee-arity register-count))
                           register-count
                           callee-arity)
                         (count arguments))
              (reject! :call-arity-mismatch
                       {:function name :call call :expected callee-arity}))))
        ;; Every stack argument a physical call needs is stored between the
        ;; previous call and it, exactly once, into the area its kind reads:
        ;; the frame's outgoing area for a call, the function's own incoming
        ;; area for a tail call.
        (when (= :physical registers)
          (let [register-count (count (get call-argument-registers target))]
            (when-let [left
                       (seq
            (reduce
             (fn [pending [index {:mir/keys [op callee] :as instruction}]]
               (cond
                 (contains? #{:mir/outgoing-argument :mir/incoming-argument-store} op)
                 (conj pending instruction)

                 ;; A direct recur IS a self tail call (the allocator turned
                 ;; it into a jump), so it consumes the incoming-area stores
                 ;; exactly as one would.
                 (or (call-operation? op) (= :mir/recur op))
                 (let [callee-arity (cond
                                      (contains? #{:mir/call :mir/tail-call} op)
                                      (get signatures callee 0)
                                      (= :mir/recur op) arity
                                      :else 0)
                       expected-op (if (contains? #{:mir/tail-call :mir/recur} op)
                                     :mir/incoming-argument-store
                                     :mir/outgoing-argument)
                       wanted (set (range register-count (max register-count callee-arity)))]
                   (when-not (and (= wanted (set (map :mir/index pending)))
                                  (= (count wanted) (count pending))
                                  (every? #(= expected-op (:mir/op %)) pending))
                     (reject! :stack-argument-profile-violation
                              {:function name :call instruction
                               :stores pending}))
                   [])

                 :else pending))
             []
             (map-indexed vector instructions)))]
              (reject! :stack-argument-profile-violation
                       {:function name :stores (vec left)})))))))
  module))

#?(:kotoba nil :default
(defn validate!
  "Validate virtual or physical MIR and return it unchanged. v3 modules own
  independent function frames and a closed scalar direct-call graph."
  [{:mir/keys [version] :as program}]
  (if (= 3 version)
    (validate-v3-module! program)
    (validate-flat! program))))

#?(:kotoba nil :default
(defn validate-problem [program]
  (try
    (validate! program)
    :ok
    (catch #?(:clj clojure.lang.ExceptionInfo :cljs :default) e
      (or (:problem (ex-data e)) :exception)))))

#?(:kotoba
   (defn- push-field [acc [:ref :form/r] ins [:ref :form/r] k :keyword] [:ref :form/r]
     (let [v (fget ins k)]
       (if (form/is-nil? v) acc (vconj acc v)))))

#?(:kotoba
   (defn- source-field-key [i :i64] :keyword
     (cond
       (= i 0) :mir/src
       (= i 1) :mir/input
       (= i 2) :mir/left
       (= i 3) :mir/right
       (= i 4) :mir/addend
       (= i 5) :mir/test
       (= i 6) :mir/value
       (= i 7) :mir/base
       (= i 8) :mir/length
       (= i 9) :mir/expected
       (= i 10) :mir/second-base
       (= i 11) :mir/second-length
       (= i 12) :mir/count
       (= i 13) :mir/stored
       (= i 14) :mir/offset
       (= i 15) :mir/size
       :else :none)))

#?(:kotoba
   (defn- push-fields [ins [:ref :form/r]] [:ref :form/r]
     (loop [i 0 acc (fvec)]
       (if (>= i 16) acc
         (recur (inc i) (push-field acc ins (source-field-key i)))))))

#?(:kotoba
   (defn- push-incoming-values [acc [:ref :form/r] incomings [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of incomings)]
       (loop [i 0 out acc]
         (if (>= i n) out
           (recur (inc i) (vconj out (fget (form/nth-of incomings i) :mir/value))))))))

#?(:kotoba
   (defn- instruction-sources [ins [:ref :form/r]] [:ref :form/r]
     (let [base (push-fields ins)
           incomings (fget ins :mir/incomings)
           with-incomings (if (form/is-vec? incomings) (push-incoming-values base incomings) base)
           with-index (if (indexed-memory-op? (kw-of (fget ins :mir/op)))
                        (vconj with-incomings (fget ins :mir/index))
                        with-incomings)
           arguments (fget ins :mir/arguments)]
       (if (form/is-vec? arguments) (vinto with-index arguments) with-index))))

#?(:kotoba
   (defn- vreg-sources [ins [:ref :form/r]] [:ref :form/r]
     (let [xs (instruction-sources ins)
           n (form/count-of xs)]
       (form/form-vec
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (let [x (form/nth-of xs i)]
              (recur (inc i) (if (gmir/vreg? x) (form/append-form acc x) acc)))))))))

#?(:kotoba
   (defn- mir-keyword-of [k :keyword] :keyword
     (let [t (document-edn-print (document-keyword k))]
       (keyword-from-string (string-concat "mir/" (string-substring t 6 (string-byte-length t)))))))

#?(:kotoba
   (defn- mir-incoming [incoming [:ref :form/r]] [:ref :form/r]
     (form/form-map
      (form/append-form
       (form/append-form
        (form/append-form
         (form/append-form (form/no-forms) (kwf :mir/predecessor))
         (fget incoming :gmir/predecessor))
        (kwf :mir/value))
       (fget incoming :gmir/value)))))

#?(:kotoba
   (defn- mir-incomings [incomings [:ref :form/r]] [:ref :form/r]
     (form/form-vec
      (let [n (form/count-of incomings)]
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (recur (inc i) (form/append-form acc (mir-incoming (form/nth-of incomings i))))))))))

#?(:kotoba
   (defn- select-instruction [target [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :gmir/op))
           kids (form/kids-of instruction)
           n (vector-count kids)
           init (cond
                  (= op :gmir/runtime-call)
                  (kassoc (fmap) :mir/context-offset
                          (mget (runtime-context-offsets) (fget instruction :gmir/runtime)))
                  (= op :gmir/capability-call)
                  (kassoc (fmap) :mir/context-offset
                          (mget (capability-context-offsets) (fget instruction :gmir/kind)))
                  :else (fmap))]
       (loop [j 0 out init]
         (if (>= (+ j 1) n) out
           (let [k (typed-list-nth [:list [:ref :form/r]] kids j)
                 v (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))
                 nk (kwf (mir-keyword-of (kw-of k)))]
             (recur (+ j 2)
                    (massoc out nk
                            (cond
                              (kw? k :gmir/op) (kwf (mir-keyword-of (kw-of v)))
                              (kw? k :gmir/incomings) (mir-incomings v)
                              :else v)))))))))

#?(:kotoba
   (defn- vreg-use-counts [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 counts (fmap)]
         (if (>= i n) counts
           (let [vs (vreg-sources (form/nth-of instructions i))
                 m (form/count-of vs)]
             (recur (inc i)
                    (loop [j 0 c counts]
                      (if (>= j m) c
                        (let [v (form/nth-of vs j)]
                          (recur (inc j) (massoc c v (fint (+ 1 (ival (mget c v))))))))))))))))

#?(:kotoba
   (defn- aarch64-fuse-zero-equality-branches [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (if (not (kw? target :aarch64))
       instructions
       (let [n (form/count-of instructions)
             use-counts (vreg-use-counts instructions)]
         (loop [index 0 out (fvec)]
           (if (>= index n) out
             (let [constant (form/nth-of instructions index)
                   equal (form/nth-of instructions (+ index 1))
                   branch (form/nth-of instructions (+ index 2))
                   zero (fget constant :mir/dst)
                   result (fget equal :mir/dst)
                   left (fget equal :mir/left)
                   right (fget equal :mir/right)
                   operand (cond (form/eq zero left) right
                                 (form/eq zero right) left
                                 :else (form/nil-form))
                   fuse? (and (kw? (fget constant :mir/op) :mir/constant)
                              (int-eq? (fget constant :mir/value) 0)
                              (kw? (fget equal :mir/op) :mir/equal)
                              (kw? (fget branch :mir/op) :mir/branch-zero)
                              (form/eq result (fget branch :mir/test))
                              (gmir/vreg? operand)
                              (and (not (form/eq zero result)) (not (form/eq zero operand)) (not (form/eq result operand)))
                              (int-eq? (mget use-counts zero) 1)
                              (int-eq? (mget use-counts result) 1))]
               (if fuse?
                 (recur (+ index 3)
                        (vconj out (form/form-map
                                    (form/append-form
                                     (form/append-form
                                      (form/append-form
                                       (form/append-form
                                        (form/append-form
                                         (form/append-form (form/no-forms) (kwf :mir/op))
                                         (kwf :mir/branch-nonzero))
                                        (kwf :mir/test))
                                       operand)
                                      (kwf :mir/target))
                                     (fget branch :mir/target)))))
                 (recur (+ index 1) (vconj out constant))))))))))

#?(:kotoba
   (defn- live-source-set [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 acc (fset)]
         (if (>= i n) acc
           (let [vs (vreg-sources (form/nth-of instructions i))
                 m (form/count-of vs)]
             (recur (inc i)
                    (loop [j 0 s acc]
                      (if (>= j m) s (recur (inc j) (sconj s (form/nth-of vs j))))))))))))

#?(:kotoba
   (defn- select-pass [target [:ref :form/r] instructions [:ref :form/r] constant-division? :bool] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 constants (fmap) out (fvec) specialized (fset)]
         (if (>= i n)
           (massoc (massoc (fmap) (kwf :out) out) (kwf :specialized) specialized)
           (let [ins (form/nth-of instructions i)
                 right (fget ins :gmir/right)
                 specialized? (and constant-division?
                                   (kw? (fget ins :gmir/op) :gmir/quotient)
                                   (mhas? constants right))
                 selected0 (select-instruction target ins)
                 selected (if specialized?
                            (form/dissoc-form (kassoc (kassoc selected0 :mir/op (kwf :mir/quotient-constant))
                                             :mir/divisor (mget constants right))
                                     (kwf :mir/right))
                            selected0)
                 constants2 (if (kw? (fget ins :gmir/op) :gmir/constant)
                              (massoc constants (fget ins :gmir/dst) (fget ins :gmir/value))
                              constants)]
             (recur (inc i) constants2 (vconj out selected)
                    (if specialized? (sconj specialized right) specialized))))))))

#?(:kotoba
   (defn- drop-absorbed-constants [out [:ref :form/r] specialized [:ref :form/r]] [:ref :form/r]
     (let [live (live-source-set out)
           m (form/count-of out)]
       (loop [j 0 res (fvec)]
         (if (>= j m) res
           (let [ins2 (form/nth-of out j)]
             (recur (inc j)
                    (if (and (kw? (fget ins2 :mir/op) :mir/constant)
                             (member-of? specialized (fget ins2 :mir/dst))
                             (not (member-of? live (fget ins2 :mir/dst))))
                      res
                      (vconj res ins2)))))))))

#?(:kotoba
   (defn- select-instructions [target [:ref :form/r] instructions [:ref :form/r] constant-division? :bool] [:ref :form/r]
     (let [pass (select-pass target instructions constant-division?)]
       (drop-absorbed-constants (aarch64-fuse-zero-equality-branches target (fget pass :out))
                                (fget pass :specialized)))))

#?(:kotoba
   (defn- gmir-dequant-op-not-q8? [op :keyword] :bool
     (or (= op :gmir/kernel-dequant-dot-q4-k) (= op :gmir/kernel-dequant-dot-q6-k)
         (= op :gmir/kernel-dequant-dot-iq4-xs) (= op :gmir/kernel-dequant-dot-iq2-s)
         (= op :gmir/kernel-dequant-dot-iq3-xxs) (= op :gmir/kernel-dequant-dot-iq3-s)
         (= op :gmir/kernel-dequant-dot-ptq1-0))))

#?(:kotoba
   (defn- gmir-all-instructions [program [:ref :form/r]] [:ref :form/r]
     (if (int-eq? (fget program :gmir/version) 3)
       (let [functions (fget program :gmir/functions)
             n (form/count-of functions)]
         (loop [i 0 acc (fvec)]
           (if (>= i n) acc
             (recur (inc i) (vinto acc (fget (form/nth-of functions i) :gmir/instructions))))))
       (fget program :gmir/instructions))))

#?(:kotoba
   (defn- any-op? [instructions [:ref :form/r] kind :i64] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) false
           (let [op (kw-of (fget (form/nth-of instructions i) :gmir/op))]
             (if (cond (= kind 0) (= op :gmir/x86-privileged)
                       (= kind 1) (gmir-dequant-op-not-q8? op)
                       :else false)
               true
               (recur (inc i)))))))))

#?(:kotoba
   (defn- select-all-functions [target [:ref :form/r] functions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of functions)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [f (form/nth-of functions i)]
             (recur (inc i)
                    (vconj acc (form/form-map
                                (form/append-form
                                 (form/append-form
                                  (form/append-form
                                   (form/append-form
                                    (form/append-form
                                     (form/append-form (form/no-forms) (kwf :mir/name))
                                     (fget f :gmir/name))
                                    (kwf :mir/arity))
                                   (fget f :gmir/arity))
                                  (kwf :mir/instructions))
                                 (select-instructions target (fget f :gmir/instructions) true)))))))))))

#?(:kotoba
   (defn- select-all-flat [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (recur (inc i) (vconj acc (select-instruction target (form/nth-of instructions i)))))))))

#?(:kotoba
   (defn- selected-program [target [:ref :form/r] program [:ref :form/r]] [:ref :form/r]
     (if (int-eq? (fget program :gmir/version) 3)
       (kassoc
        (kassoc
         (kassoc
          (kassoc
           (kassoc (fmap) :mir/version (fint 3))
           :mir/target target)
          :mir/registers (kwf :virtual))
         :mir/entry (fget program :gmir/entry))
        :mir/functions (select-all-functions target (fget program :gmir/functions)))
       (kassoc
        (kassoc
         (kassoc
          (kassoc (fmap) :mir/version (fget program :gmir/version))
          :mir/target target)
         :mir/registers (kwf :virtual))
        :mir/instructions (select-all-flat target (fget program :gmir/instructions))))))

#?(:kotoba
   (defn select-target-result [target [:ref :form/r] program [:ref :form/r]] [:ref :form/r]
     (if (not (member-of? (targets) target))
       (kassoc (fmap) :problem (kwf :unsupported-target))
       (let [instructions (do (gmir/validate! program) (gmir-all-instructions program))]
         (cond
           (and (not (kw? target :x86-64)) (any-op? instructions 0))
           (kassoc (fmap) :problem (kwf :x86-privileged-target-mismatch))
           (and (not (kw? target :x86-64)) (any-op? instructions 1))
           (kassoc (fmap) :problem (kwf :x86-simd-target-mismatch))
           :else
           (let [built (selected-program target program)
                 p (validate-problem built)]
             (if (= p :ok)
               (kassoc (fmap) :program built)
               (kassoc (fmap) :problem (kwf p)))))))))

#?(:kotoba
   (defn select-target
     "Select the closed GMIR operation set into target MIR, preserving vregs."
     [target [:ref :form/r] program [:ref :form/r]] [:ref :form/r]
     (let [r (select-target-result target program)]
       (if (mhas? r (kwf :problem))
         (do (reject! (kw-of (fget r :problem))) program)
         (let [built (fget r :program)]
           (if (and (int-eq? (fget built :mir/version) 2))
             (do (gmir/validate! (gmir-program-of (fget built :mir/instructions))) built)
             built))))))

#?(:kotoba nil :default
(defn- select-instruction [target instruction]
  (reduce-kv
   (fn [out key value]
     (assoc out
            (case key
              :gmir/op :mir/op
              :gmir/dst :mir/dst
              :gmir/index :mir/index
              :gmir/value :mir/value
              :gmir/input :mir/input
              :gmir/left :mir/left
              :gmir/right :mir/right
              :gmir/id :mir/id
              :gmir/test :mir/test
              :gmir/target :mir/target
              :gmir/incomings :mir/incomings
              :gmir/content :mir/content

              ;; boot-lit: the literal encoding travels with its content.

              :gmir/rodata-encoding :mir/rodata-encoding
              ;; boot-scratch: the named function travels with its address.
              :gmir/function :mir/function
              :gmir/callee :mir/callee
              :gmir/runtime :mir/runtime
              :gmir/action :mir/action
              :gmir/capability :mir/capability
              :gmir/kind :mir/kind
              :gmir/arguments :mir/arguments
              :gmir/base :mir/base
              :gmir/length :mir/length
              :gmir/stored :mir/stored
              ;; sysops: the compare-exchange comparand.
              :gmir/expected :mir/expected
              ;; simd: the dot product's second region and element count.
              :gmir/second-base :mir/second-base
              :gmir/second-length :mir/second-length
              :gmir/count :mir/count
              :gmir/offset :mir/offset
              :gmir/size :mir/size
              :gmir/maximum :mir/maximum)
            (cond
              (= key :gmir/op) (keyword "mir" (name value))
              (= key :gmir/incomings)
              (mapv (fn [incoming]
                      {:mir/predecessor (:gmir/predecessor incoming)
                       :mir/value (:gmir/value incoming)})
                    value)
              :else value)))
   (case (:gmir/op instruction)
     :gmir/runtime-call
     {:mir/context-offset (get runtime-context-offsets
                                (:gmir/runtime instruction))}
     :gmir/capability-call
     {:mir/context-offset (get capability-context-offsets
                                (:gmir/kind instruction))}
     {})
   instruction)))

#?(:kotoba nil :default
(defn- instruction-sources [instruction]
  (concat (keep instruction [:mir/src :mir/input :mir/left :mir/right :mir/addend
                             :mir/test :mir/value :mir/base :mir/length
                             ;; sysops: the compare-exchange comparand is read
                             ;; like any other source. Omitting it here would
                             ;; leave the allocator free to reuse the register
                             ;; holding it.
                             :mir/expected
                             ;; simd: the dot product reads five values. Every
                             ;; one has to be here or liveness kills an input
                             ;; and the allocator reuses the register holding
                             ;; it.
                             :mir/second-base :mir/second-length :mir/count
                             :mir/stored :mir/offset :mir/size])
          (when (vector? (:mir/incomings instruction))
            (map :mir/value (:mir/incomings instruction)))
          ;; memwidth: every operation that carries a `:mir/index` operand.
          (when (contains? indexed-memory-operations (:mir/op instruction))
            [(:mir/index instruction)])
          (when (vector? (:mir/arguments instruction))
            (:mir/arguments instruction)))))

;; ---------------------------------------------------------------------------
;; Kotoba route: post-allocation scheduling over Form.
;; ---------------------------------------------------------------------------

#?(:kotoba
   (defn- scheduling-latency [target [:ref :form/r] instruction [:ref :form/r]] :i64
     (if (and (or (kw? target :x86-64) (kw? target :aarch64))
              (kw? (fget instruction :mir/op) :mir/multiply))
       3
       1)))

#?(:kotoba
   (defn- scheduling-register? [target [:ref :form/r] value [:ref :form/r]] :bool
     (or (gmir/vreg? value) (physical-register? target value))))

;; The scheduling registers among INSTRUCTION's sources, without repeats.
#?(:kotoba
   (defn- scheduling-sources [target [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (let [xs (instruction-sources instruction)
           n (form/count-of xs)]
       (loop [i 0 acc (fset)]
         (if (>= i n) acc
           (let [x (form/nth-of xs i)]
             (recur (inc i) (if (scheduling-register? target x) (sconj acc x) acc))))))))

;; The set PREDS with the readers/writers recorded for SOURCES folded in: the
;; index of each source's last definition.
#?(:kotoba
   (defn- raw-predecessors [sources [:ref :form/r] last-def [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of sources)]
       (loop [i 0 acc (fset)]
         (if (>= i n) acc
           (let [s (form/nth-of sources i)]
             (recur (inc i) (if (mhas? last-def s) (sconj acc (mget last-def s)) acc))))))))

;; READERS with INDEX recorded as a reader of every source.
#?(:kotoba
   (defn- record-readers [readers [:ref :form/r] sources [:ref :form/r] index :i64] [:ref :form/r]
     (let [n (form/count-of sources)]
       (loop [i 0 acc readers]
         (if (>= i n) acc
           (let [s (form/nth-of sources i)]
             (recur (inc i) (massoc acc s (sconj (mget acc s) (fint index))))))))))

;; Register dependencies within one scheduling segment: for each instruction,
;; the set of earlier indexes it must follow (RAW, WAR and WAW).
#?(:kotoba
   (defn- segment-predecessors [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [total (form/count-of instructions)]
       (loop [index 0 last-def (fmap) readers (fmap) preds (fvec)]
         (if (>= index total) preds
           (let [instruction (form/nth-of instructions index)
                 sources (scheduling-sources target instruction)
                 dst (fget instruction :mir/dst)
                 register-dst? (scheduling-register? target dst)
                 raw (raw-predecessors sources last-def)
                 war (if register-dst? (mget readers dst) (fset))
                 waw (if register-dst? (mget last-def dst) (form/nil-form))
                 with-war (vinto raw war)
                 pred-indexes (if (form/is-nil? waw) (vdistinct with-war) (vdistinct (vconj with-war waw)))
                 readers2 (record-readers readers sources index)
                 readers3 (if register-dst? (massoc readers2 dst (fset)) readers2)
                 last-def2 (if register-dst? (massoc last-def dst (fint index)) last-def)]
             (recur (inc index) last-def2 readers3 (vconj preds pred-indexes))))))))

#?(:kotoba
   (defn- all-ready? [preds [:ref :form/r] completion [:ref :form/r] cycle :i64] :bool
     (let [n (form/count-of preds)]
       (loop [i 0]
         (if (>= i n) true
           (let [p (form/nth-of preds i)]
             (if (and (mhas? completion p) (<= (ival (mget completion p)) cycle))
               (recur (inc i))
               false)))))))

#?(:kotoba
   (defn- segment-ready-at-cycle? [predecessors [:ref :form/r] completion [:ref :form/r] cycle :i64 index :i64] :bool
     (all-ready? (form/nth-of predecessors index) completion cycle)))

;; Is ORDER a permutation of 0..COUNT-1?
#?(:kotoba
   (defn- permutation? [order [:ref :form/r] count :i64] :bool
     (and (= count (form/count-of order))
          (loop [k 0]
            (if (>= k count) true
              (if (>= (vindex-of order (fint k)) 0) (recur (inc k)) false))))))

;; Does every instruction come after all of its predecessors in ORDER?
#?(:kotoba
   (defn- respects-dependencies? [predecessors [:ref :form/r] order [:ref :form/r] count :i64] :bool
     (loop [index 0]
       (if (>= index count) true
         (let [preds (form/nth-of predecessors index)
               m (form/count-of preds)
               here (vindex-of order (fint index))]
           (if (loop [j 0]
                 (if (>= j m) true
                   (if (< (vindex-of order (form/nth-of preds j)) here) (recur (inc j)) false)))
             (recur (inc index))
             false))))))

#?(:kotoba
   (defn- valid-scheduled-segment? [target [:ref :form/r] instructions [:ref :form/r] order [:ref :form/r]] :bool
     (let [count (form/count-of instructions)]
       (and (permutation? order count)
            (respects-dependencies? (segment-predecessors target instructions) order count)))))

;; Dependency-aware list-scheduling helpers ---------------------------------

;; Successor sets: for each index, the indexes that list it as a predecessor.
#?(:kotoba
   (defn- add-successors [succ [:ref :form/r] preds [:ref :form/r] index :i64] [:ref :form/r]
     (let [n (form/count-of preds)]
       (loop [j 0 acc succ]
         (if (>= j n) acc
           (let [p (ival (form/nth-of preds j))]
             (recur (inc j) (vassoc acc p (sconj (form/nth-of acc p) (fint index))))))))))

#?(:kotoba
   (defn- empty-sets [n :i64] [:ref :form/r]
     (loop [i 0 acc (fvec)]
       (if (>= i n) acc (recur (inc i) (vconj acc (fset)))))))

#?(:kotoba
   (defn- zero-heights [n :i64] [:ref :form/r]
     (loop [i 0 acc (fvec)]
       (if (>= i n) acc (recur (inc i) (vconj acc (fint 0)))))))

#?(:kotoba
   (defn- successor-sets [predecessors [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of predecessors)]
       (loop [index 0 acc (empty-sets n)]
         (if (>= index n) acc
           (recur (inc index) (add-successors acc (form/nth-of predecessors index) index)))))))

#?(:kotoba
   (defn- max-height [heights [:ref :form/r] successors [:ref :form/r]] :i64
     (let [n (form/count-of successors)]
       (loop [j 0 best 0]
         (if (>= j n) best
           (let [h (ival (form/nth-of heights (ival (form/nth-of successors j))))]
             (recur (inc j) (if (> h best) h best))))))))

#?(:kotoba
   (defn- segment-heights [target [:ref :form/r] instructions [:ref :form/r] successors [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [index (- n 1) heights (zero-heights n)]
         (if (< index 0) heights
           (recur (- index 1)
                  (vassoc heights index
                          (fint (+ (scheduling-latency target (form/nth-of instructions index))
                                   (max-height heights (form/nth-of successors index)))))))))))

;; Of REMAINING (a set of indexes), the ready one with the greatest height, ties
;; to the smaller index; -1 when none is ready this cycle.
#?(:kotoba
   (defn- pick-ready [predecessors [:ref :form/r] remaining [:ref :form/r] completion [:ref :form/r] heights [:ref :form/r] cycle :i64] :i64
     (let [n (form/count-of remaining)]
       (loop [j 0 best -1]
         (if (>= j n) best
           (let [index (ival (form/nth-of remaining j))]
             (recur (inc j)
                    (if (segment-ready-at-cycle? predecessors completion cycle index)
                      (if (< best 0)
                        index
                        (let [hb (ival (form/nth-of heights best))
                              hi (ival (form/nth-of heights index))]
                          (if (or (> hi hb) (and (= hi hb) (< index best))) index best)))
                      best))))))))

#?(:kotoba
   (defn- all-indexes [n :i64] [:ref :form/r]
     (loop [i 0 acc (fvec)]
       (if (>= i n) acc (recur (inc i) (vconj acc (fint i)))))))

#?(:kotoba
   (defn- remove-index [remaining [:ref :form/r] index :i64] [:ref :form/r]
     (vremove-members remaining (form/form-set (form/one-form (fint index))))))

#?(:kotoba
   (defn- schedule-loop [target [:ref :form/r] instructions [:ref :form/r] predecessors [:ref :form/r] heights [:ref :form/r]] [:ref :form/r]
     (loop [cycle 0 remaining (all-indexes (form/count-of instructions)) completion (fmap) out (fvec)]
       (if (= 0 (form/count-of remaining)) out
         (let [ready (pick-ready predecessors remaining completion heights cycle)]
           (if (< ready 0)
             (recur (inc cycle) remaining completion out)
             (recur (inc cycle)
                    (remove-index remaining ready)
                    (massoc completion (fint ready)
                            (fint (+ cycle (scheduling-latency target (form/nth-of instructions ready)))))
                    (vconj out (fint ready)))))))))

;; A deterministic dependency-aware permutation of the original indexes.
#?(:kotoba
   (defn- schedule-integer-segment-indices [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (if (< n 2)
         (all-indexes n)
         (let [predecessors (segment-predecessors target instructions)
               successors (successor-sets predecessors)
               heights (segment-heights target instructions successors)
               order (schedule-loop target instructions predecessors heights)]
           ;; The host refuses a schedule that breaks a register dependency. The
           ;; list scheduler cannot produce one; should it ever, the original
           ;; order is the always-valid answer, and this function must not abort
           ;; (its caller loops).
           (if (valid-scheduled-segment? target instructions order)
             order
             (all-indexes n)))))))

#?(:kotoba
   (defn- schedule-integer-segment [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [order (schedule-integer-segment-indices target instructions)
           n (form/count-of order)]
       (loop [k 0 acc (fvec)]
         (if (>= k n) acc
           (recur (inc k) (vconj acc (form/nth-of instructions (ival (form/nth-of order k))))))))))

#?(:kotoba
   (defn- aarch64-fusion-pair? [target [:ref :form/r] instructions [:ref :form/r] use-counts [:ref :form/r] index :i64] :bool
     (let [multiply (form/nth-of instructions index)
           consumer (form/nth-of instructions (+ index 1))
           product (fget multiply :mir/dst)
           consumer-op (kw-of (fget consumer :mir/op))]
       (and (kw? (fget multiply :mir/op) :mir/multiply)
            (scheduling-register? target product)
            (int-eq? (mget use-counts product) 1)
            (or (and (= consumer-op :mir/add)
                     (or (form/eq product (fget consumer :mir/left))
                         (form/eq product (fget consumer :mir/right))))
                (and (= consumer-op :mir/subtract)
                     (form/eq product (fget consumer :mir/right))))))))

;; Use counts of the scheduling registers among all instructions' sources.
#?(:kotoba
   (defn- scheduling-use-counts [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 counts (fmap)]
         (if (>= i n) counts
           (let [xs (instruction-sources (form/nth-of instructions i))
                 m (form/count-of xs)]
             (recur (inc i)
                    (loop [j 0 c counts]
                      (if (>= j m) c
                        (let [x (form/nth-of xs j)]
                          (recur (inc j)
                                 (if (scheduling-register? target x)
                                   (massoc c x (fint (+ 1 (ival (mget c x)))))
                                   c))))))))))))

;; The indexes of adjacent multiply/consumer pairs the AArch64 selector fuses.
#?(:kotoba
   (defn- protected-scheduling-indexes [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (if (not (kw? target :aarch64))
       (fset)
       (let [use-counts (scheduling-use-counts target instructions)
             limit (- (form/count-of instructions) 1)]
         (loop [index 0 out (fset)]
           (if (>= index limit) out
             (recur (inc index)
                    (if (aarch64-fusion-pair? target instructions use-counts index)
                      (sconj (sconj out (fint index)) (fint (+ index 1)))
                      out))))))))

#?(:kotoba
   (defn- schedulable-integer-op? [op :keyword] :bool
     (or (= op :mir/add) (= op :mir/subtract) (= op :mir/multiply)
         (= op :mir/bit-and) (= op :mir/bit-or) (= op :mir/bit-xor)
         (= op :mir/shift-left) (= op :mir/shift-right-signed) (= op :mir/shift-right-unsigned)
         (= op :mir/equal) (= op :mir/less-than) (= op :mir/greater-than)
         (= op :mir/less-or-equal) (= op :mir/greater-or-equal))))

#?(:kotoba
   (defn- schedule-instructions [target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [protected (protected-scheduling-indexes target instructions)
           n (form/count-of instructions)]
       (loop [i 0 out (fvec) segment (fvec)]
         (if (>= i n)
           (vinto out (schedule-integer-segment target segment))
           (let [instruction (form/nth-of instructions i)]
             (if (and (not (member-of? protected (fint i)))
                      (schedulable-integer-op? (kw-of (fget instruction :mir/op))))
               (recur (inc i) out (vconj segment instruction))
               (recur (inc i)
                      (vconj (vinto out (schedule-integer-segment target segment)) instruction)
                      (fvec)))))))))

#?(:kotoba
   (defn- schedule-program [program [:ref :form/r]] [:ref :form/r]
     (kassoc program :mir/instructions
             (schedule-instructions (fget program :mir/target) (fget program :mir/instructions)))))

#?(:kotoba nil :default
(def ^:private schedulable-integer-operations
  "Pure, non-trapping integer operations admitted to local scheduling. Every
  other operation is a hard barrier: in particular constants, memory, calls,
  division, labels, terminators, phi transport, and target-selected ops."
  #{:mir/add :mir/subtract :mir/multiply
    :mir/bit-and :mir/bit-or :mir/bit-xor
    :mir/shift-left :mir/shift-right-signed :mir/shift-right-unsigned
    :mir/equal :mir/less-than :mir/greater-than
    :mir/less-or-equal :mir/greater-or-equal}))

#?(:kotoba nil :default
(def ^:private scheduling-latencies
  "Portable scheduling heuristic, not a microarchitecture benchmark. The
  target key keeps policy explicit as the profiles diverge; both current
  profiles conservatively model integer multiply as the only multi-cycle op."
  {:x86-64 {:mir/multiply 3}
   :aarch64 {:mir/multiply 3}}))

#?(:kotoba nil :default
(defn- scheduling-latency [target instruction]
  (get-in scheduling-latencies [target (:mir/op instruction)] 1)))

#?(:kotoba nil :default
(defn- scheduling-register? [target value]
  (or (gmir/vreg? value) (physical-register? target value))))

#?(:kotoba nil :default
(defn- segment-predecessors [target instructions]
  "Register dependencies within one scheduling segment. SSA vregs need RAW
  edges only, but post-allocation physical registers are reused: preserve WAR
  and WAW order too, or a later definition can move before an earlier read or
  an earlier definition can move after the value meant to replace it."
  (loop [index 0
         last-def {}
         readers-since-def {}
         preds []]
    (if (= index (count instructions))
      preds
      (let [instruction (nth instructions index)
            sources (->> (instruction-sources instruction)
                         (filter #(scheduling-register? target %))
                         set)
            dst (:mir/dst instruction)
            register-dst? (scheduling-register? target dst)
            raw-preds (keep last-def sources)
            ;; Capture anti-dependencies before recording this instruction as
            ;; a reader. A read-modify-write reads the old value and defines
            ;; the new value atomically; it must not depend on itself.
            war-preds (when register-dst? (get readers-since-def dst))
            waw-pred (when register-dst? (get last-def dst))
            pred-indexes (cond-> (into (set raw-preds) war-preds)
                           (some? waw-pred) (conj waw-pred))
            readers-since-def
            (reduce #(update %1 %2 (fnil conj #{}) index)
                    readers-since-def sources)
            readers-since-def (if register-dst?
                                (assoc readers-since-def dst #{})
                                readers-since-def)
            last-def (if register-dst? (assoc last-def dst index) last-def)]
        (recur (inc index) last-def readers-since-def
               (conj preds pred-indexes)))))))

#?(:kotoba nil :default
(defn- segment-ready-at-cycle? [predecessors completion cycle index]
  (every? #(and (contains? completion %)
                (<= (get completion %) cycle))
          (nth predecessors index))))

#?(:kotoba nil :default
(defn- segment-order-positions [order-indices]
  (into {}
        (map-indexed (fn [position original-index]
                       [original-index position])
                     order-indices))))

#?(:kotoba nil :default
(defn- valid-scheduled-segment?
  "True when ORDER-INDICES is an exact, register-dependency-respecting
  permutation of the original integer indexes in INSTRUCTIONS."
  [target instructions order-indices]
  (let [instruction-count (count instructions)]
    (and (= instruction-count (count order-indices))
         (every? integer? order-indices)
         (= (frequencies order-indices)
            (zipmap (range instruction-count) (repeat 1)))
         (let [predecessors (segment-predecessors target instructions)
               positions (segment-order-positions order-indices)]
           (every? (fn [index]
                     (every? #(< (positions %)
                                 (positions index))
                             (nth predecessors index)))
                   (range instruction-count)))))))

#?(:kotoba nil :default
(defn- verify-scheduled-segment!
  [target instructions order-indices]
  (when-not (valid-scheduled-segment? target instructions order-indices)
    (reject! :schedule-violates-register-dependencies
             {:segment instructions :scheduled-indexes order-indices}))
  order-indices))

#?(:kotoba nil :default
(defn- segment-completion-times
  "Modeled completion cycles for an explicit permutation of original integer
  instruction indexes. This is a portable structural score, not wall-clock
  performance evidence."
  [target instructions order-indices]
  (verify-scheduled-segment! target instructions order-indices)
  (let [predecessors (segment-predecessors target instructions)
        instruction-count (count instructions)]
    (loop [cycle 0
           order-position 0
           completion {}
           times (vec (repeat instruction-count 0))]
      (if (= order-position instruction-count)
        times
        (let [index (nth order-indices order-position)]
          (if (segment-ready-at-cycle? predecessors completion cycle index)
            (let [done (+ cycle
                          (scheduling-latency target
                                              (nth instructions index)))]
              (recur (inc cycle)
                     (inc order-position)
                     (assoc completion index done)
                     (assoc times index done)))
            (recur (inc cycle) order-position completion times))))))))

#?(:kotoba nil :default
(defn- segment-sum-completion-times
  [target instructions order-indices]
  (reduce + (segment-completion-times target instructions order-indices))))

#?(:kotoba nil :default
(defn- schedule-integer-segment-indices
  "Return a deterministic dependency-aware permutation of original indexes."
  [target instructions]
  (if (< (count instructions) 2)
    (vec (range (count instructions)))
    (let [predecessors (segment-predecessors target instructions)
          successors
          (reduce-kv (fn [out index inputs]
                       (reduce #(update %1 %2 conj index) out inputs))
                     (vec (repeat (count instructions) #{}))
                     predecessors)
          heights
          (reduce (fn [out index]
                    (assoc out index
                           (+ (scheduling-latency target (nth instructions index))
                              (reduce max 0 (map #(nth out %) (nth successors index))))))
                  (vec (repeat (count instructions) 0))
                  (reverse (range (count instructions))))]
      (verify-scheduled-segment!
       target
       instructions
       (loop [cycle 0
              remaining (set (range (count instructions)))
              completion {}
              out []]
         (if (empty? remaining)
           out
           (let [ready (->> remaining
                            (filter (fn [index]
                                      (segment-ready-at-cycle? predecessors
                                                                 completion
                                                                 cycle
                                                                 index)))
                            (sort-by (fn [index] [(- (nth heights index)) index]))
                            first)]
             (if (nil? ready)
               (recur (inc cycle) remaining completion out)
               (recur (inc cycle)
                      (disj remaining ready)
                      (assoc completion ready
                             (+ cycle
                                (scheduling-latency target
                                                    (nth instructions ready))))
                      (conj out ready)))))))))))

#?(:kotoba nil :default
(defn- schedule-integer-segment
  "Deterministic dependency-aware list scheduling for one barrier-free SSA
  segment. Critical-path height breaks ties first, original position second.
  A conceptual issue cycle lets independent work fill modeled dependency
  latency without inserting machine instructions or claiming wall-clock gain."
  [target instructions]
  (mapv #(nth instructions %)
        (schedule-integer-segment-indices target instructions))))

#?(:kotoba nil :default
(defn- aarch64-fusion-pair?
  "True when INDEX and INDEX+1 are an already-adjacent multiply/add pair the
  downstream AArch64 selector can turn into one MADD/MSUB. Keep such pairs
  fixed: separating them would regress code quality before MC fusion runs."
  [target instructions use-counts index]
  (let [multiply (nth instructions index nil)
        consumer (nth instructions (inc index) nil)
        product (:mir/dst multiply)
        consumer-op (:mir/op consumer)
        consumes-product?
        (or (and (= :mir/add consumer-op)
                 (or (= product (:mir/left consumer))
                     (= product (:mir/right consumer))))
            (and (= :mir/subtract consumer-op)
                 (= product (:mir/right consumer))))]
    (and (= :mir/multiply (:mir/op multiply))
         (scheduling-register? target product)
         (= 1 (get use-counts product))
         consumes-product?))))

#?(:kotoba nil :default
(defn- protected-scheduling-indexes [target instructions]
  (if-not (= :aarch64 target)
    #{}
    (let [use-counts (frequencies (filter #(scheduling-register? target %)
                                          (mapcat instruction-sources instructions)))]
      (reduce (fn [out index]
                (if (aarch64-fusion-pair? target instructions use-counts index)
                  (conj out index (inc index))
                  out))
              #{}
              (range (max 0 (dec (count instructions)))))))))

#?(:kotoba nil :default
(defn- schedule-instructions
  "Schedule only consecutive pure integer segments. Barriers retain their
  exact position relative to all surrounding segments. Labels, branches,
  spills, moves, and calls are barriers, so each basic block is scheduled
  independently once register allocation has fixed physical identities."
  [target instructions]
  (let [protected (protected-scheduling-indexes target instructions)]
    (letfn [(flush-segment [out segment]
              (into out (schedule-integer-segment target segment)))]
      (let [{:keys [out segment]}
            (reduce (fn [{:keys [out segment]} instruction]
                      (let [index (+ (count out) (count segment))]
                        (if (and (not (contains? protected index))
                                 (contains? schedulable-integer-operations
                                            (:mir/op instruction)))
                          {:out out :segment (conj segment instruction)}
                          {:out (conj (flush-segment out segment) instruction)
                           :segment []})))
                    {:out [] :segment []}
                    instructions)]
        (flush-segment out segment))))))

#?(:kotoba nil :default
(defn- schedule-program [{:mir/keys [target] :as program}]
  (update program :mir/instructions #(schedule-instructions target %))))


#?(:kotoba nil :default
(defn- host-number
  "A guest i64 literal narrowed to a host number, for BOUNDED comparisons only.

  MIR carries KIR literals through unchanged, and on ClojureScript a guest i64
  is a JavaScript BigInt while every number this namespace synthesizes is a
  plain one. The two do not compare, and they fail SILENTLY in both
  directions: `(zero? (js/BigInt 0))` and `(integer? (js/BigInt 0))` are both
  false, so a guard written with either simply stops recognizing its case.

  Measured 2026-09-08 through amu on nbb, `(if (= a 0) a a)` on aarch64: 12
  bytes when the literal reached here as a host number, 24 when it reached
  here as a BigInt. `aarch64-fuse-zero-equality-branches` below tests its
  constant with `zero?`, so the fusion never fired for a literal that came
  from the READER -- which is every literal written in real source. It fired
  only for the ones the frontend synthesizes. The JVM emits 12 for the same
  program, because a Long compares to 0.

  Two consequences, and the second is the one that turns a missed
  optimization into a correctness problem. The fusion was dead on the
  JVM-free front. And emission stopped being a function of the KIR VALUE:
  `kotoba-verifier` re-derives the instruction stream from sealed KIR and
  rejects any drift, so once `amu extract-native` read artifacts with a
  reader that preserves i64 exactly, a closure-bearing artifact was refused
  as \"native instruction stream rejected\" -- correctly, by a verifier with
  no way to tell representation drift from a tampered artifact.

  Narrowing is safe HERE because every caller compares against a small bound
  (zero, or membership in `#{-1 0}`), and a literal too large for a double is
  unequal to those under either representation. Do not carry the result
  onward: `gmir/i64-value?` is the exact test, and this is not it."
  [value]
  #?(:clj value
     :cljs (if (gmir/i64-value? value) (js/Number value) value))))

#?(:kotoba nil :default
(defn- aarch64-fuse-zero-equality-branches
  "Turn one SSA-only `zero; equal; branch-zero` triple into branch-nonzero.

  Both removed definitions must have exactly one use in the complete function,
  including phi incoming edges. Exact adjacency excludes labels and other
  control-flow boundaries. This runs before physical allocation, where vreg
  identity still makes global use counts meaningful."
  [target instructions]
  (if-not (= :aarch64 target)
    (vec instructions)
    (let [instructions (vec instructions)
          use-counts (frequencies
                      (filter gmir/vreg?
                              (mapcat instruction-sources instructions)))]
      (loop [index 0, out []]
        (if (>= index (count instructions))
          (vec out)
          (let [constant (get instructions index)
                equal (get instructions (inc index))
                branch (get instructions (+ index 2))
                zero (:mir/dst constant)
                result (:mir/dst equal)
                left (:mir/left equal)
                right (:mir/right equal)
                operand (cond (= zero left) right
                              (= zero right) left)
                fuse? (and (= :mir/constant (:mir/op constant))
                           (zero? (host-number (:mir/value constant)))
                           (= :mir/equal (:mir/op equal))
                           (= :mir/branch-zero (:mir/op branch))
                           (= result (:mir/test branch))
                           (gmir/vreg? operand)
                           (= 3 (count (set [zero result operand])))
                           (= 1 (get use-counts zero))
                           (= 1 (get use-counts result)))]
            (if fuse?
              (recur (+ index 3)
                     (conj out {:mir/op :mir/branch-nonzero
                                :mir/test operand
                                :mir/target (:mir/target branch)}))
              (recur (inc index) (conj out constant))))))))))

#?(:kotoba nil :default
(defn- select-instructions
  "Select one function while retaining SSA constants long enough to choose a
  target-independent constant-divisor operation. A divisor vreg disappears
  from the closed operation after its literal value is captured. Its constant
  definition is removed only when no other selected instruction consumes it."
  [target instructions constant-division?]
  (let [{:keys [out specialized-divisors]}
        (reduce
         (fn [{:keys [constants out specialized-divisors]} instruction]
           (let [right (:gmir/right instruction)
                 specialized? (and constant-division?
                                   (= :gmir/quotient (:gmir/op instruction))
                                   (contains? constants right))
                 selected (select-instruction target instruction)
                 selected (if specialized?
                            (-> selected
                                (assoc :mir/op :mir/quotient-constant
                                       :mir/divisor (get constants right))
                                (dissoc :mir/right))
                            selected)
                 constants (if (= :gmir/constant (:gmir/op instruction))
                             (assoc constants (:gmir/dst instruction)
                                    (:gmir/value instruction))
                             constants)]
             {:constants constants
              :specialized-divisors (cond-> specialized-divisors
                                      specialized? (conj right))
              :out (conj out selected)}))
         {:constants {} :specialized-divisors #{} :out []}
         instructions)
        ;; NBB represents admitted i64 literals as JavaScript BigInt values.
        ;; They are not SSA identities and must not enter a CLJS hash-set
        ;; (which would attempt object identity bookkeeping on a primitive).
        out (aarch64-fuse-zero-equality-branches target out)
        live-sources (->> out
                          (mapcat instruction-sources)
                          (filter gmir/vreg?)
                          set)]
    (->> out
         (remove (fn [{:mir/keys [op dst]}]
                   (and (= :mir/constant op)
                        (contains? specialized-divisors dst)
                        (not (contains? live-sources dst)))))
         vec))))

#?(:kotoba nil :default
(defn select-target
  "Select the closed GMIR operation set into target MIR, preserving vregs."
  [target program]
  (when-not (contains? targets target)
    (reject! :unsupported-target {:target target}))
  (gmir/validate! program)
  (let [instructions (if (= 3 (:gmir/version program))
                       (mapcat :gmir/instructions (:gmir/functions program))
                       (:gmir/instructions program))
        privileged (filter #(= :gmir/x86-privileged (:gmir/op %)) instructions)
        ;; simd: `kernel-dot-f32` IS NO LONGER X86-ONLY (2026-09-09). The
        ;; contract of the operation is an ORDER OF SUMMATION rather than a dot
        ;; product, and that is exactly why an AArch64 arm was admissible only
        ;; once it reproduced the order: `kotoba.native.machine-ir`'s
        ;; `a64-kernel-dot-f32` is the x86 SCALAR arm instruction for
        ;; instruction -- four accumulators, lower half before upper, then
        ;; `(s0+s1)+(s2+s3)` -- and AArch64 scalar FMUL/FADD are IEEE-754
        ;; round-to-nearest-even on the same operands SSE's mulss/addss are, so
        ;; the three arms agree by construction. It is scalar and not NEON
        ;; deliberately: the cheap NEON reduction computes a different tree.
        ;;
        ;; dequant: Q8_0 LEFT THIS SET ON 2026-09-09 and the K-quants did not.
        ;; The reason was never the tree -- the tree has an AArch64 spelling --
        ;; it is each format's per-block DECODE. Q8_0's is one fp16 scale and
        ;; eight sign-extended bytes per group, which transliterates from the
        ;; x86 scalar arm directly (`a64-kernel-dequant-dot`, verified against
        ;; the assembler and executed). Q4_K's nibble split and Q6_K's six-bit
        ;; regroup do not, and the four codebook formats need a read-only table
        ;; on the machine before either backend can have an arm at all.
        ;;
        ;; The set is spelled by SUBTRACTION from gmir's rather than listed, so
        ;; a format added upstream is refused here until someone decides
        ;; otherwise -- the fail-closed direction.
        aarch64-fused-dequant '#{:gmir/kernel-dequant-dot-q8-0}
        dot-products (filter #(and (contains? gmir/kernel-dequant-dot-operations
                                              (:gmir/op %))
                                   (not (contains? aarch64-fused-dequant
                                                   (:gmir/op %))))
                             instructions)
        ;; boot-lit/adr: A LITERAL'S ADDRESS SELECTS ON BOTH TARGETS AS OF
        ;; 2026-09-09, and the refusal that stood here is gone rather than
        ;; narrowed -- `targets` holds exactly two, so a refusal for
        ;; "not x86-64" was a refusal for AArch64 and nothing else.
        ;;
        ;; The refusal said the blocker was ADRP+ADD's 4 KiB page split. That
        ;; was the wrong instruction. `adr Xd, label` reaches +/-1 MiB in ONE
        ;; instruction with no page arithmetic at all, and the literal pool
        ;; that `kotoba.native`'s layout pass places sits at the end of the
        ;; same emitted buffer as the code -- so the distance is bounded by
        ;; the size of one program, which is exactly the fact a LINKER cannot
        ;; know and this backend can. ADRP exists for the case where the
        ;; symbol might be four gigabytes away; that case does not arise here.
        ;;
        ;; ⚠ The lesson is the one this workspace's own rule names: a refusal
        ;; that says "the layout pass does not model X" is a statement about
        ;; an implementation, and the way to honour it is to measure it, not
        ;; to design around it. Measuring it found that X was never needed.
        ;; boot-scratch/adr: A FUNCTION'S ADDRESS SELECTS ON BOTH TARGETS AS
        ;; OF 2026-09-09, for the same reason and by the same instruction as
        ;; the literal's did earlier the same day.
        ;;
        ;; The refusal that stood here said a function's address is
        ;; `lea dst,[rip+disp32]` too, "so it is x86-only for exactly the
        ;; reason the literal is". That sentence was true and it survived its
        ;; own premise by a few hours: the literal's reason stopped holding
        ;; when `adr` turned out to reach the pool in one instruction, and a
        ;; function's label is in the same emitted buffer as the code exactly
        ;; as the pool is. Deleting the reason and leaving the conclusion is
        ;; how a gap outlives the thing that caused it.
        ;;
        ;; ⚠ THE TWO KEYWORDS WERE STILL WORTH KEEPING APART while they both
        ;; existed. `kotoba-native`'s `isa-parity` and this file's own tests
        ;; each held a control that would have gone red if one refusal had
        ;; been widened for both -- which is what let the literal's move on
        ;; its own, hours before this one, with evidence for each.
        ]
    (when (and (not= :x86-64 target) (seq privileged))
      (reject! :x86-privileged-target-mismatch
               {:target target :actions (mapv :gmir/action privileged)}))
    (when (and (not= :x86-64 target) (seq dot-products))
      (reject! :x86-simd-target-mismatch
               {:target target
                :operations (vec (distinct (map :gmir/op dot-products)))})))
  (validate!
   (if (= 3 (:gmir/version program))
     {:mir/version 3
      :mir/target target
      :mir/registers :virtual
      :mir/entry (:gmir/entry program)
      :mir/functions
      (mapv (fn [{:gmir/keys [name arity instructions]}]
              {:mir/name name :mir/arity arity
               :mir/instructions (select-instructions target instructions true)})
            (:gmir/functions program))}
     {:mir/version (:gmir/version program)
      :mir/target target
      :mir/registers :virtual
      :mir/instructions (mapv #(select-instruction target %)
                              (:gmir/instructions program))}))))

;; ---------------------------------------------------------------------------
;; Kotoba route: phi lowering, parallel copies, the control-flow graph and
;; liveness, over Form.
;; ---------------------------------------------------------------------------

#?(:kotoba
   (defn- mk2 [k1 :keyword v1 [:ref :form/r] k2 :keyword v2 [:ref :form/r]] [:ref :form/r]
     (kassoc (kassoc (fmap) k1 v1) k2 v2)))

#?(:kotoba
   (defn- mk3 [k1 :keyword v1 [:ref :form/r] k2 :keyword v2 [:ref :form/r] k3 :keyword v3 [:ref :form/r]] [:ref :form/r]
     (kassoc (mk2 k1 v1 k2 v2) k3 v3)))

#?(:kotoba
   (defn- instr-move [dst [:ref :form/r] src [:ref :form/r]] [:ref :form/r]
     (mk3 :mir/op (kwf :mir/move) :mir/dst dst :mir/src src)))

#?(:kotoba
   (defn- instr-spill-load [dst [:ref :form/r] slot [:ref :form/r]] [:ref :form/r]
     (mk3 :mir/op (kwf :mir/spill-load) :mir/dst dst :mir/slot slot)))

#?(:kotoba
   (defn- instr-spill-store [src [:ref :form/r] slot [:ref :form/r]] [:ref :form/r]
     (mk3 :mir/op (kwf :mir/spill-store) :mir/src src :mir/slot slot)))

;; ---- lower-phis ----

;; The label that begins the join a phi at INDEX sits in: scan back over phis to
;; a label; anything else means none.
#?(:kotoba
   (defn- preceding-label [instructions [:ref :form/r] index :i64] [:ref :form/r]
     (loop [cursor (- index 1)]
       (if (< cursor 0)
         (form/nil-form)
         (let [op (kw-of (fget (form/nth-of instructions cursor) :mir/op))]
           (cond
             (= op :mir/label) (fget (form/nth-of instructions cursor) :mir/id)
             (= op :mir/phi) (recur (- cursor 1))
             :else (form/nil-form)))))))

;; The phi instructions of INSTRUCTIONS with their positions: a vector of
;; [index instruction] pair vectors.
#?(:kotoba
   (defn- phi-entries [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [ins (form/nth-of instructions i)]
             (recur (inc i)
                    (if (kw? (fget ins :mir/op) :mir/phi)
                      (vconj acc (form/vec2 (fint i) ins))
                      acc))))))))

;; A map from phi destination to its slot (position among the phis).
#?(:kotoba
   (defn- phi-slot-by-dst [phis [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of phis)]
       (loop [slot 0 acc (fmap)]
         (if (>= slot n) acc
           (recur (inc slot)
                  (massoc acc (fget (form/nth-of (form/nth-of phis slot) 1) :mir/dst) (fint slot))))))))

;; A map from slot to phi destination.
#?(:kotoba
   (defn- phi-dst-by-slot [phis [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of phis)]
       (loop [slot 0 acc (fmap)]
         (if (>= slot n) acc
           (recur (inc slot)
                  (massoc acc (fint slot) (fget (form/nth-of (form/nth-of phis slot) 1) :mir/dst))))))))

;; The merge-store list for each edge [predecessor join]: a map from the edge
;; pair vector to a vector of instructions, in phi order then incoming order.
#?(:kotoba
   (defn- stores-into-edges [stores [:ref :form/r] incomings [:ref :form/r] join [:ref :form/r] slot [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of incomings)]
       (loop [i 0 acc stores]
         (if (>= i n) acc
           (let [incoming (form/nth-of incomings i)
                 edge (form/vec2 (fget incoming :mir/predecessor) join)
                 store (mk2 :mir/op (kwf :mir/merge-store) :mir/src (fget incoming :mir/value))]
             (recur (inc i)
                    (massoc acc edge (vconj (mget acc edge) (kassoc store :mir/slot slot))))))))))

#?(:kotoba
   (defn- phi-stores-by-edge [instructions [:ref :form/r] phis [:ref :form/r] slot-by-dst [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of phis)]
       (loop [k 0 stores (fmap)]
         (if (>= k n) stores
           (let [entry (form/nth-of phis k)
                 index (ival (form/nth-of entry 0))
                 ins (form/nth-of entry 1)
                 join (preceding-label instructions index)
                 slot (mget slot-by-dst (fget ins :mir/dst))]
             (recur (inc k) (stores-into-edges stores (fget ins :mir/incomings) join slot))))))))

#?(:kotoba
   (defn- lower-phi-instructions [instructions [:ref :form/r] slot-by-dst [:ref :form/r] stores-by-edge [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 label (form/nil-form) out (fvec)]
         (if (>= i n) out
           (let [ins (form/nth-of instructions i)
                 op (kw-of (fget ins :mir/op))]
             (cond
               (= op :mir/label)
               (recur (inc i) (fget ins :mir/id) (vconj out ins))
               (= op :mir/phi)
               (recur (inc i) label
                      (vconj out (mk3 :mir/op (kwf :mir/merge-load)
                                      :mir/dst (fget ins :mir/dst)
                                      :mir/slot (mget slot-by-dst (fget ins :mir/dst)))))
               (= op :mir/jump)
               (recur (inc i) label
                      (vconj (vinto out (mget stores-by-edge (form/vec2 label (fget ins :mir/target)))) ins))
               :else
               (recur (inc i) label (vconj out ins)))))))))

;; {:program, :merge-slots, :merge-dst-by-slot} for PROGRAM with phis replaced by
;; frame-slot transport.
#?(:kotoba
   (defn- lower-phis [program [:ref :form/r]] [:ref :form/r]
     (let [instructions (fget program :mir/instructions)
           phis (phi-entries instructions)
           slot-by-dst (phi-slot-by-dst phis)
           stores-by-edge (phi-stores-by-edge instructions phis slot-by-dst)
           lowered (lower-phi-instructions instructions slot-by-dst stores-by-edge)]
       (mk3 :program (kassoc program :mir/instructions lowered)
            :merge-slots (fint (form/count-of phis))
            :merge-dst-by-slot (phi-dst-by-slot phis)))))

;; ---- parallel copies ----

;; The index of the first pending copy whose destination no pending copy reads,
;; or -1.
#?(:kotoba
   (defn- ready-copy-index [pending [:ref :form/r]] :i64
     (let [n (form/count-of pending)]
       (loop [i 0]
         (if (>= i n) -1
           (let [dst (fget (form/nth-of pending i) :mir/dst)]
             (if (loop [j 0]
                   (if (>= j n) false
                     (if (form/eq (fget (form/nth-of pending j) :mir/src) dst) true (recur (inc j)))))
               (recur (inc i))
               i)))))))

#?(:kotoba
   (defn- copies-without-identity [copies [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of copies)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [c (form/nth-of copies i)]
             (recur (inc i) (if (form/eq (fget c :mir/dst) (fget c :mir/src)) acc (vconj acc c)))))))))

;; PENDING with every copy reading SRC redirected to the temporary marker.
#?(:kotoba
   (defn- redirect-copies [pending [:ref :form/r] src [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of pending)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [c (form/nth-of pending i)]
             (recur (inc i)
                    (vconj acc (if (form/eq src (fget c :mir/src))
                                 (kassoc c :mir/src (kwf :kotoba.mir/parallel-copy-temp))
                                 c)))))))))

;; Lower simultaneous physical-register copies deterministically. Returns a map
;; with :instructions and :used-temp?.
#?(:kotoba
   (defn- schedule-parallel-copies [copies [:ref :form/r] temp-slot :i64] [:ref :form/r]
     (loop [pending (copies-without-identity copies) out (fvec) used-temp? false]
       (if (= 0 (form/count-of pending))
         (mk2 :instructions out :used-temp? (form/bool-form used-temp?))
         (let [ready (ready-copy-index pending)]
           (if (>= ready 0)
             (let [copy (form/nth-of pending ready)
                   dst (fget copy :mir/dst)
                   src (fget copy :mir/src)
                   instruction (if (kw? src :kotoba.mir/parallel-copy-temp)
                                 (instr-spill-load dst (fint temp-slot))
                                 (instr-move dst src))]
               (recur (vremove-at pending ready) (vconj out instruction) used-temp?))
             (let [src (fget (form/nth-of pending 0) :mir/src)]
               (recur (redirect-copies pending src)
                      (vconj out (instr-spill-store src (fint temp-slot)))
                      true))))))))

;; ---- coalescing phi transport ----

;; How many instructions of INSTRUCTIONS have op OP and a slot below LIMIT.
#?(:kotoba
   (defn- count-slot-ops [instructions [:ref :form/r] op :keyword limit :i64 slot :i64] :i64
     (let [n (form/count-of instructions)]
       (loop [i 0 c 0]
         (if (>= i n) c
           (let [ins (form/nth-of instructions i)]
             (recur (inc i)
                    (if (and (kw? (fget ins :mir/op) op)
                             (form/is-int? (fget ins :mir/slot))
                             (< (ival (fget ins :mir/slot)) limit)
                             (= (ival (fget ins :mir/slot)) slot))
                      (inc c)
                      c))))))))

;; The destination of the first spill-load of SLOT, or a nil form.
#?(:kotoba
   (defn- first-load-register [instructions [:ref :form/r] slot :i64] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) (form/nil-form)
           (let [ins (form/nth-of instructions i)]
             (if (and (kw? (fget ins :mir/op) :mir/spill-load)
                      (int-eq? (fget ins :mir/slot) slot))
               (fget ins :mir/dst)
               (recur (inc i)))))))))

#?(:kotoba
   (defn- transport-complete? [instructions [:ref :form/r] merge-slots :i64] :bool
     (loop [slot 0]
       (if (>= slot merge-slots) true
         (if (and (= 1 (count-slot-ops instructions :mir/spill-load merge-slots slot))
                  (<= 2 (count-slot-ops instructions :mir/spill-store merge-slots slot)))
           (recur (inc slot))
           false)))))

#?(:kotoba
   (defn- merge-store? [ins [:ref :form/r] merge-slots :i64] :bool
     (and (kw? (fget ins :mir/op) :mir/spill-store)
          (form/is-int? (fget ins :mir/slot))
          (< (ival (fget ins :mir/slot)) merge-slots))))

;; Number of consecutive merge-stores starting at FROM.
#?(:kotoba
   (defn- merge-store-run [instructions [:ref :form/r] from :i64 merge-slots :i64] :i64
     (let [n (form/count-of instructions)]
       (loop [i from]
         (if (and (< i n) (merge-store? (form/nth-of instructions i) merge-slots))
           (recur (inc i))
           (- i from))))))

;; The copies that realise the merge-stores in [FROM, FROM+RUN): each loads its
;; phi destination from the store's source.
#?(:kotoba
   (defn- store-copies [instructions [:ref :form/r] from :i64 run :i64 instructions-all [:ref :form/r]] [:ref :form/r]
     (loop [k 0 acc (fvec)]
       (if (>= k run) acc
         (let [st (form/nth-of instructions (+ from k))]
           (recur (inc k)
                  (vconj acc (mk2 :mir/dst (first-load-register instructions-all (ival (fget st :mir/slot)))
                                  :mir/src (fget st :mir/src)))))))))

;; Rewrite the instruction stream of a complete transport: the result map has
;; :out, :used-temp? and :valid?.
#?(:kotoba
   (defn- coalesce-rewrite [instructions [:ref :form/r] merge-slots :i64 frame-slots :i64] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 out (fvec) used-temp? false]
         (if (>= i n)
           (mk3 :out out :used-temp? (form/bool-form used-temp?) :valid? (form/bool-form true))
           (let [ins (form/nth-of instructions i)]
             (cond
               (merge-store? ins merge-slots)
               (let [run (merge-store-run instructions i merge-slots)
                     after (+ i run)]
                 (if (and (< after n) (kw? (fget (form/nth-of instructions after) :mir/op) :mir/jump))
                   (let [copies (store-copies instructions i run instructions)
                         scheduled (schedule-parallel-copies copies (- frame-slots merge-slots))]
                     (recur after
                            (vinto out (fget scheduled :instructions))
                            (or used-temp? (form/is-true? (fget scheduled :used-temp?)))))
                   (mk3 :out out :used-temp? (form/bool-form used-temp?) :valid? (form/bool-form false))))

               (and (kw? (fget ins :mir/op) :mir/spill-load)
                    (form/is-int? (fget ins :mir/slot))
                    (< (ival (fget ins :mir/slot)) merge-slots))
               (recur (inc i) out used-temp?)

               (fhas? ins :mir/slot)
               (let [slot (ival (fget ins :mir/slot))
                     compact (- slot (if (< slot merge-slots) slot merge-slots))]
                 (recur (inc i) (vconj out (kassoc ins :mir/slot (fint compact))) used-temp?))

               :else
               (recur (inc i) (vconj out ins) used-temp?))))))))

;; Replace complete edge merge-store groups and their join loads with a
;; deterministic parallel-copy schedule. Invalid or incomplete groups keep the
;; frame-backed representation instead of being partially rewritten.
#?(:kotoba
   (defn- coalesce-phi-transports [program [:ref :form/r] merge-slots :i64] [:ref :form/r]
     (if (= merge-slots 0)
       (kassoc (fmap) :program program)
       (let [instructions (fget program :mir/instructions)
             frame-slots (ival (fget program :mir/frame-slots))]
         (if (not (transport-complete? instructions merge-slots))
           (kassoc (fmap) :program program)
           (let [r (coalesce-rewrite instructions merge-slots frame-slots)]
             (if (not (form/is-true? (fget r :valid?)))
               (kassoc (fmap) :program program)
               (let [rewritten (kassoc (kassoc program :mir/frame-slots
                                               (fint (+ (- frame-slots merge-slots)
                                                        (if (form/is-true? (fget r :used-temp?)) 1 0))))
                                       :mir/instructions (fget r :out))
                     p (flat-problem rewritten)]
                 (if (= p :ok)
                   (kassoc (fmap) :program rewritten)
                   (kassoc (fmap) :problem (kwf p)))))))))))

;; ---- control flow ----

;; The basic blocks, each {:index :start :end}.
#?(:kotoba
   (defn- basic-blocks [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (if (= n 0)
         (vconj (fvec) (mk3 :index (fint 0) :start (fint 0) :end (fint -1)))
         (loop [i 1 start 0 acc (fvec)]
           (if (>= i n)
             (vconj acc (mk3 :index (fint (form/count-of acc)) :start (fint start) :end (fint (- n 1))))
             (if (let [pop (kw-of (fget (form/nth-of instructions (- i 1)) :mir/op))] (or (kw? (fget (form/nth-of instructions i) :mir/op) :mir/label) (= pop :mir/jump) (= pop :mir/branch-zero) (= pop :mir/branch-nonzero) (= pop :mir/return)))
               (recur (inc i) i
                      (vconj acc (mk3 :index (fint (form/count-of acc)) :start (fint start) :end (fint (- i 1)))))
               (recur (inc i) start acc))))))))

;; Label id -> index of the block it begins.
#?(:kotoba
   (defn- label-block-indexes [instructions [:ref :form/r] blocks [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of blocks)]
       (loop [b 0 acc (fmap)]
         (if (>= b n) acc
           (let [block (form/nth-of blocks b)
                 first-ins (form/nth-of instructions (ival (fget block :start)))]
             (recur (inc b)
                    (if (kw? (fget first-ins :mir/op) :mir/label)
                      (massoc acc (fget first-ins :mir/id) (fget block :index))
                      acc))))))))

;; Successor block indexes of each block, as a vector of vectors.
#?(:kotoba
   (defn- block-successors [instructions [:ref :form/r] blocks [:ref :form/r] label->block [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of blocks)]
       (loop [b 0 acc (fvec)]
         (if (>= b n) acc
           (let [block (form/nth-of blocks b)
                 last-ins (form/nth-of instructions (ival (fget block :end)))
                 op (kw-of (fget last-ins :mir/op))
                 target (mget label->block (fget last-ins :mir/target))
                 has-next (< (+ b 1) n)]
             (recur (inc b)
                    (vconj acc
                           (cond
                             (= op :mir/return) (fvec)
                             (= op :mir/jump) (vconj (fvec) target)
                             (or (= op :mir/branch-zero) (= op :mir/branch-nonzero))
                             (let [s (if has-next (vconj (fvec) (fint (+ b 1))) (fvec))]
                               (if (form/is-nil? target) s (vconj s target)))
                             has-next (vconj (fvec) (fint (+ b 1)))
                             :else (fvec))))))))))

;; The vreg a instruction defines, or a nil form.
#?(:kotoba
   (defn- instruction-def [instruction [:ref :form/r]] [:ref :form/r]
     (let [d (fget instruction :mir/dst)]
       (if (gmir/vreg? d) d (form/nil-form)))))

;; Per block {:uses :defs}: the vregs read before any local definition, and the
;; vregs defined.
#?(:kotoba
   (defn- block-use-def [instructions [:ref :form/r] blocks [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of blocks)]
       (loop [b 0 acc (fvec)]
         (if (>= b n) acc
           (let [block (form/nth-of blocks b)
                 start (ival (fget block :start))
                 end (ival (fget block :end))]
             (recur (inc b)
                    (vconj acc
                           (loop [i start uses (fset) defs (fset)]
                             (if (> i end)
                               (mk2 :uses uses :defs defs)
                               (let [ins (form/nth-of instructions i)
                                     vs (vreg-sources ins)
                                     m (form/count-of vs)
                                     uses2 (loop [j 0 u uses]
                                             (if (>= j m) u
                                               (let [v (form/nth-of vs j)]
                                                 (recur (inc j) (if (member-of? defs v) u (sconj u v))))))
                                     d (instruction-def ins)]
                                 (recur (inc i) uses2 (if (form/is-nil? d) defs (sconj defs d))))))))))))))

;; Union of live-in sets of the blocks in SUCCS.
#?(:kotoba
   (defn- union-live-in [live-in [:ref :form/r] succs [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of succs)]
       (loop [k 0 acc (fset)]
         (if (>= k n) acc
           (let [s (ival (form/nth-of succs k))
                 xs (form/nth-of live-in s)
                 m (form/count-of xs)]
             (recur (inc k)
                    (loop [j 0 u acc]
                      (if (>= j m) u (recur (inc j) (sconj u (form/nth-of xs j))))))))))))

;; uses + (out - defs)
#?(:kotoba
   (defn- live-in-of [uses [:ref :form/r] defs [:ref :form/r] out [:ref :form/r]] [:ref :form/r]
     (let [m (form/count-of out)]
       (loop [j 0 u uses]
         (if (>= j m) u
           (let [v (form/nth-of out j)]
             (recur (inc j) (if (member-of? defs v) u (sconj u v)))))))))

;; Live variables by fixed point: {:blocks :live-in :live-out}.
#?(:kotoba
   (defn- next-live-out [live-in [:ref :form/r] successors [:ref :form/r]] [:ref :form/r]
     (let [block-count (form/count-of successors)]
       (loop [b 0 acc (fvec)]
         (if (>= b block-count) acc
           (recur (inc b) (vconj acc (union-live-in live-in (form/nth-of successors b)))))))))

#?(:kotoba
   (defn- next-live-in [use-def [:ref :form/r] next-out [:ref :form/r]] [:ref :form/r]
     (let [block-count (form/count-of use-def)]
       (loop [b 0 acc (fvec)]
         (if (>= b block-count) acc
           (let [ud (form/nth-of use-def b)]
             (recur (inc b)
                    (vconj acc (live-in-of (fget ud :uses) (fget ud :defs) (form/nth-of next-out b))))))))))

#?(:kotoba
   (defn- cfg-live-variables [instructions [:ref :form/r]] [:ref :form/r]
     (let [blocks (basic-blocks instructions)
           label->block (label-block-indexes instructions blocks)
           successors (block-successors instructions blocks label->block)
           use-def (block-use-def instructions blocks)
           none (empty-sets (form/count-of blocks))]
       (loop [live-in none live-out none]
         (let [next-out (next-live-out live-in successors)
               next-in (next-live-in use-def next-out)]
           (if (and (form/eq next-in live-in) (form/eq next-out live-out))
             (mk3 :blocks blocks :live-in next-in :live-out next-out)
             (recur next-in next-out)))))))

;; The `end` index of every block that closes with a jump/branch to a block at or
;; before itself.
#?(:kotoba
   (defn- back-edge-block-ends [instructions [:ref :form/r] blocks [:ref :form/r] label->block [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of blocks)]
       (loop [b 0 acc (fset)]
         (if (>= b n) acc
           (let [block (form/nth-of blocks b)
                 end (ival (fget block :end))
                 last-ins (form/nth-of instructions end)
                 op (kw-of (fget last-ins :mir/op))
                 tb (mget label->block (fget last-ins :mir/target))]
             (recur (inc b)
                    (if (and (or (= op :mir/jump) (= op :mir/branch-zero) (= op :mir/branch-nonzero))
                             (form/is-int? tb)
                             (<= (form/int-value tb) b))
                      (sconj acc (fint end))
                      acc))))))))

;; A map vreg -> last index at which an instruction reads it.
#?(:kotoba
   (defn- textual-last-uses [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 uses (fmap)]
         (if (>= i n) uses
           (let [vs (vreg-sources (form/nth-of instructions i))
                 m (form/count-of vs)]
             (recur (inc i)
                    (loop [j 0 u uses]
                      (if (>= j m) u (recur (inc j) (massoc u (form/nth-of vs j) (fint i))))))))))))

#?(:kotoba
   (defn- extend-to-end [uses [:ref :form/r] live [:ref :form/r] end :i64] [:ref :form/r]
     (let [m (form/count-of live)]
       (loop [j 0 acc uses]
         (if (>= j m) acc
           (let [v (form/nth-of live j)
                 old (ival-or (mget acc v) -1)]
             (recur (inc j) (massoc acc v (fint (if (> end old) end old))))))))))

;; Last use of each vreg: the last textual read, or, for a value live out of a
;; loop latch, the end of that latch.
#?(:kotoba
   (defn- last-uses [instructions [:ref :form/r]] [:ref :form/r]
     (let [textual (textual-last-uses instructions)
           blocks (basic-blocks instructions)
           label->block (label-block-indexes instructions blocks)
           live-out (fget (cfg-live-variables instructions) :live-out)
           back-edges (back-edge-block-ends instructions blocks label->block)
           n (form/count-of blocks)]
       (loop [b 0 uses textual]
         (if (>= b n) uses
           (let [end (fget (form/nth-of blocks b) :end)]
             (recur (inc b)
                    (if (member-of? back-edges end)
                      (extend-to-end uses (form/nth-of live-out b) (ival end))
                      uses))))))))

;; Vregs sorted by their printed form (the host orders by `str`).
#?(:kotoba
   (defn- insert-by-text [sorted [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of sorted)
           t (kw-text v)]
       ;; after the last item whose text is <= t (stable)
       (loop [i n]
         (if (and (> i 0) (> (string-compare (kw-text (form/nth-of sorted (- i 1))) t) 0))
           (recur (- i 1))
           (form/form-vec
            (form/append-many
             (form/append-form (form/kids-of (vtake sorted i)) v)
             (form/kids-of (vdrop sorted i)))))))))

#?(:kotoba
   (defn- ordered-vregs [values [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of values)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (recur (inc i) (insert-by-text acc (form/nth-of values i))))))))

;; A map vreg -> vector of the instruction indexes that read it.
#?(:kotoba
   (defn- use-indexes [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 uses (fmap)]
         (if (>= i n) uses
           (let [vs (vdistinct (vreg-sources (form/nth-of instructions i)))
                 m (form/count-of vs)]
             (recur (inc i)
                    (loop [j 0 u uses]
                      (if (>= j m) u
                        (let [v (form/nth-of vs j)]
                          (recur (inc j) (massoc u v (vconj (mget u v) (fint i))))))))))))))

#?(:kotoba nil :default
(defn- sources [instruction]
  (instruction-sources instruction)))

#?(:kotoba nil :default
(defn- preceding-label [instructions index]
  (loop [cursor (dec index)]
    (when (not (neg? cursor))
      (let [instruction (nth instructions cursor)]
        (cond
          (= :mir/label (:mir/op instruction)) (:mir/id instruction)
          (= :mir/phi (:mir/op instruction)) (recur (dec cursor))
          :else nil))))))

#?(:kotoba nil :default
(defn- lower-phis
  [{:mir/keys [instructions] :as program}]
  (let [phis (->> instructions
                  (map-indexed vector)
                  (filter (fn [[_ instruction]] (= :mir/phi (:mir/op instruction))))
                  vec)
        slot-by-dst (into {} (map-indexed (fn [slot [_ instruction]]
                                           [(:mir/dst instruction) slot])
                                         phis))
        stores-by-edge
        (reduce (fn [stores [index {:mir/keys [dst incomings]}]]
                  (let [join (preceding-label instructions index)
                        slot (get slot-by-dst dst)]
                    (reduce (fn [out incoming]
                              (update out [(:mir/predecessor incoming) join]
                                      (fnil conj [])
                                      {:mir/op :mir/merge-store
                                       :mir/src (:mir/value incoming)
                                       :mir/slot slot}))
                            stores incomings)))
                {} phis)
        lowered
        (:out
         (reduce (fn [{:keys [label out]} {:mir/keys [op target dst] :as instruction}]
                   (case op
                     :mir/label {:label (:mir/id instruction)
                                 :out (conj out instruction)}
                     :mir/phi {:label label
                               :out (conj out {:mir/op :mir/merge-load
                                              :mir/dst dst
                                              :mir/slot (get slot-by-dst dst)})}
                     :mir/jump {:label label
                                :out (into out
                                           (concat (get stores-by-edge [label target] [])
                                                   [instruction]))}
                     {:label label :out (conj out instruction)}))
                 {:label nil :out []}
                 instructions))]
    {:program (assoc program :mir/instructions (vec lowered))
     :merge-slots (count phis)
     :merge-dst-by-slot (into {} (map-indexed (fn [slot [_ instruction]]
                                                [slot (:mir/dst instruction)])
                                              phis))})))

#?(:kotoba nil :default
(def ^:private parallel-copy-temp ::parallel-copy-temp))

#?(:kotoba nil :default
(defn- remove-at [values index]
  (into (subvec values 0 index) (subvec values (inc index)))))

#?(:kotoba nil :default
(defn- schedule-parallel-copies
  "Lower simultaneous physical-register copies deterministically. Acyclic
  copies become moves. A cycle is broken with one reusable frame slot."
  [copies temp-slot]
  (loop [pending (vec (remove #(= (:mir/dst %) (:mir/src %)) copies))
         out []
         used-temp? false]
    (if (empty? pending)
      {:instructions out :used-temp? used-temp?}
      (let [pending-sources (set (map :mir/src pending))
            ready-index (first
                         (keep-indexed
                          (fn [index {:mir/keys [dst]}]
                            (when-not (contains? pending-sources dst) index))
                          pending))]
        (if (some? ready-index)
          (let [{:mir/keys [dst src]} (nth pending ready-index)
                instruction (if (= parallel-copy-temp src)
                              {:mir/op :mir/spill-load
                               :mir/dst dst
                               :mir/slot temp-slot}
                              {:mir/op :mir/move :mir/dst dst :mir/src src})]
            (recur (remove-at pending ready-index)
                   (conj out instruction)
                   used-temp?))
          (let [{:mir/keys [src]} (first pending)]
            (recur (mapv (fn [copy]
                           (if (= src (:mir/src copy))
                             (assoc copy :mir/src parallel-copy-temp)
                             copy))
                         pending)
                   (conj out {:mir/op :mir/spill-store
                              :mir/src src
                              :mir/slot temp-slot})
                   true))))))))

#?(:kotoba nil :default
(defn- coalesce-phi-transports
  "Replace complete edge merge-store groups and their join loads with a
  deterministic parallel-copy schedule. Invalid or incomplete groups retain
  the frame-backed representation instead of being partially rewritten."
  [{:mir/keys [instructions frame-slots] :as program} merge-slots]
  (if (zero? merge-slots)
    program
    (let [loads-by-slot (group-by :mir/slot
                                  (filter #(and (= :mir/spill-load (:mir/op %))
                                                (< (:mir/slot %) merge-slots))
                                          instructions))
          stores-by-slot (group-by :mir/slot
                                   (filter #(and (= :mir/spill-store (:mir/op %))
                                                 (< (:mir/slot %) merge-slots))
                                           instructions))
          candidates (set (range merge-slots))
          complete? (every? #(and (= 1 (count (get loads-by-slot %)))
                                  (<= 2 (count (get stores-by-slot %))))
                            candidates)
          load-register (into {} (map (fn [slot]
                                        [slot (:mir/dst (first (get loads-by-slot slot)))])
                                      candidates))
          compact-slot (fn [slot]
                         (- slot (count (filter #(< % slot) candidates))))
          merge-store? #(and (= :mir/spill-store (:mir/op %))
                             (contains? candidates (:mir/slot %)))]
      (if-not complete?
        program
        (let [{:keys [out used-temp? valid?]}
              (loop [remaining instructions, out [], used-temp? false]
                (if-let [{:mir/keys [op slot] :as instruction} (first remaining)]
                  (cond
                    (merge-store? instruction)
                    (let [[stores tail] (split-with merge-store? remaining)]
                      (if (= :mir/jump (:mir/op (first tail)))
                        (let [copies (mapv (fn [{:mir/keys [src slot]}]
                                             {:mir/dst (get load-register slot)
                                              :mir/src src})
                                           stores)
                              scheduled (schedule-parallel-copies
                                         copies
                                         (- frame-slots (count candidates)))]
                          (recur tail
                                 (into out (:instructions scheduled))
                                 (or used-temp? (:used-temp? scheduled))))
                        {:out out :used-temp? used-temp? :valid? false}))

                    (and (= :mir/spill-load op) (contains? candidates slot))
                    (recur (next remaining) out used-temp?)

                    (contains? instruction :mir/slot)
                    (recur (next remaining)
                           (conj out (assoc instruction :mir/slot (compact-slot slot)))
                           used-temp?)

                    :else
                    (recur (next remaining) (conj out instruction) used-temp?))
                  {:out out :used-temp? used-temp? :valid? true}))]
          (if-not valid?
            program
            (validate-flat! (assoc program
                                   :mir/frame-slots (+ (- frame-slots (count candidates))
                                                       (if used-temp? 1 0))
                                   :mir/instructions (vec out))))))))))

#?(:kotoba nil :default
(defn- instruction-def [instruction]
  (when (gmir/vreg? (:mir/dst instruction))
    (:mir/dst instruction))))

#?(:kotoba nil :default
(def ^:private terminators
  #{:mir/jump :mir/branch-zero :mir/branch-nonzero :mir/return}))

#?(:kotoba nil :default
(defn- basic-blocks [instructions]
  (let [n (count instructions)
        leaders (sort
                 (into #{0}
                       (mapcat
                        (fn [index]
                          (let [op (:mir/op (nth instructions index))]
                            (cond
                              (= op :mir/label) [index]
                              (contains? terminators op)
                              (when (< (inc index) n) [(inc index)])
                              :else nil)))
                        (range n))))
        block-count (count leaders)]
    (mapv (fn [block-index]
            (let [start (nth leaders block-index)
                  end (if (< (inc block-index) block-count)
                        (dec (nth leaders (inc block-index)))
                        (dec n))]
              {:index block-index :start start :end end}))
          (range block-count)))))

#?(:kotoba nil :default
(defn- label-block-indexes [instructions blocks]
  (into {}
        (keep (fn [{:keys [index start]}]
                (when (= :mir/label (:mir/op (nth instructions start)))
                  [(:mir/id (nth instructions start)) index]))
              blocks))))

#?(:kotoba nil :default
(defn- block-successors [instructions blocks label->block]
  (mapv (fn [{:keys [index end]}]
          (let [op (:mir/op (nth instructions end))]
            (cond
              (= op :mir/return) []
              (= op :mir/jump)
              [(get label->block (:mir/target (nth instructions end)))]
              (contains? #{:mir/branch-zero :mir/branch-nonzero} op)
              (vec (remove nil?
                           [(when (< (inc index) (count blocks)) (inc index))
                            (get label->block
                                 (:mir/target (nth instructions end)))]))
              (< (inc index) (count blocks)) [(inc index)]
              :else [])))
        blocks)))

#?(:kotoba nil :default
(defn- block-predecessors [successors]
  (let [block-count (count successors)]
    (reduce (fn [preds from]
              (reduce (fn [acc to]
                        (update acc to (fnil conj #{}) from))
                      preds
                      (nth successors from)))
            (vec (repeat block-count #{}))
            (range block-count)))))

#?(:kotoba nil :default
(defn- intersect-dominator-sets [sets]
  (if (empty? sets)
    #{}
    (let [[head & tail] sets]
      (reduce set/intersection head tail)))))

#?(:kotoba nil :default
(defn- cfg-dominator-sets [predecessors]
  (let [block-count (count predecessors)
        universe (set (range block-count))
        initial (mapv (fn [block-index]
                        (if (zero? block-index) #{0} universe))
                      (range block-count))]
    (loop [dom initial]
      (let [next-dom
            (mapv (fn [block-index]
                    (if (zero? block-index)
                      #{0}
                      (let [preds (seq (nth predecessors block-index))]
                        (if preds
                          (conj (intersect-dominator-sets
                                 (map #(nth dom %) preds))
                                block-index)
                          (nth dom block-index)))))
                  (range block-count))]
        (if (= next-dom dom)
          dom
          (recur next-dom)))))))

#?(:kotoba nil :default
(defn- cfg-immediate-dominators [dominators]
  (mapv (fn [block-index]
          (when (pos? block-index)
            (let [strict (disj (nth dominators block-index) block-index)]
              (first (filter (fn [candidate]
                               (not (some (fn [other]
                                            (and (not= other candidate)
                                                 (contains? (nth dominators other)
                                                            candidate)))
                                          strict)))
                             strict)))))
        (range (count dominators)))))

#?(:kotoba nil :default
(defn- cfg-dominates? [dominators dominator block-index]
  (contains? (nth dominators block-index) dominator)))

#?(:kotoba nil :default
(defn- cfg-dominator-analysis [instructions]
  (let [blocks (basic-blocks instructions)
        label->block (label-block-indexes instructions blocks)
        successors (block-successors instructions blocks label->block)
        predecessors (block-predecessors successors)
        dominators (cfg-dominator-sets predecessors)]
    {:blocks blocks
     :successors successors
     :predecessors predecessors
     :dominators dominators
     :immediate-dominators (cfg-immediate-dominators dominators)})))

#?(:kotoba nil :default
(defn- block-use-def [instructions blocks]
  (mapv (fn [{:keys [start end]}]
          (reduce (fn [{:keys [uses defs]} index]
                    (let [instruction (nth instructions index)]
                      ;; Only reads before a local definition are live-in.
                      ;; Counting later reads makes loop-local temporaries look
                      ;; live across the back edge and lengthens their lifetime
                      ;; to the latch.
                      {:uses (into uses (remove defs
                                                (filter gmir/vreg?
                                                        (sources instruction))))
                       :defs (if-let [definition (instruction-def instruction)]
                               (conj defs definition)
                               defs)}))
                  {:uses #{} :defs #{}}
                  (range start (inc end))))
        blocks)))

#?(:kotoba nil :default
(defn- cfg-live-variables [instructions]
  (let [blocks (basic-blocks instructions)
        label->block (label-block-indexes instructions blocks)
        successors (block-successors instructions blocks label->block)
        use-def (block-use-def instructions blocks)
        block-count (count blocks)
        empty (vec (repeat block-count #{}))]
    (loop [live-in empty
           live-out empty]
      (let [next-out (mapv (fn [block-index]
                             (reduce into #{}
                                     (map #(nth live-in %) (nth successors block-index))))
                           (range block-count))
            next-in (mapv (fn [block-index]
                            (let [{:keys [uses defs]} (nth use-def block-index)
                                  out (nth next-out block-index)]
                              (into uses (remove defs out))))
                          (range block-count))]
        (if (and (= next-in live-in) (= next-out live-out))
          {:blocks blocks :live-in next-in :live-out next-out}
          (recur next-in next-out)))))))

#?(:kotoba nil :default
(defn- back-edge-block-ends [instructions blocks label->block]
  (into #{}
        (keep (fn [{:keys [index end]}]
                (let [op (:mir/op (nth instructions end))]
                  (when (contains? #{:mir/jump :mir/branch-zero
                                     :mir/branch-nonzero} op)
                    (let [target (:mir/target (nth instructions end))
                          target-block (get label->block target)]
                      (when (and (some? target-block) (<= target-block index))
                        end)))))
              blocks))))

#?(:kotoba nil :default
(defn- cfg-last-uses [instructions]
  (let [textual (reduce-kv
                 (fn [uses index instruction]
                   (reduce #(assoc %1 %2 index) uses
                           (filter gmir/vreg? (sources instruction))))
                 {} instructions)
        blocks (basic-blocks instructions)
        label->block (label-block-indexes instructions blocks)
        {:keys [live-out]} (cfg-live-variables instructions)
        back-edges (back-edge-block-ends instructions blocks label->block)]
    (reduce (fn [uses block-index]
              (let [end (:end (nth blocks block-index))]
                (if (contains? back-edges end)
                  (reduce (fn [out value]
                            (assoc out value (max (get out value -1) end)))
                          uses
                          (nth live-out block-index))
                  uses)))
            textual
            (range (count blocks))))))

#?(:kotoba nil :default
(defn- last-uses [instructions]
  (cfg-last-uses instructions)))

#?(:kotoba nil :default
(defn- ordered-vregs [values]
  (sort-by (fn [value] (or (:gmir/id value) (str value))) values)))

#?(:kotoba nil :default
(defn- use-indexes
  "Every instruction index at which VALUE is a source, in order."
  [instructions]
  (reduce-kv
   (fn [uses index instruction]
     (reduce (fn [indexes value]
               (update indexes value (fnil conj []) index))
             uses
             (distinct (filter gmir/vreg? (sources instruction)))))
   {} instructions)))

;; ---------------------------------------------------------------------------
;; Kotoba route: allocation helpers over Form. Allocator state is one map form
;; with the keys :assigned :free :reserve :backed :next-slot :out :used-temp?
;; :temp-slot :def-position :index, and :problem once a step has failed.
;; A failing step sets :problem (the host throws) and every caller stops at it.
;; ---------------------------------------------------------------------------

#?(:kotoba
   (defn- direct-recur-sites [instructions [:ref :form/r] current-function [:ref :form/r] parameter-homes [:ref :form/r]] [:ref :form/r]
     ;; indexes of self tail calls with as many arguments as there are homes
     (let [n (form/count-of instructions)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [ins (form/nth-of instructions i)]
             (recur (inc i)
                    (if (and (kw? (fget ins :mir/op) :mir/tail-call)
                             (form/eq current-function (fget ins :mir/callee))
                             (= (form/count-of (fget ins :mir/arguments))
                                (form/count-of parameter-homes)))
                      (vconj acc (fint i))
                      acc))))))))

;; How many times VALUE appears in the vector ARGUMENTS.
#?(:kotoba
   (defn- occurrences [arguments [:ref :form/r] value [:ref :form/r]] :i64
     (let [n (form/count-of arguments)]
       (loop [i 0 c 0]
         (if (>= i n) c
           (recur (inc i) (if (form/eq (form/nth-of arguments i) value) (inc c) c)))))))

;; Map a self-tail argument SSA value to its exact allocator-owned parameter home
;; when that recur is the value's sole use.
#?(:kotoba
   (defn- direct-recur-home-candidates [instructions [:ref :form/r] current-function [:ref :form/r] parameter-homes [:ref :form/r] indexes [:ref :form/r]] [:ref :form/r]
     (let [sites (direct-recur-sites instructions current-function parameter-homes)]
       (if (= 1 (form/count-of sites))
         (let [index (ival (form/nth-of sites 0))
               arguments (fget (form/nth-of instructions index) :mir/arguments)
               n (form/count-of arguments)]
           (loop [k 0 out (fmap)]
             (if (>= k n) out
               (let [value (form/nth-of arguments k)
                     uses (mget indexes value)]
                 (recur (inc k)
                        (if (and (gmir/vreg? value)
                                 (= 1 (occurrences arguments value))
                                 (= 1 (form/count-of uses))
                                 (int-eq? (form/nth-of uses 0) index))
                          (massoc out value (form/nth-of parameter-homes k))
                          out))))))
         (fmap)))))

;; The suffix after a producer reaches its sole recur use without crossing a
;; control-flow or call boundary.
#?(:kotoba
   (defn- straight-line-to-recur? [instructions [:ref :form/r] producer-index :i64 recur-index :i64] :bool
     (loop [i (+ producer-index 1)]
       (if (>= i recur-index) true
         (let [op (kw-of (fget (form/nth-of instructions i) :mir/op))]
           (if (or (call-operation? op) (= op :mir/label) (= op :mir/jump) (= op :mir/branch-zero) (= op :mir/branch-nonzero) (= op :mir/return) (= op :mir/tail-call) (= op :mir/recur) (= op :mir/reentry))
             false
             (recur (inc i))))))))

;; The first use of VALUE at or after INDEX, or -1.
#?(:kotoba
   (defn- next-use-of [indexes [:ref :form/r] index :i64 value [:ref :form/r]] :i64
     (let [uses (mget indexes value)
           n (form/count-of uses)]
       (loop [k 0]
         (if (>= k n) -1
           (let [u (ival (form/nth-of uses k))]
             (if (>= u index) u (recur (inc k)))))))))

;; The assigned value with the furthest next use, excluding PROTECTED operands.
;; Ties keep the earlier ordered entry. A nil form when nothing is eligible.
#?(:kotoba
   (defn- furthest-victim [assigned [:ref :form/r] indexes [:ref :form/r] index :i64 protected [:ref :form/r]] [:ref :form/r]
     (let [ordered (ordered-vregs (mkeys assigned))
           candidates (vremove-members ordered protected)
           n (form/count-of candidates)]
       (if (= n 0)
         (form/nil-form)
         (loop [k 1 best (form/nth-of candidates 0)]
           (if (>= k n) best
             (let [value (form/nth-of candidates k)
                   best-use (next-use-of indexes index best)
                   value-use (next-use-of indexes index value)]
               (recur (inc k) (if (> value-use best-use) value best)))))))))

;; STATE's assignment without VALUES, their registers back on the free list
;; unless another value still owns them.
#?(:kotoba
   (defn- dissoc-all [m [:ref :form/r] ks [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of ks)]
       (loop [i 0 acc m]
         (if (>= i n) acc (recur (inc i) (mdissoc acc (form/nth-of ks i))))))))

;; The registers ASSIGNED gives to VALUES, in VALUES' order.
#?(:kotoba
   (defn- registers-of [assigned [:ref :form/r] values [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of values)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (recur (inc i) (vconj acc (mget assigned (form/nth-of values i)))))))))

#?(:kotoba
   (defn- expire-assigned [state [:ref :form/r] values [:ref :form/r]] [:ref :form/r]
     (let [expired (ordered-vregs values)
           assigned (fget state :assigned)
           remaining (dissoc-all assigned expired)
           still-owned (mvals remaining)
           freed (vremove-members (registers-of assigned expired) still-owned)]
       (kassoc (kassoc state :assigned remaining)
               :free (vinto (fget state :free) freed)))))

;; Re-split POOL into the scratch free list and the reserve (leaf + preserved)
;; after a call has clobbered every caller-saved register.
#?(:kotoba
   (defn- rebuild-pool-lists [target [:ref :form/r] pool [:ref :form/r] assigned [:ref :form/r]] [:ref :form/r]
     (let [owned (mvals assigned)
           scratch-count (form/count-of (form/form-get (physical-registers) target))]
       (mk2 :free (vremove-members (vtake pool scratch-count) owned)
            :reserve (vremove-members (vdrop pool scratch-count) owned)))))

#?(:kotoba
   (defn- expire-assigned-in-pool [target [:ref :form/r] state [:ref :form/r] values [:ref :form/r]] [:ref :form/r]
     (let [assigned (fget state :assigned)
           remaining (dissoc-all assigned values)
           still-owned (mvals remaining)
           released (vremove-members (registers-of assigned (ordered-vregs values)) still-owned)
           scratch (form/form-get (physical-registers) target)
           state2 (expire-assigned state values)
           free2 (vinto (vremove-members (fget state2 :free) released) (vkeep-members released scratch))
           reserve2 (vinto (vremove-members released scratch) (fget state2 :reserve))]
       (kassoc (kassoc state2 :free free2) :reserve reserve2))))

;; A reload in one arm does not satisfy a use in another. Values that already
;; have a slot are dropped from the assignment at every label.
#?(:kotoba
   (defn- drop-backed-assignments [target [:ref :form/r] pool [:ref :form/r] assigned [:ref :form/r] backed [:ref :form/r]] [:ref :form/r]
     (let [ks (mkeys assigned)
           n (form/count-of ks)
           kept (loop [i 0 acc (fmap)]
                  (if (>= i n) acc
                    (let [k (form/nth-of ks i)]
                      (recur (inc i) (if (mhas? backed k) acc (massoc acc k (mget assigned k)))))))
           lists (rebuild-pool-lists target pool kept)]
       (mk3 :assigned kept :free (fget lists :free) :reserve (fget lists :reserve)))))

#?(:kotoba
   (defn- physicalize-call [instruction [:ref :form/r] call-registers [:ref :form/r] return-register [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))
           base (kassoc (kassoc (fmap) :mir/op (fget instruction :mir/op)) :mir/arguments call-registers)
           with-dst (if (= op :mir/tail-call) base (kassoc base :mir/dst return-register))
           with-callee (if (or (= op :mir/call) (= op :mir/tail-call))
                         (kassoc with-dst :mir/callee (fget instruction :mir/callee))
                         with-dst)
           with-runtime (if (= op :mir/runtime-call)
                          (kassoc (kassoc with-callee :mir/runtime (fget instruction :mir/runtime))
                                  :mir/context-offset (fget instruction :mir/context-offset))
                          with-callee)]
       (if (= op :mir/capability-call)
         (kassoc (kassoc (kassoc with-runtime :mir/capability (fget instruction :mir/capability))
                         :mir/kind (fget instruction :mir/kind))
                 :mir/context-offset (fget instruction :mir/context-offset))
         with-runtime))))

;; ---- call-live-slots ----

#?(:kotoba
   (defn- call-indexes-of [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (recur (inc i)
                  (if (call-operation? (kw-of (fget (form/nth-of instructions i) :mir/op)))
                    (vconj acc (fint i))
                    acc)))))))

#?(:kotoba
   (defn- crosses-a-call? [call-indexes [:ref :form/r] definition-index :i64 last-use :i64] :bool
     (let [n (form/count-of call-indexes)]
       (loop [k 0]
         (if (>= k n) false
           (let [c (ival (form/nth-of call-indexes k))]
             (if (and (< definition-index c) (< c last-use)) true (recur (inc k)))))))))

;; A map vreg -> stable slot, for values whose definition precedes a call and
;; whose final use follows it; slots are numbered in definition order.
#?(:kotoba
   (defn- call-live-slots [instructions [:ref :form/r]] [:ref :form/r]
     (let [last-use (last-uses instructions)
           call-indexes (call-indexes-of instructions)
           n (form/count-of instructions)]
       (loop [i 0 slots (fmap)]
         (if (>= i n) slots
           (let [dst (fget (form/nth-of instructions i) :mir/dst)]
             (recur (inc i)
                    (if (and (gmir/vreg? dst)
                             (crosses-a-call? call-indexes i (ival-or (mget last-use dst) -1)))
                      (massoc slots dst (fint (quot (form/count-of slots) 2)))
                      slots))))))))

;; ---- state helpers ----

#?(:kotoba
   (defn- st-failed? [st [:ref :form/r]] :bool (fhas? st :problem)))

#?(:kotoba
   (defn- st-fail [st [:ref :form/r] problem :keyword] [:ref :form/r]
     (kassoc st :problem (kwf problem))))

;; Splice the spill-store in immediately after VALUE was defined.
#?(:kotoba
   (defn- store-at-definition [st [:ref :form/r] value [:ref :form/r] register [:ref :form/r] slot :i64] [:ref :form/r]
     (let [def-position (fget st :def-position)]
       (if (not (mhas? def-position value))
         (st-fail st :spill-required)
         (let [position (ival (mget def-position value))
               out (fget st :out)
               store (instr-spill-store register (fint slot))
               ks (mkeys def-position)
               n (form/count-of ks)
               shifted (loop [i 0 acc (fmap)]
                         (if (>= i n) acc
                           (let [k (form/nth-of ks i)
                                 p (ival (mget def-position k))]
                             (recur (inc i) (massoc acc k (fint (if (>= p position) (inc p) p)))))))]
           (kassoc (kassoc st :out (vinto (vconj (vtake out position) store) (vdrop out position)))
                   :def-position shifted))))))

;; ---------------------------------------------------------------------------
;; Kotoba route: the entry plan and the linear-scan step functions.
;; ---------------------------------------------------------------------------

;; The number of leading :mir/argument instructions.
#?(:kotoba
   (defn- leading-argument-count [instructions [:ref :form/r]] :i64
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (and (< i n) (kw? (fget (form/nth-of instructions i) :mir/op) :mir/argument))
           (recur (inc i))
           i)))))

#?(:kotoba
   (defn- argument-after? [instructions [:ref :form/r] from :i64] :bool
     (let [n (form/count-of instructions)]
       (loop [i from]
         (if (>= i n) false
           (if (kw? (fget (form/nth-of instructions i) :mir/op) :mir/argument) true (recur (inc i))))))))

;; The argument instructions of ARGUMENTS whose value is read later.
#?(:kotoba
   (defn- used-arguments [arguments [:ref :form/r] last-use [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of arguments)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [a (form/nth-of arguments i)]
             (recur (inc i) (if (mhas? last-use (fget a :mir/dst)) (vconj acc a) acc))))))))

#?(:kotoba
   (defn- place-entry-input [state [:ref :form/r] instruction [:ref :form/r] preserved-values [:ref :form/r]] [:ref :form/r]
     (let [value (fget instruction :mir/dst)
           primary (if (member-of? preserved-values value) :preserved :scratch)
           secondary (if (= primary :preserved) :scratch :preserved)
           tier (cond (> (form/count-of (fget state primary)) 0) primary
                      (> (form/count-of (fget state secondary)) 0) secondary
                      :else :none)]
       (if (= tier :none)
         (kassoc state :spill-inputs (vconj (fget state :spill-inputs) instruction))
         (let [register (form/nth-of (fget state tier) 0)]
           (kassoc (kassoc (kassoc state tier (vrest (fget state tier)))
                           :register-inputs (vconj (fget state :register-inputs) (form/vec2 instruction register)))
                   :assigned (massoc (fget state :assigned) value register)))))))

#?(:kotoba
   (defn- place-entry-inputs [used [:ref :form/r] pool [:ref :form/r] scratch-count :i64 preserved-values [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of used)
           initial (kassoc (kassoc (kassoc (kassoc (kassoc (fmap) :scratch (vtake pool scratch-count))
                                                   :preserved (vdrop pool scratch-count))
                                           :register-inputs (fvec))
                                   :spill-inputs (fvec))
                           :assigned (fmap))]
       (loop [i 0 state initial]
         (if (>= i n) state
           (recur (inc i) (place-entry-input state (form/nth-of used i) preserved-values)))))))

;; The slot each spilled entry input is stored to: {:slots map :next-slot int}.
#?(:kotoba
   (defn- entry-spill-slots [spill-inputs [:ref :form/r] slot-base :i64 stable-slots [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of spill-inputs)]
       (loop [i 0 slots (fmap) next-slot slot-base]
         (if (>= i n)
           (mk2 :slots slots :next-slot (fint next-slot))
           (let [value (fget (form/nth-of spill-inputs i) :mir/dst)]
             (if (mhas? stable-slots value)
               (recur (inc i) (massoc slots value (mget stable-slots value)) next-slot)
               (recur (inc i) (massoc slots value (fint next-slot)) (inc next-slot)))))))))

;; Does every argument instruction name a register-passed input?
#?(:kotoba
   (defn- arguments-in-registers? [arguments [:ref :form/r] abi [:ref :form/r]] :bool
     (let [n (form/count-of arguments)]
       (loop [i 0]
         (if (>= i n) true
           (let [idx (fget (form/nth-of arguments i) :mir/index)]
             (if (and (form/is-int? idx) (>= (form/int-value idx) 0) (< (form/int-value idx) (form/count-of abi)))
               (recur (inc i))
               false)))))))

#?(:kotoba
   (defn- abi-register-of [abi [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (form/nth-of abi (ival (fget instruction :mir/index)))))

#?(:kotoba
   (defn- entry-markers [arguments [:ref :form/r] abi [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of arguments)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [a (form/nth-of arguments i)]
             (recur (inc i) (vconj acc (kassoc a :mir/dst (abi-register-of abi a))))))))))

#?(:kotoba
   (defn- entry-stores [spill-inputs [:ref :form/r] abi [:ref :form/r] entry-spills [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of spill-inputs)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [a (form/nth-of spill-inputs i)]
             (recur (inc i)
                    (vconj acc (instr-spill-store (abi-register-of abi a)
                                                  (mget entry-spills (fget a :mir/dst)))))))))))

#?(:kotoba
   (defn- entry-copies [register-inputs [:ref :form/r] abi [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of register-inputs)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [pair (form/nth-of register-inputs i)]
             (recur (inc i)
                    (vconj acc (mk2 :mir/dst (form/nth-of pair 1)
                                    :mir/src (abi-register-of abi (form/nth-of pair 0)))))))))))

;; The assigned register of each argument, in order, as the parameter homes.
#?(:kotoba
   (defn- homes-of [arguments [:ref :form/r] assigned [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of arguments)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (recur (inc i) (vconj acc (mget assigned (fget (form/nth-of arguments i) :mir/dst)))))))))

;; Materialize a function's ABI inputs as canonical self-markers followed by a
;; bounded set of direct entry spills and a parallel copy into allocator
;; registers. Returns the plan map, or {:problem ...}.
#?(:kotoba
   (defn- entry-argument-plan [target [:ref :form/r] pool [:ref :form/r] instructions [:ref :form/r] last-use [:ref :form/r] slot-base :i64 stable-slots [:ref :form/r] preserved-values [:ref :form/r]] [:ref :form/r]
     (let [argument-count (leading-argument-count instructions)
           abi (form/form-get (call-argument-registers) target)
           arguments (vtake instructions argument-count)
           remaining (vdrop instructions argument-count)]
       (cond
         (argument-after? instructions argument-count) (kassoc (fmap) :problem (kwf :spill-required))
         (not (arguments-in-registers? arguments abi)) (kassoc (fmap) :problem (kwf :spill-required))
         :else
         (let [scratch-count (form/count-of (form/form-get (physical-registers) target))
               used (used-arguments arguments last-use)
               placement (place-entry-inputs used pool scratch-count preserved-values)
               assigned (fget placement :assigned)
               spill-inputs (fget placement :spill-inputs)
               spills (entry-spill-slots spill-inputs slot-base stable-slots)
               entry-spills (fget spills :slots)
               next-slot (ival (fget spills :next-slot))
               scheduled (schedule-parallel-copies (entry-copies (fget placement :register-inputs) abi) next-slot)
               instrs (vinto (vinto (entry-markers arguments abi) (entry-stores spill-inputs abi entry-spills))
                             (fget scheduled :instructions))]
           (kassoc
            (kassoc
             (kassoc
              (kassoc
               (kassoc
                (kassoc
                 (kassoc
                  (kassoc
                   (kassoc
                    (kassoc
                     (kassoc
                      (kassoc (fmap) :argument-count (fint argument-count))
                      :remaining remaining)
                     :assigned assigned)
                    :entry-spills entry-spills)
                   :stable-slots (mmerge stable-slots entry-spills))
                  :stable-slot-count (fint next-slot))
                 :temp-slot (fint next-slot))
                :free (fget placement :scratch))
               :reserve (fget placement :preserved))
              :instructions instrs)
             :parameter-homes (if (and (= 0 (form/count-of entry-spills))
                                       (= argument-count (quot (form/count-of assigned) 2)))
                                (homes-of arguments assigned)
                                (form/nil-form)))
            :used-temp? (fget scheduled :used-temp?)))))))

;; ---- step functions (ctx = the per-function constants) ----

;; Spill VALUE's register to its slot (storing at its definition unless it is
;; already backed) and free the register.
#?(:kotoba
   (defn- spill-assigned [st [:ref :form/r] value [:ref :form/r]] [:ref :form/r]
     (let [register (mget (fget st :assigned) value)]
       (if (form/is-nil? register)
         (st-fail st :spill-required)
         (let [existing (mget (fget st :backed) value)
               has-existing (form/is-int? existing)
               slot (if has-existing (form/int-value existing) (ival (fget st :next-slot)))
               next-slot (if has-existing (ival (fget st :next-slot)) (+ 1 (ival (fget st :next-slot))))]
           (if (> next-slot 4095)
             (st-fail st :spill-frame-too-large)
             (let [st1 (kassoc
                        (kassoc
                         (kassoc
                          (kassoc st :backed (massoc (fget st :backed) value (fint slot)))
                          :next-slot (fint next-slot))
                         :assigned (mdissoc (fget st :assigned) value))
                        :free (vconj (fget st :free) register))]
               (if has-existing
                 st1
                 (store-at-definition st1 value register slot)))))))))

;; Take a register from the PREFERRED list (:preserved -> reserve, else free),
;; else from the other, else evict the assigned value with the furthest next
;; use that is not an operand. The register taken is left in :taken.
#?(:kotoba
   (defn- take-register [st [:ref :form/r] ctx [:ref :form/r] protected [:ref :form/r] prefer :keyword] [:ref :form/r]
     (let [primary (if (= prefer :preserved) :reserve :free)
           secondary (if (= prefer :preserved) :free :reserve)
           plist (fget st primary)
           slist (fget st secondary)]
       (cond
         (> (form/count-of plist) 0)
         (kassoc (kassoc st primary (vrest plist)) :taken (form/nth-of plist 0))
         (> (form/count-of slist) 0)
         (kassoc (kassoc st secondary (vrest slist)) :taken (form/nth-of slist 0))
         :else
         (let [victim (furthest-victim (fget st :assigned) (fget ctx :indexes) (ival (fget st :index)) protected)]
           (if (form/is-nil? victim)
             (st-fail st :spill-required)
             (let [register (mget (fget st :assigned) victim)
                   st1 (spill-assigned st victim)]
               (if (st-failed? st1)
                 st1
                 (kassoc (kassoc st1 :free (vrest (fget st1 :free))) :taken register)))))))))

;; Are all ARGUMENTS assigned?
#?(:kotoba
   (defn- all-assigned? [assigned [:ref :form/r] arguments [:ref :form/r]] :bool
     (let [n (form/count-of arguments)]
       (loop [i 0]
         (if (>= i n) true
           (if (mhas? assigned (form/nth-of arguments i)) (recur (inc i)) false))))))

;; The copies moving each assigned argument into its call register.
#?(:kotoba
   (defn- call-copies [assigned [:ref :form/r] arguments [:ref :form/r] call-registers [:ref :form/r]] [:ref :form/r]
     (let [n (if (< (form/count-of arguments) (form/count-of call-registers)) (form/count-of arguments) (form/count-of call-registers))]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [source (mget assigned (form/nth-of arguments i))]
             (recur (inc i)
                    (if (form/is-nil? source) acc
                      (vconj acc (mk2 :mir/dst (form/nth-of call-registers i) :mir/src source))))))))))

;; The slot loads for arguments that are not in a register, or a nil form when
;; one has no slot.
#?(:kotoba
   (defn- call-loads [st [:ref :form/r] arguments [:ref :form/r] call-registers [:ref :form/r]] [:ref :form/r]
     (let [n (if (< (form/count-of arguments) (form/count-of call-registers)) (form/count-of arguments) (form/count-of call-registers))
           assigned (fget st :assigned)
           backed (fget st :backed)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [value (form/nth-of arguments i)]
             (if (mhas? assigned value)
               (recur (inc i) acc)
               (let [slot (mget backed value)]
                 (if (form/is-nil? slot)
                   (form/nil-form)
                   (recur (inc i) (vconj acc (instr-spill-load (form/nth-of call-registers i) slot))))))))))))

;; Spill every live-across value that is not in a preserved register.
#?(:kotoba
   (defn- live-across-values [assigned [:ref :form/r] last-use [:ref :form/r] index :i64] [:ref :form/r]
     (let [ks (mkeys assigned)
           n (form/count-of ks)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [k (form/nth-of ks i)]
             (recur (inc i) (if (> (ival-or (mget last-use k) -1) index) (vconj acc k) acc))))))))

#?(:kotoba
   (defn- spill-live-across [st [:ref :form/r] ctx [:ref :form/r] index :i64] [:ref :form/r]
     (let [live (ordered-vregs (live-across-values (fget st :assigned) (fget ctx :last-use) index))
           m (form/count-of live)]
       (loop [j 0 state st]
         (if (or (>= j m) (st-failed? state)) state
           (let [value (form/nth-of live j)
                 register (mget (fget state :assigned) value)]
             (recur (inc j)
                    (if (member-of? (fget ctx :preserved-set) register)
                      state
                      (spill-assigned state value)))))))))

;; Registers of KEPT-LIKE assigned entries whose register is preserved.
#?(:kotoba
   (defn- keep-preserved [assigned [:ref :form/r] preserved-set [:ref :form/r]] [:ref :form/r]
     (let [ks (mkeys assigned)
           n (form/count-of ks)]
       (loop [i 0 acc (fmap)]
         (if (>= i n) acc
           (let [k (form/nth-of ks i)
                 r (mget assigned k)]
             (recur (inc i) (if (member-of? preserved-set r) (massoc acc k r) acc))))))))

;; The assigned values whose last use is INDEX.
#?(:kotoba
   (defn- values-dying-at [assigned [:ref :form/r] last-use [:ref :form/r] index :i64] [:ref :form/r]
     (let [ks (mkeys assigned)
           n (form/count-of ks)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [k (form/nth-of ks i)]
             (recur (inc i) (if (int-eq? (mget last-use k) index) (vconj acc k) acc))))))))

;; Pin the parallel-copy temporary when SCHEDULED used it for the first time.
#?(:kotoba
   (defn- absorb-scheduled-copies [st [:ref :form/r] scheduled [:ref :form/r] temp-slot :i64] [:ref :form/r]
     (let [sched-used (form/is-true? (fget scheduled :used-temp?))
           st-used (form/is-true? (fget st :used-temp?))
           pinning (and sched-used (not st-used))]
       (kassoc
        (kassoc
         (kassoc
          (kassoc st :out (vinto (fget st :out) (fget scheduled :instructions)))
          :used-temp? (form/bool-form (or st-used sched-used)))
         :next-slot (fint (if pinning (+ 1 (ival (fget st :next-slot))) (ival (fget st :next-slot)))))
        :temp-slot (if sched-used (fint temp-slot) (fget st :temp-slot))))))

#?(:kotoba
   (defn- current-temp-slot [st [:ref :form/r]] :i64
     (let [t (fget st :temp-slot)]
       (if (form/is-nil? t) (ival (fget st :next-slot)) (form/int-value t)))))

;; A self tail call that re-enters through the parameter homes.
#?(:kotoba
   (defn- emit-direct-recur [st [:ref :form/r] ctx [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (let [arguments (fget instruction :mir/arguments)
           homes (fget ctx :parameter-homes)
           n (form/count-of arguments)
           copies (loop [i 0 acc (fvec)]
                    (if (>= i n) acc
                      (recur (inc i)
                             (vconj acc (mk2 :mir/dst (form/nth-of homes i)
                                             :mir/src (mget (fget st :assigned) (form/nth-of arguments i)))))))
           temp-slot (current-temp-slot st)
           scheduled (schedule-parallel-copies copies temp-slot)
           st1 (absorb-scheduled-copies st scheduled temp-slot)]
       (kassoc st1 :out (vconj (fget st1 :out) (mk2 :mir/op (kwf :mir/recur) :mir/arguments homes))))))

;; The state after the call's results are placed: caller-saved assignments are
;; gone, the return register holds DST, and dying values are released.
#?(:kotoba
   (defn- settle-after-call [st [:ref :form/r] ctx [:ref :form/r] index :i64 instruction [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))
           dst (fget instruction :mir/dst)
           return-register (fget ctx :return-register)
           kept0 (keep-preserved (fget st :assigned) (fget ctx :preserved-set))
           kept (if (and (gmir/vreg? dst) (not (= op :mir/tail-call))) (massoc kept0 dst return-register) kept0)
           lists (rebuild-pool-lists (fget ctx :target) (fget ctx :pool) kept)
           st1 (kassoc (kassoc (kassoc st :assigned kept) :free (fget lists :free)) :reserve (fget lists :reserve))
           st2 (if (and (gmir/vreg? dst)
                        (member-of? (fget ctx :crossing) dst)
                        (> (form/count-of (fget st1 :reserve)) 0))
                 (let [preserved (form/nth-of (fget st1 :reserve) 0)]
                   (kassoc
                    (kassoc
                     (kassoc
                      (kassoc st1 :out (vconj (fget st1 :out) (instr-move preserved return-register)))
                      :assigned (massoc (fget st1 :assigned) dst preserved))
                     :reserve (vrest (fget st1 :reserve)))
                    :free (vconj (fget st1 :free) return-register)))
                 st1)
           expired (values-dying-at (fget st2 :assigned) (fget ctx :last-use) index)
           st3 (expire-assigned-in-pool (fget ctx :target) st2 expired)]
       (if (gmir/vreg? dst)
         (kassoc st3 :def-position (massoc (fget st3 :def-position) dst (fint (form/count-of (fget st3 :out)))))
         st3))))

;; An ordinary (non-recur) call: spill what is live across it, marshal the
;; arguments into the ABI registers, emit the call.
#?(:kotoba
   (defn- emit-ordinary-call [st [:ref :form/r] ctx [:ref :form/r] index :i64 instruction [:ref :form/r]] [:ref :form/r]
     (let [arguments (fget instruction :mir/arguments)
           call-registers (vtake (argument-registers-for-call (fget ctx :target) instruction)
                                 (form/count-of arguments))
           st1 (spill-live-across st ctx index)]
       (if (st-failed? st1)
         st1
         (let [copies (call-copies (fget st1 :assigned) arguments call-registers)
               loads (call-loads st1 arguments call-registers)]
           (if (form/is-nil? loads)
             (st-fail st1 :spill-required)
             (let [temp-slot (current-temp-slot st1)
                   scheduled (schedule-parallel-copies copies temp-slot)
                   st2 (absorb-scheduled-copies st1 scheduled temp-slot)
                   st3 (kassoc st2 :out (vconj (vinto (fget st2 :out) loads)
                                               (physicalize-call instruction call-registers (fget ctx :return-register))))]
               (settle-after-call st3 ctx index instruction))))))))

#?(:kotoba
   (defn- emit-call [st [:ref :form/r] ctx [:ref :form/r] index :i64 instruction [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))
           direct-recur? (and (form/is-true? (fget ctx :direct-reentry?))
                              (= op :mir/tail-call)
                              (form/eq (fget ctx :current-function) (fget instruction :mir/callee))
                              (all-assigned? (fget st :assigned) (fget instruction :mir/arguments)))]
       (if direct-recur?
         (emit-direct-recur st ctx instruction)
         (emit-ordinary-call st ctx index instruction)))))

;; ---------------------------------------------------------------------------
;; Kotoba route: the per-instruction step of the linear scan, and the function.
;; ---------------------------------------------------------------------------

#?(:kotoba
   (defn- load-one-source [state [:ref :form/r] ctx [:ref :form/r] source [:ref :form/r] protected [:ref :form/r]] [:ref :form/r]
     (let [slot (mget (fget state :backed) source)]
       (if (form/is-nil? slot)
         (st-fail state :spill-required)
         (let [prefer (if (member-of? (fget ctx :crossing) source) :preserved :scratch)
               taken (take-register state ctx protected prefer)]
           (if (st-failed? taken)
             taken
             (let [register (fget taken :taken)]
               (kassoc (kassoc taken :assigned (massoc (fget taken :assigned) source register))
                       :out (vconj (fget taken :out) (instr-spill-load register slot))))))))))

;; Load each of SRCS that is not in a register from its slot.
#?(:kotoba
   (defn- load-sources [st [:ref :form/r] ctx [:ref :form/r] srcs [:ref :form/r] protected [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of srcs)]
       (loop [i 0 state st]
         (if (or (>= i n) (st-failed? state)) state
           (let [source (form/nth-of srcs i)]
             (recur (inc i)
                    (if (mhas? (fget state :assigned) source)
                      state
                      (load-one-source state ctx source protected)))))))))

;; The register currently holding DESIRED-HOME's value, as the value, or a nil form.
#?(:kotoba
   (defn- owner-of-register [assigned [:ref :form/r] register [:ref :form/r]] [:ref :form/r]
     (let [ks (mkeys assigned)
           n (form/count-of ks)]
       (loop [i 0]
         (if (>= i n) (form/nil-form)
           (let [k (form/nth-of ks i)]
             (if (form/eq (mget assigned k) register) k (recur (inc i)))))))))

;; A definition may overwrite its requested recur home only when the register is
;; free, or when the old value is an operand whose final use is this very
;; instruction.
#?(:kotoba
   (defn- direct-home-for [st [:ref :form/r] ctx [:ref :form/r] index :i64 instruction [:ref :form/r] protected [:ref :form/r] dst [:ref :form/r]] [:ref :form/r]
     (let [desired (mget (fget ctx :recur-home-candidates) dst)]
       (if (form/is-nil? desired)
         (form/nil-form)
         (let [owner (owner-of-register (fget st :assigned) desired)
               recur-use (form/nth-of (mget (fget ctx :indexes) dst) 0)]
           (if (and (schedulable-integer-op? (kw-of (fget instruction :mir/op)))
                    (form/is-int? recur-use)
                    (straight-line-to-recur? (fget ctx :instructions) index (form/int-value recur-use))
                    (or (form/is-nil? owner)
                        (and (member-of? protected owner)
                             (int-eq? (mget (fget ctx :last-use) owner) index))))
             desired
             (form/nil-form)))))))

;; Give DST a register: its requested home, else the first of the preferred list,
;; else the dying left operand's register, else whatever `take-register` yields.
#?(:kotoba
   (defn- allocate-destination [st [:ref :form/r] ctx [:ref :form/r] index :i64 instruction [:ref :form/r] protected [:ref :form/r] dst [:ref :form/r]] [:ref :form/r]
     (if (mhas? (fget st :assigned) dst)
       (st-fail st :multiple-definition)
       (let [prefer (if (member-of? (fget ctx :crossing) dst) :preserved :scratch)
             direct-home (direct-home-for st ctx index instruction protected dst)
             left (fget instruction :mir/left)
             dying-left (if (and (= prefer :scratch)
                                 (gmir/vreg? left)
                                 (int-eq? (mget (fget ctx :last-use) left) index))
                          (mget (fget st :assigned) left)
                          (form/nil-form))
             primary (if (= prefer :preserved) (fget st :reserve) (fget st :free))
             from-primary (if (> (form/count-of primary) 0) (form/nth-of primary 0) (form/nil-form))
             register (cond (not (form/is-nil? direct-home)) direct-home
                            (not (form/is-nil? from-primary)) from-primary
                            :else dying-left)]
         (if (form/is-nil? register)
           (let [taken (take-register st ctx protected prefer)]
             (if (st-failed? taken)
               taken
               (kassoc taken :assigned (massoc (fget taken :assigned) dst (fget taken :taken)))))
           (let [free2 (if (not (form/is-nil? direct-home))
                         (vremove-members (fget st :free) (form/form-vec (form/one-form direct-home)))
                         (if (and (not (form/is-nil? from-primary)) (= prefer :scratch))
                           (vrest (fget st :free))
                           (fget st :free)))
                 reserve2 (if (not (form/is-nil? direct-home))
                            (vremove-members (fget st :reserve) (form/form-vec (form/one-form direct-home)))
                            (if (and (not (form/is-nil? from-primary)) (= prefer :preserved))
                              (vrest (fget st :reserve))
                              (fget st :reserve)))]
             (kassoc (kassoc (kassoc st :free free2) :reserve reserve2)
                     :assigned (massoc (fget st :assigned) dst register))))))))

;; INSTRUCTION with every vreg replaced by its register (vector arguments
;; element-wise) and the lowered merge operations turned back into spills.
#?(:kotoba
   (defn- map-assigned-vector [assigned [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of v)]
       (form/form-vec
        (loop [i 0 acc (form/no-forms)]
          (if (>= i n) acc
            (recur (inc i) (form/append-form acc (mget assigned (form/nth-of v i))))))))))

#?(:kotoba
   (defn- rewrite-registers [instruction [:ref :form/r] assigned [:ref :form/r]] [:ref :form/r]
     (let [kids (form/kids-of instruction)
           n (vector-count kids)]
       (form/form-map
        (loop [j 0 acc (form/no-forms)]
          (if (>= (+ j 1) n) acc
            (let [k (typed-list-nth [:list [:ref :form/r]] kids j)
                  v (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))]
              (recur (+ j 2)
                     (form/append-form
                      (form/append-form acc k)
                      (cond
                        (gmir/vreg? v) (mget assigned v)
                        (and (kw? k :mir/arguments) (form/is-vec? v)) (map-assigned-vector assigned v)
                        :else v))))))))))

#?(:kotoba
   (defn- lowered-merge-back [allocated [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget allocated :mir/op))]
       (cond
         (= op :mir/merge-store)
         (mk3 :mir/op (kwf :mir/spill-store) :mir/src (fget allocated :mir/src) :mir/slot (fget allocated :mir/slot))
         (= op :mir/merge-load)
         (mk3 :mir/op (kwf :mir/spill-load) :mir/dst (fget allocated :mir/dst) :mir/slot (fget allocated :mir/slot))
         :else allocated))))

;; Values to release after this instruction: dying now, or a definition nothing reads.
#?(:kotoba
   (defn- expired-after [assigned [:ref :form/r] last-use [:ref :form/r] index :i64 dst [:ref :form/r]] [:ref :form/r]
     (let [ks (mkeys assigned)
           n (form/count-of ks)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [k (form/nth-of ks i)]
             (recur (inc i)
                    (if (or (int-eq? (mget last-use k) index)
                            (and (form/eq dst k) (not (mhas? last-use k))))
                      (vconj acc k)
                      acc))))))))

;; One non-call instruction: labels reset backed assignments, sources are loaded,
;; the destination gets a register, the instruction is rewritten and dead values
;; are released.
#?(:kotoba
   (defn- step-drop-backed [st [:ref :form/r] ctx [:ref :form/r] index :i64 instruction [:ref :form/r]] [:ref :form/r]
     (if (and (kw? (fget instruction :mir/op) :mir/label)
              (> index 0)
              (let [ks (mkeys (fget st :assigned))
                    n (form/count-of ks)]
                (loop [i 0]
                  (if (>= i n) false
                    (if (mhas? (fget st :backed) (form/nth-of ks i)) true (recur (inc i)))))))
       (let [block (drop-backed-assignments (fget ctx :target) (fget ctx :pool) (fget st :assigned) (fget st :backed))]
         (kassoc (kassoc (kassoc st :assigned (fget block :assigned)) :free (fget block :free)) :reserve (fget block :reserve)))
       st)))

#?(:kotoba
   (defn- step-instruction [st0 [:ref :form/r] ctx [:ref :form/r] index :i64 instruction [:ref :form/r]] [:ref :form/r]
     (let [st1 (step-drop-backed (kassoc st0 :index (fint index)) ctx index instruction)
           srcs (vdistinct (vreg-sources instruction))
           protected (form/form-set (form/kids-of srcs))
           loaded (load-sources st1 ctx srcs protected)]
       (if (st-failed? loaded)
         loaded
         (let [dst (fget instruction :mir/dst)
               with-dst (if (gmir/vreg? dst)
                          (allocate-destination loaded ctx index instruction protected dst)
                          loaded)]
           (if (st-failed? with-dst)
             with-dst
             (let [assigned (fget with-dst :assigned)
                   allocated (lowered-merge-back (rewrite-registers instruction assigned))
                   expired (expired-after assigned (fget ctx :last-use) index dst)
                   out (fget with-dst :out)
                   state2 (if (form/is-true? (fget ctx :calls?))
                            (expire-assigned-in-pool (fget ctx :target) with-dst expired)
                            (expire-assigned with-dst expired))
                   state3 (kassoc state2 :out (vconj out allocated))]
               (if (gmir/vreg? dst)
                 (kassoc state3 :def-position
                         (massoc (fget state3 :def-position) dst (fint (+ 1 (form/count-of out)))))
                 state3))))))))

#?(:kotoba
   (defn- step [st [:ref :form/r] ctx [:ref :form/r] index :i64] [:ref :form/r]
     (let [instruction (form/nth-of (fget ctx :instructions) index)]
       (if (call-operation? (kw-of (fget instruction :mir/op)))
         (emit-call (kassoc st :index (fint index)) ctx index instruction)
         (step-instruction st ctx index instruction)))))

#?(:kotoba
   (defn- run-steps [st [:ref :form/r] ctx [:ref :form/r] from :i64 to :i64] [:ref :form/r]
     (loop [index from state st]
       (if (or (>= index to) (st-failed? state))
         state
         (recur (inc index) (step state ctx index))))))

;; Is there any instruction of OPS-KIND: 0 a call, 1 quotient, 2 control flow,
;; 3 runtime/capability call, 4 a self tail-call of CURRENT.
#?(:kotoba
   (defn- any-mir-op? [instructions [:ref :form/r] kind :i64 current [:ref :form/r]] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) false
           (let [ins (form/nth-of instructions i)
                 op (kw-of (fget ins :mir/op))]
             (if (cond (= kind 0) (call-operation? op)
                       (= kind 1) (or (= op :mir/quotient-constant) (= op :mir/quotient))
                       (= kind 2) (or (= op :mir/label) (= op :mir/branch-zero) (= op :mir/branch-nonzero)
                                      (= op :mir/jump) (= op :mir/phi))
                       (= kind 3) (or (= op :mir/runtime-call) (= op :mir/capability-call))
                       (= kind 4) (and (= op :mir/tail-call) (form/eq current (fget ins :mir/callee)))
                       :else false)
               true
               (recur (inc i)))))))))

#?(:kotoba
   (defn- argument-dsts [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 acc (fset)]
         (if (>= i n) acc
           (let [ins (form/nth-of instructions i)]
             (recur (inc i) (if (kw? (fget ins :mir/op) :mir/argument) (sconj acc (fget ins :mir/dst)) acc))))))))

;; The per-function constants of a linear scan.
#?(:kotoba
   (defn- allocation-context [program [:ref :form/r] current-function [:ref :form/r]] [:ref :form/r]
     (let [instructions (fget program :mir/instructions)
           target (fget program :mir/target)
           last-use (last-uses instructions)
           indexes (use-indexes instructions)
           calls? (any-mir-op? instructions 0 (form/nil-form))
           quotients? (any-mir-op? instructions 1 (form/nil-form))
           straight-line? (not (any-mir-op? instructions 2 (form/nil-form)))
           pool (if (and (kw? target :x86-64) quotients? (not calls?) straight-line?)
                  (x86-quotient-steered-pool true)
                  (allocator-pool target (kassoc (fmap) :leaf? (form/bool-form (not calls?)))))
           crossing (if calls? (form/form-set (form/kids-of (mkeys (call-live-slots instructions)))) (fset))
           self-tail? (and (not (form/is-nil? current-function)) (any-mir-op? instructions 4 current-function))
           host-calls? (any-mir-op? instructions 3 (form/nil-form))
           x86-direct-reentry? (and (kw? target :x86-64) self-tail? (not host-calls?))
           preserved-entry-values (cond (kw? target :aarch64) crossing
                                        x86-direct-reentry? (argument-dsts instructions)
                                        :else (fset))]
       (kassoc
        (kassoc
         (kassoc
          (kassoc
           (kassoc
            (kassoc
             (kassoc
              (kassoc
               (kassoc
                (kassoc
                 (kassoc
                  (kassoc (fmap) :instructions instructions)
                  :target target)
                 :last-use last-use)
                :indexes indexes)
               :calls? (form/bool-form calls?))
              :pool pool)
             :crossing crossing)
            :preserved-set (form/form-get (preserved-registers) target))
           :return-register (form/form-get (return-registers) target))
          :current-function current-function)
         :self-tail? (form/bool-form self-tail?))
        :preserved-entry-values preserved-entry-values))))

;; The state and context once the entry plan has been applied.
#?(:kotoba
   (defn- initial-state [entry [:ref :form/r] direct-reentry? :bool] [:ref :form/r]
     (let [entry-instructions (fget entry :instructions)
           entry-assigned (fget entry :assigned)
           ks (mkeys entry-assigned)
           n (form/count-of ks)
           start (+ (form/count-of entry-instructions) (if direct-reentry? 1 0))
           def-position (loop [i 0 acc (fmap)]
                          (if (>= i n) acc
                            (recur (inc i) (massoc acc (form/nth-of ks i) (fint start)))))
           used-temp? (form/is-true? (fget entry :used-temp?))
           out (if direct-reentry?
                 (vconj entry-instructions (mk2 :mir/op (kwf :mir/reentry) :mir/parameters (fget entry :parameter-homes)))
                 entry-instructions)]
       (kassoc
        (kassoc
         (kassoc
          (kassoc
           (kassoc
            (kassoc
             (kassoc
              (kassoc
               (kassoc (fmap) :assigned entry-assigned)
               :free (fget entry :free))
              :reserve (fget entry :reserve))
             :backed (fget entry :entry-spills))
            :next-slot (fint (+ (ival (fget entry :stable-slot-count)) (if used-temp? 1 0))))
           :out out)
          :used-temp? (form/bool-form used-temp?))
         :temp-slot (if used-temp? (fget entry :temp-slot) (form/nil-form)))
        :def-position def-position))))

#?(:kotoba
   (defn- finish-allocation [program [:ref :form/r] st [:ref :form/r]] [:ref :form/r]
     (let [out0 (fget st :out)
           out (if (> (form/count-of (filter-ops out0 5)) 0) out0 (without-reentry out0))
           built (kassoc
                  (kassoc
                   (kassoc
                    (kassoc
                     (kassoc
                      (kassoc (fmap) :mir/version (fget program :mir/version))
                      :mir/target (fget program :mir/target))
                     :mir/registers (kwf :physical))
                    :mir/frame-slots (fint (+ (ival (fget st :next-slot)) (if (form/is-true? (fget st :used-temp?)) 1 0))))
                   :mir/instructions out)
                  :mir/target (fget program :mir/target))
           p (flat-problem built)]
       (if (= p :ok)
         (kassoc (fmap) :program built)
         (kassoc (fmap) :problem (kwf p))))))

#?(:kotoba
   (defn- without-reentry [out [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of out)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [ins (form/nth-of out i)]
             (recur (inc i) (if (kw? (fget ins :mir/op) :mir/reentry) acc (vconj acc ins)))))))))

;; Linear-scan allocation. The result map has :program, or :problem (the
;; keyword the host would have thrown).
#?(:kotoba
   (defn- allocate-without-spills-result [program [:ref :form/r] merge-slots :i64 current-function [:ref :form/r]] [:ref :form/r]
     (if (not (kw? (fget program :mir/registers) :virtual))
       (kassoc (fmap) :problem (kwf :registers-not-virtual))
       (let [ctx0 (allocation-context program current-function)
             instructions (fget ctx0 :instructions)
             target (fget ctx0 :target)
             entry (entry-argument-plan target (fget ctx0 :pool) instructions (fget ctx0 :last-use)
                                        merge-slots (fmap) (fget ctx0 :preserved-entry-values))]
         (if (fhas? entry :problem)
           (kassoc (fmap) :problem (fget entry :problem))
           (let [parameter-homes (fget entry :parameter-homes)
                 self-tail? (form/is-true? (fget ctx0 :self-tail?))
                 x86-direct? (and (kw? target :x86-64) self-tail?
                                  (not (any-mir-op? instructions 3 (form/nil-form))))
                 direct-reentry? (and self-tail?
                                      (or (kw? target :aarch64) x86-direct?)
                                      (not (form/is-nil? parameter-homes)))
                 candidates (if direct-reentry?
                              (direct-recur-home-candidates instructions current-function parameter-homes (fget ctx0 :indexes))
                              (fmap))
                 ctx (kassoc
                      (kassoc
                       (kassoc ctx0 :direct-reentry? (form/bool-form direct-reentry?))
                       :parameter-homes parameter-homes)
                      :recur-home-candidates candidates)
                 st0 (initial-state entry direct-reentry?)
                 done (run-steps st0 ctx (ival (fget entry :argument-count)) (form/count-of instructions))]
             (if (st-failed? done)
               (kassoc (fmap) :problem (fget done :problem))
               (finish-allocation program done))))))))

;; ---------------------------------------------------------------------------
;; Kotoba route: the conservative all-vreg path, allocation policy, stack
;; arguments and the public allocator.
;; ---------------------------------------------------------------------------

;; ---- SSA order and frame-slot interference ----

;; {:ordered vec-of-defined-vregs} or {:problem ...}.
#?(:kotoba
   (defn- validate-ssa-definition-order [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 defined (fset) ordered (fvec)]
         (if (>= i n)
           (kassoc (fmap) :ordered ordered)
           (let [ins (form/nth-of instructions i)
                 srcs (vreg-sources ins)
                 dst (fget ins :mir/dst)]
             (cond
               (not (all-members? srcs defined)) (kassoc (fmap) :problem (kwf :use-before-definition))
               (and (gmir/vreg? dst) (member-of? defined dst)) (kassoc (fmap) :problem (kwf :multiple-definition))
               (gmir/vreg? dst) (recur (inc i) (sconj defined dst) (vconj ordered dst))
               :else (recur (inc i) defined ordered))))))))

#?(:kotoba
   (defn- all-members? [xs [:ref :form/r] s [:ref :form/r]] :bool
     (let [n (form/count-of xs)]
       (loop [i 0]
         (if (>= i n) true
           (if (member-of? s (form/nth-of xs i)) (recur (inc i)) false))))))

;; Values whose frame contents INSTRUCTION reads.
#?(:kotoba
   (defn- slot-sources [instruction [:ref :form/r]] [:ref :form/r]
     (if (kw? (fget instruction :mir/op) :mir/merge-load)
       (vconj (fvec) (fget instruction :mir/dst))
       (vreg-sources instruction))))

;; The frame value INSTRUCTION defines, or a nil form.
#?(:kotoba
   (defn- slot-definition [instruction [:ref :form/r] merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))]
       (cond
         (= op :mir/merge-store) (mget merge-dst-by-slot (fget instruction :mir/slot))
         (= op :mir/merge-load) (form/nil-form)
         :else (instruction-def instruction)))))

#?(:kotoba
   (defn- slot-block-use-def [instructions [:ref :form/r] blocks [:ref :form/r] merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of blocks)]
       (loop [b 0 acc (fvec)]
         (if (>= b n) acc
           (let [block (form/nth-of blocks b)]
             (recur (inc b)
                    (vconj acc (slot-block-fold instructions (ival (fget block :start)) (ival (fget block :end)) merge-dst-by-slot)))))))))

#?(:kotoba
   (defn- slot-block-fold [instructions [:ref :form/r] start :i64 end :i64 merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (loop [i start uses (fset) defs (fset)]
       (if (> i end)
         (mk2 :uses uses :defs defs)
         (let [ins (form/nth-of instructions i)
               reads (vremove-members (slot-sources ins) defs)
               definition (slot-definition ins merge-dst-by-slot)
               m (form/count-of reads)
               uses2 (loop [j 0 u uses]
                       (if (>= j m) u (recur (inc j) (sconj u (form/nth-of reads j)))))]
           (recur (inc i) uses2 (if (gmir/vreg? definition) (sconj defs definition) defs)))))))

#?(:kotoba
   (defn- slot-liveness [instructions [:ref :form/r] merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (let [blocks (basic-blocks instructions)
           label->block (label-block-indexes instructions blocks)
           successors (block-successors instructions blocks label->block)
           use-def (slot-block-use-def instructions blocks merge-dst-by-slot)
           none (empty-sets (form/count-of blocks))]
       (loop [live-in none live-out none]
         (let [next-out (next-live-out live-in successors)
               next-in (next-live-in use-def next-out)]
           (if (and (form/eq next-in live-in) (form/eq next-out live-out))
             (mk3 :blocks blocks :live-in next-in :live-out next-out)
             (recur next-in next-out)))))))

;; GRAPH with DEFINITION interfering with every value of LIVE (other than itself).
#?(:kotoba
   (defn- add-interference [graph [:ref :form/r] definition [:ref :form/r] live [:ref :form/r]] [:ref :form/r]
     (if (not (gmir/vreg? definition))
       graph
       (let [n (form/count-of live)]
         (loop [i 0 g (if (mhas? graph definition) graph (massoc graph definition (fset)))]
           (if (>= i n) g
             (let [value (form/nth-of live i)]
               (recur (inc i)
                      (if (form/eq value definition)
                        g
                        (massoc (massoc g definition (sconj (mget g definition) value))
                                value (sconj (mget g value) definition)))))))))))

;; LIVE without DEFINITION (when a vreg), plus the values INSTRUCTION reads.
#?(:kotoba
   (defn- live-before [live [:ref :form/r] definition [:ref :form/r] sources [:ref :form/r]] [:ref :form/r]
     (let [base (if (gmir/vreg? definition)
                  (vremove-members live (form/form-vec (form/one-form definition)))
                  live)
           n (form/count-of sources)]
       (loop [i 0 acc (form/form-set (form/kids-of base))]
         (if (>= i n) acc (recur (inc i) (sconj acc (form/nth-of sources i))))))))

#?(:kotoba
   (defn- block-interference [graph [:ref :form/r] instructions [:ref :form/r] start :i64 end :i64 live-out [:ref :form/r] merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (loop [i end g graph live live-out]
       (if (< i start) g
         (let [ins (form/nth-of instructions i)
               definition (slot-definition ins merge-dst-by-slot)
               g2 (add-interference g definition live)
               live2 (live-before live definition (slot-sources ins))]
           (recur (- i 1) g2 live2))))))

#?(:kotoba
   (defn- spill-interference [instructions [:ref :form/r] merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (let [liveness (slot-liveness instructions merge-dst-by-slot)
           blocks (fget liveness :blocks)
           live-out (fget liveness :live-out)
           n (form/count-of blocks)]
       (loop [b 0 graph (fmap)]
         (if (>= b n) graph
           (let [block (form/nth-of blocks b)]
             (recur (inc b)
                    (block-interference graph instructions (ival (fget block :start)) (ival (fget block :end))
                                        (form/nth-of live-out b) merge-dst-by-slot))))))))

;; The smallest slot at or above OFFSET that none of NEIGHBOURS already holds,
;; or -1 when the frame is full.
#?(:kotoba
   (defn- free-slot [slots [:ref :form/r] neighbours [:ref :form/r] offset :i64] :i64
     (let [taken (taken-slots slots neighbours)]
       (loop [s offset]
         (if (>= s 4096) -1
           (if (member-of? taken (fint s)) (recur (inc s)) s))))))

#?(:kotoba
   (defn- taken-slots [slots [:ref :form/r] neighbours [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of neighbours)]
       (loop [i 0 acc (fset)]
         (if (>= i n) acc
           (let [v (form/nth-of neighbours i)]
             (recur (inc i) (if (mhas? slots v) (sconj acc (mget slots v)) acc))))))))

;; {:slots map} or {:problem ...}
#?(:kotoba
   (defn- spill-slots [instructions [:ref :form/r] offset :i64 merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (let [ordered-result (validate-ssa-definition-order instructions)]
       (if (fhas? ordered-result :problem)
         ordered-result
         (let [ordered (fget ordered-result :ordered)
               interference (spill-interference instructions merge-dst-by-slot)
               n (form/count-of ordered)]
           (loop [i 0 slots (fmap)]
             (if (>= i n)
               (kassoc (fmap) :slots slots)
               (let [value (form/nth-of ordered i)
                     slot (free-slot slots (mget interference value) offset)]
                 (if (< slot 0)
                   (kassoc (fmap) :problem (kwf :spill-frame-too-large))
                   (recur (inc i) (massoc slots value (fint slot))))))))))))

;; ---- the conservative expansion ----

;; All of VALUES have a slot.
#?(:kotoba
   (defn- all-slotted? [slots [:ref :form/r] values [:ref :form/r]] :bool
     (let [n (form/count-of values)]
       (loop [i 0]
         (if (>= i n) true
           (if (mhas? slots (form/nth-of values i)) (recur (inc i)) false))))))

#?(:kotoba
   (defn- sp-load [slots [:ref :form/r] value [:ref :form/r] register [:ref :form/r]] [:ref :form/r]
     (instr-spill-load register (mget slots value))))

#?(:kotoba
   (defn- sp-store [slots [:ref :form/r] value [:ref :form/r] register [:ref :form/r]] [:ref :form/r]
     (instr-spill-store register (mget slots value))))

#?(:kotoba
   (defn- ok-expansion [instrs [:ref :form/r]] [:ref :form/r] (kassoc (fmap) :ok instrs)))

#?(:kotoba
   (defn- bad-expansion [problem :keyword] [:ref :form/r] (kassoc (fmap) :problem (kwf problem))))

#?(:kotoba
   (defn- binary-spill-op? [op :keyword] :bool
     (or (arithmetic-op? op)
         (= op :mir/f64-add) (= op :mir/f64-subtract) (= op :mir/f64-multiply) (= op :mir/f64-divide)
         (= op :mir/f64-min) (= op :mir/f64-max))))

#?(:kotoba
   (defn- unary-spill-op? [op :keyword] :bool
     (or (= op :mir/f64-sqrt) (= op :mir/f32-sqrt) (= op :mir/f32-to-f64) (= op :mir/f64-to-f32)
         (= op :mir/i64-to-f32) (= op :mir/i64-to-f64))))

#?(:kotoba
   (defn- load-op-spill? [op :keyword] :bool
     (or (= op :mir/kernel-load-u8) (= op :mir/kernel-load-u16) (= op :mir/kernel-load-u32) (= op :mir/kernel-load-u64)
         (= op :mir/slice-load-u8) (= op :mir/slice-load-u16) (= op :mir/slice-load-u32) (= op :mir/slice-load-u64)
         (= op :mir/kernel-try-lock-u32) (= op :mir/kernel-unlock-u32))))

#?(:kotoba
   (defn- store-op-spill? [op :keyword] :bool
     (or (= op :mir/kernel-store-u8) (= op :mir/kernel-store-u16) (= op :mir/kernel-store-u32) (= op :mir/kernel-store-u64)
         (= op :mir/slice-store-u8) (= op :mir/slice-store-u16) (= op :mir/slice-store-u32) (= op :mir/slice-store-u64))))

#?(:kotoba
   (defn- atomic-rw-spill? [op :keyword] :bool
     (or (= op :mir/kernel-atomic-add-u32) (= op :mir/kernel-atomic-add-u64)
         (= op :mir/kernel-xchg-u32) (= op :mir/kernel-xchg-u64))))

#?(:kotoba
   (defn- cmpxchg-spill? [op :keyword] :bool
     (or (= op :mir/kernel-cmpxchg-u32) (= op :mir/kernel-cmpxchg-u64))))

#?(:kotoba
   (defn- dot-spill? [op :keyword] :bool
     (or (= op :mir/kernel-dot-f32) (= op :mir/kernel-dequant-dot-q8-0)
         (= op :mir/kernel-dequant-dot-q4-k) (= op :mir/kernel-dequant-dot-q6-k))))

;; Loads of the named operand fields of INSTRUCTION into REGISTERS, in order.
#?(:kotoba
   (defn- loads-of-fields [slots [:ref :form/r] instruction [:ref :form/r] fields [:ref :form/r] registers [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of fields)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (recur (inc i)
                  (vconj acc (sp-load slots (fget instruction (kw-of (form/nth-of fields i))) (form/nth-of registers i)))))))))

;; The fields a family loads, as a vector of keyword forms.
#?(:kotoba
   (defn- fields-vec [a :keyword b :keyword c :keyword d :keyword e :keyword] [:ref :form/r]
     (let [v (fvec)
           v1 (if (= a :none) v (vconj v (kwf a)))
           v2 (if (= b :none) v1 (vconj v1 (kwf b)))
           v3 (if (= c :none) v2 (vconj v2 (kwf c)))
           v4 (if (= d :none) v3 (vconj v3 (kwf d)))]
       (if (= e :none) v4 (vconj v4 (kwf e))))))

;; The operand values a family loads.
#?(:kotoba
   (defn- operand-values [instruction [:ref :form/r] fields [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of fields)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (recur (inc i) (vconj acc (fget instruction (kw-of (form/nth-of fields i))))))))))

;; Expansion of an instruction that loads FIELDS into REGISTERS, then runs BODY,
;; then stores its DST from STORE-REG (a nil form: no store).
#?(:kotoba
   (defn- expand-with [slots [:ref :form/r] instruction [:ref :form/r] fields [:ref :form/r] registers [:ref :form/r] body [:ref :form/r] store-reg [:ref :form/r]] [:ref :form/r]
     (let [values (operand-values instruction fields)
           dst (fget instruction :mir/dst)]
       (if (not (and (all-slotted? slots values)
                     (or (form/is-nil? store-reg) (mhas? slots dst))))
         (bad-expansion :use-before-definition)
         (let [loads (loads-of-fields slots instruction fields registers)
               with-body (vconj loads body)]
           (ok-expansion (if (form/is-nil? store-reg)
                           with-body
                           (vconj with-body (sp-store slots dst store-reg)))))))))

;; The instruction map with the given keys, taken from INSTRUCTION's op and
;; maximum, and registers bound to its operand roles.
#?(:kotoba
   (defn- body-of [instruction [:ref :form/r] pairs [:ref :form/r]] [:ref :form/r]
     ;; PAIRS is a vector of [role register] pair vectors; :mir/op is always copied
     (let [n (form/count-of pairs)]
       (loop [i 0 acc (kassoc (fmap) :mir/op (fget instruction :mir/op))]
         (if (>= i n) acc
           (let [pair (form/nth-of pairs i)]
             (recur (inc i) (massoc acc (form/nth-of pair 0) (form/nth-of pair 1)))))))))

#?(:kotoba
   (defn- pr2 [role :keyword register [:ref :form/r]] [:ref :form/r] (form/vec2 (kwf role) register)))

#?(:kotoba
   (defn- with-maximum [body [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (kassoc body :mir/maximum (fget instruction :mir/maximum))))

;; Expand the operation families that share a shape, by register role lists.
#?(:kotoba
   (defn- expand-shaped [slots [:ref :form/r] instruction [:ref :form/r] abi [:ref :form/r] r0 [:ref :form/r] r1 [:ref :form/r] r2 [:ref :form/r] r3 [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))
           c0 (form/nth-of abi 0) c1 (form/nth-of abi 1) c2 (form/nth-of abi 2) c3 (form/nth-of abi 3) c4 (form/nth-of abi 4)]
       (cond
         (binary-spill-op? op)
         (expand-with slots instruction (fields-vec :mir/left :mir/right :none :none :none) (form/vec2 r0 r1)
                      (body-of instruction (vconj (vconj (vconj (fvec) (pr2 :mir/dst r0)) (pr2 :mir/left r0)) (pr2 :mir/right r1)))
                      r0)
         (unary-spill-op? op)
         (expand-with slots instruction (fields-vec :mir/input :none :none :none :none) (vconj (fvec) r0)
                      (body-of instruction (vconj (vconj (fvec) (pr2 :mir/dst r0)) (pr2 :mir/input r0)))
                      r0)
         (load-op-spill? op)
         (expand-with slots instruction (fields-vec :mir/base :mir/length :mir/index :none :none) (vconj (vconj (vconj (fvec) r0) r1) r2)
                      (with-maximum (body-of instruction (vconj (vconj (vconj (vconj (fvec) (pr2 :mir/dst r0)) (pr2 :mir/base r0)) (pr2 :mir/length r1)) (pr2 :mir/index r2))) instruction)
                      r0)
         (store-op-spill? op)
         (expand-with slots instruction (fields-vec :mir/base :mir/length :mir/index :mir/stored :none) (vconj (vconj (vconj (vconj (fvec) r0) r1) r2) r3)
                      (with-maximum (body-of instruction (vconj (vconj (vconj (vconj (vconj (fvec) (pr2 :mir/dst r3)) (pr2 :mir/base r0)) (pr2 :mir/length r1)) (pr2 :mir/index r2)) (pr2 :mir/stored r3))) instruction)
                      r3)
         (atomic-rw-spill? op)
         (expand-with slots instruction (fields-vec :mir/base :mir/length :mir/index :mir/stored :none) (vconj (vconj (vconj (vconj (fvec) r0) r1) r2) r3)
                      (with-maximum (body-of instruction (vconj (vconj (vconj (vconj (vconj (fvec) (pr2 :mir/dst r0)) (pr2 :mir/base r0)) (pr2 :mir/length r1)) (pr2 :mir/index r2)) (pr2 :mir/stored r3))) instruction)
                      r0)
         (cmpxchg-spill? op)
         (expand-with slots instruction (fields-vec :mir/base :mir/length :mir/index :mir/expected :mir/stored) (vconj (vconj (vconj (vconj (vconj (fvec) c0) c1) c2) c3) c4)
                      (with-maximum (body-of instruction (vconj (vconj (vconj (vconj (vconj (vconj (fvec) (pr2 :mir/dst c0)) (pr2 :mir/base c0)) (pr2 :mir/length c1)) (pr2 :mir/index c2)) (pr2 :mir/expected c3)) (pr2 :mir/stored c4))) instruction)
                      c0)
         (dot-spill? op)
         (expand-with slots instruction (fields-vec :mir/base :mir/length :mir/second-base :mir/second-length :mir/count) (vconj (vconj (vconj (vconj (vconj (fvec) c0) c1) c2) c3) c4)
                      (with-maximum (body-of instruction (vconj (vconj (vconj (vconj (vconj (vconj (fvec) (pr2 :mir/dst c0)) (pr2 :mir/base c0)) (pr2 :mir/length c1)) (pr2 :mir/second-base c2)) (pr2 :mir/second-length c3)) (pr2 :mir/count c4))) instruction)
                      c0)
         (= op :mir/kernel-subregion)
         (expand-with slots instruction (fields-vec :mir/base :mir/length :mir/offset :mir/size :none) (vconj (vconj (vconj (vconj (fvec) r0) r1) r2) r3)
                      (body-of instruction (vconj (vconj (vconj (vconj (vconj (fvec) (pr2 :mir/dst r0)) (pr2 :mir/base r0)) (pr2 :mir/length r1)) (pr2 :mir/offset r2)) (pr2 :mir/size r3)))
                      r0)
         :else (bad-expansion :unsupported-spill-operation)))))

#?(:kotoba
   (defn- shaped-op? [op :keyword] :bool
     (or (binary-spill-op? op) (unary-spill-op? op) (load-op-spill? op) (store-op-spill? op)
         (atomic-rw-spill? op) (cmpxchg-spill? op) (dot-spill? op) (= op :mir/kernel-subregion))))

;; Expansion of the call-like operations: arguments loaded into the ABI registers.
#?(:kotoba
   (defn- expand-call-like [slots [:ref :form/r] instruction [:ref :form/r] target [:ref :form/r] r0 [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))
           arguments (fget instruction :mir/arguments)
           n (form/count-of arguments)
           call-registers (cond (= op :mir/tail-call) (prefix-of (form/form-get (call-argument-registers) target) n)
                                (= op :mir/x86-privileged) (prefix-of (privileged-argument-registers target) n)
                                :else (prefix-of (argument-registers-for-call target instruction) n))]
       (if (not (all-slotted? slots arguments))
         (bad-expansion :use-before-definition)
         (let [loads (loads-into-registers slots arguments call-registers)
               dst (fget instruction :mir/dst)
               return-register (form/form-get (return-registers) target)]
           (cond
             (= op :mir/x86-privileged)
             (if (mhas? slots dst)
               (ok-expansion (vconj (vconj loads (kassoc (mk3 :mir/op (fget instruction :mir/op) :mir/dst r0 :mir/action (fget instruction :mir/action)) :mir/arguments call-registers))
                                    (sp-store slots dst r0)))
               (bad-expansion :use-before-definition))
             (= op :mir/tail-call)
             (ok-expansion (vconj loads (mk3 :mir/op (kwf :mir/tail-call) :mir/callee (fget instruction :mir/callee) :mir/arguments call-registers)))
             :else
             (if (mhas? slots dst)
               (ok-expansion (vconj (vconj loads (physicalize-call instruction call-registers return-register))
                                    (sp-store slots dst return-register)))
               (bad-expansion :use-before-definition))))))))

#?(:kotoba
   (defn- loads-into-registers [slots [:ref :form/r] values [:ref :form/r] registers [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of values)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (recur (inc i) (vconj acc (sp-load slots (form/nth-of values i) (form/nth-of registers i)))))))))

;; The expansion of one instruction of the conservative path: {:ok vec} or {:problem}.
#?(:kotoba
   (defn- expand-spill-instruction [slots [:ref :form/r] merge-dst-by-slot [:ref :form/r] target [:ref :form/r] instruction [:ref :form/r]] [:ref :form/r]
     (let [op (kw-of (fget instruction :mir/op))
           phys (form/form-get (physical-registers) target)
           r0 (form/nth-of phys 0) r1 (form/nth-of phys 1) r2 (form/nth-of phys 2) r3 (form/nth-of phys 3)
           abi (form/form-get (call-argument-registers) target)
           dst (fget instruction :mir/dst)]
       (cond
         (= op :mir/argument)
         (let [idx (fget instruction :mir/index)]
           (cond
             (not (and (form/is-int? idx) (>= (form/int-value idx) 0) (< (form/int-value idx) (form/count-of abi))))
             (bad-expansion :argument-index-invalid)
             (not (mhas? slots dst)) (bad-expansion :use-before-definition)
             :else (ok-expansion (vconj (vconj (fvec) (kassoc instruction :mir/dst (form/nth-of abi (form/int-value idx))))
                                        (sp-store slots dst (form/nth-of abi (form/int-value idx)))))))
         (or (= op :mir/constant) (= op :mir/data-address) (= op :mir/rodata-address) (= op :mir/function-address))
         (if (mhas? slots dst)
           (ok-expansion (vconj (vconj (fvec) (kassoc instruction :mir/dst r0)) (sp-store slots dst r0)))
           (bad-expansion :use-before-definition))
         (= op :mir/merge-store)
         (let [phi-dst (mget merge-dst-by-slot (fget instruction :mir/slot))]
           (cond
             (form/is-nil? phi-dst) (bad-expansion :unknown-merge-slot)
             (not (and (mhas? slots (fget instruction :mir/src)) (mhas? slots phi-dst))) (bad-expansion :use-before-definition)
             :else (ok-expansion (vconj (vconj (fvec) (sp-load slots (fget instruction :mir/src) r0))
                                        (sp-store slots phi-dst r0)))))
         (= op :mir/merge-load) (ok-expansion (fvec))
         (= op :mir/quotient-constant)
         (expand-with slots instruction (fields-vec :mir/left :none :none :none :none) (vconj (fvec) r0)
                      (body-of instruction (vconj (vconj (vconj (fvec) (pr2 :mir/dst r0)) (pr2 :mir/left r0))
                                                  (form/vec2 (kwf :mir/divisor) (fget instruction :mir/divisor))))
                      r0)
         (shaped-op? op) (expand-shaped slots instruction abi r0 r1 r2 r3)
         (or (= op :mir/x86-privileged) (= op :mir/tail-call) (= op :mir/call) (= op :mir/runtime-call) (= op :mir/capability-call))
         (expand-call-like slots instruction target r0)
         (or (= op :mir/branch-zero) (= op :mir/branch-nonzero))
         (if (mhas? slots (fget instruction :mir/test))
           (ok-expansion (vconj (vconj (fvec) (sp-load slots (fget instruction :mir/test) r0)) (kassoc instruction :mir/test r0)))
           (bad-expansion :use-before-definition))
         (= op :mir/return)
         (if (mhas? slots (fget instruction :mir/value))
           (ok-expansion (vconj (vconj (fvec) (sp-load slots (fget instruction :mir/value) r0)) (kassoc instruction :mir/value r0)))
           (bad-expansion :use-before-definition))
         (or (= op :mir/label) (= op :mir/jump)) (ok-expansion (vconj (fvec) instruction))
         :else (bad-expansion :unsupported-spill-operation)))))

#?(:kotoba
   (defn- expand-all-spill [slots [:ref :form/r] merge-dst-by-slot [:ref :form/r] target [:ref :form/r] instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 out (fvec)]
         (if (>= i n) (kassoc (fmap) :ok out)
           (let [r (expand-spill-instruction slots merge-dst-by-slot target (form/nth-of instructions i))]
             (if (fhas? r :problem)
               r
               (recur (inc i) (vinto out (fget r :ok))))))))))

;; The highest slot + 1, or 0.
#?(:kotoba
   (defn- slot-count-of [slots [:ref :form/r]] :i64
     (let [vs (mvals slots)
           n (form/count-of vs)]
       (loop [i 0 best -1]
         (if (>= i n) (+ best 1)
           (let [v (ival (form/nth-of vs i))]
             (recur (inc i) (if (> v best) v best))))))))

;; Allocate every value a frame slot and reload around each use: the path for
;; bodies the linear scan cannot fit. {:program p} or {:problem kw}.
#?(:kotoba
   (defn- allocate-with-spills-result [program [:ref :form/r] merge-dst-by-slot [:ref :form/r]] [:ref :form/r]
     (let [instructions (fget program :mir/instructions)
           target (fget program :mir/target)
           sl (spill-slots instructions 0 merge-dst-by-slot)]
       (if (fhas? sl :problem)
         sl
         (let [slots (fget sl :slots)
               slot-count (slot-count-of slots)]
           (if (> slot-count 4095)
             (kassoc (fmap) :problem (kwf :spill-frame-too-large))
             (let [expanded (expand-all-spill slots merge-dst-by-slot target instructions)]
               (if (fhas? expanded :problem)
                 expanded
                 (let [built (kassoc
                              (kassoc
                               (kassoc
                                (kassoc
                                 (kassoc
                                  (kassoc (fmap) :mir/version (fget program :mir/version))
                                  :mir/target target)
                                 :mir/registers (kwf :physical))
                                :mir/frame-slots (fint slot-count))
                               :mir/instructions (fget expanded :ok))
                              :mir/target target)
                       p (flat-problem built)]
                   (if (= p :ok)
                     (kassoc (fmap) :program built)
                     (kassoc (fmap) :problem (kwf p))))))))))))

#?(:kotoba nil :default
(defn- direct-recur-home-candidates
  "Map a self-tail argument SSA value to its exact allocator-owned parameter
  home when that recur is the value's sole use.  A repeated argument is not a
  candidate: one producer cannot define two homes, and the parallel-copy
  scheduler must retain responsibility for duplicating it.  Register
  availability is checked separately at the producer, where interference is
  known."
  [instructions current-function parameter-homes indexes]
  (let [sites (->> instructions
                   (keep-indexed
                    (fn [index {:mir/keys [op callee arguments] :as instruction}]
                      (when (and (= :mir/tail-call op)
                                 (= current-function callee)
                                 (= (count arguments)
                                    (count parameter-homes)))
                        [index instruction])))
                   vec)]
    ;; Multiple recur sites need path-sensitive interference.  This deliberately
    ;; small slice fails closed until the allocator owns that proof.
    (if (= 1 (count sites))
      (let [[index {:mir/keys [arguments]}] (first sites)
            counts (frequencies arguments)]
        (reduce (fn [out [value home]]
                  (if (and (gmir/vreg? value)
                           (= 1 (get counts value))
                           (= [index] (get indexes value)))
                    (assoc out value home)
                    out))
                {}
                (map vector arguments parameter-homes)))
      {}))))

#?(:kotoba nil :default
(def ^:private direct-home-control-boundaries
  #{:mir/label :mir/jump :mir/branch-zero :mir/branch-nonzero
    :mir/return :mir/tail-call :mir/recur :mir/reentry}))

#?(:kotoba nil :default
(defn- straight-line-to-recur?
  "The suffix after a producer reaches its sole recur use without crossing a
  control-flow or call boundary.  Register interference is handled separately;
  this guard keeps the optimization local and fail-closed."
  [instructions producer-index recur-index]
  (every? (fn [instruction]
            (and (not (call-operation? (:mir/op instruction)))
                 (not (contains? direct-home-control-boundaries
                                 (:mir/op instruction)))))
          (subvec instructions (inc producer-index) recur-index))))

#?(:kotoba nil :default
(defn- next-use-of [indexes index value]
  (some (fn [use]
          (when (>= use index) use))
        (get indexes value))))

#?(:kotoba nil :default
(defn- furthest-victim
  "The assigned value with the furthest next use, excluding PROTECTED
  operands. Ties keep the earlier ordered-vregs entry so the choice does
  not depend on hash-map iteration."
  [assigned indexes index protected]
  (let [candidates (filterv (fn [value]
                              (not (contains? protected value)))
                            (ordered-vregs (keys assigned)))]
    (when (seq candidates)
      (reduce (fn [best value]
                (let [best-use (or (next-use-of indexes index best) -1)
                      value-use (or (next-use-of indexes index value) -1)]
                  (if (> value-use best-use) value best)))
              (first candidates)
              (rest candidates))))))

#?(:kotoba nil :default
(defn- expire-assigned
  "Remove VALUES from STATE's assignment without returning a register that is
  still owned by another SSA value (the latter occurs after a dying-left
  destination coalesces onto its source register).

  Freed registers return to the end of the free list, so a register is reused
  only after every other free one has been. That ordering is what the encoders'
  byte-exact expectations were written against, and it is why the pool grows on
  demand instead of being offered whole: handing out a wide pool up front makes
  a body needing three registers touch all of them, reach the preserved tier,
  and pay a save and a restore it never needed."
  [state values]
  (let [expired (vec (ordered-vregs values))
        assigned (:assigned state)
        remaining (apply dissoc assigned expired)
        still-owned (set (vals remaining))
        freed (remove still-owned (map assigned expired))]
    (-> state
        (assoc :assigned remaining)
        (update :free into freed)))))

#?(:kotoba nil :default
(defn- rebuild-pool-lists
  "Re-split POOL into the scratch free list and the reserve (leaf + preserved)
  after a call has clobbered every caller-saved register."
  [target pool assigned]
  (let [owned (set (vals assigned))
        scratch-count (count (get physical-registers target))]
    {:free (vec (remove owned (take scratch-count pool)))
     :reserve (vec (remove owned (drop scratch-count pool)))})))

#?(:kotoba nil :default
(defn- expire-assigned-in-pool
  "Expire VALUES and restore the allocator's scratch/reserve partition.

  `expire-assigned` deliberately knows nothing about target register classes.
  Call-capable allocation must reclassify released preserved registers instead
  of appending them to the scratch list. Previously-used preserved registers go
  to the front of reserve: reusing one costs no additional frame save, while
  consuming a never-used preserved register adds a save/restore pair."
  [target state values]
  (let [assigned (:assigned state)
        remaining (apply dissoc assigned values)
        still-owned (set (vals remaining))
        released (vec (remove still-owned (map assigned (ordered-vregs values))))
        scratch? (set (get physical-registers target))
        state (expire-assigned state values)]
    (-> state
        (update :free (fn [free]
                        (into (vec (remove (set released) free))
                              (filter scratch? released))))
        (update :reserve #(into (vec (remove scratch? released)) %))))))

#?(:kotoba nil :default
(defn- drop-backed-assignments
  "A reload in one arm does not satisfy a use in another. Values that already
  have a slot are dropped from the assignment at every label so the next use
  in this block loads them again. Values that were never spilled stay: their
  definition dominates the split. Callers skip this when nothing assigned is
  backed -- rebuilding the pool lists on a leaf scramble coalescing."
  [target pool assigned backed]
  (let [kept (into {} (remove (fn [[value _]] (contains? backed value)) assigned))
        lists (rebuild-pool-lists target pool kept)]
    {:assigned kept :free (:free lists) :reserve (:reserve lists)})))

#?(:kotoba nil :default
(defn- physicalize-call
  [target instruction call-registers return-register]
  (let [op (:mir/op instruction)]
    (cond-> {:mir/op op :mir/arguments call-registers}
      (not= :mir/tail-call op) (assoc :mir/dst return-register)
      (contains? #{:mir/call :mir/tail-call} op)
      (assoc :mir/callee (:mir/callee instruction))
      (= :mir/runtime-call op)
      (assoc :mir/runtime (:mir/runtime instruction)
             :mir/context-offset (:mir/context-offset instruction))
      (= :mir/capability-call op)
      (assoc :mir/capability (:mir/capability instruction)
             :mir/kind (:mir/kind instruction)
             :mir/context-offset (:mir/context-offset instruction))))))

#?(:kotoba nil :default
(defn- entry-argument-plan
  "Materialize a function's ABI inputs as canonical self-markers followed by a
  bounded set of direct entry spills and a parallel copy into allocator
  registers. Values in PRESERVED-VALUES take the callee-saved tier first so an
  entry argument that crosses a call is not immediately stored and reloaded.
  Unused inputs need only their marker. Inputs beyond the allocator profile are
  backed directly from their ABI registers and loaded lazily."
  [target pool instructions last-use slot-base stable-slots preserved-values]
  (let [[arguments remaining] (split-with #(= :mir/argument (:mir/op %))
                                          instructions)]
    (when (some #(= :mir/argument (:mir/op %)) remaining)
      (reject! :spill-required {:problem :non-prefix-argument}))
    (let [arguments (vec arguments)
          remaining (vec remaining)
          allocator-registers pool
          abi-registers (get call-argument-registers target)
          used (filterv #(contains? last-use (:mir/dst %)) arguments)]
      (let [scratch-count (count (get physical-registers target))
            initial {:scratch (vec (take scratch-count allocator-registers))
                     :preserved (vec (drop scratch-count allocator-registers))
                     :register-inputs [] :spill-inputs [] :assigned {}}
            {:keys [register-inputs spill-inputs assigned] :as placement}
            (reduce
             (fn [state instruction]
               (let [value (:mir/dst instruction)
                     primary (if (contains? preserved-values value)
                               :preserved :scratch)
                     secondary (if (= primary :preserved) :scratch :preserved)
                     tier (cond
                            (seq (get state primary)) primary
                            (seq (get state secondary)) secondary
                            :else nil)]
                 (if tier
                   (let [register (first (get state tier))]
                     (-> state
                         (update tier #(vec (rest %)))
                         (update :register-inputs conj [instruction register])
                         (assoc-in [:assigned value] register)))
                   (update state :spill-inputs conj instruction))))
             initial used)
            input-register (fn [instruction]
                             (or (get abi-registers (:mir/index instruction))
                                 (reject! :spill-required instruction)))
            [entry-spills next-slot]
            (reduce (fn [[slots next-slot] instruction]
                      (let [value (:mir/dst instruction)]
                        (if-let [slot (get stable-slots value)]
                          [(assoc slots value slot) next-slot]
                          [(assoc slots value next-slot) (inc next-slot)])))
                    [{} slot-base]
                    spill-inputs)
            markers (mapv #(assoc % :mir/dst (input-register %)) arguments)
            stores (mapv (fn [instruction]
                           {:mir/op :mir/spill-store
                            :mir/src (input-register instruction)
                            :mir/slot (get entry-spills (:mir/dst instruction))})
                         spill-inputs)
            copies (mapv (fn [[instruction register]]
                           {:mir/dst register
                            :mir/src (input-register instruction)})
                         register-inputs)
            scheduled (schedule-parallel-copies copies next-slot)]
        {:argument-count (count arguments)
         :remaining remaining
         :assigned assigned
         :entry-spills entry-spills
         :stable-slots (merge stable-slots entry-spills)
         :stable-slot-count next-slot
         :temp-slot next-slot
         :free (:scratch placement)
         :reserve (:preserved placement)
         :instructions (into markers (concat stores (:instructions scheduled)))
         :parameter-homes (when (and (empty? entry-spills)
                                     (= (count arguments) (count assigned)))
                            (mapv #(get assigned (:mir/dst %)) arguments))
         :used-temp? (:used-temp? scheduled)})))))

#?(:kotoba nil :default
(defn- call-live-slots
  "Assign stable slots only to SSA values whose definition precedes a call and
  whose final use follows that call. Slots are ordered by definition, so the
  result is deterministic and independent of target register names."
  [instructions]
  (let [last-use (last-uses instructions)
        call-indexes (->> instructions
                          (keep-indexed (fn [index instruction]
                                          (when (call-operation? (:mir/op instruction))
                                            index)))
                          vec)
        definitions (->> instructions
                         (keep-indexed (fn [index instruction]
                                         (when (gmir/vreg? (:mir/dst instruction))
                                           [(:mir/dst instruction) index])))
                         vec)
        crossing (filter (fn [[value definition-index]]
                           (some (fn [call-index]
                                   (< definition-index call-index
                                      (get last-use value -1)))
                                 call-indexes))
                         definitions)]
    (into {} (map-indexed (fn [slot [value _]] [value slot]) crossing)))))

#?(:kotoba nil :default
(defn- store-at-definition
  "Splice the spill-store in immediately after VALUE was defined, rather than
  leaving it where the register ran out.

  This allocator walks one flat instruction list that contains labels and
  branches, so the point of exhaustion can sit inside one arm of a branch while
  the reload lands in the other. A store left there writes a slot on a path that
  was not taken, and the other path reads whatever was in it. A definition
  dominates every use of its value, because the program is in SSA form, so a
  store placed there is executed before any reload of it can be reached.

  Every definition position at or after the splice moves along by one."
  [{:keys [out def-position] :as state} value register slot]
  (let [position (or (get def-position value)
                     (reject! :spill-required
                              {:problem :no-definition-to-store-at :value value}))
        store {:mir/op :mir/spill-store :mir/src register :mir/slot slot}]
    (assoc state
           :out (into (conj (subvec out 0 position) store) (subvec out position))
           :def-position (reduce-kv (fn [positions other other-position]
                                      (assoc positions other
                                             (if (>= other-position position)
                                               (inc other-position)
                                               other-position)))
                                    {} def-position)))))

#?(:kotoba nil :default
(defn- allocate-without-spills
  "Linear-scan allocation. The pool grows on demand; when it is empty the
  live value with the furthest next use is stored, not every SSA value.
  A body that fits never reaches the spill step, so its assignment is
  byte-for-byte what it was.

  A function that contains a call is offered the non-leaf pool (scratch then
  preserved, no leaf-tier caller-saved). Values live across a call prefer the
  preserved tier at their definition so a call does not have to move them.
  Remaining live caller-saved values are stored at their definition -- the
  store dominates every reload, including the arm that does not contain the
  call -- then dropped from the assignment. A reload in one arm does not
  satisfy a use in another: at every label after the entry, backed values
  that are currently assigned leave the assignment so the next use in that
  block loads them again. The call itself uses the ABI registers. Pressure
  that still cannot complete falls out as :spill-required."
  [{:mir/keys [version target registers instructions] :as program} merge-slots
   current-function]
  (when-not (= :virtual registers)
    (reject! :registers-not-virtual program))
  (let [last-use (last-uses instructions)
        indexes (use-indexes instructions)
        calls? (boolean (some #(call-operation? (:mir/op %)) instructions))
        quotients? (boolean (some #(contains? #{:mir/quotient-constant
                                                :mir/quotient}
                                              (:mir/op %))
                                  instructions))
        ;; Straight-line only: `rebuild-pool-lists` splits pools by POSITION
        ;; at label boundaries too (`drop-backed-assignments`), and a
        ;; reordered prefix misclassifies the tiers there -- measured as two
        ;; new variant-sroa failures before this guard existed.
        straight-line? (not-any? #(contains? #{:mir/label :mir/branch-zero
                                               :mir/branch-nonzero :mir/jump
                                               :mir/phi}
                                             (:mir/op %))
                                 instructions)
        pool (if (and (= :x86-64 target) quotients? (not calls?)
                      straight-line?)
               (x86-quotient-steered-pool true)
               (allocator-pool target {:leaf? (not calls?)}))
        crossing (if calls? (set (keys (call-live-slots instructions))) #{})
        preserved-set (set (get preserved-registers target))
        return-register (get return-registers target)
        self-tail? (and current-function
                        (some #(and (= :mir/tail-call (:mir/op %))
                                    (= current-function (:mir/callee %)))
                              instructions))
        host-calls? (boolean
                     (some #(contains? #{:mir/runtime-call
                                         :mir/capability-call}
                                       (:mir/op %))
                           instructions))
        x86-direct-reentry? (and (= :x86-64 target)
                                 self-tail?
                                 (not host-calls?))
        ;; AArch64 already admits every call-crossing entry into its preserved
        ;; tier.  The x86 slice is deliberately narrower: only parameters of a
        ;; self-tail function with no runtime/capability callback. Its direct
        ;; recur edge stays inside the one frame, so every parameter home must
        ;; survive ordinary guest calls in the body. Callback-bearing helpers
        ;; retain the established x86 scratch-and-slot plan that the earlier
        ;; broad change regressed.
        preserved-entry-values
        (if (= :aarch64 target)
          crossing
          (if x86-direct-reentry?
            (into #{}
                  (keep #(when (= :mir/argument (:mir/op %)) (:mir/dst %)))
                  instructions)
            #{}))
        entry (entry-argument-plan target pool instructions last-use
                                   merge-slots {} preserved-entry-values)
        parameter-homes (:parameter-homes entry)
        direct-reentry? (and self-tail?
                             (or (= :aarch64 target) x86-direct-reentry?)
                             parameter-homes)
        recur-home-candidates
        (if direct-reentry?
          (direct-recur-home-candidates instructions current-function
                                        parameter-homes indexes)
          {})]
    (letfn [(spill-assigned [state value instruction]
              (let [register (get-in state [:assigned value])]
                (when-not register
                  (reject! :spill-required instruction))
                (let [existing (get-in state [:backed value])
                      slot (or existing (:next-slot state))
                      next-slot (if existing
                                  (:next-slot state)
                                  (inc (:next-slot state)))]
                  (when (> next-slot 4095)
                    (reject! :spill-frame-too-large {:frame-slots next-slot}))
                  ;; A value already in a slot needs no second store: it never
                  ;; changes, so what was written the first time is still what
                  ;; is there.
                  (cond-> (-> state
                              (assoc-in [:backed value] slot)
                              (assoc :next-slot next-slot)
                              (update :assigned dissoc value)
                              (update :free conj register))
                    (not existing) (store-at-definition value register slot)))))
            (take-register [state instruction protected prefer]
              (let [primary (if (= prefer :preserved) :reserve :free)
                    secondary (if (= prefer :preserved) :free :reserve)
                    from-primary (first (get state primary))]
                (if from-primary
                  [(assoc state primary (vec (rest (get state primary))))
                   from-primary]
                  (let [from-secondary (first (get state secondary))]
                    (if from-secondary
                      [(assoc state secondary (vec (rest (get state secondary))))
                       from-secondary]
                      ;; No second pass with an empty PROTECTED set. Evicting
                      ;; an operand of the instruction being allocated loses it:
                      ;; the source was just loaded and nothing reloads it, and
                      ;; the destination does not exist yet. Rejecting here
                      ;; sends the function to the conservative all-vreg path,
                      ;; which is slower and correct. Unreachable in both
                      ;; suites today -- an instruction would need every
                      ;; register held by its own operands.
                      (if-let [victim (furthest-victim (:assigned state)
                                                       indexes
                                                       (:index state)
                                                       protected)]
                        (let [register (get-in state [:assigned victim])
                              state (spill-assigned state victim instruction)]
                          [(assoc state :free (vec (rest (:free state))))
                           register])
                        (reject! :spill-required instruction)))))))
            (emit-call [state index instruction]
              (let [{:mir/keys [op dst arguments callee]} instruction
                    direct-recur? (and direct-reentry?
                                       (= :mir/tail-call op)
                                       (= current-function callee)
                                       ;; A backed source needs a load. Mixing
                                       ;; those loads with a parallel register
                                       ;; copy can overwrite a still-needed
                                       ;; source, so that site retains the
                                       ;; ordinary ABI tail path.
                                       (every? #(contains? (:assigned state) %)
                                               arguments))]
                (if direct-recur?
                  (let [copies (mapv (fn [value register]
                                       {:mir/dst register
                                        :mir/src (get-in state [:assigned value])})
                                     arguments parameter-homes)
                        temp-slot (or (:temp-slot state) (:next-slot state))
                        scheduled (schedule-parallel-copies copies temp-slot)
                        pinning-temp? (and (:used-temp? scheduled)
                                           (not (:used-temp? state)))]
                    (-> state
                        (update :out into (:instructions scheduled))
                        (update :out conj {:mir/op :mir/recur
                                           :mir/arguments parameter-homes})
                        (assoc :used-temp? (or (:used-temp? state)
                                               (:used-temp? scheduled))
                               :next-slot (cond-> (:next-slot state)
                                            pinning-temp? inc)
                               :temp-slot (if (:used-temp? scheduled)
                                            temp-slot
                                            (:temp-slot state)))))
                  (let [call-registers (subvec (argument-registers-for-call
                                            target instruction)
                                           0 (count arguments))
                    live-across (->> (keys (:assigned state))
                                     (filter #(> (get last-use % -1) index))
                                     ordered-vregs)
                    state (reduce (fn [state value]
                                    (let [register (get-in state [:assigned value])]
                                      (if (contains? preserved-set register)
                                        state
                                        (spill-assigned state value instruction))))
                                  state live-across)
                    copies (->> (map vector arguments call-registers)
                                (keep (fn [[value register]]
                                        (when-let [source (get-in state
                                                                  [:assigned value])]
                                          {:mir/dst register :mir/src source})))
                                vec)
                    loads (->> (map vector arguments call-registers)
                               (keep (fn [[value register]]
                                       (when-not (contains? (:assigned state) value)
                                         (let [slot (get (:backed state) value)]
                                           (when-not slot
                                             (reject! :spill-required instruction))
                                           {:mir/op :mir/spill-load
                                            :mir/dst register
                                            :mir/slot slot}))))
                               vec)
                    temp-slot (or (:temp-slot state) (:next-slot state))
                    scheduled (schedule-parallel-copies copies temp-slot)
                    pinning-temp? (and (:used-temp? scheduled)
                                       (not (:used-temp? state)))
                    state (-> state
                              (update :out into (:instructions scheduled))
                              (update :out into loads)
                              (update :out conj
                                      (physicalize-call target instruction
                                                        call-registers
                                                        return-register))
                              (assoc :used-temp? (or (:used-temp? state)
                                                     (:used-temp? scheduled))
                                     :next-slot (cond-> (:next-slot state)
                                                  pinning-temp? inc)
                                     :temp-slot (if (:used-temp? scheduled)
                                                  temp-slot
                                                  (:temp-slot state))))
                    kept (into {}
                               (filter (fn [[_ register]]
                                         (contains? preserved-set register))
                                       (:assigned state)))
                    kept (if (and (gmir/vreg? dst) (not= :mir/tail-call op))
                           (assoc kept dst return-register)
                           kept)
                    lists (rebuild-pool-lists target pool kept)
                    state (assoc state
                                 :assigned kept
                                 :free (:free lists)
                                 :reserve (:reserve lists))
                    state (if (and (gmir/vreg? dst)
                                   (contains? crossing dst)
                                   (seq (:reserve state)))
                            (let [preserved (first (:reserve state))]
                              (-> state
                                  (update :out conj {:mir/op :mir/move
                                                     :mir/dst preserved
                                                     :mir/src return-register})
                                  (assoc-in [:assigned dst] preserved)
                                  (assoc :reserve (vec (rest (:reserve state))))
                                  (update :free conj return-register)))
                            state)
                    expired (filter #(= index (get last-use %))
                                    (keys (:assigned state)))
                    state (expire-assigned-in-pool target state expired)]
                (if (gmir/vreg? dst)
                  (assoc-in state [:def-position dst] (count (:out state)))
                  state)))))]
      (loop [index (:argument-count entry), remaining (:remaining entry)
             assigned (:assigned entry), free (:free entry)
             reserve (:reserve entry)
             backed (:entry-spills entry)
             next-slot (cond-> (:stable-slot-count entry)
                         (:used-temp? entry) inc)
             out (cond-> (:instructions entry)
                   direct-reentry? (conj {:mir/op :mir/reentry
                                          :mir/parameters parameter-homes}))
             used-temp? (:used-temp? entry)
             ;; A RESERVATION, not a proposal. `entry-argument-plan` names one
             ;; past its own spills, which is only reserved when the entry
             ;; parallel copy actually used it -- `next-slot` was stepped past
             ;; it then. Carried forward unused, it is the slot the body's
             ;; first `spill-assigned` is handed, and the next cycle-breaking
             ;; store lands on a live value. Left nil, `emit-call` derives the
             ;; temporary from the CURRENT `next-slot` and pins it on first
             ;; use, which is what the rest of this loop already assumes.
             ;; Measured 2026-09-02: `hkdf-sha256.kotoba` read its own `ctx`
             ;; back as the literal 92 (aiueos ADR-0136).
             temp-slot (when (:used-temp? entry) (:temp-slot entry))
             ;; Everything the entry plan assigned is in place by the end of its
             ;; own instructions, so that is where a store of one of them goes.
             ;;
             ;; One instruction later when this function has a direct reentry
             ;; edge. `store-at-definition` is allowed to splice a store at a
             ;; definition because, under SSA, a definition dominates every use
             ;; of its value -- but the recur edge REDEFINES the parameter homes
             ;; and jumps back to the `:mir/reentry` marker, which is placed
             ;; after the entry plan. A store left at the entry plan therefore
             ;; runs once, before the loop, while the reloads inside the body
             ;; run every iteration: from the second iteration on they answer
             ;; with the value the parameter had on ENTRY.
             ;;
             ;; Measured 2026-09-02 on `os/aiueos/kotoba/aiueos/sha256.kotoba`
             ;; compiled for x86_64-aiueos-kernel-v1: `round-block` stored its
             ;; loop counter once at the entry plan and reloaded it inside the
             ;; loop to compute `i + 1`, so `i` was 1 on every iteration after
             ;; the first, `(= i 64)` never held, and the object spun until the
             ;; fuel guard trapped with #UD (aiueos ADR-0150).
             ;;
             ;; Placing it after the marker puts the store at the top of the
             ;; loop body, where the parameter home register is correct on the
             ;; entry path AND on every back edge.
             def-position (zipmap (keys (:assigned entry))
                                  (repeat (cond-> (count (:instructions entry))
                                            direct-reentry? inc)))]
        (if-let [instruction (first remaining)]
          (if (call-operation? (:mir/op instruction))
            (let [state (emit-call {:assigned assigned :free free :reserve reserve
                                    :backed backed :next-slot next-slot
                                    :out out :used-temp? used-temp?
                                    :temp-slot temp-slot
                                    :def-position def-position
                                    :index index}
                                   index instruction)]
              (recur (inc index) (next remaining)
                     (:assigned state) (vec (:free state)) (:reserve state)
                     (:backed state) (:next-slot state)
                     (:out state) (:used-temp? state) (:temp-slot state)
                     (:def-position state)))
            (let [drop? (and (= :mir/label (:mir/op instruction))
                             (pos? index)
                             (some #(contains? backed %) (keys assigned)))
                  block (if drop?
                          (drop-backed-assignments target pool assigned backed)
                          {:assigned assigned :free free :reserve reserve})
                  assigned (:assigned block)
                  free (:free block)
                  reserve (:reserve block)
                  srcs (distinct (filter gmir/vreg? (sources instruction)))
                  protected (set srcs)
                  loaded (reduce (fn [state source]
                                   (if (contains? (:assigned state) source)
                                     state
                                     (let [slot (get (:backed state) source)]
                                       (when-not slot
                                         (reject! :spill-required instruction))
                                       (let [prefer (if (contains? crossing source)
                                                      :preserved :scratch)
                                             [state register]
                                             (take-register (assoc state :index index)
                                                            instruction
                                                            protected
                                                            prefer)]
                                         (-> state
                                             (assoc-in [:assigned source] register)
                                             (update :out conj {:mir/op :mir/spill-load
                                                                :mir/dst register
                                                                :mir/slot slot}))))))
                                 {:assigned assigned :free free :reserve reserve
                                  :backed backed :next-slot next-slot
                                  :out out :index index
                                  :def-position def-position}
                                 srcs)
                  assigned (:assigned loaded)
                  free (:free loaded)
                  reserve (:reserve loaded)
                  backed (:backed loaded)
                  next-slot (:next-slot loaded)
                  out (:out loaded)
                  def-position (:def-position loaded)]
              (let [dst (:mir/dst instruction)
                    prefer (if (contains? crossing dst) :preserved :scratch)
                    [assigned free reserve backed next-slot out def-position]
                    (if (gmir/vreg? dst)
                      (do
                        (when (contains? assigned dst)
                          (reject! :multiple-definition instruction))
                        (let [desired-home (get recur-home-candidates dst)
                              recur-use (first (get indexes dst))
                              home-owner (when desired-home
                                           (some (fn [[value register]]
                                                   (when (= desired-home register)
                                                     value))
                                                 assigned))
                              ;; A definition may overwrite its requested home
                              ;; only when the register is free, or when the old
                              ;; value is an operand whose final CFG use is this
                              ;; very instruction.  Physical integer operations
                              ;; read all operands before writing DST, so this
                              ;; preserves simultaneous SSA semantics.  Any
                              ;; interference falls back to ordinary allocation
                              ;; and the proven parallel-copy scheduler.
                              direct-home (when (and desired-home
                                                     (contains?
                                                      schedulable-integer-operations
                                                      (:mir/op instruction))
                                                     (straight-line-to-recur?
                                                      instructions index recur-use)
                                                     (or (nil? home-owner)
                                                         (and (contains? protected
                                                                         home-owner)
                                                              (= index
                                                                 (get last-use
                                                                      home-owner)))))
                                            desired-home)
                              dying-left (when (and (= prefer :scratch)
                                                    (gmir/vreg? (:mir/left instruction))
                                                    (= index (get last-use
                                                                  (:mir/left instruction))))
                                           (get assigned (:mir/left instruction)))
                              from-primary (if (= prefer :preserved)
                                             (first reserve)
                                             (first free))
                              register (or direct-home from-primary dying-left)
                              [state register]
                              (if register
                                [{:assigned assigned
                                  :free (if direct-home
                                          (vec (remove #{direct-home} free))
                                          (if (and from-primary (= prefer :scratch))
                                            (vec (rest free))
                                            free))
                                  :reserve (if direct-home
                                             (vec (remove #{direct-home} reserve))
                                             (if (and from-primary
                                                      (= prefer :preserved))
                                               (vec (rest reserve))
                                               reserve))
                                  :backed backed
                                  :next-slot next-slot :out out :index index
                                  :def-position def-position}
                                 register]
                                (take-register {:assigned assigned :free free
                                                :reserve reserve :backed backed
                                                :def-position def-position
                                                :next-slot next-slot :out out
                                                :index index}
                                               instruction
                                               protected
                                               prefer))]
                          [(assoc (:assigned state) dst register)
                           (:free state) (:reserve state)
                           (:backed state) (:next-slot state) (:out state)
                           (:def-position state)]))
                      [assigned free reserve backed next-slot out def-position])
                    allocated (reduce-kv
                               (fn [result key value]
                                 (assoc result key
                                        (cond
                                          (gmir/vreg? value) (get assigned value)
                                          (and (= key :mir/arguments) (vector? value))
                                          (mapv assigned value)
                                          :else value)))
                               {} instruction)
                    allocated (case (:mir/op allocated)
                                :mir/merge-store
                                {:mir/op :mir/spill-store
                                 :mir/src (:mir/src allocated)
                                 :mir/slot (:mir/slot allocated)}
                                :mir/merge-load
                                {:mir/op :mir/spill-load
                                 :mir/dst (:mir/dst allocated)
                                 :mir/slot (:mir/slot allocated)}
                                allocated)
                    expired (filter #(or (= index (get last-use %))
                                         (and (= dst %)
                                              (not (contains? last-use %))))
                                    (keys assigned))
                    state (if calls?
                            (expire-assigned-in-pool
                             target
                             {:assigned assigned :free free :reserve reserve}
                             expired)
                            (expire-assigned
                             {:assigned assigned :free free}
                             expired))]
                (recur (inc index) (next remaining)
                       (:assigned state) (vec (:free state))
                       (if calls? (:reserve state) reserve)
                       backed next-slot
                       (conj out allocated) used-temp? temp-slot
                       (if (gmir/vreg? dst)
                         (assoc def-position dst (inc (count out)))
                         def-position)))))
          (let [out (if (some #(= :mir/recur (:mir/op %)) out)
                      out
                      (vec (remove #(= :mir/reentry (:mir/op %)) out)))]
            (validate-flat!
             {:mir/version version
              :mir/target target
              :mir/registers :physical
              :mir/frame-slots (+ next-slot
                                  (if used-temp? 1 0))
              :mir/instructions out}))))))))

#?(:kotoba nil :default
(defn- validate-ssa-definition-order [instructions]
  (:ordered
   (reduce (fn [{:keys [defined ordered] :as state}
                {:mir/keys [dst] :as instruction}]
             (doseq [source (filter gmir/vreg? (sources instruction))]
               (when-not (contains? defined source)
                 (reject! :use-before-definition instruction)))
             (if (gmir/vreg? dst)
               (do
                 (when (contains? defined dst)
                   (reject! :multiple-definition instruction))
                 {:defined (conj defined dst) :ordered (conj ordered dst)})
               state))
           {:defined #{} :ordered []}
           instructions))))

#?(:kotoba nil :default
(defn- slot-sources
  "Values whose frame contents are read by INSTRUCTION. A lowered merge-load
  is a slot use: the value was written on each incoming edge, not defined at
  the join."
  [instruction]
  (if (= :mir/merge-load (:mir/op instruction))
    [(:mir/dst instruction)]
    (filter gmir/vreg? (sources instruction)))))

#?(:kotoba nil :default
(defn- slot-definition
  "The frame value defined by INSTRUCTION. A merge-store defines the phi
  destination on its edge; the later merge-load only materializes that slot."
  [instruction merge-dst-by-slot]
  (case (:mir/op instruction)
    :mir/merge-store (get merge-dst-by-slot (:mir/slot instruction))
    :mir/merge-load nil
    (instruction-def instruction))))

#?(:kotoba nil :default
(defn- slot-block-use-def [instructions blocks merge-dst-by-slot]
  (mapv (fn [{:keys [start end]}]
          (reduce (fn [{:keys [uses defs]} index]
                    (let [instruction (nth instructions index)
                          read (remove defs (slot-sources instruction))
                          definition (slot-definition instruction merge-dst-by-slot)]
                      {:uses (into uses read)
                       :defs (cond-> defs (gmir/vreg? definition)
                               (conj definition))}))
                  {:uses #{} :defs #{}}
                  (range start (inc end))))
        blocks)))

#?(:kotoba nil :default
(defn- slot-liveness [instructions merge-dst-by-slot]
  (let [blocks (basic-blocks instructions)
        label->block (label-block-indexes instructions blocks)
        successors (block-successors instructions blocks label->block)
        use-def (slot-block-use-def instructions blocks merge-dst-by-slot)
        block-count (count blocks)
        empty (vec (repeat block-count #{}))]
    (loop [live-in empty live-out empty]
      (let [next-out (mapv (fn [block-index]
                             (reduce into #{}
                                     (map #(nth live-in %)
                                          (nth successors block-index))))
                           (range block-count))
            next-in (mapv (fn [block-index]
                            (let [{:keys [uses defs]} (nth use-def block-index)]
                              (into uses (remove defs (nth next-out block-index)))))
                          (range block-count))]
        (if (and (= next-in live-in) (= next-out live-out))
          {:blocks blocks :live-in next-in :live-out next-out}
          (recur next-in next-out)))))))

#?(:kotoba nil :default
(defn- add-interference [graph definition live]
  (if-not (gmir/vreg? definition)
    graph
    (reduce (fn [out value]
              (if (= definition value)
                out
                (-> out
                    (update definition (fnil conj #{}) value)
                    (update value (fnil conj #{}) definition))))
            (update graph definition (fnil identity #{}))
            live))))

#?(:kotoba nil :default
(defn- spill-interference
  "Build conservative SSA frame-slot interference from fixed-point CFG
  liveness. Mutually exclusive branch values may share a slot; values live
  together at a join or around a back edge may not."
  [instructions merge-dst-by-slot]
  (let [{:keys [blocks live-out]} (slot-liveness instructions merge-dst-by-slot)]
    (reduce
     (fn [graph block-index]
       (let [{:keys [start end]} (nth blocks block-index)]
         (:graph
          (reduce
           (fn [{:keys [graph live]} index]
             (let [instruction (nth instructions index)
                   definition (slot-definition instruction merge-dst-by-slot)
                   graph (add-interference graph definition live)
                   live (into (cond-> live (gmir/vreg? definition)
                               (disj definition))
                              (slot-sources instruction))]
               {:graph graph :live live}))
           {:graph graph :live (nth live-out block-index)}
           (range end (dec start) -1)))))
     {}
     (range (count blocks))))))

#?(:kotoba nil :default
(defn- spill-slots [instructions offset merge-dst-by-slot]
  (let [ordered (validate-ssa-definition-order instructions)
        interference (spill-interference instructions merge-dst-by-slot)]
    (reduce (fn [slots value]
              (let [unavailable (into #{} (keep slots)
                                      (get interference value))
                    slot (first (remove unavailable (range offset 4096)))]
                (when-not slot
                  (reject! :spill-frame-too-large {:frame-slots 4096}))
                (assoc slots value slot)))
            {}
            ordered))))

#?(:kotoba nil :default
(defn- allocate-with-spills
  [{:mir/keys [version target instructions] :as program} merge-dst-by-slot]
  (let [slots (spill-slots instructions 0 merge-dst-by-slot)
        slot-count (if (seq slots) (inc (apply max (vals slots))) 0)
        [r0 r1 r2 r3] (get physical-registers target)
        argument-registers (get call-argument-registers target)]
    (when (> slot-count 4095)
      (reject! :spill-frame-too-large {:frame-slots slot-count}))
    (letfn [(slot-of [instruction value]
              (or (get slots value)
                  (reject! :use-before-definition instruction)))
            (load-value [instruction value register]
              {:mir/op :mir/spill-load :mir/dst register
               :mir/slot (slot-of instruction value)})
            (store-value [instruction value register]
              {:mir/op :mir/spill-store :mir/src register
               :mir/slot (slot-of instruction value)})]
      (validate-flat!
        {:mir/version version
        :mir/target target
        :mir/registers :physical
        :mir/frame-slots slot-count
        :mir/instructions
        (vec
         (mapcat
          (fn [{:mir/keys [op dst input left right test value callee arguments
                           base length index stored offset size maximum]
                :as instruction}]
            (case op
              :mir/argument
              (let [register (or (get argument-registers (:mir/index instruction))
                                 (reject! :argument-index-invalid instruction))]
                [(assoc instruction :mir/dst register)
                 (store-value instruction dst register)])

              :mir/constant
              [(assoc instruction :mir/dst r0)
               (store-value instruction dst r0)]

              :mir/data-address
              [(assoc instruction :mir/dst r0)
               (store-value instruction dst r0)]

              ;; boot-lit: a literal's address reads nothing and writes one
              ;; register, exactly like the managed string address above.
              :mir/rodata-address
              [(assoc instruction :mir/dst r0)
               (store-value instruction dst r0)]

              ;; boot-scratch: a function's address reads nothing either. The
              ;; label it resolves against belongs to the module, which this
              ;; layer never sees; the backend holds the table.
              :mir/function-address
              [(assoc instruction :mir/dst r0)
               (store-value instruction dst r0)]

              :mir/merge-store
              (let [phi-dst (or (get merge-dst-by-slot (:mir/slot instruction))
                                (reject! :unknown-merge-slot instruction))]
                [(load-value instruction (:mir/src instruction) r0)
                 (store-value instruction phi-dst r0)])

              :mir/merge-load
              []

              :mir/quotient-constant
              [(load-value instruction left r0)
               {:mir/op op :mir/dst r0 :mir/left r0
                :mir/divisor (:mir/divisor instruction)}
               (store-value instruction dst r0)]

              (:mir/add :mir/subtract :mir/multiply :mir/quotient
               :mir/bit-and :mir/bit-or :mir/bit-xor
               :mir/shift-left :mir/shift-right-signed :mir/shift-right-unsigned
               :mir/f64-add :mir/f64-subtract :mir/f64-multiply
               :mir/f64-divide :mir/f64-min :mir/f64-max
               :mir/f64-equal :mir/f64-less-than :mir/f64-less-or-equal
               :mir/f64-greater-than :mir/f64-greater-or-equal
               :mir/f64-unordered
               ;; f32: two sources in, one value out, same as the f64 twins.
               :mir/f32-add :mir/f32-subtract :mir/f32-multiply
               :mir/f32-divide :mir/f32-equal :mir/f32-less-than
               :mir/f32-less-or-equal :mir/f32-greater-than
               :mir/f32-greater-or-equal :mir/f32-unordered
               :mir/equal :mir/less-than :mir/greater-than
               :mir/less-or-equal :mir/greater-or-equal)
              [(load-value instruction left r0)
               (load-value instruction right r1)
               {:mir/op op :mir/dst r0 :mir/left r0 :mir/right r1}
               (store-value instruction dst r0)]

              ;; One source in, one value out. The f32 conversions join
              ;; f64-sqrt here rather than getting their own arm: the shape is
              ;; the same and the WIDTH lives entirely in the encoder.
              (:mir/f64-sqrt :mir/f32-sqrt
               :mir/f32-to-f64 :mir/f64-to-f32
               :mir/i64-to-f32 :mir/i64-to-f64)
              [(load-value instruction input r0)
               {:mir/op op :mir/dst r0 :mir/input r0}
               (store-value instruction dst r0)]

              ;; memwidth: u16/u64 and the whole slice family select exactly
              ;; the way u8/u32 already did -- three sources in, one value out.
              (:mir/kernel-load-u8 :mir/kernel-load-u16
               :mir/kernel-load-u32 :mir/kernel-load-u64
               :mir/slice-load-u8 :mir/slice-load-u16
               :mir/slice-load-u32 :mir/slice-load-u64
               :mir/kernel-try-lock-u32 :mir/kernel-unlock-u32)
              [(load-value instruction base r0)
               (load-value instruction length r1)
               (load-value instruction index r2)
               {:mir/op op :mir/dst r0 :mir/base r0 :mir/length r1
                :mir/index r2 :mir/maximum maximum}
               (store-value instruction dst r0)]

              (:mir/kernel-store-u8 :mir/kernel-store-u16
               :mir/kernel-store-u32 :mir/kernel-store-u64
               :mir/slice-store-u8 :mir/slice-store-u16
               :mir/slice-store-u32 :mir/slice-store-u64)
              [(load-value instruction base r0)
               (load-value instruction length r1)
               (load-value instruction index r2)
               (load-value instruction stored r3)
               {:mir/op op :mir/dst r3 :mir/base r0 :mir/length r1
                :mir/index r2 :mir/stored r3 :mir/maximum maximum}
               (store-value instruction dst r3)]

              ;; sysops: the add and swap forms take the store's four operands
              ;; and produce a fifth value, so they fit the scratch tier the
              ;; same way -- `dst` aliases `base`, which the encoder's bounds
              ;; check has already consumed by the time the result is written.
              (:mir/kernel-atomic-add-u32 :mir/kernel-atomic-add-u64
               :mir/kernel-xchg-u32 :mir/kernel-xchg-u64)
              [(load-value instruction base r0)
               (load-value instruction length r1)
               (load-value instruction index r2)
               (load-value instruction stored r3)
               {:mir/op op :mir/dst r0 :mir/base r0 :mir/length r1
                :mir/index r2 :mir/stored r3 :mir/maximum maximum}
               (store-value instruction dst r0)]

              ;; The compare-exchanges need FIVE registers live at once, one
              ;; more than the scratch tier holds. They borrow the call
              ;; argument tier, which `physical-register?` already admits and
              ;; which this same function already hands to a five-argument
              ;; call. Nothing lives across the instruction: every operand is
              ;; loaded from its slot immediately before and dead immediately
              ;; after, so borrowing the tier cannot collide with a call's own
              ;; use of it.
              ;;
              ;; On x86-64 that tier is rdi/rsi/rdx/rcx/r8 and deliberately
              ;; excludes RAX, which `lock cmpxchg` fixes as its comparand
              ;; register and which the encoder saves and restores anyway.
              (:mir/kernel-cmpxchg-u32 :mir/kernel-cmpxchg-u64)
              (let [[c0 c1 c2 c3 c4] (get call-argument-registers target)]
                [(load-value instruction base c0)
                 (load-value instruction length c1)
                 (load-value instruction index c2)
                 (load-value instruction (:mir/expected instruction) c3)
                 (load-value instruction stored c4)
                 {:mir/op op :mir/dst c0 :mir/base c0 :mir/length c1
                  :mir/index c2 :mir/expected c3 :mir/stored c4
                  :mir/maximum maximum}
                 (store-value instruction dst c0)])
              ;; sysops: end

              ;; simd: FIVE registers live at once -- two bases, two lengths
              ;; and a count -- one more than the scratch tier holds, so it
              ;; borrows the call-argument tier exactly as the compare-
              ;; exchanges above do, and for the same reason: nothing lives
              ;; across the instruction, because every operand is loaded from
              ;; its slot immediately before and dead immediately after.
              ;;
              ;; The encoder pushes and pops everything else it touches
              ;; (RAX/RCX/RDX around the feature-detection `cpuid` calls, RBX
              ;; around the whole sequence), so borrowing this tier cannot
              ;; collide with a call's own use of it.
              ;; dequant: the fused family borrows the same tier for the
              ;; same reason -- five operands, none of them live across the
              ;; instruction.
              (:mir/kernel-dot-f32
               :mir/kernel-dequant-dot-q8-0
               :mir/kernel-dequant-dot-q4-k
               :mir/kernel-dequant-dot-q6-k)
              (let [[c0 c1 c2 c3 c4] (get call-argument-registers target)]
                [(load-value instruction base c0)
                 (load-value instruction length c1)
                 (load-value instruction (:mir/second-base instruction) c2)
                 (load-value instruction (:mir/second-length instruction) c3)
                 (load-value instruction (:mir/count instruction) c4)
                 {:mir/op op :mir/dst c0 :mir/base c0 :mir/length c1
                  :mir/second-base c2 :mir/second-length c3 :mir/count c4
                  :mir/maximum maximum}
                 (store-value instruction dst c0)])
              ;; simd: end

              :mir/kernel-subregion
              [(load-value instruction base r0)
               (load-value instruction length r1)
               (load-value instruction offset r2)
               (load-value instruction size r3)
               {:mir/op op :mir/dst r0 :mir/base r0 :mir/length r1
                :mir/offset r2 :mir/size r3}
               (store-value instruction dst r0)]

              :mir/x86-privileged
              ;; boot: the whole scratch tier, not the first two of it. The
              ;; vector was `[r0 r1]` while no action took more than two
              ;; arguments, so `:uefi-call2`'s four would have thrown out of
              ;; `subvec` rather than allocating. The tier is exactly four
              ;; registers wide on both targets, which is also why
              ;; `:uefi-call2` takes four operands and not five.
              ;;
              ;; boot-lit: and then `:uefi-call6` took eight. The tier did not
              ;; get wider -- the PRESERVED tier follows it, and every
              ;; register in that tier is callee-saved under Microsoft x64
              ;; (RBX, RBP, RDI, RSI, R12-R15) as well as under the internal
              ;; ABI, so an argument parked there survives the firmware call
              ;; it is an argument to. The scratch tier comes first so an
              ;; action narrow enough to stay inside it still costs no frame
              ;; save; `mir/saved-registers` derives the saves from the
              ;; emitted stream, so naming a preserved register here is what
              ;; makes the frame save it.
              (let [argument-registers
                    (subvec (privileged-argument-registers target)
                            0 (count arguments))]
                (concat
                 (mapv (fn [value register]
                         (load-value instruction value register))
                       arguments argument-registers)
                 [{:mir/op op :mir/dst r0 :mir/action (:mir/action instruction)
                   :mir/arguments argument-registers}
                  (store-value instruction dst r0)]))

              (:mir/branch-zero :mir/branch-nonzero)
              [(load-value instruction test r0)
               (assoc instruction :mir/test r0)]

              :mir/tail-call
              (let [call-registers (subvec (get call-argument-registers target)
                                           0 (count arguments))]
                (concat
                 (mapv (fn [argument register]
                         (load-value instruction argument register))
                       arguments call-registers)
                 [{:mir/op :mir/tail-call :mir/callee callee
                   :mir/arguments call-registers}]))

              (:mir/call :mir/runtime-call :mir/capability-call)
              (let [call-registers (subvec (argument-registers-for-call target instruction)
                                           0 (count arguments))]
                (concat
                 (mapv (fn [value register]
                         (load-value instruction value register))
                       arguments call-registers)
                 [(cond-> {:mir/op op
                           :mir/dst (get return-registers target)
                           :mir/arguments call-registers}
                    (= :mir/call op) (assoc :mir/callee callee)
                    (= :mir/runtime-call op)
                    (assoc :mir/runtime (:mir/runtime instruction)
                           :mir/context-offset (:mir/context-offset instruction))
                    (= :mir/capability-call op)
                    (assoc :mir/capability (:mir/capability instruction)
                           :mir/kind (:mir/kind instruction)
                           :mir/context-offset (:mir/context-offset instruction)))
                  (store-value instruction dst (get return-registers target))]))

              :mir/return
              [(load-value instruction value r0)
               (assoc instruction :mir/value r0)]

              (:mir/label :mir/jump) [instruction]
              (reject! :unsupported-spill-operation instruction)))
          instructions))})))))

#?(:kotoba nil :default
(defn- back-edge?
  "Does any jump or branch in INSTRUCTIONS target a label at or before it?

  ADR 0012 routes functions with control flow to the linear scanner,
  including those with a back edge. This predicate is not a routing guard.
  Leftover pressure still falls back to all-vreg via `:spill-required`."
  [instructions]
  (let [label-index (reduce-kv (fn [indexes index instruction]
                                 (if (= :mir/label (:mir/op instruction))
                                   (assoc indexes (:mir/id instruction) index)
                                   indexes))
                               {} instructions)]
    (boolean
     (some (fn [[index instruction]]
             (and (contains? #{:mir/jump :mir/branch-zero
                               :mir/branch-nonzero} (:mir/op instruction))
                  (when-let [target (get label-index (:mir/target instruction))]
                    (<= target index))))
           (map-indexed vector instructions))))))

#?(:kotoba nil :default
(defn- allocate-with-policy
  "Try the linear scanner, including call-clobber handling. A function that
  still cannot complete falls back to the conservative all-vreg path. Returns
  [allocated-program frame-policy].

  Call plus a backward jump uses the scanner (`:call-live`) when it
  completes. After `lower-phis`, latch last-uses sit after their defs, so a
  prefix-argument terminating call+loop is not `:spill-required`. Iteration
  23's empty set was `:non-prefix-argument` (label before `:mir/argument`).
  Iteration 27: the full amu suite with `back-edge?` false failed only the
  production all-vreg policy asserts. `last-uses` is CFG-backed."
  [program]
  (let [current-function (::current-function (meta program))]
    (validate-flat! program)
    (let [{:keys [program merge-slots merge-dst-by-slot]} (lower-phis program)
        calls? (boolean (some #(call-operation? (:mir/op %))
                              (:mir/instructions program)))]
      (let [schedule-allocated
            (fn [allocated]
              (schedule-program allocated))]
        (try
          (let [allocated (schedule-allocated
                           (coalesce-phi-transports
                            (allocate-without-spills program merge-slots
                                                     current-function)
                            merge-slots))]
            [allocated (if calls? :call-live :allocator)])
          (catch #?(:clj clojure.lang.ExceptionInfo :cljs js/Error) error
            (if (= :spill-required (:problem (ex-data error)))
              [(schedule-allocated
                (allocate-with-spills program merge-dst-by-slot))
               (if calls? :all-vregs :allocator)]
              (throw error)))))))))

;; ── stack-passed arguments ──────────────────────────────────────────────────
;;
;; Rewrites a virtual function so that nothing downstream of it has to know an
;; argument can live anywhere but a register:
;;
;;   :mir/argument, index i >= 5    -> :mir/incoming-load i
;;   :mir/call with n > 5 arguments -> :mir/outgoing-argument for 5..n-1,
;;                                     then the call with the first five
;;   :mir/tail-call, n > 5          -> :mir/incoming-argument-store for
;;                                     5..n-1, then the tail call
;;
;; The loads are placed right after the argument prefix, where the entry plan
;; ends -- and after a direct-reentry marker, so a self-tail loop reloads them
;; from the incoming area its own tail call just rewrote. The stores sit
;; immediately before their call, after every argument value is computed,
;; so nothing between them can reach the stack area they write.
;;
;; A function with no stack arguments comes back unchanged, and its
;; allocation is byte-for-byte what it was.

#?(:kotoba nil :default
(defn- stack-argument-rewrite [instructions target]
  (let [limit (count (get call-argument-registers target))
        stack? (fn [{:mir/keys [op index arguments]}]
                 (or (and (= :mir/argument op) (>= index limit))
                     (and (contains? #{:mir/call :mir/tail-call} op)
                          (> (count arguments) limit))))]
    (if-not (some stack? instructions)
      instructions
      (let [[arguments body] (split-with #(= :mir/argument (:mir/op %)) instructions)
            register-arguments (filterv #(< (:mir/index %) limit) arguments)
            loads (->> arguments
                       (filter #(>= (:mir/index %) limit))
                       (mapv (fn [{:mir/keys [dst index]}]
                               {:mir/op :mir/incoming-load :mir/dst dst
                                :mir/index index})))
            calls (mapcat
                   (fn [{:mir/keys [op arguments] :as instruction}]
                     (if (and (contains? #{:mir/call :mir/tail-call} op)
                              (> (count arguments) limit))
                       (let [store (if (= op :mir/call)
                                     :mir/outgoing-argument
                                     :mir/incoming-argument-store)]
                         (conj (vec (map-indexed
                                     (fn [k value]
                                       {:mir/op store :mir/src value
                                        :mir/index (+ limit k)})
                                     (drop limit arguments)))
                               (assoc instruction :mir/arguments
                                      (subvec arguments 0 limit))))
                       [instruction]))
                   body)]
        (vec (concat register-arguments loads calls)))))))

#?(:kotoba nil :default
(defn- allocate-flat
  "Allocate virtual MIR deterministically. No-call bodies spill only values
  that do not fit. Call-containing bodies use the same scanner, keeping
  live-across values in the preserved tier; leftover pressure still takes
  the conservative all-vreg path."
  [program]
  (first (allocate-with-policy program))))

#?(:kotoba nil :default
(defn allocate-registers
  "Allocate a legacy flat program or every function in a v3 module. A function
  containing a straight-line call stores only values live across that call and
  reloads them lazily. A function that also has control flow uses the linear
  scanner: live-across values prefer preserved registers, and remaining
  caller-saved values are stored at their definition. Entry arguments beyond
  the four-register allocator profile use bounded direct ABI spills. Leftover
  pressure that the linear allocator cannot complete still takes the
  conservative all-vreg path. Pure integer scheduling runs after allocation on
  physical MIR, one basic block at a time."
  [{:mir/keys [version target registers entry functions] :as program}]
  (validate! program)
  (if (= 3 version)
    (do
      (when-not (= :virtual registers)
        (reject! :registers-not-virtual program))
      (validate!
       {:mir/version 3
        :mir/target target
        :mir/registers :physical
        :mir/entry entry
        :mir/functions
        (mapv (fn [{:mir/keys [name arity instructions]}]
                (let [virtual {:mir/version 3 :mir/target target
                               :mir/registers :virtual
                               :mir/instructions (stack-argument-rewrite
                                                  instructions target)}
                      ;; Straight-line call functions previously took
                      ;; allocate-call-live first, which routes every
                      ;; call-crossing value through a stable slot. The
                      ;; linear scanner keeps preserved-register assignments
                      ;; alive across calls and moves a call-crossing call
                      ;; result into the preserved tier -- measured on the
                      ;; qualified call fixture as +6.7% over the slot shape
                      ;; (amu docs/codegen-coscientist.md, iteration 20-21).
                      ;; The scanner already carries its own conservative
                      ;; all-vreg fallback.
                      [allocated frame-policy]
                      (allocate-with-policy
                       (vary-meta virtual assoc ::current-function name))]
                  {:mir/name name
                   :mir/arity arity
                   :mir/frame-slots (:mir/frame-slots allocated)
                   :mir/frame-policy frame-policy
                   :mir/instructions (:mir/instructions allocated)}))
              functions)}))
    (allocate-flat program))))

;; ---------------------------------------------------------------------------
;; Kotoba route: allocation policy, stack-passed arguments, the public
;; allocator and the counted-self-recur analysis.
;; ---------------------------------------------------------------------------

;; ---- stack-passed arguments ----

#?(:kotoba
   (defn- stack-instruction? [instruction [:ref :form/r] limit :i64] :bool
     (let [op (kw-of (fget instruction :mir/op))]
       (or (and (= op :mir/argument) (>= (ival (fget instruction :mir/index)) limit))
           (and (or (= op :mir/call) (= op :mir/tail-call))
                (> (form/count-of (fget instruction :mir/arguments)) limit))))))

#?(:kotoba
   (defn- any-stack-instruction? [instructions [:ref :form/r] limit :i64] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) false
           (if (stack-instruction? (form/nth-of instructions i) limit) true (recur (inc i))))))))

;; The stores for call arguments past LIMIT, then the call with its first LIMIT.
#?(:kotoba
   (defn- stack-call-expansion [instruction [:ref :form/r] limit :i64] [:ref :form/r]
     (let [arguments (fget instruction :mir/arguments)
           op (kw-of (fget instruction :mir/op))
           store-op (if (= op :mir/call) :mir/outgoing-argument :mir/incoming-argument-store)
           n (form/count-of arguments)
           stores (loop [k limit acc (fvec)]
                    (if (>= k n) acc
                      (recur (inc k)
                             (vconj acc (mk3 :mir/op (kwf store-op) :mir/src (form/nth-of arguments k) :mir/index (fint k))))))]
       (vconj stores (kassoc instruction :mir/arguments (vtake arguments limit))))))

#?(:kotoba
   (defn- rewrite-stack-body [body [:ref :form/r] limit :i64] [:ref :form/r]
     (let [n (form/count-of body)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [ins (form/nth-of body i)
                 op (kw-of (fget ins :mir/op))]
             (recur (inc i)
                    (if (and (or (= op :mir/call) (= op :mir/tail-call))
                             (> (form/count-of (fget ins :mir/arguments)) limit))
                      (vinto acc (stack-call-expansion ins limit))
                      (vconj acc ins)))))))))

#?(:kotoba
   (defn- split-register-arguments [arguments [:ref :form/r] limit :i64] [:ref :form/r]
     ;; {:registers arguments below LIMIT, :loads incoming-loads for the rest}
     (let [n (form/count-of arguments)]
       (loop [i 0 regs (fvec) loads (fvec)]
         (if (>= i n) (mk2 :registers regs :loads loads)
           (let [a (form/nth-of arguments i)]
             (if (< (ival (fget a :mir/index)) limit)
               (recur (inc i) (vconj regs a) loads)
               (recur (inc i) regs
                      (vconj loads (mk3 :mir/op (kwf :mir/incoming-load) :mir/dst (fget a :mir/dst) :mir/index (fget a :mir/index)))))))))))

#?(:kotoba
   (defn- stack-argument-rewrite [instructions [:ref :form/r] target [:ref :form/r]] [:ref :form/r]
     (let [limit (call-register-count (kw-of target))]
       (if (not (any-stack-instruction? instructions limit))
         instructions
         (let [lead (leading-argument-count instructions)
               arguments (vtake instructions lead)
               body (vdrop instructions lead)
               split (split-register-arguments arguments limit)]
           (vinto (vinto (fget split :registers) (fget split :loads))
                  (rewrite-stack-body body limit)))))))

;; ---- policy ----

;; {:program p, :policy kw} or {:problem kw}.
#?(:kotoba
   (defn- allocate-with-policy-result [program [:ref :form/r] current-function [:ref :form/r]] [:ref :form/r]
     (let [flat (flat-problem program)]
       (if (not (= flat :ok))
         (kassoc (fmap) :problem (kwf flat))
         (let [lowered (lower-phis program)
               lprogram (fget lowered :program)
               merge-slots (ival (fget lowered :merge-slots))
               calls? (any-mir-op? (fget lprogram :mir/instructions) 0 (form/nil-form))
               r (allocate-without-spills-result lprogram merge-slots current-function)]
           (cond
             (fhas? r :program)
             (let [coalesced (coalesce-phi-transports (fget r :program) merge-slots)]
               (if (fhas? coalesced :problem)
                 coalesced
                 (mk2 :program (schedule-program (fget coalesced :program))
                      :policy (kwf (if calls? :call-live :allocator)))))
             (kw? (fget r :problem) :spill-required)
             (let [s (allocate-with-spills-result lprogram (fget lowered :merge-dst-by-slot))]
               (if (fhas? s :problem)
                 s
                 (mk2 :program (schedule-program (fget s :program))
                      :policy (kwf (if calls? :all-vregs :allocator)))))
             :else r))))))

;; ---- the public allocator ----

#?(:kotoba
   (defn- allocate-function [target [:ref :form/r] function [:ref :form/r]] [:ref :form/r]
     (let [virtual (kassoc
                    (kassoc
                     (kassoc
                      (kassoc (fmap) :mir/version (fint 3))
                      :mir/target target)
                     :mir/registers (kwf :virtual))
                    :mir/instructions (stack-argument-rewrite (fget function :mir/instructions) target))
           r (allocate-with-policy-result virtual (fget function :mir/name))]
       (if (fhas? r :problem)
         r
         (let [allocated (fget r :program)]
           (kassoc (fmap) :function
                   (kassoc
                    (kassoc
                     (kassoc
                      (kassoc
                       (kassoc (fmap) :mir/name (fget function :mir/name))
                       :mir/arity (fget function :mir/arity))
                      :mir/frame-slots (fget allocated :mir/frame-slots))
                     :mir/frame-policy (fget r :policy))
                    :mir/instructions (fget allocated :mir/instructions))))))))

#?(:kotoba
   (defn- allocate-functions [target [:ref :form/r] functions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of functions)]
       (loop [i 0 out (fvec)]
         (if (>= i n) (kassoc (fmap) :functions out)
           (let [r (allocate-function target (form/nth-of functions i))]
             (if (fhas? r :problem)
               r
               (recur (inc i) (vconj out (fget r :function))))))))))

;; The allocated program, or {:problem kw}: result map with :program or :problem.
#?(:kotoba
   (defn allocate-registers-result [program [:ref :form/r]] [:ref :form/r]
     (let [p (validate-problem program)]
       (cond
         (not (= p :ok)) (kassoc (fmap) :problem (kwf p))
         (int-eq? (fget program :mir/version) 3)
         (if (not (kw? (fget program :mir/registers) :virtual))
           (kassoc (fmap) :problem (kwf :registers-not-virtual))
           (let [target (fget program :mir/target)
                 fs (allocate-functions target (fget program :mir/functions))]
             (if (fhas? fs :problem)
               fs
               (let [built (kassoc
                            (kassoc
                             (kassoc
                              (kassoc
                               (kassoc (fmap) :mir/version (fint 3))
                               :mir/target target)
                              :mir/registers (kwf :physical))
                             :mir/entry (fget program :mir/entry))
                            :mir/functions (fget fs :functions))
                     q (validate-problem built)]
                 (if (= q :ok)
                   (kassoc (fmap) :program built)
                   (kassoc (fmap) :problem (kwf q)))))))
         :else
         (let [r (allocate-with-policy-result program (form/nil-form))]
           (if (fhas? r :problem)
             r
             (kassoc (fmap) :program (fget r :program))))))))

#?(:kotoba
   (defn allocate-registers
     "Allocate a legacy flat program or every function in a v3 module. A function
     containing a straight-line call stores only values live across that call and
     reloads them lazily. A function that also has control flow uses the linear
     scanner; leftover pressure takes the conservative all-vreg path. Pure integer
     scheduling runs after allocation on physical MIR, one basic block at a time.
     The Kotoba twin aborts with the first problem's keyword."
     [program [:ref :form/r]] [:ref :form/r]
     (let [r (allocate-registers-result program)]
       (if (fhas? r :problem)
         (do (reject! (kw-of (fget r :problem))) program)
         (fget r :program)))))

;; ---- counted self recursion ----

#?(:kotoba
   (defn- bulk-fuel-pure-op? [op :keyword] :bool
     (or (= op :mir/argument) (= op :mir/constant) (= op :mir/add) (= op :mir/subtract) (= op :mir/multiply)
         (= op :mir/multiply-add) (= op :mir/multiply-subtract)
         (= op :mir/bit-and) (= op :mir/bit-or) (= op :mir/bit-xor)
         (= op :mir/shift-left) (= op :mir/shift-right-signed) (= op :mir/shift-right-unsigned)
         (= op :mir/equal) (= op :mir/less-than) (= op :mir/greater-than)
         (= op :mir/less-or-equal) (= op :mir/greater-or-equal) (= op :mir/move))))

#?(:kotoba
   (defn- bulk-fuel-pure-instruction? [instruction [:ref :form/r]] :bool
     (let [op (kw-of (fget instruction :mir/op))
           divisor (fget instruction :mir/divisor)]
       (or (bulk-fuel-pure-op? op)
           (and (= op :mir/quotient-constant)
                (gmir/i64-value? divisor)
                (not (int-eq? divisor -1))
                (not (int-eq? divisor 0)))))))

#?(:kotoba
   (defn- count-op [instructions [:ref :form/r] op :keyword] :i64
     (let [n (form/count-of instructions)]
       (loop [i 0 c 0]
         (if (>= i n) c
           (recur (inc i) (if (kw? (fget (form/nth-of instructions i) :mir/op) op) (inc c) c)))))))

#?(:kotoba
   (defn- all-return-or-pure? [instructions [:ref :form/r]] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) true
           (let [ins (form/nth-of instructions i)]
             (if (or (kw? (fget ins :mir/op) :mir/return) (bulk-fuel-pure-instruction? ins))
               (recur (inc i))
               false)))))))

#?(:kotoba
   (defn- bulk-fuel-pure-leaf? [function [:ref :form/r]] :bool
     (let [instructions (fget function :mir/instructions)]
       (and (form/is-symbol? (fget function :mir/name))
            (= 1 (count-op instructions :mir/return))
            (all-return-or-pure? instructions)))))

;; The index of the first instruction of OP, -1 when none (used when exactly one).
#?(:kotoba
   (defn- first-index-of-op [instructions [:ref :form/r] op :keyword] :i64
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) -1
           (if (kw? (fget (form/nth-of instructions i) :mir/op) op) i (recur (inc i))))))))

;; Argument instructions sorted by :mir/index (stable insertion).
#?(:kotoba
   (defn- sorted-arguments [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 acc (fvec)]
         (if (>= i n) acc
           (let [ins (form/nth-of instructions i)]
             (recur (inc i) (if (kw? (fget ins :mir/op) :mir/argument) (insert-by-index acc ins) acc))))))))

#?(:kotoba
   (defn- insert-by-index [sorted [:ref :form/r] ins [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of sorted)
           k (ival-or (fget ins :mir/index) 0)]
       (loop [p n]
         (if (and (> p 0) (> (ival-or (fget (form/nth-of sorted (- p 1)) :mir/index) 0) k))
           (recur (- p 1))
           (vinto (vconj (vtake sorted p) ins) (vdrop sorted p)))))))

;; dst -> instruction for every instruction with a dst (later wins).
#?(:kotoba
   (defn- definitions-of [instructions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of instructions)]
       (loop [i 0 acc (fmap)]
         (if (>= i n) acc
           (let [ins (form/nth-of instructions i)
                 dst (fget ins :mir/dst)]
             (recur (inc i) (if (form/is-nil? dst) acc (massoc acc dst ins)))))))))

#?(:kotoba
   (defn- arguments-indexed-from-zero? [arguments [:ref :form/r]] :bool
     (let [n (form/count-of arguments)]
       (loop [i 0]
         (if (>= i n) true
           (if (int-eq? (fget (form/nth-of arguments i) :mir/index) i) (recur (inc i)) false))))))

#?(:kotoba
   (defn- counter-index-of [arguments [:ref :form/r] counter [:ref :form/r]] :i64
     (let [n (form/count-of arguments)]
       (loop [i 0]
         (if (>= i n) -1
           (if (form/eq counter (fget (form/nth-of arguments i) :mir/dst)) i (recur (inc i))))))))

#?(:kotoba
   (defn- structural-op? [op :keyword] :bool
     (or (= op :mir/branch-nonzero) (= op :mir/return) (= op :mir/label) (= op :mir/tail-call))))

#?(:kotoba
   (defn- counted-body-ok? [instructions [:ref :form/r] pure-leaf-callees [:ref :form/r]] :bool
     (let [n (form/count-of instructions)]
       (loop [i 0]
         (if (>= i n) true
           (let [ins (form/nth-of instructions i)
                 op (kw-of (fget ins :mir/op))]
             (if (or (structural-op? op)
                     (bulk-fuel-pure-instruction? ins)
                     (and (= op :mir/call) (member-of? pure-leaf-callees (fget ins :mir/callee))))
               (recur (inc i))
               false)))))))

;; The plan map, or a nil form.
#?(:kotoba
   (defn- counted-self-recur-plan* [function [:ref :form/r] pure-leaf-callees [:ref :form/r]] [:ref :form/r]
     (let [name (fget function :mir/name)
           arity (fget function :mir/arity)
           instructions (fget function :mir/instructions)
           arguments (sorted-arguments instructions)
           branch-count (+ (count-op instructions :mir/branch-zero) (count-op instructions :mir/branch-nonzero))]
       (if (not (and (form/is-symbol? name)
                     (form/is-int? arity)
                     (= (form/int-value arity) (form/count-of arguments))
                     (arguments-indexed-from-zero? arguments)
                     (= 1 branch-count)
                     (= 1 (count-op instructions :mir/label))
                     (= 1 (count-op instructions :mir/return))
                     (= 1 (count-op instructions :mir/tail-call))))
         (form/nil-form)
         (let [branch-index (if (> (count-op instructions :mir/branch-zero) 0)
                              (first-index-of-op instructions :mir/branch-zero)
                              (first-index-of-op instructions :mir/branch-nonzero))
               branch (form/nth-of instructions branch-index)
               label-index (first-index-of-op instructions :mir/label)
               label (form/nth-of instructions label-index)
               return-index (first-index-of-op instructions :mir/return)
               tail-index (first-index-of-op instructions :mir/tail-call)
               tail (form/nth-of instructions tail-index)
               counter (fget branch :mir/test)
               counter-index (counter-index-of arguments counter)
               definitions (definitions-of instructions)
               next-counter (if (>= counter-index 0) (form/nth-of (fget tail :mir/arguments) counter-index) (form/nil-form))
               decrement (mget definitions next-counter)
               one (mget definitions (fget decrement :mir/right))]
           (if (and (kw? (fget branch :mir/op) :mir/branch-nonzero)
                    (= (+ branch-index 1) return-index)
                    (= (+ branch-index 2) label-index)
                    (form/eq (fget branch :mir/target) (fget label :mir/id))
                    (= tail-index (- (form/count-of instructions) 1))
                    (form/eq name (fget tail :mir/callee))
                    (= (form/int-value arity) (form/count-of (fget tail :mir/arguments)))
                    (>= counter-index 0)
                    (kw? (fget decrement :mir/op) :mir/subtract)
                    (form/eq counter (fget decrement :mir/left))
                    (kw? (fget one :mir/op) :mir/constant)
                    (int-eq? (fget one :mir/value) 1)
                    (counted-body-ok? instructions pure-leaf-callees))
             (mk3 :counter-parameter (fint counter-index)
                  :runtime-domain (kwf :nonnegative-i64)
                  :charge (kwf :entry-plus-exact-self-recur-count))
             (form/nil-form)))))))

#?(:kotoba
   (defn counted-self-recur-plan
     "Return the conservative bulk-fuel proof for one selected virtual-MIR
     function, or nil (a nil form on this route)."
     [function [:ref :form/r]] [:ref :form/r]
     (counted-self-recur-plan* function (fset))))

#?(:kotoba
   (defn- pure-leaf-names [functions [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of functions)]
       (loop [i 0 acc (fset)]
         (if (>= i n) acc
           (let [f (form/nth-of functions i)]
             (recur (inc i) (if (bulk-fuel-pure-leaf? f) (sconj acc (fget f :mir/name)) acc))))))))

#?(:kotoba
   (defn- counted-plans-of [functions [:ref :form/r] pure-leaf-callees [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of functions)]
       (loop [i 0 acc (fmap)]
         (if (>= i n) acc
           (let [f (form/nth-of functions i)
                 plan (counted-self-recur-plan* f pure-leaf-callees)]
             (recur (inc i) (if (form/is-nil? plan) acc (massoc acc (fget f :mir/name) plan)))))))))

#?(:kotoba
   (defn counted-self-recur-plans-result [program [:ref :form/r]] [:ref :form/r]
     (let [p (validate-problem program)]
       (cond
         (not (= p :ok)) (kassoc (fmap) :problem (kwf p))
         (not (and (int-eq? (fget program :mir/version) 3) (kw? (fget program :mir/registers) :virtual)))
         (kassoc (fmap) :problem (kwf :bulk-fuel-analysis-requires-selected-virtual-module))
         :else
         (let [functions (fget program :mir/functions)]
           (kassoc (fmap) :plans (counted-plans-of functions (pure-leaf-names functions))))))))

#?(:kotoba
   (defn counted-self-recur-plans
     "Map function names to proven counted/pure self-recur fuel plans. PROGRAM
     must already be selected virtual MIR so target-specific trapping operations
     are visible to the proof."
     [program [:ref :form/r]] [:ref :form/r]
     (let [r (counted-self-recur-plans-result program)]
       (if (fhas? r :problem)
         (do (reject! (kw-of (fget r :problem))) program)
         (fget r :plans)))))

#?(:kotoba nil :default
(def ^:private bulk-fuel-pure-ops
  "MIR operations that cannot call, touch memory/capabilities, or trap.  Keep
  this allow-list closed: adding an operation is a proof obligation, not a
  throughput tweak.  In particular, general quotient is absent; the selected
  constant form is admitted separately only for divisors other than 0/-1."
  #{:mir/argument :mir/constant
    :mir/add :mir/subtract :mir/multiply
    :mir/multiply-add :mir/multiply-subtract
    :mir/bit-and :mir/bit-or :mir/bit-xor
    :mir/shift-left :mir/shift-right-signed :mir/shift-right-unsigned
    :mir/equal :mir/less-than :mir/greater-than
    :mir/less-or-equal :mir/greater-or-equal
    :mir/move}))

#?(:kotoba nil :default
(defn- bulk-fuel-pure-instruction? [{:mir/keys [op divisor]}]
  (or (contains? bulk-fuel-pure-ops op)
      ;; Same representation hazard as `host-number`'s docstring records: a
      ;; divisor that came from the reader is a BigInt, `integer?` is false
      ;; for one, and this whole clause silently stopped admitting it.
      (and (= :mir/quotient-constant op)
           (gmir/i64-value? divisor)
           (not (contains? #{-1 0} (host-number divisor)))))))

#?(:kotoba nil :default
(defn- bulk-fuel-pure-leaf?
  "Prove a closed direct callee finite, pure and nontrapping.  `leaf` is
  intentionally literal here: calls, branches and tail calls are not admitted,
  even when another analysis could prove them finite.  This keeps the proof
  local and prevents a call-graph cycle from entering bulk-fuel admission."
  [{:mir/keys [name instructions]}]
  (and (symbol? name)
       (= 1 (count (filter #(= :mir/return (:mir/op %)) instructions)))
       (every? (fn [instruction]
                 (or (= :mir/return (:mir/op instruction))
                     (bulk-fuel-pure-instruction? instruction)))
               instructions))))

#?(:kotoba nil :default
(defn- counted-self-recur-plan*
  [{:mir/keys [name arity instructions]} pure-leaf-callees]
  (let [instructions (vec instructions)
        indexed (map-indexed vector instructions)
        branches (filterv (fn [[_ instruction]]
                            (contains? #{:mir/branch-zero :mir/branch-nonzero}
                                       (:mir/op instruction)))
                          indexed)
        labels (filterv (fn [[_ instruction]]
                          (= :mir/label (:mir/op instruction)))
                        indexed)
        returns (filterv (fn [[_ instruction]]
                           (= :mir/return (:mir/op instruction)))
                         indexed)
        tails (filterv (fn [[_ instruction]]
                         (= :mir/tail-call (:mir/op instruction)))
                       indexed)
        arguments (->> instructions
                       (filter #(= :mir/argument (:mir/op %)))
                       (sort-by :mir/index)
                       vec)
        definitions (into {} (keep (fn [{:mir/keys [dst] :as instruction}]
                                     (when dst [dst instruction])))
                                   instructions)]
    (when (and (symbol? name)
               (integer? arity)
               (= arity (count arguments))
               (= (range arity) (map :mir/index arguments))
               (= 1 (count branches))
               (= 1 (count labels))
               (= 1 (count returns))
               (= 1 (count tails)))
      (let [[[branch-index branch]] branches
            [[label-index label]] labels
            [[return-index _]] returns
            [[tail-index tail]] tails
            counter (:mir/test branch)
            counter-index (first (keep-indexed
                                  (fn [index argument]
                                    (when (= counter (:mir/dst argument)) index))
                                  arguments))
            next-counter (when (some? counter-index)
                           (nth (:mir/arguments tail) counter-index nil))
            decrement (get definitions next-counter)
            one (get definitions (:mir/right decrement))
            structural-ops #{:mir/branch-nonzero :mir/return :mir/label
                             :mir/tail-call}]
        (when (and (= :mir/branch-nonzero (:mir/op branch))
                   (= (inc branch-index) return-index)
                   (= (+ branch-index 2) label-index)
                   (= (:mir/target branch) (:mir/id label))
                   (= tail-index (dec (count instructions)))
                   (= name (:mir/callee tail))
                   (= arity (count (:mir/arguments tail)))
                   (some? counter-index)
                   (= :mir/subtract (:mir/op decrement))
                   (= counter (:mir/left decrement))
                   (= :mir/constant (:mir/op one))
                   ;; host-number: a literal from the reader is a BigInt on ClojureScript, and (= 1 1n) is
                   ;; false there, so without it nbb silently refused every source-written countdown
                   (= 1 (host-number (:mir/value one)))
                   (every? (fn [instruction]
                             (or (contains? structural-ops (:mir/op instruction))
                                 (bulk-fuel-pure-instruction? instruction)
                                 (and (= :mir/call (:mir/op instruction))
                                      (contains? pure-leaf-callees
                                                 (:mir/callee instruction)))))
                           instructions))
          {:counter-parameter counter-index
           :runtime-domain :nonnegative-i64
           :charge :entry-plus-exact-self-recur-count}))))))

#?(:kotoba nil :default
(defn counted-self-recur-plan
  "Return the conservative bulk-fuel proof for one selected virtual-MIR
  function, or nil.

  The admitted CFG has one latch branch, one base return, one body label and
  one terminal self tail-call.  Its counter is an entry argument tested
  directly for nonzero and the corresponding recur argument is exactly
  `counter - 1`.  The remaining body is closed, pure and nontrapping.

  This proves the iteration count for a non-negative runtime counter.  A
  backend must retain ordinary per-edge charging for negative counters; this
  function does not authorize wrapping a negative value into a bulk charge."
  [function]
  (counted-self-recur-plan* function #{})))

#?(:kotoba nil :default
(defn counted-self-recur-plans
  "Map function names to proven counted/pure self-recur fuel plans.  PROGRAM
  must already be selected virtual MIR so target-specific trapping operations
  are visible to the proof."
  [{:mir/keys [version registers functions] :as program}]
  (validate! program)
  (when-not (and (= 3 version) (= :virtual registers))
    (reject! :bulk-fuel-analysis-requires-selected-virtual-module program))
  (let [pure-leaf-callees (into #{}
                                (keep (fn [{:mir/keys [name] :as function}]
                                        (when (bulk-fuel-pure-leaf? function)
                                          name)))
                                functions)]
    (into {}
          (keep (fn [{:mir/keys [name] :as function}]
                  (when-let [plan (counted-self-recur-plan*
                                   function pure-leaf-callees)]
                    [name plan])))
          functions))))

;; Both routes can name the problem a selection or an allocation stops at, as a
;; map with :program or :problem, so the host and the Kotoba twin can be
;; compared on identical programs.
#?(:kotoba nil :default
(defn select-target-result [target program]
  (try
    {:program (select-target target program)}
    (catch #?(:clj clojure.lang.ExceptionInfo :cljs :default) e
      {:problem (or (:problem (ex-data e)) :exception)}))))

#?(:kotoba nil :default
(defn allocate-registers-result [program]
  (try
    {:program (allocate-registers program)}
    (catch #?(:clj clojure.lang.ExceptionInfo :cljs :default) e
      {:problem (or (:problem (ex-data e)) :exception)}))))

#?(:kotoba nil :default
(defn counted-self-recur-plans-result [program]
  (try
    {:plans (counted-self-recur-plans program)}
    (catch #?(:clj clojure.lang.ExceptionInfo :cljs :default) e
      {:problem (or (:problem (ex-data e)) :exception)}))))
