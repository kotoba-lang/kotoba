;; Native AVL/identity self-checks, including multi-page large inputs.
(ns kotoba.mir-table-cases
  {:kotoba/export [main large-main]}
  (:require [kotoba.gmir.node :as node] [kotoba.mir.table :as table]))

(defn- scalar [value :i64] [:ref :mir.table/value] (table/scalar (node/i64-value value)))
(defn- has? [tree [:ref :mir.table/tree] key [:ref :mir.table/key] expected :i64] :bool
  (let [value (table/get tree key)]
    (and (option-some?-of [:option [:ref :mir.table/value]] value)
         (= (node/number (table/data (option-value-of [:option [:ref :mir.table/value]] value (scalar -1)))) expected))))
(defn- rotation? [a :i64 b :i64 c :i64] :bool
  (let [tree (table/put (table/put (table/put (table/empty) (table/index-key a) (scalar a)) (table/index-key b) (scalar b)) (table/index-key c) (scalar c))]
    (and (table/valid? tree) (= (table/count tree) 3) (= (table/height tree) 2)
         (has? tree (table/index-key 1) 1) (has? tree (table/index-key 2) 2) (has? tree (table/index-key 3) 3)
         (loop [index 0]
           (if (>= index 3) true
             (let [value (table/value-at tree index)]
               (if (and (option-some?-of [:option [:ref :mir.table/value]] value)
                        (= (node/number (table/data (option-value-of [:option [:ref :mir.table/value]] value (scalar -1)))) (+ index 1)))
                 (recur (+ index 1)) false)))))))
(defn- identities? [] :bool
  (let [none (option-none-of [:option [:ref :gmir.node/text]])
        empty (option-some-of [:option [:ref :gmir.node/text]] (node/empty-text))
        a (table/keyword-key (option-some-of [:option [:ref :gmir.node/text]] (node/string-text "a")) (node/string-text "b/c"))
        b (table/keyword-key (option-some-of [:option [:ref :gmir.node/text]] (node/string-text "a/b")) (node/string-text "c"))
        c (table/keyword-key none (node/string-text "x")) d (table/keyword-key empty (node/string-text "x"))
        e (table/symbol-key none (node/string-text "x"))
        tree (table/put (table/put (table/put (table/put (table/put (table/empty) a (scalar 1)) b (scalar 2)) c (scalar 3)) d (scalar 4)) e (scalar 5))
        nil-tree (table/put tree (table/nil-key) (table/scalar (node/nil-value)))
        nil-entry (table/get nil-tree (table/nil-key))]
    (and (table/valid? nil-tree) (= (table/count tree) 5) (= (table/count nil-tree) 6)
         (has? tree a 1) (has? tree b 2) (has? tree c 3) (has? tree d 4) (has? tree e 5)
         (not= (table/compare-key a b) 0) (not= (table/compare-key c d) 0) (not= (table/compare-key c e) 0)
         (option-some?-of [:option [:ref :mir.table/value]] nil-entry)
         (= (node/kind (table/data (option-value-of [:option [:ref :mir.table/value]] nil-entry (scalar -1)))) :nil)
         (not (option-some?-of [:option [:ref :mir.table/value]] (table/get tree (table/nil-key))))
         (not (option-some?-of [:option [:ref :mir.table/value]] (table/get nil-tree (table/index-key 0)))))))
(defn- persistence? [] :bool
  (let [empty (table/empty) first (table/put empty (table/index-key 0) (scalar 10))
        second (table/put first (table/index-key 0) (scalar 20))
        member (table/put (table/empty) (table/index-key 7) (scalar 7))
        nested (table/put second (table/index-key 1) (table/members-value member))
        found (table/get nested (table/index-key 1))]
    (and (= (table/count empty) 0) (table/valid? empty) (has? first (table/index-key 0) 10)
         (has? second (table/index-key 0) 20) (= (table/count second) 1) (= (table/count nested) 2)
         (table/valid? nested) (option-some?-of [:option [:ref :mir.table/value]] found)
         (has? (table/members (option-value-of [:option [:ref :mir.table/value]] found (scalar -1))) (table/index-key 7) 7)
         (not (option-some?-of [:option [:ref :mir.table/value]] (table/value-at nested -1)))
         (not (option-some?-of [:option [:ref :mir.table/value]] (table/value-at nested 2))))))
(defn- deletion? [] :bool
  (let [original (loop [index 0 out (table/empty)]
                   (if (>= index 257) out (recur (+ index 1) (table/put out (table/index-key index) (scalar index)))))
        evens (loop [index 0 out original]
                (if (>= index 257) out (recur (+ index 2) (table/remove out (table/index-key index)))))
        empty (loop [index 1 out evens]
                (if (>= index 257) out (recur (+ index 2) (table/remove out (table/index-key index)))))]
    (and (table/valid? original) (= (table/count original) 257) (table/valid? evens) (= (table/count evens) 128)
         (= (table/count empty) 0) (table/valid? empty) (= (table/count (table/remove evens (table/index-key -1))) 128)
         (loop [index 0]
           (if (>= index 128) true
             (let [key (table/key-at evens index)]
               (if (and (option-some?-of [:option [:ref :mir.table/key]] key)
                        (= (record-get [:ref :mir.table/key] (option-value-of [:option [:ref :mir.table/key]] key (table/nil-key)) :index) (+ (* index 2) 1))
                        (has? original (table/index-key (* index 2)) (* index 2))
                        (not (option-some?-of [:option [:ref :mir.table/value]] (table/get evens (table/index-key (* index 2))))))
                 (recur (+ index 1)) false)))))))
(defn main [] :i64
  (cond (not (and (rotation? 1 2 3) (rotation? 3 2 1) (rotation? 3 1 2) (rotation? 1 3 2))) 1
        (not (identities?)) 2 (not (persistence?)) 3 (not (deletion?)) 4 :else 0))
(defn large-main [] :i64
  (let [tree (loop [index 0 out (table/empty)]
               (if (>= index 16700) out (recur (+ index 1) (table/put out (table/index-key index) (scalar index)))))]
    (if (and (= (table/count tree) 16700) (<= (table/height tree) 32) (table/valid? tree)
             (loop [index 0]
               (if (>= index 16700) true
                 (let [value (table/value-at tree index)]
                   (if (and (has? tree (table/index-key index) index)
                            (option-some?-of [:option [:ref :mir.table/value]] value)
                            (= (node/number (table/data (option-value-of [:option [:ref :mir.table/value]] value (scalar -1)))) index))
                     (recur (+ index 1)) false))))) 0 1)))
