;; Native source fixtures only. No implementation/oracle/compiler was run.
(ns kotoba.mir-selection-cases
  {:kotoba/export [main]}
  (:require [kotoba.gmir :as gmir] [kotoba.gmir.node :as node]
            [kotoba.gmir.catalog :as gmir-catalog] [kotoba.mir.selection :as selection]
            [kotoba.mir.outcome :as outcome] [kotoba.mir-module-cases :as check]))

(defn- at [value [:ref :gmir.node/value] index :i64] [:ref :gmir.node/value]
  (option-match [:option [:ref :gmir.node/value]] (node/child value index) (node/nil-value) item item))
(defn- kw [value :keyword] [:ref :gmir.node/value] (node/keyword-literal value))
(defn- named? [value [:ref :gmir.node/value] key :keyword] :bool (node/same-name? value (kw key)))
(defn- v [index :i64] [:ref :gmir.node/value]
  (result-value-of [:result [:ref :gmir.node/value] [:ref :gmir/refusal]] (gmir/vreg (node/i64-value index)) (node/nil-value)))
(defn- sym [value :string] [:ref :gmir.node/value]
  (node/symbol-parts (option-none-of [:option [:ref :gmir.node/text]]) (node/string-text value)))
(defn- ins [op :keyword] [:ref :gmir.node/value] (node/put-key (node/empty-map) :gmir/op (kw op)))
(defn- constant [dst :i64 value [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (ins :gmir/constant) (node/put-key :gmir/dst (v dst)) (node/put-key :gmir/value value)))
(defn- binary [op :keyword dst :i64 left :i64 right :i64] [:ref :gmir.node/value]
  (-> (ins op) (node/put-key :gmir/dst (v dst)) (node/put-key :gmir/left (v left)) (node/put-key :gmir/right (v right))))
(defn- label [name :keyword] [:ref :gmir.node/value] (node/put-key (ins :gmir/label) :gmir/id (kw name)))
(defn- jump [name :keyword] [:ref :gmir.node/value] (node/put-key (ins :gmir/jump) :gmir/target (kw name)))
(defn- incoming [name :keyword value [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-map) (node/put-key :gmir/predecessor (kw name)) (node/put-key :gmir/value value)))
(defn- argument [] [:ref :gmir.node/value] (-> (ins :gmir/argument) (node/put-key :gmir/dst (v 0)) (node/put-key :gmir/index (node/i64-value 0))))
(defn- ret [value :i64] [:ref :gmir.node/value] (node/put-key (ins :gmir/return) :gmir/value (v value)))
(defn- function [name :string code [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-map) (node/put-key :gmir/name (sym name)) (node/put-key :gmir/arity (node/i64-value 1)) (node/put-key :gmir/instructions code)))
(defn- module [code [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-map) (node/put-key :gmir/version (node/i64-value 3)) (node/put-key :gmir/entry (sym "f"))
      (node/put-key :gmir/functions (node/append (node/empty-vector) (function "f" code)))))
(defn- flat [version :i64 code [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-map) (node/put-key :gmir/version (node/i64-value version)) (node/put-key :gmir/instructions code)))
(defn- mir-key [key :keyword] :keyword
  ;; Independent literal transcription of the owning selector key case.
  (case key :gmir/op :mir/op :gmir/dst :mir/dst :gmir/index :mir/index :gmir/value :mir/value
    :gmir/input :mir/input :gmir/left :mir/left :gmir/right :mir/right :gmir/id :mir/id
    :gmir/test :mir/test :gmir/target :mir/target :gmir/incomings :mir/incomings :gmir/content :mir/content
    :gmir/rodata-encoding :mir/rodata-encoding :gmir/function :mir/function :gmir/callee :mir/callee
    :gmir/runtime :mir/runtime :gmir/action :mir/action :gmir/capability :mir/capability :gmir/kind :mir/kind
    :gmir/arguments :mir/arguments :gmir/base :mir/base :gmir/length :mir/length :gmir/stored :mir/stored
    :gmir/expected :mir/expected :gmir/second-base :mir/second-base :gmir/second-length :mir/second-length
    :gmir/count :mir/count :gmir/offset :mir/offset :gmir/size :mir/size :gmir/maximum :mir/maximum :mir/unknown))
(defn- mir-op [op :keyword] [:ref :gmir.node/value] (kw (keyword-from-string (string-concat "mir/" (keyword-name op)))))
(defn- operation [value [:ref :gmir.node/value]] :keyword
  (let [all (gmir-catalog/instruction-keysets)]
    (loop [index 0]
      (if (>= index (vector-count all)) :unknown
        (let [op (gmir-catalog/keyset-operation (typed-list-nth [:list [:ref :gmir.catalog/keyset]] all index))]
          (if (named? (node/key value :gmir/op) op) op (recur (+ index 1))))))))
(defn- converted-incomings [values [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (loop [index 0 out (node/empty-vector)]
    (if (>= index (node/child-count values)) out
      (let [value (at values index)]
        (recur (+ index 1) (node/append out (-> (node/empty-map) (node/put-key :mir/predecessor (node/key value :gmir/predecessor))
          (node/put-key :mir/value (node/key value :gmir/value)))))))))
(defn- converted-instruction [value [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (let [op (operation value)
        keys (option-value-of [:option [:list :keyword]] (gmir-catalog/instruction-keys op) (typed-list-new [:list :keyword]))
        base (cond (= op :gmir/runtime-call) (node/put-key (node/empty-map) :mir/context-offset (node/i64-value 8))
                   (= op :gmir/capability-call) (node/put-key (node/empty-map) :mir/context-offset (node/i64-value 48)) :else (node/empty-map))]
    (loop [index 0 out base]
      (if (>= index (vector-count keys)) out
        (let [key (typed-list-nth [:list :keyword] keys index) original (node/key value key)]
          (recur (+ index 1) (node/put-key out (mir-key key)
            (cond (= key :gmir/op) (mir-op op) (= key :gmir/incomings) (converted-incomings original) :else original))))))))
(defn- converted-code [code [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (loop [index 0 out (node/empty-vector)]
    (if (>= index (node/child-count code)) out (recur (+ index 1) (node/append out (converted-instruction (at code index)))))))
(defn- expected-module [target :keyword code [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-map) (node/put-key :mir/version (node/i64-value 3)) (node/put-key :mir/target (kw target)) (node/put-key :mir/registers (kw :virtual))
      (node/put-key :mir/entry (sym "f")) (node/put-key :mir/functions (node/append (node/empty-vector)
        (-> (node/empty-map) (node/put-key :mir/name (sym "f")) (node/put-key :mir/arity (node/i64-value 1)) (node/put-key :mir/instructions code))))))
(defn- pass=? [target :keyword program [:ref :gmir.node/value] expected [:ref :gmir.node/value]] :bool
  (arena-scope
  (let [result (selection/select-target (kw target) program)]
    (and (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result)
         (check/same-value? (result-value-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result (node/nil-value)) expected)))))
(defn- refusal=? [target [:ref :gmir.node/value] program [:ref :gmir.node/value] phase :keyword problem :keyword data [:ref :gmir.node/value]] :bool
  (arena-scope
  (let [result (selection/select-target target program)
        error (result-error-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result (outcome/refusal :unexpected-success program))]
    (and (not (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result))
         (= (outcome/phase error) phase) (= (outcome/problem error) problem)
         (string=? (outcome/message error) (string-concat (if (= phase :gmir) "GMIR rejected: " "MIR rejected: ") (keyword-name problem)))
         (check/same-value? (outcome/instruction error) data)))))
(defn- default-field [op :keyword key :keyword] [:ref :gmir.node/value]
  (cond (= key :gmir/op) (kw op) (or (= key :gmir/id) (= key :gmir/target)) (kw :case/target)
    (or (= key :gmir/function) (= key :gmir/callee)) (sym "f")
    (= key :gmir/index) (if (= op :gmir/argument) (node/i64-value 0) (v 0))
    (= key :gmir/value) (if (= op :gmir/constant) (node/i64-value 1) (v 0))
    (= key :gmir/content) (node/string-value (node/empty-text)) (= key :gmir/rodata-encoding) (kw :hex-bytes)
    (= key :gmir/runtime) (kw :fuel-charge) (= key :gmir/action) (kw :boot-info)
    (= key :gmir/kind) (kw :i64) (= key :gmir/capability) (node/i64-value 0)
    (= key :gmir/arguments) (if (or (= op :gmir/capability-call) (= op :gmir/call) (= op :gmir/tail-call))
                            (node/append (node/empty-vector) (v 0)) (node/empty-vector))
    (= key :gmir/incomings) (-> (node/empty-vector) (node/append (incoming :case/a (v 0))) (node/append (incoming :case/b (v 0))))
    (= key :gmir/maximum)
    (node/i64-value (cond (gmir-catalog/keyword-member? (gmir/slice-operations) op) (gmir/slice-item-limit)
                         (or (= op :gmir/kernel-dot-f32) (gmir-catalog/keyword-member? (gmir/kernel-dequant-dot-operations) op)) (gmir/kernel-dot-f32-maximum)
                         :else 4096))
    :else (v 0)))
(defn- row-instruction [row [:ref :gmir.catalog/keyset]] [:ref :gmir.node/value]
  (let [op (gmir-catalog/keyset-operation row) keys (gmir-catalog/keyset-keys row)]
    (loop [index 0 out (node/empty-map)]
      (if (>= index (vector-count keys)) out
        (let [key (typed-list-nth [:list :keyword] keys index)]
          (recur (+ index 1) (node/put-key out key (default-field op key))))))))
(defn- context [op :keyword value [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (cond (= op :gmir/phi)
        (-> (node/empty-vector) (node/append (label :case/a)) (node/append (jump :case/target))
            (node/append (label :case/b)) (node/append (jump :case/target)) (node/append (label :case/target)) (node/append value) (node/append (ret 0)))
        (or (= op :gmir/jump) (= op :gmir/branch-zero)) (-> (node/empty-vector) (node/append (label :case/target)) (node/append value))
        :else (node/append (node/empty-vector) value)))
(defn- all-rows? [target :keyword] :bool
  (arena-scope
  (let [rows (gmir-catalog/instruction-keysets)]
    (and (= (vector-count rows) 92)
         (loop [index 0]
           (if (>= index (vector-count rows)) true
             (let [row (typed-list-nth [:list [:ref :gmir.catalog/keyset]] rows index) op (gmir-catalog/keyset-operation row)
                   code (context op (row-instruction row)) program (module code)
                   refused (and (= target :aarch64) (gmir-catalog/keyword-member? (gmir/kernel-dequant-dot-operations) op) (not= op :gmir/kernel-dequant-dot-q8-0))
                   good (cond (and (= target :aarch64) (= op :gmir/x86-privileged))
                              (refusal=? (kw target) program :mir :x86-privileged-target-mismatch
                                (-> (node/empty-map) (node/put-key :target (kw target)) (node/put-key :actions (node/append (node/empty-vector) (kw :boot-info)))))
                              refused (refusal=? (kw target) program :mir :x86-simd-target-mismatch
                                (-> (node/empty-map) (node/put-key :target (kw target)) (node/put-key :operations (node/append (node/empty-vector) (kw op)))))
                              :else (pass=? target program (expected-module target (converted-code code))))]
               (if good (recur (+ index 1)) false))))))))
(defn- first-refusal? [] :bool
  (arena-scope
  (let [missing (node/nil-value) unsupported (node/i64-value 7)
        bad (constant 0 (node/f64-bits-value 0x7ff8000000000001))]
    (and (refusal=? unsupported missing :mir :unsupported-target (node/put-key (node/empty-map) :target unsupported))
         (refusal=? (kw :unknown) missing :mir :unsupported-target (node/put-key (node/empty-map) :target (kw :unknown)))
         (refusal=? (kw :aarch64) missing :gmir :non-canonical-program missing)
         (refusal=? (kw :aarch64) (module (node/append (node/empty-vector) bad)) :gmir :constant-not-i64 bad)))))
(defn- division? [value [:ref :gmir.node/value] shared :bool flat-version :i64] :bool
  (arena-scope
  (let [constant (constant 1 value) quotient (binary :gmir/quotient 2 0 1)
        code (-> (node/empty-vector) (node/append (argument)) (node/append constant) (node/append quotient))
        whole (if shared (-> code (node/append (binary :gmir/add 3 2 1)) (node/append (ret 3))) (node/append code (ret 2)))
        ordinary (converted-code whole)
        optimized-quotient (-> (node/empty-map) (node/put-key :mir/op (kw :mir/quotient-constant)) (node/put-key :mir/dst (v 2))
                               (node/put-key :mir/left (v 0)) (node/put-key :mir/divisor value))
        optimized (if shared (-> (node/empty-vector) (node/append (at ordinary 0)) (node/append (at ordinary 1))
                                  (node/append optimized-quotient) (node/append (at ordinary 3)) (node/append (at ordinary 4)))
                    (-> (node/empty-vector) (node/append (at ordinary 0)) (node/append optimized-quotient) (node/append (at ordinary 3))))]
    (if (= flat-version 3) (and (pass=? :x86-64 (module whole) (expected-module :x86-64 optimized))
                              (pass=? :aarch64 (module whole) (expected-module :aarch64 optimized)))
      (let [expected (-> (node/empty-map) (node/put-key :mir/version (node/i64-value flat-version)) (node/put-key :mir/target (kw :x86-64))
                        (node/put-key :mir/registers (kw :virtual)) (node/put-key :mir/instructions ordinary))]
        (pass=? :x86-64 (flat flat-version whole) expected))))))
(defn- zero-code [zero [:ref :gmir.node/value] reversed :bool reused :bool interrupted :bool] [:ref :gmir.node/value]
  (let [equal (if reversed (binary :gmir/equal 2 1 0) (binary :gmir/equal 2 0 1))
        branch (-> (ins :gmir/branch-zero) (node/put-key :gmir/test (v 2)) (node/put-key :gmir/target (kw :case/nonzero)))
        prefix (-> (node/empty-vector) (node/append (argument)) (node/append (constant 1 zero)) (node/append equal))
        broken (if interrupted (node/append prefix (label :case/middle)) prefix)
        suffix (-> broken (node/append branch) (node/append (ret 0)) (node/append (label :case/nonzero)) (node/append (ret 0)))]
    (if reused (node/append suffix (binary :gmir/add 3 0 1)) suffix)))
(defn- zero-fusion? [zero [:ref :gmir.node/value] fuse :bool reversed :bool reused :bool interrupted :bool] :bool
  (arena-scope
  (let [code (zero-code zero reversed reused interrupted) original (converted-code code)
        fused (-> (node/empty-vector) (node/append (at original 0))
                  (node/append (-> (node/empty-map) (node/put-key :mir/op (kw :mir/branch-nonzero))
                    (node/put-key :mir/test (v 0)) (node/put-key :mir/target (kw :case/nonzero))))
                  (node/append (at original 4)) (node/append (at original 5)) (node/append (at original 6)))]
    (and (pass=? :x86-64 (module code) (expected-module :x86-64 original))
         (pass=? :aarch64 (module code) (expected-module :aarch64 (if fuse fused original)))))))
(defn- phi-global-use? [result :bool] :bool
  (arena-scope
  (let [branch (-> (ins :gmir/branch-zero) (node/put-key :gmir/test (v 2)) (node/put-key :gmir/target (kw :case/else)))
        values (-> (node/empty-vector) (node/append (incoming :case/then (v (if result 2 1)))) (node/append (incoming :case/else (v 0))))
        phi (-> (ins :gmir/phi) (node/put-key :gmir/dst (v 3)) (node/put-key :gmir/incomings values))
        code (-> (node/empty-vector) (node/append (argument)) (node/append (constant 1 (node/i64-value 0)))
                 (node/append (binary :gmir/equal 2 0 1)) (node/append branch)
                 (node/append (label :case/then)) (node/append (jump :case/join))
                 (node/append (label :case/else)) (node/append (jump :case/join)) (node/append (label :case/join))
                 (node/append phi) (node/append (ret 3)))]
    (pass=? :aarch64 (module code) (expected-module :aarch64 (converted-code code))))))
(defn- zero-negative-guards? [] :bool
  (arena-scope
  (let [base (zero-code (node/i64-value 0) false false false)
        both (binary :gmir/equal 2 1 1) alias (binary :gmir/equal 2 2 1)
        nil-operand (node/put-key (binary :gmir/equal 2 0 1) :gmir/left (node/nil-value))]
    (loop [case 0]
      (if (>= case 5) true
        (let [code (loop [index 0 out (node/empty-vector)]
                     (if (>= index (node/child-count base)) out
                       (let [value (at base index)
                             updated (cond (and (= index 2) (= case 0)) both (and (= index 2) (= case 1)) alias
                                           (and (= index 2) (= case 2)) nil-operand
                                           (and (= index 3) (= case 3)) (node/put-key value :gmir/test (v 3))
                                           (and (= index 2) (= case 4)) (binary :gmir/less-than 2 0 1) :else value)]
                         (recur (+ index 1) (node/append out updated)))))]
          (if (pass=? :aarch64 (module code) (expected-module :aarch64 (converted-code code))) (recur (+ case 1)) false)))))))
(defn- guard-order-and-data? [] :bool
  (arena-scope
  (let [rows (gmir-catalog/instruction-keysets)
        q4 (loop [index 0 out (node/nil-value)]
             (if (>= index (vector-count rows)) out
               (let [row (typed-list-nth [:list [:ref :gmir.catalog/keyset]] rows index)]
                 (recur (+ index 1) (if (= (gmir-catalog/keyset-operation row) :gmir/kernel-dequant-dot-q4-k) (row-instruction row) out)))))
        q6 (node/put-key q4 :gmir/op (kw :gmir/kernel-dequant-dot-q6-k))
        q8 (node/put-key q4 :gmir/op (kw :gmir/kernel-dequant-dot-q8-0))
        privileged (-> (ins :gmir/x86-privileged) (node/put-key :gmir/dst (v 0)) (node/put-key :gmir/action (kw :boot-info))
                       (node/put-key :gmir/arguments (node/empty-vector)))
        read-cr3 (node/put-key privileged :gmir/action (kw :read-cr3))
        code (-> (node/empty-vector) (node/append q6) (node/append q4) (node/append q8) (node/append q6))
        dq-program (module code)
        functions (-> (node/empty-vector) (node/append (function "f" code))
                      (node/append (function "g" (-> (node/empty-vector) (node/append privileged) (node/append read-cr3) (node/append privileged)))))
        combined (node/put-key dq-program :gmir/functions functions)
        target (kw :aarch64)]
    (and (refusal=? target dq-program :mir :x86-simd-target-mismatch
           (-> (node/empty-map) (node/put-key :target target) (node/put-key :operations
             (-> (node/empty-vector) (node/append (kw :gmir/kernel-dequant-dot-q6-k)) (node/append (kw :gmir/kernel-dequant-dot-q4-k))))))
         (refusal=? target combined :mir :x86-privileged-target-mismatch
           (-> (node/empty-map) (node/put-key :target target) (node/put-key :actions
             (-> (node/empty-vector) (node/append (kw :boot-info)) (node/append (kw :read-cr3)) (node/append (kw :boot-info))))))))))
(defn main [] :i64
  (cond (not (and (all-rows? :x86-64) (all-rows? :aarch64))) 1 (not (first-refusal?)) 2
        (not (and (division? (node/i64-value 2147483647) false 3) (division? (node/integer-value (node/string-text "-9223372036854775808")) false 3)
                  (division? (node/i64-value 7) true 3) (division? (node/i64-value 0) false 3)
                  (division? (node/i64-value 7) false 1) (division? (node/i64-value 7) false 2))) 3
        (not (and (zero-fusion? (node/i64-value 0) true false false false)
                  (zero-fusion? (node/integer-value (node/string-text "0")) true true false false)
                  (zero-fusion? (node/i64-value 1) false false false false)
                  (zero-fusion? (node/i64-value 0) false false true false)
                  (zero-fusion? (node/i64-value 0) false false false true))) 4
        (not (and (phi-global-use? false) (phi-global-use? true) (zero-negative-guards?))) 5
        (not (guard-order-and-data?)) 6 :else 0))
