;; Native self-check source. Complete upstream corpus,
;; allocation/fuel/authority/resource qualification remain separate gates.
(ns kotoba.mir-module-cases
  {:kotoba/export [main large-main large-reentry-main same-value?]}
  (:require [kotoba.gmir.node :as node] [kotoba.mir.catalog :as catalog]
            [kotoba.mir.validation :as validation] [kotoba.mir.outcome :as outcome]))

(defn- at [value [:ref :gmir.node/value] index :i64] [:ref :gmir.node/value]
  (option-match [:option [:ref :gmir.node/value]] (node/child value index) (node/nil-value) item item))
(defn- kw [value :keyword] [:ref :gmir.node/value] (node/keyword-literal value))
(defn- name [value :string] [:ref :gmir.node/value]
  (node/symbol-parts (option-none-of [:option [:ref :gmir.node/text]]) (node/string-text value)))
(defn- v [] [:ref :gmir.node/value] (kw :kotoba.gmir.vreg/0))
(defn- sequence2 [a [:ref :gmir.node/value] b [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-vector) (node/append a) (node/append b)))
(defn- same? [a [:ref :gmir.node/value] b [:ref :gmir.node/value]] :bool
  (let [kind (node/kind a) count (node/child-count a)]
    (and (= kind (node/kind b)) (= (node/number a) (node/number b))
         (= (node/has-namespace? a) (node/has-namespace? b))
         (node/text-equal? (node/name-of a) (node/name-of b))
         (or (not (node/has-namespace? a))
             (node/text-equal? (option-value-of [:option [:ref :gmir.node/text]] (node/namespace-of a) (node/empty-text))
                              (option-value-of [:option [:ref :gmir.node/text]] (node/namespace-of b) (node/empty-text))))
         (= count (node/child-count b))
         (cond
           (= kind :map)
           (loop [index 0]
             (if (>= index count) true
               (if (loop [other 0]
                     (if (>= other count) false
                       (if (and (same? (at a index) (at b other)) (same? (at a (+ index 1)) (at b (+ other 1))))
                         true (recur (+ other 2))))) (recur (+ index 2)) false)))
           (= kind :set)
           (loop [index 0]
             (if (>= index count) true
               (if (loop [other 0]
                     (if (>= other count) false (if (same? (at a index) (at b other)) true (recur (+ other 1)))))
                 (recur (+ index 1)) false)))
           :else
           (loop [index 0]
             (if (>= index count) true (if (same? (at a index) (at b index)) (recur (+ index 1)) false)))))))
(defn same-value? [left [:ref :gmir.node/value] right [:ref :gmir.node/value]] :bool (same? left right))
(defn- ok? [program [:ref :gmir.node/value]] :bool
  (let [result (validation/validate! program)]
    (and (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result)
         (same? program (result-value-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result (node/nil-value))))))
(defn- refused? [program [:ref :gmir.node/value] problem :keyword data [:ref :gmir.node/value]] :bool
  (let [result (validation/validate! program)
        error (result-error-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result (outcome/refusal :unexpected-success program))]
    (and (not (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result))
         (= (outcome/phase error) :mir) (= (outcome/problem error) problem)
         (string=? (outcome/message error) (string-concat "MIR rejected: " (keyword-name problem)))
         (same? (outcome/instruction error) data))))
(defn- instruction [op :keyword] [:ref :gmir.node/value] (node/put-key (node/empty-map) :mir/op (kw op)))
(defn- constant [register :keyword] [:ref :gmir.node/value]
  (-> (instruction :mir/constant) (node/put-key :mir/dst (kw register)) (node/put-key :mir/value (node/i64-value 7))))
(defn- argument [register :keyword index :i64] [:ref :gmir.node/value]
  (-> (instruction :mir/argument) (node/put-key :mir/dst (kw register)) (node/put-key :mir/index (node/i64-value index))))
(defn- move [dst :keyword src :keyword] [:ref :gmir.node/value]
  (-> (instruction :mir/move) (node/put-key :mir/dst (kw dst)) (node/put-key :mir/src (kw src))))
(defn- spill [load :bool register :keyword slot :i64] [:ref :gmir.node/value]
  (-> (instruction (if load :mir/spill-load :mir/spill-store)) (node/put-key (if load :mir/dst :mir/src) (kw register))
      (node/put-key :mir/slot (node/i64-value slot))))
(defn- area-store [incoming :bool index :i64] [:ref :gmir.node/value]
  (-> (instruction (if incoming :mir/incoming-argument-store :mir/outgoing-argument))
      (node/put-key :mir/index (node/i64-value index)) (node/put-key :mir/src (kw :x86-64/rax))))
(defn- incoming [index :i64] [:ref :gmir.node/value]
  (-> (instruction :mir/incoming-load) (node/put-key :mir/index (node/i64-value index)) (node/put-key :mir/dst (kw :x86-64/rax))))
(defn- reentry [parameters [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (node/put-key (instruction :mir/reentry) :mir/parameters parameters))
(defn- recur-call [arguments [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (node/put-key (instruction :mir/recur) :mir/arguments arguments))
(defn- label [] [:ref :gmir.node/value] (node/put-key (instruction :mir/label) :mir/id (kw :test/loop)))
(defn- call [tail :bool callee :string arguments [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (let [value (-> (instruction (if tail :mir/tail-call :mir/call)) (node/put-key :mir/callee (name callee)) (node/put-key :mir/arguments arguments))]
    (if tail value (node/put-key value :mir/dst (kw :x86-64/rax)))))
(defn- runtime [operation :keyword arguments [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (instruction :mir/runtime-call) (node/put-key :mir/dst (kw :x86-64/rax)) (node/put-key :mir/runtime (kw operation))
      (node/put-key :mir/arguments arguments)
      (node/put-key :mir/context-offset (node/i64-value (option-value-of [:option :i64] (catalog/offset-of (catalog/runtime-context-offsets) operation) -1)))))
(defn- parameters [count :i64] [:ref :gmir.node/value]
  (let [bank (option-value-of [:option [:list :keyword]] (catalog/registers-for (catalog/call-argument-registers) :x86-64 :all) (typed-list-new [:list :keyword]))]
    (loop [index 0 out (node/empty-vector)]
      (if (>= index count) out (recur (+ index 1) (node/append out (kw (typed-list-nth [:list :keyword] bank index))))))))
(defn- entry-code [count :i64] [:ref :gmir.node/value]
  (let [bank (option-value-of [:option [:list :keyword]] (catalog/registers-for (catalog/call-argument-registers) :x86-64 :all) (typed-list-new [:list :keyword]))
        register-count (if (< count 5) count 5)]
    (loop [index 0 out (node/empty-vector)]
      (if (>= index count) out
        (recur (+ index 1) (node/append out (if (< index register-count) (argument (typed-list-nth [:list :keyword] bank index) index) (incoming index))))))))
(defn- function [id :string arity [:ref :gmir.node/value] virtual :bool policy :keyword slots :i64 code [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (let [value (-> (node/empty-map) (node/put-key :mir/name (name id)) (node/put-key :mir/arity arity) (node/put-key :mir/instructions code))]
    (if virtual value (-> value (node/put-key :mir/frame-policy (kw policy)) (node/put-key :mir/frame-slots (node/i64-value slots))))))
(defn- physical [id :string arity :i64 policy :keyword slots :i64 code [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (function id (node/i64-value arity) false policy slots code))
(defn- virtual [id :string arity :i64 code [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (function id (node/i64-value arity) true :unused 0 code))
(defn- module [virtual :bool functions [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-map) (node/put-key :mir/version (node/i64-value 3)) (node/put-key :mir/target (kw :x86-64))
      (node/put-key :mir/registers (kw (if virtual :virtual :physical))) (node/put-key :mir/entry (name "f")) (node/put-key :mir/functions functions)))
(defn- single [virtual :bool function [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (module virtual (node/append (node/empty-vector) function)))
(defn- data [key :keyword value [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-map) (node/put-key :function (name "f")) (node/put-key key value)))
(defn- arity-data [call [:ref :gmir.node/value] expected [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (node/put-key (data :call call) :expected expected))
(defn- stack-data [call [:ref :gmir.node/value] stores [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (node/put-key (data :call call) :stores stores))

(defn- boundaries? [] :bool
  (let [f (virtual "f" 0 (node/empty-vector)) good (single true f)
        extra (node/put-key good :extra (node/nil-value))
        duplicate (module true (sequence2 f f)) names (sequence2 (name "f") (name "f"))
        missing (node/put-key good :mir/entry (name "missing"))
        bad-function (node/put-key f :extra (node/i64-value 1))
        bad-arity (node/node :i64 0 (option-none-of [:option [:ref :gmir.node/text]]) (node/string-text "extra") (node/empty-children))
        nominal (node/put-key f :mir/arity bad-arity)]
    (and (ok? good) (refused? extra :non-canonical-module extra)
         (refused? duplicate :invalid-module-functions (-> (node/empty-map) (node/put-key :entry (name "f")) (node/put-key :names names)))
         (refused? missing :invalid-module-functions (-> (node/empty-map) (node/put-key :entry (name "missing"))
           (node/put-key :names (node/append (node/empty-vector) (name "f")))))
         (refused? (single true bad-function) :non-canonical-function bad-function)
         (refused? (single true nominal) :non-canonical-value bad-arity)
         (let [empty (module true (node/empty-vector))] (refused? empty :non-canonical-module empty))
         (let [bad (node/put-key good :mir/target (kw :unknown))] (refused? bad :non-canonical-module bad)))))
(defn- entry-and-policy? [] :bool
  (let [good (physical "f" 1 :allocator 0 (entry-code 1))
        wrong-argument (argument :x86-64/rsi 0) wrong (physical "f" 1 :allocator 0 (node/append (node/empty-vector) wrong-argument))
        too-far (physical "f" 5 :allocator 0 (node/append (entry-code 5) (incoming 5)))
        policy (physical "f" 0 :all-vregs 0 (node/empty-vector))
        fuel (runtime :fuel-charge (node/empty-vector)) bad-call (physical "f" 0 :allocator 0 (node/append (node/empty-vector) fuel))
        bad-instruction (constant :x86-64/r9)]
    (and (ok? (single false good))
         (refused? (single false wrong) :entry-argument-profile-violation (data :arguments (node/append (node/empty-vector) wrong-argument)))
         (refused? (single false too-far) :entry-argument-profile-violation (data :arguments (entry-code 5)))
         (refused? (single false policy) :call-frame-policy-violation policy)
         (refused? (single false bad-call) :call-frame-policy-violation bad-call)
         (refused? (single false (physical "f" 0 :allocator 0 (node/append (node/empty-vector) bad-instruction))) :register-profile-violation bad-instruction))))
(defn- transport-code [] [:ref :gmir.node/value]
  (let [p (sequence2 (kw :x86-64/rsi) (kw :x86-64/rdi))]
    (-> (entry-code 2) (node/append (spill false :x86-64/rdi 0)) (node/append (move :x86-64/rdi :x86-64/rsi))
        (node/append (spill true :x86-64/rsi 0)) (node/append (reentry p)) (node/append (recur-call p)))))
(defn- reentries? [] :bool
  (let [p (node/append (node/empty-vector) (kw :x86-64/rbx))
        good-code (-> (entry-code 1) (node/append (move :x86-64/rbx :x86-64/rdi)) (node/append (reentry p)) (node/append (recur-call p)))
        good (physical "f" 1 :call-live 0 good-code)
        swapped (physical "f" 2 :call-live 1 (transport-code))
        wrong-p (sequence2 (kw :x86-64/rdi) (kw :x86-64/rsi))
        wrong-code (-> (entry-code 2) (node/append (spill false :x86-64/rdi 0)) (node/append (move :x86-64/rdi :x86-64/rsi))
                       (node/append (spill true :x86-64/rsi 0)) (node/append (reentry wrong-p)) (node/append (recur-call wrong-p)))
        wrong (physical "f" 2 :call-live 1 wrong-code)
        unknown-code (-> (entry-code 1) (node/append (move :x86-64/rbx :x86-64/r12)) (node/append (reentry p)) (node/append (recur-call p)))
        unknown (physical "f" 1 :call-live 0 unknown-code)
        orphan (physical "f" 1 :allocator 0 (node/append (entry-code 1) (reentry (parameters 1))))
        bad-termination (physical "f" 1 :call-live 0 (node/append good-code (constant :x86-64/rax)))
        duplicate (physical "f" 1 :call-live 0 (node/append good-code (reentry p)))
        forbidden-code (-> (entry-code 1) (node/append (constant :x86-64/rbx)) (node/append (reentry p)) (node/append (recur-call p)))
        forbidden (physical "f" 1 :call-live 0 forbidden-code)
        mismatched (physical "f" 1 :call-live 0 (-> (entry-code 1) (node/append (reentry (parameters 1))) (node/append (recur-call p))))
        empty (physical "f" 0 :call-live 0 (sequence2 (reentry (node/empty-vector)) (recur-call (node/empty-vector))))
        nil-dst (node/put-key (move :x86-64/rbx :x86-64/rdi) :mir/dst (node/nil-value))
        nil-src (node/put-key (move :x86-64/rbx :x86-64/rdi) :mir/src (node/nil-value))
        nil-home (physical "f" 1 :call-live 0 (-> (entry-code 1) (node/append nil-dst) (node/append nil-src)
                                                  (node/append (reentry p)) (node/append (recur-call p))))]
    (and (ok? (single false good)) (ok? (single false swapped))
         (ok? (single false (physical "f" 1 :call-live 0 (node/append good-code (label)))))
         (refused? (single false wrong) :invalid-direct-reentry-contract wrong)
         (refused? (single false unknown) :invalid-direct-reentry-contract unknown)
         (refused? (single false orphan) :invalid-direct-reentry-contract orphan)
         (refused? (single false bad-termination) :invalid-direct-reentry-contract bad-termination)
         (refused? (single false duplicate) :invalid-direct-reentry-contract duplicate)
         (refused? (single false forbidden) :invalid-direct-reentry-contract forbidden)
         (refused? (single false mismatched) :invalid-direct-reentry-contract mismatched)
         (ok? (single false empty)) (ok? (single false nil-home)))))
(defn- backed-and-parallel? [] :bool
  (let [value (constant :x86-64/rax) store (spill false :x86-64/rax 0)
        fuel (runtime :fuel-charge (node/empty-vector))
        good-code (-> (node/empty-vector) (node/append value) (node/append store) (node/append fuel) (node/append store))
        good (physical "f" 0 :all-vregs 1 good-code)
        unbacked (physical "f" 0 :all-vregs 1 (sequence2 value fuel))
        pair-args (sequence2 (kw :x86-64/rsi) (kw :x86-64/rdx))
        pair (runtime :pair pair-args)
        pair-code (-> (node/empty-vector) (node/append value) (node/append store) (node/append (spill true :x86-64/rsi 0))
                      (node/append (spill true :x86-64/rdx 0)) (node/append pair) (node/append store))
        bad-prefix (-> (node/empty-vector) (node/append value) (node/append store) (node/append (spill true :x86-64/rsi 0))
                       (node/append pair) (node/append store))
        reversed (-> (node/empty-vector) (node/append value) (node/append store) (node/append (spill true :x86-64/rdx 0))
                     (node/append (spill true :x86-64/rsi 0)) (node/append pair) (node/append store))]
    (and (ok? (single false good))
         (refused? (single false unbacked) :unbacked-call-frame-value (data :instruction value))
         (ok? (single false (physical "f" 0 :all-vregs 1 pair-code)))
         (refused? (single false (physical "f" 0 :all-vregs 1 bad-prefix)) :non-parallel-call-arguments (data :call pair))
         (refused? (single false (physical "f" 0 :all-vregs 1 reversed)) :non-parallel-call-arguments (data :call pair))
         (let [bad (physical "f" 0 :all-vregs 1 (-> (node/empty-vector) (node/append value) (node/append store) (node/append fuel)))]
           (refused? (single false bad) :unbacked-call-frame-value (data :instruction fuel))))))
(defn- linkage? [] :bool
  (let [virtual-call (-> (instruction :mir/call) (node/put-key :mir/callee (name "g")) (node/put-key :mir/dst (v))
                         (node/put-key :mir/arguments (node/append (node/empty-vector) (v))))
        f (virtual "f" 0 (node/append (node/empty-vector) virtual-call))
        g (virtual "g" 1 (node/empty-vector)) g2 (virtual "g" 2 (node/empty-vector))
        invalid-g (node/put-key g :mir/arity (node/bool-value true))
        physical-call (call false "g" (parameters 5))
        physical-f (physical "f" 0 :call-live 0 (node/append (node/empty-vector) physical-call))
        physical-g (physical "g" 5 :allocator 0 (entry-code 5))
        invalid-physical-g (node/put-key physical-g :mir/arity (node/bool-value true))
        fractional-g (node/put-key physical-g :mir/arity (node/f64-bits-value 0x4019000000000000))
        fractional-f (physical "f" 0 :call-live 0 (-> (node/empty-vector) (node/append (area-store false 5))
                          (node/append (area-store false 6)) (node/append physical-call)))
        nan-g (node/put-key physical-g :mir/arity (node/f64-bits-value 0x7ff8000000000001))]
    (and (ok? (module true (sequence2 f g)))
         (refused? (single true f) :unresolved-callee virtual-call)
         (refused? (module true (sequence2 f g2)) :call-arity-mismatch (arity-data virtual-call (node/i64-value 2)))
         (refused? (module true (sequence2 f invalid-g)) :call-arity-mismatch (arity-data virtual-call (node/bool-value true)))
         (ok? (module false (sequence2 physical-f physical-g)))
         (refused? (module false (sequence2 physical-f invalid-physical-g)) :call-arity-mismatch (arity-data physical-call (node/bool-value true)))
         ;; 6.25 needs stores for 5 and 6 in the reference range. The earlier
         ;; call passes; only then does the later function's arity get refused.
         (refused? (module false (sequence2 fractional-f fractional-g)) :non-canonical-function fractional-g)
         (refused? (module false (sequence2 physical-f nan-g)) :call-arity-mismatch (arity-data physical-call (node/f64-bits-value 0x7ff8000000000001))))))
(defn- stack-profiles? [] :bool
  (let [direct (call false "g" (parameters 5)) tail (call true "g" (parameters 5))
        outgoing (area-store false 5) incoming-store (area-store true 5)
        g (physical "g" 6 :allocator 0 (entry-code 6)) g7 (physical "g" 7 :allocator 0 (entry-code 7))
        f (physical "f" 0 :call-live 0 (sequence2 outgoing direct))
        tail-f (physical "f" 0 :call-live 0 (sequence2 incoming-store tail))
        orphan (physical "f" 0 :allocator 0 (node/append (node/empty-vector) outgoing))
        duplicate (physical "f" 0 :call-live 0 (-> (node/empty-vector) (node/append outgoing) (node/append outgoing) (node/append direct)))
        second-call (physical "f" 0 :call-live 0 (-> (node/empty-vector) (node/append outgoing) (node/append direct) (node/append direct)))
        fuel (runtime :fuel-charge (node/empty-vector))
        recur-args (parameters 5)
        recur-code (-> (entry-code 5) (node/append (reentry recur-args)) (node/append (incoming 5))
                       (node/append incoming-store) (node/append (recur-call recur-args)))
        recur-bad (-> (entry-code 5) (node/append (reentry recur-args)) (node/append (incoming 5))
                      (node/append outgoing) (node/append (recur-call recur-args)))]
    (and (ok? (module false (sequence2 f g))) (ok? (module false (sequence2 tail-f g)))
         (refused? (single false orphan) :stack-argument-profile-violation (data :stores (node/append (node/empty-vector) outgoing)))
         (refused? (module false (sequence2 duplicate g7)) :stack-argument-profile-violation (stack-data direct (sequence2 outgoing outgoing)))
         (refused? (module false (sequence2 (physical "f" 0 :call-live 0 (sequence2 outgoing tail)) g))
           :stack-argument-profile-violation (stack-data tail (node/append (node/empty-vector) outgoing)))
         (refused? (module false (sequence2 second-call g)) :stack-argument-profile-violation (stack-data direct (node/empty-vector)))
         (refused? (single false (physical "f" 0 :call-live 0 (sequence2 outgoing fuel)))
           :stack-argument-profile-violation (stack-data fuel (node/append (node/empty-vector) outgoing)))
         (ok? (single false (physical "f" 6 :call-live 0 recur-code)))
         (refused? (single false (physical "f" 6 :call-live 0 recur-bad)) :stack-argument-profile-violation
           (stack-data (recur-call recur-args) (node/append (node/empty-vector) outgoing))))))
(defn- dispatch-and-existing-rules? [] :bool
  (let [old (-> (node/empty-map) (node/put-key :mir/version (node/i64-value 1)) (node/put-key :mir/target (kw :x86-64))
                (node/put-key :mir/registers (kw :virtual)) (node/put-key :mir/instructions (node/empty-vector)))
        privileged (-> (instruction :mir/x86-privileged) (node/put-key :mir/dst (kw :x86-64/rax)) (node/put-key :mir/action (kw :boot-info))
                       (node/put-key :mir/arguments (node/empty-vector)))
        unresolved-address (-> (instruction :mir/function-address) (node/put-key :mir/dst (v)) (node/put-key :mir/function (name "not-declared")))]
    (and (ok? old)
         ;; These are the owning validator's existing admission rules. The
         ;; transcription does not invent new frame or linkage checks.
         (ok? (single false (physical "f" 0 :allocator 0 (node/append (node/empty-vector) privileged))))
         (ok? (single true (virtual "f" 0 (node/append (node/empty-vector) unresolved-address)))))))
(defn- aarch64? [] :bool
  (let [p (node/append (node/empty-vector) (kw :aarch64/x19))
        code (-> (node/empty-vector) (node/append (argument :aarch64/x0 0)) (node/append (move :aarch64/x19 :aarch64/x0))
                 (node/append (reentry p)) (node/append (recur-call p)))
        good (node/put-key (single false (physical "f" 1 :call-live 0 code)) :mir/target (kw :aarch64))
        wrong-argument (argument :aarch64/x1 0)
        bad (node/put-key (single false (physical "f" 1 :allocator 0 (node/append (node/empty-vector) wrong-argument))) :mir/target (kw :aarch64))
        direct (node/put-key (call false "g" (node/append (node/empty-vector) (kw :aarch64/x0))) :mir/dst (kw :aarch64/x0))
        f (physical "f" 0 :call-live 0 (node/append (node/empty-vector) direct))
        g (physical "g" 1 :allocator 0 (node/append (node/empty-vector) (argument :aarch64/x0 0)))
        linked (node/put-key (module false (sequence2 f g)) :mir/target (kw :aarch64))]
    (and (ok? good) (ok? linked)
         (refused? bad :entry-argument-profile-violation (data :arguments (node/append (node/empty-vector) wrong-argument))))))
(defn main [] :i64
  (cond (not (boundaries?)) 1 (not (entry-and-policy?)) 2 (not (reentries?)) 3
        (not (backed-and-parallel?)) 4 (not (linkage?)) 5 (not (stack-profiles?)) 6
        (not (dispatch-and-existing-rules?)) 7 (not (aarch64?)) 8 :else 0))
(defn large-main [] :i64
  (let [value (-> (instruction :mir/constant) (node/put-key :mir/dst (v)) (node/put-key :mir/value (node/i64-value 1)))
        code (loop [index 0 out (node/empty-vector)]
               (if (>= index 16385) out (recur (+ index 1) (node/append out value))))]
    (if (ok? (single true (virtual "f" 0 code))) 0 1)))
(defn large-reentry-main [] :i64
  (let [copy (move :x86-64/rdi :x86-64/rdi) p (parameters 1)
        prefix (loop [index 0 out (entry-code 1)]
                 (if (>= index 16385) out (recur (+ index 1) (node/append out copy))))
        code (-> prefix (node/append (reentry p)) (node/append (recur-call p)))]
    (if (ok? (single false (physical "f" 1 :call-live 0 code))) 0 1)))
