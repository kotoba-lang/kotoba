;; Native full-data scheduling self-checks. Modeled cycles are not
;; measurements, and the complete upstream/allocator/resource corpus is open.
(ns kotoba.mir-schedule-cases
  {:kotoba/export [main large-main]}
  (:require [kotoba.gmir :as gmir] [kotoba.gmir.node :as node]
            [kotoba.mir.operands :as operands] [kotoba.mir.schedule :as schedule]
            [kotoba.mir.table :as table] [kotoba.mir.outcome :as outcome]
            [kotoba.mir-module-cases :as check]))

(defn- at [value [:ref :gmir.node/value] index :i64] [:ref :gmir.node/value]
  (option-match [:option [:ref :gmir.node/value]] (node/child value index) (node/nil-value) item item))
(defn- kw [value :keyword] [:ref :gmir.node/value] (node/keyword-literal value))
(defn- add-key [values [:list :keyword] key :keyword] [:list :keyword] (typed-list-conj [:list :keyword] values key))
(defn- v [index :i64] [:ref :gmir.node/value]
  (result-value-of [:result [:ref :gmir.node/value] [:ref :gmir/refusal]] (gmir/vreg (node/i64-value index)) (node/nil-value)))
(defn- binary [op :keyword dst [:ref :gmir.node/value] a [:ref :gmir.node/value] b [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-map) (node/put-key :mir/op (kw op)) (node/put-key :mir/dst dst) (node/put-key :mir/left a) (node/put-key :mir/right b)))
(defn- four [a [:ref :gmir.node/value] b [:ref :gmir.node/value] c [:ref :gmir.node/value] d [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-vector) (node/append a) (node/append b) (node/append c) (node/append d)))
(defn- order [a :i64 b :i64 c :i64 d :i64] [:ref :gmir.node/value]
  (four (node/i64-value a) (node/i64-value b) (node/i64-value c) (node/i64-value d)))
(defn- chain [] [:ref :gmir.node/value]
  (four (binary :mir/multiply (v 4) (v 0) (v 1)) (binary :mir/multiply (v 6) (v 4) (v 2))
        (binary :mir/add (v 5) (v 2) (v 3)) (binary :mir/add (v 7) (v 6) (v 5))))
(defn- result=? [result [:result [:ref :gmir.node/value] [:ref :mir/refusal]] expected [:ref :gmir.node/value]] :bool
  (and (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result)
       (check/same-value? (result-value-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result (node/nil-value)) expected)))
(defn- score=? [result [:result :i64 [:ref :mir/refusal]] expected :i64] :bool
  (and (result-ok?-of [:result :i64 [:ref :mir/refusal]] result) (= (result-value-of [:result :i64 [:ref :mir/refusal]] result -1) expected)))
(defn- dependency-gap? [target :keyword] :bool
  (let [code (chain) original (order 0 1 2 3) expected (order 0 2 1 3)
        permuted (four (at code 0) (at code 2) (at code 1) (at code 3))
        before (schedule/segment-completion-times target code original)
        after (schedule/segment-completion-times target code expected)]
    (and (result=? (schedule/schedule-integer-segment-indices target code) expected)
         (result=? (schedule/schedule-instructions target code) permuted)
         (result=? (schedule/schedule-instructions target code) permuted)
         (schedule/valid-scheduled-segment? target code expected)
         (not (schedule/valid-scheduled-segment? target code (order 2 1 0 3)))
         (result=? before (order 3 6 5 7)) (result=? after (order 3 6 2 7))
         (score=? (schedule/segment-sum-completion-times target code original) 21)
         (score=? (schedule/segment-sum-completion-times target code expected) 18))))
(defn- hazards? [waw :bool] :bool
  (let [r0 (kw :aarch64/x0) r1 (kw :aarch64/x1) r2 (kw :aarch64/x2) r3 (kw :aarch64/x3)
        r4 (kw :aarch64/x4) r5 (kw :aarch64/x5) r6 (kw :aarch64/x6) r7 (kw :aarch64/x7)
        first (if waw (binary :mir/add r0 r1 r2) (binary :mir/add r2 r0 r1))
        code (four first (binary :mir/add r3 r4 r5) (binary :mir/multiply r0 r4 r5) (binary :mir/multiply r6 r0 r7))
        result (schedule/schedule-integer-segment-indices :aarch64 code)]
    (and (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result)
         (schedule/valid-scheduled-segment? :aarch64 code (result-value-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result (node/nil-value)))
         (not (schedule/valid-scheduled-segment? :aarch64 code (order 2 0 1 3))))))
(defn- duplicate-and-rejection? [] :bool
  (let [reg (kw :x86-64/rdi) same (binary :mir/add reg reg reg)
        code (-> (node/empty-vector) (node/append same) (node/append same))
        good (-> (node/empty-vector) (node/append (node/i64-value 0)) (node/append (node/i64-value 1)))
        bad (-> (node/empty-vector) (node/append (node/i64-value 0)) (node/append (node/i64-value 0)))
        reversed (-> (node/empty-vector) (node/append (node/i64-value 1)) (node/append (node/i64-value 0)))
        list-order (-> (node/empty-list) (node/append (node/integer-value (node/string-text "0"))) (node/append (node/i64-value 1)))
        bytes-order (node/bytes-value (node/text (typed-list-conj [:list :bytes] (typed-list-new [:list :bytes]) (bytes-from-vector-i64 [0 1]))))
        result (schedule/segment-completion-times :x86-64 code reversed)
        error (result-error-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result (outcome/refusal :unexpected-success (node/nil-value)))]
    (and (schedule/valid-scheduled-segment? :x86-64 code good)
         (schedule/valid-scheduled-segment? :x86-64 code list-order)
         (schedule/valid-scheduled-segment? :x86-64 code bytes-order)
         (not (schedule/valid-scheduled-segment? :x86-64 code (-> (node/empty-vector) (node/append (node/i64-value -1)) (node/append (node/i64-value 0)))))
         (not (schedule/valid-scheduled-segment? :x86-64 code (-> (node/empty-vector) (node/append (node/i64-value 0)) (node/append (node/i64-value 2)))))
         (not (schedule/valid-scheduled-segment? :x86-64 code (-> (node/empty-vector) (node/append (node/f64-bits-value 0)) (node/append (node/i64-value 1)))))
         (not (schedule/valid-scheduled-segment? :x86-64 code bad))
         (not (schedule/valid-scheduled-segment? :x86-64 code reversed))
         (not (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result))
         (= (outcome/phase error) :mir) (= (outcome/problem error) :schedule-violates-register-dependencies)
         (string=? (outcome/message error) "MIR rejected: schedule-violates-register-dependencies")
         (check/same-value? (outcome/instruction error) (-> (node/empty-map) (node/put-key :segment code) (node/put-key :scheduled-indexes reversed)))
         (result=? (schedule/schedule-integer-segment-indices :x86-64 (node/empty-vector)) (node/empty-vector))
         (result=? (schedule/schedule-integer-segment-indices :x86-64 (node/append (node/empty-vector) same)) (node/append (node/empty-vector) (node/i64-value 0))))))
(defn- protected-pair? [subtract :bool] :bool
  (let [multiply (binary :mir/multiply (v 4) (v 0) (v 1))
        consume (if subtract (binary :mir/subtract (v 5) (v 2) (v 4)) (binary :mir/add (v 5) (v 4) (v 2)))
        code (four multiply consume (binary :mir/add (v 6) (v 2) (v 3)) (binary :mir/add (v 7) (v 5) (v 6)))]
    (result=? (schedule/schedule-instructions :aarch64 code) code)))
(defn- all-barriers? [target :keyword] :bool
  (let [barriers (-> (typed-list-new [:list :keyword])
                   (add-key :mir/constant) (add-key :mir/quotient)
                   (add-key :mir/kernel-load-u8) (add-key :mir/call)
                   (add-key :mir/runtime-call) (add-key :mir/capability-call)
                   (add-key :mir/branch-zero) (add-key :mir/branch-nonzero)
                   (add-key :mir/return) (add-key :mir/spill-store)
                   (add-key :mir/spill-load) (add-key :mir/move)
                   (add-key :mir/label) (add-key :mir/phi)
                   (add-key :mir/multiply-add) (add-key :mir/multiply-subtract))
        code (chain)]
    (loop [index 0]
      (if (>= index (vector-count barriers)) true
        (let [barrier (node/put-key (node/empty-map) :mir/op (kw (typed-list-nth [:list :keyword] barriers index)))
              input (-> (node/empty-vector) (node/append (at code 0)) (node/append barrier)
                        (node/append (at code 1)) (node/append (at code 2)) (node/append (at code 3)))]
          (if (result=? (schedule/schedule-instructions target input) input) (recur (+ index 1)) false))))))
(defn- operands? [] :bool
  (let [expected (v 9)
        compare (-> (node/empty-map) (node/put-key :mir/op (kw :mir/kernel-cmpxchg-u64))
                    (node/put-key :mir/base (v 0)) (node/put-key :mir/length (v 1)) (node/put-key :mir/index (v 2))
                    (node/put-key :mir/stored (v 3)) (node/put-key :mir/expected expected))
        sources (operands/instruction-sources compare)
        incoming (node/put-key (node/empty-map) :mir/value (v 3))
        phi (node/put-key (node/empty-map) :mir/incomings (-> (node/empty-vector) (node/append incoming) (node/append incoming)))
        uses (operands/counts :aarch64 false (-> (node/empty-vector) (node/append compare) (node/append phi)))
        immediate (node/put-key (node/empty-map) :mir/value (node/integer-value (node/string-text "9223372036854775807")))
        raw (operands/instruction-sources immediate)]
    (and (check/same-value? sources (-> (node/empty-vector) (node/append (v 0)) (node/append (v 1)) (node/append expected) (node/append (v 3)) (node/append (v 2))))
         (= (operands/count-of uses expected) 1) (= (operands/count-of uses (v 3)) 3)
         (= (node/child-count raw) 1) (check/same-value? (at raw 0) (node/key immediate :mir/value))
         (= (table/count (operands/counts :x86-64 true (node/append (node/empty-vector) immediate))) 0))))
(defn- many-readers [count :i64] [:ref :gmir.node/value]
  (let [read (binary :mir/add (kw :aarch64/x1) (kw :aarch64/x0) (kw :aarch64/x2))
        prefix (loop [index 0 out (node/empty-vector)]
                 (if (>= index count) out (recur (+ index 1) (node/append out read))))]
    (node/append prefix (binary :mir/multiply (kw :aarch64/x0) (kw :aarch64/x3) (kw :aarch64/x4)))))
(defn- fan-in? [count :i64] :bool
  (let [code (many-readers count) graph (schedule/segment-predecessors :aarch64 code)
        entry (table/get graph (table/index-key count))
        inputs (table/members (option-value-of [:option [:ref :mir.table/value]] entry (table/scalar (node/nil-value))))]
    (and (= (table/count graph) (+ count 1)) (table/valid? graph)
         (option-some?-of [:option [:ref :mir.table/value]] entry)
         (= (table/count inputs) count) (table/valid? inputs)
         (loop [index 0]
           (if (>= index count) true
             (let [value (table/value-at inputs index)]
               (if (and (option-some?-of [:option [:ref :mir.table/value]] value)
                        (= (node/number (table/data (option-value-of [:option [:ref :mir.table/value]] value (table/scalar (node/i64-value -1))))) index))
                 (recur (+ index 1)) false)))))))
(defn main [] :i64
  (cond (not (and (dependency-gap? :x86-64) (dependency-gap? :aarch64))) 1
        (not (and (hazards? false) (hazards? true))) 2 (not (duplicate-and-rejection?)) 3
        (not (and (protected-pair? false) (protected-pair? true))) 4
        (not (and (all-barriers? :x86-64) (all-barriers? :aarch64))) 5 (not (operands?)) 6 (not (fan-in? 64)) 7 :else 0))
(defn large-main [] :i64 (if (fan-in? 16385) 0 1))
