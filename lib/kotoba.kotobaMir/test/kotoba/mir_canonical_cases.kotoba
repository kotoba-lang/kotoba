;; Native whole-MIR self-check aggregate. Public target/CI admission remains open.
(ns kotoba.mir-canonical-cases
  {:kotoba/export [main large-main catalog-main flat-main module-main table-main selection-main schedule-main counted-main allocator-main
                   module-large-main reentry-large-main table-large-main schedule-large-main counted-large-main allocator-large-main]}
  (:require [kotoba.mir-catalog-cases :as catalog]
            [kotoba.mir-flat-cases :as flat]
            [kotoba.mir-module-cases :as module]
            [kotoba.mir-table-cases :as table]
            [kotoba.mir-selection-cases :as selection]
            [kotoba.mir-schedule-cases :as schedule]
            [kotoba.mir-counted-cases :as counted] [kotoba.mir-allocator-cases :as allocator]))

;; The same whole linked image exposes component entries for exact failure
;; localization. Aggregate entries retain every case and their original order.
(defn catalog-main [] :i64 (arena-scope (catalog/main)))
(defn flat-main [] :i64 (arena-scope (flat/main)))
(defn module-main [] :i64 (arena-scope (module/main)))
(defn table-main [] :i64 (arena-scope (table/main)))
(defn selection-main [] :i64 (arena-scope (selection/main)))
(defn schedule-main [] :i64 (arena-scope (schedule/main)))
(defn counted-main [] :i64 (arena-scope (counted/main)))
(defn allocator-main [] :i64 (arena-scope (allocator/main)))
(defn module-large-main [] :i64 (arena-scope (module/large-main)))
(defn reentry-large-main [] :i64 (arena-scope (module/large-reentry-main)))
(defn table-large-main [] :i64 (arena-scope (table/large-main)))
(defn schedule-large-main [] :i64 (arena-scope (schedule/large-main)))
(defn counted-large-main [] :i64 (arena-scope (counted/large-main)))
(defn allocator-large-main [] :i64 (arena-scope (allocator/large-main)))

(defn main [] :i64
  (let [catalog-result (arena-scope (catalog/main))]
    (if (not= catalog-result 0) (+ 100 catalog-result)
      (let [flat-result (arena-scope (flat/main))]
        (if (not= flat-result 0) (+ 200 flat-result)
          (let [module-result (arena-scope (module/main))]
            (if (not= module-result 0) (+ 300 module-result)
              (let [table-result (arena-scope (table/main))]
                (if (not= table-result 0) (+ 600 table-result)
                  (let [selection-result (arena-scope (selection/main))]
                    (if (not= selection-result 0) (+ 700 selection-result)
                      (let [schedule-result (arena-scope (schedule/main))]
                        (if (not= schedule-result 0) (+ 800 schedule-result)
                          (let [counted-result (arena-scope (counted/main))]
                            (if (not= counted-result 0) (+ 1100 counted-result)
                              (let [allocator-result (arena-scope (allocator/main))]
                                (if (not= allocator-result 0) (+ 1300 allocator-result) 0)))))))))))))))))
(defn large-main [] :i64
  (let [module-result (arena-scope (module/large-main))]
    (if (not= module-result 0) (+ 400 module-result)
      (let [reentry-result (arena-scope (module/large-reentry-main))]
        (if (not= reentry-result 0) (+ 500 reentry-result)
          (let [table-result (arena-scope (table/large-main))]
            (if (not= table-result 0) (+ 900 table-result)
              (let [schedule-result (arena-scope (schedule/large-main))]
                (if (not= schedule-result 0) (+ 1000 schedule-result)
                  (let [counted-result (arena-scope (counted/large-main))]
                    (if (not= counted-result 0) (+ 1200 counted-result)
                      (let [allocator-result (arena-scope (allocator/large-main))]
                        (if (not= allocator-result 0) (+ 1400 allocator-result) 0)))))))))))))
