;; Native self-check source only. Not compiled or executed, and not a substitute
;; for the whole upstream validator/module/allocator/resource corpus.
(ns kotoba.mir-flat-cases
  {:kotoba/export [main]}
  (:require [kotoba.gmir.node :as node] [kotoba.gmir.catalog :as gmir-catalog]
            [kotoba.mir.catalog :as catalog] [kotoba.mir.flat :as flat]
            [kotoba.mir.outcome :as outcome]))

(defn- at [value [:ref :gmir.node/value] index :i64] [:ref :gmir.node/value]
  (option-match [:option [:ref :gmir.node/value]] (node/child value index) (node/nil-value) item item))
(defn- kw [value :keyword] [:ref :gmir.node/value] (node/keyword-literal value))
(defn- named? [value [:ref :gmir.node/value] expected :keyword] :bool (node/same-name? value (kw expected)))
(defn- function-name [] [:ref :gmir.node/value]
  (node/symbol-parts (option-none-of [:option [:ref :gmir.node/text]]) (node/string-text "f")))
(defn- virtual-register [] [:ref :gmir.node/value] (kw :kotoba.gmir.vreg/0))
(defn- register [target :keyword] [:ref :gmir.node/value] (kw (if (= target :x86-64) :x86-64/rax :aarch64/x0)))
(defn- bank [table [:list [:ref :mir.catalog/bank]] target :keyword kind :keyword] [:list :keyword]
  (option-value-of [:option [:list :keyword]] (catalog/registers-for table target kind) (typed-list-new [:list :keyword])))
(defn- bank-prefix [values [:list :keyword] count :i64 list :bool] [:ref :gmir.node/value]
  (loop [index 0 out (if list (node/empty-list) (node/empty-vector))]
    (if (>= index count) out
      (recur (+ index 1) (node/append out (kw (typed-list-nth [:list :keyword] values index)))))))
(defn- instruction [op :keyword] [:ref :gmir.node/value] (node/put-key (node/empty-map) :mir/op (kw op)))
(defn- label [] [:ref :gmir.node/value] (node/put-key (instruction :mir/label) :mir/id (kw :test/entry)))
(defn- program [version :i64 target :keyword virtual :bool code [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (let [base (-> (node/empty-map) (node/put-key :mir/version (node/i64-value version))
                (node/put-key :mir/target (kw target)) (node/put-key :mir/registers (kw (if virtual :virtual :physical)))
                (node/put-key :mir/instructions code))]
    (if virtual base (node/put-key base :mir/frame-slots (node/i64-value 1)))))
(defn- single [version :i64 target :keyword virtual :bool value [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (program version target virtual (node/append (node/empty-vector) value)))
(defn- accepted? [value [:ref :gmir.node/value]] :bool
  (arena-scope (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (flat/validate! value))))
(defn- refusal [value [:ref :gmir.node/value]] [:ref :mir/refusal]
  (result-error-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] (flat/validate! value)
    (outcome/refusal :unexpected-success value)))
(defn- rejected? [value [:ref :gmir.node/value] expected :keyword] :bool
  (arena-scope
    (let [error (refusal value)]
      (and (= (outcome/phase error) :mir) (= (outcome/problem error) expected)
           (string=? (outcome/message error) (string-concat "MIR rejected: " (keyword-name expected)))))))
(defn- field [op :keyword target :keyword name :keyword] [:ref :gmir.node/value]
  (cond
    (= name :mir/op) (kw op)
    (or (= name :mir/id) (= name :mir/target)) (kw :test/entry)
    (or (= name :mir/function) (= name :mir/callee)) (function-name)
    (= name :mir/arguments)
    (cond (= op :mir/runtime-call) (bank-prefix (bank (catalog/runtime-argument-registers) target :all) 2 false)
          (= op :mir/capability-call) (bank-prefix (bank (catalog/capability-argument-registers) target :i64) 1 false)
          (= op :mir/x86-privileged) (node/empty-vector)
          :else (bank-prefix (bank (catalog/call-argument-registers) target :all) 1 false))
    (= name :mir/parameters) (bank-prefix (bank (catalog/call-argument-registers) target :all) 1 false)
    (= name :mir/incomings) (node/empty-vector)
    (= name :mir/runtime) (kw :pair)
    (= name :mir/action) (kw :boot-info)
    (= name :mir/kind) (kw :i64)
    (= name :mir/capability) (node/i64-value 0)
    (= name :mir/context-offset)
    (node/i64-value (option-value-of [:option :i64]
      (catalog/offset-of (if (= op :mir/runtime-call) (catalog/runtime-context-offsets) (catalog/capability-context-offsets))
        (if (= op :mir/runtime-call) :pair :i64)) -1))
    (= name :mir/content) (node/string-value (node/string-text ""))
    (= name :mir/rodata-encoding) (kw :hex-bytes)
    (= name :mir/maximum)
    (node/i64-value (cond (gmir-catalog/keyword-member? (catalog/slice-operations) op) (catalog/slice-item-limit)
                         (or (= op :mir/kernel-dot-f32) (gmir-catalog/keyword-member? (catalog/kernel-dequant-dot-operations) op))
                         (catalog/kernel-dot-f32-maximum) :else 4096))
    (= name :mir/index)
    (cond (= op :mir/argument) (node/i64-value 0)
          (or (= op :mir/incoming-load) (= op :mir/outgoing-argument) (= op :mir/incoming-argument-store)) (node/i64-value 5)
          :else (register target))
    (= name :mir/slot) (node/i64-value 0)
    (= name :mir/divisor) (node/i64-value 2)
    (= name :mir/value) (if (= op :mir/constant) (node/i64-value 1) (register target))
    :else (if (= op :mir/phi) (virtual-register) (register target))))
(defn- from-shape [entry [:ref :mir.catalog/shape] target :keyword omit :keyword] [:ref :gmir.node/value]
  (let [keys (catalog/shape-keys entry) op (catalog/shape-operation entry)]
    (loop [index 0 out (node/empty-map)]
      (if (>= index (vector-count keys)) out
        (let [name (typed-list-nth [:list :keyword] keys index)]
          (recur (+ index 1) (if (= name omit) out (node/put-key out name (field op target name)))))))))
(defn- shape-program [entry [:ref :mir.catalog/shape] target :keyword value [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (let [op (catalog/shape-operation entry) code (if (= op :mir/label) (node/empty-vector) (node/append (node/empty-vector) (label)))]
    (program 3 target (= op :mir/phi) (node/append code value))))
(defn- shapes? [] :bool
  ;; Each of all 104 rows has a positive flat case, every required field is
  ;; removed once, and one extra field is added. Modules are tested separately.
  (let [table (catalog/instruction-keysets)]
    (and (= (vector-count table) 104)
         (loop [index 0]
           (if (>= index (vector-count table)) true
             (let [entry (typed-list-nth [:list [:ref :mir.catalog/shape]] table index)
                   target (if (= (catalog/shape-operation entry) :mir/branch-nonzero) :aarch64 :x86-64)
                   value (from-shape entry target :no-such-field) keys (catalog/shape-keys entry)]
               (if (and (accepted? (shape-program entry target value))
                        (rejected? (shape-program entry target (node/put-key value :extra (node/nil-value))) :non-canonical-instruction)
                        (loop [field-index 0]
                          (if (>= field-index (vector-count keys)) true
                            (if (rejected? (shape-program entry target (from-shape entry target (typed-list-nth [:list :keyword] keys field-index))) :non-canonical-instruction)
                              (recur (+ field-index 1)) false))))
                 (recur (+ index 1)) false)))))))
(defn- runtime-call [target :keyword name :keyword arguments [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (instruction :mir/runtime-call) (node/put-key :mir/dst (register target)) (node/put-key :mir/runtime (kw name))
      (node/put-key :mir/arguments arguments)
      (node/put-key :mir/context-offset (node/i64-value (option-value-of [:option :i64] (catalog/offset-of (catalog/runtime-context-offsets) name) -1)))))
(defn- capability-call [target :keyword kind :keyword id :i64 arguments [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (instruction :mir/capability-call) (node/put-key :mir/dst (register target)) (node/put-key :mir/kind (kw kind))
      (node/put-key :mir/capability (node/i64-value id)) (node/put-key :mir/arguments arguments)
      (node/put-key :mir/context-offset (node/i64-value (option-value-of [:option :i64] (catalog/offset-of (catalog/capability-context-offsets) kind) -1)))))
(defn- runtime-and-capability? [] :bool
  (let [runtimes (gmir-catalog/runtime-operation-arities) kinds (gmir-catalog/capability-kinds)]
    (and
      (loop [index 0]
        (if (>= index (vector-count runtimes)) true
          (let [entry (typed-list-nth [:list [:ref :gmir.catalog/arity]] runtimes index)
                n (gmir-catalog/arity-value entry) name (gmir-catalog/arity-name entry)
                call (runtime-call :x86-64 name (bank-prefix (bank (catalog/runtime-argument-registers) :x86-64 :all) n false))
                list-call (runtime-call :aarch64 name (bank-prefix (bank (catalog/runtime-argument-registers) :aarch64 :all) n true))]
            (if (and (accepted? (single 1 :x86-64 false call)) (accepted? (single 1 :aarch64 false list-call))
                     (rejected? (single 1 :x86-64 false (node/put-key call :mir/context-offset (node/i64-value -1))) :invalid-runtime-call)
                     (rejected? (single 1 :x86-64 false (node/put-key call :mir/arguments (node/i64-value n))) :invalid-runtime-call))
              (recur (+ index 1)) false))))
      (loop [index 0]
        (if (>= index (vector-count kinds)) true
          (let [kind (gmir-catalog/arity-name (typed-list-nth [:list [:ref :gmir.catalog/arity]] kinds index))
                call (capability-call :x86-64 kind 255 (bank-prefix (bank (catalog/capability-argument-registers) :x86-64 kind) 1 true))]
            (if (and (accepted? (single 1 :x86-64 false call))
                     (rejected? (single 1 :x86-64 false (node/put-key call :mir/capability (node/i64-value 256))) :invalid-capability-call)
                     (rejected? (single 1 :x86-64 false (node/put-key call :mir/arguments (node/empty-list))) :invalid-capability-call))
              (recur (+ index 1)) false)))))))
(defn- privileged? [] :bool
  (let [table (gmir-catalog/x86-privileged-action-arities) pool (catalog/privileged-argument-registers :x86-64)]
    (and (= (vector-count table) 55)
         (loop [index 0]
           (if (>= index (vector-count table)) true
             (let [entry (typed-list-nth [:list [:ref :gmir.catalog/arity]] table index)
                   n (gmir-catalog/arity-value entry)
                   call (-> (instruction :mir/x86-privileged) (node/put-key :mir/dst (register :x86-64))
                            (node/put-key :mir/action (kw (gmir-catalog/arity-name entry)))
                            (node/put-key :mir/arguments (bank-prefix pool n false)))
                   other (-> call (node/put-key :mir/dst (register :aarch64))
                                 (node/put-key :mir/arguments (bank-prefix (catalog/privileged-argument-registers :aarch64) n false)))]
               (if (and (accepted? (single 1 :x86-64 false call))
                        (rejected? (single 1 :aarch64 false other) :invalid-x86-privileged)
                        (rejected? (single 1 :x86-64 false (node/put-key call :mir/arguments (bank-prefix pool (+ n 1) false))) :invalid-x86-privileged))
                 (recur (+ index 1)) false)))))))
(defn- register-version-order? [] :bool
  (let [v (virtual-register)
        move (-> (instruction :mir/move) (node/put-key :mir/dst v) (node/put-key :mir/src v))
        branch (-> (instruction :mir/branch-nonzero) (node/put-key :mir/test v) (node/put-key :mir/target (kw :test/entry)))
        reentry (node/put-key (instruction :mir/reentry) :mir/parameters (node/empty-vector))
        arithmetic (-> (instruction :mir/add) (node/put-key :mir/dst v) (node/put-key :mir/left v) (node/put-key :mir/right v))]
    (and (rejected? (single 3 :x86-64 true move) :physical-operation-in-virtual-program)
         (rejected? (single 1 :aarch64 true branch) :non-canonical-instruction)
         (rejected? (single 3 :x86-64 true branch) :target-selected-operation-target-mismatch)
         (rejected? (single 3 :x86-64 true reentry) :direct-reentry-profile-violation)
         (accepted? (single 1 :x86-64 true arithmetic))
         (rejected? (single 1 :x86-64 true (node/put-key arithmetic :mir/left (node/i64-value 0))) :register-profile-violation)
         ;; Preserve reference keep's nil rule. This is an existing admission
         ;; hole, not permission to introduce a new nil register in allocation.
         (accepted? (single 1 :x86-64 true (node/put-key arithmetic :mir/left (node/nil-value))))
         (rejected? (single 1 :x86-64 true (node/put-key arithmetic :extra (node/i64-value 0))) :non-canonical-instruction))))
(defn- v2-projection? [] :bool
  (let [v (virtual-register)
        unary (-> (instruction :mir/f64-sqrt) (node/put-key :mir/dst v) (node/put-key :mir/input v))
        address (-> (instruction :mir/function-address) (node/put-key :mir/dst v) (node/put-key :mir/function (function-name)))
        error (refusal (single 2 :x86-64 true address))
        data (outcome/instruction error)]
    (and (accepted? (single 2 :x86-64 true unary))
         (= (outcome/phase error) :gmir) (= (outcome/problem error) :function-address-needs-a-module)
         (string=? (outcome/message error) "GMIR rejected: function-address-needs-a-module")
         (named? (node/key data :gmir/op) :gmir/function-address)
         (node/same-name? (node/key data :gmir/function) (function-name))
         (= (node/kind (node/key data :mir/op)) :nil))))
(defn- count-domain? [] :bool
  (let [v (virtual-register)
        zero (node/put-key (runtime-call :x86-64 :fuel-charge (node/nil-value)) :mir/dst v)
        one (node/put-key (runtime-call :x86-64 :gas-charge (node/string-value (node/string-text "x"))) :mir/dst v)
        two (node/put-key (runtime-call :x86-64 :pair (node/string-value (node/string-text "😀"))) :mir/dst v)]
    (and (accepted? (single 1 :x86-64 true zero))
         (accepted? (single 1 :x86-64 true one)) (accepted? (single 1 :x86-64 true two))
         (rejected? (single 1 :x86-64 false (runtime-call :x86-64 :fuel-charge (node/nil-value))) :physical-runtime-call-profile-violation)
         (not (accepted? (single 2 :x86-64 true one)))
         (rejected? (single 1 :x86-64 true (node/put-key one :mir/arguments (node/bool-value true))) :invalid-runtime-call))))
(defn- label-and-frame? [] :bool
  (let [jump (node/put-key (instruction :mir/jump) :mir/target (kw :test/missing))
        labels (program 1 :x86-64 true (-> (node/empty-vector) (node/append (label)) (node/append (label))))
        store (-> (instruction :mir/spill-store) (node/put-key :mir/slot (node/i64-value 0)) (node/put-key :mir/src (register :x86-64)))
        frame (single 3 :x86-64 false store)
        duplicate (refusal labels) unresolved (refusal (single 1 :x86-64 true jump))]
    (and (rejected? labels :duplicate-label) (= (node/kind (node/key (outcome/instruction duplicate) :labels)) :list)
         (= (node/child-count (node/key (outcome/instruction duplicate) :labels)) 2)
         (rejected? (single 1 :x86-64 true jump) :unresolved-target)
         (named? (node/key (outcome/instruction unresolved) :target) :test/missing)
         (accepted? frame)
         (rejected? (node/put-key frame :mir/frame-slots (node/i64-value 0)) :spill-slot-invalid)
         (rejected? (node/put-key frame :mir/frame-slots (node/i64-value 4096)) :non-canonical-program))))
(defn- nominal? [] :bool
  (let [bad (node/node :i64 0 (option-none-of [:option [:ref :gmir.node/text]]) (node/empty-text)
              (typed-list-conj [:list [:ref :gmir.node/chunk]] (node/empty-children)
                (node/chunk (typed-list-conj [:list [:ref :gmir.node/value]] (typed-list-new [:list [:ref :gmir.node/value]]) (node/nil-value)))))
        argument (-> (instruction :mir/argument) (node/put-key :mir/dst (virtual-register)) (node/put-key :mir/index bad))
        value (single 1 :x86-64 true argument) error (refusal value)]
    (and (rejected? value :non-canonical-value) (= (node/kind (outcome/instruction error)) :i64)
         (= (node/child-count (outcome/instruction error)) 1))))
(defn main [] :i64
  (cond (not (shapes?)) 1 (not (runtime-and-capability?)) 2 (not (register-version-order?)) 3
        (not (v2-projection?)) 4 (not (count-domain?)) 5 (not (label-and-frame?)) 6
        (not (privileged?)) 7 (not (nominal?)) 8 :else 0))
