;; Unexecuted native self-check source; not the complete upstream MIR suite.
(ns kotoba.mir-catalog-cases
  {:kotoba/export [main]}
  (:require [kotoba.gmir :as gmir] [kotoba.gmir.node :as node]
            [kotoba.gmir.outcome :as gmir-outcome] [kotoba.gmir.catalog :as gmir-catalog]
            [kotoba.mir.catalog :as catalog] [kotoba.mir.registers :as registers]
            [kotoba.mir.outcome :as outcome]))

(defn- same-keywords? [left [:list :keyword] right [:list :keyword]] :bool
  (and (= (vector-count left) (vector-count right))
       (loop [index 0]
         (if (>= index (vector-count left)) true
           (if (= (typed-list-nth [:list :keyword] left index) (typed-list-nth [:list :keyword] right index))
             (recur (+ index 1)) false)))))
(defn- unique-keywords? [values [:list :keyword]] :bool
  (loop [index 0 previous 0]
    (cond (>= index (vector-count values)) true
          (>= previous index) (recur (+ index 1) 0)
          (= (typed-list-nth [:list :keyword] values index) (typed-list-nth [:list :keyword] values previous)) false
          :else (recur index (+ previous 1)))))
(defn- bank [table [:list [:ref :mir.catalog/bank]] target :keyword kind :keyword] [:list :keyword]
  (option-value-of [:option [:list :keyword]] (catalog/registers-for table target kind) (typed-list-new [:list :keyword])))
(defn- banks? [table [:list [:ref :mir.catalog/bank]] count :i64] :bool
  (and (= (vector-count table) count)
       (loop [index 0]
         (if (>= index (vector-count table)) true
           (let [entry (typed-list-nth [:list [:ref :mir.catalog/bank]] table index)
                 target (catalog/bank-target entry) kind (catalog/bank-kind entry)
                 values (catalog/bank-registers entry) found (catalog/registers-for table target kind)]
             (if (and (option-some?-of [:option [:list :keyword]] found) (> (vector-count values) 0)
                      (loop [previous 0]
                        (if (>= previous index) true
                          (let [old (typed-list-nth [:list [:ref :mir.catalog/bank]] table previous)]
                            (if (and (= (catalog/bank-target old) target) (= (catalog/bank-kind old) kind))
                              false (recur (+ previous 1))))))
                      (unique-keywords? values) (same-keywords? values (bank table target kind)))
               (recur (+ index 1)) false))))))
(defn- offset? [table [:list [:ref :mir.catalog/offset]] name :keyword expected :i64] :bool
  (let [value (catalog/offset-of table name)]
    (and (option-some?-of [:option :i64] value) (= (option-value-of [:option :i64] value -1) expected))))
(defn- offsets? [table [:list [:ref :mir.catalog/offset]] count :i64] :bool
  (and (= (vector-count table) count)
       (not (option-some?-of [:option :i64] (catalog/offset-of table :not-an-operation)))
       (loop [index 0]
         (if (>= index (vector-count table)) true
           (let [entry (typed-list-nth [:list [:ref :mir.catalog/offset]] table index)
                 name (catalog/offset-name entry) value (catalog/offset-value entry)]
             (if (and (>= value 0) (= (bit-and value 7) 0) (offset? table name value)
                      (loop [previous 0]
                        (if (>= previous index) true
                          (if (= (catalog/offset-name (typed-list-nth [:list [:ref :mir.catalog/offset]] table previous)) name)
                            false (recur (+ previous 1))))))
               (recur (+ index 1)) false))))))
(defn- shapes? [] :bool
  (let [all (catalog/instruction-keysets)]
    (and (= (vector-count all) 104)
         (loop [index 0 seen (typed-list-new [:list :keyword])]
           (if (>= index (vector-count all)) true
             (let [entry (typed-list-nth [:list [:ref :mir.catalog/shape]] all index)
                   name (catalog/shape-operation entry) keys (catalog/shape-keys entry)]
               (if (and (not (gmir-catalog/keyword-member? seen name)) (unique-keywords? keys)
                        (same-keywords? keys (catalog/instruction-keys name))
                        (gmir-catalog/keyword-member? keys :mir/op) (>= (vector-count keys) 2))
                 (recur (+ index 1) (typed-list-conj [:list :keyword] seen name)) false)))))))
(defn- options [leaf [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (node/put-key (node/empty-map) :leaf? leaf))
(defn- pools? [] :bool
  (and (= (vector-count (catalog/privileged-argument-registers :x86-64)) 9)
       (= (vector-count (catalog/privileged-argument-registers :aarch64)) 12)
       (= (vector-count (catalog/privileged-argument-registers :unknown)) 0)
       (= (vector-count (catalog/allocator-pool :x86-64 (options (node/bool-value false)))) 9)
       (= (vector-count (catalog/allocator-pool :x86-64 (options (node/bool-value true)))) 11)
       (= (vector-count (catalog/allocator-pool :x86-64 (options (node/i64-value 0)))) 11)
       (= (vector-count (catalog/allocator-pool :aarch64 (options (node/nil-value)))) 12)
       (= (vector-count (catalog/allocator-pool :aarch64 (options (node/bool-value true)))) 19)
       (= (vector-count (catalog/allocator-pool :unknown (options (node/bool-value true)))) 0)
       (same-keywords? (catalog/allocator-pool :x86-64 (options (node/bool-value false)))
                       (catalog/privileged-argument-registers :x86-64))))
(defn- scans? [] :bool
  (let [rbx (node/keyword-literal :x86-64/rbx) r15 (node/keyword-literal :x86-64/r15)
        nested (-> (node/empty-vector)
                   (node/append (node/put-key (node/empty-map) :arbitrary (node/append (node/empty-set) r15)))
                   (node/append (node/append (node/empty-list) rbx)) (node/append r15))
        value (registers/saved-registers :x86-64 nested)
        actual (result-value-of [:result [:list :keyword] [:ref :mir/refusal]] value (typed-list-new [:list :keyword]))
        expected (typed-list-new [:list :keyword])
        key-map (node/node :map 0 (option-none-of [:option [:ref :gmir.node/text]]) (node/empty-text)
                  (typed-list-conj [:list [:ref :gmir.node/chunk]] (node/empty-children)
                    (node/chunk (typed-list-conj [:list [:ref :gmir.node/value]]
                      (typed-list-conj [:list [:ref :gmir.node/value]] (typed-list-new [:list [:ref :gmir.node/value]]) rbx)
                      (node/nil-value)))))
        keys (registers/saved-registers :x86-64 (node/append (node/empty-vector) key-map))
        bad-input (node/i64-value 42)
        bad (registers/saved-registers :x86-64 bad-input)
        error (result-error-of [:result [:list :keyword] [:ref :mir/refusal]] bad
                (outcome/refusal :unexpected-success (node/nil-value)))
        text (registers/saved-registers :x86-64 (node/string-value (node/string-text ":x86-64/rbx")))]
    (and (result-ok?-of [:result [:list :keyword] [:ref :mir/refusal]] value)
         (= (vector-count actual) 2) (= (typed-list-nth [:list :keyword] actual 0) :x86-64/rbx)
         (= (typed-list-nth [:list :keyword] actual 1) :x86-64/r15)
         (result-ok?-of [:result [:list :keyword] [:ref :mir/refusal]] keys)
         (= (vector-count (result-value-of [:result [:list :keyword] [:ref :mir/refusal]] keys expected)) 1)
         (= (typed-list-nth [:list :keyword] (result-value-of [:result [:list :keyword] [:ref :mir/refusal]] keys expected) 0) :x86-64/rbx)
         (not (result-ok?-of [:result [:list :keyword] [:ref :mir/refusal]] bad))
         (= (outcome/phase error) :mir) (= (outcome/problem error) :non-sequential-instructions)
         (= (node/number (outcome/instruction error)) 42)
         (string=? (outcome/message error) "MIR rejected: non-sequential-instructions")
         (result-ok?-of [:result [:list :keyword] [:ref :mir/refusal]] text)
         (= (vector-count (result-value-of [:result [:list :keyword] [:ref :mir/refusal]] text expected)) 0)
         (registers/physical-register? :aarch64 (node/keyword-literal :aarch64/x4))
         (not (registers/physical-register? :x86-64 (node/keyword-literal :x86-64/r9)))
         (not (registers/physical-register? :x86-64 (node/i64-value 0))))))
(defn- refusal-adapter? [] :bool
  (let [data (node/put-key (node/empty-map) :target (node/keyword-literal :aarch64))
        original (gmir-outcome/refusal :phi-predecessor-mismatch data)
        converted (outcome/from-gmir original)]
    (and (= (outcome/phase converted) :gmir) (= (outcome/problem converted) :phi-predecessor-mismatch)
         (string=? (outcome/message converted) (gmir-outcome/message original))
         (node/same-name? (node/key (outcome/instruction converted) :target) (node/keyword-literal :aarch64)))))
(defn- lookup-equivalence? [] :bool
  (let [all (gmir-catalog/instruction-keysets) names (gmir-catalog/instruction-operations)
        mir-all (catalog/instruction-keysets) mir-names (catalog/instruction-operations)]
    (and (= (vector-count names) (vector-count all)) (= (vector-count mir-names) (vector-count mir-all))
         (= (vector-count (catalog/instruction-keys :unknown)) 0)
         (not (option-some?-of [:option [:list :keyword]] (gmir-catalog/instruction-keys :unknown)))
         (loop [index 0]
           (if (>= index (vector-count all)) true
             (let [entry (typed-list-nth [:list [:ref :gmir.catalog/keyset]] all index)
                   op (gmir-catalog/keyset-operation entry)
                   keys (gmir-catalog/instruction-keys op)]
               (and (= op (typed-list-nth [:list :keyword] names index))
                    (option-some?-of [:option [:list :keyword]] keys)
                    (same-keywords? (gmir-catalog/keyset-keys entry) (option-value-of [:option [:list :keyword]] keys (typed-list-new [:list :keyword])))
                    (recur (+ index 1))))))
         (loop [index 0]
           (if (>= index (vector-count mir-all)) true
             (and (= (catalog/shape-operation (typed-list-nth [:list [:ref :mir.catalog/shape]] mir-all index))
                     (typed-list-nth [:list :keyword] mir-names index)) (recur (+ index 1))))))))
(defn- keyword-comparison? [] :bool
  (let [all (catalog/instruction-keysets)
        absent (node/keyword-parts (option-none-of [:option [:ref :gmir.node/text]]) (node/string-text "mir/op"))
        empty-ns (node/keyword-parts (option-some-of [:option [:ref :gmir.node/text]] (node/empty-text)) (node/string-text "op"))
        symbol (node/symbol-parts (option-some-of [:option [:ref :gmir.node/text]] (node/string-text "mir")) (node/string-text "op"))]
    (and (not (node/keyword-is? absent :mir/op)) (not (node/keyword-is? empty-ns :mir/op))
         (not (node/keyword-is? symbol :mir/op)) (not (node/keyword-is? (node/nil-value) :mir/op))
         (node/keyword-is? (node/keyword-literal :/) :/)
         (loop [index 0]
           (if (>= index (vector-count all)) true
             (let [op (catalog/shape-operation (typed-list-nth [:list [:ref :mir.catalog/shape]] all index))
                   value (node/keyword-literal op)]
               (and (node/keyword-is? value op) (node/same-name? value (node/keyword-literal op))
                    (not (node/keyword-is? value :missing)) (recur (+ index 1)))))))))
(defn main [] :i64
  (let [runtime (catalog/runtime-context-offsets) capability (catalog/capability-context-offsets)]
    (cond
      (not (and (= (catalog/version) 3) (= (catalog/slice-item-limit) (gmir/slice-item-limit))
                (= (catalog/kernel-dot-f32-maximum) (gmir/kernel-dot-f32-maximum))
                (= (catalog/kernel-dequant-dot-maximum) (gmir/kernel-dequant-dot-maximum)))) 1
      (not (and (banks? (catalog/physical-registers) 2) (banks? (catalog/leaf-registers) 2)
                (banks? (catalog/preserved-registers) 2) (banks? (catalog/call-argument-registers) 2)
                (banks? (catalog/runtime-argument-registers) 2) (banks? (catalog/capability-argument-registers) 16)
                (banks? (catalog/return-registers) 2))) 2
      (or (option-some?-of [:option [:list :keyword]] (catalog/registers-for (catalog/physical-registers) :unknown :all))
          (option-some?-of [:option [:list :keyword]] (catalog/registers-for (catalog/capability-argument-registers) :x86-64 :bytes-v1))) 3
      (not (and (offsets? runtime 37) (offsets? capability 8)
                (offset? runtime :fuel-charge 8) (offset? runtime :gas-charge 384)
                (offset? runtime :string-byte-length 72) (offset? runtime :pair-second 72)
                (offset? capability :i64 48) (offset? capability :string 128))) 4
      (not (shapes?)) 5
      (not (and (= (vector-count (catalog/kernel-atomic-ops)) 6)
                (= (vector-count (catalog/kernel-dequant-dot-operations)) 8)
                (gmir-catalog/keyword-member? (catalog/kernel-atomic-ops) :mir/kernel-cmpxchg-u64)
                (gmir-catalog/keyword-member? (catalog/kernel-dequant-dot-operations) :mir/kernel-dequant-dot-ptq1-0))) 6
      (not (pools?)) 7 (not (scans?)) 8 (not (refusal-adapter?)) 9 (not (keyword-comparison?)) 10
      (not (lookup-equivalence?)) 11 :else 0)))
