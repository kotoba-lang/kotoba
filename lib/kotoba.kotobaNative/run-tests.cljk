(ns run-tests
  "The whole suite on the kbb engine -- no JVM anywhere in this path.

     kbb --backend sci --classpath \"src:resources:test\" run-tests.cljk
     kbb -M:test                       ; the same namespaces through the alias

   Until 2026-09-18 this file ran the 15 portable namespaces and the other 22
   ran on the JVM only -- and had no runner at all since the `.cljk` rename
   (2026-09-11) removed the JVM route: `kbb -M:test` substituted cljs.test and
   died on the first `Throwable`, `clojure -M:test` found 0 tests. ADR 0086.

   Two things this runner counts that a plain `run-tests` would fold into one
   number:

   * EVERY `*_test.cljk` under test/ must be in the list below. The scan is
     printed (`SCANNED`) and a file the list does not name is a failure, not a
     smaller suite.
   * `known-red` names the deftests that fail for ONE named reason -- today,
     the 18 tests of the x86-64 aiueos kernel image that read features only
     the JVM twin `elf64.clj.cljk` lays (GDT/TSS/rsp0, value-runtime syscall
     shim, interrupt entry region, context slot block; ADR 0036). They RUN,
     their failures are printed, and they are counted apart as
     `known-red`. A failure outside that list fails the run; a known-red
     test that PASSES also fails the run (the list is stale, shorten it)."
  (:require [cljs.test :as t]
            ["fs" :as fs]
            ["path" :as path]
            [kotoba.lang.text :as str]
            [kotoba.native.peephole-test]
            [kotoba.native.boot-scratch-test]
            [kotoba.native.vector-region-test]
            [kotoba.native.string-index-test]
            [kotoba.native.typed-map-test]
            [kotoba.native.document-test]
            [kotoba.native.string-search-test]
            [kotoba.native.code-point-literal-test]
            [kotoba.native.arena-scope-test]
            [kotoba.native.text-slots-test]
            [kotoba.native.line-slots-test]
            [kotoba.native.inline-handle-ops-test]
            [kotoba.native.range-slots-test]
            [kotoba.native.bytes-slots-test]
            [kotoba.native.macho-test]
            ;; superproject adr-2609251400 C2: the loader-less Linux static ELF
            [kotoba.native.linux-static-test]
            [kotoba.native.affine-test]
            [kotoba.native.elf64-portable-test]
            [kotoba.native.aggregate-abi-portable-test]
            [kotoba.native.recursive-adt-test]
            ;; the 22 that were JVM-only until 2026-09-18
            [kotoba.native.aggregate-abi-test]
            [kotoba.native.context-slots-test]
            [kotoba.native.gas-charge-test]
            [kotoba.native.dequant-fusion-test]
            [kotoba.native.dequant-kquant-test]
            [kotoba.native.elf64-test]
            [kotoba.native.elf64-twin-parity-test]
            [kotoba.native.f32-test]
            [kotoba.native.false-argument-test]
            [kotoba.native.firmware-store-test]
            [kotoba.native.fuel64-test]
            [kotoba.native.interrupt-abi-test]
            [kotoba.native.isa-parity-test]
            [kotoba.native.keyword-equality-test]
            [kotoba.native.layout-test]
            [kotoba.native.machine-ir-test]
            [kotoba.native.rodata-literal-test]
            [kotoba.native.source-control-bytes-test]
            [kotoba.native.stack-arguments-test]
            [kotoba.native.store-result-test]
            [kotoba.native.uefi-boundary-test]
            [kotoba.native.vector-boundary-spelling-test]
            [kotoba.native.option-record-payload-test]
            [kotoba.native.vector-test]
            [kotoba.native-test]))

(def namespaces
  '[kotoba.native.peephole-test kotoba.native.boot-scratch-test kotoba.native.vector-region-test
    kotoba.native.string-index-test kotoba.native.typed-map-test kotoba.native.document-test kotoba.native.string-search-test kotoba.native.code-point-literal-test
    kotoba.native.arena-scope-test kotoba.native.text-slots-test kotoba.native.line-slots-test
    kotoba.native.inline-handle-ops-test kotoba.native.range-slots-test kotoba.native.bytes-slots-test kotoba.native.macho-test kotoba.native.linux-static-test
    kotoba.native.affine-test kotoba.native.elf64-portable-test kotoba.native.aggregate-abi-portable-test
    kotoba.native.recursive-adt-test
    kotoba.native.aggregate-abi-test kotoba.native.context-slots-test kotoba.native.gas-charge-test kotoba.native.dequant-fusion-test
    kotoba.native.dequant-kquant-test kotoba.native.elf64-test kotoba.native.elf64-twin-parity-test
    kotoba.native.f32-test kotoba.native.false-argument-test kotoba.native.firmware-store-test
    kotoba.native.fuel64-test kotoba.native.interrupt-abi-test kotoba.native.isa-parity-test
    kotoba.native.keyword-equality-test kotoba.native.layout-test kotoba.native.machine-ir-test
    kotoba.native.rodata-literal-test kotoba.native.source-control-bytes-test kotoba.native.stack-arguments-test kotoba.native.store-result-test
    kotoba.native.uefi-boundary-test kotoba.native.vector-boundary-spelling-test kotoba.native.option-record-payload-test kotoba.native.vector-test
    kotoba.native-test])

;; deftest name -> the one reason it remains red on this host. The portable
;; twin now lays the same GDT/TSS, ValueRuntime syscall shim and interrupt
;; entry region as the JVM packager. CPL3 ValueRuntime images remain refused
;; until their C-free provider qualification is complete.
(def known-red
  {'aiueos-user-packaging-refuses-value-runtime-until-c-free-provider-qualification
   "the user image's ValueRuntime provider has not completed C-free qualification"})

(defn- current-test []
  (some-> (t/get-current-env) :testing-vars first meta :name))

;; failures per deftest, so known-red and unexpected can be told apart
(def ^:private red (atom {}))
(defn- note-red! [] (when-let [n (current-test)] (swap! red update n (fnil inc 0))))
(def ^:private started (atom #{}))
(defmethod t/report [:cljs.test/default :begin-test-var] [m]
  (swap! started conj (-> m :var meta :name)))
(defmethod t/report [:cljs.test/default :fail] [m]
  (note-red!)
  (t/inc-report-counter! :fail)
  (println "\nFAIL in" (t/testing-vars-str m))
  (when (seq (:testing-contexts (t/get-current-env))) (println (t/testing-contexts-str)))
  (when-let [message (:message m)] (println message))
  (println "expected:" (pr-str (:expected m)))
  (println "  actual:" (pr-str (:actual m))))
(defmethod t/report [:cljs.test/default :error] [m]
  (note-red!)
  (t/inc-report-counter! :error)
  (println "\nERROR in" (t/testing-vars-str m))
  (when (seq (:testing-contexts (t/get-current-env))) (println (t/testing-contexts-str)))
  (when-let [message (:message m)] (println message))
  (println "expected:" (pr-str (:expected m)))
  (println "  actual:" (pr-str (:actual m))))

(defn- test-files-on-disk []
  (letfn [(walk [d] (mapcat (fn [n] (let [p (path/join d n)]
                                       (if (.isDirectory (.statSync fs p)) (walk p) [p])))
                            (.readdirSync fs d)))]
    (->> (walk "test") (filter #(str/ends-with? % "_test.cljk"))
         (map #(-> % (subs (count "test/")) (str/replace #"\.cljk$" "") (str/replace "/" ".") (str/replace "_" "-") symbol))
         set)))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (let [on-disk (test-files-on-disk)
        listed (set namespaces)
        unlisted (sort (remove listed on-disk))
        reds @red
        known (into {} (filter (fn [[n _]] (contains? known-red n)) reds))
        unexpected (into {} (remove (fn [[n _]] (contains? known-red n)) reds))
        stale (sort (remove reds (filter @started (keys known-red))))]
    (println (str "\nRan " (:test m) " tests containing " (+ (:pass m) (:fail m) (:error m)) " assertions."))
    (println (str (:fail m) " failures, " (:error m) " errors."))
    (println (str "SCANNED\t" (count on-disk) " test files on disk against " (count listed) " listed"))
    (doseq [[n c] (sort known)] (println (str "known-red\t" n "\t" c " failing assertion(s)\t" (known-red n))))
    (println (str "known-red tests\t" (count known) " of " (count known-red) " listed"))
    (doseq [[n c] (sort unexpected)] (println (str "UNEXPECTED-RED\t" n "\t" c)))
    (doseq [n stale] (println (str "STALE-KNOWN-RED\t" n "\tpassed; remove it from known-red")))
    (doseq [n unlisted] (println (str "UNLISTED-TEST-FILE\t" n)))
    (let [ok? (and (empty? unexpected) (empty? stale) (empty? unlisted) (pos? (:test m)))]
      (println (if ok? "kotoba-native suite: OK (known-red counted apart)" "kotoba-native suite: FAIL"))
      (set! (.-exitCode js/process) (if ok? 0 1)))))

(apply t/run-tests namespaces)
