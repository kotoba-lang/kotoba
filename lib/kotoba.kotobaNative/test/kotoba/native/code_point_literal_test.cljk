(ns kotoba.native.code-point-literal-test
  "`string-code-point-at` over an ASCII literal lowers to a bounded byte load
  from the code image's read-only pool, on both ISAs, and never to the
  slot-144 runtime call.

  Why this matters enough for its own file: a kernel object has no host. The
  packaged context's slots are zero, so the runtime call is a jump to address
  0. Measured 2026-09-16 under QEMU on aiueos's `aes128-gcm-selftest`, the
  first x86_64-aiueos-kernel-v1 object whose literal walk actually executed
  (`AIUEOS_FATAL_EXCEPTION vector=14 rip=0x0`); four objects landed before it
  walk literals the same way and had never run as machine code. The literal
  case is where every kernel-side protocol line lives, so it is the case the
  backend must carry without a host.

  Per ISA: the slot-144 load is absent from a literal walk and present for a
  computed string (so the fast path is known to be narrow), and the literal's
  bytes are in the emitted code (the address the load reaches is real)."
  (:require [kotoba.lang.text] #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.native.aarch64 :as arm]
            [kotoba.native.x86-64 :as x86]))

(defn- program [body]
  {:format :kotoba.kir/v4 :exports ['main]
   :functions [{:name 'main :params ['i] :result :i64 :body body}]})

(defn- contains-bytes? [code needle]
  (boolean (some #(= (vec needle) %) (partition (count needle) 1 code))))

(def ^:private literal-walk '(string-code-point-at "AIUEOS_JOB_V1 boot=" i))
;; the literal's UTF-8 bytes, written out: `(map int "…")` is not portable
;; (a cljs character is a one-character string)
(def ^:private literal-bytes [65 73 85 69 79 83 95 74 79 66 95 86 49 32 98 111 111 116 61])
(def ^:private computed-walk '(string-code-point-at (string-concat "AIU" "EOS") i))
(def ^:private x86-slot-144 [0x41 0xff 0x91 0x90 0x00 0x00 0x00]) ; call [r9+144]
(def ^:private arm-slot-144 [0xf0 0x48 0x40 0xf9])                 ; ldr x16, [x7, #144]

(deftest x86-64-walks-an-ascii-literal-without-a-host
  (let [code (:code (x86/emit-program (program literal-walk)))]
    (is (not (contains-bytes? code x86-slot-144)) "no call [r9+144]")
    (is (contains-bytes? code literal-bytes) "the literal's bytes are in the code image")))

(deftest x86-64-keeps-the-runtime-call-for-a-computed-string
  (is (contains-bytes? (:code (x86/emit-program (program computed-walk))) x86-slot-144)))

(deftest aarch64-walks-an-ascii-literal-without-a-host
  (let [code (:code (arm/emit-program (program literal-walk)))]
    (is (not (contains-bytes? code arm-slot-144)) "no ldr x16, [x7, #144]")
    (is (contains-bytes? code literal-bytes) "the literal's bytes are in the code image")))

(deftest aarch64-keeps-the-runtime-call-for-a-computed-string
  (is (contains-bytes? (:code (arm/emit-program (program computed-walk))) arm-slot-144)))

(deftest a-non-ascii-literal-keeps-the-runtime-call
  ;; a byte >= 0x80 is not one code point per byte, so it is not this path
  (is (contains-bytes? (:code (x86/emit-program (program '(string-code-point-at "あ" i)))) x86-slot-144)))
