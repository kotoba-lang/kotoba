(ns kotoba.native.range-slots-test
  "The ABI v10 range heads on both native ISAs: one runtime call each at
  336 / 344, with its arity, the slot load reaching the machine code -- and
  NOT in line (ADR 0084 inlines table reads, not appends or searches)."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.native.aarch64 :as arm]
            [kotoba.native.machine-ir :as machine]
            [kotoba.native.x86-64 :as x86]))

(defn- program [result body]
  {:format :kotoba.kir/v4 :exports ['main]
   :functions [{:name 'main :params '[s t] :param-types [:string :string] :result result :body body}]})

(deftest each-head-is-one-runtime-call
  (doseq [[form runtime arity] [['(string-find-byte s 10 0) :string-find-byte 3]
                                ['(string-byte-length (string-append-range s t 0 1)) :string-append-range 4]]]
    (let [calls (filter #(and (= :gmir/runtime-call (:gmir/op %)) (= runtime (:gmir/runtime %)))
                        (:gmir/instructions (machine/lower-kir-expression '[s t] form)))]
      (is (= 1 (count calls)) (pr-str form))
      (is (= arity (count (:gmir/arguments (first calls)))) (pr-str form)))))

(deftest both-isas-reach-the-slots
  (let [contains-bytes? (fn [code needle]
                          (boolean (some #(= (vec needle) %) (partition (count needle) 1 code))))
        arm (fn [body] (:code (arm/emit-program (program :i64 body))))
        x86 (fn [body] (:code (x86/emit-program (program :i64 body))))]
    ;; ldr x16, [x7, #336] = 0xf940a8f0; #344 = 0xf940acf0
    (is (contains-bytes? (arm '(string-find-byte s 10 0)) [0xf0 0xa8 0x40 0xf9]) "AArch64 336")
    (is (contains-bytes? (arm '(string-byte-length (string-append-range s t 0 1))) [0xf0 0xac 0x40 0xf9]) "AArch64 344")
    (is (contains-bytes? (x86 '(string-find-byte s 10 0)) [0x41 0xff 0x91 0x50 0x01 0x00 0x00]) "x86-64 336")
    (is (contains-bytes? (x86 '(string-byte-length (string-append-range s t 0 1))) [0x41 0xff 0x91 0x58 0x01 0x00 0x00]) "x86-64 344")))
