(ns kotoba.native.typed-map-test
  "amu ADR 0353 floor :native-hiccup-node: `[:map K V]` of one-word keys and
  values over the vector arena, keys and values interleaved."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.native.aarch64 :as arm]
            [kotoba.native.typed-map :as typed-map]
            [kotoba.native.x86-64 :as x86]))

(def ^:private backends
  [["x86-64" x86/emit-program] ["AArch64" arm/emit-program]])

(def ^:private attrs '(typed-map-new [:map :keyword :string] :class "c" :id "w1"))

(defn- program [result body]
  {:format :kotoba.kir/v4 :exports ['main]
   :functions [{:name 'main :params [] :param-types [] :result result :body body}]})

(deftest every-operation-emits-on-both-isas-and-keeps-helpers-private
  (doseq [[result body]
          [[[:map :keyword :string] attrs]
           [:i64 (list 'typed-map-count [:map :keyword :string] attrs)]
           [:bool (list 'typed-map-contains [:map :keyword :string] attrs :id)]
           [[:option :string] (list 'typed-map-get [:map :keyword :string] attrs :class)]
           [[:map :keyword :string] (list 'typed-map-assoc [:map :keyword :string] attrs :class "d")]
           [[:map :keyword :string] (list 'typed-map-dissoc [:map :keyword :string] attrs :class)]
           [[:option :i64] '(typed-map-get [:map :i64 :i64] (typed-map-new [:map :i64 :i64] 3 30) 3)]]
          [label emit] backends]
    (testing (str label " " body)
      (let [emitted (emit (program result body))]
        (is (seq (:code emitted)))
        (is (= ['main] (keys (:exports emitted)))
            "private helpers must not expand the kexe surface")))))

(deftest a-key-is-compared-by-content
  (testing "a string or keyword key by string=?, an i64 or bool key by the word compare"
    (is (some #{typed-map/find-text-name}
              (tree-seq coll? seq (typed-map/lower 'typed-map-get '[[:map :keyword :string] m :a]))))
    (is (some #{typed-map/find-word-name}
              (tree-seq coll? seq (typed-map/lower 'typed-map-get '[[:map :i64 :i64] m 1]))))))

(deftest assoc-keeps-the-reference-order-and-limit
  (let [nodes (tree-seq coll? seq (typed-map/lower 'typed-map-assoc '[[:map :keyword :string] m :a "x"]))]
    (is (some #{typed-map/without-name} nodes)
        "a present key's entry is dropped and the new one appended, as kotoba.kir does")
    (is (some #{62} nodes) "31 entries occupy 62 alternating words")
    (is (some #{'vector-at} nodes) "the limit traps on the existing native path")))

(deftest helper-injection-is-bounded-idempotent-and-collision-safe
  (let [plain [{:name 'main :params [] :body '(+ 1 2)}]
        mapped (typed-map/augment-functions
                [{:name 'main :params [] :body (list 'typed-map-count [:map :keyword :string] attrs)}])]
    (is (identical? plain (typed-map/augment-functions plain)))
    (is (= ['main typed-map/find-text-name typed-map/find-word-name typed-map/without-name]
           (mapv :name mapped)))
    (is (= mapped (typed-map/augment-functions mapped))))
  (is (thrown-with-msg?
       #?(:clj ExceptionInfo :cljs ExceptionInfo)
       #"collides with a native typed-map helper"
       (typed-map/augment-functions
        [{:name 'main :params [] :body attrs}
         {:name typed-map/find-text-name :params [] :body 0}]))))
