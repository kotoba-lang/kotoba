;; Golden inputs/observations for the native syscall fault harness.
;; Data only: importing these cases does not execute the provider or qualify it.
(ns kotoba.native.owned-output-cleanup-cases
  {:kotoba/export [cases]}
  (:schemas
   {:linux.static.cleanup/case
    [:record :linux.static.cleanup/case
     [[:name :keyword] [:phase :i64] [:live-mask :i64] [:member-count :i64]
      [:fault :keyword] [:close-mask :i64]
      [:members? :bool] [:rmdir? :bool] [:result :i64] [:final-phase :i64]]]}))

(defn- sample [name :keyword phase :i64 live-mask :i64 member-count :i64 fault :keyword close-mask :i64
               members? :bool rmdir? :bool result :i64 final-phase :i64]
  [:ref :linux.static.cleanup/case]
  (record-new [:ref :linux.static.cleanup/case]
    name phase live-mask member-count fault close-mask members? rmdir? result final-phase))

(defn- add-case [out [:list [:ref :linux.static.cleanup/case]] value [:ref :linux.static.cleanup/case]]
  [:list [:ref :linux.static.cleanup/case]]
  (typed-list-conj [:list [:ref :linux.static.cleanup/case]] out value))

;; Masks: member=1, probe=2, directory=4, parent=8. live-mask is the entry
;; journal; close-mask records attempted closes, each at most once. A successful
;; cleanup probe adds its FD after entry. member-count names 0.tmp..n-1.tmp.
(defn cases [] [:list [:ref :linux.static.cleanup/case]]
  (-> (typed-list-new [:list [:ref :linux.static.cleanup/case]])
      (add-case
        (sample :inactive 0 0 0 :none 0 false false 1 0))
      (add-case
        (sample :reserved-parent 1 8 0 :none 8 false false 1 0))
      (add-case
        (sample :reserved-close-error 1 8 0 :parent-close-eio 8 false false 0 4))
      (add-case
        (sample :created-without-capture 2 8 0 :none 8 false false 0 4))
      (add-case
        (sample :capture-open-error 2 8 0 :capture-open-error 8 false false 0 4))
      (add-case
        (sample :complete 3 12 2 :none 14 true true 1 0))
      (add-case
        (sample :published-members 3 12 2 :members-enoent 14 true true 1 0))
      (add-case
        (sample :member-close-error 3 13 2 :member-close-eio 15 true true 0 4))
      (add-case
        (sample :member-close-interrupted 3 13 2 :member-close-eintr 15 true true 0 4))
      (add-case
        (sample :probe-open-error 3 13 2 :probe-open-error 13 true false 0 4))
      (add-case
        (sample :owned-stat-error 3 13 2 :owned-stat-error 15 true false 0 4))
      (add-case
        (sample :named-stat-error 3 13 2 :named-stat-error 15 true false 0 4))
      (add-case
        (sample :device-replaced 3 13 2 :device-mismatch 15 true false 0 4))
      (add-case
        (sample :inode-replaced 3 13 2 :inode-mismatch 15 true false 0 4))
      (add-case
        (sample :directory-remove-error 3 13 2 :rmdir-error 15 true true 0 4))
      (add-case
        (sample :probe-close-error 3 13 2 :probe-close-eio 15 true true 0 4))
      (add-case
        (sample :directory-close-error 3 13 2 :directory-close-eio 15 true true 0 4))
      (add-case
        (sample :parent-close-error 3 13 2 :parent-close-eio 15 true true 0 4))
      (add-case
        (sample :member-remove-error 3 13 2 :member-unlink-error 15 true true 0 4))
      (add-case
        (sample :poisoned-retry 4 0 2 :none 0 false false 0 4))
      (add-case
        (sample :recursive-cleanup 3 13 2 :cleanup-in-progress 0 false false 0 3))
      (add-case
        (sample :stage-close-alias-consumed 3 12 2 :stage-close-error-before-cleanup 14 true true 1 0))))
