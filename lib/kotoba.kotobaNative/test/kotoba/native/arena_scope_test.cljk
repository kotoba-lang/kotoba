(ns kotoba.native.arena-scope-test
  "`(arena-scope body)` on both native ISAs -- superproject ADR-2609160044,
  context ABI v6.

  The lowering is one shape: ENTER (slot 224), the body in value position,
  LEAVE (slot 232), the body's register as the value. Two things pinned:

  1. The KIR-to-GMIR lowering emits exactly that pair around the body, with
     no arguments, and the body's register survives the leave.
  2. Both backends' machine code contains the two slot loads
     (`ldr x16, [x7, #224]` / `#232` on AArch64; `call [r9+0xe0]` /
     `[r9+0xe8]` on x86-64), so the pair reaches the host and not only the
     IR.

  Execution against a real host is amu's conformance, where the loader
  answers with the arenas reset; the reference interpreter's identity
  answer is pinned in osaho."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.native.aarch64 :as arm]
            [kotoba.native.machine-ir :as machine]
            [kotoba.native.x86-64 :as x86]))

(defn- program [body]
  {:format :kotoba.kir/v4 :exports ['main]
   :functions [{:name 'main :params '[n] :param-types [:i64] :result :i64 :body body}]})

(deftest the-lowering-is-enter-body-leave
  (let [instructions (:gmir/instructions
                      (machine/lower-kir-expression '[n] '(arena-scope (+ n 1))))
        runtime-calls (filter #(= :gmir/runtime-call (:gmir/op %)) instructions)]
    (is (= [:arena-enter :arena-leave] (mapv :gmir/runtime runtime-calls)))
    (is (every? #(empty? (:gmir/arguments %)) runtime-calls))
    (let [[enter-index leave-index] (keep-indexed (fn [i x] (when (= :gmir/runtime-call (:gmir/op x)) i))
                                                  instructions)]
      (is (< enter-index leave-index) "enter before leave")
      (is (some #(= :gmir/add (:gmir/op %))
                (subvec (vec instructions) enter-index leave-index))
          "the body's work lies between the two"))
    (is (= :gmir/return (:gmir/op (last instructions))))))

(deftest a-scope-nested-in-arithmetic-still-lowers
  (is (seq (:gmir/instructions
            (machine/lower-kir-expression '[n] '(+ 1 (arena-scope (* n 2)))))))
  (is (seq (:gmir/instructions
            (machine/lower-kir-expression '[n] '(arena-scope (arena-scope n)))))))

(deftest both-isas-reach-the-two-slots
  (let [contains-bytes? (fn [code needle]
                          (boolean (some #(= (vec needle) %)
                                         (partition (count needle) 1 code))))
        arm-code (:code (arm/emit-program (program '(arena-scope (+ n 1)))))
        x86-code (:code (x86/emit-program (program '(arena-scope (+ n 1)))))]
    (is (seq arm-code))
    (is (seq x86-code))
    ;; ldr x16, [x7, #224] = 0xf9407 0f0 ... encoded 0xf94070f0; #232 = 0xf94074f0
    (is (contains-bytes? arm-code [0xf0 0x70 0x40 0xf9]) "AArch64 enter, slot 224")
    (is (contains-bytes? arm-code [0xf0 0x74 0x40 0xf9]) "AArch64 leave, slot 232")
    (is (contains-bytes? x86-code [0x41 0xff 0x91 0xe0 0x00 0x00 0x00]) "x86-64 enter, slot 224")
    (is (contains-bytes? x86-code [0x41 0xff 0x91 0xe8 0x00 0x00 0x00]) "x86-64 leave, slot 232")))
