(ns kotoba.native.document-test
  "Native `:document` (gap 2 of the selfhost foundation, superproject
  adr-2609242330): every admitted operation lowers on both ISAs through the
  one written-out rewrite, its helpers are private, bounded and appended only
  when a body uses a document. The values themselves are compared with the
  reference, restricted ESM and the kexe loader in amu (the ladder gate and
  the differential run recorded in the landing commit)."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.native.aarch64 :as arm]
            [kotoba.native.document :as document]
            [kotoba.native.x86-64 :as x86]))

(def ^:private backends
  [["x86-64" x86/emit-program] ["AArch64" arm/emit-program]])

(defn- program
  "A one-function program; `emit-program` appends the helpers itself (after
  its own rewrites), so the test hands it the program as a compiler would."
  [result body]
  {:format :kotoba.kir/v4 :exports ['main]
   :functions [{:name 'main :params [] :param-types [] :result result :body body}]})

(def ^:private m '(document-map :b (document-i64 2) :a (document-string "x")))
(def ^:private v '(document-vector (document-i64 1) (document-keyword :k)))
(def ^:private b '(bytes-from-vector-i64 (vector-new 0 255 16)))
;; CIDv1 raw sha2-256 of the empty string, in binary
(def ^:private cid
  (list 'bytes-from-vector-i64
        (cons 'vector-new [1 85 18 32 227 176 196 66 152 252 28 20 154 251 244 200 153 111
                           185 36 39 174 65 228 100 155 147 76 164 149 153 27 120 82 184 85])))

(def ^:private cases
  [[:document '(document-null)]
   [:document '(document-bool true)]
   [:document '(document-i64 -7)]
   [:document '(document-string "q\"")]
   [:document '(document-keyword :ns/k)]
   [:document v]
   [:document '(document-list (document-null))]
   [:document '(document-set (document-i64 2) (document-i64 1))]
   [:document m]
   [:i64 (list 'document-count m)]
   [:keyword (list 'document-kind v)]
   [:bool (list 'document-equal? m m)]
   [:bool (list 'document-set-contains? '(document-set (document-i64 1)) '(document-i64 1))]
   [:bool (list 'document-contains m :a)]
   [[:option :document] (list 'document-get m :a)]
   [[:option :document] (list 'document-vector-at v 0)]
   [[:option :document] '(document-list-at (document-list (document-null)) 0)]
   [[:option :document] (list 'document-map-entry-at m 0)]
   [:document (list 'document-vector-assoc v 0 '(document-null))]
   [:document (list 'document-vector-conj v '(document-null))]
   [:document (list 'document-vector-drop v 1)]
   [:document (list 'document-vector-remove v 0)]
   [:document (list 'document-vector-sort v)]
   [:document (list 'document-assoc m :c '(document-bool false))]
   [:document (list 'document-dissoc m :a)]
   [:document (list 'document-merge m m)]
   [[:option :string] '(document-string-value (document-string "s"))]
   [[:option :keyword] '(document-keyword-value (document-keyword :k))]
   [[:option :bool] '(document-bool-value (document-bool true))]
   [[:option :i64] '(document-i64-value (document-i64 3))]
   [:string (list 'document-edn-print m)]
   ;; :bytes and :link (root ADR-2610092310 S4)
   [:document (list 'document-bytes b)]
   [[:option :bytes] (list 'document-bytes-value (list 'document-bytes b))]
   [[:option :document] (list 'document-link cid)]
   [[:option :bytes] (list 'document-link-value (list 'document-bytes b))]])

(deftest every-admitted-operation-lowers-on-both-isas
  (is (= (count cases)
         (count (disj document/operations 'document-symbol 'document-symbol-value
                      'document-edn-read)))
      "one case per operation this lowering answers, but the two symbol heads
       (native has no :symbol value to hand them) and the second EDN cast")
  (doseq [[result body] cases
          [label emit] backends]
    (testing (str label " " (first body))
      (let [emitted (emit (program result body))]
        (is (seq (:code emitted)))
        (is (= ['main] (keys (:exports emitted)))
            "the document helpers must not widen the kexe surface")))))

(deftest helper-injection-is-bounded-idempotent-and-collision-safe
  (let [plain [{:name 'main :params [] :body '(+ 1 2)}]
        casts [{:name 'main :params ['d] :param-types [:document] :result :string
                :body '(document-edn-print d)}]
        with (document/augment-functions (:functions (program :i64 (list 'document-count m))))]
    (is (identical? plain (document/augment-functions plain)))
    (is (identical? casts (document/augment-functions casts))
        "the EDN casts are the identity and need no helper")
    (is (< (inc (count (rest with))) (inc (count document/helper-names)))
        "the :bytes / :link helpers join only a program that names one of the four")
    (is (every? document/helper-names (map :name (rest with))))
    (is (= with (document/augment-functions with)))
    (let [all (document/augment-functions
               (:functions (program :document (list 'document-bytes b))))]
      (is (= (inc (count document/helper-names)) (count all)))
      (is (= document/helper-names (set (map :name (rest all)))))
      (is (= all (document/augment-functions all)))))
  (is (thrown-with-msg?
       #?(:clj ExceptionInfo :cljs ExceptionInfo)
       #"collides with a native document helper"
       (document/augment-functions
        [{:name 'main :params [] :body '(document-null)}
         {:name 'kotoba$doc-kind :params [] :body 0}]))))

(deftest the-reference-bounds-are-re-derived-in-emitted-kotoba
  (let [forms (tree-seq coll? seq (map :body (document/augment-functions
                                              (:functions (program :i64 (list 'document-count m))))))]
    (is (some #{32} forms) "32 items per container")
    (is (some #{9} forms) "depth 8 below the root is nine levels")
    (is (some #{4096} forms) "4096 nodes")
    (is (some #{'vector-at} forms) "a bound traps through the existing native trap path"))
  (testing "a literal container over the item bound is the trap, statically"
    (is (= '(vector-at (vector-new) 0)
           (document/lower 'document-vector (repeat 33 '(document-null))))))
  (testing "the EDN casts are the identity at the ABI"
    (is (= 'd (document/lower 'document-edn-print ['d])))
    (is (= 'd (document/lower 'document-edn-read ['d])))))

(deftest a-namespaced-keyword-name-drops-its-namespace
  ;; `(keyword-name :ns/n)` is "n" on the reference; native answered "ns/n"
  ;; until 2026-09-26. The rewrite finds the first `/` past the `:`.
  (doseq [[label emit] backends]
    (testing label
      (is (seq (:code (emit {:format :kotoba.kir/v4 :exports ['main]
                             :functions [{:name 'main :params [] :param-types [] :result :string
                                          :body '(keyword-name :ns/n)}]})))))))
