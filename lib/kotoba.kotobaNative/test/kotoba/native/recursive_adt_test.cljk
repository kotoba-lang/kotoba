(ns kotoba.native.recursive-adt-test
  "Aggregate ABI v8: a recursive variant and the heterogeneous vector that
  holds its children lower to EXACTLY the pair program a person would write by
  hand -- the same evidence ADR 0031 gave for nested records. Equal machine
  code on both ISAs is the claim; that the pair program itself computes the
  right answer is what the pair primitives' own tests already establish."
  (:require [kotoba.lang.error :as kerror] #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.native.machine-ir :as machine]))

(def node
  [:variant :test/node [[:leaf :i64]
                        [:branch [:vector [[:ref :test/node] [:ref :test/node]]]]]])
(def children [:vector [[:ref :test/node] [:ref :test/node]]])

(defn- module [sum-body main-body]
  {:format :kotoba.kir/v4 :entry 'main :exports ['main]
   :functions [{:name 'main :params [] :param-types [] :result :i64 :body main-body}
               {:name 'sum :params ['n] :param-types [node] :result :i64 :body sum-body}]})

(def typed
  (module
   (list 'variant-match node 'n
         [[:leaf 'x 'x]
          [:branch 'p (list '+ (list 'sum (list 'hetero-vector-at children 'p 0))
                            (list 'sum (list 'hetero-vector-at children 'p 1)))]])
   (list 'sum (list 'variant-new node :branch
                    (list 'hetero-vector-new children
                          (list 'variant-new node :leaf 20)
                          (list 'variant-new node :leaf 22))))))

(def by-hand
  (module
   '(let [v n]
      (if (= (pair-first v) 0)
        (let [x (pair-second v)] x)
        (if (= (pair-first v) 1)
          (let [p (pair-second v)]
            (+ (sum (pair-first p)) (sum (pair-first (pair-second p)))))
          (quot 1 0))))
   '(sum (pair 1 (pair (pair 0 20) (pair (pair 0 22) 0))))))

(deftest a-recursive-variant-is-the-pair-program-written-by-hand
  (doseq [target [:x86-64 :aarch64]]
    (testing (name target)
      (let [emit #(:mc/functions (machine/compile-gmir target (machine/lower-kir-module %)))]
        (is (seq (emit typed)))
        (is (= (emit by-hand) (emit typed)))))))

(deftest hetero-vector-assoc-rebuilds-the-chain
  (let [assoc-module
        (module
         (list 'variant-match node 'n
               [[:leaf 'x 'x]
                [:branch 'p (list 'sum (list 'hetero-vector-at children
                                             (list 'hetero-vector-assoc children 'p 1
                                                   (list 'variant-new node :leaf 5))
                                             1))]])
         (list 'sum (list 'variant-new node :leaf 1)))]
    (doseq [target [:x86-64 :aarch64]]
      (is (seq (:mc/functions (machine/compile-gmir target (machine/lower-kir-module assoc-module))))
          target))))

(deftest an-index-outside-the-declared-positions-is-refused
  (let [bad (module (list 'variant-match node 'n
                          [[:leaf 'x 'x]
                           [:branch 'p (list 'sum (list 'hetero-vector-at children 'p 2))]])
                    '(sum 0))]
    (try
      (machine/lower-kir-module bad)
      (is false "an index past the declared positions must not lower")
      (catch kerror/ExceptionInfo error
        (is (= :invalid-hetero-vector-index (:problem (ex-data error))))))))
