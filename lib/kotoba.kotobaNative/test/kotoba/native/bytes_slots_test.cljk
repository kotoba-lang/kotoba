(ns kotoba.native.bytes-slots-test
  "`:bytes` and the string constructor on both native ISAs (context ABI v11,
  2026-09-25, superproject adr-2609242330): a bytes value is a vector-arena
  handle, so its empty value and its two reads ARE the vector runtime calls,
  and the four new slots 352-376 are one runtime call each, with its arity,
  reaching the machine code on both ISAs."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.native.aarch64 :as arm]
            [kotoba.native.machine-ir :as machine]
            [kotoba.native.x86-64 :as x86]))

(defn- program [result body]
  {:format :kotoba.kir/v4 :exports ['main]
   :functions [{:name 'main :params '[v b] :param-types [:vector-i64 :bytes] :result result :body body}]})

(defn- runtime-calls [form]
  (keep #(when (= :gmir/runtime-call (:gmir/op %))
           [(:gmir/runtime %) (count (:gmir/arguments %))])
        (:gmir/instructions (machine/lower-kir-expression '[v b] form))))

(deftest the-new-heads-are-one-runtime-call-each
  (doseq [[form runtime arity] [['(string-byte-length (string-from-utf8 b)) :string-from-utf8 1]
                                ['(bytes-count (bytes-from-vector-i64 v)) :bytes-from-vector 1]
                                ['(vector-count (vector-i64-from-bytes b)) :bytes-from-vector 1]
                                ['(bytes-count (bytes-slice b 0 1)) :bytes-slice 3]
                                ['(bytes-count (bytes-concat b b)) :bytes-concat 2]]]
    (is (= 1 (count (filter #(= [runtime arity] %) (runtime-calls form)))) (pr-str form))))

(deftest the-reads-are-the-vector-calls
  (is (some #{[:vector-count 1]} (runtime-calls '(bytes-count b))))
  (is (some #{[:vector-at 2]} (runtime-calls '(bytes-at b 0))))
  (is (some #{[:vector-new-empty 0]} (runtime-calls '(bytes-count (bytes-empty))))))

(deftest both-isas-reach-the-slots
  (let [contains-bytes? (fn [code needle]
                          (boolean (some #(= (vec needle) %) (partition (count needle) 1 code))))
        arm (fn [body] (:code (arm/emit-program (program :i64 body))))
        x86 (fn [body] (:code (x86/emit-program (program :i64 body))))]
    ;; ldr x16, [x7, #off] = 0xf9400000 | (off/8)<<10 | 7<<5 | 16
    ;; x86-64: call qword ptr [r9+disp32] = 41 ff 91 <disp32>
    (doseq [[body off arm-bytes] [['(string-byte-length (string-from-utf8 b)) 352 [0xf0 0xb0 0x40 0xf9]]
                                  ['(bytes-count (bytes-from-vector-i64 v)) 360 [0xf0 0xb4 0x40 0xf9]]
                                  ['(bytes-count (bytes-slice b 0 1)) 368 [0xf0 0xb8 0x40 0xf9]]
                                  ['(bytes-count (bytes-concat b b)) 376 [0xf0 0xbc 0x40 0xf9]]]]
      (is (contains-bytes? (arm body) arm-bytes) (str "AArch64 " off))
      (is (contains-bytes? (x86 body) [0x41 0xff 0x91 (bit-and off 0xff) (bit-shift-right off 8) 0x00 0x00])
          (str "x86-64 " off)))))
