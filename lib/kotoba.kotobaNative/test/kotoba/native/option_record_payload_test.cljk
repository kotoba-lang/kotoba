(ns kotoba.native.option-record-payload-test
  "amu ADR 0353 floor :native-option-record. An `[:option R]` is
  pair(present, payload), its payload one word. In a module whose only record
  is a flat i64 one, the record was scalar-replaced, so `option-value-of`'s two
  arms -- the payload word and the record fallback's bundle -- did not meet:
  `branch-value-shape-mismatch`. A record an option holds now selects the
  pair-chain lowering, as a record in a variant payload already did.

  Written to fail against the pre-fix backend: without the option clause in
  `record-boundary-module?`, the module below is that rejection."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.native.machine-ir :as machine]
            [kotoba.native.aarch64 :as aarch64]
            [kotoba.native.x86-64 :as x86-64]))

(def ^:private r [:record :b/r [[:t :i64]]])
(def ^:private o [:option r])

(def ^:private option-record-kir
  {:format :kotoba.kir/v4
   :entry 'main
   :exports ['main]
   :functions
   [{:name 'f :params ['o] :param-types [o] :result :i64
     :body (list 'let ['b 'o]
                 (list 'if (list 'option-some?-of o 'b)
                       (list 'let ['c (list 'option-value-of o 'b (list 'record-new r 0))]
                             (list 'record-get r 'c :t))
                       7))}
    {:name 'main :params [] :param-types [] :result :i64
     :body (list '+ (list 'f (list 'option-some-of o (list 'record-new r 5)))
                 (list 'f (list 'option-none-of o)))}]})

(defn- rejection [kir]
  (try (machine/lower-kir-module kir) nil
       (catch ExceptionInfo error (ex-data error))))

(deftest a-record-in-an-option-lowers-on-both-isas
  (is (nil? (rejection option-record-kir)))
  (doseq [[target emit] [[:aarch64 aarch64/emit-program]
                         [:x86-64 x86-64/emit-program]]]
    (testing (name target)
      (is (seq (:code (emit option-record-kir)))))))
