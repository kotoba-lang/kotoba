(ns kotoba.native.test-support
  "What the suite used to take from the JVM, on the kbb engine (SCI on Node).

  Root ADR-2609182300 / kotoba-native ADR 0086 (2026-09-18): the suite runs
  on `kbb -M:test` only, so every `clojure.java.io`, `java.security`,
  `Float/…`, `format` and `Long/…` the tests reached is one of these six
  helpers instead. Nothing here decides anything; it reads bytes, hashes
  them, and reinterprets words."
  (:require ["fs" :as fs]
            ["path" :as path]
            ["crypto" :as crypto]
            [goog.string :as gstring]
            [goog.string.format]))

(defn read-text
  "The file's text, UTF-8. `root`-relative paths resolve against the
  process cwd (the repository root under `kbb -M:test`)."
  [p]
  (.readFileSync fs p "utf8"))

(defn read-bytes
  "The file's bytes as a vector of 0..255."
  [p]
  (vec (.readFileSync fs p)))

(defn resource-text
  "A classpath resource by its classpath-relative path. The suite's classpath
  is three directories (`resources`, `test`, `src`), searched in that order;
  a resource in none of them is an error that names the path, not nil."
  [rel]
  (let [hit (some (fn [d] (let [p (path/join d rel)] (when (.existsSync fs p) p))) ["resources" "test" "src"])]
    (when-not hit (throw (ex-info (str "resource not on the suite classpath: " rel) {:resource rel})))
    (read-text hit)))

(defn file-seq-files
  "Every regular file under `dir`, depth first, as paths."
  [dir]
  (letfn [(walk [d]
            (mapcat (fn [name]
                      (let [p (path/join d name)]
                        (if (.isDirectory (.statSync fs p)) (walk p) [p])))
                    (.readdirSync fs d)))]
    (vec (walk dir))))

(defn sha256-hex
  "Lower-case hex SHA-256 of a byte seq (0..255 each)."
  [bytes]
  (-> (.createHash crypto "sha256")
      (.update (js/Uint8Array.from (to-array (map #(bit-and % 0xff) bytes))))
      (.digest "hex")))

(defn utf8-bytes
  "The UTF-8 bytes of a string as a vector of 0..255 -- `.getBytes s \"UTF-8\"`."
  [s]
  (vec (.encode (js/TextEncoder.) s)))

(defn format
  "`clojure.core/format` for the %d / %x / %02x / %08x / %s the suite uses."
  [fmt & args]
  (apply gstring/format fmt args))

(def ^:private f32-view (js/DataView. (js/ArrayBuffer. 4)))

(defn float->raw-int-bits
  "`Float/floatToRawIntBits`: the binary32 bit pattern of `x` as a SIGNED
  32-bit integer (bit 31 set reads negative), as the JVM answers it."
  [x]
  (.setFloat32 f32-view 0 x true)
  (.getInt32 f32-view 0 true))

(defn int-bits->float
  "`Float/intBitsToFloat`: the binary32 whose bit pattern is the low 32 bits
  of `bits`."
  [bits]
  (.setUint32 f32-view 0 (bit-and bits 0xffffffff) true)
  (.getFloat32 f32-view 0 true))

;; ── 32-bit machine words ─────────────────────────────────────────────────────
;;
;; The suite reads instruction words and byte fields with the bit operations,
;; and it was written against JVM longs: `(bit-and word 0xffe00000)` on a word
;; with bit 31 set answered a POSITIVE number there, and the tests compare it
;; with a positive literal (`0xd2800000`). cljs's bit operations are JS int32
;; ops, so the same expression answers a negative number and every such
;; comparison fails (measured 2026-09-18: 173 failures on the first kbb run,
;; most of them this). These are the same operations with the answer read
;; back as an UNSIGNED 32-bit word (`>>> 0`), which is what a machine-word
;; test means by them. Test namespaces take them with
;;   (:refer-clojure :exclude [bit-and bit-or bit-xor bit-not bit-shift-left
;;                             bit-shift-right unsigned-bit-shift-right])
;;   [kotoba.native.test-support :refer [bit-and ...]]
;; A test that reasons about a genuine 64-bit value uses `kotoba.kir.cljs-i64`
;; (BigInt) and never these.
(defn- u32 [x] (unsigned-bit-shift-right x 0))
(defn bit-and
  ([a b] (u32 (cljs.core/bit-and a b)))
  ([a b & more] (u32 (reduce cljs.core/bit-and (cljs.core/bit-and a b) more))))
(defn bit-or
  ([a b] (u32 (cljs.core/bit-or a b)))
  ([a b & more] (u32 (reduce cljs.core/bit-or (cljs.core/bit-or a b) more))))
(defn bit-xor
  ([a b] (u32 (cljs.core/bit-xor a b)))
  ([a b & more] (u32 (reduce cljs.core/bit-xor (cljs.core/bit-xor a b) more))))
(defn bit-not [a] (u32 (cljs.core/bit-not a)))
(defn bit-shift-left
  "Exact while the answer fits 53 bits (`(bit-shift-left 1 40)` is a page
  address in these tests, not a wrapped word), so this is a multiply by a
  power of two rather than the int32 `<<`."
  [a n] (* a (js/Math.pow 2 n)))
(defn bit-shift-right
  "Unsigned for a 32-bit word (the tests' words are unsigned); for anything
  wider, an exact floor division by a power of two."
  [a n] (if (and (<= 0 a) (< a 4294967296)) (u32 (cljs.core/unsigned-bit-shift-right a n)) (js/Math.floor (/ a (js/Math.pow 2 n)))))
(defn unsigned-bit-shift-right [a n] (bit-shift-right a n))
