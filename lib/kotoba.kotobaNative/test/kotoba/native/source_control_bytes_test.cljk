(ns kotoba.native.source-control-bytes-test
  "A raw control byte makes grep treat a source file as binary, so it prints
  nothing and exits 1 -- which is what a file NOT containing the searched word
  does. `src/kotoba/native/elf64.clj.cljk` carried four raw NULs inside the ELF
  shstrtab literal, and it is the JVM allowlist for every aiueos kernel export
  symbol (ADR-0036). Auditing that table with grep returned silence."
  (:refer-clojure :exclude [bit-and])
  (:require [kotoba.native.test-support :refer [bit-and]]
            [kotoba.native.test-support :as support]
            [kotoba.test :refer [deftest is]]))

(defn- control-bytes [f]
  (let [bytes (support/read-bytes f)]
    (count (filter (fn [b]
                     (let [v (bit-and b 0xff)]
                       (or (< v 9) (= v 11) (= v 12) (and (< 13 v) (< v 32)))))
                   bytes))))

(deftest sources-carry-no-raw-control-bytes
  ;; `.cljk` since the 2026-09-11 rename (cljk-origin.edn). The pattern was
  ;; `\.cljc?$` until 2026-09-18 and matched NOTHING after the rename, so the
  ;; evidence floor below was the only thing this test could say.
  (let [sources (->> (support/file-seq-files "src")
                     (filter #(re-find #"\.clj[ck]?$" %)))
        offenders (into (sorted-map)
                        (keep (fn [f]
                                (let [n (control-bytes f)]
                                  (when (pos? n) [f n])))
                              sources))]
    ;; Evidence floor: a scan that found no files has not found no offenders.
    (is (pos? (count sources)) "no sources were scanned")
    (is (= {} offenders))))
