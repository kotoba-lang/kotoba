(ns kotoba.native.text-slots-test
  "The ABI v7 text heads on both native ISAs: each is one runtime call at
  its slot (240 / 248 / 256 / 264), with its arity, and the slot load
  reaches the machine code."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.native.aarch64 :as arm]
            [kotoba.native.machine-ir :as machine]
            [kotoba.native.x86-64 :as x86]))

(defn- program [result body]
  {:format :kotoba.kir/v4 :exports ['main]
   :functions [{:name 'main :params '[s t] :param-types [:string :string] :result result :body body}]})

(deftest each-head-is-one-runtime-call
  (doseq [[form runtime arity] [['(string-compare s t) :string-compare 2]
                                ['(string-fold-ascii s) :string-fold-ascii 1]
                                ['(string-find-blank s 0) :string-find-blank 2]
                                ['(string-skip-blank s 0) :string-skip-blank 2]]]
    (let [calls (filter #(= :gmir/runtime-call (:gmir/op %))
                        (:gmir/instructions (machine/lower-kir-expression '[s t] form)))]
      (is (= [runtime] (mapv :gmir/runtime calls)) (pr-str form))
      (is (= arity (count (:gmir/arguments (first calls)))) (pr-str form)))))

(deftest both-isas-reach-the-slots
  (let [contains-bytes? (fn [code needle]
                          (boolean (some #(= (vec needle) %)
                                         (partition (count needle) 1 code))))
        arm (fn [body] (:code (arm/emit-program (program :i64 body))))
        x86 (fn [body] (:code (x86/emit-program (program :i64 body))))]
    ;; ldr x16, [x7, #240] = f9407 8f0 ...: 0xf94078f0; #248 0xf9407cf0; #256 0xf94080f0; #264 0xf94084f0
    (is (contains-bytes? (arm '(string-compare s t)) [0xf0 0x78 0x40 0xf9]) "AArch64 240")
    (is (contains-bytes? (arm '(string-byte-length (string-fold-ascii s))) [0xf0 0x7c 0x40 0xf9]) "AArch64 248")
    (is (contains-bytes? (arm '(string-find-blank s 0)) [0xf0 0x80 0x40 0xf9]) "AArch64 256")
    (is (contains-bytes? (arm '(string-skip-blank s 0)) [0xf0 0x84 0x40 0xf9]) "AArch64 264")
    (is (contains-bytes? (x86 '(string-compare s t)) [0x41 0xff 0x91 0xf0 0x00 0x00 0x00]) "x86-64 240")
    (is (contains-bytes? (x86 '(string-byte-length (string-fold-ascii s))) [0x41 0xff 0x91 0xf8 0x00 0x00 0x00]) "x86-64 248")
    (is (contains-bytes? (x86 '(string-find-blank s 0)) [0x41 0xff 0x91 0x00 0x01 0x00 0x00]) "x86-64 256")
    (is (contains-bytes? (x86 '(string-skip-blank s 0)) [0x41 0xff 0x91 0x08 0x01 0x00 0x00]) "x86-64 264")))
