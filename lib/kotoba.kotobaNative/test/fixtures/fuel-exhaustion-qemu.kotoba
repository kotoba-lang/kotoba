;; amu-h7: the execution proof that fuel exhaustion names itself.
;;
;; The kernel's fuel budget is charged once per call and never replenished
;; (the interrupt entries replenish only for their own body, and save and
;; restore the interrupted budget around it). When the counter reaches zero
;; the next prologue executes `ud2`, which raises #UD, which is vector 6 --
;; and until this fixture existed a kernel that installed no vector 6 gate
;; went silent there: an empty gate is #GP, an empty #GP gate is #DF, an
;; empty #DF gate is a triple fault and a reset. Measured twice on real
;; hardware on 2026-09-07 (aiueos k16 rank-02, amu-h7): the only evidence was
;; a missing run-end byte.
;;
;; `main` installs an IDT whose vector 6 gate names the packager's entry
;; region slot for vector 6. This image declares a body for vector 32 (the
;; timer, which never fires here) so that the region exists, and declares NO
;; body for vector 6 -- so the slot the gate names is the packager's canned
;; #UD handler, not a Kotoba body. It then burns fuel until the budget is
;; gone. `burn` is self-tail-recursive (no stack growth) and each iteration
;; calls `tick`, which recurses nine frames deep and back, so every iteration
;; charges ten calls against a stack that never exceeds ten frames; the
;; budget runs out long before the counter does.
;;
;; Console (port 0xe9), in order:
;;   D  the IDT loaded and read back through `sidt`
;;   U  the canned #UD handler: fuel ran out and the machine said so
;; then exit status (0x1d << 1) | 1 = 59 through isa-debug-exit. A machine
;; that exits any other way, or writes anything after the D, has not taken
;; the path this fixture exists to see.

;; Store one byte and prove it landed. 1 when the read-back agrees.
(defn store-byte [page :i64 offset :i64 value :i64] :i64
  (let [written (kernel-store-u8-4k page 4096 offset value)]
    (if (= (kernel-load-u8-4k page 4096 offset) value) 1 0)))

;; Store one aligned quadword and prove it landed.
(defn store-word [page :i64 offset :i64 value :i64] :i64
  (let [written (kernel-store-u64-4k page 4096 offset value)]
    (if (= (kernel-load-u64-4k page 4096 offset) value) 1 0)))

;; The IDTR's 8-byte base sits at an odd offset behind a 2-byte limit. Byte
;; at a time, like the kernel's own `store64-page`.
(defn store-base [page :i64 offset :i64 value :i64] :i64
  (if (and (= (store-byte page offset (bit-and value 255)) 1)
           (= (store-byte page (+ offset 1) (bit-and (quot value 256) 255)) 1)
           (= (store-byte page (+ offset 2) (bit-and (quot value 65536) 255)) 1)
           (= (store-byte page (+ offset 3) (bit-and (quot value 16777216) 255)) 1)
           (= (store-byte page (+ offset 4) (bit-and (quot value 4294967296) 255)) 1)
           (= (store-byte page (+ offset 5) (bit-and (quot value 1099511627776) 255)) 1)
           (= (store-byte page (+ offset 6) (bit-and (quot value 281474976710656) 255)) 1)
           (= (store-byte page (+ offset 7) (bit-and (quot value 72057594037927936) 255)) 1))
    1
    0))

;; A body for a vector that never fires, so the image has an entry region.
;; Vector 6 deliberately has none.
(defn aiueos-isr-32 [vector :i64 error-code :i64 rip :i64 rsp :i64] :i64
  0)

;; Nine charged calls, nine frames deep, and back.
(defn tick [n :i64] :i64
  (if (= n 0) 0 (+ 1 (tick (- n 1)))))

;; Ten charges per iteration, no stack growth. The argument only ever falls
;; by one, so the budget -- not the counter -- is what ends this.
(defn burn [k :i64] :i64
  (if (= k 0) 0 (burn (- (+ k (tick 8)) 9))))

(defn main [] :i64
  (let [idt 1089536
        handler (kernel-isr-entry-address 6)
        selector (kernel-read-cs)
        handler-low (bit-and handler 65535)
        handler-mid (bit-and (quot handler 65536) 65535)
        handler-high (bit-and (quot handler 4294967296) 4294967295)
        gate-low (+ handler-low
                    (* selector 65536)
                    (* 142 1099511627776)
                    (* handler-mid 281474976710656))]
    (if (and (> handler 1052672) (< handler 1114112)
             (> selector 0) (<= selector 65535)
             (= (store-word idt 96 gate-low) 1)
             (= (store-word idt 104 handler-high) 1)
             (= (store-byte idt 512 239) 1)
             (= (store-byte idt 513 0) 1)
             (= (store-base idt 514 idt) 1))
      (if (= (kernel-load-idt (kernel-subregion idt 4096 512 10) 10) 1)
        (let [ready (kernel-out-u8 233 68)]
          ;; Never returns through this expression: the budget runs out
          ;; inside `burn`, and the #UD handler exits the machine.
          (+ (* 0 ready) (burn 1000000000)))
        (kernel-out-u32 244 20))
      (kernel-out-u32 244 19))))
