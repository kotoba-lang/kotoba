;; storefix: the execution proof that a bounded store answers with the word it
;; stored.
;;
;; `store_result_test.clj` says the bytes are the instructions they are named
;; for. This says the CPU agrees. Both are needed and neither implies the
;; other: the defect this fixture was written for emitted every correct store
;; instruction and simply never wrote the register the expression answered
;; with, so every byte golden anyone had written still passed.
;;
;; Each width is asked TWO questions, in this order, and writes one character
;; per answer to the 0xe9 debug console:
;;
;;   1/2/3/4  the store's ANSWER equals the word handed to it   (X when not)
;;   5/6/7/8  a LOAD BACK from the same address equals it too   (X when not)
;;
;; The load-back is the control. It says the memory effect happened, which
;; separates "the store did not run" from "the store ran and answered wrong" --
;; and those two produce the same digit if only one question is asked.
;;
;;   before kotoba-native #<this change>:  X5X6X7X8
;;   after:                                15263748
;;
;; then exit status 33 (16 << 1 | 1) through isa-debug-exit at 0xf4.
;;
;; The page is 0x109000, the same scratch page `isr-qemu.kotoba` writes its IDT
;; into: identity-mapped RAM in the image the aiueos boot chain hands over, and
;; already proven writable by that fixture. The four offsets are naturally
;; aligned for their widths, because every access above one byte checks
;; alignment before it checks anything else.
;;
;; The values are distinct byte patterns rather than small integers so that a
;; register that happens to hold a plausible number cannot pass: 0xEF, 0xABCD,
;; 0x12345678, 0x0123456789ABCDEF.

(defn main [] :i64
  (let [page 1089536
        a8 (kernel-out-u8 233
             (if (= (kernel-store-u8-4k page 4096 0 239) 239) 49 88))
        r8 (kernel-out-u8 233
             (if (= (kernel-load-u8-4k page 4096 0) 239) 53 88))
        a16 (kernel-out-u8 233
              (if (= (kernel-store-u16-4k page 4096 8 43981) 43981) 50 88))
        r16 (kernel-out-u8 233
              (if (= (kernel-load-u16-4k page 4096 8) 43981) 54 88))
        a32 (kernel-out-u8 233
              (if (= (kernel-store-u32-4k page 4096 16 305419896) 305419896)
                51 88))
        r32 (kernel-out-u8 233
              (if (= (kernel-load-u32-4k page 4096 16) 305419896) 55 88))
        a64 (kernel-out-u8 233
              (if (= (kernel-store-u64-4k page 4096 24 81985529216486895)
                     81985529216486895)
                52 88))
        r64 (kernel-out-u8 233
              (if (= (kernel-load-u64-4k page 4096 24) 81985529216486895)
                56 88))]
    (kernel-out-u32 244
      (+ 16 (* 0 (+ a8 (+ r8 (+ a16 (+ r16 (+ a32 (+ r32 (+ a64 r64))))))))))))
