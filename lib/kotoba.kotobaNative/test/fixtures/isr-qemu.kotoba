;; isr: the execution proof for the toolchain-generated interrupt entry.
;;
;; `main` installs an IDT whose vector 6 gate names the entry this compiler
;; generated, then executes a bounded load whose index is outside its window.
;; That emits `ud2`, which raises #UD, which is vector 6 -- so the CPU enters
;; the entry, the entry calls `aiueos-isr-6`, and the body says what it was
;; handed.
;;
;; #UD rather than a breakpoint because there is no `int3` operator, and adding
;; one to reach this proof would have meant a privileged operation existing for
;; the sake of its own test. `ud2` is already emitted -- by the bounds check
;; every bounded load carries -- so the trigger is one expression, no new
;; operator, and the trap that fires is the one this backend already uses to
;; say "outside the window".
;;
;; The body never returns: it writes the exit port instead. That is deliberate.
;; #UD is a FAULT, so the frame's RIP is the address of the faulting `ud2` and
;; `iretq` would re-execute it forever. Advancing that RIP would mean the entry
;; deciding how long the faulting instruction was, which is exactly the
;; judgement a toolchain-generated entry refuses to make.
;;
;; EVERY WRITE IS CHECKED BY READING IT BACK, never by comparing what the store
;; returned. A bounded store's answer is an UNDEFINED REGISTER on the machine
;; (kotoba-native `x86-kernel-memory` takes `result` as the stored register for
;; a store and never writes `:mir/dst`), while the KIR oracle answers with the
;; operand. Measured 2026-09-02: an earlier version of this fixture compared
;; store answers, every comparison was false, and the image exited through its
;; own guard without printing anything. The load-back is both the workaround
;; and the stronger check -- it says the byte reached memory, which is what the
;; IDT actually needs.
;;
;; Console (port 0xe9), in order:
;;   D  the IDT loaded and read back through `sidt`
;;   I  the entry passed vector 6
;;   S  it passed error code 0 -- the synthetic push, because #UD supplies none
;;   R  the interrupted RIP is inside this image's text
;;   P  the interrupted RSP is inside this image's stack
;; then exit status 33 through isa-debug-exit.

;; Store one byte and prove it landed. 1 when the read-back agrees.
(defn store-byte [page :i64 offset :i64 value :i64] :i64
  (let [written (kernel-store-u8-4k page 4096 offset value)]
    (if (= (kernel-load-u8-4k page 4096 offset) value) 1 0)))

;; Store one aligned quadword and prove it landed.
(defn store-word [page :i64 offset :i64 value :i64] :i64
  (let [written (kernel-store-u64-4k page 4096 offset value)]
    (if (= (kernel-load-u64-4k page 4096 offset) value) 1 0)))

;; The IDTR's 8-byte base sits at an odd offset behind a 2-byte limit, so it
;; cannot use the aligned quadword store. Byte at a time, like the kernel's own
;; `store64-page`.
(defn store-base [page :i64 offset :i64 value :i64] :i64
  (if (and (= (store-byte page offset (bit-and value 255)) 1)
           (= (store-byte page (+ offset 1) (bit-and (quot value 256) 255)) 1)
           (= (store-byte page (+ offset 2) (bit-and (quot value 65536) 255)) 1)
           (= (store-byte page (+ offset 3) (bit-and (quot value 16777216) 255)) 1)
           (= (store-byte page (+ offset 4) (bit-and (quot value 4294967296) 255)) 1)
           (= (store-byte page (+ offset 5) (bit-and (quot value 1099511627776) 255)) 1)
           (= (store-byte page (+ offset 6) (bit-and (quot value 281474976710656) 255)) 1)
           (= (store-byte page (+ offset 7) (bit-and (quot value 72057594037927936) 255)) 1))
    1
    0))

;; The four arguments the toolchain-generated entry passes, checked one at a
;; time. Each writes its own letter or an X, so a wrong argument is visible on
;; the console rather than collapsing into one exit code.
(defn aiueos-isr-6 [vector :i64 error-code :i64 rip :i64 rsp :i64] :i64
  (let [v (kernel-out-u8 233 (if (= vector 6) 73 88))
        e (kernel-out-u8 233 (if (= error-code 0) 83 88))
        r (kernel-out-u8 233 (if (and (> rip 1052672) (< rip 1114112)) 82 88))
        s (kernel-out-u8 233 (if (> rsp 1085440) 80 88))]
    (kernel-out-u32 244 (+ 16 (* 0 (+ v (+ e (+ r s))))))))

(defn main [] :i64
  (let [idt 1089536
        handler (kernel-isr-entry-address 6)
        selector (kernel-read-cs)
        handler-low (bit-and handler 65535)
        handler-mid (bit-and (quot handler 65536) 65535)
        handler-high (bit-and (quot handler 4294967296) 4294967295)
        gate-low (+ handler-low
                    (* selector 65536)
                    (* 142 1099511627776)
                    (* handler-mid 281474976710656))]
    (if (and (> handler 1052672) (< handler 1114112)
             (> selector 0) (<= selector 65535)
             (= (store-word idt 96 gate-low) 1)
             (= (store-word idt 104 handler-high) 1)
             (= (store-byte idt 512 239) 1)
             (= (store-byte idt 513 0) 1)
             (= (store-base idt 514 idt) 1))
      (if (= (kernel-load-idt (kernel-subregion idt 4096 512 10) 10) 1)
        (let [ready (kernel-out-u8 233 68)]
          ;; index 64 against a declared length of 8: the bounds check emits
          ;; `ud2`, the CPU raises #UD, and the IDT above sends it to the
          ;; generated entry.
          (+ (* 0 ready) (kernel-load-u8 idt 8 64)))
        (kernel-out-u32 244 20))
      (kernel-out-u32 244 19))))
