(ns kotoba.native.affine
  "Is this vector binding used LINEARLY — at most once on every path, with a
  consuming update as its last use?

  ## Why the question is worth asking

  `vector-assoc` allocates. The native host says so in its own words: *every
  operation that changes an element allocates rather than mutates*, and
  `checked_vector_assoc` is a `memmove` of the whole vector followed by a bump
  into an arena that is never reclaimed. Two consequences, both measured
  rather than reasoned about:

  - one element write costs O(length)
  - the number of writes a vector may ever receive is
    `arena / length` — **a 16,384-item vector, the longest KIR admits, can be
    updated four times in the life of a program** (65,536 / 16,384)

  An order book is a struct of arrays with about a million slots per field and
  a write on every order. Both numbers are wrong for it by orders of
  magnitude, and neither is a safety property: `surface-status.edn` classifies
  the whole native vector entry `:implemented-partial`, and its `:state` entry
  says plainly that **the invariant is AMBIENT, not mutation itself**.

  ## What linearity buys, and why it is not a new semantics

  If a vector handle is dead after an update, updating it in place and
  allocating a copy are indistinguishable to every observer. So this analysis
  does not change what a program MEANS. It decides when the backend may lower
  `vector-assoc` to a store instead of a copy, which is why the answer has to
  be conservative: a wrong `true` here silently mutates a value somebody still
  holds.

  ## What conservative means here

  `false` for anything not obviously linear. The shapes admitted are the ones
  a struct-of-arrays actually writes:

      (let [v (vector-i64-new n)
            v (vector-assoc v 0 x)      ; shadows — the old v is dead
            v (vector-assoc v 1 y)]
        (vector-at v 0))

  A binding that is READ after being consumed, referenced twice on one path,
  returned, passed to a function, or captured is refused. Escape analysis for
  literals already exists next door in `kotoba.native.vector-region`; this is
  the same posture applied to the update path rather than to construction.

  Not wired to a backend. `surface-status.edn` records the widening and its
  preconditions, and the lowering is one of them."
  {:kotoba/export [consuming linear-let-thread? linear-parameter? linear? reading]}
  (:require [kotoba.lang.coll :as set])
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

#?(:kotoba
   (defn- form-no-forms [] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]])))

#?(:kotoba
   (defn- form-one-form [a [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a)))

#?(:kotoba
   (defn- form-two-forms [a [:ref :form/r] b [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b)))

#?(:kotoba
   (defn- form-three-forms [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b c)))

#?(:kotoba
   (defn- form-append-form [xs [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-conj [:list [:ref :form/r]] xs x)))

#?(:kotoba
   (defn- form-mk [t :i64 s :string n :i64 k :keyword kids [:list [:ref :form/r]]] [:ref :form/r]
     (record-new [:ref :form/r] t s n k kids 0 (bytes-empty))))

#?(:kotoba
   (defn- form-nil-form [] [:ref :form/r] (form-mk 0 "" 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-bool-form [b :bool] [:ref :form/r] (form-mk 1 "" (if b 1 0) :none (form-no-forms))))

#?(:kotoba
   (defn- form-int-form [n :i64] [:ref :form/r] (form-mk 2 "" n :none (form-no-forms))))

#?(:kotoba
   (defn- form-string-form [s :string] [:ref :form/r] (form-mk 3 s 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-keyword-form [k :keyword] [:ref :form/r] (form-mk 4 "" 0 k (form-no-forms))))

#?(:kotoba
   (defn- form-symbol-form [s :string] [:ref :form/r] (form-mk 5 s 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-form-seq [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 6 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-vec [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 7 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-set [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 8 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-map [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 9 "" 0 :none kids)))

#?(:kotoba
   (defn- form-tag-of [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :tag)))

#?(:kotoba
   (defn- form-kids-of [f [:ref :form/r]] [:list [:ref :form/r]] (record-get [:ref :form/r] f :kids)))

#?(:kotoba
   (defn- form-int-value [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :n)))

#?(:kotoba
   (defn- form-string-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s)))

#?(:kotoba
   (defn- form-symbol-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s)))

#?(:kotoba
   (defn- form-keyword-value [f [:ref :form/r]] :keyword (record-get [:ref :form/r] f :k)))

#?(:kotoba
   (defn- form-bool-value [f [:ref :form/r]] :bool (= 1 (record-get [:ref :form/r] f :n))))

#?(:kotoba
   (defn- form-is-nil? [f [:ref :form/r]] :bool (= 0 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-bool? [f [:ref :form/r]] :bool (= 1 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-int? [f [:ref :form/r]] :bool (= 2 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-string? [f [:ref :form/r]] :bool (= 3 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-keyword? [f [:ref :form/r]] :bool (= 4 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-symbol? [f [:ref :form/r]] :bool (= 5 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-seq? [f [:ref :form/r]] :bool (= 6 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-vec? [f [:ref :form/r]] :bool (= 7 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-set? [f [:ref :form/r]] :bool (= 8 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-map? [f [:ref :form/r]] :bool (= 9 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-list-like? [f [:ref :form/r]] :bool (or (= 6 (form-tag-of f)) (= 7 (form-tag-of f)))))

#?(:kotoba
   (defn- form-is-true? [f [:ref :form/r]] :bool (and (= 1 (form-tag-of f)) (= 1 (record-get [:ref :form/r] f :n)))))

#?(:kotoba
   (defn- form-count-of [f [:ref :form/r]] :i64 (vector-count (form-kids-of f))))

#?(:kotoba
   (defn- form-nth-of [f [:ref :form/r] i :i64] [:ref :form/r]
     (if (and (>= i 0) (< i (form-count-of f)))
       (typed-list-nth [:list [:ref :form/r]] (form-kids-of f) i)
       (form-nil-form))))

#?(:kotoba
   (defn- form-first-of [f [:ref :form/r]] [:ref :form/r] (form-nth-of f 0)))

#?(:kotoba
   (defn- form-lookup-from [kids [:list [:ref :form/r]] key [:ref :form/r] i :i64] [:ref :form/r]
     (let [n (vector-count kids)]
       (loop [j i]
         (if (>= (+ j 1) n)
           (form-nil-form)
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))
             (recur (+ j 2))))))))

#?(:kotoba
   (defn- form-form-get [m [:ref :form/r] key [:ref :form/r]] [:ref :form/r]
     (form-lookup-from (form-kids-of m) key 0)))

#?(:kotoba
   (defn- form-lookup-has [kids [:list [:ref :form/r]] key [:ref :form/r]] :bool
     (let [n (vector-count kids)]
       (loop [j 0]
         (if (>= (+ j 1) n)
           false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             true
             (recur (+ j 2))))))))

#?(:kotoba
   (defn- form-form-has? [m [:ref :form/r] key [:ref :form/r]] :bool
     (form-lookup-has (form-kids-of m) key)))

#?(:kotoba
   (defn- form-member? [xs [:list [:ref :form/r]] x [:ref :form/r]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) x) true (recur (inc i))))))))

#?(:kotoba
   (defn- form-ordered-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) (typed-list-nth [:list [:ref :form/r]] ys i))
               (recur (inc i))
               false)))
         false))))

#?(:kotoba
   (defn- form-set-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-member? ys (typed-list-nth [:list [:ref :form/r]] xs i)) (recur (inc i)) false)))
         false))))

#?(:kotoba
   (defn- form-map-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [j 0]
           (if (>= (+ j 1) n) true
             (let [k (typed-list-nth [:list [:ref :form/r]] xs j)]
               (if (and (form-lookup-has ys k)
                        (form-eq (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)) (form-lookup-from ys k 0)))
                 (recur (+ j 2))
                 false))))
         false))))

#?(:kotoba
   (defn- form-eq
     "Structural equality, as `=` on the host's data: a list and a vector are
     different kinds here (as are they to the reader), sets and maps compare
     without order."
     [a [:ref :form/r] b [:ref :form/r]] :bool
     (let [t (form-tag-of a)]
       (and (= t (form-tag-of b))
            (cond
              (= t 0) true
              (= t 1) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 2) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 3) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 4) (= (record-get [:ref :form/r] a :k) (record-get [:ref :form/r] b :k))
              (= t 5) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 8) (form-set-eq (form-kids-of a) (form-kids-of b))
              (= t 9) (form-map-eq (form-kids-of a) (form-kids-of b))
              :else (form-ordered-eq (form-kids-of a) (form-kids-of b)))))))

#?(:kotoba
   (defn- form-rest-list
     "The kids of F after the first, as a list."
     [f [:ref :form/r]] [:list [:ref :form/r]]
     (let [xs (form-kids-of f)
           n (vector-count xs)]
       (loop [i 1 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i))))))))

#?(:kotoba
   (defn- form-last-of [f [:ref :form/r]] [:ref :form/r]
     (form-nth-of f (dec (form-count-of f)))))

#?(:kotoba
   (defn- form-cons-onto [x [:ref :form/r] xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count xs)]
       (loop [i 0 acc (form-one-form x)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i))))))))

#?(:kotoba
   (defn- form-assoc-form
     "Map M with K bound to V: the first entry whose key is K keeps its place and
     takes V, else K V are appended (as `assoc` on the host's map)."
     [m [:ref :form/r] k [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (let [xs (form-kids-of m)
           n (vector-count xs)]
       (if (form-lookup-has xs k)
         (form-form-map
          (loop [j 0 acc (form-no-forms)]
            (if (>= (+ j 1) n)
              acc
              (let [key (typed-list-nth [:list [:ref :form/r]] xs j)]
                (recur (+ j 2)
                       (typed-list-conj [:list [:ref :form/r]]
                                        (typed-list-conj [:list [:ref :form/r]] acc key)
                                        (if (form-eq key k) v (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)))))))))
         (form-form-map (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] xs k) v))))))

#?(:kotoba
   (defn- form-call0 [name :string] [:ref :form/r] (form-form-seq (form-one-form (form-symbol-form name)))))

#?(:kotoba
   (defn- form-call1 [name :string a [:ref :form/r]] [:ref :form/r]
     (form-form-seq (form-two-forms (form-symbol-form name) a))))

#?(:kotoba
   (defn- form-call2 [name :string a [:ref :form/r] b [:ref :form/r]] [:ref :form/r]
     (form-form-seq (form-three-forms (form-symbol-form name) a b))))

#?(:kotoba
   (defn- form-call3 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c))))

#?(:kotoba
   (defn- form-call4 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d))))

#?(:kotoba
   (defn- form-call5 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d) e))))

#?(:kotoba
   (defn- form-call6 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r] f [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d) e) f))))

#?(:kotoba
   (defn- form-vec2 [a [:ref :form/r] b [:ref :form/r]] [:ref :form/r] (form-form-vec (form-two-forms a b))))

#?(:kotoba
   (defn- form-vec3 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r] (form-form-vec (form-three-forms a b c))))

#?(:kotoba
   (defn- form-vec4 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d))))

#?(:kotoba
   (defn- form-vec5 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d) e))))

#?(:kotoba
   (defn- form-vec6 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r] f [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d) e) f))))



;; clojure.core/some, spelled as the loop it is. In Kotoba `some` is the
;; option constructor and a two-argument `(some pred coll)` is refused as a
;; name collision (kotoba-sema frontend); this is the same definition as
;; clojure.core/some -- the first logical-true (pred x), in order, stopping
;; there -- so the host answer is unchanged on nbb and the JVM.
#?(:kotoba
   (defn- sym-is? [f [:ref :form/r] name :string] :bool
     (and (form-is-symbol? f) (string=? (form-symbol-value f) name)))
   :default
   (defn- first-truthy [pred coll]
     (loop [s (seq coll)]
       (when s
         (or (pred (first s)) (recur (next s)))))))

#?(:kotoba nil
   :default
   (defn- symbol-set-contains? [items item]
     (contains? items item)))

#?(:kotoba
   (defn- fold-any [xs [:list [:ref :form/r]] ok :bool] :bool ok))



#?(:kotoba
   (defn consuming
     "Operations that make the vector they are given dead."
     [] [:set :symbol]
     (typed-set-new [:set :symbol] (symbol "vector-assoc") (symbol "vector-f64-assoc") (symbol "vector-conj")
                    (symbol "vector-f64-conj") (symbol "vector-drop") (symbol "vector-f64-drop")
                    (symbol "vector-take") (symbol "vector-f64-take")))
   :default
   (def consuming
     "Operations that make the vector they are given dead.

     `vector-drop` is here with the assoc family: it returns a view of a suffix,
     and a view whose parent is later written in place is a view of something
     else. Admitting it as non-consuming would make the one operation that
     ALIASES the safe one."
     '#{vector-assoc vector-f64-assoc vector-conj vector-f64-conj
        vector-drop vector-f64-drop
        ;; `vector-take` answers a view of a PREFIX (machine_ir lowers it onto
        ;; the bytes-slice view), so it aliases for `vector-drop`'s reason.
        vector-take vector-f64-take}))

#?(:kotoba
   (defn- consuming-op? [f [:ref :form/r]] :bool
     (or (sym-is? f "vector-assoc") (sym-is? f "vector-f64-assoc") (sym-is? f "vector-conj")
         (sym-is? f "vector-f64-conj") (sym-is? f "vector-drop") (sym-is? f "vector-f64-drop")
         (sym-is? f "vector-take") (sym-is? f "vector-f64-take"))))



#?(:kotoba
   (defn reading
     "Operations that observe without consuming."
     [] [:set :symbol]
     (typed-set-new [:set :symbol] (symbol "vector-count") (symbol "vector-f64-count") (symbol "vector-at")
                    (symbol "vector-f64-at") (symbol "vector-get") (symbol "vector-f64-get") (symbol "nth")))
   :default
   (def reading
     "Operations that observe without consuming."
     '#{vector-count vector-f64-count vector-at vector-f64-at
        vector-get vector-f64-get nth}))

#?(:kotoba
   (defn- reading-op? [f [:ref :form/r]] :bool
     (or (sym-is? f "vector-count") (sym-is? f "vector-f64-count") (sym-is? f "vector-at")
         (sym-is? f "vector-f64-at") (sym-is? f "vector-get") (sym-is? f "vector-f64-get")
         (sym-is? f "nth"))))



#?(:kotoba
   (defn- branching-op? [f [:ref :form/r]] :bool
     (or (sym-is? f "if") (sym-is? f "cond") (sym-is? f "case") (sym-is? f "when")
         (sym-is? f "when-not") (sym-is? f "if-let") (sym-is? f "when-let")))
   :default
   (def ^:private branching
     "Heads whose arms are alternatives, not a sequence.

     Only one arm runs, so uses in different arms are uses on DIFFERENT PATHS and
     the count is the maximum rather than the sum. Getting this wrong is not a
     small conservatism: the shape Kotoba programs actually use to thread a
     vector is tail recursion, base case reading and step case consuming --

         (defn go [v :vector-i64 i :i64 n :i64] :i64
           (if (>= i n)
             (vector-at v 0)
             (go (vector-assoc v 0 i) (+ i 1) n)))

     -- and summing the arms calls that two uses, which refuses the one shape
     that matters."
     '#{if cond case when when-not if-let when-let}))



#?(:kotoba
   (defn- sum-uses [xs [:list [:ref :form/r]] from :i64 target [:ref :form/r]] :i64
     (let [n (vector-count xs)]
       (loop [i from acc 0]
         (if (>= i n)
           acc
           (recur (inc i) (+ acc (sym-uses (typed-list-nth [:list [:ref :form/r]] xs i) target)))))))
   :default
   (defn- sym-uses
     "How many times `target` can be used on the WORST SINGLE PATH through
     `form`.

     Counted rather than detected, because `at most once` is the question and
     `appears at all` is a different one — a binding used twice on one path
     cannot be consumed by either use."
     [form target]
     (cond
       (= form target) 1
       (and (seq? form) (symbol-set-contains? branching (first form)) (< 2 (count form)))
       ;; The test runs on every path; the arms are alternatives. This does not
       ;; separate `cond`/`case` tests from their arms, which over-counts a test
       ;; and never under-counts an arm -- the safe direction.
       (+ (sym-uses (second form) target)
          (reduce max 0 (map #(sym-uses % target) (drop 2 form))))
       (seq? form) (reduce + 0 (map #(sym-uses % target) form))
       (vector? form) (reduce + 0 (map #(sym-uses % target) form))
       (map? form) (reduce + 0 (map #(+ (sym-uses (key %) target)
                                        (sym-uses (val %) target)) form))
       (set? form) (reduce + 0 (map #(sym-uses % target) form))
       :else 0)))

#?(:kotoba
   (defn- max-uses [xs [:list [:ref :form/r]] from :i64 target [:ref :form/r]] :i64
     (let [n (vector-count xs)]
       (loop [i from acc 0]
         (if (>= i n)
           acc
           (let [u (sym-uses (typed-list-nth [:list [:ref :form/r]] xs i) target)]
             (recur (inc i) (if (> u acc) u acc))))))))

#?(:kotoba
   ;; How many times TARGET can be used on the worst single path through F.
   (defn- sym-uses [f [:ref :form/r] target [:ref :form/r]] :i64
     (cond
       (form-eq f target) 1
       (and (form-is-seq? f) (branching-op? (form-first-of f)) (< 2 (form-count-of f)))
       (+ (sym-uses (form-nth-of f 1) target) (max-uses (form-kids-of f) 2 target))
       (form-is-seq? f) (sum-uses (form-kids-of f) 0 target)
       (form-is-vec? f) (sum-uses (form-kids-of f) 0 target)
       (form-is-map? f) (sum-uses (form-kids-of f) 0 target)
       (form-is-set? f) (sum-uses (form-kids-of f) 0 target)
       :else 0)))



#?(:kotoba
   (defn- consuming-call? [f [:ref :form/r] target [:ref :form/r]] :bool
     (and (form-is-seq? f) (consuming-op? (form-first-of f)) (form-eq target (form-nth-of f 1))))
   :default
   (defn- consuming-call?
     [form target]
     (and (seq? form)
          (symbol-set-contains? consuming (first form))
          (= target (second form)))))



#?(:kotoba
   (defn- reading-call? [f [:ref :form/r] target [:ref :form/r]] :bool
     (and (form-is-seq? f) (reading-op? (form-first-of f)) (form-eq target (form-nth-of f 1))))
   :default
   (defn- reading-call?
     [form target]
     (and (seq? form)
          (symbol-set-contains? reading (first form))
          (= target (second form)))))



#?(:kotoba
   (defn- kids-zero-from [xs [:list [:ref :form/r]] from :i64 target [:ref :form/r]] :bool
     (let [n (vector-count xs)]
       (loop [i from]
         (if (>= i n)
           true
           (if (= 0 (sym-uses (typed-list-nth [:list [:ref :form/r]] xs i) target)) (recur (inc i)) false)))))
   :default
   (defn- position-ok?
     "`target` may appear only as the FIRST argument of a vector operation.

     Anywhere else — an argument to something that is not a vector operation, a
     return value, an element being stored — is an escape: the handle reaches
     code this analysis cannot see, and code it cannot see may hold it."
     [form target]
     (cond
       (= form target) false
       (seq? form)
       (if (or (consuming-call? form target) (reading-call? form target))
         ;; The first argument is the vector; every other argument must not
         ;; mention it. `(vector-assoc v 0 v)` stores the handle into itself.
         (every? #(zero? (sym-uses % target)) (drop 2 form))
         (every? #(position-ok? % target) form))
       (vector? form) (every? #(position-ok? % target) form)
       (map? form) (every? #(and (position-ok? (key %) target)
                                 (position-ok? (val %) target)) form)
       (set? form) (every? #(position-ok? % target) form)
       :else true)))

#?(:kotoba
   (defn- kids-position-ok? [xs [:list [:ref :form/r]] target [:ref :form/r]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n)
           true
           (if (position-ok? (typed-list-nth [:list [:ref :form/r]] xs i) target) (recur (inc i)) false))))))

#?(:kotoba
   ;; TARGET may appear only as the FIRST argument of a vector operation.
   (defn- position-ok? [f [:ref :form/r] target [:ref :form/r]] :bool
     (cond
       (form-eq f target) false
       (form-is-seq? f)
       (if (or (consuming-call? f target) (reading-call? f target))
         (kids-zero-from (form-kids-of f) 2 target)
         (kids-position-ok? (form-kids-of f) target))
       (form-is-vec? f) (kids-position-ok? (form-kids-of f) target)
       (form-is-map? f) (kids-position-ok? (form-kids-of f) target)
       (form-is-set? f) (kids-position-ok? (form-kids-of f) target)
       :else true)))



#?(:kotoba
   (defn linear?
     "True when TARGET may be updated in place inside F."
     [f [:ref :form/r] target [:ref :form/r]] :bool
     (and (<= (sym-uses f target) 1)
          (position-ok? f target)))
   :default
   (defn linear?
     "True when `target` may be updated in place inside `form`.

     Three conditions, and each of them is a way a wrong `true` would corrupt a
     live value:

     1. **at most one use** — two uses on one path means the second sees what the
        first consumed
     2. **every use is in vector-operation position** — anywhere else the handle
        escapes to code this cannot see
     3. **a consumed binding is not read afterwards** — enforced by 1, and stated
        because it is the property that matters"
     [form target]
     (and (<= (sym-uses form target) 1)
          (position-ok? form target))))



#?(:kotoba
   (defn- pair-count [bindings [:ref :form/r]] :i64 (quot (form-count-of bindings) 2))
   :default
   (defn- binding-pairs [bindings] (partition 2 bindings)))



#?(:kotoba
   (defn linear-parameter?
     "True when a function parameter is threaded linearly through its body."
     [body [:ref :form/r] param [:ref :form/r]] :bool
     (linear? body param))
   :default
   (defn linear-parameter?
     "True when a function parameter is threaded linearly through its body.

     The shape Kotoba actually uses, because `let` cannot rebind a name:

         (defn go [v :vector-i64 i :i64 n :i64] :i64
           (if (>= i n)
             (vector-at v 0)
             (go (vector-assoc v 0 i) (+ i 1) n)))

     One use per path -- read in the base case, consumed in the step -- which is
     linear exactly when alternatives are counted as alternatives."
     [body param]
     (linear? body param)))



#?(:kotoba
   (defn- init-of [bindings [:ref :form/r] p :i64] [:ref :form/r] (form-nth-of bindings (+ (* 2 p) 1)))
   :default
   (defn linear-let-thread?
     "True when a `let` threads a vector through DISTINCT names, each consuming
     the one before.

         (let [a (vector-new 1 2 3)
               b (vector-assoc a 0 9)]
           (vector-at b 0))

     ## Distinct names, because the language refuses the other shape

     This was `linear-let-chain?` and looked for one name rebound over and over
     -- `v`, then `v`, then `v` -- which is how the same idea is written in
     Clojure. **Kotoba refuses it**: `amu check` answers `duplicate let binding`
     (measured 2026-09-01, amu e96dd8c6). So the first version described a
     program that cannot be written, and would have been a gate nothing could
     ever pass. Found by compiling one."
     [form names]
     (and (seq? form) (= 'let (first form)) (vector? (second form))
          (<= 2 (count names))
          (let [pairs (vec (binding-pairs (second form)))
                body (drop 2 form)
                bound (set (map first pairs))]
            (and (every? (fn [name] (symbol-set-contains? bound name)) names)
                 ;; Every name in the thread is used at most once across all the
                 ;; initialisers, only in vector-operation position, and linearly
                 ;; in the body. A name read after the update that consumed it is
                 ;; exactly what makes an in-place store visible to somebody who
                 ;; did not ask for it.
                 (every? (fn [n]
                           (and (<= (reduce + 0 (map #(sym-uses (second %) n) pairs)) 1)
                                (every? #(position-ok? (second %) n) pairs)))
                         names)
                 ;; Every name but the last is consumed by some later initialiser,
                 ;; and is then DEAD -- zero uses in the body. `linear?` is not
                 ;; enough here: one read of a consumed name is still one use, and
                 ;; it is precisely the read that would see the in-place store.
                 (every? (fn [n]
                           (and (first-truthy (fn [pair] (consuming-call? (second pair) n)) pairs)
                                (every? #(zero? (sym-uses % n)) body)))
                         (butlast names))
                 ;; The last name is the live one and may be read, linearly.
                 (let [live (last names)]
                   (every? #(linear? % live) body)))))))

#?(:kotoba
   (defn- name-of [bindings [:ref :form/r] p :i64] [:ref :form/r] (form-nth-of bindings (* 2 p))))

#?(:kotoba
   (defn- inits-uses [bindings [:ref :form/r] n [:ref :form/r]] :i64
     (let [c (pair-count bindings)]
       (loop [p 0 acc 0]
         (if (>= p c) acc (recur (inc p) (+ acc (sym-uses (init-of bindings p) n))))))))

#?(:kotoba
   (defn- inits-position-ok? [bindings [:ref :form/r] n [:ref :form/r]] :bool
     (let [c (pair-count bindings)]
       (loop [p 0]
         (if (>= p c) true (if (position-ok? (init-of bindings p) n) (recur (inc p)) false))))))

#?(:kotoba
   (defn- some-init-consumes? [bindings [:ref :form/r] n [:ref :form/r]] :bool
     (let [c (pair-count bindings)]
       (loop [p 0]
         (if (>= p c) false (if (consuming-call? (init-of bindings p) n) true (recur (inc p))))))))

#?(:kotoba
   (defn- is-bound? [bindings [:ref :form/r] n [:ref :form/r]] :bool
     (let [c (pair-count bindings)]
       (loop [p 0]
         (if (>= p c) false (if (form-eq (name-of bindings p) n) true (recur (inc p))))))))

#?(:kotoba
   (defn- body-zero? [f [:ref :form/r] n [:ref :form/r]] :bool (kids-zero-from (form-kids-of f) 2 n)))

#?(:kotoba
   (defn- body-linear? [f [:ref :form/r] n [:ref :form/r]] :bool
     (let [xs (form-kids-of f)
           c (vector-count xs)]
       (loop [i 2]
         (if (>= i c) true (if (linear? (typed-list-nth [:list [:ref :form/r]] xs i) n) (recur (inc i)) false))))))

#?(:kotoba
   (defn- all-names [names [:ref :form/r] f [:ref :form/r] bindings [:ref :form/r]] :bool
     (let [c (form-count-of names)]
       (loop [i 0]
         (if (>= i c)
           true
           (let [n (form-nth-of names i)]
             (if (and (is-bound? bindings n)
                      (<= (inits-uses bindings n) 1)
                      (inits-position-ok? bindings n))
               (recur (inc i))
               false)))))))

#?(:kotoba
   (defn- all-but-last [names [:ref :form/r] f [:ref :form/r] bindings [:ref :form/r]] :bool
     (let [c (dec (form-count-of names))]
       (loop [i 0]
         (if (>= i c)
           true
           (let [n (form-nth-of names i)]
             (if (and (some-init-consumes? bindings n) (body-zero? f n))
               (recur (inc i))
               false)))))))

#?(:kotoba
   (defn linear-let-thread?
     "True when a `let` threads a vector through DISTINCT names, each consuming
     the one before."
     [f [:ref :form/r] names [:ref :form/r]] :bool
     (and (form-is-seq? f)
          (sym-is? (form-first-of f) "let")
          (form-is-vec? (form-nth-of f 1))
          (<= 2 (form-count-of names))
          (let [bindings (form-nth-of f 1)]
            (and (all-names names f bindings)
                 (all-but-last names f bindings)
                 (body-linear? f (form-last-of names)))))))
