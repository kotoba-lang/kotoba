(ns kotoba.native.aggregate-abi
  "Portable contract for aggregates that reach a native function boundary.

  Word-field records, including recursively nested records, and variants whose
  payload is either scalar or a recursively boxed record cross extracted calls
  as one-word context-owned pair handles. Local flat non-escaping aggregates
  remain replaced."
  {:kotoba/export [admit-closed-linkage! admit-extracted-call! aggregate-payload-variant-type? call-profile contract hetero-vector-type? nested-record-type? record-boundary-plan reject-unextracted-call! scalar-record-type? scalar-variant-type? validate-contract! variant-boundary-plan contract-valid?]}
  (:require [kotoba.lang.coll :as set])
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

#?(:kotoba
   (defn- form-no-forms [] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]])))

#?(:kotoba
   (defn- form-one-form [a [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a)))

#?(:kotoba
   (defn- form-two-forms [a [:ref :form/r] b [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b)))

#?(:kotoba
   (defn- form-three-forms [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b c)))

#?(:kotoba
   (defn- form-append-form [xs [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-conj [:list [:ref :form/r]] xs x)))

#?(:kotoba
   (defn- form-mk [t :i64 s :string n :i64 k :keyword kids [:list [:ref :form/r]]] [:ref :form/r]
     (record-new [:ref :form/r] t s n k kids 0 (bytes-empty))))

#?(:kotoba
   (defn- form-nil-form [] [:ref :form/r] (form-mk 0 "" 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-bool-form [b :bool] [:ref :form/r] (form-mk 1 "" (if b 1 0) :none (form-no-forms))))

#?(:kotoba
   (defn- form-int-form [n :i64] [:ref :form/r] (form-mk 2 "" n :none (form-no-forms))))

#?(:kotoba
   (defn- form-string-form [s :string] [:ref :form/r] (form-mk 3 s 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-keyword-form [k :keyword] [:ref :form/r] (form-mk 4 "" 0 k (form-no-forms))))

#?(:kotoba
   (defn- form-symbol-form [s :string] [:ref :form/r] (form-mk 5 s 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-form-seq [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 6 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-vec [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 7 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-set [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 8 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-map [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 9 "" 0 :none kids)))

#?(:kotoba
   (defn- form-tag-of [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :tag)))

#?(:kotoba
   (defn- form-kids-of [f [:ref :form/r]] [:list [:ref :form/r]] (record-get [:ref :form/r] f :kids)))

#?(:kotoba
   (defn- form-int-value [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :n)))

#?(:kotoba
   (defn- form-string-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s)))

#?(:kotoba
   (defn- form-symbol-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s)))

#?(:kotoba
   (defn- form-keyword-value [f [:ref :form/r]] :keyword (record-get [:ref :form/r] f :k)))

#?(:kotoba
   (defn- form-bool-value [f [:ref :form/r]] :bool (= 1 (record-get [:ref :form/r] f :n))))

#?(:kotoba
   (defn- form-is-nil? [f [:ref :form/r]] :bool (= 0 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-bool? [f [:ref :form/r]] :bool (= 1 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-int? [f [:ref :form/r]] :bool (= 2 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-string? [f [:ref :form/r]] :bool (= 3 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-keyword? [f [:ref :form/r]] :bool (= 4 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-symbol? [f [:ref :form/r]] :bool (= 5 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-seq? [f [:ref :form/r]] :bool (= 6 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-vec? [f [:ref :form/r]] :bool (= 7 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-set? [f [:ref :form/r]] :bool (= 8 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-map? [f [:ref :form/r]] :bool (= 9 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-list-like? [f [:ref :form/r]] :bool (or (= 6 (form-tag-of f)) (= 7 (form-tag-of f)))))

#?(:kotoba
   (defn- form-is-true? [f [:ref :form/r]] :bool (and (= 1 (form-tag-of f)) (= 1 (record-get [:ref :form/r] f :n)))))

#?(:kotoba
   (defn- form-count-of [f [:ref :form/r]] :i64 (vector-count (form-kids-of f))))

#?(:kotoba
   (defn- form-nth-of [f [:ref :form/r] i :i64] [:ref :form/r]
     (if (and (>= i 0) (< i (form-count-of f)))
       (typed-list-nth [:list [:ref :form/r]] (form-kids-of f) i)
       (form-nil-form))))

#?(:kotoba
   (defn- form-first-of [f [:ref :form/r]] [:ref :form/r] (form-nth-of f 0)))

#?(:kotoba
   (defn- form-lookup-from [kids [:list [:ref :form/r]] key [:ref :form/r] i :i64] [:ref :form/r]
     (let [n (vector-count kids)]
       (loop [j i]
         (if (>= (+ j 1) n)
           (form-nil-form)
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))
             (recur (+ j 2))))))))

#?(:kotoba
   (defn- form-form-get [m [:ref :form/r] key [:ref :form/r]] [:ref :form/r]
     (form-lookup-from (form-kids-of m) key 0)))

#?(:kotoba
   (defn- form-lookup-has [kids [:list [:ref :form/r]] key [:ref :form/r]] :bool
     (let [n (vector-count kids)]
       (loop [j 0]
         (if (>= (+ j 1) n)
           false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             true
             (recur (+ j 2))))))))

#?(:kotoba
   (defn- form-form-has? [m [:ref :form/r] key [:ref :form/r]] :bool
     (form-lookup-has (form-kids-of m) key)))

#?(:kotoba
   (defn- form-member? [xs [:list [:ref :form/r]] x [:ref :form/r]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) x) true (recur (inc i))))))))

#?(:kotoba
   (defn- form-ordered-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) (typed-list-nth [:list [:ref :form/r]] ys i))
               (recur (inc i))
               false)))
         false))))

#?(:kotoba
   (defn- form-set-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-member? ys (typed-list-nth [:list [:ref :form/r]] xs i)) (recur (inc i)) false)))
         false))))

#?(:kotoba
   (defn- form-map-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [j 0]
           (if (>= (+ j 1) n) true
             (let [k (typed-list-nth [:list [:ref :form/r]] xs j)]
               (if (and (form-lookup-has ys k)
                        (form-eq (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)) (form-lookup-from ys k 0)))
                 (recur (+ j 2))
                 false))))
         false))))

#?(:kotoba
   (defn- form-eq
     "Structural equality, as `=` on the host's data: a list and a vector are
     different kinds here (as are they to the reader), sets and maps compare
     without order."
     [a [:ref :form/r] b [:ref :form/r]] :bool
     (let [t (form-tag-of a)]
       (and (= t (form-tag-of b))
            (cond
              (= t 0) true
              (= t 1) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 2) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 3) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 4) (= (record-get [:ref :form/r] a :k) (record-get [:ref :form/r] b :k))
              (= t 5) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 8) (form-set-eq (form-kids-of a) (form-kids-of b))
              (= t 9) (form-map-eq (form-kids-of a) (form-kids-of b))
              :else (form-ordered-eq (form-kids-of a) (form-kids-of b)))))))

#?(:kotoba
   (defn- form-rest-list
     "The kids of F after the first, as a list."
     [f [:ref :form/r]] [:list [:ref :form/r]]
     (let [xs (form-kids-of f)
           n (vector-count xs)]
       (loop [i 1 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i))))))))

#?(:kotoba
   (defn- form-last-of [f [:ref :form/r]] [:ref :form/r]
     (form-nth-of f (dec (form-count-of f)))))

#?(:kotoba
   (defn- form-cons-onto [x [:ref :form/r] xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count xs)]
       (loop [i 0 acc (form-one-form x)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i))))))))

#?(:kotoba
   (defn- form-assoc-form
     "Map M with K bound to V: the first entry whose key is K keeps its place and
     takes V, else K V are appended (as `assoc` on the host's map)."
     [m [:ref :form/r] k [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (let [xs (form-kids-of m)
           n (vector-count xs)]
       (if (form-lookup-has xs k)
         (form-form-map
          (loop [j 0 acc (form-no-forms)]
            (if (>= (+ j 1) n)
              acc
              (let [key (typed-list-nth [:list [:ref :form/r]] xs j)]
                (recur (+ j 2)
                       (typed-list-conj [:list [:ref :form/r]]
                                        (typed-list-conj [:list [:ref :form/r]] acc key)
                                        (if (form-eq key k) v (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)))))))))
         (form-form-map (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] xs k) v))))))

#?(:kotoba
   (defn- form-call0 [name :string] [:ref :form/r] (form-form-seq (form-one-form (form-symbol-form name)))))

#?(:kotoba
   (defn- form-call1 [name :string a [:ref :form/r]] [:ref :form/r]
     (form-form-seq (form-two-forms (form-symbol-form name) a))))

#?(:kotoba
   (defn- form-call2 [name :string a [:ref :form/r] b [:ref :form/r]] [:ref :form/r]
     (form-form-seq (form-three-forms (form-symbol-form name) a b))))

#?(:kotoba
   (defn- form-call3 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c))))

#?(:kotoba
   (defn- form-call4 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d))))

#?(:kotoba
   (defn- form-call5 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d) e))))

#?(:kotoba
   (defn- form-call6 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r] f [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d) e) f))))

#?(:kotoba
   (defn- form-vec2 [a [:ref :form/r] b [:ref :form/r]] [:ref :form/r] (form-form-vec (form-two-forms a b))))

#?(:kotoba
   (defn- form-vec3 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r] (form-form-vec (form-three-forms a b c))))

#?(:kotoba
   (defn- form-vec4 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d))))

#?(:kotoba
   (defn- form-vec5 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d) e))))

#?(:kotoba
   (defn- form-vec6 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r] f [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d) e) f))))

#?(:kotoba
   (defn- form-doc-at [d :document i :i64] :document
     (option-value-of [:option :document] (document-vector-at d i) (document-null))))

#?(:kotoba
   (defn- form-doc-list-at [d :document i :i64] :document
     (option-value-of [:option :document] (document-list-at d i) (document-null))))

#?(:kotoba
   (defn- form-doc-entry-at [d :document i :i64] :document
     (option-value-of [:option :document] (document-map-entry-at d i) (document-null))))

#?(:kotoba
   (defn- form-doc-items [d :document list? :bool] [:list [:ref :form/r]]
     (let [n (document-count d)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i)
                  (typed-list-conj [:list [:ref :form/r]] acc
                                   (form-from-document (if list? (form-doc-list-at d i) (form-doc-at d i))))))))))

#?(:kotoba
   (defn- form-doc-map-items [d :document] [:list [:ref :form/r]]
     (let [n (document-count d)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n)
           acc
           (let [e (form-doc-entry-at d i)]
             (recur (inc i)
                    (typed-list-conj [:list [:ref :form/r]]
                                     (typed-list-conj [:list [:ref :form/r]] acc (form-from-document (form-doc-at e 0)))
                                     (form-from-document (form-doc-at e 1))))))))))

#?(:kotoba
   (defn- form-set-marker? [d :document] :bool
     (and (> (document-count d) 0)
          (= (document-kind (form-doc-at d 0)) :keyword)
          (= (option-value-of [:option :keyword] (document-keyword-value (form-doc-at d 0)) :none) :kotoba.form/set))))

#?(:kotoba
   (defn- form-doc-set-items [d :document] [:list [:ref :form/r]]
     (let [n (document-count d)]
       (loop [i 1 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (form-from-document (form-doc-at d i)))))))))

#?(:kotoba
   (defn- form-from-document [d :document] [:ref :form/r]
     (let [kind (document-kind d)]
       (cond
         (= kind :bool) (form-bool-form (option-value-of [:option :bool] (document-bool-value d) false))
         (= kind :i64) (form-int-form (option-value-of [:option :i64] (document-i64-value d) 0))
         (= kind :string) (form-string-form (option-value-of [:option :string] (document-string-value d) ""))
         (= kind :keyword) (form-keyword-form (option-value-of [:option :keyword] (document-keyword-value d) :none))
         (= kind :vector) (if (form-set-marker? d) (form-form-set (form-doc-set-items d)) (form-form-vec (form-doc-items d false)))
         (= kind :list) (form-form-seq (form-doc-items d true))
         (= kind :set) (form-form-set (form-doc-items d false))
         (= kind :map) (form-form-map (form-doc-map-items d))
         :else (form-nil-form)))))

#?(:kotoba
   (defn- form-keyword-has-namespace? [f [:ref :form/r]] :bool
     (and (= 4 (form-tag-of f))
          (>= (string-find-byte (document-edn-print (document-keyword (record-get [:ref :form/r] f :k))) 47 0) 0))))

#?(:kotoba
   (defn- form-keys-of [m [:ref :form/r]] [:ref :form/r]
     (let [xs (form-kids-of m)
           n (vector-count xs)]
       (form-form-set
        (loop [j 0 acc (form-no-forms)]
          (if (>= j n)
            acc
            (recur (+ j 2) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs j)))))))))



#?(:kotoba
   (def ^:private contract-text
     "{:abi/id :kotoba.native/aggregate-boundary
      :abi/version 8
      :abi/word-bits 64
      :portable/record
      {:boundary/parameters :pair-chain-handle
       :boundary/results :pair-chain-handle
       :boundary/word-count 1
       :boundary/layout :declaration-order
       :boundary/field-representation :recursive-word-handles
       :boundary/max-nesting-depth 32
       :boundary/terminator 0
       :boundary/allocation :context-pair-arena
       :boundary/ownership :host-context
       :boundary/arena-cell-limit 4096}
      :portable/variant
      {:boundary/parameters :pair-tag-payload-handle
       :boundary/results :pair-tag-payload-handle
       :boundary/word-count 1
       :boundary/tag :zero-based-declaration-ordinal
       :boundary/payload-types [:kotoba.form/set :i64 :bool :record :handle]
       :boundary/payload-representation :recursive-word-handles
       :boundary/max-payload-nesting-depth 32
       :boundary/bool-words [:kotoba.form/set 0 1]
       :boundary/case-limit 32
       :boundary/allocation :context-pair-arena
       :boundary/ownership :host-context
       :boundary/arena-cell-limit 4096}
      :extracted
      {:local-record :scalar-replacement
       :local-variant :scalar-replacement
       :record-boundary :word-pair-chain-admitted
       :variant-boundary :recursive-payload-pair-handle-admitted
       :call-admission :sealed-callable-admitted
       :call-requires [:kotoba.form/set :per-function-frame
                        :spill-live-values-across-call
                        :parallel-argument-assignment
                        :single-word-return-register]
       :callable-dispatch {:indirect :closed-ordinal-dispatch
                           :apply :bounded-pair-chain
                           :max-apply-arguments 4
                           :arbitrary-address false}
       :linkage {:mode :closed-module-graph
                 :ambient-symbols false
                 :unresolved-symbols false}}
      :targets
      {:x86-64
       {:argument-registers [:x86-64/rdi :x86-64/rsi :x86-64/rdx
                             :x86-64/rcx :x86-64/r8]
        :return-register :x86-64/rax
        :allocator-registers [:x86-64/rax :x86-64/rcx :x86-64/rdx :x86-64/r8]
        :call-clobbers :all-allocator-registers}
       :aarch64
       {:argument-registers [:aarch64/x0 :aarch64/x1 :aarch64/x2
                             :aarch64/x3 :aarch64/x4]
        :return-register :aarch64/x0
        :allocator-registers [:aarch64/x0 :aarch64/x1
                              :aarch64/x2 :aarch64/x3]
        :call-clobbers :all-allocator-registers}}}")
   :default
   (def contract
     {:abi/id :kotoba.native/aggregate-boundary
      :abi/version 8
      :abi/word-bits 64
      :portable/record
      {:boundary/parameters :pair-chain-handle
       :boundary/results :pair-chain-handle
       :boundary/word-count 1
       :boundary/layout :declaration-order
       :boundary/field-representation :recursive-word-handles
       :boundary/max-nesting-depth 32
       :boundary/terminator 0
       :boundary/allocation :context-pair-arena
       :boundary/ownership :host-context
       :boundary/arena-cell-limit 4096}
      :portable/variant
      {:boundary/parameters :pair-tag-payload-handle
       :boundary/results :pair-tag-payload-handle
       :boundary/word-count 1
       :boundary/tag :zero-based-declaration-ordinal
       :boundary/payload-types #{:i64 :bool :record :handle}
       :boundary/payload-representation :recursive-word-handles
       :boundary/max-payload-nesting-depth 32
       :boundary/bool-words #{0 1}
       :boundary/case-limit 32
       :boundary/allocation :context-pair-arena
       :boundary/ownership :host-context
       :boundary/arena-cell-limit 4096}
      :extracted
      {:local-record :scalar-replacement
       :local-variant :scalar-replacement
       :record-boundary :word-pair-chain-admitted
       :variant-boundary :recursive-payload-pair-handle-admitted
       :call-admission :sealed-callable-admitted
       :call-requires #{:per-function-frame
                        :spill-live-values-across-call
                        :parallel-argument-assignment
                        :single-word-return-register}
       :callable-dispatch {:indirect :closed-ordinal-dispatch
                           :apply :bounded-pair-chain
                           :max-apply-arguments 4
                           :arbitrary-address false}
       :linkage {:mode :closed-module-graph
                 :ambient-symbols false
                 :unresolved-symbols false}}
      :targets
      {:x86-64
       {:argument-registers [:x86-64/rdi :x86-64/rsi :x86-64/rdx
                             :x86-64/rcx :x86-64/r8]
        :return-register :x86-64/rax
        :allocator-registers [:x86-64/rax :x86-64/rcx :x86-64/rdx :x86-64/r8]
        :call-clobbers :all-allocator-registers}
       :aarch64
       {:argument-registers [:aarch64/x0 :aarch64/x1 :aarch64/x2
                             :aarch64/x3 :aarch64/x4]
        :return-register :aarch64/x0
        :allocator-registers [:aarch64/x0 :aarch64/x1
                              :aarch64/x2 :aarch64/x3]
        :call-clobbers :all-allocator-registers}}}))

#?(:kotoba
   (defn- contract-form [] [:ref :form/r]
     (form-from-document (document-edn-read contract-text))))

#?(:kotoba
   (defn contract [] [:ref :form/r] (contract-form)))



#?(:kotoba
   (defn- reject! [problem :keyword] :i64
     ;; The host's data carries the offending value; the twin carries the problem.
     (throw (ex-info "aggregate ABI rejected" {:phase :aggregate-abi :problem problem})))
   :default
   (defn- reject! [problem value]
     (throw (ex-info (str "aggregate ABI rejected: " (name problem))
                     {:phase :aggregate-abi :problem problem :value value}))))



(def ^:private max-record-nesting-depth 32)



#?(:kotoba
   (defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r] (form-form-get m (form-keyword-form k)))
   :default
   (declare handle-aggregate-type? payload-word-type?))

#?(:kotoba
   (defn- doc [text :string] [:ref :form/r] (form-from-document (document-edn-read text))))

#?(:kotoba
   ;; (= EDN x): X read against an EDN constant.
   (defn- f= [x [:ref :form/r] text :string] :bool (form-eq x (doc text))))

#?(:kotoba
   ;; (= [:kotoba.form/set keys...] (set (keys m))): M's keys are exactly the listed set.
   (defn- keys= [m [:ref :form/r] text :string] :bool
     (and (form-is-map? m) (form-eq (form-keys-of m) (doc text)))))

#?(:kotoba
   (defn- kw-in? [f [:ref :form/r] text :string] :bool
     (and (form-is-keyword? f)
          (let [xs (form-kids-of (doc text))
                n (vector-count xs)]
            (loop [i 0]
              (if (>= i n) false (if (form-eq f (typed-list-nth [:list [:ref :form/r]] xs i)) true (recur (inc i)))))))))

#?(:kotoba
   (defn- qualified-keyword? [f [:ref :form/r]] :bool
     (and (form-is-keyword? f) (form-keyword-has-namespace? f))))

#?(:kotoba
   ;; The first elements of PAIRS are pairwise distinct.
   (defn- distinct-firsts? [pairs [:ref :form/r]] :bool
     (let [n (form-count-of pairs)]
       (loop [i 0]
         (if (>= i n) true
           (if (loop [j (inc i)]
                 (if (>= j n) true
                   (if (form-eq (form-nth-of (form-nth-of pairs i) 0) (form-nth-of (form-nth-of pairs j) 0))
                     false
                     (recur (inc j)))))
             (recur (inc i))
             false))))))



#?(:kotoba
   (defn- word-scalar? [f [:ref :form/r]] :bool
     (kw-in? f "[:kotoba.form/set :i64 :bool :f32 :f64 :string :keyword :vector-i64 :vector-f64 :string-index :bytes]"))
   :default
   (defn scalar-record-type?
     "True for a named record whose unique fields each occupy one native word.
     The record with no fields is `{}` passed as an options map (amu ADR 0353
     floor :options-map-argument): the empty pair chain, 0. A nested record occupies one word through its pair-chain handle;
     nesting is bounded so adversarial schemas fail closed during admission."
     [type]
     (letfn [(record-type? [candidate depth]
               (and (< depth max-record-nesting-depth)
                    (vector? candidate) (= 3 (count candidate))
                    (= :record (first candidate))
                    (keyword? (second candidate))
                    (vector? (nth candidate 2))
                    (every? #(and (vector? %) (= 2 (count %))
                                  (keyword? (first %))
                                  (word-field-type? (second %) (inc depth)))
                            (nth candidate 2))
                    (= (count (nth candidate 2))
                       (count (distinct (map first (nth candidate 2)))))))
             (word-field-type? [field-type depth]
               ;; `:vector-i64` is how kotoba.kir spells the i64 vector handle.
               ;; This listed `:vector`, which nothing produces (see
               ;; `machine-ir/word-result-type?`), so a record holding a
               ;; selection [start end] was refused here (amu ADR 0353 floor
               ;; :native-vector-field).
               (or (contains? #{:i64 :bool :f32 :f64 :string :keyword
                                :vector-i64 :vector-f64 :string-index :bytes}
                              field-type)
                   (and (vector? field-type)
                        (contains? #{:option :result :list :set :map :ref}
                                   (first field-type)))
                   (record-type? field-type depth)
                   (handle-aggregate-type? field-type depth)))]
       (record-type? type 0))))

#?(:kotoba
   (defn- word-field-type? [t [:ref :form/r] depth :i64] :bool
     (or (word-scalar? t)
         (and (form-is-vec? t) (kw-in? (form-first-of t) "[:kotoba.form/set :option :result :list :set :map :ref]"))
         (record-type? t depth)
         (handle-aggregate-type? t depth))))

#?(:kotoba
   (defn- fields-ok? [fields [:ref :form/r] depth :i64] :bool
     (let [n (form-count-of fields)]
       (loop [i 0]
         (if (>= i n) true
           (let [p (form-nth-of fields i)]
             (if (and (form-is-vec? p) (= 2 (form-count-of p))
                      (form-is-keyword? (form-nth-of p 0))
                      (word-field-type? (form-nth-of p 1) (inc depth)))
               (recur (inc i))
               false)))))))

#?(:kotoba
   (defn- record-type? [candidate [:ref :form/r] depth :i64] :bool
     (and (< depth max-record-nesting-depth)
          (form-is-vec? candidate) (= 3 (form-count-of candidate))
          (form-eq (form-first-of candidate) (form-keyword-form :record))
          (form-is-keyword? (form-nth-of candidate 1))
          (form-is-vec? (form-nth-of candidate 2))
          (fields-ok? (form-nth-of candidate 2) depth)
          (distinct-firsts? (form-nth-of candidate 2)))))

#?(:kotoba
   (defn scalar-record-type?
     "True for a named record whose unique fields each occupy one native word.
     The record with no fields is the empty pair chain (amu ADR 0353 floor
     :options-map-argument)."
     [type [:ref :form/r]] :bool
     (record-type? type 0)))



#?(:kotoba
   (defn- members-ok? [members [:ref :form/r] depth :i64] :bool
     (let [n (form-count-of members)]
       (loop [i 0]
         (if (>= i n) true
           (let [p (form-nth-of members i)]
             (if (and (form-is-vec? p) (= 2 (form-count-of p))
                      (form-is-keyword? (form-nth-of p 0))
                      (payload-word-type? (form-nth-of p 1) (inc depth)))
               (recur (inc i))
               false))))))
   :default
   (defn- handle-aggregate-type?
     "ABI v8: a variant or a heterogeneous vector is one word too -- a
     pair(ordinal,payload) handle and a declaration-order pair chain -- so it may
     occupy a record field or a variant payload like any other handle. Its own
     members must be words by the same rule, which is what admits a recursive
     type: `[:ref q]` is already a word, whatever q names."
     [type depth]
     (and (< depth max-record-nesting-depth)
          (vector? type)
          (case (first type)
            :variant (and (= 3 (count type)) (keyword? (second type))
                          (some? (namespace (second type)))
                          (vector? (nth type 2)) (<= 1 (count (nth type 2)) 32)
                          (every? #(and (vector? %) (= 2 (count %))
                                        (keyword? (first %))
                                        (payload-word-type? (second %) (inc depth)))
                                  (nth type 2))
                          (= (count (nth type 2))
                             (count (distinct (map first (nth type 2))))))
            :vector (and (= 2 (count type)) (vector? (second type))
                         (<= 1 (count (second type)) 32)
                         (every? #(payload-word-type? % (inc depth)) (second type)))
            false))))

#?(:kotoba
   (defn- positions-ok? [items [:ref :form/r] depth :i64] :bool
     (let [n (form-count-of items)]
       (loop [i 0]
         (if (>= i n) true
           (if (payload-word-type? (form-nth-of items i) (inc depth)) (recur (inc i)) false))))))

#?(:kotoba
   (defn- handle-aggregate-type? [t [:ref :form/r] depth :i64] :bool
     (and (< depth max-record-nesting-depth)
          (form-is-vec? t)
          (cond
            (form-eq (form-first-of t) (form-keyword-form :variant))
            (and (= 3 (form-count-of t))
                 (form-is-keyword? (form-nth-of t 1))
                 (form-keyword-has-namespace? (form-nth-of t 1))
                 (form-is-vec? (form-nth-of t 2))
                 (<= 1 (form-count-of (form-nth-of t 2)))
                 (<= (form-count-of (form-nth-of t 2)) 32)
                 (members-ok? (form-nth-of t 2) depth)
                 (distinct-firsts? (form-nth-of t 2)))
            (form-eq (form-first-of t) (form-keyword-form :vector))
            (and (= 2 (form-count-of t)) (form-is-vec? (form-nth-of t 1))
                 (<= 1 (form-count-of (form-nth-of t 1)))
                 (<= (form-count-of (form-nth-of t 1)) 32)
                 (positions-ok? (form-nth-of t 1) depth))
            :else false))))



#?(:kotoba
   (defn- payload-word-type? [t [:ref :form/r] depth :i64] :bool
     (or (kw-in? t "[:kotoba.form/set :i64 :bool :f32 :f64 :string :keyword :vector-i64 :vector-f64 :string-index]")
         (and (form-is-vec? t) (form-eq (form-first-of t) (form-keyword-form :ref)) (= 2 (form-count-of t))
              (qualified-keyword? (form-nth-of t 1)))
         (and (form-is-vec? t) (kw-in? (form-first-of t) "[:kotoba.form/set :option :result :list :set :map]"))
         (and (< depth max-record-nesting-depth) (scalar-record-type? t))
         (handle-aggregate-type? t depth)))
   :default
   (defn- payload-word-type?
     "Anything that fits one native word: a scalar, a pair-backed value, a
     reference, or a record / variant / heterogeneous-vector handle."
     [type depth]
     (or (contains? #{:i64 :bool :f32 :f64 :string :keyword
                      :vector-i64 :vector-f64 :string-index} type)
         ;; A reference names a schema, so it must name one: qualified, the same
         ;; rule a record or variant's own name obeys.
         (and (vector? type) (= :ref (first type)) (= 2 (count type))
              (keyword? (second type)) (some? (namespace (second type))))
         (and (vector? type)
              (contains? #{:option :result :list :set :map} (first type)))
         (and (< depth max-record-nesting-depth)
              (scalar-record-type? type))
         (handle-aggregate-type? type depth))))



#?(:kotoba
   (defn hetero-vector-type?
     "True for an admitted `[:vector [T ...]]`: 1..32 one-word positions."
     [type [:ref :form/r]] :bool
     (and (form-is-vec? type) (form-eq (form-first-of type) (form-keyword-form :vector))
          (handle-aggregate-type? type 0)))
   :default
   (defn hetero-vector-type?
     "True for an admitted `[:vector [T ...]]`: 1..32 one-word positions."
     [type]
     (boolean (and (vector? type) (= :vector (first type))
                   (handle-aggregate-type? type 0)))))



#?(:kotoba
   (defn- any-record-field? [fields [:ref :form/r]] :bool
     (let [n (form-count-of fields)]
       (loop [i 0]
         (if (>= i n) false
           (let [ft (form-nth-of (form-nth-of fields i) 1)]
             (if (and (form-is-vec? ft) (form-eq (form-first-of ft) (form-keyword-form :record)))
               true
               (recur (inc i))))))))
   :default
   (defn nested-record-type?
     "True when TYPE is admitted and contains at least one inline record field."
     [type]
     (and (scalar-record-type? type)
          (boolean
           (some (fn [[_ field-type]]
                   (and (vector? field-type)
                        (= :record (first field-type))))
                 (nth type 2))))))

#?(:kotoba
   (defn nested-record-type?
     "True when TYPE is admitted and contains at least one inline record field."
     [type [:ref :form/r]] :bool
     (and (scalar-record-type? type) (any-record-field? (form-nth-of type 2)))))



#?(:kotoba
   (defn- targets-ok? [targets [:ref :form/r]] :bool
     (let [xs (form-kids-of targets)
           n (vector-count xs)]
       (loop [j 0]
         (if (>= j n) true
           (let [target (typed-list-nth [:list [:ref :form/r]] xs j)
                 p (typed-list-nth [:list [:ref :form/r]] xs (+ j 1))
                 args (fget p :argument-registers)
                 allocs (fget p :allocator-registers)]
             (if (and (kw-in? target "[:kotoba.form/set :x86-64 :aarch64]")
                      (keys= p "[:kotoba.form/set :argument-registers :return-register :allocator-registers :call-clobbers]")
                      (form-is-vec? args) (= 5 (form-count-of args))
                      (distinct-firsts? (wrap-each args))
                      (form-is-keyword? (fget p :return-register))
                      (form-is-vec? allocs) (> (form-count-of allocs) 0)
                      (member? (fget p :return-register) allocs)
                      (f= (fget p :call-clobbers) ":all-allocator-registers"))
               (recur (+ j 2))
               false))))))
   :default
   (defn validate-contract!
     "Validate the published contract and return it unchanged."
     [value]
     (when-not (= #{:abi/id :abi/version :abi/word-bits :portable/record
                    :portable/variant
                    :extracted :targets}
                  (set (keys value)))
       (reject! :non-canonical-contract value))
     (when-not (and (= :kotoba.native/aggregate-boundary (:abi/id value))
                    (= 8 (:abi/version value))
                    (= 64 (:abi/word-bits value)))
       (reject! :unsupported-contract-version value))
     (let [record (:portable/record value)]
       (when-not (and (= #{:boundary/parameters :boundary/results
                           :boundary/word-count :boundary/layout
                           :boundary/field-representation :boundary/max-nesting-depth
                           :boundary/terminator :boundary/allocation
                           :boundary/ownership :boundary/arena-cell-limit}
                         (set (keys record)))
                      (= :pair-chain-handle (:boundary/parameters record))
                      (= :pair-chain-handle (:boundary/results record))
                      (= 1 (:boundary/word-count record))
                      (= :declaration-order (:boundary/layout record))
                      (= :recursive-word-handles (:boundary/field-representation record))
                      (= 32 (:boundary/max-nesting-depth record))
                      (= 0 (:boundary/terminator record))
                      (= :context-pair-arena (:boundary/allocation record))
                      (= :host-context (:boundary/ownership record))
                      (= 4096 (:boundary/arena-cell-limit record)))
         (reject! :invalid-portable-record-boundary record)))
     (let [variant (:portable/variant value)]
       (when-not (and (= #{:boundary/parameters :boundary/results
                           :boundary/word-count :boundary/tag :boundary/payload-types
                           :boundary/payload-representation
                           :boundary/max-payload-nesting-depth
                           :boundary/bool-words :boundary/case-limit
                           :boundary/allocation :boundary/ownership
                           :boundary/arena-cell-limit}
                         (set (keys variant)))
                      (= :pair-tag-payload-handle (:boundary/parameters variant))
                      (= :pair-tag-payload-handle (:boundary/results variant))
                      (= 1 (:boundary/word-count variant))
                      (= :zero-based-declaration-ordinal (:boundary/tag variant))
                      (= #{:i64 :bool :record :handle} (:boundary/payload-types variant))
                      (= :recursive-word-handles
                         (:boundary/payload-representation variant))
                      (= 32 (:boundary/max-payload-nesting-depth variant))
                      (= #{0 1} (:boundary/bool-words variant))
                      (= 32 (:boundary/case-limit variant))
                      (= :context-pair-arena (:boundary/allocation variant))
                      (= :host-context (:boundary/ownership variant))
                      (= 4096 (:boundary/arena-cell-limit variant)))
         (reject! :invalid-portable-variant-boundary variant)))
     (let [extracted (:extracted value)
           required (:call-requires extracted)]
       (when-not (= #{:local-record :local-variant :record-boundary
                      :variant-boundary :call-admission :call-requires
                      :callable-dispatch :linkage}
                    (set (keys extracted)))
         (reject! :invalid-extracted-boundary extracted))
       (when-not (and (= :scalar-replacement (:local-record extracted))
                      (= :scalar-replacement (:local-variant extracted))
                      (= :word-pair-chain-admitted (:record-boundary extracted))
                      (= :recursive-payload-pair-handle-admitted
                         (:variant-boundary extracted))
                      (= :sealed-callable-admitted (:call-admission extracted))
                      (= {:indirect :closed-ordinal-dispatch
                          :apply :bounded-pair-chain
                          :max-apply-arguments 4
                          :arbitrary-address false}
                         (:callable-dispatch extracted))
                      (= {:mode :closed-module-graph
                          :ambient-symbols false
                          :unresolved-symbols false}
                         (:linkage extracted)))
         (reject! :invalid-extracted-admission extracted))
       (when-not (= #{:per-function-frame
                      :spill-live-values-across-call
                      :parallel-argument-assignment
                      :single-word-return-register}
                    required)
         (reject! :invalid-call-prerequisites required)))
     (when-not (= #{:x86-64 :aarch64} (set (keys (:targets value))))
       (reject! :invalid-target-set (:targets value)))
     (doseq [[target {:keys [argument-registers return-register
                             allocator-registers call-clobbers]}]
             (:targets value)]
       (when-not (and (contains? #{:x86-64 :aarch64} target)
                      (= #{:argument-registers :return-register
                           :allocator-registers :call-clobbers}
                         (set (keys (get (:targets value) target))))
                      (vector? argument-registers) (= 5 (count argument-registers))
                      (= (count argument-registers)
                         (count (distinct argument-registers)))
                      (keyword? return-register)
                      (vector? allocator-registers) (seq allocator-registers)
                      (contains? (set allocator-registers) return-register)
                      (= :all-allocator-registers call-clobbers))
         (reject! :invalid-target-call-profile
                  {target (get (:targets value) target)})))
     value))

#?(:kotoba
   ;; Each item of XS wrapped in a one-element vector, so `distinct-firsts?` reads
   ;; the items themselves.
   (defn- wrap-each [xs [:ref :form/r]] [:ref :form/r]
     (let [n (form-count-of xs)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n) (form-form-vec acc)
           (recur (inc i) (form-append-form acc (form-vec2 (form-nth-of xs i) (form-nil-form)))))))))

#?(:kotoba
   (defn- member? [x [:ref :form/r] xs [:ref :form/r]] :bool
     (let [n (form-count-of xs)]
       (loop [i 0]
         (if (>= i n) false (if (form-eq (form-nth-of xs i) x) true (recur (inc i))))))))

#?(:kotoba
   (defn- contract-problem [value [:ref :form/r]] :keyword
     (let [record (fget value :portable/record)
           variant (fget value :portable/variant)
           extracted (fget value :extracted)]
       (cond
         (not (keys= value "[:kotoba.form/set :abi/id :abi/version :abi/word-bits :portable/record :portable/variant :extracted :targets]")) :non-canonical-contract
         (not (and (f= (fget value :abi/id) ":kotoba.native/aggregate-boundary")
                   (f= (fget value :abi/version) "8")
                   (f= (fget value :abi/word-bits) "64"))) :unsupported-contract-version
         (not (and (keys= record "[:kotoba.form/set :boundary/parameters :boundary/results :boundary/word-count :boundary/layout :boundary/field-representation :boundary/max-nesting-depth :boundary/terminator :boundary/allocation :boundary/ownership :boundary/arena-cell-limit]")
                   (f= (fget record :boundary/parameters) ":pair-chain-handle")
                   (f= (fget record :boundary/results) ":pair-chain-handle")
                   (f= (fget record :boundary/word-count) "1")
                   (f= (fget record :boundary/layout) ":declaration-order")
                   (f= (fget record :boundary/field-representation) ":recursive-word-handles")
                   (f= (fget record :boundary/max-nesting-depth) "32")
                   (f= (fget record :boundary/terminator) "0")
                   (f= (fget record :boundary/allocation) ":context-pair-arena")
                   (f= (fget record :boundary/ownership) ":host-context")
                   (f= (fget record :boundary/arena-cell-limit) "4096"))) :invalid-portable-record-boundary
         (not (and (keys= variant "[:kotoba.form/set :boundary/parameters :boundary/results :boundary/word-count :boundary/tag :boundary/payload-types :boundary/payload-representation :boundary/max-payload-nesting-depth :boundary/bool-words :boundary/case-limit :boundary/allocation :boundary/ownership :boundary/arena-cell-limit]")
                   (f= (fget variant :boundary/parameters) ":pair-tag-payload-handle")
                   (f= (fget variant :boundary/results) ":pair-tag-payload-handle")
                   (f= (fget variant :boundary/word-count) "1")
                   (f= (fget variant :boundary/tag) ":zero-based-declaration-ordinal")
                   (f= (fget variant :boundary/payload-types) "[:kotoba.form/set :i64 :bool :record :handle]")
                   (f= (fget variant :boundary/payload-representation) ":recursive-word-handles")
                   (f= (fget variant :boundary/max-payload-nesting-depth) "32")
                   (f= (fget variant :boundary/bool-words) "[:kotoba.form/set 0 1]")
                   (f= (fget variant :boundary/case-limit) "32")
                   (f= (fget variant :boundary/allocation) ":context-pair-arena")
                   (f= (fget variant :boundary/ownership) ":host-context")
                   (f= (fget variant :boundary/arena-cell-limit) "4096"))) :invalid-portable-variant-boundary
         (not (keys= extracted "[:kotoba.form/set :local-record :local-variant :record-boundary :variant-boundary :call-admission :call-requires :callable-dispatch :linkage]")) :invalid-extracted-boundary
         (not (and (f= (fget extracted :local-record) ":scalar-replacement")
                   (f= (fget extracted :local-variant) ":scalar-replacement")
                   (f= (fget extracted :record-boundary) ":word-pair-chain-admitted")
                   (f= (fget extracted :variant-boundary) ":recursive-payload-pair-handle-admitted")
                   (f= (fget extracted :call-admission) ":sealed-callable-admitted")
                   (f= (fget extracted :callable-dispatch) "{:indirect :closed-ordinal-dispatch :apply :bounded-pair-chain :max-apply-arguments 4 :arbitrary-address false}")
                   (f= (fget extracted :linkage) "{:mode :closed-module-graph :ambient-symbols false :unresolved-symbols false}"))) :invalid-extracted-admission
         (not (f= (fget extracted :call-requires) "[:kotoba.form/set :per-function-frame :spill-live-values-across-call :parallel-argument-assignment :single-word-return-register]")) :invalid-call-prerequisites
         (not (keys= (fget value :targets) "[:kotoba.form/set :x86-64 :aarch64]")) :invalid-target-set
         (not (targets-ok? (fget value :targets))) :invalid-target-call-profile
         :else :ok))))

#?(:kotoba
   (defn validate-contract!
     "Validate the published contract and return it unchanged."
     [value [:ref :form/r]] [:ref :form/r]
     (let [p (contract-problem value)]
       (if (= p :ok) value (do (reject! p) value)))))



#?(:kotoba
   (defn record-boundary-plan
     "Return the admitted one-word scalar record boundary plan."
     [type [:ref :form/r]] [:ref :form/r]
     (if (scalar-record-type? type)
       (form-assoc-form
        (form-assoc-form (fget (contract-form) :portable/record) (form-keyword-form :boundary/type) type)
        (form-keyword-form :boundary/extracted-admission) (form-keyword-form :admitted))
       (do (reject! :unsupported-record-type) type)))
   :default
   (defn record-boundary-plan
     "Return the admitted one-word scalar record boundary plan."
     [type]
     (when-not (scalar-record-type? type)
       (reject! :unsupported-record-type type))
     (assoc (:portable/record contract)
            :boundary/type type
            :boundary/extracted-admission :admitted)))



#?(:kotoba
   (defn- payloads-ok? [cases [:ref :form/r]] :bool
     (let [n (form-count-of cases)]
       (loop [i 0]
         (if (>= i n) true
           (let [p (form-nth-of cases i)
                 pt (form-nth-of p 1)]
             (if (and (form-is-vec? p) (= 2 (form-count-of p))
                      (form-is-keyword? (form-nth-of p 0))
                      (or (kw-in? pt "[:kotoba.form/set :i64 :bool]") (payload-word-type? pt 1)))
               (recur (inc i))
               false))))))
   :default
   (defn scalar-variant-type?
     "True for the admitted sealed one-word variant boundary family.

     The historical name remains API-compatible. Record payloads occupy one word
     through the same bounded pair-chain handle used by record boundaries."
     [type]
     (and (vector? type) (= 3 (count type)) (= :variant (first type))
          (keyword? (second type)) (some? (namespace (second type)))
          (vector? (nth type 2)) (<= 1 (count (nth type 2)) 32)
          (every? #(and (vector? %) (= 2 (count %))
                        (keyword? (first %))
                        (or (contains? #{:i64 :bool} (second %))
                            (payload-word-type? (second %) 1)))
                  (nth type 2))
          (= (count (nth type 2))
             (count (distinct (map first (nth type 2))))))))

#?(:kotoba
   (defn scalar-variant-type?
     "True for the admitted sealed one-word variant boundary family."
     [type [:ref :form/r]] :bool
     (and (form-is-vec? type) (= 3 (form-count-of type))
          (form-eq (form-first-of type) (form-keyword-form :variant))
          (form-is-keyword? (form-nth-of type 1))
          (form-keyword-has-namespace? (form-nth-of type 1))
          (form-is-vec? (form-nth-of type 2))
          (<= 1 (form-count-of (form-nth-of type 2)))
          (<= (form-count-of (form-nth-of type 2)) 32)
          (payloads-ok? (form-nth-of type 2))
          (distinct-firsts? (form-nth-of type 2)))))



#?(:kotoba
   (defn- any-handle-payload? [cases [:ref :form/r]] :bool
     (let [n (form-count-of cases)]
       (loop [i 0]
         (if (>= i n) false
           (if (kw-in? (form-nth-of (form-nth-of cases i) 1) "[:kotoba.form/set :i64 :bool]") (recur (inc i)) true)))))
   :default
   (defn aggregate-payload-variant-type?
     "True when TYPE is admitted and at least one case carries a handle rather
     than a scalar: a record, another variant, a vector, an option/result, a
     string, or a `[:ref ...]`. Such a payload is already one boxed word, so the
     two-register local SROA representation cannot hold it."
     [type]
     (and (scalar-variant-type? type)
          (boolean (some (fn [[_ payload-type]]
                           (not (contains? #{:i64 :bool} payload-type)))
                         (nth type 2))))))

#?(:kotoba
   (defn aggregate-payload-variant-type?
     "True when TYPE is admitted and at least one case carries a handle rather
     than a scalar."
     [type [:ref :form/r]] :bool
     (and (scalar-variant-type? type) (any-handle-payload? (form-nth-of type 2)))))



#?(:kotoba
   (defn- firsts [cases [:ref :form/r]] [:ref :form/r]
     (let [n (form-count-of cases)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n) (form-form-vec acc)
           (recur (inc i) (form-append-form acc (form-nth-of (form-nth-of cases i) 0)))))))
   :default
   (defn variant-boundary-plan
     "Return the admitted one-word scalar/record-payload variant boundary plan."
     [type]
     (when-not (scalar-variant-type? type)
       (reject! :unsupported-variant-type type))
     (assoc (:portable/variant contract)
            :boundary/type type
            :boundary/cases (mapv first (nth type 2))
            :boundary/payload-schemas (mapv second (nth type 2))
            :boundary/extracted-admission :admitted)))

#?(:kotoba
   (defn- seconds [cases [:ref :form/r]] [:ref :form/r]
     (let [n (form-count-of cases)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n) (form-form-vec acc)
           (recur (inc i) (form-append-form acc (form-nth-of (form-nth-of cases i) 1))))))))

#?(:kotoba
   (defn variant-boundary-plan
     "Return the admitted one-word scalar/record-payload variant boundary plan."
     [type [:ref :form/r]] [:ref :form/r]
     (if (scalar-variant-type? type)
       (let [m0 (fget (contract-form) :portable/variant)
             m1 (form-assoc-form m0 (form-keyword-form :boundary/type) type)
             m2 (form-assoc-form m1 (form-keyword-form :boundary/cases) (firsts (form-nth-of type 2)))
             m3 (form-assoc-form m2 (form-keyword-form :boundary/payload-schemas) (seconds (form-nth-of type 2)))]
         (form-assoc-form m3 (form-keyword-form :boundary/extracted-admission) (form-keyword-form :admitted)))
       (do (reject! :unsupported-variant-type) type))))



#?(:kotoba
   (defn call-profile [target [:ref :form/r]] [:ref :form/r]
     (let [targets (fget (contract-form) :targets)]
       (if (form-form-has? targets target)
         (form-form-get targets target)
         (do (reject! :unsupported-target) target))))
   :default
   (defn call-profile [target]
     (or (get-in contract [:targets target])
         (reject! :unsupported-target target))))



#?(:kotoba
   (defn- missing-guarantee? [required [:ref :form/r] supplied [:ref :form/r]] :bool
     (let [n (form-count-of required)]
       (loop [i 0]
         (if (>= i n) false
           (if (member? (form-nth-of required i) supplied) (recur (inc i)) true)))))
   :default
   (defn admit-extracted-call!
     "Fail closed until a call implementation supplies every frame/clobber
     guarantee and the versioned contract deliberately flips admission."
     [target guarantees]
     (let [profile (call-profile target)
           required (get-in contract [:extracted :call-requires])
           supplied (set guarantees)
           missing (set/difference required supplied)]
       (when (seq missing)
         (reject! :missing-call-guarantees
                  {:target target :missing missing :profile profile}))
       (when-not (= :sealed-callable-admitted
                    (get-in contract [:extracted :call-admission]))
         (reject! :call-abi-not-admitted
                  {:target target :required required :profile profile}))
       profile)))

#?(:kotoba
   (defn admit-extracted-call!
     "Fail closed until a call implementation supplies every frame/clobber
     guarantee and the versioned contract deliberately flips admission."
     [target [:ref :form/r] guarantees [:ref :form/r]] [:ref :form/r]
     (let [profile (call-profile target)
           extracted (fget (contract-form) :extracted)
           required (fget extracted :call-requires)]
       (cond
         (missing-guarantee? required guarantees) (do (reject! :missing-call-guarantees) profile)
         (not (f= (fget extracted :call-admission) ":sealed-callable-admitted")) (do (reject! :call-abi-not-admitted) profile)
         :else profile))))



#?(:kotoba
   (defn- lower-hex? [s :string] :bool
     (let [n (string-byte-length s)]
       (and (= n 64)
            (loop [i 0]
              (if (>= i n) true
                (let [c (string-code-point-at s i)]
                  (if (or (and (>= c 48) (<= c 57)) (and (>= c 97) (<= c 102))) (recur (inc i)) false)))))))
   :default
   (defn admit-closed-linkage!
     "Admit only a fully resolved, content-addressed module graph.

     Native code never resolves an ambient symbol at load time. The source owner
     must seal the graph first and provide its digest; an empty unresolved-symbol
     set is part of the evidence rather than an assumed default."
     [evidence]
     (when-not (and (map? evidence)
                    (= #{:mode :module-graph-digest :unresolved-symbols
                         :ambient-symbols}
                       (set (keys evidence)))
                    (= :closed-module-graph (:mode evidence))
                    (string? (:module-graph-digest evidence))
                    (boolean (re-matches #"[0-9a-f]{64}"
                                         (:module-graph-digest evidence)))
                    (= #{} (:unresolved-symbols evidence))
                    (false? (:ambient-symbols evidence)))
       (reject! :unsealed-external-linkage evidence))
     evidence))

#?(:kotoba
   (defn admit-closed-linkage!
     "Admit only a fully resolved, content-addressed module graph."
     [evidence [:ref :form/r]] [:ref :form/r]
     (if (and (keys= evidence "[:kotoba.form/set :mode :module-graph-digest :unresolved-symbols :ambient-symbols]")
              (f= (fget evidence :mode) ":closed-module-graph")
              (form-is-string? (fget evidence :module-graph-digest))
              (lower-hex? (form-string-value (fget evidence :module-graph-digest)))
              (f= (fget evidence :unresolved-symbols) "[:kotoba.form/set]")
              (f= (fget evidence :ambient-symbols) "false"))
       evidence
       (do (reject! :unsealed-external-linkage) evidence))))



#?(:kotoba
   (defn reject-unextracted-call!
     "The standalone expression producer invokes this for call-shaped values;
     it always aborts. The Kotoba twin names the problem, not the operation."
     [form [:ref :form/r]] [:ref :form/r]
     (if (and (form-is-seq? form) (form-is-symbol? (form-first-of form)))
       (throw (ex-info "aggregate ABI rejected: call-abi-not-admitted"
                       {:phase :aggregate-abi :problem :call-abi-not-admitted}))
       (do (reject! :call-abi-not-admitted) form)))
   :default
   (defn reject-unextracted-call!
     "The standalone expression producer invokes this for call-shaped values.
     Calls are admitted only inside a validated GMIR v3 function module.

     By the time a form reaches here every declared function is a known callee,
     so the head is an OPERATION the native lowering has no case for, and the
     message names it (2026-09-26, superproject adr-2609242330). Until then the
     form rode only in ex-data, which the amu CLI drops: the selfhost scoreboard
     carried a bare \"call-abi-not-admitted\" that was `min` in one module and
     `vector-take` in another. The problem keyword and phase are unchanged."
     [form]
     (let [value {:form form
                  :required (get-in contract [:extracted :call-requires])}]
       (if (and (seq? form) (symbol? (first form)))
         (throw (ex-info (str "aggregate ABI rejected: call-abi-not-admitted: "
                              "native has no lowering for the operation `" (first form) "`")
                         {:phase :aggregate-abi :problem :call-abi-not-admitted :value value}))
         (reject! :call-abi-not-admitted value)))))



#?(:kotoba
   (defn contract-valid? [] :bool (= :ok (contract-problem (contract-form))))
   :default
   (validate-contract! contract))
