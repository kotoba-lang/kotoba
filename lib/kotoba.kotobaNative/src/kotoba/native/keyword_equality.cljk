(ns kotoba.native.keyword-equality
  "`=` on keyword operands, lowered for BOTH native ISAs onto `string=?`.

  ## The defect this closes (measured 2026-09-15, amu 73ddd26)

  A keyword is carried on native as the same one-word `pair(offset,length)`
  handle a string is, over its printed text, and every evaluation of a
  keyword literal is a fresh `pair_new`. `=` lowers to a word compare
  (`cmp` + `cset`), so two handles over the same bytes compare unequal:

      (= :end :end)                          -> 0 on aarch64, 1 on KIR/js/wasm
      (let [k (:phase (->R :end))] (= :end k)) -> 0 on aarch64

  `case` on a keyword desugars to that same `=`, so every keyword dispatch
  on native took the default arm. The interpreter, the restricted-ESM and
  the wasm targets compare keywords by content; native did not.

  ## The lowering

  Keyword equality is content equality, and the content of a keyword handle
  is the bytes `string=?` already compares (host call, slot 112 on both
  ISAs). So `(= a b)` becomes `(string=? a b)` whenever either operand is
  keyword-typed, and `=` on anything else is left as the word compare it was.
  No new representation, no new host operation, no ABI bump.

  What counts as keyword-typed is decided from the KIR itself, with no
  inference beyond it: a keyword literal; a parameter whose `:param-types`
  entry is `:keyword`; a `let` binding whose value is keyword-typed (the
  bindings are walked in order, so a later binding sees the earlier ones);
  a `record-get` whose descriptor names the field `:keyword`; a call to a
  function of this module whose `:result` is `:keyword`; and an `if` whose
  arms are keyword-typed. A `let`'s type is its body's. Anything else is
  not keyword-typed and its `=` is untouched -- a value this cannot see the
  type of is a word compare, as before, never a byte compare of two integers.

  `variant-match` and `typed-cap-call` binders are not looked into: a
  keyword bound by them keeps the word compare it had. That is the
  remaining gap, and it is named here rather than papered over.

  ## Order

  Runs first in `emit-program`, before `vector-region/rewrite-program` and
  the string helpers: those passes read `string=?` and must see the rewritten
  form, and nothing they introduce compares keywords."
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

#?(:kotoba
   (defn- form-no-forms [] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]])))

#?(:kotoba
   (defn- form-one-form [a [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a)))

#?(:kotoba
   (defn- form-two-forms [a [:ref :form/r] b [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b)))

#?(:kotoba
   (defn- form-three-forms [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b c)))

#?(:kotoba
   (defn- form-append-form [xs [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-conj [:list [:ref :form/r]] xs x)))

#?(:kotoba
   (defn- form-mk [t :i64 s :string n :i64 k :keyword kids [:list [:ref :form/r]]] [:ref :form/r]
     (record-new [:ref :form/r] t s n k kids 0 (bytes-empty))))

#?(:kotoba
   (defn- form-nil-form [] [:ref :form/r] (form-mk 0 "" 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-bool-form [b :bool] [:ref :form/r] (form-mk 1 "" (if b 1 0) :none (form-no-forms))))

#?(:kotoba
   (defn- form-int-form [n :i64] [:ref :form/r] (form-mk 2 "" n :none (form-no-forms))))

#?(:kotoba
   (defn- form-string-form [s :string] [:ref :form/r] (form-mk 3 s 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-keyword-form [k :keyword] [:ref :form/r] (form-mk 4 "" 0 k (form-no-forms))))

#?(:kotoba
   (defn- form-symbol-form [s :string] [:ref :form/r] (form-mk 5 s 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-form-seq [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 6 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-vec [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 7 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-set [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 8 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-map [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 9 "" 0 :none kids)))

#?(:kotoba
   (defn- form-tag-of [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :tag)))

#?(:kotoba
   (defn- form-kids-of [f [:ref :form/r]] [:list [:ref :form/r]] (record-get [:ref :form/r] f :kids)))

#?(:kotoba
   (defn- form-int-value [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :n)))

#?(:kotoba
   (defn- form-string-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s)))

#?(:kotoba
   (defn- form-symbol-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s)))

#?(:kotoba
   (defn- form-keyword-value [f [:ref :form/r]] :keyword (record-get [:ref :form/r] f :k)))

#?(:kotoba
   (defn- form-bool-value [f [:ref :form/r]] :bool (= 1 (record-get [:ref :form/r] f :n))))

#?(:kotoba
   (defn- form-is-nil? [f [:ref :form/r]] :bool (= 0 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-bool? [f [:ref :form/r]] :bool (= 1 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-int? [f [:ref :form/r]] :bool (= 2 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-string? [f [:ref :form/r]] :bool (= 3 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-keyword? [f [:ref :form/r]] :bool (= 4 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-symbol? [f [:ref :form/r]] :bool (= 5 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-seq? [f [:ref :form/r]] :bool (= 6 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-vec? [f [:ref :form/r]] :bool (= 7 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-set? [f [:ref :form/r]] :bool (= 8 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-map? [f [:ref :form/r]] :bool (= 9 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-list-like? [f [:ref :form/r]] :bool (or (= 6 (form-tag-of f)) (= 7 (form-tag-of f)))))

#?(:kotoba
   (defn- form-is-true? [f [:ref :form/r]] :bool (and (= 1 (form-tag-of f)) (= 1 (record-get [:ref :form/r] f :n)))))

#?(:kotoba
   (defn- form-count-of [f [:ref :form/r]] :i64 (vector-count (form-kids-of f))))

#?(:kotoba
   (defn- form-nth-of [f [:ref :form/r] i :i64] [:ref :form/r]
     (if (and (>= i 0) (< i (form-count-of f)))
       (typed-list-nth [:list [:ref :form/r]] (form-kids-of f) i)
       (form-nil-form))))

#?(:kotoba
   (defn- form-first-of [f [:ref :form/r]] [:ref :form/r] (form-nth-of f 0)))

#?(:kotoba
   (defn- form-lookup-from [kids [:list [:ref :form/r]] key [:ref :form/r] i :i64] [:ref :form/r]
     (let [n (vector-count kids)]
       (loop [j i]
         (if (>= (+ j 1) n)
           (form-nil-form)
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))
             (recur (+ j 2))))))))

#?(:kotoba
   (defn- form-form-get [m [:ref :form/r] key [:ref :form/r]] [:ref :form/r]
     (form-lookup-from (form-kids-of m) key 0)))

#?(:kotoba
   (defn- form-lookup-has [kids [:list [:ref :form/r]] key [:ref :form/r]] :bool
     (let [n (vector-count kids)]
       (loop [j 0]
         (if (>= (+ j 1) n)
           false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             true
             (recur (+ j 2))))))))

#?(:kotoba
   (defn- form-form-has? [m [:ref :form/r] key [:ref :form/r]] :bool
     (form-lookup-has (form-kids-of m) key)))

#?(:kotoba
   (defn- form-member? [xs [:list [:ref :form/r]] x [:ref :form/r]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) x) true (recur (inc i))))))))

#?(:kotoba
   (defn- form-ordered-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) (typed-list-nth [:list [:ref :form/r]] ys i))
               (recur (inc i))
               false)))
         false))))

#?(:kotoba
   (defn- form-set-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-member? ys (typed-list-nth [:list [:ref :form/r]] xs i)) (recur (inc i)) false)))
         false))))

#?(:kotoba
   (defn- form-map-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [j 0]
           (if (>= (+ j 1) n) true
             (let [k (typed-list-nth [:list [:ref :form/r]] xs j)]
               (if (and (form-lookup-has ys k)
                        (form-eq (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)) (form-lookup-from ys k 0)))
                 (recur (+ j 2))
                 false))))
         false))))

#?(:kotoba
   (defn- form-eq
     "Structural equality, as `=` on the host's data: a list and a vector are
     different kinds here (as are they to the reader), sets and maps compare
     without order."
     [a [:ref :form/r] b [:ref :form/r]] :bool
     (let [t (form-tag-of a)]
       (and (= t (form-tag-of b))
            (cond
              (= t 0) true
              (= t 1) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 2) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 3) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 4) (= (record-get [:ref :form/r] a :k) (record-get [:ref :form/r] b :k))
              (= t 5) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 8) (form-set-eq (form-kids-of a) (form-kids-of b))
              (= t 9) (form-map-eq (form-kids-of a) (form-kids-of b))
              :else (form-ordered-eq (form-kids-of a) (form-kids-of b)))))))

#?(:kotoba
   (defn- form-rest-list
     "The kids of F after the first, as a list."
     [f [:ref :form/r]] [:list [:ref :form/r]]
     (let [xs (form-kids-of f)
           n (vector-count xs)]
       (loop [i 1 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i))))))))

#?(:kotoba
   (defn- form-last-of [f [:ref :form/r]] [:ref :form/r]
     (form-nth-of f (dec (form-count-of f)))))

#?(:kotoba
   (defn- form-cons-onto [x [:ref :form/r] xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count xs)]
       (loop [i 0 acc (form-one-form x)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i))))))))

#?(:kotoba
   (defn- form-assoc-form
     "Map M with K bound to V: the first entry whose key is K keeps its place and
     takes V, else K V are appended (as `assoc` on the host's map)."
     [m [:ref :form/r] k [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (let [xs (form-kids-of m)
           n (vector-count xs)]
       (if (form-lookup-has xs k)
         (form-form-map
          (loop [j 0 acc (form-no-forms)]
            (if (>= (+ j 1) n)
              acc
              (let [key (typed-list-nth [:list [:ref :form/r]] xs j)]
                (recur (+ j 2)
                       (typed-list-conj [:list [:ref :form/r]]
                                        (typed-list-conj [:list [:ref :form/r]] acc key)
                                        (if (form-eq key k) v (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)))))))))
         (form-form-map (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] xs k) v))))))



#?(:kotoba
   (defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r] (form-form-get m (form-keyword-form k)))
   :default
   (defn- record-field-type [descriptor field]
     (when (and (vector? descriptor) (= :record (first descriptor)))
       (some (fn [[name type]] (when (= name field) type)) (nth descriptor 2 [])))))

#?(:kotoba
   (defn- sym-is? [f [:ref :form/r] name :string] :bool
     (and (form-is-symbol? f) (string=? (form-symbol-value f) name))))

#?(:kotoba
   (defn- kw-form? [f [:ref :form/r]] :bool (form-eq f (form-keyword-form :keyword))))

#?(:kotoba
   (defn- truthy? [f [:ref :form/r]] :bool
     (not (or (form-is-nil? f) (and (form-is-bool? f) (not (form-bool-value f)))))))

#?(:kotoba
   ;; The first pair in FIELDS naming FIELD whose type is truthy, else nil.
   (defn- field-type-in [fields [:ref :form/r] field [:ref :form/r]] [:ref :form/r]
     (let [n (form-count-of fields)]
       (loop [i 0]
         (if (>= i n)
           (form-nil-form)
           (let [p (form-nth-of fields i)]
             (if (and (form-eq (form-nth-of p 0) field) (truthy? (form-nth-of p 1)))
               (form-nth-of p 1)
               (recur (inc i)))))))))

#?(:kotoba
   (defn- record-field-type [descriptor [:ref :form/r] field [:ref :form/r]] [:ref :form/r]
     (if (and (form-is-vec? descriptor)
              (form-eq (form-first-of descriptor) (form-keyword-form :record)))
       (field-type-in (form-nth-of descriptor 2) field)
       (form-nil-form))))



#?(:kotoba
   (defn- keyword-typed?
     [f [:ref :form/r] env [:ref :form/r] results [:ref :form/r]] :bool
     (cond
       (form-is-keyword? f) true
       (form-is-symbol? f) (kw-form? (form-form-get env f))
       (form-is-seq? f)
       (let [op (form-first-of f)
             argf (form-form-seq (form-rest-list f))]
         (cond
           (sym-is? op "record-get") (kw-form? (record-field-type (form-nth-of argf 0) (form-nth-of argf 2)))
           (sym-is? op "if") (and (keyword-typed? (form-nth-of argf 1) env results)
                                  (keyword-typed? (form-nth-of argf 2) env results))
           (sym-is? op "let") (keyword-typed? (form-nth-of argf 1) (bind-env (form-nth-of argf 0) env results) results)
           (sym-is? op "do") (keyword-typed? (form-last-of argf) env results)
           (form-is-symbol? op) (kw-form? (form-form-get results op))
           :else false))
       :else false))
   :default
   (defn- keyword-typed?
     "Whether `form` is a keyword by the rules in the namespace doc. `env` maps a
     symbol to its type where known; `results` maps a function name to its
     `:result`."
     [form env results]
     (cond
       (keyword? form) true
       (symbol? form) (= :keyword (get env form))
       (seq? form)
       (let [[op & args] form]
         (cond
           (= op 'record-get) (= :keyword (record-field-type (first args) (nth args 2 nil)))
           (= op 'if) (and (keyword-typed? (nth args 1 nil) env results)
                           (keyword-typed? (nth args 2 nil) env results))
           (= op 'let) (let [[bindings body] args
                             env (reduce (fn [env [name value]]
                                           (assoc env name (if (keyword-typed? value env results) :keyword :other)))
                                         env (partition 2 bindings))]
                         (keyword-typed? body env results))
           (= op 'do) (keyword-typed? (last args) env results)
           (symbol? op) (= :keyword (get results op))
           :else false))
       :else false)))

#?(:kotoba
   ;; A let's bindings, walked in order: each name takes :keyword or :other from
   ;; its value under the environment so far.
   (defn- bind-env [bindings [:ref :form/r] env [:ref :form/r] results [:ref :form/r]] [:ref :form/r]
     (let [n (form-count-of bindings)]
       (loop [i 0 e env]
         (if (>= (+ i 1) n)
           e
           (recur (+ i 2)
                  (form-assoc-form e (form-nth-of bindings i)
                                   (form-keyword-form (if (keyword-typed? (form-nth-of bindings (+ i 1)) e results) :keyword :other)))))))))



#?(:kotoba
   (defn- rewrite-list [xs [:list [:ref :form/r]] env [:ref :form/r] results [:ref :form/r]] [:list [:ref :form/r]]
     (let [n (vector-count xs)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i) (form-append-form acc (rewrite-form (typed-list-nth [:list [:ref :form/r]] xs i) env results)))))))
   :default
   (defn- rewrite-form [form env results]
     (cond
       (not (seq? form)) form
       :else
       (let [[op & args] form]
         (cond
           (= op 'let)
           (let [[bindings body] args
                 [env rebound]
                 (reduce (fn [[env acc] [name value]]
                           (let [value' (rewrite-form value env results)
                                 type (if (keyword-typed? value env results) :keyword :other)]
                             [(assoc env name type) (conj acc name value')]))
                         [env []] (partition 2 bindings))]
             (list 'let rebound (rewrite-form body env results)))

           (and (= op '=) (= 2 (count args))
                (or (keyword-typed? (first args) env results)
                    (keyword-typed? (second args) env results)))
           (list 'string=? (rewrite-form (first args) env results) (rewrite-form (second args) env results))

           :else
           (cons op (map #(rewrite-form % env results) args)))))))

#?(:kotoba
   ;; The let: answers [env' rebound] as a vector form.
   (defn- rewrite-bindings [bindings [:ref :form/r] env [:ref :form/r] results [:ref :form/r]] [:ref :form/r]
     (let [n (form-count-of bindings)]
       (loop [i 0 e env acc (form-no-forms)]
         (if (>= (+ i 1) n)
           (form-form-vec (form-two-forms e (form-form-vec acc)))
           (let [name (form-nth-of bindings i)
                 value (form-nth-of bindings (+ i 1))]
             (recur (+ i 2)
                    (form-assoc-form e name (form-keyword-form (if (keyword-typed? value e results) :keyword :other)))
                    (form-append-form (form-append-form acc name) (rewrite-form value e results)))))))))

#?(:kotoba
   (defn- rewrite-form [f [:ref :form/r] env [:ref :form/r] results [:ref :form/r]] [:ref :form/r]
     (if (form-is-seq? f)
       (let [op (form-first-of f)
             args (form-rest-list f)
             argf (form-form-seq args)]
         (cond
           (sym-is? op "let")
           (let [r (rewrite-bindings (form-nth-of argf 0) env results)]
             (form-form-seq (form-three-forms (form-symbol-form "let")
                                              (form-nth-of r 1)
                                              (rewrite-form (form-nth-of argf 1) (form-nth-of r 0) results))))

           (and (sym-is? op "=") (= 2 (form-count-of argf))
                (or (keyword-typed? (form-nth-of argf 0) env results)
                    (keyword-typed? (form-nth-of argf 1) env results)))
           (form-form-seq (form-three-forms (form-symbol-form "string=?")
                                            (rewrite-form (form-nth-of argf 0) env results)
                                            (rewrite-form (form-nth-of argf 1) env results)))

           :else
           (form-form-seq (form-cons-onto op (rewrite-list args env results)))))
       f)))



#?(:kotoba
   (defn- initial-env [function [:ref :form/r]] [:ref :form/r]
     (let [params (fget function :params)
           types (fget function :param-types)
           given (truthy? types)
           n (form-count-of params)
           m (if given (form-count-of types) n)
           k (if (< n m) n m)]
       (loop [i 0 env (form-form-map (form-no-forms))]
         (if (>= i k)
           env
           (recur (inc i)
                  (form-assoc-form env (form-nth-of params i)
                                   (if given (form-nth-of types i) (form-keyword-form :i64))))))))
   :default
   (defn rewrite-function [{:keys [params param-types] :as function} results]
     (let [env (zipmap params (or param-types (repeat (count params) :i64)))]
       (update function :body rewrite-form env results))))

#?(:kotoba
   (defn rewrite-function [function [:ref :form/r] results [:ref :form/r]] [:ref :form/r]
     (form-assoc-form function (form-keyword-form :body)
                      (rewrite-form (fget function :body) (initial-env function) results))))



#?(:kotoba
   (defn- results-of [functions [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (vector-count functions)]
       (loop [i 0 acc (form-form-map (form-no-forms))]
         (if (>= i n)
           acc
           (let [f (typed-list-nth [:list [:ref :form/r]] functions i)]
             (recur (inc i) (form-assoc-form acc (fget f :name) (fget f :result))))))))
   :default
   (defn rewrite-program
     "The KIR module with every keyword `=` lowered to `string=?`."
     [kir]
     (let [results (into {} (map (juxt :name :result)) (:functions kir))]
       (update kir :functions (fn [functions] (mapv #(rewrite-function % results) functions))))))

#?(:kotoba
   (defn- rewrite-functions [functions [:list [:ref :form/r]] results [:ref :form/r]] [:list [:ref :form/r]]
     (let [n (vector-count functions)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i) (form-append-form acc (rewrite-function (typed-list-nth [:list [:ref :form/r]] functions i) results))))))))

#?(:kotoba
   (defn rewrite-program
     "The KIR module with every keyword `=` lowered to `string=?`."
     [kir [:ref :form/r]] [:ref :form/r]
     (let [functions (form-kids-of (fget kir :functions))]
       (form-assoc-form kir (form-keyword-form :functions)
                        (form-form-vec (rewrite-functions functions (results-of functions)))))))
