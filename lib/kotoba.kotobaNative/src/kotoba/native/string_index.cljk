(ns kotoba.native.string-index
  "Native lowering for the bounded canonical string -> i64 index.

  The public KIR value is canonical and sorted. Native code keeps an opaque
  private representation in the existing context-owned vector arena:

      [key-handle value key-handle value ...]

  Order is deliberately unobservable: the language exposes only new, count,
  contains, get and assoc. No string-index handle may cross a kexe export
  boundary. This therefore needs neither a new host callback nor a context ABI
  bump, and keeps lookup/update decisions in emitted Kotoba machine code.

  The reference limits are re-derived here: 128 entries and 65536 aggregate
  UTF-8 key bytes. A rejected insertion traps through an intentionally
  out-of-range vector-at, using an existing native trap path."
  {:kotoba/export [augment-functions find-name key-bytes-name lower]}
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

#?(:kotoba
   (defn- form-no-forms [] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]])))

#?(:kotoba
   (defn- form-one-form [a [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a)))

#?(:kotoba
   (defn- form-two-forms [a [:ref :form/r] b [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b)))

#?(:kotoba
   (defn- form-three-forms [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b c)))

#?(:kotoba
   (defn- form-append-form [xs [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-conj [:list [:ref :form/r]] xs x)))

#?(:kotoba
   (defn- form-mk [t :i64 s :string n :i64 k :keyword kids [:list [:ref :form/r]]] [:ref :form/r]
     (record-new [:ref :form/r] t s n k kids 0 (bytes-empty))))

#?(:kotoba
   (defn- form-nil-form [] [:ref :form/r] (form-mk 0 "" 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-bool-form [b :bool] [:ref :form/r] (form-mk 1 "" (if b 1 0) :none (form-no-forms))))

#?(:kotoba
   (defn- form-int-form [n :i64] [:ref :form/r] (form-mk 2 "" n :none (form-no-forms))))

#?(:kotoba
   (defn- form-string-form [s :string] [:ref :form/r] (form-mk 3 s 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-keyword-form [k :keyword] [:ref :form/r] (form-mk 4 "" 0 k (form-no-forms))))

#?(:kotoba
   (defn- form-symbol-form [s :string] [:ref :form/r] (form-mk 5 s 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-form-seq [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 6 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-vec [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 7 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-set [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 8 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-map [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 9 "" 0 :none kids)))

#?(:kotoba
   (defn- form-tag-of [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :tag)))

#?(:kotoba
   (defn- form-kids-of [f [:ref :form/r]] [:list [:ref :form/r]] (record-get [:ref :form/r] f :kids)))

#?(:kotoba
   (defn- form-int-value [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :n)))

#?(:kotoba
   (defn- form-string-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s)))

#?(:kotoba
   (defn- form-symbol-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s)))

#?(:kotoba
   (defn- form-keyword-value [f [:ref :form/r]] :keyword (record-get [:ref :form/r] f :k)))

#?(:kotoba
   (defn- form-bool-value [f [:ref :form/r]] :bool (= 1 (record-get [:ref :form/r] f :n))))

#?(:kotoba
   (defn- form-is-nil? [f [:ref :form/r]] :bool (= 0 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-bool? [f [:ref :form/r]] :bool (= 1 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-int? [f [:ref :form/r]] :bool (= 2 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-string? [f [:ref :form/r]] :bool (= 3 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-keyword? [f [:ref :form/r]] :bool (= 4 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-symbol? [f [:ref :form/r]] :bool (= 5 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-seq? [f [:ref :form/r]] :bool (= 6 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-vec? [f [:ref :form/r]] :bool (= 7 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-set? [f [:ref :form/r]] :bool (= 8 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-map? [f [:ref :form/r]] :bool (= 9 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-list-like? [f [:ref :form/r]] :bool (or (= 6 (form-tag-of f)) (= 7 (form-tag-of f)))))

#?(:kotoba
   (defn- form-is-true? [f [:ref :form/r]] :bool (and (= 1 (form-tag-of f)) (= 1 (record-get [:ref :form/r] f :n)))))

#?(:kotoba
   (defn- form-count-of [f [:ref :form/r]] :i64 (vector-count (form-kids-of f))))

#?(:kotoba
   (defn- form-nth-of [f [:ref :form/r] i :i64] [:ref :form/r]
     (if (and (>= i 0) (< i (form-count-of f)))
       (typed-list-nth [:list [:ref :form/r]] (form-kids-of f) i)
       (form-nil-form))))

#?(:kotoba
   (defn- form-first-of [f [:ref :form/r]] [:ref :form/r] (form-nth-of f 0)))

#?(:kotoba
   (defn- form-lookup-from [kids [:list [:ref :form/r]] key [:ref :form/r] i :i64] [:ref :form/r]
     (let [n (vector-count kids)]
       (loop [j i]
         (if (>= (+ j 1) n)
           (form-nil-form)
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))
             (recur (+ j 2))))))))

#?(:kotoba
   (defn- form-form-get [m [:ref :form/r] key [:ref :form/r]] [:ref :form/r]
     (form-lookup-from (form-kids-of m) key 0)))

#?(:kotoba
   (defn- form-lookup-has [kids [:list [:ref :form/r]] key [:ref :form/r]] :bool
     (let [n (vector-count kids)]
       (loop [j 0]
         (if (>= (+ j 1) n)
           false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             true
             (recur (+ j 2))))))))

#?(:kotoba
   (defn- form-form-has? [m [:ref :form/r] key [:ref :form/r]] :bool
     (form-lookup-has (form-kids-of m) key)))

#?(:kotoba
   (defn- form-member? [xs [:list [:ref :form/r]] x [:ref :form/r]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) x) true (recur (inc i))))))))

#?(:kotoba
   (defn- form-ordered-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) (typed-list-nth [:list [:ref :form/r]] ys i))
               (recur (inc i))
               false)))
         false))))

#?(:kotoba
   (defn- form-set-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-member? ys (typed-list-nth [:list [:ref :form/r]] xs i)) (recur (inc i)) false)))
         false))))

#?(:kotoba
   (defn- form-map-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [j 0]
           (if (>= (+ j 1) n) true
             (let [k (typed-list-nth [:list [:ref :form/r]] xs j)]
               (if (and (form-lookup-has ys k)
                        (form-eq (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)) (form-lookup-from ys k 0)))
                 (recur (+ j 2))
                 false))))
         false))))

#?(:kotoba
   (defn- form-eq
     "Structural equality, as `=` on the host's data: a list and a vector are
     different kinds here (as are they to the reader), sets and maps compare
     without order."
     [a [:ref :form/r] b [:ref :form/r]] :bool
     (let [t (form-tag-of a)]
       (and (= t (form-tag-of b))
            (cond
              (= t 0) true
              (= t 1) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 2) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 3) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 4) (= (record-get [:ref :form/r] a :k) (record-get [:ref :form/r] b :k))
              (= t 5) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 8) (form-set-eq (form-kids-of a) (form-kids-of b))
              (= t 9) (form-map-eq (form-kids-of a) (form-kids-of b))
              :else (form-ordered-eq (form-kids-of a) (form-kids-of b)))))))

#?(:kotoba
   (defn- form-rest-list
     "The kids of F after the first, as a list."
     [f [:ref :form/r]] [:list [:ref :form/r]]
     (let [xs (form-kids-of f)
           n (vector-count xs)]
       (loop [i 1 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i))))))))

#?(:kotoba
   (defn- form-last-of [f [:ref :form/r]] [:ref :form/r]
     (form-nth-of f (dec (form-count-of f)))))

#?(:kotoba
   (defn- form-cons-onto [x [:ref :form/r] xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count xs)]
       (loop [i 0 acc (form-one-form x)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i))))))))

#?(:kotoba
   (defn- form-assoc-form
     "Map M with K bound to V: the first entry whose key is K keeps its place and
     takes V, else K V are appended (as `assoc` on the host's map)."
     [m [:ref :form/r] k [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (let [xs (form-kids-of m)
           n (vector-count xs)]
       (if (form-lookup-has xs k)
         (form-form-map
          (loop [j 0 acc (form-no-forms)]
            (if (>= (+ j 1) n)
              acc
              (let [key (typed-list-nth [:list [:ref :form/r]] xs j)]
                (recur (+ j 2)
                       (typed-list-conj [:list [:ref :form/r]]
                                        (typed-list-conj [:list [:ref :form/r]] acc key)
                                        (if (form-eq key k) v (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)))))))))
         (form-form-map (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] xs k) v))))))

#?(:kotoba
   (defn- form-call0 [name :string] [:ref :form/r] (form-form-seq (form-one-form (form-symbol-form name)))))

#?(:kotoba
   (defn- form-call1 [name :string a [:ref :form/r]] [:ref :form/r]
     (form-form-seq (form-two-forms (form-symbol-form name) a))))

#?(:kotoba
   (defn- form-call2 [name :string a [:ref :form/r] b [:ref :form/r]] [:ref :form/r]
     (form-form-seq (form-three-forms (form-symbol-form name) a b))))

#?(:kotoba
   (defn- form-call3 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c))))

#?(:kotoba
   (defn- form-call4 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d))))

#?(:kotoba
   (defn- form-call5 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d) e))))

#?(:kotoba
   (defn- form-call6 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r] f [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d) e) f))))

#?(:kotoba
   (defn- form-vec2 [a [:ref :form/r] b [:ref :form/r]] [:ref :form/r] (form-form-vec (form-two-forms a b))))

#?(:kotoba
   (defn- form-vec3 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r] (form-form-vec (form-three-forms a b c))))

#?(:kotoba
   (defn- form-vec4 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d))))

#?(:kotoba
   (defn- form-vec5 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d) e))))

#?(:kotoba
   (defn- form-vec6 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r] f [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d) e) f))))



#?(:kotoba
   (def ^:private find-text "kotoba$string-index-find")
   :default
   (def find-name 'kotoba$string-index-find))

#?(:kotoba
   (defn find-name [] :symbol (symbol find-text)))


#?(:kotoba
   (def ^:private key-bytes-text "kotoba$string-index-key-bytes")
   :default
   (def key-bytes-name 'kotoba$string-index-key-bytes))

#?(:kotoba
   (defn key-bytes-name [] :symbol (symbol key-bytes-text)))



#?(:kotoba
   (def ^:private index-text "kotoba$string-index-value")
   :default
   (def ^:private index-symbol 'kotoba$string-index-value))


#?(:kotoba
   (def ^:private key-text "kotoba$string-index-key")
   :default
   (def ^:private key-symbol 'kotoba$string-index-key))


#?(:kotoba
   (def ^:private item-text "kotoba$string-index-item")
   :default
   (def ^:private item-symbol 'kotoba$string-index-item))


#?(:kotoba
   (def ^:private position-text "kotoba$string-index-position")
   :default
   (def ^:private position-symbol 'kotoba$string-index-position))



#?(:kotoba
   (def ^:private entry-limit 128)
   :default
   (def ^:private entry-limit 128))


#?(:kotoba
   (def ^:private key-byte-limit 65536)
   :default
   (def ^:private key-byte-limit 65536))



#?(:kotoba
   (defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r] (form-form-get m (form-keyword-form k)))
   :default
   (def ^:private find-function
     {:name find-name
      :params '[index key position]
      :param-types [:string-index :string :i64]
      :result :i64
      :body
      (list 'if
            (list '>= 'position (list 'vector-count 'index))
            -1
            (list 'if
                  (list 'string=? (list 'vector-at 'index 'position) 'key)
                  'position
                  (list find-name 'index 'key (list '+ 'position 2))))}))

#?(:kotoba
   (defn- sym [s :string] [:ref :form/r] (form-symbol-form s)))

#?(:kotoba
   (defn- num [n :i64] [:ref :form/r] (form-int-form n)))

#?(:kotoba
   (defn- sym-is? [f [:ref :form/r] name :string] :bool
     (and (form-is-symbol? f) (string=? (form-symbol-value f) name))))

#?(:kotoba
   (defn- function-map [name :string params [:ref :form/r] types [:ref :form/r] result [:ref :form/r] body [:ref :form/r]] [:ref :form/r]
     (let [m0 (form-form-map (form-no-forms))
           m1 (form-assoc-form m0 (form-keyword-form :name) (sym name))
           m2 (form-assoc-form m1 (form-keyword-form :params) params)
           m3 (form-assoc-form m2 (form-keyword-form :param-types) types)
           m4 (form-assoc-form m3 (form-keyword-form :result) result)]
       (form-assoc-form m4 (form-keyword-form :body) body))))

#?(:kotoba
   (defn- find-function [] [:ref :form/r]
     (function-map find-text
                   (form-vec3 (sym "index") (sym "key") (sym "position"))
                   (form-vec3 (form-keyword-form :string-index) (form-keyword-form :string) (form-keyword-form :i64))
                   (form-keyword-form :i64)
                   (form-call3 "if" (form-call2 ">=" (sym "position") (form-call1 "vector-count" (sym "index")))
                               (num -1)
                               (form-call3 "if"
                                           (form-call2 "string=?" (form-call2 "vector-at" (sym "index") (sym "position")) (sym "key"))
                                           (sym "position")
                                           (form-call3 find-text (sym "index") (sym "key") (form-call2 "+" (sym "position") (num 2))))))))



#?(:kotoba
   (defn- key-bytes-function [] [:ref :form/r]
     (function-map key-bytes-text
                   (form-vec3 (sym "index") (sym "position") (sym "total"))
                   (form-vec3 (form-keyword-form :string-index) (form-keyword-form :i64) (form-keyword-form :i64))
                   (form-keyword-form :i64)
                   (form-call3 "if" (form-call2 ">=" (sym "position") (form-call1 "vector-count" (sym "index")))
                               (sym "total")
                               (form-call3 key-bytes-text
                                           (sym "index")
                                           (form-call2 "+" (sym "position") (num 2))
                                           (form-call2 "+" (sym "total")
                                                       (form-call1 "string-byte-length"
                                                                   (form-call2 "vector-at" (sym "index") (sym "position"))))))))
   :default
   (def ^:private key-bytes-function
     {:name key-bytes-name
      :params '[index position total]
      :param-types [:string-index :i64 :i64]
      :result :i64
      :body
      (list 'if
            (list '>= 'position (list 'vector-count 'index))
            'total
            (list key-bytes-name
                  'index
                  (list '+ 'position 2)
                  (list '+ 'total
                        (list 'string-byte-length
                              (list 'vector-at 'index 'position)))))}))



#?(:kotoba
   (defn- op-of-interest? [f [:ref :form/r]] :bool
     (or (sym-is? f "string-index-new") (sym-is? f "string-index-count")
         (sym-is? f "string-index-contains") (sym-is? f "string-index-get")
         (sym-is? f "string-index-assoc")))
   :default
   (defn- uses? [form]
     (cond
       (seq? form) (or (contains? '#{string-index-new string-index-count
                                     string-index-contains string-index-get
                                     string-index-assoc}
                                   (first form))
                       (boolean (some uses? (rest form))))
       (vector? form) (boolean (some uses? form))
       :else false)))

#?(:kotoba
   (defn- any-uses? [xs [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n)
           false
           (if (uses? (typed-list-nth [:list [:ref :form/r]] xs i)) true (recur (inc i))))))))

#?(:kotoba
   ;; Only the REST of a list is visited, as on the host.
   (defn- uses? [f [:ref :form/r]] :bool
     (cond
       (form-is-seq? f) (or (op-of-interest? (form-first-of f)) (any-uses? (form-rest-list f)))
       (form-is-vec? f) (any-uses? (form-kids-of f))
       :else false)))



#?(:kotoba
   (defn- vec8 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r] f [:ref :form/r] g [:ref :form/r] h [:ref :form/r]] [:ref :form/r]
     (form-form-vec (form-append-form (form-append-form (form-append-form (form-append-form (form-append-form (form-append-form (form-append-form (form-one-form a) b) c) d) e) f) g) h)))
   :default
   (defn lower
     "Rewrite one string-index operation into existing vector/string/pair ops."
     [op args]
     (case op
       string-index-new
       (list 'vector-new)

       string-index-count
       (list 'quot (list 'vector-count (first args)) 2)

       string-index-contains
       (let [[index key] args]
         (list 'let [index-symbol index key-symbol key]
               (list 'if
                     (list '< (list find-name index-symbol key-symbol 0) 0)
                     0 1)))

       string-index-get
       (let [[index key] args]
         (list 'let [index-symbol index key-symbol key
                     position-symbol (list find-name index-symbol key-symbol 0)]
               (list 'if
                     (list '< position-symbol 0)
                     (list 'option-none-of [:option :i64])
                     (list 'option-some-of [:option :i64]
                           (list 'vector-at index-symbol
                                 (list '+ position-symbol 1))))))

       string-index-assoc
       (let [[index key item] args
             words-limit (* 2 entry-limit)]
         (list 'let [index-symbol index key-symbol key item-symbol item
                     position-symbol (list find-name index-symbol key-symbol 0)]
               (list 'if
                     (list '>= position-symbol 0)
                     (list 'vector-assoc index-symbol
                           (list '+ position-symbol 1)
                           item-symbol)
                     (list 'if
                           (list '>= (list 'vector-count index-symbol)
                                 words-limit)
                           ;; Guaranteed out of range, hence a native trap.
                           (list 'vector-at index-symbol
                                 (list 'vector-count index-symbol))
                           (list 'if
                                 (list '>
                                       (list '+
                                             (list key-bytes-name index-symbol 0 0)
                                             (list 'string-byte-length key-symbol))
                                       key-byte-limit)
                                 (list 'vector-at index-symbol
                                       (list 'vector-count index-symbol))
                                 (list 'vector-conj
                                       (list 'vector-conj index-symbol key-symbol)
                                       item-symbol))))))

       (throw (ex-info "unknown native string-index operation"
                       {:phase :native :operation op})))))

#?(:kotoba
   (defn- option-i64 [] [:ref :form/r]
     (form-vec2 (form-keyword-form :option) (form-keyword-form :i64))))

#?(:kotoba
   (defn lower
     "Rewrite one string-index operation into existing vector/string/pair ops."
     [op [:ref :form/r] args [:ref :form/r]] [:ref :form/r]
     (let [a0 (form-nth-of args 0)
           a1 (form-nth-of args 1)
           a2 (form-nth-of args 2)
           idx (sym index-text)
           k (sym key-text)
           it (sym item-text)
           pos (sym position-text)]
       (cond
         (sym-is? op "string-index-new") (form-call0 "vector-new")
         (sym-is? op "string-index-count") (form-call2 "quot" (form-call1 "vector-count" a0) (num 2))
         (sym-is? op "string-index-contains")
         (form-call2 "let" (form-vec4 idx a0 k a1)
                     (form-call3 "if" (form-call2 "<" (form-call3 find-text idx k (num 0)) (num 0)) (num 0) (num 1)))
         (sym-is? op "string-index-get")
         (form-call2 "let" (form-vec6 idx a0 k a1 pos (form-call3 find-text idx k (num 0)))
                     (form-call3 "if" (form-call2 "<" pos (num 0))
                                 (form-call1 "option-none-of" (option-i64))
                                 (form-call2 "option-some-of" (option-i64)
                                             (form-call2 "vector-at" idx (form-call2 "+" pos (num 1))))))
         (sym-is? op "string-index-assoc")
         (form-call2 "let" (vec8 idx a0 k a1 it a2 pos (form-call3 find-text idx k (num 0)))
                     (form-call3 "if" (form-call2 ">=" pos (num 0))
                                 (form-call3 "vector-assoc" idx (form-call2 "+" pos (num 1)) it)
                                 (form-call3 "if" (form-call2 ">=" (form-call1 "vector-count" idx) (num (* 2 entry-limit)))
                                             (form-call2 "vector-at" idx (form-call1 "vector-count" idx))
                                             (form-call3 "if"
                                                         (form-call2 ">" (form-call2 "+" (form-call3 key-bytes-text idx (num 0) (num 0))
                                                                                     (form-call1 "string-byte-length" k))
                                                                     (num key-byte-limit))
                                                         (form-call2 "vector-at" idx (form-call1 "vector-count" idx))
                                                         (form-call2 "vector-conj" (form-call2 "vector-conj" idx k) it)))))
         :else (throw (ex-info "unknown native string-index operation"
                               {:phase :native :problem :unknown-operation}))))))



#?(:kotoba
   (defn- any-body-uses? [functions [:list [:ref :form/r]]] :bool
     (let [n (vector-count functions)]
       (loop [i 0]
         (if (>= i n)
           false
           (if (uses? (fget (typed-list-nth [:list [:ref :form/r]] functions i) :body)) true (recur (inc i)))))))
   :default
   (defn augment-functions
     "Append the private helpers exactly when a declared body uses string-index.

     Helpers are never exported because each backend captures the declared export
     set before calling this function. The operation is idempotent and rejects a
     source-level collision rather than silently redirecting lowered calls."
     [functions]
     (if-not (some #(uses? (:body %)) functions)
       functions
       (let [declared (into {} (map (juxt :name identity)) functions)
             wanted [find-function key-bytes-function]
             clashes (filter (fn [helper]
                               (when-let [existing (get declared (:name helper))]
                                 (not= existing helper)))
                             wanted)]
         (when (seq clashes)
           (throw (ex-info
                   "a program function collides with a native string-index helper"
                   {:phase :native :functions (mapv :name clashes)})))
         (vec (concat functions
                      (remove #(contains? declared (:name %)) wanted)))))))

#?(:kotoba
   (defn- declared-named [functions [:list [:ref :form/r]] name [:ref :form/r]] [:ref :form/r]
     (let [n (vector-count functions)]
       (loop [i 0 found (form-nil-form)]
         (if (>= i n)
           found
           (let [f (typed-list-nth [:list [:ref :form/r]] functions i)]
             (recur (inc i) (if (form-eq (fget f :name) name) f found))))))))

#?(:kotoba
   (defn- declares? [functions [:list [:ref :form/r]] name [:ref :form/r]] :bool
     (let [n (vector-count functions)]
       (loop [i 0]
         (if (>= i n)
           false
           (if (form-eq (fget (typed-list-nth [:list [:ref :form/r]] functions i) :name) name) true (recur (inc i))))))))

#?(:kotoba
   ;; A helper clashes when a function of its name is declared and differs.
   (defn- clashes? [functions [:list [:ref :form/r]] helper [:ref :form/r]] :bool
     (let [name (fget helper :name)]
       (and (declares? functions name)
            (not (form-eq (declared-named functions name) helper))))))

#?(:kotoba
   (defn- with-helper [functions [:list [:ref :form/r]] helper [:ref :form/r]] [:list [:ref :form/r]]
     (if (declares? functions (fget helper :name)) functions (form-append-form functions helper))))

#?(:kotoba
   (defn augment-functions
     "Append the private helpers exactly when a declared body uses string-index;
     idempotent; a same-named different function aborts."
     [functions [:ref :form/r]] [:ref :form/r]
     (let [fs (form-kids-of functions)
           h1 (find-function)
           h2 (key-bytes-function)]
       (if (not (any-body-uses? fs))
         functions
         (if (or (clashes? fs h1) (clashes? fs h2))
           (throw (ex-info "a program function collides with a native string-index helper"
                           {:phase :native :problem :helper-collision}))
           (form-form-vec (with-helper (with-helper fs h1) h2)))))))
