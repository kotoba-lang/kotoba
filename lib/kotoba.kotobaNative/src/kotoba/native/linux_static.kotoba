;; Complete canonical Linux-static packager composition. Unqualified source.
(ns kotoba.native.linux-static
  {:kotoba/export [package plan targets image-layout slot-names implemented-slots]}
  (:require [kotoba.artifact.core :as artifact]
            [kotoba.object.elf64 :as elf]
            [kotoba.native.linux-static-plan :as planning]
            [kotoba.native.linux-static-assembler :as asm]
            [kotoba.native.linux-static-prelude :as prelude]
            [kotoba.native.linux-static-context :as context])
  (:schemas
   {:linux.static.image/result
    [:record :linux.static.image/result
     [[:bytes :vector-i64] [:value :document] [:error :keyword] [:data :document]]]
    :linux.static.image/decisions
    [:record :linux.static.image/decisions
     [[:bytes :vector-i64] [:labels [:list [:ref :linux.static/label]]] [:regions :document]
      [:error :keyword] [:data :document]]]
    :linux.static.image/build
    [:record :linux.static.image/build
     [[:text :vector-i64] [:context :vector-i64] [:layout :document] [:details :document]
      [:error :keyword] [:data :document]]]}))

(defn targets [] :document (planning/targets))
(defn implemented-slots [] :document (planning/implemented-slots))
(defn slot-names [abi :document] [:ref :linux.static.plan/result] (planning/slot-names abi))
(defn plan [source :document profile :document overrides :document] [:ref :linux.static.plan/result]
  (planning/plan source profile overrides))
(defn image-layout [text-size :i64 source-plan :document] [:ref :linux.static.plan/result]
  (planning/image-layout text-size source-plan))
(defn- text-base [] :i64 4198400)
(defn- assembly-limit [] :i64 (- 9223372036854775807 (text-base)))
(defn- lookup [m :document key :document] :document
  (if (not= (document-kind m) :map) (document-null)
    (loop [index 0]
      (if (= index (document-count m)) (document-null)
        (let [pair (option-value-of [:option :document] (document-map-entry-at m index) (document-null))]
          (if (document-equal? (option-value-of [:option :document] (document-vector-at pair 0) (document-null)) key)
            (option-value-of [:option :document] (document-vector-at pair 1) (document-null)) (recur (+ index 1))))))))
(defn- get-key [m :document key :keyword] :document (lookup m (document-keyword key)))
(defn- item [v :document index :i64] :document
  (if (= (document-kind v) :list)
    (option-value-of [:option :document] (document-list-at v index) (document-null))
    (option-value-of [:option :document] (document-vector-at v index) (document-null))))
(defn- i64-of [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) -1))
(defn- key-of [d :document] :keyword (option-value-of [:option :keyword] (document-keyword-value d) :none))
(defn- true? [d :document] :bool (document-equal? d (document-bool true)))
(defn- detail [stage :keyword field :keyword] :document
  (document-map (document-keyword :stage) (document-keyword stage) (document-keyword :field) (document-keyword field)))
(defn- ok [bytes :vector-i64] [:ref :linux.static.image/result]
  (record-new [:ref :linux.static.image/result] bytes (document-null) :ok (document-null)))
(defn- fail [error :keyword data :document] [:ref :linux.static.image/result]
  (record-new [:ref :linux.static.image/result] (vector-alloc 0) (document-null) error data))
(defn- good? [r [:ref :linux.static.image/result]] :bool
  (= (record-get [:ref :linux.static.image/result] r :error) :ok))
(defn- bytes-of [r [:ref :linux.static.image/result]] :vector-i64
  (record-get [:ref :linux.static.image/result] r :bytes))
(defn- checked-add [a :i64 b :i64] :i64
  (if (or (< a 0) (< b 0) (> b (- 9223372036854775807 a))) -1 (+ a b)))
(defn- align-up [n :i64 alignment :i64] :i64
  (if (or (< n 0) (<= alignment 0)) -1
    (let [remainder (- n (* (quot n alignment) alignment))]
      (checked-add n (if (= remainder 0) 0 (- alignment remainder))))))
(defn- zeros [n :i64] :vector-i64
  (loop [index 0 out (vector-alloc 0)] (if (= index n) out (recur (+ index 1) (vector-conj out 0)))))
(defn- join [a :vector-i64 b :vector-i64] :vector-i64
  (loop [index 0 out a]
    (if (= index (vector-count b)) out (recur (+ index 1) (vector-conj out (vector-at b index))))))
(defn- append-bytes [out [:ref :linux.static.image/result] more :vector-i64] [:ref :linux.static.image/result]
  (if (not (good? out)) out
    (if (< (checked-add (vector-count (bytes-of out)) (vector-count more)) 0) (fail :image-overflow (detail :frame :bytes))
      (ok (join (bytes-of out) more)))))
(defn- from-elf [r [:ref :kotoba.object.elf64/result] stage :keyword] [:ref :linux.static.image/result]
  (if (not= (record-get [:ref :kotoba.object.elf64/result] r :error) :ok)
    (fail (record-get [:ref :kotoba.object.elf64/result] r :error)
      (detail stage (record-get [:ref :kotoba.object.elf64/result] r :field)))
    (ok (record-get [:ref :kotoba.object.elf64/result] r :bytes))))
(defn- append-elf [out [:ref :linux.static.image/result] more [:ref :kotoba.object.elf64/result] stage :keyword]
  [:ref :linux.static.image/result]
  (if (not (good? out)) out
    (let [r (from-elf more stage)] (if (good? r) (append-bytes out (bytes-of r)) r))))
(defn- pad-result [out [:ref :linux.static.image/result] size :i64 stage :keyword] [:ref :linux.static.image/result]
  (if (not (good? out)) out (from-elf (elf/pad-to (bytes-of out) size) stage)))
(defn- normalized-code [value :document field :keyword] [:ref :linux.static.image/result]
  (if (= (document-kind value) :bytes)
    (let [bytes (option-value-of [:option :bytes] (document-bytes-value value) (bytes-empty))]
      (loop [index 0 out (vector-alloc 0)]
        (if (= index (bytes-count bytes)) (ok out) (recur (+ index 1) (vector-conj out (bytes-at bytes index))))))
    (if (not (or (= (document-kind value) :vector) (= (document-kind value) :list))) (fail :artifact-code (detail :code field))
      (loop [index 0 out (vector-alloc 0)]
        (if (= index (document-count value)) (ok out)
          (let [byte (item value index)]
            (if (not= (document-kind byte) :i64) (fail :artifact-code (detail :code field))
              (recur (+ index 1) (vector-conj out (bit-and (i64-of byte) 255))))))))))
(defn- address [labels [:list [:ref :linux.static/label]] name :keyword] :i64
  (loop [index 0]
    (if (= index (vector-count labels)) -1
      (let [row (typed-list-nth [:list [:ref :linux.static/label]] labels index)]
        (if (= (record-get [:ref :linux.static/label] row :name) name)
          (record-get [:ref :linux.static/label] row :address) (recur (+ index 1)))))))
(defn- external-labels [labels [:list [:ref :linux.static/label]] main :i64] [:list [:ref :linux.static/label]]
  (typed-list-conj [:list [:ref :linux.static/label]] labels (asm/label :ls/guest-main main)))
(defn- add-label [labels [:list [:ref :linux.static/label]] name :keyword value :i64] [:list [:ref :linux.static/label]]
  (typed-list-conj [:list [:ref :linux.static/label]] labels (asm/label name value)))
(defn- decision-fail [error :keyword data :document] [:ref :linux.static.image/decisions]
  (record-new [:ref :linux.static.image/decisions] (vector-alloc 0)
    (typed-list-new [:list [:ref :linux.static/label]]) (document-vector) error data))
(defn- symbol-offset [component :document name :string size :i64] :i64
  (let [offset (lookup (get-key component :offsets) (document-symbol (symbol name)))]
    (if (and (= (document-kind offset) :i64) (>= (i64-of offset) 0) (< (i64-of offset) size)) (i64-of offset) -1)))
(defn- decision-text [source-plan :document code-end :i64] [:ref :linux.static.image/decisions]
  (if (not (true? (get-key source-plan :handlers?)))
    (record-new [:ref :linux.static.image/decisions] (vector-alloc 0)
      (typed-list-new [:list [:ref :linux.static/label]]) (document-vector) :ok (document-null))
    (let [pair (get-key source-plan :handler-code) decisions (get-key pair :decisions) handlers (get-key pair :handlers)
          dr (normalized-code (get-key decisions :code) :decisions) hr (normalized-code (get-key handlers :code) :handlers)]
      (cond
        (not (good? dr)) (decision-fail (record-get [:ref :linux.static.image/result] dr :error) (record-get [:ref :linux.static.image/result] dr :data))
        (not (good? hr)) (decision-fail (record-get [:ref :linux.static.image/result] hr :error) (record-get [:ref :linux.static.image/result] hr :data))
        :else
        (let [dsize (vector-count (bytes-of dr)) hsize (vector-count (bytes-of hr))
              c1 (align-up code-end 16) dend (checked-add c1 dsize) h (align-up dend 16) end (checked-add h hsize)
              cap (symbol-offset decisions "cap-admitted" dsize) decide (symbol-offset decisions "decide" dsize)
              handle (symbol-offset handlers "decide" hsize)]
          (cond
            (or (< c1 0) (< dend 0) (< h 0) (< end 0)) (decision-fail :layout-overflow (detail :decisions :end))
            (or (< cap 0) (< decide 0) (< handle 0)) (decision-fail :handler-export (detail :decisions :offsets))
            :else
            (let [bytes (join (join (join (zeros (- c1 code-end)) (bytes-of dr)) (zeros (- h dend))) (bytes-of hr))
                  labels (-> (typed-list-new [:list [:ref :linux.static/label]])
                             (add-label :ls.cap/c1-cap (+ c1 cap))
                             (add-label :ls.cap/c1-decide (+ c1 decide))
                             (add-label :ls.cap/h-decide (+ h handle)))
                  regions (document-vector
                            (document-map (document-keyword :which) (document-keyword :decisions)
                              (document-keyword :address) (document-i64 c1) (document-keyword :size) (document-i64 dsize))
                            (document-map (document-keyword :which) (document-keyword :handlers)
                              (document-keyword :address) (document-i64 h) (document-keyword :size) (document-i64 hsize)))]
              (record-new [:ref :linux.static.image/decisions] bytes labels regions :ok (document-null)))))))))
(defn- build-fail [error :keyword data :document] [:ref :linux.static.image/build]
  (record-new [:ref :linux.static.image/build] (vector-alloc 0) (vector-alloc 0) (document-null) (document-null) error data))
(defn- finish-build [isa :keyword source-plan :document layout :document guest :vector-i64 main-offset :i64
                     prelude-size :i64 decisions [:ref :linux.static.image/decisions]] [:ref :linux.static.image/build]
  (let [body (prelude/routine isa source-plan layout)
        code-address (+ (text-base) prelude-size) main-address (+ code-address main-offset)]
    (if (not= (record-get [:ref :linux.static.prelude/result] body :error) :ok)
      (build-fail (record-get [:ref :linux.static.prelude/result] body :error) (detail :prelude :final))
      (let [assembled (asm/assemble isa (text-base) (record-get [:ref :linux.static.prelude/result] body :code)
                        (external-labels (record-get [:ref :linux.static.image/decisions] decisions :labels) main-address) (assembly-limit))
            labels (record-get [:ref :linux.static/result] assembled :labels)
            prelude (record-get [:ref :linux.static/result] assembled :bytes) entry (address labels :ls/start)]
        (cond
          (not= (record-get [:ref :linux.static/result] assembled :error) :ok)
          (build-fail (record-get [:ref :linux.static/result] assembled :error)
            (document-map (document-keyword :stage) (document-keyword :assembly-final)
              (document-keyword :at) (document-i64 (record-get [:ref :linux.static/result] assembled :at))))
          (or (not= (vector-count prelude) prelude-size) (not= (address labels :ls/text-end) code-address))
          (build-fail :prelude-size (detail :assembly-final :text-end))
          (or (< entry (text-base)) (>= entry code-address)) (build-fail :entry-span (detail :assembly-final :start))
          :else
          (let [initialized (context/context-bytes source-plan layout labels
                              (record-get [:ref :linux.static.prelude/result] body :bindings) code-address (vector-count guest))]
            (if (not= (record-get [:ref :linux.static.context/result] initialized :error) :ok)
              (build-fail (record-get [:ref :linux.static.context/result] initialized :error) (detail :context :initialized))
              (record-new [:ref :linux.static.image/build]
                (join (join prelude guest) (record-get [:ref :linux.static.image/decisions] decisions :bytes))
                (record-get [:ref :linux.static.context/result] initialized :bytes) layout
                (document-map (document-keyword :entry-address) (document-i64 entry)
                  (document-keyword :main-address) (document-i64 main-address)
                  (document-keyword :prelude-size) (document-i64 prelude-size)
                  (document-keyword :code-size) (document-i64 (vector-count guest))
                  (document-keyword :decision-regions) (record-get [:ref :linux.static.image/decisions] decisions :regions))
                :ok (document-null)))))))))
(defn- build-after-probe [isa :keyword source-plan :document guest :vector-i64 main-offset :i64 probe [:ref :linux.static/result]]
  [:ref :linux.static.image/build]
  (let [size (vector-count (record-get [:ref :linux.static/result] probe :bytes))
        code-address (checked-add (text-base) size) code-end (checked-add code-address (vector-count guest))]
    (cond
      (or (< code-address 0) (< code-end 0)) (build-fail :layout-overflow (detail :probe :code-end))
      (not= (address (record-get [:ref :linux.static/result] probe :labels) :ls/text-end) code-address)
      (build-fail :prelude-size (detail :probe :text-end))
      :else
      (let [decisions (decision-text source-plan code-end)]
        (if (not= (record-get [:ref :linux.static.image/decisions] decisions :error) :ok)
          (build-fail (record-get [:ref :linux.static.image/decisions] decisions :error)
            (record-get [:ref :linux.static.image/decisions] decisions :data))
          (let [text-size (checked-add (checked-add size (vector-count guest))
                            (vector-count (record-get [:ref :linux.static.image/decisions] decisions :bytes)))]
            (if (< text-size 0) (build-fail :layout-overflow (detail :layout :text-size))
              (let [layout (planning/image-layout text-size source-plan)]
                (if (not= (record-get [:ref :linux.static.plan/result] layout :error) :ok)
                  (build-fail (record-get [:ref :linux.static.plan/result] layout :error)
                    (record-get [:ref :linux.static.plan/result] layout :data))
                  (finish-build isa source-plan (record-get [:ref :linux.static.plan/result] layout :value)
                    guest main-offset size decisions))))))))))
(defn- build [isa :keyword source-plan :document guest :vector-i64 main-offset :i64] [:ref :linux.static.image/build]
  (let [layout (planning/image-layout 0 source-plan)]
    (if (not= (record-get [:ref :linux.static.plan/result] layout :error) :ok)
      (build-fail (record-get [:ref :linux.static.plan/result] layout :error) (record-get [:ref :linux.static.plan/result] layout :data))
      (let [body (prelude/routine isa source-plan (record-get [:ref :linux.static.plan/result] layout :value))
            decisions (decision-text source-plan (text-base))]
        (cond
          (not= (record-get [:ref :linux.static.prelude/result] body :error) :ok)
          (build-fail (record-get [:ref :linux.static.prelude/result] body :error) (detail :prelude :probe))
          (not= (record-get [:ref :linux.static.image/decisions] decisions :error) :ok)
          (build-fail (record-get [:ref :linux.static.image/decisions] decisions :error)
            (record-get [:ref :linux.static.image/decisions] decisions :data))
          :else
          (let [probe (asm/assemble isa (text-base) (record-get [:ref :linux.static.prelude/result] body :code)
                        (external-labels (record-get [:ref :linux.static.image/decisions] decisions :labels) (text-base)) (assembly-limit))]
            (if (not= (record-get [:ref :linux.static/result] probe :error) :ok)
              (build-fail (record-get [:ref :linux.static/result] probe :error)
                (document-map (document-keyword :stage) (document-keyword :assembly-probe)
                  (document-keyword :at) (document-i64 (record-get [:ref :linux.static/result] probe :at))))
              (build-after-probe isa source-plan guest main-offset probe))))))))

(defn- section [name-offset :i64 type :keyword flags :i64 address :i64 offset :i64 size :i64 alignment :i64]
  [:ref :kotoba.object.elf64/result]
  (elf/encode-section-header
    (document-map (document-keyword :name-offset) (document-i64 name-offset) (document-keyword :type) (document-keyword type)
      (document-keyword :flags) (document-i64 flags) (document-keyword :address) (document-i64 address)
      (document-keyword :offset) (document-i64 offset) (document-keyword :size) (document-i64 size)
      (document-keyword :alignment) (document-i64 alignment))))
(defn- program-header [type :document flags :i64 offset :i64 address :i64 file-size :i64 memory-size :i64 alignment :i64]
  [:ref :kotoba.object.elf64/result]
  (elf/encode-program-header
    (document-map (document-keyword :type) type (document-keyword :flags) (document-i64 flags)
      (document-keyword :offset) (document-i64 offset) (document-keyword :virtual-address) (document-i64 address)
      (document-keyword :file-size) (document-i64 file-size) (document-keyword :memory-size) (document-i64 memory-size)
      (document-keyword :alignment) (document-i64 alignment))))
(defn- utf8 [text :string] :vector-i64
  (let [bytes (string-to-utf8 text)]
    (loop [index 0 out (vector-alloc 0)]
      (if (= index (bytes-count bytes)) out (recur (+ index 1) (vector-conj out (bytes-at bytes index)))))))
(defn- frame [machine :keyword built [:ref :linux.static.image/build]] [:ref :linux.static.image/result]
  (let [layout (record-get [:ref :linux.static.image/build] built :layout) details (record-get [:ref :linux.static.image/build] built :details)
        text (record-get [:ref :linux.static.image/build] built :text) context (record-get [:ref :linux.static.image/build] built :context)
        text-offset (i64-of (get-key layout :text-offset)) text-address (i64-of (get-key layout :text))
        data-offset (i64-of (get-key layout :data-offset)) data-address (i64-of (get-key layout :data))
        memory-size (i64-of (get-key layout :memory-size)) names (utf8 "\u0000.text\u0000.data\u0000.bss\u0000.shstrtab\u0000")
        names-offset (checked-add data-offset 1024) section-offset (align-up (checked-add names-offset (vector-count names)) 8)
        end (checked-add section-offset 320)]
    (cond
      (or (< names-offset 0) (< section-offset 0) (< end 0)) (fail :image-overflow (detail :frame :section-offset))
      (or (not= text-offset 4096) (not= text-address (text-base)) (< data-offset text-offset)
          (> (vector-count text) (- data-offset text-offset)) (not= (vector-count context) 1024) (< memory-size 4096)
          (< data-address 0) (> memory-size (- 9223372036854775807 data-address))) (fail :layout-input (detail :frame :regions))
      :else
      (let [header (elf/encode-header
                     (document-map (document-keyword :type) (document-keyword :executable) (document-keyword :machine) (document-keyword machine)
                       (document-keyword :entry) (get-key details :entry-address) (document-keyword :program-header-offset) (document-i64 64)
                       (document-keyword :program-header-count) (document-i64 3) (document-keyword :section-header-offset) (document-i64 section-offset)
                       (document-keyword :section-header-count) (document-i64 5) (document-keyword :section-name-index) (document-i64 4)))
            bytes (-> (from-elf header :header)
                      (append-elf (program-header (document-keyword :load) 5 text-offset text-address (vector-count text) (vector-count text) 4096) :text-program)
                      (append-elf (program-header (document-keyword :load) 6 data-offset data-address 1024 memory-size 4096) :data-program)
                      (append-elf (program-header (document-i64 1685382481) 6 0 0 0 0 16) :stack-program)
                      (pad-result text-offset :before-text) (append-bytes text) (pad-result data-offset :before-data)
                      (append-bytes context) (append-bytes names) (pad-result section-offset :before-sections)
                      (append-bytes (zeros 64))
                      (append-elf (section 1 :progbits 6 text-address text-offset (vector-count text) 16) :text-section)
                      (append-elf (section 7 :progbits 3 data-address data-offset 1024 16) :data-section)
                      (append-elf (section 13 :nobits 3 (+ data-address 4096) names-offset (- memory-size 4096) 16) :bss-section)
                      (append-elf (section 18 :strtab 0 0 names-offset (vector-count names) 1) :names-section))]
        (if (and (good? bytes) (not= (vector-count (bytes-of bytes)) end))
          (fail :image-size (detail :frame :end)) bytes)))))
(defn- slot-states [slots :document] :document
  (loop [index 0 out (document-map)]
    (if (= index (document-count slots)) out
      (let [pair (option-value-of [:option :document] (document-map-entry-at slots index) (document-null))]
        (recur (+ index 1) (document-merge out (document-map (item pair 0)
          (document-keyword (if (true? (get-key (item pair 1) :admitted?)) :implemented :traps)))))))))
(defn- file-regions [regions :document] :document
  (loop [index 0 out (document-vector)]
    (if (= index (document-count regions)) out
      (let [row (item regions index) offset (+ 4096 (- (i64-of (get-key row :address)) (text-base)))]
        (recur (+ index 1) (document-vector-conj out (document-merge row
          (document-map (document-keyword :address) (document-i64 offset)))))))))
(defn- metadata [source :document source-plan :document built [:ref :linux.static.image/build]] :document
  (let [details (record-get [:ref :linux.static.image/build] built :details) layout (record-get [:ref :linux.static.image/build] built :layout)]
    (document-map
      (document-keyword :format) (document-keyword :elf64/v1) (document-keyword :target) (get-key source :target)
      (document-keyword :entry) (document-keyword :_start) (document-keyword :entry-address) (get-key details :entry-address)
      (document-keyword :source-entry) (get-key (get-key source :program) :entry) (document-keyword :main-address) (get-key details :main-address)
      (document-keyword :text-offset) (get-key layout :text-offset) (document-keyword :prelude-size) (get-key details :prelude-size)
      (document-keyword :code-offset) (document-i64 (+ (i64-of (get-key layout :text-offset)) (i64-of (get-key details :prelude-size))))
      (document-keyword :code-size) (get-key details :code-size)
      (document-keyword :data-offset) (get-key layout :data-offset) (document-keyword :data-address) (get-key layout :data)
      (document-keyword :budgets) (document-map (document-keyword :cells) (get-key source-plan :cells)
        (document-keyword :bytes) (get-key source-plan :bytes)
        (document-keyword :vectors) (get-key source-plan :vectors)
        (document-keyword :vector-items) (get-key source-plan :vector-items)
        (document-keyword :vector-item-limit) (get-key source-plan :vector-item-limit)
        (document-keyword :byte-value-limit) (get-key source-plan :byte-value-limit)
        (document-keyword :string-value-limit) (get-key source-plan :string-value-limit))
      (document-keyword :fuel) (document-map (document-keyword :initial) (get-key source-plan :fuel) (document-keyword :metered) (get-key source-plan :metered?))
      (document-keyword :slots) (slot-states (get-key source-plan :slots))
      (document-keyword :sections) (document-vector (document-keyword :text) (document-keyword :data) (document-keyword :bss) (document-keyword :shstrtab))
      (document-keyword :imports) (document-vector) (document-keyword :interpreter) (document-null) (document-keyword :dynamic) (document-null)
      (document-keyword :grant) (get-key source-plan :grant) (document-keyword :fs-scope) (get-key source-plan :fs-scope)
      (document-keyword :spawn) (get-key source-plan :spawn)
      (document-keyword :decision-code) (file-regions (get-key details :decision-regions)))))
(defn- package-planned [source :document source-plan :document target :document code :vector-i64 main-offset :i64]
  [:ref :linux.static.image/result]
  (let [built (build (key-of (get-key target :isa)) source-plan code main-offset)]
    (if (not= (record-get [:ref :linux.static.image/build] built :error) :ok)
      (fail (record-get [:ref :linux.static.image/build] built :error) (record-get [:ref :linux.static.image/build] built :data))
      (let [framed (frame (key-of (get-key target :machine)) built)]
        (if (not (good? framed)) framed
          (record-new [:ref :linux.static.image/result] (bytes-of framed) (metadata source source-plan built) :ok (document-null)))))))

(defn package [source :document profile :document overrides :document] [:ref :linux.static.image/result]
  (cond
    (or (not= (document-kind source) :map) (not (artifact/valid-seal? source))) (fail :unsealed (detail :admission :artifact))
    :else
    (let [target (lookup (planning/targets) (get-key source :target))
          entry (get-key (get-key source :program) :entry) export (lookup (get-key source :exports) entry)]
      (cond
        (not= (document-kind target) :map) (fail :not-linux-static (detail :admission :target))
        (or (not= (document-kind export) :map) (not (document-equal? (get-key export :arity) (document-i64 0))))
        (fail :entry-not-zero-arity (detail :admission :entry))
        :else
        (let [code (normalized-code (get-key source :code) :guest) offset (get-key export :offset)]
          (cond
            (not (good? code)) code
            (or (not= (document-kind offset) :i64) (< (i64-of offset) 0) (>= (i64-of offset) (vector-count (bytes-of code))))
            (fail :entry-span (detail :admission :offset))
            :else
            (let [source-plan (planning/plan source profile overrides)]
              (if (not= (record-get [:ref :linux.static.plan/result] source-plan :error) :ok)
                (fail (record-get [:ref :linux.static.plan/result] source-plan :error) (record-get [:ref :linux.static.plan/result] source-plan :data))
                (package-planned source (record-get [:ref :linux.static.plan/result] source-plan :value)
                  target (bytes-of code) (i64-of offset))))))))))
