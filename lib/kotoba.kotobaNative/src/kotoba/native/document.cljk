      (h 'kotoba$doc-merge '[a b] [:string :string] :string
         '(kotoba$doc-merge-from a b 1))
      (h 'kotoba$doc-entry-at '[m i] [:string :i64] [:option :document]
         '(if (< i 0) (option-none-of [:option :document])
              (let [p (kotoba$doc-item m 1 (* 2 i))]
                (if (< p 0) (option-none-of [:option :document])
                    (let [ke (kotoba$doc-end m p)]
                      (option-some-of [:option :document]
                                      (string-concat
                                       (string-concat "[" (string-substring m p (kotoba$doc-end m (+ ke 1))))
                                       "]")))))))

      ;; ── vectors, lists, sets ──
      (h 'kotoba$doc-nth '[d i] [:string :i64] [:option :document]
         '(if (< i 0) (option-none-of [:option :document])
              (let [p (kotoba$doc-item d (kotoba$doc-open d) i)]
                (if (< p 0) (option-none-of [:option :document])
                    (option-some-of [:option :document]
                                    (string-substring d p (kotoba$doc-end d p)))))))
      (h 'kotoba$doc-conj '[v x] [:string :string] :string
         '(kotoba$doc-bounded (kotoba$doc-insert-at v (kotoba$doc-close v) x)))
      (h 'kotoba$doc-vector-assoc '[v i x] [:string :i64 :string] :string
         '(let [p (if (< i 0) -1 (kotoba$doc-item v 1 i))]
            (if (< p 0) (kotoba$doc-trap)
                (kotoba$doc-bounded
                 (string-concat (string-append-range "" v 0 p)
                                (string-concat x (string-substring v (kotoba$doc-end v p)
                                                                   (string-byte-length v))))))))
      (h 'kotoba$doc-vector-remove '[v i] [:string :i64] :string
         '(let [p (if (< i 0) -1 (kotoba$doc-item v 1 i))]
            (if (< p 0) (kotoba$doc-trap)
                (kotoba$doc-cut v p (kotoba$doc-end v p)))))
      (h 'kotoba$doc-vector-drop '[v n] [:string :i64] :string
         '(if (< n 0) (kotoba$doc-trap)
              (if (> n (kotoba$doc-forms v)) (kotoba$doc-trap)
                  (if (= n 0) v
                      (let [p (kotoba$doc-item v 1 n)]
                        (if (< p 0) "[]"
                            (string-append-range "[" v p (string-byte-length v))))))))
      (h 'kotoba$doc-set-contains '[s x i] [:string :string :i64] :bool
         '(let [c (string-code-point-at s i)]
            (if (= c 32) (kotoba$doc-set-contains s x (+ i 1))
                (if (kotoba$doc-closer? c) false
                    (let [e (kotoba$doc-end s i)]
                      (if (kotoba$doc-region=? s i e x 0) true
                          (kotoba$doc-set-contains s x e)))))))
      ;; offset of the first item that sorts after X; traps on an equal one when
      ;; UNIQUE? (a set), keeps order among equals otherwise (a sort)
      (h 'kotoba$doc-item-slot '[s cx i unique?] [:string :string :i64 :bool] :i64
         '(let [c (string-code-point-at s i)]
            (if (= c 32) (kotoba$doc-item-slot s cx (+ i 1) unique?)
                (if (kotoba$doc-closer? c) i
                    (let [order (string-compare cx (kotoba$doc-canon-at "" s i))]
                      (if (< order 0) i
                          (if (if unique? (= order 0) false) (kotoba$doc-trap)
                              (kotoba$doc-item-slot s cx (kotoba$doc-end s i) unique?))))))))
      (h 'kotoba$doc-set-put '[s x] [:string :string] :string
         '(kotoba$doc-bounded
           (kotoba$doc-insert-at s (kotoba$doc-item-slot s (kotoba$doc-canon x) 2 true) x)))
      (h 'kotoba$doc-sort-from '[acc v i] [:string :string :i64] :string
         '(let [c (string-code-point-at v i)]
            (if (= c 32) (kotoba$doc-sort-from acc v (+ i 1))
                (if (kotoba$doc-closer? c) acc
                    (let [e (kotoba$doc-end v i)
                          x (string-substring v i e)]
                      (kotoba$doc-sort-from
                       (kotoba$doc-insert-at acc (kotoba$doc-item-slot acc (kotoba$doc-canon x) 1 false) x)
                       v e))))))
      (h 'kotoba$doc-vector-sort '[v] [:string] :string
         '(kotoba$doc-sort-from "[]" v 1))]))



;; The :bytes and :link constructors and readers (root ADR-2610092310 S4).
;; Appended only when a body names one of the four operations, so a document
;; program that does not keeps the helpers (and the code) it had; they are the
;; only helpers that touch a `:bytes` handle (a vector-arena handle on native).
#?(:kotoba
   ;; The host table below, printed (pr-str) and read by the Form EDN reader,
   ;; exactly as `helpers-text` is for `helpers`.
   (def ^:private bytes-helpers-text
     "[{:name kotoba$doc-pow2, :params [n], :param-types [:i64], :result :i64, :body (if (<= n 0) 1 (* 2 (kotoba$doc-pow2 (- n 1))))} {:name kotoba$doc-text-of, :params [v], :param-types [:vector-i64], :result :string, :body (string-from-utf8 (bytes-from-vector-i64 v))} {:name kotoba$doc-hex-digit, :params [n], :param-types [:i64], :result :i64, :body (if (< n 10) (+ n 48) (+ n 87))} {:name kotoba$doc-hex-into, :params [v b i], :param-types [:vector-i64 :bytes :i64], :result :vector-i64, :body (if (>= i (bytes-count b)) v (let [x (bytes-at b i) hi (quot x 16)] (kotoba$doc-hex-into (vector-assoc! (vector-assoc! v (* 2 i) (kotoba$doc-hex-digit hi)) (+ (* 2 i) 1) (kotoba$doc-hex-digit (- x (* hi 16)))) b (+ i 1))))} {:name kotoba$doc-bytes, :params [b], :param-types [:bytes], :result :string, :body (if (> (bytes-count b) 65536) (kotoba$doc-trap) (if (= (bytes-count b) 0) \"#kotoba/bytes \\\"\\\"\" (string-concat (string-concat \"#kotoba/bytes \\\"\" (kotoba$doc-text-of (kotoba$doc-hex-into (vector-alloc (* 2 (bytes-count b))) b 0))) \"\\\"\")))} {:name kotoba$doc-unhex-into, :params [v k d i e], :param-types [:vector-i64 :i64 :string :i64 :i64], :result :vector-i64, :body (if (>= i e) v (kotoba$doc-unhex-into (vector-assoc! v k (+ (* 16 (kotoba$doc-hex (string-code-point-at d i))) (kotoba$doc-hex (string-code-point-at d (+ i 1))))) (+ k 1) d (+ i 2) e))} {:name kotoba$doc-bytes-payload, :params [d], :param-types [:string], :result :bytes, :body (let [q (+ (string-find-byte d 34 0) 1) e (- (string-byte-length d) 1)] (if (>= q e) (bytes-empty) (bytes-from-vector-i64 (kotoba$doc-unhex-into (vector-alloc (quot (- e q) 2)) 0 d q e))))} {:name kotoba$doc-varint-end, :params [b i j], :param-types [:bytes :i64 :i64], :result :i64, :body (if (>= j (bytes-count b)) -1 (if (>= (- j i) 9) -1 (let [x (bytes-at b j)] (if (< x 128) (if (if (= x 0) (> j i) false) -1 (+ j 1)) (kotoba$doc-varint-end b i (+ j 1))))))} {:name kotoba$doc-varint-value, :params [b i e mult acc], :param-types [:bytes :i64 :i64 :i64 :i64], :result :i64, :body (if (>= i e) acc (let [x (bytes-at b i) acc (+ acc (* mult (if (< x 128) x (- x 128))))] (if (>= (+ i 1) e) acc (kotoba$doc-varint-value b (+ i 1) e (* mult 128) acc))))} {:name kotoba$doc-cidv1?, :params [b], :param-types [:bytes], :result :bool, :body (let [n (bytes-count b)] (if (> n 128) false (if (< n 1) false (if (= (bytes-at b 0) 1) (let [i1 (kotoba$doc-varint-end b 1 1)] (if (< i1 0) false (let [i2 (kotoba$doc-varint-end b i1 i1)] (if (< i2 0) false (let [i3 (kotoba$doc-varint-end b i2 i2)] (if (< i3 0) false (= (kotoba$doc-varint-value b i2 i3 1 0) (- n i3)))))))) false))))} {:name kotoba$doc-b32-digit, :params [x], :param-types [:i64], :result :i64, :body (if (< x 26) (+ x 97) (+ x 24))} {:name kotoba$doc-b32-into, :params [v k b i buf bits], :param-types [:vector-i64 :i64 :bytes :i64 :i64 :i64], :result :vector-i64, :body (if (>= bits 5) (let [p (kotoba$doc-pow2 (- bits 5)) x (quot buf p)] (kotoba$doc-b32-into (vector-assoc! v k (kotoba$doc-b32-digit x)) (+ k 1) b i (- buf (* x p)) (- bits 5))) (if (< i (bytes-count b)) (kotoba$doc-b32-into v k b (+ i 1) (+ (* buf 256) (bytes-at b i)) (+ bits 8)) (if (> bits 0) (vector-assoc! v k (kotoba$doc-b32-digit (* buf (kotoba$doc-pow2 (- 5 bits))))) v)))} {:name kotoba$doc-link, :params [b], :param-types [:bytes], :result [:option :document], :body (if (kotoba$doc-cidv1? b) (option-some-of [:option :document] (string-concat (string-concat \"#kotoba/cid \\\"b\" (kotoba$doc-text-of (kotoba$doc-b32-into (vector-alloc (quot (+ (* 8 (bytes-count b)) 4) 5)) 0 b 0 0 0))) \"\\\"\")) (option-none-of [:option :document]))} {:name kotoba$doc-unb32-into, :params [v k d i e buf bits], :param-types [:vector-i64 :i64 :string :i64 :i64 :i64 :i64], :result :vector-i64, :body (if (>= bits 8) (let [p (kotoba$doc-pow2 (- bits 8)) x (quot buf p)] (kotoba$doc-unb32-into (vector-assoc! v k x) (+ k 1) d i e (- buf (* x p)) (- bits 8))) (if (>= i e) v (kotoba$doc-unb32-into v k d (+ i 1) e (+ (* buf 32) (kotoba$doc-b32-value (string-code-point-at d i))) (+ bits 5))))} {:name kotoba$doc-link-payload, :params [d], :param-types [:string], :result :bytes, :body (let [q (+ (string-find-byte d 34 0) 2) e (- (string-byte-length d) 1)] (bytes-from-vector-i64 (kotoba$doc-unb32-into (vector-alloc (quot (* 5 (- e q)) 8)) 0 d q e 0 0)))}]")
   :default
   (def ^:private bytes-helpers
     [(h 'kotoba$doc-pow2 '[n] [:i64] :i64
         '(if (<= n 0) 1 (* 2 (kotoba$doc-pow2 (- n 1)))))
      ;; Text is written as code points into one vector-alloc'd run and made a
      ;; string once, so a payload costs its length in the string pool (an
      ;; append per digit would cost its square).
      (h 'kotoba$doc-text-of '[v] [:vector-i64] :string
         '(string-from-utf8 (bytes-from-vector-i64 v)))
      (h 'kotoba$doc-hex-digit '[n] [:i64] :i64 '(if (< n 10) (+ n 48) (+ n 87)))
      ;; V with the lowercase hex of B[I, end) at 2I on
      (h 'kotoba$doc-hex-into '[v b i] [:vector-i64 :bytes :i64] :vector-i64
         '(if (>= i (bytes-count b)) v
              (let [x (bytes-at b i)
                    hi (quot x 16)]
                (kotoba$doc-hex-into
                 (vector-assoc! (vector-assoc! v (* 2 i) (kotoba$doc-hex-digit hi))
                                (+ (* 2 i) 1) (kotoba$doc-hex-digit (- x (* hi 16))))
                 b (+ i 1)))))
      ;; the reference's bytes-value-byte-limit, then the EDN text
      (h 'kotoba$doc-bytes '[b] [:bytes] :string
         '(if (> (bytes-count b) 65536) (kotoba$doc-trap)
              (if (= (bytes-count b) 0) "#kotoba/bytes \"\""
                  (string-concat
                   (string-concat "#kotoba/bytes \""
                                  (kotoba$doc-text-of
                                   (kotoba$doc-hex-into (vector-alloc (* 2 (bytes-count b))) b 0)))
                   "\""))))
      ;; V with the bytes the hex digits d[i, e) spell, from K on
      (h 'kotoba$doc-unhex-into '[v k d i e] [:vector-i64 :i64 :string :i64 :i64] :vector-i64
         '(if (>= i e) v
              (kotoba$doc-unhex-into
               (vector-assoc! v k (+ (* 16 (kotoba$doc-hex (string-code-point-at d i)))
                                     (kotoba$doc-hex (string-code-point-at d (+ i 1)))))
               (+ k 1) d (+ i 2) e)))
      (h 'kotoba$doc-bytes-payload '[d] [:string] :bytes
         '(let [q (+ (string-find-byte d 34 0) 1)
                e (- (string-byte-length d) 1)]
            (if (>= q e) (bytes-empty)
                (bytes-from-vector-i64
                 (kotoba$doc-unhex-into (vector-alloc (quot (- e q) 2)) 0 d q e)))))
      ;; ── CIDv1 (osaho kotoba.kir.value/cidv1-binary-items?) ──
      ;; the end of the minimal unsigned LEB128 varint that starts at I, or -1
      ;; when it is truncated, longer than 9 bytes, or not minimal
      (h 'kotoba$doc-varint-end '[b i j] [:bytes :i64 :i64] :i64
         '(if (>= j (bytes-count b)) -1
              (if (>= (- j i) 9) -1
                  (let [x (bytes-at b j)]
                    (if (< x 128)
                      (if (if (= x 0) (> j i) false) -1 (+ j 1))
                      (kotoba$doc-varint-end b i (+ j 1)))))))
      ;; the value of the varint B[I, E); at most 63 bits, so it never wraps
      (h 'kotoba$doc-varint-value '[b i e mult acc] [:bytes :i64 :i64 :i64 :i64] :i64
         '(if (>= i e) acc
              (let [x (bytes-at b i)
                    acc (+ acc (* mult (if (< x 128) x (- x 128))))]
                (if (>= (+ i 1) e) acc
                    (kotoba$doc-varint-value b (+ i 1) e (* mult 128) acc)))))
      ;; version 1 (a minimal varint 1 is the one byte 1), codec, multihash code,
      ;; digest length, exactly that many digest bytes, at most 128 bytes in all
      (h 'kotoba$doc-cidv1? '[b] [:bytes] :bool
         '(let [n (bytes-count b)]
            (if (> n 128) false
                (if (< n 1) false
                    (if (= (bytes-at b 0) 1)
                      (let [i1 (kotoba$doc-varint-end b 1 1)]
                        (if (< i1 0) false
                            (let [i2 (kotoba$doc-varint-end b i1 i1)]
                              (if (< i2 0) false
                                  (let [i3 (kotoba$doc-varint-end b i2 i2)]
                                    (if (< i3 0) false
                                        (= (kotoba$doc-varint-value b i2 i3 1 0) (- n i3))))))))
                      false)))))
      (h 'kotoba$doc-b32-digit '[x] [:i64] :i64 '(if (< x 26) (+ x 97) (+ x 24)))
      ;; V from K on: the lowercase unpadded base32 of B from I; BUF holds the
      ;; BITS (< 13) not yet written
      (h 'kotoba$doc-b32-into '[v k b i buf bits] [:vector-i64 :i64 :bytes :i64 :i64 :i64] :vector-i64
         '(if (>= bits 5)
            (let [p (kotoba$doc-pow2 (- bits 5))
                  x (quot buf p)]
              (kotoba$doc-b32-into (vector-assoc! v k (kotoba$doc-b32-digit x)) (+ k 1)
                                   b i (- buf (* x p)) (- bits 5)))
            (if (< i (bytes-count b))
              (kotoba$doc-b32-into v k b (+ i 1) (+ (* buf 256) (bytes-at b i)) (+ bits 8))
              (if (> bits 0)
                (vector-assoc! v k (kotoba$doc-b32-digit (* buf (kotoba$doc-pow2 (- 5 bits)))))
                v))))
      (h 'kotoba$doc-link '[b] [:bytes] [:option :document]
         '(if (kotoba$doc-cidv1? b)
            (option-some-of [:option :document]
                            (string-concat
                             (string-concat "#kotoba/cid \"b"
                                            (kotoba$doc-text-of
                                             (kotoba$doc-b32-into
                                              (vector-alloc (quot (+ (* 8 (bytes-count b)) 4) 5))
                                              0 b 0 0 0)))
                             "\""))
            (option-none-of [:option :document])))
      ;; V from K on: the bytes the base32 digits d[i, e) spell; the trailing
      ;; bits of canonical base32 are zero and are dropped
      (h 'kotoba$doc-unb32-into '[v k d i e buf bits] [:vector-i64 :i64 :string :i64 :i64 :i64 :i64] :vector-i64
         '(if (>= bits 8)
            (let [p (kotoba$doc-pow2 (- bits 8))
                  x (quot buf p)]
              (kotoba$doc-unb32-into (vector-assoc! v k x) (+ k 1) d i e (- buf (* x p)) (- bits 8)))
            (if (>= i e) v
                (kotoba$doc-unb32-into v k d (+ i 1) e
                                       (+ (* buf 32) (kotoba$doc-b32-value (string-code-point-at d i)))
                                       (+ bits 5)))))
      (h 'kotoba$doc-link-payload '[d] [:string] :bytes
         '(let [q (+ (string-find-byte d 34 0) 2)
                e (- (string-byte-length d) 1)]
            (bytes-from-vector-i64
             (kotoba$doc-unb32-into (vector-alloc (quot (* 5 (- e q)) 8)) 0 d q e 0 0))))]))

#?(:kotoba
   (defn- bytes-helpers [] [:ref :form/r] (form-edn-form bytes-helpers-text)))

#?(:kotoba
   (defn- bytes-operation? [f [:ref :form/r]] :bool
     (or (sym-is? f "document-bytes") (sym-is? f "document-bytes-value")
         (sym-is? f "document-link") (sym-is? f "document-link-value")))
   :default
   (def ^:private bytes-operations
     '#{document-bytes document-bytes-value document-link document-link-value}))



#?(:kotoba
   (defn helper-names [] [:ref :form/r]
     (name-set (form-append-many (form-kids-of (helpers)) (form-kids-of (bytes-helpers)))))
   :default
   (def helper-names (set (map :name (concat helpers bytes-helpers)))))



;; The control characters 0..31, one byte each: what a `\u00XX` escape in a
;; canonical string reads back as.
#?(:kotoba
   (def ^:private control-json
     "\"\\u0000\\u0001\\u0002\\u0003\\u0004\\u0005\\u0006\\u0007\\u0008\\u0009\\u000a\\u000b\\u000c\\u000d\\u000e\\u000f\\u0010\\u0011\\u0012\\u0013\\u0014\\u0015\\u0016\\u0017\\u0018\\u0019\\u001a\\u001b\\u001c\\u001d\\u001e\\u001f\"")
   :default
   (def ^:private control-text
     (apply str (map char (range 32)))))

#?(:kotoba
   ;; The control characters 0..31, one byte each: what a `\u00XX` escape in a
   ;; canonical string reads back as.
   (defn- control-text [] :string
     (option-value-of [:option :string] (document-string-value (document-edn-read control-json)) "")))



#?(:kotoba
   (def ^:private control-binding "kotoba$doc-control")
   :default
   (def ^:private control-binding 'kotoba$doc-control))



;; ── the surface operations ──────────────────────────────────────────────────

#?(:kotoba
   (defn operations
     "The document operations this lowering answers."
     [] [:ref :form/r]
     (form-form-set
      (form-kids-of
       (form-edn-form "[document-null document-bool document-i64 document-string document-keyword document-symbol document-vector document-list document-set document-map document-count document-kind document-equal? document-set-contains? document-contains document-get document-vector-at document-list-at document-set-at document-map-entry-at document-vector-assoc document-vector-conj document-vector-drop document-vector-remove document-vector-sort document-assoc document-dissoc document-merge document-string-value document-keyword-value document-symbol-value document-bool-value document-i64-value document-edn-print document-edn-read document-bytes document-bytes-value document-link document-link-value]"))))
   :default
   (def operations
     "The document operations this lowering answers. Refused before it (by the
     native gate): document-f64, document-f64-value, document-sha256,
     document-print, document-read."
     '#{document-null document-bool document-i64 document-string document-keyword
        document-symbol document-vector document-list document-set document-map
        document-count document-kind document-equal? document-set-contains?
        document-contains document-get document-vector-at document-list-at document-set-at
        document-map-entry-at document-vector-assoc document-vector-conj
        document-vector-drop document-vector-remove document-vector-sort
        document-assoc document-dissoc document-merge document-string-value
        document-keyword-value document-symbol-value document-bool-value
        document-i64-value document-edn-print document-edn-read
        document-bytes document-bytes-value document-link document-link-value}))

#?(:kotoba
   (defn- operation? [f [:ref :form/r]] :bool
     (and (form-is-symbol? f)
          (let [ops (form-kids-of (operations))
                n (vector-count ops)]
            (loop [i 0]
              (if (>= i n) false (if (form-eq f (typed-list-nth [:list [:ref :form/r]] ops i)) true (recur (inc i)))))))))



#?(:kotoba
   (defn- kind-keyword [i :i64] :keyword
     (case i 0 :null 1 :bool 2 :i64 3 :f64 4 :string 5 :keyword 6 :symbol 7 :vector 8 :list 9 :set 11 :bytes 12 :link :map))
   :default
   (def ^:private kind-keywords
     [:null :bool :i64 :f64 :string :keyword :symbol :vector :list :set :map :bytes :link]))



#?(:kotoba
   (defn- require-kind [f [:ref :form/r] lo :i64 hi :i64] [:ref :form/r]
     (form-call3 "kotoba$doc-require" f (num lo) (num hi)))
   :default
   (defn- require-kind [form lo hi]
     (list 'kotoba$doc-require form lo hi)))



#?(:kotoba
   (defn- joined [open :string items [:list [:ref :form/r]] close :string] [:ref :form/r]
     (let [n (vector-count items)]
       (if (= n 0)
         (str- (string-concat open close))
         (loop [i 1 acc (form-call2 "string-concat" (str- open) (typed-list-nth [:list [:ref :form/r]] items 0))]
           (if (>= i n)
             (form-call2 "string-concat" acc (str- close))
             (recur (inc i)
                    (form-call2 "string-concat" (form-call2 "string-concat" acc (str- " ")) (typed-list-nth [:list [:ref :form/r]] items i))))))))
   :default
   (defn- joined [open items close]
     (if (empty? items)
       (str open close)
       (reduce (fn [acc item] (list 'string-concat acc item))
               (list 'string-concat open (first items))
               (concat (mapcat (fn [item] [" " item]) (rest items)) [close])))))



#?(:kotoba
   ;; VALUE-TYPE is the option's payload type: the kind's keyword, except
   ;; :bytes for both :bytes and :link (whose reader answers the CID's bytes).
   (defn- value-of-typed [kind :i64 f [:ref :form/r] payload [:ref :form/r] value-type :keyword] [:ref :form/r]
     (let [d (sym "document__")
           t (form-vec2 (form-keyword-form :option) (form-keyword-form value-type))]
       (form-call2 "let" (form-vec2 d f)
                   (form-call3 "if" (form-call2 "=" (form-call1 "kotoba$doc-kind" d) (num kind))
                               (form-call2 "option-some-of" t payload)
                               (form-call1 "option-none-of" t)))))
   :default
   (defn- value-of
     ([kind form payload] (value-of kind form payload (nth kind-keywords kind)))
     ([kind form payload value-type]
      (let [d (gensym "document__")]
        (list 'let [d form]
              (list 'if (list '= (list 'kotoba$doc-kind d) kind)
                    (list 'option-some-of [:option value-type] (payload d))
                    (list 'option-none-of [:option value-type])))))))



#?(:kotoba
   (defn- fold-set [args [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (vector-count args)]
       (loop [i 0 acc (str- "#{}")]
         (if (>= i n) acc (recur (inc i) (form-call2 "kotoba$doc-set-put" acc (typed-list-nth [:list [:ref :form/r]] args i)))))))
   :default
   (defn lower
     "Rewrite one document operation onto the string slots and the helpers."
     [op args]
     (case op
       document-null "nil"
       document-bool (list 'if (first args) "true" "false")
       document-i64 (list 'kotoba$doc-dec (first args))
       document-string (list 'kotoba$doc-escape (first args))
       document-keyword (first args)
       document-symbol (list 'kotoba$doc-symbol (first args))
       document-vector (if (> (count args) 32) trap (list 'kotoba$doc-bounded (joined "[" args "]")))
       document-list (if (> (count args) 32) trap (list 'kotoba$doc-bounded (joined "(" args ")")))
       document-set (if (> (count args) 32) trap
                        (reduce (fn [acc item] (list 'kotoba$doc-set-put acc item)) "#{}" args))
       document-map (if (> (count args) 64) trap
                        (reduce (fn [acc [k v]] (list 'kotoba$doc-map-put acc k v true))
                                "{}" (partition 2 args)))
       document-count (let [d (gensym "document__")]
                        (list 'let [d (require-kind (first args) 7 10)]
                              (list 'if (list '= (list 'kotoba$doc-kind d) 10)
                                    (list 'quot (list 'kotoba$doc-forms d) 2)
                                    (list 'kotoba$doc-forms d))))
       document-kind (let [k (gensym "kind__")]
                       (list 'let [k (list 'kotoba$doc-kind (first args))]
                             (reduce (fn [acc index]
                                       (list 'if (list '= k index) (nth kind-keywords index) acc))
                                     :map (concat [12 11] (range 9 -1 -1)))))
       document-equal? (list 'string=? (first args) (second args))
       document-set-contains? (list 'kotoba$doc-set-contains
                                    (require-kind (first args) 9 9) (second args) 2)
       document-contains (list '>= (list 'kotoba$doc-map-find (require-kind (first args) 10 10)
                                         (second args) 1)
                               0)
       document-get (list 'kotoba$doc-get (require-kind (first args) 10 10) (second args))
       (document-vector-at) (list 'kotoba$doc-nth (require-kind (first args) 7 7) (second args))
       (document-list-at) (list 'kotoba$doc-nth (require-kind (first args) 8 8) (second args))
       (document-set-at) (list 'kotoba$doc-nth (require-kind (first args) 9 9) (second args))
       document-map-entry-at (list 'kotoba$doc-entry-at (require-kind (first args) 10 10)
                                   (second args))
       document-vector-assoc (list 'kotoba$doc-vector-assoc (require-kind (first args) 7 7)
                                   (second args) (nth args 2))
       document-vector-conj (list 'kotoba$doc-conj (require-kind (first args) 7 7) (second args))
       document-vector-drop (list 'kotoba$doc-vector-drop (require-kind (first args) 7 7)
                                  (second args))
       document-vector-remove (list 'kotoba$doc-vector-remove (require-kind (first args) 7 7)
                                    (second args))
       document-vector-sort (list 'kotoba$doc-vector-sort (require-kind (first args) 7 7))
       document-assoc (list 'kotoba$doc-assoc (require-kind (first args) 10 10)
                            (second args) (nth args 2))
       document-dissoc (list 'kotoba$doc-dissoc (require-kind (first args) 10 10) (second args))
       document-merge (reduce (fn [acc m] (list 'kotoba$doc-merge acc (require-kind m 10 10)))
                              (require-kind (first args) 10 10) (rest args))
       document-string-value (value-of 4 (first args) (fn [d] (list 'kotoba$doc-unescape d)))
       document-keyword-value (value-of 5 (first args) identity)
       document-symbol-value (value-of 6 (first args) identity)
       document-bool-value (value-of 1 (first args) (fn [d] (list 'string=? d "true")))
       document-i64-value (value-of 2 (first args) (fn [d] (list 'kotoba$doc-parse-i64 d)))
       ;; :bytes and :link (root ADR-2610092310): the EDN tagged literals
       ;; `#kotoba/bytes \"<hex>\"` and `#kotoba/cid \"b<base32>\"`.
       document-bytes (list 'kotoba$doc-bytes (first args))
       document-bytes-value (value-of 11 (first args) (fn [d] (list 'kotoba$doc-bytes-payload d)) :bytes)
       document-link (list 'kotoba$doc-link (first args))
       document-link-value (value-of 12 (first args) (fn [d] (list 'kotoba$doc-link-payload d)) :bytes)
       ;; Identity at the ABI: the native document IS its canonical EDN text.
       (document-edn-print document-edn-read) (first args)
       (throw (ex-info "unknown native document operation" {:phase :native :operation op})))))

#?(:kotoba
   (defn- fold-map [args [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (vector-count args)]
       (loop [i 0 acc (str- "{}")]
         (if (>= (+ i 1) n)
           acc
           (recur (+ i 2) (form-call4 "kotoba$doc-map-put" acc (typed-list-nth [:list [:ref :form/r]] args i) (typed-list-nth [:list [:ref :form/r]] args (+ i 1)) (form-bool-form true))))))))

#?(:kotoba
   (defn- value-of [kind :i64 f [:ref :form/r] payload [:ref :form/r]] [:ref :form/r]
     (value-of-typed kind f payload (kind-keyword kind))))

#?(:kotoba
   ;; As the host's reduce over 12, 11, 9 .. 0: 12 and 11 innermost, before :map.
   (defn- kind-chain [k [:ref :form/r]] [:ref :form/r]
     (loop [index 9
            acc (form-call3 "if" (form-call2 "=" k (num 11)) (form-keyword-form :bytes)
                            (form-call3 "if" (form-call2 "=" k (num 12)) (form-keyword-form :link)
                                        (form-keyword-form :map)))]
       (if (< index 0)
         acc
         (recur (dec index) (form-call3 "if" (form-call2 "=" k (num index)) (form-keyword-form (kind-keyword index)) acc))))))

#?(:kotoba
   (defn- fold-merge [args [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (vector-count args)]
       (loop [i 1 acc (require-kind (form-nth-of (form-form-vec args) 0) 10 10)]
         (if (>= i n) acc
           (recur (inc i) (form-call2 "kotoba$doc-merge" acc (require-kind (typed-list-nth [:list [:ref :form/r]] args i) 10 10))))))))

#?(:kotoba
   (defn lower
     "Rewrite one document operation onto the string slots and the helpers. The
     Kotoba twin names its let-bound temporaries `document__` / `kind__` (the host
     gensyms them); they are bound around code whose operands sit in initialiser
     position, so no capture is possible."
     [op [:ref :form/r] args [:ref :form/r]] [:ref :form/r]
     (let [a (form-kids-of args)
           a0 (form-nth-of args 0)
           a1 (form-nth-of args 1)
           a2 (form-nth-of args 2)
           n (vector-count a)
           d (sym "document__")]
       (cond
         (and (or (sym-is? op "document-vector-assoc") (sym-is? op "document-assoc")) (< n 3))
         (throw (ex-info "native document operation missing an argument"
                         {:phase :native :problem :missing-argument}))
         (sym-is? op "document-null") (str- "nil")
         (sym-is? op "document-bool") (form-call3 "if" a0 (str- "true") (str- "false"))
         (sym-is? op "document-i64") (form-call1 "kotoba$doc-dec" a0)
         (sym-is? op "document-string") (form-call1 "kotoba$doc-escape" a0)
         (sym-is? op "document-keyword") a0
         (sym-is? op "document-symbol") (form-call1 "kotoba$doc-symbol" a0)
         (sym-is? op "document-vector") (if (> n 32) (trap) (form-call1 "kotoba$doc-bounded" (joined "[" a "]")))
         (sym-is? op "document-list") (if (> n 32) (trap) (form-call1 "kotoba$doc-bounded" (joined "(" a ")")))
         (sym-is? op "document-set") (if (> n 32) (trap) (fold-set a))
         (sym-is? op "document-map") (if (> n 64) (trap) (fold-map a))
         (sym-is? op "document-count")
         (form-call2 "let" (form-vec2 d (require-kind a0 7 10))
                     (form-call3 "if" (form-call2 "=" (form-call1 "kotoba$doc-kind" d) (num 10))
                                 (form-call2 "quot" (form-call1 "kotoba$doc-forms" d) (num 2))
                                 (form-call1 "kotoba$doc-forms" d)))
         (sym-is? op "document-kind")
         (let [k (sym "kind__")]
           (form-call2 "let" (form-vec2 k (form-call1 "kotoba$doc-kind" a0)) (kind-chain k)))
         (sym-is? op "document-equal?") (form-call2 "string=?" a0 a1)
         (sym-is? op "document-set-contains?") (form-call3 "kotoba$doc-set-contains" (require-kind a0 9 9) a1 (num 2))
         (sym-is? op "document-contains")
         (form-call2 ">=" (form-call3 "kotoba$doc-map-find" (require-kind a0 10 10) a1 (num 1)) (num 0))
         (sym-is? op "document-get") (form-call2 "kotoba$doc-get" (require-kind a0 10 10) a1)
         (sym-is? op "document-vector-at") (form-call2 "kotoba$doc-nth" (require-kind a0 7 7) a1)
         (sym-is? op "document-list-at") (form-call2 "kotoba$doc-nth" (require-kind a0 8 8) a1)
         (sym-is? op "document-set-at") (form-call2 "kotoba$doc-nth" (require-kind a0 9 9) a1)
         (sym-is? op "document-map-entry-at") (form-call2 "kotoba$doc-entry-at" (require-kind a0 10 10) a1)
         (sym-is? op "document-vector-assoc") (form-call3 "kotoba$doc-vector-assoc" (require-kind a0 7 7) a1 a2)
         (sym-is? op "document-vector-conj") (form-call2 "kotoba$doc-conj" (require-kind a0 7 7) a1)
         (sym-is? op "document-vector-drop") (form-call2 "kotoba$doc-vector-drop" (require-kind a0 7 7) a1)
         (sym-is? op "document-vector-remove") (form-call2 "kotoba$doc-vector-remove" (require-kind a0 7 7) a1)
         (sym-is? op "document-vector-sort") (form-call1 "kotoba$doc-vector-sort" (require-kind a0 7 7))
         (sym-is? op "document-assoc") (form-call3 "kotoba$doc-assoc" (require-kind a0 10 10) a1 a2)
         (sym-is? op "document-dissoc") (form-call2 "kotoba$doc-dissoc" (require-kind a0 10 10) a1)
         (sym-is? op "document-merge") (fold-merge a)
         (sym-is? op "document-string-value") (value-of 4 a0 (form-call1 "kotoba$doc-unescape" d))
         (sym-is? op "document-keyword-value") (value-of 5 a0 d)
         (sym-is? op "document-symbol-value") (value-of 6 a0 d)
         (sym-is? op "document-bool-value") (value-of 1 a0 (form-call2 "string=?" d (str- "true")))
         (sym-is? op "document-i64-value") (value-of 2 a0 (form-call1 "kotoba$doc-parse-i64" d))
         ;; :bytes and :link (root ADR-2610092310): the EDN tagged literals
         ;; `#kotoba/bytes \"<hex>\"` and `#kotoba/cid \"b<base32>\"`.
         (sym-is? op "document-bytes") (form-call1 "kotoba$doc-bytes" a0)
         (sym-is? op "document-bytes-value") (value-of-typed 11 a0 (form-call1 "kotoba$doc-bytes-payload" d) :bytes)
         (sym-is? op "document-link") (form-call1 "kotoba$doc-link" a0)
         (sym-is? op "document-link-value") (value-of-typed 12 a0 (form-call1 "kotoba$doc-link-payload" d) :bytes)
         (or (sym-is? op "document-edn-print") (sym-is? op "document-edn-read")) a0
         :else (throw (ex-info "unknown native document operation"
                               {:phase :native :problem :unknown-operation}))))))



#?(:kotoba
   (defn- any-uses? [xs [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) false (if (uses? (typed-list-nth [:list [:ref :form/r]] xs i)) true (recur (inc i)))))))
   :default
   (defn- uses? [form]
     (cond
       (seq? form) (or (and (contains? operations (first form))
                            (not (contains? '#{document-edn-print document-edn-read} (first form))))
                       (boolean (some uses? (rest form))))
       (vector? form) (boolean (some uses? form))
       :else false)))

#?(:kotoba
   ;; Only the REST of a list is visited, as on the host.
   (defn- uses? [f [:ref :form/r]] :bool
     (cond
       (form-is-seq? f)
       (or (and (operation? (form-first-of f))
                (not (sym-is? (form-first-of f) "document-edn-print"))
                (not (sym-is? (form-first-of f) "document-edn-read")))
           (any-uses? (form-rest-list f)))
       (form-is-vec? f) (any-uses? (form-kids-of f))
       :else false)))



#?(:kotoba
   (defn- any-uses-bytes? [xs [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) false (if (uses-bytes? (typed-list-nth [:list [:ref :form/r]] xs i)) true (recur (inc i)))))))
   :default
   (defn- uses-bytes? [form]
     (cond
       (seq? form) (or (contains? bytes-operations (first form))
                       (boolean (some uses-bytes? (rest form))))
       (vector? form) (boolean (some uses-bytes? form))
       :else false)))

#?(:kotoba
   (defn- uses-bytes? [f [:ref :form/r]] :bool
     (cond
       (form-is-seq? f)
       (or (bytes-operation? (form-first-of f))
           (any-uses-bytes? (form-rest-list f)))
       (form-is-vec? f) (any-uses-bytes? (form-kids-of f))
       :else false)))



#?(:kotoba
   (defn- substitute-kids [xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count xs)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n) acc (recur (inc i) (form-append-form acc (substitute-control (typed-list-nth [:list [:ref :form/r]] xs i))))))))
   :default
   (defn- substitute-control
     "The helpers name the control-character table by a symbol so their bodies
     stay printable; it becomes the literal here."
     [form]
     (cond
       (= form control-binding) control-text
       (seq? form) (apply list (map substitute-control form))
       (vector? form) (mapv substitute-control form)
       :else form)))

#?(:kotoba
   ;; The helpers name the control-character table by a symbol so their bodies stay
   ;; printable; it becomes the literal here.
   (defn- substitute-control [f [:ref :form/r]] [:ref :form/r]
     (cond
       (sym-is? f control-binding) (str- (control-text))
       (form-is-seq? f) (form-form-seq (substitute-kids (form-kids-of f)))
       (form-is-vec? f) (form-form-vec (substitute-kids (form-kids-of f)))
       :else f)))



#?(:kotoba
   ;; The helpers, plus the bytes helpers when BYTES? (a body names a :bytes /
   ;; :link operation), with the control table substituted.
   (defn- wanted-helpers [bytes? :bool] [:list [:ref :form/r]]
     (let [hs (if bytes?
                (form-append-many (form-kids-of (helpers)) (form-kids-of (bytes-helpers)))
                (form-kids-of (helpers)))
           n (vector-count hs)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n) acc
           (let [h (typed-list-nth [:list [:ref :form/r]] hs i)]
             (recur (inc i) (form-append-form acc (form-assoc-form h (form-keyword-form :body) (substitute-control (fget h :body))))))))))
   :default
   (defn augment-functions
     "FUNCTIONS plus the document helpers, exactly when a body uses a document
     operation this lowering answers. A program that does not is returned
     unchanged, so no existing emission moves. Idempotent; a program function
     with a helper's name and another definition is refused, because the calls
     this lowering emits would go there instead (as string-index does)."
     [functions]
     (if-not (some #(uses? (:body %)) functions)
       functions
       (let [declared (into {} (map (juxt :name identity)) functions)
             wanted (mapv #(update % :body substitute-control)
                          (if (some #(uses-bytes? (:body %)) functions)
                            (concat helpers bytes-helpers)
                            helpers))
             clashes (filter (fn [helper]
                               (when-let [existing (get declared (:name helper))]
                                 (not= existing helper)))
                             wanted)]
         (when (seq clashes)
           (throw (ex-info "a program function collides with a native document helper"
                           {:phase :native :functions (mapv :name clashes)})))
         (vec (concat functions (remove #(contains? declared (:name %)) wanted)))))))

#?(:kotoba
   (defn- any-body-uses? [functions [:list [:ref :form/r]]] :bool
     (let [n (vector-count functions)]
       (loop [i 0]
         (if (>= i n) false (if (uses? (fget (typed-list-nth [:list [:ref :form/r]] functions i) :body)) true (recur (inc i))))))))

#?(:kotoba
   (defn- any-body-uses-bytes? [functions [:list [:ref :form/r]]] :bool
     (let [n (vector-count functions)]
       (loop [i 0]
         (if (>= i n) false (if (uses-bytes? (fget (typed-list-nth [:list [:ref :form/r]] functions i) :body)) true (recur (inc i))))))))

#?(:kotoba
   (defn- declared-named [functions [:list [:ref :form/r]] name [:ref :form/r]] [:ref :form/r]
     (let [n (vector-count functions)]
       (loop [i 0 found (form-nil-form)]
         (if (>= i n) found
           (let [f (typed-list-nth [:list [:ref :form/r]] functions i)]
             (recur (inc i) (if (form-eq (fget f :name) name) f found))))))))

#?(:kotoba
   (defn- declares? [functions [:list [:ref :form/r]] name [:ref :form/r]] :bool
     (let [n (vector-count functions)]
       (loop [i 0]
         (if (>= i n) false (if (form-eq (fget (typed-list-nth [:list [:ref :form/r]] functions i) :name) name) true (recur (inc i))))))))

#?(:kotoba
   (defn- any-clash? [functions [:list [:ref :form/r]] wanted [:list [:ref :form/r]]] :bool
     (let [n (vector-count wanted)]
       (loop [i 0]
         (if (>= i n) false
           (let [h (typed-list-nth [:list [:ref :form/r]] wanted i)
                 name (fget h :name)]
             (if (and (declares? functions name) (not (form-eq (declared-named functions name) h)))
               true
               (recur (inc i)))))))))

#?(:kotoba
   (defn- append-missing [functions [:list [:ref :form/r]] wanted [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count wanted)]
       (loop [i 0 acc functions]
         (if (>= i n) acc
           (let [h (typed-list-nth [:list [:ref :form/r]] wanted i)]
             (recur (inc i) (if (declares? functions (fget h :name)) acc (form-append-form acc h)))))))))

#?(:kotoba
   (defn augment-functions
     "FUNCTIONS plus the document helpers, exactly when a body uses a document
     operation this lowering answers; idempotent; a same-named different function
     aborts."
     [functions [:ref :form/r]] [:ref :form/r]
     (let [fs (form-kids-of functions)]
       (if (not (any-body-uses? fs))
         functions
         (let [wanted (wanted-helpers (any-body-uses-bytes? fs))]
           (if (any-clash? fs wanted)
             (throw (ex-info "a program function collides with a native document helper"
                             {:phase :native :problem :helper-collision}))
             (form-form-vec (append-missing fs wanted))))))))
