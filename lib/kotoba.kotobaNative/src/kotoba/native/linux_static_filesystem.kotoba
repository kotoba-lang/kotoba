;; Complete C3 fs/app-data source port. All sixteen forms are retained.
;; Source candidate; policy stays in the sealed owning decision artifacts.
(ns kotoba.native.linux-static-filesystem
  {:kotoba/export [routine]}
  (:require [kotoba.native.linux-static-assembler :as asm]
            [kotoba.native.linux-static-io :as io]
            [kotoba.native.linux-static-fs-protocol :as protocol]
            [kotoba.native.linux-static-paths :as paths]
            [kotoba.native.linux-static-strings :as strings])
  (:schemas
   {:linux.static.fs/fragment
    [:record :linux.static.fs/fragment
     [[:key :keyword] [:code [:list [:ref :linux.static/instruction]]] [:error :keyword]]]
    :linux.static.fs/config
    [:record :linux.static.fs/config
     [[:isa :keyword] [:data :i64] [:buf-a :i64] [:buf-b :i64] [:buf-c :i64]
      [:stat :i64] [:answer :i64] [:tokens :i64] [:probe :i64]
      [:sources [:list [:ref :linux.static.fs/fragment]]]
      [:pair [:list [:ref :linux.static/instruction]]]]]
    :linux.static.fs/result
    [:record :linux.static.fs/result
     [[:code [:list [:ref :linux.static/instruction]]] [:binding :keyword] [:error :keyword]]]}))

(defn- empty-code [] [:list [:ref :linux.static/instruction]]
  (typed-list-new [:list [:ref :linux.static/instruction]]))
(defn- append [out [:list [:ref :linux.static/instruction]] op :keyword aux :keyword
               d :keyword s :keyword b :keyword i :keyword n :i64 target :keyword]
  [:list [:ref :linux.static/instruction]]
  (typed-list-conj [:list [:ref :linux.static/instruction]] out
    (asm/instruction op aux d s b i n target (vector-alloc 0))))
(defn- join [out [:list [:ref :linux.static/instruction]] code [:list [:ref :linux.static/instruction]]]
  [:list [:ref :linux.static/instruction]]
  (loop [index 0 current out]
    (if (>= index (vector-count code)) current
      (recur (+ index 1) (typed-list-conj [:list [:ref :linux.static/instruction]] current
                            (typed-list-nth [:list [:ref :linux.static/instruction]] code index))))))
(defn- tag [prefix :string suffix :string] :keyword
  (keyword-from-string (string-concat (string-concat "ls.fs/" prefix) (string-concat "-" suffix))))
(defn- form-label [form :i64] :keyword (tag "form" (string-from-i64 form)))
(defn- mark [out [:list [:ref :linux.static/instruction]] label :keyword]
  [:list [:ref :linux.static/instruction]] (append out :label :none :none :none :none :none 0 label))
(defn- li [out [:list [:ref :linux.static/instruction]] d :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (append out :li :none d :none :none :none n :none))
(defn- la [out [:list [:ref :linux.static/instruction]] d :keyword label :keyword]
  [:list [:ref :linux.static/instruction]] (append out :la :none d :none :none :none 0 label))
(defn- mov [out [:list [:ref :linux.static/instruction]] d :keyword s :keyword]
  [:list [:ref :linux.static/instruction]] (append out :mov :none d s :none :none 0 :none))
(defn- load [out [:list [:ref :linux.static/instruction]] d :keyword key :keyword]
  [:list [:ref :linux.static/instruction]] (append out :ld :none d :none :s0 :none (io/state-offset key) :none))
(defn- store [out [:list [:ref :linux.static/instruction]] d :keyword key :keyword]
  [:list [:ref :linux.static/instruction]] (append out :st :none d :none :s0 :none (io/state-offset key) :none))
(defn- mem [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword base :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (append out op :none d :none base :none n :none))
(defn- byte-op [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword base :keyword i :keyword]
  [:list [:ref :linux.static/instruction]] (append out op :none d :none base i 0 :none))
(defn- alu [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword s :keyword]
  [:list [:ref :linux.static/instruction]] (append out :alu op d s :none :none 0 :none))
(defn- imm [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (append out :alui op d :none :none :none n :none))
(defn- shift [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (append out op :none d :none :none :none n :none))
(defn- branch [out [:list [:ref :linux.static/instruction]] condition :keyword label :keyword]
  [:list [:ref :linux.static/instruction]]
  (append out (if (= condition :always) :b :bcc) condition :none :none :none :none 0 label))
(defn- hd [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config] op :i64
           a [:ref :linux.static.io/operand] b [:ref :linux.static.io/operand]
           c [:ref :linux.static.io/operand] d [:ref :linux.static.io/operand]]
  [:list [:ref :linux.static/instruction]]
  (io/decision-fragment out (record-get [:ref :linux.static.fs/config] cfg :data)
    :ls.cap/h-decide (io/literal op) a b c d))
(defn- sys [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config] call :keyword
            a [:ref :linux.static.io/operand] b [:ref :linux.static.io/operand]
            c [:ref :linux.static.io/operand] d [:ref :linux.static.io/operand] e [:ref :linux.static.io/operand]]
  [:list [:ref :linux.static/instruction]]
  (io/syscall-fragment out (record-get [:ref :linux.static.fs/config] cfg :isa) call a b c d e))
(defn- close [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config] fd :keyword]
  [:list [:ref :linux.static/instruction]]
  (sys out cfg :close (io/state-field fd) (io/literal 0) (io/literal 0) (io/literal 0) (io/literal 0)))
(defn- outcome [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]
                prefix :string form :i64 stage :i64 retry :keyword negative :keyword named :keyword]
  [:list [:ref :linux.static/instruction]]
  (let [errno (-> out (store :t0 :x6) (li :t1 0) (imm :cmp :t0 0) (branch :ge (tag prefix "errno"))
                  (mov :t1 :t0) (append :neg :none :t1 :none :none :none 0 :none) (mark (tag prefix "errno")))]
    (-> (hd errno cfg 12 (io/literal form) (io/literal stage) (io/register :t1) (io/literal 0))
        (imm :cmp :t0 3) (branch :eq (tag prefix "proceed"))
        (imm :cmp :t0 2) (branch :eq retry) (imm :cmp :t0 0) (branch :eq negative)
        (imm :cmp :t0 4) (branch :eq named) (branch :always :ls/bad)
        (mark (tag prefix "proceed")) (load :t0 :x6))))
(defn- copy [out [:list [:ref :linux.static/instruction]] prefix :string dst :keyword src :keyword n :keyword]
  [:list [:ref :linux.static/instruction]]
  (-> out (li :t0 0) (mark (tag prefix "copy")) (alu :cmp :t0 n) (branch :hs (tag prefix "copied"))
      (byte-op :ldb :t1 src :t0) (byte-op :stb :t1 dst :t0)
      (imm :add :t0 1) (branch :always (tag prefix "copy")) (mark (tag prefix "copied"))))
(defn- fragment [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config] key :keyword]
  [:list [:ref :linux.static/instruction]]
  (let [sources (record-get [:ref :linux.static.fs/config] cfg :sources)]
    (loop [index 0]
      (if (>= index (vector-count sources)) (append out :unknown-fs-fragment :none :none :none :none :none 0 :none)
        (let [source (typed-list-nth [:list [:ref :linux.static.fs/fragment]] sources index)]
          (if (= key (record-get [:ref :linux.static.fs/fragment] source :key))
            (join out (record-get [:ref :linux.static.fs/fragment] source :code)) (recur (+ index 1))))))))
(defn- intern [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  (-> (hd out cfg 6 (io/state-field :pool-used) (io/register :s2) (io/state-field :bytes) (io/literal 0))
      (imm :cmp :t0 1) (branch :ne :ls/trap-bytes)
      (append :call :none :none :none :none :none 0 :ls.io/intern) (mov :t0 :ret)))
(defn- finish [out [:list [:ref :linux.static/instruction]]]
  [:list [:ref :linux.static/instruction]] (branch (store out :t0 :res) :always :ls.fs-protocol/finish))
(defn- answer [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config] label :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (finish (intern (-> out (la :s1 label) (li :s2 n)) cfg)))
(defn- utoa [out [:list [:ref :linux.static/instruction]]]
  [:list [:ref :linux.static/instruction]] (append out :call :none :none :none :none :none 0 :ls.fs/utoa))

(defn- token-name [id :i64] :string
  (case id 0 "WRITE_SEP" 1 "APPEND_SEP" 2 "EXISTS_SEP" 3 "RANGE_SEP" 4 "STAT_SEP" 5 "MTIME_SEP"
    6 "CHMOD_SEP" 7 "MKDIR_SEP" 8 "UNLINK_SEP" 9 "RMDIR_SEP" 10 "RENAME_SEP"
    11 "FSYNC_SEP" 12 "MKTEMP_SEP" 13 "NOFOLLOW_SEP" 14 "OWNER_SEP" ""))
(defn- token-label [id :i64] :keyword (tag "token" (string-from-i64 id)))
(defn- token-select [out [:list [:ref :linux.static/instruction]]] [:list [:ref :linux.static/instruction]]
  (loop [id 0 code out]
    (if (= id 15) code
      (recur (+ id 1) (-> code (imm :cmp :s4 id) (branch :ne (tag "select" (string-from-i64 id)))
                            (la :a1 (token-label id)) (li :a2 (bytes-count (string-to-utf8 (token-name id))))
                            (mark (tag "select" (string-from-i64 id))))))))
(defn- tokens [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  (let [start (-> out (load :s2 :rp) (load :s3 :rl) (li :s4 0) (mark :ls.fs/token-loop)
                  (imm :cmp :s4 15) (branch :hs :ls.fs/scan-done)
                  (mov :t0 :s4) (shift :shli :t0 4) (li :t1 (record-get [:ref :linux.static.fs/config] cfg :tokens))
                  (alu :add :t1 :t0) (li :t0 0) (mem :st :t0 :t1 0) (li :t0 -1) (mem :st :t0 :t1 8) (li :s1 0))
        scanned (-> (token-select start) (mark :ls.fs/scan) (alu :cmp :s1 :s3) (branch :hi :ls/bad)
                    (mov :t0 :s3) (alu :sub :t0 :s1) (alu :cmp :t0 :a2) (branch :lo :ls.fs/token-next)
                    (li :t0 0) (mark :ls.fs/token-compare) (alu :cmp :t0 :a2) (branch :hs :ls.fs/token-match)
                    (mov :t2 :s1) (alu :add :t2 :t0) (byte-op :ldb :t2 :s2 :t2) (byte-op :ldb :t3 :a1 :t0)
                    (alu :cmp :t2 :t3) (branch :ne :ls.fs/scan-no) (imm :add :t0 1) (branch :always :ls.fs/token-compare)
                    (mark :ls.fs/token-match) (mov :t0 :s4) (shift :shli :t0 4)
                    (li :t1 (record-get [:ref :linux.static.fs/config] cfg :tokens)) (alu :add :t1 :t0)
                    (mem :ld :t0 :t1 0) (imm :cmp :t0 0) (branch :ne :ls.fs/token-duplicate) (mem :st :s1 :t1 8)
                    (mark :ls.fs/token-duplicate) (imm :add :t0 1) (mem :st :t0 :t1 0)
                    (alu :add :s1 :a2) (branch :always :ls.fs/scan)
                    (mark :ls.fs/scan-no) (imm :add :s1 1) (branch :always :ls.fs/scan)
                    (mark :ls.fs/token-next) (imm :add :s4 1) (branch :always :ls.fs/token-loop)
                    (mark :ls.fs/scan-done) (li :s1 0) (li :s4 0) (mark :ls.fs/present)
                    (imm :cmp :s4 15) (branch :hs :ls.fs/write-first)
                    (mov :t0 :s4) (shift :shli :t0 4) (li :t1 (record-get [:ref :linux.static.fs/config] cfg :tokens))
                    (alu :add :t1 :t0) (mem :ld :t0 :t1 0) (imm :cmp :t0 0) (branch :eq :ls.fs/present-next)
                    (li :t2 1) (li :t3 0) (mark :ls.fs/mask-shift) (alu :cmp :t3 :s4) (branch :hs :ls.fs/mask-shifted)
                    (shift :shli :t2 1) (imm :add :t3 1) (branch :always :ls.fs/mask-shift)
                    (mark :ls.fs/mask-shifted) (alu :or :s1 :t2) (mark :ls.fs/present-next)
                    (imm :add :s4 1) (branch :always :ls.fs/present)
                    (mark :ls.fs/write-first) (li :s2 0) (li :t1 (record-get [:ref :linux.static.fs/config] cfg :tokens))
                    (mem :ld :t0 :t1 8) (mem :ld :t2 :t1 24) (alu :cmp :t0 :t2) (branch :ge :ls.fs/write-first-done)
                    (li :s2 1) (mark :ls.fs/write-first-done))
        chosen (-> (hd scanned cfg 1 (io/register :s1) (io/register :s2) (io/literal 0) (io/literal 0))
                   (imm :cmp :t0 0) (branch :lt :ls/bad) (imm :cmp :t0 15) (branch :hi :ls/bad) (store :t0 :form))
        implemented (-> (hd chosen cfg 2 (io/register :t0) (io/literal 0) (io/literal 0) (io/literal 0))
                        (imm :cmp :t0 1) (branch :ne :ls/bad) (load :s2 :rl) (li :t2 0)
                        (load :t0 :form) (imm :cmp :t0 0) (branch :eq :ls.fs/path-token)
                        (imm :sub :t0 1) (shift :shli :t0 4)
                        (li :t1 (record-get [:ref :linux.static.fs/config] cfg :tokens)) (alu :add :t1 :t0)
                        (mem :ld :t2 :t1 0) (mem :ld :s2 :t1 8) (mark :ls.fs/path-token))]
    (-> (hd implemented cfg 17 (io/state-field :form) (io/register :t2) (io/literal 0) (io/literal 0))
        (imm :cmp :t0 1) (branch :ne :ls/bad) (load :s1 :rp))))
(defn- after-token [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config] token :i64]
  [:list [:ref :linux.static/instruction]]
  (-> out (load :t0 :fs-frame) (imm :cmp :t0 0) (branch :eq (tag "tail-legacy" (string-from-i64 token)))
      (load :s1 :fs-tail) (load :s2 :fs-tail-len) (branch :always (tag "tail-done" (string-from-i64 token)))
      (mark (tag "tail-legacy" (string-from-i64 token)))
      (li :t1 (record-get [:ref :linux.static.fs/config] cfg :tokens))
      (mem :ld :t0 :t1 (+ 8 (* 16 token))) (imm :cmp :t0 0) (branch :lt :ls/bad)
      (load :t1 :rl) (alu :cmp :t0 :t1) (branch :hi :ls/bad) (alu :sub :t1 :t0)
      (li :t2 (bytes-count (string-to-utf8 (token-name token)))) (alu :cmp :t2 :t1) (branch :hi :ls/bad)
      (alu :add :t0 :t2) (load :s1 :rp) (alu :add :s1 :t0) (load :s2 :rl) (alu :sub :s2 :t0)
      (mark (tag "tail-done" (string-from-i64 token)))))

(defn- write-all [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config] prefix :string form :i64]
  [:list [:ref :linux.static/instruction]]
  (let [loop (-> out (li :s3 0) (mark (tag prefix "write")) (alu :cmp :s3 :s2) (branch :hs (tag prefix "written"))
                 (mov :s4 :s1) (alu :add :s4 :s3) (mov :t2 :s2) (alu :sub :t2 :s3))
        sent (sys loop cfg :write (io/state-field :fd) (io/register :s4) (io/register :t2) (io/literal 0) (io/literal 0))
        checked (outcome sent cfg prefix form 3 (tag prefix "write") :ls/bad :ls/bad)]
    (-> checked (imm :cmp :t0 0) (branch :le :ls/bad) (mov :t1 :s2) (alu :sub :t1 :s3)
        (alu :cmp :t0 :t1) (branch :hi :ls/bad) (alu :add :s3 :t0) (branch :always (tag prefix "write"))
        (mark (tag prefix "written")))))
(defn- read-file [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  (let [first (-> out (load :s1 :pool-used) (load :t0 :bytes) (alu :cmp :s1 :t0) (branch :hi :ls/trap-bytes)
                  (alu :sub :t0 :s1) (store :t0 :room) (li :s2 0) (mark :ls.fs/read-loop)
                  (load :t0 :room) (alu :cmp :s2 :t0) (branch :hs :ls.fs/read-full)
                  (load :s3 :pool-base) (alu :add :s3 :s1) (alu :add :s3 :s2) (mov :s4 :t0) (alu :sub :s4 :s2))
        got (outcome (sys first cfg :read (io/state-field :fd) (io/register :s3) (io/register :s4) (io/literal 0) (io/literal 0))
              cfg "read-data" 0 3 :ls.fs/read-loop :ls/bad :ls/bad)
        more (-> got (imm :cmp :t0 0) (branch :eq :ls.fs/read-done) (alu :cmp :t0 :s4) (branch :hi :ls/bad)
                 (alu :add :s2 :t0) (branch :always :ls.fs/read-loop) (mark :ls.fs/read-full) (mark :ls.fs/read-probe))
        probe (outcome (sys more cfg :read (io/state-field :fd)
                        (io/literal (record-get [:ref :linux.static.fs/config] cfg :probe)) (io/literal 1) (io/literal 0) (io/literal 0))
                cfg "read-probe" 0 3 :ls.fs/read-probe :ls/bad :ls/bad)
        done (-> (close (-> probe (imm :cmp :t0 0) (branch :ne :ls/trap-bytes) (mark :ls.fs/read-done)) cfg :fd)
                 (mov :t0 :s1) (alu :add :t0 :s2) (store :t0 :pool-used)
                 (mov :s4 :s1) (append :not :none :s4 :none :none :none 0 :none))]
    (finish (join done (record-get [:ref :linux.static.fs/config] cfg :pair)))))

(defn- parse-span [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]
                   prefix :string start :keyword length :keyword fail :keyword]
  [:list [:ref :linux.static/instruction]]
  (let [first (-> (hd out cfg 20 (io/state-field length) (io/literal 0) (io/literal 0) (io/literal 0))
                  (imm :cmp :t0 1) (branch :ne fail) (li :s1 0) (li :s4 0)
                  (load :s2 start) (load :s3 length) (mark (tag prefix "digits"))
                  (alu :cmp :s4 :s3) (branch :hs (tag prefix "parsed")) (byte-op :ldb :t1 :s2 :s4))]
    (-> (hd first cfg 3 (io/register :s1) (io/register :t1) (io/literal 0) (io/literal 0))
        (imm :cmp :t0 -2) (branch :eq fail) (mov :s1 :t0) (imm :add :s4 1)
        (branch :always (tag prefix "digits")) (mark (tag prefix "parsed")))))

(defn- formatter [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  (let [end (+ (record-get [:ref :linux.static.fs/config] cfg :data) 688)]
    (-> out (mark :ls.fs/utoa) (li :s2 end) (li :t0 0) (mark :ls.fs/utoa-digit)
        (append :udiv10 :none :t1 :t1 :t3 :none 0 :none) (imm :add :t3 48) (imm :sub :s2 1) (li :t0 0)
        (byte-op :stb :t3 :s2 :t0) (imm :cmp :t1 0) (branch :ne :ls.fs/utoa-digit)
        (mov :s1 :s2) (li :s2 end) (alu :sub :s2 :s1)
        (append :ret :none :none :none :none :none 0 :none))))

(defn- append-field [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]
                     prefix :string space? :bool]
  [:list [:ref :linux.static/instruction]]
  (let [start (-> (utoa out) (load :t2 :x2) (imm :cmp :t2 256) (branch :hi :ls/bad)
                  (li :t3 256) (alu :sub :t3 :t2) (imm :sub :t3 (if space? 1 0))
                  (imm :cmp :t3 0) (branch :lt :ls/bad) (alu :cmp :s2 :t3) (branch :hi :ls/bad)
                  (li :t3 (record-get [:ref :linux.static.fs/config] cfg :answer)) (alu :add :t3 :t2))
        copied (-> (copy start prefix :t3 :s1 :s2) (load :t2 :x2) (alu :add :t2 :s2))
        spaced (if space?
                 (-> copied (li :t0 32) (li :t1 (record-get [:ref :linux.static.fs/config] cfg :answer))
                     (byte-op :stb :t0 :t1 :t2) (imm :add :t2 1)) copied)]
    (store spaced :t2 :x2)))

(defn- stat-answer [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]
                    prefix :string form :i64 opened :keyword negative :keyword]
  [:list [:ref :linux.static/instruction]]
  (let [start (fragment (mark out (tag prefix "open")) cfg opened)
        fd (-> (outcome start cfg (string-concat prefix "-open") form 0 (tag prefix "open") negative :ls/bad)
               (store :t0 :fd))
        got (sys fd cfg :fstat (io/state-field :fd) (io/literal (record-get [:ref :linux.static.fs/config] cfg :stat))
                   (io/literal 0) (io/literal 0) (io/literal 0))]
    (outcome (-> (close (store got :t0 :x0) cfg :fd) (load :t0 :x0))
      cfg (string-concat prefix "-stat") form 4 :ls/bad negative :ls/bad)))

(defn- stat-mode [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  (-> out (li :t1 (record-get [:ref :linux.static.fs/config] cfg :stat))
      (mem :ld :t0 :t1 (if (= (record-get [:ref :linux.static.fs/config] cfg :isa) :x86_64) 24 16))
      (shift :shli :t0 32) (shift :shri :t0 32) (store :t0 :x3)))

(defn- metadata-form [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]
                      form :i64]
  [:list [:ref :linux.static/instruction]]
  (let [prefix (string-concat "metadata-" (string-from-i64 form)) negative (tag prefix "absent")
        got (stat-answer (mark out (form-label form)) cfg prefix form
              (if (or (= form 14) (= form 15)) :open-nofollow :open-read) negative)
        ready (-> got (li :t0 0) (store :t0 :x2))
        text
        (cond
          (= form 6)
          (-> ready (li :t1 (record-get [:ref :linux.static.fs/config] cfg :stat)) (mem :ld :t1 :t1 88) (utoa))
          (= form 15)
          (let [uid (-> ready (li :t1 (record-get [:ref :linux.static.fs/config] cfg :stat))
                         (mem :ld :t1 :t1 (if (= (record-get [:ref :linux.static.fs/config] cfg :isa) :x86_64) 28 24))
                         (shift :shli :t1 32) (shift :shri :t1 32))
                field (append-field uid cfg (string-concat prefix "-uid") true)
                euid (sys field cfg :geteuid (io/literal 0) (io/literal 0) (io/literal 0) (io/literal 0) (io/literal 0))]
            (-> (append-field (mov euid :t1 :t0) cfg (string-concat prefix "-euid") false)
                (li :s1 (record-get [:ref :linux.static.fs/config] cfg :answer)) (load :s2 :x2)))
          :else
          (let [mode (hd (stat-mode ready cfg) cfg 16 (io/literal 0) (io/state-field :x3) (io/literal 0) (io/literal 0))
                f0 (append-field (mov mode :t1 :t0) cfg (string-concat prefix "-mode") true)
                f1 (append-field (-> f0 (li :t1 (record-get [:ref :linux.static.fs/config] cfg :stat)) (mem :ld :t1 :t1 48))
                     cfg (string-concat prefix "-size") true)
                f2 (append-field (-> f1 (li :t1 (record-get [:ref :linux.static.fs/config] cfg :stat)) (mem :ld :t1 :t1 64))
                     cfg (string-concat prefix "-blocks") true)
                kind (hd f2 cfg 16 (io/literal (if (= form 5) 1 2)) (io/state-field :x3) (io/literal 0) (io/literal 0))]
            (-> (append-field (mov kind :t1 :t0) cfg (string-concat prefix "-kind") false)
                (li :s1 (record-get [:ref :linux.static.fs/config] cfg :answer)) (load :s2 :x2))))]
    (answer (mark (finish (intern text cfg)) negative) cfg :ls.fs/zero 0)))

(defn- read-form [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  (let [opened (fragment (-> out (mark (form-label 0)) (mark :ls.fs/read-open)) cfg :open-read)]
    (read-file (-> (outcome opened cfg "read-open" 0 0 :ls.fs/read-open :ls/bad :ls/bad) (store :t0 :fd)) cfg)))

(defn- write-form [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config] form :i64]
  [:list [:ref :linux.static/instruction]]
  (let [prefix (if (= form 1) "write" "append")
        opened (fragment (-> out (mark (form-label form)) (mark (tag prefix "open"))) cfg
                 (if (= form 1) :open-write :open-append))
        content (-> (outcome opened cfg (string-concat prefix "-open") form 0 (tag prefix "open") :ls/bad :ls/bad)
                    (store :t0 :fd) (after-token cfg (- form 1)) (store :s1 :x0) (store :s2 :x1))
        written (write-all content cfg prefix form)]
    (finish (intern (-> (close written cfg :fd) (load :s1 :x0) (load :s2 :x1)) cfg))))

(defn- stage-member-form [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  ;; Q path NUL octal-mode NUL bytes. All mode parsing precedes creation.
  ;; One exclusive FD remains usable even when fchmod sets mode 0000/0400.
  (let [scan (-> out (mark (form-label 16)) (load :s2 :fs-tail) (load :s3 :fs-tail-len)
                 (li :s4 0) (mark :ls.fs/stage-mode-end) (alu :cmp :s4 :s3) (branch :hs :ls/bad)
                 (byte-op :ldb :t0 :s2 :s4) (imm :cmp :t0 0) (branch :eq :ls.fs/stage-mode-size)
                 (imm :add :s4 1) (imm :cmp :s4 6) (branch :hi :ls/bad)
                 (branch :always :ls.fs/stage-mode-end) (mark :ls.fs/stage-mode-size))
        sized (-> (hd scan cfg 24 (io/register :s4) (io/literal 0) (io/literal 0) (io/literal 0))
                  (imm :cmp :t0 1) (branch :ne :ls/bad) (store :s4 :x3)
                  (mov :t0 :s2) (alu :add :t0 :s4) (imm :add :t0 1) (store :t0 :x0)
                  (mov :t0 :s3) (alu :sub :t0 :s4) (imm :sub :t0 1) (store :t0 :x1)
                  (li :s1 0) (li :s4 0) (mark :ls.fs/stage-mode-digit)
                  (load :t0 :x3) (alu :cmp :s4 :t0) (branch :hs :ls.fs/stage-mode-parsed)
                  (byte-op :ldb :t1 :s2 :s4))
        parsed (-> (hd sized cfg 23 (io/register :s1) (io/register :t1) (io/literal 0) (io/literal 0))
                   (imm :cmp :t0 -2) (branch :eq :ls/bad) (mov :s1 :t0) (imm :add :s4 1)
                   (branch :always :ls.fs/stage-mode-digit) (mark :ls.fs/stage-mode-parsed))
        mode (-> (hd parsed cfg 25 (io/register :s1) (io/literal 0) (io/literal 0) (io/literal 0))
                 (store :t0 :x2) (mark :ls.fs/stage-open))
        owner (-> mode (li :t0 0) (store :t0 :out-managed-member) (load :t0 :out-active)
                  (imm :cmp :t0 0) (branch :eq :ls.fs/stage-unmanaged)
                  (li :t0 1) (store :t0 :out-managed-member)
                  (append :call :none :none :none :none :none 0 :ls.output/member-open) (mov :t0 :ret)
                  (branch :always :ls.fs/stage-opened) (mark :ls.fs/stage-unmanaged))
        raw-open (-> (fragment owner cfg :open-stage) (mark :ls.fs/stage-opened))
        opened (-> (outcome raw-open cfg "stage-open" 16 0 :ls.fs/stage-open :ls/bad :ls/bad)
                   (store :t0 :fd) (mark :ls.fs/stage-mode-apply))
        changed (sys opened cfg :fchmod (io/state-field :fd) (io/state-field :x2) (io/literal 0) (io/literal 0) (io/literal 0))
        ready (-> (outcome changed cfg "stage-mode" 16 3 :ls.fs/stage-mode-apply :ls/bad :ls/bad)
                  (load :s1 :x0) (load :s2 :x1))
        written (-> (write-all ready cfg "stage" 16) (mark :ls.fs/stage-flush))
        flushed (sys written cfg :fsync (io/state-field :fd) (io/literal 0) (io/literal 0) (io/literal 0) (io/literal 0))
        done (outcome flushed cfg "stage-flush" 16 3 :ls.fs/stage-flush :ls/bad :ls/bad)
        closing (-> done (load :t0 :out-managed-member) (imm :cmp :t0 0) (branch :eq :ls.fs/stage-closing)
                    ;; Linux consumes the FD even on close error. Retire its
                    ;; cleanup alias before the syscall or any fatal conversion.
                    (li :t0 -1) (store :t0 :out-file) (mark :ls.fs/stage-closing))
        closed (-> (close closing cfg :fd) (imm :cmp :t0 0) (branch :ne :ls/bad))]
    (answer closed cfg :ls.fs/one 1)))

(defn- discard-output-form [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  (let [matched (-> out (mark (form-label 18))
                    (append :call :none :none :none :none :none 0 :ls.output/same-path)
                    (mov :t0 :ret) (imm :cmp :t0 1) (branch :ne :ls/bad))
        cleaned (-> matched (append :call :none :none :none :none :none 0 :ls.output/cleanup)
                    (mov :t0 :ret) (imm :cmp :t0 1) (branch :ne :ls.fs/discard-output-failed))]
    (-> (answer cleaned cfg :ls.fs/one 1) (mark :ls.fs/discard-output-failed) (answer cfg :ls.fs/zero 1))))

(defn- exists-form [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  (let [opened (fragment (-> out (mark (form-label 3)) (mark :ls.fs/exists-open)) cfg :open-read)
        fd (-> (outcome opened cfg "exists-open" 3 0 :ls.fs/exists-open :ls.fs/exists-absent :ls/bad) (store :t0 :fd))]
    (-> (answer (close fd cfg :fd) cfg :ls.fs/one 1) (mark :ls.fs/exists-absent) (answer cfg :ls.fs/zero 1))))

(defn- range-form [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  (let [split (-> (after-token (mark out (form-label 4)) cfg 3) (li :t0 0) (store :t0 :r-ok)
                  (mark :ls.fs/range-colon) (alu :cmp :t0 :s2) (branch :hs :ls.fs/range-spec)
                  (byte-op :ldb :t1 :s1 :t0) (imm :cmp :t1 58) (branch :eq :ls.fs/range-found)
                  (imm :add :t0 1) (branch :always :ls.fs/range-colon) (mark :ls.fs/range-found)
                  (store :s1 :x0) (store :t0 :x1) (mov :t1 :s1) (alu :add :t1 :t0) (imm :add :t1 1) (store :t1 :x2)
                  (mov :t1 :s2) (alu :sub :t1 :t0) (imm :sub :t1 1) (store :t1 :x3))
        offset (store (parse-span split cfg "range-offset" :x0 :x1 :ls.fs/range-spec) :s1 :r-off)
        length (-> (parse-span offset cfg "range-length" :x2 :x3 :ls.fs/range-spec)
                   (store :s1 :r-len) (li :t0 1) (store :t0 :r-ok) (mark :ls.fs/range-spec))
        spec (-> (hd length cfg 21 (io/state-field :r-ok) (io/state-field :r-len) (io/state-field :bytes) (io/literal 0))
                 (imm :cmp :t0 0) (branch :eq :ls/trap-bytes) (mark :ls.fs/range-open))
        fd (-> (outcome (fragment spec cfg :open-read) cfg "range-open" 4 0 :ls.fs/range-open :ls/bad :ls/bad)
               (store :t0 :fd))
        stated (-> (sys fd cfg :fstat (io/state-field :fd) (io/literal (record-get [:ref :linux.static.fs/config] cfg :stat))
                     (io/literal 0) (io/literal 0) (io/literal 0))
                   (imm :cmp :t0 0) (branch :ne :ls/bad) (stat-mode cfg))
        kind (-> (hd stated cfg 16 (io/literal 2) (io/state-field :x3) (io/literal 0) (io/literal 0))
                 (li :t1 0) (imm :cmp :t0 0) (branch :ne :ls.fs/range-not-regular) (li :t1 1)
                 (mark :ls.fs/range-not-regular) (store :t1 :x4)
                 (li :t1 (record-get [:ref :linux.static.fs/config] cfg :stat)) (mem :ld :t1 :t1 48) (store :t1 :x5))
        window (-> (hd kind cfg 22 (io/state-field :r-off) (io/state-field :r-len) (io/state-field :x5) (io/state-field :x4))
                   (imm :cmp :t0 1) (branch :ne :ls/bad))
        charged (-> (hd window cfg 6 (io/state-field :pool-used) (io/state-field :r-len) (io/state-field :bytes) (io/literal 0))
                    (imm :cmp :t0 1) (branch :ne :ls/trap-bytes)
                    (load :t0 :pool-used) (load :t1 :bytes) (alu :cmp :t0 :t1) (branch :hi :ls/trap-bytes)
                    (alu :sub :t1 :t0) (load :t0 :r-len) (alu :cmp :t0 :t1) (branch :hi :ls/trap-bytes)
                    (li :s2 0) (mark :ls.fs/range-read) (load :t0 :r-len) (alu :cmp :s2 :t0) (branch :hs :ls.fs/range-done)
                    (load :s3 :pool-base) (load :t1 :pool-used) (alu :add :s3 :t1) (alu :add :s3 :s2)
                    (mov :s4 :t0) (alu :sub :s4 :s2) (load :s1 :r-off) (alu :add :s1 :s2))
        got (outcome (sys charged cfg :pread64 (io/state-field :fd) (io/register :s3) (io/register :s4)
                       (io/register :s1) (io/literal 0)) cfg "range-data" 4 3 :ls.fs/range-read :ls/bad :ls/bad)
        done (-> (close (-> got (imm :cmp :t0 0) (branch :le :ls/bad) (alu :cmp :t0 :s4) (branch :hi :ls/bad)
                            (alu :add :s2 :t0) (branch :always :ls.fs/range-read) (mark :ls.fs/range-done)) cfg :fd)
                 (load :s3 :pool-used) (load :s2 :r-len) (mov :t0 :s3) (alu :add :t0 :s2) (store :t0 :pool-used)
                 (mov :s4 :s3) (append :not :none :s4 :none :none :none 0 :none))]
    (finish (join done (record-get [:ref :linux.static.fs/config] cfg :pair)))))

(defn- chmod-form [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  (let [digits (-> (after-token (mark out (form-label 7)) cfg 6) (mov :s3 :s2) (mov :s2 :s1))
        first (-> (hd digits cfg 24 (io/register :s3) (io/literal 0) (io/literal 0) (io/literal 0))
                  (imm :cmp :t0 1) (branch :ne :ls/bad) (li :s1 0) (li :s4 0) (mark :ls.fs/chmod-digit)
                  (alu :cmp :s4 :s3) (branch :hs :ls.fs/chmod-parsed) (byte-op :ldb :t1 :s2 :s4))
        parsed (-> (hd first cfg 23 (io/register :s1) (io/register :t1) (io/literal 0) (io/literal 0))
                   (imm :cmp :t0 -2) (branch :eq :ls/bad) (mov :s1 :t0) (imm :add :s4 1)
                   (branch :always :ls.fs/chmod-digit) (mark :ls.fs/chmod-parsed))
        mode (-> (hd parsed cfg 25 (io/register :s1) (io/literal 0) (io/literal 0) (io/literal 0))
                 (store :t0 :x2) (mark :ls.fs/chmod-open))
        fd (-> (outcome (fragment mode cfg :open-read) cfg "chmod-open" 7 0 :ls.fs/chmod-open :ls.fs/chmod-no :ls/bad)
               (store :t0 :fd))
        changed (sys fd cfg :fchmod (io/state-field :fd) (io/state-field :x2) (io/literal 0) (io/literal 0) (io/literal 0))
        checked (outcome (-> (close (store changed :t0 :x1) cfg :fd) (load :t0 :x1))
                  cfg "chmod-result" 7 2 :ls/bad :ls.fs/chmod-no :ls/bad)]
    (-> (answer checked cfg :ls.fs/one 1) (mark :ls.fs/chmod-no) (answer cfg :ls.fs/zero 1))))

(defn- mutation-form [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config] form :i64]
  [:list [:ref :linux.static/instruction]]
  (let [prefix (string-concat "mutate-" (string-from-i64 form))
        ;; Keep the parent live through the owning retry decision.
        parent (fragment (mark out (form-label form)) cfg
                 (case form 8 :parent-mkdir 9 :parent-unlink :parent-rmdir))
        done (sys (mark parent (tag prefix "retry")) cfg (if (= form 8) :mkdirat :unlinkat)
               (io/state-field :pfd) (io/state-field :x0) (io/literal (case form 8 511 10 512 0))
               (io/literal 0) (io/literal 0))
        admitted (outcome done cfg prefix form 2 (tag prefix "retry") (tag prefix "negative") :ls/bad)
        success (answer (close admitted cfg :pfd) cfg :ls.fs/one 1)
        negative (close (mark success (tag prefix "negative")) cfg :pfd)]
    (answer (mark negative (tag prefix "no-parent")) cfg :ls.fs/zero 1)))

(defn- rename-form [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  (let [second (fragment (after-token (mark out (form-label 11)) cfg 10) cfg :resolve-c)
        first-parent (fragment second cfg :parent-rename-a)
        second-parent (fragment (-> first-parent (load :t0 :x0) (store :t0 :n1)) cfg :parent-rename-c)
        renamed (sys (mark second-parent :ls.fs/rename-retry) cfg :renameat2
                  (io/state-field :pfd) (io/state-field :n1) (io/state-field :fd) (io/state-field :x0) (io/literal 0))
        decided (outcome renamed cfg "rename-result" 11 2 :ls.fs/rename-retry :ls.fs/rename-negative :ls/bad)
        good (answer (close (close decided cfg :fd) cfg :pfd) cfg :ls.fs/one 1)
        bad (close (mark good :ls.fs/rename-negative) cfg :fd)
        second-failed (close (mark bad :ls.fs/rename-no-second) cfg :pfd)]
    (answer (mark second-failed :ls.fs/rename-no-parent) cfg :ls.fs/zero 1)))

(defn- fsync-form [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  (let [opened (fragment (-> out (mark (form-label 12)) (mark :ls.fs/fsync-open)) cfg :open-read)
        fd (-> (outcome opened cfg "fsync-open" 12 0 :ls.fs/fsync-open :ls.fs/fsync-no :ls/bad)
               (store :t0 :fd) (mark :ls.fs/fsync-retry))
        flushed (sys fd cfg :fsync (io/state-field :fd) (io/literal 0) (io/literal 0) (io/literal 0) (io/literal 0))
        done (outcome flushed cfg "fsync-result" 12 3 :ls.fs/fsync-retry :ls.fs/fsync-close-no :ls/bad)
        success (answer (close done cfg :fd) cfg :ls.fs/one 1)
        failure (close (mark success :ls.fs/fsync-close-no) cfg :fd)]
    (answer (mark failure :ls.fs/fsync-no) cfg :ls.fs/zero 1)))

(defn- temp-answer [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  (let [directory (-> out (li :s3 (record-get [:ref :linux.static.fs/config] cfg :buf-a))
                      (li :s1 (record-get [:ref :linux.static.fs/config] cfg :buf-b)) (load :s2 :len-a))
        slash (-> (copy directory "temp-directory" :s3 :s1 :s2)
                  (imm :cmp :s2 1) (branch :eq :ls.fs/temp-no-slash)
                  (li :t0 47) (byte-op :stb :t0 :s3 :s2) (imm :add :s2 1) (mark :ls.fs/temp-no-slash)
                  (mov :t2 :s3) (alu :add :t2 :s2) (li :t3 (record-get [:ref :linux.static.fs/config] cfg :buf-c)) (load :a1 :x1))]
    (finish (intern (-> (copy slash "temp-name" :t2 :t3 :a1) (alu :add :s2 :a1)
                        (li :s1 (record-get [:ref :linux.static.fs/config] cfg :buf-a))) cfg))))

(defn- clear-temp-owner [out [:list [:ref :linux.static/instruction]] prefix :string]
  [:list [:ref :linux.static/instruction]]
  (-> out (load :t0 :out-create) (imm :cmp :t0 0) (branch :eq (tag prefix "owner-cleared"))
      (li :t0 0) (store :t0 :out-active) (li :t0 -1) (store :t0 :out-parent)
      (mark (tag prefix "owner-cleared"))))

(defn- temp-form [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  (let [managed (-> out (mark (form-label 17)) (load :t0 :out-active)
                    (imm :cmp :t0 0) (branch :ne :ls/bad) (li :t0 1) (store :t0 :out-create)
                    (la :s1 :ls.fs/output-prefix) (li :s2 15) (branch :always :ls.fs/temp-selected)
                    (mark (form-label 13)) (li :t0 0) (store :t0 :out-create))
        prefix (-> (after-token managed cfg 12) (mark :ls.fs/temp-selected) (store :s1 :m-pre) (store :s2 :m-plen)
                   (li :t2 0) (li :t0 0) (mark :ls.fs/temp-prefix)
                   (alu :cmp :t0 :s2) (branch :hs :ls.fs/temp-prefix-done) (byte-op :ldb :t1 :s1 :t0)
                   (imm :cmp :t1 47) (branch :eq :ls.fs/temp-prefix-invalid)
                   (imm :cmp :t1 0) (branch :eq :ls.fs/temp-prefix-invalid)
                   (imm :add :t0 1) (branch :always :ls.fs/temp-prefix)
                   (mark :ls.fs/temp-prefix-invalid) (li :t2 1) (mark :ls.fs/temp-prefix-done))
        admitted (-> (hd prefix cfg 26 (io/state-field :m-plen) (io/register :t2) (io/literal 0) (io/literal 0))
                     (imm :cmp :t0 1) (branch :ne :ls/bad) (load :t0 :m-plen) (imm :cmp :t0 4000) (branch :hi :ls/bad)
                     (mark :ls.fs/temp-open))
        opened (outcome (fragment admitted cfg :open-temp-root) cfg "temp-open" 13 1 :ls.fs/temp-open :ls.fs/temp-empty :ls/bad)
        fd (-> opened (store :t0 :m-dfd) (li :t0 0) (store :t0 :m-k)
               (load :s1 :m-pre) (load :s2 :m-plen) (li :s3 (record-get [:ref :linux.static.fs/config] cfg :buf-c)))
        attempt (-> (hd (mark (copy fd "temp-prefix" :s3 :s1 :s2) :ls.fs/temp-try) cfg 28
                      (io/state-field :m-k) (io/literal 0) (io/literal 0) (io/literal 0))
                    (imm :cmp :t0 1) (branch :ne :ls.fs/temp-exhausted)
                    (load :t0 :m-k) (imm :add :t0 1) (store :t0 :m-k))
        suffix (-> (hd attempt cfg 29 (io/literal 0) (io/literal 0) (io/literal 0) (io/literal 0))
                   (imm :cmp :t0 1) (branch :lt :ls/bad) (imm :cmp :t0 16) (branch :hi :ls/bad)
                   (store :t0 :m-n) (mark :ls.fs/temp-random))
        random (outcome (sys suffix cfg :getrandom (io/literal (record-get [:ref :linux.static.fs/config] cfg :probe))
                          (io/state-field :m-n) (io/literal 0) (io/literal 0) (io/literal 0))
                 cfg "temp-random" 40 3 :ls.fs/temp-random :ls/bad :ls.fs/temp-no-entropy)
        first (-> random (load :t1 :m-n) (alu :cmp :t0 :t1) (branch :ne :ls/bad) (li :s4 0)
                  (mark :ls.fs/temp-suffix) (load :t0 :m-n) (alu :cmp :s4 :t0) (branch :hs :ls.fs/temp-suffixed)
                  (li :t1 (record-get [:ref :linux.static.fs/config] cfg :probe)) (byte-op :ldb :t2 :t1 :s4))
        mapped (-> (hd first cfg 27 (io/register :t2) (io/literal 0) (io/literal 0) (io/literal 0))
                   (li :t1 (record-get [:ref :linux.static.fs/config] cfg :buf-c)) (load :t2 :m-plen)
                   (alu :add :t1 :t2) (byte-op :stb :t0 :t1 :s4) (imm :add :s4 1) (branch :always :ls.fs/temp-suffix)
                   (mark :ls.fs/temp-suffixed) (li :t1 (record-get [:ref :linux.static.fs/config] cfg :buf-c))
                   (load :t2 :m-plen) (alu :add :t2 :s4) (li :t0 0) (byte-op :stb :t0 :t1 :t2) (store :t2 :x1)
                   ;; Bound the eventual path before mkdirat can create anything.
                   (load :t0 :len-a) (imm :cmp :t0 1) (branch :eq :ls.fs/temp-output-length)
                   (imm :add :t0 1) (mark :ls.fs/temp-output-length)
                   (imm :cmp :t0 4096) (branch :hs :ls/bad) (li :t1 4096) (alu :sub :t1 :t0)
                   (alu :cmp :t2 :t1) (branch :hs :ls/bad))
        mode (-> (hd mapped cfg 30 (io/literal 0) (io/literal 0) (io/literal 0) (io/literal 0)) (store :t0 :x2)
                 (load :t0 :out-create) (imm :cmp :t0 0) (branch :eq :ls.fs/temp-prepared)
                 (append :call :none :none :none :none :none 0 :ls.output/prepare)
                 (mov :t0 :ret) (imm :cmp :t0 1) (branch :ne :ls/bad) (mark :ls.fs/temp-prepared))
        created (sys mode cfg :mkdirat (io/state-field :m-dfd)
                        (io/literal (record-get [:ref :linux.static.fs/config] cfg :buf-c)) (io/state-field :x2)
                        (io/literal 0) (io/literal 0))
        journaled (-> created (store :t0 :x6) (imm :cmp :t0 0) (branch :ne :ls.fs/temp-journaled)
                      (load :t1 :out-create) (imm :cmp :t1 0) (branch :eq :ls.fs/temp-journaled)
                      (li :t1 2) (store :t1 :out-active) (mark :ls.fs/temp-journaled) (load :t0 :x6))
        made (outcome journaled
               cfg "temp-mkdir" 13 2 :ls.fs/temp-try :ls.fs/temp-exhausted :ls/bad)
        selected (-> made (load :t0 :out-create) (imm :cmp :t0 0) (branch :eq :ls.fs/temp-unmanaged)
                     (append :call :none :none :none :none :none 0 :ls.output/capture)
                     (mov :t0 :ret) (imm :cmp :t0 1) (branch :ne :ls/bad)
                     (branch :always :ls.fs/temp-ready) (mark :ls.fs/temp-unmanaged))
        ready (-> (close selected cfg :m-dfd) (mark :ls.fs/temp-ready))
        done (temp-answer ready cfg)
        empty (answer (-> (close (mark done :ls.fs/temp-exhausted) cfg :m-dfd)
                          (clear-temp-owner "temp-empty") (mark :ls.fs/temp-empty)) cfg :ls.fs/zero 0)]
    (-> (close (mark empty :ls.fs/temp-no-entropy) cfg :m-dfd)
        (clear-temp-owner "temp-entropy") (branch :always :ls.io/entropy-unavailable))))

(defn- data-bytes [out [:list [:ref :linux.static/instruction]] label :keyword text :string]
  [:list [:ref :linux.static/instruction]]
  (let [input (string-to-utf8 text)
        bytes (loop [index 0 data (vector-alloc 0)]
                (if (>= index (bytes-count input)) data
                  (recur (+ index 1) (vector-conj data (bytes-at input index)))))]
    (typed-list-conj [:list [:ref :linux.static/instruction]] (mark out label)
      (asm/instruction :bytes :none :none :none :none :none 0 :none bytes))))

(defn- constants [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.fs/config]]
  [:list [:ref :linux.static/instruction]]
  (let [formatted (formatter out cfg)
        tokens (loop [index 0 code formatted]
                 (if (= index 15) code
                   (recur (+ index 1) (data-bytes code (token-label index) (token-name index)))))]
    (-> tokens (data-bytes :ls.fs/one "1") (data-bytes :ls.fs/zero "0")
        (data-bytes :ls.fs/output-prefix ".kotoba-output-")
        (append :align :none :none :none :none :none 16 :none))))

(defn- lookup [m :document key :keyword] :document
  (if (not= (document-kind m) :map) (document-null)
    (loop [index 0]
      (if (>= index (document-count m)) (document-null)
        (let [pair (option-value-of [:option :document] (document-map-entry-at m index) (document-null))
              k (option-value-of [:option :document] (document-vector-at pair 0) (document-null))]
          (if (document-equal? k (document-keyword key))
            (option-value-of [:option :document] (document-vector-at pair 1) (document-null)) (recur (+ index 1))))))))
(defn- i64-of [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) -1))
(defn- region? [base :i64 size :i64 begin :i64 end :i64] :bool
  (and (>= base begin) (<= base end) (= (bit-and base 15) 0) (<= size (- end base))))
(defn- region-size [key :keyword] :i64
  (case key :buf-a 4096 :buf-b 4096 :buf-c 4096 :stat-buf 256 :answer 256 :tokens 256 :probe 16 -1))
(defn- region-key [index :i64] :keyword
  (case index 0 :buf-a 1 :buf-b 2 :buf-c 3 :stat-buf 4 :answer 5 :tokens 6 :probe :none))
(defn- configuration-error [isa :keyword source-plan :document layout :document] :keyword
  (let [data (i64-of (lookup layout :data)) memory (i64-of (lookup layout :memory-size))]
    (cond
      (not (or (= isa :x86_64) (= isa :aarch64))) :unknown-isa
      (not (document-equal? (lookup source-plan :handlers?) (document-bool true))) :handlers-not-planned
      (or (<= data 0) (not= (bit-and data 4095) 0) (< memory 4096)
          (> memory (- 9223372036854775807 data))) :layout-input
      :else
      (loop [index 0]
        (if (= index 7) :ok
          (let [key (region-key index) base (i64-of (lookup layout key)) size (region-size key)]
            (if (not (region? base size (+ data 4096) (+ data memory))) :scratch-region
              (let [separate? (loop [other 0]
                                (if (= other index) true
                                  (let [other-key (region-key other) other-base (i64-of (lookup layout other-key))]
                                    (if (or (<= (+ base size) other-base)
                                            (<= (+ other-base (region-size other-key)) base))
                                      (recur (+ other 1)) false))))]
                (if separate? (recur (+ index 1)) :scratch-overlap)))))))))

(defn- add-source [out [:list [:ref :linux.static.fs/fragment]] key :keyword source [:ref :linux.static.paths/result]]
  [:list [:ref :linux.static.fs/fragment]]
  (typed-list-conj [:list [:ref :linux.static.fs/fragment]] out
    (record-new [:ref :linux.static.fs/fragment] key
      (record-get [:ref :linux.static.paths/result] source :code)
      (record-get [:ref :linux.static.paths/result] source :error))))

(defn- source-fragments [isa :keyword source-plan :document layout :document]
  [:list [:ref :linux.static.fs/fragment]]
  (let [b (i64-of (lookup layout :buf-b)) c (i64-of (lookup layout :buf-c))
        nf (+ 524288 (if (= isa :x86_64) 131072 32768))
        directory (if (= isa :x86_64) 65536 16384)
        empty (typed-list-new [:list [:ref :linux.static.fs/fragment]])]
    (-> empty
        (add-source :resolve-a (paths/resolve-path isa source-plan layout "fs-path-a" :ls.fs/path-failed b :len-a :rel-a))
        (add-source :resolve-c (paths/resolve-path isa source-plan layout "fs-rename-path" :ls.fs/path-failed c :len-c :rel-c))
        (add-source :parent-mkdir (paths/open-parent isa source-plan layout "fs-parent-mkdir" 8 b :len-a :pfd :x0 :ls.fs/mutate-8-no-parent))
        (add-source :parent-unlink (paths/open-parent isa source-plan layout "fs-parent-unlink" 9 b :len-a :pfd :x0 :ls.fs/mutate-9-no-parent))
        (add-source :parent-rmdir (paths/open-parent isa source-plan layout "fs-parent-rmdir" 10 b :len-a :pfd :x0 :ls.fs/mutate-10-no-parent))
        (add-source :parent-rename-a (paths/open-parent isa source-plan layout "fs-parent-rename-a" 11 b :len-a :pfd :x0 :ls.fs/rename-no-parent))
        (add-source :parent-rename-c (paths/open-parent isa source-plan layout "fs-parent-rename-c" 11 c :len-c :fd :x0 :ls.fs/rename-no-second))
        (add-source :open-read (paths/open-at isa source-plan layout (io/state-field :rel-a) nf 0))
        (add-source :open-write (paths/open-at isa source-plan layout (io/state-field :rel-a) (+ nf 577) 420))
        ;; O_WRONLY|O_CREAT|O_EXCL, initial 0600, NOFOLLOW/CLOEXEC as above.
        (add-source :open-stage (paths/open-at isa source-plan layout (io/state-field :rel-a) (+ nf 193) 384))
        (add-source :open-append (paths/open-at isa source-plan layout (io/state-field :rel-a) (+ nf 1025) 0))
        (add-source :open-nofollow (paths/open-at isa source-plan layout (io/state-field :rel-a) (+ nf 2097152) 0))
        (add-source :open-temp-root (paths/open-at isa source-plan layout (io/state-field :rel-a) (+ 2621440 directory) 0)))))

(defn- source-error [sources [:list [:ref :linux.static.fs/fragment]]] :keyword
  (loop [index 0]
    (if (>= index (vector-count sources)) :ok
      (let [source (typed-list-nth [:list [:ref :linux.static.fs/fragment]] sources index)
            error (record-get [:ref :linux.static.fs/fragment] source :error)]
        (if (= error :ok) (recur (+ index 1)) error)))))
(defn- failure [error :keyword] [:ref :linux.static.fs/result]
  (record-new [:ref :linux.static.fs/result] (empty-code) :none error))

(defn routine [isa :keyword source-plan :document layout :document] [:ref :linux.static.fs/result]
  (let [error (configuration-error isa source-plan layout)]
    (if (not= error :ok) (failure error)
      (let [sources (source-fragments isa source-plan layout) source-error (source-error sources)
            pair (strings/pool-pair-fragment (lookup source-plan :context-abi))
            path-utf8 (strings/utf8-span-fragment "fs-raw-path")
            frame (protocol/request-fragment :app-data :ls.fs/legacy-request)]
        (cond
          (not= source-error :ok) (failure source-error)
          (not= (record-get [:ref :linux.static.strings/result] pair :error) :ok)
          (failure (record-get [:ref :linux.static.strings/result] pair :error))
          (not= (record-get [:ref :linux.static.strings/result] path-utf8 :error) :ok)
          (failure (record-get [:ref :linux.static.strings/result] path-utf8 :error))
          (not= (record-get [:ref :linux.static.fs.protocol/result] frame :error) :ok)
          (failure (record-get [:ref :linux.static.fs.protocol/result] frame :error))
          :else
          (let [cfg (record-new [:ref :linux.static.fs/config] isa (i64-of (lookup layout :data))
                      (i64-of (lookup layout :buf-a)) (i64-of (lookup layout :buf-b)) (i64-of (lookup layout :buf-c))
                      (i64-of (lookup layout :stat-buf)) (i64-of (lookup layout :answer)) (i64-of (lookup layout :tokens))
                      (i64-of (lookup layout :probe)) sources (record-get [:ref :linux.static.strings/result] pair :code))
                entry (-> (empty-code) (append :align :none :none :none :none :none 16 :none)
                          (mark :ls.cap/fs-app-data))
                framed (-> (hd (join entry (record-get [:ref :linux.static.fs.protocol/result] frame :code)) cfg 2
                             (io/state-field :form) (io/literal 0) (io/literal 0) (io/literal 0))
                           (imm :cmp :t0 1) (branch :ne :ls/bad)
                           (li :t2 1) (load :t0 :form) (imm :cmp :t0 0) (branch :ne :ls.fs/framed-occurrence)
                           (li :t2 0) (mark :ls.fs/framed-occurrence))
                checked (-> (hd framed cfg 17 (io/state-field :form) (io/register :t2) (io/literal 0) (io/literal 0))
                            (imm :cmp :t0 1) (branch :ne :ls/bad) (branch :always :ls.fs/request-ready)
                            ;; Raw contracts require FS2; ambiguous legacy
                            ;; token framing remains only on the old text API.
                            (mark :ls.fs/legacy-request) (load :t0 :rk) (imm :cmp :t0 1) (branch :ne :ls/bad)
                            (tokens cfg) (mark :ls.fs/request-ready))
                typed (-> (hd checked cfg 49 (io/state-field :rk) (io/state-field :form) (io/literal 0) (io/literal 0))
                          (imm :cmp :t0 1) (branch :ne :ls/bad)
                          (load :t0 :rk) (imm :cmp :t0 8) (branch :eq :ls.fs/check-path-utf8)
                          (imm :cmp :t0 11) (branch :ne :ls.fs/path-utf8-ready) (mark :ls.fs/check-path-utf8))
                path-checked (-> (join typed (record-get [:ref :linux.static.strings/result] path-utf8 :code))
                                 (mark :ls.fs/path-utf8-ready))
                parsed (fragment path-checked cfg :resolve-a)
                dispatch (loop [form 0 code parsed]
                           (if (= form 19) (branch code :always :ls/bad)
                             (recur (+ form 1) (-> code (load :t0 :form) (imm :cmp :t0 form) (branch :eq (form-label form))))))
                failed (-> dispatch (mark :ls.fs/path-failed) (load :t0 :path-denied)
                           (imm :cmp :t0 1) (branch :eq :ls.fs/scope-absent)
                           ;; Preserve the previous EXISTS false for an invalid path;
                           ;; other malformed/unavailable paths remain terminal.
                           (load :t0 :form) (imm :cmp :t0 3) (branch :ne :ls/bad)
                           (branch :always :ls.fs/scope-false) (mark :ls.fs/scope-absent))
                absent (-> (hd failed cfg 48 (io/state-field :form) (io/literal 0) (io/literal 0) (io/literal 0))
                           (imm :cmp :t0 1) (branch :eq :ls.fs/scope-false)
                           (imm :cmp :t0 0) (branch :ne :ls/bad))
                path-failed (-> (answer absent cfg :ls.fs/zero 0) (mark :ls.fs/scope-false)
                                (answer cfg :ls.fs/zero 1))
                code (-> path-failed (read-form cfg) (write-form cfg 1) (write-form cfg 2) (exists-form cfg)
                         (range-form cfg) (metadata-form cfg 5) (metadata-form cfg 6) (chmod-form cfg)
                         (mutation-form cfg 8) (mutation-form cfg 9) (mutation-form cfg 10) (rename-form cfg)
                         (fsync-form cfg) (temp-form cfg) (metadata-form cfg 14) (metadata-form cfg 15)
                         (stage-member-form cfg) (discard-output-form cfg) (constants cfg))]
            (record-new [:ref :linux.static.fs/result] code :ls.cap/fs-app-data :ok)))))))
