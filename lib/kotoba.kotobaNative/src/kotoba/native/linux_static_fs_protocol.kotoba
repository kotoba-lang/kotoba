;; Full path framing for both native filesystem capabilities. Source candidate.
;; No authority is granted here; entry follows the owning C1 and UTF-8 gate.
(ns kotoba.native.linux-static-fs-protocol
  {:kotoba/export [request-fragment answer-routine]}
  (:require [kotoba.native.linux-static-assembler :as asm]
            [kotoba.native.linux-static-io :as io]
            [kotoba.native.linux-static-strings :as strings])
  (:schemas
   {:linux.static.fs.protocol/result
    [:record :linux.static.fs.protocol/result
     [[:code [:list [:ref :linux.static/instruction]]] [:error :keyword]]]}))

(defn- empty-code [] [:list [:ref :linux.static/instruction]]
  (typed-list-new [:list [:ref :linux.static/instruction]]))
(defn- append [out [:list [:ref :linux.static/instruction]] op :keyword aux :keyword
               d :keyword s :keyword b :keyword i :keyword n :i64 target :keyword]
  [:list [:ref :linux.static/instruction]]
  (typed-list-conj [:list [:ref :linux.static/instruction]] out
    (asm/instruction op aux d s b i n target (vector-alloc 0))))
(defn- join [out [:list [:ref :linux.static/instruction]] code [:list [:ref :linux.static/instruction]]]
  [:list [:ref :linux.static/instruction]]
  (loop [index 0 current out]
    (if (>= index (vector-count code)) current
      (recur (+ index 1) (typed-list-conj [:list [:ref :linux.static/instruction]] current
                          (typed-list-nth [:list [:ref :linux.static/instruction]] code index))))))
(defn- tag [family :keyword suffix :string] :keyword
  (keyword-from-string (string-concat "ls.fs-protocol/"
    (string-concat (if (= family :browse) "browse-" "data-") suffix))))
(defn- mark [out [:list [:ref :linux.static/instruction]] label :keyword]
  [:list [:ref :linux.static/instruction]] (append out :label :none :none :none :none :none 0 label))
(defn- li [out [:list [:ref :linux.static/instruction]] d :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (append out :li :none d :none :none :none n :none))
(defn- mov [out [:list [:ref :linux.static/instruction]] d :keyword s :keyword]
  [:list [:ref :linux.static/instruction]] (append out :mov :none d s :none :none 0 :none))
(defn- load [out [:list [:ref :linux.static/instruction]] d :keyword key :keyword]
  [:list [:ref :linux.static/instruction]] (append out :ld :none d :none :s0 :none (io/state-offset key) :none))
(defn- store [out [:list [:ref :linux.static/instruction]] d :keyword key :keyword]
  [:list [:ref :linux.static/instruction]] (append out :st :none d :none :s0 :none (io/state-offset key) :none))
(defn- byte-op [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword base :keyword i :keyword]
  [:list [:ref :linux.static/instruction]] (append out op :none d :none base i 0 :none))
(defn- alu [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword s :keyword]
  [:list [:ref :linux.static/instruction]] (append out :alu op d s :none :none 0 :none))
(defn- imm [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (append out :alui op d :none :none :none n :none))
(defn- branch [out [:list [:ref :linux.static/instruction]] condition :keyword label :keyword]
  [:list [:ref :linux.static/instruction]]
  (append out (if (= condition :always) :b :bcc) condition :none :none :none :none 0 label))
(defn- marker-byte [index :i64] :i64 (case index 0 0 1 70 2 83 3 50 4 0 -1))
(defn- checked-marker [out [:list [:ref :linux.static/instruction]]]
  [:list [:ref :linux.static/instruction]]
  (loop [index 1 code out]
    (if (= index 5) code
      (recur (+ index 1) (-> code (li :t0 index) (byte-op :ldb :t1 :s1 :t0)
                            (imm :cmp :t1 (marker-byte index)) (branch :ne :ls/bad))))))

(defn request-fragment [family :keyword legacy :keyword] [:ref :linux.static.fs.protocol/result]
  "Legacy branches to LEGACY. V2 falls through with s1=path, s2=path bytes.
  The original request span is unchanged; tail and form have private state."
  (if (not (or (= family :app-data) (= family :browse)))
    (record-new [:ref :linux.static.fs.protocol/result] (empty-code) :protocol-family)
    (let [start (-> (empty-code) (li :t0 0) (store :t0 :fs-frame)
                    (store :t0 :fs-tail) (store :t0 :fs-tail-len)
                    (load :s1 :rp) (load :s3 :rl) (imm :cmp :s3 0) (branch :eq legacy)
                    (li :t0 0) (byte-op :ldb :t1 :s1 :t0) (imm :cmp :t1 0) (branch :ne legacy)
                    ;; NUL FS2 NUL, original A..P or proposed Q/R/S, path, NUL, tail.
                    (imm :cmp :s3 8) (branch :lo :ls/bad))
          header (-> (checked-marker start) (li :t0 5) (byte-op :ldb :t1 :s1 :t0)
                     (imm :cmp :t1 65) (branch :lo :ls/bad)
                     (imm :cmp :t1 (if (= family :browse) 65 83)) (branch :hi :ls/bad)
                     (imm :sub :t1 65) (store :t1 :form)
                     (imm :add :s1 6) (imm :sub :s3 6) (li :s2 0)
                     (mark (tag family "path")) (alu :cmp :s2 :s3) (branch :hs :ls/bad)
                     (byte-op :ldb :t0 :s1 :s2) (imm :cmp :t0 0) (branch :eq (tag family "path-end"))
                     (imm :add :s2 1) (branch :always (tag family "path"))
                     (mark (tag family "path-end")) (imm :cmp :s2 0) (branch :eq :ls/bad)
                     (mov :t0 :s1) (alu :add :t0 :s2) (imm :add :t0 1) (store :t0 :fs-tail)
                     (mov :t0 :s3) (alu :sub :t0 :s2) (imm :sub :t0 1) (store :t0 :fs-tail-len))
          tail (if (= family :browse)
                 (-> header (imm :cmp :t0 0) (branch :ne :ls/bad))
                 ;; The six original tail forms plus stage-member (16).
                 (let [body (loop [index 0 code (load header :t1 :form)]
                              (if (= index 7) code
                                (recur (+ index 1)
                                  (-> code (imm :cmp :t1 (case index 0 1 1 2 2 4 3 7 4 11 5 13 16))
                                      (branch :eq (tag family "tail-ok"))))))]
                   (-> body (load :t0 :fs-tail-len) (imm :cmp :t0 0) (branch :ne :ls/bad)
                       (mark (tag family "tail-ok")))))]
      (record-new [:ref :linux.static.fs.protocol/result]
        (-> tail (li :t0 1) (store :t0 :fs-frame)) :ok))))

(defn answer-routine [data :i64 context :document] [:ref :linux.static.fs.protocol/result]
  "One shared finish routine acknowledges every V2 answer, including empty data."
  (let [reader (strings/read-string-fragment context "fs-protocol-answer")
        raw-reader (strings/read-span-fragment context "fs-protocol-answer-raw")
        pair (strings/pool-pair-fragment context)]
    (cond
      (not= (record-get [:ref :linux.static.strings/result] reader :error) :ok)
      (record-new [:ref :linux.static.fs.protocol/result] (empty-code)
        (record-get [:ref :linux.static.strings/result] reader :error))
      (not= (record-get [:ref :linux.static.strings/result] raw-reader :error) :ok)
      (record-new [:ref :linux.static.fs.protocol/result] (empty-code)
        (record-get [:ref :linux.static.strings/result] raw-reader :error))
      (not= (record-get [:ref :linux.static.strings/result] pair :error) :ok)
      (record-new [:ref :linux.static.fs.protocol/result] (empty-code)
        (record-get [:ref :linux.static.strings/result] pair :error))
      :else
      (let [start (-> (empty-code) (mark :ls.fs-protocol/finish) (load :t0 :fs-frame)
                      (imm :cmp :t0 0) (branch :eq :ls.cap/finish) (load :s1 :res))
            selected (-> start (load :t0 :xk) (imm :cmp :t0 1) (branch :eq :ls.fs-protocol/read-text))
            raw (-> (join selected (record-get [:ref :linux.static.strings/result] raw-reader :code))
                    (branch :always :ls.fs-protocol/read-ready) (mark :ls.fs-protocol/read-text))
            read (-> (join raw (record-get [:ref :linux.static.strings/result] reader :code))
                     (mark :ls.fs-protocol/read-ready)
                     (mov :s1 :s2) (mov :s2 :s3)
                     (li :t0 9223372036854775802) (alu :cmp :s2 :t0) (branch :hi :ls/trap-bytes)
                     (imm :add :s2 5))
            charge (-> (io/decision-fragment read data :ls.cap/h-decide (io/literal 6)
                         (io/state-field :pool-used) (io/register :s2) (io/state-field :bytes) (io/literal 0))
                       (imm :cmp :t0 1) (branch :ne :ls/trap-bytes)
                       (load :s4 :pool-used) (load :t0 :bytes) (alu :cmp :s4 :t0) (branch :hi :ls/trap-bytes)
                       (alu :sub :t0 :s4) (alu :cmp :s2 :t0) (branch :hi :ls/trap-bytes)
                       (load :a1 :pool-base) (alu :add :a1 :s4))
            marker (loop [index 0 code charge]
                     (if (= index 5) code
                       (recur (+ index 1) (-> code (li :t0 (marker-byte index)) (li :t1 index)
                                             (byte-op :stb :t0 :a1 :t1)))))
            copied (-> marker (imm :add :a1 5) (li :t0 0) (mark :ls.fs-protocol/copy)
                       (alu :cmp :t0 :s3) (branch :hs :ls.fs-protocol/copied)
                       (byte-op :ldb :t1 :s1 :t0) (byte-op :stb :t1 :a1 :t0)
                       (imm :add :t0 1) (branch :always :ls.fs-protocol/copy)
                       (mark :ls.fs-protocol/copied) (mov :t0 :s4) (alu :add :t0 :s2)
                       (store :t0 :pool-used) (append :not :none :s4 :none :none :none 0 :none))
            code (-> (join copied (record-get [:ref :linux.static.strings/result] pair :code))
                     (store :t0 :res) (branch :always :ls.cap/finish)
                     (append :align :none :none :none :none :none 16 :none))]
        (record-new [:ref :linux.static.fs.protocol/result] code :ok)))))
