;; Canonical C3 call gate, native SHA-256, physical cwd and raw FS2 boundary.
;; Sealed decision text and common trap paths remain required externals.
;; Source candidate only: does not enable the owning wire-3/wire-40 profile.
(ns kotoba.native.linux-static-capability
  {:kotoba/export [routine]}
  (:require [kotoba.native.linux-static-assembler :as asm]
            [kotoba.native.linux-static-strings :as strings]
            [kotoba.native.linux-static-vectors :as vectors]
            [kotoba.native.linux-static-io :as io]
            [kotoba.native.linux-static-paths :as paths]
            [kotoba.native.linux-static-browse :as browse]
            [kotoba.native.linux-static-fs-protocol :as fs-protocol]
            [kotoba.native.linux-static-filesystem :as filesystem]
            [kotoba.native.linux-static-spawn :as spawn]
            [kotoba.native.linux-static-sha256 :as sha256])
  (:schemas
   {:linux.static.capability/config
    [:record :linux.static.capability/config
     [[:data :i64] [:allow :i64] [:workspace :i64] [:cwd :i64] [:raw? :bool]]]
    :linux.static.capability/result
    [:record :linux.static.capability/result
     [[:code [:list [:ref :linux.static/instruction]]]
      [:start [:list [:ref :linux.static/instruction]]]
      [:bindings :document] [:externals :document] [:error :keyword]]]}))

(defn- empty-code [] [:list [:ref :linux.static/instruction]]
  (typed-list-new [:list [:ref :linux.static/instruction]]))

(defn- append [out [:list [:ref :linux.static/instruction]] op :keyword aux :keyword
               d :keyword s :keyword b :keyword i :keyword n :i64 target :keyword]
  [:list [:ref :linux.static/instruction]]
  (typed-list-conj [:list [:ref :linux.static/instruction]] out
    (asm/instruction op aux d s b i n target (vector-alloc 0))))

(defn- join [out [:list [:ref :linux.static/instruction]] code [:list [:ref :linux.static/instruction]]]
  [:list [:ref :linux.static/instruction]]
  (loop [index 0 current out]
    (if (>= index (vector-count code)) current
      (recur (+ index 1) (typed-list-conj [:list [:ref :linux.static/instruction]] current
                            (typed-list-nth [:list [:ref :linux.static/instruction]] code index))))))

(defn- mark [out [:list [:ref :linux.static/instruction]] label :keyword]
  [:list [:ref :linux.static/instruction]]
  (append out :label :none :none :none :none :none 0 label))

(defn- li [out [:list [:ref :linux.static/instruction]] d :keyword n :i64]
  [:list [:ref :linux.static/instruction]]
  (append out :li :none d :none :none :none n :none))

(defn- mov [out [:list [:ref :linux.static/instruction]] d :keyword s :keyword]
  [:list [:ref :linux.static/instruction]]
  (append out :mov :none d s :none :none 0 :none))

(defn- mem [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword base :keyword offset :i64]
  [:list [:ref :linux.static/instruction]]
  (append out op :none d :none base :none offset :none))

(defn- alu [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword s :keyword]
  [:list [:ref :linux.static/instruction]]
  (append out :alu op d s :none :none 0 :none))

(defn- imm [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword n :i64]
  [:list [:ref :linux.static/instruction]]
  (append out :alui op d :none :none :none n :none))

(defn- unary [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword]
  [:list [:ref :linux.static/instruction]]
  (append out op :none d :none :none :none 0 :none))

(defn- branch [out [:list [:ref :linux.static/instruction]] condition :keyword target :keyword]
  [:list [:ref :linux.static/instruction]]
  (append out (if (= condition :always) :b :bcc) condition :none :none :none :none 0 target))

(defn- simple [out [:list [:ref :linux.static/instruction]] op :keyword]
  [:list [:ref :linux.static/instruction]]
  (append out op :none :none :none :none :none 0 :none))

(defn- decision-call [out [:list [:ref :linux.static/instruction]] data :i64 target :keyword]
  [:list [:ref :linux.static/instruction]]
  ;; Five value arguments are already in ctx/p0,a1..a4. gctx is the
  ;; separate hidden private context, not a guest-controlled argument.
  (-> out (li :t1 9007199254740991) (mem :st :t1 :s0 1080)
      (li :gctx (+ data 1072))
      (append :call :none :none :none :none :none 0 target) (mov :t0 :ret)))

(defn- begin [cfg [:ref :linux.static.capability/config]] [:list [:ref :linux.static/instruction]]
  (let [data (record-get [:ref :linux.static.capability/config] cfg :data)
        allow (record-get [:ref :linux.static.capability/config] cfg :allow)
        saved (-> (empty-code) (append :align :none :none :none :none :none 16 :none)
                  (mark :ls.cap/typed-cap-call)
                  (unary :push :s0) (unary :push :s1) (unary :push :s2)
                  (unary :push :s3) (unary :push :s4) (simple :save-lr)
                  (li :s0 data) (mem :st :a1 :s0 1128) (mem :st :a2 :s0 1136)
                  (mem :st :a3 :s0 1144) (mem :st :a4 :s0 1152))
        masks (-> saved (mem :ld :ctx :s0 allow) (mem :ld :a1 :s0 (+ allow 8))
                  (mem :ld :a2 :s0 (+ allow 16)) (mem :ld :a3 :s0 (+ allow 24)) (mem :ld :a4 :s0 1128))
        granted (-> (decision-call masks data :ls.cap/c1-cap)
                    (imm :cmp :t0 1) (branch :ne :ls/bad)
                    (li :ctx 1) (mem :ld :a1 :s0 1136) (mem :ld :a2 :s0 1144) (li :a3 0) (li :a4 0))
        kinds (-> (decision-call granted data :ls.cap/c1-decide)
                  (imm :cmp :t0 1) (branch :ne :ls/bad)
                  (li :ctx 0) (mem :ld :a1 :s0 1128) (mem :ld :a2 :s0 1136) (li :a3 0) (li :a4 0))
        provider (-> (decision-call kinds data :ls.cap/c1-decide)
                     (li :ctx 0) (mov :a1 :t0) (mem :ld :a2 :s0 1128) (li :a3 0) (li :a4 0))]
    (let [handler (-> (decision-call provider data :ls.cap/h-decide) (mem :st :t0 :s0 1176)
                      (imm :cmp :t0 0) (branch :eq :ls.cap/no-handler))
        ;; Discriminators name full request/result contracts, not primitive
        ;; type codes. Only fs/app-data handler 7 accepts byte contracts
        ;; 8/9 and segmented contracts 10/11; all others are string/string.
          kind (if (record-get [:ref :linux.static.capability/config] cfg :raw?)
                 (-> handler (mem :ld :t0 :s0 1136) (imm :cmp :t0 1) (branch :eq :ls.cap/kind-ready)
                     (mem :ld :t1 :s0 1176) (imm :cmp :t1 7) (branch :ne :ls/bad)
                     (imm :cmp :t0 8) (branch :eq :ls.cap/kind-ready)
                     (imm :cmp :t0 9) (branch :eq :ls.cap/kind-ready)
                     (imm :cmp :t0 10) (branch :eq :ls.cap/kind-ready)
                     (imm :cmp :t0 11) (branch :ne :ls/bad) (mark :ls.cap/kind-ready))
                 (-> handler (mem :ld :t0 :s0 1136) (imm :cmp :t0 1) (branch :ne :ls/bad)))]
      (-> kind (mov :ctx :s0) (mem :ld :s1 :s0 1152)))))

(defn- request-code [cfg [:ref :linux.static.capability/config]
                     text [:list [:ref :linux.static/instruction]] raw [:list [:ref :linux.static/instruction]]
                     chunks [:list [:ref :linux.static/instruction]]]
  [:list [:ref :linux.static/instruction]]
  (let [code (if (not (record-get [:ref :linux.static.capability/config] cfg :raw?))
               (join (begin cfg) text)
               (let [selected (-> (begin cfg) (mem :ld :t0 :s0 1136) (imm :cmp :t0 8)
                                   (branch :eq :ls.cap/bytes-request)
                                   (imm :cmp :t0 11) (branch :eq :ls.cap/chunks-request))
                     textual (branch (join selected text) :always :ls.cap/request-ready)
                     binary (branch (join (mark textual :ls.cap/bytes-request) raw) :always :ls.cap/request-ready)
                     segmented (join (mark binary :ls.cap/chunks-request) chunks)]
                 (mark segmented :ls.cap/request-ready)))]
    (-> code (mem :st :s2 :s0 1160) (mem :st :s3 :s0 1168))))

(defn- dispatch-label [id :i64] :keyword
  (case id
    1 :ls.cap/io-write 2 :ls.cap/io-write-error 3 :ls.cap/io-read
    4 :ls.cap/cli-args 5 :ls.cap/env-read 6 :ls.cap/clock
    7 :ls.cap/fs-app-data 8 :ls.cap/fs-browse 9 :ls.cap/entropy
    10 :ls.cap/spawn 11 :ls.cap/hash 12 :ls.cap/cwd :ls/bad))

(defn- dispatch [out [:list [:ref :linux.static/instruction]] hash? :bool]
  [:list [:ref :linux.static/instruction]]
  (loop [id 1 code out]
    (if (> id 12) (branch code :always :ls/bad)
      (recur (+ id 1)
        (if (and (= id 11) (not hash?)) code
          (-> code (mem :ld :t0 :s0 1176) (imm :cmp :t0 id)
              (branch :eq (dispatch-label id))))))))

(defn- hash-body [out [:list [:ref :linux.static/instruction]]
                  cfg [:ref :linux.static.capability/config]
                  intern [:list [:ref :linux.static/instruction]]]
  [:list [:ref :linux.static/instruction]]
  (let [workspace (record-get [:ref :linux.static.capability/config] cfg :workspace)
        data (record-get [:ref :linux.static.capability/config] cfg :data)
        raw (-> out (mark :ls.cap/hash) (mov :ctx :s0) (li :a1 workspace)
                (mem :ld :a2 :s0 1160) (mem :ld :a3 :s0 1168)
                (append :call :none :none :none :none :none 0 (sha256/entry-label))
                (mov :t0 :ret) (li :t1 (+ workspace (sha256/digest-offset)))
                (alu :cmp :t0 :t1) (branch :ne :ls/bad)
                (mov :s1 :t0) (li :s2 (sha256/digest-bytes))
                (li :ctx 6) (mem :ld :a1 :s0 520) (mov :a2 :s2)
                (mem :ld :a3 :s0 544) (li :a4 0))
        charge (-> (decision-call raw data :ls.cap/h-decide)
                   (imm :cmp :t0 1) (branch :ne :ls/trap-bytes))]
    (-> (join charge intern) (mem :st :t0 :s0 1184) (branch :always :ls.cap/finish))))

(defn- cwd-body [out [:list [:ref :linux.static/instruction]]
                 cfg [:ref :linux.static.capability/config]
                 intern [:list [:ref :linux.static/instruction]]]
  [:list [:ref :linux.static/instruction]]
  ;; paths/startup has already captured getcwd, before its temporary fchdir
  ;; for scope-root discovery. The private buffer and cwd-len are immutable
  ;; after startup; a failed/nonabsolute capture leaves length zero.
  (let [data (record-get [:ref :linux.static.capability/config] cfg :data)
        captured (-> out (mark :ls.cap/cwd)
                     (mem :ld :t0 :s0 1168) (imm :cmp :t0 0) (branch :ne :ls/bad)
                     (mem :ld :s2 :s0 1032) (imm :cmp :s2 0) (branch :le :ls/bad)
                     (imm :cmp :s2 4096) (branch :hs :ls/bad)
                     (li :s1 (record-get [:ref :linux.static.capability/config] cfg :cwd))
                     (li :ctx 6) (mem :ld :a1 :s0 520) (mov :a2 :s2)
                     (mem :ld :a3 :s0 544) (li :a4 0))
        charge (-> (decision-call captured data :ls.cap/h-decide)
                   (imm :cmp :t0 1) (branch :ne :ls/trap-bytes))]
    ;; Common finish resolves and validates the returned UTF-8 string.
    (-> (join charge intern) (mem :st :t0 :s0 1184) (branch :always :ls.cap/finish))))

(defn- finish [out [:list [:ref :linux.static/instruction]] raw? :bool
               result-reader [:list [:ref :linux.static/instruction]]
               raw-reader [:list [:ref :linux.static/instruction]]
               raw-writer [:list [:ref :linux.static/instruction]]
               chunks-writer [:list [:ref :linux.static/instruction]]]
  [:list [:ref :linux.static/instruction]]
  (let [loaded (-> out (mark :ls.cap/finish) (mov :ctx :s0) (mem :ld :s1 :s0 1184))
        text (if (not raw?) (join loaded result-reader)
               (let [selected (-> loaded (mem :ld :t0 :s0 1144) (imm :cmp :t0 1)
                                   (branch :eq :ls.cap/string-result))
                     span (-> (join selected raw-reader) (mov :s1 :s2) (mov :s2 :s3)
                              (mem :ld :t0 :s0 1144) (imm :cmp :t0 10) (branch :eq :ls.cap/chunks-result)
                              (imm :cmp :t0 11) (branch :eq :ls.cap/chunks-result))
                     raw (-> (join span raw-writer) (mov :s1 :t0) (branch :always :ls.cap/result-ready))
                     chunks (-> (join (mark raw :ls.cap/chunks-result) chunks-writer)
                                (mov :s1 :t0) (branch :always :ls.cap/result-ready))
                     text (join (mark chunks :ls.cap/string-result) result-reader)]
                 (mark text :ls.cap/result-ready)))]
    (-> text (mov :t0 :s1) (simple :restore-lr)
        (unary :pop :s4) (unary :pop :s3) (unary :pop :s2) (unary :pop :s1) (unary :pop :s0)
        (mov :ret :t0) (simple :ret))))

(defn- externals [] :document
  (document-set
    (document-keyword :ls.cap/c1-cap) (document-keyword :ls.cap/c1-decide) (document-keyword :ls.cap/h-decide)
    (document-keyword :ls/bad) (document-keyword :ls/trap-cells) (document-keyword :ls/trap-bytes)
    (document-keyword :ls.cap/no-handler) (document-keyword :ls/trap-exit)))

(defn- lookup [m :document key :keyword] :document
  (if (not= (document-kind m) :map) (document-null)
    (loop [index 0]
      (if (>= index (document-count m)) (document-null)
        (let [pair (option-value-of [:option :document] (document-map-entry-at m index) (document-null))
              k (option-value-of [:option :document] (document-vector-at pair 0) (document-null))]
          (if (document-equal? k (document-keyword key))
            (option-value-of [:option :document] (document-vector-at pair 1) (document-null))
            (recur (+ index 1))))))))

(defn- i64-of [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) -1))

(defn- granted-hash? [grant :document] :bool
  (loop [index 0]
    (if (>= index (document-count grant)) false
      (if (document-equal? (option-value-of [:option :document] (document-vector-at grant index) (document-null))
                          (document-i64 3)) true (recur (+ index 1))))))

(defn- sum-fits? [a :i64 b :i64] :bool
  (and (>= a 0) (>= b 0) (<= b (- 9223372036854775807 a))))

(defn- configuration-error [source-plan :document layout :document] :keyword
  (let [context (lookup source-plan :context-abi) allow (lookup context :allow-bitmap-offset)
        grant (lookup source-plan :grant) handlers (lookup source-plan :handlers?)
        data (i64-of (lookup layout :data)) memory (i64-of (lookup layout :memory-size))
        pool (i64-of (lookup layout :pool)) bytes (i64-of (lookup source-plan :bytes))
        workspace (i64-of (lookup layout :hash-workspace))]
    (cond
      (not (document-equal? handlers (document-bool true))) :handlers-not-planned
      (not= (document-kind grant) :vector) :grant-malformed
      (or (not= (document-kind allow) :i64) (< (i64-of allow) 0) (> (i64-of allow) 480)
          (not= (bit-and (i64-of allow) 7) 0)) :allow-bitmap-offset
      (or (<= data 0) (not= (bit-and data 4095) 0) (< memory 4096) (not (sum-fits? data memory))) :layout-input
      (not (granted-hash? grant)) :ok
      (or (<= workspace 0) (not= (bit-and workspace 15) 0)
          (not (sum-fits? workspace (sha256/workspace-bytes)))
          (not (sum-fits? pool bytes))) :hash-workspace
      (or (< workspace (+ data 4096)) (< workspace (+ pool bytes))
          (> (+ workspace (sha256/workspace-bytes)) (+ data memory))) :hash-workspace
      :else :ok)))

(defn- failure [error :keyword] [:ref :linux.static.capability/result]
  (record-new [:ref :linux.static.capability/result] (empty-code) (empty-code) (document-map) (document-set) error))

(defn routine [isa :keyword source-plan :document layout :document] [:ref :linux.static.capability/result]
  (let [error (configuration-error source-plan layout)]
    (if (not= error :ok) (failure error)
      (let [context (lookup source-plan :context-abi)
            raw? (and (> (i64-of (lookup source-plan :byte-value-limit)) 0)
                      (> (i64-of (lookup source-plan :vectors)) 0)
                      (> (i64-of (lookup source-plan :vector-items)) 0))
            request (strings/read-string-fragment context "cap-request")
            answer (strings/read-string-fragment context "cap-result")
            byte-request (if raw? (vectors/read-bytes-fragment context (i64-of (lookup layout :data)) "cap-request-bytes")
                           (record-new [:ref :linux.static.vectors/result] (empty-code) (document-map) :ok))
            chunks-request (if raw? (vectors/read-chunks-fragment context (i64-of (lookup layout :data)) "cap-request-chunks")
                             (record-new [:ref :linux.static.vectors/result] (empty-code) (document-map) :ok))
            raw-answer (strings/read-span-fragment context "cap-result-raw")
            byte-answer (if raw? (vectors/intern-bytes-fragment context "cap-result-bytes")
                          (record-new [:ref :linux.static.vectors/result] (empty-code) (document-map) :ok))
            chunks-answer (if raw? (vectors/intern-chunks-fragment context "cap-result-chunks")
                            (record-new [:ref :linux.static.vectors/result] (empty-code) (document-map) :ok))
            intern (strings/intern-string-fragment context "cap-intern")
            cwd-intern (strings/intern-string-fragment context "cap-cwd-intern")
            providers (io/routines isa source-plan layout)
            scope (paths/startup isa source-plan layout)
            directory (browse/routine isa source-plan layout)
            files (filesystem/routine isa source-plan layout)
            filesystem-answer (fs-protocol/answer-routine (i64-of (lookup layout :data)) context)
            process (spawn/routine isa source-plan layout)]
        (cond
          (not= (record-get [:ref :linux.static.strings/result] request :error) :ok)
          (failure (record-get [:ref :linux.static.strings/result] request :error))
          (not= (record-get [:ref :linux.static.strings/result] answer :error) :ok)
          (failure (record-get [:ref :linux.static.strings/result] answer :error))
          (not= (record-get [:ref :linux.static.vectors/result] byte-request :error) :ok)
          (failure (record-get [:ref :linux.static.vectors/result] byte-request :error))
          (not= (record-get [:ref :linux.static.vectors/result] chunks-request :error) :ok)
          (failure (record-get [:ref :linux.static.vectors/result] chunks-request :error))
          (not= (record-get [:ref :linux.static.strings/result] raw-answer :error) :ok)
          (failure (record-get [:ref :linux.static.strings/result] raw-answer :error))
          (not= (record-get [:ref :linux.static.vectors/result] byte-answer :error) :ok)
          (failure (record-get [:ref :linux.static.vectors/result] byte-answer :error))
          (not= (record-get [:ref :linux.static.vectors/result] chunks-answer :error) :ok)
          (failure (record-get [:ref :linux.static.vectors/result] chunks-answer :error))
          (not= (record-get [:ref :linux.static.strings/result] intern :error) :ok)
          (failure (record-get [:ref :linux.static.strings/result] intern :error))
          (not= (record-get [:ref :linux.static.strings/result] cwd-intern :error) :ok)
          (failure (record-get [:ref :linux.static.strings/result] cwd-intern :error))
          (not= (record-get [:ref :linux.static.io/result] providers :error) :ok)
          (failure (record-get [:ref :linux.static.io/result] providers :error))
          (not= (record-get [:ref :linux.static.paths/result] scope :error) :ok)
          (failure (record-get [:ref :linux.static.paths/result] scope :error))
          (not= (record-get [:ref :linux.static.browse/result] directory :error) :ok)
          (failure (record-get [:ref :linux.static.browse/result] directory :error))
          (not= (record-get [:ref :linux.static.fs/result] files :error) :ok)
          (failure (record-get [:ref :linux.static.fs/result] files :error))
          (not= (record-get [:ref :linux.static.fs.protocol/result] filesystem-answer :error) :ok)
          (failure (record-get [:ref :linux.static.fs.protocol/result] filesystem-answer :error))
          (not= (record-get [:ref :linux.static.spawn/result] process :error) :ok)
          (failure (record-get [:ref :linux.static.spawn/result] process :error))
          :else
          (let [hash? (granted-hash? (lookup source-plan :grant))
                cfg (record-new [:ref :linux.static.capability/config]
                      (i64-of (lookup layout :data)) (i64-of (lookup context :allow-bitmap-offset))
                      (if hash? (i64-of (lookup layout :hash-workspace)) 0)
                      (i64-of (lookup layout :cwd)) raw?)
                requested (request-code cfg (record-get [:ref :linux.static.strings/result] request :code)
                            (record-get [:ref :linux.static.vectors/result] byte-request :code)
                            (record-get [:ref :linux.static.vectors/result] chunks-request :code))
                gate (dispatch requested hash?)
                provider (if hash? (hash-body gate cfg (record-get [:ref :linux.static.strings/result] intern :code)) gate)
                with-cwd (cwd-body provider cfg
                           (record-get [:ref :linux.static.strings/result] cwd-intern :code))
                completed (finish with-cwd raw? (record-get [:ref :linux.static.strings/result] answer :code)
                            (record-get [:ref :linux.static.strings/result] raw-answer :code)
                            (record-get [:ref :linux.static.vectors/result] byte-answer :code)
                            (record-get [:ref :linux.static.vectors/result] chunks-answer :code))
                kernel (if hash? (join completed (sha256/routine)) completed)
                handlers (join (join kernel (record-get [:ref :linux.static.io/result] providers :code))
                           (record-get [:ref :linux.static.browse/result] directory :code))
                with-file-body (join handlers (record-get [:ref :linux.static.fs/result] files :code))
                with-files (join with-file-body
                             (record-get [:ref :linux.static.fs.protocol/result] filesystem-answer :code))
                with-spawn (join with-files (record-get [:ref :linux.static.spawn/result] process :code))
                code (join with-spawn
                       (record-get [:ref :linux.static.paths/result] scope :code))
                start (join (record-get [:ref :linux.static.io/result] providers :start)
                        (record-get [:ref :linux.static.paths/result] scope :start))]
            (record-new [:ref :linux.static.capability/result] code
              start
              (document-map (document-keyword :typed-cap-call) (document-keyword :ls.cap/typed-cap-call)
                            (document-keyword :finish) (document-keyword :ls.cap/finish))
              (externals) :ok)))))))
