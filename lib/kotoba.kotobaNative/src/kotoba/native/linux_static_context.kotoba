;; Complete initialized data/context page, from admitted plan and real labels.
;; Source candidate: document/span checks do not attest an artifact or mapping.
(ns kotoba.native.linux-static-context
  {:kotoba/export [context-bytes]}
  (:require [kotoba.native.linux-static-assembler :as asm]
            [kotoba.native.linux-static-io :as io])
  (:schemas
   {:linux.static.context/word
    [:record :linux.static.context/word [[:offset :i64] [:value :i64]]]
    :linux.static.context/result
    [:record :linux.static.context/result [[:bytes :vector-i64] [:error :keyword]]]}))

(defn- lookup [m :document key :keyword] :document
  (if (not= (document-kind m) :map) (document-null)
    (loop [index 0]
      (if (>= index (document-count m)) (document-null)
        (let [pair (option-value-of [:option :document] (document-map-entry-at m index) (document-null))
              k (option-value-of [:option :document] (document-vector-at pair 0) (document-null))]
          (if (document-equal? k (document-keyword key))
            (option-value-of [:option :document] (document-vector-at pair 1) (document-null)) (recur (+ index 1))))))))
(defn- item [v :document index :i64] :document
  (option-value-of [:option :document] (document-vector-at v index) (document-null)))
(defn- entry [m :document index :i64] :document
  (option-value-of [:option :document] (document-map-entry-at m index) (document-null)))
(defn- i64-of [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) -1))
(defn- key-of [d :document] :keyword (option-value-of [:option :keyword] (document-keyword-value d) :none))
(defn- true? [d :document] :bool (document-equal? d (document-bool true)))
(defn- abi-key [index :i64] :keyword
  (case index 0 :fuel-offset 1 :pair-used-pointer-offset 2 :pairs-base-offset 3 :pair-validated-base-offset
    4 :vector-used-pointer-offset 5 :vectors-base-offset 6 :vector-items-base-offset 7 :allow-bitmap-offset :none))
(defn- address [labels [:list [:ref :linux.static/label]] name :keyword] :i64
  (loop [index 0]
    (if (>= index (vector-count labels)) -1
      (let [label (typed-list-nth [:list [:ref :linux.static/label]] labels index)]
        (if (= name (record-get [:ref :linux.static/label] label :name))
          (record-get [:ref :linux.static/label] label :address) (recur (+ index 1)))))))
(defn- word [out [:list [:ref :linux.static.context/word]] offset :i64 value :i64]
  [:list [:ref :linux.static.context/word]]
  (typed-list-conj [:list [:ref :linux.static.context/word]] out
    (record-new [:ref :linux.static.context/word] offset value)))
(defn- data-words [source-plan :document layout :document labels [:list [:ref :linux.static/label]]
                   bindings :document code-address :i64 code-length :i64]
  [:list [:ref :linux.static.context/word]]
  (let [context (lookup source-plan :context-abi) data (i64-of (lookup layout :data))
        handler (address labels :ls/handler)
        base (-> (typed-list-new [:list [:ref :linux.static.context/word]])
                 (word 0 11) (word (i64-of (lookup context :fuel-offset)) (i64-of (lookup source-plan :fuel)))
                 (word (i64-of (lookup context :pair-used-pointer-offset)) (+ data (io/state-offset :pair-used)))
                 (word (i64-of (lookup context :pairs-base-offset)) (i64-of (lookup layout :pairs)))
                 (word (i64-of (lookup context :pair-validated-base-offset)) (i64-of (lookup layout :valid)))
                 (word (i64-of (lookup context :vector-used-pointer-offset)) (+ data (io/state-offset :vector-used)))
                 (word (i64-of (lookup context :vectors-base-offset)) (i64-of (lookup layout :vectors)))
                 (word (i64-of (lookup context :vector-items-base-offset)) (i64-of (lookup layout :vector-items)))
                 (word (io/state-offset :cells) (i64-of (lookup source-plan :cells)))
                 (word (io/state-offset :bytes) (i64-of (lookup source-plan :bytes)))
                 (word (io/state-offset :metered) (if (true? (lookup source-plan :metered?)) 1 0))
                 (word (io/state-offset :code-base) code-address) (word (io/state-offset :code-length) code-length)
                 (word (io/state-offset :pool-base) (i64-of (lookup layout :pool)))
                 (word (io/state-offset :sigaction) handler)
                 (word (+ (io/state-offset :sigaction) 8) 201326592)
                 (word (+ (io/state-offset :sigaction) 16) handler)
                 (word (io/state-offset :stack-t) (i64-of (lookup layout :alt)))
                 (word (+ (io/state-offset :stack-t) 16) 16384)
                 (word (io/state-offset :out-active) 0) (word (io/state-offset :out-cleaning) 0)
                 (word (io/state-offset :out-count) 0)
                 (word (io/state-offset :out-parent) -1) (word (io/state-offset :out-directory) -1)
                 (word (io/state-offset :out-file) -1) (word (io/state-offset :out-probe) -1))
        slots (lookup source-plan :slots)]
    (loop [index 0 words base]
      (if (>= index (document-count slots)) words
        (let [pair (entry slots index) slot (key-of (item pair 0)) description (item pair 1)]
          (recur (+ index 1) (word words (i64-of (lookup description :offset))
            (address labels (key-of (lookup bindings slot))))))))))

(defn- span? [base :i64 size :i64 begin :i64 end :i64] :bool
  (and (>= base begin) (<= base end) (>= size 0) (<= size (- end base)) (= (bit-and base 15) 0)))
(defn- configuration-error [source-plan :document layout :document labels [:list [:ref :linux.static/label]]
                            bindings :document code-address :i64 code-length :i64] :keyword
  (let [data (i64-of (lookup layout :data)) memory (i64-of (lookup layout :memory-size))
        cells (i64-of (lookup source-plan :cells)) bytes (i64-of (lookup source-plan :bytes))
        table-count (i64-of (lookup source-plan :vectors)) item-count (i64-of (lookup source-plan :vector-items))
        table (i64-of (lookup layout :vectors)) items (i64-of (lookup layout :vector-items))
        fuel (i64-of (lookup source-plan :fuel)) context (lookup source-plan :context-abi)
        slots (lookup source-plan :slots) grant (lookup source-plan :grant)
        alt (i64-of (lookup layout :alt)) pairs (i64-of (lookup layout :pairs))
        valid (i64-of (lookup layout :valid)) pool (i64-of (lookup layout :pool))
        text (i64-of (lookup layout :text)) handler (address labels :ls/handler)]
    (cond
      (or (<= data 0) (not= (bit-and data 4095) 0) (< memory 4096)
          (> memory (- 9223372036854775807 data))) :layout-input
      (or (not (document-equal? (lookup context :version) (document-i64 11)))
          (< fuel 0) (< cells 0) (< bytes 0) (> cells (quot 9223372036854775807 16))
          (not= (document-kind (lookup source-plan :metered?)) :bool)) :initial-values
      (or (< table-count 0) (< item-count 0)
          (> table-count (quot 9223372036854775807 16)) (> item-count (quot 9223372036854775807 8))) :vector-initial-values
      (or (<= text 0) (< code-address text) (< code-length 0) (> code-address data)
          (> code-length (- data code-address)) (< handler text) (>= handler code-address)) :code-span
      (or (not (span? alt 16384 (+ data 4096) (+ data memory)))
          (not (span? pairs (* cells 16) (+ data 4096) (+ data memory)))
          (not (span? valid cells (+ data 4096) (+ data memory)))
          (not (span? table (* 16 table-count) (+ data 4096) (+ data memory)))
          (not (span? items (* 8 item-count) (+ data 4096) (+ data memory)))
          (not (span? pool bytes (+ data 4096) (+ data memory)))
          (> (+ alt 16384) pairs) (> (+ pairs (* cells 16)) valid) (> (+ valid cells) table)
          (> (+ table (* 16 table-count)) items) (> (+ items (* 8 item-count)) pool)) :arena-layout
      (or (not= (document-kind slots) :map) (not= (document-kind bindings) :map)
          (not= (document-kind grant) :vector)) :context-input
      :else
      (let [abi-valid? (loop [index 0]
                         (if (= index 8) true
                           (let [offset (i64-of (lookup context (abi-key index))) size (if (= index 7) 32 8)]
                             (if (and (>= offset 8) (<= offset (- 512 size)) (= (bit-and offset 7) 0))
                               (recur (+ index 1)) false))))
            grant-valid? (loop [index 0]
                           (if (>= index (document-count grant)) true
                             (let [id (item grant index)]
                               (if (and (= (document-kind id) :i64) (>= (i64-of id) 0) (<= (i64-of id) 255))
                                 (recur (+ index 1)) false))))]
        (cond
          (not abi-valid?) :context-offset
          (not grant-valid?) :grant-input
          :else
          (loop [index 0]
            (if (>= index (document-count slots)) :ok
              (let [pair (entry slots index) slot (item pair 0) description (item pair 1)
                    offset (i64-of (lookup description :offset))
                    abi-name (keyword-from-string (string-concat (keyword-name (key-of slot)) "-offset"))
                    binding (lookup bindings (key-of slot)) pointer (address labels (key-of binding))]
                (if (and (= (document-kind slot) :keyword) (= (document-kind description) :map)
                         (>= offset 8) (<= offset 504) (= (bit-and offset 7) 0)
                         (= offset (i64-of (lookup context abi-name)))
                         (= (document-kind binding) :keyword) (>= pointer text) (< pointer code-address))
                  (recur (+ index 1)) :slot-binding)))))))))

(defn- words-error [words [:list [:ref :linux.static.context/word]] bitmap :i64] :keyword
  (loop [index 0]
    (if (>= index (vector-count words)) :ok
      (let [current (typed-list-nth [:list [:ref :linux.static.context/word]] words index)
            offset (record-get [:ref :linux.static.context/word] current :offset)
            value (record-get [:ref :linux.static.context/word] current :value)]
        (cond
          (or (< offset 0) (> offset 1016) (not= (bit-and offset 7) 0) (< value 0)) :context-word-unbound
          (and (< offset (+ bitmap 32)) (> (+ offset 8) bitmap)) :context-bitmap-overlap
          :else
          (let [duplicate? (loop [previous 0]
                             (if (= previous index) false
                               (if (= offset (record-get [:ref :linux.static.context/word]
                                               (typed-list-nth [:list [:ref :linux.static.context/word]] words previous) :offset))
                                 true (recur (+ previous 1)))))]
            (if duplicate? :context-word-overlap (recur (+ index 1)))))))))
(defn- grant-byte [grant :document byte :i64] :i64
  (loop [index 0 value 0]
    (if (>= index (document-count grant)) value
      (let [id (i64-of (item grant index))]
        (recur (+ index 1)
          (if (= (quot id 8) byte) (bit-or value (i64-shift-left 1 (- id (* byte 8)))) value))))))
(defn- word-byte [words [:list [:ref :linux.static.context/word]] offset :i64] :i64
  (loop [index 0]
    (if (>= index (vector-count words)) 0
      (let [word (typed-list-nth [:list [:ref :linux.static.context/word]] words index)
            begin (record-get [:ref :linux.static.context/word] word :offset)]
        (if (and (>= offset begin) (< offset (+ begin 8)))
          (bit-and (u64-shift-right (record-get [:ref :linux.static.context/word] word :value) (* 8 (- offset begin))) 255)
          (recur (+ index 1)))))))
(defn- encode [words [:list [:ref :linux.static.context/word]] grant :document bitmap :i64] :vector-i64
  (loop [offset 0 out (vector-alloc 0)]
    (if (= offset 1024) out
      (recur (+ offset 1) (vector-conj out
        (if (and (>= offset bitmap) (< offset (+ bitmap 32))) (grant-byte grant (- offset bitmap)) (word-byte words offset)))))))
(defn- failure [error :keyword] [:ref :linux.static.context/result]
  (record-new [:ref :linux.static.context/result] (vector-alloc 0) error))

(defn context-bytes [source-plan :document layout :document labels [:list [:ref :linux.static/label]]
                     bindings :document code-address :i64 code-length :i64] [:ref :linux.static.context/result]
  (let [error (configuration-error source-plan layout labels bindings code-address code-length)]
    (if (not= error :ok) (failure error)
      (let [words (data-words source-plan layout labels bindings code-address code-length)
            bitmap (i64-of (lookup (lookup source-plan :context-abi) :allow-bitmap-offset))
            error (words-error words bitmap)]
        (if (not= error :ok) (failure error)
          (record-new [:ref :linux.static.context/result] (encode words (lookup source-plan :grant) bitmap) :ok))))))
