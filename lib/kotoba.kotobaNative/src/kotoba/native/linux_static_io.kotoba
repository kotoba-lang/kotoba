;; Complete seven non-filesystem/non-spawn C3 handlers, both Linux ISAs.
;; Canonical source candidate; never grants authority or runs a hosted helper.
(ns kotoba.native.linux-static-io
  {:kotoba/export [routines state-offset literal register state-field label-address
                   operand-fragment decision-fragment syscall-fragment]}
  (:require [kotoba.native.linux-static-assembler :as asm]
            [kotoba.native.linux-static-strings :as strings])
  (:schemas
   {:linux.static.io/operand
    [:record :linux.static.io/operand [[:kind :keyword] [:reg :keyword] [:value :i64]]]
    :linux.static.io/config
    [:record :linux.static.io/config
     [[:isa :keyword] [:data :i64] [:buf-a :i64] [:buf-b :i64] [:probe :i64] [:refused :i64]
      [:intern [:list [:ref :linux.static/instruction]]]
      [:pair [:list [:ref :linux.static/instruction]]]]]
    :linux.static.io/result
    [:record :linux.static.io/result
     [[:code [:list [:ref :linux.static/instruction]]]
      [:start [:list [:ref :linux.static/instruction]]]
      [:bindings :document] [:externals :document] [:error :keyword]]]}))

(defn- empty-code [] [:list [:ref :linux.static/instruction]]
  (typed-list-new [:list [:ref :linux.static/instruction]]))

(defn- append [out [:list [:ref :linux.static/instruction]] op :keyword aux :keyword
               d :keyword s :keyword b :keyword i :keyword n :i64 target :keyword]
  [:list [:ref :linux.static/instruction]]
  (typed-list-conj [:list [:ref :linux.static/instruction]] out
    (asm/instruction op aux d s b i n target (vector-alloc 0))))

(defn- join [out [:list [:ref :linux.static/instruction]] code [:list [:ref :linux.static/instruction]]]
  [:list [:ref :linux.static/instruction]]
  (loop [index 0 current out]
    (if (>= index (vector-count code)) current
      (recur (+ index 1) (typed-list-conj [:list [:ref :linux.static/instruction]] current
                            (typed-list-nth [:list [:ref :linux.static/instruction]] code index))))))

(defn- tag [prefix :string suffix :string] :keyword
  (keyword-from-string (string-concat (string-concat "ls.io/" prefix) (string-concat "-" suffix))))
(defn- mark [out [:list [:ref :linux.static/instruction]] label :keyword]
  [:list [:ref :linux.static/instruction]] (append out :label :none :none :none :none :none 0 label))
(defn- li [out [:list [:ref :linux.static/instruction]] d :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (append out :li :none d :none :none :none n :none))
(defn- la [out [:list [:ref :linux.static/instruction]] d :keyword label :keyword]
  [:list [:ref :linux.static/instruction]] (append out :la :none d :none :none :none 0 label))
(defn- mov [out [:list [:ref :linux.static/instruction]] d :keyword s :keyword]
  [:list [:ref :linux.static/instruction]] (append out :mov :none d s :none :none 0 :none))
(defn- mem [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword base :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (append out op :none d :none base :none n :none))
(defn- byte-op [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword base :keyword i :keyword]
  [:list [:ref :linux.static/instruction]] (append out op :none d :none base i 0 :none))
(defn- alu [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword s :keyword]
  [:list [:ref :linux.static/instruction]] (append out :alu op d s :none :none 0 :none))
(defn- imm [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (append out :alui op d :none :none :none n :none))
(defn- unary [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword]
  [:list [:ref :linux.static/instruction]] (append out op :none d :none :none :none 0 :none))
(defn- shift [out [:list [:ref :linux.static/instruction]] op :keyword d :keyword n :i64]
  [:list [:ref :linux.static/instruction]] (append out op :none d :none :none :none n :none))
(defn- branch [out [:list [:ref :linux.static/instruction]] condition :keyword target :keyword]
  [:list [:ref :linux.static/instruction]]
  (append out (if (= condition :always) :b :bcc) condition :none :none :none :none 0 target))

(defn- offset [key :keyword] :i64
  (case key
    :pair-used 512 :pool-used 520 :zero 528 :cells 536 :bytes 544 :metered 552
    :code-base 560 :code-length 568 :pool-base 576 :argc 584 :argv 592 :sigaction 600
    :stack-t 632 :itoa 656 :envp 1024 :cwd-len 1032 :root-fd 1040 :last-mono 1048
    :carry-n 1056 :carry 1064 :dctx 1072 :dctx-fuel 1080 :ts 1088 :ts-nsec 1096
    :how 1104 :how-mode 1112 :how-resolve 1120 :id 1128 :rk 1136 :xk 1144
    :req 1152 :rp 1160 :rl 1168 :h 1176 :res 1184 :form 1192
    :fd 1200 :pfd 1208 :want 1216 :start 1224 :room 1232 :whole 1240
    :limit 1248 :cnt 1256 :tot 1264 :n1 1272 :x0 1280 :x1 1288
    :x2 1296 :x3 1304 :x4 1312 :x5 1320 :x6 1328 :len-a 1336
    :rel-a 1344 :len-c 1352 :rel-c 1360 :r-off 1368 :r-len 1376 :r-ok 1384
    :m-k 1392 :m-plen 1400 :m-pre 1408 :m-dfd 1416 :m-n 1424 :sp-count 1432
    :sp-plen 1440 :sp-nul 1448 :sp-slash 1456 :sp-prog 1464 :sp-envn 1472 :sp-pid 1480
    :sp-start 1488 :sp-total 1496 :sp-limit 1504 :sp-exit 1512 :sp-in-r 1520 :sp-in-w 1528
    :sp-out-r 1536 :sp-out-w 1544 :sp-st-r 1552 :sp-st-w 1560 :sp-dlen 1568 :sp-word 1576
    :root-real-len 1584 :ru-a 1592 :ru-c 1600
    :fs-frame 1608 :fs-tail 1616 :fs-tail-len 1624 :path-denied 1632 :fs-root-fd 1640
    :vector-used 1648 :vector-item-used 1656 :vector-capacity 1664
    :vector-item-capacity 1672 :vector-item-limit 1680
    :byte-value-limit 1688 :string-value-limit 1696
    :chunk-outer-offset 1704 :chunk-outer-count 1712 :chunk-total 1720
    :chunk-index 1728 :chunk-pool 1736 :chunk-copied 1744
    :out-active 1752 :out-parent 1760 :out-directory 1768 :out-file 1776
    :out-count 1784 :out-path-length 1792 :out-name-length 1800 :out-index 1808
    :out-failed 1816 :out-cleaning 1824 :out-probe 1832 :out-rmdir 1840
    :out-create 1848 :out-managed-member 1856 :out-message 1864
    :out-message-length 1872 :out-exit 1880 -1))

(defn- load [out [:list [:ref :linux.static/instruction]] d :keyword key :keyword]
  [:list [:ref :linux.static/instruction]] (mem out :ld d :s0 (offset key)))
(defn- store [out [:list [:ref :linux.static/instruction]] d :keyword key :keyword]
  [:list [:ref :linux.static/instruction]] (mem out :st d :s0 (offset key)))
(defn- lit [n :i64] [:ref :linux.static.io/operand]
  (record-new [:ref :linux.static.io/operand] :literal :none n))
(defn- reg [r :keyword] [:ref :linux.static.io/operand]
  (record-new [:ref :linux.static.io/operand] :register r 0))
(defn- field [key :keyword] [:ref :linux.static.io/operand]
  (record-new [:ref :linux.static.io/operand] :field :none (offset key)))

(defn- operand [out [:list [:ref :linux.static/instruction]] dst :keyword arg [:ref :linux.static.io/operand]]
  [:list [:ref :linux.static/instruction]]
  (case (record-get [:ref :linux.static.io/operand] arg :kind)
    :literal (li out dst (record-get [:ref :linux.static.io/operand] arg :value))
    :register (mov out dst (record-get [:ref :linux.static.io/operand] arg :reg))
    :field (mem out :ld dst :s0 (record-get [:ref :linux.static.io/operand] arg :value))
    :label (la out dst (record-get [:ref :linux.static.io/operand] arg :reg))
    (append out :invalid-operand :none :none :none :none :none 0 :none)))

(defn- hcall [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config] op :i64
              a [:ref :linux.static.io/operand] b [:ref :linux.static.io/operand]
              c [:ref :linux.static.io/operand] d [:ref :linux.static.io/operand]]
  [:list [:ref :linux.static/instruction]]
  (let [args (operand (operand (operand (operand (li out :ctx op) :a1 a) :a2 b) :a3 c) :a4 d)]
    (-> args (li :t1 9007199254740991) (store :t1 :dctx-fuel)
        (li :gctx (+ (record-get [:ref :linux.static.io/config] cfg :data) (offset :dctx)))
        (append :call :none :none :none :none :none 0 :ls.cap/h-decide) (mov :t0 :ret))))

(defn- syscall-number [isa :keyword call :keyword] :i64
  (case isa
    :x86_64 (case call
      :write 1 :rt-sigaction 13 :sigaltstack 131 :exit-group 231
      :read 0 :close 3 :fstat 5 :getdents64 217 :getcwd 79 :openat 257
      :openat2 437 :mkdirat 258 :unlinkat 263 :renameat2 316 :clock-gettime 228
      :pread64 17 :fchmod 91 :fsync 74 :getrandom 318 :pipe2 293 :clone 56 :dup3 292
      :close-range 436 :prctl 157 :fchdir 81 :execve 59 :wait4 61 :kill 62 :ppoll 271 :geteuid 107 -1)
    :aarch64 (case call
      :write 64 :rt-sigaction 134 :sigaltstack 132 :exit-group 94
      :read 63 :close 57 :fstat 80 :getdents64 61 :getcwd 17 :openat 56
      :openat2 437 :mkdirat 34 :unlinkat 35 :renameat2 276 :clock-gettime 113
      :pread64 67 :fchmod 52 :fsync 82 :getrandom 278 :pipe2 59 :clone 220 :dup3 24
      :close-range 436 :prctl 167 :fchdir 50 :execve 221 :wait4 260 :kill 129 :ppoll 73 :geteuid 175 -1)
    -1))

(defn- sys [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config] call :keyword
            a [:ref :linux.static.io/operand] b [:ref :linux.static.io/operand] c [:ref :linux.static.io/operand]]
  [:list [:ref :linux.static/instruction]]
  (let [args (operand (operand (operand out :p0 a) :p1 b) :p2 c)]
    (-> args (li :nr (syscall-number (record-get [:ref :linux.static.io/config] cfg :isa) call))
        (append :syscall :none :none :none :none :none 0 :none) (mov :t0 :ret))))

(defn- outcome [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config]
                prefix :string form :i64 stage :i64 retry :keyword negative :keyword named :keyword]
  [:list [:ref :linux.static/instruction]]
  (let [errno (-> out (store :t0 :x6) (li :t1 0) (imm :cmp :t0 0) (branch :ge (tag prefix "errno-ok"))
                  (mov :t1 :t0) (unary :neg :t1) (mark (tag prefix "errno-ok")))
        decided (hcall errno cfg 12 (lit form) (lit stage) (reg :t1) (lit 0))]
    (-> decided (imm :cmp :t0 3) (branch :eq (tag prefix "proceed"))
        (imm :cmp :t0 2) (branch :eq retry) (imm :cmp :t0 0) (branch :eq negative)
        (imm :cmp :t0 4) (branch :eq named) (branch :always :ls/bad)
        (mark (tag prefix "proceed")) (load :t0 :x6))))

(defn- copy [out [:list [:ref :linux.static/instruction]] prefix :string dst :keyword src :keyword n :keyword]
  [:list [:ref :linux.static/instruction]]
  (-> out (li :t0 0) (mark (tag prefix "copy")) (alu :cmp :t0 n) (branch :hs (tag prefix "copied"))
      (byte-op :ldb :t1 src :t0) (byte-op :stb :t1 dst :t0)
      (imm :add :t0 1) (branch :always (tag prefix "copy")) (mark (tag prefix "copied"))))

(defn- strlen [out [:list [:ref :linux.static/instruction]] prefix :string p :keyword n :keyword]
  [:list [:ref :linux.static/instruction]]
  (-> out (li n 0) (mark (tag prefix "strlen")) (byte-op :ldb :t0 p n)
      (imm :cmp :t0 0) (branch :eq (tag prefix "strlen-done"))
      (imm :add n 1) (branch :always (tag prefix "strlen")) (mark (tag prefix "strlen-done"))))

(defn- intern [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config]]
  [:list [:ref :linux.static/instruction]]
  (let [charge (-> (hcall out cfg 6 (field :pool-used) (reg :s2) (field :bytes) (lit 0))
                   (imm :cmp :t0 1) (branch :ne :ls/trap-bytes))]
    (-> charge (append :call :none :none :none :none :none 0 :ls.io/intern) (mov :t0 :ret))))

(defn- itoa [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config] prefix :string]
  [:list [:ref :linux.static/instruction]]
  (let [end (+ (record-get [:ref :linux.static.io/config] cfg :data) 688)]
    (-> out (li :s2 end) (mark (tag prefix "itoa"))
        (append :udiv10 :none :t1 :t1 :t3 :none 0 :none)
        (imm :add :t3 48) (imm :sub :s2 1) (li :t0 0) (byte-op :stb :t3 :s2 :t0)
        (imm :cmp :t1 0) (branch :ne (tag prefix "itoa"))
        (mov :s1 :s2) (li :s2 end) (alu :sub :s2 :s1))))

(defn- finish [out [:list [:ref :linux.static/instruction]]]
  [:list [:ref :linux.static/instruction]] (branch (store out :t0 :res) :always :ls.cap/finish))

(defn- parse-decimal [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config] prefix :string]
  [:list [:ref :linux.static/instruction]]
  (let [start (-> (hcall out cfg 4 (field :rl) (lit 0) (lit 0) (lit 0))
                  (imm :cmp :t0 1) (branch :ne :ls/bad) (li :s1 0) (li :s4 0)
                  (load :s2 :rp) (load :s3 :rl) (mark (tag prefix "decimal"))
                  (alu :cmp :s4 :s3) (branch :hs (tag prefix "decimal-done")) (byte-op :ldb :t1 :s2 :s4))]
    (-> (hcall start cfg 3 (reg :s1) (reg :t1) (lit 0) (lit 0))
        (imm :cmp :t0 -2) (branch :eq :ls/bad) (mov :s1 :t0) (imm :add :s4 1)
        (branch :always (tag prefix "decimal")) (mark (tag prefix "decimal-done")))))

(defn- write-all [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config] prefix :string]
  [:list [:ref :linux.static/instruction]]
  (let [start (-> out (li :s3 0) (mark (tag prefix "write"))
                  (alu :cmp :s3 :s2) (branch :hs (tag prefix "written"))
                  (mov :s4 :s1) (alu :add :s4 :s3) (mov :t2 :s2) (alu :sub :t2 :s3))
        sent (sys start cfg :write (field :fd) (reg :s4) (reg :t2))
        checked (outcome sent cfg prefix 30 3 (tag prefix "write") :ls/bad :ls/bad)]
    (-> checked (imm :cmp :t0 0) (branch :eq :ls/bad)
        (mov :t1 :s2) (alu :sub :t1 :s3) (alu :cmp :t0 :t1) (branch :hi :ls/bad)
        (alu :add :s3 :t0) (branch :always (tag prefix "write")) (mark (tag prefix "written")))))

(defn- io-write [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config]
                 fd :i64 label :keyword prefix :string]
  [:list [:ref :linux.static/instruction]]
  (let [start (-> out (mark label) (li :t0 fd) (store :t0 :fd) (load :s1 :rp) (load :s2 :rl))
        written (load (write-all start cfg prefix) :t1 :rl)]
    (finish (intern (itoa written cfg prefix) cfg))))

(defn- cli-args [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config]]
  [:list [:ref :linux.static/instruction]]
  (let [start (-> out (mark :ls.cap/cli-args) (load :t0 :rl) (imm :cmp :t0 0) (branch :eq :ls.io/argc))
        parsed (-> (parse-decimal start cfg "args") (load :t0 :argc) (imm :sub :t0 1)
                   (alu :cmp :s1 :t0) (branch :ge :ls.io/arg-past)
                   (imm :add :s1 1) (shift :shli :s1 3) (load :t0 :argv) (alu :add :t0 :s1) (mem :ld :s1 :t0 0))
        found (finish (intern (strlen parsed "args" :s1 :s2) cfg))
        empty (finish (intern (-> found (mark :ls.io/arg-past) (la :s1 :ls.io/empty) (li :s2 0)) cfg))
        count (-> empty (mark :ls.io/argc) (load :t1 :argc) (imm :sub :t1 1))]
    (finish (intern (itoa count cfg "argc") cfg))))

(defn- env-read [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config]]
  [:list [:ref :linux.static/instruction]]
  (let [scan (-> out (mark :ls.cap/env-read) (load :s2 :rp) (load :s3 :rl) (li :t2 0) (li :t0 0)
                 (mark :ls.io/env-equals) (alu :cmp :t0 :s3) (branch :hs :ls.io/env-name-done)
                 (byte-op :ldb :t1 :s2 :t0) (imm :add :t0 1) (imm :cmp :t1 61) (branch :ne :ls.io/env-equals)
                 (li :t2 1) (mark :ls.io/env-name-done))
        walk (-> (hcall scan cfg 5 (reg :s3) (reg :t2) (lit 0) (lit 0))
                 (imm :cmp :t0 1) (branch :ne :ls/bad) (load :s4 :envp)
                 (mark :ls.io/env-walk) (mem :ld :s1 :s4 0) (imm :cmp :s1 0) (branch :eq :ls.io/env-unset)
                 (li :t0 0) (mark :ls.io/env-compare) (alu :cmp :t0 :s3) (branch :hs :ls.io/env-compared)
                 (byte-op :ldb :t1 :s1 :t0) (byte-op :ldb :t2 :s2 :t0)
                 (alu :cmp :t1 :t2) (branch :ne :ls.io/env-next) (imm :add :t0 1) (branch :always :ls.io/env-compare)
                 (mark :ls.io/env-compared) (byte-op :ldb :t1 :s1 :t0) (imm :cmp :t1 61) (branch :ne :ls.io/env-next)
                 (alu :add :s1 :t0) (imm :add :s1 1))
        found (finish (intern (strlen walk "env" :s1 :s2) cfg))
        unset (-> found (mark :ls.io/env-next) (imm :add :s4 8) (branch :always :ls.io/env-walk)
                  (mark :ls.io/env-unset) (la :s1 :ls.io/empty) (li :s2 0))]
    (finish (intern unset cfg))))

(defn- clock [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config]]
  [:list [:ref :linux.static/instruction]]
  (let [wall (-> out (mark :ls.cap/clock) (load :s2 :rp) (load :s3 :rl)
                 (imm :cmp :s3 4) (branch :ne :ls.io/not-wall) (la :t2 :ls.io/wall) (li :t0 0)
                 (mark :ls.io/wall-compare) (imm :cmp :t0 4) (branch :hs :ls.io/wall-form)
                 (byte-op :ldb :t1 :s2 :t0) (byte-op :ldb :t3 :t2 :t0) (alu :cmp :t1 :t3) (branch :ne :ls/bad)
                 (imm :add :t0 1) (branch :always :ls.io/wall-compare))
        mono (-> wall (mark :ls.io/not-wall) (imm :cmp :s3 9) (branch :ne :ls/bad)
                 (la :t2 :ls.io/monotonic) (li :t0 0) (mark :ls.io/mono-compare)
                 (imm :cmp :t0 9) (branch :hs :ls.io/mono-form)
                 (byte-op :ldb :t1 :s2 :t0) (byte-op :ldb :t3 :t2 :t0) (alu :cmp :t1 :t3) (branch :ne :ls/bad)
                 (imm :add :t0 1) (branch :always :ls.io/mono-compare)
                 (mark :ls.io/wall-form) (li :s1 1) (branch :always :ls.io/clock-form)
                 (mark :ls.io/mono-form) (li :s1 2) (mark :ls.io/clock-form) (mov :s2 :s1) (imm :sub :s2 1))
        got (-> (sys mono cfg :clock-gettime (reg :s2) (lit (+ (record-get [:ref :linux.static.io/config] cfg :data) (offset :ts))) (lit 0))
                (imm :cmp :t0 0) (branch :ne :ls/bad))
        millis (-> (hcall got cfg 10 (reg :s1) (field :ts) (field :ts-nsec) (lit 0))
                   (imm :cmp :t0 -1) (branch :eq :ls/bad) (mov :s4 :t0)
                   (imm :cmp :s1 2) (branch :ne :ls.io/clock-not-mono))
        monotone (-> (hcall millis cfg 11 (field :last-mono) (reg :s4) (lit 0) (lit 0))
                     (imm :cmp :t0 1) (branch :ne :ls/bad) (store :s4 :last-mono)
                     (mark :ls.io/clock-not-mono) (mov :t1 :s4))]
    (finish (intern (itoa monotone cfg "clock") cfg))))

(defn- read-plan [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config]]
  [:list [:ref :linux.static/instruction]]
  (let [first (-> out (mark :ls.cap/io-read) (li :s1 0) (li :t0 1) (store :t0 :whole)
                  (load :t0 :rl) (imm :cmp :t0 0) (branch :eq :ls.io/read-whole)
                  (li :t0 0) (store :t0 :whole))
        parsed (-> (parse-decimal first cfg "read") (mark :ls.io/read-whole) (store :s1 :limit)
                   (load :t0 :pool-used) (store :t0 :start) (load :t1 :bytes)
                   (alu :cmp :t0 :t1) (branch :hi :ls/trap-bytes) (alu :sub :t1 :t0) (store :t1 :room))]
    (-> (hcall parsed cfg 7 (field :whole) (field :limit) (field :room) (lit 0))
        (imm :cmp :t0 0) (branch :lt :ls/bad) (load :t1 :room) (alu :cmp :t0 :t1) (branch :hi :ls/trap-bytes)
        (store :t0 :want) (li :s2 0))))

(defn- read-loop [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config]]
  [:list [:ref :linux.static/instruction]]
  (let [data (record-get [:ref :linux.static.io/config] cfg :data)
        carry (-> out (load :t1 :carry-n) (imm :cmp :t1 0) (branch :eq :ls.io/read-no-carry)
                  (imm :cmp :t1 0) (branch :lt :ls/bad) (imm :cmp :t1 3) (branch :hi :ls/bad)
                  (alu :cmp :t1 :t0) (branch :hi :ls/bad) (load :t2 :pool-base) (load :t0 :start) (alu :add :t2 :t0)
                  (li :t3 (+ data (offset :carry))) (mov :a1 :t1))
        copied (-> (copy carry "read-carry" :t2 :t3 :a1)
                   (mov :s2 :a1) (li :t0 0) (store :t0 :carry-n) (mark :ls.io/read-no-carry)
                   (mark :ls.io/read-loop) (load :t0 :want) (alu :cmp :s2 :t0) (branch :hs :ls.io/read-done)
                   (load :s3 :pool-base) (load :t1 :start) (alu :add :s3 :t1) (alu :add :s3 :s2)
                   (mov :s4 :t0) (alu :sub :s4 :s2))
        got (outcome (sys copied cfg :read (lit 0) (reg :s3) (reg :s4)) cfg "read-data" 31 3 :ls.io/read-loop :ls/bad :ls/bad)]
    (-> got (imm :cmp :t0 0) (branch :eq :ls.io/read-done) (alu :cmp :t0 :s4) (branch :hi :ls/bad)
        (alu :add :s2 :t0) (load :t1 :whole) (imm :cmp :t1 1) (branch :eq :ls.io/read-loop)
        (mark :ls.io/read-done))))

(defn- read-probe [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config]]
  [:list [:ref :linux.static/instruction]]
  (let [needed (-> (hcall out cfg 8 (field :whole) (reg :s2) (field :room) (lit 0))
                   (imm :cmp :t0 1) (branch :ne :ls.io/read-no-probe) (mark :ls.io/read-probe))
        got (outcome (sys needed cfg :read (lit 0) (lit (record-get [:ref :linux.static.io/config] cfg :probe)) (lit 1))
              cfg "read-probe" 31 3 :ls.io/read-probe :ls/bad :ls/bad)]
    (-> got (imm :cmp :t0 0) (branch :ne :ls/bad) (mark :ls.io/read-no-probe))))

(defn- read-tail [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config]]
  [:list [:ref :linux.static/instruction]]
  (let [first (-> out (load :t0 :whole) (imm :cmp :t0 1) (branch :eq :ls.io/read-tail)
                  (imm :cmp :s2 0) (branch :eq :ls.io/read-tail)
                  (load :s3 :pool-base) (load :t0 :start) (alu :add :s3 :t0) (li :s1 0)
                  (mark :ls.io/read-back) (imm :cmp :s1 3) (branch :hs :ls.io/read-back-done)
                  (alu :cmp :s1 :s2) (branch :hs :ls.io/read-back-done)
                  (mov :t1 :s2) (imm :sub :t1 1) (alu :sub :t1 :s1) (byte-op :ldb :t0 :s3 :t1)
                  (imm :and :t0 192) (imm :cmp :t0 128) (branch :ne :ls.io/read-back-done)
                  (imm :add :s1 1) (branch :always :ls.io/read-back)
                  (mark :ls.io/read-back-done) (li :t2 0) (alu :cmp :s1 :s2) (branch :hs :ls.io/read-held)
                  (mov :t1 :s2) (imm :sub :t1 1) (alu :sub :t1 :s1) (byte-op :ldb :t2 :s3 :t1) (mark :ls.io/read-held))
        held (-> (hcall first cfg 9 (reg :s1) (reg :t2) (reg :s2) (lit 0))
                 (imm :cmp :t0 0) (branch :eq :ls.io/read-tail) (alu :cmp :t0 :s2) (branch :hs :ls/bad)
                 (imm :cmp :t0 3) (branch :hi :ls/bad) (store :t0 :carry-n) (alu :sub :s2 :t0)
                 (mov :t2 :s3) (alu :add :t2 :s2)
                 (li :t3 (+ (record-get [:ref :linux.static.io/config] cfg :data) (offset :carry))) (mov :a1 :t0))
        tail (-> (copy held "read-hold" :t3 :t2 :a1) (mark :ls.io/read-tail)
                 (load :s3 :start) (mov :t0 :s3) (alu :add :t0 :s2) (store :t0 :pool-used)
                 (mov :s4 :s3) (unary :not :s4))]
    (finish (join tail (record-get [:ref :linux.static.io/config] cfg :pair)))))

(defn- entropy [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config]]
  [:list [:ref :linux.static/instruction]]
  (let [start (store (parse-decimal (mark out :ls.cap/entropy) cfg "entropy") :s1 :x0)
        allowed (-> (hcall start cfg 31 (reg :s1) (lit 0) (lit 0) (lit 0))
                    (imm :cmp :t0 1) (branch :ne :ls/bad) (load :t0 :x0) (imm :cmp :t0 2048) (branch :hi :ls/bad)
                    (li :s2 0) (mark :ls.io/random-loop) (load :t0 :x0) (alu :cmp :s2 :t0) (branch :hs :ls.io/random-done)
                    (li :s3 (record-get [:ref :linux.static.io/config] cfg :buf-b)) (alu :add :s3 :s2)
                    (mov :s4 :t0) (alu :sub :s4 :s2))
        got (outcome (sys allowed cfg :getrandom (reg :s3) (reg :s4) (lit 0)) cfg "entropy" 40 3
              :ls.io/random-loop :ls/bad :ls.io/entropy-unavailable)
        high (-> got (imm :cmp :t0 0) (branch :le :ls/bad) (alu :cmp :t0 :s4) (branch :hi :ls/bad)
                 (alu :add :s2 :t0) (branch :always :ls.io/random-loop) (mark :ls.io/random-done)
                 (li :s3 0) (mark :ls.io/hex-loop) (load :t0 :x0) (alu :cmp :s3 :t0) (branch :hs :ls.io/hex-done)
                 (li :t1 (record-get [:ref :linux.static.io/config] cfg :buf-b)) (byte-op :ldb :t2 :t1 :s3) (shift :shri :t2 4))
        low (-> (hcall high cfg 32 (reg :t2) (lit 0) (lit 0) (lit 0))
                (li :t1 (record-get [:ref :linux.static.io/config] cfg :buf-a))
                (mov :t2 :s3) (shift :shli :t2 1) (byte-op :stb :t0 :t1 :t2)
                (li :t1 (record-get [:ref :linux.static.io/config] cfg :buf-b)) (byte-op :ldb :t2 :t1 :s3) (imm :and :t2 15))
        hex (-> (hcall low cfg 32 (reg :t2) (lit 0) (lit 0) (lit 0))
                (li :t1 (record-get [:ref :linux.static.io/config] cfg :buf-a))
                (mov :t2 :s3) (shift :shli :t2 1) (imm :add :t2 1) (byte-op :stb :t0 :t1 :t2)
                (imm :add :s3 1) (branch :always :ls.io/hex-loop) (mark :ls.io/hex-done)
                (li :s1 (record-get [:ref :linux.static.io/config] cfg :buf-a)) (load :s2 :x0) (shift :shli :s2 1))]
    (finish (intern hex cfg))))

(defn- data-bytes [out [:list [:ref :linux.static/instruction]] label :keyword text :string]
  [:list [:ref :linux.static/instruction]]
  (let [input (string-to-utf8 text)
        bytes (loop [index 0 data (vector-alloc 0)]
                (if (>= index (bytes-count input)) data
                  (recur (+ index 1) (vector-conj data (bytes-at input index)))))]
    (typed-list-conj [:list [:ref :linux.static/instruction]] (mark out label)
      (asm/instruction :bytes :none :none :none :none :none 0 :none bytes))))

(defn- entropy-message [] :string
  "KEXE_TRAP {:kind :capability :capability :entropy/draw :reason :entropy/unavailable}\n")

(defn- constants [out [:list [:ref :linux.static/instruction]] cfg [:ref :linux.static.io/config]]
  [:list [:ref :linux.static/instruction]]
  (let [body (join (-> out (mark :ls.io/intern) (append :save-lr :none :none :none :none :none 0 :none))
                  (record-get [:ref :linux.static.io/config] cfg :intern))
        returned (-> body (append :restore-lr :none :none :none :none :none 0 :none)
                     (mov :ret :t0) (append :ret :none :none :none :none :none 0 :none))
        refusal (-> returned (mark :ls.io/entropy-unavailable) (la :p1 :ls.io/entropy-message)
                    (li :p2 (bytes-count (string-to-utf8 (entropy-message))))
                    (li :t5 (record-get [:ref :linux.static.io/config] cfg :refused)) (branch :always :ls/trap-exit))]
    (append (data-bytes (data-bytes (data-bytes (data-bytes refusal :ls.io/empty "")
                                      :ls.io/wall "wall") :ls.io/monotonic "monotonic")
               :ls.io/entropy-message (entropy-message))
      :align :none :none :none :none :none 16 :none)))

(defn- start [data :i64] [:list [:ref :linux.static/instruction]]
  (-> (empty-code) (li :s0 data) (load :t0 :argc) (imm :cmp :t0 0) (branch :lt :ls/bad)
      (li :t1 1152921504606846974) (alu :cmp :t0 :t1) (branch :hi :ls/bad)
      (imm :add :t0 1) (shift :shli :t0 3) (load :t2 :argv)
      (imm :cmp :t2 0) (branch :le :ls/bad) (li :t1 9223372036854775807)
      (alu :sub :t1 :t2) (alu :cmp :t0 :t1) (branch :hi :ls/bad)
      (alu :add :t2 :t0) (store :t2 :envp)
      (li :t0 11) (store :t0 :dctx) (li :t0 -1) (store :t0 :last-mono)))

(defn- lookup [m :document key :keyword] :document
  (if (not= (document-kind m) :map) (document-null)
    (loop [index 0]
      (if (>= index (document-count m)) (document-null)
        (let [pair (option-value-of [:option :document] (document-map-entry-at m index) (document-null))
              k (option-value-of [:option :document] (document-vector-at pair 0) (document-null))]
          (if (document-equal? k (document-keyword key))
            (option-value-of [:option :document] (document-vector-at pair 1) (document-null)) (recur (+ index 1))))))))
(defn- i64-of [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) -1))

(defn- region? [base :i64 size :i64 data :i64 end :i64] :bool
  (and (>= base data) (<= base end) (= (bit-and base 15) 0) (<= size (- end base))))

(defn- configuration-error [isa :keyword source-plan :document layout :document] :keyword
  (let [data (i64-of (lookup layout :data)) memory (i64-of (lookup layout :memory-size))]
    (cond
      (not (or (= isa :x86_64) (= isa :aarch64))) :unknown-isa
      (not (document-equal? (lookup source-plan :handlers?) (document-bool true))) :handlers-not-planned
      (not= (document-kind (lookup (lookup source-plan :exit-codes) :capability/refused)) :i64) :refused-exit-code
      (or (<= data 0) (not= (bit-and data 4095) 0) (< memory 4096)
          (> memory (- 9223372036854775807 data))) :layout-input
      :else (let [end (+ data memory)]
              (if (and (region? (i64-of (lookup layout :buf-a)) 4096 (+ data 4096) end)
                       (region? (i64-of (lookup layout :buf-b)) 4096 (+ data 4096) end)
                       (region? (i64-of (lookup layout :probe)) 16 (+ data 4096) end)) :ok :scratch-region)))))

(defn- failure [reason :keyword] [:ref :linux.static.io/result]
  (record-new [:ref :linux.static.io/result] (empty-code) (empty-code) (document-map) (document-set) reason))

(defn- bindings [] :document
  (document-map (document-i64 1) (document-keyword :ls.cap/io-write)
                (document-i64 2) (document-keyword :ls.cap/io-write-error)
                (document-i64 3) (document-keyword :ls.cap/io-read)
                (document-i64 4) (document-keyword :ls.cap/cli-args)
                (document-i64 5) (document-keyword :ls.cap/env-read)
                (document-i64 6) (document-keyword :ls.cap/clock)
                (document-i64 9) (document-keyword :ls.cap/entropy)))

(defn state-offset [key :keyword] :i64 (offset key))
(defn literal [n :i64] [:ref :linux.static.io/operand] (lit n))
(defn register [r :keyword] [:ref :linux.static.io/operand] (reg r))
(defn state-field [key :keyword] [:ref :linux.static.io/operand]
  (let [n (offset key)]
    (record-new [:ref :linux.static.io/operand] (if (< n 0) :invalid :field) :none n)))
(defn label-address [label :keyword] [:ref :linux.static.io/operand]
  (record-new [:ref :linux.static.io/operand] :label label 0))
(defn operand-fragment [out [:list [:ref :linux.static/instruction]] dst :keyword arg [:ref :linux.static.io/operand]]
  [:list [:ref :linux.static/instruction]] (operand out dst arg))

;; Low-level source builders for the other canonical handler modules.
;; Their caller owns admitted memory, sealed decision targets, argument moves
;; and matching ISA. Unknown decisions/syscalls produce unassemblable IR.
(defn decision-fragment [out [:list [:ref :linux.static/instruction]] data :i64 target :keyword
                         a [:ref :linux.static.io/operand] b [:ref :linux.static.io/operand]
                         c [:ref :linux.static.io/operand] d [:ref :linux.static.io/operand]
                         e [:ref :linux.static.io/operand]]
  [:list [:ref :linux.static/instruction]]
  (if (not (or (= target :ls.cap/c1-cap) (= target :ls.cap/c1-decide) (= target :ls.cap/h-decide)))
    (append out :unknown-decision :none :none :none :none :none 0 :none)
    (let [args (operand (operand (operand (operand (operand out :ctx a) :a1 b) :a2 c) :a3 d) :a4 e)]
      (-> args (li :t1 9007199254740991) (store :t1 :dctx-fuel) (li :gctx (+ data (offset :dctx)))
          (append :call :none :none :none :none :none 0 target) (mov :t0 :ret)))))

(defn syscall-fragment [out [:list [:ref :linux.static/instruction]] isa :keyword call :keyword
                        a [:ref :linux.static.io/operand] b [:ref :linux.static.io/operand]
                        c [:ref :linux.static.io/operand] d [:ref :linux.static.io/operand]
                        e [:ref :linux.static.io/operand]]
  [:list [:ref :linux.static/instruction]]
  (let [nr (syscall-number isa call)]
    (if (< nr 0) (append out :unknown-syscall :none :none :none :none :none 0 :none)
      (let [args (operand (operand (operand (operand (operand out :p0 a) :p1 b) :p2 c) :p3 d) :p4 e)]
        (-> args (li :nr nr) (append :syscall :none :none :none :none :none 0 :none) (mov :t0 :ret))))))

(defn routines [isa :keyword source-plan :document layout :document] [:ref :linux.static.io/result]
  (let [error (configuration-error isa source-plan layout)]
    (if (not= error :ok) (failure error)
      (let [context (lookup source-plan :context-abi)
            interned (strings/intern-string-fragment context "io-intern")
            pair (strings/pool-pair-fragment context)]
        (cond
          (not= (record-get [:ref :linux.static.strings/result] interned :error) :ok)
          (failure (record-get [:ref :linux.static.strings/result] interned :error))
          (not= (record-get [:ref :linux.static.strings/result] pair :error) :ok)
          (failure (record-get [:ref :linux.static.strings/result] pair :error))
          :else
          (let [data (i64-of (lookup layout :data))
                cfg (record-new [:ref :linux.static.io/config] isa data
                      (i64-of (lookup layout :buf-a)) (i64-of (lookup layout :buf-b)) (i64-of (lookup layout :probe))
                      (i64-of (lookup (lookup source-plan :exit-codes) :capability/refused))
                      (record-get [:ref :linux.static.strings/result] interned :code)
                      (record-get [:ref :linux.static.strings/result] pair :code))
                aligned (append (empty-code) :align :none :none :none :none :none 16 :none)
                writes (io-write (io-write aligned cfg 1 :ls.cap/io-write "stdout") cfg 2 :ls.cap/io-write-error "stderr")
                read (read-tail (read-probe (read-loop (read-plan writes cfg) cfg) cfg) cfg)
                code (constants (entropy (clock (env-read (cli-args read cfg) cfg) cfg) cfg) cfg)]
            (record-new [:ref :linux.static.io/result] code (start data) (bindings)
              (document-set (document-keyword :ls.cap/h-decide) (document-keyword :ls.cap/finish)
                (document-keyword :ls/bad) (document-keyword :ls/trap-cells)
                (document-keyword :ls/trap-bytes) (document-keyword :ls/trap-exit)) :ok)))))))
