;; Canonical typed port of linux_static.cljk's complete register-IR assembler.
;; Pure source candidate: no hosted encoder, FFI, C loader or assembler import.
;; Native admission, byte parity and packager integration remain unqualified.
(ns kotoba.native.linux-static-assembler
  {:kotoba/export [instruction label instruction-size assemble]}
  (:schemas
   {:linux.static/instruction
    [:record :linux.static/instruction
     [[:op :keyword] [:aux :keyword] [:d :keyword] [:s :keyword]
      [:b :keyword] [:i :keyword] [:n :i64] [:label :keyword]
      [:data :vector-i64]]]
    :linux.static/label
    [:record :linux.static/label [[:name :keyword] [:address :i64]]]
    :linux.static/layout
    [:record :linux.static/layout
     [[:labels [:list [:ref :linux.static/label]]] [:end :i64]
      [:error :keyword] [:at :i64]]]
    :linux.static/result
    [:record :linux.static/result
     [[:bytes :vector-i64] [:labels [:list [:ref :linux.static/label]]]
      [:error :keyword] [:at :i64]]]}))

(defn instruction [op :keyword aux :keyword d :keyword s :keyword
                   b :keyword i :keyword n :i64 target :keyword data :vector-i64]
  [:ref :linux.static/instruction]
  (record-new [:ref :linux.static/instruction] op aux d s b i n target data))

(defn label [name :keyword address :i64] [:ref :linux.static/label]
  (record-new [:ref :linux.static/label] name address))

(defn- layout-result [labels [:list [:ref :linux.static/label]] end :i64
                      error :keyword at :i64] [:ref :linux.static/layout]
  (record-new [:ref :linux.static/layout] labels end error at))

(defn- result [bytes :vector-i64 labels [:list [:ref :linux.static/label]]
               error :keyword at :i64] [:ref :linux.static/result]
  (record-new [:ref :linux.static/result] bytes labels error at))

(defn- failure [labels [:list [:ref :linux.static/label]] error :keyword at :i64]
  [:ref :linux.static/result]
  (result (vector-alloc 0) labels error at))

(defn- register [isa :keyword name :keyword] :i64
  (if (= isa :x86_64)
    (case name
      :ctx 7 :a1 6 :a2 2 :a3 1 :a4 8
      :t0 0 :t1 10 :t2 11 :t3 9 :t4 3 :t5 12 :t6 13 :t7 14 :t8 15
      :gctx 9 :nr 0 :p0 7 :p1 6 :p2 2 :p3 10 :p4 8 :ret 0
      :s0 3 :s1 12 :s2 13 :s3 14 :s4 15 -1)
    (if (= isa :aarch64)
      (case name
        :ctx 0 :a1 1 :a2 2 :a3 3 :a4 4
        :t0 9 :t1 10 :t2 11 :t3 12 :t4 13 :t5 14 :t6 15 :t7 5 :t8 6
        :gctx 7 :nr 8 :p0 0 :p1 1 :p2 2 :p3 3 :p4 4 :ret 0
        :s0 19 :s1 20 :s2 21 :s3 22 :s4 23 -1)
      -1)))

(defn- x86-condition [condition :keyword] :i64
  (case condition :eq 4 :ne 5 :lo 2 :hs 3 :ls 6 :hi 7
        :lt 12 :ge 13 :le 14 :gt 15 -1))

(defn- a64-condition [condition :keyword] :i64
  (case condition :eq 0 :ne 1 :hs 2 :lo 3 :hi 8 :ls 9
        :ge 10 :lt 11 :gt 12 :le 13 -1))

(defn- x86-alu [op :keyword] :i64
  (case op :add 0x01 :sub 0x29 :and 0x21 :or 0x09 :cmp 0x39 -1))

(defn- x86-alu-ext [op :keyword] :i64
  (case op :add 0 :or 1 :and 4 :sub 5 :cmp 7 -1))

(defn- a64-alu [op :keyword] :i64
  (case op :add 0x8b000000 :sub 0xcb000000 :and 0x8a000000 :or 0xaa000000 -1))

(defn- small-a64-immediate? [op :keyword n :i64] :bool
  (and (or (= op :add) (= op :sub) (= op :cmp)) (>= n 0) (<= n 4095)))

(defn instruction-size [isa :keyword ins [:ref :linux.static/instruction]] :i64
  (let [op (record-get [:ref :linux.static/instruction] ins :op)
        aux (record-get [:ref :linux.static/instruction] ins :aux)
        n (record-get [:ref :linux.static/instruction] ins :n)]
    (cond
      (not (or (= isa :x86_64) (= isa :aarch64))) -1
      (= op :bytes) (vector-count (record-get [:ref :linux.static/instruction] ins :data))
      (or (= op :label) (= op :align)) 0
      (= isa :x86_64)
      (case op
        :li 10 :la 7 :mov 3
        :ld (+ 7 (if (= 4 (bit-and (register isa (record-get [:ref :linux.static/instruction] ins :b)) 7)) 1 0))
        :st (+ 7 (if (= 4 (bit-and (register isa (record-get [:ref :linux.static/instruction] ins :b)) 7)) 1 0))
        :ldb 6 :stb 5 :alu 3 :alui 7 :shli 4 :shri 4 :not 3 :neg 3
        :bcc 6 :b 5 :call 5 :ret 1 :syscall 2 :trap 2
        :push (if (>= (register isa (record-get [:ref :linux.static/instruction] ins :d)) 8) 2 1)
        :pop (if (>= (register isa (record-get [:ref :linux.static/instruction] ins :d)) 8) 2 1)
        :ld-sp 8 :lea-sp 8 :udiv10 24 :save-lr 0 :restore-lr 0 -1)
      (= isa :aarch64)
      (case op
        :li 16 :la 4 :mov 4 :ld 4 :st 4 :ldb 4 :stb 4 :alu 4
        :alui (if (small-a64-immediate? aux n) 4 20)
        :shli 4 :shri 4 :not 4 :neg 4 :bcc 4 :b 4 :call 4
        :ret 4 :syscall 4 :trap 4 :push 4 :pop 4 :ld-sp 4 :lea-sp 4
        :udiv10 16 :save-lr 4 :restore-lr 4 -1)
      :else -1)))

(defn- valid-bytes? [data :vector-i64] :bool
  (loop [index 0]
    (if (>= index (vector-count data)) true
      (let [value (vector-at data index)]
        (if (or (< value 0) (> value 255)) false (recur (+ index 1)))))))

(defn- signed32? [n :i64] :bool (and (>= n -2147483648) (<= n 2147483647)))

(defn- word32? [n :i64] :bool (and (>= n -2147483648) (<= n 4294967295)))

(defn- scaled-a64-offset? [n :i64] :bool
  (and (>= n 0) (<= n 32760) (= (bit-and n 7) 0)))

(defn- operand-problem [isa :keyword ins [:ref :linux.static/instruction]] :keyword
  (let [op (record-get [:ref :linux.static/instruction] ins :op)
        aux (record-get [:ref :linux.static/instruction] ins :aux)
        d (register isa (record-get [:ref :linux.static/instruction] ins :d))
        s (register isa (record-get [:ref :linux.static/instruction] ins :s))
        b (register isa (record-get [:ref :linux.static/instruction] ins :b))
        i (register isa (record-get [:ref :linux.static/instruction] ins :i))
        n (record-get [:ref :linux.static/instruction] ins :n)
        uses-d (not (or (= op :label) (= op :align) (= op :bytes)
                        (= op :bcc) (= op :b) (= op :call) (= op :ret)
                        (= op :syscall) (= op :trap) (= op :save-lr) (= op :restore-lr)))
        uses-s (or (= op :mov) (= op :alu) (= op :udiv10))
        uses-b (or (= op :ld) (= op :st) (= op :ldb) (= op :stb) (= op :udiv10))]
    (cond
      (< (instruction-size isa ins) 0) :unknown-op
      (or (and uses-d (< d 0)) (and uses-s (< s 0)) (and uses-b (< b 0))
          (and (or (= op :ldb) (= op :stb)) (< i 0))) :unknown-register
      (and (or (= op :alu) (= op :alui)) (< (x86-alu aux) 0)) :unknown-alu
      (and (= op :bcc) (< (x86-condition aux) 0)) :unknown-condition
      (and (= op :align) (< n 1)) :invalid-alignment
      (and (= op :bytes) (not (valid-bytes? (record-get [:ref :linux.static/instruction] ins :data)))) :invalid-byte
      (and (or (= op :shli) (= op :shri)) (or (< n 0) (> n 63))) :invalid-immediate
      (and (= isa :x86_64) (= op :alui) (not (word32? n))) :invalid-immediate
      (and (= isa :x86_64) (or (= op :ld) (= op :st) (= op :ld-sp) (= op :lea-sp))
           (not (signed32? n))) :invalid-immediate
      (and (= isa :aarch64) (or (= op :ld) (= op :st) (= op :ld-sp))
           (not (scaled-a64-offset? n))) :invalid-immediate
      (and (= isa :aarch64) (= op :lea-sp) (or (< n 0) (> n 4095))) :invalid-immediate
      :else :ok)))

(defn- label-index [labels [:list [:ref :linux.static/label]] name :keyword] :i64
  (loop [index 0]
    (if (>= index (vector-count labels)) -1
      (if (= name (record-get [:ref :linux.static/label]
                             (typed-list-nth [:list [:ref :linux.static/label]] labels index) :name))
        index (recur (+ index 1))))))

(defn- external-problem [labels [:list [:ref :linux.static/label]]] :i64
  (loop [index 0]
    (if (>= index (vector-count labels)) -1
      (let [item (typed-list-nth [:list [:ref :linux.static/label]] labels index)]
        (if (or (< (record-get [:ref :linux.static/label] item :address) 0)
                (not= index (label-index labels (record-get [:ref :linux.static/label] item :name))))
          index (recur (+ index 1)))))))

(defn- padding [pc :i64 alignment :i64] :i64
  (let [remainder (- pc (* (quot pc alignment) alignment))]
    (if (= remainder 0) 0 (- alignment remainder))))

(defn- layout [isa :keyword base :i64 limit :i64
                items [:list [:ref :linux.static/instruction]]
                external [:list [:ref :linux.static/label]]]
  [:ref :linux.static/layout]
  (loop [index 0 pc base labels external]
    (if (>= index (vector-count items)) (layout-result labels pc :ok -1)
      (let [ins (typed-list-nth [:list [:ref :linux.static/instruction]] items index)
            problem (operand-problem isa ins)
            op (record-get [:ref :linux.static/instruction] ins :op)
            target (record-get [:ref :linux.static/instruction] ins :label)]
        (if (not= problem :ok) (layout-result labels pc problem index)
          (let [size (if (= op :align)
                       (padding pc (record-get [:ref :linux.static/instruction] ins :n))
                       (instruction-size isa ins))]
            (cond
              (> size (- limit (- pc base))) (layout-result labels pc :output-limit index)
              (and (= isa :aarch64) (not (or (= op :bytes) (= op :align) (= op :label)))
                   (not= (bit-and pc 3) 0))
              (layout-result labels pc :instruction-alignment index)
              (and (= op :label) (>= (label-index labels target) 0))
              (layout-result labels pc :duplicate-label index)
              :else
              (recur (+ index 1) (+ pc size)
                     (if (= op :label)
                       (typed-list-conj [:list [:ref :linux.static/label]] labels (label target pc))
                       labels)))))))))

(defn- append-le [out :vector-i64 value :i64 width :i64] :vector-i64
  (loop [index 0 bits value bytes out]
    (if (>= index width) bytes
      (recur (+ index 1) (u64-shift-right bits 8) (vector-conj bytes (bit-and bits 255))))))

(defn- bytes1 [a :i64] :vector-i64 (vector-conj (vector-alloc 0) a))
(defn- bytes2 [a :i64 b :i64] :vector-i64 (vector-conj (bytes1 a) b))
(defn- bytes3 [a :i64 b :i64 c :i64] :vector-i64 (vector-conj (bytes2 a b) c))
(defn- bytes4 [a :i64 b :i64 c :i64 d :i64] :vector-i64 (vector-conj (bytes3 a b c) d))

(defn- rex [wide :bool r :i64 x :i64 b :i64] :i64
  (bit-or (bit-or (bit-or (bit-or 0x40 (if wide 8 0)) (if (>= r 8) 4 0)) (if (>= x 8) 2 0)) (if (>= b 8) 1 0)))

(defn- modrm [mode :i64 r :i64 m :i64] :i64
  (bit-or (bit-or (i64-shift-left mode 6) (i64-shift-left (bit-and r 7) 3)) (bit-and m 7)))

(defn- x86-memory [out :vector-i64 r :i64 b :i64 n :i64] :vector-i64
  (let [with-modrm (vector-conj out (modrm 2 r b))]
    (append-le (if (= 4 (bit-and b 7)) (vector-conj with-modrm 0x24) with-modrm) n 4)))

(defn- x86-move [out :vector-i64 d :i64 s :i64] :vector-i64
  (vector-conj (vector-conj (vector-conj out (rex true s 0 d)) 0x89) (modrm 3 s d)))

(defn- encode-x86 [ins [:ref :linux.static/instruction] pc :i64 target :i64] :vector-i64
  (let [op (record-get [:ref :linux.static/instruction] ins :op)
        aux (record-get [:ref :linux.static/instruction] ins :aux)
        d (register :x86_64 (record-get [:ref :linux.static/instruction] ins :d))
        s (register :x86_64 (record-get [:ref :linux.static/instruction] ins :s))
        b (register :x86_64 (record-get [:ref :linux.static/instruction] ins :b))
        i (register :x86_64 (record-get [:ref :linux.static/instruction] ins :i))
        n (record-get [:ref :linux.static/instruction] ins :n)]
    (case op
      :label (vector-alloc 0)
      :align (vector-alloc 0)
      :save-lr (vector-alloc 0)
      :restore-lr (vector-alloc 0)
      :li (append-le (bytes2 (rex true 0 0 d) (+ 0xb8 (bit-and d 7))) n 8)
      :la (append-le (bytes3 (rex true d 0 0) 0x8d (modrm 0 d 5)) (- target (+ pc 7)) 4)
      :mov (x86-move (vector-alloc 0) d s)
      :ld (x86-memory (bytes2 (rex true d 0 b) 0x8b) d b n)
      :st (x86-memory (bytes2 (rex true d 0 b) 0x89) d b n)
      :ldb (vector-conj (vector-conj (bytes4 (rex true d i b) 0x0f 0xb6 (modrm 1 d 4)) (modrm 0 i b)) 0)
      :stb (vector-conj (bytes4 (rex false d i b) 0x88 (modrm 1 d 4) (modrm 0 i b)) 0)
      :alu (bytes3 (rex true s 0 d) (x86-alu aux) (modrm 3 s d))
      :alui (append-le (bytes3 (rex true 0 0 d) 0x81 (modrm 3 (x86-alu-ext aux) d)) n 4)
      :shli (bytes4 (rex true 0 0 d) 0xc1 (modrm 3 4 d) n)
      :shri (bytes4 (rex true 0 0 d) 0xc1 (modrm 3 5 d) n)
      :not (bytes3 (rex true 0 0 d) 0xf7 (modrm 3 2 d))
      :neg (bytes3 (rex true 0 0 d) 0xf7 (modrm 3 3 d))
      :bcc (append-le (bytes2 0x0f (+ 0x80 (x86-condition aux))) (- target (+ pc 6)) 4)
      :b (append-le (bytes1 0xe9) (- target (+ pc 5)) 4)
      :call (append-le (bytes1 0xe8) (- target (+ pc 5)) 4)
      :ret (bytes1 0xc3)
      :syscall (bytes2 0x0f 0x05)
      :trap (bytes2 0x0f 0x0b)
      :push (if (>= d 8) (bytes2 0x41 (+ 0x50 (bit-and d 7))) (bytes1 (+ 0x50 d)))
      :pop (if (>= d 8) (bytes2 0x41 (+ 0x58 (bit-and d 7))) (bytes1 (+ 0x58 d)))
      :ld-sp (append-le (bytes4 (rex true d 0 0) 0x8b (modrm 2 d 4) 0x24) n 4)
      :lea-sp (append-le (bytes4 (rex true d 0 0) 0x8d (modrm 2 d 4) 0x24) n 4)
      :udiv10
      (let [a (x86-move (vector-alloc 0) 0 s)
            z (vector-conj (vector-conj a 0x31) 0xd2)
            ten (append-le (vector-conj (vector-conj z (rex true 0 0 11)) 0xbb) 10 8)
            div (vector-conj (vector-conj (vector-conj ten (rex true 0 0 11)) 0xf7) (modrm 3 6 11))]
        (x86-move (x86-move div d 0) b 2))
      :bytes (record-get [:ref :linux.static/instruction] ins :data)
      (vector-alloc 0))))

(defn- append-word [out :vector-i64 word :i64] :vector-i64 (append-le out word 4))
(defn- word [value :i64] :vector-i64 (append-word (vector-alloc 0) value))

(defn- a64-immediate [out :vector-i64 d :i64 n :i64] :vector-i64
  (loop [index 0 bytes out]
    (if (>= index 4) bytes
      (let [chunk (bit-and (u64-shift-right n (* 16 index)) 65535)
            opcode (if (= index 0) 0xd2800000 0xf2800000)]
        (recur (+ index 1)
               (append-word bytes (bit-or (bit-or (bit-or opcode (i64-shift-left index 21)) (i64-shift-left chunk 5)) d)))))))

(defn- a64-alu-word [aux :keyword d :i64 s :i64] :i64
  (if (= aux :cmp)
    (bit-or (bit-or 0xeb00001f (i64-shift-left s 16)) (i64-shift-left d 5))
    (bit-or (bit-or (bit-or (a64-alu aux) (i64-shift-left s 16)) (i64-shift-left d 5)) d)))

(defn- encode-a64 [ins [:ref :linux.static/instruction] pc :i64 target :i64] :vector-i64
  (let [op (record-get [:ref :linux.static/instruction] ins :op)
        aux (record-get [:ref :linux.static/instruction] ins :aux)
        d (register :aarch64 (record-get [:ref :linux.static/instruction] ins :d))
        s (register :aarch64 (record-get [:ref :linux.static/instruction] ins :s))
        b (register :aarch64 (record-get [:ref :linux.static/instruction] ins :b))
        i (register :aarch64 (record-get [:ref :linux.static/instruction] ins :i))
        n (record-get [:ref :linux.static/instruction] ins :n)
        relative (- target pc)]
    (case op
      :label (vector-alloc 0)
      :align (vector-alloc 0)
      :li (a64-immediate (vector-alloc 0) d n)
      :la (word (bit-or (bit-or (bit-or 0x10000000 (i64-shift-left (bit-and relative 3) 29)) (i64-shift-left (bit-and (i64-shift-right relative 2) 0x7ffff) 5)) d))
      :mov (word (bit-or (bit-or 0xaa0003e0 (i64-shift-left s 16)) d))
      :ld (word (bit-or (bit-or (bit-or 0xf9400000 (i64-shift-left (quot n 8) 10)) (i64-shift-left b 5)) d))
      :st (word (bit-or (bit-or (bit-or 0xf9000000 (i64-shift-left (quot n 8) 10)) (i64-shift-left b 5)) d))
      :ldb (word (bit-or (bit-or (bit-or 0x38606800 (i64-shift-left i 16)) (i64-shift-left b 5)) d))
      :stb (word (bit-or (bit-or (bit-or 0x38206800 (i64-shift-left i 16)) (i64-shift-left b 5)) d))
      :alu (word (a64-alu-word aux d s))
      :alui
      (if (small-a64-immediate? aux n)
        (word (case aux
                :add (bit-or (bit-or (bit-or 0x91000000 (i64-shift-left n 10)) (i64-shift-left d 5)) d)
                :sub (bit-or (bit-or (bit-or 0xd1000000 (i64-shift-left n 10)) (i64-shift-left d 5)) d)
                (bit-or (bit-or 0xf100001f (i64-shift-left n 10)) (i64-shift-left d 5))))
        (append-word (a64-immediate (vector-alloc 0) 17 n) (a64-alu-word aux d 17)))
      :shli (word (bit-or (bit-or (bit-or (bit-or 0xd3400000 (i64-shift-left (bit-and (- 64 n) 63) 16)) (i64-shift-left (- 63 n) 10)) (i64-shift-left d 5)) d))
      :shri (word (bit-or (bit-or (bit-or 0xd340fc00 (i64-shift-left n 16)) (i64-shift-left d 5)) d))
      :not (word (bit-or (bit-or 0xaa2003e0 (i64-shift-left d 16)) d))
      :neg (word (bit-or (bit-or 0xcb0003e0 (i64-shift-left d 16)) d))
      :bcc (word (bit-or (bit-or 0x54000000 (i64-shift-left (bit-and (quot relative 4) 0x7ffff) 5)) (a64-condition aux)))
      :b (word (bit-or 0x14000000 (bit-and (quot relative 4) 0x3ffffff)))
      :call (word (bit-or 0x94000000 (bit-and (quot relative 4) 0x3ffffff)))
      :ret (word 0xd65f03c0)
      :syscall (word 0xd4000001)
      :trap (word 0)
      :push (word (bit-or 0xf81f0fe0 d))
      :pop (word (bit-or 0xf84107e0 d))
      :ld-sp (word (bit-or (bit-or 0xf94003e0 (i64-shift-left (quot n 8) 10)) d))
      :lea-sp (word (bit-or (bit-or 0x910003e0 (i64-shift-left n 10)) d))
      :udiv10
      (let [a (word 0xd2800151)
            divide (append-word a (bit-or (bit-or (bit-or 0x9ac00800 (i64-shift-left 17 16)) (i64-shift-left s 5)) 16))
            remainder (append-word divide (bit-or (bit-or (bit-or (bit-or 0x9b008000 (i64-shift-left 17 16)) (i64-shift-left s 10)) (i64-shift-left 16 5)) b))]
        (append-word remainder (bit-or (bit-or 0xaa0003e0 (i64-shift-left 16 16)) d)))
      :save-lr (word (bit-or 0xf81f0fe0 30))
      :restore-lr (word (bit-or 0xf84107e0 30))
      :bytes (record-get [:ref :linux.static/instruction] ins :data)
      (vector-alloc 0))))

(defn- relative-op? [op :keyword] :bool
  (or (= op :la) (= op :bcc) (= op :b) (= op :call)))

(defn- relative-valid? [isa :keyword op :keyword pc :i64 target :i64] :bool
  (if (not (relative-op? op)) true
    (if (= isa :x86_64)
      (signed32? (- target (+ pc (if (= op :la) 7 (if (= op :bcc) 6 5)))))
      (let [delta (- target pc)]
        (if (= op :la) (and (>= delta -1048576) (<= delta 1048575))
          (and (= (bit-and delta 3) 0)
               (if (= op :bcc) (and (>= delta -1048576) (<= delta 1048572))
                 (and (>= delta -134217728) (<= delta 134217724)))))))))

(defn- copy-code [out :vector-i64 offset :i64 code :vector-i64] :vector-i64
  (loop [index 0 bytes out]
    (if (>= index (vector-count code)) bytes
      (recur (+ index 1) (vector-assoc! bytes (+ offset index) (vector-at code index))))))

(defn- zero-padding [out :vector-i64 offset :i64 count :i64] :vector-i64
  (loop [index 0 bytes out]
    (if (>= index count) bytes
      (recur (+ index 1) (vector-assoc! bytes (+ offset index) 0)))))

(defn- emit [isa :keyword base :i64 items [:list [:ref :linux.static/instruction]]
              positions [:ref :linux.static/layout]] [:ref :linux.static/result]
  (let [labels (record-get [:ref :linux.static/layout] positions :labels)
        length (- (record-get [:ref :linux.static/layout] positions :end) base)]
    (loop [index 0 offset 0 bytes (vector-alloc length)]
      (if (>= index (vector-count items))
        (if (= offset length) (result bytes labels :ok -1) (failure labels :assembler-passes index))
        (let [ins (typed-list-nth [:list [:ref :linux.static/instruction]] items index)
              op (record-get [:ref :linux.static/instruction] ins :op)
              pc (+ base offset)]
          (if (= op :align)
            (let [size (padding pc (record-get [:ref :linux.static/instruction] ins :n))]
              (if (> size (- length offset)) (failure labels :assembler-passes index)
                (recur (+ index 1) (+ offset size) (zero-padding bytes offset size))))
            (let [target-index (if (relative-op? op)
                                 (label-index labels (record-get [:ref :linux.static/instruction] ins :label)) -1)
                  target (if (>= target-index 0)
                           (record-get [:ref :linux.static/label]
                                       (typed-list-nth [:list [:ref :linux.static/label]] labels target-index) :address) 0)]
              (cond
                (and (relative-op? op) (< target-index 0)) (failure labels :undefined-label index)
                (not (relative-valid? isa op pc target)) (failure labels :relative-range index)
                :else
                (let [code (if (= isa :x86_64) (encode-x86 ins pc target) (encode-a64 ins pc target))
                      size (vector-count code)]
                  (if (not= size (instruction-size isa ins)) (failure labels :encoding-size index)
                    (if (> size (- length offset)) (failure labels :assembler-passes index)
                      (recur (+ index 1) (+ offset size) (copy-code bytes offset code)))))))))))))

(defn assemble [isa :keyword base :i64 items [:list [:ref :linux.static/instruction]]
                external [:list [:ref :linux.static/label]] limit :i64]
  [:ref :linux.static/result]
  (cond
    (not (or (= isa :x86_64) (= isa :aarch64))) (failure external :unknown-isa -1)
    (or (< base 0) (< limit 0) (> base (- 9223372036854775807 limit)))
    (failure external :address-overflow -1)
    :else
    (let [bad-external (external-problem external)]
      (if (>= bad-external 0) (failure external :invalid-external-label bad-external)
        (let [positions (layout isa base limit items external)
              error (record-get [:ref :linux.static/layout] positions :error)]
          (if (not= error :ok)
            (failure (record-get [:ref :linux.static/layout] positions :labels) error
                     (record-get [:ref :linux.static/layout] positions :at))
            (emit isa base items positions)))))))
