;; Canonical planning boundary for the complete Linux-static packager.
;; Reference: linux_static.cljk, owning main 535ca0a3.
;; Source candidate only: no hosted numeric conversion or verifier callback.
(ns kotoba.native.linux-static-plan
  {:kotoba/export [targets implemented-slots slot-names plan image-layout]}
  (:require [kotoba.artifact.core :as artifact]
            [kotoba.native.linux-static-sha256 :as sha256]
            [kotoba.native.linux-static-vectors :as vectors])
  (:schemas {:linux.static.plan/result
             [:record :linux.static.plan/result
              [[:value :document] [:error :keyword] [:data :document]]]}))

(defn- ok [value :document] [:ref :linux.static.plan/result]
  (record-new [:ref :linux.static.plan/result] value :ok (document-null)))

(defn- fail [error :keyword data :document] [:ref :linux.static.plan/result]
  (record-new [:ref :linux.static.plan/result] (document-null) error data))

(defn- value [r [:ref :linux.static.plan/result]] :document
  (record-get [:ref :linux.static.plan/result] r :value))

(defn- good? [r [:ref :linux.static.plan/result]] :bool
  (= (record-get [:ref :linux.static.plan/result] r :error) :ok))

(defn- item [v :document index :i64] :document
  (option-value-of [:option :document] (document-vector-at v index) (document-null)))

(defn- entry [m :document index :i64] :document
  (option-value-of [:option :document] (document-map-entry-at m index) (document-null)))

(defn- lookup [m :document key :document] :document
  (if (not= (document-kind m) :map) (document-null)
    (loop [index 0]
      (if (>= index (document-count m)) (document-null)
        (let [pair (entry m index)]
          (if (document-equal? (item pair 0) key) (item pair 1) (recur (+ index 1))))))))

(defn- has? [m :document key :document] :bool
  (if (not= (document-kind m) :map) false
    (loop [index 0]
      (if (>= index (document-count m)) false
        (if (document-equal? (item (entry m index) 0) key) true (recur (+ index 1)))))))

(defn- get-key [m :document key :keyword] :document (lookup m (document-keyword key)))
(defn- get2 [m :document a :keyword b :keyword] :document (get-key (get-key m a) b))
(defn- get3 [m :document a :keyword b :keyword c :keyword] :document (get-key (get2 m a b) c))
(defn- i64-of [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) 0))
(defn- string-of [d :document] :string (option-value-of [:option :string] (document-string-value d) ""))
(defn- key-of [d :document] :keyword (option-value-of [:option :keyword] (document-keyword-value d) :none))
(defn- bool-of [d :document] :bool (option-value-of [:option :bool] (document-bool-value d) false))
(defn- i64-document? [d :document] :bool (= (document-kind d) :i64))

(defn- truthy? [d :document] :bool
  (and (not= (document-kind d) :null) (not (and (= (document-kind d) :bool) (not (bool-of d))))))

(defn- put [m :document key :document v :document] :document
  (document-merge m (document-map key v)))

(defn- put-key [m :document key :keyword v :document] :document (put m (document-keyword key) v))

(defn- field [name :keyword] :document (document-map (document-keyword :field) (document-keyword name)))

(defn- sequence-vector [xs :document reason :keyword] [:ref :linux.static.plan/result]
  (case (document-kind xs)
    :vector (ok xs)
    :list (loop [index 0 out (document-vector)]
            (if (>= index (document-count xs)) (ok out)
              (recur (+ index 1)
                     (document-vector-conj out
                       (option-value-of [:option :document] (document-list-at xs index) (document-null))))))
    :set (let [printed (document-edn-print xs)]
           (ok (document-edn-read
                 (string-concat "[" (string-substring printed 2 (- (string-length printed) 1)) "]"))))
    (fail reason xs)))

(defn- contains-value? [xs :document x :document] :bool
  (loop [index 0]
    (if (>= index (document-count xs)) false
      (if (document-equal? (item xs index) x) true (recur (+ index 1))))))

(defn- insert-wire [xs :document wire :i64] :document
  (loop [index 0 inserted false out (document-vector)]
    (if (>= index (document-count xs))
      (if inserted out (document-vector-conj out (document-i64 wire)))
      (let [current (i64-of (item xs index))]
        (cond
          (= current wire) xs
          (and (not inserted) (< wire current))
          (recur index true (document-vector-conj out (document-i64 wire)))
          :else (recur (+ index 1) inserted (document-vector-conj out (item xs index))))))))

(defn- wire-vector [xs :document reason :keyword] [:ref :linux.static.plan/result]
  (let [parsed (sequence-vector xs reason)]
    (if (not (good? parsed)) parsed
      (loop [index 0 out (document-vector)]
        (if (>= index (document-count (value parsed))) (ok out)
          (let [wire (item (value parsed) index)]
            (cond
              (not (i64-document? wire)) (fail reason wire)
              (or (< (i64-of wire) 0) (> (i64-of wire) 255)) (fail :capability-wire-range wire)
              :else (recur (+ index 1) (insert-wire out (i64-of wire))))))))))

(defn- effect-ids [effects :document] [:ref :linux.static.plan/result]
  (let [parsed (sequence-vector (if (= (document-kind effects) :null) (document-vector) effects)
                                :effect-not-capability)]
    (if (not (good? parsed)) parsed
      (loop [index 0 out (document-vector)]
        (if (>= index (document-count (value parsed))) (ok out)
          (let [effect (item (value parsed) index)]
            (cond
              (and (= (document-kind effect) :keyword)
                   (or (= (key-of effect) :state) (= (key-of effect) :abort)))
              (recur (+ index 1) out)
              (not (and (= (document-kind effect) :vector) (= (document-count effect) 2)
                        (= (document-kind (item effect 0)) :keyword) (= (key-of (item effect 0)) :cap/call)
                        (i64-document? (item effect 1))))
              (fail :effect-not-capability effect)
              (or (< (i64-of (item effect 1)) 0) (> (i64-of (item effect 1)) 255))
              (fail :capability-wire-range effect)
              :else (recur (+ index 1) (insert-wire out (i64-of (item effect 1)))))))))))

(defn- canonical-scope? [path :string] :bool
  (let [bytes (string-to-utf8 path) n (bytes-count bytes)]
    (if (or (< n 1) (>= n 4096) (not= (bytes-at bytes 0) 47)
            (and (> n 1) (= (bytes-at bytes (- n 1)) 47))) false
      (if (= n 1) true
        (loop [index 1 start 1]
          (if (or (= index n) (= (bytes-at bytes index) 47))
            (let [length (- index start)]
              (if (or (= length 0)
                      (and (= length 1) (= (bytes-at bytes start) 46))
                      (and (= length 2) (= (bytes-at bytes start) 46) (= (bytes-at bytes (+ start 1)) 46))) false
                (if (= index n) true (recur (+ index 1) (+ index 1)))))
            (if (= (bytes-at bytes index) 0) false (recur (+ index 1) start))))))))

(defn- basename [path :string] :string
  (let [bytes (string-to-utf8 path) n (bytes-count bytes)]
    (loop [index 0 start 0]
      (if (>= index n) (string-substring path start n)
        (recur (+ index 1) (if (= (bytes-at bytes index) 47) (+ index 1) start))))))

(defn- env-name? [name :string] :bool
  (let [bytes (string-to-utf8 name) n (bytes-count bytes)]
    (if (or (< n 1) (>= n 256)) false
      (loop [index 0]
        (if (>= index n) true
          (if (or (= (bytes-at bytes index) 0) (= (bytes-at bytes index) 61)) false (recur (+ index 1))))))))

(defn- spawn-programs [programs :document lookup? :bool] [:ref :linux.static.plan/result]
  (if (or (not= (document-kind programs) :vector) (> (document-count programs) 16))
    (fail :spawn-programs-malformed programs)
    (loop [index 0 seen (document-vector) names (document-vector)]
      (if (>= index (document-count programs)) (ok programs)
        (let [program (item programs index)]
          (cond
            (or (not= (document-kind program) :string) (not (canonical-scope? (string-of program)))
                (string=? (string-of program) "/") (contains-value? seen program))
            (fail :spawn-programs-malformed program)
            (and lookup? (contains-value? names (document-string (basename (string-of program)))))
            (fail :spawn-lookup-ambiguous program)
            :else (recur (+ index 1) (document-vector-conj seen program)
                         (document-vector-conj names (document-string (basename (string-of program)))))))))))

(defn- spawn-env [env :document] [:ref :linux.static.plan/result]
  (if (or (not= (document-kind env) :vector) (> (document-count env) 16))
    (fail :spawn-env-malformed env)
    (loop [index 0]
      (if (>= index (document-count env)) (ok env)
        (let [name (item env index)]
          (if (and (= (document-kind name) :string) (env-name? (string-of name)))
            (recur (+ index 1)) (fail :spawn-env-malformed name)))))))

(defn- spawn-grant [spawn :document grant :document] [:ref :linux.static.plan/result]
  (if (not (truthy? spawn))
    (ok (document-map (document-keyword :programs) (document-vector)
                      (document-keyword :path-lookup) (document-bool false)
                      (document-keyword :env) (document-vector)))
    (cond
      (not (contains-value? grant (document-i64 20))) (fail :spawn-without-capability spawn)
      (not= (document-kind spawn) :map) (fail :spawn-programs-malformed spawn)
      :else
      (let [programs0 (get-key spawn :programs) env0 (get-key spawn :env)
            lookup (get-key spawn :path-lookup)
            programs (if (truthy? programs0) programs0 (document-vector))
            env (if (truthy? env0) env0 (document-vector))]
        (if (not (or (= (document-kind lookup) :null) (= (document-kind lookup) :bool)))
          (fail :spawn-path-lookup-malformed lookup)
          (let [pr (spawn-programs programs (bool-of lookup)) er (spawn-env env)]
            (cond
              (not (good? pr)) pr
              (not (good? er)) er
              :else (ok (document-map (document-keyword :programs) (value pr)
                                      (document-keyword :path-lookup) (document-bool (bool-of lookup))
                                      (document-keyword :env) (value er))))))))))

(defn targets [] :document
  (document-map
    (document-keyword :x86_64-linux-static-kotoba-v1)
    (document-map (document-keyword :isa) (document-keyword :x86_64)
                  (document-keyword :machine) (document-keyword :x86-64)
                  (document-keyword :context-register) (document-keyword :r9))
    (document-keyword :aarch64-linux-static-kotoba-v1)
    (document-map (document-keyword :isa) (document-keyword :aarch64)
                  (document-keyword :machine) (document-keyword :aarch64)
                  (document-keyword :context-register) (document-keyword :x7))))

(defn implemented-slots [] :document
  (document-set (document-keyword :pair-new) (document-keyword :pair-first) (document-keyword :pair-second)
                 (document-keyword :string-equal) (document-keyword :string-concat)
                 (document-keyword :string-substring) (document-keyword :string-index-of)
                 (document-keyword :vector-new-empty) (document-keyword :vector-conj)
                 (document-keyword :vector-count) (document-keyword :vector-at)
                 (document-keyword :vector-assoc) (document-keyword :vector-alloc)
                 (document-keyword :vector-assoc-in-place) (document-keyword :vector-drop)
                 (document-keyword :bytes-from-vector) (document-keyword :bytes-slice)
                 (document-keyword :bytes-concat) (document-keyword :string-from-utf8)
                 (document-keyword :typed-cap-call)))

(defn- normalized-code [code :document] [:ref :linux.static.plan/result]
  (let [parsed (if (= (document-kind code) :bytes)
                 (let [bytes (option-value-of [:option :bytes] (document-bytes-value code) (bytes-empty))]
                   (loop [index 0 out (document-vector)]
                     (if (>= index (bytes-count bytes)) (ok out)
                       (recur (+ index 1) (document-vector-conj out (document-i64 (bytes-at bytes index)))))))
                 (sequence-vector code :handler-code))]
    (if (not (good? parsed)) parsed
      (loop [index 0 out (document-vector)]
        (if (>= index (document-count (value parsed))) (ok out)
          (let [byte (item (value parsed) index)]
            (if (not (i64-document? byte)) (fail :handler-code byte)
              (recur (+ index 1) (document-vector-conj out (document-i64 (bit-and (i64-of byte) 255)))))))))))

(defn- handler-code [source :document isa :keyword names :document] [:ref :linux.static.plan/result]
  (cond
    (or (not= (document-kind source) :map) (not (artifact/valid-seal? source)))
    (fail :handler-unsealed (get-key source :sha256))
    (not (document-equal? (get-key source :lowering)
                          (document-keyword (if (= isa :x86_64) :runtime-sysv-v1 :runtime-aapcs64-v1))))
    (fail :handler-isa (get-key source :lowering))
    :else
    (let [code (normalized-code (get-key source :code)) exports (get-key source :exports)]
      (if (not (good? code)) code
        (loop [index 0 offsets (document-map)]
          (if (>= index (document-count names))
            (ok (document-map (document-keyword :code) (value code) (document-keyword :offsets) offsets))
            (let [name (item names index) export (lookup exports name) offset (get-key export :offset)]
              (if (or (not= (document-kind export) :map) (not (i64-document? offset))
                      (< (i64-of offset) 0) (>= (i64-of offset) (document-count (value code))))
                (fail :handler-export name)
                (recur (+ index 1) (put offsets name offset))))))))))

(defn- handler-pair [overrides :document isa :keyword] [:ref :linux.static.plan/result]
  (let [handlers (get-key overrides :handlers)
        decisions (get-key handlers :decisions) service (get-key handlers :handlers)]
    (if (or (not (truthy? decisions)) (not (truthy? service))) (fail :handlers-missing handlers)
      (let [dr (handler-code decisions isa
                 (document-vector (document-symbol (symbol "cap-admitted")) (document-symbol (symbol "decide"))))]
        (if (not (good? dr)) dr
          (let [hr (handler-code service isa (document-vector (document-symbol (symbol "decide"))))]
            (if (not (good? hr)) hr
              (ok (document-map (document-keyword :decisions) (value dr)
                                (document-keyword :handlers) (value hr))))))))))

(defn- grant-subset? [grant :document effects :document] :bool
  (loop [index 0]
    (if (>= index (document-count grant)) true
      (if (contains-value? effects (item grant index)) (recur (+ index 1)) false))))

(defn- unhandled [effects :document handled :document named :document] :document
  (loop [index 0 out (document-vector)]
    (if (>= index (document-count effects)) out
      (let [wire (item effects index)]
        (recur (+ index 1)
               (if (has? handled wire) out
                 (document-vector-conj out (document-vector wire (lookup named wire)))))))))

(defn- capability-plan [source :document profile :document overrides :document] [:ref :linux.static.plan/result]
  (let [effects (effect-ids (get-key source :effects))
        target (lookup (targets) (get-key source :target))
        raw-grant (get-key overrides :grant)
        scope (get-key overrides :fs-scope)]
    (if (not (good? effects)) effects
      (let [missing (unhandled (value effects)
                      (get3 profile :static-elf :capability-handlers :value)
                      (get3 profile :static-elf :refused-capabilities :value))
            grant (wire-vector (if (truthy? raw-grant) raw-grant (value effects)) :grant-malformed)]
        (cond
          (> (document-count missing) 0) (fail :capability-without-handler missing)
          (not (good? grant)) grant
          (not (grant-subset? (value grant) (value effects))) (fail :grant-widens-effects (value grant))
          (and (truthy? scope) (or (not= (document-kind scope) :string) (not (canonical-scope? (string-of scope)))))
          (fail :fs-scope-not-canonical scope)
          (and (> (document-count (value effects)) 0) (= (document-kind target) :null))
          (fail :not-linux-static (get-key source :target))
          :else
          (let [spawn (spawn-grant (get-key overrides :spawn) (value grant))]
            (if (not (good? spawn)) spawn
              (let [base (document-map
                           (document-keyword :effect-ids) (value effects)
                           (document-keyword :grant) (value grant)
                           (document-keyword :fs-scope) scope
                           (document-keyword :spawn) (value spawn))]
                (if (= (document-count (value effects)) 0) (ok base)
                  (let [handlers (handler-pair overrides (key-of (get-key target :isa)))]
                    (if (not (good? handlers)) handlers
                      (ok (put-key base :handler-code (value handlers))))))))))))))

(defn- data-word? [name :keyword] :bool
  (case name
    :fuel-offset true :allow-bitmap-offset true :pair-used-pointer-offset true
    :pairs-base-offset true :pair-validated-base-offset true
    :vector-used-pointer-offset true :vectors-base-offset true :vector-items-base-offset true false))

;; The reference sorted-map compares keyword names as UTF-16, on both hosts.
;; Canonical strings use UTF-8 bytes; compare the corresponding code units.
(defn- utf16-units [name :string] :vector-i64
  (let [bytes (string-to-utf8 name) n (bytes-count bytes)]
    (loop [index 0 out (vector-alloc 0)]
      (if (>= index n) out
        (let [a (bytes-at bytes index)
              width (if (< a 128) 1 (if (< a 224) 2 (if (< a 240) 3 4)))
              point
              (if (= width 1) a
                (if (= width 2)
                  (+ (* (bit-and a 31) 64) (bit-and (bytes-at bytes (+ index 1)) 63))
                  (if (= width 3)
                    (+ (* (bit-and a 15) 4096) (* (bit-and (bytes-at bytes (+ index 1)) 63) 64)
                       (bit-and (bytes-at bytes (+ index 2)) 63))
                    (+ (* (bit-and a 7) 262144) (* (bit-and (bytes-at bytes (+ index 1)) 63) 4096)
                       (* (bit-and (bytes-at bytes (+ index 2)) 63) 64) (bit-and (bytes-at bytes (+ index 3)) 63)))))
              next (if (< point 65536) (vector-conj out point)
                     (let [rest (- point 65536)]
                       (vector-conj (vector-conj out (+ 55296 (quot rest 1024))) (+ 56320 (bit-and rest 1023)))))]
          (recur (+ index width) next))))))

(defn- compare-names [a :string b :string] :i64
  (let [x (utf16-units a) y (utf16-units b)
        xn (vector-count x) yn (vector-count y)]
    (loop [index 0]
      (if (or (>= index xn) (>= index yn)) (- xn yn)
        (let [difference (- (vector-at x index) (vector-at y index))]
          (if (not= difference 0) difference (recur (+ index 1))))))))

(defn- sort-keyed-map [m :document] :document
  (loop [remaining m out (document-map)]
    (if (= (document-count remaining) 0) out
      (let [best (loop [index 1 selected 0]
                   (if (>= index (document-count remaining)) selected
                     (let [a (keyword-name (key-of (item (entry remaining index) 0)))
                           b (keyword-name (key-of (item (entry remaining selected) 0)))]
                       (recur (+ index 1) (if (< (compare-names a b) 0) index selected)))))
            pair (entry remaining best) key (item pair 0)
            rest (loop [index 0 result (document-map)]
                   (if (>= index (document-count remaining)) result
                     (let [current (entry remaining index)]
                       (recur (+ index 1)
                              (if (= index best) result (put result (item current 0) (item current 1)))))))]
        (recur rest (put out key (item pair 1)))))))

(defn slot-names [context :document] [:ref :linux.static.plan/result]
  (if (not= (document-kind context) :map) (fail :context-abi-shape context)
    (loop [index 0 out (document-map)]
      (if (>= index (document-count context)) (ok (sort-keyed-map out))
        (let [pair (entry context index) key (item pair 0) offset (item pair 1)]
          (if (not= (document-kind key) :keyword) (fail :context-abi-key key)
            (let [name (keyword-name (key-of key)) length (string-length name)]
              (if (and (>= length 7) (string=? (string-substring name (- length 7) length) "-offset")
                       (not (data-word? (key-of key))))
                (if (= length 7) (fail :context-abi-key key)
                  (if (or (not (i64-document? offset)) (< (i64-of offset) 0)) (fail :context-abi-offset pair)
                    (recur (+ index 1)
                           (put out (document-keyword (keyword-from-string (string-substring name 0 (- length 7)))) offset))))
                (recur (+ index 1) out)))))))))

(defn- admitted-slots [raw :document] [:ref :linux.static.plan/result]
  (let [parsed (sequence-vector raw :native-profile-incomplete)]
    (if (not (good? parsed)) parsed
      (loop [index 0 out (document-vector)]
        (if (>= index (document-count (value parsed))) (ok out)
          (let [slot (item (value parsed) index)]
            (cond
              (not= (document-kind slot) :keyword) (fail :native-profile-incomplete (field :admitted-slots))
              (not (document-set-contains? (implemented-slots) slot)) (fail :admitted-slot-unimplemented slot)
              :else (recur (+ index 1) (if (contains-value? out slot) out (document-vector-conj out slot))))))))))

(defn- exit-codes [exits :document traps :document handlers? :bool] [:ref :linux.static.plan/result]
  (let [required (document-vector
                   (document-keyword :ok) (document-keyword :trap/signal)
                   (document-keyword :budget/fuel) (document-keyword :budget/cells) (document-keyword :budget/bytes)
                   (get-key traps :slot) (get-key traps :fuel) (get-key traps :cells) (get-key traps :bytes))
        all (if handlers? (document-vector-conj required (document-keyword :capability/refused)) required)]
    (loop [index 0]
      (if (>= index (document-count all)) (ok exits)
        (let [outcome (item all index)]
          (if (not (i64-document? (lookup exits outcome))) (fail :exit-code-missing outcome)
            (recur (+ index 1))))))))

(defn- vector-slots? [admitted :document] :bool
  (loop [index 0]
    (if (>= index (document-count admitted)) false
      (if (document-set-contains? (vectors/supported-slots) (item admitted index)) true (recur (+ index 1))))))

(defn- bytes-slots? [admitted :document] :bool
  (loop [index 0]
    (if (>= index (document-count admitted)) false
      (if (document-set-contains? (vectors/supported-byte-slots) (item admitted index)) true (recur (+ index 1))))))
(defn- byte-value-traps [static :document bytes? :bool] [:ref :linux.static.plan/result]
  (if (not bytes?) (ok (document-vector))
    (let [names (get2 static :bytes-value-traps :value)]
      (if (or (not= (document-kind names) :vector) (not= (document-count names) 11))
        (fail :native-profile-incomplete (field :bytes-value-traps))
        (loop [i 0]
          (if (= i 11) (ok names)
            (if (= (document-kind (item names i)) :keyword) (recur (+ i 1))
              (fail :native-profile-incomplete (field :bytes-value-traps)))))))))

(defn- budgets [profile :document overrides :document vectors? :bool bytes? :bool] [:ref :linux.static.plan/result]
  (let [raw-cells (get-key overrides :cells) raw-bytes (get-key overrides :bytes)
        cells (if (truthy? raw-cells) raw-cells (get3 profile :cells :default :value))
        cells-max (get3 profile :cells :pair-arena-max :value)
        bytes (if (truthy? raw-bytes) raw-bytes (get3 profile :bytes :default :value))
        bytes-max (get3 profile :bytes :max :value)
        raw-vectors (get-key overrides :vectors) raw-items (get-key overrides :vector-items)
        table (if (truthy? raw-vectors) raw-vectors (get3 profile :cells :vectors :value))
        table-max (get3 profile :cells :vectors :max)
        items (if (truthy? raw-items) raw-items (get3 profile :cells :vector-items :value))
        items-max (get3 profile :cells :vector-items :max)
        limit (get3 profile :cells :vector-items :per-vector-max)
        byte-limit (get2 profile :bytes :value-max) string-limit (get2 profile :bytes :string-value-max)]
    (cond
      (not (i64-document? cells-max)) (fail :native-profile-incomplete (field :pair-arena-max))
      (not (i64-document? bytes-max)) (fail :native-profile-incomplete (field :bytes-max))
      (or (not (i64-document? cells)) (< (i64-of cells) 1) (> (i64-of cells) (i64-of cells-max)))
      (fail :cells-outside-profile cells)
      (or (not (i64-document? bytes)) (< (i64-of bytes) 1) (> (i64-of bytes) (i64-of bytes-max)))
      (fail :bytes-outside-profile bytes)
      (and vectors? (or (not (i64-document? table-max)) (not (i64-document? items-max))
                       (not (i64-document? limit)) (< (i64-of table-max) 1)
                       (< (i64-of items-max) 1) (< (i64-of limit) 1)))
      (fail :native-profile-incomplete (field :vector-bounds))
      (and vectors? (or (not (i64-document? table)) (< (i64-of table) 1) (> (i64-of table) (i64-of table-max))))
      (fail :vectors-outside-profile table)
      (and vectors? (or (not (i64-document? items)) (< (i64-of items) 1) (> (i64-of items) (i64-of items-max))))
      (fail :vector-items-outside-profile items)
      (and (not vectors?) (or (truthy? raw-vectors) (truthy? raw-items)))
      (fail :vector-slots-not-admitted (field :vectors))
      (and bytes? (or (not (i64-document? byte-limit)) (< (i64-of byte-limit) 1) (> (i64-of byte-limit) 65536)
                     (not (i64-document? string-limit)) (< (i64-of string-limit) 1) (> (i64-of string-limit) 65536)))
      (fail :native-profile-incomplete (field :byte-value-bounds))
      :else (ok (document-map (document-keyword :cells) cells (document-keyword :bytes) bytes
                  (document-keyword :vectors) (if vectors? table (document-i64 0))
                  (document-keyword :vector-items) (if vectors? items (document-i64 0))
                  (document-keyword :vector-item-limit) (if vectors? limit (document-i64 0))
                  (document-keyword :byte-value-limit) (if bytes? byte-limit (document-i64 0))
                  (document-keyword :string-value-limit) (if bytes? string-limit (document-i64 0)))))))

(defn- slot-plan [names :document admitted :document handlers? :bool] :document
  (loop [index 0 out (document-map)]
    (if (>= index (document-count names)) out
      (let [pair (entry names index) slot (item pair 0)]
        (recur (+ index 1)
               (put out slot
                    (document-map (document-keyword :offset) (item pair 1)
                                  (document-keyword :admitted?)
                                  (document-bool (and (contains-value? admitted slot)
                                     (or (not= (key-of slot) :typed-cap-call) handlers?))))))))))

(defn plan [source :document profile :document overrides :document] [:ref :linux.static.plan/result]
  (let [static (get-key profile :static-elf)
        context (get-key source :context-abi)
        fuel (get2 source :fuel-abi :initial)
        traps (document-map
                (document-keyword :fuel) (get2 profile :fuel :trap)
                (document-keyword :cells) (get2 profile :cells :trap)
                (document-keyword :bytes) (get2 profile :bytes :trap)
                (document-keyword :slot) (get-key static :unimplemented-slot-trap))]
    (cond
      (not= (document-kind static) :map) (fail :native-profile-incomplete (field :static-elf))
      (or (not= (document-kind (get-key traps :fuel)) :keyword)
          (not= (document-kind (get-key traps :cells)) :keyword)
          (not= (document-kind (get-key traps :bytes)) :keyword)
          (not= (document-kind (get-key traps :slot)) :keyword))
      (fail :native-profile-incomplete (field :trap-names))
      (or (not (i64-document? (get-key context :version))) (not= (i64-of (get-key context :version)) 11))
      (fail :context-abi-version (get-key context :version))
      (not (i64-document? fuel)) (fail :native-profile-incomplete (field :initial-fuel))
      :else
      (let [names (slot-names context)
            admitted (admitted-slots (get2 static :admitted-slots :value))
            byte-slots (and (good? admitted) (bytes-slots? (value admitted)))
            values (byte-value-traps static byte-slots)
            limits (budgets profile overrides (and (good? admitted) (vector-slots? (value admitted))) byte-slots)]
        (cond
          (not (good? limits)) limits
          (not (good? names)) names
          (not (good? admitted)) admitted
          (not (good? values)) values
          :else
          (let [caps (capability-plan source profile overrides)]
            (if (not (good? caps)) caps
              (let [handlers? (> (document-count (get-key (value caps) :effect-ids)) 0)
                    exits (exit-codes (get2 static :exit-codes :value) traps handlers?)]
                (if (not (good? exits)) exits
                  (ok (document-merge (value caps) (value limits)
                         (document-map
                           (document-keyword :metered?)
                           (document-bool (not (document-equal? (get2 source :limits :fuel-metering) (document-keyword :off))))
                           (document-keyword :handlers?) (document-bool handlers?)
                           (document-keyword :fuel) fuel
                           (document-keyword :trap-names) traps
                           (document-keyword :exit-codes) (value exits)
                           (document-keyword :bytes-value-traps) (value values)
                           (document-keyword :slots) (slot-plan (value names) (value admitted) handlers?)
                           (document-keyword :context-abi) context))))))))))))

(defn- checked-align [n :i64 alignment :i64] [:ref :linux.static.plan/result]
  (if (or (< n 0) (< alignment 1)) (fail :layout-overflow (document-i64 n))
    (let [remainder (- n (* (quot n alignment) alignment))
          extra (if (= remainder 0) 0 (- alignment remainder))]
      (if (> extra (- 9223372036854775807 n)) (fail :layout-overflow (document-i64 n))
        (ok (document-i64 (+ n extra)))))))

(defn- append-region [layout :document name :keyword size :i64] [:ref :linux.static.plan/result]
  (let [end (i64-of (get-key layout :end))]
    (if (or (< size 0) (> size (- 9223372036854775807 end)))
      (fail :layout-overflow (field name))
      (ok (put-key (put-key layout name (document-i64 end)) :end (document-i64 (+ end size)))))))

(defn- append-regions [initial [:ref :linux.static.plan/result] regions :document] [:ref :linux.static.plan/result]
  (loop [index 0 current initial]
    (if (or (not (good? current)) (>= index (document-count regions))) current
      (let [pair (item regions index)]
        (recur (+ index 1) (append-region (value current) (key-of (item pair 0)) (i64-of (item pair 1))))))))

(defn- layout-start [text-size :i64] [:ref :linux.static.plan/result]
  (if (or (< text-size 0) (> text-size (- 9223372036854775807 4096)))
    (fail :layout-overflow (field :text-size))
    (let [aligned (checked-align (+ 4096 text-size) 4096)]
      (if (not (good? aligned)) aligned
        (let [offset (i64-of (value aligned))]
          (if (> offset (- 9223372036854775807 4198400)) (fail :layout-overflow (field :data))
            (ok (document-map
                  (document-keyword :text-offset) (document-i64 4096)
                  (document-keyword :text) (document-i64 4198400)
                  (document-keyword :data-offset) (document-i64 offset)
                  (document-keyword :data) (document-i64 (+ 4194304 offset))
                  (document-keyword :end) (document-i64 (+ 4198400 offset))))))))))

(defn- scratch-layout [layout :document bytes :i64] [:ref :linux.static.plan/result]
  (let [names (checked-align bytes 16)
        entries (+ 2 (quot bytes 3))]
    (cond
      (not (good? names)) names
      (> entries (quot 9223372036854775807 24)) (fail :layout-overflow (field :index))
      :else
      (let [index (checked-align (* 24 entries) 16)]
        (if (not (good? index)) index
          (append-regions (ok layout)
            (document-vector
              (document-vector (document-keyword :buf-a) (document-i64 4096))
              (document-vector (document-keyword :buf-b) (document-i64 4096))
              (document-vector (document-keyword :buf-c) (document-i64 4096))
              (document-vector (document-keyword :cwd) (document-i64 4096))
              (document-vector (document-keyword :dents) (document-i64 32768))
              (document-vector (document-keyword :stat-buf) (document-i64 256))
              (document-vector (document-keyword :answer) (document-i64 256))
              (document-vector (document-keyword :tokens) (document-i64 256))
              (document-vector (document-keyword :probe) (document-i64 16))
              (document-vector (document-keyword :spawn-io) (document-i64 64))
              (document-vector (document-keyword :root-real) (document-i64 4096))
              (document-vector (document-keyword :output-control) (document-i64 5120))
              (document-vector (document-keyword :names) (value names))
              (document-vector (document-keyword :index) (value index)))))))))

(defn- hash-layout [current [:ref :linux.static.plan/result] source-plan :document]
  [:ref :linux.static.plan/result]
  (if (not (good? current)) current
    (let [raw (get-key source-plan :grant)
          grant (wire-vector (if (= (document-kind raw) :null) (document-vector) raw) :grant-malformed)]
      (cond
        (not (good? grant)) grant
        (not (contains-value? (value grant) (document-i64 3))) current
        (not (bool-of (get-key source-plan :handlers?))) (fail :layout-input (field :grant))
        :else (append-region (value current) :hash-workspace (sha256/workspace-bytes))))))

(defn image-layout [text-size :i64 source-plan :document] [:ref :linux.static.plan/result]
  (let [cells (get-key source-plan :cells) bytes (get-key source-plan :bytes)
        table (get-key source-plan :vectors) items (get-key source-plan :vector-items)
        handlers (get-key source-plan :handlers?)]
    (cond
      (or (not (i64-document? cells)) (not (i64-document? bytes)) (< (i64-of cells) 0) (< (i64-of bytes) 0)
          (not= (document-kind handlers) :bool))
      (fail :layout-input source-plan)
      (> (i64-of cells) (quot 9223372036854775807 16)) (fail :layout-overflow (field :pairs))
      (or (not (i64-document? table)) (not (i64-document? items)) (< (i64-of table) 0) (< (i64-of items) 0))
      (fail :layout-input (field :vectors))
      (> (i64-of table) (quot 9223372036854775807 16)) (fail :layout-overflow (field :vectors))
      (> (i64-of items) (quot 9223372036854775807 8)) (fail :layout-overflow (field :vector-items))
      :else
      (let [start (layout-start text-size) valid (checked-align (i64-of cells) 16)]
        (cond
          (not (good? start)) start
          (not (good? valid)) valid
          :else
          (let [regions (append-regions start
                          (document-vector
                            (document-vector (document-keyword :alt) (document-i64 16384))
                            (document-vector (document-keyword :pairs) (document-i64 (* 16 (i64-of cells))))
                            (document-vector (document-keyword :valid) (value valid))
                            (document-vector (document-keyword :vectors) (document-i64 (* 16 (i64-of table))))
                            (document-vector (document-keyword :vector-items) (document-i64 (* 8 (i64-of items))))
                            (document-vector (document-keyword :pool) bytes)))]
            (if (not (good? regions)) regions
              (let [end (checked-align (i64-of (get-key (value regions) :end)) 16)]
                (if (not (good? end)) end
                  (let [aligned (put-key (value regions) :end (value end))
                        scratch (if (bool-of handlers) (scratch-layout aligned (i64-of bytes)) (ok aligned))
                        all (hash-layout scratch source-plan)]
                    (if (not (good? all)) all
                      (ok (put-key (document-dissoc (value all) :end) :memory-size
                            (document-i64 (- (i64-of (get-key (value all) :end))
                                             (i64-of (get-key (value all) :data)))))))))))))))))
