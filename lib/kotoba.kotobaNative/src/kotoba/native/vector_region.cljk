(ns kotoba.native.vector-region
  "Conservative escape analysis and scalar-region lowering for bounded native
  vector literals.  A literal is admitted only when every lexical use is a
  count/read with no identity observation or function-boundary escape."
  {:kotoba/export [rewrite-expression rewrite-program]}
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :vr/rw [:record :vr/rw [[:form [:ref :form/r]] [:n :i64]]]})))

#?(:kotoba
   (defn- form-no-forms [] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]])))

#?(:kotoba
   (defn- form-one-form [a [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a)))

#?(:kotoba
   (defn- form-two-forms [a [:ref :form/r] b [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b)))

#?(:kotoba
   (defn- form-three-forms [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-new [:list [:ref :form/r]] a b c)))

#?(:kotoba
   (defn- form-append-form [xs [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
     (typed-list-conj [:list [:ref :form/r]] xs x)))

#?(:kotoba
   (defn- form-mk [t :i64 s :string n :i64 k :keyword kids [:list [:ref :form/r]]] [:ref :form/r]
     (record-new [:ref :form/r] t s n k kids 0 (bytes-empty))))

#?(:kotoba
   (defn- form-nil-form [] [:ref :form/r] (form-mk 0 "" 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-bool-form [b :bool] [:ref :form/r] (form-mk 1 "" (if b 1 0) :none (form-no-forms))))

#?(:kotoba
   (defn- form-int-form [n :i64] [:ref :form/r] (form-mk 2 "" n :none (form-no-forms))))

#?(:kotoba
   (defn- form-string-form [s :string] [:ref :form/r] (form-mk 3 s 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-keyword-form [k :keyword] [:ref :form/r] (form-mk 4 "" 0 k (form-no-forms))))

#?(:kotoba
   (defn- form-symbol-form [s :string] [:ref :form/r] (form-mk 5 s 0 :none (form-no-forms))))

#?(:kotoba
   (defn- form-form-seq [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 6 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-vec [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 7 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-set [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 8 "" 0 :none kids)))

#?(:kotoba
   (defn- form-form-map [kids [:list [:ref :form/r]]] [:ref :form/r] (form-mk 9 "" 0 :none kids)))

#?(:kotoba
   (defn- form-tag-of [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :tag)))

#?(:kotoba
   (defn- form-kids-of [f [:ref :form/r]] [:list [:ref :form/r]] (record-get [:ref :form/r] f :kids)))

#?(:kotoba
   (defn- form-int-value [f [:ref :form/r]] :i64 (record-get [:ref :form/r] f :n)))

#?(:kotoba
   (defn- form-string-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s)))

#?(:kotoba
   (defn- form-symbol-value [f [:ref :form/r]] :string (record-get [:ref :form/r] f :s)))

#?(:kotoba
   (defn- form-keyword-value [f [:ref :form/r]] :keyword (record-get [:ref :form/r] f :k)))

#?(:kotoba
   (defn- form-bool-value [f [:ref :form/r]] :bool (= 1 (record-get [:ref :form/r] f :n))))

#?(:kotoba
   (defn- form-is-nil? [f [:ref :form/r]] :bool (= 0 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-bool? [f [:ref :form/r]] :bool (= 1 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-int? [f [:ref :form/r]] :bool (= 2 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-string? [f [:ref :form/r]] :bool (= 3 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-keyword? [f [:ref :form/r]] :bool (= 4 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-symbol? [f [:ref :form/r]] :bool (= 5 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-seq? [f [:ref :form/r]] :bool (= 6 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-vec? [f [:ref :form/r]] :bool (= 7 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-set? [f [:ref :form/r]] :bool (= 8 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-map? [f [:ref :form/r]] :bool (= 9 (form-tag-of f))))

#?(:kotoba
   (defn- form-is-list-like? [f [:ref :form/r]] :bool (or (= 6 (form-tag-of f)) (= 7 (form-tag-of f)))))

#?(:kotoba
   (defn- form-is-true? [f [:ref :form/r]] :bool (and (= 1 (form-tag-of f)) (= 1 (record-get [:ref :form/r] f :n)))))

#?(:kotoba
   (defn- form-count-of [f [:ref :form/r]] :i64 (vector-count (form-kids-of f))))

#?(:kotoba
   (defn- form-nth-of [f [:ref :form/r] i :i64] [:ref :form/r]
     (if (and (>= i 0) (< i (form-count-of f)))
       (typed-list-nth [:list [:ref :form/r]] (form-kids-of f) i)
       (form-nil-form))))

#?(:kotoba
   (defn- form-first-of [f [:ref :form/r]] [:ref :form/r] (form-nth-of f 0)))

#?(:kotoba
   (defn- form-lookup-from [kids [:list [:ref :form/r]] key [:ref :form/r] i :i64] [:ref :form/r]
     (let [n (vector-count kids)]
       (loop [j i]
         (if (>= (+ j 1) n)
           (form-nil-form)
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             (typed-list-nth [:list [:ref :form/r]] kids (+ j 1))
             (recur (+ j 2))))))))

#?(:kotoba
   (defn- form-form-get [m [:ref :form/r] key [:ref :form/r]] [:ref :form/r]
     (form-lookup-from (form-kids-of m) key 0)))

#?(:kotoba
   (defn- form-lookup-has [kids [:list [:ref :form/r]] key [:ref :form/r]] :bool
     (let [n (vector-count kids)]
       (loop [j 0]
         (if (>= (+ j 1) n)
           false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] kids j) key)
             true
             (recur (+ j 2))))))))

#?(:kotoba
   (defn- form-form-has? [m [:ref :form/r] key [:ref :form/r]] :bool
     (form-lookup-has (form-kids-of m) key)))

#?(:kotoba
   (defn- form-member? [xs [:list [:ref :form/r]] x [:ref :form/r]] :bool
     (let [n (vector-count xs)]
       (loop [i 0]
         (if (>= i n) false
           (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) x) true (recur (inc i))))))))

#?(:kotoba
   (defn- form-ordered-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-eq (typed-list-nth [:list [:ref :form/r]] xs i) (typed-list-nth [:list [:ref :form/r]] ys i))
               (recur (inc i))
               false)))
         false))))

#?(:kotoba
   (defn- form-set-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [i 0]
           (if (>= i n) true
             (if (form-member? ys (typed-list-nth [:list [:ref :form/r]] xs i)) (recur (inc i)) false)))
         false))))

#?(:kotoba
   (defn- form-map-eq [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] :bool
     (let [n (vector-count xs)]
       (if (= n (vector-count ys))
         (loop [j 0]
           (if (>= (+ j 1) n) true
             (let [k (typed-list-nth [:list [:ref :form/r]] xs j)]
               (if (and (form-lookup-has ys k)
                        (form-eq (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)) (form-lookup-from ys k 0)))
                 (recur (+ j 2))
                 false))))
         false))))

#?(:kotoba
   (defn- form-eq
     "Structural equality, as `=` on the host's data: a list and a vector are
     different kinds here (as are they to the reader), sets and maps compare
     without order."
     [a [:ref :form/r] b [:ref :form/r]] :bool
     (let [t (form-tag-of a)]
       (and (= t (form-tag-of b))
            (cond
              (= t 0) true
              (= t 1) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 2) (= (record-get [:ref :form/r] a :n) (record-get [:ref :form/r] b :n))
              (= t 3) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 4) (= (record-get [:ref :form/r] a :k) (record-get [:ref :form/r] b :k))
              (= t 5) (string=? (record-get [:ref :form/r] a :s) (record-get [:ref :form/r] b :s))
              (= t 8) (form-set-eq (form-kids-of a) (form-kids-of b))
              (= t 9) (form-map-eq (form-kids-of a) (form-kids-of b))
              :else (form-ordered-eq (form-kids-of a) (form-kids-of b)))))))

#?(:kotoba
   (defn- form-rest-list
     "The kids of F after the first, as a list."
     [f [:ref :form/r]] [:list [:ref :form/r]]
     (let [xs (form-kids-of f)
           n (vector-count xs)]
       (loop [i 1 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i))))))))

#?(:kotoba
   (defn- form-last-of [f [:ref :form/r]] [:ref :form/r]
     (form-nth-of f (dec (form-count-of f)))))

#?(:kotoba
   (defn- form-cons-onto [x [:ref :form/r] xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count xs)]
       (loop [i 0 acc (form-one-form x)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs i))))))))

#?(:kotoba
   (defn- form-assoc-form
     "Map M with K bound to V: the first entry whose key is K keeps its place and
     takes V, else K V are appended (as `assoc` on the host's map)."
     [m [:ref :form/r] k [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (let [xs (form-kids-of m)
           n (vector-count xs)]
       (if (form-lookup-has xs k)
         (form-form-map
          (loop [j 0 acc (form-no-forms)]
            (if (>= (+ j 1) n)
              acc
              (let [key (typed-list-nth [:list [:ref :form/r]] xs j)]
                (recur (+ j 2)
                       (typed-list-conj [:list [:ref :form/r]]
                                        (typed-list-conj [:list [:ref :form/r]] acc key)
                                        (if (form-eq key k) v (typed-list-nth [:list [:ref :form/r]] xs (+ j 1)))))))))
         (form-form-map (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] xs k) v))))))

#?(:kotoba
   (defn- form-call0 [name :string] [:ref :form/r] (form-form-seq (form-one-form (form-symbol-form name)))))

#?(:kotoba
   (defn- form-call1 [name :string a [:ref :form/r]] [:ref :form/r]
     (form-form-seq (form-two-forms (form-symbol-form name) a))))

#?(:kotoba
   (defn- form-call2 [name :string a [:ref :form/r] b [:ref :form/r]] [:ref :form/r]
     (form-form-seq (form-three-forms (form-symbol-form name) a b))))

#?(:kotoba
   (defn- form-call3 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c))))

#?(:kotoba
   (defn- form-call4 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d))))

#?(:kotoba
   (defn- form-call5 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d) e))))

#?(:kotoba
   (defn- form-call6 [name :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r] f [:ref :form/r]] [:ref :form/r]
     (form-form-seq (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms (form-symbol-form name) a b) c) d) e) f))))

#?(:kotoba
   (defn- form-vec2 [a [:ref :form/r] b [:ref :form/r]] [:ref :form/r] (form-form-vec (form-two-forms a b))))

#?(:kotoba
   (defn- form-vec3 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r] (form-form-vec (form-three-forms a b c))))

#?(:kotoba
   (defn- form-vec4 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d))))

#?(:kotoba
   (defn- form-vec5 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d) e))))

#?(:kotoba
   (defn- form-vec6 [a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r] e [:ref :form/r] f [:ref :form/r]] [:ref :form/r]
     (form-form-vec (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (typed-list-conj [:list [:ref :form/r]] (form-three-forms a b c) d) e) f))))

#?(:kotoba
   (defn- form-doc-at [d :document i :i64] :document
     (option-value-of [:option :document] (document-vector-at d i) (document-null))))

#?(:kotoba
   (defn- form-doc-list-at [d :document i :i64] :document
     (option-value-of [:option :document] (document-list-at d i) (document-null))))

#?(:kotoba
   (defn- form-doc-entry-at [d :document i :i64] :document
     (option-value-of [:option :document] (document-map-entry-at d i) (document-null))))

#?(:kotoba
   (defn- form-doc-items [d :document list? :bool] [:list [:ref :form/r]]
     (let [n (document-count d)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i)
                  (typed-list-conj [:list [:ref :form/r]] acc
                                   (form-from-document (if list? (form-doc-list-at d i) (form-doc-at d i))))))))))

#?(:kotoba
   (defn- form-doc-map-items [d :document] [:list [:ref :form/r]]
     (let [n (document-count d)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n)
           acc
           (let [e (form-doc-entry-at d i)]
             (recur (inc i)
                    (typed-list-conj [:list [:ref :form/r]]
                                     (typed-list-conj [:list [:ref :form/r]] acc (form-from-document (form-doc-at e 0)))
                                     (form-from-document (form-doc-at e 1))))))))))

#?(:kotoba
   (defn- form-set-marker? [d :document] :bool
     (and (> (document-count d) 0)
          (= (document-kind (form-doc-at d 0)) :keyword)
          (= (option-value-of [:option :keyword] (document-keyword-value (form-doc-at d 0)) :none) :kotoba.form/set))))

#?(:kotoba
   (defn- form-doc-set-items [d :document] [:list [:ref :form/r]]
     (let [n (document-count d)]
       (loop [i 1 acc (form-no-forms)]
         (if (>= i n)
           acc
           (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (form-from-document (form-doc-at d i)))))))))

#?(:kotoba
   (defn- form-from-document [d :document] [:ref :form/r]
     (let [kind (document-kind d)]
       (cond
         (= kind :bool) (form-bool-form (option-value-of [:option :bool] (document-bool-value d) false))
         (= kind :i64) (form-int-form (option-value-of [:option :i64] (document-i64-value d) 0))
         (= kind :string) (form-string-form (option-value-of [:option :string] (document-string-value d) ""))
         (= kind :keyword) (form-keyword-form (option-value-of [:option :keyword] (document-keyword-value d) :none))
         (= kind :vector) (if (form-set-marker? d) (form-form-set (form-doc-set-items d)) (form-form-vec (form-doc-items d false)))
         (= kind :list) (form-form-seq (form-doc-items d true))
         (= kind :set) (form-form-set (form-doc-items d false))
         (= kind :map) (form-form-map (form-doc-map-items d))
         :else (form-nil-form)))))

#?(:kotoba
   (defn- form-keyword-has-namespace? [f [:ref :form/r]] :bool
     (and (= 4 (form-tag-of f))
          (>= (string-find-byte (document-edn-print (document-keyword (record-get [:ref :form/r] f :k))) 47 0) 0))))

#?(:kotoba
   (defn- form-keys-of [m [:ref :form/r]] [:ref :form/r]
     (let [xs (form-kids-of m)
           n (vector-count xs)]
       (form-form-set
        (loop [j 0 acc (form-no-forms)]
          (if (>= j n)
            acc
            (recur (+ j 2) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] xs j)))))))))

#?(:kotoba
   (defn- form-dissoc-form
     "Map M without K (as `dissoc` on the host's map)."
     [m [:ref :form/r] k [:ref :form/r]] [:ref :form/r]
     (let [xs (form-kids-of m)
           n (vector-count xs)]
       (form-form-map
        (loop [j 0 acc (form-no-forms)]
          (if (>= (+ j 1) n)
            acc
            (let [key (typed-list-nth [:list [:ref :form/r]] xs j)]
              (recur (+ j 2)
                     (if (form-eq key k)
                       acc
                       (typed-list-conj [:list [:ref :form/r]]
                                        (typed-list-conj [:list [:ref :form/r]] acc key)
                                        (typed-list-nth [:list [:ref :form/r]] xs (+ j 1))))))))))))

#?(:kotoba
   (defn- form-append-many [xs [:list [:ref :form/r]] ys [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count ys)]
       (loop [i 0 acc xs]
         (if (>= i n) acc (recur (inc i) (typed-list-conj [:list [:ref :form/r]] acc (typed-list-nth [:list [:ref :form/r]] ys i))))))))



#?(:kotoba
   (def ^:private max-items 32)
   :default
   (def ^:private max-items 32))


#?(:kotoba
   (defn- sym-is? [f [:ref :form/r] name :string] :bool
     (and (form-is-symbol? f) (string=? (form-symbol-value f) name)))
   :default
   (def ^:private constructors '#{vector-new vector-f64-new}))

#?(:kotoba
   (defn- constructor-op? [f [:ref :form/r]] :bool (or (sym-is? f "vector-new") (sym-is? f "vector-f64-new"))))


#?(:kotoba
   (defn- count-op? [f [:ref :form/r]] :bool (or (sym-is? f "vector-count") (sym-is? f "vector-f64-count")))
   :default
   (def ^:private counts '#{vector-count vector-f64-count}))


#?(:kotoba
   (defn- at-op? [f [:ref :form/r]] :bool (or (sym-is? f "vector-at") (sym-is? f "vector-f64-at")))
   :default
   (def ^:private ats '#{vector-at vector-f64-at}))


#?(:kotoba
   (defn- get-op? [f [:ref :form/r]] :bool (or (sym-is? f "vector-get") (sym-is? f "vector-f64-get")))
   :default
   (def ^:private gets '#{vector-get vector-f64-get}))



#?(:kotoba
   (defn- rw [f [:ref :form/r] n :i64] [:ref :vr/rw] (record-new [:ref :vr/rw] f n))
   :default
   (defn- constructor-items [form]
     (when (and (seq? form) (contains? constructors (first form))
                (<= (dec (count form)) max-items))
       (vec (rest form)))))

#?(:kotoba
   (defn- rw-form [r [:ref :vr/rw]] [:ref :form/r] (record-get [:ref :vr/rw] r :form)))

#?(:kotoba
   ;; The items of a vector constructor form as a vector form (empty is still a
   ;; constructor), or nil for anything else.
   (defn- constructor-items [f [:ref :form/r]] [:ref :form/r]
     (if (and (form-is-seq? f) (constructor-op? (form-first-of f)) (<= (dec (form-count-of f)) max-items))
       (form-form-vec (form-rest-list f))
       (form-nil-form))))



#?(:kotoba
   (defn- member? [x [:ref :form/r] xs [:ref :form/r]] :bool
     (let [n (form-count-of xs)]
       (loop [i 0]
         (if (>= i n) false (if (form-eq (form-nth-of xs i) x) true (recur (inc i)))))))
   :default
   (defn- bound-names [bindings]
     (set (keep #(when (symbol? %) %) (take-nth 2 bindings)))))

#?(:kotoba
   ;; Is TARGET among the symbols at the even positions of BINDINGS?
   (defn- bound-name? [bindings [:ref :form/r] target [:ref :form/r]] :bool
     (let [n (form-count-of bindings)]
       (loop [i 0]
         (if (>= i n) false
           (if (and (form-is-symbol? (form-nth-of bindings i)) (form-eq (form-nth-of bindings i) target)) true (recur (+ i 2))))))))



#?(:kotoba
   (defn- num [n :i64] [:ref :form/r] (form-int-form n))
   :default
   (declare safe-uses?))


#?(:kotoba
   (defn- every-safe-from? [xs [:list [:ref :form/r]] from :i64 step :i64 target [:ref :form/r]] :bool
     (let [n (vector-count xs)]
       (loop [i from]
         (if (>= i n) true
           (if (safe-uses? (typed-list-nth [:list [:ref :form/r]] xs i) target) (recur (+ i step)) false)))))
   :default
   (defn- safe-seq? [form target]
     (let [op (first form) args (rest form)]
       (cond
         (and (contains? counts op) (= 1 (count args)) (= target (first args))) true
         (and (or (contains? ats op) (contains? gets op))
              (<= 2 (count args) 3) (= target (first args)))
         (every? #(safe-uses? % target) (rest args))
         (= op 'let)
         (let [[bindings & body] args]
           (and (vector? bindings)
                (every? #(safe-uses? % target) (take-nth 2 (rest bindings)))
                (or (contains? (bound-names bindings) target)
                    (every? #(safe-uses? % target) body))))
         :else (every? #(safe-uses? % target) form)))))

#?(:kotoba
   (defn- safe-seq? [f [:ref :form/r] target [:ref :form/r]] :bool
     (let [op (form-first-of f)
           argc (dec (form-count-of f))
           arg0 (form-nth-of f 1)]
       (cond
         (and (count-op? op) (= 1 argc) (form-eq target arg0)) true
         (and (or (at-op? op) (get-op? op)) (<= 2 argc) (<= argc 3) (form-eq target arg0))
         (every-safe-from? (form-kids-of f) 2 1 target)
         (sym-is? op "let")
         (let [bindings arg0]
           (and (form-is-vec? bindings)
                (every-safe-from? (form-kids-of bindings) 1 2 target)
                (or (bound-name? bindings target)
                    (every-safe-from? (form-kids-of f) 2 1 target))))
         :else (every-safe-from? (form-kids-of f) 0 1 target)))))



#?(:kotoba
   (defn- safe-uses? [f [:ref :form/r] target [:ref :form/r]] :bool
     (cond
       (form-eq f target) false
       (form-is-seq? f) (safe-seq? f target)
       (form-is-vec? f) (every-safe-from? (form-kids-of f) 0 1 target)
       (form-is-map? f) (every-safe-from? (form-kids-of f) 0 1 target)
       (form-is-set? f) (every-safe-from? (form-kids-of f) 0 1 target)
       :else true))
   :default
   (defn- safe-uses? [form target]
     (cond
       (= form target) false
       (seq? form) (safe-seq? form target)
       (vector? form) (every? #(safe-uses? % target) form)
       (map? form) (every? #(and (safe-uses? (key %) target)
                                 (safe-uses? (val %) target)) form)
       (set? form) (every? #(safe-uses? % target) form)
       :else true)))



#?(:kotoba
   (defn- set-add [s [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
     (if (member? x s) s (form-form-set (form-append-form (form-kids-of s) x))))
   :default
   (defn- all-symbols [form]
     (into #{} (filter symbol?) (tree-seq coll? seq form))))

#?(:kotoba
   (defn- symbols-into [f [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
     (cond
       (form-is-symbol? f) (set-add acc f)
       (or (form-is-seq? f) (form-is-vec? f) (form-is-set? f) (form-is-map? f))
       (let [xs (form-kids-of f)
             n (vector-count xs)]
         (loop [i 0 a acc]
           (if (>= i n) a (recur (inc i) (symbols-into (typed-list-nth [:list [:ref :form/r]] xs i) a)))))
       :else acc)))

#?(:kotoba
   (defn- all-symbols [f [:ref :form/r]] [:ref :form/r]
     (symbols-into f (form-form-set (form-no-forms)))))



#?(:kotoba
   (defn- fresh [used [:ref :form/r] label :string counter :i64] [:ref :vr/rw]
     (loop [c counter]
       (let [n (inc c)
             candidate (form-symbol-form (string-concat (string-concat (string-concat "kotoba$region$" label) "$") (string-from-i64 n)))]
         (if (member? candidate used)
           (recur n)
           (rw candidate n)))))
   :default
   (defn- fresh! [state used label]
     (loop []
       (let [n (swap! state inc)
             candidate (symbol (str "kotoba$region$" label "$" n))]
         (if (contains? used candidate) (recur) candidate)))))

#?(:kotoba
   ;; One fresh item symbol per item of a vector of COUNT: a vector form.
   (defn- fresh-slots [count :i64 used [:ref :form/r] counter :i64] [:ref :vr/rw]
     (loop [i 0 acc (form-no-forms) c counter]
       (if (>= i count)
         (rw (form-form-vec acc) c)
         (let [r (fresh used "item" c)]
           (recur (inc i) (form-append-form acc (rw-form r)) (rw-n r)))))))



#?(:kotoba
   (defn- rw-n [r [:ref :vr/rw]] :i64 (record-get [:ref :vr/rw] r :n))
   :default
   (declare rewrite*))

#?(:kotoba
   ;; A literal kept in locals is still a constructor: it pays the one unit of
   ;; fuel the reference charges for it, before its items (amu ADR 0353 floor
   ;; :allocation-budget-native). The binding pair [fresh (fuel-charge!)] as a
   ;; vector form, so it precedes the items' own.
   (defn- charge [used [:ref :form/r] counter :i64] [:ref :vr/rw]
     (let [f (fresh used "charge" counter)]
       (rw (form-vec2 (rw-form f) (form-call0 "fuel-charge!")) (rw-n f))))
   :default
   (defn- charge
     "A literal kept in locals is still a constructor: it pays the one unit of
     fuel the reference charges for it, before its items (amu ADR 0353 floor
     :allocation-budget-native). A binding, so it precedes the items' own."
     [state used]
     [(fresh! state used "charge") (list 'fuel-charge!)]))


#?(:kotoba
   (defn- selected-chain [items [:ref :form/r] i [:ref :form/r] fallback [:ref :form/r]] [:ref :form/r]
     (loop [k (dec (form-count-of items)) acc fallback]
       (if (< k 0)
         acc
         (recur (dec k) (form-call3 "if" (form-call2 "=" i (num k)) (form-nth-of items k) acc)))))
   :default
   (defn- select-form [items index fallback state used]
     (let [i (fresh! state used "index")
           n (count items)
           selected (reduce (fn [otherwise [position item]]
                              (list 'if (list '= i position) item otherwise))
                            fallback
                            (reverse (map-indexed vector items)))]
       (list 'let [i (rewrite* index state used)]
             (list 'if (list '>= i 0)
                   (list 'if (list '< i n) selected fallback)
                   fallback)))))

#?(:kotoba
   (defn- select-form [items [:ref :form/r] index [:ref :form/r] fallback [:ref :form/r] counter :i64 used [:ref :form/r]] [:ref :vr/rw]
     (let [fi (fresh used "index" counter)
           i (rw-form fi)
           selected (selected-chain items i fallback)
           ri (rewrite* index (rw-n fi) used)]
       (rw (form-call2 "let" (form-vec2 i (rw-form ri))
                       (form-call3 "if" (form-call2 ">=" i (num 0))
                                   (form-call3 "if" (form-call2 "<" i (num (form-count-of items))) selected fallback)
                                   fallback))
           (rw-n ri)))))



#?(:kotoba
   (defn- literal-bindings [slots [:ref :form/r] items [:ref :form/r] counter :i64 used [:ref :form/r]] [:ref :vr/rw]
     (let [n (form-count-of items)]
       (loop [i 0 acc (form-no-forms) c counter]
         (if (>= i n)
           (rw (form-form-vec acc) c)
           (let [r (rewrite* (form-nth-of items i) c used)]
             (recur (inc i)
                    (form-append-form (form-append-form acc (form-nth-of slots i)) (rw-form r))
                    (rw-n r)))))))
   :default
   (defn- rewrite-read [op args regions state used]
     (let [[subject index fallback] args
           items (get regions subject)
           literal-items (constructor-items subject)]
       (cond
         (and items (contains? counts op)) (count items)
         (and items (contains? ats op))
         (select-form items index (list 'quot 1 0) state used)
         (and items (contains? gets op))
         (select-form items index (rewrite* fallback state used) state used)
         (and literal-items
              (or (contains? counts op) (contains? ats op) (contains? gets op)))
         (let [slots (mapv (fn [_] (fresh! state used "item")) literal-items)
               bindings (into (charge state used)
                              (mapcat vector slots (map #(rewrite* % state used) literal-items)))
               result (cond
                        (contains? counts op) (count slots)
                        (contains? ats op) (select-form slots index (list 'quot 1 0) state used)
                        :else (select-form slots index (rewrite* fallback state used) state used))]
           (list 'let bindings result))
         :else nil))))

#?(:kotoba
   (defn- rewrite-read [op [:ref :form/r] argf [:ref :form/r] regions [:ref :form/r] counter :i64 used [:ref :form/r]] [:ref :vr/rw]
     (let [subject (form-nth-of argf 0)
           index (form-nth-of argf 1)
           fallback (form-nth-of argf 2)
           has (form-form-has? regions subject)
           items (if has (form-form-get regions subject) (form-nil-form))
           lit (constructor-items subject)
           any-read (or (count-op? op) (at-op? op) (get-op? op))]
       (cond
         (and has (count-op? op)) (rw (num (form-count-of items)) counter)
         (and has (at-op? op)) (select-form items index (form-call2 "quot" (num 1) (num 0)) counter used)
         (and has (get-op? op))
         (let [fb (rewrite* fallback counter used)]
           (select-form items index (rw-form fb) (rw-n fb) used))
         (and (not (form-is-nil? lit)) any-read)
         (let [sl (fresh-slots (form-count-of lit) used counter)
               slots (rw-form sl)
               ch (charge used (rw-n sl))
               bl (literal-bindings slots lit (rw-n ch) used)
               result (cond
                        (count-op? op) (rw (num (form-count-of slots)) (rw-n bl))
                        (at-op? op) (select-form slots index (form-call2 "quot" (num 1) (num 0)) (rw-n bl) used)
                        :else (let [fb (rewrite* fallback (rw-n bl) used)]
                                (select-form slots index (rw-form fb) (rw-n fb) used)))]
           (rw (form-call2 "let"
                           (form-form-vec (form-append-many (form-kids-of (rw-form ch)) (form-kids-of (rw-form bl))))
                           (rw-form result))
               (rw-n result)))
         :else (rw (form-nil-form) counter)))))



#?(:kotoba
   (defn- rewrite-each [xs [:list [:ref :form/r]] regions [:ref :form/r] counter :i64 used [:ref :form/r]] [:ref :vr/rw]
     (let [n (vector-count xs)]
       (loop [i 0 acc (form-no-forms) c counter]
         (if (>= i n)
           (rw (form-form-vec acc) c)
           (let [r (rewrite-with-regions (typed-list-nth [:list [:ref :form/r]] xs i) regions c used)]
             (recur (inc i) (form-append-form acc (rw-form r)) (rw-n r)))))))
   :default
   (defn- rewrite-with-regions [form regions state used]
     (cond
       (seq? form)
       (let [op (first form) args (rest form)]
         (if-let [read (rewrite-read op args regions state used)]
           read
           (if (= op 'let)
             (let [[bindings & body] args]
               (loop [pairs (partition 2 bindings) out [] active regions]
                 (if-let [[name value] (first pairs)]
                   (if-let [items (and (symbol? name) (constructor-items value))]
                     (let [remainder (concat (map second (rest pairs)) body)]
                       (if (every? #(safe-uses? % name) remainder)
                         (let [slots (mapv (fn [_] (fresh! state used "item")) items)
                               lowered (concat (charge state used)
                                               (mapcat vector slots
                                                       (map #(rewrite-with-regions % active state used) items)))]
                           (recur (rest pairs) (into out lowered)
                                  (assoc active name slots)))
                         (recur (rest pairs)
                                (conj out name (rewrite-with-regions value active state used))
                                (dissoc active name))))
                     (recur (rest pairs)
                            (conj out name (rewrite-with-regions value active state used))
                            (dissoc active name)))
                   (list* 'let (vec out)
                          (map #(rewrite-with-regions % active state used) body)))))
             (apply list (map #(rewrite-with-regions % regions state used) form)))))
       (vector? form) (mapv #(rewrite-with-regions % regions state used) form)
       (map? form) (into (empty form) (map (fn [[k v]] [(rewrite-with-regions k regions state used)
                                                         (rewrite-with-regions v regions state used)]) form))
       (set? form) (set (map #(rewrite-with-regions % regions state used) form))
       :else form)))

#?(:kotoba
   (defn- rewrite*-each [xs [:list [:ref :form/r]] counter :i64 used [:ref :form/r]] [:ref :vr/rw]
     (let [n (vector-count xs)]
       (loop [i 0 acc (form-no-forms) c counter]
         (if (>= i n)
           (rw (form-form-vec acc) c)
           (let [r (rewrite* (typed-list-nth [:list [:ref :form/r]] xs i) c used)]
             (recur (inc i) (form-append-form acc (rw-form r)) (rw-n r))))))))

#?(:kotoba
   ;; Every later initialiser and every body form is a safe use of NAME.
   (defn- rest-safe? [bindings [:ref :form/r] i :i64 argf [:ref :form/r] name [:ref :form/r]] :bool
     (let [n (form-count-of bindings)
           later (loop [j (+ i 3)]
                   (if (>= j n) true (if (safe-uses? (form-nth-of bindings j) name) (recur (+ j 2)) false)))]
       (and later (every-safe-from? (form-kids-of argf) 1 1 name)))))

#?(:kotoba
   (defn- lower-items [items [:ref :form/r] slots [:ref :form/r] regions [:ref :form/r] counter :i64 used [:ref :form/r]] [:ref :vr/rw]
     (let [n (form-count-of items)]
       (loop [i 0 acc (form-no-forms) c counter]
         (if (>= i n)
           (rw (form-form-vec acc) c)
           (let [r (rewrite-with-regions (form-nth-of items i) regions c used)]
             (recur (inc i)
                    (form-append-form (form-append-form acc (form-nth-of slots i)) (rw-form r))
                    (rw-n r))))))))

#?(:kotoba
   (defn- rewrite-let [argf [:ref :form/r] regions [:ref :form/r] counter :i64 used [:ref :form/r]] [:ref :vr/rw]
     (let [bindings (form-nth-of argf 0)
           n (form-count-of bindings)]
       (loop [i 0 out (form-no-forms) active regions c counter]
         (if (>= (+ i 1) n)
           (let [body (rewrite-each (form-rest-list argf) active c used)]
             (rw (form-form-seq (form-cons-onto (form-symbol-form "let")
                                                (form-cons-onto (form-form-vec out) (form-kids-of (rw-form body)))))
                 (rw-n body)))
           (let [name (form-nth-of bindings i)
                 value (form-nth-of bindings (+ i 1))
                 items (if (form-is-symbol? name) (constructor-items value) (form-nil-form))]
             (if (and (not (form-is-nil? items)) (rest-safe? bindings i argf name))
               (let [sl (fresh-slots (form-count-of items) used c)
                     ch (charge used (rw-n sl))
                     low (lower-items items (rw-form sl) active (rw-n ch) used)]
                 (recur (+ i 2)
                        (form-append-many (form-append-many out (form-kids-of (rw-form ch)))
                                          (form-kids-of (rw-form low)))
                        (form-assoc-form active name (rw-form sl))
                        (rw-n low)))
               (let [v (rewrite-with-regions value active c used)]
                 (recur (+ i 2)
                        (form-append-form (form-append-form out name) (rw-form v))
                        (form-dissoc-form active name)
                        (rw-n v))))))))))

#?(:kotoba
   (defn- rebuild-map [flat [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (vector-count flat)]
       (loop [j 0 m (form-form-map (form-no-forms))]
         (if (>= (+ j 1) n)
           m
           (recur (+ j 2) (form-assoc-form m (typed-list-nth [:list [:ref :form/r]] flat j) (typed-list-nth [:list [:ref :form/r]] flat (+ j 1)))))))))

#?(:kotoba
   (defn- rebuild-set [items [:list [:ref :form/r]]] [:ref :form/r]
     (let [n (vector-count items)]
       (loop [i 0 s (form-form-set (form-no-forms))]
         (if (>= i n)
           s
           (recur (inc i) (set-add s (typed-list-nth [:list [:ref :form/r]] items i))))))))

#?(:kotoba
   (defn- rewrite-with-regions [f [:ref :form/r] regions [:ref :form/r] counter :i64 used [:ref :form/r]] [:ref :vr/rw]
     (cond
       (form-is-seq? f)
       (let [op (form-first-of f)
             argf (form-form-seq (form-rest-list f))
             read (rewrite-read op argf regions counter used)]
         (cond
           (not (form-is-nil? (rw-form read))) read
           (sym-is? op "let") (rewrite-let argf regions counter used)
           :else (let [r (rewrite-each (form-kids-of f) regions counter used)]
                   (rw (form-form-seq (form-kids-of (rw-form r))) (rw-n r)))))
       (form-is-vec? f)
       (let [r (rewrite-each (form-kids-of f) regions counter used)]
         (rw (rw-form r) (rw-n r)))
       (form-is-map? f)
       (let [r (rewrite-each (form-kids-of f) regions counter used)]
         (rw (rebuild-map (form-kids-of (rw-form r))) (rw-n r)))
       (form-is-set? f)
       (let [r (rewrite-each (form-kids-of f) regions counter used)]
         (rw (rebuild-set (form-kids-of (rw-form r))) (rw-n r)))
       :else (rw f counter))))



#?(:kotoba
   (defn- rewrite* [f [:ref :form/r] counter :i64 used [:ref :form/r]] [:ref :vr/rw]
     (let [items (constructor-items f)]
       (if (not (form-is-nil? items))
         (let [r (rewrite*-each (form-kids-of items) counter used)]
           (rw (form-form-seq (form-cons-onto (form-first-of f) (form-kids-of (rw-form r)))) (rw-n r)))
         (rewrite-with-regions f (form-form-map (form-no-forms)) counter used))))
   :default
   (defn- rewrite* [form state used]
     (if-let [items (constructor-items form)]
       ;; Immediate non-escaping consumer handling happens at the parent.  A bare
       ;; constructor remains materialized because it escapes.
       (apply list (first form) (map #(rewrite* % state used) items))
       (rewrite-with-regions form {} state used))))



#?(:kotoba
   (defn rewrite-expression [f [:ref :form/r]] [:ref :form/r]
     (rw-form (rewrite* f 0 (all-symbols f))))
   :default
   (defn rewrite-expression [form]
     (let [used (all-symbols form)] (rewrite* form (atom 0) used))))



#?(:kotoba
   (defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r] (form-form-get m (form-keyword-form k)))
   :default
   (defn rewrite-program [kir]
     (update kir :functions
             (fn [functions]
               (mapv #(update % :body rewrite-expression) functions)))))

#?(:kotoba
   (defn- rewrite-functions [functions [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [n (vector-count functions)]
       (loop [i 0 acc (form-no-forms)]
         (if (>= i n)
           acc
           (let [fn-form (typed-list-nth [:list [:ref :form/r]] functions i)]
             (recur (inc i)
                    (form-append-form acc (form-assoc-form fn-form (form-keyword-form :body)
                                                           (rewrite-expression (fget fn-form :body)))))))))))

#?(:kotoba
   (defn rewrite-program [kir [:ref :form/r]] [:ref :form/r]
     (form-assoc-form kir (form-keyword-form :functions)
                      (form-form-vec (rewrite-functions (form-kids-of (fget kir :functions)))))))
