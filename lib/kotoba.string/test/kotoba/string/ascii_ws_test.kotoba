(ns kotoba.string.ascii-ws-test
  (:export [main])
  (:require [kotoba.string.ascii-ws :as w]))

(defn- check [ok :bool] :i64 (if ok 0 1))

(defn main [] :i64
  (+ (check (w/ascii-ws? 32))
     (check (w/ascii-ws? 9))
     (check (w/ascii-ws? 10))
     (check (w/ascii-ws? 13))
     (check (w/ascii-ws? 12))
     (check (w/ascii-ws? 11))
     (check (not (w/ascii-ws? 0)))
     (check (not (w/ascii-ws? 65)))
     (check (not (w/ascii-ws? 160)))
     (check (not (w/ascii-ws? 12288)))
     (check (not (w/ascii-ws? 33)))))
