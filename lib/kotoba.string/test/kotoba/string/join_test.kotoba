;; Test for kotoba.string.join. main returns the number of failed cases.
(ns kotoba.string.join-test
  (:export [main])
  (:require [kotoba.string.join :as j]))

(defn- chk-str [got :string want :string] :i64
  (if (string=? got want) 0 1))

(defn main [] :i64
  (let [c1 (chk-str (j/join ", " (document-vector (document-string "a") (document-string "b") (document-string "c"))) "a, b, c")
        c2 (chk-str (j/join-all (document-vector (document-string "x") (document-null) (document-i64 1))) "x1")
        c3 (chk-str (j/join "-" (document-vector)) "")
        c4 (chk-str (j/join "-" (document-vector (document-null))) "")
        c5 (chk-str (j/join-all (document-vector (document-string "a"))) "a")
        c6 (chk-str (j/join "" (document-null)) "")
        c7 (chk-str (j/join "/" (document-vector (document-i64 1) (document-i64 22))) "1/22")]
    (+ c1 (+ c2 (+ c3 (+ c4 (+ c5 (+ c6 c7))))))))
