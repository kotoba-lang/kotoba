;; Test for kotoba.string.pad. main returns the number of failed cases.
(ns kotoba.string.pad-test
  (:export [main])
  (:require [kotoba.string.pad :as p]))

(defn- chk [ok :bool] :i64
  (if ok 0 1))

(defn- first-three [] :i64
  (+ (chk (string=? (p/pad "ab" 5 false "x") "xxxab"))
     (+ (chk (string=? (p/pad "ab" 5 true "x") "abxxx"))
        (chk (string=? (p/pad "abc" 2 false "x") "abc")))))

(defn main [] :i64
  (+ (first-three)
     (+ (chk (string=? (p/pad "" 3 false "-") "---"))
        (+ (chk (string=? (p/pad "a" 4 false "ab") "abababa"))
           (+ (chk (string=? (p/pad "x" 1 true "-") "x"))
              (chk (string=? (p/pad "" 0 true "-") "")))))))
