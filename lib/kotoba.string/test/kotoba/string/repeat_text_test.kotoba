(ns kotoba.string.repeat-text-test
  (:export [main])
  (:require [kotoba.string.repeat-text :as r]))

(defn- check [ok :bool] :i64 (if ok 0 1))

(defn main [] :i64
  (+ (check (= (r/repeat-text "ab" 3) "ababab"))
     (check (= (r/repeat-text "ab" 1) "ab"))
     (check (= (r/repeat-text "ab" 0) ""))
     (check (= (r/repeat-text "ab" -2) ""))
     (check (= (r/repeat-text "" 4) ""))
     (check (= (r/repeat-text "x" 5) "xxxxx"))))
