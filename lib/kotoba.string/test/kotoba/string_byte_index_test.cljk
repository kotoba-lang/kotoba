(ns kotoba.string-byte-index-test
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.string.byte-index-to-codepoint-index :as index]))

(deftest utf8-offsets-must-land-on-complete-codepoints
  (let [codepoints [0x41 0xe9 0x1f600]]
    (is (= [0 1 nil 2 nil nil nil 3 nil]
           (mapv #(index/byte-index->codepoint-index codepoints %) (range 9))))
    (is (nil? (index/byte-index->codepoint-index codepoints -1)))
    (is (= 0 (index/byte-index->codepoint-index [] 0)))
    (is (nil? (index/byte-index->codepoint-index [] 1)))))
