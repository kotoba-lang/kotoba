(ns kotoba.string.pad-right-text
  "pad-right-text -- one definition, addressed on its own.

  Split out of kotoba.lang.text on 2026-09-09. The unit here is the
  DEFINITION, not the library: this repo holds pad-right-text and names, in its
  deps.edn, exactly the definitions pad-right-text reaches. Nothing else."
  (:require [kotoba.string.codepoints-of :refer [codepoints-of]]))

(defn pad-right-text
  "Oracle for the kernel's pad-right-text: append fill until width."
  [s width fill]
  (let [w (count (codepoints-of s))]
    (if (>= w width)
      s
      (if (empty? fill)
        s
        (loop [acc s]
          (if (>= (count (codepoints-of acc)) width)
            acc
            (recur (str acc fill))))))))
