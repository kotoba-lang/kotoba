(ns kotoba.string.blank
  "blank? -- one definition, addressed on its own.

  Split out of kotoba.lang.text on 2026-09-09. The unit here is the
  DEFINITION, not the library: this repo holds blank? and names, in its
  deps.edn, exactly the definitions blank? reaches. Nothing else."
  (:require [kotoba.string.trim :refer [trim]]))

(defn blank?
  "True if `s` is nil, empty, or contains only whitespace."
  [s] (or (nil? s) (= "" (trim s))))
