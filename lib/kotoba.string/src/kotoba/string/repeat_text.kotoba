;; Kotoba port of lib/kotoba.string/src/kotoba/string/repeat_text.cljk.
;;
;; Named divergence: the .cljk uses (apply str (repeat times s)), where
;; clojure.core/repeat is lazy. The port concatenates in a counted loop; the
;; result is the same for every times (zero or negative answers "").
(ns kotoba.string.repeat-text
  (:export [repeat-text]))

(defn repeat-text [s :string times :i64] :string
  (loop [i 0 acc ""]
    (if (< i times)
      (recur (+ i 1) (str acc s))
      acc)))
