;; Port of kotoba.string.pad (pad.cljk), Kotoba-native.
;;
;; Named divergences:
;;   - the source takes `fill` as a char and repeats it; this port takes a
;;     string and repeats it (identical for one-character fills).
;;   - the width is measured with string-length (code points); the source
;;     uses Clojure count (UTF-16 units). They agree for BMP text.
;;   - `left?` keeps the source's meaning: true appends the padding after s,
;;     false (the default in callers) prepends it.
(ns kotoba.string.pad
  (:export [pad]))

(defn- repeat-str [fill :string n :i64] :string
  (loop [i 0 acc ""]
    (if (>= i n)
      acc
      (recur (+ i 1) (string-concat acc fill)))))

(defn pad [s :string width :i64 left? :bool fill :string] :string
  (let [n (- width (string-length s))]
    (if (> n 0)
      (let [p (repeat-str fill n)]
        (if left? (string-concat s p) (string-concat p s)))
      s)))
