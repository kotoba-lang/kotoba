(ns kotoba.string.codepoints-of
  "codepoints-of -- one definition, addressed on its own.

  Split out of kotoba.lang.text on 2026-09-09. The unit here is the
  DEFINITION, not the library: this repo holds codepoints-of and names, in its
  deps.edn, exactly the definitions codepoints-of reaches. Nothing else."
  (:require [kotoba.string.codepoints :refer [codepoints]]))

(defn codepoints-of
  "Code points of s as a vector (text/codepoints, reused here so the oracle
  and kernel walk the same sequence)."
  [s]
  (codepoints s))
