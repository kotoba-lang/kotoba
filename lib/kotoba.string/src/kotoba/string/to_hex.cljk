(ns kotoba.string.to-hex
  "to-hex -- one definition, addressed on its own.

  Split out of kotoba.lang.text on 2026-09-09. The unit here is the
  DEFINITION, not the library: this repo holds to-hex and names, in its
  deps.edn, exactly the definitions to-hex reaches. Nothing else."
  )

(defn to-hex [n]
  #?(:clj (Long/toHexString (long n))
     :cljs (.toString (long n) 16)))
