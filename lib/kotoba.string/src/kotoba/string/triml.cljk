(ns kotoba.string.triml
  "triml -- one definition, addressed on its own.

  Split out of kotoba.lang.text on 2026-09-09. The unit here is the
  DEFINITION, not the library: this repo holds triml and names, in its
  deps.edn, exactly the definitions triml reaches. Nothing else."
  (:require [kotoba.string.java-whitespace :refer [java-whitespace?]]))

(defn triml
  "Remove whitespace from the left end of `s`."
  [s]
  (let [s (str s) n (count s)]
    (loop [l 0]
      (if (and (< l n) (java-whitespace? (nth s l)))
        (recur (inc l))
        (subs s l)))))
