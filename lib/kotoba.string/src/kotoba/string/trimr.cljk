(ns kotoba.string.trimr
  "trimr -- one definition, addressed on its own.

  Split out of kotoba.lang.text on 2026-09-09. The unit here is the
  DEFINITION, not the library: this repo holds trimr and names, in its
  deps.edn, exactly the definitions trimr reaches. Nothing else."
  (:require [kotoba.string.java-whitespace :refer [java-whitespace?]]))

(defn trimr
  "Remove whitespace from the right end of `s`."
  [s]
  (let [s (str s)]
    (loop [r (count s)]
      (if (and (pos? r) (java-whitespace? (nth s (dec r))))
        (recur (dec r))
        (subs s 0 r)))))
