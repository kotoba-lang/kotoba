(ns kotoba.string.starts-with
  "starts-with? -- one definition, addressed on its own.

  Split out of kotoba.lang.text on 2026-09-09. The unit here is the
  DEFINITION, not the library: this repo holds starts-with? and names, in its
  deps.edn, exactly the definitions starts-with? reaches. Nothing else."
  )

(defn starts-with? [s prefix]
  #?(:clj  (.startsWith ^String (str s) ^String (str prefix))
     :cljs (.startsWith (str s) (str prefix))))
