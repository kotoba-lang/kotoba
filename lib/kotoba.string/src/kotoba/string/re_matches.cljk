(ns kotoba.string.re-matches
  "re-matches -- one definition, addressed on its own.

  Split out of kotoba.lang.text on 2026-09-09. The unit here is the
  DEFINITION, not the library: this repo holds re-matches and names, in its
  deps.edn, exactly the definitions re-matches reaches. Nothing else."
  (:refer-clojure :exclude [re-matches])
  )

(defn re-matches [re s] (#?(:clj clojure.core/re-matches :cljs cljs.core/re-matches) re s))
