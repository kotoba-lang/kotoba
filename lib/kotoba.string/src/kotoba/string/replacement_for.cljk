(ns kotoba.string.replacement-for
  "replacement-for -- one definition, addressed on its own.

  Split out of kotoba.lang.text on 2026-09-09. The unit here is the
  DEFINITION, not the library: this repo holds replacement-for and names, in its
  deps.edn, exactly the definitions replacement-for reaches. Nothing else."
  (:require [kotoba.string.expand-template :refer [expand-template]]))

(defn replacement-for
  "The text one REGEX match contributes: a function is called with the match
  (the whole match when the pattern has no groups, the group vector when it
  has), a string is expanded as a template."
  [replacement groups]
  (if (fn? replacement)
    (str (replacement (if (= 1 (count groups)) (first groups) groups)))
    (expand-template replacement groups)))
