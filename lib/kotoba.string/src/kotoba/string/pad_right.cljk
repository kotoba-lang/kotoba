(ns kotoba.string.pad-right
  "pad-right -- one definition, addressed on its own.

  Split out of kotoba.lang.text on 2026-09-09. The unit here is the
  DEFINITION, not the library: this repo holds pad-right and names, in its
  deps.edn, exactly the definitions pad-right reaches. Nothing else."
  (:require [kotoba.string.join :refer [join]]
            [kotoba.string.pad :refer [pad]]))

(defn pad-right [s width ch] (let [pad (max 0 (- width (count s)))] (str s (join (repeat pad ch)))))
