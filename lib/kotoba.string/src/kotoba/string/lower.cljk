(ns kotoba.string.lower
  "lower -- one definition, addressed on its own.

  Split out of kotoba.lang.text on 2026-09-09. The unit here is the
  DEFINITION, not the library: this repo holds lower and names, in its
  deps.edn, exactly the definitions lower reaches. Nothing else."
  )

(defn lower
  "Lower-case `s` using the host's default locale."
  [s] #?(:clj (.toLowerCase ^String (str s)) :cljs (.toLowerCase (str s))))
