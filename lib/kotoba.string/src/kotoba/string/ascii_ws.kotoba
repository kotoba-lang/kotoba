;; Kotoba port of lib/kotoba.string/src/kotoba/string/ascii_ws.cljk.
;;
;; Named divergence: the .cljk tests membership in #{32 9 10 13 12 11}. The
;; kotoba js-browser subset rejects integer-set constants (E2116/E2124), so the
;; same six code points are spelled as a disjunction, as in the mmio precedent.
;; The ^long hint becomes the :i64 parameter type.
(ns kotoba.string.ascii-ws
  (:export [ascii-ws?]))

(defn ascii-ws? [cp :i64] :bool
  (or (= cp 32) (= cp 9) (= cp 10) (= cp 13) (= cp 12) (= cp 11)))
