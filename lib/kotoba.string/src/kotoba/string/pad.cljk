(ns kotoba.string.pad
  "pad -- one definition, addressed on its own.

  Split out of kotoba.lang.text on 2026-09-09. The unit here is the
  DEFINITION, not the library: this repo holds pad and names, in its
  deps.edn, exactly the definitions pad reaches. Nothing else."
  )

(defn pad
  "Pad `s` to `width` with `fill`, on the left unless `left?`."
  [s width left? fill]
  (let [n (- width (count s))]
    (if (pos? n)
      (let [p (apply str (repeat n fill))]
        (if left? (str s p) (str p s)))
      s)))
