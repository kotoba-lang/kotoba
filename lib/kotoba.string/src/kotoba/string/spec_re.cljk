(ns kotoba.string.spec-re
  "spec-re -- one definition, addressed on its own.

  Split out of kotoba.lang.text on 2026-09-09. The unit here is the
  DEFINITION, not the library: this repo holds spec-re and names, in its
  deps.edn, exactly the definitions spec-re reaches. Nothing else."
  )

(def spec-re #"%([-+ 0#]*)(\d+)?(?:\.(\d+))?([a-zA-Z%])")
