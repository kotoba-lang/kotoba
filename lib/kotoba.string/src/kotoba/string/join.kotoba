;; Port of kotoba.string.join (join.cljk), Kotoba-native.
;; Named divergences:
;;   - the source is variadic (1- and 2-arity). amu cannot export multi-arity
;;     fns (E2138), so this module exports join (sep, coll) and join-all (coll).
;;   - coll is a :document vector (a null coll is empty). nil items render as
;;     "" as in the source; strings as their text; integers as decimal; other
;;     items as their canonical EDN text (the source uses str).
(ns kotoba.string.join
  (:export [join join-all]))

(defn- size [coll :document] :i64
  (if (= (document-kind coll) :null) 0 (document-count coll)))

(defn- elem [coll :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at coll i) (document-null)))

(defn- item-text [x :document] :string
  (if (= (document-kind x) :null)
    ""
    (if (= (document-kind x) :string)
      (option-value-of [:option :string] (document-string-value x) "")
      (if (= (document-kind x) :i64)
        (string-from-i64 (option-value-of [:option :i64] (document-i64-value x) 0))
        (document-edn-print x)))))

(defn- join-loop [sep :string coll :document i :i64 acc :string] :string
  (if (>= i (size coll))
    acc
    (let [piece (item-text (elem coll i))
          acc2 (if (= i 0) piece (string-concat (string-concat acc sep) piece))]
      (join-loop sep coll (+ i 1) acc2))))

(defn join [sep :string coll :document] :string
  (join-loop sep coll 0 ""))

(defn join-all [coll :document] :string
  (join-loop "" coll 0 ""))
