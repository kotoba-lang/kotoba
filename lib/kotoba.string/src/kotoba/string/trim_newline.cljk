(ns kotoba.string.trim-newline
  "trim-newline -- one definition, addressed on its own.

  Split out of kotoba.lang.text on 2026-09-09. The unit here is the
  DEFINITION, not the library: this repo holds trim-newline and names, in its
  deps.edn, exactly the definitions trim-newline reaches. Nothing else."
  (:require [kotoba.string.ends-with :refer [ends-with?]]))

(defn trim-newline
  "Remove trailing newline (\\n) or carriage-return+newline (\\r\\n) from `s`."
  [s]
  (let [s (str s)]
    (cond
      (ends-with? s "\r\n") (subs s 0 (- (count s) 2))
      (ends-with? s "\n")    (subs s 0 (dec (count s)))
      (ends-with? s "\r")    (subs s 0 (dec (count s)))
      :else s)))
