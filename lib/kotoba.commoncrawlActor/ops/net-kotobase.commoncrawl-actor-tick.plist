<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  net-kotobase.commoncrawl-actor-tick — one commoncrawl-actor tick: attempt
  up to `--budget` (1) seeds from resources/seeds.edn (fetch -> advise ->
  govern -> commit | hold), then, if anything committed, one batched
  Iceberg sync to R2 Data Catalog.

  Hourly, per this repo's own docs/operator-guide.md recommendation
  ("hourly or daily with --budget 1-3"). The actor's own budget cap and
  seed-scope Governor (commoncrawl.policy) are what keep this small and
  bounded -- this plist just supplies the clock.

  The logic lives in bin/scheduled.cljk, not here -- launchctl needs
  bootout/bootstrap on every plist edit, so a plist that carries decisions
  is a plist nobody fixes (same rule cloud-itonami/otent's own tick plist
  states).

  install:
    cp ops/net-kotobase.commoncrawl-actor-tick.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/net-kotobase.commoncrawl-actor-tick.plist
  watch:
    tail -40 /tmp/commoncrawl-actor-tick.log
  stop:
    launchctl bootout gui/$(id -u)/net-kotobase.commoncrawl-actor-tick
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net-kotobase.commoncrawl-actor-tick</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/junkawasaki/github/com-junkawasaki/orgs/net-kotobase/commoncrawl-actor &amp;&amp; exec /opt/homebrew/bin/nbb bin/scheduled.cljk</string>
  </array>

  <key>StartInterval</key>
  <integer>3600</integer>

  <!-- Not at load. A bootstrap during an edit should not fire a tick. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/commoncrawl-actor-tick.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/commoncrawl-actor-tick.err</string>

  <!-- A budget-1 tick is a handful of network calls; five minutes is
       already generous, not a measured ceiling. -->
  <key>ExitTimeOut</key>
  <integer>300</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
