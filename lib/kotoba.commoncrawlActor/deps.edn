{:paths ["src" "resources"]
 ;; Pinned as git deps (not :local/root) so this actor resolves standalone
 ;; from a clean clone with no monorepo siblings present — same convention
 ;; org-chainagnostic-cacao's deps.edn documents (ADR-2607022400). SHAs are
 ;; each sibling repo's origin/main HEAD as of 2026-07-19.
 :deps {
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/langgraph {:local/root "../kotoba.langgraph"}
        io.github.kotoba-lang/langchain-store {:local/root "../kotoba.langchainStore"}
        io.github.kotoba-lang/org-chainagnostic-cacao {:local/root "../org.chainagnostic.cacao"}
        io.github.kotoba-lang/org-ietf-ed25519 {:local/root "../org.ietf.ed25519"}
        io.github.kotoba-lang/org-ietf-cbor {:local/root "../org.ietf.cbor"}}
 :aliases
 {;; Monorepo-local dev/test — resolve every sibling from the west-managed
  ;; sibling checkouts. This repo lives at orgs/net-kotobase/commoncrawl-actor
  ;; since the 2026-08 transfer, while every sibling below is still a
  ;; kotoba-lang project — so these are ../../kotoba-lang/<name>, not ../<name>
  ;; (the same layout gftd-talent-actor's :dev alias and
  ;; org-chainagnostic-cacao's :local alias both use).
  :dev {:override-deps
        {io.github.kotoba-lang/langgraph
        {:local/root "../../../../kotoba-lang/kotoba/lib/kotoba.langgraph"}
         io.github.kotoba-lang/langchain-store
        {:local/root "../../../../kotoba-lang/kotoba/lib/kotoba.langchainStore"}
         io.github.kotoba-lang/org-chainagnostic-cacao
        {:local/root "../../../../kotoba-lang/kotoba/lib/org.chainagnostic.cacao"}
         io.github.kotoba-lang/org-ietf-ed25519
        {:local/root "../../../../kotoba-lang/kotoba/lib/org.ietf.ed25519"}
         io.github.kotoba-lang/org-ietf-cbor
        {:local/root "../../../../kotoba-lang/kotoba/lib/org.ietf.cbor"}
         ;; langchain is langgraph's own transitive dep; pin the same local
         ;; checkout so the whole graph resolves from one workspace.
         io.github.kotoba-lang/langchain
        {:local/root "../../../../kotoba-lang/kotoba/lib/kotoba.langchain"}}}
  :test {:extra-paths ["test"]}}}
