(ns kotoba.webrtc.room-test (:export [main]) (:require [kotoba.webrtc.room :as p]))

(defn- str [s :string] :document (document-string s))
(defn- has? [s :document x :document] :i64
  (if (document-set-contains? s x) 0 1))
(defn- absent [s :document x :document] :i64
  (if (document-set-contains? s x) 1 0))
(defn- n-of [s :document] :i64
  (if (document-equal? s (document-null)) -1 (document-count s)))

(defn- case-create-join [] :i64
  (let [r (p/create-room (str "r1"))
        r2 (p/join (p/join (p/join r (str "a")) (str "b")) (str "a"))
        ids (p/participant-ids r2)]
    (+ (if (document-equal? (option-or (document-get r (document-keyword :webrtc.room/room-id)) (document-null)) (str "r1")) 0 1)
       (if (= (n-of (p/participant-ids r)) 0) 0 1)
       (if (= (n-of ids) 2) 0 1)
       (has? ids (str "a"))
       (has? ids (str "b"))
       (absent ids (str "z")))))

(defn- case-tracks [] :i64
  (let [r (p/join (p/join (p/create-room (str "r1")) (str "a")) (str "b"))
        r2 (p/publish-track (p/publish-track (p/publish-track r (str "a") (str "t1")) (str "a") (str "t2")) (str "a") (str "t1"))
        r3 (p/publish-track r2 (str "x") (str "t9"))
        r4 (p/unpublish-track r2 (str "a") (str "t1"))
        t-a (p/tracks-of r2 (str "a"))]
    (+ (if (= (n-of t-a) 2) 0 1)
       (has? t-a (str "t1"))
       (has? t-a (str "t2"))
       (if (= (n-of (p/tracks-of r3 (str "x"))) -1) 0 1)
       (if (= (n-of (p/tracks-of r4 (str "a"))) 1) 0 1)
       (has? (p/tracks-of r4 (str "a")) (str "t2"))
       (if (= (n-of (p/tracks-of r2 (str "b"))) 0) 0 1)
       (if (document-equal? (p/tracks-of r r4) (p/tracks-of r r4)) 0 1))))

(defn- case-subscribe [] :i64
  (let [r (p/join (p/join (p/create-room (str "r1")) (str "a")) (str "b"))
        s1 (p/subscribe r (str "a") (str "b"))
        s-self (p/subscribe s1 (str "a") (str "a"))
        s-unknown (p/subscribe s1 (str "a") (str "z"))
        subs-b (p/subscribers-of s1 (str "b"))
        s2 (p/unsubscribe s1 (str "a") (str "b"))]
    (+ (if (= (n-of subs-b) 1) 0 1)
       (has? subs-b (str "a"))
       (if (= (n-of (p/subscribers-of s-self (str "a"))) 0) 0 1)
       (if (= (n-of (p/subscribers-of s-unknown (str "z"))) 0) 0 1)
       (if (= (n-of (p/subscribers-of s2 (str "b"))) 0) 0 1))))

(defn- case-leave [] :i64
  (let [r (p/join (p/join (p/create-room (str "r1")) (str "a")) (str "b"))
        s (p/subscribe (p/subscribe r (str "a") (str "b")) (str "b") (str "a"))
        l (p/leave s (str "b"))]
    (+ (if (= (n-of (p/participant-ids l)) 1) 0 1)
       (has? (p/participant-ids l) (str "a"))
       (if (= (n-of (p/subscribers-of l (str "a"))) 0) 0 1)
       (if (= (n-of (p/subscribers-of l (str "b"))) 0) 0 1)
       (if (document-equal? (p/tracks-of l (str "b")) (document-null)) 0 1))))

(defn main [] :i64
  (+ (case-create-join) (case-tracks) (case-subscribe) (case-leave)))
