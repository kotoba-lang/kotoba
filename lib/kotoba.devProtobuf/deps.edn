{:paths ["src"]
 ;; Wire format only — no .proto parser, no descriptors, no codegen, no deps.
 ;; A schema is an ordinary EDN map from field number to descriptor, so it sits
 ;; next to the spec it came from instead of in generated output.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
