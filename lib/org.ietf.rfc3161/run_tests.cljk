;; The portable half of this library, on nbb (SCI).
;;
;; The JVM suite is `.clj` because it verifies real signatures through JCA, and
;; that is where the crypto belongs — the verify function is injected precisely
;; so this library holds none. What is portable is everything up to the
;; signature: parsing, structure, the refusals. This runs THAT on ClojureScript
;; against the same fixtures.
;;
;; A smaller claim than the JVM job makes, stated as one.
(ns run-tests
  (:require [asn1.core :as asn1]
            [asn1.oid :as oid]
            [rfc3161.core :as ts]
            [x509.core :as x509]
            ["crypto" :as node-crypto]))

(def failures (atom 0))
(defn check [label expected actual]
  (if (= expected actual)
    (println "  ok  " label)
    (do (swap! failures inc)
        (println "  FAIL" label "expected" (pr-str expected) "got" (pr-str actual)))))
(defn check-throws [label f]
  (if (try (f) false (catch :default _ true))
    (println "  ok  " label)
    (do (swap! failures inc) (println "  FAIL" label "did not throw"))))
(defn done! []
  (println "\nnbb:" @failures "failures")
  (when (pos? @failures) (js/process.exit 1)))

;; Node's crypto as the injected `digest-fn`. In the JVM suite this is
;; `cms.jvm/digest`; the point of injection is that neither is inside the
;; library.
(defn digest-fn [algorithm data]
  (let [h (.createHash node-crypto (case algorithm
                                     :sha256 "sha256" :sha384 "sha384"
                                     :sha512 "sha512" :sha1 "sha1"
                                     (throw (ex-info "unsupported" {:algorithm algorithm}))))]
    (.update h (js/Buffer.from (clj->js (vec (asn1/->ints data)))))
    (vec (js/Array.from (.digest h)))))

(def response (ts/parse-response (asn1/unhex "")))
(def token (ts/parse-token (:token-der response)))
(def digest (asn1/unhex "404d8f2246f3a6948de6aee686a6e3d116ed2eb56a74b9b1d3df75f2130203e2"))

(println "rfc3161 on nbb:")
(check "status" :granted (:status response))
(check "TSTInfo genTime" "2026-07-30T13:49:55Z" (:gen-time (:tst-info token)))
(check "messageImprint" (vec digest) (vec (:message-imprint (:tst-info token))))
(check "nonce came back" "7d82213101890cc3" (:nonce (:tst-info token)))
(check "eContentType is id-ct-TSTInfo" :ct-tst-info
       (oid/named (:cms/econtent-type (:signed-data token))))

;; The request encoder, byte-identical to `openssl ts -query` — the same
;; assertion the JVM suite makes, on the other platform.
(check "request is byte-identical to openssl's"
       "30430201013031300d060960864801650304020105000420404d8f2246f3a6948de6aee686a6e3d116ed2eb56a74b9b1d3df75f2130203e202087d82213101890cc30101ff"
       (asn1/hex (ts/request {:digest digest :nonce "7d82213101890cc3" :cert-req? true})))

(let [c (first (:cms/certificates (:signed-data token)))]
  (check "the TSA certificate qualifies" true (ts/timestamping-certificate? c))
  (check "and one that is ALSO a TLS key does not" false
         (ts/timestamping-certificate?
          (assoc c :x509/extensions
                 (mapv #(if (= :extended-key-usage (:name %))
                          (assoc % :der (asn1/encode-ints
                                         (asn1/sequence*
                                          [(asn1/oid (oid/dotted :kp-time-stamping))
                                           (asn1/oid "1.3.6.1.5.5.7.3.1")])))
                          %)
                       (:x509/extensions c))))))

(check-throws "no nonce is refused" #(ts/request {:digest digest}))
(check-throws "a nonce as a NUMBER is refused — 64 bits does not fit a JS number"
              #(ts/request {:digest digest :nonce 12345}))
(check-throws "a digest length that disagrees with its algorithm is refused"
              #(ts/request {:digest (asn1/unhex "aabb") :nonce "01"}))
(check-throws "verifying with no expected digest is a programming error"
              #(ts/verify-token token {:digest-fn digest-fn :verify-fn (constantly true)}))
(done!)
