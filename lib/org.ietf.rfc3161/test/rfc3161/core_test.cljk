(ns rfc3161.core-test
  "Against a request and response OpenSSL's `ts` produced, from a TSA whose
  certificate carries a critical `id-kp-timeStamping` EKU and nothing else."
  (:require [kotoba.test :refer [deftest is testing]]
            [asn1.core :as asn1]
            [asn1.oid :as oid]
            [cms.jvm :as jvm]
            [rfc3161.core :as ts]
            [x509.core :as x509]))

;; openssl ts -query -data data.txt -sha256 -cert
(def request-hex "30430201013031300d060960864801650304020105000420404d8f2246f3a6948de6aee686a6e3d116ed2eb56a74b9b1d3df75f2130203e202087d82213101890cc30101ff")

;; openssl ts -reply -queryfile req.tsq -config tsa.cnf
(def response-hex "")

;; sha256 of the timestamped content
(def digest (asn1/unhex "404d8f2246f3a6948de6aee686a6e3d116ed2eb56a74b9b1d3df75f2130203e2"))
(def nonce-hex "7d82213101890cc3")

(def response (ts/parse-response (asn1/unhex response-hex)))
(def token (ts/parse-token (:token-der response)))

(def opts {:digest digest :nonce nonce-hex
           :digest-fn jvm/digest :verify-fn jvm/verify})

(deftest request-is-what-openssl-asks-for
  (testing "byte-identical to `openssl ts -query -data … -sha256 -cert`"
    ;; The nonce is the one OpenSSL chose, passed in, because a library that
    ;; invents a nonce hands the caller something they cannot check.
    (is (= request-hex
           (asn1/hex (ts/request {:digest digest
                                  :digest-algorithm :sha256
                                  :nonce nonce-hex
                                  :cert-req? true}))))))

(deftest request-refuses-what-the-tsa-would-refuse-a-round-trip-later
  (testing "a digest whose length disagrees with its named algorithm"
    (is (thrown-with-msg? clojure.lang.ExceptionInfo #"32 bytes, got 20"
                          (ts/request {:digest (asn1/unhex (apply str (repeat 20 "aa")))
                                       :digest-algorithm :sha256
                                       :nonce "01"}))))
  (testing "a nonce given as a NUMBER is refused — 64 bits does not fit a JS number"
    (is (thrown-with-msg? clojure.lang.ExceptionInfo #"hex STRING"
                          (ts/request {:digest digest :nonce 12345}))))
  (testing "no nonce at all"
    (is (thrown-with-msg? clojure.lang.ExceptionInfo #"nonce is required"
                          (ts/request {:digest digest}))))
  (testing "an unnamed digest algorithm"
    (is (thrown? clojure.lang.ExceptionInfo
                 (ts/request {:digest digest :digest-algorithm :md5 :nonce "01"})))))

(deftest parses-the-response-and-the-token
  (testing "status"
    (is (= :granted (:status response)))
    (is (:success? response))
    (is (some? (:token-der response))))

  (testing "TSTInfo"
    (let [info (:tst-info token)]
      (is (= 1 (:version info)))
      (is (= "1.3.6.1.4.1.99999.1.1" (:policy info)))
      (is (= (oid/dotted :sha256) (:digest-algorithm info)))
      (is (= (vec digest) (vec (:message-imprint info))))
      (is (= "2026-07-30T13:49:55Z" (:gen-time info)))
      (is (= "02" (:serial-number info)))
      (is (= nonce-hex (:nonce info)))
      (is (true? (:ordering? info)))))

  (testing "the token is a CMS SignedData whose eContentType is id-ct-TSTInfo"
    (is (= :ct-tst-info (oid/named (:cms/econtent-type (:signed-data token)))))
    (is (= 2 (count (:cms/certificates (:signed-data token)))))))

(deftest a-non-timestamp-cms-message-is-not-a-token
  ;; The eContentType check that stops a signature over ordinary data being
  ;; presented as a timestamp.
  (is (thrown-with-msg? clojure.lang.ExceptionInfo #"not id-ct-TSTInfo"
                        (ts/parse-token
                         (asn1/unhex "")))))

(deftest verifies-the-real-token
  (let [result (ts/verify-token token opts)]
    (is (:verified result) (pr-str result))
    (is (= "2026-07-30T13:49:55Z" (:gen-time result)))
    (is (= "CN=Kotoba Test TSA,O=Kotoba Test,C=JP" (:tsa-subject result)))
    (is (true? (:tsa-certificate-valid-at-gen-time? result)))))

(deftest verified-and-trusted-are-different-answers
  ;; A structurally sound token signed by a certificate nobody vouched for is
  ;; exactly what an attacker produces with `openssl ts` and their own CA —
  ;; which is what this fixture IS. The cryptography is perfect.
  (testing "with no :trusted? the answer is :unknown, not true"
    (is (= :unknown (:trusted (ts/verify-token token opts))))
    (is (some? (ts/accredited-note (ts/verify-token token opts)))))

  (testing "an explicit :trusted? that says no leaves :verified true and :trusted false"
    (let [result (ts/verify-token token (assoc opts :trusted? (constantly false)))]
      (is (:verified result))
      (is (false? (:trusted result)))
      (is (some? (ts/accredited-note result)))))

  (testing "and only an explicit yes silences the note"
    (let [result (ts/verify-token token (assoc opts :trusted? (constantly true)))]
      (is (true? (:trusted result)))
      (is (nil? (ts/accredited-note result))))))

(deftest the-refusals
  (testing "a different digest — the token is about something else"
    (is (= :message-imprint-mismatch
           (:reason (ts/verify-token token (assoc opts :digest (asn1/unhex (apply str (repeat 32 "00")))))))))

  (testing "a nonce that did not come back means this is not an answer to this request"
    (is (= :nonce-mismatch
           (:reason (ts/verify-token token (assoc opts :nonce "0000000000000000"))))))

  (testing "no expected digest at all is a programming error, not a pass"
    (is (thrown-with-msg? clojure.lang.ExceptionInfo #"何も証明しません"
                          (ts/verify-token token (dissoc opts :digest)))))

  (testing "a tampered signature does not verify"
    (let [broken (update-in token [:signed-data :cms/signer-infos 0 :signer/signature]
                            (fn [s] (assoc (vec s) 8 (bit-xor (nth s 8) 0xff))))]
      (is (not (:verified (ts/verify-token broken opts))))))

  (testing "a tampered TSTInfo fails at messageDigest, before the time is believed"
    ;; The time lives in eContent, so changing it breaks the CMS messageDigest
    ;; link rather than the signature — which is exactly why that check exists.
    (let [swapped (assoc-in token [:signed-data :cms/econtent]
                            (asn1/->ints (assoc (vec (:cms/econtent (:signed-data token)))
                                                60 0x39)))
          result (ts/verify-token swapped opts)]
      (is (not (:verified result))))))

(deftest a-tsa-certificate-must-be-only-a-tsa-certificate
  (let [tsa-cert (first (:cms/certificates (:signed-data token)))]
    (testing "the fixture's leaf qualifies"
      (is (ts/timestamping-certificate? tsa-cert)))

    (testing "a certificate with no EKU does not, even though RFC 5280 reads absent as unrestricted"
      (is (not (ts/timestamping-certificate?
                (assoc tsa-cert :x509/extensions
                       (remove #(= :extended-key-usage (:name %))
                               (:x509/extensions tsa-cert)))))))

    (testing "a NON-critical timeStamping EKU does not — §2.3 says it must be critical"
      (is (not (ts/timestamping-certificate?
                (assoc tsa-cert :x509/extensions
                       (mapv #(if (= :extended-key-usage (:name %))
                                (assoc % :critical? false) %)
                             (:x509/extensions tsa-cert)))))))

    (testing "and a key that is ALSO a TLS server key does not — exclusivity is the point"
      (let [dual (assoc tsa-cert :x509/extensions
                        (mapv #(if (= :extended-key-usage (:name %))
                                 (assoc % :der (asn1/encode-ints
                                                (asn1/sequence*
                                                 [(asn1/oid (oid/dotted :kp-time-stamping))
                                                  (asn1/oid "1.3.6.1.5.5.7.3.1")])))
                                 %)
                              (:x509/extensions tsa-cert)))]
        (is (= 2 (count (x509/extended-key-usage dual))))
        (is (not (ts/timestamping-certificate? dual)))
        (is (= :not-a-timestamping-certificate
               (:reason (ts/verify-token
                         (assoc-in token [:signed-data :cms/certificates 0] dual)
                         opts))))))))

(deftest a-rejection-is-information-and-not-an-error
  ;; PKIStatus 2 with failureInfo badAlg.
  (let [rejected (ts/parse-response
                  (asn1/encode-ints
                   (asn1/sequence*
                    [(asn1/sequence* [(asn1/integer 2)
                                      (asn1/sequence* [(asn1/utf8-string "unsupported digest")])
                                      (asn1/bit-string [0x80] 7)])])))]
    (is (= :rejection (:status rejected)))
    (is (not (:success? rejected)))
    (is (nil? (:token-der rejected)))
    (is (= ["unsupported digest"] (:status-text rejected)))
    (is (= #{:bad-alg} (:failure-info rejected)))))
