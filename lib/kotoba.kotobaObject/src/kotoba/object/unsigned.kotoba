;; Natural-number container arithmetic, without a hosted bigint or float.
;; Explicit little-endian u32 limbs preserve arbitrary positive integer inputs.
(ns kotoba.object.unsigned
  {:kotoba/export [parse little-endian align-up]}
  (:schemas
   {:kotoba.object.unsigned/result
    [:record :kotoba.object.unsigned/result
     [[:words :vector-i64] [:bytes :vector-i64] [:value :document] [:error :keyword]]]}))

(defn- fail [error :keyword] [:ref :kotoba.object.unsigned/result]
  (record-new [:ref :kotoba.object.unsigned/result] (vector-alloc 0) (vector-alloc 0) (document-null) error))
(defn- lookup [m :document key :keyword] :document
  (if (not= (document-kind m) :map) (document-null)
    (loop [index 0]
      (if (>= index (document-count m)) (document-null)
        (let [pair (option-value-of [:option :document] (document-map-entry-at m index) (document-null))
              k (option-value-of [:option :document] (document-vector-at pair 0) (document-null))]
          (if (document-equal? k (document-keyword key))
            (option-value-of [:option :document] (document-vector-at pair 1) (document-null)) (recur (+ index 1))))))))
(defn- item [v :document index :i64] :document
  (option-value-of [:option :document] (document-vector-at v index) (document-null)))
(defn- i64-of [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) -1))
(defn- trim [words :vector-i64] :vector-i64
  (let [length (loop [end (vector-count words)]
                 (if (and (> end 1) (= (vector-at words (- end 1)) 0)) (recur (- end 1)) end))]
    (loop [index 0 out (vector-alloc 0)]
      (if (= index length) (if (= length 0) (vector-conj out 0) out)
        (recur (+ index 1) (vector-conj out (vector-at words index)))))))
(defn- as-document [words :vector-i64] :document
  (let [n (vector-count words) low (vector-at words 0)]
    (cond
      (= n 1) (document-i64 low)
      (and (= n 2) (<= (vector-at words 1) 2147483647))
      (document-i64 (+ low (* (vector-at words 1) 4294967296)))
      :else
      (document-map (document-keyword :kotoba.object/unsigned)
        (loop [index 0 out (document-vector)]
          (if (= index n) out (recur (+ index 1) (document-vector-conj out (document-i64 (vector-at words index))))))))))
(defn- result [words :vector-i64 bytes :vector-i64] [:ref :kotoba.object.unsigned/result]
  (let [normalized (trim words)]
    (record-new [:ref :kotoba.object.unsigned/result] normalized bytes (as-document normalized) :ok)))

(defn parse [value :document] [:ref :kotoba.object.unsigned/result]
  (if (= (document-kind value) :i64)
    (let [n (i64-of value)]
      (if (< n 0) (fail :unsigned-shape)
        (result (vector-conj (vector-conj (vector-alloc 0) (bit-and n 4294967295)) (u64-shift-right n 32)) (vector-alloc 0))))
    (let [full (lookup value :kotoba.object/unsigned) pair (lookup value :elf64/u64)
          limbs (if (= (document-kind full) :vector) full pair)]
      (if (or (not= (document-kind value) :map) (not= (document-count value) 1)
              (not= (document-kind limbs) :vector) (< (document-count limbs) 1)
              (and (not= (document-kind full) :vector) (not= (document-count pair) 2)))
        (fail :unsigned-shape)
        (loop [index 0 words (vector-alloc 0)]
          (if (= index (document-count limbs)) (result words (vector-alloc 0))
            (let [word (item limbs index)]
              (if (and (= (document-kind word) :i64) (>= (i64-of word) 0) (<= (i64-of word) 4294967295))
                (recur (+ index 1) (vector-conj words (i64-of word))) (fail :unsigned-shape)))))))))

;; PE's original public helper deliberately truncates high bits and accepts
;; every width 1..8. Strict formats must check their own width/range first.
(defn little-endian [value :document width :i64] [:ref :kotoba.object.unsigned/result]
  (if (or (< width 1) (> width 8)) (fail :integer-width)
    (let [parsed (parse value)]
      (if (not= (record-get [:ref :kotoba.object.unsigned/result] parsed :error) :ok) parsed
        (let [words (record-get [:ref :kotoba.object.unsigned/result] parsed :words)
              bytes (loop [index 0 out (vector-alloc 0)]
                      (if (= index width) out
                        (let [at (quot index 4) word (if (< at (vector-count words)) (vector-at words at) 0)]
                          (recur (+ index 1) (vector-conj out
                            (bit-and (u64-shift-right word (* 8 (- index (* at 4)))) 255))))))]
          (result words bytes))))))

(defn- add-small [words :vector-i64 value :i64] :vector-i64
  (let [length (if (< (vector-count words) 2) 2 (vector-count words))]
    (loop [index 0 carry 0 out (vector-alloc 0)]
      (if (and (>= index length) (= carry 0)) out
        (let [word (if (< index (vector-count words)) (vector-at words index) 0)
              extra (case index 0 (bit-and value 4294967295) 1 (u64-shift-right value 32) 0)
              sum (+ (+ word extra) carry)]
          (recur (+ index 1) (quot sum 4294967296) (vector-conj out (bit-and sum 4294967295))))))))
(defn align-up [value :document alignment :i64] [:ref :kotoba.object.unsigned/result]
  (cond
    (or (<= alignment 0) (not= (bit-and alignment (- alignment 1)) 0)) (fail :alignment)
    :else
    (let [parsed (parse value)]
      (if (not= (record-get [:ref :kotoba.object.unsigned/result] parsed :error) :ok) parsed
        (let [power (loop [n alignment exponent 0] (if (= n 1) exponent (recur (quot n 2) (+ exponent 1))))
              at (quot power 32) bits (- power (* at 32)) factor (i64-shift-left 1 bits)
              added (add-small (record-get [:ref :kotoba.object.unsigned/result] parsed :words) (- alignment 1))
              rounded (loop [index 0 out (vector-alloc 0)]
                        (if (= index (vector-count added)) out
                          (let [word (vector-at added index)]
                            (recur (+ index 1) (vector-conj out
                              (cond (< index at) 0 (= index at) (* (quot word factor) factor) :else word))))))]
          (result rounded (vector-alloc 0)))))))
