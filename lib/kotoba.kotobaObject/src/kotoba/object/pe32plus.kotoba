;; Whole canonical PE32+ record/image source candidate, with original limits.
(ns kotoba.object.pe32plus
  {:kotoba/export [align-up encode-image encode-optional-header encode-section-header little-endian machine-codes max-image-bytes max-section-count pad-to subsystem-codes]}
  (:require [kotoba.object.unsigned :as unsigned])
  (:schemas
   {:kotoba.object.pe32plus/result
    [:record :kotoba.object.pe32plus/result
     [[:bytes :vector-i64] [:value :document] [:error :keyword] [:field :keyword]]]
    :kotoba.object.pe32plus/section
    [:record :kotoba.object.pe32plus/section
     [[:rva :i64] [:virtual-size :i64] [:raw-size :i64] [:raw-offset :i64]
      [:bytes :vector-i64] [:header :vector-i64]]]
    :kotoba.object.pe32plus/sections
    [:record :kotoba.object.pe32plus/sections
     [[:rows [:list [:ref :kotoba.object.pe32plus/section]]] [:error :keyword] [:field :keyword]]]}))

(defn machine-codes [] :document
  (document-map (document-keyword :x86-64) (document-i64 34404) (document-keyword :aarch64) (document-i64 43620)))
(defn subsystem-codes [] :document (document-map (document-keyword :efi-application) (document-i64 10)))
(defn max-image-bytes [] :i64 67108864)
(defn max-section-count [] :i64 32)
(defn- ok [bytes :vector-i64] [:ref :kotoba.object.pe32plus/result]
  (record-new [:ref :kotoba.object.pe32plus/result] bytes (document-null) :ok :none))
(defn- fail [error :keyword field :keyword] [:ref :kotoba.object.pe32plus/result]
  (record-new [:ref :kotoba.object.pe32plus/result] (vector-alloc 0) (document-null) error field))
(defn- good? [r [:ref :kotoba.object.pe32plus/result]] :bool
  (= (record-get [:ref :kotoba.object.pe32plus/result] r :error) :ok))
(defn- bytes-of [r [:ref :kotoba.object.pe32plus/result]] :vector-i64
  (record-get [:ref :kotoba.object.pe32plus/result] r :bytes))
(defn- lookup [m :document key :document] :document
  (if (not= (document-kind m) :map) (document-null)
    (loop [index 0]
      (if (>= index (document-count m)) (document-null)
        (let [pair (option-value-of [:option :document] (document-map-entry-at m index) (document-null))]
          (if (document-equal? (option-value-of [:option :document] (document-vector-at pair 0) (document-null)) key)
            (option-value-of [:option :document] (document-vector-at pair 1) (document-null)) (recur (+ index 1))))))))
(defn- has? [m :document key :document] :bool
  (if (not= (document-kind m) :map) false
    (loop [index 0]
      (if (>= index (document-count m)) false
        (let [pair (option-value-of [:option :document] (document-map-entry-at m index) (document-null))]
          (if (document-equal? (option-value-of [:option :document] (document-vector-at pair 0) (document-null)) key)
            true (recur (+ index 1))))))))
(defn- get-key [m :document key :keyword] :document (lookup m (document-keyword key)))
(defn- field [m :document key :keyword fallback :document] :document
  (if (has? m (document-keyword key)) (get-key m key) fallback))
(defn- item [xs :document index :i64] :document
  (if (= (document-kind xs) :list)
    (option-value-of [:option :document] (document-list-at xs index) (document-null))
    (option-value-of [:option :document] (document-vector-at xs index) (document-null))))
(defn- i64-of [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) -1))
(defn- small-number [d :document limit :i64] :i64
  (let [r (unsigned/parse d) value (record-get [:ref :kotoba.object.unsigned/result] r :value)]
    (if (and (= (record-get [:ref :kotoba.object.unsigned/result] r :error) :ok)
             (= (document-kind value) :i64) (<= (i64-of value) limit)) (i64-of value) -1)))
(defn- from-unsigned [r [:ref :kotoba.object.unsigned/result] field :keyword] [:ref :kotoba.object.pe32plus/result]
  (if (not= (record-get [:ref :kotoba.object.unsigned/result] r :error) :ok)
    (fail (record-get [:ref :kotoba.object.unsigned/result] r :error) field)
    (record-new [:ref :kotoba.object.pe32plus/result]
      (record-get [:ref :kotoba.object.unsigned/result] r :bytes)
      (record-get [:ref :kotoba.object.unsigned/result] r :value) :ok :none)))
(defn little-endian [value :document width :i64] [:ref :kotoba.object.pe32plus/result]
  (let [r (unsigned/little-endian value width)]
    (from-unsigned r (if (= (record-get [:ref :kotoba.object.unsigned/result] r :error) :integer-width) :width :value))))
(defn align-up [value :document alignment :i64] [:ref :kotoba.object.pe32plus/result]
  (let [r (unsigned/align-up value alignment)]
    (from-unsigned r (if (= (record-get [:ref :kotoba.object.unsigned/result] r :error) :alignment) :alignment :value))))
(defn- power? [n :i64] :bool (and (> n 0) (= (bit-and n (- n 1)) 0)))
(defn- align-value [n :i64 a :i64] :i64
  (if (or (< n 0) (not (power? a))) -1
    (let [remainder (- n (* (quot n a) a)) extra (if (= remainder 0) 0 (- a remainder))]
      (if (> extra (- 9223372036854775807 n)) -1 (+ n extra)))))
(defn- join [a :vector-i64 b :vector-i64] :vector-i64
  (loop [index 0 out a]
    (if (>= index (vector-count b)) out (recur (+ index 1) (vector-conj out (vector-at b index))))))
(defn- append-result [out [:ref :kotoba.object.pe32plus/result] more [:ref :kotoba.object.pe32plus/result]]
  [:ref :kotoba.object.pe32plus/result]
  (cond
    (not (good? out)) out (not (good? more)) more
    (> (vector-count (bytes-of more)) (- (max-image-bytes) (vector-count (bytes-of out)))) (fail :image-limit :bytes)
    :else (ok (join (bytes-of out) (bytes-of more)))))
(defn- append-field [out [:ref :kotoba.object.pe32plus/result] value :document width :i64 key :keyword]
  [:ref :kotoba.object.pe32plus/result]
  (if (not (good? out)) out
    (let [r (little-endian value width)]
      (if (not (good? r)) (fail (record-get [:ref :kotoba.object.pe32plus/result] r :error) key) (append-result out r)))))
(defn- zeros [n :i64] :vector-i64
  (loop [index 0 out (vector-alloc 0)] (if (= index n) out (recur (+ index 1) (vector-conj out 0)))))
(defn pad-to [bytes :vector-i64 size :i64] [:ref :kotoba.object.pe32plus/result]
  (cond
    (or (< size 0) (> size (max-image-bytes))) (fail :region-allocation :size)
    (> (vector-count bytes) size) (fail :region-too-small :size)
    :else
    (let [valid? (loop [index 0]
                   (if (= index (vector-count bytes)) true
                     (let [b (vector-at bytes index)] (if (and (>= b 0) (<= b 255)) (recur (+ index 1)) false))))]
      (if (not valid?) (fail :invalid-byte :bytes)
        (loop [index (vector-count bytes) out bytes]
          (if (= index size) (ok out) (recur (+ index 1) (vector-conj out 0))))))))
(defn- pad-result [r [:ref :kotoba.object.pe32plus/result] size :i64] [:ref :kotoba.object.pe32plus/result]
  (if (good? r) (pad-to (bytes-of r) size) r))
(defn- byte-region [value :document] [:ref :kotoba.object.pe32plus/result]
  (cond
    (= (document-kind value) :null) (ok (vector-alloc 0))
    (= (document-kind value) :bytes)
    (let [bytes (option-value-of [:option :bytes] (document-bytes-value value) (bytes-empty))]
      (if (> (bytes-count bytes) (max-image-bytes)) (fail :image-limit :bytes)
        (loop [index 0 out (vector-alloc 0)]
          (if (= index (bytes-count bytes)) (ok out) (recur (+ index 1) (vector-conj out (bytes-at bytes index)))))))
    (not (or (= (document-kind value) :vector) (= (document-kind value) :list))) (fail :byte-region :bytes)
    (> (document-count value) (max-image-bytes)) (fail :image-limit :bytes)
    :else (loop [index 0 out (vector-alloc 0)]
            (if (= index (document-count value)) (ok out)
              (let [v (item value index) b (i64-of v)]
                (if (and (= (document-kind v) :i64) (>= b 0) (<= b 255))
                  (recur (+ index 1) (vector-conj out b)) (fail :invalid-byte :bytes)))))))
(defn- name-bytes [value :document] [:ref :kotoba.object.pe32plus/result]
  (let [text (option-value-of [:option :string] (document-string-value value) "") bytes (string-to-utf8 text)]
    (if (or (not= (document-kind value) :string) (< (bytes-count bytes) 1) (> (bytes-count bytes) 8))
      (fail :section-name :name)
      (loop [index 0 out (vector-alloc 0)]
        (if (= index (bytes-count bytes)) (pad-to out 8)
          (let [b (bytes-at bytes index)]
            (if (and (>= b 32) (<= b 126)) (recur (+ index 1) (vector-conj out b)) (fail :section-name :name))))))))

(defn encode-section-header [opts :document] [:ref :kotoba.object.pe32plus/result]
  (let [keys (document-vector (document-keyword :virtual-size) (document-keyword :rva)
               (document-keyword :raw-size) (document-keyword :raw-offset) (document-keyword :characteristics))
        invalid (loop [index 0]
                  (if (= index 5) :none
                    (let [key (option-value-of [:option :keyword] (document-keyword-value (item keys index)) :none)]
                      (if (< (small-number (get-key opts key) 4294967295) 0) key (recur (+ index 1))))))]
    (cond
      (not= (document-kind opts) :map) (fail :options-shape :options)
      (not= invalid :none) (fail :section-field invalid)
      :else (-> (name-bytes (get-key opts :name))
                (append-field (get-key opts :virtual-size) 4 :virtual-size) (append-field (get-key opts :rva) 4 :rva)
                (append-field (get-key opts :raw-size) 4 :raw-size) (append-field (get-key opts :raw-offset) 4 :raw-offset)
                (append-result (ok (zeros 12))) (append-field (get-key opts :characteristics) 4 :characteristics)))))
(defn- directory [directories :document index :i64] :document
  (cond
    (and (= (document-kind directories) :vector) (< index (document-count directories))) (item directories index)
    (and (= (document-kind directories) :map) (has? directories (document-i64 index))) (lookup directories (document-i64 index))
    :else (document-map (document-keyword :rva) (document-i64 0) (document-keyword :size) (document-i64 0))))
(defn encode-optional-header [opts :document] [:ref :kotoba.object.pe32plus/result]
  (let [subsystem (lookup (subsystem-codes) (get-key opts :subsystem))
        file-alignment (small-number (get-key opts :file-alignment) 9223372036854775807)
        text (align-up (get-key opts :text-size) file-alignment)
        directories (get-key opts :data-directories) zero (document-i64 0)]
    (cond
      (not= (document-kind opts) :map) (fail :options-shape :options)
      (= (document-kind subsystem) :null) (fail :unsupported-subsystem :subsystem)
      (not (good? text)) (fail (record-get [:ref :kotoba.object.pe32plus/result] text :error)
                         (if (= (record-get [:ref :kotoba.object.pe32plus/result] text :field) :alignment) :file-alignment :text-size))
      (not (or (= (document-kind directories) :null) (= (document-kind directories) :vector)
               (= (document-kind directories) :map))) (fail :directories-shape :data-directories)
      :else
      (let [fixed (-> (ok (vector-alloc 0)) (append-field (document-i64 523) 2 :magic) (append-result (ok (zeros 2)))
                      (append-field (record-get [:ref :kotoba.object.pe32plus/result] text :value) 4 :text-size)
                      (append-field (get-key opts :initialized-size) 4 :initialized-size) (append-field zero 4 :uninitialized-size)
                      (append-field (get-key opts :entry-rva) 4 :entry-rva) (append-field (get-key opts :text-rva) 4 :text-rva)
                      (append-field (get-key opts :image-base) 8 :image-base)
                      (append-field (get-key opts :section-alignment) 4 :section-alignment)
                      (append-field (get-key opts :file-alignment) 4 :file-alignment)
                      (append-field (document-i64 2) 2 :os-major) (append-field zero 2 :os-minor)
                      (append-field zero 2 :image-major) (append-field zero 2 :image-minor)
                      (append-field (document-i64 2) 2 :subsystem-major) (append-field zero 2 :subsystem-minor)
                      (append-field zero 4 :win32-version) (append-field (get-key opts :image-size) 4 :image-size)
                      (append-field (get-key opts :headers-size) 4 :headers-size) (append-field zero 4 :checksum)
                      (append-field subsystem 2 :subsystem) (append-field (get-key opts :dll-characteristics) 2 :dll-characteristics)
                      (append-field (get-key opts :stack-reserve) 8 :stack-reserve) (append-field (get-key opts :stack-commit) 8 :stack-commit)
                      (append-field (get-key opts :heap-reserve) 8 :heap-reserve) (append-field (get-key opts :heap-commit) 8 :heap-commit)
                      (append-field zero 4 :loader-flags) (append-field (document-i64 16) 4 :directory-count))]
        (if (not (good? fixed)) fixed
          (if (not= (vector-count (bytes-of fixed)) 112) (fail :optional-layout :optional-header)
            (loop [index 0 out fixed]
              (if (or (= index 16) (not (good? out))) out
                (let [d (directory directories index)]
                  (if (not= (document-kind d) :map) (fail :directory-entry :data-directories)
                    (recur (+ index 1) (-> out (append-field (get-key d :rva) 4 :directory-rva)
                                          (append-field (get-key d :size) 4 :directory-size)))))))))))))

(defn- sections-fail [error :keyword field :keyword] [:ref :kotoba.object.pe32plus/sections]
  (record-new [:ref :kotoba.object.pe32plus/sections]
    (typed-list-new [:list [:ref :kotoba.object.pe32plus/section]]) error field))
(defn- collect-sections [sections :document file-alignment :i64 section-alignment :i64 headers-span :i64]
  [:ref :kotoba.object.pe32plus/sections]
  (loop [index 0 rows (typed-list-new [:list [:ref :kotoba.object.pe32plus/section]])]
    (if (= index (document-count sections)) (record-new [:ref :kotoba.object.pe32plus/sections] rows :ok :none)
      (let [source (item sections index) header (encode-section-header source) bytes (byte-region (get-key source :bytes))
            rva (small-number (get-key source :rva) 4294967295)
            virtual-size (small-number (get-key source :virtual-size) 4294967295)
            raw-size (small-number (get-key source :raw-size) 4294967295)
            raw-offset (small-number (get-key source :raw-offset) 4294967295)
            mapped (align-value virtual-size section-alignment)]
        (cond
          (not (good? header)) (sections-fail (record-get [:ref :kotoba.object.pe32plus/result] header :error)
                                   (record-get [:ref :kotoba.object.pe32plus/result] header :field))
          (not (good? bytes)) (sections-fail (record-get [:ref :kotoba.object.pe32plus/result] bytes :error) :bytes)
          (not= raw-size (align-value (vector-count (bytes-of bytes)) file-alignment)) (sections-fail :noncanonical-raw-size :raw-size)
          (or (> raw-offset (max-image-bytes)) (> raw-size (- (max-image-bytes) raw-offset))) (sections-fail :image-limit :raw-size)
          (or (< mapped 0) (> mapped (- 9223372036854775807 rva))) (sections-fail :virtual-overflow :virtual-size)
          (not= (- rva (* (quot rva section-alignment) section-alignment)) 0) (sections-fail :virtual-alignment :rva)
          (< rva headers-span) (sections-fail :virtual-headers-overlap :rva)
          :else (recur (+ index 1) (typed-list-conj [:list [:ref :kotoba.object.pe32plus/section]] rows
                   (record-new [:ref :kotoba.object.pe32plus/section]
                     rva virtual-size raw-size raw-offset (bytes-of bytes) (bytes-of header)))))))))
(defn- position [row [:ref :kotoba.object.pe32plus/section] raw? :bool] :i64
  (if raw? (record-get [:ref :kotoba.object.pe32plus/section] row :raw-offset)
    (record-get [:ref :kotoba.object.pe32plus/section] row :rva)))
;; Stable ordering of all <=32 entries; no replacement smaller section limit.
(defn- ordering [rows [:list [:ref :kotoba.object.pe32plus/section]] raw? :bool] :vector-i64
  (loop [count 0 used 0 out (vector-alloc 0)]
    (if (= count (vector-count rows)) out
      (let [next (loop [index 0 chosen -1 minimum 0]
                   (if (= index (vector-count rows)) chosen
                     (let [row (typed-list-nth [:list [:ref :kotoba.object.pe32plus/section]] rows index)
                           value (position row raw?) bit (i64-shift-left 1 index)]
                       (if (or (not= (bit-and used bit) 0) (and (>= chosen 0) (>= value minimum)))
                         (recur (+ index 1) chosen minimum) (recur (+ index 1) index value)))))]
        (recur (+ count 1) (bit-or used (i64-shift-left 1 next)) (vector-conj out next))))))
(defn- overlaps? [rows [:list [:ref :kotoba.object.pe32plus/section]] order :vector-i64 raw? :bool alignment :i64] :bool
  (loop [index 1]
    (if (>= index (vector-count order)) false
      (let [left (typed-list-nth [:list [:ref :kotoba.object.pe32plus/section]] rows (vector-at order (- index 1)))
            right (typed-list-nth [:list [:ref :kotoba.object.pe32plus/section]] rows (vector-at order index))
            size (if raw? (record-get [:ref :kotoba.object.pe32plus/section] left :raw-size)
                   (align-value (record-get [:ref :kotoba.object.pe32plus/section] left :virtual-size) alignment))]
        (if (> (+ (position left raw?) size) (position right raw?)) true (recur (+ index 1)))))))
(defn- compare-numbers [a :document b :document] :i64
  (let [ar (unsigned/parse a) br (unsigned/parse b)
        aw (record-get [:ref :kotoba.object.unsigned/result] ar :words)
        bw (record-get [:ref :kotoba.object.unsigned/result] br :words)]
    (cond
      (or (not= (record-get [:ref :kotoba.object.unsigned/result] ar :error) :ok)
          (not= (record-get [:ref :kotoba.object.unsigned/result] br :error) :ok)) -2
      (< (vector-count aw) (vector-count bw)) -1
      (> (vector-count aw) (vector-count bw)) 1
      :else (loop [index (- (vector-count aw) 1)]
              (if (< index 0) 0
                (let [av (vector-at aw index) bv (vector-at bw index)]
                  (cond (< av bv) -1 (> av bv) 1 :else (recur (- index 1)))))))))
(defn- image-layout-error [rows [:list [:ref :kotoba.object.pe32plus/section]] opts :document
                           section-alignment :i64 headers-span :i64] :keyword
  (let [image (get-key opts :image-size) aligned (align-up image section-alignment)
        required (loop [index 0 maximum headers-span]
                   (if (= index (vector-count rows)) maximum
                     (let [row (typed-list-nth [:list [:ref :kotoba.object.pe32plus/section]] rows index)
                           end (+ (record-get [:ref :kotoba.object.pe32plus/section] row :rva)
                                  (align-value (record-get [:ref :kotoba.object.pe32plus/section] row :virtual-size) section-alignment))]
                       (recur (+ index 1) (if (> end maximum) end maximum)))))]
    (cond
      (overlaps? rows (ordering rows true) true section-alignment) :raw-overlap
      (overlaps? rows (ordering rows false) false section-alignment) :virtual-overlap
      (or (not (good? aligned)) (< (compare-numbers image (document-i64 required)) 0)) :image-coverage
      (not= (compare-numbers image (record-get [:ref :kotoba.object.pe32plus/result] aligned :value)) 0) :image-alignment
      :else :ok)))
(defn- image-options [opts :document] :document
  (let [defaults (document-map
                   (document-keyword :image-base) (document-i64 4194304)
                   (document-keyword :section-alignment) (document-i64 4096)
                   (document-keyword :file-alignment) (document-i64 512)
                   (document-keyword :headers-size) (document-i64 512)
                   (document-keyword :subsystem) (document-keyword :efi-application)
                   (document-keyword :dll-characteristics) (document-i64 352)
                   (document-keyword :stack-reserve) (document-i64 1048576)
                   (document-keyword :stack-commit) (document-i64 4096)
                   (document-keyword :heap-reserve) (document-i64 1048576)
                   (document-keyword :heap-commit) (document-i64 4096)
                   (document-keyword :data-directories) (document-map))]
    (document-merge defaults opts)))
(defn- optional-options [opts :document rows [:list [:ref :kotoba.object.pe32plus/section]]] :document
  (let [initialized (loop [index 1 total 0]
                      (if (= index (vector-count rows)) total
                        (recur (+ index 1) (+ total (record-get [:ref :kotoba.object.pe32plus/section]
                                                     (typed-list-nth [:list [:ref :kotoba.object.pe32plus/section]] rows index) :raw-size)))))
        text (typed-list-nth [:list [:ref :kotoba.object.pe32plus/section]] rows 0)]
    (document-merge opts (document-map
      (document-keyword :text-size) (document-i64 (vector-count (record-get [:ref :kotoba.object.pe32plus/section] text :bytes)))
      (document-keyword :initialized-size) (document-i64 initialized)))))
(defn- dos [] :vector-i64
  (loop [index 0 out (vector-alloc 0)]
    (if (= index 128) out (recur (+ index 1) (vector-conj out (case index 0 77 1 90 60 128 0))))))
(defn- header-bytes [opts :document rows [:list [:ref :kotoba.object.pe32plus/section]] headers-size :i64]
  [:ref :kotoba.object.pe32plus/result]
  (let [machine (lookup (machine-codes) (get-key opts :machine))
        coff (-> (ok (vector-alloc 0)) (append-field machine 2 :machine)
                 (append-field (document-i64 (vector-count rows)) 2 :section-count)
                 (append-result (ok (zeros 12))) (append-field (document-i64 240) 2 :optional-size)
                 (append-field (document-i64 34) 2 :characteristics))
        optional (encode-optional-header (optional-options opts rows))
        base (-> (ok (dos)) (append-field (document-i64 17744) 4 :pe-signature)
                 (append-result coff) (append-result optional))
        full (loop [index 0 out base]
               (if (or (= index (vector-count rows)) (not (good? out))) out
                 (recur (+ index 1) (append-result out (ok (record-get [:ref :kotoba.object.pe32plus/section]
                   (typed-list-nth [:list [:ref :kotoba.object.pe32plus/section]] rows index) :header))))))]
    (pad-result full headers-size)))
(defn- materialize [headers [:ref :kotoba.object.pe32plus/result] rows [:list [:ref :kotoba.object.pe32plus/section]]]
  [:ref :kotoba.object.pe32plus/result]
  (let [order (ordering rows true)]
    (loop [index 0 out headers]
      (if (or (= index (vector-count order)) (not (good? out))) out
        (let [row (typed-list-nth [:list [:ref :kotoba.object.pe32plus/section]] rows (vector-at order index))
              padded (pad-result out (record-get [:ref :kotoba.object.pe32plus/section] row :raw-offset))
              data (pad-to (record-get [:ref :kotoba.object.pe32plus/section] row :bytes)
                           (record-get [:ref :kotoba.object.pe32plus/section] row :raw-size))]
          (recur (+ index 1) (append-result padded data)))))))

(defn encode-image [input :document] [:ref :kotoba.object.pe32plus/result]
  (let [opts (image-options (if (= (document-kind input) :map) input (document-map)))
        sections (get-key opts :sections)
        file-alignment (small-number (get-key opts :file-alignment) 9223372036854775807)
        section-alignment (small-number (get-key opts :section-alignment) 9223372036854775807)
        headers-size (small-number (get-key opts :headers-size) (max-image-bytes))
        headers-span (align-value headers-size section-alignment)]
    (cond
      (not (or (= (document-kind input) :map) (= (document-kind input) :null))) (fail :options-shape :options)
      (= (document-kind (lookup (machine-codes) (get-key opts :machine))) :null) (fail :unsupported-machine :machine)
      (or (not (or (= (document-kind sections) :vector) (= (document-kind sections) :list)))
          (< (document-count sections) 1) (> (document-count sections) (max-section-count))) (fail :section-count :sections)
      (not (power? file-alignment)) (fail :alignment :file-alignment)
      (not (power? section-alignment)) (fail :alignment :section-alignment)
      (< headers-size 0) (fail :region-allocation :headers-size)
      (< headers-span 0) (fail :alignment-overflow :headers-size)
      :else
      (let [planned (collect-sections sections file-alignment section-alignment headers-span)
            error (record-get [:ref :kotoba.object.pe32plus/sections] planned :error)
            rows (record-get [:ref :kotoba.object.pe32plus/sections] planned :rows)]
        (if (not= error :ok) (fail error (record-get [:ref :kotoba.object.pe32plus/sections] planned :field))
          (let [layout-error (image-layout-error rows opts section-alignment headers-span)]
            (if (not= layout-error :ok) (fail layout-error :layout)
              (materialize (header-bytes opts rows headers-size) rows))))))))
