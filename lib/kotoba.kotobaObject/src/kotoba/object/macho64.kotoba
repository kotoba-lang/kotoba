;; Complete canonical MH_OBJECT source candidate; callers retain target policy.
(ns kotoba.object.macho64
  {:kotoba/export [align-up encode-object little-endian]}
  (:require [kotoba.object.unsigned :as unsigned])
  (:schemas
   {:kotoba.object.macho64/result
    [:record :kotoba.object.macho64/result
     [[:bytes :vector-i64] [:value :document] [:error :keyword] [:field :keyword]]]
    :kotoba.object.macho64/section
    [:record :kotoba.object.macho64/section
     [[:name :vector-i64] [:segment :vector-i64] [:address :i64] [:size :i64]
      [:offset :i64] [:align :i64] [:flags :i64] [:bytes :vector-i64] [:relocations :document]]]
    :kotoba.object.macho64/sections
    [:record :kotoba.object.macho64/sections
     [[:rows [:list [:ref :kotoba.object.macho64/section]]] [:address :i64] [:end :i64]
      [:error :keyword] [:field :keyword]]]
    :kotoba.object.macho64/relocations
    [:record :kotoba.object.macho64/relocations
     [[:offsets :vector-i64] [:end :i64] [:error :keyword]]]
    :kotoba.object.macho64/strings
    [:record :kotoba.object.macho64/strings
     [[:bytes :vector-i64] [:offsets :vector-i64] [:indexes :document] [:error :keyword] [:field :keyword]]]}))

(defn- max-bytes [] :i64 67108864)
(defn- ok [bytes :vector-i64] [:ref :kotoba.object.macho64/result]
  (record-new [:ref :kotoba.object.macho64/result] bytes (document-null) :ok :none))
(defn- fail [error :keyword field :keyword] [:ref :kotoba.object.macho64/result]
  (record-new [:ref :kotoba.object.macho64/result] (vector-alloc 0) (document-null) error field))
(defn- good? [r [:ref :kotoba.object.macho64/result]] :bool
  (= (record-get [:ref :kotoba.object.macho64/result] r :error) :ok))
(defn- bytes-of [r [:ref :kotoba.object.macho64/result]] :vector-i64
  (record-get [:ref :kotoba.object.macho64/result] r :bytes))
(defn- lookup [m :document key :document] :document
  (if (not= (document-kind m) :map) (document-null)
    (loop [index 0]
      (if (= index (document-count m)) (document-null)
        (let [pair (option-value-of [:option :document] (document-map-entry-at m index) (document-null))]
          (if (document-equal? (option-value-of [:option :document] (document-vector-at pair 0) (document-null)) key)
            (option-value-of [:option :document] (document-vector-at pair 1) (document-null)) (recur (+ index 1))))))))
(defn- has? [m :document key :document] :bool
  (if (not= (document-kind m) :map) false
    (loop [index 0]
      (if (= index (document-count m)) false
        (let [pair (option-value-of [:option :document] (document-map-entry-at m index) (document-null))]
          (if (document-equal? (option-value-of [:option :document] (document-vector-at pair 0) (document-null)) key)
            true (recur (+ index 1))))))))
(defn- get-key [m :document key :keyword] :document (lookup m (document-keyword key)))
(defn- field [m :document key :keyword fallback :document] :document
  (if (has? m (document-keyword key)) (get-key m key) fallback))
(defn- i64-of [d :document] :i64 (option-value-of [:option :i64] (document-i64-value d) -1))
(defn- keyword-of [d :document] :keyword
  (option-value-of [:option :keyword] (document-keyword-value d) :none))
(defn- sequence? [d :document] :bool
  (or (= (document-kind d) :vector) (= (document-kind d) :list) (= (document-kind d) :null)))
(defn- item [xs :document index :i64] :document
  (if (= (document-kind xs) :list)
    (option-value-of [:option :document] (document-list-at xs index) (document-null))
    (option-value-of [:option :document] (document-vector-at xs index) (document-null))))
(defn- truthy? [d :document] :bool
  (and (not= (document-kind d) :null)
       (if (= (document-kind d) :bool) (option-value-of [:option :bool] (document-bool-value d) false) true)))
(defn- small-number [d :document limit :i64] :i64
  (let [r (unsigned/parse d) value (record-get [:ref :kotoba.object.unsigned/result] r :value)]
    (if (and (= (record-get [:ref :kotoba.object.unsigned/result] r :error) :ok)
             (= (document-kind value) :i64) (<= (i64-of value) limit)) (i64-of value) -1)))

;; Strict widths/ranges are checked before using the shared truncating helper.
(defn little-endian [value :document width :i64] [:ref :kotoba.object.macho64/result]
  (if (not (or (= width 1) (= width 2) (= width 4) (= width 8))) (fail :integer-width :width)
    (let [parsed (unsigned/parse value) words (record-get [:ref :kotoba.object.unsigned/result] parsed :words)]
      (cond
        (not= (record-get [:ref :kotoba.object.unsigned/result] parsed :error) :ok) (fail :integer-range :value)
        (> (vector-count words) (if (= width 8) 2 1)) (fail :integer-range :value)
        (and (= width 1) (>= (vector-at words 0) 256)) (fail :integer-range :value)
        (and (= width 2) (>= (vector-at words 0) 65536)) (fail :integer-range :value)
        :else (ok (record-get [:ref :kotoba.object.unsigned/result] (unsigned/little-endian value width) :bytes))))))
(defn align-up [value :document exponent :i64] [:ref :kotoba.object.macho64/result]
  (if (or (< exponent 0) (> exponent 15)) (fail :alignment :exponent)
    (let [r (unsigned/align-up value (i64-shift-left 1 exponent))]
      (if (not= (record-get [:ref :kotoba.object.unsigned/result] r :error) :ok) (fail :alignment :value)
        (record-new [:ref :kotoba.object.macho64/result] (vector-alloc 0)
          (record-get [:ref :kotoba.object.unsigned/result] r :value) :ok :none)))))
(defn- align-value [n :i64 exponent :i64] :i64
  (let [alignment (i64-shift-left 1 exponent)] (* alignment (quot (+ n (- alignment 1)) alignment))))
(defn- zeros [n :i64] :vector-i64
  (loop [index 0 out (vector-alloc 0)] (if (= index n) out (recur (+ index 1) (vector-conj out 0)))))
(defn- join [a :vector-i64 b :vector-i64] :vector-i64
  (loop [index 0 out a]
    (if (= index (vector-count b)) out (recur (+ index 1) (vector-conj out (vector-at b index))))))
(defn- append-result [out [:ref :kotoba.object.macho64/result] more [:ref :kotoba.object.macho64/result]]
  [:ref :kotoba.object.macho64/result]
  (cond
    (not (good? out)) out (not (good? more)) more
    (> (vector-count (bytes-of more)) (- (max-bytes) (vector-count (bytes-of out)))) (fail :object-limit :bytes)
    :else (ok (join (bytes-of out) (bytes-of more)))))
(defn- append-field [out [:ref :kotoba.object.macho64/result] value :i64 width :i64 key :keyword]
  [:ref :kotoba.object.macho64/result]
  (if (not (good? out)) out
    (let [r (little-endian (document-i64 value) width)]
      (if (not (good? r)) (fail :integer-range key) (append-result out r)))))
(defn- pad-result [r [:ref :kotoba.object.macho64/result] size :i64] [:ref :kotoba.object.macho64/result]
  (cond
    (not (good? r)) r
    (or (< size 0) (> size (max-bytes))) (fail :region-allocation :size)
    (> (vector-count (bytes-of r)) size) (fail :region-too-small :size)
    :else (loop [index (vector-count (bytes-of r)) out (bytes-of r)]
            (if (= index size) (ok out) (recur (+ index 1) (vector-conj out 0))))))
(defn- byte-region [value :document] [:ref :kotoba.object.macho64/result]
  (cond
    (= (document-kind value) :null) (ok (vector-alloc 0))
    (= (document-kind value) :bytes)
    (let [bytes (option-value-of [:option :bytes] (document-bytes-value value) (bytes-empty))]
      (if (> (bytes-count bytes) (max-bytes)) (fail :object-limit :section-bytes)
        (loop [index 0 out (vector-alloc 0)]
          (if (= index (bytes-count bytes)) (ok out) (recur (+ index 1) (vector-conj out (bytes-at bytes index)))))))
    (not (sequence? value)) (fail :byte-region :section-bytes)
    (> (document-count value) (max-bytes)) (fail :object-limit :section-bytes)
    :else (loop [index 0 out (vector-alloc 0)]
            (if (= index (document-count value)) (ok out)
              (let [v (item value index) b (i64-of v)]
                (if (and (= (document-kind v) :i64) (>= b 0) (<= b 255))
                  (recur (+ index 1) (vector-conj out b)) (fail :invalid-byte :section-bytes)))))))
(defn- name-bytes [value :document minimum :i64 maximum :i64 symbol? :bool key :keyword]
  [:ref :kotoba.object.macho64/result]
  (let [text (option-value-of [:option :string] (document-string-value value) "")]
    (if (or (not= (document-kind value) :string) (< (string-length text) minimum) (> (string-length text) maximum))
      (fail :name-shape key)
      (let [bytes (string-to-utf8 text)]
        (cond
          (> (bytes-count bytes) maximum) (fail :name-shape key)
          (and symbol? (not= (bytes-at bytes 0) 95)) (fail :symbol-prefix key)
          :else (loop [index 0 out (vector-alloc 0)]
                  (if (= index (bytes-count bytes)) (ok out)
                    (let [b (bytes-at bytes index)]
                      (if (and (>= b 32) (<= b 126)) (recur (+ index 1) (vector-conj out b)) (fail :name-ascii key))))))))))
(defn- version-field [value :document] :i64
  (if (or (not= (document-kind value) :vector) (not= (document-count value) 3)) -1
    (let [major (small-number (item value 0) 65535) minor (small-number (item value 1) 255) patch (small-number (item value 2) 255)]
      (if (or (< major 0) (< minor 0) (< patch 0)) -1 (+ (+ (* major 65536) (* minor 256)) patch)))))
(defn- cpu-type [machine :keyword] :i64 (case machine :aarch64 16777228 :x86-64 16777223 -1))
(defn- platform-id [platform :keyword] :i64
  (case platform :macos 1 :ios 2 :tvos 3 :watchos 4 :maccatalyst 6 :ios-simulator 7
    :tvos-simulator 8 :watchos-simulator 9 :driverkit 10 :visionos 11 :visionos-simulator 12 -1))
(defn- relocation-code [machine :keyword type :keyword] :i64
  (case machine
    :aarch64 (case type :aarch64/unsigned 0 :aarch64/branch26 2 :aarch64/page21 3 :aarch64/pageoff12 4 -1)
    :x86-64 (case type :x86-64/unsigned 0 :x86-64/signed 1 :x86-64/branch 2 :x86-64/got-load 3 :x86-64/got 4 :x86-64/tlv 9 -1)
    -1))

(defn- sections-fail [error :keyword key :keyword] [:ref :kotoba.object.macho64/sections]
  (record-new [:ref :kotoba.object.macho64/sections]
    (typed-list-new [:list [:ref :kotoba.object.macho64/section]]) 0 0 error key))
(defn- layout-sections [data-offset :i64 sections :document] [:ref :kotoba.object.macho64/sections]
  (loop [index 0 address 0 file-offset data-offset rows (typed-list-new [:list [:ref :kotoba.object.macho64/section]])]
    (if (= index (document-count sections)) (record-new [:ref :kotoba.object.macho64/sections] rows address file-offset :ok :none)
      (let [section (item sections index) bytes (byte-region (get-key section :bytes))
            name (pad-result (name-bytes (get-key section :name) 1 16 false :section) 16)
            segment (pad-result (name-bytes (get-key section :segment) 1 16 false :segment) 16)
            exponent (small-number (get-key section :align) 15) flags (small-number (get-key section :flags) 4294967295)
            relocations (get-key section :relocations)]
        (cond
          (not= (document-kind section) :map) (sections-fail :section-shape :sections)
          (not (good? bytes)) (sections-fail (record-get [:ref :kotoba.object.macho64/result] bytes :error) :section-bytes)
          (not (good? name)) (sections-fail (record-get [:ref :kotoba.object.macho64/result] name :error) :section)
          (not (good? segment)) (sections-fail (record-get [:ref :kotoba.object.macho64/result] segment :error) :segment)
          (< exponent 0) (sections-fail :alignment :align)
          (< flags 0) (sections-fail :section-flags :flags)
          (not (sequence? relocations)) (sections-fail :relocation-shape :relocations)
          (> (document-count relocations) 65535) (sections-fail :relocation-count :relocations)
          :else
          (let [aligned-address (align-value address exponent) aligned-offset (align-value file-offset exponent)
                size (vector-count (bytes-of bytes))]
            (if (or (> aligned-offset (max-bytes)) (> size (- (max-bytes) aligned-offset)))
              (sections-fail :object-limit :section-bytes)
              (recur (+ index 1) (+ aligned-address size) (+ aligned-offset size)
                (typed-list-conj [:list [:ref :kotoba.object.macho64/section]] rows
                  (record-new [:ref :kotoba.object.macho64/section] (bytes-of name) (bytes-of segment)
                    aligned-address size aligned-offset exponent flags (bytes-of bytes) relocations))))))))))
(defn- layout-relocations [sections [:ref :kotoba.object.macho64/sections] count :i64] [:ref :kotoba.object.macho64/relocations]
  (let [rows (record-get [:ref :kotoba.object.macho64/sections] sections :rows)]
    (loop [index 0 end (record-get [:ref :kotoba.object.macho64/sections] sections :end) offsets (vector-alloc 0)]
      (if (= index count) (record-new [:ref :kotoba.object.macho64/relocations] offsets end :ok)
        (let [row (typed-list-nth [:list [:ref :kotoba.object.macho64/section]] rows index)
              n (document-count (record-get [:ref :kotoba.object.macho64/section] row :relocations))
              offset (if (> n 0) (align-value end 2) 0) size (* n 8)]
          (if (or (> offset (max-bytes)) (> size (- (max-bytes) offset)))
            (record-new [:ref :kotoba.object.macho64/relocations] (vector-alloc 0) 0 :object-limit)
            (recur (+ index 1) (if (> n 0) (+ offset size) end) (vector-conj offsets offset))))))))

(defn- strings-fail [error :keyword field :keyword] [:ref :kotoba.object.macho64/strings]
  (record-new [:ref :kotoba.object.macho64/strings] (vector-alloc 0) (vector-alloc 0) (document-null) error field))
(defn- string-table [symbols :document] [:ref :kotoba.object.macho64/strings]
  (loop [index 0 bytes (vector-conj (vector-alloc 0) 0) offsets (vector-alloc 0) indexes (document-map)]
    (if (= index (document-count symbols))
      (let [padded (pad-result (ok bytes) (align-value (vector-count bytes) 3))]
        (if (not (good? padded)) (strings-fail :object-limit :strings)
          (record-new [:ref :kotoba.object.macho64/strings] (bytes-of padded) offsets indexes :ok :none)))
      (let [entry (item symbols index) name (get-key entry :name) encoded (name-bytes name 2 255 true :symbol)]
        (cond
          (not= (document-kind entry) :map) (strings-fail :symbol-shape :symbols)
          (not (good? encoded)) (strings-fail (record-get [:ref :kotoba.object.macho64/result] encoded :error) :symbol)
          (has? indexes name) (strings-fail :duplicate-symbol :symbol)
          :else (recur (+ index 1) (vector-conj (join bytes (bytes-of encoded)) 0)
                  (vector-conj offsets (vector-count bytes)) (document-assoc indexes name (document-i64 index))))))))
(defn- encode-section [row [:ref :kotoba.object.macho64/section] relocation-offset :i64]
  [:ref :kotoba.object.macho64/result]
  (-> (ok (record-get [:ref :kotoba.object.macho64/section] row :name))
      (append-result (ok (record-get [:ref :kotoba.object.macho64/section] row :segment)))
      (append-field (record-get [:ref :kotoba.object.macho64/section] row :address) 8 :address)
      (append-field (record-get [:ref :kotoba.object.macho64/section] row :size) 8 :size)
      (append-field (record-get [:ref :kotoba.object.macho64/section] row :offset) 4 :offset)
      (append-field (record-get [:ref :kotoba.object.macho64/section] row :align) 4 :align)
      (append-field relocation-offset 4 :relocation-offset)
      (append-field (document-count (record-get [:ref :kotoba.object.macho64/section] row :relocations)) 4 :relocation-count)
      (append-field (record-get [:ref :kotoba.object.macho64/section] row :flags) 4 :flags)
      (append-result (ok (zeros 12)))))
(defn- encode-symbol [sections [:ref :kotoba.object.macho64/sections] count :i64 string-offset :i64 symbol :document]
  [:ref :kotoba.object.macho64/result]
  (let [section (small-number (get-key symbol :section) count)
        value (small-number (get-key symbol :value) (max-bytes))
        external? (truthy? (get-key symbol :external?))
        description (small-number (field symbol :description (document-i64 0)) 65535)]
    (cond
      (< section 0) (fail :symbol-section :section)
      (< value 0) (fail :symbol-value :value)
      (and (= section 0) (or (not external?) (not= value 0))) (fail :symbol-value :value)
      (< description 0) (fail :symbol-description :description)
      :else
      (let [rows (record-get [:ref :kotoba.object.macho64/sections] sections :rows)
            row (typed-list-nth [:list [:ref :kotoba.object.macho64/section]] rows (if (= section 0) 0 (- section 1)))
            size (record-get [:ref :kotoba.object.macho64/section] row :size)
            address (if (= section 0) 0 (+ (record-get [:ref :kotoba.object.macho64/section] row :address) value))]
        (if (and (> section 0) (> value size)) (fail :symbol-value :value)
          (-> (ok (vector-alloc 0))
              (append-field string-offset 4 :string-offset)
              (append-field (if (= section 0) 1 (bit-or 14 (if external? 1 0))) 1 :symbol-type)
              (append-field section 1 :section) (append-field description 2 :description)
              (append-field address 8 :symbol-value)))))))
(defn- encode-relocation [machine :keyword indexes :document size :i64 relocation :document]
  [:ref :kotoba.object.macho64/result]
  (let [code (relocation-code machine (keyword-of (get-key relocation :type)))
        width (if (= code 0) 8 4) symbol-index (i64-of (lookup indexes (get-key relocation :symbol)))
        offset (small-number (get-key relocation :offset) size)]
    (cond
      (or (not= (document-kind relocation) :map) (not= (document-count relocation) 3)
          (not (has? relocation (document-keyword :offset))) (not (has? relocation (document-keyword :type)))
          (not (has? relocation (document-keyword :symbol)))) (fail :relocation-shape :relocations)
      (< code 0) (fail :relocation-type :type)
      (< symbol-index 0) (fail :relocation-symbol :symbol)
      (or (< offset 0) (> (+ offset width) size)) (fail :relocation-span :offset)
      :else
      (let [pcrel? (and (not= code 0) (not (and (= machine :aarch64) (= code 4))))
            word (bit-or (bit-or symbol-index (if pcrel? 16777216 0))
                   (bit-or (i64-shift-left (if (= width 8) 3 2) 25) (bit-or 134217728 (i64-shift-left code 28))))]
        (-> (ok (vector-alloc 0)) (append-field offset 4 :relocation-offset) (append-field word 4 :relocation-info))))))

(defn- encode-header [machine :keyword count :i64 flags :i64] [:ref :kotoba.object.macho64/result]
  (-> (ok (vector-alloc 0)) (append-field 4277009103 4 :magic)
      (append-field (cpu-type machine) 4 :cpu-type) (append-field (if (= machine :x86-64) 3 0) 4 :cpu-subtype)
      (append-field 1 4 :file-type) (append-field 3 4 :command-count)
      (append-field (+ 120 (* 80 count)) 4 :command-size) (append-field flags 4 :flags) (append-field 0 4 :reserved)))
(defn- encode-segment [sections [:ref :kotoba.object.macho64/sections] relocations [:ref :kotoba.object.macho64/relocations] count :i64]
  [:ref :kotoba.object.macho64/result]
  (let [data-offset (+ 152 (* 80 count)) rows (record-get [:ref :kotoba.object.macho64/sections] sections :rows)
        offsets (record-get [:ref :kotoba.object.macho64/relocations] relocations :offsets)
        header (-> (ok (vector-alloc 0)) (append-field 25 4 :segment-command) (append-field (+ 72 (* 80 count)) 4 :segment-command-size)
                   (append-result (ok (zeros 16))) (append-field 0 8 :vm-address)
                   (append-field (record-get [:ref :kotoba.object.macho64/sections] sections :address) 8 :vm-size)
                   (append-field data-offset 8 :file-offset)
                   (append-field (- (record-get [:ref :kotoba.object.macho64/sections] sections :end) data-offset) 8 :file-size)
                   (append-field 7 4 :max-protection) (append-field 7 4 :initial-protection)
                   (append-field count 4 :section-count) (append-field 0 4 :segment-flags))]
    (loop [index 0 out header]
      (if (or (= index count) (not (good? out))) out
        (recur (+ index 1) (append-result out
          (encode-section (typed-list-nth [:list [:ref :kotoba.object.macho64/section]] rows index) (vector-at offsets index))))))))
(defn- encode-build-version [platform :i64 minimum-os :i64 sdk :i64] [:ref :kotoba.object.macho64/result]
  (-> (ok (vector-alloc 0)) (append-field 50 4 :build-command) (append-field 24 4 :build-command-size)
      (append-field platform 4 :platform) (append-field minimum-os 4 :minimum-os)
      (append-field sdk 4 :sdk) (append-field 0 4 :tool-count)))
(defn- encode-symtab [symbol-offset :i64 symbol-count :i64 string-size :i64] [:ref :kotoba.object.macho64/result]
  (-> (ok (vector-alloc 0)) (append-field 2 4 :symtab-command) (append-field 24 4 :symtab-command-size)
      (append-field symbol-offset 4 :symbol-offset) (append-field symbol-count 4 :symbol-count)
      (append-field (+ symbol-offset (* 16 symbol-count)) 4 :string-offset) (append-field string-size 4 :string-size)))
(defn- append-section-data [out [:ref :kotoba.object.macho64/result] sections [:ref :kotoba.object.macho64/sections] count :i64]
  [:ref :kotoba.object.macho64/result]
  (let [rows (record-get [:ref :kotoba.object.macho64/sections] sections :rows)]
    (loop [index 0 result out]
      (if (or (= index count) (not (good? result))) result
        (let [row (typed-list-nth [:list [:ref :kotoba.object.macho64/section]] rows index)]
          (recur (+ index 1) (append-result (pad-result result (record-get [:ref :kotoba.object.macho64/section] row :offset))
            (ok (record-get [:ref :kotoba.object.macho64/section] row :bytes)))))))))
(defn- append-relocation-data [out [:ref :kotoba.object.macho64/result] machine :keyword indexes :document
                              sections [:ref :kotoba.object.macho64/sections] relocations [:ref :kotoba.object.macho64/relocations] count :i64]
  [:ref :kotoba.object.macho64/result]
  (let [rows (record-get [:ref :kotoba.object.macho64/sections] sections :rows)
        offsets (record-get [:ref :kotoba.object.macho64/relocations] relocations :offsets)]
    (loop [index 0 result out]
      (if (or (= index count) (not (good? result))) result
        (let [row (typed-list-nth [:list [:ref :kotoba.object.macho64/section]] rows index)
              entries (record-get [:ref :kotoba.object.macho64/section] row :relocations)
              size (record-get [:ref :kotoba.object.macho64/section] row :size)
              padded (if (= (document-count entries) 0) result (pad-result result (vector-at offsets index)))
              encoded (loop [at 0 bytes padded]
                        (if (or (= at (document-count entries)) (not (good? bytes))) bytes
                          (recur (+ at 1) (append-result bytes (encode-relocation machine indexes size (item entries at))))))]
          (recur (+ index 1) encoded))))))
(defn- append-symbol-data [out [:ref :kotoba.object.macho64/result] sections [:ref :kotoba.object.macho64/sections]
                          count :i64 strings [:ref :kotoba.object.macho64/strings] symbols :document]
  [:ref :kotoba.object.macho64/result]
  (let [offsets (record-get [:ref :kotoba.object.macho64/strings] strings :offsets)]
    (loop [index 0 result out]
      (if (or (= index (document-count symbols)) (not (good? result))) result
        (recur (+ index 1) (append-result result (encode-symbol sections count (vector-at offsets index) (item symbols index))))))))
(defn- materialize [machine :keyword platform :i64 minimum-os :i64 sdk :i64 flags :i64 count :i64
                    sections [:ref :kotoba.object.macho64/sections] relocations [:ref :kotoba.object.macho64/relocations]
                    strings [:ref :kotoba.object.macho64/strings] symbols :document]
  [:ref :kotoba.object.macho64/result]
  (let [symbol-offset (align-value (record-get [:ref :kotoba.object.macho64/relocations] relocations :end) 3)
        string-bytes (record-get [:ref :kotoba.object.macho64/strings] strings :bytes)
        end (+ (+ symbol-offset (* 16 (document-count symbols))) (vector-count string-bytes))]
    (if (> end (max-bytes)) (fail :object-limit :bytes)
      (-> (encode-header machine count flags) (append-result (encode-segment sections relocations count))
          (append-result (encode-build-version platform minimum-os sdk))
          (append-result (encode-symtab symbol-offset (document-count symbols) (vector-count string-bytes)))
          (append-section-data sections count)
          (append-relocation-data machine (record-get [:ref :kotoba.object.macho64/strings] strings :indexes) sections relocations count)
          (pad-result symbol-offset) (append-symbol-data sections count strings symbols) (append-result (ok string-bytes))))))

(defn encode-object [opts :document] [:ref :kotoba.object.macho64/result]
  (let [machine (keyword-of (get-key opts :machine)) platform (platform-id (keyword-of (get-key opts :platform)))
        sections (get-key opts :sections) symbols (get-key opts :symbols)
        count (document-count sections) symbol-count (document-count symbols)
        default-version (document-vector (document-i64 0) (document-i64 0) (document-i64 0))
        minimum-os (version-field (field opts :minimum-os default-version)) sdk (version-field (field opts :sdk default-version))
        flags (small-number (field opts :flags (document-i64 0)) 4294967295)]
    (cond
      (not= (document-kind opts) :map) (fail :options-shape :options)
      (< (cpu-type machine) 0) (fail :machine :machine)
      (< platform 0) (fail :platform :platform)
      (or (not (sequence? sections)) (< count 1) (> count 32)) (fail :section-count :sections)
      (or (not (sequence? symbols)) (< symbol-count 1) (> symbol-count 4096)) (fail :symbol-count :symbols)
      (< flags 0) (fail :header-flags :flags)
      (< minimum-os 0) (fail :version :minimum-os)
      (< sdk 0) (fail :version :sdk)
      :else
      (let [laid-out (layout-sections (+ 152 (* 80 count)) sections)]
        (if (not= (record-get [:ref :kotoba.object.macho64/sections] laid-out :error) :ok)
          (fail (record-get [:ref :kotoba.object.macho64/sections] laid-out :error)
                (record-get [:ref :kotoba.object.macho64/sections] laid-out :field))
          (let [relocations (layout-relocations laid-out count) strings (string-table symbols)]
            (cond
              (not= (record-get [:ref :kotoba.object.macho64/relocations] relocations :error) :ok)
              (fail (record-get [:ref :kotoba.object.macho64/relocations] relocations :error) :relocations)
              (not= (record-get [:ref :kotoba.object.macho64/strings] strings :error) :ok)
              (fail (record-get [:ref :kotoba.object.macho64/strings] strings :error)
                    (record-get [:ref :kotoba.object.macho64/strings] strings :field))
              :else (materialize machine platform minimum-os sdk flags count laid-out relocations strings symbols))))))))
