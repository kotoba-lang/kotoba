(ns kotoba.plm.runner-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.plm.runner :as runner]))

(def ready-adapter
  {:job.adapter/id :runner/bwa
   :job.adapter/status :ready
   :job.adapter/software :sw/bwa
   :job.adapter/operation :op/align
   :job.adapter/command {:command/argv ["bwa" "mem" "ref.fa" "reads.fq"]}})

(deftest execute!-defaults-to-dry-run
  (is (= :dry-run (:run/status (runner/execute! ready-adapter)))))

(deftest exec!-reports-the-process-result-without-throwing
  (testing "a whitelisted binary that is not installed is a :failed run, not a throw"
    (let [res (runner/exec! (assoc-in ready-adapter [:job.adapter/command :command/argv] ["bwa" "--no-such-flag"]))]
      (is (= :runner/bwa (:run/adapter res)))
      (is (= :failed (:run/status res)))
      (is (string? (:run/stdout res)))
      (is (string? (:run/stderr res)))))
  (testing "the allowlist is enforced again by kotoba.lang.process/exec itself"
    (let [res (runner/exec! (assoc-in ready-adapter [:job.adapter/command :command/argv] ["rm" "-rf" "/nonexistent-kotoba-test"]))]
      (is (= :failed (:run/status res)))
      (is (re-find #"exec rejected" (:run/stderr res))))))
