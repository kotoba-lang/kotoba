{:paths ["src" "resources"]
 ;; ws-valueflo-vocabulary supplies the Valueflows action behaviour table, which
 ;; decides WHICH inventory register a movement touches (kotoba.plm.registers).
 ;; A git dep rather than a copy: re-deriving that table here is how one copy
 ;; gets fixed and the other does not.
 :deps {
        io.github.kotoba-lang/process {:local/root "../kotoba.process"}
        io.github.kotoba-lang/pprint {:local/root "../kotoba.pprint"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/ws-valueflo-vocabulary {:local/root "../kotoba.wsValuefloVocabulary"}}
 :aliases
 {;; GitHub Pages workbench build (shadow-cljs :app) — UI deps isolated here


  :test {:extra-paths ["test"]}}}
