(ns teian.model-test (:export [main]) (:require [teian.model :as m]))

(defn- fld [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))

(defn- same [a :document b :document] :bool
  (string=? (document-edn-print a) (document-edn-print b)))

(defn main [] :i64
  (let [content (document-map :kind (document-keyword :deck) :slides (document-vector))
        d0 (m/draft (document-string "a1") :deck content)
        exp0 (document-map :activity-id (document-string "a1") :kind (document-keyword :deck)
                           :content content :confidence (document-f64 0.0) :cites (document-vector)
                           :redactions (document-vector) :tenant (document-null)
                           :status (document-keyword :proposed))
        d1 (m/draft-with (document-string "a2") :doc content
                         (document-map :tenant (document-string "gftdcojp/cloud-itonami")
                                       :confidence (document-f64 0.9)))
        a0 (m/artifact (document-string "a1") (document-string "gftdcojp/cloud-itonami") (document-string "T"))
        exp-a0 (document-map :id (document-string "a1") :repo (document-string "gftdcojp/cloud-itonami")
                             :title (document-string "T") :status (document-keyword :open))
        a1 (m/artifact-with (document-string "a2") (document-string "r") (document-string "U")
                            (document-map :status (document-keyword :closed)))]
    (+ (if (same d0 exp0) 0 1)
       (if (same (fld d1 :tenant) (document-string "gftdcojp/cloud-itonami")) 0 1)
       (if (same (fld d1 :confidence) (document-f64 0.9)) 0 1)
       (if (same (fld d1 :kind) (document-keyword :doc)) 0 1)
       (if (same (fld d1 :status) (document-keyword :proposed)) 0 1)
       (if (same a0 exp-a0) 0 1)
       (if (same (fld a1 :status) (document-keyword :closed)) 0 1)
       (if (same (fld a1 :title) (document-string "U")) 0 1))))
