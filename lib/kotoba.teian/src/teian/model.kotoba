;; Port of teian.model (model.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from model.cljk:
;;   - draft and artifact are multi-arity in the source; each arity is a named
;;     fn here (draft / draft-with, artifact / artifact-with).
;;   - :confidence is an :f64 document value (carried, not computed).
;;   - content is passed through as a :document (slides EDN) unchanged.

(ns teian.model
  (:export [draft draft-with artifact artifact-with]))

(defn draft-with [activity-id :document kind :keyword content :document attrs :document] :document
  (document-merge
    (document-map :activity-id activity-id
                  :kind (document-keyword kind)
                  :content content
                  :confidence (document-f64 0.0)
                  :cites (document-vector)
                  :redactions (document-vector)
                  :tenant (document-null)
                  :status (document-keyword :proposed))
    attrs))

(defn draft [activity-id :document kind :keyword content :document] :document
  (draft-with activity-id kind content (document-map)))

(defn artifact-with [id :document repo :document title :document attrs :document] :document
  (document-merge
    (document-map :id id :repo repo :title title :status (document-keyword :open))
    attrs))

(defn artifact [id :document repo :document title :document] :document
  (artifact-with id repo title (document-map)))
