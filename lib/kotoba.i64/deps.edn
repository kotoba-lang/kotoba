;; Top-level deps stay `org.clojure/clojure` alone. This library is the shared
;; floor for 64-bit integer semantics across amu / kotoba-kir / kotoba-native /
;; kotoba-wasm, and a floor that pulls a dependency is not a floor.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
