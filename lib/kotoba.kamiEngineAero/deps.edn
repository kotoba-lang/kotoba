{:paths ["src"]
 ;; Reduced-order aero solver over the shared, purpose-split libraries:
 ;;   datom      — kotoba Datom-log representation
 ;;   vphysics   — road-load / aero force / range math
 ;;   cae-solver — the solve dispatch contract (:rom-buildup ↔ :lbm)
 ;; A future kami-cfd (Rust LBM) registers :lbm on the same contract.
 :deps {
        io.github.kotoba-lang/io
        {:local/root "../kotoba.io"}
        io.github.kotoba-lang/edn
        {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test
        {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text
        {:local/root "../kotoba.text"}
       io.github.kotoba-lang/datom
        {:local/root "../kotoba.datom"}
        io.github.kotoba-lang/kami-engine-vphysics   {:local/root "../kotoba.kamiEngineVphysics"}
        io.github.kotoba-lang/kami-engine-cae-solver {:local/root "../kotoba.kamiEngineCaeSolver"}}
 :aliases
 {
  :test {:extra-paths ["test"]}}}
