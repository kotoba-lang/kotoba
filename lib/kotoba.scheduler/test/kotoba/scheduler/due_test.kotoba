(ns kotoba.scheduler.due-test (:export [main]) (:require [kotoba.scheduler.due :as p]))

(defn- job [t :i64] :document
  (document-map :at (document-map :time/instant (document-i64 t))))

(defn- sch [a :i64 b :i64] :document
  (document-map :jobs (document-map :a (job a) :b (job b))))

(defn main [] :i64
  (let [s (sch 100 300)
        only-b (document-map :jobs (document-map :b (job 300)))
        none (document-map)]
    (+ (if (p/due? s (document-i64 50)) 1 0)
       (if (p/due? s (document-i64 100)) 0 1)
       (if (p/due? s (document-i64 200)) 0 1)
       (if (p/due? only-b (document-i64 299)) 1 0)
       (if (p/due? only-b (document-i64 300)) 0 1)
       (if (p/due? only-b (document-map :time/instant (document-i64 300))) 0 1)
       (if (p/due? none (document-i64 1000)) 1 0))))
