(ns kotoba.scheduler.markov-test
  (:export [main])
  (:require [kotoba.scheduler.markov :as m]))

(defn main [] :i64
  (let [row (m/transition-row [0 1 0 1 0 2 1 2] 3 0)]
    (+ (if (= (m/probability-bps row 1 3) 6666) 0 1)
       (if (= (m/probability-bps row 2 3) 3333) 0 1)
       (if (= (m/probability-bps row 0 3) 0) 0 1)
       (if (= (m/probability-bps row 1 4) -1) 0 1)
       (if (= (m/probability-bps (m/transition-row [1 2] 3 0) 2 1) -1) 0 1)
       (if (= (vector-count (m/transition-row [0] 3 0)) 0) 0 1)
       (if (= (vector-count (m/transition-row [0 1 1 3] 3 0)) 0) 0 1)
       (if (= (m/probability-bps [100000 1] 0 1) -1) 0 1)
       (if (= (m/probability-bps [1 -1] 0 1) -1) 0 1)
       (if (= (m/probability-bps (m/transition-row (vector-alloc 200000) 64 0) 0 100000)
              10000) 0 1)
       (if (= (vector-count (m/transition-row (vector-alloc 200002) 64 0)) 0) 0 1))))
