(ns kotoba.scheduler.due-jobs-test
  (:export [main])
  (:require [kotoba.scheduler.due-jobs :as d]))

(defn- job [t :i64] :document
  (document-map :at (document-map :time/instant (document-i64 t))))

(defn- at [xs :document i :i64] :document
  (option-or (document-vector-at xs i) (document-null)))

(defn- key-of [p :document] :string
  (keyword-name (option-or (document-keyword-value (at p 0)) :none)))

(defn main [] :i64
  (let [sch (document-map :jobs (document-map :b (job 5) :a (job 5) :c (job 9) :d (job 1)))
        r1 (d/due-jobs sch (document-map :time/instant (document-i64 5)))
        r2 (d/due-jobs sch (document-i64 4))
        r3 (d/due-jobs (document-map) (document-i64 5))]
    (+ (if (= (document-count r1) 3) 0 1)
       (if (string=? (key-of (at r1 0)) "d") 0 1)
       (if (string=? (key-of (at r1 1)) "a") 0 1)
       (if (string=? (key-of (at r1 2)) "b") 0 1)
       (if (= (document-count r2) 1) 0 1)
       (if (string=? (key-of (at r2 0)) "d") 0 1)
       (if (= (document-count r3) 0) 0 1))))
