;; Port of kotoba.scheduler.due-jobs (due_jobs.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from due_jobs.cljk:
;;   - a job without an integer :at :time/instant is left out (the source compares
;;     nil and throws).
;;   - now is a :document: a map with an integer :time/instant, or a bare integer
;;     instant. Anything else reads as 0.
;;   - the result is a :document vector of [id job] pairs, sorted by instant and
;;     then by id name, built by sorted insertion (no document-vector-sort).
;;   - an id that is not a keyword reads as :none for the sort.

(ns kotoba.scheduler.due-jobs
  (:export [due-jobs]))

(defn- kind-of [d :document] :string
  (keyword-name (document-kind d)))

(defn- field [d :document k :keyword] :document
  (if (string=? (kind-of d) "map")
    (option-or (document-get d k) (document-null))
    (document-null)))

(defn- at [xs :document i :i64] :document
  (option-or (document-vector-at xs i) (document-null)))

(defn- instant-doc [job :document] :document
  (field (field job :at) :time/instant))

(defn- due-instant? [job :document] :bool
  (string=? (kind-of (instant-doc job)) "i64"))

(defn- instant-of [job :document] :i64
  (option-or (document-i64-value (instant-doc job)) 0))

(defn- now-instant [now :document] :i64
  (if (string=? (kind-of now) "map")
    (if (string=? (kind-of (field now :time/instant)) "i64")
      (option-or (document-i64-value (field now :time/instant)) 0)
      0)
    (option-or (document-i64-value now) 0)))

(defn- id-name [k :document] :string
  (keyword-name (option-or (document-keyword-value k) :none)))

(defn- pair-key [p :document] :document (at p 0))
(defn- pair-job [p :document] :document (at p 1))

(defn- before? [a :document b :document] :bool
  (let [ia (instant-of (pair-job a))
        ib (instant-of (pair-job b))]
    (or (< ia ib)
        (and (= ia ib)
             (< (string-compare (id-name (pair-key a)) (id-name (pair-key b))) 0)))))

(defn- insert-sorted [sorted :document e :document] :document
  (let [n (document-count sorted)]
    (loop [i 0 acc (document-vector) placed false]
      (if (>= i n)
        (if placed acc (document-vector-conj acc e))
        (let [x (at sorted i)]
          (if (and (not placed) (before? e x))
            (recur (+ i 1) (document-vector-conj (document-vector-conj acc e) x) true)
            (recur (+ i 1) (document-vector-conj acc x) placed)))))))

(defn due-jobs [sch :document now :document] :document
  (let [jobs (field sch :jobs)
        n (if (string=? (kind-of jobs) "map") (document-count jobs) 0)
        t (now-instant now)]
    (loop [i 0 sorted (document-vector)]
      (if (>= i n)
        sorted
        (let [p (option-or (document-map-entry-at jobs i) (document-vector))
              job (pair-job p)]
          (if (and (due-instant? job) (<= (instant-of job) t))
              (recur (+ i 1) (insert-sorted sorted p))
              (recur (+ i 1) sorted)))))))
