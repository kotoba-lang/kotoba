;; Port of kotoba.scheduler.due (due.cljk), Kotoba-native.
;;
;; sch is a :document map {:jobs {id {:at {:time/instant ms}}}}. due? is true
;; iff some job's instant is at or before now.
;;
;; Named divergences from due.cljk:
;;   - now is a :document: an i64 epoch-millis, or a map with :time/instant.
;;   - an absent :jobs reads as the empty map (the source's (some .. nil) is false).
;;   - a job without a numeric :at :time/instant is never due (the source
;;     compares nil and throws). A missing now reads as 0.

(ns kotoba.scheduler.due
  (:export [due?]))

(defn- now-ms [now :document] :i64
  (if (map? now)
    (let [inst (document-i64-value (option-or (document-get now :time/instant) (document-null)))]
      (if (option-some?-of [:option :i64] inst)
        (option-value-of [:option :i64] inst 0)
        0))
    (option-or (document-i64-value now) 0)))

(defn- job-due? [job :document n :i64] :bool
  (let [inst (document-i64-value
              (option-or (document-get (option-or (document-get job :at) (document-null)) :time/instant)
                         (document-null)))]
    (and (option-some?-of [:option :i64] inst)
         (<= (option-value-of [:option :i64] inst 0) n))))

(defn- job-value [jobs :document i :i64] :document
  (let [entry (option-or (document-map-entry-at jobs i) (document-null))]
    (option-or (document-vector-at entry 1) (document-null))))

(defn due? [sch :document now :document] :bool
  (let [n (now-ms now)
        jobs (option-or (document-get sch :jobs) (document-map))
        cnt (document-count jobs)]
    (loop [i 0]
      (if (>= i cnt)
        false
        (if (job-due? (job-value jobs i) n)
          true
          (recur (+ i 1)))))))
