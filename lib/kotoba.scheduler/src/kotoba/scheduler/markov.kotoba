(ns kotoba.scheduler.markov
  (:export [transition-row probability-bps]))

(defn- increment-count [counts :vector-i64 dest :i64] :vector-i64
  (vector-assoc! counts dest (+ 1 (vector-at counts dest))))

;; Pairs describe already ordered transitions. Each pair is independent,
;; so a job boundary never creates a transition.
(defn transition-row [pairs :vector-i64 states :i64 from :i64] :vector-i64
  (let [size (vector-count pairs)]
    (if (or (< states 1) (> states 64) (< from 0) (>= from states)
            (> size 200000) (not= (rem size 2) 0))
      []
      (loop [index 0 counts (vector-alloc states)]
        (if (>= index size)
          counts
          (let [origin (vector-at pairs index)
                dest (vector-at pairs (+ index 1))]
            (cond
              (or (< origin 0) (>= origin states) (< dest 0) (>= dest states)) []
              (= origin from)
              (recur (+ index 2) (increment-count counts dest))
              :else (recur (+ index 2) counts))))))))

;; One-step empirical probability, rounded down to a basis point.
;; -1 means malformed counts or insufficient evidence.
(defn probability-bps [counts :vector-i64 dest :i64 min-count :i64] :i64
  (let [size (vector-count counts)]
    (if (or (> size 64) (< dest 0) (>= dest size) (< min-count 1))
      -1
      (loop [index 0 total 0]
        (if (>= index size)
          (if (< total min-count)
            -1
            (quot (* 10000 (vector-at counts dest)) total))
          (let [count (vector-at counts index)]
            (if (or (< count 0) (> count (- 100000 total)))
              -1
              (recur (+ index 1) (+ total count)))))))))
