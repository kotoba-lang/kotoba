(ns tsunagi.fixtures
  "Deterministic identities. Key generation costs ~150 ms each in the pure
  implementation, so tests share these instead of making their own."
  (:require [tsunagi.identity :as id]))

(defn seed [n] (vec (map #(bit-and (+ n (* 7 %)) 0xff) (range 32))))

(def alice (id/from-seed (seed 1)))
(def bob (id/from-seed (seed 2)))
(def relay-a (id/from-seed (seed 3)))
(def relay-b (id/from-seed (seed 4)))
