(ns tsunagi.crypto
  "The primitives tsunagi is built on, every one of them first-party kotoba:

  | primitive          | library                         |
  |--------------------|---------------------------------|
  | SHA-256, HMAC      | `org-nist-sha2` (`sha2.core`)   |
  | HKDF-SHA256        | `org-ietf-hpke` (`hpke.kdf`)    |
  | X25519             | `org-ietf-x25519`               |
  | Ed25519            | `org-ietf-ed25519` (`ed25519.sign`) |
  | ChaCha20-Poly1305  | `org-ietf-chacha20-poly1305`    |

  No host crypto and no npm package is reached. The cost of that is stated in
  the upstream libraries and repeated here: the X25519 ladder and Ed25519
  scalar multiplication are **not constant-time**. On a shared-CPU host an
  attacker able to time operations can learn key bits; on a phone or a radio
  node that is the owner's own hardware this is the accepted trade.

  Randomness is the one thing a portable library cannot produce. `random-bytes`
  reaches the host CSPRNG (WebCrypto / `SecureRandom`); every function that
  needs fresh secrets also accepts them as an argument so tests and replays
  are deterministic."
  (:require [sha2.core :as sha2]
            [hpke.kdf :as kdf]
            [x25519.core :as x]
            [ed25519.sign :as ed]
            [chacha20.aead :as aead]
            [tsunagi.wire :as w]))

(defn sha256 [bs] (sha2/sha256 (vec bs)))

(defn hmac-sha256 [k m] (sha2/hmac-sha256 (vec k) (vec m)))

(defn truncated-hash
  "The first `n` bytes of SHA-256 — tsunagi's address width is 16 bytes."
  [bs n]
  (subvec (vec (sha256 bs)) 0 n))

(defn hkdf
  "HKDF-SHA256 to `length` bytes."
  [ikm salt info length]
  (let [prk (kdf/extract kdf/hkdf-sha256 (vec salt) (vec ikm))
        r (kdf/expand kdf/hkdf-sha256 prk (vec info) length)]
    (if (= :ok (:status r))
      (:bytes r)
      (throw (ex-info "tsunagi.crypto/hkdf" r)))))

(defn x25519-public [secret] (x/public-key (vec secret)))

(defn x25519-shared
  "Shared secret, or nil for a non-contributory (all-zero) result — a peer that
  sends a low-order point must not get a predictable key."
  [secret peer-public]
  (let [r (x/x25519 (vec secret) (vec peer-public))]
    (when (and (= :ok (:status r))
               (not (every? zero? (:bytes r))))
      (:bytes r))))

(defn ed25519-secret [seed] (ed/secret-key! (vec seed)))

(defn ed25519-sign [secret-key-map message] (ed/sign secret-key-map (vec message)))

(defn ed25519-verify [public message signature]
  (ed/verify (vec public) (vec message) (vec signature)))

(def aead-key-bytes 32)
(def aead-nonce-bytes 12)
(def aead-tag-bytes 16)

(defn seal [key nonce aad plaintext]
  (:bytes (aead/seal (vec key) (vec nonce) (vec aad) (vec plaintext))))

(defn open
  "Plaintext or nil."
  [key nonce aad sealed]
  (let [r (aead/open (vec key) (vec nonce) (vec aad) (vec sealed))]
    (when (= :ok (:status r)) (:bytes r))))

(defn random-bytes
  "`n` bytes from the host CSPRNG."
  [n]
  #?(:cljs (let [a (js/Uint8Array. n)]
             (.getRandomValues js/crypto a)
             (vec (js/Array.from a)))
     :clj (let [a (byte-array n)]
            (.nextBytes (java.security.SecureRandom.) a)
            (mapv #(bit-and % 0xff) a))
     :default (throw (ex-info "tsunagi.crypto/random-bytes: no host entropy" {:n n}))))

(defn counter-nonce
  "A 12-byte AEAD nonce from a 4-byte direction tag and a 48-bit counter.
  Distinct directions never share a nonce under one key."
  [direction counter]
  (w/cat-bytes [0 0] (w/u32 direction) (w/u48 counter)))
