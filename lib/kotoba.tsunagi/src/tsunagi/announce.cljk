(ns tsunagi.announce
  "Announces: how a destination makes itself reachable without a directory.

  An announce is flooded through the mesh. Every node that relays it learns
  \"this destination is N hops away, via the neighbour I heard it from\" — the
  path table is nothing but remembered announces. Because the address is
  derived from the key (see `tsunagi.identity`), and the announce is signed by
  that key, a relay can verify an announce it has never seen the owner of.

      payload = public key (64)
             ++ name hash (10)
             ++ emission (10)    5 random bytes ++ 5-byte big-endian seconds
             ++ app-data (lp16)
             ++ signature (64)   Ed25519 over destination ++ everything above

  `emission` lets a node tell a newer announce from a replayed older one: the
  timestamp half orders them, the random half keeps two announces in the same
  second distinct."
  (:require [tsunagi.identity :as id]
            [tsunagi.packet :as p]
            [tsunagi.wire :as w]
            [tsunagi.crypto :as c]))

(defn- emission [random-5 now-seconds]
  (w/cat-bytes (vec (take 5 random-5))
               (let [hi (quot now-seconds 4294967296)]
                 (into [(bit-and hi 0xff)] (w/u32 (- now-seconds (* hi 4294967296)))))))

(defn emission-time
  "The seconds field of an emission."
  [em]
  (let [[a b d e f] (subvec (vec em) 5 10)]
    (+ (* a 4294967296) (* b 16777216) (* d 65536) (* e 256) f)))

(defn build
  "An announce packet map for `identity` (private) reachable as `app-name`.

  Options: `:app-data` bytes (e.g. capabilities, a display name), `:now`
  seconds, `:random` 5 bytes, `:context` (`:path-response` when answering a
  path request)."
  [identity app-name {:keys [app-data now random context]
                      :or {app-data [] context :none}}]
  (let [nh (id/name-hash app-name)
        dest (id/destination-hash identity app-name)
        em (emission (or random (c/random-bytes 5)) (or now 0))
        signed (w/cat-bytes dest (:public identity) nh em (w/lp16 app-data))
        sig (id/sign identity signed)]
    {:packet-type :announce
     :destination-type :single
     :hops 0
     :destination dest
     :context context
     :payload (w/cat-bytes (:public identity) nh em (w/lp16 app-data) sig)}))

(defn parse
  "Validate an announce packet map. Answers

      {:destination … :identity {:public … :hash …} :name-hash … :emission …
       :emitted-at seconds :app-data … :hops n}

  or nil when the signature fails, the destination is not the one the key and
  name produce, or the payload is malformed."
  [{:keys [packet-type destination payload hops]}]
  (when (= :announce packet-type)
    (let [c (w/cursor payload)]
      (when-let [[public c] (w/take-bytes c id/public-bytes)]
        (when-let [[nh c] (w/take-bytes c id/name-hash-bytes)]
          (when-let [[em c] (w/take-bytes c 10)]
            (when-let [[app-data c] (w/take-lp16 c)]
              (when-let [[sig c] (w/take-bytes c id/signature-bytes)]
                (when (w/done? c)
                  (let [ident (id/public-only public)]
                    (when (and ident
                               (w/bytes-eq? destination
                                            (id/destination-hash-from nh (:hash ident)))
                               (id/verify ident
                                          (w/cat-bytes destination public nh em (w/lp16 app-data))
                                          sig))
                      {:destination destination
                       :identity ident
                       :name-hash nh
                       :emission em
                       :emitted-at (emission-time em)
                       :app-data app-data
                       :hops hops})))))))))))

(defn newer?
  "Whether emission `a` is strictly newer than emission `b` (nil is oldest)."
  [a b]
  (or (nil? b)
      (let [ta (emission-time a) tb (emission-time b)]
        (or (> ta tb)
            (and (= ta tb) (pos? (w/compare-bytes a b)))))))

(defn encode [announce-packet] (p/encode announce-packet))
