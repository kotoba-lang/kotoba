(ns tsunagi.resource
  "Splitting a payload larger than one packet into parts, and putting it back.

      part = resource id (8) ++ index (u16) ++ total (u16) ++ data
      id   = SHA-256(whole payload)[0..8]

  Reassembly checks the whole payload against its id, so a part from another
  resource or a corrupted part cannot produce a wrong result — only none.
  Parts may arrive in any order and more than once."
  (:require [tsunagi.crypto :as c]
            [tsunagi.wire :as w]))

(def header-bytes 12)

(defn split
  "Parts of `payload`, each carrying at most `part-size` data bytes."
  [payload part-size]
  (let [payload (vec payload)
        rid (c/truncated-hash payload 8)
        chunks (if (empty? payload) [[]] (mapv vec (partition-all part-size payload)))
        total (count chunks)]
    (when (> total 65535)
      (throw (ex-info "tsunagi.resource: too many parts" {:parts total})))
    (vec (map-indexed (fn [i ch] (w/cat-bytes rid (w/u16 i) (w/u16 total) ch)) chunks))))

(defn parse-part [part]
  (let [cur (w/cursor part)]
    (when-let [[rid cur] (w/take-bytes cur 8)]
      (when-let [[i cur] (w/take-u16 cur)]
        (when-let [[total cur] (w/take-u16 cur)]
          (when (< i total)
            {:id rid :index i :total total :data (first (w/take-rest cur))}))))))

(defn assembler [] {})

(defn accept
  "Add a part. Answers `[assembler completed-payload-or-nil]`."
  [asm part]
  (if-let [{:keys [id index total data]} (parse-part part)]
    (let [rk (w/hex id)
          entry (get asm rk {:total total :parts {}})]
      (if (not= total (:total entry))
        [asm nil]
        (let [entry (assoc-in entry [:parts index] data)]
          (if (= total (count (:parts entry)))
            (let [whole (into [] (mapcat #(get-in entry [:parts %])) (range total))]
              (if (w/bytes-eq? id (c/truncated-hash whole 8))
                [(dissoc asm rk) whole]
                [(dissoc asm rk) nil]))
            [(assoc asm rk entry) nil]))))
    [asm nil]))

(defn missing
  "Indices still missing for a resource id."
  [asm id]
  (when-let [{:keys [total parts]} (get asm (w/hex id))]
    (vec (remove #(contains? parts %) (range total)))))
