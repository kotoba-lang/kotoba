(ns tsunagi.wire
  "Byte-level encoding shared by every tsunagi record.

  Bytes are vectors of ints in 0..255, as everywhere in kotoba-lang. Encoding
  is plain concatenation of fixed-width fields and length-prefixed fields; a
  decoder is a cursor `{:bytes v :at i}` threaded through `take-*` functions
  that answer `[value cursor]` or `nil` when the input is too short. Nothing
  here throws on malformed input — a radio delivers garbage routinely, and a
  decoder that throws turns noise into a crash.")

(defn ->bytes
  "Normalise any sequential of ints to a vector of 0..255."
  [xs]
  (mapv #(bit-and % 0xff) xs))

(defn cat-bytes
  "Concatenate byte sequences into one vector."
  [& parts]
  (into [] cat parts))

(defn u8 [n] [(bit-and n 0xff)])

(defn u16 [n]
  [(bit-and (quot n 256) 0xff) (bit-and n 0xff)])

(defn u32
  "Big-endian 4 bytes. Uses arithmetic rather than shifts so values up to
  2^32-1 survive on ClojureScript, whose shifts are signed int32."
  [n]
  [(bit-and (quot n 16777216) 0xff)
   (bit-and (quot n 65536) 0xff)
   (bit-and (quot n 256) 0xff)
   (bit-and n 0xff)])

(defn u48
  "Big-endian 6 bytes, for counters and millisecond clocks (< 2^48 stays exact
  in a double)."
  [n]
  (let [hi (quot n 4294967296)
        lo (- n (* hi 4294967296))]
    (into (u16 hi) (u32 lo))))

(defn lp8
  "A field with a one-byte length prefix (at most 255 bytes)."
  [bs]
  (let [bs (vec bs)]
    (when (> (count bs) 255)
      (throw (ex-info "tsunagi.wire: lp8 field longer than 255" {:length (count bs)})))
    (into [(count bs)] bs)))

(defn lp16
  "A field with a two-byte length prefix (at most 65535 bytes)."
  [bs]
  (let [bs (vec bs)]
    (when (> (count bs) 65535)
      (throw (ex-info "tsunagi.wire: lp16 field longer than 65535" {:length (count bs)})))
    (into (u16 (count bs)) bs)))

;; ---------------------------------------------------------------------------
;; Decoding cursor

(defn cursor [bs] {:bytes (vec bs) :at 0})

(defn remaining [{:keys [bytes at]}] (- (count bytes) at))

(defn take-bytes
  "`[bytes cursor]` for the next `n` bytes, or nil if fewer remain."
  [{:keys [bytes at] :as c} n]
  (when (and (>= n 0) (<= (+ at n) (count bytes)))
    [(subvec bytes at (+ at n)) (assoc c :at (+ at n))]))

(defn take-rest [{:keys [bytes at] :as c}]
  [(subvec bytes at) (assoc c :at (count bytes))])

(defn take-u8 [c]
  (when-let [[[b] c] (take-bytes c 1)] [b c]))

(defn take-u16 [c]
  (when-let [[[a b] c] (take-bytes c 2)] [(+ (* a 256) b) c]))

(defn take-u32 [c]
  (when-let [[[a b d e] c] (take-bytes c 4)]
    [(+ (* a 16777216) (* b 65536) (* d 256) e) c]))

(defn take-u48 [c]
  (when-let [[hi c] (take-u16 c)]
    (when-let [[lo c] (take-u32 c)]
      [(+ (* hi 4294967296) lo) c])))

(defn take-lp8 [c]
  (when-let [[n c] (take-u8 c)] (take-bytes c n)))

(defn take-lp16 [c]
  (when-let [[n c] (take-u16 c)] (take-bytes c n)))

(defn done? [c] (zero? (remaining c)))

;; ---------------------------------------------------------------------------
;; Text

(defn utf8
  "UTF-8 bytes of a string."
  [s]
  #?(:cljs (vec (js/Array.from (.encode (js/TextEncoder.) s)))
     :clj (mapv #(bit-and % 0xff) (.getBytes ^String s "UTF-8"))
     :default (throw (ex-info "tsunagi.wire/utf8: no host" {}))))

(defn utf8-str
  "Decode UTF-8 bytes to a string (malformed sequences become U+FFFD)."
  [bs]
  #?(:cljs (.decode (js/TextDecoder.) (js/Uint8Array.from (clj->js (vec bs))))
     :clj (String. (byte-array (map unchecked-byte bs)) "UTF-8")
     :default (throw (ex-info "tsunagi.wire/utf8-str: no host" {}))))

(def ^:private hex-digits "0123456789abcdef")

(defn hex [bs]
  (apply str (mapcat (fn [b] [(nth hex-digits (quot b 16)) (nth hex-digits (rem b 16))]) bs)))

(defn unhex [s]
  (when (even? (count s))
    (let [v (fn [ch] (let [i (.indexOf "0123456789abcdef" (str ch))
                           j (.indexOf "0123456789ABCDEF" (str ch))]
                       (cond (>= i 0) i (>= j 0) j :else nil)))
          ds (map v s)]
      (when (every? some? ds)
        (mapv (fn [[a b]] (+ (* a 16) b)) (partition 2 ds))))))

(defn bytes-eq?
  "Equality over the full length, without an early exit on the first mismatch."
  [a b]
  (let [a (vec a) b (vec b)]
    (and (= (count a) (count b))
         (zero? (reduce bit-or 0 (map bit-xor a b))))))

(defn compare-bytes
  "Lexicographic comparison of two byte vectors: negative, zero or positive."
  [a b]
  (let [a (vec a) b (vec b) n (min (count a) (count b))]
    (loop [i 0]
      (if (= i n)
        (- (count a) (count b))
        (let [d (- (nth a i) (nth b i))]
          (if (zero? d) (recur (inc i)) d))))))
