;; Acceptance test for webauthn.datom (port of datom.cljk).
;; main returns the number of failed cases (0 = all pass).
(ns webauthn.datom-test
  (:export [main])
  (:require [webauthn.datom :as d]))

(defn- chk [ok :bool] :i64 (if ok 0 1))
(defn- kv [m :document k :keyword v :document] :document (document-assoc m (document-keyword k) v))
(defn- fget [m :document k :keyword] :document
  (option-or (document-get m (document-keyword k)) (document-null)))
(defn- at0 [v :document] :document
  (option-or (document-vector-at v 0) (document-null)))
(defn- ex-str [s :string] :document (document-string s))

(defn main [] :i64
  (let [ch (kv (kv (kv (kv (document-map)
                           :webauthn.challenge/id (ex-str "c1"))
                       :webauthn.challenge/ceremony (document-keyword :create))
                   :webauthn.challenge/rp-id (ex-str "example.test"))
               :webauthn.challenge/expires-at (document-i64 99))
        cv (d/challenge-datoms ch)
        cr (at0 cv)
        c1 (chk (= (document-count cv) 1))
        c2 (chk (document-equal? (fget cr :db/id) (ex-str "c1")))
        c3 (chk (document-equal? (fget cr :webauthn.challenge/ceremony) (document-keyword :create)))
        c4 (chk (document-equal? (fget cr :webauthn.challenge/expires-at) (document-i64 99)))
        c5 (chk (not (document-contains cr (document-keyword :webauthn.challenge/id))))
        cred (kv (kv (kv (document-map) :webauthn.credential/id (ex-str "k1"))
                     :webauthn.credential/transports (document-vector-conj (document-vector) (ex-str "usb")))
                 :webauthn.credential/discoverable? (document-bool true))
        cc (at0 (d/credential-datoms cred))
        e1 (chk (document-equal? (fget cc :db/id) (ex-str "k1")))
        e2 (chk (document-equal? (fget cc :webauthn.credential/transports)
                                 (document-vector-conj (document-vector) (ex-str "usb"))))
        e3 (chk (document-equal? (fget cc :webauthn.credential/discoverable?) (document-bool true)))
        as (kv (kv (kv (document-map) :webauthn.assertion/challenge-id (ex-str "ch1"))
                   :webauthn.assertion/credential-id (ex-str "cred1"))
               :webauthn.assertion/sign-count (document-i64 7))
        ca (at0 (d/assertion-datoms as))
        f1 (chk (document-equal? (fget ca :db/id) (ex-str "ch1:cred1")))
        f2 (chk (document-equal? (fget ca :webauthn.assertion/sign-count) (document-i64 7)))
        f3 (chk (document-equal? (fget ca :webauthn.assertion/ok?) (document-null)))]
    (+ c1 (+ c2 (+ c3 (+ c4 (+ c5 (+ e1 (+ e2 (+ e3 (+ f1 (+ f2 f3))))))))))))
