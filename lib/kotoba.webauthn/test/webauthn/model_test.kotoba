(ns webauthn.model-test (:export [main]) (:require [webauthn.model :as p]))

(defn- kw [k :keyword] :document (document-keyword k))
(defn- str [s :string] :document (document-string s))
(defn- get-or-null [m :document k :keyword] :document
  (option-or (document-get m (document-keyword k)) (document-null)))

(defn- case-sets [] :i64
  (+ (if (document-equal? (p/ceremonies) (document-set (kw :registration) (kw :authentication) (kw :prf))) 0 1)
     (if (document-equal? (p/transports) (document-set (kw :usb) (kw :nfc) (kw :ble) (kw :internal) (kw :hybrid))) 0 1)
     (if (document-equal? (p/transports) (document-set (kw :usb) (kw :nfc) (kw :ble) (kw :internal))) 1 0)))

(defn- case-challenge [] :i64
  (let [opts (document-map :rp-id (str "example.com") :challenge (str "abc") :created-at (document-i64 100) :expires-at (document-i64 400))
        c (p/challenge (str "ch-1") (kw :registration) opts)]
    (+ (if (document-equal? c (document-map :webauthn.challenge/id (str "ch-1")
                                            :webauthn.challenge/ceremony (kw :registration)
                                            :webauthn.challenge/rp-id (str "example.com")
                                            :webauthn.challenge/user-handle (document-null)
                                            :webauthn.challenge/challenge (str "abc")
                                            :webauthn.challenge/created-at (document-i64 100)
                                            :webauthn.challenge/expires-at (document-i64 400))) 0 1)
       (if (document-equal? (get-or-null c :webauthn.challenge/rp-id) (str "example.com")) 0 1))))

(defn- case-credential [] :i64
  (let [opts (document-map :transports (document-vector (kw :usb) (kw :usb) (kw :nfc))
                           :discoverable? (document-bool true)
                           :aaguid (str "aa"))
        c (p/credential (str "cred-1") opts)
        bare (p/credential (str "cred-2") (document-map))]
    (+ (if (string=? (document-edn-print (get-or-null c :webauthn.credential/transports)) "#{:usb :nfc}") 0 1)
       (if (document-equal? (get-or-null c :webauthn.credential/discoverable?) (document-bool true)) 0 1)
       (if (document-equal? (get-or-null bare :webauthn.credential/transports) (document-set)) 0 1)
       (if (document-equal? (get-or-null bare :webauthn.credential/discoverable?) (document-bool false)) 0 1)
       (if (document-equal? (get-or-null c :webauthn.credential/aaguid) (str "aa")) 0 1))))

(defn- case-assertion [] :i64
  (let [chal (p/challenge (str "ch-1") (kw :authentication) (document-map))
        a (p/assertion chal (str "cred-1") true (document-map :sign-count (document-i64 7) :user-present? (document-bool true)))
        b (p/assertion chal (str "cred-1") false (document-map))]
    (+ (if (document-equal? (get-or-null a :webauthn.assertion/challenge-id) (str "ch-1")) 0 1)
       (if (document-equal? (get-or-null a :webauthn.assertion/ok?) (document-bool true)) 0 1)
       (if (document-equal? (get-or-null a :webauthn.assertion/sign-count) (document-i64 7)) 0 1)
       (if (document-equal? (get-or-null a :webauthn.assertion/user-verified?) (document-bool false)) 0 1)
       (if (document-equal? (get-or-null b :webauthn.assertion/ok?) (document-bool false)) 0 1)
       (if (document-equal? (get-or-null b :webauthn.assertion/sign-count) (document-null)) 0 1))))

(defn- case-prf [] :i64
  (let [e (p/prf-envelope (str "cred-1") (document-map :salt-ref (str "s") :wrapped-ref (str "w")))]
    (+ (if (document-equal? (get-or-null e :webauthn.prf/salt-ref) (str "s")) 0 1)
       (if (document-equal? (get-or-null e :webauthn.prf/wrapped-ref) (str "w")) 0 1)
       (if (document-equal? (get-or-null e :webauthn.prf/rp-id) (document-null)) 0 1))))

(defn main [] :i64
  (+ (case-sets) (case-challenge) (case-credential) (case-assertion) (case-prf)))
