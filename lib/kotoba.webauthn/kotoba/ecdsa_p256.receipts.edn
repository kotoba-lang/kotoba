;; KAT 実行 receipts — kexe_loader 経由（JUN-98 (b)、2026-10-19 実測）
;; 経路: amu compile --target aarch64-macos --jvm-free → amu extract-native --symbol <s> --output <bin>
;;       → KEXE_PAIRS=67108864 KEXE_VECTORS=4194304 KEXE_VECTOR_ITEMS=67108864 KEXE_FUEL=<max>
;;         kexe-loader <bin> <offset> 0 aarch64 -
;; 値 0 = その KAT グループ全緑。シンボルごとに instance を分けて実行。
;;
;; check-u256-mul   => 0   （16-bit lane 畳み込み、3 KAT）
;; check-reduce     => 0   （mod-p fold、6 KAT。python アルゴリズム移植 50/50 一致と二重検証）
;; check-jacobian   => 0   （2G / 3G、u256-add carry 修正後。修正前は 100 = 2G.x 不一致）
;; check-modn       => 0   （mod-n Barrett、6 KAT。sub 条件の逆転バグを修正後）
;; check-scalar-mult=> 未走（次 tick）
;; check-verify     => 実行時 :budget/cells :arena :pairs で天井到達（2^26 = loader 天井）
;;   正しさの失敗ではなく資源特性: 1 回の verify（scalar mult ×2 + 逆元）が
;;   ペアセル 6,700 万超を消費する構成。main（全グループ直列）も同じ理由で天井。
;;   対処候補: ホット経路の record 割当を flat 化 / 分割実行（上記のとおり）/
;;   amu test --native-runtime の one-instance-per-test 経路。
;;
;; 修正した実バグ 2 件:
;; 1. u256-add の carry が 2^32 の値を次 limb に足していた（0/1 シフトに修正）。
;;    check-u256 に carry 伝播と wrap の両 KAT を追加（両方向）。
;; 2. modn-reduce の n 減算条件が逆（hi != 0 のときだけ引くべきで、
;;    逆に常に引いて mod 2^512 で壊れていた）。

;; --- 追記（2026-10-19 実行走・最終）---
;; check-verify => 0 **ECDSA P-256 検証が pure kotoba で実行緑**（valid → 0、
;;   s 改ざん → 4、z 改ざん → 4）。実バグ 3 件を実行走で検出して修正:
;;   ① inv-bits の 32 ステップ固定（ビット長ループは limb 間の base を壊す）
;;   ② ecdsa-verify が Jacobian の x を直接比較していた → affine x =
;;     X3 * (Z3^2)^(p-2) を計算してから比較（modp-inv を追加）
;;   ③ modn-reduce の hi!=0 ガード（前日記録）
;; per-symbol instance で全グループ緑（u256 / mul / reduce / jacobian /
;; scalar-mult / modn / inv / verify）。main（全グループ直列）は pairs 天井
;; 2^6 で到達 — one-instance-per-test（amu test --native-runtime）が正。

;; --- JUN-98 完了（2026-10-19、全 KAT が kexe_loader 実行で緑）---
;; check-u256-mul / check-reduce / check-jacobian / check-scalar-mult /
;; check-modn / check-inv / check-verify / check-cose / check-authdata /
;; check-ceremony / check-clientdata => すべて 0（per-symbol instance）。
;; 追加で実行緑になったもの:
;;   COSE EC2 P-256 鍵抽出（77 bytes 固定形、hex 文字列規約、ヘッダ検証）
;;   authData ヘッダ（rpIdHash/flags/signCount fixed offsets）
;;   ceremony 状態遷移（init→pending-owner→session-live→txn-open→enrolled、
;;     無効遷移は拒否コード）+ ecdsa-verify 接続
;;   clientDataJSON 固定形パース（type/challenge/origin、quote 無し値前提）
;; string-substring は (s start end) の end-based（probe で実測）。
