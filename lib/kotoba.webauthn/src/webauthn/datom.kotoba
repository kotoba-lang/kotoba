;; Port of webauthn.datom (datom.cljk), Kotoba-native.
;;
;; Each builder takes a challenge / credential / assertion map as a :document
;; and returns a one-element :document vector, as the source returns a
;; one-element vector of maps.
;;
;; Named divergences from datom.cljk:
;;   - A field that is absent and a field holding nil are both stored as a nil
;;     document, as the source's map literal does (`(:k m)` is nil for both).
;;   - The assertion db/id is `(str challenge-id ":" credential-id)`. `str` is
;;     reproduced for the value kinds that occur: nil -> "", strings verbatim,
;;     anything else through document-edn-print (keywords keep their colon).

(ns webauthn.datom
  (:export [challenge-datoms credential-datoms assertion-datoms]))

(defn- fldd [m :document k :document] :document
  (option-or (document-get m k) (document-null)))

(defn- fld [m :document k :keyword] :document
  (fldd m (document-keyword k)))

(defn- kvd [m :document k :document v :document] :document
  (document-assoc m k v))

(defn- kv [m :document k :keyword v :document] :document
  (kvd m (document-keyword k) v))

;; Copy each key named in `ks` (a vector document of keywords) from src to dst
;; under the same name.
(defn- copy-keys [src :document dst :document ks :document] :document
  (let [n (document-count ks)]
    (loop [i 0 acc dst]
      (if (>= i n)
        acc
        (let [k (option-or (document-vector-at ks i) (document-null))]
          (recur (+ i 1) (kvd acc k (fldd src k))))))))

(defn- one [m :document] :document
  (document-vector-conj (document-vector) m))

(defn- kind-name [d :document] :string
  (keyword-name (document-kind d)))

(defn- str-of [d :document] :string
  (cond
    (string=? (kind-name d) "null") ""
    (string=? (kind-name d) "string") (option-or (document-string-value d) "")
    :else (document-edn-print d)))

(defn challenge-datoms [challenge :document] :document
  (one (kv (copy-keys challenge (document-map)
                      (document-edn-read "[:webauthn.challenge/ceremony :webauthn.challenge/rp-id :webauthn.challenge/user-handle :webauthn.challenge/challenge :webauthn.challenge/created-at :webauthn.challenge/expires-at]"))
           :db/id (fld challenge :webauthn.challenge/id))))

(defn credential-datoms [credential :document] :document
  (one (kv (copy-keys credential (document-map)
                      (document-edn-read "[:webauthn.credential/rp-id :webauthn.credential/user-handle :webauthn.credential/public-key-ref :webauthn.credential/aaguid :webauthn.credential/transports :webauthn.credential/discoverable? :webauthn.credential/created-at]"))
           :db/id (fld credential :webauthn.credential/id))))

(defn assertion-datoms [assertion :document] :document
  (one (kv (copy-keys assertion (document-map)
                      (document-edn-read "[:webauthn.assertion/challenge-id :webauthn.assertion/credential-id :webauthn.assertion/ok? :webauthn.assertion/sign-count :webauthn.assertion/user-present? :webauthn.assertion/user-verified? :webauthn.assertion/evidence-ref :webauthn.assertion/attested-at]"))
           :db/id (document-string
                   (string-concat
                    (string-concat (str-of (fld assertion :webauthn.assertion/challenge-id)) ":")
                    (str-of (fld assertion :webauthn.assertion/credential-id)))))))
