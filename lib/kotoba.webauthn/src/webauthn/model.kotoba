;; Port of webauthn.model (model.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from model.cljk:
;;   - ceremonies and transports are zero-arg fns returning :document sets
;;     (def cannot be exported, E2005).
;;   - a missing key in opts reads as document-null, and a key whose value is
;;     nil is kept as document-null in the record (as nil is kept in the source).
;;   - (set coll) is built from the elements of a vector, list or set, with
;;     duplicates dropped. The set is built from its EDN text, since set
;;     insertion is not a builtin. Runtime quirk (observed, amu 2026-11): a set
;;     read from EDN with two or more elements does not document-equal? a
;;     document-set literal with the same elements, although the literal sets
;;     are equal to each other in any order. Compare such sets by
;;     document-edn-print or document-set-contains?.
;;   - (boolean x) is truthy: any value other than nil/false is true.
;;   - the parameter named `challenge` in `assertion` is renamed `chal`, so
;;     it does not shadow the `challenge` fn of this namespace.

(ns webauthn.model
  (:export [ceremonies transports challenge credential assertion prf-envelope]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- truthy? [v :document] :bool
  (if (document-equal? v (document-null))
    false
    (if (document-equal? v (document-bool false)) false true)))

(defn- nil-doc? [d :document] :bool
  (string=? (document-edn-print d) "nil"))

(defn- vec-at [v :document i :i64] :document
  (option-or (document-vector-at v i) (document-null)))

;; elements of a collection as a :document vector (set/list re-read from EDN)
(defn- elems [d :document] :document
  (let [t (document-edn-print d)]
    (if (string=? t "nil")
      (document-vector)
      (if (string=? (string-substring t 0 1) "[")
        d
        (if (string=? (string-substring t 0 1) "#")
          (document-edn-read (string-concat "[" (string-concat (string-substring t 2 (- (string-length t) 1)) "]")))
          (if (string=? (string-substring t 0 1) "(")
            (document-edn-read (string-concat "[" (string-concat (string-substring t 1 (- (string-length t) 1)) "]")))
            (document-vector)))))))

(defn- has-doc? [v :document x :document] :bool
  (loop [i 0]
    (if (= i (document-count v))
      false
      (if (document-equal? (vec-at v i) x) true (recur (+ i 1))))))

(defn- join-edn [v :document] :string
  (loop [i 0 acc ""]
    (if (= i (document-count v))
      acc
      (recur (+ i 1) (string-concat acc (string-concat (document-edn-print (vec-at v i)) " "))))))

;; a :document vector of distinct elements to a :document set
(defn- vec->set [v :document] :document
  (document-edn-read (string-concat "#{" (string-concat (join-edn v) "}"))))

;; (set coll): the distinct elements of coll as a set
(defn- to-set [coll :document] :document
  (let [es (elems coll)]
    (loop [i 0 uniq (document-vector)]
      (if (= i (document-count es))
        (vec->set uniq)
        (let [x (vec-at es i)]
          (recur (+ i 1) (if (has-doc? uniq x) uniq (document-vector-conj uniq x))))))))

(defn ceremonies [] :document
  (document-set (document-keyword :registration)
                (document-keyword :authentication)
                (document-keyword :prf)))

(defn transports [] :document
  (document-set (document-keyword :usb)
                (document-keyword :nfc)
                (document-keyword :ble)
                (document-keyword :internal)
                (document-keyword :hybrid)))

(defn challenge [id :document ceremony :document opts :document] :document
  (document-map :webauthn.challenge/id id
                :webauthn.challenge/ceremony ceremony
                :webauthn.challenge/rp-id (field opts :rp-id)
                :webauthn.challenge/user-handle (field opts :user-handle)
                :webauthn.challenge/challenge (field opts :challenge)
                :webauthn.challenge/created-at (field opts :created-at)
                :webauthn.challenge/expires-at (field opts :expires-at)))

(defn credential [id :document opts :document] :document
  (document-map :webauthn.credential/id id
                :webauthn.credential/rp-id (field opts :rp-id)
                :webauthn.credential/user-handle (field opts :user-handle)
                :webauthn.credential/public-key-ref (field opts :public-key-ref)
                :webauthn.credential/aaguid (field opts :aaguid)
                :webauthn.credential/transports (to-set (field opts :transports))
                :webauthn.credential/discoverable? (document-bool (truthy? (field opts :discoverable?)))
                :webauthn.credential/created-at (field opts :created-at)))

(defn assertion [chal :document credential-id :document ok? :bool opts :document] :document
  (document-map :webauthn.assertion/challenge-id (field chal :webauthn.challenge/id)
                :webauthn.assertion/credential-id credential-id
                :webauthn.assertion/ok? (document-bool ok?)
                :webauthn.assertion/sign-count (field opts :sign-count)
                :webauthn.assertion/user-present? (document-bool (truthy? (field opts :user-present?)))
                :webauthn.assertion/user-verified? (document-bool (truthy? (field opts :user-verified?)))
                :webauthn.assertion/evidence-ref (field opts :evidence-ref)
                :webauthn.assertion/attested-at (field opts :attested-at)))

(defn prf-envelope [credential-id :document opts :document] :document
  (document-map :webauthn.prf/credential-id credential-id
                :webauthn.prf/rp-id (field opts :rp-id)
                :webauthn.prf/salt-ref (field opts :salt-ref)
                :webauthn.prf/wrapped-ref (field opts :wrapped-ref)
                :webauthn.prf/created-at (field opts :created-at)))
