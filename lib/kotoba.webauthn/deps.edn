{:paths ["src"]
 ;; cacao.edge.cbor -- the shared edge CBOR decoder (definite-length RFC 8949
 ;; subset over js/Uint8Array) that webauthn.adapters.edge needs for
 ;; attestationObject and COSE_Key. It lives in the cacao repo for historical
 ;; reasons and is not CACAO-specific; depending on it beats a fifth
 ;; hand-rolled CBOR decoder in this workspace. Only the CLJS edge adapter
 ;; pulls it in -- the portable model/ports/validation namespaces have no
 ;; dependency at all, and `kbb -M:test` never loads it.
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/org-chainagnostic-cacao {:local/root "../org.chainagnostic.cacao"}}
 :aliases {:test {:extra-paths ["test"]}}}
