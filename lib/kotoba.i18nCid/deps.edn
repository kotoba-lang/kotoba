{:paths ["src" "resources"]
 ;; git/sha pins (workspace-standard). The sibling local/root dev variant
 ;; lives in the :dev alias below.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/io-ipld {:local/root "../kotoba.ioIpld"}
        io.github.kotoba-lang/kotobase-lake {:local/root "../kotoba.kotobaseLake"}
        io.github.kotoba-lang/io-ipld-car {:local/root "../kotoba.ioIpldCar"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :dev {:extra-deps {io.github.kotoba-lang/i18n {:local/root "../i18n"}}}}}
