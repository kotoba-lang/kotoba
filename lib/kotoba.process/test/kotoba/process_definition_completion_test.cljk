(ns kotoba.process-definition-completion-test
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.process.error-types :as errors]
            [kotoba.process.iprocess :as legacy]
            [kotoba.process.process :as canonical]
            [kotoba.lang.process :as original]))

(deftest legacy-protocol-keeps-its-own-dispatch-identity
  (let [old (reify legacy/IProcess
              (spawn! [_ request] {:tag :ok :request request}))
        current (reify canonical/Process
                  (spawn! [_ request] {:tag :ok :request request}))]
    (is (= {:tag :ok :request {:argv ["injected"]}}
           (legacy/spawn! old {:argv ["injected"]})))
    (is (= {:tag :ok :request {:argv ["injected"]}}
           (canonical/spawn! current {:argv ["injected"]})))
    (is (not (satisfies? canonical/Process old)))
    (is (not (satisfies? legacy/IProcess current)))))

(deftest error-keywords-retain-the-original-contract
  (is (= original/error-types errors/error-types))
  (is (contains? errors/error-types :process/timeout))
  (is (contains? errors/error-types :process/not-allowed)))
