(ns kotoba.process-test
  "The facade kotoba.process: it loads (it did not on kbb until 2026-09-24),
  `sh` parses clojure.java.shell's argument grammar, and `exec` answers."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.process :as p]
            [kotoba.lang.process-host :as host]))

(defn- throws? [f] (try (f) false (catch #?(:clj Exception :cljs :default) _ true)))

(deftest facade-sh-is-java-shell-sh
  (is (identical? p/sh host/java-shell-sh)))

(deftest facade-sh-returns-clojure-java-shell-shape
  (is (= {:exit 0 :out "hi\n" :err ""} (p/sh "echo" "hi"))))

(deftest facade-sh-takes-keyword-options-like-clojure-java-shell
  (testing ":in and :dir are keyword/value pairs after the leading strings"
    (is (= {:exit 0 :out "piped" :err ""} (p/sh "cat" :in "piped")))
    (is (= "/" (-> (p/sh "pwd" :dir "/") :out (subs 0 1)))))
  (testing "the keywords are NOT passed as arguments (process-host/sh would pass them)"
    (is (= "a\n" (:out (p/sh "echo" "a" :dir "/"))))
    (is (= "a :dir /\n" (:out (host/sh "echo" "a" :dir "/")))))
  (testing "an odd option count throws, as clojure.java.shell does"
    (is (throws? #(p/sh "echo" "a" :dir))))
  (testing "a trailing map is an odd option count there too"
    (is (throws? #(p/sh "echo" "a" {:dir "/"}))))
  (testing ":env / :out-enc / a non-string :in throw instead of being ignored"
    (is (throws? #(p/sh "env" :env {"A" "1"})))
    (is (throws? #(p/sh "cat" "f" :out-enc :bytes)))
    (is (throws? #(p/sh "cat" :in (p/exec ["echo"]))))))

(deftest facade-sh-bounded-contract
  (testing "argv[0] with a path separator is refused, never spawned"
    (is (= {:exit -1 :out "" :err "sh rejected: path-command"} (p/sh "/bin/echo" "x"))))
  (testing "a blank argument is refused"
    (is (= {:exit -1 :out "" :err "sh rejected: bad-arg"} (p/sh "echo" "")))))

(deftest facade-exec-runs
  (is (= {:status 0 :stdout "hi\n" :stderr ""} (p/exec ["echo" "hi"]))))
