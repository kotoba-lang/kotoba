;; Native route exposes pure spawn validation, without OS process authority.
(ns kotoba.process
  (:export [validate-spawn])
  (:require [kotoba.lang.process :as impl]))
(defn validate-spawn
  ([argv [:list :string] max-output :i64 timeout :i64] [:option :keyword]
   (impl/validate-spawn argv max-output timeout))
  ([argv [:list :string] max-output :i64 timeout :i64 allowed [:set :string]] [:option :keyword]
   (impl/validate-spawn argv max-output timeout allowed)))
