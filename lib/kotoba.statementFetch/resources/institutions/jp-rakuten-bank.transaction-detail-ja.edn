;; 楽天銀行 — 入出金明細 (Japanese), PDF.
;;
;; Immediate PDF download for any window within the last 24 months, up to
;; 3,000 entries. Rakuten's English documents (英文残高証明書) are NOT
;; reachable this way: they are phone-request only and arrive by post in
;; 1–10 days, so there is deliberately no `*-en` flow for this institution.
;;
;; Contains structure only — no account number, no credential, no personal
;; data. Every post-login step is unverified pending a discovery run.

{:institution/id      :jp-rakuten-bank
 :institution/name    "楽天銀行"
 :institution/country "JP"
 :document/id         :transaction-detail-ja
 :document/name       "入出金明細 (Japanese)"
 :document/language   :ja

 :flow/login
 {:step/type      :handoff
  :handoff/url    "https://www.rakuten-bank.co.jp/"
  :handoff/reason "ネットバンキングの認証情報は人間が入力する。agent は触れない。"
  :handoff/done-when {:expect/text "ログアウト"}}

 :flow/steps
 [{:step/type :snapshot
   :step/note "post-login landing; confirms the handoff actually authenticated"}

  {:step/type       :click
   :step/selector   "text=入出金明細"
   :step/unverified true}

  {:step/type       :fill
   :step/selector   "[name=dateFrom]"
   :step/value      "{{from}}"
   :step/unverified true}

  {:step/type       :fill
   :step/selector   "[name=dateTo]"
   :step/value      "{{to}}"
   :step/unverified true}

  {:step/type       :click
   :step/selector   "text=照会"
   :step/unverified true}

  {:step/type       :download
   :step/selector   "text=PDF形式でダウンロード"
   :step/path       "{{out}}"
   :step/unverified true}]}
