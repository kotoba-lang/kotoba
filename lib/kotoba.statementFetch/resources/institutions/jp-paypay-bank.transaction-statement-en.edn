;; PayPay銀行 — English transaction statement (英文 取引明細書), PDF.
;;
;; Used to satisfy "personal bank statement from the last 90 days" requests
;; from non-Japanese institutions (e.g. US bank onboarding / KYC), which will
;; not accept a Japanese-language 入出金明細.
;;
;; Contains structure only: public URLs, selectors, step order. No account
;; number, no branch number, no credential, no personal data — this file lives
;; in a public repository.
;;
;; Verified 2026-07-25:
;;   - the personal login entry point below (extracted from `Janet_Login_URL`
;;     on https://www.paypay-bank.co.jp/; the site's visible "ログイン" links
;;     are `javascript:void(0)` and resolve through `jnb_tologin()`).
;; Unverified:
;;   - every post-login step. They are marked `:step/unverified true` and must
;;     be replaced from a discovery run before this flow is trusted. See
;;     `bin/statement_fetch.cljk discover`.
;;
;; Fee/availability note (公式ページ現行記載, 2026-07-25): 取引明細書 is
;; 880 JPY per issuance and the English variant supports immediate PDF. Older
;; third-party write-ups describing a free English 残高証明書 predate this.

{:institution/id      :jp-paypay-bank
 :institution/name    "PayPay銀行"
 :institution/country "JP"
 :document/id         :transaction-statement-en
 :document/name       "English transaction statement (英文 取引明細書)"
 :document/language   :en

 ;; Authentication is a human handoff. The agent opens the page and stops.
 ;; The operator authenticates with their own password manager; the agent
 ;; never sees, stores, or types the credential.
 :flow/login
 {:step/type      :handoff
  :handoff/url    "https://login.paypay-bank.co.jp/wctx/LoginAction.do"
  :handoff/reason "ネットバンキングの認証情報は人間が入力する。agent は触れない。"
  :handoff/fields ["店番号" "口座番号" "ログインパスワード"]
  :handoff/done-when {:expect/text "ログアウト"}}

 :flow/steps
 [{:step/type :snapshot
   :step/note "post-login landing; confirms the handoff actually authenticated"}

  {:step/type       :click
   :step/selector   "text=取引明細"
   :step/unverified true
   :step/note       "navigate to 取引明細照会 / 証明書発行"}

  {:step/type       :select
   :step/selector   "[name=language]"
   :step/value      "英文"
   :step/unverified true}

  {:step/type       :fill
   :step/selector   "[name=dateFrom]"
   :step/value      "{{from}}"
   :step/unverified true}

  {:step/type       :fill
   :step/selector   "[name=dateTo]"
   :step/value      "{{to}}"
   :step/unverified true}

  {:step/type       :click
   :step/selector   "text=照会"
   :step/unverified true}

  {:step/type       :download
   :step/selector   "text=PDF"
   :step/path       "{{out}}"
   :step/unverified true}]}
