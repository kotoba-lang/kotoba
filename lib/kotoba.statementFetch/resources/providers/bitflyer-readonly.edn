{:provider/id :bitflyer/readonly
 :provider/kind :crypto
 :auth/kind :hmac-sha256
 :auth/api-key-env "BITFLYER_READONLY_KEY"
 :auth/api-secret-env "BITFLYER_READONLY_SECRET"
 :api/base-url "https://api.bitflyer.com"
 :api/allowed-methods ["GET"]
 :api/read-paths ["/v1/me/getpermissions" "/v1/me/getbalance"
                  "/v1/me/getbalancehistory" "/v1/me/getexecutions"
                  "/v1/me/getcoinins" "/v1/me/getcoinouts"
                  "/v1/me/getdeposits" "/v1/me/getwithdrawals"]
 :provider/setup :readonly-api-key-required}
