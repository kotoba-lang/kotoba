#!/usr/bin/env kbb
;; git-remote-kotoba + both adapters, end to end under kbb (nbb) -- the host
;; the bin/ scripts actually run on. Run from the repo root:
;;
;;   kbb --backend sci --classpath "src:test:$(kbb -Spath)" test/run_remote_helper.cljk
;;
;; `kbb -M:test` runs these too, with the rest of the suite; this runner is
;; the fast path when only bin/ and bonsai.remote-helper changed.
(require '[cljs.test :as t]
         '[remote-helper-test])

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (when-not (t/successful? m) (set! (.-exitCode js/process) 1)))

(t/run-tests 'remote-helper-test)
