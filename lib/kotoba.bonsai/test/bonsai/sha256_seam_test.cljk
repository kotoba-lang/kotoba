(ns bonsai.sha256-seam-test
  "node:crypto's SHA-256 under multiformats' digest seam changes no CID.

   bonsai.private-remote installs it for speed (the portable digest is the
   cost that dominates sealing a multi-megabyte snapshot under kbb). The seam
   already refuses a candidate that disagrees with the portable digest on its
   corpus; this pins the property bonsai depends on beyond that corpus: the
   golden CIDs of conformance-test and the Git OID bridge, a megabyte, and the
   host byte shapes bonsai actually hands it (Uint8Array, kbb's Int8Array, a
   byte vector). The portable digest is put back afterwards, so the rest of
   the suite measures what it always measured."
  (:require [kotoba.bytes :as kbytes]
            [kotoba.test :refer [deftest is testing]]
            [multiformats.core :as mf]
            #?@(:cljs [[bonsai.private-remote :as remote]
                       [bonsai.git-object :as git-object]
                       [bonsai.repo :as repo]])))

#?(:cljs
   (deftest node-sha256-agrees-with-the-portable-digest-and-moves-no-cid
     (let [inputs [(js/Uint8Array. 0)
                   (.encode (js/TextEncoder.) "abc")
                   (js/Uint8Array.from (range 200))
                   (kbytes/utf8-bytes "kotoba 日本語\n")             ; Int8Array on kbb
                   [0 1 2 254 255]
                   (let [b (js/Uint8Array. (* 1024 1024))]
                     (dotimes [i (.-length b)] (aset b i (bit-and (* i 7) 0xff)))
                     b)]
           scene "{:game/id :m0/fixture\n :world {:gravity 26 :jump 9}\n :render/sky {:zenith [0.20 0.42 0.78]}}\n"
           cids (fn [] (mapv #(str (mf/cidv1-raw %)) inputs))]
       (is (= :portable (mf/sha256-provider)))
       (doseq [b inputs]
         (is (= (vec (js/Array.from (mf/portable-sha256 b)))
                (vec (js/Array.from (remote/node-sha256 b))))))
       (let [before (cids)]
         (remote/install-sha256!)
         (try
           (is (= :installed (mf/sha256-provider)))
           (is (= before (cids)) "every CID is the same string")
           (is (= "bafkreibvmwcaurdcl3rf6vuayg7xosjsg6iu4ymm72w6adtaa7qronuy74"
                  (str (mf/cidv1-raw (.encode (js/TextEncoder.) scene))))
               "conformance-test's golden raw CID, through the installed digest")
           (testing "the Git OID bridge is unaffected (SHA-1, not this seam)"
             (let [[_ {:keys [oid cid]}] (git-object/write-object (repo/empty-repo) "blob" (kbytes/utf8-bytes "hello\n"))]
               (is (= "ce013625030ba8dba906f756967f9e9ca394464a" oid))
               (is (string? cid))))
           (finally
             (mf/install-sha256! mf/portable-sha256))))
       (is (= :portable (mf/sha256-provider)) "put back for the rest of the suite"))))

#?(:clj
   (deftest the-jvm-already-uses-message-digest
     (is (= :message-digest (mf/sha256-provider)))))
