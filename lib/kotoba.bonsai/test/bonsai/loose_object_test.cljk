(ns bonsai.loose-object-test
  (:require [kotoba.bytes :as kbytes] [kotoba.io :as kio] [kotoba.process :as shell]
            [bonsai.loose-object :as loose]
            [kotoba.test :refer [deftest is]]))

(defn- utf8 [s]
  #?(:clj (kbytes/utf8-bytes ^String s)
     :cljs (.encode (js/TextEncoder.) s)))

(deftest loose-roundtrip
  (let [body (utf8 "hello\n")
        decoded (loose/decode (loose/encode "blob" body))]
    (is (= "blob" (:type decoded)))
    (is (= "ce013625030ba8dba906f756967f9e9ca394464a" (:oid decoded)))
    (is (= (vec body) (vec (:body decoded))))))

(deftest inflated-size-is-bounded
  (is (= :inflated-limit
         (try (loose/decode (loose/encode "blob" (utf8 "hello\n")) 5)
              nil
              (catch #?(:clj Exception :cljs js/Error) e (:reason (ex-data e)))))))

(deftest malformed-zlib-fails-closed-with-a-reason
  ;; Both runtimes name the same defect the same way, whichever inflater
  ;; found it (java.util.zip.Inflater on the JVM, org-ietf-deflate on kbb).
  (let [good (vec (map #(bit-and % 0xff) (loose/encode "blob" (utf8 "hello\n"))))
        reason (fn [bs] (try (loose/decode (kbytes/->host-bytes bs)) nil
                             (catch #?(:clj Exception :cljs js/Error) e (:reason (ex-data e)))))]
    (is (= :trailing-zlib (reason (conj good 0))))
    (is (= :truncated-zlib (reason (subvec good 0 (- (count good) 6)))))))

;; Real git, both directions, on every runtime: kotoba.io and kotoba.process
;; are the JVM's and Node's own filesystem and spawn behind one surface, so
;; these are no longer JVM-only.
(defn- rm-rf [dir]
  (doseq [f (reverse (kio/file-seq dir))] (kio/delete f)))

(deftest loose-file-is-readable-by-git
  (let [dir (kio/temp-dir "bonsai-loose-")
        git-dir (kio/file dir ".git")
        oid "ce013625030ba8dba906f756967f9e9ca394464a"
        object-dir (kio/file git-dir (str "objects/" (subs oid 0 2)))
        object-file (kio/file object-dir (subs oid 2))]
    (try
      (is (zero? (:exit (shell/sh "git" "init" (kio/path dir)))))
      (kio/mkdirs object-dir)
      (kio/write-bytes object-file (loose/encode "blob" (utf8 "hello\n")))
      (let [{:keys [exit out err]} (shell/sh "git" "-C" (kio/path dir)
                                             "cat-file" "-p" oid)]
        (is (zero? exit) err)
        (is (= "hello\n" out)))
      (finally (rm-rf dir)))))

(deftest git-written-loose-file-decodes
  (let [dir (kio/temp-dir "bonsai-loose-git-")]
    (try
      (is (zero? (:exit (shell/sh "git" "init" "-q" (kio/path dir)))))
      (kio/write-string (kio/file dir "k.txt") "kotoba 日本語\n")
      (let [oid (.trim ^String (:out (shell/sh "git" "-C" (kio/path dir)
                                                "hash-object" "-w" "k.txt")))
            decoded (loose/decode (kio/read-all-bytes
                                   (kio/file dir (str ".git/objects/" (subs oid 0 2)
                                                      "/" (subs oid 2)))))]
        (is (= oid (:oid decoded)))
        (is (= "blob" (:type decoded)))
        (is (= (vec (map #(bit-and % 0xff) (utf8 "kotoba 日本語\n")))
               (vec (map #(bit-and % 0xff) (:body decoded))))))
      (finally (rm-rf dir)))))
