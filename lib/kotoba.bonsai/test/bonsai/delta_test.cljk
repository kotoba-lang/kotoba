(ns bonsai.delta-test
  (:require [kotoba.bytes :as kbytes] [bonsai.delta :as delta]
            [kotoba.test :refer [deftest is]]))

(defn- utf8 [s]
  #?(:clj (kbytes/utf8-bytes ^String s)
     :cljs (.encode (js/TextEncoder.) s)))

(deftest literal-delta-roundtrip
  (let [base (utf8 "hello") result (utf8 "hello kotoba")]
    (is (= (vec result) (vec (delta/apply-delta base (delta/literal-delta base result)))))))

(deftest copy-and-insert-delta
  ;; base-size=5, result-size=6, copy offset=0 size=5, insert "!"
  (is (= (vec (utf8 "hello!"))
         (vec (delta/apply-delta (utf8 "hello")
                                 [5 6 0x90 5 1 33])))))

(defn- reason [f]
  (try (f) :accepted
       (catch #?(:clj Exception :cljs :default) e (:reason (ex-data e)))))

(deftest malformed-delta-sizes-and-copy
  ;; 2^32 + 1 used to wrap to 1 on cljs, admitting a false base/result size.
  (is (= :delta-base-size
         (reason #(delta/apply-delta [120] [0x81 0x80 0x80 0x80 0x10 1 1 120]))))
  (is (= :delta-result-size
         (reason #(delta/apply-delta [120] [1 0x81 0x80 0x80 0x80 0x10 1 120]))))
  (is (= :delta-copy-bounds
         (reason #(delta/apply-delta [120] [1 1 0x98 0x80 1]))))
  (is (= :truncated-delta
         (reason #(delta/apply-delta [120] [1 1 0x91]))))
  (is (= :delta-result-size
         (reason #(delta/apply-delta [120] [1 0 1 120]))))
  (is (= :delta-size
         (reason #(delta/apply-delta [] (repeat 10 0xff))))))

(deftest copy-default-size-is-65536
  (let [base (vec (repeat 65536 120))]
    (is (= base (vec (delta/apply-delta base [0x80 0x80 4 0x80 0x80 4 0x80]))))))
