#!/usr/bin/env kbb
(ns kotoba-b2-git-adapter (:require [bonsai.b2-git :as b2] ["node:fs" :as fs]))
(try
  (b2/install-hash!)
  (let [[operation url gd & extra] *command-line-args*]
    (b2/require! (and url gd (empty? extra)) "Expected fetch|receive|push URL CACHE")
    (case operation
      "fetch" (b2/fetch! url gd (fs/realpathSync *file*))
      "receive" (b2/receive! url gd (fs/readFileSync 0 "utf8"))
      ;; B2 publication is inside pre-receive, before native Git acknowledges.
      "push" nil
      (b2/fail! "Unsupported adapter operation" {})))
  (.exit js/process 0)
  (catch :default e (fs/writeSync 2 (str "kotoba-b2-git-adapter: " (ex-message e) "\n")) (.exit js/process 1)))
