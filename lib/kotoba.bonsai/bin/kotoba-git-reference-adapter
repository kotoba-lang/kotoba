#!/usr/bin/env kbb
(ns kotoba-git-reference-adapter
  "Filesystem reference implementation of the network adapter contract.
   KOTOBA_GIT_REFERENCE_ROOT maps kotoba://host/path to a bare repo under that
   root. Production adapters replace copy/clone with CID hydration and signed
   ref-event admission."
  (:require ["node:fs" :as fs]
            ["node:path" :as path]
            ["node:child_process" :as cp]))

(defn fail! [m] (fs/writeSync 2 (str m "\n")) (.exit js/process 1))

(defn run! [argv]
  (let [r (cp/spawnSync (first argv) (clj->js (rest argv)) #js {:stdio "inherit"})]
    (when-not (= 0 (.-status r)) (.exit js/process (or (.-status r) 1)))))

(let [[operation remote cache] *command-line-args*
      root (.. js/process -env -KOTOBA_GIT_REFERENCE_ROOT)]
  (when-not (and root (path/isAbsolute root))
    (fail! "KOTOBA_GIT_REFERENCE_ROOT must be absolute"))
  (when-not (and remote (.startsWith remote "kotoba://"))
    (fail! "reference adapter accepts kotoba:// URLs only"))
  (let [relative (subs remote (count "kotoba://"))]
    (when (or (= "" (.trim relative)) (.includes relative "..")
              (.includes relative "\\") (.includes relative "\u0000"))
      (fail! "unsafe reference remote path"))
    (let [source (path/join root (str relative ".git"))]
      (case operation
        "fetch" (do
                  (when-not (fs/existsSync source) (run! ["git" "init" "--bare" source]))
                  (if (fs/existsSync (path/join cache "HEAD"))
                    (run! ["git" "--git-dir" cache "fetch" "--prune" source "+refs/*:refs/*"])
                    (run! ["git" "clone" "--mirror" source cache])))
        "push" (run! ["git" "--git-dir" cache "push" "--mirror" source])
        (fail! (str "unsupported adapter operation: " operation))))))
