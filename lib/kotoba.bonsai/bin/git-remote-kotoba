#!/usr/bin/env kbb
(ns git-remote-kotoba
  "Git remote-helper transport bridge.

   URL forms:
     kotoba::/absolute/path/to/repo.git
     kotoba:///absolute/path/to/repo.git
     kotoba://host/path   (materialized by $KOTOBA_GIT_ADAPTER)

   This first transport adapter speaks Git's `connect` capability and hands
   the byte stream to upload-pack/receive-pack. The repository path may be a
   local mount or a kotobase-managed materialized bare repo. Signed peer-ref
   admission remains an application boundary; this helper never invents
   authority from filesystem possession.

   Runs under kbb (nbb). Git runs helpers with the caller repository as cwd,
   so deps.edn-relative classpath discovery is not reliable: the
   implementation is put on the classpath relative to this executable, and
   installed copies must preserve bin/../src."
  (:require ["node:fs" :as fs]
            ["node:path" :as path]
            [nbb.classpath :as classpath]))

(classpath/add-classpath
 (path/join (path/dirname (fs/realpathSync *file*)) ".." "src"))

(require '[bonsai.remote-helper :as helper])

(.exit js/process (helper/main! (vec *command-line-args*) (.-env js/process)))
