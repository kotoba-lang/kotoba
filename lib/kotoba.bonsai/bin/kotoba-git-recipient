#!/usr/bin/env kbb
(ns kotoba-git-recipient
  "The private-Git recipient key store.

     kotoba-git-recipient init   create the X25519 + ML-KEM-768 keys (refuses to overwrite)
     kotoba-git-recipient show   print the public recipient descriptor (EDN)

   The store is KOTOBA_GIT_RECIPIENT_FILE, default
   ~/.config/kotoba/rad/recipient.edn: mode 0600 in a 0700 directory. Neither
   command ever prints private key material; `show`'s output is what another
   machine puts in its KOTOBA_GIT_RECIPIENTS file to seal to this one."
  (:require ["node:fs" :as fs]
            [bonsai.recipient-store :as store]))

(defn- fail! [m]
  (fs/writeSync 2 (str "kotoba-git-recipient: " m "\n"))
  (.exit js/process 1))

(let [[command & more] *command-line-args*
      file (store/store-path (.-env js/process))]
  (try
    (case (when-not more command)
      "init" (do (prn (store/generate! file))
                 (fs/writeSync 2 (str "kotoba-git-recipient: created " file "\n")))
      "show" (prn (store/public-descriptor (store/load-record file)))
      (fail! "usage: kotoba-git-recipient init|show"))
    (catch :default e (fail! (ex-message e)))))
