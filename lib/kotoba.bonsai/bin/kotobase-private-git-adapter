#!/usr/bin/env kbb
(ns kotobase-private-git-adapter
  "KOTOBA_GIT_ADAPTER for kotobase's encrypted private-Git route.

     kotobase-private-git-adapter fetch|push kotoba://<host>/<rid> <cache>

   git-remote-kotoba runs `fetch` before every connect and `push` after a
   successful receive-pack. The work is bonsai.private-remote; this file is
   argv and exit codes.

   Environment (nothing secret travels in argv):
     KOTOBA_GIT_BISCUIT_FILE    file holding the repository Biscuit (re-read
                                per request; kotoba-biscuit-mint writes it)
     KOTOBA_GIT_RECIPIENT_FILE  this machine's key store
                                (default ~/.config/kotoba/rad/recipient.edn;
                                kotoba-git-recipient init creates it)
     KOTOBA_GIT_RECIPIENTS      optional EDN vector of further public
                                recipients {:id :pub :pq-pub} to seal to
     KOTOBA_GIT_ALLOW_HTTP_LOOPBACK=1  plain http to 127.0.0.1/localhost (tests)

   Launched by `#!/usr/bin/env kbb` from any cwd: kbb finds this repository's
   deps.edn from the script's real path, so src/, the pinned :git/sha deps
   and their npm modules (@noble/*, installed under ~/.gitlibs by kbb and put
   on NODE_PATH) resolve without a wrapper. A symlink to this file keeps
   working; a COPY elsewhere does not."
  (:require ["node:fs" :as fs]
            [bonsai.private-remote :as remote]
            [bonsai.recipient-store :as store]))

(defn- fail! [m]
  (fs/writeSync 2 (str "kotobase-private-git-adapter: " m "\n"))
  (.exit js/process 1))

(let [[operation url cache & more] *command-line-args*]
  (when (or more (not (#{"fetch" "push"} operation)) (not url) (not cache))
    (fail! "usage: kotobase-private-git-adapter fetch|push <kotoba://host/rid> <cache>"))
  (try
    (remote/install-sha256!)
    (let [keyring (store/load-keys (store/store-path (.-env js/process)))]
      (-> (case operation
            "fetch" (remote/fetch! url cache keyring)
            "push" (remote/push! url cache keyring))
          (.then (fn [_] (.exit js/process 0)))
          (.catch (fn [e] (fail! (or (ex-message e) (str e)))))))
    (catch :default e (fail! (or (ex-message e) (str e))))))
