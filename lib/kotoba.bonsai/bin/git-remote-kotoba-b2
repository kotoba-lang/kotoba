#!/usr/bin/env kbb
(ns git-remote-kotoba-b2 (:require [bonsai.b2-git :as b2] ["node:fs" :as fs] ["node:path" :as path]))
(try (b2/install-hash!)
     (.exit js/process
            (b2/remote-main! (vec *command-line-args*)
                             (path/join (path/dirname (fs/realpathSync *file*)) "kotoba-b2-git-adapter")))
     (catch :default e (fs/writeSync 2 (str "git-remote-kotoba-b2: " (ex-message e) "\n")) (.exit js/process 1)))
