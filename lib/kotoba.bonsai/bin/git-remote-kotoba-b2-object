#!/usr/bin/env kbb
(ns git-remote-kotoba-b2-object (:require [bonsai.b2-git :as b2] ["node:fs" :as fs]))
(try (b2/install-hash!)
     (.exit js/process (b2/object-main! (vec *command-line-args*)))
     (catch :default e (fs/writeSync 2 (str "git-remote-kotoba-b2-object: " (ex-message e) "\n")) (.exit js/process 1)))
