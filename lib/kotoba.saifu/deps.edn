;; saifu — Cosmos/EVM wallet. 権限は popup ではなく値（ADR-2608039900）。
;;
;; address と policy は依存ゼロの純粋関数のまま（資金も鍵も無しに正しさを
;; 証明できる範囲を、依存の無さで示す）。tx / sign が持ち込む依存は 2 つだけ:
;;   dev-protobuf — SIGN_MODE_DIRECT の wire format（機構、schema は saifu.tx が
;;                  data で持つ）
;;   wallet       — signer seam（ADR-2608241100。鍵は seam の向こう側 = 本番は
;;                  kagi の vault から出ない。btc/eth-crypto は wallet 自身の
;;                  pin 経由で、crypto 機構の version truth を 1 本化）
{:paths ["src" "resources"]
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/dev-protobuf {:local/root "../kotoba.devProtobuf"}
        io.github.kotoba-lang/wallet {:local/root "../kotoba.wallet"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
