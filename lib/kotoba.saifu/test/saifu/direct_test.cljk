(ns saifu.direct-test
  "VERIFICATION GATE for saifu.tx / saifu.sign: a SIGN_MODE_DIRECT vector
  generated by cosmjs (the reference implementation — see cosmjs_oracle.cljs
  for regeneration), reproduced byte-for-byte: body, auth-info, sign-doc,
  sha256 digest, the 64-byte signature (which also cross-validates that the
  wallet signer seam's RFC-6979 secp256k1 reproduces @cosmjs/crypto's exact
  deterministic signature), the compressed pubkey at m/44'/118'/0'/0/0
  (cross-validating bip32 against cosmjs' Slip10), and the akash address
  (exercising saifu.address against a real derivation, not just the stored
  mainnet pairs)."
  (:require [kotoba.test :refer [deftest is]]
            [btc-crypto.bip32 :as bip32]
            [btc-crypto.bip39 :as bip39]
            [btc-crypto.core :as btc]
            [protobuf.wire :as pb]
            [saifu.address :as address]
            [saifu.sign :as sign]
            [saifu.tx :as tx]
            [wallet.signer :as wsigner]))

;; ── the cosmjs-generated vector (test/saifu/cosmjs_oracle.cljk) ──────────

(def ^:private vector*
  {:mnemonic "abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"
   :path "m/44'/118'/0'/0/0"
   :address "akash19rl4cm2hmr8afy4kldpxz3fka4jguq0a3mq6x0"
   :to "akash1a6zlyvpnksx8wr6wz8wemur2xe8zyh0ytz6d88"
   :chain-id "akashnet-2"
   :account-number 42
   :sequence 7
   :pubkey33 "024f4e2ad99c34d60b9ba6283c9431a8418af8673212961f97a77b6377fcd05b62"
   :body "0a8c010a1c2f636f736d6f732e62616e6b2e763162657461312e4d736753656e64126c0a2c616b6173683139726c34636d32686d7238616679346b6c6470787a33666b61346a6775713061336d71367830122c616b6173683161367a6c7976706e6b737838777236777a3877656d7572327865387a79683079747a366438381a0e0a0475616b741206353030303030"
   :auth-info "0a500a460a1f2f636f736d6f732e63727970746f2e736563703235366b312e5075624b657912230a21024f4e2ad99c34d60b9ba6283c9431a8418af8673212961f97a77b6377fcd05b6212040a020801180712120a0c0a0475616b7412043530303010c09a0c"
   :sign-doc ""
   :digest "7ff28752ed2c4c2c2f593768eb95f9909f9cde74647bb560359a22f1d3a3d540"
   :signature64 "eaeed328df2ed859af0dfcd5ea7cf8578afdfce881a2740dadae24909037dfda09845fd18ec43007b576a78a8ffff5b4eaaff2d1e24e1b58a382e642ad12e7b6"})

(defn- hex [bs]
  (apply str (map #(format "%02x" (bit-and (long %) 0xff)) (seq bs))))

(def ^:private sgnr
  (wsigner/seed-signer
   (bip32/seed->master (bip39/mnemonic->seed (:mnemonic vector*)))))

(def ^:private pubkey33 (sign/pubkey33 sgnr (:path vector*)))

(defn- doc []
  (let [body (tx/body-bytes
              {:messages [(tx/msg-send-any (:address vector*) (:to vector*)
                                           [{:denom "uakt" :amount "500000"}])]})
        auth-info (tx/auth-info-bytes
                   {:pubkey33 pubkey33
                    :sequence (:sequence vector*)
                    :fee {:amount [{:denom "uakt" :amount "5000"}]
                          :gas-limit 200000}})]
    {:body body :auth-info auth-info
     :chain-id (:chain-id vector*)
     :account-number (:account-number vector*)}))

(deftest pubkey-and-address-match-cosmjs-derivation
  (is (= (:pubkey33 vector*) (hex pubkey33)))
  (is (= (:address vector*)
         (address/from-hash160 "akash"
                               ;; saifu.address is pure and takes 0..255 ints —
                               ;; JVM byte-arrays carry signed bytes, so mask
                               (mapv #(bit-and (long %) 0xff)
                                     (btc/hash160 pubkey33))))))

(deftest canonical-bytes-match-cosmjs
  (let [{:keys [body auth-info] :as d} (doc)]
    (is (= (:body vector*) (hex body)))
    (is (= (:auth-info vector*) (hex auth-info)))
    (is (= (:sign-doc vector*) (hex (tx/sign-doc-bytes d))))
    (is (= (:digest vector*) (hex (sign/sha256 (tx/sign-doc-bytes d)))))))

(deftest signature-matches-cosmjs-rfc6979
  (let [commit-policy {:chains #{:akash} :msg-types #{:MsgSend}
                       :recipients #{(:to vector*)}
                       :max-spend {:uakt 1000000} :max-per-tx {:uakt 600000}
                       :expires-at 9999999999999 :disposition :commit}
        request {:chain :akash :msg-type :MsgSend
                 :recipient (:to vector*) :amount {:uakt 500000}}
        {:keys [signed refused]} (sign/sign! sgnr (:path vector*)
                                             {:policy commit-policy :request request
                                              :spent {} :now 1756000000000}
                                             (doc))]
    (is (nil? refused))
    (is (= (:signature64 vector*) (hex (:signature signed))))
    (is (= (:sign-doc vector*) (hex (:sign-doc signed))))
    ;; TxRaw carries the same body/auth-info and exactly this signature
    (is (.contains ^String (hex (:tx-raw signed)) (:signature64 vector*)))))

(deftest sign!-refuses-below-commit-with-the-gate-reason
  (let [d (doc)
        base {:policy {:chains #{:akash} :msg-types #{:MsgSend} :recipients :any
                       :max-spend {:uakt 1000000} :max-per-tx {:uakt 600000}
                       :disposition :escalate}
              :request {:chain :akash :msg-type :MsgSend :amount {:uakt 500000}}
              :spent {} :now 1756000000000}]
    ;; escalate は例外ではなくデータ — 人間承認待ちは正常な状態
    (is (= :escalate (get-in (sign/sign! sgnr (:path vector*) base d)
                             [:refused :disposition])))
    ;; no policy at all → hold, with the gate's reason preserved
    (let [r (sign/sign! sgnr (:path vector*) (assoc base :policy nil) d)]
      (is (= :hold (get-in r [:refused :disposition])))
      (is (= :no-policy (get-in r [:refused :reason]))))
    ;; over the per-tx cap → the gate's own reason comes through untouched
    (let [r (sign/sign! sgnr (:path vector*)
                        (assoc-in base [:policy :max-per-tx :uakt] 400000) d)]
      (is (= :over-per-tx (get-in r [:refused :reason]))))))

(deftest proto3-defaults-are-omitted-not-zero-encoded
  ;; sequence 0 must NOT appear on the wire — writing varint 0 would produce
  ;; bytes cosmjs never signs, and the two implementations would diverge on
  ;; exactly the account state (a fresh account) most likely to be missed.
  (let [auth-info (tx/auth-info-bytes
                   {:pubkey33 pubkey33 :sequence 0
                    :fee {:amount [{:denom "uakt" :amount "5000"}]
                          :gas-limit 200000}})
        decoded (pb/decode tx/AuthInfo auth-info)]
    (is (nil? (:sequence (first (:signer-infos decoded)))))))
