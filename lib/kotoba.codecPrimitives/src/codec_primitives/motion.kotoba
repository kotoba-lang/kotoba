(ns codec-primitives.motion
  ;; Kotoba port of `codec-primitives.motion`'s MotionVector schema and
  ;; `valid-mv?` predicate. The original used malli to check the shape of a
  ;; plain Clojure map; here the shape is the parameter type itself, so the
  ;; language's typed value admission at the boundary plays the role malli
  ;; played: a motion vector that does not have an i64 picture order count,
  ;; an i64 reference index, a 2-tuple of i64 deltas, and a keyword reference
  ;; frame cannot be admitted as a `motion-vector` value at all.
  ;;
  ;; `:mv` is the malli `[:tuple :int :int]` expressed as a heterogeneous
  ;; vector of two i64s -- Kotoba has no separate tuple type; `[:vector
  ;; [T ...]]` with a fixed item-type list is its fixed-arity tuple.
  (:export [valid-mv?]))

(def motion-vector-type
  [:record :codec-primitives/motion-vector
   [[:poc :i64]                    ;; picture order count
    [:ref-idx :i64]
    [:mv [:vector [:i64 :i64]]]    ;; [dx dy] クォーターペル単位
    [:ref-frame :keyword]]])       ;; フレームを指すID(実体はVault blob CID等、codec側が解決)

(defn valid-mv? [x [:alias motion-vector-type]] :bool
  ;; Admission is the validation: a value typed `motion-vector` already
  ;; satisfies every clause the malli schema checked.
  true)
