{:source-paths ["src" "test"]
 :builds {:intake-worker {:target :esm :output-dir "build/intake"
                          :modules {:worker {:exports {default ekyc.identity-worker/default}}}
                          :compiler-options {:output-feature-set :es2020 :infer-externs :auto}}
          :identity-test {:target :node-test :output-to "build/identity-tests.cjs"
                          :ns-regexp "ekyc.identity.*-test$" :autorun true
                          :compiler-options {:output-feature-set :es2020 :infer-externs :auto}}
          :identity {:target :esm :output-dir "build/identity"
                     :modules {:identity {:exports {verifyPassport ekyc.passport/verify-js}}}
                     :compiler-options {:output-feature-set :es2020 :infer-externs :auto}}}}
