(ns ekyc.identity-trust
  "Versioned, provisional assurance points, never identity probabilities.
  Evidence is created only by the private reviewed state machine. Client scores
  and client-selected weights are never inputs to admission.")

(def version "kotoba-trust-routes-2026-09-v1")
(def weights {:web-reviewed 60 :app-passport 80})
(def threshold 60)
(def ceiling 100)
(defn text? [x] (and (string? x) (<= 1 (count x) 512)))
(defn valid? [record route evidence now]
  (and (contains? weights route) (= route (:route evidence))
       (= version (:policy evidence)) (= :verified (:status evidence))
       (= (:principal record) (:principal evidence))
       (= (:holder-key-id record) (:holder-key-id evidence))
       (text? (:principal record)) (text? (:holder-key-id record))
       (text? (:source-application-id evidence)) (text? (:evidence-ref evidence))
       (number? (:issued-at evidence)) (number? (:expires-at evidence))
       (<= 0 (:issued-at evidence) now) (< now (:expires-at evidence))))

(defn summary [record now]
  (let [active (filter #(valid? record % (get-in record [:trust-routes %]) now) (keys weights))
        points (reduce + 0 (map weights active))]
    {:policy version :score (min ceiling points) :threshold threshold
     :sufficient (>= points threshold)
     :routes (vec (sort (map name active)))}))

(defn evidence [record route reference issued expires]
  {:route route :policy version :status :verified
   :principal (:principal record) :holder-key-id (:holder-key-id record)
   :source-application-id (:id record) :evidence-ref reference
   :issued-at issued :expires-at expires})

(defn projection
  "Minimal private-authority wire result. TTL ends before any contributing route
  or the identity expires. Recompute after expiry; do not persist this as truth."
  [record now]
  (let [result (summary record now)
        active (filter #(valid? record % (get-in record [:trust-routes %]) now) (keys weights))
        expiry (if (and (seq active) (= :approved (:status record)) (number? (:expires-at record)))
                 (apply min (+ now 60000) (:expires-at record) (map #(get-in record [:trust-routes % :expires-at]) active)) now)]
    {:policyVersion version :score (:score result) :routes (:routes result)
     :evaluatedAt now :expiresAt expiry}))

(defn invalidate-origin
  "Revoking source evidence also invalidates all linked copies. Other independent
  route evidence remains intact. Whole-application revocation stays a hard gate."
  [state source-id route]
  (update state :applications
          (fn [applications]
            (into {} (map (fn [[id record]]
                            [id (update record :trust-routes
                                        (fn [routes]
                                          (into {} (map (fn [[kind evidence]]
                                                          [kind (if (and (= source-id (:source-application-id evidence))
                                                                         (or (nil? route) (= route kind)))
                                                                  (assoc evidence :status :revoked) evidence)]) routes))))])
                          applications)))))

(defn withdraw-unsupported-credentials [state now]
  (reduce (fn [current [id record]]
            (if (and (= :active (get-in current [:credentials id :status]))
                     (not (:sufficient (summary record now))))
              (assoc-in current [:credentials id :status] :revoked) current))
          state (:applications state)))
