(ns ekyc.identity-worker
  "Private deployment entry. No public routes or implicit storage fallback.
  The deployment may be connected before providers are qualified; only status
  is served until all private ports and the approved operator policy are ready."
  (:require [ekyc.identity-intake :as intake]
            [ekyc.researcher-profile :as profile]
            [ekyc.identity-intake-service :as service]))

(defn missing [env]
  (cond-> []
    (nil? (aget env "IDENTITY_STORAGE")) (conj "private-storage")
    (nil? (aget env "IDENTITY_KEYS")) (conj "key-management")
    (nil? (aget env "IDENTITY_REVIEW_POLICY")) (conj "reviewer-and-notice-policy")))

(defn fetch! [request env]
  (let [url (js/URL. (.-url request))
        principal (.get (.-headers request) "x-kotoba-principal")
        requirements (missing env)]
    (cond
      (not (and (= "https://identity.internal" (.-origin url))
                (= "POST" (.-method request)) (intake/text? principal)))
      (js/Promise.resolve (service/json-response {:error "private-binding-required"} 403))

      (= "/status" (.-pathname url))
      (js/Promise.resolve
        (service/json-response
          {:policyVersion intake/version :profilePolicyVersion profile/version
           :principalId principal :intakeEnabled false :cases [] :reviewer false :queue []
           :connection {:authority "connected" :storage "unavailable" :keys "unavailable"
                        :review "unavailable" :missing requirements
                        :status "provider-qualification-required"}} 200))

      :else
      (js/Promise.resolve
        (service/json-response {:error "private-providers-not-qualified"} 503)))))

(def default #js {:fetch fetch!})
