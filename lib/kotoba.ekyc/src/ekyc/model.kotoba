;; Port of ekyc.model (model.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from model.cljk:
;;   - checks and statuses are sets in the source. They are zero-arg functions
;;     returning the members as a :document vector of keywords, in the source's
;;     listed order (cross-module constants are not exportable in amu).
;;   - :ekyc/required-checks is (set ...) in the source. Here it is kept as a
;;     :document vector in the given order; an absent or nil value is the empty
;;     vector, as (set nil) is the empty set. No de-duplication is done.
;;   - :ekyc/status defaults to :created only when the key is absent from opts
;;     (as clojure get does); a present nil stays nil.
;;   - a non-map opts or session reads every field as document-null.

(ns ekyc.model
  (:export [checks statuses session evidence]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- null-doc? [d :document] :bool
  (string=? (document-edn-print d) (document-edn-print (document-null))))

(defn checks [] :document
  (document-vector (document-keyword :document-authenticity)
                   (document-keyword :document-ocr)
                   (document-keyword :liveness)
                   (document-keyword :face-match)
                   (document-keyword :address)
                   (document-keyword :pep)
                   (document-keyword :sanctions)
                   (document-keyword :adverse-media)
                   (document-keyword :manual-review)))

(defn statuses [] :document
  (document-vector (document-keyword :created)
                   (document-keyword :submitted)
                   (document-keyword :verified)
                   (document-keyword :rejected)
                   (document-keyword :expired)
                   (document-keyword :review)))

(defn- required-checks-of [opts :document] :document
  (let [rc (field opts :required-checks)]
    (if (null-doc? rc) (document-vector) rc)))

(defn- status-of [opts :document] :document
  (if (map? opts)
    (if (document-contains opts :status)
      (field opts :status)
      (document-keyword :created))
    (document-keyword :created)))

(defn session [id :document subject :document opts :document] :document
  (document-map :ekyc/id id
                :ekyc/subject subject
                :ekyc/status (status-of opts)
                :ekyc/provider (field opts :provider)
                :ekyc/purpose (field opts :purpose)
                :ekyc/session-ref (field opts :session-ref)
                :ekyc/required-checks (required-checks-of opts)
                :ekyc/created-at (field opts :created-at)
                :ekyc/expires-at (field opts :expires-at)))

(defn evidence [session :document check :document status :document opts :document] :document
  (document-map :ekyc/id (field session :ekyc/id)
                :ekyc/check check
                :ekyc/status status
                :ekyc/provider (field session :ekyc/provider)
                :ekyc/evidence-ref (field opts :evidence-ref)
                :ekyc/source (field opts :source)
                :ekyc/confidence (field opts :confidence)
                :ekyc/observed-at (field opts :observed-at)
                :ekyc/non-adjudicating (document-bool true)))
