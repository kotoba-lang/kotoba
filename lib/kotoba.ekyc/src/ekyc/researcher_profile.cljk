(ns ekyc.researcher-profile
  "Private, holder-signed affiliation and qualification declarations. These never
  authenticate a session or grant research scope. Verification needs signed review.")

(def version "kotoba-researcher-profile-2026-09-v1")
(def max-qualifications 5)
(defn text? [x n] (and (string? x) (<= 1 (count x) n) (boolean (re-find #"\S" x))))
(defn fields? [x ks] (and (map? x) (= (set (keys x)) (set ks))))
(defn affiliation? [x]
  (or (and (fields? x [:kind]) (= "independent" (:kind x)))
      (and (fields? x [:kind :name :role :evidence]) (= "organization" (:kind x))
           (text? (:name x) 160) (text? (:role x) 160) (text? (:evidence x) 512))))
(defn qualification? [q]
  (and (fields? q [:id :name :issuer :reference :evidence :no-expiry :expires-at])
       (contains? #{"q1" "q2" "q3" "q4" "q5"} (:id q))
       (text? (:name q) 160) (text? (:issuer q) 160)
       (text? (:reference q) 160) (text? (:evidence q) 512)
       (or (and (true? (:no-expiry q)) (nil? (:expires-at q)))
           (and (false? (:no-expiry q)) (integer? (:expires-at q)) (pos? (:expires-at q))))))
(defn valid? [profile]
  (and (fields? profile [:version :affiliation :qualification-status :qualifications])
       (= version (:version profile)) (affiliation? (:affiliation profile))
       (vector? (:qualifications profile))
       (case (:qualification-status profile)
         "none" (empty? (:qualifications profile))
         "declared" (let [qs (:qualifications profile)]
                      (and (<= 1 (count qs) max-qualifications)
                           (= (count qs) (count (set (map :id qs))))
                           (every? qualification? qs)))
         false)))

(defn verification? [v now]
  (and (= "verified" (:status v)) (true? (:holder-match v))
       (text? (:evidence-ref v) 512) (text? (:source v) 512)
       (integer? (:checked-at v)) (<= 0 (:checked-at v) now)
       (integer? (:expires-at v)) (< now (:expires-at v) (+ now 31536000001))))
(defn reviewed? [profile review now]
  (and (valid? profile) (map? review) (= version (:version review))
       (vector? (:qualifications review))
       (if (= "independent" (get-in profile [:affiliation :kind]))
         (= "declared-none" (get-in review [:affiliation :status]))
         (verification? (:affiliation review) now))
       (= (set (map :id (:qualifications profile)))
          (set (map :id (:qualifications review))))
       (= (count (:qualifications profile)) (count (:qualifications review)))
       (every? (fn [q]
                 (let [v (first (filter #(= (:id q) (:id %)) (:qualifications review)))]
                   (and (verification? v now)
                        (or (:no-expiry q) (<= (:expires-at v) (:expires-at q))))))
               (:qualifications profile))))

(defn summary [profile review now]
  (let [status (fn [v] (cond
                        (= "revoked" (:status v)) "revoked"
                        (= "declared-none" (:status v)) "declared-none"
                        (and (= "verified" (:status v)) (number? (:expires-at v))
                             (<= (:expires-at v) now)) "expired"
                        (verification? v now) "verified"
                        :else "pending"))]
    {:version version
     :affiliation (if (= "independent" (get-in profile [:affiliation :kind]))
                    "declared-none" (status (:affiliation review)))
     :qualifications (mapv (fn [q]
                            {:id (:id q) :status
                             (if (and (number? (:expires-at q)) (<= (:expires-at q) now))
                               "expired"
                               (status (first (filter #(= (:id q) (:id %)) (:qualifications review)))))})
                          (:qualifications profile))
     :qualificationStatus (if (= "none" (:qualification-status profile)) "declared-none" "declared")}))
