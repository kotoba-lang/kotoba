(ns ekyc.identity-key-service
  "Case-bound KMS adapter. Keys are non-extractable AES-GCM 256-bit WebCrypto keys.
  Key material can be held by DO storage or in-memory, and destruction is
  cryptographically irrevocable per case id.
  Never exports raw key bytes or substitutes classical secrets."
  (:require [ekyc.passport :as p]
            [ekyc.identity-intake :as intake]))

(defn generate-case-key []
  (.generateKey (.-subtle js/crypto)
                #js {:name "AES-GCM" :length 256}
                false
                #js ["encrypt" "decrypt"]))

(defn make-in-memory-key-provider
  "In-memory key provider with strict case isolation and verified destruction.
  Satisfies :create-key!, :key!, and :destroy-key! port requirements."
  ([] (make-in-memory-key-provider (atom {})))
  ([store]
   {:create-key!
    (fn [case-id]
      (p/require! (intake/text? case-id) :invalid-case-id)
      (-> (generate-case-key)
          (.then (fn [key]
                   (let [key-ref (str "kms:case:" case-id)]
                     (swap! store assoc case-id {:key key :ref key-ref :status :active})
                     key-ref)))))

    :key!
    (fn [key-ref case-id]
      (let [entry (get @store case-id)]
        (if (and entry (= :active (:status entry)) (= key-ref (:ref entry)))
          (js/Promise.resolve (:key entry))
          (js/Promise.reject (ex-info "key-unavailable-or-destroyed" {:status 404})))))

    :destroy-key!
    (fn [key-ref case-id]
      (let [entry (get @store case-id)]
        (if (and entry (= key-ref (:ref entry)))
          (do
            ;; Cryptographic erasure: drop reference and mark tombstone
            (swap! store assoc case-id {:status :destroyed :destroyed-at (js/Date.now)})
            (js/Promise.resolve {:status :destroyed :receipt-ref (str "kms:destroyed:" case-id)}))
          (js/Promise.reject (ex-info "key-not-found-for-destruction" {:status 404})))))}))
