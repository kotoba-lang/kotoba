;; Port of ekyc.datom (datom.cljk), Kotoba-native, :document maps.
;;
;; Each emitter returns a :document vector of one flat-namespaced map, as the
;; source returns a vector of one map.
;;
;; Named divergences from datom.cljk:
;;   - A missing key, or a non-map argument, reads as document-null (nil in
;;     the source).
;;   - evidence-datoms :db/id is (str id ":" (name check)). str of nil is "";
;;     name of a keyword is its name; a string is itself. A missing check
;;     reads as "" here, where the source's (name nil) throws.

(ns ekyc.datom
  (:export [session-datoms evidence-datoms decision-datoms]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- null-doc? [d :document] :bool
  (document-equal? d (document-null)))

(defn- str-of [v :document] :string
  (if (null-doc? v)
    ""
    (option-or (document-string-value v) (document-edn-print v))))

(defn- name-of [v :document] :string
  (if (option-some?-of [:option :keyword] (document-keyword-value v))
    (keyword-name (option-value-of [:option :keyword] (document-keyword-value v) :none))
    (str-of v)))

(defn session-datoms [s :document] :document
  (document-vector
   (document-map :db/id (field s :ekyc/id)
                 :ekyc/subject (field s :ekyc/subject)
                 :ekyc/status (field s :ekyc/status)
                 :ekyc/provider (field s :ekyc/provider)
                 :ekyc/purpose (field s :ekyc/purpose)
                 :ekyc/session-ref (field s :ekyc/session-ref)
                 :ekyc/required-checks (field s :ekyc/required-checks)
                 :ekyc/created-at (field s :ekyc/created-at)
                 :ekyc/expires-at (field s :ekyc/expires-at))))

(defn evidence-datoms [e :document] :document
  (document-vector
   (document-map :db/id (document-string (string-concat (string-concat (str-of (field e :ekyc/id)) ":")
                                                        (name-of (field e :ekyc/check))))
                 :ekyc/id (field e :ekyc/id)
                 :ekyc/check (field e :ekyc/check)
                 :ekyc/status (field e :ekyc/status)
                 :ekyc/provider (field e :ekyc/provider)
                 :ekyc/evidence-ref (field e :ekyc/evidence-ref)
                 :ekyc/source (field e :ekyc/source)
                 :ekyc/confidence (field e :ekyc/confidence)
                 :ekyc/observed-at (field e :ekyc/observed-at)
                 :ekyc/non-adjudicating (field e :ekyc/non-adjudicating))))

(defn decision-datoms [d :document] :document
  (document-vector
   (document-map :db/id (field d :ekyc/id)
                 :ekyc/complete? (field d :ekyc/complete?)
                 :ekyc/missing-checks (field d :ekyc/missing-checks)
                 :ekyc/verified-checks (field d :ekyc/verified-checks)
                 :ekyc/status (field d :ekyc/status))))
