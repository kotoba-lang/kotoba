(ns ekyc.adapters.production-provider-core
  ;; Vertical-slice guest (ADR-2608261100): the product semantics of
  ;; src/ekyc/adapters/production_provider.cljk — which endpoint each
  ;; provider operation targets, with which HTTP method, and how payload /
  ;; query options attach — as plain Kotoba values.
  ;;
  ;; The endpoints document carries the three URLs as keyword-keyed
  ;; :string entries (:sessions / :evidence / :result), read out with the
  ;; same option accessors todo-app.kotoba uses. A missing entry traps
  ;; (document-keyword-value has no default here) rather than guessing a
  ;; URL: the .cljc oracle answers nil for a missing endpoint and the
  ;; transport then fails downstream, so a trap is the honest guest read
  ;; of the same contract. The :url :keyword workaround exists because a
  ;; :keyword record field is refused "keyword not a representable field
  ;; type" (measured 2026-09-04, amu a7e469f2, :subset phase) while
  ;; :string is representable — a backend shape gap, not a language
  ;; invariant, and this comment is its removal condition.
  ;;
  ;; Host-mechanism residue deliberately NOT ported: `reify` (a JVM/JS
  ;; object adapter — host mechanism per ADR-2607279200 decision 5 row 3)
  ;; and `static-transport`'s call-log `atom` (ambient mutation, denied by
  ;; default per surface-status :no-ambient-mutation). Both stay in the
  ;; .cljc oracle, which remains the meaning-of-record until a human
  ;; retires it. The guest exposes the pure request-assembly core the
  ;; adapter wraps; the caller performs the request.
  (:export [assemble-create-session assemble-upload-evidence assemble-retrieve-result
           request-method request-url request-body request-query])
  (:schemas {:ekyc.adapters.production-provider-core/request
             [:record :ekyc.adapters.production-provider-core/request
              [[:method :keyword] [:url :string]
               [:body :document] [:query :document]]]}))

;; --- one pure request assembler, one per provider operation ---------------

(defn assemble-create-session
  [endpoints :document payload :document]
  [:record :ekyc.adapters.production-provider-core/request
   [[:method :keyword] [:url :string] [:body :document] [:query :document]]]
  (record
    [:record :ekyc.adapters.production-provider-core/request
     [[:method :keyword] [:url :string] [:body :document] [:query :document]]]
    :post
    (option-value-of [:option :string]
     (document-string-value
      (option-or (document-get endpoints (document-keyword :sessions))
                 (document-null)))
     "")
    payload
    (document-map)))

(defn assemble-upload-evidence
  [endpoints :document payload :document]
  [:record :ekyc.adapters.production-provider-core/request
   [[:method :keyword] [:url :string] [:body :document] [:query :document]]]
  (record
    [:record :ekyc.adapters.production-provider-core/request
     [[:method :keyword] [:url :string] [:body :document] [:query :document]]]
    :post
    (option-value-of [:option :string]
     (document-string-value
      (option-or (document-get endpoints (document-keyword :evidence))
                 (document-null)))
     "")
    payload
    (document-map)))

(defn assemble-retrieve-result
  [endpoints :document query :document]
  [:record :ekyc.adapters.production-provider-core/request
   [[:method :keyword] [:url :string] [:body :document] [:query :document]]]
  (record
    [:record :ekyc.adapters.production-provider-core/request
     [[:method :keyword] [:url :string] [:body :document] [:query :document]]]
    :get
    (option-value-of [:option :string]
     (document-string-value
      (option-or (document-get endpoints (document-keyword :result))
                 (document-null)))
     "")
    (document-map)
    query))

;; --- accessors ------------------------------------------------------------

(defn request-method
  [r [:record :ekyc.adapters.production-provider-core/request
      [[:method :keyword] [:url :string] [:body :document] [:query :document]]]] :keyword
  (record-get
    [:record :ekyc.adapters.production-provider-core/request
     [[:method :keyword] [:url :string] [:body :document] [:query :document]]]
    r :method))

(defn request-url
  [r [:record :ekyc.adapters.production-provider-core/request
      [[:method :keyword] [:url :string] [:body :document] [:query :document]]]] :string
  (record-get
    [:record :ekyc.adapters.production-provider-core/request
     [[:method :keyword] [:url :string] [:body :document] [:query :document]]]
    r :url))

(defn request-body
  [r [:record :ekyc.adapters.production-provider-core/request
      [[:method :keyword] [:url :string] [:body :document] [:query :document]]]] :document
  (record-get
    [:record :ekyc.adapters.production-provider-core/request
     [[:method :keyword] [:url :string] [:body :document] [:query :document]]]
    r :body))

(defn request-query
  [r [:record :ekyc.adapters.production-provider-core/request
      [[:method :keyword] [:url :string] [:body :document] [:query :document]]]] :document
  (record-get
    [:record :ekyc.adapters.production-provider-core/request
     [[:method :keyword] [:url :string] [:body :document] [:query :document]]]
    r :query))
