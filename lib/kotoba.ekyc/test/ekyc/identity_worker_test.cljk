(ns ekyc.identity-worker-test
  (:require [cljs.test :refer-macros [deftest is async]]
            [ekyc.identity-worker :as worker]))

(deftest unqualified-deployment-never-accepts-evidence
  (async done
    (let [request (fn [path principal]
                    (js/Request. (str "https://identity.internal/" path)
                      #js {:method "POST" :headers (clj->js {"x-kotoba-principal" principal}) :body "{}"}))]
      (-> (worker/fetch! (request "status" "synthetic-applicant") #js {})
          (.then (fn [response] (is (= 200 (.-status response))) (.json response)))
          (.then (fn [raw]
                   (let [r (js->clj raw :keywordize-keys true)]
                     (is (false? (:intakeEnabled r)))
                     (is (= "synthetic-applicant" (:principalId r)))
                     (is (= ["private-storage" "key-management" "reviewer-and-notice-policy"]
                            (get-in r [:connection :missing]))))
                   (worker/fetch! (request "start" "synthetic-applicant") #js {})))
          (.then (fn [r] (is (= 503 (.-status r)))
                   (worker/fetch! (js/Request. "https://public.example/status") #js {})))
          (.then (fn [r] (is (= 403 (.-status r)))))
          (.catch #(is false (str %))) (.finally done)))))
