(ns ekyc.identity-policy-test
  (:require [cljs.test :refer-macros [deftest is]] [ekyc.identity-policy :as p] [ekyc.identity-session :as session]))
(def now 1789170000000)
(def start {:op :start :id "app" :principal "alice" :audience "https://kotoba.cloud" :nonce "random-challenge"
            :holder-key-id "holder-key" :session-verified true :consent true :policy-version p/version})
(def document {:op :document :id "app" :principal "alice" :nonce "random-challenge" :holder-proof-verified true
               :document {:status :document-authentic :adult true :document-tag "hmac-private-tag" :sod-digest "sod-hash"
                          :dg2-digest "portrait-hash" :trust-version "trust-v1" :document-expires-at (+ now 9999999)}})
(def approval {:op :approve :id "app" :principal "alice" :actor "reviewer" :operator-signature-verified true
               :sod-digest "sod-hash" :dg2-digest "portrait-hash" :holder-method :supervised-live-document-comparison
               :holder-match true :liveness true :review-evidence-ref "private:review-receipt" :expires-at (+ now 9000000)
               :screening {:status :clear :coverage [:sanctions :pep :adverse-media] :evidence-ref "private:screening" :checked-at now :expires-at (+ now 9000000)}
               :scope {:status :approved :id "scope" :issued-at now :expires-at (+ now 9000000)}})
(defn apply! [state event] (:state (p/transition state event now)))
(def initial {:reviewers #{"reviewer"}
              :observers {"fixture" {:status :active :key-id "key" :key-thumbprint "thumb" :kinds #{:authenticated}}}
              :sessions {"session-a" {:id "session-a" :principal "alice" :holder-key-id "holder-key" :status :active
                                      :created-at now :expires-at (+ now 1800000) :alerts {}
                                      :controller {:observer "fixture" :key-id "key" :key-thumbprint "thumb" :kind :authenticated :at now :expires-at (+ now 1800000) :mass 18}}}})
(def reviewed (-> initial (apply! start) (apply! document)))
(def approved (apply! reviewed approval))
(deftest lifecycle-and-revocation
  (is (= :review (get-in reviewed [:applications "app" :status])))
  (is (= :approved (get-in approved [:applications "app" :status])))
  (is (= :active (get-in approved [:credentials "app" :status])))
  (doseq [change [{:actor "alice"} {:operator-signature-verified false} {:holder-match false}
                  {:liveness false} {:dg2-digest "another-image"} {:review-evidence-ref nil}
                  {:screening {:status :pending}}]]
    (is (false? (:ok (p/transition reviewed (merge approval change) now)))))
  (is (false? (:ok (p/transition approved approval now))))
  (is (false? (:ok (p/transition (assoc-in reviewed [:documents "hmac-private-tag"] "bob") approval now))))
  (let [revoked (apply! approved {:op :revoke :id "app" :actor "reviewer" :operator-signature-verified true :reason-ref "private:revocation"})]
    (is (= :revoked (get-in revoked [:credentials "app" :status])))
    (is (= :review-required (p/eligibility (get-in revoked [:applications "app"]) now)))))
(deftest quota-reservation-is-canonical-and-free
  (let [event {:op :reserve :id "app" :principal "alice" :session-verified true :session-id "session-a" :scope-id "scope" :task :code-review :utc-day (quot now 86400000)}
        used (reduce (fn [state i] (apply! state (assoc event :request-id (str "request-" i)))) approved (range 50))]
    (is (= 50 (get-in used [:usage ["alice" (quot now 86400000)]])))
    (is (= :free-quota-exhausted (:reason (p/transition used (assoc event :request-id "request-51") now))))
    (is (= :request-already-reserved (:reason (p/transition used (assoc event :request-id "request-0") now))))
    (is (= :invalid-reservation (:reason (p/transition used (assoc event :request-id "new" :principal "bob") now))))))
