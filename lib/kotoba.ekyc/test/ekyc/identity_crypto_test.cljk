(ns ekyc.identity-crypto-test
  (:require [cljs.test :refer-macros [deftest is async]] [ekyc.identity-crypto :as c]
            [ekyc.identity-policy-test :as fixture] [ekyc.identity-passport-test :refer [rejects]]
            [ekyc.identity-trust :as trust]))
(def issuer "https://identity.kotoba.cloud")
(defn prepare [now]
  (-> (js/Promise.all #js [(.generateKey (.-subtle js/crypto) "Ed25519" true #js ["sign" "verify"])
                          (.generateKey (.-subtle js/crypto) "Ed25519" true #js ["sign" "verify"])])
      (.then (fn [keys]
               (-> (.exportKey (.-subtle js/crypto) "jwk" (.-publicKey (aget keys 1)))
                   (.then (fn [jwk]
                            {:issuer-key (aget keys 0) :holder (aget keys 1) :now now
                             :jwk (select-keys (js->clj jwk :keywordize-keys true) [:kty :crv :x])})))))))
(defn issue-fixture [{:keys [^js issuer-key jwk now] :as context}]
  (-> (c/holder-key-id jwk)
      (.then (fn [key-id]
               (let [record (assoc (get-in fixture/approved [:applications "app"])
                                   :issued-at now :expires-at (+ now 60000) :holder-key-id key-id
                                   :screening {:status :clear :checked-at now :expires-at (+ now 60000)}
                                   :scope {:status :approved :issued-at now :expires-at (+ now 60000)})]
                 (let [record (assoc record :trust-routes {:app-passport (trust/evidence record :app-passport "private:review" now (+ now 60000))})]
                 (-> (c/issue (.-privateKey issuer-key) issuer "issuer-1" "app" record "pairwise-subject" jwk now)
                     (.then #(assoc context :credential % :record record)))))))))
(defn present-fixture [{:keys [^js holder credential now] :as context}]
  (-> (c/present (.-privateKey holder) "holder" credential "https://kotoba.cloud" "server-random-nonce" now)
      (.then #(assoc context :proof %))))
(defn check-fixture [{:keys [^js issuer-key ^js holder credential proof record jwk now]}]
  (let [expected {:audience "https://kotoba.cloud" :nonce "server-random-nonce" :holder-kid "holder"
                  :created-at now :expires-at (+ now 120000) :consumed false}
        active (fn [id] (js/Promise.resolve {:id id :status :active :checked-at now :expires-at (+ now 30000)}))
        check (fn [key challenge status] (c/verify-presentation key issuer "issuer-1" credential proof challenge status now))]
    (-> (check (.-publicKey issuer-key) expected active)
        (.then (fn [claims]
                 (is (= "pairwise-subject" (:sub claims)))
                 (is (not (contains? claims :birth-date)))
                 (js/Promise.all
                  #js [(rejects #(check (.-publicKey issuer-key) (assoc expected :nonce "other") active))
                       (rejects #(check (.-publicKey issuer-key) (assoc expected :consumed true) active))
                       (rejects #(check (.-publicKey issuer-key) expected (fn [id] (js/Promise.resolve {:id id :status :revoked}))))
                       (rejects #(check (.-publicKey holder) expected active))
                       (rejects #(c/issue (.-privateKey issuer-key) issuer "issuer-1" "app" (assoc record :holder-key-id "unbound") "pairwise-subject" jwk now))]))))))
(deftest signed-credential-and-holder-proof
  (async done
    (-> (prepare (js/Date.now)) (.then issue-fixture) (.then present-fixture) (.then check-fixture)
        (.catch #(is false (str "signed credential path failed: " (ex-data %) " " (.-stack %))))
        (.finally done))))
