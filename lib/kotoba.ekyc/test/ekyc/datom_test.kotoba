(ns ekyc.datom-test (:export [main]) (:require [ekyc.datom :as p]))

(defn- ok [b :bool] :i64
  (if b 0 1))

(defn- row [v :document] :document
  (option-or (document-vector-at v 0) (document-null)))

(defn- session-checks [] :i64
  (let [s (document-map :ekyc/id (document-string "S-1") :ekyc/status (document-keyword :open)
                        :ekyc/subject (document-string "sub"))
        v (p/session-datoms s)]
    (+ (ok (= (document-count v) 1))
       (ok (document-equal? (row v)
                            (document-map :db/id (document-string "S-1")
                                          :ekyc/subject (document-string "sub")
                                          :ekyc/status (document-keyword :open)
                                          :ekyc/provider (document-null)
                                          :ekyc/purpose (document-null)
                                          :ekyc/session-ref (document-null)
                                          :ekyc/required-checks (document-null)
                                          :ekyc/created-at (document-null)
                                          :ekyc/expires-at (document-null)))))))

(defn- evidence-checks [] :i64
  (let [e (document-map :ekyc/id (document-string "S-1") :ekyc/check (document-keyword :passport)
                        :ekyc/status (document-keyword :passed))
        v (p/evidence-datoms e)]
    (+ (ok (= (document-count v) 1))
       (ok (document-equal? (row v)
                            (document-map :db/id (document-string "S-1:passport")
                                          :ekyc/id (document-string "S-1")
                                          :ekyc/check (document-keyword :passport)
                                          :ekyc/status (document-keyword :passed)
                                          :ekyc/provider (document-null)
                                          :ekyc/evidence-ref (document-null)
                                          :ekyc/source (document-null)
                                          :ekyc/confidence (document-null)
                                          :ekyc/observed-at (document-null)
                                          :ekyc/non-adjudicating (document-null)))))))

(defn- decision-checks [] :i64
  (let [d (document-map :ekyc/id (document-string "S-1") :ekyc/complete? (document-bool false))
        v (p/decision-datoms d)]
    (ok (document-equal? (row v)
                         (document-map :db/id (document-string "S-1")
                                       :ekyc/complete? (document-bool false)
                                       :ekyc/missing-checks (document-null)
                                       :ekyc/verified-checks (document-null)
                                       :ekyc/status (document-null))))))

(defn main [] :i64
  (+ (session-checks) (+ (evidence-checks) (decision-checks))))
