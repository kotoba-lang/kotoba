(ns ekyc.identity-trust-test
  (:require [cljs.test :refer-macros [deftest is]] [ekyc.identity-trust :as t]
            [ekyc.identity-policy :as p] [ekyc.identity-policy-test :as f]))

(def web-start (assoc f/start :id "web"))
(def web-document {:op :web-document :id "web" :principal "alice" :nonce "random-challenge"
                   :holder-proof-verified true
                   :document {:status :captured-unverified :document-image-digest "image-digest"
                              :live-capture-digest "live-digest" :capture-evidence-ref "private:capture"}})
(def web-approval (merge f/approval
                        {:op :approve-web :id "web" :document-image-digest "image-digest" :live-capture-digest "live-digest"
                         :holder-method :supervised-live-video-document-comparison :document-checked true :adult true
                         :document-tag "hmac-private-tag" :document-expires-at (+ f/now 9999999)}))
(def web-reviewed (-> f/initial (f/apply! web-start) (f/apply! web-document)))
(def web-approved (f/apply! web-reviewed web-approval))
(def both-approved (-> web-approved (f/apply! f/start) (f/apply! f/document) (f/apply! f/approval)))
(def link-command {:op :link-route :id "web" :source-id "app" :principal "alice" :actor "reviewer"
                   :route :app-passport :same-person-verified true :operator-signature-verified true
                   :link-evidence-ref "private:link"})
(defn score [state id at] (:score (t/summary (get-in state [:applications id]) at)))

(deftest web-alone-is-a-reviewed-trust-root
  (is (= 0 (score web-reviewed "web" f/now)))
  (is (= :captured-unverified (get-in web-reviewed [:applications "web" :document :status])))
  (is (= 60 (score web-approved "web" f/now)))
  (is (= {:policyVersion t/version :score 60 :routes ["web-reviewed"] :evaluatedAt f/now :expiresAt (+ f/now 60000)}
         (t/projection (get-in web-approved [:applications "web"]) f/now)))
  (is (nil? (p/eligibility (get-in web-approved [:applications "web"]) f/now)))
  (is (= :free (get-in (p/transition web-approved
                        {:op :reserve :id "web" :principal "alice" :session-verified true :session-id "session-a" :scope-id "scope"
                         :task :code-review :utc-day (quot f/now 86400000) :request-id "first-web-request"}
                        f/now) [:effects 0 :billing])))
  (doseq [change [{:actor "alice"} {:operator-signature-verified false} {:document-checked false}
                  {:adult false} {:liveness false} {:holder-match false} {:document-image-digest "other"}
                  {:live-capture-digest "replayed"} {:screening {:status :pending}}]]
    (is (false? (:ok (p/transition web-reviewed (merge web-approval change) f/now)))))
  (is (false? (:ok (p/transition web-reviewed (assoc f/approval :id "web") f/now))))
  (is (false? (:ok (p/transition f/reviewed (assoc web-approval :id "app") f/now)))))

(deftest independent-route-addition-is-bounded-and-bound
  (let [linked (f/apply! both-approved link-command)]
    (is (= 80 (score both-approved "app" f/now)))
    (is (= 100 (score linked "web" f/now)))
    (is (= (+ f/now 1000) (:expiresAt (t/projection (assoc-in (get-in linked [:applications "web"])
                                                            [:trust-routes :app-passport :expires-at] (+ f/now 1000)) f/now))))
    (is (false? (:ok (p/transition linked link-command f/now))))
    (doseq [change [{:principal "bob"} {:actor "alice"} {:operator-signature-verified false}
                    {:same-person-verified false} {:link-evidence-ref nil} {:route :unknown}]]
      (is (false? (:ok (p/transition both-approved (merge link-command change) f/now)))))
    (is (false? (:ok (p/transition (assoc-in both-approved [:applications "app" :holder-key-id] "other-key") link-command f/now))))
    (is (= 60 (score (assoc-in linked [:applications "web" :trust-routes :app-passport :expires-at] f/now) "web" f/now)))
    (is (= 60 (score (assoc-in linked [:applications "web" :trust-routes :app-passport :principal] "bob") "web" f/now)))
    (is (= 60 (score (assoc-in web-approved [:applications "web" :trust-routes :web-reviewed :weight] 9999) "web" f/now)))
    (is (= :screening-required (p/eligibility (assoc-in (get-in linked [:applications "web"]) [:screening :status] :pending) f/now)))
    (is (= :review-required (p/eligibility (assoc (get-in linked [:applications "web"]) :status :suspended) f/now)))))

(deftest source-revocation-propagates-to-linked-evidence
  (let [linked (f/apply! both-approved link-command)
        revoked (f/apply! linked {:op :revoke-route :id "app" :route :app-passport :actor "reviewer"
                                 :operator-signature-verified true :reason-ref "private:route-revocation"})
        fully-revoked (f/apply! linked {:op :revoke :id "app" :actor "reviewer"
                                       :operator-signature-verified true :reason-ref "private:revocation"})]
    (is (= 0 (score revoked "app" f/now)))
    (is (= :revoked (get-in revoked [:credentials "app" :status])))
    (is (= :active (get-in revoked [:credentials "web" :status])))
    (is (= 60 (score revoked "web" f/now)))
    (is (= 60 (score fully-revoked "web" f/now)))
    (is (= :trust-route-required (p/eligibility (get-in revoked [:applications "app"]) f/now)))
    (is (nil? (p/eligibility (get-in revoked [:applications "web"]) f/now)))
    (is (false? (:ok (p/transition revoked link-command f/now))))
    (is (= :trust-route-required (p/eligibility (dissoc (get-in web-approved [:applications "web"]) :trust-routes) f/now)))))
