(ns ekyc.identity-fixture
  "Synthetic issuer and passport. Never a production trust root or real identity."
  (:refer-clojure :exclude [name])
  (:require ["pkijs" :as pki] ["asn1js" :as asn] [ekyc.passport :as passport]))
(defn encoded [^js x] (.toBER (.toSchema x true) false))
(defn name [s] (pki/RelativeDistinguishedNames. #js {:typesAndValues #js [(pki/AttributeTypeAndValue. #js {:type "2.5.4.3" :value (asn/Utf8String. #js {:value s})})]}))
(defn certificate [keys issuer-name subject-name serial ca? issuer-key now]
  (let [cert (pki/Certificate.) constraints (pki/BasicConstraints. #js {:cA ca?})]
    (set! (.-version cert) 2)
    (set! (.-serialNumber cert) (asn/Integer. #js {:value serial}))
    (set! (.-issuer cert) issuer-name) (set! (.-subject cert) subject-name)
    (set! (.. cert -notBefore -value) (js/Date. (- now 86400000)))
    (set! (.. cert -notAfter -value) (js/Date. (+ now (* 365 86400000))))
    (set! (.-extensions cert) #js [(pki/Extension. #js {:extnID "2.5.29.19" :critical true :extnValue (.toBER (.toSchema constraints) false) :parsedValue constraints})
                                 (pki/Extension. #js {:extnID "2.5.29.15" :critical true :extnValue (.toBER (asn/BitString. #js {:valueHex (.-buffer (js/Uint8Array. #js [(if ca? 6 128)])) :unusedBits (if ca? 1 7)}) false)})])
    (-> (.importKey (.-subjectPublicKeyInfo cert) (.-publicKey keys))
        (.then #(.sign cert issuer-key "SHA-256")) (.then (fn [] cert)))))
(defn td3 [year]
  (let [prefix "P<UTOERIKSSON<<ANNA<MARIA<<<<<<<<<<<<<<<<<<<" ; padded to 44 below
        first (.padEnd prefix 44 "<")
        doc "L898902C<" birth "900101" expiry (str (.slice (str (+ year 5)) -2) "0101") personal "<<<<<<<<<<<<<<"
        a (str doc (passport/checksum doc)) b (str birth (passport/checksum birth))
        c (str expiry (passport/checksum expiry) personal (passport/checksum personal))
        second (str a "UTO" b "F" c (passport/checksum (str a b c)))
        mrz (.encode (js/TextEncoder.) (str first second))]
    (js/Uint8Array. (clj->js (concat [97 91 95 31 88] (array-seq mrz))))))
(defn build
  ([] (build {}))
  ([{:keys [revoked? stale? missing-attrs? wrong-content-type?]}]
   (let [now (js/Date.now) algorithm #js {:name "ECDSA" :namedCurve "P-256"}]
     (-> (js/Promise.all #js [(.generateKey (.-subtle js/crypto) algorithm true #js ["sign" "verify"])
                              (.generateKey (.-subtle js/crypto) algorithm true #js ["sign" "verify"])])
         (.then
          (fn [keys]
            (let [root-key (aget keys 0) signer-key (aget keys 1) root-name (name "SYNTHETIC TEST CSCA") signer-name (name "SYNTHETIC TEST DSC")]
              (-> (js/Promise.all #js [(certificate root-key root-name root-name 1 true (.-privateKey root-key) now)
                                       (certificate signer-key root-name signer-name 2 false (.-privateKey root-key) now)])
                  (.then
                   (fn [certs]
                     (let [root (aget certs 0) ^js signer (aget certs 1) crl (pki/CertificateRevocationList.)
                           dg1 (td3 (.getUTCFullYear (js/Date. now))) dg2 (js/Uint8Array. #js [117 3 1 2 3])]
                       (set! (.-issuer crl) root-name)
                       (set! (.-thisUpdate crl) (pki/Time. #js {:type 0 :value (js/Date. (- now 86400000))}))
                       (set! (.-nextUpdate crl) (pki/Time. #js {:type 0 :value (js/Date. (if stale? (- now 1000) (+ now 86400000)))}))
                       (when revoked? (set! (.-revokedCertificates crl)
                                             #js [(pki/RevokedCertificate. #js {:userCertificate (.-serialNumber signer)
                                                                              :revocationDate (pki/Time. #js {:type 0 :value (js/Date. (- now 1000))})})]))
                       (-> (.sign crl (.-privateKey root-key) "SHA-256")
                           (.then #(js/Promise.all #js [(passport/digest "SHA-256" dg1) (passport/digest "SHA-256" dg2)]))
                           (.then
                            (fn [hashes]
                              (let [content (.toBER (asn/Sequence. #js {:value #js [(asn/Integer. #js {:value 0})
                                                                                  (.toSchema (pki/AlgorithmIdentifier. #js {:algorithmId "2.16.840.1.101.3.4.2.1"}))
                                                                                  (asn/Sequence. #js {:value #js [(asn/Sequence. #js {:value #js [(asn/Integer. #js {:value 1}) (asn/OctetString. #js {:valueHex (aget hashes 0)})]})
                                                                                                                  (asn/Sequence. #js {:value #js [(asn/Integer. #js {:value 2}) (asn/OctetString. #js {:valueHex (aget hashes 1)})]})]})]}) false)
                                    signed (pki/SignedData. #js {:version 3 :certificates #js [signer]
                                                                :encapContentInfo (pki/EncapsulatedContentInfo. #js {:eContentType "2.23.136.1.1.1" :eContent (asn/OctetString. #js {:valueHex content})})
                                                                :signerInfos #js [(pki/SignerInfo. #js {:version 1 :sid (pki/IssuerAndSerialNumber. #js {:issuer (.-issuer signer) :serialNumber (.-serialNumber signer)})})]})]
                                (-> (passport/digest "SHA-256" content)
                                    (.then (fn [hash]
                                             (when-not missing-attrs?
                                               (aset (aget (.-signerInfos signed) 0) "signedAttrs"
                                                     (pki/SignedAndUnsignedAttributes.
                                                      #js {:type 0 :attributes
                                                           #js [(pki/Attribute. #js {:type "1.2.840.113549.1.9.3" :values #js [(asn/ObjectIdentifier. #js {:value (if wrong-content-type? "1.2.840.113549.1.7.1" "2.23.136.1.1.1")})]})
                                                                (pki/Attribute. #js {:type "1.2.840.113549.1.9.4" :values #js [(asn/OctetString. #js {:valueHex hash})]})]})))
                                             (.sign signed (.-privateKey signer-key) 0 "SHA-256")))
                                    (.then (fn [] {:now now :policy {:trusted-cscas [(encoded root)] :crls [(encoded crl)] :trust-version "SYNTHETIC-TEST-ONLY" :trust-expires-at (+ now 86400000)}
                                                    :evidence {:sod (encoded (pki/ContentInfo. #js {:contentType "1.2.840.113549.1.7.2" :content (.toSchema signed true)})) :dg1 dg1 :dg2 dg2}}))))))))))))))))))
