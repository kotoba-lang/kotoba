(ns ekyc.identity-passport-test
  (:require [ekyc.identity-test-reporter]
            [cljs.test :refer-macros [deftest is async]] [ekyc.passport :as passport] [ekyc.identity-fixture :as fixture]))
(defn rejects [operation]
  (-> (js/Promise.resolve) (.then operation) (.then (fn [_] (is false "must reject evidence")))
      (.catch (fn [_] (is true)))))
(deftest cryptographic-passive-authentication
  (async done
    (-> (fixture/build)
        (.then (fn [{:keys [policy evidence now]}]
                 (-> (passport/verify-passport policy evidence now)
                     (.then (fn [result]
                              (is (= :document-authentic (:status result)))
                              (is (= :review-required (:holder-status result)))
                              (is (true? (:adult result)))
                              (js/Promise.all
                               #js [(-> (fixture/build) (.then (fn [other] (rejects #(passport/verify-passport (assoc policy :trusted-cscas (get-in other [:policy :trusted-cscas])) evidence now)))))
                                    (rejects #(passport/verify-passport (assoc policy :trusted-cscas []) evidence now))
                                    (rejects #(passport/verify-passport policy (assoc evidence :dg2 (js/Uint8Array. #js [117 3 9 8 7])) now))
                                    (rejects #(passport/verify-passport (assoc policy :trust-expires-at now) evidence now))
                                    (rejects #(let [s (.slice (passport/bytes (:sod evidence)))] (aset s (dec (.-length s)) (bit-xor 1 (aget s (dec (.-length s))))) (passport/verify-passport policy (assoc evidence :sod s) now)))]))))))
        (.then #(fixture/build {:revoked? true}))
        (.then (fn [{:keys [policy evidence now]}] (rejects #(passport/verify-passport policy evidence now))))
        (.then #(fixture/build {:stale? true}))
        (.then (fn [{:keys [policy evidence now]}] (rejects #(passport/verify-passport policy evidence now))))
        (.then #(fixture/build {:missing-attrs? true}))
        (.then (fn [{:keys [policy evidence now]}] (rejects #(passport/verify-passport policy evidence now))))
        (.then #(fixture/build {:wrong-content-type? true}))
        (.then (fn [{:keys [policy evidence now]}] (rejects #(passport/verify-passport policy evidence now))))
        (.catch #(is false (str "positive cryptographic path failed: " (.-stack %))))
        (.finally done))))
(deftest strict-mrz
  (let [now (js/Date.now) year (.getUTCFullYear (js/Date. now)) dg (fixture/td3 year)]
    (is (true? (:adult (passport/parse-td3 dg now))))
    (is (thrown? js/Error (passport/parse-td3 (.slice dg 1) now)))
    (aset dg 50 90)
    (is (thrown? js/Error (passport/parse-td3 dg now)))))
