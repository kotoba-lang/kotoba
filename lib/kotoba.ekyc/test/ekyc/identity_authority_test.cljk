(ns ekyc.identity-authority-test
  (:require [cljs.test :refer-macros [deftest is async]] [ekyc.identity-authority :as a]
            [ekyc.identity-policy-test :as fixture] [ekyc.identity-trust-test :as web-fixture]
            [ekyc.identity-crypto :as crypto] [ekyc.identity-passport-test :refer [rejects]]))
(deftest effects-require-durable-commit
  (async done
    (let [read! #(js/Promise.resolve {:revision 7 :state fixture/reviewed})]
      (-> (a/execute read! (fn [revision state]
                            (is (= 7 revision)) (is (= :approved (get-in state [:applications "app" :status])))
                            (js/Promise.resolve {:status :committed :revision 8 :receipt-ref "private:kotobase-commit"}))
                     fixture/approval fixture/now)
          (.then (fn [result]
                   (is (= :issue-credential (get-in result [:effects 0 :type])))
                   (js/Promise.all
                    #js [(rejects #(a/execute read! (fn [_ _] (js/Promise.resolve {:status :committed :revision 7 :receipt-ref "wrong"})) fixture/approval fixture/now))
                         (rejects #(a/execute read! (fn [_ _] (js/Promise.resolve {:status :conflict})) fixture/approval fixture/now))
                         (rejects #(a/execute read! (fn [_ _] (js/Promise.reject (js/Error. "storage unavailable"))) fixture/approval fixture/now))])))
          (.catch #(is false (str %))) (.finally done)))))

(deftest review-requires-registered-signature
  (async done
    (-> (.generateKey (.-subtle js/crypto) "Ed25519" true #js ["sign" "verify"])
        (.then
         (fn [keys]
           (let [command (assoc fixture/approval :aud "https://kotoba.cloud" :nonce "review-challenge"
                                :iat (crypto/seconds fixture/now) :exp (+ (crypto/seconds fixture/now) 120))
                 read! #(js/Promise.resolve {:revision 1 :state fixture/reviewed})
                 cas! (fn [_ state]
                        (is (= :approved (get-in state [:applications "app" :status])))
                        (js/Promise.resolve {:status :committed :revision 2 :receipt-ref "private:review-commit"}))]
             (-> (crypto/sign (.-privateKey keys) "reviewer-key" "kotoba-review+jwt" command)
                 (.then (fn [token]
                          (-> (a/review (.-publicKey keys) "reviewer-key" "reviewer" token "app" "review-challenge" fixture/now read! cas!)
                              (.then (fn [result]
                                       (is (true? (:ok result)))
                                       (rejects #(a/review (.-publicKey keys) "reviewer-key" "reviewer" token "app" "different-challenge" fixture/now read! cas!)))))))))))
        (.catch #(is false (str %))) (.finally done))))

(deftest signed-web-review-and-app-link-use-closed-wire-enums
  (async done
    (-> (.generateKey (.-subtle js/crypto) "Ed25519" true #js ["sign" "verify"])
        (.then
         (fn [keys]
           (js/Promise.all
            (clj->js
             (map (fn [[command state expected-score]]
                    (let [command (assoc command :aud "https://kotoba.cloud" :nonce "review-nonce"
                                         :iat (crypto/seconds fixture/now) :exp (+ (crypto/seconds fixture/now) 120))]
                      (-> (crypto/sign (.-privateKey keys) "reviewer-key" "kotoba-review+jwt" command)
                          (.then (fn [token]
                                   (a/review (.-publicKey keys) "reviewer-key" "reviewer" token "web" "review-nonce" fixture/now
                                             #(js/Promise.resolve {:revision 1 :state state})
                                             (fn [_ committed]
                                               (is (= expected-score (web-fixture/score committed "web" fixture/now)))
                                               (js/Promise.resolve {:status :committed :revision 2 :receipt-ref "private:web-commit"}))))))))
                  [[web-fixture/web-approval web-fixture/web-reviewed 60]
                   [web-fixture/link-command web-fixture/both-approved 100]])))))
        (.catch #(is false (str %))) (.finally done))))
