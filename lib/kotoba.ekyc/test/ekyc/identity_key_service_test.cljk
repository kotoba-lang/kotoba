(ns ekyc.identity-key-service-test
  (:require [cljs.test :refer-macros [deftest is async]]
            [ekyc.identity-key-service :as kms]))

(deftest test-key-service-lifecycle
  (async done
    (let [provider (kms/make-in-memory-key-provider)
          case-id "case-1234-abcd"
          create-fn (:create-key! provider)
          key-fn (:key! provider)
          destroy-fn (:destroy-key! provider)]
      (-> (create-fn case-id)
          (.then (fn [key-ref]
                   (is (= "kms:case:case-1234-abcd" key-ref))
                   (key-fn key-ref case-id)))
          (.then (fn [key]
                   (is (= "secret" (.-type key)))
                   (is (false? (.-extractable key)))
                   (is (= "AES-GCM" (.-name (.-algorithm key))))
                   (is (= 256 (.-length (.-algorithm key))))
                   (destroy-fn "kms:case:case-1234-abcd" case-id)))
          (.then (fn [receipt]
                   (is (= :destroyed (:status receipt)))
                   (is (= "kms:destroyed:case-1234-abcd" (:receipt-ref receipt)))
                   (key-fn "kms:case:case-1234-abcd" case-id)))
          (.then (fn [_] (is false "Expected key retrieval to fail after destruction"))
                 (fn [err] (is (some? err))))
          (.catch (fn [e] (is false (str "Unexpected error: " e))))
          (.finally done)))))
