(ns ekyc.identity-profile-test
  (:require [cljs.test :refer-macros [deftest is]]
            [ekyc.researcher-profile :as p]
            [ekyc.identity-intake :as intake]
            [ekyc.identity-intake-test :as fixture]))
(def now fixture/now)
(def qualification {:id "q1" :name "Example certification" :issuer "Example institute"
                    :reference "SYNTHETIC-001" :evidence "Issuer register / SYNTHETIC-001"
                    :no-expiry false :expires-at (+ now 86400000)})
(def profile {:version p/version
              :affiliation {:kind "organization" :name "Example research lab" :role "Researcher"
                            :evidence "Official staff directory / synthetic researcher"}
              :qualification-status "declared" :qualifications [qualification]})
(def verified {:status "verified" :holder-match true :source "Official issuer register"
               :evidence-ref "private:synthetic-review" :checked-at now :expires-at (+ now 3600000)})
(def review {:version p/version :affiliation verified :qualifications [(assoc verified :id "q1")]})

(deftest declarations-are-bounded-and-cannot-self-verify
  (is (p/valid? profile))
  (is (p/valid? fixture/profile-none))
  (doseq [bad [(dissoc profile :affiliation)
               (assoc-in profile [:affiliation :name] "   ")
               (assoc-in profile [:affiliation :status] "verified")
               (assoc-in profile [:qualifications 0 :name] (apply str (repeat 161 "x")))
               (assoc-in profile [:qualifications 0 :no-expiry] true)
               (assoc-in profile [:qualifications 0 :expires-at] nil)
               (assoc profile :qualification-status "none")
               (assoc profile :qualifications [qualification qualification])
               (assoc profile :qualifications (vec (repeat 6 qualification)))
               (assoc profile :version "old")]]
    (is (false? (p/valid? bad)))
    (is (= :invalid-intake (:reason (intake/transition fixture/initial
                                     (assoc fixture/start :researcher-profile bad) now)))))
  (is (= "pending" (:affiliation (p/summary profile nil now))))
  (is (= "pending" (get-in (p/summary profile nil now) [:qualifications 0 :status]))))

(deftest every-declared-claim-needs-current-holder-matched-review
  (is (p/reviewed? profile review now))
  (is (p/reviewed? fixture/profile-none fixture/review-none now))
  (doseq [bad [(dissoc review :affiliation)
               (assoc-in review [:affiliation :holder-match] false)
               (assoc-in review [:affiliation :status] "declared-none")
               (assoc-in review [:affiliation :checked-at] (inc now))
               (assoc-in review [:qualifications 0 :source] "")
               (assoc-in review [:qualifications 0 :expires-at] now)
               (assoc-in review [:qualifications 0 :expires-at] (+ now 86400001))
               (assoc-in review [:qualifications 0 :status] "revoked")
               (assoc-in review [:qualifications 0 :id] "q2")
               (assoc review :qualifications [])]]
    (is (not (p/reviewed? profile bad now))))
  (is (= "expired" (:affiliation (p/summary profile review (+ now 3600000)))))
  (is (= "expired" (get-in (p/summary profile review (+ now 86400000)) [:qualifications 0 :status])))
  (is (= "declared-none" (:affiliation (p/summary fixture/profile-none fixture/review-none now)))))

(deftest private-profile-is-not-in-queue-and-reads-require-owner-or-assigned-reviewer
  (let [s (:state (intake/transition fixture/initial (assoc fixture/start :researcher-profile profile) now))
        r (get-in s [:intake "case"])
        read-event {:op :intake-profile-read :id "case" :principal "alice" :authenticated true :audit-id "audit-1"}]
    (is (not (contains? (intake/public-record r now) :researcher-profile)))
    (is (= "pending" (get-in (intake/public-record r now) [:profileSummary :affiliation])))
    (is (= :profile-read (get-in (intake/transition s read-event now) [:state :intake-audit "audit-1" :action])))
    (doseq [principal ["mallory" "reviewer"]]
      (is (= :profile-access-denied (:reason (intake/transition s (assoc read-event :principal principal) now)))))
    (is (= :profile-access-denied (:reason (intake/transition s read-event (+ now 604800000)))))))
