(ns ekyc.model-test (:export [main]) (:require [ekyc.model :as p]))

(defn- fstr [d :document k :keyword] :string
  (option-or (document-string-value (option-or (document-get d k) (document-null))) "?"))

(defn- fedn [d :document k :keyword] :string
  (document-edn-print (option-or (document-get d k) (document-null))))

(defn- session-case [] :i64
  (let [s (p/session (document-string "E1") (document-string "subj")
                     (document-map :provider (document-string "idv")
                                   :purpose (document-string "kyc")
                                   :required-checks (document-vector (document-keyword :liveness)
                                                                     (document-keyword :face-match))))
        bare (p/session (document-string "E2") (document-string "subj") (document-map :status (document-null)))]
    (+ (if (string=? (fstr s :ekyc/id) "E1") 0 1)
       (if (string=? (fedn s :ekyc/status) ":created") 0 1)
       (if (string=? (fstr s :ekyc/provider) "idv") 0 1)
       (if (= (document-count (option-or (document-get s :ekyc/required-checks) (document-null))) 2) 0 1)
       (if (string=? (fedn s :ekyc/expires-at) "nil") 0 1)
       (if (string=? (fedn bare :ekyc/status) "nil") 0 1)
       (if (= (document-count (option-or (document-get bare :ekyc/required-checks) (document-null))) 0) 0 1))))

(defn- evidence-case [] :i64
  (let [s (p/session (document-string "E1") (document-string "subj")
                     (document-map :provider (document-string "idv")))
        e (p/evidence s (document-keyword :liveness) (document-keyword :pass)
                      (document-map :confidence (document-i64 90)))]
    (+ (if (string=? (fstr e :ekyc/id) "E1") 0 1)
       (if (string=? (fedn e :ekyc/check) ":liveness") 0 1)
       (if (string=? (fedn e :ekyc/status) ":pass") 0 1)
       (if (string=? (fstr e :ekyc/provider) "idv") 0 1)
       (if (string=? (fedn e :ekyc/confidence) "90") 0 1)
       (if (string=? (fedn e :ekyc/non-adjudicating) "true") 0 1))))

(defn- sets-case [] :i64
  (+ (if (= (document-count (p/checks)) 9) 0 1)
     (if (= (document-count (p/statuses)) 6) 0 1)))

(defn main [] :i64
  (+ (session-case) (evidence-case) (sets-case)))
