(ns kotoba.lang.log-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.log :as log]))

(defn- recording-sink [atom] (fn [rec] (swap! atom conj rec)))

(deftest make-logger-shape
  (let [lg (log/make-logger (recording-sink (atom [])))]
    (is (= :info (:level lg)))
    (is (fn? (:sink lg)))))

(deftest level-filtering
  (let [recs (atom []) lg (log/make-logger (recording-sink recs) {:level :warn})]
    (log/info lg "skipped")                       ; below :warn, filtered
    (log/warn lg "kept")
    (is (= 1 (count @recs)))
    (is (= :warn (-> @recs first :level)))))

(deftest record-shape-and-context
  (let [recs (atom [])
        lg (log/make-logger (recording-sink recs) {:context {:service "x"}})]
    (log/info lg "hi" {:pid 42})
    (let [r (first @recs)]
      (is (= :info (:level r)))
      (is (= "hi" (:message r)))
      (is (= {:service "x" :pid 42} (:fields r))))))

(deftest level-convenience-fns
  (let [recs (atom []) lg (log/make-logger (recording-sink recs) {:level :trace})]
    (log/trace lg "t") (log/debug lg "d") (log/info lg "i")
    (log/warn lg "w") (log/error lg "e") (log/fatal lg "f")
    (is (= [:trace :debug :info :warn :error :fatal] (map :level @recs)))))

(deftest with-context-merges
  (let [recs (atom [])
        lg (-> (log/make-logger (recording-sink recs) {:context {:a 1}})
               (log/with-context {:b 2}))]
    (log/info lg "x")
    (is (= {:a 1 :b 2} (-> @recs first :fields)))))

(deftest span-lifecycle
  (let [recs (atom []) lg (log/make-logger (recording-sink recs) {:level :trace})]
    (let [[lg' span] (log/start-span lg "work")]
      (log/info lg' "doing work")
      (let [ended (log/end-span lg' span 15)]
        (is (= 15 (:duration-ms ended)))
        (is (= "work" (:name span)))
        ;; the child record carries the span-id
        (is (= (:span-id span) (:span-id (first @recs))))))))

(deftest clock-injects-timestamp
  (let [recs (atom []) lg (log/make-logger (recording-sink recs) {:clock (fn [] 1000)})]
    (log/info lg "x")
    (is (= 1000 (-> @recs first :ts)))))

(deftest filtered-log-returns-nil
  ;; a record below the min level is filtered out and returns nil (no sink call)
  (let [called? (atom false)
        lg (log/make-logger (fn [_] (reset! called? true)) {:level :error})]
    (is (nil? (log/info lg "x")))                  ; info < error -> filtered
    (is (false? @called?))))                       ; sink never invoked
