;; Acceptance test for kotoba.log.with-span (port of with_span.cljk).
;; main returns the number of failed cases (0 = all pass).
(ns kotoba.log.with-span-test
  (:export [main])
  (:require [kotoba.log.with-span :as ws]))

(defn- chk [ok :bool] :i64 (if ok 0 1))
(defn- kv [m :document k :keyword v :document] :document
  (document-assoc m (document-keyword k) v))
(defn- fget [m :document k :keyword] :document
  (option-or (document-get m (document-keyword k)) (document-null)))

(defn main [] :i64
  (let [lg (kv (kv (document-map) :level (document-keyword :info)) :name (document-string "app"))
        w (ws/with-span lg (document-i64 42))
        a (chk (document-equal? (fget w :span-id) (document-i64 42)))
        b (chk (document-equal? (fget w :level) (document-keyword :info)))
        c (chk (document-equal? (fget w :name) (document-string "app")))
        d (chk (document-equal? (fget lg :span-id) (document-null)))
        w2 (ws/with-span w (document-i64 7))
        e (chk (document-equal? (fget w2 :span-id) (document-i64 7)))]
    (+ a (+ b (+ c (+ d e))))))
