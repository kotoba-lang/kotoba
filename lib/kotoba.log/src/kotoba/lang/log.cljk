(ns kotoba.lang.log
  "Structured logging + telemetry (trace/span) as pure data, host-injected sink.
  A capability-confined kotoba cell does not get stdout — the host grants a log
  sink. Records are pure data; transport is `(sink record)`. Consumes coll for
  field shaping. No third-party deps; .cljc (JVM/SCI/CLJS/GraalVM/kotoba-WASM)."
  (:require [kotoba.lang.coll :as c]))

(def levels [:trace :debug :info :warn :error :fatal])
(def level-rank (zipmap levels (range)))

(defn- level->rank [lvl] (get level-rank lvl 99))

(defn make-logger
  "Make a logger. `sink` is a host-injected fn of one record. `opts`:
  `:level` (default :info), `:context` (default fields merged into every
  record), `:clock` (a 0-arg fn returning epoch-millis; default nil = no ts)."
  ([sink] (make-logger sink nil))
  ([sink opts]
   (let [o (or opts {})]
     {:sink    sink
      :level   (:level o :info)
      :context (:context o {})
      :clock   (:clock o)
      :span-id (:span-id o)})))

(defn level-enabled?
  "True iff `lvl` is >= the logger's min level."
  [logger lvl]
  (>= (level->rank lvl) (level->rank (:level logger))))

(defn with-context
  "Return a logger with merged context fields (coll/deep-merge)."
  [logger context]
  (update logger :context #(c/deep-merge % context)))

(defn with-span
  "Return a logger whose records tag `span-id` as their parent."
  [logger span-id]
  (assoc logger :span-id span-id))

(defn- emit
  [logger lvl message fields]
  (when (level-enabled? logger lvl)
    (let [rec (cond-> {:level lvl :message message}
                (:context logger) (assoc :fields (c/deep-merge (:context logger) (or fields {})))
                (:span-id logger)  (assoc :span-id (:span-id logger))
                (:clock logger)     (assoc :ts ((:clock logger))))]
      ((:sink logger) rec)
      rec)))

(defn log
  "Emit a record at `lvl` with `message` and optional `fields` map. Returns the
  record (or nil if filtered by level)."
  ([logger lvl message] (log logger lvl message nil))
  ([logger lvl message fields] (emit logger lvl message fields)))

(defn trace [logger message & [fields]] (log logger :trace message fields))
(defn debug [logger message & [fields]] (log logger :debug message fields))
(defn info  [logger message & [fields]] (log logger :info  message fields))
(defn warn  [logger message & [fields]] (log logger :warn  message fields))
(defn error [logger message & [fields]] (log logger :error message fields))
(defn fatal [logger message & [fields]] (log logger :fatal message fields))

;; ---------- spans ----------

(def ^:private id-counter (atom 0))
(defn- next-span-id []
  ;; deterministic-ish id (no Math/random in pure lib); caller can override
  (swap! id-counter inc))

(defn start-span
  "Start a span named `name`. Returns `[logger' span]` where `logger'` tags
  child records with the span id, and `span` is `{:span-id :name :start-ts}`."
  ([logger name] (start-span logger name nil))
  ([logger name opts]
   (let [sid (or (:span-id opts) (next-span-id))
         span {:span-id sid :name name
               :start-ts (when (:clock logger) ((:clock logger)))
               :parent-id (:span-id logger)}
         logger' (with-span logger sid)]
     [logger' span])))

(defn end-span
  "End a span. `elapsed-ms` is the duration (host-supplied — the lib has no
  wall-clock). Emits a span-end record via the sink and returns the finalized
  span with `:duration-ms`."
  [logger span elapsed-ms]
  (let [span' (assoc span :duration-ms elapsed-ms :end-ts (when (:clock logger) ((:clock logger))))]
    (when (level-enabled? logger :trace)
      ((:sink logger) {:level :trace :message (str "span.end " (:name span))
                       :span (:span-id span') :fields span'}))
    span'))
