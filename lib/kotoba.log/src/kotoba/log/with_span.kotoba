;; Port of kotoba.log.with-span (with_span.cljk), Kotoba-native.
;;
;; The logger is a :document map and `span-id` a :document. The result is the
;; logger with :span-id set, as `assoc` does. No divergence in behaviour.

(ns kotoba.log.with-span
  (:export [with-span]))

;; Return a logger whose records tag `span-id` as their parent.
(defn with-span [logger :document span-id :document] :document
  (document-assoc logger :span-id span-id))
