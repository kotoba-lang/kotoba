(ns kotoba.log.log
  "log -- addressed on its own.

  Split out of kotoba.lang.log on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.log.emit :refer [emit]])
)

(defn log
  "Emit a record at `lvl` with `message` and optional `fields` map. Returns the
  record (or nil if filtered by level)."
  ([logger lvl message] (log logger lvl message nil))
  ([logger lvl message fields] (emit logger lvl message fields)))
