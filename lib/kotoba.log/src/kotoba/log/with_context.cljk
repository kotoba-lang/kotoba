(ns kotoba.log.with-context
  "with-context -- addressed on its own.

  Split out of kotoba.lang.log on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.lang.coll :as c])
)

(defn with-context
  "Return a logger with merged context fields (coll/deep-merge)."
  [logger context]
  (update logger :context #(c/deep-merge % context)))
