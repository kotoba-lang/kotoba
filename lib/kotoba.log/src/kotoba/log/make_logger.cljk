(ns kotoba.log.make-logger
  "make-logger -- addressed on its own.

  Split out of kotoba.lang.log on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  )

(defn make-logger
  "Make a logger. `sink` is a host-injected fn of one record. `opts`:
  `:level` (default :info), `:context` (default fields merged into every
  record), `:clock` (a 0-arg fn returning epoch-millis; default nil = no ts)."
  ([sink] (make-logger sink nil))
  ([sink opts]
   (let [o (or opts {})]
     {:sink    sink
      :level   (:level o :info)
      :context (:context o {})
      :clock   (:clock o)
      :span-id (:span-id o)})))
