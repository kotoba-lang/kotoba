(ns kotoba.log.level-enabled
  "level-enabled? -- addressed on its own.

  Split out of kotoba.lang.log on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.log.level-to-rank :refer [level->rank]])
)

(defn level-enabled?
  "True iff `lvl` is >= the logger's min level."
  [logger lvl]
  (>= (level->rank lvl) (level->rank (:level logger))))
