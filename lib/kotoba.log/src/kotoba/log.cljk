(ns kotoba.log
  "Assembled from one repo per definition.

  This namespace holds no implementation. It re-exports the definitions
  that each live in their own repo, so a call site can require one name
  and a library can require only the definitions it actually uses.

  Value vars are not re-exported either: id-counter, level-rank, levels. `(def x other/x)` copies, which is harmless for a function and makes
  with-redefs through this namespace a SILENT no-op for a value -- measured
  on kotoba.lang.edn, where three assertions passed against nothing at all.
  Require the repo that defines the value.
"
  (:require [kotoba.log.debug :as debug-ns]
            [kotoba.log.end-span :as end-span-ns]
            [kotoba.log.error :as error-ns]
            [kotoba.log.fatal :as fatal-ns]
            [kotoba.log.info :as info-ns]
            [kotoba.log.level-enabled :as level-enabled-ns]
            [kotoba.log.log :as log-ns]
            [kotoba.log.make-logger :as make-logger-ns]
            [kotoba.log.start-span :as start-span-ns]
            [kotoba.log.trace :as trace-ns]
            [kotoba.log.warn :as warn-ns]
            [kotoba.log.with-context :as with-context-ns]
            [kotoba.log.with-span :as with-span-ns]))

(def debug "See kotoba.log.debug/debug." debug-ns/debug)
(def end-span "See kotoba.log.end-span/end-span." end-span-ns/end-span)
(def error "See kotoba.log.error/error." error-ns/error)
(def fatal "See kotoba.log.fatal/fatal." fatal-ns/fatal)
(def info "See kotoba.log.info/info." info-ns/info)
(def level-enabled? "See kotoba.log.level-enabled/level-enabled?." level-enabled-ns/level-enabled?)
(def log "See kotoba.log.log/log." log-ns/log)
(def make-logger "See kotoba.log.make-logger/make-logger." make-logger-ns/make-logger)
(def start-span "See kotoba.log.start-span/start-span." start-span-ns/start-span)
(def trace "See kotoba.log.trace/trace." trace-ns/trace)
(def warn "See kotoba.log.warn/warn." warn-ns/warn)
(def with-context "See kotoba.log.with-context/with-context." with-context-ns/with-context)
(def with-span "See kotoba.log.with-span/with-span." with-span-ns/with-span)
