{:paths ["src"]
 ;; The multirotor mass spiral, over the three sizing solvers. Thrust equals
 ;; weight on a rotorcraft, so mass appears on both sides of the loop and the
 ;; fixed point is not guaranteed to exist — this library's job is to find it
 ;; when it does and to REFUSE when it does not.
 :deps {
        io.github.kotoba-lang/test
        {:local/root "../kotoba.test"}io.github.kotoba-lang/datom
        {:local/root "../kotoba.datom"}
        io.github.kotoba-lang/kami-engine-cae-solver {:local/root "../kotoba.kamiEngineCaeSolver"}
        io.github.kotoba-lang/kami-engine-rotor      {:local/root "../kotoba.kamiEngineRotor"}
        io.github.kotoba-lang/kami-engine-pack       {:local/root "../kotoba.kamiEnginePack"}
        io.github.kotoba-lang/kami-engine-motor      {:local/root "../kotoba.kamiEngineMotor"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
