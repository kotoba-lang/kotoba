;; Port of session.model (model.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from model.cljk:
;;   - statuses is a zero-arg fn returning a :document vector of the three
;;     status keywords (the source is a set; a def cannot be exported).
;;   - an absent option and a null option are both stored as document-null,
;;     as nil is in the source.
;;   - session and event keep their argument order and key names.

(ns session.model
  (:export [statuses session event]))

(defn- opt [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn statuses [] :document
  (document-vector (document-keyword :active) (document-keyword :expired) (document-keyword :revoked)))

(defn session [id :document subject :document opts :document] :document
  (document-map :session/id id
                :session/subject subject
                :session/status (option-or (document-get opts :status) (document-keyword :active))
                :session/authn-ref (opt opts :authn-ref)
                :session/device-id (opt opts :device-id)
                :session/ip (opt opts :ip)
                :session/token-binding (opt opts :token-binding)
                :session/cookie-binding (opt opts :cookie-binding)
                :session/header-binding (opt opts :header-binding)
                :session/created-at (opt opts :created-at)
                :session/last-seen-at (opt opts :last-seen-at)
                :session/rotated-from (opt opts :rotated-from)
                :session/expires-at (opt opts :expires-at)))

(defn event [sess :document ev-type :document opts :document] :document
  (document-map :session.event/session-id (opt sess :session/id)
                :session.event/type ev-type
                :session.event/at (opt opts :at)
                :session.event/reason (opt opts :reason)))
