;; Port of session.datom (datom.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from datom.cljk:
;;   - str of each event-id part is text: null is "", a string is itself, any
;;     other value is its canonical EDN text (document-edn-print). A null
;;     session-id or type therefore gives "" where Clojure's str/name would
;;     throw on nil.
;;   - (name type) reads a keyword's name; a non-keyword type uses its text.
;;   - absent keys are document-null, as nil is in the source.

(ns session.datom
  (:export [session-datoms event-datoms]))

(defn- field [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn- text [d :document] :string
  (if (= (document-kind d) :null)
    ""
    (option-or (document-string-value d) (document-edn-print d))))

(defn- name-text [d :document] :string
  (if (= (document-kind d) :keyword)
    (keyword-name (option-or (document-keyword-value d) :none))
    (text d)))

(defn- event-id [event :document] :string
  (string-concat (string-concat (string-concat (text (field event :session.event/session-id)) ":")
                                (string-concat (name-text (field event :session.event/type)) ":"))
                 (text (field event :session.event/at))))

(defn session-datoms [session :document] :document
  (document-vector
   (document-map :db/id (document-vector (document-keyword :session/id) (field session :session/id))
                 :session/id (field session :session/id)
                 :session/subject (field session :session/subject)
                 :session/status (field session :session/status)
                 :session/authn-ref (field session :session/authn-ref)
                 :session/device-id (field session :session/device-id)
                 :session/ip (field session :session/ip)
                 :session/token-binding (field session :session/token-binding)
                 :session/cookie-binding (field session :session/cookie-binding)
                 :session/header-binding (field session :session/header-binding)
                 :session/created-at (field session :session/created-at)
                 :session/last-seen-at (field session :session/last-seen-at)
                 :session/rotated-from (field session :session/rotated-from)
                 :session/expires-at (field session :session/expires-at))))

(defn event-datoms [event :document] :document
  (document-vector
   (document-map :db/id (document-vector (document-keyword :session.event/id) (document-string (event-id event)))
                 :session.event/id (document-string (event-id event))
                 :session.event/session-id (field event :session.event/session-id)
                 :session.event/type (field event :session.event/type)
                 :session.event/at (field event :session.event/at)
                 :session.event/reason (field event :session.event/reason))))
