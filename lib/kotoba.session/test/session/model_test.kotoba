(ns session.model-test (:export [main]) (:require [session.model :as p]))

(defn- show [d :document k :keyword] :string
  (document-edn-print (option-or (document-get d k) (document-null))))

(defn main [] :i64
  (let [s (p/session (document-string "s1") (document-string "u") (document-map))
        r (p/session (document-string "s2") (document-string "u")
                     (document-map :status (document-keyword :revoked) :authn-ref (document-string "a")))
        e (p/event r (document-keyword :revoked) (document-map :at (document-i64 7) :reason (document-string "x")))]
    (+ (if (string=? (show s :session/status) ":active") 0 1)
       (if (string=? (show r :session/status) ":revoked") 0 1)
       (if (string=? (show r :session/authn-ref) "\"a\"") 0 1)
       (if (string=? (show s :session/authn-ref) "nil") 0 1)
       (if (string=? (show e :session.event/session-id) "\"s2\"") 0 1)
       (if (string=? (show e :session.event/type) ":revoked") 0 1)
       (if (string=? (show e :session.event/at) "7") 0 1)
       (if (string=? (show e :session.event/reason) "\"x\"") 0 1)
       (if (string=? (document-edn-print (p/statuses)) "[:active :expired :revoked]") 0 1))))
