(ns session.datom-test
  (:export [main])
  (:require [session.datom :as s]))

(defn- expect [got :bool want :bool] :i64
  (if (= got want) 0 1))

(defn- edn-is [got :document want :string] :i64
  (if (string=? (document-edn-print got) want) 0 1))

(defn- field [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn- at [xs :document i :i64] :document
  (option-or (document-vector-at xs i) (document-null)))

(defn main [] :i64
  (let [sess (document-map :session/id (document-string "s1")
                           :session/subject (document-string "alice")
                           :session/status (document-keyword :active)
                           :session/created-at (document-i64 100)
                           :session/expires-at (document-i64 900))
        sd (at (s/session-datoms sess) 0)
        ev (document-map :session.event/session-id (document-string "s1")
                         :session.event/type (document-keyword :login)
                         :session.event/at (document-i64 100)
                         :session.event/reason (document-string "ok"))
        ed (at (s/event-datoms ev) 0)]
    (+ (edn-is (field sd :db/id) "[:session/id \"s1\"]")
       (edn-is (field sd :session/subject) "\"alice\"")
       (edn-is (field sd :session/status) ":active")
       (edn-is (field sd :session/expires-at) "900")
       (expect (= (document-kind (field sd :session/ip)) :null) true)
       (edn-is (field ed :db/id) "[:session.event/id \"s1:login:100\"]")
       (edn-is (field ed :session.event/id) "\"s1:login:100\"")
       (edn-is (field ed :session.event/reason) "\"ok\"")
       (expect (= (document-count (s/session-datoms sess)) 1) true))))
