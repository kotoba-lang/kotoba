;; resources/computeruse/backends.edn — the selectable execution-backend
;; registry (ADR-0003). Ten ids, fixed. A bot selects one with a single
;; keyword (:bot/backend); promoting a bot is a one-keyword edit.
;;
;; ## How to read :qualification
;;
;; Per capability (:observe / :act / :probe) one of:
;;
;;   :qualified    measured working, on the date in :measured-at, by the
;;                 command in :how
;;   :refused      implemented and deliberately says no (deny-by-default
;;                 policy); :reason pins the refusal literal
;;   :unavailable  implemented, measured, and it did not work here;
;;                 :why carries the exact error
;;   :pending      not implemented; :unblock is the concrete condition
;;   :unmeasured   nobody measured it in the run that wrote this file
;;
;; A status without a date is not a status. Nothing in this file may be
;; optimistic: "we did not try" is :unmeasured, never :qualified. The
;; workspace rule this follows is the capability-kit discipline —
;; a value written here is quoted later without its date, so only write
;; what was observed.
;;
;; ## Isolation
;;
;; :steals-focus?  does using this backend take the operator's keyboard
;;                 focus or move their cursor? This workstation runs many
;;                 concurrent agent sessions in terminal panes; a backend
;;                 that steals focus can send input to the wrong pane.
;; :shares-desktop? does it observe/act on the same desktop the operator
;;                 is using right now?

{:registry/version 1
 :registry/measured-at "2026-08-29"
 :registry/measured-on {:os "macOS (Darwin 25.4.0)" :arch "arm64"
                        :host "junkawasaki workstation"}
 :registry/note
 "Measurements below were taken by the run that landed ADR-0003. Re-measure with `probe!`; do not quote these as current."

 :backends
 {;; ─────────────────────────────────────────────────────────────────
  :macos-local
  {:description
   "The live macOS desktop of the machine the CLI runs on: full-screen screencapture, osascript keystrokes, cliclick pointer. This is computeruse.macos as a selectable backend."
   :implemented? true
   :isolation {:steals-focus? true
               :shares-desktop? true
               :note "Acts land wherever the OS focus is. On this workstation that is one of many concurrent Claude Code terminal panes, so act is deny-by-default: :bot/target must carry {:allow-foreground true}."}
   :target-keys {:allow-foreground "boolean — required for any act; without it every act refuses with :backend/foreground-not-allowed"}
   :qualification
   {:observe {:status :qualified :measured-at "2026-08-29"
              :how "screencapture -x -t png /tmp/…png on the workstation main display"}
    :act {:status :refused :measured-at "2026-08-29"
          :reason :backend/foreground-not-allowed
          :why "deny-by-default. The act paths (osascript keystroke, cliclick) exist and their tools are present (/opt/homebrew/bin/cliclick, /usr/bin/osascript, measured 2026-08-29), but they were NOT exercised: sending synthetic input on this workstation would have typed into a live agent's terminal pane."
          :unblock "set :allow-foreground true in the bot's :bot/target, on a machine whose desktop is not shared with concurrent agent sessions"}
    :probe {:status :qualified :measured-at "2026-08-29"
            :how "which screencapture / which cliclick"}}}

  ;; ─────────────────────────────────────────────────────────────────
  :window-scoped
  {:description
   "One macOS window, addressed by CGWindowID. Observes with `screencapture -l <id>` — which captures a window WITHOUT focusing it — and acts only through app scripting (AppleScript/AX). Synthetic global input is refused permanently."
   :implemented? true
   :isolation {:steals-focus? false
               :shares-desktop? true
               :note "Capture does not raise or focus the window (measured: frontmost app was unchanged after capture). Synthetic global keyboard/mouse input is excluded twice over: the :pointer/:key/:type action KINDS are refused, and the :script content is checked for System Events keystroke / key code / key down|up / click at and for do shell script / run script. A :script may still `activate` an application (that takes the operator's focus without synthesising input); when it does, the act result carries :activated-app? true so the receipt shows it."
               :measured-hole "2026-08-29, in a real session: refusing the action kinds alone was NOT enough. The model wrote `tell application \"Google Chrome\" to activate` followed by `tell application \"System Events\" to key code 116`, and the gate allowed it four steps running because the kind was :script. On this workstation those key codes could have landed in a concurrent agent's terminal pane. The content check was added in response; excluding a capability by naming the action kind is not excluding it."}
   :target-keys {:window-id "int — an exact CGWindowID"
                 :app "string — CGWindowOwnerName, e.g. \"Google Chrome\""
                 :title-substr "string — substring match on the window title"}
   :qualification
   {:observe {:status :qualified :measured-at "2026-08-29"
              :how "Swift CGWindowListCopyWindowInfo helper enumerated 11 on-screen layer-0 windows; `screencapture -x -o -l 110` produced a 128,873-byte PNG of the ChatGPT window; a 32px downsample measured byte-stddev 94.4 (blank threshold 4.0); the frontmost application was still Terminal afterwards."
              :notes ["pyobjc Quartz is absent on this machine (ModuleNotFoundError) and JXA ObjC.deepUnwrap of the CGWindowList CFArray yields undefined, so the Swift helper is the working enumeration route. First call pays one swiftc compile (8.8s measured); later calls reuse the cached binary."
                      "Windows on other Spaces or minimised windows are not layer-0 on-screen and will not be found — measured: Google Chrome was running with 1 window and did NOT appear in the on-screen list."]}
    :act {:status :qualified :measured-at "2026-08-29"
          :how "osascript app-scripting through the :script action, measured in a real session (Chrome `open location` and `execute javascript … in active tab` both executed); :pointer/:key/:type refuse with :backend/unsupported-action-kind; a :script containing synthetic input refuses with :backend/synthetic-input-in-script before reaching osascript"
          :refuses {:pointer :backend/unsupported-action-kind
                    :key :backend/unsupported-action-kind
                    :type :backend/unsupported-action-kind
                    :script-with-synthetic-input :backend/synthetic-input-in-script}
          :caveat "The content check is a denylist over a language that can hide constructs behind indirection, so it is a floor rather than a proof. The structural guarantee is that the action kinds are refused."}
    :probe {:status :qualified :measured-at "2026-08-29"
            :how "window enumeration + target match"}}}

  ;; ─────────────────────────────────────────────────────────────────
  :agent-space
  {:description
   "A background macOS Space that hosts the target app, so the agent drives a window the operator never sees and never competes with for focus. The mechanism exists behind the computer-use-mcp server (create_agent_space / agent_pointer / activate_window)."
   :implemented? false
   :isolation {:steals-focus? false
               :shares-desktop? false
               :note "The point of this backend: same machine, different Space."}
   :qualification
   {:observe {:status :pending :measured-at "2026-08-29"
              :measured "There is no computer-use-mcp binary on PATH and no global npm package providing one (`command -v computer-use-mcp` → absent; `npm ls -g --depth 0` has no computer-use package). The tools are reachable only from inside an MCP client session, which a library cannot call."
              :unblock "a non-MCP seam for agent spaces — either a CLI that this backend can shell (create/destroy a space, move a window into it, capture it), or a local HTTP endpoint the sh seam can curl. Until then this cannot be driven from a resident bot process."}
    :act {:status :pending :measured-at "2026-08-29" :unblock "same as :observe"}
    :probe {:status :pending :measured-at "2026-08-29" :unblock "same as :observe"}}}

  ;; ─────────────────────────────────────────────────────────────────
  :fleet-node
  {:description
   "A murakumo mac-mini fleet node over ssh: capture there, copy the PNG back with scp. Isolated from the operator's desktop entirely."
   :implemented? true
   :isolation {:steals-focus? false
               :shares-desktop? false
               :note "Another machine. Nothing it does can touch the operator's session."}
   :target-keys {:host "string — ssh host alias, e.g. \"judah\""}
   :qualification
   {:observe {:status :unavailable :measured-at "2026-08-29"
              :why "ssh reaches all three nodes tried and /usr/sbin/screencapture is present on each, but the ssh session has no window-server connection, so the capture never happens."
              :per-node {"judah" "ssh ok (Darwin, user judah); screencapture exits 1: \"could not create image from display\"; no file produced"
                         "simeon" "ssh ok (Darwin, user simeon); screencapture exits 1: \"could not create image from display\"; no file produced"
                         "zebulun" "ssh ok (Darwin, user zebulun); screencapture exits 1: \"could not create image from display\"; no file produced"}
              :unblock "a GUI login session on the node (console user logged in, not just sshd) AND Screen Recording TCC granted to the ssh context. Nothing was installed on any node to measure this."}
    :act {:status :unavailable :measured-at "2026-08-29"
          :reason :backend/act-unsupported
          :why "cliclick is absent on judah/simeon/zebulun, and `osascript -e 'tell application \"System Events\" to keystroke \"a\"'` over ssh fails with error -10810 (no GUI session) on judah."
          :unblock "same GUI-session requirement as :observe, plus an input tool on the node"}
    :probe {:status :qualified :measured-at "2026-08-29"
            :how "ssh <host> true, then remote screencapture — reports available? false with the exact per-node error, which is what it measured"}}}

