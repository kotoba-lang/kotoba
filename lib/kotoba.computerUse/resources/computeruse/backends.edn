  ;; ─────────────────────────────────────────────────────────────────
  :host-object
  {:description
   "No screen at all: run a caller-supplied probe command and take its verdict as the observation. Its three-valued exit (0 pass / 1 fail / 2 could-not-measure) and the last EDN form it printed are the frame. This makes a cheap deterministic gate selectable through the same contract as a desktop — a bot starts here and is promoted by changing one keyword."
   :implemented? true
   :isolation {:steals-focus? false
               :shares-desktop? false
               :note "Spawns a process. It has whatever authority the command has — this backend does not sandbox anything, it only refuses to synthesise input."}
   :target-keys {:cmd "vector of strings — [exe arg…]"
                 :cwd "string — working directory; a relative value is resolved by the CLI against the roster's directory, then its parent"
                 :timeout-ms "int — default 600000"}
   :qualification
   {:observe {:status :qualified :measured-at "2026-08-29"
              :how "ran the isekai-touch-qa target (kbb --backend sci scripts/run-task.cljk jintori-touch in orgs/network-awai/network-isekai) and captured its exit plus its final EDN line"}
    :act {:status :refused :measured-at "2026-08-29"
          :reason :backend/act-unsupported
          :why "observation-only by construction; there is nothing to act on"}
    :probe {:status :qualified :measured-at "2026-08-29"
