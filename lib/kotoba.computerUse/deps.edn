{:paths ["src" "resources"]
 ;; Built on langgraph (graph agent loop) which brings langchain
 ;; (ChatModel / tools / Datomic-API store). Both are zero-third-party-dep .cljc.
 ;; Was pinned {:git/tag "v0.2.0" :sha "133740f..."} -- `:sha` (not
 ;; `:git/sha`) is not a real tools.deps git-coord key, so it was silently
 ;; dropped and resolution fell through to just `:git/tag "v0.2.0"`, which
 ;; is langgraph's pre-org-rename commit (still depends on the OLD
 ;; io.github.com-junkawasaki/langchain-clj coordinate, which shadows
 ;; io.github.kotoba-lang/langchain's `langchain.model` namespace on the
 ;; classpath and drops `openai-model` -- every example in this repo
 ;; failed to load with `No such var: model/openai-model` as a result,
 ;; not just new ones). Pinned past langgraph's org-rename
 ;; (kotoba-lang/langgraph#3) to a commit that depends on
 ;; io.github.kotoba-lang/langchain directly; no v0.2.x tag has this yet
 ;; (newest tag v0.2.1 predates the rename), hence :git/sha only.
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/json {:local/root "../kotoba.json"}
        io.github.kotoba-lang/pprint {:local/root "../kotoba.pprint"}
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/hil {:local/root "../kotoba.hil"}
        io.github.kotoba-lang/langgraph {:local/root "../kotoba.langgraph"}}
 :aliases
 {:test {:extra-paths ["test"]}
  ;; local checkouts for workspace development (orgs/kotoba-lang/*)
  :dev {:override-deps {io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.langgraph"}
                        io.github.kotoba-lang/langchain
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.langchain"}}}}}
