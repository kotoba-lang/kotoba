(ns nafuda.core-test
  (:require [kotoba.test :refer [deftest is testing]]
            [nafuda.core :as n]
            [nafuda.statement :as st]
            [nafuda.registry :as reg]
            [tsunagi.identity :as id]
            [tsunagi.wire :as w]))

(defn- seed [k] (vec (map #(bit-and (+ k (* 11 %)) 0xff) (range 32))))
(def root (id/from-seed (seed 1)))
(def phone (id/from-seed (seed 2)))
(def home (id/from-seed (seed 3)))
(def g1 (id/from-seed (seed 4)))
(def g2 (id/from-seed (seed 5)))
(def g3 (id/from-seed (seed 6)))
(def new-root (id/from-seed (seed 7)))
(def village (id/from-seed (seed 8)))
(def rh (n/hex-of root))

(def phone-cert (n/device-cert root phone {:roles #{:call :page} :serial 1 :not-before 0 :not-after 1000}))

(deftest statement-test
  (testing "canonical bytes ignore map and set construction order"
    (is (= (st/signing-bytes {:b 1 :a #{3 1 2}})
           (st/signing-bytes (array-map :a #{2 3 1} :b 1)))))
  (testing "encode/decode round-trip keeps the signature valid"
    (is (st/valid? (st/decode (st/encode phone-cert)))))
  (testing "a changed field breaks it"
    (is (not (st/valid? (assoc-in phone-cert [:statement :nafuda/roles] #{:call :page :home})))))
  (is (nil? (st/decode (w/utf8 "#=(boom)")))))

(deftest authorization-test
  (testing "a certified device acts in its roles, within its window"
    (is (n/authorized? rh [phone-cert] phone :call 10))
    (is (not (n/authorized? rh [phone-cert] phone :home 10)))
    (is (not (n/authorized? rh [phone-cert] phone :call 1000))))
  (testing "a certificate signed by someone else is worthless"
    (is (not (n/authorized? rh [(n/device-cert home phone {:roles #{:call} :serial 1})] phone :call 10))))
  (testing "revocation cuts a device off"
    (is (not (n/authorized? rh [phone-cert (n/revocation root [1] 20)] phone :call 30)))))

(deftest root-continuity-test
  (let [gs (n/guardian-set root [g1 g2 g3] 2 0)
        cert-new (n/device-cert new-root phone {:roles #{:call} :serial 1})]
    (testing "succession signed by the old root"
      (is (= (n/hex-of new-root) (n/current-root rh [(n/succession root new-root 5)]))))
    (testing "guardian recovery needs a quorum of distinct members"
      (is (= rh (n/current-root rh [gs (n/recovery-vote g1 root new-root 9)])))
      (is (= rh (n/current-root rh [gs (n/recovery-vote g1 root new-root 9)
                                    (n/recovery-vote g1 root new-root 10)])))
      (is (= (n/hex-of new-root)
             (n/current-root rh [gs (n/recovery-vote g1 root new-root 9)
                                 (n/recovery-vote g3 root new-root 9)]))))
    (testing "a vote from outside the guardian set does not count"
      (is (= rh (n/current-root rh [gs (n/recovery-vote g1 root new-root 9)
                                    (n/recovery-vote village root new-root 9)]))))
    (testing "after recovery, the new root's certificates authorize"
      (is (n/authorized? rh [gs cert-new (n/recovery-vote g1 root new-root 9)
                             (n/recovery-vote g2 root new-root 9)]
                         phone :call 10)))))

(deftest card-test
  (let [c (n/card root {:name "田中" :devices [phone-cert] :homes ["00ff"] :issued-at 1})
        qr (n/card->qr c)
        back (n/qr->card qr)]
    (is (= "田中" (get-in back [:statement :nafuda/name])))
    (is (n/authorized? (get-in back [:statement :nafuda/signer])
                       (get-in back [:statement :nafuda/devices]) phone :page 5))
    (is (nil? (n/qr->card "nafuda:AAAA")))
    (is (nil? (n/qr->card "http://evil")))))

(deftest backup-test
  (let [rnd (let [s (atom 3)] (fn [k] (vec (repeatedly k #(bit-and (swap! s (fn [x] (+ (* 31 x) 7))) 0xff)))))
        b (n/backup-shares (:seed root) [g1 g2 g3] 2 rnd)
        opened (fn [g i] (n/open-share g (get-in b [:shares i :sealed])))]
    (is (= (:seed root) (n/recover-seed (:commitment b) [(opened g1 0) (opened g3 2)])))
    (testing "a guardian cannot open another's share"
      (is (nil? (opened g2 0))))
    (testing "one share is not enough"
      (is (nil? (n/recover-seed (:commitment b) [(opened g1 0)]))))))

(deftest registry-test
  (let [r (reg/registry village "yamanaka" {})
        [r c1] (reg/claim r root "tanaka" 100)
        [r taken] (reg/claim r phone "tanaka" 100)
        [r c2] (reg/claim r phone "suzuki" 100)
        trusted {"yamanaka" (n/hex-of village)}
        claims [c1 c2]]
    (is (= {:error :name-taken} taken))
    (is (= "1000" (get-in c1 [:statement :nafuda/number])))
    (is (= "1001" (get-in c2 [:statement :nafuda/number])))
    (is (= rh (reg/resolve-address trusted claims "tanaka@yamanaka" 200)))
    (is (= rh (reg/resolve-address trusted claims "#yamanaka/1000" 200)))
    (testing "an untrusted registry's claim resolves to nothing"
      (is (nil? (reg/resolve-address {"yamanaka" (n/hex-of g1)} claims "tanaka@yamanaka" 200))))
    (testing "display name prefers the user's own petname"
      (is (= ["おばあちゃん" :petname]
             (reg/display-name (reg/set-petname (reg/petnames) root "おばあちゃん") claims trusted root 200)))
      (is (= ["tanaka@yamanaka" :registry] (reg/display-name {} claims trusted root 200)))
      (is (= :unknown (second (reg/display-name {} [] trusted root 200)))))))
