(ns nafuda.statement
  "Signed statements — the one record format every nafuda credential uses.

  A statement is an EDN map. Its signing bytes are its **canonical** EDN:
  maps become sorted maps, sets become sorted vectors, recursively, then
  `pr-str`, then UTF-8. Two runtimes that hold equal values therefore sign
  and verify the same bytes. Byte values travel as lowercase hex strings so
  the map stays plain EDN.

      {:nafuda/kind   :device          ; what the statement says
       :nafuda/signer \"<hex public>\"  ; who says it (64-byte tsunagi public key)
       …kind-specific fields…}

  A signed statement is `{:statement m :signature hex}`; on the wire it is the
  canonical EDN of that map."
  (:require [kotoba.lang.edn :as edn]
            [tsunagi.identity :as id]
            [tsunagi.wire :as w]))

(defn canonical [x]
  (cond
    (map? x) (into (sorted-map) (map (fn [[k v]] [k (canonical v)])) x)
    (set? x) (vec (sort (map canonical x)))
    (sequential? x) (mapv canonical x)
    :else x))

(defn signing-bytes [statement]
  (w/utf8 (pr-str (canonical statement))))

(defn sign
  "Sign `statement` with a private tsunagi identity; the signer field is set
  here so it cannot disagree with the key that signed."
  [identity statement]
  (let [st (assoc statement :nafuda/signer (w/hex (:public identity)))]
    {:statement st
     :signature (w/hex (id/sign identity (signing-bytes st)))}))

(defn signer
  "The public identity a signed statement claims to be from (unverified)."
  [{:keys [statement]}]
  (some-> (:nafuda/signer statement) w/unhex id/public-only))

(defn valid?
  "Whether the signature is good for the claimed signer."
  [{:keys [statement signature] :as signed}]
  (boolean
   (when-let [ident (signer signed)]
     (when-let [sig (and (string? signature) (w/unhex signature))]
       (id/verify ident (signing-bytes statement) sig)))))

(defn signed-by?
  "Valid and from exactly this public key (hex or bytes)."
  [signed public]
  (and (valid? signed)
       (= (:nafuda/signer (:statement signed))
          (if (string? public) public (w/hex public)))))

(defn encode [signed] (w/utf8 (pr-str (canonical signed))))

(defn decode
  "A signed statement from bytes, or nil for anything that is not one."
  [bs]
  (try
    (let [v (edn/read-string (w/utf8-str bs))]
      (when (and (map? v) (map? (:statement v)) (string? (:signature v)))
        v))
    (catch #?(:clj Exception :cljs :default :default :default) _ nil)))

(defn in-force?
  "Whether `now` (seconds) falls inside the statement's validity window."
  [{:keys [statement]} now]
  (let [{:nafuda/keys [not-before not-after]} statement]
    (and (or (nil? not-before) (<= not-before now))
         (or (nil? not-after) (< now not-after)))))
