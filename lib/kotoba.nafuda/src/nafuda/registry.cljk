(ns nafuda.registry
  "Human names, scoped to a community, with no global namespace.

      tanaka@yamanaka      a name the `yamanaka` registry signed
      #yamanaka/4021       a short number the same registry allocated

  A registry is an ordinary tsunagi identity run by a community (a village
  office, a co-op, a building). It signs **claims**; it never stores anything
  a client must reach in order to place a call — a client holds the claims
  it was given and checks them against the registry keys it chose to trust.
  Two registries may both issue `tanaka`; the `@community` part, bound to a
  registry key the user trusts, says which one is meant.

  The same claim form carries an **E.164 binding** issued by a licensed PSTN
  gateway (`:nafuda/kind :e164`), so a contact imported from an ordinary
  phone book can be matched to a key."
  (:require [nafuda.statement :as st]
            [nafuda.core :as core]
            [kotoba.lang.text :as text]))

(defn registry
  "A registry's own state: who it is and what it has issued."
  [identity community {:keys [first-number ttl] :or {first-number 1000 ttl (* 365 24 3600)}}]
  {:identity identity
   :community community
   :ttl ttl
   :names {}          ; local name → {:subject hex :not-after t}
   :numbers {}        ; short number string → subject hex
   :by-subject {}     ; subject hex → {:name … :number …}
   :next-number first-number})

(defn- valid-name? [s]
  (and (string? s) (<= 1 (count s) 32)
       ;; Any script is allowed (田中, tanaka, Танака); only the characters
       ;; the address syntax itself uses, and whitespace, are not.
       (re-matches #"[^\s@#/.][^\s@#/]*" s)))

(defn claim
  "Issue `local-name` (and a short number) to `subject` (a root public
  identity or hex). Answers `[registry signed-claim]` or `[registry {:error …}]`.
  Renewing for the same subject keeps their number."
  [reg subject local-name now]
  (let [subj (core/hex-of subject)
        holder (get-in reg [:names local-name])]
    (cond
      (not (valid-name? local-name))
      [reg {:error :invalid-name}]

      (and holder (not= subj (:subject holder)) (> (:not-after holder) now))
      [reg {:error :name-taken}]

      :else
      (let [prior (get-in reg [:by-subject subj])
            number (or (:number prior) (str (:next-number reg)))
            reg (cond-> reg
                  (nil? (:number prior)) (update :next-number inc)
                  (and prior (not= local-name (:name prior))) (update :names dissoc (:name prior)))
            not-after (+ now (:ttl reg))
            signed (st/sign (:identity reg)
                            {:nafuda/kind :name
                             :nafuda/community (:community reg)
                             :nafuda/name local-name
                             :nafuda/number number
                             :nafuda/subject subj
                             :nafuda/not-before now
                             :nafuda/not-after not-after})]
        [(-> reg
             (assoc-in [:names local-name] {:subject subj :not-after not-after})
             (assoc-in [:numbers number] subj)
             (assoc-in [:by-subject subj] {:name local-name :number number}))
         signed]))))

(defn e164-binding
  "A gateway's statement that `subject` controls the PSTN number `e164`
  (verified out of band, e.g. by an SMS code)."
  [gateway subject e164 now ttl]
  (st/sign gateway {:nafuda/kind :e164
                    :nafuda/e164 e164
                    :nafuda/subject (core/hex-of subject)
                    :nafuda/not-before now
                    :nafuda/not-after (+ now ttl)}))

(defn parse-address
  "`\"tanaka@yamanaka\"` → `{:name \"tanaka\" :community \"yamanaka\"}`,
  `\"#yamanaka/4021\"` → `{:number \"4021\" :community \"yamanaka\"}`,
  `\"+81…\"` → `{:e164 …}`."
  [s]
  (cond
    (text/starts-with? s "+") {:e164 s}
    (text/starts-with? s "#") (let [[c n] (text/split (subs s 1) #"/")]
                                (when (and c n) {:community c :number n}))
    :else (let [[n c] (text/split s #"@")]
            (when (and n c) {:name n :community c}))))

(defn resolve-address
  "The subject (root hex) an address names, according to the `claims` we hold
  and the registries we trust: `trusted` maps community → registry public hex
  (and :e164 → a set of trusted gateway hexes). nil when nothing valid matches."
  [trusted claims address now]
  (let [a (parse-address address)
        ok? (fn [s]
              (let [m (:statement s)]
                (and (st/valid? s) (st/in-force? s now)
                     (if (:e164 a)
                       (and (= :e164 (:nafuda/kind m))
                            (= (:e164 a) (:nafuda/e164 m))
                            (contains? (set (:e164 trusted)) (:nafuda/signer m)))
                       (and (= :name (:nafuda/kind m))
                            (= (:community a) (:nafuda/community m))
                            (= (get trusted (:community a)) (:nafuda/signer m))
                            (if (:number a)
                              (= (:number a) (:nafuda/number m))
                              (= (:name a) (:nafuda/name m))))))))]
    (when a
      (some->> claims (filter ok?) (sort-by #(get-in % [:statement :nafuda/not-before])) last
               :statement :nafuda/subject))))

;; ---------------------------------------------------------------------------
;; Petnames — the user's own names for people, which nobody else can change

(defn petnames [] {})

(defn set-petname [book subject name] (assoc book (core/hex-of subject) name))

(defn petname [book subject] (get book (core/hex-of subject)))

(defn display-name
  "What to show for a caller: the petname if we gave one, else the
  registry-qualified name, else a short fingerprint flagged as unknown."
  [book claims trusted subject now]
  (let [subj (core/hex-of subject)]
    (or (some-> (petname book subj) (vector :petname))
        (some (fn [s]
                (let [m (:statement s)]
                  (when (and (= :name (:nafuda/kind m)) (= subj (:nafuda/subject m))
                             (= (get trusted (:nafuda/community m)) (:nafuda/signer m))
                             (st/valid? s) (st/in-force? s now))
                    [(str (:nafuda/name m) "@" (:nafuda/community m)) :registry])))
              claims)
        [(str "?" (subs subj 0 8)) :unknown])))
