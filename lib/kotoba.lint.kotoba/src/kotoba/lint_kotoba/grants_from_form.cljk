(ns kotoba.lint-kotoba.grants-from-form
  "grants-from-form -- addressed on its own.

  Split out of kotoba.lang.lint-kotoba on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  )

(defn grants-from-form
  "If `form` is a map with :grants, return the granted capability strings."
  [form]
  (when (map? form)
    (let [g (:grants form)]
      (cond
        (sequential? g) (set (map str g))
        (set? g)        (set (map str g))
        :else #{}))))
