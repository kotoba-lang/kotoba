;; Port of kotoba.lint-kotoba.grants-from-form (grants_from_form.cljk), Kotoba-native.
;;
;; Named divergences from grants_from_form.cljk:
;;   - a non-map form returns document-null (nil in the source).
;;   - :grants that is neither a vector, list nor set reads as the empty set.
;;   - the result is a :document set of strings: each granted item is taken as
;;     (str item). Kotoba has no dynamic set constructor, so the set is read back
;;     with document-edn-read from the members' canonical EDN text, with
;;     duplicates removed first.
;;   - a list or set cannot be indexed in Kotoba (indexing traps at run time), so
;;     its canonical EDN text is re-read as a vector before iteration.

(ns kotoba.lint-kotoba.grants-from-form
  (:export [grants-from-form]))

(defn- kind-of [d :document] :string
  (keyword-name (document-kind d)))

(defn- at [xs :document i :i64] :document
  (option-or (document-vector-at xs i) (document-null)))

(defn- as-vector [g :document] :document
  (let [k (kind-of g)]
    (if (string=? k "vector")
      g
      (let [t (document-edn-print g)
            n (string-length t)
            inner (if (string=? k "set")
                    (string-substring t 2 (- n 1))
                    (string-substring t 1 (- n 1)))]
        (document-edn-read (string-concat (string-concat "[" inner) "]"))))))

(defn- item-text [x :document] :string
  (let [k (kind-of x)]
    (if (string=? k "string")
      (option-or (document-string-value x) "")
      (if (string=? k "keyword")
        (string-concat ":" (keyword-name (option-or (document-keyword-value x) :none)))
        (if (string=? k "i64")
          (string-from-i64 (option-or (document-i64-value x) 0))
          (if (string=? k "null")
            ""
            (document-edn-print x)))))))

(defn- string-members [g :document] :document
  (let [n (document-count g)]
    (loop [i 0 acc (document-vector)]
      (if (>= i n)
        acc
        (recur (+ i 1) (document-vector-conj acc (document-string (item-text (at g i)))))))))

(defn- edn-set [members :document] :document
  (let [n (document-count members)]
    (loop [i 0 seen "\n" out ""]
      (if (>= i n)
        (document-edn-read (string-concat (string-concat "#{" out) "}"))
        (let [t (document-edn-print (at members i))]
          (if (string-contains? seen (string-concat (string-concat "\n" t) "\n"))
            (recur (+ i 1) seen out)
            (recur (+ i 1) (string-concat (string-concat seen t) "\n") (string-concat (string-concat out " ") t))))))))

(defn grants-from-form [form :document] :document
  (if (string=? (kind-of form) "map")
    (let [g (option-or (document-get form :grants) (document-null))
          k (kind-of g)]
      (if (or (string=? k "vector") (or (string=? k "list") (string=? k "set")))
        (edn-set (string-members (as-vector g)))
        (edn-set (document-vector))))
    (document-null)))
