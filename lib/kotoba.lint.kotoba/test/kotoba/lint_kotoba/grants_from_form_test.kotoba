(ns kotoba.lint-kotoba.grants-from-form-test
  (:export [main])
  (:require [kotoba.lint-kotoba.grants-from-form :as g]))

(defn- kind-of [d :document] :string
  (keyword-name (document-kind d)))

(defn- size [s :document] :i64
  (document-count s))

(defn main [] :i64
  (let [r1 (g/grants-from-form
            (document-map :grants (document-vector (document-string "read") (document-keyword :write) (document-i64 7))))
        r2 (g/grants-from-form (document-map :grants (document-vector (document-string "x") (document-string "x") (document-string "y"))))
        r3 (g/grants-from-form (document-map :grants (document-set (document-keyword :s1) (document-keyword :s2))))
        r4 (g/grants-from-form (document-vector (document-string "read")))
        r5 (g/grants-from-form (document-map :other (document-i64 1)))
        r6 (g/grants-from-form (document-map :grants (document-string "read")))]
    (+ (if (= (size r1) 3) 0 1)
       (if (document-set-contains? r1 (document-string "read")) 0 1)
       (if (document-set-contains? r1 (document-string ":write")) 0 1)
       (if (document-set-contains? r1 (document-string "7")) 0 1)
       (if (= (size r2) 2) 0 1)
       (if (= (size r3) 2) 0 1)
       (if (string=? (kind-of r4) "null") 0 1)
       (if (= (size r5) 0) 0 1)
       (if (= (size r6) 0) 0 1))))
