{:paths ["src"]
 ;; datom-source is the only runtime dependency, and it is itself zero-dep
 ;; portable .cljc. It is here rather than reimplemented because
 ;; `IPatternSource` is the declared seam every kotobase query path plugs
 ;; into -- a second definition of that protocol would be a second thing for
 ;; a query surface to fail to recognise.
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/columnar {:local/root "../kotoba.columnar"}
        io.github.kotoba-lang/datom-source {:local/root "../kotoba.datomSource"}
        io.github.kotoba-lang/org-w3-nquads {:local/root "../org.w3.nquads"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; The same portable suite under real ClojureScript. Not a duplicate of the
  ;; JVM run: `sniff/prefix` has a reader conditional per platform, and the
  ;; runtime this library actually deploys on (a Worker) is the cljs one.
  :cljs {:extra-paths ["test"]
         :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
