;; No dependencies. PTP is a 34-byte header, a handful of 10/20/30-byte
;; bodies, and 48/64-bit big-endian integer arithmetic; a leaf that dragged
;; a socket or a clock-servo loop behind it would defeat the point.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
