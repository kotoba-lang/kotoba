{:paths ["src"]
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/process {:local/root "../kotoba.process"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; kotoba-lang/amu is a TEST-ONLY dependency, for the tests that
         ;; compile src/kotoba/cartpole_math.kotoba and require it to agree with the
         ;; restored .cljc load path (ADR 0001 as amended, and ADR-2608133600 in
         ;; com-junkawasaki/root). kotoba-lang/webgpu requires kami.cartpole-math and
         ;; must not be made to drag a compiler in behind it — kotoba-lang/css,
         ;; /dsl-core, /async and /postfx set the same boundary.
         :extra-deps {
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "e4dfcbc006f0749d88db8f2d710446a2d4459808"}}}}}
