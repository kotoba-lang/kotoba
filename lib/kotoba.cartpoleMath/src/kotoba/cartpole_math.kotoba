(ns kotoba.cartpole-math
  (:export [main step-x step-x-dot step-theta step-theta-dot
            canonical-x canonical-x-dot canonical-theta canonical-theta-dot]))

;; cfg   = [cart-mass pole-mass pole-half-length gravity force-mag dt]
;; state = [x x-dot theta theta-dot]

(defn main [] :i64 0)

(defn clamp [value :f64 lower :f64 upper :f64] :f64
  (f64-max lower (f64-min upper value)))

(defn theta-acc [cfg :vector-f64 state :vector-f64 action :f64] :f64
  (let [cart-mass (vector-f64-at cfg 0)
        pole-mass (vector-f64-at cfg 1)
        pole-half-length (vector-f64-at cfg 2)
        gravity (vector-f64-at cfg 3)
        force-mag (vector-f64-at cfg 4)
        theta (vector-f64-at state 2)
        theta-dot (vector-f64-at state 3)
        force (clamp action (f64-sub 0.0 force-mag) force-mag)
        sin-t (f64-sin-bounded theta)
        cos-t (f64-cos-bounded theta)
        total (f64-add cart-mass pole-mass)
        pml (f64-mul pole-mass pole-half-length)
        angular-force (f64-mul pml (f64-mul theta-dot (f64-mul theta-dot sin-t)))
        temp (f64-div (f64-add force angular-force) total)
        numerator (f64-sub (f64-mul gravity sin-t) (f64-mul cos-t temp))
        mass-term (f64-div (f64-mul pole-mass (f64-mul cos-t cos-t)) total)
        denominator (f64-mul pole-half-length
                             (f64-sub (f64-div 4.0 3.0) mass-term))]
    (f64-div numerator denominator)))

(defn x-acc [cfg :vector-f64 state :vector-f64 action :f64] :f64
  (let [cart-mass (vector-f64-at cfg 0)
        pole-mass (vector-f64-at cfg 1)
        pole-half-length (vector-f64-at cfg 2)
        force-mag (vector-f64-at cfg 4)
        theta (vector-f64-at state 2)
        theta-dot (vector-f64-at state 3)
        force (clamp action (f64-sub 0.0 force-mag) force-mag)
        sin-t (f64-sin-bounded theta)
        cos-t (f64-cos-bounded theta)
        total (f64-add cart-mass pole-mass)
        pml (f64-mul pole-mass pole-half-length)
        angular-force (f64-mul pml (f64-mul theta-dot (f64-mul theta-dot sin-t)))
        temp (f64-div (f64-add force angular-force) total)
        acceleration (theta-acc cfg state action)
        correction (f64-div (f64-mul pml (f64-mul acceleration cos-t)) total)]
    (f64-sub temp correction)))

(defn step-x-dot [cfg :vector-f64 state :vector-f64 action :f64] :f64
  (let [dt (vector-f64-at cfg 5)
        x-dot (vector-f64-at state 1)]
    (f64-add x-dot (f64-mul dt (x-acc cfg state action)))))

(defn step-x [cfg :vector-f64 state :vector-f64 action :f64] :f64
  (let [dt (vector-f64-at cfg 5)
        x (vector-f64-at state 0)]
    (f64-add x (f64-mul dt (step-x-dot cfg state action)))))

(defn step-theta-dot [cfg :vector-f64 state :vector-f64 action :f64] :f64
  (let [dt (vector-f64-at cfg 5)
        theta-dot (vector-f64-at state 3)]
    (f64-add theta-dot (f64-mul dt (theta-acc cfg state action)))))

(defn step-theta [cfg :vector-f64 state :vector-f64 action :f64] :f64
  (let [dt (vector-f64-at cfg 5)
        theta (vector-f64-at state 2)]
    (f64-add theta (f64-mul dt (step-theta-dot cfg state action)))))

(defn canonical-x [] :f64
  (step-x (vector-f64 1.0 0.1 0.5 9.8 10.0 0.02)
          (vector-f64 0.0 0.0 0.2 0.0) 1.0))
(defn canonical-x-dot [] :f64
  (step-x-dot (vector-f64 1.0 0.1 0.5 9.8 10.0 0.02)
              (vector-f64 0.0 0.0 0.2 0.0) 1.0))
(defn canonical-theta [] :f64
  (step-theta (vector-f64 1.0 0.1 0.5 9.8 10.0 0.02)
              (vector-f64 0.0 0.0 0.2 0.0) 1.0))
(defn canonical-theta-dot [] :f64
  (step-theta-dot (vector-f64 1.0 0.1 0.5 9.8 10.0 0.02)
                  (vector-f64 0.0 0.0 0.2 0.0) 1.0))
