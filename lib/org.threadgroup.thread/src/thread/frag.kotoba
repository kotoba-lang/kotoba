(ns q9probe3.c17)
;; hand-port of thread.frag whole surface (build-frag1, build-fragn, parse-frag1, parse-fragn)
;; encoded: status-code integer tagged int-vector results; quot/mul replaces shifts.
;; This is the kotoba entry candidate for orgs/kotoba-lang/org-threadgroup-thread whole-component frag slice.
(defn build-frag1 [datagram-size datagram-tag]
  (if (not (<= 0 datagram-size 2047))
    [0 datagram-size]
    (if (not (<= 0 datagram-tag 65535))
      [0 datagram-tag]
      [(bit-or 192 (bit-and (quot datagram-size 256) 7))
       (bit-and datagram-size 255)
       (bit-and (quot datagram-tag 256) 255)
       (bit-and datagram-tag 255)])))
(defn build-fragn [datagram-size datagram-tag datagram-offset]
  (if (not (<= 0 datagram-size 2047))
    [0 datagram-size]
    (if (not (<= 0 datagram-tag 65535))
      [0 datagram-tag]
      (if (not (<= 0 datagram-offset 255))
        [0 datagram-offset]
        [(bit-or 224 (bit-and (quot datagram-size 256) 7))
         (bit-and datagram-size 255)
         (bit-and (quot datagram-tag 256) 255)
         (bit-and datagram-tag 255)
         (bit-and datagram-offset 255)]))))
(defn parse-frag1 [b0 b1 b2 b3]
  (if (not (= 192 (bit-and b0 248)))
    [0 b0]
    [1 (+ (* (bit-and b0 7) 256) b1) (+ (* b2 256) b3)]))
(defn parse-fragn [b0 b1 b2 b3 b4]
  (if (not (= 224 (bit-and b0 248)))
    [0 b0]
    [1 (+ (* (bit-and b0 7) 256) b1) (+ (* b2 256) b3) b4]))
(defn main [] 0)
