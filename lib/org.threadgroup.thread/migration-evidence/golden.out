build-frag1 {:datagram-size 100, :datagram-tag 7} => [:ok [192 100 0 7]]
build-frag1 {:datagram-size 2047, :datagram-tag 65535} => [:ok [199 255 255 255]]
build-frag1 {:datagram-size 2048, :datagram-tag 1} => [:error :thread.frag/datagram-size-out-of-range 2048]
build-frag1 {:datagram-size 5, :datagram-tag 65536} => [:error :thread.frag/datagram-tag-out-of-range 65536]
parse-frag1 [[192 100 0 7]] => [:ok {:datagram-size 100, :datagram-tag 7} 4]
parse-frag1 [[192 100 255 255]] => [:ok {:datagram-size 100, :datagram-tag 65535} 4]
parse-frag1 [[224 100 0 7]] => [:error :thread.frag/not-frag1-dispatch 224]
parse-frag1 [[193 0 0 0]] => [:ok {:datagram-size 256, :datagram-tag 0} 4]
parse-frag1 [[192 100 0]] => [:error :thread.frag/header-too-short 3]
build-fragn {:datagram-size 100, :datagram-tag 7, :datagram-offset 3} => [:ok [224 100 0 7 3]]
build-fragn {:datagram-size 2047, :datagram-tag 65535, :datagram-offset 255} => [:ok [231 255 255 255 255]]
build-fragn {:datagram-size 100, :datagram-tag 7, :datagram-offset 256} => [:error :thread.frag/datagram-offset-out-of-range 256]
parse-fragn [[224 100 0 7 3]] => [:ok {:datagram-size 100, :datagram-tag 7, :datagram-offset 3} 5]
parse-fragn [[225 0 0 0 0]] => [:ok {:datagram-size 256, :datagram-tag 0, :datagram-offset 0} 5]
parse-fragn [[224 100 0 7]] => [:error :thread.frag/header-too-short 4]
