{:paths ["src"]
 ;; rdf.validate uses dsl-core's shared kotoba.dsl.problem convention for
 ;; structural-validation problem maps (domain :rdf); otherwise zero
 ;; third-party runtime deps — every namespace is portable .cljc.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/dsl-core {:local/root "../kotoba.dslCore"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
