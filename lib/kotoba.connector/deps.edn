{:paths ["src"]
 ;; org-anthropic-mcp is the only runtime dependency and only `connector.mcp`
 ;; uses it. It is a sibling kernel in this org rather than a third-party
 ;; library, and the alternative — re-deriving its `:mcp/*` manifest shape here
 ;; — is how one contract acquires two spellings.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/org-anthropic-mcp {:local/root "../com.anthropic.mcp"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
