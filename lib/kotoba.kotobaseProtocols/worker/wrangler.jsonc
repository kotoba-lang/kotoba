// kotobase-git — Cloudflare Worker serving git.kotobase.net (the CLJC
// kotobase Git projection transport shell, ADR-2607174500/2607176000).
// This wrangler.jsonc did not previously exist in this repo (the worker was
// deployed directly, e.g. via `wrangler deploy` from a local checkout) —
// reconstructed here from the LIVE worker's actual bindings/routes/cron
// (read via the Cloudflare API before this file was written, to avoid
// dropping or recreating any resource on deploy). ADMIN_TOKEN is an
// existing Worker secret, not declared here — `wrangler deploy` never
// touches secrets it isn't asked to set.
{
  "name": "kotobase-git",
  "main": "git-worker.mjs",
  "compatibility_date": "2026-07-17",
  "routes": [
    { "pattern": "git.kotobase.net", "custom_domain": true }
  ],
  "d1_databases": [
    { "binding": "GIT_DB", "database_id": "f431818a-daa9-44ba-a291-b9df0b696052" }
  ],
  "r2_buckets": [
    { "binding": "GIT_OBJECTS", "bucket_name": "kotobase-git-objects" }
  ],
  "kv_namespaces": [
    { "binding": "GIT_STORE", "id": "222cfc5a53f24c59942b65e2a467186a" }
  ],
  "queues": {
    "producers": [
      { "binding": "KAIZEN_EVENTS", "queue": "murakumo-kaizen" }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "SERVICE_VERSION": "0.1.0",
    // Repos (comma-separated "org/repo" strings, plain names — not
    // secrets) whose git.kotobase.net GET/HEAD traffic now requires the
    // same ADMIN_TOKEN bearer a write already needs. Every other repo
    // keeps the surface's original public-read design untouched.
    "PRIVATE_GIT_REPO_PREFIXES": "jk-luxury/club-shinshi-kaizen",
    // Repos (comma-separated "org/repo") whose reads are x402-paywalled:
    // anonymous agents pay per read (USDC on Base, KOTOBASE_TREASURY_ADDR —
    // a Worker SECRET, set via `wrangler secret put`); authorized Base wallet
    // CACAOs (x-git-cacao) and the admin bearer read free. Empty = no paywall.
    "PAID_GIT_REPOS": "fabric-witness/paid-e2e"
  }
}
