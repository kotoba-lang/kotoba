(ns vdesign.fatigue-test
  "Tests for vdesign.fatigue — exact identities on synthetic fixtures
  (fixture numbers carry fixture provenance; no Mg/MgH2, PEM, vehicle,
  or material constant is measured or invented here)."
  (:require [kotoba.test :refer [deftest is testing]]
            [vdesign.fatigue :as f]))

(def ^:private sn-src "fixture: synthetic S-N curve for tests only")
(def ^:private spec-src "fixture: synthetic load spectrum for tests only")

;; log-log exact by construction: (100,1e6) → (200,1e4). Two decades of
;; stress, four decades of life.
(def ^:private curve
  [{:stress-mpa 100.0 :cycles 1.0e6}
   {:stress-mpa 200.0 :cycles 1.0e4}])

(defn- screen [curve bins]
  (f/fatigue-screen {:sn-curve curve :sn-source sn-src
                     :load-spectrum bins :spectrum-source spec-src}))

(defn- throws? [f]
  (try (f) false (catch :default _ true)))

(deftest log-log-interpolation-is-exact-at-curve-points
  (let [r (screen curve [{:stress-amp-mpa 200.0 :cycles 5.0e3}])]
    (is (< (Math/abs (- (:cycles-to-failure (nth (:bins r) 0)) 1.0e4)) 1e-9))
    (is (< (Math/abs (- (:damage-total r) 0.5)) 1e-12))
    (is (= :ok (:verdict r)))))

(deftest geometric-midpoint-interpolates-to-geometric-mean-life
  (let [s (Math/sqrt (* 100.0 200.0))       ; log-midpoint of the curve
        r (screen curve [{:stress-amp-mpa s :cycles 1.0e5}])]
    (is (< (Math/abs (- (:cycles-to-failure (nth (:bins r) 0)) 1.0e5)) 1e-6))
    (is (< (Math/abs (- (:damage-total r) 1.0)) 1e-12))
    (is (= :at-limit (:verdict r)))))

(deftest multi-bin-damage-sums-and-exceeds
  ;; 1 damage unit total: 0.25 at 200 MPa + 0.75 at ~141.42 MPa
  (let [s (Math/sqrt (* 100.0 200.0))
        r (screen curve [{:stress-amp-mpa 200.0 :cycles 2.5e3}
                         {:stress-amp-mpa s :cycles 7.5e4}])]
    (is (= 2 (count (:bins r))))
    (is (< (Math/abs (- (:damage-total r) 1.0)) 1e-12))
    (is (= :at-limit (:verdict r))))
  (let [s (Math/sqrt (* 100.0 200.0))
        r (screen curve [{:stress-amp-mpa 200.0 :cycles 5.0e3}
                         {:stress-amp-mpa s :cycles 1.5e5}])]
    (is (> (:damage-total r) 1.0))
    (is (= :exceeded (:verdict r)))))

(deftest curve-point-at-low-end-is-honoured
  (let [r (screen curve [{:stress-amp-mpa 100.0 :cycles 1.0e6}])]
    (is (< (Math/abs (- (:damage-total r) 1.0)) 1e-12))
    (is (= :at-limit (:verdict r)))))

(deftest provenance-is-echoed-and-unmeasured-listed
  (let [r (screen curve [{:stress-amp-mpa 200.0 :cycles 1.0}])]
    (is (= sn-src (:sn-source r)))
    (is (= spec-src (:spectrum-source r)))
    (is (= [100.0 200.0] (:sn-stress-range-mpa r)))
    (is (contains? (set (:unmeasured r)) :mean-stress-effects))
    (is (contains? (set (:unmeasured r)) :scatter/life-factor))))

(deftest refuses-extrapolation-outside-curve-range
  (is (throws? #(screen curve [{:stress-amp-mpa 300.0 :cycles 1.0e3}])))
  (is (throws? #(screen curve [{:stress-amp-mpa  50.0 :cycles 1.0e6}]))))

(deftest refuses-blank-or-missing-provenance
  (is (throws? #(f/fatigue-screen {:sn-curve curve :sn-source "  "
                                   :load-spectrum [{:stress-amp-mpa 200.0 :cycles 1.0}]
                                   :spectrum-source spec-src})))
  (is (throws? #(f/fatigue-screen {:sn-curve curve
                                   :load-spectrum [{:stress-amp-mpa 200.0 :cycles 1.0}]
                                   :spectrum-source spec-src}))))

(deftest refuses-empty-and-malformed-inputs
  (is (throws? #(screen [] [{:stress-amp-mpa 200.0 :cycles 1.0}])))
  (is (throws? #(screen curve [])))
  (is (throws? #(screen [{:stress-mpa 200.0 :cycles 1.0e4}
                         {:stress-mpa 200.0 :cycles 1.0e4}] ; duplicate stress
                        [{:stress-amp-mpa 200.0 :cycles 1.0}])))
  (is (throws? #(screen curve [{:stress-amp-mpa 200.0 :cycles 0.0}])))
  (is (throws? #(screen curve [{:stress-amp-mpa -1.0 :cycles 1.0}])))
  (is (throws? #(screen curve [{:stress-amp-mpa (Math/NaN) :cycles 1.0}]))))
