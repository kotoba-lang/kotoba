{:paths ["src"]
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/process {:local/root "../kotoba.process"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; kotoba-lang/amu is a TEST-ONLY dependency: it is needed by the tests
         ;; that compile src/kotoba/rtx_native.kotoba and require it to agree with
         ;; src/kotoba/rtx_native.cljk (ADR 0001 as amended, and ADR-2608134800 in
         ;; com-junkawasaki/root). Consumers require only the .cljc and must not be
         ;; made to drag the compiler in behind it — kotoba-lang/css, /dsl-core,
         ;; /async and /postfx set the same boundary.
         :extra-deps {
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "16215e00e8709a54b260477ef440129e26b07595"}}}}}
