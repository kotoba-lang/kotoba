{:paths ["src" "resources"]
 ;; Git coordinates, not :local/root — a downstream consumer pulling this repo
 ;; as a git dep cannot resolve a sibling path inside ~/.gitlibs. The :local
 ;; alias is the sibling-checkout workflow (same contract as byoubu-ui).
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/mokuroku {:local/root "../kotoba.mokuroku"}
        io.github.kotoba-lang/kotoba-ui {:local/root "../kotoba.kotobaUi"}
        io.github.kotoba-lang/appkit {:local/root "../kotoba.appkit"}}
 :aliases
 {:test {:extra-paths ["test"]}

  :local {:override-deps {io.github.kotoba-lang/mokuroku {:local/root "../mokuroku"}
                          io.github.kotoba-lang/kotoba-ui {:local/root "../kotoba-ui"}
                          io.github.kotoba-lang/appkit {:local/root "../appkit"}
                          io.github.kotoba-lang/design-quality
                          {:local/root "../design-quality"}}}
}}
