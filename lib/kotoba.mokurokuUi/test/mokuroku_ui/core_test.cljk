(ns mokuroku-ui.core-test
  (:require [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]]
            [design-quality.audit :as dq]
            [mokuroku.catalog :as catalog]
            [mokuroku.item :as item]
            [mokuroku.source :as source]
            [mokuroku-ui.core :as mui]))

(def descriptor
  (source/descriptor
   {:id :test/tracks
    :item-kind :track
    :label "Library"
    :capability "media/library"
    :commands #{:play :trash}
    :attributes [(source/attribute :title "Title" :string)
                 (source/attribute :duration "Time" :duration)
                 (source/attribute :size "Size" :bytes)
                 (source/attribute :artist "Artist" :string)
                 (source/attribute :path "Path" :string false)]}))

(def items
  [(item/item "1" :track "Kind of Blue" {:title "Kind of Blue" :duration 545
                                         :size 13421772 :artist "Miles Davis"
                                         :path "/m/1"})
   (item/item "2" :track "Blue in Green" {:title "Blue in Green" :duration 337
                                          :size 8388608 :artist "Miles Davis"
                                          :path "/m/2"})])

(defn- make-cat []
  (catalog/refresh (catalog/catalog (source/memory-source descriptor items))))

(deftest formatters
  (testing "bytes"
    (is (= "1.0 KB" (mui/human-bytes 1024))
        "one decimal below 100, so 1.0 KB and 1.9 KB are distinguishable")
    (is (= "12.8 MB" (mui/human-bytes 13421772)))
    (is (= "512 B" (mui/human-bytes 512)))
    (is (nil? (mui/human-bytes nil)) "absent stays absent, it does not become 0"))

  (testing "duration"
    (is (= "9:05" (mui/human-duration 545)))
    (is (= "5:37" (mui/human-duration 337)))
    (is (= "1:00:00" (mui/human-duration 3600)))
    (is (= "0:07" (mui/human-duration 7)) "seconds under ten are padded"))

  (testing "percent"
    (is (= "12.5%" (mui/percent 12.5))))

  (testing "the default renderer says absent rather than showing an empty cell"
    (is (= "--" (mui/plain nil)))
    (is (= "file" (mui/plain :file)))
    (is (= "Yes" (mui/plain true)))))

(deftest columns-come-from-the-descriptor
  (testing "the default is the first three sortable attributes, in declared order"
    ;; Three, because a row wider than that stops being scannable. The app
    ;; controls which three by ordering its descriptor.
    (let [html (mui/->html (catalog/view (make-cat)) {})]
      (is (str/includes? html "Kind of Blue"))
      (is (str/includes? html "9:05"))
      (is (str/includes? html "12.8 MB"))
      (is (not (str/includes? html "Miles Davis"))
          "artist is the fourth sortable attribute, so it is not a default column")))

  (testing "an unsortable attribute is never a default column"
    ;; :path is declared unsortable. If it leaked in, the user would get a
    ;; column header that cannot do what every other header does.
    (is (not (str/includes? (mui/->html (catalog/view (make-cat)) {}) "/m/1"))))

  (testing "an app can name its own columns"
    (let [html (mui/->html (catalog/view (make-cat)) {:columns [:title :artist]})]
      (is (str/includes? html "Miles Davis"))
      (is (not (str/includes? html "12.8 MB"))))))

(deftest values-are-formatted-by-declared-type
  (let [html (mui/->html (catalog/view (make-cat)) {})]
    (is (str/includes? html "9:05") "duration, not 545")
    (is (str/includes? html "12.8 MB") "bytes, not 13421772")))

(deftest the-empty-state-names-the-capability
  ;; A catalog that was never refreshed is what an app looks like before a
  ;; grant arrives. It must not be indistinguishable from an empty library.
  (let [html (mui/->html (catalog/view (catalog/catalog (source/memory-source descriptor [])))
                         {})]
    (is (str/includes? html "media/library"))
    (is (str/includes? html "Waiting on"))))

(deftest the-status-line-reports-what-it-hid
  (let [c (catalog/set-query (make-cat) {:query/limit 1})
        html (mui/->html (catalog/view c) {:noun "tracks"})]
    (is (str/includes? html "1 of 2"))
    (is (str/includes? html "tracks"))))

(deftest destructive-commands-are-marked-before-the-click
  (let [html (mui/->html (catalog/view (catalog/select (make-cat) "1")) {})]
    (is (str/includes? html "mokuroku__command--destructive"))
    (is (str/includes? html "Asks for confirmation"))))

(deftest selection-is-announced-not-just-coloured
  ;; A CSS class tells the eye and nothing else. aria-selected belongs on the
  ;; element carrying role="listitem", and this test is what proves it gets
  ;; there — the :attrs opt it relies on was added to liquid-glass/list-row
  ;; for this, and before that a passed attrs map was silently dropped.
  (let [selected (mui/->html (catalog/view (catalog/select (make-cat) "1")) {})]
    (is (str/includes? selected "aria-selected=\"true\"")
        "the selected row says so to a screen reader")
    (is (str/includes? selected "aria-selected=\"false\"")
        "and the unselected row says that, rather than saying nothing")
    (is (str/includes? selected "mokuroku__row--selected")
        "the class is still there for the eye"))

  (testing "the row keeps its own role and act"
    (let [html (mui/->html (catalog/view (catalog/select (make-cat) "1")) {})]
      (is (str/includes? html "role=\"listitem\""))
      (is (str/includes? html "data-act")))))

(deftest the-detail-slot-draws-the-thing-and-not-the-row-about-it
  ;; What every app in this suite needs and none of them could have without
  ;; composing its own window: Photos shows the photograph, Music the album
  ;; art, Preview the page.
  (let [drawn (mui/->html (catalog/view (catalog/select (make-cat) "1"))
                          {:detail (fn [view]
                                     (when-let [id (first (:selection/ids
                                                           (:view/selection view)))]
                                       [:p {:class "the-thing"} (str "drawn " id)]))})]
    (is (str/includes? drawn "drawn 1"))
    (is (str/includes? drawn "the-thing"))
    (testing "and it still draws the listing underneath"
      (is (str/includes? drawn "mokuroku__row"))))

  (testing "nothing is added when the app supplies no detail"
    (let [plain (mui/->html (catalog/view (catalog/select (make-cat) "1")) {})]
      (is (not (str/includes? plain "the-thing")))))

  (testing "and a detail that declines to draw leaves no empty panel"
    ;; A blank card under the toolbar reads as something that failed to
    ;; load, which is a worse answer than the space the listing gets back.
    (let [before (mui/->html (catalog/view (make-cat)) {})
          after (mui/->html (catalog/view (make-cat)) {:detail (constantly nil)})]
      (is (= before after)))))

(deftest window-meets-the-design-quality-floor
  (let [pages {"listing" (mui/->page (catalog/view (make-cat)) {:title "Library"})
               "selection" (mui/->page (catalog/view (catalog/select-all (make-cat)))
                                       {:title "Library"})
               "awaiting-grant" (mui/->page
                                 (catalog/view (catalog/catalog
                                                (source/memory-source descriptor [])))
                                 {:title "Library"})}
        {:keys [overall pages] :as report} (dq/audit pages {:extra-axes dq/extra-axes})]
    (println "design-quality: aggregate" overall)
    (doseq [[nm r] (sort-by key pages)]
      (println " " nm (:overall r)
               (pr-str (mapv :id (remove #(>= (:score %) 1.0) (:axes r))))))
    (is (>= overall 98.0) (pr-str (:findings report)))
    (doseq [[nm r] pages]
      (is (>= (:overall r) 98.0) nm))))

(deftest the-shared-css-spends-tokens-not-literals
  (is (not (re-find #"#[0-9a-fA-F]{3,8}" mui/app-css)))
  (is (not (re-find #"font-size\s*:\s*\d+px" mui/app-css)))
  (testing "the accent in the default theme is the one legitimate hex"
    (is (re-find #"^#[0-9A-F]{6}$" (:accent mui/default-theme)))))
