{:paths ["src"]
 ;; Zero third-party runtime deps. Request/wire namespaces are portable .cljc;
 ;; the embedded GGUF reader is JVM-specific.
 ;; A vLLM inference request IS data (:vllm/* maps); the library renders it to the
 ;; OpenAI/vLLM wire shape (string-keyed maps) and normalizes responses. The actual
 ;; HTTP + JSON (de)serialization is a host-injected ITransport port.
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/json {:local/root "../kotoba.json"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}
  :real-gguf-verify
  {:extra-paths ["test"]
   :jvm-opts ["-Xms128m" "-Xmx512m"]
   :main-opts ["-m" "vllm.real-gguf-verify"]}
  :metal-worker-verify
  {:extra-paths ["test"]
   :jvm-opts ["-Xms64m" "-Xmx256m"]
   :main-opts ["-m" "vllm.metal-worker-verify"]}
  :real-metal-verify
  {:extra-paths ["test"]
   :jvm-opts ["-Xms128m" "-Xmx512m"]
   :main-opts ["-m" "vllm.real-metal-verify"]}
  :real-batch-verify
  {:extra-paths ["test"]
   :jvm-opts ["-Xms128m" "-Xmx512m"]
   :main-opts ["-m" "vllm.real-batch-verify"]}
  :real-continuous-verify
  {:extra-paths ["test"]
   :jvm-opts ["-Xms128m" "-Xmx512m"]
   :main-opts ["-m" "vllm.real-continuous-verify"]}
  :real-prefix-verify
  {:extra-paths ["test"]
   :jvm-opts ["-Xms128m" "-Xmx512m"]
   :main-opts ["-m" "vllm.real-prefix-verify"]}}}
