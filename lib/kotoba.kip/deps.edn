{:paths ["src"]
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.cognitect-labs/test-runner
    {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}

    ;; TEST-ONLY. The parity gate compiles kotoba/kip_gate_core.kotoba and runs
    ;; it against src/kotoba/kip/core.cljk; nothing in :paths depends on either
    ;; of these, and the library must stay usable from nbb.
    ;;
    ;; kotoba-lang/amu now lives at kotoba-lang/amu, hence the :git/url
    ;; override under the old coordinate. These two pins are advanced together —
    ;; they are the pair murakumo qualified as a unit, and a kir/amu mismatch
    ;; fails as a KIR shape error rather than as a version complaint.
    io.github.kotoba-lang/amu
    {:git/url "https://github.com/kotoba-lang/amu.git"
     :git/sha "1e21a1f56613d7d4c7628af1945ebf1cf7862ff3"}
    io.github.kotoba-lang/osaho
    {:git/url "https://github.com/kotoba-lang/osaho.git"
     :git/sha "6d08e3cffa09c003f8dbcdfaee964c4a1ea021ad"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}

  ;; The .cljc suite alone, with no compiler dependency — what runs where a
  ;; maven/git fetch is not available. It is a strict subset: passing it does
  ;; NOT mean the .kotoba core still agrees, which is what :test is for.
  :test-pure
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
   :main-opts ["-m" "cognitect.test-runner"
               "-n" "kotoba.kip.core-test"
               "-n" "kotoba.kip.registry-test"
               "-n" "kotoba.kip.quorum-test"]}

  :lint
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
   :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
