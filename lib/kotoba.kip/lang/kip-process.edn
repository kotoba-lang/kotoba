;; lang/kip-process.edn — the machine-normative KIP process authority.
;;
;; `kip` = **K**otoba **I**mprovement **P**roposal. This file is what the
;; validator reads; `kips/kip-0000.edn` is the human-readable statement of the
;; same process. When the two disagree, **this file wins** and kip-0000 is a
;; bug (the same split `kotoba-lang/kotoba-lang` uses between
;; `docs/lang/semantics-ssot.md` (human-normative) and `lang/guest-grammar.edn`
;; (machine-normative)).
;;
;; ## What this is NOT
;;
;; It is not a second decision log. `90-docs/adr/` in the superproject and
;; `docs/adr/` in each child repo keep recording decisions, and they stay the
;; place a decision is *written down*. A KIP is narrower and does one thing an
;; ADR structurally cannot: it puts a **pending** change to a normative surface
;; in a queue that someone other than its author can enumerate, object to, and
;; block. An ADR is written by the party that already decided.
;;
;; ## Why the states are the way they are
;;
;; EIP-1 and IPIP-0001 both converge on the same shape: a draft nobody has to
;; read, a review anyone may object during, a last call with a *clock* on it,
;; and a final that is expensive to change. The clock is the load-bearing part —
;; without a minimum interval, "last call" is a formality that closes whenever
;; the author is ready, which is the same as not having it.

{:kotoba.kip.process/version 1
 :kotoba.kip.process/authority "kotoba-lang/kip"
 :kotoba.kip.process/as-of "2026-08-16"
 :kotoba.kip.process/statement "kips/kip-0000.edn"

 ;; ---------------------------------------------------------------- numbering
 :numbering
 {:pattern "kips/kip-NNNN.edn"
  :width 4
  :first 0
  :monotonic true
  ;; A withdrawn or rejected number is spent. Reuse would make every external
  ;; citation of "KIP-17" ambiguous, which is the one thing the number is for.
  :reuse false}

 ;; ------------------------------------------------------------------- tracks
 :tracks
 {:standards
  {:meaning "Changes a normative surface — a file some implementation is
             required to agree with. Requires last call and quorum."
   :requires-last-call true
   :requires-quorum true}
  :process
  {:meaning "Changes how this workspace decides things (including this file).
             No last call: the editors are the affected party."
   :requires-last-call false
   :requires-quorum false}
  :informational
  {:meaning "Records a finding, a measurement, or guidance that nothing is
             required to conform to."
   :requires-last-call false
   :requires-quorum false}}

 ;; ------------------------------------------------------------------- states
 :states
 {:draft      {:terminal false :meaning "Written down. No one is obliged to read it."}
  :review     {:terminal false :meaning "Open for objection. Editors of every touched surface are on notice."}
  :last-call  {:terminal false :meaning "Objection window with a clock. Standards track only."}
  :final      {:terminal true  :meaning "Admitted. The touched surfaces may now change to match it."}
  :withdrawn  {:terminal true  :meaning "The author stopped. The number stays spent."}
  :rejected   {:terminal true  :meaning "An editor declined it. The number stays spent."}
  :superseded {:terminal true  :meaning "A later Final replaced it. Requires :kip/superseded-by."}}

 ;; -------------------------------------------------------------------- roles
 ;; `:editor` is not a standing committee. For a given KIP it is the set of
 ;; authority owners named by `lang/normative-surfaces.edn` for the surfaces
 ;; that KIP touches — so who may advance it is a function of what it changes,
 ;; not of who is on a list.
 :roles
 {:author {:meaning "Whoever wrote it. May advance draft->review and withdraw."}
  :editor {:meaning "Authority owner of a touched surface (see lang/normative-surfaces.edn)."}
  :quorum {:meaning "N distinct signers from the fleet governance allow-list."}}

 ;; -------------------------------------------------------------- transitions
 ;; [from to role] plus optional guards. A transition not listed here does not
 ;; exist; the validator does not infer.
 :transitions
 [{:from :draft      :to :review     :role :author}
  {:from :review     :to :draft      :role :editor  :note "changes requested"}
  {:from :review     :to :last-call  :role :editor  :track :standards}
  {:from :review     :to :final      :role :editor  :track #{:process :informational}}
  {:from :review     :to :rejected   :role :editor}
  {:from :last-call  :to :review     :role :editor  :note "a substantive objection reopens review"}
  {:from :last-call  :to :final      :role :quorum  :track :standards
   :guards [:last-call-elapsed :quorum-met :has-surfaces :has-evidence :has-migration]}
  {:from :last-call  :to :rejected   :role :editor}
  {:from :draft      :to :withdrawn  :role :author}
  {:from :review     :to :withdrawn  :role :author}
  {:from :last-call  :to :withdrawn  :role :author}
  {:from :final      :to :superseded :role :quorum  :guards [:has-superseded-by]}]

 ;; ------------------------------------------------------------------- guards
 :guards
 {:last-call-elapsed
  {:min-days 14
   :reason "The window has to outlast a week off. 14 days is the shortest
            interval that survives one person being away, which is the only
            failure mode a last call exists to prevent."
   :measured-from :kip/last-call-started}
  :quorum-met
  {:threshold 2
   ;; The allow-list is NOT copied here. It lives in the superproject at
   ;; manifest/fleet-keys.edn :canonical :allow, which is also what
   ;; `kagami govern` reads for canonical pin advances. Two copies of a key
   ;; list is two answers to "who may sign".
   :allow-list-ref {:repo "com-junkawasaki/root"
                    :path "manifest/fleet-keys.edn"
                    :key [:canonical :allow]}
   :signature-verification :delegated
   :signature-verification-note
   "kotoba.kip.core/validate takes an optional :verify-fn. Without one the
    validator checks shape and distinct-signer count only, and every report
    says so on its own line (QUORUM-VERIFY skipped:no-verifier) rather than
    folding an unchecked signature into a pass."}
  :has-surfaces   {:field :kip/surfaces   :reason "A standards KIP that names no surface is not standards track."}
  :has-evidence   {:field :kip/evidence   :reason "What was run, and what it printed."}
  :has-migration  {:field :kip/migration  :reason "What existing callers must do. \"nothing\" is a valid answer, absence is not."}
  :has-superseded-by {:field :kip/superseded-by}}

 ;; --------------------------------------------------------------- field sets
 ;; Required at each state. Checked cumulatively: entering :review requires
 ;; everything :draft required, and so on.
 :requirements
 {:draft     #{:kip/number :kip/title :kip/track :kip/status :kip/author :kip/created}
  :review    #{:kip/abstract :kip/motivation :kip/specification}
  :last-call #{:kip/surfaces :kip/last-call-started}
  :final     #{:kip/evidence :kip/migration :kip/quorum}}

 ;; Which required fields exist only because a track has that capability.
 ;; Removed from the requirement set when the track's flag is false, instead of
 ;; dropping the whole :last-call rung — `:kip/surfaces` sits on that rung but
 ;; has nothing to do with the clock, and a process KIP that touches a normative
 ;; surface still has to name it. Measured 2026-08-16: dropping the rung wholesale
 ;; let a process KIP reach :final without declaring what it changes.
 :track-gated-fields
 {:requires-last-call #{:kip/last-call-started}
  :requires-quorum #{:kip/quorum}}

 ;; ------------------------------------------------------------- diagnostics
 ;; Shared with kotoba/kip_gate_core.kotoba, which returns these as :i64.
 ;; Keep the numbers stable: they are what the parity test compares.
 :diagnostics
 {0 :kip/ok
  1 :kip/unknown-from-state
  2 :kip/unknown-to-state
  3 :kip/no-such-transition
  4 :kip/role-not-permitted
  5 :kip/last-call-too-short
  6 :kip/quorum-below-threshold
  7 :kip/missing-surfaces
  8 :kip/missing-evidence
  9 :kip/missing-migration
  10 :kip/missing-superseded-by
  11 :kip/track-not-permitted}}
