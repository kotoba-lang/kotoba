;; lang/normative-surfaces.edn — which files may only change through a Final KIP.
;;
;; ## This file is a declaration, not a measurement
;;
;; Nothing here observes a repository. It says "these paths are under the KIP
;; process"; whether a given change to one of them actually had a KIP is a
;; *coverage* question, and answering it needs two things this repo does not
;; have: the other repos' git history, and the KIP registry, at the same time.
;; That check therefore lives operator-side in the superproject
;; (`scripts/verify-kip-coverage.cljs`), not as a fleet gate here.
;;
;; That split is deliberate and it is copied from a mistake this workspace
;; already made. `root-permit-index` was landed as a fleet gate whose generator
;; reads `<root>/orgs/cloud-itonami`, which `git ls-files` in the root repo does
;; not contain — so it has run ~300 times and never once been green. A gate that
;; cannot see its input is not strict, it is silent. See also the "なぜ半分だけか"
;; note in `scripts/fleet-ci/gates/west-pin-policy-check.cljs`, which declines to
;; port the half of a check that would need credentials on a node.
;;
;; ## :adopted vs :proposed
;;
;; `:adopted` is exactly the set that `kotoba-lang/kotoba-lang`'s
;; `docs/authority-map.edn` already names as normative, transcribed. Naming a
;; file normative is the authority owner's call, and authority-map is where they
;; make it — this file does not get to promote a path by listing it.
;;
;; `:proposed` are paths that behave like normative surfaces (implementations
;; are required to agree with them, and `docs/lang/gates.md` gates on several)
;; but that authority-map does not currently name. Moving one to `:adopted`
;; is what KIP-0001 is for.
;;
;; Verified 2026-08-16: all 16 paths below exist in their named repository.

{:kotoba.kip.surfaces/version 1
 :kotoba.kip.surfaces/as-of "2026-08-16"
 :kotoba.kip.surfaces/derived-from
 {:repo "kotoba-lang/kotoba-lang"
  :path "docs/authority-map.edn"
  :key [:authorities]
  :selector "kind ∈ #{:machine-normative :human-normative}"
  :note "Transcribed by hand. `scripts/check-kips.cljk --surfaces <path-to-authority-map>`
         re-derives and diffs when the sibling checkout is available; without it
         the check prints SURFACE-DRIFT skipped:no-authority-map and does not pass that line."}

 :adopted
 [{:id :language-semantics
   :repo "kotoba-lang/kotoba-lang" :path "docs/lang/semantics-ssot.md"
   :kind :human-normative :owner "kotoba-lang/kotoba-lang"}
  {:id :admitted-grammar
   :repo "kotoba-lang/kotoba-lang" :path "lang/guest-grammar.edn"
   :kind :machine-normative :owner "kotoba-lang/kotoba-lang"}
  {:id :surface-status
   :repo "kotoba-lang/kotoba-lang" :path "lang/surface-status.edn"
   :kind :machine-normative :owner "kotoba-lang/kotoba-lang"}
  {:id :documentation-release-binding
   :repo "kotoba-lang/kotoba-lang" :path "lang/docs-release.edn"
   :kind :machine-normative :owner "kotoba-lang/kotoba-lang"}
  {:id :diagnostic-registry
   :repo "kotoba-lang/kotoba-lang" :path "lang/diagnostics.edn"
   :kind :machine-normative :owner "kotoba-lang/kotoba-lang"}
  {:id :source-classification
   :repo "kotoba-lang/kotoba-core-contracts" :path "lang/profile.edn"
   :kind :machine-normative :owner "kotoba-lang/kotoba-core-contracts"}
  {:id :package-contract
   :repo "kotoba-lang/kotoba-core-contracts" :path "lang/package.edn"
   :kind :machine-normative :owner "kotoba-lang/kotoba-core-contracts"}]

 :proposed
 [{:id :version-policy
   :repo "kotoba-lang/kotoba-lang" :path "lang/version-policy.edn"
   :kind :machine-normative :owner "kotoba-lang/kotoba-lang"
   :why "Sets the deprecation floor (180 days), removal-requires-major, and what a
         signed release tag binds. A silent edit here shortens a promise already made."}
  {:id :capability-semantics
   :repo "kotoba-lang/kotoba-lang" :path "lang/capability-semantics.edn"
   :kind :machine-normative :owner "kotoba-lang/kotoba-lang"
   :why "ADR-2608160200 names this the core capability IR that UCAN/CACAO/OCapN
         adapt to. Widening :cap/kind is widening authority."}
  {:id :value-codec
   :repo "kotoba-lang/kotoba-lang" :path "lang/value-codec.edn"
   :kind :machine-normative :owner "kotoba-lang/kotoba-lang"
   :why "Canonical encoding. A change here changes CIDs, which are identities."}
  {:id :elaboration-pipeline
   :repo "kotoba-lang/kotoba-lang" :path "lang/elaboration-pipeline.edn"
   :kind :machine-normative :owner "kotoba-lang/kotoba-lang"
   :why "docs/lang/gates.md already gates on its existence and on its
         profile-version agreeing with grammar and surface-status."}
  {:id :conformance-manifest
   :repo "kotoba-lang/kotoba-lang" :path "lang/conformance/manifest.edn"
   :kind :machine-normative :owner "kotoba-lang/kotoba-lang"
   :why "What a conforming implementation is required to run."}
  {:id :capability-conformance-manifest
   :repo "kotoba-lang/kotoba-lang" :path "lang/capability-conformance/manifest.edn"
   :kind :machine-normative :owner "kotoba-lang/kotoba-lang"}
  {:id :type-conformance-manifest
   :repo "kotoba-lang/kotoba-lang" :path "lang/type-conformance/manifest.edn"
   :kind :machine-normative :owner "kotoba-lang/kotoba-lang"}
  {:id :kip-process
   :repo "kotoba-lang/kip" :path "lang/kip-process.edn"
   :kind :machine-normative :owner "kotoba-lang/kip"
   :why "The process governs itself, or the first thing anyone changes is the process."}]

 ;; Named by authority-map but deliberately NOT under the KIP process: these are
 ;; implementations and assurance surfaces. They are required to *follow* the
 ;; normative files; they do not define them, and putting an implementation
 ;; under a change process only slows down conforming to a decision already made.
 :excluded
 [{:id :compiler-and-cli :repo "kotoba-lang/kotoba" :kind :implementation}
  {:id :release-admission :repo "kotoba-lang/release" :kind :assurance}]}
