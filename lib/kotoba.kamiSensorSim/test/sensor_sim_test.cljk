(ns sensor-sim-test
  "Namespace-loads smoke test for the `sensor-sim` root namespace."
  (:require [kotoba.test :refer [deftest is]]
            [sensor-sim :as sensor-sim]))

(deftest root-namespace-loads
  (is (= "kami-sensor-sim" sensor-sim/kami-name))
  (is (= "isaacsim.sensors" sensor-sim/nv-compat-target))
  (is (= #{"camera" "lidar" "imu" "contact"} (set sensor-sim/supported-sensors))))
