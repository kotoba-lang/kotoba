(ns sensor-sim.imu-test
  "Ported 1:1 from `imu.rs`'s `#[cfg(test)] mod tests` (kami-sensor-sim,
   deleted PR #82). ADR-2607010930.

   The original Rust tests reused a single mutable `imu` binding across
   calls (`imu.sample(...)`); this CLJC restoration is pure-functional
   (`sample` returns `{:reading r :imu next-imu}`), so each test threads
   `:imu` explicitly between calls instead."
  (:require [kotoba.test :refer [deftest testing is]]
            [sensor-sim.imu :as imu]
            [sensor-sim.math :as m]))

(deftest static-body-reads-plus-g-along-body-up
  ;; Body at rest at world origin with identity orientation. Real
  ;; accelerometer reading should be (0, 0, +9.81) ("up").
  (let [imu0 (imu/imu-new "imu" "/W/cart/imu" "cart")
        ;; First sample: no previous velocity, so report -gravity ("up").
        {r0 :reading imu1 :imu} (imu/sample imu0 m/v-zero m/v-zero (m/quat-identity) 0.0)]
    (is (< (Math/abs (- (m/vz (:linear-acceleration r0)) 9.81)) 1e-3))
    ;; Steady-state: still zero velocity, time advanced. Reading still +g up.
    (let [{r1 :reading} (imu/sample imu1 m/v-zero m/v-zero (m/quat-identity) 0.01)]
      (is (< (Math/abs (- (m/vz (:linear-acceleration r1)) 9.81)) 1e-3)))))

(deftest freefall-reads-zero
  ;; Body in freefall (lin_vel decreasing along -z over time).
  (let [imu0 (-> (imu/imu-new "imu" "/W/imu" "any") imu/reset)
        ;; first sample to set the baseline:
        {imu1 :imu} (imu/sample imu0 m/v-zero m/v-zero (m/quat-identity) 0.0)
        dt 0.01
        v-fall [0.0 0.0 (* -9.81 dt)]
        {r :reading} (imu/sample imu1 v-fall m/v-zero (m/quat-identity) dt)]
    ;; Proper accel = (v - 0) / dt - gravity = (0, 0, -9.81) - (0,0,-9.81) = 0
    (is (< (m/v-length (:linear-acceleration r)) 1e-2))))

(deftest rotating-body-reports-body-frame-ang-vel
  ;; Body rotating at 1 rad/s about world +y, oriented at 90deg about y.
  ;; Body-frame +z (originally world +z) maps to world +x after rotation.
  ;; So world ang_vel (0, 1, 0) -> body ang_vel (0, 1, 0) (y axis is shared
  ;; by both orientation and rotation).
  (let [imu0 (-> (imu/imu-new "imu" "/W/imu" "any") imu/reset)
        q (m/quat-from-axis-angle [0.0 1.0 0.0] (/ Math/PI 2.0))
        {r :reading} (imu/sample imu0 m/v-zero [0.0 1.0 0.0] q 0.0)]
    ;; y-axis rotation: world y == body y.
    (is (< (Math/abs (- (m/vy (:angular-velocity r)) 1.0)) 1e-4))))

(deftest reading-carries-orientation-and-time
  (let [imu0 (imu/imu-new "imu" "/W/imu" "any")
        q (m/quat-from-axis-angle [0.0 1.0 0.0] 0.3)
        {r :reading} (imu/sample imu0 m/v-zero m/v-zero q 1.234)]
    (is (< (Math/abs (- (:time r) 1.234)) 1e-6))
    (is (< (Math/abs (- (nth (:orientation r) 2) (nth q 2))) 1e-6))))
