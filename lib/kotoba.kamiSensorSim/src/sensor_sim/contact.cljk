(ns sensor-sim.contact
  "ContactSensor — sphere-approximated link vs scene-primitive contact.

   Restored 1:1 from `contact.rs` (`kotoba-lang/kami-engine`'s deleted
   `kami-sensor-sim` crate, removed in PR #82 \"Remove Rust workspace\"),
   per ADR-2607010930 (`com-junkawasaki/root`).

   Mirrors `isaacsim.sensors.ContactSensor` (Isaac Sim 4.x) at the public API
   level. Each articulation link is approximated as a sphere (center +
   radius); at sample time the sensor walks the scene's primitives (from
   `sensor-sim.lidar`: ground-plane / sphere / AABB) and reports:

   - `:in-contact?`        -- sphere overlaps any primitive
   - `:penetration-depth`  -- how far the sphere penetrates (0 if not in contact)
   - `:contact-normal`     -- world-frame unit vector from primitive surface
     toward the sphere center; arbitrary when not in contact
   - `:closest-distance`   -- signed distance from sphere surface to nearest
     primitive surface (negative when penetrating)
   - `:closest-primitive`  -- index of nearest primitive, or nil if the
     scene has none (nil stands in for the original's `usize::MAX`)

   Distance metric for sphere-vs-primitive: closest point on primitive
   surface to sphere center, minus sphere radius."
  (:require [sensor-sim.math :as m]))

(defn contact-reading-default []
  {:in-contact? false
   :penetration-depth 0.0
   :contact-normal [0.0 0.0 1.0]
   :closest-distance ##Inf
   :closest-primitive nil
   :time 0.0})

(defn contact-sensor-new
  "`radius` is the sphere radius approximating the link's collision geometry."
  [name prim-path link-name radius]
  {:name name :prim-path prim-path :link-name link-name :radius radius})

(defn primitive-closest
  "Closest-point distance from `p-world` to the surface of `prim`, with the
   world-frame outward normal of the surface at that closest point.
   Returns `[distance normal]`; distance is signed, negative when `p-world`
   is inside the primitive."
  [prim p-world]
  (case (:type prim)
    :ground-plane
    (let [height (:height prim)
          d (- (m/vz p-world) height)]
      [d [0.0 0.0 1.0]])

    :sphere
    (let [{:keys [center radius]} prim
          delta (m/v-sub p-world center)
          d-centers (m/v-length delta)]
      (if (< d-centers 1e-12)
        [(- radius) [0.0 0.0 1.0]]
        (let [normal (m/v-scale delta (/ 1.0 d-centers))]
          [(- d-centers radius) normal])))

    :aabb
    (let [{mn :min mx :max} prim
          clamped (m/v-clamp p-world mn mx)
          inside? (= p-world clamped)]
      (if-not inside?
        (let [delta (m/v-sub p-world clamped)
              d (m/v-length delta)]
          (if (< d 1e-12)
            [0.0 [0.0 0.0 1.0]]
            [d (m/v-scale delta (/ 1.0 d))]))
        (let [dx-min (- (m/vx p-world) (m/vx mn))
              dx-max (- (m/vx mx) (m/vx p-world))
              dy-min (- (m/vy p-world) (m/vy mn))
              dy-max (- (m/vy mx) (m/vy p-world))
              dz-min (- (m/vz p-world) (m/vz mn))
              dz-max (- (m/vz mx) (m/vz p-world))
              depths [[dx-min [-1.0 0.0 0.0]]
                      [dx-max [1.0 0.0 0.0]]
                      [dy-min [0.0 -1.0 0.0]]
                      [dy-max [0.0 1.0 0.0]]
                      [dz-min [0.0 0.0 -1.0]]
                      [dz-max [0.0 0.0 1.0]]]
              [min-depth normal] (reduce (fn [[md n] [d n2]]
                                            (if (< d md) [d n2] [md n]))
                                          [##Inf [0.0 0.0 1.0]]
                                          depths)]
          [(- min-depth) normal])))))

(defn sample
  "`link-position` is the world-frame position of the link's collision
   sphere center."
  [sensor link-position scene time]
  (let [radius (:radius sensor)
        [closest-d closest-idx closest-normal]
        (reduce
         (fn [[cd ci cn] [i p]]
           (let [[d n] (primitive-closest p link-position)
                 sphere-surface-d (- d radius)]
             (if (< sphere-surface-d cd) [sphere-surface-d i n] [cd ci cn])))
         [##Inf nil [0.0 0.0 1.0]]
         (map-indexed vector (:primitives scene)))
        in-contact? (< closest-d 0.0)
        penetration-depth (if in-contact? (- closest-d) 0.0)]
    {:in-contact? in-contact?
     :penetration-depth penetration-depth
     :contact-normal closest-normal
     :closest-distance closest-d
     :closest-primitive closest-idx
     :time time}))

(defn sample-all
  "Report **every** primitive the link's collision sphere overlaps, not just
   the nearest -- Isaac's `ContactSensor` exposes multiple simultaneous
   contacts. One reading per contacting primitive (each with
   `:in-contact? true`), sorted deepest-penetration first. Empty when no
   contact. The single-contact `sample` returns the nearest surface instead."
  [sensor link-position scene time]
  (let [radius (:radius sensor)
        hits (keep
              (fn [[i p]]
                (let [[d n] (primitive-closest p link-position)
                      sphere-surface-d (- d radius)]
                  (when (< sphere-surface-d 0.0)
                    {:in-contact? true
                     :penetration-depth (- sphere-surface-d)
                     :contact-normal n
                     :closest-distance sphere-surface-d
                     :closest-primitive i
                     :time time})))
              (map-indexed vector (:primitives scene)))]
    (vec (sort-by :penetration-depth > hits))))
