(ns sensor-sim.imu
  "IMUSensor — body-frame inertial measurement unit.

   Restored 1:1 from `imu.rs` (`kotoba-lang/kami-engine`'s deleted
   `kami-sensor-sim` crate, removed in PR #82 \"Remove Rust workspace\"),
   per ADR-2607010930 (`com-junkawasaki/root`).

   Mirrors `isaacsim.sensors.IMUSensor` (Isaac Sim 4.x) at the public API
   level. Attached to a named link of an articulation; samples at each step
   to expose:
   - linear acceleration in body frame (finite difference of linear velocity)
   - angular velocity in body frame (rotated from world)
   - orientation as a quaternion (world)

   Convention: linear acceleration is **proper acceleration** = inertial
   acceleration - gravity in body frame. A static body in free fall reads
   zero; a body resting on the ground reads +g in the \"up\" body direction
   (matches real accelerometers).

   The original Rust `Imu` mutated its own sampling state (`&mut self`)
   across calls. This restoration is a pure-functional equivalent: `sample`
   takes the current `imu` state and returns `{:reading r :imu next-imu}`;
   callers thread `:imu` through successive calls the way the Rust tests
   reused the same `mut imu` binding."
  (:require [sensor-sim.math :as m]))

(defn imu-reading-default []
  {:linear-acceleration m/v-zero
   :angular-velocity m/v-zero
   :orientation (m/quat-identity)
   :time 0.0})

(defn imu-new
  "Default gravity is 9.81 m/s^2 along -z (world frame)."
  [name prim-path link-name]
  {:name name
   :prim-path prim-path
   :link-name link-name
   :gravity [0.0 0.0 -9.81]
   :last-lin-vel-world m/v-zero
   :last-time 0.0
   :has-previous? false})

(defn set-gravity
  "Override gravity (e.g. zero gravity for free-fall sanity tests)."
  [imu g]
  (assoc imu :gravity g))

(defn reset
  "Reset the running state (forget previous sample). Call before each new
   episode."
  [imu]
  (assoc imu :has-previous? false :last-lin-vel-world m/v-zero :last-time 0.0))

(defn sample
  "Sample the IMU given the link's world-frame state and the current sim
   time. `lin-vel-world` and `ang-vel-world` come from
   `kami-genesis`-equivalent articulation link state. Returns
   `{:reading <ImuReading> :imu <updated imu>}`; on the very first call (no
   previous velocity), the linear-acceleration is reported as the
   negative-gravity reading (consistent with a body at rest in gravity)."
  [imu lin-vel-world ang-vel-world orientation time]
  (let [{:keys [gravity last-lin-vel-world last-time has-previous?]} imu
        inertial-accel-world (if (and has-previous? (> time last-time))
                                (m/v-scale (m/v-sub lin-vel-world last-lin-vel-world)
                                           (/ 1.0 (- time last-time)))
                                m/v-zero)
        ;; Proper acceleration (world) = inertial - gravity. A body at rest
        ;; reads (0,0,0) - (0,0,-g) = (0,0,+g) in world ("up"), matching a
        ;; real accelerometer at rest.
        proper-world (m/v-sub inertial-accel-world gravity)
        inv (m/quat-inverse orientation)
        lin-accel-body (m/quat-rotate-vec3 inv proper-world)
        ang-vel-body (m/quat-rotate-vec3 inv ang-vel-world)
        next-imu (assoc imu
                         :last-lin-vel-world lin-vel-world
                         :last-time time
                         :has-previous? true)
        reading {:linear-acceleration lin-accel-body
                 :angular-velocity ang-vel-body
                 :orientation orientation
                 :time time}]
    {:reading reading :imu next-imu}))
