;; chmod -- POSIX chmod (IEEE Std 1003.1), the OCTAL form.
;;
;;   chmod MODE FILE...
;;
;; ## Octal only
;;
;; The symbolic form (`u+x`, `go-w`, `a=r`) is a small language of its own --
;; a who-list, an operator and a perm-list, applied against the file's
;; current mode. It is not implemented, and this is the same kind of boundary
;; org-ieee-grep draws at -F: what is here is exact, and what is absent is
;; named rather than half-done.
;;
;; ## Measured against /bin/chmod 2026-09-10
;;
;;   chmod 644 f      -> exit 0
;;   chmod 0755 d     -> exit 0, the leading zero is accepted
;;   chmod 644 nope   -> chmod: nope: No such file or directory   exit 1
;;
;; The mode travels to the host as the OCTAL TEXT it arrived as, so neither
;; side re-renders it and `0755` and `755` are the same request.
;;
;; Setuid, setgid and the sticky bit are NOT settable: the host masks to the
;; twelve permission bits, because a grant to write a file's bytes is not a
;; grant to make it run as someone else. `chmod 4755` therefore sets 0755
;; here and 4755 under /bin/chmod, and the README says so.
;;
;; Capabilities: :cli/args (38), :fs/app-data (35), :io/write-error (39).
(ns chmod.core (:export [main]))

(defn arg [i :string] :string
  (typed-cap-call :cli/args :string :string i))

(defn emit-error [s :string] :string
  (typed-cap-call :io/write-error :string :string s))

(defn cap [s :string] :string
  (typed-cap-call :fs/app-data :string :string s))

(defn exists? [path :string] :bool
  (string=? (cap (string-concat path "EXISTS_SEP")) "1"))

(defn set-mode [path :string octal :string] :bool
  (string=? (cap (string-concat (string-concat path "CHMOD_SEP") octal)) "1"))

(defn nl [] :string
  (string-substring "a
b" 1 2))

(defn tab [] :string
  (string-substring "a	b" 1 2))

(defn digit-text [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn decimal-of [n :i64] :string
  (if (< n 10)
    (digit-text n)
    (string-concat (decimal-of (quot n 10))
                   (digit-text (- n (* 10 (quot n 10)))))))

;; Every byte an octal digit, and at least one. The host refuses a bad mode
;; with a trap, which a command must never provoke -- so it is checked here
;; and reported the way chmod reports it.
(defn octal-digit? [s :string i :i64] :bool
  (let [c (string-code-point-at s i)]
    (if (< c 48) false (< c 56))))

(defn all-octal? [s :string i :i64 n :i64] :bool
  (if (= n 0)
    false
    (if (>= i n)
      true
      (if (octal-digit? s i) (all-octal? s (+ i 1) n) false))))

(defn valid-mode? [s :string] :bool
  (let [n (string-byte-length s)]
    (if (> n 6) false (all-octal? s 0 n))))

(defn say [path :string reason :string] :i64
  (do (emit-error "chmod: ")
      (emit-error path)
      (emit-error reason)
      (emit-error (nl))
      1))

(defn each [i :i64 total :string mode :string worst :i64] :i64
  (if (string=? (decimal-of i) total)
    worst
    (let [path (arg (decimal-of i))]
      (if (exists? path)
        (if (set-mode path mode)
          (each (+ i 1) total mode worst)
          (each (+ i 1) total mode (say path ": Operation not permitted")))
        (each (+ i 1) total mode (say path ": No such file or directory"))))))

(defn main [] :i64
  (let [total (arg "")
        mode (arg "0")]
    (if (if (string=? total "0") true (string=? total "1"))
      ;; Measured byte for byte: TWO lines, a literal TAB after `usage:` and
      ;; at the start of the second, and exit 1 -- not the 64 that rm and mv
      ;; use for the same mistake. Each utility was measured on itself.
      (do
        (emit-error "usage:")
        (emit-error (tab))
        (emit-error "chmod [-fhv] [-R [-H | -L | -P]] [-a | +a | =a  [i][# [ n]]] mode|entry file ...")
        (emit-error (nl))
        (emit-error (tab))
        (emit-error "chmod [-fhv] [-R [-H | -L | -P]] [-E | -C | -N | -i | -I] file ...")
        (emit-error (nl))
        1)
      (if (valid-mode? mode)
        (each 1 total mode 0)
        (do
          (emit-error "chmod: Invalid file mode: ")
          (emit-error mode)
          (emit-error (nl))
          1)))))
