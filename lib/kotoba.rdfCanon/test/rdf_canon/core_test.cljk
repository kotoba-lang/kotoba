(ns rdf-canon.core-test
  (:require [kotoba.test :refer [deftest is testing]]
            [rdf-canon.core :as canon]))

(defn iri [v] {:rdf/type :iri :value v})
(defn lit
  ([v] {:rdf/type :literal :value v})
  ([v extra] (merge {:rdf/type :literal :value v} extra)))

(deftest canonicalizes-by-sort
  (let [a {:subject (iri "b") :predicate (iri "p") :object (lit "2")}
        b {:subject (iri "a") :predicate (iri "p") :object (lit "1")}]
    (is (= "<a> <p> \"1\" .\n<b> <p> \"2\" .\n"
           (canon/canonical [a b])))
    (is (= 64 (count (canon/digest [a b]))))))

;; ── The five pinned identities ────────────────────────────────────────────
;;
;; `digest` is what callers store and address content by, so the SHA-256 swap
;; (java.security.MessageDigest → kotoba-lang/org-nist-sha2, 2026-08-18) had
;; to leave every digest byte-identical. These constants were captured from
;; the JVM implementation BEFORE the swap and then confirmed against
;; `shasum -a 256`, an implementation outside this workspace:
;;
;;   printf '%s' '<a> <p> "1" .
;;   <b> <p> "2" .
;;   ' | shasum -a 256
;;   -> eb473a919e0b478af0a015c67f54290b07e1a97a2af5c6be5a492331b00983eb
;;
;;   printf '%s' '<http://例え.jp/s> <http://example.org/p> "日本語テキスト"@ja .
;;   ' | shasum -a 256
;;   -> c797ffef7d5941803922307051d72aceb8399a5624a5eb1ce5ae1f67d476f6f4
;;
;;   printf '%s\n' '<http://example.org/s> <http://example.org/p> "back\\slash \"quote\" nl\ncr\r" .' | shasum -a 256
;;   -> 92c103d999c13845b705a26a103678cefe85a9176855ec2a1607bc9e1695df2a
;;
;;   printf '%s\n' '_:b0 <http://example.org/p> "42"^^<http://www.w3.org/2001/XMLSchema#integer> <http://example.org/g> .' | shasum -a 256
;;   -> 32b38a54ff3d64ee4985ac9addf2600e0c8e2f2400fefd56b698caacfa921a72
;;
;;   printf '' | shasum -a 256
;;   -> e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
;;
;; The multi-byte case is deliberate. `canonicalizes-by-sort` above asserts
;; that a digest is 64 characters long, which every hash function satisfies,
;; and the length of a hex digest says nothing about whether the string was
;; encoded to UTF-8 correctly on the way in. A Japanese literal under a
;; non-ASCII IRI is where a wrong encoder shows.

(def pinned
  [{:name :ascii-pair
    :quads [{:subject (iri "b") :predicate (iri "p") :object (lit "2")}
            {:subject (iri "a") :predicate (iri "p") :object (lit "1")}]
    :canonical "<a> <p> \"1\" .\n<b> <p> \"2\" .\n"
    :digest "eb473a919e0b478af0a015c67f54290b07e1a97a2af5c6be5a492331b00983eb"}
   {:name :multibyte
    :quads [{:subject (iri "http://例え.jp/s")
             :predicate (iri "http://example.org/p")
             :object (lit "日本語テキスト" {:language "ja"})}]
    :canonical "<http://例え.jp/s> <http://example.org/p> \"日本語テキスト\"@ja .\n"
    :digest "c797ffef7d5941803922307051d72aceb8399a5624a5eb1ce5ae1f67d476f6f4"}
   {:name :escapes
    :quads [{:subject (iri "http://example.org/s")
             :predicate (iri "http://example.org/p")
             :object (lit "back\\slash \"quote\" nl\ncr\r")}]
    :canonical (str "<http://example.org/s> <http://example.org/p> "
                    "\"back\\\\slash \\\"quote\\\" nl\\ncr\\r\" .\n")
    :digest "92c103d999c13845b705a26a103678cefe85a9176855ec2a1607bc9e1695df2a"}
   {:name :typed-and-graph
    :quads [{:subject {:rdf/type :blank :id "b0"}
             :predicate (iri "http://example.org/p")
             :object (lit "42" {:datatype (iri "http://www.w3.org/2001/XMLSchema#integer")})
             :graph (iri "http://example.org/g")}]
    :canonical (str "_:b0 <http://example.org/p> "
                    "\"42\"^^<http://www.w3.org/2001/XMLSchema#integer> "
                    "<http://example.org/g> .\n")
    :digest "32b38a54ff3d64ee4985ac9addf2600e0c8e2f2400fefd56b698caacfa921a72"}
   {:name :empty
    :quads []
    :canonical ""
    :digest "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}])

(deftest digest-values-are-pinned
  (testing "the exact SHA-256 hex the JVM produced before the portable swap"
    (is (= 5 (count pinned)) "if the table shrinks this test measures less")
    (doseq [{:keys [name quads digest]} pinned]
      (is (= digest (canon/digest quads)) (str "digest moved for " name)))))

(deftest canonical-forms-are-pinned
  (testing "the N-Quads bytes the digest is taken over. Pinning only the
            digest would leave `canonical` free to change in a way no
            assertion names, and the failure would read as a hash problem."
    (doseq [{:keys [name quads canonical]} pinned]
      (is (= canonical (canon/canonical quads))
          (str "canonical form moved for " name)))))

(deftest sha-256-matches-the-external-oracle-on-a-bare-string
  (testing "`sha-256` on its own, so a change in `canonical` cannot mask a
            change in the hash or the other way round. Both constants are
            `shasum -a 256` output:
              printf '%s' 'abc'  -> ba7816bf…
              printf '%s' '日本' -> cf2abf0c…"
    (is (= "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
           (canon/sha-256 "abc")))
    (is (= "cf2abf0c5be326cb922a70f8163f91079c4d9aa8655c60ead89ad545c9de2e92"
           (canon/sha-256 "日本")))))

(deftest the-encoder-is-utf-8-and-not-one-byte-per-code-unit
  (testing "the specific way a portable hash goes wrong: hashing one byte per
            UTF-16 code unit instead of UTF-8. Both spellings below are three
            code points; only the encoding differs, and both produce a
            64-character hex string, so only a pinned value sees the
            difference.

              U+65E5 日        -> UTF-8 e6 97 a5
              U+00E6 U+0097 U+00A5 -> UTF-8 c3 a6 c2 97 c2 a5

            The second string is exactly what a latin-1 reading of the first
            string's bytes would be, so if `sha-256` ever byte-passes UTF-16
            code units these two collide.

              printf '\\xe6\\x97\\xa5' | shasum -a 256
                -> 85217f7aff77841438439fb3e7cf37bb3062fb026453c7692247d3a5641a0115
              printf '\\xc3\\xa6\\xc2\\x97\\xc2\\xa5' | shasum -a 256
                -> 2f2c9dfb1522d02ccb6bb25d3058362cd66f88f476aef034e3943f309ff7bfa0"
    (let [mojibake (str (char 0xe6) (char 0x97) (char 0xa5))]
      (is (= "85217f7aff77841438439fb3e7cf37bb3062fb026453c7692247d3a5641a0115"
             (canon/sha-256 "日")))
      (is (= "2f2c9dfb1522d02ccb6bb25d3058362cd66f88f476aef034e3943f309ff7bfa0"
             (canon/sha-256 mojibake)))
      (is (not= (canon/sha-256 "日") (canon/sha-256 mojibake))
          "equal here means the encoder dropped to one byte per code unit"))))

(deftest terms-render-by-type
  (is (= "<http://example.org/s>" (canon/term (iri "http://example.org/s"))))
  (is (= "_:b7" (canon/term {:rdf/type :blank :id "b7"})))
  (is (= "\"plain\"" (canon/term (lit "plain"))))
  (is (= "\"bonjour\"@fr" (canon/term (lit "bonjour" {:language "fr"}))))
  (is (= "\"1\"^^<http://www.w3.org/2001/XMLSchema#integer>"
         (canon/term (lit "1" {:datatype (iri "http://www.w3.org/2001/XMLSchema#integer")}))))
  (testing "language wins over datatype when both are present, as the cond orders them"
    (is (= "\"x\"@en"
           (canon/term (lit "x" {:language "en" :datatype (iri "http://d")}))))))

(deftest an-unknown-term-is-refused-rather-than-rendered
  (testing "rendering an unrecognised term as \"\" would produce a well-formed
            canonical string, and therefore a plausible digest, for a quad the
            library did not understand"
    (let [thrown (try (canon/term {:rdf/type :quoted-triple :value "x"})
                      nil
                      (catch #?(:clj Exception :cljs :default) e e))]
      (is (some? thrown))
      (is (= {:term {:rdf/type :quoted-triple :value "x"}} (ex-data thrown))))))

(deftest escaping-covers-all-four-sequences
  (is (= "a\\\\b" (canon/esc "a\\b")))
  (is (= "a\\\"b" (canon/esc "a\"b")))
  (is (= "a\\nb" (canon/esc "a\nb")))
  (is (= "a\\rb" (canon/esc "a\rb")))
  (testing "the backslash pass runs first, so an escape introduced by a later
            pass is not itself escaped: the result of escaping a newline is
            two characters, not three"
    (is (= "\\n" (canon/esc "\n")))
    (is (= 2 (count (canon/esc "\n"))))))

(deftest a-term-component-that-is-not-a-string-is-refused
  (testing "ClojureScript has no distinct floating-point type. Its reader
            turns 1.0 into 1 before this library sees anything, so `(str v)`
            gives \"1.0\" on the JVM and \"1\" under ClojureScript — measured in
            both runtimes on 2026-08-18 — and the digest of the same graph
            would depend on which runtime read it. No reader conditional can
            fix that: the distinction is destroyed upstream. So `term` takes
            lexical forms and refuses to invent one.

            The refusal covers numbers in general rather than floats alone,
            because on ClojureScript there is no difference between the two
            to test for. It also covers keywords, booleans and nil, whose
            printed forms happen to agree today — one rule that is true is
            better than four exceptions that have to stay true."
    (doseq [bad [1.0 42 -0.0 1e21 true nil :ja]]
      (let [thrown (try (canon/term (lit bad))
                        nil
                        (catch #?(:clj Exception :cljs :default) e e))]
        (is (some? thrown) (str "a literal value of " (pr-str bad) " was rendered"))
        (is (= {:value bad} (ex-data thrown)))))
    (testing "and every other slot a term is built from, not only the
              literal's value — an IRI or a blank-node label interpolated
              with `str` diverges in exactly the same way"
      (doseq [t [{:rdf/type :iri :value 1.0}
                 {:rdf/type :blank :id 1.0}
                 (lit "x" {:language 1.0})
                 (lit "x" {:datatype {:rdf/type :iri :value 1.0}})]]
        (is (nil? (try (canon/term t)
                       (catch #?(:clj Exception :cljs :default) _ nil)))
            (str "unrefused: " (pr-str t)))))))

(deftest esc-still-coerces-and-that-is-not-the-identity-path
  (testing "`esc` is a public string helper and keeps its `(str s)`. It is
            only reached from `term` after `lexical` has already refused
            non-strings, so the coercion cannot put a runtime-dependent
            number into a canonical form. These two values print the same on
            every runtime; a float is deliberately not among them."
    (is (= "" (canon/esc nil)))
    (is (= "42" (canon/esc 42)))))

(deftest a-typed-double-is-canonical-because-the-caller-supplied-the-lexical-form
  (testing "the case the refusal above exists for, done right. Both of these
            are xsd:double literals of the same VALUE and different literals
            in RDF, and both digests are `shasum -a 256` output:

              printf '%s\\n' '<http://example.org/s> <http://example.org/p> \"1.0\"^^<http://www.w3.org/2001/XMLSchema#double> .' | shasum -a 256
                -> 608919e678b07bacc0201c778ea8a3fbd6ee9f3aae331682409bab3659468e8d
              printf '%s\\n' '<http://example.org/s> <http://example.org/p> \"1\"^^<http://www.w3.org/2001/XMLSchema#double> .' | shasum -a 256
                -> aaeae4269f6d38e0f13a8a9360a81ea5083fdcbee73a0802acbe41feeabed032

            They differ, which is the point: had the value arrived as a
            Clojure 1.0 the two runtimes would each have picked a different
            one of these two digests for the same input."
    (let [xsd-double (iri "http://www.w3.org/2001/XMLSchema#double")
          q (fn [lex] [{:subject (iri "http://example.org/s")
                        :predicate (iri "http://example.org/p")
                        :object (lit lex {:datatype xsd-double})}])]
      (is (= "608919e678b07bacc0201c778ea8a3fbd6ee9f3aae331682409bab3659468e8d"
             (canon/digest (q "1.0"))))
      (is (= "aaeae4269f6d38e0f13a8a9360a81ea5083fdcbee73a0802acbe41feeabed032"
             (canon/digest (q "1"))))
      (is (not= (canon/digest (q "1.0")) (canon/digest (q "1")))))))

(deftest a-graph-is-appended-only-when-present
  (let [without {:subject (iri "s") :predicate (iri "p") :object (lit "o")}]
    (is (= "<s> <p> \"o\" ." (canon/quad-line without)))
    (is (= "<s> <p> \"o\" <g> ."
           (canon/quad-line (assoc without :graph (iri "g")))))))

(deftest canonical-is-order-independent-and-newline-terminated
  (let [q1 {:subject (iri "a") :predicate (iri "p") :object (lit "1")}
        q2 {:subject (iri "b") :predicate (iri "p") :object (lit "2")}
        q3 {:subject (iri "c") :predicate (iri "p") :object (lit "3")}]
    (is (= (canon/canonical [q1 q2 q3]) (canon/canonical [q3 q1 q2])))
    (is (= (canon/digest [q1 q2 q3]) (canon/digest [q3 q1 q2])))
    (testing "every line is terminated, including the last. Otherwise the
              empty set and a set of one would differ only by a trailing byte
              that nothing asserts."
      (is (= 3 (count (re-seq #"\n" (canon/canonical [q1 q2 q3])))))
      (is (= "" (canon/canonical []))))))
