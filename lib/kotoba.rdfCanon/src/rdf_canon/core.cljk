(ns rdf-canon.core
  "Deterministic RDF quad canonical string and hash helpers, portable.

  ## Why this is `.cljc` and not `.clj`

  One import made this namespace JVM-only — `java.security.MessageDigest` —
  and with it every consumer that wanted a content address for a set of
  quads. That is the wrong way round for this workspace, where the runtime
  order is kotoba-wasm → clojurewasm → ClojureScript → nbb with the JVM
  last. Turning quads into a canonical string is arithmetic on data; it has
  no business pinning a caller to a host.

  ## The digests did not move

  `digest` is an **identity**: callers store it, compare it, and address
  content by it, so a portable SHA-256 that disagreed with the old one by a
  single byte would silently rename everything this library has ever
  emitted. It does not. `kotoba-lang/org-nist-sha2` produces the same bytes
  as `MessageDigest`, and `digest-values-are-pinned` in the suite holds five
  constants that were captured from the JVM implementation BEFORE the swap
  and then checked against `shasum -a 256` — an oracle outside this
  workspace entirely. One of them is a Japanese literal under a
  non-ASCII IRI, because a wrong UTF-8 encoding shows there and an
  ASCII-only pin would not see it.

  Note what an unpinned suite cannot catch: asserting that a digest is 64
  characters long, or that two different inputs hash differently, is
  satisfied by *any* hash function. Those assertions stayed green through
  every hash I tried while writing this.

  ## No reader conditional over a host hash

  The obvious alternative — `#?(:cljs …)` over `node:crypto` — was
  rejected. It works under nbb and not in a browser, and it leaves two
  implementations of the same identity that can disagree. `org-nist-sha2`
  is one implementation on both platforms, and `kotoba.bytes/utf8-encode`
  is one UTF-8 encoder on both platforms, so there is nothing here for two
  hosts to disagree about."
  (:require [kotoba.lang.text :as str]
            [kotoba.bytes :as b]
            [sha2.core :as sha2]))

(defn- lexical
  "`v`, which must ALREADY be a string. Anything else is refused.

  ## Why this refuses instead of calling `str`

  ClojureScript has no distinct floating-point type. Its reader collapses a
  whole-numbered double into an integer BEFORE any code here runs, so the
  information needed to reproduce the JVM's answer is gone upstream of this
  library. Measured in both runtimes on 2026-08-18, same expression:

      (str 1.0)    JVM \"1.0\"     ClojureScript \"1\"
      (str -0.0)   JVM \"-0.0\"    ClojureScript \"0\"
      (str 1e21)   JVM \"1.0E21\"  ClojureScript \"1e+21\"
      (integer? 1.0)  JVM false    ClojureScript true

  A canonicalizer whose output depends on which runtime read the EDN is not
  a canonicalizer, and a digest that changes with the host is not an
  identity. **No reader conditional fixes this** — under ClojureScript the
  value handed to this function is already `1`, and nothing here can tell it
  from a double. Papering over it would produce two canonical forms for one
  graph and two digests for one identity, which is worse than refusing.

  Refusing NUMBERS IN GENERAL, not just floats, follows from the same fact:
  on ClojureScript `1.0` and `1` are the same value, so a rule that admitted
  integers would be a rule that admitted whole-numbered doubles by
  accident.

  RDF wants a lexical form anyway. `\"1.0\"^^xsd:double` and
  `\"1\"^^xsd:double` are distinct literals with the same value, and only the
  caller knows which one it holds — so the caller supplies the string. That
  is not a workaround; it is what the data model asks for."
  [v]
  (if (string? v)
    v
    (throw (ex-info "RDF term components must be lexical forms (strings)"
                    {:value v}))))

(defn esc
  "Escape a string for an N-Quads literal.

  `(str s)` coerces, which is safe for `nil` and for values whose printed
  form is the same on every runtime — but NOT for floating point, and this
  is a public function. Anything reaching the canonical form through `term`
  has already been through `lexical`, which refuses non-strings for the
  reason recorded there."
  [s]
  (-> (str s)
      (str/replace "\\" "\\\\")
      (str/replace "\"" "\\\"")
      (str/replace "\n" "\\n")
      (str/replace "\r" "\\r")))

(defn term
  "One RDF term as its N-Quads bytes.

  Every component goes through `lexical`, so a term built from anything but
  strings is refused rather than rendered — see that function for the
  floating-point reason."
  [x]
  (case (:rdf/type x)
    :iri (str "<" (lexical (:value x)) ">")
    :blank (str "_:" (lexical (:id x)))
    :literal (str "\"" (esc (lexical (:value x))) "\""
                  (cond
                    (:language x) (str "@" (lexical (:language x)))
                    (:datatype x) (str "^^<" (lexical (:value (:datatype x))) ">")
                    :else ""))
    (throw (ex-info "Unknown RDF term" {:term x}))))

(defn quad-line [{:keys [subject predicate object graph]}]
  (str (term subject) " " (term predicate) " " (term object)
       (when graph (str " " (term graph)))
       " ."))

(defn canonical [quads]
  (str (str/join "\n" (sort (map quad-line quads)))
       (when (seq quads) "\n")))

(defn sha-256
  "Lowercase hex SHA-256 of the UTF-8 bytes of `s`.

  This was `java.security.MessageDigest` plus `format \"%02x\"` until
  2026-08-18. `format` is as JVM-only as the import was — it does not exist
  in ClojureScript — so both went. `sha2/hex` zero-pads to two digits per
  byte exactly as `%02x` did; if it did not, the pinned digests below would
  be the wrong length and the suite would say so."
  [s]
  (sha2/sha256-hex (b/utf8-encode s)))

(defn digest [quads]
  (sha-256 (canonical quads)))
