;; One mutation per invariant. `:find` must occur EXACTLY ONCE in `:file`.
;;
;; ## SCOPE
;;
;; Covers the 2026-08-18 `.clj` → `.cljc` conversion: that the digests are
;; still SHA-256 over the UTF-8 bytes of the canonical form, and that the
;; canonical form itself is still what it was — sorted, newline-terminated,
;; escaped in that order, and refusing terms it does not recognise. It does
;; NOT cover blank-node canonicalization, which this library does not do
;; (see the README: stable provided ids only), so a clean run here means
;; "the portability invariants are measured" and not "this library is
;; measured".
;;
;; ⚠ These mutations drive `kbb -M:test`. `test/run_portable.cljk` runs
;; the same `.cljc` suite under nbb and this harness does not invoke it, so
;; a defect that exists only on the `:cljs` side survives here. There is no
;; `:cljs` branch in this namespace to hide in — the UTF-8 encoder is
;; `kotoba.bytes/utf8-encode`, one implementation on both platforms — but
;; that dependency does carry a reader conditional internally, so the cljs
;; path was broken BY HAND under nbb and the pinned-digest test was watched
;; going red. That evidence is in the PR, not in this table.
[{:id :the-hash-is-sha-256
  :invariant "digest is SHA-256, not some other member of the family"
  :file "src/rdf_canon/core.cljk"
  :find "(sha2/sha256-hex (b/utf8-encode s))"
  :replace "(sha2/sha224-hex (b/utf8-encode s))"}

 {:id :the-bytes-hashed-are-utf-8
  :invariant "the string is encoded to UTF-8, not one byte per UTF-16 code unit"
  :file "src/rdf_canon/core.cljk"
  :find "(b/utf8-encode s)"
  :replace "(mapv #(bit-and (int %) 0xff) s)"}

 {:id :quad-lines-are-sorted
  :invariant "canonical order does not depend on the order quads arrived in"
  :file "src/rdf_canon/core.cljk"
  :find "(str/join \"\\n\" (sort (map quad-line quads)))"
  :replace "(str/join \"\\n\" (map quad-line quads))"}

 {:id :the-last-line-is-terminated
  :invariant "a non-empty canonical form ends in a newline"
  :file "src/rdf_canon/core.cljk"
  :find "(when (seq quads) \"\\n\")"
  :replace "(when (seq quads) \"\")"}

 {:id :backslash-is-escaped
  :invariant "a literal backslash is doubled before the other passes run"
  :file "src/rdf_canon/core.cljk"
  :find "(str/replace \"\\\\\" \"\\\\\\\\\")"
  :replace "(str/replace \"\\\\\" \"\\\\\")"}

 {:id :a-quote-is-escaped
  :invariant "a quote inside a literal cannot close the literal"
  :file "src/rdf_canon/core.cljk"
  :find "(str/replace \"\\\"\" \"\\\\\\\"\")"
  :replace "(str/replace \"\\\"\" \"\\\"\")"}

 {:id :a-carriage-return-is-escaped
  :invariant "CR becomes the two-character sequence, not a raw byte"
  :file "src/rdf_canon/core.cljk"
  :find "(str/replace \"\\r\" \"\\\\r\")"
  :replace "(str/replace \"\\r\" \"\\r\")"}

 {:id :an-unknown-term-is-refused
  :invariant "an unrecognised term must not render as a plausible empty string"
  :file "src/rdf_canon/core.cljk"
  :find "(throw (ex-info \"Unknown RDF term\" {:term x}))"
  :replace "\"\""}

 {:id :the-graph-is-part-of-the-line
  :invariant "the fourth component is in the bytes that get hashed"
  :file "src/rdf_canon/core.cljk"
  :find "(when graph (str \" \" (term graph)))"
  :replace "nil"}

 {:id :the-language-tag-is-rendered
  :invariant "\"x\"@ja and \"x\" are different quads and must hash differently"
  :file "src/rdf_canon/core.cljk"
  :find "(:language x) (str \"@\" (lexical (:language x)))"
  :replace "(:language x) \"\""}

 {:id :the-datatype-renders-its-iri-value
  :invariant "^^<...> carries the IRI string, not the printed term map"
  :file "src/rdf_canon/core.cljk"
  :find "(str \"^^<\" (lexical (:value (:datatype x))) \">\")"
  :replace "(str \"^^<\" (lexical (:datatype x)) \">\")"}

 {:id :a-blank-node-keeps-its-prefix
  :invariant "_:b0 is a blank node label, not a bare id"
  :file "src/rdf_canon/core.cljk"
  :find "(str \"_:\" (lexical (:id x)))"
  :replace "(str (lexical (:id x)))"}

 {:id :subject-predicate-object-keep-their-positions
  :invariant "the triple is ordered s p o, not p s o"
  :file "src/rdf_canon/core.cljk"
  :find "(str (term subject) \" \" (term predicate) \" \" (term object)"
  :replace "(str (term predicate) \" \" (term subject) \" \" (term object)"}

 {:id :esc-coerces-its-argument-to-a-string
  :invariant "esc's (str s) coercion is reachable and does coerce"
  :file "src/rdf_canon/core.cljk"
  :find "(-> (str s)"
  :replace "(-> s"}

 ;; ADDED after the first table was written, on a finding from a sibling
 ;; agent: ClojureScript has no distinct floating-point type, and its reader
 ;; collapses 1.0 to 1 before this library sees anything. `term` used to
 ;; interpolate `(:value x)` straight into a string, so a Clojure double in
 ;; a literal produced \"1.0\" on the JVM and \"1\" under ClojureScript — the
 ;; same graph, two canonical forms, two digests. The first form of this
 ;; table did not look for that, and the suite it was written against
 ;; asserted `(term (lit 42))` was \"42\", which BLESSED the coercion.
 {:id :a-non-string-lexical-form-is-refused
  :invariant "term does not invent a lexical form, because on ClojureScript
              the float/integer distinction is already gone when it is asked"
  :file "src/rdf_canon/core.cljk"
  :find "  (if (string? v)\n    v\n    (throw"
  :replace "  (if true\n    (str v)\n    (throw"}

 {:id :the-refusal-covers-every-slot-not-just-the-literal-value
  :invariant "an IRI interpolated with str diverges the same way a literal does"
  :file "src/rdf_canon/core.cljk"
  :find ":iri (str \"<\" (lexical (:value x)) \">\")"
  :replace ":iri (str \"<\" (:value x) \">\")"}]
