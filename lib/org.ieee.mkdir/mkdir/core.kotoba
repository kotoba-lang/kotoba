;; mkdir -- POSIX mkdir (IEEE Std 1003.1).
;;
;;   mkdir DIR...        create each directory
;;   mkdir -p DIR...     create missing parents too, and do not complain that
;;                       a directory already exists
;;
;; ## The diagnostics name the PARENT, not the operand
;;
;; Measured against /bin/mkdir 2026-09-10:
;;
;;   mkdir x/y/z   ->  mkdir: x/y: No such file or directory
;;   mkdir one     ->  mkdir: one: File exists           (when it does)
;;
;; So a missing-parent failure reports `x/y` and not `x/y/z`. The wire answers
;; only "1" or "0", so which of the two messages applies is decided by asking
;; EXISTS about the operand and then about its parent -- that is what the
;; EXISTS form is for.
;;
;; ## Why -p recurses upward and stops at the first existing ancestor
;;
;; It cannot walk DOWNWARD from the root creating as it goes: an out-of-scope
;; path answers EXISTS "0", which is indistinguishable from absent, so the
;; walk would try to create `/private` and trap on the grant. Going upward and
;; stopping at the first ancestor that EXISTS terminates inside the grant,
;; because the scope root exists and answers "1".
;;
;; A `-p` whose ancestors lie outside the grant therefore traps rather than
;; reporting. That is a real divergence and the README names it; a packaged
;; command is given a scope its operands live under.
;;
;; Capabilities: :cli/args (38), :fs/app-data (35), :io/write-error (39).
(ns mkdir.core (:export [main]))

(defn arg [i :string] :string
  (typed-cap-call :cli/args :string :string i))

(defn emit-error [s :string] :string
  (typed-cap-call :io/write-error :string :string s))

(defn cap [s :string] :string
  (typed-cap-call :fs/app-data :string :string s))

(defn exists? [path :string] :bool
  (string=? (cap (string-concat path "EXISTS_SEP")) "1"))

(defn make-dir [path :string] :bool
  (string=? (cap (string-concat path "MKDIR_SEP")) "1"))

(defn nl [] :string
  (string-substring "a
b" 1 2))

(defn digit-text [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn decimal-of [n :i64] :string
  (if (< n 10)
    (digit-text n)
    (string-concat (decimal-of (quot n 10))
                   (digit-text (- n (* 10 (quot n 10)))))))

;; --- paths ---------------------------------------------------------------
(defn last-slash [p :string from :i64 best :i64] :i64
  (let [rest (string-substring p from (string-byte-length p))
        i (string-index-of rest "/")]
    (if (< i 0)
      best
      (last-slash p (+ from (+ i 1)) (+ from i)))))

(defn parent-of [p :string] :string
  (let [i (last-slash p 0 -1)]
    (if (< i 0) "." (if (= i 0) "/" (string-substring p 0 i)))))

;; --- flags ---------------------------------------------------------------
;; Argument 0's SHAPE, never the argument COUNT: `mkdir a b` is also two
;; arguments and must not be read as carrying a flag. Three sibling commands
;; had that bug and it was invisible until a second operand existed.
(defn parents? [] :bool
  (string=? (arg "0") "-p"))

(defn first-operand [] :i64
  (if (parents?) 1 0))

;; --- diagnostics ---------------------------------------------------------
(defn say [path :string reason :string] :i64
  (do (emit-error "mkdir: ")
      (emit-error path)
      (emit-error reason)
      (emit-error (nl))
      1))

;; Which of mkdir's two messages a failure earns. Asked only after the
;; attempt failed, so the answer costs nothing on the common path.
(defn explain [path :string] :i64
  (if (exists? path)
    (say path ": File exists")
    (say (parent-of path) ": No such file or directory")))

;; --- -p ------------------------------------------------------------------
;; Upward, stopping at the first ancestor that exists. `fuel` bounds the climb
;; so a path the grant does not contain fails instead of recursing forever;
;; the compiler admits five parameters and this needs one.
(defn make-parents [path :string fuel :i64] :bool
  (if (< fuel 1)
    (do (say path ": No such file or directory") false)
    (if (exists? path)
      true
      (if (make-parents (parent-of path) (- fuel 1))
        (if (make-dir path)
          true
          ;; The chain above this point was created or already there, so the
          ;; only thing that can refuse the child is the parent not being a
          ;; directory -- measured: `mkdir -p af/below` over a FILE `af` says
          ;; `mkdir: af: Not a directory`, naming the component rather than
          ;; the operand. The walk knows which one that is: it is the first
          ;; ancestor that existed.
          (do (say (parent-of path) ": Not a directory") false))
        false))))

;; --- the walk ------------------------------------------------------------
(defn each [i :i64 total :string worst :i64] :i64
  (if (string=? (decimal-of i) total)
    worst
    (let [path (arg (decimal-of i))]
      (if (parents?)
        ;; -p is silent about a directory that already exists, and 64 is a
        ;; depth no packaged scope reaches. `make-parents` owns the message,
        ;; because only it knows WHICH component refused.
        (if (make-parents path 64)
          (each (+ i 1) total worst)
          (each (+ i 1) total 1))
        (if (make-dir path)
          (each (+ i 1) total worst)
          (each (+ i 1) total (explain path)))))))

(defn main [] :i64
  (let [total (arg "")
        start (first-operand)]
    (if (string=? (decimal-of start) total)
      ;; No operand. mkdir(1) prints a usage line; this refuses with the same
      ;; status rather than inventing one.
      1
      (each start total 0))))
