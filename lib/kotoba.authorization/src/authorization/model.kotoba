;; Port of authorization.model (model.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from model.cljk:
;;   - decisions is a set in the source. It is a zero-arg function returning the
;;     members as a :document vector of keywords (cross-module constants are
;;     not exportable in amu).
;;   - :authz.decision/obligations is (vec ...) in the source. An absent or nil
;;     value gives the empty vector; any other value is kept as given.
;;   - a non-map opts or request reads every field as document-null.

(ns authorization.model
  (:export [decisions request decision]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- null-doc? [d :document] :bool
  (string=? (document-edn-print d) (document-edn-print (document-null))))

(defn decisions [] :document
  (document-vector (document-keyword :allow)
                   (document-keyword :deny)
                   (document-keyword :not-applicable)))

(defn request [id :document principal :document action :document resource :document opts :document] :document
  (document-map :authz.request/id id
                :authz.request/principal principal
                :authz.request/action action
                :authz.request/resource resource
                :authz.request/context (field opts :context)
                :authz.request/capability-ref (field opts :capability-ref)))

(defn- obligations-of [opts :document] :document
  (let [o (field opts :obligations)]
    (if (null-doc? o) (document-vector) o)))

(defn decision [request :document decision :document opts :document] :document
  (document-map :authz.decision/request-id (field request :authz.request/id)
                :authz.decision/decision decision
                :authz.decision/by (field opts :by)
                :authz.decision/reason (field opts :reason)
                :authz.decision/policy-ref (field opts :policy-ref)
                :authz.decision/policy-version (field opts :policy-version)
                :authz.decision/effect-trace (field opts :effect-trace)
                :authz.decision/obligations (obligations-of opts)
                :authz.decision/issued-at (field opts :issued-at)))
