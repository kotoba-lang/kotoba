(ns authorization.model-test (:export [main]) (:require [authorization.model :as p]))

(defn- fstr [d :document k :keyword] :string
  (option-or (document-string-value (option-or (document-get d k) (document-null))) "?"))

(defn- fedn [d :document k :keyword] :string
  (document-edn-print (option-or (document-get d k) (document-null))))

(defn- count-of [d :document k :keyword] :i64
  (document-count (option-or (document-get d k) (document-null))))

(defn- main-case [] :i64
  (let [req (p/request (document-string "R1") (document-string "alice") (document-string "read")
                       (document-string "doc/1")
                       (document-map :context (document-map :ip (document-string "x"))))
        d (p/decision req (document-keyword :allow)
                      (document-map :by (document-string "pdp")
                                    :obligations (document-vector (document-string "log"))))
        none (p/decision req (document-keyword :deny) (document-map))]
    (+ (if (string=? (fstr req :authz.request/principal) "alice") 0 1)
       (if (string=? (fstr d :authz.decision/request-id) "R1") 0 1)
       (if (string=? (fedn d :authz.decision/decision) ":allow") 0 1)
       (if (string=? (fstr d :authz.decision/by) "pdp") 0 1)
       (if (= (count-of d :authz.decision/obligations) 1) 0 1)
       (if (string=? (fedn d :authz.decision/policy-ref) "nil") 0 1)
       (if (= (count-of none :authz.decision/obligations) 0) 0 1)
       (if (string=? (fedn none :authz.decision/decision) ":deny") 0 1))))

(defn main [] :i64
  (+ (main-case)
     (if (= (document-count (p/decisions)) 3) 0 1)))
