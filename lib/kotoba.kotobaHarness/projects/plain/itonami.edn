{:id "itonami-plain" :title "itonami registered free-trial quota admission"
 :module-file "src/itonami/quota.kotoba"
 :preserved-check "(if (= (marker) 7) 0 1000)"
 :program
 {:goal "itonami free-trial admission. account-left(used) is the remaining daily quota for one account: three minus used, never below zero. admit(account-used, service-used) is true exactly when the account still has quota (zero is less than account-left of account-used) and the service-wide count service-used is less than one hundred; otherwise false."
  :stages [{:id "quota" :goal "Per-account remaining quota: subtract used from the literal three, then clamp at zero with maximum." :operations ["subtract" "maximum"] :calls [] :depends-on []} {:id "admission" :goal "If zero is less than account-left of account-used, the result is whether service-used is less than one hundred; otherwise the literal false." :operations ["less-than" "if-bool"] :calls ["account-left"] :depends-on ["quota"]}]
  :functions [{:id "account-left" :stage "quota" :args [{:name "used" :type :i64}] :returns :i64} {:id "admit" :stage "admission" :args [{:name "account-used" :type :i64} {:name "service-used" :type :i64}] :returns :bool}]
  :literals [{:id "zero" :type :i64 :value 0} {:id "three" :type :i64 :value 3} {:id "one-hundred" :type :i64 :value 100} {:id "true" :type :bool :value true} {:id "false" :type :bool :value false}]
  :max-decisions 96 :max-depth 6 :candidate-limit 8}
 :baseline "(ns itonami.quota (:export [account-left admit marker]))
;; Registered free pilot: 3 accepted attempts per account per UTC day, 100 per service.
(defn account-left [used :i64] :i64 0)
(defn admit [account-used :i64 service-used :i64] :bool false)
(defn marker [] :i64 7)
"
 :check ";; Fixed acceptance checks (exhaustive grids) per function; marker must stay 7.
(defn chk-left [used :i64] :i64 (if (< used 3) (- 3 used) 0))
(defn chk-case-account-left [a :i64] :i64 (if (= (account-left a) (chk-left a)) 0 1))
(defn chk-account-left-a [a :i64 bad :i64] :i64 (if (< a 7) (chk-account-left-a (+ a 1) (+ bad (chk-case-account-left a))) bad))
(defn chk-case-admit [a :i64 s :i64] :i64 (if (admit a s) (if (< a 3) (if (< s 100) 0 1) 1) (if (< a 3) (if (< s 100) 1 0) 0)))
(defn chk-admit-a [a :i64 bad :i64] :i64 (if (< a 7) (chk-admit-a (+ a 1) (chk-admit-s a 0 bad)) bad))
(defn chk-admit-s [a :i64 s :i64 bad :i64] :i64 (if (< s 121) (chk-admit-s a (+ s 1) (+ bad (chk-case-admit a s))) bad))
"
 :checks {"account-left" "(chk-account-left-a 0 0)" "admit" "(chk-admit-a 0 0)"}
 :cases 854
 :known {"account-left" "(max 0 (- 3 used))" "admit" "(if (< 0 (account-left account-used)) (< service-used 100) false)"}
 :wrong {"account-left" "(max 0 (- 3 used))" "admit" "(< service-used 100)"}}
