{:id "murakumo-plain" :title "murakumo gateway output-token cap"
 :module-file "src/murakumo/budget.kotoba"
 :preserved-check "(if (= (marker) 7) 0 1000)"
 :program
 {:goal "murakumo inference gateway output budget. output-cap(requested, window, prompt) is the number of output tokens to allow: the smaller of requested and the context left (window minus prompt), never below zero. can-generate(requested, window, prompt) is true exactly when zero is less than output-cap of the same three arguments in the same order."
  :stages [{:id "cap" :goal "Context left is window minus prompt; take the minimum of requested and context left, then clamp at zero with maximum." :operations ["subtract" "minimum" "maximum"] :calls [] :depends-on []} {:id "route" :goal "Generate exactly when zero is less than output-cap called with requested, window, prompt in that order." :operations ["less-than"] :calls ["output-cap"] :depends-on ["cap"]}]
  :functions [{:id "output-cap" :stage "cap" :args [{:name "requested" :type :i64} {:name "window" :type :i64} {:name "prompt" :type :i64}] :returns :i64} {:id "can-generate" :stage "route" :args [{:name "requested" :type :i64} {:name "window" :type :i64} {:name "prompt" :type :i64}] :returns :bool}]
  :literals [{:id "zero" :type :i64 :value 0}]
  :max-decisions 96 :max-depth 6 :candidate-limit 8}
 :baseline "(ns murakumo.budget (:export [output-cap can-generate marker]))
;; Murakumo gateway: cap requested output tokens to the context window left after the prompt.
(defn output-cap [requested :i64 window :i64 prompt :i64] :i64 0)
(defn can-generate [requested :i64 window :i64 prompt :i64] :bool false)
(defn marker [] :i64 7)
"
 :check ";; Fixed acceptance checks (exhaustive grids) per function; marker must stay 7.
(defn chk-cap [r :i64 w :i64 p :i64] :i64 (if (< p w) (if (< r (- w p)) r (- w p)) 0))
(defn chk-case-output-cap [r :i64 w :i64 p :i64] :i64 (if (= (output-cap r w p) (chk-cap r w p)) 0 1))
(defn chk-output-cap-r [r :i64 bad :i64] :i64 (if (< r 9) (chk-output-cap-r (+ r 1) (chk-output-cap-w r 0 bad)) bad))
(defn chk-output-cap-w [r :i64 w :i64 bad :i64] :i64 (if (< w 13) (chk-output-cap-w r (+ w 1) (chk-output-cap-p r w 0 bad)) bad))
(defn chk-output-cap-p [r :i64 w :i64 p :i64 bad :i64] :i64 (if (< p 13) (chk-output-cap-p r w (+ p 1) (+ bad (chk-case-output-cap r w p))) bad))
(defn chk-case-can-generate [r :i64 w :i64 p :i64] :i64 (if (can-generate r w p) (if (< 0 (chk-cap r w p)) 0 1) (if (< 0 (chk-cap r w p)) 1 0)))
(defn chk-can-generate-r [r :i64 bad :i64] :i64 (if (< r 9) (chk-can-generate-r (+ r 1) (chk-can-generate-w r 0 bad)) bad))
(defn chk-can-generate-w [r :i64 w :i64 bad :i64] :i64 (if (< w 13) (chk-can-generate-w r (+ w 1) (chk-can-generate-p r w 0 bad)) bad))
(defn chk-can-generate-p [r :i64 w :i64 p :i64 bad :i64] :i64 (if (< p 13) (chk-can-generate-p r w (+ p 1) (+ bad (chk-case-can-generate r w p))) bad))
"
 :checks {"output-cap" "(chk-output-cap-r 0 0)" "can-generate" "(chk-can-generate-r 0 0)"}
 :cases 3042
 :known {"output-cap" "(max 0 (min requested (- window prompt)))" "can-generate" "(< 0 (output-cap requested window prompt))"}
 :wrong {"output-cap" "(min requested (- window prompt))" "can-generate" "(< 0 (output-cap requested window prompt))"}}
