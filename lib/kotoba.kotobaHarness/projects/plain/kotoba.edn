{:id "kotoba-plain" :title "kotoba-code durable outer-loop budget"
 :module-file "src/kotoba_code/budget.kotoba"
 :preserved-check "(if (= (marker) 7) 0 1000)"
 :program
 {:goal "kotoba-code durable outer-loop budget. budget-left(used, limit) returns the remaining tool-call budget: limit minus used, never below zero. may-call(used, limit) is true exactly when some budget remains, i.e. zero is less than budget-left."
  :stages [{:id "budget" :goal "Remaining budget: subtract used from limit, then clamp at zero with maximum." :operations ["subtract" "maximum"] :calls [] :depends-on []} {:id "gate" :goal "Admit another tool call exactly when zero is less than the remaining budget computed by budget-left." :operations ["less-than"] :calls ["budget-left"] :depends-on ["budget"]}]
  :functions [{:id "budget-left" :stage "budget" :args [{:name "used" :type :i64} {:name "limit" :type :i64}] :returns :i64} {:id "may-call" :stage "gate" :args [{:name "used" :type :i64} {:name "limit" :type :i64}] :returns :bool}]
  :literals [{:id "zero" :type :i64 :value 0}]
  :max-decisions 96 :max-depth 6 :candidate-limit 8}
 :baseline "(ns kotoba-code.budget (:export [budget-left may-call marker]))
;; Durable outer-loop budget (kotoba-code durable.cljc semantics, kotoba typed subset).
(defn budget-left [used :i64 limit :i64] :i64 0)
(defn may-call [used :i64 limit :i64] :bool false)
(defn marker [] :i64 7)
"
 :check ";; Fixed acceptance checks (exhaustive grids) per function; marker must stay 7.
(defn chk-left [used :i64 limit :i64] :i64 (if (< used limit) (- limit used) 0))
(defn chk-case-budget-left [u :i64 l :i64] :i64 (if (= (budget-left u l) (chk-left u l)) 0 1))
(defn chk-budget-left-u [u :i64 bad :i64] :i64 (if (< u 16) (chk-budget-left-u (+ u 1) (chk-budget-left-l u 0 bad)) bad))
(defn chk-budget-left-l [u :i64 l :i64 bad :i64] :i64 (if (< l 16) (chk-budget-left-l u (+ l 1) (+ bad (chk-case-budget-left u l))) bad))
(defn chk-case-may-call [u :i64 l :i64] :i64 (if (may-call u l) (if (< u l) 0 1) (if (< u l) 1 0)))
(defn chk-may-call-u [u :i64 bad :i64] :i64 (if (< u 16) (chk-may-call-u (+ u 1) (chk-may-call-l u 0 bad)) bad))
(defn chk-may-call-l [u :i64 l :i64 bad :i64] :i64 (if (< l 16) (chk-may-call-l u (+ l 1) (+ bad (chk-case-may-call u l))) bad))
"
 :checks {"budget-left" "(chk-budget-left-u 0 0)" "may-call" "(chk-may-call-u 0 0)"}
 :cases 512
 :known {"budget-left" "(max 0 (- limit used))" "may-call" "(< 0 (budget-left used limit))"}
 :wrong {"budget-left" "(- limit used)" "may-call" "(< 0 (budget-left used limit))"}}
