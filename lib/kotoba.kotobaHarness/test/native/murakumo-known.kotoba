(ns verify (:export [main]))
;; Murakumo gateway: cap requested output tokens to the context window left after the prompt.
(defn output-cap [requested :i64 window :i64 prompt :i64] :i64 (max 0 (min requested (- window prompt))))
(defn can-generate [requested :i64 window :i64 prompt :i64] :bool (< 0 (output-cap requested window prompt)))
(defn marker [] :i64 7)

;; Fixed acceptance checks (exhaustive grids) per function; marker must stay 7.
(defn chk-cap [r :i64 w :i64 p :i64] :i64 (if (< p w) (if (< r (- w p)) r (- w p)) 0))
(defn chk-case-output-cap [r :i64 w :i64 p :i64] :i64 (if (= (output-cap r w p) (chk-cap r w p)) 0 1))
(defn chk-output-cap-r [r :i64 bad :i64] :i64 (if (< r 9) (chk-output-cap-r (+ r 1) (chk-output-cap-w r 0 bad)) bad))
(defn chk-output-cap-w [r :i64 w :i64 bad :i64] :i64 (if (< w 13) (chk-output-cap-w r (+ w 1) (chk-output-cap-p r w 0 bad)) bad))
(defn chk-output-cap-p [r :i64 w :i64 p :i64 bad :i64] :i64 (if (< p 13) (chk-output-cap-p r w (+ p 1) (+ bad (chk-case-output-cap r w p))) bad))
(defn chk-case-can-generate [r :i64 w :i64 p :i64] :i64 (if (can-generate r w p) (if (< 0 (chk-cap r w p)) 0 1) (if (< 0 (chk-cap r w p)) 1 0)))
(defn chk-can-generate-r [r :i64 bad :i64] :i64 (if (< r 9) (chk-can-generate-r (+ r 1) (chk-can-generate-w r 0 bad)) bad))
(defn chk-can-generate-w [r :i64 w :i64 bad :i64] :i64 (if (< w 13) (chk-can-generate-w r (+ w 1) (chk-can-generate-p r w 0 bad)) bad))
(defn chk-can-generate-p [r :i64 w :i64 p :i64 bad :i64] :i64 (if (< p 13) (chk-can-generate-p r w (+ p 1) (+ bad (chk-case-can-generate r w p))) bad))
(defn main [] :i64 (+ (if (= (marker) 7) 0 1000) (chk-can-generate-r 0 0) (chk-output-cap-r 0 0)))
