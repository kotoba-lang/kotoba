(ns kotoba-harness.data-test
  (:export [main])
  (:require [kotoba-harness.data :as d]))
(defn- check [ok :bool] :i64 (if ok 0 1))
(defn main [] :i64
  (let [edn (d/read-edn "{\n :id \"local\"\n :program {:functions [{:id \"f\" :returns :i64}]}\n :value -7}")
        program (d/field (d/value edn) :program)
        json (d/read-json "{\"answers\": {\"next_action\": {\"choice\": \"x\", \"probabilities\": {\"x\": 0.6, \"y\": 0.39}}}, \"ok\": true}")
        unicode (d/read-json "{\"x\":\"\\u0041\\ud83d\\ude00\\n\"}")
        values (d/read-json "[1, false, null, -1.25e-3]")
        wide-map (loop [i 0 out "{"]
                   (if (= i 40) (str out "}") (recur (+ i 1) (str out (if (= i 0) "" ",") (d/quote (str "k" i)) ":" i))))]
    (+ (check (string=? (d/error edn) ""))
       (check (string=? (d/text (d/field (d/value edn) :id)) "local"))
       (check (= (document-count (d/field program :functions)) 1))
       (check (= (d/integer (d/field (d/value edn) :value)) -7))
       (check (string=? (d/error json) ""))
       (check (string=? (d/error unicode) ""))
       (check (string=? (d/text (option-value-of [:option :document] (document-get (d/value unicode) (document-string "x")) (document-null))) "A😀\n"))
       (check (= (document-count (d/value values)) 4))
       (check (string=? (d/error (d/read-json "{\"x\":1,\"x\":2}")) "input-duplicate-key"))
       (check (not (string=? (d/error (d/read-json "[1,]")) "")))
       (check (not (string=? (d/error (d/read-json "{\"x\" 1}")) "")))
       (check (not (string=? (d/error (d/read-json "[01]")) "")))
       (check (not (string=? (d/error (d/read-json "\"\\ud800\"")) "")))
       (check (string=? (d/json (d/value values)) "[1,false,null,-1.25e-3]"))
       (check (d/identifier? "may-call"))
       (check (not (d/identifier? "x) (evil")))
       (check (string=? (d/error (d/read-json "9223372036854775808")) "input-i64-range"))
       (check (string=? (d/error (d/read-json "-9223372036854775809")) "input-i64-range"))
       (check (= (d/integer (d/value (d/read-json "-9223372036854775808"))) -9223372036854775808))
       (check (string=? (document-edn-print (d/value (d/read-edn "+0007"))) "7"))
       (check (= (document-count (d/value (d/read-json wide-map))) 40)))))
