(ns verify (:export [main]))
;; Durable outer-loop budget (kotoba-code durable.cljc semantics, kotoba typed subset).
(defn budget-left [used :i64 limit :i64] :i64 (- limit used))
(defn may-call [used :i64 limit :i64] :bool (< 0 (budget-left used limit)))
(defn marker [] :i64 7)

;; Fixed acceptance checks (exhaustive grids) per function; marker must stay 7.
(defn chk-left [used :i64 limit :i64] :i64 (if (< used limit) (- limit used) 0))
(defn chk-case-budget-left [u :i64 l :i64] :i64 (if (= (budget-left u l) (chk-left u l)) 0 1))
(defn chk-budget-left-u [u :i64 bad :i64] :i64 (if (< u 16) (chk-budget-left-u (+ u 1) (chk-budget-left-l u 0 bad)) bad))
(defn chk-budget-left-l [u :i64 l :i64 bad :i64] :i64 (if (< l 16) (chk-budget-left-l u (+ l 1) (+ bad (chk-case-budget-left u l))) bad))
(defn chk-case-may-call [u :i64 l :i64] :i64 (if (may-call u l) (if (< u l) 0 1) (if (< u l) 1 0)))
(defn chk-may-call-u [u :i64 bad :i64] :i64 (if (< u 16) (chk-may-call-u (+ u 1) (chk-may-call-l u 0 bad)) bad))
(defn chk-may-call-l [u :i64 l :i64 bad :i64] :i64 (if (< l 16) (chk-may-call-l u (+ l 1) (+ bad (chk-case-may-call u l))) bad))
(defn main [] :i64 (+ (if (= (marker) 7) 0 1000) (chk-budget-left-u 0 0) (chk-may-call-u 0 0)))
