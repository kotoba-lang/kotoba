(ns kotoba-harness.catalog-test
  (:export [main])
  (:require [kotoba-harness.data :as d] [kotoba-harness.catalog :as c]))
(defn- check [ok :bool] :i64 (if ok 0 1))
(defn main [] :i64
  (let [raw (typed-cap-call :io/read :string :string "")
        parsed (d/read-edn raw) project (d/value parsed) p (d/field project :program)
        plan (c/prepare p) fns (d/field p :functions) stages (d/field p :stages)
        known (d/field project :known) source (c/splice p (d/text (d/field project :baseline)) known)
        bad-op (document-assoc (d/at stages 0) :operations (document-vector (document-string "filterv")))
        future-call (document-assoc (d/at stages 0) :calls (document-vector (document-string "admit")))
        bad-return (document-assoc (d/at fns 0) :returns (document-keyword :string))
        choices (c/candidates p 0 (document-keyword :i64) 0)]
    (+ (check (string=? (d/error parsed) ""))
       (check (string=? (c/failure plan) ""))
       (check (string=? (c/project-error project plan) ""))
       (check (= (vector-count (c/units plan)) 2))
       (check (string=? (c/failure (c/prepare (document-assoc p :stages (document-vector-assoc stages 0 bad-op)))) "stage-contract"))
       (check (string=? (c/failure (c/prepare (document-assoc p :stages (document-vector-assoc stages 0 future-call)))) "stage-call-dependency"))
       (check (string=? (c/failure (c/prepare (document-assoc p :functions (document-vector-assoc fns 0 bad-return)))) "function-contract"))
       (check (string=? (d/error source) ""))
       (check (>= (string-index-of (d/text (d/value source)) "(defn marker [] :i64 7)") 0))
       (check (string=? (d/error (c/splice p "(ns x)\n" known)) "baseline-shape"))
       (check (= (vector-count choices) 6))
       (check (string=? (d/text (d/field (typed-list-nth [:list :document] choices 0) :id)) "argument-used"))
       (check (string=? (d/text (d/field (typed-list-nth [:list :document] choices 4) :id)) "subtract"))
       (check (string=? (d/text (d/field (typed-list-nth [:list :document] choices 5) :id)) "maximum")))))
