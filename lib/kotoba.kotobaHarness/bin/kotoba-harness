#!/bin/sh
# Canonical Kotoba controller. --all retains the separate fixed-corpus gate.
set -eu
harness_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "${1:-}" = --all ]; then
  exec python3 -B "$harness_root/bin/native-controls.py" "$@"
fi
exec python3 -B "$harness_root/bin/native-transport.py" "$@"
