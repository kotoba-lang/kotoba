#!/bin/sh
# Alternating rounds: guided and plain wording, escalation on and off.
# usage: bin/bench [rounds] [out-dir]
set -u
home=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
rounds=${1:-5}; out=${2:-$home/runs/bench}
mkdir -p "$out"
i=1; while [ "$i" -le "$rounds" ]; do
  for esc in 1 0; do for variant in "" plain/; do for p in kotoba itonami murakumo; do
    KOTOBA_HARNESS_ESCALATE=$esc "$home/bin/kotoba-harness" "$home/projects/$variant$p.edn" jev "$out" 2>&1 | head -1 | sed "s/^/round $i escalate=$esc /"
  done; done; done
  i=$((i+1))
done
