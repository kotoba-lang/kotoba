(ns kotoba-harness.catalog
  (:export [prepare program order failure function stage find-function find-stage
            units candidates signature splice project-error operation])
  (:require [kotoba-harness.data :as d])
  (:schemas {:harness/plan [:record :harness/plan
                          [[:program :document] [:order :vector-i64] [:error :string]]]}))

(defn program [p [:ref :harness/plan]] :document (record-get [:ref :harness/plan] p :program))
(defn order [p [:ref :harness/plan]] :vector-i64 (record-get [:ref :harness/plan] p :order))
(defn failure [p [:ref :harness/plan]] :string (record-get [:ref :harness/plan] p :error))
(defn- countv [v :document] :i64 (if (d/kind? v :vector) (document-count v) -1))
(defn- find-id [v :document key :keyword id :string] :i64
  (if (not (d/kind? v :vector)) -1
    (loop [i 0] (cond (= i (document-count v)) -1
                      (string=? (d/text (d/field (d/at v i) key)) id) i :else (recur (+ i 1))))))
(defn find-function [p :document id :string] :i64 (find-id (d/field p :functions) :id id))
(defn find-stage [p :document id :string] :i64 (find-id (d/field p :stages) :id id))
(defn function [p :document i :i64] :document (d/at (d/field p :functions) i))
(defn stage [p :document i :i64] :document (d/at (d/field p :stages) i))
(defn- type? [v :document] :bool
  (or (document-equal? v (document-keyword :i64)) (document-equal? v (document-keyword :bool))))
(defn- unique? [v :document key :keyword] :bool
  (loop [i 0]
    (if (= i (document-count v)) true
      (let [id (d/text (d/field (d/at v i) key))]
        (and (= (find-id v key id) i) (recur (+ i 1)))))))
(defn- shape? [p :document] :bool
  (let [f (d/field p :functions) s (d/field p :stages) l (d/field p :literals)
        goal (d/field p :goal) decisions (d/field p :max-decisions)
        depth (d/field p :max-depth) limit (d/field p :candidate-limit)]
    (and (d/kind? goal :string) (>= (d/utf16-count (d/text goal)) 1) (<= (d/utf16-count (d/text goal)) 4096)
         (>= (countv f) 1) (<= (countv f) 16) (unique? f :id)
         (>= (countv s) 1) (<= (countv s) 16) (unique? s :id)
         (>= (countv l) 0) (<= (countv l) 32)
         (d/kind? decisions :i64) (> (d/integer decisions) 0) (<= (d/integer decisions) 256)
         (d/kind? depth :i64) (> (d/integer depth) 0) (<= (d/integer depth) 16)
         (d/kind? limit :i64) (>= (d/integer limit) 4) (<= (d/integer limit) 16))))
(defn- function? [p :document f :document] :bool
  (let [args (d/field f :args) goal (d/field f :goal)]
    (and (d/identifier? (d/text (d/field f :id)))
         (>= (find-stage p (d/text (d/field f :stage))) 0)
         (or (d/kind? goal :null) (and (d/kind? goal :string) (>= (d/utf16-count (d/text goal)) 1) (<= (d/utf16-count (d/text goal)) 1024)))
         (type? (d/field f :returns)) (>= (countv args) 0) (<= (countv args) 8) (unique? args :name)
         (loop [i 0]
           (if (= i (document-count args)) true
             (let [arg (d/at args i)]
               (and (d/identifier? (d/text (d/field arg :name))) (type? (d/field arg :type)) (recur (+ i 1)))))))))
(defn- literal? [v :document] :bool
  (let [type (d/field v :type) value (d/field v :value)]
    (and (d/identifier? (d/text (d/field v :id)))
         (or (and (document-equal? type (document-keyword :i64)) (d/kind? value :i64))
             (and (document-equal? type (document-keyword :bool)) (d/kind? value :bool))))))
(defn operation [i :i64] :document
  (let [id (case i 0 "add" 1 "subtract" 2 "multiply" 3 "minimum" 4 "maximum" 5 "less-than" 6 "equal" 7 "if-i64" "if-bool")
        emit (case i 0 "+" 1 "-" 2 "*" 3 "min" 4 "max" 5 "<" 6 "=" "if")
        description (case i 0 "Child 0 plus child 1." 1 "Child 0 minus child 1 (order matters)."
                     2 "Child 0 times child 1." 3 "The smaller of the two children."
                     4 "The larger of the two children; (max 0 x) clamps x at zero."
                     5 "True exactly when child 0 is strictly less than child 1."
                     6 "True exactly when the two integer children are equal."
                     "If child 0 then child 1 else child 2.")
        output (if (or (= i 5) (= i 6) (= i 8)) (document-keyword :bool) (document-keyword :i64))
        inputs (cond (= i 7) (document-vector (document-keyword :bool) (document-keyword :i64) (document-keyword :i64))
                     (= i 8) (document-vector (document-keyword :bool) (document-keyword :bool) (document-keyword :bool))
                     :else (document-vector (document-keyword :i64) (document-keyword :i64)))]
    (document-map :id (document-string id) :emit (document-string emit) :in inputs :out output
                  :description (document-string description) :kind (document-keyword :operation))))
(defn- operation-id? [s :string] :bool
  (loop [i 0] (cond (= i 9) false (string=? s (d/text (d/field (operation i) :id))) true :else (recur (+ i 1)))))
(defn- stage? [p :document s :document] :bool
  (let [ops (d/field s :operations) calls (d/field s :calls) deps (d/field s :depends-on)]
    (and (d/identifier? (d/text (d/field s :id))) (d/kind? (d/field s :goal) :string)
         (or (d/kind? ops :null) (and (d/kind? ops :vector)
             (loop [i 0] (if (= i (document-count ops)) true (and (operation-id? (d/text (d/at ops i))) (recur (+ i 1)))))))
         (or (d/kind? calls :null) (and (d/kind? calls :vector)
             (loop [i 0] (if (= i (document-count calls)) true (and (>= (find-function p (d/text (d/at calls i))) 0) (recur (+ i 1)))))))
         (or (d/kind? deps :null) (and (d/kind? deps :vector)
             (loop [i 0] (if (= i (document-count deps)) true (and (>= (find-stage p (d/text (d/at deps i))) 0) (recur (+ i 1))))))))))
(defn- contracts [p :document] :string
  (let [fns (d/field p :functions) literals (d/field p :literals) stages (d/field p :stages)
        f-ok (loop [i 0] (if (= i (document-count fns)) true (and (function? p (d/at fns i)) (recur (+ i 1)))))
        l-ok (loop [i 0] (if (= i (document-count literals)) true (and (literal? (d/at literals i)) (recur (+ i 1)))))
        s-ok (loop [i 0] (if (= i (document-count stages)) true (and (stage? p (d/at stages i)) (recur (+ i 1)))))]
    (cond (not f-ok) "function-contract" (not l-ok) "literal-contract" (not s-ok) "stage-contract" :else "")))
(defn- rank [order :vector-i64 item :i64] :i64
  (loop [i 0] (cond (= i (vector-count order)) -1 (= item (vector-at order i)) i :else (recur (+ i 1)))))
(defn- ready? [p :document s :i64 order :vector-i64] :bool
  (let [deps (d/field (stage p s) :depends-on)]
    (or (d/kind? deps :null)
        (loop [i 0] (if (= i (document-count deps)) true
          (and (>= (rank order (find-stage p (d/text (d/at deps i)))) 0) (recur (+ i 1))))))))
(defn- topological [p :document] :vector-i64
  (let [n (document-count (d/field p :stages))]
    (loop [out (vector-i64)]
      (if (= (vector-count out) n) out
        (let [s (loop [i 0]
                  (cond (= i n) -1 (and (< (rank out i) 0) (ready? p i out)) i :else (recur (+ i 1))))]
          (if (< s 0) out (recur (vector-conj out s))))))))
(defn- calls-ordered? [p :document order :vector-i64] :bool
  (loop [i 0]
    (if (= i (vector-count order)) true
      (let [calls (d/field (stage p (vector-at order i)) :calls)
            valid (or (d/kind? calls :null)
                      (loop [j 0]
                        (if (= j (document-count calls)) true
                          (let [f (function p (find-function p (d/text (d/at calls j))))
                                s (find-stage p (d/text (d/field f :stage)))]
                            (and (<= (rank order s) i) (recur (+ j 1)))))))]
        (and valid (recur (+ i 1)))))))
(defn prepare [p :document] [:ref :harness/plan]
  (if (not (shape? p)) (record-new [:ref :harness/plan] p (vector-i64) "program-shape")
    (let [err (contracts p)]
      (if (not (string=? err "")) (record-new [:ref :harness/plan] p (vector-i64) err)
        (let [ordered (topological p)
              e (cond (not= (vector-count ordered) (document-count (d/field p :stages))) "stage-cycle"
                      (not (calls-ordered? p ordered)) "stage-call-dependency" :else "")]
          (record-new [:ref :harness/plan] p ordered e))))))
(defn units [plan [:ref :harness/plan]] :vector-i64
  (let [p (program plan) ordered (order plan) fns (d/field p :functions)]
    (loop [s 0 out (vector-i64)]
      (if (= s (vector-count ordered)) out
        (let [id (d/field (stage p (vector-at ordered s)) :id)
              more (loop [i 0 result out]
                     (if (= i (document-count fns)) result
                       (recur (+ i 1) (if (document-equal? id (d/field (d/at fns i) :stage)) (vector-conj result i) result))))]
          (recur (+ s 1) more))))))
(defn- argument-candidates [f :document type :document] [:list :document]
  (let [args (d/field f :args)]
    (loop [i 0 out (typed-list-new [:list :document])]
      (if (= i (document-count args)) out
        (let [a (d/at args i) name (d/text (d/field a :name))]
          (recur (+ i 1) (if (document-equal? type (d/field a :type))
            (typed-list-conj [:list :document] out
              (document-map :id (document-string (string-concat "argument-" name)) :kind (document-keyword :argument)
                            :name (document-string name) :type type)) out)))))))
(defn candidates [p :document fid :i64 type :document depth :i64] [:list :document]
  (let [f (function p fid) s (stage p (find-stage p (d/text (d/field f :stage))))
        literals (d/field p :literals) deep (< depth (d/integer (d/field p :max-depth)))
        args (argument-candidates f type)
        with-literals (loop [i 0 out args]
          (if (= i (document-count literals)) out
            (let [l (d/at literals i)]
              (recur (+ i 1) (if (document-equal? type (d/field l :type))
                (typed-list-conj [:list :document] out
                  (document-map :id (document-string (string-concat "literal-" (d/text (d/field l :id))))
                                :kind (document-keyword :literal) :value (d/field l :value) :type type)) out)))))
        with-ops (loop [i 0 out with-literals]
          (if (= i 9) out
            (let [op (operation i)]
              (recur (+ i 1) (if (and deep (document-equal? type (d/field op :out))
                                                     (d/member? (d/field s :operations) (d/field op :id)))
                (typed-list-conj [:list :document] out op) out)))))
        calls (d/field s :calls)]
    (loop [i 0 out with-ops]
      (if (or (not deep) (d/kind? calls :null) (= i (document-count calls))) out
        (let [id (d/text (d/at calls i)) g (function p (find-function p id)) a (d/field g :args)
              in (loop [j 0 v (document-vector)] (if (= j (document-count a)) v (recur (+ j 1) (document-vector-conj v (d/field (d/at a j) :type)))))
              names (loop [j 0 text ""] (if (= j (document-count a)) text
                      (recur (+ j 1) (string-concat text (string-concat (if (= j 0) "" ", ") (d/text (d/field (d/at a j) :name)))))))]
          (recur (+ i 1) (if (document-equal? type (d/field g :returns))
            (typed-list-conj [:list :document] out
              (document-map :id (document-string (string-concat "call-" id)) :kind (document-keyword :call)
                            :function (document-string id) :emit (document-string id) :in in :out type
                            :description (document-string (string-concat "Call " (string-concat id (string-concat " with arguments (" (string-concat names ") in that order."))))))) out)))))))
(defn signature [f :document] :string
  (let [args (d/field f :args)
        a (loop [i 0 out ""]
            (if (= i (document-count args)) out
              (let [x (d/at args i)]
                (recur (+ i 1) (string-concat out (string-concat (if (= i 0) "" " ")
                  (string-concat (d/text (d/field x :name)) (string-concat " " (document-edn-print (d/field x :type))))))))))]
    (str "(defn " (d/text (d/field f :id)) " [" a "] " (document-edn-print (d/field f :returns)) " ")))
(defn- starts? [line :string prefix :string] :bool
  (and (>= (string-length line) (string-length prefix)) (string=? (string-substring line 0 (string-length prefix)) prefix)))
(defn splice [p :document baseline :string bodies :document] [:ref :harness/parsed]
  (loop [pos 0 out "" hits 0]
    (if (> pos (string-length baseline))
      (d/make-result (document-string out) hits (if (= hits (document-count bodies)) "" "baseline-shape"))
      (let [end (loop [i pos] (if (or (= i (string-length baseline)) (= (string-code-point-at baseline i) 10)) i (recur (+ i 1))))
            line (string-substring baseline pos end)
            fns (d/field p :functions)
            match (loop [i 0]
                    (cond (= i (document-count fns)) -1
                          (and (document-contains bodies (d/field (d/at fns i) :id)) (starts? line (signature (d/at fns i)))) i
                          :else (recur (+ i 1))))
            body (if (< match 0) line
                   (string-concat (signature (function p match))
                     (string-concat (d/text (option-value-of [:option :document] (document-get bodies (d/field (function p match) :id)) (document-null))) ")")))
            next (string-concat out (string-concat body (if (< end (string-length baseline)) "\n" "")))]
        (recur (+ end 1) next (+ hits (if (< match 0) 0 1)))))))
(defn- keys-match? [m :document fns :document] :bool
  (and (d/kind? m :map) (= (document-count m) (document-count fns))
       (loop [i 0] (if (= i (document-count fns)) true
         (and (document-contains m (d/field (d/at fns i) :id)) (recur (+ i 1)))))))
(defn project-error [project :document plan [:ref :harness/plan]] :string
  (if (not (string=? (failure plan) "")) (failure plan)
    (let [p (program plan) fns (d/field p :functions)
          keys-ok (loop [which 0]
                    (if (= which 3) true
                      (and (keys-match? (d/field project (case which 0 :checks 1 :known :wrong)) fns)
                           (recur (+ which 1)))))]
      (if (not keys-ok) "project-checks"
        (let [known (splice p (d/text (d/field project :baseline)) (d/field project :known))
              wrong (splice p (d/text (d/field project :baseline)) (d/field project :wrong))]
          (if (not (string=? (d/error known) "")) (d/error known) (d/error wrong)))))))
