(ns kotoba-harness.ast
  (:export [initial node hole fill render role replace-node])
  (:require [kotoba-harness.data :as d] [kotoba-harness.catalog :as c]))

;; Flat immutable arena: depth-16 trees and >32 decisions must not be squeezed
;; into the bounded document collection ABI. Frames retain arena snapshots.
(defn node [nodes [:list :document] i :i64] :document (typed-list-nth [:list :document] nodes i))
(defn- empty-node [type :document depth :i64 parent :i64 slot :i64] :document
  (document-map :type type :depth (document-i64 depth) :parent (document-i64 parent)
                :slot (document-i64 slot) :candidate (document-null) :children (document-vector)))
(defn initial [type :document] [:list :document]
  (typed-list-conj [:list :document] (typed-list-new [:list :document]) (empty-node type 0 -1 0)))
(defn replace-node [nodes [:list :document] index :i64 value :document] [:list :document]
  (loop [i 0 out (typed-list-new [:list :document])]
    (if (= i (vector-count nodes)) out
      (recur (+ i 1) (typed-list-conj [:list :document] out (if (= i index) value (node nodes i)))))))
(defn hole [nodes [:list :document] i :i64] :i64
  (let [n (node nodes i) children (d/field n :children)]
    (if (d/kind? (d/field n :candidate) :null) i
      (loop [j 0]
        (if (= j (document-count children)) -1
          (let [h (hole nodes (d/integer (d/at children j)))]
            (if (>= h 0) h (recur (+ j 1)))))))))
(defn fill [nodes [:list :document] index :i64 candidate :document] [:list :document]
  (let [n (node nodes index) inputs (d/field candidate :in)
        count (if (d/kind? inputs :vector) (document-count inputs) 0)
        start (vector-count nodes)
        children (loop [i 0 out (document-vector)]
                   (if (= i count) out (recur (+ i 1) (document-vector-conj out (document-i64 (+ start i))))))
        replaced (replace-node nodes index (document-assoc (document-assoc n :candidate candidate) :children children))]
    (loop [i 0 out replaced]
      (if (= i count) out
        (recur (+ i 1) (typed-list-conj [:list :document] out
          (empty-node (d/at inputs i) (+ 1 (d/integer (d/field n :depth))) index i)))))))
(defn render [nodes [:list :document] index :i64 focus :i64] :string
  (let [n (node nodes index) cand (d/field n :candidate) kind (d/field cand :kind)]
    (cond (= index focus) "?"
          (d/kind? cand :null) "_"
          (document-equal? kind (document-keyword :argument)) (d/text (d/field cand :name))
          (document-equal? kind (document-keyword :literal)) (document-edn-print (d/field cand :value))
          :else
          (let [children (d/field n :children)
                args (loop [i 0 out ""]
                       (if (= i (document-count children)) out
                         (recur (+ i 1) (str out " " (render nodes (d/integer (d/at children i)) focus)))))]
            (str "(" (d/text (d/field cand :emit)) args ")")))))
(defn role [p :document fid :i64 nodes [:list :document] h :i64] :string
  (let [n (node nodes h) parent (d/integer (d/field n :parent)) f (c/function p fid)]
    (if (< parent 0) (str "the whole body of " (d/text (d/field f :id)) ", returning " (document-edn-print (d/field f :returns)))
      (let [pn (node nodes parent) cand (d/field pn :candidate) slot (d/integer (d/field n :slot))]
        (if (document-equal? (d/field cand :kind) (document-keyword :call))
          (let [g (c/function p (c/find-function p (d/text (d/field cand :emit)))) a (d/at (d/field g :args) slot)]
            (str "argument " (+ slot 1) " of " (document-count (d/field pn :children)) " in the call to "
                 (d/text (d/field cand :emit)) ": the parameter " (d/text (d/field a :name)) " " (document-edn-print (d/field a :type))))
          (str "child " slot " of " (d/text (d/field cand :id)) " (" (d/text (d/field cand :description)) ")"))))))
