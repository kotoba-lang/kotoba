(ns kotoba-harness.verification
  (:export [sources judge])
  (:require [kotoba-harness.data :as d] [kotoba-harness.catalog :as c]))
(defn- less? [a :string b :string] :bool
  (loop [i 0]
    (cond (= i (string-length a)) (< i (string-length b)) (= i (string-length b)) false
          (< (string-code-point-at a i) (string-code-point-at b i)) true
          (> (string-code-point-at a i) (string-code-point-at b i)) false :else (recur (+ i 1)))))
(defn- ordered [bodies :document] :document
  (loop [n 0 out (document-vector)]
    (if (= n (document-count bodies)) out
      (let [next (loop [i 0 best ""]
                   (if (= i (document-count bodies)) best
                     (let [pair (option-value-of [:option :document] (document-map-entry-at bodies i) (document-vector)) id (d/at pair 0) text (d/text id)]
                       (recur (+ i 1) (if (and (not (d/member? out id)) (or (string=? best "") (less? text best))) text best)))))]
        (recur (+ n 1) (document-vector-conj out (document-string next)))))))
(defn- module-path? [v :document] :bool
  (let [s (d/text v) n (string-length s)]
    (and (d/kind? v :string) (> n 7) (<= n 256) (string=? (string-substring s (- n 7) n) ".kotoba")
         (loop [i 0 start 0]
           (if (= i n) (> i start)
             (let [c (string-code-point-at s i)]
               (if (= c 47)
                 (let [segment (string-substring s start i)]
                   (and (> i start) (not (string=? segment ".")) (not (string=? segment "..")) (recur (+ i 1) (+ i 1))))
                 (and (or (and (>= c 48) (<= c 57)) (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122)) (= c 45) (= c 46) (= c 95))
                      (recur (+ i 1) start)))))))))
(defn sources [project :document bodies :document] [:ref :harness/parsed]
  (let [source (c/splice (d/field project :program) (d/text (d/field project :baseline)) bodies)
        text (d/text (d/value source)) newline (string-index-of text "\n") checked (ordered bodies)
        checks (loop [i 0 out ""]
                 (if (= i (document-count checked)) out
                   (let [v (option-value-of [:option :document] (document-get (d/field project :checks) (d/at checked i)) (document-null))]
                     (recur (+ i 1) (str out " " (d/text v))))))]
    (if (not (module-path? (d/field project :module-file))) (d/make-result (document-null) 0 "module-path")
      (if (not (string=? (d/error source) "")) source
      (if (< newline 0) (d/make-result (document-null) 0 "baseline-namespace")
        (d/make-result (document-map :source (document-string text) :module-file (d/field project :module-file) :checked checked
          :verify-source (document-string (str "(ns verify (:export [main]))\n" (string-substring text (+ newline 1) (string-length text))
                            "\n" (d/text (d/field project :check)) "(defn main [] :i64 (+ " (d/text (d/field project :preserved-check)) checks "))\n"))) 0 ""))))))
(defn- digest? [v :document] :bool
  (let [s (d/text v)]
    (and (d/kind? v :string) (= (string-length s) 64)
         (loop [i 0]
           (if (= i 64) true
             (let [c (string-code-point-at s i)]
               (and (or (and (>= c 48) (<= c 57)) (and (>= c 97) (<= c 102))) (recur (+ i 1)))))))))
(defn judge [observation :document checked :document] :document
  (let [check (d/field observation :check) compile (d/field observation :compile) browser (d/field observation :browser)
        raw (d/field browser :stdout) parsed (d/read-edn (d/text raw)) report (d/value parsed)
        result (d/field report :result) trap (d/field browser :wasmTrap)
        valid (and (d/kind? (d/field check :exit) :i64) (= (d/integer (d/field check :exit)) 0)
                   (d/kind? (d/field compile :exit) :i64) (= (d/integer (d/field compile :exit)) 0)
                   (d/kind? (d/field browser :exit) :i64) (= (d/integer (d/field browser :exit)) 0)
                   (string=? (d/error parsed) "") (document-equal? (d/field report :status) (document-keyword :ok))
                   (or (d/kind? trap :null) (and (d/kind? trap :string) (string=? (d/text trap) "")))
                   (digest? (d/field observation :wasm-sha256)) (d/kind? result :i64) (>= (d/integer result) 0))]
    (document-map :passed (document-bool (and valid (= (d/integer result) 0))) :blocked (document-bool (not valid))
      :checked checked :kotoba-check (document-bool (and (d/kind? (d/field check :exit) :i64) (= (d/integer (d/field check :exit)) 0)))
      :compiled (document-bool (and (d/kind? (d/field compile :exit) :i64) (= (d/integer (d/field compile :exit)) 0)))
      :failures (if valid (document-string (str (d/integer result))) (document-null)) :trap trap
      :wasm-sha256 (d/field observation :wasm-sha256) :browser (d/field observation :version) :verify-ms (d/field observation :wall-ms))))
