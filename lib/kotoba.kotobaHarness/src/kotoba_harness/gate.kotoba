(ns kotoba-harness.gate (:export [main])
  (:require [kotoba-harness.data :as d] [kotoba-harness.io :as io]))
(defn- exchange [effect :document] :document
  (let [sent (io/send (d/json effect)) r (io/receive)]
    (if (or (not= sent 0) (not (string=? (d/error r) ""))) (document-null)
      (d/value (d/read-json (d/text (d/value r)))))))
(defn- script [i :i64] :document
  (d/value (d/read-json
    (case i
      0 "[\"maximum\",\"literal-zero\",\"subtract\",\"argument-limit\",\"argument-used\",\"less-than\",\"literal-zero\",\"call-budget-left\",\"argument-used\",\"argument-limit\"]"
      1 "[\"subtract\",\"literal-three\",\"argument-used\",\"stop\",\"stop\",\"maximum\",\"literal-zero\",\"subtract\",\"literal-three\",\"argument-used\",\"if-bool\",\"less-than\",\"literal-zero\",\"call-account-left\",\"argument-account-used\",\"less-than\",\"argument-service-used\",\"literal-one-hundred\",\"literal-false\"]"
      "[\"maximum\",\"literal-zero\",\"minimum\",\"argument-requested\",\"subtract\",\"argument-window\",\"argument-prompt\",\"less-than\",\"literal-zero\",\"call-output-cap\",\"argument-requested\",\"argument-window\",\"argument-prompt\"]"))))
(defn- finish [status :string error :string passed :i64] :i64
  (let [code (if (string=? status "verified") 0 1)
        receipt (document-map :format (document-string "kotoba-harness.native-gate/v1") :status (document-string status)
                  :error (document-string error) :passed (document-i64 passed) :original-tests (document-i64 6) :original-assertions (document-i64 25))
        sent (io/send (d/json (document-map :op (document-string "finish") :receipt (document-string (d/json receipt)) :exit (document-i64 code))))]
    (if (= sent 0) code 78)))
(defn main [] :i64
  (let [frame (io/receive) config (d/value (d/read-json (d/text (d/value frame)))) projects (d/field config :projects)
        tests (document-vector (document-string "data") (document-string "catalog") (document-string "search") (document-string "boundary"))
        tested (loop [i 0]
                 (if (= i (document-count tests)) i
                   (let [obs (exchange (document-map :op (document-string "native-test") :entry (d/at tests i)))
                         report (d/value (d/read-edn (d/text (d/field obs :stdout))))]
                     (if (and (d/kind? (d/field obs :exit) :i64) (= (d/integer (d/field obs :exit)) 0)
                              (document-equal? (d/field report :status) (document-keyword :ok))
                              (d/kind? (d/field report :result) :i64) (= (d/integer (d/field report :result)) 0))
                       (recur (+ i 1)) i))))]
    (if (not= tested 4) (finish "failed" (str "native-test-" tested) tested)
      (loop [i 0]
        (if (= i 13) (finish "verified" "" (+ tested i))
          (if (= i 12)
            (let [all (loop [j 0 out (document-vector)]
                        (if (= j 6) out (recur (+ j 1) (document-vector-conj out (d/at projects (rem j 3))))))
                  obs (exchange (document-map :op (document-string "benchmark") :projects all :rounds (document-i64 1) :budget-usd (document-edn-read "0.00001")))
                  r (d/value (d/read-json (d/text (d/field obs :receipt))))]
              (if (and (= (d/integer (d/field obs :exit)) 1) (string=? (d/text (d/field r :status)) "budget-exhausted")
                       (= (d/integer (d/field r :runs)) 0))
                (recur (+ i 1)) (finish "failed" "benchmark-budget" (+ tested i))))
          (let [project (quot i 3) mode (rem i 3)
                method (cond (< i 9) (case mode 0 "known" 1 "wrong" "scripted") (= i 9) "scripted" (= i 10) "scripted" :else "jev")
                p (if (< i 9) project 1)
                scr (cond (= i 9) (document-vector (document-string "stop")) :else (script p))
                request (document-map :op (document-string "session") :project (d/at projects p) :method (document-string method)
                          :script scr :escalate (document-bool (not= i 10)) :budget-usd (document-edn-read "0.00001"))
                obs (exchange request) receipt (d/value (d/read-json (d/text (d/field obs :receipt))))
                status (d/text (d/field receipt :status)) exit (d/integer (d/field obs :exit))
                pass (cond (< i 9)
                            (if (= mode 1)
                              (and (= exit 1) (string=? status "rejected") (string=? (d/text (d/field (d/field receipt :verification) :failures)) (case project 0 "120" 1 "400" "702")))
                              (and (= exit 0) (string=? status "verified") (d/truth (d/field (d/field receipt :verification) :passed))))
                           :else (and (= exit 1) (string=? status "refused")
                                      (string=? (d/text (d/field receipt :error)) (case i 9 "search-exhausted" 10 "policy-stopped" "api-budget"))))]
            (if pass (recur (+ i 1)) (finish "failed" (str "session-" i "-" status) (+ tested i))))))))))
