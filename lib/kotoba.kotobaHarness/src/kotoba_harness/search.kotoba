(ns kotoba-harness.search
  (:export [start advance answer verified phase failure bodies audit attempts offered request rejected current-state verification abort])
  (:require [kotoba-harness.data :as d] [kotoba-harness.catalog :as c]
            [kotoba-harness.ast :as a] [kotoba-harness.decision :as j])
  (:schemas
    {:harness/frame [:record :harness/frame [[:nodes [:list :document]] [:excluded [:list :document]] [:remaining :i64] [:choice :string]]]
     :harness/search [:record :harness/search
       [[:program :document] [:units :vector-i64] [:position :i64] [:nodes [:list :document]]
        [:frames [:list [:ref :harness/frame]]] [:excluded [:list :document]] [:page :i64]
        [:audit [:list :document]] [:attempts [:list :document]] [:rejected :document]
        [:fixed :document] [:verification :document] [:n-attempts :i64] [:retry :i64]
        [:phase :string] [:error :string] [:offered :document] [:request :document] [:escalate :bool]]]}))

(defn phase [s [:ref :harness/search]] :string (record-get [:ref :harness/search] s :phase))
(defn failure [s [:ref :harness/search]] :string (record-get [:ref :harness/search] s :error))
(defn audit [s [:ref :harness/search]] [:list :document] (record-get [:ref :harness/search] s :audit))
(defn attempts [s [:ref :harness/search]] [:list :document] (record-get [:ref :harness/search] s :attempts))
(defn offered [s [:ref :harness/search]] :document (record-get [:ref :harness/search] s :offered))
(defn request [s [:ref :harness/search]] :document (record-get [:ref :harness/search] s :request))
(defn verification [s [:ref :harness/search]] :document (record-get [:ref :harness/search] s :verification))
(defn rejected [s [:ref :harness/search]] :document (record-get [:ref :harness/search] s :rejected))
(defn- p [s [:ref :harness/search]] :document (record-get [:ref :harness/search] s :program))
(defn- fid [s [:ref :harness/search]] :i64
  (vector-at (record-get [:ref :harness/search] s :units) (record-get [:ref :harness/search] s :position)))
(defn- nodes [s [:ref :harness/search]] [:list :document] (record-get [:ref :harness/search] s :nodes))
(defn- context [s [:ref :harness/search]] :document
  (let [f (c/function (p s) (fid s))]
    (document-map :stage (d/field f :stage) :function (d/field f :id))))
(defn- refuse [s [:ref :harness/search] error :string] [:ref :harness/search]
  (record-assoc [:ref :harness/search] (record-assoc [:ref :harness/search] s :phase "refused") :error error))
(defn abort [s [:ref :harness/search] error :string] [:ref :harness/search] (refuse s error))
(defn start [plan [:ref :harness/plan] escalate :bool] [:ref :harness/search]
  (let [p (c/program plan) units (c/units plan) f (c/function p (vector-at units 0))]
    (record-new [:ref :harness/search] p units 0 (a/initial (d/field f :returns))
      (typed-list-new [:list [:ref :harness/frame]]) (typed-list-new [:list :document]) 0
      (typed-list-new [:list :document]) (typed-list-new [:list :document]) (document-vector)
      (document-map) (document-null) 0 0 "step" "" (document-vector) (document-null) escalate)))
(defn bodies [s [:ref :harness/search]] :document
  (document-assoc (record-get [:ref :harness/search] s :fixed) (d/field (c/function (p s) (fid s)) :id)
                  (document-string (a/render (nodes s) 0 -1))))
(defn- rewind [s [:ref :harness/search] cause :string] [:ref :harness/search]
  (let [frames (record-get [:ref :harness/search] s :frames)
        index (loop [i (- (vector-count frames) 1)]
                (cond (< i 0) -1 (> (record-get [:ref :harness/frame] (typed-list-nth [:list [:ref :harness/frame]] frames i) :remaining) 0) i
                      :else (recur (- i 1))))]
    (if (< index 0) (refuse s "search-exhausted")
      (let [f (typed-list-nth [:list [:ref :harness/frame]] frames index)
            before (loop [i 0 out (typed-list-new [:list [:ref :harness/frame]])]
                     (if (= i index) out (recur (+ i 1) (typed-list-conj [:list [:ref :harness/frame]] out (typed-list-nth [:list [:ref :harness/frame]] frames i)))))
            event (document-assoc (document-assoc (context s) :event (document-string cause)) :rewound-to (document-string (record-get [:ref :harness/frame] f :choice)))
            s1 (record-assoc [:ref :harness/search] s :nodes (record-get [:ref :harness/frame] f :nodes))
            s2 (record-assoc [:ref :harness/search] s1 :excluded (record-get [:ref :harness/frame] f :excluded))
            s3 (record-assoc [:ref :harness/search] s2 :frames before)
            s4 (record-assoc [:ref :harness/search] s3 :audit (typed-list-conj [:list :document] (audit s) event))
            s5 (record-assoc [:ref :harness/search] s4 :page 0)]
        (record-assoc [:ref :harness/search] s5 :phase "step")))))
(defn- legal [s [:ref :harness/search] h :i64] [:list :document]
  (let [n (a/node (nodes s) h) all (c/candidates (p s) (fid s) (d/field n :type) (d/integer (d/field n :depth)))
        excluded (record-get [:ref :harness/search] s :excluded)]
    (loop [i 0 out (typed-list-new [:list :document])]
      (if (= i (vector-count all)) out
        (let [x (typed-list-nth [:list :document] all i)]
          (recur (+ i 1) (if (d/list-member? excluded (d/field x :id)) out (typed-list-conj [:list :document] out x))))))))
(defn current-state [s [:ref :harness/search]] :document
  (let [f (c/function (p s) (fid s)) stage (c/stage (p s) (c/find-stage (p s) (d/text (d/field f :stage))))
        h (a/hole (nodes s) 0)]
    (document-map :goal (d/field (p s) :goal) :stage (document-map :id (d/field stage :id) :goal (d/field stage :goal))
      :function (document-string (str (c/signature f) "...)")) :function-goal (d/field f :goal)
      :assembly (document-string (a/render (nodes s) 0 h)) :hole-type (d/field (a/node (nodes s) h) :type)
      :hole-role (document-string (a/role (p s) (fid s) (nodes s) h))
      :verified-functions (record-get [:ref :harness/search] s :fixed) :rejected-assemblies (rejected s)
      :page (document-i64 (record-get [:ref :harness/search] s :page)))))
(defn advance [s [:ref :harness/search]] [:ref :harness/search]
  (if (not (string=? (phase s) "step")) s
    (let [h (a/hole (nodes s) 0)]
      (if (< h 0) (record-assoc [:ref :harness/search] s :phase "verify")
        (let [choices (legal s h) size (- (d/integer (d/field (p s) :candidate-limit)) 1)
              begin (* size (record-get [:ref :harness/search] s :page))
              end (min (vector-count choices) (+ begin size))
              shown (loop [i begin out (document-vector)]
                      (if (>= i end) out (recur (+ i 1) (document-vector-conj out (typed-list-nth [:list :document] choices i)))))
              more (< end (vector-count choices))
              offered (document-vector-conj shown (document-map :id (document-string (if more "next-page" "stop")) :kind (if more (document-keyword :page) (document-keyword :stop))))]
          (cond (= (document-count shown) 0) (advance (rewind s "empty-hole"))
                (>= (vector-count (audit s)) (d/integer (d/field (p s) :max-decisions))) (refuse s "decision-budget")
                :else (let [s1 (record-assoc [:ref :harness/search] s :offered offered)
                            s2 (record-assoc [:ref :harness/search] s1 :request (j/request (current-state s) offered))
                            s3 (record-assoc [:ref :harness/search] s2 :retry 0)]
                        (record-assoc [:ref :harness/search] s3 :phase "ask"))))))))
(defn answer [s [:ref :harness/search] answer :document wall-ms :document] [:ref :harness/search]
  (if (not (string=? (phase s) "ask")) (refuse s "search-protocol")
    (let [choices (offered s) index (j/admit choices answer)
          ids (loop [i 0 out (document-vector)]
                (if (= i (document-count choices)) out (recur (+ i 1) (document-vector-conj out (d/field (d/at choices i) :id)))))
          entry (document-merge (context s) (document-assoc (document-assoc answer :offered ids) :wall-ms wall-ms))
          s0 (record-assoc [:ref :harness/search] s :audit (typed-list-conj [:list :document] (audit s) entry))]
      (if (< index 0)
        (cond (> (record-get [:ref :harness/search] s :retry) 0) (refuse s0 "invalid-distribution")
              (>= (vector-count (audit s0)) (d/integer (d/field (p s) :max-decisions))) (refuse s0 "decision-budget")
              :else (record-assoc [:ref :harness/search] s0 :retry 1))
        (let [chosen (d/at choices index) kind (d/field chosen :kind)]
          (cond (document-equal? kind (document-keyword :page))
                  (advance (record-assoc [:ref :harness/search] (record-assoc [:ref :harness/search] s0 :page (+ 1 (record-get [:ref :harness/search] s :page))) :phase "step"))
                (document-equal? kind (document-keyword :stop))
                  (if (record-get [:ref :harness/search] s :escalate) (advance (rewind s0 "stop-escalation")) (refuse s0 "policy-stopped"))
                :else
                  (let [h (a/hole (nodes s) 0) all (legal s h)
                        excluded (typed-list-conj [:list :document] (record-get [:ref :harness/search] s :excluded) (d/field chosen :id))
                        remaining (loop [i 0 n 0]
                                    (if (= i (vector-count all)) n
                                      (recur (+ i 1) (+ n (if (document-equal? (d/field (typed-list-nth [:list :document] all i) :id) (d/field chosen :id)) 0 1)))))
                        frame (record-new [:ref :harness/frame] (nodes s) excluded remaining (d/text (d/field chosen :id)))
                        s1 (record-assoc [:ref :harness/search] s0 :frames (typed-list-conj [:list [:ref :harness/frame]] (record-get [:ref :harness/search] s :frames) frame))
                        s2 (record-assoc [:ref :harness/search] s1 :nodes (a/fill (nodes s) h chosen))
                        s3 (record-assoc [:ref :harness/search] s2 :excluded (typed-list-new [:list :document]))
                        s4 (record-assoc [:ref :harness/search] s3 :page 0)]
                    (advance (record-assoc [:ref :harness/search] s4 :phase "step")))))))))
(defn verified [s [:ref :harness/search] v :document] [:ref :harness/search]
  (if (not (string=? (phase s) "verify")) (refuse s "search-protocol")
    (let [n (+ (record-get [:ref :harness/search] s :n-attempts) 1)
          b (bodies s) entry (document-merge (context s) (document-map :attempt (document-i64 n) :bodies b :verification v))
          s0 (record-assoc [:ref :harness/search] s :attempts (typed-list-conj [:list :document] (attempts s) entry))
          s1 (record-assoc [:ref :harness/search] s0 :n-attempts n)
          s2 (record-assoc [:ref :harness/search] s1 :verification v)]
      (cond (d/truth (d/field v :blocked)) (refuse s2 "verification-blocked")
            (d/truth (d/field v :passed))
              (let [pos (+ (record-get [:ref :harness/search] s :position) 1) units (record-get [:ref :harness/search] s :units)
                    fixed (record-assoc [:ref :harness/search] s2 :fixed b)]
                (if (= pos (vector-count units)) (record-assoc [:ref :harness/search] fixed :phase "done")
                  (let [f (c/function (p s) (vector-at units pos))
                        next (record-assoc [:ref :harness/search] fixed :position pos)
                        n1 (record-assoc [:ref :harness/search] next :nodes (a/initial (d/field f :returns)))
                        n2 (record-assoc [:ref :harness/search] n1 :frames (typed-list-new [:list [:ref :harness/frame]]))
                        n3 (record-assoc [:ref :harness/search] n2 :excluded (typed-list-new [:list :document]))
                        n4 (record-assoc [:ref :harness/search] n3 :page 0)
                        n5 (record-assoc [:ref :harness/search] n4 :n-attempts 0)
                        n6 (record-assoc [:ref :harness/search] n5 :rejected (document-vector))]
                    (advance (record-assoc [:ref :harness/search] n6 :phase "step")))))
            (>= n 6) (refuse s2 "stage-rejected")
            :else (let [assembly (document-map (d/field (c/function (p s) (fid s)) :id) (document-string (a/render (nodes s) 0 -1)))
                        r (document-vector-conj (rejected s) (document-map :assembly assembly :failed-cases (d/field v :failures)))]
                    (advance (rewind (record-assoc [:ref :harness/search] s2 :rejected r) "verification-failed")))))))
