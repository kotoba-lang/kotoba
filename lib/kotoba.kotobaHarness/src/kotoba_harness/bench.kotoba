(ns kotoba-harness.bench (:export [main])
  (:require [kotoba-harness.data :as d] [kotoba-harness.io :as io] [kotoba-harness.ledger :as m]))
(defn- exchange [effect :document] :document
  (let [sent (io/send (d/json effect)) r (io/receive)]
    (if (or (not= sent 0) (not (string=? (d/error r) ""))) (document-null)
      (d/value (d/read-json (d/text (d/value r)))))))
(defn- finish [status :string spent :i64 results [:list :document]] :i64
  (let [base (d/json (document-map :format (document-string "kotoba-harness.native-bench/v1") :status (document-string status)
                       :api-usd (m/usd spent) :runs (document-i64 (vector-count results))))
        rows (loop [i 0 out "["]
               (if (= i (vector-count results)) (str out "]")
                 (recur (+ i 1) (str out (if (= i 0) "" ",") (d/json (typed-list-nth [:list :document] results i))))))
        json (str (string-substring base 0 (- (string-length base) 1)) ",\"results\":" rows "}")
        code (cond (string=? status "complete") 0 (string=? status "blocked") 78 :else 1)
        sent (io/send (d/json (document-map :op (document-string "finish") :receipt (document-string json) :exit (document-i64 code))))]
    (if (= sent 0) code 78)))
(defn main [] :i64
  (let [frame (io/receive) input (d/read-json (d/text (d/value frame))) config (d/value input)
        projects (d/field config :projects) rounds (d/integer (d/field config :rounds)) budget (m/cost (d/field config :budget-usd))]
    (if (or (not (string=? (d/error input) "")) (not (d/kind? projects :vector)) (not= (document-count projects) 6)
            (< rounds 1) (> rounds 32) (< budget 0)) (finish "refused" 0 (typed-list-new [:list :document]))
      (loop [i 0 spent 0 results (typed-list-new [:list :document])]
        (cond (= i (* rounds 12)) (finish "complete" spent results)
              (> (+ spent 1376256000) budget) (finish "budget-exhausted" spent results)
              :else
                (let [slot (rem i 12) project (rem slot 6) escalate (< slot 6)
                      effect (document-map :op (document-string "session") :project (d/at projects project) :method (document-string "jev")
                                :escalate (document-bool escalate) :budget-usd (m/usd (- budget spent)))
                      observation (exchange effect) parsed (d/read-json (d/text (d/field observation :receipt))) receipt (d/value parsed)
                      charge (m/cost (d/field receipt :api-usd))
                      row (document-map :round (document-i64 (+ (quot i 12) 1)) :variant (document-string (if (< project 3) "guided" "plain"))
                            :project (d/field receipt :project) :escalate (document-bool escalate) :status (d/field receipt :status)
                            :api-usd (d/field receipt :api-usd) :error (d/field receipt :error))
                      next (typed-list-conj [:list :document] results row)]
                  (if (or (not (string=? (d/error parsed) "")) (< charge 0)) (finish "blocked" -1 next)
                    (cond (string=? (d/text (d/field receipt :status)) "blocked") (finish "blocked" (+ spent charge) next)
                          (string=? (d/text (d/field receipt :error)) "api-budget") (finish "budget-exhausted" (+ spent charge) next)
                          :else (recur (+ i 1) (+ spent charge) next)))))))))
