(ns kotoba-harness.ledger (:export [cost usd])
  (:require [kotoba-harness.data :as d] [kotoba-harness.decision :as j]))
(defn cost [v :document] :i64
  ;; Picodollars rounded upward preserve a conservative ledger; raw provider
  ;; cost remains in each decision. Missing/negative/nonfinite cost is unknown.
  (if (and (j/numeric v) (f64-ge (j/number v) (i64-to-f64-rounded 0)) (f64-le (j/number v) (i64-to-f64-rounded 1)))
    (let [scaled (f64-mul (j/number v) (i64-to-f64-rounded 1000000000000)) n (f64-to-i64-truncating scaled)]
      (+ n (if (f64-gt scaled (i64-to-f64-rounded n)) 1 0))) -1))
(defn usd [n :i64] :document (if (< n 0) (document-null) (document-edn-read (str n "e-12"))))
