(ns kotoba-harness.control-verdict (:export [main]))
;; Fixed acceptance-corpus verdict, not the unported search/Jev controller.
;; The observation is transported as project/method/status/exit/result/trap.
(defn- arg [index :string] :string
  (typed-cap-call :cli/args :string :string index))
(defn- finish [status :string code :i64] :i64
  (let [written (typed-cap-call :io/write :string :string status)] code))
(defn- wrong-result? [project :string result :string] :bool
  (or (and (string=? project "kotoba") (string=? result "120"))
      (and (string=? project "itonami") (string=? result "400"))
      (and (string=? project "murakumo") (string=? result "702"))))
(defn- judge [project :string method :string status :string exit :string result :string trap :string count :string] :i64
  (cond (not (string=? count "6")) 78
        (not (or (string=? project "kotoba") (string=? project "itonami") (string=? project "murakumo"))) 78
        (not (and (string=? status "ok") (string=? exit "0") (string=? trap ""))) 78
        (string=? method "known") (if (string=? result "0") 0 1)
        (string=? method "wrong") (if (wrong-result? project result) 0 1)
        :else 78))
(defn- selftest [] :i64
  (+ (if (= (judge "kotoba" "known" "ok" "0" "0" "" "6") 0) 0 1)
     (if (= (judge "kotoba" "wrong" "ok" "0" "120" "" "6") 0) 0 1)
     (if (= (judge "itonami" "wrong" "ok" "0" "400" "" "6") 0) 0 1)
     (if (= (judge "murakumo" "wrong" "ok" "0" "702" "" "6") 0) 0 1)
     (if (= (judge "kotoba" "known" "ok" "0" "1" "" "6") 1) 0 1)
     (if (= (judge "kotoba" "wrong" "ok" "0" "0" "" "6") 1) 0 1)
     (if (= (judge "kotoba" "wrong" "ok" "0" "999999" "" "6") 1) 0 1)
     (if (= (judge "kotoba" "known" "trap" "0" "0" "" "6") 78) 0 1)
     (if (= (judge "kotoba" "known" "ok" "120" "0" "" "6") 78) 0 1)
     (if (= (judge "kotoba" "known" "ok" "0" "0" "trap" "6") 78) 0 1)
     (if (= (judge "unknown" "known" "ok" "0" "0" "" "6") 78) 0 1)
     (if (= (judge "kotoba" "unknown" "ok" "0" "0" "" "6") 78) 0 1)
     (if (= (judge "kotoba" "known" "ok" "0" "0" "" "5") 78) 0 1)))
(defn main [] :i64
  (let [project (arg "0") method (arg "1") status (arg "2")
        exit (arg "3") result (arg "4") trap (arg "5") count (arg "")]
    (if (and (string=? project "selftest") (string=? count "1"))
      (let [failures (selftest)]
        (if (= failures 0) (finish "selftest-verified" 0) (finish "selftest-failed" 1)))
      (let [verdict (judge project method status exit result trap count)]
        (cond (= verdict 78) (finish "blocked" 78)
              (= verdict 1) (finish "failed-control" 1)
              (string=? method "known") (finish "verified" 0)
              :else (finish "rejected" 0))))))
