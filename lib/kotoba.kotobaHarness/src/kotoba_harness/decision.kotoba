(ns kotoba-harness.decision
  (:export [admit numeric number unit? describe request response model?])
  (:require [kotoba-harness.data :as d]))

(def instructions "Fill only the hole marked ? in the active function's assembly (_ marks holes filled later). Ancestors already perform part of the goal: choose the subexpression needed at this position, not the whole goal again. A parameter or literal may fully satisfy the hole. Never repeat a rejected assembly. No source text is accepted. next-page shows more legal candidates; stop means no candidate here can be right, which revises an earlier choice.")
(defn numeric [v :document] :bool (or (d/kind? v :i64) (d/kind? v :f64)))
(defn number [v :document] :f64
  (option-value-of [:option :f64] (decimal-f64-parse (document-edn-print v)) (i64-to-f64-rounded -1)))
(defn unit? [v :document] :bool
  (and (numeric v) (f64-ge (number v) (i64-to-f64-rounded 0)) (f64-le (number v) (i64-to-f64-rounded 1))))
(defn admit [choices :document answer :document] :i64
  (let [choice (d/field answer :choice) probs (d/field answer :probabilities)
        labels (loop [i 0 out (document-vector)]
                 (if (= i (document-count choices)) out
                   (let [id (d/field (d/at choices i) :id)]
                     (recur (+ i 1) (if (d/member? out id) out (document-vector-conj out id))))))
        index (loop [i 0] (cond (= i (document-count choices)) -1
                               (document-equal? choice (d/field (d/at choices i) :id)) i :else (recur (+ i 1))))]
    (if (or (< index 0) (not (unit? (d/field answer :confidence))) (not (d/kind? probs :map))
            (not= (document-count probs) (document-count labels))) -1
      (let [winner (option-value-of [:option :document] (document-get probs choice) (document-null))
            valid (loop [i 0]
                    (if (= i (document-count labels)) true
                      (let [id (d/at labels i)
                            v (option-value-of [:option :document] (document-get probs id) (document-null))]
                        (and (unit? v) (unit? winner) (f64-le (number v) (number winner)) (recur (+ i 1))))))
            sum (loop [i 0 total (i64-to-f64-rounded 0)]
                  (if (= i (document-count labels)) total
                    (let [v (option-value-of [:option :document] (document-get probs (d/at labels i)) (document-null))]
                      (recur (+ i 1) (f64-add total (number v))))))
            tolerance (f64-add (option-value-of [:option :f64] (decimal-f64-parse "0.000000001") (i64-to-f64-rounded 0))
                              (f64-mul (option-value-of [:option :f64] (decimal-f64-parse "0.005") (i64-to-f64-rounded 0)) (i64-to-f64-rounded (document-count labels))))]
        (if (and valid (f64-le (f64-abs (f64-sub (i64-to-f64-rounded 1) sum)) tolerance)) index -1)))))
(defn describe [cand :document] :string
  (let [kind (d/field cand :kind)]
    (cond (document-equal? kind (document-keyword :argument)) (str "parameter " (d/text (d/field cand :name)) " " (document-edn-print (d/field cand :type)))
          (document-equal? kind (document-keyword :literal)) (str "literal " (document-edn-print (d/field cand :value)) " " (document-edn-print (d/field cand :type)))
          (document-equal? kind (document-keyword :page)) "show more legal candidates"
          (document-equal? kind (document-keyword :stop)) "no candidate here can be right; revise an earlier choice"
          :else (let [in (d/field cand :in)
                      args (loop [i 0 out ""]
                             (if (= i (document-count in)) out
                               (recur (+ i 1) (str out (if (= i 0) "" " ") (document-edn-print (d/at in i))))))]
                  (str "(" (d/text (d/field cand :emit)) " " args ") -> " (document-edn-print (d/field cand :out)) ". " (d/text (d/field cand :description)))))))
(defn request [state :document choices :document] :document
  ;; Criteria must retain the offered catalog/page order. document-assoc
  ;; canonicalizes map order, which would change the actual model input.
  (let [criteria-text (loop [i 0 out "{" seen (document-vector)]
                        (if (= i (document-count choices)) (str out "}")
                          (let [id (d/field (d/at choices i) :id)
                                last (loop [k i found i]
                                       (if (= k (document-count choices)) found
                                         (recur (+ k 1) (if (document-equal? id (d/field (d/at choices k) :id)) k found))))]
                            (if (d/member? seen id) (recur (+ i 1) out seen)
                              (recur (+ i 1) (str out (if (= (document-count seen) 0) "" " ") (d/quote (d/text id)) " " (d/quote (describe (d/at choices last))))
                                     (document-vector-conj seen id))))))
        criteria (document-edn-read criteria-text)]
    (document-map :model (document-string "typesafe/jev-1.13") :state (document-string (document-edn-print state))
      :questions (document-map :next_action (document-map :type (document-string "choice")
                               :instructions (document-string instructions) :criteria criteria)))))
(defn model? [s :string] :bool
  (let [base "typesafe/jev-1.13" n (string-length base)]
    (or (string=? s base)
        (and (> (string-length s) (+ n 1)) (string=? (string-substring s 0 n) base) (= (string-code-point-at s n) 45)
             (loop [i (+ n 1)]
               (if (= i (string-length s)) true
                 (let [x (string-code-point-at s i)]
                   (and (or (and (>= x 48) (<= x 57)) (and (>= x 65) (<= x 90)) (and (>= x 97) (<= x 122)) (= x 46) (= x 95) (= x 45))
                        (recur (+ i 1))))))))))
(defn- key [v :document s :string] :document
  (if (d/kind? v :map) (option-value-of [:option :document] (document-get v (document-string s)) (document-null)) (document-null)))
(defn response [raw :string] [:ref :harness/parsed]
  (let [parsed (d/read-json raw) v (d/value parsed) answer (key (key v "answers") "next_action")
        model (key v "model") usage (key v "usage")]
    (cond (not (string=? (d/error parsed) "")) parsed
          (not (model? (d/text model))) (d/make-result (document-null) 0 "provider-model")
          (not (and (string=? (d/text (key answer "type")) "choice") (d/kind? (key answer "choice") :string) (d/kind? (key answer "probabilities") :map)))
            (d/make-result (document-null) 0 "provider-answer-shape")
          :else (d/make-result (document-map :choice (key answer "choice") :confidence (key answer "confidence")
                                :probabilities (key answer "probabilities") :model model :request-id (key v "id")
                                :usage (document-map :input_tokens (key usage "input_tokens") :output_tokens (key usage "output_tokens") :cost (key usage "cost"))) 0 ""))))
