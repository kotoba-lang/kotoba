(ns kotoba-harness.io (:export [receive send now sha])
  (:require [kotoba-harness.data :as d]))
;; Length-delimited UTF-8 data only. No commands, paths, credentials or
;; compiler selection are read from the environment by the native controller.
(defn receive [] [:ref :harness/parsed]
  (let [length (loop [n 0 digits 0]
                 (let [s (typed-cap-call :io/read :string :string "1")]
                   (cond (string=? s "\n") (if (> digits 0) n -1)
                         (or (not= (string-length s) 1) (>= digits 7)) -1
                         :else (let [c (string-code-point-at s 0)]
                                 (if (and (>= c 48) (<= c 57)) (recur (+ (* n 10) (- c 48)) (+ digits 1)) -1)))))]
    (if (or (< length 0) (> length 1048576)) (d/make-result (document-null) 0 "transport-length")
      (loop [left length out ""]
        (if (= left 0) (d/make-result (document-string out) 0 "")
          (let [chunk (typed-cap-call :io/read :string :string (str left)) n (string-length chunk)]
            (if (or (= n 0) (> n left)) (d/make-result (document-null) 0 "transport-eof")
              (recur (- left n) (string-concat out chunk)))))))))
(defn send [s :string] :i64
  (let [out (str (string-length s) "\n" s)
        written (typed-cap-call :io/write :string :string out)
        ;; Native stdout is buffered. The stderr capability flushes it before
        ;; writing; an empty stderr write is the explicit duplex barrier.
        flushed (typed-cap-call :io/write-error :string :string "")]
    (if (and (string=? written (str (string-length out))) (string=? flushed "0")) 0 78)))
(defn now [] :i64
  (d/integer (document-edn-read (typed-cap-call :clock/now :string :string "wall"))))
(defn sha [s :string] :string (typed-cap-call :hash/sha256 :string :string s))
