{:paths ["src" "resources"]
 :deps {io.github.kotoba-lang/hanmen
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.hanmen"}
        ;; The registry and encoding tables a host injects. This loop is a
        ;; host: it measures what the renderer does when it is wired up the
        ;; way a real consumer wires it, not what it does bare.
        io.github.kotoba-lang/com-adobe-cmap
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.comAdobeCmap"}}
 :aliases
 {:run {:main-opts ["-m" "render-fidelity.main"]}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/clojure {:mvn/version "1.11.1"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
