{:paths ["src" "resources"]
 :deps {io.github.kotoba-lang/hanmen
        {:git/url "https://github.com/kotoba-lang/hanmen.git"
         :git/sha "cffae2dc0ef7cc59da0e7d1cc081cd149285ad34"}
        ;; The registry and encoding tables a host injects. This loop is a
        ;; host: it measures what the renderer does when it is wired up the
        ;; way a real consumer wires it, not what it does bare.
        io.github.kotoba-lang/com-adobe-cmap
        {:git/url "https://github.com/kotoba-lang/com-adobe-cmap.git"
         :git/sha "e02ad46978ed841bb300274cc13b342e4a238e0d"}}
 :aliases
 {:run {:main-opts ["-m" "render-fidelity.main"]}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/clojure {:mvn/version "1.11.1"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
