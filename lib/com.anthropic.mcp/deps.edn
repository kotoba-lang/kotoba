{:paths ["src"]
 ;; Zero third-party runtime deps — every namespace is portable .cljc (JVM, CLJS, SCI).
 ;; JSON I/O accepts already-parsed Clojure maps/vectors (string keys) and emits
 ;; JSON-ready maps; a host may inject its own JSON parser and feed mcp.json/from-data
 ;; the result — no JSON text parsing occurs inside this library.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
