{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:microsoft.etzhayyim.com",
  "component": {
    "env": {
      "M365_TENANT_ID": "e9b32269-81a5-4d3a-bf94-048ba6770c99",
