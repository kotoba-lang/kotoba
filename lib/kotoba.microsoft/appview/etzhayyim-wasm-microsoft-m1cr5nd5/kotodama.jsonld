      "INTERNAL_EMAIL_SUFFIXES": ".onmicrosoft.com",
      "KAISYA_CREATE_TASK_URL": "https://kaisya.etzhayyim.com"
    }
  },
  "convoSystemPrompt": "You are the microsoft.etzhayyim.com agent — a write-capable Microsoft 365 / Outlook / Teams send facade. You route outbound email per etzhayyim policy: internal recipients (@etzhayyim.co.jp / @etzhayyim.com / @etzhayyim.works / @etzhayyim.group and configured Teams channel email addresses) send directly via Graph Mail.Send; external recipients land in Outlook Drafts and require human approval via sendDraft. Never send payment / transaction email; never include credentials in body.",
  "duties": ["勤労の義務"],
  "governance": {
    "classification": "restricted",
    "complianceFrameworks": ["etzhayyim-agent-rules", "PII-Tier3"],
    "raci": "responsible"
  },
  "kpi": [
    "external draft approval latency",
    "mis-routed internal/external classification (target: 0)"
  ],
  "name": "microsoft-send",
  "nanoid": "m1cr5nd5",
  "performerType": "service",
  "profile": {
    "agentType": "reactive",
    "capabilities": ["send-email", "draft-email", "list-drafts", "teams-channel-email-post"],
    "category": "infrastructure",
    "description": "Microsoft 365 write facade — Mail.Send (app-only) with policy routing (internal=direct / external=draft_only) per deps.toml [etzhayyim_agent.auth]. Exposes com.etzhayyim.apps.microsoft.{sendMail,sendDraft,listDrafts} over XRPC, auto-published as MCP tools via atproto.etzhayyim.com.",
    "displayName": "Microsoft 365 Send",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "project": "microsoft",
  "routes": [
    { "host": "microsoft.etzhayyim.com", "paths": ["/"], "tls": true },
    { "host": "m1cr5nd5.etzhayyim.com", "paths": ["/"], "tls": true }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "Outbound mail / Teams post events (drafted / sent / failed).",
        "kind": "public",
        "name": "microsoft-send"
      }
    ],
    "description": "Microsoft 365 Send facade — policy-routed email + Teams channel posting.",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "Microsoft 365 Send"
  },
  "triggers": {
    "http": { "listen": "0.0.0.0:8080" }
  },
  "uiType": "none"
