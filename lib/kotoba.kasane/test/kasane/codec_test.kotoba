(ns kasane.codec-test (:export [main]) (:require [kasane.codec :as p]))

(defn- same? [a :document b :document] :bool
  (string=? (document-edn-print a) (document-edn-print b)))

(defn- wiki-case [] :i64
  ;; PackBits example: FE AA | 02 80 00 2A | FD AA | 03 80 00 2A 22 | F7 AA
  (let [in (document-vector (document-i64 254) (document-i64 170)
                            (document-i64 2) (document-i64 128) (document-i64 0) (document-i64 42)
                            (document-i64 253) (document-i64 170)
                            (document-i64 3) (document-i64 128) (document-i64 0) (document-i64 42) (document-i64 34)
                            (document-i64 247) (document-i64 170))
        want (document-vector (document-i64 170) (document-i64 170) (document-i64 170)
                              (document-i64 128) (document-i64 0) (document-i64 42)
                              (document-i64 170) (document-i64 170) (document-i64 170) (document-i64 170)
                              (document-i64 128) (document-i64 0) (document-i64 42) (document-i64 34)
                              (document-i64 170) (document-i64 170) (document-i64 170) (document-i64 170)
                              (document-i64 170) (document-i64 170) (document-i64 170) (document-i64 170)
                              (document-i64 170) (document-i64 170))]
    (if (same? (p/packbits in) want) 0 1)))

(defn main [] :i64
  (+ (wiki-case)
     (if (same? (p/packbits (document-vector)) (document-vector)) 0 1)
     (if (same? (p/packbits (document-vector (document-i64 128))) (document-vector)) 0 1)
     (if (same? (p/packbits (document-vector (document-i64 0) (document-i64 65))) (document-vector (document-i64 65))) 0 1)
     (if (same? (p/packbits (document-vector (document-i64 253) (document-i64 66)))
                (document-vector (document-i64 66) (document-i64 66) (document-i64 66) (document-i64 66))) 0 1)
     ;; truncated literal run: clamped to the bytes present
     (if (same? (p/packbits (document-vector (document-i64 5) (document-i64 1) (document-i64 2)))
                (document-vector (document-i64 1) (document-i64 2))) 0 1)))
