;; Port of kasane.codec (codec.cljk), Kotoba-native: PackBits RLE decoding.
;;
;; packbits takes a :document vector of unsigned bytes (i64 values) and returns
;; a :document vector of the decoded bytes. Replicate and literal runs follow
;; the PackBits rules used by PSD :rle channels: 0..127 copies h+1 literal
;; bytes; 129..255 repeats the next byte 257-h times; 128 is a no-op.
;;
;; Named divergences from codec.cljk:
;;   - a truncated input is clamped: a literal run stops at the last byte, and a
;;     replicate header with no following byte ends the decode. The source
;;     throws (subvec / nth out of range). No bytes are invented.
;;   - a nil or non-vector input decodes to the empty vector.

(ns kasane.codec
  (:export [packbits]))

(defn- seq-count [d :document] :i64
  (if (vector? d) (document-count d) 0))

(defn- byte-at [v :document i :i64] :i64
  (option-or (document-i64-value (option-or (document-vector-at v i) (document-null))) 0))

(defn- copy-range [out :document v :document from :i64 to :i64] :document
  (loop [j from acc out]
    (if (>= j to)
      acc
      (recur (+ j 1) (document-vector-conj acc (document-i64 (byte-at v j)))))))

(defn- repeat-byte [out :document b :i64 cnt :i64] :document
  (loop [k 0 acc out]
    (if (>= k cnt)
      acc
      (recur (+ k 1) (document-vector-conj acc (document-i64 b))))))

(defn packbits [data :document] :document
  (let [n (seq-count data)]
    (loop [i 0 out (document-vector)]
      (if (>= i n)
        out
        (let [h (byte-at data i)]
          (if (= h 128)
            (recur (+ i 1) out)
            (if (< h 128)
              (let [cnt (+ h 1)
                    end (if (< (+ i 1 cnt) n) (+ i 1 cnt) n)]
                (recur end (copy-range out data (+ i 1) end)))
              (if (>= (+ i 1) n)
                out
                (let [cnt (- 257 h)]
                  (recur (+ i 2) (repeat-byte out (byte-at data (+ i 1)) cnt)))))))))))
