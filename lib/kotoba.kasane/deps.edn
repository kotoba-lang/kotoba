{:paths ["src" "resources"]
 ;; kasane.json/kasane.svg/kasane.gltf は既存 kotoba-lang repo への薄い
 ;; adapter（2026-07-08、独自実装は廃止）。org-khronos-glb は kasane.gltf より
 ;; 高機能なGLB reader/writerを既に独立に持っていた（accessor decode含む）。
 ;; ooxml/office: ooxml->doc のformat検出+multi-part discovery+Word text抽出
 ;; に使う（両方とも100%移植可能な関数のみ呼ぶ — office.opc/open-package
 ;; というJVM専用関数(java.util.zip)は一切呼ばない。kasane.normalizeの
 ;; docstring参照）。
 :deps  {
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.bytes"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/json
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.json"}
         io.github.kotoba-lang/org-w3-svg
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/org.w3.svg"}
         io.github.kotoba-lang/org-khronos-glb
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/org.khronos.glb"}
         io.github.kotoba-lang/ooxml
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.ooxml"}
         io.github.kotoba-lang/office         {:git/sha "b5838def811d05f1db1e7d77e5daede8ac953883"}}
 :aliases
 {;; malli はモデル検証(SSoT)用。WASM/コア経路には含めない。
  ;; テスト(JVM)。ooxml_test/inflate_test 系だけ fixture 生成に java.util.zip
  ;; を使う（ライブラリ本体は使わない）。zip.core(org-pkware-zip) はテスト専用
  ;; の entries 供給源（ooxml_test.clj: 実際の呼び出し側は zip.core で unzip
  ;; した entries を kasane.normalize/ooxml->doc に渡す想定）。
  :test  {:extra-paths ["test"]}}}
