(ns kotoba.pbrt-parity-test
  "Parity gate between `src/kotoba/pbrt.kotoba` (the semantic authority) and
  `src/kotoba/pbrt.cljk` (the load path a Clojure/ClojureScript consumer requires).

  Shape follows `kotoba-lang/css` (`css.kotoba-parity-test`), `kotoba-lang/dsl-core`
  and `kotoba-lang/async` (ADR-2608130900), and `kotoba-lang/postfx` (ADR-2608133600):
  the `.kotoba` is compiled here and executed through the reference evaluator in this
  same JVM, so nothing crosses a runtime boundary, and `kotoba-lang/compiler` stays a
  test-only dependency.

  WHY THE .cljc EXISTS AT ALL. `17bcaf80` (2026-07-20) deleted
  `src/kotoba/pbrt.cljk` and put the `.kotoba` at that path. A `.kotoba` is on no
  Clojure classpath, so `kotoba.pbrt` stopped being loadable by every runtime this
  workspace ranks above the native path. The `.cljc` restored beside it is the load
  path; the `.kotoba` remains the authority.

  SEMANTICS DECISION: VERBATIM. The guest's six exported values are byte-identical to
  the six strings the pre-migration `.cljc` defined, so the restored file is the
  pre-migration file unchanged (`17bcaf80^`). Unlike `dsl-core`/`async`, the guest did
  not alter meaning here; this test is what makes \"unchanged\" a checked claim.

  WHAT THIS DOES NOT CLAIM — the divergences, asserted rather than hidden.

  1. `def` vs nullary function. Kotoba has no top-level value bindings, so every
     constant crosses as a nullary export. Value is compared; the binding form is not.
     (Same divergence `postfx` records for `effect-types`.)

  2. `status` has no guest counterpart. It is a Clojure map and this guest exports
     only `:string`/`:i64` scalars — the migration flattened the record away.
     `status-is-exactly-the-guest-backed-values-and-nothing-else` pins it to the six
     parity-checked constants so it cannot drift, even though the authority cannot
     express the map itself.

  3. `main` is a wasm entry point, not library API, and is not mirrored."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.compiler.core :as compiler]
            [kotoba.compiler.ir :as ir]
            [kotoba.pbrt :as pbrt]))

(def ^:private source (slurp "lib/kotoba.pbrt/src/kotoba/pbrt.kotoba"))

(def ^:private kir (delay (:kir (compiler/compile-source source :js-kotoba-v1))))

(defn- call [f & args] (ir/execute @kir f (vec args)))

;; Each pair is [guest export, the var the .cljc load path publishes].
(def ^:private constants
  [['adr-value              #'pbrt/adr]
   ['phase-value            #'pbrt/phase]
   ['kami-name-value        #'pbrt/kami-name]
   ['nv-compat-target-value #'pbrt/nv-compat-target]
   ['upstream-repo-value    #'pbrt/upstream-repo]
   ['fork-policy-value      #'pbrt/fork-policy]])

(deftest every-guest-constant-has-an-equal-load-path-constant
  (doseq [[guest-fn v] constants]
    (testing (str guest-fn)
      (is (= (call guest-fn) @v)
          (str "the guest's " guest-fn " and this namespace's " (symbol v)
               " must carry the same string")))))

(deftest the-load-path-adds-no-constant-the-guest-does-not-back
  (testing "every public string var here is a value the guest actually exports"
    (is (= (set (map (comp call first) constants))
           (->> (ns-publics 'kotoba.pbrt)
                vals
                (filter #(string? @%))
                (map deref)
                set)))))

(deftest status-is-exactly-the-guest-backed-values-and-nothing-else
  (testing "the guest cannot express this map, so it is pinned to the guest's scalars"
    (is (= {:adr              (call 'adr-value)
            :phase            (call 'phase-value)
            :kami-name        (call 'kami-name-value)
            :nv-compat-target (call 'nv-compat-target-value)
            :upstream-repo    (call 'upstream-repo-value)
            :fork-policy      (call 'fork-policy-value)}
           pbrt/status)))
  (testing "no seventh key can appear without a guest export behind it"
    (is (= 6 (count pbrt/status)))))

(deftest the-guest-exports-no-effects
  (is (= #{} (set (:effects @kir)))
      "this namespace is pure data; an effect here would mean the guest grew a
       capability the .cljc load path cannot carry"))
