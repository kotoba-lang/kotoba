;; Test for faceid.model. main returns the number of failed cases.
(ns faceid.model-test
  (:export [main])
  (:require [faceid.model :as m]))

(defn- gv [x :document k :keyword] :document
  (option-value-of [:option :document] (document-get x k) (document-null)))
(defn- str-of [x :document k :keyword] :string
  (option-value-of [:option :string] (document-string-value (gv x k)) "<none>"))
(defn- bool-of [x :document k :keyword] :bool
  (option-value-of [:option :bool] (document-bool-value (gv x k)) false))
(defn- kw-of [x :document k :keyword] :keyword
  (option-value-of [:option :keyword] (document-keyword-value (gv x k)) :none))
(defn- chk-str [got :string want :string] :i64
  (if (string=? got want) 0 1))
(defn- chk-bool [got :bool want :bool] :i64
  (if (= got want) 0 1))
(defn- chk-kw [got :keyword want :keyword] :i64
  (if (= got want) 0 1))

(defn- cases-request [] :i64
  (let [opts (document-map :challenge (document-string "ch")
                           :rp-id (document-string "rp")
                           :subject (document-string "sub")
                           :created-at (document-string "t0"))
        req (m/request (document-string "id1") opts)
        c1 (chk-str (str-of req :faceid/id) "id1")
        c2 (chk-kw (kw-of req :faceid/purpose) :step-up)
        c3 (chk-str (str-of req :faceid/challenge) "ch")
        req2 (m/request (document-string "id2")
                        (document-map :purpose (document-keyword :unlock)))
        c4 (chk-kw (kw-of req2 :faceid/purpose) :unlock)]
    (+ c1 (+ c2 (+ c3 c4)))))

(defn- cases-attest [] :i64
  (let [req (m/request (document-string "id1") (document-map :subject (document-string "sub")))
        att (m/attestation req true
                           (document-map :device-id (document-string "d1")
                                         :provider (document-string "p")))
        c5 (chk-bool (bool-of att :faceid/ok?) true)
        c6 (chk-str (str-of att :faceid/subject) "sub")
        c7 (chk-str (str-of att :faceid/device-id) "d1")
        c8 (chk-kw (kw-of att :faceid/purpose) :step-up)
        bad (m/attestation req false (document-map))
        c9 (chk-bool (bool-of bad :faceid/ok?) false)]
    (+ c5 (+ c6 (+ c7 (+ c8 c9))))))

(defn- cases-sets [] :i64
  (let [c10 (chk-bool (document-set-contains? (m/purposes) (document-keyword :consent)) true)
        c11 (chk-bool (document-set-contains? (m/purposes) (document-keyword :raw-face)) false)
        c12 (chk-bool (document-set-contains? (m/forbidden-keys) (document-keyword :raw-face)) true)]
    (+ c10 (+ c11 c12))))

(defn main [] :i64
  (+ (cases-request) (+ (cases-attest) (cases-sets))))
