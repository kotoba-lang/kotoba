;; Port of faceid.model (model.cljk), Kotoba-native.
;; Named divergences:
;;   - purposes and forbidden-keys are sets (defs) in the source. A def cannot be
;;     exported (E2005), so they are zero-argument fns returning :document sets.
;;   - request reads its options as a :document. An absent :purpose key gives
;;     :step-up; a present null stays null (the source's get returns nil then).
;;   - attestation's ok? is typed :bool (the source coerces with boolean).
(ns faceid.model
  (:export [purposes forbidden-keys request attestation]))

(defn purposes [] :document
  (document-set (document-keyword :unlock) (document-keyword :step-up)
                (document-keyword :consent) (document-keyword :reveal)
                (document-keyword :sign)))

(defn forbidden-keys [] :document
  (document-set (document-keyword :raw-face) (document-keyword :raw-face-image)
                (document-keyword :face-template) (document-keyword :face-embedding)
                (document-keyword :biometric-template)))

(defn- gv [m :document k :keyword] :document
  (option-value-of [:option :document] (document-get m k) (document-null)))

(defn request [id :document opts :document] :document
  (document-map :faceid/id id
                :faceid/purpose (if (document-contains opts :purpose)
                                  (gv opts :purpose)
                                  (document-keyword :step-up))
                :faceid/challenge (gv opts :challenge)
                :faceid/rp-id (gv opts :rp-id)
                :faceid/subject (gv opts :subject)
                :faceid/created-at (gv opts :created-at)))

(defn attestation [req :document ok? :bool opts :document] :document
  (document-map :faceid/id (gv req :faceid/id)
                :faceid/ok? (document-bool ok?)
                :faceid/purpose (gv req :faceid/purpose)
                :faceid/subject (gv req :faceid/subject)
                :faceid/device-id (gv opts :device-id)
                :faceid/credential-id (gv opts :credential-id)
                :faceid/provider (gv opts :provider)
                :faceid/evidence-ref (gv opts :evidence-ref)
                :faceid/attested-at (gv opts :attested-at)))
