(ns faceid.datom
  ;; Kotoba port of faceid.datom/attestation-datoms (parity slice).
  ;; Input and output are :document values -- the Kotoba encoding of the
  ;; Clojure map -- so a missing field surfaces as document-null where the
  ;; original returns nil.
  (:export [attestation-datoms]))

(defn dget [d :document k :keyword] :document
  (option-value-of [:option :document] (document-get d k) (document-null)))

(defn attestation-datoms [a :document] :document
  (document-vector
   (document-map
    :db/id (dget a :faceid/id)
    :faceid/ok? (dget a :faceid/ok?)
    :faceid/purpose (dget a :faceid/purpose)
    :faceid/subject (dget a :faceid/subject)
    :faceid/device-id (dget a :faceid/device-id)
    :faceid/credential-id (dget a :faceid/credential-id)
    :faceid/provider (dget a :faceid/provider)
    :faceid/evidence-ref (dget a :faceid/evidence-ref)
    :faceid/attested-at (dget a :faceid/attested-at))))
