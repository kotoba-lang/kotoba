;; RFC 6298 / RFC 9293 retransmission-queue decisions, as safe Kotoba.
;;
;; The decision core of `tcp.retransmit`: for one queue entry, is it retired by
;; this ACK, has its timer expired, has it been tried too many times, and what
;; round trip does it measure. Walking the queue and building the retired list
;; stay in .cljc -- those are collection work and the per-entry answers are the
;; same either way.
;;
;; Depends on `tcp.seq-core` for sequence comparison and for `segment-end`,
;; which `tcp.sack` and `tcp.retransmit` used to hold two private copies of.
;;
;; Checked against `tcp.retransmit` in test/tcp/retransmit_kotoba_parity_test.cljk.

(ns tcp.retransmit-core
  (:require [tcp.seq-core :as s])
  (:export [retired? due? give-up? rtt-sample]))

;; RFC 9293 §3.8.3 wants a connection abandoned rather than retried forever.
;; The limit is the caller's policy and is passed in; 5 is the common default
;; and is not exported -- an :export vector may only name functions, and a
;; constant crossing the ABI as a call would be a second place for it to live.

;; A cumulative ACK retires an entry only when it covers the entry's LAST byte.
;; Comparing against the entry's start instead retires data the receiver never
;; acknowledged, and that data is then never sent again.
(defn retired? [entry-seq :i64 len :i64 syn? :bool fin? :bool ack-num :i64] :bool
  (s/leq? (s/segment-end entry-seq len syn? fin?) ack-num))

;; `>=`, not `>`: an entry whose timer has run exactly to the RTO has expired.
;;
;; Measured from `sent-ms`, which `mark-retransmitted` moves forward on every
;; transmission, so the timer restarts with each attempt rather than running
;; from the original send.
(defn due? [sent-ms :i64 rto-ms :i64 now-ms :i64] :bool
  (>= (- now-ms sent-ms) rto-ms))

(defn give-up? [transmissions :i64 limit :i64] :bool
  (> transmissions limit))

;; Measured from `first-sent-ms`, not from `sent-ms`. The round trip being
;; timed began when the data first went out; timing from the retransmission
;; would report a shorter trip than actually happened and pull the RTO down
;; toward a value the path cannot meet.
;;
;; The caller must only ask this of an entry that was never retransmitted --
;; Karn's algorithm -- because for one that was, there is no way to know which
;; transmission the ACK belongs to. That is a property of the queue, so it
;; stays with the queue rather than being guessed here.
(defn rtt-sample [now-ms :i64 first-sent-ms :i64] :i64
  (- now-ms first-sent-ms))
