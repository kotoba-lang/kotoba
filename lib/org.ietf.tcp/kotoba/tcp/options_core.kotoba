;; TCP option negotiation and PAWS, as safe Kotoba.
;;
;; What is decided rather than encoded: which options are in use, which shift
;; applies in which direction, whether a timestamp is acceptable, and what
;; round trip an echo names.
;;
;; The wire encoding is in `options_wire_core.kotoba`, split off because
;; kotoba-lang/amu#611 refuses a module holding both a shift and a `:bool`
;; parameter. This half has the booleans.
;;
;; Two functions from `tcp.options` are NOT here and cannot be:
;; `apply-scale` and `advertise` shift by a negotiated amount, and an i64 shift
;; count must be an integer literal in [0,63]. RFC 7323 negotiates the shift
;; during the handshake, so it is a variable by construction. They need a
;; bounded table or a bounded loop, which is a different implementation rather
;; than a port, and no such thing is claimed here.
;;
;; Checked against `tcp.options` in test/tcp/options_kotoba_parity_test.cljk.

(ns tcp.options-core
  (:require [tcp.seq-core :as s])
  (:export [max-shift-value shift-valid? window-scaling? send-shift recv-shift
            timestamps? paws-acceptable? paws-idle-expired? record-timestamp?
            rtt-sample-valid? rtt-sample]))

;; RFC 7323 §2.3. A receiver accepting more can be pushed past the 2^30 limit
;; the sequence space allows a window to reach, at which point acceptability
;; tests start disagreeing with the peer.
(def max-shift 14)

;; §5.5: a connection idle longer than 24 days may legitimately present a
;; timestamp that looks older, so PAWS is suspended past this.
(def paws-idle-ms 2073600000)

(defn max-shift-value [] :i64 max-shift)

(defn shift-valid? [shift :i64] :bool (<= shift max-shift))

;; Absent from either side means absent from both. There is no partial adoption
;; of either option: half-applied scaling is a window wrong by a factor of 2^N
;; in whichever direction hurts.
(defn window-scaling? [ours-offered? :bool theirs-offered? :bool] :bool
  (and ours-offered? theirs-offered?))

;; What WE shift outgoing advertisements by is what WE offered; what we shift
;; THEIR advertisements by is what THEY offered. Swapping these is the other
;; classic bug, and it only shows on asymmetric shifts.
(defn send-shift [in-use? :bool ours :i64] :i64 (if in-use? ours 0))
(defn recv-shift [in-use? :bool theirs :i64] :i64 (if in-use? theirs 0))

(defn timestamps? [ours-offered? :bool theirs-offered? :bool] :bool
  (and ours-offered? theirs-offered?))

(defn paws-idle-expired? [last-seen-ms :i64 now-ms :i64] :bool
  (> (- now-ms last-seen-ms) paws-idle-ms))

;; The comparison is modular for the same reason sequence comparison is: the
;; timestamp clock is 32 bits and wraps, and a stack comparing raw integers
;; rejects every segment for a while after the wrap.
;;
;; `have-recent?` carries what the .cljc reads as a non-nil recorded value.
;; `idle-expired?` is the caller's answer from `paws-idle-expired?`, which it
;; can only ask when it has both timestamps.
(defn paws-acceptable?
  [have-recent? :bool idle-expired? :bool recent :i64 tsval :i64] :bool
  (if (not have-recent?) true
      (if idle-expired? true
          (not (s/lt? tsval recent)))))

;; §4.3: the echo must come from the segment that advances the window.
;; Recording from an out-of-order arrival lets a reordered old segment raise
;; the bar against the segments that follow it.
(defn record-timestamp? [have-tsval? :bool seg-seq :i64 rcv-nxt :i64] :bool
  (and have-tsval? (= (s/wrap seg-seq) (s/wrap rcv-nxt))))

;; This is what lifts Karn's restriction. `tcp.rto/sample` refuses a
;; measurement from a retransmitted segment because the ACK is ambiguous about
;; which copy it acknowledges; the echo is not ambiguous, because it names the
;; transmission.
(defn rtt-sample-valid? [have-tsecr? :bool tsecr :i64 now-ms :i64] :bool
  (and have-tsecr? (and (> tsecr 0) (>= now-ms tsecr))))

(defn rtt-sample [tsecr :i64 now-ms :i64] :i64 (- now-ms tsecr))
