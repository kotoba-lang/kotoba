;; TCP option wire encoding, as safe Kotoba.
;;
;; Byte-level packing only: reading a 32-bit field out of four bytes, writing
;; one back, and the two-byte MSS. Parsing the option list itself stays in
;; .cljc -- it walks a vector.
;;
;; SEPARATE from `options_core.kotoba`, and the split is not a design choice.
;; kotoba-lang/amu#611 refuses any module holding both an i64 shift and a
;; `:bool` parameter, and this half needs shifts while the other half needs
;; booleans. The seam happens to be a real one -- wire format on this side,
;; negotiation and PAWS on that -- but it was drawn here because of the
;; compiler, and it should be reconsidered when #611 is fixed.
;;
;; Checked against `tcp.options` in test/tcp/options_kotoba_parity_test.cljk.

(ns tcp.options-wire-core
  (:export [u32-from-bytes u32-byte mss-from-bytes mss-hi mss-lo]))

(def kind-eol 0)
(def kind-nop 1)
(def kind-mss 2)
(def kind-window-scale 3)
(def kind-timestamps 8)

;; Multiplication rather than shifts, matching the .cljc, so the two cannot
;; disagree about a carry.
(defn u32-from-bytes [b0 :i64 b1 :i64 b2 :i64 b3 :i64] :i64
  (+ (* b0 16777216) (+ (* b1 65536) (+ (* b2 256) b3))))

;; Byte `which` of a 32-bit value, most significant first. The shift counts are
;; literals in each branch because an i64 shift count must be a literal in
;; [0,63] -- a single `(i64-shift-right n (* 8 (- 3 which)))` does not compile.
(defn u32-byte [n :i64 which :i64] :i64
  (if (= which 0) (bit-and (u64-shift-right n 24) 255)
      (if (= which 1) (bit-and (u64-shift-right n 16) 255)
          (if (= which 2) (bit-and (u64-shift-right n 8) 255)
              (bit-and n 255)))))

(defn mss-from-bytes [hi :i64 lo :i64] :i64 (+ (* 256 hi) lo))
(defn mss-hi [mss :i64] :i64 (bit-and (u64-shift-right mss 8) 255))
(defn mss-lo [mss :i64] :i64 (bit-and mss 255))
