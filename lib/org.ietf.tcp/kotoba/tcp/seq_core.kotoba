;; RFC 9293 sequence-number arithmetic, as safe Kotoba.
;;
;; This is `tcp.seq` with two rewrites and no loss of meaning:
;;
;;   (mod n 4294967296)  ->  (bit-and n 4294967295)
;;   (max 0 (dec len))   ->  (if (> len 1) (dec len) 0)
;;
;; The second rewrite is untested, and deliberately so rather than by omission.
;; `max 0` differs from `dec` only at len 0, and len 0 takes the other branch of
;; `acceptable?`, so `end` is computed and discarded. Replacing the whole guard
;; with a bare `(- len 1)` leaves all 26,091 parity assertions green -- that was
;; run. The `max` is dead in the .cljc too. It is kept here because the .cljc
;; keeps it, not because anything depends on it.
;;
;; The first is exact rather than approximate. Two's-complement `bit-and` with
;; 2^32-1 and `mod` by 2^32 agree on every i64, negative ones included, which
;; is the case that matters here -- `-seq` subtracts and then wraps.
;;
;; The second is not a rewrite of `max` in general. It is a rewrite of this
;; call, where the other argument is zero and the value is a length.
;;
;; Everything else is the .cljc source unchanged apart from type annotations.
;; The parity test in test/tcp/seq_kotoba_parity_test.cljk runs both.

(ns tcp.seq-core
  (:export [wrap add-seq sub-seq lt? leq? gt? geq? between? ordered? acceptable?
            segment-end]))

(def modulus-mask 4294967295)                   ; 2^32 - 1
(def half 2147483648)                           ; 2^31

(defn wrap [n :i64] :i64
  (bit-and n modulus-mask))

(defn add-seq [a :i64 b :i64] :i64
  (wrap (+ a b)))

(defn sub-seq [b :i64 a :i64] :i64
  (wrap (- b a)))

(defn lt? [a :i64 b :i64] :bool
  (let [d (sub-seq b a)]
    (and (> d 0) (< d half))))

(defn leq? [a :i64 b :i64] :bool
  (or (= (wrap a) (wrap b)) (lt? a b)))

(defn gt? [a :i64 b :i64] :bool
  (lt? b a))

(defn geq? [a :i64 b :i64] :bool
  (or (= (wrap a) (wrap b)) (gt? a b)))

(defn between? [x :i64 lo :i64 hi :i64] :bool
  (and (leq? lo x) (lt? x hi)))

;; False for the 2^31 antipode, where TCP's comparison is undefined.
(defn ordered? [a :i64 b :i64] :bool
  (not (= (sub-seq b a) half)))

;; SYN and FIN each occupy one sequence number of their own, so they are counted
;; here rather than folded into `len`. A sender that omits them computes an end
;; one short, and every range comparison built on it -- what a SACK block
;; covers, what a cumulative ACK retires -- is wrong by exactly the handshake
;; byte.
(defn segment-end [seg-seq :i64 len :i64 syn? :bool fin? :bool] :i64
  (add-seq seg-seq (+ len (+ (if syn? 1 0) (if fin? 1 0)))))

;; RFC 9293 §3.10.7.4, the four cases kept apart.
(defn acceptable? [seg-seq :i64 seg-len :i64 rcv-nxt :i64 rcv-wnd :i64] :bool
  (let [end (add-seq seg-seq (if (> seg-len 1) (- seg-len 1) 0))
        win-end (add-seq rcv-nxt rcv-wnd)]
    (if (= seg-len 0)
      (if (= rcv-wnd 0)
        (= (wrap seg-seq) (wrap rcv-nxt))
        (between? seg-seq rcv-nxt win-end))
      (if (= rcv-wnd 0)
        false
        (or (between? seg-seq rcv-nxt win-end)
            (between? end rcv-nxt win-end))))))
