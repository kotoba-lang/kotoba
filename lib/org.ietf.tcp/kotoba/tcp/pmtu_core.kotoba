;; RFC 8899 packetization-layer path MTU discovery, as safe Kotoba.
;;
;; The decision core of `tcp.pmtu`: the binary search, the give-up rule, the
;; ICMP verdict and the black-hole test. The discoverer map stays in .cljc.
;;
;; Integer-only and free of shifts, so it reaches the native ISA. `:bool`
;; parameters are used here and are fine on their own -- what amu#611 refuses
;; is a module holding a shift AND a `:bool` parameter, and there is nothing to
;; pack in a search.
;;
;; Two absences from the safe surface show up: `max` is an `if`, and there is
;; no nil. Where the .cljc returns nil for "no probe left" this returns 0, and
;; where the caller had no size to report it passes 0. Zero is not a probe size
;; and not an MTU, so it does not collide with a real answer.
;;
;; Checked against `tcp.pmtu` in test/tcp/pmtu_kotoba_parity_test.cljk.

(ns tcp.pmtu-core
  (:export [midpoint next-probe search-done?
            on-probe-acked-current on-probe-acked-floor
            probe-loss-exhausts? on-probe-lost-ceiling
            icmp-verdict black-hole? mss-for]))

(def min-mtu 1200)                              ; §5.1.1; IPv6 requires 1280 e2e
(def base-mtu 1200)                             ; BASE_PMTU
(def max-probes 3)                              ; §5.1.3 MAX_PROBES
(def black-hole-timeouts 2)                     ; one timeout is ordinary loss

(def st-base 0)
(def st-searching 1)
(def st-search-complete 2)
(def st-error 3)

;; The gap below which probing costs more round trips than the bytes are worth.
(def search-floor-gap 8)

(def icmp-accept 0)
(def icmp-not-quoting-our-packet 1)
(def icmp-no-size 2)
(def icmp-below-floor 3)
(def icmp-not-smaller 4)
(def icmp-contradicts-confirmed 5)

(defn- imax [a :i64 b :i64] :i64 (if (> a b) a b))

(defn midpoint [lo :i64 hi :i64] :i64
  (+ lo (quot (- hi lo) 2)))

;; 0 means "nothing left to learn", which is the .cljc's nil.
(defn next-probe [state :i64 floor :i64 ceiling :i64] :i64
  (if (= state st-search-complete) 0
      (if (> (- ceiling floor) search-floor-gap) (midpoint floor ceiling) 0)))

(defn search-done? [state :i64 floor :i64 ceiling :i64] :bool
  (= (next-probe state floor ceiling) 0))

;; An acknowledgement from the transport is proof the packet arrived, which is
;; why this search needs no ICMP at all: no router had to volunteer anything.
(defn on-probe-acked-current [current :i64 size :i64] :i64 (imax current size))
(defn on-probe-acked-floor [floor :i64 size :i64] :i64 (imax floor size))

;; `probes` counts ATTEMPTS at this size, not losses -- the transmission that
;; was just authorised is already counted as 1. Comparing losses against
;; MAX_PROBES instead gives up after two attempts, one short of the RFC.
(defn probe-loss-exhausts? [probes :i64] :bool
  (> (+ probes 1) max-probes))

(defn on-probe-lost-ceiling [probe-size :i64] :i64 (- probe-size 1))

;; `claimed` 0 means the message named no size. `quote-matches?` is the
;; caller's verified answer to "does the quoted packet match something we
;; actually sent" -- RFC 8201 requires it, and without it anyone who can send
;; an ICMP packet can pin this connection's segments to the floor.
;;
;; The order is load-bearing and matches the .cljc's cond. In particular the
;; news is measured against the CEILING, not against the confirmed size: a
;; router naming 1400 when a probe has confirmed 1350 is telling us something,
;; and comparing against `current` would discard it.
(defn icmp-verdict
  [claimed :i64 ceiling :i64 current :i64 quote-matches? :bool] :i64
  (if (not quote-matches?) icmp-not-quoting-our-packet
      (if (= claimed 0) icmp-no-size
          ;; refused, not clamped: a path that cannot carry the floor is not
          ;; one this transport can use, and clamping hides that behind tiny
          ;; segments.
          (if (< claimed min-mtu) icmp-below-floor
              (if (>= claimed ceiling) icmp-not-smaller
                  ;; A claim at or below a size a probe already carried
                  ;; contradicts evidence this connection gathered itself. A
                  ;; changed path and a forgery are indistinguishable from
                  ;; here, so the confirmed floor stands; the black-hole test
                  ;; is what catches a genuinely changed path, using timeouts
                  ;; rather than anyone's assertion.
                  (if (<= claimed current) icmp-contradicts-confirmed
                      icmp-accept))))))

;; Repeated timeouts at a size that used to work are the black-hole signature:
;; packets dropped by something that will not say so. This is the failure the
;; ICMP method cannot see at all.
(defn black-hole? [data-timeouts :i64 current :i64] :bool
  (and (>= (+ data-timeouts 1) black-hole-timeouts)
       (not (= current base-mtu))))

(defn mss-for [current :i64 header-bytes :i64] :i64
  (imax 1 (- current header-bytes)))
