;; RFC 2018 / RFC 6675 selective acknowledgement, as safe Kotoba.
;;
;; The decision core of `tcp.sack`. What is here is the arithmetic that has to
;; be right per entry and per block: how many blocks fit in the option space,
;; where a queue entry ends, and whether a block covers it. Building the block
;; list, coalescing it and walking the retransmission queue stay in .cljc --
;; those are collection work, and the decisions are the same either way.
;;
;; This module has a real dependency: coverage is a sequence-space comparison
;; and an entry's end is `tcp.seq-core/segment-end`, so it calls that rather
;; than restating either. The .cljc carried two private copies of the end
;; calculation, in `tcp.sack` and `tcp.retransmit`, textually identical -- which
;; is the good case; the bad one is where they stop being. Both now call
;; `tcp.seq/segment-end`. Driving it from a
;; JVM test needs `compile-project`, not `compile-source` -- the latter refuses
;; a `:require` clause outright.
;;
;; Checked against `tcp.sack` in test/tcp/sack_kotoba_parity_test.cljk.

(ns tcp.sack-core
  (:require [tcp.seq-core :as s])
  (:export [max-blocks covered? sack-permitted?]))

(def block-bytes 8)
(def option-header-bytes 2)
(def option-space-bytes 40)
(def timestamp-option-bytes 10)

;; How many blocks fit alongside whatever else the header carries. Timestamps
;; cost ten bytes, which is more than one block: a connection using RFC 7323
;; reports three ranges where one without reports four.
(defn max-blocks [timestamps? :bool] :i64
  (quot (- (- option-space-bytes option-header-bytes)
           (if timestamps? timestamp-option-bytes 0))
        block-bytes))

;; A block covers an entry only if it contains the whole entry. Partial cover
;; is not cover: the uncovered bytes still have to be sent, and marking the
;; entry would drop them.
(defn covered? [entry-seq :i64 end :i64 lo :i64 hi :i64] :bool
  (and (s/geq? entry-seq lo) (s/leq? end hi)))

;; Used only when both SYNs carried SACK-permitted, like every other negotiated
;; option in this stack.
(defn sack-permitted? [ours :bool theirs :bool] :bool
  (and ours theirs))
