;; Out-of-order reassembly range arithmetic, as safe Kotoba.
;;
;; The decision core of `tcp.reassemble`. Splitting, concatenating and sorting
;; byte vectors stay in .cljc; what is here is the arithmetic those operations
;; are steered by, which is where this namespace has actually gone wrong.
;;
;; It went wrong twice, and both are checked here:
;;
;;   `sub-seq` is a FORWARD distance. Asking it how far `at` is from a segment
;;   that begins AFTER `at` returns nearly 2^32 rather than a negative number,
;;   and reading that as "skip everything" discards every out-of-order segment
;;   -- which is the entire case this namespace exists for. The ordering has to
;;   be tested before the distance is computed.
;;
;;   The queue bound belongs on what stays HELD, not on what arrives. In-order
;;   data is delivered and never occupies the queue, so charging arrivals
;;   refuses a large but perfectly ordered segment.
;;
;; Checked against `tcp.reassemble` in test/tcp/reassemble_kotoba_parity_test.cljk.

(ns tcp.reassemble-core
  (:require [tcp.seq-core :as s])
  (:export [seg-end duplicate? trim-skip trimmed-away? overlaps?
            prefix-len held-order-key contiguous? queue-full?]))

(defn seg-end [seg-seq :i64 len :i64] :i64
  (s/add-seq seg-seq len))

;; Entirely at or below what has already been handed up.
(defn duplicate? [seg-seq :i64 len :i64 rcv-nxt :i64] :bool
  (s/leq? (seg-end seg-seq len) rcv-nxt))

;; How many leading bytes of the segment fall below `at`.
;;
;; The ordering test comes first and is the whole point. `sub-seq` cannot
;; return a negative distance, so a segment starting after `at` yields a
;; distance close to 2^32; without the guard that reads as "drop the entire
;; segment" and every out-of-order arrival is thrown away.
(defn trim-skip [at :i64 seg-seq :i64] :i64
  (if (s/leq? at seg-seq) 0 (s/sub-seq at seg-seq)))

;; Nothing survives the trim. The caller reports this as a duplicate rather
;; than as an empty segment -- a segment entirely below rcv-nxt is data already
;; delivered, not a segment with no data in it, and the two get different
;; drop reasons.
(defn trimmed-away? [at :i64 seg-seq :i64 len :i64] :bool
  (>= (trim-skip at seg-seq) len))

;; Half-open ranges overlap when each begins before the other ends. Comparing
;; only one direction reports every later segment as overlapping the earlier
;; one.
(defn overlaps? [a-seq :i64 a-len :i64 b-seq :i64 b-len :i64] :bool
  (and (s/lt? a-seq (seg-end b-seq b-len))
       (s/lt? b-seq (seg-end a-seq a-len))))

;; The part of a piece lying before a held range starts. Zero when the held
;; range begins at or before the piece, and zero when it begins at or after the
;; piece's end -- in both cases there is no prefix, and returning a distance
;; there would cut a piece that has none.
(defn prefix-len [held-seq :i64 piece-seq :i64 piece-len :i64] :i64
  (let [d (s/sub-seq held-seq piece-seq)]
    (if (> d 0) (if (< d piece-len) d 0) 0)))

;; Held ranges are ordered by forward distance from rcv-nxt, not by raw
;; sequence number: across the wrap the raw numbers sort backwards.
(defn held-order-key [seg-seq :i64 rcv-nxt :i64] :i64
  (s/sub-seq seg-seq rcv-nxt))

(defn contiguous? [held-seq :i64 at :i64] :bool
  (= (s/wrap held-seq) (s/wrap at)))

;; On what STAYS HELD. In-order data is delivered and never occupies the queue,
;; so charging arrivals would refuse a large but perfectly ordered segment.
(defn queue-full? [remaining :i64 max-bytes :i64] :bool
  (> remaining max-bytes))
