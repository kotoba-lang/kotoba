(ns tcp.seq-test
  (:require [tcp.seq :as s]
            [kotoba.test :refer [deftest is testing]]))

(deftest comparison-is-modular-not-arithmetic
  (testing "the case a raw < gets wrong: after a wrap, small is newer than large"
    (is (true? (s/lt? 4294967290 5)) "5 comes after 4294967290")
    (is (false? (s/lt? 5 4294967290)))
    (is (true? (s/gt? 5 4294967290)))))

(deftest equality-is-not-before
  (is (false? (s/lt? 100 100)))
  (is (true? (s/leq? 100 100)))
  (is (true? (s/geq? 100 100))))

(deftest the-antipode-is-not-ordered
  (testing "two numbers exactly 2^31 apart cannot be ordered, and neither direction is invented"
    (is (false? (s/lt? 0 s/half)))
    (is (false? (s/lt? s/half 0)))
    (is (false? (s/ordered? 0 s/half)))
    (is (true? (s/ordered? 0 (dec s/half))))))

(deftest distance-wraps-forward
  (is (= 10 (s/-seq 10 0)))
  (is (= 10 (s/-seq 5 4294967291)) "across the wrap")
  (is (= 0 (s/-seq 7 7))))

(deftest a-window-that-wraps-still-contains-its-members
  (let [lo 4294967290 hi (s/+seq lo 20)]
    (is (true? (s/between? lo lo hi)))
    (is (true? (s/between? 3 lo hi)) "3 is inside a window that wrapped")
    (is (false? (s/between? hi lo hi)) "half-open: the top is outside")
    (is (false? (s/between? 100 lo hi)))))

;; ── the four acceptability cases (RFC 9293 3.10.7.4) ─────────────────────

(deftest zero-length-zero-window-accepts-only-an-exact-match
  (is (true? (s/acceptable? 1000 0 1000 0)))
  (is (false? (s/acceptable? 1001 0 1000 0))))

(deftest zero-length-open-window-accepts-inside-the-window
  (is (true? (s/acceptable? 1000 0 1000 100)))
  (is (true? (s/acceptable? 1099 0 1000 100)))
  (is (false? (s/acceptable? 1100 0 1000 100)) "half-open at the top")
  (is (false? (s/acceptable? 999 0 1000 100))))

(deftest data-against-a-closed-window-is-never-acceptable
  (is (false? (s/acceptable? 1000 1 1000 0))
      "the case hand-written stacks let through"))

(deftest data-is-acceptable-if-either-end-lands-in-the-window
  (is (true? (s/acceptable? 1000 10 1000 100)) "starts inside")
  (is (true? (s/acceptable? 995 10 1000 100)) "starts before, ends inside")
  (is (true? (s/acceptable? 1099 10 1000 100)) "starts inside, runs past")
  (is (false? (s/acceptable? 1200 10 1000 100)) "entirely after")
  (is (false? (s/acceptable? 900 10 1000 100)) "entirely before"))

(deftest acceptability-survives-the-wrap
  (let [rcv 4294967290]
    (is (true? (s/acceptable? rcv 10 rcv 100)))
    (is (true? (s/acceptable? 3 1 rcv 100)) "past the wrap, still in window")))
