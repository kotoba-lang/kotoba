(ns tcp.rto-test
  (:require [tcp.rto :as r]
            [kotoba.test :refer [deftest is testing]]))

(deftest before-any-sample-the-timeout-is-one-second
  (let [e (r/estimator)]
    (is (= 1000 (:tcp.rto/rto-ms e)))
    (is (nil? (:tcp.rto/srtt-ms e)) "nil, not zero -- zero is a measurement never taken")
    (is (nil? (:tcp.rto/rttvar-ms e)))))

(deftest the-first-sample-seeds-rather-than-smooths
  (testing "RFC 6298 2.2: SRTT = R, RTTVAR = R/2"
    (let [e (r/sample (r/estimator) 400)]
      (is (= 400.0 (:tcp.rto/srtt-ms e)))
      (is (= 200.0 (:tcp.rto/rttvar-ms e)))
      (is (= 1200 (:tcp.rto/rto-ms e)) "400 + 4*200 = 1200"))))

(deftest later-samples-smooth-with-the-rfc-gains
  (let [e1 (r/sample (r/estimator) 400)
        e2 (r/sample e1 400)]
    (is (= 400.0 (:tcp.rto/srtt-ms e2)) "a steady RTT does not move the mean")
    (is (= 150.0 (:tcp.rto/rttvar-ms e2)) "0.75*200 + 0.25*0 = 150")
    (is (= 1000 (:tcp.rto/rto-ms e2)) "400 + 600 = 1000, at the floor")))

(deftest rttvar-uses-the-old-srtt-so-a-jump-widens-the-headroom
  (testing "updating SRTT first would collapse the deviation exactly when it is needed"
    (let [e1 (r/sample (r/estimator) 100)
          e2 (r/sample e1 500)]
      ;; |100 - 500| = 400 against the OLD srtt; 0.75*50 + 0.25*400 = 137.5
      (is (= 137.5 (:tcp.rto/rttvar-ms e2)))
      (is (= 150.0 (:tcp.rto/srtt-ms e2)) "0.875*100 + 0.125*500"))))

(deftest the-floor-and-the-ceiling-hold
  (is (= r/min-rto-ms (:tcp.rto/rto-ms (r/sample (r/estimator) 1)))
      "a 1 ms network still waits the floor before retransmitting")
  (let [huge (reduce (fn [e _] (r/backoff e)) (r/sample (r/estimator) 30000) (range 10))]
    (is (= r/max-rto-ms (:tcp.rto/rto-ms huge)))))

;; ── Karn ─────────────────────────────────────────────────────────────────

(deftest a-sample-from-a-retransmitted-segment-is-refused
  (let [e1 (r/sample (r/estimator) 400)
        e2 (r/sample e1 5000 true)]
    (is (= (:tcp.rto/srtt-ms e1) (:tcp.rto/srtt-ms e2)) "the estimate did not move")
    (is (= (:tcp.rto/rto-ms e1) (:tcp.rto/rto-ms e2)))
    (is (= :karn (:tcp.rto/last-ignored e2))
        "refused and said so -- a measurement taken and discarded is not the same as none")))

(deftest a-missing-measurement-is-refused-too
  (is (= :not-a-measurement (:tcp.rto/last-ignored (r/sample (r/estimator) nil))))
  (is (= :not-a-measurement (:tcp.rto/last-ignored (r/sample (r/estimator) -5)))))

;; ── backoff ──────────────────────────────────────────────────────────────

(deftest backoff-doubles-and-leaves-the-estimate-alone
  (let [e (r/sample (r/estimator) 400)
        b (r/backoff e)]
    (is (= 2400 (:tcp.rto/rto-ms b)))
    (is (= (:tcp.rto/srtt-ms e) (:tcp.rto/srtt-ms b))
        "a timeout observed nothing; folding it into SRTT invents a measurement")
    (is (= 1 (:tcp.rto/backoffs b)))))

(deftest backoff-is-bounded
  (let [e (reduce (fn [e _] (r/backoff e)) (r/sample (r/estimator) 400) (range 20))]
    (is (= r/max-rto-ms (:tcp.rto/rto-ms e)))))

(deftest recovery-recomputes-from-the-smoothed-values
  (let [e (r/sample (r/estimator) 400)
        backed (r/backoff (r/backoff e))
        back (r/on-ack-after-loss backed)]
    (is (= 1200 (:tcp.rto/rto-ms back)) "back to SRTT + 4*RTTVAR")
    (is (nil? (:tcp.rto/backoffs back)))))

(deftest recovery-without-any-sample-returns-to-the-initial-timeout
  (is (= r/initial-rto-ms
         (:tcp.rto/rto-ms (r/on-ack-after-loss (r/backoff (r/estimator)))))))
