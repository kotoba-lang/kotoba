{:paths ["src"]
 ;; Zero runtime dependencies. Sequence arithmetic and the state machine are
 ;; portable .cljc with no sockets, no buffers and no clock -- the caller passes
 ;; :now-ms, which is what makes TIME-WAIT testable without waiting out 2*MSL.
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; TEST-ONLY. The library keeps zero runtime dependencies; these two
         ;; exist so `kotoba/seq_core.kotoba` can be compiled and run inside the
         ;; test JVM and checked against `tcp.seq`, which is the only thing
         ;; keeping the two implementations from drifting apart in silence.
         :extra-deps {
                      io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.osaho"}
                      io.github.kotoba-lang/compiler
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "1e21a1f56613d7d4c7628af1945ebf1cf7862ff3"}
                      ;; The native executor: signs an artifact, measures the
                      ;; runtime, builds a loader and runs real machine code.
                      ;; Only `seq_native_execution_test` uses it, and it is
                      ;; the only test here that answers "does this run" rather
                      ;; than "does this compile".
                      ;;
                      ;; Named directly rather than inherited from amu, which
                      ;; carries it in a :test alias and therefore does not
                      ;; pass it on. The sha is this library's main, which is
                      ;; ahead of amu's pin: `measure-runtime` only learned to
                      ;; be told where the reviewed loader source is in 9114591.
                      io.github.kotoba-lang/kototama-native
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.kototamaNative"}}}}}
