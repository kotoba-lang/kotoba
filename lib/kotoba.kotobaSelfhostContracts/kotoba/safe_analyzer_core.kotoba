;; safe-analyzer-core — the safe-analyzer's op classification, as a decision
;; that executes.
;;
;; WHY THIS EXISTS
;; ---------------
;; `resources/kotoba/selfhost/safe_analyzer_facts.edn` has carried these four
;; tables since the Rust crates were removed, but nothing read them: the only
;; consumer, `kotoba.selfhost.contracts`, validates seed SHAPE (schema name,
;; owner, canonical-format) and never classifies an op. The analyzer that used
;; to run — `crates/kotoba-clj/selfhost/safe_analyzer.kotoba` — went with the
;; crates. Three documents still describe it as running; see the ADR.
;;
;; So the tables were a fact list with no decision attached. This file is the
;; decision, and it is Kotoba, which is where ADR-safe-capability-language 0.1
;; says the measure of self-hosting lives: not fewer host lines, but more
;; slices whose SAFETY DECISION is authored in Kotoba.
;;
;; AUTHORITY SPLIT (do not collapse it)
;; ------------------------------------
;;   safe_analyzer_facts.edn  owns WHICH ops are in each class (the list)
;;   this file               owns WHAT IT MEANS to be in one   (the decision)
;;   safe-analyzer-core-test binds them: every entry must classify true, and a
;;                           non-entry must classify false, in both directions,
;;                           so an edit to either side alone fails CI.
;;
;; Regenerate the predicate bodies from the EDN rather than hand-editing them;
;; the test will tell you immediately if you did not.
;;
;; SHAPE — TEMPORARY, NOT STYLE
;; ----------------------------
;; string in, bool out, no collections: this is the native admission gate
;; (`only-native-word-typed-features?` in kotoba-kir), not a preference and not
;; a language ceiling. When native grows a heap representation, the natural
;; form here is a set membership test over one table value, and this file
;; should take it. `(if (or ...) true false)` rather than a bare `or` for the
;; same kind of reason: `or` still yields :i64 today.
;;
;; Effects: none. Capabilities: none. This is `kotoba/pure`.

(ns safe-analyzer-core
  (:export [facts-schema
            non-executable-form? numeric-result-op?
            effect-op? user-call-excluded-op?
            test-facts-schema test-non-executable-form test-numeric-result-op
            test-effect-op test-user-call-excluded-op]))

(defn facts-schema [] :string
  "kotoba.selfhost.safe-analyzer-facts.v0")

(defn non-executable-form? [op :string] :bool
  ;; 25 entries from :non-executable-forms
  (if (or (string=? op "ns")
          (string=? op "require")
          (string=? op "require-macros")
          (string=? op "use")
          (string=? op "use-macros")
          (string=? op "refer-clojure")
          (string=? op "in-ns")
          (string=? op "alias")
          (string=? op "create-ns")
          (string=? op "remove-ns")
          (string=? op "import")
          (string=? op "gen-class")
          (string=? op "set!")
          (string=? op "defrecord")
          (string=? op "deftype")
          (string=? op "defprotocol")
          (string=? op "extend-type")
          (string=? op "extend-protocol")
          (string=? op "defmulti")
          (string=? op "defmethod")
          (string=? op "defmacro")
          (string=? op "definline")
          (string=? op "defstruct")
          (string=? op "create-struct")
          (string=? op "declare"))
    true
    false))

(defn numeric-result-op? [op :string] :bool
  ;; 28 entries from :numeric-result-ops
  (if (or (string=? op "+")
          (string=? op "-")
          (string=? op "*")
          (string=? op "/")
          (string=? op "quot")
          (string=? op "mod")
          (string=? op "rem")
          (string=? op "inc")
          (string=? op "dec")
          (string=? op "min")
          (string=? op "max")
          (string=? op "bit-and")
          (string=? op "bit-or")
          (string=? op "bit-xor")
          (string=? op "bit-not")
          (string=? op "bit-shift-left")
          (string=? op "bit-shift-right")
          (string=? op "double")
          (string=? op "int")
          (string=? op "str-len")
          (string=? op "byte-at")
          (string=? op "bytes-len")
          (string=? op "has-capability?")
          (string=? op "Math/round")
          (string=? op "Math/floor")
          (string=? op "Math/ceil")
          (string=? op "Math/abs")
          (string=? op "Math/sqrt"))
    true
    false))

(defn effect-op? [op :string] :bool
  ;; 6 entries from :effect-ops
  (if (or (string=? op "kgraph-assert!")
          (string=? op "kgraph-retract!")
          (string=? op "kgraph-get-objects")
          (string=? op "kgraph-query")
          (string=? op "llm-infer")
          (string=? op "has-capability?"))
    true
    false))

(defn user-call-excluded-op? [op :string] :bool
  ;; 37 entries from :user-call-excluded-ops
  (if (or (string=? op "do")
          (string=? op "let")
          (string=? op "loop")
          (string=? op "if")
          (string=? op "fn")
          (string=? op "recur")
          (string=? op "quote")
          (string=? op "var")
          (string=? op "comment")
          (string=? op "+")
          (string=? op "-")
          (string=? op "*")
          (string=? op "/")
          (string=? op "quot")
          (string=? op "mod")
          (string=? op "rem")
          (string=? op "inc")
          (string=? op "dec")
          (string=? op "min")
          (string=? op "max")
          (string=? op "=")
          (string=? op "<")
          (string=? op "<=")
          (string=? op ">")
          (string=? op ">=")
          (string=? op "str-len")
          (string=? op "byte-at")
          (string=? op "bytes-alloc")
          (string=? op "bytes-len")
          (string=? op "bytes-finish")
          (string=? op "byte-append!")
          (string=? op "has-capability?")
          (string=? op "llm-infer")
          (string=? op "kgraph-assert!")
          (string=? op "kgraph-retract!")
          (string=? op "kgraph-get-objects")
          (string=? op "kgraph-query"))
    true
    false))

;; In-language tests. These prove the predicates agree across :jvm-kir, :js and
;; :wasm; exhaustive agreement with the EDN is the CLJ authority test's job.

(defn test-facts-schema [] :i64
  (if (string=? (facts-schema) "kotoba.selfhost.safe-analyzer-facts.v0") 1 0))

(defn test-non-executable-form [] :i64
  (if (and (non-executable-form? "ns")
           (non-executable-form? "defmacro")
           (non-executable-form? "declare")
           (not (non-executable-form? "if"))
           (not (non-executable-form? "kgraph-query")))
    1 0))

(defn test-numeric-result-op [] :i64
  (if (and (numeric-result-op? "+")
           (numeric-result-op? "bit-shift-right")
           (numeric-result-op? "Math/sqrt")
           (not (numeric-result-op? "ns"))
           (not (numeric-result-op? "kgraph-assert!")))
    1 0))

(defn test-effect-op [] :i64
  ;; has-capability? is deliberately in three tables at once: it reports an
  ;; effect, yields a number, and is not a user call. A classifier that made
  ;; the classes exclusive would be wrong about it.
  (if (and (effect-op? "kgraph-assert!")
           (effect-op? "llm-infer")
           (effect-op? "has-capability?")
           (numeric-result-op? "has-capability?")
           (user-call-excluded-op? "has-capability?")
           (not (effect-op? "+")))
    1 0))

(defn test-user-call-excluded-op [] :i64
  (if (and (user-call-excluded-op? "let")
           (user-call-excluded-op? "recur")
           (user-call-excluded-op? "bytes-finish")
           (not (user-call-excluded-op? "ns"))
           (not (user-call-excluded-op? "my-fn")))
    1 0))
