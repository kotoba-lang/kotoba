<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- getOauthConfig -->
  <bpmn:process id="outlook-get-oauth-config" name="Outlook Get OAuth Config" isExecutable="true">
    <bpmn:startEvent id="start-get-oauth-config"/>
    <bpmn:sequenceFlow id="sf-goc-1" sourceRef="start-get-oauth-config" targetRef="task-get-oauth-config"/>
    <bpmn:serviceTask id="task-get-oauth-config" name="Get OAuth Config">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.outlook.get.oauth.config"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-goc-2" sourceRef="task-get-oauth-config" targetRef="end-get-oauth-config"/>
    <bpmn:endEvent id="end-get-oauth-config"/>
  </bpmn:process>

  <!-- startAuth -->
  <bpmn:process id="outlook-start-auth" name="Outlook Start Auth" isExecutable="true">
    <bpmn:startEvent id="start-start-auth"/>
    <bpmn:sequenceFlow id="sf-sta-1" sourceRef="start-start-auth" targetRef="task-start-auth"/>
    <bpmn:serviceTask id="task-start-auth" name="Start Auth">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.outlook.start.auth"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-sta-2" sourceRef="task-start-auth" targetRef="end-start-auth"/>
    <bpmn:endEvent id="end-start-auth"/>
  </bpmn:process>

  <!-- exchangeCode -->
  <bpmn:process id="outlook-exchange-code" name="Outlook Exchange Code" isExecutable="true">
    <bpmn:startEvent id="start-exchange-code"/>
    <bpmn:sequenceFlow id="sf-ec-1" sourceRef="start-exchange-code" targetRef="task-exchange-code"/>
    <bpmn:serviceTask id="task-exchange-code" name="Exchange Code">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.outlook.exchange.code"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ec-2" sourceRef="task-exchange-code" targetRef="end-exchange-code"/>
    <bpmn:endEvent id="end-exchange-code"/>
  </bpmn:process>

  <!-- getAuthStatus -->
  <bpmn:process id="outlook-get-auth-status" name="Outlook Get Auth Status" isExecutable="true">
    <bpmn:startEvent id="start-get-auth-status"/>
    <bpmn:sequenceFlow id="sf-gas-1" sourceRef="start-get-auth-status" targetRef="task-get-auth-status"/>
    <bpmn:serviceTask id="task-get-auth-status" name="Get Auth Status">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.outlook.get.auth.status"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gas-2" sourceRef="task-get-auth-status" targetRef="end-get-auth-status"/>
    <bpmn:endEvent id="end-get-auth-status"/>
  </bpmn:process>

  <!-- getConnection -->
  <bpmn:process id="outlook-get-connection" name="Outlook Get Connection" isExecutable="true">
    <bpmn:startEvent id="start-get-connection"/>
    <bpmn:sequenceFlow id="sf-gc-1" sourceRef="start-get-connection" targetRef="task-get-connection"/>
    <bpmn:serviceTask id="task-get-connection" name="Get Connection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.outlook.get.connection"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gc-2" sourceRef="task-get-connection" targetRef="end-get-connection"/>
    <bpmn:endEvent id="end-get-connection"/>
  </bpmn:process>

  <!-- syncMailbox -->
  <bpmn:process id="outlook-sync-mailbox" name="Outlook Sync Mailbox" isExecutable="true">
    <bpmn:startEvent id="start-sync-mailbox"/>
    <bpmn:sequenceFlow id="sf-sm-1" sourceRef="start-sync-mailbox" targetRef="task-sync-mailbox"/>
    <bpmn:serviceTask id="task-sync-mailbox" name="Sync Mailbox">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.outlook.sync.mailbox"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-sm-2" sourceRef="task-sync-mailbox" targetRef="end-sync-mailbox"/>
    <bpmn:endEvent id="end-sync-mailbox"/>
  </bpmn:process>

  <!-- cardHome -->
  <bpmn:process id="outlook-card-home" name="Outlook Card Home" isExecutable="true">
    <bpmn:startEvent id="start-card-home"/>
    <bpmn:sequenceFlow id="sf-ch-1" sourceRef="start-card-home" targetRef="task-card-home"/>
    <bpmn:serviceTask id="task-card-home" name="Card Home">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.outlook.card.home"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ch-2" sourceRef="task-card-home" targetRef="end-card-home"/>
    <bpmn:endEvent id="end-card-home"/>
  </bpmn:process>

  <!-- cardAction -->
  <bpmn:process id="outlook-card-action" name="Outlook Card Action" isExecutable="true">
    <bpmn:startEvent id="start-card-action"/>
    <bpmn:sequenceFlow id="sf-ca-1" sourceRef="start-card-action" targetRef="task-card-action"/>
    <bpmn:serviceTask id="task-card-action" name="Card Action">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.outlook.card.action"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-ca-2" sourceRef="task-card-action" targetRef="end-card-action"/>
    <bpmn:endEvent id="end-card-action"/>
  </bpmn:process>

</bpmn:definitions>
