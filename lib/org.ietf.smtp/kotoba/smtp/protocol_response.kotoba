;; SMTP reply-line structure as ordinary Kotoba values (ADR-2608261100).
;;
;; Product semantics: what a reply line MEANS. The socket, TLS and base64
;; stay in the host — those are mechanism. Command construction is
;; `kotoba/smtp/protocol_commands.{kotoba,cljk}`; the SASL pick is
;; `protocol_core.{kotoba,cljk}`.
;;
;; The oracle scans with `re-matches #"(\d{3})([ -])(.*)"`. ADR-2608650000
;; decision 6 says a design that depends on a regular expression gets the
;; design change BEFORE the migration, rather than waiting for regex to be
;; admitted. RFC 5321 4.2 fixes the first four octets of every reply line,
;; so there is nothing to scan: characters 0-2 are the code, character 3 is
;; the separator, the rest is text. The regex was never carrying its weight.
;;
;; Two shapes here are backend gaps, not the programming model:
;;
;;   1. Four scalar exports rather than one record. Measured 2026-08-26 on
;;      amu dd943e08: a record as a RETURN type is refused — `Reply` and
;;      `[:record Reply]` are read as a body expression ("function must
;;      contain one result expression") and `:record` is "value type is
;;      outside the safe profile". Records inside a function body are fine
;;      (amu test/nbb/fixtures/computed-record-map.kotoba). Removal: when a
;;      record can be named as a return type, these four collapse into one
;;      `response-line` returning {:code :final? :text}, matching the oracle.
;;   2. `digit` is a ten-way `cond` because there is no character type and
;;      no parse-long. Removal: when a digit-value builtin is admitted.
;;
;;
;; RFC 3463's enhanced status is here too: it is the front of a reply's TEXT,
;; the same subject as the rest of this module, and the transaction records
;; it per refused recipient (`kotoba/smtp/session.kotoba`). It has the same
;; regex-to-positional design change as the reply line — `^` anchors the
;; oracle's match, so nothing was ever being searched for.
;;
;; `.cljc` remains the oracle. This file is not required from
;; `smtp.protocol` (require-graph). Clojure-shaped twin: protocol_response.cljk.
;;
;; Compile (the CLI needs -M and an ABSOLUTE source path):
;;   kotoba -M compile /abs/kotoba/smtp/protocol_response.kotoba \
;;     --target wasm32-browser --output response.wasm
;;   kotoba -M compile /abs/kotoba/smtp/protocol_response.kotoba \
;;     --target js-browser --output response.mjs

(ns smtp.protocol-response
  (:export [response-line? response-code response-final? response-text
            enhanced-status]))

(defn- digit [line :string i :i64] :i64
  (let [c (string-substring line i (+ i 1))]
    (cond
      (string=? c "0") 0
      (string=? c "1") 1
      (string=? c "2") 2
      (string=? c "3") 3
      (string=? c "4") 4
      (string=? c "5") 5
      (string=? c "6") 6
      (string=? c "7") 7
      (string=? c "8") 8
      (string=? c "9") 9
      :else -1)))

(defn- three-digits? [line :string] :bool
  (and (>= (digit line 0) 0)
       (>= (digit line 1) 0)
       (>= (digit line 2) 0)))

(defn- separator? [line :string] :bool
  (let [s (string-substring line 3 4)]
    (or (string=? s " ") (string=? s "-"))))

(defn response-line? [line :string] :bool
  (and (>= (string-length line) 4)
       (three-digits? line)
       (separator? line)))

(defn response-code [line :string] :i64
  (if (response-line? line)
    (+ (* (digit line 0) 100)
       (* (digit line 1) 10)
       (digit line 2))
    -1))

(defn response-final? [line :string] :bool
  (if (response-line? line)
    (let [sep (string-substring line 3 4)]
      (string=? sep " "))
    false))

(defn response-text [line :string] :string
  (if (response-line? line)
    (string-substring line 4 (string-length line))
    ""))

;; ---------------------------------------------- enhanced status (RFC 3463)

;; `550` says a message was rejected; `5.1.1` says the mailbox does not exist
;; and `5.7.1` says delivery was refused on policy grounds. Those are
;; different conversations to have with whoever sent it, and the three-digit
;; reply code alone cannot tell them apart, so the transaction records it per
;; refused recipient (`kotoba/smtp/session.kotoba`).
;;
;; The oracle scans `#"^\s*([245]\.\d{1,3}\.\d{1,3})\b"`. As with the reply
;; line above, ADR-2608650000 decision 6 takes the design change rather than
;; waiting for regex: `^` already anchors the match, so nothing is being
;; searched for — the code either starts the text or is absent. What is left
;; is a walk with three bounded runs and one word boundary.

(defn- ws-at? [s :string i :i64] :bool
  (string-contains? " \t\r\n" (string-substring s i (+ i 1))))

(defn- skip-ws [s :string i :i64] :i64
  (cond
    (>= i (string-length s)) i
    (ws-at? s i) (skip-ws s (+ i 1))
    :else i))

(defn- digit-at? [s :string i :i64] :bool
  (>= (digit s i) 0))

;; At most `limit` digits, so `\d{1,3}` cannot run away on a long number.
(defn- digits-end [s :string i :i64 limit :i64] :i64
  (cond
    (= limit 0) i
    (>= i (string-length s)) i
    (digit-at? s i) (digits-end s (+ i 1) (- limit 1))
    :else i))

;; `\b`: end of string, or a character that cannot continue a word. Without
;; it "5.1.1234" would be read as the status "5.1.123".
(defn- boundary? [s :string i :i64] :bool
  (if (>= i (string-length s))
    true
    (not (string-contains?
          "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
          (string-substring s i (+ i 1))))))

(defn- status-end [text :string a :i64 d2 :i64 start2 :i64] :string
  (cond
    (= d2 start2) ""
    (boundary? text d2) (string-substring text a d2)
    :else ""))

(defn- status-tail [text :string a :i64 d1 :i64] :string
  (cond
    (= d1 (+ a 2)) ""
    (>= d1 (string-length text)) ""
    (not (string=? (string-substring text d1 (+ d1 1)) ".")) ""
    :else (status-end text a (digits-end text (+ d1 1) 3) (+ d1 1))))

(defn- status-from [text :string a :i64] :string
  (cond
    ;; "2.0.0" is the shortest possible code: five characters from `a`.
    (>= (+ a 4) (string-length text)) ""
    (not (string-contains? "245" (string-substring text a (+ a 1)))) ""
    (not (string=? (string-substring text (+ a 1) (+ a 2)) ".")) ""
    :else (status-tail text a (digits-end text (+ a 2) 3))))

(defn enhanced-status [text :string] :string
  (status-from text (skip-ws text 0)))
