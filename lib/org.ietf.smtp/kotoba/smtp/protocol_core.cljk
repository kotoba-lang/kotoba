;; Clojure-shaped twin of protocol_core.kotoba (:clj-kotoba / .cljk).
;;
;; Fallback: SASL pick as scalars because max-parameters is 5. Command
;; strings are protocol_commands.cljk, not this file.
;;
;; The body keeps the same `and`/`or`/`if` as the .cljc oracle.
;;
;; Three annotations survive here and nowhere else in this module, and they
;; are the ones the compiler genuinely needs: `auth-pick`'s three `:bool`
;; parameters. Untyped `or` of two `=` is i64 (the css port measured this),
;; so `if` would see two branch types -- inference cannot recover what the
;; body never requires. That is a compiler fact, not a reason to rewrite the
;; table as nested `if`.
;;
;; The other fifteen were removed. Each removal was kept only when the
;; signature map stayed identical, and the emitted wasm32 is byte-identical
;; to the fully annotated version.
;;
;; The parameter vector is now mixed -- `[n-advertised has-xoauth2 :bool ...]`
;; -- which the grammar did not allow until per-parameter annotation landed.
;;
;; Compile:
;;   kotoba compile kotoba/smtp/protocol_core.cljk --target wasm -o core.wasm
;;   kotoba compile kotoba/smtp/protocol_core.cljk --target web -o core.mjs

(ns smtp.protocol-core
  (:export [positive? xoauth2-continue? auth-pick
            auth-none auth-xoauth2 auth-plain auth-login auth-unsupported]))

(defn auth-none [] 0)
(defn auth-xoauth2 [] 1)
(defn auth-plain [] 2)
(defn auth-login [] 3)
(defn auth-unsupported [] 4)

(defn positive? [code]
  (< code 400))

(defn xoauth2-continue? [code]
  (= code 334))

(defn- has-token? [creds]
  (or (= creds 1) (= creds 3)))

(defn- has-password? [creds]
  (or (= creds 2) (= creds 3)))

(defn auth-pick
  [n-advertised has-xoauth2 :bool has-plain :bool has-login :bool creds]
  :i64
  (if (and has-xoauth2 (has-token? creds)) (auth-xoauth2)
      (if (and has-plain (has-password? creds)) (auth-plain)
          (if (and has-login (has-password? creds)) (auth-login)
              (if (> n-advertised 0) (auth-unsupported) (auth-none))))))
