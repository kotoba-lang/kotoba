;; Clojure-shaped twin of protocol_response.kotoba (:clj-kotoba / .cljk).
;;
;; Same positional parse, same `string=?` digit table. `.cljk` is :clj-kotoba,
;; not a JVM target.
;;
;; No type annotations. There used to be 45 of them, written because an absent
;; annotation meant `:i64` and anything touching a string had to say so; the
;; frontend infers a parameter's type from what its body requires now, and a
;; result's from what the body returns. Removing all 45 leaves the emitted
;; wasm32 byte-identical, which is how they were established to be redundant
;; rather than by reading them.
;;
;;
;; RFC 3463's enhanced status is here too: it is the front of a reply's TEXT,
;; the same subject as the rest of this module, and the transaction records
;; it per refused recipient (`kotoba/smtp/session.kotoba`). It has the same
;; regex-to-positional design change as the reply line — `^` anchors the
;; oracle's match, so nothing was ever being searched for.
;;
;; Compile (the CLI needs -M and an ABSOLUTE source path):
;;   kotoba -M compile /abs/kotoba/smtp/protocol_response.cljk \
;;     --target wasm32-browser --output response.wasm
;;   kotoba -M compile /abs/kotoba/smtp/protocol_response.cljk \
;;     --target js-browser --output response.mjs

(ns smtp.protocol-response
  (:export [response-line? response-code response-final? response-text
            enhanced-status]))

(defn- digit [line i]
  (let [c (string-substring line i (+ i 1))]
    (cond
      (string=? c "0") 0
      (string=? c "1") 1
      (string=? c "2") 2
      (string=? c "3") 3
      (string=? c "4") 4
      (string=? c "5") 5
      (string=? c "6") 6
      (string=? c "7") 7
      (string=? c "8") 8
      (string=? c "9") 9
      :else -1)))

(defn- three-digits? [line]
  (and (>= (digit line 0) 0)
       (>= (digit line 1) 0)
       (>= (digit line 2) 0)))

(defn- separator? [line]
  (let [s (string-substring line 3 4)]
    (or (string=? s " ") (string=? s "-"))))

(defn response-line? [line]
  (and (>= (string-length line) 4)
       (three-digits? line)
       (separator? line)))

(defn response-code [line]
  (if (response-line? line)
    (+ (* (digit line 0) 100)
       (* (digit line 1) 10)
       (digit line 2))
    -1))

(defn response-final? [line]
  (if (response-line? line)
    (let [sep (string-substring line 3 4)]
      (string=? sep " "))
    false))

(defn response-text [line]
  (if (response-line? line)
    (string-substring line 4 (string-length line))
    ""))

;; ---------------------------------------------- enhanced status (RFC 3463)

;; `550` says a message was rejected; `5.1.1` says the mailbox does not exist
;; and `5.7.1` says delivery was refused on policy grounds. Those are
;; different conversations to have with whoever sent it, and the three-digit
;; reply code alone cannot tell them apart, so the transaction records it per
;; refused recipient (`kotoba/smtp/session.kotoba`).
;;
;; The oracle scans `#"^\s*([245]\.\d{1,3}\.\d{1,3})\b"`. As with the reply
;; line above, ADR-2608650000 decision 6 takes the design change rather than
;; waiting for regex: `^` already anchors the match, so nothing is being
;; searched for — the code either starts the text or is absent. What is left
;; is a walk with three bounded runs and one word boundary.

(defn- ws-at? [s i]
  (string-contains? " \t\r\n" (string-substring s i (+ i 1))))

(defn- skip-ws [s i]
  (cond
    (>= i (string-length s)) i
    (ws-at? s i) (skip-ws s (+ i 1))
    :else i))

(defn- digit-at? [s i]
  (>= (digit s i) 0))

;; At most `limit` digits, so `\d{1,3}` cannot run away on a long number.
(defn- digits-end [s i limit]
  (cond
    (= limit 0) i
    (>= i (string-length s)) i
    (digit-at? s i) (digits-end s (+ i 1) (- limit 1))
    :else i))

;; `\b`: end of string, or a character that cannot continue a word. Without
;; it "5.1.1234" would be read as the status "5.1.123".
(defn- boundary? [s i]
  (if (>= i (string-length s))
    true
    (not (string-contains?
          "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
          (string-substring s i (+ i 1))))))

(defn- status-end [text a d2 start2]
  (cond
    (= d2 start2) ""
    (boundary? text d2) (string-substring text a d2)
    :else ""))

(defn- status-tail [text a d1]
  (cond
    (= d1 (+ a 2)) ""
    (>= d1 (string-length text)) ""
    (not (string=? (string-substring text d1 (+ d1 1)) ".")) ""
    :else (status-end text a (digits-end text (+ d1 1) 3) (+ d1 1))))

(defn- status-from [text a]
  (cond
    ;; "2.0.0" is the shortest possible code: five characters from `a`.
    (>= (+ a 4) (string-length text)) ""
    (not (string-contains? "245" (string-substring text a (+ a 1)))) ""
    (not (string=? (string-substring text (+ a 1) (+ a 2)) ".")) ""
    :else (status-tail text a (digits-end text (+ a 2) 3))))

(defn enhanced-status [text]
  (status-from text (skip-ws text 0)))
