;; SMTP command lines as ordinary Kotoba values (ADR-2608261100).
;;
;; Product semantics: what the session says on the wire. The socket, TLS,
;; base64 encoder and response-line regex stay in .cljc / the host — those
;; are mechanism. EHLO / MAIL FROM / RCPT TO / AUTH / DATA / QUIT are not
;; judgement tables; they are strings, the same as amu's todo-app.
;;
;; `str` has no admitted lowering today (compile fails :subset). Nested
;; `string-concat` (arity 2) is the lowering, not a reason to flatten
;; commands into integers. Removal: when `str` is admitted, this file can
;; read `(str "EHLO " domain "\r\n")`.
;;
;; `.cljc` remains the oracle. This file is not required from
;; `smtp.protocol` (require-graph). Clojure-shaped twin: protocol_commands.cljk.
;;
;; Compile:
;;   kotoba compile kotoba/smtp/protocol_commands.kotoba --target wasm -o commands.wasm
;;   kotoba compile kotoba/smtp/protocol_commands.kotoba --target web  -o commands.mjs

(ns smtp.protocol-commands
  (:export [ehlo-line starttls-line mail-from-line rcpt-to-line
            data-line rset-line noop-line quit-line
            auth-login-line auth-plain-line auth-xoauth2-line
            payload-line empty-line]))

(defn- line [s :string] :string
  (string-concat s "\r\n"))

(defn empty-line [] :string "\r\n")

(defn payload-line [s :string] :string
  (line s))

(defn ehlo-line [domain :string] :string
  (line (string-concat "EHLO " domain)))

(defn starttls-line [] :string
  (line "STARTTLS"))

(defn mail-from-line [mailbox :string] :string
  (line (string-concat "MAIL FROM:<" (string-concat mailbox ">"))))

(defn rcpt-to-line [mailbox :string] :string
  (line (string-concat "RCPT TO:<" (string-concat mailbox ">"))))

(defn data-line [] :string
  (line "DATA"))

(defn rset-line [] :string
  (line "RSET"))

(defn noop-line [] :string
  (line "NOOP"))

(defn quit-line [] :string
  (line "QUIT"))

(defn auth-login-line [] :string
  (line "AUTH LOGIN"))

(defn auth-plain-line [payload :string] :string
  (line (string-concat "AUTH PLAIN " payload)))

(defn auth-xoauth2-line [payload :string] :string
  (line (string-concat "AUTH XOAUTH2 " payload)))
