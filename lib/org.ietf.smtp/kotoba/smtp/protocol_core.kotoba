;; RFC 5321 reply-class and SASL pick, as a Kotoba fallback (ADR-2608261100).
;;
;; Named backends still take only five scalar parameters here, so the SASL
;; table is packed into integers. That is a backend gap, not the language's
;; programming model and not the template for the rest of SMTP. Command
;; construction — strings — is `kotoba/smtp/protocol_commands.{kotoba,cljk}`.
;; Response-line regex, base64 and the socket stay in .cljc / the host.
;;
;; The SASL table is the reason this core exists at all. `authenticate!`
;; used to re-derive the preference inline; a second copy in Kotoba would
;; drift in silence unless something compared them. The codes below are the
;; wire between this file and `smtp.protocol/auth-pick`.
;;
;;   0 none           server advertised no AUTH (IP / client-cert is fine)
;;   1 XOAUTH2
;;   2 PLAIN
;;   3 LOGIN
;;   4 unsupported    advertised only mechanisms this client does not implement
;;
;; `creds` packs the caller's secrets so the pick stays inside max-parameters
;; (5): 0 neither, 1 token, 2 password, 3 both.
;;
;; Checked against `smtp.protocol` in test/smtp/protocol_kotoba_parity_test.cljk.
;;
;; Clojure-shaped twin: `protocol_core.cljk`. Compile either with
;; `kotoba compile kotoba/smtp/protocol_core.kotoba --target wasm -o core.wasm`
;; `kotoba compile kotoba/smtp/protocol_core.cljk --target wasm -o core.wasm`

(ns smtp.protocol-core
  (:export [positive? xoauth2-continue? auth-pick
            auth-none auth-xoauth2 auth-plain auth-login auth-unsupported]))

(defn auth-none [] :i64 0)
(defn auth-xoauth2 [] :i64 1)
(defn auth-plain [] :i64 2)
(defn auth-login [] :i64 3)
(defn auth-unsupported [] :i64 4)

(defn positive? [code :i64] :bool
  (< code 400))

(defn xoauth2-continue? [code :i64] :bool
  (= code 334))

(defn- has-token? [creds :i64] :bool
  (or (= creds 1) (= creds 3)))

(defn- has-password? [creds :i64] :bool
  (or (= creds 2) (= creds 3)))

(defn auth-pick
  [n-advertised :i64 has-xoauth2 :bool has-plain :bool has-login :bool creds :i64]
  :i64
  (if (and has-xoauth2 (has-token? creds)) (auth-xoauth2)
      (if (and has-plain (has-password? creds)) (auth-plain)
          (if (and has-login (has-password? creds)) (auth-login)
              (if (> n-advertised 0) (auth-unsupported) (auth-none))))))
