(ns smtp.kotoba.protocol-core
  "Pure SMTP RFC 5321 protocol functions - Kotoba guest.
   Mirrors smtp.protocol.cljc with Kotoba-admitted operations only."
  (:export [auth-none auth-xoauth2 auth-plain auth-login auth-unsupported
            response-line positive? auth-pick auth-pick-from command pos?]))

;; SASL pick codes (same as protocol.cljc)
(def auth-none 0)
(def auth-xoauth2 1)
(def auth-plain 2)
(def auth-login 3)
(def auth-unsupported 4)

;; Positive check helper
(defn pos? [n]
  (> n 0))

;; Parse SMTP response line - simplified without regex
(defn response-line
  "Parse SMTP response line into {:code int :final? bool :text str} or nil"
  [line]
  (let [len (count line)]
    (if (< len 3)
      nil
      (let [c0 (int (nth line 0))
            c1 (int (nth line 1))
            c2 (int (nth line 2))]
        (if (or (< c0 48) (> c0 53)
                (< c1 48) (> c1 57)
                (< c2 48) (> c2 57))
          nil
          (let [code (+ (* (- c0 48) 100)
                        (* (- c1 48) 10)
                        (- c2 48))
                sep (if (>= len 4) (nth line 3) " ")
                text (if (>= len 4) (subs line 4) "")]
            {:code code :final? (= sep " ") :text text})))))))

;; Positive response code check (2xx/3xx)
(defn positive?
  "True for 2xx/3xx (success or positive-intermediate)"
  [code]
  (and code (< code 400)))

;; Command building
(defn command
  "One CRLF-terminated command line"
  [& parts]
  (let [non-empty (filter (fn [p] (and p (not= p nil))) parts)]
    (str (apply str non-empty) "\r\n")))

;; Command lines
(defn ehlo-line [domain]
  (command "EHLO " domain))

(defn starttls-line []
  (command "STARTTLS"))

(defn mail-from-line [mailbox]
  (command "MAIL FROM:<" mailbox ">"))

(defn rcpt-to-line [mailbox]
  (command "RCPT TO:<" mailbox ">"))

(defn data-line []
  (command "DATA"))

(defn rset-line []
  (command "RSET"))

(defn noop-line []
  (command "NOOP"))

(defn quit-line []
  (command "QUIT"))

(defn auth-login-line []
  (command "AUTH LOGIN"))

(defn auth-plain-line [payload]
  (command "AUTH PLAIN " payload))

(defn auth-xoauth2-line [payload]
  (command "AUTH XOAUTH2 " payload))

(defn payload-line [s]
  (str s "\r\n"))

(defn empty-line []
  "\r\n")

;; Credential code packing
(defn creds-code
  "Pack token/password presence into one integer (0=neither, 1=token, 2=password, 3=both)"
  [has-token? has-password?]
  (if has-token?
    (if has-password? 3 1)
    (if has-password? 2 0)))

;; Auth mechanism selection
(defn auth-pick
  "Which SASL mechanism to attempt, given scalars"
  [n-advertised has-xoauth2? has-plain? has-login? creds]
  (let [has-token? (or (= creds 1) (= creds 3))
        has-password? (or (= creds 2) (= creds 3))]
    (cond
      (and has-xoauth2? has-token?) auth-xoauth2
      (and has-plain? has-password?) auth-plain
      (and has-login? has-password?) auth-login
      (pos? n-advertised) auth-unsupported
      :else auth-none)))

(defn auth-pick-from
  "auth-pick over the set authenticate! already holds"
  [mechanisms access-token password]
  (let [has-token? (and access-token (not= access-token nil))
        has-password? (and password (not= password nil))]
    (auth-pick (count mechanisms)
               has-token?
               has-password?
               has-password?
               (creds-code has-token? has-password?))))
