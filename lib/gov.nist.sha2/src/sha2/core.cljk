(ns sha2.core
  "SHA-224 and SHA-256 (NIST FIPS 180-4), plus HMAC (FIPS 198-1), in portable
   `.cljc` with no dependencies.

   ```clojure
   (require '[sha2.core :as sha2])

   (sha2/sha256 bytes)        ; => 32 unsigned bytes
   (sha2/sha256-hex bytes)    ; => lowercase hex string
   (sha2/sha224 bytes)
   (sha2/hmac-sha256 key-bytes message-bytes)
   ```

   Why this exists: `org-tukaani-xz` refuses `.xz` files whose block check is
   SHA-256 because the workspace had no portable SHA-256 to check them with — the
   only options were injecting a host hash or refusing. There was `sha256d` (the
   Bitcoin double hash) and a pile of `capability-hash-sha256` *names*, but no
   library.

   Everything stays in the unsigned 32-bit domain. ClojureScript's bitwise
   operators return signed int32, so every result is normalised through `u32`; on
   the JVM the same code is already unsigned because Clojure integers are 64-bit.

   The round constants are the standard ones (the first 32 bits of the fractional
   parts of the cube roots of the first 64 primes). They are not verified by a
   published checksum, because FIPS 180-4 does not publish one for the table
   itself — instead the suite pins the *digests* against NIST's own test vectors
   and against a reference implementation over hundreds of inputs, which fails
   loudly if any single constant is wrong."
  {:kotoba/export [hex hmac-sha256 hmac-sha256-hex sha224 sha224-hex sha256 sha256-hex u32]}
  (:refer-clojure :exclude [update]))

;; R6QW3: the Kotoba reading (W2/W3: the scan refused this module E2101 at
;; unsigned-bit-shift-right). The guest bit operations are i64-shift-left /
;; u64-shift-right (seed/HEADS); the host op names are shadowed by wrapper
;; functions here so the bodies stay byte-identical in both readings. Forms
;; holding 0x literals take the decimal spelling in the Kotoba reading only
;; (the seed's integer literal rule), and the host collection forms
;; (mapv/into/repeat/subvec/mapcat/take) are walks.
#?(:kotoba
   (defn- unsigned-bit-shift-right [x :i64 n :i64] :i64 (u64-shift-right x n)))
#?(:kotoba
   (defn- bit-shift-left [x :i64 n :i64] :i64 (i64-shift-left x n)))

;; the pad walks (the host's mapv/into/repeat over the byte vector)
#?(:kotoba
   (defn- pad-copy [data :vector-i64 i :i64 n :i64 out :vector-i64] :vector-i64
     (if (>= i n) out (pad-copy data (+ i 1) n (vector-conj out (vector-at data i))))))
#?(:kotoba
   (defn- pad-zeros [out :vector-i64 k :i64] :vector-i64
     (if (<= k 0) out (pad-zeros (vector-conj out 0) (- k 1)))))
#?(:kotoba
   (defn- pad-len [out :vector-i64 hi :i64 lo :i64] :vector-i64
     (let [o1 (vector-conj out (bit-and (quot hi 16777216) 255))
           o2 (vector-conj o1 (bit-and (quot hi 65536) 255))
           o3 (vector-conj o2 (bit-and (quot hi 256) 255))
           o4 (vector-conj o3 (bit-and hi 255))]
       (pad-len-lo o4 lo))))
#?(:kotoba
   (defn- pad-len-lo [out :vector-i64 lo :i64] :vector-i64
     (let [o1 (vector-conj out (bit-and (quot lo 16777216) 255))
           o2 (vector-conj o1 (bit-and (quot lo 65536) 255))
           o3 (vector-conj o2 (bit-and (quot lo 256) 255))]
       (vector-conj o3 (bit-and lo 255)))))

;; one compression round as a state-vector update (the host's 9-name loop
;; exceeds the loop cap of 5; the state is :vector-i64 so the round is vector-assoc)
#?(:kotoba
   (defn- comp-round [t :i64 s :vector-i64 w :vector-i64] :vector-i64
     (let [a (vector-at s 0) b (vector-at s 1) c (vector-at s 2) dd (vector-at s 3)
           e (vector-at s 4) f (vector-at s 5) g (vector-at s 6) h (vector-at s 7)]
       (let [s1 (bit-xor (bit-xor (rotr e 6) (rotr e 11)) (rotr e 25))
             ch (bit-xor (bit-and e f) (bit-and (m32 (bit-not e)) g))
             t1 (m32 (+ h s1 ch (vector-at k t) (vector-at w t)))
             s0 (bit-xor (bit-xor (rotr a 2) (rotr a 13)) (rotr a 22))
             maj (bit-xor (bit-xor (bit-and a b) (bit-and a c)) (bit-and b c))
             t2 (m32 (+ s0 maj))]
         (let [r1 (vector-assoc s 0 (m32 (+ t1 t2)))
               r2 (vector-assoc r1 1 a)
               r3 (vector-assoc r2 2 b)
               r4 (vector-assoc r3 3 c)
               r5 (vector-assoc r4 4 (m32 (+ dd t1)))
               r6 (vector-assoc r5 5 e)
               r7 (vector-assoc r6 6 f)]
           (vector-assoc r7 7 g))))))
#?(:kotoba
   (defn- w-init [block :vector-i64 i :i64 w :vector-i64] :vector-i64
     (if (>= i 16)
       w
       (w-init block (+ i 1)
               (vector-conj w (+ (* 16777216 (vector-at block (* 4 i)))
                                 (* 65536 (vector-at block (+ (* 4 i) 1)))
                                 (* 256 (vector-at block (+ (* 4 i) 2)))
                                 (vector-at block (+ (* 4 i) 3))))))))
#?(:kotoba
   (defn- w-extend [w :vector-i64 t :i64] :vector-i64
     (if (>= t 64)
       w
       (let [w15 (vector-at w (- t 15))
             w2 (vector-at w (- t 2))
             s0 (bit-xor (bit-xor (rotr w15 7) (rotr w15 18)) (unsigned-bit-shift-right w15 3))
             s1 (bit-xor (bit-xor (rotr w2 17) (rotr w2 19)) (unsigned-bit-shift-right w2 10))]
         (w-extend (vector-conj w (m32 (+ (vector-at w (- t 16)) s0 (vector-at w (- t 7)) s1))) (+ t 1))))))
#?(:kotoba
   (defn- comp-loop [t :i64 s :vector-i64 w :vector-i64] :vector-i64
     (if (>= t 64) s (comp-loop (+ t 1) (comp-round t s w) w))))
#?(:kotoba
   (defn- ff-add [out :vector-i64 i :i64 state :vector-i64 s :vector-i64] :vector-i64
     (if (>= i 8)
       out
       (ff-add (vector-conj out (m32 (+ (vector-at state i) (vector-at s i)))) (+ i 1) state s))))

;; the digest walks (the host's subvec/mapcat/take over the word vector)
#?(:kotoba
   (defn- digest-loop [i :i64 s :vector-i64 padded :vector-i64 n :i64] :vector-i64
     (if (>= i n)
       s
       (digest-loop (+ i 64) (compress-block s (sub-vec padded i (+ i 64))) padded n)))
)
#?(:kotoba
   (defn- sub-vec [v :vector-i64 a :i64 b :i64] :vector-i64
     (sub-walk v a b (vector-alloc 0))))
#?(:kotoba
   (defn- sub-walk [v :vector-i64 i :i64 b :i64 out :vector-i64] :vector-i64
     (if (>= i b) out (sub-walk v (+ i 1) b (vector-conj out (vector-at v i))))))
#?(:kotoba
   (defn- words-bytes [s :vector-i64 i :i64 words :i64 out :vector-i64] :vector-i64
     (if (>= i words)
       out
       (let [x (vector-at s i)
             o1 (vector-conj out (bit-and (quot x 16777216) 255))
             o2 (vector-conj o1 (bit-and (quot x 65536) 255))
             o3 (vector-conj o2 (bit-and (quot x 256) 255))
             o4 (vector-conj o3 (bit-and x 255))]
         (words-bytes s (+ i 1) words o4)))))

;; lowercase hex of the bytes as a nibble walk (the host's toString interop)
#?(:kotoba
   (defn- hex-walk [bytes :vector-i64 i :i64 n :i64 acc :string] :string
     (if (>= i n)
       acc
       (hex-walk bytes (+ i 1) n
                 (string-concat acc (string-concat (hex-nibble (quot (vector-at bytes i) 16))
                                                   (hex-nibble (mod (vector-at bytes i) 16)))))))
)
#?(:kotoba
   (defn- hex-nibble [v :i64] :string
     (if (< v 10) (string-from-i64 (+ v 48)) (string-from-i64 (+ v 87)))))

;; the hmac walks (the host's vec/into/repeat/mapv over the key and pads)
#?(:kotoba
   (defn- pad-zeros2 [v :vector-i64 k :i64] :vector-i64
     (if (<= k 0) v (pad-zeros2 (vector-conj v 0) (- k 1)))))
#?(:kotoba
   (defn- xor-walk [v :vector-i64 i :i64 m :i64 out :vector-i64] :vector-i64
     (if (>= i (vector-count v)) out (xor-walk v (+ i 1) m (vector-conj out (bit-xor (vector-at v i) m))))))
#?(:kotoba
   (defn- vec-cat [a :vector-i64 b :vector-i64] :vector-i64
     (vec-cat-walk a 0 b (vector-count b))))
#?(:kotoba
   (defn- vec-cat-walk [a :vector-i64 i :i64 b :vector-i64 n :i64] :vector-i64
     (if (>= i n) a (vec-cat-walk (vector-conj a (vector-at b i)) (+ i 1) b n))))

(defn u32 [x] (if (neg? x) (+ x 4294967296) x))
#?(:kotoba
(defn- m32 [x] (u32 (bit-and x 4294967295)))
   :default
(defn- m32 [x] (u32 (bit-and x 0xffffffff))))
(defn- rotr [x n]
  (m32 (bit-or (unsigned-bit-shift-right x n)
               (bit-shift-left x (- 32 n)))))
#?(:kotoba
(def ^:private k
  [1116352408 1899447441 3049323471 3921009573 961987163 1508970993 2453635748 2870763221
   3624381080 310598401 607225278 1426881987 1925078388 2162078206 2614888103 3248222580
   3835390401 4022224774 264347078 604807628 770255983 1249150122 1555081692 1996064986
   2554220882 2821834349 2952996808 3210313671 3336571891 3584528711 113926993 338241895
   666307205 773529912 1294757372 1396182291 1695183700 1986661051 2177026350 2456956037
   2730485921 2820302411 3259730800 3345764771 3516065817 3600352804 4094571909 275423344
   430227734 506948616 659060556 883997877 958139571 1322822218 1537002063 1747873779
   1955562222 2024104815 2227730452 2361852424 2428436474 2756734187 3204031479 3329325298])
   :default
(def ^:private k
  [0x428a2f98 0x71374491 0xb5c0fbcf 0xe9b5dba5 0x3956c25b 0x59f111f1 0x923f82a4 0xab1c5ed5
   0xd807aa98 0x12835b01 0x243185be 0x550c7dc3 0x72be5d74 0x80deb1fe 0x9bdc06a7 0xc19bf174
   0xe49b69c1 0xefbe4786 0x0fc19dc6 0x240ca1cc 0x2de92c6f 0x4a7484aa 0x5cb0a9dc 0x76f988da
   0x983e5152 0xa831c66d 0xb00327c8 0xbf597fc7 0xc6e00bf3 0xd5a79147 0x06ca6351 0x14292967
   0x27b70a85 0x2e1b2138 0x4d2c6dfc 0x53380d13 0x650a7354 0x766a0abb 0x81c2c92e 0x92722c85
   0xa2bfe8a1 0xa81a664b 0xc24b8b70 0xc76c51a3 0xd192e819 0xd6990624 0xf40e3585 0x106aa070
   0x19a4c116 0x1e376c08 0x2748774c 0x34b0bcb5 0x391c0cb3 0x4ed8aa4a 0x5b9cca4f 0x682e6ff3
   0x748f82ee 0x78a5636f 0x84c87814 0x8cc70208 0x90befffa 0xa4506ceb 0xbef9a3f7 0xc67178f2]))
#?(:kotoba
(def ^:private h-256
  [1779033703 3144134277 1013904242 2773480762 1359893119 2600822924 528734635 1541459225])
   :default
(def ^:private h-256
  [0x6a09e667 0xbb67ae85 0x3c6ef372 0xa54ff53a 0x510e527f 0x9b05688c 0x1f83d9ab 0x5be0cd19]))
#?(:kotoba
(def ^:private h-224
  [3238371032 914150663 812702999 4144912697 4290775857 1750603025 1694076839 3204075428])
   :default
(def ^:private h-224
  [0xc1059ed8 0x367cd507 0x3070dd17 0xf70e5939 0xffc00b31 0x68581511 0x64f98fa7 0xbefa4fa4]))
#?(:kotoba
   (defn- pad
     "FIPS 180-4 5.1.1: append 128, then zeros, then the length in bits as a
   64-bit big-endian integer, so the total is a multiple of 64 bytes. The
   walks replace mapv/into/repeat (the host collection forms)."
     [data :vector-i64] :vector-i64
     (let [n (vector-count data)
           bits (* 8 n)
           zeros (let [r (rem (+ n 1) 64)] (if (<= r 56) (- 56 r) (- 120 r)))
           hi (quot bits 4294967296)
           lo (mod bits 4294967296)]
       (pad-len (pad-zeros (vector-conj (pad-copy data 0 n (vector-alloc 0)) 128) zeros) hi lo)))
   :default
(defn- pad
  "FIPS 180-4 §5.1.1: append 0x80, then zeros, then the message length in bits as
   a 64-bit big-endian integer, so the total is a multiple of 64 bytes.

   The length is written as two 32-bit halves rather than by shifting: a 64-bit
   shift does not exist on ClojureScript, and a message long enough to need the
   high half is exactly the case a shift would get wrong."
  [data]
  (let [n (count data)
        bits (* 8 n)
        zeros (let [r (rem (+ n 1) 64)]
                (if (<= r 56) (- 56 r) (- 120 r)))
        hi (quot bits 4294967296)
        lo (mod bits 4294967296)
        len (mapv #(bit-and % 0xff)
                  [(quot hi 16777216) (quot hi 65536) (quot hi 256) hi
                   (quot lo 16777216) (quot lo 65536) (quot lo 256) lo])]
    (into (into (into (vec data) [0x80]) (repeat zeros 0)) len))))
#?(:kotoba
   (defn- compress-block [state :vector-i64 block :vector-i64] :vector-i64
     (let [w (w-extend (w-init block 0 (vector-alloc 0)) 16)
           s (comp-loop 0 state w)]
       (ff-add (vector-alloc 0) 0 state s)))
   :default
(defn- compress-block
  [state block]
  (let [w (loop [t 16
                 w (mapv (fn [i]
                           (+ (* 16777216 (nth block (* 4 i)))
                              (* 65536 (nth block (+ (* 4 i) 1)))
                              (* 256 (nth block (+ (* 4 i) 2)))
                              (nth block (+ (* 4 i) 3))))
                         (range 16))]
             (if (= t 64)
               w
               (let [w15 (nth w (- t 15))
                     w2 (nth w (- t 2))
                     s0 (bit-xor (rotr w15 7) (rotr w15 18) (unsigned-bit-shift-right w15 3))
                     s1 (bit-xor (rotr w2 17) (rotr w2 19) (unsigned-bit-shift-right w2 10))]
                 (recur (inc t)
                        (conj w (m32 (+ (nth w (- t 16)) s0 (nth w (- t 7)) s1)))))))]
    (loop [t 0
           a (nth state 0) b (nth state 1) c (nth state 2) d (nth state 3)
           e (nth state 4) f (nth state 5) g (nth state 6) h (nth state 7)]
      (if (= t 64)
        [(m32 (+ (nth state 0) a)) (m32 (+ (nth state 1) b))
         (m32 (+ (nth state 2) c)) (m32 (+ (nth state 3) d))
         (m32 (+ (nth state 4) e)) (m32 (+ (nth state 5) f))
         (m32 (+ (nth state 6) g)) (m32 (+ (nth state 7) h))]
        (let [s1 (bit-xor (rotr e 6) (rotr e 11) (rotr e 25))
              ch (bit-xor (bit-and e f) (bit-and (m32 (bit-not e)) g))
              t1 (m32 (+ h s1 ch (nth k t) (nth w t)))
              s0 (bit-xor (rotr a 2) (rotr a 13) (rotr a 22))
              maj (bit-xor (bit-and a b) (bit-and a c) (bit-and b c))
              t2 (m32 (+ s0 maj))]
          (recur (inc t) (m32 (+ t1 t2)) a b c (m32 (+ d t1)) e f g)))))))
#?(:kotoba
   (defn- digest [initial :vector-i64 words :i64 data :vector-i64] :vector-i64
     (let [padded (pad data)
           state (digest-loop 0 initial padded (vector-count padded))]
       (words-bytes state 0 words (vector-alloc 0))))
   :default
(defn- digest
  [initial words data]
  (let [padded (pad data)
        state (loop [i 0 s initial]
                (if (>= i (count padded))
                  s
                  (recur (+ i 64) (compress-block s (subvec padded i (+ i 64))))))]
    (vec (mapcat (fn [x] [(bit-and (quot x 16777216) 0xff)
                          (bit-and (quot x 65536) 0xff)
                          (bit-and (quot x 256) 0xff)
                          (bit-and x 0xff)])
                 (take words state))))))
(defn sha256
  "SHA-256 of `data` (unsigned bytes) → 32 unsigned bytes."
  [data]
  (digest h-256 8 data))
(defn sha224
  "SHA-224 of `data` → 28 unsigned bytes. Same compression function as SHA-256
   with different initial state, truncated to seven words."
  [data]
  (digest h-224 7 data))
#?(:kotoba
   (defn hex [bytes :vector-i64] :string
     (hex-walk bytes 0 (vector-count bytes) (string-substring (string-from-i64 7) 0 0)))
   :default
(defn hex
  "Lowercase hex of a byte vector."
  [bytes]
  (apply str (map (fn [b]
                    (let [s (#?(:clj Integer/toString :cljs .toString) b 16)]
                      (if (= 1 (count s)) (str "0" s) s)))
                  bytes))))
(defn sha256-hex [data] (hex (sha256 data)))
(defn sha224-hex [data] (hex (sha224 data)))
(def ^:private block-size 64)
#?(:kotoba
   (defn hmac-sha256 [key :vector-i64 message :vector-i64] :vector-i64
     (let [kv (if (> (vector-count key) block-size) (sha256 key) key)
           kp (pad-zeros2 kv (- block-size (vector-count kv)))
           ipad (xor-walk kp 0 54 (vector-alloc 0))
           opad (xor-walk kp 0 92 (vector-alloc 0))]
       (sha256 (vec-cat opad (sha256 (vec-cat ipad message))))))
   :default
(defn hmac-sha256
  "HMAC-SHA-256 (FIPS 198-1) of `message` under `key`, both unsigned bytes →
   32 unsigned bytes.

   A key longer than the 64-byte block size is hashed first, and a shorter one is
   zero-padded — not truncated, and not used as-is, which are the two ways this
   gets written wrong."
  [key message]
  (let [k' (let [kv (vec key)]
             (if (> (count kv) block-size) (sha256 kv) kv))
        k' (into k' (repeat (- block-size (count k')) 0))
        ipad (mapv #(bit-xor % 0x36) k')
        opad (mapv #(bit-xor % 0x5c) k')]
    (sha256 (into opad (sha256 (into ipad (vec message))))))))
(defn hmac-sha256-hex [key message] (hex (hmac-sha256 key message)))
