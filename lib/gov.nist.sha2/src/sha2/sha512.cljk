(ns sha2.sha512
  "SHA-512 and SHA-384 (NIST FIPS 180-4) and HMAC-SHA-512 (FIPS 198-1), in
  portable `.cljc` with no dependencies.

  ```clojure
  (require '[sha2.sha512 :as sha512])

  (sha512/sha512 bytes)      ; => 64 unsigned bytes
  (sha512/sha512-hex bytes)
  (sha512/sha384 bytes)      ; => 48
  (sha512/hmac-sha512 key message)
  ```

  Written because Ed25519 (RFC 8032) hashes with SHA-512 and this workspace
  had SHA-224/256 only.

  ## Why a second namespace rather than more of `sha2.core`

  SHA-224/256 are 32-bit and SHA-384/512 are 64-bit, and neither runtime here
  has a 64-bit integer both can name: the JVM does and ClojureScript does
  not. So a word is `[hi lo]`, two unsigned 32-bit halves, and every operation
  in this file is a different one from its 32-bit twin.

  ## Where the constants come from

  They were DERIVED, not transcribed. FIPS 180-4 defines the initial hash
  value as the first 64 bits of the fractional parts of the square roots of
  the first eight primes, the SHA-384 one as the same for the ninth through
  sixteenth, and the round constants as the cube roots of the first eighty.
  All three tables were computed to 80 significant digits and checked against
  the published values before being written here, so no digit passed through
  anyone's memory.

  The suite pins the digests against NIST vectors and against the platform's
  own MessageDigest, which fails loudly if a single constant is wrong."
  {:kotoba/export [hex hmac-sha384 hmac-sha384-hex hmac-sha512 hmac-sha512-hex sha384 sha384-hex sha512 sha512-hex]}
  (:refer-clojure :exclude [update]))

;; ── 64-bit words as [hi lo] ──────────────────────────────────────────────────

;; R6QW3: the Kotoba reading (W3: the selfbuild scan refused this module E2139 at the
;; destructured [hi lo] parameters). The destructured pair parameters become plain
;; :vector-i64 parameters with a let prologue binding the piece names, so every body
;; stays byte-identical in both readings. The host op names are shadowed by wrappers
;; (the guest shifts are i64-shift-left / u64-shift-right) and the collection forms
;; (mapv/seq/int) are walks.
#?(:kotoba
   (defn- unsigned-bit-shift-right [x :i64 n :i64] :i64 (u64-shift-right x n)))
#?(:kotoba
   (defn- bit-shift-left [x :i64 n :i64] :i64 (i64-shift-left x n)))

;; the 64-bit words live as [hi lo] pairs (:vector-i64 of 2); the state, the schedule and
;; the constant tables are FLAT vectors (pair i at 2i, 2i+1) because a typed vector holds
;; one element kind. The pair helpers restore the [hi lo] reading.
#?(:kotoba
   (defn- state-pair [s :vector-i64 i :i64] :vector-i64
     (vector-conj (vector-conj (vector-alloc 0) (vector-at s (* 2 i))) (vector-at s (+ (* 2 i) 1)))))
#?(:kotoba
   (defn- flat-2 [out :vector-i64 x :vector-i64] :vector-i64
     (vector-conj (vector-conj out (vector-at x 0)) (vector-at x 1))))
#?(:kotoba
   (defn- flat-8 [out :vector-i64 a :vector-i64 b :vector-i64 c :vector-i64 dd :vector-i64
                  e :vector-i64 f :vector-i64 g :vector-i64 hh :vector-i64] :vector-i64
     (flat-2 (flat-2 (flat-2 (flat-2 (flat-2 (flat-2 (flat-2 (flat-2 out a) b) c) dd) e) f) g) hh)))
#?(:kotoba
   (defn- w-init512 [block :vector-i64 i :i64 w :vector-i64] :vector-i64
     (if (>= i 16)
       w
       (let [o (* 8 i)]
         (w-init512 block (+ i 1)
                    (vector-conj (vector-conj w
                       (u32 (+ (* 16777216 (vector-at block o)) (* 65536 (vector-at block (+ o 1)))
                               (* 256 (vector-at block (+ o 2))) (vector-at block (+ o 3)))))
                       (u32 (+ (* 16777216 (vector-at block (+ o 4))) (* 65536 (vector-at block (+ o 5)))
                               (* 256 (vector-at block (+ o 6))) (vector-at block (+ o 7))))))))))
#?(:kotoba
   (defn- w-extend512 [w :vector-i64 t :i64] :vector-i64
     (if (>= t 80)
       w
       (w-extend512 (flat-2 w (add64 (add64 (small-sigma1 (state-pair w (- t 2))) (state-pair w (- t 7)))
                                     (add64 (small-sigma0 (state-pair w (- t 15))) (state-pair w (- t 16))))) (+ t 1)))))
#?(:kotoba
   (defn- comp-round512 [t :i64 s :vector-i64 w :vector-i64] :vector-i64
     (let [a (state-pair s 0) b (state-pair s 1) c (state-pair s 2) dd (state-pair s 3)
           e (state-pair s 4) f (state-pair s 5) g (state-pair s 6) hh (state-pair s 7)]
       (let [t1 (add64 (add64 (add64 hh (big-sigma1 e))
                              (add64 (ch e f g) (k-pair t)))
                       (state-pair w t))
             t2 (add64 (big-sigma0 a) (maj a b c))]
         (flat-8 (vector-alloc 0) (add64 t1 t2) a b c (add64 dd t1) e f g)))))
#?(:kotoba
   (defn- comp-loop512 [t :i64 s :vector-i64 w :vector-i64] :vector-i64
     (if (>= t 80) s (comp-loop512 (+ t 1) (comp-round512 t s w) w))))
#?(:kotoba
   (defn- ff-add512 [out :vector-i64 i :i64 h :vector-i64 s :vector-i64] :vector-i64
     (if (>= i 8)
       out
       (ff-add512 (flat-2 out (add64 (state-pair h i) (state-pair s i))) (+ i 1) h s))))
#?(:kotoba
   (defn- compress512 [h :vector-i64 block :vector-i64] :vector-i64
     (let [w (w-extend512 (w-init512 block 0 (vector-alloc 0)) 16)
           s (comp-loop512 0 h w)]
       (ff-add512 (vector-alloc 0) 0 h s))))
#?(:kotoba
   (defn- digest-loop512 [i :i64 n :i64 h :vector-i64 padded :vector-i64] :vector-i64
     (if (>= i n)
       h
       (digest-loop512 (+ i 1) n
                       (compress512 h (sub-vec512 padded (* i block-bytes) (* (+ i 1) block-bytes)))
                       padded))))
#?(:kotoba
   (defn- sub-vec512 [v :vector-i64 a :i64 b :i64] :vector-i64
     (sub-walk512 v a b (vector-alloc 0))))
#?(:kotoba
   (defn- sub-walk512 [v :vector-i64 i :i64 b :i64 out :vector-i64] :vector-i64
     (if (>= i b) out (sub-walk512 v (+ i 1) b (vector-conj out (vector-at v i))))))
#?(:kotoba
   (defn- out-walk [h :vector-i64 i :i64 out-bytes :i64 out :vector-i64] :vector-i64
     (if (>= (* i 8) out-bytes)
       out
       (let [hi (vector-at h (* 2 i))
             lo (vector-at h (+ (* 2 i) 1))
             o1 (vector-conj out (bit-and (quot hi 16777216) 255))
             o2 (vector-conj o1 (bit-and (quot hi 65536) 255))
             o3 (vector-conj o2 (bit-and (quot hi 256) 255))
             o4 (vector-conj o3 (bit-and hi 255))
             o5 (vector-conj o4 (bit-and (quot lo 16777216) 255))
             o6 (vector-conj o5 (bit-and (quot lo 65536) 255))
             o7 (vector-conj o6 (bit-and (quot lo 256) 255))]
         (out-walk h (+ i 1) out-bytes (vector-conj o7 (bit-and lo 255)))))))
#?(:kotoba
   (defn- pad512-copy [bs :vector-i64 i :i64 n :i64 out :vector-i64] :vector-i64
     (if (>= i n) out (pad512-copy bs (+ i 1) n (vector-conj out (vector-at bs i))))))
#?(:kotoba
   (defn- pad512-zeros [out :vector-i64 k :i64] :vector-i64
     (if (<= k 0) out (pad512-zeros (vector-conj out 0) (- k 1)))))
#?(:kotoba
   (defn- len16-bytes [out :vector-i64 i :i64 bits :i64] :vector-i64
     (if (>= i 8)
       out
       (len16-bytes (vector-conj out (bit-and (quot bits (pow256 (- 7 i))) 255)) (+ i 1) bits))))
#?(:kotoba
   (defn- pow256 [e :i64] :i64
     (if (<= e 0) 1 (* 256 (pow256 (- e 1))))))
#?(:kotoba
   (defn- hmac512-pad [v :vector-i64 k :i64] :vector-i64
     (if (<= k 0) v (hmac512-pad (vector-conj v 0) (- k 1)))))
#?(:kotoba
   (defn- xor512-walk [v :vector-i64 i :i64 m :i64 out :vector-i64] :vector-i64
     (if (>= i (vector-count v)) out (xor512-walk v (+ i 1) m (vector-conj out (bit-xor (vector-at v i) m))))))
#?(:kotoba
   (defn- cat512 [a :vector-i64 b :vector-i64] :vector-i64
     (cat512-walk a 0 b (vector-count b))))
#?(:kotoba
   (defn- cat512-walk [a :vector-i64 i :i64 b :vector-i64 n :i64] :vector-i64
     (if (>= i n) a (cat512-walk (vector-conj a (vector-at b i)) (+ i 1) b n))))

