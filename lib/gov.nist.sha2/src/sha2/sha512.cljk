#?(:kotoba
   (def ^:private k-lo [3609767458 602891725 3964484399 2173295548 4081628472 3053834265 2937671579 3664609560 2734883394 1164996542 1323610764 3590304994 4068182383 991336113 633803317 3479774868 2666613458 944711139 2341262773 2007800933 1495990901 1856431235 3175218132 2198950837 3999719339 766784016 2566594879 3203337956 1034457026 2466948901 3758326383 168717936 1188179964 1546045734 1522805485 2643833823 2343527390 1014477480 1206759142 344077627 1290863460 3158454273 3505952657 106217008 3606008344 1432725776 1467031594 851169720 3100823752 1363258195 3750685593 3785050280 3318307427 3812723403 2003034995 3602036899 1575990012 1125592928 2716904306 442776044 593698344 3733110249 2999351573 3815920427 3928383900 566280711 3454069534 4000239992 1914138554 2731055270 3203993006 320620315 587496836 1086792851 365543100 2618297676 3409855158 4234509866 987167468 1246189591]))
#?(:kotoba
   (defn- k-pair [t :i64] :vector-i64
     (vector-conj (vector-conj (vector-alloc 0) (vector-at k-hi t)) (vector-at k-lo t))))
;; the ->ints / hex walks (the host's mapv/seq/int/toString over the byte vector)
#?(:kotoba
   (defn- ints-walk [data :vector-i64 i :i64 n :i64 out :vector-i64] :vector-i64
     (if (>= i n) out (ints-walk data (+ i 1) n (vector-conj out (bit-and (vector-at data i) 255))))))
#?(:kotoba
   (defn- hex-walk512 [bs :vector-i64 i :i64 n :i64 acc :string] :string
     (if (>= i n)
       acc
       (hex-walk512 bs (+ i 1) n
                    (string-concat acc (string-concat (hex-nib512 (quot (vector-at bs i) 16))
                                                      (hex-nib512 (mod (vector-at bs i) 16))))))))
#?(:kotoba
   (defn- hex-nib512 [v :i64] :string
     (if (< v 10) (string-from-i64 (+ v 48)) (string-from-i64 (+ v 87)))))

#?(:kotoba
   (defn- u32 [x] (bit-and x 4294967295))
   :default
(defn- u32 [x]
  #?(:clj (bit-and x 0xFFFFFFFF)
     :cljs (unsigned-bit-shift-right x 0)
     ;; Kotoba: integers are i64, so the :clj mask is exact. Without a
     ;; :default clause the Kotoba reader (features #{:kotoba}) read this
     ;; body as nothing -- "function body is empty" (adr-2609111900).
     :default (bit-and x 0xFFFFFFFF))))
#?(:kotoba
   (defn- add64 [g1 :vector-i64 g2 :vector-i64]
     (let [ahi (vector-at g1 0) alo (vector-at g1 1) bhi (vector-at g2 0) blo (vector-at g2 1)]

  (let [lo (+ alo blo)
        carry (if (>= lo 4294967296) 1 0)]
    [(u32 (+ ahi bhi carry)) (if (= 1 carry) (- lo 4294967296) lo)])))
   :default
(defn- add64 [[ahi alo] [bhi blo]]
  (let [lo (+ alo blo)
        carry (if (>= lo 4294967296) 1 0)]
    [(u32 (+ ahi bhi carry)) (if (= 1 carry) (- lo 4294967296) lo)])))
#?(:kotoba
   (defn- xor64 [g1 :vector-i64 g2 :vector-i64]
     (let [ahi (vector-at g1 0) alo (vector-at g1 1) bhi (vector-at g2 0) blo (vector-at g2 1)]
 [(u32 (bit-xor ahi bhi)) (u32 (bit-xor alo blo))]))
   :default
(defn- xor64 [[ahi alo] [bhi blo]] [(u32 (bit-xor ahi bhi)) (u32 (bit-xor alo blo))]))
#?(:kotoba
   (defn- and64 [g1 :vector-i64 g2 :vector-i64]
     (let [ahi (vector-at g1 0) alo (vector-at g1 1) bhi (vector-at g2 0) blo (vector-at g2 1)]
 [(u32 (bit-and ahi bhi)) (u32 (bit-and alo blo))]))
   :default
(defn- and64 [[ahi alo] [bhi blo]] [(u32 (bit-and ahi bhi)) (u32 (bit-and alo blo))]))
#?(:kotoba
   (defn- not64 [g1 :vector-i64]
     (let [hi (vector-at g1 0) lo (vector-at g1 1)]
 [(u32 (bit-not hi)) (u32 (bit-not lo))]))
   :default
(defn- not64 [[hi lo]] [(u32 (bit-not hi)) (u32 (bit-not lo))]))
#?(:kotoba
   (defn- rotr64 [g1 :vector-i64 n]
     (let [hi (vector-at g1 0) lo (vector-at g1 1)]

  (cond
    (= n 32) [lo hi]
    (< n 32) [(u32 (bit-or (unsigned-bit-shift-right hi n) (bit-shift-left lo (- 32 n))))
              (u32 (bit-or (unsigned-bit-shift-right lo n) (bit-shift-left hi (- 32 n))))]
    :else (let [n (- n 32)]
            (if (zero? n)
              [lo hi]
              [(u32 (bit-or (unsigned-bit-shift-right lo n) (bit-shift-left hi (- 32 n))))
               (u32 (bit-or (unsigned-bit-shift-right hi n) (bit-shift-left lo (- 32 n))))])))))
   :default
(defn- rotr64
  "Rotate right by `n`, 0 < n < 64.

  `n = 32` is a half swap and is written as one: expressing it as a shift
  would ask ClojureScript for `<< 32`, which it silently performs as `<< 0`."
  [[hi lo] n]
  (cond
    (= n 32) [lo hi]
    (< n 32) [(u32 (bit-or (unsigned-bit-shift-right hi n) (bit-shift-left lo (- 32 n))))
              (u32 (bit-or (unsigned-bit-shift-right lo n) (bit-shift-left hi (- 32 n))))]
    :else (let [n (- n 32)]
            (if (zero? n)
              [lo hi]
              [(u32 (bit-or (unsigned-bit-shift-right lo n) (bit-shift-left hi (- 32 n))))
               (u32 (bit-or (unsigned-bit-shift-right hi n) (bit-shift-left lo (- 32 n))))])))))
#?(:kotoba
   (defn- shr64 [g1 :vector-i64 n]
     (let [hi (vector-at g1 0) lo (vector-at g1 1)]

  (cond
    (= n 32) [0 hi]
    (< n 32) [(u32 (unsigned-bit-shift-right hi n))
              (u32 (bit-or (unsigned-bit-shift-right lo n) (bit-shift-left hi (- 32 n))))]
    :else [0 (u32 (unsigned-bit-shift-right hi (- n 32)))])))
   :default
(defn- shr64 [[hi lo] n]
  (cond
    (= n 32) [0 hi]
    (< n 32) [(u32 (unsigned-bit-shift-right hi n))
              (u32 (bit-or (unsigned-bit-shift-right lo n) (bit-shift-left hi (- 32 n))))]
    :else [0 (u32 (unsigned-bit-shift-right hi (- n 32)))])))
