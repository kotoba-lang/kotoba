;; Clojure-shaped twin of subpath_dispatch.kotoba (:clj-kotoba / .cljk).
;;
;; Compile:
;;   kotoba compile kotoba/hash/subpath_dispatch.cljk --target wasm -o subpath_dispatch.wasm

(ns hash.subpath-dispatch
  (:export [target-unknown target-org-nist-sha2 target-org-ietf-blake2
            target-crypto target-hash target-org-ietf-argon2
            dispatch-subpath]))

(defn target-unknown [] :i64 0)
(defn target-org-nist-sha2 [] :i64 1)
(defn target-org-ietf-blake2 [] :i64 2)
(defn target-crypto [] :i64 3)
(defn target-hash [] :i64 4)
(defn target-org-ietf-argon2 [] :i64 5)

(defn- starts-with? [s :string prefix :string] :bool
  (if (< (string-length s) (string-length prefix)) false
      (string=? (string-substring s 0 (string-length prefix)) prefix)))

(defn- is-sha2-family [sub :string] :bool
  (if (string=? sub "sha2") true
      (if (string=? sub "sha256") true
          (if (string=? sub "sha224") true
              (if (string=? sub "sha384") true
                  (if (string=? sub "sha512") true
                      (if (starts-with? sub "sha2") true false)))))))

(defn dispatch-subpath [sub :string] :i64
  (if (is-sha2-family sub) (target-org-nist-sha2)
      (if (string=? sub "hmac") (target-org-nist-sha2)
          (if (string=? sub "blake2") (target-org-ietf-blake2)
              (if (string=? sub "blake2s") (target-org-ietf-blake2)
                  (if (string=? sub "blake2b") (target-org-ietf-blake2)
                      (if (starts-with? sub "blake2") (target-org-ietf-blake2)
                          (if (string=? sub "hkdf") (target-crypto)
                              (if (string=? sub "pbkdf2") (target-crypto)
                                  (if (string=? sub "sha1") (target-hash)
                                      (if (string=? sub "legacy") (target-hash)
                                          (if (string=? sub "argon2") (target-org-ietf-argon2)
                                              (target-unknown)))))))))))))
