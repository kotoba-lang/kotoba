;; sha2.native-gate -- the corpus of test/sha2/sha2_test.cljk and
;; test/sha2/sha2_oracle_test.cljk, run by a loaderless static image built
;; from kotoba/sha2/core.kotoba (README "Native gate" composes the two bodies).
;;
;; main returns a bitmask of the portable suite's checks, done in the image:
;;   1 SHA-256 NIST vectors     2 SHA-224 NIST vectors and size
;;   4 HMAC RFC 4231 / fox      8 HMAC key handling (long, short, empty, 64)
;;  16 hex and u32             32 padding boundaries and the length sweep
;; 63 is a pass. It also prints one line per oracle case
;;   sha256 <case> <hex> / sha224 <case> <hex> / hmac <key> <case> <hex>
;; for the README's hashlib/hmac comparison, the same shapes, lengths and
;; keys as the oracle suite.
(ns sha2.native-gate
  (:export [main]))

;; ---------------------------------------------------------------------------
;; Inputs

(defn- g-fill [n :i64 x :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i x)))))

(defn- g-ascii [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))

(defn- g-cat [a :vector-i64 b :vector-i64] :vector-i64
  (loop [i 0 out (vector-alloc (+ (vector-count a) (vector-count b)))]
    (if (= i (vector-count out)) out
      (recur (+ i 1) (vector-assoc! out i (if (< i (vector-count a)) (vector-at a i) (vector-at b (- i (vector-count a)))))))))

(defn- g-head [v :vector-i64 n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v i))))))

(defn- g-all-bytes [] :vector-i64
  (loop [i 0 out (vector-alloc 256)] (if (= i 256) out (recur (+ i 1) (vector-assoc! out i i)))))

(defn- g-text [] :vector-i64
  (let [unit (g-ascii "the quick brown fox. ")]
    (loop [i 0 out (vector-alloc (* 40 (vector-count unit)))]
      (if (= i (vector-count out)) out
        (recur (+ i 1) (vector-assoc! out i (vector-at unit (rem i (vector-count unit)))))))))

(defn- g-pseudo [] :vector-i64
  (loop [i 0 out (vector-alloc 5000)]
    (if (= i 5000) out (recur (+ i 1) (vector-assoc! out i (rem (* 1103515245 (+ i 1)) 256))))))

;; data[i] = 31 (n + i) mod 256, the oracle's length sweep
(defn- g-sweep [n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (rem (* 31 (+ n i)) 256))))))

;; the oracle's shapes: 0..7 named, 8..18 length-n with n bytes of n
(defn- g-lengths [] :vector-i64 [54 55 56 57 63 64 65 118 119 120 121])

(defn- g-shape-name [i :i64] :string
  (case i 0 "empty" 1 "one" 2 "abc" 3 "all-bytes" 4 "high-bytes" 5 "text" 6 "pseudo-random" 7 "one-megabyte"
          (string-concat "length-" (string-from-i64 (vector-at (g-lengths) (- i 8))))))

(defn- g-shape [i :i64] :vector-i64
  (case i 0 (vector-alloc 0) 1 (g-fill 1 0) 2 (g-ascii "abc") 3 (g-all-bytes) 4 (g-fill 300 255)
          5 (g-text) 6 (g-pseudo) 7 (g-fill 1000000 97)
          (let [n (vector-at (g-lengths) (- i 8))] (g-fill n n))))

(defn- g-key-name [i :i64] :string
  (case i 0 "k" 1 "Jefe" 2 "0b-x64" 3 "aa-x100" "55-x200"))

(defn- g-key [i :i64] :vector-i64
  (case i 0 (g-ascii "k") 1 (g-ascii "Jefe") 2 (g-fill 64 11) 3 (g-fill 100 170) (g-fill 200 85)))

;; ---------------------------------------------------------------------------
;; The portable suite

(defn- g-sha256-vectors [] :bool
  (and (= (sha256-hex (vector-alloc 0)) "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
       (= (sha256-hex (g-ascii "abc")) "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
       (= (sha256-hex (g-ascii "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))
          "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
       (= (vector-count (sha256 (g-fill 10000 97))) 32)))

(defn- g-sha224-vectors [] :bool
  (and (= (sha224-hex (vector-alloc 0)) "d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f")
       (= (sha224-hex (g-ascii "abc")) "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7")
       (= (vector-count (sha224 (g-ascii "abc"))) 28)))

(defn- g-hmac-vectors [] :bool
  (and (= (hmac-sha256-hex (g-ascii "Jefe") (g-ascii "what do ya want for nothing?"))
          "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
       (= (hmac-sha256-hex (g-ascii "key") (g-ascii "The quick brown fox jumps over the lazy dog"))
          "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8")))

(defn- g-hmac-keys [] :bool
  (let [long-key (g-fill 100 170) msg (g-ascii "msg")]
    (and (= (hmac-sha256-hex long-key msg) (hmac-sha256-hex (sha256 long-key) msg))
         (not (= (hmac-sha256-hex long-key msg) (hmac-sha256-hex (g-head long-key 64) msg)))
         (= (hmac-sha256-hex (g-ascii "k") msg) (hmac-sha256-hex (g-cat (g-ascii "k") (g-fill 30 0)) msg))
         (= (vector-count (hmac-sha256 (vector-alloc 0) msg)) 32)
         (= (hmac-sha256-hex (vector-alloc 0) msg) "5f576a8d68fe4fb7eb823227246353c0870c3b0e878997341db1226b4bd88d61")
         (= (hmac-sha256-hex (vector-alloc 0) (vector-alloc 0)) "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad")
         (= (vector-count (hmac-sha256 (g-fill 64 11) msg)) 32))))

(defn- g-hex [] :bool
  (and (= (hex [0]) "00") (= (hex [15 16 255]) "0f10ff")
       (= (string-length (sha256-hex (g-ascii "x"))) 64)
       (= (string-length (sha224-hex (g-ascii "x"))) 56)
       (= (u32 -1) 4294967295) (= (u32 5) 5) (= (u32 0) 0)))

(defn- g-bytes-ok? [d :vector-i64] :bool
  (and (= (vector-count d) 32)
       (loop [i 0] (if (= i 32) true (if (and (>= (vector-at d i) 0) (<= (vector-at d i) 255)) (recur (+ i 1)) false)))))

(defn- g-distinct6? [v :vector-i64] :bool
  (loop [i 0 ok true]
    (if (= i 6) ok
      (recur (+ i 1) (and ok (loop [j (+ i 1) d true]
                               (if (= j 6) d
                                 (recur (+ j 1) (and d (not (= (sha256-hex (g-fill (vector-at v i) 65))
                                                               (sha256-hex (g-fill (vector-at v j) 65)))))))))))))

(defn- g-shared [a :vector-i64 b :vector-i64] :i64
  (loop [i 0 n 0] (if (= i 32) n (recur (+ i 1) (if (= (vector-at a i) (vector-at b i)) (+ n 1) n)))))

(defn- g-padding [] :bool
  (and (loop [n 0] (if (= n 200) true (if (g-bytes-ok? (sha256 (g-fill n (rem (* 7 n) 256)))) (recur (+ n 1)) false)))
       (g-distinct6? [55 56 63 64 119 120])
       (< (g-shared (sha256 (g-ascii "message")) (sha256 (g-ascii "messagf"))) 8)))

;; ---------------------------------------------------------------------------
;; The oracle lines

(defn- g-say [s :string] :i64
  (let [x (typed-cap-call :io/write :string :string (string-concat s "\n"))] 0))

(defn- g-print-shapes [] :i64
  (loop [i 0 n 0]
    (if (= i 19) n
      (let [d (g-shape i) name (g-shape-name i)
            a (g-say (string-concat (string-concat "sha256 " name) (string-concat " " (sha256-hex d))))
            b (g-say (string-concat (string-concat "sha224 " name) (string-concat " " (sha224-hex d))))]
        (recur (+ i 1) (+ n 2))))))

(defn- g-print-sweeps [] :i64
  (loop [n 0 c 0]
    (if (= n 200) c
      (let [a (g-say (string-concat (string-concat "sha256 sweep-" (string-from-i64 n)) (string-concat " " (sha256-hex (g-sweep n)))))
            b (g-say (string-concat (string-concat "sha256 pad-" (string-from-i64 n))
                                    (string-concat " " (sha256-hex (g-fill n (rem (* 7 n) 256))))))]
        (recur (+ n 1) (+ c 2))))))

(defn- g-print-hmacs [] :i64
  (loop [k 0 c 0]
    (if (= k 5) c
      (recur (+ k 1)
             (loop [i 0 c2 c]
               (if (= i 19) c2
                 (if (= i 7) (recur (+ i 1) c2)
                   (let [line (string-concat (string-concat (string-concat "hmac " (g-key-name k)) (string-concat " " (g-shape-name i)))
                                             (string-concat " " (hmac-sha256-hex (g-key k) (g-shape i))))
                         x (g-say line)]
                     (recur (+ i 1) (+ c2 1))))))))))

(defn main [] :i64
  (let [lines (+ (g-print-shapes) (+ (g-print-sweeps) (g-print-hmacs)))
        x (g-say (string-concat "lines " (string-from-i64 lines)))]
    (+ (if (g-sha256-vectors) 1 0)
       (+ (if (g-sha224-vectors) 2 0)
          (+ (if (g-hmac-vectors) 4 0)
             (+ (if (g-hmac-keys) 8 0)
                (+ (if (g-hex) 16 0) (if (g-padding) 32 0))))))))
