(ns sha512
  (:export [main]))

;; SHA-512 (FIPS 180-4) in the Kotoba guest subset.
;;
;; Every word is an i64. SHA-512 is defined over unsigned 64-bit words, and
;; the two agree bit for bit for the operations it uses: addition wraps mod
;; 2^64 either way (measured -- (+ 9223372036854775807 1) evaluates to
;; -9223372036854775808 on this backend), and xor/and/not are bitwise. Only
;; the right shift differs, so `u64-shift-right` is used wherever the spec
;; says SHR or ROTR and `i64-shift-right` appears nowhere in this file.
;;
;; Constants are the spec's unsigned values written as their signed i64
;; bit patterns, because a literal above 2^63-1 is not an i64.

(defn k-table [] :vector-i64
  (let [k0 (vector-alloc 80)
        k1 (vector-assoc k0 0 4794697086780616226)
        k2 (vector-assoc k1 1 8158064640168781261)
        k3 (vector-assoc k2 2 -5349999486874862801)
        k4 (vector-assoc k3 3 -1606136188198331460)
        k5 (vector-assoc k4 4 4131703408338449720)
        k6 (vector-assoc k5 5 6480981068601479193)
        k7 (vector-assoc k6 6 -7908458776815382629)
        k8 (vector-assoc k7 7 -6116909921290321640)
        k9 (vector-assoc k8 8 -2880145864133508542)
        k10 (vector-assoc k9 9 1334009975649890238)
        k11 (vector-assoc k10 10 2608012711638119052)
        k12 (vector-assoc k11 11 6128411473006802146)
        k13 (vector-assoc k12 12 8268148722764581231)
        k14 (vector-assoc k13 13 -9160688886553864527)
        k15 (vector-assoc k14 14 -7215885187991268811)
        k16 (vector-assoc k15 15 -4495734319001033068)
        k17 (vector-assoc k16 16 -1973867731355612462)
        k18 (vector-assoc k17 17 -1171420211273849373)
        k19 (vector-assoc k18 18 1135362057144423861)
        k20 (vector-assoc k19 19 2597628984639134821)
        k21 (vector-assoc k20 20 3308224258029322869)
        k22 (vector-assoc k21 21 5365058923640841347)
        k23 (vector-assoc k22 22 6679025012923562964)
        k24 (vector-assoc k23 23 8573033837759648693)
        k25 (vector-assoc k24 24 -7476448914759557205)
        k26 (vector-assoc k25 25 -6327057829258317296)
        k27 (vector-assoc k26 26 -5763719355590565569)
        k28 (vector-assoc k27 27 -4658551843659510044)
        k29 (vector-assoc k28 28 -4116276920077217854)
        k30 (vector-assoc k29 29 -3051310485924567259)
        k31 (vector-assoc k30 30 489312712824947311)
        k32 (vector-assoc k31 31 1452737877330783856)
        k33 (vector-assoc k32 32 2861767655752347644)
        k34 (vector-assoc k33 33 3322285676063803686)
        k35 (vector-assoc k34 34 5560940570517711597)
        k36 (vector-assoc k35 35 5996557281743188959)
        k37 (vector-assoc k36 36 7280758554555802590)
        k38 (vector-assoc k37 37 8532644243296465576)
        k39 (vector-assoc k38 38 -9096487096722542874)
        k40 (vector-assoc k39 39 -7894198246740708037)
        k41 (vector-assoc k40 40 -6719396339535248540)
        k42 (vector-assoc k41 41 -6333637450476146687)
        k43 (vector-assoc k42 42 -4446306890439682159)
        k44 (vector-assoc k43 43 -4076793802049405392)
        k45 (vector-assoc k44 44 -3345356375505022440)
        k46 (vector-assoc k45 45 -2983346525034927856)
        k47 (vector-assoc k46 46 -860691631967231958)
        k48 (vector-assoc k47 47 1182934255886127544)
        k49 (vector-assoc k48 48 1847814050463011016)
        k50 (vector-assoc k49 49 2177327727835720531)
        k51 (vector-assoc k50 50 2830643537854262169)
        k52 (vector-assoc k51 51 3796741975233480872)
        k53 (vector-assoc k52 52 4115178125766777443)
        k54 (vector-assoc k53 53 5681478168544905931)
        k55 (vector-assoc k54 54 6601373596472566643)
        k56 (vector-assoc k55 55 7507060721942968483)
        k57 (vector-assoc k56 56 8399075790359081724)
        k58 (vector-assoc k57 57 8693463985226723168)
        k59 (vector-assoc k58 58 -8878714635349349518)
        k60 (vector-assoc k59 59 -8302665154208450068)
        k61 (vector-assoc k60 60 -8016688836872298968)
        k62 (vector-assoc k61 61 -6606660893046293015)
        k63 (vector-assoc k62 62 -4685533653050689259)
        k64 (vector-assoc k63 63 -4147400797238176981)
        k65 (vector-assoc k64 64 -3880063495543823972)
        k66 (vector-assoc k65 65 -3348786107499101689)
        k67 (vector-assoc k66 66 -1523767162380948706)
        k68 (vector-assoc k67 67 -757361751448694408)
        k69 (vector-assoc k68 68 500013540394364858)
        k70 (vector-assoc k69 69 748580250866718886)
        k71 (vector-assoc k70 70 1242879168328830382)
        k72 (vector-assoc k71 71 1977374033974150939)
        k73 (vector-assoc k72 72 2944078676154940804)
        k74 (vector-assoc k73 73 3659926193048069267)
        k75 (vector-assoc k74 74 4368137639120453308)
        k76 (vector-assoc k75 75 4836135668995329356)
        k77 (vector-assoc k76 76 5532061633213252278)
        k78 (vector-assoc k77 77 6448918945643986474)
        k79 (vector-assoc k78 78 6902733635092675308)
        k80 (vector-assoc k79 79 7801388544844847127)
        ]
    k80))

(defn h-table [] :vector-i64
  (let [h0 (vector-alloc 8)
        h1 (vector-assoc h0 0 7640891576956012808)
        h2 (vector-assoc h1 1 -4942790177534073029)
        h3 (vector-assoc h2 2 4354685564936845355)
        h4 (vector-assoc h3 3 -6534734903238641935)
        h5 (vector-assoc h4 4 5840696475078001361)
        h6 (vector-assoc h5 5 -7276294671716946913)
        h7 (vector-assoc h6 6 2270897969802886507)
        h8 (vector-assoc h7 7 6620516959819538809)
        ]
    h8))

;; The shift count must be an integer literal in [0,63] -- a guest rule, and a
;; good one: a rotation whose distance is a runtime value is how constant-time
;; code stops being constant-time. So the rotations are written out rather
;; than parameterised, which is also how FIPS 180-4 states them.

(defn big-s0 [x :i64] :i64
  (bit-xor (bit-or (u64-shift-right x 28) (i64-shift-left x 36))
           (bit-xor (bit-or (u64-shift-right x 34) (i64-shift-left x 30))
                    (bit-or (u64-shift-right x 39) (i64-shift-left x 25)))))

(defn big-s1 [x :i64] :i64
  (bit-xor (bit-or (u64-shift-right x 14) (i64-shift-left x 50))
           (bit-xor (bit-or (u64-shift-right x 18) (i64-shift-left x 46))
                    (bit-or (u64-shift-right x 41) (i64-shift-left x 23)))))

(defn small-s0 [x :i64] :i64
  (bit-xor (bit-or (u64-shift-right x 1) (i64-shift-left x 63))
           (bit-xor (bit-or (u64-shift-right x 8) (i64-shift-left x 56))
                    (u64-shift-right x 7))))

(defn small-s1 [x :i64] :i64
  (bit-xor (bit-or (u64-shift-right x 19) (i64-shift-left x 45))
           (bit-xor (bit-or (u64-shift-right x 61) (i64-shift-left x 3))
                    (u64-shift-right x 6))))

(defn ch [x :i64 y :i64 z :i64] :i64
  (bit-xor (bit-and x y) (bit-and (bit-not x) z)))

(defn maj [x :i64 y :i64 z :i64] :i64
  (bit-xor (bit-and x y) (bit-xor (bit-and x z) (bit-and y z))))

;; ---------------------------------------------------------------- schedule
;;
;; W[0..15] are the block; W[16..79] are derived. Self-recursive rather than
;; `loop`, because a loop desugars to a helper whose parameters are its
;; bindings and the guest admits at most five.

(defn extend-w [w :vector-i64 t :i64] :vector-i64
  (if (> t 79)
    w
    (let [a (vector-at w (- t 2))
          b (vector-at w (- t 7))
          c (vector-at w (- t 15))
          d (vector-at w (- t 16))]
      (extend-w (vector-assoc w t (+ (small-s1 a) (+ b (+ (small-s0 c) d))))
                (+ t 1)))))

;; ------------------------------------------------------------- compression

(defn compress [st :vector-i64 w :vector-i64 kt :vector-i64 t :i64] :vector-i64
  (if (> t 79)
    st
    (let [a (vector-at st 0)
          b (vector-at st 1)
          c (vector-at st 2)
          d (vector-at st 3)
          e (vector-at st 4)
          f (vector-at st 5)
          g (vector-at st 6)
          h (vector-at st 7)
          t1 (+ h (+ (big-s1 e) (+ (ch e f g) (+ (vector-at kt t) (vector-at w t)))))
          t2 (+ (big-s0 a) (maj a b c))
          s7 (vector-assoc st 7 g)
          s6 (vector-assoc s7 6 f)
          s5 (vector-assoc s6 5 e)
          s4 (vector-assoc s5 4 (+ d t1))
          s3 (vector-assoc s4 3 c)
          s2 (vector-assoc s3 2 b)
          s1 (vector-assoc s2 1 a)
          s0 (vector-assoc s1 0 (+ t1 t2))]
      (compress s0 w kt (+ t 1)))))

(defn add-state [out :vector-i64 st :vector-i64 t :i64] :vector-i64
  (if (> t 7)
    out
    (add-state (vector-assoc out t (+ (vector-at out t) (vector-at st t)))
               st (+ t 1))))

(defn copy-state [dst :vector-i64 src :vector-i64 t :i64] :vector-i64
  (if (> t 7)
    dst
    (copy-state (vector-assoc dst t (vector-at src t)) src (+ t 1))))

;; One 128-byte block, already padded, given as W[0..15] in BLOCK.
(defn hash-block [block :vector-i64] :vector-i64
  (let [h (h-table)
        w (extend-w (copy-16 (vector-alloc 80) block 0) 16)
        st (copy-state (vector-alloc 8) h 0)
        done (compress st w (k-table) 0)]
    (add-state h done 0)))

(defn copy-16 [dst :vector-i64 src :vector-i64 t :i64] :vector-i64
  (if (> t 15)
    dst
    (copy-16 (vector-assoc dst t (vector-at src t)) src (+ t 1))))

;; ------------------------------------------------------------- self-check
;;
;; Returns the NUMBER of mismatched 64-bit words across the two FIPS 180-4
;; vectors, so 0 is a pass and any other number says how much is wrong. A
;; boolean could not tell one wrong word from a hash that returns garbage.

(defn zero-block [b :vector-i64 t :i64] :vector-i64
  (if (> t 15) b (zero-block (vector-assoc b t 0) (+ t 1))))

(defn mismatches [got :vector-i64 want :vector-i64 t :i64 acc :i64] :i64
  (if (> t 7)
    acc
    (mismatches got want (+ t 1)
                (if (= (vector-at got t) (vector-at want t)) acc (+ acc 1)))))

(defn abc-block [] :vector-i64
  (let [ab0 (vector-alloc 16)
        ab1 (vector-assoc ab0 0 7017280570803617792)
        ab2 (vector-assoc ab1 1 0)
        ab3 (vector-assoc ab2 2 0)
        ab4 (vector-assoc ab3 3 0)
        ab5 (vector-assoc ab4 4 0)
        ab6 (vector-assoc ab5 5 0)
        ab7 (vector-assoc ab6 6 0)
        ab8 (vector-assoc ab7 7 0)
        ab9 (vector-assoc ab8 8 0)
        ab10 (vector-assoc ab9 9 0)
        ab11 (vector-assoc ab10 10 0)
        ab12 (vector-assoc ab11 11 0)
        ab13 (vector-assoc ab12 12 0)
        ab14 (vector-assoc ab13 13 0)
        ab15 (vector-assoc ab14 14 0)
        ab16 (vector-assoc ab15 15 24)
        ]
    ab16))

(defn empty-block [] :vector-i64
  (let [eb0 (vector-alloc 16)
        eb1 (vector-assoc eb0 0 -9223372036854775808)
        eb2 (vector-assoc eb1 1 0)
        eb3 (vector-assoc eb2 2 0)
        eb4 (vector-assoc eb3 3 0)
        eb5 (vector-assoc eb4 4 0)
        eb6 (vector-assoc eb5 5 0)
        eb7 (vector-assoc eb6 6 0)
        eb8 (vector-assoc eb7 7 0)
        eb9 (vector-assoc eb8 8 0)
        eb10 (vector-assoc eb9 9 0)
        eb11 (vector-assoc eb10 10 0)
        eb12 (vector-assoc eb11 11 0)
        eb13 (vector-assoc eb12 12 0)
        eb14 (vector-assoc eb13 13 0)
        eb15 (vector-assoc eb14 14 0)
        eb16 (vector-assoc eb15 15 0)
        ]
    eb16))

(defn abc-want [] :vector-i64
  (let [aw0 (vector-alloc 8)
        aw1 (vector-assoc aw0 0 -2472698702324467014)
        aw2 (vector-assoc aw1 1 -3728572256194903759)
        aw3 (vector-assoc aw2 2 1362051152550133410)
        aw4 (vector-assoc aw3 3 765311659573367706)
        aw5 (vector-assoc aw4 4 2419164356178592168)
        aw6 (vector-assoc aw5 5 3943530547489205181)
        aw7 (vector-assoc aw6 6 4993722480620005390)
        aw8 (vector-assoc aw7 7 3069987439919277215)
        ]
    aw8))

(defn empty-want [] :vector-i64
  (let [ew0 (vector-alloc 8)
        ew1 (vector-assoc ew0 0 -3493701266030217027)
        ew2 (vector-assoc ew1 1 -1057175684865228793)
        ew3 (vector-assoc ew2 2 -3017161040022006308)
        ew4 (vector-assoc ew3 3 -8938333397677446706)
        ew5 (vector-assoc ew4 4 5174866029046002352)
        ew6 (vector-assoc ew5 5 -35157079593391057)
        ew7 (vector-assoc ew6 6 7185829369460390529)
        ew8 (vector-assoc ew7 7 -6541422955008107970)
        ]
    ew8))

(defn main [] :i64
  (+ (mismatches (hash-block (abc-block)) (abc-want) 0 0)
     (mismatches (hash-block (empty-block)) (empty-want) 0 0)))
