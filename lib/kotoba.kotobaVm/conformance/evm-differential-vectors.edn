;; conformance/evm-differential-vectors.edn
;;
;; Differential vectors for the kototama :evm/v1 profile. Each :expect is a
;; value an independent Ethereum implementation produces for the same bytecode
;; -- a constant from the Yellow Paper, a canonical hash, or a semantics the
;; spec fixes -- NOT a value read back out of kotoba-vm.
;;
;; This is the START of the suite kototama's spec names
;; (:profile-suites {:evm/v1 [:ethereum-general-state-tests :differential-execution]}),
;; not the suite. Passing every vector here does NOT earn the :bytecode level;
;; kototama sets :floating-evm-claim-forbidden true and
;; :differential-tests-required [:semantic :bytecode :state], and
;; ethereum/tests has not been run against this implementation at all.
;;
;; What it IS for: a deterministic judge, so the EVM axis has the same kind of
;; fitness function the codegen axis has in perfgate -- a number that moves.

{:schema :kotoba.vm.evm/differential-vectors-v1
 :hardfork :paris
 :vectors
 [{:id :arith/mul
   :hex "6006600702"
   :expect {:status :stopped :stack [42]}
   :source "PUSH1 6, PUSH1 7, MUL -- Yellow Paper 0x02"}

  {:id :arith/add
   :hex "6003600201"
   :expect {:status :stopped :stack [5]}
   :source "PUSH1 3, PUSH1 2, ADD -- Yellow Paper 0x01"}

  {:id :arith/sub-underflow-wraps
   :hex "6003600503"
   :expect {:status :stopped :stack [2]}
   :source "SUB is 2^256-modular; 5-3=2 -- Yellow Paper 0x03"}

  {:id :arith/div-by-zero-is-zero
   :hex "6000600504"
   :expect {:status :stopped :stack [0]}
   :source "EVM DIV by zero yields 0, it does not trap -- Yellow Paper 0x04"}

  {:id :hash/keccak256-empty
   :hex "6000600020"
   :expect {:status :stopped
            :stack [89477152217924674838424037953991966239322087453347756267410168184682657981552]}
   :source "keccak256(\"\") = 0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470 -- the canonical empty-input Keccak digest, identical in every Ethereum client"}

  {:id :control/stop
   :hex "00"
   :expect {:status :stopped :stack []}
   :source "STOP halts normally -- Yellow Paper 0x00"}

  {:id :control/revert
   :hex "60006000fd"
   :expect {:status :reverted :stack []}
   :source "REVERT(0,0) -- EIP-140"}

  {:id :control/return
   :hex "600660070260005260206000f3"
   :expect {:status :halted :stack []}
   :source "MUL, MSTORE, RETURN(0,32) -- Yellow Paper 0xf3"}

  ;; --- control flow -------------------------------------------------------
  ;; The nine vectors this file shipped with all passed while JUMP and JUMPI
  ;; were transferring control nowhere, because not one of them contained a
  ;; jump. Every vector below is written so that TAKING the branch and FALLING
  ;; THROUGH land on different opcodes -- a vector whose two outcomes agree
  ;; cannot detect which one happened.

  {:id :control/jump-transfers-control
   :hex "6004560c5b00"
   :expect {:status :stopped}
   :source "PUSH1 4; JUMP; INVALID; JUMPDEST; STOP -- Yellow Paper 0x56. Taken lands on the JUMPDEST at 4 and stops; falling through lands on the undefined 0x0c at 3. :stopped proves the jump was taken."}

  {:id :control/jumpi-taken-when-condition-nonzero
   :hex "60016006570c5b00"
   :expect {:status :stopped}
   :source "PUSH1 1; PUSH1 6; JUMPI; INVALID; JUMPDEST; STOP -- Yellow Paper 0x57 pops counter (destination) FIRST, condition second, so the destination is the top of the stack. Taken reaches the JUMPDEST at 6; falling through hits 0x0c at 5."}

  {:id :control/jumpi-falls-through-when-condition-zero
   :hex "6000600657005b0c"
   :expect {:status :stopped}
   :source "PUSH1 0; PUSH1 6; JUMPI; STOP; JUMPDEST; INVALID -- same shape, condition zero. Correct fall-through reaches the STOP at 5; a wrongly-taken branch reaches the undefined 0x0c at 7. This is the direction that catches swapped operands, which the taken case alone cannot."}

  {:id :control/jump-backwards-loops-until-gas-is-gone
   :hex "5b600056"
   :expect {:status :invalid :gas 0}
   :source "JUMPDEST; PUSH1 0; JUMP -- an unbounded backward loop. A working JUMP consumes the whole allowance and halts exceptionally; a JUMP that silently falls through runs off the end of the code and reports the ordinary :stopped of an implicit STOP. The two are trivial to tell apart and were indistinguishable to this suite before."}

  {:id :control/jump-to-a-non-jumpdest-is-rejected
   :hex "6003560000"
   :expect {:status :invalid}
   :source "PUSH1 3; JUMP; STOP; STOP -- offset 3 holds 0x00, not JUMPDEST. Yellow Paper 9.4.2: an invalid jump destination is exceptional halting. Kept as the negative control for the four above, so a change that made every jump succeed would not pass."}

  {:id :control/invalid-opcode-consumes-all-gas
   :hex "0c"
   :expect {:status :invalid :gas 0}
   :source "An undefined opcode is exceptional halting and consumes the whole gas allowance -- Yellow Paper 9.4.2. This vector is the one most likely to catch a lenient interpreter: returning :stopped, or leaving gas unspent, are both wrong."}]}
