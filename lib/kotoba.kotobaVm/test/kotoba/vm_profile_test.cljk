(ns kotoba.vm-profile-test
  (:require [clojure.edn :as edn]
            [kotoba.io :as io]
            [kotoba.test :refer [deftest is testing]]))

(def profile
  (-> "kototama-profile.edn" io/file slurp edn/read-string))

(deftest declaration-targets-versioned-kototama
  (is (= :kototama.vm/implementation-profile-v1 (:schema profile)))
  (is (= {:schema :kototama.vm/spec-v1
          :version 1
          :repository "https://github.com/kotoba-lang/kototama"}
         (:spec profile)))
  (is (= :kotoba-vm (get-in profile [:implementation :name]))))

(deftest current-evidence-is-described-without-false-compatibility-claims
  (is (= :partial (get-in profile [:profiles :core/v1 :status])))
  (is (seq (get-in profile [:profiles :core/v1 :omissions])))
  (is (= :shape-only
         (get-in profile [:profiles :fvm-actor/v1 :status])))
  (is (empty? (get-in profile [:profiles :fvm-actor/v1 :levels])))
  (is (= :partial
         (get-in profile [:profiles :evm/v1 :status])))
  (is (seq (get-in profile [:profiles :evm/v1 :implemented])))
  (is (seq (get-in profile [:profiles :evm/v1 :evidence])))
  (is (= :partial
         (get-in profile [:profiles :fevm/v1 :status])))
  (is (seq (get-in profile [:profiles :fevm/v1 :implemented])))
  (is (seq (get-in profile [:profiles :fevm/v1 :evidence])))
  (is (= #{:filecoin-network-compatibility
           :evm-compatibility
           :fevm-compatibility
           :consensus}
         (set (:non-claims profile)))))

(deftest bounded-datalog-partial-implementation-has-direct-evidence
  (let [core (get-in profile [:profiles :core/v1])]
    (is (= :partial (:status core)))
    (is (every? (set (:implemented core))
                [:bounded-positive-function-free-datalog
                 :range-restricted-rules
                 :source-slot-derived-fact-provenance
                 :five-origin-eligibility-join
                 :datalog-round-fact-and-join-budgets
                 :invoke-time-five-origin-authorization-gate
                 :authority-decisions-in-local-message-result]))
    (is (some #(= "lib/kotoba.kotobaVm/test/kotoba/vm/kototama_datalog_test.cljk" %) (:evidence core)))
    (is (seq (:omissions core)))
    (is (some #{:source-authenticated-authority-fact-adapters}
              (:omissions core)))))

(deftest bounded-datalog-evidence-file-contains-tests
  (let [path "lib/kotoba.kotobaVm/test/kotoba/vm/kototama_datalog_test.cljk"]
    (is (io/exists? (io/file path)))
    (is (re-find #"deftest" (slurp path)))))

(deftest every-incomplete-profile-names-its-omissions
  (doseq [[profile-name declaration] (:profiles profile)]
    (testing (name profile-name)
      (is (seq (:omissions declaration))))))
