;; Actual live-certified prefix input, real Cell authority and raw Ethereum
;; transaction. The host supplies fixture bytes; replay and durable admission
;; run in this native closure. Input is nine LF-delimited ASCII fields.
(ns kotoba.vm.evm.native-live-domain-driver
 (:require [kotoba.vm.evm.native-store :as s] [kotoba.vm.evm.native-store-io :as io]
           [kotoba.vm.evm.native-bytes :as b] [inga.native-prefix :as n])
 (:export [main]))
(defn main [] :i64
 (let [input (typed-cap-call :cli/args :string :string "0")
       base (typed-cap-call :cli/args :string :string "1")
       mode (typed-cap-call :cli/args :string :string "2")]
  (if (or (= input "") (= base "")) -1
   (let [rows (io/read input) ctx (b/field rows 10 0) validators (b/field rows 10 1)
         prefix (b/hex-text (b/field rows 10 3)) qc (b/hex-text (b/field rows 10 4))
         catalog (b/hex-text (b/field rows 10 5)) checkpoint (b/field rows 10 6)
         expected (b/field rows 10 7)
         result (if (= mode "recover") (s/recover base ctx validators (n/number (b/field rows 10 2)))
                  (s/publish base ctx validators (n/number (b/field rows 10 2)) prefix qc catalog checkpoint))
         written (io/write (string-concat base "/domain-result") result)]
    (if (and written (= result expected)) 1 0)))))
