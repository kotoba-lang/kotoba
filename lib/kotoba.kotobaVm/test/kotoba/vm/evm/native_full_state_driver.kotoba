;; Data-only fixture adapter. Each row is id~world~raw-tx~block~root~logs~exception.
;; No host EVM participates in the native execution or expected-hash comparison.
(ns kotoba.vm.evm.native-full-state-driver
 (:require [kotoba.vm.evm.native-transition :as t]
           [kotoba.vm.evm.native-bytes :as b]
           [kotoba.vm.evm.native-logs :as l]
           [kotoba.vm.evm.native-store-io :as io])
 (:export [main]))
(defn- run-row [row :string output :string] :i64
 (arena-scope
  (let [tx (t/apply-transaction (b/field row 126 1) (b/from-hex (b/field row 126 2)) (b/field row 126 3))
        status (record-get [:ref :evm.native/transition] tx :status)
        root (b/to-hex (record-get [:ref :evm.native/transition] tx :state-root))
        logs (b/to-hex (l/digest (record-get [:ref :evm.native/transition] tx :logs)))
        exception (not (= (b/field row 126 6) ""))
        pass (if exception (= status 11)
              (and (or (= status 1) (= status 2) (and (>= status 3) (<= status 7)) (= status 9))
                   (= root (b/field row 126 4)) (= logs (b/field row 126 5))))
        result (string-concat (b/field row 126 0)
                 (string-concat "~" (string-concat (str status)
                  (string-concat "~" (string-concat root
                   (string-concat "~" (string-concat logs
                    (string-concat "~" (string-concat (str (record-get [:ref :evm.native/transition] tx :gas-used))
                     (string-concat "~" (if pass "pass"
                       (string-concat (if (or (= status 8) (= status 10) (= status 11)) ""
                                        (record-get [:ref :evm.native/transition] tx :world)) "~fail"))))))))))))]
   (if (io/write output result) (if pass 1 0) -1))))
(defn main [] :i64
 (let [input (typed-cap-call :cli/args :string :string "0")
       output (typed-cap-call :cli/args :string :string "1")
       rows (if (or (= input "") (= output "")) "" (io/read input))]
  (if (= rows "") -2
   (loop [i 0 passed 0]
    (if (= i (b/fields rows 10)) passed
     (let [row (b/field rows 10 i)
           result (run-row row (string-concat output (string-concat "/" (b/field row 126 0))))]
      (if (< result 0) -3 (recur (+ i 1) (+ passed result)))))))))
