(ns kotoba.vm.evm.native-state-resource-driver
 (:require [kotoba.vm.evm.native-state :as s]
           [kotoba.vm.evm.native-trie :as t]
           [kotoba.vm.evm.native-bytes :as b]
           [kotoba.vm.evm.native-store-io :as io])
 (:export [main]))
(defn- check-row [row :string output :string] :i64
 (arena-scope
  (let [world (b/field row 126 1) expected (= (b/field row 126 2) "1")
        valid (s/valid-world? world) limits (s/within-limits? world)
        pass (and (= valid expected) (= limits expected)
               (or (not expected)
                 (and (= (b/to-hex (t/state-root world)) (b/field row 126 3))
                      (= (b/to-hex (t/storage-root (s/storage-text world "0000000000000000000000000000000000000100")))
                         (b/field row 126 4)))))]
   (if (io/write output (if pass "pass" "fail")) (if pass 1 0) -1))))
(defn main [] :i64
 (let [input (typed-cap-call :cli/args :string :string "0")
       output (typed-cap-call :cli/args :string :string "1")
       rows (if (or (= input "") (= output "")) "" (io/read input))]
  (if (= rows "") -2
   (loop [i 0 passed 0]
    (if (= i (b/fields rows 10)) passed
     (let [row (b/field rows 10 i)
           result (if (= row "") 0
                   (check-row row (string-concat output (string-concat "/" (b/field row 126 0)))))]
      (if (< result 0) -3 (recur (+ i 1) (+ passed result)))))))))
