;; Projection only; provenance.json pins original official bytes and omissions.
(ns kotoba.vm.evm.native-official-frame-gate
  (:require [kotoba.vm.evm.native-core :as e]
            [kotoba.vm.evm.native-word :as w])
  (:export [main]))

(defn- hex-nibble [c :i64] :i64
  (if (<= c 57) (- c 48) (- c 87)))

(defn- bytes [s :string] :vector-i64
  (loop [i 0 out (vector-i64)]
    (if (= i (string-length s)) out
      (recur (+ i 2)
        (vector-conj out (+ (* 16 (hex-nibble (string-code-point-at s i)))
                            (hex-nibble (string-code-point-at s (+ i 1)))))))))

(defn- execute [code :string gas :i64 static :bool] [:ref :evm.native/machine]
  (e/run (bytes code) (vector-i64) (vector-i64) (vector-i64) gas static))

(defn main [] :i64
  (let [a (execute "600160010160005500" 379000 false)
        b (execute "600060015500" 100000 false)]
    (+ (if (and (= (e/status a) 1) (= (vector-count (e/storage a)) 32)
                (w/equal-word (e/read-slot (e/storage a) (w/zero-word)) (w/from-long 2))) 1 0)
       (if (and (= (e/status b) 1) (= (vector-count (e/storage b)) 0)) 1 0))))
