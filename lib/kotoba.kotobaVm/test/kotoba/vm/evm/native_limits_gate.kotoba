(ns kotoba.vm.evm.native-limits-gate
  (:require [kotoba.vm.evm.native-core :as e]
            [kotoba.vm.evm.native-word :as w])
  (:export [main]))
(defn main [] :i64
  (let [store (vector-alloc 131072)
        filled (loop [i 0]
                 (if (= i 4096) 0
                   (let [key (vector-assoc! store (* i 32) i)
                         value (vector-assoc! store (+ (* i 32) 16) 1)]
                     (recur (+ i 1)))))
        result (e/run (vector-i64 96 1 97 16 0 85 0) (vector-i64) store (vector-i64) 100000 false)]
    (if (and (= (e/status result) 10) (= (vector-count (e/storage result)) 131072)
             (w/zero? (e/read-slot (e/storage result) (w/from-long 4096)))) 1 0)))
