;; Byte identity across the runtime's 8 MiB byte-object boundary. These are
;; larger ASCII/hex strings carried in independently bounded byte chunks.
(ns kotoba.vm.evm.native-byte-resource-gate
 (:require [kotoba.vm.evm.native-bytes :as b]) (:export [main]))
(defn main [] :i64
 (+
  (arena-scope
   (let [data (vector-alloc 8388609)
         filled (loop [i 0] (if (= i (vector-count data)) 0
                             (let [z (vector-assoc! data i 97)] (recur (+ i 1)))))
         text (b/ascii-text data 0 (vector-count data))]
    (+ (if (= (string-length text) 8388609) 1 0)
       (if (= (string-substring text 0 2) "aa") 1 0)
       (if (= (string-substring text 8388607 8388609) "aa") 1 0))))
  (arena-scope
   (let [data (vector-alloc 4194305) a (vector-assoc! data 0 171)
         c (vector-assoc! data 4194303 1) d (vector-assoc! data 4194304 255)
         text (b/to-hex data)]
    (+ (if (= (string-length text) 8388610) 1 0)
       (if (= (string-substring text 0 2) "ab") 1 0)
       (if (= (string-substring text 8388606 8388610) "01ff") 1 0))))
  (if (= (b/ascii-text (vector-i64 97 98 99) 1 2) "bc") 1 0)))
