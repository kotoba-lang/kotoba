;; Process-level qualification driver. Crash modes stage the exact production
;; candidate bytes through the same native I/O adapter, then wait for SIGKILL.
(ns kotoba.vm.evm.native-store-driver
 (:require [kotoba.vm.evm.native-store :as s]
           [kotoba.vm.evm.native-store-io :as io]
           [kotoba.vm.evm.native-ethereum-fixture :as f])
 (:export [main]))
(defn- wait-for-kill [base :string] :i64
 (let [ready (io/write (string-concat base "/ready") "ready")]
  (if (not ready) -30
   (loop [i 0] (if (= i 9223372036854775807) -31 (recur (+ i 1)))))))
(defn- stage-crash [base :string stage :i64] :i64
 (let [lock (string-concat base "/awai81.lock")
       pending (string-concat base "/awai81.pending") final (string-concat base "/awai81.state")]
  (if (not (io/lock lock)) -20
   (let [candidate (if (= stage 0) "partial"
                    (s/candidate-envelope (f/context) (f/validators) 3 (f/extended) (f/extended-tip) (f/catalog) (f/next-checkpoint)))]
    (cond (not (io/write pending candidate)) -21
          (and (>= stage 2) (not (io/sync pending))) -22
          (and (>= stage 3) (not (io/rename pending final))) -23
          (and (>= stage 4) (not (io/sync base))) -24
          :else (wait-for-kill base))))))
(defn main [] :i64
 (let [mode (typed-cap-call :cli/args :string :string "0")
       base (typed-cap-call :cli/args :string :string "1")]
  (cond
   (= mode "init")
   (if (= (s/publish base (f/context) (f/validators) 3 (f/prefix) (f/tip) (f/catalog) (f/checkpoint)) (f/expected)) 1 0)
   (= mode "repeat")
   (if (= (s/publish base (f/context) (f/validators) 3 (f/prefix) (f/tip) (f/catalog) (f/next-checkpoint)) (f/expected)) 1 0)
   (= mode "recover") (if (= (s/recover base (f/context) (f/validators) 3) (f/expected)) 1 0)
   (= mode "extend")
   (if (= (s/publish base (f/context) (f/validators) 3 (f/extended) (f/extended-tip) (f/catalog) (f/next-checkpoint)) (f/expected-extended)) 1 0)
   (= mode "recover-extended") (if (= (s/recover base (f/context) (f/validators) 3) (f/expected-extended)) 1 0)
   (= mode "repeat-extended")
   (if (= (s/publish base (f/context) (f/validators) 3 (f/extended) (f/extended-tip) (f/catalog) (f/extended-checkpoint)) (f/expected-extended)) 1 0)
   (= mode "stale")
   (if (= (s/publish base (f/context) (f/validators) 3 (f/prefix) (f/tip) (f/catalog) (f/checkpoint)) "rejected:compare") 1 0)
   (= mode "rollback")
   (if (= (s/publish base (f/context) (f/validators) 3 (f/short) (f/short-tip) (f/catalog) (f/next-checkpoint)) "rejected:proof-or-checkpoint") 1 0)
   (= mode "fork")
   (if (= (s/publish base (f/context) (f/validators) 3 (f/fork) (f/fork-tip) (f/catalog) (f/next-checkpoint)) "rejected:proof-or-checkpoint") 1 0)
   (= mode "busy")
   (if (= (s/publish base (f/context) (f/validators) 3 (f/extended) (f/extended-tip) (f/catalog) (f/next-checkpoint)) "rejected:busy") 1 0)
   (= mode "corrupt") (if (= (s/recover base (f/context) (f/validators) 3) "rejected:corrupt") 1 0)
   (= mode "crash-partial") (stage-crash base 0)
   (= mode "crash-written") (stage-crash base 1)
   (= mode "crash-synced") (stage-crash base 2)
   (= mode "crash-renamed") (stage-crash base 3)
   (= mode "crash-durable") (stage-crash base 4)
   :else -1)))
