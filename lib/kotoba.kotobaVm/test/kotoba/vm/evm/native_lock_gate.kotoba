(ns kotoba.vm.evm.native-lock-gate (:require [kotoba.vm.evm.native-store-io :as io]) (:export [main]))
(defn main [] :i64
 (let [a (io/lock "/work/native-durable/locktest/one.lock")
       b (io/lock "/work/native-durable/locktest/one.lock")
       c (io/unlock "/work/native-durable/locktest/wrong.lock")
       d (io/unlock "/work/native-durable/locktest/one.lock")
       e (io/unlock "/work/native-durable/locktest/one.lock")
       f (io/lock "/work/native-durable/locktest/one.lock")
       g (io/unlock "/work/native-durable/locktest//one.lock")
       h (io/lock "/work/lock-outside-scope")
       i (io/lock "/work/native-durable/locktest/link.lock")]
  (+ (if a 1 0) (if b 0 1) (if c 0 1) (if d 1 0) (if e 0 1) (if f 1 0) (if g 1 0) (if h 0 1) (if i 0 1))))
