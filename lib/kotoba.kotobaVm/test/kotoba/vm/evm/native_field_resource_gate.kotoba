(ns kotoba.vm.evm.native-field-resource-gate
 (:require [kotoba.vm.evm.native-bytes :as b]) (:export [main]))
(defn main [] :i64
 (+ (if (= (b/fields "" 124) 0) 1 0)
    (if (= (b/fields "|" 124) 2) 1 0)
    (if (= (b/fields "|a||b|" 124) 5) 1 0)
    (if (= (b/field "|a||b|" 124 1) "a") 1 0)
    (if (= (b/field "|a||b|" 124 3) "b") 1 0)
    (if (= (b/field "|a||b|" 124 4) "") 1 0)
    (if (= (b/field "|a||b|" 124 5) "") 1 0)
    (if (= (b/field "a:b:c" 58 2) "c") 1 0)
    (if (= (b/field "a:b:c" 44 0) "a:b:c") 1 0)
    (if (= (b/field "abc" 124 -1) "") 1 0)))
