(ns kotoba.vm.evm.native-core-gate
  (:require [kotoba.vm.evm.native-core :as e]
            [kotoba.vm.evm.native-word :as w]
            [kotoba.vm.evm.native-keccak :as k])
  (:export [main]))

(defn- hex-nibble [c :i64] :i64
  (if (<= c 57) (- c 48) (- c 87)))

(defn- bytes [s :string] :vector-i64
  (loop [i 0 out (vector-i64)]
    (if (= i (string-length s)) out
      (recur (+ i 2)
        (vector-conj out (+ (* 16 (hex-nibble (string-code-point-at s i)))
                            (hex-nibble (string-code-point-at s (+ i 1)))))))))

(defn- execute [code :string gas :i64 static :bool] [:ref :evm.native/machine]
  (e/run (bytes code) (vector-i64) (vector-i64) (vector-i64) gas static))

(defn main [] :i64
  (let [mul (execute "600660070260005260206000f3" 100000 false)
        write (execute "600160005500" 100000 false)
        revert (execute "600160005560006000fd" 100000 false)
        load (execute "60005460005400" 100000 false)
        badjump (execute "600456605b00" 100000 false)
        oog (execute "5b600056" 50 false)
        invalid (execute "5f" 100000 false)
        unsupported (execute "44" 100000 false)
        static (execute "6001600055" 100000 true)
        underflow (execute "01" 100000 false)
        calldataload (execute "7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff3500" 100000 false)
        returnzero (execute "60007ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff3" 100000 false)
        ordered (execute "6007600255600860015500" 100000 false)
        clear (execute "6001600055600060005500" 100000 false)
        invalid-gap (execute "0c" 100000 false)
        iszero (execute "60001500" 100000 false)
        truncated (execute "61ab" 100000 false)
        malformed (e/run (vector-i64 256) (vector-i64) (vector-i64) (vector-i64) 100 false)
        hash (execute "600060002000" 100000 false)]
    (+ (if (and (= (e/status ordered) 1) (= (vector-count (e/storage ordered)) 64)
                 (= (vector-at (e/storage ordered) 0) 1)
                 (w/equal-word (e/read-slot (e/storage ordered) (w/from-long 2)) (w/from-long 7))) 1 0)
       (if (and (= (e/status clear) 1) (= (vector-count (e/storage clear)) 0)
                (= (e/gas-left clear) 77788)
                (= (record-get [:ref :evm.native/machine] clear :refund) 19900)) 1 0)
       (if (= (e/status invalid-gap) 4) 1 0)
       (if (and (= (e/status iszero) 1) (= (e/gas-left iszero) 99994)) 1 0)
       (if (and (= (e/status truncated) 1) (w/equal-word (e/stack-word truncated 0) (w/from-long 43776))) 1 0)
       (if (= (e/status malformed) 11) 1 0)
       (if (and (= (e/status mul) 1) (= (e/gas-left mul) 99974)
                (w/equal-word (w/from-bytes (e/output mul) 0 32) (w/from-long 42))) 1 0)
       (if (and (= (e/status write) 1) (= (e/gas-left write) 77894)
                (w/equal-word (e/read-slot (e/storage write) (w/zero-word)) (w/from-long 1))) 1 0)
       (if (and (= (e/status revert) 2) (= (e/gas-left revert) 77888)
                (= (vector-count (e/storage revert)) 0)) 1 0)
       (if (and (= (e/status load) 1) (= (e/gas-left load) 97794)) 1 0)
       (if (and (= (e/status badjump) 7) (= (e/gas-left badjump) 0)) 1 0)
       (if (and (= (e/status oog) 3) (= (e/gas-left oog) 0)) 1 0)
       (if (= (e/status invalid) 4) 1 0)
       (if (= (e/status unsupported) 8) 1 0)
       (if (and (= (e/status static) 9) (= (vector-count (e/storage static)) 0)) 1 0)
       (if (= (e/status underflow) 5) 1 0)
       (if (and (= (e/status calldataload) 1) (w/zero? (e/stack-word calldataload 0))) 1 0)
       (if (and (= (e/status returnzero) 1) (= (vector-count (e/output returnzero)) 0)) 1 0)
       (if (w/equal-word (w/from-bytes (k/digest (vector-i64)) 0 32)
                        (w/from-hex "c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470")) 1 0)
       (if (w/equal-word (w/from-bytes (k/digest (vector-i64 97 98 99)) 0 32)
                        (w/from-hex "4e03657aea45a94fc7d47ba826c8d667c0d1e6e33a64a036ec44f58fa12d6c45")) 1 0)
       (if (and (= (e/status hash) 1) (= (e/gas-left hash) 99964)
                (w/equal-word (e/stack-word hash 0)
                  (w/from-hex "c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470"))) 1 0))))
