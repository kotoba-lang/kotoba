(ns kotoba.vm.evm.native-ethereum-domain-gate
 (:require [kotoba.vm.evm.native-ethereum-domain :as d] [kotoba.vm.evm.native-ethereum-fixture :as f]) (:export [main]))
(defn main [] :i64
 (+ (if (= (d/replay (f/context) (f/validators) 3 (f/prefix) (f/tip) (f/catalog) (f/checkpoint)) (f/expected)) 1 0)
    (if (= (d/replay (f/context) (f/validators) 3 (f/extended) (f/extended-tip) (f/catalog) (f/next-checkpoint)) (f/expected-extended)) 1 0)
    (if (= (d/replay (f/context) (f/validators) 3 (f/short) (f/short-tip) (f/catalog) (f/next-checkpoint)) "rejected:proof-or-checkpoint") 1 0)
    (if (= (d/replay (f/context) (f/validators) 3 (f/fork) (f/fork-tip) (f/catalog) (f/next-checkpoint)) "rejected:proof-or-checkpoint") 1 0)
    (if (= (d/replay (f/context) (f/validators) 3 (f/prefix) (f/tip) "" (f/checkpoint)) "rejected:missing-request") 1 0)
    (if (= (d/replay (f/context) (f/validators) 3 (f/prefix) "invalid" (f/catalog) (f/checkpoint)) "rejected:proof-or-checkpoint") 1 0)))
