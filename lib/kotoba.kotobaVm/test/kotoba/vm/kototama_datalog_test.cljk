(ns kotoba.vm.kototama-datalog-test
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.vm.kototama.datalog :as datalog]))

(def ^:private eligible-facts
  [{:tuple ["vm:runs" "alice" "definition-1"] :origin :vm}
   {:tuple ["amu:requires" "definition-1" "fs/read"] :origin :amu}
   {:tuple ["amu:world" "definition-1" "world-1"] :origin :amu}
   {:tuple ["vm:requests" "alice" "fs/read" "/notes"] :origin :vm}
   {:tuple ["grant:right" "alice" "fs/read" "/notes"] :origin :grant}
   {:tuple ["policy:allows" "alice" "fs/read" "/notes"] :origin :policy}
   {:tuple ["runtime:world" "world-1"] :origin :runtime}
   {:tuple ["runtime:available" "fs/read" "/notes"] :origin :runtime}])

(def ^:private eligible-origin-facts
  {:vm [["vm:runs" "alice" "definition-1"]
        ["vm:requests" "alice" "fs/read" "/notes"]]
   :amu [["amu:requires" "definition-1" "fs/read"]
         ["amu:world" "definition-1" "world-1"]]
   :grant [["grant:right" "alice" "fs/read" "/notes"]]
   :policy [["policy:allows" "alice" "fs/read" "/notes"]]
   :runtime [["runtime:world" "world-1"]
             ["runtime:available" "fs/read" "/notes"]]})

(deftest authority-requires-one-complete-five-origin-derivation
  (let [allowed (datalog/authorize eligible-origin-facts "alice" "fs/read" "/notes" nil)
        missing (datalog/authorize (dissoc eligible-origin-facts :runtime)
                                   "alice" "fs/read" "/notes" nil)]
    (is (= :allow (:decision allowed)))
    (is (= datalog/authority-origins (:origins allowed)))
    (is (= :deny (:decision missing)))
    (is (= :incomplete-authority-intersection (:reason missing)))))

(deftest token-facts-cannot-impersonate-another-origin
  (let [facts (update eligible-origin-facts :grant conj
                      ["amu:requires" "definition-1" "fs/read"])
        result (datalog/authorize facts "alice" "fs/read" "/notes" nil)]
    (is (= :deny (:decision result)))
    (is (= :invalid-authority-evidence (:reason result)))))

(deftest range-restricted-rules-compute-a-bounded-transitive-closure
  (let [result
        (datalog/evaluate
         {:facts [{:tuple ["edge" "a" "b"] :origin :vm}
                  {:tuple ["edge" "b" "c"] :origin :vm}]
          :rules [{:head ["path" '?x '?y]
                   :body [["edge" '?x '?y]]}
                  {:head ["path" '?x '?z]
                   :body [["path" '?x '?y] ["edge" '?y '?z]]}]
          :query ["path" "a" '?destination]})]
    (is (= :ok (:status result)))
    (is (= [["path" "a" "b"] ["path" "a" "c"]]
           (mapv :tuple (:answers result))))
    (is (pos? (:fuel-used result)))))

(deftest provenance-keeps-independent-supports-separate
  (let [result (datalog/evaluate
                {:facts [{:tuple ["seed" "x"] :origin :vm}
                         {:tuple ["seed" "x"] :origin :grant}]
                 :rules [] :query ["seed" "x"]})]
    (is (= :ok (:status result)))
    (is (= [#{:vm} #{:grant}]
           (get-in result [:answers 0 :provenances])))))

(deftest canonical-byte-values-use-content-equality
  (let [left #?(:clj (byte-array [1 2 3])
                :cljs (js/Uint8Array. #js [1 2 3]))
        right #?(:clj (byte-array [1 2 3])
                 :cljs (js/Uint8Array. #js [1 2 3]))
        result (datalog/evaluate
                {:facts [{:tuple ["bytes" left] :origin :vm}]
                 :rules [] :query ["bytes" right]})]
    (is (= :ok (:status result)))
    (is (= 1 (count (:answers result))))))

(deftest unbounded-rules-and-budget-exhaustion-fail-closed
  (testing "a head variable not present in the body is rejected"
    (let [result (datalog/evaluate
                 {:facts []
                  :rules [{:head ["unsafe" '?unbound]
                           :body [["seed" "fixed"]]}]
                  :query ["unsafe" "anything"]})]
      (is (= :invalid (:status result)))
      (is (= :not-range-restricted (:reason result)))))
  (testing "a join-budget exhaustion returns no partial authority answer"
    (let [result (datalog/authorize eligible-origin-facts "alice" "fs/read" "/notes"
                                    {:max-joins 1})]
      (is (= :resource-exhaustion (:decision result)))
      (is (= :max-joins (:reason result)))))
  (testing "input fact vectors cannot exceed their configured bound"
    (let [result (datalog/evaluate
                  {:facts eligible-facts :rules []
                   :query ["vm:runs" "alice" "definition-1"]
                   :budget {:max-facts 1}})]
      (is (= :resource-exhaustion (:status result)))
      (is (empty? (:answers result)))))
  (testing "invalid numeric budget ceilings are refused"
    (let [result (datalog/evaluate
                  {:facts [] :rules [] :query ["empty"]
                   :budget {:max-joins 2000000}})]
      (is (= :invalid (:status result)))
      (is (= :invalid-budget (:reason result)))))
  (testing "host objects are not accepted as Datalog constants"
    (let [result (datalog/evaluate
                  {:facts [{:tuple ["host" (fn [] :not-data)] :origin :vm}]
                   :rules [] :query ["host" '?value]})]
      (is (= :invalid (:status result)))
      (is (= :non-portable-term (:reason result))))))
