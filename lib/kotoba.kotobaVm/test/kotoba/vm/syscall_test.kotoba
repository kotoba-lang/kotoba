(ns kotoba.vm.syscall-test (:export [main]) (:require [kotoba.vm.syscall :as p]))

(defn- case-costs [] :i64
  (let [c (p/costs)]
    (+ (if (= (option-or (document-i64-value (option-or (document-get c (document-keyword :ipld/open)) (document-null))) 0) 10) 0 1)
       (if (= (option-or (document-i64-value (option-or (document-get c (document-keyword :actor/call)) (document-null))) 0) 100) 0 1)
       (if (= (option-or (document-i64-value (option-or (document-get c (document-keyword :byte-unit)) (document-null))) 0) 32) 0 1)
       (if (= (document-count c) 10) 0 1))))

(defn- case-size [] :i64
  (+ (if (= (p/size-cost 2 (document-i64 0)) 2) 0 1)
     (if (= (p/size-cost 2 (document-i64 31)) 2) 0 1)
     (if (= (p/size-cost 2 (document-i64 32)) 3) 0 1)
     (if (= (p/size-cost 2 (document-i64 1000)) 33) 0 1)
     (if (= (p/size-cost 2 (document-null)) 2) 0 1)
     (if (= (p/size-cost 2 (document-i64 -32)) 1) 0 1)))

(defn- case-read-write [] :i64
  (+ (if (= (p/read-cost (document-null)) 4) 0 1)
     (if (= (p/read-cost (document-i64 0)) 4) 0 1)
     (if (= (p/read-cost (document-i64 100)) 7) 0 1)
     (if (= (p/write-cost (document-i64 64)) 6) 0 1)
     (if (= (p/write-cost (document-i64 0)) 4) 0 1)
     (if (= (p/write-cost (document-i64 4096)) 132) 0 1)))

(defn main [] :i64
  (+ (case-costs) (case-size) (case-read-write)))
