(ns kotoba.vm.kototama-program-test
  (:require #?(:clj [kotoba.test :refer [deftest is]]
               :cljs [cljs.test :refer [deftest is] :include-macros true])
            [ipld.core :as ipld]
            [kotoba.vm :as vm]
            #?(:clj [clojure.java.io :as clj-io]
               :cljs ["node:fs" :as fs])))

(defn- artifact []
  ;; Generated by bin/amu compile --target kototama from a source module
  ;; exporting (defn sum [a :i64 b :i64] :i64 (+ a b)).
  (ipld/decode
   #?(:clj (with-open [input (clj-io/input-stream
                              "lib/kotoba.kotobaVm/test/fixtures/amu-kototama-sum-v1.dagcbor")]
             (.readAllBytes input))
      :cljs (.readFileSync fs "lib/kotoba.kotobaVm/test/fixtures/amu-kototama-sum-v1.dagcbor"))))

(defn- capability-artifact []
  ;; Generated by Amu from examples/capability-named.kotoba with its matching
  ;; named-capability policy; this fixture crosses the real producer boundary.
  (ipld/decode
   #?(:clj (with-open [input (clj-io/input-stream
                              "lib/kotoba.kotobaVm/test/fixtures/amu-kototama-capability-v1.dagcbor")]
             (.readAllBytes input))
      :cljs (.readFileSync fs "lib/kotoba.kotobaVm/test/fixtures/amu-kototama-capability-v1.dagcbor"))))

(defn- run [store machine code method args fuel]
  (let [state (ipld/put-node! (:put! machine) {"counter" 0})]
    (vm/apply-message machine
                      {:actors {"alice" {:code code :state state :nonce 0 :balance 0}}
                       :from "bob" :to "alice" :method method :args args :fuel fuel})))

(defn- data-program [body]
  ["kototama.vm/program" 1
   {"entry" "echo"
    "exports" ["echo"]
    "value-profile" "kototama.data-i64/v1"
    "methods" {"echo" {"params" ["value"] "param-types" ["value"]
                        "result" "value" "effects" [] "body" body}}}])

(defn- effect-program []
  ["kototama.vm/program" 1
   {"entry" "write"
    "exports" ["write"]
    "value-profile" "kototama.data-i64/v1"
    "methods" {"write" {"params" [] "param-types" []
                          "result" "value" "effects" []
                          "body" ["call" "persist" []]}
               "persist" {"params" [] "param-types" []
                           "result" "value" "effects" [["fs/write"]]
                           "body" ["const" "done"]}}}])

(defn- authority-facts [{:keys [actor program effect]} grant-resource]
  {:resource "/notes"
   :origin-facts
   {:vm [["vm:runs" actor program]
         ["vm:requests" actor effect "/notes"]]
    :amu [["amu:requires" program effect]
          ["amu:world" program "world-1"]]
    :grant [["grant:right" actor effect grant-resource]]
    :policy [["policy:allows" actor effect "/notes"]]
    :runtime [["runtime:world" "world-1"]
              ["runtime:available" effect "/notes"]]}})

(deftest canonical-amu-program-runs-with-i64-wrap-semantics
  (let [store (vm/memory-store)
        machine {:get-fn (:get-fn store) :put! (:put! store)}
        code (vm/put-code! (:put! machine) (artifact))
        sum (run store machine code "sum"
                 [#?(:clj Long/MAX_VALUE :cljs (js/BigInt "9223372036854775807"))
                  #?(:clj 1 :cljs (js/BigInt 1))] 100)
        branch (run store machine code "choose" [0] 100)]
    (is (:ok? sum))
    (is (= #?(:clj Long/MIN_VALUE :cljs (js/BigInt "-9223372036854775808"))
           (get-in sum [:receipt :return])))
    (is (:ok? branch))
    (is (= #?(:clj 7 :cljs (js/BigInt 7)) (get-in branch [:receipt :return])))))

(deftest canonical-amu-program-charges-expression-fuel
  (let [store (vm/memory-store)
        machine {:get-fn (:get-fn store) :put! (:put! store)}
        code (vm/put-code! (:put! machine) (artifact))
        result (run store machine code "sum" [1 2] 1)]
    (is (not (:ok? result)))
    (is (= :fuel-exhausted (get-in result [:receipt :exit])))))

(deftest canonical-program-replicas-agree
  (let [left-store (vm/memory-store)
        right-store (vm/memory-store)
        left-machine {:get-fn (:get-fn left-store) :put! (:put! left-store)}
        right-machine {:get-fn (:get-fn right-store) :put! (:put! right-store)}
        left-code (vm/put-code! (:put! left-machine) (artifact))
        right-code (vm/put-code! (:put! right-machine) (artifact))
        left (run left-store left-machine left-code "sum" [20 22] 100)
        right (run right-store right-machine right-code "sum" [20 22] 100)]
    (is (= left-code right-code))
    (is (= "bafyreiadqe4yzd45fvkz456jfesqq3tc46th46ufyzermn2mzvixu47edu"
           left-code))
    (is (= (:receipt left) (:receipt right)))
    (is (= #?(:clj 42 :cljs (js/BigInt 42))
           (get-in left [:receipt :return])))))

(deftest data-value-profile-accepts-portable-values
  (let [store (vm/memory-store)
        machine {:get-fn (:get-fn store) :put! (:put! store)}
        code (vm/put-code! (:put! machine) (data-program ["var" "value"]))
        value {"items" [#?(:clj 1 :cljs (js/BigInt 1)) true nil "ok"]
               "nested" {"answer" #?(:clj 42 :cljs (js/BigInt 42))}}
        result (run store machine code "echo" [value] 100)]
    (is (:ok? result))
    (is (= value (get-in result [:receipt :return])))))

(deftest data-value-profile-uses-lisp-truth
  (let [store (vm/memory-store)
        machine {:get-fn (:get-fn store) :put! (:put! store)}
        body ["if" ["var" "value"]
              ["const" ["integer" "7"]]
              ["const" ["integer" "9"]]]
        code (vm/put-code! (:put! machine) (data-program body))
        false-result (run store machine code "echo" [false] 100)
        zero-result (run store machine code "echo" [0] 100)]
    (is (= #?(:clj 9 :cljs (js/BigInt 9)) (get-in false-result [:receipt :return])))
    (is (= #?(:clj 7 :cljs (js/BigInt 7)) (get-in zero-result [:receipt :return])))))

(deftest data-value-profile-compares-values-structurally
  (let [store (vm/memory-store)
        machine {:get-fn (:get-fn store) :put! (:put! store)}
        value [1 true {"key" "value"}]
        expected [#?(:clj 1 :cljs (js/BigInt 1)) true {"key" "value"}]
        body ["compare" "=" [["var" "value"]
                                ["const" [["integer" "1"] true {"key" "value"}]]]]
        code (vm/put-code! (:put! machine) (data-program body))
        result (run store machine code "echo" [expected] 100)]
    (is (:ok? result))
    (is (true? (get-in result [:receipt :return])))))

(deftest private-methods-remain-callable-internally-but-not-from-actor-messages
  (let [store (vm/memory-store)
        machine {:get-fn (:get-fn store) :put! (:put! store)}
        program ["kototama.vm/program" 1
                 {"entry" "main" "exports" ["main"]
                  "value-profile" "kototama.data-i64/v1"
                  "methods" {"main" {"params" [] "param-types" []
                                      "result" "value" "effects" []
                                      "body" ["call" "private" []]}
                             "private" {"params" [] "param-types" []
                                        "result" "value" "effects" []
                                        "body" ["const" "done"]}}}]
        code (vm/put-code! (:put! machine) program)
        private-call (run store machine code "private" [] 100)
        entry-call (run store machine code "main" [] 100)]
    (is (not (:ok? private-call)))
    (is (:ok? entry-call))
    (is (= "done" (get-in entry-call [:receipt :return])))))

(deftest effect-bearing-entry-is-gated-by-the-five-origin-join
  (let [store (vm/memory-store)
        base-machine {:get-fn (:get-fn store) :put! (:put! store)}
        code (vm/put-code! (:put! base-machine) (effect-program))
        message {:actors {"alice" {:code code :state nil :nonce 0 :balance 0}}
                 :from "bob" :to "alice" :method "write" :args [] :fuel 1000}
        denied (vm/apply-message base-machine message)
        authorized-machine
        (assoc base-machine :authority-facts-fn
               (fn [request] (authority-facts request "/notes")))
        allowed (vm/apply-message authorized-machine message)]
    (is (not (:ok? denied)))
    (is (= :unauthorized (get-in denied [:receipt :exit])))
    (is (:ok? allowed))
    (is (= "done" (get-in allowed [:receipt :return])))
    (is (= [{:method "persist" :effect ["fs/write"] :resource "/notes"}]
           (get-in allowed [:receipt :authority-decisions])))
    (is (pos? (get-in allowed [:receipt :fuel-used])))))

(deftest amu-capability-artifact-runs-through-authorized-kototama-effect-port
  (let [store (vm/memory-store)
        calls (atom [])
        base-machine {:get-fn (:get-fn store) :put! (:put! store)}
        code (vm/put-code! (:put! base-machine) (capability-artifact))
        machine (assoc base-machine
                       :authority-facts-fn (fn [request]
                                             (authority-facts request "/notes"))
                       :effect-fn (fn [request]
                                    (swap! calls conj request)
                                    {:ok? true :value (second (:args request))}))
        result (run store machine code "helper" [17] 1000)]
    (is (:ok? result))
    (is (= #?(:clj 17 :cljs (js/BigInt 17))
           (get-in result [:receipt :return])))
    (is (= 1 (count @calls)))
    (is (= [["keyword" "cap/call"] ["integer" "1"]]
           (:effect (first @calls))))
    (is (= ["helper" "audit"]
           (mapv :method (get-in result [:receipt :authority-decisions]))))))

(deftest undeclared-capability-expression-never-reaches-the-host-port
  (let [store (vm/memory-store)
        calls (atom 0)
        base-machine {:get-fn (:get-fn store) :put! (:put! store)}
        program (assoc-in (capability-artifact) [2 "methods" "audit" "effects"] [])
        code (vm/put-code! (:put! base-machine) program)
        machine (assoc base-machine
                       :authority-facts-fn (fn [request]
                                             (authority-facts request "/notes"))
                       :effect-fn (fn [_]
                                    (swap! calls inc)
                                    {:ok? true :value 17}))
        result (run store machine code "helper" [17] 1000)]
    (is (not (:ok? result)))
    (is (= :unauthorized (get-in result [:receipt :exit])))
    (is (zero? @calls))))

(deftest effect-bearing-entry-denies-a-mismatched-grant
  (let [store (vm/memory-store)
        base-machine {:get-fn (:get-fn store) :put! (:put! store)}
        code (vm/put-code! (:put! base-machine) (effect-program))
        machine (assoc base-machine :authority-facts-fn
                       (fn [request] (authority-facts request "/other")))
        result (vm/apply-message machine
                                 {:actors {"alice" {:code code :state nil :nonce 0 :balance 0}}
                                  :from "bob" :to "alice" :method "write"
                                  :args [] :fuel 1000})]
    (is (not (:ok? result)))
    (is (= :unauthorized (get-in result [:receipt :exit])))
    (is (empty? (get-in result [:receipt :authority-decisions])))))

(deftest effect-authorization-budget-exhaustion-stops-before-the-body
  (let [store (vm/memory-store)
        base-machine {:get-fn (:get-fn store) :put! (:put! store)}
        code (vm/put-code! (:put! base-machine) (effect-program))
        machine (assoc base-machine
                       :authority-facts-fn
                       (fn [request] (authority-facts request "/notes"))
                       :datalog-budget {:max-joins 1})
        result (vm/apply-message machine
                                 {:actors {"alice" {:code code :state nil :nonce 0 :balance 0}}
                                  :from "bob" :to "alice" :method "write"
                                  :args [] :fuel 1000})]
    (is (not (:ok? result)))
    (is (= :fuel-exhausted (get-in result [:receipt :exit])))
    (is (empty? (get-in result [:receipt :authority-decisions])))))
