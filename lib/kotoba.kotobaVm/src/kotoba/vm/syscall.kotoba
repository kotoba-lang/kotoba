;; Port of kotoba.vm.syscall (syscall.cljk), Kotoba-native, :document values.
;;
;; Integer costs charged before the effect. Exhaustion stays a value on the
;; context (no throw); this namespace only prices calls.
;;
;; Named divergences from syscall.cljk:
;;   - `costs` is a zero-arg fn returning the :document cost map (def cannot be
;;     exported, E2005). Each cost is read from it by keyword.
;;   - size-cost takes its base as an i64 and its byte count as a :document;
;;     a nil or absent byte count is 0, as (or n 0) in the source. A non-integer
;;     byte count also reads as 0 (the source would throw).
;;   - (long base) is the identity here: base is already an i64.

(ns kotoba.vm.syscall
  (:export [costs size-cost read-cost write-cost]))

(defn costs [] :document
  (document-map :ipld/open (document-i64 10)
                :ipld/read-base (document-i64 4)
                :ipld/write-base (document-i64 4)
                :ipld/link (document-i64 20)
                :ipld/stat (document-i64 2)
                :self/root (document-i64 2)
                :self/set-state (document-i64 2)
                :actor/call (document-i64 100)
                :guest/op (document-i64 1)
                :byte-unit (document-i64 32)))

(defn- cost [k :keyword] :i64
  (option-or (document-i64-value (option-or (document-get (costs) (document-keyword k)) (document-null))) 0))

(defn size-cost
  "Linear in bytes, integer division. A 0-byte write still pays the base."
  [base :i64 n :document] :i64
  (+ base (quot (option-or (document-i64-value n) 0) (cost :byte-unit))))

(defn read-cost [n :document] :i64
  (size-cost (cost :ipld/read-base) n))

(defn write-cost [n :document] :i64
  (size-cost (cost :ipld/write-base) n))
