;; Narrow native filesystem adapter. The runtime enforces the externally
;; granted :fs/app-data root; these functions do not create a grant.
(ns kotoba.vm.evm.native-store-io)
(defn- io-token [word :string] :string (string-concat word "_SEP"))
(defn exists? [path :string] :bool
 (= (typed-cap-call :fs/app-data :string :string (string-concat path (io-token "EXISTS"))) "1"))
(defn read [path :string] :string (typed-cap-call :fs/app-data :string :string path))
(defn write [path :string data :string] :bool
 (= (typed-cap-call :fs/app-data :string :string (string-concat path (string-concat (io-token "WRITE") data))) data))
(defn sync [path :string] :bool
 (= (typed-cap-call :fs/app-data :string :string (string-concat path (io-token "FSYNC"))) "1"))
(defn rename [from :string to :string] :bool
 (= (typed-cap-call :fs/app-data :string :string (string-concat from (string-concat (io-token "RENAME") to))) "1"))
(defn lock [path :string] :bool
 (= (typed-cap-call :fs/app-data :string :string (string-concat path (io-token "FLOCK"))) "1"))
(defn unlock [path :string] :bool
 (= (typed-cap-call :fs/app-data :string :string (string-concat path (io-token "UNLOCK"))) "1"))
