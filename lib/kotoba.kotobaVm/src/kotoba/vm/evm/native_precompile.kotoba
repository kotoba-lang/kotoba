;; Paris precompile dispatcher. Unsupported algorithms are explicit profile
;; refusals, never successful empty results. Implementations are native only.
(ns kotoba.vm.evm.native-precompile
  (:require [kotoba.vm.evm.native-bytes :as b]
            [kotoba.vm.evm.native-word :as w]
            [kotoba.vm.evm.native-recover :as recover]
            [kotoba.vm.evm.native-ripemd :as ripemd]
            [kotoba.vm.evm.native-modexp :as modexp]
            [kotoba.vm.evm.native-bn128 :as bn]
            [kotoba.vm.evm.native-pairing :as pairing]
            [kotoba.vm.evm.native-blake2f :as blake]
            [sha2.core :as sha])
  (:schemas {:evm.native/precompile
    [:record :evm.native/precompile [[:status :i64] [:gas :i64] [:output :vector-i64]]]}))
(defn number [address :string] :i64 (w/bounded-long (w/from-hex address) 10))
(defn execute [address :string input :vector-i64 gas :i64] [:ref :evm.native/precompile]
  (let [id (number address) words (quot (+ (vector-count input) 31) 32)
        cost (cond (= id 1) 3000 (= id 2) (+ 60 (* words 12))
                   (= id 3) (+ 600 (* words 120)) (= id 4) (+ 15 (* words 3))
                   (= id 5) (modexp/cost input) (= id 6) 150 (= id 7) 6000
                   (= id 8) (+ 45000 (* 34000 (quot (vector-count input) 192)))
                   (= id 9) (blake/rounds input) :else 0)]
    (cond
      (or (not (= (string-length address) 40)) (not (b/valid-hex? address))
          (not (b/valid? input)) (< gas 0))
      (record-new [:ref :evm.native/precompile] 11 gas (vector-i64))
      (or (< id 1) (> id 9)) (record-new [:ref :evm.native/precompile] 0 gas (vector-i64))
      (or (< cost 0) (> cost gas)) (record-new [:ref :evm.native/precompile] 3 0 (vector-i64))
      (and (= id 5) (or (> (modexp/length input 0) 65536)
                       (> (modexp/length input 32) 65536) (> (modexp/length input 64) 65536))
           (not (and (= (modexp/length input 0) 0) (= (modexp/length input 64) 0))))
      (record-new [:ref :evm.native/precompile] 10 gas (vector-i64))
      (and (= id 9) (not (blake/valid? input)))
      (record-new [:ref :evm.native/precompile] 4 0 (vector-i64))
      :else
      (let [output (cond (= id 1) (recover/precompile input) (= id 2) (sha/sha256 input)
                         (= id 3) (b/concat (vector-alloc 12) (ripemd/digest input))
                         (= id 4) (b/slice input 0 (vector-count input))
                         (= id 5) (modexp/execute input) (= id 6) (bn/add input)
                         (= id 7) (bn/multiply input) (= id 8) (pairing/execute input)
                         :else (blake/compress input))]
       (if (and (or (= id 6) (= id 7)) (not (= (vector-count output) 64)))
        (record-new [:ref :evm.native/precompile] 4 0 (vector-i64))
        (if (and (= id 8) (not (= (vector-count output) 32)))
         (record-new [:ref :evm.native/precompile] 4 0 (vector-i64))
         (record-new [:ref :evm.native/precompile] 1 (- gas cost) output)))))))
