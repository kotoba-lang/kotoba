;; Ethereum state-test logs hash: Keccak256(RLP([[address, topics, data], ...])).
;; The execution manager supplies its canonical admitted log representation.
(ns kotoba.vm.evm.native-logs
 (:require [kotoba.vm.evm.native-bytes :as b]
           [kotoba.vm.evm.native-rlp :as r]
           [kotoba.vm.evm.native-keccak :as k]))
(defn digest [logs :string] :vector-i64
 (let [encoded
       (loop [i 0 out (vector-i64)]
        (if (= i (b/fields logs 124)) out
         (let [entry (b/field logs 124 i) topics (b/field entry 58 1)
               ts (loop [j 0 acc (vector-i64)]
                   (if (= j (b/fields topics 44)) acc
                    (recur (+ j 1) (b/concat acc (r/encode-bytes (b/from-hex (b/field topics 44 j)))))))
               item (r/encode-list
                     (b/concat (r/encode-bytes (b/from-hex (b/field entry 58 0)))
                      (b/concat (r/encode-list ts) (r/encode-bytes (b/from-hex (b/field entry 58 2))))))]
          (recur (+ i 1) (b/concat out item)))))]
  (k/digest (r/encode-list encoded))))
