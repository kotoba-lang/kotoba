;; Public-key recovery only. No signing, secret keys or host crypto.
(ns kotoba.vm.evm.native-recover
 (:require [kotoba.vm.evm.native-field :as f]
           [kotoba.vm.evm.native-curve :as c]
           [kotoba.vm.evm.native-word :as w]
           [kotoba.vm.evm.native-bytes :as b]
           [kotoba.vm.evm.native-keccak :as k]))
(defn public-key [hash :vector-i64 r :vector-i64 s :vector-i64 parity :i64] :vector-i64
 ;; This primitive accepts high-s, as ECRECOVER does. Ethereum transaction
 ;; admission separately enforces EIP-2 low-s and the transaction's chain id.
 (let [out (vector-alloc 64)
       size (arena-scope
        (let [fp (f/secp-field) scalar-context (f/secp-order) order (f/modulus scalar-context)]
         (if (or (not (= (vector-count hash) 32)) (not (b/valid? hash))
                 (< parity 0) (> parity 1) (w/zero? r) (w/zero? s)
                 (not (w/less-word r order)) (not (w/less-word s order))) 0
          (let [x (f/from-word fp r) rhs (f/add fp (f/multiply fp (f/square fp x) x) (f/from-word fp (w/from-long 7)))
                exponent (w/shift-right (w/add-word (f/modulus fp) (w/from-long 1)) 2 false)
                root (f/power fp rhs exponent)
                y (if (= (w/bit-at (f/to-word fp root) 0) parity) root (f/negate fp root))]
           (if (not (w/equal-word (f/square fp y) rhs)) 0
            (let [rr (f/from-word scalar-context r) ss (f/from-word scalar-context s)
                  z (f/from-word scalar-context (w/from-bytes hash 0 32)) ri (f/inverse scalar-context rr)
                  u (f/to-word scalar-context (f/negate scalar-context (f/multiply scalar-context z ri)))
                  v (f/to-word scalar-context (f/multiply scalar-context ss ri))
                  q (c/add fp (c/multiply fp (c/secp-generator fp) u)
                              (c/multiply fp (c/affine-point fp x y) v))]
             (if (c/infinity? q) 0
              (let [affine (c/to-affine fp q)
                    copied (loop [i 0]
                            (if (= i 64) 0
                             (let [z (vector-assoc! out i (vector-at affine i))] (recur (+ i 1)))))] 64))))))))]
  (if (= size 64) out (vector-i64))))
(defn address [hash :vector-i64 r :vector-i64 s :vector-i64 parity :i64] :vector-i64
 (let [key (public-key hash r s parity)]
  (if (= (vector-count key) 64) (b/slice (k/digest key) 12 20) (vector-i64))))
(defn precompile [input :vector-i64] :vector-i64
 (let [v (w/from-bytes input 32 32)
       parity (cond (w/equal-word v (w/from-long 27)) 0 (w/equal-word v (w/from-long 28)) 1 :else -1)
       recovered (if (< parity 0) (vector-i64)
                   (address (b/slice input 0 32) (w/from-bytes input 64 32) (w/from-bytes input 96 32) parity))]
  (if (= (vector-count recovered) 20) (b/concat (vector-alloc 12) recovered) (vector-i64))))
