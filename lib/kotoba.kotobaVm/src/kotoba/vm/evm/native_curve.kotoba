;; Jacobian arithmetic for the a=0 prime-field curves used by secp256k1 and
;; alt_bn128. Coordinates are Montgomery elements; Z=0 denotes infinity.
(ns kotoba.vm.evm.native-curve
 (:require [kotoba.vm.evm.native-field :as f]
           [kotoba.vm.evm.native-word :as w]
           [kotoba.vm.evm.native-bytes :as b]))
(defn coordinate [point :vector-i64 index :i64] :vector-i64 (b/slice point (* index 16) 16))
(defn infinity? [point :vector-i64] :bool
 (loop [i 32] (if (= i 48) true (if (= (vector-at point i) 0) (recur (+ i 1)) false))))
(defn affine-point [ctx [:ref :evm.native/field] x :vector-i64 y :vector-i64] :vector-i64
 (b/concat (b/concat x y) (f/one ctx)))
(defn- nc-copy [out :vector-i64 source :vector-i64] :i64
 (loop [i 0] (if (= i 48) 0 (let [z (vector-assoc! out i (vector-at source i))] (recur (+ i 1))))))
(defn- nc-zero [out :vector-i64] :i64
 (loop [i 0] (if (= i 48) 0 (let [z (vector-assoc! out i 0)] (recur (+ i 1))))))
(defn- nc-write [out :vector-i64 x :vector-i64 y :vector-i64 z :vector-i64] :i64
 (loop [i 0]
  (if (= i 16) 0
   (let [a (vector-assoc! out i (vector-at x i))
         c (vector-assoc! out (+ 16 i) (vector-at y i))
         d (vector-assoc! out (+ 32 i) (vector-at z i))] (recur (+ i 1))))))
(defn- nc-double-into [out :vector-i64 ctx [:ref :evm.native/field] point :vector-i64] :i64
 (arena-scope
  (let [x (coordinate point 0) y (coordinate point 1) z (coordinate point 2)]
   (if (or (w/zero? z) (w/zero? y)) (nc-zero out)
    (let [a (f/square ctx x) b2 (f/square ctx y) c (f/square ctx b2)
          d0 (f/subtract ctx (f/subtract ctx (f/square ctx (f/add ctx x b2)) a) c)
          d (f/add ctx d0 d0) e (f/add ctx (f/add ctx a a) a) ff (f/square ctx e)
          nx (f/subtract ctx ff (f/add ctx d d))
          c2 (f/add ctx c c) c4 (f/add ctx c2 c2) c8 (f/add ctx c4 c4)
          ny (f/subtract ctx (f/multiply ctx e (f/subtract ctx d nx)) c8)
          yz (f/multiply ctx y z) nz (f/add ctx yz yz)]
     (nc-write out nx ny nz))))))
(defn- nc-add-into [out :vector-i64 ctx [:ref :evm.native/field] a :vector-i64 b :vector-i64] :i64
 (arena-scope
  (cond
   (infinity? a) (nc-copy out b)
   (infinity? b) (nc-copy out a)
   :else
   (let [x1 (coordinate a 0) y1 (coordinate a 1) z1 (coordinate a 2)
         x2 (coordinate b 0) y2 (coordinate b 1) z2 (coordinate b 2)
         z1z1 (f/square ctx z1) z2z2 (f/square ctx z2)
         u1 (f/multiply ctx x1 z2z2) u2 (f/multiply ctx x2 z1z1)
         s1 (f/multiply ctx y1 (f/multiply ctx z2 z2z2))
         s2 (f/multiply ctx y2 (f/multiply ctx z1 z1z1))]
    (if (w/equal-word u1 u2)
     (if (w/equal-word s1 s2) (nc-double-into out ctx a) (nc-zero out))
     (let [h (f/subtract ctx u2 u1) h2 (f/add ctx h h) i (f/square ctx h2)
           j (f/multiply ctx h i) delta (f/subtract ctx s2 s1) r (f/add ctx delta delta)
           v (f/multiply ctx u1 i)
           nx (f/subtract ctx (f/subtract ctx (f/square ctx r) j) (f/add ctx v v))
           s1j (f/multiply ctx s1 j)
           ny (f/subtract ctx (f/multiply ctx r (f/subtract ctx v nx)) (f/add ctx s1j s1j))
           nz (f/multiply ctx (f/subtract ctx (f/subtract ctx (f/square ctx (f/add ctx z1 z2)) z1z1) z2z2) h)]
      (nc-write out nx ny nz)))))))
(defn add [ctx [:ref :evm.native/field] a :vector-i64 b :vector-i64] :vector-i64
 (let [out (vector-alloc 48) written (nc-add-into out ctx a b)] out))
(defn double-point [ctx [:ref :evm.native/field] point :vector-i64] :vector-i64
 (let [out (vector-alloc 48) written (nc-double-into out ctx point)] out))
(defn multiply [ctx [:ref :evm.native/field] point :vector-i64 scalar :vector-i64] :vector-i64
 (let [out (vector-alloc 48)
       written (arena-scope
                (let [acc (vector-alloc 48)
                      done (loop [bit 255]
                            (if (< bit 0) 0
                             (let [d (nc-double-into acc ctx acc)
                                   a (if (= (w/bit-at scalar bit) 1) (nc-add-into acc ctx acc point) 0)]
                              (recur (- bit 1)))))]
                 (nc-copy out acc)))] out))
(defn to-affine [ctx [:ref :evm.native/field] point :vector-i64] :vector-i64
 (let [out (vector-alloc 64)
       written (arena-scope
                (if (infinity? point) 0
                 (let [zinv (f/inverse ctx (coordinate point 2)) z2 (f/square ctx zinv)
                       x (f/to-word ctx (f/multiply ctx (coordinate point 0) z2))
                       y (f/to-word ctx (f/multiply ctx (coordinate point 1) (f/multiply ctx z2 zinv)))]
                  (loop [i 0]
                   (if (= i 32) 0
                    (let [a (vector-assoc! out i (w/byte-at x i))
                          b (vector-assoc! out (+ i 32) (w/byte-at y i))] (recur (+ i 1))))))))] out))
(defn from-bytes [ctx [:ref :evm.native/field] input :vector-i64 offset :i64 curve-b :i64] :vector-i64
 ;; Empty vector signals an invalid point; 48 zero limbs denote infinity.
 (let [x (w/from-bytes input offset 32) y (w/from-bytes input (+ offset 32) 32) p (f/modulus ctx)]
  (cond (and (w/zero? x) (w/zero? y)) (vector-alloc 48)
        (or (not (w/less-word x p)) (not (w/less-word y p))) (vector-i64)
        :else
        (let [xx (f/from-word ctx x) yy (f/from-word ctx y)
              rhs (f/add ctx (f/multiply ctx (f/square ctx xx) xx) (f/from-word ctx (w/from-long curve-b)))]
         (if (w/equal-word (f/square ctx yy) rhs) (affine-point ctx xx yy) (vector-i64))))))
(defn secp-generator [ctx [:ref :evm.native/field]] :vector-i64
 (affine-point ctx
  (f/from-word ctx (w/from-hex "79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798"))
  (f/from-word ctx (w/from-hex "483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8"))))
