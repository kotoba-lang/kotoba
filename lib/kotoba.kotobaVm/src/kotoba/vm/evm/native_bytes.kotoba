;; Byte-preserving helpers shared by native Ethereum codecs and execution.
(ns kotoba.vm.evm.native-bytes)

(defn valid? [v :vector-i64] :bool
  (loop [i 0]
    (if (= i (vector-count v)) true
      (if (and (>= (vector-at v i) 0) (<= (vector-at v i) 255)) (recur (+ i 1)) false))))

(defn equal? [a :vector-i64 b :vector-i64] :bool
  (and (= (vector-count a) (vector-count b))
    (loop [i 0]
      (if (= i (vector-count a)) true
        (if (= (vector-at a i) (vector-at b i)) (recur (+ i 1)) false)))))

(defn slice [v :vector-i64 offset :i64 length :i64] :vector-i64
  ;; Zero padding is intentional for EVM code/calldata/memory callers.
  (let [out (vector-alloc length)]
    (loop [i 0]
      (if (= i length) out
        (let [z (vector-assoc! out i (vector-get v (+ offset i) 0))] (recur (+ i 1)))))))

(defn concat [a :vector-i64 b :vector-i64] :vector-i64
  (let [na (vector-count a) nb (vector-count b) out (vector-alloc (+ na nb))]
    (loop [i 0]
      (if (= i (+ na nb)) out
        (let [z (vector-assoc! out i (if (< i na) (vector-at a i) (vector-at b (- i na))))]
          (recur (+ i 1)))))))

(defn- nibble [c :i64] :i64
  (cond (and (>= c 48) (<= c 57)) (- c 48)
        (and (>= c 97) (<= c 102)) (- c 87) :else -1))

(defn valid-hex? [s :string] :bool
  (and (= (rem (string-length s) 2) 0)
    (loop [i 0]
      (if (= i (string-length s)) true
        (if (>= (nibble (string-code-point-at s i)) 0) (recur (+ i 1)) false)))))

(defn from-hex [s :string] :vector-i64
  ;; Input must pass valid-hex? at the protocol boundary.
  (let [n (quot (string-length s) 2) out (vector-alloc n)]
    (loop [i 0]
      (if (= i n) out
        (let [z (vector-assoc! out i (+ (* 16 (nibble (string-code-point-at s (* i 2))))
                                        (nibble (string-code-point-at s (+ (* i 2) 1)))))]
          (recur (+ i 1)))))))

(defn- hex-small [v :vector-i64] :string
  (let [alphabet "0123456789abcdef" n (vector-count v) out (vector-alloc (* n 2))]
    (loop [i 0]
      (if (= i n) (string-from-utf8 (bytes-from-vector-i64 out))
        (let [x (vector-at v i)
              a (vector-assoc! out (* i 2) (string-code-point-at alphabet (quot x 16)))
              z (vector-assoc! out (+ (* i 2) 1) (string-code-point-at alphabet (rem x 16)))]
          (recur (+ i 1)))))))

(defn to-hex [v :vector-i64] :string
 (if (<= (vector-count v) 4194304) (hex-small v)
  (loop [offset 0 out ""]
   (if (= offset (vector-count v)) out
    (let [remaining (- (vector-count v) offset) count (if (> remaining 4194304) 4194304 remaining)]
     (recur (+ offset count) (string-concat out (hex-small (slice v offset count)))))))))

(defn- separator [delimiter :i64] :string
 (cond (= delimiter 10) "\n" (= delimiter 124) "|" (= delimiter 58) ":"
       (= delimiter 44) "," (= delimiter 59) ";" (= delimiter 126) "~"
       (= delimiter 32) " " (= delimiter 47) "/" (= delimiter 46) "."
       :else (string-from-utf8 (bytes-from-vector-i64 (vector-i64 delimiter)))))
(defn fields [s :string delimiter :i64] :i64
 ;; Protocol inputs are ASCII. Native substring views and byte search avoid
 ;; scanning the same prefix again for every account, proof or catalog field.
 (if (= (string-length s) 0) 0
  (if (or (< delimiter 0) (> delimiter 127)) 1
   (let [sep (separator delimiter) length (string-length s)]
    (loop [offset 0 count 1]
     (let [at (string-index-of (string-substring s offset length) sep)]
      (if (< at 0) count (recur (+ offset at 1) (+ count 1)))))))))
(defn field [s :string delimiter :i64 index :i64] :string
 (if (< index 0) ""
  (if (or (< delimiter 0) (> delimiter 127)) (if (= index 0) s "")
   (let [sep (separator delimiter) length (string-length s)]
    (loop [offset 0 part 0]
     (let [at (string-index-of (string-substring s offset length) sep)
           end (if (< at 0) length (+ offset at))]
      (cond (= part index) (string-substring s offset end)
            (< at 0) ""
            :else (recur (+ end 1) (+ part 1)))))))))

(defn ascii? [s :string] :bool
  (loop [i 0] (if (= i (string-length s)) true
    (let [c (string-code-point-at s i)]
      (if (or (= c 10) (and (>= c 32) (<= c 126))) (recur (+ i 1)) false)))))
(defn ascii-bytes [s :string] :vector-i64
  (let [out (vector-alloc (string-length s))]
    (loop [i 0] (if (= i (string-length s)) out
      (let [z (vector-assoc! out i (string-code-point-at s i))] (recur (+ i 1)))))))
(defn ascii-hex [s :string] :string (to-hex (ascii-bytes s)))
(defn valid-ascii-hex? [s :string] :bool
 (and (valid-hex? s)
  (let [bytes (from-hex s)]
   (loop [i 0] (if (= i (vector-count bytes)) true
    (let [c (vector-at bytes i)]
     (if (or (= c 10) (and (>= c 32) (<= c 126))) (recur (+ i 1)) false)))))))
(defn hex-text [s :string] :string
 (if (valid-ascii-hex? s) (string-from-utf8 (bytes-from-vector-i64 (from-hex s))) ""))

;; Byte-object conversion remains bounded even for a larger owned ASCII
;; buffer. Every chunk is independently valid ASCII and within 8 MiB.
(defn ascii-text [v :vector-i64 offset :i64 length :i64] :string
 (loop [at 0 out ""]
  (if (= at length) out
   (let [remaining (- length at) count (if (> remaining 4194304) 4194304 remaining)
         part (string-from-utf8 (bytes-from-vector-i64 (slice v (+ offset at) count)))]
    (recur (+ at count) (string-concat out part))))))
