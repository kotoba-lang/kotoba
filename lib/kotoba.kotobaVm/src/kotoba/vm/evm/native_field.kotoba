;; 16-limb CIOS Montgomery arithmetic. All products/intermediates fit i64.
;; No host BigInt, crypto capability or external arithmetic implementation.
(ns kotoba.vm.evm.native-field
 (:require [kotoba.vm.evm.native-word :as w])
 (:schemas {:evm.native/field [:record :evm.native/field
   [[:modulus :vector-i64] [:n0 :i64] [:r2 :vector-i64] [:one :vector-i64]]]}))
(defn secp-field [] [:ref :evm.native/field]
 (record-new [:ref :evm.native/field]
  (w/from-hex "fffffffffffffffffffffffffffffffffffffffffffffffffffffffefffffc2f") 13617
  (w/from-hex "000000000000000000000000000000000000000000000001000007a2000e90a1") (w/from-hex "00000000000000000000000000000000000000000000000000000001000003d1")))
(defn secp-order [] [:ref :evm.native/field]
 (record-new [:ref :evm.native/field]
  (w/from-hex "fffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141") 45375
  (w/from-hex "9d671cd581c69bc5e697f5e45bcd07c6741496c20e7cf878896cf21467d7d140") (w/from-hex "000000000000000000000000000000014551231950b75fc4402da1732fc9bebf")))
(defn bn-field [] [:ref :evm.native/field]
 (record-new [:ref :evm.native/field]
  (w/from-hex "30644e72e131a029b85045b68181585d97816a916871ca8d3c208c16d87cfd47") 25481
  (w/from-hex "06d89f71cab8351f47ab1eff0a417ff6b5e71911d44501fbf32cfc5b538afa89") (w/from-hex "0e0a77c19a07df2f666ea36f7879462c0a78eb28f5c70b3dd35d438dc58f0d9d")))

(defn modulus [f [:ref :evm.native/field]] :vector-i64
 (record-get [:ref :evm.native/field] f :modulus))
(defn one [f [:ref :evm.native/field]] :vector-i64
 (record-get [:ref :evm.native/field] f :one))
(defn add [f [:ref :evm.native/field] a :vector-i64 b :vector-i64] :vector-i64
 (let [sum (w/add-word a b) p (modulus f)]
  (if (or (w/less-word sum a) (not (w/less-word sum p))) (w/subtract-word sum p) sum)))
(defn subtract [f [:ref :evm.native/field] a :vector-i64 b :vector-i64] :vector-i64
 (let [difference (w/subtract-word a b)]
  (if (w/less-word a b) (w/add-word difference (modulus f)) difference)))
(defn negate [f [:ref :evm.native/field] a :vector-i64] :vector-i64
 (if (w/zero? a) (w/zero-word) (w/subtract-word (modulus f) a)))

(defn- nf-multiply-into [out :vector-i64 f [:ref :evm.native/field] a :vector-i64 b :vector-i64] :i64
 (arena-scope
  (let [t (vector-alloc 18) p (modulus f) n0 (record-get [:ref :evm.native/field] f :n0)
        product
        (loop [i 0]
         (if (= i 16) 0
          (let [carry (loop [j 0 carry 0]
                       (if (= j 16) carry
                        (let [sum (+ (vector-at t j) (* (vector-at a j) (vector-at b i)) carry)
                              z (vector-assoc! t j (rem sum 65536))]
                         (recur (+ j 1) (quot sum 65536)))))
                high (+ (vector-at t 16) carry)
                h0 (vector-assoc! t 16 (rem high 65536)) h1 (vector-assoc! t 17 (quot high 65536))
                q (rem (* (vector-at t 0) n0) 65536)
                reduced-carry
                (loop [j 0 carry 0]
                 (if (= j 16) carry
                  (let [sum (+ (vector-at t j) (* q (vector-at p j)) carry)
                        z (if (= j 0) t (vector-assoc! t (- j 1) (rem sum 65536)))]
                   (recur (+ j 1) (quot sum 65536)))))
                top (+ (vector-at t 16) reduced-carry)
                r0 (vector-assoc! t 15 (rem top 65536))
                r1 (vector-assoc! t 16 (+ (vector-at t 17) (quot top 65536)))
                r2 (vector-assoc! t 17 0)]
           (recur (+ i 1)))))
        reduce (or (not (= (vector-at t 16) 0))
                   (loop [j 15]
                    (if (< j 0) true
                     (let [a (vector-at t j) b (vector-at p j)]
                      (if (= a b) (recur (- j 1)) (> a b))))))]
   (loop [i 0 borrow 0]
    (if (= i 16) 0
     (let [value (if reduce (- (vector-at t i) (vector-at p i) borrow) (vector-at t i))
           z (vector-assoc! out i (if (< value 0) (+ value 65536) value))]
      (recur (+ i 1) (if (< value 0) 1 0))))))))

(defn multiply [f [:ref :evm.native/field] a :vector-i64 b :vector-i64] :vector-i64
 (let [out (vector-alloc 16) written (nf-multiply-into out f a b)] out))
(defn square [f [:ref :evm.native/field] a :vector-i64] :vector-i64 (multiply f a a))
(defn from-word [f [:ref :evm.native/field] a :vector-i64] :vector-i64
 (multiply f (w/remainder-word a (modulus f)) (record-get [:ref :evm.native/field] f :r2)))
(defn to-word [f [:ref :evm.native/field] a :vector-i64] :vector-i64
 (multiply f a (w/from-long 1)))
(defn copy-into [out :vector-i64 source :vector-i64] :i64
 (loop [i 0]
  (if (= i 16) 0 (let [z (vector-assoc! out i (vector-at source i))] (recur (+ i 1))))))
(defn power [f [:ref :evm.native/field] a :vector-i64 exponent :vector-i64] :vector-i64
 (let [out (vector-alloc 16)
       written (arena-scope
                (let [result (loop [bit 255 acc (one f)]
                              (if (< bit 0) acc
                               (let [squared (square f acc)]
                                (recur (- bit 1) (if (= (w/bit-at exponent bit) 1)
                                                 (multiply f squared a) squared)))))]
                 (copy-into out result)))] out))
(defn inverse [f [:ref :evm.native/field] a :vector-i64] :vector-i64
 ;; Input is nonzero in the supported prime field; callers validate it.
 (power f a (w/subtract-word (modulus f) (w/from-long 2))))
