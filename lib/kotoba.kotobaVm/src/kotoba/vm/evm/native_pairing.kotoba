;; EIP-197 alt_bn128 pairing. Projective line formulas follow py_ecc
;; v8.0.0 optimized_bn128 (MIT; docs/licenses/py-ecc.txt). Arithmetic and
;; exponentiation are native Kotoba, without foreign crypto or host BigInt.
(ns kotoba.vm.evm.native-pairing
 (:require [kotoba.vm.evm.native-field :as f]
           [kotoba.vm.evm.native-extension :as e]
           [kotoba.vm.evm.native-extension-curve :as c]
           [kotoba.vm.evm.native-curve :as g1]
           [kotoba.vm.evm.native-word :as w]
           [kotoba.vm.evm.native-bytes :as b]))
(defn- np-order [] :vector-i64 (w/from-hex "30644e72e131a029b85045b68181585d2833e84879b9709143e1f593f0000001"))
(defn- np-b2-real [] :vector-i64 (w/from-hex "2b149d40ceb8aaae81be18991be06ac3b5b4c5e559dbefa33267e6dc24a138e5"))
(defn- np-b2-imag [] :vector-i64 (w/from-hex "009713b03af0fed4cd2cafadeed8fdf4a74fa084e52d1852e4a2bd0685c315d2"))
(defn- np-ate [] :vector-i64 (w/from-hex "0000000000000000000000000000000000000000000000019d797039be763ba8"))
(defn- np-prime-exponent [] :vector-i64 (b/from-hex "30644e72e131a029b85045b68181585d97816a916871ca8d3c208c16d87cfd47"))
(defn- np-inverse-exponent [] :vector-i64 (b/from-hex ""))
(defn- np-final-exponent [] :vector-i64 (b/from-hex ""))
(defn- np-g2 [ctx [:ref :evm.native/field] input :vector-i64 offset :i64] :vector-i64
 (let [xi (w/from-bytes input offset 32) xr (w/from-bytes input (+ offset 32) 32)
       yi (w/from-bytes input (+ offset 64) 32) yr (w/from-bytes input (+ offset 96) 32)
       p (f/modulus ctx)]
  (if (or (not (w/less-word xi p)) (not (w/less-word xr p)) (not (w/less-word yi p)) (not (w/less-word yr p))) (vector-i64)
   (if (and (w/zero? xi) (w/zero? xr) (w/zero? yi) (w/zero? yr)) (vector-alloc 96)
    (let [x (b/concat (f/from-word ctx xr) (f/from-word ctx xi))
          y (b/concat (f/from-word ctx yr) (f/from-word ctx yi))
          bb (b/concat (f/from-word ctx (np-b2-real)) (f/from-word ctx (np-b2-imag)))
          valid (b/equal? (e/multiply ctx y y) (e/add ctx (e/multiply ctx (e/multiply ctx x x) x) bb))]
     (if valid (c/point x y (e/one ctx 2)) (vector-i64)))))))
(defn- np-twist-coordinate [ctx [:ref :evm.native/field] a :vector-i64 shift :i64] :vector-i64
 (let [out (vector-alloc 192) real (e/coefficient a 0) imag (e/coefficient a 1)
       z0 (e/put out shift (f/subtract ctx real (f/multiply ctx imag (f/from-word ctx (w/from-long 9)))))
       z1 (e/put out (+ 6 shift) imag)] out))
(defn- np-twist [ctx [:ref :evm.native/field] q :vector-i64] :vector-i64
 (c/point (np-twist-coordinate ctx (c/coordinate q 0) 2)
          (np-twist-coordinate ctx (c/coordinate q 1) 3) (e/one ctx 12)))
(defn- np-cast [ctx [:ref :evm.native/field] p :vector-i64] :vector-i64
 (c/point (e/embed 12 (g1/coordinate p 0)) (e/embed 12 (g1/coordinate p 1)) (e/one ctx 12)))
(defn- np-line-accumulate [ctx [:ref :evm.native/field] num :vector-i64 den :vector-i64 line :vector-i64] :i64
 (let [a (e/multiply-into num ctx num (b/slice line 0 192))
       b (e/multiply-into den ctx den (b/slice line 192 192))] 0))
(defn- np-miller-into [num :vector-i64 den :vector-i64 ctx [:ref :evm.native/field] q :vector-i64 p :vector-i64] :i64
 (arena-scope
  (let [rr (b/slice q 0 576) ate (np-ate)
        done (loop [i 63]
          (if (< i 0) 0
           (let [step (arena-scope
             (let [line (c/line ctx rr rr p)
                   sn (e/multiply-into num ctx num num) sd (e/multiply-into den ctx den den)
                   product (np-line-accumulate ctx num den line) doubled (c/double-into rr ctx rr)
                   added (if (= (w/bit-at ate i) 1)
                           (let [line2 (c/line ctx rr q p) a (np-line-accumulate ctx num den line2)
                                 b (c/add-into rr ctx rr q)] 0) 0)] 0))] (recur (- i 1)))))
        prime (np-prime-exponent)
        q1 (c/point (e/power ctx (c/coordinate q 0) prime) (e/power ctx (c/coordinate q 1) prime) (e/one ctx 12))
        nq2 (c/point (e/power ctx (c/coordinate q1 0) prime) (e/negate ctx (e/power ctx (c/coordinate q1 1) prime)) (e/one ctx 12))
        line1 (c/line ctx rr q1 p) a (np-line-accumulate ctx num den line1)
        next (c/add-into rr ctx rr q1) line2 (c/line ctx rr nq2 p) bb (np-line-accumulate ctx num den line2)] 0)))
(defn execute [input :vector-i64] :vector-i64
 ;; Empty output signals malformed length, invalid coordinate, off-curve or
 ;; non-subgroup G2. Valid pairing results are exactly one 32-byte word.
 (let [out (vector-alloc 32)
       valid (arena-scope
        (if (not (= (rem (vector-count input) 192) 0)) false
         (let [ctx (f/bn-field) num (e/one ctx 12) den (e/one ctx 12)
               ok (loop [offset 0]
                (if (= offset (vector-count input)) true
                 (let [accepted (arena-scope
                   (let [p (g1/from-bytes ctx input offset 3) q (np-g2 ctx input (+ offset 64))]
                    (if (or (= (vector-count p) 0) (= (vector-count q) 0)) false
                     (if (not (c/infinity? (c/multiply ctx q (np-order)))) false
                      (if (or (g1/infinity? p) (c/infinity? q)) true
                       (let [n (e/one ctx 12) d (e/one ctx 12)
                             miller (np-miller-into n d ctx (np-twist ctx q) (np-cast ctx p))
                             combined-n (e/multiply-into num ctx num n)
                             combined-d (e/multiply-into den ctx den d)] true))))))]
                  (if accepted (recur (+ offset 192)) false))))]
          (if (not ok) false
           (let [inverse (e/power ctx den (np-inverse-exponent))
                 reduced (e/power ctx (e/multiply ctx num inverse) (np-final-exponent))
                 result (if (b/equal? reduced (e/one ctx 12)) 1 0)
                 z (vector-assoc! out 31 result)] true)))))]
  (if valid out (vector-i64))))
