;; Homogeneous curve arithmetic (x/z,y/z) over BN128 Fp2 and Fp12.
;; Formula reference: ethereum/py_ecc v8.0.0 optimized_bn128.
(ns kotoba.vm.evm.native-extension-curve
 (:require [kotoba.vm.evm.native-field :as f]
           [kotoba.vm.evm.native-extension :as e]
           [kotoba.vm.evm.native-word :as w]
           [kotoba.vm.evm.native-bytes :as b]))
(defn coordinate [p :vector-i64 i :i64] :vector-i64
 (let [n (quot (vector-count p) 3)] (b/slice p (* i n) n)))
(defn point [x :vector-i64 y :vector-i64 z :vector-i64] :vector-i64 (b/concat (b/concat x y) z))
(defn infinity? [p :vector-i64] :bool (e/zero? (coordinate p 2)))
(defn- ne-write [out :vector-i64 x :vector-i64 y :vector-i64 z :vector-i64] :i64
 (let [n (vector-count x)]
  (loop [i 0] (if (= i n) 0
   (let [a (vector-assoc! out i (vector-at x i)) c (vector-assoc! out (+ i n) (vector-at y i)) d (vector-assoc! out (+ i (* n 2)) (vector-at z i))] (recur (+ i 1)))))))
(defn double-into [out :vector-i64 ctx [:ref :evm.native/field] p :vector-i64] :i64
 (arena-scope
  (let [x (coordinate p 0) y (coordinate p 1) z (coordinate p 2)
        ww (e/scale ctx (e/multiply ctx x x) 3) ss (e/multiply ctx y z)
        bb (e/multiply ctx (e/multiply ctx x y) ss)
        hh (e/subtract ctx (e/multiply ctx ww ww) (e/scale ctx bb 8))
        ss2 (e/multiply ctx ss ss)
        nx (e/scale ctx (e/multiply ctx hh ss) 2)
        ny (e/subtract ctx (e/multiply ctx ww (e/subtract ctx (e/scale ctx bb 4) hh)) (e/scale ctx (e/multiply ctx (e/multiply ctx y y) ss2) 8))
        nz (e/scale ctx (e/multiply ctx ss ss2) 8)] (ne-write out nx ny nz))))
(defn add-into [out :vector-i64 ctx [:ref :evm.native/field] a :vector-i64 b :vector-i64] :i64
 (arena-scope
  (cond (infinity? a) (e/copy-into out b) (infinity? b) (e/copy-into out a)
   :else
   (let [x1 (coordinate a 0) y1 (coordinate a 1) z1 (coordinate a 2)
         x2 (coordinate b 0) y2 (coordinate b 1) z2 (coordinate b 2)
         u1 (e/multiply ctx y2 z1) u2 (e/multiply ctx y1 z2)
         v1 (e/multiply ctx x2 z1) v2 (e/multiply ctx x1 z2)]
    (if (b/equal? v1 v2)
     (if (b/equal? u1 u2) (double-into out ctx a)
      (let [one (e/one ctx (quot (vector-count x1) 16))] (ne-write out one one (vector-alloc (vector-count x1)))))
     (let [u (e/subtract ctx u1 u2) v (e/subtract ctx v1 v2)
           v2s (e/multiply ctx v v) vv2 (e/multiply ctx v2s v2) v3 (e/multiply ctx v v2s)
           ww (e/multiply ctx z1 z2)
           aa (e/subtract ctx (e/subtract ctx (e/multiply ctx (e/multiply ctx u u) ww) v3) (e/scale ctx vv2 2))
           nx (e/multiply ctx v aa) ny (e/subtract ctx (e/multiply ctx u (e/subtract ctx vv2 aa)) (e/multiply ctx v3 u2))
           nz (e/multiply ctx v3 ww)] (ne-write out nx ny nz)))))))
(defn multiply [ctx [:ref :evm.native/field] p :vector-i64 scalar :vector-i64] :vector-i64
 (let [out (vector-alloc (vector-count p))
       done (loop [bit 255] (if (< bit 0) 0
               (let [d (double-into out ctx out)
                     a (if (= (w/bit-at scalar bit) 1) (add-into out ctx out p) 0)] (recur (- bit 1)))))] out))
(defn line [ctx [:ref :evm.native/field] a :vector-i64 bb :vector-i64 t :vector-i64] :vector-i64
 (let [n (quot (vector-count a) 3) out (vector-alloc (* n 2))
       written (arena-scope
        (let [x1 (coordinate a 0) y1 (coordinate a 1) z1 (coordinate a 2)
              x2 (coordinate bb 0) y2 (coordinate bb 1) z2 (coordinate bb 2)
              xt (coordinate t 0) yt (coordinate t 1) zt (coordinate t 2)
              mn0 (e/subtract ctx (e/multiply ctx y2 z1) (e/multiply ctx y1 z2))
              md0 (e/subtract ctx (e/multiply ctx x2 z1) (e/multiply ctx x1 z2))
              tangent (and (e/zero? md0) (e/zero? mn0))
              mn (if tangent (e/scale ctx (e/multiply ctx x1 x1) 3) mn0)
              md (if tangent (e/scale ctx (e/multiply ctx y1 z1) 2) md0)
              dx (e/subtract ctx (e/multiply ctx xt z1) (e/multiply ctx x1 zt))
              num (if (and (e/zero? md0) (not tangent)) dx
                    (e/subtract ctx (e/multiply ctx mn dx) (e/multiply ctx md (e/subtract ctx (e/multiply ctx yt z1) (e/multiply ctx y1 zt)))))
              den (if (and (e/zero? md0) (not tangent)) (e/multiply ctx z1 zt) (e/multiply ctx (e/multiply ctx md zt) z1))]
         (loop [i 0] (if (= i n) 0
          (let [a (vector-assoc! out i (vector-at num i)) b (vector-assoc! out (+ i n) (vector-at den i))] (recur (+ i 1)))))))] out))
