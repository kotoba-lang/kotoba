;; EIP-196 prime-order alt_bn128 G1 operations. Inputs are zero padded and
;; excess bytes ignored exactly as the precompile interface specifies.
(ns kotoba.vm.evm.native-bn128
 (:require [kotoba.vm.evm.native-field :as f]
           [kotoba.vm.evm.native-curve :as c]
           [kotoba.vm.evm.native-word :as w]))
(defn add [input :vector-i64] :vector-i64
 (let [ctx (f/bn-field) a (c/from-bytes ctx input 0 3) b (c/from-bytes ctx input 64 3)]
  (if (or (= (vector-count a) 0) (= (vector-count b) 0)) (vector-i64)
   (c/to-affine ctx (c/add ctx a b)))))
(defn multiply [input :vector-i64] :vector-i64
 (let [ctx (f/bn-field) a (c/from-bytes ctx input 0 3) scalar (w/from-bytes input 64 32)]
  (if (= (vector-count a) 0) (vector-i64)
   (c/to-affine ctx (c/multiply ctx a scalar)))))
