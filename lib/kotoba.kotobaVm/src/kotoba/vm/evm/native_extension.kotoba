;; BN128 extension fields: Fp2 = Fp[u]/(u^2+1),
;; Fp12 = Fp[w]/(w^12-18*w^6+82). Coefficients use native Montgomery Fp.
(ns kotoba.vm.evm.native-extension
 (:require [kotoba.vm.evm.native-field :as f]
           [kotoba.vm.evm.native-word :as w]
           [kotoba.vm.evm.native-bytes :as b]))
(defn coefficient [a :vector-i64 i :i64] :vector-i64 (b/slice a (* i 16) 16))
(defn put [a :vector-i64 i :i64 value :vector-i64] :i64
 (loop [j 0] (if (= j 16) 0 (let [z (vector-assoc! a (+ (* i 16) j) (vector-at value j))] (recur (+ j 1))))))
(defn copy-into [out :vector-i64 a :vector-i64] :i64
 (loop [i 0] (if (= i (vector-count out)) 0 (let [z (vector-assoc! out i (vector-at a i))] (recur (+ i 1))))))
(defn one [ctx [:ref :evm.native/field] degree :i64] :vector-i64
 (let [out (vector-alloc (* degree 16)) z (put out 0 (f/one ctx))] out))
(defn embed [degree :i64 value :vector-i64] :vector-i64
 (let [out (vector-alloc (* degree 16)) z (put out 0 value)] out))
(defn zero? [a :vector-i64] :bool
 (loop [i 0] (if (= i (vector-count a)) true (if (= (vector-at a i) 0) (recur (+ i 1)) false))))
(defn add [ctx [:ref :evm.native/field] a :vector-i64 b :vector-i64] :vector-i64
 (let [out (vector-alloc (vector-count a))
       z (arena-scope (loop [i 0] (if (= (* i 16) (vector-count a)) 0
                       (let [x (put out i (f/add ctx (coefficient a i) (coefficient b i)))] (recur (+ i 1))))))] out))
(defn subtract [ctx [:ref :evm.native/field] a :vector-i64 b :vector-i64] :vector-i64
 (let [out (vector-alloc (vector-count a))
       z (arena-scope (loop [i 0] (if (= (* i 16) (vector-count a)) 0
                       (let [x (put out i (f/subtract ctx (coefficient a i) (coefficient b i)))] (recur (+ i 1))))))] out))
(defn negate [ctx [:ref :evm.native/field] a :vector-i64] :vector-i64
 (subtract ctx (vector-alloc (vector-count a)) a))
(defn- ne-small [ctx [:ref :evm.native/field] a :vector-i64 amount :i64] :vector-i64
 (loop [n amount power a acc (w/zero-word)]
  (if (= n 0) acc
   (recur (quot n 2) (f/add ctx power power) (if (= (rem n 2) 1) (f/add ctx acc power) acc)))))
(defn scale [ctx [:ref :evm.native/field] a :vector-i64 amount :i64] :vector-i64
 (let [out (vector-alloc (vector-count a))
       z (arena-scope (let [scalar amount]
                       (loop [i 0] (if (= (* i 16) (vector-count a)) 0
                         (let [x (put out i (ne-small ctx (coefficient a i) scalar))] (recur (+ i 1)))))))] out))
(defn multiply-into [out :vector-i64 ctx [:ref :evm.native/field] a :vector-i64 b :vector-i64] :i64
 (arena-scope
  (let [degree (quot (vector-count a) 16) acc (vector-alloc (* (- (* 2 degree) 1) 16))
        convolved (loop [i 0] (if (= i degree) 0
                    (let [done (loop [j 0] (if (= j degree) 0
                       (let [z (arena-scope
                                 (let [x (coefficient a i) y (coefficient b j)]
                                  (if (or (w/zero? x) (w/zero? y)) 0
                                   (put acc (+ i j) (f/add ctx (coefficient acc (+ i j)) (f/multiply ctx x y))))))]
                        (recur (+ j 1)))))] (recur (+ i 1)))))
        reduced (loop [i (- (* 2 degree) 2)]
                  (if (< i degree) 0
                   (let [z (arena-scope
                             (let [x (coefficient acc i)]
                              (if (= degree 2) (put acc (- i 2) (f/subtract ctx (coefficient acc (- i 2)) x))
                               (let [a (put acc (- i 6) (f/add ctx (coefficient acc (- i 6)) (ne-small ctx x 18)))
                                     b (put acc (- i 12) (f/subtract ctx (coefficient acc (- i 12)) (ne-small ctx x 82)))] 0))))] (recur (- i 1)))))
        written (loop [i 0] (if (= i degree) 0 (let [z (put out i (coefficient acc i))] (recur (+ i 1)))))] 0)))
(defn multiply [ctx [:ref :evm.native/field] a :vector-i64 b :vector-i64] :vector-i64
 (let [out (vector-alloc (vector-count a)) z (multiply-into out ctx a b)] out))
(defn power [ctx [:ref :evm.native/field] a :vector-i64 exponent :vector-i64] :vector-i64
 ;; Exponent is big-endian bytes (not a 256-bit-limited EVM word).
 (let [out (one ctx (quot (vector-count a) 16))
       done (loop [i 0 started false]
              (if (= i (* 8 (vector-count exponent))) 0
               (let [bit (bit-and (i64-shift-right (vector-at exponent (quot i 8)) (- 7 (rem i 8))) 1)
                     s (if started (multiply-into out ctx out out) 0)
                     p (if (= bit 1) (multiply-into out ctx out a) 0)]
                (recur (+ i 1) (or started (= bit 1))))))] out))
