(ns kotoba.vm.kototama.program
  "Wire-format boundary for this engine's register-machine guest profile.

  This decoder accepts a profile-specific DAG-CBOR array envelope and lowers
  its method table into the existing kernel's data-only instruction interface.
  It intentionally rejects instructions the current partial core profile
  cannot execute; it never evaluates source or loads a host function.")

(def program-tag "kotoba.vm/register-guest")
(def program-version 1)
(def canonical-program-tag "kototama.vm/program")
(def canonical-program-version 1)

(def supported-instructions
  #{"self" "args" "method" "caller" "address"
    "const" "empty" "open" "node" "get" "put" "inc" "add"
    "nth" "write-node" "set-state" "call" "return" "halt"})

(def instruction-arity
  {"self" 2 "args" 2 "method" 2 "caller" 2 "address" 2
   "const" 3 "empty" 2 "open" 3 "node" 3 "get" 4 "put" 5
   "inc" 3 "add" 4 "nth" 4 "write-node" 3 "set-state" 2
   "call" 5 "return" 2 "halt" 1})

(defn- invalid! [message data]
  (throw (ex-info message (merge {:type :kototama.vm/invalid-program} data))))

(defn- validate-methods [methods]
  (when-not (map? methods)
    (invalid! "Kototama program method table must be a map" {}))
  (doseq [[method instructions] methods]
    (when-not (and (string? method) (vector? instructions))
      (invalid! "Kototama methods must map text names to instruction vectors"
                {:method method}))
    (doseq [[index instruction] (map-indexed vector instructions)]
      (when-not (and (vector? instruction)
                     (string? (first instruction))
                     (contains? supported-instructions (first instruction))
                     (= (instruction-arity (first instruction))
                        (count instruction)))
        (invalid! "Kototama instruction is not implemented by this VM profile"
                  {:method method :instruction-index index
                   :instruction instruction}))))
  methods)

(def ^:private expressions
  #{"const" "var" "let" "loop" "recur" "if" "do" "call" "effect"
    "arith" "compare" "vector" "list" "map" "set" "get" "assoc" "dissoc"})

(defn- validate-expression! [form]
  (when-not (and (vector? form) (string? (first form))
                 (contains? expressions (first form)))
    (invalid! "Canonical Kototama expression is not implemented by core/i64-v1"
              {:expression form}))
  (let [[tag a b c] form]
    (case tag
      "const" (when-not (= 2 (count form)) (invalid! "Malformed const expression" {}))
      "var" (when-not (and (= 2 (count form)) (string? a))
              (invalid! "Malformed variable expression" {}))
      ("let" "loop")
      (do
        (when-not (and (= 3 (count form)) (vector? a)
                       (every? #(and (vector? %) (= 2 (count %)) (string? (first %))) a))
          (invalid! "Malformed binding expression" {:tag tag}))
        (doseq [[_ value] a] (validate-expression! value))
        (validate-expression! b))
      "if" (do (when-not (= 4 (count form)) (invalid! "Malformed if expression" {}))
               (doseq [child [a b c]] (validate-expression! child)))
      ("get" "dissoc")
      (do (when-not (= 3 (count form)) (invalid! "Malformed collection expression" {:tag tag}))
          (validate-expression! a) (validate-expression! b))
      "assoc" (do (when-not (= 4 (count form)) (invalid! "Malformed assoc expression" {}))
                  (doseq [child [a b c]] (validate-expression! child)))
      ("call" "arith" "compare")
      (do (when-not (and (= 3 (count form)) (string? a) (vector? b))
            (invalid! "Malformed call or operation expression" {:tag tag}))
          (when (and (= tag "arith") (not (contains? #{"add" "sub" "mul" "div" "quot" "mod"} a)))
            (invalid! "Unknown arithmetic operation" {:op a}))
          (when (and (= tag "compare") (not (contains? #{"=" "<" ">" "<=" ">="} a)))
            (invalid! "Unknown comparison operation" {:op a}))
          (doseq [child b] (validate-expression! child)))
      "effect"
      (do
        (when-not (and (= 3 (count form)) (string? a) (vector? b))
          (invalid! "Malformed effect expression" {}))
        (doseq [child b] (validate-expression! child)))
      (do
        (when-not (and (= 2 (count form)) (vector? a))
          (invalid! "Malformed expression vector" {:tag tag}))
        (if (= tag "map")
          (doseq [pair a]
            (when-not (and (vector? pair) (= 2 (count pair)))
              (invalid! "Malformed map expression pair" {}))
            (doseq [child pair] (validate-expression! child)))
          (doseq [child a] (validate-expression! child)))))))

(defn decode
  "Return a kernel-compatible guest map for this engine's register profile.

  Wire form: [\"kotoba.vm/register-guest\" 1 {method [instruction ...]}].
  The vector and all nested values are encoded as canonical DAG-CBOR."
  [node]
  (when-not (and (vector? node)
                 (= 3 (count node))
                 (= program-tag (nth node 0))
                 (= program-version (nth node 1)))
    (invalid! "Block is not a Kototama program/v1 envelope" {}))
  {"kotoba.vm/guest" 1
   "methods" (validate-methods (nth node 2))})

(defn decode-canonical
  "Validate Amu's engine-neutral `kototama.vm/program` envelope without
  translating it into this VM's distinct register-guest instruction set.

  `kotoba.i64-wrap/v1` is the original scalar profile. The additive
  `kototama.data-i64/v1` profile keeps bounded i64 arithmetic while allowing
  canonical nil, booleans, text, vectors, and maps as values."
  [node]
  (when-not (and (vector? node) (= 3 (count node))
                 (= canonical-program-tag (nth node 0))
                 (= canonical-program-version (nth node 1)))
    (invalid! "Block is not a canonical Kototama program/v1 envelope" {}))
  (let [program (nth node 2)
        methods (get program "methods")]
    (when-not (and (map? program)
                   (or (nil? (get program "entry"))
                       (string? (get program "entry")))
                   (contains? #{"kotoba.i64-wrap/v1" "kototama.data-i64/v1"}
                              (get program "value-profile"))
                   (map? methods))
      (invalid! "Canonical Kototama program header is invalid" {}))
    (let [exports (if (contains? program "exports")
                    (get program "exports")
                    (vec (keys methods)))]
      (when-not (and (vector? exports)
                     (every? string? exports)
                     (= (count exports) (count (set exports)))
                     (every? #(contains? methods %) exports)
                     (or (nil? (get program "entry"))
                         (some #{(get program "entry")} exports)))
        (invalid! "Canonical Kototama export list is invalid"
                  {:exports exports :entry (get program "entry")}))
      (doseq [[name method] methods]
      (when-not (and (string? name) (map? method)
                     (vector? (get method "params"))
                     (every? string? (get method "params"))
                     (vector? (get method "param-types"))
                     (= (count (get method "params"))
                        (count (get method "param-types")))
                     (every? (if (= "kotoba.i64-wrap/v1" (get program "value-profile"))
                               #{"i64"} #{"value"})
                             (get method "param-types"))
                     (= (if (= "kotoba.i64-wrap/v1" (get program "value-profile"))
                          "i64" "value")
                        (get method "result"))
                     (vector? (get method "effects"))
                     (every? vector? (get method "effects"))
                     (vector? (get method "body")))
          (invalid! "Canonical Kototama method is unsupported by this VM profile"
                    {:method name}))
        (validate-expression! (get method "body")))
      {"kototama.vm/program" 1
       "entry" (get program "entry")
       "exports" exports
       "value-profile" (get program "value-profile")
       "methods" methods})))
