(ns extract-vectors
  "Turn the MLS interop corpus into `test/mls/vectors.cljk`.

  These are the working group's own vectors, from
  `mlswg/mls-implementations` — the corpus every MLS implementation is
  expected to agree with. Unlike ECH and ODoH, this is not one vendor's
  reference output.

  Both files are pinned by sha256 and emitted whole.

      for f in tree-math crypto-basics; do
        curl -sSo mls-$f.json \\
          https://raw.githubusercontent.com/mlswg/mls-implementations/main/test-vectors/$f.json
      done
      kbb --backend sci scripts/extract_vectors.cljk mls-tree-math.json mls-crypto-basics.json"
  (:require ["fs" :as fs] ["crypto" :as crypto] [kotoba.lang.text :as str]))

(def sources
  {"tree-math" "27f04891f56106593b74b674445f01b845e173953770c084deb2f8cf5592e2fc"
   "crypto-basics" "17cfcf89af9f51d0f2aa7af77f6f9ec99376a039214b6d42a6f11646b83e8c29"
   "key-schedule" "05aa9a68bd2538ace72d8c53375984cc728ef62220ebf314df675708546d97a7"
   "secret-tree" "08f92e6272452e2c832e32d38e16cf0c4aa28967e47d3842c60bc354c6b67a94"
   "transcript-hashes" "58046b58fbd98519b4e60953a105f550e4b427e2b140ea67dedcb751260eecb8"
   "psk-secret" "2b534969dba0b65a04b7d790496af5c0ccdb472b3fc4ca25c8c82df3e8523784"
   "message-protection" "f7c1ae62ce63c3003e526d539c99f2b1444f65ee0a487d3a5667d46867526c45"})

(defn- sha256-hex [s] (-> (crypto/createHash "sha256") (.update s "utf8") (.digest "hex")))

(defn- load-pinned [path name-]
  (let [text (str (fs/readFileSync path "utf8"))]
    (when (not= (get sources name-) (sha256-hex text))
      (println "REFUSING:" name- "sha256 mismatch")
      (println "  expected" (get sources name-))
      (println "  got     " (sha256-hex text))
      (js/process.exit 2))
    (js->clj (js/JSON.parse text) :keywordize-keys true)))

(defn -main [& args]
  (when (not= 7 (count args))
    (println "usage: kbb --backend sci scripts/extract_vectors.cljk <tree-math> <crypto-basics> <key-schedule> <secret-tree> <transcript-hashes> <psk_secret> <message-protection>")
    (js/process.exit 2))
  (let [[tm-path cb-path ks-path st-path th-path psk-path mp-path] args
        tm (load-pinned tm-path "tree-math")
        cb (load-pinned cb-path "crypto-basics")
        ks (load-pinned ks-path "key-schedule")
        st (load-pinned st-path "secret-tree")
        th (load-pinned th-path "transcript-hashes")
        psk (load-pinned psk-path "psk-secret")
        mp (load-pinned mp-path "message-protection")
        tree (vec (for [e tm]
                    {:n-leaves (:n_leaves e) :n-nodes (:n_nodes e) :root (:root e)
                     :left (vec (:left e)) :right (vec (:right e))
                     :parent (vec (:parent e)) :sibling (vec (:sibling e))}))
        crypto- (vec (for [e cb]
                       {:cipher-suite (:cipher_suite e)
                        :ref-hash (:ref_hash e)
                        :expand-with-label (:expand_with_label e)
                        :derive-secret (:derive_secret e)
                        :derive-tree-secret (:derive_tree_secret e)
                        :encrypt-with-label (:encrypt_with_label e)
                        ;; sign_with_label is carried but not used -- see the
                        ;; README. Keeping it makes the gap visible in the
                        ;; fixture rather than only in prose.
                        :sign-with-label (:sign_with_label e)}))]
    (println "tree-math" (count tree) "trees, leaves"
             (pr-str (mapv :n-leaves tree)))
    (println "crypto-basics" (count crypto-) "suites"
             (pr-str (mapv :cipher-suite crypto-)))
    (println "key-schedule" (count ks) "suites,"
             (reduce + (map #(count (:epochs %)) ks)) "epochs")
    (println "secret-tree" (count st) "trees, leaves"
             (pr-str (vec (sort (distinct (map #(count (:leaves %)) st))))))
    (println "transcript-hashes" (count th) "suites")
    (println "message-protection" (count mp) "suites")
    (println "psk-secret" (count psk) "entries, psk counts"
             (pr-str (vec (sort (distinct (map #(count (:psks %)) psk))))))
    (let [out (str ";; GENERATED by scripts/extract_vectors.cljk — do not edit.\n;;\n"
                   ";; The MLS working group's interop corpus, complete.\n"
                   ";;   tree-math      " (count tree) " trees, 1 to "
                   (apply max (map :n-leaves tree)) " leaves\n"
                   ";;   crypto-basics  " (count crypto-) " cipher suites\n"
                   ";;   key-schedule   " (count ks) " suites, "
                   (reduce + (map #(count (:epochs %)) ks)) " epochs\n"
                   ";;   secret-tree    " (count st) " trees, "
                   (reduce + (map #(count (:leaves %)) st)) " leaves\n"
                   ";;   transcript     " (count th) " suites\n"
                   ";;   psk-secret     " (count psk) " entries, 0 to "
                   (apply max (map #(count (:psks %)) psk)) " PSKs each\n"
                   ";;   message-protection  " (count mp) " suites\n;;\n"
                   ";; Source:  https://github.com/mlswg/mls-implementations/tree/main/test-vectors\n"
                   ";; sha256:  tree-math      " (get sources "tree-math") "\n"
                   ";;          crypto-basics  " (get sources "crypto-basics") "\n"
                   ";;          key-schedule   " (get sources "key-schedule") "\n"
                   ";;          secret-tree    " (get sources "secret-tree") "\n"
                   ";;          transcript     " (get sources "transcript-hashes") "\n"
                   ";;          psk-secret     " (get sources "psk-secret") "\n"
                   ";;          message-protection  " (get sources "message-protection") "\n"
                   "(ns mls.vectors)\n\n"
                   "(def tree-math\n  [" (str/join "\n   " (map pr-str tree)) "])\n\n"
                   "(def crypto-basics\n  [" (str/join "\n\n   " (map pr-str crypto-)) "])\n\n"
                   "(def key-schedule\n  ["
                   (str/join "\n\n   "
                             (map (fn [e]
                                    (pr-str {:cipher-suite (:cipher_suite e)
                                             :group-id (:group_id e)
                                             :initial-init-secret (:initial_init_secret e)
                                             :epochs (vec (for [ep (:epochs e)]
                                                            {:commit-secret (:commit_secret ep)
                                                             :psk-secret (:psk_secret ep)
                                                             :confirmed-transcript-hash (:confirmed_transcript_hash ep)
                                                             :tree-hash (:tree_hash ep)
                                                             :group-context (:group_context ep)
                                                             :joiner-secret (:joiner_secret ep)
                                                             :welcome-secret (:welcome_secret ep)
                                                             :init-secret (:init_secret ep)
                                                             :sender-data-secret (:sender_data_secret ep)
                                                             :encryption-secret (:encryption_secret ep)
                                                             :exporter-secret (:exporter_secret ep)
                                                             :external-secret (:external_secret ep)
                                                             :external-pub (:external_pub ep)
                                                             :confirmation-key (:confirmation_key ep)
                                                             :membership-key (:membership_key ep)
                                                             :resumption-psk (:resumption_psk ep)
                                                             :epoch-authenticator (:epoch_authenticator ep)
                                                             :exporter (:exporter ep)}))}))
                                  ks))
                   "])\n\n"
                   "(def secret-tree\n  ["
                   (str/join "\n\n   "
                             (map (fn [e]
                                    (pr-str {:cipher-suite (:cipher_suite e)
                                             :encryption-secret (:encryption_secret e)
                                             :sender-data (:sender_data e)
                                             :leaves (vec (for [leaf (:leaves e)]
                                                            (vec (for [g leaf]
                                                                   {:generation (:generation g)
                                                                    :application-key (:application_key g)
                                                                    :application-nonce (:application_nonce g)
                                                                    :handshake-key (:handshake_key g)
                                                                    :handshake-nonce (:handshake_nonce g)}))))}))
                                  st))
                   "])\n\n"
                   "(def transcript-hashes\n  ["
                   (str/join "\n\n   "
                             (map (fn [e]
                                    (pr-str {:cipher-suite (:cipher_suite e)
                                             :confirmation-key (:confirmation_key e)
                                             :authenticated-content (:authenticated_content e)
                                             :interim-before (:interim_transcript_hash_before e)
                                             :confirmed-after (:confirmed_transcript_hash_after e)
                                             :interim-after (:interim_transcript_hash_after e)}))
                                  th))
                   "])\n\n"
                   "(def psk-secret\n  ["
                   (str/join "\n\n   "
                             (map (fn [e]
                                    (pr-str {:cipher-suite (:cipher_suite e)
                                             :psks (vec (for [x (:psks e)]
                                                          {:psk-id (:psk_id x)
                                                           :psk (:psk x)
                                                           :psk-nonce (:psk_nonce x)}))
                                             :psk-secret (:psk_secret e)}))
                                  psk))
                   "])\n\n"
                   "(def message-protection\n  ["
                   (str/join "\n\n   "
                             (map (fn [e]
                                    (pr-str (into {} (map (fn [[k x]]
                                                            [(keyword (str/replace (name k) "_" "-")) x])
                                                          e))))
                                  mp))
                   "])\n")]
      (fs/mkdirSync "test/mls" #js {:recursive true})
      (fs/writeFileSync "test/mls/vectors.cljk" out)
      (println "wrote test/mls/vectors.cljk" (count out) "bytes"))))

(apply -main *command-line-args*)
