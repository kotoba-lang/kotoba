#!/usr/bin/env kbb
;; Run the suite on the ClojureScript side.
;;
;; Not a formality: MLS's tree math is bit arithmetic on node indices and its
;; labelled KDF is byte assembly, and both are places the two runtimes differ.
;; Everything underneath -- HPKE, the curves, the hashes -- runs on both.
;;
;;   kbb --backend sci --classpath "$(kbb -A:cljs -Spath)" scripts/verify-cljs.cljk
(ns verify-cljs
  (:require [kotoba.test :as t]
            [mls.tree-test]
            [mls.crypto-test]
            [mls.varint-test]
            [mls.key-schedule-test]
            [mls.secret-tree-test]
            [mls.psk-transcript-test]
            [mls.message-test]
            [mls.node-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println)
  (cond
    (zero? (+ (:pass m) (:fail m) (:error m)))
    (do (println "REFUSING: the runner executed no assertions") (js/process.exit 2))
    (t/successful? m) (println "all checks passed on the ClojureScript path")
    :else (do (println "FAILED on the ClojureScript path") (js/process.exit 1))))

(t/run-tests 'mls.tree-test 'mls.crypto-test 'mls.varint-test 'mls.key-schedule-test 'mls.secret-tree-test 'mls.psk-transcript-test 'mls.message-test 'mls.node-test)
