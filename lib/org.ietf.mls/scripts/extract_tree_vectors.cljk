(ns extract-tree-vectors
  "Turn three more of the MLS interop corpora into fixtures.

  `messages` is a **codec** corpus: 300 entries, each a set of structs
  serialised by another implementation with random field values. Nothing in
  it is cryptographically valid, and it is not meant to be — decoding those
  bytes and re-encoding to *the same bytes* is agreement with another
  implementation about the wire format, which is exactly the question the
  ratchet tree's node encodings raise.

  `tree-validation` is the semantic half: real trees, with the tree hash of
  every node and the resolution of every node computed by that same
  implementation.

  `tree-operations` applies one proposal to a tree and gives the tree hash on
  both sides of it.

  All three are pinned by sha256 and emitted whole.

      for f in messages tree-validation tree-operations; do
        curl -sSo mls-$f.json \\
          https://raw.githubusercontent.com/mlswg/mls-implementations/main/test-vectors/$f.json
      done
      kbb --backend sci scripts/extract_tree_vectors.cljk mls-messages.json mls-tree-validation.json mls-tree-operations.json"
  (:require ["fs" :as fs] ["crypto" :as crypto] [kotoba.lang.text :as str]))

(def sources
  {"messages" "b194abe1561995223482dbad51c180146920dc2f637e74d01e07a388308791fb"
   "tree-validation" "b66a432d93b520623f0640835ed43b9dfc95e116b8be081d81581d7c11e67a37"
   "tree-operations" "9a25f8720714d1256ba2dad8d83a660ba0bae0d33ed15c682b9d74a5d67aad0a"})

(defn- sha256-hex [s] (-> (crypto/createHash "sha256") (.update s "utf8") (.digest "hex")))

(defn- load-pinned [path name-]
  (let [text (str (fs/readFileSync path "utf8"))]
    (when (not= (get sources name-) (sha256-hex text))
      (println "REFUSING:" name- "sha256 mismatch")
      (println "  expected" (get sources name-))
      (println "  got     " (sha256-hex text))
      (js/process.exit 2))
    (js->clj (js/JSON.parse text) :keywordize-keys true)))

(defn- kebab [m]
  (into {} (map (fn [[k v]] [(keyword (str/replace (name k) "_" "-")) v])) m))

(defn -main [& args]
  (when (not= 3 (count args))
    (println "usage: kbb --backend sci scripts/extract_tree_vectors.cljk <messages> <tree-validation> <tree-operations>")
    (js/process.exit 2))
  (let [[m-path tv-path to-path] args
        msgs (mapv kebab (load-pinned m-path "messages"))
        tv (vec (for [e (load-pinned tv-path "tree-validation")]
                  {:cipher-suite (:cipher_suite e)
                   :tree (:tree e)
                   :group-id (:group_id e)
                   :tree-hashes (vec (:tree_hashes e))
                   :resolutions (mapv vec (:resolutions e))}))
        to (vec (for [e (load-pinned to-path "tree-operations")]
                  {:cipher-suite (:cipher_suite e)
                   :proposal (:proposal e)
                   :proposal-sender (:proposal_sender e)
                   :tree-before (:tree_before e)
                   :tree-after (:tree_after e)
                   :tree-hash-before (:tree_hash_before e)
                   :tree-hash-after (:tree_hash_after e)}))]
    ;; Refuse to write a fixture whose entries do not all carry the same
    ;; fields. A corpus that lost a struct between releases would otherwise
    ;; produce a smaller fixture that still passes every test written against
    ;; the fields that remain.
    (let [ks (set (keys (first msgs)))]
      (when-not (every? #(= ks (set (keys %))) msgs)
        (println "REFUSING: messages entries do not all carry the same fields")
        (js/process.exit 2))
      (println "messages" (count msgs) "entries," (count ks) "structs each"))
    (println "tree-validation" (count tv) "trees, suites"
             (pr-str (vec (sort (distinct (map :cipher-suite tv)))))
             "nodes" (pr-str (vec (sort (distinct (map #(count (:tree-hashes %)) tv))))))
    (println "tree-operations" (count to) "operations")
    (let [out (str ";; GENERATED by scripts/extract_tree_vectors.cljk — do not edit.\n;;\n"
                   ";; Three more of the MLS working group's interop corpora.\n"
                   ";;   messages         " (count msgs) " entries, "
                   (count (keys (first msgs))) " structs each -- a CODEC corpus.\n"
                   ";;                    The field values are random and none of it is\n"
                   ";;                    cryptographically valid. Decoding another\n"
                   ";;                    implementation's bytes and re-encoding to the\n"
                   ";;                    same bytes is the whole of what it proves.\n"
                   ";;   tree-validation  " (count tv) " trees, "
                   (apply max (map #(count (:tree-hashes %)) tv))
                   " nodes at the largest, all 7 suites\n"
                   ";;   tree-operations  " (count to) " operations\n;;\n"
                   ";; Source:  https://github.com/mlswg/mls-implementations/tree/main/test-vectors\n"
                   ";; sha256:  messages         " (get sources "messages") "\n"
                   ";;          tree-validation  " (get sources "tree-validation") "\n"
                   ";;          tree-operations  " (get sources "tree-operations") "\n"
                   "(ns mls.tree-vectors)\n\n"
                   "(def messages\n  [" (str/join "\n\n   " (map pr-str msgs)) "])\n\n"
                   "(def tree-validation\n  [" (str/join "\n\n   " (map pr-str tv)) "])\n\n"
                   "(def tree-operations\n  [" (str/join "\n\n   " (map pr-str to)) "])\n")]
      (fs/mkdirSync "test/mls" #js {:recursive true})
      (fs/writeFileSync "test/mls/tree_vectors.cljk" out)
      (println "wrote test/mls/tree_vectors.cljk" (count out) "bytes"))))

(apply -main *command-line-args*)
