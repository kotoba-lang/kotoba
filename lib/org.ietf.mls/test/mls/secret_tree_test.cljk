(ns mls.secret-tree-test
  "The secret tree against the working group's corpus: 21 trees (7 suites × 1,
  8 and 32 leaves), every leaf, both ratchets, generations 0 and 15.

  **Generation 15 is the useful one.** A ratchet is a hash chain, so reaching
  it means fifteen derivations — an implementation that used the generation as
  a direct input instead of advancing would agree at generation 0 and diverge
  everywhere after, and generation 0 alone is what a corpus without a second
  entry would check."
  (:require [kotoba.test :refer [deftest is testing]]
            [mls.crypto :as crypto]
            [mls.result :as r]
            [mls.secret-tree :as st]
            [mls.suite :as suite]
            [mls.tree :as tree]
            [mls.vectors :as vec-]))

(defn- unhex [s]
  (mapv #(#?(:clj Integer/parseInt :cljs js/parseInt) (apply str %) 16) (partition 2 s)))

(defn- hex [bs]
  (apply str (map (fn [b] (let [b (bit-and (int b) 0xFF)
                                s #?(:clj (Integer/toString b 16) :cljs (.toString b 16))]
                            (if (= 1 (count s)) (str "0" s) s)))
                  bs)))

(deftest the-corpus-is-whole
  (is (= 21 (count vec-/secret-tree)))
  (is (= [1 8 32] (vec (sort (distinct (map #(count (:leaves %)) vec-/secret-tree))))))
  (is (= #{1 2 3 4 5 6 7} (set (map :cipher-suite vec-/secret-tree))))
  (testing "and it carries a generation past zero, which is the point"
    (is (= #{0 15} (set (for [e vec-/secret-tree, leaf (:leaves e), g leaf]
                          (:generation g)))))))

(deftest every-leaf-of-every-tree
  (doseq [{:keys [cipher-suite encryption-secret leaves]} vec-/secret-tree]
    (let [s (get suite/suites cipher-suite)
          es (unhex encryption-secret)
          n (count leaves)]
      (testing (str "suite " cipher-suite ", " n " leaves")
        (doseq [[i leaf] (map-indexed vector leaves)
                g leaf]
          (let [gen (:generation g)
                app (st/leaf-keys s es n i :application gen)
                hs (st/leaf-keys s es n i :handshake gen)]
            (is (r/ok? app) (str "leaf " i " gen " gen " " (pr-str (r/err app))))
            (is (r/ok? hs) (str "leaf " i " gen " gen))
            (is (= (:application-key g) (hex (:mls/key (r/val app))))
                (str "leaf " i " gen " gen " application key"))
            (is (= (:application-nonce g) (hex (:mls/nonce (r/val app))))
                (str "leaf " i " gen " gen " application nonce"))
            (is (= (:handshake-key g) (hex (:mls/key (r/val hs))))
                (str "leaf " i " gen " gen " handshake key"))
            (is (= (:handshake-nonce g) (hex (:mls/nonce (r/val hs))))
                (str "leaf " i " gen " gen " handshake nonce"))))))))

(deftest sender-data-keys-are-bound-to-their-ciphertext
  (doseq [{:keys [cipher-suite sender-data]} vec-/secret-tree]
    (let [s (get suite/suites cipher-suite)
          {:keys [sender_data_secret ciphertext key nonce]} sender-data
          got (st/sender-data-keys s (unhex sender_data_secret) (unhex ciphertext))]
      (testing (str "suite " cipher-suite)
        (is (r/ok? got))
        (is (= key (hex (:mls/key (r/val got)))))
        (is (= nonce (hex (:mls/nonce (r/val got)))))
        (testing "and a different ciphertext gives different keys"
          (let [ct (unhex ciphertext)
                other (st/sender-data-keys s (unhex sender_data_secret)
                                           (assoc (vec ct) 0 (bit-xor 1 (first ct))))]
            (is (not= (:mls/key (r/val got)) (:mls/key (r/val other))))))))))

(deftest a-short-ciphertext-is-sampled-whole
  ;; §6.3.2: the sample is the first KDF.Nh bytes, or the whole ciphertext if
  ;; it is shorter. A message shorter than Nh is ordinary, not an edge case,
  ;; and an implementation that indexed past the end would fail on exactly
  ;; those.
  (doseq [id [1 4]]
    (let [s (get suite/suites id)
          secret (vec (repeat (:nh s) 3))
          short- (vec (range 5))
          got (st/sender-data-keys s secret short-)]
      (is (r/ok? got))
      (is (= short- (:mls/sample (r/val got))) "the whole thing, not padded")
      (is (= (:nk s) (count (:mls/key (r/val got)))))
      (testing "and a full-length one is truncated to Nh"
        (let [long- (vec (range (* 2 (:nh s))))
              g2 (st/sender-data-keys s secret long-)]
          (is (= (:nh s) (count (:mls/sample (r/val g2)))))
          (is (= (vec (take (:nh s) long-)) (:mls/sample (r/val g2)))))))))

;; ── the shape of the thing ──────────────────────────────────────────────────

(deftest the-two-ratchets-are-separate
  ;; Sharing one ratchet between handshake and application messages would let
  ;; the two consume each other's single-use pairs.
  (let [s (get suite/suites 1)
        es (vec (repeat 32 7))
        leaf (r/val (st/leaf-secret s es 8 3))
        h (r/val (st/ratchet-root s leaf :handshake))
        a (r/val (st/ratchet-root s leaf :application))]
    (is (not= h a))
    (is (= :unknown-ratchet-kind (r/reason (st/ratchet-root s leaf :other))))))

(deftest siblings-differ-and-the-path-is-what-decides
  ;; The children of a node are distinguished by the CONTEXT (left/right), not
  ;; the label -- both are derived with label "tree". Swapping the two roles
  ;; would make siblings equal, and every member of the group would hold every
  ;; other member's keys.
  (let [s (get suite/suites 1)
        es (vec (repeat 32 5))
        secrets (for [i (range 8)] (r/val (st/leaf-secret s es 8 i)))]
    (is (= 8 (count (distinct secrets))) "eight leaves, eight distinct secrets")
    (testing "and a leaf's secret depends on the size of the tree it is in"
      (is (not= (r/val (st/leaf-secret s es 8 0))
                (r/val (st/leaf-secret s es 32 0)))
          "leaf 0 of an 8-leaf tree is not leaf 0 of a 32-leaf tree"))
    (testing "the one-leaf tree's leaf is the root itself"
      (is (= es (r/val (st/leaf-secret s es 1 0)))
          "no derivation at all, because there is no path"))))

(deftest a-leaf-outside-the-tree-is-refused
  (let [s (get suite/suites 1) es (vec (repeat 32 1))]
    (is (= :leaf-out-of-range (r/reason (st/leaf-secret s es 8 8))))
    (is (= :leaf-out-of-range (r/reason (st/leaf-secret s es 8 -1))))
    (is (r/ok? (st/leaf-secret s es 8 7)))))

(deftest the-ratchet-cannot-be-jumped
  ;; Each generation's secret comes from the previous one. Deriving generation
  ;; 15 directly from the root -- using the generation only as the context --
  ;; gives a different answer, which is what makes an earlier key
  ;; unrecoverable from a later one.
  (let [s (get suite/suites 1)
        root (vec (repeat 32 9))
        proper (r/val (st/ratchet-at s root 15))
        shortcut (r/val (st/ratchet-step s root 15))]
    (is (not= (:mls/key proper) (:mls/key shortcut)))
    (testing "and each step differs from the one before"
      (let [keys- (for [g (range 6)] (:mls/key (r/val (st/ratchet-at s root g))))]
        (is (= 6 (count (distinct keys-))))))))
