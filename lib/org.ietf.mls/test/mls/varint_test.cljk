(ns mls.varint-test
  "RFC 9420 §2.1.2, including the rule that separates it from QUIC's.

  MLS **requires** the smallest encoding and says a decoder MUST reject a
  longer one. That is the whole difference from RFC 9000 §16, and it exists
  because these lengths prefix values that get hashed: two encodings of one
  length would be two byte strings for one object, and therefore two
  `KeyPackageRef`s for one KeyPackage."
  (:require [kotoba.test :refer [deftest is testing]]
            [mls.result :as r]
            [mls.varint :as v]))

(deftest the-three-widths-and-their-boundaries
  ;; RFC 9420 Table 1: 6, 14 and 30 usable bits.
  (doseq [[n width] {0 1, 1 1, 63 1, 64 2, 16383 2, 16384 4, 1073741823 4}]
    (is (= width (count (r/val (v/encode n)))) (str n)))
  (testing "and one past the top is refused rather than truncated"
    (is (r/error? (v/encode 1073741824)))
    (is (= :varint-too-large (r/reason (v/encode 1073741824))))
    (is (= :bad-varint (r/reason (v/encode -1))))))

(deftest every-value-round-trips
  (doseq [n (concat (range 0 300) [16382 16383 16384 16385 65535 1000000 1073741823])]
    (let [e (r/val (v/encode n))
          d (v/decode e 0)]
      (is (r/ok? d) (str n))
      (is (= n (:mls/value (r/val d))) (str n))
      (is (= (count e) (:mls/next (r/val d))) (str n)))))

(deftest a-longer-encoding-of-the-same-value-is-malformed
  ;; The rule with teeth. 1 fits in one byte; these are the same 1 written in
  ;; two and four, which QUIC accepts and MLS does not.
  (is (= :non-minimal-varint (r/reason (v/decode [0x40 0x01] 0))))
  (is (= :non-minimal-varint (r/reason (v/decode [0x80 0x00 0x00 0x01] 0))))
  (is (= :non-minimal-varint (r/reason (v/decode [0x80 0x00 0x3F 0xFF] 0)))
      "16383 fits in two bytes, so four is malformed")
  (is (= :non-minimal-varint (r/reason (v/decode [0x40 0x00] 0)))
      "and 0 fits in one")
  (testing "while the minimal forms are fine"
    (is (r/ok? (v/decode [0x01] 0)))
    (is (r/ok? (v/decode [0x40 0x40] 0)))
    (is (r/ok? (v/decode [0x80 0x00 0x40 0x00] 0)) ":= 16384, which needs four")))

(deftest the-reserved-prefix-and-truncation-are-different-answers
  (is (= :reserved-varint-prefix (r/reason (v/decode [0xC0 0 0 0] 0))))
  (is (= :truncated-varint (r/reason (v/decode [] 0))))
  (is (= :truncated-varint (r/reason (v/decode [0x40] 0))))
  (is (= :truncated-varint (r/reason (v/decode [0x80 0x00] 0)))))

(deftest opaque-vectors
  (doseq [n [0 1 63 64 100 16383 16384]]
    (let [bs (vec (repeat n 0xAB))
          e (r/val (v/opaque bs))
          d (v/read-opaque e 0)]
      (is (r/ok? d) (str n))
      (is (= bs (:mls/value (r/val d))) (str n))
      (is (= (count e) (:mls/next (r/val d))) (str n))))
  (testing "a length that runs past the buffer is refused"
    (is (= :opaque-past-end (r/reason (v/read-opaque [0x05 1 2] 0))))))

(deftest the-rfc-worked-example
  ;; §2.1.2: "the four-byte length value 0x9d7f3e7d decodes to 494878333".
  (is (= 494878333 (:mls/value (r/val (v/decode [0x9d 0x7f 0x3e 0x7d] 0)))))
  (is (= [0x9d 0x7f 0x3e 0x7d] (r/val (v/encode 494878333)))))
