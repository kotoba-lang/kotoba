(ns mls.tree-test
  "Tree math against the MLS working group's own corpus.

  Ten trees, 1 to 512 leaves — 1,023 nodes at the top end — and for each one
  the corpus publishes the root and the full `left`, `right`, `parent` and
  `sibling` arrays, with `null` where the operation has no answer.

  **The nulls are the interesting half.** A leaf has no children and the root
  has no parent, and an implementation that returned 0 or the node itself for
  those would agree with the corpus everywhere else. So they are asserted as
  errors, by reason."
  (:require [kotoba.test :refer [deftest is testing]]
            [mls.result :as r]
            [mls.tree :as tree]
            [mls.vectors :as v]
            [kotoba.lang.coll]))

(deftest the-corpus-is-whole
  (is (= 10 (count v/tree-math)))
  (is (= [1 2 4 8 16 32 64 128 256 512] (mapv :n-leaves v/tree-math)))
  (doseq [{:keys [n-nodes left right parent sibling]} v/tree-math]
    (is (= n-nodes (count left)))
    (is (= n-nodes (count right)))
    (is (= n-nodes (count parent)))
    (is (= n-nodes (count sibling))))
  (testing "and it really does contain nulls, or the next test asserts nothing"
    (is (some (fn [e] (some nil? (:left e))) v/tree-math))
    (is (some (fn [e] (some nil? (:parent e))) v/tree-math))))

(deftest node-width-and-root
  (doseq [{:keys [n-leaves n-nodes root]} v/tree-math]
    (testing (str n-leaves " leaves")
      (is (= n-nodes (tree/node-width n-leaves)))
      (is (= root (tree/root n-leaves))))))

(deftest every-relation-in-every-tree
  (doseq [{:keys [n-leaves left right parent sibling]} v/tree-math]
    (testing (str n-leaves " leaves")
      (dotimes [x (count left)]
        (let [check (fn [expected got what]
                      (if (nil? expected)
                        (is (r/error? got) (str what " of " x " should have no answer"))
                        (do (is (r/ok? got) (str what " of " x ": " (pr-str (r/err got))))
                            (is (= expected (r/val got)) (str what " of " x)))))]
          (check (nth left x) (tree/left x) "left")
          (check (nth right x) (tree/right x) "right")
          (check (nth parent x) (tree/parent x n-leaves) "parent")
          (check (nth sibling x) (tree/sibling x n-leaves) "sibling"))))))

(deftest the-absences-have-their-own-reasons
  ;; "It failed" is not something a caller can act on, and these are two
  ;; different failures: a leaf never has children at any size of tree, and
  ;; whether a node is the root depends on how many leaves there are.
  (is (= :leaf-has-no-children (r/reason (tree/left 0))))
  (is (= :leaf-has-no-children (r/reason (tree/right 4))))
  (is (= :root-has-no-parent (r/reason (tree/parent 7 8))))
  (testing "and node 7 is only the root in a tree of exactly 8 leaves"
    (is (r/ok? (tree/parent 7 16)))
    (is (= :root-has-no-parent (r/reason (tree/parent 15 16))))))

(deftest direct-paths-climb-to-the-root-and-stop
  (doseq [{:keys [n-leaves root]} v/tree-math]
    (testing (str n-leaves " leaves")
      (is (= [] (r/val (tree/direct-path root n-leaves))) "the root's path is empty")
      (dotimes [leaf (min n-leaves 32)]
        (let [x (* 2 leaf)
              d (tree/direct-path x n-leaves)]
          (is (r/ok? d))
          (let [path (r/val d)]
            (if (= x root)
              ;; The one-leaf tree: its only leaf IS the root, so it has no
              ;; path. Written out rather than skipped -- a tree of one is
              ;; where an off-by-one hides, and a test that quietly excluded
              ;; it would be a test that never looked.
              (is (= [] path) "a leaf that is the root has an empty path")
              (do
                (is (= root (last path)) (str "leaf " leaf " reaches the root"))
                (is (= (count path) (count (distinct path))) "and visits nothing twice")
                (is (apply < (cons -1 (map tree/level path)))
                    "each step is strictly higher than the last")))))))))

(deftest a-copath-is-one-sibling-per-step
  (doseq [{:keys [n-leaves]} v/tree-math :when (> n-leaves 1)]
    (testing (str n-leaves " leaves")
      (dotimes [leaf (min n-leaves 16)]
        (let [x (* 2 leaf)
              d (r/val (tree/direct-path x n-leaves))
              c (tree/copath x n-leaves)]
          (is (r/ok? c))
          (is (= (count d) (count (r/val c)))
              "one node to encrypt to for each step of the path")
          (is (empty? (kotoba.lang.coll/intersection (set d) (set (r/val c))))
              "and no node is both on the path and beside it"))))))

(deftest log2-and-level
  (is (= 0 (tree/log2 0)))
  (is (= 0 (tree/log2 1)))
  (is (= 1 (tree/log2 2)))
  (is (= 1 (tree/log2 3)))
  (is (= 2 (tree/log2 4)))
  (is (= 9 (tree/log2 1023)))
  (testing "leaves are even and level 0; a node's level is its trailing ones"
    (is (= 0 (tree/level 0)))
    (is (= 0 (tree/level 2)))
    (is (= 1 (tree/level 1)))
    (is (= 1 (tree/level 5)))
    (is (= 2 (tree/level 3)))
    (is (= 3 (tree/level 7)))
    (is (every? #(zero? (tree/level %)) (range 0 64 2)))
    (is (every? #(pos? (tree/level %)) (range 1 64 2)))))
