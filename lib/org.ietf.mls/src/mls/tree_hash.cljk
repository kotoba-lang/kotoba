(ns mls.tree-hash
  "The tree hash and the resolution — [RFC 9420](https://www.rfc-editor.org/rfc/rfc9420)
  §7.8 and §7.1.

  `mls.tree` is the array arithmetic and knows nothing about what is in the
  nodes; `mls.node` is the encodings and knows nothing about where they sit.
  This is the join, and it is the first thing in this library that needs both.

  ## A blank node is a value

  `nil` in the node array means *blank*, and blank is not missing: it hashes
  to a definite value (`optional<Node>` with a zero presence byte), and it is
  what makes the resolution rules non-trivial. A tree that treated a blank as
  an absent entry would produce a shorter array, a different tree hash and a
  group that cannot agree with anyone."
  (:require [mls.node :as node]
            [mls.result :as r :refer [ok error]]
            [mls.tree :as tree]
            [mls.varint :as v]))

(defn- u32 [n] (vec (loop [x n out () k 0]
                      (if (= k 4) out (recur (quot x 256) (conj out (bit-and x 0xFF)) (inc k))))))

(defn- optional
  "`optional<T>` around an already-encoded body, or a zero byte for blank."
  [encoded] (if (nil? encoded) [0] (into [1] encoded)))

(defn leaf-hash-input
  "`TreeHashInput` for a leaf — the node type byte, the **leaf** index (not the
  node index), then `optional<LeafNode>`."
  [node-index leaf]
  (r/let-ok [body (if (nil? leaf) (ok nil) (node/encode-leaf-node leaf))]
    (ok (vec (concat [1] (u32 (quot node-index 2)) (optional body))))))

(defn parent-hash-input
  "`TreeHashInput` for a parent — `optional<ParentNode>`, then the two child
  hashes, each length-prefixed."
  [parent left-hash right-hash]
  (r/let-ok [body (if (nil? parent) (ok nil) (node/encode-parent-node parent))
             l (v/opaque left-hash)
             rr (v/opaque right-hash)]
    (ok (vec (concat [2] (optional body) l rr)))))

(defn- node-at
  "The `LeafNode` or `ParentNode` at a node index, or `nil` if blank.

  Refuses a leaf index holding a parent node and vice versa. The array
  position decides which one a node *must* be, so a mismatch is not a variant
  this reader does not handle — it is a tree that cannot be walked."
  [nodes x]
  (let [n (nth nodes x nil)]
    (cond
      (nil? n) (ok nil)
      (and (tree/leaf? x) (= :leaf (:type n))) (ok (:leaf-node n))
      (and (not (tree/leaf? x)) (= :parent (:type n))) (ok (:parent-node n))
      :else (error :node-type-position-mismatch {:mls/at x :mls/type (:type n)}))))

(defn tree-hash
  "The tree hash rooted at node index `x`, using `suite`'s hash."
  [suite nodes x]
  (r/let-ok [n (node-at nodes x)]
    (if (tree/leaf? x)
      (r/let-ok [input (leaf-hash-input x n)] (ok (vec ((:hash suite) input))))
      (r/let-ok [lx (tree/left x)
                 rx (tree/right x)
                 l (tree-hash suite nodes lx)
                 rr (tree-hash suite nodes rx)
                 input (parent-hash-input n l rr)]
        (ok (vec ((:hash suite) input)))))))

(defn root-hash
  "The tree hash of the whole tree."
  [suite nodes] (tree-hash suite nodes (tree/root (quot (inc (count nodes)) 2))))

(defn resolution
  "§7.1. An **ordered list of node indices**.

    - a blank leaf resolves to nothing
    - a non-blank leaf resolves to itself
    - a blank parent resolves to its children's resolutions, left then right
    - a non-blank parent resolves to itself followed by its unmerged leaves

  The unmerged leaves are stored as *leaf* indices and appear here as *node*
  indices, because that is what the rest of the list is. Mixing the two
  numberings produces a list that is the right length and points at the wrong
  nodes."
  [nodes x]
  (r/let-ok [n (node-at nodes x)]
    (cond
      (and (nil? n) (tree/leaf? x)) (ok [])
      (nil? n) (r/let-ok [lx (tree/left x)
                          rx (tree/right x)
                          l (resolution nodes lx)
                          rr (resolution nodes rx)]
                 (ok (into l rr)))
      (tree/leaf? x) (ok [x])
      :else (ok (into [x] (map #(* 2 %)) (:unmerged-leaves n))))))
