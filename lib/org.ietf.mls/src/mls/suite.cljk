(ns mls.suite
  "The seven MLS cipher suites — [RFC 9420](https://www.rfc-editor.org/rfc/rfc9420)
  §17.1 — mapped onto this workspace's primitives.

  A suite is a value carrying an HPKE suite, a hash, and the lengths derived
  from them. Nothing below branches on the identifier.

  ## Five of the seven sign

  MLS names a signature scheme in every suite: Ed25519, Ed448, or ECDSA over
  P-256/384/521. Five of those are here — `org-ietf-ed25519` and
  `org-nist-ecc` — and **Ed448 is not**, so suites 4 and 6 have a KEM, a KDF
  and an AEAD and no way to sign.

  That is recorded in `:signature` rather than left out, so `sign-with-label`
  can refuse **by name** (`:unimplemented-signature-scheme`) instead of
  falling off a `case`. A suite whose signature half is missing and a suite
  that is not in the table are different things to tell a caller.

  ⚠ This docstring said the opposite until 2026-08-27 — that no suite here
  signs, because `org-ietf-ed25519` was `:clj`-only and `org-nist-ecc` had no
  ECDSA. Both had stopped being true. The sentence was load-bearing: it was
  read as evidence and cited as a blocker before anyone counted the reader
  conditionals. **Prose about what another repository can do goes stale
  silently, and it goes stale with an authoritative tone.**"
  (:require [hpke.core :as hpke]
            [hpke.dhkem :as dhkem]
            [hpke.kdf :as kdf]
            [sha2.core :as sha2]
            [sha2.sha512 :as sha512]))

(def ^:private hashes
  {:sha256 {:fn sha2/sha256 :length 32}
   :sha384 {:fn sha512/sha384 :length 48}
   :sha512 {:fn sha512/sha512 :length 64}})

(defn- suite
  [id nm kem kdf- aead hash-kw sig]
  (let [h (get hashes hash-kw)]
    {:id id :name nm
     :hpke (hpke/suite kem kdf- aead)
     :kdf kdf- :aead aead :kem kem
     :hash (:fn h) :hash-length (:length h)
     :nh (:nh kdf-) :nk (:nk aead) :nn (:nn aead)
     :signature sig}))

(def suites
  "By identifier. The `:signature` field names what MLS requires and this does
  not implement — it is recorded rather than omitted, so a caller reaching for
  it finds a name instead of a missing key."
  (into {}
        (map (fn [[id nm kem kdf- aead h sig]] [id (suite id nm kem kdf- aead h sig)]))
        [[0x0001 :MLS_128_DHKEMX25519_AES128GCM_SHA256_Ed25519
          dhkem/x25519-hkdf-sha256 kdf/hkdf-sha256 hpke/aes-128-gcm :sha256 :ed25519]
         [0x0002 :MLS_128_DHKEMP256_AES128GCM_SHA256_P256
          dhkem/p256-hkdf-sha256 kdf/hkdf-sha256 hpke/aes-128-gcm :sha256 :ecdsa-secp256r1-sha256]
         [0x0003 :MLS_128_DHKEMX25519_CHACHA20POLY1305_SHA256_Ed25519
          dhkem/x25519-hkdf-sha256 kdf/hkdf-sha256 hpke/chacha20-poly1305 :sha256 :ed25519]
         [0x0004 :MLS_256_DHKEMX448_AES256GCM_SHA512_Ed448
          dhkem/x448-hkdf-sha512 kdf/hkdf-sha512 hpke/aes-256-gcm :sha512 :ed448]
         [0x0005 :MLS_256_DHKEMP521_AES256GCM_SHA512_P521
          dhkem/p521-hkdf-sha512 kdf/hkdf-sha512 hpke/aes-256-gcm :sha512 :ecdsa-secp521r1-sha512]
         [0x0006 :MLS_256_DHKEMX448_CHACHA20POLY1305_SHA512_Ed448
          dhkem/x448-hkdf-sha512 kdf/hkdf-sha512 hpke/chacha20-poly1305 :sha512 :ed448]
         [0x0007 :MLS_256_DHKEMP384_AES256GCM_SHA384_P384
          dhkem/p384-hkdf-sha384 kdf/hkdf-sha384 hpke/aes-256-gcm :sha384 :ecdsa-secp384r1-sha384]]))
