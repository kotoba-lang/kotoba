(ns mls.uint
  "`uint64` on two runtimes that cannot both hold one.

  MLS carries epochs as `uint64`. A JVM `long` overflows above 2^63-1 — and
  overflow here is not a wrong number, it is an **uncaught
  `ArithmeticException`**, so a peer that sends nine bytes of `0xFF` crashes
  the parser instead of being refused. A JavaScript number silently drops the
  low bits above 2^53, so the same input is accepted and comes back as a
  different value.

  Both were reachable from `mls.framing/decode-private-message` with fewer
  than twenty bytes of peer-supplied input.

  So this reads a `uint64` **only inside the range both runtimes represent
  exactly**, and returns an error outside it. That is narrower than the wire
  format allows and it is deliberate: an epoch counts commits, 2^53 of them
  will not happen, and a refusal a caller can see beats a crash on one runtime
  and a wrong answer on the other.

  `Lifetime` is the field where 2^64-1 really is the expected value, and
  `mls.node` keeps it as bytes for exactly that reason — it does not come
  through here."
  (:require [mls.result :as r :refer [ok error]]))

(def max-exact
  "2^53 - 1. The largest integer both a JVM `long` and an IEEE-754 double hold
  exactly, so the largest one this library will hand back as a number."
  9007199254740991)

(defn u64
  "Eight big-endian bytes."
  [n]
  (if (or (neg? n) (> n max-exact))
    (error :u64-beyond-exact-range {:mls/value n})
    (ok (vec (loop [x n out () k 0]
               (if (= k 8) out (recur (quot x 256) (conj out (bit-and x 0xFF)) (inc k))))))))

(defn u64!
  "For callers that built the value themselves and cannot be out of range.
  Throws rather than returning a result — a bug here is in this library, not
  in a peer's bytes."
  [n]
  (let [x (u64 n)]
    (if (r/ok? x) (r/val x) (throw (ex-info "mls uint64 out of range" {:n n})))))

(defn read-u64
  "Returns `[:ok n]`, or refuses.

  The range check runs on the **bytes**, before anything is multiplied, so the
  refusal happens instead of the overflow rather than after it. `max-exact` is
  2^53-1, whose eight bytes are `00 1F FF FF FF FF FF FF` — so the first byte
  must be zero and the second at most `0x1F`, and both halves of that are
  load-bearing. Checking only the first byte would admit 2^56."
  [bs off]
  (if (> (+ off 8) (count bs))
    (error :truncated-u64 {:mls/at off})
    (if (or (pos? (nth bs off)) (> (nth bs (inc off)) 0x1F))
      (error :u64-beyond-exact-range {:mls/at off})
      (ok (reduce (fn [a i] (+ (* 256 a) (nth bs (+ off i)))) 0 (range 8))))))
