(ns mls.varint
  "MLS's variable-size vector length header — [RFC 9420](https://www.rfc-editor.org/rfc/rfc9420)
  §2.1.2.

  The two high bits of the first byte give the base-2 logarithm of the
  encoding's length in bytes; the value occupies the rest. So 1, 2 or 4 bytes
  carrying 6, 14 or 30 bits.

  ## The minimum-encoding rule is not decoration

  RFC 9420 differs from QUIC's encoding (RFC 9000 §16) in exactly one way: it
  **requires** the smallest encoding, and says a decoder MUST treat a longer
  one as malformed.

  That matters because these lengths prefix values that get **hashed**.
  `RefHash` and `KDFLabel` both serialise `opaque x<V>`, so two encodings of
  the same length would be two byte strings for the same object — two
  different `KeyPackageRef`s for one KeyPackage, and a signature that verifies
  over one and not the other. Accepting a non-minimal length is how an object
  acquires a second identity."
  (:require [mls.result :as r :refer [ok error]]))

(defn encode
  "A length as 1, 2 or 4 bytes, always the smallest that fits."
  [n]
  (cond
    (neg? n) (error :bad-varint {:mls/value n})
    (<= n 0x3F) (ok [n])
    (<= n 0x3FFF) (ok [(bit-or 0x40 (bit-and (quot n 256) 0x3F)) (bit-and n 0xFF)])
    (<= n 0x3FFFFFFF) (ok [(bit-or 0x80 (bit-and (quot n 16777216) 0x3F))
                           (bit-and (quot n 65536) 0xFF)
                           (bit-and (quot n 256) 0xFF)
                           (bit-and n 0xFF)])
    :else (error :varint-too-large {:mls/value n})))

(defn encode! [n]
  (let [x (encode n)]
    (if (r/ok? x) (r/val x) (throw (ex-info "mls varint" {:n n})))))

(defn decode
  "Returns `{:mls/value n :mls/next i}`, or an error.

  Three refusals, and each has its own reason because they are three different
  things a peer did: a truncated buffer, the reserved `11` prefix, and a value
  encoded in more bytes than it needs."
  [bs off]
  (let [bs (vec bs)]
    (if (>= off (count bs))
      (error :truncated-varint {:mls/at off})
      (let [b0 (nth bs off)
            prefix (bit-shift-right b0 6)
            len (case prefix 0 1 1 2 2 4 3 :invalid)]
        (if (= :invalid len)
          (error :reserved-varint-prefix {:mls/byte b0})
          (if (> (+ off len) (count bs))
            (error :truncated-varint {:mls/at off :mls/need len})
            (let [v (reduce (fn [acc i] (+ (* 256 acc) (nth bs (+ off i))))
                            (bit-and b0 0x3F)
                            (range 1 len))]
              (if (not= len (count (r/val (encode v))))
                (error :non-minimal-varint {:mls/value v :mls/bytes len})
                (ok {:mls/value v :mls/next (+ off len)})))))))))

(defn opaque
  "`opaque x<V>` — the varint length, then the bytes."
  [bs]
  (let [bs (mapv #(bit-and (int %) 0xFF) (seq bs))]
    (r/let-ok [n (encode (count bs))]
      (ok (into n bs)))))

(defn opaque! [bs] (r/val (opaque bs)))

(defn read-opaque [bs off]
  (r/let-ok [n (decode bs off)]
    (let [len (:mls/value n) start (:mls/next n) end (+ start len)]
      (if (> end (count bs))
        (error :opaque-past-end {:mls/declared len :mls/available (- (count bs) start)})
        (ok {:mls/value (subvec (vec bs) start end) :mls/next end})))))
