(ns mls.group-context
  "`GroupContext` — [RFC 9420](https://www.rfc-editor.org/rfc/rfc9420) §8.1.

  The summary of a group's state that every member keeps, and the value the
  key schedule binds each epoch to. Its **serialised form** is what goes into
  `ExpandWithLabel` for `joiner_secret` and `epoch_secret`, so an encoding
  that differs by one byte is a group whose members derive different keys and
  cannot tell each other why."
  (:require [mls.result :as r :refer [ok error]]
            [mls.uint :as uint]
            [mls.varint :as v]))

(def version
  "`mls10` — the only ProtocolVersion RFC 9420 defines."
  0x0001)

(defn- u16 [n] [(bit-and (quot n 256) 0xFF) (bit-and n 0xFF)])

(defn encode
  "The serialised `GroupContext`."
  [{:keys [cipher-suite group-id epoch tree-hash confirmed-transcript-hash extensions]}]
  (r/let-ok [gid (v/opaque group-id)
             th (v/opaque tree-hash)
             cth (v/opaque confirmed-transcript-hash)
             ext (v/opaque (or extensions []))]
    (ok (vec (concat (u16 version) (u16 cipher-suite) gid (uint/u64! epoch) th cth ext)))))

(defn decode
  [bs]
  (let [bs (mapv #(bit-and (int %) 0xFF) (seq bs))]
    (if (< (count bs) 4)
      (error :truncated-group-context {:mls/length (count bs)})
      (let [ver (+ (* 256 (nth bs 0)) (nth bs 1))
            cs (+ (* 256 (nth bs 2)) (nth bs 3))]
        (if (not= version ver)
          (error :unknown-protocol-version {:mls/version ver})
          (r/let-ok [gid (v/read-opaque bs 4)]
            (let [off (:mls/next gid)]
              (if (> (+ off 8) (count bs))
                (error :truncated-group-context {:mls/at off})
                (let [epoch (reduce (fn [acc i] (+ (* 256 acc) (nth bs (+ off i)))) 0 (range 8))]
                  (r/let-ok [th (v/read-opaque bs (+ off 8))
                             cth (v/read-opaque bs (:mls/next th))
                             ext (v/read-opaque bs (:mls/next cth))]
                    (if (not= (count bs) (:mls/next ext))
                      (error :trailing-bytes {:mls/at (:mls/next ext) :mls/total (count bs)})
                      (ok {:cipher-suite cs
                           :group-id (:mls/value gid)
                           :epoch epoch
                           :tree-hash (:mls/value th)
                           :confirmed-transcript-hash (:mls/value cth)
                           :extensions (:mls/value ext)}))))))))))))
