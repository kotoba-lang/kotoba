(ns mls.transcript
  "The transcript hashes — [RFC 9420](https://www.rfc-editor.org/rfc/rfc9420)
  §8.2.

  Two running hashes over every Commit a group has ever seen:

  - `confirmed_transcript_hash` covers the history **up to and including the
    signature** of the most recent Commit
  - `interim_transcript_hash` covers that, plus the most recent Commit's
    `confirmation_tag`

  The split is what makes the confirmation tag possible at all. The tag is a
  MAC over the confirmed hash, so the confirmed hash cannot include it —
  otherwise computing the tag would require the tag. The interim hash exists
  to fold it back in for the next epoch.

  ## The tag is how the AuthenticatedContent is split

  `AuthenticatedContent` for a Commit is
  `ConfirmedTranscriptHashInput || opaque confirmation_tag<V>`, and the
  boundary between them is not marked. Finding it by parsing would mean
  parsing a whole Commit — proposals, an UpdatePath, a Sender.

  It does not have to be parsed. The tag is recomputable from the
  confirmation key and the confirmed hash, so its encoded form is a known
  suffix: match it, and what remains in front is exactly the input to the
  confirmed hash. That is a **stronger** check than parsing would be, because
  it verifies the tag in the same step."
  (:require [mls.result :as r :refer [ok error]]
            [mls.varint :as v]))

(defn confirmation-tag
  "`MAC(confirmation_key, confirmed_transcript_hash)` — §6.1.

  The MAC is the one under the suite's KDF: HMAC with the suite's hash."
  [suite confirmation-key confirmed-transcript-hash]
  (vec ((:hmac (:kdf suite)) (vec confirmation-key) (vec confirmed-transcript-hash))))

(defn confirmed-hash
  "`Hash(interim_transcript_hash_[n-1] || ConfirmedTranscriptHashInput_[n])`.

  Epoch 0's interim hash is the **empty string**, not a hash of nothing and
  not `Nh` zeros — §8.2 says zero-length, and a group started from any other
  value agrees with no one."
  [suite interim-before cthi]
  (ok (vec ((:hash suite) (vec (concat interim-before cthi))))))

(defn interim-hash
  "`Hash(confirmed_transcript_hash_[n] || InterimTranscriptHashInput_[n])`,
  where the input is the `confirmation_tag` as `opaque MAC<V>` — length
  prefix included."
  [suite confirmed tag]
  (r/let-ok [t (v/opaque tag)]
    (ok (vec ((:hash suite) (vec (concat confirmed t)))))))

(defn split-authenticated-content
  "Separate a Commit's `AuthenticatedContent` into the confirmed-hash input
  and its `confirmation_tag`, using the tag as the boundary.

  Returns an error when the recomputed tag is not the suffix — which means
  either the content was not produced with this confirmation key, or it is not
  a Commit at all. Those are not distinguished, deliberately: from outside,
  both are the same statement, that this content does not belong to this
  epoch."
  [suite confirmation-key confirmed-hash- authenticated-content]
  (let [ac (mapv #(bit-and (int %) 0xFF) (seq authenticated-content))
        tag (confirmation-tag suite confirmation-key confirmed-hash-)]
    (r/let-ok [suffix (v/opaque tag)]
      (let [n (count suffix)
            cut (- (count ac) n)]
        (if (or (neg? cut) (not= suffix (subvec ac cut)))
          (error :confirmation-tag-not-at-the-end
                 {:mls/expected-suffix-length n :mls/content-length (count ac)})
          (ok {:mls/confirmed-input (subvec ac 0 cut)
               :mls/confirmation-tag tag}))))))
