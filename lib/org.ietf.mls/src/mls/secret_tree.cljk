(ns mls.secret-tree
  "The secret tree and the sender ratchets — [RFC 9420](https://www.rfc-editor.org/rfc/rfc9420)
  §9.

  The `encryption_secret` sits at the root of a tree with the **same shape as
  the group's ratchet tree**, and each parent derives its two children by
  label. Every member owns the leaf at its own index, and from that leaf runs
  two hash ratchets — one for handshake messages, one for application
  messages — which produce a single-use key and nonce per message.

  ## Why the tree and not just a per-member secret

  Because a member only needs the secrets on its own path. Giving each member
  the root would give it everyone's keys; giving each member an unrelated
  secret would mean the group had to distribute one per member per epoch. The
  tree lets one value at the root imply every member's, while each member
  derives only its own — the same reason the ratchet tree above it has the
  shape it does.

  ## Each key/nonce pair is used once

  §9.1 says a pair MUST NOT encrypt more than one message, and §9.2 says to
  delete a secret as soon as anything derived from it has been consumed. This
  namespace derives; it does not hold state, and it deletes nothing — a caller
  that keeps a ratchet around is responsible for both. That is stated because
  a library which quietly cached ratchet secrets would break the forward
  secrecy the ratchet exists for."
  (:require [mls.crypto :as crypto]
            [mls.result :as r :refer [ok error]]
            [mls.tree :as tree]))

(defn- child-label
  "`left` or `right` — the **context** of the derivation, not its label. The
  label is the constant `tree` for both; what distinguishes the children is
  the context. Swapping the two roles derives two children that are equal."
  [c] (crypto/ascii-bytes c))

(defn leaf-secret
  "The secret at leaf `leaf-index` of a tree with `n-leaves`, derived from the
  root down.

  Only this path is walked. Materialising the whole tree would compute every
  other member's secrets as a side effect of finding one's own, which is
  exactly the thing the tree is shaped to avoid."
  [suite encryption-secret n-leaves leaf-index]
  (if-not (< -1 leaf-index n-leaves)
    (error :leaf-out-of-range {:mls/leaf leaf-index :mls/leaves n-leaves})
    (let [node (* 2 leaf-index)]
      (r/let-ok [up (tree/direct-path node n-leaves)]
        ;; direct-path is leaf-to-root; the derivation runs root-to-leaf.
        (let [chain (reverse (cons node up))]
          (loop [secret encryption-secret
                 [parent child & _ :as nodes] chain]
            (if (nil? child)
              (ok secret)
              (r/let-ok [l (tree/left parent)]
                (r/let-ok [next- (crypto/expand-with-label
                                  suite secret "tree"
                                  (child-label (if (= child l) "left" "right"))
                                  (:nh suite))]
                  (recur next- (next nodes)))))))))))

(defn ratchet-root
  "The generation-0 secret of one of a leaf's two ratchets — §9, Figure 26.

  `kind` is `:handshake` or `:application`, and the two are separate ratchets
  from the same leaf. Sharing one would mean a handshake message and an
  application message could consume each other's key/nonce pairs."
  [suite leaf-secret- kind]
  (case kind
    :handshake (crypto/expand-with-label suite leaf-secret- "handshake" [] (:nh suite))
    :application (crypto/expand-with-label suite leaf-secret- "application" [] (:nh suite))
    (error :unknown-ratchet-kind {:mls/kind kind})))

(defn ratchet-step
  "The key, nonce and next secret at generation `j` — §9.1.

  All three come from the **same** secret and differ only by label; the next
  secret is not derived from the key. `DeriveTreeSecret`'s context is the
  generation as a big-endian uint32, which is what binds a key to its position
  in the ratchet."
  [suite secret j]
  (r/let-ok [nonce (crypto/derive-tree-secret suite secret "nonce" j (:nn suite))
             key- (crypto/derive-tree-secret suite secret "key" j (:nk suite))
             next- (crypto/derive-tree-secret suite secret "secret" j (:nh suite))]
    (ok {:mls/key key- :mls/nonce nonce :mls/next-secret next-})))

(defn ratchet-at
  "Advance a ratchet to generation `j` and return that generation's key and
  nonce.

  There is no shortcut. A ratchet is a hash chain, so reaching generation 15
  means fifteen derivations — which is the property that makes an earlier key
  unrecoverable from a later one, and the reason this cannot take a generation
  and jump."
  [suite root j]
  (loop [secret root i 0]
    (let [step (ratchet-step suite secret i)]
      (cond
        (r/error? step) step
        (= i j) (ok (dissoc (r/val step) :mls/next-secret))
        :else (recur (:mls/next-secret (r/val step)) (inc i))))))

(defn leaf-keys
  "The key and nonce for one message: leaf, ratchet kind, generation."
  [suite encryption-secret n-leaves leaf-index kind generation]
  (r/let-ok [leaf (leaf-secret suite encryption-secret n-leaves leaf-index)
             root (ratchet-root suite leaf kind)]
    (ratchet-at suite root generation)))

;; ── sender data, §6.3.2 ─────────────────────────────────────────────────────

(defn sender-data-keys
  "The key and nonce protecting the sender metadata — §6.3.2.

  Derived from `sender_data_secret` and a **sample of the ciphertext they will
  protect**: the first `KDF.Nh` bytes, or the whole thing if it is shorter.
  That coupling is deliberate — the sender data is bound to the message it
  describes, so it cannot be lifted onto another one.

  The short-ciphertext case is not an edge case to tolerate. A message shorter
  than `Nh` is ordinary, and an implementation that indexed past the end would
  fail on exactly those."
  [suite sender-data-secret ciphertext]
  (let [ct (mapv #(bit-and (int %) 0xFF) (seq ciphertext))
        sample (vec (take (:nh suite) ct))]
    (r/let-ok [key- (crypto/expand-with-label suite sender-data-secret "key" sample (:nk suite))
               nonce (crypto/expand-with-label suite sender-data-secret "nonce" sample (:nn suite))]
      (ok {:mls/key key- :mls/nonce nonce :mls/sample sample}))))
