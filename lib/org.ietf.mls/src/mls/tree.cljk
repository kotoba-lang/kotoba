(ns mls.tree
  "Array-based ratchet tree arithmetic — [RFC 9420](https://www.rfc-editor.org/rfc/rfc9420)
  Appendix C.

  MLS's ratchet tree is a complete balanced binary tree flattened into an
  array: leaf `n` sits at index `2n`, and every odd index is a parent. That
  layout means every relationship — parent, sibling, the direct path to the
  root — is **index arithmetic**, with no pointers to maintain and nothing to
  keep consistent.

  ## Why this is its own namespace with its own vectors

  It is the one part of MLS with no cryptography in it at all, and the MLS
  interop corpus tests it separately for that reason. Everything above it —
  parent hashes, tree hashes, the path secrets of TreeKEM — is defined in
  terms of these functions, so an off-by-one here is not a wrong answer in one
  place, it is a wrong answer everywhere at once, in a form that still looks
  like a tree."
  (:require [mls.result :as r :refer [ok error]]))

(defn log2
  "The exponent of the largest power of 2 not greater than `x`, and 0 for 0.

  The RFC defines it with a loop rather than `floor(log(x, 2))`, and that is
  not a style choice: the floating-point form is wrong for large powers of two
  on some runtimes, and this is used to find the root."
  [x]
  (if (zero? x)
    0
    (loop [k 0] (if (pos? (bit-shift-right x k)) (recur (inc k)) (dec k)))))

(defn level
  "0 for a leaf, and for a parent the number of trailing 1 bits."
  [x]
  (if (zero? (bit-and x 1))
    0
    (loop [k 0] (if (= 1 (bit-and (bit-shift-right x k) 1)) (recur (inc k)) k))))

(defn node-width
  "The number of array slots a tree with `n` leaves occupies."
  [n]
  (if (zero? n) 0 (inc (* 2 (dec n)))))

(defn root
  "The index of the root of a tree with `n` leaves."
  [n]
  (dec (bit-shift-left 1 (log2 (node-width n)))))

(defn leaf? [x] (zero? (level x)))

(defn left
  "The left child. A leaf has none, and that is an error rather than a
  sentinel — `nil` here would be indistinguishable from index 0, which is a
  real node."
  [x]
  (let [k (level x)]
    (if (zero? k)
      (error :leaf-has-no-children {:mls/node x})
      (ok (bit-xor x (bit-shift-left 1 (dec k)))))))

(defn right [x]
  (let [k (level x)]
    (if (zero? k)
      (error :leaf-has-no-children {:mls/node x})
      (ok (bit-xor x (bit-shift-left 3 (dec k)))))))

(defn parent
  "The parent of `x` in a tree with `n` leaves. The root has none."
  [x n]
  (if (= x (root n))
    (error :root-has-no-parent {:mls/node x})
    (let [k (level x)
          b (bit-and (bit-shift-right x (inc k)) 1)]
      (ok (bit-xor (bit-or x (bit-shift-left 1 k)) (bit-shift-left b (inc k)))))))

(defn sibling
  "The other child of `x`'s parent."
  [x n]
  (r/let-ok [p (parent x n)]
    (if (< x p) (right p) (left p))))

(defn direct-path
  "Every node from `x`'s parent to the root, in that order. Empty for the
  root itself."
  [x n]
  (let [rt (root n)]
    (if (= x rt)
      (ok [])
      (loop [x x acc []]
        (if (= x rt)
          (ok acc)
          (let [p (parent x n)]
            (if (r/error? p) p (recur (r/val p) (conj acc (r/val p))))))))))

(defn copath
  "The sibling of each node on the direct path — the nodes a member must
  encrypt to when it updates its own path."
  [x n]
  (r/let-ok [d (direct-path x n)]
    (loop [nodes (cons x (butlast d)) acc []]
      (if-let [node (first nodes)]
        (let [s (sibling node n)]
          (if (r/error? s) s (recur (next nodes) (conj acc (r/val s)))))
        (ok acc)))))
