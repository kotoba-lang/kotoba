(ns mls.result
  "`[:ok v]` or `[:error {…}]`, with a stable reason keyword.

  The same shape `org-ietf-tls` uses, and for the same reason: a failed check
  and a successful one must not return the same thing. `nil` for both is how a
  refusal becomes a silent acceptance."
  (:refer-clojure :exclude [val]))

(defn ok [v] [:ok v])

(defn error
  "Note the merge order: the **reason wins** over the caller's context map.

  `org-ietf-tls` merges the other way, and a context map that happened to
  carry `:tls/reason` silently replaced the stable keyword a caller asserts
  on. That was found this week by a test that asserted *which* error rather
  than that one happened; putting the reason last makes it unfindable because
  it cannot happen."
  ([reason] (error reason {}))
  ([reason data] [:error (merge data {:mls/reason reason})]))

(defn ok? [r] (and (vector? r) (= :ok (first r))))
(defn error? [r] (and (vector? r) (= :error (first r))))

(defn val
  "The value of an `[:ok v]`. Throws on an error — reaching for the value of a
  result you did not check is a bug in the caller."
  [r]
  (if (ok? r) (second r) (throw (ex-info "mls.result/val on an error result" {:result r}))))

(defn err [r] (when (error? r) (second r)))
(defn reason [r] (:mls/reason (err r)))

(defmacro let-ok
  "Bind results, short-circuiting on the first error."
  [bindings & body]
  (if (empty? bindings)
    `(do ~@body)
    (let [[sym expr & more] bindings]
      `(let [r# ~expr]
         (if (error? r#)
           r#
           (let [~sym (val r#)]
             (let-ok ~(vec more) ~@body)))))))
