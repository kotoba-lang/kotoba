;; Port of importer.receipt (receipt.cljk), Kotoba-native.
;;
;; A receipt is a :document map. `receipt` takes the options map (the source's
;; destructured argument) and returns the receipt map.
;;
;; Named divergences from receipt.cljk:
;;   - `silent-hole?` and `problems` read planned/persisted as i64 with a
;;     default of 0 when absent. A key present with nil is also read as 0; the
;;     source would throw on the comparison.
;;   - `problems` returns a :document vector of {:importer/code :importer/msg}
;;     maps, in the source's order.
;;   - `(or rejected 0)` and `(seq blobs)` follow Clojure truthiness: nil and
;;     false are absent, and an empty blobs vector is not added.

(ns importer.receipt
  (:export [receipt silent-hole? problems]))

(defn- fld [m :document k :keyword] :document
  (option-or (document-get m (document-keyword k)) (document-null)))

(defn- kv [m :document k :keyword v :document] :document
  (document-assoc m (document-keyword k) v))

(defn- kind-null? [d :document] :bool
  (string=? (keyword-name (document-kind d)) "null"))

(defn- truthy? [d :document] :bool
  (if (kind-null? d) false (option-or (document-bool-value d) true)))

(defn- or2 [a :document b :document] :document
  (if (truthy? a) a b))

(defn- i64-of [d :document dflt :i64] :i64
  (option-or (document-i64-value d) dflt))

(defn- nonempty? [d :document] :bool
  (if (truthy? d) (> (document-count d) 0) false))

(defn receipt [opts :document] :document
  (let [cin (fld opts :cursor-in)
        cout (fld opts :cursor-out)
        m0 (kv (document-map) :importer.receipt/source-id (fld cin :importer.cursor/source-id))
        m1 (kv m0 :importer.receipt/stream (fld cin :importer.cursor/stream))
        m2 (kv m1 :importer.receipt/key (fld cin :importer.cursor/key))
        m3 (kv m2 :importer.receipt/phase (fld cin :importer.cursor/phase))
        m4 (kv m3 :importer.receipt/token-in (fld cin :importer.cursor/token))
        m5 (kv m4 :importer.receipt/token-out (fld cout :importer.cursor/token))
        m6 (kv m5 :importer.receipt/moved? (document-bool (truthy? (fld opts :moved?))))
        m7 (kv m6 :importer.receipt/planned (fld opts :planned))
        m8 (kv m7 :importer.receipt/persisted (fld opts :persisted))
        m9 (kv m8 :importer.receipt/rejected (or2 (fld opts :rejected) (document-i64 0)))
        m10 (kv m9 :importer.receipt/outcome (fld opts :outcome))
        m11 (kv m10 :importer.receipt/at (fld opts :at))
        m12 (if (truthy? (fld opts :held-reason))
              (kv m11 :importer.receipt/held-reason (fld opts :held-reason))
              m11)
        m13 (if (truthy? (fld opts :held-detail))
              (kv m12 :importer.receipt/held-detail (fld opts :held-detail))
              m12)
        m14 (if (truthy? (fld opts :resync-required?))
              (kv m13 :importer.receipt/resync-required? (document-bool true))
              m13)
        blobs (fld opts :blobs)]
    (if (nonempty? blobs)
      (kv m14 :importer.receipt/blobs blobs)
      m14)))

;; The cursor moved past records the sink did not take.
(defn silent-hole? [r :document] :bool
  (if (truthy? (fld r :importer.receipt/moved?))
    (< (i64-of (fld r :importer.receipt/persisted) 0)
       (i64-of (fld r :importer.receipt/planned) 0))
    false))

(defn- problem-doc [code :document msg :string] :document
  (document-assoc (document-assoc (document-map) (document-keyword :importer/code) code)
                  (document-keyword :importer/msg)
                  (document-string msg)))

(defn problems [r :document] :document
  (let [moved (truthy? (fld r :importer.receipt/moved?))
        synced (document-equal? (fld r :importer.receipt/outcome) (document-keyword :synced))
        planned (i64-of (fld r :importer.receipt/planned) 0)
        persisted (i64-of (fld r :importer.receipt/persisted) 0)
        v0 (document-vector)
        v1 (if (silent-hole? r)
             (document-vector-conj
              v0
              (problem-doc (document-keyword :receipt/silent-hole)
                           (string-concat
                            (string-concat "cursor advanced past "
                                           (string-from-i64 (- planned persisted)))
                            " records the sink did not take")))
             v0)
        v2 (if (and moved (not synced))
             (document-vector-conj
              v1
              (problem-doc (document-keyword :receipt/moved-without-sync)
                           "cursor moved on an outcome that was not :synced"))
             v1)
        v3 (if (and (not moved) synced)
             (document-vector-conj
              v2
              (problem-doc (document-keyword :receipt/sync-without-move)
                           "reported :synced while the cursor was held"))
             v2)]
    v3))
