{:schema "kotoba.connector.repository.v1",
 :connector/origin-domain "itonami.cloud",
 :connector/base-scopes [],
 :connector/id "cloud.itonami.corpus",
 :connector/var "provider",
 :connector/scopes [],
 :authority "90-docs/adr/2608301500-workspace-importer-plane.edn",
 :connector/namespace "importer.connector",
 :connector/auth-kind :bearer,
 :connector/auth-pkce? nil,
 :connector/summary
 "Mail, calendar and files already imported from a tenant's Google Workspace and Microsoft 365. Read-only, and every answer states what it covers.",
 :connector/name "Imported Workspace Corpus",
 :connector/client-id-env nil,
 :connector/tools
 [{:connector/name "corpus_calendar_window",
   :connector/effect :read,
   :connector/scopes [],
   :connector/description "Imported events overlapping a time window."}
  {:connector/name "corpus_file_search",
   :connector/effect :read,
   :connector/scopes [],
   :connector/description
   "Imported file metadata. Metadata only -- no tool here downloads content."}
  {:connector/name "corpus_import_status",
   :connector/effect :read,
   :connector/scopes [],
   :connector/description
   "What each stream is read through, and what it is not. Three-valued: a stream that could not be measured is reported as such rather than as current."}
  {:connector/name "corpus_mail_message",
   :connector/effect :read,
   :connector/scopes [],
   :connector/description
   "One imported message by its provider-independent id. Headers by default; the raw blob is referenced, not inlined."}
  {:connector/name "corpus_mail_search",
   :connector/effect :read,
   :connector/scopes [],
   :connector/description
   "Search imported mail across every connected provider. Answers carry coverage: an empty result with an uncovered mailbox is not the same as no such mail."}
  {:connector/name "corpus_mail_thread",
   :connector/effect :read,
   :connector/scopes [],
   :connector/description
   "Every imported message in one thread, oldest first."}]}
