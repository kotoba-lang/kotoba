;; Acceptance test for importer.receipt (port of receipt.cljk).
;; main returns the number of failed cases (0 = all pass).
(ns importer.receipt-test
  (:export [main])
  (:require [importer.receipt :as rc]))

(defn- chk [ok :bool] :i64 (if ok 0 1))
(defn- kv [m :document k :keyword v :document] :document
  (document-assoc m (document-keyword k) v))
(defn- fget [m :document k :keyword] :document
  (option-or (document-get m (document-keyword k)) (document-null)))
(defn- at0 [v :document] :document
  (option-or (document-vector-at v 0) (document-null)))

(defn- cursor [src :string token :string] :document
  (kv (kv (document-map) :importer.cursor/source-id (document-string src))
      :importer.cursor/token (document-string token)))

(defn- opts [moved :bool planned :i64 persisted :i64 outcome :keyword] :document
  (kv (kv (kv (kv (kv (kv (document-map)
                          :cursor-in (cursor "s" "t1"))
                      :cursor-out (cursor "s" "t2"))
                  :moved? (document-bool moved))
              :planned (document-i64 planned))
          :persisted (document-i64 persisted))
      :outcome (document-keyword outcome)))

(defn main [] :i64
  (let [good (rc/receipt (kv (opts true 3 3 :synced) :at (document-i64 100)))
        a (chk (document-equal? (fget good :importer.receipt/source-id) (document-string "s")))
        b (chk (document-equal? (fget good :importer.receipt/token-in) (document-string "t1")))
        c (chk (document-equal? (fget good :importer.receipt/token-out) (document-string "t2")))
        d (chk (document-equal? (fget good :importer.receipt/moved?) (document-bool true)))
        e (chk (document-equal? (fget good :importer.receipt/rejected) (document-i64 0)))
        f (chk (document-equal? (fget good :importer.receipt/at) (document-i64 100)))
        g (chk (not (document-contains good (document-keyword :importer.receipt/blobs))))
        h (chk (= (document-count (rc/problems good)) 0))
        i (chk (not (rc/silent-hole? good)))
        hole (rc/receipt (opts true 5 3 :synced))
        j (chk (rc/silent-hole? hole))
        hp (rc/problems hole)
        k (chk (= (document-count hp) 1))
        k2 (chk (document-equal? (fget (at0 hp) :importer/code)
                                 (document-keyword :receipt/silent-hole)))
        k3 (chk (document-equal? (fget (at0 hp) :importer/msg)
                                 (document-string "cursor advanced past 2 records the sink did not take")))
        mv (rc/receipt (opts true 3 3 :held))
        l (chk (document-equal? (fget (at0 (rc/problems mv)) :importer/code)
                                (document-keyword :receipt/moved-without-sync)))
        sw (rc/receipt (opts false 3 3 :synced))
        m (chk (document-equal? (fget (at0 (rc/problems sw)) :importer/code)
                                (document-keyword :receipt/sync-without-move)))
        held (kv (kv (kv (opts false 0 0 :held)
                         :held-reason (document-keyword :no-progress))
                     :blobs (document-vector-conj (document-vector) (document-string "b1")))
                 :resync-required? (document-bool true))
        hr (rc/receipt held)
        n (chk (document-equal? (fget hr :importer.receipt/held-reason) (document-keyword :no-progress)))
        o (chk (document-equal? (fget hr :importer.receipt/blobs)
                                (document-vector-conj (document-vector) (document-string "b1"))))
        p (chk (document-equal? (fget hr :importer.receipt/resync-required?) (document-bool true)))
        q (chk (= (document-count (rc/problems hr)) 0))]
    (+ a (+ b (+ c (+ d (+ e (+ f (+ g (+ h (+ i (+ j (+ k (+ k2 (+ k3 (+ l (+ m (+ n (+ o (+ p q))))))))))))))))))))
