{:paths ["src"]
 ;; The connector kernel is the only dependency, and only `importer.connector`
 ;; uses it. An importer is a connector plus a cursor plus a sink, so the
 ;; descriptor model, the per-tool scope arithmetic and the invoke path are
 ;; inherited rather than re-spelled. Re-deriving them here is how one contract
 ;; acquires two spellings (ADR-2608097000 made the same call about
 ;; org-anthropic-mcp).
 :deps {
        io.github.kotoba-lang/pprint {:local/root "../kotoba.pprint"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/connector {:local/root "../kotoba.connector"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
