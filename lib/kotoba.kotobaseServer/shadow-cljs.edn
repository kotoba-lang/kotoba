;; Test-only build (this lib has no deploy target of its own -- see README).
{:deps {:aliases [:cljs :test-node]}
 ;; :autorun is deliberately OFF. With it on, the tests run DURING the
 ;; compile and `amu compile --target wasm32-browser test-node` exits 0 no matter how many
 ;; of them failed -- measured 2026-08-27: 4 failures, exit 0. CI runs
 ;; `npm run test:cljs`, so the gate could not go red. Running the emitted
 ;; bundle as its own step exits 1 on failure, which is the whole point.
 :builds {:test-node
          {:target :node-test :output-to "target/node-tests.js"
           :ns-regexp "-test$"}}}
