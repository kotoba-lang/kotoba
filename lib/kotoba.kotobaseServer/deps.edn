{:paths ["src"]
 ;; kotobase-server -- platform-independent XRPC handler + async/sync storage
 ;; bridge for a kotobase-peer-backed worker. No deploy surface, no
 ;; Cloudflare/R2/B2-specific code -- see README.md.
 ;; kotobase-peer pin: feature-frozen engine facade after the capability
 ;; split. Projection, federation, and maintenance behavior now lives in
 ;; their dedicated repositories; compatibility namespaces remain here.
 ;; kotobase-client pin: picks up kotobase.cid/did-key->ed25519-pub's
 ;; fail-closed fix (returns nil, not a throw, on malformed base58) --
 ;; kotobase.server.ipns requires kotobase.ipns (kotobase-client), whose
 ;; verify-head calls did-key->ed25519-pub directly to resolve the
 ;; signer's pubkey for every IPNS record signature check.
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/datom-source {:local/root "../kotoba.datomSource"}
        io.github.kotoba-lang/arrangement {:local/root "../kotoba.arrangement"}
        io.github.kotoba-lang/io-ipld {:local/root "../kotoba.ioIpld"}
        io.github.kotoba-lang/prolly-tree {:local/root "../kotoba.prollyTree"}
        io.github.kotoba-lang/org-w3-sparql-protocol {:local/root "../org.w3.sparqlProtocol"}
        io.github.kotoba-lang/dev-protobuf {:local/root "../kotoba.devProtobuf"}
        io.github.kotoba-lang/org-biscuitsec {:local/root "../org.biscuitsec.biscuit"}
        io.github.kotoba-lang/authority {:local/root "../kotoba.authority"}
        io.github.kotoba-lang/kotobase-peer
        {:git/url "https://github.com/kotoba-lang/kotobase-peer.git"
         :git/sha "d556d85d17e00218cda11e18b84944395e639b5b"}
        io.github.kotoba-lang/kotobase-client {:local/root "../kotoba.kotobaseClient"}
        io.github.kotoba-lang/kotobase-storage {:local/root "../kotoba.kotobaseStorage"}
        io.github.kotoba-lang/org-nist-sha2 {:local/root "../gov.nist.sha2"}
        io.github.kotoba-lang/org-ietf-hpke {:local/root "../org.ietf.hpke"}
        io.github.kotoba-lang/org-nist-aes
        {:git/url "https://github.com/kotoba-lang/org-nist-aes.git"
         :git/sha "d021bbe9f2d516d63bbbb2dd594aed93148fdf50"}}
 :aliases
 {}}
