#!/usr/bin/env kbb
;; Run this library's portable namespaces under ClojureScript.
;;
;;   bin/test-portable-cljs          (from the repository root)
;;
;; The JVM half runs the same namespaces from `kbb -M:test`. This half is
;; what makes the `.cljc` extension mean something: without it the JVM is the
;; only runtime that has ever executed them, and this library is almost
;; entirely `.cljc`.
;;
;; No classpath is asked of `deps.edn`: the portable namespaces depend on
;; nothing outside `src` and `test`, and a portable judgement that needed a
;; pinned interpreter to run would not be very portable.

(ns test-portable-cljs
  (:require ["node:child_process" :as cp]))

(let [{:keys [status]}
      (js->clj (cp/spawnSync "nbb" #js ["--classpath" "src:test"
                                        "test/portable_nbb.cljk"]
                             #js {:stdio "inherit" :encoding "utf8"})
               :keywordize-keys true)]
  (set! (.-exitCode js/process) (or status 1)))
