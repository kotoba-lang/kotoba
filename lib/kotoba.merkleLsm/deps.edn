{:paths ["src"]
 ;; ONE dependency, on purpose.
 ;;
 ;; The whole point of this repo is that the write-optimised physical store
 ;; needs nothing but content-addressed DAG-CBOR blocks: `ipld.core` supplies
 ;; encode/decode, CIDs and tag-42 links, and multiformats/cbor come in
 ;; transitively through it. There is no query engine, no arrangement, no
 ;; chain, no S3 client, and no cache implementation on this path -- runs and
 ;; manifests are values, and storage is a returned effect descriptor the HOST
 ;; interprets. If a change here needs a second dependency, that is a signal
 ;; the boundary is being crossed, not a missing coordinate.
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/io-ipld {:local/root "../kotoba.ioIpld"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
