;; SNMP is BER on the wire (RFC 1157 §4, RFC 3416 §2) — the tag/length/OID
;; codec is not this repo's job. It belongs to org-ietf-asn1, which already
;; implements it (X.690 tag classes incl. APPLICATION/CONTEXT, base-128 OID
;; subidentifiers, definite-length forms). This repo depends on it as a
;; workspace git dep rather than writing a second BER codec.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/org-ietf-asn1 {:local/root "../org.ietf.asn1"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
