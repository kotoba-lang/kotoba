(ns kotoba.lang.bounded-coll
  (:export [empty-string-set string-set-count string-set-contains?
            string-set-add string-set-remove string-set-equal?
            keyword-set-count keyword-set-contains?
            keyword-set-add keyword-set-remove keyword-set-equal?
            main]))

;; Sovereign bounded set kernel. General higher-order map/seq transforms stay in
;; the CLJC oracle until closures and generic collection ABI values are sealed.
;; Typed sets are canonical, duplicate-free, and compiler-bounded to 32 items.

(defn empty-string-set [] [:set :string]
  (typed-set-new [:set :string]))

(defn string-set-count [items [:set :string]] :i64
  (typed-set-count [:set :string] items))

(defn string-set-contains? [items [:set :string] item :string] :bool
  (typed-set-contains [:set :string] items item))

(defn string-set-add [items [:set :string] item :string] [:set :string]
  (typed-set-conj [:set :string] items item))

(defn string-set-remove [items [:set :string] item :string] [:set :string]
  (typed-set-disj [:set :string] items item))

(defn string-set-equal? [left [:set :string] right [:set :string]] :bool
  (if (typed-set-equal [:set :string] left right) true false))

(defn keyword-set-count [items [:set :keyword]] :i64
  (typed-set-count [:set :keyword] items))

(defn keyword-set-contains? [items [:set :keyword] item :keyword] :bool
  (typed-set-contains [:set :keyword] items item))

(defn keyword-set-add [items [:set :keyword] item :keyword] [:set :keyword]
  (typed-set-conj [:set :keyword] items item))

(defn keyword-set-remove [items [:set :keyword] item :keyword] [:set :keyword]
  (typed-set-disj [:set :keyword] items item))

(defn keyword-set-equal? [left [:set :keyword] right [:set :keyword]] :bool
  (if (typed-set-equal [:set :keyword] left right) true false))

(defn main [] :i64
  (let [s0 (empty-string-set)
        s1 (string-set-add s0 "actor")
        s2 (string-set-add s1 "actor")
        s3 (string-set-add s2 "io")
        s4 (string-set-remove s3 "io")
        k0 (typed-set-new [:set :keyword])
        k1 (keyword-set-add k0 :ready)]
    (if (= (string-set-count s2) 1)
      (if (string-set-contains? s2 "actor")
        (if (string-set-equal? s1 s4)
          (if (keyword-set-contains? k1 :ready) 42 4)
          3)
        2)
      1)))
