;; Kotoba port of lib/kotoba.coll/src/kotoba/coll/default_max_walk_depth.cljk.
;;
;; Named divergence: the .cljk defines a value `default-max-walk-depth` = 1024.
;; Cross-module constants fail E6004 in the kotoba checker, so the same value is
;; exported as a zero-arg function. Callers read it as (default-max-walk-depth).
(ns kotoba.coll.default-max-walk-depth
  (:export [default-max-walk-depth]))

(defn default-max-walk-depth [] :i64
  1024)
