;; Port of kotoba.coll.deep-merge (deep_merge.cljk), Kotoba-native.
;;
;; When both values are maps, merge them recursively; otherwise the right
;; value replaces the left (merge semantics, not conj).
;; Named divergences:
;;   - the source is 1-, 2- and variadic. amu cannot export multi-arity or
;;     variadic functions (E2138), so this module exports the 2-arity form as
;;     deep-merge and the fold over a vector of documents as deep-merge-all
;;     (deep-merge-all of one element is that element; of none is null).
(ns kotoba.coll.deep-merge
  (:export [deep-merge deep-merge-all]))

(defn- entry-part [m :document i :i64 j :i64] :document
  (option-value-of [:option :document]
                   (document-vector-at
                    (option-value-of [:option :document] (document-map-entry-at m i) (document-vector))
                    j)
                   (document-null)))

(defn deep-merge [a :document b :document] :document
  (if (and (= (document-kind a) :map) (= (document-kind b) :map))
    (let [n (document-count b)]
      (loop [i 0 acc a]
        (if (>= i n)
          acc
          (let [k (entry-part b i 0)
                bv (entry-part b i 1)
                merged (if (document-contains a k)
                         (deep-merge (option-value-of [:option :document] (document-get a k) (document-null)) bv)
                         bv)]
            (recur (+ i 1) (document-assoc acc k merged))))))
    b))

(defn deep-merge-all [xs :document] :document
  (let [n (document-count xs)]
    (if (= n 0)
      (document-null)
      (loop [i 1 acc (option-value-of [:option :document] (document-vector-at xs 0) (document-null))]
        (if (>= i n)
          acc
          (recur (+ i 1) (deep-merge acc (option-value-of [:option :document] (document-vector-at xs i) (document-null)))))))))
