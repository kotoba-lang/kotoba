;; Test for kotoba.coll.deep-merge. main returns the number of failed cases.
(ns kotoba.coll.deep-merge-test
  (:export [main])
  (:require [kotoba.coll.deep-merge :as dm]))

(defn- g [m :document k :keyword] :document
  (option-value-of [:option :document] (document-get m k) (document-null)))
(defn- i64v [m :document k :keyword] :i64
  (option-value-of [:option :i64] (document-i64-value (g m k)) -1))
(defn- nested-i64 [m :document k :keyword k2 :keyword] :i64
  (i64v (g m k) k2))
(defn- chk-i64 [got :i64 want :i64] :i64
  (if (= got want) 0 1))

(defn main [] :i64
  (let [a (document-map :x (document-i64 1)
                        :n (document-map :p (document-i64 1) :q (document-i64 2)))
        b (document-map :y (document-i64 5)
                        :n (document-map :q (document-i64 3) :r (document-i64 4)))
        m (dm/deep-merge a b)
        c1 (chk-i64 (i64v m :x) 1)
        c2 (chk-i64 (i64v m :y) 5)
        c3 (chk-i64 (nested-i64 m :n :p) 1)
        c4 (chk-i64 (nested-i64 m :n :q) 3)
        c5 (chk-i64 (nested-i64 m :n :r) 4)
        ov (dm/deep-merge (document-map :x (document-map :a (document-i64 1)))
                          (document-map :x (document-i64 7)))
        c6 (chk-i64 (i64v ov :x) 7)
        ta (dm/deep-merge-all (document-vector (document-map :a (document-i64 1))
                                               (document-map :a (document-i64 2))
                                               (document-map :b (document-i64 3))))
        c7 (chk-i64 (i64v ta :a) 2)
        c8 (chk-i64 (i64v ta :b) 3)]
    (+ c1 (+ c2 (+ c3 (+ c4 (+ c5 (+ c6 (+ c7 c8)))))))))
