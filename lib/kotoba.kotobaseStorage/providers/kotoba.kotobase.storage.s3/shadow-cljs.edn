{:deps {:aliases [:engine-test :prolly-engine-test]}
 :builds
 {;; nbb runs the other two suites, and cannot run this one: its dynamic
  ;; interop cannot dispatch `.then` through kotobase-peer's protocol-heavy
  ;; internals, and fails with a stack entirely inside nbb itself. A real
  ;; ClojureScript compiler is the difference between "the engine does not
  ;; work on R2" and "the runner cannot tell".
  :engine-r2 {:target :node-script
              :output-to "out/engine-r2.js"
              :main engine-r2/-main
              :compiler-options {:optimizations :none}}

  :prolly-engine-r2
  {:target :node-script
   :output-to "out/prolly-engine-r2.js"
   :main prolly-engine-r2/-main
   :compiler-options {:optimizations :none}}

  ;; Advanced, because that is what a Workers build ships and because the
  ;; only bug this repo has had in production-shaped code was invisible at
  ;; every other optimisation level.
  :measure {:target :node-script
            :output-to "out/measure.js"
            :main prolly-measure/-main
            :compiler-options {:optimizations :none}}

  :advanced-r2 {:target :node-script
                :output-to "out/advanced-r2.js"
                :main advanced-r2/-main
                :compiler-options {:optimizations :advanced
                                   :source-map false}}

  ;; The live R2 benchmark worker. :esm because wrangler wants an ES module
  ;; with a default export, and because writing the worker in JavaScript would
  ;; make it the only .mjs in a repository whose 15 other runners are all
  ;; ClojureScript.
  :r2-live-worker {:target :esm
                   :output-dir "out/r2-live-worker"
                   :modules {:worker {:exports {:default r2-live-worker/worker}}}
                   :compiler-options {:optimizations :advanced
                                      :source-map false}}}}
