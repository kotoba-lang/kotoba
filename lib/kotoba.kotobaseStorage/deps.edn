{:paths ["src"]
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; io-multiformats is a TEST-ONLY dependency on purpose.
         ;; `kotobase.storage.object-id` assembles base32/multihash/CIDv1 with
         ;; no dependencies, because this library sits under every provider
         ;; including Worker builds and io-multiformats pulls @noble/hashes on
         ;; :cljs. Zero-dep and second-implementation are both real costs; the
         ;; one we refuse to pay is SILENT drift, so the suite checks our
         ;; arithmetic against theirs (which is byte-identical to
         ;; `ipfs add --cid-version=1 --raw-leaves`).
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/io-multiformats
                      {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
                       :git/sha "d2f43630eb893eea74ab580fdd7d09263f8e7362"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; The async suite carries its own oracles (test/run.cljk): the
  ;; concurrent half behaves differently on one event loop than on JVM
  ;; threads, and "passes on the JVM" is not evidence for the Worker path
  ;; every provider in this family actually deploys on.
  :cljs-test {:extra-paths ["test"]
              :extra-deps {org.clojure/clojurescript
                           {:mvn/version "1.11.132"}}}

  ;; `kbb -M:cljs-compile`
  ;;
  ;; Not a third test suite — it runs no assertions. It asks the one question
  ;; neither existing gate can: does this namespace COMPILE with the
  ;; ClojureScript compiler.
  ;;
  ;; `kbb -M:test` runs on the JVM and `kbb --backend sci test/run.cljk` runs on SCI,
  ;; and in both of those `satisfies?` is an ordinary function. In compiled
  ;; ClojureScript it is a macro that resolves its protocol argument at
  ;; compile time, so a computed protocol is not a slower spelling of the
  ;; same thing — it is a namespace that does not build. That shipped in
  ;; `validate-object-store!` on 2026-08-16 and both gates stayed green,
  ;; because an interpreter cannot fail a macroexpansion the way a compiler
  ;; does. It was found by a downstream Worker build, which is the wrong
  ;; place to find it: every provider in this family deploys through
  ;; shadow-cljs, and this library sits under all of them.
  :cljs-compile
  {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}
   :main-opts ["-m" "cljs.main" "-t" "node" "-O" "none"
               "-d" "target/cljs-compile"
               "-c" "kotobase.storage.object"
               "-c" "kotobase.storage.core"
               "-c" "kotobase.storage.observed-ref"
               "-c" "kotobase.storage.signed-head"
               "-c" "kotobase.storage.verify"
               "-c" "kotobase.storage.ordered-map"]}}}
