{:paths ["src"]
 ;; kotobase-query (kotoba-lang/kotobase-query) provides the bridge from
 ;; kotobase.store/IStore documents to real cross-record Datalog queries
 ;; (kotobase.query.bridge/materialize + q/query, ADR-2607172300 in
 ;; com-junkawasaki/root) -- kotobase.pg.sql translates the small v0.1 SQL
 ;; subset onto that bridge's :find/:where shape and delegates all actual
 ;; query evaluation to it, same "thin translator, not a reimplementation"
 ;; discipline kotobase-query itself follows relative to arrangement.
 ;;
 ;; kotobase (kotoba-lang/kotobase) is also a DIRECT dep here (not just
 ;; transitive via kotobase-query) because kotobase.pg.sql's own tests
 ;; build fixture stores directly with kotobase.local/kotobase.store, the
 ;; same pattern kotobase-query's own bridge_test.cljc uses.
 ;;
 ;; kotobase-query's own deps.edn pulls in arrangement (the 4-covering
 ;; index + Datalog engine), which in turn pulls in prolly-tree/io-ipld
 ;; (its commit!/CID-snapshot machinery, unused here but required at
 ;; namespace-load time), which pull in io-multiformats/org-ietf-cbor --
 ;; tools.deps resolves that whole chain transitively from the two direct
 ;; deps below for the JVM :test alias. The nbb primary test path has no
 ;; dependency resolver, so bin/run_tests.cljk / CI clone each transitive
 ;; dep by hand and list every src dir on --classpath -- see the README's
 ;; Develop/test section for the exact command.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/kotobase-query {:local/root "../kotoba.ayatori"}
        io.github.kotoba-lang/kotobase
        {:git/sha "bbf57df9dde5c1869182012860129a598382e088"}}
 ;; First-class runtime is nbb/cljs (repo-wide runtime priority: kotoba
 ;; wasm > clojurewasm > cljs > nbb > (jvm/bb)):
 ;;   kbb --backend sci --classpath "src:test:.deps/kotobase-query/src:.deps/kotobase/src:.deps/arrangement/src:.deps/prolly-tree/src:.deps/io-ipld/src:.deps/io-multiformats/src:.deps/org-ietf-cbor/src" bin/run_tests.cljk
 ;; The :test alias below is the JVM COMPAT suite for the pure `.cljc`
 ;; core (kotobase.pg.sql -- the SQL parser/translator/executor) only --
 ;; it never loads anything under src/kotobase/pg/wire.cljk (`.cljs`-only,
 ;; node:net + Buffer, cannot run on the JVM at all; see that namespace's
 ;; own docstring).
 :aliases
 {:test {:extra-paths ["test"]}}}
