;; Which workspace contract THIS repo claims to satisfy.
;;
;; The authority these declarations are checked against lives in the
;; superproject at manifest/repository-rules.edn (ADR-2607299000); this file
;; exists so a reader of jiten alone can still see which contract it claims.

{:schema "kotoba.repository-role-rules.v0"

 :vocabulary/id :name-prefix

 :prefix nil
 :role :library
 :must [:provide-reusable-contract]
 :must-not [:own-ingest-schedule :require-resident-runner :own-ci-state]

 :declares
 {:name "jiten"
  :owns ["the admissibility contract for an encyclopedic entry"
         "statement-level sourcing semantics"
         "notability bases and their checkable conditions"
         "link kinds, red-link semantics, :part-of acyclicity"
         "statement-granular revision diff"
         "the Datomic / DataScript / flat-plane projection"]
  :does-not-own ["storage (kotobase)"
                 "version history (kotobase :as-of / :since / :history)"
                 "rendering"
                 "ingest scheduling — a loop-* orchestrator would own that"
                 "any sourced corpus — real claims live in a corpus repo, never here"]
  :third-party-deps []
  :vocabulary-shared-with
  {"kotoba-lang/innen" [:confidences :topic-kinds/first-ten :company/lei :innen.node/wikidata]}}}
