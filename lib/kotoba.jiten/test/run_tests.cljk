(ns run-tests
  (:require [cljs.test :as t]
            [jiten.core-test]
            [jiten.link-test]
            [jiten.revision-test]
            [jiten.schema-test]
            [jiten.tx-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (when-not (t/successful? m)
    (js/process.exit 1)))

(t/run-tests 'jiten.schema-test 'jiten.link-test 'jiten.revision-test
             'jiten.core-test 'jiten.tx-test)
