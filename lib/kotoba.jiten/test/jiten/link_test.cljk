(ns jiten.link-test
  (:require [kotoba.test :refer [deftest is testing]]
            [jiten.fixtures :as f]
            [jiten.link :as link]))

(defn- codes [problems] (set (map :jiten/code problems)))
(defn- errors [problems] (filter #(= :error (:jiten/severity %)) problems))

(deftest fixture-links-resolve
  (is (empty? (errors (link/problems f/corpus-entries)))))

(deftest red-link-is-a-warning-never-an-error
  (let [e (f/entry :entry/x "X" :links [{:jiten.link/to :entry/nowhere :jiten.link/kind :see-also}])
        p (link/problems [e])]
    (is (contains? (codes p) :link/red))
    (is (empty? (errors p))
        "a red link is how an encyclopedia states what it is missing")))

(deftest a-malformed-target-is-an-error
  (let [e (f/entry :entry/x "X" :links [{:jiten.link/to "entry/b" :jiten.link/kind :see-also}])]
    (is (contains? (codes (link/problems [e])) :link/target-not-keyword))))

(deftest missing-targets-rank-by-how-many-entries-want-them
  (let [want (fn [id to] (f/entry id (name id) :links [{:jiten.link/to to :jiten.link/kind :see-also}]))
        entries [(want :entry/1 :entry/wanted)
                 (want :entry/2 :entry/wanted)
                 (want :entry/3 :entry/lonely)]
        ranked (link/missing-targets (link/index entries))]
    (is (= :entry/wanted (:jiten.link/to (first ranked))))
    (is (= 2 (:jiten/referenced-by (first ranked))))
    (is (= [:entry/1 :entry/2] (:jiten/from (first ranked))))))

(deftest translation-links-must-actually-cross-languages
  (testing "same language is not a translation"
    (let [a (f/entry :entry/a "A" :lang "en" :subject :node/a
                     :links [{:jiten.link/to :entry/a2 :jiten.link/kind :translation-of}])
          a2 (f/entry :entry/a2 "A again" :lang "en" :subject :node/a)]
      (is (contains? (codes (link/problems [a a2])) :link/translation-same-lang))))
  (testing "different subjects are two entries, not two languages"
    (let [a (f/entry :entry/a "A" :lang "en" :subject :node/a
                     :links [{:jiten.link/to :entry/b :jiten.link/kind :translation-of}])
          b (f/entry :entry/b "B" :lang "ja" :subject :node/b)]
      (is (contains? (codes (link/problems [a b])) :link/translation-different-subject))))
  (testing "the fixture pair is a real translation"
    (is (not (contains? (codes (link/problems f/corpus-entries)) :link/translation-same-lang)))))

(deftest part-of-cycles-are-detected
  (let [mk (fn [id to] (f/entry id (name id) :links [{:jiten.link/to to :jiten.link/kind :part-of}]))
        entries [(mk :entry/a :entry/b) (mk :entry/b :entry/c) (mk :entry/c :entry/a)]]
    (is (seq (link/part-of-cycles (link/index entries))))
    (is (contains? (codes (link/problems entries)) :link/part-of-cycle)))
  (testing "a plain hierarchy has none"
    (let [mk (fn [id to] (f/entry id (name id) :links [{:jiten.link/to to :jiten.link/kind :part-of}]))
          entries [(mk :entry/a :entry/b) (mk :entry/b :entry/c) (f/entry :entry/c "C")]]
      (is (empty? (link/part-of-cycles (link/index entries)))))))

(deftest disambiguates-only-from-a-disambiguation-entry
  (let [bad (f/entry :entry/a "A" :links [{:jiten.link/to :entry/b :jiten.link/kind :disambiguates}])
        b (f/entry :entry/b "B")]
    (is (contains? (codes (link/problems [bad b])) :link/disambiguates-from-non-disambiguation)))
  (let [ok (f/entry :entry/d "D" :form :disambiguation :body []
                    :links [{:jiten.link/to :entry/b :jiten.link/kind :disambiguates}])
        b (f/entry :entry/b "B")]
    (is (not (contains? (codes (link/problems [ok b])) :link/disambiguates-from-non-disambiguation)))))

(deftest inline-mentions-become-links-and-keep-their-statement
  (let [e (f/entry :entry/a "A"
                   :body [(f/section :lead "Lead"
                                     [(f/stmt :s/a1 "A mentions B."
                                              {:jiten.statement/links [:entry/b]})])])
        b (f/entry :entry/b "B")
        idx (link/index [e b])
        inline (first (filter :jiten.link/inline? (:links idx)))]
    (is (= :entry/b (:jiten.link/to inline)))
    (is (= :s/a1 (:jiten.link/statement inline))
        "a broken mention has to be traceable to the sentence that made it")
    (is (= [:entry/a] (link/backlinks idx :entry/b)))))

(deftest self-link-is-refused
  (let [e (f/entry :entry/a "A" :links [{:jiten.link/to :entry/a :jiten.link/kind :see-also}])]
    (is (contains? (codes (link/problems [e])) :link/self))))

(deftest orphans-are-listed
  (let [a (f/entry :entry/a "A" :links [{:jiten.link/to :entry/b :jiten.link/kind :see-also}])
        b (f/entry :entry/b "B")
        c (f/entry :entry/c "C")]
    (is (= [:entry/a :entry/c] (link/orphans (link/index [a b c]))))))
