(ns jiten.tx-test
  "Synthetic fixtures -- see jiten.fixtures' docstring for why."
  (:require [kotoba.lang.edn :as edn]
            [kotoba.test :refer [deftest is testing]]
            [jiten.core :as c]
            [jiten.fixtures :as f]
            [jiten.tx :as tx]))

(def g (c/corpus f/corpus-entries))

(deftest schema-forms-agree
  (let [dsc (tx/datascript-schema)
        dtm (into {} (map (juxt :db/ident identity)) (tx/datomic-schema))]
    (testing "every attribute appears in the Datomic schema"
      (is (= (set (keys tx/attributes)) (set (keys dtm)))))
    (testing "refs and unique identities survive into the DataScript form"
      (is (= :db.type/ref (get-in dsc [:jiten.statement/entry :db/valueType])))
      (is (= :db.unique/identity (get-in dsc [:jiten.entry/id :db/unique])))
      (is (= :db.unique/identity (get-in dtm [:jiten.statement/id :db/unique]))))
    (testing "cardinality/many survives"
      (is (= :db.cardinality/many (get-in dsc [:jiten.notability/sources :db/cardinality])))
      (is (= :db.cardinality/many (get-in dtm [:jiten.statement/links :db/cardinality]))))
    (testing "plain scalars are omitted from the DataScript form (it needs no declaration)"
      (is (not (contains? dsc :jiten.entry/title))))))

(deftest join-keys-are-carried-verbatim
  (testing "renaming these into a jiten namespace would break the only reason they are here"
    (is (contains? tx/attributes :company/lei))
    (is (contains? tx/attributes :innen.node/wikidata))
    (is (not (contains? tx/attributes :jiten.entry/lei)))
    (is (not (contains? tx/attributes :jiten.entry/wikidata)))))

(deftest no-attribute-judges-the-subject
  (testing "the gate is the attribute not existing: Datomic refuses an unknown
            attribute and DataScript cannot resolve one, so this is 'cannot be
            written', not 'written as false'"
    (doseq [absent [:jiten.entry/rating :jiten.entry/rank :jiten.entry/score
                    :jiten.entry/quality :jiten.entry/verdict :jiten.entry/truth-rating
                    :jiten.entry/abstract]]
      (is (not (contains? tx/attributes absent)) (str absent " must not be projectable")))))

(deftest three-entity-types-in-dependency-order
  (let [t (tx/->tx g {:dataset "jiten-test"})
        kind (fn [m] (cond (:jiten.entry/title m) :entry
                           (:jiten.section/heading m) :section
                           (:jiten.statement/text m) :statement
                           (:jiten.link/kind m) :link))
        order (map kind t)]
    (testing "entries, then sections, then statements, then links -- so lookup refs resolve in one transaction"
      (is (= [:entry :section :statement :link] (distinct order))))
    (testing "every entity is stamped with its corpus"
      (is (every? #(= "jiten-test" (:source/dataset %)) t)))))

(deftest statements-are-entities-with-their-own-identity
  (let [t (tx/->tx g)
        s (first (filter :jiten.statement/text t))]
    (is (keyword? (:jiten.statement/id s)))
    (is (= [:jiten.entry/id :entry/a] (:jiten.statement/entry s)))
    (is (= [:jiten.section/id (tx/section-id :entry/a :lead)] (:jiten.statement/section s)))
    (is (= 0 (:jiten.statement/ordinal s)))
    (is (string? (:jiten.statement/source s))
        "this is what makes 'which claims cite this source' a Datalog query")))

(deftest sections-survive-even-when-empty
  (let [e (f/entry :entry/x "X" :body [(f/section :lead "Lead" [(f/stmt :s/1 "one")])
                                       (f/section :later "Considered" [])])
        t (tx/->tx (c/corpus* [e]))
        secs (filter :jiten.section/heading t)]
    (is (= 2 (count secs)))
    (is (= ["Lead" "Considered"] (map :jiten.section/heading secs))
        "if an empty section vanished, the record that a topic was considered would be lost")
    (is (= [0 1] (map :jiten.section/ordinal secs)))))

(deftest section-ids-are-composed-so-writers-need-only-local-uniqueness
  (is (= (tx/section-id :entry/a :lead) (tx/section-id :entry/a :lead)))
  (is (not= (tx/section-id :entry/a :lead) (tx/section-id :entry/b :lead))))

(deftest notability-is-flattened-onto-the-entry
  (let [t (tx/->tx g)
        e (first (filter :jiten.entry/title t))]
    (is (= :independent-sources (:jiten.notability/basis e)))
    (is (= 2 (count (:jiten.notability/sources e))))
    (is (not (contains? e :jiten.entry/notability))
        "the nested map does not survive as a value; neither Datomic nor the flat plane can store one")
    (is (not (contains? e :jiten.entry/body)))))

(deftest a-red-link-carries-no-ref
  (let [e (f/entry :entry/a "A" :links [{:jiten.link/to :entry/nowhere :jiten.link/kind :see-also}])
        t (tx/->tx (c/corpus* [e]))
        l (first (filter :jiten.link/kind t))]
    (is (= :entry/nowhere (:jiten.link/to-id l)))
    (is (not (contains? l :jiten.link/to))
        "there is no entity to point at, and inventing one would turn a known gap into a phantom entry")
    (is (false? (:jiten.link/resolved? l)))
    (is (= [:jiten.entry/id :entry/a] (:jiten.link/from l)))))

(deftest a-resolved-link-carries-both
  (let [t (tx/->tx g)
        l (first (filter #(= :see-also (:jiten.link/kind %)) t))]
    (is (= [:jiten.entry/id :entry/b] (:jiten.link/to l)))
    (is (= :entry/b (:jiten.link/to-id l)))
    (is (true? (:jiten.link/resolved? l)))))

(deftest the-flat-plane-can-still-tell-a-red-link-from-a-resolved-one
  (testing "found by running the projection into datascript.js: the flat form
            strips :jiten.link/to, so without an explicit boolean every link
            reads as missing on exactly the plane most likely to ask"
    (let [a (f/entry :entry/a "A" :links [{:jiten.link/to :entry/b :jiten.link/kind :see-also}
                                          {:jiten.link/to :entry/gone :jiten.link/kind :see-also}])
          b (f/entry :entry/b "B")
          t (tx/->flat-tx (c/corpus* [a b]))
          links (filter :jiten.link/kind t)
          by-target (into {} (map (juxt :jiten.link/to-id :jiten.link/resolved?)) links)]
      (is (every? #(not (contains? % :jiten.link/to)) links))
      (is (= {:entry/b true :entry/gone false} by-target)))))

(deftest link-ids-are-stable-so-reingest-upserts
  (let [t1 (tx/->tx g)
        t2 (tx/->tx (c/corpus f/corpus-entries))]
    (is (= (map :jiten.link/id (filter :jiten.link/kind t1))
           (map :jiten.link/id (filter :jiten.link/kind t2))))))

(deftest flat-projection-has-no-refs
  (let [t (tx/->flat-tx g {:dataset "jiten-test"})]
    (is (every? (fn [m] (not-any? vector? (vals m))) (remove :jiten.notability/sources t))
        "the unified query plane's loader has no notion of refs")
    (testing "but keeps the plain-keyword twins, so the same joins are still expressible"
      (let [s (first (filter :jiten.statement/text t))]
        (is (= :entry/a (:jiten.statement/entry-id s)))
        (is (not (contains? s :jiten.statement/entry)))))))

(deftest revisions-are-projected-separately
  (testing "revisions accumulate per edit; a corpus projection is a snapshot"
    (is (not-any? :jiten.rev/author (tx/->tx g)))
    (is (= "did:key:zTest" (:jiten.rev/author (tx/revision->entity {:jiten.rev/author "did:key:zTest"
                                                                    :jiten.rev/note nil}))))))

(deftest every-composed-id-survives-an-edn-round-trip
  (testing "found by POSTing the projection to kotobase: `~` prints fine and
            throws on the way back in, so the server rejected the whole body.
            A projection that only ever moves through memory never notices."
    (let [t (tx/->flat-tx g)
          ids (concat (keep :jiten.section/id t)
                      (keep :jiten.statement/id t)
                      (keep :jiten.link/id t)
                      (keep :jiten.entry/id t))]
      (is (seq ids))
      (doseq [id ids]
        (is (tx/id-readable? id) (str (pr-str id) " is not readable as EDN")))
      (testing "and the reader agrees, not just the predicate"
        (is (= (vec ids) (edn/read-string (pr-str (vec ids)))))))))

(deftest id-readable-rejects-the-character-that-caused-it
  (is (not (tx/id-readable? (keyword "jiten.section" "a~b"))))
  (is (tx/id-readable? (keyword "jiten.section" "a$b"))))
