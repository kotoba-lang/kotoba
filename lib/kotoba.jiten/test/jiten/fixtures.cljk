(ns jiten.fixtures
  "Synthetic fixtures, on purpose.

   Real encyclopedic claims do not belong in a test fixture. A fact asserted only
   inside a passing test looks verified when all the test proved is that the code
   accepted a string -- and for a record whose entire premise is that every claim
   is traceable, seeding it with untraceable ones inside the test suite would be
   the exact failure it exists to prevent. Sourced corpora live in a corpus repo.
   `jiten.fixtures` says `\"Test org A\"` and cites `\"fixture\"`.")

(defn stmt
  ([id text] (stmt id text {}))
  ([id text overrides]
   (merge {:jiten.statement/id id
           :jiten.statement/text text
           :jiten.statement/source "fixture: synthetic test data, 2026-07-29"
           :jiten.statement/confidence :documented}
          overrides)))

(defn section
  ([id heading statements] {:jiten.section/id id
                            :jiten.section/heading heading
                            :jiten.section/statements (vec statements)}))

(defn entry
  [id title & {:keys [lang form topic-kind subject body links notability]
               :or {lang "en" form :article topic-kind :organization}}]
  (cond-> {:jiten.entry/id id
           :jiten.entry/title title
           :jiten.entry/lang lang
           :jiten.entry/form form
           :jiten.entry/topic-kind topic-kind
           :jiten.entry/body (vec (or body
                                      [(section :lead "Lead"
                                                [(stmt (keyword "s" (str (name id) "-1"))
                                                       (str title " is a synthetic fixture."))])]))}
    subject (assoc :jiten.entry/subject subject)
    links (assoc :jiten.entry/links (vec links))
    (not= form :disambiguation)
    (assoc :jiten.entry/notability
           (or notability
               {:jiten.notability/basis :independent-sources
                :jiten.notability/sources ["fixture source one" "fixture source two"]}))
    (= form :disambiguation) (dissoc :jiten.entry/notability)))

(def entry-a
  (entry :entry/a "Test org A"
         :subject :node/a
         :links [{:jiten.link/to :entry/b :jiten.link/kind :see-also}]))

(def entry-b
  (entry :entry/b "Test org B"
         :subject :node/b))

(def entry-a-ja
  (entry :entry/a-ja "テスト組織A"
         :lang "ja"
         :subject :node/a
         :links [{:jiten.link/to :entry/a :jiten.link/kind :translation-of}]))

(def corpus-entries [entry-a entry-b entry-a-ja])
