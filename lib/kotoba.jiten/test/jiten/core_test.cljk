(ns jiten.core-test
  (:require [kotoba.test :refer [deftest is testing]]
            [jiten.core :as c]
            [jiten.fixtures :as f]))

(defn- codes [problems] (set (map :jiten/code problems)))

(deftest corpus-builds-from-the-fixture
  (let [g (c/corpus f/corpus-entries)]
    (is (= 3 (count (c/entries g))))
    (is (= "Test org A" (:jiten.entry/title (c/entry g :entry/a))))))

(deftest corpus-refuses-on-an-error
  (let [bad (update-in f/entry-a [:jiten.entry/body 0 :jiten.section/statements 0]
                       dissoc :jiten.statement/source)]
    (is (thrown? #?(:clj clojure.lang.ExceptionInfo :cljs js/Error)
                 (c/corpus [bad])))
    (testing "corpus* keeps going and carries the problems, which is what an ingest pass needs"
      (let [g (c/corpus* [bad])]
        (is (seq (c/errors g)))
        (is (= 1 (count (c/entries g))))))))

(deftest duplicate-statement-ids-are-caught-before-they-upsert
  (let [a (f/entry :entry/a "A" :body [(f/section :lead "Lead" [(f/stmt :s/dup "one")])])
        b (f/entry :entry/b "B" :body [(f/section :lead "Lead" [(f/stmt :s/dup "a different claim")])])
        g (c/corpus* [a b])]
    (is (contains? (codes (c/problems-of g)) :corpus/duplicate-statement-id))))

(deftest duplicate-entry-and-section-ids-are-caught
  (let [g (c/corpus* [f/entry-a f/entry-a])]
    (is (contains? (codes (c/problems-of g)) :corpus/duplicate-entry-id)))
  (let [e (f/entry :entry/a "A" :body [(f/section :lead "Lead" [(f/stmt :s/1 "one")])
                                       (f/section :lead "Lead again" [(f/stmt :s/2 "two")])])]
    (is (contains? (codes (c/problems-of (c/corpus* [e]))) :corpus/duplicate-section-id))))

(deftest sources-invert-the-record
  (let [a (f/entry :entry/a "A" :body [(f/section :lead "Lead"
                                                  [(f/stmt :s/1 "one" {:jiten.statement/source "SRC-X"})
                                                   (f/stmt :s/2 "two" {:jiten.statement/source "SRC-Y"})])])
        b (f/entry :entry/b "B" :body [(f/section :lead "Lead"
                                                  [(f/stmt :s/3 "three" {:jiten.statement/source "SRC-X"})])])
        g (c/corpus [a b])]
    (is (= [:s/1 :s/3] (get (c/sources g) "SRC-X"))
        "given a source that turns out to be wrong, this is the list of claims to revisit")))

(deftest single-source-entries-are-listable
  (let [a (f/entry :entry/a "A")                          ; fixture: one statement, one source
        b (f/entry :entry/b "B" :body [(f/section :lead "Lead"
                                                  [(f/stmt :s/1 "one" {:jiten.statement/source "SRC-X"})
                                                   (f/stmt :s/2 "two" {:jiten.statement/source "SRC-Y"})])])]
    (is (= [:entry/a] (c/single-source-entries (c/corpus [a b]))))))

(deftest entries-about-crosses-languages
  (let [g (c/corpus f/corpus-entries)]
    (is (= [:entry/a :entry/a-ja] (map :jiten.entry/id (c/entries-about g :node/a)))
        "the subject is the join key from the start, so two languages are not an undiscovered fork")
    (is (= #{:node/a :node/b} (set (c/subjects g))))))

(deftest coverage-against-an-external-record
  (let [g (c/corpus f/corpus-entries)
        cov (c/coverage g [:node/a :node/b :node/c :node/d])]
    (is (= [:node/a :node/b] (:covered cov)))
    (is (= [:node/c :node/d] (:uncovered cov)))
    (is (= 0.5 (:ratio cov)))))

(deftest frontier-marks-targets-the-outside-world-believes-in
  (let [a (f/entry :entry/a "A" :links [{:jiten.link/to :entry/missing :jiten.link/kind :see-also}])
        g (c/corpus* [a])
        fr (c/frontier g #{:entry/missing})]
    (is (= :entry/missing (:jiten.link/to (first fr))))
    (is (true? (:jiten/in-external-record (first fr))))))

(deftest contested-statements-carry-their-dissent
  (let [e (f/entry :entry/a "A"
                   :body [(f/section :lead "Lead"
                                     [(f/stmt :s/1 "founded in 1602"
                                              {:jiten.statement/confidence :contested
                                               :jiten.statement/dissent "the charter is dated 1601 in source B"})])])
        [got] (c/contested (c/corpus [e]))]
    (is (= :s/1 (:jiten.statement/id got)))
    (is (= "the charter is dated 1601 in source B" (:jiten.statement/dissent got)))))

(deftest title-collisions-need-a-disambiguation
  (let [a (f/entry :entry/a "Mercury" :lang "en")
        b (f/entry :entry/b "mercury" :lang "en")
        d (f/entry :entry/d "Mercury" :lang "en" :form :disambiguation :body [])]
    (is (seq (c/title-collisions (c/corpus [a b]))))
    (testing "and stop being reported once one exists"
      (is (empty? (c/title-collisions (c/corpus* [a b d])))))))

(deftest explain-attaches-a-citation-to-each-claim
  (let [g (c/corpus f/corpus-entries)
        x (c/explain g :entry/a)]
    (is (= :node/a (:jiten.entry/subject x)))
    (is (every? :jiten.statement/source (:jiten/claims x)))
    (is (= [:entry/a-ja] (:jiten/backlinks x)))))

(deftest stats-counts-without-judging
  (let [s (c/stats (c/corpus f/corpus-entries))]
    (is (= 3 (:entries s)))
    (is (= 3 (:statements s)))
    (is (= #{"en" "ja"} (set (:languages s))))
    (is (= {:documented 3} (:confidence s)))))
