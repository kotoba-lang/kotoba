(ns jiten.revision-test
  (:require [kotoba.test :refer [deftest is testing]]
            [jiten.fixtures :as f]
            [jiten.revision :as rev]))

(defn- codes [problems] (set (map :jiten/code problems)))

(def ok-rev
  {:jiten.rev/entry :entry/a
   :jiten.rev/author "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK"
   :jiten.rev/at "2026-07-29T10:00:00Z"
   :jiten.rev/reason "added the founding date with a registry citation"
   :jiten.rev/basis "bafyreiabc123"})

(deftest a-valid-revision-passes
  (is (empty? (rev/revision-problems ok-rev))))

(deftest an-edit-must-say-why
  (is (contains? (codes (rev/revision-problems (dissoc ok-rev :jiten.rev/reason))) :rev/no-reason))
  (is (contains? (codes (rev/revision-problems (assoc ok-rev :jiten.rev/reason "  "))) :rev/no-reason)))

(deftest the-author-is-a-did
  (is (contains? (codes (rev/revision-problems (assoc ok-rev :jiten.rev/author "jun"))) :rev/author-not-did))
  (is (contains? (codes (rev/revision-problems (dissoc ok-rev :jiten.rev/author))) :rev/no-author)))

(deftest a-missing-basis-warns-but-does-not-refuse
  (let [p (rev/revision-problems (dissoc ok-rev :jiten.rev/basis))]
    (is (contains? (codes p) :rev/no-basis))
    (is (every? #(= :warn (:jiten/severity %)) p))))

(deftest diff-is-by-statement-id-not-by-text-position
  (let [v1 (f/entry :entry/a "A"
                    :body [(f/section :lead "Lead" [(f/stmt :s/1 "one") (f/stmt :s/2 "two")])])
        ;; same claims, reordered and re-headed: no claim changed
        v2 (f/entry :entry/a "A"
                    :body [(f/section :lead "Lead" [(f/stmt :s/2 "two") (f/stmt :s/1 "one")])])
        d (rev/diff v1 v2)]
    (is (empty? (:added d)))
    (is (empty? (:removed d)))
    (is (empty? (:changed d)))
    (is (= 2 (count (:moved d)))
        "a reflow is a move, not a change to the claim")))

(deftest diff-names-the-attributes-that-changed
  (let [v1 (f/entry :entry/a "A" :body [(f/section :lead "Lead" [(f/stmt :s/1 "one")])])
        v2 (f/entry :entry/a "A" :body [(f/section :lead "Lead"
                                                   [(f/stmt :s/1 "one" {:jiten.statement/source "a different source"})])])
        d (rev/diff v1 v2)
        c (first (:changed d))]
    (is (= :s/1 (:jiten.statement/id c)))
    (is (= [:jiten.statement/source] (:jiten/attrs c))
        "a changed citation on an unchanged claim is the decay this exists to catch")))

(deftest diff-tracks-added-removed-and-sections
  (let [v1 (f/entry :entry/a "A" :body [(f/section :lead "Lead" [(f/stmt :s/1 "one")])])
        v2 (f/entry :entry/a "A" :body [(f/section :lead "Lead" [(f/stmt :s/2 "two")])
                                        (f/section :history "History" [(f/stmt :s/3 "three")])])
        d (rev/diff v1 v2)]
    (is (= [:s/2 :s/3] (:added d)))
    (is (= [:s/1] (:removed d)))
    (is (= [:history] (get-in d [:sections :added])))))

(deftest unsourced-after-catches-the-quiet-decay
  (let [v1 (f/entry :entry/a "A" :body [(f/section :lead "Lead" [(f/stmt :s/1 "one")])])
        v2 (f/entry :entry/a "A" :body [(f/section :lead "Lead"
                                                   [(f/stmt :s/1 "one" {:jiten.statement/source ""})])])]
    (is (rev/unsourced-after? (rev/diff v1 v2)))
    (is (not (rev/unsourced-after? (rev/diff v1 v1))))))

(deftest summarize-reads
  (let [v1 (f/entry :entry/a "A" :body [(f/section :lead "Lead" [(f/stmt :s/1 "one")])])]
    (is (= "no statement-level change" (rev/summarize (rev/diff v1 v1))))
    (testing "and counts what moved"
      (let [v2 (f/entry :entry/a "A" :body [(f/section :lead "Lead" [(f/stmt :s/1 "one") (f/stmt :s/2 "two")])])]
        (is (re-find #"\+1 statement" (rev/summarize (rev/diff v1 v2))))))))
