(ns jiten.schema-test
  (:require [kotoba.test :refer [deftest is testing]]
            [jiten.fixtures :as f]
            [jiten.schema :as s]))

(defn- codes [problems] (set (map :jiten/code problems)))
(defn- errors [problems] (filter #(= :error (:jiten/severity %)) problems))

(deftest admissible-fixture
  (is (s/admissible? f/corpus-entries)
      "the fixture corpus must itself be admissible, or every other test is testing the fixture"))

(deftest statement-needs-a-source
  (testing "sourcing is fail-closed, not a warning"
    (let [p (s/statement-problems (dissoc (f/stmt :s/1 "a claim") :jiten.statement/source))]
      (is (contains? (codes p) :statement/no-source))
      (is (= :error (:jiten/severity (first (filter #(= :statement/no-source (:jiten/code %)) p)))))))
  (testing "a blank string is not a source either"
    (is (contains? (codes (s/statement-problems (f/stmt :s/1 "a claim" {:jiten.statement/source "   "})))
                   :statement/no-source))))

(deftest statement-needs-a-declared-confidence
  (is (contains? (codes (s/statement-problems (dissoc (f/stmt :s/1 "x") :jiten.statement/confidence)))
                 :statement/unknown-confidence))
  (is (contains? (codes (s/statement-problems (f/stmt :s/1 "x" {:jiten.statement/confidence :pretty-sure})))
                 :statement/unknown-confidence)))

(deftest weak-confidences-carry-obligations
  (testing ":contested must record the disagreement"
    (is (contains? (codes (s/statement-problems (f/stmt :s/1 "x" {:jiten.statement/confidence :contested})))
                   :statement/contested-without-dissent))
    (is (empty? (errors (s/statement-problems
                         (f/stmt :s/1 "x" {:jiten.statement/confidence :contested
                                           :jiten.statement/dissent "source B says otherwise"}))))))
  (testing ":estimate must say how"
    (is (contains? (codes (s/statement-problems (f/stmt :s/1 "x" {:jiten.statement/confidence :estimate})))
                   :statement/estimate-without-method))
    (is (empty? (errors (s/statement-problems
                         (f/stmt :s/1 "x" {:jiten.statement/confidence :estimate
                                           :jiten.statement/method "interpolated between two reported years"})))))))

(deftest entry-needs-a-language
  (is (contains? (codes (s/entry-problems (dissoc f/entry-a :jiten.entry/lang))) :entry/no-lang))
  (is (contains? (codes (s/entry-problems (assoc f/entry-a :jiten.entry/lang "English"))) :entry/bad-lang))
  (is (empty? (errors (s/entry-problems (assoc f/entry-a :jiten.entry/lang "zh-Hant")))))
  (is (empty? (errors (s/entry-problems (assoc f/entry-a :jiten.entry/lang "ja"))))))

(deftest article-needs-notability-and-a-claim
  (testing "an article with no notability declaration is refused"
    (is (contains? (codes (s/entry-problems (dissoc f/entry-a :jiten.entry/notability)))
                   :entry/no-notability)))
  (testing "an article with a title and no statements is a red link with extra steps"
    (is (contains? (codes (s/entry-problems (assoc f/entry-a :jiten.entry/body [])))
                   :entry/no-statements))))

(deftest navigational-entries-are-exempt-but-mute
  (let [d (f/entry :entry/d "Test D" :form :disambiguation :body [])]
    (testing "no notability required"
      (is (not (contains? (codes (s/entry-problems d)) :entry/no-notability))))
    (testing "and no claims allowed"
      (let [with-claims (assoc d :jiten.entry/body
                               [(f/section :lead "Lead" [(f/stmt :s/d1 "a claim")])])]
        (is (contains? (codes (s/entry-problems with-claims)) :entry/navigational-with-claims))))))

(deftest notability-basis-conditions-are-checked
  (testing ":independent-sources needs two"
    (is (contains? (codes (s/notability-problems {:jiten.notability/basis :independent-sources
                                                  :jiten.notability/sources ["only one"]}))
                   :notability/too-few-sources)))
  (testing "the same citation twice is one source"
    (is (contains? (codes (s/notability-problems {:jiten.notability/basis :independent-sources
                                                  :jiten.notability/sources ["same" "same"]}))
                   :notability/duplicate-sources)))
  (testing ":registry needs one, and :workspace needs to name the record"
    (is (empty? (errors (s/notability-problems {:jiten.notability/basis :registry
                                                :jiten.notability/sources ["GLEIF LEI 5493001KJTIIGC8Y1R12"]}))))
    (is (contains? (codes (s/notability-problems {:jiten.notability/basis :workspace
                                                  :jiten.notability/sources ["manifest/west.yml"]}))
                   :notability/workspace-without-note)))
  (testing "an unknown basis is refused rather than defaulted"
    (is (contains? (codes (s/notability-problems {:jiten.notability/basis :seems-important
                                                  :jiten.notability/sources ["a" "b"]}))
                   :notability/unknown-basis))))

(deftest person-entries-need-a-public-role
  (let [p (f/entry :entry/p "Test person" :topic-kind :person)]
    (is (contains? (codes (s/entry-problems p)) :entry/person-not-marked-public))
    (is (not (contains? (codes (s/entry-problems (assoc p :jiten.entry/public-role? true)))
                        :entry/person-not-marked-public)))))

(deftest confidence-vocabulary-matches-innen
  (testing "the two records describe the same world; a reader should not have to
            learn two vocabularies for how well-established a claim is"
    (is (= #{:documented :attested :contested :estimate} (set (keys s/confidences))))))

(deftest empty-section-is-a-warning-not-an-error
  (let [p (s/section-problems (f/section :x "Considered" []))]
    (is (contains? (codes p) :section/empty))
    (is (empty? (errors p)))))
