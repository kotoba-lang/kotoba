{:paths ["src"]
 ;; The concrete sources (secret_resolve/exec.cljs, sources.cljs) are
 ;; Node-only (child_process) and run under nbb — see README. This deps.edn
 ;; exists so the portable .cljc resolver (resolver.cljc — the pure
 ;; ordered-fallback logic) is also test/lint-able on the JVM.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
