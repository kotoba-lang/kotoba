(ns erc20.permit
  "EIP-2612 `permit` typed-data construction — the gasless-approval path.

  Portable `.cljc` and dependency-free BY DESIGN: this namespace only builds
  the EIP-712 *data* (domain / types / message), it never hashes it. Hashing
  needs keccak256, which is :clj-only in eth-crypto today; keeping the data
  builder separate means a browser can construct the exact struct to be signed
  and hand it to whatever can actually sign (a hardware wallet, a WebAuthn
  passkey, an injected provider's `eth_signTypedData_v4`, or eth-crypto on the
  JVM) without this namespace becoming :clj-only too.

  WHY PERMIT MATTERS FOR A SWAP: without it, spending an ERC-20 through a
  router costs the user two transactions (approve, then swap) and two wallet
  confirmations. With permit, the approval is an off-chain signature the swap
  transaction carries, so the user signs twice but pays gas once.

  NOT IMPLEMENTED (deliberately): Uniswap's Permit2. Its `PermitSingle` /
  `PermitDetails` / `TokenPermissions` struct definitions are not reproduced
  here because getting an EIP-712 struct definition subtly wrong yields
  signatures that are silently invalid (or, worse, valid for something other
  than what the UI showed). Adding it needs the real spec in front of the
  author plus a cross-implementation digest check, the same bar the EIP-2612
  path below is held to."
  (:require [erc20.core :as erc20]))

(def permit-types
  "The EIP-2612 `Permit` struct, in eth-crypto's `types` shape
  ({typeName(str) [{:name str :type str} …]})."
  {"Permit" [{:name "owner" :type "address"}
             {:name "spender" :type "address"}
             {:name "value" :type "uint256"}
             {:name "nonce" :type "uint256"}
             {:name "deadline" :type "uint256"}]})

(defn domain
  "The EIP-712 domain a token enforces for permit.

  `version` IS NOT OPTIONAL IN PRACTICE and is not guessable: USDC uses \"2\",
  most tokens use \"1\", DAI's permit is a different struct entirely. Read the
  token's own `DOMAIN_SEPARATOR()` (see `erc20.core/domain-separator-call`) and
  compare it against `eth-crypto/domain-separator` of this map before trusting
  a signature you built — a wrong name/version/chainId produces a signature the
  token rejects, with no other symptom."
  [{:keys [name version chain-id token]}]
  {"name" name
   "version" (or version "1")
   "chainId" chain-id
   "verifyingContract" token})

(defn message
  "The `Permit` message. `value` is in the token's smallest unit
  (`erc20.core/->units`); `nonce` comes from the token's `nonces(owner)` view;
  `deadline` is a unix timestamp (seconds)."
  [{:keys [owner spender value nonce deadline]}]
  {"owner" owner
   "spender" spender
   "value" (str value)
   "nonce" (str nonce)
   "deadline" (str deadline)})

(defn typed-data
  "Everything needed to sign an EIP-2612 permit, as data:
  {:domain … :types … :primary \"Permit\" :message …}.

  Feed it to eth-crypto on the JVM:

    (let [{:keys [domain types primary message]} (typed-data opts)]
      (eth/eip712-digest domain types primary message))

  or hand the same map to a browser provider's eth_signTypedData_v4."
  [{:keys [name version chain-id token owner spender value nonce deadline]}]
  {:domain (domain {:name name :version version :chain-id chain-id :token token})
   :types permit-types
   :primary "Permit"
   :message (message {:owner owner :spender spender :value value
                      :nonce nonce :deadline deadline})})

(defn calldata
  "`permit(...)` calldata from a signature. `signature` is
  {:v :r :s} — v is 27/28, r and s are 32-byte 0x-hex values."
  [{:keys [owner spender value deadline]} {:keys [v r s]}]
  (erc20/permit {:owner owner :spender spender :value value :deadline deadline
                 :v v :r r :s s}))
