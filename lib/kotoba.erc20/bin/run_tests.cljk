;; nbb test runner — proves the PORTABILITY claim, not just the JVM behaviour.
;; erc20 exists so a browser can build ERC-20 calldata before eth-crypto's
;; keccak256 is ported to cljs; that claim is only real if the .cljc actually
;; runs under ClojureScript, so CI runs this alongside `kbb -M:test`.
;;
;;   kbb --backend sci --classpath src:test bin/run_tests.cljk
;;
;; The :clj-only tests (selector-vs-keccak, permit digest vs viem) are excluded
;; by their own reader conditionals — they verify platform-independent
;; constants, so verifying them once on the JVM covers cljs too.
(ns run-tests
  (:require [cljs.test :as t]
            [erc20.core-test]
            [erc20.permit-test]
            [erc20.selector-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (when-not (t/successful? m)
    (js/process.exit 1)))

(t/run-tests 'erc20.core-test 'erc20.permit-test 'erc20.selector-test)
