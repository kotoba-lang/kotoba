;; erc20 — ERC-20 calldata + EIP-2612 permit typed data, pure .cljc.
;; ZERO runtime dependencies and genuinely dual-platform (:clj AND :cljs): the
;; function selectors are pinned constants verified against keccak256 in the
;; test suite rather than hashed at runtime, so this works in a browser today
;; even though eth-crypto's keccak256 is still :clj-only.
;; eth-crypto appears ONLY in :test, where it recomputes every selector and the
;; EIP-2612 permit digest to prove the pinned values are right.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/eth-crypto
                      {:git/sha "b9982cf0ff516cb2d7a1379f42cb382c429d3a78"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
