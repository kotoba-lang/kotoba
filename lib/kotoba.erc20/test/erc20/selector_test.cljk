(ns erc20.selector-test
  "VERIFICATION GATE for the pinned selector constants.

  `erc20.core/selectors` hard-codes 4-byte function selectors so that the
  encoder stays portable (eth-crypto's keccak256 is :clj-only — see
  erc20.core's ns docstring). A hand-typed selector constant is exactly the
  kind of thing that is wrong 1 time in 12 and then quietly calls a different
  function on a real token, so this test recomputes EVERY entry from its
  canonical signature with keccak256 and asserts equality.

  :clj-only, because keccak256 is. That is fine: the constants are platform-
  independent, so verifying them once on the JVM verifies them for cljs too.
  eth-crypto is a TEST-ONLY dependency — erc20 itself has no dependencies."
  (:require [kotoba.test :refer [deftest is testing]]
            [erc20.core :as erc20]
            #?(:clj [eth-crypto.core :as eth])))

#?(:clj
   (deftest every-pinned-selector-equals-keccak
     (doseq [[signature pinned] (sort erc20.core/selectors)]
       (testing signature
         (is (= pinned
                (subs (eth/bytes->hex (eth/keccak256 (eth/utf8 signature))) 0 8))
             (str "pinned selector for " signature " does not match keccak256"))))))

#?(:clj
   (deftest selector-count-guard
     (testing "a new signature added without a keccak assertion would fail above"
       ;; The doseq covers whatever is in the map, so this just documents the
       ;; current surface and trips if someone trims the map by accident.
       (is (= 12 (count erc20.core/selectors))))))

(deftest selector-lookup-is-total-or-throws
  (testing "every pinned signature resolves; anything else throws"
    (doseq [sig (keys erc20.core/selectors)]
      (is (= 8 (count (erc20/selector sig)))))
    (is (thrown? #?(:clj clojure.lang.ExceptionInfo :cljs js/Error)
                 (erc20/selector "notAFunction()")))))
