(ns erc20.permit-test
  "VERIFICATION GATE for EIP-2612 permit typed data: the digest computed from
  `erc20.permit/typed-data` is asserted against viem's `hashTypedData` for the
  same permit. A permit signature over a subtly wrong struct is not a crash —
  it is a signature the token silently rejects, or (worse) one that authorizes
  something other than what the UI displayed."
  (:require [kotoba.test :refer [deftest is testing]]
            [erc20.permit :as permit]
            #?(:clj [eth-crypto.core :as eth])))

(def usdc "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48")
(def owner "0x3535353535353535353535353535353535353535")
(def spender "0x1111111111111111111111111111111111111111")

(def opts
  {:name "USD Coin" :version "2" :chain-id 1 :token usdc
   :owner owner :spender spender
   :value "1000000" :nonce 0 :deadline "1750000000"})

(deftest typed-data-shape
  (let [{:keys [domain types primary message]} (permit/typed-data opts)]
    (is (= "Permit" primary))
    (is (= {"name" "USD Coin" "version" "2" "chainId" 1
            "verifyingContract" usdc}
           domain))
    (is (= ["owner" "spender" "value" "nonce" "deadline"]
           (mapv :name (get types "Permit"))))
    (is (= {"owner" owner "spender" spender "value" "1000000"
            "nonce" "0" "deadline" "1750000000"}
           message))))

(deftest canonical-type-string
  (testing "encodeType matches the EIP-2612 spec string"
    #?(:clj
       (is (= "Permit(address owner,address spender,uint256 value,uint256 nonce,uint256 deadline)"
              (eth/encode-type (:types (permit/typed-data opts)) "Permit"))))))

#?(:clj
   (deftest permit-digest-matches-viem
     (testing "EIP-712 digest for a USDC permit == viem hashTypedData"
       (let [{:keys [domain types primary message]} (permit/typed-data opts)]
         (is (= "0xbfde60e0309ded405f49855803f19c1936df065fed8b2a67d352d6631c4ae79a"
                (str "0x" (eth/bytes->hex
                           (eth/eip712-digest domain types primary message)))))))))

#?(:clj
   (deftest permit-signature-recovers-owner
     (testing "sign the permit digest -> ecrecover returns the owner"
       ;; A real end-to-end permit: derive an address from a key, build the
       ;; permit for THAT owner, sign, recover.
       (let [privkey (eth/hex->bytes
                      "0x4646464646464646464646464646464646464646464646464646464646464646")
             signer (eth/address-of-privkey privkey)
             {:keys [domain types primary message]}
             (permit/typed-data (assoc opts :owner signer))
             digest (eth/eip712-digest domain types primary message)
             {:keys [r s recovery-id]} (eth/secp256k1-sign privkey digest)
             sig (byte-array 65)]
         (System/arraycopy (#'eth/pad-left-32 (#'eth/uint->minimal r)) 0 sig 0 32)
         (System/arraycopy (#'eth/pad-left-32 (#'eth/uint->minimal s)) 0 sig 32 32)
         (aset-byte sig 64 (unchecked-byte (+ recovery-id 27)))
         (is (= signer (eth/ecrecover-checksum digest sig)))
         ;; …and the resulting calldata is well-formed permit() calldata.
         (is (= "0xd505accf"
                (subs (permit/calldata (assoc opts :owner signer)
                                       {:v (+ recovery-id 27)
                                        :r (str "0x" (eth/bytes->hex
                                                      (#'eth/pad-left-32
                                                       (#'eth/uint->minimal r))))
                                        :s (str "0x" (eth/bytes->hex
                                                      (#'eth/pad-left-32
                                                       (#'eth/uint->minimal s))))})
                      0 10)))))))

(deftest version-default-is-1-but-documented-as-unguessable
  (testing "version defaults to \"1\" (most tokens) — USDC needs \"2\" explicitly"
    (is (= "1" (get (permit/domain {:name "T" :chain-id 1 :token usdc}) "version")))
    (is (= "2" (get (permit/domain {:name "T" :version "2" :chain-id 1 :token usdc})
                    "version")))))
