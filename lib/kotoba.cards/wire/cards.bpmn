<?xml version="1.0" encoding="UTF-8"?>
<!--
  cards.etzhayyim.com — 21 BPMN processes, one per XRPC method.
  XRPC-bound (ADR-0056). Each process: Start → ServiceTask (pyzeebe) → End.
  Task type = full NSID (com.etzhayyim.apps.cards.*).
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="Definitions_cards"
    targetNamespace="https://etzhayyim.com/bpmn/cards"
    exporter="hand-written"
    exporterVersion="2.0">

  <!-- 1. createCardholder -->
  <bpmn:process id="cards_create_cardholder" name="cards createCardholder" isExecutable="true">
    <bpmn:documentation>{ "nsid": "com.etzhayyim.apps.cards.createCardholder", "version": 1 }</bpmn:documentation>
    <bpmn:startEvent id="Start_createCardholder" name="createCardholder">
      <bpmn:outgoing>Flow_createCardholder_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_createCardholder" name="create cardholder">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.cards.createCardholder"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_createCardholder_1</bpmn:incoming>
      <bpmn:outgoing>Flow_createCardholder_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_createCardholder" name="done">
      <bpmn:incoming>Flow_createCardholder_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_createCardholder_1" sourceRef="Start_createCardholder" targetRef="Task_createCardholder"/>
    <bpmn:sequenceFlow id="Flow_createCardholder_2" sourceRef="Task_createCardholder" targetRef="End_createCardholder"/>
  </bpmn:process>

