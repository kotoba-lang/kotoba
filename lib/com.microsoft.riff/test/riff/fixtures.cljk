(ns riff.fixtures
  "Real WAV files produced by ffmpeg, recorded so the portable suite can
   assert conformance on both runtimes with no shell and no filesystem.

   0.05 s of a sine wave at 8 kHz per file. s24 and s32 are
   WAVE_FORMAT_EXTENSIBLE, which is how ffmpeg writes those widths, and all
   of them carry a LIST/INFO chunk the walker has to step over.

   Generated by tools/record_fixtures.cljk — do not hand-edit.")

(def files
  {
   "u8"
   ""
   "s16"
   ""
   "s24"
   ""
   "s32"
   ""
   "f32"
   ""
   })
