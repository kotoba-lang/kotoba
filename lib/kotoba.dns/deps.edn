{:paths ["src"]
 ;; Frontend deps (shadow-cljs :cljs alias). appkit transitively pulls
 ;; kotoba-ui → liquid-glass-ui → shitsuke — same convention as
 ;; orgs/kotoba-lang/murakumo-studio/deps.edn.
 ;; local/root is relative to this deps.edn: from the _wt-* worktree layout
 ;; (orgs/kotoba-lang/_wt-dns) ../appkit is the west checkout
 ;; orgs/kotoba-lang/appkit. Verified green from this layout
 ;; (amu compile --target wasm32-browser app, cold cache, 0 errors).
 :aliases
 {:cljs
  {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}
                reagent/reagent {:mvn/version "1.2.0"}
                io.github.kotoba-lang/appkit {:local/root "../appkit"}}}}
 }
