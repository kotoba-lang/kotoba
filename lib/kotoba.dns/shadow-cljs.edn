;; shadow-cljs build for the dns (etzhayyim-wasm-dns-scndu0rf) appview UI
;; (migrated from svelte).
;; Mirrors orgs/kotoba-lang/murakumo-studio/shadow-cljs.edn and the merged
;; cloud-itonami migrations (fleamarket / public-malak / open-cofog):
;; CLJS + reagent on kotoba-ui.core + appkit.core (murakumo-studio構成).
{:deps {:aliases [:cljs]}
 :nrepl {:port 9633}

 :builds
 {:app
  {:target :browser
   :output-dir "appview/etzhayyim-wasm-dns-scndu0rf/web/dist/js"
   :asset-path "js"
   :modules {:main {:init-fn kotoba-lang.dns.desktop/init!}}}}}
