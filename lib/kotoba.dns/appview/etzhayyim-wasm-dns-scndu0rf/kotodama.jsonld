{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:scndu0rf.etzhayyim.com",
  "name": "DNS / Cloudflare Registrar",
  "nanoid": "scndu0rf",
  "performerType": "service",
  "framework": "ts-thin-edge",
  "component": { "path": "src/app.ts" },
  "build": {
    "role": "thin-edge",
    "businessLogic": "40-engine/kotoba/crates/kotoba-kotodama/py/src/kotodama/ingest/dns.py",
    "bpmn": "etzhayyim-root/00-contracts/bpmn/com/etzhayyim/dns"
  },
  "convoSystemPrompt": "You are the dns.etzhayyim.com controller. You manage Cloudflare zones, DNS records, domain registration, and inbound transfers from external registrars. The actor:cfRegistrar sub-DID drives the Cloudflare Registrar API side of Squarespace → Cloudflare transfers. Respond in the user's language.",
  "profile": {
    "displayName": "DNS / Cloudflare Registrar",
    "description": "Cloudflare DNS + Registrar 自動化 — zone/record CRUD, domain registration, Squarespace → Cloudflare 移管受入れ",
    "avatar": "DNS",
    "category": "infra",
    "operator": "etzhayyim",
    "isBot": true,
    "agentType": "autonomous",
    "capabilities": [
      "bpmn-dispatch",
      "zone-management",
      "dns-records",
      "domain-registration",
      "domain-transfer-inbound",
      "dnssec"
    ]
  },
  "space": {
    "name": "DNS Control Plane",
    "description": "Cloudflare zone + Registrar 管理 project convo",
    "joinRule": "invite",
    "historyVisibility": "shared",
    "convos": [
      { "name": "dns-ops", "kind": "public", "description": "zone/record 操作", "default": true },
      { "name": "domain-transfer", "kind": "private", "description": "移管 project convo (per-transfer)" }
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.graph.follow",
        "com.etzhayyim.dns.zone",
        "com.etzhayyim.dns.record",
        "com.etzhayyim.dns.registration",
        "com.etzhayyim.dns.transferRequest",
        "com.etzhayyim.dns.transferStep",
        "com.etzhayyim.dns.transferOutcome",
        "com.etzhayyim.dns.ownershipTransfer"
      ]
    }
  },
  "derive": [
    {
      "when": {
        "collection": "com.etzhayyim.dns.transferRequest",
        "action": "create"
      },
      "emit": {
        "type": "app.bsky.feed.post",
        "did": "${record.cfRegistrarDid}",
        "text": "📥 Transfer requested: ${record.domain} (${record.fromRegistrar} → cloudflare). Awaiting ${record.approvals.length}/3 signers.",
        "tags": ["dns", "transfer", "requested"]
      }
    },
    {
      "when": {
        "collection": "com.etzhayyim.dns.transferOutcome",
        "action": "create",
        "filter": { "result": "success" }
      },
      "emit": {
        "type": "app.bsky.feed.post",
        "did": "${record.zoneDid}",
        "text": "✅ Transfer complete: ${record.domain} is now on Cloudflare. Zone DID ${record.zoneDid} is live.",
        "tags": ["dns", "transfer", "success"]
      }
    },
    {
      "when": {
        "collection": "com.etzhayyim.dns.transferOutcome",
        "action": "create",
        "filter": { "result": "failure" }
      },
      "emit": {
        "type": "app.bsky.feed.post",
        "did": "did:web:scndu0rf.etzhayyim.com:actor:cfRegistrar",
        "text": "❌ Transfer failed: ${record.domain}. Reason: ${record.failureReason}. Rolled back ${record.rollbackSteps.length} step(s).",
        "tags": ["dns", "transfer", "failure"]
      }
    }
  ]
}
