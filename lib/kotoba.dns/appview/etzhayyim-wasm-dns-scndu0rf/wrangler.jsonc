{
  "name": "kotodama-scndu0rf",
  "main": "./src/app.ts",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"bpmn-dispatch\",\"zone-management\",\"dns-records\",\"domain-registration\",\"domain-transfer-inbound\",\"dnssec\"]",
    "APP_DESCRIPTION": "Cloudflare DNS + Registrar automation. Domain-transfer business logic runs in BPMN + Zeebe Python.",
    "APP_DISPLAY_NAME": "DNS / Cloudflare Registrar",
    "APP_EMBED_URL": "https://scndu0rf.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "worker-static-assets",
    "APP_NANOID": "scndu0rf",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "routes": [
    {
      "pattern": "scndu0rf.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
