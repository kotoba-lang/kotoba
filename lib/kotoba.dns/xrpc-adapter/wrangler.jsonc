{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dns-xrpc-adapter",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "4da88288dc30d9ee257f319d3c33ecf0",
  "workers_dev": false,
  "vars": {
    "ACTOR_DID": "did:web:dns.etzhayyim.com",
    "PDS_URL": "https://pds.etzhayyim.com",
    "L2_RPC_URL": "https://mainnet.base.org"
  },
  "routes": [
    {
      "pattern": "dns.etzhayyim.com/xrpc/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "observability": {
    "enabled": true
  }
}
