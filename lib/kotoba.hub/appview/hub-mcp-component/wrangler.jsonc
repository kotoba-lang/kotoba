{
  // DEPLOY PATH UNVERIFIED BY THIS CHANGE: `main` was dropped during the
  // svelte -> cljs migration (svelte-to-cljs branch). Neither Worker
  // source in this repo (`src/app.ts`, `src/xrpc-proxy.ts`) calls
  // env.ASSETS.fetch, so pointing `main` at either would put a Worker in
  // front of the static assets with nothing serving them; this config now
  // deploys the `cljs/public` static assets only, and the `/xrpc/*`
  // surface this project used to advertise as enabled no longer deploys.
  // Reviving it is an open product decision, not made by this migration.
  // `wrangler deploy` / `wrangler dev` were NOT run against this change.
  "name": "kotodama-n5t2lqyz",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"registerEndpoint\",\"listEndpoints\",\"routeRequest\",\"getRouteStatus\",\"createWebhook\",\"listWebhooks\",\"testConnection\",\"getMetrics\"]",
    "APP_DESCRIPTION": "hub — Integration Hub & API Gateway Platform. BPMN-driven endpoint management, request routing, webhook orchestration, and API metrics.",
    "APP_DISPLAY_NAME": "Integration Hub",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "n5t2lqyz",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "n5t2lqyz.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "hub.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
