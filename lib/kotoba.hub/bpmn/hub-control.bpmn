<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- registerEndpoint -->
  <bpmn:process id="hub-register-endpoint" name="Hub Register Endpoint" isExecutable="true">
    <bpmn:startEvent id="start-register-endpoint"/>
    <bpmn:sequenceFlow id="sf-re-1" sourceRef="start-register-endpoint" targetRef="task-register-endpoint"/>
    <bpmn:serviceTask id="task-register-endpoint" name="Register Endpoint">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.hub.registerEndpoint"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-re-2" sourceRef="task-register-endpoint" targetRef="end-register-endpoint"/>
    <bpmn:endEvent id="end-register-endpoint"/>
  </bpmn:process>

  <!-- listEndpoints -->
  <bpmn:process id="hub-list-endpoints" name="Hub List Endpoints" isExecutable="true">
    <bpmn:startEvent id="start-list-endpoints"/>
    <bpmn:sequenceFlow id="sf-le-1" sourceRef="start-list-endpoints" targetRef="task-list-endpoints"/>
    <bpmn:serviceTask id="task-list-endpoints" name="List Endpoints">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.hub.listEndpoints"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-le-2" sourceRef="task-list-endpoints" targetRef="end-list-endpoints"/>
    <bpmn:endEvent id="end-list-endpoints"/>
  </bpmn:process>

  <!-- routeRequest -->
  <bpmn:process id="hub-route-request" name="Hub Route Request" isExecutable="true">
    <bpmn:startEvent id="start-route-request"/>
    <bpmn:sequenceFlow id="sf-rr-1" sourceRef="start-route-request" targetRef="task-route-request"/>
    <bpmn:serviceTask id="task-route-request" name="Route Request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.hub.routeRequest"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-rr-2" sourceRef="task-route-request" targetRef="end-route-request"/>
    <bpmn:endEvent id="end-route-request"/>
  </bpmn:process>

  <!-- getRouteStatus -->
  <bpmn:process id="hub-get-route-status" name="Hub Get Route Status" isExecutable="true">
    <bpmn:startEvent id="start-get-route-status"/>
    <bpmn:sequenceFlow id="sf-grs-1" sourceRef="start-get-route-status" targetRef="task-get-route-status"/>
    <bpmn:serviceTask id="task-get-route-status" name="Get Route Status">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.hub.getRouteStatus"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-grs-2" sourceRef="task-get-route-status" targetRef="end-get-route-status"/>
    <bpmn:endEvent id="end-get-route-status"/>
  </bpmn:process>

  <!-- createWebhook -->
  <bpmn:process id="hub-create-webhook" name="Hub Create Webhook" isExecutable="true">
    <bpmn:startEvent id="start-create-webhook"/>
    <bpmn:sequenceFlow id="sf-cw-1" sourceRef="start-create-webhook" targetRef="task-create-webhook"/>
    <bpmn:serviceTask id="task-create-webhook" name="Create Webhook">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.hub.createWebhook"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-cw-2" sourceRef="task-create-webhook" targetRef="end-create-webhook"/>
    <bpmn:endEvent id="end-create-webhook"/>
  </bpmn:process>

  <!-- listWebhooks -->
  <bpmn:process id="hub-list-webhooks" name="Hub List Webhooks" isExecutable="true">
    <bpmn:startEvent id="start-list-webhooks"/>
    <bpmn:sequenceFlow id="sf-lw-1" sourceRef="start-list-webhooks" targetRef="task-list-webhooks"/>
    <bpmn:serviceTask id="task-list-webhooks" name="List Webhooks">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.hub.listWebhooks"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-lw-2" sourceRef="task-list-webhooks" targetRef="end-list-webhooks"/>
    <bpmn:endEvent id="end-list-webhooks"/>
  </bpmn:process>

  <!-- testConnection -->
  <bpmn:process id="hub-test-connection" name="Hub Test Connection" isExecutable="true">
    <bpmn:startEvent id="start-test-connection"/>
    <bpmn:sequenceFlow id="sf-tc-1" sourceRef="start-test-connection" targetRef="task-test-connection"/>
    <bpmn:serviceTask id="task-test-connection" name="Test Connection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.hub.testConnection"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-tc-2" sourceRef="task-test-connection" targetRef="end-test-connection"/>
    <bpmn:endEvent id="end-test-connection"/>
  </bpmn:process>

  <!-- getMetrics -->
  <bpmn:process id="hub-get-metrics" name="Hub Get Metrics" isExecutable="true">
    <bpmn:startEvent id="start-get-metrics"/>
    <bpmn:sequenceFlow id="sf-gm-1" sourceRef="start-get-metrics" targetRef="task-get-metrics"/>
    <bpmn:serviceTask id="task-get-metrics" name="Get Metrics">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="com.etzhayyim.apps.hub.getMetrics"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="sf-gm-2" sourceRef="task-get-metrics" targetRef="end-get-metrics"/>
    <bpmn:endEvent id="end-get-metrics"/>
  </bpmn:process>

</bpmn:definitions>
