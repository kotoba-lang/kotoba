{:largest-in-snapshot
 {:find [?path ?bytes ?category ?policy]
  :in [$ ?snapshot-id]
  :where [[?s :diskspace.snapshot/id ?snapshot-id]
          [?e :diskspace.entry/snapshot ?s]
          [?e :diskspace.entry/path ?path]
          [?e :diskspace.entry/bytes ?bytes]
          [?e :diskspace.entry/category ?category]
          [?e :diskspace.entry/cleanup-policy ?policy]]}

 :rebuildable-in-snapshot
 {:find [?path ?bytes ?category]
  :in [$ ?snapshot-id]
  :where [[?s :diskspace.snapshot/id ?snapshot-id]
          [?e :diskspace.entry/snapshot ?s]
          [?e :diskspace.entry/path ?path]
          [?e :diskspace.entry/bytes ?bytes]
          [?e :diskspace.entry/category ?category]
          [?e :diskspace.entry/cleanup-policy :cleanup/rebuildable]]}

 :path-history
 {:find [?captured ?bytes ?snapshot-id]
  :in [$ ?path]
  :where [[?e :diskspace.entry/path ?path]
          [?e :diskspace.entry/bytes ?bytes]
          [?e :diskspace.entry/snapshot ?s]
          [?s :diskspace.snapshot/id ?snapshot-id]
          [?s :diskspace.snapshot/captured-at ?captured]]}

 :cleanup-proposals
 {:find [?path ?bytes ?class ?confidence ?risk ?recovery]
  :in [$ ?snapshot-id]
  :where [[?s :diskspace.snapshot/id ?snapshot-id]
          [?c :cleanup.candidate/snapshot ?s]
          [?c :cleanup.candidate/path ?path]
          [?c :cleanup.candidate/bytes ?bytes]
          [?c :cleanup.candidate/class ?class]
          [?c :cleanup.candidate/confidence ?confidence]
          [?c :cleanup.candidate/risk ?risk]
          [?c :cleanup.candidate/recovery ?recovery]
          [?c :cleanup.candidate/status :cleanup.status/proposed]]}

 :high-confidence-low-risk
 {:find [?path ?bytes ?recovery]
  :in [$ ?snapshot-id]
  :where [[?s :diskspace.snapshot/id ?snapshot-id]
          [?c :cleanup.candidate/snapshot ?s]
          [?c :cleanup.candidate/path ?path]
          [?c :cleanup.candidate/bytes ?bytes]
          [?c :cleanup.candidate/recovery ?recovery]
          [?c :cleanup.candidate/confidence :cleanup.confidence/high]
          [?c :cleanup.candidate/risk :cleanup.risk/low]
          [?c :cleanup.candidate/status :cleanup.status/proposed]]}}
