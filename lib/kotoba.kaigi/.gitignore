.cpcache/
.shadow-cljs/
node_modules/
worker/.shadow-cljs/
worker/.wrangler/
# No trailing slash: in a `git worktree` this path is usually a SYMLINK to the
# shared checkout's install rather than a directory, and a pattern ending in
# `/` matches only directories — so `worker/node_modules/` left a symlink to
# 140 packages sitting in `git status` as an untracked file, one `git add -A`
# away from being committed.
worker/node_modules
worker/dist/

# Generated deploy artifacts, NOT committed.
#
# `public/index.html` is SSR output from generate-page.cljs and
# `public/js/kaigi-app.js` is a amu compile --target wasm32-browser build. Committing them
# would put a 1.5 MB artifact under review and let it drift from the source it
# was built from — the exact hazard cloud-itonami's shadow-cljs.edn documents
# for its own committed bundle. Deploys run both generators first; the order is
# in README.md under "Build and test".
worker/public/index.html
worker/public/js/

# Local secrets for `wrangler dev`. Never committed.
worker/.dev.vars

# nbb dependency cache -- a build artifact, not source
.nbb/
