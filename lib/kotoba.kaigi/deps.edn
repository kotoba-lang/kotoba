{:paths ["src"]
 ;; kaigi is the meeting layer, not a second WebRTC implementation: track and
 ;; subscription state comes from `webrtc` (kotoba.webrtc.room/session) and
 ;; relay routing from `org-w3-webrtc-signaling` (kotoba.rt.core). Both are
 ;; pure .cljc with no transport, which is why they compose here without
 ;; dragging a runtime in.
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/webrtc {:local/root "../kotoba.webrtc"}
        io.github.kotoba-lang/org-w3-webrtc-signaling {:local/root "../org.w3.webrtcSignaling"}
        io.github.kotoba-lang/org-ietf-turn {:local/root "../org.ietf.turn"}}
 :aliases
 {:test {:extra-paths ["test"]}}}