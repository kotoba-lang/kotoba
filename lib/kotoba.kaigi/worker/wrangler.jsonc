{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaigi",
  "main": "dist/kaigi-worker.js",
  "compatibility_date": "2026-07-01",

  // The SSR'd console (public/index.html, written by generate-page.cljs) and
  // the browser bundle (public/js/kaigi-app.js). Static assets take precedence
  // for paths that exist, so /api/kaigi/* still reaches the Worker.
  //
  // `not_found_handling` alone is NOT sufficient, and that was measured:
  // with a Worker `main` present, an asset miss falls through to the Worker
  // instead of triggering the asset layer's not-found behaviour, so
  // /some/deep/link still answered `{"error":"no route for ..."}`. The binding
  // below is what lets the Worker serve the shell itself for unmatched
  // navigations (see kaigi.worker.entry/on-fetch).
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // The room is one Durable Object per meeting id. This is the binding
  // AGENTS.md sanctions for DO use: a serializer and realtime room. Nothing
  // cross-meeting is stored in it — each DO's SQLite is private, so a
  // cross-meeting query plane placed there would split into one island per
  // room.
  "durable_objects": {
    "bindings": [
      { "name": "KAIGI_ROOMS", "class_name": "KaigiRoom" }
    ]
  },

  // SQLite-backed DO classes need an explicit migration tag.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["KaigiRoom"] }
  ],

  // REALTIME_APP_ID / REALTIME_APP_TOKEN are deliberately ABSENT.
  //
  // No Cloudflare Realtime app has been provisioned for this account: the
  // wrangler OAuth session carries no `calls`/`realtime` scope, and creating
  // an app needs either the dashboard or an API token minted there. Until one
  // exists, `kaigi.plan/transport` reads the missing bindings as `:mesh` and
  // the deployment works for small meetings. Provisioning is one owner action
  // and no code change:
  //
  //   wrangler secret put REALTIME_APP_ID   --name kaigi
  //   wrangler secret put REALTIME_APP_TOKEN --name kaigi
  //
  // TURN_URL / TURN_USERNAME / TURN_CREDENTIAL are also absent, so
  // participants behind symmetric NAT will fail to connect over the mesh.
  // `kaigi.worker.room/ice-servers` reports the server list to the client as
  // data so the UI can say that, rather than spinning forever.
  // Recordings. Media lives HERE and never in the Durable Object or the
  // meeting value — `kaigi.recording` stores only an object-key prefix, which
  // is what keeps `gijiroku`'s G4 (raw audio/video never enters the store)
  // true at the producing end.
  "r2_buckets": [
    { "binding": "KAIGI_RECORDINGS", "bucket_name": "kaigi-recordings" }
  ],

  "observability": { "enabled": true }
}
