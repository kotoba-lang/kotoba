;; kaigi Worker build.
;;
;; :target :esm because a Cloudflare Worker module needs `export default` and
;; a named class export for the Durable Object binding. `:exports` maps both:
;; `default` to the fetch handler object and `KaigiRoom` to the deftype, which
;; compiles to a real class with an un-munged prototype.
;;
;; :simple, not :advanced. The code reads untyped fields off runtime objects
;; the compiler has never seen — `ctx.storage`, `ws.serializeAttachment`,
;; `env.KAIGI_ROOMS` — and :advanced's property renaming would rewrite those
;; property names into gibberish the runtime does not answer to. The same
;; hazard cloud-itonami's :edge-api comment documents.
{:source-paths ["src"
                ;; the portable core, consumed in place: kaigi's own .cljc plus
                ;; the two libraries it composes. No jar, no publish step —
                ;; these are west checkouts sitting next to each other.
                "../src"
                "../../webrtc/src"
                "../../org-w3-webrtc-signaling/src"
                ;; TURN ephemeral credentials (kaigi.turn) + its byte helpers
                "../../org-ietf-turn/src"
                "../../bytes/src"
                ;; design system, for the browser console's views
                ;; kotoba-ui composes byoubu; without these two the build stops
                ;; at `The required namespace "byoubu-ui.core" is not available`
                ;; before any code runs (restored 2026-08-18)
                "../../byoubu/src"
                "../../byoubu-ui/src"
                "../../kotoba-ui/src"
                "../../liquid-glass-ui/src"
                "../../shitsuke/src"
                "../../css/src"
                "../../html/src"
                "../../appkit/src"]
 :dependencies []
 :builds
 {:worker
  {:target :esm
   :output-dir "dist"
   :modules {:kaigi-worker
             {:exports {default   kaigi.worker.entry/handler
                        KaigiRoom kaigi.worker.entry/KaigiRoom}}}
   :compiler-options {:optimizations :simple
                      :output-feature-set :es2020
                      :infer-externs :auto}}

  ;; Browser console. Lands in public/js/ because it is served as a static
  ;; asset of the same Worker, alongside the SSR'd index.html.
  ;;
  ;; :simple, not :advanced — the app reads untyped fields off WebRTC objects
  ;; (`RTCTrackEvent.track`, `RTCStatsReport` entries, `MediaStreamTrack`)
  ;; that the compiler has never seen, and :advanced's property renaming would
  ;; rewrite those names into gibberish the browser does not answer to. The
  ;; same reason cloud-itonami's :workspace-app build gives.
  :app
  {:target :esm
   :output-dir "public/js"
   :modules {:kaigi-app {:exports {init kaigi.app/init}}}
   :compiler-options {:optimizations :simple
                      :output-feature-set :es2020
                      :infer-externs :auto}}}}
