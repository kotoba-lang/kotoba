;; eth-crypto-clj — standalone, dependency-free Ethereum crypto for Clojure/babashka.
;; Keccak-256 + EIP-55 + EIP-712 typed-data + secp256k1 ecrecover, pure clojure.*
;; (java.math.BigInteger only). Verified against the canonical EIP-712 'Ether Mail'
;; spec vector. Lift-ready for extraction into com-junkawasaki/eth-crypto-clj.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         ;; test namespaces are eth-crypto.test-eth-crypto / eth-crypto.test-signing
         ;; (do not end in -test), so widen the discovery regex from the default -test$.
         :main-opts ["-m" "cognitect.test-runner" "-r" ".*"]
         :exec-fn cognitect.test-runner.api/test
         :exec-args {:namespace-regex ".*"}}
  :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
