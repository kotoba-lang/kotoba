{:schema "kotoba-spice-migration/v1"
 :profile :spice/bounded-nmos-model-library-v1
 :legacy {:source "src/spice/model.cljk" :status :retained-general-oracle}
 :canonical {:kernel-and-conformance "src/spice/bounded_nmos_library.kotoba"}
 :domain
 {:functions [:nmos :make-library :add-nmos :model-count :has-model? :nmos-vth0-bits-or :default-nmos]
  :scope "the Level-1 NMOS compact-model library: a name-keyed library of NMOS
          parameter records (vth0/kp/lambda/tox/nsub). BJT/diode models, the
          heterogeneous [:mosfet|:bjt|:diode model] tagging in spice.model, the
          circuit container (spice.circuit), and the nonlinear DC operating-
          point solver (spice.analysis) stay the CLJC oracle."
  :representation "the library is kotoba-lang/compiler's canonical bounded
                   typed-map ([:map :string [:record :spice/nmos ...f64...]],
                   max-typed-map-entries 31) whose VALUE is a record of eight
                   :f64 compact-model parameters. Unblocked by the compiler's
                   f64 fixes (#262/#263/#264): f64-field records and function
                   bodies constructing them with scalar f64 ops previously
                   miscompiled or misclassified for the Wasm target."}
 :excluded [:spice.model/bjt :spice.model/diode
            :spice.model/heterogeneous-model-tagging
            :spice.circuit :spice.analysis :spice.netlist]
 :exclusion-reason "not reviewed this pass; BJT/diode compact models, the
                    tagged heterogeneous model library, the circuit container,
                    the netlist reader, and the nonlinear DC solver remain the
                    CLJC oracle's responsibility."
 :compiler-findings
 {:f64-field-records-in-typed-map-values-now-work
  {:description "A [:record ...:f64...] value inside a [:map :string ...]
                 typed-map, and a body constructing it with f64-from-bits,
                 now compile and run on wasm32-browser -- this was one of the
                 classes fixed by compiler #262/#263/#264. Direct :f64 map
                 keys/values are still rejected (structured-scalar-ABI rule);
                 wrapping the f64s in a record is the supported path."}}
 :verification
 {:legacy {:tests 11 :assertions 32 :failures 0 :errors 0}
  :hand-verified-cases
  "main builds spice.model/default-nmos \"n1\" (vth0 0.7) plus \"n2\", asserts
   model-count 2, membership of \"n1\", vth0 IEEE-bit round-trip
   (4604480259023595110 == bits of 0.7), absence of \"absent\", and the
   fallback for a missing model. Returns 42 iff all hold."
  :web {:main 42 :required-capabilities []}
  :wasm {:main 42}
  :required-capabilities []}
 :cutover {:bounded-profile-authorized true :general-cljc-oracle-retained true}}
