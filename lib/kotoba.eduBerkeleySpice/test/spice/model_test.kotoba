(ns spice.model-test (:export [main]) (:require [spice.model :as m]))

(defn- same [a :document b :document] :bool
  (string=? (document-edn-print a) (document-edn-print b)))

(defn main [] :i64
  (let [lib0 (m/library)
        n1 (m/default-nmos "M1")
        q1 (m/default-npn "Q1")
        d1 (m/default-diode "D1")
        lib1 (m/add-mosfet lib0 n1)
        lib2 (m/add-bjt lib1 q1)
        lib3 (m/add-diode lib2 d1)
        lib4 (m/add-mosfet lib3 (m/default-nmos "M1"))]
    (+ (if (= (m/model-count lib0) 0) 0 1)
       (if (= (m/model-count lib1) 1) 0 1)
       (if (= (m/model-count lib3) 3) 0 1)
       (if (= (m/model-count lib4) 3) 0 1)
       (if (same (m/get-model lib4 "M1") (document-vector (document-keyword :mosfet) n1)) 0 1)
       (if (same (m/get-model lib4 "Q1") (document-vector (document-keyword :bjt) q1)) 0 1)
       (if (same (m/get-model lib4 "D1") (document-vector (document-keyword :diode) d1)) 0 1)
       (if (same (m/get-model lib4 "nope") (document-null)) 0 1)
       (if (same (m/get-model lib0 "M1") (document-null)) 0 1)
       (if (same (m/default-npn "X") (m/default-npn "X")) 0 1))))
