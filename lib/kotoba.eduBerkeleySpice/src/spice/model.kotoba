;; Port of spice.model (model.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from model.cljk:
;;   - the model library is {:models {name [kind model]}}; the model name is a
;;     :string and is stored as a document-string key.
;;   - float parameters are :f64 document values (carried, not computed).
;;   - get-model returns document-null where the source returns nil.

(ns spice.model
  (:export [default-nmos default-npn default-diode library add-mosfet add-bjt
            add-diode get-model model-count]))

(defn default-nmos [name :string] :document
  (document-map :name (document-string name) :mosfet-type (document-keyword :nmos)
                :vth0 (document-f64 0.7) :kp (document-f64 110e-6) :lambda (document-f64 0.04)
                :tox (document-f64 9e-9) :nsub (document-f64 1e17) :uo (document-f64 600.0)
                :phi (document-f64 0.65) :gamma (document-f64 0.37)))

(defn default-npn [name :string] :document
  (document-map :name (document-string name) :bjt-type (document-keyword :npn)
                :is-sat (document-f64 1e-15) :bf (document-f64 100.0) :br (document-f64 1.0)
                :vaf (document-f64 100.0) :var (document-f64 0.0)))

(defn default-diode [name :string] :document
  (document-map :name (document-string name) :is-sat (document-f64 1e-14)
                :n (document-f64 1.0) :bv (document-f64 100.0) :rs (document-f64 0.0)))

(defn library [] :document
  (document-map :models (document-map)))

(defn- put-model [lib :document kind :keyword model :document] :document
  (let [nm (option-or (document-get model :name) (document-null))
        models (option-or (document-get lib :models) (document-map))]
    (document-assoc lib :models
                    (document-assoc models nm (document-vector (document-keyword kind) model)))))

(defn add-mosfet [lib :document model :document] :document (put-model lib :mosfet model))
(defn add-bjt [lib :document model :document] :document (put-model lib :bjt model))
(defn add-diode [lib :document model :document] :document (put-model lib :diode model))

(defn get-model [lib :document name :string] :document
  (option-or (document-get (option-or (document-get lib :models) (document-map)) (document-string name))
             (document-null)))

(defn model-count [lib :document] :i64
  (document-count (option-or (document-get lib :models) (document-map))))
