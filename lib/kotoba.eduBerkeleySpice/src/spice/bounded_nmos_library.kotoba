(ns spice.bounded-nmos-library
  (:export [main make-library add-nmos model-count has-model? nmos-vth0-bits-or]))

;; Bounded-profile port of spice.model's device-model library, scoped to the
;; Level-1 NMOS compact model: a name-keyed library of NMOS parameter records.
;; BJT/diode models, the heterogeneous [:mosfet|:bjt|:diode model] tagging in
;; spice.model, the circuit container, and spice.analysis's nonlinear DC
;; operating-point solver stay the CLJC oracle.
;;
;; This migration is unblocked by kotoba-lang/compiler's f64 fixes
;; (#262/#263/#264): the NMOS model is a record of eight :f64 compact-model
;; parameters, stored as the VALUE of a string-keyed canonical bounded
;; typed-map ([:map :string [:record ...]], <= 31 entries). Records carrying
;; f64 fields, and function bodies constructing them with scalar f64 ops,
;; previously miscompiled or misclassified for the Wasm target.

(defn nmos [vth0 :f64 kp :f64 lambda :f64 tox :f64 nsub :f64]
    [:record :spice/nmos [[:vth0 :f64] [:kp :f64] [:lambda :f64]
                          [:tox :f64] [:nsub :f64]]]
  (record [:record :spice/nmos [[:vth0 :f64] [:kp :f64] [:lambda :f64]
                                [:tox :f64] [:nsub :f64]]]
          vth0 kp lambda tox nsub))

(defn make-library []
    [:map :string [:record :spice/nmos [[:vth0 :f64] [:kp :f64] [:lambda :f64]
                                        [:tox :f64] [:nsub :f64]]]]
  (typed-map-new [:map :string [:record :spice/nmos [[:vth0 :f64] [:kp :f64]
                                                     [:lambda :f64] [:tox :f64]
                                                     [:nsub :f64]]]]))

(defn add-nmos [lib [:map :string [:record :spice/nmos [[:vth0 :f64] [:kp :f64]
                                                        [:lambda :f64] [:tox :f64]
                                                        [:nsub :f64]]]]
                name :string
                model [:record :spice/nmos [[:vth0 :f64] [:kp :f64] [:lambda :f64]
                                            [:tox :f64] [:nsub :f64]]]]
    [:map :string [:record :spice/nmos [[:vth0 :f64] [:kp :f64] [:lambda :f64]
                                        [:tox :f64] [:nsub :f64]]]]
  (typed-map-assoc [:map :string [:record :spice/nmos [[:vth0 :f64] [:kp :f64]
                                                       [:lambda :f64] [:tox :f64]
                                                       [:nsub :f64]]]]
                   lib name model))

(defn model-count [lib [:map :string [:record :spice/nmos [[:vth0 :f64] [:kp :f64]
                                                           [:lambda :f64] [:tox :f64]
                                                           [:nsub :f64]]]]] :i64
  (typed-map-count [:map :string [:record :spice/nmos [[:vth0 :f64] [:kp :f64]
                                                       [:lambda :f64] [:tox :f64]
                                                       [:nsub :f64]]]] lib))

(defn has-model? [lib [:map :string [:record :spice/nmos [[:vth0 :f64] [:kp :f64]
                                                          [:lambda :f64] [:tox :f64]
                                                          [:nsub :f64]]]]
                  name :string] :bool
  (typed-map-contains [:map :string [:record :spice/nmos [[:vth0 :f64] [:kp :f64]
                                                          [:lambda :f64] [:tox :f64]
                                                          [:nsub :f64]]]] lib name))

;; Return the IEEE bit pattern of a named model's vth0, or a fallback when the
;; model is absent (typed-map-get returns an option of the record type).
(defn nmos-vth0-bits-or [lib [:map :string [:record :spice/nmos [[:vth0 :f64] [:kp :f64]
                                                                 [:lambda :f64] [:tox :f64]
                                                                 [:nsub :f64]]]]
                         name :string fallback :i64] :i64
  (match-option
   (typed-map-get [:map :string [:record :spice/nmos [[:vth0 :f64] [:kp :f64]
                                                      [:lambda :f64] [:tox :f64]
                                                      [:nsub :f64]]]] lib name)
   [:option [:record :spice/nmos [[:vth0 :f64] [:kp :f64] [:lambda :f64]
                                  [:tox :f64] [:nsub :f64]]]]
   (none fallback)
   (some model
     (f64-to-bits (record-get [:record :spice/nmos [[:vth0 :f64] [:kp :f64]
                                                    [:lambda :f64] [:tox :f64]
                                                    [:nsub :f64]]]
                              model :vth0)))))

;; Self-conformance: build spice.model/default-nmos "n1" (vth0 0.7) plus a
;; second model "n2", then assert count, membership, vth0 round-trip, and the
;; fallback for an absent model. Returns 42 iff all hold.
(defn default-nmos []
    [:record :spice/nmos [[:vth0 :f64] [:kp :f64] [:lambda :f64]
                          [:tox :f64] [:nsub :f64]]]
  (nmos (f64-from-bits 4604480259023595110)   ; vth0   0.7
        (f64-from-bits 4547744991781892171)   ; kp     110e-6
        (f64-from-bits 4585925428558828667)   ; lambda 0.04
        (f64-from-bits 4486521795421909351)   ; tox    9e-9
        (f64-from-bits 4861130398305394688))) ; nsub   1e17

(defn main [] :i64
  (let [lib (add-nmos (add-nmos (make-library) "n1" (default-nmos))
                      "n2" (nmos (f64-from-bits 4604480259023595110)
                                 (f64-from-bits 4547744991781892171)
                                 (f64-from-bits 4585925428558828667)
                                 (f64-from-bits 4486521795421909351)
                                 (f64-from-bits 4861130398305394688)))]
    (if (= 2 (model-count lib))
      (if (has-model? lib "n1")
        (if (= 4604480259023595110 (nmos-vth0-bits-or lib "n1" 0))
          (if (has-model? lib "absent")
            1
            (if (= 0 (nmos-vth0-bits-or lib "absent" 0))
              42
              1))
          1)
        1)
      1)))
