{
  "name": "@kotoba-lang/kobo",
  "private": true,
  "description": "nbb harness for kobo: the local workbench console server and the Node host tests.",
  "scripts": {
    "test:host": "kbb --backend sci --classpath \"$(kbb -Spath -M:test)\" test/run_host_tests.cljk",
    "console": "kbb --backend sci --classpath \"$(kbb -Spath -M:test)\" bin/kobo-console.cljk",
    "test:browser-render": "kbb -M:browser-render:test -d test-browser"
  },
  "devDependencies": {
    "nbb": "1.4.208"
  }
}
