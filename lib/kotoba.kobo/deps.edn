{:paths ["src" "resources"]
 ;; Siblings are named by GIT COORDINATE, not :local/root: a :local/root dep
 ;; resolves relative to the consumer's gitlibs directory, so a library that
 ;; uses one cannot be consumed outside a monorepo checkout. The :local alias
 ;; overrides them to sibling checkouts for monorepo work, and CI runs the
 ;; plain git path — which proves kobo is still consumable, not merely that it
 ;; compiles next to its siblings.
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/kuro
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.kuro"}
        io.github.kotoba-lang/kotoba-ui {:local/root "../kotoba.kotobaUi"}
        io.github.kotoba-lang/appkit {:local/root "../kotoba.appkit"}}
 :aliases
 {:local {:override-deps
          {io.github.kotoba-lang/kuro {:local/root "../kuro"}
           io.github.kotoba-lang/kotoba-ui {:local/root "../kotoba-ui"}
           io.github.kotoba-lang/appkit {:local/root "../appkit"}}}
  ;; kotoba-lang/browser で console を render する gate。別 alias なのは
  ;; browser が git 座標で consume できない（dom-gpu ↔ cssom ↔ htmldom が
  ;; :local/root で相互参照する循環）ため —— sibling checkout がある環境で
  ;; のみ走る。browser 側から継承した制約。
  :browser-render {:extra-paths ["test-browser"]
                   :extra-deps {io.github.kotoba-lang/browser {:local/root "../browser"}}}
  :test {:extra-paths ["test"]}}}
