;; Port of yield.corner (corner.cljk), Kotoba-native. PARTIAL port.
;; Ported: process-corners, pvt-corner, corner-result, standard-corners.
;; Not ported: run-corners. It takes an eval-fn function value (amu rejects
;; :fn values, E2105) and orders doubles (amu's :f64 has no ordering).
;; Named divergences:
;;   - process-corners is a def in the source. A def cannot be exported (E2005),
;;     so it is a zero-argument fn returning a :document set of keywords.
;;   - voltage and temperature are :f64 documents (opaque IEEE-754 carriers).
;;   - standard-corners builds its doubles with f64-from-bits from the binary64
;;     bit patterns of 0.9, 0.99, 0.81, 25.0, -40.0 and 125.0.
(ns yield.corner
  (:export [process-corners pvt-corner corner-result standard-corners]))

(defn process-corners [] :document
  (document-set (document-keyword :tt) (document-keyword :ff) (document-keyword :ss)
                (document-keyword :fs) (document-keyword :sf)))

(defn pvt-corner [nm :string process :keyword voltage :document temperature-c :document] :document
  (document-map :name (document-string nm)
                :process (document-keyword process)
                :voltage voltage
                :temperature-c temperature-c))

(defn corner-result [corner-name :document value :document pass :bool] :document
  (document-map :corner-name corner-name
                :value value
                :pass (document-bool pass)))

(defn- f64doc [bits :i64] :document
  (document-f64 (f64-from-bits bits)))

(defn standard-corners [] :document
  (document-vector
   (pvt-corner "TT_0.9V_25C" :tt (f64doc 4606281698874543309) (f64doc 4627730092099895296))
   (pvt-corner "FF_0.99V_-40C" :ff (f64doc 4607092346807469998) (f64doc -4592545720011063296))
   (pvt-corner "SS_0.81V_125C" :ss (f64doc 4605471050941616620) (f64doc 4638496509959077888))
   (pvt-corner "FS_0.9V_25C" :fs (f64doc 4606281698874543309) (f64doc 4627730092099895296))
   (pvt-corner "SF_0.9V_25C" :sf (f64doc 4606281698874543309) (f64doc 4627730092099895296))))
