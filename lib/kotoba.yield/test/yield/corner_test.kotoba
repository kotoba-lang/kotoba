;; Test for yield.corner. main returns the number of failed cases.
(ns yield.corner-test
  (:export [main])
  (:require [yield.corner :as c]))

(defn- elem [xs :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at xs i) (document-null)))
(defn- gv [m :document k :keyword] :document
  (option-value-of [:option :document] (document-get m k) (document-null)))
(defn- str-of [m :document k :keyword] :string
  (option-value-of [:option :string] (document-string-value (gv m k)) "<none>"))
(defn- bits-of [m :document k :keyword] :i64
  (f64-to-bits (option-value-of [:option :f64] (document-f64-value (gv m k)) (f64-from-bits 0))))
(defn- chk-i64 [got :i64 want :i64] :i64
  (if (= got want) 0 1))
(defn- chk-str [got :string want :string] :i64
  (if (string=? got want) 0 1))

(defn- cases-sets [] :i64
  (let [c1 (chk-i64 (document-count (c/process-corners)) 5)
        c2 (chk-i64 (if (document-set-contains? (c/process-corners) (document-keyword :ss)) 1 0) 1)]
    (+ c1 c2)))

(defn- cases-standard [] :i64
  (let [cs (c/standard-corners)
        c3 (chk-i64 (document-count cs) 5)
        tt (elem cs 0)
        c4 (chk-str (str-of tt :name) "TT_0.9V_25C")
        c5 (chk-i64 (bits-of tt :voltage) 4606281698874543309)
        c6 (chk-i64 (bits-of tt :temperature-c) 4627730092099895296)
        ff (elem cs 1)
        c7 (chk-i64 (bits-of ff :temperature-c) -4592545720011063296)
        ss (elem cs 2)
        c8 (chk-i64 (bits-of ss :voltage) 4605471050941616620)]
    (+ c3 (+ c4 (+ c5 (+ c6 (+ c7 c8)))))))

(defn- cases-result [] :i64
  (let [r (c/corner-result (document-string "TT") (document-f64 (f64-from-bits 4607092346807469998)) true)
        c9 (chk-str (str-of r :corner-name) "TT")
        c10 (chk-i64 (if (= (document-kind (gv r :pass)) :bool) 0 1) 0)]
    (+ c9 c10)))

(defn main [] :i64
  (+ (cases-sets) (+ (cases-standard) (cases-result))))
