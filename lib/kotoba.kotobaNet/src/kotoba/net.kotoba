(ns kotoba.net
  "Pure URI/percent-encoding core in Kotoba. Host HTTP transport lives in the
  host layer; this module holds only pure logic over i64 char codes."
  (:export [pct-encode-char pct-decode-hex is-unreserved scheme-char? main]))

;; RFC 3986 unreserved: ALPHA / DIGIT / "-" / "." / "_" / "~" -> 1 else 0
(defn is-unreserved [c] :i64
  (if (or (and (>= c 65) (<= c 90))
          (and (>= c 97) (<= c 122))
          (and (>= c 48) (<= c 57))
          (= c 45) (= c 46) (= c 95) (= c 126))
    1 0))

;; Value 0..15 -> uppercase hex char code
(defn pct-encode-char [c] :i64
  (if (< c 10) (+ c 48) (+ c -10 65)))

;; Hex digit char -> value 0..15, -1 if invalid
(defn pct-decode-hex [c] :i64
  (cond
    (and (>= c 48) (<= c 57)) (- c 48)
    (and (>= c 65) (<= c 70)) (+ c -65 10)
    (and (>= c 97) (<= c 102)) (+ c -97 10)
    :else -1))

;; scheme first-char must be ALPHA -> 1 else 0
(defn scheme-char? [c] :i64
  (if (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122))) 1 0))

;; Self-check returns the NUMBER of failing cases.
(defn self-check [] :i64
  (+ (+ (+ (+ (+ (+ (+ (+ (+ (+ (if (= 1 (is-unreserved 65)) 0 1)
   (if (= 1 (is-unreserved 48)) 0 1))
   (if (= 1 (is-unreserved 45)) 0 1))
   (if (= 0 (is-unreserved 32)) 0 1))
   (if (= 48 (pct-encode-char 0)) 0 1))
   (if (= 65 (pct-encode-char 10)) 0 1))
   (if (= 15 (pct-decode-hex 70)) 0 1))
   (if (= 9 (pct-decode-hex 57)) 0 1))
   (if (= -1 (pct-decode-hex 71)) 0 1))
   (if (= 1 (scheme-char? 104)) 0 1))
   (if (= 0 (scheme-char? 47)) 0 1)))

(defn main [] :i64 (self-check))
