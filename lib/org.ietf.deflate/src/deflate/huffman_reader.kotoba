;; Canonical Huffman decoding for RFC 1951. Huffman code bits are sent most
;; significant first, even though the bit reader consumes bytes LSB-first.
;; This primitive detects empty/oversubscribed trees; format-specific rules
;; for incomplete trees and required end codes remain the caller's duty.
(ns deflate.huffman-reader
 (:require [deflate.bit-reader :as bits])
 (:export [decode-symbol validate-lengths])
 (:schemas {:deflate/symbol [:record :deflate/symbol [[:symbol :i64] [:next :i64]]]}))

(defn- counts [lengths :vector-i64] [:result :vector-i64 :keyword]
 (let [n (vector-count lengths)]
  (if (or (= n 0) (> n 288)) (result-err-of [:result :vector-i64 :keyword] :invalid-tree)
   (loop [i 0 c (vector-alloc 16) used 0]
    (if (= i n)
     (if (= used 0) (result-err-of [:result :vector-i64 :keyword] :invalid-tree)
      (loop [depth 1 left 1]
       (if (= depth 16) (result-ok-of [:result :vector-i64 :keyword] c)
        (let [remaining (- (* left 2) (vector-at c depth))]
         (if (< remaining 0) (result-err-of [:result :vector-i64 :keyword] :oversubscribed)
          (recur (+ depth 1) remaining))))))
     (let [v (vector-at lengths i)]
      (if (or (< v 0) (> v 15)) (result-err-of [:result :vector-i64 :keyword] :invalid-tree)
       (if (= v 0) (recur (+ i 1) c used)
        (recur (+ i 1) (vector-assoc! c v (+ 1 (vector-at c v))) (+ used 1))))))))))

(defn- at-ordinal [lengths :vector-i64 width :i64 ordinal :i64] :i64
 (loop [i 0 k ordinal]
  (cond (= i (vector-count lengths)) -1
        (= (vector-at lengths i) width) (if (= k 0) i (recur (+ i 1) (- k 1)))
        :else (recur (+ i 1) k))))

(defn validate-lengths [lengths :vector-i64] [:result :vector-i64 :keyword]
 (counts lengths))

(defn decode-symbol [lengths :vector-i64 input :vector-i64 offset :i64] [:result [:ref :deflate/symbol] :keyword]
 (let [r (counts lengths)]
  (if (not (result-ok?-of [:result :vector-i64 :keyword] r))
   (result-err-of [:result [:ref :deflate/symbol] :keyword] (result-error-of [:result :vector-i64 :keyword] r :invalid-tree))
   (let [c (result-value-of [:result :vector-i64 :keyword] r [])]
    (loop [width 1 code 0 first 0 pos offset]
     (if (> width 15) (result-err-of [:result [:ref :deflate/symbol] :keyword] :bad-code)
      (let [b (bits/read-bits input pos 1)]
       (if (not (result-ok?-of [:result [:ref :deflate/read] :keyword] b))
        (result-err-of [:result [:ref :deflate/symbol] :keyword] (result-error-of [:result [:ref :deflate/read] :keyword] b :truncated))
        (let [one (result-value-of [:result [:ref :deflate/read] :keyword] b (record-new [:ref :deflate/read] 0 0))
              next-code (+ (* code 2) (record-get [:ref :deflate/read] one :value))
              n (vector-at c width) delta (- next-code first)]
         (if (and (>= delta 0) (< delta n))
          (result-ok-of [:result [:ref :deflate/symbol] :keyword]
           (record-new [:ref :deflate/symbol] (at-ordinal lengths width delta) (+ pos 1)))
          (recur (+ width 1) next-code (* 2 (+ first n)) (+ pos 1)))))))))))
)
