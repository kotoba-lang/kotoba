;; Strict, bounded RFC1950 subset: one final dynamic DEFLATE block, 32 KiB
;; window, no dictionary, exact trailer/EOF and Adler-32. Other profiles fail.
(ns deflate.zlib-single
 (:require [deflate.bit-reader :as bits] [deflate.dynamic-tables :as dynamic] [deflate.huffman-block :as block])
 (:export [inflate]))
(defn- take-bits [data :vector-i64 offset :i64 width :i64] [:ref :deflate/read]
 (let [r (bits/read-bits data offset width)]
  (if (result-ok?-of [:result [:ref :deflate/read] :keyword] r)
   (result-value-of [:result [:ref :deflate/read] :keyword] r (record-new [:ref :deflate/read] 0 0))
   (throw (result-error-of [:result [:ref :deflate/read] :keyword] r :truncated)))))
(defn- adler [data :vector-i64] :i64
 (loop [i 0 a 1 b 0]
  (if (= i (vector-count data)) (+ (* b 65536) a)
   (let [next-a (rem (+ a (vector-at data i)) 65521)]
    (recur (+ i 1) next-a (rem (+ b next-a) 65521))))))
(defn- decode! [data :vector-i64 limit :i64] :vector-i64
 (let [n (vector-count data)]
  (if (or (< n 7) (> n 16777216)) (throw :invalid-size)
   (let [cmf (vector-at data 0) flg (vector-at data 1)]
    (cond (or (< cmf 0) (> cmf 255) (< flg 0) (> flg 255)
              (not= (bit-and cmf 15) 8) (not= (rem (+ (* cmf 256) flg) 31) 0)) (throw :invalid-header)
          (not= (quot cmf 16) 7) (throw :unsupported-window)
          (not= (bit-and flg 32) 0) (throw :unsupported-dictionary)
          :else
          (let [final (take-bits data 16 1) kind (take-bits data 17 2)]
           (if (or (not= (record-get [:ref :deflate/read] final :value) 1) (not= (record-get [:ref :deflate/read] kind :value) 2))
            (throw :unsupported-block)
            (let [table (dynamic/read-tables data 19)]
             (if (not (result-ok?-of [:result [:ref :deflate/tables] :keyword] table))
              (throw (result-error-of [:result [:ref :deflate/tables] :keyword] table :invalid-tree))
              (let [t (result-value-of [:result [:ref :deflate/tables] :keyword] table (record-new [:ref :deflate/tables] [] [] 0))
                    result (block/inflate-block data (record-get [:ref :deflate/tables] t :next)
                            (record-get [:ref :deflate/tables] t :literal) (record-get [:ref :deflate/tables] t :distance) limit)]
               (if (not (result-ok?-of [:result [:ref :deflate/block] :keyword] result))
                (throw (result-error-of [:result [:ref :deflate/block] :keyword] result :invalid-block))
                (let [r (result-value-of [:result [:ref :deflate/block] :keyword] result (record-new [:ref :deflate/block] [] 0))
                      end (record-get [:ref :deflate/block] r :next) output (record-get [:ref :deflate/block] r :bytes) p (- n 4)
                      x0 (vector-at data p) x1 (vector-at data (+ p 1)) x2 (vector-at data (+ p 2)) x3 (vector-at data (+ p 3))]
                 (cond (not= (quot (+ end 7) 8) p) (throw :invalid-end)
                       (or (< x0 0) (> x0 255) (< x1 0) (> x1 255) (< x2 0) (> x2 255) (< x3 0) (> x3 255)) (throw :invalid-byte)
                       (not= (adler output) (+ (* x0 16777216) (* x1 65536) (* x2 256) x3)) (throw :checksum)
                       :else output))))))))))))
)
(defn inflate [data :vector-i64 limit :i64] [:result :vector-i64 :keyword]
 (try (result-ok-of [:result :vector-i64 :keyword] (decode! data limit))
  (catch :keyword e (result-err-of [:result :vector-i64 :keyword] e))))
