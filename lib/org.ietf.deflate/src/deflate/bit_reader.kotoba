;; RFC 1951 data elements are read least-significant bit first. The caller
;; owns the input and next bit offset; a failed read returns no advanced state.
(ns deflate.bit-reader
 (:export [read-bits align-byte])
 (:schemas {:deflate/read [:record :deflate/read [[:value :i64] [:next :i64]]]}))

(defn read-bits [bytes :vector-i64 offset :i64 width :i64] [:result [:ref :deflate/read] :keyword]
 (let [n (vector-count bytes)]
  (cond (or (> n 16777216) (< offset 0) (< width 0) (> width 24))
         (result-err-of [:result [:ref :deflate/read] :keyword] :invalid-bound)
        (or (> offset (* n 8)) (> width (- (* n 8) offset)))
         (result-err-of [:result [:ref :deflate/read] :keyword] :truncated)
        :else
         (loop [i 0 out 0]
          (if (= i width)
           (result-ok-of [:result [:ref :deflate/read] :keyword] (record-new [:ref :deflate/read] out (+ offset width)))
           (let [pos (+ offset i) b (vector-at bytes (quot pos 8))]
            (if (or (< b 0) (> b 255))
             (result-err-of [:result [:ref :deflate/read] :keyword] :invalid-byte)
             (recur (+ i 1) (bit-or out (i64-shift-left (bit-and 1 (i64-shift-right b (rem pos 8))) i))))))))))

(defn align-byte [bytes :vector-i64 offset :i64] [:result :i64 :keyword]
 (let [n (vector-count bytes)]
  (cond (or (> n 16777216) (< offset 0)) (result-err-of [:result :i64 :keyword] :invalid-bound)
        (> offset (* n 8)) (result-err-of [:result :i64 :keyword] :truncated)
        :else (result-ok-of [:result :i64 :keyword] (* 8 (quot (+ offset 7) 8))))))
