;; Bounded RFC 1951 dynamic code-length table reader. OFFSET follows BTYPE.
;; This reads table lengths only and checks DEFLATE alphabet completeness.
(ns deflate.dynamic-tables
 (:require [deflate.bit-reader :as bits] [deflate.huffman-reader :as h])
 (:export [read-tables])
 (:schemas {:deflate/tables [:record :deflate/tables [[:literal :vector-i64] [:distance :vector-i64] [:next :i64]]]
            :deflate/lengths [:record :deflate/lengths [[:values :vector-i64] [:next :i64]]]}))
(defn- take-bits [data :vector-i64 pos :i64 width :i64] [:ref :deflate/read]
 (let [r (bits/read-bits data pos width)]
  (if (result-ok?-of [:result [:ref :deflate/read] :keyword] r)
   (result-value-of [:result [:ref :deflate/read] :keyword] r (record-new [:ref :deflate/read] 0 0))
   (throw (result-error-of [:result [:ref :deflate/read] :keyword] r :truncated)))))
(defn- slice [data :vector-i64 start :i64 length :i64] :vector-i64
 (loop [i 0 out (vector-alloc length)]
  (if (= i length) out (recur (+ i 1) (vector-assoc! out i (vector-at data (+ start i)))))))
(defn- read-code-lengths-loop [data :vector-i64 start :i64 n :i64 order :vector-i64 i :i64 out :vector-i64] :vector-i64
 (if (= i n) out
  (let [one (take-bits data (+ start (* i 3)) 3)]
   (read-code-lengths-loop data start n order (+ i 1) (vector-assoc! out (vector-at order i) (record-get [:ref :deflate/read] one :value))))))
(defn- fill-lengths [out :vector-i64 at :i64 n :i64 fill :i64] :vector-i64
 (loop [j 0 v out] (if (= j n) v (recur (+ j 1) (vector-assoc! v (+ at j) fill)))))
(defn- decode-lengths [data :vector-i64 pos :i64 out :vector-i64 i :i64 clens :vector-i64] [:ref :deflate/lengths]
 (if (= i (vector-count out)) (record-new [:ref :deflate/lengths] out pos)
  (let [r (h/decode-symbol clens data pos)]
   (if (not (result-ok?-of [:result [:ref :deflate/symbol] :keyword] r))
    (throw (result-error-of [:result [:ref :deflate/symbol] :keyword] r :invalid-tree))
    (let [one (result-value-of [:result [:ref :deflate/symbol] :keyword] r (record-new [:ref :deflate/symbol] 0 0))
          s (record-get [:ref :deflate/symbol] one :symbol) next (record-get [:ref :deflate/symbol] one :next)]
     (cond (< s 16) (decode-lengths data next (vector-assoc! out i s) (+ i 1) clens)
           (> s 18) (throw :invalid-repeat)
           (and (= s 16) (= i 0)) (throw :repeat-without-previous)
           :else
            (let [width (if (= s 16) 2 (if (= s 17) 3 7)) base (if (= s 18) 11 3)
                  extra (take-bits data next width) n (+ base (record-get [:ref :deflate/read] extra :value))
                  fill (if (= s 16) (vector-at out (- i 1)) 0)]
             (if (> (+ i n) (vector-count out)) (throw :repeat-overrun)
              (decode-lengths data (+ next width) (fill-lengths out i n fill) (+ i n) clens)))))))))
(defn- decode! [data :vector-i64 offset :i64] [:ref :deflate/tables]
 (let [a (take-bits data offset 5) b (take-bits data (+ offset 5) 5) c (take-bits data (+ offset 10) 4)
       hlit (+ 257 (record-get [:ref :deflate/read] a :value)) hdist (+ 1 (record-get [:ref :deflate/read] b :value))
       hclen (+ 4 (record-get [:ref :deflate/read] c :value)) order (vector-i64 16 17 18 0 8 7 9 6 10 5 11 4 12 3 13 2 14 1 15)]
  (if (> hlit 286) (throw :invalid-literal-count)
   (let [clens (read-code-lengths-loop data (+ offset 14) hclen order 0 (vector-alloc 19))
         cv (h/validate-lengths clens)
         _ (if (not (result-ok?-of [:result :vector-i64 :keyword] cv)) (throw (result-error-of [:result :vector-i64 :keyword] cv :invalid-tree))
             (if (not (h/complete-or-single? (result-value-of [:result :vector-i64 :keyword] cv []) false)) (throw :incomplete-code-tree) 0))
         decoded (decode-lengths data (+ offset 14 (* hclen 3)) (vector-alloc (+ hlit hdist)) 0 clens)
         out (record-get [:ref :deflate/lengths] decoded :values) l (slice out 0 hlit) d (slice out hlit hdist)
         lv (h/validate-lengths l) dv (h/validate-lengths d)]
    (cond (= (vector-at l 256) 0) (throw :missing-end-code)
          (not (result-ok?-of [:result :vector-i64 :keyword] lv)) (throw (result-error-of [:result :vector-i64 :keyword] lv :invalid-tree))
          (not (h/complete-or-single? (result-value-of [:result :vector-i64 :keyword] lv []) true)) (throw :incomplete-literal-tree)
          (and (not (result-ok?-of [:result :vector-i64 :keyword] dv)) (not (and (= hdist 1) (= (vector-at d 0) 0))))
           (throw (result-error-of [:result :vector-i64 :keyword] dv :invalid-tree))
          (and (result-ok?-of [:result :vector-i64 :keyword] dv)
               (not (h/complete-or-single? (result-value-of [:result :vector-i64 :keyword] dv []) true))) (throw :incomplete-distance-tree)
          :else (record-new [:ref :deflate/tables] l d (record-get [:ref :deflate/lengths] decoded :next)))))))
(defn read-tables [data :vector-i64 offset :i64] [:result [:ref :deflate/tables] :keyword]
 (try (result-ok-of [:result [:ref :deflate/tables] :keyword] (decode! data offset))
  (catch :keyword e (result-err-of [:result [:ref :deflate/tables] :keyword] e))))
