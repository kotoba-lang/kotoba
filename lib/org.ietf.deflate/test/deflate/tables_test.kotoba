(ns deflate.tables-test (:export [main]) (:require [deflate.tables :as t]))

(defn- at [v :document i :i64] :i64
  (option-value-of [:option :i64] (document-i64-value (option-value-of [:option :document] (document-vector-at v i) (document-null))) -1))

(defn- code-is [r :document a :i64 b :i64 c :i64] :i64
  (if (and (= (at r 0) a) (and (= (at r 1) b) (= (at r 2) c))) 0 1))

(defn main [] :i64
  (+ (if (= (document-count (t/len-base)) 29) 0 1)
     (if (= (document-count (t/len-extra)) 29) 0 1)
     (if (= (document-count (t/dist-base)) 30) 0 1)
     (if (= (document-count (t/dist-extra)) 30) 0 1)
     (if (= (document-count (t/clc-order)) 19) 0 1)
     (if (= (document-count (t/fixed-lit-lengths)) 288) 0 1)
     (if (= (at (t/fixed-lit-lengths) 143) 8) 0 1)
     (if (= (at (t/fixed-lit-lengths) 144) 9) 0 1)
     (if (= (at (t/fixed-lit-lengths) 287) 8) 0 1)
     (if (= (document-count (t/fixed-dist-lengths)) 30) 0 1)
     (if (= (t/max-code-length) 15) 0 1)
     (if (= (t/max-clc-length) 7) 0 1)
     (code-is (t/len-code 3) 257 0 0)
     (code-is (t/len-code 10) 264 0 0)
     (code-is (t/len-code 11) 265 1 0)
     (code-is (t/len-code 12) 265 1 1)
     (code-is (t/len-code 258) 285 0 0)
     (code-is (t/dist-code 1) 0 0 0)
     (code-is (t/dist-code 5) 4 1 0)
     (code-is (t/dist-code 32768) 29 13 8191)
     (if (document-equal? (t/len-code 2) (document-null)) 0 1)
     (if (document-equal? (t/dist-code 0) (document-null)) 0 1)))
