(ns deflate.bit-reader-test (:require [deflate.bit-reader :as b]) (:export [main]))
(defn main [] :i64
 (let [xs (vector-i64 178 97) a (b/read-bits xs 0 3) c (b/read-bits xs 3 7)
       empty (b/read-bits xs 16 0) trunc (b/read-bits xs 15 2)
       bad (b/read-bits (vector-i64 256) 0 1) width (b/read-bits xs 0 25)
       aligned (b/align-byte xs 9) past (b/align-byte xs 17)]
  (cond (not (result-ok?-of [:result [:ref :deflate/read] :keyword] a)) 1
        (not= (record-get [:ref :deflate/read] (result-value-of [:result [:ref :deflate/read] :keyword] a (record-new [:ref :deflate/read] 0 0)) :value) 2) 2
        (not= (record-get [:ref :deflate/read] (result-value-of [:result [:ref :deflate/read] :keyword] c (record-new [:ref :deflate/read] 0 0)) :value) 54) 3
        (not= (record-get [:ref :deflate/read] (result-value-of [:result [:ref :deflate/read] :keyword] c (record-new [:ref :deflate/read] 0 0)) :next) 10) 4
        (not (result-ok?-of [:result [:ref :deflate/read] :keyword] empty)) 5
        (not= (result-error-of [:result [:ref :deflate/read] :keyword] trunc :unexpected) :truncated) 6
        (not= (result-error-of [:result [:ref :deflate/read] :keyword] bad :unexpected) :invalid-byte) 7
        (not= (result-error-of [:result [:ref :deflate/read] :keyword] width :unexpected) :invalid-bound) 8
        (not= (result-value-of [:result :i64 :keyword] aligned -1) 16) 9
        (not= (result-error-of [:result :i64 :keyword] past :unexpected) :truncated) 10
        :else 0)))
