(ns deflate.zlib-single-test (:require [deflate.zlib-single :as z]) (:export [main]))
(defn main [] :i64
 (let [short (z/inflate (vector-i64 120 1) 100)
       header (z/inflate (vector-i64 120 0 0 0 0 0 0) 100)
       window (z/inflate (vector-i64 8 29 0 0 0 0 0) 100)
       dictionary (z/inflate (vector-i64 120 32 0 0 0 0 0) 100)
       stored (z/inflate (vector-i64 120 1 1 0 0 255 255 0 0 0 1) 100)
       nonfinal (z/inflate (vector-i64 120 1 4 0 0 0 0) 100)]
  (cond (not= (result-error-of [:result :vector-i64 :keyword] short :none) :invalid-size) 1
        (not= (result-error-of [:result :vector-i64 :keyword] header :none) :invalid-header) 2
        (not= (result-error-of [:result :vector-i64 :keyword] window :none) :unsupported-window) 3
        (not= (result-error-of [:result :vector-i64 :keyword] dictionary :none) :unsupported-dictionary) 4
        (not= (result-error-of [:result :vector-i64 :keyword] stored :none) :unsupported-block) 5
        (not= (result-error-of [:result :vector-i64 :keyword] nonfinal :none) :unsupported-block) 6
        :else 0)))
