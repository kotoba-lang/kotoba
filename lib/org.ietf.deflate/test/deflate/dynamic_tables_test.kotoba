(ns deflate.dynamic-tables-test (:require [deflate.dynamic-tables :as d]) (:export [main]))
(defn main [] :i64
 (let [truncated (d/read-tables (vector-i64) 0)
       bad-count (d/read-tables (vector-i64 30 0) 0)
       empty-tree (d/read-tables (vector-i64 0 0 0 0) 0)
       incomplete (d/read-tables (vector-i64 0 128 0 0) 0)
       incomplete-lit (d/read-tables (vector-i64 0 56 16 1 0 0 0 24 118 127 234 7) 0)
       incomplete-dist (d/read-tables (vector-i64 32 56 16 1 0 0 0 24 54 127 234 61) 0)
       first-repeat (d/read-tables (vector-i64 0 64 128 4) 0)
       overrun (d/read-tables (vector-i64 0 56 16 1 0 0 0 0 228 239 15) 0)
       positive (d/read-tables (vector-i64 0 56 16 1 0 0 0 0 180 63 245 1) 0)
       v (result-value-of [:result [:ref :deflate/tables] :keyword] positive (record-new [:ref :deflate/tables] [] [] 0))
       lit (record-get [:ref :deflate/tables] v :literal) dist (record-get [:ref :deflate/tables] v :distance)]
  (cond (not= (result-error-of [:result [:ref :deflate/tables] :keyword] truncated :none) :truncated) 1
        (not= (result-error-of [:result [:ref :deflate/tables] :keyword] bad-count :none) :invalid-literal-count) 2
        (not= (result-error-of [:result [:ref :deflate/tables] :keyword] empty-tree :none) :invalid-tree) 3
        (not= (result-error-of [:result [:ref :deflate/tables] :keyword] incomplete :none) :incomplete-code-tree) 9
        (not= (result-error-of [:result [:ref :deflate/tables] :keyword] incomplete-lit :none) :incomplete-literal-tree) 10
        (not= (result-error-of [:result [:ref :deflate/tables] :keyword] incomplete-dist :none) :incomplete-distance-tree) 11
        (not= (result-error-of [:result [:ref :deflate/tables] :keyword] first-repeat :none) :repeat-without-previous) 4
        (not= (result-error-of [:result [:ref :deflate/tables] :keyword] overrun :none) :repeat-overrun) 8
        (not (result-ok?-of [:result [:ref :deflate/tables] :keyword] positive)) 5
        (or (not= (vector-count lit) 257) (not= (vector-at lit 0) 1) (not= (vector-at lit 1) 0) (not= (vector-at lit 256) 1)) 6
        (or (not= (vector-count dist) 1) (not= (vector-at dist 0) 0) (not= (record-get [:ref :deflate/tables] v :next) 90)) 7
        :else 0)))
