(ns deflate.huffman-block-test (:require [deflate.huffman-block :as block]) (:export [main]))
(defn- same? [a :vector-i64 b :vector-i64] :bool
 (and (= (vector-count a) (vector-count b)) (loop [i 0] (if (= i (vector-count a)) true (and (= (vector-at a i) (vector-at b i)) (recur (+ i 1)))))))
(defn main [] :i64
 (let [v (vector-alloc 258) _ (vector-assoc! v 65 1) _ (vector-assoc! v 256 2) _ (vector-assoc! v 257 2)
       dist (vector-i64 1) good (block/inflate-block (vector-i64 22) 0 v dist 4)
       short (block/inflate-block (vector-i64 22) 0 v dist 3)
       bad-distance (block/inflate-block (vector-i64 3) 0 v dist 20)
       trunc (block/inflate-block (vector-i64 0) 0 v dist 20)
       work (block/inflate-block (vector-alloc 513) 0 v dist 6000)
       bounded (block/inflate-block (vector-i64 22) 0 v dist 1048577)
       x (result-value-of [:result [:ref :deflate/block] :keyword] good (record-new [:ref :deflate/block] [] 0))]
  (cond (not (result-ok?-of [:result [:ref :deflate/block] :keyword] good)) 1
        (not (same? (record-get [:ref :deflate/block] x :bytes) (vector-i64 65 65 65 65))) 2
        (not= (record-get [:ref :deflate/block] x :next) 6) 3
        (not= (result-error-of [:result [:ref :deflate/block] :keyword] short :none) :output-limit) 4
        (not= (result-error-of [:result [:ref :deflate/block] :keyword] bad-distance :none) :bad-distance) 5
        (not= (result-error-of [:result [:ref :deflate/block] :keyword] trunc :none) :truncated) 6
        (not= (result-error-of [:result [:ref :deflate/block] :keyword] bounded :none) :invalid-bound) 7
        (not= (result-error-of [:result [:ref :deflate/block] :keyword] work :none) :work-limit) 8
        :else 0)))
