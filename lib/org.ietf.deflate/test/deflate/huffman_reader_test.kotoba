(ns deflate.huffman-reader-test (:require [deflate.huffman-reader :as h]) (:export [main]))
(defn main [] :i64
 (let [lens (vector-i64 1 2 2) wire (vector-i64 26)
       a (h/decode-symbol lens wire 0) b (h/decode-symbol lens wire 1) c (h/decode-symbol lens wire 3)
       excess (h/decode-symbol (vector-i64 1 1 1) wire 0)
       empty (h/decode-symbol (vector-i64 0 0) wire 0)
       trunc (h/decode-symbol (vector-i64 1 2 2) (vector-i64 128) 7)
       badlen (h/decode-symbol (vector-i64 16) wire 0)]
  (cond (not= (record-get [:ref :deflate/symbol] (result-value-of [:result [:ref :deflate/symbol] :keyword] a (record-new [:ref :deflate/symbol] -1 -1)) :symbol) 0) 1
        (not= (record-get [:ref :deflate/symbol] (result-value-of [:result [:ref :deflate/symbol] :keyword] b (record-new [:ref :deflate/symbol] -1 -1)) :symbol) 1) 2
        (not= (record-get [:ref :deflate/symbol] (result-value-of [:result [:ref :deflate/symbol] :keyword] c (record-new [:ref :deflate/symbol] -1 -1)) :symbol) 2) 3
        (not= (record-get [:ref :deflate/symbol] (result-value-of [:result [:ref :deflate/symbol] :keyword] c (record-new [:ref :deflate/symbol] -1 -1)) :next) 5) 4
        (not= (result-error-of [:result [:ref :deflate/symbol] :keyword] excess :none) :oversubscribed) 5
        (not= (result-error-of [:result [:ref :deflate/symbol] :keyword] empty :none) :invalid-tree) 6
        (not= (result-error-of [:result [:ref :deflate/symbol] :keyword] trunc :none) :truncated) 7
        (not= (result-error-of [:result [:ref :deflate/symbol] :keyword] badlen :none) :invalid-tree) 8
        :else 0)))
