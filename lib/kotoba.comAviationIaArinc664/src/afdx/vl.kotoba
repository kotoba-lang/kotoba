;; Port of afdx.vl (vl.cljk), Kotoba-native, :document results.
;;
;; The VL ID is embedded in the destination MAC as 03:00:00:00:HH:LL (see the
;; source's provenance note: this convention is not verified against ARINC 664
;; Part 7 and must be checked against a real network before use).
;;
;; Named divergences from vl.cljk:
;;   - results are tagged :document vectors: [:ok [6 octets]] / [:ok vl-id] /
;;     [:error <reason> value], as in the source.
;;   - a MAC that is not a 6-element vector is read by its elements, and an
;;     absent or non-integer octet reads as -1, so it never matches the prefix.

(ns afdx.vl
  (:export [vl-id->dst-mac dst-mac->vl-id]))

(defn- octet [mac :document i :i64] :i64
  (option-or (document-i64-value (option-or (document-vector-at mac i) (document-null))) -1))

(defn vl-id->dst-mac [vl-id :i64] :document
  (if (and (>= vl-id 0) (<= vl-id 65535))
    (document-vector (document-keyword :ok)
                     (document-vector (document-i64 3) (document-i64 0) (document-i64 0) (document-i64 0)
                                      (document-i64 (bit-and (i64-shift-right vl-id 8) 255))
                                      (document-i64 (bit-and vl-id 255))))
    (document-vector (document-keyword :error) (document-keyword :afdx/vl-id-out-of-range)
                     (document-i64 vl-id))))

(defn dst-mac->vl-id [mac :document] :document
  (if (and (= (document-count mac) 6)
           (= (octet mac 0) 3) (= (octet mac 1) 0) (= (octet mac 2) 0) (= (octet mac 3) 0))
    (document-vector (document-keyword :ok)
                     (document-i64 (bit-or (i64-shift-left (octet mac 4) 8) (octet mac 5))))
    (document-vector (document-keyword :error) (document-keyword :afdx/not-a-vl-mac) mac)))
