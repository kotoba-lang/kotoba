(ns afdx.vl-test
  (:export [main])
  (:require [afdx.vl :as vl]))

(defn- at [v :document i :i64] :document
  (option-or (document-vector-at v i) (document-null)))

(defn- tag [v :document] :string
  (keyword-name (option-or (document-keyword-value (at v 0)) :none)))

(defn- octet [m :document i :i64] :i64
  (option-or (document-i64-value (at m i)) -1))

(defn main [] :i64
  (let [ok (vl/vl-id->dst-mac 4660)
        mac (at ok 1)
        back (vl/dst-mac->vl-id mac)]
    (+ (if (string=? (tag ok) "ok") 0 1)
       (if (= (octet mac 0) 3) 0 1)
       (if (= (octet mac 4) 18) 0 1)
       (if (= (octet mac 5) 52) 0 1)
       (if (string=? (tag back) "ok") 0 1)
       (if (= (option-or (document-i64-value (at back 1)) -1) 4660) 0 1)
       (if (string=? (tag (vl/vl-id->dst-mac 65536)) "error") 0 1)
       (if (string=? (tag (vl/dst-mac->vl-id (document-vector (document-i64 1) (document-i64 2) (document-i64 3)
                                                             (document-i64 4) (document-i64 5) (document-i64 6))))
                     "error") 0 1))))
