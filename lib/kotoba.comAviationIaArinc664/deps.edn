;; No dependencies. AFDX is Ethernet + IPv4 + UDP framing plus a handful
;; of AFDX-specific fields (VL-in-MAC, trailing sequence number, BAG,
;; redundancy). A leaf that dragged in a real socket/NIC stack would
;; defeat the point, which is that this codec has to be checkable on
;; both the JVM and ClojureScript.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
