(ns kotobase.blockcodec.inflate-provider-test
  (:require [kotoba.test :refer [deftest is]]
            [deflate.core :as d]
            [kotobase.blockcodec.core :as bc]
            [kotobase.blockcodec.golden-test :as golden]
            [kotobase.blockcodec.fixtures :as fx]))

(deftest decoder-provider-cannot-change-writer-bytes-or-accept-damage
  (let [calls (atom 0)
        provider (fn [bytes] (swap! calls inc) (d/inflate bytes))]
    (try
      (is (= :host (bc/install-inflate! provider)))
      (reset! calls 0)
      (is (= (fx/golden-input) (bc/unframe golden/golden-framed)))
      (is (= 1 @calls))
      (is (= golden/golden-framed (bc/frame (fx/golden-input))))
      (is (= 1 @calls) "encoding never calls a host decoder")
      (is (= [160] (bc/unframe [160])))
      (is (= [1 2] (bc/unframe [0 1 2])))
      (is (thrown? #?(:clj Exception :cljs js/Error)
                   (bc/install-inflate! (constantly []))))
      (is (= (fx/golden-input) (bc/unframe golden/golden-framed))
          "bad installation must leave the validated decoder intact")
      (finally (bc/install-inflate! nil)))))
