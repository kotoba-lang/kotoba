;; Port of isobmff.blob (blob.cljk), Kotoba-native.
;;
;; content-id is FNV-1a 32-bit over a byte vector, rendered as
;; "isobmff-fnv1a32-<8 lowercase hex digits>". Deterministic placeholder,
;; the same as the source.
;; Named divergences:
;;   - the byte vector is a :vector-i64 (the source takes any seq of ints).
;;     Each byte is masked with 255, as the source does with (bit-and (int x) 0xff).
;;   - bit-shift-left is not in the Kotoba surface; h << k is written as
;;     h * 2^k (exact: h1 < 2^32 and k <= 24, so the product fits in i64).
;;     Right shifts are written as quot by 16 (non-negative values only).
(ns isobmff.blob
  (:export [content-id]))

(defn- fnv-step [h :i64 x :i64] :i64
  (let [h1 (bit-xor h (bit-and x 255))]
    (bit-and (+ h1 (+ (* h1 2)
                      (+ (* h1 16)
                         (+ (* h1 128)
                            (+ (* h1 256) (* h1 16777216))))))
             4294967295)))

(defn- hash-bytes [bs :vector-i64] :i64
  (let [n (vector-count bs)]
    (loop [i 0 h 2166136261]
      (if (>= i n)
        h
        (recur (+ i 1) (fnv-step h (vector-at bs i)))))))

(defn- hex-digit [d :i64] :string
  (string-substring "0123456789abcdef" d (+ d 1)))

(defn- hex8 [h :i64] :string
  (loop [i 0 x h acc ""]
    (if (>= i 8)
      acc
      (let [q (quot x 16)]
        (recur (+ i 1) q (string-concat (hex-digit (- x (* 16 q))) acc))))))

(defn content-id [bs :vector-i64] :string
  (string-concat "isobmff-fnv1a32-" (hex8 (hash-bytes bs))))
