;; Test for isobmff.blob. main returns the number of failed cases.
;; Expected values: FNV-1a 32 of the empty input is the offset basis 0x811c9dc5;
;; FNV-1a 32 of "a" is 0xe40c292c; of "foobar" is 0xbf9cf968.
(ns isobmff.blob-test
  (:export [main])
  (:require [isobmff.blob :as b]))

(defn- chk [ok :bool] :i64
  (if ok 0 1))

(defn- empty-and-a [] :i64
  (+ (chk (string=? (b/content-id (vector-i64)) "isobmff-fnv1a32-811c9dc5"))
     (chk (string=? (b/content-id (vector-i64 97)) "isobmff-fnv1a32-e40c292c"))))

(defn- foobar-and-same [] :i64
  (let [fb (vector-i64 102 111 111 98 97 114)]
    (+ (chk (string=? (b/content-id fb) "isobmff-fnv1a32-bf9cf968"))
       (chk (string=? (b/content-id fb) (b/content-id fb))))))

(defn main [] :i64
  (+ (empty-and-a) (foobar-and-same)))
