;; This repository's entry in the kotoba.repository-role-rules taxonomy.
;; ADR-2607266000 / ADR-2607299000.
{:schema "kotoba.repository-role-rules.v0"
 :this-repo
 {:name "paging"
  :tier :t5
  :role :library
  ;; The whole point is that the policy is a pure function: it emits :fetch,
  ;; :writeback and :drop and lets a host perform them. A wall clock would
  ;; also destroy replay, which is what makes eviction testable at all.
  :must-not [:perform-io :read-a-wall-clock :probe-hardware]
  :depends-on ["kotoba-lang/machine"]}}
