(ns json.native-test (:export [main]) (:require [json.core :as json]))

(defn- good? [source :string expected :string] :bool
  (let [r (json/decode source)]
    (if (result-ok?-of [:result :document :document] r)
      (string=? (json/encode (result-value-of [:result :document :document] r (document-null))) expected)
      false)))

(defn- bad? [source :string] :bool
  (not (result-ok?-of [:result :document :document] (json/decode source))))

(defn main [] :i64
  (if (and
        (good? "{\"x\":[[[[[[[0]]]]]]]}" "{\"x\":[[[[[[[0]]]]]]]}")
        (good? "{\"x\":1,\"x\":2}" "{\"x\":2}")
        (good? "{\"x\":{\"y\":1,\"\\u0079\":2}}" "{\"x\":{\"y\":2}}")
        (good? "[true,false,null,0,0.7999,\"日本😀\"]" "[true,false,null,0,0.7999,\"日本😀\"]")
        (good? "\"\\b\\f\\n\\r\\t\\/\\\\\\\"\"" "\"\\b\\f\\n\\r\\t/\\\\\\\"\"")
        (good? "\"\\u0000\"" "\"\\u0000\"")
        (bad? "[1,]") (bad? "{\"a\":1,}") (bad? "{\"a\":}")
        (bad? "{a:1}") (bad? "\"raw\nline\"") (bad? "01")
        (bad? "1.") (bad? "1e+") (bad? "\"\\q\"")
        (bad? "\"\\uD800\"") (bad? "{} trailing"))
    42 7))
