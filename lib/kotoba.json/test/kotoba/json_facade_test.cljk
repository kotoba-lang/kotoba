(ns kotoba.json-facade-test
  "kotoba.json re-exports clojure.data.json's read-str / write-str contract.
  Needs the definition repos (json-decode, ...) on the classpath, so it runs
  under `kbb -M:test`, not under run-tests.cljk's bare -cp."
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.json :as kj]
            [json.clojure-data-json :as j]))

(deftest facade-re-exports-read-str-and-write-str
  (is (identical? j/read-str kj/read-str))
  (is (identical? j/write-str kj/write-str))
  (is (= "{\"u\":\"a\\/b\"}" (kj/write-str {:u "a/b"})))
  (is (= {:a 1} (kj/read-str "{\"a\":1}" :key-fn keyword))))
