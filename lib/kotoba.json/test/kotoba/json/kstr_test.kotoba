(ns kotoba.json.kstr-test (:export [main]) (:require [kotoba.json.kstr :as p]))

(defn main [] :i64
  (+ (if (string=? (p/kstr (document-keyword :name)) "name") 0 1)
     (if (string=? (p/kstr (document-keyword :ns/key)) "key") 0 1)
     (if (string=? (p/kstr (document-string "plain")) "plain") 0 1)
     (if (string=? (p/kstr (document-null)) "") 0 1)
     (if (string=? (p/kstr (document-i64 42)) "42") 0 1)))
