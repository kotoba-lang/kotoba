(ns kotoba.json.starts-test
  (:export [main])
  (:require [kotoba.json.starts :as j]))

(defn- check [ok :bool] :i64 (if ok 0 1))

(defn main [] :i64
  (+ (check (j/starts? "{\"a\":1}" 0 "{"))
     (check (not (j/starts? "{\"a\":1}" 0 "[")))
     (check (j/starts? "xtrue" 1 "true"))
     (check (not (j/starts? "tru" 0 "true")))
     (check (j/starts? "abc" 3 ""))
     (check (not (j/starts? "abc" 4 "")))
     (check (not (j/starts? "abc" -1 "a")))))
