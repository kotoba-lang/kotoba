;; Batch B -- lexing: whitespace, escapes, UTF-8, and the refused escapes.
;; Spliced onto kotoba/json_scalar.kotoba by scripts/kotoba_test.cljk; not a
;; standalone compilation unit. See batch A's header for why these are split.

(defn is-some? [got [:option :string] want :string] :bool
  (and (option-some?-of [:option :string] got)
       (string=? (option-value-of [:option :string] got "") want)))

(defn is-none? [got [:option :string]] :bool
  (not (option-some?-of [:option :string] got)))

(defn test-whitespace [] :i64
  (if (is-some? (json-string-field "{ \"a\" : \"x\" , \"b\" : \"y\" }" "b") "y") 1 0))

(defn test-escape-newline [] :i64
  (if (is-some? (json-string-field "{\"a\":\"x\\ny\"}" "a") "x\ny") 1 0))

(defn test-escape-quote [] :i64
  (if (is-some? (json-string-field "{\"a\":\"q\\\"q\"}" "a") "q\"q") 1 0))

(defn test-escape-tab [] :i64
  (if (is-some? (json-string-field "{\"a\":\"x\\ty\"}" "a") "x\ty") 1 0))

(defn test-escape-solidus [] :i64
  (if (is-some? (json-string-field "{\"a\":\"a\\/b\"}" "a") "a/b") 1 0))

(defn test-escape-backslash [] :i64
  (if (is-some? (json-string-field "{\"a\":\"a\\\\b\"}" "a") "a\\b") 1 0))

;; Two of the three named gaps: a refused escape returns none, never a wrong
;; answer. `\f` is the third and behaves identically to `\b`.
(defn test-u-escape-refused [] :i64
  (if (is-none? (json-string-field "{\"a\":\"\\u0041\"}" "a")) 1 0))

(defn test-b-escape-refused [] :i64
  (if (is-none? (json-string-field "{\"a\":\"x\\by\"}" "a")) 1 0))

;; A multi-byte code point in an EARLIER member must not desynchronise the
;; byte scan; every step advances by the code point's own width.
(defn test-utf8-skip [] :i64
  (if (is-some? (json-string-field "{\"a\":\"日本\",\"b\":\"y\"}" "b") "y") 1 0))

(defn test-utf8-value [] :i64
  (if (is-some? (json-string-field "{\"a\":\"日本\"}" "a") "日本") 1 0))

;; A `}` INSIDE a string must not end the object early.
(defn test-brace-inside-string [] :i64
  (if (is-some? (json-string-field "{\"a\":\"}\",\"b\":\"y\"}" "b") "y") 1 0))

;; A `:` and `,` inside a skipped string must not be read as structure.
(defn test-colon-inside-string [] :i64
  (if (is-some? (json-string-field "{\"a\":\"x:1,y\",\"b\":\"y\"}" "b") "y") 1 0))
