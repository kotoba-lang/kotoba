;; Batch A -- structure. Spliced onto kotoba/json_scalar.kotoba by
;; scripts/kotoba_test.cljk; not a standalone compilation unit.
;;
;; Batched because `amu test` runs every case in one file against a SINGLE
;; instance, and fuel is charged per function entry, so a whole suite shares
;; one 512-unit budget. Keep a batch under ~12 cases.

(defn is-some? [got [:option :string] want :string] :bool
  (and (option-some?-of [:option :string] got)
       (string=? (option-value-of [:option :string] got "") want)))

(defn is-none? [got [:option :string]] :bool
  (not (option-some?-of [:option :string] got)))

(defn test-plain [] :i64
  (if (is-some? (json-string-field "{\"a\":\"x\"}" "a") "x") 1 0))

(defn test-second [] :i64
  (if (is-some? (json-string-field "{\"a\":\"x\",\"b\":\"y\"}" "b") "y") 1 0))

(defn test-missing [] :i64
  (if (is-none? (json-string-field "{\"a\":\"x\"}" "zz")) 1 0))

(defn test-empty-object [] :i64
  (if (is-none? (json-string-field "{}" "a")) 1 0))

(defn test-not-an-object [] :i64
  (if (is-none? (json-string-field "[1,2]" "a")) 1 0))

(defn test-skip-object [] :i64
  (if (is-some? (json-string-field "{\"a\":{\"b\":\"q\"},\"c\":\"z\"}" "c") "z") 1 0))

(defn test-skip-array [] :i64
  (if (is-some? (json-string-field "{\"a\":[1,{\"b\":3}],\"c\":\"z\"}" "c") "z") 1 0))

(defn test-skip-number [] :i64
  (if (is-some? (json-string-field "{\"a\":-12.5,\"c\":\"z\"}" "c") "z") 1 0))

;; A key that only exists INSIDE a nested object is not a top-level member.
(defn test-nested-key-not-seen [] :i64
  (if (is-none? (json-string-field "{\"a\":{\"b\":\"q\"}}" "b")) 1 0))

;; "a" must not match the member "ab".
(defn test-key-is-not-a-prefix [] :i64
  (if (is-some? (json-string-field "{\"ab\":\"x\",\"a\":\"y\"}" "a") "y") 1 0))

(defn test-non-string-value [] :i64
  (if (is-none? (json-string-field "{\"a\":123}" "a")) 1 0))
