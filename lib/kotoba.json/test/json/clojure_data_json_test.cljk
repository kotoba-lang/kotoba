(ns json.clojure-data-json-test
  "Every expected string below is what org.clojure/data.json 2.5.2 returned on
  the JVM for the same input (measured 2026-09-24). The JVM side of this
  namespace was also compared against data.json directly: 415 inputs x
  options, 0 differences."
  (:require [kotoba.test :refer [deftest is testing]]
            [json.clojure-data-json :as j]))

(defn- throws? [f] (try (f) false (catch #?(:clj Throwable :cljs :default) _ true)))

(deftest write-str-defaults-match-data-json
  (is (= "{\"b\":1,\"a\":\"x\"}" (j/write-str (array-map :b 1 :a "x"))) "map order is the map's own")
  (is (= "{\"u\":\"a\\/b\"}" (j/write-str {"u" "a/b"})) ":escape-slash defaults to true")
  (is (= "{\"s\":\"\\u65e5\\u672c\\u00e9\"}" (j/write-str {"s" "日本é"})) ":escape-unicode defaults to true")
  (is (= "{\"s\":\"\\ud83d\\ude00\"}" (j/write-str {"s" "😀"})) "UTF-16 code units, lower-case hex")
  (is (= "{\"s\":\"a\\u0001b\\n\\t\\r\\b\\f\\u001f\u007f\"}"
         (j/write-str {"s" (str "a" "\u0001" "b\n\t\r\b\f" "\u001f" "\u007f")})))
  (is (= "{\"s\":\"\\u2028\\u2029\"}" (j/write-str {"s" "\u2028\u2029"})))
  (is (= "{\"k\":\"v\",\"n\":\"kw\"}" (j/write-str (array-map :k :v :n :ns/kw))))
  (is (= "{\"b\":1}" (j/write-str {:a/b 1})))
  (is (= "{\"s\":\"b\"}" (j/write-str {'s 'a/b})))
  (is (= "[1]" (j/write-str #{1})) "a set is an array, not \"#{1}\"")
  (is (= "[1,2]" (j/write-str '(1 2))))
  (is (= "[1,[2,{\"a\":null}],true,false]" (j/write-str [1 [2 {:a nil}] true false])))
  (is (= "\"00000000-0000-0000-0000-000000000001\"" (j/write-str #uuid "00000000-0000-0000-0000-000000000001")))
  (is (= "null" (j/write-str nil)))
  (is (= "\"a\\/b\"" (j/write-str "a/b")))
  (is (= "{\"1\":2}" (j/write-str {1 2})))
  (is (= "[{},[],\"\"]" (j/write-str [{} [] ""])))
  (is (= "12345678901234" (j/write-str 12345678901234)))
  (is (= "1.5" (j/write-str 1.5))))

(deftest write-str-options-match-data-json
  (is (= "{\"u\":\"a/b\"}" (j/write-str {"u" "a/b"} :escape-slash false)))
  (is (= "{\"s\":\"日本é\"}" (j/write-str {"s" "日本é"} :escape-unicode false)))
  (is (= "{\"s\":\"\\u2028\\u2029\"}" (j/write-str {"s" "\u2028\u2029"} :escape-unicode false))
      "JS separators stay escaped with :escape-unicode false")
  (is (= "{\n  \"b\": 1,\n  \"a\": \"x\"\n}" (j/write-str (array-map :b 1 :a "x") :indent true)))
  (is (= "[\n  1,\n  [\n    2,\n    {\n      \"a\": null\n    }\n  ],\n  true,\n  false\n]"
         (j/write-str [1 [2 {:a nil}] true false] :indent true)))
  (is (= "[\n  {},\n  [],\n  \"\"\n]" (j/write-str [{} [] ""] :indent true)))
  (is (= "{\"A-B\":1}" (j/write-str {:a-b 1} :key-fn #(.toUpperCase (name %)))))
  (is (= "{\"a\":2,\"b\":2}" (j/write-str (array-map :a 1 :b 2) :value-fn (fn [k v] (if (= k :a) (inc v) v)))))
  (is (= "{\"b\":2}" (j/write-str (array-map :a 1 :b 2) :value-fn (fn self [k v] (if (= k :a) self v))))
      "a value-fn returning itself omits the entry"))

(deftest write-str-refusals
  (is (throws? #(j/write-str {nil 1})) "a nil key throws")
  (is (throws? #(j/write-str (fn []))))
  (is (throws? #(j/write-str ##NaN)))
  (is (throws? #(j/write-str {:a 1} :indent)) "odd option count"))

(deftest read-str-matches-data-json
  (is (= {"a" 1 "b" [1 2.5 0 1000.0 0.01 true false nil]}
         (j/read-str "{\"a\":1,\"b\":[1,2.5,-0,1e3,1E-2,true,false,null]}")))
  (is (= {:a 1 :b [1]} (j/read-str "{\"a\":1,\"b\":[1]}" :key-fn keyword)))
  (testing "trailing input is ignored, as in clojure.data.json"
    (is (= 1 (j/read-str "1 2")))
    (is (= {"a" 1} (j/read-str "{\"a\":1} x")))
    (is (= [1] (j/read-str "[1]x")))
    (is (= 1 (j/read-str "1]"))))
  (testing "a number ends only at whitespace , ] } or the end"
    (is (throws? #(j/read-str "1x")))
    (is (throws? #(j/read-str "1/")))
    (is (throws? #(j/read-str "[1x]"))))
  (is (= "x" (j/read-str "  \"x\"  ")))
  (is (= "é/" (j/read-str "\"\\u00e9\\/\"")))
  (is (= "😀" (j/read-str "\"\\ud83d\\ude00\"")))
  (is (= {"a" 2} (j/read-str "{\"a\":1,\"a\":2}")))
  (is (= {:a {:b 1}} (j/read-str "{\"a\":{\"b\":1}}" :key-fn keyword)))
  (is (= {:a 2 :b 2} (j/read-str "{\"a\":1,\"b\":2}" :key-fn keyword :value-fn (fn [k v] (if (= k :a) (inc v) v))))
      "value-fn sees the key AFTER key-fn")
  (is (= {"b" 2} (j/read-str "{\"a\":1,\"b\":2}" :value-fn (fn self [k v] (if (= k "a") self v))))))

(deftest read-str-refusals
  (doseq [bad ["" "  " "[" "01" "nul" "[1,]" "tru" "\"unterminated" "{\"a\"}" "[1 2]" "-" "{\"x\":1,}" "\"\\x\""]]
    (is (throws? #(j/read-str bad)) (str "throws on " (pr-str bad))))
  (is (= :EOF (j/read-str "  " :eof-error? false :eof-value :EOF)))
  (is (throws? #(j/read-str "1.5" :bigdec true)) ":bigdec is refused, not approximated")
  (is (throws? #(j/read-str nil))))
