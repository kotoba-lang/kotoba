(ns kotoba.lang.json
  "Compatibility namespace for the foundational JSON API."
  {:kotoba/export #?(:kotoba [decode encode json] :default '[decode encode json])}
  (:require [json.core :as json]))

;; Dual-runtime: on the host each name is the `json.core` function itself (a
;; value); on Kotoba an export must name a function of this module, so each is a
;; forwarding function with the types `json.core`'s Kotoba reading has.
#?(:kotoba (defn encode [x :document] :string (json/encode x))
   :default (def encode json/encode))
#?(:kotoba (defn decode [s :string] [:result :document :document]
             ;; Forward the explicit result without discarding malformed input.
             (json/decode s))
   :default (def decode json/decode))
#?(:kotoba (defn json [x :document] :string (json/json x))
   :default (def json json/json))
