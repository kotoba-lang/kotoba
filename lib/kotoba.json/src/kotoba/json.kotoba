;; Native canonical facade. Host callers retain the existing .cljk API.
(ns kotoba.json
  (:export [encode decode json])
  (:require [json.core :as impl]))
(defn encode [value :document] :string (impl/encode value))
(defn decode [text :string] [:result :document :document] (impl/decode text))
(defn json [value :document] :string (impl/json value))
