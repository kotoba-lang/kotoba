;; JUN-757: complete JSON syntax, used0..1MiB in a real>=1MiB allocation.
;; Keeps the existing64KiB cursor unchanged. At most64 nested containers;
;; siblings have no node cap. The shared scalar codec reads a <=12-byte view
;; of the original allocation, including escapes crossing any64KiB boundary.
;; No allocation, AST, schema, side effect, identity or consent authority.
(ns kotoba.json.document-region
  (:require [kotoba.json.region :as j])
  (:export [valid-document]))
(defn- b [input capacity count at] :i64
  (if (and (>= at 0) (< at count)) (kernel-load-u8 (kernel-subregion input capacity at 1) 1 0) -1))
(defn- white [v] :bool (or (= v 32) (= v 9) (= v 10) (= v 13)))
(defn- space [input capacity count at] :i64
  (if (white (b input capacity count at)) (space input capacity count (+ at 1)) at))
(defn- scalar-step [window bytes] :i64 (j/next-character window bytes 0 bytes))
(defn- window-step [input capacity at bytes] :i64
  (scalar-step (kernel-subregion input capacity at bytes) bytes))
(defn- step [input capacity count at] :i64
  (let [bytes (if (< (- count at) 12) (- count at) 12)]
    (let [n (window-step input capacity at bytes)]
      (if (< n 0) -1 (+ at (quot n 2097152))))))
(defn- string-end [input capacity count at] :i64
  (let [v (b input capacity count at)]
    (if (or (>= at count) (< v 32)) -1
      (if (= v 34) (+ at 1)
        (if (and (< v 128) (not= v 92)) (string-end input capacity count (+ at 1))
          (let [n (step input capacity count at)] (if (< n 0) -1 (string-end input capacity count n))))))))
(defn- digit [v] :bool (and (>= v 48) (<= v 57)))
(defn- digits [input capacity count at] :i64
  (if (digit (b input capacity count at)) (digits input capacity count (+ at 1)) at))
(defn- exponent [input capacity count at] :i64
  (if (or (= (b input capacity count at) 101) (= (b input capacity count at) 69))
    (let [n (if (or (= (b input capacity count (+ at 1)) 43) (= (b input capacity count (+ at 1)) 45)) (+ at 2) (+ at 1))]
      (if (digit (b input capacity count n)) (digits input capacity count (+ n 1)) -1)) at))
(defn- fraction [input capacity count at] :i64
  (if (= (b input capacity count at) 46)
    (if (digit (b input capacity count (+ at 1))) (exponent input capacity count (digits input capacity count (+ at 2))) -1)
    (exponent input capacity count at)))
(defn- number [input capacity count at] :i64
  (let [n (if (= (b input capacity count at) 45) (+ at 1) at)]
    (if (= (b input capacity count n) 48) (fraction input capacity count (+ n 1))
      (if (and (>= (b input capacity count n) 49) (<= (b input capacity count n) 57))
        (fraction input capacity count (digits input capacity count (+ n 1))) -1))))
(defn- literal [input capacity count at kind i] :i64
  (if (>= i (if (= kind 2) 5 4)) (+ at i)
    (if (= (b input capacity count (+ at i))
      (if (= kind 1) (case i 0 116 1 114 2 117 101)
        (if (= kind 2) (case i 0 102 1 97 2 108 3 115 101) (case i 0 110 1 117 2 108 108))))
      (literal input capacity count at kind (+ i 1)) -1)))
(defn- array-next [input capacity count at depth] :i64
  (let [end (value input capacity count at depth)]
    (if (< end 0) -1
      (let [n (space input capacity count end)]
        (if (= (b input capacity count n) 93) (+ n 1)
          (if (= (b input capacity count n) 44) (array-next input capacity count (space input capacity count (+ n 1)) depth) -1))))))
(defn- object-next [input capacity count at depth] :i64
  (if (not= (b input capacity count at) 34) -1
    (let [end (string-end input capacity count (+ at 1))]
      (if (< end 0) -1
        (let [colon (space input capacity count end)]
          (if (not= (b input capacity count colon) 58) -1
            (let [finish (value input capacity count (space input capacity count (+ colon 1)) depth)]
              (if (< finish 0) -1
                (let [n (space input capacity count finish)]
                  (if (= (b input capacity count n) 125) (+ n 1)
                    (if (= (b input capacity count n) 44) (object-next input capacity count (space input capacity count (+ n 1)) depth) -1)))))))))))
(defn- value [input capacity count at depth] :i64
  (if (or (< at 0) (>= at count) (> depth 64)) -1
    (let [v (b input capacity count at)]
      (if (and (or (= v 123) (= v 91)) (>= depth 64)) -1
        (if (= v 123)
          (let [n (space input capacity count (+ at 1))]
            (if (= (b input capacity count n) 125) (+ n 1) (object-next input capacity count n (+ depth 1))))
          (if (= v 91)
            (let [n (space input capacity count (+ at 1))]
              (if (= (b input capacity count n) 93) (+ n 1) (array-next input capacity count n (+ depth 1))))
            (if (= v 34) (string-end input capacity count (+ at 1))
              (if (= v 116) (literal input capacity count at 1 0)
                (if (= v 102) (literal input capacity count at 2 0)
                  (if (= v 110) (literal input capacity count at 3 0) (number input capacity count at)))))))))))
(defn- valid-run [input capacity count] :bool
  (let [end (value input capacity count (space input capacity count 0) 0)]
    (and (>= end 0) (= (space input capacity count end) count))))
(defn valid-document [input capacity count] :bool
  (and (>= capacity 1048576) (>= count 0) (<= count 1048576)
       (valid-run (kernel-subregion input capacity 0 1048576) 1048576 count)))
