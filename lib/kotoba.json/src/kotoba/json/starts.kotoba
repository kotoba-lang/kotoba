;; Kotoba port of lib/kotoba.json/src/kotoba/json/starts.cljk.
;;
;; Named divergence: the .cljk uses (subs s i end), which throws for a start
;; outside the string. The kotoba port answers false for i < 0 or i > length,
;; since the checker has no exceptions. For in-range i the result is the same.
(ns kotoba.json.starts
  (:export [starts?]))

(defn starts? [s :string i :i64 lit :string] :bool
  (let [n (string-length s)
        m (string-length lit)]
    (if (or (< i 0) (> i n))
      false
      (string=? lit (string-substring s i (min n (+ i m)))))))
