;; Port of kotoba.json.kstr (kstr), Kotoba-native.
;;
;; kstr turns a key into a string: a keyword becomes its name (namespace
;; dropped), anything else becomes its string form.
;;
;; Named divergences from kstr (the source is (if (keyword? k) (name k) (str k))):
;;   - the key is a :document. A keyword gives its name; a string gives itself.
;;   - nil gives "" (clojure str of nil). Any other non-string value gives its
;;     canonical EDN text, which for numbers and booleans is the str text.

(ns kotoba.json.kstr
  (:export [kstr]))

(defn kstr [k :document] :string
  (if (option-some?-of [:option :keyword] (document-keyword-value k))
    (keyword-name (option-value-of [:option :keyword] (document-keyword-value k) :none))
    (if (string=? (document-edn-print k) (document-edn-print (document-null)))
      ""
      (option-or (document-string-value k) (document-edn-print k)))))
