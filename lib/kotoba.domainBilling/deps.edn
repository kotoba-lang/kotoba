{:paths ["src"]
 ;; kotoba-lang/srs supplies the events this library folds into a ledger. The
 ;; dependency points one way on purpose: billing reads srs, srs knows nothing
 ;; about money.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/srs {:local/root "../kotoba.srs"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :dev {:override-deps {io.github.kotoba-lang/srs {:local/root "../srs"}}}}}
