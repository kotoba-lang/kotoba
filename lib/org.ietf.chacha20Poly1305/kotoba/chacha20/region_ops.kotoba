;; Shared allocation-free512-byte ChaCha/Poly1305 region operations.
;; Internal OS ABI: every region is an already-admitted full512-byte state.
;; Algorithms are factored unchanged from chacha20.region; no IO or grants.
;; Products use aead-region; the compatibility region module also exposes raw
;; block/Poly APIs. Keep one arithmetic implementation for both surfaces.
(ns chacha20.region-ops (:export [ld put b p m32 m26 rot fill copy w wp qr rounds initial-word initial h-output working-key block-output block-internal r h hp d dp dot products carry poly-block poly-key poly-add poly-valid normalize plus-five choose-g final-word tag-words poly-done]))
(defn ld [st at] (kernel-load-u32 st 512 at))
(defn put [st at x] (kernel-store-u32 st 512 at x))
(defn b [st at] (kernel-load-u8 st 512 at))
(defn p [st at x] (kernel-store-u8 st 512 at x))
(defn m32 [x] (bit-and x 4294967295))
(defn m26 [x] (bit-and x 67108863))
(defn rot [x n] (m32 (bit-or (i64-shift-left x n) (u64-shift-right x (- 32 n)))))
(defn fill [st at end x]
  (if (>= at end) 1 (do (p st at x) (fill st (+ at 1) end x))))
(defn copy [st src dst n]
  (if (<= n 0) 1 (do (p st dst (b st src)) (copy st (+ src 1) (+ dst 1) (- n 1)))))
(defn w [st i] (ld st (+ 192 (* i 4))))
(defn wp [st i x] (put st (+ 192 (* i 4)) x))
(defn qr [st ids]
  (let [a (mod ids 16) b (mod (quot ids 16) 16)
        c (mod (quot ids 256) 16) d (quot ids 4096)]
    (do (wp st a (m32 (+ (w st a) (w st b))))
        (wp st d (rot (bit-xor (w st d) (w st a)) 16))
        (wp st c (m32 (+ (w st c) (w st d))))
        (wp st b (rot (bit-xor (w st b) (w st c)) 12))
        (wp st a (m32 (+ (w st a) (w st b))))
        (wp st d (rot (bit-xor (w st d) (w st a)) 8))
        (wp st c (m32 (+ (w st c) (w st d))))
        (wp st b (rot (bit-xor (w st b) (w st c)) 7)) 1)))
(defn rounds [st i]
  (if (>= i 10) 1
    (do (qr st 51264) (qr st 55633) (qr st 60002) (qr st 64371)
        (qr st 64080) (qr st 52065) (qr st 55410) (qr st 59715)
        (rounds st (+ i 1)))))
(defn initial-word [st key nonce counter mode+i]
  (let [mode (quot mode+i 32) i (mod mode+i 32)]
    (cond (< i 4) (case i 0 1634760805 1 857760878 2 2036477234 1797285236)
          (< i 12) (ld st (+ key (* (- i 4) 4)))
          (= mode 1) (ld st (+ nonce (* (- i 12) 4)))
          (= i 12) counter
          :else (ld st (+ nonce (* (- i 13) 4))))))
(defn initial [st key nonce counter mode+i]
  (if (>= (mod mode+i 32) 16) 1
    (do (put st (+ 128 (* (mod mode+i 32) 4)) (initial-word st key nonce counter mode+i))
        (wp st (mod mode+i 32) (ld st (+ 128 (* (mod mode+i 32) 4))))
        (initial st key nonce counter (+ mode+i 1)))))
(defn h-output [st i]
  (if (>= i 8) 1
    (do (put st (+ 64 (* i 4)) (w st (if (< i 4) i (+ i 8)))) (h-output st (+ i 1)))))
(defn working-key [st size]
  (if (= size 12) (do (copy st 0 64 32) (copy st 32 96 12))
    (do (initial st 0 32 0 32) (rounds st 0) (h-output st 0)
        (fill st 96 100 0) (copy st 48 100 8))))
(defn block-output [st i]
  (if (>= i 16) 1
    (do (put st (+ 256 (* i 4)) (m32 (+ (w st i) (ld st (+ 128 (* i 4))))))
        (block-output st (+ i 1)))))
(defn block-internal [st counter]
  (do (initial st 64 96 counter 0) (rounds st 0) (block-output st 0)))
(defn r [st i] (ld st (+ 320 (* i 4))))
(defn h [st i] (ld st (+ 352 (* i 4))))
(defn hp [st i x] (put st (+ 352 (* i 4)) x))
(defn d [st i] (+ (ld st (+ 128 (* i 8))) (* (ld st (+ 132 (* i 8))) 4294967296)))
(defn dp [st i x]
  (do (put st (+ 128 (* i 8)) (m32 x)) (put st (+ 132 (* i 8)) (u64-shift-right x 32))))
(defn dot [st which j acc]
  (if (>= j 5) acc
    (dot st which (+ j 1)
      (+ acc (* (h st j) (if (<= j which) (r st (- which j)) (* 5 (r st (+ which 5 (- 0 j))))))))))
(defn products [st i]
  (if (>= i 5) 1 (do (dp st i (dot st i 0 0)) (products st (+ i 1)))))
(defn carry [st i c]
  (if (>= i 5)
    (let [x (+ (h st 0) (* c 5))]
      (do (hp st 1 (+ (h st 1) (u64-shift-right x 26))) (hp st 0 (m26 x))))
    (do (hp st i (m26 (+ (d st i) c)))
        (carry st (+ i 1) (u64-shift-right (+ (d st i) c) 26)))))
(defn poly-block [st high]
  (do (hp st 0 (+ (h st 0) (m26 (ld st 400))))
      (hp st 1 (+ (h st 1) (m26 (bit-or (u64-shift-right (ld st 400) 26) (i64-shift-left (ld st 404) 6)))))
      (hp st 2 (+ (h st 2) (m26 (bit-or (u64-shift-right (ld st 404) 20) (i64-shift-left (ld st 408) 12)))))
      (hp st 3 (+ (h st 3) (m26 (bit-or (u64-shift-right (ld st 408) 14) (i64-shift-left (ld st 412) 18)))))
      (hp st 4 (+ (h st 4) (bit-or (u64-shift-right (ld st 412) 8) high)))
      (products st 0) (carry st 0 0) (fill st 400 416 0) (put st 416 0) 1))
(defn poly-key [st]
  (do (fill st 320 432 0)
      (put st 320 (m26 (ld st 256)))
      (put st 324 (bit-and (bit-or (u64-shift-right (ld st 256) 26) (i64-shift-left (ld st 260) 6)) 67108611))
      (put st 328 (bit-and (bit-or (u64-shift-right (ld st 260) 20) (i64-shift-left (ld st 264) 12)) 67092735))
      (put st 332 (bit-and (bit-or (u64-shift-right (ld st 264) 14) (i64-shift-left (ld st 268) 18)) 66076671))
      (put st 336 (bit-and (u64-shift-right (ld st 268) 8) 1048575))
      (copy st 272 384 16) (put st 464 1) 1))
(defn poly-add [st x]
  (do (p st (+ 400 (ld st 416)) x) (put st 416 (+ (ld st 416) 1))
      (if (= (ld st 416) 16) (poly-block st 16777216) 0) 1))
(defn poly-valid [st]
  (and (= (ld st 464) 1) (< (ld st 416) 16)))
(defn normalize [st i]
  (if (>= i 4)
    (do (hp st 0 (+ (h st 0) (* 5 (u64-shift-right (h st 4) 26))))
        (hp st 4 (m26 (h st 4)))
        (hp st 1 (+ (h st 1) (u64-shift-right (h st 0) 26))) (hp st 0 (m26 (h st 0))))
    (do (hp st (+ i 1) (+ (h st (+ i 1)) (u64-shift-right (h st i) 26)))
        (hp st i (m26 (h st i))) (normalize st (+ i 1)))))
(defn plus-five [st i c]
  (if (>= i 5) c
    (do (put st (+ 128 (* i 4)) (m26 (+ (h st i) c)))
        (plus-five st (+ i 1) (u64-shift-right (+ (h st i) c) 26)))))
(defn choose-g [st i]
  (if (>= i 5) 1
    (do (hp st i (ld st (+ 128 (* i 4)))) (choose-g st (+ i 1)))))
(defn final-word [st i]
  (case i 0 (m32 (bit-or (h st 0) (i64-shift-left (h st 1) 26)))
    1 (m32 (bit-or (u64-shift-right (h st 1) 6) (i64-shift-left (h st 2) 20)))
    2 (m32 (bit-or (u64-shift-right (h st 2) 12) (i64-shift-left (h st 3) 14)))
    (m32 (bit-or (u64-shift-right (h st 3) 18) (i64-shift-left (h st 4) 8)))))
(defn tag-words [st i c]
  (if (>= i 4) 1
    (do (put st (+ 432 (* i 4)) (m32 (+ (final-word st i) (ld st (+ 384 (* i 4))) c)))
        (tag-words st (+ i 1) (u64-shift-right (+ (final-word st i) (ld st (+ 384 (* i 4))) c) 32)))))
(defn poly-done [st]
  (do (if (> (ld st 416) 0) (do (p st (+ 400 (ld st 416)) 1) (poly-block st 0)) 0)
      (normalize st 1) (if (> (plus-five st 0 5) 0) (choose-g st 0) 0) (normalize st 1)
      (tag-words st 0 0) (put st 464 2) 1))
