;; chacha20.core -- RFC 8439 ChaCha20 (sections 2.1-2.4) in native .kotoba (AWAI-117).
;; Bytes are :vector-i64 of 0..255; a 32-bit word is an i64 in 0..2^32-1 and every
;; operation ends in a mask, so nothing depends on how a wider integer wraps.
;;   block key counter nonce -> the 64-byte block (key 32 bytes, nonce 12)
;;   xor-stream key counter nonce data -> data XOR the keystream from block counter
;;   hchacha20 key nonce16 -> the 32-byte XChaCha subkey (draft-irtf-cfrg-xchacha 2.2)
;; The caller checks lengths (chacha20.aead does). Not constant time: see the README.
(ns chacha20.core
  (:export [block xor-stream hchacha20]))

(defn- w32 [x :i64] :i64 (bit-and x 4294967295))
(defn- rotl [x :i64 n :i64] :i64 (w32 (bit-or (i64-shift-left x n) (i64-shift-right x (- 32 n)))))
(defn- le32 [b :vector-i64 o :i64] :i64
  (+ (vector-at b o) (* 256 (vector-at b (+ o 1))) (* 65536 (vector-at b (+ o 2))) (* 16777216 (vector-at b (+ o 3)))))

(defn- qr [s :vector-i64 a :i64 b :i64 c :i64 d :i64] :vector-i64
  ;; section 2.1, in place on the 16-word state
  (let [x1 (vector-assoc! s a (w32 (+ (vector-at s a) (vector-at s b))))
        x2 (vector-assoc! s d (rotl (bit-xor (vector-at s d) (vector-at s a)) 16))
        x3 (vector-assoc! s c (w32 (+ (vector-at s c) (vector-at s d))))
        x4 (vector-assoc! s b (rotl (bit-xor (vector-at s b) (vector-at s c)) 12))
        x5 (vector-assoc! s a (w32 (+ (vector-at s a) (vector-at s b))))
        x6 (vector-assoc! s d (rotl (bit-xor (vector-at s d) (vector-at s a)) 8))
        x7 (vector-assoc! s c (w32 (+ (vector-at s c) (vector-at s d))))]
    (vector-assoc! s b (rotl (bit-xor (vector-at s b) (vector-at s c)) 7))))

(defn- initial [key :vector-i64 counter :i64 nonce :vector-i64] :vector-i64
  ;; section 2.3: constants, key, counter, nonce
  (let [s (vector-alloc 16)
        a (vector-assoc! s 0 1634760805) b (vector-assoc! s 1 857760878)
        c (vector-assoc! s 2 2036477234) d (vector-assoc! s 3 1797285236)
        k (loop [i 0] (if (= i 8) 0 (let [x (vector-assoc! s (+ 4 i) (le32 key (* 4 i)))] (recur (+ i 1)))))
        e (vector-assoc! s 12 (w32 counter))]
    (loop [i 0] (if (= i 3) s (let [x (vector-assoc! s (+ 13 i) (le32 nonce (* 4 i)))] (recur (+ i 1)))))))

(defn block [key :vector-i64 counter :i64 nonce :vector-i64] :vector-i64
  (let [s (initial key counter nonce)
        w (loop [i 0 w (vector-alloc 16)] (if (= i 16) w (recur (+ i 1) (vector-assoc! w i (vector-at s i)))))
        r (loop [round 0]
            (if (= round 10) 0
              (let [a (qr w 0 4 8 12) b (qr w 1 5 9 13) c (qr w 2 6 10 14) d (qr w 3 7 11 15)
                    e (qr w 0 5 10 15) f (qr w 1 6 11 12) g (qr w 2 7 8 13) h (qr w 3 4 9 14)]
                (recur (+ round 1)))))]
    (loop [i 0 out (vector-alloc 64)]
      (if (= i 16) out
        (let [x (w32 (+ (vector-at w i) (vector-at s i)))
              a (vector-assoc! out (* 4 i) (bit-and x 255))
              b (vector-assoc! out (+ (* 4 i) 1) (bit-and (i64-shift-right x 8) 255))
              c (vector-assoc! out (+ (* 4 i) 2) (bit-and (i64-shift-right x 16) 255))]
          (recur (+ i 1) (vector-assoc! out (+ (* 4 i) 3) (bit-and (i64-shift-right x 24) 255))))))))

(defn xor-stream [key :vector-i64 counter :i64 nonce :vector-i64 data :vector-i64] :vector-i64
  ;; section 2.4
  (let [n (vector-count data) out (vector-alloc n)]
    (loop [j 0]
      (if (>= j n) out
        (let [ks (block key (+ counter (quot j 64)) nonce)
              x (loop [i 0]
                  (if (or (= i 64) (= (+ j i) n)) 0
                    (let [y (vector-assoc! out (+ j i) (bit-xor (vector-at data (+ j i)) (vector-at ks i)))] (recur (+ i 1)))))]
          (recur (+ j 64)))))))

(defn hchacha20 [key :vector-i64 nonce16 :vector-i64] :vector-i64
  ;; 20 rounds with the 16-byte nonce in words 12-15, then words 0-3 and 12-15 with
  ;; no final addition
  (let [s (initial key (le32 nonce16 0) (vector-i64 (vector-at nonce16 4) (vector-at nonce16 5) (vector-at nonce16 6) (vector-at nonce16 7)
                                                   (vector-at nonce16 8) (vector-at nonce16 9) (vector-at nonce16 10) (vector-at nonce16 11)
                                                   (vector-at nonce16 12) (vector-at nonce16 13) (vector-at nonce16 14) (vector-at nonce16 15)))
        r (loop [round 0]
            (if (= round 10) 0
              (let [a (qr s 0 4 8 12) b (qr s 1 5 9 13) c (qr s 2 6 10 14) d (qr s 3 7 11 15)
                    e (qr s 0 5 10 15) f (qr s 1 6 11 12) g (qr s 2 7 8 13) h (qr s 3 4 9 14)]
                (recur (+ round 1)))))
        words (vector-i64 0 1 2 3 12 13 14 15)]
    (loop [i 0 out (vector-alloc 32)]
      (if (= i 8) out
        (let [x (vector-at s (vector-at words i))
              a (vector-assoc! out (* 4 i) (bit-and x 255))
              b (vector-assoc! out (+ (* 4 i) 1) (bit-and (i64-shift-right x 8) 255))
              c (vector-assoc! out (+ (* 4 i) 2) (bit-and (i64-shift-right x 16) 255))]
          (recur (+ i 1) (vector-assoc! out (+ (* 4 i) 3) (bit-and (i64-shift-right x 24) 255))))))))
