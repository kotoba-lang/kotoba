(defn- g-tampered [] :bool
  (and (refused? (a/open (g-ak) (g-an) (g-aa) (g-flip (g-s282) 0)))
       (refused? (a/open (g-ak) (g-an) (g-aa) (g-flip (g-s282) 113)))
       (refused? (a/open (g-ak) (g-an) (g-aa) (g-flip (g-s282) 120)))
       (refused? (a/open (g-ak) (g-an) (g-flip (g-aa) 3) (g-s282)))
       (refused? (a/open (g-ak) (g-flip (g-an) 11) (g-aa) (g-s282)))))

(defn- g-refusals [] :bool
  (and (= (vector-count (a/seal (g-slice (g-ak) 0 31) (g-an) (g-aa) (g-sun))) 0)
       (= (vector-count (a/seal (g-ak) (g-slice (g-an) 0 11) (g-aa) (g-sun))) 0)
       (= (vector-count (a/seal (g-ak) (g-an) (g-aa) (g-set (g-sun) 4 256))) 0)
       (= (vector-count (a/seal (g-ak) (g-an) (g-set (g-aa) 0 -1) (g-sun))) 0)
       (refused? (a/open (g-slice (g-ak) 0 31) (g-an) (g-aa) (g-s282)))
       (refused? (a/open (g-ak) (g-an) (g-aa) (g-slice (g-s282) 0 15)))))

(defn main [] :i64
  (+ (if (same? (c/block (g-k0) 1 (g-n232)) (g-b232)) 1 0)
     (if (same? (c/xor-stream (g-k0) 1 (g-n242) (g-sun)) (g-e242)) 2 0)
     (if (and (same? (p/mac (g-pk) (g-pm)) (g-ptag)) (same? (p/mac (g-a3-0-k) (g-a3-0-m)) (g-a3-0-t)) (same? (p/mac (g-a3-1-k) (g-a3-1-m)) (g-a3-1-t)) (same? (p/mac (g-a3-2-k) (g-a3-2-m)) (g-a3-2-t)) (same? (p/mac (g-a3-3-k) (g-a3-3-m)) (g-a3-3-t)) (same? (p/mac (g-a3-4-k) (g-a3-4-m)) (g-a3-4-t))) 4 0)
     (if (and (same? (a/seal (g-ak) (g-an) (g-aa) (g-sun)) (g-s282))
              (same? (a/open (g-ak) (g-an) (g-aa) (g-s282)) (g-sun))) 8 0)
     (if (g-tampered) 16 0)
     (if (and (same? (p/mac (g-ak) (g-slice (g-pat) 0 0)) (g-mac-0)) (same? (p/mac (g-ak) (g-slice (g-pat) 0 1)) (g-mac-1)) (same? (p/mac (g-ak) (g-slice (g-pat) 0 15)) (g-mac-15)) (same? (p/mac (g-ak) (g-slice (g-pat) 0 16)) (g-mac-16)) (same? (p/mac (g-ak) (g-slice (g-pat) 0 17)) (g-mac-17)) (same? (p/mac (g-ak) (g-slice (g-pat) 0 63)) (g-mac-63)) (same? (p/mac (g-ak) (g-slice (g-pat) 0 64)) (g-mac-64)) (same? (p/mac (g-ak) (g-slice (g-pat) 0 65)) (g-mac-65)) (same? (p/mac (g-ak) (g-slice (g-pat) 0 129)) (g-mac-129)) (same? (a/seal (g-ak) (g-an) (g-aa) (g-slice (g-pat) 0 0)) (g-seal-0)) (same? (a/seal (g-ak) (g-an) (g-aa) (g-slice (g-pat) 0 1)) (g-seal-1)) (same? (a/seal (g-ak) (g-an) (g-aa) (g-slice (g-pat) 0 15)) (g-seal-15)) (same? (a/seal (g-ak) (g-an) (g-aa) (g-slice (g-pat) 0 16)) (g-seal-16)) (same? (a/seal (g-ak) (g-an) (g-aa) (g-slice (g-pat) 0 17)) (g-seal-17)) (same? (a/seal (g-ak) (g-an) (g-aa) (g-slice (g-pat) 0 63)) (g-seal-63)) (same? (a/seal (g-ak) (g-an) (g-aa) (g-slice (g-pat) 0 64)) (g-seal-64)) (same? (a/seal (g-ak) (g-an) (g-aa) (g-slice (g-pat) 0 65)) (g-seal-65)) (same? (a/seal (g-ak) (g-an) (g-aa) (g-slice (g-pat) 0 129)) (g-seal-129)) (same? (a/open (g-ak) (g-an) (g-aa) (g-seal-0)) (g-slice (g-pat) 0 0)) (same? (a/open (g-ak) (g-an) (g-aa) (g-seal-1)) (g-slice (g-pat) 0 1)) (same? (a/open (g-ak) (g-an) (g-aa) (g-seal-15)) (g-slice (g-pat) 0 15)) (same? (a/open (g-ak) (g-an) (g-aa) (g-seal-16)) (g-slice (g-pat) 0 16)) (same? (a/open (g-ak) (g-an) (g-aa) (g-seal-17)) (g-slice (g-pat) 0 17)) (same? (a/open (g-ak) (g-an) (g-aa) (g-seal-63)) (g-slice (g-pat) 0 63)) (same? (a/open (g-ak) (g-an) (g-aa) (g-seal-64)) (g-slice (g-pat) 0 64)) (same? (a/open (g-ak) (g-an) (g-aa) (g-seal-65)) (g-slice (g-pat) 0 65)) (same? (a/open (g-ak) (g-an) (g-aa) (g-seal-129)) (g-slice (g-pat) 0 129))
              (same? (a/seal (g-ak) (g-an) (vector-i64) (vector-i64)) (g-empty-sealed))
              (same? (a/open (g-ak) (g-an) (vector-i64) (g-empty-sealed)) (vector-i64))) 32 0)
     (if (g-refusals) 64 0)
     (if (and (same? (c/hchacha20 (g-k0) (g-hn)) (g-hk))
              (same? (a/xseal (g-ak) (g-xn) (g-aa) (g-sun)) (g-xs))
              (same? (a/xopen (g-ak) (g-xn) (g-aa) (g-xs)) (g-sun))
              (refused? (a/xopen (g-ak) (g-flip (g-xn) 20) (g-aa) (g-xs)))
              (= (vector-count (a/xseal (g-ak) (g-slice (g-xn) 0 23) (g-aa) (g-sun))) 0)) 128 0)))
