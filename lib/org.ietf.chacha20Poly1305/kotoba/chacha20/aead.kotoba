;; chacha20.aead -- RFC 8439 AEAD_CHACHA20_POLY1305 (section 2.8) in native .kotoba
;; (AWAI-117). Bytes are :vector-i64 of 0..255.
;;   seal key nonce aad plaintext -> ciphertext ++ tag (16); empty when the key is not
;;                                   32 bytes, the nonce not 12, or a value is not a byte
;;   open key nonce aad sealed    -> the plaintext; the one-element vector [-1] when the
;;                                   parameters are bad, sealed is shorter than a tag, or
;;                                   the tag does not verify. An empty plaintext is valid,
;;                                   so failure cannot be the empty vector.
;; The tag comparison ORs the XOR of every byte; nothing is decrypted before it passes.
;; Not constant time: see the README.
(ns chacha20.aead
  (:require [chacha20.core :as c] [chacha20.poly1305 :as p] [chacha20.aead-params :as params])
  (:export [seal open]))

(defn- bytes? [v :vector-i64] :bool
  (loop [i 0] (if (= i (vector-count v)) true (if (and (>= (vector-at v i) 0) (<= (vector-at v i) 255)) (recur (+ i 1)) false))))
(defn- ok-params? [key :vector-i64 nonce :vector-i64] :bool
  (and (= (params/check-params (vector-count key) (vector-count nonce)) (params/err-ok)) (bytes? key) (bytes? nonce)))
(defn- slice [v :vector-i64 start :i64 n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ start i)))))))
(defn- padded [v :vector-i64] :i64 (* 16 (quot (+ (vector-count v) 15) 16)))

(defn- mac-data [aad :vector-i64 ct :vector-i64] :vector-i64
  ;; aad || pad16 || ct || pad16 || le64(|aad|) || le64(|ct|)
  (let [pa (padded aad) pc (padded ct) out (vector-alloc (+ pa pc 16))
        a (loop [i 0] (if (= i (vector-count aad)) 0 (let [x (vector-assoc! out i (vector-at aad i))] (recur (+ i 1)))))
        b (loop [i 0] (if (= i (vector-count ct)) 0 (let [x (vector-assoc! out (+ pa i) (vector-at ct i))] (recur (+ i 1)))))
        z (loop [i (vector-count aad)] (if (>= i pa) 0 (let [x (vector-assoc! out i 0)] (recur (+ i 1)))))
        y (loop [i (+ pa (vector-count ct))] (if (>= i (+ pa pc)) 0 (let [x (vector-assoc! out i 0)] (recur (+ i 1)))))
        w (loop [i 0]
            (if (= i 8) 0
              (let [x (vector-assoc! out (+ pa pc i) (bit-and (i64-shift-right (vector-count aad) (* 8 i)) 255))]
                (recur (+ i 1)))))]
    (loop [i 0]
      (if (= i 8) out
        (let [x (vector-assoc! out (+ pa pc 8 i) (bit-and (i64-shift-right (vector-count ct) (* 8 i)) 255))]
          (recur (+ i 1)))))))

(defn- tag [key :vector-i64 nonce :vector-i64 aad :vector-i64 ct :vector-i64] :vector-i64
  (p/mac (slice (c/block key 0 nonce) 0 32) (mac-data aad ct)))

(defn seal [key :vector-i64 nonce :vector-i64 aad :vector-i64 plaintext :vector-i64] :vector-i64
  (if (or (not (ok-params? key nonce)) (not (bytes? aad)) (not (bytes? plaintext))) (vector-i64)
    (let [ct (c/xor-stream key 1 nonce plaintext) t (tag key nonce aad ct) n (vector-count ct)
          out (vector-alloc (+ n 16))
          a (loop [i 0] (if (= i n) 0 (let [x (vector-assoc! out i (vector-at ct i))] (recur (+ i 1)))))]
      (loop [i 0] (if (= i 16) out (let [x (vector-assoc! out (+ n i) (vector-at t i))] (recur (+ i 1))))))))

(defn open [key :vector-i64 nonce :vector-i64 aad :vector-i64 sealed :vector-i64] :vector-i64
  (if (or (not (ok-params? key nonce)) (not (bytes? aad)) (< (vector-count sealed) 16) (not (bytes? sealed))) (vector-i64 -1)
    (let [n (- (vector-count sealed) 16) ct (slice sealed 0 n) t (tag key nonce aad ct)
          differ (loop [i 0 x 0] (if (= i 16) x (recur (+ i 1) (bit-or x (bit-xor (vector-at t i) (vector-at sealed (+ n i)))))))]
      (if (= differ 0) (c/xor-stream key 1 nonce ct) (vector-i64 -1)))))
