;; RFC 8439 AEAD parameter checks as a Kotoba oracle (ADR-2608301100).
;;
;; The heavy cipher stays in portable .cljc; this file owns the scalar
;; decision that `chacha20.aead/check-params` already makes — key and nonce
;; lengths — so a guest can refuse bad inputs without ambient crypto.
;;
;; Reason codes match `chacha20.aead` error keywords as i64:
;;   0 ok  1 bad-key-length  2 bad-nonce-length
;;
;; Clojure-shaped twin: `aead_params.cljk`. Parity:
;; `test/chacha20/aead_params_kotoba_parity_test.cljk`.

(ns chacha20.aead-params
  (:export [key-bytes nonce-bytes err-ok err-bad-key err-bad-nonce check-params]))

(defn key-bytes [] :i64 32)
(defn nonce-bytes [] :i64 12)
(defn err-ok [] :i64 0)
(defn err-bad-key [] :i64 1)
(defn err-bad-nonce [] :i64 2)

(defn check-params [key-len :i64 nonce-len :i64] :i64
  (if (not (= key-len (key-bytes))) (err-bad-key)
      (if (not (= nonce-len (nonce-bytes))) (err-bad-nonce) (err-ok))))
