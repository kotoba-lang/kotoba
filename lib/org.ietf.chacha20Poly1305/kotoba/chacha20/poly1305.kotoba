;; chacha20.poly1305 -- RFC 8439 Poly1305 (section 2.5) in native .kotoba (AWAI-117).
;;   mac key msg -> the 16-byte tag (key is 32 bytes: r then s)
;; The accumulator is five 26-bit limbs (the "donna" layout), so a product of a limb and
;; a multiplier is below 2^56 and a sum of five below 2^59: an i64 never overflows.
;; Not constant time: see the README.
(ns chacha20.poly1305
  (:export [mac]))

(defn- le32 [b :vector-i64 o :i64] :i64
  (+ (vector-at b o) (* 256 (vector-at b (+ o 1))) (* 65536 (vector-at b (+ o 2))) (* 16777216 (vector-at b (+ o 3)))))
(defn- m26 [x :i64] :i64 (bit-and x 67108863))

(defn- word-at [msg :vector-i64 j :i64 w :i64] :i64
  ;; word w of the block at j, padded with 0x01 then zeros past the end (section 2.5.1)
  (loop [k 3 acc 0]
    (if (< k 0) acc
      (let [p (+ j (* 4 w) k) n (vector-count msg)
            b (cond (< p n) (vector-at msg p) (= p n) 1 :else 0)]
        (recur (- k 1) (+ (* acc 256) b))))))

(defn mac [key :vector-i64 msg :vector-i64] :vector-i64
  (let [t0 (le32 key 0) t1 (le32 key 4) t2 (le32 key 8) t3 (le32 key 12)
        ;; clamp r (section 2.5) while splitting it into limbs
        r0 (bit-and t0 67108863)
        r1 (bit-and (bit-or (i64-shift-right t0 26) (i64-shift-left t1 6)) 67108611)
        r2 (bit-and (bit-or (i64-shift-right t1 20) (i64-shift-left t2 12)) 67092735)
        r3 (bit-and (bit-or (i64-shift-right t2 14) (i64-shift-left t3 18)) 66076671)
        r4 (bit-and (i64-shift-right t3 8) 1048575)
        s1 (* r1 5) s2 (* r2 5) s3 (* r3 5) s4 (* r4 5)
        n (vector-count msg)
        h (vector-alloc 5)
        done (loop [j 0]
               (if (>= j n) 0
                 (let [full (<= (+ j 16) n)
                       ;; a full block gets its 2^128 bit here; a short one got 0x01 in word-at
                       m0 (word-at msg j 0) m1 (word-at msg j 1) m2 (word-at msg j 2) m3 (word-at msg j 3)
                       hi (if full 16777216 0)
                       h0 (+ (vector-at h 0) (m26 m0))
                       h1 (+ (vector-at h 1) (m26 (bit-or (i64-shift-right m0 26) (i64-shift-left m1 6))))
                       h2 (+ (vector-at h 2) (m26 (bit-or (i64-shift-right m1 20) (i64-shift-left m2 12))))
                       h3 (+ (vector-at h 3) (m26 (bit-or (i64-shift-right m2 14) (i64-shift-left m3 18))))
                       h4 (+ (vector-at h 4) (bit-or (i64-shift-right m3 8) hi))
                       d0 (+ (* h0 r0) (* h1 s4) (* h2 s3) (* h3 s2) (* h4 s1))
                       d1 (+ (* h0 r1) (* h1 r0) (* h2 s4) (* h3 s3) (* h4 s2))
                       d2 (+ (* h0 r2) (* h1 r1) (* h2 r0) (* h3 s4) (* h4 s3))
                       d3 (+ (* h0 r3) (* h1 r2) (* h2 r1) (* h3 r0) (* h4 s4))
                       d4 (+ (* h0 r4) (* h1 r3) (* h2 r2) (* h3 r1) (* h4 r0))
                       e1 (+ d1 (i64-shift-right d0 26)) e2 (+ d2 (i64-shift-right e1 26))
                       e3 (+ d3 (i64-shift-right e2 26)) e4 (+ d4 (i64-shift-right e3 26))
                       f0 (+ (m26 d0) (* 5 (i64-shift-right e4 26)))
                       a (vector-assoc! h 0 (m26 f0))
                       b (vector-assoc! h 1 (+ (m26 e1) (i64-shift-right f0 26)))
                       c (vector-assoc! h 2 (m26 e2))
                       d (vector-assoc! h 3 (m26 e3))
                       e (vector-assoc! h 4 (m26 e4))]
                   (recur (+ j 16)))))
        ;; full carry, then h - p if h >= p (p = 2^130 - 5)
        c1 (vector-at h 1) c2 (+ (vector-at h 2) (i64-shift-right c1 26)) c3 (+ (vector-at h 3) (i64-shift-right c2 26))
        c4 (+ (vector-at h 4) (i64-shift-right c3 26)) c0 (+ (vector-at h 0) (* 5 (i64-shift-right c4 26)))
        k0 (m26 c0) k1 (+ (m26 c1) (i64-shift-right c0 26)) k2 (m26 c2) k3 (m26 c3) k4 (m26 c4)
        g0 (+ k0 5) g1 (+ k1 (i64-shift-right g0 26)) g2 (+ k2 (i64-shift-right g1 26))
        g3 (+ k3 (i64-shift-right g2 26)) g4 (- (+ k4 (i64-shift-right g3 26)) 67108864)
        use-g (>= g4 0)
        q0 (if use-g (m26 g0) k0) q1 (if use-g (m26 g1) k1) q2 (if use-g (m26 g2) k2) q3 (if use-g (m26 g3) k3) q4 (if use-g g4 k4)
        ;; h mod 2^128 as four words, plus s
        w0 (bit-and (bit-or q0 (i64-shift-left q1 26)) 4294967295)
        w1 (bit-and (bit-or (i64-shift-right q1 6) (i64-shift-left q2 20)) 4294967295)
        w2 (bit-and (bit-or (i64-shift-right q2 12) (i64-shift-left q3 14)) 4294967295)
        w3 (bit-and (bit-or (i64-shift-right q3 18) (i64-shift-left q4 8)) 4294967295)
        f0 (+ w0 (le32 key 16)) f1 (+ w1 (le32 key 20) (i64-shift-right f0 32))
        f2 (+ w2 (le32 key 24) (i64-shift-right f1 32)) f3 (+ w3 (le32 key 28) (i64-shift-right f2 32))
        words (vector-i64 (bit-and f0 4294967295) (bit-and f1 4294967295) (bit-and f2 4294967295) (bit-and f3 4294967295))]
    (loop [i 0 out (vector-alloc 16)]
      (if (= i 16) out
        (recur (+ i 1) (vector-assoc! out i (bit-and (i64-shift-right (vector-at words (quot i 4)) (* 8 (rem i 4))) 255)))))))
