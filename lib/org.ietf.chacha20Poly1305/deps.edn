;; No dependencies. ChaCha20 is 32-bit words and Poly1305 is arithmetic modulo
;; 2^130-5; the limbs are thirteen of ten bits because neither the JVM
;; nor ClojureScript has a type for either.
 {:deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "dd943e084e8189f4b399b51fe88f1227baba5b1e"}
                      io.github.kotoba-lang/osaho
                      {:git/url "https://github.com/kotoba-lang/osaho.git"
                       :git/sha "fdf407a6645d7d35af8b6fd8ffb69d948bfe2aa8"}}}
  :cljs {:extra-paths ["test"]}

}}
