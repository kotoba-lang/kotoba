;; Public CPU-only region fixtures. No NIC, device identity or app operation.
(ns chacha20.region-gate
  (:require [chacha20.region :as c] [chacha20.aead-region :as a] [noise.blake2s-region :as hash])
  (:export [run]))
(defn p [i v] (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0 v))
(defn word [i] (kernel-load-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0))
(defn sb [i] (kernel-load-u8 (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 i))
(defn sp [i x] (kernel-store-u8 (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 i x))
(defn ob [i] (kernel-load-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536 i))
(defn op [i x] (kernel-store-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536 i x))
(defn ib [i] (kernel-load-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536 i))
(defn ip [i x] (kernel-store-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536 i x))
(defn check [ok :bool] :i64 (if ok 1 (do (p 75 (+ (word 75) 1)) 0)))
(defn pattern [i] (mod (+ (* i 17) 3) 256))
(defn keys [i variant]
  (if (>= i 56) 1
    (do (sp i (if (< i 32) (if (= variant 1) 255 (mod (+ (* i 3) 7) 256)) (mod (+ (* i 5) 11) 256)))
        (keys (+ i 1) variant))))
(defn plaintext [n i]
  (if (>= i n) 1 (do (ip i (pattern i)) (plaintext n (+ i 1)))))
(defn plain-same [n i]
  (if (>= i n) 1 (if (= (ib i) (pattern i)) (plain-same n (+ i 1)) 0)))
(defn sentinel [n i]
  (if (>= i n) 1 (do (ip i 165) (sentinel n (+ i 1)))))
(defn sentinel-same [n i]
  (if (>= i n) 1 (if (= (ib i) 165) (sentinel-same n (+ i 1)) 0)))
(defn aad [n i wrong]
  (if (>= i n) 1
    (do (check (= (c/aad-byte (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 (bit-xor (mod (+ (* i 11) 5) 256) (if (and (= wrong 1) (= i 0)) 1 0))) 1))
        (aad n (+ i 1) wrong))))
(defn digest-input [input capacity n i]
  (if (>= i n) 1
    (do (check (= (hash/update-byte (kernel-subregion (kernel-browser-context) 8192 2048 512) 512 (kernel-load-u8-64k input capacity i)) 1)) (digest-input input capacity n (+ i 1)))))
(defn digest-save [i]
  (if (>= i 32) 1
    (do (if (< (word 78) 10)
          (kernel-store-u8-16k (kernel-desktop-effects) 16384 (+ (* (word 78) 32) i) (hash/digest-byte (kernel-subregion (kernel-browser-context) 8192 2048 512) 512 i))
          (op (+ 4096 (* (word 78) 32) i) (hash/digest-byte (kernel-subregion (kernel-browser-context) 8192 2048 512) 512 i)))
        (digest-save (+ i 1)))))
(defn record [input capacity n]
  (do (hash/init (kernel-subregion (kernel-browser-context) 8192 2048 512) 512) (digest-input input capacity n 0) (hash/finish (kernel-subregion (kernel-browser-context) 8192 2048 512) 512)
      (digest-save 0) (p 78 (+ (word 78) 1))))
(defn setup [size n wrong]
  (do (keys 0 0) (if (= wrong 2) (sp 0 (bit-xor (sb 0) 1)) 0)
      (if (= wrong 3) (sp 32 (bit-xor (sb 32) 1)) 0)
      (check (= (c/init (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 size) 1)) (aad n 0 (if (= wrong 1) 1 0))))
(defn wrong-open [size aadn n wrong]
  (do (setup size aadn wrong) (sentinel n 0)
      (check (= (do (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 (+ n 16)) (c/open (kernel-subregion (kernel-browser-context) 8192 1024 512) (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536 (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536)) -1))
      (check (= (sentinel-same n 0) 1))))
(defn tag-refusals [size aadn n i]
  (if (>= i 16) 1
    (do (op (+ n i) (bit-xor (ob (+ n i)) 1))
        (wrong-open size aadn n 0) (op (+ n i) (bit-xor (ob (+ n i)) 1))
        (tag-refusals size aadn n (+ i 1)))))
(defn aead [size aadn n]
  (do (p 72 (+ 10000 (word 78))) (plaintext n 0) (setup size aadn 0)
      (check (= (do (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 n) (c/seal (kernel-subregion (kernel-browser-context) 8192 1024 512) (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536)) (+ n 16)))
      (record (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536 (+ n 16))
      (setup size aadn 0)
      (check (= (do (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 (+ n 16)) (c/open (kernel-subregion (kernel-browser-context) 8192 1024 512) (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536 (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536)) n))
      (check (= (plain-same n 0) 1))
      (if (= n 65) (tag-refusals size aadn n 0)
        (do (op (+ n 15) (bit-xor (ob (+ n 15)) 1)) (wrong-open size aadn n 0)
            (op (+ n 15) (bit-xor (ob (+ n 15)) 1))))
      (if (> n 0) (do (op 0 (bit-xor (ob 0) 1)) (wrong-open size aadn n 0) (op 0 (bit-xor (ob 0) 1))) 0)
      (if (> aadn 0) (wrong-open size aadn n 1) 0)
      (wrong-open size aadn n 2) (wrong-open size aadn n 3)))
(defn big-length [i] (case i 0 1024 1 4096 2 16383 3 65511 65519))
(defn big [size i]
  (if (>= i 5) 1 (do (aead size 8 (big-length i)) (big size (+ i 1)))))
(defn transfer-log [i]
  (if (>= i 320) 1
    (do (op (+ 4096 i) (kernel-load-u8-16k (kernel-desktop-effects) 16384 i)) (transfer-log (+ i 1)))))
(defn blocks [size i]
  (if (>= i 4) 1
    (do (keys 0 0) (check (= (c/block (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 (case i 0 0 1 1 2 2147483647 4294967295) size) 1))
        (record (kernel-subregion (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 256 64) 64 64) (blocks size (+ i 1)))))
(defn poly-feed [n i]
  (if (>= i n) 1
    (do (check (= (c/poly-byte (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 (pattern i)) 1)) (poly-feed n (+ i 1)))))
(defn polys [variant n]
  (if (>= n 258) 1
    (do (keys 0 variant) (check (= (c/poly-init (kernel-subregion (kernel-browser-context) 8192 1024 512) 512) 1))
        (poly-feed n 0) (check (= (c/poly-finish (kernel-subregion (kernel-browser-context) 8192 1024 512) 512) 1))
        (record (kernel-subregion (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 432 16) 16 16) (polys variant (+ n 1)))))
(defn rfckey [i]
  (bit-and (u64-shift-right (case (quot i 8) 0 3705711902572074629 1 -6339144941766032257
     2 -166054862247689471 3 2014596954792050506) (* (mod i 8) 8)) 255))
(defn rfcmsg [i]
  (case i 0 67 1 114 2 121 3 112 4 116 5 111 6 103 7 114 8 97 9 112 10 104 11 105 12 99 13 32
    14 70 15 111 16 114 17 117 18 109 19 32 20 82 21 101 22 115 23 101 24 97 25 114 26 99 27 104 28 32
    29 71 30 114 31 111 32 117 33 112 0))
(defn rfc-key-stage [i]
  (if (>= i 32) 1 (do (sp i (rfckey i)) (rfc-key-stage (+ i 1)))))
(defn rfc-feed [i]
  (if (>= i 34) 1 (do (c/poly-byte (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 (rfcmsg i)) (rfc-feed (+ i 1)))))
(defn known-poly [i]
  (if (>= i 16) 1
    (if (= (c/tag-byte (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 i)
      (case i 0 168 1 6 2 29 3 193 4 48 5 81 6 54 7 198 8 194 9 43 10 139 11 175 12 12 13 1 14 39 169))
      (known-poly (+ i 1)) 0)))
(defn rfc []
  (do (rfc-key-stage 0) (c/poly-init (kernel-subregion (kernel-browser-context) 8192 1024 512) 512) (rfc-feed 0) (c/poly-finish (kernel-subregion (kernel-browser-context) 8192 1024 512) 512)
      (p 74 (known-poly 0))
      (record (kernel-subregion (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 432 16) 16 16)))
(defn small [size n]
  (if (>= n 258) 1 (do (aead size (mod (* n 7) 65) n) (small size (+ n 1)))))
(defn snapshot [i]
  (if (>= i 512) 1
    (do (kernel-store-u8-16k (kernel-desktop-effects) 16384 (+ 12000 i) (sb i)) (snapshot (+ i 1)))))
(defn unchanged [i]
  (if (>= i 512) 1
    (if (= (kernel-load-u8-16k (kernel-desktop-effects) 16384 (+ 12000 i)) (sb i)) (unchanged (+ i 1)) 0)))
(defn guards []
  (do (keys 0 0) (c/init (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 12) (snapshot 0)
      (check (and (= (c/init (kernel-subregion (kernel-browser-context) 8192 1024 512) 511 12) 0) (= (c/init (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 13) 0)
        (= (c/aad-byte (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 -1) 0) (= (c/aad-byte (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 256) 0)
        (= (c/wipe (kernel-subregion (kernel-browser-context) 8192 1024 512) 511) 0) (= (unchanged 0) 1)))
      (check (and (= (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 -1) 0) (= (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 65536) 0) (= (unchanged 0) 1)))
      (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 65520) (snapshot 0)
      (check (and (= (c/seal (kernel-subregion (kernel-browser-context) 8192 1024 512) (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536) -1) (= (unchanged 0) 1)))
      (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 1) (snapshot 0)
      (check (and (= (c/seal (kernel-subregion (kernel-browser-context) 8192 1024 512) (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536 (kernel-subregion (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536 0 16) 16) -1) (= (unchanged 0) 1)))
      (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 15) (snapshot 0)
      (check (and (= (c/open (kernel-subregion (kernel-browser-context) 8192 1024 512) (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536) -1) (= (unchanged 0) 1)))
      (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 17) (snapshot 0)
      (check (and (= (c/open (kernel-subregion (kernel-browser-context) 8192 1024 512) (kernel-subregion (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536 0 16) 16 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536) -1)
        (= (c/seal (kernel-subregion (kernel-browser-context) 8192 1024 512) (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536 (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536) -1)
        (= (c/seal (kernel-subregion (kernel-browser-context) 8192 1024 512) (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536) -1) (= (unchanged 0) 1)))
      (c/block (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 1 12) (snapshot 0)
      (check (and (= (c/block (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 -1 12) 0) (= (c/block (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 4294967296 12) 0)
        (= (c/block-byte (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 -1) -1) (= (c/block-byte (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 64) -1) (= (unchanged 0) 1)))
      (c/poly-init (kernel-subregion (kernel-browser-context) 8192 1024 512) 512) (snapshot 0)
      (check (and (= (c/poly-byte (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 256) 0) (= (c/poly-finish (kernel-subregion (kernel-browser-context) 8192 1024 512) 511) 0)
        (= (c/tag-byte (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 0) -1) (= (unchanged 0) 1)))
      (c/poly-finish (kernel-subregion (kernel-browser-context) 8192 1024 512) 512) (snapshot 0)
      (check (and (= (c/poly-byte (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 1) 0) (= (c/poly-finish (kernel-subregion (kernel-browser-context) 8192 1024 512) 512) 0)
        (= (c/tag-byte (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 -1) -1) (= (c/tag-byte (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 16) -1) (= (unchanged 0) 1)))
      (p 76 1)))
(defn hash-api []
  (do (check (= (hash/hmac-key-init (kernel-subregion (kernel-browser-context) 8192 2048 512) 512) 1)) (check (= (hash/hmac-key-byte (kernel-subregion (kernel-browser-context) 8192 2048 512) 512 7) 1)) (check (= (hash/hmac-key-finish (kernel-subregion (kernel-browser-context) 8192 2048 512) 512) 1)) (check (= (hash/hmac-update-byte (kernel-subregion (kernel-browser-context) 8192 2048 512) 512 9) 1)) (check (= (hash/hmac-finish (kernel-subregion (kernel-browser-context) 8192 2048 512) 512) 1)) (check (= (hash/wipe (kernel-subregion (kernel-browser-context) 8192 2048 512) 512) 1))))
(defn shifted-plain [offset n i]
  (if (>= i n) 1 (do (ip (+ offset i) (pattern i)) (shifted-plain offset n (+ i 1)))))
(defn shifted-same [offset n i]
  (if (>= i n) 1 (if (= (ib (+ offset i)) (pattern i)) (shifted-same offset n (+ i 1)) 0)))
(defn output-same [offset n i]
  (if (>= i n) 1 (if (= (ob i) (ob (+ offset i))) (output-same offset n (+ i 1)) 0)))
(defn offset-tests [size]
  (do (plaintext 65 0) (setup size 17 0) (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 65)
      (check (= (c/seal (kernel-subregion (kernel-browser-context) 8192 1024 512)
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536) 81))
      (shifted-plain 33 65 0) (setup size 17 0) (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 65)
      (check (= (a/set-offsets (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 33 257) 1))
      (check (= (c/seal (kernel-subregion (kernel-browser-context) 8192 1024 512)
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536) 81))
      (check (= (output-same 257 81 0) 1))
      (setup size 17 0) (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 81)
      (a/set-offsets (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 257 1111)
      (check (= (c/open (kernel-subregion (kernel-browser-context) 8192 1024 512)
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536) 65))
      (check (= (shifted-same 1111 65 0) 1))
      (setup size 17 0) (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 81)
      (a/set-offsets (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 257 1111)
      (op 337 (bit-xor (ob 337) 1)) (sentinel 65536 0)
      (check (= (c/open (kernel-subregion (kernel-browser-context) 8192 1024 512)
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536) -1))
      (check (= (sentinel-same 65536 0) 1)) (op 337 (bit-xor (ob 337) 1))
      (setup size 0 0) (snapshot 0)
      (check (and (= (a/set-offsets (kernel-subregion (kernel-browser-context) 8192 1024 512) 511 0 0) 0)
                  (= (a/set-offsets (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 -1 0) 0)
                  (= (a/set-offsets (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 0 -1) 0)
                  (= (a/set-offsets (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 65537 0) 0)
                  (= (a/set-offsets (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 0 65537) 0)
                  (= (unchanged 0) 1)))
      (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 1)
      (a/set-offsets (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 65536 0) (snapshot 0)
      (check (and (= (c/seal (kernel-subregion (kernel-browser-context) 8192 1024 512)
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536) -1) (= (unchanged 0) 1)))
      (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 16)
      (a/set-offsets (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 65536 0) (snapshot 0)
      (check (and (= (c/open (kernel-subregion (kernel-browser-context) 8192 1024 512)
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536) -1) (= (unchanged 0) 1)))
      (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 17)
      (a/set-offsets (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 0 65536) (snapshot 0)
      (check (and (= (c/open (kernel-subregion (kernel-browser-context) 8192 1024 512)
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536) -1) (= (unchanged 0) 1)))
      (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 0)
      (a/set-offsets (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 0 65536) (snapshot 0)
      (check (and (= (c/seal (kernel-subregion (kernel-browser-context) 8192 1024 512)
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536) -1) (= (unchanged 0) 1)))
      (setup size 0 0) (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 0)
      (check (= (c/seal (kernel-subregion (kernel-browser-context) 8192 1024 512)
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536) 16))
      (setup size 0 0) (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 0)
      (a/set-offsets (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 65536 65520)
      (check (= (c/seal (kernel-subregion (kernel-browser-context) 8192 1024 512)
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536) 16))
      (check (= (output-same 65520 16 0) 1))
      (setup size 0 0) (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 16)
      (a/set-offsets (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 65520 65536)
      (check (= (c/open (kernel-subregion (kernel-browser-context) 8192 1024 512)
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536) 0))
      (setup size 0 0) (a/set-offsets (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 33 257)
      (c/set-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 0)
      (check (and (= (kernel-load-u32 (kernel-subregion (kernel-browser-context) 8192 1492 4) 4 0) 0)
                  (= (kernel-load-u32 (kernel-subregion (kernel-browser-context) 8192 1496 4) 4 0) 0)))
      (check (= (c/seal (kernel-subregion (kernel-browser-context) 8192 1024 512)
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536) 16))
      (check (= (output-same 65520 16 0) 1))
      (ip 65535 91) (op 65535 165)))
(defn park [] (do (kernel-pause) (park)))
(defn exercise [] :i64
  (do (hash-api)
      (p 100 (bit-and (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 4294967295)) (p 101 (quot (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 4294967296))
      (ip 65535 91) (op 65535 165)
      (big 12 0) (big 24 0) (transfer-log 0)
      (blocks 12 0) (blocks 24 0) (polys 0 0) (polys 1 0) (rfc) (small 12 0) (small 24 0)
      (guards) (offset-tests 12) (offset-tests 24)
      (p 77 (if (and (= (ib 65535) 91) (= (ob 65535) 165)) 1 0))
      (p 79 1) (park)))
(defn run [] :i64
  (do (kernel-cli) (p 74 0) (p 75 0) (p 76 0) (p 77 0) (p 78 0) (p 79 0) (p 72 1)
      ;; Never dereference a missing domain request region or erase init errors.
      (if (and (> (kernel-register-value-domain 73) 0)
               (= (kernel-publish-current-domain 73) 73)
               (= (kernel-value-enable-user) 1)
               (> (kernel-value-domain-request-page 73) 0))
        (exercise)
        (do (p 75 1) (p 72 2) (p 79 1) (park)))))
