(ns monban.postage
  "Refundable postage on community credit.

  A caller unknown to the callee can put community credit at stake instead of
  (or as well as) computing a stamp. The credit is not paid to anyone: it is
  **held** while the call is decided, then either **released** (the callee
  says the call was welcome, or simply never complains before it expires) or
  **forfeited** (the callee reports it — the held units are burned).

  Credit is `moyai-ledger` credit: non-monetary, non-transferable, decaying,
  minted for relaying, running home nodes and keeping propagation stores up.
  Because it cannot be bought or moved between identities, a spammer cannot
  buy a war chest, and a sybil farm cannot pool one; each fresh identity
  starts with nothing to put at stake.

  State is `{:ledger moyai-log :holds {hold-id {…}}}`."
  (:require [moyai.ledger :as ledger]))

(defn book [] {:ledger [] :holds {}})

(defn held-by [bk holder]
  (transduce (comp (map val)
                   (filter #(and (= holder (:holder %)) (= :held (:status %))))
                   (map :units))
             + 0 (:holds bk)))

(defn available [bk holder epoch]
  (- (ledger/balance (:ledger bk) holder epoch) (held-by bk holder)))

(defn earn
  "Credit for verified contribution (relayed traffic, uptime)."
  [bk holder units epoch ref]
  (update bk :ledger ledger/mint holder units epoch ref))

(defn hold
  "Put `units` of `holder`'s credit at stake for call `hold-id` to `payee`.
  Answers `[book :held]` or `[book :insufficient]`."
  [bk hold-id holder payee units epoch expires-epoch]
  (cond
    (contains? (:holds bk) hold-id) [bk :duplicate]
    (> units (available bk holder epoch)) [bk :insufficient]
    :else [(assoc-in bk [:holds hold-id] {:holder holder :payee payee :units units
                                          :status :held :expires expires-epoch})
           :held]))

(defn release
  "The call was welcome: the stake returns to the caller untouched."
  [bk hold-id]
  (if (= :held (get-in bk [:holds hold-id :status]))
    (assoc-in bk [:holds hold-id :status] :released)
    bk))

(defn forfeit
  "The callee reported the call: the stake is burned. Only the payee named in
  the hold can do this."
  [bk hold-id by epoch]
  (let [h (get-in bk [:holds hold-id])]
    (if (and h (= :held (:status h)) (= by (:payee h)))
      ;; Decay may have shrunk the balance below the stake since the hold;
      ;; burn what is left (whole units), never more.
      (let [units (min (:units h) (int (ledger/balance (:ledger bk) (:holder h) epoch)))]
        (cond-> (assoc-in bk [:holds hold-id :status] :forfeited)
          (pos? units) (update :ledger ledger/burn (:holder h) units epoch
                               (str "postage-forfeit:" hold-id))))
      bk)))

(defn expire
  "Holds past their expiry are released — silence is consent."
  [bk epoch]
  (update bk :holds
          (fn [hs] (into {} (map (fn [[k h]]
                                   [k (if (and (= :held (:status h)) (<= (:expires h) epoch))
                                        (assoc h :status :released)
                                        h)]))
                         hs))))
