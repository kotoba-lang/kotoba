(ns monban.stamp
  "Proof-of-work stamps: a cost a stranger pays to make a phone ring.

      stamp  = 8-byte nonce
      valid  ⇔ SHA-256(\"monban/1\" ++ target ++ nonce) has ≥ cost leading zero bits

  `target` binds the stamp to one specific call attempt (the ring's call id,
  callee and expiry), so a stamp cannot be computed once and replayed
  against many people. Each extra bit doubles the expected work; the callee
  chooses the cost, typically 12–20 bits for an unknown caller — a fraction
  of a second to a few seconds on a phone, prohibitive across thousands of
  calls.

  A GPU spammer is much faster than a phone, which is why a stamp is only
  one of the doors in `monban.policy`, alongside postage and introductions."
  (:require [tsunagi.crypto :as c]
            [tsunagi.wire :as w]))

(def ^:private domain (w/utf8 "monban/1"))

(defn leading-zero-bits [bs]
  (loop [[b & more] bs n 0]
    (cond
      (nil? b) n
      (zero? b) (recur more (+ n 8))
      :else (+ n (loop [b b z 0] (if (>= b 128) z (recur (* b 2) (inc z))))))))

(defn work [target nonce]
  (leading-zero-bits (c/sha256 (w/cat-bytes domain target nonce))))

(defn valid? [target stamp cost]
  (and (= 8 (count stamp))
       (>= (work target stamp) cost)))

(defn mint
  "Search for a stamp of at least `cost` bits. `start` lets callers split the
  search; `limit` bounds it (answers nil when exhausted)."
  ([target cost] (mint target cost 0 (* 64 (bit-shift-left 1 (min cost 24)))))
  ([target cost start limit]
   (let [target (vec target)]
     (loop [i start]
       (when (< i (+ start limit))
         (let [nonce (w/cat-bytes [0 0] (w/u48 i))]
           (if (>= (work target nonce) cost)
             nonce
             (recur (inc i)))))))))

(defn value
  "The work a stamp represents, in bits (0 for none or invalid)."
  [target stamp]
  (if (= 8 (count stamp)) (work target stamp) 0))
