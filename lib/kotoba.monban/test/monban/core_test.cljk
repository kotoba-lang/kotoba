(ns monban.core-test
  (:require [kotoba.test :refer [deftest is testing]]
            [monban.stamp :as stamp]
            [monban.postage :as postage]
            [monban.policy :as policy]
            [nafuda.core :as n]
            [nafuda.registry :as reg]
            [tsunagi.identity :as id]))

(defn- seed [k] (vec (map #(bit-and (+ k (* 13 %)) 0xff) (range 32))))
(def callee (id/from-seed (seed 1)))
(def friend (id/from-seed (seed 2)))
(def stranger (id/from-seed (seed 3)))
(def neighbour (id/from-seed (seed 4)))
(def village (id/from-seed (seed 5)))
(def watchdog (id/from-seed (seed 6)))
(def hx n/hex-of)

(deftest stamp-test
  (let [target [1 2 3 4]
        s (stamp/mint target 10)]
    (is (stamp/valid? target s 10))
    (is (>= (stamp/value target s) 10))
    (testing "a stamp is bound to its target"
      (is (not (stamp/valid? [1 2 3 5] s 10))))
    (is (= 9 (stamp/leading-zero-bits [0 0x40])))))

(deftest postage-test
  (let [bk (postage/earn (postage/book) "caller" 5 0 "relay")
        [bk r1] (postage/hold bk "call-1" "caller" "callee" 3 0 10)
        [bk r2] (postage/hold bk "call-2" "caller" "callee" 3 0 10)]
    (is (= [:held :insufficient] [r1 r2]))
    (is (= 2.0 (postage/available bk "caller" 0)))
    (testing "only the payee can forfeit"
      (is (= :held (get-in (postage/forfeit bk "call-1" "someone" 1) [:holds "call-1" :status]))))
    (testing "forfeit burns the stake"
      (let [bk (postage/forfeit bk "call-1" "callee" 1)]
        (is (= :forfeited (get-in bk [:holds "call-1" :status])))
        (is (< (postage/available bk "caller" 1) 2.1))))
    (testing "release and expiry return it"
      (is (< 4.9 (postage/available (postage/release bk "call-1") "caller" 0)))
      (is (< 4.9 (postage/available (postage/expire bk 10) "caller" 0))))))

(deftest policy-test
  (let [cfg {:callee (hx callee)
             :contacts #{(hx friend)}
             :vouches [(policy/vouch friend (hx neighbour) 0)]
             :communities #{(hx village)}
             :subscriptions #{(hx watchdog)}
             :stamp-cost 8
             :limits {:known {:rate 0 :burst 2} :community {:rate 0 :burst 1} :unknown {:rate 0 :burst 1}}}
        decide (fn [st attempt] (policy/decide cfg st (merge {:now 100} attempt)))]
    (testing "a contact rings"
      (is (= :ring (:verdict (decide {} {:caller (hx friend)})))))
    (testing "a contact's vouch lets a neighbour ring"
      (is (= [:vouched-by (hx friend)] (:reason (decide {} {:caller (hx neighbour)})))))
    (testing "an unknown caller goes to voicemail unless they pay"
      (is (= :voicemail (:verdict (decide {} {:caller (hx stranger)}))))
      (let [target [9 9 9]]
        (is (= :screen (:verdict (decide {} {:caller (hx stranger) :stamp-target target
                                              :stamp (stamp/mint target 8)}))))
        (is (= :voicemail (:verdict (decide {} {:caller (hx stranger) :stamp-target target
                                                 :stamp [0 0 0 0 0 0 0 0]}))))))
    (testing "an introduction from a contact admits a stranger"
      (is (= :ring (:verdict (decide {} {:caller (hx stranger)
                                         :introductions [(policy/introduction friend (hx stranger) (hx callee) 200)]})))))
    (testing "community membership admits, within its own smaller quota"
      (let [[_ claim] (reg/claim (reg/registry village "yamanaka" {}) stranger "sato" 0)
            r1 (decide {} {:caller (hx stranger) :memberships [claim]})
            r2 (decide (:state r1) {:caller (hx stranger) :memberships [claim]})]
        (is (= :ring (:verdict r1)))
        (is (= [:voicemail :rate-limited] [(:verdict r2) (:reason r2)]))))
    (testing "a subscribed blocklist rejects even a contact"
      (is (= :reject (:verdict (decide {} {:caller (hx friend)
                                           :blocklists [(policy/blocklist watchdog [(hx friend)] 1)]})))))
    (testing "an unsubscribed blocklist is ignored"
      (is (= :ring (:verdict (decide {} {:caller (hx friend)
                                         :blocklists [(policy/blocklist village [(hx friend)] 1)]})))))))
