(ns kotoba.crypto.default-digest-fn
  "default-digest-fn -- addressed on its own.

  Split out of kotoba.lang.crypto on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.crypto.jvm-digest :refer [jvm-digest]])
)

(def default-digest-fn
  "Default digest fn (JVM MessageDigest). On WASM, inject a host fn."
  (fn [algo data]
    (jvm-digest (case algo :sha256 "SHA-256" :sha512 "SHA-512" "SHA-256") data)))
