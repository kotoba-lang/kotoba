(ns browseruse.history
  ;; Parity slice of src/browseruse/history.cljk (ADR-2608261100):
  ;; portable pure classification. The original defrecords
  ;; (ActionResult / AgentHistory) are represented as documents with the
  ;; same keys; `actions` is a document-vector where the original used a
  ;; vector. `export` in the original converts a record to a plain map with
  ;; `into {}` -- here history values are already documents, so export is
  ;; the identity. `replay` is NOT migrated: it takes an injected
  ;; `(fn [action-result])`, and Kotoba has no first-class function values
  ;; (the same no-callback rule todo-app documents); callers keep replay on
  ;; the host side for now.
  (:export [empty-history append export]))

(defn dget [d :document k :keyword] :document
  (option-value-of [:option :document] (document-get d k) (document-null)))

(defn empty-history [session-id :document settings :document] :document
  (document-map :session-id session-id
                :settings settings
                :actions (document-vector)
                :metadata (document-map)))

(defn append [history :document result :document] :document
  (document-assoc history :actions
                  (document-vector-conj (dget history :actions) result)))

(defn export [history :document] :document
  history)
