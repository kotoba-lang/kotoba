(ns run-tests
  "The host-independent mokuroku kernel suite on SCI, run from this dir:
   kbb --backend sci run-tests.cljk (paths come from nbb.edn).

  Covers catalog and query. bounded-parity-test is NOT included: it needs
  kotoba.compiler (amu-side lazy-require packaging namespaces, JUN-380 F1),
  the same wall as kotobaUi's parity tests."
  (:require [cljs.test :as t]
            [mokuroku.catalog-test]
            [mokuroku.query-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println (str "\nnbb: " (:test m) " tests, " (:pass m) " passed, "
                (:fail m) " failed, " (:error m) " errors"))
  (when-not (t/successful? m)
    (set! (.-exitCode js/process) 1)))

(t/run-tests 'mokuroku.catalog-test
             'mokuroku.query-test)
