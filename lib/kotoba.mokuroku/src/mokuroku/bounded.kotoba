(ns mokuroku.bounded
  (:export [new-item new-catalog put-item drop-item item-count
            select deselect selected? selection-count reconcile]))

;; The capability-free Kotoba profile of the catalog kernel.
;;
;; The open-schema `.cljc` model stays authoritative for text search, mixed-type
;; comparison, grouping and command proposals. What is narrowed here is chosen,
;; not accidental: this profile proves the one property the whole suite leans
;; on, which is that a selection is a set of *ids* and therefore survives the
;; source changing underneath it.
;;
;; `rank` stands in for whatever attribute the app sorts by. It is an :i64
;; because the bounded profile has no string ordering; the `.cljc` model does
;; the real comparison.

(def item-type
  [:record :mokuroku/item
   [[:id :keyword] [:kind :keyword] [:rank :i64]]])
(def items-type [:map :keyword [:alias item-type]])
(def selection-type [:set :keyword])
(def catalog-type
  [:record :mokuroku/catalog
   [[:id :keyword]
    [:items [:alias items-type]]
    [:selected [:alias selection-type]]]])
(def item-option-type [:option [:alias item-type]])
(def entry-type [:vector [:keyword [:alias item-type]]])
(def entry-option-type [:option [:alias entry-type]])

(defn new-item [id :keyword kind :keyword rank :i64] [:alias item-type]
  (record item-type id kind rank))

(defn new-catalog [id :keyword] [:alias catalog-type]
  (record catalog-type id
    (typed-map-new items-type)
    (typed-set-new selection-type)))

(defn put-item
  [cat [:alias catalog-type] item [:alias item-type]] [:alias catalog-type]
  (record-assoc catalog-type cat :items
    (typed-map-assoc items-type
      (record-get catalog-type cat :items)
      (record-get item-type item :id)
      item)))

(defn drop-item [cat [:alias catalog-type] id :keyword] [:alias catalog-type]
  (record-assoc catalog-type cat :items
    (typed-map-dissoc items-type (record-get catalog-type cat :items) id)))

(defn item-count [cat [:alias catalog-type]] :i64
  (typed-map-count items-type (record-get catalog-type cat :items)))

(defn select [cat [:alias catalog-type] id :keyword] [:alias catalog-type]
  (record-assoc catalog-type cat :selected
    (typed-set-conj selection-type (record-get catalog-type cat :selected) id)))

(defn deselect [cat [:alias catalog-type] id :keyword] [:alias catalog-type]
  (record-assoc catalog-type cat :selected
    (typed-set-disj selection-type (record-get catalog-type cat :selected) id)))

(defn selected? [cat [:alias catalog-type] id :keyword] :bool
  (typed-set-contains selection-type (record-get catalog-type cat :selected) id))

(defn selection-count [cat [:alias catalog-type]] :i64
  (typed-set-count selection-type (record-get catalog-type cat :selected)))

;; Rebuild the selection as the intersection with what the source now yields.
;;
;; Walking the items rather than the selection is what makes this the
;; intersection by construction: an id that is no longer an item is never
;; visited, so it cannot be carried forward. `typed-map-entry-at` walks in key
;; order, so the result is the same on every runtime.
(defn keep-present
  [items [:alias items-type]
   old [:alias selection-type]
   acc [:alias selection-type]
   index :i64
   count :i64] [:alias selection-type]
  (if (= index count) acc
    (match-option (typed-map-entry-at items-type items index) entry-option-type
      (none acc)
      (some entry
        (let [key (hetero-vector-at entry-type entry 0)]
          (if (typed-set-contains selection-type old key)
            (keep-present items old
              (typed-set-conj selection-type acc key)
              (+ index 1) count)
            (keep-present items old acc (+ index 1) count)))))))

(defn reconcile [cat [:alias catalog-type]] [:alias catalog-type]
  (let [items (record-get catalog-type cat :items)]
    (record-assoc catalog-type cat :selected
      (keep-present items
        (record-get catalog-type cat :selected)
        (typed-set-new selection-type)
        0
        (typed-map-count items-type items)))))
