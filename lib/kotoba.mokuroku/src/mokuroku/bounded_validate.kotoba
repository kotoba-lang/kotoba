(ns mokuroku.bounded-validate
  (:export [selection-sound? bounded? valid?]))

;; Types are re-declared rather than imported: a reader of this namespace alone
;; must be able to see the shape it is judging.

(def item-type
  [:record :mokuroku/item
   [[:id :keyword] [:kind :keyword] [:rank :i64]]])
(def items-type [:map :keyword [:alias item-type]])
(def selection-type [:set :keyword])
(def catalog-type
  [:record :mokuroku/catalog
   [[:id :keyword]
    [:items [:alias items-type]]
    [:selected [:alias selection-type]]]])
(def item-option-type [:option [:alias item-type]])
(def entry-type [:vector [:keyword [:alias item-type]]])
(def entry-option-type [:option [:alias entry-type]])

(def max-items 8)

;; Every selected id is an item the catalog currently holds.
;;
;; This is the invariant `reconcile` establishes and the reason selection is
;; stored by id. If it can be violated, a command proposal can name a target
;; that no longer exists -- which for a destructive command means acting on
;; whatever took that id's place.
;;
;; Counted rather than walked over the set: an id present in the selection but
;; absent from the items is exactly the case where the counts disagree, because
;; the walk below only counts ids that are in both.
(defn present-selected-count
  [items [:alias items-type]
   selected [:alias selection-type]
   index :i64
   count :i64
   acc :i64] :i64
  (if (= index count) acc
    (match-option (typed-map-entry-at items-type items index) entry-option-type
      (none acc)
      (some entry
        (let [key (hetero-vector-at entry-type entry 0)]
          (if (typed-set-contains selection-type selected key)
            (present-selected-count items selected (+ index 1) count (+ acc 1))
            (present-selected-count items selected (+ index 1) count acc)))))))

;; `=` is i64-valued in this subset, not bool -- it is only directly usable as
;; an `if` condition. Returning it from a :bool function is a type error, so
;; comparisons are folded through `if` here and everywhere below.
(defn selection-sound? [cat [:alias catalog-type]] :bool
  (let [items (record-get catalog-type cat :items)
        selected (record-get catalog-type cat :selected)]
    (if (= (typed-set-count selection-type selected)
           (present-selected-count items selected 0
             (typed-map-count items-type items) 0))
      true
      false)))

;; Every entry is filed under its own id. A map whose key disagrees with the
;; item's :id makes `typed-map-get` and the item itself tell two different
;; stories about which row this is.
(defn keys-agree?
  [items [:alias items-type] index :i64 count :i64] :bool
  (if (= index count) true
    (match-option (typed-map-entry-at items-type items index) entry-option-type
      (none false)
      (some entry
        (let [key (hetero-vector-at entry-type entry 0)
              item (hetero-vector-at entry-type entry 1)]
          (if (= key (record-get item-type item :id))
            (keys-agree? items (+ index 1) count)
            false))))))

(defn bounded? [cat [:alias catalog-type]] :bool
  (if (< max-items (typed-map-count items-type (record-get catalog-type cat :items)))
    false
    true))

(defn valid? [cat [:alias catalog-type]] :bool
  (let [items (record-get catalog-type cat :items)]
    (if (bounded? cat)
      (if (keys-agree? items 0 (typed-map-count items-type items))
        (selection-sound? cat)
        false)
      false)))
