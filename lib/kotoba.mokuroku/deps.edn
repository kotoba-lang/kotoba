{:paths ["src" "resources"]
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; The compiler is TEST-ONLY, for `bounded-parity-test`: it compiles
         ;; `src/mokuroku/bounded.kotoba` and runs it against `selection.cljc`
         ;; over the same inputs. Nothing in `src/` requires it, so it cannot
         ;; change what the library does -- the same split the :kotoba alias
         ;; already had, which only ever ran the CLI from CI.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       ;; Same pin the :kotoba alias uses, so the gate measures
                       ;; the compiler this repo actually ships against.
                       :git/sha "bef32b78852212bc096849d1ff9779c8afae4796"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :kotoba {:extra-deps {io.github.kotoba-lang/amu
                        {:git/url "https://github.com/kotoba-lang/amu.git"
                         :git/sha "bef32b78852212bc096849d1ff9779c8afae4796"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
