(ns mokuroku.bounded-conformance
  (:require [mokuroku.bounded :as catalog]
            [mokuroku.bounded-validate :as validate])
  (:export [main]))

;; Returns 42 when every case holds; otherwise the number of the case that
;; failed, so a failing run names which property broke.
(defn main [] :i64
  (let [base (catalog/new-catalog :files)
        with-items (catalog/put-item
                     (catalog/put-item
                       (catalog/put-item base (catalog/new-item :alpha :file 20))
                       (catalog/new-item :beta :file 20))
                     (catalog/new-item :gamma :directory 5))

        ;; Two of the three selected.
        chosen (catalog/select (catalog/select with-items :alpha) :gamma)

        ;; The source changed: :gamma is gone, :delta appeared. This is the
        ;; refresh the whole design exists to survive.
        refreshed (catalog/put-item
                    (catalog/drop-item chosen :gamma)
                    (catalog/new-item :delta :file 1))
        reconciled (catalog/reconcile refreshed)

        ;; Selecting an id that was never an item: sound only after reconcile.
        phantom (catalog/select with-items :never-existed)

        overflow (catalog/put-item
                   (catalog/put-item
                     (catalog/put-item
                       (catalog/put-item
                         (catalog/put-item
                           (catalog/put-item with-items (catalog/new-item :f4 :file 1))
                           (catalog/new-item :f5 :file 1))
                         (catalog/new-item :f6 :file 1))
                       (catalog/new-item :f7 :file 1))
                     (catalog/new-item :f8 :file 1))
                   (catalog/new-item :f9 :file 1))]

    (if (validate/valid? with-items)
      (if (= 3 (catalog/item-count with-items))
        (if (= 2 (catalog/selection-count chosen))
          (if (validate/valid? chosen)
            ;; Before reconcile the stale id is still held, so the invariant
            ;; must report unsound -- if it reported sound here it would be
            ;; measuring nothing.
            (if (validate/selection-sound? refreshed) 5
              (if (validate/selection-sound? reconciled)
                (if (= 1 (catalog/selection-count reconciled))
                  (if (catalog/selected? reconciled :alpha)
                    (if (catalog/selected? reconciled :gamma) 9
                      (if (validate/selection-sound? phantom) 10
                        (if (validate/selection-sound? (catalog/reconcile phantom))
                          (if (validate/bounded? overflow) 12
                            42)
                          11)))
                    8)
                  7)
                6))
            4)
          3)
        2)
      1)))
