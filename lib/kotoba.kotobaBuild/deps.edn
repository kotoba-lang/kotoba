;; kotoba-build has NO Clojure runtime: the tool is a `.kotoba` module and its
;; host is nbb. This file exists so the repo answers `kbb -M` the way the
;; rest of the workspace does, and so a consumer that wants the build plan on
;; the JVM has a coordinate to name.
{:paths ["kotoba"]
 :deps {
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}}
