(ns counter-app
  ;; The app this repo's acceptance actually builds and loads in a browser.
  ;;
  ;; It is written against shitsuke's Kotoba re-frame pair -- `reframe-core`
  ;; for db/event/subscription/effect and `reagent-core` for the view -- so it
  ;; also answers the question those libraries exist to answer: can an app in
  ;; another repository require them and get all four verbs? The build resolves
  ;; them with a second `--source-path`, which is how a multi-repo Kotoba build
  ;; links (measured: `--source-path` may be repeated).
  ;;
  ;; Two contracts, one module:
  ;;
  ;;   init / view / step        amu's runtime/dom-driver.mjs (strings in)
  ;;   init-text / handle-text / step-text / query-text / view-text
  ;;                             an HTTP host (shitsuke's reframe-worker.mjs)
  ;;
  ;; `step` is the driver's contract and `handle` is re-frame's; `step` is the
  ;; adapter between them. The host reports WHICH NAME was acted on -- a
  ;; guest-chosen `data-k` string, never a node handle -- and this module turns
  ;; that name into an event. Nothing DOM-shaped crosses.
  (:require [reagent-core :as rg]
            [reframe-core :as rf])
  (:export [main init view step handle query
            init-text handle-text step-text query-text view-text
            test-init test-step test-view test-unknown-target test-text]))

;; --- db -------------------------------------------------------------------

(defn init [] :document
  (rf/db-assoc-i (rf/db-assoc-str (rf/db-empty) :label "clicks") :count 0))

;; --- events ---------------------------------------------------------------

(defn handle [db :document ev :document] :document
  (let [id (rf/event-id ev)
        n (rf/db-i db :count)]
    (cond
      (= id :counter/inc) (rf/fx-of (rf/db-assoc-i db :count (+ n 1)))
      (= id :counter/dec) (rf/fx-of (rf/db-assoc-i db :count (- n 1)))
      (= id :counter/label) (rf/fx-of (rf/db-assoc-str db :label (rf/event-arg-str ev 0)))
      (= id :counter/reset) (rf/fx-dispatch (rf/fx-of (rf/db-assoc-i db :count 0))
                                            (rf/event0 :ui/focus))
      :else (rf/fx-of db))))

;; --- subscriptions --------------------------------------------------------

(defn query [db :document q :document] :document
  (let [id (rf/query-id q)]
    (cond
      (= id :counter/count) (document-i64 (rf/db-i db :count))
      (= id :counter/label) (document-string (rf/db-str db :label))
      (= id :counter/positive?) (document-bool (> (rf/db-i db :count) 0))
      :else (document-null))))

;; --- the driver's contract ------------------------------------------------

(defn event-for [target :string kind :string value :string] :document
  (cond
    (and (string=? kind "input") (string=? target "label"))
    (rf/event-str :counter/label value)
    (string=? kind "click")
    (cond
      (string=? target "inc") (rf/event0 :counter/inc)
      (string=? target "dec") (rf/event0 :counter/dec)
      (string=? target "reset") (rf/event0 :counter/reset)
      :else (rf/event0 :ui/ignored))
    :else (rf/event0 :ui/ignored)))

(defn step [db :document target :string kind :string value :string] :document
  (rf/fx-db (handle db (event-for target kind value))))

;; --- view -----------------------------------------------------------------

(defn digits [] :string
  "0123456789")

;; Kotoba has no integer-to-string builtin, so the reading is drawn from a
;; literal and the display saturates at 9. The same bound amu's todo example
;; documents; it is a missing builtin, not a workaround to keep.
(defn count-label [n :i64] :string
  (cond
    (< n 0) "-"
    (< n 10) (string-substring (digits) n (+ n 1))
    :else "9+"))

(defn view [db :document] :document
  (rg/el "main"
         (rg/class-attr "counter")
         (rg/children3
          (rg/leaf "h1" (rg/attrs-none) (rf/db-str db :label))
          (rg/leaf "output"
                   (rg/keyed (rg/class-attr "count") "count")
                   (count-label (rf/db-i db :count)))
          (rg/el "div"
                 (rg/class-attr "row")
                 (rg/children3
                  (rg/leaf "button" (rg/keyed (rg/class-attr "dec") "dec") "-")
                  (rg/leaf "button" (rg/keyed (rg/class-attr "inc") "inc") "+")
                  (rg/leaf "button" (rg/keyed (rg/class-attr "reset") "reset") "reset"))))))

;; --- the text boundary ----------------------------------------------------

(defn init-text [] :string
  (rf/edn-print (init)))

(defn handle-text [db-text :string ev-text :string] :string
  (rf/edn-print (handle (rf/edn-read db-text) (rf/edn-read ev-text))))

(defn step-text [db-text :string ev-text :string] :string
  (rf/edn-print (rf/fx-db (handle (rf/edn-read db-text) (rf/edn-read ev-text)))))

(defn query-text [db-text :string q-text :string] :string
  (rf/edn-print (query (rf/edn-read db-text) (rf/edn-read q-text))))

(defn view-text [db-text :string] :string
  (rf/edn-print (view (rf/edn-read db-text))))

;; --- tests ----------------------------------------------------------------

(defn test-init [] :bool
  (and (= 0 (rf/db-i (init) :count))
       (string=? "clicks" (rf/db-str (init) :label))))

(defn test-step [] :bool
  (let [up (step (init) "inc" "click" "")
        down (step up "dec" "click" "")
        named (step (init) "label" "input" "taps")]
    (and (= 1 (rf/db-i up :count))
         (= 0 (rf/db-i down :count))
         (string=? "taps" (rf/db-str named :label))
         ;; the driver sends every click it sees; a name this app does not own
         ;; leaves the db alone rather than trapping
         (= 1 (rf/db-i (step up "nothing" "click" "") :count)))))

(defn test-unknown-target [] :bool
  (let [db (step (init) "inc" "click" "")]
    (and (document-equal? db (step db "inc" "keydown" ""))
         (document-equal? db (step db "" "click" "")))))

(defn test-view [] :bool
  (let [v (view (init))
        two (view (step (step (init) "inc" "click" "") "inc" "click" ""))]
    (and (string=? "main" (rg/tag-of v))
         (= 3 (rg/child-count v))
         (string=? "0" (rg/text-of (option-value-of [:option :document]
                                                    (document-vector-at (rg/children-of v) 1)
                                                    (document-null))))
         (string=? "2" (rg/text-of (option-value-of [:option :document]
                                                    (document-vector-at (rg/children-of two) 1)
                                                    (document-null))))
         ;; the boundary of the digit literal: 9 reads, 10 saturates
         (string=? "9" (count-label 9))
         (string=? "9+" (count-label 10)))))

(defn test-text [] :bool
  (let [db0 (init-text)
        db1 (step-text db0 "[:counter/inc]")
        n (rf/edn-read (query-text db1 "[:counter/count]"))]
    (and (= 1 (option-value-of [:option :i64] (document-i64-value n) -1))
         (string=? "main" (rg/tag-of (rf/edn-read (view-text db1)))))))

(defn main []
  (rf/db-i (step (init) "inc" "click" "") :count))
