;; The build this repo's acceptance runs. Paths are relative to THIS file.
{:app "counter"
 :entry "counter_app.kotoba"
 ;; Two source paths: the app, and shitsuke's Kotoba re-frame pair. A Kotoba
 ;; build links a module graph across repositories this way -- `--source-path`
 ;; may be repeated (measured 2026-09-09).
 :source-paths ["." "../../com-junkawasaki/orgs/kotoba-lang/shitsuke/kotoba"]
 :target "js"
 :out "dist"
 :mode :release
 :mount "app"
 :title "Counter"
 ;; amu's runtime/, for the dom-driver the shell imports.
 :amu-runtime "../../com-junkawasaki/orgs/kotoba-lang/amu/runtime"}
