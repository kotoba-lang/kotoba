(ns ecc.oracle-test
  "The three curves against `java.security`, over a sweep.

  Wycheproof supplies both parties' keys, so it never multiplies the base
  point: `gx` and `gy` could both be wrong and all 1,806 of its cases would
  still pass. This is what covers that, by deriving public keys from scalars
  and asking the JVM to agree — and then by agreeing on the shared secret in
  both directions, which is the property ECDH actually has."
  (:require [kotoba.test :refer [deftest is testing]]
            [ecc.bignum :as b]
            [ecc.curve :as curve]
            [ecc.ecdh :as ecdh])
  (:import [java.security AlgorithmParameters KeyFactory]
           [java.security.spec ECGenParameterSpec ECParameterSpec ECPoint
            ECPrivateKeySpec ECPublicKeySpec]
           [javax.crypto KeyAgreement]
           [java.math BigInteger]))

(def ^:private std {:p256 "secp256r1" :p384 "secp384r1" :p521 "secp521r1"})

(defn- spec ^ECParameterSpec [k]
  (let [ap (AlgorithmParameters/getInstance "EC")]
    (.init ap (ECGenParameterSpec. ^String (get std k)))
    (.getParameterSpec ap ECParameterSpec)))

(defn- jvm-agree
  "The JVM's shared secret from our scalar and our serialised point."
  [k d-str point-bytes]
  (let [s (spec k)
        c (get curve/curves k)
        n (:byte-len c)
        bs (vec point-bytes)
        x (BigInteger. ^String (b/to-hex (b/of-bytes (subvec bs 1 (inc n))) n) 16)
        y (BigInteger. ^String (b/to-hex (b/of-bytes (subvec bs (inc n))) n) 16)
        kf (KeyFactory/getInstance "EC")
        priv (.generatePrivate kf (ECPrivateKeySpec. (BigInteger. ^String d-str) s))
        pub (.generatePublic kf (ECPublicKeySpec. (ECPoint. x y) s))
        ka (KeyAgreement/getInstance "ECDH")]
    (.init ka priv)
    (.doPhase ka pub true)
    (mapv #(bit-and (int %) 0xff) (.generateSecret ka))))

(defn- scalars [c n]
  (map #(b/add (b/of-int (+ 1 (* 7919 %))) (b/of-int %)) (range n)))

(deftest agrees-with-java-security-over-a-sweep
  (doseq [[k c] curve/curves]
    (testing (name k)
      (doseq [[da db] (partition 2 (scalars c 24))]
        (let [pa (:bytes (ecdh/public-key c da))
              pb (:bytes (ecdh/public-key c db))
              ours (:bytes (ecdh/ecdh c da pb))
              theirs (jvm-agree k (b/to-dec da) pb)]
          ;; pb came from OUR base-point multiplication. The JVM parses it,
          ;; validates it, and agrees on a secret -- which it could not do if
          ;; gx or gy were wrong.
          (is (= theirs ours) (str "shared secret, " (name k)))
          (is (= (:bytes (ecdh/ecdh c db pa)) ours)
              (str "and both directions agree, " (name k))))))))

(deftest the-oracle-can-fail
  (testing "a differential test that cannot report a difference proves nothing"
    (let [c (:p256 curve/curves)
          d1 (b/of-int 11) d2 (b/of-int 13)
          p (:bytes (ecdh/public-key c (b/of-int 17)))]
      (is (not= (jvm-agree :p256 "11" p) (jvm-agree :p256 "13" p))))))
