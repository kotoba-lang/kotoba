(ns extract-wycheproof-ecdh
  "Turn Project Wycheproof's three `ecdh_secp*_ecpoint_test.json` files into
  `test/ecc/wycheproof_ecdh.cljk`.

  The `_ecpoint_` variant is the one to use: its public keys are raw
  uncompressed points in hex, which is what RFC 9180 §7.1.1 serialises. The
  plain `ecdh_secp*_test.json` files wrap the same keys in ASN.1, and parsing
  DER to run a curve test would put a parser between the corpus and the thing
  under test.

  All three corpora are emitted whole -- no sampling. A truncated adversarial
  corpus is the subset that happened to pass, so the declared count is checked
  here and asserted again at run time.

      for c in secp256r1 secp384r1 secp521r1; do
        curl -sSo ecdh_${c}_ecpoint_test.json \\
          https://raw.githubusercontent.com/C2SP/wycheproof/master/testvectors_v1/ecdh_${c}_ecpoint_test.json
      done
      kbb --backend sci scripts/extract_wycheproof_ecdh.cljk ecdh_secp256r1_ecpoint_test.json \\
          ecdh_secp384r1_ecpoint_test.json ecdh_secp521r1_ecpoint_test.json"
  (:require ["fs" :as fs]
            ["crypto" :as crypto]
            [kotoba.lang.text :as str]))

(def sources
  {"secp256r1" {:curve :p256
                :sha256 "648f16d077caf2400d02331ca51f44744c72c799830c8d0595d0b18b6dd9f886"}
   "secp384r1" {:curve :p384
                :sha256 "ffa7835fe1de359dff762c8f1272b98acebd5578e2f855d969051ff956c6dca3"}
   "secp521r1" {:curve :p521
                :sha256 "87aba8739c96de2bde8c75b60ffea09d0493192c4d9543d1d969e5e998931f35"}})

(defn- sha256-hex [s]
  (-> (crypto/createHash "sha256") (.update s "utf8") (.digest "hex")))

(defn- load-one [path]
  (let [text (str (fs/readFileSync path "utf8"))
        j (js->clj (js/JSON.parse text) :keywordize-keys true)
        std (get-in j [:testGroups 0 :curve])
        spec (get sources std)]
    (when-not spec
      (println "REFUSING: unknown curve" std "in" path)
      (js/process.exit 2))
    (when (not= (:sha256 spec) (sha256-hex text))
      (println "REFUSING:" path "sha256 mismatch")
      (println "  expected" (:sha256 spec))
      (println "  got     " (sha256-hex text))
      (js/process.exit 2))
    (let [cases (vec (for [g (:testGroups j) t (:tests g)]
                       {:id (:tcId t) :private (:private t) :public (:public t)
                        :shared (:shared t) :result (keyword (:result t))
                        :flags (set (map keyword (:flags t)))}))]
      (when (not= (:numberOfTests j) (count cases))
        (println "REFUSING:" path "declares" (:numberOfTests j) "extracted" (count cases))
        (js/process.exit 2))
      (println std (:curve spec) "cases" (count cases)
               "valid" (count (filter #(= :valid (:result %)) cases))
               "invalid" (count (filter #(= :invalid (:result %)) cases))
               "acceptable" (count (filter #(= :acceptable (:result %)) cases)))
      [(:curve spec) {:standard std :declared (:numberOfTests j) :cases cases}])))

(defn -main [& args]
  (when (not= 3 (count args))
    (println "usage: kbb --backend sci scripts/extract_wycheproof_ecdh.cljk <p256.json> <p384.json> <p521.json>")
    (js/process.exit 2))
  (let [by-curve (into {} (map load-one args))
        total (reduce + (map #(count (:cases %)) (vals by-curve)))
        out (str ";; GENERATED by scripts/extract_wycheproof_ecdh.cljk — do not edit.\n"
                 ";;\n"
                 ";; Project Wycheproof ECDH, raw-point encoding, complete:\n"
                 ";; " total " cases across P-256, P-384 and P-521. No sampling.\n"
                 ";;\n"
                 ";; Source:  https://raw.githubusercontent.com/C2SP/wycheproof/master/testvectors_v1/\n"
                 (str/join (map (fn [[k v]] (str ";;   " (name k) "  " (:standard v) "  "
                                                 (:sha256 (get sources (:standard v))) "\n"))
                                (sort-by key by-curve)))
                 "(ns ecc.wycheproof-ecdh)\n\n"
                 "(def total-declared " total ")\n\n"
                 "(def by-curve\n  {"
                 (str/join "\n\n   "
                           (map (fn [[k v]]
                                  (str (pr-str k) "\n   {:standard " (pr-str (:standard v))
                                       "\n    :declared " (:declared v)
                                       "\n    :cases\n    ["
                                       (str/join "\n     " (map pr-str (:cases v)))
                                       "]}"))
                                (sort-by key by-curve)))
                 "})\n")]
    (fs/mkdirSync "test/ecc" #js {:recursive true})
    (fs/writeFileSync "test/ecc/wycheproof_ecdh.cljk" out)
    (println "wrote test/ecc/wycheproof_ecdh.cljk" (count out) "bytes")))

(apply -main *command-line-args*)
