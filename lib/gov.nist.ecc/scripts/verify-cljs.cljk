#!/usr/bin/env kbb
;; Run the suite on the ClojureScript side.
;;
;; This is not a formality here, it is the point. `ecc.bignum` exists because
;; ClojureScript's BigInt does not answer cljs.core's numeric predicates --
;; and `zero?` answers them **wrongly and silently**. The JVM run cannot see
;; that class of bug at all: on the JVM every one of those predicates is
;; correct, so a version of this library that called them directly would be
;; green there and quietly broken here.
;;
;;   kbb --backend sci --classpath "$(kbb -A:cljs -Spath)" scripts/verify-cljs.cljk
(ns verify-cljs
  (:require [kotoba.test :as t]
            [ecc.bignum-test]
            [ecc.ecdh-test]
            [ecc.ecdsa-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println)
  (if (t/successful? m)
    (println "all checks passed on the ClojureScript path")
    (do (println "FAILED on the ClojureScript path")
        (js/process.exit 1))))

(t/run-tests 'ecc.bignum-test 'ecc.ecdh-test 'ecc.ecdsa-test)
