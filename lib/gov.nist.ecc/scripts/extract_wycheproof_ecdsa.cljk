(ns extract-wycheproof-ecdsa
  "Turn Project Wycheproof's ECDSA verification corpora into
  `test/ecc/wycheproof_ecdsa.cljk`.

  Three files — P-256/SHA-256, P-384/SHA-384, P-521/SHA-512 — the three MLS
  names. Each is emitted whole, pinned by sha256.

  These are **verification** vectors, and that is the useful direction: ECDSA
  signing is randomised, so a signature cannot be reproduced byte-for-byte,
  but a signature someone else produced can be checked. 930 of the 1,530
  cases are invalid, and most of those are malformed DER rather than bad
  arithmetic — which is where the interesting failures are.

      for c in secp256r1_sha256 secp384r1_sha384 secp521r1_sha512; do
        curl -sSo wp-ecdsa_${c}_test.json \\
          https://raw.githubusercontent.com/C2SP/wycheproof/master/testvectors_v1/ecdsa_${c}_test.json
      done
      kbb --backend sci scripts/extract_wycheproof_ecdsa.cljk wp-ecdsa_*_test.json"
  (:require ["fs" :as fs] ["crypto" :as crypto] [kotoba.lang.text :as str]))

(def sources
  {"secp256r1" {:curve :p256 :hash :sha256
                :sha256 "182db4f3e230f6f9fa9f800d2a614dede30284b8e8438bbfe1171905402e9332"}
   "secp384r1" {:curve :p384 :hash :sha384
                :sha256 "8a5b3ae1760975143414811f13588c24d951d9d8c904195087ba327591dfe9cc"}
   "secp521r1" {:curve :p521 :hash :sha512
                :sha256 "0fa3bb09a2319242253028b53d555fb8ec2081d891271321205cdaeabb3eef3e"}})

(defn- sha256-hex [s] (-> (crypto/createHash "sha256") (.update s "utf8") (.digest "hex")))

(defn- load-one [path]
  (let [text (str (fs/readFileSync path "utf8"))
        j (js->clj (js/JSON.parse text) :keywordize-keys true)
        std (get-in j [:testGroups 0 :publicKey :curve])
        spec (get sources std)]
    (when-not spec
      (println "REFUSING: unknown curve" std "in" path) (js/process.exit 2))
    (when (not= (:sha256 spec) (sha256-hex text))
      (println "REFUSING:" path "sha256 mismatch")
      (println "  expected" (:sha256 spec))
      (println "  got     " (sha256-hex text))
      (js/process.exit 2))
    (let [groups (vec (for [g (:testGroups j)]
                        {:public-key (get-in g [:publicKey :uncompressed])
                         :tests (vec (for [t (:tests g)]
                                       {:id (:tcId t) :msg (:msg t) :sig (:sig t)
                                        :result (keyword (:result t))
                                        :flags (set (map keyword (:flags t)))}))}))
          n (reduce + (map #(count (:tests %)) groups))]
      (when (not= (:numberOfTests j) n)
        (println "REFUSING:" path "declares" (:numberOfTests j) "extracted" n)
        (js/process.exit 2))
      (println std (:curve spec) (:hash spec) "groups" (count groups) "tests" n
               "valid" (count (filter #(= :valid (:result %)) (mapcat :tests groups))))
      [(:curve spec) {:standard std :hash (:hash spec) :declared (:numberOfTests j)
                      :groups groups}])))

(defn -main [& args]
  (when (not= 3 (count args))
    (println "usage: kbb --backend sci scripts/extract_wycheproof_ecdsa.cljk <p256> <p384> <p521>")
    (js/process.exit 2))
  (let [by-curve (into {} (map load-one args))
        total (reduce + (map (fn [v] (reduce + (map #(count (:tests %)) (:groups v))))
                             (vals by-curve)))
        out (str ";; GENERATED by scripts/extract_wycheproof_ecdsa.cljk — do not edit.\n;;\n"
                 ";; Project Wycheproof ECDSA verification, complete: " total " cases\n"
                 ";; across P-256/SHA-256, P-384/SHA-384 and P-521/SHA-512.\n;;\n"
                 ";; Source:  https://raw.githubusercontent.com/C2SP/wycheproof/master/testvectors_v1/\n"
                 (str/join (map (fn [[k v]] (str ";;   " (name k) "  " (:standard v) "  "
                                                 (:sha256 (get sources (:standard v))) "\n"))
                                (sort-by key by-curve)))
                 "(ns ecc.wycheproof-ecdsa)\n\n"
                 "(def total-declared " total ")\n\n"
                 "(def by-curve\n  {"
                 (str/join "\n\n   "
                           (map (fn [[k v]]
                                  (str (pr-str k) "\n   {:standard " (pr-str (:standard v))
                                       "\n    :hash " (pr-str (:hash v))
                                       "\n    :declared " (:declared v)
                                       "\n    :groups\n    ["
                                       (str/join "\n     " (map pr-str (:groups v)))
                                       "]}"))
                                (sort-by key by-curve)))
                 "})\n")]
    (fs/mkdirSync "test/ecc" #js {:recursive true})
    (fs/writeFileSync "test/ecc/wycheproof_ecdsa.cljk" out)
    (println "wrote test/ecc/wycheproof_ecdsa.cljk" (count out) "bytes")))

(apply -main *command-line-args*)
