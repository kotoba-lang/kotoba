;; Read the NIST prime-curve parameters out of the JVM's own tables, so that
;; the constants in src/ecc/curve.cljk are transcribed by a program rather
;; than by a person.
;;
;; The JVM is a convenient source, not an authority: the values it prints are
;; checked independently in ecc.ecdh-test against G being on the curve, n*G
;; being the point at infinity, a = p-3, and the field length matching p --
;; and behaviourally against 1,806 Wycheproof cases and RFC 9180's own
;; DeriveKeyPair vectors.
;;
;;   kbb -M scripts/extract_curve_params.cljk
(import '[java.security AlgorithmParameters]
        '[java.security.spec ECGenParameterSpec ECParameterSpec ECFieldFp])
(defn params [std]
  (let [ap (AlgorithmParameters/getInstance "EC")
        _ (.init ap (ECGenParameterSpec. std))
        s ^ECParameterSpec (.getParameterSpec ap ECParameterSpec)
        c (.getCurve s)
        g (.getGenerator s)]
    {:p (str (.getP ^ECFieldFp (.getField c)))
     :a (str (.getA c)) :b (str (.getB c))
     :gx (str (.getAffineX g)) :gy (str (.getAffineY g))
     :n (str (.getOrder s)) :h (.getCofactor s)}))
(doseq [[k std] [[:p256 "secp256r1"] [:p384 "secp384r1"] [:p521 "secp521r1"]]]
  (println k (pr-str (params std))))
