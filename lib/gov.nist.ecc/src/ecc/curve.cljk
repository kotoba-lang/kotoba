(def curves {:p256 p256 :p384 p384 :p521 p521})

;; ── field helpers ────────────────────────────────────────────────────────────

(defn- f+ [c x y] (b/mod (b/add x y) (:p c)))
(defn- f- [c x y] (b/mod (b/sub x y) (:p c)))
(defn- f* [c x y] (b/mod (b/mul x y) (:p c)))
(defn- fsq [c x] (f* c x x))
(defn- fk [c k x] (f* c (b/of-int k) x))

;; ── Jacobian points ──────────────────────────────────────────────────────────
;;
;; `[X Y Z]` with `x = X/Z^2` and `y = Y/Z^3`. Z = 0 is the point at
;; infinity. Affine coordinates would need one modular inversion per group
;; operation and a scalar multiplication does hundreds of them; here there is
;; exactly one, at the end.

(def infinity [b/zero b/one b/zero])

(defn infinity? [[_ _ z]] (b/zero? z))

(defn double-point
  "Doubling, in the form specialised for `a = -3` (dbl-2001-b).

  Public because `add-points` has a branch that `scalar-mult` never reaches,
  and a branch no test can reach is a branch no test is checking. See
  `ecc.curve-test/the-addition-branches-are-all-reachable`."
  [c [x y z]]
  (if (b/zero? z)
    infinity
    (let [delta (fsq c z)
          gamma (fsq c y)
          beta (f* c x gamma)
          alpha (fk c 3 (f* c (f- c x delta) (f+ c x delta)))
          x3 (f- c (fsq c alpha) (fk c 8 beta))
          z3 (f- c (f- c (fsq c (f+ c y z)) gamma) delta)
          y3 (f- c (f* c alpha (f- c (fk c 4 beta) x3))
                 (fk c 8 (fsq c gamma)))]
      [x3 y3 z3])))

(defn add-points
  [c [x1 y1 z1 :as pp] [x2 y2 z2 :as q]]
  (cond
    (b/zero? z1) q
    (b/zero? z2) pp
    :else
    (let [z1z1 (fsq c z1) z2z2 (fsq c z2)
          u1 (f* c x1 z2z2) u2 (f* c x2 z1z1)
          s1 (f* c y1 (f* c z2 z2z2))
          s2 (f* c y2 (f* c z1 z1z1))
          h (f- c u2 u1)
          r (fk c 2 (f- c s2 s1))]
      (if (b/zero? h)
        ;; Same x. Either the same point -- in which case the chord is a
        ;; tangent and this is a doubling -- or two points that sum to
        ;; infinity.
        ;;
        ;; **`scalar-mult` never reaches this.** Left-to-right double-and-add
        ;; adds P to a multiple of P that is never P itself, so h is never
        ;; zero there. It was measured: forcing this branch to `false` left
        ;; the entire suite green, which is what a branch nothing checks looks
        ;; like. It is kept because `add-points` is a group operation and a
        ;; partial one is a trap for the next caller -- and it is now reached
        ;; directly from a test.
        (if (b/zero? r) (double-point c pp) infinity)
        (let [i (fsq c (fk c 2 h))
              j (f* c h i)
              v (f* c u1 i)
              x3 (f- c (f- c (fsq c r) j) (fk c 2 v))
              y3 (f- c (f* c r (f- c v x3)) (fk c 2 (f* c s1 j)))
              z3 (f* c (f- c (f- c (fsq c (f+ c z1 z2)) z1z1) z2z2) h)]
          [x3 y3 z3])))))

(defn ->affine
  [c [x y z]]
  (when-not (b/zero? z)
    (let [zi (b/inv-mod z (:p c))
          zi2 (fsq c zi)]
      [(f* c x zi2) (f* c y (f* c zi zi2))])))

(defn scalar-mult
  "`k * P`, double-and-add from the top bit.

  Returns a Jacobian point; `infinity?` it before using the result. Not
  constant-time — see the README."
  [c k [px py]]
  (loop [i (dec (b/bit-length k)) acc infinity]
    (if (neg? i)
      acc
      (recur (dec i)
             (let [d (double-point c acc)]
               (if (b/test-bit k i) (add-points c d [px py b/one]) d))))))

(defn on-curve?
  [c x y]
  (and (b/lt? x (:p c)) (b/lt? y (:p c))
       (b/eq? (fsq c y)
              (f+ c (f+ c (f* c x (fsq c x)) (f* c (:a c) x)) (:b c)))))

;; ── SEC1 encoding ────────────────────────────────────────────────────────────
;;
;; RFC 9180 §7.1.1 says SerializePublicKey for these curves is SEC1's
;; uncompressed form: 0x04 || X || Y, each coordinate padded to the field
;; length. Compressed points are not accepted -- HPKE never produces one, and
;; accepting an encoding a peer cannot have sent is surface for nothing.

(defn point->bytes
  [c [x y]]
  (into [0x04] (concat (b/to-bytes x (:byte-len c)) (b/to-bytes y (:byte-len c)))))

(defn bytes->point
  "Parse and **validate**. Returns `{:status :ok :point [x y]}`.

  Validation is not optional here. An unchecked point lets a peer hand over
  something that is not on the curve at all, and the scalar multiplication
  then happens in a group the attacker chose -- one that can be small enough
  to recover the private scalar from the result. The cofactor is 1 on all
  three curves, so on-curve and not-infinity is the whole check."
  [c bs]
  (let [n (:byte-len c)
        bs (mapv #(bit-and (int %) 0xFF) (seq bs))]
    (cond
      (not= (inc (* 2 n)) (count bs))
      {:status :error :reason :bad-point-length :length (count bs)}

      (not= 0x04 (first bs))
      {:status :error :reason :not-uncompressed :prefix (first bs)}

      :else
      (let [x (b/of-bytes (subvec bs 1 (inc n)))
            y (b/of-bytes (subvec bs (inc n)))]
        (if-not (on-curve? c x y)
          {:status :error :reason :point-not-on-curve}
          {:status :ok :point [x y]})))))
