(ns ecc.bignum
  "Arbitrary-precision integers, once, for both runtimes.

  This is the **only** file in this library with a reader conditional. Above
  it, the curve arithmetic is written once and reads the same on the JVM and
  under ClojureScript.

  ## Why a wrapper at all, when both runtimes have big integers

  Because ClojureScript's are `BigInt`, and not all of `cljs.core` knows that.
  Measured under nbb, the runtime this workspace verifies the ClojureScript
  path with:

      (+ (js/BigInt 3) (js/BigInt 4))     => 7n       works
      (mod (js/BigInt -1) (js/BigInt 7))  => 6n       works, and Euclidean
      (rem (js/BigInt 17) (js/BigInt 5))  => throws
      (even? (js/BigInt 4))               => throws
      (zero? (js/BigInt 0))               => **false**

  The last line is the reason this file exists. `rem` and `even?` throw, which
  is a bug that announces itself. `zero?` returns a confident wrong answer,
  and `ecc.curve` asks it whether a Jacobian `Z` is zero — which is how the
  point at infinity is represented. An always-false `zero?` makes every
  addition take the general formula with `Z = 0` substituted in, which does
  not throw and does not return infinity; it returns a point.

  That is measured, not assumed: `ecc.curve-test` replaces this namespace's
  `zero?` with a constant `false` and counts what goes red. An earlier draft
  of this docstring justified the wrapper by a *different* branch — the
  doubling discriminant inside `add-points` — and that one turned out to be
  unreachable from `scalar-mult`, so forcing it false broke nothing. The
  claim was replaced with the one that holds.

  So nothing here calls a `cljs.core` predicate on one of these that has not
  been measured, and `zero?` and `even?` are **shadowed** so that a caller who
  reaches for the obvious name gets the one that works.

  `js*` is not available either — nbb evaluates rather than compiles — so the
  operations below are the ones that were checked, not the ones that would be
  natural to write.

  ## Not constant-time

  Neither `java.math.BigInteger` nor `BigInt` is. Their operations branch and
  allocate on the magnitude of their inputs. See the README: this is
  appropriate for protocol work on data the process already holds, and not for
  a setting where an attacker can measure this process."
  (:refer-clojure :exclude [zero? even? mod])
  #?(:clj (:import [java.math BigInteger])))

(defn of-int [n]
  #?(:clj (BigInteger/valueOf (long n))
     :cljs (js/BigInt n)))

(defn of-dec [s]
  #?(:clj (BigInteger. ^String s 10)
     :cljs (js/BigInt s)))

(defn of-hex [s]
  #?(:clj (BigInteger. ^String s 16)
     :cljs (js/BigInt (str "0x" (if (= "" s) "0" s)))))

(def zero (of-int 0))
(def one (of-int 1))
(def two (of-int 2))
(def three (of-int 3))

(defn add [a b] #?(:clj (.add ^BigInteger a ^BigInteger b) :cljs (+ a b)))
(defn sub [a b] #?(:clj (.subtract ^BigInteger a ^BigInteger b) :cljs (- a b)))
(defn mul [a b] #?(:clj (.multiply ^BigInteger a ^BigInteger b) :cljs (* a b)))

(defn mod
  "Always in `[0, m)`, on both runtimes.

  JavaScript's own `%` keeps the sign of the dividend; `cljs.core/mod` does
  not, and was measured to give Euclidean answers on `BigInt` — `-1 mod 7` is
  `6`, matching Java's `.mod`. That agreement is asserted in
  `ecc.bignum-test`, because a field subtraction that goes negative is where
  the difference would first show and the result would still look like a
  field element."
  [a m]
  #?(:clj (.mod ^BigInteger a ^BigInteger m)
     :cljs (clojure.core/mod a m)))

(defn eq? [a b] #?(:clj (= 0 (.compareTo ^BigInteger a ^BigInteger b)) :cljs (= a b)))
(defn lt? [a b] #?(:clj (neg? (.compareTo ^BigInteger a ^BigInteger b)) :cljs (< a b)))
(defn zero? [a] (eq? a zero))
(defn even? [a] (eq? (mod a two) zero))

(defn test-bit
  "Is bit `i` set? Counted from the least significant."
  [a i]
  #?(:clj (.testBit ^BigInteger a (int i))
     :cljs (eq? (bit-and (bit-shift-right a (js/BigInt i)) one) one)))

(defn shr
  "Shift right by `n` bits."
  [a n]
  #?(:clj (.shiftRight ^BigInteger a (int n))
     :cljs (bit-shift-right a (js/BigInt n))))

(defn bit-length [a]
  #?(:clj (.bitLength ^BigInteger a)
     :cljs (if (zero? a) 0 (count (.toString a 2)))))

(defn mod-pow
  [a e m]
  #?(:clj (.modPow ^BigInteger a ^BigInteger e ^BigInteger m)
     :cljs (loop [b (mod a m) e e acc one]
             (if (zero? e)
               acc
               (recur (mod (mul b b) m)
                      (bit-shift-right e one)
                      (if (test-bit e 0) (mod (mul acc b) m) acc))))))

(defn inv-mod
  "The multiplicative inverse modulo a **prime** `m`, by Fermat.

  Not the extended Euclidean algorithm: this is used once per scalar
  multiplication, to leave Jacobian coordinates, and `mod-pow` reuses the
  arithmetic already here instead of adding a second algorithm with its own
  sign conventions to get wrong. Zero has no inverse and returns `nil` rather
  than the `0` that Fermat would hand back."
  [a m]
  (when-not (zero? (mod a m))
    (mod-pow a (sub m two) m)))

(defn to-hex
  "Fixed-width, zero-padded to `len` bytes."
  [a len]
  (let [s #?(:clj (.toString ^BigInteger a 16) :cljs (.toString a 16))
        want (* 2 len)]
    (str (apply str (repeat (- want (count s)) "0")) s)))

(defn to-bytes [a len]
  (mapv #(#?(:clj Integer/parseInt :cljs js/parseInt) (apply str %) 16)
        (partition 2 (to-hex a len))))

(defn to-dec
  "Decimal string. Only the JVM oracle needs this; it is here rather than
  there because reaching into the representation from outside is what this
  namespace exists to prevent."
  [a]
  #?(:clj (.toString ^BigInteger a 10) :cljs (.toString a 10)))

(defn of-bytes [bs]
  (of-hex (apply str (map (fn [b]
                            (let [b (bit-and (int b) 0xFF)
                                  s #?(:clj (Integer/toString b 16) :cljs (.toString b 16))]
                              (if (= 1 (count s)) (str "0" s) s)))
                          bs))))
