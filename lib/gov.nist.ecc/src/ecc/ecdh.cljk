(ns ecc.ecdh
  "ECDH on the NIST prime curves — the two operations a KEM needs.

  `public-key` multiplies the base point; `ecdh` multiplies a peer's point and
  returns the **x-coordinate only**, which is what SEC1's ECDH primitive and
  RFC 9180 §7.1.4 both specify. Returning the whole point would be a different
  function with a different security argument."
  (:require [ecc.bignum :as b]
            [ecc.curve :as curve]))

(defn valid-scalar?
  "A private key is an integer in `[1, n-1]`.

  Both ends matter. Zero multiplies to infinity, and `n` and above wrap to a
  smaller equivalent — so an out-of-range scalar is not merely unusual, it is
  a different key than the caller believes they hold."
  [c k]
  (and (not (b/zero? k)) (b/lt? k (:n c))))

(defn public-key
  "`k * G`, serialised. Returns `{:status :ok :bytes …}`."
  [c k]
  (if-not (valid-scalar? c k)
    {:status :error :reason :scalar-out-of-range}
    (let [j (curve/scalar-mult c k [(:gx c) (:gy c)])]
      (if (curve/infinity? j)
        {:status :error :reason :public-key-is-infinity}
        {:status :ok :bytes (curve/point->bytes c (curve/->affine c j))}))))

(defn ecdh
  "The shared x-coordinate, `Nsecret` bytes.

  `peer` is a serialised uncompressed point and is validated before it is
  multiplied — see `curve/bytes->point` for why that is not optional."
  [c k peer]
  (if-not (valid-scalar? c k)
    {:status :error :reason :scalar-out-of-range}
    (let [p (curve/bytes->point c peer)]
      (if (not= :ok (:status p))
        p
        (let [j (curve/scalar-mult c k (:point p))]
          (if (curve/infinity? j)
            ;; Unreachable with a valid scalar and an on-curve point on a
            ;; cofactor-1 curve, and checked anyway: the alternative is
            ;; dividing by zero in ->affine and returning nil as if it were
            ;; a secret.
            {:status :error :reason :non-contributory-dh}
            {:status :ok
             :bytes (b/to-bytes (first (curve/->affine c j)) (:byte-len c))}))))))
