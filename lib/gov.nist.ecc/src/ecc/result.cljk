(ns ecc.result
  "`[:ok v]` or `[:error {…}]`.

  The reason is merged **last**, so a caller's context map cannot replace it.
  `org-ietf-tls` merges the other way, and a context carrying `:tls/reason`
  silently replaced the stable keyword there — found only because its tests
  assert which error rather than that one happened."
  (:refer-clojure :exclude [val]))

(defn ok [v] [:ok v])
(defn error
  ([reason] (error reason {}))
  ([reason data] [:error (merge data {:ecc/reason reason})]))
(defn ok? [r] (and (vector? r) (= :ok (first r))))
(defn error? [r] (and (vector? r) (= :error (first r))))
(defn val [r] (if (ok? r) (second r) (throw (ex-info "ecc.result/val on an error" {:result r}))))
(defn err [r] (when (error? r) (second r)))
(defn reason [r] (:ecc/reason (err r)))

(defmacro let-ok
  [bindings & body]
  (if (empty? bindings)
    `(do ~@body)
    (let [[sym expr & more] bindings]
      `(let [r# ~expr]
         (if (error? r#) r# (let [~sym (val r#)] (let-ok ~(vec more) ~@body)))))))
