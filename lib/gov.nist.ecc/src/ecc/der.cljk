(ns ecc.der
  "The one DER structure ECDSA needs: `SEQUENCE { INTEGER r, INTEGER s }`.

  A parser, not a decoder. Every rule below is a **refusal**, because the
  corpus this is checked against is mostly malformed signatures — 92 of
  Wycheproof's P-256 cases are invalid encodings and 7 are BER, and an
  implementation that accepts them accepts signatures nobody else does.

  ## Why strictness is a security property here, not tidiness

  A signature is a bearer token for a statement. If two byte strings both
  decode to the same `(r, s)`, then a system that deduplicates or records
  signatures by their bytes sees two, and one of them can be replayed past a
  check that already saw the other. That is the whole reason DER exists rather
  than BER: **exactly one encoding per value**.

  So: minimal length encoding, no indefinite lengths, no trailing bytes after
  the SEQUENCE, no leading `0x00` on an INTEGER unless the next byte would
  otherwise read as negative, and no negative INTEGERs at all — `r` and `s`
  are positive by construction."
  (:require [ecc.bignum :as b]
            [ecc.result :as r :refer [ok error]]))

(defn- read-length
  "A definite, minimally encoded length. Returns `[len next-offset]`."
  [bs off]
  (if (>= off (count bs))
    (error :truncated {:ecc/at off})
    (let [b0 (nth bs off)]
      (cond
        (< b0 0x80) (ok [b0 (inc off)])
        (= b0 0x80) (error :indefinite-length {:ecc/at off})
        (= b0 0xFF) (error :reserved-length {:ecc/at off})
        :else
        (let [n (- b0 0x80)]
          (cond
            (> (+ off 1 n) (count bs)) (error :truncated {:ecc/at off :ecc/need n})
            (> n 4) (error :length-too-large {:ecc/bytes n})
            :else
            (let [v (reduce (fn [acc i] (+ (* 256 acc) (nth bs (+ off 1 i)))) 0 (range n))]
              (cond
                (zero? (nth bs (+ off 1))) (error :non-minimal-length {:ecc/at off})
                (< v 0x80) (error :non-minimal-length {:ecc/value v})
                :else (ok [v (+ off 1 n)])))))))))

(defn- read-integer
  "One non-negative, minimally encoded INTEGER."
  [bs off]
  (if (or (>= off (count bs)) (not= 0x02 (nth bs off)))
    (error :expected-integer {:ecc/at off
                              :ecc/tag (when (< off (count bs)) (nth bs off))})
    (r/let-ok [[len off] (read-length bs (inc off))]
      (let [end (+ off len)]
        (cond
          (> end (count bs)) (error :truncated {:ecc/at off :ecc/need len})
          (zero? len) (error :empty-integer {:ecc/at off})
          (>= (nth bs off) 0x80) (error :negative-integer {:ecc/at off})
          (and (> len 1) (zero? (nth bs off)) (< (nth bs (inc off)) 0x80))
          (error :non-minimal-integer {:ecc/at off})
          :else (ok [(b/of-bytes (subvec (vec bs) off end)) end]))))))

(defn parse-signature
  "`SEQUENCE { INTEGER r, INTEGER s }` and nothing else."
  [bs]
  (let [bs (mapv #(bit-and (int %) 0xFF) (seq bs))]
    (if (or (empty? bs) (not= 0x30 (first bs)))
      (error :expected-sequence {:ecc/tag (first bs)})
      (r/let-ok [[len off] (read-length bs 1)]
        (cond
          (not= (count bs) (+ off len))
          (error :trailing-bytes {:ecc/declared (+ off len) :ecc/total (count bs)})
          :else
          (r/let-ok [[rr off] (read-integer bs off)
                     [ss off] (read-integer bs off)]
            (if (not= off (count bs))
              (error :trailing-bytes-in-sequence {:ecc/at off :ecc/total (count bs)})
              (ok {:ecc/r rr :ecc/s ss}))))))))

(defn- integer-bytes [x]
  (let [hexed (b/to-bytes x (max 1 (quot (+ 7 (b/bit-length x)) 8)))
        trimmed (let [t (drop-while zero? hexed)] (if (seq t) (vec t) [0]))]
    (if (>= (first trimmed) 0x80) (into [0x00] trimmed) trimmed)))

(defn- length-bytes [n]
  (if (< n 0x80)
    [n]
    (let [bs (loop [v n out ()] (if (zero? v) (vec out) (recur (quot v 256) (conj out (mod v 256)))))]
      (into [(+ 0x80 (count bs))] bs))))

(defn encode-signature
  "The canonical DER for `(r, s)`. Round-trips with `parse-signature`, which
  is the only property asserted of it — there is exactly one right answer, so
  agreeing with the parser is agreeing with the standard."
  [r- s-]
  (let [ri (into [0x02] (let [b (integer-bytes r-)] (into (length-bytes (count b)) b)))
        si (into [0x02] (let [b (integer-bytes s-)] (into (length-bytes (count b)) b)))
        body (into ri si)]
    (ok (into [0x30] (into (length-bytes (count body)) body)))))
