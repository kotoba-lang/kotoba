(ns ecc.bignum-test
  "The wrapper, and the reason it is a wrapper.

  The point of `ecc.bignum` is that ClojureScript's `BigInt` does not answer
  `cljs.core`'s numeric predicates correctly, and one of the wrong answers is
  silent. These tests run on both runtimes and assert the *shadowing*
  versions behave, which is the property the curve code depends on."
  (:require [kotoba.test :refer [deftest is testing]]
            [ecc.bignum :as b]))

(deftest zero-is-recognised
  ;; The one that matters. Under ClojureScript, `cljs.core/zero?` returns
  ;; false for a BigInt zero -- a confident wrong answer, in the predicate
  ;; that picks between three different point-addition formulas.
  (is (b/zero? b/zero))
  (is (b/zero? (b/sub b/three b/three)))
  (is (b/zero? (b/mod (b/of-int 12) (b/of-int 4))))
  (is (not (b/zero? b/one)))
  (testing "and on ClojureScript the core predicate does not"
    #?(:cljs (is (false? (zero? (js/BigInt 0)))
                 "if this ever starts passing, cljs.core learned about BigInt")
       :clj (is true))))

(deftest mod-agrees-across-the-two-runtimes
  ;; The same assertions run on both, so a divergence shows up as a failure
  ;; on one of them rather than as two libraries that each pass their own.
  (doseq [[a m e] [[-1 7 6] [-7 7 0] [-8 7 6] [1 7 1] [8 7 1] [0 7 0] [17 5 2]]]
    (is (b/eq? (b/of-int e) (b/mod (b/of-int a) (b/of-int m)))
        (str a " mod " m " = " e))))

(deftest mod-is-never-negative
  ;; JavaScript's % keeps the sign of the dividend and Java's .mod does not.
  ;; A field subtraction that goes negative is where the difference shows.
  (doseq [[a m] [[-1 7] [-7 7] [-8 7] [-100 7] [1 7] [100 7]]]
    (is (b/lt? (b/mod (b/of-int a) (b/of-int m)) (b/of-int m)))
    (is (not (b/lt? (b/mod (b/of-int a) (b/of-int m)) b/zero))
        (str a " mod " m))))

(deftest arithmetic-round-trips
  (let [p (b/of-dec "115792089210356248762697446949407573530086143415290314195533631308867097853951")]
    (testing "inverse"
      (doseq [n [1 2 3 65537 999999937]]
        (let [x (b/of-int n)
              i (b/inv-mod x p)]
          (is (b/eq? b/one (b/mod (b/mul x i) p)) (str n)))))
    (testing "zero has no inverse, and says so rather than returning zero"
      (is (nil? (b/inv-mod b/zero p))))
    (testing "mod-pow"
      (is (b/eq? (b/of-int 445) (b/mod-pow (b/of-int 4) (b/of-int 13) (b/of-int 497)))))))

(deftest bytes-round-trip-at-a-fixed-width
  (doseq [[n len] [[0 32] [1 32] [255 32] [256 32] [65535 66]]]
    (let [x (b/of-int n)
          bs (b/to-bytes x len)]
      (is (= len (count bs)) (str n))
      (is (every? #(<= 0 % 255) bs))
      (is (b/eq? x (b/of-bytes bs)))))
  (testing "a value that fills the width, and one that overflows it"
    (let [p256 (b/of-dec "115792089210356248762697446949407573530086143415290314195533631308867097853951")
          big (b/sub p256 b/one)]
      (is (= 32 (count (b/to-bytes big 32))))
      (is (b/eq? big (b/of-bytes (b/to-bytes big 32))))
      (is (= 255 (first (b/to-bytes big 32))) "the top byte is really the top byte"))))

(deftest bits
  (is (= 0 (b/bit-length b/zero)))
  (is (= 1 (b/bit-length b/one)))
  (is (= 8 (b/bit-length (b/of-int 255))))
  (is (= 9 (b/bit-length (b/of-int 256))))
  (is (b/test-bit (b/of-int 5) 0))
  (is (not (b/test-bit (b/of-int 5) 1)))
  (is (b/test-bit (b/of-int 5) 2))
  (is (b/even? (b/of-int 4)))
  (is (not (b/even? (b/of-int 5)))))
