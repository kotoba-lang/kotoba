;; Zero dependencies. Big integers come from the host language, not from a
;; library: see src/ecc/bignum.cljk for what that costs and where it is
;; confined.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]
         :extra-deps {io.github.kotoba-lang/org-nist-sha2
                      {:git/url "https://github.com/kotoba-lang/org-nist-sha2.git"
                       :git/sha "e7c1b250adf3291ef99424fa85d8e7381cb086fb"}}}}}
