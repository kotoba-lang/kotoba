(ns kotoba.card.lifecycle-test
  "These tests pin this table to the DEPLOYED issuer side, not to a reading of
  it. Every expectation below is transcribed from

    cloud-itonami/cloud-itonami-card-issuing
      cardissuing.governor/legal-predecessor  -> which state each event is legal from
      cardissuing.store/lifecycle!            -> which state each event lands in

  If those change, these tests should fail and this table should follow them."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.card.lifecycle :as lc]))

;; Transcribed verbatim from cardissuing.governor/legal-predecessor.
(def issuer-legal-predecessor
  {:activate #{:issued}
   :block    #{:active}
   :reissue  #{:blocked}
   :close    #{:issued :active :blocked}})

;; Transcribed verbatim from cardissuing.store/lifecycle!'s next-status case.
(def issuer-next-status
  {:activate :active
   :block    :blocked
   :reissue  :active
   :close    :closed})

(deftest table-mirrors-the-issuer-side-exactly
  (testing "the event vocabulary matches"
    (is (= (set (keys issuer-legal-predecessor)) (set (keys lc/events)))))
  (testing "every event is legal from exactly the states the governor allows"
    (doseq [[event from] issuer-legal-predecessor]
      (is (= from (get-in lc/events [event :from]))
          (str event " :from must mirror the governor's allowlist"))))
  (testing "every event lands in exactly the state the store assigns"
    (doseq [[event to] issuer-next-status]
      (is (= to (get-in lc/events [event :to]))
          (str event " :to must mirror the store's next-status"))))
  (testing "and reachability agrees state by state, in both directions"
    (doseq [event (keys lc/events)
            state lc/states]
      (is (= (contains? (get issuer-legal-predecessor event) state)
             (lc/reachable? state event))
          (str event " from " state)))))

(deftest the-two-easy-guesses-are-wrong
  (testing "unblocking is NOT an activate -- :activate is legal only from :issued"
    (is (lc/reachable? :issued :activate))
    (is (not (lc/reachable? :blocked :activate))))
  (testing "a blocked card is recovered by :reissue, and only from :blocked"
    (is (lc/reachable? :blocked :reissue))
    (is (not (lc/reachable? :active :reissue)))
    (is (not (lc/reachable? :issued :reissue)))))

(deftest reissue-mints-a-successor
  (testing "the issuer side creates the replacement card in the same operation,
            so this table says so rather than deferring it to the caller"
    (is (lc/mints-successor? :reissue))
    (doseq [e [:activate :block :close]]
      (is (not (lc/mints-successor? e)) (str e " must not mint a card"))))
  (testing "and a reissue lands in :active, not in a separate terminal state"
    (is (= :active (lc/next-state :blocked :reissue)))
    (is (not (lc/terminal? :active))))
  (testing "apply-event reports the mint and echoes the superseded reference"
    (let [r (lc/apply-event :blocked :reissue :card-reference "411111...1111")]
      (is (:card/ok? r))
      (is (= :active (:card/to r)))
      (is (:card/mints-successor? r))
      (is (= "411111...1111" (:card/supersedes-reference r)))))
  (testing "a non-reissue carries no mint keys at all"
    (let [r (lc/apply-event :issued :activate)]
      (is (not (contains? r :card/mints-successor?)))
      (is (not (contains? r :card/supersedes-reference))))))

(deftest intake-is-not-reachable-by-any-lifecycle-event
  (testing ":intake is a state, but issuance is :card/issue -- not a lifecycle event"
    (is (contains? lc/states :intake))
    (doseq [event (keys lc/events)]
      (is (not (lc/reachable? :intake event))
          (str "no lifecycle event may act on an :intake record: " event))
      (is (not= :intake (get-in lc/events [event :to]))
          (str event " must not land back in :intake")))))

(deftest terminality
  (testing ":closed is the only terminal state"
    (is (lc/terminal? :closed))
    (doseq [s [:intake :issued :active :blocked]]
      (is (not (lc/terminal? s)) (str s " should not be terminal"))))
  (testing "a closed card admits nothing"
    (doseq [event (keys lc/events)]
      (is (not (lc/reachable? :closed event)) (str :closed " / " event)))))

(deftest no-event-repeats-itself
  (testing "an event is never legal from the state it lands in"
    (doseq [[event {:keys [to]}] lc/events]
      (is (not (lc/reachable? to event))
          (str event " must not be legal from its own result state " to)))))

(deftest next-state-is-total
  (is (= :active (lc/next-state :issued :activate)))
  (is (= :blocked (lc/next-state :active :block)))
  (is (= :closed (lc/next-state :blocked :close)))
  (testing "an unreachable event yields nil rather than throwing"
    (is (nil? (lc/next-state :blocked :activate)))
    (is (nil? (lc/next-state :active :reissue)))
    (is (nil? (lc/next-state :closed :activate)))
    (is (nil? (lc/next-state :nonsense :activate)))))

(deftest transition-issues-cite-a-reason
  (testing "a reachable transition has no issues"
    (is (empty? (lc/transition-issues :active :block))))
  (testing "each refusal names its own kind"
    (is (= [:event/unknown] (mapv :card/issue (lc/transition-issues :active :unblock))))
    (is (= [:state/unknown] (mapv :card/issue (lc/transition-issues :frozen :block))))
    (is (= [:state/terminal] (mapv :card/issue (lc/transition-issues :closed :activate))))
    (is (= [:transition/unreachable] (mapv :card/issue (lc/transition-issues :blocked :activate)))))
  (testing "an unreachable transition reports the states it would be reachable from"
    (is (= #{:issued} (:card/from (first (lc/transition-issues :blocked :activate)))))))

(deftest apply-event-never-throws
  (is (false? (:card/ok? (lc/apply-event nil nil))))
  (is (false? (:card/ok? (lc/apply-event :active :suspend))))
  (is (false? (:card/ok? (lc/apply-event :intake :activate)))))

(deftest a-full-path-runs-through
  (testing "issued -> active -> blocked -> (reissue) active -> closed"
    (let [path [[:issued :activate :active]
                [:active :block :blocked]
                [:blocked :reissue :active]
                [:active :close :closed]]]
      (doseq [[from event to] path]
        (let [r (lc/apply-event from event)]
          (is (:card/ok? r) (str event " from " from))
          (is (= to (:card/to r)))))))
  (testing "and the walk stops at :closed"
    (is (lc/terminal? :closed))))

(deftest describe-renders-both-outcomes
  (is (= "activate: issued -> active" (lc/describe :issued :activate)))
  (is (= "reissue: blocked -> active (new card reference)"
         (lc/describe :blocked :reissue)))
  (is (= "activate: refused from blocked (reachable from issued)"
         (lc/describe :blocked :activate))))
