{:paths ["src"]
 ;; Sibling libraries are named by GIT COORDINATE, not :local/root.
 ;;
 ;; A library whose :deps use :local/root is only consumable from inside a
 ;; monorepo checkout: tools.deps resolves "../html" relative to the consumer's
 ;; gitlibs directory, which does not exist, and the classpath build fails
 ;; before anything runs. Measured 2026-07-30 on kotoba-lang/esim, which had the
 ;; same shape and could not be consumed by cloud-itonami-app at all:
 ;;   Error building classpath. Local lib io.github.kotoba-lang/phone not found:
 ;;   ~/.gitlibs/libs/io.github.kotoba-lang/esim/phone
 ;;
 ;; So :deps carry git coordinates and the :dev alias overrides them to sibling
 ;; checkouts for monorepo work. CI runs the plain (git) path, which means CI
 ;; proves this library is still consumable rather than only that it compiles
 ;; next to its siblings.
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/html {:local/root "../kotoba.html"}
        io.github.kotoba-lang/css {:local/root "../kotoba.css"}}
 :aliases
 {:dev {:override-deps
        {io.github.kotoba-lang/html {:local/root "../html"}
         io.github.kotoba-lang/css  {:local/root "../css"}}}
  :test {:extra-paths ["test"]
         :extra-deps {
                      ;; TEST-ONLY. Parity compiles kotoba/kotoba/card/
                      ;; lifecycle.{kotoba,cljk} to KIR and runs it against
                      ;; kotoba.card.lifecycle. Nothing in :paths depends on
                      ;; either; `:test-pure` runs the .cljc suites without them.
                      ;; Pins are the west pair and advance together.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "93c49982be32459b7671d70a308f0b8998b67477"}
                      io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.osaho"}}}
}}
