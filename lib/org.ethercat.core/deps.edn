;; No dependencies. EtherCAT's addressed read/write layer is a 2-byte
;; frame header, a 10-byte datagram header, an 11-bit length/flag word
;; and a working-counter arithmetic rule — a leaf that dragged a raw
;; socket / real-time NIC driver binding behind it would defeat the
;; point, the same reasoning org-modbus and ch-iec-61850 give for having
;; none.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
