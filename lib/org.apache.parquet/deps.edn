{:paths ["src"]
 ;; columnar is the only dependency: this repo exists to be a provider for it,
 ;; and IColumnSource is the shape it provides.
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/com-google-snappy {:local/root "../com.google.snappy"}
        io.github.kotoba-lang/columnar {:local/root "../kotoba.columnar"}
        io.github.kotoba-lang/org-ietf-deflate {:local/root "../org.ietf.deflate"}
        io.github.kotoba-lang/org-ietf-zstd {:local/root "../org.ietf.zstd"}}
 :aliases
 ;; kotobase-lake is a TEST dependency only. This repo provides a column
 ;; source and must not know about catalogs, tenants or triple patterns —
 ;; but something has to prove the whole chain works against a real file
 ;; rather than a fake column source, and this is the end that has one.
 {:test {:extra-paths ["test"]}}}
