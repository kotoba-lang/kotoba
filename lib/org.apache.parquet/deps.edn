{:paths ["src"]
 ;; columnar is the only dependency: this repo exists to be a provider for it,
 ;; and IColumnSource is the shape it provides.
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/com-google-snappy {:local/root "../com.google.snappy"}
        io.github.kotoba-lang/columnar {:local/root "../kotoba.columnar"}
        io.github.kotoba-lang/org-ietf-deflate {:local/root "../org.ietf.deflate"}
        io.github.kotoba-lang/org-ietf-zstd {:local/root "../org.ietf.zstd"}}
 :aliases
 ;; kotobase-lake is a TEST dependency only. This repo provides a column
 ;; source and must not know about catalogs, tenants or triple patterns —
 ;; but something has to prove the whole chain works against a real file
 ;; rather than a fake column source, and this is the end that has one.
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/kotobase-lake
                      {:git/url "https://github.com/kotoba-lang/kotobase-lake.git"
                       :git/sha "19cec4f3c4bb3f6763172dc60b86e8950accec01"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-paths ["test"]
         :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  ;; Writes the files `test/fixtures/verify_written.py` hands to pyarrow. A
  ;; separate entrypoint because the claim it supports -- that a file we wrote
  ;; is one a REAL Parquet implementation accepts, with statistics it can SEE --
  ;; cannot be checked from inside this repo. Two failures were measured that
  ;; passed every in-repo test: a missing `required` thrift field, and missing
  ;; `column_orders` which made every statistic invisible.
  :emit {:extra-paths ["test"]
         :main-opts ["-m" "parquet.emit-for-python"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
