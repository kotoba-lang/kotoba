(ns kotoba.lint.lint-file
  "lint-file -- addressed on its own.

  Split out of kotoba.lang.lint on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.lang.fs :as fs]
            [kotoba.lint.lint-source :refer [lint-source]])
)

(defn lint-file
  "Read a source file via an injected `IFilesystem` (`fsb`) at `path`, then
  `lint-source`. Returns the lint result, or `:kotoba.lang.lint/read-error` if the file is
  absent."
  [fsb path]
  (let [raw (fs/read fsb path)]
    (if (nil? raw)
      :kotoba.lang.lint/read-error
      (lint-source raw))))
