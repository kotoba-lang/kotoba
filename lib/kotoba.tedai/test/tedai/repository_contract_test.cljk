(ns tedai.repository-contract-test
  (:require [kotoba.lang.edn :as edn]
            [kotoba.io :as io]
            [kotoba.test :refer [deftest is]]))

(def root (io/file (System/getProperty "user.dir")))

(deftest canonical-edn-contract
  (doseq [path ["manifest.edn" "lib/kotoba.tedai/schema/schema.edn"
                "lib/kotoba.tedai/data/app-registry.kotoba.edn"]]
    (is (some? (edn/read-string (slurp (io/file root path)))) path)))

(deftest no-legacy-language-entrypoints
  (is (empty? (filter #(io/file? %) (io/file-seq (io/file root "methods"))))))
