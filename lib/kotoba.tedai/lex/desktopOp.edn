[{:db/id -1, :desktopOp/lexicon 1, :desktopOp/id "com.etzhayyim.tedai.desktopOp", :desktopOp/defs "{:main {:type \"record\", :key \"tid\", :record {:type \"object\", :required [\"app\" \"noun\" \"verb\" \"safety\" \"destructive\" \"adapterTier\" \"dryRun\" \"stanceGate\" \"mutateGate\"], :properties {:args {:type \"string\", :description \"serialized flag KEYS only; never values (a value could carry a secret/path) (G3)\"}, :dryRun {:type \"boolean\", :const true, :description \"G6 invariant — R0 is plan/dry-run only; live actuation Council Lv6+ + operator gated\"}, :executedAt {:type \"string\", :format \"datetime\", :description \"G7 as-of exec history (gated)\"}, :verb {:type \"string\", :description \"list / read / create / move / delete / send …\"}, :mutateGate {:type \"string\", :enum [\"read-allowed\" \"awaiting-member-sig\" \"awaiting-member-sig-and-outward-gate\" \"authorized\"], :description \"G5 — read ships at R0; mutate requires member signature; outward additionally requires the Council outward gate\"}, :route {:type \"string\", :enum [\"karakuri\"], :description \"N7 — browser surfaces route to karakuri (one owner per surface)\"}, :adapterTier {:type \"string\", :enum [\"t1-scripting-api\" \"t2-vision-pointer\" \"t3-file-level\"], :description \"T1 scripting/accessibility-API first (G2)\"}, :evidenceSha256 {:type \"string\", :description \"G9 — sha256 of the on-device frame; the raw frame never enters the log\"}, :stanceGate {:type \"string\", :enum [\"ok\" \"refused-synthetic-input-prohibited\"], :description \"G2 — T2 on a synthetic-input-prohibited app (anti-cheat/DRM) is refused by construction\"}, :safety {:type \"string\", :enum [\"read\" \"create\" \"update\" \"delete\" \"outward\"], :description \"classified op safety; :outward = effect leaves the device (send/pay/post/upload)\"}, :destructive {:type \"boolean\", :description \"true for delete / irreversible mutations\"}, :app {:type \"string\", :description \"app id from the :representative registry\"}, :plannedAt {:type \"string\", :format \"datetime\", :description \"G7 as-of plan history\"}, :noun {:type \"string\", :description \"resource noun (files / message / sheet / records …)\"}}}}}"}]
