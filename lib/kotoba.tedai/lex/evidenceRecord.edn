[{:db/id -1, :evidenceRecord/lexicon 1, :evidenceRecord/id "com.etzhayyim.tedai.evidenceRecord", :evidenceRecord/defs "{:main {:type \"record\", :key \"tid\", :record {:type \"object\", :required [\"opId\" \"evidenceSha256\" \"rawFrameRetained\" \"frameLeftDevice\"], :properties {:opId {:type \"string\", :description \"the DesktopOp this evidence attests (G7)\"}, :evidenceSha256 {:type \"string\", :description \"sha256 hex digest of the on-device frame — the ONLY form in which screen evidence may enter the log (G9)\"}, :rawFrameRetained {:type \"boolean\", :const false, :description \"G8/G9 — the raw frame is not retained in the audit trail; it stays on-device under the member's key and expires\"}, :frameLeftDevice {:type \"boolean\", :const false, :description \"G4 — a screenshot never leaves the device; cloud computer-use APIs are structurally unrepresentable\"}, :scope {:type \"string\", :const \"op\", :description \"G8 — observation is op-scoped to the member's own session; never ambient, never of other persons\"}, :recordedAt {:type \"string\", :format \"datetime\", :description \"G7 as-of history (caller-stamped)\"}}}}}"}]
