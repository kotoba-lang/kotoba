[{:db/id -1, :pairingGrant/lexicon 1, :pairingGrant/id "com.etzhayyim.tedai.pairingGrant", :pairingGrant/defs "{:main {:type \"record\", :key \"tid\", :record {:type \"object\", :required [\"device\" \"principal\" \"deviceOwner\" \"paired\" \"serverHeldKey\" \"pairingRef\"], :properties {:device {:type \"string\", :description \"the member's device label (member-laptop …)\"}, :principal {:type \"string\", :const \"member\", :description \"G1 — member-principal only\"}, :deviceOwner {:type \"string\", :const \"member\", :description \"G1 — the member's OWN device; third-party device control is refused (N3: structurally not a RAT)\"}, :paired {:type \"boolean\", :const true, :description \"G1 — physical pairing ceremony (consent) completed\"}, :serverHeldKey {:type \"boolean\", :const false, :description \"G3 — the platform never holds a pairing key (ADR-2605231525)\"}, :pairingRef {:type \"string\", :description \"encref:com.etzhayyim.encrypted/* — encrypted-envelope REFERENCE only, never key material (G3, ADR-2605181100)\"}, :mutateGate {:type \"string\", :enum [\"read-allowed\" \"awaiting-member-sig\" \"awaiting-member-sig-and-outward-gate\" \"authorized\"], :description \"G5 — outward ops are held at the Council outward gate even WITH a member signature\"}, :grantedAt {:type \"string\", :format \"datetime\"}}}}}"}]
