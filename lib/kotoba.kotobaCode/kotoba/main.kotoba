(ns main
  (:schemas {;; Whole-component operator entry for kotoba-code.
             ;; Replaces kbb -M:run (kotoba-code.main) including
             ;; :jvm-opts --enable-native-access=ALL-UNNAMED.
             ;; Do not wrap Datalevin/LMDB JNI as a C .so.
             :main/starts-with [:record :main/starts-with
                                [[:s :string] [:prefix :string]]]})
  (:export [main run
            cmd-help cmd-version cmd-tools cmd-commands cmd-capabilities
            cmd-task cmd-interactive cmd-tui cmd-doctor cmd-check
            cmd-persist cmd-infer
            code-ready code-usage code-admitted code-host-listen-hold
            backend-openrouter backend-murakumo backend-subscription
            blank? starts-with?
            catalog? host-listen?
            model-backend command-status]))

;; Operator entry for kotoba-lang/kotoba-code.
;; Replaces deps.edn :run (`kbb -M:run` → kotoba-code.main).
;; Working start is compile + instantiateKotoba:
;;   kotoba compile kotoba/main.kotoba --target wasm|web
;;   sh scripts/kotoba-compile.sh && sh scripts/kotoba-run.sh
;; Intended public command (CLI source-run gap until the CLI accepts this guest):
;;   kotoba run kotoba/main.kotoba
;; Native (sealed kexe, aarch64-macos only; Linux kexe-verify is HOLD):
;;   bin/amu check kotoba/main.kotoba --jvm-free
;;   bin/amu compile kotoba/main.kotoba --target aarch64-macos --jvm-free --output main.kexe
;;   bin/amu verify main.kexe
;;
;; Guest owns command admission (catalog vs host-listen vs usage) and
;; model-backend classification. main is not the constant 0.
;;
;; Host-listen HOLD (not implemented in this guest, not a fake ok):
;; OpenRouter/Murakumo HTTP inference, kotoba-Datom persist, filesystem/git
;; tools, nbb Ink / leftover JLine TUI, leftover MCP/HTTP listen.
;; Do not wrap --enable-native-access leftovers or Datalevin/LMDB JNI.

(defn cmd-help [] :string "help")
(defn cmd-version [] :string "version")
(defn cmd-tools [] :string "tools")
(defn cmd-commands [] :string "commands")
(defn cmd-capabilities [] :string "capabilities")
(defn cmd-task [] :string "task")
(defn cmd-interactive [] :string "interactive")
(defn cmd-tui [] :string "tui")
(defn cmd-doctor [] :string "doctor")
(defn cmd-check [] :string "check")
(defn cmd-persist [] :string "persist")
(defn cmd-infer [] :string "infer")

(defn code-ready [] :i64 42)
(defn code-usage [] :i64 2)
(defn code-admitted [] :i64 11)
(defn code-host-listen-hold [] :i64 90)

(defn backend-openrouter [] :string "openrouter")
(defn backend-murakumo [] :string "murakumo")
(defn backend-subscription [] :string "subscription")

(defn blank? [s :string] :bool
  (string=? s ""))

(defn starts-with? [x [:ref :main/starts-with]] :bool
  (let [s (record-get x :s)
        prefix (record-get x :prefix)
        n (string-byte-length s)
        p (string-byte-length prefix)]
    (if (< n p)
      false
      (string=? (string-substring s 0 p) prefix))))

(defn catalog? [command :string] :bool
  (if (string=? command (cmd-help))
    true
    (if (string=? command (cmd-version))
      true
      (if (string=? command (cmd-tools))
        true
        (if (string=? command (cmd-commands))
          true
          (string=? command (cmd-capabilities)))))))

(defn host-listen? [command :string] :bool
  (if (string=? command (cmd-task))
    true
    (if (string=? command (cmd-interactive))
      true
      (if (string=? command (cmd-tui))
        true
        (if (string=? command (cmd-doctor))
          true
          (if (string=? command (cmd-check))
            true
            (if (string=? command (cmd-persist))
              true
              (string=? command (cmd-infer)))))))))

(defn command-status [command :string] :i64
  (if (blank? command)
    (code-usage)
    (if (catalog? command)
      (code-admitted)
      (if (host-listen? command)
        (code-host-listen-hold)
        (code-usage)))))

(defn model-backend [model-id :string] :string
  (if (blank? model-id)
    ""
    (if (starts-with? (record-new [:ref :main/starts-with] model-id "murakumo:"))
      (backend-murakumo)
      (if (starts-with? (record-new [:ref :main/starts-with] model-id "codex:"))
        (backend-subscription)
        (if (starts-with? (record-new [:ref :main/starts-with] model-id "claude:"))
          (backend-subscription)
          (backend-openrouter))))))

(defn run [command :string] :i64
  (command-status command))

(defn main [] :i64
  (code-ready))
