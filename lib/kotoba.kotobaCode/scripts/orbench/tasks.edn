;; clj -> kotoba refactor benchmark tasks.
;;
;; Ground truth is a landed decision core in kotoba-lang/murakumo, held out of
;; the prompt. The `:battery` is an independent oracle: expected values come
;; from the Clojure semantics (calendar values recomputed from Hinnant's
;; days-from-civil, token strings read off the pre-port cljc), not from the
;; reference .kotoba. Every battery is verified to PASS on the reference and to
;; FAIL on a mutated reference before any model is called.

[{:id :t1-stream
  :reference "kotoba/overlay_stream_core.kotoba"
  :difficulty :easy
  :source
  "(ns murakumo.overlay.stream
  (:require [murakumo.identity :as identity]))

(def default-window-size 64)

(defn stream-id
  \"Stable stream id for a logical service connection.\"
  [session service opened-at]
  (identity/sha256-hex
   (pr-str {:overlay (:overlay session) :node (:node session)
            :name (:name session) :principal (:principal session)
            :service service :opened-at opened-at})))

(defn open-stream
  ([session service] (open-stream session service 0))
  ([session service opened-at]
   {:type \"murakumo.overlay.stream\"
    :id (stream-id session service opened-at)
    :overlay (:overlay session) :node (:node session)
    :name (:name session) :principal (:principal session)
    :service service :opened-at opened-at
    :next-seq 0
    :window default-window-size
    :closed? false}))

(defn frame
  \"Build one ordered stream frame.\"
  [stream payload]
  {:type \"murakumo.overlay.stream-frame\"
   :stream (:id stream) :overlay (:overlay stream) :node (:node stream)
   :name (:name stream) :service (:service stream)
   :seq (:next-seq stream) :payload payload})

(defn advance [stream]
  (update stream :next-seq inc))

(defn ack
  [frame accepted?]
  {:type \"murakumo.overlay.stream-ack\"
   :stream (:stream frame) :seq (:seq frame) :accepted? accepted?})"
  :interface
  "(ns overlay-stream-core
  (:export [default-window-size advance-seq ack-accepted?
            initial-next-seq type-stream type-frame type-ack]))

;; default-window-size []            -> :i64    the receive window constant
;; initial-next-seq    []            -> :i64    the :next-seq a new stream opens at
;; advance-seq         [next-seq :i64] -> :i64  what `advance` does to :next-seq
;; ack-accepted?       [accepted :bool] -> :bool the ack's accepted? projection
;; type-stream         []            -> :string the open-stream :type token
;; type-frame          []            -> :string the frame :type token
;; type-ack            []            -> :string the ack :type token"
  :battery
  "(defn test-window [] :bool (= (default-window-size) 64))
(defn test-initial [] :bool (= (initial-next-seq) 0))
(defn test-advance-0 [] :bool (= (advance-seq 0) 1))
(defn test-advance-41 [] :bool (= (advance-seq 41) 42))
(defn test-advance-neg [] :bool (= (advance-seq -1) 0))
;; string=? is i64-valued in this compiler, so it is folded through `if`
;; rather than returned directly; `=` is not defined on :bool either.
(defn test-type-stream [] :bool (if (string=? (type-stream) \"murakumo.overlay.stream\") true false))
(defn test-type-frame [] :bool (if (string=? (type-frame) \"murakumo.overlay.stream-frame\") true false))
(defn test-type-ack [] :bool (if (string=? (type-ack) \"murakumo.overlay.stream-ack\") true false))
(defn test-ack-true [] :bool (ack-accepted? true))
(defn test-ack-false [] :bool (not (ack-accepted? false)))"
  :want [[default-window-size 0 :i64] [initial-next-seq 0 :i64]
         [advance-seq 1 :i64] [ack-accepted? 1 :bool]
         [type-stream 0 :string] [type-frame 0 :string] [type-ack 0 :string]]
  :mutation ["(+ next-seq 1)" "(+ next-seq 2)"]}

 {:id :t2-prices
  :reference "kotoba/prices_core.kotoba"
  :difficulty :medium
  :source
  "(ns murakumo.infer.prices
  (:require [clojure.edn :as edn] [clojure.string :as str]))

(defn- days-between
  \"ISO date 文字列 2 つの日数差（from → to）。時刻は持たない。\"
  [from to]
  (letfn [(->days [s]
            (let [[y m d] (map #(Long/parseLong %) (str/split s #\"-\"))
                  ;; civil-days（Howard Hinnant のアルゴリズム）。うるう年を正しく扱う。
                  y' (if (<= m 2) (dec y) y)
                  era (quot (if (>= y' 0) y' (- y' 399)) 400)
                  yoe (- y' (* era 400))
                  doy (+ (quot (+ (* 153 (+ m (if (> m 2) -3 9))) 2) 5) (dec d))
                  doe (+ (* yoe 365) (quot yoe 4) (- (quot yoe 100)) doy)]
              (+ (* era 146097) doe -719468)))]
    (- (->days to) (->days from))))

(defn stale?
  \"レジストリが today（ISO 文字列）時点で陳腐化しているか。\"
  [registry today]
  (let [limit (:staleness-days registry)
        at    (:verified-at registry)]
    (boolean (and limit at (> (days-between at today) limit)))))

(defn assert-fresh!
  \"陳腐化していたら例外。silent に古い原価で見積もらない。\"
  [registry today]
  (when (stale? registry today)
    (throw (ex-info \"price registry is stale\" {})))
  registry)"
  :interface
  "(ns prices-core
  (:schemas {:prices/span [:record :prices/span
                           [[:from-y :i64] [:from-m :i64] [:from-d :i64]
                            [:to-y :i64] [:to-m :i64] [:to-d :i64]]]
             :prices/staleness [:record :prices/staleness
                                [[:elapsed :i64] [:limit :i64]]]})
  (:export [civil-days days-between stale? epoch-shift]))

;; epoch-shift  []                          -> :i64  the 719468 constant, named
;; civil-days   [y :i64 m :i64 d :i64]      -> :i64  the inner ->days, minus the
;;                                                   string parsing
;; days-between [s [:ref :prices/span]]     -> :i64  from -> to, may be negative
;; stale?       [r [:ref :prices/staleness]] -> :bool the (> elapsed limit)
;;                                                   judgement only
;;
;; Splitting \"2026-08-11\" into three integers, reading the registry map, and
;; throwing all stay in Clojure. Nothing here throws."
  :battery
  "(defn test-shift [] :bool (= (epoch-shift) 719468))
(defn test-epoch [] :bool (= (civil-days 1970 1 1) 0))
(defn test-day-before-epoch [] :bool (= (civil-days 1969 12 31) -1))
(defn test-march-boundary-a [] :bool (= (civil-days 1970 2 28) 58))
(defn test-march-boundary-b [] :bool (= (civil-days 1970 3 1) 59))
(defn test-leap-400 [] :bool (= (civil-days 2000 2 29) 11016))
(defn test-leap-100 [] :bool (= (civil-days 1900 3 1) -25508))
(defn test-leap-ordinary [] :bool (= (civil-days 2024 2 29) 19782))
(defn test-pre-epoch-era [] :bool (= (civil-days 1600 1 1) -135140))
(defn test-between-fwd [] :bool
  (= (days-between (record-new [:ref :prices/span] 1970 1 1 2026 8 13)) 20678))
(defn test-between-back [] :bool
  (= (days-between (record-new [:ref :prices/span] 2026 8 13 1970 1 1)) -20678))
(defn test-between-zero [] :bool
  (= (days-between (record-new [:ref :prices/span] 2026 8 13 2026 8 13)) 0))
(defn test-stale-yes [] :bool
  (stale? (record-new [:ref :prices/staleness] 10 7)))
(defn test-stale-boundary [] :bool
  (not (stale? (record-new [:ref :prices/staleness] 7 7))))
(defn test-stale-no [] :bool
  (not (stale? (record-new [:ref :prices/staleness] 0 7))))"
  :want [[epoch-shift 0 :i64] [civil-days 3 :i64]
         [days-between 1 :i64] [stale? 1 :bool]]
  ;; Objective quality checks the correctness gates cannot see. Each is
  ;; [label max-occurrences-of-literal]; the reference itself is the calibration
  ;; (it names the constant once and calls it thereafter).
  :quality [["719468 duplicated instead of calling (epoch-shift)" "719468" 1]
            ["146097 duplicated" "146097" 1]]
  ;; Generated-code speed, not model speed: how long the compiled artifact takes
  ;; to answer, against the landed reference compiled the same way.
  :perf {:fn "civil-days" :args [2026 8 13] :iterations 200000}
  :mutation ["(> elapsed limit)" "(>= elapsed limit)"]}]
