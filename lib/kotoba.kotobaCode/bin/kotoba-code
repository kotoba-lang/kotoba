#!/usr/bin/env sh
set -eu

# Working operator start is compile + instantiateKotoba.
# There is no kotoba -M and no kbb -M / kbb -M start path.
#
# Replaces the former:
#   kbb -M:run  (kotoba-code.main, :jvm-opts --enable-native-access=ALL-UNNAMED)
# That wrapper is gone, not leftover-jvm-run-path exit 2.
# Do not wrap Datalevin/LMDB JNI as a C .so.
#
# Do not exec `kotoba run kotoba/main.kotoba` here. On Release CLI,
# source-run of this guest is kotoba/runtime-rejected (typed forms). That
# is the intended public command and a named CLI gap, not a working start.

SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR="$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  case "$TARGET" in
    /*) SOURCE="$TARGET" ;;
    *) SOURCE="$DIR/$TARGET" ;;
  esac
done

APP_DIR="$(CDPATH= cd -- "$(dirname -- "$SOURCE")/.." && pwd)"
cd "$APP_DIR"

if [ "$#" -gt 0 ]; then
  echo "working operator start is compile + instantiateKotoba." >&2
  echo "leftover subcommands are not dispatched from this wrapper." >&2
  echo "intended public command (CLI source-run gap until the CLI accepts this guest):" >&2
  echo "  kotoba run kotoba/main.kotoba" >&2
  echo "leftover JVM library (not start): kbb -M -m kotoba-code.main $*" >&2
fi

sh scripts/kotoba-compile.sh
exec sh scripts/kotoba-run.sh
