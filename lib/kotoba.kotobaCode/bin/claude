#!/usr/bin/env sh
set -eu

# Leftover compatibility name. Not operator start.
# Former `exec kbb -M:run` is gone, not leftover-jvm-run-path exit 2.
# Do not exec `kotoba run kotoba/main.kotoba` here: Release CLI source-run
# of typed forms is kotoba/runtime-rejected. That is the intended public
# command and a named CLI gap, not a working start.

SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR="$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  case "$TARGET" in
    /*) SOURCE="$TARGET" ;;
    *) SOURCE="$DIR/$TARGET" ;;
  esac
done

APP_DIR="$(CDPATH= cd -- "$(dirname -- "$SOURCE")/.." && pwd)"
cd "$APP_DIR"

echo "leftover compatibility name. Not operator start." >&2
echo "working operator start is compile + instantiateKotoba:" >&2
echo "  bin/kotoba-code" >&2
echo "  sh scripts/kotoba-compile.sh" >&2
echo "  sh scripts/kotoba-run.sh" >&2
echo "intended public command (CLI source-run gap until the CLI accepts this guest):" >&2
echo "  kotoba run kotoba/main.kotoba" >&2
echo "leftover JVM library (not start): kbb -M -m kotoba-code.main $*" >&2
exit 127
