;; No third-party dependencies. This library is a check-digit algorithm,
;; a code-shape validator, a plain data shape for the six-axis part model,
;; and a generic CSV reader for a licensee's own release file -- none of
;; that needs anything beyond the language itself, and this repo ships no
;; LOINC content for a dependency to carry.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
