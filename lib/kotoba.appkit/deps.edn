{:paths ["src"]
 ;; Desktop/dense-data platform binding on top of kotoba-ui.core — supplies
 ;; default option maps only (thick/regular surfaces, multi-pane conventions).
 ;; Owns no tokens/CSS/component logic; never modifies shitsuke/liquid-glass-ui/
 ;; kotoba-ui. See docs/adr/0001-appkit.md.
 :deps {
        io.github.kotoba-lang/process {:local/root "../kotoba.process"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/kotoba-ui {:local/root "../kotoba.kotobaUi"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :local {:override-deps {io.github.kotoba-lang/kotoba-ui {:local/root "../kotoba-ui"}}}}}
