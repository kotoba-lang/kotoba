{
  // NOTE: this app used to be built by SvelteKit's @sveltejs/adapter-cloudflare,
  // which emitted both a server-rendering Worker script (`main`, pointed at
  // the SvelteKit Cloudflare adapter build output) and a static client bundle
  // (`assets.directory`, the +page.svelte status page). The deployed XRPC
  // handler behind that build was svelte/src/routes/xrpc/[...path]/+server.ts
  // — moved (not deleted) to src/xrpc-proxy.ts, see that file's header.
  //
  // The frontend was migrated to a plain ClojureScript (shadow-cljs + reagent
  // + re-frame + jp-go-dds) static bundle with no server-rendering step — see
  // cljs/ and the repo README. `assets.directory` now points at the cljs
  // build output.
  //
  // Unlike some sibling migrations, `main` is NOT dropped here: src/app.ts
  // (this repo's production Worker facade) DOES call `env.ASSETS.fetch(req)`
  // as its fallback branch (see that file, the `if (env.ASSETS) return
  // env.ASSETS.fetch(req);` line), so it can keep serving both its own
  // `/health`, `/oauth/callback`, `/xrpc/com.etzhayyim.apps.gmail.*` routes
  // AND the static asset bundle. `main` is repointed at src/app.ts, which was
  // already the intended entry point per this repo's AGENTS.md/kotodama.jsonld
  // (`component.path: "src/app.ts"`) but was not wired into wrangler.jsonc
  // before this migration. src/xrpc-proxy.ts (the moved +server.ts) is NOT
  // wired as `main` — it duplicates a subset of src/app.ts's XRPC proxying
  // via a different upstream (AGENTGATEWAY_MCP_ROUTER_URL vs. DISPATCHER_URL)
  // and reviving/reconciling it is an open product decision, not made here.
  //
  // This edit is unverified: `wrangler deploy`/`wrangler dev` were not run
  // against it.
  "name": "kotodama-gm4il0x1",
  "main": "src/app.ts",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_CAPABILITIES": "[\"bpmn-dispatch\",\"oauth-redirect\",\"gmail-sync\",\"email-send\"]",
    "APP_DEPLOY_AT": "2026-04-17T01:27:35Z",
    "APP_DEPLOY_SHA": "0211475241f",
    "APP_DESCRIPTION": "Thin edge facade; Gmail sync, send, triage, and OAuth run in BPMN + Zeebe Python",
    "APP_DISPLAY_NAME": "Gmail Intelligence",
    "APP_EMBED_URL": "https://gm4il0x1.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "gm4il0x1",
    "APP_PERFORMER_TYPE": "service",
    "APP_SOURCE": "custom",
    "APP_TEMPLATE": "",
    "APP_UI_TYPE": "appview",
    "APP_VERSION": "0.1.0",
    "INTERFACES_REQUIRES": "[\"etzhayyim:collection/collection@1.0.0\"]",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "routes": [
    {
      "pattern": "gm4il0x1.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "gmail.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
