{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:gmail.etzhayyim.com",
  "name": "gmail",
  "nanoid": "gm4il0x1",
  "performerType": "service",
  "runtimeType": "worker",
  "sensitivity": "internal",
  "source": "custom",
  "version": "0.1.0",
  "build": {
    "guestLanguage": "ts",
    "role": "thin-edge"
  },
  "component": {
    "path": "src/app.ts"
  },
  "profile": {
    "displayName": "Gmail Intelligence",
    "description": "Thin edge facade; Gmail sync, send, triage, and OAuth run in AgentGateway MCP + pod-side LangServer",
    "isBot": true,
    "agentType": "autonomous",
    "operator": "etzhayyim.com",
    "capabilities": [
      "bpmn-dispatch",
      "oauth-redirect",
      "gmail-sync",
      "email-send"
    ]
  },
  "interfaces": {
    "package": "etzhayyim:gmail@1.0.0",
    "requires": [
      "etzhayyim:collection/collection@1.0.0"
    ]
  },
  "governance": {
    "raci": "responsible",
    "classification": "internal"
  },
  "convoSystemPrompt": "You are the Gmail Intelligence agent. You sync Gmail inboxes, create contact DIDs for each sender, perform AI email triage, and detect phishing emails (SPF/DKIM/DMARC analysis + URL heuristics). Phishing alerts are forwarded to malak for cybercrime intelligence. Respond helpfully in the user's language.",
  "duties": [
    "勤労の義務"
  ],
  "kpi": [
    "credits の獲得"
  ],
  "deploy": {},
  "routes": [
    {
      "host": "gmail.etzhayyim.com",
      "paths": ["/"],
      "tls": true
    }
  ],
  "space": {
    "name": "Gmail Intelligence",
    "joinRule": "public",
    "historyVisibility": "shared",
    "channels": [
      {
        "name": "inbox-feed",
        "kind": "public",
        "default": true
      },
      {
        "name": "phishing-alerts",
        "kind": "public"
      }
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.gmail.email",
        "com.etzhayyim.apps.gmail.thread",
        "com.etzhayyim.apps.gmail.syncJob",
        "com.etzhayyim.apps.gmail.triageResult",
        "com.etzhayyim.apps.gmail.accountBinding",
        "com.etzhayyim.apps.gmail.contactDid",
        "com.etzhayyim.apps.gmail.outboundEmail",
        "com.etzhayyim.apps.gmail.labelAction",
        "com.etzhayyim.apps.gmail.phishingAlert",
        "com.etzhayyim.apps.gmail.dailyEvolution",
        "com.etzhayyim.apps.gmail.engagement",
        "com.etzhayyim.apps.gmail.newFollower"
      ]
    }
  },
  "ui": {
    "accent": "#c71610",
    "icon": "📧",
    "ssrRoutes": {
      "apps": "etzhayyim.gmail.v1.GmailService/gmail.tools",
      "live": "etzhayyim.gmail.v1.GmailService/gmail.dashboard"
    }
  },
  "uiType": "appview"
}
