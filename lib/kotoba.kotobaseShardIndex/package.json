{
  "name": "kotobase-shard-index",
  "version": "0.1.0",
  "private": true,
  "description": "A search index a client reads directly out of an object store — no query server, no database to hydrate, no cache tier.",
  "license": "Apache-2.0",
  "scripts": {
    "test": "kbb --backend sci --classpath src test/run_tests.cljk",
    "mutations": "kbb --backend sci --classpath src test/mutations.cljk",
    "budget": "kbb --backend sci --classpath src bench/check_budget.cljk",
    "budget:write": "kbb --backend sci --classpath src bench/check_budget.cljk --write",
    "bench:gets": "kbb --backend sci --classpath src bench/get_scaling.cljk",
    "bench:route": "kbb --backend sci --classpath src bench/route_scaling.cljk",
    "bench:incremental": "kbb --backend sci --classpath src:bench bench/incremental.cljk"
  },
  "devDependencies": {
    "nbb": "1.4.208"
  }
}
