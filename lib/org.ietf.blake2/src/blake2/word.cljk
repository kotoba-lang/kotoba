(ns blake2.word
  "64-bit words, on two runtimes that disagree about whether those exist.

  This is the one file in this library that knows which runtime it is on —
  the same containment `storj.node.bytes` uses. Everything above it
  (`blake2.core`) is a single code path.

  BLAKE2b is defined over 64-bit unsigned words with wrapping addition. The
  JVM has exactly that in `long` (as a bit pattern — Clojure's `long` is
  signed, but two's-complement addition, xor and rotation don't care).
  JavaScript has nothing of the kind: `Number` loses integer exactness past
  2^53 and every bitwise operator truncates to *32* bits, so the obvious
  translation is silently wrong rather than slow. `BigInt` is the only
  primitive on that side with the right semantics, so that is what a word is
  under ClojureScript, wrapped back to 64 bits with `BigInt.asUintN` after
  every operation that can overflow.

  The cost is real: BigInt allocates, and a compression round does 96 of
  these. For the inputs this library exists to serve — Filecoin addresses
  (≤65 bytes) and block CIDs — that is irrelevant. Hashing a large file on
  the JavaScript side would not be.

  A word is therefore an opaque value: a `long` on :clj, a `BigInt` on
  :cljs. Do not compare words across platforms, and do not let one escape
  this library's public API."
  (:refer-clojure :exclude [zero?]))

#?(:clj
   (do
     (defn hex
       "Parse 16 hex digits into a word. The BLAKE2b IV constants exceed
       Long/MAX_VALUE, and Clojure's reader rejects those as literals — this
       is how they get written down without hand-computing a negative."
       ^long [^String s]
       (.longValue (java.math.BigInteger. s 16)))

     (def all-ones (hex "ffffffffffffffff"))

     (defn of-count
       "A byte count (a plain integer) as a word."
       ^long [n] (long n))

     (defn w+ ^long [^long a ^long b] (unchecked-add a b))
     (defn wxor ^long [^long a ^long b] (bit-xor a b))

     (defn rotr
       "Rotate right by n (0 < n < 64). Uses the *unsigned* shift: an
       arithmetic `>>` would smear the sign bit into the top of the result."
       ^long [^long x n]
       (bit-or (unsigned-bit-shift-right x (int n))
               (bit-shift-left x (int (- 64 n)))))

     (defn le->word
       "8 bytes at `off` (little-endian) as a word. `bs` is a vector of ints."
       ^long [bs off]
       (loop [i 7 acc 0]
         (if (neg? i)
           acc
           (recur (dec i) (bit-or (bit-shift-left acc 8)
                                  (long (bit-and (int (nth bs (+ off i))) 0xff)))))))

     (defn word->le
       "A word as 8 ints, little-endian."
       [^long x]
       (mapv #(int (bit-and (unsigned-bit-shift-right x (int (* 8 %))) 0xff)) (range 8))))

   :cljs
   (do
     (defn- u64 [x] (js/BigInt.asUintN 64 x))

     (defn hex [s] (js/BigInt (str "0x" s)))

     (def all-ones (hex "ffffffffffffffff"))

     (defn of-count [n] (js/BigInt n))

     (defn w+ [a b] (u64 (+ a b)))
     (defn wxor [a b] (bit-xor a b))

     (defn rotr [x n]
       (let [n (js/BigInt n)]
         (u64 (bit-or (bit-shift-right x n)
                      (bit-shift-left x (- (js/BigInt 64) n))))))

     (defn le->word [bs off]
       (loop [i 7 acc (js/BigInt 0)]
         (if (neg? i)
           acc
           (recur (dec i)
                  (bit-or (bit-shift-left acc (js/BigInt 8))
                          (js/BigInt (bit-and (nth bs (+ off i)) 0xff)))))))

     (defn word->le [x]
       (mapv #(js/Number (bit-and (bit-shift-right x (js/BigInt (* 8 %)))
                                  (js/BigInt 0xff)))
             (range 8)))))
