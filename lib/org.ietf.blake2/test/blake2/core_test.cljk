(ns blake2.core-test
  (:require [kotoba.test :refer [deftest is testing]]
            [blake2.core :as blake2]
            [blake2.vectors :as v]))

;; ── hex, locally ─────────────────────────────────────────────────────────────
;; This library has no dependencies, so the tests can't borrow
;; `multiformats.core/hexify`. Small enough to carry.

(defn- unhex [s]
  (mapv (fn [[a b]] #?(:clj (Integer/parseInt (str a b) 16)
                       :cljs (js/parseInt (str a b) 16)))
        (partition 2 s)))

(defn- hexify [bs]
  (apply str (map (fn [b]
                    (let [v (bit-and (int b) 0xff)
                          h #?(:clj (Integer/toHexString v)
                               :cljs (.toString v 16))]
                      (if (= 1 (count h)) (str "0" h) h)))
                  (seq bs))))

;; ── the two values that are not this workspace's to choose ───────────────────
;; Pinned by hand, from the documents rather than from the generator: RFC 7693
;; §A.1, and entry 0 of the BLAKE2 reference `blake2b-kat.json`. If CPython's
;; hashlib ever regressed, `gen_vectors.py` would move every other assertion
;; in this file in lockstep and nothing would fail. These two would.

(def ^:private rfc7693-abc
  (str "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d1"
       "7d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923"))

(def ^:private kat-keyed-empty
  (str "10ebb67700b1868efb4417987acf4690ae9d972fb7a590c2f02871799aaa4786"
       "b5e996e8f0f4eb981fc214b005f42d2ff4233499391653df7aefcbc13fc51568"))

(deftest published-vectors
  (testing "RFC 7693 §A.1 — BLAKE2b-512(\"abc\")"
    (is (= rfc7693-abc (hexify (blake2/blake2b (blake2/utf8 "abc"))))))

  (testing "BLAKE2 reference KAT entry 0 — keyed, empty input"
    (is (= kat-keyed-empty
           (hexify (blake2/blake2b [] {:key (vec (range 64))}))))))

;; ── the generated table ──────────────────────────────────────────────────────

(deftest generated-vectors
  (doseq [{:keys [name input key digest-size digest]} v/vectors]
    (testing name
      (is (= digest
             (hexify (blake2/blake2b (unhex input)
                                     (cond-> {:digest-size digest-size}
                                       key (assoc :key (unhex key))))))))))

;; ── shapes and refusals ──────────────────────────────────────────────────────

(deftest accepts-every-byte-shape
  (testing "byte-array / Uint8Array, a vector of ints, and a lazy seq agree"
    (let [expected (hexify (blake2/blake2b (blake2/utf8 "abc")))]
      (is (= expected (hexify (blake2/blake2b [0x61 0x62 0x63]))))
      (is (= expected (hexify (blake2/blake2b (map identity [0x61 0x62 0x63])))))))
  (testing "and a byte with the high bit set survives the round trip"
    ;; On the JVM a byte is signed: 0xff arrives as -1, and an implementation
    ;; that forgets to mask hashes a different value than the one passed in.
    (is (= (hexify (blake2/blake2b [0xff 0x80 0x7f]))
           (hexify (blake2/blake2b #?(:clj (byte-array [(unchecked-byte 0xff)
                                                        (unchecked-byte 0x80)
                                                        0x7f])
                                      :cljs (js/Uint8Array. #js [0xff 0x80 0x7f]))))))))

(deftest digest-length-is-checked
  (is (thrown? #?(:clj Exception :cljs js/Error)
               (blake2/blake2b [] {:digest-size 0})))
  (is (thrown? #?(:clj Exception :cljs js/Error)
               (blake2/blake2b [] {:digest-size 65})))
  (is (thrown? #?(:clj Exception :cljs js/Error)
               (blake2/blake2b [] {:key (vec (range 65))}))))

(deftest digest-size-is-not-truncation
  (testing "a shorter digest is a different hash, not a prefix of the long one"
    ;; The digest length goes into the parameter block, so BLAKE2b-256 is not
    ;; the first 32 bytes of BLAKE2b-512. Getting this wrong produces a
    ;; library that looks right until it has to match someone else's output.
    (let [d64 (hexify (blake2/blake2b (blake2/utf8 "abc")))
          d32 (hexify (blake2/blake2b (blake2/utf8 "abc") {:digest-size 32}))]
      (is (not= d32 (subs d64 0 64))))))

(deftest blake2b-256-is-the-shorthand
  (is (= (hexify (blake2/blake2b (blake2/utf8 "abc") {:digest-size 32}))
         (hexify (blake2/blake2b-256 (blake2/utf8 "abc"))))))
