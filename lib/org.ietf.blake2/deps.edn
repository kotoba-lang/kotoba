;; No dependencies, and that is the point: this is a leaf. Both `io-filecoin`
;; and `io-filecoin-node` need BLAKE2b, so it cannot sit inside either of
;; them, and it must not drag a crypto stack behind it that would pin it to
;; one runtime.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test" "testdata"]}
  ;; classpath only, no :main-opts — `kbb -A:cljs -Spath` resolves deps
  ;; for nbb without the deprecation warning `-A` prints when the alias
  ;; carries a main.
  :cljs {:extra-paths ["test" "testdata"]}
}}
