#!/usr/bin/env kbb
;; Run the suite on the ClojureScript side.
;;
;; Not a formality, and not redundant with the JVM job: the two runtimes run
;; *different arithmetic* here. A word is a `long` on the JVM and a `BigInt`
;; under ClojureScript (see `blake2.word`), so every add, xor and rotation in
;; the compression function is a different operation on this path. A green
;; JVM run says nothing about whether `BigInt.asUintN` was applied in the
;; right places.
;;
;;   kbb --backend sci --classpath "$(kbb -A:cljs -Spath)" scripts/verify-cljs.cljk
(ns verify-cljs
  (:require [kotoba.test :as t]
            [blake2.core-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println)
  (if (t/successful? m)
    (println "all checks passed on the ClojureScript path")
    (do (println "FAILED on the ClojureScript path")
        (js/process.exit 1))))

(t/run-tests 'blake2.core-test)
