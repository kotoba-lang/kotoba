{:paths ["src"]
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/process {:local/root "../kotoba.process"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; kotoba-lang/amu is a TEST-ONLY dependency: it is needed by the tests
         ;; that compile src/annotation/core.kotoba and compare it with
         ;; src/annotation/core.cljk (ADR 0001 as amended, and ADR-2608134800 in
         ;; com-junkawasaki/root). Consumers require only the .cljc and must not be
         ;; made to drag the compiler in behind it — kotoba-lang/css, /dsl-core,
         ;; /async and /postfx set the same boundary.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/amu
                      {:git/sha "c3be07fb38bf457a159a2b304152e18693f9b0b6"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
