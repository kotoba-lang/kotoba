;; kotoba-lang/host — browser game host surface (ADR-2607102200 addendum 8):
;;   kami.host  — WASM/ECS import object for compiled games
;;   kami.input — keyboard/gamepad → axes
;;   kami.ui    — DOM HUD widgets
;;   kami.audio — Web Audio synth bank
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/physics {:local/root "../kotoba.physics"}
        io.github.kotoba-lang/physics-2d {:local/root "../kotoba.physics2d"}
        io.github.kotoba-lang/kami-engine-sdk {:local/root "../kotoba.kamiEngineSdk"}}
 :override-deps {io.github.kotoba-lang/physics {:git/url "https://github.com/kotoba-lang/physics.git"
         :git/sha "5fbd5979dfe6a0be92c43c439e41878b9ef5f9c8"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
