{:paths ["src"]
 ;; Zero third-party runtime deps — every namespace is portable .cljc (JVM, CLJS, SCI).
 ;; JSON I/O has a built-in bidirectional converter; a host may instead parse JSON
 ;; with its own library and feed the resulting string-keyed map into openapi.json/from-data.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
