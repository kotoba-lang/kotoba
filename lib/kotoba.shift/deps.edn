{:paths ["src"]
 ;; Deliberately dependency-free. `->timesheet-entries` emits the `:ts/*`
 ;; shape `kotoba.labor/timesheet` uses, so the two compose without either
 ;; depending on the other — and a capture agent embedding this library
 ;; pulls in no wage/payroll code it has no business holding.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
