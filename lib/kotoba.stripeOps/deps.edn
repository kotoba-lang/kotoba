{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep, all .cljc
 ;; -> portable to JVM / SCI / ClojureScript / GraalVM). Same runtime
 ;; koyomi/shoko/tosmonitor ride on; a Stripe ops actor is just another
 ;; sealed-intelligence ⊣ independent-governor StateGraph.
 :deps {
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/langgraph {:local/root "../kotoba.langgraph"}}
 :aliases
 {;; offline workspace dev — pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain {:local/root "../langchain"}}}
  :test {:extra-paths ["test"]}}}
