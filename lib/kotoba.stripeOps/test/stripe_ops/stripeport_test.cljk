(ns stripe-ops.stripeport-test
  "mock-stripeport's idempotency behavior, and live-stripeport's REQUEST-
  BUILDING only -- no live Stripe call anywhere here, mirroring
  koyomi.scheduleport-test's slack-scheduleport tests (an injected fake
  :http-fn captures the request map; the real java.net.http default is
  never exercised in this suite)."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.text :as str]
            [stripe-ops.stripeport :as sp]))

(deftest mock-lookup-reads-demo-fixtures
  (let [port (sp/mock-stripeport)]
    (is (= "Alice Example" (:name (sp/get-customer port "cus_demo_alice"))))
    (is (nil? (sp/get-customer port "cus_missing")))
    (is (= 80000 (:unit_amount (sp/get-price port "price_demo_isic6399_managed_starter"))))))

(deftest mock-create-payment-link-is-idempotent
  (let [created (atom {}) id-seq (atom 0)
        port (sp/mock-stripeport created id-seq)
        r1 (sp/create-payment-link! port "price_demo_isic6399_managed_starter"
             {:idempotency-key "k1" :metadata {:lead "acme"}})
        r2 (sp/create-payment-link! port "price_demo_isic6399_managed_starter"
             {:idempotency-key "k1" :metadata {:lead "acme"}})
        r3 (sp/create-payment-link! port "price_demo_isic6399_managed_starter"
             {:idempotency-key "k2" :metadata {}})]
    (is (= (:id r1) (:id r2)) "same idempotency-key -> same record, never a second link")
    (is (not= (:id r1) (:id r3)) "different idempotency-key -> a distinct link")
    (is (= 2 (count @created)))
    (is (= 1 (:quantity r1)))))

;; ───────────────────────── live-stripeport — request-building only ─────────────────────────

(defn- capturing-http-fn [captured]
  (fn [req] (reset! captured req) {:status 200 :body "{\"id\":\"plink_live_1\",\"url\":\"https://buy.stripe.com/x\"}"}))

(deftest live-get-customer-builds-authenticated-get
  (let [captured (atom nil)
        port (sp/live-stripeport {:api-key "rk_test_demo" :http-fn (capturing-http-fn captured)})]
    (sp/get-customer port "cus_123")
    (is (= :get (:method @captured)))
    (is (str/includes? (:url @captured) "/customers/cus_123"))
    (is (= "Bearer rk_test_demo" (get (:headers @captured) "Authorization")))))

(deftest live-create-payment-link-sends-idempotency-key-as-header-not-body
  (let [captured (atom nil)
        port (sp/live-stripeport {:api-key "rk_test_demo" :http-fn (capturing-http-fn captured)})
        result (sp/create-payment-link! port "price_abc" {:idempotency-key "lead-1" :metadata {:lead "acme"}})]
    (is (= :post (:method @captured)))
    (is (str/includes? (:url @captured) "/payment_links"))
    (is (= "lead-1" (get (:headers @captured) "Idempotency-Key"))
        "Stripe's own dedup mechanism is the Idempotency-Key REQUEST HEADER, not a body field")
    (is (not (str/includes? (:body @captured) "idempotency"))
        "the idempotency key must never also be duplicated into the form body")
    (is (str/includes? (:body @captured) "line_items%5B0%5D%5Bprice%5D=price_abc"))
    (is (str/includes? (:body @captured) "line_items%5B0%5D%5Bquantity%5D=1"))
    (is (= "plink_live_1" (:id result)))
    (is (= "https://buy.stripe.com/x" (:url result)))
    (is (= 1 (:quantity result)))))

(deftest live-create-payment-link-never-accepts-a-custom-amount-argument
  (testing "the fn's own argument list has no amount/unit-amount slot at all --
            structural defense-in-depth on top of the governor's own check"
    (let [captured (atom nil)
          port (sp/live-stripeport {:api-key "rk_test_demo" :http-fn (capturing-http-fn captured)})]
      (sp/create-payment-link! port "price_abc" {:idempotency-key "k" :metadata {} :unit-amount 1})
      (is (not (str/includes? (:body @captured) "amount"))
          "an :unit-amount key in opts is silently ignored -- create-payment-link! only ever
           destructures :idempotency-key/:metadata, never a caller-supplied amount"))))
