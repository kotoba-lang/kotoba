(ns stripe-ops.store-contract-test
  "Store contract against both backends -- proving MemStore ≡ DatomicStore
  makes 'swap the SSoT for Datomic / kotoba-server' a config change, not a
  rewrite (koyomi.store-contract-test's own charter, applied here)."
  (:require [kotoba.test :refer [deftest is testing]]
            [stripe-ops.store :as store]
            [langchain.db :as db]))

(defn- backends [] [["MemStore" (store/seed-db)] ["DatomicStore" (store/datomic-seed-db)]])

(deftest read-parity
  (doseq [[label s] (backends)]
    (testing label
      (is (= "Managed Job Board (Starter)"
             (:product-name (store/known-price s "price_demo_isic6399_managed_starter"))))
      (is (= "cloud-itonami-isic-6310"
             (:vertical (store/known-price s "price_demo_isic6310_managed_starter"))))
      (is (nil? (store/known-price s "price_does_not_exist")))
      (is (= 3 (count (store/all-known-prices s))))
      (is (nil? (store/payment-link s "plink_missing"))))))

(deftest write-and-ledger-parity
  (doseq [[label s] (backends)]
    (testing label
      (store/record-datom! s {:kind :payment-link :id "plink_1"
                              :value {:id "plink_1" :url "https://x" :price-id "price_demo_isic6399_managed_starter"
                                      :quantity 1 :idempotency-key "k1" :metadata {}}})
      (is (= "https://x" (:url (store/payment-link s "plink_1"))))
      (store/record-datom! s {:kind :payment-link :id "plink_1" :value {:metadata {:lead "acme"}}})
      (is (= {:lead "acme"} (:metadata (store/payment-link s "plink_1"))) "merge updates metadata")
      (is (= "https://x" (:url (store/payment-link s "plink_1"))) "merge preserves other fields")
      (store/append-ledger! s {:op :a :disposition :record})
      (store/append-ledger! s {:op :b :disposition :commit})
      (is (= [:record :commit] (mapv :disposition (store/ledger s)))))))

(deftest datomic-empty-store-usable
  (let [s (store/datomic-store)]
    (is (nil? (store/known-price s "nope")))
    (is (= [] (store/all-known-prices s)))
    (store/record-datom! s {:kind :known-price :id "price_x"
                            :value {:price-id "price_x" :product-name "X" :vertical "v"}})
    (is (= "X" (:product-name (store/known-price s "price_x"))))))

(deftest datomic-ledger-append-does-not-lose-a-fact-when-two-writers-race
  (testing "two append-ledger! callers who both read the same `(count (ledger s))` before
            either transacts must NOT collide -- verified against real langchain.db
            transact! semantics, mirroring koyomi.store-contract-test's own race test"
    (let [s (store/datomic-store)
          n1 (count (store/ledger s))
          n2 (count (store/ledger s))]
      (is (= 0 n1 n2))
      ((:transact! db/api) (:conn s) [{:ledger/fact (pr-str {:op :writer-A :disposition :commit})}])
      ((:transact! db/api) (:conn s) [{:ledger/fact (pr-str {:op :writer-B :disposition :commit})}])
      (is (= 2 (count (store/ledger s))) "both facts survive -- neither writer's append is lost"))))
