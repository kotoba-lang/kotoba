(ns stripe-ops.model
  "Unified data shapes stripe-ops carries across the lookup/payment-link-create
  flow. This actor does NOT reimplement Stripe's own object model (customer/
  subscription/product/price) -- those are read verbatim (as plain EDN maps
  shaped like Stripe's own REST JSON) from `stripe-ops.stripeport`. The only
  shapes this actor owns are its own control-plane records:

    known-price   -- a whitelist entry this actor is allowed to create NEW
                     Payment Links against: price-id, product-name, vertical
                     (which cloud-itonami flagship repo it belongs to). This
                     whitelist is the HARD boundary stripe-ops.governor
                     enforces -- payment-link-create can reference ONLY a
                     price-id already in this catalog, never an arbitrary one
                     a proposal invents.
    payment-link  -- the durable record of a Payment Link this actor actually
                     created: id, url, price-id, quantity (always 1), metadata,
                     idempotency-key (so a retried request is verifiably a
                     no-op, never a second live Payment Link)."
  )

(defn known-price
  ([price-id product-name vertical] (known-price price-id product-name vertical {}))
  ([price-id product-name vertical attrs]
   (merge {:price-id price-id :product-name product-name :vertical vertical} attrs)))

(defn payment-link
  ([id url price-id idempotency-key] (payment-link id url price-id idempotency-key {}))
  ([id url price-id idempotency-key attrs]
   (merge {:id id :url url :price-id price-id :quantity 1
           :idempotency-key idempotency-key :metadata {}}
          attrs)))
