(ns stripe-ops.phase
  "Phase 0->3 staged rollout, gating only :stripe/lookup's autonomy.
  :stripe/payment-link-create is NEVER in any phase's :auto set -- it is
  this actor's only actuation, and the governor's high-stakes flag already
  forces it to always escalate regardless; phase and governor agree by
  construction (same invariant koyomi/tosmonitor establish for their own
  single actuation).

    0 disabled    -- neither op is even assessed (shadow mode).
    1 assisted    -- both ops assessed, but always human even for a clean
                     lookup.
    2 lookup-auto -- a clean+confident lookup may auto-commit (it has no
                     external write effect); payment-link-create stays human.
    3 supervised  -- same autonomy as 2; payment-link-create remains
                     high-stakes and ALWAYS routes to a human regardless of
                     phase."
  )

(def assess-ops #{:stripe/lookup :stripe/payment-link-create})

(def phases
  {0 {:label "disabled"    :assess #{}        :auto #{}}
   1 {:label "assisted"    :assess assess-ops :auto #{}}
   2 {:label "lookup-auto" :assess assess-ops :auto #{:stripe/lookup}}
   3 {:label "supervised"  :assess assess-ops :auto #{:stripe/lookup}}})

(def default-phase
  "The phase used when `context` carries no :phase at all, AND the fallback
  `gate` itself uses for an unrecognized phase number. This must be the
  MOST CONSERVATIVE phase, never the most permissive (repo-wide fixed-bug
  convention -- see koyomi.phase/tosmonitor.phase's own docstrings for the
  incident this pattern already caused elsewhere in this fleet before being
  fixed everywhere). 1 (assisted): a caller who forgets :phase still gets a
  human in the loop for everything, never silent autonomy."
  1)

(defn gate
  "Adjust an assess op's governor disposition for the rollout phase.
  Returns {:disposition kw :reason kw|nil}."
  [phase {:keys [op]} disposition]
  (let [{:keys [assess auto]} (get phases phase (get phases default-phase))]
    (cond
      (= :hold disposition)          {:disposition :hold :reason nil}
      (not (contains? assess op))    {:disposition :hold :reason :phase-disabled}
      (and (= :commit disposition)
           (not (contains? auto op))) {:disposition :escalate :reason :phase-approval}
      :else                          {:disposition disposition :reason nil})))

(defn verdict->disposition [v]
  (cond (:hard? v) :hold (:escalate? v) :escalate :else :commit))
