(ns kotoba.lsp.offset-to-position-test (:export [main]) (:require [kotoba.lsp.offset-to-position :as p]))

(defn- fld [d :document k :keyword] :i64
  (option-or (document-i64-value (option-or (document-get d k) (document-null))) -1))

(defn- doc [starts :document] :document (document-map :line-starts starts))

(defn- at [doc :document offset :i64 line :i64 ch :i64] :i64
  (let [r (p/offset->position doc offset)]
    (if (and (= (fld r :line) line) (= (fld r :character) ch)) 0 1)))

(defn main [] :i64
  (let [d (doc (document-vector (document-i64 0) (document-i64 5) (document-i64 10)))
        empty (document-map)]
    (+ (at d 0 0 0) (at d 4 0 4) (at d 5 1 0) (at d 9 1 4) (at d 12 2 2)
       (at empty 3 0 3))))
