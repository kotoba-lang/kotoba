(ns kotoba.lsp.position-test (:export [main]) (:require [kotoba.lsp.position :as p]))

(defn- iget [d :document k :keyword] :i64
  (option-value-of [:option :i64] (document-i64-value (option-or (document-get d k) (document-null))) -1))

(defn main [] :i64
  (let [q (p/position (document-i64 3) (document-i64 7))]
    (+ (if (= (iget q :line) 3) 0 1)
       (if (= (iget q :character) 7) 0 1)
       (if (= (document-count q) 2) 0 1))))
