(ns kotoba.lsp.pos-gte-test (:export [main]) (:require [kotoba.lsp.pos-gte :as p]))

(defn pos [line :i64 ch :i64] :document
  (document-map :line (document-i64 line) :character (document-i64 ch)))

(defn main [] :i64
  (+ (if (p/pos>= (pos 1 5) (pos 1 3)) 0 1)
     (if (p/pos>= (pos 1 3) (pos 1 5)) 1 0)
     (if (p/pos>= (pos 2 0) (pos 1 9)) 0 1)
     (if (p/pos>= (pos 1 9) (pos 2 0)) 1 0)
     (if (p/pos>= (pos 1 3) (pos 1 3)) 0 1)
     (if (p/pos>= (document-map) (document-map)) 0 1)))
