(ns kotoba.lsp.position-to-offset "Compatibility definition derived from the Apache-2.0 licensed kotoba-lang/lsp owner; see derivations.json.")

(defn position->offset "Convert a position to a character offset in the source." [doc pos] (let [line (:line pos) starts (:line-starts doc)] (if (>= line (count starts)) (count (:source doc)) (let [line-start (nth starts line)] (min (+ line-start (:character pos)) (count (:source doc)))))))
