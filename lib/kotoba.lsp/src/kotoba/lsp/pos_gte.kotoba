;; Port of kotoba.lsp.pos-gte (pos_gte.cljk), Kotoba-native, :document positions.
;;
;; A position is a :document map {:line i64 :character i64}. pos>= returns
;; true when a is at or after b (line first, then character).
;;
;; Named divergences from pos_gte.cljk:
;;   - a missing or non-integer :line / :character reads as 0. The source
;;     compares nil and throws; Kotoba has no nil comparison.
;;   - the function name pos>= is kept as written in the source.

(ns kotoba.lsp.pos-gte
  (:export [pos>=]))

(defn- field-i64 [d :document k :keyword] :i64
  (option-or (document-i64-value (option-or (document-get d k) (document-null))) 0))

(defn pos>= [a :document b :document] :bool
  (let [la (field-i64 a :line)
        lb (field-i64 b :line)]
    (or (> la lb)
        (and (= la lb) (>= (field-i64 a :character) (field-i64 b :character))))))
