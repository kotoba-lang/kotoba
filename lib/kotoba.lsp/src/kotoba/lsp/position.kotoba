;; Port of kotoba.lsp.position (position.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from position.cljk:
;;   - line and character are :document values (kept as given), since the
;;     source takes any value.

(ns kotoba.lsp.position
  (:export [position]))

(defn position [line :document character :document] :document
  (document-map :line line :character character))
