(ns kotoba.lsp.pos-gte "Compatibility definition derived from the Apache-2.0 licensed kotoba-lang/lsp owner; see derivations.json.")

(defn pos>= [a b] (or (> (:line a) (:line b)) (and (= (:line a) (:line b)) (>= (:character a) (:character b)))))
