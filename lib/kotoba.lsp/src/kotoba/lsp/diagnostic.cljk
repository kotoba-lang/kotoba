(ns kotoba.lsp.diagnostic "Compatibility definition derived from the Apache-2.0 licensed kotoba-lang/lsp owner; see derivations.json." (:require [kotoba.lsp.severities :refer [severities]]))

(defn diagnostic "Construct a diagnostic. `severity` is one of #{:error :warning :information :hint}." [r severity source message] (when-not (contains? severities severity) (throw (ex-info "lsp/diagnostic: invalid severity" {:severity severity}))) {:range r, :severity severity, :source source, :message message})
