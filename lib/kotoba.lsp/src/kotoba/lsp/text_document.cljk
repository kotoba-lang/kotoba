(ns kotoba.lsp.text-document "Compatibility definition derived from the Apache-2.0 licensed kotoba-lang/lsp owner; see derivations.json." (:require [kotoba.lang.text :as str]))

(defn text-document "Build a line-indexed document from `source`. Returns a map with `:source`\n  and `:line-starts` (a vector of the char-offset at which each line begins).\n  Trailing newlines do not create a phantom line (matches editor behavior)." [source] (let [lines (if (str/ends-with? source "\n") (drop-last (str/split-lines source)) (str/split-lines source))] {:source source, :line-count (count lines), :line-starts (loop [i 0 acc [0]] (if (>= i (dec (count lines))) (vec acc) (recur (inc i) (conj acc (+ (peek acc) (count (nth lines i)) 1)))))}))
