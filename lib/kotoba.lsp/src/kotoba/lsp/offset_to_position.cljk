(ns kotoba.lsp.offset-to-position "Compatibility definition derived from the Apache-2.0 licensed kotoba-lang/lsp owner; see derivations.json.")

(defn offset->position "Convert a character offset to a position." [doc offset] (let [starts (:line-starts doc) line (loop [l 0] (if (and (< (inc l) (count starts)) (<= (nth starts (inc l)) offset)) (recur (inc l)) l))] {:line line, :character (- offset (nth starts line))}))
