(ns kotoba.lsp.diagnostics-by-severity "Compatibility definition derived from the Apache-2.0 licensed kotoba-lang/lsp owner; see derivations.json." (:require [kotoba.lsp.severity-rank :refer [severity-rank]]))

(defn diagnostics-by-severity "Sort diagnostics most-severe first." [diags] (sort-by (fn* [%1#] (get severity-rank (:severity %1#))) diags))
