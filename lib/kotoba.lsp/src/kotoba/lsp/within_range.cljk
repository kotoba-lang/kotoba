(ns kotoba.lsp.within-range "Compatibility definition derived from the Apache-2.0 licensed kotoba-lang/lsp owner; see derivations.json." (:require [kotoba.lsp.pos-gte :refer [pos>=]] [kotoba.lsp.pos-lt :refer [pos<]]))

(defn within-range? "True iff `pos` lies within `r` (inclusive start, exclusive end, LSP style)." [r pos] (let [s (:start r) e (:end r)] (and (pos>= pos s) (pos< pos e))))
