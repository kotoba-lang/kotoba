;; Port of kotoba.lsp.offset-to-position (offset_to_position.cljk), Kotoba-native.
;;
;; doc is a :document map with :line-starts, a :document vector of i64 offsets
;; (the start offset of each line, ascending). offset->position returns the
;; :document map {:line i64 :character i64} for a character offset.
;;
;; Named divergences from offset_to_position.cljk:
;;   - a missing :line-starts reads as an empty vector (line 0, character =
;;     offset); the source throws on nil.
;;   - a missing or non-integer line start reads as 0.
;;   - the public name offset->position is kept; its result is a :document map.

(ns kotoba.lsp.offset-to-position
  (:export [offset->position]))

(defn- item-i64 [v :document i :i64] :i64
  (option-or (document-i64-value (option-or (document-vector-at v i) (document-null))) 0))

(defn offset->position [doc :document offset :i64] :document
  (let [starts (option-or (document-get doc :line-starts) (document-vector))
        n (document-count starts)
        line (loop [l 0]
               (if (and (< (+ l 1) n) (<= (item-i64 starts (+ l 1)) offset))
                 (recur (+ l 1))
                 l))]
    (document-map :line (document-i64 line)
                  :character (document-i64 (- offset (item-i64 starts line))))))
