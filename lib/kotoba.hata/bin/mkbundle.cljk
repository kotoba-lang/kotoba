(ns mkbundle
  "publish 前の準備を、DNS が無くても完了させておく: 本物の itonami-hello
  bundle（CAR）を実 digest で組み立て、app の鍵対（did:key + IPNS name）を
  作る。bytes 面が戻れば、ここから先は publish（content-address の
  publish_catalog 経路）→ bin/open_bundle.cljk の 2 コマンド。

    kbb --backend sci --classpath src:test:<codec paths> bin/mkbundle.cljk

  何を測るか: CAR の実バイト・root CID・鍵対の導出（did:key ↔ IPNS name）。
  何を測らないか: publish と fetch（bytes 面 DNS 不通）。"
  (:require ["node:crypto" :as crypto]
            ["node:fs" :as fs]
            [hata.didkey :as didkey]
            [hata.rebuild-test :as fx]
            [ipld.car.v2 :as car]
            [ipld.core :as ipld]))

(def ^:private out-dir "/Users/junkawasaki/.hermes/cache/scratch/hata-bundle")

(defn- exit! [code] (.exit js/process code))

(defn- sha256-hex [bytes]
  (-> (.createHash crypto "sha256") (.update bytes) (.digest "hex")))

(defn- app-keypair!
  "新しい ed25519 鍵対。公開鍵 32 bytes（JWK x を base64url で）と、
  その鍵で署名できる secret は生成元に残す（publish で IPNS record を署名
  するときに使う）。"
  []
  (let [{:keys [publicKey privateKey]} (js->clj (.generateKeyPairSync crypto "ed25519")
                                                :keywordize-keys true)
        jwk (.export publicKey #js {:format "jwk"})
        x (.-x jwk)
        raw (js/Uint8Array.from (.from js/Buffer x "base64url"))]
    {:pubkey (vec raw)
     :private-key privateKey
     :jwk-x x}))

(defn -main [& _]
  (let [{:keys [pubkey private-key jwk-x]} (app-keypair!)
        did (didkey/pubkey->did-key pubkey)
        name (didkey/did-key->ipns-name did)
        ;; manifest は実 DID で組み直す（fixture の did:key:z6MkApp は置き換える）
        manifest-block (ipld/node->block
                        {"kotoba.app/id" "itonami-hello"
                         "kotoba.app/kind" "app"
                         "kotoba.app/did" did
                         "kotoba.app/roles" [{"role" "hello"
                                              "mon" (:cid fx/mon-block)
                                              "logic" [(:cid fx/logic-block)]
                                              "clone-limit" 0}]
                         "kotoba.app/ui" {"bundle" (:cid fx/ui-block)
                                          "entry" "index.html"}})
        blocks [fx/mon-block fx/logic-block fx/ui-block manifest-block]
        packed (car/pack {:roots [(:cid manifest-block)] :blocks blocks})
        car-bytes (:bytes packed)
        car-path (str out-dir "/itonami-hello.car")
        key-path (str out-dir "/app-key.jwk")]
    (.mkdirSync fs out-dir #js {:recursive true})
    (.writeFileSync fs car-path car-bytes)
    (.writeFileSync fs key-path (.stringify js/JSON (.export private-key #js {:format "jwk"})))
    (println "BUNDLE" car-path (str "sha256=" (sha256-hex car-bytes)
                                    " bytes=" (.-length car-bytes)))
    (println "BUNDLE-CID" (:cid manifest-block))
    (println "APP-DID" did)
    (println "IPNS-NAME" name)
    (println "KEY-JWK" key-path "(publish で IPNS record の署名に使う)")
    (println "NEXT" "bytes 面の DNS 復旧後:")
    (println " " "publish: PUT car-bytes → plane、IPNS record を key で署名して publish")
    (println " " (str "open:    bin/open_bundle.cljk --app-did " did
                      " --gateway https://<plane>"))
    (exit! 0)))

(-main)
