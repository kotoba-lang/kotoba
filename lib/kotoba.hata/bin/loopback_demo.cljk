(ns loopback-demo
  "P3 合否条件 (1)(2)(3) + UI 局所 API を、実 HTTP transport（loopback）で通す。

    kbb --backend sci --classpath src:test:<codec paths> bin/loopback_demo.cljk

  測っているもの: 実 CAR（CARv2）・実 digest（DAG-CBOR CIDv1）・実 HTTP
  fetch・open-bundle!・logic の receipt・糸 の記録・UI の局所 API 計画。
  測っていないもの: 実 IPFS/IPNS plane（bytes 面の DNS 不通のため未測定）。

  Exit: 0 = 全経路が通った、1 = 拒否、2 = 測れなかった。"
  (:require ["node:http" :as http]
            [hata.conductor :as conductor]
            [hata.ui :as ui]
            [hata.rebuild-test :as fx]
            [ipld.core :as ipld]))

(defn- exit! [code]
  ;; .exit, not exitCode: the listening server would keep node alive forever.
  (.exit js/process code))

(defn- sign [author action] (str "sig:" author ":" (hash action)))

(defn- verify [author action signature]
  (= signature (str "sig:" author ":" (hash action))))

(defn- fetch-bytes! [url]
  (-> (.fetch js/global url)
      (.then (fn [res] (when (.-ok res) (.arrayBuffer res))))
      (.then (fn [buf] (when buf (js/Uint8Array. buf))))
      (.catch (fn [_] nil))))

(defn- serve! [req res]
  (cond
    (= (.-url req) "/ipns/k51loopback")
    (do (.writeHead res 200 #js {"Content-Type" "application/vnd.ipld.car"})
        (.end res (:bytes fx/packed)))

    (= (.-url req) "/index.html")
    (do (.writeHead res 200 #js {"Content-Type" "text/html; charset=utf-8"})
        (.end res (:bytes fx/ui-block)))

    :else (do (.writeHead res 404) (.end res "not found"))))

(defn- machine [bytes]
  (conductor/resident
   {:cid-fn ipld/cid
    :digest-fn ipld/cid
    :sign-fn sign
    :verify-fn verify
    :device-key "loopback-device"
    :membrane-check-fn (constantly true)
    :fetch-fn (constantly bytes)
    :parse-bundle-fn fx/car->bundle
    :host-fn (fn [cell call]
               (assoc fx/ok-receipt
                      :host :kototama-stub :call call :mon (:hata.cell/mon-cid cell)))}))

(defn- report! [base bytes]
  (let [m (machine bytes)
        opened (conductor/open-bundle! m "did:key:z6MkApp")]
    (if-let [probs (:problems opened)]
      (do (println "REFUSED" (pr-str probs)) (exit! 1))
      (let [cell-id (:ok opened)
            ran (conductor/run-logic! m cell-id {:op :compute})
            cell (get @(:cells m) cell-id)
            plan (ui/serve-plan (:bundle opened) :origin base)]
        (println "OPENED" (pr-str cell-id))
        (println "BUNDLE-CID" (get-in opened [:bundle :bundle-cid]))
        (println "RECEIPT" (pr-str (:ok ran)))
        (println "ITO" (pr-str (mapv #(get-in % [:hata.action/action :hata.action/kind])
                                     (:hata.cell/ito cell))))
        (println "UI-PLAN" (pr-str (select-keys plan [:entry :content-type :path :app-id])))
        (-> (fetch-bytes! (str base (:path plan)))
            (.then (fn [ui-bytes]
                     (if (nil? ui-bytes)
                       (do (println "UI-UNANSWERED") (exit! 2))
                       (do (println "UI-SERVED" (.-length ui-bytes)) (exit! 0))))))))))

(defn -main [& _]
  (let [server (.createServer http serve!)]
    (.listen server 0 "127.0.0.1"
             (fn []
               (let [port (.-port (.address server))
                     base (str "http://127.0.0.1:" port)]
                 (println "LISTENING" base)
                 (-> (fetch-bytes! (str base "/ipns/k51loopback"))
                     (.then (fn [bytes]
                              (if (nil? bytes)
                                (do (println "UNANSWERED") (exit! 2))
                                (report! base bytes))))
                     (.catch (fn [e] (println "ERROR" (str e)) (exit! 2)))))))))

(-main)
