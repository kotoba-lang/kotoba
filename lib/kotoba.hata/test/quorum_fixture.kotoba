(ns hata.quorum-fixture
  (:export [seed config proposal certificate])
  (:require [hata.codec :as c] [hata.quorum :as q] [hata.authority-fixture :as f]))
;; Public deterministic fixture seeds, never production enrollment material.
(defn seed [index :i64] :vector-i64 (f/set-word (f/actor-seed) 0 (+ 40 index)))
(defn config [] :vector-i64
  (let [voters (loop [i 0 out (vector-i64 1 1 11 12 13 14 4 3)]
                 (if (= i 4) out
                   (recur (+ i 1) (c/append out (f/public-key (seed i))))))]
    (c/append voters (f/public-key (f/checkpoint-seed)))))
(defn proposal [cfg :vector-i64 context :vector-i64 value :vector-i64] :vector-i64
  ;; context = [sequence epoch kind parent4]
  (let [header (c/append (vector-i64 1) (c/append context
                 (c/append (q/value-hash value) (c/append (c/slice cfg 2 4)
                   (c/digest (c/slice cfg 136 32))))))]
    (q/make cfg header value (f/checkpoint-seed))))
(defn certificate [cfg :vector-i64 request :vector-i64] :vector-i64
  (loop [i 0 out (vector-i64 1 3)]
    (if (= i 3) out
      (recur (+ i 1) (c/append out (q/vote cfg (q/descriptor request) i (seed i)))))))
