(ns hata.broker-fixture
  (:export [policy config command facts])
  (:require [hata.codec :as c] [hata.authority-fixture :as f] [hata.broker :as b]
            [hata.store :as s]))
;; Public test enrollment, host-owned origins, and one five-byte managed object.
(defn- four [v :vector-i64 start :i64 words :vector-i64] :vector-i64
  (loop [i 0 out (c/slice v 0 (vector-count v))]
    (if (= i 4) out (recur (+ i 1) (vector-assoc! out (+ start i) (vector-at words i))))))
(defn policy [epoch :i64] :vector-i64
  (four (f/set-word (f/policy) 1 epoch) 12 (b/operation)))
(defn config [] :vector-i64 (four (f/config) 13 (b/operation)))
(defn command [blob :vector-i64 p :vector-i64] :vector-i64
  (let [id (vector-i64 91 92 93 94)
        r0 (four (f/request p id) 14 (b/operation))
        r (f/with-digests p (f/set-word (f/set-word r0 43 5000) 49 8192) id)]
    (c/append (c/append (vector-i64 1000) (s/token blob)) (c/append r (f/proof p r id)))))
(defn facts [missing :string] [:map :string [:set :string]]
  (let [empty (typed-set-new [:set :string])
        kind (typed-set-new [:set :string] "object-store.put-block")
        pair (typed-set-new [:set :string] "object-store.put-block awai://object")
        world (typed-set-new [:set :string] "awai.native/v1")]
    {"catalog" (if (= missing "catalog") empty kind)
     "effects" (if (= missing "effects") empty kind)
     "intents" (if (= missing "intents") empty pair)
     "grants" (if (= missing "grants") empty pair)
     "policy" (if (= missing "policy") empty pair)
     "available" (if (= missing "available") empty pair)
     "definition-world" world "runtime-world" (if (= missing "world") empty world)}))
