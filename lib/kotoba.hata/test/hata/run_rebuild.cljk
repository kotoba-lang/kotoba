(ns hata.rebuild-runner
  "Codec-on-classpath entry point. The default `kbb -M:test` suite stays
  pure; this runner exists so the real-CID / real-CAR measurements have a
  command that fails to load without the codecs rather than skipping."
  (:require [cljs.test :as t]
            [hata.didkey-test]
            [hata.rebuild-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println (str "\nhata rebuild: " (:test m) " tests, " (:pass m) " passed, "
                (:fail m) " failed, " (:error m) " errors"))
  (when (pos? (+ (or (:fail m) 0) (or (:error m) 0)))
    (set! (.-exitCode js/process) 1)))

(t/run-tests 'hata.didkey-test 'hata.rebuild-test)
