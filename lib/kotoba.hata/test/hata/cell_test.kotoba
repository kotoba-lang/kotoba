(ns hata.cell-test (:export [main]) (:require [hata.cell :as p]))

(defn- str [s :string] :document (document-string s))
(defn- get-or-null [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn- cfg [mon :document agent :document proof :document] :document
  (document-map :mon-cid mon :agent-key agent :membrane-proof proof))

(defn- case-open-ok [] :i64
  (let [r (p/open (cfg (str "mon-1") (str "agent-1") (str "proof")) true)
        cell (get-or-null r :ok)]
    (+ (if (document-equal? (get-or-null r :problems) (document-null)) 0 1)
       (if (document-equal? (get-or-null cell :hata.cell/mon-cid) (str "mon-1")) 0 1)
       (if (document-equal? (get-or-null cell :hata.cell/agent-key) (str "agent-1")) 0 1)
       (if (document-equal? (get-or-null cell :hata.cell/ito) (document-vector)) 0 1))))

(defn- case-membrane-refused [] :i64
  (let [r (p/open (cfg (str "mon-1") (str "agent-1") (str "bad")) false)]
    (+ (if (document-equal? (get-or-null r :ok) (document-null)) 0 1)
       (if (document-equal? (get-or-null r :problems)
                            (document-vector (document-map :problem (document-keyword :membrane-refused)
                                                           :mon-cid (str "mon-1"))))
           0 1))))

(defn- case-missing-fields [] :i64
  (let [r (p/open (cfg (document-null) (document-i64 7) (document-null)) true)
        probs (get-or-null r :problems)]
    (+ (if (= (document-count probs) 2) 0 1)
       (if (document-equal? (option-or (document-vector-at probs 0) (document-null))
                            (document-map :problem (document-keyword :no-mon-cid))) 0 1)
       (if (document-equal? (option-or (document-vector-at probs 1) (document-null))
                            (document-map :problem (document-keyword :no-agent-key))) 0 1))))

(defn- case-all-wrong [] :i64
  (let [r (p/open (cfg (document-null) (document-null) (document-null)) false)]
    (if (= (document-count (get-or-null r :problems)) 3) 0 1)))

(defn main [] :i64
  (+ (case-open-ok) (case-membrane-refused) (case-missing-fields) (case-all-wrong)))
