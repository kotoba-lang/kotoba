(ns hata.authority-fixture
  (:export [policy config request proof issuer-seed service-seed checkpoint-seed
            actor-seed public-key signed set-word with-digests payload-digest])
  (:require [hata.codec :as c] [hata.authority :as a] [ed25519.selfhost :as ed]))
;; PUBLIC deterministic test keys only. Never enroll these keys in a service.
(defn issuer-seed [] :vector-i64
  (ed/hex-bytes "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"))
(defn service-seed [] :vector-i64
  (ed/hex-bytes "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"))
(defn checkpoint-seed [] :vector-i64
  (ed/hex-bytes "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7"))
(defn actor-seed [] :vector-i64
  (ed/hex-bytes "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"))
(defn set-word [v :vector-i64 i :i64 x :i64] :vector-i64
  (vector-assoc! (c/slice v 0 (vector-count v)) i x))
(defn public-key [seed :vector-i64] :vector-i64
  (let [out (vector-alloc 32)
        done (arena-scope (let [pk (ed/public-from-seed seed)]
               (loop [i 0] (if (= i 32) 0
                 (let [z (vector-assoc! out i (vector-at pk i))] (recur (+ i 1)))))))] out))
(defn signed [seed :vector-i64 message :vector-i64] :vector-i64
  (let [out (vector-alloc 64) done (ed/sign-into out seed message)] out))
(defn policy [] :vector-i64
  (c/append (vector-i64 1 7 3 900 2000 1 0 0 11 12 13 14 21 22 23 24)
    (c/append (public-key (issuer-seed))
      (c/append (public-key (service-seed)) (public-key (checkpoint-seed))))))
(defn config [] :vector-i64
  (vector-i64 1 7 3 0 1000 64 0 0 -1 11 12 13 14 21 22 23 24
              64 64000 64000 64000 64000 64000 4096))
(defn- set-four [r :vector-i64 start :i64 digest :vector-i64] :vector-i64
  (loop [i 0 out (c/slice r 0 (vector-count r))]
    (if (= i 4) out
      (recur (+ i 1) (vector-assoc! out (+ start i) (vector-at digest i))))))
(defn payload-digest [] :vector-i64 (c/digest (ed/hex-bytes "68656c6c6f")))
(defn with-digests [p :vector-i64 r :vector-i64 id :vector-i64] :vector-i64
  (let [actor (set-four r 30 (c/digest (public-key (actor-seed))))
        grant (set-four actor 34 (a/grant-digest p actor))]
    (set-four grant 22 (a/request-digest grant id (payload-digest)))))
(defn request [p :vector-i64 id :vector-i64] :vector-i64
  (with-digests p
    (vector-i64 1 (vector-at p 1) 900 2000 2000 (vector-at p 2) 1 2000 5 2000
                11 12 13 14 21 22 23 24 31 32 33 34
                0 0 0 0 51 52 53 54 0 0 0 0 0 0 0 0
                1 4096 100 200 300 400 1 8192 2000 2000 2000 2000) id))
(defn- signatures [p :vector-i64 r :vector-i64 id :vector-i64] :vector-i64
  (c/append (c/append (vector-i64 1) id)
    (c/append (public-key (actor-seed))
      (c/append (signed (issuer-seed) (a/credential-message p r))
        (c/append (signed (service-seed) (a/grant-message p r))
          (c/append (signed (service-seed) (a/coupon-message r id))
                    (signed (actor-seed) (a/request-message r id))))))))

(defn proof [p :vector-i64 r :vector-i64 id :vector-i64] :vector-i64
  (c/append (signatures p r id) (payload-digest)))
