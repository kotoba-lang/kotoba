(ns hata.quorum-native-test
  (:export [main])
  (:require [hata.codec :as c] [hata.quorum :as q] [hata.quorum-fixture :as f]
            [hata.authority-fixture :as a] [kototama.effect-origins :as admission]))
(defn main [] :i64
  (let [cfg (f/config) request (f/proposal cfg (vector-i64 1 7 2 0 0 0 0) (vector-i64 99))
        cert (f/certificate cfg request)
        duplicate (c/append (c/slice cert 0 132) (c/slice cert 2 65))
        catalog (typed-set-new [:set :string] "object-store.put-block")
        keys (typed-set-new [:set :string] "object-store.put-block awai://object")
        empty (typed-set-new [:set :string])]
    (cond
      (not (q/config? cfg)) 2001
      (not (q/valid? cfg request)) 2002
      (not (q/certificate? cfg request cert)) 2003
      (q/certificate? cfg request duplicate) 2004
      (q/certificate? cfg request (c/slice cert 0 132)) 2005
      (q/certificate? cfg request (a/set-word cert 10 (bit-xor (vector-at cert 10) 1))) 2006
      (q/valid? cfg (a/set-word request 85 100)) 2007
      (q/valid? cfg (a/set-word request 2 8)) 2008
      (q/config? (a/set-word cfg 7 2)) 2009
      (not (admission/eligible? catalog catalog "awai.native/v1" keys keys keys "awai.native/v1" keys "object-store.put-block" "awai://object")) 2010
      (admission/eligible? catalog catalog "awai.native/v1" keys keys empty "awai.native/v1" keys "object-store.put-block" "awai://object") 2011
      (admission/eligible? catalog catalog "other-world" keys keys keys "awai.native/v1" keys "object-store.put-block" "awai://object") 2012
      (admission/eligible? empty catalog "awai.native/v1" keys keys keys "awai.native/v1" keys "object-store.put-block" "awai://object") 2013
      (admission/eligible? catalog empty "awai.native/v1" keys keys keys "awai.native/v1" keys "object-store.put-block" "awai://object") 2014
      (admission/eligible? catalog catalog "awai.native/v1" empty keys keys "awai.native/v1" keys "object-store.put-block" "awai://object") 2015
      (admission/eligible? catalog catalog "awai.native/v1" keys empty keys "awai.native/v1" keys "object-store.put-block" "awai://object") 2016
      (admission/eligible? catalog catalog "awai.native/v1" keys keys keys "awai.native/v1" empty "object-store.put-block" "awai://object") 2017
      :else 0)))
