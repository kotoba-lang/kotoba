(ns hata.audit-native-test
  (:export [main])
  (:require [hata.codec :as c] [hata.quorum :as q] [hata.audit :as audit]
            [hata.quorum-fixture :as f] [hata.authority-fixture :as a]))
;; Pure audit-history verdicts (AWAI-106) on fixture-certified entries.
(defn- item [x :vector-i64] :vector-i64 (c/append (vector-i64 (vector-count x)) x))
(defn- record [cfg :vector-i64 request :vector-i64] :vector-i64
  (c/append (q/descriptor request) (f/certificate cfg request)))
(defn- batch1 [x :vector-i64] :vector-i64 (c/append (vector-i64 1) (item x)))
(defn- batch2 [x :vector-i64 y :vector-i64] :vector-i64 (c/append (vector-i64 2) (c/append (item x) (item y))))
(defn- head [cfg :vector-i64 k :i64 request :vector-i64] :vector-i64
  (c/append (vector-i64 k) (q/entry-id cfg (q/descriptor request))))
(defn main [] :i64
  (let [cfg (f/config)
        r1 (f/proposal cfg (vector-i64 1 7 2 0 0 0 0) (vector-i64 99))
        r2 (f/proposal cfg (c/append (vector-i64 2 7 3) (q/entry-id cfg (q/descriptor r1))) (vector-i64 5))
        orphan (f/proposal cfg (vector-i64 2 7 3 0 0 0 0) (vector-i64 5))
        fork (f/proposal cfg (vector-i64 1 7 2 0 0 0 0) (vector-i64 98))
        x1 (record cfg r1) x2 (record cfg r2)
        good (batch2 x1 x2)
        forged (batch2 x1 (a/set-word x2 95 (bit-xor (vector-at x2 95) 1)))
        other (a/set-word cfg 1 2)]
    (cond
      (not (c/equal? (audit/history cfg good) (head cfg 2 r2))) 4001
      (not (c/equal? (audit/history cfg (vector-i64 0)) (vector-i64 0 0 0 0 0))) 4002
      (not= (vector-count (audit/history cfg (batch1 x2))) 1) 4003
      (not= (vector-count (audit/history cfg (batch2 x1 (record cfg orphan)))) 1) 4004
      (not= (vector-count (audit/history cfg forged)) 1) 4005
      (not= (vector-count (audit/history cfg (c/append good (vector-i64 7)))) 1) 4006
      (not (audit/extends? cfg (head cfg 1 r1) good)) 4007
      (audit/extends? cfg (head cfg 2 r2) (batch1 x1)) 4008
      (audit/extends? cfg (head cfg 1 fork) good) 4009
      (not= (vector-count (audit/history other good)) 1) 4010
      (not (audit/extends? cfg (vector-i64 0 0 0 0 0) good)) 4011
      :else 0)))
