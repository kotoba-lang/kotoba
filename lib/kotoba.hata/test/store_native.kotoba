(ns hata.store-native-test
  (:export [main])
  (:capabilities [:cli/args])
  (:require [hata.store :as s] [hata.store-io :as io] [hata.codec :as c]
            [hata.authority-fixture :as f] [hata.admission :as ad]))
(defn- committed? [result :string] :bool (= (string-index-of result "committed:") 0))
(defn- submit-command [blob :vector-i64 p :vector-i64 changed :bool] :vector-i64
  (let [id (vector-i64 91 92 93 94) r0 (f/request p id)
        r (if changed (f/with-digests p (f/set-word r0 21 999) id) r0)]
    (c/append (c/append (vector-i64 1000) (s/token blob)) (c/append r (f/proof p r id)))))
(defn main [] :i64
  (let [mode (typed-cap-call :cli/args :string :string "0")
        base (typed-cap-call :cli/args :string :string "1") p (f/policy) seed (f/checkpoint-seed)]
    (cond
      (= mode "create") (if (committed? (s/create base (f/config) p seed)) 1 -1)
      (= mode "create-small")
      (if (committed? (s/create base (f/set-word (f/config) 5 1) p seed)) 1 -21)
      (= mode "capacity")
      (let [id (vector-i64 95 96 97 98) blob (s/load base p)
            r (f/with-digests p (f/set-word (f/request p id) 21 999) id)
            cmd (c/append (c/append (vector-i64 1000) (s/token blob)) (c/append r (f/proof p r id)))
            before (s/token blob) result (s/submit base p seed cmd)]
        (if (and (= result "rejected:admission:17") (c/equal? before (s/token (s/load base p)))) 1 -22))
      (= mode "codec-max")
      (let [words (loop [i 0 out (vector-alloc 53660)]
                    (if (= i 53660) out
                      (recur (+ i 1) (vector-assoc! out i (- 0 i)))))
            text (c/hex words)]
        (if (and (= (string-length text) 858560) (c/equal? words (c/unhex text))
                 (= (vector-count (s/token words)) 4)) 1 -23))
      (= mode "create-again") (if (= (s/create base (f/config) p seed) "rejected:exists") 1 -2)
      (= mode "submit") (if (committed? (s/submit base p seed (submit-command (s/load base p) p false))) 1 -3)
      (= mode "duplicate") (if (= (s/submit base p seed (submit-command (s/load base p) p false)) "duplicate:1") 1 -4)
      (= mode "conflict") (if (= (s/submit base p seed (submit-command (s/load base p) p true)) "rejected:request-id-conflict") 1 -5)
      (= mode "denied")
      (let [cmd (submit-command (s/load base p) p false)
            bad (f/set-word cmd 284 (bit-xor (vector-at cmd 284) 1))
            before (s/token (s/load base p)) result (s/submit base p seed bad)]
        (if (and (= result "rejected:authority:40") (c/equal? before (s/token (s/load base p)))) 1 -6))
      (= mode "state-empty")
      (let [state (s/state (s/load base p))]
        (if (and (= (vector-count state) 24) (= (vector-at state 6) 0) (= (vector-at state 17) 64)) 1 -7))
      (= mode "state-reserved")
      (let [state (s/state (s/load base p))]
        (if (and (= (vector-count state) 81) (= (vector-at state 6) 1)
                 (= (vector-at state 17) 63) (= (vector-at state 24) 1)) 1 -8))
      (= mode "complete")
      (let [blob (s/load base p) id (vector-i64 91 92 93 94) r (f/request p id)
            cmd (c/append (c/append (vector-i64 1001) (s/token blob))
                  (c/append (c/slice r 22 4) (vector-i64 2 81 82 83 84)))]
        (if (committed? (s/complete base p seed cmd)) 1 -9))
      (= mode "state-complete")
      (let [state (s/state (s/load base p))]
        (if (and (= (vector-at state 24) 2) (= (vector-at state 17) 63)) 1 -10))
      (= mode "recover")
      (let [blob (s/load base p) cmd (c/append (c/append (vector-i64 1002) (s/token blob)) (vector-i64 8))]
        (if (committed? (s/recover base p seed cmd)) 1 -11))
      (= mode "state-unknown")
      (let [state (s/state (s/load base p))]
        (if (and (= (vector-at state 1) 8) (= (vector-at state 24) 4) (= (vector-at state 17) 63)) 1 -12))
      (= mode "corrupt") (if (= (vector-count (s/load base p)) 0) 1 -13)
      (= mode "save-token")
      (if (io/write (string-concat base "/expected") (c/hex (s/token (s/load base p)))) 1 -14)
      (= mode "stale")
      (let [cmd (submit-command (s/load base p) p false)
            old (c/unhex (io/read (string-concat base "/expected")))
            changed (loop [i 0 out cmd] (if (= i 4) out
                      (recur (+ i 1) (vector-assoc! out (+ i 1) (vector-at old i)))))]
        (if (= (s/submit base p seed changed) "rejected:compare") 1 -15))
      (= mode "race")
      (let [cmd (submit-command (s/load base p) p false)
            old (c/unhex (io/read (string-concat base "/expected")))
            changed (loop [i 0 out cmd] (if (= i 4) out
                      (recur (+ i 1) (vector-assoc! out (+ i 1) (vector-at old i)))))
            result (s/submit base p seed changed)]
        (cond (committed? result) 11 (= result "rejected:busy") 12 (= result "rejected:compare") 13 :else -16))
      (= mode "old-writer")
      (let [blob (s/load base p)
            cmd (c/append (c/append (vector-i64 1003) (s/token blob))
                  (vector-i64 1 2 3 4 2 81 82 83 84))]
        (if (= (s/complete base p seed cmd) "rejected:epoch") 1 -18))
      (= mode "request-after-recovery")
      (let [current (f/set-word p 1 8)]
        (if (= (s/submit base current seed (submit-command (s/load base current) current false))
               "rejected:request-id-conflict") 1 -19))
      (= mode "busy")
      (if (= (s/create base (f/config) p seed) "rejected:busy") 1 -20)
      (= mode "unsafe-path") (if (= (s/create "/tmp/../escape" (f/config) p seed) "rejected:path") 1 -17)
      :else -100)))
