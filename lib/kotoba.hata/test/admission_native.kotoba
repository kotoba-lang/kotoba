(ns hata.admission-native-test
  (:export [main])
  (:require [hata.admission :as ad]))

;; Native project links the canonical module unchanged. Tests exercise only its
;; public API; all expectations and assertions execute in Kotoba.
(defn- test-copy [v :vector-i64] :vector-i64
  (loop [i 0 out (vector-i64)]
    (if (= i (vector-count v)) out
      (recur (+ i 1) (vector-conj out (vector-at v i))))))
(defn- test-set [v :vector-i64 i :i64 value :i64] :vector-i64
  (vector-assoc! (test-copy v) i value))
(defn- test-state [] :vector-i64
  (ad/admission-initialize
   (vector-i64 1 7 3 0 1000 4 0 0 -1
               11 12 13 14 21 22 23 24
               10 8000 8000 10000 10000 10000 4096)))
(defn- test-request [] :vector-i64
  (vector-i64 1 7 900 2000 2000 3 1 2000 600 2000
              11 12 13 14 21 22 23 24 31 32 33 34
              41 42 43 44 51 52 53 54 61 62 63 64 71 72 73 74
              1 1000 100 200 300 400 1 2000 2000 2000 2000 2000))
(defn- test-submit [s :vector-i64 r :vector-i64] :vector-i64
  (ad/admission-submit s r 1000 (vector-at s 3) 7))
(defn- test-code [r :vector-i64] :i64
  (ad/admission-status (test-submit (test-state) r)))
(defn- test-zero-digest [v :vector-i64 i :i64] :vector-i64
  (test-set (test-set (test-set (test-set v i 0) (+ i 1) 0) (+ i 2) 0) (+ i 3) 0))

(defn- test-shapes [] :i64
  (let [r (test-request) s (test-state)]
    (cond
      (not (ad/admission-preflight 400 4096 4096 0 1)) 101
      (ad/admission-preflight 401 1 4096 0 1) 102
      (ad/admission-preflight 400 -1 4096 0 1) 103
      (ad/admission-preflight 400 4097 4096 0 1) 104
      (ad/admission-preflight 400 1 4096 1 1) 105
      (ad/admission-preflight 400 1 4096 -1 1) 106
      (ad/admission-preflight 400 1 4096 0 0) 107
      (ad/admission-preflight 400 1 -1 0 1) 108
      (not= (ad/admission-status (vector-i64)) 10) 109
      (not= (vector-count (ad/admission-initialize (test-set s 5 65))) 0) 110
      (not= (vector-count (ad/admission-initialize (test-set s 17 -1))) 0) 111
      (not= (vector-count (ad/admission-initialize (test-set s 3 1))) 0) 112
      (not= (vector-count (ad/admission-initialize (test-set s 6 1))) 0) 113
      (not= (vector-count (ad/admission-initialize (test-zero-digest s 9))) 0) 114
      (not= (test-code (vector-i64)) 12) 115
      (not= (test-code (vector-conj r 1)) 12) 116
      (not= (test-code (test-set r 0 2)) 12) 117
      (not= (test-code (test-set r 6 3)) 12) 118
      (not= (test-code (test-set r 38 0)) 12) 119
      (not= (test-code (test-set r 39 399)) 12) 120
      (not= (test-code (test-set r 8 601)) 12) 121
      (not= (test-code (test-set r 2 2000)) 12) 122
      (not= (test-code (test-set r 9 1999)) 12) 123
      (not= (test-code (test-zero-digest r 26)) 12) 124
      (not= (test-code (test-zero-digest r 30)) 12) 125
      (not= (test-code (test-zero-digest r 34)) 12) 126
      (not= (test-code (test-zero-digest r 18)) 12) 127
      (not= (test-code (test-zero-digest r 22)) 12) 128
      (not= (test-code (test-set r 40 -1)) 12) 129
      (not= (test-code (test-set r 44 -1)) 12) 130
      :else 0)))

(defn- test-bindings [] :i64
  (let [r (test-request) s (test-state)]
    (cond
      (not= (test-code r) 1) 201
      (not= (test-code (test-set r 6 2)) 1) 202
      (not= (test-code (test-set r 1 6)) 13) 203
      (not= (test-code (test-set r 5 4)) 13) 204
      (not= (test-code (test-set r 10 99)) 13) 205
      (not= (test-code (test-set r 13 99)) 13) 206
      (not= (test-code (test-set r 14 99)) 13) 207
      (not= (test-code (test-set r 17 99)) 13) 208
      (not= (test-code (test-set r 2 1001)) 14) 209
      (not= (test-code (test-set r 3 1000)) 14) 210
      (not= (test-code (test-set r 4 1000)) 14) 211
      (not= (test-code (test-set r 7 1000)) 14) 212
      (not= (ad/admission-status (ad/admission-submit s r 999 0 7)) 11) 213
      (not= (ad/admission-status (ad/admission-submit s r 1000 1 7)) 11) 214
      (not= (ad/admission-status (ad/admission-submit s r 1000 0 6)) 11) 215
      (not= (ad/admission-status (test-submit (test-set s 23 599) r)) 15) 216
      (not= (ad/admission-status (test-submit (test-set s 3 9223372036854775807) r)) 11) 217
      (not= (test-code (test-set r 8 9223372036854775807)) 12) 218
      :else 0)))

(defn- test-llm-allow [] :bool true)
(defn- test-budgets [] :i64
  (let [s (test-state) r (test-request) a (test-submit s r)]
    (cond
      (not= (vector-at a 17) 9) 301
      (not= (vector-at a 18) 7000) 302
      (not= (vector-at a 19) 7900) 303
      (not= (vector-at a 20) 9800) 304
      (not= (vector-at a 21) 9700) 305
      (not= (vector-at a 22) 9600) 306
      (not= (vector-at a 3) 1) 307
      (not= (vector-at a 6) 1) 308
      (not= (vector-count a) 81) 309
      (not= (vector-at s 17) 10) 310
      (not= (vector-at s 6) 0) 311
      (not= (vector-at r 39) 1000) 312
      :else
      (loop [i 0]
        (if (= i 6)
          (if (and (test-llm-allow)
                   (= (test-code (test-set r 41 2001)) 18)) 0 313)
          (let [too-small-state (test-set s (+ 17 i) (- (vector-at r (+ 38 i)) 1))
                too-small-grant (test-set r (+ 44 i) (- (vector-at r (+ 38 i)) 1))]
            (cond (not= (ad/admission-status (test-submit too-small-state r)) 18) (+ 320 i)
                  (not= (test-code too-small-grant) 18) (+ 330 i)
                  (not= (vector-at too-small-state 3) 0) (+ 340 i)
                  :else (recur (+ i 1)))))))))

(defn- test-replay [] :i64
  (let [s (test-state) r (test-request) a (test-submit s r)
        duplicate (ad/admission-submit a r 1001 1 7)
        collision (ad/admission-submit a (test-set r 25 45) 1001 1 7)
        new-coupon (ad/admission-submit a (test-set r 21 35) 1001 1 7)
        different-actor (ad/admission-submit a (test-set r 33 65) 1001 1 7)
        different-principal (ad/admission-submit a (test-set r 29 55) 1001 1 7)
        different-grant (ad/admission-submit a (test-set r 37 75) 1001 1 7)
        other (test-set (test-set r 21 35) 25 45)
        full (test-submit (test-set s 5 1) r)]
    (cond
      (not= (ad/admission-status duplicate) 2) 401
      (not= (vector-at duplicate 17) 9) 402
      (not= (vector-at duplicate 3) 1) 403
      (not= (vector-at duplicate 6) 1) 404
      (not= (ad/admission-row-status duplicate (vector-i64 41 42 43 44)) 1) 405
      (not= (ad/admission-status collision) 16) 406
      (not= (ad/admission-status new-coupon) 16) 407
      (not= (ad/admission-status different-actor) 16) 408
      (not= (ad/admission-status different-principal) 16) 409
      (not= (ad/admission-status different-grant) 16) 410
      (not= (ad/admission-status (ad/admission-submit full other 1001 1 7)) 17) 411
      (not= (ad/admission-status (ad/admission-submit full r 1001 1 7)) 2) 412
      (not= (ad/admission-status (ad/admission-submit a other 1001 1 7)) 1) 413
      (not= (ad/admission-status (ad/admission-submit a r 2000 1 7)) 14) 414
      (not= (ad/admission-row-status a (vector-i64 1 2 3 4)) 0) 415
      (not= (ad/admission-row-status a (vector-i64)) -1) 416
      :else 0)))

(defn- test-complete [s :vector-i64 key :vector-i64 outcome :i64
                       result :vector-i64 now :i64 anchor :i64 epoch :i64] :vector-i64
  (ad/admission-complete s key outcome result (vector-i64 now anchor epoch)))

(defn- test-completion [] :i64
  (let [r (test-request) a (test-submit (test-state) r)
        key (vector-i64 41 42 43 44) result (vector-i64 81 82 83 84)
        done (test-complete a key 2 result 1001 1 7)
        failed (test-complete a key 3 result 1001 1 7)
        unknown (test-complete a key 4 (vector-i64 0 0 0 0) 1001 1 7)]
    (cond
      (not= (ad/admission-status done) 3) 501
      (not= (ad/admission-row-status done key) 2) 502
      (not= (vector-at done 3) 2) 503
      (not= (vector-at done 26) 2) 504
      (not= (vector-at done 17) 9) 505
      (not= (vector-at a 24) 1) 506
      (not= (ad/admission-status (test-complete done key 2 result 1002 2 7)) 2) 507
      (not= (ad/admission-status (test-complete done key 3 result 1002 2 7)) 21) 508
      (not= (ad/admission-status (test-complete done key 2 (vector-i64 81 82 83 85) 1002 2 7)) 21) 509
      (not= (ad/admission-status (test-complete a key 2 result 1001 0 7)) 11) 510
      (not= (ad/admission-status (test-complete a key 2 result 999 1 7)) 11) 511
      (not= (ad/admission-status (test-complete a key 2 result 1001 1 8)) 11) 512
      (not= (ad/admission-status (test-complete a key 1 result 1001 1 7)) 19) 513
      (not= (ad/admission-status (test-complete a key 2 (vector-i64 0 0 0 0) 1001 1 7)) 19) 514
      (not= (ad/admission-status (test-complete a (vector-i64) 2 result 1001 1 7)) 19) 515
      (not= (ad/admission-status (test-complete a (vector-i64 1 2 3 4) 2 result 1001 1 7)) 20) 516
      (not= (ad/admission-row-status failed key) 3) 517
      (not= (vector-at failed 17) 9) 518
      (not= (ad/admission-row-status unknown key) 4) 519
      (not= (vector-at unknown 17) 9) 520
      (not= (ad/admission-status (test-complete unknown key 2 result 1002 2 7)) 21) 521
      (not= (ad/admission-status (ad/admission-submit done r 1002 2 7)) 2) 522
      (not= (ad/admission-status (ad/admission-complete a key 2 result (vector-i64))) 19) 523
      :else 0)))

(defn- test-recovery [] :i64
  (let [s (test-state) r (test-request) a (test-submit s r)
        key (vector-i64 41 42 43 44) result (vector-i64 81 82 83 84)
        recovered (ad/admission-recover a 1001 1 7 8)
        finished (test-complete a key 2 result 1001 1 7)
        finished-recovered (ad/admission-recover finished 1002 2 7 8)]
    (cond
      (not= (ad/admission-status recovered) 4) 601
      (not= (vector-at recovered 1) 8) 602
      (not= (vector-at recovered 3) 2) 603
      (not= (vector-at recovered 4) 1001) 604
      (not= (ad/admission-row-status recovered key) 4) 605
      (not= (vector-at recovered 17) 9) 606
      (not= (vector-at a 24) 1) 607
      (not= (ad/admission-status (ad/admission-recover a 1001 1 7 7)) 11) 608
      (not= (ad/admission-status (ad/admission-recover a 1001 1 7 6)) 11) 609
      (not= (ad/admission-status (ad/admission-recover a 1001 0 7 8)) 11) 610
      (not= (ad/admission-status (ad/admission-recover s 1001 1 7 8)) 11) 611
      (not= (ad/admission-status (test-complete recovered key 2 result 1002 2 7)) 11) 612
      (not= (ad/admission-status (test-complete recovered key 2 result 1002 2 8)) 21) 613
      (not= (ad/admission-row-status finished-recovered key) 2) 614
      (not= (ad/admission-status (ad/admission-submit recovered r 1002 2 8)) 13) 615
      (not= (ad/admission-status (ad/admission-submit recovered (test-set r 1 8) 1002 2 8)) 16) 616
      (not= (ad/admission-status (ad/admission-recover a 999 1 7 8)) 11) 617
      :else 0)))

(defn- test-capacity [] :i64
  (let [s (ad/admission-initialize
           (vector-i64 1 7 3 0 1000 64 0 0 -1
                       11 12 13 14 21 22 23 24
                       64 25600 0 0 0 0 4096))
        r (vector-i64 1 7 900 2000 2000 3 1 2000 0 2000
                      11 12 13 14 21 22 23 24 31 32 33 34
                      41 42 43 44 51 52 53 54 61 62 63 64 71 72 73 74
                      1 400 0 0 0 0 1 400 0 0 0 0)
        full (loop [i 0 state s]
               (if (= i 64) state
                 (recur (+ i 1) (ad/admission-submit state
                                    (test-set (test-set r 21 (+ 34 i)) 25 (+ 44 i))
                                    1000 (vector-at state 3) 7))))
        recovered (ad/admission-recover full 1001 64 7 8)]
    (cond
      (not= (ad/admission-status full) 1) 701
      (not= (vector-at full 6) 64) 702
      (not= (vector-at full 3) 64) 703
      (not= (vector-count full) 3672) 704
      (not= (vector-at full 17) 0) 705
      (not= (vector-at full 18) 0) 706
      (not= (vector-at s 17) 64) 707
      (not= (vector-at s 6) 0) 708
      (not= (ad/admission-status (ad/admission-submit full
                 (test-set (test-set r 21 1000) 25 1000) 1001 64 7)) 17) 709
      (not= (ad/admission-status (ad/admission-submit full r 1001 64 7)) 2) 710
      (not= (ad/admission-status recovered) 4) 711
      (not= (vector-at recovered 3) 65) 712
      (not= (vector-at recovered 17) 0) 713
      :else
      (loop [i 0]
        (if (= i 64) 0
          (cond (not= (ad/admission-row-status recovered (vector-i64 41 42 43 (+ 44 i))) 4) (+ 720 i)
                (not= (ad/admission-row-status full (vector-i64 41 42 43 (+ 44 i))) 1) (+ 800 i)
                :else (recur (+ i 1))))))))

(defn admission-native-tests [] :i64
  (let [shape (test-shapes) bindings (test-bindings) budget (test-budgets)
        replay (test-replay) completion (test-completion) recovery (test-recovery)
        capacity (test-capacity)]
    (cond (not= shape 0) shape (not= bindings 0) bindings
          (not= budget 0) budget (not= replay 0) replay
          (not= completion 0) completion (not= recovery 0) recovery
          (not= capacity 0) capacity
          :else 0)))

(defn main [] :i64 (admission-native-tests))
