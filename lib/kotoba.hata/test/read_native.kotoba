(ns hata.read-native-test
  (:export [main])
  (:require [hata.codec :as c] [hata.quorum :as q] [hata.read :as r]
            [hata.quorum-fixture :as f] [hata.authority-fixture :as a]))
;; Pure fresh-read verdicts (AWAI-103). Snapshots follow hata.replica Snapshot15;
;; every attestation is signed by the fixture replica key it names.
(defn- nonce [] :vector-i64 (vector-i64 5 6 7 8))
(defn- genesis [cfg :vector-i64 i :i64] :vector-i64
  (c/append (vector-i64 1 i 0 0 0 0 0 0 0 0 0) (q/roster-id cfg)))
(defn- committed [cfg :vector-i64 i :i64 desc :vector-i64 cert :vector-i64] :vector-i64
  (c/append (c/append (vector-i64 1 i (vector-at desc 1) (vector-at desc 2)) (q/entry-id cfg desc))
    (c/append (c/append (vector-i64 85 (vector-count cert) 0) (q/roster-id cfg)) (c/append desc cert))))
(defn- pending [s :vector-i64 desc :vector-i64] :vector-i64
  (c/append (a/set-word s 10 85) desc))
(defn- att [cfg :vector-i64 i :i64 s :vector-i64 v :vector-i64 n :vector-i64] :vector-i64
  (r/attestation cfg i (f/seed i) n s v))
(defn- item [x :vector-i64] :vector-i64 (c/append (vector-i64 (vector-count x)) x))
(defn- batch2 [x :vector-i64 y :vector-i64] :vector-i64
  (c/append (vector-i64 2) (c/append (item x) (item y))))
(defn- batch3 [x :vector-i64 y :vector-i64 z :vector-i64] :vector-i64
  (c/append (vector-i64 3) (c/append (item x) (c/append (item y) (item z)))))
(defn- status [result :vector-i64] :i64 (if (> (vector-count result) 0) (vector-at result 0) -1))
(defn- head? [result :vector-i64 code :i64 seq :i64 desc :vector-i64] :bool
  (and (= (status result) code) (>= (vector-count result) 87) (= (vector-at result 1) seq)
       (c/equal? (c/slice result 2 85) desc)))
(defn- cert3 [cfg :vector-i64 desc :vector-i64 x :i64 y :i64 z :i64] :vector-i64
  (c/append (vector-i64 1 3)
    (c/append (q/vote cfg desc x (f/seed x)) (c/append (q/vote cfg desc y (f/seed y)) (q/vote cfg desc z (f/seed z))))))
(defn main [] :i64
  (let [cfg (f/config) n (nonce)
        r1 (f/proposal cfg (vector-i64 1 7 2 0 0 0 0) (vector-i64 99)) d1 (q/descriptor r1)
        k1 (f/certificate cfg r1)
        r2 (f/proposal cfg (c/append (vector-i64 2 7 3) (q/entry-id cfg d1)) (vector-i64 5)) d2 (q/descriptor r2)
        fork (q/descriptor (f/proposal cfg (vector-i64 1 7 2 0 0 0 0) (vector-i64 98)))
        orphan (q/descriptor (f/proposal cfg (vector-i64 2 7 3 0 0 0 0) (vector-i64 5)))
        c0 (att cfg 0 (committed cfg 0 d1 k1) (vector-i64) n) c1 (att cfg 1 (committed cfg 1 d1 k1) (vector-i64) n)
        c2 (att cfg 2 (committed cfg 2 d1 k1) (vector-i64) n) c3 (att cfg 3 (committed cfg 3 d1 k1) (vector-i64) n)
        g0 (att cfg 0 (genesis cfg 0) (vector-i64) n) g1 (att cfg 1 (genesis cfg 1) (vector-i64) n)
        g2 (att cfg 2 (genesis cfg 2) (vector-i64) n) g3 (att cfg 3 (genesis cfg 3) (vector-i64) n)
        p0 (att cfg 0 (pending (committed cfg 0 d1 k1) d2) (q/vote cfg d2 0 (f/seed 0)) n)
        p1 (att cfg 1 (pending (committed cfg 1 d1 k1) d2) (q/vote cfg d2 1 (f/seed 1)) n)
        p2 (att cfg 2 (pending (committed cfg 2 d1 k1) d2) (q/vote cfg d2 2 (f/seed 2)) n)
        recovered (r/latest cfg n (batch3 p0 p1 p2))
        cert (c/slice recovered 87 (- (vector-count recovered) 87))
        stale (att cfg 2 (committed cfg 2 d1 k1) (vector-i64) (vector-i64 1 1 1 1))
        tampered (a/set-word c2 12 (+ (vector-at c2 12) 1))
        other (a/set-word cfg 1 2)
        forked (att cfg 3 (committed cfg 3 fork (cert3 cfg fork 1 2 3)) (vector-i64) n)
        wrong-voter (att cfg 0 (pending (committed cfg 0 d1 k1) d2) (q/vote cfg d2 1 (f/seed 1)) n)
        bad-parent (att cfg 0 (pending (committed cfg 0 d1 k1) orphan) (q/vote cfg orphan 0 (f/seed 0)) n)
        lagging (att cfg 3 (pending (genesis cfg 3) d1) (q/vote cfg d1 3 (f/seed 3)) n)]
    (cond
      (not (q/certificate? cfg r1 k1)) 3000
      (not (head? (r/latest cfg n (batch3 c0 c1 c2)) 1 1 d1)) 3001
      (not (head? (r/latest cfg n (batch3 c0 c1 g3)) 1 1 d1)) 3002
      (not (and (head? recovered 2 2 d2) (q/certificate? cfg r2 cert))) 3003
      (not (head? (r/latest cfg n (batch3 p0 c1 c3)) 3 2 d2)) 3004
      (not (head? (r/latest cfg n (batch3 p0 p1 c3)) 3 2 d2)) 3005
      (not= (status (r/latest cfg n (batch2 c0 c1))) 0) 3006
      (not= (status (r/latest cfg n (batch3 c0 c0 c1))) 0) 3007
      (not= (status (r/latest cfg n (batch3 c0 c1 stale))) 0) 3008
      (not= (status (r/latest cfg n (batch3 c0 c1 tampered))) 0) 3009
      (not= (status (r/latest other n (batch3 c0 c1 c2))) 0) 3010
      (not= (status (r/latest cfg n (batch3 c0 c1 forked))) 0) 3011
      (not (c/equal? (r/latest cfg n (batch3 g0 g1 g2)) (vector-i64 4 0))) 3012
      (not= (status (r/latest cfg n (batch3 wrong-voter c1 c2))) 0) 3013
      (not= (status (r/latest cfg n (batch3 bad-parent c1 c2))) 0) 3014
      (not (head? (r/latest cfg n (batch3 c0 c1 lagging)) 1 1 d1)) 3015
      :else 0)))
