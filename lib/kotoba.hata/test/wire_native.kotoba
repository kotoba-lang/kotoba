;; hata.wire-native-test -- the broker envelope of hata.wire (AWAI-102). main returns 127:
;;   1 seal / open round trips for every kind, with bodies of 0, 1 and max-body bytes
;;   2 open refuses another version, another kind, another id, a short or long length
;;     field, a truncated envelope, and anything over 65535 bytes
;;   4 seal refuses an unknown kind, a 31-byte id, a body over max-body and a non-byte
;;   8 request ids differ by session (handshake hash), by sequence and by body, and match
;;     SHA-256 of the label, hh, the 8-byte sequence and the body (computed here)
;;  16 reply-kind pairs each request with its response and refuses responses and unknowns
;;  32 a sealed max-body envelope is exactly 65535 bytes (one noise.frame)
;;  64 a response sealed with the request's id opens only against that id
(ns hata.wire-native-test
  (:require [hata.wire :as w] [sha2.core :as h])
  (:export [main]))

(defn- pat [n :i64 k :i64] :vector-i64 (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (rem (+ (* 7 i) k) 256))))))
(defn- cat [a :vector-i64 b :vector-i64] :vector-i64
  (let [na (vector-count a) out (vector-alloc (+ na (vector-count b)))]
    (loop [i 0] (if (= i (vector-count out)) out
      (let [z (vector-assoc! out i (if (< i na) (vector-at a i) (vector-at b (- i na))))] (recur (+ i 1)))))))
(defn- slice [v :vector-i64 start :i64 n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ start i)))))))
(defn- set1 [v :vector-i64 at :i64 x :i64] :vector-i64 (let [o (slice v 0 (vector-count v))] (vector-assoc! o at x)))
(defn- same? [a :vector-i64 b :vector-i64] :bool
  (and (= (vector-count a) (vector-count b))
       (loop [i 0] (if (= i (vector-count a)) true (if (= (vector-at a i) (vector-at b i)) (recur (+ i 1)) false)))))
(defn- refused? [v :vector-i64] :bool (and (= (vector-count v) 1) (= (vector-at v 0) -1)))
(defn- round? [k :i64 n :i64] :bool
  (let [id (pat 32 k) b (pat n (+ k 1))] (same? (w/open (w/seal k id b) k id) b)))
(defn- label [] :vector-i64 (vector-i64 104 97 116 97 46 119 105 114 101 46 118 49 47 114 101 113 117 101 115 116 10))

(defn main [] :i64
  (let [id (pat 32 1) body (pat 10 2) env (w/seal 1 id body)
        hh (pat 32 3) hh2 (pat 32 4)
        r0 (w/request-id hh 0 body)
        mb (w/max-body)
        big (w/seal 2 id (pat mb 5))]
    (+ (if (and (round? 1 0) (round? 2 1) (round? 3 mb) (round? 4 10) (round? 5 1) (round? 6 0)) 1 0)
       (if (and (refused? (w/open (set1 env 0 2) 1 id)) (refused? (w/open env 2 id))
                (refused? (w/open env 1 (pat 32 9))) (refused? (w/open (set1 env 37 11) 1 id))
                (refused? (w/open (set1 env 37 9) 1 id)) (refused? (w/open (slice env 0 47) 1 id))
                (refused? (w/open (cat big (vector-i64 0)) 2 id))) 2 0)
       (if (and (= (vector-count (w/seal 7 id body)) 0) (= (vector-count (w/seal 0 id body)) 0)
                (= (vector-count (w/seal 1 (pat 31 1) body)) 0) (= (vector-count (w/seal 1 id (pat (+ mb 1) 1))) 0)
                (= (vector-count (w/seal 1 id (set1 body 0 256))) 0)) 4 0)
       (if (and (not (same? r0 (w/request-id hh2 0 body))) (not (same? r0 (w/request-id hh 1 body)))
                (not (same? r0 (w/request-id hh 0 (pat 10 3))))
                (same? r0 (h/sha256 (cat (cat (cat (label) hh) (vector-i64 0 0 0 0 0 0 0 0)) body)))
                (same? (w/request-id hh 258 body) (h/sha256 (cat (cat (cat (label) hh) (vector-i64 0 0 0 0 0 0 1 2)) body)))) 8 0)
       (if (and (= (w/reply-kind 1) 2) (= (w/reply-kind 3) 4) (= (w/reply-kind 5) 6)
                (= (w/reply-kind 2) -1) (= (w/reply-kind 6) -1) (= (w/reply-kind 7) -1) (= (w/reply-kind 0) -1)) 16 0)
       (if (= (vector-count big) 65535) 32 0)
       (if (let [resp (w/seal (w/reply-kind 1) r0 body)]
             (and (same? (w/open resp 2 r0) body) (refused? (w/open resp 2 (w/request-id hh 1 body))))) 64 0))))
