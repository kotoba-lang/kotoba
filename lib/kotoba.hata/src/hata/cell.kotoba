;; Port of hata.cell (cell.cljk), Kotoba-native, :document maps. PARTIAL.
;;
;; Ported: open.
;; NOT ported: append. It delegates to hata.ito (ito.cljk), which has no
;; Kotoba port yet, and it takes a `seams` map of functions (E2105).
;;
;; Named divergences from cell.cljk:
;;   - open takes its config as one :document map {:mon-cid :agent-key
;;     :membrane-proof} (as the source destructures it) and a precomputed
;;     boolean `membrane-ok?`. The source's membrane-check-fn is a function
;;     value, which Kotoba does not have; the caller evaluates the membrane
;;     check and passes its result. The check runs even when the other fields
;;     are invalid, as in the source.
;;   - a :problems vector is returned in the same order as the source.

(ns hata.cell
  (:export [open]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- string-doc? [d :document] :bool
  (option-some?-of [:option :string] (document-string-value d)))

(defn open
  "Open a cell. {:ok cell} or {:problems [...]}.

  A cell that refuses its membrane never exists -- there is no half-open cell
  for anything downstream to trip over."
  [cfg :document membrane-ok? :bool] :document
  (let [mon (field cfg :mon-cid)
        agent (field cfg :agent-key)
        p1 (if (string-doc? mon) (document-vector) (document-vector (document-map :problem (document-keyword :no-mon-cid))))
        p2 (if (string-doc? agent) p1 (document-vector-conj p1 (document-map :problem (document-keyword :no-agent-key))))
        problems (if membrane-ok?
                   p2
                   (document-vector-conj p2 (document-map :problem (document-keyword :membrane-refused)
                                                          :mon-cid mon)))]
    (if (= (document-count problems) 0)
      (document-map :ok (document-map :hata.cell/mon-cid mon
                                      :hata.cell/agent-key agent
                                      :hata.cell/ito (document-vector)))
      (document-map :problems problems))))
