(ns hata.seal
  (:export [token pack unpack persist])
  (:require [hata.codec :as c] [hata.store-io :as io] [ed25519.selfhost :as ed]))
;; Internal bounded host snapshots. Distinct tags prevent cross-protocol reuse.
(defn token [tag :string value :vector-i64] :vector-i64
  (c/digest (c/message tag value)))
(defn pack [tag :string value :vector-i64 seed :vector-i64] :string
  (let [sig (vector-alloc 64)
        signed (ed/sign-into sig seed (c/message tag (token tag value)))]
    (if (not= signed 0) ""
      (string-concat tag (string-concat "\n" (string-concat (c/hex value)
        (string-concat "\n" (c/hex sig))))))))
(defn unpack [tag :string text :string pk :vector-i64] :vector-i64
  (let [prefix (string-concat tag "\n")]
    (if (or (> (string-length text) 1048576) (not= (string-index-of text prefix) 0)) (vector-i64)
      (let [rest (string-substring text (string-length prefix) (string-length text))
            split (string-index-of rest "\n")]
        (if (< split 0) (vector-i64)
          (let [value (c/unhex (string-substring rest 0 split))
                sig (c/unhex (string-substring rest (+ split 1) (string-length rest)))]
            (if (and (> (vector-count value) 0) (= (vector-count sig) 64) (c/bytes? sig)
                     (ed/prime-order-key? pk)
                     (ed/verify? pk (c/message tag (token tag value)) sig)) value (vector-i64))))))))
(defn persist [base :string stem :string text :string] :bool
  (let [temp (string-concat base (string-concat "/" (string-concat stem ".pending")))
        final (string-concat base (string-concat "/" stem))]
    (and (> (string-length text) 0) (io/write temp text) (io/sync temp)
         (io/rename temp final) (io/sync base))))
