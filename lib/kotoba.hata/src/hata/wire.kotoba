;; hata.wire -- the envelope every broker exchange travels in over an authenticated
;; ADR-0001 session (lib/kotoba.noise), AWAI-102. Bytes are :vector-i64 of 0..255.
;;
;;   envelope = version (1, = 1) || kind (1) || request id (32) || body length (4, big-endian)
;;              || body; at most 65535 bytes in all, so one envelope is one noise.frame
;;   kinds: 1 vote request, 2 vote response, 3 commit request, 4 commit response,
;;          5 attest request, 6 attest response (a response kind is its request's + 1)
;;
;;   request-id hh seq body -> SHA-256("hata.wire.v1/request\n" || hh || seq (8, big-endian)
;;                             || body): bound to one session (its handshake hash) and one
;;                             position in it, so a request replayed into another session or
;;                             at another position has another id
;;   seal kind id body      -> the envelope; empty for an unknown kind, an id that is not
;;                             32 bytes, a body that does not fit, or a value that is not a byte
;;   open env kind id       -> the body, or [-1] unless env is a whole envelope of exactly
;;                             that version, kind and id (an empty body is valid)
;;   open-request env kind hh seq -> the body of a request envelope whose id is
;;                             request-id(hh, seq, body) for that very body, or [-1]: how the
;;                             receiving side checks a request it could not predict
;;   reply-kind kind        -> the response kind for a request kind, or -1
;; The sequence number and its replay window are the session owner's (one more than the
;; last accepted); this module only binds them into the id.
(ns hata.wire
  (:require [sha2.core :as h])
  (:export [request-id seal open open-request reply-kind max-body]))

(defn max-body [] :i64 65497)
(defn- label [] :vector-i64 (vector-i64 104 97 116 97 46 119 105 114 101 46 118 49 47 114 101 113 117 101 115 116 10))
(defn- cat [a :vector-i64 b :vector-i64] :vector-i64
  (let [na (vector-count a) out (vector-alloc (+ na (vector-count b)))]
    (loop [i 0] (if (= i (vector-count out)) out
      (let [z (vector-assoc! out i (if (< i na) (vector-at a i) (vector-at b (- i na))))] (recur (+ i 1)))))))
(defn- slice [v :vector-i64 start :i64 n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ start i)))))))
(defn- bytes? [v :vector-i64] :bool
  (loop [i 0] (if (= i (vector-count v)) true (if (and (>= (vector-at v i) 0) (<= (vector-at v i) 255)) (recur (+ i 1)) false))))
(defn- same? [a :vector-i64 b :vector-i64] :bool
  (and (= (vector-count a) (vector-count b))
       (loop [i 0] (if (= i (vector-count a)) true (if (= (vector-at a i) (vector-at b i)) (recur (+ i 1)) false)))))
(defn- be [n :i64 width :i64] :vector-i64
  (loop [i 0 out (vector-alloc width)]
    (if (= i width) out (recur (+ i 1) (vector-assoc! out i (bit-and (i64-shift-right n (* 8 (- width i 1))) 255))))))
(defn- kind? [k :i64] :bool (and (>= k 1) (<= k 6)))

(defn reply-kind [kind :i64] :i64 (if (and (kind? kind) (= (rem kind 2) 1)) (+ kind 1) -1))

(defn request-id [hh :vector-i64 seq :i64 body :vector-i64] :vector-i64
  (if (or (not (= (vector-count hh) 32)) (< seq 0) (not (bytes? hh)) (not (bytes? body))) (vector-i64)
    (h/sha256 (cat (cat (cat (label) hh) (be seq 8)) body))))

(defn seal [kind :i64 id :vector-i64 body :vector-i64] :vector-i64
  (if (or (not (kind? kind)) (not (= (vector-count id) 32)) (> (vector-count body) (max-body))
          (not (bytes? id)) (not (bytes? body))) (vector-i64)
    (cat (cat (cat (vector-i64 1 kind) id) (be (vector-count body) 4)) body)))

(defn open [env :vector-i64 kind :i64 id :vector-i64] :vector-i64
  (if (or (< (vector-count env) 38) (> (vector-count env) 65535)) (vector-i64 -1)
    (let [n (+ (* 16777216 (vector-at env 34)) (* 65536 (vector-at env 35)) (* 256 (vector-at env 36)) (vector-at env 37))]
      (if (or (not (= (vector-at env 0) 1)) (not (= (vector-at env 1) kind)) (not (kind? kind))
              (not (same? (slice env 2 32) id)) (not (= (vector-count env) (+ 38 n))))
        (vector-i64 -1)
        (slice env 38 n)))))

(defn open-request [env :vector-i64 kind :i64 hh :vector-i64 seq :i64] :vector-i64
  (if (or (< (vector-count env) 38) (= (rem kind 2) 0)) (vector-i64 -1)
    (let [body (open env kind (slice env 2 32))]
      (if (and (= (vector-count body) 1) (= (vector-at body 0) -1)) body
        (if (same? (slice env 2 32) (request-id hh seq body)) body (vector-i64 -1))))))
