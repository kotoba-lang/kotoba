(ns hata.store-io (:export [exists? read write sync rename lock unlock])
  (:capabilities [:fs/app-data]))
;; Existing native :fs/app-data operations, enforced by the host's granted
;; directory. Callers validate base paths; this module creates no grants.
(defn exists? [path :string] :bool
  (= (typed-cap-call :fs/app-data :string :string (string-concat path "EXISTS_SEP")) "1"))
(defn read [path :string] :string (typed-cap-call :fs/app-data :string :string path))
(defn write [path :string data :string] :bool
  (= (typed-cap-call :fs/app-data :string :string (string-concat path (string-concat "WRITE_SEP" data))) data))
(defn sync [path :string] :bool
  (= (typed-cap-call :fs/app-data :string :string (string-concat path "FSYNC_SEP")) "1"))
(defn rename [from :string to :string] :bool
  (= (typed-cap-call :fs/app-data :string :string (string-concat from (string-concat "RENAME_SEP" to))) "1"))
(defn lock [path :string] :bool
  (= (typed-cap-call :fs/app-data :string :string (string-concat path "FLOCK_SEP")) "1"))
(defn unlock [path :string] :bool
  (= (typed-cap-call :fs/app-data :string :string (string-concat path "UNLOCK_SEP")) "1"))
