(ns hata.codec
  (:export [slice equal? append message digest hex unhex bytes? safe-base?])
  (:require [sha2.core :as sha]))

(defn slice [v :vector-i64 start :i64 count :i64] :vector-i64
  (loop [i 0 out (vector-i64)]
    (if (= i count) out (recur (+ i 1) (vector-conj out (vector-at v (+ start i)))))))
(defn equal? [a :vector-i64 b :vector-i64] :bool
  (and (= (vector-count a) (vector-count b))
       (loop [i 0] (if (= i (vector-count a)) true
         (and (= (vector-at a i) (vector-at b i)) (recur (+ i 1)))))))
(defn append [a :vector-i64 b :vector-i64] :vector-i64
  (loop [i 0 out (slice a 0 (vector-count a))]
    (if (= i (vector-count b)) out (recur (+ i 1) (vector-conj out (vector-at b i))))))
(defn bytes? [v :vector-i64] :bool
  (loop [i 0] (if (= i (vector-count v)) true
    (and (>= (vector-at v i) 0) (<= (vector-at v i) 255) (recur (+ i 1))))))
(defn- word-bytes [word :i64] :vector-i64
  (loop [i 0 out (vector-i64)]
    (if (= i 8) out
      (recur (+ i 1) (vector-conj out (bit-and (u64-shift-right word (* i 8)) 255))))))
(defn message [tag :string words :vector-i64] :vector-i64
  (let [n (string-length tag) out (vector-alloc (+ (+ n 1) (* (vector-count words) 8)))
        prefix (loop [i 0]
                 (if (= i n) (vector-assoc! out n 0)
                   (let [z (vector-assoc! out i (string-code-point-at tag i))] (recur (+ i 1)))))]
    (loop [i 0]
      (if (= i (vector-count words)) out
        (let [z (loop [j 0]
                  (if (= j 8) 0
                    (let [w (vector-assoc! out (+ (+ n 1) (+ (* i 8) j))
                              (bit-and (u64-shift-right (vector-at words i) (* j 8)) 255))]
                      (recur (+ j 1)))))]
          (recur (+ i 1)))))))
(defn- bytes-words [b :vector-i64] :vector-i64
  (loop [i 0 out (vector-i64)]
    (if (= i (vector-count b)) out
      (let [word (loop [j 0 x 0] (if (= j 8) x
                   (recur (+ j 1) (bit-or x (i64-shift-left (vector-at b (+ i j)) (* j 8))))))]
        (recur (+ i 8) (vector-conj out word))))))
(defn digest [bytes :vector-i64] :vector-i64
  (let [out (vector-alloc 4)
        done (arena-scope
               (let [words (bytes-words (sha/sha256 bytes))]
                 (loop [i 0] (if (= i 4) 0
                   (let [z (vector-assoc! out i (vector-at words i))] (recur (+ i 1)))))))] out))
(defn hex [words :vector-i64] :string
  (let [out (vector-alloc (* (vector-count words) 16)) digits "0123456789abcdef"
        done (loop [i 0]
               (if (= i (vector-count words)) 0
                 (let [z (loop [j 0]
                           (if (= j 8) 0
                             (let [byte (bit-and (u64-shift-right (vector-at words i) (* j 8)) 255)
                                   a (vector-assoc! out (+ (* i 16) (* j 2))
                                       (string-code-point-at digits (quot byte 16)))
                                   b (vector-assoc! out (+ (+ (* i 16) (* j 2)) 1)
                                       (string-code-point-at digits (rem byte 16)))] (recur (+ j 1)))))]
                   (recur (+ i 1)))))]
    (string-from-utf8 (bytes-from-vector-i64 out))))
(defn- nibble [c :i64] :i64
  (cond (and (>= c 48) (<= c 57)) (- c 48)
        (and (>= c 97) (<= c 102)) (- c 87) :else -1))
(defn unhex [text :string] :vector-i64
  (if (or (> (string-length text) 1048576) (not= (rem (string-length text) 16) 0))
    (vector-i64)
    (let [bytes (loop [i 0 out (vector-i64)]
                  (if (= i (string-length text)) out
                    (let [a (nibble (string-code-point-at text i))
                          b (nibble (string-code-point-at text (+ i 1)))]
                      (if (or (< a 0) (< b 0)) (vector-i64)
                        (recur (+ i 2) (vector-conj out (+ (* a 16) b)))))))]
      (bytes-words bytes))))
(defn safe-base? [base :string] :bool
  (and (> (string-length base) 1) (< (string-length base) 3800)
       (= (string-code-point-at base 0) 47)
       (< (string-index-of base "_SEP") 0)
       (not= (string-code-point-at base (- (string-length base) 1)) 47)
       (loop [i 1 slash true]
         (if (= i (string-length base)) true
           (let [c (string-code-point-at base i)]
             (and (or (and (>= c 48) (<= c 57)) (and (>= c 65) (<= c 90))
                      (and (>= c 97) (<= c 122)) (= c 45) (= c 95) (= c 47))
                  (not (and slash (= c 47))) (recur (+ i 1) (= c 47))))))))
