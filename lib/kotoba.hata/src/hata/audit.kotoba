(ns hata.audit
  (:export [history extends?])
  (:require [hata.codec :as c] [hata.quorum :as q]))
;; Audit history for the fixed 4/3 roster (AWAI-106). A history is the certified
;; entries 1..K in order: Batch = [count len1 record1 len2 record2 ...] with
;; record = descriptor85 certificate. history returns [K entry-id4] when every
;; entry is certified on this roster, entry k has sequence k and its parent is
;; entry k-1 (zero for entry 1); [0 0 0 0 0] is the empty history and [0] a
;; refusal. A gap, a fork, a forged certificate or trailing bytes never count as
;; success. extends? accepts a later history only when it is valid and holds an
;; earlier accepted head [K entry-id4] at sequence K, so a shorter or diverging
;; history (rollback) is refused. This proves agreement with the roster, not
;; that no newer history exists elsewhere: that needs a fresh read (hata.read)
;; or an external anchor.
(defn- walk [cfg :vector-i64 batch :vector-i64 limit :i64] :vector-i64
  ;; [k id4 ok] after the first min(limit, count) entries; ok 0 on any defect,
  ;; and every entry of the batch is checked even past limit.
  (if (or (not (q/config? cfg)) (< (vector-count batch) 1)
          (< (vector-at batch 0) 0) (> (vector-at batch 0) 256))
    (vector-i64 0 0 0 0 0 0)
    (loop [k 0 cursor 1 prev (vector-i64 0 0 0 0) at (vector-i64 0 0 0 0 0)]
      (cond (= k (vector-at batch 0))
            (if (= cursor (vector-count batch))
              (c/append (if (>= limit k) (c/append (vector-i64 k) prev) at) (vector-i64 1))
              (vector-i64 0 0 0 0 0 0))
            (>= cursor (vector-count batch)) (vector-i64 0 0 0 0 0 0)
            :else
            (let [n (vector-at batch cursor) start (+ cursor 1)]
              (if (or (< n 282) (> (+ start n) (vector-count batch))) (vector-i64 0 0 0 0 0 0)
                (let [desc (c/slice batch start 85) cert (c/slice batch (+ start 85) (- n 85))]
                  (if (and (= (vector-at desc 1) (+ k 1)) (c/equal? (c/slice desc 4 4) prev)
                           (q/descriptor-certificate? cfg desc cert))
                    (let [id (q/entry-id cfg desc)]
                      (recur (+ k 1) (+ start n) id (if (= (+ k 1) limit) (c/append (vector-i64 (+ k 1)) id) at)))
                    (vector-i64 0 0 0 0 0 0)))))))))
(defn history [cfg :vector-i64 batch :vector-i64] :vector-i64
  (let [w (walk cfg batch 256)]
    (if (= (vector-at w 5) 1) (c/slice w 0 5) (vector-i64 0))))
(defn extends? [cfg :vector-i64 head :vector-i64 batch :vector-i64] :bool
  ;; head = [K entry-id4] accepted earlier; K = 0 is the empty history.
  (and (= (vector-count head) 5) (>= (vector-at head 0) 0) (<= (vector-at head 0) 256)
       (let [w (walk cfg batch (vector-at head 0))]
         (and (= (vector-at w 5) 1) (= (vector-at w 0) (vector-at head 0))
              (c/equal? (c/slice w 1 4) (c/slice head 1 4))))))
