;; kotoba-lang/kami-web — portable CLJC (math/render-IR/document) + static demos/
;; Related runtime packages (not hard-required for pure CLJC tests):
;;   webgpu (executor), host (game surface), kami-engine-app-sdk (DOM chrome)
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test
        {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text
        {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  ;; Optional classpath for demo-adjacent development
  :demos {:extra-deps {io.github.kotoba-lang/webgpu {:local/root "../kotoba.webgpu"}
                       io.github.kotoba-lang/host {:local/root "../kotoba.host"}
                       io.github.kotoba-lang/kami-engine-app-sdk {:local/root "../kotoba.kamiEngineAppSdk"}
                       io.github.kotoba-lang/kami-engine-sdk {:local/root "../kotoba.kamiEngineSdk"}}}}}
