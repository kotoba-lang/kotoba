;; test/dirname_test.cljk — build the command and compare it with the
;; system dirname, byte for byte, on every argv below.
;;
;;   AMU_HOME=<amu checkout> kbb --backend sci test/dirname_test.cljk
;;
;; Exits 0 when every case matches, 1 on any difference, 2 when it could not
;; run at all.
(ns dirname-test
  (:require ["fs" :as fs] ["path" :as path] ["os" :as os]))

(def cp (js/require "node:child_process"))

(defn- run [cmd args opts]
  (let [r (.spawnSync cp cmd (clj->js args) (clj->js (merge {:encoding "buffer"} opts)))]
    {:status (.-status r) :out (.-stdout r) :err (.-stderr r)}))

(defn- refuse [message]
  (println (pr-str {:ok false :phase :setup :message message}))
  (.exit js/process 2))

(def amu-home
  (or (.-AMU_HOME js/process.env)
      (let [guess (.resolve path (.cwd js/process) ".." ".." "kotoba-lang" "amu")]
        (when (.existsSync fs (.join path guess "bin" "amu")) guess))))

(def system-dirname "/usr/bin/dirname")

(def cases
  [["/a/b/c.txt"] ["/a/b/"] ["c.txt"] ["/"] ["a"] [""] ["/a//b//"] ["///"] ["//a"] ["//"] ["a/"] ["/a"]
   ["a/b"] ["a//b"] ["/a/b//c/"] ["./x"] ["../x/y"]
   ;; -- and a dash operand
   ["--" "-x"] ["--" "/a/-x"] ["--"]
   ;; Several operands: one line each.
   ["a" "b"] ["/a/b" "c" "/"]
   ;; Multi-byte.
   ["/a/\u65e5\u672c.txt"] ["/\u65e5/\u672c/"] ["\u65e5\u672c"]
   ;; Usage: no operand.
   []])

(when-not amu-home (refuse "set AMU_HOME to an amu checkout"))
(let [amu (.join path amu-home "bin" "amu")
      packager (.join path amu-home "scripts" "package-command.cljk")
      kbb (.join path amu-home "bin" "kbb")]
  (when-not (.existsSync fs amu) (refuse (str "no amu at " amu)))
  (when-not (.existsSync fs system-dirname) (refuse (str "no " system-dirname)))
  (let [tmp (.mkdtempSync fs (.join path (.tmpdir os) "org-ieee-dirname-"))
        src (.resolve path (.cwd js/process) "dirname" "core.kotoba")
        policy (.join path tmp "policy.edn")
        kexe (.join path tmp "dirname.kexe")
        blob (.join path tmp "dirname.bin")
        exe (.join path tmp "dirname")]
    (.writeFileSync fs policy "{:allow #{[:cap/call 37] [:cap/call 38] [:cap/call 39]}}" "utf8")
    (let [c (run "node" [amu "compile" src "--target" "aarch64-macos" "--jvm-free"
                         "--policy" policy "--output" kexe] {})]
      (when (not= 0 (:status c)) (refuse (str "compile failed: " (str (:err c)) (str (:out c))))))
    (let [e (run "node" [amu "extract-native" kexe "--symbol" "main" "--output" blob] {})
          _ (when (not= 0 (:status e)) (refuse (str "extract failed: " (str (:err e)))))
          offset (second (re-find #":offset (\d+)" (str (:out e))))]
      (when-not offset (refuse "no :offset in the extract report"))
      (let [p (run "node" [kbb "--backend" "sci" packager "--code" blob "--offset" offset "--isa" "aarch64"
                           "--allow" "37,38,39" "--output" exe] {})]
        (when (not= 0 (:status p)) (refuse (str "package failed: " (str (:err p)))))))
    (let [b64 (fn [buf] (.toString buf "base64"))
          results
          (for [argv cases]
            (let [k (run exe argv {})
                  s (run system-dirname argv {})
                  same? (and (= (b64 (:out k)) (b64 (:out s)))
                             (= (b64 (:err k)) (b64 (:err s)))
                             (= (:status k) (:status s)))]
              {:argv argv :ok same? :kotoba (.toString (:out k) "utf8") :system (.toString (:out s) "utf8")
               :kotoba-err (.toString (:err k) "utf8") :system-err (.toString (:err s) "utf8")
               :exit [(:status k) (:status s)]}))
          bad (remove :ok results)]
      (doseq [r results]
        (println (str (if (:ok r) "  ok   " "  FAIL ") (pr-str (:argv r)) " -> " (pr-str (:kotoba r))
                      (when-not (:ok r) (str " but " system-dirname " says " (pr-str (:system r))
                                             " exits " (pr-str (:exit r))
                                             " stderr " (pr-str (:kotoba-err r)) " vs " (pr-str (:system-err r)))))))
      (println (pr-str {:ok (empty? bad) :cases (count results) :failed (count bad)}))
      (.exit js/process (if (seq bad) 1 0)))))
