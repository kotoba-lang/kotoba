;; dirname -- POSIX dirname (IEEE Std 1003.1) as a Kotoba command.
;;
;;   dirname STRING [...]     everything before the last path component
;;   dirname -- STRING        STRING may begin with a dash
;;
;; ## Measured, 2026-09-16
;;
;; 399 invocations in 1,268,018 agent Bash calls (superproject
;; ADR-2609161710): `dirname ARG` 140 as a bare word, most of the rest inside
;; `$(dirname "$0")`. /usr/bin/dirname takes SEVERAL operands and answers one
;; line each (measured: `dirname a b` prints two dots, exit 0).
;;
;; The algorithm is POSIX's, checked against /usr/bin/dirname on each edge:
;;   1. ""            -> "."
;;   2. all slashes   -> "/"
;;   3. strip trailing slashes; drop the last component; strip trailing
;;      slashes again
;;   4. nothing left  -> "." (no slash in the string) or "/" (only the root)
;;
;; The walk is FORWARD over slash positions with `string-find-byte` -- a
;; slash is always a code-point boundary, so no offset this constructs lands
;; inside a multi-byte sequence (the sibling `basename` learned that the
;; hard way).
;;
;; Capabilities: :cli/args (38), :io/write (37), :io/write-error (39).
(ns dirname.core (:export [main]))

(defn arg [i :string] :string
  (typed-cap-call :cli/args :string :string i))

(defn emit [s :string] :string
  (typed-cap-call :io/write :string :string s))

(defn emit-error [s :string] :string
  (typed-cap-call :io/write-error :string :string s))

(defn nl [] :string "\n")

(defn digit-text [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn decimal-of [n :i64] :string
  (if (< n 10)
    (digit-text n)
    (string-concat (decimal-of (quot n 10)) (digit-text (- n (* 10 (quot n 10)))))))

(defn argc-from [k :i64 total :string] :i64
  (if (string=? (decimal-of k) total) k (argc-from (+ k 1) total)))

(defn argc [] :i64 (argc-from 0 (arg "")))

;; Two FORWARD walks over the slash positions, and none backwards: a slash
;; is always a code-point boundary, so no offset here is ever inside a
;; multi-byte sequence -- the first cut stepped back a byte at a time and
;; `string-find-byte` refused the continuation byte of 日 (SIGILL, measured
;; 2026-09-16).
;;
;; The first walk finds the last non-empty component: STATE packs its START
;; + 1 in the low word (0 = none seen). A component ends at a slash
;; position, so the answer `S[0, prev-end)` needs no trailing-slash strip.
(defn- walk [s :string from :i64 n :i64 state :i64] :i64
  (if (>= from n)
    state
    (let [i (string-find-byte s 47 from)
          stop (if (< i 0) n i)]
      (if (> stop from)
        (walk s (+ stop 1) n (+ from 1))
        (walk s (+ stop 1) n state)))))

;; The second walk answers the end of the component BEFORE the last one --
;; it stops at the last component's start -- or -1 when there is none.
(defn- end-before [s :string from :i64 last-start :i64 found :i64] :i64
  (if (>= from last-start)
    found
    (let [i (string-find-byte s 47 from)
          stop (if (< i 0) last-start i)]
      (if (> stop from)
        (end-before s (+ stop 1) last-start stop)
        (end-before s (+ stop 1) last-start found)))))

(defn- dir-of [s :string] :string
  (let [n (string-byte-length s)
        state (walk s 0 n 0)]
    (if (= state 0)
      (if (= n 0) "." "/")
      (let [last-start (- state 1)
            prev-end (end-before s 0 last-start -1)]
        (if (< prev-end 0)
          (if (= last-start 0) "." "/")
          (string-substring s 0 prev-end))))))

(defn- usage [] :i64
  (do (emit-error "usage: dirname string [...]")
      (emit-error (nl))
      1))

(defn- each [i :i64 n :i64] :i64
  (if (>= i n)
    0
    (do (emit (dir-of (arg (decimal-of i)))) (emit (nl)) (each (+ i 1) n))))

(defn main [] :i64
  (let [n (argc)]
    (if (= n 0)
      (usage)
      (if (string=? (arg "0") "--")
        (if (= n 1) (usage) (each 1 n))
        (each 0 n)))))
