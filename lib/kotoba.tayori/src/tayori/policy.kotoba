;; Port of tayori.policy (policy.cljk), Kotoba-native, :document values.
;;
;; Pure checks over published tayori facts. Maps are :document maps; cite and
;; redaction collections are :document vectors (a set or list is read through
;; its canonical EDN text, as vector-at traps on sets and lists).
;;
;; Named divergences from policy.cljk:
;;   - `protected-tags` is a zero-arg fn (def cannot be exported, E2005).
;;   - a missing key reads as document-null; a nil collection is empty.
;;   - first-contact? is truthy as in the source: only document-null and
;;     document-bool false are false.
;;   - missing-redactions returns a :document vector in the order of `cites`
;;     (Clojure's vec of a lazy seq; same order).

(ns tayori.policy
  (:export [protected-tags protected-tag? missing-redactions consent-blocked?
            first-contact? target-mismatch?]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- truthy? [v :document] :bool
  (if (document-equal? v (document-null))
    false
    (if (document-equal? v (document-bool false)) false true)))

(defn- first-char [t :string] :string
  (string-substring t 0 1))

;; The elements of a collection as a :document vector. A vector is itself;
;; a set or list is re-read from its EDN text; nil is empty.
(defn- elems [d :document] :document
  (let [t (document-edn-print d)
        c (first-char t)]
    (if (string=? t "nil")
      (document-vector)
      (if (string=? c "[")
        d
        (if (string=? c "#")
          (document-edn-read (string-concat "[" (string-concat (string-substring t 2 (- (string-length t) 1)) "]")))
          (if (string=? c "(")
            (document-edn-read (string-concat "[" (string-concat (string-substring t 1 (- (string-length t) 1)) "]")))
            (document-vector)))))))

(defn- vec-at [v :document i :i64] :document
  (option-or (document-vector-at v i) (document-null)))

(defn- has-doc? [v :document x :document] :bool
  (loop [i 0]
    (if (= i (document-count v))
      false
      (if (document-equal? (vec-at v i) x) true (recur (+ i 1))))))

(defn protected-tags [] :document
  (document-set (document-keyword :health) (document-keyword :legal) (document-keyword :financial)))

(defn protected-tag? [cite :document] :bool
  (document-set-contains? (protected-tags) cite))

(defn missing-redactions [cites :document redactions :document] :document
  (let [cs (elems cites)
        rs (elems redactions)]
    (loop [i 0 out (document-vector)]
      (if (= i (document-count cs))
        out
        (let [c (vec-at cs i)]
          (recur (+ i 1)
                 (if (protected-tag? c)
                   (if (has-doc? rs c) out (document-vector-conj out c))
                   out)))))))

(defn consent-blocked? [contact :document] :bool
  (document-equal? (field contact :consent) (document-keyword :blocked)))

(defn first-contact? [contact :document] :bool
  (truthy? (field contact :first-contact?)))

(defn target-mismatch? [document :document target :document] :bool
  (if (document-equal? target (field document :path)) false true))
