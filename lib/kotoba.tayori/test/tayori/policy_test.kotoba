(ns tayori.policy-test (:export [main]) (:require [tayori.policy :as p]))

(defn- kw [k :keyword] :document (document-keyword k))

(defn- case-tags [] :i64
  (+ (if (p/protected-tag? (kw :health)) 0 1)
     (if (p/protected-tag? (kw :legal)) 0 1)
     (if (p/protected-tag? (kw :financial)) 0 1)
     (if (p/protected-tag? (kw :marketing)) 1 0)
     (if (p/protected-tag? (document-string "health")) 1 0)))

(defn- case-missing [] :i64
  (let [cites (document-vector (kw :health) (kw :marketing) (kw :legal) (kw :financial))
        redactions (document-vector (kw :legal))
        out (p/missing-redactions cites redactions)]
    (+ (if (document-equal? out (document-vector (kw :health) (kw :financial))) 0 1)
       (if (document-equal? (p/missing-redactions cites (document-null)) (document-vector (kw :health) (kw :legal) (kw :financial))) 0 1)
       (if (document-equal? (p/missing-redactions (document-vector (kw :marketing)) (document-null)) (document-vector)) 0 1)
       (if (document-equal? (p/missing-redactions (document-null) (document-null)) (document-vector)) 0 1)
       (if (document-equal? (p/missing-redactions cites (document-set (kw :health) (kw :financial) (kw :legal))) (document-vector))
           0 1))))

(defn- case-missing-redactions-only-set [] :i64
  ;; a redaction set counts as membership (the source uses (set redactions))
  (if (document-equal? (p/missing-redactions (document-vector (kw :health)) (document-set (kw :health)))
                       (document-vector))
      0 1))

(defn- case-consent [] :i64
  (let [blocked (document-map :consent (kw :blocked))
        known (document-map :consent (kw :known))
        none (document-map :name (document-string "x"))]
    (+ (if (p/consent-blocked? blocked) 0 1)
       (if (p/consent-blocked? known) 1 0)
       (if (p/consent-blocked? none) 1 0)
       (if (p/consent-blocked? (document-null)) 1 0))))

(defn- case-first-contact [] :i64
  (+ (if (p/first-contact? (document-map :first-contact? (document-bool true))) 0 1)
     (if (p/first-contact? (document-map :first-contact? (document-bool false))) 1 0)
     (if (p/first-contact? (document-map :first-contact? (document-i64 0))) 0 1)
     (if (p/first-contact? (document-map :first-contact? (document-null))) 1 0)
     (if (p/first-contact? (document-map)) 1 0)))

(defn- case-target [] :i64
  (let [doc (document-map :path (document-string "/a/b"))]
    (+ (if (p/target-mismatch? doc (document-string "/a/b")) 1 0)
       (if (p/target-mismatch? doc (document-string "/a/c")) 0 1)
       (if (p/target-mismatch? doc (document-null)) 0 1))))

(defn main [] :i64
  (+ (case-tags) (case-missing) (case-missing-redactions-only-set) (case-consent) (case-first-contact) (case-target)))
