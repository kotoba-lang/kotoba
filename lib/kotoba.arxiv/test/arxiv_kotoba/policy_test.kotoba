(ns arxiv-kotoba.policy-test (:export [main]) (:require [arxiv-kotoba.policy :as p]))

(defn- kget [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))

(defn- risk-is [cap :document k :keyword] :i64
  (if (document-equal? (p/risk-of cap) (document-keyword k)) 0 1))

(defn- bool-is [b :bool] :i64
  (if b 0 1))

(defn main [] :i64
  (let [ro (document-map :risk (document-keyword :read-only))
        ea (document-map :risk (document-keyword :external-auth))
        ro-human (document-map :risk (document-keyword :read-only)
                               :requires (document-vector (document-keyword :human-approval)))
        ro-set (document-map :risk (document-keyword :read-only)
                             :requires (document-set (document-keyword :human-approval)))
        none (document-map)
        ok-auto (document-map :approved? (document-bool true))
        rank (option-value-of [:option :i64]
                              (document-i64-value (kget (p/risk-rank) :public-submit)) -1)
        ro-mode (kget (p/default-autonomy) :read-only)]
    (+ (risk-is none :destructive)
       (risk-is ea :external-auth)
       (bool-is (not (p/approval-required? ro)))
       (bool-is (p/approval-required? ea))
       (bool-is (p/approval-required? ro-human))
       (bool-is (p/approval-required? ro-set))
       (bool-is (p/allowed? none ro))
       (bool-is (not (p/allowed? none ea)))
       (bool-is (p/allowed? ok-auto ea))
       (if (= rank 3) 0 1)
       (if (document-equal? ro-mode (document-keyword :auto)) 0 1))))
