#!/usr/bin/env bash
# arxiv-submit — run browser submission for a package.edn
#
# Usage:
#   export ARXIV_USER ARXIV_PASSWORD   # or use --op-item
#   bin/arxiv-submit submissions/sqrt-space-kv
#   bin/arxiv-submit submissions/sqrt-space-kv --stop-after start
#   APPROVE_FINAL=1 bin/arxiv-submit submissions/sqrt-space-kv --stop-after final
#
# Credentials (recommended):
#   bin/arxiv-submit submissions/sqrt-space-kv --op-item 'Arxiv - N24' --op-vault Private
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PYTHONPATH="${ROOT}/browser${PYTHONPATH:+:$PYTHONPATH}"
# prefer repo venv (uv venv .venv && uv pip install -r browser/requirements.txt)
if [[ -x "${ROOT}/.venv/bin/python" ]]; then
  PYTHON="${ROOT}/.venv/bin/python"
else
  PYTHON="${PYTHON:-python3}"
fi

OP_ITEM=""
OP_VAULT="Private"
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --op-item) OP_ITEM="$2"; shift 2 ;;
    --op-vault) OP_VAULT="$2"; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

if [[ -n "$OP_ITEM" ]]; then
  export ARXIV_USER
  export ARXIV_PASSWORD
  ARXIV_USER="$(op item get "$OP_ITEM" --vault "$OP_VAULT" --fields username --reveal)"
  ARXIV_PASSWORD="$(op item get "$OP_ITEM" --vault "$OP_VAULT" --fields password --reveal)"
fi

if [[ -z "${ARXIV_USER:-}" || -z "${ARXIV_PASSWORD:-}" ]]; then
  echo "Set ARXIV_USER/ARXIV_PASSWORD or pass --op-item 'Arxiv - N24'" >&2
  exit 2
fi

# default package path relative to repo root
if [[ ${#ARGS[@]} -eq 0 ]]; then
  ARGS=(--package submissions/sqrt-space-kv)
elif [[ "${ARGS[0]}" != --* ]]; then
  # first positional is package dir
  PKG="${ARGS[0]}"
  ARGS=(--package "$PKG" "${ARGS[@]:1}")
fi

cd "$ROOT"
exec "$PYTHON" -m arxiv_submit "${ARGS[@]}"
