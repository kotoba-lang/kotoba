;; arxiv-kotoba.dialogue -- deterministic dialogue seed. Kotoba port of
;; dialogue.cljk (same ns, same public names: respond).
;;
;; Named divergences from dialogue.cljk:
;;   - respond takes the record `Input` {text} instead of a destructured map,
;;     and returns the record `Reply` {status text} instead of a map.
;;     `make-input` is the public constructor: qualified `->Input` calls are
;;     not admitted across modules (E6004).
;;   - `str/lower` is `ascii-lower` (kotoba.lang.text has no Unicode lower).
;;     Non-ASCII letters are not case-folded; the matched keywords are ASCII.
(ns arxiv-kotoba.dialogue
  (:require [kotoba.lang.text :as str]))

(defrecord Input [text :string])

(defrecord Reply [status :keyword text :string])

(defn make-input [text :string] [:record :arxiv-kotoba.dialogue/Input [[:text :string]]]
  (->Input text))

(defn respond [input [:record :arxiv-kotoba.dialogue/Input [[:text :string]]]] [:record :arxiv-kotoba.dialogue/Reply [[:status :keyword] [:text :string]]]
  (let [t (str/ascii-lower (:text input))]
    (if (str/includes? t "category")
      (->Reply :ok "I can advise categories from the local EDN facts, then route validation through :arxiv/advise-categories.")
      (if (or (str/includes? t "submit") (str/includes? t "submission"))
        (->Reply :ok "I can prepare a draft submission, but final arXiv submit requires human approval.")
        (->Reply :ok "I represent arXiv-facing workflows as an organism actor. Use functional ops for execution.")))))
