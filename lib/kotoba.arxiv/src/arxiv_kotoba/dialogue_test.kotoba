;; Behavior check for arxiv-kotoba.dialogue (dialogue.kotoba). main returns the
;; number of failed cases; 0 means all pass.
(ns arxiv-kotoba.dialogue-test
  (:require [arxiv-kotoba.dialogue :as d]))

(defn check [ok :bool] :i64
  (if ok 0 1))

(defn main [] :i64
  (let [cat (d/respond (d/make-input "Which CATEGORY fits?"))
        sub (d/respond (d/make-input "I want a submission"))
        other (d/respond (d/make-input "hello"))]
    (+ (check (= (:status cat) :ok))
       (check (string=? (:text cat) "I can advise categories from the local EDN facts, then route validation through :arxiv/advise-categories."))
       (check (string=? (:text sub) "I can prepare a draft submission, but final arXiv submit requires human approval."))
       (check (string=? (:text other) "I represent arXiv-facing workflows as an organism actor. Use functional ops for execution.")))))
