;; Port of arxiv-kotoba.policy (policy.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from policy.cljk:
;;   - risk-rank and default-autonomy are zero-arg functions (cross-module
;;     constants are not exportable in amu).
;;   - approval-required? is the 1-arity form; the 2-arity form is
;;     approval-required-under? (multi-arity defns are not expressible, E2138).
;;   - `(or x default)` treats nil and false as absent.
;;   - :requires may be a vector or a set; any other value (including a list)
;;     is read as having no :human-approval. The source's (set x) accepts a
;;     list too; that case is not ported.

(ns arxiv-kotoba.policy
  (:export [risk-rank default-autonomy risk-of approval-required?
            approval-required-under? allowed?]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- null-doc? [d :document] :bool
  (string=? (document-edn-print d) (document-edn-print (document-null))))

(defn- or-default [v :document d :document] :document
  (if (or (null-doc? v) (document-equal? v (document-bool false)))
    d
    v))

(defn- seq-has? [v :document x :document] :bool
  (loop [i 0]
    (if (< i (document-count v))
      (if (document-equal? (option-value-of [:option :document] (document-vector-at v i) (document-null)) x)
        true
        (recur (+ i 1)))
      false)))

(defn- requires-has? [requires :document k :document] :bool
  (let [kind (document-kind requires)]
    (if (= kind :set)
      (document-set-contains? requires k)
      (if (= kind :vector)
        (seq-has? requires k)
        false))))

(defn- has-human-approval? [requires :document] :bool
  (requires-has? requires (document-keyword :human-approval)))

(defn risk-rank [] :document
  (document-map :read-only (document-i64 0)
                :external-auth (document-i64 1)
                :external-draft (document-i64 2)
                :public-submit (document-i64 3)
                :destructive (document-i64 4)))

(defn default-autonomy [] :document
  (document-map :read-only (document-keyword :auto)
                :external-auth (document-keyword :approve)
                :external-draft (document-keyword :approve)
                :public-submit (document-keyword :approve)
                :destructive (document-keyword :approve)))

(defn risk-of [capability :document] :document
  (or-default (field capability :risk) (document-keyword :destructive)))

(defn approval-required? [capability :document] :bool
  (approval-required-under? (default-autonomy) capability))

(defn approval-required-under? [autonomy :document capability :document] :bool
  (let [a (or-default autonomy (default-autonomy))
        mode (option-value-of [:option :document]
                              (document-get a (risk-of capability))
                              (document-keyword :approve))]
    (or (has-human-approval? (field capability :requires))
        (not (document-equal? mode (document-keyword :auto))))))

(defn allowed? [opts :document capability :document] :bool
  (or (not (approval-required-under? (field opts :autonomy) capability))
      (option-value-of [:option :bool] (document-bool-value (field opts :approved?)) false)))
