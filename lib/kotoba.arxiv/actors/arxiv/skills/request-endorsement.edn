{:skill/id :arxiv.request-endorsement
 :skill/uses :yorishiro/arxiv
 :skill/risk :external-draft
 :skill/params [:package-dir :primary-category :draft-id]
 :skill/doc
 "Handle arXiv Start-page endorsement block.

  When Continue on /submit/<id>/start returns
  'You are not endorsed for this archive', open
  https://arxiv.org/auth/need-endorsement.php?category_id=<primary>
  which shows a unique endorsement code and emails it to the account.

  Human must forward that email to a *qualified* endorser (3 papers in
  related cs.* in last 5 years, older than 3 months). Runner records
  code + URL in status.edn; never invents or spams endorsers; never
  switches to an unrelated archive solely to bypass endorsement."
 :skill/routes
 [{:route/id :computer
   :steps
   [{:do :run
     :argv ["bin/arxiv-submit"
            [:param :package-dir]
            "--stop-after" "endorsement"
            "--resume-draft" [:param :draft-id]
            "--op-item" "Arxiv - N24"]
     :cwd :arxiv-repo-root
     :expect-status :pending-endorsement}]}
  {:route/id :browser-dom
   :steps
   [{:do :navigate
     :url [:str "https://arxiv.org/submit/" [:param :draft-id] "/start"]}
    {:do :click :match {:text "request endorsement"}}
    {:do :extract
     :match {:regex "unique endorsement code is:\\s*([A-Z0-9]+)"}
     :as :endorsement-code}
    {:do :screenshot :as "arxiv-endorsement-request"}
    {:do :checkpoint
     :id :endorsement-hold
     :payload {:hold-reason :endorsement-required
               :next-action :forward-code-to-qualified-endorser
               :primary [:param :primary-category]
               :draft-id [:param :draft-id]
               :help-url "https://info.arxiv.org/help/endorsement.html"
               :notes
               ["status.edn state = :pending-endorsement until endorser acts"
                "Do not submit to an unrelated archive solely to bypass endorsement."]}]}]}
  {:route/id :local
   :steps
   [{:do :checkpoint
     :id :endorsement-hold
     :payload {:hold-reason :endorsement-required
               :help-url "https://info.arxiv.org/help/endorsement.html"}}]}]}
