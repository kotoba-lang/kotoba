[{:db/id -1, :skill/id :arxiv.create-submission, :skill/uses :yorishiro/arxiv, :skill/risk :external-draft, :skill/params [:paper-dir :title :abstract :categories :package-dir], :skill/doc "Start a new arXiv draft (START NEW SUBMISSION) or resume package draft-id.\n  Prefer the computer route which runs browser/arxiv_submit (Playwright).", :skill/routes "[{:route/id :computer, :prefer 1, :steps [{:do :run, :argv [\"python\" \"-m\" \"arxiv_submit\" \"--package\" [:param :package-dir] \"--stop-after\" \"start\"], :cwd :arxiv-repo-root, :env {:ARXIV_USER {:secret :arxiv/user}, :ARXIV_PASSWORD {:secret :arxiv/password}}}]} {:route/id :browser-dom, :prefer 50, :steps [{:do :navigate, :url \"https://arxiv.org/user/\"} {:do :click, :match {:text \"START NEW SUBMISSION\"}} {:do :checkpoint, :id :draft-created} {:do :invoke-skill, :skill :arxiv.fill-start-form} {:do :screenshot, :as \"arxiv-draft-created\"}]}]"}]