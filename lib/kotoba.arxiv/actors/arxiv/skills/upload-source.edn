[{:db/id -1, :skill/id :arxiv.upload-source, :skill/uses :yorishiro/arxiv, :skill/risk :external-draft, :skill/params [:draft-id :source-archive], :skill/routes "[{:route/id :browser-dom, :steps [{:do :navigate, :url [:str \"https://arxiv.org/submit/\" [:param :draft-id] \"/file\"]} {:do :assert, :match {:css \"input[type=file]\"}} {:do :set-input-files, :match {:css \"input[type=file]\"}, :path [:param :source-archive]} {:do :click, :match {:text \"Upload files\"}} {:do :wait, :ms 3000} {:do :screenshot, :as \"arxiv-upload-source\"} {:do :checkpoint, :id :source-uploaded}]} {:route/id :computer, :steps [{:do :run, :argv [\"python\" \"-m\" \"arxiv_submit\" \"--package\" [:param :package-dir] \"--stop-after\" \"upload\" \"--resume-draft\" [:param :draft-id]]}]}]"}]