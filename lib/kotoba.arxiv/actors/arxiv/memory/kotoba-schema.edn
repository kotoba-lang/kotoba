{:schema/id :arxiv-submission-memory
 :schema/target :kotoba
 :schema/purpose
 "Durable actor memory for arXiv-facing submission workflows. Store replayable facts, not browser cookies, passwords, or unpublished private reviewer notes."
 :entities
 {:submission
  {:id :string
   :title :string
   :primary-category :string
   :cross-lists [:string]
   :state :keyword
   :source-archive :string
   :pdf :string}
  :attempt
  {:id :string
   :submission :ref
   :at :instant
   :url :string
   :primary-category :string
   :cross-lists [:string]
   :result :keyword
   :server-message :string}
  :approval
  {:id :string
   :submission :ref
   :kind :keyword
   :requested-at :instant
   :approved-at :instant
   :approved-by :string}
  :actor-checkpoint
  {:id :string
   :submission :ref
   :actor :keyword
   :op :keyword
   :state :keyword
   :input-cid :string
   :output-cid :string}}
 :events
 [{:event :submission/category-selected
   :datoms [[:submission/id]
            [:submission/primary-category]
            [:submission/cross-lists]]}
  {:event :submission/attempt-recorded
   :datoms [[:attempt/submission]
            [:attempt/at]
            [:attempt/result]
            [:attempt/server-message]]}
  {:event :submission/endorsement-hold-recorded
   :datoms [[:submission/state :endorsement-hold]
            [:attempt/result :hold]]}
  {:event :submission/human-approval-recorded
   :datoms [[:approval/kind :final-submit]
            [:approval/approved-at]
            [:approval/approved-by]]}
  {:event :actor/checkpoint-recorded
   :datoms [[:actor-checkpoint/actor]
            [:actor-checkpoint/op]
            [:actor-checkpoint/state]
            [:actor-checkpoint/input-cid]
            [:actor-checkpoint/output-cid]]}]
 :queries
 {:current-state
  [:find ?state .
    :in $ ?submission
    :where [?s :submission/id ?submission]
           [?s :submission/state ?state]]
  :latest-blocker
  [:find ?category ?message .
    :in $ ?submission
    :where [?s :submission/id ?submission]
           [?a :attempt/submission ?s]
           [?a :attempt/result :hold]
           [?a :attempt/primary-category ?category]
           [?a :attempt/server-message ?message]]
  :pending-human-approvals
  [:find ?kind .
    :in $ ?submission
    :where [?s :submission/id ?submission]
           [?ap :approval/submission ?s]
           [?ap :approval/kind ?kind]
           (not [?ap :approval/approved-at])]}
 :privacy
 {:never-store [:password :cookie :session-token :one-time-code]
  :store-by-reference [:source-archive :pdf]
  :redact-server-fields [:email :user-id]}}
