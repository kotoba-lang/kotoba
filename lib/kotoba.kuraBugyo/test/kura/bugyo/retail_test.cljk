(ns kura.bugyo.retail-test
  "The retail plane, and the one thing it is for: the same bytes are
  loss-making sold by the terabyte and profitable sold as a subscription, and
  a report that does not say which basis it is on is worse than either number."
  (:require [kotoba.test :refer [deftest is testing]]
            [kura.bugyo.budget :as budget]
            [kura.bugyo.pricing :as pricing]))

(def launch pricing/launch-layout)
(def rates (pricing/rates {}))
(def pol (budget/policy {:monthly-usd-cap 25.00}))

;; Phase 0 as it actually stands: everything on rented B2.
(def b2-basis (budget/cost-basis launch {:backblaze-b2 1.0}))

(defn- tier [k] (first (filter #(= k (:tier %)) pricing/default-tiers)))
(defn- econ [k] (pricing/tier-economics (tier k) b2-basis pricing/default-fx))

(deftest the-cost-basis-is-the-provider-bill-not-the-node-rate-card
  (testing "a rented fleet does not buy storage at what it pays a node to hold
            it, and pricing a subscription off the node rate would understate
            the bill by a factor of four"
    (is (= 6.95 (:usd-physical-tb-month b2-basis)))
    (is (= 2.0 (:coded-multiplier b2-basis)))
    (is (not= (:usd-physical-tb-month b2-basis)
              (get-in rates [:node-storage-usd-tb-month :value])))))

(deftest the-object-quota-bounds-the-replication-exposure
  (testing "sub-mebibyte objects are replicated three ways rather than coded,
            which looks like it breaks a per-byte price — until you notice the
            byte quota cannot be filled with them"
    (let [t (tier :standard)
          e (econ :standard)
          ;; 50 GiB of sub-MiB objects would need 51,200 of them
          needed (quot (:quota-bytes t) (:replication-threshold-bytes b2-basis))]
      (is (= 51200 needed))
      (is (> needed (:quota-objects t))
          "the pin cap makes an all-small workload unable to reach the byte cap")
      (is (< 0.005 (/ (:small-object-penalty-usd e) (:cost-if-all-objects-large-usd e)) 0.015)
          (str "so the worst case lands ~1% above the flat coded figure, got "
               (/ (:small-object-penalty-usd e) (:cost-if-all-objects-large-usd e)))))))

(deftest the-worst-case-is-the-byte-quota-arm-not-the-object-quota-arm
  (testing "both arrangements are priced and the more expensive one wins —
            asserted because taking only the flat figure would be right by
            accident here and wrong for any tier with a looser object cap"
    (let [t {:tier :toy :jpy-month 1000 :quota-bytes 1048576 :quota-objects 10000}]
      ;; 10,000 slots against a 1 MiB byte cap: every object CAN be small, so
      ;; the object-quota arm is the binding one and replication wins.
      (is (= (* 1048576 3.0) (pricing/worst-case-physical-bytes t b2-basis))
          "when the object cap is loose the small-object arm is the worst case"))))

(deftest a-quota-tier-does-not-price-per-terabyte
  (testing "the finding that makes B2-backed viable: a subscription is not
            anchored to $/TB, so the storage multiplier that dominates the
            wholesale card is a rounding error here"
    (doseq [k [:standard :pro]]
      (let [e (econ k)]
        (is (> (:storage-gross-margin e) 0.90)
            (str (name k) " keeps over 90% at the worst case its quota allows"))
        (is (> (:versus-storj-retail-multiple e) 30.0)
            (str (name k) " implies a $/TB price tens of times Storj retail — "
                 "which is what it means for the price not to be per-terabyte"))))
    (testing "and the bigger plan is the cheaper one per byte, as a plan should be"
      (is (< (:implied-usd-logical-tb-month (econ :pro))
             (:implied-usd-logical-tb-month (econ :standard)))))))

(deftest the-margin-carries-the-scope-it-covers
  (testing "a 96% figure named only `margin` gets read as a business margin the
            first time it is published — so the number travels with what it
            leaves out, and the largest excluded item is priced next to it"
    (let [e (econ :standard)]
      (is (contains? e :storage-gross-margin) "not :margin, and not :margin-at-full-quota")
      (is (some #{"egress"} (:cost-excludes e)))
      (is (>= (count (:cost-excludes e)) 5)
          "naming only egress would imply the rest are covered")
      (is (some #(re-find #"storage-gross-margin" %)
                (:caveats (pricing/retail-card b2-basis)))
          "and the card says so where a reader of the table will see it"))))

(deftest no-margin-is-reported-on-zero-revenue
  (testing "a free tier has a cost and no margin; reporting 0 or -Inf would
            both be claims about a quantity that does not exist"
    (let [e (econ :free)]
      (is (nil? (:storage-gross-margin e)))
      (is (pos? (:cost-usd-month e)) "the cost is real and is reported")
      (is (neg? (:gross-profit-usd-month e))))))

(deftest a-plan-without-a-quota-is-uncomputable-not-estimated
  (let [e (econ :regulated)]
    (is (= :uncomputable (:economics e)))
    (is (seq (:why e)))
    (is (nil? (:storage-gross-margin e))
        "no quota, no worst case, no margin — and no invented one")))

(deftest egress-is-what-threatens-the-margin-not-storage
  (testing "storage headroom is enormous and egress headroom is not, which is
            the opposite of where attention goes by default"
    (doseq [k [:standard :pro]]
      (let [e (econ k)
            g (pricing/egress-headroom e (:backblaze-b2 pricing/default-egress-terms))]
        (is (< 20.0 (:breakeven-reads-of-full-quota g) 60.0)
            (str (name k) ": a subscriber may read their whole quota a few "
                 "dozen times a month before the gross profit is gone, got "
                 (:breakeven-reads-of-full-quota g)))
        (is (pos? (:free-egress-tb g))
            "B2's free allowance is a multiple of what it HOLDS, so the code's
             multiplier enlarges the allowance without enlarging the bill")))))

(deftest the-two-bases-disagree-about-the-same-bytes
  (testing "this is the whole reason the retail plane exists: identical usage,
            identical provider bill, one basis reports a loss and the other a
            26x profit — so an unlabelled margin is unreadable"
    (let [subs {:standard 3}
          physical (long (* 3 (:worst-case-physical-bytes (econ :standard))))
          usage {:backblaze-b2 physical}
          w (budget/report pol rates launch usage)
          r (budget/retail-report pol usage subs launch {:backblaze-b2 1.0})]
      (is (= :wholesale (:basis w)))
      (is (= :retail (:basis r)))
      (is (= (:cost-usd-month w) (:cost-usd-month r))
          "the bill is the same number on both bases — only revenue differs")
      (is (true? (:loss-making? w)) "sold by the terabyte at the node rate card")
      (is (false? (:loss-making? r)) "sold as three subscriptions")
      (is (> (:net-usd-month r) (* 20 (Math/abs (double (:net-usd-month w))))))
      (is (seq (:basis-note w))
          "and the wholesale report names its own basis rather than leaving
           :loss-making? to be read as a verdict on the business"))))

(deftest zero-subscriptions-is-a-stage-not-a-defect
  (testing "with no customers the retail basis is also loss-making, and the
            report distinguishes *no revenue yet* from *the price does not
            cover the cost* — they are the same sign and different findings"
    (let [r (budget/retail-report pol {:backblaze-b2 (long 6e10)} {} launch
                                  {:backblaze-b2 1.0})]
      (is (true? (:loss-making? r)))
      (is (zero? (:paying-subscriptions r)))
      (is (re-find #"no paying subscriptions" (:why r)))))
  (testing "and a free subscriber is not counted as paying"
    (let [r (budget/retail-report pol {} {:free 40} launch {:backblaze-b2 1.0})]
      (is (zero? (:paying-subscriptions r)))
      (is (zero? (:revenue-usd-month r))))))

(deftest retail-tables-never-claim-to-be-observed
  (testing "the same discipline the node rate card holds itself to — nothing
            may claim to be measured on kura until kura has measured it"
    (is (every? #(contains? #{:adopted} (:provenance %)) pricing/default-tiers))
    (is (every? #(seq (:source %)) pricing/default-tiers)
        "an adopted figure without a source is a guess wearing a better label")
    (is (= :assumed (get-in pricing/default-fx [:jpy-per-usd :provenance]))
        "the exchange rate is assumed, not read — it moves every day")
    (is (= :published (get-in pricing/default-egress-terms
                              [:backblaze-b2 :provenance])))
    (is (seq (get-in pricing/default-egress-terms [:backblaze-b2 :source])))))

(deftest the-margin-survives-the-exchange-rate-being-wrong
  (testing "revenue is denominated in JPY, so the rate only moves the framing —
            and the conclusion has to hold across any plausible one"
    (doseq [jpy [100.0 150.0 200.0]]
      (let [fx {:jpy-per-usd {:value jpy :provenance :supplied}}
            e (pricing/tier-economics (tier :standard) b2-basis fx)]
        (is (> (:storage-gross-margin e) 0.90)
            (str "at " jpy " yen to the dollar, got "
                 (:storage-gross-margin e)))))))

(deftest the-card-carries-its-caveats
  (testing "attached to the numbers rather than to a document nobody opens"
    (let [c (pricing/retail-card b2-basis)]
      (is (= :retail (:basis c)))
      (is (= 4 (count (:tiers c))))
      (is (>= (count (:caveats c)) 5))
      (is (some #(re-find #"ceiling" %) (:caveats c))
          "a quota is a ceiling, so every margin is a floor")
      (is (some #(re-find #"[Ee]gress" %) (:caveats c)))
      (is (some #(re-find #"ADOPTED|adopted" %) (:caveats c))))))
