(ns kura.bugyo.cljs-runner
  (:require [kotoba.test :as t :refer [run-tests]]
            [kura.bugyo.budget-test]
            [kura.bugyo.economics-test]
            ;; plane-test was JVM-only, so the :cljs branch of its reader
            ;; conditionals had never actually run. A reader conditional you
            ;; have not executed is a guess about the other host.
            [kura.bugyo.plane-test]
            [kura.bugyo.retail-test]))
#?(:cljs
   (defmethod t/report [:cljs.test/default :end-run-tests] [m]
     (when-not (t/successful? m) (set! (.-exitCode js/process) 1))))
(defn -main [] (run-tests 'kura.bugyo.economics-test 'kura.bugyo.budget-test
                        'kura.bugyo.plane-test 'kura.bugyo.retail-test))
