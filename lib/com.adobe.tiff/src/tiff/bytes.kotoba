(ns tiff.bytes
  "Portable read cursor over a sequence of unsigned byte values (0-255).
   Kotoba port of tiff.bytes (bytes.cljk). Self-contained, no dependencies.

   Named divergences from bytes.cljk (Kotoba has no mutable record fields,
   no atom-typed parameters and no `reverse`/`subvec`):
   - The cursor is an immutable record {:data :pos}. The .cljk cursor held
     its position in an atom and `read-bytes!` mutated it. Here the caller
     threads the position: `read-bytes!` and `uint!` return a record that
     carries the new `:pos`, and the caller builds the next cursor with
     `cursor-at`.
   - EOF does not throw (a thrown abort at a public function is refused at
     the export boundary, E2130). Reads return `:ok false` instead, with the
     position unchanged; the .cljk ex-info payload (pos/n/len) is not kept.
   - `uint!` computes the value by index instead of reversing the slice; the
     result is the same for both byte orders.")

(defn cursor [data [:list :i64]] [:record :tiff.bytes/cursor [[:data [:list :i64]] [:pos :i64]]]
  (record [:record :tiff.bytes/cursor [[:data [:list :i64]] [:pos :i64]]] data 0))

(defn cursor-at [c [:record :tiff.bytes/cursor [[:data [:list :i64]] [:pos :i64]]] pos :i64]
  [:record :tiff.bytes/cursor [[:data [:list :i64]] [:pos :i64]]]
  (record [:record :tiff.bytes/cursor [[:data [:list :i64]] [:pos :i64]]] (:data c) pos))

(defn- slice [data [:list :i64] start :i64 n :i64] [:list :i64]
  (loop [i 0 out (list)]
    (if (< i n)
      (recur (+ i 1) (conj out (nth data (+ start i))))
      out)))

(defn read-bytes! [c [:record :tiff.bytes/cursor [[:data [:list :i64]] [:pos :i64]]] n :i64]
  [:record :tiff.bytes/read [[:ok :bool] [:bytes [:list :i64]] [:pos :i64]]]
  (let [p (:pos c)
        end (+ p n)]
    (if (> end (count (:data c)))
      (record [:record :tiff.bytes/read [[:ok :bool] [:bytes [:list :i64]] [:pos :i64]]]
              false (list) p)
      (record [:record :tiff.bytes/read [[:ok :bool] [:bytes [:list :i64]] [:pos :i64]]]
              true (slice (:data c) p n) end))))

(defn uint!
  "Read an `n`-byte unsigned integer at the cursor. `big?` selects byte order.
   Returns {:ok :value :pos}; on EOF :ok is false and :pos is unchanged."
  [c [:record :tiff.bytes/cursor [[:data [:list :i64]] [:pos :i64]]] n :i64 big? :bool]
  [:record :tiff.bytes/uint [[:ok :bool] [:value :i64] [:pos :i64]]]
  (let [r (read-bytes! c n)
        bs (:bytes r)]
    (record [:record :tiff.bytes/uint [[:ok :bool] [:value :i64] [:pos :i64]]]
            (:ok r)
            (if (:ok r)
              (loop [i 0 acc 0]
                (if (< i n)
                  (recur (+ i 1)
                         (+ (* acc 256)
                            (nth bs (if big? i (- (- n 1) i)))))
                  acc))
              0)
            (:pos r))))
