 ;; zlib-wrapped, same codec PNG/ZIP/WOFF/PDF share (2026-07-08 wiring).
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/org-ietf-deflate {:local/root "../org.ietf.deflate"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {
                               ;; TEST-ONLY. Parity compiles
