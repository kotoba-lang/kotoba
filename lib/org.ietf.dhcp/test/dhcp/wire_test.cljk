(ns dhcp.wire-test
  (:require [dhcp.wire :as w]
            [kotoba.test :refer [deftest is testing]]))

(def chaddr [0x52 0x54 0x00 0x12 0x34 0x56])
(def xid 0xdeadbeef)

(defn- offer-bytes
  "A server OFFER built by hand, so the decoder is tested against bytes this
  namespace did not encode."
  [& {:keys [yiaddr opts] :or {yiaddr [192 168 1 50]}}]
  (vec (concat
        [2 1 6 0]                                  ; op=BOOTREPLY htype hlen hops
        [0xde 0xad 0xbe 0xef]                      ; xid
        [0 0] [0 0]                                ; secs flags
        [0 0 0 0] yiaddr [0 0 0 0] [0 0 0 0]       ; ciaddr yiaddr siaddr giaddr
        chaddr (repeat 10 0)                       ; chaddr padded to 16
        (repeat 64 0) (repeat 128 0)               ; sname file
        w/magic-cookie
        (or opts (concat [53 1 2]                  ; message-type = offer
                         [1 4 255 255 255 0]       ; subnet mask
                         [3 4 192 168 1 1]         ; router
                         [6 8 8 8 8 8 1 1 1 1]     ; two DNS servers
                         [51 4 0 0 14 16]          ; lease 3600s
                         [54 4 192 168 1 1]))      ; server id
        [255])))

(deftest an-offer-decodes-into-its-parts
  (let [m (w/decode (offer-bytes))]
    (is (nil? (:dhcp/error m)))
    (is (= :offer (:dhcp/message-type m)))
    (is (= xid (:dhcp/xid m)))
    (is (= [192 168 1 50] (:dhcp/yiaddr m)))
    (is (= chaddr (:dhcp/chaddr m)))))

(deftest a-lease-reads-the-fields-a-client-acts-on
  (let [l (w/lease (w/decode (offer-bytes)))]
    (is (= [192 168 1 50] (:dhcp/address l)))
    (is (= [255 255 255 0] (:dhcp/subnet-mask l)))
    (is (= [192 168 1 1] (:dhcp/router l)))
    (is (= [[8 8 8 8] [1 1 1 1]] (:dhcp/dns l)) "two servers, split into quads")
    (is (= 3600 (:dhcp/lease-seconds l)))))

(deftest an-ack-without-an-address-is-not-a-lease
  (testing "returning a map with a nil address would let a caller configure an interface with it"
    (is (nil? (w/lease (w/decode (offer-bytes :yiaddr [0 0 0 0])))))))

(deftest an-option-that-runs-past-the-end-is-refused-not-clamped
  (let [b (vec (concat (drop-last (offer-bytes)) [1 40]))]   ; claims 40 bytes, has none
    (is (= :option-overruns (:dhcp/error (w/decode b))))))

(deftest a-truncated-option-header-is-refused
  (is (= :option-truncated (:dhcp/error (w/decode (vec (concat (drop-last (offer-bytes)) [1])))))))

(deftest an-option-area-with-no-end-marker-is-refused
  (is (= :missing-end-option
         (:dhcp/error (w/decode (vec (drop-last (offer-bytes))))))))

(deftest a-bootp-reply-with-no-message-type-is-not-a-dhcp-message
  (let [b (offer-bytes :opts [1 4 255 255 255 0])]
    (is (= :no-message-type (:dhcp/error (w/decode b)))
        "guessing the type is how an OFFER gets treated as an ACK")))

(deftest an-unknown-message-type-is-refused-rather-than-passed-through
  (is (= :unknown-message-type (:dhcp/error (w/decode (offer-bytes :opts [53 1 99]))))))

(deftest a-packet-without-the-magic-cookie-is-not-ours
  (let [b (assoc (offer-bytes) w/header-bytes 0)]
    (is (= :bad-magic-cookie (:dhcp/error (w/decode b))))))

(deftest a-short-buffer-is-refused
  (is (= :too-short (:dhcp/error (w/decode (vec (repeat 20 0)))))))

(deftest unknown-options-are-kept-not-dropped
  (let [b (offer-bytes :opts (concat [53 1 2] [200 2 7 7]))
        m (w/decode b)]
    (is (= {200 [7 7]} (:dhcp/unknown-options m))
        "an option we do not understand is still evidence about what the server said")))

(deftest pad-options-are-skipped
  (let [m (w/decode (offer-bytes :opts (concat [0 0 0] [53 1 2] [0] [54 4 10 0 0 1])))]
    (is (= :offer (:dhcp/message-type m)))
    (is (= [10 0 0 1] (get-in m [:dhcp/options :server-id])))))

(deftest a-discover-round-trips-through-our-own-decoder
  (let [b (w/encode {:message-type :discover :xid xid :chaddr chaddr
                     :parameter-request-list [:subnet-mask :router]})
        ;; our encoder writes BOOTREQUEST; flip the op so the decoder (which is
        ;; only ever pointed at replies in production) will read it back.
        m (w/decode (assoc (vec b) 0 2))]
    (is (= :discover (:dhcp/message-type m)))
    (is (= xid (:dhcp/xid m)))
    (is (= chaddr (:dhcp/chaddr m)))
    (is (= [(w/option-codes :subnet-mask) (w/option-codes :router)]
           (get-in m [:dhcp/options :parameter-request-list])))))

(deftest every-decode-error-is-in-the-declared-set
  (doseq [b [(vec (repeat 20 0))
             (assoc (offer-bytes) w/header-bytes 0)
             (offer-bytes :opts [53 1 99])
             (vec (drop-last (offer-bytes)))]]
    (let [e (:dhcp/error (w/decode b))]
      (is (contains? w/decode-errors e) (str "undeclared error: " e)))))
