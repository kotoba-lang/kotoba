{:paths ["src"]
 ;; Zero runtime dependencies. The codec and the state machine are portable
 ;; .cljc with no sockets, no clock and no randomness -- the caller supplies
 ;; the transaction id, the hardware address and :now-ms, which is what lets
 ;; the whole of this be tested without a DHCP server anywhere near it.
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; TEST-ONLY. The library keeps zero runtime dependencies; these two
         ;; exist so `kotoba/dhcp/client_core.kotoba` can be compiled and run
         ;; inside the test JVM and checked against `dhcp.client`, which is the
         ;; only thing keeping the two from drifting apart in silence.
         :extra-deps {
                      io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.osaho"}
                      io.github.kotoba-lang/compiler
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "1e21a1f56613d7d4c7628af1945ebf1cf7862ff3"}
                      ;; The native executor, for the one test here that runs
                      ;; machine code rather than compiling it. Named directly
                      ;; because amu carries it in a :test alias and does not
                      ;; pass it on, and at this library's main because amu's
                      ;; pin predates 9114591, where measure-runtime learned to
                      ;; be told where the reviewed loader source is.
                      io.github.kotoba-lang/kototama-native
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.kototamaNative"}}}}}
