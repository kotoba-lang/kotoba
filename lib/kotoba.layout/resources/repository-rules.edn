;; This repository's entry in the kotoba.repository-role-rules taxonomy.
;; ADR-2607266000 / ADR-2607299000.
{:schema "kotoba.repository-role-rules.v0"
 :this-repo
 {:name "layout"
  :tier :t5
  :role :library
  ;; A layout planner that quietly reorders fields at a component boundary is
  ;; a wire-format bug, so the ABI verdict is carried, never assumed. And a
  ;; planner that measures is no longer a pure function of its inputs.
  :must-not [:cross-abi-boundary-non-canonically :probe-hardware :run-benchmarks]
  :depends-on ["kotoba-lang/machine"]}}
