{:paths ["src"]
 ;; columnar and nothing else. It carries both halves of the seam this library
 ;; plugs into -- `IColumnSource` (what the engine asks a format for) and
 ;; `IByteSource` (what a format asks the world for) -- and is itself zero-dep
 ;; portable .cljc, so the transitive cost is nil.
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/columnar {:local/root "../kotoba.columnar"}
        io.github.kotoba-lang/org-ietf-zstd {:local/root "../org.ietf.zstd"}
        io.github.kotoba-lang/io-ipld {:local/root "../kotoba.ioIpld"}}
 :aliases
 ;; kotobase-lake is a TEST dependency only. This repo provides a column source
 ;; and must not know about catalogs, tenants or triple patterns — but the
 ;; claim this repo exists to check is that the lake's scan seam takes a
 ;; SECOND format without changing, and only an end-to-end test against a real
 ;; file can say so.
 {:test {:extra-paths ["test"]}}}
