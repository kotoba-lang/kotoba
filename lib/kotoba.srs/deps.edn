{:paths ["src"]
 ;; Zero third-party runtime deps — every namespace is portable .cljc (JVM,
 ;; CLJS, SCI, kotoba-WASM). The lifecycle takes `now` as an argument and holds
 ;; no storage, so there is nothing here to make host-specific. Calendar
 ;; arithmetic is hand-rolled in srs.time rather than pulled from java.time,
 ;; which is JVM-only; see that namespace's docstring.
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
