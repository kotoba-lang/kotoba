(ns kotoba.compiler.js-closure-test
  (:require #?(:clj [kotoba.test :refer [deftest is]]
               :cljs [cljs.test :refer [deftest is]])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]
            [kotoba.compiler.js-value-type-test :refer [refusal]]))

(def keep-source
  "(ns host.closures (:export [keep]))
   (defn applyOpaque [f [:fn [[:js-value] :js-value]] v :js-value] :js-value (f v))
   (defn keep [v :js-value] :js-value (applyOpaque (fn [x] x) v))")

#?(:cljs
   (deftest typed-guest-js-closure-preserves-opaque-identities
       (let [hir (sema/analyze keep-source)
             lowered (kir/lower hir)
             reads (atom 0)
             proxy (js/Proxy. #js {} #js {:get (fn [& _] (swap! reads inc) (throw (js/Error. "read")))})
             revoked (.revocable js/Proxy #js {} #js {})
             _ ((.-revoke revoked))
             values [nil js/undefined false true 0 (- 0.0) js/NaN (js/BigInt "0") "" (js/Symbol "x") #js {} #js [] proxy (.-proxy revoked)]]
         (is (nil? (:entry hir)))
         (doseq [v values] (is (js/Object.is v (kir/execute lowered 'keep [v] {}))))
         (is (= 0 @reads)))))

#?(:cljs
   (deftest typed-js-closure-ref-and-multiple-parameters
       (let [source "(ns host.closures (:export [firstValue]))
                     (defn selectOpaque [a :js-value b :js-value] :js-value a)
                     (defn applyTwo [f [:fn [[:js-value :js-value] :js-value]] a :js-value b :js-value] :js-value (f a b))
                     (defn firstValue [a :js-value b :js-value] :js-value (applyTwo (fn-ref selectOpaque) a b))"
             lowered (kir/lower (sema/analyze source))
             a #js {} b #js {}]
         (is (identical? a (kir/execute lowered 'firstValue [a b] {})))
         (is (not (identical? b (kir/execute lowered 'firstValue [a b] {})))))))

#?(:cljs
   (deftest stored-zero-arity-js-closure-retains-undefined
       (let [source "(ns host.closures (:export [noop]))
                     (defn create [] [:fn [[] :js-value]] (fn [] (js-undefined)))
                     (defn noop [] :js-value (let [f (create)] (f)))"
             hir (sema/analyze source)
             heads (set (filter symbol? (tree-seq coll? seq hir)))]
         (is (contains? heads 'js-undefined))
         (is (js/Object.is js/undefined (kir/execute (kir/lower hir) 'noop [] {}))))))

(deftest js-closure-contracts-retain-type-and-host-boundaries
  (doseq [source
          ["(defn consume [f [:fn [[:js-value] :js-value]]] :i64 0) (defn main [] :i64 (consume (fn [x] 1)))"
           "(defn applyOpaque [f [:fn [[:js-value] :js-value]] v :js-value] :js-value (f 1))"
           "(defn applyOpaque [f [:fn [[:js-value] :js-value]] v :js-value] :i64 (f v))"
           "(ns host.closures (:export [capture])) (defn capture [e [:record :host/event [[:payload :js-value]]]] [:fn [[] :js-value]] (fn [] (record-get [:record :host/event [[:payload :js-value]]] e :payload)))"
           "(ns host.closures (:export [invokeHost])) (defn invokeHost [f :js-value v :js-value] :js-value (f v))"]]
    (is (some? (refusal source)) source)))

#?(:cljs
   (deftest nested-js-leaves-pass-through-the-typed-closure-profile
     (let [source "(ns host.closures (:export [payload]))
                   (defn applyEvent [f [:fn [[[:record :host/event [[:payload :js-value]]]] [:record :host/event [[:payload :js-value]]]]] e [:record :host/event [[:payload :js-value]]]] [:record :host/event [[:payload :js-value]]] (f e))
                   (defn payload [v :js-value] :js-value (record-get [:record :host/event [[:payload :js-value]]] (applyEvent (fn [e] e) (record-new [:record :host/event [[:payload :js-value]]] v)) :payload))"
           lowered (kir/lower (sema/analyze source))
           revoked (.revocable js/Proxy #js {} #js {})
           _ ((.-revoke revoked))]
       (doseq [v [js/undefined #js {} (.-proxy revoked)]]
         (is (js/Object.is v (kir/execute lowered 'payload [v] {})))))))
