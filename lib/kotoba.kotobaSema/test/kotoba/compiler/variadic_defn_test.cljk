(ns kotoba.compiler.variadic-defn-test
  "A `[fixed ... & rest]` defn is admitted by the static specialization the
  `fn` profile already had (2026-09-12, adr-2609111900 selfhost ceiling).

  The authorities said so before the compiler did. `lang/guest-grammar.edn`
  `:named-multi-arity` `:variadic` reads \"[fixed ... & rest] statically
  specialized through arity 5\" and `lang/surface-status.edn`
  `:named-multi-arity-functions` `:variadic` reads \"specialized for each
  used/supported arity through 5; rest is a pair-chain\" -- the closure entry
  says the same of `fn` and the compiler honoured it there. The refusal
  `variadic parameters are outside the multi-arity profile` was therefore
  IMPLEMENTATION STATE, not a property of the language.

  Measured at 6f49a83 before the change, two shapes for one clause:

      (defn f ([a] a) ([a & r] ...))   refused by name (the multi-arity path)
      (defn f [a & r] r)               ADMITTED as a three-parameter function
                                       whose second parameter was named `&`:
                                       (f 1 2 3) answered 3, (f 1 2) was
                                       refused `f takes 3 arguments`

  The second is the worse one -- accepted and wrong -- and it is why the
  positives below RUN rather than only analyze.

  Lowering: one clause per arity a call site uses (plus the smallest
  arity no fixed clause holds, so the body is always checked), each the
  `fn` profile's `specialize-variadic-clause` -- surplus arguments become
  positional parameters and REST is `(list ...)` of them, the pair-chain
  `first` / `second` / `rest` / `empty?` / `cons` and `apply` read. A
  fixed-arity defn is untouched: its CID is measured unchanged in amu
  (`definition-cids`), not here."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn- answer
  "Compile SOURCE and run `main` on the interpreter."
  [source]
  (kir/execute (kir/lower (sema/analyze source)) 'main [] {}))

(defn- refusal
  [source]
  (try (do (sema/analyze source) nil)
       (catch #?(:clj Throwable :cljs :default) e
         {:message (ex-message e)
          :code (:kotoba.error/code (ex-data e))
          :function (:function (ex-data e))
          :supplied (:supplied (ex-data e))})))

(defn- function-names [source]
  (->> (sema/analyze source) :functions (map :name) (remove #{'main}) sort vec))

(defn- w [x] #?(:clj x :cljs (js/Number x)))

;; --- positives: run to a value ---------------------------------------------

(deftest a-variadic-defn-answers-at-zero-one-and-three-rest-arguments
  ;; 0, 1 and 3 rest arguments in ONE module: 1 + (10+20) + (100+200) = 331.
  ;; The pre-change single-arity reading would have refused (f 1) and
  ;; (f 10 20) with `f takes 3 arguments`.
  (is (= 331 (w (answer "(defn- f [a & r] (if (empty? r) a (+ a (first r))))
                         (defn main [] :i64 (+ (f 1) (f 10 20) (f 100 200 300 400)))")))))

(deftest rest-is-the-pair-chain-the-fn-profile-binds
  (testing "first / second"
    (is (= 601 (w (answer "(defn- f [a & r] (if (empty? r) a (+ a (first r) (second r))))
                           (defn main [] :i64 (+ (f 1) (f 100 200 300 400)))")))))
  (testing "rest"
    (is (= 4 (w (answer "(defn- f [a & r] (+ a (first (rest r))))
                         (defn main [] :i64 (f 1 2 3))")))))
  (testing "apply's trailing argument is the chain"
    (is (= 3 (w (answer "(defn- f [a & r] (let [g (fn [x y] (+ x y))] (apply g a r)))
                         (defn main [] :i64 (f 1 2))")))))
  (testing "the same source, as a fn value, answers the same -- one lowering"
    (is (= 331 (w (answer "(defn main [] :i64
                             (let [f (fn [a & r] (if (empty? r) a (+ a (first r))))]
                               (+ (f 1) (f 10 20) (f 100 200 300 400))))"))))))

(deftest zero-fixed-parameters
  (is (= 17 (w (answer "(defn- f [& r] (if (empty? r) 7 (first r)))
                        (defn main [] :i64 (+ (f) (f 10)))")))))

(deftest a-fixed-clause-wins-its-arity-and-the-variadic-clause-takes-the-rest
  ;; (f 1) -> fixed clause 2; (f 10 20) -> 30; (f 100 200 300) -> 300.
  (is (= 332 (w (answer "(defn- f ([a] (* a 2)) ([a & r] (+ a (first r))))
                         (defn main [] :i64 (+ (f 1) (f 10 20) (f 100 200 300)))"))))
  (is (= 13 (w (answer "(defn- f ([a b] (+ a b)) ([a & r] (- a (first r))))
                        (defn main [] :i64 (f 10 3))")))))

(deftest docstring-and-typed-fixed-parameters
  (is (= 15 (w (answer "(defn f \"doc\" [a :string & r] :i64
                          (if (empty? r) (string-length a) (+ (string-length a) (first r))))
                        (defn main [] :i64 (+ (f \"ab\") (f \"abc\" 10)))")))))

(deftest the-abi-bound-arity-five-is-reachable
  (is (= 19 (w (answer "(defn- f [a & r] (if (empty? r) a (+ a (first r))))
                        (defn- h [a b c d e] (+ a b c d e))
                        (defn main [] :i64 (+ (f 1) (h 1 2 3 4 5) (f 1 2 3 4 5)))")))))

(deftest a-call-inside-another-variadic-body-is-a-call-site
  (is (= 19 (w (answer "(defn- g [x & r] (if (empty? r) x (+ x (first r))))
                        (defn- f [a & r] (+ a (g 5) (g 6 7)))
                        (defn main [] :i64 (f 1 2 3))")))))

;; --- what is emitted --------------------------------------------------------

(deftest only-used-arities-are-emitted-under-the-multi-arity-abi-names
  (is (= '[f$arity$1 f$arity$3]
         (function-names "(defn- f [a & r] (if (empty? r) a (+ a (first r))))
                          (defn main [] :i64 (+ (f 1) (f 1 2 3)))"))))

(deftest one-clause-is-one-ordinary-function
  ;; The plain name, as the linker writes a one-clause export: its interface
  ;; and CID are those of the fixed-arity defn an author would have written.
  (is (= '[f] (function-names "(defn- f [a & r] (if (empty? r) a (+ a (first r))))
                               (defn main [] :i64 (f 1))")))
  ;; The minimum arity is ALWAYS emitted (the body must be checked), so a
  ;; single call above it is two clauses, not one.
  (is (= '[f$arity$1 f$arity$2]
         (function-names "(defn- f [a & r] (if (empty? r) a (+ a (first r))))
                          (defn main [] :i64 (f 1 2))"))))

(deftest an-uncalled-variadic-defn-still-has-its-body-checked
  (testing "the minimum arity is emitted"
    (is (= '[f] (function-names "(defn- f [a & r] a)\n(defn main [] :i64 1)"))))
  (testing "so a broken body is refused even with no call"
    (is (= "unknown operation: nope is not a builtin, a sugar head, or a function of this module"
           (:message (refusal "(defn- f [a & r] (nope a))\n(defn main [] :i64 1)"))))))

;; --- refusals by name -------------------------------------------------------

(deftest the-old-refusal-is-gone
  (is (nil? (refusal "(defn- f ([a] a) ([a & r] (+ a 1)))\n(defn main [] :i64 (f 1 2 3))"))))

(deftest ampersand-must-be-followed-by-exactly-one-rest-name
  (let [message "variadic defn requires [fixed ... & rest]: `&` must be followed by exactly one rest name and nothing else"]
    (is (= message (:message (refusal "(defn- f [a & r b] a)\n(defn main [] :i64 (f 1))"))))
    (is (= message (:message (refusal "(defn- f [a &] a)\n(defn main [] :i64 (f 1))"))))
    (is (= message (:message (refusal "(defn- f [a & r & s] a)\n(defn main [] :i64 (f 1))"))))))

(deftest the-rest-name-is-a-simple-symbol
  (let [message "variadic defn requires [fixed ... & rest]: the rest name must be a simple symbol"]
    (is (= message (:message (refusal "(defn- f [a & &] a)\n(defn main [] :i64 (f 1))"))))
    (is (= message (:message (refusal "(defn- f [a & [r]] a)\n(defn main [] :i64 (f 1))"))))))

(deftest the-rest-name-may-not-shadow-a-fixed-parameter
  (is (= "variadic rest name a shadows a fixed parameter of the same clause"
         (:message (refusal "(defn- f [a & a] a)\n(defn main [] :i64 (f 1))")))))

;; The bound is 64 (was 5 until 2026-09-23, the native register count; past
;; the fifth argument the native backends now pass on the stack). These build
;; their sources from the count so the boundary itself is what is asserted.

(defn- names [prefix n] (apply str (interpose " " (map #(str prefix %) (range n)))))

(deftest more-fixed-parameters-than-the-bound
  (is (= {:message "function parameters exceed ABI-supported arity"
          :code :kotoba.error/max-parameters}
         (select-keys (refusal (str "(defn- f [" (names "a" 65) " & r] a0)\n"
                                    "(defn main [] :i64 (f 1))"))
                      [:message :code])))
  (testing "sixty-four fixed parameters and a rest are admitted"
    (is (nil? (refusal (str "(defn- f [" (names "a" 64) " & r] a0)\n"
                            "(defn main [] :i64 (f " (names "" 64) "))"))))))

(deftest a-call-past-the-bound
  (is (= {:message "variadic function f is called with 65 arguments; a variadic defn is specialized through arity 64 (the ABI bound), so a longer call has no clause to reach"
          :code :kotoba.error/call-arity :function 'f :supplied 65}
         (refusal (str "(defn- f [a & r] a)\n(defn main [] :i64 (f " (names "" 65) "))")))))

(deftest a-call-below-the-fixed-count-is-the-multi-arity-refusal
  (is (= {:message "no matching multi-arity clause" :code :kotoba.error/call-arity
          :function 'f :supplied 1}
         (refusal "(defn- f [a b & r] a)\n(defn main [] :i64 (+ (f 1) (f 1 2 3)))"))))

(deftest at-most-one-variadic-clause
  (is (= "defn admits at most one variadic clause"
         (:message (refusal "(defn- f ([a & r] a) ([b & s] b))\n(defn main [] :i64 (f 1))")))))

(deftest a-variadic-defn-is-not-a-value
  (let [message "variadic function f is used as a value; a variadic defn is specialized per call site and has no single interface, so it is admitted only by direct call `(f ...)` -- not through fn-ref, apply, a callback position, or a bare reference. If this `f` is a local binding, it shadows the function: rename one of them"]
    (testing "fn-ref"
      (is (= message (:message (refusal "(defn- f [a & r] a)\n(defn main [] :i64 (let [g (fn-ref f)] 1))")))))
    (testing "apply"
      (is (= message (:message (refusal "(defn- f [a & r] a)\n(defn main [] :i64 (apply f 1 (list 2)))")))))
    (testing "callback"
      (is (= message (:message (refusal "(defn- f [a & r] a)\n(defn main [] :i64 (map f [1 2]))")))))
    (testing "bare reference in a vector"
      (is (= message (:message (refusal "(defn- f [a & r] a)\n(defn main [] :i64 (count [f]))")))))))

(deftest a-variadic-defn-cannot-be-exported
  (is (= {:message "variadic function f cannot be exported: an export must have a fixed interface, and a [fixed ... & rest] defn is specialized per call site of this module. Export a fixed-arity defn that calls it, or give the clause a fixed parameter vector"
          :code :kotoba.error/subset-reject :function 'f}
         (select-keys (refusal "(ns m {:kotoba/export [f g]})\n(defn f [a & r] a)\n(defn g [x] (f x 1))")
                      [:message :code :function])))
  (testing "the fixed-arity defn that calls it exports"
    (is (= '[g] (:exports (sema/analyze "(ns m {:kotoba/export [g]})\n(defn f [a & r] a)\n(defn g [x] (f x 1))"))))))
