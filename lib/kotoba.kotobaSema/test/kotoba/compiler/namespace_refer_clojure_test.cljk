(ns kotoba.compiler.namespace-refer-clojure-test
  "`(:refer-clojure :exclude [sym ...])` / `(:refer-clojure :only [sym ...])`
  is admitted as a NO-OP (kotoba-lang `lang/guest-grammar.edn` `:ns :clauses
  :refer-clojure`, 2026-09-11). On a Clojure host the clause narrows what
  `ns` auto-refers from clojure.core; Kotoba refers nothing from
  clojure.core, so it has no meaning and no effect. Refusing it bought no
  safety and cost every dual-runtime module that shadows a core name.

  What the test pins: (1) a module carrying the clause analyses IDENTICALLY
  to the same module without it -- same analysis value, so the same
  definition CIDs downstream; (2) the clause does not count toward the
  three-clause limit; (3) what stays refused is refused BY NAME: `:rename`
  (it does change name resolution), an option nobody declared, a non-symbol
  entry, an odd option list, and a second `:refer-clojure`."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]))

(defn- refusal [source]
  (try (do (sema/analyze source) nil)
       (catch #?(:clj Throwable :cljs :default) e
         {:message (ex-message e)
          :code (:kotoba.error/code (ex-data e))})))

(def ^:private body
  "\n(defn update [n :i64] :i64 (+ n 1))\n(defn main [] :i64 (update 1))")

(deftest the-clause-is-a-no-op
  (let [without (sema/analyze (str "(ns t (:export [main update]))" body))]
    (doseq [clause ["(:refer-clojure :exclude [update])"
                    "(:refer-clojure :only [inc])"
                    "(:refer-clojure :exclude [update] :only [inc])"
                    "(:refer-clojure :only [inc] :exclude [update])"
                    "(:refer-clojure :exclude [])"
                    "(:refer-clojure)"]]
      (testing clause
        (is (= without (sema/analyze (str "(ns t " clause " (:export [main update]))" body)))
            "the analysis differs from the same module without the clause")
        ;; Position does not matter either: after the other clauses.
        (is (= without (sema/analyze (str "(ns t (:export [main update]) " clause ")" body))))))))

(deftest the-clause-does-not-count-toward-the-clause-limit
  ;; :export + :capabilities + :schemas is the limit; :refer-clojure beside
  ;; all three is still admitted.
  (is (nil? (refusal (str "(ns t (:refer-clojure :exclude [update]) (:export [main update]) (:capabilities #{}) (:schemas {}))"
                          body)))))

(deftest what-stays-refused-is-refused-by-name
  (doseq [[clause expected-message]
          [["(:refer-clojure :rename {update up})"
            "namespace clause :refer-clojure :rename is not admitted: renaming changes name resolution; :exclude and :only are admitted as no-ops"]
           ["(:refer-clojure :frobnicate [update])"
            "namespace clause :refer-clojure option :frobnicate is not admitted; the admitted options are :exclude and :only"]
           ["(:refer-clojure :exclude [\"update\"])"
            "namespace clause :refer-clojure :exclude takes a bounded vector of simple symbols"]
           ["(:refer-clojure :only [clojure.core/inc])"
            "namespace clause :refer-clojure :only takes a bounded vector of simple symbols"]
           ["(:refer-clojure :exclude update)"
            "namespace clause :refer-clojure :exclude takes a bounded vector of simple symbols"]
           ["(:refer-clojure :exclude)"
            "namespace clause :refer-clojure takes :exclude [sym ...] and/or :only [sym ...]"]
           ["(:refer-clojure :exclude [update] :exclude [inc])"
            "namespace clause :refer-clojure repeats an option"]]]
    (testing clause
      (let [r (refusal (str "(ns t " clause " (:export [main update]))" body))]
        (is (some? r) (str clause " was admitted"))
        (is (= :kotoba.error/namespace-refer-clojure-clause (:code r)) (pr-str r))
        (is (= expected-message (:message r)) (pr-str r))))))

(deftest a-second-refer-clojure-is-refused
  (let [r (refusal (str "(ns t (:refer-clojure :exclude [update]) (:refer-clojure :only [inc]) (:export [main update]))" body))]
    (is (= :kotoba.error/namespace-clause-duplicate (:code r)) (pr-str r))
    (is (= "namespace admits :refer-clojure at most once" (:message r)))))

(deftest the-other-refused-heads-still-win-over-the-no-op
  ;; `:import` beside an admitted `:refer-clojure` is refused for the `:import`.
  (let [r (refusal (str "(ns t (:refer-clojure :exclude [update]) (:import [java.io File]) (:export [main update]))" body))]
    (is (= :kotoba.error/namespace-host-clause (:code r)) (pr-str r))))
