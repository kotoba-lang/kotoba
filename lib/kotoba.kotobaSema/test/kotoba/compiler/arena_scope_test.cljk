(ns kotoba.compiler.arena-scope-test
  "`(arena-scope body)` at the frontend -- superproject ADR-2609160044.

  The region's safety argument is one type rule: the body is :i64, :bool or
  :f64, so no handle can be the result and nothing the body allocated is
  reachable after the release. This file pins that rule in both directions,
  with the reason literal, and the arity by name."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn- run
  ([source] (run source 'main []))
  ([source function arguments]
   (kir/execute (kir/lower (sema/analyze source)) function arguments {})))

(defn- refusal [source]
  (try (do (sema/analyze source) nil)
       (catch #?(:clj Throwable :cljs :default) e
         {:message (ex-message e)
          :code (:kotoba.error/code (ex-data e))})))

(defn- w [x] #?(:clj x :cljs (js/Number x)))

(deftest a-scalar-body-is-the-scope-s-value
  (is (= 42 (w (run "(defn main [] :i64 (arena-scope 42))"))))
  (is (= 6 (w (run "(defn main [] :i64 (arena-scope (string-byte-length (string-concat \"abc\" \"def\"))))"))))
  (is (= 3 (w (run "(defn main [] :i64 (+ 1 (arena-scope (+ 1 1))))"))))
  (is (= 1 (w (run "(defn main [] :i64 (if (arena-scope (= 1 1)) 1 0))")))
      "a :bool body, through if"))

(deftest a-string-body-is-refused-for-the-reason-it-is-dangerous
  (is (= {:message (str "arena-scope body must be :i64, :bool or :f64, got :string"
                        ": a handle would escape the region it is released with")
          :code :kotoba.error/arena-scope-body-not-scalar}
         (refusal "(defn main [] :string (arena-scope (string-concat \"a\" \"b\")))"))))

(deftest the-arity-is-one-by-name
  (is (= "region operation arity mismatch: arena-scope takes 1 argument; got 2"
         (:message (refusal "(defn main [] :i64 (arena-scope 1 2))"))))
  (is (= "region operation arity mismatch: arena-scope takes 1 argument; got 0"
         (:message (refusal "(defn main [] :i64 (arena-scope))")))))
