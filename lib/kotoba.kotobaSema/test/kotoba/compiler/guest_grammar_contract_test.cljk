(ns kotoba.compiler.guest-grammar-contract-test
  (:require #?(:clj [kotoba.test :refer [deftest is]]
               :cljs [cljs.test :refer [deftest is]])
            [kotoba.lang.edn :as edn]
            [kotoba.compiler.frontend :as frontend]))

;; The authority resync updates this literal and the byte copy together.
(def authority-grammar-sha256 "da68c3fa4065087974abb60e4f0ebca427d0a1ff5f169b1431cf0bef6bd4504d")
(def resource-path "lib/kotoba.kotobaSema/resources/kotoba/lang/guest-grammar.edn")

(defn- grammar-source []
  #?(:clj (slurp resource-path)
     :cljs (.readFileSync (js/require "node:fs") resource-path "utf8")))

(defn- sha256 [source]
  #?(:clj (let [digest (.digest (java.security.MessageDigest/getInstance "SHA-256")
                                (.getBytes ^String source "UTF-8"))]
            (apply str (map #(format "%02x" %) digest)))
     :cljs (.digest (.update (.createHash (js/require "node:crypto") "sha256") source "utf8") "hex")))

(deftest the-actual-vendored-bytes-match-the-authority
  (is (= authority-grammar-sha256 (sha256 (grammar-source)))))

(deftest callable-contract-refinements-and-limits-match-the-source-owner
  (let [grammar (edn/read-string (grammar-source))
        callable (:callable-type grammar)
        higher (:higher-order callable)]
    (is (= :i64 (:physical-abi higher)))
    (is (= :callable-contract (:logical-identity higher)))
    (is (= #{:parameter :result} (:positions higher)))
    (is (= #{:callable-param-contracts :callable-result-contract} (:metadata higher)))
    (is (= frontend/max-type-depth (get-in higher [:limits :type-depth])))
    (is (= frontend/max-type-nodes (get-in higher [:limits :type-nodes])))
    (is (= 4 (get-in callable [:arity :max])))
    (is (= :refused (:host-invocation higher)))
    (is (= :refused (:linear-resources higher)))))

(deftest aggregate-and-definition-admission-match-the-source-owner
  (let [limits (:admission-limits (edn/read-string (grammar-source)))]
    (is (= frontend/max-source-bytes (:max-source-bytes limits)))
    (is (= frontend/max-definition-source-bytes (:max-definition-source-bytes limits)))))
