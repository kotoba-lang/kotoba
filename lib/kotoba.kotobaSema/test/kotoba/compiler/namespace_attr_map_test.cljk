(ns kotoba.compiler.namespace-attr-map-test
  "The namespace header's ATTR-MAP spelling (kotoba-lang `lang/guest-grammar.edn`
  `:ns :attr-map`, 2026-09-11): `(ns NAME DOCSTRING? ATTR-MAP? CLAUSE ...)`, where
  `{:kotoba/export [...]}` means exactly `(:export [...])`.

  Why it exists: Clojure's `ns` admits a map after the docstring and ignores
  it, while SCI's `ns` (nbb) refuses `(:export ...)` with `No matching
  clause: export`. Measured 2026-09-11, 83 of amu's 178 source files were
  refused in project mode ONLY for the missing export clause -- and none of
  them can carry the clause and still load on the host that builds the
  compiler. The attr-map is the spelling both hosts accept.

  Fail-closed: an unknown key is refused BY NAME (a namespaced key nobody
  declared is not a comment; `{:author ...}` must not become an export), a
  key spelled beside its clause is refused as declared twice, and a map
  anywhere but its one position is refused as such. The values go through
  the SAME clause loop as the explicit spelling -- the equality test below is
  the assertion that there is one validation path, not two."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]))

(defn- refusal
  "The refusal SOURCE produces, or nil when it compiles."
  [source]
  (try (do (sema/analyze source) nil)
       (catch #?(:clj Throwable :cljs :default) e
         {:message (ex-message e)
          :code (:kotoba.error/code (ex-data e))})))

(def ^:private body "\n(defn main [] :i64 1)\n(defn other [] :i64 2)")

(deftest the-attr-map-export-is-the-export-clause
  (testing "both spellings parse to the same exports, namespace and result"
    (let [clause (sema/analyze (str "(ns t (:export [main other]))" body))
          attr   (sema/analyze (str "(ns t {:kotoba/export [main other]})" body))]
      (is (= '[main other] (:exports clause)))
      (is (= (:exports clause) (:exports attr)))
      (is (= (:namespace clause) (:namespace attr)))
      (is (= (:schemas clause) (:schemas attr)))
      (is (= (dissoc clause :entry) (dissoc attr :entry))
          "the HIR envelope differs between the two spellings; the attr-map is
           not being rewritten into the clause")))
  (testing "after a docstring, the position Clojure defines"
    (is (= '[main] (:exports (sema/analyze (str "(ns t \"doc\" {:kotoba/export [main]})" body))))))
  (testing "the attr-map may stand beside a clause it does not duplicate"
    (is (= '[main] (:exports (sema/analyze (str "(ns t {:kotoba/export [main]} (:schemas {}))" body)))))))

(deftest a-quoted-attr-map-value-is-the-unquoted-one
  ;; JVM Clojure's `ns` EVALUATES the attr-map: `{:kotoba/export [main]}`
  ;; throws `Unable to resolve symbol: main` there, `'[main]` loads. The
  ;; quoted spelling must therefore mean exactly the bare one.
  (testing "export: the same result as the clause and as the bare vector"
    (let [clause (sema/analyze (str "(ns t (:export [main other]))" body))
          quoted (sema/analyze (str "(ns t {:kotoba/export '[main other]})" body))]
      (is (= '[main other] (:exports quoted)))
      (is (= (dissoc clause :entry) (dissoc quoted :entry)))))
  (testing "after a docstring, and for :kotoba/capabilities"
    (is (= '[main] (:exports (sema/analyze (str "(ns t \"doc\" {:kotoba/export '[main]})" body)))))
    ;; an unused capability is refused -- with the SET named, the same
    ;; refusal as the bare spelling, so the quote was unwrapped first
    (is (= (refusal (str "(ns t {:kotoba/export [main] :kotoba/capabilities #{:clock/now}})" body))
           (refusal (str "(ns t {:kotoba/export '[main] :kotoba/capabilities '#{:clock/now}})" body))
           {:message "namespace :capabilities declares a capability never used via cap-call: #{:clock/now}"
            :code :kotoba.error/subset-reject})))
  (testing "the quoted value is validated by the same clause path"
    (is (= {:message "namespace exports must be unique bounded function names"
            :code :kotoba.error/namespace-exports}
           (refusal (str "(ns t {:kotoba/export '[main main]})" body))))
    (is (= {:message "only a bounded :export vector is admitted in namespace clauses"
            :code :kotoba.error/namespace-export-clause}
           (refusal (str "(ns t {:kotoba/export 'main})" body)))
        "a quoted symbol is still not a vector"))
  (testing "a quoted declaration beside its clause is still declared twice"
    (is (= :kotoba.error/namespace-clause-duplicate
           (:code (refusal (str "(ns t {:kotoba/export '[main]} (:export [main]))" body)))))))

(deftest the-attr-map-value-is-validated-by-the-clause-path
  ;; The message is the CLAUSE spelling's message, verbatim: proof that the
  ;; value was checked by the existing loop, not by a second copy of it.
  (is (= {:message "only a bounded :export vector is admitted in namespace clauses"
          :code :kotoba.error/namespace-export-clause}
         (refusal (str "(ns t {:kotoba/export main})" body))))
  (is (= {:message "only a bounded :capabilities set is admitted in namespace clauses"
          :code :kotoba.error/namespace-capabilities-clause}
         (refusal (str "(ns t {:kotoba/capabilities [:clock/now]} (:export [main]))" body))))
  (is (= {:message "only a closed :schemas map is admitted in namespace clauses"
          :code :kotoba.error/namespace-schemas-clause}
         (refusal (str "(ns t {:kotoba/schemas []} (:export [main]))" body))))
  (is (= {:message "namespace exports must be unique bounded function names"
          :code :kotoba.error/namespace-exports}
         (refusal (str "(ns t {:kotoba/export [main main]})" body)))))

(deftest an-unknown-attr-map-key-is-refused-by-name
  (is (= {:message (str "namespace attr-map key :author is not admitted; the admitted keys are "
                        "[:kotoba/capabilities :kotoba/export :kotoba/params :kotoba/schemas]")
          :code :kotoba.error/namespace-attr-map}
         (refusal (str "(ns t {:author \"nobody\" :kotoba/export [main]})" body))))
  (testing "a namespaced key nobody declared is not a comment"
    (is (= {:message (str "namespace attr-map key :kotoba/exports is not admitted; the admitted keys are "
                          "[:kotoba/capabilities :kotoba/export :kotoba/params :kotoba/schemas]")
            :code :kotoba.error/namespace-attr-map}
           (refusal (str "(ns t {:kotoba/exports [main]})" body)))))
  (testing "the bare clause name is not the key either"
    (is (= :kotoba.error/namespace-attr-map
           (:code (refusal (str "(ns t {:export [main]})" body)))))))

(deftest a-declaration-in-both-spellings-is-declared-twice
  (is (= {:message "namespace declares :export twice: attr-map :kotoba/export and clause (:export ...)"
          :code :kotoba.error/namespace-clause-duplicate}
         (refusal (str "(ns t {:kotoba/export [main]} (:export [main]))" body)))
      "identical values are still two declarations")
  (is (= {:message "namespace declares :schemas twice: attr-map :kotoba/schemas and clause (:schemas ...)"
          :code :kotoba.error/namespace-clause-duplicate}
         (refusal (str "(ns t {:kotoba/schemas {}} (:export [main]) (:schemas {}))" body)))))

(deftest an-attr-map-out-of-position-is-refused-as-such
  (let [expected {:message "namespace attr-map must follow the docstring: (ns NAME DOCSTRING? ATTR-MAP? CLAUSE ...)"
                  :code :kotoba.error/namespace-attr-map}]
    (is (= expected (refusal (str "(ns t (:export [main]) {:kotoba/export [main]})" body))))
    (is (= expected (refusal (str "(ns t {:kotoba/export [main]} (:schemas {}) {:kotoba/schemas {}})" body)))
        "a second map after the first is out of position too")))

(deftest kotoba-params-means-the-params-clause
  ;; The frontend does not admit `(:params ...)` -- it is the project
  ;; linker's clause, stripped before a module reaches here -- so the
  ;; attr-map spelling is refused exactly as the clause is.
  (is (= (refusal (str "(ns t (:params [elem]) (:export [main]))" body))
         (refusal (str "(ns t {:kotoba/params [elem]} (:export [main]))" body))))
  (is (= :kotoba.error/namespace-export-clause
         (:code (refusal (str "(ns t {:kotoba/params [elem]} (:export [main]))" body))))))

(deftest the-pure-product-profile-sees-both-spellings
  ;; `check-pure-product-source-forms!` refuses a `:capabilities` declaration;
  ;; the attr-map must not be a door around it.
  (let [opts {:language-profile :pure-product}
        refusal* (fn [source]
                   (try (do (sema/analyze source opts) nil)
                        (catch #?(:clj Throwable :cljs :default) e
                          (:kotoba.error/code (ex-data e)))))
        clause (refusal* (str "(ns t (:export [main]) (:capabilities #{:clock/now}))" body))
        attr (refusal* (str "(ns t {:kotoba/capabilities #{:clock/now}} (:export [main]))" body))]
    (is (some? clause) "the control: the clause spelling is refused in pure-product")
    (is (= clause attr) "the attr-map spelling reaches a different refusal than the clause")))
