(ns kotoba.compiler.remove-test
  "`remove` is Clojure's `(filter (complement pred) coll)`. Before 2026-09-25
  it was `unknown operation: remove is not a builtin, a sugar head, or a
  function of this module` (kotoba-lang/browser's surface reducer, aiueos
  desktop floor :browser-component, wall 7). It now lowers to filter's own
  bounded loop with the predicate negated.

  Pinned: every predicate shape filter admits, RUN to a value and
  discriminated against filter over the same input (the kept items are the
  complement, in source order); the stored-callback shape evaluated once; the
  lowering has no `remove` head left; a module defining its own `remove`
  keeps it; the arity refusal names `remove`."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn- run
  ([body] (run "" body))
  ([defs body]
   (let [v (kir/execute (kir/lower (sema/analyze (str "(ns m.probe)\n" defs
                                                      "(defn main [] " body ")\n")))
                        'main [] {})]
     #?(:clj v :cljs (js/Number v)))))

(defn- refusal [body]
  (try (do (sema/analyze (str "(ns m.probe)\n(defn main [] " body ")\n")) nil)
       (catch #?(:clj Throwable :cljs :default) e (ex-message e))))

(deftest remove-keeps-the-complement-in-order
  (testing "inline fn"
    (is (= 2 (run "(count (remove (fn [x] (= x 1)) [1 2 3 1]))")))
    (is (= 2 (run "(first (remove (fn [x] (= x 1)) [1 2 3 1]))")))
    (is (= 3 (run "(peek (remove (fn [x] (= x 1)) [1 2 3 1]))"))))
  (testing "the #() reader form browser.surface writes"
    (is (= 2 (run "(count (remove #(= % 2) [1 2 3]))"))))
  (testing "a named predicate"
    (is (= 2 (run "(defn one? [x] (= x 1))\n" "(count (remove one? [1 2 3 1]))"))))
  (testing "a stored callback"
    (is (= 2 (run "(let [p (fn [x] (< x 3))] (count (remove p [1 2 3 4])))")))
    (is (= 3 (run "(let [p (fn [x] (< x 3))] (first (remove p [1 2 3 4])))"))))
  (testing "remove and filter partition the same input"
    (is (= 5 (run "(+ (count (remove (fn [x] (< x 3)) [1 2 3 4 5]))
                      (count (filter (fn [x] (< x 3)) [1 2 3 4 5])))"))))
  (testing "all removed, none removed, empty"
    (is (= 0 (run "(count (remove (fn [x] (> x 0)) [1 2 3]))")))
    (is (= 3 (run "(count (remove (fn [x] (> x 9)) [1 2 3]))")))
    (is (= 0 (run "(count (remove (fn [x] (> x 0)) []))")))))

(deftest the-lowering-is-filters-loop
  (let [text (pr-str (sema/analyze "(ns m.probe)\n(defn main [] (count (remove (fn [x] (= x 1)) [1 2])))\n"))]
    (is (re-find #"vector-conj" text))
    (is (not (re-find #"\(remove " text)))))

(deftest a-module-defining-remove-keeps-it
  (is (= 3 (run "(defn remove [a b] (+ a b))\n" "(remove 1 2)"))))

(deftest the-arity-refusal-names-remove
  (is (= "remove requires pred and one vector-i64 collection"
         (refusal "(count (remove (fn [x] (= x 1))))"))))
