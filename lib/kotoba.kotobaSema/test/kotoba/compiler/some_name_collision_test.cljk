(ns kotoba.compiler.some-name-collision-test
  "`some` is the option constructor here; `(some pred coll)` is
  clojure.core/some and a NAME COLLISION, not an arity slip. Measured
  2026-09-12 (selfhost measurement 16): 8 of the compiler's own modules were
  answered `some requires one i64 operand` for a call they wrote as a
  predicate search. The two-argument spelling now says which `some` it hit;
  the one-operand constructor and the zero-argument slip keep their sentences."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]))

(defn- refusal [body]
  (try (do (sema/analyze (str "(ns m.probe)\n(defn main [] :i64 " body ")\n")) nil)
       (catch #?(:clj Throwable :cljs :default) e (ex-message e))))

(deftest two-argument-some-names-the-collision
  (is (= "some with two arguments is clojure.core/some (a predicate over a collection); in this language `some` is the option constructor and takes one i64 operand -- search with filter / first, or write the loop"
         (refusal "(some (fn [x] (< 0 x)) [1 2 3])"))))

(deftest one-operand-some-is-the-constructor
  (is (nil? (refusal "(if (some? (some 1)) 1 0)"))))

(deftest zero-argument-some-keeps-the-arity-sentence
  (is (= "some requires one i64 operand" (refusal "(some)"))))
