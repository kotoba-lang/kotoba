(ns kotoba.compiler.js-capture-test
  (:require #?(:clj [kotoba.test :refer [deftest is]]
               :cljs [cljs.test :refer [deftest is]])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]
            [kotoba.compiler.js-value-type-test :refer [refusal]]))

(def source
  "(ns host.captures (:export [keep]))
   (defn create [v :js-value] [:fn [[] :js-value]] (fn [] v))
   (defn keep [v :js-value] :js-value (let [f (create v)] (f)))")

#?(:cljs
   (deftest typed-opaque-capture-retains-identity
     (let [hir (sema/analyze source)
           k (kir/lower hir)
           reads (atom 0)
           proxy (js/Proxy. #js {} #js {:get (fn [& _] (swap! reads inc) (throw (js/Error. "get")))
                                      :getPrototypeOf (fn [& _] (swap! reads inc) (throw (js/Error. "prototype")))})
           revoked (.revocable js/Proxy #js {} #js {})
           _ ((.-revoke revoked))
           values [nil js/undefined false true 0 (- 0.0) js/NaN (js/BigInt "0") "" (js/Symbol "x") #js {} #js [] proxy (.-proxy revoked)]]
       (is (nil? (:entry hir)))
       (doseq [v values] (is (js/Object.is v (kir/execute k 'keep [v] {}))))
       (is (= 0 @reads)))))

#?(:cljs
   (deftest opaque-and-integer-captures-use-typed-helper-slots
     (let [s "(ns host.captures (:export [keep]))
              (defn create [n :i64 v :js-value] [:fn [[] :js-value]] (fn [] (if (= n 7) v (js-undefined))))
              (defn keep [v :js-value] :js-value (let [f (create 7 v)] (f)))"
           k (kir/lower (sema/analyze s))]
       (doseq [v [js/undefined #js {}]]
         (is (js/Object.is v (kir/execute k 'keep [v] {})))))))

#?(:cljs
   (deftest typed-guest-function-capture-and-opaque-slot-retain-refinement
     (let [s "(ns host.captures (:export [keep]))
              (defn undef [] :js-value (js-undefined))
              (defn wrap [g [:fn [[] :js-value]] v :js-value] [:fn [[] :js-value]] (fn [] (if (js-nullish? v) (g) v)))
              (defn keep [v :js-value] :js-value (let [f (wrap (fn-ref undef) v)] (f)))"
           k (kir/lower (sema/analyze s))
           v #js {}]
       (is (js/Object.is v (kir/execute k 'keep [v] {})))
       (is (js/Object.is js/undefined (kir/execute k 'keep [nil] {})))
       (is (js/Object.is js/undefined (kir/execute k 'keep [js/undefined] {}))))))

#?(:cljs
   (deftest five-opaque-captures-retain-the-existing-bound
     (let [s "(ns host.captures (:export [keep]))
              (defn create [a :js-value b :js-value c :js-value d :js-value e :js-value] [:fn [[] :js-value]] (fn [] (do (js-truthy? a) (js-truthy? b) (js-truthy? c) (js-truthy? d) e)))
              (defn keep [v :js-value] :js-value (let [f (create v v v v v)] (f)))"
           k (kir/lower (sema/analyze s))
           v #js {}]
       (is (js/Object.is v (kir/execute k 'keep [v] {}))))))

(deftest capture-contracts-refuse-wrong-results-and-host-invocation
  (doseq [s ["(defn create [v :js-value] [:fn [[] :i64]] (fn [] v))"
             "(defn create [v :js-value] [:fn [[] :js-value]] (fn [] (+ v 1)))"
             "(defn create [v :js-value] [:fn [[] :js-value]] (fn [] (v)))"
             "(defn create [a :js-value b :js-value c :js-value d :js-value e :js-value] [:fn [[] :js-value]] (let [z (js-undefined)] (fn [] (do (js-truthy? a) (js-truthy? b) (js-truthy? c) (js-truthy? d) (js-truthy? e) z))))"]]
    (is (some? (refusal s)) s)))

#?(:cljs
   (deftest captured-opaque-value-and-typed-guest-argument-remain-distinct
     (let [s "(ns host.captures (:export [keep]))
              (defn wrap [v :js-value] [:fn [[:js-value] :js-value]] (fn [x] (do (js-truthy? x) v)))
              (defn keep [v :js-value] :js-value (let [f (wrap v)] (f (js-undefined))))"
           k (kir/lower (sema/analyze s))]
       (doseq [v [js/undefined #js {}]]
         (is (js/Object.is v (kir/execute k 'keep [v] {})))))))

#?(:cljs
   (deftest nested-opaque-captures-keep-their-types
     (let [s "(ns host.captures (:export [keep]))
              (defn wrap [v :js-value] [:fn [[] :js-value]] (fn [] (let [f (fn [] v)] (f))))
              (defn keep [v :js-value] :js-value (let [f (wrap v)] (f)))"
           k (kir/lower (sema/analyze s))]
       (doseq [v [js/undefined #js {}]]
         (is (js/Object.is v (kir/execute k 'keep [v] {})))))))

#?(:cljs
   (deftest opaque-closure-allocation-retains-fuel-and-cell-ledgers
     (let [k (kir/lower (sema/analyze source))
           trap (fn [options]
                  (try (kir/execute k 'keep [js/undefined] options) :no-trap
                       (catch :default e (:trap (ex-data e)))))]
       (is (js/Object.is js/undefined (kir/execute k 'keep [js/undefined] {:fuel 6 :cells 2})))
       (is (= :budget/fuel (trap {:fuel 5})))
       (is (= :budget/cells (trap {:cells 1})))
       (is (js/Object.is js/undefined (kir/execute k 'keep [js/undefined] {}))))))

#?(:cljs
   (deftest lexical-initializers-retain-opaque-capture-types
     (doseq [initial ["(js-undefined)" "(js-bool-value true)" "(identity-js (js-undefined))"
                      "(if true (js-undefined) (js-bool-value false))"
                      "(do 7 (js-undefined))" "(let [inner (js-undefined)] inner)"]]
       (let [s (str "(defn identity-js [x :js-value] :js-value x) "
                    "(defn create [] [:fn [[] :bool]] (let [v " initial
                    " alias v] (fn [] (js-nullish? alias)))) "
                    "(defn main [] :bool (let [f (create)] (f)))")
             k (kir/lower (sema/analyze s))]
         (is (= (not= initial "(js-bool-value true)") (kir/execute k 'main [] {})) initial)))))

#?(:cljs
   (deftest lexical-shadowing-does-not-reuse-an-opaque-type
     (doseq [s ["(defn create [v :js-value] [:fn [[] :i64]] (let [v 7] (fn [] v))) (defn main [] :i64 (let [f (create (js-undefined))] (f)))"
                "(defn create [] [:fn [[] :i64]] (let [v (js-undefined) v 7] (fn [] v))) (defn main [] :i64 (let [f (create)] (f)))"
                "(defn create [v :js-value] [:fn [[:i64] :i64]] (fn [v] (let [f (fn [x] (+ v x))] (f 0)))) (defn main [] :i64 (let [f (create (js-undefined))] (f 7)))"]]
       (is (= (js/BigInt 7) (kir/execute (kir/lower (sema/analyze s)) 'main [] {}))))))

(deftest wrong-lexical-opaque-operands-remain-refused
  (is (some? (refusal "(defn create [] [:fn [[] :js-value]] (let [v (js-bool-value 7)] (fn [] v)))"))))

#?(:cljs
   (deftest callable-initializer-and-overloads-select-their-own-result-type
     (let [s "(defn undef [] :js-value (js-undefined))
              (defn create [g [:fn [[] :js-value]]] [:fn [[] :bool]]
                (let [v (g)] (fn [] (js-nullish? v))))
              (defn main [] :bool (let [f (create (fn-ref undef))] (f)))"]
       (is (true? (kir/execute (kir/lower (sema/analyze s)) 'main [] {}))))
     (let [s "(defn choice ([] :js-value (js-undefined)) ([x :i64] :i64 x))
              (defn create [] [:fn [[] :i64]] (let [v (choice 7)] (fn [] v)))
              (defn main [] :i64 (let [f (create)] (f)))"]
       (is (= (js/BigInt 7) (kir/execute (kir/lower (sema/analyze s)) 'main [] {}))))
     (let [s "(defn js-undefined [] :i64 7)
              (defn create [] [:fn [[] :i64]] (let [v (js-undefined)] (fn [] v)))
              (defn main [] :i64 (let [f (create)] (f)))"]
       (is (some? (refusal s))))))
