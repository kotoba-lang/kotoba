(ns kotoba.compiler.range-slots-test
  "The ABI v10 range heads at the frontend: typed, arity-checked, executed."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn- run [source] (kir/execute (kir/lower (sema/analyze source)) 'main [] {}))
(defn- refusal [source]
  (try (do (sema/analyze source) nil)
       (catch #?(:clj Throwable :cljs :default) e {:message (ex-message e)})))
(defn- w [x] #?(:clj x :cljs (js/Number x)))

(deftest the-two-heads-type-and-run
  (is (= 3 (w (run "(defn main [] :i64 (string-find-byte \"a\\nb\\n\" 10 2))"))))
  (is (= "xbc" (run "(defn main [] :string (string-append-range \"x\" \"abc\" 1 3))"))))

(deftest operand-types-are-required
  (is (re-find #"i64" (:message (refusal "(defn main [] :i64 (string-find-byte \"a\" \"b\" 0))"))))
  (is (re-find #"string" (:message (refusal "(defn main [] :string (string-append-range 1 \"abc\" 0 1))")))))

(deftest arities-are-checked-by-name
  (is (= "string operation arity mismatch: string-find-byte takes 3 arguments; got 2"
         (:message (refusal "(defn main [] :i64 (string-find-byte \"a\" 10))"))))
  (is (= "string operation arity mismatch: string-append-range takes 4 arguments; got 3"
         (:message (refusal "(defn main [] :string (string-append-range \"\" \"a\" 0))")))))
