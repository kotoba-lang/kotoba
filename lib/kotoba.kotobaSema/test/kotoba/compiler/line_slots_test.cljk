(ns kotoba.compiler.line-slots-test
  "The ABI v8 line heads at the frontend: typed, arity-checked, and executed
  through the reference interpreter."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn- run [source] (kir/execute (kir/lower (sema/analyze source)) 'main [] {}))
(defn- refusal [source]
  (try (do (sema/analyze source) nil)
       (catch #?(:clj Throwable :cljs :default) e {:message (ex-message e)})))
(defn- w [x] #?(:clj x :cljs (js/Number x)))

(deftest the-two-heads-type-and-run
  (is (= 2 (w (run "(defn main [] :i64 (string-index-of-from \"xaxab\" \"x\" 1))"))))
  (is (= -1 (w (run "(defn main [] :i64 (string-index-of-from \"abc\" \"c\" 3))"))))
  (is (= -1 (w (run "(defn main [] :i64 (string-compare-lines \"a\\nb\\n\" 0 \"a\\nb\\n\" 2))"))))
  (is (= 0 (w (run "(defn main [] :i64 (string-compare-lines \"ab\\n\" 0 \"ab\" 0))")))))

(deftest operand-types-are-required
  (is (re-find #"i64" (:message (refusal "(defn main [] :i64 (string-index-of-from \"a\" \"a\" \"0\"))"))))
  (is (re-find #"string" (:message (refusal "(defn main [] :i64 (string-compare-lines \"a\" 0 1 0))")))))

(deftest arities-are-checked-by-name
  (is (= "string operation arity mismatch: string-index-of-from takes 3 arguments; got 2"
         (:message (refusal "(defn main [] :i64 (string-index-of-from \"a\" \"a\"))"))))
  (is (= "string operation arity mismatch: string-compare-lines takes 4 arguments; got 3"
         (:message (refusal "(defn main [] :i64 (string-compare-lines \"a\" 0 \"b\"))")))))
