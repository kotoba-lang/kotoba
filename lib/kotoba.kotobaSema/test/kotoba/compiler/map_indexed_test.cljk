(ns kotoba.compiler.map-indexed-test
  "`map-indexed` (adr-2609111900, the selfhost ceiling loop). CLASSIFICATION:
  IMPLEMENTATION STATE, not a property -- nothing in `lang/guest-grammar.edn`
  or `lang/surface-status.edn` refused an index before this arm; the wall
  measured at amu 10469db0 against 225 sources was stdlib coverage (9 modules
  refused `unknown operation: map-indexed is not a builtin, a sugar head, or
  a function of this module`, e.g. multiformats base32.cljk), not a designed
  exclusion.

  `map-indexed` reuses `map`'s callback admission VERBATIM (named / inline /
  closure-value; literal / partial / comp refused by name; a parameter
  mapper requests its dispatcher, exactly as `map`'s stored callback does).
  The two differences from `map`: the callback's arity is fixed at two
  (there is only ever one source, so the arity is never the source count),
  and the callback takes the INDEX FIRST -- `(fn [i x] ...)`, not `(fn [x
  i] ...)` -- so a one-parameter callback (the shape a `map` callback author
  reaches for first) is refused by name with that reason instead of falling
  through to the generic parameter-count sentence.

  A module may define `map-indexed` itself; the into/mapv \"do not steal a
  module's own name\" rule (`mapv-alias-shadowing-test`) applies here too."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn- module [defs body]
  (str "(ns m.probe)\n" defs "\n(defn main [] :i64 " body ")\n"))

(defn- answer
  "Analyse, lower and RUN `main`; the value, not the admission."
  [defs body]
  (let [v (kir/execute (kir/lower (sema/analyze (module defs body))) 'main [] {})]
    #?(:clj (long v) :cljs (js/Number v))))

(defn- refusal [defs body]
  (try (do (sema/analyze (module defs body)) nil)
       (catch #?(:clj Throwable :cljs :default) e
         {:message (ex-message e) :form (:form (ex-data e))})))

(defn- function-names [source]
  (set (map :name (:functions (sema/analyze source)))))

;; ---------------------------------------------------------------- admitted

(deftest a-named-function-callback-maps-indexed
  (is (= 32 (answer "(defn add-idx [i x] (+ i x))(defn f [xs] (map-indexed add-idx xs))"
                    "(vector-at (f [10 20 30]) 2)"))))

(deftest an-inline-fn-maps-indexed
  (is (= 32 (answer "(defn f [xs] (map-indexed (fn [i x] (+ i x)) xs))"
                    "(vector-at (f [10 20 30]) 2)")))
  (testing "index arrives at zero for the first item"
    (is (= 10 (answer "(defn f [xs] (map-indexed (fn [i x] (+ i x)) xs))"
                      "(vector-at (f [10 20 30]) 0)"))))
  (testing "explicit do is the spelling for several forms"
    (is (= 32 (answer "(defn f [xs] (map-indexed (fn [i x] (do (+ i 0) (+ i x))) xs))"
                      "(vector-at (f [10 20 30]) 2)")))))

(deftest a-closure-value-maps-indexed
  (testing "a parameter, handed a closure literal"
    (is (= 32 (answer "(defn f [g xs] (map-indexed g xs))"
                      "(vector-at (f (fn [i x] (+ i x)) [10 20 30]) 2)"))))
  (testing "a parameter, handed (fn-ref named)"
    (is (= 32 (answer "(defn add-idx [i x] (+ i x))(defn f [g xs] (map-indexed g xs))"
                      "(vector-at (f (fn-ref add-idx) [10 20 30]) 2)"))))
  (testing "a let-bound closure"
    (is (= 32 (answer "(defn f [xs] (let [g (fn [i x] (+ i x))] (map-indexed g xs)))"
                      "(vector-at (f [10 20 30]) 2)")))))

(deftest a-parameter-mapper-requests-its-dispatcher
  ;; Exactly as `a-parameter-mapper-requests-its-dispatcher` in
  ;; map-callback-shape-test: a module with no lambda of arity 2 anywhere
  ;; in it must still get `__kotoba_invoke$arity2`, because the map-indexed
  ;; site REQUESTS it rather than merely naming it.
  (let [names (function-names "(ns m.lib (:export [f]))(defn f [g xs] (map-indexed g xs))")]
    (is (contains? names 'f))
    (is (contains? names '__kotoba_invoke$arity2))))

(deftest the-empty-source-maps-to-the-empty-vector
  (is (= 0 (answer "(defn f [xs] (vector-count (map-indexed (fn [i x] x) xs)))" "(f [])"))))

;; -------------------------------------------------------- own-name kept

(deftest a-module-that-defines-map-indexed-gets-its-own
  ;; The into/mapv rule (mapv-alias-shadowing-test): an undeclared alias
  ;; must not steal a module's own definition. This one walks a pair chain
  ;; and passes an index to `invoke` -- if the built-in stole the name
  ;; instead of deferring to this definition, it would be refused `expected
  ;; vector-i64, got i64` (a pair chain is not a vector-i64) instead of
  ;; running.
  (is (= 8 (answer (str "(defn map-indexed [f items] (if (= items 0) 0 "
                       "(pair (invoke f 0 (pair-first items)) "
                       "(map-indexed f (pair-second items)))))\n"
                       "(defn f [xs] (pair-first (map-indexed (fn [i x] (- 9 x)) xs)))")
                  "(f (pair 1 (pair 2 0)))")))
  (testing "the control: without a module definition, the built-in still lowers"
    (is (= 32 (answer "(defn f [xs] (vector-at (map-indexed (fn [i x] (+ i x)) xs) 2))"
                      "(f [10 20 30])")))))

;; ----------------------------------------------------------------- refusals

(deftest a-one-parameter-callback-is-refused-by-its-own-cause
  ;; The shape a `map` callback author reaches for first, refused BY NAME --
  ;; not the generic "requires 2 parameters; got 1" a blind arity check
  ;; would give -- because the cause is that the index comes first, not
  ;; merely that a count differs.
  (let [{:keys [message]} (refusal "(defn f [xs] (map-indexed (fn [x] x) xs))"
                                   "(vector-at (f [1 2]) 0)")]
    (is (= "map-indexed fn requires 2 parameters; got 1 -- map-indexed passes the index first: (fn [i x] ...), not (fn [x] ...)"
           message))))

(deftest a-keyword-callback-is-refused-by-its-kind
  (let [{:keys [message form]} (refusal "(defn f [xs] (map-indexed :a xs))" "(vector-at (f [1 2]) 0)")]
    (is (= :a form))
    (is (= "map-indexed callback must be a named function, an inline fn, or a closure value; got a keyword literal -- a map-indexed source is a vector-i64 and its item is an i64, so no keyword or literal can map it"
           message))))

(deftest the-kept-checks-each-say-why
  (testing "a named function of the wrong arity"
    (is (= "named map-indexed callback does not support two parameters; map-indexed passes the index first: (fn [i x] ...)"
           (:message (refusal "(defn g [x] x)(defn f [xs] (map-indexed g xs))" "(vector-at (f [1 2]) 0)")))))
  (testing "three parameters, still refused by count (not the index-first sentence)"
    (is (= "map-indexed fn requires 2 parameters (index, item); got 3"
           (:message (refusal "(defn f [xs] (map-indexed (fn [i x y] x) xs))" "(vector-at (f [1 2]) 0)")))))
  (testing "duplicate parameters"
    (is (= "map-indexed fn parameters must be unique"
           (:message (refusal "(defn f [xs] (map-indexed (fn [i i] i) xs))" "(vector-at (f [1 2]) 0)")))))
  (testing "empty body"
    (is (= "map-indexed fn requires a body expression"
           (:message (refusal "(defn f [xs] (map-indexed (fn [i x]) xs))" "(vector-at (f [1 2]) 0)")))))
  (testing "a multi-arity fn is not a map-indexed callback"
    (is (= "map-indexed fn requires a parameter vector; a multi-arity (fn ([i x] ...) ...) is not a map-indexed callback"
           (:message (refusal "(defn f [xs] (map-indexed (fn ([i x] x) ([i x y] x)) xs))" "(vector-at (f [1 2]) 0)")))))
  (testing "destructuring, the same reason map's callback gives"
    (is (= "map-indexed fn parameter destructures ([a]): the index and the item of a vector-i64 source are i64 and have no positions to bind; take symbols and index a typed value inside the body"
           (:message (refusal "(defn f [xs] (map-indexed (fn [[a] x] x) xs))" "(vector-at (f [1 2]) 0)"))))))

(deftest partial-and-comp-are-refused-as-not-heads
  (is (= "map-indexed callback (partial ...) is not admitted: partial is not a head of this language; write the callback as (fn [i x] ...)"
         (:message (refusal "(defn mul [a b] (* a b))(defn f [xs] (map-indexed (partial mul 2) xs))" "(vector-at (f [1 2]) 0)"))))
  (is (= "map-indexed callback (comp ...) is not admitted: comp is not a head of this language; write the callback as (fn [i x] ...)"
         (:message (refusal "(defn f [xs] (map-indexed (comp inc inc) xs))" "(vector-at (f [1 2]) 0)")))))

;; ------------------------------------------------------------- CID control

(deftest an-already-admitted-inline-map-analyses-to-the-same-hir
  ;; Nothing about `map`'s own lowering changed in this arm -- it is a new
  ;; case clause, not an edit to `map`'s. Pinned here so a future change
  ;; that reaches into the shared helpers (`bounded-vector-source-binding?`)
  ;; cannot silently move `map`'s own analysis.
  (let [hir (sema/analyze (module "(defn f [xs] (map (fn [x] (* x 2)) xs))" "(vector-at (f [3 4]) 1)"))
        helper (first (filter :loop-helper? (:functions hir)))]
    (is (= [:i64 :vector-i64 :vector-i64] (:param-types helper)))
    (is (= 8 (answer "(defn f [xs] (map (fn [x] (* x 2)) xs))" "(vector-at (f [3 4]) 1)")))))
