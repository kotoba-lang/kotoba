(ns kotoba.compiler.typed-closure-parameters-test
  "A closure PARAMETER may carry any type a closure RESULT may carry
  (2026-09-12, adr-2609111900 selfhost ceiling; `lang/guest-grammar.edn`
  `:callable-type` `:parameter-types`, `lang/surface-status.edn`
  `:typed-closure-parameters`).

  Until this wave `validate-value-type!` refused every `[:fn ...]` whose
  parameter types were not all `:i64` with `callable parameter types
  currently require the i64 closure ABI` (measured at 820e85d1: the source
  of `a-document-passes-through-a-closure-parameter` below was refused by
  exactly that sentence). That was IMPLEMENTATION STATE, not a property: a
  dispatcher is an ordinary KIR function with a typed signature and the
  helper a `fn` lowers to is another, so an argument crosses a closure call
  exactly as it crosses a direct call. This first-order widening kept callables and linear resources out.
  Higher-order contracts now retain nested callable refinements on i64
  words; linear resources remain refused.

  Selfhost measurements 16-19 (2026-09-12): `clojure.walk`'s twin could not
  offer `walk` / `prewalk` / `postwalk` because `(defn apply-doc [f [:fn
  [[:document] :document]] d :document] ...)` was refused; 21 of the
  compiler's own call sites in 19 modules were at that sentence.

  What is asserted, both directions:
    - a `:document`, a `[:set :keyword]`, two `:document`s, a record and a
      `:string` pass THROUGH a closure parameter and RUN on the interpreter;
    - a `fn-ref` written in a typed position is typed by the contract;
    - a let-bound closure from a typed RESULT contract is called with a
      typed argument;
    - the all-`:i64` contract program (amu callable_values_test's
      `public-callable-contracts-select-arity-and-result-family`) has the
      same HIR and KIR digests it had at 820e85d1 -- the control;
    - a nested callable-typed parameter runs without erasing its contract;
      a linear parameter stays refused; a type outside the result profile is
      refused by the sentence that names the predicate; a wrong argument at
      the call site is refused by the ordinary type-mismatch sentence."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]
            [kotoba.artifact.core :as artifact]))

(defn- answer
  "Compile SOURCE and run `main` on the interpreter."
  [source]
  (kir/execute (kir/lower (sema/analyze source)) 'main [] {}))

(defn- refusal
  [source]
  (try (do (sema/analyze source) nil)
       (catch #?(:clj Throwable :cljs :default) e
         {:message (ex-message e)
          :code (:kotoba.error/code (ex-data e))
          :expected (:kotoba.error/expected (ex-data e))
          :actual (:kotoba.error/actual (ex-data e))})))

(defn- function-named [hir name]
  (some #(when (= name (:name %)) %) (:functions hir)))

(defn- w [x] #?(:clj x :cljs (js/Number x)))

;; --- positives: run to a value ---------------------------------------------

(def ^:private apply-doc-source
  ;; The `clojure.walk` twin's shape: a document-to-document closure applied
  ;; to a document. `main` prints the merged document, so the assertion is on
  ;; the bytes that came back, not on a count that a trap could not fake.
  "(defn apply-doc [f [:fn [[:document] :document]] d :document] :document (f d))
   (defn main [] :string
     (document-print (apply-doc (fn [d] (document-merge d (document {:b 2})))
                                (document {:a 1}))))")

(deftest a-document-passes-through-a-closure-parameter
  (is (= (answer "(defn main [] :string (document-print (document {:a 1 :b 2})))")
         (answer apply-doc-source))
      "the closure's document-merge answered the merged document"))

(deftest a-typed-set-passes-through-a-closure-parameter
  (is (= 2 (w (answer "(defn count-with [f [:fn [[[:set :keyword]] :i64]] s [:set :keyword]] :i64 (f s))
                       (defn main [] :i64
                         (count-with (fn [s] (typed-set-count [:set :keyword] s)) #{:a :b}))")))))

(deftest two-document-parameters
  ;; One clause with two parameter types: `[[:document :document] :document]`.
  (is (= (answer "(defn main [] :string (document-print (document {:a 1 :b 2})))")
         (answer "(defn combine [f [:fn [[:document :document] :document]] a :document b :document] :document (f a b))
                  (defn main [] :string
                    (document-print (combine (fn [x y] (document-merge x y))
                                             (document {:a 1}) (document {:b 2}))))"))))

(deftest a-record-and-a-string-pass-through
  (testing "record"
    (is (= 7 (w (answer "(defn apply-pt [f [:fn [[[:record :demo/pt [[:x :i64]]]] :i64]] p [:record :demo/pt [[:x :i64]]]] :i64 (f p))
                         (defn main [] :i64
                           (apply-pt (fn [p] (record-get [:record :demo/pt [[:x :i64]]] p :x))
                                     (record-new [:record :demo/pt [[:x :i64]]] 7)))")))))
  (testing "string in, string out"
    (is (= 6 (w (answer "(defn apply-s [f [:fn [[:string] :string]] s :string] :string (f s))
                         (defn main [] :i64 (string-length (apply-s (fn [s] (string-concat s s)) \"abc\")))"))))))

(deftest a-fn-ref-in-a-typed-position-is-typed-by-the-contract
  (is (= 1 (w (answer "(defn wrap [d :document] :document (document-vector d))
                       (defn apply-doc [f [:fn [[:document] :document]] d :document] :document (f d))
                       (defn main [] :i64 (document-count (apply-doc (fn-ref wrap) (document-i64 1))))")))))

(deftest a-typed-result-contract-is-called-with-a-typed-argument
  (is (= 2 (w (answer "(defn make [] [:fn [[:document] :i64]] (fn [d] (document-count d)))
                       (defn main [] :i64
                         (let [g (make)] (g (document-vector (document-i64 1) (document-i64 2)))))")))))

(deftest a-typed-closure-parameter-passes-through-to-another-typed-slot
  ;; `twice` hands its own contract-typed `f` on; the lexical contract
  ;; selects the same dispatcher family at both sites.
  (is (= (answer "(defn main [] :string (document-print (document {:a 1 :n 1})))")
         (answer "(defn apply-doc [f [:fn [[:document] :document]] d :document] :document (f d))
                  (defn twice [f [:fn [[:document] :document]] d :document] :document
                    (apply-doc f (apply-doc f d)))
                  (defn main [] :string
                    (document-print (twice (fn [d] (document-merge d (document {:n 1})))
                                           (document {:a 1}))))"))))

;; --- what is emitted --------------------------------------------------------

(deftest the-typed-family-is-one-dispatcher-per-clause-signature
  (let [hir (sema/analyze apply-doc-source)
        dispatcher (some #(when (re-find #"^__kotoba_invoke_p_[0-9a-f]{64}_document\$arity1$"
                                         (str (:name %)))
                            %)
                         (:functions hir))
        helper (function-named hir '__kotoba_lambda_1_arity1)]
    (is (some? dispatcher) "a parameter-typed document family, named by its signature digest")
    (is (= [:i64 :document] (:param-types dispatcher))
        "the closure word stays i64; the argument is the clause's type")
    (is (= :document (:result dispatcher)))
    (is (= [:document] (:param-types helper)) "the lambda's own parameter carries the type")
    (is (= {0 [:fn [[:document] :document]]}
           (:callable-param-contracts (function-named hir 'apply-doc))))
    (is (= [:i64 :document] (:param-types (function-named hir 'apply-doc)))
        "the closure parameter itself is still one i64 word")))

;; --- every name the compiler writes is a name the compiler admits -----------

(def ^:private pt-type "[:record :demo/st [[:count :i64] [:phase :keyword]]]")

(def ^:private record-to-record-source
  ;; A node over a record STATE: typed parameter AND structured result.
  (str "(defn run [node [:fn [[" pt-type "] " pt-type "]] s " pt-type "] " pt-type " (node s))\n"
       "(defn main [] :i64 (record-get " pt-type " (run (fn [s] (record-new " pt-type
       " (+ 1 (record-get " pt-type " s :count)) :end)) (record-new " pt-type " 0 :go)) :count))\n"))

(deftest a-typed-parameter-with-a-structured-result-is-one-digest-not-two
  ;; Until 2026-09-15 this family was named `p_<64>_t_<64>`: 156 characters,
  ;; over `max-symbol-chars` (128), so the linked source amu writes for a
  ;; project was refused by `valid-name?` with `invalid function name` at a
  ;; span the author never wrote. Single-module analysis never validated the
  ;; synthesized name, so the same program was admitted here and refused
  ;; linked. The bound is asserted on EVERY function name the analysis
  ;; emits, not only the dispatcher, and the program still runs.
  (let [hir (sema/analyze record-to-record-source)
        names (map (comp str :name) (:functions hir))
        dispatcher (some #(when (re-find #"^__kotoba_invoke_pt_[0-9a-f]{64}\$arity1$" %) %) names)]
    (is (some? dispatcher) "typed parameters + structured result: one signature digest")
    (is (= 90 (count dispatcher)))
    (is (empty? (filter #(> (count %) 128) names))
        (str "names over max-symbol-chars: " (pr-str (filter #(> (count %) 128) names))))
    (is (= 1 (w (answer record-to-record-source))))))

(deftest the-two-older-families-keep-their-names
  ;; typed parameters + keyword result stays `p_<64>_<keyword>`; i64
  ;; parameters + structured result stays `t_<64>` -- a program that had a
  ;; name at cac05453 keeps it.
  (let [names (fn [source] (set (map (comp str :name) (:functions (sema/analyze source)))))
        p-names (names apply-doc-source)
        t-names (names (str "(defn make [] [:fn [[:i64] " pt-type "]] (fn [x] (record-new " pt-type " x :go)))\n"
                            "(defn main [] :i64 (let [g (make)] (record-get " pt-type " (g 3) :count)))\n"))]
    (is (some #(re-find #"^__kotoba_invoke_p_[0-9a-f]{64}_document\$arity1$" %) p-names))
    (is (some #(re-find #"^__kotoba_invoke_t_[0-9a-f]{64}\$arity1$" %) t-names))
    (is (not-any? #(re-find #"_pt_" %) (concat p-names t-names)))))

;; --- the control: an all-i64 contract program is untouched -----------------

(def ^:private i64-contract-source
  ;; amu callable_values_test `public-callable-contracts-select-arity-and-
  ;; result-family`, verbatim modulo whitespace.
  (str "(defn apply-one [f [:fn [[:i64] :i64]] x :i64] :i64 (f x))\n"
       "(defn make-renderer [] [:fn [[:i64] :string]] (fn [x] (string-from-i64 x)))\n"
       "(defn main [] :i64 (+ (apply-one (fn [x] (+ x 1)) 4) (string-length (let [render (make-renderer)] (render 42)))))\n"))

(def ^:private i64-contract-goldens
  "Digests of `(pr-str hir)` and `(pr-str (kir/lower hir))` for
  `i64-contract-source`, measured on nbb at kotoba-sema 820e85d1 -- the
  frontend BEFORE typed closure parameters, shadowed onto the classpath
  ahead of the changed one -- and again after the change: equal.

  Per runtime because the digest is over a rendering (a `.kotoba` integer
  literal prints as `42n` on ClojureScript and `42` on the JVM). The JVM
  pair was NOT measured in this wave (no JVM was run), so on `:clj` the
  control is the signature shape below and not a digest."
  #?(:cljs {:hir "8ed8945497035aa0f2be4c75e81bfc83b2fde6271c54861f48a74940e654f16b"
            :kir "7ce233b51df35dd6f0bc8c350f024d197fa619343448719010ab39e95d4e054f"}
     :clj nil))

(deftest an-all-i64-contract-program-lowers-as-it-did-before
  (let [hir (sema/analyze i64-contract-source)]
    (is (= 7 (w (kir/execute (kir/lower hir) 'main [] {}))))
    (is (= '[apply-one make-renderer main __kotoba_lambda_1_arity1 __kotoba_lambda_2_arity1
             __kotoba_invoke$arity1 __kotoba_invoke_string$arity1
             __kotoba_string_from_i64_nat __kotoba_string_from_i64]
           (mapv :name (:functions hir)))
        "the i64 family keeps its old dispatcher names")
    (is (= [:i64 :i64] (:param-types (function-named hir '__kotoba_invoke$arity1))))
    (is (= [:i64] (:param-types (function-named hir '__kotoba_lambda_1_arity1))))
    (when i64-contract-goldens
      (is (= (:hir i64-contract-goldens) (artifact/sha256 (pr-str hir))))
      (is (= (:kir i64-contract-goldens) (artifact/sha256 (pr-str (kir/lower hir))))))))

;; --- negatives: refused by the sentence that names the rule ----------------

(deftest a-callable-typed-parameter-retains-its-contract-on-a-word-slot
  (is (= 42 (w (answer "(defn apply-higher [f [:fn [[[:fn [[:i64] :i64]]] :i64]] g [:fn [[:i64] :i64]]] :i64 (f g))
                         (defn main [] :i64 (apply-higher (fn [g] (g 41)) (fn [x] (+ x 1))))"))))
  (is (nil? (refusal "(defn ok [f [:fn [[[:fn [[:i64] :i64]]] :i64]]] :i64 0)
                      (defn main [] :i64 0)"))))

(deftest a-linear-parameter-stays-refused
  (let [{:keys [message code]} (refusal "(defn bad [f [:fn [[[:stream :bytes]] :i64]]] :i64 0)
                                         (defn main [] :i64 0)")]
    (is (= "callable parameter types cannot be linear resources" message))
    (is (= :kotoba.error/callable-parameter-type code))))

(deftest a-parameter-type-outside-the-result-profile-is-refused-by-the-predicate
  ;; `:keyword` is not a closure result type today (closure-flat-result-types
  ;; does not list it), so it is not a closure parameter type either: one
  ;; predicate, both sides.
  (let [{:keys [message code]} (refusal "(defn bad [f [:fn [[:keyword] :i64]]] :i64 0)
                                         (defn main [] :i64 0)")]
    (is (= (str "callable parameter type is outside the admitted dispatcher profile "
                "(a parameter type is admitted exactly when it is admitted as a closure result type)")
           message))
    (is (= :kotoba.error/callable-parameter-type code))))

(deftest the-old-sentence-is-gone
  (is (nil? (refusal "(defn ok [f [:fn [[:string] :i64]]] :i64 0)
                      (defn main [] :i64 0)"))
      "amu callable_values_test's `[:fn [[:string] :i64]]` case is admitted now"))

(deftest a-wrong-argument-at-the-call-site-is-a-type-mismatch
  ;; An i64 EXPRESSION where the clause says `:document`: refused by the
  ;; ordinary checker against the dispatcher's signature. (A bare integer
  ;; LITERAL in a `:document` slot is read as a document literal, exactly as
  ;; `(defn g [] :document 42)` is -- the argument takes the result path's
  ;; expected-type context.)
  (let [{:keys [message expected actual]}
        (refusal "(defn apply-doc [f [:fn [[:document] :document]] n :i64] :document (f (+ n 1)))
                  (defn main [] :i64 0)")]
    (is (= "expression type mismatch: expected document, got i64" message))
    (is (= :document expected))
    (is (= :i64 actual)))
  (testing "a set slot given an i64 parameter"
    (let [{:keys [message]}
          (refusal "(defn count-with [f [:fn [[[:set :keyword]] :i64]] n :i64] :i64 (f n))
                    (defn main [] :i64 0)")]
      (is (= "expression type mismatch: expected [:set :keyword], got i64" message)))))
