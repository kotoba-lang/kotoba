(ns kotoba.compiler.quoted-symbol-constants-test
  "Quoted symbol data -- `'sym`, `'#{a b}`, `'{a 1 b 2}`, `'[a b]` -- as an
  expression and as a module constant (adr-2609111900, the selfhost ceiling
  loop; the wall: lang/selfhost-distance.edn measurement 18 at amu cdebca89,
  225 compiler sources, 12 modules refused `constant value is quoted data
  holding symbols: ... spell the entries as keywords` -- 8 with a quoted SET
  of symbols, 4 with a quoted MAP whose keys are symbols, every one an
  operation table of the compiler's own: `(def arithmetic '#{+ - * quot
  ...})`, `(def heap-operations '{pair 2 pair-first 1})`, `(def find-name
  'kotoba$string-index-find)`. The members ARE symbols; keywords are not
  available to those authors).

  CLASSIFICATION, written before the change: IMPLEMENTATION STATE. `:symbol`
  is a value type of the frontend, `(symbol \"a\")` builds one, the typed
  constructors take `:symbol` descriptors; only the literal spelling was
  missing (measured 2026-09-12: `'a` in a body was `unknown operation:
  quote`, `(def s (symbol \"a\"))` was `evaluates to a :symbol, which has no
  literal spelling`).

  Pinned here:

  1. positives, each RUN on the KIR interpreter: `'a` as an expression;
     a symbol-set constant answered by `typed-set-contains` (1 for a member,
     0 for a non-member -- `contains?` is refused on a typed set, measured);
     a symbol-key map constant answered by `get` (i64 and string values);
     a symbol constant; a namespaced `'ns/x` (the symbol `(symbol \"ns/x\")`
     gives -- that call was measured admitted, and mirrored); a symbol vector;
  2. the CID control: `'a` and `(symbol \"a\")` analyse EQUAL, in a body and
     at a def; `'#{a b}` and `(typed-set-new [:set :symbol] (symbol \"a\")
     (symbol \"b\"))` analyse EQUAL; `'{a 1 b 2}` and the `typed-map-new`
     spelling analyse EQUAL -- one definition CID for the two spellings;
  3. the refusals BY NAME: a set / vector mixing symbols with other kinds, a
     map mixing key kinds, a map whose values are not one scalar kind, a
     quoted list in a body; a quoted list at a def keeps the closedness
     sentence, as `'(1 2)` does; `=` on two symbols is NOT widened here and
     its refusal is pinned so the next wave sees it."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn- module [defs result body]
  (str "(ns m.probe)\n" defs "\n(defn main [] " result " " body ")\n"))

(defn- answer
  "Analyse, lower and RUN `main`; the value, not the admission."
  [defs result body]
  (kir/execute (kir/lower (sema/analyze (module defs result body))) 'main [] {}))

(defn- answer-i64 [defs body]
  (let [v (answer defs ":i64" body)]
    #?(:clj (long v) :cljs (js/Number v))))

(defn- refusal [defs result body]
  (try (do (sema/analyze (module defs result body)) nil)
       (catch #?(:clj Throwable :cljs :default) e
         {:message (ex-message e) :code (:kotoba.error/code (ex-data e))})))

(defn- main-function [hir]
  (some #(when (= 'main (:name %)) %) (:functions hir)))

;; ---------------------------------------------------------------- positives

(deftest a-quoted-symbol-is-an-expression-of-type-symbol
  (is (= 'a (answer "" ":symbol" "'a")))
  (is (= 'a (answer "" ":symbol" "(quote a)")))
  ;; a namespaced symbol is the one `(symbol "ns/x")` gives
  (is (= 'ns/x (answer "" ":symbol" "'ns/x")))
  (is (= 'ns/x (answer "" ":symbol" "(symbol \"ns/x\")"))))

(deftest a-symbol-set-constant-answers-membership
  ;; the shape of measurement 18's 8 modules: `(def arithmetic '#{+ - * ...})`
  (is (= 1 (answer-i64 "(def ops '#{a b})" "(if (typed-set-contains [:set :symbol] ops 'a) 1 0)")))
  (is (= 0 (answer-i64 "(def ops '#{a b})" "(if (typed-set-contains [:set :symbol] ops 'c) 1 0)")))
  (is (= 2 (answer-i64 "(def ops '#{a b})" "(count ops)")))
  (is (= 1 (answer-i64 "(def arithmetic '#{+ - * quot bit-xor bit-and bit-or})"
                       "(if (typed-set-contains [:set :symbol] arithmetic 'bit-xor) 1 0)")))
  ;; a later constant may read it (the fold sees the quoted set as data)
  (is (= 3 (answer-i64 "(def ops '#{a b}) (def more (typed-set-conj [:set :symbol] ops 'c))" "(count more)"))))

(deftest a-symbol-key-map-constant-answers-lookup
  ;; the shape of measurement 18's 4 modules: `(def heap-operations '{pair 2 ...})`
  (is (= 2 (answer-i64 "(def m '{pair 2 pair-first 1 pair-second 1})" "(get m 'pair 0)")))
  (is (= 1 (answer-i64 "(def m '{pair 2 pair-first 1 pair-second 1})" "(get m 'pair-first 0)")))
  (is (= 0 (answer-i64 "(def m '{pair 2 pair-first 1 pair-second 1})" "(get m 'absent 0)")))
  (is (= 3 (answer-i64 "(def m '{pair 2 pair-first 1 pair-second 1})" "(count m)")))
  ;; string values, the `'{aiueos-capability-v2-wit "..."}` shape
  (is (= "wit" (answer "(def m '{aiueos-capability-v2-wit \"wit\"})" ":string"
                       "(get m 'aiueos-capability-v2-wit \"\")"))))

(deftest a-symbol-constant-and-a-symbol-vector-constant
  (is (= 'kotoba$string-index-find
         (answer "(def find-name 'kotoba$string-index-find)" ":symbol" "find-name")))
  (is (= 'ns/x (answer "(def s 'ns/x)" ":symbol" "s")))
  (is (= 2 (answer-i64 "(def v '[a b])" "(count v)")))
  (is (= 'b (answer "(def v '[a b])" ":symbol" "(nth v 1)")))
  ;; a quoted symbol inside an unquoted vector literal is a :symbol item
  (is (= 'a (answer "(def v [1 'a])" ":symbol" "(nth v 1)"))))

;; ------------------------------------------------------------- CID control

(deftest the-quoted-and-constructed-spellings-are-one-analysis
  ;; `'a` and `(symbol "a")` -- the same KIR, so amu's definition CID (a
  ;; function of this analysis) cannot differ
  (let [quoted (sema/analyze (module "" ":symbol" "'a"))
        built (sema/analyze (module "" ":symbol" "(symbol \"a\")"))]
    (is (= '(symbol "a") (:body (main-function quoted))))
    (is (= (main-function quoted) (main-function built)))
    (is (= quoted built)))
  ;; at a def: the literal `'a` and the folded `(symbol "a")` are one constant
  (let [quoted (sema/analyze (module "(def s 'a)" ":symbol" "s"))
        built (sema/analyze (module "(def s (symbol \"a\"))" ":symbol" "s"))]
    (is (= quoted built)))
  ;; the symbol set: the quoted literal and the typed constructor
  (let [quoted (sema/analyze (module "(def s '#{a b})" ":i64" "(count s)"))
        built (sema/analyze (module "(def s (typed-set-new [:set :symbol] (symbol \"a\") (symbol \"b\")))" ":i64" "(count s)"))]
    (is (= '(typed-set-count [:set :symbol] (typed-set-new [:set :symbol] (symbol "a") (symbol "b")))
           (:body (main-function quoted))))
    (is (= quoted built)))
  ;; the symbol-key map: the quoted literal and the typed constructor
  (let [quoted (sema/analyze (module "(def m '{a 1 b 2})" ":i64" "(get m 'a 0)"))
        built (sema/analyze (module "(def m (typed-map-new [:map :symbol :i64] (symbol \"a\") 1 (symbol \"b\") 2))" ":i64" "(get m 'a 0)"))]
    (is (= quoted built))))

;; ----------------------------------------------------------------- refusals

(deftest a-mixed-quoted-set-is-refused-by-name
  (let [{:keys [message code]} (refusal "(def ops '#{a :b})" ":i64" "0")]
    (is (= :kotoba.error/subset-reject code))
    (is (= "quoted set mixes symbols with other kinds: (quote #{:b a}) -- a symbol set ([:set :symbol]) holds symbols only; spell every entry as a symbol, or every entry as a keyword"
           message)))
  ;; the same sentence in a body
  (is (= "quoted set mixes symbols with other kinds: (quote #{:b a}) -- a symbol set ([:set :symbol]) holds symbols only; spell every entry as a symbol, or every entry as a keyword"
         (:message (refusal "" ":i64" "(count '#{a :b})"))))
  ;; a nested collection is another kind
  (is (= "quoted set mixes symbols with other kinds: (quote #{[b] a}) -- a symbol set ([:set :symbol]) holds symbols only; spell every entry as a symbol, or every entry as a keyword"
         (:message (refusal "(def ops '#{a [b]})" ":i64" "0")))))

(deftest a-mixed-quoted-map-is-refused-by-name
  (is (= "quoted map mixes symbol keys with other key kinds: (quote {:b 2, a 1}) -- a symbol-key map ([:map :symbol V]) holds symbol keys only; spell every key as a symbol, or every key as a keyword"
         (:message (refusal "(def m '{a 1 :b 2})" ":i64" "0"))))
  (is (= "quoted symbol-key map values are not one scalar kind: (quote {a 1, b \"s\"}) -- a symbol-key map is [:map :symbol V] for one V of integer / string / keyword / boolean; a symbol or a collection is not a value it holds"
         (:message (refusal "(def m '{a 1 b \"s\"})" ":i64" "0"))))
  ;; a symbol VALUE is not a value the map holds
  (is (= "quoted symbol-key map values are not one scalar kind: (quote {a b}) -- a symbol-key map is [:map :symbol V] for one V of integer / string / keyword / boolean; a symbol or a collection is not a value it holds"
         (:message (refusal "(def m '{a b})" ":i64" "0")))))

(deftest a-mixed-quoted-vector-is-refused-by-name
  (is (= "quoted vector mixes symbols with other kinds: (quote [a 1]) -- a symbol vector ([:vector [:symbol ...]]) holds symbols only; spell every item as a symbol"
         (:message (refusal "(def v '[a 1])" ":i64" "0")))))

(deftest a-quoted-list-keeps-its-refusal
  ;; at a def: the closedness sentence, as `'(1 2)` has always had
  (let [{:keys [message code]} (refusal "(def x '(a b))" ":i64" "0")]
    (is (= :kotoba.error/subset-reject code))
    (is (= "constant value must be closed bounded integer/string/keyword/boolean/nil/vector/map or non-empty keyword-set data" message)))
  (is (= "constant value must be closed bounded integer/string/keyword/boolean/nil/vector/map or non-empty keyword-set data"
         (:message (refusal "(def x '(1 2))" ":i64" "0"))))
  ;; in a body: by name
  (is (= "quoted list has no literal spelling: (quote (a b)) -- quote admits a symbol, a symbol set, a symbol-key map or a symbol vector; a list is a heap value built with list"
         (:message (refusal "" ":i64" "(count '(a b))")))))

(deftest equality-on-symbols-is-not-widened-by-this-wave
  ;; recorded, not changed: measurement 18 shows the same sentence for
  ;; `(= (symbol "a") (symbol "a"))`; membership is typed-set-contains
  (is (= "equality type is outside the safe value profile"
         (:message (refusal "" ":bool" "(= 'a 'a)"))))
  (is (= "equality type is outside the safe value profile"
         (:message (refusal "" ":bool" "(= (symbol \"a\") (symbol \"a\"))")))))
