(ns kotoba.compiler.expression-absence-test
  "Expression-level absence (gap 1 of the selfhost foundation, superproject
  adr-2609242330; amu ladder floor :expression-absence).

  A `when` / `when-not` / `if-not` / `when-let` / `if-let` / `cond` with no
  else, and a literal `nil` branch, answer nothing on that path. The present
  branch's type decides what nothing is: false beside a :bool, the none of an
  option beside an option, and `[:option T]` beside any other T -- an :i64
  too, except where the author declared the function's result, where a
  missing else is still the 0 it always was. Until 2026-09-26 the desugar
  wrote the i64 0 on every such path, so any other present type was refused
  (`first-truthy`'s loop: \"loop exits with two different value types: bool
  ... and i64 from 0\")."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn- run [source]
  (kir/execute (kir/lower (sema/analyze source)) 'main [] {}))
(defn- refusal [source]
  (try (do (kir/lower (sema/analyze source)) nil)
       (catch #?(:clj Throwable :cljs :default) e (ex-message e))))
(defn- w [x] #?(:clj x :cljs (js/Number x)))

(deftest a-missing-else-is-absence
  (testing "admitted: beside a keyword, a string, an i64 in an inferred result -> [:option T]"
    (is (= 11 (w (run (str "(defn- f [x :i64] (when (> x 0) :pos))\n"
                           "(defn main [] :i64 (+ (if (f 1) 1 0) (if (f -1) 100 0) (if-let [k (f 2)] 10 0)))")))))
    (is (= 2 (w (run (str "(defn- f [x :i64] (if (> x 0) \"ab\" nil))\n"
                          "(defn main [] :i64 (if-let [s (f 1)] (string-byte-length s) 99))")))))
    (is (= 12 (w (run (str "(defn- f [x :i64] (if (> x 0) x nil))\n"
                           "(defn main [] :i64 (+ (option-value-of [:option :i64] (f 5) 7) "
                           "(option-value-of [:option :i64] (f -5) 7)))"))))))
  (testing "admitted: beside a :bool the absent path is false"
    (is (= 1 (w (run (str "(defn- f [x :i64] :bool (when (> x 0) (> x 10)))\n"
                          "(defn main [] :i64 (+ (if (f 20) 1 0) (if (f 5) 10 0) (if (f -1) 100 0)))"))))))
  (testing "admitted: beside an option it is that option's none (flattened)"
    (is (= 3 (w (run (str "(defn- g [x :i64] (when (> x 0) :k))\n"
                          "(defn- f [x :i64] (when (< x 100) (g x)))\n"
                          "(defn main [] :i64 (+ (if (f 5) 1 0) (if (f -5) 10 0) (if (f 500) 100 0) (if (f 7) 2 0)))"))))))
  (testing "admitted: cond with no :else, when-let with no else"
    (is (= 101 (w (run (str "(defn- c [x :i64] (cond (= x 1) :one (= x 2) :two))\n"
                            "(defn- l [o [:option :string]] (when-let [s o] :has))\n"
                            "(defn main [] :i64 (+ (if (c 1) 1 0) (if (c 3) 10 0) "
                            "(if (l (option-some-of [:option :string] \"x\")) 100 0) "
                            "(if (l (option-none-of [:option :string])) 1000 0)))")))))))

(deftest a-loop-that-finds-nothing-answers-absence
  (testing "admitted: find-first -- index 0 found is not the same as nothing found"
    (is (= -10 (w (run (str "(defn- idx [v :vector-i64 t :i64] (loop [i 0] (when (< i (count v)) "
                            "(if (= (nth v i) t) i (recur (inc i))))))\n"
                            "(defn main [] :i64 (+ (option-value-of [:option :i64] (idx (vector-i64 5 6 7) 5) -1) "
                            "(* 10 (option-value-of [:option :i64] (idx (vector-i64 5 6 7) 9) -1))))"))))))
  (testing "admitted: first-truthy's loop shape, with an option predicate and with a bool one"
    (is (= 21 (w (run (str "(defn- hit [v :vector-i64 t :i64] (loop [i 0] (when (< i (count v)) "
                           "(or (when (= (nth v i) t) :hit) (recur (inc i))))))\n"
                           "(defn- any [v :vector-i64 t :i64] (loop [i 0] (when (< i (count v)) "
                           "(or (= (nth v i) t) (recur (inc i))))))\n"
                           "(defn main [] :i64 (+ (if (hit (vector-i64 1 2) 2) 1 0) (if (hit (vector-i64 1 2) 3) 10 0) "
                           "(if (any (vector-i64 1 2) 1) 20 0) (if (any (vector-i64 1 2) 9) 300 0)))")))))))

(deftest a-declared-result-keeps-the-i64-stand-in
  (testing "admitted, unchanged: where the author declared :i64, a missing else is 0"
    (is (= 101 (w (run "(defn main [] :i64 (+ (when true 100) (when false 10) 1))"))))
    (is (= 105 (w (run "(defn main [] :i64 (let [n 5] (when (> n 0) (+ n 10) (+ n 100))))")))))
  (testing "admitted, unchanged: a statement's missing else is still the 0 it was"
    (is (= 7 (w (run "(defn- f [v :vector-i64] (do (when (> (count v) 1) (count v)) 7))\n(defn main [] :i64 (f (vector-i64 1 2 3)))"))))))

(deftest what-absence-does-not-admit
  (testing "refused: an absent i64 is not the number it would hold (no coercion)"
    (is (= "expression type mismatch: expected i64, got [:option :i64]"
           (refusal "(defn- f [x :i64] (when (> x 0) x))\n(defn main [] :i64 (+ (f 1) 1))"))))
  (testing "refused: two present values of different types are still two types"
    (is (= "if branches must have the same value type"
           (refusal "(defn main [] :i64 (let [k (if (> 1 0) :k 5)] 1))"))))
  (testing "refused: `if` still takes an else (`when` is the form without one)"
    (is (= "if requires test, then, else; got 2 arguments"
           (refusal "(defn main [] :i64 (if (> 1 0) 1))")))))
