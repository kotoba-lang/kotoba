(ns kotoba.compiler.bytes-value-test
  "`:bytes` as a guest value and the string constructor at the frontend
  (2026-09-25, superproject adr-2609242330): the three heads that build
  values are typed, arity-checked and executed; `:bytes` and `:vector-i64`
  stay two types."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn- run [source] (kir/execute (kir/lower (sema/analyze source)) 'main [] {}))
(defn- refusal [source]
  (try (do (sema/analyze source) nil)
       (catch #?(:clj Throwable :cljs :default) e {:message (ex-message e)})))
(defn- w [x] #?(:clj x :cljs (js/Number x)))

(deftest the-constructors-type-and-run
  (is (= "hiあ" (run "(defn main [] :string (string-from-utf8 (bytes-from-vector-i64 (vector-i64 104 105 227 129 130))))")))
  (is (= 3 (w (run "(defn main [] :i64 (vector-count (vector-i64-from-bytes (bytes-from-vector-i64 (vector-i64 1 2 3)))))"))))
  (is (= 2 (w (run "(defn b [] :bytes (bytes-from-vector-i64 (vector-i64 9 8)))\n(defn main [] :i64 (bytes-count (b)))")))
      "a :bytes result crosses a function boundary"))

(deftest bytes-and-vector-i64-are-two-types
  (is (re-find #"expected bytes, got vector-i64"
               (:message (refusal "(defn main [] :string (string-from-utf8 (vector-i64 104)))")))
      "a vector of small ints is not a byte string")
  (is (re-find #"expected vector-i64, got bytes"
               (:message (refusal "(defn main [] :bytes (bytes-from-vector-i64 (bytes-empty)))"))))
  (is (re-find #"expected bytes, got string"
               (:message (refusal "(defn main [] :vector-i64 (vector-i64-from-bytes \"ab\"))")))))

(deftest arities-are-refused-by-name
  (is (= "string-from-utf8 requires one operand; got 2"
         (:message (refusal "(defn main [] :string (string-from-utf8 (bytes-empty) (bytes-empty)))"))))
  (is (= "bytes-from-vector-i64 requires one operand; got 0"
         (:message (refusal "(defn main [] :bytes (bytes-from-vector-i64))")))))

(deftest a-refusal-at-run-time-carries-its-name
  (is (= :utf8/overlong
         (try (run "(defn main [] :string (string-from-utf8 (bytes-from-vector-i64 (vector-i64 192 128))))") nil
              (catch #?(:clj Throwable :cljs :default) e (:trap (ex-data e))))))
  (is (= :bytes/item-out-of-range
         (try (run "(defn main [] :i64 (bytes-count (bytes-from-vector-i64 (vector-i64 256))))") nil
              (catch #?(:clj Throwable :cljs :default) e (:trap (ex-data e)))))))
