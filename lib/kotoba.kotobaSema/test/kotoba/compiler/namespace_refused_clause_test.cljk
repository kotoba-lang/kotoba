(ns kotoba.compiler.namespace-refused-clause-test
  "The namespace clauses the frontend refuses BY NAME (kotoba-lang
  `lang/guest-grammar.edn` `:ns-refused-clauses`, 2026-09-11): `:import`,
  `:require-macros`, `:use`, `:load`, `:gen-class`. (`:refer-clojure` left
  the set the same day: it is admitted as a no-op, see
  `namespace_refer_clojure_test`.)

  Nothing here is admitted. What the test pins is that each refusal says
  which clause it saw and why, so a census of refusals over dual-runtime
  source (the compiler's own modules: 18 carry `:import`) can tell host
  interop from a malformed admitted clause -- answers that the one generic
  sentence used to flatten.

  The control is `:require`: it must keep the generic sentence VERBATIM,
  because amu's `kotoba.compiler.diagnostic/refine` recognises exactly that
  code and head and renames it to the project-route remedy. A rename here
  would turn that remedy into the generic refusal again."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]))

(defn- refusal [source]
  (try (do (sema/analyze source) nil)
       (catch #?(:clj Throwable :cljs :default) e
         {:message (ex-message e)
          :code (:kotoba.error/code (ex-data e))
          :form (:form (ex-data e))})))

(def ^:private body "\n(defn main [] :i64 1)")

(deftest a-refused-clause-is-named
  (doseq [[clause expected-head expected-reason]
          [["(:import [java.io File])" ":import" "host interop (a Java / JS class) is outside the language"]
           ["(:require-macros [m :refer [x]])" ":require-macros" "macros are outside the language"]
           ["(:use [m])" ":use" "an unqualified ambient namespace is outside the language"]
           ["(:load \"x\")" ":load" "loading source at run time is outside the language"]
           ["(:gen-class)" ":gen-class" "host interop is outside the language"]]]
    (testing clause
      (let [r (refusal (str "(ns t (:export [main]) " clause ")" body))]
        (is (some? r) (str clause " was admitted"))
        (is (= :kotoba.error/namespace-host-clause (:code r)) (pr-str r))
        (is (= (str "namespace clause " expected-head " is not admitted: " expected-reason
                    "; the admitted clauses are :export, :capabilities and :schemas"
                    " (and :require / :params on the project route)")
               (:message r))
            (pr-str r))))))

(deftest the-named-refusal-wins-over-the-clause-count
  ;; Four clauses, one of them `:import`: the answer is the `:import`, not
  ;; "at most three clauses" -- the count is not the cause.
  (let [r (refusal (str "(ns t (:export [main]) (:capabilities #{}) (:schemas {}) (:import [java.io File]))" body))]
    (is (= :kotoba.error/namespace-host-clause (:code r)) (pr-str r))))

(deftest require-keeps-the-generic-sentence-for-amu-to-refine
  (let [r (refusal (str "(ns t (:require [m :as a]) (:export [main]))" body))]
    (is (= :kotoba.error/namespace-export-clause (:code r)) (pr-str r))
    (is (= "only a bounded :export vector is admitted in namespace clauses" (:message r)))
    (is (= :require (first (:form r))) "the form in ex-data is the clause amu keys on")))

(deftest an-unknown-head-is-still-the-generic-refusal
  ;; The named set is closed: a head nobody listed is refused, not named,
  ;; so `namespace-refused-clauses` cannot silently become an allow-list.
  (let [r (refusal (str "(ns t (:export [main]) (:frobnicate 1))" body))]
    (is (= :kotoba.error/namespace-export-clause (:code r)) (pr-str r))))
