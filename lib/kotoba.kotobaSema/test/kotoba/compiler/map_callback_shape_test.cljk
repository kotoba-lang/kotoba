(ns kotoba.compiler.map-callback-shape-test
  "The `map` callback, by shape (adr-2609111900, the selfhost ceiling loop;
  compiler-side wall measured 2026-09-11 at amu 6e56b1d8 / kotoba-sema
  6a35ed4a: 7 of the compiler's own 208 sources were refused `1-source map
  fn requires matching unique parameters and one expression`).

  What the measurement found BEFORE anything was changed: the 7 modules were
  ONE site -- `(map (fn [[k v]] ...) x)` in kotoba.artifact.core/edn-safe,
  reached through `into`'s transducer rewrite by everything that requires
  artifact -- and the one sentence covered five conditions, so it did not say
  which. Probing each shape on the interpreter (`answer` below) also found a
  parameter used as the mapper, in a module with no lambda of that arity,
  answered with a SYNTHESIZED name (`unknown operation: __kotoba_invoke$arity1
  is not a builtin`): the map site named the dispatcher without requesting
  it, while `(g x)` in the same module requested it and compiled.

  CLASSIFICATION, with the authority's evidence:

  - a named module function / a parameter / a let-bound closure / `(fn-ref
    f)` / `#(...)` / two sources -- ADMITTED already (surface-status
    `:map-function :callback :portable`); pinned here by RUNNING each to a
    value, and the parameter case in a module with no local lambda.
  - `(fn [[k v]] ...)` -- IMPLEMENTATION STATE: destructuring is admitted in
    let and function parameters (`:nested-destructuring :portable-scope`),
    and what is missing is a source model past vector-i64 for the item to
    have positions in. Refused BY NAME with that reason, so it moves when
    the source model does.
  - `(fn [x] a b)` -- WAS the profile's one-expression rule (guest-grammar
    `:implicit-body-forms :refuses` held `fn` and `defn`; explicit `do` was
    the spelling), refused by name mirroring defn's sentence. 2026-09-12 the
    grammar moved `fn` and `defn` to `:sequences` for every site at once, so
    several forms are one `do` here too; `defn-body-sequences-test` pins the
    answer, and the test below pins that this site follows.
  - a keyword / literal / `(partial ...)` / `(comp ...)` -- no value model
    (a map source is a vector-i64; partial and comp are not heads). Refused
    by name instead of falling through to the dispatcher.
  - arity mismatch / duplicate parameters / empty body -- KEPT, each with its
    own sentence.

  CID control: an already-admitted `(map (fn [x] ...) coll)` analyses to the
  same HIR before and after (the split touches only refusals and the
  stored-callback dispatcher request), so amu's definition CIDs cannot move."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn- module [defs body]
  (str "(ns m.probe)\n" defs "\n(defn main [] :i64 " body ")\n"))

(defn- answer
  "Analyse, lower and RUN `main`; the value, not the admission."
  [defs body]
  (let [v (kir/execute (kir/lower (sema/analyze (module defs body))) 'main [] {})]
    #?(:clj (long v) :cljs (js/Number v))))

(defn- refusal [defs body]
  (try (do (sema/analyze (module defs body)) nil)
       (catch #?(:clj Throwable :cljs :default) e
         {:message (ex-message e) :form (:form (ex-data e))})))

(defn- function-names [source]
  (set (map :name (:functions (sema/analyze source)))))

;; ---------------------------------------------------------------- admitted

(deftest a-named-module-function-maps
  (is (= 8 (answer "(defn dbl [x] (* x 2))(defn f [xs] (map dbl xs))"
                   "(vector-at (f [3 4]) 1)")))
  (testing "over two sources"
    (is (= 24 (answer "(defn add [a b] (+ a b))(defn f [xs ys] (map add xs ys))"
                      "(vector-at (f [3 4] [10 20]) 1)")))))

(deftest an-inline-fn-maps
  (is (= 8 (answer "(defn f [xs] (map (fn [x] (* x 2)) xs))" "(vector-at (f [3 4]) 1)")))
  (testing "#(...) reads to the inline shape"
    (is (= 8 (answer "(defn f [xs] (map #(* % 2) xs))" "(vector-at (f [3 4]) 1)"))))
  (testing "explicit do is the spelling for several forms"
    (is (= 8 (answer "(defn f [xs] (map (fn [x] (do (+ x 0) (* x 2))) xs))"
                     "(vector-at (f [3 4]) 1)"))))
  (testing "two sources, two parameters"
    (is (= 24 (answer "(defn f [xs ys] (map (fn [a b] (+ a b)) xs ys))"
                      "(vector-at (f [3 4] [10 20]) 1)")))))

(deftest a-closure-value-maps
  (testing "a parameter, handed a closure literal"
    (is (= 8 (answer "(defn f [g xs] (map g xs))"
                     "(vector-at (f (fn [x] (* x 2)) [3 4]) 1)"))))
  (testing "a parameter, handed (fn-ref named)"
    (is (= 8 (answer "(defn dbl [x] (* x 2))(defn f [g xs] (map g xs))"
                     "(vector-at (f (fn-ref dbl) [3 4]) 1)"))))
  (testing "a let-bound closure"
    (is (= 8 (answer "(defn f [xs] (let [g (fn [x] (* x 2))] (map g xs)))"
                     "(vector-at (f [3 4]) 1)")))))

(deftest a-parameter-mapper-requests-its-dispatcher
  ;; Before 2026-09-11 this module -- no lambda of arity 1 anywhere in it --
  ;; was refused `unknown operation: __kotoba_invoke$arity1 is not a builtin`
  ;; at the map site, while `(defn f [g x] (g x))` in the same module
  ;; compiled. The dispatcher is now REQUESTED by the map site, as it is by
  ;; a lexical call, so the module analyses alone and carries it.
  (let [names (function-names "(ns m.lib (:export [f]))(defn f [g xs] (map g xs))")]
    (is (contains? names 'f))
    (is (contains? names '__kotoba_invoke$arity1)))
  (testing "and a bare function name as a VALUE is still refused at the caller, by the fn-ref rule"
    (let [{:keys [message form]} (refusal "(defn dbl [x] (* x 2))(defn f [g xs] (map g xs))"
                                          "(vector-at (f dbl [3 4]) 1)")]
      (is (= 'dbl form))
      (is (= "unbound or dynamic symbol is forbidden: dbl is not a parameter, a let binding, or a function of this module"
             message)))))

;; ------------------------------------------------------------- CID control

(deftest an-already-admitted-inline-map-analyses-to-the-same-hir
  ;; The split touches only refusals and the stored-callback request. An
  ;; inline callback takes neither path, so its analysis -- the input amu's
  ;; definition CID is computed from -- is the value it always was: pinned
  ;; as the helper's param-types, the shape map_source_type_test already
  ;; measured, and by running.
  (let [hir (sema/analyze (module "(defn f [xs] (map (fn [x] (* x 2)) xs))" "(vector-at (f [3 4]) 1)"))
        helper (first (filter :loop-helper? (:functions hir)))]
    (is (= [:i64 :vector-i64 :vector-i64] (:param-types helper)))
    (is (= 8 (answer "(defn f [xs] (map (fn [x] (* x 2)) xs))" "(vector-at (f [3 4]) 1)")))))

;; ----------------------------------------------------------------- refusals

(deftest destructuring-is-refused-by-what-it-would-need
  (let [{:keys [message form]} (refusal "(defn f [xs] (map (fn [[a b]] (+ a b)) xs))"
                                        "(vector-at (f [1 2]) 0)")]
    (is (= '(fn [[a b]] (+ a b)) form))
    (is (= "map fn parameter destructures ([a b]): the item of a vector-i64 source is an i64 and has no positions to bind; take a symbol and index a typed value inside the body"
           message)))
  (testing "a map pattern, the same reason"
    (let [{:keys [message]} (refusal "(defn f [xs] (map (fn [{:keys [a]}] a) xs))"
                                     "(vector-at (f [1 2]) 0)")]
      (is (= "map fn parameter destructures ({:keys [a]}): the item of a vector-i64 source is an i64 and has no positions to bind; take a symbol and index a typed value inside the body"
             message)))))

(deftest several-body-forms-are-sequenced-as-defn-sequences-them
  ;; Until 2026-09-12: `map fn must contain one result expression; explicit
  ;; (do ...) is the spelling`. Now one `do`, the LAST form the value.
  (is (nil? (refusal "(defn f [xs] (map (fn [x] (+ x 0) (* x 2)) xs))"
                     "(vector-at (f [3 4]) 1)")))
  (is (= 8 (answer "(defn f [xs] (map (fn [x] (+ x 0) (* x 2)) xs))"
                   "(vector-at (f [3 4]) 1)"))))

(deftest the-kept-checks-each-say-why
  (testing "arity: the callback's parameter count IS the source count"
    (is (= "2-source map fn requires 2 parameters; got 1"
           (:message (refusal "(defn f [xs ys] (map (fn [a] a) xs ys))" "(vector-at (f [3 4] [1 2]) 1)"))))
    (is (= "1-source map fn requires 1 parameter; got 2"
           (:message (refusal "(defn f [xs] (map (fn [a b] a) xs))" "(vector-at (f [3 4]) 1)")))))
  (testing "duplicate parameters"
    (is (= "map fn parameters must be unique"
           (:message (refusal "(defn f [xs ys] (map (fn [a a] (+ a a)) xs ys))" "(vector-at (f [3 4] [1 2]) 1)")))))
  (testing "empty body"
    (is (= "map fn requires a body expression"
           (:message (refusal "(defn f [xs] (map (fn [x]) xs))" "(vector-at (f [3 4]) 1)")))))
  (testing "a multi-arity fn is not a map callback"
    (is (= "map fn requires a parameter vector; a multi-arity (fn ([x] ...) ...) is not a map callback"
           (:message (refusal "(defn f [xs] (map (fn ([x] x) ([x y] x)) xs))" "(vector-at (f [3 4]) 1)"))))))

(deftest a-literal-callback-is-refused-by-its-kind
  (let [{:keys [message form]} (refusal "(defn f [xs] (map :a xs))" "(vector-at (f [1 2]) 0)")]
    (is (= :a form))
    (is (= "map callback must be a named function, an inline fn, or a closure value; got a keyword literal -- a map source is a vector-i64 and its item is an i64, so no keyword or literal can map it"
           message)))
  (is (= "map callback must be a named function, an inline fn, or a closure value; got a integer literal -- a map source is a vector-i64 and its item is an i64, so no keyword or literal can map it"
         (:message (refusal "(defn f [xs] (map 3 xs))" "(vector-at (f [1 2]) 0)"))))
  (is (= "map callback must be a named function, an inline fn, or a closure value; got a string literal -- a map source is a vector-i64 and its item is an i64, so no keyword or literal can map it"
         (:message (refusal "(defn f [xs] (map \"a\" xs))" "(vector-at (f [1 2]) 0)")))))

(deftest partial-and-comp-are-refused-as-not-heads
  (is (= "map callback (partial ...) is not admitted: partial is not a head of this language; write the callback as (fn [x] ...)"
         (:message (refusal "(defn mul [a b] (* a b))(defn f [xs] (map (partial mul 2) xs))" "(vector-at (f [3 4]) 1)"))))
  (is (= "map callback (comp ...) is not admitted: comp is not a head of this language; write the callback as (fn [x] ...)"
         (:message (refusal "(defn f [xs] (map (comp inc inc) xs))" "(vector-at (f [3 4]) 1)"))))
  (testing "unless this module defines the name -- then it is an ordinary call, refused or admitted on its own terms"
    (let [{:keys [message]} (refusal "(defn partial [a b] (+ a b))(defn f [xs] (map (partial 1 2) xs))" "(vector-at (f [3 4]) 1)")]
      (is (not= "map callback (partial ...) is not admitted: partial is not a head of this language; write the callback as (fn [x] ...)"
                message)))))
