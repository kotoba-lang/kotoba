(ns kotoba.compiler.definition-admission-test
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.compiler.frontend :as frontend]
            [kotoba.lang.text :as str]))

(defn- many-bounded-definitions []
  (str/join
   "\n"
   (map (fn [index]
          (str "(defn f" index " [] :i64 \""
               (apply str (repeat 1800 "x"))
               "\" 0)"))
        (range 600))))

(deftest admission-is-per-definition
  (testing "a source larger than 1 MiB is admitted when each definition is bounded"
    (let [source (many-bounded-definitions)
          forms (frontend/read-forms source)]
      (is (> (count source) frontend/max-definition-source-bytes))
      (is (= 600 (count forms)))))
  (testing "one oversized definition is still refused"
    (let [source (str "(def huge \""
                      (apply str (repeat frontend/max-definition-source-bytes "x"))
                      "\")")]
      (is (thrown-with-msg?
           #?(:clj clojure.lang.ExceptionInfo :cljs js/Error)
           #"top-level definition exceeds admission limit"
           (frontend/read-forms source))))))

(deftest aggregate-input-remains-bounded
  (let [source (apply str (repeat (inc frontend/max-source-bytes) ";"))]
    (is (thrown-with-msg?
         #?(:clj clojure.lang.ExceptionInfo :cljs js/Error)
         #"source exceeds aggregate admission limit"
         (frontend/read-forms source)))))
