(ns kotoba.compiler.library-heads-test
  "The selfhost builtin gaps (2026-09-25, superproject adr-2609242330;
  kotoba-lang guest-grammar `:library-heads`, `:sugar` `:string-equality` /
  `:true?` / `:integer?`, lang/abort-ability.edn `:loop-body`). Each widening
  in both directions: what now runs, with its value, and what is still
  refused, with the reason literal pinned."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn- run
  ([source] (run source 'main []))
  ([source f args] (kir/execute (kir/lower (sema/analyze source)) f args {})))
(defn- refusal [source]
  (try (do (sema/analyze source) nil)
       (catch #?(:clj Throwable :cljs :default) e (ex-message e))))
(defn- trap [source f args]
  (try (run source f args) nil
       (catch #?(:clj Throwable :cljs :default) e (:trap (ex-data e)))))
(defn- w [x] #?(:clj x :cljs (js/Number x)))
(defn- i [x] #?(:clj x :cljs (js/BigInt x)))

(deftest equality-on-two-strings-is-string=?
  (is (= 11 (w (run "(defn main [] :i64 0) (defn f [n :i64] :i64 (let [a (string-from-i64 n)] (+ (if (= a \"12\") 1 0) (if (not= a \"x\") 10 0))))"
                    'f [(i 12)]))))
  (is (= 10 (w (run "(defn main [] :i64 0) (defn f [n :i64] :i64 (let [a (string-from-i64 n)] (+ (if (= a \"12\") 1 0) (if (not= a \"x\") 10 0))))"
                    'f [(i 13)]))))
  (testing "a string beside another type is still the same-type refusal"
    (is (= "equality operands must have the same value type"
           (refusal "(defn main [] :i64 (if (= \"a\" 1) 1 0))")))))

(deftest true?-and-integer?-are-decided-by-the-static-type
  (is (= 10101 (w (run "(defn main [] :i64 (+ (if (true? (= 1 1)) 1 0) (if (true? 5) 10 0) (if (integer? 5) 100 0) (if (integer? \"x\") 1000 0) (if (integer? (string-byte-length \"ab\")) 10000 0)))"))))
  (testing "on a :document they ask the node's kind (gap 3, 2026-09-26; refused by name until then)"
    (is (= 1 (w (run "(defn main [] :i64 (if (true? (document-bool true)) 1 0))"))))
    (is (= 1 (w (run "(defn main [] :i64 (if (integer? (document-i64 1)) 1 0))"))))))

(def ^:private kind-probe
  "Fifteen predicates as the bits of one i64, so one run reads every answer."
  (str "(defn- k [d :document] :i64 (+ (if (map? d) 1 0) (if (vector? d) 2 0) "
       "(if (keyword? d) 4 0) (if (string? d) 8 0) (if (integer? d) 16 0) "
       "(if (true? d) 32 0) (if (false? d) 64 0) (if (nil? d) 128 0) "
       "(if (coll? d) 256 0) (if (some? d) 512 0) (if (set? d) 1024 0) "
       "(if (seq? d) 2048 0) (if (symbol? d) 4096 0) (if (boolean? d) 8192 0) "
       "(if (list? d) 16384 0)))\n"))

(defn- kinds [document]
  (w (run (str kind-probe "(defn main [] :i64 (k " document "))"))))

(deftest type-predicates-on-a-document-ask-its-kind
  (testing "admitted: every predicate reads the node's run-time kind"
    (is (= (+ 128) (kinds "(document-null)")))
    (is (= (+ 32 512 8192) (kinds "(document-bool true)")))
    (is (= (+ 64 512 8192) (kinds "(document-bool false)")))
    (is (= (+ 16 512) (kinds "(document-i64 7)")))
    (is (= (+ 8 512) (kinds "(document-string \"s\")")))
    (is (= (+ 4 512) (kinds "(document-keyword :x)")))
    (is (= (+ 2 256 512) (kinds "(document-vector (document-i64 1))")))
    (is (= (+ 256 512 2048 16384) (kinds "(document-list (document-i64 1))")))
    (is (= (+ 256 512 1024) (kinds "(document-set (document-i64 1))")))
    (is (= (+ 1 256 512) (kinds "(document-map :a (document-i64 1))"))))
  (testing "admitted: on a static type the answer is the type's, the operand still runs"
    (is (= 1111 (w (run (str "(defn main [] :i64 (+ (if (string? \"x\") 1 0) (if (keyword? :a) 10 0) "
                             "(if (vector? (vector-i64 1 2)) 100 0) (if (false? (= 1 2)) 1000 0) "
                             "(if (map? \"x\") 10000 0) (if (coll? 5) 100000 0)))"))))))
  (testing "admitted: on [:option T] a predicate T answers true for is presence"
    (is (= 1 (w (run (str "(defn main [] :i64 (let [o (option-some-of [:option :string] \"s\") "
                          "n (option-none-of [:option :string])] (+ (if (string? o) 1 0) "
                          "(if (string? n) 10 0) (if (integer? o) 100 0))))"))))))
  (testing "refused: an option whose payload's answer depends on the value"
    (is (= "true? on [:option :bool] depends on the value, not the type: bind the payload first (when-let / if-let) and ask the payload"
           (refusal "(defn main [] :i64 (if (true? (option-some-of [:option :bool] true)) 1 0))")))
    (is (= "map? on [:option :document] depends on the value, not the type: bind the payload first (when-let / if-let) and ask the payload"
           (refusal "(defn main [] :i64 (if (map? (option-none-of [:option :document])) 1 0))"))))
  (testing "refused: nil? / some? ask absence, and a string has none"
    (is (= "expression type mismatch: expected option-i64, got string"
           (refusal "(defn main [] :i64 (if (nil? \"s\") 1 0))")))))

(deftest subvec-is-drop-then-copy-and-traps-out-of-range
  (let [src "(defn main [] :i64 0) (defn f [n :i64] :i64 (let [v (subvec (vector-i64 10 20 30 40 50) 1 n)] (+ (* 1000 (vector-count v)) (vector-at v 0))))
             (defn from [n :i64] :i64 (vector-count (subvec (vector-i64 10 20 30 40 50) n)))"]
    (is (= 2020 (w (run src 'f [(i 3)]))))
    (is (= 2 (w (run src 'from [(i 3)]))))
    (is (= :vector-drop-out-of-range (trap src 'f [(i 6)])) "end past count")
    (is (= :vector-drop-out-of-range (trap src 'f [(i 0)])) "end before start")
    (is (= :vector-drop-out-of-range (trap src 'from [(i -1)])) "negative start"))
  (is (= "expression type mismatch: expected vector-i64, got vector-f64"
         (refusal "(defn main [] :i64 (vector-f64-count (subvec (vector-f64 1.5 2.5) 0 1)))"))))

(deftest a-loop-exit-written-conj-is-the-vector-type
  (is (= 4 (w (run "(defn main [] :i64 (vector-count (loop [i 0 v (vector-i64)] (if (< i 3) (recur (+ i 1) (conj v i)) (conj v -1)))))")))))

(deftest string-to-utf8-encodes-every-width
  (is (= 10 (w (run "(defn main [] :i64 (bytes-count (string-to-utf8 \"aé€😀\")))"))))
  (is (= 195128 (w (run "(defn main [] :i64 (let [b (string-to-utf8 \"aé€😀\")] (+ (* 1000 (bytes-at b 1)) (bytes-at b 9))))"))))
  (is (= "aé€😀" (run "(defn main [] :string (string-from-utf8 (string-to-utf8 \"aé€😀\")))")) "round trip")
  (is (= 0 (w (run "(defn main [] :i64 (bytes-count (string-to-utf8 \"\")))")))))

(def ^:private parse-src
  "(defn- show [r [:result :i64 :keyword]] :i64
     (if (result-ok?-of [:result :i64 :keyword] r)
       (result-value-of [:result :i64 :keyword] r 0)
       (if (= :parse/malformed (result-error-of [:result :i64 :keyword] r :x)) -1 -2)))
   (defn main [] :i64 0)
   (defn p [s :string] :i64 (show (string-parse-i64 s)))
   (defn l [s :string] :i64 (option-or (parse-long s) -7))")

(deftest string-parse-i64-names-malformed-and-out-of-range-apart
  (doseq [[text expected] [["42" 42] ["+17" 17] ["-0" 0] ["007" 7]
                           ["9223372036854775807" "9223372036854775807"]
                           ["-9223372036854775808" "-9223372036854775808"]
                           ["9223372036854775808" -2] ["-9223372036854775809" -2]
                           ["" -1] ["-" -1] ["+" -1] [" 1" -1] ["1 " -1] ["1a" -1] ["1_0" -1]
                           ["١٢" -1] ["99999999999999999999x" -1]]]
    (is (= (str expected) (str (run parse-src 'p [text]))) text))
  (is (= "123" (str (run parse-src 'l ["123"]))))
  (is (= "-7" (str (run parse-src 'l ["x"]))))
  (is (= "-7" (str (run parse-src 'l ["9223372036854775808"])))))

(deftest ex-info-builds-a-document-from-a-map-literal-with-locals
  (let [src "(defn- f [n :i64] :i64 (if (> n 3) (throw (ex-info \"too big\" {:phase :decode :limit n :path \"p\"})) n))
             (defn- lim [e :document] :i64 (option-or (document-i64-value (option-or (document-get (ex-data e) (document-keyword :limit)) (document-null))) -1))
             (defn main [] :i64 0)
             (defn msg [n :i64] :i64 (try (f n) (catch e (string-byte-length (ex-message e)))))
             (defn limit [n :i64] :i64 (try (f n) (catch e (lim e))))"]
    (is (= 2 (w (run src 'msg [(i 2)]))))
    (is (= 7 (w (run src 'msg [(i 5)]))))
    (is (= 9 (w (run src 'limit [(i 9)])))))
  (is (= "ex-info takes a message and a data document; the cause arity has no Throwable to name"
         (refusal "(defn main [] :i64 (throw (ex-info \"m\" {:a 1} \"cause\")))")))
  (is (= "ex-info data map keys must be keywords"
         (refusal "(defn main [] :i64 (throw (ex-info \"m\" {\"a\" 1})))"))))

(deftest throw-inside-a-loop-body-is-admitted-and-a-fn-literal-is-not
  (is (= 105 (w (run "(defn main [] :i64 (try (loop [i 0] (if (= i 3) (throw \"three\") (recur (+ i 1)))) (catch e (+ 100 (string-length e)))))"))))
  (is (= "throw inside a fn literal is not admitted in abort slice 1: precondition :checked-lexical-facet-unwind is not met"
         (refusal "(defn main [] :i64 (try (let [g (fn [x] (throw x))] (g 1)) (catch e 0)))"))))

(deftest a-module-that-defines-the-name-keeps-its-own
  (is (= 99 (w (run "(defn- parse-long [s :string] :i64 99) (defn main [] :i64 (parse-long \"1\"))")))))

(deftest a-module-without-the-heads-is-analyzed-as-before
  (let [src "(defn f [x :i64] :i64 (+ x 1)) (defn main [] :i64 (f 2))"]
    (is (= (sema/analyze src) (sema/analyze src)))
    (is (not (re-find #"__kotoba_intrinsic_" (pr-str (sema/analyze src)))))))

(deftest the-helpers-do-not-narrow-the-implicit-export-set
  (let [hir (sema/analyze "(defn g [s :string] :i64 (option-or (parse-long s) 0)) (defn main [] :i64 (g \"4\"))")]
    (is (= '[g main] (vec (sort (:exports hir)))))))

(deftest an-abort-before-recur-is-refused-by-name
  (is (= "a throw or a call to an aborting function before recur on the same path is not admitted: its result match would take the recur out of tail position; abort only on a path that exits the loop, or move the call out of the loop"
         (refusal "(defn- f [x :i64] :i64 (if (= x 3) (throw x) x))
                   (defn main [] :i64 (try (loop [i 1 acc 0] (if (= i 5) acc (recur (+ i 1) (+ acc (f i))))) (catch e (+ 1000 e))))")))
  (is (= 1003 (w (run "(defn- f [x :i64] :i64 (if (= x 3) (throw x) x))
                       (defn main [] :i64 (try (loop [i 1] (if (= i 3) (f i) (recur (+ i 1)))) (catch e (+ 1000 e))))")))
      "the same call on the path that exits the loop runs"))

(deftest the-facet-unwind-guard-fires-on-this-runtime-too
  ;; Until 2026-09-25 a row's BigInt wire id never matched the registry's
  ;; Number under ClojureScript, so this was ADMITTED on nbb.
  (is (= "throw in function f whose effect row has a dataspace facet operation #{:dataspace/transact} is not admitted in abort slice 1: precondition :checked-lexical-facet-unwind is not met"
         (refusal "(ns t (:capabilities #{:dataspace/transact}) (:export [main]))
                   (defn- f [] :i64 (do (facet-leave! 0) (throw \"s\")))
                   (defn main [] :i64 (try (f) (catch e 0)))")))
  (is (= "abort in function f whose effect row has a dataspace facet operation #{:dataspace/transact} is not admitted in abort slice 1: precondition :checked-lexical-facet-unwind is not met"
         (refusal "(ns t (:capabilities #{:dataspace/transact}) (:export [main]))
                   (defn- f [] :i64 (do (facet-leave! 0) (loop [i 0] (if (= i 3) (throw \"s\") (recur (+ i 1))))))
                   (defn main [] :i64 (try (f) (catch e 0)))"))
      "a throw in a loop body reaches the facet check through the function it aborts"))
