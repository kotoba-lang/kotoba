(ns kotoba.compiler.keyword-lookup-on-maps-test
  "`(:k m)` and `(:k m default)` are Clojure's `(get m :k)` and
  `(get m :k default)`. Before 2026-09-25 the frontend desugared the keyword
  accessor straight to the record projection, so on the two map types --
  the bounded keyword->i64 map a keyword map literal with only i64 values
  lowers to, and the canonical typed map -- `(get m :k)` compiled and
  `(:k m)` was refused with `record-get without a type descriptor requires a
  record value; got :map`, and the three-argument accessor was refused as a
  computed call. Measured with kotoba-lang/browser's reducers (aiueos
  desktop floor :browser-component, wall 3).

  Pinned here: both arities RUN to a value on the KIR interpreter on both map
  types, each equals the `get` spelling of the same lookup, the record
  projection is unchanged, and the refusals keep their reasons (a non-map receiver). Since 2026-09-26 (d609c60, ADR 0353 floor
  :literal-typing) a record with a default answers statically: a present
  field answers the field (the default is never evaluated: a literal or
  a local only), an absent field answers the default. Pinned here too."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn- run [body]
  (kir/execute (kir/lower (sema/analyze (str "(ns m.probe)\n(defn main [] " body ")\n")))
               'main [] {}))

(defn- i64 [body] (let [v (run body)] #?(:clj v :cljs (js/Number v))))

(defn- refusal [body]
  (try (do (sema/analyze (str "(ns m.probe)\n(defn main [] " body ")\n")) nil)
       (catch #?(:clj Throwable :cljs :default) e
         {:message (ex-message e) :code (:kotoba.error/code (ex-data e))})))

(deftest keyword-lookup-on-the-bounded-map
  (testing "a keyword map literal with only i64 values is the bounded map"
    (is (= 10 (i64 "(:window/x {:window/id 1 :window/x 10})")))
    (is (= 1 (i64 "(:window/id {:window/id 1 :window/x 10})"))))
  (testing "an absent key answers get's default, 0 for two arguments"
    (is (= 0 (i64 "(:window/y {:window/id 1 :window/x 10})")))
    (is (= 7 (i64 "(:window/y {:window/id 1 :window/x 10} 7)")))
    (is (= 10 (i64 "(:window/x {:window/id 1 :window/x 10} 7)"))))
  (testing "each arity means what the get spelling means"
    (is (= (i64 "(get {:a 3 :b 4} :b)") (i64 "(:b {:a 3 :b 4})")))
    (is (= (i64 "(get {:a 3 :b 4} :c 9)") (i64 "(:c {:a 3 :b 4} 9)"))))
  (testing "through a let binding, not only on a literal"
    (is (= 14 (i64 "(let [m {:a 4 :b 10}] (+ (:a m) (:b m)))")))))

(deftest keyword-lookup-on-a-typed-map
  (testing "the default arity reads through option-value-of, like get"
    (is (= 20 (i64 "(:b (typed-map-new [:map :keyword :i64] :a 10 :b 20) 0)")))
    (is (= 5 (i64 "(:z (typed-map-new [:map :keyword :i64] :a 10 :b 20) 5)"))))
  (testing "the one-argument arity answers an option, like get"
    (is (= 10 (i64 "(option-or (:a (typed-map-new [:map :keyword :i64] :a 10)) 0)")))
    (is (= 3 (i64 "(option-or (:q (typed-map-new [:map :keyword :i64] :a 10)) 3)")))))

(deftest record-projection-is-unchanged
  (is (= 10 (i64 "(:x {:x 10 :name \"w1\"})")))
  (testing "a record with a default answers statically (ADR 0353 floor :literal-typing, d609c60)"
    (is (= 10 (i64 "(:x {:x 10 :name \"w1\"} 0)")))
    (is (= 10 (i64 "(get {:x 10 :name \"w1\"} :x 0)")))
    (is (= 3 (i64 "(:z {:x 10 :name \"w1\"} 3)"))))
  (testing "the default of a present field is never evaluated: a literal or a local only"
    (let [r (refusal "(:x {:x 10 :name \"w1\"} (+ 1 2))")]
      (is (re-find #"^the default of :x on record \S+ is never evaluated, because the record has that field: write the default as a literal or a local$" (:message r)))
      (is (= :kotoba.error/record-projection-unresolved (:code r)))))
  (testing "the default must be the field's type -- no coercion"
    (let [r (refusal "(:name {:x 10 :name \"w1\"} :a)")]
      (is (= "expression type mismatch: expected string, got keyword" (:message r)))
      (is (= :kotoba.error/subset-reject (:code r)))))
  (testing "a non-map receiver is still refused with the projection's reason"
    (let [r (refusal "(:x 5)")]
      (is (re-find #"^record-get without a type descriptor requires a record value; got :i64" (str (:message r))))
      (is (= :kotoba.error/record-projection-unresolved (:code r))))))
