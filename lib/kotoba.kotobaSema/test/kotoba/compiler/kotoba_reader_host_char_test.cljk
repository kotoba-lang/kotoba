(ns kotoba.compiler.kotoba-reader-host-char-test
  "The reader on BOTH hosts sees whitespace, delimiters, comments and string
  escapes. Loadable on the JVM (unlike kotoba-reader-test, whose `(catch
  :default ..)` is ClojureScript-only), so a JVM run can pin what broke there.

  44f162c spelled the reader's character literals as one-character strings
  while it still took characters with `nth` -- a String on ClojureScript, a
  java.lang.Character on the JVM. On the JVM nothing compared equal to \" \"
  or \"(\", and `read-forms` returned the whole source as ONE symbol
  (measured 2026-09-25 through kotoba-lang's JVM suite: 175 failures and
  1,125 errors, `only ns, def, defn, and defn- are allowed at top level`)."
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.compiler.kotoba-reader :as r]))

(deftest whitespace-and-delimiters-separate-forms
  (let [forms (r/read-forms "(defn a [] x)\n;; c\n(def b \"x\\ny\")")]
    (is (= 2 (count forms)))
    (is (= '(defn a [] x) (first forms)))
    (is (= "x\ny" (nth (second forms) 2)))))

(deftest a-unicode-escape-in-a-string-reads-as-one-character
  (is (= "A" (first (r/read-forms "\"\\u0041\"")))))
