(ns kotoba.compiler.document-bytes-link-test
  "The :bytes and :link document kinds, typed and RUN (root ADR-2610092310 S2).

  document-bytes : [:bytes] -> :document
  document-bytes-value : [:document] -> [:option :bytes]
  document-link : [:bytes] -> [:option :document] -- none unless the bytes are
                  one binary CIDv1 (the rule is osaho's, osaho#105)
  document-link-value : [:document] -> [:option :bytes]

  Each is run to a value on the KIR interpreter this repository pins, and each
  wrong argument type is refused by name. The digest pinned below was taken
  outside Kotoba (Python hashlib over x3:<00 ff 10>, 2026-10-09), the same
  value osaho's kir_document_bytes_link_test pins."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.lang.text :as str]
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn- module [result body]
  (str "(ns m.probe)\n(defn main [] " result " " body ")\n"))

(defn- answer [result body]
  (kir/execute (kir/lower (sema/analyze (module result body))) 'main [] {}))

(defn- n [v] #?(:clj (long v) :cljs (js/Number v)))

(defn- refusal [result body]
  (try (do (sema/analyze (module result body)) nil)
       (catch #?(:clj Throwable :cljs :default) e (ex-message e))))

(def ^:private three-bytes "(bytes-from-vector-i64 (vector-i64 0 255 16))")

;; bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku in binary
(def ^:private cid-bytes
  (str "(bytes-from-vector-i64 (vector-i64 1 85 18 32 227 176 196 66 152 252 28 20 154 251"
       " 244 200 153 111 185 36 39 174 65 228 100 155 147 76 164 149 153 27 120 82 184 85))"))

(defn- link-of [bytes]
  (str "(option-value-of [:option :document] (document-link " bytes ") (document-null))"))

(deftest bytes-round-trip-through-a-document
  (is (= 3 (n (answer ":i64" (str "(bytes-count (option-value-of [:option :bytes]"
                                  " (document-bytes-value (document-bytes " three-bytes "))"
                                  " (bytes-empty)))")))))
  (is (= :bytes (answer ":keyword" (str "(document-kind (document-bytes " three-bytes "))"))))
  (is (= "9a20ad21716d8ac7de1ab4e20a18e918538e89e094cb7561fb0abdab0f36a2b8"
         (answer ":string" (str "(document-sha256 (document-bytes " three-bytes "))")))))

(deftest a-link-is-made-only-from-a-binary-cidv1
  (is (= :link (answer ":keyword" (str "(document-kind " (link-of cid-bytes) ")"))))
  (is (= 36 (n (answer ":i64" (str "(bytes-count (option-value-of [:option :bytes]"
                                   " (document-link-value " (link-of cid-bytes) ") (bytes-empty)))")))))
  (testing "bytes that are not a CIDv1 make no link"
    (is (= :null (answer ":keyword" (str "(document-kind " (link-of three-bytes) ")")))))
  (testing "a reader of the other kind answers none"
    (is (= 0 (n (answer ":i64" (str "(bytes-count (option-value-of [:option :bytes]"
                                    " (document-link-value (document-bytes " three-bytes "))"
                                    " (bytes-empty)))")))))))

(deftest wrong-argument-types-are-refused
  (doseq [[result body] [[":document" "(document-bytes \"not bytes\")"]
                         [":document" "(option-value-of [:option :document] (document-link 7) (document-null))"]
                         [":i64" "(bytes-count (option-value-of [:option :bytes] (document-bytes-value 7) (bytes-empty)))"]
                         [":i64" "(bytes-count (option-value-of [:option :bytes] (document-link-value \"x\") (bytes-empty)))"]]]
    (let [why (refusal result body)]
      (is (and (string? why) (str/includes? why "expression type mismatch")) (str body " -> " (pr-str why))))))

(deftest declared-results-are-exact
  (is (some? (refusal ":document" (str "(document-link " cid-bytes ")")))
      "document-link answers [:option :document], not :document")
  (is (some? (refusal ":bytes" (str "(document-bytes-value (document-bytes " three-bytes "))")))
      "document-bytes-value answers [:option :bytes], not :bytes"))
