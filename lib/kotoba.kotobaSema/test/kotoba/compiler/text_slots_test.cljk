(ns kotoba.compiler.text-slots-test
  "The ABI v7 text heads at the frontend: typed, arity-checked, and executed
  through the reference interpreter."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn- run [source] (kir/execute (kir/lower (sema/analyze source)) 'main [] {}))
(defn- refusal [source]
  (try (do (sema/analyze source) nil)
       (catch #?(:clj Throwable :cljs :default) e {:message (ex-message e)})))
(defn- w [x] #?(:clj x :cljs (js/Number x)))

(deftest the-four-heads-type-and-run
  (is (= -1 (w (run "(defn main [] :i64 (string-compare \"a\" \"b\"))"))))
  (is (= "abc" (run "(defn main [] :string (string-fold-ascii \"AbC\"))")))
  (is (= 1 (w (run "(defn main [] :i64 (string-find-blank \"a b\" 0))"))))
  (is (= 2 (w (run "(defn main [] :i64 (string-skip-blank \"  a\" 0))")))))

(deftest operand-types-are-required
  (is (re-find #"string" (:message (refusal "(defn main [] :i64 (string-compare 1 \"b\"))"))))
  (is (re-find #"i64" (:message (refusal "(defn main [] :i64 (string-find-blank \"a\" \"0\"))")))))

(deftest arities-are-checked-by-name
  (is (= "string operation arity mismatch: string-compare takes 2 arguments; got 1"
         (:message (refusal "(defn main [] :i64 (string-compare \"a\"))"))))
  (is (= "string operation arity mismatch: string-fold-ascii takes 1 argument; got 2"
         (:message (refusal "(defn main [] :string (string-fold-ascii \"a\" \"b\"))")))))
