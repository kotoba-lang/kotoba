(ns kotoba.compiler.empty-library-test
  (:require #?(:clj [kotoba.test :refer [deftest is]]
               :cljs [cljs.test :refer [deftest is]])
            [kotoba.sema :as sema]))
(defn refusal [source]
  (try (sema/analyze source) nil
       (catch #?(:clj Exception :cljs :default) e (ex-message e))))
(deftest explicit-empty-library-is-an-entryless-empty-hir
  (let [hir (sema/analyze "(ns empty.library (:export []))")]
    (is (= 'empty.library (:namespace hir)))
    (is (nil? (:entry hir)))
    (is (nil? (:result hir)))
    (is (= [] (:exports hir)))
    (is (= [] (:functions hir)))
    (is (= #{} (:effects hir)))))
(deftest explicit-empty-exports-can-keep-private-functions
  (let [hir (sema/analyze "(ns private.library (:export [])) (defn- hidden [] :i64 7)")]
    (is (nil? (:entry hir)))
    (is (= [] (:exports hir)))
    (is (= 1 (count (:functions hir))))))
(deftest invalid-empty-and-export-boundaries-still-refuse
  (doseq [source ["" "(ns empty.library)" "(ns empty.library (:export [missing]))"
                  "(ns empty.library (:export [])) (defn main [] 0)"
                  "(ns empty.library (:export [])) (ambient-side-effect)"]]
    (is (some? (refusal source)) source)))
