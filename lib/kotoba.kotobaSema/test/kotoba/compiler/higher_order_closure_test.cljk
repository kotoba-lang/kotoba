(ns kotoba.compiler.higher-order-closure-test
  (:require #?(:clj [kotoba.test :refer [deftest is]]
               :cljs [cljs.test :refer [deftest is]])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]
            [kotoba.compiler.js-value-type-test :refer [refusal refusal-code]]))

(def returned-source
  "(ns host.higher (:export [keep]))
   (defn factory [v :js-value] [:fn [[] [:fn [[] :js-value]]]] (fn [] (fn [] v)))
   (defn keep [v :js-value] :js-value (let [maker (factory v) f (maker)] (f)))")

#?(:cljs
   (deftest returned-callable-retains-opaque-capture-identity
     (let [k (kir/lower (sema/analyze returned-source))
           reads (atom 0)
           proxy (js/Proxy. #js {} #js {:get (fn [& _] (swap! reads inc) (throw (js/Error. "get")))
                                      :getPrototypeOf (fn [& _] (swap! reads inc) (throw (js/Error. "prototype")))})
           revoked (.revocable js/Proxy #js {} #js {})
           _ ((.-revoke revoked))
           values [nil js/undefined false true 0 (- 0.0) js/NaN (js/BigInt "0") "" (js/Symbol "x") #js {} #js [] proxy (.-proxy revoked)]]
       (doseq [v values] (is (js/Object.is v (kir/execute k 'keep [v] {}))))
       (is (= 0 @reads)))))

#?(:cljs
   (deftest callable-arguments-retain-logical-contracts-on-word-slots
     (let [source "(ns host.higher (:export [keep]))
                   (defn adapter [f [:fn [[[:fn [[:js-value] :js-value]] :js-value] :js-value]] g [:fn [[:js-value] :js-value]] v :js-value] :js-value (f g v))
                   (defn keep [v :js-value] :js-value (adapter (fn [g x] (g x)) (fn [x] x) v))"
           h (sema/analyze source)
           helper (some #(when (= '__kotoba_lambda_1_arity2 (:name %)) %) (:functions h))
           k (kir/lower h)]
       (is (= [:i64 :js-value] (:param-types helper)))
       (is (= {0 [:fn [[:js-value] :js-value]]} (:callable-param-contracts helper)))
       (doseq [v [js/undefined #js {}]] (is (js/Object.is v (kir/execute k 'keep [v] {})))))))

#?(:cljs
   (deftest explicit-invoke-selects-a-callable-result-family
     (let [source "(ns host.higher (:export [keep]))
                   (defn factory [v :js-value] [:fn [[] [:fn [[] :js-value]]]] (fn [] (fn [] v)))
                   (defn keep [v :js-value] :js-value (let [f (invoke [:fn [[] :js-value]] (factory v))] (f)))"
           k (kir/lower (sema/analyze source))]
       (doseq [v [js/undefined #js {}]] (is (js/Object.is v (kir/execute k 'keep [v] {})))))))

(deftest higher-order-contracts-do-not-admit-host-values-or-linear-resources
  (doseq [[source expected]
          [["(defn bad [v :js-value] [:fn [[] [:fn [[] :js-value]]]] (fn [] v))"
            [:kotoba.error/callable-result-type "fn result does not match the declared callable contract"]]
           ["(defn bad [v :js-value] [:fn [[[:fn [[] :js-value]]] :i64]] (fn [f] (v)))"
            [:kotoba.error/subset-reject "closure refinement requires an i64 parameter"]]
           ["(defn bad [f [:fn [[[:fn [[[:stream :bytes]] :i64]]] :i64]]] :i64 0)"
            [:kotoba.error/callable-parameter-type "callable parameter types cannot be linear resources"]]
           ["(defn bad [f [:fn [[] [:fn [[] [:stream :bytes]]]]]] :i64 0)"
            [:kotoba.error/callable-result-type "callable results cannot be linear resources"]]]]
    (let [source (str "(ns host.refused (:export [bad])) " source)]
      (is (= expected [(refusal-code source) (refusal source)])))))

(deftest identical-physical-word-types-do-not-erase-known-contracts
  (doseq [source ["(defn bad [g [:fn [[] :i64]]] [:fn [[] [:fn [[] :js-value]]]] (fn [] g))"
                  "(defn bad [h [:fn [[[:fn [[] :js-value]]] :js-value]] g [:fn [[] :i64]]] :js-value (h g))"]]
    (is (= :kotoba.error/callable-contract
           (refusal-code (str "(ns host.refused (:export [bad])) " source))))))

#?(:cljs
   (deftest a-lexical-callable-result-shadows-a-top-level-result-contract
     (let [source "(ns host.shadow (:export [keep]))
                   (defn f [] [:fn [[] :i64]] (fn [] 7))
                   (defn factory [v :js-value] [:fn [[] [:fn [[] :js-value]]]] (fn [] (fn [] v)))
                   (defn choose [f [:fn [[] [:fn [[] :js-value]]]]] [:fn [[] :js-value]] (f))
                   (defn keep [v :js-value] :js-value (let [leaf (choose (factory v))] (leaf)))"
           k (kir/lower (sema/analyze source))]
       (doseq [v [js/undefined #js {}]]
         (is (js/Object.is v (kir/execute k 'keep [v] {})))))))
