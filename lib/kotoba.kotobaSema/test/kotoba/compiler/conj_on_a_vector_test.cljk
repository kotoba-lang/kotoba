(ns kotoba.compiler.conj-on-a-vector-test
  "`conj` on a bounded vector appends at the END -- Clojure's vector `conj`.
  Before 2026-09-25 the frontend's `conj` arm knew only the typed set and
  refused `(conj (filterv p v) x)` with `conj requires a typed set
  [:set item-type]; got :vector-i64`, telling the author to spell
  `vector-conj` by hand. Measured with kotoba-lang/browser's reducers (aiueos
  desktop floor :browser-component, wall 4).

  Pinned: the END reading, discriminated (`(peek (conj [1 2] 3))` is 3, and
  `(first ...)` is still 1); variadic items fold left in order; i64 and f64
  vectors; through `cond->` and a computed receiver; single evaluation of the
  receiver; the lowering is exactly the vector primitive; and the refusals
  that remain keep their codes (disj on a vector, conj on an i64, an f64 item
  on an i64 vector)."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn- run [body]
  (kir/execute (kir/lower (sema/analyze (str "(ns m.probe)\n(defn main [] " body ")\n")))
               'main [] {}))

(defn- i64 [body] (let [v (run body)] #?(:clj v :cljs (js/Number v))))

(defn- refusal [body]
  (try (do (sema/analyze (str "(ns m.probe)\n(defn main [] " body ")\n")) nil)
       (catch #?(:clj Throwable :cljs :default) e
         {:message (ex-message e) :code (:kotoba.error/code (ex-data e))})))

(deftest conj-appends-at-the-end
  (is (= 3 (i64 "(count (conj [1 2] 3))")))
  (is (= 3 (i64 "(peek (conj [1 2] 3))")))
  (is (= 1 (i64 "(first (conj [1 2] 3))")))
  (testing "several items fold left, in order"
    (is (= 5 (i64 "(count (conj [1 2] 3 4 5))")))
    (is (= 5 (i64 "(peek (conj [1 2] 3 4 5))")))
    (is (= 3 (i64 "(nth (conj [1 2] 3 4 5) 2 0)"))))
  (testing "onto an empty vector and a computed receiver"
    (is (= 9 (i64 "(peek (conj [] 9))")))
    (is (= 2 (i64 "(count (conj (filterv (fn [x] (= x 1)) [1 2 3]) 4))")))
    (is (= 4 (i64 "(peek (conj (filterv (fn [x] (= x 1)) [1 2 3]) 4))"))))
  (testing "through cond->, the shape browser.input writes"
    (is (= 2 (i64 "(count (cond-> [1] true (conj 2)))")))
    (is (= 1 (i64 "(count (cond-> [1] false (conj 2)))")))))

(deftest conj-on-an-f64-vector
  (is (= 3 (i64 "(vector-f64-count (conj (vector-f64-new 1.5 2.5) 3.5))"))))

(deftest the-lowering-is-the-vector-primitive
  (let [text (pr-str (sema/analyze "(ns m.probe)\n(defn main [] (count (conj [1 2] 3)))\n"))]
    (is (re-find #"vector-conj" text))
    (is (not (re-find #"typed-set-conj" text)))))

(deftest the-remaining-refusals-keep-their-reasons
  (testing "disj has no vector meaning"
    (is (= :kotoba.error/set-disj-receiver (:code (refusal "(count (disj [1 2] 1))")))))
  (testing "an i64 receiver names no collection"
    (let [r (refusal "(conj 1 2)")]
      (is (= :kotoba.error/set-conj-receiver (:code r)))
      (is (re-find #"^conj requires a typed set \[:set item-type\] or a bounded :vector-i64 / :vector-f64; got :i64" (:message r)))))
  (testing "an item of the wrong element type is refused by the vector primitive"
    (is (some? (refusal "(count (conj [1 2] 3.5))")))))
