(ns kotoba.compiler.stored-closure-lowering-test
  "A `fn` literal stored as a map-literal value or a `record-new` field is
  lowered where it is written (amu ADR 0352 point 5, ADR 0353 floor
  `:stored-closures`).

  Both builders put their field values under `list*` as a lazy `map`, which
  ran the desugarer when the body was first walked -- after the `binding` that
  holds `*lambda-counter*` had ended -- so `(let [m {:f (fn [x] (+ x 1)) :n
  \"a\"}] ((:f m) 1))` was `internal compiler error` (`vswap!` on nil) instead
  of a program. `realized-lowering` realizes each defn and lambda body inside
  its own binding.

  Control: a `[:fn ...]` record field TAKES a fn literal -- since 1a8763b
  (amu ADR 0353 floor :function-values) a closure is a function, not an
  i64 word, and the checker lifts the literal under the field's contract.
  Anything in such a field that is not a closure is refused by name, not
  crashed."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.sema :as sema]))

(defn- outcome [source]
  (try (sema/analyze (str "(ns t)\n" source)) :admitted
       (catch #?(:clj Throwable :cljs :default) e
         {:message (ex-message e) :code (:kotoba.error/code (ex-data e))})))

(deftest a-stored-fn-literal-is-lowered-where-it-is-written
  (testing "map-literal value beside a string (the ADR 0352 reproduction)"
    (is (= :admitted
           (outcome "(defn main [] :i64 (let [m {:f (fn [x] (+ x 1)) :n \"a\"}] ((:f m) 1)))"))))
  (testing "a capturing fn in a record returned from a function"
    (is (= :admitted
           (outcome (str "(defn- mk [k] {:f (fn [x] (+ x k)) :n \"a\"})\n"
                         "(defn main [] :i64 ((:f (mk 10)) 1))")))))
  (testing "a fn literal where the field is declared [:fn ...] is lifted under that contract (1a8763b)"
    (is (= :admitted
           (outcome (str "(defn main [] :i64 ((:f (record-new [:record :t/h [[:f [:fn [[:i64] :i64]]]]]"
                         " (fn [x] (+ x 1)))) 1))")))))
  (testing "a non-closure in such a field is refused by name, not crashed"
    (is (= {:message "expression type mismatch: expected [:fn [[:i64] :i64]], got i64"
            :code :kotoba.error/subset-reject}
           (outcome (str "(defn main [] :i64 (:f (record-new [:record :t/h [[:f [:fn [[:i64] :i64]]]]]"
                         " 5)))"))))))
