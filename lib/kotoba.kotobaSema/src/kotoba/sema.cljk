(ns kotoba.sema
  "Stable public entry points for Kotoba source semantic analysis."
  {:kotoba/export [analyze analyze-forms capability-id->name capability-registry forbidden-heads kernel-operation-heads kernel-region-report lint lint-forms max-bindings max-expression-nodes max-function-docstring-chars max-functions max-list-items max-lowered-nodes max-namespace-capabilities max-namespace-docstring-chars namespace-attr-map->clauses namespace-attr-map-keys read-forms schema-identities source-operation-registry validate-schema-table!]}
  (:require [kotoba.compiler.frontend :as frontend]
            [kotoba.compiler.schema :as schema]
            #?@(:kotoba [[kotoba.form :as form]
                         [kotoba.compiler.frontend.namespace-defs :as namespace-defs]
                         [kotoba.compiler.frontend-tables :as tables]]
                :default [[kotoba.compiler.frontend.analyze :as fe-analyze]
                          [kotoba.compiler.frontend.expand :as fe-expand]
                          [kotoba.compiler.frontend.namespace-defs :as fe-namespace-defs]
                          [kotoba.compiler.frontend.validate :as fe-validate]]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                         :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]] [:phase :string] [:data [:ref :form/r]]]]
                         :fe/namespace-attr-clauses [:record :fe/namespace-attr-clauses [[:clauses [:list [:ref :form/r]]]]]
                         :kotoba.reader/out [:record :kotoba.reader/out [[:forms [:list [:ref :form/r]]] [:err :string] [:at :i64]]]
                         :ana/ir [:record :ana/ir [[:ok :bool] [:val [:ref :form/r]] [:err [:ref :fe/err]]]]})))

#?(:kotoba
(defn analyze [source :string opts [:ref :form/r]] [:ref :ana/ir]
  (frontend/analyze source opts))
   :default nil)

#?(:kotoba
(defn analyze-forms [source-forms [:ref :form/r] opts [:ref :form/r]] [:ref :ana/ir]
  (frontend/analyze-forms source-forms opts))
   :default nil)

#?(:kotoba
(defn lint [source :string opts [:ref :form/r]] [:ref :ana/ir]
  (frontend/lint source opts))
   :default nil)

#?(:kotoba
(defn lint-forms [source-forms [:ref :form/r] opts [:ref :form/r]] [:ref :ana/ir]
  (frontend/lint-forms source-forms opts))
   :default nil)

#?(:kotoba
(defn capability-registry [] [:ref :form/r]
  (frontend/capability-registry))
   :default nil)

#?(:kotoba
(defn max-functions [] :i64
  (frontend/max-functions))
   :default nil)

#?(:kotoba
(defn max-namespace-capabilities [] :i64
  (frontend/max-namespace-capabilities))
   :default nil)

#?(:kotoba
(defn max-namespace-docstring-chars [] :i64
  (frontend/max-namespace-docstring-chars))
   :default nil)

#?(:kotoba
(defn namespace-attr-map-clauses [attr-map [:ref :form/r]
                                  explicit-clauses [:list [:ref :form/r]]]
  [:ref :fe/namespace-attr-clauses]
  (frontend/namespace-attr-map-clauses attr-map explicit-clauses))
   :default nil)

#?(:kotoba
(defn read-error [message :string] [:ref :fe/err]
  (frontend/read-error message))
   :default nil)

#?(:kotoba
(defn read-forms-result [source :string] [:ref :kotoba.reader/out]
  (frontend/read-forms-result source))
   :default nil)

;; The remaining export surface gets its Kotoba-route twin here, delegating
;; exactly where the host `def`s below delegate: through `frontend` for the
;; twelve frontend-routed names, folding in place for `kernel-operation-heads`
;; (the host `def` below folds the three kernel tables HERE, so its twin does),
;; straight to `schema` for the two schema names. A constant is a no-arg defn
;; on this route (the max-* convention). `namespace-attr-map->clauses` takes
;; the typed route's TWO arguments: the host's third `reject-fn` is a refusal
;; callback, and on this route refusals throw (ADR 0007) -- see the frontend
;; twin's note.
#?(:kotoba
(defn capability-id->name [] [:ref :form/r]
  (frontend/capability-id->name))
   :default nil)

#?(:kotoba
(defn forbidden-heads [] [:ref :form/r]
  (frontend/forbidden-heads))
   :default nil)

;; The host `def` below folds the three kernel tables into one symbol set AT
;; THIS FACADE, so its twin folds the same three tables here: the key forms of
;; each table Form (`heads-kids`), as the set Form (`form/form-set`) every
;; other typed set answer on this route already is -- membership by scanning
;; the kids, duplicates across tables harmless.
#?(:kotoba
(defn kernel-operation-heads [] [:ref :form/r]
  (form/form-set
   (form/append-many
    (form/append-many (namespace-defs/heads-kids (tables/kernel-memory-operations))
                      (namespace-defs/heads-kids (tables/slice-value-operations)))
    (namespace-defs/heads-kids (tables/kernel-privileged-operations)))))
   :default nil)

#?(:kotoba
(defn kernel-region-report [functions [:list [:ref :form/r]]] [:ref :form/r]
  (frontend/kernel-region-report functions))
   :default nil)

#?(:kotoba
(defn max-bindings [] :i64
  (frontend/max-bindings))
   :default nil)

#?(:kotoba
(defn max-expression-nodes [] :i64
  (frontend/max-expression-nodes))
   :default nil)

#?(:kotoba
(defn max-function-docstring-chars [] :i64
  (frontend/max-function-docstring-chars))
   :default nil)

#?(:kotoba
(defn max-list-items [] :i64
  (frontend/max-list-items))
   :default nil)

#?(:kotoba
(defn max-lowered-nodes [] :i64
  (frontend/max-lowered-nodes))
   :default nil)

#?(:kotoba
(defn namespace-attr-map->clauses [attr-map [:ref :form/r]
                                   explicit-clauses [:list [:ref :form/r]]]
  [:list [:ref :form/r]]
  (frontend/namespace-attr-map->clauses attr-map explicit-clauses))
   :default nil)

#?(:kotoba
(defn namespace-attr-map-keys [] [:ref :form/r]
  (frontend/namespace-attr-map-keys))
   :default nil)

#?(:kotoba
(defn read-forms [source :string] [:ref :form/r]
  (frontend/read-forms source))
   :default nil)

#?(:kotoba
(defn source-operation-registry [] [:ref :form/r]
  (frontend/source-operation-registry))
   :default nil)

#?(:kotoba
(defn validate-schema-table! [table :document] :document
  (schema/validate-table! table))
   :default nil)

#?(:kotoba
(defn schema-identities [table :document] :document
  (schema/identities table))
   :default nil)


#?(:kotoba nil :default
(do

(def read-forms
  "Read Kotoba source using the admitted reader profile."
  frontend/read-forms)

(def validate-schema-table!
  "Validate a named schema table and return it."
  schema/validate-table!)

(def schema-identities
  "Return stable nominal content identities for a schema table."
  schema/identities)

(def capability-registry frontend/capability-registry)
(def source-operation-registry frontend/source-operation-registry)
(def capability-id->name frontend/capability-id->name)
(def forbidden-heads frontend/forbidden-heads)
(def max-functions frontend/max-functions)
(def max-expression-nodes frontend/max-expression-nodes)
(def max-lowered-nodes frontend/max-lowered-nodes)
(def max-bindings frontend/max-bindings)
(def max-list-items frontend/max-list-items)
(def max-namespace-capabilities frontend/max-namespace-capabilities)
(def max-namespace-docstring-chars frontend/max-namespace-docstring-chars)
(def max-function-docstring-chars frontend/max-function-docstring-chars)
(def kernel-region-report frontend/kernel-region-report)

(def namespace-attr-map-keys
  "The namespace header's attr-map spelling: key -> the clause head it stands
  for (`{:kotoba/export [...]}` is `(:export [...])`). Public because the
  amu project linker parses the same header and must admit the same keys;
  see `namespace-attr-map->clauses`."
  frontend/namespace-attr-map-keys)

(def namespace-attr-map->clauses
  "Rewrite a namespace ATTR-MAP into the clauses it stands for, refusing an
  unknown key by name and a key whose clause is also spelled explicitly
  (declared twice). `(namespace-attr-map->clauses attr-map explicit-clauses
  reject-fn)`; reject-fn takes (message data code). Values are NOT validated
  here -- the caller's clause loop is the one path that does."
  frontend/namespace-attr-map->clauses)

(def kernel-operation-heads
  "Every kernel head this frontend admits as a builtin: the byte-indexed and
  element-indexed memory operations, the CARRIED slice family, and the
  privileged machine operations. A set of symbols.

  Public because kotoba-lang's `lang/guest-grammar.edn` `:admitted-builtins`
  claims to name exactly these, four repositories carry a byte copy of that
  file, and a consumer therefore has to be able to CHECK the claim rather than
  restate it as a number. amu's `guest-grammar-vendor-test` compares the
  grammar it reads against this set across its `deps.edn` pin; before this
  existed it pinned the count as a literal, which went stale one authority
  edit later and reported staleness as drift.

  A set rather than the three tables, because the tables' arities are this
  repository's business and a consumer that read them would be depending on
  the implementation -- which is what `kotoba.compiler.namespace-reachability`
  refuses, correctly."
  (into #{}
        (mapcat keys)
        [frontend/kernel-memory-operations
         frontend/slice-value-operations
         frontend/kernel-privileged-operations]))

(defn- default-controls? []
  (= [max-functions max-expression-nodes max-lowered-nodes max-bindings
      max-list-items max-namespace-capabilities
      max-namespace-docstring-chars max-function-docstring-chars]
     [frontend/max-functions frontend/max-expression-nodes
      frontend/max-lowered-nodes frontend/max-bindings
      frontend/max-list-items frontend/max-namespace-capabilities
      frontend/max-namespace-docstring-chars
      frontend/max-function-docstring-chars]))

(defn- analyze-with-controls [source opts]
  (if (default-controls?)
    (frontend/analyze source opts)
    ;; Rebinding is only entered when a caller explicitly overrides the public
    ;; facade controls (principally bounded tests). Normal concurrent analysis
    ;; stays on the direct, mutation-free path above.
    (with-redefs [fe-namespace-defs/max-functions max-functions
                  fe-validate/max-expression-nodes max-expression-nodes
                  fe-analyze/max-lowered-nodes max-lowered-nodes
                  fe-validate/max-bindings max-bindings
                  fe-validate/max-list-items max-list-items
                  fe-namespace-defs/max-namespace-capabilities max-namespace-capabilities
                  fe-namespace-defs/max-namespace-docstring-chars max-namespace-docstring-chars
                  fe-expand/max-function-docstring-chars max-function-docstring-chars]
      (frontend/analyze source opts))))

(def lint
  "Analyze Kotoba source as `analyze` does, then return a vector of non-fatal
  findings -- `:code`, `:severity :warning`, `:message`, `:span` when known --
  empty when there is nothing to say. A refusal propagates unchanged. The
  first finding is `:kotoba.lint/zero-multiply-sequencing`: a call sequenced
  as `(* 0 (call))`, kept for its effect with its value dropped."
  frontend/lint)

(defn analyze
  "Analyze Kotoba source and return a validated HIR envelope. Public admission
  controls are authoritative when explicitly overridden."
  ([source] (analyze-with-controls source nil))
  ([source opts] (analyze-with-controls source opts)))

(defn- analyze-forms-with-controls [source-forms opts]
  (if (default-controls?)
    (frontend/analyze-forms source-forms opts)
    ;; Rebinding is only entered when a caller explicitly overrides the public
    ;; facade controls (principally bounded tests). Normal concurrent analysis
    ;; stays on the direct, mutation-free path above.
    (with-redefs [fe-namespace-defs/max-functions max-functions
                  fe-validate/max-expression-nodes max-expression-nodes
                  fe-analyze/max-lowered-nodes max-lowered-nodes
                  fe-validate/max-bindings max-bindings
                  fe-validate/max-list-items max-list-items
                  fe-namespace-defs/max-namespace-capabilities max-namespace-capabilities
                  fe-namespace-defs/max-namespace-docstring-chars max-namespace-docstring-chars
                  fe-expand/max-function-docstring-chars max-function-docstring-chars]
      (frontend/analyze-forms source-forms opts))))

(defn analyze-forms
  "Analyze already-read Kotoba source FORMS and return a validated HIR
  envelope. Public admission controls are authoritative when explicitly
  overridden, exactly as for `analyze`."
  ([source-forms] (analyze-forms-with-controls source-forms nil))
  ([source-forms opts] (analyze-forms-with-controls source-forms opts)))

(def lint-forms
  "Analyze already-read Kotoba source FORMS as `lint` does its source text,
  then return a vector of non-fatal findings -- empty when there is nothing
  to say. A refusal propagates unchanged."
  frontend/lint-forms)
))
