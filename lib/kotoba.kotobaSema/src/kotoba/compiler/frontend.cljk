#?(:kotoba
(defn analyze [source :string opts [:ref :form/r]] [:ref :ana/ir]
  (analyze/analyze source opts))
   :default (def analyze analyze/analyze))
#?(:kotoba
(defn analyze-forms [source-forms [:ref :form/r] opts [:ref :form/r]] [:ref :ana/ir]
  (analyze/analyze-forms* source-forms opts))
   :default (def analyze-forms analyze/analyze-forms*))
#?(:kotoba
(defn lint [source :string opts [:ref :form/r]] [:ref :ana/ir]
  (lint-core/lint source opts))
   :default (def lint analyze/lint))
#?(:kotoba
(defn lint-forms [source-forms [:ref :form/r] opts [:ref :form/r]] [:ref :ana/ir]
  (lint-core/lint-forms source-forms opts))
   :default (def lint-forms analyze/lint-forms))
