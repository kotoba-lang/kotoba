(ns kotoba.compiler.schema
  "Closed, bounded nominal schema graphs for structured application values."
  {:kotoba/export [identities max-schema-depth max-schema-nodes max-schemas ref-type? validate-table!]}
  (:require [kotoba.artifact.core :as artifact]))

#?(:kotoba (defn max-schemas [] :i64 32) :default (def max-schemas 32))
#?(:kotoba (defn max-schema-nodes [] :i64 64) :default (def max-schema-nodes 64))
;; kotoba-lang lang/limits.edn :language/static :type-descriptor-depth
;; (8 -> 12 on 2026-09-24, adr-2609242100 P1; the frontend's max-type-depth
;; and osaho's adt-depth-limit are the same bound).
#?(:kotoba (defn max-schema-depth [] :i64 12) :default (def max-schema-depth 12))

#?(:kotoba nil
   :default
   (def ^:private primitives
     ;; :document admitted 2026-08-01 (document-in-record): design-system
     ;; Delivery-6 document-plane multi-arg folds need guest records that carry
     ;; logical :document fields (css rule-doc, html constructors, tokens groups).
     ;; Frontend value-types and KIR already treat :document as a scalar-like
     ;; heap value; schema closed profile was the remaining gate.
     ;;
     ;; :bytes admitted 2026-10-19 (bytes-in-record): the same shape as
     ;; document-in-record. `:bytes` is the language's byte string, a distinct
     ;; scalar-like heap type (`frontend.cljk` `value-types`; "a distinct type
     ;; from :vector-i64"), and every record carrying raw bytes -- the form
     ;; record's `:data`, kotoba.compiler.nbb.check-driver's `:form/r` -- was
     ;; refused "schema descriptor is outside the closed profile" for it.
     #{:i64 :f32 :f64 :string :keyword :bool :vector-i64 :vector-f64 :document :bytes}))
;; unary :set / :list / :option are productive constructors — guest records
;; may already carry e.g. [:set :string] fields (set-in-record / T8.3 true-set
;; uniqueness on pure/KIR; see set_in_record_test). Not a bare primitive.
#?(:kotoba nil :default (def ^:private unary-tags #{:option :set :list}))
#?(:kotoba nil :default (def ^:private binary-tags #{:result :map}))
#?(:kotoba nil :default
   (def ^:private productive-tags
     #{:option :set :list :result :map :vector :record :variant}))

(defn ref-type?
  #?@(:kotoba [[value :document] :bool]
      :default [[value]])
  (and (vector? value) (= 2 (count value)) #?(:kotoba (document-equal? (first value) (document-keyword :ref)) :default (= :ref (first value)))))

#?(:kotoba
   (defn- fail! [message :string] :i64
     (throw (document-map (document-keyword :phase) (document-keyword :schema)
                          (document-keyword :message) (document-string message)))))
#?(:kotoba nil
   :default
   (defn- fail! [message data]
     (throw (ex-info message (assoc data :phase :schema)))))

#?(:kotoba
   (defn- primitive? [k :document] :bool (or (document-equal? k (document-keyword :i64)) (document-equal? k (document-keyword :f32)) (document-equal? k (document-keyword :f64)) (document-equal? k (document-keyword :string)) (document-equal? k (document-keyword :keyword)) (document-equal? k (document-keyword :bool)) (document-equal? k (document-keyword :vector-i64)) (document-equal? k (document-keyword :vector-f64)) (document-equal? k (document-keyword :document)) (document-equal? k (document-keyword :bytes))))
   :default
   (defn- primitive? [k] (primitives k)))
#?(:kotoba
   (defn- unary-tag? [k :document] :bool (or (document-equal? k (document-keyword :option)) (document-equal? k (document-keyword :set)) (document-equal? k (document-keyword :list))))
   :default
   (defn- unary-tag? [k] (unary-tags k)))
#?(:kotoba
   (defn- binary-tag? [k :document] :bool (or (document-equal? k (document-keyword :result)) (document-equal? k (document-keyword :map))))
   :default
   (defn- binary-tag? [k] (binary-tags k)))
#?(:kotoba
   (defn- nominal-tag? [k :document] :bool (or (document-equal? k (document-keyword :record)) (document-equal? k (document-keyword :variant))))
   :default
   (defn- nominal-tag? [k] (#{:record :variant} k)))

;; The path of nominal owners being walked: a set on the host, a document
;; vector on the Kotoba route (a set of documents has no spelling there).
#?(:kotoba
   (defn- qualified-keys?
     [table :document keys :document from :i64] :bool
     (if (< from (count keys))
       (let [k (nth keys from)]
         (if (= (document-kind k) :keyword)
           (if (> (string-index-of (document-edn-print k) "/") 1)
             (qualified-keys? table keys (inc from))
             false)
           false))
       true)))

#?(:kotoba
   (defn- path-has?
     [path :document target :document from :i64] :bool
     (if (< from (count path))
       (if (document-equal? (nth path from) target)
         true
         (path-has? path target (inc from)))
       false))
   :default
   (declare walk))

(defn- walk-children
  #?@(:kotoba [[table :document origin :document nominal-root :document children :document
                from :i64 path :document depth :i64 spent :i64] :i64]
       :default [[table origin nominal-root children from path depth spent]])
  (if (< from (count children))
    (let [after (walk table origin nominal-root (nth children from)
                      path true (inc depth) spent)]
      (walk-children table origin nominal-root children (inc from) path depth after))
    spent))

(defn- walk-members
  #?@(:kotoba [[table :document origin :document nominal-root :document entries :document
                from :i64 path :document depth :i64 spent :i64] :i64]
       :default [[table origin nominal-root entries from path depth spent]])
  (if (< from (count entries))
    (let [entry (nth entries from)
          _ (when-not (keyword? (first entry))
              #?(:kotoba (fail! "schema member name must be a keyword")
                 :default (fail! "schema member name must be a keyword"
                                 {:root origin :member (first entry)})))
          after (walk table origin nominal-root (second entry)
                      path true (inc depth) spent)]
      (walk-members table origin nominal-root entries (inc from) path depth after))
    spent))

(defn- walk-roots
  #?@(:kotoba [[table :document roots :document from :i64] :i64]
      :default [[table roots from]])
  (if (< from (count roots))
    (let [root (nth roots from)
          spent (walk table root root #?(:kotoba (get table root (document-null)) :default (get table root)) #?(:kotoba (document-vector root) :default #{root}) false 0 0)]
      (walk-roots table roots (inc from)))
    0))

(defn- walk
  #?@(:kotoba [[table :document origin :document nominal-root :document node :document
                path :document productive? :bool depth :i64 budget :i64] :i64]
       :default [[table origin nominal-root node path productive? depth budget]])
  (let [budget (inc budget)]
    (when (> budget #?(:kotoba (max-schema-nodes) :default max-schema-nodes))
      #?(:kotoba (fail! "schema graph exceeds node limit")
         :default (fail! "schema graph exceeds node limit" {:root origin})))
    (when (> depth #?(:kotoba (max-schema-depth) :default max-schema-depth))
      #?(:kotoba (fail! "schema graph exceeds depth limit")
         :default (fail! "schema graph exceeds depth limit" {:root origin})))
    (cond
      (primitive? node) budget
      (ref-type? node)
      (let [target (second node)]
        (when-not (contains? table target)
          #?(:kotoba (fail! "schema reference is not declared")
             :default (fail! "schema reference is not declared"
                             {:root origin :ref target})))
        (if #?(:kotoba (path-has? path target 0) :default (contains? path target))
          (do (when-not productive?
                #?(:kotoba (fail! "schema alias cycle is not productive")
                   :default (fail! "schema alias cycle is not productive"
                                   {:root origin :ref target})))
              budget)
          ;; A reference changes the nominal owner whose descriptor is
          ;; being checked. Keeping the original root separately
          ;; preserves whole-graph depth/node accounting and useful
          ;; diagnostics without requiring the referenced record or
          ;; variant to forge the caller's nominal identity.
          (walk table origin target #?(:kotoba (get table target (document-null)) :default (get table target))
                #?(:kotoba (document-vector-conj path target) :default (conj path target)) false (inc depth) budget)))
      (and (vector? node) (unary-tag? (first node)) (= 2 (count node)))
      (walk table origin nominal-root (second node)
            path true (inc depth) budget)
      (and (vector? node) (binary-tag? (first node)) (= 3 (count node)))
      (walk-children table origin nominal-root #?(:kotoba (rest node) :default (vec (rest node))) 0 path depth budget)
      (and (vector? node) #?(:kotoba (document-equal? (first node) (document-keyword :vector)) :default (= :vector (first node))) (= 2 (count node))
           (vector? (second node)))
      (walk-children table origin nominal-root (second node) 0 path depth budget)
      (and (vector? node) (nominal-tag? (first node)) (= 3 (count node))
           #?(:kotoba (document-equal? nominal-root (second node)) :default (= nominal-root (second node))) (vector? (nth node 2)))
      (walk-members table origin nominal-root (nth node 2) 0 path depth budget)
      :else #?(:kotoba (fail! "schema descriptor is outside the closed profile")
               :default (fail! "schema descriptor is outside the closed profile"
                               {:root origin :descriptor node})))))

(defn- check-table!
  "Validates and returns a closed schema table. Recursive references are
  admitted only through a productive value constructor."
  #?@(:kotoba [[table :document] :document]
       :default [[table]])
  (when-not #?(:kotoba (= (document-kind table) :map) :default (map? table))
    #?(:kotoba (fail! "schema table must be a map")
       :default (fail! "schema table must be a map" {:table table})))
  (when-not #?(:kotoba (> (count table) 0) :default (seq table))
    #?(:kotoba (fail! "schema table must not be empty")
       :default (fail! "schema table must not be empty" {:table table})))
  (when-not (<= (count table) #?(:kotoba (max-schemas) :default max-schemas))
    #?(:kotoba (fail! "schema table exceeds the schema limit")
       :default (fail! "schema table exceeds the schema limit" {:table table})))
  (when-not #?(:kotoba (qualified-keys? table (keys table) 0)
               :default (every? #(and (keyword? %) (namespace %)) (keys table)))
    #?(:kotoba (fail! "schema table keys must be qualified names")
       :default (fail! "schema table keys must be qualified names" {:table table})))
  ;; `budget` is the node count so far, threaded through `walk` (which returns
  ;; the count after the subtree) instead of a shared volatile: the Kotoba
  ;; route has no mutable cell to pass as an argument, and the count visited,
  ;; the limit and the order of the two limit checks are exactly the host's.
  (walk-roots table #?(:kotoba (keys table) :default (vec (keys table))) 0)
  table)

#?(:kotoba
   (defn validate-table!
     "The Kotoba route cannot export an aborting function, so the refusal is
     the value: the table itself when it is admitted, otherwise the document
     {:phase :schema :message ...} the host would have thrown."
     [table :document] :document
     (try (check-table! table)
          (catch :document e e))))
#?(:kotoba nil
   :default
   (defn validate-table!
     "Validates and returns a closed schema table."
     [table]
     (check-table! table)))

#?(:kotoba
   (defn- identities-from
     [table :document roots :document from :i64 acc :document] :document
     (if (< from (count roots))
       (let [root (nth roots from)
             digest (artifact/sha256 (document-map (document-keyword :root) root
                                                   (document-keyword :schemas) table))]
         (identities-from table roots (inc from) (assoc acc root (document-string digest))))
       acc)))

#?(:kotoba
   (defn identities
     "Returns stable content identities as a document map, or (the Kotoba
     route cannot abort through an export) the refusal document
     `validate-table!` returns."
     [table :document] :document
     (let [checked (validate-table! table)]
       (if (document-equal? checked table)
         (identities-from table (keys table) 0 (document-map))
         checked)))
   :default
   (defn identities
     "Returns stable content identities. Each identity binds its nominal root to
  the complete closed table, so changing any reachable definition changes it."
     [table]
     (validate-table! table)
     (into (sorted-map)
           (map (fn [root]
                  [root (artifact/sha256 {:root root :schemas table})]))
           (sort-by str (keys table)))))
