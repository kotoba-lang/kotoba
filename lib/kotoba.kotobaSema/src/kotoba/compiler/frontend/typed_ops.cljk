(ns kotoba.compiler.frontend.typed-ops
  #?(:kotoba {:kotoba/export [typed-op-specs]})
  (:require [kotoba.form :as form])
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

;; the table-driven typed operations: op -> [arity message kinds-per-operand]
#?(:kotoba
   (defn typed-op-specs [] [:ref :form/r]
     (form/edn-form "{typed-list-nth [3 \"typed-list-nth requires type, value, and index\" [:raw :value :expr]]
    typed-list-conj [3 \"typed-list-conj requires type, value, and item\" [:raw :value :list-item]]
    typed-set-count [2 \"typed-set-count requires type and value\" [:raw :value]]
    typed-set-contains [3 \"typed-set-contains requires type, value, and item\" [:raw :value :set-item]]
    typed-set-conj [3 \"typed-set-conj requires type, value, and item\" [:raw :value :set-item]]
    typed-set-disj [3 \"typed-set-disj requires type, value, and item\" [:raw :value :set-item]]
    typed-set-equal [3 \"typed-set-equal requires type and two values\" [:raw :value :value]]
    typed-set-nth [3 \"typed-set-nth requires type, value, and index\" [:raw :value :expr]]
    typed-map-count [2 \"typed-map-count requires type and value\" [:raw :value]]
    typed-map-contains [3 \"typed-map-contains requires type, value, and key\" [:raw :value :key]]
    typed-map-get [3 \"typed-map-get requires type, value, and key\" [:raw :value :key]]
    typed-map-entry-at [3 \"typed-map-entry-at requires type, value, and index\" [:raw :value :expr]]
    typed-map-keys [2 \"typed-map-keys requires type and value\" [:raw :value]]
    typed-map-vals [2 \"typed-map-vals requires type and value\" [:raw :value]]
    typed-map-assoc [4 \"typed-map-assoc requires type, value, key, and item\" [:raw :value :key :val]]
    typed-map-dissoc [3 \"typed-map-dissoc requires type, value, and key\" [:raw :value :key]]
    typed-map-equal [3 \"typed-map-equal requires type and two values\" [:raw :value :value]]
    hetero-vector-count [2 \"hetero-vector-count requires type and value\" [:raw :value]]
    hetero-vector-at [3 \"hetero-vector-at requires type, value, and literal index\" [:raw :value :raw]]
    hetero-vector-equal [3 \"hetero-vector-equal requires type and two values\" [:raw :value :value]]
    record-equal [3 \"record-equal requires type and two values\" [:ct :value :value]]
    result-ok-of [2 \"result-ok-of requires type and payload\" [:raw :ok]]
    result-err-of [2 \"result-err-of requires type and payload\" [:raw :err]]
    result-ok?-of [2 \"result-ok?-of requires type and result\" [:raw :value]]
    result-value-of [3 \"result-value-of requires type, result, and fallback\" [:raw :value :ok]]
    result-error-of [3 \"result-error-of requires type, result, and fallback\" [:raw :value :err]]
    option-some-of [2 \"option-some-of requires type and payload\" [:raw :payload]]
    option-none-of [1 \"option-none-of requires one type\" [:raw]]
    option-some?-of [2 \"option-some?-of requires type and value\" [:raw :value]]
    option-value-of [3 \"option-value-of requires type, value, and fallback\" [:raw :value :payload]]
    option-or [2 \"option-or requires an option value and a fallback\" [:expr :expr]]}"))
   :default nil)
