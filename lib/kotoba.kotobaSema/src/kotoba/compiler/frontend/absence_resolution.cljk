(ns kotoba.compiler.frontend.absence-resolution
  #?(:kotoba {:kotoba/export [resolve-function-absences retire-absence-markers]})
  (:require #?@(:kotoba [[kotoba.form :as form]
                         [kotoba.compiler.frontend.base :refer [fget fmeta-from fput]]
                         [kotoba.compiler.frontend.kernel-region :refer [absence-marker?]]
                         [kotoba.compiler.frontend.infer :refer [absence-in-tail? legacy-absence #?@(:kotoba [zip-locals] :default [])]]
                         [kotoba.compiler.frontend.infer-passes :refer [abort-signatures infer-type-or-nil resolve-absence-if]]]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                         :ie/ctx [:record :ie/ctx [[:schemas [:ref :form/r]] [:row-schemas [:ref :form/r]] [:handlers [:ref :form/r]] [:final :bool] [:tail :bool] [:names [:ref :form/r]] [:recording :bool] [:recorded [:ref :form/r]] [:collect :bool] [:throws [:list [:ref :form/r]]] [:known [:ref :form/r]] [:tbl [:ref :form/r]] [:rec-limit :i64] [:rec-count :i64]]]
                         :ana/r [:record :ana/r [[:form [:ref :form/r]] [:aux [:ref :form/r]] [:n :i64]]]})))

#?(:kotoba
(defn- ar-sym-is? [form [:ref :form/r] name :string] :bool
  (and (form/is-symbol? form) (string=? (form/symbol-value form) name)))
   :default nil)

#?(:kotoba
(defn- ar-seq2 [head :string a [:ref :form/r] b [:ref :form/r]] [:ref :form/r]
  (form/form-seq (form/three-forms (form/symbol-form head) a b)))
   :default nil)

#?(:kotoba
(defn- ar-seq3 [head :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r]
  (form/form-seq (form/append-form (form/three-forms (form/symbol-form head) a b) c)))
   :default nil)

#?(:kotoba
(defn- ar-r [value [:ref :form/r] aux [:ref :form/r] n :i64] [:ref :ana/r]
  (record-new [:ref :ana/r] value aux n))
   :default nil)

#?(:kotoba
(defn- ar-r-form [result [:ref :ana/r]] [:ref :form/r]
  (record-get [:ref :ana/r] result :form))
   :default nil)

#?(:kotoba
(defn- ar-r-aux [result [:ref :ana/r]] [:ref :form/r]
  (record-get [:ref :ana/r] result :aux))
   :default nil)

#?(:kotoba
(defn- ar-absence-kids? [kids [:list [:ref :form/r]] i :i64] :bool
  (if (>= i (vector-count kids))
    false
    (or (ar-absence-in-body? (typed-list-nth [:list [:ref :form/r]] kids i))
        (ar-absence-kids? kids (+ i 1)))))
   :default nil)

#?(:kotoba
(defn- ar-absence-in-body? [form [:ref :form/r]] :bool
  (cond
    (absence-marker? form) true
    (or (form/is-seq? form) (form/is-vec? form)) (ar-absence-kids? (form/kids-of form) 0)
    :else false))
   :default nil)

#?(:kotoba
(defn- ar-abs-let-pairs [ctx [:ref :ie/ctx] bindings [:ref :form/r] i :i64 current [:ref :form/r]
                         sigs [:ref :form/r] out [:list [:ref :form/r]]] [:ref :ana/r]
  (if (>= (+ i 1) (form/count-of bindings))
    (ar-r (form/form-vec out) current 0)
    (let [name (form/nth-of bindings i)
          value (ar-resolve-absences ctx (form/nth-of bindings (+ i 1)) current sigs false)]
      (ar-abs-let-pairs ctx bindings (+ i 2)
                        (form/assoc-form current name (infer-type-or-nil ctx value current sigs)) sigs
                        (form/append-form (form/append-form out name) value)))))
   :default nil)

#?(:kotoba
(defn- ar-abs-kids-true [ctx [:ref :ie/ctx] form [:ref :form/r] i :i64 end :i64
                         locals [:ref :form/r] sigs [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i end)
    acc
    (ar-abs-kids-true ctx form (+ i 1) end locals sigs
                      (form/append-form acc (ar-resolve-absences ctx (form/nth-of form i) locals sigs true)))))
   :default nil)

#?(:kotoba
(defn- ar-abs-kids-all [ctx [:ref :ie/ctx] form [:ref :form/r] i :i64
                        locals [:ref :form/r] sigs [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of form))
    acc
    (ar-abs-kids-all ctx form (+ i 1) locals sigs
                     (form/append-form acc (ar-resolve-absences ctx (form/nth-of form i) locals sigs false)))))
   :default nil)

#?(:kotoba
(defn- ar-resolve-absence-non-tails [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (cond
    (absence-marker? form) form
    (and (form/is-seq? form) (ar-sym-is? (form/nth-of form 0) "if") (= 4 (form/count-of form)))
    (fmeta-from form (ar-seq3 "if" (ar-resolve-absences ctx (form/nth-of form 1) locals sigs false)
                               (ar-resolve-absence-non-tails ctx (form/nth-of form 2) locals sigs)
                               (ar-resolve-absence-non-tails ctx (form/nth-of form 3) locals sigs)))
    (and (form/is-seq? form) (ar-sym-is? (form/nth-of form 0) "let") (form/is-vec? (form/nth-of form 1)) (= 3 (form/count-of form)))
    (let [pair (ar-abs-let-pairs ctx (form/nth-of form 1) 0 locals sigs (form/no-forms))]
      (fmeta-from form (ar-seq2 "let" (ar-r-form pair)
                                (ar-resolve-absence-non-tails ctx (form/nth-of form 2) (ar-r-aux pair) sigs))))
    (and (form/is-seq? form) (ar-sym-is? (form/nth-of form 0) "do") (<= 2 (form/count-of form)))
    (let [n (form/count-of form)
          leading (ar-abs-kids-true ctx form 1 (- n 1) locals sigs (form/no-forms))
          tail (ar-resolve-absence-non-tails ctx (form/nth-of form (- n 1)) locals sigs)]
      (fmeta-from form (form/form-seq (form/cons-onto (form/symbol-form "do") (form/append-form leading tail)))))
    :else (ar-resolve-absences ctx form locals sigs false)))
   :default nil)

#?(:kotoba
(defn- ar-resolve-absences [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r]
                           sigs [:ref :form/r] statement? :bool] [:ref :form/r]
  (cond
    (not (form/is-seq? form)) form
    (absence-marker? form) form
    (= 0 (form/count-of form)) form
    (and (ar-sym-is? (form/nth-of form 0) "let") (form/is-vec? (form/nth-of form 1)) (= 3 (form/count-of form)))
    (let [pair (ar-abs-let-pairs ctx (form/nth-of form 1) 0 locals sigs (form/no-forms))]
      (fmeta-from form (ar-seq2 "let" (ar-r-form pair)
                                (ar-resolve-absences ctx (form/nth-of form 2) (ar-r-aux pair) sigs statement?))))
    (and (ar-sym-is? (form/nth-of form 0) "do") (<= 2 (form/count-of form)))
    (let [n (form/count-of form)
          leading (ar-abs-kids-true ctx form 1 (- n 1) locals sigs (form/no-forms))
          tail (ar-resolve-absences ctx (form/nth-of form (- n 1)) locals sigs statement?)]
      (fmeta-from form (form/form-seq (form/cons-onto (form/symbol-form "do") (form/append-form leading tail)))))
    (and (ar-sym-is? (form/nth-of form 0) "if") (= 4 (form/count-of form)) (absence-in-tail? form))
    (resolve-absence-if ctx (ar-resolve-absence-non-tails ctx form locals sigs) locals sigs statement?)
    (and (ar-sym-is? (form/nth-of form 0) "if") (= 4 (form/count-of form)))
    (fmeta-from form (ar-seq3 "if" (ar-resolve-absences ctx (form/nth-of form 1) locals sigs false)
                               (ar-resolve-absences ctx (form/nth-of form 2) locals sigs statement?)
                               (ar-resolve-absences ctx (form/nth-of form 3) locals sigs statement?)))
    :else (fmeta-from form (form/form-seq (ar-abs-kids-all ctx form 0 locals sigs (form/no-forms))))))
   :default nil)

#?(:kotoba
(defn- ar-absence-signatures [functions [:ref :form/r]] [:ref :form/r]
  (abort-signatures functions))
   :default nil)

#?(:kotoba
(defn- ar-any-absence-body? [functions [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of functions))
    false
    (or (ar-absence-in-body? (fget (form/nth-of functions i) :body))
        (ar-any-absence-body? functions (+ i 1)))))
   :default nil)

#?(:kotoba
(defn- ar-resolve-fn-absences [ctx [:ref :ie/ctx] functions [:ref :form/r] i :i64
                              sigs [:ref :form/r] acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of functions))
    (form/form-vec acc)
    (let [function (form/nth-of functions i)
          body (ar-resolve-absences ctx (fget function :body)
                                    (zip-locals (fget function :params) (fget function :param-types)) sigs false)]
      (ar-resolve-fn-absences ctx functions (+ i 1) sigs
                              (form/append-form acc (fput function :body body)))))))

#?(:kotoba
;; Runs after result inference and before abort elaboration moves tails into result values.
(defn resolve-function-absences [ctx [:ref :ie/ctx] functions [:ref :form/r]] [:ref :form/r]
  (if (not (ar-any-absence-body? functions 0))
    functions
    (ar-resolve-fn-absences ctx functions 0 (ar-absence-signatures functions) (form/no-forms))))
   :default nil)

#?(:kotoba
(defn- ar-retire-kids [form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of form))
    acc
    (ar-retire-kids form (+ i 1) (form/append-form acc (retire-absence-markers (form/nth-of form i))))))
   :default nil)

#?(:kotoba
;; Markers with no inferred type retain the legacy lowering: 0 or option-none.
(defn retire-absence-markers [form [:ref :form/r]] [:ref :form/r]
  (cond
    (absence-marker? form) (legacy-absence form)
    (form/is-seq? form) (fmeta-from form (form/form-seq (ar-retire-kids form 0 (form/no-forms))))
    (form/is-vec? form) (fmeta-from form (form/form-vec (ar-retire-kids form 0 (form/no-forms))))
    :else form))
   :default nil)
