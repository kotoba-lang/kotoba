(ns kotoba.compiler.frontend.source-prepasses
  #?(:kotoba {:kotoba/export [annotate-doseq-collection-kinds expand-app-data-bytes-writes]})
  (:require #?@(:kotoba [[kotoba.form :as form]
                         [kotoba.compiler.frontend.base :refer [fmeta-from]]]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                         :sp/r [:record :sp/r [[:form [:ref :form/r]] [:aux [:ref :form/r]] [:n :i64]]]})))

#?(:kotoba
(defn- sp-sym-is? [form [:ref :form/r] name :string] :bool
  (and (form/is-symbol? form) (string=? (form/symbol-value form) name)))
   :default nil)

#?(:kotoba
(defn- sp-r [value [:ref :form/r] env [:ref :form/r] index :i64] [:ref :sp/r]
  (record-new [:ref :sp/r] value env index))
   :default nil)

#?(:kotoba
(defn- sp-r-form [result [:ref :sp/r]] [:ref :form/r]
  (record-get [:ref :sp/r] result :form))
   :default nil)

#?(:kotoba
(defn- sp-r-aux [result [:ref :sp/r]] [:ref :form/r]
  (record-get [:ref :sp/r] result :aux))
   :default nil)

#?(:kotoba
(defn- sp-r-n [result [:ref :sp/r]] :i64
  (record-get [:ref :sp/r] result :n))
   :default nil)

#?(:kotoba
(defn- sp-empty-map [] [:ref :form/r]
  (form/form-map (form/no-forms)))
   :default nil)

#?(:kotoba
(defn- sp-seq1 [head :string value [:ref :form/r]] [:ref :form/r]
  (form/form-seq (form/two-forms (form/symbol-form head) value)))
   :default nil)

#?(:kotoba
(defn- sp-seq2 [head :string a [:ref :form/r] b [:ref :form/r]] [:ref :form/r]
  (form/form-seq (form/three-forms (form/symbol-form head) a b)))
   :default nil)

#?(:kotoba
(defn- sp-ad-kind-of [form [:ref :form/r] env [:ref :form/r]] [:ref :form/r]
  (cond
    (form/is-symbol? form) (form/form-get env form)
    (form/is-vec? form) (form/keyword-form :vector)
    (and (form/is-seq? form) (> (form/count-of form) 0)
         (or (sp-sym-is? (form/nth-of form 0) "list")
             (sp-sym-is? (form/nth-of form 0) "cons")
             (sp-sym-is? (form/nth-of form 0) "rest")
             (sp-sym-is? (form/nth-of form 0) "__kotoba_pair_sequence")))
    (form/keyword-form :pair)
    :else (form/nil-form)))
   :default nil)

#?(:kotoba
(defn- sp-ad-bindings [bindings [:ref :form/r] i :i64 current [:ref :form/r]
                       out [:list [:ref :form/r]]] [:ref :sp/r]
  (if (>= (+ i 1) (form/count-of bindings))
    (sp-r (form/form-vec out) current 0)
    (let [name (form/nth-of bindings i)
          value (sp-ad-walk (form/nth-of bindings (+ i 1)) current)
          kind (sp-ad-kind-of value current)
          next-env (if (form/is-symbol? name)
                     (if (form/is-nil? kind)
                       (form/dissoc-form current name)
                       (form/assoc-form (form/dissoc-form current name) name kind))
                     current)]
      (sp-ad-bindings bindings (+ i 2) next-env
                      (form/append-form (form/append-form out name) value)))))
   :default nil)

#?(:kotoba
(defn- sp-ad-modifiers [binding [:ref :form/r] j :i64 modifier-env [:ref :form/r]
                        group-out [:list [:ref :form/r]]] [:ref :sp/r]
  (if (and (< j (form/count-of binding)) (form/is-keyword? (form/nth-of binding j)))
    (let [modifier (form/nth-of binding j)
          value (form/nth-of binding (+ j 1))]
      (if (form/eq modifier (form/keyword-form :let))
        (if (and (form/is-vec? value) (= 0 (rem (form/count-of value) 2)))
          (let [walked (sp-ad-bindings value 0 modifier-env (form/no-forms))]
            (sp-ad-modifiers binding (+ j 2) (sp-r-aux walked)
                             (form/append-form (form/append-form group-out modifier) (sp-r-form walked))))
          (sp-ad-modifiers binding (+ j 2) modifier-env
                           (form/append-form (form/append-form group-out modifier)
                                             (sp-ad-walk value modifier-env))))
        (sp-ad-modifiers binding (+ j 2) modifier-env
                         (form/append-form (form/append-form group-out modifier)
                                           (sp-ad-walk value modifier-env)))))
    (sp-r (form/form-vec group-out) modifier-env j)))
   :default nil)

#?(:kotoba
(defn- sp-ad-doseq [binding [:ref :form/r] i :i64 current [:ref :form/r]
                    out [:list [:ref :form/r]]] [:ref :sp/r]
  (if (>= i (form/count-of binding))
    (sp-r (form/form-vec out) current 0)
    (let [item (form/nth-of binding i)
          collection (form/nth-of binding (+ i 1))
          coll* (sp-ad-walk collection current)
          kind (sp-ad-kind-of coll* current)
          coll** (if (and (form/eq kind (form/keyword-form :pair)) (form/is-symbol? coll*))
                   (sp-seq1 "__kotoba_pair_sequence" coll*) coll*)
          after-item (if (form/is-symbol? item) (form/dissoc-form current item) current)
          mods (sp-ad-modifiers binding (+ i 2) after-item
                                (form/append-form (form/append-form out item) coll**))]
      (if (< (sp-r-n mods) (form/count-of binding))
        (sp-ad-doseq binding (sp-r-n mods) (sp-r-aux mods) (form/kids-of (sp-r-form mods)))
        (sp-r (sp-r-form mods) (sp-r-aux mods) 0)))))
   :default nil)

#?(:kotoba
(defn- sp-ad-kids [form [:ref :form/r] i :i64 env [:ref :form/r]
                   acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of form))
    acc
    (sp-ad-kids form (+ i 1) env
                (form/append-form acc (sp-ad-walk (form/nth-of form i) env)))))
   :default nil)

#?(:kotoba
(defn- sp-sym-doseq [] [:ref :form/r]
  (form/symbol-form "doseq"))
   :default nil)

#?(:kotoba
(defn- sp-ad-seq [form [:ref :form/r] env [:ref :form/r]] [:ref :form/r]
  (let [op (form/nth-of form 0)]
    (cond
      (and (sp-sym-is? op "let") (> (form/count-of form) 1)
           (form/is-vec? (form/nth-of form 1))
           (= 0 (rem (form/count-of (form/nth-of form 1)) 2)))
      (let [walked (sp-ad-bindings (form/nth-of form 1) 0 env (form/no-forms))]
        (form/form-seq (form/cons-onto op
          (form/cons-onto (sp-r-form walked)
            (sp-ad-kids form 2 (sp-r-aux walked) (form/no-forms))))))
      (and (sp-sym-is? op "doseq") (> (form/count-of form) 1)
           (form/is-vec? (form/nth-of form 1))
           (<= 2 (form/count-of (form/nth-of form 1))))
      (let [walked (sp-ad-doseq (form/nth-of form 1) 0 env (form/no-forms))]
        (form/form-seq (form/cons-onto (sp-sym-doseq)
          (form/cons-onto (sp-r-form walked)
            (sp-ad-kids form 2 (sp-r-aux walked) (form/no-forms))))))
      :else (form/form-seq (form/cons-onto op (sp-ad-kids form 1 env (form/no-forms)))))))
   :default nil)

#?(:kotoba
(defn- sp-ad-walk [form [:ref :form/r] env [:ref :form/r]] [:ref :form/r]
  (cond
    (and (form/is-seq? form) (> (form/count-of form) 0)) (fmeta-from form (sp-ad-seq form env))
    (form/is-seq? form) form
    (form/is-vec? form) (fmeta-from form (form/form-vec (sp-ad-kids form 0 env (form/no-forms))))
    (form/is-map? form) (fmeta-from form (form/form-map (sp-ad-kids form 0 env (form/no-forms))))
    (form/is-set? form) (fmeta-from form (form/form-set (sp-ad-kids form 0 env (form/no-forms))))
    :else form))
   :default nil)

#?(:kotoba
(defn annotate-doseq-collection-kinds [root [:ref :form/r]] [:ref :form/r]
  (sp-ad-walk root (sp-empty-map)))
   :default nil)

#?(:kotoba
(defn- sp-eadbw-kids [form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of form))
    acc
    (sp-eadbw-kids form (+ i 1)
                   (form/append-form acc (expand-app-data-bytes-writes (form/nth-of form i))))))
   :default nil)

#?(:kotoba
(defn expand-app-data-bytes-writes [form [:ref :form/r]] [:ref :form/r]
  (cond
    (form/is-seq? form)
    (let [kids (sp-eadbw-kids form 0 (form/no-forms))
          rewritten (form/form-seq kids)]
      (if (and (> (vector-count kids) 0)
               (sp-sym-is? (typed-list-nth [:list [:ref :form/r]] kids 0) "fs/app-data-bytes")
               (= 3 (vector-count kids)))
        (sp-seq1 "fs/app-data-bytes"
                 (sp-seq2 "bytes-concat"
                          (sp-seq1 "string-to-utf8" (typed-list-nth [:list [:ref :form/r]] kids 1))
                          (typed-list-nth [:list [:ref :form/r]] kids 2)))
        rewritten))
    (form/is-vec? form) (form/form-vec (sp-eadbw-kids form 0 (form/no-forms)))
    :else form))
   :default nil)
