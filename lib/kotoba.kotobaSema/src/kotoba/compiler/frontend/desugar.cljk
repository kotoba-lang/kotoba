    ;; unknown, and that is refused by name: the literal's own source does not
    ;; say what the field holds when it is present.
    (when-let [[k _] (first #?(:kotoba (let [fe-lc__298338 (form/kids-of entries) fe-ln__298338 (vector-count fe-lc__298338)] (form/form-seq (loop [fe-li__298338 0 fe-la__298338 (form/no-forms)] (if (>= fe-li__298338 fe-ln__298338) fe-la__298338 (let [dd__293790_1 (typed-list-nth [:list [:ref :form/r]] fe-lc__298338 fe-li__298338)] (recur (+ fe-li__298338 1) (if (do (let [v (fe-nth dd__293790_1 1)] (nil? v))) (form/append-form fe-la__298338 dd__293790_1) fe-la__298338))))))) :default (filter (fn [dd__293790_1] (let [k (fe-nth dd__293790_1 0) v (fe-nth dd__293790_1 1)] (and (nil? v) (not (absent-field-type k))))) entries)))]
      (reject! (str "map literal value at key "
                    (map-literal-key-description-for-message k)
                    " is nil, which makes the field an absent [:option T], and "
                    "nothing here says T: give the literal a record type from "
                    "context (a declared record result, or a record field) or "
                    "write (option-none-of [:option T])")
