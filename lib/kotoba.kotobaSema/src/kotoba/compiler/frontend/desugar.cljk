                   (nth args 2))
                  (desugar-expected-value
                   (when (canonical-typed-map-type? (first args))
                     (nth (first args) 2))
                   (nth args 3))))
        typed-map-dissoc
        (do (when-not (= 3 (count args))
              (reject! "typed-map-dissoc requires type, value, and key" form))
            (list 'typed-map-dissoc (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expected-value
                   (when (canonical-typed-map-type? (first args))
                     (second (first args)))
                   (nth args 2))))
        typed-map-equal
        (do (when-not (= 3 (count args))
              (reject! "typed-map-equal requires type and two values" form))
            (list 'typed-map-equal (first args)
                  (desugar-expected-value (first args) (second args))
                  (desugar-expected-value (first args) (nth args 2))))
        record
        (do (when (empty? args)
              (reject! "record requires a type descriptor" form))
            (let [type (canonical-closure-result-type (first args))
                  field-types (when (record-type? type) (mapv second (nth type 2)))]
              (list* 'record-new type
                     (map-indexed (fn [index value]
                                    (desugar-expected-value
                                     (nth field-types index nil) value))
                                  (rest args)))))
        record-new
        (do (when (empty? args)
              (reject! "record-new requires a type descriptor" form))
            (let [type (canonical-closure-result-type (first args))
                  field-types (when (record-type? type) (mapv second (nth type 2)))]
              (list* 'record-new type
                     (map-indexed (fn [index value]
                                    (desugar-expected-value
                                     (nth field-types index nil) value))
                                  (rest args)))))
        record-get
        (do (when-not (contains? #{2 3} (count args))
              (reject! "record-get requires (value field) or (type value field)" form))
            ;; 2-arity is the projection sugar: the schema is recovered from the
            ;; value's inferred type by rewrite-record-projections, which runs
            ;; after desugar and before validation. Lowering only ever sees the
            ;; canonical 3-arity form.
            (if (= 2 (count args))
              (list 'record-get (desugar-expr (first args)) (second args))
              (let [type (canonical-closure-result-type (first args))]
                (list 'record-get type
                      (desugar-expected-value type (second args)) (nth args 2)))))
        record-assoc
        (do (when-not (= 4 (count args))
              (reject! "record-assoc requires type, value, literal field, and replacement" form))
            (let [type (canonical-closure-result-type (first args))
                  field-type (when (record-type? type)
                               (first-truthy (fn [[field field-type]]
                                       (when (= field (nth args 2)) field-type))
                                     (nth type 2)))]
              (list 'record-assoc type (desugar-expected-value type (second args))
                    (nth args 2) (desugar-expected-value field-type (nth args 3)))))
        record-equal
        (do (when-not (= 3 (count args))
              (reject! "record-equal requires type and two values" form))
            (let [type (canonical-closure-result-type (first args))]
              (list 'record-equal type
                    (desugar-expected-value type (second args))
                    (desugar-expected-value type (nth args 2)))))
        result-ok-of (do (when-not (= 2 (count args)) (reject! "result-ok-of requires type and payload" form))
                         (list 'result-ok-of (first args)
                               (desugar-expected-value
                                (when (parametric-result-type? (first args)) (second (first args)))
                                (second args))))
        result-err-of (do (when-not (= 2 (count args)) (reject! "result-err-of requires type and payload" form))
                          (list 'result-err-of (first args)
                                (desugar-expected-value
                                 (when (parametric-result-type? (first args)) (nth (first args) 2))
                                 (second args))))
        result-ok?-of (do (when-not (= 2 (count args)) (reject! "result-ok?-of requires type and result" form))
                          (list 'result-ok?-of (first args)
                                (desugar-expected-value (first args) (second args))))
        result-value-of (do (when-not (= 3 (count args)) (reject! "result-value-of requires type, result, and fallback" form))
                            (list 'result-value-of (first args)
                                  (desugar-expected-value (first args) (second args))
                                  (desugar-expected-value
                                   (when (parametric-result-type? (first args)) (second (first args)))
                                   (nth args 2))))
        result-error-of (do (when-not (= 3 (count args)) (reject! "result-error-of requires type, result, and fallback" form))
                            (list 'result-error-of (first args)
                                  (desugar-expected-value (first args) (second args))
                                  (desugar-expected-value
                                   (when (parametric-result-type? (first args)) (nth (first args) 2))
                                   (nth args 2))))
        ;; ADR-2607182410: `(cap-call :some/name value)` -> `(cap-call <int>
        ;; (desugar-expr value))`, resolving the keyword against
        ;; capability-registry BEFORE validate-expr/direct-facts ever see the
        ;; form -- everything downstream keeps working exactly as it does
        ;; for the pre-existing literal-int form, byte-for-byte. Only
        ;; intercepts when the FIRST arg is actually a keyword; any other
        ;; shape (correct int form, or a malformed call of any other arity)
        ;; falls through to the identical generic case below, unchanged, so
        ;; validate-expr's own existing arity/range check still fires with
        ;; its original message for every case this desugar step doesn't
        ;; specifically own. `(rest args)` (not a fixed `[value]`
        ;; destructure) preserves whatever argument count followed the
        ;; keyword, so a malformed `(cap-call :kw)` or `(cap-call :kw a b)`
        ;; still reaches validate-expr's "requires ... one value" rejection
        ;; instead of being silently coerced into a well-formed 2-arg call.
        cap-call
        (if (and (seq args) (keyword? (first args)))
          (let [kw (first args)
                elaborated (list* 'cap-call (resolve-capability-keyword! kw form)
                                  (map desugar-expr (rest args)))]
            (attach-source-operation form elaborated kw))
          (apply list op (map desugar-expr args)))
        typed-cap-call
        (if (and (seq args) (keyword? (first args)))
          (let [[capability request-type result-type request & extra] args
                elaborated (list* 'typed-cap-call
                                  (resolve-capability-keyword! capability form)
                                  request-type result-type
                                  (when (<= 4 (count args))
                                    (desugar-expected-value request-type request))
                                  (map desugar-expr extra))]
            (attach-source-operation form elaborated capability))
          (if (and (= 4 (count args))
                   (kotoba-integer? (first args)))
            (let [[capability request-type result-type request] args]
              (list 'typed-cap-call capability request-type result-type
                    (desugar-expected-value request-type request)))
            (apply list op (map desugar-expr args))))
        xorshift32
        (do
          (when-not (= 1 (count args))
            (reject! "xorshift32 requires one state value" form))
          (let [x0 (synthetic "xorshift32_0")
                x1 (synthetic "xorshift32_1")
                x2 (synthetic "xorshift32_2")
                x3 (synthetic "xorshift32_3")]
            (list 'let [x0 (list 'u32-wrap (desugar-expr (first args)))
                         x1 (list 'u32-wrap (list 'i32-xor x0 (list 'i32-shift-left x0 13)))
                         x2 (list 'u32-wrap (list 'i32-xor x1 (list 'u32-shift-right x1 17)))
                         x3 (list 'u32-wrap (list 'i32-xor x2 (list 'i32-shift-left x2 5)))]
                  x3)))
        ;; Product Value ABI v1: surface aliases that lower to ops already
        ;; qualified on every product backend (wasm / KIR / native string slice).
        ;; `str` surface alias: 2+ parts lower to the nested `string-concat`
        ;; already qualified on wasm/KIR/js, so the runtime cost is exactly the
        ;; cost of hand-writing `(string-concat a b ...)` — no new backend
        ;; lowering, no new fuel shape. A single string argument is identity.
        ;; Non-string parts fail closed at type check (`string-concat`
        ;; requires two :string operands) rather than silently coercing.
        str
        (do (when-not (pos? (count args))
              (reject! "str requires at least one argument" form))
            (if (= 1 (count args))
              (desugar-expr (first args))
              (reduce (fn [acc part]
                        (list 'string-concat acc part))
                      (str-part (first args))
                      (mapv str-part (rest args)))))
        string-length
        (do (when-not (= 1 (count args))
              (reject! "string-length requires one string" form))
            (list 'string-byte-length
                  (desugar-result-expr :string (first args))))
        string-from-i64
        (do (when-not (= 1 (count args))
              (reject! "string-from-i64 requires one i64" form))
            (list string-from-i64-helper-name (desugar-expr (first args))))
        ;; `(char n)` -> the one-code-point string. A module that defines its
        ;; own `char` keeps it (the mapv lesson); a string operand is already
        ;; a one-character value and is returned as written.
        char
        (if (contains? *function-arities* 'char)
          (apply list 'char (map desugar-expr args))
          (do (when-not (= 1 (count args))
                (reject! "char requires one code point" form))
              (if (string? (first args))
                (first args)
                (list char-helper-name (desugar-expr (first args))))))
        ;; T4.2: multi-part join → nested string-concat. The 8-part cap of ADR 0162
        ;; was the size of the unrolled expansion, not a semantic bound; the
        ;; expression-node and lowered-node limits already bound it.
        ;; Works on every backend that already has string-concat (wasm/KIR/js).
        string-join
        (do (when (zero? (count args))
              (reject! "string-join requires a separator string" form))
            (let [sep (desugar-result-expr :string (first args))
                  parts (mapv #(desugar-result-expr :string %) (rest args))]
              (cond
                (empty? parts) ""
                (= 1 (count parts)) (first parts)
                :else
                (reduce (fn [acc part]
                          (list 'string-concat acc
                                (list 'string-concat sep part)))
                        (first parts)
                        (rest parts)))))
        ;; T4.5/stdlib sugar: inc/dec → arithmetic already dual-backend green.
        inc
        (do (when-not (= 1 (count args))
              (reject! "inc requires one i64" form))
            (list '+ (desugar-expr (first args)) 1))
        dec
        (do (when-not (= 1 (count args))
              (reject! "dec requires one i64" form))
            (list '- (desugar-expr (first args)) 1))
        ;; `rem` truncates toward zero, as `quot` does; `mod` floors, so its
        ;; result takes the divisor's sign. Both evaluate each operand once.
        rem
        (do (when-not (= 2 (count args))
              (reject! "rem requires two i64 operands" form))
            (let [a (synthetic "rem_a") b (synthetic "rem_b")]
              (list 'let [a (desugar-expr (first args)) b (desugar-expr (second args))]
                    (list '- a (list '* (list 'quot a b) b)))))
        mod
        (do (when-not (= 2 (count args))
              (reject! "mod requires two i64 operands" form))
            (let [a (synthetic "mod_a") b (synthetic "mod_b") r (synthetic "mod_r")]
              (list 'let [a (desugar-expr (first args)) b (desugar-expr (second args))
                          r (list '- a (list '* (list 'quot a b) b))]
                    (list 'if (list '= r 0) r
                          (list 'if (list '< r 0)
                                (list 'if (list '< b 0) r (list '+ r b))
                                (list 'if (list '< b 0) (list '+ r b) r))))))
        ;; T4.5: bounded reduce over vector-i64 → zero-charge loop.
        ;; With an explicit init, admits arithmetic, inline, named, or stored
        ;; binary callbacks.  Without an init, the callback must provide the
        ;; Clojure-compatible zero and binary arities: empty vectors invoke
        ;; arity zero, while non-empty vectors start with their first item.
        reduce
        (do
          (when-not (#{2 3} (count args))
            (reject! "reduce requires callback+collection or callback+init+collection" form))
          (if (= 2 (count args))
            (let [[f-form coll-form] args
                  named? (top-level-function-symbol? f-form)
                  _ (when (and named?
                               (not (every? (get *function-arities* f-form) [0 2])))
                      (reject! "named no-init reduce callback must provide arities 0 and 2" f-form))
                  inline? (and (seq? f-form) (= 'fn (first f-form)))
                  _ (when inline?
                      (let [[_ params-or-clause & tail] f-form
                            clauses (when-not (vector? params-or-clause)
                                      (cons params-or-clause tail))
                            arities (when (and (seq clauses)
                                               (every? #(and (seq? %)
                                                             (vector? (first %)))
                                                       clauses))
                                      (mapv #(count (first %)) clauses))]
                        (when-not (= #{0 2} (set arities))
                          (reject! "inline no-init reduce callback must define exactly [] and [acc value] arities"
                                   f-form))))
                  callback* (desugar-expr (if named? (list 'fn-ref f-form) f-form))
                  coll* (desugar-result-expr :vector-i64 coll-form)
                  callback (synthetic "reduce_callback")
                  v (synthetic "reduce_v")
                  i (synthetic "reduce_i")
                  acc (synthetic "reduce_acc")]
              (desugar-expr
               (list 'let [callback callback* v coll*]
                     (list 'if (list '= (list 'vector-count v) 0)
                           (list (invoke-dispatcher-name 0) callback)
                           (list 'loop [i 1 acc (list 'vector-at v 0)]
                                 (list 'if (list '< i (list 'vector-count v))
                                       (list 'recur
                                             (list '+ i 1)
                                             (list (invoke-dispatcher-name 2) callback acc
                                                   (list 'vector-at v i)))
                                       acc))))))
            (let [[f-form init-form coll-form] args
                  ;; A parameter declared `[:list T]` is folded through
                  ;; `typed-list-nth`; every other collection is the
                  ;; vector-i64 fold below. The type is the one the function
                  ;; declared for that parameter (a wrong guess is refused
                  ;; later, by `typed-list-nth`'s own type check).
                  list-type (when (and (symbol? coll-form) (map? *local-types*))
                              (let [t (get *local-types* coll-form)]
                                (when (canonical-list-type? t) t)))
                  ;; a `:document` collection (a parameter, a `let` local, or
                  ;; the answer of a sequence head on one) is walked by index
                  ;; through `__kotoba_doc_nth`
                  document-coll? (and (nil? list-type) (guess-document-form? coll-form))
                  ;; A closed, pure unary map chain can be consumed directly by
                  ;; a pure primitive fold.  The ordinary eager map lowering
                  ;; remains the fallback for callbacks whose effects are not
                  ;; proven here, because interleaving an effectful mapper with
                  ;; a reducer would change the language's eager evaluation
                  ;; order.  `inc` and `dec` are total i64 arithmetic sugar, so
                  ;; composing them at the vector read is semantics-preserving.
                  map-chain
                  (when (and (nil? list-type)
                             (not document-coll?)
                             (symbol? f-form)
                             (not (contains? *lexical-bindings* f-form))
                             (contains? '#{+ - * bit-and bit-or bit-xor} f-form))
                    (loop [candidate coll-form callbacks []]
                      (if (and (seq? candidate)
                               (= 'map (first candidate))
                               (= 3 (count candidate))
                               (symbol? (second candidate))
                               (not (contains? *lexical-bindings* (second candidate)))
                               (contains? '#{inc dec} (second candidate)))
                        (recur (nth candidate 2) (conj callbacks (second candidate)))
                        (when (seq callbacks)
                          {:collection candidate
                           ;; We peel outermost first; values flow from the
                           ;; innermost map to the outermost map.
                           :callbacks (vec (reverse callbacks))}))))
                  init* (desugar-expr init-form)
                  coll* (if (or list-type document-coll?)
                          (desugar-expr coll-form)
                          (desugar-vector-i64-source
                           (if map-chain
                             (:collection map-chain)
                             coll-form)))
                  v (synthetic "reduce_v")
                  i (synthetic "reduce_i")
                  acc (synthetic "reduce_acc")
                  primitive? (and (symbol? f-form)
                                  (not (contains? *lexical-bindings* f-form))
                                  (contains? '#{+ - * bit-and bit-or bit-xor} f-form))
                  named? (top-level-function-symbol? f-form)
                  stored? (not (or primitive? named?
                                   (and (seq? f-form) (= 'fn (first f-form)))))
                  callback (when stored? (synthetic "reduce_callback"))
                  item (if (or list-type document-coll?)
                         (if document-coll?
                           (list doc-nth-helper-name v i)
                           (list 'typed-list-nth list-type v i))
                         (reduce (fn [value callback-name]
                                   (case callback-name
                                     inc (list '+ value 1)
                                     dec (list '- value 1)))
                                 (list 'vector-at v i)
                                 (:callbacks map-chain)))
                  step
                  (cond
                    primitive?
                    (list f-form acc item)

                    (and (seq? f-form) (= 'fn (first f-form)))
                    (let [[_ params & body] f-form]
                      ;; `single-expr` is the sentence's word for a NON-EMPTY
                      ;; body: several forms are one `do` (`implicit-do-body`).
                      ;; A parameter may be a destructuring pattern
                      ;; (`(fn [{:keys [a]} [i x]] ...)`): it is bound by the
                      ;; ordinary `let` destructuring below.
                      (when-not (and (vector? params) (= 2 (count params))
                                     (every? #(or (symbol? %) (vector? %) (map? %)) params)
                                     (not-any? #{'&} (tree-seq coll? seq params))
                                     (seq body))
                        (reject! "reduce fn must be (fn [acc x] single-expr)" f-form))
                      (let [[a b] params]
                        (list 'let [a acc
                                    b item]
                              (binding [*lexical-bindings*
                                        (into *lexical-bindings* (binding-symbols params))
                                        *abort-lexical-context* :fn]
                                (desugar-expr (implicit-do-body body))))))

                    ;; Named binary module function (fail-closed if unbound / wrong arity).
                    named?
                    (list f-form acc item)

                    :else
                    (list (invoke-dispatcher-name 2) callback acc item))]
              ;; Re-enter desugar so loop → __kotoba_loop_N under *pending-loop-helpers*.
              (binding [*loop-known-types* (cond-> {i :i64 v (cond list-type list-type
                                                                     document-coll? :document
                                                                     :else :vector-i64)}
                                             callback (assoc callback :i64))]
                (desugar-expr
                 (list 'let (vec (concat (when stored? [callback f-form]) [v coll*]))
                       (list 'loop [i 0 acc init*]
                             (list 'if (list '< i (list (if document-coll? 'document-count 'vector-count) v))
                                   (list 'recur (list '+ i 1) step)
                                   acc))))))))
        ;; Bounded eager map over one to five vector-i64 sources.  One/two
        ;; sources stay direct for stable KIR; three-to-five source handles
        ;; share one typed heterogeneous-vector state value, so synthesized
        ;; loop helpers stay inside the five-word ABI even with a callback.
        ;; mapv/filterv surface aliases: the T4.5 map/filter lowerings already
        ;; return eager bounded vector-i64 results, so mapv/filterv are pure
        ;; surface sugar — same lowering, same KIR CIDs, zero new backend work.
        ;; Arity is validated here first so the alias fails closed with its own
        ;; name in the diagnostic rather than delegating a wrong shape.
        mapv
        ;; A module may define `mapv` (stdlib.core walks pair chains under
        ;; that name). Steal the call only when this module did not.
        (if (contains? *function-arities* 'mapv)
          (apply list 'mapv (map desugar-expr args))
          (do (when-not (<= 2 (count args) 6)
                (reject! "mapv requires a callback and one to five vector-i64 collections" form))
              (desugar-expr (with-meta (cons 'map args) (meta form)))))
        filterv
        (if (contains? *function-arities* 'filterv)
          (apply list 'filterv (map desugar-expr args))
          (do (when-not (= 2 (count args))
                (reject! "filterv requires pred and one vector-i64 collection" form))
              (desugar-expr (with-meta (cons 'filter args) (meta form)))))
        ;; `into` (2-arity, vector destination) is a SURFACE ALIAS of the
        ;; already-qualified T4.5 reduce + vector-conj lowering (measured
        ;; 2026-09-07: the hand twin `(reduce (fn [acc x] (vector-conj acc x))
        ;; (vector-alloc 0) src)` check+compile PASSes with zero new backend
        ;; work), so `into` is pure surface sugar - same lowering, same KIR
        ;; CIDs. The alias is deliberately narrow: exactly 2 args, and only
        ;; when this module does not define `into` itself (the mapv lesson -
        ;; an undeclared alias must not steal a module's own name). Other
        ;; shapes (transducer 3-arity, non-vector destinations) fail closed
        ;; here with the alias's own name in the diagnostic.
        into
        (if (contains? *function-arities* 'into)
          (apply list 'into (map desugar-expr args))
          ;; The transducer 3-arity `(into to (xf f) src)` for the five
          ;; single-step transducers is rewritten to the 2-arity
          ;; `(into to (xf f src))` -- the same value, the same lowering,
          ;; no transducer machinery. Measured 2026-09-11 (adr-2609111900):
          ;; 7 of the compiler's own sources spell `into` this way, all with
          ;; map / filter / remove / keep / mapcat. A composed xform
          ;; (`(comp ...)`) or any other head stays refused by name.
          (let [args (if (and (= 3 (count args))
                              (seq? (second args))
                              (contains? '#{map filter remove keep mapcat} (first (second args)))
                              (= 2 (count (second args))))
                       [(first args) (list (first (second args)) (second (second args)) (nth args 2))]
                       args)]
            (when-not (= 2 (count args))
              (reject! (if (= 3 (count args))
                         "into with a transducer admits only (map f) (filter f) (remove f) (keep f) (mapcat f) as the middle argument"
                         "into requires a destination and one source in this subset")
                       form))
            (desugar-expr
             (with-meta
              (list* 'reduce (list 'fn '[acc x] (list 'vector-conj 'acc 'x)) args)
              (meta form)))))
        map
        (do
          (when-not (<= 2 (count args) 6)
            (reject! "map requires a callback and one to five vector-i64 collections" form))
          (let [[f-form & coll-forms] args
                n-colls (count coll-forms)
                top-level? (top-level-function-symbol? f-form)
                primitive? (and (= 1 n-colls)
                                (symbol? f-form)
                                (not (contains? *lexical-bindings* f-form))
                                (contains? '#{inc dec} f-form))
                inline? (and (seq? f-form) (= 'fn (first f-form)))
                stored? (not (or top-level? primitive? inline?))
                _ (when (and top-level?
                             (not (contains? (get *function-arities* f-form) n-colls)))
                    (reject! "named map callback does not support the source arity" f-form))
                ;; A stored callback is a closure VALUE: a parameter, a let
                ;; binding, `(fn-ref f)`, `(invoke ...)`, a call that returns
                ;; one. What is not a value of that kind is refused HERE, by
                ;; what it is. Measured 2026-09-11 (adr-2609111900): a keyword
                ;; `(map :a xs)` fell through to the dispatcher call and was
                ;; answered `unknown operation: __kotoba_invoke$arity1 is not
                ;; a builtin` -- a synthesized name the author never wrote,
                ;; for a shape the language has no value model for (a map
                ;; source is a vector-i64; its item is an i64, not a record).
                ;; `(partial f a)` / `(comp f g)` were answered `unbound
                ;; symbol has no value type: f` -- f IS a function of the
                ;; module; it is the head that is not a head of this language.
                _ (when stored?
                    (let [kind (cond (keyword? f-form) "keyword"
                                     (string? f-form) "string"
                                     (kotoba-integer? f-form) "integer"
                                     (boolean? f-form) "boolean"
                                     (nil? f-form) "nil"
                                     (vector? f-form) "vector"
                                     (map? f-form) "map"
                                     (set? f-form) "set")]
                      (when kind
                        (reject! (str "map callback must be a named function, an inline fn, "
                                      "or a closure value; got a " kind
                                      " literal -- a map source is a vector-i64 and its "
                                      "item is an i64, so no keyword or literal can map it")
                                 f-form)))
                    (when (and (seq? f-form)
                               (contains? '#{partial comp juxt complement} (first f-form))
                               (not (contains? *function-arities* (first f-form)))
                               (not (contains? *lexical-bindings* (first f-form))))
                      (reject! (str "map callback (" (first f-form) " ...) is not admitted: "
                                    (first f-form) " is not a head of this language; "
                                    "write the callback as (fn [x] ...)")
                               f-form)))
                inline-parts
                (when inline?
                  (let [[_ params & body] f-form]
                    ;; Each refusal names ITS cause. Until 2026-09-11 the five
                    ;; conditions below shared one sentence (`N-source map fn
                    ;; requires matching unique parameters and one
                    ;; expression`), and the 7 compiler sources it answered
                    ;; were all ONE site -- `(map (fn [[k v]] ...) x)` in
                    ;; kotoba.artifact.core/edn-safe, reached through
                    ;; `into`'s transducer rewrite -- which the sentence did
                    ;; not say. `vector?` is checked before anything counts
                    ;; PARAMS: a multi-arity `(fn ([x] ...))` puts a list
                    ;; there. The one-expression rule is the profile's
                    ;; (`lang/guest-grammar.edn :implicit-body-forms :refuses`
                    ;; holds `fn` and `defn`; explicit `do` is the spelling),
                    ;; so the sentence mirrors defn's. Destructuring is refused
                    ;; by what it would need: `[k v]` reads positions off the
                    ;; item, and the item of a vector-i64 source is an i64.
                    (when-not (vector? params)
                      (reject! (str "map fn requires a parameter vector; a multi-arity "
                                    "(fn ([x] ...) ...) is not a map callback")
                               f-form))
                    (when-not (= n-colls (count params))
                      (reject! (str n-colls "-source map fn requires " n-colls
                                    " parameter" (when-not (= 1 n-colls) "s")
                                    "; got " (count params))
                               f-form))
                    (when-not (every? symbol? params)
                      (reject! (str "map fn parameter destructures ("
                                    (pr-str (first (remove symbol? params)))
                                    "): the item of a vector-i64 source is an i64 and "
                                    "has no positions to bind; take a symbol and index "
                                    "a typed value inside the body")
                               f-form))
                    (when-not (= (count params) (count (distinct params)))
                      (reject! "map fn parameters must be unique" f-form))
                    (when (empty? body)
                      (reject! "map fn requires a body expression" f-form))
                    ;; Several forms are one `do` (`implicit-do-body`); until
                    ;; 2026-09-12 this site refused them `map fn must contain
                    ;; one result expression; explicit (do ...) is the spelling`.
                    [params (implicit-do-body body)]))
                _ (when (and stored? (> n-colls 4))
                    (reject! "stored map callbacks support at most four sources" f-form))
                packed? (> n-colls 2)
                source-type [:vector (vec (repeat n-colls :vector-i64))]
                source-values (mapv desugar-vector-i64-source coll-forms)
                sources (when packed? (synthetic "map_sources"))
                direct-sources (when-not packed?
                                 (mapv #(synthetic (str "map_source_" %))
                                       (range n-colls)))
                callback (when stored? (synthetic "map_callback"))
                i (synthetic "map_i")
                acc (synthetic "map_acc")
                source-at (fn [index]
                            (if packed?
                              (list 'hetero-vector-at source-type sources index)
                              (nth direct-sources index)))
                items (mapv (fn [index]
                              (list 'vector-at (source-at index) i))
                            (range n-colls))
                mapped
                (cond
                  (and primitive? (= 'inc f-form)) (list '+ (first items) 1)
                  (and primitive? (= 'dec f-form)) (list '- (first items) 1)
                  inline?
                  (let [[params body] inline-parts]
                    (list 'let (vec (mapcat vector params items))
                          (binding [*lexical-bindings*
                                    (into *lexical-bindings* params)
                                    *abort-lexical-context* :fn]
                            (desugar-expr body))))
                  top-level? (apply list f-form items)
                  ;; REQUEST the dispatcher, as `(g x)` and `(invoke g x)`
                  ;; do. Measured 2026-09-11 (adr-2609111900): `(defn f [g
                  ;; xs] (map g xs))` in a module with no lambda of arity 1
                  ;; was answered `unknown operation: __kotoba_invoke$arity1
                  ;; is not a builtin` -- `lambda-dispatchers` builds only
                  ;; the arities a local lambda or a request names, and this
                  ;; site named without requesting. `(defn f [g x] (g x))`
                  ;; in the same module compiled. A closure that arrives from
                  ;; a caller is the same value either way.
                  :else (apply list (request-invoke-dispatcher :i64 n-colls)
                               callback items))
                exhausted (apply list 'or
                                 (map-indexed
                                  (fn [index _]
                                    (list '>= i
                                          (list 'vector-count (source-at index))))
                                  coll-forms))
                source-bindings
                (if packed?
                  [sources (apply list 'hetero-vector source-type source-values)]
                  (vec (mapcat vector direct-sources source-values)))]
            (binding [*loop-result-type* :vector-i64
                      *loop-known-types*
                      (cond-> {i :i64 acc :vector-i64}
                        packed? (assoc sources source-type)
                        (not packed?) (into (map vector direct-sources
                                                 (repeat :vector-i64)))
                        callback (assoc callback :i64))]
              (desugar-expr
               (list 'let
                     (vec (concat (when stored? [callback f-form])
                                  source-bindings))
                     (list 'loop [i 0 acc (list 'vector-i64)]
                           (list 'if exhausted
                                 acc
                                 (list 'recur (list '+ i 1)
                                       (list 'vector-conj acc mapped)))))))))
        ;; map-indexed: (map-indexed f coll) over one vector-i64 source. The
        ;; callback takes the INDEX FIRST, then the item: (fn [i x] ...) --
        ;; the arity is fixed at two (never the source count, since there is
        ;; only ever one source). IMPLEMENTATION STATE, not a property:
        ;; nothing in lang/guest-grammar.edn / surface-status.edn refused an
        ;; index before this arm (adr-2609111900, the selfhost ceiling loop);
        ;; the wall measured at amu 10469db0 (225 sources) was stdlib
        ;; coverage -- 9 modules refused `unknown operation: map-indexed is
        ;; not a builtin, a sugar head, or a function of this module` (e.g.
        ;; multiformats base32.cljk) -- not a designed exclusion. Every
        ;; refusal below reuses `map`'s callback admission verbatim (adr-
        ;; 2609111900's map-callback-shapes split): the ONLY two differences
        ;; are the fixed arity and the one-parameter refusal, which names its
        ;; own cause instead of falling through to `map`'s "N-source ... got
        ;; 1" sentence, because a one-parameter (fn [x] ...) is the shape a
        ;; `map` callback author reaches for first.
        map-indexed
        ;; A module may define `map-indexed` itself (the into/mapv "do not
        ;; steal a module's own name" rule -- mapv-alias-shadowing-test).
        ;; Steal the call only when this module did not.
        (if (contains? *function-arities* 'map-indexed)
          (apply list 'map-indexed (map desugar-expr args))
          (do
            (when-not (= 2 (count args))
              (reject! "map-indexed requires a callback and one vector-i64 collection" form))
            (let [[f-form coll-form] args
                  top-level? (top-level-function-symbol? f-form)
                  inline? (and (seq? f-form) (= 'fn (first f-form)))
                  stored? (not (or top-level? inline?))
                  _ (when (and top-level?
                               (not (contains? (get *function-arities* f-form) 2)))
                      (reject! (str "named map-indexed callback does not support two parameters; "
                                    "map-indexed passes the index first: (fn [i x] ...)")
                               f-form))
                  ;; Reuse map's literal / not-a-head refusals verbatim.
                  _ (when stored?
                      (let [kind (cond (keyword? f-form) "keyword"
                                       (string? f-form) "string"
                                       (kotoba-integer? f-form) "integer"
                                       (boolean? f-form) "boolean"
                                       (nil? f-form) "nil"
                                       (vector? f-form) "vector"
                                       (map? f-form) "map"
                                       (set? f-form) "set")]
                        (when kind
                          (reject! (str "map-indexed callback must be a named function, an inline fn, "
                                        "or a closure value; got a " kind
                                        " literal -- a map-indexed source is a vector-i64 and its "
                                        "item is an i64, so no keyword or literal can map it")
                                   f-form)))
                      (when (and (seq? f-form)
                                 (contains? '#{partial comp juxt complement} (first f-form))
                                 (not (contains? *function-arities* (first f-form)))
                                 (not (contains? *lexical-bindings* (first f-form))))
                        (reject! (str "map-indexed callback (" (first f-form) " ...) is not admitted: "
                                      (first f-form) " is not a head of this language; "
                                      "write the callback as (fn [i x] ...)")
                                 f-form)))
                  inline-parts
                  (when inline?
                    (let [[_ params & body] f-form]
                      (when-not (vector? params)
                        (reject! (str "map-indexed fn requires a parameter vector; a multi-arity "
                                      "(fn ([i x] ...) ...) is not a map-indexed callback")
                                 f-form))
                      ;; The one-parameter shape is refused BY NAME, first:
                      ;; it is the shape a `map` callback author reaches for,
                      ;; and the generic count sentence below would not say
                      ;; why two are required.
                      (when (= 1 (count params))
                        (reject! (str "map-indexed fn requires 2 parameters; got 1 -- "
                                      "map-indexed passes the index first: (fn [i x] ...), not (fn [x] ...)")
                                 f-form))
                      (when-not (= 2 (count params))
                        (reject! (str "map-indexed fn requires 2 parameters (index, item); got "
                                      (count params))
                                 f-form))
                      (when-not (every? symbol? params)
                        (reject! (str "map-indexed fn parameter destructures ("
                                      (pr-str (first (remove symbol? params)))
                                      "): the index and the item of a vector-i64 source are i64 and "
                                      "have no positions to bind; take symbols and index "
                                      "a typed value inside the body")
                                 f-form))
                      (when-not (= (count params) (count (distinct params)))
                        (reject! "map-indexed fn parameters must be unique" f-form))
                      (when (empty? body)
                        (reject! "map-indexed fn requires a body expression" f-form))
                      ;; Several forms are one `do`, as at `map`'s site.
                      [params (implicit-do-body body)]))
                  coll* (desugar-vector-i64-source coll-form)
                  v (synthetic "mapindexed_v")
                  i (synthetic "mapindexed_i")
                  acc (synthetic "mapindexed_acc")
                  x (synthetic "mapindexed_x")
                  callback (when stored? (synthetic "mapindexed_callback"))
                  mapped
                  (cond
                    inline?
                    (let [[params body] inline-parts
                          [i-param x-param] params]
                      (list 'let [i-param i x-param x]
                            (binding [*lexical-bindings*
                                      (into *lexical-bindings* params)
                                      *abort-lexical-context* :fn]
                              (desugar-expr body))))
                    top-level? (list f-form i x)
                    ;; REQUEST the dispatcher, exactly as `map`'s stored
                    ;; callback path does (adr-2609111900).
                    :else (apply list (request-invoke-dispatcher :i64 2) callback [i x]))]
              (binding [*loop-result-type* :vector-i64
                        *loop-known-types* (cond-> {i :i64 acc :vector-i64 v :vector-i64}
                                             callback (assoc callback :i64))]
                (desugar-expr
                 (list 'let (vec (concat (when stored? [callback f-form]) [v coll*]))
                       (list 'loop [i 0 acc (list 'vector-i64)]
                             (list 'if (list '< i (list 'vector-count v))
                                   (list 'let [x (list 'vector-at v i)]
                                         (list 'recur (list '+ i 1)
                                               (list 'vector-conj acc mapped)))
                                   acc))))))))
        ;; T4.5: bounded filter over vector-i64 → zero-charge loop + vector-conj.
        ;; (filter (fn [x] pred) coll) or (filter named-pred coll).
        ;;
        ;; `remove` is Clojure's `(filter (complement pred) coll)` and lowers
        ;; to exactly this loop with the predicate's result negated: every
        ;; predicate shape filter admits (inline fn, named function, stored
        ;; callback bound once ahead of the source), no new KIR head, no
        ;; backend work. Until 2026-09-25 it was `unknown operation: remove
        ;; is not a builtin` (aiueos desktop floor :browser-component, wall
        ;; 7). A module defining its own `remove` keeps it (the guard above).
        (filter remove)
        (do
          (when-not (= 2 (count args))
            (reject! (str op " requires pred and one vector-i64 collection") form))
          (let [[p-form coll-form] args
                coll* (desugar-vector-i64-source coll-form)
                v (synthetic "filter_v")
                i (synthetic "filter_i")
                acc (synthetic "filter_acc")
                x (synthetic "filter_x")
                named? (top-level-function-symbol? p-form)
                stored? (not (or named?
                                 (and (seq? p-form) (= 'fn (first p-form)))))
                callback (when stored? (synthetic "filter_callback"))
                pred-body
                (cond
                  (and (seq? p-form) (= 'fn (first p-form)))
                  (let [[_ params & body] p-form]
                    ;; `single-expr` is the sentence's word for a NON-EMPTY
                    ;; body: several forms are one `do` (`implicit-do-body`).
                    (when-not (and (vector? params) (= 1 (count params))
                                   (every? symbol? params)
                                   (seq body))
                      (reject! (str op " pred must be (fn [x] single-expr)") p-form))
                    (let [[px] params]
                      ;; Bind user param to element; desugar body in that scope.
                      (list 'let [px x]
                            (binding [*lexical-bindings*
                                      (into *lexical-bindings* params)
                                      *abort-lexical-context* :fn]
                              (desugar-expr (implicit-do-body body))))))

                  named?
                  (list p-form x)

                  :else
                  (list (invoke-dispatcher-name :bool 1) callback x))]
            (binding [*loop-result-type* :vector-i64
                      *loop-known-types* (cond-> {i :i64 acc :vector-i64 v :vector-i64}
                                           callback (assoc callback :i64))]
              (desugar-expr
               (list 'let (vec (concat (when stored? [callback p-form]) [v coll*]))
                     (list 'loop [i 0 acc (list 'vector-i64)]
                           (list 'if (list '< i (list 'vector-count v))
                                 (list 'let [x (list 'vector-at v i)]
                                       (list 'recur (list '+ i 1)
                                             (list 'if (if (= op 'remove)
                                                         (list 'not pred-body)
                                                         pred-body)
                                                   (list 'vector-conj acc x)
                                                   acc)))
                                 acc)))))))
        ;; W1: friendly namespaced ops elaborate before validation sees them.
        (if-let [kw (capability-keyword-for-symbol op)]
          (elaborate-named-operation form op kw args)
          (if (and (symbol? op) (namespace op))
            (if (= "clojure.core" (namespace op))
              ;; `clojure.core/merge` is the same head as `merge`, spelled
              ;; fully to dodge a local of the same name -- 17 of the
              ;; compiler's dependency sources (coll.cljk) do this. The
              ;; prefix names no module Kotoba has; strip it and let the
              ;; bare head be admitted or refused on its own terms
              ;; (measured 2026-09-11, adr-2609111900).
              (desugar-expr (with-meta (cons (symbol (name op)) args) (meta form)))
            (do
              ;; Reader-tagged host literals arrive here first (desugar runs
              ;; before validation); a SELECTED one is refused by name.
              (refuse-reader-tagged-host-literal! form op)
              (reject! (str "named operation " (pr-str op)
                            " is not a registered capability")
                       form)))
            (desugar-ordinary-call op args)))))))))

;; the arguments of a call of a module function, in order; each `fn` (or `fn-ref`) written in a contract-typed parameter position is lifted under
;; that contract (`*function-callable-param-contracts*`: only a contract naming a non-i64 parameter type reaches the argument)
#?(:kotoba
   (defn desugar-call-args [env [:ref :fe/env] contracts [:ref :form/r] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [contract (form/form-get contracts (form/int-form (- i 1)))
             a (if (and (not (form/is-nil? contract)) (contract-typed-params? (callable-clauses contract) 0))
                 (desugar-under-contract env contract (form/nth-of form i))
                 (desugar-expr env (form/nth-of form i)))]
         (desugar-call-args (dr-env a) contracts form (+ i 1) (form/append-form acc (dr-form a))))))
   :default nil)

;; `(op args...)` of a module function: the arguments desugared in order, under the parameter contracts of the module function
#?(:kotoba
   (defn desugar-ordinary-call [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [contracts (form/form-get (env-con env :params) (form/vec2 op (form/int-form (argc form))))
           r (desugar-call-args env contracts form 1 (form/no-forms))]
       (dr (drs-env r) (head-call op (drs-forms r)))))
   :default
(defn desugar-ordinary-call
  "`(op args...)` for a head that is neither sugar nor a capability: the
  arguments desugared in order, each `fn` (or `fn-ref`) argument written in
  a contract-typed parameter position of a module function lifted under
  that contract (`*function-callable-param-contracts*`). Every other
  argument, and every argument of a call with no such contract, desugars
  exactly as before."
  [op args]
  (let [contracts (get *function-callable-param-contracts* [op (count args)])
        ;; Only a contract that names a non-i64 parameter type reaches the
        ;; argument: an all-i64 contract lowers its `fn` argument exactly as
        ;; it did before typed parameters (result inferred from the body, a
        ;; family mismatch trapping closed at the dispatcher), so an i64
        ;; program keeps its HIR and its CIDs.
        contracts (into {}
                        (filter (fn [[_ contract]]
                                  (or (callable-effect-row contract)
                                      (first-truthy (fn [[parameter-types result-type]]
                                              (or (callable-type? result-type)
                                                  (not (i64-parameter-types? parameter-types))))
                                            (callable-clauses contract)))))
                        contracts)]
    (apply list op
           (if (seq contracts)
             (map-indexed (fn [index argument]
                            (if-let [contract (get contracts index)]
                              (do
                                (require-rowed-callable-argument! contract argument)
                                (binding [*expected-callable-contract* contract]
                                  (desugar-expr argument)))
                              (desugar-expr argument)))
                          args)
             (map desugar-expr args))))))

#?(:kotoba nil :default (def i64-answer-predicates tables/i64-answer-predicates))

#?(:kotoba nil :default (defn bool-predicate-answer
  "Wraps a desugared 0/1 predicate operation as `(= op 1)`, exactly once.
  The head symbol is marked (`::i64-answer`): symbol meta is what survives the
  later passes, and a form whose source head already carries the mark is a
  re-desugar of an elaborated operand, which is marked again, not re-wrapped."
  [form result]
  (if (and (seq? result) (contains? i64-answer-predicates (first result)))
    (let [marked (apply list (vary-meta (first result) assoc ::i64-answer true)
                        (rest result))]
      (if (and (seq? form) (symbol? (first form))
               (::i64-answer (meta (first form))))
        marked
        (list '= marked 1)))
    result)))

;; The Kotoba reading of `bool-predicate-answer` (agent F64, 2026-10-04). A Form has no metadata, so the
;; `::i64-answer` mark on the head symbol is a span no reader produces (line -1, column 0): the passes carry
;; a head symbol by value, so the mark survives exactly as the host's symbol meta does.
#?(:kotoba
   (defn i64-answer-mark [] :i64 -4294967296)
   :default nil)

#?(:kotoba
   (defn i64-answer-head? [f [:ref :form/r]] :bool
     (and (form/is-seq? f) (> (form/count-of f) 0) (form/is-symbol? (form/nth-of f 0))
          (tables/i64-answer-predicates-has? (form/nth-of f 0))))
   :default nil)

#?(:kotoba
   (defn bool-predicate-answer [form [:ref :form/r] result [:ref :form/r]] [:ref :form/r]
     (if (i64-answer-head? result)
       (let [head (form/nth-of result 0)
             marked (form/form-seq (form/cons-onto (record-assoc [:ref :form/r] head :span (i64-answer-mark))
                                                   (form/rest-list result)))]
         (if (and (form/is-seq? form) (> (form/count-of form) 0) (form/is-symbol? (form/nth-of form 0))
                  (= (form/span-of (form/nth-of form 0)) (i64-answer-mark)))
           marked
           (form/form-seq (form/cons-onto (form/symbol-form "=")
                                          (form/cons-onto marked (form/cons-onto (form/int-form 1) (form/no-forms)))))))
       result))
   :default nil)

#?(:kotoba
   (defn desugar-expr [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [ctx (env-result env)
           r (desugar-expr* (with-result env (form/nil-form)) form ctx)]
       (dr (with-result (dr-env r) ctx) (bool-predicate-answer form (dr-form r)))))
   :default
(defn desugar-expr [form]
  ;; The one chokepoint every desugared node passes through, and therefore the
  ;; only place a host error escaping ANY branch of the lowering table can be
  ;; named. The innermost frame wraps first, so the operation reported is the
  ;; one that actually broke; outer frames see `:phase :internal` and rethrow
  ;; untouched (`internal-failure!`).
  (let [contextual-result-type *contextual-closure-result-type*
        result (binding [*contextual-closure-result-type* nil]
                 (try (desugar-expr* form contextual-result-type)
                      (catch #?(:clj Throwable :cljs :default) error
                        (internal-failure! error form))))
        ;; Display-only: when the lowering table renamed the head
        ;; (`string-length` -> `string-byte-length`), remember the name the
        ;; source wrote on the NEW head symbol. List meta does not survive the
        ;; later passes (they rebuild with `cons`/`list`); a head symbol is
        ;; carried through by value and keeps its meta. Read by
        ;; `use-site-text` so a diagnostic can show the operation as written;
        ;; nothing else looks at it, and symbol equality ignores meta.
        result (if (and (seq? form) (symbol? (first form))
                        (seq? result) (symbol? (first result))
                        (not= (first form) (first result))
                        (not (:kotoba.diag/source-head (meta (first result)))))
                 (with-meta (apply list (vary-meta (first result) assoc
                                                   :kotoba.diag/source-head (first form))
                                   (rest result))
                   (meta result))
                 result)
        result (bool-predicate-answer form result)
        location (select-keys (meta form)
                              [:line :column :end-line :end-column :offset :end-offset])]
    (if (and (seq location) (or (coll? result) (symbol? result)))
      (with-meta result (merge (meta result) location))
      result))))


;; --- main-only preservation forms (a7ef280 monolith), host twins only ---
;; These 18 forms are preserved from the monolith verbatim (feature wiring is
;; absent in the split -- see PR notes: typed twins and wiring are follow-ups).
;; 13 remain here; the 5 of the list-note cluster (*list-item-notes*,
;; *module-list-fields*, *module-list-inferred*, list-field-read-key,
;; note-list-item-type!) moved to infer.cljk (M11).

#?(:kotoba nil :default (def ^:dynamic *module-absent-fields* {}))

#?(:kotoba nil :default (defn- absent-field-spelled-type
  "The type ONE value written at a key spells on its own, for
  `module-absent-fields`, or `nil` when it spells none: `nil` itself, an
  expression only inference can type, and a keyword literal whose values
  spell nothing (it lowers to the legacy pair map, `:map`, and is typed
  against T where it is written instead). A literal that refuses on its own
  contributes nothing here; it refuses where it is desugared."
  [form]
  (when (some? form)
    (let [t (try (binding [*module-absent-fields* {}]
                   (map-literal-record-field-type form))
                 (catch #?(:clj Throwable :cljs :default) error
                   (if (compiler-rejection? error) nil (throw error))))]
      (when (and (some? t) (not= :map t)) t)))))

#?(:kotoba nil :default (defn module-absent-fields
  "`*module-absent-fields*` for one module's source forms: every keyword key
  written with a `nil` value -- a keyword-keyed map literal entry or an
  `assoc` pair -- with the types every non-nil value written at that key
  spells (`absent-field-spelled-type`), compared with `=`, never hashed."
  [forms]
  (let [writes (volatile! [])
        note! (fn [k v] (when (keyword? k) (vswap! writes conj [k v])))
        walk (fn walk [form]
               (cond
                 (map? form)
                 (do (when (every? keyword? (keys form))
                       (doseq [[k v] form] (note! k v)))
                     (doseq [[k v] form] (walk k) (walk v)))
                 (seq? form)
                 (do (when (and (= 'assoc (first form))
                                (>= (count form) 4) (even? (count form)))
                       (doseq [[k v] (partition 2 (drop 2 form))] (note! k v)))
                     (doseq [x form] (walk x)))
                 (coll? form) (doseq [x form] (walk x))
                 :else nil))]
    (doseq [form forms] (walk form))
    (let [absent (reduce (fn [acc [k v]] (if (nil? v) (conj acc k) acc)) #{} @writes)]
      (reduce (fn [acc [k v]]
                (if-let [t (when (contains? absent k) (absent-field-spelled-type v))]
                  (let [[known] (get-in acc [:conflicts k])
                        known (or known (second (get-in acc [:fields k])))]
                    (cond
                      (nil? known) (assoc-in acc [:fields k] [:option t])
                      (= known t) acc
                      (contains? (:conflicts acc) k) acc
                      :else (-> acc
                                (update :fields dissoc k)
                                (assoc-in [:conflicts k] [known t]))))
                  acc))
              {:fields {} :conflicts {}}
              @writes)))))

#?(:kotoba nil :default (defn- reject-absent-field-conflict!
  "A key the module writes `nil` at and two values of two types: which one is
  the absent field's T is not this compiler's guess to make."
  [k form]
  (when-let [[t u] (get-in *module-absent-fields* [:conflicts k])]
    (reject! (str "field " (map-literal-key-description-for-message k)
                  " is nil in this module, which makes it an absent [:option T], "
                  "and this module writes two types at it: "
                  (map-literal-type-description t) " and "
                  (map-literal-type-description u)
                  "; an absent field holds one type when it is present")
             form :kotoba.error/map-literal-value))))

#?(:kotoba nil :default (defn- absent-field-type
  "The `[:option T]` the module's source says key `k` is, or `nil`."
  [k]
  (get-in *module-absent-fields* [:fields k])))

#?(:kotoba nil :default (defn module-list-fields
  "`*module-list-fields*` for one module's source forms (floor
  :empty-vector-field): every keyword key written `[]`, with the item types
  the module's `conj`s and vector literals at that key spell
  (`absent-field-spelled-type`), compared with `=`, never hashed."
  [forms]
  (let [empties (volatile! #{})
        items (volatile! [])
        literal-i64 (volatile! #{})
        record-lists (volatile! #{})
        note-item! (fn [k x]
                     (vswap! items conj [k x])
                     (when (integer? x) (vswap! literal-i64 conj k)))
        note! (fn [k v]
                (when (keyword? k)
                  (when (vector? v)
                    (if (empty? v)
                      (vswap! empties conj k)
                      (do (when (some #(and (map? %) (seq %) (every? keyword? (keys %))) v)
                            (vswap! record-lists conj k))
                          (doseq [x v] (note-item! k x)))))))
        walk (fn walk [form]
               (cond
                 (map? form)
                 (do (when (every? keyword? (keys form))
                       (doseq [[k v] form] (note! k v)))
                     (doseq [[k v] form] (walk k) (walk v)))
                 (seq? form)
                 (do (when (and (= 'assoc (first form))
                                (>= (count form) 4) (even? (count form)))
                       (doseq [[k v] (partition 2 (drop 2 form))] (note! k v)))
                     (when (and (= 'update (first form)) (>= (count form) 5)
                                (keyword? (nth form 2)) (= 'conj (nth form 3)))
                       (doseq [x (drop 4 form)] (note-item! (nth form 2) x)))
                     (doseq [x form] (walk x)))
                 (coll? form) (doseq [x form] (walk x))
                 :else nil))]
    (doseq [form forms] (walk form))
    (let [types (reduce (fn [acc [k x]]
                          (if-let [t (when (contains? @empties k) (absent-field-spelled-type x))]
                            (update acc k (fn [ts] (if (some #(= t %) ts) ts (conj (or ts []) t))))
                            acc))
                        {} @items)
          spelled (reduce-kv (fn [acc k ts]
                               (cond
                                 (< 1 (count ts)) (assoc-in acc [:conflicts k] (vec (take 2 ts)))
                                 (= :i64 (first ts)) acc
                                 :else (assoc-in acc [:fields k] [:list (first ts)])))
                             {:fields {} :conflicts {}}
                             types)
          open (into #{} (remove #(or (contains? (:fields spelled) %)
                                      (contains? (:conflicts spelled) %)))
                     @empties)]
      ;; floor :list-item-from-expression: an open key's inferred types.
      (reduce-kv (fn [acc k ts]
                   (if-not (contains? open k)
                     acc
                     (let [ts (cond->> (vec (distinct ts))
                                (contains? @literal-i64 k) (into [:i64]))]
                       (cond
                         (< 1 (count ts)) (assoc-in acc [:conflicts k] (vec (take 2 ts)))
                         (= :i64 (first ts)) acc
                         :else (assoc-in acc [:fields k] [:list (first ts)])))))
                 (assoc spelled
                        :open open
                        :record-lists @record-lists
                        ;; floor :record-list-field-literal: a record-lists key
                        ;; holds the R its literal types, noted beside every
                        ;; type the module conj's there; a second type is the
                        ;; conflict.
                        :record-conflicts
                        (into {}
                              (keep (fn [k]
                                      (let [ts (distinct (get *module-list-inferred* k))]
                                        (when (< 1 (count ts)) [k (vec (take 2 ts))]))))
                              @record-lists))
                 *module-list-inferred*)))))

;; list-field-read-key and note-list-item-type! moved to infer.cljk (M11):
;; record-projection's `conj` arms call note-list-item-type!, and
;; record-projection cannot require desugar (desugar requires it).

#?(:kotoba nil :default (defn- reject-list-field-conflict!
  "A key the module writes `[]` at and conj's items of two types at: which one
  the list holds is not this compiler's guess to make."
  [k form]
  (when-let [[t u] (get-in *module-list-fields* [:conflicts k])]
    (reject! (str "field " (map-literal-key-description-for-message k)
                  " is [] in this module, which makes it a list of what the module "
                  "conj's at it, and this module conj's two types at it: "
                  (map-literal-type-description t) " and "
                  (map-literal-type-description u)
                  "; a list holds one type")
             form :kotoba.error/map-literal-value))
  (when-let [[t u] (get-in *module-list-fields* [:record-conflicts k])]
    (reject! (str "field " (map-literal-key-description-for-message k)
                  " holds a vector of " (map-literal-type-description t)
                  " in this module, which makes it a list of that record, and this module conj's "
                  (map-literal-type-description u)
                  " at it; a list holds one type")
             form :kotoba.error/map-literal-value))))

#?(:kotoba nil :default (defn- list-field-type
  "The `[:list R]` the module's source says key `k` is, or `nil`."
  [k]
  (get-in *module-list-fields* [:fields k])))

#?(:kotoba nil :default (defn- desugar-absent-field-value
  "A value written at an absent field of type `option-type`: `nil` is its
  none; a value whose type the source spells, and a map or vector literal
  (typed against T, as a record field's literal is), is its some. Anything
  else is an expression already of some type, checked against the option as
  written -- a present T from a call is not wrapped (no coercion)."
  [option-type form]
  (let [t (second option-type)]
    (cond
      (nil? form) (list 'option-none-of option-type)
      (and (map? form) (record-type? t))
      (list 'option-some-of option-type (desugar-map form t))
      (or (map? form) (vector? form) (some? (map-literal-value-type form)))
      (list 'option-some-of option-type (desugar-expected-value t form))
      :else (desugar-expected-value option-type form)))))

#?(:kotoba nil :default (defn- desugar-update
  "`(update m k f x ..)` as `(assoc m k (f (k m) x ..))`, the map named once.
  A keyword key reads with `(k m)`, any other with `(get m k)`. A `fn` literal
  with one parameter vector of the call's arity is applied as a `let` -- its
  parameters bound to the read value and the extra arguments in order -- so a
  destructuring parameter means what it means in `let`; any other function is
  called as it would be written."
  [args form]
  (when (< (count args) 3)
    (reject! "update requires a map, a key and a function: (update m k f x ..)"
             form :kotoba.error/update-arity))
  (let [[target k f & extra] args
        bound (if (simple-symbol? target) target (synthetic "update_target"))
        read (if (keyword? k) (list k bound) (list 'get bound k))
        fn-parts (when (and (seq? f) (= 'fn (first f)))
                   (let [parts (rest f)
                         parts (if (simple-symbol? (first parts)) (rest parts) parts)]
                     (when (vector? (first parts)) parts)))
        params (first fn-parts)
        applied (if (and params
                         (= (count params) (inc (count extra)))
                         (not-any? #{'&} params)
                         (seq (rest fn-parts)))
                  (list* 'let (vec (interleave params (cons read extra)))
                         (rest fn-parts))
                  (list* f read extra))
        written (list 'assoc bound k applied)]
    (desugar-expr (if (= bound target)
                    written
                    (list 'let [bound target] written))))))

#?(:kotoba nil :default (defn- sequence-first-chain
  "The filter / remove / reverse chain `first` is asked of, outermost step
  first, or nil when the operand is not one (or a step is a module's own
  function, or has another arity)."
  [form]
  (loop [form form steps []]
    (let [head (when (seq? form) (first form))]
      (cond
        (and (= 'reverse head) (= 2 (count form))
             (not (contains? *function-arities* 'reverse)))
        (recur (second form) (conj steps [:reverse]))

        (and (contains? '#{filter remove} head) (= 3 (count form))
             (not (contains? *function-arities* head)))
        (recur (nth form 2) (conj steps [head (second form)]))

        (seq steps) {:source form :steps steps}
        :else nil)))))

#?(:kotoba nil :default (defn- desugar-sequence-first
  [{:keys [source steps]}]
  (let [items (synthetic "seq_v")
        i (synthetic "seq_i")
        x (synthetic "seq_x")
        backward? (odd? (count (filter #(= :reverse (first %)) steps)))
        tests (for [[op p-form] (reverse steps)
                    :when (not= :reverse op)]
                (let [named? (top-level-function-symbol? p-form)
                      inline? (and (seq? p-form) (= 'fn (first p-form)))
                      callback (when-not (or named? inline?) (synthetic "seq_callback"))
                      test (cond
                             inline?
                             (let [[_ params & body] p-form]
                               (when-not (and (vector? params) (= 1 (count params))
                                              (every? symbol? params)
                                              (seq body))
                                 (reject! (str op " pred must be (fn [x] single-expr)") p-form))
                               (list 'let [(first params) x]
                                     (binding [*lexical-bindings* (into *lexical-bindings* params)
                                               *abort-lexical-context* :fn]
                                       (desugar-expr (implicit-do-body body)))))
                             named? (list p-form x)
                             :else (list (invoke-dispatcher-name :bool 1) callback x))]
                  {:callback callback :p-form p-form
                   :test (if (= 'remove op) (list 'not test) test)}))
        callbacks (filter :callback tests)
        index (if backward? (list '- (list '- (list 'count items) 1) i) i)
        found (list '__kotoba_seq_found items x)
        absent (list '__kotoba_seq_absent items)
        search (if (seq tests)
                 (list 'loop [i 0]
                       (list 'if (list '< i (list 'count items))
                             (list 'let [x (list 'nth items index)]
                                   (list 'if (if (next tests)
                                               (cons 'and (map :test tests))
                                               (:test (first tests)))
                                         found
                                         (list 'recur (list '+ i 1))))
                             absent))
                 (list 'if (list '< 0 (list 'count items))
                       (list 'let [x (list 'nth items (if backward?
                                                       (list '- (list 'count items) 1)
                                                       0))]
                             found)
                       absent))]
    (binding [*loop-known-types* (into {i :i64} (map (fn [t] [(:callback t) :i64])) callbacks)]
      (desugar-expr
       (list 'let (vec (concat (mapcat (juxt :callback :p-form) callbacks) [items source]))
             search))))))

#?(:kotoba nil :default (defn- require-rowed-callable-argument!
  "A `[:fn ...]` parameter that declares an effect row is given a closure
  whose row is known to be that one: a `fn` / `fn-ref` written there, lifted
  under the contract and checked against its row, or a value of exactly that
  type. Anything else is a closure of unknown row -- a let-bound `fn` lifted
  under no contract -- and is refused by name rather than trapping closed at
  the row's dispatcher."
  [contract argument]
  (when (callable-effect-row contract)
    (when-not (or (and (seq? argument) (contains? '#{fn fn-ref} (first argument)))
                  (= contract (expression-callable-contract argument)))
      (reject! (str "a [:fn ...] parameter declaring the effect row "
                    (pr-str (:effects (peek contract)))
                    " takes a fn literal or a value of that same type; the row of this closure is not known (ADR 0353)")
               argument :kotoba.error/callable-effect-row)))))
