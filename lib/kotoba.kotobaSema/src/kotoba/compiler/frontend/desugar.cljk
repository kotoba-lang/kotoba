#?(:kotoba nil :default (defn map-literal-record-field-type
  "The field type ONE value of a keyword-keyed literal determines on its own,
  or `nil` for an expression whose type only inference can know.

  This is `map-literal-value-type` plus the two literal shapes a config map
  actually nests -- a vector literal (through `closed-vector-literal-type`,
  the same reading a bare vector gets) and a map literal (through the type
  the nested literal itself lowers to)."
  [form]
  (cond
    (map? form) (map-literal-lowered-type form)
    (vector? form) (closed-vector-literal-type form)
    :else (map-literal-value-type form))))

