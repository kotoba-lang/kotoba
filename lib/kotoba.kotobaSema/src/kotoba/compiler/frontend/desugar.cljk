  (let [typed (vec (keep (fn [dd__289620_1]
                           (let [k (fe-nth dd__289620_1 0) v (fe-nth dd__289620_1 1)]
                             (when-let [t (map-literal-value-type v)] [k t])))
                         entries))
        floating (first #?(:kotoba (let [fe-lc__293635 (form/kids-of typed) fe-ln__293635 (vector-count fe-lc__293635)] (form/form-seq (loop [fe-li__293635 0 fe-la__293635 (form/no-forms)] (if (>= fe-li__293635 fe-ln__293635) fe-la__293635 (let [dd__289775_1 (typed-list-nth [:list [:ref :form/r]] fe-lc__293635 fe-li__293635)] (recur (+ fe-li__293635 1) (if (do (let [t (fe-nth dd__289775_1 1)] (contains? #{:f32 :f64} t))) (form/append-form fe-la__293635 dd__289775_1) fe-la__293635))))))) :default (filter (fn [dd__289775_1] (let [t (fe-nth dd__289775_1 1)] (contains? #{:f32 :f64} t))) typed)))]
    (when floating
      (let [k (fe-nth floating 0) t (fe-nth floating 1)]
        (reject! (str "map literal value at key "
                      (map-literal-key-description-for-message k)
                      " is a floating point literal: map value type " t
                      " is outside the structured scalar ABI. This is the "
                      "ABI's refusal and not the floating-key one -- a value "
                      "needs neither a total order nor a decidable identity, "
                      "and is refused because the typed map's value slot has "
                      "no floating encoding")
                 entries :kotoba.error/floating-map-kv)))
    (if-let [[first-key first-type] (first typed)]
      ;; `=` rather than `distinct`: a value type may be a descriptor
      ;; vector, and hashing is not something both runtimes agree on for
      ;; every literal shape (`run-tests.cljk` records the `desugar-case`
      ;; bigint hashing defect that taught this).
      (if-let [[other-key other-type]
               (first (remove (fn [dd__290862_1] (let [t (fe-nth dd__290862_1 1)] (= t first-type))) (rest typed)))]
        #?(:kotoba (throw (fe-error (str "map literal values must all be one type; the value "
                      "at key "
                      (map-literal-key-description-for-message first-key)
                      " is " (map-literal-type-description first-type)
                      " and the value at key "
                      (map-literal-key-description-for-message other-key)
                      " is " (map-literal-type-description other-type)) "kotoba.error/map-literal-value" entries)) :default (reject! (str "map literal values must all be one type; the value "
                      "at key "
                      (map-literal-key-description-for-message first-key)
                      " is " (map-literal-type-description first-type)
                      " and the value at key "
                      (map-literal-key-description-for-message other-key)
                      " is " (map-literal-type-description other-type))
                 entries :kotoba.error/map-literal-value))
        first-type)
