           #?(:kotoba (let [fe-lc__301829 (form/kids-of fields) fe-ln__301829 (vector-count fe-lc__301829)] (form/form-seq (loop [fe-li__301829 0 fe-la__301829 (form/no-forms)] (if (>= fe-li__301829 fe-ln__301829) fe-la__301829 (recur (+ fe-li__301829 1) (form/append-form fe-la__301829 (let [dd__296784_1 (typed-list-nth [:list [:ref :form/r]] fe-lc__301829 fe-li__301829)] (let [field (fe-nth dd__296784_1 0) field-type (fe-nth dd__296784_1 1)]
                    (let [value (get form field ::absent)]
