#?(:kotoba nil :default (defn map-literal-lowered-type
  "The type a map literal will lower to, read off its source alone -- what a
  NESTED literal contributes as a record field type. `nil` when the key set
  is not one admitted kind; the nested literal's own `desugar-map` then
  refuses it by name, and this function never has to say it twice."
  [form]
  (let [kinds (into #{} (map map-literal-key-kind) (keys form))
        kind (or (first kinds) :keyword)]
    (when (and (not (contains? kinds nil)) (<= (count kinds) 1))
      (let [entries (sort-by key (map-literal-key-order kind) form)]
        (if (= :keyword kind)
          (if-let [fields (keyword-map-literal-record-fields form entries)]
            (map-literal-record-type fields)
            :map)
          [:map kind (map-literal-item-type kind entries)]))))))

