    (when (first-truthy (fn [dd__294312_1] (let [t (fe-nth dd__294312_1 1)] (and (some? t) (not= :i64 t)))) typed)
      (let [_ #?(:kotoba (require-k (not (> (count entries) max-record-fields)) (str "map literal with keyword keys and a non-i64 value lowers "
                      "to a closed record and exceeds the record field limit: "
                      (count entries) " entries, at most " max-record-fields) "kotoba.error/map-literal-value" form) :default (when (> (count entries) max-record-fields)
        (reject! (str "map literal with keyword keys and a non-i64 value lowers "
