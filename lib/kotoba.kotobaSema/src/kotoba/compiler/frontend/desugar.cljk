   (defn str-integer-form? [env [:ref :fe/env] part [:ref :form/r]] :bool
     (or (form/is-int? part)
         (and (form/is-symbol? part) (form/is-map? (env-types env))
              (form/eq (form/form-get (env-types env) part) (form/keyword-form :i64)))
         (and (form/is-seq? part) (> (form/count-of part) 0)
              (tables/table-has? (env-table env :str-int) (form/nth-of part 0)))))
   :default
(defn str-integer-form?
  "Is PART certainly an i64 without a type inference: an integer literal, a
  parameter or `let` local known as :i64, or an arithmetic form."
  [part]
  (boolean (or (kotoba-integer? part)
               (and (symbol? part) (= :i64 (get *local-types* part)))
               (and (seq? part) (contains? str-integer-heads (first part)))))))

#?(:kotoba
   (defn str-part [env [:ref :fe/env] part [:ref :form/r]] [:ref :fe/dr]
     (if (str-integer-form? env part)
       (let [a (desugar-expr env part)]
         (dr (dr-env a) (form/call1 "__kotoba_string_from_i64" (dr-form a))))
       (desugar-result-expr env (form/keyword-form :string) part)))
   :default
(defn str-part
  "One `str` argument as a :string operand. Clojure's `str` prints an integer
  as its decimal digits, so an integer literal, a parameter typed :i64 and an
  arithmetic form are wrapped in `string-from-i64`; everything else must
  already be a string and fails closed at type check as it always did."
  [part]
  (if (str-integer-form? part)
    (list string-from-i64-helper-name (desugar-expr part))
    (desugar-result-expr :string part))))

#?(:kotoba nil :default (defn elaborate-named-operation
  "W1 safety elaboration validates an ordinary namespaced operation and keeps
  it named until parameter/result types are available. The later contextual
  elaboration pass lowers it to `typed-cap-call`; authors never write numeric
  capability IDs, type envelopes, or portable-effect envelopes."
  [form op kw args]
  (let [_ #?(:kotoba (require-k (= 1 (count args)) (str "named operation " (pr-str op)
                  " requires exactly one request value") "kotoba.error/subset-reject" form) :default (when-not (= 1 (count args))
    (reject! (str "named operation " (pr-str op)
                  " requires exactly one request value")
             form)))]
  (let [_ (resolve-capability-keyword! kw form)
        elaborated (list op (desugar-expr (first args)))]
    (attach-source-operation form elaborated kw)))))

#?(:kotoba nil :default (defn desugar-list [args form]
  (let [_ #?(:kotoba (require-k (not (> (count args) max-list-items)) "list item count exceeds admission limit" "kotoba.error/subset-reject" form) :default (when (> (count args) max-list-items)
    (reject! "list item count exceeds admission limit" form)))]
  (if (canonical-list-type? *contextual-closure-result-type*)
    (let [type *contextual-closure-result-type*
          item-type (second type)]
      (apply list 'typed-list-new type
             (map #(desugar-expected-value item-type %) args)))
    #?(:kotoba (let [fe-lc__234992 (form/kids-of (reverse args)) fe-ln__234992 (vector-count fe-lc__234992)] (loop [fe-li__234992 0 tail 0] (if (>= fe-li__234992 fe-ln__234992) tail (recur (+ fe-li__234992 1) (let [item (typed-list-nth [:list [:ref :form/r]] fe-lc__234992 fe-li__234992)] (list 'pair (desugar-expr item) tail)))))) :default (reduce (fn [tail item] (list 'pair (desugar-expr item) tail))
            0 (reverse args)))))))

;; Synthesized `let` temporaries for `and` / `or` / comparison chains.
;;
;; These used to be `gensym`, which made the emitted KIR different on every
;; compile: the same source produced `and-tmp__11125` in one run and
;; `and-tmp__11129` in the next, because the counter is process-global and
;; depends on how much compiled before it. Anything that compares precompiled
;; KIR therefore could not use `and`/`or` at all -- measured in
;; kotoba-lang/murakumo, whose `infer_schedule_core.kotoba` says in a comment:
;;
;;   Nested `if` (not `and`/`or`) so the precompiled KIR is gensym-stable for
;;   the drift gate.
;;
;; That is language profile 5's headline ergonomics being unavailable in exactly
;; the code that most wants them. A deterministic name fixes it: the name is a
;; function of the chain position, so the same source always yields the same KIR.
;;
;; Capture is prevented by construction rather than by luck: the names live under
;; the reserved `__kotoba_` prefix, which `reject-reserved-binding!` now refuses
;; in any user binding or parameter position. Shadowing between nested chains is
;; harmless anyway -- a temp is read only in its own `if` test and else branch,
;; both outside any inner binding -- but relying on that alone would leave a real
;; program able to capture one by writing the name.
#?(:kotoba
   (defn chain-temp [prefix :string depth :i64] [:ref :form/r]
     (form/symbol-form (string-concat "__kotoba_" (string-concat prefix (string-concat "_" (string-from-i64 depth))))))
   :default
(defn chain-temp [prefix depth]
  (symbol (str "__kotoba_" prefix "_" depth))))

;; ARGS are the forms of FORM from index I
#?(:kotoba
   (defn desugar-and [env [:ref :fe/env] form [:ref :form/r] i :i64] [:ref :fe/dr]
     (let [n (- (form/count-of form) i)]
       (cond
         (= n 0) (dr env (form/int-form 1))
         (= n 1) (desugar-bool-expr env (form/nth-of form i))
         :else (let [tmp (chain-temp "and" n)
                     a (desugar-bool-expr env (form/nth-of form i))
                     b (desugar-and (dr-env a) form (+ i 1))]
                 (dr (dr-env b)
                     (form/call2 "let" (form/vec2 tmp (dr-form a))
                                 (form/call3 "if" tmp (dr-form b) tmp)))))))
   :default
(defn desugar-and
  "`(and a b c ...)` -> nested `let`/`if`, ported from kotoba-lang/kotoba's
  runtime.clj `desugar-and` (verified live there, ADR-2607150000): binds
  each argument's value once (never re-evaluated) and branches on it.
  `(and)` is vacuously truthy (1); `(and a)` is just a."
  [args]
  (cond
    (empty? args) 1
    (empty? (rest args)) (desugar-bool-expr (first args))
    :else (let [tmp (chain-temp "and" (count args))]
            (list 'let [tmp (desugar-bool-expr (first args))]
                  (list 'if tmp (desugar-and (rest args)) tmp))))))

#?(:kotoba
   (defn desugar-or [env [:ref :fe/env] form [:ref :form/r] i :i64] [:ref :fe/dr]
     (let [n (- (form/count-of form) i)]
       (cond
         (= n 0) (dr env (form/int-form 0))
         (= n 1) (desugar-bool-expr env (form/nth-of form i))
         :else (let [tmp (chain-temp "or" n)
                     a (desugar-bool-expr env (form/nth-of form i))
                     b (desugar-or (dr-env a) form (+ i 1))]
                 (dr (dr-env b)
                     (form/call2 "let" (form/vec2 tmp (dr-form a))
                                 (form/call3 "if" tmp tmp (dr-form b))))))))
   :default
(defn desugar-or
  "Mirror of desugar-and for `(or a b c ...)`. `(or)` is vacuously falsy
  (0); `(or a)` is just a."
  [args]
  (cond
    (empty? args) 0
    (empty? (rest args)) (desugar-bool-expr (first args))
    :else (let [tmp (chain-temp "or" (count args))]
            (list 'let [tmp (desugar-bool-expr (first args))]
                  (list 'if tmp tmp (desugar-or (rest args))))))))

#?(:kotoba
   (defn desugar-cond [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 0 (rem (argc form) 2)) "cond requires test/result pairs" "kotoba.error/cond-pairs" form)]
       (desugar-cond-lower env form 1)))
   :default
(defn desugar-cond
  "Lowers `(cond test value ... :else fallback)` to the already admitted
  nested `if` core. Tests retain left-to-right, at-most-once evaluation.
  `:else` is syntax here, not a runtime keyword value, and must be last so
  unreachable clauses cannot be hidden accidentally. An empty cond has the
  profile's ordinary false/nil sentinel value, 0."
  [args form]
  (when (odd? (count args))
    (reject! "cond requires test/result pairs" form :kotoba.error/cond-pairs))
  (letfn [(lower [clauses]
            (if (empty? clauses)
              0
              (let [[test result & remaining] clauses
                    value (fn [x] (if (nil? x) '(__kotoba_absent :nil) (desugar-expr x)))]
                (if (= :else test)
                  (do (when (seq remaining)
                        (reject! "cond :else clause must be last" form))
                      (value result))
                  (list 'if (desugar-bool-expr test)
                        (value result)
                        ;; no :else is absence (`absence-type`); an empty
                        ;; cond stays the 0 it always was
                        (if (seq remaining) (lower remaining) (absence-marker-form)))))))]
    (lower args))))

#?(:kotoba
   (defn desugar-condp [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (>= (argc form) 2) "condp requires a predicate and dispatch expression"
                        "kotoba.error/subset-reject" form)
           predicate (arg form 0)
           _ (require-k (simple-symbol-form? predicate) "condp predicate must be an unqualified function symbol"
                        "kotoba.error/subset-reject" form)
           _ (require-k (not (condp-has-arrow? form 3)) "condp :>> clauses are not supported by this portable profile"
                        "kotoba.error/subset-reject" form)
           clauses (- (argc form) 2)
           default? (= 1 (rem clauses 2))
           end (if default? (- (form/count-of form) 1) (form/count-of form))
           t (synthetic env "condp")
           tmp (dr-form t)
           disp (desugar-expr (dr-env t) (arg form 1))
           dflt (desugar-expr (dr-env disp) (condp-default-form form default?))
           folded (condp-fold (dr-env dflt) predicate tmp form 3 end (dr-form dflt))]
       (dr (dr-env folded) (form/call2 "let" (form/vec2 tmp (dr-form disp)) (dr-form folded)))))
   :default
(defn desugar-condp
  "Lowers the portable `(condp predicate dispatch test result ... default?)`
  subset to a single dispatch binding and left-to-right nested `if` calls.
  The predicate must be a statically resolvable, unqualified two-argument
  function symbol. Clojure's `:>>` extension is deliberately outside this
  bounded slice. With no default, a miss traps like `case`."
  [args form]
  (when (< (count args) 2)
    (reject! "condp requires a predicate and dispatch expression" form))
  (let [[predicate dispatch & clauses] args]
    (when-not (and (symbol? predicate) (nil? (namespace predicate)))
      (reject! "condp predicate must be an unqualified function symbol" form))
    (when (first-truthy #{:>>} clauses)
      (reject! "condp :>> clauses are not supported by this portable profile" form))
    (let [default? (odd? (count clauses))
          default (if default? (last clauses) '(quot 1 0))
          pairs (partition 2 (if default? (butlast clauses) clauses))
          tmp (synthetic "condp")]
      (list 'let [tmp (desugar-expr dispatch)]
            (reduce (fn [fallback [test result]]
                      (list 'if
                            (desugar-bool-expr
                             (list predicate (desugar-expr test) tmp))
                            (desugar-expr result)
                            fallback))
                    (desugar-expr default)
                    (reverse pairs)))))))

#?(:kotoba
   (defn desugar-cond-thread [env [:ref :fe/env] form [:ref :form/r] last? :bool] [:ref :fe/dr]
     (let [_ (require-k (and (> (argc form) 0) (= 0 (rem (- (argc form) 1) 2)))
                        (string-concat (if last? "cond->>" "cond->") " requires an initial value followed by test/form pairs")
                        "kotoba.error/subset-reject" form)
           init (desugar-expr env (arg form 0))]
       (cond-thread-steps (dr-env init) (dr-form init) form 2 last?)))
   :default
(defn desugar-cond-thread [args form last?]
  (when (or (empty? args) (odd? (count (rest args))))
    (reject! (str (if last? "cond->>" "cond->")
                  " requires an initial value followed by test/form pairs") form))
  (reduce (fn [value [test step]]
            (when-not (and (seq? step) (symbol? (first step)))
              (reject! (str (if last? "cond->>" "cond->")
                            " update must be a non-empty call form") step))
            (let [tmp (synthetic "cond-thread")
                  threaded (thread-form tmp step last?)]
              (list 'let [tmp value]
                    (list 'if (desugar-bool-expr test)
                          (desugar-expr threaded)
                          tmp))))
          (desugar-expr (first args))
          (partition 2 (rest args)))))

#?(:kotoba
   (defn desugar-dotimes [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [bform (if (> (argc form) 0) (arg form 0) (form/nil-form))
           _ (require-k (and (form/is-vec? bform) (= 2 (form/count-of bform)) (simple-symbol-form? (form/nth-of bform 0)))
                        "dotimes requires [unqualified-symbol count]" "kotoba.error/subset-reject" form)
           index (form/nth-of bform 0)
           s (synthetic env "dotimes-limit")
           limit (dr-form s)
           iteration (head-call (form/symbol-form "do")
                                (form/append-form (args-from form 2) (form/call1 "recur" (form/call2 "+" index (form/int-form 1)))))]
       (desugar-expr-in-loop (dr-env s)
                     (form/call2 "let" (form/vec2 limit (form/nth-of bform 1))
                                 (form/call2 "loop" (form/vec2 index (form/int-form 0))
                                             (form/call3 "if" (form/call2 "<" index limit) iteration (form/int-form 0)))))))
   :default
(defn desugar-dotimes [args form]
  (let [[binding & body] args]
    (when-not (and (vector? binding) (= 2 (count binding))
                   (symbol? (first binding)) (nil? (namespace (first binding))))
      (reject! "dotimes requires [unqualified-symbol count]" form))
    (let [[index count-form] binding
          limit (synthetic "dotimes-limit")
          iteration (list* 'do (concat body [(list 'recur (list '+ index 1))]))]
      (desugar-expr
       (list 'let [limit count-form]
             (list 'loop [index 0]
                   (list 'if (list '< index limit) iteration 0))))))))

;; ---- doseq on the Kotoba route: the parser of the binding vector (groups of item/collection/modifiers) and the unrolled lowering ----
;; The host builds the lowering with a `let*` that also computes the pair-sequence form for EVERY group, so the synthetic-name counter
;; advances by 2*limit+1 for it even when the collection is a vector; the port reproduces the counter, and builds the form only for
;; a pair sequence.
#?(:kotoba
   (defn doseq-limit-k [] :i64 128)
   :default nil)

;; (list ...)-shaped collections the host lowers by cursor
#?(:kotoba
   (defn doseq-pair-seq? [c [:ref :form/r]] :bool
     (and (form/is-seq? c) (> (form/count-of c) 0)
          (let [h (form/nth-of c 0)]
            (or (sym-is? h "list") (sym-is? h "cons") (sym-is? h "rest") (sym-is? h "__kotoba_pair_sequence")))))
   :default nil)

;; every element of B at I, I+2, ... is an unqualified symbol
#?(:kotoba
   (defn even-simple-symbols? [b [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of b))
       true
       (and (simple-symbol-form? (form/nth-of b i)) (even-simple-symbols? b (+ i 2)))))
   :default nil)

;; no element of B at an even position from I repeats a later one
#?(:kotoba
   (defn evens-after-differ? [b [:ref :form/r] x [:ref :form/r] j :i64] :bool
     (if (>= j (form/count-of b))
       true
       (and (not (form/eq x (form/nth-of b j))) (evens-after-differ? b x (+ j 2)))))
   :default nil)

#?(:kotoba
   (defn evens-distinct? [b [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of b))
       true
       (and (evens-after-differ? b (form/nth-of b i) (+ i 2)) (evens-distinct? b (+ i 2)))))
   :default nil)

#?(:kotoba
   (defn doseq-modifier [kw [:ref :form/r] v [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (cond
       (form/eq kw (form/keyword-form :let))
       (let [_ (require-k (and (form/is-vec? v) (= 0 (rem (form/count-of v) 2)) (even-simple-symbols? v 0) (evens-distinct? v 0))
                          "doseq :let requires unique unqualified symbol/value bindings" "kotoba.error/subset-reject" form)]
         (form/vec2 kw v))
       (form/eq kw (form/keyword-form :when)) (form/vec2 kw v)
       (form/eq kw (form/keyword-form :while)) (form/vec2 kw v)
       :else (throw (fe-reject "doseq supports only :let, :when, and :while modifiers" "kotoba.error/subset-reject" form))))
   :default nil)

;; the group G (a vector [item collection pair? modifiers]) with modifier M appended
#?(:kotoba
   (defn doseq-add-modifier [g [:ref :form/r] m [:ref :form/r]] [:ref :form/r]
     (form/vec4 (form/nth-of g 0) (form/nth-of g 1) (form/nth-of g 2)
                (form/form-vec (form/append-form (form/kids-of (form/nth-of g 3)) m))))
   :default nil)

;; the binding vector as a vector of groups; CURRENT is the group under construction (nil-form for none)
#?(:kotoba
   (defn doseq-groups [form [:ref :form/r] tokens [:ref :form/r] i :i64 groups [:ref :form/r] current [:ref :form/r]] [:ref :form/r]
     (let [n (form/count-of tokens)]
       (cond
         (>= i n) (if (form/is-nil? current) groups (form/form-vec (form/append-form (form/kids-of groups) current)))
         (form/is-nil? current)
         (let [item (form/nth-of tokens i)
               _ (require-k (and (simple-symbol-form? item) (< (+ i 1) n))
                            "doseq requires [unqualified-symbol collection] binding pairs" "kotoba.error/subset-reject" form)
               coll (form/nth-of tokens (+ i 1))]
           (doseq-groups form tokens (+ i 2) groups
                         (form/vec4 item coll (form/bool-form (doseq-pair-seq? coll)) (form/form-vec (form/no-forms)))))
         (form/is-keyword? (form/nth-of tokens i))
         (let [_ (require-k (< (+ i 1) n) "doseq modifiers require keyword/value pairs" "kotoba.error/subset-reject" form)
               m (doseq-modifier (form/nth-of tokens i) (form/nth-of tokens (+ i 1)) form)]
           (doseq-groups form tokens (+ i 2) groups (doseq-add-modifier current m)))
         (simple-symbol-form? (form/nth-of tokens i))
         (doseq-groups form tokens i (form/form-vec (form/append-form (form/kids-of groups) current)) (form/nil-form))
         :else (throw (fe-reject "doseq requires binding pairs separated only by :let/:when/:while modifiers"
                                 "kotoba.error/subset-reject" form)))))
   :default nil)

;; the iteration signal: the modifiers applied from the last to the first around INNER
#?(:kotoba
   (defn doseq-signal [mods [:ref :form/r] i :i64 inner [:ref :form/r]] [:ref :form/r]
     (if (< i 0)
       inner
       (let [m (form/nth-of mods i)
             kw (form/nth-of m 0)
             v (form/nth-of m 1)]
         (doseq-signal mods (- i 1)
                       (cond
                         (form/eq kw (form/keyword-form :let)) (form/call2 "let" v inner)
                         (form/eq kw (form/keyword-form :when)) (form/call3 "if" v inner (form/int-form 1))
                         :else (form/call3 "if" v inner (form/int-form 0)))))))
   :default nil)

;; one block of up to 16 indices [lo, hi): each index runs the signal then the continuation, from the last index to the first
#?(:kotoba
   (defn doseq-block [item [:ref :form/r] values [:ref :form/r] length [:ref :form/r] signal [:ref :form/r] lo :i64 i :i64 cont [:ref :form/r]] [:ref :form/r]
     (if (< i lo)
       cont
       (doseq-block item values length signal lo (- i 1)
                    (form/call3 "if" (form/call2 "<" (form/int-form i) length)
                                (form/call3 "if"
                                            (form/call2 "let" (form/vec2 item (form/call2 "vector-at" values (form/int-form i))) signal)
                                            cont (form/int-form 0))
                                (form/int-form 1)))))
   :default nil)

;; the blocks chained from the last (starting at START) to the first
#?(:kotoba
   (defn doseq-unroll [item [:ref :form/r] values [:ref :form/r] length [:ref :form/r] signal [:ref :form/r] limit :i64 start :i64 cont [:ref :form/r]] [:ref :form/r]
     (if (< start 0)
       cont
       (let [hi (if (< (+ start 16) limit) (+ start 16) limit)
             block (doseq-block item values length signal start (- hi 1) (form/int-form 1))]
         (doseq-unroll item values length signal limit (- start 16) (form/call3 "if" block cont (form/int-form 0))))))
   :default nil)

;; the cursor walk of a pair sequence: index INDEX of LIMIT, the cursor expression CURSOR-EXPR
#?(:kotoba
   (defn doseq-pair-step [env [:ref :fe/env] index :i64 limit :i64 cursor-expr [:ref :form/r] item [:ref :form/r] signal [:ref :form/r]] [:ref :fe/dr]
     (let [c (synthetic env "doseq-cursor")
           cursor (dr-form c)]
       (if (= index limit)
         (dr (dr-env c)
             (form/call2 "let" (form/vec2 cursor cursor-expr)
                         (form/call3 "if" (form/call2 "=" cursor (form/int-form 0)) (form/int-form 0)
                                     (form/call2 "quot" (form/int-form 1) (form/int-form 0)))))
         (let [nx (synthetic (dr-env c) "doseq-next")
               next-cursor (dr-form nx)
               st (doseq-pair-step (dr-env nx) (+ index 1) limit next-cursor item signal)]
           (dr (dr-env st)
               (form/call2 "let" (form/vec2 cursor cursor-expr)
                           (form/call3 "if" (form/call2 "=" cursor (form/int-form 0)) (form/int-form 0)
                                       (form/call2 "let" (form/vec2 next-cursor (form/call1 "pair-second" cursor))
                                                   (form/call3 "if"
                                                               (form/call2 "let" (form/vec2 item (form/call1 "pair-first" cursor)) signal)
                                                               (dr-form st) (form/int-form 0))))))))))
   :default nil)

;; one collection group around INNER (the lowered rest of the doseq)
#?(:kotoba
   (defn doseq-lower-group [env [:ref :fe/env] g [:ref :form/r] inner [:ref :form/r] limit :i64] [:ref :fe/dr]
     (let [item (form/nth-of g 0)
           coll (form/nth-of g 1)
           pair? (form/is-true? (form/nth-of g 2))
           signal (doseq-signal (form/nth-of g 3) (- (form/count-of (form/nth-of g 3)) 1)
                                (head-call (form/symbol-form "do") (form/two-forms inner (form/int-form 1))))
           vs (synthetic env "doseq-values")
           values (dr-form vs)
           ln (synthetic (dr-env vs) "doseq-length")
           length (dr-form ln)
           bounded (if pair?
                     (doseq-pair-step (dr-env ln) 0 limit values item signal)
                     (let [unrolled (doseq-unroll item values length signal limit (* 16 (quot (- limit 1) 16)) (form/int-form 0))]
                       (dr (record-assoc [:ref :fe/env] (dr-env ln) :counter (+ (env-counter (dr-env ln)) (+ (* 2 limit) 1)))
                           (if (< limit (doseq-limit-k))
                             (form/call3 "if" (form/call2 "<" (form/int-form limit) length)
                                         (form/call2 "quot" (form/int-form 1) (form/int-form 0)) unrolled)
                             unrolled))))
           source (if (and pair? (form/is-seq? coll) (sym-is? (form/nth-of coll 0) "__kotoba_pair_sequence"))
                    (form/nth-of coll 1)
                    coll)]
       (dr (dr-env bounded)
           (form/call2 "let" (form/vec2 values source)
                       (if pair?
                         (dr-form bounded)
                         (form/call2 "let" (form/vec2 length (form/call1 "vector-count" values)) (dr-form bounded)))))))
   :default nil)

#?(:kotoba
   (defn doseq-limit-for [groups-count :i64 pair? :bool] :i64
     (cond
       (= 4 groups-count) 2
       (= 3 groups-count) 4
       (= 2 groups-count) 16
       pair? 32
       :else (doseq-limit-k)))
   :default nil)

;; the groups from the last (index I) to the first around INNER
#?(:kotoba
   (defn doseq-lower-groups [env [:ref :fe/env] groups [:ref :form/r] i :i64 inner [:ref :form/r]] [:ref :fe/dr]
     (if (< i 0)
       (dr env inner)
       (let [g (form/nth-of groups i)
             r (doseq-lower-group env g inner (doseq-limit-for (form/count-of groups) (form/is-true? (form/nth-of g 2))))]
         (doseq-lower-groups (dr-env r) groups (- i 1) (dr-form r)))))
   :default nil)

#?(:kotoba
   (defn desugar-doseq [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [bform (if (> (argc form) 0) (arg form 0) (form/nil-form))
           _ (require-k (form/is-vec? bform) "doseq requires a binding vector" "kotoba.error/subset-reject" form)
           groups (doseq-groups form bform 0 (form/form-vec (form/no-forms)) (form/nil-form))
           _ (require-k (and (<= 1 (form/count-of groups)) (<= (form/count-of groups) 4))
                        "doseq supports at most four collection bindings" "kotoba.error/subset-reject" form)
           lowered (doseq-lower-groups env groups (- (form/count-of groups) 1)
                                       (head-call (form/symbol-form "do") (form/append-form (args-from form 2) (form/int-form 0))))]
       (desugar-expr-in-loop (dr-env lowered) (dr-form lowered))))
   :default
(defn desugar-doseq [args form]
  (let [[binding & body] args]
    (when-not (vector? binding)
      (reject! "doseq requires a binding vector" form))
    (letfn [(valid-item? [item]
              (and (symbol? item) (nil? (namespace item))))
            (parse-modifier [modifier modifier-value]
              (case modifier
                :let
                (do
                  (when-not (and (vector? modifier-value)
                                 (even? (count modifier-value))
                                 (every? valid-item? (take-nth 2 modifier-value))
                                 (= (count (take-nth 2 modifier-value))
                                    (count (distinct (take-nth 2 modifier-value)))))
                    (reject! "doseq :let requires unique unqualified symbol/value bindings"
                             form))
                  [:let modifier-value])
                :when [:when modifier-value]
                :while [:while modifier-value]
                (reject! "doseq supports only :let, :when, and :while modifiers"
                         form)))
            (pair-sequence-form? [collection]
              (and (seq? collection)
                   (contains? #{'list 'cons 'rest
                                '__kotoba_pair_sequence}
                              (first collection))))
            (parse-groups []
              (loop [tokens (seq binding) groups [] current nil]
                (cond
                  (nil? tokens)
                  (cond-> groups current (conj current))

                  (nil? current)
                  (let [item (first tokens)
                        collection (second tokens)]
                    (when-not (and (valid-item? item) (next tokens))
                      (reject! "doseq requires [unqualified-symbol collection] binding pairs"
                               form))
                    (recur (nnext tokens) groups
                           {:item item
                            :collection collection
                            :pair-sequence? (pair-sequence-form? collection)
                            :modifiers []}))

                  (keyword? (first tokens))
                  (do
                    (when-not (next tokens)
                      (reject! "doseq modifiers require keyword/value pairs" form))
                    (recur (nnext tokens) groups
                           (update current :modifiers conj
                                   (parse-modifier (first tokens) (second tokens)))))

                  (valid-item? (first tokens))
                  (recur tokens (conj groups current) nil)

                  :else
                  (reject! "doseq requires binding pairs separated only by :let/:when/:while modifiers"
                           form))))
            (lower-group [{:keys [item collection modifiers pair-sequence?]}
                          group-body limit]
              (let [iteration-signal
                    (reduce
                     (fn [inner [modifier modifier-value]]
                       (case modifier
                         :let (list 'let modifier-value inner)
                         :when (list 'if modifier-value inner true)
                         :while (list 'if modifier-value inner false)))
                     (list* 'do (concat group-body [true]))
                     (reverse modifiers))
                    values (synthetic "doseq-values")
                    length (synthetic "doseq-length")
                    ;; The vector walk is a `loop` too, over at most LIMIT
                    ;; items -- the items it was unrolled over until
                    ;; 2026-10-10, one copy of the body per index (16 x 16 for
                    ;; two bindings). kotoba-lang control/doseq.kotoba
                    ;; compiled to a 103 KB Wasm module that way, against
                    ;; 3 KB for a fixture of its size, and the module overflowed
                    ;; the stack of the child node that decodes it from a data
                    ;; URL (amu test --manifest on Node 24, Linux). Same bound,
                    ;; same trap below for a vector longer than LIMIT, same
                    ;; order of evaluation; the body is written once.
                    ;; Under the trap LENGTH <= LIMIT, so only the untrapped
                    ;; one-binding walk also counts against LIMIT: a vector
                    ;; built longer at run time still stops after LIMIT items.
                    index (synthetic "doseq-index")
                    trapped? (< limit value/vector-literal-item-limit)
                    step (list 'if
                               (list 'let
                                     [item (list 'vector-at values index)]
                                     iteration-signal)
                               (list 'recur (list '+ index 1))
                               0)
                    vector-walk
                    (list 'loop [index 0]
                          (list 'if (list '< index length)
                                (if trapped?
                                  step
                                  (list 'if (list '< index limit) step 0))
                                0))
                    ;; The pair walk is a `loop` -- `dotimes`'s lowering --
                    ;; that counts its steps: past LIMIT items a chain that
                    ;; still goes on traps, as it always did. Until 2026-10-09
                    ;; it was unrolled into a nest five forms deep per step,
                    ;; 160 levels at the limit of 32, which the nbb hosts amu
                    ;; and this suite run on refused as `desugared nesting
                    ;; exhausted the host stack` for EVERY pair-sequence
                    ;; doseq, a three-item list included (kotoba-lang
                    ;; lang/conformance/control/doseq.kotoba). A flat `let`
                    ;; of the same steps is no better: each `if` in a binding
                    ;; duplicates the rest, and 32 of them exhaust the
                    ;; lowered-program budget. Same bound, same trap, same
                    ;; order of evaluation.
                    pair-unrolled
                    (let [cursor (synthetic "doseq-cursor")
                          index (synthetic "doseq-index")]
                      (list 'loop [cursor values index 0]
                            (list 'if (list '= cursor 0)
                                  0
                                  (list 'if (list '< index limit)
                                        (list 'if
                                              (list 'let
                                                    [item (list 'pair-first cursor)]
                                                    iteration-signal)
                                              (list 'recur
                                                    (list 'pair-second cursor)
                                                    (list '+ index 1))
                                              0)
                                        (list 'quot 1 0)))))
                    bounded
                    (if pair-sequence?
                      pair-unrolled
                      (if trapped?
                        (list 'if (list '< limit length)
                              (list 'quot 1 0)
                              vector-walk)
                        vector-walk))]
                (list 'let [values (if (and pair-sequence?
                                            (seq? collection)
                                            (= '__kotoba_pair_sequence
                                               (first collection)))
                                     (second collection)
                                     collection)]
                      (if pair-sequence?
                        bounded
                        (list 'let [length (list 'vector-count values)]
                              bounded)))))]
      (let [groups (parse-groups)
            group-count (count groups)]
        (when-not (<= 1 group-count 4)
          (reject! "doseq supports at most four collection bindings"
                   form))
        (let [lowered
              (reduce (fn [inner group]
                        (lower-group group [inner]
                                     (cond
                                       (= 4 group-count) 2
                                       (= 3 group-count) 4
                                       (= 2 group-count) 16
                                       (:pair-sequence? group) 32
                                       :else value/vector-literal-item-limit)))
                      (list* 'do (concat body [0]))
                      (reverse groups))]
          (desugar-expr lowered)))))))

#?(:kotoba
   (defn thread-form [value [:ref :form/r] step [:ref :form/r] last? :bool] [:ref :form/r]
     (cond
       (form/is-symbol? step) (form/call1 (form/symbol-value step) value)
       (and (form/is-seq? step) (> (form/count-of step) 0) (form/is-symbol? (form/nth-of step 0)))
       (if last?
         (form/form-seq (form/cons-onto (form/nth-of step 0) (form/append-form (form/rest-list step) value)))
         (form/form-seq (form/cons-onto (form/nth-of step 0) (form/cons-onto value (form/rest-list step)))))
       :else (throw (fe-reject "thread step must be a symbol or non-empty call" "kotoba.error/subset-reject" step))))
   :default
(defn thread-form [value step last?]
  (cond
    (symbol? step) (list step value)
    (and (seq? step) (symbol? (first step)))
    (if last?
      (apply list (first step) (concat (rest step) [value]))
      (list* (first step) value (rest step)))
    :else (reject! "thread step must be a symbol or non-empty call" step))))

#?(:kotoba
   (defn desugar-thread [env [:ref :fe/env] form [:ref :form/r] last? :bool] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) (if last? "->> requires an initial value" "-> requires an initial value")
                        "kotoba.error/subset-reject" form)
           v (thread-steps (arg form 0) form 2 last?)]
       (desugar-expr env v)))
   :default
(defn desugar-thread [args form last?]
  (when (empty? args)
    (reject! (if last? "->> requires an initial value" "-> requires an initial value") form))
  (desugar-expr (reduce #(thread-form %1 %2 last?) (first args) (rest args)))))

#?(:kotoba
   (defn desugar-as-thread [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (and (<= 2 (argc form)) (simple-symbol-form? (arg form 1)))
                        "as-> requires an initial value, an unqualified binding symbol, and optional forms"
                        "kotoba.error/subset-reject" form)]
       (desugar-expr env (as-thread-steps (arg form 0) (arg form 1) form 3))))
   :default
(defn desugar-as-thread [args form]
  (let [[initial name & steps] args]
    (when-not (and (<= 2 (count args)) (symbol? name) (nil? (namespace name)))
      (reject! "as-> requires an initial value, an unqualified binding symbol, and optional forms" form))
    (desugar-expr
     (reduce (fn [value step] (list 'let [name value] step))
             initial steps)))))

#?(:kotoba
   (defn resolve-option-type [env [:ref :fe/env] v [:ref :form/r]] [:ref :form/r]
     (let [fallback (form/vec2 (form/keyword-form :option) (form/keyword-form :i64))]
       (cond
         (and (simple-symbol-form? v) (form/is-map? (record-get [:ref :fe/env] env :options)))
         (form/form-get (record-get [:ref :fe/env] env :options) v)
         (and (form/is-seq? v) (> (form/count-of v) 0)
              (or (head-is? v "option-some-of") (head-is? v "option-none-of") (head-is? v "option-some?-of")
                  (head-is? v "option-value-of") (head-is? v "option-match"))
              (option-descriptor? (form/nth-of v 1)))
         (form/nth-of v 1)
         (head-is? v "record-get")
         (let [n (argc v)
               ft (cond
                    (and (= 3 n) (form/is-keyword? (arg v 2)))
                    (record-field-type (arg v 0) (arg v 2) (env-schemas env))
                    (and (= 2 n) (form/is-symbol? (arg v 0)) (form/is-keyword? (arg v 1)) (form/is-map? (env-types env)))
                    (record-field-type (form/form-get (env-types env) (arg v 0)) (arg v 1) (env-schemas env))
                    :else (form/nil-form))]
           (if (option-descriptor? ft) ft fallback))
         :else fallback)))
   :default
(defn resolve-option-type
  "Best-effort option type for sugar lowering (Product Value ABI v1).

  Prefer an explicit typed local (`*local-option-types*`), then syntactic
  constructors `(option-some-of T …)` / `(option-none-of T)`, then
  `(record-get … :field)` when the field is itself `[:option T]` (T5.2
  option-string-in-record). Fall back to `[:option :i64]` only for legacy
  monomorphic option-i64 paths."
  [value-form]
  (cond
    (and (symbol? value-form) (nil? (namespace value-form))
         (map? *local-option-types*))
    (get *local-option-types* value-form)

    (and (seq? value-form)
         (contains? '#{option-some-of option-none-of option-some?-of
                       option-value-of option-match}
                    (first value-form))
         (vector? (second value-form))
         (= :option (first (second value-form))))
    (second value-form)

    ;; `(record-get TYPE value field)` (post rewrite) or
    ;; `(record-get value field)` (pre rewrite, typed local).
    (and (seq? value-form)
         (= 'record-get (first value-form)))
    (let [args (vec (rest value-form))
          field-type
          (cond
            (and (= 3 (count args)) (keyword? (nth args 2)))
            (record-field-type (nth args 0) (nth args 2))

            (and (= 2 (count args))
                 (symbol? (nth args 0))
                 (keyword? (nth args 1))
                 (map? *local-types*))
            (record-field-type (get *local-types* (nth args 0)) (nth args 1))

            :else nil)]
      (if (and (vector? field-type) (= :option (first field-type)))
        field-type
        [:option :i64]))

    :else [:option :i64])))

#?(:kotoba
   (defn option-payload-fallback [t [:ref :form/r]] [:ref :form/r]
     (cond
       (form/eq t (form/keyword-form :i64)) (form/int-form 0)
       (form/eq t (form/keyword-form :bool)) (form/bool-form false)
       (form/eq t (form/keyword-form :string)) (form/string-form "")
       (form/eq t (form/keyword-form :keyword)) (form/keyword-form :none)
       (form/eq t (form/keyword-form :f64)) (form/f64-form 0)
       (form/eq t (form/keyword-form :f32)) (form/f64-form 0)
       :else (form/int-form 0)))
   :default
(defn option-payload-fallback
  "Typed bottom value for option-value-of's unused fallback arm.
  Must match payload type so typecheck accepts the if-some lowering."
  [payload-type]
  (cond
    (= payload-type :i64) 0
    (= payload-type :bool) false
    (= payload-type :string) ""
    (= payload-type :keyword) :none
    (= payload-type :f64) 0.0
    (= payload-type :f32) 0.0
    :else 0)))

#?(:kotoba
   (defn desugar-some-thread [env [:ref :fe/env] form [:ref :form/r] last? :bool] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) (if last? "some->> requires an initial option" "some-> requires an initial option")
                        "kotoba.error/subset-reject" form)]
       (some-thread-lower env (arg form 0) form 2 last?)))
   :default
(defn desugar-some-thread
  "`(some-> x s1 s2)` threads while each value is present (ADR 0353 floor
  :absence). A step whose value is an `[:option T]` stops the thread when it
  is absent and passes its payload on; a step whose value is not an option is
  always present. The result is always an option: the last step's value
  wrapped in `option-some-of` unless it already is one, absent if any step
  was. Types decide all three, so this emits the markers
  `__kotoba_some_bind` / `__kotoba_some_last` / `__kotoba_present` and
  `rewrite-record-projection` resolves them once the steps have types."
  [args form last?]
  (when (empty? args)
    (reject! (if last? "some->> requires an initial option" "some-> requires an initial option") form))
  (letfn [(lower [value-form steps]
            (if (empty? steps)
              (list '__kotoba_some_last (desugar-expr value-form))
              (let [tmp (if *loop-counter*
                          (symbol (str "some-thread__" (vswap! *loop-counter* inc)))
                          (synthetic "some-thread"))
                    threaded (thread-form (list '__kotoba_present tmp) (first steps) last?)]
                (list 'let [tmp (desugar-expr value-form)]
                      (list '__kotoba_some_bind tmp (lower threaded (rest steps)))))))]
    (lower (first args) (rest args)))))

#?(:kotoba
   (defn desugar-binding-if [env [:ref :fe/env] form [:ref :form/r] when? :bool] [:ref :fe/dr]
     (let [bform (arg form 0)
           nb (- (form/count-of form) 2)
           _ (require-k (and (form/is-vec? bform) (= 2 (form/count-of bform)))
                        (if when? "when-let requires one binding pair" "if-let requires one binding pair")
                        "kotoba.error/subset-reject" form)
           _ (require-k (if when? (> nb 0) (and (<= 1 nb) (<= nb 2)))
                        (if when? "when-let requires at least one body expression"
                            "if-let requires then and optional else expressions")
                        "kotoba.error/subset-reject" form)
           pattern (form/nth-of bform 0)
           t (synthetic env "binding-if")
           tmp (dr-form t)
           then-form (binding-if-then form when?)
           else-form (binding-if-else env form when?)
           v (desugar-bool-expr (dr-env t) (form/nth-of bform 1))]
       (desugar-expr (dr-env v)
                     (form/call2 "let" (form/vec2 tmp (dr-form v))
                                 (form/call3 "if" tmp
                                             (form/call2 "let" (form/vec2 pattern (form/call1 "__kotoba_present" tmp)) then-form)
                                             else-form)))))
   :default
(defn desugar-binding-if [args form when?]
  (let [[binding & bodies] args]
    (when-not (and (vector? binding) (= 2 (count binding)))
      (reject! (if when? "when-let requires one binding pair"
                           "if-let requires one binding pair") form))
    (when (if when? (empty? bodies) (not (<= 1 (count bodies) 2)))
      (reject! (if when? "when-let requires at least one body expression"
                           "if-let requires then and optional else expressions") form))
    (let [[pattern value] binding
          tmp (synthetic "binding-if")
          then-form (if when?
                      (if (= 1 (count bodies)) (first bodies) (cons 'do bodies))
                      (first bodies))
          else-form (if when? (absence-marker-form)
                        (if (= 2 (count bodies)) (second bodies) (absence-marker-form)))]
      ;; ADR 0353 floor :absence: over an `[:option T]` the test is presence
      ;; and the pattern binds the payload. Which one this is is known only
      ;; once the value has a type, so `rewrite-record-projection` resolves
      ;; `if` and `__kotoba_present` from the inferred type of `tmp`; over a
      ;; `:bool` both are what they always were.
      (desugar-expr
       (list 'let [tmp (desugar-bool-expr value)]
             (list 'if tmp
                   (list 'let [pattern (list '__kotoba_present tmp)] then-form)
                   else-form)))))))

#?(:kotoba
   (defn desugar-binding-some [env [:ref :fe/env] form [:ref :form/r] when? :bool] [:ref :fe/dr]
     (let [bform (arg form 0)
           nb (- (form/count-of form) 2)
           _ (require-k (and (form/is-vec? bform) (= 2 (form/count-of bform)))
                        (if when? "when-some requires one binding pair" "if-some requires one binding pair")
                        "kotoba.error/subset-reject" form)
           _ (require-k (if when? (> nb 0) (and (<= 1 nb) (<= nb 2)))
                        (if when? "when-some requires at least one body expression"
                            "if-some requires then and optional else expressions")
                        "kotoba.error/subset-reject" form)
           pattern (form/nth-of bform 0)
           value (form/nth-of bform 1)
           t (synthetic env "binding-some")
           tmp (dr-form t)
           found (resolve-option-type (dr-env t) value)
           option-type (if (form/is-nil? found) (form/vec2 (form/keyword-form :option) (form/keyword-form :i64)) found)
           th (binding-some-then (dr-env t) form when?)
           else-form (binding-if-else (dr-env th) form when?)
           payload-type (if (option-descriptor? option-type) (form/nth-of option-type 1) (form/nil-form))
           fallback (option-payload-fallback payload-type)
           _ (require-k (option-descriptor? option-type)
                        "if-some/when-some value must have an option type; use match-option with an explicit type or a typed local"
                        "kotoba.error/subset-reject" form)]
       (desugar-expr (dr-env th)
                     (form/call2 "let" (form/vec2 tmp value)
                                 (form/call3 "if" (form/call2 "option-some?-of" option-type tmp)
                                             (form/call2 "let" (form/vec2 pattern (form/call3 "option-value-of" option-type tmp fallback))
                                                         (dr-form th))
                                             else-form)))))
   :default
(defn desugar-binding-some [args form when?]
  (let [[binding & bodies] args]
    (when-not (and (vector? binding) (= 2 (count binding)))
      (reject! (if when? "when-some requires one binding pair"
                           "if-some requires one binding pair") form))
    (when (if when? (empty? bodies) (not (<= 1 (count bodies) 2)))
      (reject! (if when? "when-some requires at least one body expression"
                           "if-some requires then and optional else expressions") form))
    (let [[pattern value] binding
          ;; Deterministic, like every other synthesized temp. This was already
          ;; deterministic but kept the old `binding-some__N` shape, which has
          ;; two costs: it still matches the `.+__\d+` gensym pattern, so the
          ;; conformance digest normalized it away and could not see a change in
          ;; it; and it borrowed `*loop-counter*`, so adding or removing a
          ;; `loop` renumbered it for no reason.
          tmp (synthetic "binding-some")
          option-type (or (resolve-option-type value) [:option :i64])
          then-form (if when?
                      (if (= 1 (count bodies)) (first bodies) (desugar-do bodies))
                      (first bodies))
          else-form (if when? (absence-marker-form)
                        (if (= 2 (count bodies)) (second bodies) (absence-marker-form)))
          payload-type (when (and (vector? option-type) (= :option (first option-type)))
                         (second option-type))
          fallback (option-payload-fallback payload-type)]
      (when-not (and (vector? option-type) (= :option (first option-type)))
        (reject! "if-some/when-some value must have an option type; use match-option with an explicit type or a typed local"
                 form))
      (desugar-expr
       (list 'let [tmp value]
             (list 'if (list 'option-some?-of option-type tmp)
                   (list 'let [pattern (list 'option-value-of option-type tmp fallback)]
                         then-form)
                   else-form)))))))

#?(:kotoba
   (defn desugar-case [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) "case requires a dispatch expression" "kotoba.error/subset-reject" form)
           clauses (- (argc form) 1)
           default? (= 1 (rem clauses 2))
           end (if default? (- (form/count-of form) 1) (form/count-of form))
           _ (require-k (case-constants-ok? form 2 end)
                        "case constants must be bounded integer, keyword, boolean, or string literals"
                        "kotoba.error/subset-reject" form)
           _ (require-k (all-distinct? (case-constants form 2 end (form/no-forms)) 0)
                        "case constants must be unique" "kotoba.error/subset-reject" form)
           t (synthetic env "case")
           tmp (dr-form t)
           disp (desugar-expr (dr-env t) (arg form 0))
           dflt (desugar-expr (dr-env disp) (condp-default-form form default?))
           folded (case-fold (dr-env dflt) tmp form 2 end (dr-form dflt))]
       (dr (dr-env folded) (form/call2 "let" (form/vec2 tmp (dr-form disp)) (dr-form folded)))))
   :default
(defn desugar-case [args form]
  (when (empty? args) (reject! "case requires a dispatch expression" form))
  (let [[dispatch & clauses] args
        default? (odd? (count clauses))
        default (if default? (last clauses) '(quot 1 0))
        pairs (partition 2 (if default? (butlast clauses) clauses))
        groups (map first pairs)
        constants (mapcat #(if (seq? %) % [%]) groups)
        literal? #(or (kotoba-integer? %) (keyword? %) (boolean? %) (string? %))]
    (when-not (every? literal? constants)
      (reject! "case constants must be bounded integer, keyword, boolean, or string literals" form))
    (when-not (all-distinct? constants)
      (reject! "case constants must be unique" form))
    (let [tmp (synthetic "case")]
      (list 'let [tmp (desugar-expr dispatch)]
            (reduce (fn [fallback [group result]]
                      (let [members (if (seq? group) group [group])
                            test (if (= 1 (count members))
                                   (list '= tmp (desugar-expr (first members)))
                                   (desugar-or
                                    (map #(list '= tmp (desugar-expr %)) members)))]
                        (list 'if test
                              (desugar-expr result) fallback)))
                    (desugar-expr default)
                    (reverse pairs)))))))

;; ARGS are the forms of FORM from index I
#?(:kotoba
   (defn desugar-comparison-chain [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] i :i64] [:ref :fe/dr]
     (let [n (- (form/count-of form) i)
           _ (require-k (or (string=? (form/symbol-value op) "=") (> n 0))
                        "ordered comparison requires at least one operand" "kotoba.error/subset-reject" form)]
       (if (= n 0)
         (dr env (form/bool-form true))
         (let [left (chain-temp "cmp" (+ n 1))
               a (desugar-expr env (form/nth-of form i))
               b (comparison-chain-rest (dr-env a) op left form (+ i 1))]
           (dr (dr-env b)
               (form/call2 "let" (form/vec2 left (dr-form a)) (dr-form b)))))))
   :default
(defn desugar-comparison-chain [op args form]
  (when (and (not= op '=) (empty? args))
    (reject! "ordered comparison requires at least one operand" form))
  ;; Comparisons are `:bool`-typed, so a chain folds to `true`/`false` rather
  ;; than 1/0 — otherwise the chain is an i64 that cannot compose with `and`,
  ;; `or`, `not` or another comparison.
  (letfn [(chain [left remaining]
            (if (empty? remaining)
              true
              (let [right (chain-temp "cmp" (count remaining))]
                (list 'let [right (desugar-expr (first remaining))]
                      (list 'if (list op left right)
                            (chain right (rest remaining)) false)))))]
    (if (empty? args)
      true
      (let [left (chain-temp "cmp" (inc (count args)))]
        (list 'let [left (desugar-expr (first args))]
              (chain left (rest args))))))))


#?(:kotoba
   (defn desugar-do [env [:ref :fe/env] form [:ref :form/r] i :i64] [:ref :fe/dr]
     (let [n (- (form/count-of form) i)]
       (cond
         (= n 0) (dr env (form/int-form 0))
         (= n 1) (desugar-expr env (form/nth-of form i))
         :else (let [t (synthetic env "do-tmp")
                     a (desugar-expr (dr-env t) (form/nth-of form i))
                     b (desugar-do (dr-env a) form (+ i 1))]
                 (dr (dr-env b)
                     (form/call2 "let" (form/vec2 (dr-form t) (dr-form a)) (dr-form b)))))))
   :default
(defn desugar-do
  "ADR-2607180900 L2: `(do a b c)` -> nested `let` returning last expression."
  [args]
  (cond
    (empty? args) 0
    (empty? (rest args)) (desugar-expr (first args))
    :else (let [tmp (synthetic "do-tmp")]
            (list 'let [tmp (desugar-expr (first args))]
                  (desugar-do (rest args)))))))

#?(:kotoba nil :default (defn f64-literal-key?
  "A floating literal in either of its two read forms: a host double on `:clj`,
  and the JVM-free reader's exact-bits `(f64-from-bits <i64>)` on `:cljs`."
  [form]
  (or (value/f64-value? form)
      (and (seq? form)
           (true? (:kotoba.reader/f64-literal (meta form)))))))

#?(:kotoba nil :default (def map-literal-value-constructors tables/map-literal-value-constructors))

#?(:kotoba nil :default (defn map-literal-value-type
  "The value type a literal's VALUE expression determines ON ITS OWN, or `nil`
  when it is an arbitrary expression whose type only inference can know.

  This is the map-value analogue of `closed-vector-literal-type`, and it is
  deliberately syntactic: `desugar-map` runs before inference, so the only
  types available here are the ones the source spells out. Floating literals
  are recognized so they can be refused BY NAME (see `desugar-map`) rather
  than reaching the generic arm."
  [form]
  (cond
    (boolean? form) :bool
    (kotoba-integer? form) :i64
    (string? form) :string
    (keyword? form) :keyword
    (f64-literal-key? form) :f64
    (seq? form)
    (let [head (first form)]
      (cond
        (= 'f64-from-bits head) :f64
        (= 'f32-from-bits head) :f32
        :else
        (let [declared (get map-literal-value-constructors head)
              descriptor (second form)]
          (when (and declared (vector? descriptor) (seq descriptor)
                     (= declared (first descriptor)))
            descriptor))))
    :else nil)))

#?(:kotoba nil :default (defn map-literal-type-description
  "A value type said the way the SOURCE says it, for a refusal message --
  `:string`, not `string`. The refusal names `typed-map-new` as the way to
  write the map the program wanted, and a reader has to be able to paste the
  type into it; `(name :string)` would print a descriptor that does not read."
  [type]
  (pr-str type)))

#?(:kotoba nil :default (defn map-literal-key-description-for-message
  "Which ENTRY a refusal is about. A Clojure map literal has no positions, so
  the entry is named by its key -- which is what the reader wrote, and what
  the canonical order is keyed on.

  An integer key goes through `str` and not `pr-str`, because a `.kotoba`
  integer literal is a JS bigint under `:cljs` and `pr-str` renders that as
  `#object[BigInt 1]`. Measured 2026-09-03: the first draft used `pr-str` for
  every key, was green on the JVM, and printed `map literal value at key
  #object[BigInt 1] ...` under nbb -- the SAME refusal saying two different
  things on the two runtimes this file claims. A string key keeps `pr-str`,
  which is what puts the quotes on."
  [key]
  (if (kotoba-integer? key) (str key) (pr-str key))))

#?(:kotoba nil :default (defn map-literal-key-kind [key]
  (cond (keyword? key) :keyword
        (kotoba-integer? key) :i64
        (string? key) :string
        :else nil)))

#?(:kotoba nil :default (defn map-literal-key-description
  "What a refused key IS, said in source terms. `(pr-str key)` alone would
  print `1.5` for a JVM double and `(f64-from-bits …)` for the same literal
  read JVM-free, so the KIND is named rather than the value shown."
  [key]
  (cond (f64-literal-key? key) "floating point"
        (boolean? key) "boolean"
        (seq? key) "expression"
        (symbol? key) "symbol"
        (vector? key) "vector"
        (map? key) "map"
        (set? key) "set"
        (nil? key) "nil"
        :else "unrecognized")))

#?(:kotoba nil :default (defn map-literal-item-type
  "The VALUE type of a bounded map literal, read off its own value expressions.

  A literal carries no annotation, so this is the only place the value half
  can come from. Every value whose type the source spells out has to agree on
  ONE type; values whose type only inference can know (an ordinary call, a
  local, an arithmetic form) contribute nothing here and are checked against
  the agreed type afterwards, exactly as they were checked against `:i64`
  before. A literal with no typed value at all keeps `:i64`, so an all-unknown
  literal lowers to the descriptor it always lowered to.

  Three refusals happen here rather than downstream, because downstream has
  only a type mismatch to report and this has the reason:

  * a FLOATING value, refused on the structured scalar ABI. This is NOT the
    floating-KEY refusal wearing a different hat. A key needs a total order
    and a decidable identity, and a float has neither; a value needs neither,
    and is refused only because `[:map K :f64]` has no encoding --
    `kotoba.kir.value/validate-value-type!` throws
    \"direct floating map keys or values are outside the structured scalar
    ABI\" for it, measured. The two facts are said as two messages.
  * DISAGREEING value types, naming both types and both entries.
  KEYWORD keys never reach this function: their literal is typed by
  `keyword-map-literal-record-fields` (a legacy pair map when every spelled
  value is `:i64`, a closed record otherwise), which is why the two float
  refusals below stay the typed map's alone -- a record field HAS an `:f64`
  encoding."
