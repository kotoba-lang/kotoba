            (list '= (desugar-expr (first args)) (desugar-expr (second args)))
            (desugar-comparison-chain '= args form))
        < (if (= 2 (count args))
            (list '< (desugar-expr (first args)) (desugar-expr (second args)))
            (desugar-comparison-chain '< args form))
        > (if (= 2 (count args))
            (list '> (desugar-expr (first args)) (desugar-expr (second args)))
            (desugar-comparison-chain '> args form))
        <= (if (= 2 (count args))
             (list '<= (desugar-expr (first args)) (desugar-expr (second args)))
