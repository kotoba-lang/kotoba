(ns kotoba.compiler.frontend.desugar
  "Module `desugar` of kotoba.compiler.frontend, cut from the original namespace by amu refactor split (287 forms, 5768 lines). Depends on: base, kernel-region, closure-types, expand, namespace-defs, validate, infer, record-projection."
  ;; the surface the other modules of the Kotoba route use (the analysis driver): the desugarer, the env accessors, the contract tables entry
  #?(:kotoba {:kotoba/export [desugar-expr desugar-result-expr put2 char-helper-name doc-append-from-helper-name lazy-drop-helper-name lazy-take-helper-name string-from-i64-helper-name expression-callable-contract with-contract-tables with-con env-con with-result with-lexical with-types with-options with-none with-abort-ctx with-loop-counter with-lambdas env-result env-lexical env-types env-options env-none? env-arities env-docfns env-abort-ctx env-loop-counter env-helpers env-shapes env-lambdas env-dispatchers env-uses-apply? env-uses-lazy? drs drs-env drs-forms dr-env dr-form]})
  (:require #?@(:kotoba [] :default [[kotoba.lang.coll :as set]])
            [kotoba.lang.text :as str]
            [kotoba.compiler.frontend-tables :as tables]
            [kotoba.kir.value :as value]
            #?@(:kotoba [[kotoba.form :as form] [kotoba.artifact.core :as artifact] [kotoba.compiler.value-type :as vt]])
            #?@(:kotoba [[kotoba.compiler.frontend.base :refer [dr env-counter form->document synthetic]]] :default [[kotoba.compiler.frontend.base :refer [capability-registry capability-wire-id effect-capability-id first-truthy form-span if-parts refuse-reader-tagged-host-literal! reject! reject-operation-arity! synthetic try-clause-parts #?@(:kotoba [dr])]]])
            #?@(:kotoba [[kotoba.compiler.frontend.kernel-region :refer [absence-marker? head-is? map-literal-record-type sym-is?]]] :default [[kotoba.compiler.frontend.kernel-region :refer [absence-marker? map-literal-key-order map-literal-record-type #?@(:kotoba [head-is? sym-is?])]]])
            #?@(:kotoba [[kotoba.compiler.frontend.closure-types :refer [callable-clauses callable-type? canonical-closure-result-type canonical-list-type? canonical-typed-map-type? closure-result-type? env-schemas generic-option-type? heterogeneous-vector-type? kw-text parametric-result-type? record-type? schema-ref-type? structured-type? typed-set-type? variant-type?]]] :default [[kotoba.compiler.frontend.closure-types :refer [callable-clauses callable-effect-row callable-type? canonical-closure-result-type canonical-list-type? canonical-typed-map-type? closure-result-type? closure-word-type dispatcher-key generic-option-type? heterogeneous-vector-type? i64-parameter-types? invoke-dispatcher-name max-record-fields parametric-result-type? record-type? structured-type? typed-set-type? validate-value-type! variant-type? #?@(:kotoba [env-schemas kw-text])]]])
            #?@(:kotoba [[kotoba.compiler.frontend.expand :refer [all-distinct?]]] :default [[kotoba.compiler.frontend.expand :refer [all-distinct? binding-symbols implicit-do-body kotoba-integer? max-parameters specialize-variadic-clause valid-name?]]])
            #?@(:kotoba [] :default [[kotoba.compiler.frontend.namespace-defs :refer [compiler-rejection? internal-failure! #?@(:kotoba [] :default [typed-vector-operations])]]])
            #?@(:kotoba [[kotoba.compiler.frontend.validate :refer [holds-symbol? max-typed-set-items]]] :default [[kotoba.compiler.frontend.validate :refer [document-reader-f64-form? holds-symbol? max-list-items max-typed-map-entries quote-form? quoted-symbol-datum-kind reject-quoted-symbol-datum!]]])
            #?@(:kotoba [[kotoba.compiler.frontend.infer :refer [kw-head? record-field-type]]] :default [[kotoba.compiler.frontend.infer :refer [record-field-type *module-list-fields* *module-list-inferred* #?@(:kotoba [kw-head?])]]])
            #?@(:kotoba [] :default [[kotoba.compiler.frontend.record-projection :refer [doc-nth-helper-name f32-literal-bits! match-has-marker]]]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]
                                 ;; a refusal: the Kotoba-route `reject!` throws one (ADR 0007)
                                 :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]] [:phase :string] [:data [:ref :form/r]]]]
                                 ;; the desugar env and its results (docs/selfhost-frontend-typemodel-design.md 1.2)
                                 :fe/env [:record :fe/env [[:counter :i64] [:result [:ref :form/r]] [:none :bool] [:arities [:ref :form/r]] [:lexical [:ref :form/r]] [:types [:ref :form/r]] [:docfns [:ref :form/r]] [:loop-counter :i64] [:tbl [:ref :form/r]] [:schemas [:ref :form/r]] [:lazy :bool] [:abort-ctx :string] [:used-caps [:ref :form/r]] [:options [:ref :form/r]] [:helpers [:ref :form/r]] [:shapes [:ref :form/r]] [:lambda-counter :i64] [:lambdas [:ref :form/r]] [:loop-result [:ref :form/r]] [:loop-known [:ref :form/r]] [:dispatchers [:ref :form/r]] [:uses-apply :bool] [:uses-lazy :bool] [:contracts [:ref :form/r]]]]
                                 :fe/dr [:record :fe/dr [[:env [:ref :fe/env]] [:form [:ref :form/r]]]]
                                 :fe/drs [:record :fe/drs [[:env [:ref :fe/env]] [:forms [:list [:ref :form/r]]]]]})))

;; amu-refactor: positional access.  Host: what [a b] destructuring does; Kotoba: Form child, nil-form past the end.
#?(:kotoba
   (defn- fe-nth [f [:ref :form/r] i :i64] [:ref :form/r] (form/nth-of f i))
   :default
   (defn- fe-nth [c i] (nth c i nil)))

;; amu-refactor: the rest after the first i children (nil / nil-form when none).
#?(:kotoba
   (defn- fe-nthnext [f [:ref :form/r] i :i64] [:ref :form/r]
     (let [n (form/count-of f)]
       (if (>= i n)
         (form/nil-form)
         (form/form-seq (loop [j i acc (form/no-forms)]
                          (if (>= j n) acc (recur (+ j 1) (form/append-form acc (form/nth-of f j)))))))))
   :default
   (defn- fe-nthnext [c i] (nthnext c i)))

;; amu-refactor: keyword lookup.  Host: `get`; Kotoba: form-get with a keyword Form.
#?(:kotoba
   (defn- fe-get [m [:ref :form/r] k :keyword] [:ref :form/r] (form/form-get m (form/keyword-form k)))
   :default
   (defn- fe-get [m k] (get m k)))


;; forward references inside this module (the cut keeps the original form order)
#?(:kotoba nil :default (declare desugar-result-expr desugar-expr chain-temp desugar-cond-value desugar-bool-expr desugar-cond-rest absence-marker-form thread-form desugar-tail-expressions desugar-comparison-chain desugar-head str-part sequenced-body args-from some-thread-temp all-literal? desugar-or top-level-function-symbol? desugar-ordinary-call sequence-first-chain desugar-sequence-first desugar-update require-rowed-callable-argument! reject-absent-field-conflict! reject-list-field-conflict! absent-field-type list-field-type desugar-absent-field-value guess-document-form? document-head-target desugar-and desugar-thread desugar-as-thread desugar-some-thread desugar-cond desugar-condp desugar-cond-thread desugar-case desugar-binding-some desugar-binding-if desugar-typed-op desugar-list-arm desugar-item-ctor desugar-hetero-ctor desugar-typed-map-new desugar-record-ctor desugar-record-get desugar-record-assoc desugar-hetero-assoc desugar-variant-new desugar-match-variant desugar-variant-match desugar-match-result desugar-result-match-of desugar-option-match desugar-match-option desugar-throw desugar-try desugar-catch-arm desugar-vector-i64-arm desugar-vector-f64-arm desugar-xorshift32 desugar-assoc-arm desugar-select-keys-arm desugar-merge-arm desugar-named-op args-from-loop desugar-expected-value desugar-map desugar-validate-error-type closed-vector-literal-type desugar-each-from ev-each-types all-keywords? note-used-capability desugar-do ^:dynamic *local-types* ^:dynamic *local-option-types* form-free-symbols desugar-list string-from-i64-helper-name map-literal-lowered-type desugar-expr*))


;; Dataspace v1 is a language-owned typed capability contract. These
;; descriptors intentionally match capability-kits/dataspace-v1.edn. Keeping
;; the source sugar here means HIR/KIR/backends only see ordinary closed
;; record/variant construction plus typed-cap-call; there is no second runtime
;; or authority path for coordination forms.
#?(:kotoba nil :default (def dataspace-assert-type
  [:record :kotoba.dataspace/assert [[:assertion :document] [:facet :i64]]]))
#?(:kotoba nil :default (def dataspace-retract-type
  [:record :kotoba.dataspace/retract [[:assertion :document] [:facet :i64]]]))
#?(:kotoba nil :default (def dataspace-observe-type
  [:record :kotoba.dataspace/observe [[:pattern :document] [:facet :i64]]]))
#?(:kotoba nil :default (def dataspace-request-type
  [:variant :kotoba.dataspace/request
   [[:assert dataspace-assert-type]
    [:retract dataspace-retract-type]
    [:observe dataspace-observe-type]
    [:facet-enter :bool]
    [:facet-leave :i64]]]))
#?(:kotoba nil :default (def dataspace-result-type
  [:variant :kotoba.dataspace/result
   [[:asserted [:record :kotoba.dataspace/asserted
                [[:count :i64] [:notices :document]]]]
    [:retracted [:record :kotoba.dataspace/retracted [[:count :i64]]]]
    [:matches [:record :kotoba.dataspace/matches
               [[:bindings :document] [:notices :document]]]]
    [:facet [:record :kotoba.dataspace/facet [[:id :i64]]]]
    [:error [:record :kotoba.dataspace/error
             [[:code :keyword] [:message :string]]]]]]))

#?(:kotoba
   (defn env-result [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :result))
   :default nil)

#?(:kotoba
   (defn env-none? [env [:ref :fe/env]] :bool (record-get [:ref :fe/env] env :none))
   :default nil)

#?(:kotoba
   (defn env-arities [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :arities))
   :default nil)

#?(:kotoba
   (defn env-lexical [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :lexical))
   :default nil)

#?(:kotoba
   (defn env-types [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :types))
   :default nil)

#?(:kotoba
   (defn env-docfns [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :docfns))
   :default nil)

#?(:kotoba
   (defn env-loop-counter [env [:ref :fe/env]] :i64 (record-get [:ref :fe/env] env :loop-counter))
   :default nil)

#?(:kotoba
   (defn with-lexical [env [:ref :fe/env] s [:ref :form/r]] [:ref :fe/env]
     (record-assoc [:ref :fe/env] env :lexical s))
   :default nil)

#?(:kotoba
   (defn with-loop-counter [env [:ref :fe/env] n :i64] [:ref :fe/env]
     (record-assoc [:ref :fe/env] env :loop-counter n))
   :default nil)

#?(:kotoba
   (defn with-result [env [:ref :fe/env] r [:ref :form/r]] [:ref :fe/env]
     (record-assoc [:ref :fe/env] env :result r))
   :default nil)

#?(:kotoba
   (defn dr-env [r [:ref :fe/dr]] [:ref :fe/env] (record-get [:ref :fe/dr] r :env))
   :default nil)

#?(:kotoba
   (defn dr-form [r [:ref :fe/dr]] [:ref :form/r] (record-get [:ref :fe/dr] r :form))
   :default nil)

#?(:kotoba
   (defn drs [env [:ref :fe/env] fs [:list [:ref :form/r]]] [:ref :fe/drs]
     (record-new [:ref :fe/drs] env fs))
   :default nil)

#?(:kotoba
   (defn drs-env [r [:ref :fe/drs]] [:ref :fe/env] (record-get [:ref :fe/drs] r :env))
   :default nil)

#?(:kotoba
   (defn drs-forms [r [:ref :fe/drs]] [:list [:ref :form/r]] (record-get [:ref :fe/drs] r :forms))
   :default nil)

;; a refusal with a stable code (the host `reject!`'s :kotoba.error/code, spelled as its text)
#?(:kotoba
   (defn fe-reject [msg :string code :string form [:ref :form/r]] [:ref :fe/err]
     (record-new [:ref :fe/err] msg code form "subset" (form/nil-form)))
   :default nil)

;; `(when-not ok (reject! msg form code))` as an aborting function: bind it in a `let`
#?(:kotoba
   (defn require-k [ok :bool msg :string code :string form [:ref :form/r]] :i64
     (if ok 0 (throw (fe-reject msg code form))))
   :default nil)

;; the Kotoba route has not ported this shape yet: the differential counts these, it does not compare them
#?(:kotoba
   (defn fe-unported [what :string form [:ref :form/r]] [:ref :fe/err]
     (record-new [:ref :fe/err] (string-concat "unported desugar form: " what) "kotoba.fe/unported" form "desugar" (form/nil-form)))
   :default nil)

;; `(simple-symbol? f)`: a symbol with no namespace (the lone `/` is one)
#?(:kotoba
   (defn simple-symbol-form? [f [:ref :form/r]] :bool
     (and (form/is-symbol? f)
          (or (< (string-find-byte (form/symbol-value f) 47 0) 0)
              (string=? (form/symbol-value f) "/"))))
   :default nil)

#?(:kotoba
   (defn document-ctx? [t [:ref :form/r]] :bool
     (and (form/is-keyword? t) (string=? (kw-text t) ":document")))
   :default nil)

#?(:kotoba
   (defn argc [form [:ref :form/r]] :i64 (- (form/count-of form) 1))
   :default nil)

#?(:kotoba
   (defn arg [form [:ref :form/r] k :i64] [:ref :form/r] (form/nth-of form (+ k 1)))
   :default nil)

;; the constant tables the dispatch reads, parsed ONCE per env (a Kotoba table accessor re-reads its EDN on every call)
#?(:kotoba
   (defn put2 [acc [:list [:ref :form/r]] k [:ref :form/r] v [:ref :form/r]] [:list [:ref :form/r]]
     (form/append-form (form/append-form acc k) v))
   :default nil)

#?(:kotoba
   (defn env-table [env [:ref :fe/env] k :keyword] [:ref :form/r]
     (form/form-get (record-get [:ref :fe/env] env :tbl) (form/keyword-form k)))
   :default nil)

;; the form at index I of FORM: under RESULT-TYPE when it is the last form and there is one
#?(:kotoba
   (defn desugar-tail-one [env [:ref :fe/env] result-type [:ref :form/r] form [:ref :form/r] i :i64] [:ref :fe/dr]
     (if (and (not (form/is-nil? result-type)) (= i (- (form/count-of form) 1)))
       (desugar-result-expr env result-type (form/nth-of form i))
       (desugar-expr env (form/nth-of form i))))
   :default nil)

;; the chain from the remaining operands [j, n) of FORM, LEFT the bound temp of the previous operand
#?(:kotoba
   (defn comparison-chain-rest [env [:ref :fe/env] op [:ref :form/r] left [:ref :form/r] form [:ref :form/r] j :i64] [:ref :fe/dr]
     (let [remaining (- (form/count-of form) j)]
       (if (= remaining 0)
         (dr env (form/bool-form true))
         (let [right (chain-temp "cmp" remaining)
               a (desugar-expr env (form/nth-of form j))
               b (comparison-chain-rest (dr-env a) op right form (+ j 1))]
           (dr (dr-env b)
               (form/call2 "let" (form/vec2 right (dr-form a))
                           (form/call3 "if" (form/call2 (form/symbol-value op) left right)
                                       (dr-form b) (form/bool-form false))))))))
   :default nil)

;; CLAUSES are the forms of FORM from index I (test/result pairs)
#?(:kotoba
   (defn desugar-cond-lower [env [:ref :fe/env] form [:ref :form/r] i :i64] [:ref :fe/dr]
     (let [n (- (form/count-of form) i)]
       (if (= n 0)
         (dr env (form/int-form 0))
         (let [test (form/nth-of form i)
               result (form/nth-of form (+ i 1))
               remaining (- n 2)]
           (if (form/eq test (form/keyword-form :else))
             (let [_ (require-k (= remaining 0) "cond :else clause must be last" "kotoba.error/subset-reject" form)]
               (desugar-cond-value env result))
             (let [t (desugar-bool-expr env test)
                   v (desugar-cond-value (dr-env t) result)
                   e (desugar-cond-rest (dr-env v) form (+ i 2) remaining)]
               (dr (dr-env e) (form/call3 "if" (dr-form t) (dr-form v) (dr-form e)))))))))
   :default nil)

;; what follows a cond clause: the remaining clauses, or the absence marker
#?(:kotoba
   (defn desugar-cond-rest [env [:ref :fe/env] form [:ref :form/r] i :i64 remaining :i64] [:ref :fe/dr]
     (if (> remaining 0)
       (desugar-cond-lower env form i)
       (dr env (absence-marker-form env))))
   :default nil)

#?(:kotoba
   (defn desugar-cond-value [env [:ref :fe/env] x [:ref :form/r]] [:ref :fe/dr]
     (if (form/is-nil? x)
       (dr env (form/call1 "__kotoba_absent" (form/keyword-form :nil)))
       (desugar-expr env x)))
   :default nil)

;; reduce thread-form over the steps of FORM from index I
#?(:kotoba
   (defn thread-steps [value [:ref :form/r] form [:ref :form/r] i :i64 last? :bool] [:ref :form/r]
     (if (>= i (form/count-of form))
       value
       (thread-steps (thread-form value (form/nth-of form i) last?) form (+ i 1) last?)))
   :default nil)

#?(:kotoba
   (defn as-thread-steps [value [:ref :form/r] name [:ref :form/r] form [:ref :form/r] i :i64] [:ref :form/r]
     (if (>= i (form/count-of form))
       value
       (as-thread-steps (form/call2 "let" (form/vec2 name value) (form/nth-of form i)) name form (+ i 1))))
   :default nil)

;; VALUE is the already desugared accumulator; the test/step pairs of FORM start at index I
#?(:kotoba
   (defn cond-thread-steps [env [:ref :fe/env] value [:ref :form/r] form [:ref :form/r] i :i64 last? :bool] [:ref :fe/dr]
     (if (>= i (form/count-of form))
       (dr env value)
       (let [test (form/nth-of form i)
             step (form/nth-of form (+ i 1))
             _ (require-k (and (form/is-seq? step) (> (form/count-of step) 0) (form/is-symbol? (form/nth-of step 0)))
                          (string-concat (if last? "cond->>" "cond->") " update must be a non-empty call form")
                          "kotoba.error/subset-reject" step)
             t (synthetic env "cond-thread")
             tmp (dr-form t)
             threaded (thread-form tmp step last?)
             a (desugar-bool-expr (dr-env t) test)
             b (desugar-expr (dr-env a) threaded)]
         (cond-thread-steps (dr-env b)
                            (form/call2 "let" (form/vec2 tmp value)
                                        (form/call3 "if" (dr-form a) (dr-form b) tmp))
                            form (+ i 2) last?))))
   :default nil)

;; the pairs of FORM from index I (up to END, exclusive), folded from the last to the first over FALLBACK
#?(:kotoba
   (defn condp-fold [env [:ref :fe/env] predicate [:ref :form/r] tmp [:ref :form/r] form [:ref :form/r]
                      i :i64 end :i64 fallback [:ref :form/r]] [:ref :fe/dr]
     (if (< i end)
       (let [j (- end 2)
             test (form/nth-of form j)
             result (form/nth-of form (+ j 1))
             a (desugar-expr env test)
             c (desugar-bool-expr (dr-env a) (form/call2 (form/symbol-value predicate) (dr-form a) tmp))
             d (desugar-expr (dr-env c) result)]
         (condp-fold (dr-env d) predicate tmp form i j (form/call3 "if" (dr-form c) (dr-form d) fallback)))
       (dr env fallback)))
   :default nil)

#?(:kotoba
   (defn condp-default-form [form [:ref :form/r] default? :bool] [:ref :form/r]
     (if default?
       (form/nth-of form (- (form/count-of form) 1))
       (form/call2 "quot" (form/int-form 1) (form/int-form 0))))
   :default nil)

#?(:kotoba
   (defn condp-has-arrow? [form [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of form))
       false
       (if (form/eq (form/nth-of form i) (form/keyword-form :>>))
         true
         (condp-has-arrow? form (+ i 1)))))
   :default nil)

;; the forms of FORM from index I, each desugared, in order
#?(:kotoba
   (defn desugar-each [env [:ref :fe/env] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-expr env (form/nth-of form i))]
         (desugar-each (dr-env r) form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; (HEAD ,@forms)
#?(:kotoba
   (defn head-call [head [:ref :form/r] forms [:list [:ref :form/r]]] [:ref :form/r]
     (form/form-seq (form/cons-onto head forms)))
   :default nil)

;; (NAME (desugar arg))-shaped heads: the arity is checked first
#?(:kotoba
   (defn desugar-operand [env [:ref :fe/env] form [:ref :form/r] msg :string] [:ref :fe/dr]
     (let [_ (require-k (= 1 (argc form)) msg "kotoba.error/subset-reject" form)]
       (desugar-expr env (arg form 0))))
   :default nil)

#?(:kotoba
   (defn desugar-if-branch [env [:ref :fe/env] ctx [:ref :form/r] x [:ref :form/r]] [:ref :fe/dr]
     (cond
       (form/is-nil? x) (dr env (form/call1 "__kotoba_absent" (form/keyword-form :nil)))
       (not (form/is-nil? ctx)) (desugar-result-expr env ctx x)
       :else (desugar-expr env x)))
   :default nil)

#?(:kotoba
   (defn desugar-if [env [:ref :fe/env] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 3 (argc form))
                        (string-concat "if requires test, then, else; got " (string-concat (string-from-i64 (argc form)) " arguments"))
                        "kotoba.error/if-arity" form)
           t (desugar-bool-expr env (arg form 0))
           a (desugar-if-branch (dr-env t) ctx (arg form 1))
           b (desugar-if-branch (dr-env a) ctx (arg form 2))]
       (dr (dr-env b) (form/call3 "if" (dr-form t) (dr-form a) (dr-form b)))))
   :default nil)

#?(:kotoba
   (defn desugar-do-arm [env [:ref :fe/env] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) "do requires at least one expression" "kotoba.error/do-empty" form)]
       (if (= 1 (argc form))
         (if (form/is-nil? ctx)
           (desugar-expr env (arg form 0))
           (desugar-result-expr env ctx (arg form 0)))
         (let [r (desugar-tail-expressions env ctx form 1 (form/no-forms))]
           (dr (drs-env r) (head-call (form/symbol-form "do") (drs-forms r)))))))
   :default nil)

;; (= a b) and the ordered comparisons: two operands stay a call, any other count is a chain
#?(:kotoba
   (defn desugar-binary-op [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (if (= 2 (argc form))
       (let [a (desugar-expr env (arg form 0))
             b (desugar-expr (dr-env a) (arg form 1))]
         (dr (dr-env b) (form/call2 (form/symbol-value op) (dr-form a) (dr-form b))))
       (desugar-comparison-chain env op form 1)))
   :default nil)

#?(:kotoba
   (defn desugar-not= [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (if (= 2 (argc form))
       (let [a (desugar-expr env (arg form 0))
             b (desugar-expr (dr-env a) (arg form 1))]
         (dr (dr-env b) (form/call3 "if" (form/call2 "=" (dr-form a) (dr-form b)) (form/bool-form false) (form/bool-form true))))
       (let [c (desugar-comparison-chain env (form/symbol-form "=") form 1)]
         (dr (dr-env c) (form/call3 "if" (dr-form c) (form/bool-form false) (form/bool-form true))))))
   :default nil)

#?(:kotoba
   (defn desugar-when-body [env [:ref :fe/env] form [:ref :form/r] single-only :bool] [:ref :fe/dr]
     ;; the body of when / when-not, forms from index 2: one form is itself, several a `do`, none 0 (when-not) or (do)
     (let [n (- (form/count-of form) 2)]
       (cond
         (= n 1) (desugar-expr env (form/nth-of form 2))
         (and (= n 0) (not single-only)) (dr env (form/int-form 0))
         :else (let [r (desugar-each env form 2 (form/no-forms))]
                 (dr (drs-env r) (head-call (form/symbol-form "do") (drs-forms r)))))))
   :default nil)

#?(:kotoba
   (defn desugar-when [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) "when requires a test expression" "kotoba.error/subset-reject" form)
           then (desugar-when-body env form true)
           t (desugar-bool-expr (dr-env then) (arg form 0))]
       (dr (dr-env t) (form/call3 "if" (dr-form t) (dr-form then) (absence-marker-form (dr-env t))))))
   :default nil)

#?(:kotoba
   (defn desugar-when-not [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) "when-not requires a test expression" "kotoba.error/subset-reject" form)
           then (desugar-when-body env form false)
           t (desugar-bool-expr (dr-env then) (arg form 0))]
       (dr (dr-env t) (form/call3 "if" (dr-form t) (absence-marker-form (dr-env t)) (dr-form then)))))
   :default nil)

#?(:kotoba
   (defn desugar-if-not-else [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (if (= 3 (argc form))
       (desugar-cond-value env (arg form 2))
       (dr env (absence-marker-form env))))
   :default nil)

#?(:kotoba
   (defn desugar-if-not [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (and (<= 2 (argc form)) (<= (argc form) 3)) "if-not requires then and optional else expressions"
                        "kotoba.error/subset-reject" form)
           t (desugar-bool-expr env (arg form 0))
           e (desugar-if-not-else (dr-env t) form)
           th (desugar-cond-value (dr-env e) (arg form 1))]
       (dr (dr-env th) (form/call3 "if" (dr-form t) (dr-form e) (dr-form th)))))
   :default nil)

;; (NAME ,@(map desugar-expr args)) with an arity check; `(get ...)`-style heads keep the authored head
#?(:kotoba
   (defn desugar-keep-head [env [:ref :fe/env] form [:ref :form/r] ok :bool msg :string] [:ref :fe/dr]
     (let [_ (require-k ok msg "kotoba.error/subset-reject" form)
           r (desugar-each env form 1 (form/no-forms))]
       (dr (drs-env r) (head-call (form/nth-of form 0) (drs-forms r)))))
   :default nil)

#?(:kotoba
   (defn desugar-some-arm [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 1 (argc form))
                        (if (= 2 (argc form))
                          "some with two arguments is clojure.core/some (a predicate over a collection); in this language `some` is the option constructor and takes one i64 operand -- search with filter / first, or write the loop"
                          "some requires one i64 operand")
                        "kotoba.error/subset-reject" form)
           a (desugar-expr env (arg form 0))]
       (dr (dr-env a) (form/call1 "option-some" (dr-form a)))))
   :default nil)

;; (OUTER (desugar arg)) with the one-operand check
#?(:kotoba
   (defn desugar-wrap1 [env [:ref :fe/env] form [:ref :form/r] msg :string outer :string] [:ref :fe/dr]
     (let [a (desugar-operand env form msg)]
       (dr (dr-env a) (form/call1 outer (dr-form a)))))
   :default nil)

;; (OUTER (desugar arg) CONST) for zero? pos? neg? empty?
#?(:kotoba
   (defn desugar-against-zero [env [:ref :fe/env] form [:ref :form/r] msg :string outer :string] [:ref :fe/dr]
     (let [a (desugar-operand env form msg)]
       (dr (dr-env a) (form/call2 outer (dr-form a) (form/int-form 0)))))
   :default nil)

;; ((fn ...) args): bound to a synthetic callee and called by name; the contextual result type rides along
#?(:kotoba
   (defn desugar-beta [env [:ref :fe/env] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [c (synthetic env "app_callee")
           callee (dr-form c)
           call (form/form-seq (form/cons-onto callee (form/rest-list form)))]
       (desugar-expr (with-result (dr-env c) ctx) (form/call2 "let" (form/vec2 callee (form/nth-of form 0)) call))))
   :default nil)

#?(:kotoba
   (defn desugar-wrap1-if [env [:ref :fe/env] form [:ref :form/r] msg :string] [:ref :fe/dr]
     (let [a (desugar-operand env form msg)]
       (dr (dr-env a) (form/call3 "if" (dr-form a) (form/bool-form false) (form/bool-form true)))))
   :default nil)

#?(:kotoba
   (defn desugar-second [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [a (desugar-operand env form "second requires one operand")]
       (dr (dr-env a) (form/call1 "pair-first" (form/call1 "pair-second" (dr-form a))))))
   :default nil)

#?(:kotoba
   (defn desugar-cons [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 2 (argc form)) "cons requires two operands" "kotoba.error/subset-reject" form)
           a (desugar-expr env (arg form 0))
           b (desugar-expr (dr-env a) (arg form 1))]
       (dr (dr-env b) (form/call2 "pair" (dr-form a) (dr-form b)))))
   :default nil)

#?(:kotoba
   (defn desugar-nil? [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [a (desugar-operand env form "nil? requires one option operand")]
       (dr (dr-env a) (form/call1 "bool-not" (form/call1 "option-some?" (dr-form a))))))
   :default nil)

#?(:kotoba
   (defn desugar-call [env [:ref :fe/env] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (if (= 0 (form/count-of form))
       ;; `()`: the host takes `(first form)` = nil as the head and the call falls through to an ordinary call of nil: `(nil)`
       (dr env (form/form-seq (form/one-form (form/nil-form))))
       (let [op (form/nth-of form 0)]
         (cond
           (form/is-keyword? op)
           (cond
             (= 2 (form/count-of form))
             (let [a (desugar-expr env (form/nth-of form 1))]
               (dr (dr-env a) (form/call2 "record-get" (dr-form a) op)))
             (= 3 (form/count-of form))
             (desugar-expr env (form/call3 "get" (form/nth-of form 1) op (form/nth-of form 2)))
             :else (desugar-ordinary-call env op form))
           (form/is-seq? op) (desugar-beta env form ctx)
           (form/is-symbol? op) (desugar-head env op form ctx)
           :else (desugar-ordinary-call env op form)))))
   :default nil)

#?(:kotoba
   (defn unported-head? [env [:ref :fe/env] name :string] :bool
     (tables/table-has? (env-table env :unported) (form/symbol-form name)))
   :default nil)

;; `lexical-call-form?`: the head is a local bound by an enclosing let/fn and is not a non-shadowable special head
#?(:kotoba
   (defn lexical-call? [env [:ref :fe/env] op [:ref :form/r]] :bool
     (and (tables/table-has? (env-lexical env) op)
          (not (tables/table-has? (env-table env :non-shadowable) op))))
   :default nil)

;; whether SOURCE form F is a :document as far as desugaring can tell without types
#?(:kotoba
   (defn guess-document-src [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (if (or (sym-is? op "map") (sym-is? op "mapv") (sym-is? op "filter") (sym-is? op "filterv") (sym-is? op "remove"))
       (form/nth-of form 2)
       (form/nth-of form 1)))
   :default nil)

;; the parts of FORM from index I, each as a :string operand
#?(:kotoba
   (defn str-parts [env [:ref :fe/env] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [p (str-part env (form/nth-of form i))]
         (str-parts (dr-env p) form (+ i 1) (form/append-form acc (dr-form p))))))
   :default nil)

#?(:kotoba
   (defn concat-parts [acc [:ref :form/r] parts [:list [:ref :form/r]] i :i64] [:ref :form/r]
     (if (>= i (vector-count parts))
       acc
       (concat-parts (form/call2 "string-concat" acc (typed-list-nth [:list [:ref :form/r]] parts i)) parts (+ i 1))))
   :default nil)

#?(:kotoba
   (defn desugar-str [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) "str requires at least one argument" "kotoba.error/subset-reject" form)]
       (if (= 1 (argc form))
         (desugar-expr env (arg form 0))
         (let [first-part (str-part env (arg form 0))
               rest-parts (str-parts (dr-env first-part) form 2 (form/no-forms))]
           (dr (drs-env rest-parts) (concat-parts (dr-form first-part) (drs-forms rest-parts) 0))))))
   :default nil)

#?(:kotoba
   (defn desugar-string-length [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 1 (argc form)) "string-length requires one string" "kotoba.error/subset-reject" form)
           a (desugar-result-expr env (form/keyword-form :string) (arg form 0))]
       (dr (dr-env a) (form/call1 "string-byte-length" (dr-form a)))))
   :default nil)

#?(:kotoba
   (defn desugar-string-from-i64 [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [a (desugar-operand env form "string-from-i64 requires one i64")]
       (dr (dr-env a) (form/call1 "__kotoba_string_from_i64" (dr-form a)))))
   :default nil)

#?(:kotoba
   (defn desugar-inc-dec [env [:ref :fe/env] form [:ref :form/r] msg :string op :string] [:ref :fe/dr]
     (let [a (desugar-operand env form msg)]
       (dr (dr-env a) (form/call2 op (dr-form a) (form/int-form 1)))))
   :default nil)

#?(:kotoba
   (defn desugar-rem [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 2 (argc form)) "rem requires two i64 operands" "kotoba.error/subset-reject" form)
           sa (synthetic env "rem_a")
           sb (synthetic (dr-env sa) "rem_b")
           a (desugar-expr (dr-env sb) (arg form 0))
           b (desugar-expr (dr-env a) (arg form 1))
           ta (dr-form sa)
           tb (dr-form sb)]
       (dr (dr-env b)
           (form/call2 "let" (form/vec4 ta (dr-form a) tb (dr-form b))
                       (form/call2 "-" ta (form/call2 "*" (form/call2 "quot" ta tb) tb))))))
   :default nil)

#?(:kotoba
   (defn desugar-mod [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 2 (argc form)) "mod requires two i64 operands" "kotoba.error/subset-reject" form)
           sa (synthetic env "mod_a")
           sb (synthetic (dr-env sa) "mod_b")
           sr (synthetic (dr-env sb) "mod_r")
           a (desugar-expr (dr-env sr) (arg form 0))
           b (desugar-expr (dr-env a) (arg form 1))
           ta (dr-form sa)
           tb (dr-form sb)
           tr (dr-form sr)
           zero (form/int-form 0)
           rv (form/call2 "-" ta (form/call2 "*" (form/call2 "quot" ta tb) tb))]
       (dr (dr-env b)
           (form/call2 "let" (form/vec6 ta (dr-form a) tb (dr-form b) tr rv)
                       (form/call3 "if" (form/call2 "=" tr zero) tr
                                   (form/call3 "if" (form/call2 "<" tr zero)
                                               (form/call3 "if" (form/call2 "<" tb zero) tr (form/call2 "+" tr tb))
                                               (form/call3 "if" (form/call2 "<" tb zero) (form/call2 "+" tr tb) tr)))))))
   :default nil)

#?(:kotoba
   (defn desugar-assert [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 1 (argc form)) "assert requires exactly one condition; messages are not supported"
                        "kotoba.error/subset-reject" form)
           a (desugar-bool-expr env (arg form 0))]
       (dr (dr-env a) (form/call3 "if" (dr-form a) (form/int-form 0) (form/call2 "quot" (form/int-form 1) (form/int-form 0))))))
   :default nil)

#?(:kotoba
   (defn desugar-bytes-arm [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 0 (argc form)) "bytes currently constructs only the canonical empty value"
                        "kotoba.error/subset-reject" form)]
       (dr env (form/call0 "bytes-empty"))))
   :default nil)

;; ---- let destructuring on the Kotoba route (selfhost S3): destructure-binding over Form ----
;; `(expand pattern value)` answers the flat list of [symbol expr] pairs (as 2-vectors) the host's `destructure-binding` builds, the
;; synthetic counter threaded through the temps (`__kotoba_destr_vector_N`, `__kotoba_destr_map_N`) and the desugared `:or` defaults.
#?(:kotoba
   (defn supported-pattern? [p [:ref :form/r]] :bool
     (or (form/is-symbol? p) (form/is-vec? p) (form/is-map? p)))
   :default nil)

;; the index of the first `&` of the vector V from I, the count when there is none
#?(:kotoba
   (defn amp-index [v [:ref :form/r] i :i64] :i64
     (cond
       (>= i (form/count-of v)) i
       (sym-is? (form/nth-of v i) "&") i
       :else (amp-index v (+ i 1))))
   :default nil)

#?(:kotoba
   (defn all-supported-patterns? [v [:ref :form/r] i :i64 end :i64] :bool
     (if (>= i end)
       true
       (and (supported-pattern? (form/nth-of v i)) (all-supported-patterns? v (+ i 1) end))))
   :default nil)

;; the pairs of positional items I..end-1: each item expanded against (nth tmp index)
#?(:kotoba
   (defn destructure-positional [env [:ref :fe/env] v [:ref :form/r] i :i64 end :i64 tmp [:ref :form/r] acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i end)
       (drs env acc)
       (let [r (destructure-expand env (form/nth-of v i) (form/call2 "nth" tmp (form/int-form i)))]
         (destructure-positional (dr-env r) v (+ i 1) end tmp (form/append-many acc (form/kids-of (dr-form r)))))))
   :default nil)

#?(:kotoba
   (defn destructure-vector [env [:ref :fe/env] candidate [:ref :form/r] value [:ref :form/r]] [:ref :fe/dr]
     (let [ts (synthetic env "destr-vector")
           tmp (dr-form ts)
           end (amp-index candidate 0)
           _ (require-k (all-supported-patterns? candidate 0 end)
                        "vector destructuring items must be symbols or nested vector/map patterns" "kotoba.error/subset-reject" candidate)
           rest-count (- (form/count-of candidate) end)
           _ (require-k (or (= 0 rest-count) (and (= 2 rest-count) (form/is-symbol? (form/nth-of candidate (+ end 1)))))
                        "`&` in vector destructuring must be followed by exactly one rest-binding symbol" "kotoba.error/subset-reject" candidate)
           items (destructure-positional (dr-env ts) candidate 0 end tmp (form/one-form (form/vec2 tmp value)))
           pairs (drs-forms items)]
       (dr (drs-env items)
           (form/form-vec (if (= 0 rest-count)
                            pairs
                            (form/append-form pairs (form/vec2 (form/nth-of candidate (+ end 1)) (form/call2 "vector-drop" tmp (form/int-form end)))))))))
   :default nil)

;; ---- names of symbols and keywords ----
;; the text after the namespace slash, and the namespace text ("" for none); the lone `/` is a bare name
#?(:kotoba
   (defn text-name [t :string] :string
     (let [i (string-find-byte t 47 0)]
       (if (or (< i 0) (string=? t "/")) t (string-substring t (+ i 1) (string-byte-length t)))))
   :default nil)

#?(:kotoba
   (defn text-namespace [t :string] :string
     (let [i (string-find-byte t 47 0)]
       (if (or (< i 0) (string=? t "/")) "" (string-substring t 0 i))))
   :default nil)

;; the keyword text without its colon
#?(:kotoba
   (defn keyword-bare [k [:ref :form/r]] :string
     (let [t (kw-text k)] (string-substring t 1 (string-byte-length t))))
   :default nil)

;; `:keys` / `:ns/keys` slots of the map pattern M (kid positions 0, 2, ...), as a Form list of the keyword keys
#?(:kotoba
   (defn keys-slots [m [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= (+ i 1) (form/count-of m))
       acc
       (let [k (form/nth-of m i)]
         (keys-slots m (+ i 2)
                     (if (and (form/is-keyword? k) (string=? (text-name (keyword-bare k)) "keys")) (form/append-form acc k) acc)))))
   :default nil)

#?(:kotoba
   (defn pattern-has-slot? [slots [:list [:ref :form/r]] k [:ref :form/r] i :i64] :bool
     (if (>= i (vector-count slots))
       false
       (or (form/eq k (typed-list-nth [:list [:ref :form/r]] slots i)) (pattern-has-slot? slots k (+ i 1)))))
   :default nil)

;; are all of the slots' values symbol vectors (a slot whose value is not a vector counts as the keyword itself: not a symbol)
#?(:kotoba
   (defn slots-all-symbols? [m [:ref :form/r] slots [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count slots))
       true
       (let [v (form/form-get m (typed-list-nth [:list [:ref :form/r]] slots i))]
         (and (form/is-vec? v) (all-symbols? v 0) (slots-all-symbols? m slots (+ i 1))))))
   :default nil)

;; the [name lookup-keyword] entries of the slot S: one per symbol k of its vector
#?(:kotoba
   (defn slot-key-entries [slot [:ref :form/r] v [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of v))
       acc
       (let [k (form/symbol-value (form/nth-of v i))
             ns (if (string=? (text-namespace k) "") (text-namespace (keyword-bare slot)) (text-namespace k))
             nm (text-name k)
             kw (form/edn-form (string-concat ":" (if (string=? ns "") nm (string-concat ns (string-concat "/" nm)))))]
         (slot-key-entries slot v (+ i 1) (form/append-form acc (form/vec2 (form/symbol-form nm) kw))))))
   :default nil)

#?(:kotoba
   (defn all-key-entries [m [:ref :form/r] slots [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count slots))
       acc
       (let [slot (typed-list-nth [:list [:ref :form/r]] slots i)
             v (form/form-get m slot)]
         (all-key-entries m slots (+ i 1)
                          (if (and (form/is-vec? v) (all-symbols? v 0)) (slot-key-entries slot v 0 acc) acc)))))
   :default nil)

;; the explicit [binding-pattern lookup-key] entries (everything but the :keys slots, :or and :as), ordered by the printed lookup key
#?(:kotoba
   (defn explicit-position [sorted [:list [:ref :form/r]] key-text :string i :i64] :i64
     (if (>= i (vector-count sorted))
       i
       (if (> (string-compare (pr-form (form/nth-of (typed-list-nth [:list [:ref :form/r]] sorted i) 1)) key-text) 0)
         i
         (explicit-position sorted key-text (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn explicit-entries [m [:ref :form/r] slots [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= (+ i 1) (form/count-of m))
       acc
       (let [k (form/nth-of m i)]
         (if (or (pattern-has-slot? slots k 0) (form/eq k (form/keyword-form :or)) (form/eq k (form/keyword-form :as)))
           (explicit-entries m slots (+ i 2) acc)
           (let [e (form/vec2 k (form/nth-of m (+ i 1)))
                 p (explicit-position acc (pr-form (form/nth-of m (+ i 1))) 0)]
             (explicit-entries m slots (+ i 2)
                               (slice-forms acc p (vector-count acc) (form/append-form (slice-forms acc 0 p (form/no-forms)) e))))))))
   :default nil)

;; every explicit entry has a supported binding pattern and a keyword lookup key
#?(:kotoba
   (defn explicit-valid? [es [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count es))
       true
       (let [e (typed-list-nth [:list [:ref :form/r]] es i)]
         (and (supported-pattern? (form/nth-of e 0)) (form/is-keyword? (form/nth-of e 1)) (explicit-valid? es (+ i 1))))))
   :default nil)

;; a symbol among the direct bindings: a key name or a symbol binding pattern of an explicit entry
#?(:kotoba
   (defn direct-symbol? [x [:ref :form/r] key-entries [:list [:ref :form/r]] explicit [:list [:ref :form/r]]] :bool
     (or (direct-in-entries? x key-entries 0) (direct-in-entries? x explicit 0)))
   :default nil)

#?(:kotoba
   (defn direct-in-entries? [x [:ref :form/r] es [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count es))
       false
       (or (form/eq x (form/nth-of (typed-list-nth [:list [:ref :form/r]] es i) 0)) (direct-in-entries? x es (+ i 1)))))
   :default nil)

;; every key of the :or map is a symbol bound directly
#?(:kotoba
   (defn defaults-valid? [defaults [:ref :form/r] key-entries [:list [:ref :form/r]] explicit [:list [:ref :form/r]] i :i64] :bool
     (if (>= (+ i 1) (form/count-of defaults))
       true
       (let [k (form/nth-of defaults i)]
         (and (form/is-symbol? k) (direct-symbol? k key-entries explicit)
              (defaults-valid? defaults key-entries explicit (+ i 2))))))
   :default nil)

;; the lookup of the entry (binding-pattern, key): with the desugared :or default when the pattern is a defaulted symbol
#?(:kotoba
   (defn destructure-map-entries [env [:ref :fe/env] tmp [:ref :form/r] entries [:list [:ref :form/r]] i :i64 defaults [:ref :form/r] acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (vector-count entries))
       (drs env acc)
       (let [e (typed-list-nth [:list [:ref :form/r]] entries i)
             pat (form/nth-of e 0)
             key (form/nth-of e 1)
             defaulted? (and (form/is-symbol? pat) (form/is-map? defaults) (form/form-has? defaults pat))
             dflt (if defaulted? (desugar-expr env (form/form-get defaults pat)) (dr env (form/nil-form)))
             lookup (if defaulted?
                      (form/call3 "__kotoba_destructure_get" tmp key (dr-form dflt))
                      (form/call2 "__kotoba_destructure_get" tmp key))
             r (destructure-expand (dr-env dflt) pat lookup)]
         (destructure-map-entries (dr-env r) tmp entries (+ i 1) defaults (form/append-many acc (form/kids-of (dr-form r)))))))
   :default nil)

#?(:kotoba
   (defn destructure-map [env [:ref :fe/env] candidate [:ref :form/r] value [:ref :form/r]] [:ref :fe/dr]
     (let [slots (keys-slots candidate 0 (form/no-forms))
           key-entries (all-key-entries candidate slots 0 (form/no-forms))
           defaults-raw (form/form-get candidate (form/keyword-form :or))
           defaults (if (form/is-nil? defaults-raw) (form/form-map (form/no-forms)) defaults-raw)
           as-name (form/form-get candidate (form/keyword-form :as))
           explicit (explicit-entries candidate slots 0 (form/no-forms))
           _ (require-k (and (slots-all-symbols? candidate slots 0)
                             (form/is-map? defaults)
                             (defaults-valid? defaults key-entries explicit 0)
                             (or (form/is-nil? as-name) (form/is-symbol? as-name))
                             (explicit-valid? explicit 0)
                             (or (> (vector-count key-entries) 0) (> (vector-count explicit) 0) (not (form/is-nil? as-name))))
                        "map destructuring requires :keys, :as, or keyword-valued explicit entries, with :or defaults for direct symbol bindings"
                        "kotoba.error/subset-reject" candidate)
           ts (synthetic env "destr-map")
           tmp (dr-form ts)
           r (destructure-map-entries (dr-env ts) tmp (form/append-many key-entries explicit) 0 defaults (form/one-form (form/vec2 tmp value)))]
       (dr (drs-env r)
           (form/form-vec (if (form/is-nil? as-name)
                            (drs-forms r)
                            (form/append-form (drs-forms r) (form/vec2 as-name tmp)))))))
   :default nil)

;; the [symbol expr] pairs binding PATTERN against the already-desugared VALUE, as a Form vector of 2-vectors
#?(:kotoba
   (defn destructure-expand [env [:ref :fe/env] candidate [:ref :form/r] value [:ref :form/r]] [:ref :fe/dr]
     (cond
       (form/is-symbol? candidate) (dr env (form/form-vec (form/one-form (form/vec2 candidate value))))
       (form/is-vec? candidate) (destructure-vector env candidate value)
       (form/is-map? candidate) (destructure-map env candidate value)
       :else (throw (fe-reject "unsupported destructuring pattern" "kotoba.error/subset-reject" candidate))))
   :default nil)

;; ---- let: the bindings lowered in sequence (patterns expanded, :i64 / :document locals recorded), then the body ----
#?(:kotoba
   (defn lexical-add-pairs [lex [:ref :form/r] pairs [:ref :form/r] i :i64] [:ref :form/r]
     (if (>= i (form/count-of pairs))
       lex
       (lexical-add-pairs (set-add lex (form/nth-of (form/nth-of pairs i) 0)) pairs (+ i 1))))
   :default nil)

#?(:kotoba
   (defn flatten-pairs [pairs [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of pairs))
       acc
       (flatten-pairs pairs (+ i 1)
                      (form/append-form (form/append-form acc (form/nth-of (form/nth-of pairs i) 0)) (form/nth-of (form/nth-of pairs i) 1)))))
   :default nil)

#?(:kotoba
   (defn lower-let-bindings [env [:ref :fe/env] bindings [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of bindings))
       (drs env acc)
       (let [pattern (form/nth-of bindings i)
             value (form/nth-of bindings (+ i 1))
             types (env-types env)
             value-contract (expression-callable-contract env value)
             document? (and (form/is-symbol? pattern) (guess-document-form? env value))
             v (desugar-expr env value)
             expanded (destructure-expand (dr-env v) pattern (dr-form v))
             pairs (dr-form expanded)
             integer? (and (form/is-symbol? pattern) (not document?) (str-integer-form? env value))
             next-types (cond
                          document? (types-assoc types pattern (form/keyword-form :document))
                          integer? (types-assoc types pattern (form/keyword-form :i64))
                          :else types)
             env1 (with-types (with-lexical (dr-env expanded) (lexical-add-pairs (env-lexical (dr-env expanded)) pairs 0)) next-types)
             env2 (if (and (form/is-symbol? pattern) (not (form/is-nil? value-contract)))
                    (with-con env1 :lexical (types-assoc (env-con env1 :lexical) pattern value-contract))
                    env1)]
         (lower-let-bindings env2 bindings (+ i 2) (form/append-many acc (flatten-pairs pairs 0 (form/no-forms)))))))
   :default nil)

#?(:kotoba
   (defn desugar-let [env [:ref :fe/env] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [bindings (arg form 0)]
       (if (and (form/is-vec? bindings) (= 0 (rem (form/count-of bindings) 2)))
         (let [saved (env-lexical env)
               saved-types (env-types env)
               saved-contracts (env-con env :lexical)
               lowered (lower-let-bindings env bindings 0 (form/no-forms))
               body (desugar-tail-expressions (drs-env lowered) ctx form 2 (form/no-forms))
               sb (sequenced-body (drs-forms body) form "let")]
           (dr (with-con (with-types (with-lexical (drs-env body) saved) saved-types) :lexical saved-contracts)
               (form/call2 "let" (form/form-vec (drs-forms lowered)) sb)))
         (let [r (desugar-each env form 2 (form/no-forms))]
           (dr (drs-env r) (form/form-seq (form/cons-onto (form/symbol-form "let") (form/cons-onto bindings (drs-forms r)))))))))
   :default nil)




#?(:kotoba
   (defn binding-if-else [env [:ref :fe/env] form [:ref :form/r] when? :bool] [:ref :form/r]
     (if when?
       (absence-marker-form env)
       (if (= 4 (form/count-of form))
         (form/nth-of form 3)
         (absence-marker-form env))))
   :default nil)

#?(:kotoba
   (defn binding-if-then [form [:ref :form/r] when? :bool] [:ref :form/r]
     ;; bodies are the forms of FORM from index 2
     (if when?
       (if (= 1 (- (form/count-of form) 2))
         (form/nth-of form 2)
         (form/form-seq (form/cons-onto (form/symbol-form "do") (args-from form 2))))
       (form/nth-of form 2)))
   :default nil)

#?(:kotoba
   (defn some-thread-lower [env [:ref :fe/env] value-form [:ref :form/r] form [:ref :form/r] i :i64 last? :bool] [:ref :fe/dr]
     (if (>= i (form/count-of form))
       (let [a (desugar-expr env value-form)]
         (dr (dr-env a) (form/call1 "__kotoba_some_last" (dr-form a))))
       (let [t (some-thread-temp env)
             tmp (dr-form t)
             threaded (thread-form (form/call1 "__kotoba_present" tmp) (form/nth-of form i) last?)
             a (desugar-expr (dr-env t) value-form)
             b (some-thread-lower (dr-env a) threaded form (+ i 1) last?)]
         (dr (dr-env b)
             (form/call2 "let" (form/vec2 tmp (dr-form a))
                         (form/call2 "__kotoba_some_bind" tmp (dr-form b)))))))
   :default nil)

;; the temp of one `some->` step: numbered by the loop counter when the analysis has one, else by the synthetic counter
#?(:kotoba
   (defn some-thread-temp [env [:ref :fe/env]] [:ref :fe/dr]
     (if (>= (env-loop-counter env) 0)
       (let [n (+ (env-loop-counter env) 1)]
         (dr (with-loop-counter env n) (form/symbol-form (string-concat "some-thread__" (string-from-i64 n)))))
       (synthetic env "some-thread")))
   :default nil)

#?(:kotoba
   (defn case-literal? [x [:ref :form/r]] :bool
     (or (form/is-int? x) (form/is-keyword? x) (form/is-bool? x) (form/is-string? x)))
   :default nil)

;; every constant of the clause groups (a list group contributes its members) is a literal
#?(:kotoba
   (defn case-constants-ok? [form [:ref :form/r] i :i64 end :i64] :bool
     (if (>= i end)
       true
       (let [g (form/nth-of form i)]
         (and (if (form/is-seq? g) (all-literal? (form/kids-of g) 0) (case-literal? g))
              (case-constants-ok? form (+ i 2) end)))))
   :default nil)

#?(:kotoba
   (defn all-literal? [kids [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count kids))
       true
       (and (case-literal? (typed-list-nth [:list [:ref :form/r]] kids i)) (all-literal? kids (+ i 1)))))
   :default nil)

;; the constants of the groups of FORM from index I to END (step 2), as one flat list
#?(:kotoba
   (defn case-constants [form [:ref :form/r] i :i64 end :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i end)
       acc
       (let [g (form/nth-of form i)]
         (case-constants form (+ i 2) end
                         (if (form/is-seq? g) (form/append-many acc (form/kids-of g)) (form/append-form acc g))))))
   :default nil)

;; the tests of one clause group: (= tmp X') for each member, desugared in order
#?(:kotoba
   (defn case-member-tests [env [:ref :fe/env] tmp [:ref :form/r] members [:list [:ref :form/r]] i :i64
                             acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (vector-count members))
       (drs env acc)
       (let [a (desugar-expr env (typed-list-nth [:list [:ref :form/r]] members i))]
         (case-member-tests (dr-env a) tmp members (+ i 1) (form/append-form acc (form/call2 "=" tmp (dr-form a)))))))
   :default nil)

#?(:kotoba
   (defn case-group-test [env [:ref :fe/env] tmp [:ref :form/r] group [:ref :form/r]] [:ref :fe/dr]
     (let [members (if (form/is-seq? group) (form/kids-of group) (form/one-form group))
           tests (case-member-tests env tmp members 0 (form/no-forms))]
       (if (= 1 (vector-count members))
         (dr (drs-env tests) (typed-list-nth [:list [:ref :form/r]] (drs-forms tests) 0))
         (desugar-or (drs-env tests) (form/form-seq (form/cons-onto (form/symbol-form "or") (drs-forms tests))) 1))))
   :default nil)

;; the pairs [i, end) of FORM folded from the last over FALLBACK
#?(:kotoba
   (defn case-fold [env [:ref :fe/env] tmp [:ref :form/r] form [:ref :form/r] i :i64 end :i64 fallback [:ref :form/r]] [:ref :fe/dr]
     (if (< i end)
       (let [j (- end 2)
             test (case-group-test env tmp (form/nth-of form j))
             r (desugar-expr (dr-env test) (form/nth-of form (+ j 1)))]
         (case-fold (dr-env r) tmp form i j (form/call3 "if" (dr-form test) (dr-form r) fallback)))
       (dr env fallback)))
   :default nil)

;; X under RTYPE when there is one (not nil), else as it stands
#?(:kotoba
   (defn desugar-under [env [:ref :fe/env] rtype [:ref :form/r] x [:ref :form/r]] [:ref :fe/dr]
     (if (form/is-nil? rtype)
       (desugar-expr env x)
       (desugar-result-expr env rtype x)))
   :default nil)

;; (OP ,@args) with the args at the indexes in IDX desugared under RTYPE (idx a Form set; nil-form: none)
#?(:kotoba
   (defn desugar-indexed [env [:ref :fe/env] form [:ref :form/r] idx [:ref :form/r] rtype [:ref :form/r]
                           i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-under env (if (tables/table-has? idx (form/int-form (- i 1))) rtype (form/nil-form))
                              (form/nth-of form i))]
         (desugar-indexed (dr-env r) form idx rtype (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

#?(:kotoba
   (defn desugar-indexed-call [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] idx [:ref :form/r] rtype [:ref :form/r]] [:ref :fe/dr]
     (let [r (desugar-indexed env form idx rtype 1 (form/no-forms))]
       (dr (drs-env r) (head-call op (drs-forms r)))))
   :default nil)

;; every argument under one result type
#?(:kotoba
   (defn desugar-all-under [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] rtype [:ref :form/r] i :i64
                             acc [:list [:ref :form/r]]] [:ref :fe/dr]
     (if (>= i (form/count-of form))
       (dr env (head-call op acc))
       (let [r (desugar-result-expr env rtype (form/nth-of form i))]
         (desugar-all-under (dr-env r) op form rtype (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; document-map: the odd-indexed arguments (value positions) are :document
#?(:kotoba
   (defn desugar-document-map [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/dr]
     (if (>= i (form/count-of form))
       (dr env (head-call op acc))
       (let [r (desugar-under env (if (= 1 (rem (- i 1) 2)) (form/keyword-form :document) (form/nil-form))
                              (form/nth-of form i))]
         (desugar-document-map (dr-env r) op form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; contextual-vector-f64-argument-types: index -> expected type
#?(:kotoba
   (defn desugar-typed-indexed [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] expected [:ref :form/r] i :i64
                                 acc [:list [:ref :form/r]]] [:ref :fe/dr]
     (if (>= i (form/count-of form))
       (dr env (head-call op acc))
       (let [want (form/form-get expected (form/int-form (- i 1)))
             r (desugar-under env want (form/nth-of form i))]
         (desugar-typed-indexed (dr-env r) op form expected (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; typed-vector-operations: first operand a :vector-i64
#?(:kotoba
   (defn desugar-typed-vector-op [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [arity (tables/table-get (env-table env :typed-vec) op)
           _ (require-k (= (form/int-value arity) (argc form))
                        (string-concat "typed vector operation arity mismatch: "
                          (string-concat (form/symbol-value op)
                            (string-concat " takes "
                              (string-concat (string-from-i64 (form/int-value arity))
                                (string-concat (if (= 1 (form/int-value arity)) " argument" " arguments")
                                  (string-concat "; got " (string-from-i64 (argc form))))))))
                        "kotoba.error/call-arity" form)]
       (desugar-indexed-call env op form (form/form-set (form/one-form (form/int-form 0))) (form/keyword-form :vector-i64))))
   :default nil)

;; ---- loop/recur on the Kotoba route (selfhost S3): the helper registries as env fields ----
;; The host keeps `*pending-loop-helpers*` (an atom of synthesized helper definitions), `*loop-helper-shapes*` (a volatile
;; map helper-name -> shape), `*loop-result-type*` and `*loop-known-types*` (dynamic overrides) beside `*loop-counter*`.
;; Here they are :fe/env fields: `helpers` is a Form vector the pass APPENDS to (the caller of the whole analysis reads it
;; back and injects the definitions into the module), `shapes` a Form map, `loop-result`/`loop-known` the overrides
;; (nil-form for none). A pass that lowers through a loop returns the grown env, exactly as it returns the counter.
#?(:kotoba
   (defn env-abort-ctx [env [:ref :fe/env]] :string (record-get [:ref :fe/env] env :abort-ctx))
   :default nil)

#?(:kotoba
   (defn with-abort-ctx [env [:ref :fe/env] s :string] [:ref :fe/env]
     (record-assoc [:ref :fe/env] env :abort-ctx s))
   :default nil)

#?(:kotoba
   (defn with-types [env [:ref :fe/env] t [:ref :form/r]] [:ref :fe/env]
     (record-assoc [:ref :fe/env] env :types t))
   :default nil)

#?(:kotoba
   (defn env-helpers [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :helpers))
   :default nil)

#?(:kotoba
   (defn env-shapes [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :shapes))
   :default nil)

#?(:kotoba
   (defn env-loop-result [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :loop-result))
   :default nil)

#?(:kotoba
   (defn env-loop-known [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :loop-known))
   :default nil)

;; `(swap! *pending-loop-helpers* conj helper)`
#?(:kotoba
   (defn with-helper [env [:ref :fe/env] helper [:ref :form/r]] [:ref :fe/env]
     (record-assoc [:ref :fe/env] env :helpers
                   (form/form-vec (form/append-form (form/kids-of (env-helpers env)) helper))))
   :default nil)

;; `(vswap! *loop-helper-shapes* assoc helper-name shape)`
#?(:kotoba
   (defn with-shape [env [:ref :fe/env] name [:ref :form/r] shape [:ref :form/r]] [:ref :fe/env]
     (record-assoc [:ref :fe/env] env :shapes (form/assoc-form (env-shapes env) name shape)))
   :default nil)

;; `(binding [*loop-result-type* r *loop-known-types* k] ...)` is `with-loop-overrides` and `restore-loop-overrides`
#?(:kotoba
   (defn with-loop-overrides [env [:ref :fe/env] result [:ref :form/r] known [:ref :form/r]] [:ref :fe/env]
     (record-assoc [:ref :fe/env] (record-assoc [:ref :fe/env] env :loop-result result) :loop-known known))
   :default nil)

;; the bound-name set grown by one name
#?(:kotoba
   (defn set-add [s [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
     (if (tables/table-has? s x)
       s
       (form/form-set (form/append-form (form/kids-of s) x))))
   :default nil)

;; `form-free-symbols`: the symbols FORM references as VALUES (never call heads) that are not in BOUND, as a Form set
;; (ACC grows). Runs on an ALREADY DESUGARED form: every `let` has plain-symbol bindings.
#?(:kotoba
   (defn free-syms [f [:ref :form/r] bound [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
     (cond
       (form/is-symbol? f) (if (tables/table-has? bound f) acc (set-add acc f))
       (form/is-seq? f)
       (cond
         (= 0 (form/count-of f)) acc
         (sym-is? (form/nth-of f 0) "let") (free-syms-let f bound acc)
         (sym-is? (form/nth-of f 0) "try") (free-syms-try f bound acc)
         :else (free-syms-kids f 1 bound acc))
       (or (form/is-vec? f) (form/is-set? f) (form/is-map? f)) (free-syms-kids f 0 bound acc)
       :else acc))
   :default nil)

#?(:kotoba
   (defn free-syms-kids [f [:ref :form/r] i :i64 bound [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (form/count-of f))
       acc
       (let [a (free-syms (form/nth-of f i) bound acc)]
         (free-syms-kids f (+ i 1) bound a))))
   :default nil)

;; (let [n v ...] body...): each value is scanned with the names bound before it, the body with all of them
#?(:kotoba
   (defn free-syms-let [f [:ref :form/r] bound [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
     (if (< (form/count-of f) 2)
       acc
       (free-syms-let-pairs f (form/nth-of f 1) 0 bound acc)))
   :default nil)

#?(:kotoba
   (defn free-syms-let-pairs [f [:ref :form/r] bindings [:ref :form/r] i :i64 bound [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
     (if (< (+ i 1) (form/count-of bindings))
       (let [a (free-syms (form/nth-of bindings (+ i 1)) bound acc)]
         (free-syms-let-pairs f bindings (+ i 2) (set-add bound (form/nth-of bindings i)) a))
       (free-syms-kids-from f 2 bound acc)))
   :default nil)

#?(:kotoba
   (defn free-syms-kids-from [f [:ref :form/r] i :i64 bound [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
     (free-syms-kids f i bound acc))
   :default nil)

;; (try body (catch [type] binder handler)): the binder is bound in the handler and nowhere else
#?(:kotoba
   (defn free-syms-try [f [:ref :form/r] bound [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
     (let [clause (if (> (form/count-of f) 2) (form/nth-of f 2) (form/nil-form))
           _ (require-k (head-is? clause "catch") "try requires a (catch [error-type] binder handler) clause" "kotoba.error/abort-shape" f)
           parts (- (form/count-of clause) 1)
           _ (require-k (or (= 2 parts) (= 3 parts))
                        "catch requires an optional error type, one binder, and one handler expression"
                        "kotoba.error/abort-shape" f)
           binder (form/nth-of clause (if (= 2 parts) 1 2))
           handler (form/nth-of clause (if (= 2 parts) 2 3))
           _ (require-k (simple-symbol-form? binder) "catch binder must be an unqualified symbol" "kotoba.error/abort-shape" f)
           a (free-syms (form/nth-of f 1) bound acc)]
       (free-syms handler (set-add bound binder) a)))
   :default nil)

;; a Form list of the symbols of the Form set S in `(sort-by str ...)` order
#?(:kotoba
   (defn first-greater [xs [:list [:ref :form/r]] x [:ref :form/r] i :i64] :i64
     (if (>= i (vector-count xs))
       i
       (if (> (string-compare (form/symbol-value (typed-list-nth [:list [:ref :form/r]] xs i)) (form/symbol-value x)) 0)
         i
         (first-greater xs x (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn slice-forms [xs [:list [:ref :form/r]] from :i64 to :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= from to)
       acc
       (slice-forms xs (+ from 1) to (form/append-form acc (typed-list-nth [:list [:ref :form/r]] xs from)))))
   :default nil)

#?(:kotoba
   (defn insert-sorted [xs [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
     (let [p (first-greater xs x 0)]
       (slice-forms xs p (vector-count xs) (form/append-form (slice-forms xs 0 p (form/no-forms)) x))))
   :default nil)

#?(:kotoba
   (defn sorted-symbols [s [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of s))
       acc
       (sorted-symbols s (+ i 1) (insert-sorted acc (form/nth-of s i)))))
   :default nil)

;; `replace-recur`: every `(recur a b ...)` of the desugared loop body becomes a call of HELPER-NAME with the new loop
;; values followed by the CAPTURED values unchanged. Only seq forms are walked (the host does not enter vectors).
#?(:kotoba
   (defn replace-recur-k [f [:ref :form/r] helper [:ref :form/r] n :i64 captured [:list [:ref :form/r]]] [:ref :form/r]
     (if (form/is-seq? f)
       (if (= 0 (form/count-of f))
         (form/form-seq (form/one-form (form/nil-form)))
         (if (sym-is? (form/nth-of f 0) "recur")
           (let [_ (require-k (= (- (form/count-of f) 1) n) "recur argument count must match loop bindings" "kotoba.error/subset-reject" f)]
             (form/form-seq (form/cons-onto helper (form/append-many (form/rest-list f) captured))))
           (let [kids (replace-recur-each f 1 helper n captured (form/no-forms))]
             (form/form-seq (form/cons-onto (form/nth-of f 0) kids)))))
       f))
   :default nil)

#?(:kotoba
   (defn replace-recur-each [f [:ref :form/r] i :i64 helper [:ref :form/r] n :i64 captured [:list [:ref :form/r]]
                             acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of f))
       acc
       (let [k (replace-recur-k (form/nth-of f i) helper n captured)]
         (replace-recur-each f (+ i 1) helper n captured (form/append-form acc k)))))
   :default nil)

;; the symbols at the even positions of the binding vector B from I, true when every one is a symbol
#?(:kotoba
   (defn even-symbols? [b [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of b))
       true
       (and (form/is-symbol? (form/nth-of b i)) (even-symbols? b (+ i 2)))))
   :default nil)

;; the elements of B at I, I+2, ... as a list
#?(:kotoba
   (defn strided [b [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of b))
       acc
       (strided b (+ i 2) (form/append-form acc (form/nth-of b i)))))
   :default nil)

;; the inits (odd positions) of the loop binding vector, desugared in order
#?(:kotoba
   (defn desugar-loop-inits [env [:ref :fe/env] b [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of b))
       (drs env acc)
       (let [r (desugar-expr env (form/nth-of b i))]
         (desugar-loop-inits (dr-env r) b (+ i 2) (form/append-form acc (dr-form r))))))
   :default nil)

;; the local types with every binding whose init is certainly an i64 marked :i64
#?(:kotoba
   (defn loop-integer-types [env [:ref :fe/env] b [:ref :form/r] i :i64 types [:ref :form/r]] [:ref :form/r]
     (if (>= (+ i 1) (form/count-of b))
       types
       (loop-integer-types env b (+ i 2)
                           (if (str-integer-form? env (form/nth-of b (+ i 1)))
                             (types-assoc types (form/nth-of b i) (form/keyword-form :i64))
                             types))))
   :default nil)

#?(:kotoba
   (defn join-symbols [xs [:list [:ref :form/r]] i :i64 acc :string] :string
     (if (>= i (vector-count xs))
       acc
       (join-symbols xs (+ i 1)
                     (string-concat (if (> i 0) (string-concat acc ", ") acc)
                                    (form/symbol-value (typed-list-nth [:list [:ref :form/r]] xs i))))))
   :default nil)

#?(:kotoba
   (defn plural-s [n :i64] :string (if (= n 1) "" "s"))
   :default nil)

;; loop bindings plus captured outer variables beyond the ABI ceiling (max-parameters = 64)
#?(:kotoba
   (defn loop-ceiling-message [names :i64 captured [:list [:ref :form/r]] total :i64] :string
     (string-concat
      (string-concat
       (string-concat
        (string-concat
         (string-concat
          (string-concat
           (string-concat
            (string-concat
             (string-concat "loop bindings plus captured outer variables exceed this compiler's ABI-supported arity: "
                            (string-from-i64 names))
             (string-concat " binding" (plural-s names)))
            " plus ")
           (string-from-i64 (vector-count captured)))
          (string-concat " captured outer variable" (plural-s (vector-count captured))))
         (string-concat " is " (string-from-i64 total)))
        ", and the limit is 64")
       (if (> (vector-count captured) 0)
         (string-concat "; the captured variables are " (join-symbols captured 0 ""))
         ""))
      ""))
   :default nil)

#?(:kotoba
   (defn loop-shape [n :i64 declared [:ref :form/r] known [:ref :form/r]] [:ref :form/r]
     (let [base (form/assoc-form (form/assoc-form (form/form-map (form/no-forms)) (form/keyword-form :bindings) (form/int-form n))
                                 (form/keyword-form :declared-result) declared)]
       (if (and (form/is-map? known) (> (form/count-of known) 0))
         (form/assoc-form base (form/keyword-form :known-types) known)
         base)))
   :default nil)

#?(:kotoba
   (defn loop-helper-def [helper [:ref :form/r] params [:ref :form/r] result [:ref :form/r] body [:ref :form/r]] [:ref :form/r]
     (form/assoc-form
      (form/assoc-form
       (form/assoc-form
        (form/assoc-form
         (form/assoc-form
          (form/assoc-form (form/form-map (form/no-forms)) (form/keyword-form :name) helper)
          (form/keyword-form :params) params)
         (form/keyword-form :result) result)
        (form/keyword-form :effects) (form/form-set (form/no-forms)))
       (form/keyword-form :loop-helper?) (form/bool-form true))
      (form/keyword-form :body) body))
   :default nil)

;; (loop [n init ...] body) -> a call of a synthesized recursive helper `__kotoba_loop_N`; the helper's definition and shape
;; are appended to the env (ADR-2607150000), every free variable of the body is captured as an extra parameter
#?(:kotoba
   (defn desugar-loop [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [bindings (if (> (argc form) 0) (arg form 0) (form/nil-form))
           _ (require-k (and (form/is-vec? bindings) (= 0 (rem (form/count-of bindings) 2)) (even-symbols? bindings 0))
                        "loop requires an even vector of plain-symbol bindings (destructure inside the body instead)"
                        "kotoba.error/subset-reject" form)
           _ (require-k (= 1 (- (argc form) 1)) "loop requires exactly one body expression (this profile has no `do`)"
                        "kotoba.error/subset-reject" form)
           names (strided bindings 0 (form/no-forms))
           inits (desugar-loop-inits env bindings 1 (form/no-forms))
           env1 (drs-env inits)
           saved-ctx (env-abort-ctx env1)
           saved-types (env-types env1)
           body-env (with-types (with-abort-ctx env1 "loop")
                      (loop-integer-types env1 bindings 0 (if (form/is-map? saved-types) saved-types (form/form-map (form/no-forms)))))
           body (desugar-expr body-env (arg form 1))
           env2 (with-types (with-abort-ctx (dr-env body) saved-ctx) saved-types)
           desugared (dr-form body)
           free (free-syms desugared (form/form-set names) (form/form-set (form/no-forms)))
           captured (sorted-symbols free 0 (form/no-forms))
           n (+ (env-loop-counter env2) 1)
           helper (form/symbol-form (string-concat "__kotoba_loop_" (string-from-i64 n)))
           params (form/append-many names captured)
           _ (require-k (<= (vector-count params) 64)
                        (loop-ceiling-message (vector-count names) captured (vector-count params))
                        "kotoba.error/loop-parameter-ceiling" form)
           result (if (form/is-nil? (env-loop-result env2)) (form/keyword-form :i64) (env-loop-result env2))
           new-body (replace-recur-k desugared helper (vector-count names) captured)
           env3 (with-shape (with-helper (with-loop-counter env2 n)
                              (loop-helper-def helper (form/form-vec params) result new-body))
                  helper (loop-shape (vector-count names) (env-loop-result env2) (env-loop-known env2)))]
       (dr env3 (form/form-seq (form/cons-onto helper (form/append-many (drs-forms inits) captured))))))
   :default nil)

;; ---- filter / remove / reduce / mapv / filterv / into / map / map-indexed on the Kotoba route (selfhost S3) ----
;; These lower through `loop`, so they feed the helper registries the same way (the loop override fields `loop-result`/`loop-known`
;; are bound for the extent of the final desugar and restored). A STORED callback (a closure value) needs the closure-dispatcher
;; registry of `request-invoke-dispatcher`, which is not an env field yet: such a call is refused as unported, after the refusals
;; the host makes first.
#?(:kotoba
   (defn implicit-do-list [xs [:list [:ref :form/r]]] [:ref :form/r]
     (if (= 1 (vector-count xs))
       (typed-list-nth [:list [:ref :form/r]] xs 0)
       (head-call (form/symbol-form "do") xs)))
   :default nil)

;; the lexical set grown by every element of PARAMS
#?(:kotoba
   (defn lex-add-vec [lex [:ref :form/r] params [:ref :form/r] i :i64] [:ref :form/r]
     (if (>= i (form/count-of params))
       lex
       (lex-add-vec (set-add lex (form/nth-of params i)) params (+ i 1))))
   :default nil)

;; every symbol anywhere in PATTERN (except `&`): the host's `binding-symbols`
#?(:kotoba
   (defn pattern-symbols [p [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
     (cond
       (form/is-symbol? p) (if (string=? (form/symbol-value p) "&") acc (set-add acc p))
       (or (form/is-seq? p) (form/is-vec? p) (form/is-set? p) (form/is-map? p)) (pattern-symbols-kids p 0 acc)
       :else acc))
   :default nil)

#?(:kotoba
   (defn pattern-symbols-kids [p [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (form/count-of p))
       acc
       (pattern-symbols-kids p (+ i 1) (pattern-symbols (form/nth-of p i) acc))))
   :default nil)

#?(:kotoba
   (defn lex-add-set [lex [:ref :form/r] syms [:ref :form/r]] [:ref :form/r]
     (lex-add-vec lex syms 0))
   :default nil)

;; a call form (HEAD a b ...) from a symbol name and a list of operands
#?(:kotoba
   (defn named-call [name :string xs [:list [:ref :form/r]]] [:ref :form/r]
     (head-call (form/symbol-form name) xs))
   :default nil)

;; `(binding [*lexical-bindings* (into lex syms) *abort-lexical-context* :fn] (desugar-expr body))`, the env restored after
#?(:kotoba
   (defn desugar-in-fn-scope [env [:ref :fe/env] syms [:ref :form/r] body [:ref :form/r]] [:ref :fe/dr]
     (let [saved-lex (env-lexical env)
           saved-ctx (env-abort-ctx env)
           r (desugar-expr (with-abort-ctx (with-lexical env (lex-add-set saved-lex syms)) "fn") body)]
       (dr (with-abort-ctx (with-lexical (dr-env r) saved-lex) saved-ctx) (dr-form r))))
   :default nil)

;; `(binding [*loop-result-type* R *loop-known-types* K] (desugar-expr form))`, the overrides restored after
#?(:kotoba
   (defn desugar-with-loop-overrides [env [:ref :fe/env] result [:ref :form/r] known [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [saved-result (env-loop-result env)
           saved-known (env-loop-known env)
           r (desugar-expr (with-loop-overrides env result known) form)]
       (dr (with-loop-overrides (dr-env r) saved-result saved-known) (dr-form r))))
   :default nil)

;; {name type ...} from a list of alternating entries
#?(:kotoba
   (defn known-map [entries [:list [:ref :form/r]] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= (+ i 1) (vector-count entries))
       acc
       (known-map entries (+ i 2)
                  (form/assoc-form acc (typed-list-nth [:list [:ref :form/r]] entries i) (typed-list-nth [:list [:ref :form/r]] entries (+ i 1))))))
   :default nil)

#?(:kotoba
   (defn invoke-name-bool1 [] [:ref :form/r] (form/symbol-form "__kotoba_invoke_bool$arity1"))
   :default nil)

#?(:kotoba
   (defn invoke-name-i64 [arity :i64] [:ref :form/r]
     (form/symbol-form (string-concat "__kotoba_invoke$arity" (string-from-i64 arity))))
   :default nil)

;; the predicate of a filter/remove as an expression over the element X
#?(:kotoba
   (defn filter-pred-body [env [:ref :fe/env] opn :string p-form [:ref :form/r] named? :bool inline? :bool cb [:ref :form/r] x [:ref :form/r]] [:ref :fe/dr]
     (cond
       inline?
       (let [params (if (> (form/count-of p-form) 1) (form/nth-of p-form 1) (form/nil-form))
             _ (require-k (and (form/is-vec? params) (= 1 (form/count-of params)) (all-symbols? params 0) (> (form/count-of p-form) 2))
                          (string-concat opn " pred must be (fn [x] single-expr)") "kotoba.error/subset-reject" p-form)
             r (desugar-in-fn-scope env params (implicit-do-list (args-from p-form 2)))]
         (dr (dr-env r) (form/call2 "let" (form/vec2 (form/nth-of params 0) x) (dr-form r))))
       named? (dr env (form/form-seq (form/two-forms p-form x)))
       :else (dr env (form/form-seq (form/three-forms (invoke-name-bool1) cb x)))))
   :default nil)

;; (filter pred coll) / (remove pred coll): a bounded loop over a vector-i64 that keeps (or drops) the elements the predicate admits
#?(:kotoba
   (defn desugar-filter [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [opn (form/symbol-value op)
           _ (require-k (= 2 (argc form)) (string-concat opn " requires pred and one vector-i64 collection") "kotoba.error/subset-reject" form)
           p-form (arg form 0)
           cr (desugar-vector-i64-source env (arg form 1))
           vs (synthetic (dr-env cr) "filter_v")
           is (synthetic (dr-env vs) "filter_i")
           as (synthetic (dr-env is) "filter_acc")
           xs (synthetic (dr-env as) "filter_x")
           v (dr-form vs) i (dr-form is) acc (dr-form as) x (dr-form xs)
           named? (top-level-function-symbol? (dr-env xs) p-form)
           inline? (head-is? p-form "fn")
           stored? (not (or named? inline?))
           cs (if stored? (synthetic (dr-env xs) "filter_callback") (dr (dr-env xs) (form/nil-form)))
           cb (dr-form cs)
           pb (filter-pred-body (dr-env cs) opn p-form named? inline? cb x)
           pred (if (string=? opn "remove") (form/call1 "not" (dr-form pb)) (dr-form pb))
           known (known-map (if stored?
                              (form/cons-onto i (form/cons-onto (form/keyword-form :i64)
                                (form/cons-onto acc (form/cons-onto (form/keyword-form :vector-i64)
                                  (form/cons-onto v (form/cons-onto (form/keyword-form :vector-i64)
                                    (form/cons-onto cb (form/one-form (form/keyword-form :i64)))))))))
                              (form/cons-onto i (form/cons-onto (form/keyword-form :i64)
                                (form/cons-onto acc (form/cons-onto (form/keyword-form :vector-i64)
                                  (form/cons-onto v (form/one-form (form/keyword-form :vector-i64))))))))
                            0 (form/form-map (form/no-forms)))
           bindings (if stored?
                      (form/vec4 cb p-form v (dr-form cr))
                      (form/vec2 v (dr-form cr)))
           loop-form (form/call2 "loop" (form/vec4 i (form/int-form 0) acc (form/call0 "vector-i64"))
                       (form/call3 "if" (form/call2 "<" i (form/call1 "vector-count" v))
                         (form/call2 "let" (form/vec2 x (form/call2 "vector-at" v i))
                           (form/call2 "recur" (form/call2 "+" i (form/int-form 1))
                             (form/call3 "if" pred (form/call2 "vector-conj" acc x) acc)))
                         acc))]
       (desugar-with-loop-overrides (dr-env pb) (form/keyword-form :vector-i64) known
                                    (form/call2 "let" bindings loop-form))))
   :default nil)

;; primitive fold operators
#?(:kotoba
   (defn reduce-primitive? [env [:ref :fe/env] f [:ref :form/r]] :bool
     (and (form/is-symbol? f)
          (not (tables/table-has? (env-lexical env) f))
          (let [n (form/symbol-value f)]
            (or (string=? n "+") (string=? n "-") (string=? n "*") (string=? n "bit-and") (string=? n "bit-or") (string=? n "bit-xor")))))
   :default nil)

;; (map inc|dec (map inc|dec ... coll)): [coll callbacks-innermost-first] or nil-form when the collection is not such a chain
#?(:kotoba
   (defn reduce-map-chain [env [:ref :fe/env] cand [:ref :form/r] cbs [:list [:ref :form/r]]] [:ref :form/r]
     (if (and (form/is-seq? cand) (= 3 (form/count-of cand)) (sym-is? (form/nth-of cand 0) "map")
              (form/is-symbol? (form/nth-of cand 1))
              (not (tables/table-has? (env-lexical env) (form/nth-of cand 1)))
              (or (sym-is? (form/nth-of cand 1) "inc") (sym-is? (form/nth-of cand 1) "dec")))
       (reduce-map-chain env (form/nth-of cand 2) (form/cons-onto (form/nth-of cand 1) cbs))
       (if (> (vector-count cbs) 0)
         (form/vec2 cand (form/form-vec cbs))
         (form/nil-form))))
   :default nil)

;; the element at I of the vector V under the map-chain callbacks (innermost first)
#?(:kotoba
   (defn reduce-chain-item [value [:ref :form/r] cbs [:ref :form/r] i :i64] [:ref :form/r]
     (if (>= i (form/count-of cbs))
       value
       (reduce-chain-item (if (sym-is? (form/nth-of cbs i) "inc")
                            (form/call2 "+" value (form/int-form 1))
                            (form/call2 "-" value (form/int-form 1)))
                          cbs (+ i 1))))
   :default nil)

;; true when no symbol of PARAMS (a parameter vector) is `&` anywhere inside it
#?(:kotoba
   (defn no-rest-marker? [p [:ref :form/r]] :bool
     (cond
       (form/is-symbol? p) (not (string=? (form/symbol-value p) "&"))
       (or (form/is-seq? p) (form/is-vec? p) (form/is-set? p) (form/is-map? p)) (no-rest-marker-kids? p 0)
       :else true))
   :default nil)

#?(:kotoba
   (defn no-rest-marker-kids? [p [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of p))
       true
       (and (no-rest-marker? (form/nth-of p i)) (no-rest-marker-kids? p (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn pattern-param? [p [:ref :form/r]] :bool
     (or (form/is-symbol? p) (form/is-vec? p) (form/is-map? p)))
   :default nil)

#?(:kotoba
   (defn every-pattern-param? [ps [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of ps))
       true
       (and (pattern-param? (form/nth-of ps i)) (every-pattern-param? ps (+ i 1)))))
   :default nil)

;; the body of the fold step for the callback F: (f acc item) for a primitive or a named function, the inlined `fn` body under a
;; `let` of its parameters otherwise
#?(:kotoba
   (defn reduce-step [env [:ref :fe/env] f [:ref :form/r] primitive? :bool named? :bool cb [:ref :form/r] acc [:ref :form/r] item [:ref :form/r]] [:ref :fe/dr]
     (cond
       primitive? (dr env (form/form-seq (form/three-forms f acc item)))
       (head-is? f "fn")
       (let [params (if (> (form/count-of f) 1) (form/nth-of f 1) (form/nil-form))
             _ (require-k (and (form/is-vec? params) (= 2 (form/count-of params)) (every-pattern-param? params 0)
                               (no-rest-marker? params) (> (form/count-of f) 2))
                          "reduce fn must be (fn [acc x] single-expr)" "kotoba.error/subset-reject" f)
             r (desugar-in-fn-scope env (pattern-symbols params (form/form-set (form/no-forms))) (implicit-do-list (args-from f 2)))]
         (dr (dr-env r) (form/call2 "let" (form/vec4 (form/nth-of params 0) acc (form/nth-of params 1) item) (dr-form r))))
       named? (dr env (form/form-seq (form/three-forms f acc item)))
       :else (dr env (form/form-seq (form/cons-onto (invoke-name-i64 2) (form/three-forms cb acc item))))))
   :default nil)

;; the list-typed collection symbol's declared type (nil-form when it is not a symbol local of a canonical list type)
#?(:kotoba
   (defn reduce-list-type [env [:ref :fe/env] coll [:ref :form/r]] [:ref :form/r]
     (if (and (form/is-symbol? coll) (form/is-map? (env-types env)))
       (let [t (form/form-get (env-types env) coll)]
         (if (canonical-list-type? t) t (form/nil-form)))
       (form/nil-form)))
   :default nil)

#?(:kotoba
   (defn reduce-source [env [:ref :fe/env] plain? :bool coll [:ref :form/r] stripped [:ref :form/r]] [:ref :fe/dr]
     (if plain? (desugar-expr env coll) (desugar-vector-i64-source env stripped)))
   :default nil)

;; (reduce f init coll): a loop over the collection by index; the callback is inlined when it is a primitive, a named function or a
;; literal `fn`. The 2-arity (no init) form lowers the callback as a closure value and is not ported.
#?(:kotoba
   (defn desugar-reduce [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (or (= 2 (argc form)) (= 3 (argc form)))
                        "reduce requires callback+collection or callback+init+collection" "kotoba.error/subset-reject" form)]
       (if (= 2 (argc form))
         (desugar-reduce-no-init env form)
         (desugar-reduce-init env form))))
   :default nil)

#?(:kotoba
   (defn desugar-reduce-init [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [f (arg form 0)
           init-form (arg form 1)
           coll-form (arg form 2)
           list-type (reduce-list-type env coll-form)
           list? (not (form/is-nil? list-type))
           document? (and (not list?) (guess-document-form? env coll-form))
           primitive? (reduce-primitive? env f)
           chain (if (and (not list?) (not document?) primitive?)
                   (reduce-map-chain env coll-form (form/no-forms))
                   (form/nil-form))
           init-r (desugar-expr env init-form)
           coll-r (reduce-source (dr-env init-r) (or list? document?) coll-form (if (form/is-nil? chain) coll-form (form/nth-of chain 0)))
           vs (synthetic (dr-env coll-r) "reduce_v")
           is (synthetic (dr-env vs) "reduce_i")
           as (synthetic (dr-env is) "reduce_acc")
           v (dr-form vs) i (dr-form is) acc (dr-form as)
           named? (top-level-function-symbol? (dr-env as) f)
           stored? (not (or primitive? named? (head-is? f "fn")))
           cs (if stored? (synthetic (dr-env as) "reduce_callback") (dr (dr-env as) (form/nil-form)))
           cb (dr-form cs)
           item (cond
                  document? (form/call2 "__kotoba_doc_nth" v i)
                  list? (form/call3 "typed-list-nth" list-type v i)
                  :else (reduce-chain-item (form/call2 "vector-at" v i) (if (form/is-nil? chain) (form/form-vec (form/no-forms)) (form/nth-of chain 1)) 0))
           step (reduce-step (dr-env cs) f primitive? named? cb acc item)
           vtype (cond list? list-type document? (form/keyword-form :document) :else (form/keyword-form :vector-i64))
           known0 (form/assoc-form (form/assoc-form (form/form-map (form/no-forms)) i (form/keyword-form :i64)) v vtype)
           known (if stored? (form/assoc-form known0 cb (form/keyword-form :i64)) known0)
           bindings (if stored? (form/vec4 cb f v (dr-form coll-r)) (form/vec2 v (dr-form coll-r)))]
       (desugar-with-loop-overrides (dr-env step) (env-loop-result (dr-env step)) known
         (form/call2 "let" bindings
           (form/call2 "loop" (form/vec4 i (form/int-form 0) acc (dr-form init-r))
             (form/call3 "if" (form/call2 "<" i (form/call1 (if document? "document-count" "vector-count") v))
               (form/call2 "recur" (form/call2 "+" i (form/int-form 1)) (dr-form step))
               acc))))))
   :default nil)

;; ---- a printer for the few forms a refusal message quotes (`pr-str` of a parameter pattern) ----
#?(:kotoba
   (defn pr-kids [f [:ref :form/r] i :i64 sep :string acc :string] :string
     (if (>= i (form/count-of f))
       acc
       (pr-kids f (+ i 1) sep (string-concat (if (> i 0) (string-concat acc sep) acc) (pr-form (form/nth-of f i))))))
   :default nil)

;; a map prints its entries as `k v, k v`
#?(:kotoba
   (defn pr-map-entries [f [:ref :form/r] i :i64 acc :string] :string
     (if (>= (+ i 1) (form/count-of f))
       acc
       (pr-map-entries f (+ i 2)
                       (string-concat (if (> i 0) (string-concat acc ", ") acc)
                                      (string-concat (pr-form (form/nth-of f i)) (string-concat " " (pr-form (form/nth-of f (+ i 1)))))))))
   :default nil)

#?(:kotoba
   (defn pr-form [f [:ref :form/r]] :string
     (cond
       (form/is-nil? f) "nil"
       (form/is-bool? f) (if (form/bool-value f) "true" "false")
       (form/is-int? f) (string-from-i64 (form/int-value f))
       (form/is-string? f) (string-concat "\"" (string-concat (form/string-value f) "\""))
       (form/is-keyword? f) (kw-text f)
       (form/is-symbol? f) (form/symbol-value f)
       (form/is-seq? f) (string-concat "(" (string-concat (pr-kids f 0 " " "") ")"))
       (form/is-vec? f) (string-concat "[" (string-concat (pr-kids f 0 " " "") "]"))
       (form/is-set? f) (string-concat "#{" (string-concat (pr-kids f 0 " " "") "}"))
       (form/is-map? f) (string-concat "{" (string-concat (pr-map-entries f 0 "") "}"))
       :else "?"))
   :default nil)

;; the first element of the vector PARAMS that is not a symbol (nil-form when all are)
#?(:kotoba
   (defn first-non-symbol [ps [:ref :form/r] i :i64] [:ref :form/r]
     (cond
       (>= i (form/count-of ps)) (form/nil-form)
       (form/is-symbol? (form/nth-of ps i)) (first-non-symbol ps (+ i 1))
       :else (form/nth-of ps i)))
   :default nil)

;; no element of the vector PS is equal to a later one
#?(:kotoba
   (defn all-distinct-from? [ps [:ref :form/r] x [:ref :form/r] j :i64] :bool
     (if (>= j (form/count-of ps))
       true
       (and (not (form/eq x (form/nth-of ps j))) (all-distinct-from? ps x (+ j 1)))))
   :default nil)

#?(:kotoba
   (defn forms-distinct? [ps [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of ps))
       true
       (and (all-distinct-from? ps (form/nth-of ps i) (+ i 1)) (forms-distinct? ps (+ i 1)))))
   :default nil)

;; what kind of literal a stored callback is, "" when it is a possible closure value
#?(:kotoba
   (defn callback-literal-kind [f [:ref :form/r]] :string
     (cond
       (form/is-keyword? f) "keyword"
       (form/is-string? f) "string"
       (form/is-int? f) "integer"
       (form/is-bool? f) "boolean"
       (form/is-nil? f) "nil"
       (form/is-vec? f) "vector"
       (form/is-map? f) "map"
       (form/is-set? f) "set"
       :else ""))
   :default nil)

#?(:kotoba
   (defn callback-wrapper-head? [env [:ref :fe/env] f [:ref :form/r]] :bool
     (and (form/is-seq? f) (> (form/count-of f) 0)
          (let [h (form/nth-of f 0)]
            (and (or (sym-is? h "partial") (sym-is? h "comp") (sym-is? h "juxt") (sym-is? h "complement"))
                 (not (tables/table-has? (env-arities env) h))
                 (not (tables/table-has? (env-lexical env) h))))))
   :default nil)

;; whether the named function F of the module has an arity N
#?(:kotoba
   (defn function-has-arity? [env [:ref :fe/env] f [:ref :form/r] n :i64] :bool
     (let [a (tables/table-get (env-arities env) f)]
       (and (not (form/is-nil? a)) (tables/table-has? a (form/int-form n)))))
   :default nil)

;; the refusals a stored (closure-value) callback of map / map-indexed meets before lowering; NAME is "map" or "map-indexed"
#?(:kotoba
   (defn check-stored-callback [env [:ref :fe/env] name :string f [:ref :form/r] source :string example :string] :i64
     (let [kind (callback-literal-kind f)
           _ (require-k (string=? kind "")
                        (string-concat name
                          (string-concat " callback must be a named function, an inline fn, or a closure value; got a "
                            (string-concat kind
                              (string-concat " literal -- a "
                                (string-concat source " source is a vector-i64 and its item is an i64, so no keyword or literal can map it")))))
                        "kotoba.error/subset-reject" f)
           _ (require-k (not (callback-wrapper-head? env f))
                        (string-concat name
                          (string-concat " callback ("
                            (string-concat (form/symbol-value (form/nth-of f 0))
                              (string-concat " ...) is not admitted: "
                                (string-concat (form/symbol-value (form/nth-of f 0))
                                  (string-concat " is not a head of this language; write the callback as " example))))))
                        "kotoba.error/subset-reject" f)]
       0))
   :default nil)

;; the direct sources: map_source_0 .. map_source_{n-1}, each a synthetic symbol (threaded counter)
#?(:kotoba
   (defn map-direct-sources [env [:ref :fe/env] i :i64 n :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i n)
       (drs env acc)
       (let [s (synthetic env (string-concat "map_source_" (string-from-i64 i)))]
         (map-direct-sources (dr-env s) (+ i 1) n (form/append-form acc (dr-form s))))))
   :default nil)

;; the source values: each collection argument under the vector-i64 context, in order
#?(:kotoba
   (defn map-source-values [env [:ref :fe/env] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-vector-i64-source env (form/nth-of form i))]
         (map-source-values (dr-env r) form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; [:vector [:vector-i64 ...]] with N entries
#?(:kotoba
   (defn map-source-type [n :i64] [:ref :form/r]
     (form/vec2 (form/keyword-form :vector) (form/form-vec (map-repeat-vector-i64 n (form/no-forms)))))
   :default nil)

#?(:kotoba
   (defn map-repeat-vector-i64 [n :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (<= n 0) acc (map-repeat-vector-i64 (- n 1) (form/append-form acc (form/keyword-form :vector-i64)))))
   :default nil)

;; source I as an expression: the packed hetero-vector element or the direct source symbol
#?(:kotoba
   (defn map-source-at [packed? :bool source-type [:ref :form/r] sources [:ref :form/r] direct [:list [:ref :form/r]] idx :i64] [:ref :form/r]
     (if packed?
       (form/call3 "hetero-vector-at" source-type sources (form/int-form idx))
       (typed-list-nth [:list [:ref :form/r]] direct idx)))
   :default nil)

;; (vector-at source_k i) for k in [0, n)
#?(:kotoba
   (defn map-items [packed? :bool source-type [:ref :form/r] sources [:ref :form/r] direct [:list [:ref :form/r]] i [:ref :form/r] k :i64 n :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= k n)
       acc
       (map-items packed? source-type sources direct i (+ k 1) n
                  (form/append-form acc (form/call2 "vector-at" (map-source-at packed? source-type sources direct k) i)))))
   :default nil)

;; (>= i (vector-count source_k)) for k in [0, n)
#?(:kotoba
   (defn map-exhausted-tests [packed? :bool source-type [:ref :form/r] sources [:ref :form/r] direct [:list [:ref :form/r]] i [:ref :form/r] k :i64 n :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= k n)
       acc
       (map-exhausted-tests packed? source-type sources direct i (+ k 1) n
                            (form/append-form acc (form/call2 ">=" i (form/call1 "vector-count" (map-source-at packed? source-type sources direct k)))))))
   :default nil)

;; the pairs [p0 item0 p1 item1 ...] of the parameters and their items
#?(:kotoba
   (defn zip-bindings [params [:ref :form/r] items [:list [:ref :form/r]] k :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= k (form/count-of params))
       acc
       (zip-bindings params items (+ k 1)
                     (form/append-form (form/append-form acc (form/nth-of params k)) (typed-list-nth [:list [:ref :form/r]] items k)))))
   :default nil)

;; the pairs [direct_k value_k ...]
#?(:kotoba
   (defn zip-lists [a [:list [:ref :form/r]] b [:list [:ref :form/r]] k :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= k (vector-count a))
       acc
       (zip-lists a b (+ k 1)
                  (form/append-form (form/append-form acc (typed-list-nth [:list [:ref :form/r]] a k)) (typed-list-nth [:list [:ref :form/r]] b k)))))
   :default nil)

;; the known-types entries of a direct-source map: each source symbol is a :vector-i64
#?(:kotoba
   (defn known-vector-sources [direct [:list [:ref :form/r]] k :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= k (vector-count direct))
       acc
       (known-vector-sources direct (+ k 1) (form/assoc-form acc (typed-list-nth [:list [:ref :form/r]] direct k) (form/keyword-form :vector-i64)))))
   :default nil)

;; the inline `fn` of a map: [params body] after the per-cause refusals
#?(:kotoba
   (defn map-inline-params [f [:ref :form/r] n :i64] [:ref :form/r]
     (let [params (if (> (form/count-of f) 1) (form/nth-of f 1) (form/nil-form))
           _ (require-k (form/is-vec? params)
                        "map fn requires a parameter vector; a multi-arity (fn ([x] ...) ...) is not a map callback"
                        "kotoba.error/subset-reject" f)
           _ (require-k (= n (form/count-of params))
                        (string-concat (string-from-i64 n)
                          (string-concat "-source map fn requires "
                            (string-concat (string-from-i64 n)
                              (string-concat " parameter"
                                (string-concat (if (= n 1) "" "s")
                                  (string-concat "; got " (string-from-i64 (form/count-of params))))))))
                        "kotoba.error/subset-reject" f)
           bad (first-non-symbol params 0)
           _ (require-k (all-symbols? params 0)
                        (string-concat "map fn parameter destructures ("
                          (string-concat (pr-form bad)
                            "): the item of a vector-i64 source is an i64 and has no positions to bind; take a symbol and index a typed value inside the body"))
                        "kotoba.error/subset-reject" f)
           _ (require-k (forms-distinct? params 0) "map fn parameters must be unique" "kotoba.error/subset-reject" f)
           _ (require-k (> (form/count-of f) 2) "map fn requires a body expression" "kotoba.error/subset-reject" f)]
       params))
   :default nil)

#?(:kotoba
   (defn map-check-stored [env [:ref :fe/env] stored? :bool f [:ref :form/r]] :i64
     (if stored? (check-stored-callback env "map" f "map" "(fn [x] ...)") 0))
   :default nil)

#?(:kotoba
   (defn map-params-of [inline? :bool f [:ref :form/r] n :i64] [:ref :form/r]
     (if inline? (map-inline-params f n) (form/nil-form)))
   :default nil)

#?(:kotoba
   (defn map-mapped [env [:ref :fe/env] f [:ref :form/r] params [:ref :form/r] items [:list [:ref :form/r]] primitive? :bool inline? :bool stored? :bool cb [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (cond
       primitive? (dr env (if (sym-is? f "inc")
                            (form/call2 "+" (typed-list-nth [:list [:ref :form/r]] items 0) (form/int-form 1))
                            (form/call2 "-" (typed-list-nth [:list [:ref :form/r]] items 0) (form/int-form 1))))
       inline? (let [r (desugar-in-fn-scope env params (implicit-do-list (args-from f 2)))]
                 (dr (dr-env r) (form/call2 "let" (form/form-vec (zip-bindings params items 0 (form/no-forms))) (dr-form r))))
       stored? (let [name (request-i64-dispatcher env (vector-count items) form)]
                 (dr (dr-env name) (head-call (dr-form name) (form/cons-onto cb items))))
       :else (dr env (head-call f items))))
   :default nil)

;; (map f c1 ... cn), 1 to 5 vector-i64 sources: a bounded loop that conj's (f item1 ... itemn); a stored callback is not ported
#?(:kotoba
   (defn desugar-map-call [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (and (<= 2 (argc form)) (<= (argc form) 6)) "map requires a callback and one to five vector-i64 collections"
                        "kotoba.error/subset-reject" form)
           f (arg form 0)
           n (- (argc form) 1)
           top-level? (top-level-function-symbol? env f)
           primitive? (and (= 1 n) (form/is-symbol? f) (not (tables/table-has? (env-lexical env) f))
                           (or (sym-is? f "inc") (sym-is? f "dec")))
           inline? (head-is? f "fn")
           stored? (not (or top-level? primitive? inline?))
           _ (require-k (or (not top-level?) (function-has-arity? env f n)) "named map callback does not support the source arity"
                        "kotoba.error/subset-reject" f)
           _ (map-check-stored env stored? f)
           params (map-params-of inline? f n)
           _ (require-k (not (and stored? (> n 4))) "stored map callbacks support at most four sources" "kotoba.error/subset-reject" f)
           packed? (> n 2)
           source-type (map-source-type n)
           svals (map-source-values env form 2 (form/no-forms))
           sr (if packed? (synthetic (drs-env svals) "map_sources") (dr (drs-env svals) (form/nil-form)))
           sources (dr-form sr)
           dsr (if packed? (drs (dr-env sr) (form/no-forms)) (map-direct-sources (dr-env sr) 0 n (form/no-forms)))
           direct (drs-forms dsr)
           cbs (if stored? (synthetic (drs-env dsr) "map_callback") (dr (drs-env dsr) (form/nil-form)))
           cb (dr-form cbs)
           is (synthetic (dr-env cbs) "map_i")
           as (synthetic (dr-env is) "map_acc")
           i (dr-form is) acc (dr-form as)
           items (map-items packed? source-type sources direct i 0 n (form/no-forms))
           mapped (map-mapped (dr-env as) f params items primitive? inline? stored? cb form)
           exhausted (head-call (form/symbol-form "or") (map-exhausted-tests packed? source-type sources direct i 0 n (form/no-forms)))
           source-bindings (if packed?
                             (form/vec2 sources (form/form-seq (form/cons-onto (form/symbol-form "hetero-vector") (form/cons-onto source-type (drs-forms svals)))))
                             (form/form-vec (zip-lists direct (drs-forms svals) 0 (form/no-forms))))
           known0 (form/assoc-form (form/assoc-form (form/form-map (form/no-forms)) i (form/keyword-form :i64)) acc (form/keyword-form :vector-i64))
           known1 (if packed?
                    (form/assoc-form known0 sources source-type)
                    (known-vector-sources direct 0 known0))
           known (if stored? (form/assoc-form known1 cb (form/keyword-form :i64)) known1)
           all-bindings (if stored?
                          (form/form-vec (form/cons-onto cb (form/cons-onto f (form/kids-of source-bindings))))
                          source-bindings)]
       (desugar-with-loop-overrides (dr-env mapped) (form/keyword-form :vector-i64) known
         (form/call2 "let" all-bindings
           (form/call2 "loop" (form/vec4 i (form/int-form 0) acc (form/call0 "vector-i64"))
             (form/call3 "if" exhausted acc
               (form/call2 "recur" (form/call2 "+" i (form/int-form 1))
                 (form/call2 "vector-conj" acc (dr-form mapped)))))))))
   :default nil)

#?(:kotoba
   (defn map-indexed-params [f [:ref :form/r]] [:ref :form/r]
     (let [params (if (> (form/count-of f) 1) (form/nth-of f 1) (form/nil-form))
           _ (require-k (form/is-vec? params)
                        "map-indexed fn requires a parameter vector; a multi-arity (fn ([i x] ...) ...) is not a map-indexed callback"
                        "kotoba.error/subset-reject" f)
           _ (require-k (not (= 1 (form/count-of params)))
                        "map-indexed fn requires 2 parameters; got 1 -- map-indexed passes the index first: (fn [i x] ...), not (fn [x] ...)"
                        "kotoba.error/subset-reject" f)
           _ (require-k (= 2 (form/count-of params))
                        (string-concat "map-indexed fn requires 2 parameters (index, item); got " (string-from-i64 (form/count-of params)))
                        "kotoba.error/subset-reject" f)
           _ (require-k (all-symbols? params 0)
                        (string-concat "map-indexed fn parameter destructures ("
                          (string-concat (pr-form (first-non-symbol params 0))
                            "): the index and the item of a vector-i64 source are i64 and have no positions to bind; take symbols and index a typed value inside the body"))
                        "kotoba.error/subset-reject" f)
           _ (require-k (forms-distinct? params 0) "map-indexed fn parameters must be unique" "kotoba.error/subset-reject" f)
           _ (require-k (> (form/count-of f) 2) "map-indexed fn requires a body expression" "kotoba.error/subset-reject" f)]
       params))
   :default nil)

#?(:kotoba
   (defn map-indexed-prepare [env [:ref :fe/env] f [:ref :form/r] top-level? :bool inline? :bool stored? :bool] [:ref :form/r]
     (let [_ (require-k (or (not top-level?) (function-has-arity? env f 2))
                        "named map-indexed callback does not support two parameters; map-indexed passes the index first: (fn [i x] ...)"
                        "kotoba.error/subset-reject" f)
           _ (map-indexed-check-stored env stored? f)]
       (if inline? (map-indexed-params f) (form/nil-form))))
   :default nil)

#?(:kotoba
   (defn map-indexed-check-stored [env [:ref :fe/env] stored? :bool f [:ref :form/r]] :i64
     (if stored? (check-stored-callback env "map-indexed" f "map-indexed" "(fn [i x] ...)") 0))
   :default nil)

#?(:kotoba
   (defn map-indexed-mapped [env [:ref :fe/env] f [:ref :form/r] params [:ref :form/r] inline? :bool stored? :bool cb [:ref :form/r] i [:ref :form/r] x [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (cond
       inline?
       (let [r (desugar-in-fn-scope env params (implicit-do-list (args-from f 2)))]
         (dr (dr-env r) (form/call2 "let" (form/vec4 (form/nth-of params 0) i (form/nth-of params 1) x) (dr-form r))))
       stored?
       (let [name (request-i64-dispatcher env 2 form)]
         (dr (dr-env name) (form/form-seq (form/cons-onto (dr-form name) (form/three-forms cb i x)))))
       :else (dr env (form/form-seq (form/three-forms f i x)))))
   :default nil)

#?(:kotoba
   (defn desugar-map-indexed [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (if (tables/table-has? (env-arities env) op)
       (desugar-ordinary-call env op form)
       (let [_ (require-k (= 2 (argc form)) "map-indexed requires a callback and one vector-i64 collection" "kotoba.error/subset-reject" form)
             f (arg form 0)
             top-level? (top-level-function-symbol? env f)
             inline? (head-is? f "fn")
             stored? (not (or top-level? inline?))
             params (map-indexed-prepare env f top-level? inline? stored?)
             cr (desugar-vector-i64-source env (arg form 1))
             vs (synthetic (dr-env cr) "mapindexed_v")
             is (synthetic (dr-env vs) "mapindexed_i")
             as (synthetic (dr-env is) "mapindexed_acc")
             xs (synthetic (dr-env as) "mapindexed_x")
             cbs (if stored? (synthetic (dr-env xs) "mapindexed_callback") (dr (dr-env xs) (form/nil-form)))
             cb (dr-form cbs)
             v (dr-form vs) i (dr-form is) acc (dr-form as) x (dr-form xs)
             mapped (map-indexed-mapped (dr-env cbs) f params inline? stored? cb i x form)
             known0 (form/assoc-form (form/assoc-form (form/assoc-form (form/form-map (form/no-forms)) i (form/keyword-form :i64))
                                                     acc (form/keyword-form :vector-i64))
                                     v (form/keyword-form :vector-i64))
             known (if stored? (form/assoc-form known0 cb (form/keyword-form :i64)) known0)]
         (desugar-with-loop-overrides (dr-env mapped) (form/keyword-form :vector-i64) known
           (form/call2 "let" (if stored? (form/vec4 cb f v (dr-form cr)) (form/vec2 v (dr-form cr)))
             (form/call2 "loop" (form/vec4 i (form/int-form 0) acc (form/call0 "vector-i64"))
               (form/call3 "if" (form/call2 "<" i (form/call1 "vector-count" v))
                 (form/call2 "let" (form/vec2 x (form/call2 "vector-at" v i))
                   (form/call2 "recur" (form/call2 "+" i (form/int-form 1))
                     (form/call2 "vector-conj" acc (dr-form mapped))))
                 acc)))))))
   :default nil)

;; mapv / filterv: the aliases of map / filter unless the module defines the name itself
#?(:kotoba
   (defn desugar-mapv [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (if (tables/table-has? (env-arities env) op)
       (desugar-ordinary-call env op form)
       (let [_ (require-k (and (<= 2 (argc form)) (<= (argc form) 6)) "mapv requires a callback and one to five vector-i64 collections"
                          "kotoba.error/subset-reject" form)]
         (desugar-expr env (head-call (form/symbol-form "map") (args-from form 1))))))
   :default nil)

#?(:kotoba
   (defn desugar-filterv [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (if (tables/table-has? (env-arities env) op)
       (desugar-ordinary-call env op form)
       (let [_ (require-k (= 2 (argc form)) "filterv requires pred and one vector-i64 collection" "kotoba.error/subset-reject" form)]
         (desugar-expr env (head-call (form/symbol-form "filter") (args-from form 1))))))
   :default nil)

;; (into to src) is (reduce (fn [acc x] (vector-conj acc x)) to src); the transducer 3-arity of the five single-step transducers
;; is rewritten to the 2-arity first
#?(:kotoba
   (defn into-transducer? [form [:ref :form/r]] :bool
     (and (= 3 (argc form))
          (form/is-seq? (arg form 1))
          (> (form/count-of (arg form 1)) 0)
          (let [h (form/nth-of (arg form 1) 0)]
            (or (sym-is? h "map") (sym-is? h "filter") (sym-is? h "remove") (sym-is? h "keep") (sym-is? h "mapcat")))
          (= 2 (form/count-of (arg form 1)))))
   :default nil)

#?(:kotoba
   (defn desugar-into [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (if (tables/table-has? (env-arities env) op)
       (desugar-ordinary-call env op form)
       (let [xf? (into-transducer? form)
             n (if xf? 2 (argc form))
             _ (require-k (= 2 n)
                          (if (= 3 n)
                            "into with a transducer admits only (map f) (filter f) (remove f) (keep f) (mapcat f) as the middle argument"
                            "into requires a destination and one source in this subset")
                          "kotoba.error/subset-reject" form)
             dest (arg form 0)
             src (if xf? (form/call2 (form/symbol-value (form/nth-of (arg form 1) 0)) (form/nth-of (arg form 1) 1) (arg form 2)) (arg form 1))
             fn-form (form/call2 "fn" (form/vec2 (form/symbol-form "acc") (form/symbol-form "x"))
                                 (form/call2 "vector-conj" (form/symbol-form "acc") (form/symbol-form "x")))]
         (desugar-expr env (form/call3 "reduce" fn-form dest src)))))
   :default nil)

;; ---- fn literals, fn-ref, apply, invoke on the Kotoba route: the lambda and closure-dispatcher registries as env fields ----
;; `*pending-lambdas*` is the env's `lambdas` (a Form vector of lifted lambda infos, appended in the host's order),
;; `*lambda-counter*` its `lambda-counter`, `*required-closure-dispatchers*` the `dispatchers` set (keys [result arity]),
;; `*uses-apply?*` / `*uses-lazy?*` the two flags. Not ported: a variadic clause (`&`), a fn under an expected callable contract
;; (the Kotoba route sets none: its ordinary calls carry no callable contracts yet), and a dispatcher family whose result type is a
;; structured descriptor (its name is a SHA-256 digest of the descriptor).
#?(:kotoba
   (defn env-lambdas [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :lambdas))
   :default nil)

#?(:kotoba
   (defn env-dispatchers [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :dispatchers))
   :default nil)

#?(:kotoba
   (defn env-uses-apply? [env [:ref :fe/env]] :bool (record-get [:ref :fe/env] env :uses-apply))
   :default nil)

#?(:kotoba
   (defn env-lambda-counter [env [:ref :fe/env]] :i64 (record-get [:ref :fe/env] env :lambda-counter))
   :default nil)

#?(:kotoba
   (defn with-none [env [:ref :fe/env] b :bool] [:ref :fe/env]
     ;; a :bool record field holds a real boolean: a comparison's 0/1 is normalized through `if`
     (record-assoc [:ref :fe/env] env :none (if b true false)))
   :default nil)

#?(:kotoba
   (defn env-lazy? [env [:ref :fe/env]] :bool (record-get [:ref :fe/env] env :lazy))
   :default nil)

#?(:kotoba
   (defn with-lambdas [env [:ref :fe/env] n :i64 infos [:list [:ref :form/r]]] [:ref :fe/env]
     (record-assoc [:ref :fe/env]
                   (record-assoc [:ref :fe/env] env :lambda-counter n)
                   :lambdas
                   (form/form-vec (form/append-many (form/kids-of (record-get [:ref :fe/env] env :lambdas)) infos))))
   :default nil)

#?(:kotoba
   (defn with-uses-apply [env [:ref :fe/env]] [:ref :fe/env] (record-assoc [:ref :fe/env] env :uses-apply true))
   :default nil)

;; ---- callable contracts (ADR 0353) and the closure dispatcher families ----
;; The host keeps the four contract tables in dynamic vars (`*lexical-callable-contracts*`, `*function-callable-result-contracts*`,
;; `*function-callable-param-contracts*`, `*expected-callable-contract*`); on this route they are the entries :lexical, :results, :params
;; and :expected of the Form map in the env field `contracts`, set and restored for the extent of a call exactly as `binding` does.
#?(:kotoba
   (defn env-con [env [:ref :fe/env] key :keyword] [:ref :form/r]
     (form/form-get (record-get [:ref :fe/env] env :contracts) (form/keyword-form key)))
   :default nil)

#?(:kotoba
   (defn with-con [env [:ref :fe/env] key :keyword v [:ref :form/r]] [:ref :fe/env]
     (record-assoc [:ref :fe/env] env :contracts
                   (form/assoc-form (record-get [:ref :fe/env] env :contracts) (form/keyword-form key) v)))
   :default nil)

;; the analysis driver's entry: the four tables for one function (`analyze` binds the dynamic vars per defn): its parameters' contracts by symbol,
;; the module's declared result contracts by [name arity], its contract-typed parameter positions by [name arity] -> {index contract}, and
;; the function's own declared result contract (nil-form for none)
#?(:kotoba
   (defn with-contract-tables [env [:ref :fe/env] lexical [:ref :form/r] results [:ref :form/r] params [:ref :form/r] expected [:ref :form/r]] [:ref :fe/env]
     (with-con (with-con (with-con (with-con env :lexical lexical) :results results) :params params) :expected expected))
   :default nil)

;; every parameter type of the Form vector PS (from I) is :i64 (the closure ABI before typed parameters; nil-form is the same shape)
#?(:kotoba
   (defn i64-types? [ps [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of ps))
       true
       (and (form/eq (form/nth-of ps i) (form/keyword-form :i64)) (i64-types? ps (+ i 1)))))
   :default nil)

;; some clause of the contract names a parameter type other than :i64 (the contract reaches a call's argument only then)
#?(:kotoba
   (defn contract-typed-params? [clauses [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of clauses))
       false
       (or (not (i64-types? (form/nth-of (form/nth-of clauses i) 0) 0))
           (contract-typed-params? clauses (+ i 1)))))
   :default nil)

;; the clause of the contract with ARITY parameters (host `callable-clause-for-arity`)
#?(:kotoba
   (defn contract-clause-at [clauses [:ref :form/r] arity :i64 i :i64 form [:ref :form/r]] [:ref :form/r]
     (if (>= i (form/count-of clauses))
       (throw (fe-reject "callable contract does not admit this arity" "kotoba.error/callable-arity" form))
       (if (= arity (form/count-of (form/nth-of (form/nth-of clauses i) 0)))
         (form/nth-of clauses i)
         (contract-clause-at clauses arity (+ i 1) form))))
   :default nil)

;; the contract of an expression: a local closure's, or the declared result contract of the module function it calls
#?(:kotoba
   (defn expression-callable-contract [env [:ref :fe/env] form [:ref :form/r]] [:ref :form/r]
     (cond
       (form/is-symbol? form) (form/form-get (env-con env :lexical) form)
       (form/is-seq? form)
       (let [table (env-con env :results)
             by-arity (form/form-get table (form/vec2 (form/nth-of form 0) (form/int-form (- (form/count-of form) 1))))]
         (if (form/is-nil? by-arity) (form/form-get table (form/nth-of form 0)) by-arity))
       :else (form/nil-form)))
   :default nil)

;; `(vswap! *required-closure-dispatchers* conj (dispatcher-key result arity parameter-types))`
#?(:kotoba
   (defn with-dispatcher [env [:ref :fe/env] result [:ref :form/r] arity :i64 ptypes [:ref :form/r]] [:ref :fe/env]
     (record-assoc [:ref :fe/env] env :dispatchers
                   (set-add (record-get [:ref :fe/env] env :dispatchers)
                            (if (i64-types? ptypes 0)
                              (form/vec2 result (form/int-form arity))
                              (form/vec3 result (form/int-form arity) ptypes)))))
   :default nil)

;; Two aborting functions of closure-types, as module-local copies. An aborting function IMPORTED from another module is typed [:result T E] at the call and
;; its abort does not propagate through a plain call (the language's abort ability does not cross a module boundary yet; closure-types keeps its own `require-k` for the
;; same reason), so a refusal raised there would be dropped. The differential pins each to the host's function.
;; `validate-value-type!` of closure-types: the value-type descriptor check, as a refusal
#?(:kotoba
   (defn type-valid! [type [:ref :form/r]] :i64
     (let [r (vt/validate-type type 0 0)]
       (if (vt/outcome-ok? r)
         (vt/outcome-nodes r)
         (throw (fe-reject (vt/outcome-msg r) (vt/outcome-code r) type)))))
   :default nil)

;; the name of a keyword type, namespace off (`(name result-type)`)
#?(:kotoba
   (defn dn-keyword-name [k [:ref :form/r]] :string
     (let [body (string-substring (kw-text k) 1 (string-length (kw-text k)))
           slash (string-find-byte body 47 0)]
       (if (< slash 0) body (string-substring body (+ slash 1) (string-length body)))))
   :default nil)

#?(:kotoba
   (defn dn-result-label [result-type [:ref :form/r]] :string
     (if (form/is-keyword? result-type)
       (dn-keyword-name result-type)
       (string-concat "t_" (artifact/sha256 (form->document result-type)))))
   :default nil)

;; the name segment a typed-parameter family carries, "" for the all-`:i64` family
#?(:kotoba
   (defn dn-parameter-label [ptypes [:ref :form/r]] :string
     (if (i64-types? ptypes 0)
       ""
       (string-concat "p_" (artifact/sha256 (form->document (form/form-vec (form/kids-of ptypes)))))))
   :default nil)

;; `invoke-dispatcher-name` of closure-types: spelled for a flat result type, a digest of the descriptor for a structured one, a digest of the parameter types
;; for typed parameters (one digest of the whole signature when the result is structured too: the 128-character symbol bound)
#?(:kotoba
   (defn dispatcher-name-for [rt [:ref :form/r] arity :i64 ptypes [:ref :form/r]] [:ref :form/r]
     (let [_ (require-k (or (schema-ref-type? rt) (closure-result-type? rt)) "closure result type is outside the admitted dispatcher profile"
                        "kotoba.error/subset-reject" rt)
           plabel (dn-parameter-label ptypes)
           labelled? (not (string=? plabel ""))
           structured? (not (form/is-keyword? rt))
           middle (if (and labelled? structured?)
                    (string-concat "_pt_" (artifact/sha256 (form->document (form/form-vec (form/two-forms (form/form-vec (form/kids-of ptypes)) rt)))))
                    (string-concat (if labelled? (string-concat "_" plabel) "")
                                   (if (form/eq rt (form/keyword-form :i64)) "" (string-concat "_" (dn-result-label rt)))))]
       (form/symbol-form (string-concat "__kotoba_invoke" (string-concat middle (string-concat "$arity" (string-from-i64 arity)))))))
   :default nil)

;; `request-invoke-dispatcher` with the clause's parameter types (nil-form: none): register the family and answer its name (`dispatcher-name-for`, the module-local copy of closure-types'
;; `invoke-dispatcher-name`)
#?(:kotoba
   (defn request-dispatcher-p [env [:ref :fe/env] result [:ref :form/r] arity :i64 ptypes [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [rt (canonical-closure-result-type env result)
           env1 (with-dispatcher env rt arity ptypes)
           name (dispatcher-name-for rt arity ptypes)]
       (dr env1 name)))
   :default nil)

#?(:kotoba
   (defn request-dispatcher [env [:ref :fe/env] result [:ref :form/r] arity :i64 form [:ref :form/r]] [:ref :fe/dr]
     (request-dispatcher-p env result arity (form/nil-form) form))
   :default nil)

;; the stored-callback call head of map / map-indexed
#?(:kotoba
   (defn request-i64-dispatcher [env [:ref :fe/env] arity :i64 form [:ref :form/r]] [:ref :fe/dr]
     (request-dispatcher env (form/keyword-form :i64) arity form))
   :default nil)

;; ---- lift-lambda ----
#?(:kotoba
   (defn valid-name-form? [v [:ref :form/r]] :bool
     (and (simple-symbol-form? v) (<= (string-byte-length (form/symbol-value v)) 128)))
   :default nil)

#?(:kotoba
   (defn every-valid-name? [ps [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of ps))
       true
       (and (valid-name-form? (form/nth-of ps i)) (every-valid-name? ps (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn has-amp? [ps [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of ps))
       false
       (or (sym-is? (form/nth-of ps i) "&") (has-amp? ps (+ i 1)))))
   :default nil)

;; the clause list of an fn form as a Form vector of [params body] (body nil-form when absent), unsorted
#?(:kotoba
   (defn lambda-raw-clauses [form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of form))
       acc
       (let [clause (form/nth-of form i)
             _ (require-k (and (form/is-seq? clause) (>= (form/count-of clause) 2) (form/is-vec? (form/nth-of clause 0)))
                          "multi-arity fn requires ([params] body) clauses" "kotoba.error/subset-reject" clause)]
         (lambda-raw-clauses form (+ i 1)
                             (form/append-form acc (form/vec2 (form/nth-of clause 0) (implicit-do-list (args-from clause 1))))))))
   :default nil)

#?(:kotoba
   (defn lambda-clauses-of [form [:ref :form/r]] [:list [:ref :form/r]]
     (let [pc (if (> (form/count-of form) 1) (form/nth-of form 1) (form/nil-form))]
       (if (form/is-vec? pc)
         (form/one-form (form/vec2 pc (if (> (form/count-of form) 2) (implicit-do-list (args-from form 2)) (form/nil-form))))
         (lambda-raw-clauses-checked form))))
   :default nil)

#?(:kotoba
   (defn lambda-raw-clauses-checked [form [:ref :form/r]] [:list [:ref :form/r]]
     (let [_ (require-k (> (form/count-of form) 1) "multi-arity fn requires ([params] body) clauses" "kotoba.error/subset-reject" (form/nil-form))]
       (lambda-raw-clauses form 1 (form/no-forms))))
   :default nil)

;; variadic clauses `[fixed ... & rest]`: the shape, then the count; each is specialized at the arities not written out, up to four
#?(:kotoba
   (defn prefix-valid-names? [ps [:ref :form/r] i :i64 end :i64] :bool
     (if (>= i end)
       true
       (and (valid-name-form? (form/nth-of ps i)) (prefix-valid-names? ps (+ i 1) end))))
   :default nil)

;; is the clause well formed as [fixed ... & rest] (the `&` second to last, at most four fixed, valid names)
#?(:kotoba
   (defn variadic-shape-ok? [ps [:ref :form/r]] :bool
     (let [a (amp-index ps 0)]
       (and (= a (- (form/count-of ps) 2))
            (<= a 4)
            (prefix-valid-names? ps 0 a)
            (valid-name-form? (form/nth-of ps (- (form/count-of ps) 1))))))
   :default nil)

;; how many clauses are variadic; a malformed variadic clause is refused
#?(:kotoba
   (defn lambda-variadic-count [cs [:list [:ref :form/r]] i :i64 n :i64] :i64
     (if (>= i (vector-count cs))
       n
       (let [c (typed-list-nth [:list [:ref :form/r]] cs i)
             ps (form/nth-of c 0)
             v? (has-amp? ps 0)
             _ (require-k (or (not v?) (variadic-shape-ok? ps)) "variadic fn clause requires [fixed ... & rest]" "kotoba.error/subset-reject" c)]
         (lambda-variadic-count cs (+ i 1) (if v? (+ n 1) n)))))
   :default nil)

;; the first variadic clause, nil-form when none
#?(:kotoba
   (defn lambda-first-variadic [cs [:list [:ref :form/r]] i :i64] [:ref :form/r]
     (if (>= i (vector-count cs))
       (form/nil-form)
       (let [c (typed-list-nth [:list [:ref :form/r]] cs i)]
         (if (has-amp? (form/nth-of c 0) 0) c (lambda-first-variadic cs (+ i 1))))))
   :default nil)

;; the arity of the fixed clause with that many parameters, or nil-form
#?(:kotoba
   (defn lambda-fixed-clause-of [cs [:list [:ref :form/r]] n :i64 i :i64] [:ref :form/r]
     (if (>= i (vector-count cs))
       (form/nil-form)
       (let [c (typed-list-nth [:list [:ref :form/r]] cs i)
             ps (form/nth-of c 0)]
         (if (and (not (has-amp? ps 0)) (= n (form/count-of ps)))
           c
           (lambda-fixed-clause-of cs n (+ i 1))))))
   :default nil)

;; the set of arities of the fixed clauses
#?(:kotoba
   (defn lambda-fixed-arities [cs [:list [:ref :form/r]] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (vector-count cs))
       acc
       (let [ps (form/nth-of (typed-list-nth [:list [:ref :form/r]] cs i) 0)]
         (lambda-fixed-arities cs (+ i 1) (if (has-amp? ps 0) acc (set-add acc (form/int-form (form/count-of ps))))))))
   :default nil)

;; add the integers from..4 to the arity set
#?(:kotoba
   (defn add-arity-range [acc [:ref :form/r] from :i64] [:ref :form/r]
     (if (> from 4)
       acc
       (add-arity-range (set-add acc (form/int-form from)) (+ from 1))))
   :default nil)

;; `specialize-variadic-clause`: [fixed ++ extras, (let [rest (list extras...)] body)] at ARITY
#?(:kotoba
   (defn rest-extras [i :i64 n :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i n)
       acc
       (rest-extras (+ i 1) n (form/append-form acc (form/symbol-form (string-concat "__kotoba_lambda_rest_arg_" (string-from-i64 i)))))))
   :default nil)

#?(:kotoba
   (defn specialize-variadic [v [:ref :form/r] arity :i64] [:ref :form/r]
     (let [ps (form/nth-of v 0)
           a (amp-index ps 0)
           extras (rest-extras 0 (- arity a) (form/no-forms))
           fixed (doc-members-of ps 0 (form/no-forms))]
       (form/vec2 (form/form-vec (form/append-many (slice-forms fixed 0 a (form/no-forms)) extras))
                  (form/call2 "let" (form/vec2 (form/nth-of ps (- (form/count-of ps) 1)) (head-call (form/symbol-form "list") extras))
                              (form/nth-of v 1)))))
   :default nil)

#?(:kotoba
   (defn lambda-clauses-for-arities [cs [:list [:ref :form/r]] v [:ref :form/r] arities [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count arities))
       acc
       (let [n (form/int-value (typed-list-nth [:list [:ref :form/r]] arities i))
             fixed (lambda-fixed-clause-of cs n 0)]
         (lambda-clauses-for-arities cs v arities (+ i 1)
                                     (form/append-form acc (if (form/is-nil? fixed) (specialize-variadic v n) fixed))))))
   :default nil)

;; the fixed clauses ordered by arity: every written clause, plus the variadic one specialized at the arities no clause writes
#?(:kotoba
   (defn lambda-expand-clauses [cs [:list [:ref :form/r]] form [:ref :form/r]] [:list [:ref :form/r]]
     (let [vcount (lambda-variadic-count cs 0 0)
           _ (require-k (and (<= vcount 1) (fixed-arities-unique? cs 0))
                        "fn requires unique fixed arities and at most one variadic clause" "kotoba.error/subset-reject" form)]
       (if (= 0 vcount)
         (sort-clauses cs 0 (form/no-forms))
         (let [v (lambda-first-variadic cs 0)
               arities (sorted-ints (add-arity-range (lambda-fixed-arities cs 0 (form/form-set (form/no-forms))) (amp-index (form/nth-of v 0) 0)) 0 (form/no-forms))]
           (lambda-clauses-for-arities cs v arities 0 (form/no-forms))))))
   :default nil)

;; no two clauses share an arity
#?(:kotoba
   (defn fixed-differ-from? [cs [:list [:ref :form/r]] n :i64 j :i64] :bool
     (if (>= j (vector-count cs))
       true
       (let [ps (form/nth-of (typed-list-nth [:list [:ref :form/r]] cs j) 0)]
         (and (or (has-amp? ps 0) (not (= n (form/count-of ps))))
              (fixed-differ-from? cs n (+ j 1))))))
   :default nil)

;; no two fixed clauses share an arity
#?(:kotoba
   (defn fixed-arities-unique? [cs [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count cs))
       true
       (let [ps (form/nth-of (typed-list-nth [:list [:ref :form/r]] cs i) 0)]
         (and (or (has-amp? ps 0) (fixed-differ-from? cs (form/count-of ps) (+ i 1)))
              (fixed-arities-unique? cs (+ i 1))))))
   :default nil)

;; the clauses ordered by arity (the host sorts the arity set and maps over it)
#?(:kotoba
   (defn clause-arity-position [sorted [:list [:ref :form/r]] n :i64 i :i64] :i64
     (if (>= i (vector-count sorted))
       i
       (if (> (form/count-of (form/nth-of (typed-list-nth [:list [:ref :form/r]] sorted i) 0)) n)
         i
         (clause-arity-position sorted n (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn sort-clauses [cs [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count cs))
       acc
       (let [c (typed-list-nth [:list [:ref :form/r]] cs i)
             p (clause-arity-position acc (form/count-of (form/nth-of c 0)) 0)]
         (sort-clauses cs (+ i 1) (slice-forms acc p (vector-count acc) (form/append-form (slice-forms acc 0 p (form/no-forms)) c))))))
   :default nil)

#?(:kotoba
   (defn clauses-valid? [cs [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count cs))
       true
       (let [c (typed-list-nth [:list [:ref :form/r]] cs i)
             ps (form/nth-of c 0)]
         (and (not (form/is-nil? (form/nth-of c 1)))
              (<= (form/count-of ps) 4)
              (every-valid-name? ps 0)
              (forms-distinct? ps 0)
              (clauses-valid? cs (+ i 1))))))
   :default nil)

;; the typed parameters of a contract clause are locals of their type inside the body (a record-field projection reads them), and an option-typed one
;; is a local option type: the host's `*local-types*` / `*local-option-types*` bindings of `lift-lambda`
#?(:kotoba
   (defn with-options [env [:ref :fe/env] t [:ref :form/r]] [:ref :fe/env]
     (record-assoc [:ref :fe/env] env :options t))
   :default nil)

#?(:kotoba
   (defn env-options [env [:ref :fe/env]] [:ref :form/r] (record-get [:ref :fe/env] env :options))
   :default nil)

#?(:kotoba
   (defn lambda-param-types [env [:ref :fe/env] params [:ref :form/r] ptypes [:ref :form/r] i :i64] [:ref :fe/env]
     (if (>= i (form/count-of params))
       env
       (let [p (form/nth-of params i)
             t (form/nth-of ptypes i)
             env1 (with-types env (types-assoc (env-types env) p t))
             env2 (if (generic-option-type? t) (with-options env1 (types-assoc (env-options env1) p t)) env1)]
         (lambda-param-types env2 params ptypes (+ i 1)))))
   :default nil)

;; the body of one clause desugared in the fn scope (its params lexical, the abort context :fn); the result is the contract clause's when the
;; expected contract names one for this arity, else the contextual closure result; absence per that result
#?(:kotoba
   (defn lambda-clause-body [env [:ref :fe/env] c [:ref :form/r] results [:ref :form/r] cparams [:ref :form/r]] [:ref :fe/dr]
     (let [params (form/nth-of c 0)
           cres (form/form-get results (form/int-form (form/count-of params)))
           cpar (form/form-get cparams (form/int-form (form/count-of params)))
           expected (if (form/is-nil? cres) (env-result env) cres)
           saved-lex (env-lexical env)
           saved-ctx (env-abort-ctx env)
           saved-none (env-none? env)
           saved-types (env-types env)
           saved-opts (env-options env)
           scoped0 (with-none (with-abort-ctx (with-lexical env (lex-add-vec saved-lex params 0)) "fn") (form/is-nil? expected))
           scoped (if (form/is-nil? cpar) scoped0 (lambda-param-types scoped0 params cpar 0))
           r (lambda-body-expr scoped expected (form/nth-of c 1))]
       (dr (with-options (with-types (with-none (with-abort-ctx (with-lexical (dr-env r) saved-lex) saved-ctx) saved-none) saved-types) saved-opts)
           (dr-form r))))
   :default nil)

#?(:kotoba
   (defn lambda-body-expr [env [:ref :fe/env] expected [:ref :form/r] body [:ref :form/r]] [:ref :fe/dr]
     (if (form/is-nil? expected)
       (desugar-expr env body)
       (desugar-result-expr env expected body)))
   :default nil)

;; the bodies lowered, in clause order: a Form vector of [params lowered-body]
#?(:kotoba
   (defn lambda-lower-clauses [env [:ref :fe/env] cs [:list [:ref :form/r]] results [:ref :form/r] cparams [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (vector-count cs))
       (drs env acc)
       (let [c (typed-list-nth [:list [:ref :form/r]] cs i)
             r (lambda-clause-body env c results cparams)
             n (form/count-of (form/nth-of c 0))]
         (lambda-lower-clauses (dr-env r) cs results cparams (+ i 1)
                               (form/append-form acc (form/vec4 (form/nth-of c 0) (dr-form r)
                                                                (form/form-get results (form/int-form n))
                                                                (form/form-get cparams (form/int-form n))))))))
   :default nil)

;; the free symbols of every lowered body (params bound), as a set
#?(:kotoba
   (defn lambda-captures [lowered [:list [:ref :form/r]] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (vector-count lowered))
       acc
       (let [c (typed-list-nth [:list [:ref :form/r]] lowered i)
             a (free-syms (form/nth-of c 1) (form/form-set (form/kids-of (form/nth-of c 0))) acc)]
         (lambda-captures lowered (+ i 1) a))))
   :default nil)

#?(:kotoba
   (defn lambda-too-wide [lowered [:list [:ref :form/r]] captures [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count lowered))
       false
       (or (> (+ (vector-count captures) (form/count-of (form/nth-of (typed-list-nth [:list [:ref :form/r]] lowered i) 0))) 64)
           (lambda-too-wide lowered captures (+ i 1)))))
   :default nil)

;; N copies of :i64 appended to the Form list ACC
#?(:kotoba
   (defn i64-types-n [n :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (<= n 0) acc (i64-types-n (- n 1) (form/append-form acc (form/keyword-form :i64)))))
   :default nil)

;; the lifted infos {:id :arity :captures :helper {...}} of the clauses; a contract clause adds :contract-result / :parameter-types and the
;; helper's :param-types (the captures stay the i64 pair-chain words they are read out of, only the clause's own parameters carry the types)
#?(:kotoba
   (defn lambda-info [id :i64 captures [:list [:ref :form/r]] params [:ref :form/r] body [:ref :form/r] lazy? :bool cres [:ref :form/r] cpar [:ref :form/r]] [:ref :form/r]
     (let [arity (form/count-of params)
           helper (form/symbol-form (string-concat "__kotoba_lambda_" (string-concat (string-from-i64 id) (string-concat "_arity" (string-from-i64 arity)))))
           hmap0 (form/assoc-form
                  (form/assoc-form
                   (form/assoc-form
                    (form/assoc-form
                     (form/assoc-form
                      (form/assoc-form
                       (form/assoc-form (form/form-map (form/no-forms)) (form/keyword-form :name) helper)
                       (form/keyword-form :params) (form/form-vec (form/append-many captures (form/kids-of params))))
                      (form/keyword-form :result) (form/keyword-form :i64))
                     (form/keyword-form :result-inferred?) (form/bool-form true))
                    (form/keyword-form :effects) (form/form-set (form/no-forms)))
                   (form/keyword-form :body) body)
                  (form/keyword-form :lazy-thunk?) (form/bool-form lazy?))
           hmap (if (form/is-nil? cpar)
                  hmap0
                  (form/assoc-form hmap0 (form/keyword-form :param-types)
                                   (form/form-vec (form/append-many (i64-types-n (vector-count captures) (form/no-forms)) (form/kids-of cpar)))))
           info0 (form/assoc-form
                  (form/assoc-form
                   (form/assoc-form
                    (form/assoc-form (form/form-map (form/no-forms)) (form/keyword-form :id) (form/int-form id))
                    (form/keyword-form :arity) (form/int-form arity))
                   (form/keyword-form :captures) (form/form-vec captures))
                  (form/keyword-form :helper) hmap)
           info1 (if (form/is-nil? cres) info0 (form/assoc-form info0 (form/keyword-form :contract-result) cres))]
       (if (form/is-nil? cpar) info1 (form/assoc-form info1 (form/keyword-form :parameter-types) cpar))))
   :default nil)

#?(:kotoba
   (defn lambda-infos [id :i64 captures [:list [:ref :form/r]] lowered [:list [:ref :form/r]] lazy? :bool i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count lowered))
       acc
       (let [c (typed-list-nth [:list [:ref :form/r]] lowered i)]
         (lambda-infos id captures lowered lazy? (+ i 1)
                       (form/append-form acc (lambda-info id captures (form/nth-of c 0) (form/nth-of c 1) lazy? (form/nth-of c 2) (form/nth-of c 3)))))))
   :default nil)

;; (fn [params] body) / (fn ([p] b) ...) lifted to top-level helpers `__kotoba_lambda_ID_arityN` and replaced by `(pair ID captures)`
;; the expected contract's result type by arity ({arity result}) and its non-i64 parameter types by arity ({arity [types]})
#?(:kotoba
   (defn contract-results-map [cclauses [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (form/count-of cclauses))
       acc
       (let [c (form/nth-of cclauses i)]
         (contract-results-map cclauses (+ i 1) (form/assoc-form acc (form/int-form (form/count-of (form/nth-of c 0))) (form/nth-of c 1))))))
   :default nil)

#?(:kotoba
   (defn contract-params-map [cclauses [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (form/count-of cclauses))
       acc
       (let [c (form/nth-of cclauses i)
             ps (form/nth-of c 0)]
         (contract-params-map cclauses (+ i 1)
                              (if (i64-types? ps 0) acc (form/assoc-form acc (form/int-form (form/count-of ps)) ps))))))
   :default nil)

;; every clause arity is an arity of the contract
#?(:kotoba
   (defn contract-arities-in? [clauses [:list [:ref :form/r]] i :i64 cres [:ref :form/r]] :bool
     (if (>= i (vector-count clauses))
       true
       (and (form/form-has? cres (form/int-form (form/count-of (form/nth-of (typed-list-nth [:list [:ref :form/r]] clauses i) 0))))
            (contract-arities-in? clauses (+ i 1) cres))))
   :default nil)

;; the clause arities and the contract's arities are the same set (the clauses have unique arities)
#?(:kotoba
   (defn contract-arities-match? [clauses [:list [:ref :form/r]] cres [:ref :form/r]] :bool
     (and (= (vector-count clauses) (quot (form/count-of cres) 2)) (contract-arities-in? clauses 0 cres)))
   :default nil)

#?(:kotoba
   (defn lift-lambda-k [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [raw (lambda-clauses-of form)
           clauses (lambda-expand-clauses raw form)
           expected-contract (env-con env :expected)
           cclauses (callable-clauses expected-contract)
           cres (contract-results-map cclauses 0 (form/form-map (form/no-forms)))
           cparams (contract-params-map cclauses 0 (form/form-map (form/no-forms)))
           _ (require-k (or (form/is-nil? expected-contract) (contract-arities-match? clauses cres))
                        "fn arities do not match the declared callable result contract" "kotoba.error/callable-result-arity" form)
           _ (require-k (and (> (vector-count clauses) 0) (clauses-valid? clauses 0))
                        "fn value requires unique arities with zero to four unique parameters" "kotoba.error/subset-reject" form)
           _ (require-k (not (and (form/is-vec? (if (> (form/count-of form) 1) (form/nth-of form 1) (form/nil-form))) (= 2 (form/count-of form))))
                        "single-arity fn value requires exactly one body" "kotoba.error/subset-reject" form)
           lowered (lambda-lower-clauses env clauses cres cparams 0 (form/no-forms))
           lenv (drs-env lowered)
           lforms (drs-forms lowered)
           free (lambda-captures lforms 0 (form/form-set (form/no-forms)))
           captures (sorted-symbols free 0 (form/no-forms))
           id (+ (env-lambda-counter lenv) 1)
           _ (require-k (not (lambda-too-wide lforms captures 0)) "fn captures plus parameters exceed ABI-supported arity" "kotoba.error/subset-reject" form)
           env2 (with-lambdas lenv id (lambda-infos id captures lforms (env-lazy? lenv) 0 (form/no-forms)))
           expected (env-result env2)
           listed (desugar-list-arm (with-result env2 (form/nil-form)) (head-call (form/symbol-form "list") captures) (form/nil-form))]
       (dr (with-result (dr-env listed) expected) (form/call2 "pair" (form/int-form id) (dr-form listed)))))
   :default nil)

#?(:kotoba
   (defn desugar-fn [env [:ref :fe/env] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [saved (env-result env)
           r (lift-lambda-k (with-result env ctx) form)]
       (dr (with-result (dr-env r) saved) (dr-form r))))
   :default nil)

;; ---- fn-ref, apply, invoke ----
#?(:kotoba
   (defn sorted-ints [s [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of s))
       acc
       (sorted-ints s (+ i 1) (insert-int acc (form/nth-of s i)))))
   :default nil)

#?(:kotoba
   (defn first-int-greater [xs [:list [:ref :form/r]] x [:ref :form/r] i :i64] :i64
     (if (>= i (vector-count xs))
       i
       (if (> (form/int-value (typed-list-nth [:list [:ref :form/r]] xs i)) (form/int-value x))
         i
         (first-int-greater xs x (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn insert-int [xs [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
     (let [p (first-int-greater xs x 0)]
       (slice-forms xs p (vector-count xs) (form/append-form (slice-forms xs 0 p (form/no-forms)) x))))
   :default nil)

#?(:kotoba
   (defn any-int-over [s [:ref :form/r] limit :i64 i :i64] :bool
     (if (>= i (form/count-of s))
       false
       (or (> (form/int-value (form/nth-of s i)) limit) (any-int-over s limit (+ i 1)))))
   :default nil)

;; the parameter symbols __kotoba_fn_ref_arg_0 .. _{n-1}
#?(:kotoba
   (defn fn-ref-params [n :i64 i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i n)
       acc
       (fn-ref-params n (+ i 1) (form/append-form acc (form/symbol-form (string-concat "__kotoba_fn_ref_arg_" (string-from-i64 i)))))))
   :default nil)

;; (fn ([a0 ..] (f a0 ..)) ...) over the sorted arities of F
#?(:kotoba
   (defn fn-ref-clauses [f [:ref :form/r] arities [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count arities))
       acc
       (let [ps (fn-ref-params (form/int-value (typed-list-nth [:list [:ref :form/r]] arities i)) 0 (form/no-forms))]
         (fn-ref-clauses f arities (+ i 1)
                         (form/append-form acc (form/form-seq (form/two-forms (form/form-vec ps) (head-call f ps))))))))
   :default nil)

#?(:kotoba
   (defn desugar-fn-ref [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (if (tables/table-has? (env-arities env) op)
       (desugar-ordinary-call env op form)
       (let [_ (require-k (and (= 1 (argc form)) (form/is-symbol? (arg form 0)))
                          "fn-ref requires one top-level function symbol" "kotoba.error/subset-reject" form)
             f (arg form 0)
             arities (tables/table-get (env-arities env) f)
             _ (require-k (and (not (form/is-nil? arities)) (> (form/count-of arities) 0))
                          "fn-ref requires a declared top-level function" "kotoba.error/subset-reject" f)
             _ (require-k (not (any-int-over arities 4 0)) "fn-ref target exceeds closure ABI arity four" "kotoba.error/subset-reject" f)]
         (lift-lambda-k env (head-call (form/symbol-form "fn") (fn-ref-clauses f (sorted-ints arities 0 (form/no-forms)) 0 (form/no-forms)))))))
   :default nil)

;; (apply closure fixed... collection): the fixed arguments consed onto the collection, the closure applied by the runtime helper
#?(:kotoba
   (defn apply-arg-list [env [:ref :fe/env] form [:ref :form/r] i :i64 tail [:ref :form/r]] [:ref :fe/dr]
     (if (< i 2)
       (dr env tail)
       (let [v (desugar-expr env (form/nth-of form i))]
         (apply-arg-list (dr-env v) form (- i 1) (form/call2 "pair" (dr-form v) tail)))))
   :default nil)

#?(:kotoba
   (defn desugar-apply [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (if (tables/table-has? (env-arities env) op)
       (desugar-ordinary-call env op form)
       (let [_ (require-k (and (<= 2 (argc form)) (<= (argc form) 6))
                          "apply requires a closure, up to four fixed arguments, and a final argument collection" "kotoba.error/subset-reject" form)
             env1 (with-uses-apply env)
             trailing (desugar-expr env1 (arg form (- (argc form) 1)))
             args (apply-arg-list (dr-env trailing) form (- (argc form) 1) (dr-form trailing))
             closure (desugar-expr (dr-env args) (arg form 0))]
         (dr (dr-env closure) (form/call2 "__kotoba_closure_apply" (dr-form closure) (dr-form args))))))
   :default nil)

#?(:kotoba
   (defn invoke-result-type [env [:ref :fe/env] declared [:ref :form/r] typed? :bool ctx [:ref :form/r]] [:ref :form/r]
     (cond
       typed? (canonical-closure-result-type env declared)
       (not (form/is-nil? ctx)) (canonical-closure-result-type env ctx)
       :else (form/keyword-form :i64)))
   :default nil)

#?(:kotoba
   (defn desugar-invoke-args [env [:ref :fe/env] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-expr env (form/nth-of form i))]
         (desugar-invoke-args (dr-env r) form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

#?(:kotoba
   (defn desugar-invoke [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (if (tables/table-has? (env-arities env) op)
       (desugar-ordinary-call env op form)
       (let [declared (if (> (argc form) 0) (arg form 0) (form/nil-form))
             typed? (closure-result-type? declared)
             _ (require-k (not (and (or (form/is-keyword? declared) (structured-type? declared)) (not typed?)))
                          "closure result type is outside the admitted dispatcher profile" "kotoba.error/subset-reject" declared)
             rt (invoke-result-type env declared typed? ctx)
             first-call (if typed? 2 1)
             _ (require-k (and (<= 1 (- (argc form) (- first-call 1))) (<= (- (argc form) (- first-call 1)) 5))
                          "invoke requires an optional admitted result descriptor, a closure, and zero to four arguments"
                          "kotoba.error/subset-reject" form)
             n (- (argc form) first-call)
             name (request-dispatcher env rt n form)
             closure (desugar-result-expr (dr-env name) rt (form/nth-of form first-call))
             rest-args (desugar-invoke-args (dr-env closure) form (+ first-call 1) (form/no-forms))]
         (dr (drs-env rest-args)
             (head-call (dr-form name) (form/cons-onto (dr-form closure) (drs-forms rest-args)))))))
   :default nil)

;; the clause forms of an inline fn callback of a no-init reduce whose parameter vectors have exactly the arities 0 and 2
#?(:kotoba
   (defn reduce-clause-arity [f [:ref :form/r] i :i64] :i64
     ;; the arity of clause I of the fn F, or -1 when the clause is not ([params] ...)
     (let [c (form/nth-of f i)]
       (if (and (form/is-seq? c) (> (form/count-of c) 0) (form/is-vec? (form/nth-of c 0)))
         (form/count-of (form/nth-of c 0))
         -1)))
   :default nil)

#?(:kotoba
   (defn reduce-arities-ok? [f [:ref :form/r] i :i64 has0 :bool has2 :bool] :bool
     (if (>= i (form/count-of f))
       (and has0 has2)
       (let [a (reduce-clause-arity f i)]
         (cond
           (= a 0) (reduce-arities-ok? f (+ i 1) true has2)
           (= a 2) (reduce-arities-ok? f (+ i 1) has0 true)
           :else false))))
   :default nil)

;; (reduce f coll): the first element seeds the accumulator; an empty collection answers (f)
#?(:kotoba
   (defn desugar-reduce-no-init [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [f (arg form 0)
           coll-form (arg form 1)
           named? (top-level-function-symbol? env f)
           _ (require-k (or (not named?) (and (function-has-arity? env f 0) (function-has-arity? env f 2)))
                        "named no-init reduce callback must provide arities 0 and 2" "kotoba.error/subset-reject" f)
           inline? (head-is? f "fn")
           _ (require-k (or (not inline?)
                            (and (> (form/count-of f) 1) (not (form/is-vec? (form/nth-of f 1))) (reduce-arities-ok? f 1 false false)))
                        "inline no-init reduce callback must define exactly [] and [acc value] arities" "kotoba.error/subset-reject" f)
           cb-r (desugar-expr env (if named? (form/call1 "fn-ref" f) f))
           coll-r (desugar-result-expr (dr-env cb-r) (form/keyword-form :vector-i64) coll-form)
           cs (synthetic (dr-env coll-r) "reduce_callback")
           vs (synthetic (dr-env cs) "reduce_v")
           is (synthetic (dr-env vs) "reduce_i")
           as (synthetic (dr-env is) "reduce_acc")
           cb (dr-form cs) v (dr-form vs) i (dr-form is) acc (dr-form as)]
       (desugar-expr (dr-env as)
                     (form/call2 "let" (form/vec4 cb (dr-form cb-r) v (dr-form coll-r))
                       (form/call3 "if" (form/call2 "=" (form/call1 "vector-count" v) (form/int-form 0))
                         (form/form-seq (form/two-forms (form/symbol-form "__kotoba_invoke$arity0") cb))
                         (form/call2 "loop" (form/vec4 i (form/int-form 1) acc (form/call2 "vector-at" v (form/int-form 0)))
                           (form/call3 "if" (form/call2 "<" i (form/call1 "vector-count" v))
                             (form/call2 "recur" (form/call2 "+" i (form/int-form 1))
                             (form/form-seq (form/cons-onto (invoke-name-i64 2) (form/three-forms cb acc (form/call2 "vector-at" v i)))))
                             acc)))))))
   :default nil)

;; ---- lexical calls, lazy sequences (take, drop, lazy-cons/first/rest/empty?), char, string-join ----
#?(:kotoba
   (defn lexical-call-clause [contract [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (if (form/is-nil? contract)
       (form/nil-form)
       (contract-clause-at (callable-clauses contract) (argc form) 0 form)))
   :default nil)

;; the arguments of a call of a local closure under a contract clause: an :i64 parameter desugars as ever, any other under its type
#?(:kotoba
   (defn lexical-call-args [env [:ref :fe/env] form [:ref :form/r] i :i64 ptypes [:ref :form/r] acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [wanted (form/nth-of ptypes (- i 1))
             a (if (form/eq wanted (form/keyword-form :i64))
                 (desugar-expr env (form/nth-of form i))
                 (desugar-expected-value env wanted (form/nth-of form i)))]
         (lexical-call-args (dr-env a) form (+ i 1) ptypes (form/append-form acc (dr-form a))))))
   :default nil)

;; a call of a local closure: with a contract (`*lexical-callable-contracts*`) the clause of that arity gives the parameter types, which select the
;; dispatcher family, and the result type; without one the family is the contextual result type (i64 when there is none)
#?(:kotoba
   (defn desugar-lexical-call-k [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (<= (argc form) 4) "direct closure call exceeds ABI arity four" "kotoba.error/subset-reject" form)
           clause (lexical-call-clause (form/form-get (env-con env :lexical) op) form)
           ptypes (form/nth-of clause 0)
           cres (form/nth-of clause 1)
           rt (if (form/is-nil? cres) (if (form/is-nil? ctx) (form/keyword-form :i64) ctx) cres)
           name (request-dispatcher-p env rt (argc form) ptypes form)
           args (if (form/is-nil? ptypes)
                  (desugar-each (dr-env name) form 1 (form/no-forms))
                  (lexical-call-args (dr-env name) form 1 ptypes (form/no-forms)))]
       (dr (drs-env args) (head-call (dr-form name) (form/cons-onto op (drs-forms args))))))
   :default nil)

#?(:kotoba
   (defn with-uses-lazy [env [:ref :fe/env]] [:ref :fe/env] (record-assoc [:ref :fe/env] env :uses-lazy true))
   :default nil)

#?(:kotoba
   (defn with-lazy [env [:ref :fe/env] b :bool] [:ref :fe/env] (record-assoc [:ref :fe/env] env :lazy (if b true false)))
   :default nil)

#?(:kotoba
   (defn env-uses-lazy? [env [:ref :fe/env]] :bool (record-get [:ref :fe/env] env :uses-lazy))
   :default nil)

#?(:kotoba
   (defn invoke-name-0 [] [:ref :form/r] (form/symbol-form "__kotoba_invoke$arity0"))
   :default nil)

;; (take n s) / (drop n s) over lazy sequences
#?(:kotoba
   (defn desugar-lazy-count-op [env [:ref :fe/env] form [:ref :form/r] opn :string helper :string msg :string] [:ref :fe/dr]
     (let [_ (require-k (= 2 (argc form)) msg "kotoba.error/subset-reject" form)
           env1 (with-uses-lazy env)
           a (desugar-expr env1 (arg form 0))
           b (desugar-expr (dr-env a) (arg form 1))]
       (dr (dr-env b) (form/call2 helper (dr-form a) (dr-form b)))))
   :default nil)

;; (lazy-first s) / (lazy-rest s): the thunk is forced once and the head (or the tail thunk) taken out of its cell
#?(:kotoba
   (defn desugar-lazy-part [env [:ref :fe/env] form [:ref :form/r] msg :string part :string] [:ref :fe/dr]
     (let [_ (require-k (= 1 (argc form)) msg "kotoba.error/subset-reject" form)
           env1 (with-uses-lazy env)
           ls (synthetic env1 "lazy_seq")
           cs (synthetic (dr-env ls) "lazy_cell")
           seq-sym (dr-form ls)
           cell (dr-form cs)
           v (desugar-expr (dr-env cs) (arg form 0))]
       (dr (dr-env v)
           (form/call2 "let" (form/vec2 seq-sym (dr-form v))
                       (form/call3 "if" (form/call2 "=" seq-sym (form/int-form 0))
                                   (form/int-form 0)
                                   (form/call2 "let" (form/vec2 cell (form/form-seq (form/two-forms (invoke-name-0) seq-sym)))
                                               (form/call3 "if" (form/call2 "=" cell (form/int-form 0))
                                                           (form/int-form 0)
                                                           (form/form-seq (form/two-forms (invoke-name-0) (form/call1 part cell))))))))))
   :default nil)

#?(:kotoba
   (defn desugar-lazy-empty [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 1 (argc form)) "lazy-empty? requires one lazy sequence" "kotoba.error/subset-reject" form)
           env1 (with-uses-lazy env)
           ls (synthetic env1 "lazy_seq")
           seq-sym (dr-form ls)
           v (desugar-expr (dr-env ls) (arg form 0))]
       (dr (dr-env v)
           (form/call2 "let" (form/vec2 seq-sym (dr-form v))
                       (form/call3 "if" (form/call2 "=" seq-sym (form/int-form 0))
                                   (form/bool-form true)
                                   (form/call2 "=" (form/form-seq (form/two-forms (invoke-name-0) seq-sym)) (form/int-form 0)))))))
   :default nil)

;; (lazy-cons head tail): the thunk of a pair of thunks, lifted with the lazy-thunk flag on for its whole extent
#?(:kotoba
   (defn desugar-lazy-cons [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 2 (argc form)) "lazy-cons requires a head and lazy tail expression" "kotoba.error/subset-reject" form)
           env1 (with-lazy (with-uses-lazy env) true)
           saved-lazy (env-lazy? env)
           r (lift-lambda-k env1
                            (form/call2 "fn" (form/form-vec (form/no-forms))
                                        (form/call2 "pair"
                                                    (form/call2 "fn" (form/form-vec (form/no-forms)) (arg form 0))
                                                    (form/call2 "fn" (form/form-vec (form/no-forms)) (arg form 1)))))]
       (dr (with-lazy (dr-env r) saved-lazy) (dr-form r))))
   :default nil)

;; (char code) is the helper call, a literal string stays as it is
#?(:kotoba
   (defn desugar-char [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (if (tables/table-has? (env-arities env) op)
       (desugar-ordinary-call env op form)
       (let [_ (require-k (= 1 (argc form)) "char requires one code point" "kotoba.error/subset-reject" form)]
         (if (form/is-string? (arg form 0))
           (dr env (arg form 0))
           (let [a (desugar-expr env (arg form 0))]
             (dr (dr-env a) (form/call1 "__kotoba_char" (dr-form a))))))))
   :default nil)

;; the string parts of (string-join sep part ...), each under the :string context
#?(:kotoba
   (defn desugar-string-parts [env [:ref :fe/env] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-result-expr env (form/keyword-form :string) (form/nth-of form i))]
         (desugar-string-parts (dr-env r) form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

#?(:kotoba
   (defn join-fold [sep [:ref :form/r] parts [:list [:ref :form/r]] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (vector-count parts))
       acc
       (join-fold sep parts (+ i 1)
                  (form/call2 "string-concat" acc
                              (form/call2 "string-concat" sep (typed-list-nth [:list [:ref :form/r]] parts i))))))
   :default nil)

#?(:kotoba
   (defn desugar-string-join [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) "string-join requires a separator string" "kotoba.error/subset-reject" form)
           sep (desugar-result-expr env (form/keyword-form :string) (arg form 0))
           parts (desugar-string-parts (dr-env sep) form 2 (form/no-forms))
           ps (drs-forms parts)]
       (dr (drs-env parts)
           (cond
             (= 0 (vector-count ps)) (form/string-form "")
             (= 1 (vector-count ps)) (typed-list-nth [:list [:ref :form/r]] ps 0)
             :else (join-fold (dr-form sep) ps 1 (typed-list-nth [:list [:ref :form/r]] ps 0))))))
   :default nil)

;; `dotimes` / `doseq` bind the abort context to :loop for their whole lowering
#?(:kotoba
   (defn desugar-expr-in-loop [env [:ref :fe/env] f [:ref :form/r]] [:ref :fe/dr]
     (let [saved (env-abort-ctx env)
           r (desugar-expr (with-abort-ctx env "loop") f)]
       (dr (with-abort-ctx (dr-env r) saved) (dr-form r))))
   :default nil)

;; ---- match on the Kotoba route (selfhost S3): pattern plans over Form ----
;; A plan is the Form vector [temps tests binds]: `temps` and `binds` are vectors of [symbol expr] pairs, `tests` a vector of
;; expressions. The synthetic counter is threaded through the plans of the arms (a map pattern names its projections).
#?(:kotoba
   (defn match-plan [temps [:ref :form/r] tests [:ref :form/r] binds [:ref :form/r]] [:ref :form/r]
     (form/vec3 temps tests binds))
   :default nil)

#?(:kotoba
   (defn match-empty-vec [] [:ref :form/r] (form/form-vec (form/no-forms)))
   :default nil)

#?(:kotoba
   (defn match-literal-k? [p [:ref :form/r]] :bool
     (or (form/is-int? p) (form/is-keyword? p) (form/is-bool? p) (form/is-string? p)))
   :default nil)

;; all keys of the map pattern (the even kids) are keywords
#?(:kotoba
   (defn match-keys-keywords? [m [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of m))
       true
       (and (form/is-keyword? (form/nth-of m i)) (match-keys-keywords? m (+ i 2)))))
   :default nil)

;; the entries of the map pattern as [key sub-pattern] vectors ordered by the key text (`(sort-by (comp str key) pattern)`)
#?(:kotoba
   (defn match-entry-position [sorted [:list [:ref :form/r]] key-text :string i :i64] :i64
     (if (>= i (vector-count sorted))
       i
       (if (> (string-compare (kw-text (form/nth-of (typed-list-nth [:list [:ref :form/r]] sorted i) 0)) key-text) 0)
         i
         (match-entry-position sorted key-text (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn match-sorted-entries [m [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= (+ i 1) (form/count-of m))
       acc
       (let [e (form/vec2 (form/nth-of m i) (form/nth-of m (+ i 1)))
             p (match-entry-position acc (kw-text (form/nth-of m i)) 0)]
         (match-sorted-entries m (+ i 2)
                               (slice-forms acc p (vector-count acc) (form/append-form (slice-forms acc 0 p (form/no-forms)) e))))))
   :default nil)

;; the plan of a map pattern's entries from index I: the projection temp, the presence test and the sub-plan of each
#?(:kotoba
   (defn match-map-entries [env [:ref :fe/env] entries [:list [:ref :form/r]] i :i64 subject [:ref :form/r] form [:ref :form/r] plan [:ref :form/r]] [:ref :fe/dr]
     (if (>= i (vector-count entries))
       (dr env plan)
       (let [e (typed-list-nth [:list [:ref :form/r]] entries i)
             key (form/nth-of e 0)
             ps (synthetic env "match-key")
             projection (dr-form ps)
             sub (match-plan-k (dr-env ps) (form/nth-of e 1) projection form true)
             sp (dr-form sub)]
         (match-map-entries (dr-env sub) entries (+ i 1) subject form
                            (match-plan
                             (form/form-vec (form/append-many (form/append-form (form/kids-of (form/nth-of plan 0)) (form/vec2 projection (form/call2 "get" subject key)))
                                                              (form/kids-of (form/nth-of sp 0))))
                             (form/form-vec (form/append-many (form/append-form (form/kids-of (form/nth-of plan 1)) (form/call2 "__kotoba_match_has" subject key))
                                                              (form/kids-of (form/nth-of sp 1))))
                             (form/form-vec (form/append-many (form/kids-of (form/nth-of plan 2)) (form/kids-of (form/nth-of sp 2)))))))))
   :default nil)

#?(:kotoba
   (defn match-plan-k [env [:ref :fe/env] pattern [:ref :form/r] subject [:ref :form/r] form [:ref :form/r] nested? :bool] [:ref :fe/dr]
     (cond
       (sym-is? pattern "_") (dr env (match-plan (match-empty-vec) (match-empty-vec) (match-empty-vec)))
       (form/is-symbol? pattern)
       (let [_ (require-k (simple-symbol-form? pattern) "match binding pattern must be an unqualified symbol" "kotoba.error/subset-reject" form)]
         (dr env (match-plan (match-empty-vec) (match-empty-vec) (form/form-vec (form/one-form (form/vec2 pattern subject))))))
       (match-literal-k? pattern)
       (dr env (match-plan (match-empty-vec)
                           (form/form-vec (form/one-form (if (form/is-string? pattern)
                                                           (form/call2 "string=?" subject pattern)
                                                           (form/call2 "=" subject pattern))))
                           (match-empty-vec)))
       (form/is-map? pattern) (match-map-pattern env pattern subject form nested?)
       (form/is-vec? pattern) (throw (fe-reject "match does not admit vector patterns" "kotoba.error/subset-reject" form))
       (form/is-set? pattern) (throw (fe-reject "match does not admit set patterns" "kotoba.error/subset-reject" form))
       (form/is-seq? pattern) (throw (fe-reject "match does not admit list patterns or guards" "kotoba.error/subset-reject" form))
       :else (throw (fe-reject "match admits `_`, an unqualified symbol, a bounded integer, keyword, boolean or string literal, and a keyword-keyed map pattern"
                               "kotoba.error/subset-reject" form))))
   :default nil)

#?(:kotoba
   (defn match-map-pattern [env [:ref :fe/env] pattern [:ref :form/r] subject [:ref :form/r] form [:ref :form/r] nested? :bool] [:ref :fe/dr]
     (let [n (quot (form/count-of pattern) 2)
           _ (require-k (not nested?) "match map pattern values admit `_`, an unqualified symbol, or a bounded literal" "kotoba.error/subset-reject" form)
           _ (require-k (> n 0) "match map pattern requires at least one key" "kotoba.error/subset-reject" form)
           _ (require-k (<= n 8) "match map pattern key count exceeds admission limit" "kotoba.error/subset-reject" form)
           _ (require-k (match-keys-keywords? pattern 0) "match map pattern keys must be keywords" "kotoba.error/subset-reject" form)]
       (match-map-entries env (match-sorted-entries pattern 0 (form/no-forms)) 0 subject form
                          (match-plan (match-empty-vec) (match-empty-vec) (match-empty-vec)))))
   :default nil)

;; `match-conj-k`: nested `if`, a lone test as itself
#?(:kotoba
   (defn match-conj-k [tests [:ref :form/r] i :i64] [:ref :form/r]
     (cond
       (>= i (form/count-of tests)) (form/bool-form true)
       (= (+ i 1) (form/count-of tests)) (form/nth-of tests i)
       :else (form/call3 "if" (form/nth-of tests i) (match-conj-k tests (+ i 1)) (form/bool-form false))))
   :default nil)

;; the flat [sym expr sym expr ...] vector of a vector of pairs
#?(:kotoba
   (defn match-flatten [pairs [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of pairs))
       acc
       (match-flatten pairs (+ i 1)
                      (form/append-form (form/append-form acc (form/nth-of (form/nth-of pairs i) 0)) (form/nth-of (form/nth-of pairs i) 1)))))
   :default nil)

;; one arm with FALLBACK (the rest of the match) appearing once
#?(:kotoba
   (defn match-arm-k [plan [:ref :form/r] result [:ref :form/r] fallback [:ref :form/r]] [:ref :form/r]
     (let [temps (form/nth-of plan 0)
           tests (form/nth-of plan 1)
           binds (form/nth-of plan 2)
           matched (if (> (form/count-of binds) 0)
                     (form/call2 "let" (form/form-vec (match-flatten binds 0 (form/no-forms))) result)
                     result)
           chosen (if (= 0 (form/count-of tests))
                    matched
                    (form/call3 "if" (match-conj-k tests 0) matched fallback))]
       (if (> (form/count-of temps) 0)
         (form/call2 "let" (form/form-vec (match-flatten temps 0 (form/no-forms))) chosen)
         chosen)))
   :default nil)

;; the plans of the arms 0..n-1 (the pattern of arm k is form index 2+2k), counter threaded
#?(:kotoba
   (defn match-plans [env [:ref :fe/env] form [:ref :form/r] subject [:ref :form/r] k :i64 n :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= k n)
       (drs env acc)
       (let [r (match-plan-k env (form/nth-of form (+ 2 (* 2 k))) subject form false)]
         (match-plans (dr-env r) form subject (+ k 1) n (form/append-form acc (dr-form r))))))
   :default nil)

;; an arm with no tests always matches: nothing after it can run
#?(:kotoba
   (defn match-reachable [plans [:list [:ref :form/r]] i :i64 else? :bool form [:ref :form/r]] :i64
     (if (>= i (vector-count plans))
       0
       (let [_ (require-k (not (and (= 0 (form/count-of (form/nth-of (typed-list-nth [:list [:ref :form/r]] plans i) 1)))
                                    (or else? (< i (- (vector-count plans) 1)))))
                          "match clause after an irrefutable pattern is unreachable" "kotoba.error/subset-reject" form)]
         (match-reachable plans (+ i 1) else? form))))
   :default nil)

;; the bound names of a plan are pairwise distinct
#?(:kotoba
   (defn match-bind-names-distinct? [binds [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of binds))
       true
       (and (match-name-differs? binds (form/nth-of (form/nth-of binds i) 0) (+ i 1))
            (match-bind-names-distinct? binds (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn match-name-differs? [binds [:ref :form/r] x [:ref :form/r] j :i64] :bool
     (if (>= j (form/count-of binds))
       true
       (and (not (form/eq x (form/nth-of (form/nth-of binds j) 0))) (match-name-differs? binds x (+ j 1)))))
   :default nil)

#?(:kotoba
   (defn match-no-duplicate-binds [plans [:list [:ref :form/r]] i :i64 form [:ref :form/r]] :i64
     (if (>= i (vector-count plans))
       0
       (let [_ (require-k (match-bind-names-distinct? (form/nth-of (typed-list-nth [:list [:ref :form/r]] plans i) 2) 0)
                          "match pattern binds the same symbol twice" "kotoba.error/subset-reject" form)]
         (match-no-duplicate-binds plans (+ i 1) form))))
   :default nil)

;; the arms folded from the last to the first around FALLBACK, each result desugared as it is reached
#?(:kotoba
   (defn match-fold [env [:ref :fe/env] form [:ref :form/r] plans [:list [:ref :form/r]] k :i64 fallback [:ref :form/r]] [:ref :fe/dr]
     (if (< k 0)
       (dr env fallback)
       (let [r (desugar-expr env (form/nth-of form (+ 3 (* 2 k))))]
         (match-fold (dr-env r) form plans (- k 1)
                     (match-arm-k (typed-list-nth [:list [:ref :form/r]] plans k) (dr-form r) fallback)))))
   :default nil)

;; is the pattern at clause index K the keyword :else; the index of the first, -1 for none, and how many
#?(:kotoba
   (defn match-else-count [form [:ref :form/r] k :i64 n :i64 acc :i64] :i64
     (if (>= k n)
       acc
       (match-else-count form (+ k 1) n
                         (if (form/eq (form/nth-of form (+ 2 (* 2 k))) (form/keyword-form :else)) (+ acc 1) acc))))
   :default nil)

#?(:kotoba
   (defn desugar-match-k [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) "match requires a scrutinee expression" "kotoba.error/subset-reject" form)
           clauses (- (argc form) 1)
           _ (require-k (= 0 (rem clauses 2)) "match requires pattern/result pairs" "kotoba.error/subset-reject" form)
           _ (require-k (> clauses 0) "match requires at least one pattern/result pair" "kotoba.error/subset-reject" form)
           npairs (quot clauses 2)
           _ (require-k (<= npairs 32) "match clause count exceeds admission limit" "kotoba.error/subset-reject" form)
           elses (match-else-count form 0 npairs 0)
           _ (require-k (<= elses 1) "match admits at most one :else clause" "kotoba.error/subset-reject" form)
           else? (= elses 1)
           _ (require-k (or (not else?) (form/eq (form/nth-of form (+ 2 (* 2 (- npairs 1)))) (form/keyword-form :else)))
                        "match :else clause must be last" "kotoba.error/subset-reject" form)
           narms (if else? (- npairs 1) npairs)
           default (if else? (form/nth-of form (+ 3 (* 2 (- npairs 1)))) (form/call2 "quot" (form/int-form 1) (form/int-form 0)))
           ss (synthetic env "match")
           subject (dr-form ss)
           plans-r (match-plans (dr-env ss) form subject 0 narms (form/no-forms))
           plans (drs-forms plans-r)
           _ (match-reachable plans 0 else? form)
           _ (match-no-duplicate-binds plans 0 form)
           scrut (desugar-expr (drs-env plans-r) (arg form 0))
           dflt (desugar-expr (dr-env scrut) default)
           folded (match-fold (dr-env dflt) form plans (- narms 1) (dr-form dflt))]
       (dr (dr-env folded) (form/call2 "let" (form/vec2 subject (dr-form scrut)) (dr-form folded)))))
   :default nil)

;; ---- coordination forms and capability calls on the Kotoba route: assert! retract! observe! facet-enter! facet-leave!, cap-call, typed-cap-call, eval ----
;; The named capability resolver (`resolve-capability-keyword!`) seals the wire id from the registry table and notes the keyword in
;; the used-capability set; a source location rides as Form span data on this route, so `attach-source-operation` is the identity.
#?(:kotoba
   (defn capability-id [env [:ref :fe/env] kw [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (let [id (tables/table-get (env-table env :cap-registry) kw)
           _ (require-k (not (form/is-nil? id)) (string-concat "cap-call names an unregistered capability: " (kw-text kw))
                        "kotoba.error/subset-reject" form)]
       id))
   :default nil)

;; the dataspace descriptors (capability-kits/dataspace-v1.edn), spelled as the host's constants
#?(:kotoba
   (defn dataspace-types-k [which :string] [:ref :form/r]
     (cond
       (string=? which "assert") (form/edn-form "[:record :kotoba.dataspace/assert [[:assertion :document] [:facet :i64]]]")
       (string=? which "retract") (form/edn-form "[:record :kotoba.dataspace/retract [[:assertion :document] [:facet :i64]]]")
       (string=? which "observe") (form/edn-form "[:record :kotoba.dataspace/observe [[:pattern :document] [:facet :i64]]]")
       (string=? which "request")
       (form/edn-form "[:variant :kotoba.dataspace/request [[:assert [:record :kotoba.dataspace/assert [[:assertion :document] [:facet :i64]]]] [:retract [:record :kotoba.dataspace/retract [[:assertion :document] [:facet :i64]]]] [:observe [:record :kotoba.dataspace/observe [[:pattern :document] [:facet :i64]]]] [:facet-enter :bool] [:facet-leave :i64]]]")
       :else
       (form/edn-form "[:variant :kotoba.dataspace/result [[:asserted [:record :kotoba.dataspace/asserted [[:count :i64] [:notices :document]]]] [:retracted [:record :kotoba.dataspace/retracted [[:count :i64]]]] [:matches [:record :kotoba.dataspace/matches [[:bindings :document] [:notices :document]]]] [:facet [:record :kotoba.dataspace/facet [[:id :i64]]]] [:error [:record :kotoba.dataspace/error [[:code :keyword] [:message :string]]]]]]")))
   :default nil)

;; the facet argument: the second operand, 0 when it is absent or nil/false (`(or (second args) 0)`)
#?(:kotoba
   (defn facet-or-zero [form [:ref :form/r]] [:ref :form/r]
     (if (and (>= (argc form) 2)
              (not (form/is-nil? (arg form 1)))
              (not (and (form/is-bool? (arg form 1)) (not (form/bool-value (arg form 1))))))
       (arg form 1)
       (form/int-form 0)))
   :default nil)

;; [tag payload-type payload] of the coordination form NAME
#?(:kotoba
   (defn dataspace-payload [name :string form [:ref :form/r]] [:ref :form/r]
     (let [nargs (argc form)]
       (cond
         (string=? name "assert!")
         (let [_ (require-k (and (<= 1 nargs) (<= nargs 2)) "assert! requires an assertion document and an optional facet" "kotoba.error/subset-reject" form)]
           (form/vec3 (form/keyword-form :assert) (dataspace-types-k "assert")
                      (form/call3 "record-new" (dataspace-types-k "assert") (arg form 0) (facet-or-zero form))))
         (string=? name "retract!")
         (let [_ (require-k (and (<= 1 nargs) (<= nargs 2)) "retract! requires an assertion document and an optional facet" "kotoba.error/subset-reject" form)]
           (form/vec3 (form/keyword-form :retract) (dataspace-types-k "retract")
                      (form/call3 "record-new" (dataspace-types-k "retract") (arg form 0) (facet-or-zero form))))
         (string=? name "observe!")
         (let [_ (require-k (and (<= 1 nargs) (<= nargs 2)) "observe! requires a pattern document and an optional facet" "kotoba.error/subset-reject" form)]
           (form/vec3 (form/keyword-form :observe) (dataspace-types-k "observe")
                      (form/call3 "record-new" (dataspace-types-k "observe") (arg form 0) (facet-or-zero form))))
         (string=? name "facet-enter!")
         (let [_ (require-k (= 0 nargs) "facet-enter! takes no arguments" "kotoba.error/subset-reject" form)]
           (form/vec3 (form/keyword-form :facet-enter) (form/keyword-form :bool) (form/bool-form true)))
         :else
         (let [_ (require-k (= 1 nargs) "facet-leave! requires one facet identifier" "kotoba.error/subset-reject" form)]
           (form/vec3 (form/keyword-form :facet-leave) (form/keyword-form :i64) (arg form 0))))))
   :default nil)

#?(:kotoba
   (defn desugar-dataspace-form-k [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [p (dataspace-payload (form/symbol-value op) form)
           tag (form/nth-of p 0)
           payload (form/nth-of p 2)
           request (form/call3 "variant-new" (dataspace-types-k "request") tag payload)
           kw (form/keyword-form :dataspace/transact)
           id (capability-id env kw form)
           env1 (note-used-capability env kw)
           r (desugar-expected-value env1 (dataspace-types-k "request") request)]
       (dr (dr-env r)
           (head-call (form/symbol-form "typed-cap-call")
                      (form/cons-onto id (form/three-forms (dataspace-types-k "request") (dataspace-types-k "result") (dr-form r)))))))
   :default nil)

;; (cap-call :cap/name args...) with a keyword name: the wire id replaces the keyword
#?(:kotoba
   (defn desugar-cap-call [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (if (and (> (argc form) 0) (form/is-keyword? (arg form 0)))
       (let [kw (arg form 0)
             id (capability-id env kw form)
             env1 (note-used-capability env kw)
             rest-args (desugar-each env1 form 2 (form/no-forms))]
         (dr (drs-env rest-args) (head-call (form/symbol-form "cap-call") (form/cons-onto id (drs-forms rest-args)))))
       (desugar-ordinary-call-heads env op form)))
   :default nil)

;; the head kept, every operand desugared (the host's `(apply list op (map desugar-expr args))`)
#?(:kotoba
   (defn desugar-ordinary-call-heads [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [r (desugar-each env form 1 (form/no-forms))]
       (dr (drs-env r) (head-call op (drs-forms r)))))
   :default nil)

;; the operand I of the form, nil-form past the end
#?(:kotoba
   (defn arg-or-nil [form [:ref :form/r] i :i64] [:ref :form/r]
     (if (< i (argc form)) (arg form i) (form/nil-form)))
   :default nil)

;; (typed-cap-call :cap/name request-type result-type request & extra); a numeric id with exactly four operands keeps its id
#?(:kotoba
   (defn desugar-typed-cap-call [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (cond
       (and (> (argc form) 0) (form/is-keyword? (arg form 0)))
       (let [kw (arg form 0)
             id (capability-id env kw form)
             env1 (note-used-capability env kw)
             req (if (<= 4 (argc form))
                   (desugar-expected-value env1 (arg-or-nil form 1) (arg-or-nil form 3))
                   (dr env1 (form/nil-form)))
             extra (desugar-each (dr-env req) form 5 (form/no-forms))]
         (dr (drs-env extra)
             (head-call (form/symbol-form "typed-cap-call")
                        (form/cons-onto id (form/cons-onto (arg-or-nil form 1) (form/cons-onto (arg-or-nil form 2) (form/cons-onto (dr-form req) (drs-forms extra))))))))
       (and (= 4 (argc form)) (form/is-int? (arg form 0)))
       (let [req (desugar-expected-value env (arg form 1) (arg form 3))]
         (dr (dr-env req) (form/call4 "typed-cap-call" (arg form 0) (arg form 1) (arg form 2) (dr-form req))))
       :else (desugar-ordinary-call-heads env op form)))
   :default nil)

;; (eval request): the catalogued code/eval ability with one :document request
#?(:kotoba
   (defn desugar-eval [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (if (tables/table-has? (env-arities env) op)
       (desugar-ordinary-call-heads env op form)
       (let [_ (require-k (= 1 (argc form)) "typed eval requires exactly one :document request" "kotoba.error/subset-reject" form)]
         (desugar-named-op env (form/symbol-form "code/eval") (form/call1 "code/eval" (arg form 0))))))
   :default nil)

;; ---- lazy-map / lazy-filter on the Kotoba route: a synthesized recursive helper whose body is a lifted thunk ----
;; The arities a callback provides: a module function's, or the union over the clauses of a literal fn (a variadic clause is not ported).
#?(:kotoba
   (defn params-arity-set [ps [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
     (if (has-amp? ps 0)
       (add-arity-range acc (amp-index ps 0))
       (set-add acc (form/int-form (form/count-of ps)))))
   :default nil)

#?(:kotoba
   (defn clause-arity-set [fn-form [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
     ;; the clauses are the forms of FN-FORM from I; each is ([params] ...) and provides its arity (a variadic one: from its fixed count to four)
     (if (>= i (form/count-of fn-form))
       acc
       (clause-arity-set fn-form (+ i 1) (params-arity-set (form/nth-of (form/nth-of fn-form i) 0) acc))))
   :default nil)

#?(:kotoba
   (defn all-clause-shaped? [fn-form [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of fn-form))
       true
       (let [c (form/nth-of fn-form i)]
         (and (form/is-seq? c) (> (form/count-of c) 0) (form/is-vec? (form/nth-of c 0)) (all-clause-shaped? fn-form (+ i 1))))))
   :default nil)

;; the set of arities the callback provides, nil-form when it is not a module function or a literal fn
#?(:kotoba
   (defn callback-supported-arities-k [env [:ref :fe/env] callback [:ref :form/r]] [:ref :form/r]
     (cond
       (top-level-function-symbol? env callback) (tables/table-get (env-arities env) callback)
       (head-is? callback "fn")
       (let [pc (if (> (form/count-of callback) 1) (form/nth-of callback 1) (form/nil-form))]
         (cond
           (form/is-vec? pc) (callback-single-arity pc)
           (all-clause-shaped? callback 1) (clause-arity-set callback 1 (form/form-set (form/no-forms)))
           :else (form/nil-form)))
       :else (form/nil-form)))
   :default nil)

#?(:kotoba
   (defn callback-single-arity [params [:ref :form/r]] [:ref :form/r]
     (params-arity-set params (form/form-set (form/no-forms))))
   :default nil)

;; the callback as a closure value: the arity is checked against what it provides, a module function goes through fn-ref
#?(:kotoba
   (defn callback-closure-k [env [:ref :fe/env] kind :string callback [:ref :form/r] arity :i64] [:ref :fe/dr]
     (let [arities (callback-supported-arities-k env callback)
           _ (require-k (or (form/is-nil? arities) (tables/table-has? arities (form/int-form arity)))
                        (string-concat kind (string-concat " callback does not provide arity " (string-from-i64 arity)))
                        "kotoba.error/subset-reject" callback)]
       (if (top-level-function-symbol? env callback)
         (desugar-expr env (form/call1 "fn-ref" callback))
         (desugar-expr env callback))))
   :default nil)

;; helper-name ++ suffix as a symbol
#?(:kotoba
   (defn suffixed [helper [:ref :form/r] suffix :string] [:ref :form/r]
     (form/symbol-form (string-concat (form/symbol-value helper) suffix)))
   :default nil)

#?(:kotoba
   (defn lazy-coll-params [helper [:ref :form/r] i :i64 n :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i n)
       acc
       (lazy-coll-params helper (+ i 1) n (form/append-form acc (suffixed helper (string-concat "_coll_" (string-from-i64 i)))))))
   :default nil)

;; (f p0) (f p1) ... for the parameters PS
#?(:kotoba
   (defn map-calls [f :string ps [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count ps))
       acc
       (map-calls f ps (+ i 1) (form/append-form acc (form/call1 f (typed-list-nth [:list [:ref :form/r]] ps i))))))
   :default nil)

#?(:kotoba
   (defn lifted-with-lazy [env [:ref :fe/env] fn-form [:ref :form/r]] [:ref :fe/dr]
     (let [saved (env-lazy? env)
           r (lift-lambda-k (with-lazy env true) fn-form)]
       (dr (with-lazy (dr-env r) saved) (dr-form r))))
   :default nil)

;; the helper definition map of the lazy synthesizers: no :loop-helper? key
#?(:kotoba
   (defn loop-helper-plain [helper [:ref :form/r] params [:ref :form/r] body [:ref :form/r]] [:ref :form/r]
     (form/assoc-form
      (form/assoc-form
       (form/assoc-form
        (form/assoc-form
         (form/assoc-form (form/form-map (form/no-forms)) (form/keyword-form :name) helper)
         (form/keyword-form :params) params)
        (form/keyword-form :result) (form/keyword-form :i64))
       (form/keyword-form :effects) (form/form-set (form/no-forms)))
      (form/keyword-form :body) body))
   :default nil)

;; the thunk that yields the next cell of a lazy-map: empty when any source is
#?(:kotoba
   (defn lazy-map-resolver [helper [:ref :form/r] cb [:ref :form/r] cps [:list [:ref :form/r]]] [:ref :form/r]
     (form/call2 "fn" (form/form-vec (form/no-forms))
                 (form/call3 "if" (head-call (form/symbol-form "or") (map-calls "lazy-empty?" cps 0 (form/no-forms)))
                             (form/int-form 0)
                             (form/call2 "pair"
                                         (form/call2 "fn" (form/form-vec (form/no-forms))
                                                     (head-call (form/symbol-form "invoke") (form/cons-onto cb (map-calls "lazy-first" cps 0 (form/no-forms)))))
                                         (form/call2 "fn" (form/form-vec (form/no-forms))
                                                     (head-call helper (form/cons-onto cb (map-calls "lazy-rest" cps 0 (form/no-forms)))))))))
   :default nil)

#?(:kotoba
   (defn desugar-lazy-map [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (and (<= 2 (argc form)) (<= (argc form) 5)) "lazy-map requires a callback and one to four lazy sequences"
                        "kotoba.error/subset-reject" form)
           env0 (with-uses-lazy env)
           callback (arg form 0)
           arity (- (argc form) 1)
           hs (synthetic env0 "lazy_map")
           helper (dr-form hs)
           cb (suffixed helper "_callback")
           cps (lazy-coll-params helper 0 arity (form/no-forms))
           cv (callback-closure-k (dr-env hs) "lazy-map" callback arity)
           resolver (lifted-with-lazy (dr-env cv) (lazy-map-resolver helper cb cps))
           _ (require-k (<= (+ arity 1) 64) "lazy-map callback plus sources exceed ABI-supported arity" "kotoba.error/subset-reject" form)
           env1 (with-helper (dr-env resolver) (loop-helper-plain helper (form/form-vec (form/cons-onto cb cps)) (dr-form resolver)))
           cols (desugar-each env1 form 2 (form/no-forms))]
       (dr (drs-env cols) (head-call helper (form/cons-onto (dr-form cv) (drs-forms cols))))))
   :default nil)

#?(:kotoba
   (defn lazy-filter-resolver [helper [:ref :form/r] cb [:ref :form/r] coll [:ref :form/r] value [:ref :form/r] cursor [:ref :form/r]] [:ref :form/r]
     (form/call2 "fn" (form/form-vec (form/no-forms))
                 (form/call2 "loop" (form/vec2 cursor coll)
                             (form/call3 "if" (form/call1 "lazy-empty?" cursor)
                                         (form/int-form 0)
                                         (form/call2 "let" (form/vec2 value (form/call1 "lazy-first" cursor))
                                                     (form/call3 "if" (form/call3 "invoke" (form/keyword-form :bool) cb value)
                                                                 (form/call2 "pair"
                                                                             (form/call2 "fn" (form/form-vec (form/no-forms)) value)
                                                                             (form/call2 "fn" (form/form-vec (form/no-forms))
                                                                                         (form/call2 (form/symbol-value helper) cb (form/call1 "lazy-rest" cursor))))
                                                                 (form/call1 "recur" (form/call1 "lazy-rest" cursor))))))))
   :default nil)

#?(:kotoba
   (defn desugar-lazy-filter [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 2 (argc form)) "lazy-filter requires a unary predicate and lazy sequence" "kotoba.error/subset-reject" form)
           env0 (with-uses-lazy env)
           hs (synthetic env0 "lazy_filter")
           helper (dr-form hs)
           cb (suffixed helper "_callback")
           coll (suffixed helper "_coll")
           value (suffixed helper "_value")
           cursor (suffixed helper "_cursor")
           cv (callback-closure-k (dr-env hs) "lazy-filter" (arg form 0) 1)
           resolver (lifted-with-lazy (dr-env cv) (lazy-filter-resolver helper cb coll value cursor))
           env1 (with-helper (dr-env resolver) (loop-helper-plain helper (form/vec2 cb coll) (dr-form resolver)))
           c (desugar-expr env1 (arg form 1))]
       (dr (dr-env c) (form/call2 (form/symbol-value helper) (dr-form cv) (dr-form c)))))
   :default nil)

;; ---- closed document literals on the Kotoba route (the `document` head and any literal in a :document context) ----
;; `contextual-document-literal?`: syntax that is unambiguously a closed document value (a call form and a simple symbol are not).
#?(:kotoba
   (defn contextual-document-literal-k? [f [:ref :form/r]] :bool
     (cond
       (or (form/is-nil? f) (form/is-bool? f) (form/is-int? f) (form/is-f64? f) (form/is-string? f) (form/is-keyword? f)) true
       (form/is-symbol? f) (not (simple-symbol-form? f))
       (or (form/is-vec? f) (form/is-set? f) (form/is-map? f)) (all-contextual-document? f 0)
       :else false))
   :default nil)

#?(:kotoba
   (defn all-contextual-document? [f [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of f))
       true
       (and (contextual-document-literal-k? (form/nth-of f i)) (all-contextual-document? f (+ i 1)))))
   :default nil)

;; ---- the sort key (stable, host-independent) used to order set members and map entries ----
#?(:kotoba
   (defn doc-frame [text :string] :string
     (string-concat (string-from-i64 (string-byte-length text)) (string-concat ":" text)))
   :default nil)

#?(:kotoba
   (defn doc-sort-key [f [:ref :form/r]] :string
     (cond
       (form/is-nil? f) "00:nil"
       (form/is-bool? f) (if (form/bool-value f) "01:true" "01:false")
       (form/is-int? f) (string-concat "02:" (string-from-i64 (form/int-value f)))
       (form/is-f64? f) (string-concat "03:" (string-from-i64 (form/bits-of f)))
       (form/is-string? f) (string-concat "04:" (form/string-value f))
       (form/is-keyword? f) (string-concat "05:" (kw-text f))
       (form/is-symbol? f) (string-concat "06:" (form/symbol-value f))
       (form/is-vec? f) (string-concat "07:[" (string-concat (doc-key-frames f 0 "") "]"))
       (form/is-set? f) (string-concat "08:{" (string-concat (doc-join-frames (doc-sorted-strings (doc-child-keys f 0 (form/no-forms)) 0 (form/no-forms)) 0 "") "}"))
       (form/is-map? f) (string-concat "09:{" (string-concat (doc-join-strings (doc-sorted-strings (doc-entry-keys f 0 (form/no-forms)) 0 (form/no-forms)) 0 "") "}"))
       (form/is-seq? f) (string-concat "10:(" (string-concat (doc-key-frames f 0 "") ")"))
       :else "99:?"))
   :default nil)

#?(:kotoba
   (defn doc-key-frames [f [:ref :form/r] i :i64 acc :string] :string
     (if (>= i (form/count-of f))
       acc
       (doc-key-frames f (+ i 1) (string-concat acc (doc-frame (doc-sort-key (form/nth-of f i)))))))
   :default nil)

;; the sort keys of the members of a set, as string forms
#?(:kotoba
   (defn doc-child-keys [f [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of f))
       acc
       (doc-child-keys f (+ i 1) (form/append-form acc (form/string-form (doc-sort-key (form/nth-of f i)))))))
   :default nil)

;; the entry strings of a map: frame(key) frame(value)
#?(:kotoba
   (defn doc-entry-keys [f [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= (+ i 1) (form/count-of f))
       acc
       (doc-entry-keys f (+ i 2)
                       (form/append-form acc (form/string-form (string-concat (doc-frame (doc-sort-key (form/nth-of f i)))
                                                                              (doc-frame (doc-sort-key (form/nth-of f (+ i 1))))))))))
   :default nil)

#?(:kotoba
   (defn doc-string-position [sorted [:list [:ref :form/r]] s :string i :i64] :i64
     (if (>= i (vector-count sorted))
       i
       (if (> (string-compare (form/string-value (typed-list-nth [:list [:ref :form/r]] sorted i)) s) 0)
         i
         (doc-string-position sorted s (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn doc-sorted-strings [xs [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count xs))
       acc
       (let [x (typed-list-nth [:list [:ref :form/r]] xs i)
             p (doc-string-position acc (form/string-value x) 0)]
         (doc-sorted-strings xs (+ i 1) (slice-forms acc p (vector-count acc) (form/append-form (slice-forms acc 0 p (form/no-forms)) x))))))
   :default nil)

#?(:kotoba
   (defn doc-join-frames [xs [:list [:ref :form/r]] i :i64 acc :string] :string
     (if (>= i (vector-count xs))
       acc
       (doc-join-frames xs (+ i 1) (string-concat acc (doc-frame (form/string-value (typed-list-nth [:list [:ref :form/r]] xs i)))))))
   :default nil)

#?(:kotoba
   (defn doc-join-strings [xs [:list [:ref :form/r]] i :i64 acc :string] :string
     (if (>= i (vector-count xs))
       acc
       (doc-join-strings xs (+ i 1) (string-concat acc (form/string-value (typed-list-nth [:list [:ref :form/r]] xs i))))))
   :default nil)

;; ---- the elaboration: every node becomes a document constructor call; nodes and depth are bounded ----
#?(:kotoba
   (defn doc-charge [f [:ref :form/r] depth :i64 nodes :i64] :i64
     (let [_ (require-k (<= depth 8) "document literal exceeds depth limit" "kotoba.error/subset-reject" f)
           n (+ nodes 1)
           _ (require-k (<= n 4096) "document literal exceeds node limit" "kotoba.error/subset-reject" f)]
       n))
   :default nil)

;; the members of a vector/set/list (or the sorted members of a set) walked in order: [elaborated-list nodes]
#?(:kotoba
   (defn doc-walk-members [members [:list [:ref :form/r]] i :i64 depth :i64 nodes :i64 acc [:list [:ref :form/r]]] [:ref :form/r]
     (if (>= i (vector-count members))
       (form/vec2 (form/form-vec acc) (form/int-form nodes))
       (let [w (doc-walk (typed-list-nth [:list [:ref :form/r]] members i) depth nodes)]
         (doc-walk-members members (+ i 1) depth (form/int-value (form/nth-of w 1)) (form/append-form acc (form/nth-of w 0))))))
   :default nil)

;; the set's members ordered by their sort key (stable)
#?(:kotoba
   (defn doc-key-position [sorted [:list [:ref :form/r]] key :string i :i64] :i64
     (if (>= i (vector-count sorted))
       i
       (if (> (string-compare (doc-sort-key (typed-list-nth [:list [:ref :form/r]] sorted i)) key) 0)
         i
         (doc-key-position sorted key (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn doc-sorted-members [f [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of f))
       acc
       (let [m (form/nth-of f i)
             p (doc-key-position acc (doc-sort-key m) 0)]
         (doc-sorted-members f (+ i 1) (slice-forms acc p (vector-count acc) (form/append-form (slice-forms acc 0 p (form/no-forms)) m))))))
   :default nil)

#?(:kotoba
   (defn doc-members-of [f [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of f))
       acc
       (doc-members-of f (+ i 1) (form/append-form acc (form/nth-of f i)))))
   :default nil)

;; the map's entries as [key value] vectors ordered by the key's sort key (stable)
#?(:kotoba
   (defn doc-entry-position [sorted [:list [:ref :form/r]] key :string i :i64] :i64
     (if (>= i (vector-count sorted))
       i
       (if (> (string-compare (doc-sort-key (form/nth-of (typed-list-nth [:list [:ref :form/r]] sorted i) 0)) key) 0)
         i
         (doc-entry-position sorted key (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn doc-sorted-entries [f [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= (+ i 1) (form/count-of f))
       acc
       (let [e (form/vec2 (form/nth-of f i) (form/nth-of f (+ i 1)))
             p (doc-entry-position acc (doc-sort-key (form/nth-of f i)) 0)]
         (doc-sorted-entries f (+ i 2) (slice-forms acc p (vector-count acc) (form/append-form (slice-forms acc 0 p (form/no-forms)) e))))))
   :default nil)

;; a map key: a keyword stays as written, anything else is walked
#?(:kotoba
   (defn doc-walk-key [k [:ref :form/r] depth :i64 nodes :i64] [:ref :form/r]
     (if (form/is-keyword? k)
       (form/vec2 k (form/int-form nodes))
       (doc-walk k depth nodes)))
   :default nil)

;; the elaborated key/value pairs of a map's entries, flat: [elaborated-kids nodes]
#?(:kotoba
   (defn doc-walk-entries [entries [:list [:ref :form/r]] i :i64 depth :i64 nodes :i64 acc [:list [:ref :form/r]]] [:ref :form/r]
     (if (>= i (vector-count entries))
       (form/vec2 (form/form-vec acc) (form/int-form nodes))
       (let [e (typed-list-nth [:list [:ref :form/r]] entries i)
             k (form/nth-of e 0)
             kw (doc-walk-key k depth nodes)
             vw (doc-walk (form/nth-of e 1) depth (form/int-value (form/nth-of kw 1)))]
         (doc-walk-entries entries (+ i 1) depth (form/int-value (form/nth-of vw 1))
                           (form/append-form (form/append-form acc (form/nth-of kw 0)) (form/nth-of vw 0))))))
   :default nil)

;; the walk: [elaborated nodes]
#?(:kotoba
   (defn doc-walk [f [:ref :form/r] depth :i64 nodes :i64] [:ref :form/r]
     (let [n (doc-charge f depth nodes)]
       (cond
         (form/is-nil? f) (form/vec2 (form/call0 "document-null") (form/int-form n))
         (form/is-bool? f) (form/vec2 (form/call1 "document-bool" f) (form/int-form n))
         (form/is-int? f) (form/vec2 (form/call1 "document-i64" f) (form/int-form n))
         ;; the host reader's closed f64 shape `(f64-from-bits <bits>)` (desugar-f64-literal), not the bare f64 Form
         ;; validate has no rule for (agent F64, 2026-10-04: general-document-map was refused "value type is outside the safe profile")
         (form/is-f64? f) (form/vec2 (form/call1 "document-f64" (form/call1 "f64-from-bits" (form/int-form (form/bits-of f)))) (form/int-form n))
         (form/is-string? f) (form/vec2 (form/call1 "document-string" f) (form/int-form n))
         (form/is-keyword? f) (form/vec2 (form/call1 "document-keyword" f) (form/int-form n))
         (form/is-symbol? f) (form/vec2 (form/call1 "document-symbol" (form/call1 "symbol" (form/string-form (form/symbol-value f)))) (form/int-form n))
         (form/is-vec? f) (doc-walk-container f depth n "document-vector" "document vector literal exceeds item limit")
         (form/is-set? f) (doc-walk-container f depth n "document-set" "document set literal exceeds item limit")
         (form/is-map? f) (doc-walk-map f depth n)
         (form/is-seq? f) (doc-walk-container f depth n "document-list" "document list literal exceeds item limit")
         :else (throw (fe-reject "document requires a closed EDN literal tree" "kotoba.error/subset-reject" f)))))
   :default nil)

#?(:kotoba
   (defn doc-walk-container [f [:ref :form/r] depth :i64 nodes :i64 head :string msg :string] [:ref :form/r]
     (let [_ (require-k (<= (form/count-of f) 32) msg "kotoba.error/subset-reject" f)
           members (if (form/is-set? f) (doc-sorted-members f 0 (form/no-forms)) (doc-members-of f 0 (form/no-forms)))
           w (doc-walk-members members 0 (+ depth 1) nodes (form/no-forms))]
       (form/vec2 (head-call (form/symbol-form head) (form/kids-of (form/nth-of w 0))) (form/nth-of w 1))))
   :default nil)

#?(:kotoba
   (defn doc-walk-map [f [:ref :form/r] depth :i64 nodes :i64] [:ref :form/r]
     (let [_ (require-k (<= (quot (form/count-of f) 2) 32) "document map literal exceeds entry limit" "kotoba.error/subset-reject" f)
           w (doc-walk-entries (doc-sorted-entries f 0 (form/no-forms)) 0 (+ depth 1) nodes (form/no-forms))]
       (form/vec2 (head-call (form/symbol-form "document-map") (form/kids-of (form/nth-of w 0))) (form/nth-of w 1))))
   :default nil)

#?(:kotoba
   (defn elaborate-document-literal-k [f [:ref :form/r]] [:ref :form/r]
     (form/nth-of (doc-walk f 0 0) 0))
   :default nil)

;; (document literal)
#?(:kotoba
   (defn desugar-document-head [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 1 (argc form)) "document requires exactly one closed literal tree" "kotoba.error/subset-reject" form)
           e (elaborate-document-literal-k (arg form 0))]
       (dr env e)))
   :default nil)

;; a literal in a :document context
#?(:kotoba
   (defn desugar-document-literal [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [e (elaborate-document-literal-k form)]
       (dr env e)))
   :default nil)

;; ---- map, set and f64 literals on the Kotoba route (selfhost S3) ----
;; A bounded map literal lowers to a legacy pair map (`map-new`, keyword keys with i64-spelled values), a closed anonymous record
;; (keyword keys with a value that spells another type), a typed map (`typed-map-new`, integer or string keys), or the record named by
;; the context. Entries are emitted in the key type's total order. Type descriptors are Form trees; a "type or nothing" answer is the
;; nil-form.
#?(:kotoba
   (defn mlit-key-kind [k [:ref :form/r]] :string
     (cond
       (form/is-keyword? k) "keyword"
       (form/is-int? k) "i64"
       (form/is-string? k) "string"
       :else ""))
   :default nil)

;; how many keys of the map literal M have the kind KIND
#?(:kotoba
   (defn mlit-count-kind [m [:ref :form/r] kind :string i :i64 n :i64] :i64
     (if (>= i (form/count-of m))
       n
       (mlit-count-kind m kind (+ i 2) (if (string=? (mlit-key-kind (form/nth-of m i)) kind) (+ n 1) n))))
   :default nil)

;; the first key (in source order) that has no admitted kind, nil-form when there is none
#?(:kotoba
   (defn mlit-first-offender [m [:ref :form/r] i :i64] [:ref :form/r]
     (cond
       (>= i (form/count-of m)) (form/nil-form)
       (string=? (mlit-key-kind (form/nth-of m i)) "") (form/nth-of m i)
       :else (mlit-first-offender m (+ i 2))))
   :default nil)

#?(:kotoba
   (defn mlit-key-description [k [:ref :form/r]] :string
     (cond
       (form/is-f64? k) "floating point"
       (form/is-bool? k) "boolean"
       (form/is-seq? k) "expression"
       (form/is-symbol? k) "symbol"
       (form/is-vec? k) "vector"
       (form/is-map? k) "map"
       (form/is-set? k) "set"
       (form/is-nil? k) "nil"
       :else "unrecognized"))
   :default nil)

#?(:kotoba
   (defn mlit-key-text [k [:ref :form/r]] :string
     (if (form/is-int? k) (string-from-i64 (form/int-value k)) (pr-form k)))
   :default nil)

;; the order of two keys of one kind: -1, 0, 1
#?(:kotoba
   (defn mlit-key-compare [kind :string a [:ref :form/r] b [:ref :form/r]] :i64
     (cond
       (string=? kind "i64") (cond (< (form/int-value a) (form/int-value b)) -1 (> (form/int-value a) (form/int-value b)) 1 :else 0)
       (string=? kind "string") (string-compare (form/string-value a) (form/string-value b))
       :else (string-compare (kw-text a) (kw-text b))))
   :default nil)

#?(:kotoba
   (defn mlit-entry-position [sorted [:list [:ref :form/r]] kind :string k [:ref :form/r] i :i64] :i64
     (if (>= i (vector-count sorted))
       i
       (if (> (mlit-key-compare kind (form/nth-of (typed-list-nth [:list [:ref :form/r]] sorted i) 0) k) 0)
         i
         (mlit-entry-position sorted kind k (+ i 1)))))
   :default nil)

;; the entries of M as [key value] vectors in the total order of KIND
#?(:kotoba
   (defn mlit-sorted-entries [m [:ref :form/r] kind :string i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= (+ i 1) (form/count-of m))
       acc
       (let [e (form/vec2 (form/nth-of m i) (form/nth-of m (+ i 1)))
             p (mlit-entry-position acc kind (form/nth-of m i) 0)]
         (mlit-sorted-entries m kind (+ i 2)
                              (slice-forms acc p (vector-count acc) (form/append-form (slice-forms acc 0 p (form/no-forms)) e))))))
   :default nil)

;; the value type a literal value determines on its own (nil-form for an expression only inference can type)
#?(:kotoba
   (defn mlit-value-type [env [:ref :fe/env] v [:ref :form/r]] [:ref :form/r]
     (cond
       (form/is-bool? v) (form/keyword-form :bool)
       (form/is-int? v) (form/keyword-form :i64)
       (form/is-string? v) (form/keyword-form :string)
       (form/is-keyword? v) (form/keyword-form :keyword)
       (form/is-f64? v) (form/keyword-form :f64)
       (form/is-seq? v) (mlit-seq-type v)
       :else (form/nil-form)))
   :default nil)

#?(:kotoba
   (defn mlit-seq-type [v [:ref :form/r]] [:ref :form/r]
     (if (= 0 (form/count-of v))
       (form/nil-form)
       (let [head (form/nth-of v 0)]
         (cond
           (sym-is? head "f64-from-bits") (form/keyword-form :f64)
           (sym-is? head "f32-from-bits") (form/keyword-form :f32)
           :else
           (let [declared (tables/table-get (tables/map-literal-value-constructors) head)
                 descriptor (if (> (form/count-of v) 1) (form/nth-of v 1) (form/nil-form))]
             (if (and (not (form/is-nil? declared)) (form/is-vec? descriptor) (> (form/count-of descriptor) 0)
                      (form/eq declared (form/nth-of descriptor 0)))
               descriptor
               (form/nil-form)))))))
   :default nil)

;; the [key type] pairs of the entries whose value spells a type
#?(:kotoba
   (defn mlit-typed-entries [env [:ref :fe/env] entries [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count entries))
       acc
       (let [e (typed-list-nth [:list [:ref :form/r]] entries i)
             t (mlit-value-type env (form/nth-of e 1))]
         (mlit-typed-entries env entries (+ i 1)
                             (if (form/is-nil? t) acc (form/append-form acc (form/vec2 (form/nth-of e 0) t)))))))
   :default nil)

;; the first typed entry whose type is a float, nil-form when there is none
#?(:kotoba
   (defn mlit-first-floating [typed [:list [:ref :form/r]] i :i64] [:ref :form/r]
     (if (>= i (vector-count typed))
       (form/nil-form)
       (let [e (typed-list-nth [:list [:ref :form/r]] typed i)
             t (form/nth-of e 1)]
         (if (or (form/eq t (form/keyword-form :f32)) (form/eq t (form/keyword-form :f64)))
           e
           (mlit-first-floating typed (+ i 1))))))
   :default nil)

;; the first typed entry after I whose type differs from T
#?(:kotoba
   (defn mlit-first-other [typed [:list [:ref :form/r]] t [:ref :form/r] i :i64] [:ref :form/r]
     (if (>= i (vector-count typed))
       (form/nil-form)
       (let [e (typed-list-nth [:list [:ref :form/r]] typed i)]
         (if (form/eq (form/nth-of e 1) t)
           (mlit-first-other typed t (+ i 1))
           e))))
   :default nil)

#?(:kotoba
   (defn mlit-floating-refusal [floating [:ref :form/r] form [:ref :form/r]] :i64
     (if (form/is-nil? floating)
       0
       (throw (fe-reject
               (string-concat "map literal value at key "
                 (string-concat (mlit-key-text (form/nth-of floating 0))
                   (string-concat " is a floating point literal: map value type "
                     (string-concat (kw-text (form/nth-of floating 1))
                       " is outside the structured scalar ABI. This is the ABI's refusal and not the floating-key one -- a value needs neither a total order nor a decidable identity, and is refused because the typed map's value slot has no floating encoding"))))
               "kotoba.error/floating-map-kv" form))))
   :default nil)

#?(:kotoba
   (defn mlit-disagree-refusal [first-e [:ref :form/r] other [:ref :form/r] form [:ref :form/r]] :i64
     (if (form/is-nil? other)
       0
       (throw (fe-reject
               (string-concat "map literal values must all be one type; the value at key "
                 (string-concat (mlit-key-text (form/nth-of first-e 0))
                   (string-concat " is "
                     (string-concat (pr-form (form/nth-of first-e 1))
                       (string-concat " and the value at key "
                         (string-concat (mlit-key-text (form/nth-of other 0))
                           (string-concat " is " (pr-form (form/nth-of other 1)))))))))
               "kotoba.error/map-literal-value" form))))
   :default nil)

;; the value type of a typed map literal read off its own value expressions (refusing floats and disagreeing types by name)
#?(:kotoba
   (defn mlit-item-type [env [:ref :fe/env] entries [:list [:ref :form/r]] form [:ref :form/r]] [:ref :form/r]
     (let [typed (mlit-typed-entries env entries 0 (form/no-forms))
           _ (mlit-floating-refusal (mlit-first-floating typed 0) form)]
       (mlit-item-type-agree typed form)))
   :default nil)

#?(:kotoba
   (defn mlit-item-type-agree [typed [:list [:ref :form/r]] form [:ref :form/r]] [:ref :form/r]
     (if (= 0 (vector-count typed))
       (form/keyword-form :i64)
       (let [first-e (typed-list-nth [:list [:ref :form/r]] typed 0)
             other (mlit-first-other typed (form/nth-of first-e 1) 1)
             _ (mlit-disagree-refusal first-e other form)]
         (form/nth-of first-e 1))))
   :default nil)

;; the field type one value of a keyword-keyed literal determines on its own (a nested literal through its own lowered type)
#?(:kotoba
   (defn mlit-record-field-type [env [:ref :fe/env] v [:ref :form/r]] [:ref :form/r]
     (cond
       (form/is-map? v) (mlit-lowered-type env v)
       (form/is-vec? v) (closed-vector-literal-type v)
       :else (mlit-value-type env v)))
   :default nil)

;; [key (or type nil)] for every entry
#?(:kotoba
   (defn mlit-field-types [env [:ref :fe/env] entries [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count entries))
       acc
       (let [e (typed-list-nth [:list [:ref :form/r]] entries i)
             t (mlit-record-field-type env (form/nth-of e 1))]
         (mlit-field-types env entries (+ i 1) (form/append-form acc (form/vec2 (form/nth-of e 0) t))))))
   :default nil)

;; the first entry whose value is the literal nil, nil-form when there is none
#?(:kotoba
   (defn mlit-first-nil-entry [entries [:list [:ref :form/r]] i :i64] [:ref :form/r]
     (if (>= i (vector-count entries))
       (form/nil-form)
       (let [e (typed-list-nth [:list [:ref :form/r]] entries i)]
         (if (form/is-nil? (form/nth-of e 1))
           e
           (mlit-first-nil-entry entries (+ i 1))))))
   :default nil)

#?(:kotoba
   (defn mlit-nil-refusal [e [:ref :form/r] form [:ref :form/r]] :i64
     (if (form/is-nil? e)
       0
       (throw (fe-reject
               (string-concat "map literal value at key "
                 (string-concat (mlit-key-text (form/nth-of e 0))
                   " is nil, which makes the field an absent [:option T], and nothing here says T: give the literal a record type from context (a declared record result, or a record field) or write (option-none-of [:option T])"))
               "kotoba.error/map-literal-value" form))))
   :default nil)

;; does any typed field spell something other than :i64
#?(:kotoba
   (defn mlit-any-non-i64? [typed [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count typed))
       false
       (let [t (form/nth-of (typed-list-nth [:list [:ref :form/r]] typed i) 1)]
         (or (and (not (form/is-nil? t)) (not (form/eq t (form/keyword-form :i64))))
             (mlit-any-non-i64? typed (+ i 1))))))
   :default nil)

;; the fields [key type] with the unspelled ones as :i64
#?(:kotoba
   (defn mlit-defaulted-fields [typed [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count typed))
       acc
       (let [e (typed-list-nth [:list [:ref :form/r]] typed i)
             t (form/nth-of e 1)]
         (mlit-defaulted-fields typed (+ i 1)
                                (form/append-form acc (form/vec2 (form/nth-of e 0) (if (form/is-nil? t) (form/keyword-form :i64) t)))))))
   :default nil)

#?(:kotoba
   (defn mlit-record-limit-refusal [n :i64 form [:ref :form/r]] :i64
     (if (<= n 32)
       0
       (throw (fe-reject
               (string-concat "map literal with keyword keys and a non-i64 value lowers to a closed record and exceeds the record field limit: "
                 (string-concat (string-from-i64 n) (string-concat " entries, at most " (string-from-i64 32))))
               "kotoba.error/map-literal-value" form))))
   :default nil)

;; the fields of the closed record a keyword-keyed literal lowers to, nil-form when it stays the legacy pair map
#?(:kotoba
   (defn mlit-keyword-fields [env [:ref :fe/env] form [:ref :form/r] entries [:list [:ref :form/r]]] [:ref :form/r]
     (let [typed (mlit-field-types env entries 0 (form/no-forms))
           _ (mlit-nil-refusal (mlit-first-nil-entry entries 0) form)]
       (mlit-keyword-fields-spelled typed (vector-count entries) form)))
   :default nil)

#?(:kotoba
   (defn mlit-keyword-fields-spelled [typed [:list [:ref :form/r]] n :i64 form [:ref :form/r]] [:ref :form/r]
     (if (mlit-any-non-i64? typed 0)
       (let [_ (mlit-record-limit-refusal n form)]
         (form/form-vec (mlit-defaulted-fields typed 0 (form/no-forms))))
       (form/nil-form)))
   :default nil)

;; the kinds present among the keys: [keyword-count i64-count string-count other-count]
#?(:kotoba
   (defn mlit-kind-count [m [:ref :form/r]] :i64
     (+ (+ (if (> (mlit-count-kind m "keyword" 0 0) 0) 1 0) (if (> (mlit-count-kind m "i64" 0 0) 0) 1 0))
        (+ (if (> (mlit-count-kind m "string" 0 0) 0) 1 0) (if (> (mlit-count-kind m "" 0 0) 0) 1 0))))
   :default nil)

;; the single kind of the keys of M, "keyword" for an empty literal
#?(:kotoba
   (defn mlit-the-kind [m [:ref :form/r]] :string
     (cond
       (> (mlit-count-kind m "i64" 0 0) 0) "i64"
       (> (mlit-count-kind m "string" 0 0) 0) "string"
       :else "keyword"))
   :default nil)

;; the type a map literal lowers to, read off its source alone (nil-form when its keys are not one admitted kind)
#?(:kotoba
   (defn mlit-lowered-type [env [:ref :fe/env] m [:ref :form/r]] [:ref :form/r]
     (if (and (= 0 (mlit-count-kind m "" 0 0)) (<= (mlit-kind-count m) 1))
       (let [kind (mlit-the-kind m)
             entries (mlit-sorted-entries m kind 0 (form/no-forms))]
         (if (string=? kind "keyword")
           (mlit-lowered-keyword-type env m entries)
           (mlit-lowered-typed-type env entries kind m)))
       (form/nil-form)))
   :default nil)

#?(:kotoba
   (defn mlit-lowered-keyword-type [env [:ref :fe/env] m [:ref :form/r] entries [:list [:ref :form/r]]] [:ref :form/r]
     (let [fields (mlit-keyword-fields env m entries)]
       (if (form/is-nil? fields)
         (form/keyword-form :map)
         (map-literal-record-type fields))))
   :default nil)

#?(:kotoba
   (defn mlit-lowered-typed-type [env [:ref :fe/env] entries [:list [:ref :form/r]] kind :string m [:ref :form/r]] [:ref :form/r]
     (let [t (mlit-item-type env entries m)]
       (form/vec3 (form/keyword-form :map) (mlit-kind-keyword kind) t)))
   :default nil)

#?(:kotoba
   (defn mlit-kind-keyword [kind :string] [:ref :form/r]
     (cond
       (string=? kind "i64") (form/keyword-form :i64)
       (string=? kind "string") (form/keyword-form :string)
       :else (form/keyword-form :keyword)))
   :default nil)

;; ---- a keyword-keyed literal in a position whose type is a record ----
#?(:kotoba
   (defn mlit-field-name-in? [fields [:ref :form/r] k [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of fields))
       false
       (or (form/eq k (form/nth-of (form/nth-of fields i) 0)) (mlit-field-name-in? fields k (+ i 1)))))
   :default nil)

;; the keys of M (all keywords) that are not fields of the record, the first by text order; nil-form when none
#?(:kotoba
   (defn mlit-extra-key [m [:ref :form/r] fields [:ref :form/r] i :i64 best [:ref :form/r]] [:ref :form/r]
     (if (>= i (form/count-of m))
       best
       (let [k (form/nth-of m i)]
         (mlit-extra-key m fields (+ i 2)
                         (if (mlit-field-name-in? fields k 0)
                           best
                           (if (or (form/is-nil? best) (< (string-compare (kw-text k) (kw-text best)) 0)) k best))))))
   :default nil)

#?(:kotoba
   (defn mlit-extra-refusal [extra [:ref :form/r] record-name [:ref :form/r] form [:ref :form/r]] :i64
     (if (form/is-nil? extra)
       0
       (throw (fe-reject
               (string-concat "map literal key "
                 (string-concat (mlit-key-text extra)
                   (string-concat " is not a field of record " (kw-text record-name))))
               "kotoba.error/map-literal-value" form))))
   :default nil)

#?(:kotoba
   (defn mlit-absent-refusal [field [:ref :form/r] field-type [:ref :form/r] record-name [:ref :form/r] key-absent? :bool form [:ref :form/r]] [:ref :form/r]
     (if (generic-option-type? field-type)
       (form/call1 "option-none-of" field-type)
       (throw (fe-reject
               (string-concat "map literal field "
                 (string-concat (mlit-key-text field)
                   (string-concat " of record "
                     (string-concat (kw-text record-name)
                       (string-concat " is "
                         (string-concat (pr-form field-type)
                           (string-concat ", which is not an option, so it cannot be absent"
                             (string-concat (if key-absent? " (the key is left out)" " (its value is nil)")
                                            "; only an [:option T] field is absent"))))))))
               "kotoba.error/map-literal-value" form))))
   :default nil)

;; one record field of a literal: the value checked against the declared type, or the absent option
#?(:kotoba
   (defn mlit-record-field [env [:ref :fe/env] m [:ref :form/r] field [:ref :form/r] field-type [:ref :form/r] record-name [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [present? (form/form-has? m field)
           value (form/form-get m field)]
       (if (or (not present?) (form/is-nil? value))
         (mlit-absent-dr env field field-type record-name (not present?) form)
         (desugar-expected-value env field-type value))))
   :default nil)

#?(:kotoba
   (defn mlit-absent-dr [env [:ref :fe/env] field [:ref :form/r] field-type [:ref :form/r] record-name [:ref :form/r] key-absent? :bool form [:ref :form/r]] [:ref :fe/dr]
     (let [v (mlit-absent-refusal field field-type record-name key-absent? form)]
       (dr env v)))
   :default nil)

#?(:kotoba
   (defn mlit-record-fields [env [:ref :fe/env] m [:ref :form/r] fields [:ref :form/r] i :i64 record-name [:ref :form/r] form [:ref :form/r] acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of fields))
       (drs env acc)
       (let [f (form/nth-of fields i)
             r (mlit-record-field env m (form/nth-of f 0) (form/nth-of f 1) record-name form)]
         (mlit-record-fields (dr-env r) m fields (+ i 1) record-name form (form/append-form acc (dr-form r))))))
   :default nil)

#?(:kotoba
   (defn mlit-against-record [env [:ref :fe/env] m [:ref :form/r] record [:ref :form/r]] [:ref :fe/dr]
     (let [fields (form/nth-of record 2)
           record-name (form/nth-of record 1)
           _ (mlit-extra-refusal (mlit-extra-key m fields 0 (form/nil-form)) record-name m)
           r (mlit-record-fields env m fields 0 record-name m (form/no-forms))]
       (dr (drs-env r) (head-call (form/symbol-form "record-new") (form/cons-onto record (drs-forms r))))))
   :default nil)

;; ---- the literal itself ----
;; the sorted kind names of the keys, joined with " and " (for the mixed-kind refusal)
#?(:kotoba
   (defn mlit-kind-names [m [:ref :form/r]] :string
     (let [i64? (> (mlit-count-kind m "i64" 0 0) 0)
           kw? (> (mlit-count-kind m "keyword" 0 0) 0)
           s? (> (mlit-count-kind m "string" 0 0) 0)]
       (cond
         (and i64? kw? s?) "i64 and keyword and string"
         (and i64? kw?) "i64 and keyword"
         (and i64? s?) "i64 and string"
         :else "keyword and string")))
   :default nil)

#?(:kotoba
   (defn mlit-key-refusal [m [:ref :form/r] form [:ref :form/r]] :i64
     (let [offender (mlit-first-offender m 0)]
       (if (form/is-f64? offender)
         (throw (fe-reject "map literal keys must be keywords, integers or strings; this literal has a floating point key, which has no portable key identity -- NaN compares unequal to itself, and +0.0 and -0.0 are equal while differing in bits, so neither the entry order nor duplicate-key detection is decidable"
                           "kotoba.error/map-literal-key" form))
         (throw (fe-reject (string-concat "map literal keys must be keywords, integers or strings; this literal has a key of kind: " (mlit-key-description offender))
                           "kotoba.error/map-literal-key" form)))))
   :default nil)

;; the [key value] pairs desugared (values only; keys stay as written), flat after the head
#?(:kotoba
   (defn mlit-desugar-values [env [:ref :fe/env] entries [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (vector-count entries))
       (drs env acc)
       (let [e (typed-list-nth [:list [:ref :form/r]] entries i)
             v (desugar-expr env (form/nth-of e 1))]
         (mlit-desugar-values (dr-env v) entries (+ i 1) (form/append-form (form/append-form acc (form/nth-of e 0)) (dr-form v))))))
   :default nil)

;; the record-new operands: each value desugared against its field type
#?(:kotoba
   (defn mlit-record-values [env [:ref :fe/env] entries [:list [:ref :form/r]] fields [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (vector-count entries))
       (drs env acc)
       (let [e (typed-list-nth [:list [:ref :form/r]] entries i)
             r (desugar-expected-value env (form/nth-of (form/nth-of fields i) 1) (form/nth-of e 1))]
         (mlit-record-values (dr-env r) entries fields (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

#?(:kotoba
   (defn mlit-keyword-literal [env [:ref :fe/env] m [:ref :form/r] entries [:list [:ref :form/r]]] [:ref :fe/dr]
     (let [fields (mlit-keyword-fields env m entries)]
       (if (form/is-nil? fields)
         (mlit-pair-map env entries)
         (mlit-closed-record env entries fields))))
   :default nil)

#?(:kotoba
   (defn mlit-pair-map [env [:ref :fe/env] entries [:list [:ref :form/r]]] [:ref :fe/dr]
     (let [vs (mlit-desugar-values env entries 0 (form/no-forms))]
       (dr (drs-env vs) (head-call (form/symbol-form "map-new") (drs-forms vs)))))
   :default nil)

#?(:kotoba
   (defn mlit-closed-record [env [:ref :fe/env] entries [:list [:ref :form/r]] fields [:ref :form/r]] [:ref :fe/dr]
     (let [vs (mlit-record-values env entries fields 0 (form/no-forms))]
       (dr (drs-env vs) (head-call (form/symbol-form "record-new") (form/cons-onto (map-literal-record-type fields) (drs-forms vs))))))
   :default nil)

#?(:kotoba
   (defn mlit-typed-literal [env [:ref :fe/env] m [:ref :form/r] entries [:list [:ref :form/r]] kind :string] [:ref :fe/dr]
     (let [item-type (mlit-item-type env entries m)
           _ (require-k (<= (vector-count entries) 31)
                        (string-concat "map literal with " (string-concat kind " keys exceeds the typed map entry limit"))
                        "kotoba.error/map-literal-key" m)
           vs (mlit-desugar-values env entries 0 (form/no-forms))]
       (dr (drs-env vs)
           (head-call (form/symbol-form "typed-map-new")
                      (form/cons-onto (form/vec3 (form/keyword-form :map) (mlit-kind-keyword kind) item-type) (drs-forms vs))))))
   :default nil)

#?(:kotoba
   (defn mlit-context-record [env [:ref :fe/env] ctx [:ref :form/r]] [:ref :form/r]
     (let [t (canonical-closure-result-type env ctx)]
       (if (record-type? t) t (form/nil-form))))
   :default nil)

#?(:kotoba
   (defn desugar-map-literal [env [:ref :fe/env] m [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [n (quot (form/count-of m) 2)
           _ (require-k (<= n 128) "map entry count exceeds admission limit" "kotoba.error/subset-reject" m)
           context-record (mlit-context-record env ctx)
           kinds (mlit-kind-count m)
           keyword-only? (and (= 1 kinds) (> (mlit-count-kind m "keyword" 0 0) 0))]
       (cond
         (and (not (form/is-nil? context-record)) keyword-only?) (mlit-against-record env m context-record)
         (> (mlit-count-kind m "" 0 0) 0) (mlit-key-refusal-dr env m)
         (> kinds 1) (mlit-mixed-refusal-dr env m)
         :else (mlit-literal-of-kind env m))))
   :default nil)

#?(:kotoba
   (defn mlit-key-refusal-dr [env [:ref :fe/env] m [:ref :form/r]] [:ref :fe/dr]
     (let [_ (mlit-key-refusal m m)]
       (dr env m)))
   :default nil)

#?(:kotoba
   (defn mlit-mixed-refusal-dr [env [:ref :fe/env] m [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k false (string-concat "map literal keys must all be one kind; this literal mixes " (mlit-kind-names m))
                        "kotoba.error/map-literal-key" m)]
       (dr env m)))
   :default nil)

#?(:kotoba
   (defn mlit-literal-of-kind [env [:ref :fe/env] m [:ref :form/r]] [:ref :fe/dr]
     (let [kind (mlit-the-kind m)
           entries (mlit-sorted-entries m kind 0 (form/no-forms))]
       (if (string=? kind "keyword")
         (mlit-keyword-literal env m entries)
         (mlit-typed-literal env m entries kind))))
   :default nil)

;; ---- set and f64 literals ----
#?(:kotoba
   (defn set-member-position [sorted [:list [:ref :form/r]] key :string i :i64] :i64
     (if (>= i (vector-count sorted))
       i
       (if (> (string-compare (pr-form (typed-list-nth [:list [:ref :form/r]] sorted i)) key) 0)
         i
         (set-member-position sorted key (+ i 1)))))
   :default nil)

;; the members of the set ordered by their printed text (the host's `(sort-by pr-str ...)`), stable
#?(:kotoba
   (defn set-sorted-members [s [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of s))
       acc
       (let [m (form/nth-of s i)
             p (set-member-position acc (pr-form m) 0)]
         (set-sorted-members s (+ i 1) (slice-forms acc p (vector-count acc) (form/append-form (slice-forms acc 0 p (form/no-forms)) m))))))
   :default nil)

;; a bounded non-empty keyword set lowers to the typed-set profile in canonical order; a `#{...}` literal is always [:set :keyword]
#?(:kotoba
   (defn desugar-set-literal [env [:ref :fe/env] s [:ref :form/r]] [:ref :fe/dr]
     (dr env (head-call (form/symbol-form "typed-set-new")
                        (form/cons-onto (form/vec2 (form/keyword-form :set) (form/keyword-form :keyword))
                                        (set-sorted-members s 0 (form/no-forms))))))
   :default nil)

;; a floating literal is its bits
;; The binary32 bit pattern of an f64 literal written in an `:f32` context (host `f32-literal-bits!`, record_projection.cljk): the narrowing is
;; exact-or-refused, so the literal is admitted when widening its binary32 rounding gives back the same f64 bits. -1 << 40 when it is not exact.
#?(:kotoba
   (defn f32-literal-bits-or-none [b :i64] :i64
     (let [n (f64-to-f32-rounded (f64-from-bits b))]
       (if (= (f64-to-bits (f32-to-f64-exact n)) b) (f32-to-bits n) -1099511627776)))
   :default nil)

;; a NaN or an infinity (the exponent field all ones), spelled as `pr-str` spells it
#?(:kotoba
   (defn f64-nonfinite-text [b :i64] :string
     (if (= (bit-and b 9218868437227405312) 9218868437227405312)
       (if (= (bit-and b 4503599627370495) 0)
         (if (< b 0) "##-Inf" "##Inf")
         "##NaN")
       ""))
   :default nil)

#?(:kotoba
   (defn desugar-f32-literal [env [:ref :fe/env] f [:ref :form/r]] [:ref :fe/dr]
     (let [b (form/bits-of f)
           nf (f64-nonfinite-text b)
           _ (require-k (= (string-length nf) 0)
                        (string-concat "f32 literal must be a finite decimal: "
                                       (string-concat nf " -- write (f32-from-bits <i32>) for a NaN or an infinity"))
                        "kotoba.error/f32-literal-not-finite" f)
           r (f32-literal-bits-or-none b)]
       ;; the inexact refusal prints the literal with `pr-str` (the shortest decimal that reads back as these bits), which is not ported
       (if (= r -1099511627776)
         (throw (fe-unported "f32 literal that is not exactly representable in binary32" f))
         (dr env (form/call1 "f32-from-bits" (form/int-form r))))))
   :default nil)

#?(:kotoba
   (defn desugar-f64-literal [env [:ref :fe/env] f [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (if (form/eq ctx (form/keyword-form :f32))
       (desugar-f32-literal env f)
       (dr env (form/call1 "f64-from-bits" (form/int-form (form/bits-of f))))))
   :default nil)

;; ---- collection heads over a :document (map, filter, remove, merge, select-keys, get-in, assoc-in, update, some, every?, concat, keep, into) ----
;; Each is rewritten to source built from primitives the frontend already lowers (`get`/`assoc` paths, `document-merge`, a `reduce` that
;; builds a document vector), then desugared again.
#?(:kotoba
   (defn doc-callback-call [f [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
     (cond
       (head-is? f "fn")
       (let [params (if (> (form/count-of f) 1) (form/nth-of f 1) (form/nil-form))
             _ (require-k (and (form/is-vec? params) (= 1 (form/count-of params)) (> (form/count-of f) 2))
                          "a fn applied to a document collection takes one parameter and a body" "kotoba.error/subset-reject" f)]
         (form/call2 "let" (form/vec2 (form/nth-of params 0) x) (implicit-do-list (args-from f 2))))
       (form/is-keyword? f) (form/call3 "get" x f (form/call0 "document-null"))
       :else (form/form-seq (form/two-forms f x))))
   :default nil)

#?(:kotoba
   (defn doc-hof->reduce [op [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (let [acc (form/symbol-form "__kotoba_hof_acc")
           x (form/symbol-form "__kotoba_hof_x")
           call (doc-callback-call (arg form 0) x)
           name (form/symbol-value op)
           step (cond
                  (or (string=? name "map") (string=? name "mapv"))
                  (form/call2 "document-vector-conj" acc (form/call1 "__kotoba_document_of" call))
                  (or (string=? name "filter") (string=? name "filterv"))
                  (form/call3 "if" call (form/call2 "document-vector-conj" acc x) acc)
                  :else (form/call3 "if" call acc (form/call2 "document-vector-conj" acc x)))]
       (form/call3 "reduce" (form/call2 "fn" (form/vec2 acc x) step) (form/call0 "document-vector") (arg form 1))))
   :default nil)

#?(:kotoba
   (defn desugar-document-hof [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [f (doc-hof->reduce op form)]
       (desugar-expr env f)))
   :default nil)

;; the literal key path of an operation: a non-empty vector, or a refusal
#?(:kotoba
   (defn doc-path [op [:ref :form/r] form [:ref :form/r] i :i64] [:ref :form/r]
     (let [v (if (< i (argc form)) (arg form i) (form/nil-form))
           _ (require-k (and (form/is-vec? v) (> (form/count-of v) 0))
                        (string-concat (form/symbol-value op) " on a document takes a literal non-empty vector of keys")
                        "kotoba.error/subset-reject" form)]
       v))
   :default nil)

#?(:kotoba
   (defn doc-merge-fold [form [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (> i (argc form))
       acc
       (doc-merge-fold form (+ i 1) (form/call2 "document-merge" acc (form/nth-of form i)))))
   :default nil)

#?(:kotoba
   (defn doc-select-fold [ks [:ref :form/r] i :i64 m [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (form/count-of ks))
       acc
       (let [k (form/nth-of ks i)]
         (doc-select-fold ks (+ i 1) m
                          (form/call3 "if" (form/call2 "contains?" m k)
                                      (form/call3 "assoc" acc k (form/call3 "get" m k (form/call0 "document-null")))
                                      acc)))))
   :default nil)

#?(:kotoba
   (defn doc-get-in-fold [ks [:ref :form/r] i :i64 f [:ref :form/r] default [:ref :form/r]] [:ref :form/r]
     (if (= (+ i 1) (form/count-of ks))
       (form/call3 "get" f (form/nth-of ks i) default)
       (doc-get-in-fold ks (+ i 1) (form/call3 "get" f (form/nth-of ks i) (form/call0 "document-null")) default)))
   :default nil)

#?(:kotoba
   (defn doc-assoc-in-build [ks [:ref :form/r] i :i64 m [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (let [k (form/nth-of ks i)]
       (if (= (+ i 1) (form/count-of ks))
         (form/call3 "assoc" m k v)
         (form/call3 "assoc" m k
                     (doc-assoc-in-build ks (+ i 1) (form/call3 "get" m k (form/call0 "document-map")) v)))))
   :default nil)

#?(:kotoba
   (defn doc-concat-fold [form [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (> i (argc form))
       acc
       (doc-concat-fold form (+ i 1) (form/call3 "__kotoba_doc_append_from" (form/nth-of form i) (form/int-form 0) acc))))
   :default nil)

;; the operand I (0-based) of the call, nil-form past the end
#?(:kotoba
   (defn operand-or-nil [form [:ref :form/r] i :i64] [:ref :form/r]
     (if (< i (argc form)) (arg form i) (form/nil-form)))
   :default nil)

#?(:kotoba
   (defn doc-update-applied [f [:ref :form/r] current [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (cond
       (head-is? f "fn") (doc-callback-call f current)
       (form/is-keyword? f) (form/call3 "get" current f (form/call0 "document-null"))
       :else (form/form-seq (form/cons-onto f (form/cons-onto current (args-from-nth form 4))))))
   :default nil)

;; the operands of the call from 0-based index I as a list
#?(:kotoba
   (defn args-from-nth [form [:ref :form/r] i :i64] [:list [:ref :form/r]]
     (if (< i (form/count-of form)) (args-from form i) (form/no-forms)))
   :default nil)

#?(:kotoba
   (defn doc-head->form [op [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (let [name (form/symbol-value op)
           acc (form/symbol-form "__kotoba_hof_acc")
           x (form/symbol-form "__kotoba_hof_x")
           nil-doc (form/call0 "document-null")]
       (cond
         (string=? name "merge") (doc-merge-fold form 2 (form/nth-of form 1))
         (string=? name "select-keys")
         (let [m (form/symbol-form "__kotoba_sel_m")
               ks (doc-path op form 1)]
           (form/call2 "let" (form/vec2 m (operand-or-nil form 0)) (doc-select-fold ks 0 m (form/call0 "document-map"))))
         (string=? name "get-in")
         (let [ks (doc-path op form 1)
               default (if (= 3 (argc form)) (arg form 2) nil-doc)]
           (doc-get-in-fold ks 0 (operand-or-nil form 0) default))
         (string=? name "assoc-in")
         (let [ks (doc-path op form 1)]
           (doc-assoc-in-build ks 0 (operand-or-nil form 0) (operand-or-nil form 2)))
         (string=? name "update")
         (let [m (operand-or-nil form 0)
               k (operand-or-nil form 1)
               f (operand-or-nil form 2)
               current (form/call3 "get" m k nil-doc)
               applied (doc-update-applied f current form)]
           (form/call3 "assoc" m k applied))
         (string=? name "empty?") (form/call2 "=" (form/call1 "document-count" (operand-or-nil form 0)) (form/int-form 0))
         (string=? name "some")
         (let [call (doc-callback-call (operand-or-nil form 0) x)]
           (form/call3 "reduce" (form/call2 "fn" (form/vec2 acc x) (form/call3 "if" acc acc call)) (form/bool-form false) (operand-or-nil form 1)))
         (string=? name "every?")
         (let [call (doc-callback-call (operand-or-nil form 0) x)]
           (form/call3 "reduce" (form/call2 "fn" (form/vec2 acc x) (form/call3 "if" acc call (form/bool-form false))) (form/bool-form true) (operand-or-nil form 1)))
         (string=? name "concat") (doc-concat-fold form 1 (form/call0 "document-vector"))
         (string=? name "keep")
         (let [call (doc-callback-call (operand-or-nil form 0) x)
               kept (form/symbol-form "__kotoba_kept")]
           (form/call3 "reduce"
                       (form/call2 "fn" (form/vec2 acc x)
                                   (form/call2 "let" (form/vec2 kept call)
                                               (form/call3 "if" (form/call2 "=" (form/call1 "document-kind" kept) (form/keyword-form :null))
                                                           acc
                                                           (form/call2 "document-vector-conj" acc kept))))
                       (form/call0 "document-vector") (operand-or-nil form 1)))
         :else
         (form/call3 "reduce"
                     (form/call2 "fn" (form/vec2 acc x)
                                 (form/call3 "if" (form/call2 "=" (form/call1 "document-kind" acc) (form/keyword-form :map))
                                             (form/call3 "document-assoc" acc (form/call2 "__kotoba_doc_nth" x (form/int-form 0)) (form/call2 "__kotoba_doc_nth" x (form/int-form 1)))
                                             (form/call2 "document-vector-conj" acc x)))
                     (operand-or-nil form 0) (operand-or-nil form 1)))))
   :default nil)

#?(:kotoba
   (defn desugar-document-head-op [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [f (doc-head->form op form)]
       (desugar-expr env f)))
   :default nil)

;; a call whose operator is a symbol, in the order of the host's cond chain and then its `case op`
#?(:kotoba
   (defn desugar-head [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [name (form/symbol-value op)]
       (cond
         (lexical-call? env op) (desugar-lexical-call-k env op form ctx)
         (tables/table-has? (env-table env :string-idx) op)
         (desugar-indexed-call env op form (tables/table-get (env-table env :string-idx) op) (form/keyword-form :string))
         (tables/table-has? (env-table env :document-idx) op)
         (desugar-indexed-call env op form (tables/table-get (env-table env :document-idx) op) (form/keyword-form :document))
         (or (string=? name "document-vector") (string=? name "document-list") (string=? name "document-set"))
         (desugar-all-under env op form (form/keyword-form :document) 1 (form/no-forms))
         (string=? name "document-map") (desugar-document-map env op form 1 (form/no-forms))
         (tables/table-has? (env-table env :f64-idx) op)
         (desugar-indexed-call env op form (tables/table-get (env-table env :f64-idx) op) (form/keyword-form :f64))
         (tables/table-has? (env-table env :f32-idx) op)
         (desugar-indexed-call env op form (tables/table-get (env-table env :f32-idx) op) (form/keyword-form :f32))
         (tables/table-has? (env-table env :vec-f64) op)
         (desugar-typed-indexed env op form (tables/table-get (env-table env :vec-f64) op) 1 (form/no-forms))
         (string=? name "vector-f64-new") (desugar-all-under env op form (form/keyword-form :f64) 1 (form/no-forms))
         (tables/table-has? (env-table env :typed-vec) op) (desugar-typed-vector-op env op form)
         (and (or (string=? name "mapv") (string=? name "filterv") (string=? name "remove"))
              (top-level-function-symbol? env op))
         (desugar-ordinary-call env op form)
         (and (or (string=? name "map") (string=? name "mapv") (string=? name "filter") (string=? name "filterv") (string=? name "remove"))
              (= 2 (argc form))
              (not (tables/table-has? (env-lexical env) op))
              (guess-document-form? env (arg form 1)))
         (desugar-document-hof env op form)
         (and (tables/table-has? (env-table env :doc-heads) op)
              (not (tables/table-has? (env-lexical env) op))
              (not (top-level-function-symbol? env op))
              (> (argc form) 0)
              (guess-document-form? env (document-head-target op form)))
         (desugar-document-head-op env op form)
         (string=? name "if") (desugar-if env form ctx)
         (string=? name "do") (desugar-do-arm env form ctx)
         (string=? name "and") (desugar-and env form 1)
         (string=? name "or") (desugar-or env form 1)
         (string=? name "not") (desugar-wrap1-if env form "not requires one operand")
         (string=? name "not=") (desugar-not= env form)
         (string=? name "zero?") (desugar-against-zero env form "zero? requires one operand" "=")
         (string=? name "pos?") (desugar-against-zero env form "pos? requires one operand" ">")
         (string=? name "neg?") (desugar-against-zero env form "neg? requires one operand" "<")
         (string=? name "empty?") (desugar-against-zero env form "empty? requires one operand" "=")
         (string=? name "=") (desugar-binary-op env op form)
         (string=? name "<") (desugar-binary-op env op form)
         (string=? name ">") (desugar-binary-op env op form)
         (string=? name "<=") (desugar-binary-op env op form)
         (string=? name ">=") (desugar-binary-op env op form)
         (string=? name "->") (desugar-thread env form false)
         (string=? name "->>") (desugar-thread env form true)
         (string=? name "as->") (desugar-as-thread env form)
         (string=? name "some->") (desugar-some-thread env form false)
         (string=? name "some->>") (desugar-some-thread env form true)
         (string=? name "cond") (desugar-cond env form)
         (string=? name "condp") (desugar-condp env form)
         (string=? name "cond->") (desugar-cond-thread env form false)
         (string=? name "cond->>") (desugar-cond-thread env form true)
         (string=? name "assert") (desugar-assert env form)
         (string=? name "case") (desugar-case env form)
         (string=? name "if-some") (desugar-binding-some env form false)
         (string=? name "when-some") (desugar-binding-some env form true)
         (string=? name "if-let") (desugar-binding-if env form false)
         (string=? name "when-let") (desugar-binding-if env form true)
         (string=? name "if-not") (desugar-if-not env form)
         (string=? name "when-not") (desugar-when-not env form)
         (string=? name "when") (desugar-when env form)
         (string=? name "let") (desugar-let env form ctx)
         (string=? name "first") (desugar-wrap1 env form "first requires one operand" "pair-first")
         (string=? name "rest") (desugar-wrap1 env form "rest requires one operand" "pair-second")
         (string=? name "second") (desugar-second env form)
         (string=? name "cons") (desugar-cons env form)
         (string=? name "some") (desugar-some-arm env form)
         (string=? name "some?") (desugar-wrap1 env form "some? requires one option operand" "option-some?")
         (string=? name "nil?") (desugar-nil? env form)
         (string=? name "bytes") (desugar-bytes-arm env form)
         (string=? name "str") (desugar-str env form)
         (string=? name "string-length") (desugar-string-length env form)
         (string=? name "string-from-i64") (desugar-string-from-i64 env form)
         (string=? name "inc") (desugar-inc-dec env form "inc requires one i64" "+")
         (string=? name "dec") (desugar-inc-dec env form "dec requires one i64" "-")
         (string=? name "rem") (desugar-rem env form)
         (string=? name "mod") (desugar-mod env form)
         (string=? name "get")
         (desugar-keep-head env form (and (<= 2 (argc form)) (<= (argc form) 3))
                            "get requires a value, a key, and an optional default")
         (string=? name "contains?")
         (desugar-keep-head env form (= 2 (argc form)) "contains? requires a map and one key")
         (string=? name "dissoc")
         (desugar-keep-head env form (>= (argc form) 2) "dissoc requires a map and at least one key")
         (tables/table-has? (env-table env :typed-ops) op)
         (desugar-typed-op env op form (tables/table-get (env-table env :typed-ops) op))
         (string=? name "list") (desugar-list-arm env form ctx)
         (string=? name "typed-list-new") (desugar-item-ctor env form "typed-list-new" "typed-list-new requires a type descriptor" false)
         (string=? name "typed-set") (desugar-item-ctor env form "typed-set-new" "typed-set requires a type descriptor" true)
         (string=? name "typed-set-new") (desugar-item-ctor env form "typed-set-new" "typed-set-new requires a type descriptor" true)
         (string=? name "hetero-vector") (desugar-hetero-ctor env form "hetero-vector requires a type descriptor")
         (string=? name "hetero-vector-new") (desugar-hetero-ctor env form "hetero-vector-new requires a type descriptor")
         (string=? name "typed-map-new") (desugar-typed-map-new env form)
         (string=? name "record") (desugar-record-ctor env form "record requires a type descriptor")
         (string=? name "record-new") (desugar-record-ctor env form "record-new requires a type descriptor")
         (string=? name "record-get") (desugar-record-get env form)
         (string=? name "record-assoc") (desugar-record-assoc env form)
         (string=? name "hetero-vector-assoc") (desugar-hetero-assoc env form)
         (string=? name "variant-new") (desugar-variant-new env form)
         (string=? name "match-variant") (desugar-match-variant env form)
         (string=? name "variant-match") (desugar-variant-match env form)
         (string=? name "match-result") (desugar-match-result env form)
         (string=? name "result-match-of") (desugar-result-match-of env form)
         (string=? name "option-match") (desugar-option-match env form)
         (string=? name "match-option") (desugar-match-option env form)
         (string=? name "throw") (desugar-throw env form)
         (string=? name "try") (desugar-try env form)
         (string=? name "catch") (throw (desugar-catch-arm form))
         (string=? name "vector-i64") (desugar-vector-i64-arm env form)
         (string=? name "vector-f64") (desugar-vector-f64-arm env form)
         (string=? name "xorshift32") (desugar-xorshift32 env form)
         (string=? name "assoc") (desugar-assoc-arm env form)
         (string=? name "select-keys") (desugar-select-keys-arm env form)
         (string=? name "merge") (desugar-merge-arm env form)
         (string=? name "loop") (desugar-loop env form)
         (string=? name "dotimes") (desugar-dotimes env form)
         (string=? name "doseq") (desugar-doseq env form)
         (or (string=? name "filter") (string=? name "remove")) (desugar-filter env op form)
         (string=? name "reduce") (desugar-reduce env form)
         (string=? name "mapv") (desugar-mapv env op form)
         (string=? name "filterv") (desugar-filterv env op form)
         (string=? name "into") (desugar-into env op form)
         (string=? name "map") (desugar-map-call env form)
         (string=? name "map-indexed") (desugar-map-indexed env op form)
         (string=? name "fn") (desugar-fn env form ctx)
         (string=? name "fn-ref") (desugar-fn-ref env op form)
         (string=? name "apply") (desugar-apply env op form)
         (string=? name "invoke") (desugar-invoke env op form ctx)
         (string=? name "take") (desugar-lazy-count-op env form "take" "__kotoba_lazy_take" "take requires a count and lazy sequence")
         (string=? name "drop") (desugar-lazy-count-op env form "drop" "__kotoba_lazy_drop" "drop requires a count and lazy sequence")
         (string=? name "lazy-first") (desugar-lazy-part env form "lazy-first requires one lazy sequence" "pair-first")
         (string=? name "lazy-rest") (desugar-lazy-part env form "lazy-rest requires one lazy sequence" "pair-second")
         (string=? name "lazy-empty?") (desugar-lazy-empty env form)
         (string=? name "lazy-cons") (desugar-lazy-cons env form)
         (string=? name "char") (desugar-char env op form)
         (string=? name "string-join") (desugar-string-join env form)
         (string=? name "match") (desugar-match-k env form)
         (or (string=? name "assert!") (string=? name "retract!") (string=? name "observe!")
             (string=? name "facet-enter!") (string=? name "facet-leave!"))
         (desugar-dataspace-form-k env op form)
         (string=? name "cap-call") (desugar-cap-call env op form)
         (string=? name "typed-cap-call") (desugar-typed-cap-call env op form)
         (string=? name "eval") (desugar-eval env op form)
         (string=? name "lazy-map") (desugar-lazy-map env form)
         (string=? name "lazy-filter") (desugar-lazy-filter env form)
         (string=? name "document") (desugar-document-head env form)
         (unported-head? env name) (throw (fe-unported name form))
         (not (< (string-find-byte name 47 0) 0)) (desugar-named-op env op form)
         :else (desugar-ordinary-call env op form))))
   :default nil)

;; the forms of FORM from index I as a list
#?(:kotoba
   (defn args-from [form [:ref :form/r] i :i64] [:list [:ref :form/r]]
     (args-from-loop form i (form/no-forms)))
   :default nil)

#?(:kotoba
   (defn args-from-loop [form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of form))
       acc
       (args-from-loop form (+ i 1) (form/append-form acc (form/nth-of form i)))))
   :default nil)

;; the component of the descriptor T a typed operation's operand is expected to have (nil-form when T is not that kind)
#?(:kotoba
   (defn component-type [k :string t [:ref :form/r]] [:ref :form/r]
     (cond
       (string=? k ":list-item") (if (canonical-list-type? t) (form/nth-of t 1) (form/nil-form))
       (string=? k ":set-item") (if (typed-set-type? t) (form/nth-of t 1) (form/nil-form))
       (string=? k ":key") (if (canonical-typed-map-type? t) (form/nth-of t 1) (form/nil-form))
       (string=? k ":val") (if (canonical-typed-map-type? t) (form/nth-of t 2) (form/nil-form))
       (string=? k ":ok") (if (parametric-result-type? t) (form/nth-of t 1) (form/nil-form))
       (string=? k ":err") (if (parametric-result-type? t) (form/nth-of t 2) (form/nil-form))
       (string=? k ":payload") (if (generic-option-type? t) (form/nth-of t 1) (form/nil-form))
       :else (form/nil-form)))
   :default nil)

;; one operand of a table-driven typed operation, by its kind
#?(:kotoba
   (defn typed-op-arg [env [:ref :fe/env] kind [:ref :form/r] t [:ref :form/r] x [:ref :form/r]] [:ref :fe/dr]
     (let [k (kw-text kind)]
       (cond
         (string=? k ":raw") (dr env x)
         (string=? k ":ct") (dr env (canonical-closure-result-type env x))
         (string=? k ":expr") (desugar-expr env x)
         (string=? k ":value") (desugar-expected-value env t x)
         :else (desugar-expected-value env (component-type k t) x))))
   :default nil)

;; operands [i, n) of FORM by the KINDS vector (index i-1), T the first operand
#?(:kotoba
   (defn typed-op-args [env [:ref :fe/env] kinds [:ref :form/r] t [:ref :form/r] form [:ref :form/r] i :i64
                         acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (typed-op-arg env (form/nth-of kinds (- i 1)) t (form/nth-of form i))]
         (typed-op-args (dr-env r) kinds t form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; SPEC is [arity message kinds]: one kind per operand (:raw verbatim, :ct canonical type, :expr plain, :value expected
;; under the first operand, or a component kind). The head is OP.
#?(:kotoba
   (defn desugar-typed-op [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r] spec [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= (form/int-value (form/nth-of spec 0)) (argc form)) (form/string-value (form/nth-of spec 1))
                        "kotoba.error/subset-reject" form)
           t (arg form 0)
           r (typed-op-args env (form/nth-of spec 2) t form 1 (form/no-forms))]
       (dr (drs-env r) (head-call op (drs-forms r)))))
   :default nil)

;; each operand from index I of FORM expected as ITEM-TYPE (nil-form: plain)
#?(:kotoba
   (defn ev-each [env [:ref :fe/env] item-type [:ref :form/r] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-expected-value env item-type (form/nth-of form i))]
         (ev-each (dr-env r) item-type form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; typed-list-new / typed-set / typed-set-new: (HEAD type item ...) items expected as the descriptor's item type
#?(:kotoba
   (defn desugar-item-ctor [env [:ref :fe/env] form [:ref :form/r] head :string msg :string set? :bool] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) msg "kotoba.error/subset-reject" form)
           t (arg form 0)
           item (if (if set? (typed-set-type? t) (canonical-list-type? t)) (form/nth-of t 1) (form/nil-form))
           r (ev-each env item form 2 (form/no-forms))]
       (dr (drs-env r) (head-call (form/symbol-form head) (form/cons-onto t (drs-forms r))))))
   :default nil)

;; each operand from index I expected as the matching item type of the Form vector TYPES (index i-2)
#?(:kotoba
   (defn ev-each-indexed [env [:ref :fe/env] types [:ref :form/r] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-expected-value env (form/nth-of types (- i 2)) (form/nth-of form i))]
         (ev-each-indexed (dr-env r) types form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

#?(:kotoba
   (defn ctor-tail [env [:ref :fe/env] types [:ref :form/r] form [:ref :form/r]] [:ref :fe/drs]
     (if (= (form/count-of types) (- (argc form) 1))
       (ev-each-indexed env types form 2 (form/no-forms))
       (desugar-each env form 2 (form/no-forms))))
   :default nil)

;; hetero-vector / hetero-vector-new
#?(:kotoba
   (defn desugar-hetero-ctor [env [:ref :fe/env] form [:ref :form/r] msg :string] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) msg "kotoba.error/subset-reject" form)
           t (arg form 0)
           types (if (heterogeneous-vector-type? t) (form/nth-of t 1) (form/form-vec (form/no-forms)))
           r (ctor-tail env types form)]
       (dr (drs-env r) (head-call (form/symbol-form "hetero-vector-new") (form/cons-onto t (drs-forms r))))))
   :default nil)

;; typed-map-new: (typed-map-new type key value ...) keys and values expected as the descriptor's
#?(:kotoba
   (defn map-pairs [env [:ref :fe/env] key-type [:ref :form/r] value-type [:ref :form/r] form [:ref :form/r] i :i64
                     acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= (+ i 1) (form/count-of form))
       (drs env acc)
       (let [k (desugar-expected-value env key-type (form/nth-of form i))
             v (desugar-expected-value (dr-env k) value-type (form/nth-of form (+ i 1)))]
         (map-pairs (dr-env v) key-type value-type form (+ i 2)
                    (form/append-form (form/append-form acc (dr-form k)) (dr-form v))))))
   :default nil)

#?(:kotoba
   (defn desugar-typed-map-new [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (and (> (argc form) 0) (= 1 (rem (argc form) 2))) "typed-map-new requires type and key/value pairs"
                        "kotoba.error/subset-reject" form)
           t (arg form 0)
           ok? (canonical-typed-map-type? t)
           r (map-pairs env (if ok? (form/nth-of t 1) (form/nil-form)) (if ok? (form/nth-of t 2) (form/nil-form)) form 2 (form/no-forms))]
       (dr (drs-env r) (head-call (form/symbol-form "typed-map-new") (form/cons-onto t (drs-forms r))))))
   :default nil)

;; record / record-new: field values expected as the declared field types
#?(:kotoba
   (defn record-field-type-at [fields [:ref :form/r] i :i64] [:ref :form/r]
     (if (and (>= i 0) (< i (form/count-of fields)))
       (form/nth-of (form/nth-of fields i) 1)
       (form/nil-form)))
   :default nil)

#?(:kotoba
   (defn record-values [env [:ref :fe/env] ct [:ref :form/r] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [ft (if (record-type? ct) (record-field-type-at (form/nth-of ct 2) (- i 2)) (form/nil-form))
             r (desugar-expected-value env ft (form/nth-of form i))]
         (record-values (dr-env r) ct form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

#?(:kotoba
   (defn desugar-record-ctor [env [:ref :fe/env] form [:ref :form/r] msg :string] [:ref :fe/dr]
     (let [_ (require-k (> (argc form) 0) msg "kotoba.error/subset-reject" form)
           ct (canonical-closure-result-type env (arg form 0))
           r (record-values env ct form 2 (form/no-forms))]
       (dr (drs-env r) (head-call (form/symbol-form "record-new") (form/cons-onto ct (drs-forms r))))))
   :default nil)

#?(:kotoba
   (defn desugar-record-get [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (or (= 2 (argc form)) (= 3 (argc form))) "record-get requires (value field) or (type value field)"
                        "kotoba.error/subset-reject" form)]
       (if (= 2 (argc form))
         (let [a (desugar-expr env (arg form 0))]
           (dr (dr-env a) (form/call2 "record-get" (dr-form a) (arg form 1))))
         (let [ct (canonical-closure-result-type env (arg form 0))
               a (desugar-expected-value env ct (arg form 1))]
           (dr (dr-env a) (form/call3 "record-get" ct (dr-form a) (arg form 2)))))))
   :default nil)

;; the type of FIELD in the record descriptor CT's fields (nil-form when CT is not a record or has no such field)
#?(:kotoba
   (defn field-type-of [fields [:ref :form/r] field [:ref :form/r] i :i64] [:ref :form/r]
     (if (>= i (form/count-of fields))
       (form/nil-form)
       (if (form/eq (form/nth-of (form/nth-of fields i) 0) field)
         (form/nth-of (form/nth-of fields i) 1)
         (field-type-of fields field (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn desugar-record-assoc [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 4 (argc form)) "record-assoc requires type, value, literal field, and replacement"
                        "kotoba.error/subset-reject" form)
           ct (canonical-closure-result-type env (arg form 0))
           ft (if (record-type? ct) (field-type-of (form/nth-of ct 2) (arg form 2) 0) (form/nil-form))
           a (desugar-expected-value env ct (arg form 1))
           b (desugar-expected-value (dr-env a) ft (arg form 3))]
       (dr (dr-env b) (form/call4 "record-assoc" ct (dr-form a) (arg form 2) (dr-form b)))))
   :default nil)

#?(:kotoba
   (defn desugar-hetero-assoc [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 4 (argc form)) "hetero-vector-assoc requires type, value, literal index, and item"
                        "kotoba.error/subset-reject" form)
           t (arg form 0)
           index (arg form 2)
           it (if (and (heterogeneous-vector-type? t) (form/is-int? index) (<= 0 (form/int-value index))
                       (< (form/int-value index) (form/count-of (form/nth-of t 1))))
                (form/nth-of (form/nth-of t 1) (form/int-value index))
                (form/nil-form))
           a (desugar-expected-value env t (arg form 1))
           b (desugar-expected-value (dr-env a) it (arg form 3))]
       (dr (dr-env b) (form/call4 "hetero-vector-assoc" t (dr-form a) index (dr-form b)))))
   :default nil)

;; the payload type of case TAG in the variant descriptor's cases vector
#?(:kotoba
   (defn variant-payload-type [cases [:ref :form/r] tag [:ref :form/r] i :i64] [:ref :form/r]
     (if (>= i (form/count-of cases))
       (form/nil-form)
       (if (form/eq (form/nth-of (form/nth-of cases i) 0) tag)
         (form/nth-of (form/nth-of cases i) 1)
         (variant-payload-type cases tag (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn desugar-variant-new [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 3 (argc form)) "variant-new requires type, case tag, and payload" "kotoba.error/subset-reject" form)
           t (arg form 0)
           ct (canonical-closure-result-type env t)
           pt (if (variant-type? ct) (variant-payload-type (form/nth-of ct 2) (arg form 1) 0) (form/nil-form))
           a (desugar-expected-value env pt (arg form 2))]
       (dr (dr-env a) (form/call3 "variant-new" t (arg form 1) (dr-form a)))))
   :default nil)

;; branches [tag binder body] as a vector of vectors with the bodies desugared; BRANCH-AT reads branch k of FORM
#?(:kotoba
   (defn variant-branches [env [:ref :fe/env] branches [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of branches))
       (drs env acc)
       (let [b (form/nth-of branches i)
             body (desugar-expr env (form/nth-of b 2))]
         (variant-branches (dr-env body) branches (+ i 1)
                           (form/append-form acc (form/vec3 (form/nth-of b 0) (form/nth-of b 1) (dr-form body)))))))
   :default nil)

#?(:kotoba
   (defn variant-branch-ok? [b [:ref :form/r] seq? :bool] :bool
     (and (if seq? (form/is-seq? b) (form/is-vec? b)) (= 3 (form/count-of b))
          (form/is-keyword? (form/nth-of b 0)) (form/is-symbol? (form/nth-of b 1))))
   :default nil)

#?(:kotoba
   (defn all-variant-branches-ok? [branches [:ref :form/r] i :i64 seq? :bool] :bool
     (if (>= i (form/count-of branches))
       true
       (and (variant-branch-ok? (form/nth-of branches i) seq?) (all-variant-branches-ok? branches (+ i 1) seq?))))
   :default nil)

;; a Form vector of the forms of FORM from index I
#?(:kotoba
   (defn vec-from [form [:ref :form/r] i :i64] [:ref :form/r]
     (form/form-vec (args-from form i)))
   :default nil)

#?(:kotoba
   (defn desugar-match-variant [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (>= (argc form) 3) "match-variant requires value, type, and exhaustive branches"
                        "kotoba.error/subset-reject" form)
           branches (vec-from form 3)
           _ (require-k (all-variant-branches-ok? branches 0 true) "match-variant branches require (:case binder body)"
                        "kotoba.error/subset-reject" form)
           t (arg form 1)
           v (desugar-expected-value env t (arg form 0))
           bs (variant-branches (dr-env v) branches 0 (form/no-forms))]
       (dr (drs-env bs) (form/call3 "variant-match" t (dr-form v) (form/form-vec (drs-forms bs))))))
   :default nil)

#?(:kotoba
   (defn desugar-variant-match [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 3 (argc form)) "variant-match requires type, value, and lowered branches"
                        "kotoba.error/subset-reject" form)
           t (arg form 0)
           branches (arg form 2)
           _ (require-k (and (form/is-vec? branches) (all-variant-branches-ok? branches 0 false))
                        "variant-match lowered branches are invalid" "kotoba.error/subset-reject" form)
           v (desugar-expected-value env t (arg form 1))
           bs (variant-branches (dr-env v) branches 0 (form/no-forms))]
       (dr (drs-env bs) (form/call3 "variant-match" t (dr-form v) (form/form-vec (drs-forms bs))))))
   :default nil)

;; (ok binder body) / (err binder body) / (some binder body) branch shape: a 3-element seq headed by HEAD with a symbol binder
#?(:kotoba
   (defn branch3? [b [:ref :form/r] head :string] :bool
     (and (form/is-seq? b) (= 3 (form/count-of b)) (sym-is? (form/nth-of b 0) head) (form/is-symbol? (form/nth-of b 1))))
   :default nil)

#?(:kotoba
   (defn desugar-match-result [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 4 (argc form)) "match-result requires value, type, ok branch, and err branch"
                        "kotoba.error/subset-reject" form)
           okb (arg form 2)
           errb (arg form 3)
           _ (require-k (branch3? okb "ok") "match-result requires exactly one (ok binder body) branch"
                        "kotoba.error/subset-reject" form)
           _ (require-k (branch3? errb "err") "match-result requires exactly one (err binder body) branch"
                        "kotoba.error/subset-reject" form)
           t (arg form 1)
           v (desugar-expected-value env t (arg form 0))
           ob (desugar-expr (dr-env v) (form/nth-of okb 2))
           eb (desugar-expr (dr-env ob) (form/nth-of errb 2))]
       (dr (dr-env eb)
           (form/call6 "result-match-of" t (dr-form v) (form/nth-of okb 1) (dr-form ob) (form/nth-of errb 1) (dr-form eb)))))
   :default nil)

#?(:kotoba
   (defn desugar-result-match-of [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 6 (argc form)) "result-match-of requires type, value, and two bound branches"
                        "kotoba.error/subset-reject" form)
           _ (require-k (and (form/is-symbol? (arg form 2)) (form/is-symbol? (arg form 4)))
                        "result-match-of requires symbol binders" "kotoba.error/subset-reject" form)
           t (arg form 0)
           v (desugar-expected-value env t (arg form 1))
           ob (desugar-expr (dr-env v) (arg form 3))
           eb (desugar-expr (dr-env ob) (arg form 5))]
       (dr (dr-env eb) (form/call6 "result-match-of" t (dr-form v) (arg form 2) (dr-form ob) (arg form 4) (dr-form eb)))))
   :default nil)

#?(:kotoba
   (defn desugar-option-match [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 5 (argc form)) "option-match requires type, value, none body, binder, and some body"
                        "kotoba.error/subset-reject" form)
           _ (require-k (form/is-symbol? (arg form 3)) "option-match requires a symbol binder" "kotoba.error/subset-reject" form)
           t (arg form 0)
           v (desugar-expected-value env t (arg form 1))
           nb (desugar-expr (dr-env v) (arg form 2))
           sb (desugar-expr (dr-env nb) (arg form 4))]
       (dr (dr-env sb) (form/call5 "option-match" t (dr-form v) (dr-form nb) (arg form 3) (dr-form sb)))))
   :default nil)

#?(:kotoba
   (defn desugar-match-option [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 4 (argc form)) "match-option requires value, type, none branch, and some branch"
                        "kotoba.error/subset-reject" form)
           nb (arg form 2)
           sb (arg form 3)
           _ (require-k (and (form/is-seq? nb) (= 2 (form/count-of nb)) (sym-is? (form/nth-of nb 0) "none"))
                        "match-option requires exactly one (none body) branch" "kotoba.error/subset-reject" form)
           _ (require-k (branch3? sb "some") "match-option requires exactly one (some binder body) branch"
                        "kotoba.error/subset-reject" form)
           t (arg form 1)
           v (desugar-expected-value env t (arg form 0))
           n (desugar-expr (dr-env v) (form/nth-of nb 1))
           s (desugar-expr (dr-env n) (form/nth-of sb 2))]
       (dr (dr-env s) (form/call5 "option-match" t (dr-form v) (dr-form n) (form/nth-of sb 1) (dr-form s)))))
   :default nil)

;; ---- abort ability: throw / try / catch ----
;; the description of the lexical context that refuses `throw`, or "" (`abort-lexical-context`)
#?(:kotoba
   (defn abort-context-text [env [:ref :fe/env]] :string
     (cond
       (record-get [:ref :fe/env] env :lazy) "a lazy thunk"
       (string=? (record-get [:ref :fe/env] env :abort-ctx) "fn") "a fn literal"
       :else ""))
   :default nil)

#?(:kotoba
   (defn desugar-throw [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 1 (argc form)) "throw requires exactly one error value" "kotoba.error/abort-shape" form)
           context (abort-context-text env)
           _ (require-k (string=? context "")
                        (string-concat "throw inside "
                          (string-concat context " is not admitted in abort slice 1: precondition :checked-lexical-facet-unwind is not met"))
                        "kotoba.error/abort-precondition" form)
           a (desugar-expr env (arg form 0))]
       (dr (dr-env a) (form/call1 "throw" (dr-form a)))))
   :default nil)

#?(:kotoba
   (defn types-assoc [types [:ref :form/r] k [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
     (if (form/is-map? types)
       (form/assoc-form types k v)
       (form/form-map (form/two-forms k v))))
   :default nil)

#?(:kotoba
   (defn desugar-try [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 2 (argc form)) "try requires exactly one body expression and one catch clause"
                        "kotoba.error/abort-shape" form)
           body (arg form 0)
           clause (arg form 1)
           _ (require-k (and (form/is-seq? clause) (sym-is? (form/nth-of clause 0) "catch"))
                        "try requires a (catch [error-type] binder handler) clause" "kotoba.error/abort-shape" form)
           parts (- (form/count-of clause) 1)
           _ (require-k (or (= 2 parts) (= 3 parts))
                        "catch requires an optional error type, one binder, and one handler expression"
                        "kotoba.error/abort-shape" form)
           binder (form/nth-of clause (if (= 2 parts) 1 2))
           handler (form/nth-of clause (if (= 2 parts) 2 3))
           raw-type (if (= 2 parts) (form/nil-form) (form/nth-of clause 1))
           error-type (if (form/eq raw-type (form/keyword-form :default)) (form/nil-form) raw-type)
           _ (require-k (simple-symbol-form? binder) "catch binder must be an unqualified symbol" "kotoba.error/abort-shape" form)
           _ (require-k (<= (string-byte-length (form/symbol-value binder)) 128)
                        "catch binder must be a bounded unqualified symbol" "kotoba.error/abort-shape" form)
           _ (desugar-validate-error-type error-type)
           saved-lexical (env-lexical env)
           saved-types (env-types env)
           henv (record-assoc [:ref :fe/env] (with-lexical env (form/form-set (form/append-form (form/kids-of saved-lexical) binder)))
                              :types (if (form/is-nil? error-type) saved-types (types-assoc saved-types binder error-type)))
           h (desugar-expr henv handler)
           renv (record-assoc [:ref :fe/env] (with-lexical (dr-env h) saved-lexical) :types saved-types)
           b (desugar-expr renv body)]
       (dr (dr-env b)
           (form/call2 "try" (dr-form b)
                       (if (form/is-nil? error-type)
                         (form/call2 "catch" binder (dr-form h))
                         (form/call3 "catch" error-type binder (dr-form h)))))))
   :default nil)

;; `(when (some? error-type) (validate-value-type! error-type))`
#?(:kotoba
   (defn desugar-validate-error-type [error-type [:ref :form/r]] :i64
     (if (form/is-nil? error-type)
       0
       (type-valid! error-type)))
   :default nil)

#?(:kotoba
   (defn desugar-catch-arm [form [:ref :form/r]] [:ref :fe/err]
     (fe-reject "catch is admitted only as the clause of a try" "kotoba.error/abort-shape" form))
   :default nil)

;; ---- vector literals ----
;; `closed-vector-literal-type`: the descriptor a closed literal determines, nil-form when it is not closed
#?(:kotoba
   (defn all-item-types-are? [types [:list [:ref :form/r]] want [:ref :form/r] i :i64] :bool
     (if (>= i (vector-count types))
       true
       (and (form/eq (typed-list-nth [:list [:ref :form/r]] types i) want) (all-item-types-are? types want (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn all-item-types-some? [types [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count types))
       true
       (and (not (form/is-nil? (typed-list-nth [:list [:ref :form/r]] types i))) (all-item-types-some? types (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn closed-vector-item-types [f [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of f))
       acc
       (closed-vector-item-types f (+ i 1) (form/append-form acc (closed-vector-literal-type (form/nth-of f i))))))
   :default nil)

#?(:kotoba
   (defn desugar-vector-literal [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (<= (form/count-of form) 128) "vector literal exceeds item limit" "kotoba.error/subset-reject" form)
           types (closed-vector-item-types form 0 (form/no-forms))]
       (cond
         (or (= 0 (vector-count types)) (all-item-types-are? types (form/keyword-form :i64) 0))
         (let [r (desugar-each-from env form 0 (form/no-forms))]
           (dr (drs-env r) (head-call (form/symbol-form "vector-new") (drs-forms r))))
         (all-item-types-are? types (form/keyword-form :f64) 0)
         (let [r (desugar-each-from env form 0 (form/no-forms))]
           (dr (drs-env r) (head-call (form/symbol-form "vector-f64-new") (drs-forms r))))
         (all-item-types-some? types 0)
         (let [t (form/vec2 (form/keyword-form :vector) (form/form-vec types))
               r (ev-each-types env types form 0 (form/no-forms))]
           (dr (drs-env r) (head-call (form/symbol-form "hetero-vector-new") (form/cons-onto t (drs-forms r)))))
         :else
         (let [r (desugar-each-from env form 0 (form/no-forms))]
           (dr (drs-env r) (head-call (form/symbol-form "vector-new") (drs-forms r)))))))
   :default nil)

;; each kid of FORM from index I desugared (a literal's items start at 0; a call's operands at 1)
#?(:kotoba
   (defn desugar-each-from [env [:ref :fe/env] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-expr env (form/nth-of form i))]
         (desugar-each-from (dr-env r) form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; item k of the literal FORM expected as TYPES[k]
#?(:kotoba
   (defn ev-each-types [env [:ref :fe/env] types [:list [:ref :form/r]] form [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-expected-value env (typed-list-nth [:list [:ref :form/r]] types i) (form/nth-of form i))]
         (ev-each-types (dr-env r) types form (+ i 1) (form/append-form acc (dr-form r))))))
   :default nil)

;; ---- small arms ----
#?(:kotoba
   (defn desugar-vector-i64-arm [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (<= (argc form) 128) "vector-i64 exceeds item limit" "kotoba.error/subset-reject" form)
           r (desugar-each env form 1 (form/no-forms))]
       (dr (drs-env r) (head-call (form/symbol-form "vector-new") (drs-forms r)))))
   :default nil)

#?(:kotoba
   (defn desugar-vector-f64-arm [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (<= (argc form) 128) "vector-f64 exceeds item limit" "kotoba.error/subset-reject" form)]
       (desugar-all-under env (form/symbol-form "vector-f64-new") form (form/keyword-form :f64) 1 (form/no-forms))))
   :default nil)

#?(:kotoba
   (defn desugar-xorshift32 [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (= 1 (argc form)) "xorshift32 requires one state value" "kotoba.error/subset-reject" form)
           s0 (synthetic env "xorshift32_0")
           s1 (synthetic (dr-env s0) "xorshift32_1")
           s2 (synthetic (dr-env s1) "xorshift32_2")
           s3 (synthetic (dr-env s2) "xorshift32_3")
           x0 (dr-form s0)
           x1 (dr-form s1)
           x2 (dr-form s2)
           x3 (dr-form s3)
           a (desugar-expr (dr-env s3) (arg form 0))
           b0 (form/call1 "u32-wrap" (dr-form a))
           b1 (form/call1 "u32-wrap" (form/call2 "i32-xor" x0 (form/call2 "i32-shift-left" x0 (form/int-form 13))))
           b2 (form/call1 "u32-wrap" (form/call2 "i32-xor" x1 (form/call2 "u32-shift-right" x1 (form/int-form 17))))
           b3 (form/call1 "u32-wrap" (form/call2 "i32-xor" x2 (form/call2 "i32-shift-left" x2 (form/int-form 5))))]
       (dr (dr-env a)
           (form/call2 "let" (form/form-vec (put2 (put2 (put2 (put2 (form/no-forms) x0 b0) x1 b1) x2 b2) x3 b3)) x3))))
   :default nil)

#?(:kotoba
   (defn desugar-assoc-arm [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (and (>= (argc form) 3) (= 1 (rem (argc form) 2)))
                        "assoc requires a map followed by one or more key/value pairs" "kotoba.error/subset-reject" form)
           r (desugar-each env form 1 (form/no-forms))]
       (dr (drs-env r) (head-call (form/symbol-form "map-assoc") (drs-forms r)))))
   :default nil)

#?(:kotoba
   (defn desugar-select-keys-arm [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [ks (arg form 1)
           _ (require-k (and (= 2 (argc form)) (form/is-vec? ks) (all-keywords? ks 0))
                        "select-keys requires a record and a literal vector of keyword fields: a record's fields are static, so the fields it keeps are written, not computed"
                        "kotoba.error/row-operation-shape" form)
           a (desugar-expr env (arg form 0))]
       (dr (dr-env a) (form/form-seq (form/cons-onto (form/symbol-form "select-keys") (form/cons-onto (dr-form a) (form/kids-of ks)))))))
   :default nil)

#?(:kotoba
   (defn all-keywords? [v [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of v))
       true
       (and (form/is-keyword? (form/nth-of v i)) (all-keywords? v (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn desugar-merge-arm [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (>= (argc form) 2)
                        "merge requires a record and at least one record or map literal to merge onto it"
                        "kotoba.error/row-operation-shape" form)
           r (desugar-each env form 1 (form/no-forms))]
       (dr (drs-env r) (head-call (form/symbol-form "merge") (drs-forms r)))))
   :default nil)

;; ---- list ----
;; `(list a b c)`: the pair chain built from the last item (items are desugared last to first, as the host's reverse/reduce)
#?(:kotoba
   (defn list-pairs [env [:ref :fe/env] form [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :fe/dr]
     (if (< i 1)
       (dr env acc)
       (let [a (desugar-expr env (form/nth-of form i))]
         (list-pairs (dr-env a) form (- i 1) (form/call2 "pair" (dr-form a) acc)))))
   :default nil)

#?(:kotoba
   (defn desugar-list-arm [env [:ref :fe/env] form [:ref :form/r] ctx [:ref :form/r]] [:ref :fe/dr]
     (let [_ (require-k (<= (argc form) 128) "list item count exceeds admission limit" "kotoba.error/subset-reject" form)]
       (if (canonical-list-type? ctx)
         (let [r (ev-each env (form/nth-of ctx 1) form 1 (form/no-forms))]
           (dr (drs-env r) (head-call (form/symbol-form "typed-list-new") (form/cons-onto ctx (drs-forms r)))))
         (list-pairs env form (argc form) (form/int-form 0)))))
   :default nil)

;; ---- named operations: a namespaced head ----
#?(:kotoba
   (defn reader-tagged-refusal [name :string form [:ref :form/r]] [:ref :fe/err]
     (cond
       (string=? name "kotoba.reader/regex")
       (fe-reject "host regex literal #\"...\" is not admitted; pass the pattern as a string to kotoba.lang.bounded-regex"
                  "kotoba.error/host-regex-literal" form)
       (string=? name "kotoba.reader/js")
       (fe-reject "#js literal is host interop; keep it inside a :cljs reader-conditional branch"
                  "kotoba.error/host-js-literal" form)
       (or (string=? name "kotoba.reader/set") (string=? name "kotoba.reader/bigint") (string=? name "kotoba.reader/bigdec"))
       (fe-reject (string-concat "host literal "
                    (string-concat (string-substring name 14 (string-byte-length name))
                      " is not admitted (Kotoba admits keyword-set data and i64 / f64 literals); keep it inside a :clj / :cljs reader-conditional branch"))
                  "kotoba.error/host-literal" form)
       (string=? name "kotoba.reader/char")
       (fe-reject "character literal \\c is host data; Kotoba text is UTF-8 bytes -- spell the byte as an integer (byte-at / string-byte-at) or use a one-character string"
                  "kotoba.error/host-char-literal" form)
       :else (fe-reject (string-concat "named operation " (string-concat name " is not a registered capability"))
                        "kotoba.error/subset-reject" form)))
   :default nil)

;; the operation was written with a namespace: a registered capability (one request value), clojure.core/X
;; (the bare head), else a refusal by name
#?(:kotoba
   (defn desugar-named-op [env [:ref :fe/env] op [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [name (form/symbol-value op)
           slash (string-find-byte name 47 0)
           kw (form/edn-form (string-concat ":" name))]
       (cond
         (tables/table-has? (env-table env :cap-registry) kw)
         (let [_ (require-k (= 1 (argc form)) (string-concat "named operation " (string-concat name " requires exactly one request value"))
                            "kotoba.error/subset-reject" form)
               a (desugar-expr (note-used-capability env kw) (arg form 0))]
           (dr (dr-env a) (form/call1 name (dr-form a))))
         (string=? (string-substring name 0 slash) "clojure.core")
         (desugar-expr env (form/form-seq (form/cons-onto (form/symbol-form (string-substring name (+ slash 1) (string-byte-length name)))
                                                          (form/rest-list form))))
         :else (throw (reader-tagged-refusal name form)))))
   :default nil)

;; `*used-capability-keywords*` when bound: a Form set the analysis reads back; nil-form when unbound
#?(:kotoba
   (defn note-used-capability [env [:ref :fe/env] kw [:ref :form/r]] [:ref :fe/env]
     (let [used (record-get [:ref :fe/env] env :used-caps)]
       (record-assoc [:ref :fe/env] env :used-caps
                     (if (form/is-set? used) (form/form-set (form/append-form (form/kids-of used) kw)) used))))
   :default nil)

;; ---- if-some / when-some ----
;; `resolve-option-type`: the option type of a value form as far as sugar lowering can tell without inference
;; (nil-form: a symbol with no recorded option type); [:option :i64] is the legacy fallback
#?(:kotoba
   (defn option-descriptor? [t [:ref :form/r]] :bool
     (and (form/is-vec? t) (kw-head? t "option")))
   :default nil)

#?(:kotoba
   (defn binding-some-then [env [:ref :fe/env] form [:ref :form/r] when? :bool] [:ref :fe/dr]
     (if when?
       (if (= 1 (- (form/count-of form) 2))
         (dr env (form/nth-of form 2))
         (desugar-do env form 2))
       (dr env (form/nth-of form 2))))
   :default nil)

#?(:kotoba
   (defn all-symbols? [v [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of v))
       true
       (and (form/is-symbol? (form/nth-of v i)) (all-symbols? v (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn symbol-literal-forms [v [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of v))
       acc
       (symbol-literal-forms v (+ i 1) (form/append-form acc (form/call1 "symbol" (form/string-form (form/symbol-value (form/nth-of v i))))))))
   :default nil)

#?(:kotoba
   (defn symbol-type-list [n :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (<= n 0) acc (symbol-type-list (- n 1) (form/append-form acc (form/keyword-form :symbol)))))
   :default nil)
#?(:kotoba nil :default (def contextual-string-argument-indexes tables/contextual-string-argument-indexes))
#?(:kotoba nil :default (def contextual-document-argument-indexes tables/contextual-document-argument-indexes))
#?(:kotoba nil :default (def contextual-f64-argument-indexes tables/contextual-f64-argument-indexes))
#?(:kotoba nil :default (def contextual-f32-argument-indexes tables/contextual-f32-argument-indexes))
#?(:kotoba nil :default (def contextual-vector-f64-argument-types tables/contextual-vector-f64-argument-types))

;; ADR-2607150000: bound (via `binding`) around each top-level defn's
;; desugaring pass in `analyze`, to an atom `loop`'s desugar-expr case
;; conjoins synthesized helper-function definitions onto -- the same
;; "collect synthesized functions on the side, inject them into `parsed`
;; afterward" pattern `map-get-helper`/`uses-map-get?` already established,
;; generalized to support MULTIPLE, uniquely-named helpers per defn (one
;; per `loop` occurrence) rather than one fixed shared name.
#?(:kotoba nil :default (def ^:dynamic *pending-loop-helpers* nil))

;; ADR 0027: helper name -> {:bindings n :declared-result t-or-nil} for every
;; synthesized loop-helper, bound ONCE per `analyze` beside `*loop-counter*`.
;; It is a SIDE table on purpose. The obvious place for these two facts is the
;; helper's own function map, and putting them there changed the emitted HIR:
;; the map crossed the eight-entry array-map threshold and printed its keys in
;; a different order, so every loop-using module's HIR text moved without one
;; value in it changing. Byte-identical output for an unchanged program is the
;; measurement this pass had to keep, so what the passes need travels here and
;; the function map is left exactly as it was.
#?(:kotoba nil :default (def ^:dynamic *loop-helper-shapes* nil))

;; Optional override for the synthesized loop-helper's return type.
;;
;; nil -- the ordinary case -- means "read it from the loop's own exits", which
;; `infer-loop-helper-results` does once the helper's parameter types are known.
;; It used to default to `:i64`, which made the helper's result a CONSTANT with
;; two hard-coded values: every loop returned an i64 unless it was one of the
;; two T4.5 desugarings below, so `(loop [i 0 acc 0.0] ... acc)` was refused
;; with "expected f64, got i64" at the loop's own call site (ADR 0027).
;;
;; T4.5 map/filter still bind it, and the binding is now a redundancy check
;; rather than the only source of the answer: inference derives `:vector-i64`
;; for those two loops on its own (their accumulator is initialised to
;; `(vector-i64)` and their sole exit is that accumulator), and
;; `infer-loop-helper-results` refuses a declared result its exits disagree
;; with, so the two cannot drift apart silently.
#?(:kotoba nil :default (def ^:dynamic *loop-result-type* nil))

;; Known types for a synthesized loop-helper's bindings and captured outer
;; variables. T4.5 map/filter/reduce know the source is `:vector-i64` (or a
;; packed heterogeneous vector of those) before the helper's call site can
;; say so: the collection is often an unannotated parameter, still
;; provisionally `:i64` when `resolve-loop-helper-param-types` records
;; argument types. Without this overlay the helper is typed `:i64` for
;; `__kotoba_map_source_*` and `vector-count` / `vector-at` refuse the
;; binding the author never wrote -- the stdlib-core-oracle cascade.
#?(:kotoba nil :default (def ^:dynamic *loop-known-types* nil))

;; ADR-2607150000: loop-helper names are NOT `gensym` -- unlike and/or's
;; gensym'd `let`-local temp names (erased into numeric WASM local indices,
;; never appearing in the compiled bytes -- confirmed by repeated-compile
;; byte comparison), a loop-helper becomes a real EXPORTED top-level
;; function ("every function is exported by current backends," see
;; analyze's :effects comment below), so its NAME is literally baked into
;; the WASM export section. `gensym` uses a JVM-process-wide monotonic
;; counter, so two compiles of the IDENTICAL source in the same process
;; would get DIFFERENT loop-helper names and therefore DIFFERENT bytes --
;; confirmed empirically (compiled the same loop-using source twice in one
;; process: bytes differed). This compiler's own reproducible-build gates
;; (coverage_evidence.clj/release.clj) require byte-for-byte determinism,
;; so loop-helpers instead get a sequential name from *loop-counter*,
;; bound ONCE per `analyze` call (not per-defn) so the same source always
;; encounters `loop` forms in the same left-to-right desugaring order and
;; always assigns the same names.
#?(:kotoba nil :default (def ^:dynamic *loop-counter* nil))
#?(:kotoba nil :default (def ^:dynamic *function-arities* {}))
#?(:kotoba nil :default (def ^:dynamic *document-functions*
  "Source names of the module's functions whose DECLARED result is `:document`.
  `reduce`/`map`/`filter` choose between the vector-i64 and document lowerings
  while desugaring, when a call's result type is not inferred yet; a declared
  `:document` result is what lets `(merge (base) x)` or `(vals (f))` be read as a
  document."
  #{}))
#?(:kotoba nil :default (def ^:dynamic *lambda-counter* nil))
#?(:kotoba nil :default (def ^:dynamic *pending-lambdas* nil))
#?(:kotoba nil :default (def ^:dynamic *uses-apply?* nil))
#?(:kotoba nil :default (def ^:dynamic *uses-lazy?* nil))
#?(:kotoba nil :default (def ^:dynamic *lifting-lazy-thunk?* false))

;; Abort ability, slice 1 (kotoba-lang `lang/abort-ability.edn`). `throw` is
;; refused inside the lexical contexts whose unwind is not checked yet -- a
;; loop/doseq/dotimes body (which becomes a synthesized helper function), a
;; lazy thunk, a fn literal. Bound to the context's tag while its body is
;; desugared so the refusal can name it and cite the precondition it waits on.
#?(:kotoba nil :default (def ^:dynamic *abort-lexical-context* nil))

#?(:kotoba nil :default (defn abort-lexical-context
  "The description of the lexical context that refuses `throw`, or nil."
  []
  ;; A loop/doseq/dotimes body is NOT here since 2026-09-25 (superproject
  ;; adr-2609242330; kotoba-lang lang/abort-ability.edn :loop-body). Its body
  ;; becomes a loop helper that is called exactly where the loop is written,
  ;; so an abort from it reaches the enclosing function, which becomes
  ;; aborting in turn -- and `check-abort-facet-unwind!` refuses every
  ;; aborting function whose interprocedural row carries a facet operation.
  ;; That check IS the facet-unwind precondition for a lexically bounded body.
  ;; A lazy thunk and a fn literal are not lexically bounded (either can run
  ;; after, or outside, the scope that wrote it) and stay refused.
  (cond
    *lifting-lazy-thunk?* "a lazy thunk"
    (= :fn *abort-lexical-context*) "a fn literal")))
#?(:kotoba nil :default (def ^:dynamic *lexical-bindings* #{}))
#?(:kotoba nil :default (def ^:dynamic *lexical-callable-contracts* {}))
#?(:kotoba nil :default (def ^:dynamic *function-callable-result-contracts* {}))
;; `[source-name arity]` -> `{parameter-index callable-contract}` for every
;; defn clause whose parameter vector names a `[:fn ...]` type. Read at an
;; ordinary call so a `fn` written in that argument position is lifted under
;; the contract, the way a `fn` in a contract-typed result position already
;; is (2026-09-12): its parameters take the clause's types and it joins the
;; dispatcher family of that signature. A lambda written anywhere else keeps
;; i64 parameters.
#?(:kotoba nil :default (def ^:dynamic *function-callable-param-contracts* {}))
#?(:kotoba nil :default (def ^:dynamic *expected-callable-contract* nil))
#?(:kotoba nil :default (def ^:dynamic *contextual-closure-result-type* nil))
#?(:kotoba nil :default (def ^:dynamic *required-closure-dispatchers* nil))
#?(:kotoba nil :default (def ^:dynamic *opaque-result-functions* #{}))

#?(:kotoba nil :default (defn request-invoke-dispatcher
  ([result-type arity] (request-invoke-dispatcher result-type arity nil))
  ([result-type arity parameter-types]
   (request-invoke-dispatcher result-type arity parameter-types nil))
  ([result-type arity parameter-types row]
   (let [result-type (canonical-closure-result-type result-type)]
     (when *required-closure-dispatchers*
       (vswap! *required-closure-dispatchers* conj
               (dispatcher-key result-type arity parameter-types row)))
     (invoke-dispatcher-name result-type arity parameter-types row)))))

#?(:kotoba nil :default (def non-shadowable-special-heads tables/non-shadowable-special-heads))

#?(:kotoba nil :default (defn lexical-call-form? [form]
  (and (seq? form)
       (symbol? (first form))
       (contains? *lexical-bindings* (first form))
       (not (contains? non-shadowable-special-heads (first form))))))

#?(:kotoba nil :default (defn callable-clause-for-arity [contract arity form]
  (or (first-truthy #(when (= arity (count (first %))) %) (callable-clauses contract))
      (reject! "callable contract does not admit this arity"
               form :kotoba.error/callable-arity))))

#?(:kotoba nil :default (defn rowed-field-contract
  "The `[:fn ...]` contract of a record field read, `(record-get T v :f)` or
  `(:f v)` over a local of a record type, when that contract declares an
  effect row (ADR 0353 floor :function-effect-rows); nil otherwise. Only a
  ROWED field answers: a field with no row keeps the untyped call it always
  had, so a module with no row keeps its HIR and its CIDs."
  [form]
  (when (seq? form)
    (let [[type field]
          (cond
            (and (= 'record-get (first form)) (= 4 (count form)))
            [(second form) (nth form 3)]
            (and (keyword? (first form)) (= 2 (count form)) (symbol? (second form)))
            [(get *local-types* (second form)) (first form)]
            :else nil)
          type (when type (canonical-closure-result-type type))]
      (when (and (record-type? type) (keyword? field))
        (let [contract (record-field-type type field)]
          (when (callable-effect-row contract) contract)))))))

#?(:kotoba nil :default (defn expression-callable-contract [form]
  (cond
    (symbol? form) (get *lexical-callable-contracts* form)
    (seq? form)
    (let [[op & args] form]
      (if (or (contains? *lexical-bindings* op)
              (contains? *lexical-callable-contracts* op))
        (when-let [contract (get *lexical-callable-contracts* op)]
          (let [result (second (callable-clause-for-arity contract (count args) form))]
            (when (callable-type? result) result)))
        (or (get *function-callable-result-contracts* [op (count args)])
            (get *function-callable-result-contracts* op)
            (rowed-field-contract form))))
    :else nil)))

#?(:kotoba nil :default (defn require-matching-callable-contract! [expected form]
  (when-let [actual (expression-callable-contract form)]
    (when (not= expected actual)
      (reject! "callable contract does not match the expected contract"
               {:expected expected :actual actual :expression form}
               :kotoba.error/callable-contract)))))

#?(:kotoba nil :default (defn opaque-expression? [form]
  ;; Capture storage must be chosen before lifting, ahead of full type checking.
  ;; Carry only proven opaque leaves; the ordinary checker validates operands
  ;; and signatures later. Unknown values retain the existing word ABI.
  (cond
    (symbol? form) (= :js-value (get *local-types* form))
    (seq? form)
    (let [[op & args] form]
      (cond
        (contains? *lexical-bindings* op)
        (when-let [contract (get *lexical-callable-contracts* op)]
          (= :js-value (second (callable-clause-for-arity contract (count args) form))))
        (contains? *opaque-result-functions* [op (count args)]) true
        (contains? *function-arities* op) false
        (contains? '#{js-undefined js-bool-value js-capture-value} op) true
        (= 'do op) (opaque-expression? (last args))
        (= 'if op) (and (opaque-expression? (second args))
                       (opaque-expression? (nth args 2 nil)))
        (= 'let op)
        (let [[bindings body] args]
          (when (and (vector? bindings) (even? (count bindings)))
            (loop [remaining (partition 2 bindings) types *local-types*]
              (if-let [[name value] (first remaining)]
                (let [opaque? (binding [*local-types* types] (opaque-expression? value))]
                  (recur (rest remaining)
                         (cond-> (dissoc types name) opaque? (assoc name :js-value))))
                (binding [*local-types* types] (opaque-expression? body))))))
        :else false))
    :else false)))

#?(:kotoba nil :default (defn desugar-lexical-call [result-type form]
  (let [closure (fe-nth form 0) args (fe-nthnext form 1)]
    (let [_ #?(:kotoba (require-k (not (> (count args) 4)) "direct closure call exceeds ABI arity four" "kotoba.error/subset-reject" form) :default (when (> (count args) 4)
      (reject! "direct closure call exceeds ABI arity four" form)))]
    (let [contract (get *lexical-callable-contracts* closure)
          dd__208183_1 (when contract (callable-clause-for-arity contract (count args) form))
          parameter-types (fe-nth dd__208183_1 0)
          contract-result (fe-nth dd__208183_1 1)
          result-type (or contract-result result-type)]
      ;; A contract's parameter types select the dispatcher family (one per
      ;; distinct clause signature) and give each argument its expected type
      ;; context, exactly as a typed result gives the tail expression one.
      ;; An `:i64` parameter is desugared as it always was, so a program
      ;; whose contracts are all-i64 lowers to the same HIR. The argument's
      ;; TYPE is checked where every call's is -- against the dispatcher's
      ;; signature by the ordinary checker (`expression type mismatch:
      ;; expected document, got i64`) -- not by a second table here.
      (apply list (request-invoke-dispatcher result-type (count args) parameter-types
                                             (callable-effect-row contract))
             closure
             (if parameter-types
               (map (fn [argument wanted]
                      (if (= :i64 wanted)
                        (desugar-expr argument)
                        (desugar-expected-value wanted argument)))
                    args parameter-types)
               (map desugar-expr args))))))))

#?(:kotoba
   (defn desugar-result-expr [env [:ref :fe/env] result-type [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [rt (canonical-closure-result-type env result-type)
           _ (require-k (closure-result-type? rt) "closure result type is outside the admitted dispatcher profile"
                        "kotoba.error/subset-reject" rt)]
       (desugar-expr (with-result env rt) form)))
   :default
(defn desugar-result-expr
  "Desugar an expression in a context with a known closure result family.
  The expectation follows value-producing tail positions, while ordinary
  operands are desugared without inheriting it."
  [result-type form]
  (let [result-type (canonical-closure-result-type result-type)]
    (when-not (or (callable-type? result-type) (closure-result-type? result-type {}))
      (reject! "closure result type is outside the admitted dispatcher profile"
               result-type))
    (if (callable-type? result-type)
      (do
        (require-matching-callable-contract! result-type form)
        (binding [*expected-callable-contract* result-type
                  *contextual-closure-result-type* nil]
          (desugar-expr form)))
      (binding [*contextual-closure-result-type* result-type]
        (desugar-expr form))))))

#?(:kotoba
   (defn desugar-vector-i64-source [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (if (and (form/is-seq? form) (= 2 (form/count-of form))
              (or (head-is? form "rest") (head-is? form "pair-second")))
       (let [a (desugar-vector-i64-source env (form/nth-of form 1))]
         (dr (dr-env a) (form/call2 "vector-drop" (dr-form a) (form/int-form 1))))
       (desugar-result-expr env (form/keyword-form :vector-i64) form)))
   :default
(defn desugar-vector-i64-source
  "Desugar a T4.5 map/filter/reduce collection in the vector-i64 profile.

  `rest` and a written `pair-second` are Clojure's tail of a vector, not the
  legacy pair-chain walk: leaving them as `pair-second` types the source as
  `:i64` and the loop helper then refuses `__kotoba_map_source_*` with
  `expected vector-i64, got i64` -- or the reverse, `pair-second` requiring
  `:i64` of a source that is already a vector. `vector-drop` is the same
  tail and keeps `:vector-i64` through the binding and the captured loop
  parameter. Nested tails compose. Every other form keeps the ordinary
  vector-i64 result context."
  [form]
  (if (and (seq? form)
           (contains? '#{rest pair-second} (first form))
           (= 1 (count (rest form))))
    (list 'vector-drop (desugar-vector-i64-source (second form)) 1)
    (desugar-result-expr :vector-i64 form))))

#?(:kotoba
   (defn desugar-bool-expr [env [:ref :fe/env] form [:ref :form/r]] [:ref :fe/dr]
     (desugar-result-expr env (form/keyword-form :bool) form))
   :default
(defn desugar-bool-expr [form]
  (desugar-result-expr :bool form)))

#?(:kotoba
   (defn desugar-under-contract [env [:ref :fe/env] contract [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [saved (env-con env :expected)
           r (desugar-expr (with-con env :expected contract) form)]
       (dr (with-con (dr-env r) :expected saved) (dr-form r))))
   :default nil)

#?(:kotoba
   (defn desugar-expected-value [env [:ref :fe/env] result-type [:ref :form/r] form [:ref :form/r]] [:ref :fe/dr]
     (let [rt (canonical-closure-result-type env result-type)]
       (cond
         (closure-result-type? rt) (desugar-result-expr env rt form)
         (and (callable-type? rt) (head-is? form "fn")) (desugar-under-contract env rt form)
         :else (desugar-expr env form))))
   :default
(defn desugar-expected-value [result-type form]
  (let [result-type (canonical-closure-result-type result-type)]
    (cond
      (callable-type? result-type)
      (do
        (require-matching-callable-contract! result-type form)
        (binding [*expected-callable-contract* result-type]
          (desugar-expr form)))
      ;; ADR 0353 floor :empty-vector-field: a vector literal where a
      ;; `[:list T]` is expected -- `[]` at a list field -- is that list, each
      ;; item typed against T (a map literal against a record T, as an absent
      ;; field's is).
      (and (canonical-list-type? result-type) (vector? form))
      (let [t (second result-type)]
        (list* 'typed-list-new result-type
               (mapv #(if (and (map? %) (record-type? t)) (desugar-map % t) (desugar-expected-value t %))
                     form)))
      (closure-result-type? result-type {})
      (desugar-result-expr result-type form)
      :else (desugar-expr form)))))

;; the forms of FORM from index I (inclusive), each desugared, the last under RESULT-TYPE when it is not nil
#?(:kotoba
   (defn desugar-tail-expressions [env [:ref :fe/env] result-type [:ref :form/r] form [:ref :form/r] i :i64
                                    acc [:list [:ref :form/r]]] [:ref :fe/drs]
     (if (>= i (form/count-of form))
       (drs env acc)
       (let [r (desugar-tail-one env result-type form i)]
         (desugar-tail-expressions (dr-env r) result-type form (+ i 1) (form/append-form acc (dr-form r))))))
   :default
(defn desugar-tail-expressions [result-type forms]
  (let [last-index (dec (count forms))]
    (mapv (fn [index form]
            (if (and result-type (= index last-index))
              (desugar-result-expr result-type form)
              (desugar-expr form)))
          (range (count forms)) forms))))

#?(:kotoba
   (defn sequenced-body [forms [:list [:ref :form/r]] form [:ref :form/r] head :string] [:ref :form/r]
     (cond
       (= 0 (vector-count forms)) (throw (fe-reject (string-concat head " requires at least one body expression")
                                                    "kotoba.error/let-body-empty" form))
       (= 1 (vector-count forms)) (typed-list-nth [:list [:ref :form/r]] forms 0)
       :else (form/form-seq (form/cons-onto (form/symbol-form "do") forms))))
   :default
(defn sequenced-body
  "Collapse an implicit-`do` body into the ONE expression a core head takes.

  Heads whose source body is a sequence of forms (`let` today; `when` and its
  relatives reach `do` by their own desugaring) must hand exactly one
  expression to the core form, because `let` in KIR is `(let [n v ...] body)`
  with a single body -- every consumer in this file and in kotoba-kir
  destructures it that way.

  The collapse is `do`, never a nested `let`. `do` is kept as a first-class
  head through desugaring for the reason stated at the `do` case below: a
  nested-`let` encoding of sequencing makes an earlier subexpression an unused
  binding, and an unused binding is exactly what a later pass is entitled to
  drop. A kernel store or a `cap-call` in non-final position is the thing that
  would be dropped.

  An empty body is refused rather than collapsed. `(let [x 1])` has no value to
  return, and returning `nil` from here put a literal `nil` into HIR where an
  expression belongs."
  [forms form head]
  (cond
    (empty? forms)
    (reject! (str head " requires at least one body expression") form
             :kotoba.error/let-body-empty)
    (= 1 (count forms)) (first forms)
    :else (list* 'do forms))))

#?(:kotoba
   (defn closed-vector-literal-type [f [:ref :form/r]] [:ref :form/r]
     (cond
       (form/is-int? f) (form/keyword-form :i64)
       (form/is-f64? f) (form/keyword-form :f64)
       (form/is-string? f) (form/keyword-form :string)
       (form/is-keyword? f) (form/keyword-form :keyword)
       (form/is-bool? f) (form/keyword-form :bool)
       (and (form/is-seq? f) (= 2 (form/count-of f)) (sym-is? (form/nth-of f 0) "quote") (form/is-symbol? (form/nth-of f 1)))
       (form/keyword-form :symbol)
       (form/is-vec? f)
       (let [types (closed-vector-item-types f 0 (form/no-forms))]
         (cond
           (= 0 (vector-count types)) (form/keyword-form :vector-i64)
           (all-item-types-are? types (form/keyword-form :i64) 0) (form/keyword-form :vector-i64)
           (all-item-types-are? types (form/keyword-form :f64) 0) (form/keyword-form :vector-f64)
           (all-item-types-some? types 0) (form/vec2 (form/keyword-form :vector) (form/form-vec types))
           :else (form/nil-form)))
       :else (form/nil-form)))
   :default
(defn closed-vector-literal-type
  "Infer only descriptors that are completely determined by a closed vector
  literal. Unknown expressions return nil and keep the established i64-vector
  path, where ordinary type checking reports any mismatch."
  [form]
  (cond
    (kotoba-integer? form) :i64
    (value/f64-value? form) :f64
    (string? form) :string
    (keyword? form) :keyword
    (boolean? form) :bool
