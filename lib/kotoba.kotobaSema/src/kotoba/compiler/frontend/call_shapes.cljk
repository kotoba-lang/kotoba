(ns kotoba.compiler.frontend.call-shapes
  #?(:kotoba {:kotoba/export [declaration-clauses variadic-source-names variadic-call-arities resolve-overloaded-calls]})
  (:require #?@(:kotoba [[kotoba.form :as form]
                         [kotoba.compiler.frontend.base :refer [fe-reject fe-reject-data fdrop fl-drop fl-has? fl-nth fl-slice fmeta-from form-text]]
                         [kotoba.compiler.frontend.expand :refer [max-parameters variadic-params?]]]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]] [:phase :string] [:data [:ref :form/r]]]]})))

#?(:kotoba
(defn- cs-empty-set [] [:ref :form/r]
  (form/form-set (form/no-forms)))
   :default nil)

#?(:kotoba
(defn- cs-empty-map [] [:ref :form/r]
  (form/form-map (form/no-forms)))
   :default nil)

#?(:kotoba
(defn- cs-set-has? [s [:ref :form/r] x [:ref :form/r]] :bool
  (fl-has? (form/kids-of s) x 0))
   :default nil)

#?(:kotoba
(defn- cs-set-add [s [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
  (if (cs-set-has? s x)
    s
    (form/form-set (form/append-form (form/kids-of s) x))))
   :default nil)

#?(:kotoba
(defn- cs-sym-is? [f [:ref :form/r] name :string] :bool
  (and (form/is-symbol? f) (string=? (form/symbol-value f) name)))
   :default nil)

#?(:kotoba
(defn- cs-fail [bad? :bool msg :string code :string source [:ref :form/r]] :i64
  (if bad? (throw (fe-reject msg code source)) 0))
   :default nil)

#?(:kotoba
(defn- cs-declaration [form [:ref :form/r]] [:ref :form/r]
  (let [d (fdrop form 2)]
    (if (and (> (vector-count d) 0) (form/is-string? (fl-nth d 0)))
      (form/form-vec (fl-drop d 1))
      (form/form-vec d))))
   :default nil)

#?(:kotoba
(defn- cs-all-clauses? [d [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of d))
    true
    (let [c (form/nth-of d i)]
      (and (form/is-seq? c) (> (form/count-of c) 0) (form/is-vec? (form/nth-of c 0)) (cs-all-clauses? d (+ i 1))))))
   :default nil)

#?(:kotoba
;; The `(params ...)` clauses a defn form declares, single-arity written as one clause (a Form vector).
(defn declaration-clauses [source [:ref :form/r]] [:ref :form/r]
  (let [d (cs-declaration source)]
    (cond
      (and (> (form/count-of d) 0) (form/is-vec? (form/nth-of d 0))) (form/form-vec (form/one-form (form/form-seq (form/kids-of d))))
      (cs-all-clauses? d 0) d
      :else (form/form-vec (form/no-forms)))))
   :default nil)

#?(:kotoba
(defn- cs-any-variadic-clause? [clauses [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of clauses))
    false
    (or (variadic-params? (form/nth-of (form/nth-of clauses i) 0)) (cs-any-variadic-clause? clauses (+ i 1)))))
   :default nil)

#?(:kotoba
(defn- cs-variadic-names [defs [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of defs))
    acc
    (let [source (form/nth-of defs i)
          source-name (form/nth-of source 1)]
      (cs-variadic-names defs (+ i 1)
                         (if (and (form/is-symbol? source-name) (cs-any-variadic-clause? (declaration-clauses source) 0))
                           (cs-set-add acc source-name)
                           acc)))))
   :default nil)

#?(:kotoba
;; The names of the defns that declare a `[fixed ... & rest]` clause.
(defn variadic-source-names [defs [:ref :form/r]] [:ref :form/r]
  (cs-variadic-names defs 0 (cs-empty-set)))
   :default nil)

#?(:kotoba
(defn- cs-found-add [found [:ref :form/r] op [:ref :form/r] n :i64] [:ref :form/r]
  (let [cur (form/form-get found op)
        arities (if (form/is-nil? cur) (cs-empty-set) cur)]
    (form/assoc-form found op (cs-set-add arities (form/int-form n)))))
   :default nil)

#?(:kotoba
(defn- cs-variadic-walk-kids [source [:ref :form/r] i :i64 names [:ref :form/r] found [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of source))
    found
    (cs-variadic-walk-kids source (+ i 1) names (variadic-walk (form/nth-of source i) names found))))
   :default nil)

#?(:kotoba
(defn- cs-variadic-call [source [:ref :form/r] op [:ref :form/r] names [:ref :form/r] found [:ref :form/r]] [:ref :form/r]
  (let [argc (- (form/count-of source) 1)
        u_1 (cs-fail (> argc (max-parameters))
                     (str "variadic function " (form-text op) " is called with " (string-from-i64 argc)
                          " arguments; a variadic defn is specialized through arity " (string-from-i64 (max-parameters))
                          " (the ABI bound), so a longer call has no clause to reach")
                     "kotoba.error/call-arity" source)
        found2 (cs-found-add found op argc)
        found3 (if (form/is-seq? op) (variadic-walk op names found2) found2)]
    (cs-variadic-walk-kids source 1 names found3)))
   :default nil)

#?(:kotoba
(defn- variadic-walk [source [:ref :form/r] names [:ref :form/r] found [:ref :form/r]] [:ref :form/r]
  (cond
    (and (form/is-seq? source) (> (form/count-of source) 0))
    (let [op (form/nth-of source 0)]
      (cond
        (cs-sym-is? op "quote") found
        (cs-set-has? names op) (cs-variadic-call source op names found)
        :else
        (let [found2 (if (form/is-seq? op) (variadic-walk op names found) found)]
          (cs-variadic-walk-kids source 1 names found2))))
    (form/is-symbol? source)
    (let [_ (cs-fail (cs-set-has? names source)
                     (str "variadic function " (form-text source) " is used as a value; "
                          "a variadic defn is specialized per call site and has "
                          "no single interface, so it is admitted only by direct "
                          "call `(" (form-text source) " ...)` -- not through fn-ref, apply, a "
                          "callback position, or a bare reference. If this `"
                          (form-text source) "` is a local binding, it shadows the function: "
                          "rename one of them")
                     "kotoba.error/subset-reject" source)]
      found)
    (or (form/is-seq? source) (form/is-vec? source) (form/is-set? source) (form/is-map? source)) (cs-variadic-walk-kids source 0 names found)
    :else found))
   :default nil)

#?(:kotoba
(defn- cs-variadic-clauses [clauses [:ref :form/r] i :i64 names [:ref :form/r] found [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of clauses))
    found
    (cs-variadic-clauses clauses (+ i 1) names (cs-variadic-walk-kids (form/nth-of clauses i) 1 names found))))
   :default nil)

#?(:kotoba
(defn- cs-variadic-defs [defs [:ref :form/r] i :i64 names [:ref :form/r] found [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of defs))
    found
    (cs-variadic-defs defs (+ i 1) names (cs-variadic-clauses (declaration-clauses (form/nth-of defs i)) 0 names found))))
   :default nil)

#?(:kotoba
;; Every arity at which a variadic function of this module is called.
(defn variadic-call-arities [defs [:ref :form/r] variadic-names [:ref :form/r]] [:ref :form/r]
  (cs-variadic-defs defs 0 variadic-names (cs-empty-map)))
   :default nil)

#?(:kotoba
(defn- cs-insert-int [xs [:list [:ref :form/r]] x [:ref :form/r] i :i64] [:list [:ref :form/r]]
  (if (or (>= i (vector-count xs)) (> (form/int-value (fl-nth xs i)) (form/int-value x)))
    (fl-slice xs i (vector-count xs) (form/append-form (fl-slice xs 0 i (form/no-forms)) x))
    (cs-insert-int xs x (+ i 1))))
   :default nil)

#?(:kotoba
(defn- cs-overload-arities [overloads [:ref :form/r] op [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= (+ i 1) (form/count-of overloads))
    acc
    (let [key (form/nth-of overloads i)]
      (cs-overload-arities overloads op (+ i 2)
                           (if (form/eq (form/nth-of key 0) op) (cs-insert-int acc (form/nth-of key 1) 0) acc)))))
   :default nil)

#?(:kotoba
(defn- cs-overload-fail [op [:ref :form/r] source [:ref :form/r] overloads [:ref :form/r] argc :i64] :i64
  (throw (fe-reject-data "no matching multi-arity clause" "kotoba.error/call-arity" source
                         (form/assoc-form (form/assoc-form (form/assoc-form (cs-empty-map) (form/keyword-form :function) op)
                                                           (form/keyword-form :expected) (form/form-set (cs-overload-arities overloads op 0 (form/no-forms))))
                                            (form/keyword-form :supplied) (form/int-form argc)))))
   :default nil)

#?(:kotoba
(defn- cs-resolve-kids [source [:ref :form/r] i :i64 overloads [:ref :form/r] sources [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of source))
    acc
    (cs-resolve-kids source (+ i 1) overloads sources
                     (form/append-form acc (resolve-overloaded-calls (form/nth-of source i) overloads sources)))))
   :default nil)

#?(:kotoba
(defn- cs-overload-check [sources [:ref :form/r] op [:ref :form/r] resolved [:ref :form/r] source [:ref :form/r] overloads [:ref :form/r] argc :i64] :i64
  (if (and (cs-set-has? sources op) (form/eq resolved op))
    (cs-overload-fail op source overloads argc)
    0))
   :default nil)

#?(:kotoba
(defn- cs-resolve-call [source [:ref :form/r] op [:ref :form/r] overloads [:ref :form/r] sources [:ref :form/r]] [:ref :form/r]
  (let [argc (- (form/count-of source) 1)
        found (if (form/is-symbol? op) (form/form-get overloads (form/vec2 op (form/int-form argc))) (form/nil-form))
        resolved (if (form/is-nil? found) op found)
        u_1 (cs-overload-check sources op resolved source overloads argc)
        args (cs-resolve-kids source 1 overloads sources (form/no-forms))]
    (fmeta-from source (form/form-seq (form/cons-onto resolved args)))))
   :default nil)

#?(:kotoba
;; Resolve a call to an overloaded source name to the clause's ABI name.
(defn resolve-overloaded-calls [source [:ref :form/r] overloads [:ref :form/r] overloaded-sources [:ref :form/r]] [:ref :form/r]
  (cond
    (and (form/is-seq? source) (> (form/count-of source) 0))
    (let [op (form/nth-of source 0)]
      (if (cs-sym-is? op "quote")
        source
        (cs-resolve-call source op overloads overloaded-sources)))
    (form/is-vec? source) (form/form-vec (cs-resolve-kids source 0 overloads overloaded-sources (form/no-forms)))
    (form/is-map? source) (form/form-map (cs-resolve-kids source 0 overloads overloaded-sources (form/no-forms)))
    :else source))
   :default nil)
