(ns kotoba.compiler.frontend.record-projection
  "Module `record-projection` of kotoba.compiler.frontend, cut from the original namespace by amu refactor split (23 forms, 1356 lines). Depends on: base, closure-types, expand, namespace-defs, infer."
  ;; the Kotoba-route interface: the names the other frontend modules, kotoba.sema and the native guests use
  ;; (the linked project export bound is 1024 clauses, ADR 0363 port)
  #?(:kotoba {:kotoba/export [collection-head-advice f64-bits-literal-form? library-predicate-document-test option-presence-test option-present-value resolve-float-operator rewrite-record-projection rewrite-record-projection-or rewrite-record-projections]})
  (:require [kotoba.compiler.frontend-tables :as tables]
            [kotoba.kir.value :as value]
            #?@(:kotoba [[kotoba.form :as form]])
            #?@(:cljs [[kotoba.kir.cljs-i64 :as i64]])
            [kotoba.compiler.frontend.base :refer [let-body reject! #?@(:kotoba [fdrop fe-reject-data fget fl-has? fl-nth fl-slice fname form-text fput fsource-head ftruthy? fwith-source-head pr-form] :default [synthetic first-truthy *synthetic-counter*])]]
            [kotoba.compiler.frontend.closure-types :refer [canonical-list-type? canonical-typed-map-type? closure-default-value-expr heterogeneous-vector-type? record-type? schema-ref-type? typed-set-type? variant-type? #?@(:kotoba [fe-error])]]
            [kotoba.compiler.frontend.expand :refer [kotoba-integer? preserve-form-meta]]
            [kotoba.compiler.frontend.namespace-defs :refer [heterogeneous-vector-index! #?@(:kotoba [] :default [collection-count-operations map-projection-operations set-operations vector-end-operations])]]
            [kotoba.compiler.frontend.infer :refer [document-of-constructor! infer-expression-type library-predicate-answer! nominal-type-identity option-vector-type? record-field-type record-get-default-type require-expression-type! #?@(:kotoba [zip-locals] :default [resolve-absence-if]) row-op-fields row-op-literal-entries row-op-not-record! row-op-record row-op-result-type #?@(:kotoba [argc ctx-row-schemas ctx-schemas use-site-text] :default [document-of-constructors float-arithmetic-resolution library-predicate-heads note-list-item-type! str-part-type! use-site-text])]]
            #?@(:kotoba [[kotoba.compiler.frontend.infer-passes :refer [abort-signatures infer-type-or-nil resolve-absence-if]]]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]
                                 ;; a refusal: the Kotoba-route `reject!` throws one (ADR 0007)
                                 :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]] [:phase :string] [:data [:ref :form/r]]]]
                                 ;; the desugar env and its results (docs/selfhost-frontend-typemodel-design.md 1.2)
                                 :fe/env [:record :fe/env [[:counter :i64] [:result [:ref :form/r]] [:none :bool] [:arities [:ref :form/r]] [:lexical [:ref :form/r]] [:types [:ref :form/r]] [:docfns [:ref :form/r]] [:loop-counter :i64] [:tbl [:ref :form/r]] [:schemas [:ref :form/r]] [:lazy :bool] [:abort-ctx :string] [:used-caps [:ref :form/r]] [:options [:ref :form/r]] [:helpers [:ref :form/r]] [:shapes [:ref :form/r]] [:lambda-counter :i64] [:lambdas [:ref :form/r]] [:loop-result [:ref :form/r]] [:loop-known [:ref :form/r]] [:dispatchers [:ref :form/r]] [:uses-apply :bool] [:uses-lazy :bool] [:contracts [:ref :form/r]]]]
                                 :fe/dr [:record :fe/dr [[:env [:ref :fe/env]] [:form [:ref :form/r]]]]
                                 :fe/drs [:record :fe/drs [[:env [:ref :fe/env]] [:forms [:list [:ref :form/r]]]]]
                                 :ie/ctx [:record :ie/ctx [[:schemas [:ref :form/r]] [:row-schemas [:ref :form/r]] [:handlers [:ref :form/r]] [:final :bool] [:tail :bool] [:names [:ref :form/r]] [:recording :bool] [:recorded [:ref :form/r]] [:collect :bool] [:throws [:list [:ref :form/r]]] [:known [:ref :form/r]] [:tbl [:ref :form/r]] [:rec-limit :i64] [:rec-count :i64]]]
                                 :ie/r [:record :ie/r [[:type [:ref :form/r]] [:ctx [:ref :ie/ctx]]]]
                                 :ana/r [:record :ana/r [[:form [:ref :form/r]] [:aux [:ref :form/r]] [:n :i64]]]
                                 :ana/rl [:record :ana/rl [[:forms [:list [:ref :form/r]]] [:aux [:ref :form/r]] [:n :i64]]]
                                 :ana/g [:record :ana/g [[:ctx [:ref :ie/ctx]] [:a [:ref :form/r]] [:b [:ref :form/r]] [:c [:ref :form/r]] [:d [:ref :form/r]]]]
                                 :ana/ir [:record :ana/ir [[:ok :bool] [:val [:ref :form/r]] [:err [:ref :fe/err]]]]})))

;; forward references inside this module (the cut keeps the original form order)
#?(:kotoba nil :default
(declare ))


#?(:kotoba nil :default (def type-directed-numeric-heads tables/type-directed-numeric-heads))
#?(:kotoba nil :default (def float-negation-resolution tables/float-negation-resolution))

#?(:kotoba
   (defn heterogeneous-vector-slice-index! [index [:ref :form/r] item-types [:ref :form/r]
                                             form [:ref :form/r]] :i64
     (if (kotoba-integer? index)
       (let [host-index (form/int-value index)]
         (if (and (<= 0 host-index) (<= host-index (form/count-of item-types)))
           host-index
           (throw (fe-error "heterogeneous vector drop count must be in range"
                            "kotoba.error/hetero-vector-slice-index-range" form))))
       (throw (fe-error "heterogeneous vector drop count must be an integer literal"
                        "kotoba.error/hetero-vector-slice-index" form))))
   :default
(defn heterogeneous-vector-slice-index!
  "Return a host index for a compile-time heterogeneous-vector slice. Unlike
  an element index, the vector length itself is valid and denotes an empty
  suffix. Keeping this literal-only makes the resulting descriptor exact."
  [index item-types form]
  (when-not (kotoba-integer? index)
    (reject! "heterogeneous vector drop count must be an integer literal"
             form :kotoba.error/hetero-vector-slice-index))
  (let [host-index #?(:clj index
                      :cljs (if (i64/bigint-value? index) (js/Number index) index))]
    (when-not (and (integer? host-index) (<= 0 host-index)
                   (<= host-index (count item-types)))
      (reject! "heterogeneous vector drop count must be in range"
               form :kotoba.error/hetero-vector-slice-index-range))
    #?(:clj (long host-index) :cljs host-index))))

;; ---------------------------------------------------------------------------
;; Sequence heads on a `:document` (a dynamic EDN tree: the compiler's own forms,
;; HIR, policies). `first`/`rest`/`nth`/`keys`/`vals` on a document read its
;; run-time kind, so they need small recursive helpers, injected into a module
;; only when it uses documents (a module that does not lowers byte for byte as
;; before). Written directly in primitive form, like the other helpers.

#?(:kotoba
   (defn doc-nth-helper-name [] [:ref :form/r]
     (form/edn-form "__kotoba_doc_nth"))
   :default
(def doc-nth-helper-name '__kotoba_doc_nth))
#?(:kotoba
   (defn doc-rest-helper-name [] [:ref :form/r]
     (form/edn-form "__kotoba_doc_rest"))
   :default
(def doc-rest-helper-name '__kotoba_doc_rest))
#?(:kotoba
   (defn doc-keys-helper-name [] [:ref :form/r]
     (form/edn-form "__kotoba_doc_keys"))
   :default
(def doc-keys-helper-name '__kotoba_doc_keys))
#?(:kotoba
   (defn doc-vals-helper-name [] [:ref :form/r]
     (form/edn-form "__kotoba_doc_vals"))
   :default
(def doc-vals-helper-name '__kotoba_doc_vals))

;; ---------------------------------------------------------------------------
;; `count` / `nth` on the legacy i64 pair chain -- `list`, `cons`, `take`, a
;; variadic rest parameter. Monolith (a7ef280) 6376-6443, host route.
;; `__kotoba_list_count` is the "bounded pair-chain walk" `lang/guest-grammar.edn`
;; names for `count`; `__kotoba_list_drop` answers the chain from index N on --
;; 0, the empty chain, when N is negative or past the end -- so the `nth` arm
;; reads the item with `pair-first` and a default can be chosen without walking
;; twice. Each step costs one call of the run's fuel. Injected by the `count` /
;; `nth` arms' rewrites only when one writes a call, so a module that never
;; counts or indexes a chain is byte-identical.

#?(:kotoba nil :default
(defn- nonzero-integer-literal?
  "An integer literal other than 0: a value `count` / `nth` refuse as no pair
  chain at all. 0 IS one -- the empty chain `(list)` desugars to. Compared by
  digits, because a ClojureScript BigInt is not `zero?`."
  [form]
  (and (kotoba-integer? form) (not= "0" (str form)))))

#?(:kotoba nil :default (def list-count-helper-name '__kotoba_list_count))

#?(:kotoba nil :default
(def list-count-helper
  {:name list-count-helper-name
   :params '[xs]
   :param-types [:i64]
   :result :i64
   :effects #{}
   :body '(if (= xs 0)
            0
            (+ 1 (__kotoba_list_count (pair-second xs))))}))

#?(:kotoba nil :default
(defn uses-list-count? [form]
  (cond
    (seq? form) (or (= list-count-helper-name (first form))
                    (first-truthy uses-list-count? (rest form)))
    (coll? form) (first-truthy uses-list-count? form)
    :else false)))

#?(:kotoba nil :default (def list-drop-helper-name '__kotoba_list_drop))

#?(:kotoba nil :default
(def list-drop-helper
  {:name list-drop-helper-name
   :params '[xs n]
   :param-types [:i64 :i64]
   :result :i64
   :effects #{}
   :body '(if (< n 0)
            0
            (if (= xs 0)
              0
              (if (= n 0)
                xs
                (__kotoba_list_drop (pair-second xs) (- n 1)))))}))

#?(:kotoba nil :default
(defn uses-list-drop? [form]
  (cond
    (seq? form) (or (= list-drop-helper-name (first form))
                    (first-truthy uses-list-drop? (rest form)))
    (coll? form) (first-truthy uses-list-drop? form)
    :else false)))

;; ---------------------------------------------------------------------------
;; `match` -- the authority's `:bounded-control-and-sugar` sugar, whose safety
;; row reads `:single-evaluation-pure-desugar`.
;;
;; The scrutinee is bound ONCE, before any arm is tried, and every arm reads
;; that binding. That is the safety claim, not an optimization: a scrutinee is
;; an arbitrary expression, and a `match` that re-evaluated it per arm would
;; call a capability once per arm.
;;
;; What is admitted is deliberately small and is listed in `match-pattern-plan`
;; below. Everything outside it is refused by name rather than half-lowered:
;; a `match` that silently ignores a pattern it does not understand is worse
;; than one that does not exist.
;;
;; Refutability comes from two places and only two: an equality test against a
;; literal, and a key-presence test on a map. Presence is a real test -- `get`
;; on this profile's bounded map answers the default for an absent key, so a
;; map pattern lowered as projection alone would be irrefutable and every
;; `match` on a map would take its first arm.

#?(:kotoba
   (defn match-has-marker [] [:ref :form/r]
     (form/edn-form "__kotoba_match_has"))
   :default
(def match-has-marker '__kotoba_match_has))

;; the binary32 bit pattern of the f64 whose bits are B, or -1<<40 when the narrowing is not exact
#?(:kotoba
(defn rp-f32-bits-or-none [b :i64] :i64
  (let [n (f64-to-f32-rounded (f64-from-bits b))]
    (if (= (f64-to-bits (f32-to-f64-exact n)) b) (f32-to-bits n) -1099511627776)))
   :default nil)

#?(:kotoba
(defn rp-f64-nonfinite-text [b :i64] :string
  (if (= (bit-and b 9218868437227405312) 9218868437227405312)
    (if (= (bit-and b 4503599627370495) 0)
      (if (< b 0) "##-Inf" "##Inf")
      "##NaN")
    ""))
   :default nil)

#?(:kotoba
;; The binary32 bit pattern of a decimal literal written in an `:f32` context, or a refusal. B is the literal's f64 bits.
;; The inexact refusal prints the literal with the shortest round-trip decimal, which is not ported: it is refused as unported.
(defn f32-literal-bits! [b :i64 form [:ref :form/r]] :i64
  (let [nf (rp-f64-nonfinite-text b)
        _ (rp-fail (not (string=? nf ""))
                   (str "f32 literal must be a finite decimal: " nf " -- write (f32-from-bits <i32>) for a NaN or an infinity")
                   "kotoba.error/f32-literal-not-finite" form)
        r (rp-f32-bits-or-none b)
        _ (rp-fail (= r -1099511627776)
                   "f32 literal is not exactly representable in binary32 (unported: the literal is printed with the shortest round-trip decimal)"
                   "kotoba.fe/unported" form)]
    r))
   :default
(defn f32-literal-bits!
  "The binary32 bit pattern of a decimal literal written in an `:f32` context,
  or a refusal.

  A decimal literal reaches this compiler as a host binary64: the reader has
  already rounded, and the decimal text is gone. So there is no way to round
  decimal -> binary32 in one step, and decimal -> binary64 -> binary32 is not
  always the value decimal -> binary32 would have been. Double rounding is rare
  and it is silent, which is the worst combination.

  A literal is therefore admitted only when the binary64 the reader produced
  round-trips exactly through binary32. `1.5`, `0.5`, `2.0`, `16777216.0` are;
  `0.1` is not, and is refused rather than quietly becoming a number the author
  did not write. The explicit spellings for the rounding are
  `(f64-to-f32-rounded 0.1)` and `(f32-from-bits 0x3DCCCCCD)`, both of which say
  in the source that a narrowing happened.

  Same fail-closed discipline `lang/value-codec.edn` already applies at the wire
  (\"never two encodings for one source program\") rather than a second one.

  `##NaN` and the infinities get their own refusal, ahead of the narrowing and
  not folded into it. Two reasons, and the first is the one that matters: on the
  JVM `(float ##Inf)` THROWS `IllegalArgumentException: Value out of range for
  float`, so a shared guard evaluated in the same `let` raises a host exception
  with no `:phase` and no `:kotoba.error/code` before the check can run --
  measured, not supposed. The second is that \"narrow it explicitly\" is useless
  advice for a value that has no decimal form at all.

  Decided by kotoba-lang docs/adr/ADR-kotoba-floating-point-on-native.md."
  [form]
  (when-not #?(:clj (Double/isFinite (double form))
               :cljs (js/Number.isFinite form))
    (reject! (str "f32 literal must be a finite decimal: " (pr-str form)
                  " -- write (f32-from-bits <i32>) for a NaN or an infinity")
             form :kotoba.error/f32-literal-not-finite))
  (let [narrowed #?(:clj (float form) :cljs (js/Math.fround form))
        exact? #?(:clj (== (double narrowed) (double form))
                  :cljs (js/Object.is narrowed form))]
    (when-not exact?
      (reject! (str "f32 literal is not exactly representable in binary32: "
                    (pr-str form)
                    " -- write (f64-to-f32-rounded " (pr-str form)
                    ") to narrow it explicitly, or (f32-from-bits <i32>)")
               form :kotoba.error/f32-literal-inexact))
    (value/f32-to-i64-bits narrowed))))

#?(:kotoba
;; What the caller should write instead, for a receiver this friendly head does not answer; "" when nothing specific is known
(defn collection-head-advice [type [:ref :form/r]] :string
  (cond
    (typed-set-type? type)
    (str "A typed set answers to typed-set-count, typed-set-contains, "
         "typed-set-conj, typed-set-disj and typed-set-nth; conj and disj "
         "also reach it through the friendly surface")

    (canonical-typed-map-type? type)
    (str "A canonical typed map answers to typed-map-count, typed-map-get, "
         "typed-map-entry-at, typed-map-assoc and typed-map-dissoc; get, "
         "assoc, contains? and dissoc also reach it through the friendly "
         "surface")

    (rp-ty? type :map)
    (str "The legacy keyword-keyed bounded map answers to get and assoc and "
         "has no other primitive at all -- not count, not presence, not "
         "removal")

    (canonical-list-type? type)
    (str "A canonical [:list T] answers to vector-count -- which walks the "
         "list carrier, measured -- and to typed-list-nth; count and nth "
         "reach it through the friendly surface. It has no rear operation, "
         "so peek and pop do not reach it")

    (rp-ty? type :string)
    (str "A string has no element count in this profile: string-byte-length "
         "counts UTF-8 BYTES and string-code-unit-count counts UTF-16 code "
         "units, and naming either one count would give two different answers "
         "the same spelling (ADR 0353)")

    :else ""))
   :default
(defn collection-head-advice
  "What the caller should write instead, for a receiver this friendly head does
  not answer.

  A refusal that only reports a type mismatch reads as a defect in the
  caller's program. Measured 2026-09-03 against sema `df383ba0`:
  `(first [7 8 9])` was refused `expression type mismatch: expected i64, got
  vector-i64`, because `first` desugars to `pair-first` and the pair
  accessors are declared over the legacy i64 pair chain -- so the reader was
  told their vector was the wrong type for an operation whose Clojure meaning
  it satisfies exactly. The same shape as `contains?` on a set before
  2026-09-03, one level worse: `operation has no admitted lowering` at least
  names the operation.

  Returns a sentence, or nil when nothing specific is known -- nil means the
  generic refusal is the honest one, not that the receiver is fine."
  [type]
  (cond
    (typed-set-type? type)
    (str "A typed set answers to typed-set-count, typed-set-contains, "
         "typed-set-conj, typed-set-disj and typed-set-nth; conj and disj "
         "also reach it through the friendly surface")

    (canonical-typed-map-type? type)
    (str "A canonical typed map answers to typed-map-count, typed-map-get, "
         "typed-map-entry-at, typed-map-assoc and typed-map-dissoc; get, "
         "assoc, contains? and dissoc also reach it through the friendly "
         "surface")

    (= :map type)
    (str "The legacy keyword-keyed bounded map answers to get and assoc and "
         "has no other primitive at all -- not count, not presence, not "
         "removal")

    (canonical-list-type? type)
    (str "A canonical [:list T] answers to vector-count -- which walks the "
         "list carrier, measured -- and to typed-list-nth; count and nth "
         "reach it through the friendly surface. It has no rear operation, "
         "so peek and pop do not reach it")

    (= :string type)
    (str "A string has no element count in this profile: string-byte-length "
         "counts UTF-8 BYTES and string-code-unit-count counts UTF-16 code "
         "units, and naming either one count would give two different answers "
         "the same spelling (ADR 0353)")

    :else nil)))

#?(:kotoba
(defn rp-row-op-fields [g [:ref :ana/g] op [:ref :form/r] args [:ref :form/r] types [:ref :form/r] locals [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
  (record-get [:ref :ie/r] (row-op-fields (rp-g-ctx g) op args types locals (rp-g-sigs g) form) :type))
   :default nil)

;; the record descriptor TYPE is (a declared `[:ref ..]` resolved), or nil
#?(:kotoba
(defn rp-row-op-record [g [:ref :ana/g] type [:ref :form/r]] [:ref :form/r]
  (row-op-record type (ctx-schemas (rp-g-ctx g)) (ctx-row-schemas (rp-g-ctx g))))
   :default nil)

;; (reduce (fn [acc [key value]] (list 'record-assoc record acc key value)) first (partition 2 pairs))
#?(:kotoba
(defn rp-assoc-fold [record [:ref :form/r] acc [:ref :form/r] args [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= (+ i 1) (form/count-of args))
    acc
    (rp-assoc-fold record (rp-seq4 "record-assoc" record acc (form/nth-of args i) (form/nth-of args (+ i 1))) args (+ i 2))))
   :default nil)

;; record field k -> (record-get record local k), for the fields of RECORD
#?(:kotoba
(defn rp-projected [record [:ref :form/r] local [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (let [fields (form/nth-of record 2)]
    (if (>= i (form/count-of fields))
      acc
      (let [k (form/nth-of (form/nth-of fields i) 0)]
        (rp-projected record local (+ i 1) (form/assoc-form acc k (rp-seq3 "record-get" record local k)))))))
   :default nil)

#?(:kotoba
(defn rp-merge-maps [a [:ref :form/r] b [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= (+ i 1) (form/count-of b))
    a
    (rp-merge-maps (form/assoc-form a (form/nth-of b i) (form/nth-of b (+ i 1))) b (+ i 2))))
   :default nil)

;; state of the binding walk: {:bindings [..] :sources {k expr}} and the counter
#?(:kotoba
(defn rp-bs [bindings [:ref :form/r] sources [:ref :form/r] n :i64] [:ref :ana/r]
  (record-new [:ref :ana/r] bindings sources n))
   :default nil)

#?(:kotoba
(defn rp-bs-bindings [b [:ref :ana/r]] [:ref :form/r] (record-get [:ref :ana/r] b :form))
   :default nil)

#?(:kotoba
(defn rp-bs-sources [b [:ref :ana/r]] [:ref :form/r] (record-get [:ref :ana/r] b :aux))
   :default nil)

#?(:kotoba
(defn rp-bs-n [b [:ref :ana/r]] :i64 (record-get [:ref :ana/r] b :n))
   :default nil)

#?(:kotoba
(defn rp-bind-entries [entries [:ref :form/r] i :i64 bs [:ref :ana/r]] [:ref :ana/r]
  (if (>= i (form/count-of entries))
    bs
    (let [entry (form/nth-of entries i)
          local (rp-synth "row_value" (rp-bs-n bs))
          sym (rp-r-form local)]
      (rp-bind-entries entries (+ i 1)
                       (rp-bs (form/form-vec (form/append-form (form/append-form (form/kids-of (rp-bs-bindings bs)) sym) (form/nth-of entry 1)))
                              (form/assoc-form (rp-bs-sources bs) (form/nth-of entry 0) sym)
                              (rp-r-n local))))))
   :default nil)

;; one operand: a (key value) pair of map-assoc, a literal map's entries, or another record
#?(:kotoba
(defn rp-operand [g [:ref :ana/g] op [:ref :form/r] arg [:ref :form/r] type [:ref :form/r] bs [:ref :ana/r]] [:ref :ana/r]
  (cond
    (rp-sym-is? op "map-assoc")
    (let [local (rp-synth "row_value" (rp-bs-n bs))
          sym (rp-r-form local)]
      (rp-bs (form/form-vec (form/append-form (form/append-form (form/kids-of (rp-bs-bindings bs)) sym) (form/nth-of arg 1)))
             (form/assoc-form (rp-bs-sources bs) (form/nth-of arg 0) sym)
             (rp-r-n local)))
    (not (form/is-nil? (row-op-literal-entries arg)))
    (rp-bind-entries (row-op-literal-entries arg) 0 bs)
    :else
    (let [local (rp-synth "row_operand" (rp-bs-n bs))
          sym (rp-r-form local)]
      (rp-bs (form/form-vec (form/append-form (form/append-form (form/kids-of (rp-bs-bindings bs)) sym) arg))
             (rp-merge-maps (rp-bs-sources bs) (rp-projected (rp-row-op-record g type) sym 0 (rp-empty-map)) 0)
             (rp-r-n local)))))
   :default nil)

#?(:kotoba
(defn rp-empty-map [] [:ref :form/r]
  (form/form-map (form/no-forms)))
   :default nil)

;; the operands of a row operation as (arg, type) pairs: (key value) pairs of map-assoc, (operand, type) of merge, none otherwise
#?(:kotoba
(defn rp-operands [op [:ref :form/r] args [:ref :form/r] types [:ref :form/r]] [:ref :form/r]
  (cond
    (rp-sym-is? op "map-assoc") (rp-pairs-of args 1 types (form/no-forms))
    (rp-sym-is? op "merge") (rp-zip-from args types 1 (form/no-forms))
    :else (form/form-vec (form/no-forms))))
   :default nil)

#?(:kotoba
(defn rp-pairs-of [args [:ref :form/r] i :i64 types [:ref :form/r] acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= (+ i 1) (form/count-of args))
    (form/form-vec acc)
    (rp-pairs-of args (+ i 2) types
                 (form/append-form acc (form/vec2 (form/vec2 (form/nth-of args i) (form/nth-of args (+ i 1))) (form/nil-form))))))
   :default nil)

#?(:kotoba
(defn rp-zip-from [args [:ref :form/r] types [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (or (>= i (form/count-of args)) (>= i (form/count-of types)))
    (form/form-vec acc)
    (rp-zip-from args types (+ i 1) (form/append-form acc (form/vec2 (form/nth-of args i) (form/nth-of types i))))))
   :default nil)

#?(:kotoba
(defn rp-fold-operands [g [:ref :ana/g] op [:ref :form/r] operands [:ref :form/r] i :i64 bs [:ref :ana/r]] [:ref :ana/r]
  (if (>= i (form/count-of operands))
    bs
    (let [pair (form/nth-of operands i)]
      (rp-fold-operands g op operands (+ i 1) (rp-operand g op (form/nth-of pair 0) (form/nth-of pair 1) bs)))))
   :default nil)

#?(:kotoba
(defn rp-result-sources [result-fields [:ref :form/r] sources [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of result-fields))
    acc
    (rp-result-sources result-fields sources (+ i 1)
                       (form/append-form acc (form/form-get sources (form/nth-of (form/nth-of result-fields i) 0))))))
   :default nil)

#?(:kotoba
;; `(op receiver ...)` on a record, as record-new / record-get / record-assoc. Every operand is bound in source order before the
;; record is built. Answers the form and the counter.
(defn row-op-elaborate [g [:ref :ana/g] op [:ref :form/r] args [:ref :form/r] types [:ref :form/r] locals [:ref :form/r] n :i64 form [:ref :form/r]] [:ref :ana/r]
  (let [receiver-type (form/nth-of types 0)
        record (rp-row-op-record g receiver-type)
        fields (rp-row-op-fields g op args types locals form)
        result-type (row-op-result-type receiver-type fields (ctx-schemas (rp-g-ctx g)) (ctx-row-schemas (rp-g-ctx g)))]
    (if (and (rp-sym-is? op "map-assoc") (form/eq result-type receiver-type))
      (rp-r (rp-assoc-fold record (form/nth-of args 0) args 1) n)
      (let [result (rp-row-op-record g result-type)
            recv (rp-synth "row_receiver" n)
            receiver (rp-r-form recv)
            start (rp-bs (form/form-vec (form/two-forms receiver (form/nth-of args 0)))
                         (rp-projected record receiver 0 (rp-empty-map))
                         (rp-r-n recv))
            done (rp-fold-operands g op (rp-operands op args types) 0 start)
            values (rp-result-sources (form/nth-of result 2) (rp-bs-sources done) 0 (form/no-forms))]
        (rp-r (rp-seq2 "let" (rp-bs-bindings done)
                       (form/form-seq (form/cons-onto (form/symbol-form "record-new") (form/cons-onto result values))))
              (rp-bs-n done))))))
   :default
(defn row-op-elaborate
  "`(op receiver ...)` on a record, as record-new / record-get / record-assoc.
  Every operand is bound in source order before the record is built."
  [op args types locals signatures form]
  (let [receiver-type (first types)
        record (row-op-record receiver-type)
        result-type (row-op-result-type
                     receiver-type (row-op-fields op args types locals signatures form))]
    (if (and (= op 'map-assoc) (= result-type receiver-type))
      (reduce (fn [acc [key value]] (list 'record-assoc record acc key value))
              (first args) (partition 2 (rest args)))
      (let [result (row-op-record result-type)
            receiver (synthetic "row_receiver")
            projected (fn [record local]
                        (into {} (map (fn [[k _]] [k (list 'record-get record local k)]))
                              (nth record 2)))
            [bindings sources]
            (reduce (fn [[bindings sources] [arg type]]
                      (cond
                        (= op 'map-assoc)
                        (let [local (synthetic "row_value")]
                          [(conj bindings local (second arg)) (assoc sources (first arg) local)])
                        (row-op-literal-entries arg)
                        (reduce (fn [[bindings sources] [k v]]
                                  (let [local (synthetic "row_value")]
                                    [(conj bindings local v) (assoc sources k local)]))
                                [bindings sources] (row-op-literal-entries arg))
                        :else
                        (let [local (synthetic "row_operand")]
                          [(conj bindings local arg)
                           (merge sources (projected (row-op-record type) local))])))
                    [[receiver (first args)] (projected record receiver)]
                    (case op
                      map-assoc (map (fn [pair] [(vec pair) nil]) (partition 2 (rest args)))
                      merge (map vector (rest args) (rest types))
                      []))]
        (list 'let bindings
              (list* 'record-new result (map (fn [[k _]] (get sources k)) (nth result 2)))))))))

#?(:kotoba
(defn rp-arg-types [g [:ref :ana/g] args [:ref :form/r] i :i64 locals [:ref :form/r] acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of args))
    (form/form-vec acc)
    (let [t (rp-infer g (form/nth-of args i) locals)]
      (rp-arg-types g args (+ i 1) locals (form/append-form acc t)))))
   :default nil)

#?(:kotoba
(defn row-op-rewrite [g [:ref :ana/g] op [:ref :form/r] args [:ref :form/r] locals [:ref :form/r] n :i64 form [:ref :form/r]] [:ref :ana/r]
  (let [types (rp-arg-types g args 0 locals (form/no-forms))]
    (row-op-elaborate g op args types locals n form)))
   :default
(defn row-op-rewrite [op args locals signatures form]
  (row-op-elaborate op args (mapv #(infer-expression-type % locals signatures) args)
                    locals signatures form)))

#?(:kotoba nil :default (def library-predicate-document-kinds tables/library-predicate-document-kinds))

#?(:kotoba
;; FORM as a `:document` expression, for the Clojure heads applied to a document receiver
(defn as-document-form [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r]] [:ref :form/r]
  (let [t (rp-infer-or-nil g form locals)]
    (cond
      (rp-ty? t :document) form
      (and (not (form/is-nil? t)) (form/form-has? (tables/document-of-constructors) t))
      (form/form-seq (form/two-forms (form/form-get (tables/document-of-constructors) t) form))
      :else form)))
   :default
(defn as-document-form
  "FORM as a `:document` expression, for the Clojure heads (`assoc`, `get` with a
  default, ...) applied to a document receiver. A document stays as it is; a
  scalar is wrapped in its document constructor. Anything else is left alone so
  the type checker reports the mismatch at the operand."
  [form locals signatures]
  (let [t (try (infer-expression-type form locals signatures)
               (catch #?(:clj Exception :cljs :default) _ nil))]
    (cond
      (= :document t) form
      (contains? document-of-constructors t)
      (list (get document-of-constructors t) form)
      :else form))))

#?(:kotoba
;; A document map key: a keyword or a document; a string key becomes a document string
(defn as-document-key [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r]] [:ref :form/r]
  (let [t (rp-infer-or-nil g form locals)]
    (if (or (rp-ty? t :keyword) (rp-ty? t :document))
      form
      (as-document-form g form locals))))
   :default
(defn as-document-key
  "A document map key: a keyword or a document, as `document-get` and friends
  require. A string key becomes a document string."
  [form locals signatures]
  (let [t (try (infer-expression-type form locals signatures)
               (catch #?(:clj Exception :cljs :default) _ nil))]
    (if (contains? #{:keyword :document} t)
      form
      (as-document-form form locals signatures)))))

;; (reduce ... false (reverse (sort kinds))): the nested ifs, the greatest kind outermost
#?(:kotoba
(defn rp-kind-tests [tmp [:ref :form/r] kinds [:list [:ref :form/r]] i :i64 else [:ref :form/r]] [:ref :form/r]
  (if (>= i (vector-count kinds))
    else
    (let [kind (fl-nth kinds i)
          test (rp-seq2 "=" (rp-seq1 "document-kind" tmp) kind)]
      (rp-kind-tests tmp kinds (+ i 1) (rp-seq3 "if" test (form/bool-form true) else)))))
   :default nil)

#?(:kotoba
(defn rp-sort-kinds-desc [xs [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of xs))
    acc
    (rp-sort-kinds-desc xs (+ i 1) (rp-insert-desc acc (form/nth-of xs i) 0))))
   :default nil)

#?(:kotoba
(defn rp-insert-desc [xs [:list [:ref :form/r]] x [:ref :form/r] i :i64] [:list [:ref :form/r]]
  (if (or (>= i (vector-count xs)) (< (string-compare (form-text (fl-nth xs i)) (form-text x)) 0))
    (fl-slice xs i (vector-count xs) (form/append-form (fl-slice xs 0 i (form/no-forms)) x))
    (rp-insert-desc xs x (+ i 1))))
   :default nil)

#?(:kotoba
;; The `:bool` form asking OP of the document bound to TMP.
(defn library-predicate-document-test [op [:ref :form/r] tmp [:ref :form/r]] [:ref :form/r]
  (cond
    (rp-sym-is? op "true?")
    (rp-seq3 "option-value-of" (form/vec2 (rp-tk :option) (rp-tk :bool)) (rp-seq1 "document-bool-value" tmp) (form/bool-form false))
    (rp-sym-is? op "false?")
    (rp-seq1 "bool-not" (rp-seq3 "option-value-of" (form/vec2 (rp-tk :option) (rp-tk :bool)) (rp-seq1 "document-bool-value" tmp) (form/bool-form true)))
    :else
    (let [kinds (form/form-get (tables/library-predicate-document-kinds) op)]
      (rp-kind-tests tmp (rp-sort-kinds-desc kinds 0 (form/no-forms)) 0 (form/bool-form false)))))
   :default
(defn library-predicate-document-test
  "The `:bool` form asking OP of the document bound to TMP."
  [op tmp]
  (let [kinds (get library-predicate-document-kinds op)
        kind-test (fn [kind] (list '= (list 'document-kind tmp) kind))]
    (case op
      ;; document-bool-value is [:option :bool], absent unless the node is a
      ;; bool, so the payload with the right fallback is the whole answer.
      true? (list 'option-value-of [:option :bool] (list 'document-bool-value tmp) false)
      false? (list 'bool-not (list 'option-value-of [:option :bool]
                                   (list 'document-bool-value tmp) true))
      (reduce (fn [else kind] (list 'if (kind-test kind) true else))
              false (reverse (sort kinds)))))))

#?(:kotoba nil :default
(def ^:dynamic *record-protocol-dispatch* {}))

#?(:kotoba
(defn rp-sym-is? [f [:ref :form/r] name :string] :bool
  (and (form/is-symbol? f) (string=? (form/symbol-value f) name)))
   :default nil)

#?(:kotoba
(defn rp-kw-is? [f [:ref :form/r] k :keyword] :bool
  (and (form/is-keyword? f) (= (form/keyword-value f) k)))
   :default nil)

#?(:kotoba
(defn rp-error [msg :string code :string form [:ref :form/r]] [:ref :fe/err]
  (record-new [:ref :fe/err] msg code form "subset" (form/nil-form)))
   :default nil)

#?(:kotoba
(defn rp-fail [bad? :bool msg :string code :string form [:ref :form/r]] :i64
  (if bad? (throw (rp-error msg code form)) 0))
   :default nil)

#?(:kotoba
(defn rp-set-has? [s [:ref :form/r] x [:ref :form/r]] :bool
  (fl-has? (form/kids-of s) x 0))
   :default nil)

#?(:kotoba
(defn rp-seq1 [head :string a [:ref :form/r]] [:ref :form/r]
  (form/form-seq (form/two-forms (form/symbol-form head) a)))
   :default nil)

#?(:kotoba
(defn rp-seq2 [head :string a [:ref :form/r] b [:ref :form/r]] [:ref :form/r]
  (form/form-seq (form/three-forms (form/symbol-form head) a b)))
   :default nil)

#?(:kotoba
(defn rp-seq3 [head :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r]] [:ref :form/r]
  (form/form-seq (form/append-form (form/three-forms (form/symbol-form head) a b) c)))
   :default nil)

#?(:kotoba
(defn rp-seq4 [head :string a [:ref :form/r] b [:ref :form/r] c [:ref :form/r] d [:ref :form/r]] [:ref :form/r]
  (form/form-seq (form/append-form (form/append-form (form/three-forms (form/symbol-form head) a b) c) d)))
   :default nil)

;; a type-keyword Form `:i64`
#?(:kotoba
(defn rp-tk [k :keyword] [:ref :form/r]
  (form/keyword-form k))
   :default nil)

#?(:kotoba
(defn rp-ty? [t [:ref :form/r] k :keyword] :bool
  (form/eq t (form/keyword-form k)))
   :default nil)

#?(:kotoba
(defn rp-r [form [:ref :form/r] n :i64] [:ref :ana/r]
  (record-new [:ref :ana/r] form (form/nil-form) n))
   :default nil)

#?(:kotoba
(defn rp-r-form [r [:ref :ana/r]] [:ref :form/r] (record-get [:ref :ana/r] r :form))
   :default nil)

#?(:kotoba
(defn rp-r-n [r [:ref :ana/r]] :i64 (record-get [:ref :ana/r] r :n))
   :default nil)

#?(:kotoba
(defn rp-rl [forms [:list [:ref :form/r]] n :i64] [:ref :ana/rl]
  (record-new [:ref :ana/rl] forms (form/nil-form) n))
   :default nil)

#?(:kotoba
(defn rp-rl-forms [r [:ref :ana/rl]] [:list [:ref :form/r]] (record-get [:ref :ana/rl] r :forms))
   :default nil)

#?(:kotoba
(defn rp-rl-n [r [:ref :ana/rl]] :i64 (record-get [:ref :ana/rl] r :n))
   :default nil)

;; the bundle: the inference context, the signature table, the schema table, the record-protocol dispatch table
#?(:kotoba
(defn rp-g [ctx [:ref :ie/ctx] sigs [:ref :form/r] schemas [:ref :form/r] dispatch [:ref :form/r]] [:ref :ana/g]
  (record-new [:ref :ana/g] ctx sigs schemas dispatch (rp-tables)))
   :default nil)

;; the operation tables the dispatch tests, parsed once per walk
#?(:kotoba
(defn rp-tables [] [:ref :form/r]
  (form/assoc-form
   (form/assoc-form
    (form/assoc-form
     (form/assoc-form
      (form/assoc-form
       (form/assoc-form (form/form-map (form/no-forms)) (form/keyword-form :set-ops) (tables/set-operations))
       (form/keyword-form :count-ops) (tables/collection-count-operations))
      (form/keyword-form :vec-end) (tables/vector-end-operations))
     (form/keyword-form :map-proj) (tables/map-projection-operations))
    (form/keyword-form :lib-pred) (tables/library-predicate-heads))
   (form/keyword-form :numeric) (tables/type-directed-numeric-heads)))
   :default nil)

#?(:kotoba
(defn rp-g-tbl [g [:ref :ana/g] k :keyword] [:ref :form/r]
  (form/form-get (record-get [:ref :ana/g] g :d) (form/keyword-form k)))
   :default nil)

#?(:kotoba
(defn rp-g-ctx [g [:ref :ana/g]] [:ref :ie/ctx] (record-get [:ref :ana/g] g :ctx))
   :default nil)

#?(:kotoba
(defn rp-g-sigs [g [:ref :ana/g]] [:ref :form/r] (record-get [:ref :ana/g] g :a))
   :default nil)

#?(:kotoba
(defn rp-g-schemas [g [:ref :ana/g]] [:ref :form/r] (record-get [:ref :ana/g] g :b))
   :default nil)

#?(:kotoba
(defn rp-g-dispatch [g [:ref :ana/g]] [:ref :form/r] (record-get [:ref :ana/g] g :c))
   :default nil)

;; the next synthetic symbol `__kotoba_<prefix>_<n+1>`
#?(:kotoba
(defn rp-synth [prefix :string n :i64] [:ref :ana/r]
  (rp-r (form/symbol-form (str "__kotoba_" prefix "_" (string-from-i64 (+ n 1)))) (+ n 1)))
   :default nil)

#?(:kotoba
(defn rp-infer-or-nil [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r]] [:ref :form/r]
  (infer-type-or-nil (rp-g-ctx g) form locals (rp-g-sigs g)))
   :default nil)

;; the type of the only argument when there is exactly one, else nil (the `if` is hoisted: an aborting branch cannot be a `let` value)
#?(:kotoba
(defn rp-infer-single [g [:ref :ana/g] args [:ref :form/r] locals [:ref :form/r]] [:ref :form/r]
  (if (= 1 (form/count-of args)) (rp-infer g (form/nth-of args 0) locals) (form/nil-form)))
   :default nil)

;; the type of FORM; a refusal propagates
#?(:kotoba
(defn rp-infer [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r]] [:ref :form/r]
  (record-get [:ref :ie/r] (infer-expression-type (rp-g-ctx g) form locals (rp-g-sigs g)) :type))
   :default nil)

#?(:kotoba
;; The closed `(f64-from-bits <integer>)` shape a decimal literal has after desugar
(defn f64-bits-literal-form? [form [:ref :form/r]] :bool
  (and (form/is-seq? form) (= 2 (form/count-of form))
       (rp-sym-is? (form/nth-of form 0) "f64-from-bits")
       (kotoba-integer? (form/nth-of form 1))))
   :default
(defn f64-bits-literal-form?
  "The closed `(f64-from-bits <integer>)` shape a decimal literal has after
  desugar (and straight out of the JVM-free reader)."
  [form]
  (and (seq? form)
       (= 'f64-from-bits (first form))
       (= 2 (count form))
       (kotoba-integer? (second form)))))

;; Lower the plain operator OP on OPERANDS that all have FLOAT-TYPE to the typed operation
#?(:kotoba
(defn rp-fold-float-form [typed [:ref :form/r] acc [:ref :form/r] operands [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of operands))
    acc
    (rp-fold-float-form typed (form/form-seq (form/three-forms typed acc (form/nth-of operands i))) operands (+ i 1))))
   :default nil)

#?(:kotoba
(defn resolve-float-operator [op [:ref :form/r] float-type [:ref :form/r] operands [:ref :form/r]] [:ref :form/r]
  (let [typed (form/form-get (form/form-get (tables/float-arithmetic-resolution) float-type) op)
        arity (form/count-of operands)
        negation (form/form-get (tables/float-negation-resolution) float-type)]
    (cond
      (and (rp-sym-is? op "-") (= 1 arity))
      (form/form-seq (form/two-forms negation (form/nth-of operands 0)))

      (and (or (rp-sym-is? op "+") (rp-sym-is? op "*")) (= 1 arity))
      (form/nth-of operands 0)

      (or (rp-sym-is? op "+") (rp-sym-is? op "-") (rp-sym-is? op "*"))
      (rp-fold-float-form typed (form/nth-of operands 0) operands 1)

      (= 2 arity)
      (form/form-seq (form/three-forms typed (form/nth-of operands 0) (form/nth-of operands 1)))

      :else (form/form-seq (form/cons-onto op (form/kids-of operands))))))
   :default
(defn resolve-float-operator
  "Lower the plain operator OP on OPERANDS that all have FLOAT-TYPE to the
  typed operation. Arities mirror the i64 reading KIR gives the plain form:
  unary `-` negates, unary `+`/`*` is the operand, n-ary `+ - *` fold left.
  `/` and the comparisons are binary; any other arity is left for validation
  to reject with the plain operator's own arity message."
  [op float-type operands]
  (let [typed (get-in float-arithmetic-resolution [float-type op])
        arity (count operands)]
    (cond
      (and (= op '-) (= 1 arity))
      (list (get float-negation-resolution float-type) (first operands))

      (and (contains? '#{+ *} op) (= 1 arity))
      (first operands)

      (contains? '#{+ - *} op)
      (reduce (fn [acc operand] (list typed acc operand))
              (first operands) (rest operands))

      (= 2 arity)
      (list typed (first operands) (second operands))

      :else (cons op operands)))))

#?(:kotoba
;; TEST as a `:bool` presence test when its type is an option, else TEST
(defn option-presence-test [test [:ref :form/r] test-type [:ref :form/r]] [:ref :form/r]
  (cond
    (option-vector-type? test-type) (rp-seq2 "option-some?-of" test-type test)
    (rp-ty? test-type :option-i64) (rp-seq1 "option-some?" test)
    :else test))
   :default
(defn option-presence-test
  "TEST as a `:bool` presence test when its type is an option, else TEST."
  [test test-type]
  (cond
    (option-vector-type? test-type) (list 'option-some?-of test-type test)
    (= :option-i64 test-type) (list 'option-some? test)
    :else test)))

#?(:kotoba
(defn rp-default-or-fail [type [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
  (let [d (closure-default-value-expr (form/nth-of type 1))]
    (if (form/is-nil? d)
      (throw (rp-error (str "an absent " (pr-form type) " has no payload "
                            "inhabitant to stand in the unreachable branch; bind "
                            "it with option-match instead")
                       "kotoba.error/option-type-unresolved" form))
      d)))
   :default nil)

#?(:kotoba
;; The payload of VALUE when its type is an option (only reached under a presence test), else VALUE
(defn option-present-value [value [:ref :form/r] value-type [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
  (cond
    (option-vector-type? value-type)
    (let [d (rp-default-or-fail value-type form)]
      (rp-seq3 "option-value-of" value-type value d))
    (rp-ty? value-type :option-i64) (rp-seq2 "option-value" value (form/int-form 0))
    :else value))
   :default
(defn option-present-value
  "The payload of VALUE when its type is an option (only reached under a
  presence test, so the fallback is never the answer), else VALUE."
  [value value-type form]
  (cond
    (option-vector-type? value-type)
    (list 'option-value-of value-type value
          (or (closure-default-value-expr (second value-type))
              (reject! (str "an absent " (pr-str value-type) " has no payload "
                            "inhabitant to stand in the unreachable branch; bind "
                            "it with option-match instead")
                       form :kotoba.error/option-type-unresolved)))
    (= :option-i64 value-type) (list 'option-value value 0)
    :else value)))

;; the one body of a `let` (base's `let-body`)
#?(:kotoba
(defn rp-let-body [form [:ref :form/r]] [:ref :form/r]
  (let [n (- (form/count-of form) 1)
        bodies (if (> n 0) (- n 1) 0)
        _ (rp-fail (not (= bodies 1))
                   (str "let requires one result expression; got " (string-from-i64 bodies) " (sequence with `do`)")
                   "kotoba.error/let-body-multiple-forms" form)]
    (form/nth-of form 2)))
   :default nil)

;; the rewritten kids of FORM from I on, appended to ACC
#?(:kotoba
(defn rp-rw-kids [g [:ref :ana/g] form [:ref :form/r] i :i64 locals [:ref :form/r] n :i64 acc [:list [:ref :form/r]]] [:ref :ana/rl]
  (if (>= i (form/count-of form))
    (rp-rl acc n)
    (let [r (rp-rewrite g (form/nth-of form i) locals n)]
      (rp-rw-kids g form (+ i 1) locals (rp-r-n r) (form/append-form acc (rp-r-form r))))))
   :default nil)

;; the arguments of FORM rewritten, as a Form vector and the counter
#?(:kotoba
(defn rp-rw-args [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/rl]
  (rp-rw-kids g form 1 locals n (form/no-forms)))
   :default nil)

#?(:kotoba
(defn rp-args-vec [rl [:ref :ana/rl]] [:ref :form/r]
  (form/form-vec (rp-rl-forms rl)))
   :default nil)

;; (cons op rewritten-args)
#?(:kotoba
(defn rp-op-call [op [:ref :form/r] args [:ref :form/r]] [:ref :form/r]
  (form/form-seq (form/cons-onto op (form/kids-of args))))
   :default nil)

#?(:kotoba
(defn rp-schema-get [schemas [:ref :form/r] t [:ref :form/r]] [:ref :form/r]
  (form/form-get schemas (form/nth-of t 1)))
   :default nil)

;; a schema reference resolved through the closed table, else the type itself
#?(:kotoba
(defn rp-descriptor [g [:ref :ana/g] t [:ref :form/r]] [:ref :form/r]
  (if (schema-ref-type? t) (rp-schema-get (rp-g-schemas g) t) t))
   :default nil)

#?(:kotoba
(defn rp-let-pairs [g [:ref :ana/g] bindings [:ref :form/r] i :i64 locals [:ref :form/r] n :i64 out [:list [:ref :form/r]]] [:ref :ana/r]
  (if (>= (+ i 1) (form/count-of bindings))
    (record-new [:ref :ana/r] (form/form-vec out) locals n)
    (let [nm (form/nth-of bindings i)
          r (rp-rewrite g (form/nth-of bindings (+ i 1)) locals n)
          v (rp-r-form r)]
      (rp-let-pairs g bindings (+ i 2) (form/assoc-form locals nm (rp-infer-or-nil g v locals)) (rp-r-n r)
                    (form/append-form (form/append-form out nm) v)))))
   :default nil)

#?(:kotoba
(defn rp-arm-let [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [bindings (form/nth-of form 1)
        body (rp-let-body form)
        ls (rp-let-pairs g bindings 0 locals n (form/no-forms))
        rb (rp-rewrite g body (record-get [:ref :ana/r] ls :aux) (record-get [:ref :ana/r] ls :n))]
    (rp-r (rp-seq2 "let" (record-get [:ref :ana/r] ls :form) (rp-r-form rb)) (rp-r-n rb))))
   :default nil)

;; resolve-absence-if does not abort (it answers the form it was given when it cannot decide)
#?(:kotoba
(defn rp-resolve-absence [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r]] [:ref :form/r]
  (resolve-absence-if (rp-g-ctx g) form locals (rp-g-sigs g) false))
   :default nil)

#?(:kotoba
(defn rp-arm-if [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        args (rp-args-vec rl)
        test (form/nth-of args 0)
        test-type (rp-infer-or-nil g test locals)
        presence (option-presence-test test test-type)
        branches (fdrop args 1)
        rebuilt (form/form-seq (form/cons-onto (form/symbol-form "if") (form/cons-onto presence branches)))
        resolved (rp-resolve-absence g rebuilt locals)]
    (rp-r resolved (rp-rl-n rl))))
   :default nil)

#?(:kotoba
(defn rp-arm-present [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [r (rp-rewrite g (form/nth-of form 1) locals n)
        value (rp-r-form r)
        value-type (rp-infer-or-nil g value locals)
        out (option-present-value value value-type form)]
    (rp-r out (rp-r-n r))))
   :default nil)

#?(:kotoba
(defn rp-some-last-form [value [:ref :form/r] value-type [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
  (cond
    (or (option-vector-type? value-type) (rp-ty? value-type :option-i64)) value
    (form/is-nil? value-type)
    (throw (rp-error "some-> step has no inferable type, so its result cannot be made an option" "kotoba.error/option-type-unresolved" form))
    :else (rp-seq2 "option-some-of" (form/vec2 (rp-tk :option) value-type) value)))
   :default nil)

#?(:kotoba
(defn rp-arm-some-last [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [r (rp-rewrite g (form/nth-of form 1) locals n)
        value (rp-r-form r)
        value-type (rp-infer-or-nil g value locals)
        out (rp-some-last-form value value-type form)]
    (rp-r out (rp-r-n r))))
   :default nil)

#?(:kotoba
(defn rp-none-of [body-type [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
  (cond
    (option-vector-type? body-type) (rp-seq1 "option-none-of" body-type)
    (rp-ty? body-type :option-i64) (form/form-seq (form/one-form (form/symbol-form "option-none")))
    :else (throw (rp-error "some-> result has no option type" "kotoba.error/option-type-unresolved" form))))
   :default nil)

#?(:kotoba
(defn rp-arm-some-bind [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [tmp (form/nth-of form 1)
        r (rp-rewrite g (form/nth-of form 2) locals n)
        body (rp-r-form r)
        tmp-type (form/form-get locals tmp)
        body-type (rp-infer-or-nil g body locals)]
    (if (or (option-vector-type? tmp-type) (rp-ty? tmp-type :option-i64))
      (let [none (rp-none-of body-type form)]
        (rp-r (rp-seq3 "if" (option-presence-test tmp tmp-type) body none) (rp-r-n r)))
      (rp-r body (rp-r-n r)))))
   :default nil)

#?(:kotoba
(defn rp-arm-option-or [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rv (rp-rewrite g (form/nth-of form 1) locals n)
        rf (rp-rewrite g (form/nth-of form 2) locals (rp-r-n rv))
        value (rp-r-form rv)
        fallback (rp-r-form rf)
        option-type (rp-infer g value locals)
        _ (rp-fail (not (and (form/is-vec? option-type) (= 2 (form/count-of option-type)) (rp-kw-is? (form/nth-of option-type 0) :option)))
                   (str "option-or requires an option value; got " (pr-form option-type))
                   "kotoba.error/option-type-unresolved" form)]
    (rp-r (rp-seq3 "option-value-of" option-type value fallback) (rp-r-n rf))))
   :default nil)

#?(:kotoba
(defn rp-document-null-test [tmp [:ref :form/r]] [:ref :form/r]
  (rp-seq1 "bool-not" (rp-seq2 "=" (rp-seq1 "document-kind" tmp) (form/keyword-form :null))))
   :default nil)

#?(:kotoba
(defn rp-arm-option-some [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [r (rp-rewrite g (form/nth-of form 1) locals n)
        value (rp-r-form r)
        option-type (rp-infer-or-nil g value locals)
        src (fsource-head form)]
    (cond
      (option-vector-type? option-type) (rp-r (rp-seq2 "option-some?-of" option-type value) (rp-r-n r))
      (and (rp-ty? option-type :document) (or (string=? src "some?") (string=? src "nil?")))
      (let [tmp (rp-synth "type-predicate" (rp-r-n r))
            sym (rp-r-form tmp)
            inner (rp-rewrite g (rp-document-null-test sym) (form/assoc-form locals sym (rp-tk :document)) (rp-r-n tmp))]
        (rp-r (rp-seq2 "let" (form/vec2 sym value) (rp-r-form inner)) (rp-r-n inner)))
      :else (rp-r (rp-seq1 "option-some?" value) (rp-r-n r)))))
   :default nil)

#?(:kotoba
(defn rp-arm-option-value [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rv (rp-rewrite g (form/nth-of form 1) locals n)
        rf (rp-rewrite g (form/nth-of form 2) locals (rp-r-n rv))
        value (rp-r-form rv)
        fallback (rp-r-form rf)
        option-type (rp-infer-or-nil g value locals)]
    (if (option-vector-type? option-type)
      (rp-r (rp-seq3 "option-value-of" option-type value fallback) (rp-r-n rf))
      (rp-r (rp-seq2 "option-value" value fallback) (rp-r-n rf)))))
   :default nil)

#?(:kotoba
(defn rp-arm-option-match [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [type (form/nth-of form 1)
        rv (rp-rewrite g (form/nth-of form 2) locals n)
        rn (rp-rewrite g (form/nth-of form 3) locals (rp-r-n rv))
        rs (rp-rewrite g (form/nth-of form 5) (form/assoc-form locals (form/nth-of form 4) (form/nth-of type 1)) (rp-r-n rn))]
    (rp-r (form/form-seq (form/append-form (form/append-form (form/append-form (form/three-forms (form/symbol-form "option-match") type (rp-r-form rv))
                                                                                (rp-r-form rn))
                                                              (form/nth-of form 4))
                                            (rp-r-form rs)))
          (rp-r-n rs))))
   :default nil)

#?(:kotoba
(defn rp-arm-result-match [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [type (form/nth-of form 1)
        rv (rp-rewrite g (form/nth-of form 2) locals n)
        ro (rp-rewrite g (form/nth-of form 4) (form/assoc-form locals (form/nth-of form 3) (form/nth-of type 1)) (rp-r-n rv))
        re (rp-rewrite g (form/nth-of form 6) (form/assoc-form locals (form/nth-of form 5) (form/nth-of type 2)) (rp-r-n ro))]
    (rp-r (form/form-seq (form/append-form (form/append-form (form/append-form (form/append-form (form/three-forms (form/symbol-form "result-match-of") type (rp-r-form rv))
                                                                                                (form/nth-of form 3))
                                                                              (rp-r-form ro))
                                                            (form/nth-of form 5))
                                          (rp-r-form re)))
          (rp-r-n re))))
   :default nil)

;; the payload type of TAG among the cases of a variant descriptor (nil when absent)
#?(:kotoba
(defn rp-payload [descriptor [:ref :form/r] tag [:ref :form/r] i :i64] [:ref :form/r]
  (let [cases (form/nth-of descriptor 2)]
    (if (>= i (form/count-of cases))
      (form/nil-form)
      (if (form/eq (form/nth-of (form/nth-of cases i) 0) tag)
        (form/nth-of (form/nth-of cases i) 1)
        (rp-payload descriptor tag (+ i 1))))))
   :default nil)

#?(:kotoba
(defn rp-vm-branches [g [:ref :ana/g] descriptor [:ref :form/r] branches [:ref :form/r] i :i64 locals [:ref :form/r] n :i64 acc [:list [:ref :form/r]]] [:ref :ana/rl]
  (if (>= i (form/count-of branches))
    (rp-rl acc n)
    (let [br (form/nth-of branches i)
          tag (form/nth-of br 0)
          binder (form/nth-of br 1)
          payload (if (variant-type? descriptor) (rp-payload descriptor tag 0) (form/nil-form))
          r (rp-rewrite g (form/nth-of br 2) (form/assoc-form locals binder payload) n)]
      (rp-vm-branches g descriptor branches (+ i 1) locals (rp-r-n r)
                      (form/append-form acc (form/vec3 tag binder (rp-r-form r)))))))
   :default nil)

#?(:kotoba
(defn rp-arm-variant-match [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [type (form/nth-of form 1)
        descriptor (rp-descriptor g type)
        _ (rp-fail (and (schema-ref-type? type) (not (variant-type? descriptor)))
                   (str "no :variant schema declared for " (form-text (form/nth-of type 1)) " in this namespace")
                   "kotoba.error/subset-reject" form)
        rv (rp-rewrite g (form/nth-of form 2) locals n)
        rb (rp-vm-branches g descriptor (form/nth-of form 3) 0 locals (rp-r-n rv) (form/no-forms))]
    (rp-r (rp-seq3 "variant-match" descriptor (rp-r-form rv) (form/form-vec (rp-rl-forms rb))) (rp-rl-n rb))))
   :default nil)

;; a call of a protocol method: statically dispatched to the implementation of the receiver's record type
#?(:kotoba
(defn rp-arm-protocol [g [:ref :ana/g] form [:ref :form/r] op [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [method (form/form-get (form/form-get (rp-g-dispatch g) (form/keyword-form :methods)) op)
        arity (form/int-value (fget method :arity))
        implementations (fget method :implementations)
        rl (rp-rw-args g form locals n)
        args (rp-args-vec rl)
        _ (rp-fail (not (= arity (form/count-of args)))
                   "protocol method call does not match its declared arity" "kotoba.error/protocol-method" form)
        receiver-type (rp-infer g (form/nth-of args 0) locals)
        type-id (nominal-type-identity receiver-type)
        implementation (form/form-get implementations type-id)
        _ (rp-fail (not (ftruthy? implementation))
                   (str "protocol method requires a statically known implemented record; got " (pr-form receiver-type))
                   "kotoba.error/protocol-dispatch" form)]
    (rp-r (rp-op-call implementation args) (rp-rl-n rl))))
   :default nil)

;; (cons op (cons descriptor (map rw (rest args)))): the type argument resolved through the schema table
#?(:kotoba
(defn rp-arm-schema-arg [g [:ref :ana/g] form [:ref :form/r] op [:ref :form/r] locals [:ref :form/r] n :i64 variant? :bool] [:ref :ana/r]
  (let [rf (form/nth-of form 1)
        descriptor (rp-schema-get (rp-g-schemas g) rf)
        _ (rp-fail (if variant? (not (variant-type? descriptor)) (not (record-type? descriptor)))
                   (str (if variant? "no :variant schema declared for " "no :record schema declared for ")
                        (form-text (form/nth-of rf 1)) " in this namespace")
                   (if variant? "kotoba.error/subset-reject" "kotoba.error/record-projection-unresolved") form)
        rl (rp-rw-kids g form 2 locals n (form/no-forms))]
    (rp-r (form/form-seq (form/cons-onto op (form/cons-onto descriptor (rp-rl-forms rl)))) (rp-rl-n rl))))
   :default nil)

#?(:kotoba
(defn rp-record-get-form [g [:ref :ana/g] form [:ref :form/r] value [:ref :form/r] value-type [:ref :form/r] key [:ref :form/r]] [:ref :form/r]
  (let [descriptor (rp-descriptor g value-type)]
    (cond
      (canonical-typed-map-type? value-type) (rp-seq3 "typed-map-get" value-type value key)
      (rp-ty? value-type :map) (rp-seq3 "map-get" value key (form/int-form 0))
      :else
      (let [_ (rp-fail (not (record-type? descriptor))
                       (str "record-get without a type descriptor requires a record value; got " (pr-form value-type)
                            (if (schema-ref-type? value-type)
                              (str " (no :record schema declared for " (form-text (form/nth-of value-type 1)) " in this namespace)")
                              ""))
                       "kotoba.error/record-projection-unresolved" form)]
        (rp-seq3 "record-get" descriptor value key)))))
   :default nil)

#?(:kotoba
(defn rp-arm-record-get [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [r (rp-rewrite g (form/nth-of form 1) locals n)
        value (rp-r-form r)
        value-type (rp-infer g value locals)
        out (rp-record-get-form g form value value-type (form/nth-of form 2))]
    (rp-r out (rp-r-n r))))
   :default nil)

;; destructure needs the caller's locals: the helper above only exists to keep the signature small
#?(:kotoba
(defn rp-destructure-with [g [:ref :ana/g] form [:ref :form/r] args [:ref :form/r] locals [:ref :form/r]] [:ref :form/r]
  (let [value (form/nth-of args 0)
        key (form/nth-of args 1)
        dflt (form/nth-of args 2)
        value-type (rp-infer-or-nil g value locals)
        descriptor (rp-descriptor g value-type)]
    (cond
      (canonical-typed-map-type? value-type)
      (let [_ (rp-fail (not (= 3 (form/count-of args))) "typed-map destructuring requires an :or default" "kotoba.error/destructure-default" form)]
        (rp-seq3 "option-value-of" (form/vec2 (rp-tk :option) (form/nth-of value-type 2))
                 (rp-seq3 "typed-map-get" value-type value key) dflt))
      (record-type? descriptor)
      (let [_ (rp-fail (not (form/is-keyword? key)) "record destructuring requires keyword fields" "kotoba.error/record-projection-unresolved" form)]
        (rp-seq3 "record-get" descriptor value key))
      :else (rp-seq3 "map-get" value key (if (= 3 (form/count-of args)) dflt (form/int-form 0))))))
   :default nil)

#?(:kotoba
(defn rp-arm-destructure [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        out (rp-destructure-with g form (rp-args-vec rl) locals)]
    (rp-r out (rp-rl-n rl))))
   :default nil)

#?(:kotoba
(defn rp-arm-match-has [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        args (rp-args-vec rl)
        value-type (rp-infer-or-nil g (form/nth-of args 0) locals)
        descriptor (rp-descriptor g value-type)
        _ (rp-fail (canonical-typed-map-type? value-type)
                   "match map patterns admit the bounded map only; this scrutinee is a canonical typed map"
                   "kotoba.error/subset-reject" form)
        _ (rp-fail (record-type? descriptor)
                   "match map patterns admit the bounded map only; this scrutinee is a record"
                   "kotoba.error/subset-reject" form)
        value (form/nth-of args 0)
        key (form/nth-of args 1)]
    (rp-r (rp-seq2 "=" (rp-seq3 "map-get" value key (form/int-form 0)) (rp-seq3 "map-get" value key (form/int-form 1))) (rp-rl-n rl))))
   :default nil)

#?(:kotoba
(defn rp-get-default-check [g [:ref :ana/g] descriptor [:ref :form/r] key [:ref :form/r] dflt [:ref :form/r] form [:ref :form/r] locals [:ref :form/r]] [:ref :form/r]
  (record-get [:ref :ie/r] (record-get-default-type (rp-g-ctx g) descriptor key dflt form locals (rp-g-sigs g)) :type))
   :default nil)

#?(:kotoba
(defn rp-get-form [g [:ref :ana/g] form [:ref :form/r] args [:ref :form/r] locals [:ref :form/r]] [:ref :form/r]
  (let [value (form/nth-of args 0)
        key (form/nth-of args 1)
        dflt (form/nth-of args 2)
        three? (= 3 (form/count-of args))
        value-type (rp-infer-or-nil g value locals)
        descriptor (rp-descriptor g value-type)]
    (cond
      (rp-ty? value-type :document)
      (let [lookup (rp-seq2 "document-get" value (as-document-key g key locals))]
        (if three?
          (rp-seq3 "option-value-of" (form/vec2 (rp-tk :option) (rp-tk :document)) lookup (as-document-form g dflt locals))
          lookup))
      (canonical-typed-map-type? value-type)
      (let [lookup (rp-seq3 "typed-map-get" value-type value key)]
        (if three?
          (rp-seq3 "option-value-of" (form/vec2 (rp-tk :option) (form/nth-of value-type 2)) lookup dflt)
          lookup))
      (and (record-type? descriptor) three? (form/is-keyword? key))
      (let [_ (rp-get-default-check g descriptor key dflt form locals)]
        (if (ftruthy? (record-field-type descriptor key (ctx-schemas (rp-g-ctx g))))
          (rp-seq3 "record-get" descriptor value key)
          (rp-seq2 "do" value dflt)))
      (record-type? descriptor)
      (let [_ (rp-fail (not (and (= 2 (form/count-of args)) (form/is-keyword? key)))
                       "record get requires a value and one keyword field" "kotoba.error/record-projection-unresolved" form)]
        (rp-seq3 "record-get" descriptor value key))
      :else (rp-seq3 "map-get" value key (if three? dflt (form/int-form 0))))))
   :default nil)

#?(:kotoba
(defn rp-arm-get [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        out (rp-get-form g form (rp-args-vec rl) locals)]
    (rp-r out (rp-rl-n rl))))
   :default nil)

;; (reduce (fn [acc [key item]] (list head ... acc key item)) init pairs), the pairs from index I of ARGS
#?(:kotoba
(defn rp-fold-pairs [head :string extra [:ref :form/r] acc [:ref :form/r] args [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= (+ i 1) (form/count-of args))
    acc
    (rp-fold-pairs head extra
                   (form/form-seq (form/append-form (form/append-form (form/append-form (form/one-form (form/symbol-form head)) acc) (form/nth-of args i)) (form/nth-of args (+ i 1))))
                   args (+ i 2))))
   :default nil)

#?(:kotoba
(defn rp-fold-typed-assoc [descriptor [:ref :form/r] acc [:ref :form/r] args [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= (+ i 1) (form/count-of args))
    acc
    (rp-fold-typed-assoc descriptor
                         (rp-seq4 "typed-map-assoc" descriptor acc (form/nth-of args i) (form/nth-of args (+ i 1)))
                         args (+ i 2))))
   :default nil)

#?(:kotoba
(defn rp-fold-doc-assoc [g [:ref :ana/g] acc [:ref :form/r] args [:ref :form/r] i :i64 locals [:ref :form/r]] [:ref :form/r]
  (if (>= (+ i 1) (form/count-of args))
    acc
    (rp-fold-doc-assoc g (rp-seq3 "document-assoc" acc (as-document-key g (form/nth-of args i) locals)
                                  (as-document-form g (form/nth-of args (+ i 1)) locals))
                       args (+ i 2) locals)))
   :default nil)

#?(:kotoba
(defn rp-empty-map-literal? [receiver [:ref :form/r]] :bool
  (and (form/is-seq? receiver) (= 1 (form/count-of receiver)) (rp-sym-is? (form/nth-of receiver 0) "map-new")))
   :default nil)

#?(:kotoba
(defn rp-assoc-descriptor [g [:ref :ana/g] receiver [:ref :form/r] pairs-args [:ref :form/r] value-type [:ref :form/r] locals [:ref :form/r]] [:ref :form/r]
  (let [key-type (if (and (rp-ty? value-type :map) (rp-empty-map-literal? receiver) (> (form/count-of pairs-args) 0))
                   (rp-infer-or-nil g (form/nth-of pairs-args 0) locals)
                   (form/nil-form))
        retyped-key (if (or (rp-ty? key-type :i64) (rp-ty? key-type :string)) key-type (form/nil-form))
        retyped-item (if (form/is-nil? retyped-key)
                       (form/nil-form)
                       (let [t (rp-infer-or-nil g (form/nth-of pairs-args 1) locals)]
                         (if (form/is-nil? t) (rp-tk :i64) t)))]
    (cond
      (canonical-typed-map-type? value-type) value-type
      (not (form/is-nil? retyped-key)) (form/form-vec (form/three-forms (rp-tk :map) retyped-key retyped-item))
      :else (form/nil-form))))
   :default nil)

#?(:kotoba
(defn rp-map-assoc-form [g [:ref :ana/g] form [:ref :form/r] args [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [receiver (form/nth-of args 0)
        pairs-args (form/form-vec (fdrop args 1))
        value-type (rp-infer-or-nil g receiver locals)
        descriptor (rp-assoc-descriptor g receiver pairs-args value-type locals)]
    (cond
      (not (form/is-nil? (rp-row-op-record g value-type)))
      (row-op-rewrite g (form/symbol-form "map-assoc") args locals n form)
      (rp-ty? value-type :document)
      (rp-r (rp-fold-doc-assoc g receiver pairs-args 0 locals) n)
      (not (form/is-nil? descriptor))
      (rp-r (rp-fold-typed-assoc descriptor
                                 (if (canonical-typed-map-type? value-type) receiver (rp-seq1 "typed-map-new" descriptor))
                                 pairs-args 0)
            n)
      :else (rp-r (rp-op-call (form/symbol-form "map-assoc") args) n))))
   :default nil)

#?(:kotoba
(defn rp-arm-map-assoc [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)]
    (rp-map-assoc-form g form (rp-args-vec rl) locals (rp-rl-n rl))))
   :default nil)

#?(:kotoba
(defn rp-arm-contains [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        args (rp-args-vec rl)
        receiver (form/nth-of args 0)
        key (form/nth-of args 1)
        value-type (rp-infer g receiver locals)
        out (rp-contains-form g form receiver key value-type locals)]
    (rp-r out (rp-rl-n rl))))
   :default nil)

#?(:kotoba
(defn rp-contains-form [g [:ref :ana/g] form [:ref :form/r] receiver [:ref :form/r] key [:ref :form/r] value-type [:ref :form/r] locals [:ref :form/r]] [:ref :form/r]
  (cond
    (typed-set-type? value-type) (rp-seq3 "typed-set-contains" value-type receiver key)
    (rp-ty? value-type :document) (rp-seq2 "document-contains" receiver (as-document-key g key locals))
    (canonical-typed-map-type? value-type) (rp-seq3 "typed-map-contains" value-type receiver key)
    :else
    (throw (rp-error (str "contains? requires a canonical typed map "
                          "[:map key-type value-type]; got " (pr-form value-type)
                          ". A typed set answers to typed-set-contains, and the "
                          "bounded keyword map has no presence primitive at all")
                     "kotoba.error/map-presence-receiver" form))))
   :default nil)

#?(:kotoba
(defn rp-fold-doc-dissoc [g [:ref :ana/g] acc [:ref :form/r] args [:ref :form/r] i :i64 locals [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of args))
    acc
    (rp-fold-doc-dissoc g (rp-seq2 "document-dissoc" acc (as-document-key g (form/nth-of args i) locals)) args (+ i 1) locals)))
   :default nil)

#?(:kotoba
(defn rp-fold-typed-dissoc [value-type [:ref :form/r] acc [:ref :form/r] args [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of args))
    acc
    (rp-fold-typed-dissoc value-type (rp-seq3 "typed-map-dissoc" value-type acc (form/nth-of args i)) args (+ i 1))))
   :default nil)

#?(:kotoba
(defn rp-dissoc-form [g [:ref :ana/g] form [:ref :form/r] args [:ref :form/r] value-type [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [receiver (form/nth-of args 0)]
    (cond
      (not (form/is-nil? (rp-row-op-record g value-type)))
      (row-op-rewrite g (form/symbol-form "dissoc") args locals n form)
      (rp-ty? value-type :document)
      (rp-r (rp-fold-doc-dissoc g receiver args 1 locals) n)
      (not (canonical-typed-map-type? value-type))
      (throw (rp-error (str "dissoc requires a record or a canonical typed map "
                            "[:map key-type value-type]; got " (pr-form value-type)
                            ". A typed set answers to typed-set-disj, and the "
                            "bounded keyword map has no removal primitive at all")
                       "kotoba.error/map-dissoc-receiver" form))
      :else (rp-r (rp-fold-typed-dissoc value-type receiver args 1) n))))
   :default nil)

#?(:kotoba
(defn rp-arm-dissoc [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        args (rp-args-vec rl)
        value-type (rp-infer g (form/nth-of args 0) locals)]
    (rp-dissoc-form g form args value-type locals (rp-rl-n rl))))
   :default nil)

#?(:kotoba
(defn rp-row-op-not-record [op [:ref :form/r] receiver [:ref :form/r] type [:ref :form/r] form [:ref :form/r]] [:ref :ana/r]
  (throw (fe-reject-data (str (form-text op) " is a row operation on a record; " (use-site-text receiver) " is "
                              (if (form/is-keyword? type) (fname type) (pr-form type)))
                         "kotoba.error/row-operation-receiver" form
                         (form/assoc-form (form/form-map (form/no-forms)) (form/keyword-form :kotoba.error/actual) type))))
   :default nil)

#?(:kotoba
(defn rp-arm-row-op [g [:ref :ana/g] form [:ref :form/r] op [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        args (rp-args-vec rl)
        receiver-type (rp-infer g (form/nth-of args 0) locals)]
    (if (not (form/is-nil? (rp-row-op-record g receiver-type)))
      (row-op-rewrite g op args locals (rp-rl-n rl) form)
      (rp-row-op-not-record op (form/nth-of args 0) receiver-type form))))
   :default nil)

#?(:kotoba
(defn rp-fold-items [head :string type-arg [:ref :form/r] acc [:ref :form/r] items [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of items))
    acc
    (rp-fold-items head type-arg
                   (if (form/is-nil? type-arg)
                     (rp-seq2 head acc (form/nth-of items i))
                     (rp-seq3 head type-arg acc (form/nth-of items i)))
                   items (+ i 1))))
   :default nil)

#?(:kotoba
(defn rp-set-op-form [form [:ref :form/r] op [:ref :form/r] args [:ref :form/r] value-type [:ref :form/r]] [:ref :form/r]
  (let [receiver (form/nth-of args 0)
        items (form/form-vec (fdrop args 1))
        conj? (rp-sym-is? op "conj")
        _ (rp-fail (= 0 (form/count-of items))
                   (str (form-text op) " requires a set and at least one item") "kotoba.error/set-operation-arity" form)]
    (cond
      (and conj? (rp-ty? value-type :vector-i64)) (rp-fold-items "vector-conj" (form/nil-form) receiver items 0)
      (and conj? (rp-ty? value-type :vector-f64)) (rp-fold-items "vector-f64-conj" (form/nil-form) receiver items 0)
      (and conj? (canonical-list-type? value-type)) (rp-fold-items "typed-list-conj" value-type receiver items 0)
      :else
      (let [_ (rp-fail (not (typed-set-type? value-type))
                       (str (form-text op) " requires a typed set [:set item-type]"
                            (if conj? " or a bounded :vector-i64 / :vector-f64" "")
                            "; got " (pr-form value-type)
                            ". A bounded vector answers to vector-conj, and a "
                            "canonical typed map answers to typed-map-assoc and "
                            "typed-map-dissoc")
                       (if conj? "kotoba.error/set-conj-receiver" "kotoba.error/set-disj-receiver") form)]
        (rp-fold-items (if conj? "typed-set-conj" "typed-set-disj") value-type receiver items 0)))))
   :default nil)

#?(:kotoba
(defn rp-arm-set-op [g [:ref :ana/g] form [:ref :form/r] op [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        args (rp-args-vec rl)
        value-type (rp-infer g (form/nth-of args 0) locals)
        out (rp-set-op-form form op args value-type)]
    (rp-r out (rp-rl-n rl))))
   :default nil)

#?(:kotoba
(defn rp-hetero-at [value-type [:ref :form/r] value-name [:ref :form/r] i :i64 end :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i end)
    acc
    (rp-hetero-at value-type value-name (+ i 1) end
                  (form/append-form acc (rp-seq3 "hetero-vector-at" value-type value-name (form/int-form i))))))
   :default nil)

#?(:kotoba
(defn rp-drop-hetero [g [:ref :ana/g] form [:ref :form/r] args [:ref :form/r] value-type [:ref :form/r] n :i64] [:ref :ana/r]
  (let [_ (rp-fail (not (= 2 (form/count-of args)))
                   "heterogeneous vector drop requires a value and one literal count" "kotoba.error/hetero-vector-slice-index" form)
        item-types (form/nth-of value-type 1)
        host-index (heterogeneous-vector-slice-index! (form/nth-of args 1) item-types form)
        suffix-types (form/form-vec (fl-slice (form/kids-of item-types) host-index (form/count-of item-types) (form/no-forms)))
        suffix-type (form/vec2 (rp-tk :vector) suffix-types)
        vn (rp-synth "hetero-slice" n)
        value-name (rp-r-form vn)
        elems (rp-hetero-at value-type value-name host-index (form/count-of item-types) (form/no-forms))]
    (rp-r (rp-seq2 "let" (form/vec2 value-name (form/nth-of args 0))
                   (form/form-seq (form/cons-onto (form/symbol-form "hetero-vector-new") (form/cons-onto suffix-type elems))))
          (rp-r-n vn))))
   :default nil)

#?(:kotoba
(defn rp-arm-vector-drop [g [:ref :ana/g] form [:ref :form/r] op [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        args (rp-args-vec rl)
        value-type (rp-infer-or-nil g (form/nth-of args 0) locals)]
    (cond
      (heterogeneous-vector-type? value-type) (rp-drop-hetero g form args value-type (rp-rl-n rl))
      (rp-ty? value-type :vector-f64) (rp-r (rp-op-call (form/symbol-form "vector-f64-drop") args) (rp-rl-n rl))
      :else (rp-r (rp-op-call op args) (rp-rl-n rl)))))
   :default nil)

#?(:kotoba
(defn rp-nth-form [g [:ref :ana/g] form [:ref :form/r] op [:ref :form/r] args [:ref :form/r] value-type [:ref :form/r] locals [:ref :form/r]] [:ref :form/r]
  (let [argc (form/count-of args)
        advice (collection-head-advice value-type)]
    (cond
      (and (rp-ty? value-type :document) (= 2 argc))
      (rp-seq2 "__kotoba_doc_nth" (form/nth-of args 0) (form/nth-of args 1))

      (heterogeneous-vector-type? value-type)
      (let [_ (rp-fail (not (and (<= 2 argc) (<= argc 3)))
                       "heterogeneous vector nth requires a value, one literal index, and an optional dflt"
                       "kotoba.error/hetero-vector-index" form)
            host-index (rp-hetero-index (form/nth-of args 1) (form/nth-of value-type 1) form)
            item-type (form/nth-of (form/nth-of value-type 1) host-index)
            _ (rp-nth-default-check g args item-type locals)]
        (rp-seq3 "hetero-vector-at" value-type (form/nth-of args 0) (form/nth-of args 1)))

      (rp-ty? value-type :vector-i64)
      (let [_ (rp-fail (not (and (<= 2 argc) (<= argc 3))) "vector nth requires value, index, and optional dflt" "kotoba.error/subset-reject" form)]
        (rp-op-call (form/symbol-form (if (= 3 argc) "vector-get" "vector-at")) args))

      (rp-ty? value-type :vector-f64)
      (let [_ (rp-fail (not (and (<= 2 argc) (<= argc 3))) "vector nth requires value, index, and optional dflt" "kotoba.error/subset-reject" form)]
        (rp-op-call (form/symbol-form (if (= 3 argc) "vector-f64-get" "vector-f64-at")) args))

      (canonical-list-type? value-type)
      (let [_ (rp-fail (not (= 2 argc))
                       (str "nth on a canonical [:list T] takes a value "
                            "and an index and has no defaulting form; "
                            "typed-list-nth traps on an index out of "
                            "range, as vector nth without a dflt does")
                       "kotoba.error/nth-receiver" form)]
        (rp-seq3 "typed-list-nth" value-type (form/nth-of args 0) (form/nth-of args 1)))

      (not (string=? advice ""))
      (throw (rp-error (str "nth indexes a bounded vector; got " (pr-form value-type) ". " advice) "kotoba.error/nth-receiver" form))

      :else (rp-op-call op args))))
   :default nil)

#?(:kotoba
(defn rp-hetero-index [index [:ref :form/r] item-types [:ref :form/r] form [:ref :form/r]] :i64
  (heterogeneous-vector-index! index item-types form))
   :default nil)

#?(:kotoba
(defn rp-require-type [actual [:ref :form/r] expected [:ref :form/r] form [:ref :form/r]] :i64
  (require-expression-type! actual expected form))
   :default nil)

;; a default given to a heterogeneous nth must have the item's type
#?(:kotoba
(defn rp-nth-default-check [g [:ref :ana/g] args [:ref :form/r] item-type [:ref :form/r] locals [:ref :form/r]] :i64
  (if (= 3 (form/count-of args))
    (let [dflt (form/nth-of args 2)
          t (rp-infer g dflt locals)]
      (rp-require-type t item-type dflt))
    0))
   :default nil)

#?(:kotoba
(defn rp-arm-nth [g [:ref :ana/g] form [:ref :form/r] op [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        args (rp-args-vec rl)
        value-type (rp-infer-or-nil g (form/nth-of args 0) locals)
        out (rp-nth-form g form op args value-type locals)]
    (rp-r out (rp-rl-n rl))))
   :default nil)

#?(:kotoba
(defn rp-arm-count [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        args (rp-args-vec rl)
        receiver (form/nth-of args 0)
        value-type (rp-infer-single g args locals)
        _ (rp-fail (not (= 1 (form/count-of args))) "count requires exactly one collection" "kotoba.error/count-arity" form)
        out (rp-count-form form receiver value-type)]
    (rp-r out (rp-rl-n rl))))
   :default nil)

#?(:kotoba
(defn rp-count-form [form [:ref :form/r] receiver [:ref :form/r] value-type [:ref :form/r]] [:ref :form/r]
  (cond
    (rp-ty? value-type :vector-i64) (rp-seq1 "vector-count" receiver)
    (rp-ty? value-type :vector-f64) (rp-seq1 "vector-f64-count" receiver)
    (heterogeneous-vector-type? value-type) (rp-seq2 "hetero-vector-count" value-type receiver)
    (typed-set-type? value-type) (rp-seq2 "typed-set-count" value-type receiver)
    (rp-ty? value-type :document) (rp-seq1 "document-count" receiver)
    (canonical-typed-map-type? value-type) (rp-seq2 "typed-map-count" value-type receiver)
    (canonical-list-type? value-type) (rp-seq1 "vector-count" receiver)
    :else
    (let [advice (collection-head-advice value-type)]
      (throw (rp-error (str "count requires a bounded vector, a typed set or a "
                            "canonical typed map; got " (pr-form value-type) "."
                            (if (string=? advice "") "" (str " " advice)))
                       "kotoba.error/count-receiver" form)))))
   :default nil)

#?(:kotoba
(defn rp-end-ops [value-type [:ref :form/r]] [:ref :form/r]
  (cond
    (rp-ty? value-type :vector-i64) (form/form-vec (form/three-forms (form/symbol-form "vector-at") (form/symbol-form "vector-count") (form/symbol-form "vector-take")))
    (rp-ty? value-type :vector-f64) (form/form-vec (form/three-forms (form/symbol-form "vector-f64-at") (form/symbol-form "vector-f64-count") (form/symbol-form "vector-f64-take")))
    :else (form/nil-form)))
   :default nil)

#?(:kotoba
(defn rp-peek-pop-form [form [:ref :form/r] op [:ref :form/r] receiver [:ref :form/r] value-type [:ref :form/r] n :i64] [:ref :ana/r]
  (let [peek? (rp-sym-is? op "peek")
        ops (rp-end-ops value-type)]
    (if (form/is-nil? ops)
      (let [advice (collection-head-advice value-type)]
        (throw (rp-error (str (if peek? "peek" "pop")
                              " takes from the END of a bounded vector, as it does"
                              " in Clojure; got " (pr-form value-type) ". "
                              (if (string=? advice "")
                                (str "The legacy i64 pair chain is this "
                                     "profile's list, and Clojure reads peek "
                                     "and pop on a list from the FRONT -- but "
                                     "a pair chain and an ordinary integer are "
                                     "the same type here, so that reading "
                                     "cannot be told from reading an integer as "
                                     "a pair. Write first and rest, which lower "
                                     "to pair-first and pair-second and say "
                                     "which was meant")
                                advice))
                         (if peek? "kotoba.error/peek-receiver" "kotoba.error/pop-receiver") form)))
      (let [vn (rp-synth (if peek? "peek" "pop") n)
            value-name (rp-r-form vn)
            at-op (form/nth-of ops 0)
            count-op (form/nth-of ops 1)
            take-op (form/nth-of ops 2)
            last-index (rp-seq2 "-" (form/form-seq (form/two-forms count-op value-name)) (form/int-form 1))]
        (rp-r (rp-seq2 "let" (form/vec2 value-name receiver)
                       (if peek?
                         (form/form-seq (form/three-forms at-op value-name last-index))
                         (form/form-seq (form/three-forms take-op value-name last-index))))
              (rp-r-n vn))))))
   :default nil)

#?(:kotoba
(defn rp-arm-peek-pop [g [:ref :ana/g] form [:ref :form/r] op [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        args (rp-args-vec rl)
        receiver (form/nth-of args 0)
        value-type (rp-infer-single g args locals)
        peek? (rp-sym-is? op "peek")
        _ (rp-fail (not (= 1 (form/count-of args)))
                   (str (form-text op) " requires exactly one collection")
                   (if peek? "kotoba.error/peek-arity" "kotoba.error/pop-arity") form)]
    (rp-peek-pop-form form op receiver value-type (rp-rl-n rl))))
   :default nil)

#?(:kotoba
(defn rp-keys-vals-form [form [:ref :form/r] op [:ref :form/r] receiver [:ref :form/r] value-type [:ref :form/r]] [:ref :form/r]
  (let [keys? (rp-sym-is? op "keys")]
    (cond
      (canonical-typed-map-type? value-type) (rp-seq2 (if keys? "typed-map-keys" "typed-map-vals") value-type receiver)
      (rp-ty? value-type :document) (rp-seq1 (if keys? "__kotoba_doc_keys" "__kotoba_doc_vals") receiver)
      :else
      (let [advice (collection-head-advice value-type)]
        (throw (rp-error (str (if keys? "keys" "vals")
                              " projects a canonical typed map; got " (pr-form value-type) ". "
                              (if (rp-ty? value-type :map)
                                (str "The legacy keyword-keyed bounded map answers "
                                     "to get and assoc and has no projection "
                                     "primitive; write the canonical [:map K V] "
                                     "with typed-map-new to project it")
                                (if (string=? advice "")
                                  (str "Only a canonical [:map K V] has a key "
                                       "and value projection")
                                  advice)))
                         (if keys? "kotoba.error/keys-receiver" "kotoba.error/vals-receiver") form))))))
   :default nil)

#?(:kotoba
(defn rp-arm-keys-vals [g [:ref :ana/g] form [:ref :form/r] op [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        args (rp-args-vec rl)
        receiver (form/nth-of args 0)
        value-type (rp-infer-single g args locals)
        keys? (rp-sym-is? op "keys")
        _ (rp-fail (not (= 1 (form/count-of args)))
                   (str (form-text op) " requires exactly one map")
                   (if keys? "kotoba.error/keys-arity" "kotoba.error/vals-arity") form)
        out (rp-keys-vals-form form op receiver value-type)]
    (rp-r out (rp-rl-n rl))))
   :default nil)

#?(:kotoba
(defn rp-pair-form [form [:ref :form/r] op [:ref :form/r] args [:ref :form/r] value-type [:ref :form/r]] [:ref :form/r]
  (let [first? (rp-sym-is? op "pair-first")
        receiver (form/nth-of args 0)
        advice (collection-head-advice value-type)]
    (cond
      (rp-ty? value-type :document)
      (if first?
        (rp-seq2 "__kotoba_doc_nth" receiver (form/int-form 0))
        (rp-seq1 "__kotoba_doc_rest" receiver))
      (rp-ty? value-type :vector-i64)
      (if first? (rp-seq2 "vector-at" receiver (form/int-form 0)) (rp-seq2 "vector-drop" receiver (form/int-form 1)))
      (rp-ty? value-type :vector-f64)
      (if first? (rp-seq2 "vector-f64-at" receiver (form/int-form 0)) (rp-seq2 "vector-f64-drop" receiver (form/int-form 1)))
      (not (string=? advice ""))
      (throw (rp-error (str (if first? "first (pair-first)" "rest (pair-second)")
                            " reads a pair chain or a bounded vector; got " (pr-form value-type) ". " advice)
                       (if first? "kotoba.error/pair-first-receiver" "kotoba.error/pair-second-receiver") form))
      :else (rp-op-call op args))))
   :default nil)

#?(:kotoba
(defn rp-arm-pair [g [:ref :ana/g] form [:ref :form/r] op [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        args (rp-args-vec rl)
        value-type (if (= 1 (form/count-of args)) (rp-infer-or-nil g (form/nth-of args 0) locals) (form/nil-form))
        out (rp-pair-form form op args value-type)]
    (rp-r out (rp-rl-n rl))))
   :default nil)

#?(:kotoba
(defn rp-string-args? [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r]] :bool
  (and (= 3 (form/count-of form))
       (rp-ty? (rp-infer-or-nil g (form/nth-of form 1) locals) :string)
       (rp-ty? (rp-infer-or-nil g (form/nth-of form 2) locals) :string)))
   :default nil)

#?(:kotoba
(defn rp-arm-string-eq [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        out (form/form-seq (form/cons-onto (form/symbol-form "string=?") (rp-rl-forms rl)))]
    (rp-r (fwith-source-head out "=") (rp-rl-n rl))))
   :default nil)

#?(:kotoba
(defn rp-arm-document-of [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [r (rp-rewrite g (form/nth-of form 1) locals n)
        operand (rp-r-form r)
        operand-type (rp-infer g operand locals)
        constructor (document-of-constructor! (rp-g-ctx g) operand-type operand)]
    (if (rp-kw-is? constructor :identity)
      (rp-r operand (rp-r-n r))
      (rp-r (form/form-seq (form/two-forms constructor operand)) (rp-r-n r)))))
   :default nil)

#?(:kotoba
(defn rp-arm-library-predicate [g [:ref :ana/g] form [:ref :form/r] op [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [r (rp-rewrite g (form/nth-of form 1) locals n)
        operand (rp-r-form r)
        operand-type (rp-infer g operand locals)
        answer (library-predicate-answer! op operand-type operand)]
    (cond
      (rp-kw-is? answer :operand) (rp-r operand (rp-r-n r))
      (rp-kw-is? answer :negated) (rp-r (rp-seq1 "bool-not" operand) (rp-r-n r))
      (rp-kw-is? answer :present) (rp-r (option-presence-test operand operand-type) (rp-r-n r))
      (rp-kw-is? answer :document)
      (let [tmp (rp-synth "type-predicate" (rp-r-n r))
            sym (rp-r-form tmp)
            inner (rp-rewrite g (library-predicate-document-test op sym) (form/assoc-form locals sym (rp-tk :document)) (rp-r-n tmp))]
        (rp-r (rp-seq2 "let" (form/vec2 sym operand) (rp-r-form inner)) (rp-r-n inner)))
      :else (rp-r (rp-seq2 "do" operand answer) (rp-r-n r)))))
   :default nil)

#?(:kotoba
(defn rp-any-eq? [xs [:ref :form/r] k :keyword i :i64] :bool
  (if (>= i (form/count-of xs))
    false
    (or (rp-kw-is? (form/nth-of xs i) k) (rp-any-eq? xs k (+ i 1)))))
   :default nil)

#?(:kotoba
(defn rp-all-float? [types [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of types))
    true
    (and (or (rp-ty? (form/nth-of types i) :f64) (rp-ty? (form/nth-of types i) :f32)) (rp-all-float? types (+ i 1)))))
   :default nil)

#?(:kotoba
(defn rp-all-same? [types [:ref :form/r] i :i64] :bool
  (if (>= (+ i 1) (form/count-of types))
    true
    (and (form/eq (form/nth-of types i) (form/nth-of types (+ i 1))) (rp-all-same? types (+ i 1)))))
   :default nil)

#?(:kotoba
(defn rp-operand-types [g [:ref :ana/g] args [:ref :form/r] i :i64 locals [:ref :form/r] acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of args))
    (form/form-vec acc)
    (rp-operand-types g args (+ i 1) locals (form/append-form acc (rp-infer-or-nil g (form/nth-of args i) locals)))))
   :default nil)

;; an f64 decimal literal beside an f32 operand is narrowed exactly or refused
#?(:kotoba
(defn rp-narrow-literals [args [:ref :form/r] types [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of args))
    (form/form-vec acc)
    (let [arg (form/nth-of args i)]
      (if (and (rp-ty? (form/nth-of types i) :f64) (f64-bits-literal-form? arg))
        (let [b (f32-literal-bits! (form/int-value (form/nth-of arg 1)) arg)]
          (rp-narrow-literals args types (+ i 1) (form/append-form acc (rp-seq1 "f32-from-bits" (form/int-form b)))))
        (rp-narrow-literals args types (+ i 1) (form/append-form acc arg))))))
   :default nil)

#?(:kotoba
(defn rp-arm-numeric [g [:ref :ana/g] form [:ref :form/r] op [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (let [rl (rp-rw-args g form locals n)
        rewritten (rp-args-vec rl)
        types (rp-operand-types g rewritten 0 locals (form/no-forms))
        has-f32 (rp-any-eq? types :f32 0)
        narrowed (if has-f32 (rp-narrow-literals rewritten types 0 (form/no-forms)) rewritten)
        types2 (if has-f32 (rp-operand-types g narrowed 0 locals (form/no-forms)) types)]
    (if (and (> (form/count-of types2) 0) (rp-all-float? types2 0) (rp-all-same? types2 0))
      (rp-r (resolve-float-operator op (form/nth-of types2 0) narrowed) (rp-rl-n rl))
      (rp-r (rp-op-call op narrowed) (rp-rl-n rl)))))
   :default nil)

#?(:kotoba
(defn rp-head-in? [tbl [:ref :form/r] op [:ref :form/r]] :bool
  (rp-set-has? tbl op))
   :default nil)

#?(:kotoba
(defn rp-arm-schema-ref? [form [:ref :form/r] op [:ref :form/r]] :bool
  (and (> (form/count-of form) 1) (schema-ref-type? (form/nth-of form 1))
       (or (rp-sym-is? op "record-new") (rp-sym-is? op "record-get") (rp-sym-is? op "record-assoc") (rp-sym-is? op "record-equal"))))
   :default nil)

;; one seq form: the arms in the host's order (the order is part of the semantics)
#?(:kotoba
(defn rp-rewrite-seq [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (if (= 0 (form/count-of form))
    (rp-r (form/form-seq (form/one-form (form/nil-form))) n)
    (let [op (form/nth-of form 0)
          argc (- (form/count-of form) 1)
          methods (form/form-get (rp-g-dispatch g) (form/keyword-form :methods))]
      (cond
        (rp-sym-is? op "let") (rp-arm-let g form locals n)
        (rp-sym-is? op "if") (rp-arm-if g form locals n)
        (rp-sym-is? op "__kotoba_present") (rp-arm-present g form locals n)
        (rp-sym-is? op "__kotoba_some_last") (rp-arm-some-last g form locals n)
        (rp-sym-is? op "__kotoba_some_bind") (rp-arm-some-bind g form locals n)
        (rp-sym-is? op "option-or") (rp-arm-option-or g form locals n)
        (rp-sym-is? op "option-some?") (rp-arm-option-some g form locals n)
        (rp-sym-is? op "option-value") (rp-arm-option-value g form locals n)
        (rp-sym-is? op "option-match") (rp-arm-option-match g form locals n)
        (rp-sym-is? op "result-match-of") (rp-arm-result-match g form locals n)
        (rp-sym-is? op "variant-match") (rp-arm-variant-match g form locals n)
        (and (form/is-map? methods) (form/form-has? methods op)) (rp-arm-protocol g form op locals n)
        (and (rp-sym-is? op "variant-new") (> argc 0) (schema-ref-type? (form/nth-of form 1)))
        (rp-arm-schema-arg g form op locals n true)
        (rp-arm-schema-ref? form op) (rp-arm-schema-arg g form op locals n false)
        (and (rp-sym-is? op "record-get") (= argc 2)) (rp-arm-record-get g form locals n)
        (rp-sym-is? op "__kotoba_destructure_get") (rp-arm-destructure g form locals n)
        (rp-sym-is? op "__kotoba_match_has") (rp-arm-match-has g form locals n)
        (rp-sym-is? op "get") (rp-arm-get g form locals n)
        (rp-sym-is? op "map-assoc") (rp-arm-map-assoc g form locals n)
        (rp-sym-is? op "contains?") (rp-arm-contains g form locals n)
        (rp-sym-is? op "dissoc") (rp-arm-dissoc g form locals n)
        (or (rp-sym-is? op "select-keys") (rp-sym-is? op "merge")) (rp-arm-row-op g form op locals n)
        (rp-head-in? (rp-g-tbl g :set-ops) op) (rp-arm-set-op g form op locals n)
        (rp-sym-is? op "vector-drop") (rp-arm-vector-drop g form op locals n)
        (rp-sym-is? op "nth") (rp-arm-nth g form op locals n)
        (rp-head-in? (rp-g-tbl g :count-ops) op) (rp-arm-count g form locals n)
        (rp-head-in? (rp-g-tbl g :vec-end) op) (rp-arm-peek-pop g form op locals n)
        (rp-head-in? (rp-g-tbl g :map-proj) op) (rp-arm-keys-vals g form op locals n)
        (or (rp-sym-is? op "pair-first") (rp-sym-is? op "pair-second")) (rp-arm-pair g form op locals n)
        (and (rp-sym-is? op "=") (= argc 2) (rp-string-args? g form locals)) (rp-arm-string-eq g form locals n)
        (rp-sym-is? op "__kotoba_document_of") (rp-arm-document-of g form locals n)
        (and (rp-head-in? (rp-g-tbl g :lib-pred) op) (not (form/form-has? (rp-g-sigs g) op)))
        (rp-arm-library-predicate g form op locals n)
        (rp-head-in? (rp-g-tbl g :numeric) op) (rp-arm-numeric g form op locals n)
        :else
        (let [rl (rp-rw-args g form locals n)]
          (rp-r (rp-op-call op (rp-args-vec rl)) (rp-rl-n rl)))))))
   :default nil)

;; Type-directed rewrite: `(record-get value :field)` -> `(record-get SCHEMA value :field)`, and the other sugar that needs the
;; receiver's type. Answers the form and the counter. Every branch rebuilds the form, and the source form's metadata is restored.
#?(:kotoba
(defn rp-rewrite [g [:ref :ana/g] form [:ref :form/r] locals [:ref :form/r] n :i64] [:ref :ana/r]
  (if (form/is-seq? form)
    (let [r (rp-rewrite-seq g form locals n)]
      (rp-r (preserve-form-meta form (rp-r-form r)) (rp-r-n r)))
    (rp-r form n)))
   :default nil)

#?(:kotoba
;; The rewrite of one form against LOCALS and the signature table SIGS, with the record-protocol DISPATCH table and the counter N;
;; answers the form and the counter.
(defn rewrite-record-projection [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] schemas [:ref :form/r]
                                 dispatch [:ref :form/r] n :i64] [:ref :ana/r]
  (rp-rewrite (rp-g ctx sigs schemas dispatch) form locals n))
   :default
(defn rewrite-record-projection
  "Type-directed rewrite: `(record-get value :field)` -> the canonical
  `(record-get SCHEMA value :field)`, recovering SCHEMA from the value's
  inferred type.

  `record-get` needs the descriptor because lowering is static, which forced
  every projection site to repeat the whole `[:record :ns/name [[:f :i64] …]]`
  literal (13 copies in one murakumo module). The type is already known here,
  so the descriptor is derivable rather than something the author must retype.

  Runs after desugar and before validation, so `validate-expr`, inference and
  every backend continue to see only the 3-arity form — no lowering or
  out-of-repo change is involved.

  `let` is the only binding form that survives to this stage (`loop`/`fn` are
  already lowered to helpers), so it is threaded explicitly and everything else
  recurses structurally. Vectors — including type descriptors — are returned
  untouched because they are not seqs."
  [form locals signatures schemas]
  (if-not (seq? form)
    form
    ;; Every branch below rebuilds the form, and a rebuilt list carries no
    ;; metadata. That silently erased the reader span and `:source-operation`
    ;; that `attach-source-operation` puts on an elaborated named operation --
    ;; but only in functions WITH parameters, because `rewrite-record-projections`
    ;; skips a body whose `:param-types` is empty. `(defn main [] (read-clock 42))`
    ;; kept its span while `(defn read-clock [seed] (clock/now seed))` lost it,
    ;; which is why the loss read as unrelated to this pass.
    ;;
    ;; Downstream diagnostics are the casualty: an effect-ceiling or admission
    ;; rejection could no longer name the operation or point at a line
    ;; (ADR-2607279200 promises both). Restore the source form's metadata onto
    ;; whatever this pass produces.
    (preserve-form-meta
     form
     (let [[op & args] form]
      (cond
        (= op 'let)
        (let [bindings (first args) body (let-body args form)
              [pairs locals']
              (reduce (fn [[acc cur] [nm value]]
                        (let [v (rewrite-record-projection value cur signatures schemas)]
                          [(conj acc nm v)
                           ;; This pass resolves record projections; it is not a
                           ;; type checker, and it must never be the thing that
                           ;; reports a type error. It runs BEFORE
                           ;; `elaborate-named-abilities`, so a binding whose
                           ;; value is a still-named capability operation has no
                           ;; signature yet -- inference threw "operation has no
                           ;; admitted type signature", pre-empting the accurate
                           ;; "named capability operation requires a typed result
                           ;; context" that elaboration would have produced one
                           ;; pass later. Measured on
                           ;;   (let [response (http/post request)] response)
                           ;; An untypeable binding simply has no known type
                           ;; here; a 2-arity `record-get` against it still fails
                           ;; closed with the record-projection message, and any
                           ;; genuine type error surfaces later from
                           ;; check-value-types! with its own diagnostics.
                           (assoc cur nm
                                  (try (infer-expression-type v cur signatures)
                                       (catch #?(:clj Exception :cljs :default) _ nil)))]))
                      [[] locals]
                      (partition 2 bindings))]
          (list 'let (vec pairs) (rewrite-record-projection body locals' signatures schemas)))

        ;; ADR 0353 floor :absence. Truthiness exists on `:bool` and on
        ;; `[:option T]` only: an option test is presence. `when`, `if-not`,
        ;; `when-not`, `not`, `cond`, `cond->` and `if-let` / `when-let` all
        ;; reach here as `if`. Any other test type is left for inference to
        ;; refuse ("if test must be bool or an option"; an `:i64` by its own
        ;; name, floor :bool-predicates).
        (= op 'if)
        (let [test (rewrite-record-projection (first args) locals signatures schemas)
              static (when (and (boolean? test)
                                (first-truthy #(and (seq? %) (= match-has-marker (first %)))
                                              (tree-seq coll? seq (first args))))
                       test)]
          (if (some? static)
            ;; A map pattern on a record: presence was decided statically
            ;; (floor :empty-map-literal), so the test is gone, not wrapped,
            ;; and an arm that cannot match is not there to be typed.
            (rewrite-record-projection (if static (second args) (nth args 2 false))
                                       locals signatures schemas)
            (let [branches (mapv #(rewrite-record-projection % locals signatures schemas)
                                 (rest args))
                  test-type (try (infer-expression-type test locals signatures)
                                 (catch #?(:clj Exception :cljs :default) _ nil))]
            (resolve-absence-if (list* 'if (option-presence-test test test-type) branches)
                              locals signatures))))

        (= op '__kotoba_present)
        (let [value (rewrite-record-projection (first args) locals signatures schemas)
              value-type (try (infer-expression-type value locals signatures)
                              (catch #?(:clj Exception :cljs :default) _ nil))]
          (option-present-value value value-type form))

        (= op '__kotoba_some_last)
        (let [value (rewrite-record-projection (first args) locals signatures schemas)
              value-type (try (infer-expression-type value locals signatures)
                              (catch #?(:clj Exception :cljs :default) _ nil))]
          (cond
            (or (option-vector-type? value-type) (= :option-i64 value-type)) value
            (nil? value-type)
            (reject! "some-> step has no inferable type, so its result cannot be made an option"
                     form :kotoba.error/option-type-unresolved)
            :else (list 'option-some-of [:option value-type] value)))

        (= op '__kotoba_some_bind)
        (let [[tmp body] args
              body (rewrite-record-projection body locals signatures schemas)
              tmp-type (get locals tmp)
              body-type (try (infer-expression-type body locals signatures)
                             (catch #?(:clj Exception :cljs :default) _ nil))]
          (if (or (option-vector-type? tmp-type) (= :option-i64 tmp-type))
            (list 'if (option-presence-test tmp tmp-type)
                  body
                  (cond
                    (option-vector-type? body-type) (list 'option-none-of body-type)
                    (= :option-i64 body-type) '(option-none)
                    :else (reject! "some-> result has no option type"
                                   form :kotoba.error/option-type-unresolved)))
            body))

        (= op 'option-or)
        (let [[value fallback] args
              value (rewrite-record-projection value locals signatures schemas)
              fallback (rewrite-record-projection fallback locals signatures schemas)
              option-type (infer-expression-type value locals signatures)]
          (when-not (and (vector? option-type)
                         (= 2 (count option-type))
                         (= :option (first option-type)))
            (reject! (str "option-or requires an option value; got "
                          (pr-str option-type))
                     form
                     :kotoba.error/option-type-unresolved))
          (list 'option-value-of option-type value fallback))

        ;; Bare `option-some?` / `option-value` are typed `:option-i64`. A
        ;; decision core that stores `[:option :string]` on a record therefore
        ;; has to write `option-some?-of` at every site — the same tax
        ;; `option-or` above already pays by rewriting to `option-value-of`.
        ;; When the value's type is a parametric `[:option T]`, rewrite to the
        ;; `-of` form native already admits. Leave `:option-i64` as the bare
        ;; form so KIR execute and existing native tests keep working.
        ;; Inference of the bare form stays `:option-i64`-only: a missed
        ;; rewrite still fails closed with `expected option-i64`.
        (= op 'option-some?)
        (let [value (rewrite-record-projection (first args) locals signatures schemas)
              option-type (try (infer-expression-type value locals signatures)
                               (catch #?(:clj Exception :cljs :default) _ nil))]
          (cond
            (option-vector-type? option-type)
            (list 'option-some?-of option-type value)
            ;; `some?` / `nil?` on a :document ask its run-time kind (gap 3,
            ;; adr-2609242330): absent is the :null node.
            (and (= :document option-type)
                 (contains? '#{some? nil?} (:kotoba.diag/source-head (meta form))))
            (let [tmp (synthetic "type-predicate")]
              (list 'let [tmp value]
                    (rewrite-record-projection
                     (list 'bool-not (list '= (list 'document-kind tmp) :null))
                     (assoc locals tmp :document) signatures schemas)))
            :else (list 'option-some? value)))

        (= op 'option-value)
        (let [value (rewrite-record-projection (first args) locals signatures schemas)
              fallback (rewrite-record-projection (second args) locals signatures schemas)
              option-type (try (infer-expression-type value locals signatures)
                               (catch #?(:clj Exception :cljs :default) _ nil))]
          (if (option-vector-type? option-type)
            (list 'option-value-of option-type value fallback)
            (list 'option-value value fallback)))

        ;; Type-directed sugar may appear inside a lowered pattern branch. The
        ;; branch binder is lexical, but a generic structural recursion would
        ;; visit the body with the enclosing locals only. In practice this made
        ;; `(option-or (typed-map-get ... key) fallback)` fail when `key` was
        ;; derived from a `(some entry ...)` payload, even though `option-match`
        ;; already carries the exact payload descriptor. Thread the same binder
        ;; types used by `infer-expression-type` through this earlier rewrite.
        (= op 'option-match)
        (let [[type value none-body some-name some-body] args]
          (list 'option-match type
                (rewrite-record-projection value locals signatures schemas)
                (rewrite-record-projection none-body locals signatures schemas)
                some-name
                (rewrite-record-projection some-body
                                           (assoc locals some-name (second type))
                                           signatures schemas)))

        (= op 'result-match-of)
        (let [[type value ok-name ok-body err-name err-body] args]
          (list 'result-match-of type
                (rewrite-record-projection value locals signatures schemas)
                ok-name
                (rewrite-record-projection ok-body
                                           (assoc locals ok-name (second type))
                                           signatures schemas)
                err-name
                (rewrite-record-projection err-body
                                           (assoc locals err-name (nth type 2))
                                           signatures schemas)))

        (= op 'variant-match)
        (let [[type value branches] args
              descriptor (if (schema-ref-type? type)
                           (get schemas (second type))
                           type)
              _ (when (and (schema-ref-type? type)
                           (not (variant-type? descriptor)))
                  (reject! (str "no :variant schema declared for " (second type)
                                " in this namespace")
                           form))
              payloads (if (variant-type? descriptor)
                         (into {} (nth descriptor 2))
                         {})]
          (list 'variant-match descriptor
                (rewrite-record-projection value locals signatures schemas)
                (mapv (fn [[tag binder body]]
                        [tag binder
                         (rewrite-record-projection body
                                                    (assoc locals binder (get payloads tag))
                                                    signatures schemas)])
                      branches)))

        (contains? (:methods *record-protocol-dispatch*) op)
        (let [{:keys [arity implementations]}
              (get-in *record-protocol-dispatch* [:methods op])
              rewritten-args
              (mapv #(rewrite-record-projection % locals signatures schemas) args)]
          (when-not (= arity (count rewritten-args))
            (reject! "protocol method call does not match its declared arity"
                     form :kotoba.error/protocol-method))
          (let [receiver-type (infer-expression-type (first rewritten-args)
                                                     locals signatures)
                type-id (nominal-type-identity receiver-type)
                implementation (get implementations type-id)]
            (when-not implementation
              (reject! (str "protocol method requires a statically known implemented record; got "
                            (pr-str receiver-type))
                       form :kotoba.error/protocol-dispatch))
            (list* implementation rewritten-args)))

        (and (= op 'variant-new)
             (schema-ref-type? (first args)))
        (let [descriptor (get schemas (second (first args)))]
          (when-not (variant-type? descriptor)
            (reject! (str "no :variant schema declared for "
                          (second (first args)) " in this namespace")
                     form))
          (cons op (cons descriptor
                         (map #(rewrite-record-projection % locals signatures schemas)
                              (rest args)))))

        ;; A named record schema reference in an operation's *type argument*
        ;; is resolved here too (variant constructor/match references are
        ;; handled immediately above), so validation, inference and lowering
        ;; keep seeing only inline descriptors. Annotations in parameter/return
        ;; position need no rewrite — `same-expression-type?` already treats a
        ;; reference and its descriptor as the same nominal type.
        (and (contains? '#{record-new record-get record-assoc record-equal} op)
             (schema-ref-type? (first args)))
        (let [descriptor (get schemas (second (first args)))]
          (when-not (record-type? descriptor)
            (reject! (str "no :record schema declared for " (second (first args))
                          " in this namespace")
                     form
                     :kotoba.error/record-projection-unresolved))
          (cons op (cons descriptor
                         (map #(rewrite-record-projection % locals signatures schemas)
                              (rest args)))))

        (and (= op 'record-get) (= 2 (count args)))
        (let [value (rewrite-record-projection (first args) locals signatures schemas)
              value-type (infer-expression-type value locals signatures)
              ;; A named schema reference resolves through the namespace's
              ;; closed :schemas map, so a value threaded through many
              ;; signatures can be annotated `[:ref :ns/name]` instead of
              ;; repeating the descriptor at every site.
              descriptor (if (schema-ref-type? value-type)
                           (get schemas (second value-type))
                           value-type)]
          (cond
            ;; `(:field m)` is Clojure's `(get m :field)`, and on the two map
            ;; types it means exactly what the `get` arm below makes of it: a
            ;; canonical typed map answers `typed-map-get` (an option), the
            ;; bounded keyword->i64 map answers `map-get` with get's default
            ;; 0. Until 2026-09-25 both were refused here with "requires a
            ;; record value", so `(get m :k)` compiled and `(:k m)` did not.
            (canonical-typed-map-type? value-type)
            (list 'typed-map-get value-type value (second args))

            (= :map value-type)
            (list 'map-get value (second args) 0)

            :else
            (do
              (when-not (record-type? descriptor)
                (reject! (str "record-get without a type descriptor requires a record "
                              "value; got " (pr-str value-type)
                              (when (schema-ref-type? value-type)
                                (str " (no :record schema declared for "
                                     (second value-type) " in this namespace)")))
                         form
                         :kotoba.error/record-projection-unresolved))
              (list 'record-get descriptor value (second args)))))

        (= op '__kotoba_destructure_get)
        (let [rewritten-args
              (mapv #(rewrite-record-projection % locals signatures schemas) args)
              [value key default] rewritten-args
              value-type (try (infer-expression-type value locals signatures)
                              (catch #?(:clj Exception :cljs :default) _ nil))
              descriptor (if (schema-ref-type? value-type)
                           (get schemas (second value-type))
                           value-type)]
          (cond
            (canonical-typed-map-type? value-type)
            (do
              (when-not (= 3 (count rewritten-args))
                (reject! "typed-map destructuring requires an :or default"
                         form :kotoba.error/destructure-default))
              (list 'option-value-of [:option (nth value-type 2)]
                    (list 'typed-map-get value-type value key)
                    default))

            (record-type? descriptor)
            (do
              (when-not (keyword? key)
                (reject! "record destructuring requires keyword fields"
                         form :kotoba.error/record-projection-unresolved))
              (list 'record-get descriptor value key))

            :else
            (list 'map-get value key
                  (if (= 3 (count rewritten-args)) default 0))))

        (= op match-has-marker)
        ;; The key-presence scan is written against this profile's bounded map
        ;; (a cons list of pairs). A canonical typed map or a record answers
        ;; presence through a different primitive entirely, so say which one
        ;; the pattern met rather than letting it surface as `expected i64`
        ;; from somewhere inside the synthesized helper.
        (let [rewritten-args
              (mapv #(rewrite-record-projection % locals signatures schemas) args)
              value-type (try (infer-expression-type (first rewritten-args)
                                                     locals signatures)
                              (catch #?(:clj Exception :cljs :default) _ nil))
              descriptor (if (schema-ref-type? value-type)
                           (get schemas (second value-type))
                           value-type)]
          (when (canonical-typed-map-type? value-type)
            (reject! "match map patterns admit the bounded map only; this scrutinee is a canonical typed map"
                     form))
          (if (record-type? descriptor)
            ;; ADR 0353 floor :empty-map-literal: a map literal is a record,
            ;; so a map pattern reads one. A record's field set is its type,
            ;; so presence is decided here, statically: a field it has is
            ;; present, and an arm naming a key it lacks does not match -- in
            ;; a row function's specialization, the arm written for another
            ;; record. Both are constants the enclosing `if` folds away.
            (let [key (second rewritten-args)]
              (boolean (first-truthy (fn [[field _]] (= field key)) (nth descriptor 2))))
            ;; Presence, on a value type with no presence primitive. `map-get`
            ;; answers the DEFAULT for an absent key, so one lookup cannot tell
            ;; an absent key from a key whose value happens to equal the
            ;; default. Two lookups with different defaults can: a present value
            ;; equals itself, and 0 never equals 1. Both are pure and total, and
            ;; the receiver is always a symbol here (the scrutinee binding or a
            ;; projection temp), so neither the map nor the key is re-evaluated.
            (let [[value key] rewritten-args]
              (list '= (list 'map-get value key 0) (list 'map-get value key 1)))))

        (= op 'get)
        (let [rewritten-args
              (mapv #(rewrite-record-projection % locals signatures schemas) args)
              [value key default] rewritten-args
              ;; This rewrite selects a primitive when the receiver type is
              ;; already known; it is not a type-checking pass. An earlier
              ;; invalid binding may deliberately carry nil here so the final
              ;; checker can report that binding's precise error.
              value-type (try (infer-expression-type value locals signatures)
                              (catch #?(:clj Exception :cljs :default) _ nil))
              descriptor (if (schema-ref-type? value-type)
                           (get schemas (second value-type))
                           value-type)]
          (cond
            ;; `get` on a `:document` (a dynamic EDN map): the document lookup,
            ;; which answers an option; with a default, the option's value or
            ;; the default (as a document).
            (= :document value-type)
            (let [lookup (list 'document-get value (as-document-key key locals signatures))]
              (if (= 3 (count rewritten-args))
                (list 'option-value-of [:option :document] lookup
                      (as-document-form default locals signatures))
                lookup))

            (canonical-typed-map-type? value-type)
            (let [lookup (list 'typed-map-get value-type value key)]
              (if (= 3 (count rewritten-args))
                (list 'option-value-of [:option (nth value-type 2)] lookup default)
                lookup))

            (and (record-type? descriptor) (= 3 (count rewritten-args)) (keyword? key))
            (do (record-get-default-type descriptor key default form locals signatures)
                (if (record-field-type descriptor key)
                  (list 'record-get descriptor value key)
                  (list 'do value default)))

            ;; A match pattern's projection of a key the record lacks: its
            ;; arm does not match and is folded away (floor
            ;; :empty-map-literal), so the temp is never read.
            (and (record-type? descriptor)
                 (:kotoba.compiler.frontend/match-projection (meta form))
                 (not (record-field-type descriptor key)))
            (list 'do value 0)

            ;; floor :row-get-and-match: a record's fields are static, so
            ;; the field a get reads is written, not computed.
            (and (record-type? descriptor) (not (keyword? key)))
            (reject! (str "get on record " (second descriptor) " has the computed key "
                          (use-site-text (nth args 1))
                          ": a record's fields are static, so the field a get reads is a"
                          " keyword literal; a computed key needs a [:map K V]")
                     form :kotoba.error/record-projection-unresolved)

            (record-type? descriptor)
            (do
              (when-not (and (= 2 (count rewritten-args)) (keyword? key))
                (reject! "record get requires a value and one keyword field"
                         form :kotoba.error/record-projection-unresolved))
              (list 'record-get descriptor value key))

            :else
            (list 'map-get value key
                  (if (= 3 (count rewritten-args)) default 0))))

        ;; `assoc` / `contains?` / `dissoc` on a canonical typed map.
        ;;
        ;; `get` has selected `typed-map-get` from the receiver's type since
        ;; the typed map landed; the other three had not been written, so a
        ;; `[:map K V]` could be READ through the friendly surface and not
        ;; written, and `(assoc m :a 1)` on one was refused with `expected
        ;; map, got [:map :keyword :i64]` -- for every key type, keyword
        ;; included. These three arms are that half.
        (= op 'map-assoc)
        (let [rewritten-args
              (mapv #(rewrite-record-projection % locals signatures schemas) args)
              [receiver & pairs] rewritten-args
              value-type (try (infer-expression-type receiver locals signatures)
                              (catch #?(:clj Exception :cljs :default) _ nil))
              ;; An EMPTY map literal carries no key type of its own: `{}`
              ;; desugars to `(map-new)`, whose type is the legacy `:map`
              ;; whatever the program goes on to put in it. `(assoc {} 1 10)`
              ;; -- the shape the defect was reported as -- therefore has to
              ;; take its key type from the first key. Only the two key types
              ;; a literal may carry are retyped, so a keyword-keyed `(assoc
              ;; {} :a 1)` still lowers to the legacy map it always did.
              retyped-key (when (and (= '(map-new) receiver)
                                     (seq pairs))
                            (let [key-type
                                  (try (infer-expression-type (first pairs)
                                                              locals signatures)
                                       (catch #?(:clj Exception :cljs :default) _ nil))]
                              (when (contains? #{:i64 :string} key-type) key-type)))
              ;; The VALUE half of the retype. This pass runs AFTER
              ;; desugaring, so unlike `desugar-map` it can ask inference
              ;; rather than reading literals, and `(assoc {} 1 "a")` gets
              ;; `[:map :i64 :string]` for the same reason `{1 "a"}` does.
              ;; `:i64` when inference cannot answer -- the descriptor this
              ;; site has always built.
              retyped-item (when retyped-key
                             (or (try (infer-expression-type (second pairs)
                                                             locals signatures)
                                      (catch #?(:clj Exception :cljs :default) _ nil))
                                 :i64))
              descriptor (cond
                           (canonical-typed-map-type? value-type) value-type
                           retyped-key [:map retyped-key retyped-item]
                           :else nil)]
          (cond
            (row-op-record value-type)
            (row-op-rewrite op rewritten-args locals signatures form)
            ;; `assoc` on a `:document`: one `document-assoc` per pair.
            (= :document value-type)
            (reduce (fn [accumulated [key item]]
                      (list 'document-assoc accumulated
                            (as-document-key key locals signatures)
                            (as-document-form item locals signatures)))
                    receiver (partition 2 pairs))
            descriptor
            (reduce (fn [accumulated [key item]]
                      (list 'typed-map-assoc descriptor accumulated key item))
                    (if (canonical-typed-map-type? value-type)
                      receiver
                      (list 'typed-map-new descriptor))
                    (partition 2 pairs))
            :else (cons 'map-assoc rewritten-args)))

        (= op 'contains?)
        (let [rewritten-args
              (mapv #(rewrite-record-projection % locals signatures schemas) args)
              [receiver key] rewritten-args
              ;; Unlike `get`, this arm REFUSES when the receiver is not a
              ;; typed map, so swallowing the receiver's own refusal would
              ;; replace a precise message (`map key type :f64 has no portable
              ;; key identity …`) with `got nil`. The exception is carried out
              ;; of the `try` and rethrown instead.
              inferred (try {:type (infer-expression-type receiver locals signatures)}
                            (catch #?(:clj Exception :cljs :default) e {:refusal e}))
              _ (when-let [refusal (:refusal inferred)] (throw refusal))
              value-type (:type inferred)]
          (cond
            ;; `(contains? s x)` on a typed set is Clojure's membership test;
            ;; the receiver's type already says which primitive answers.
            (typed-set-type? value-type)
            (list 'typed-set-contains value-type receiver key)

            (= :document value-type)
            (list 'document-contains receiver (as-document-key key locals signatures))

            (canonical-typed-map-type? value-type)
            (list 'typed-map-contains value-type receiver key)

            :else
            (reject! (str "contains? requires a canonical typed map "
                          "[:map key-type value-type]; got " (pr-str value-type)
                          ". A typed set answers to typed-set-contains, and the "
                          "bounded keyword map has no presence primitive at all")
                     form :kotoba.error/map-presence-receiver)))

        (= op 'dissoc)
        (let [rewritten-args
              (mapv #(rewrite-record-projection % locals signatures schemas) args)
              [receiver & keys] rewritten-args
              ;; See `contains?` above: this arm refuses, so it rethrows the
              ;; receiver's own refusal rather than reporting `got nil`.
              inferred (try {:type (infer-expression-type receiver locals signatures)}
                            (catch #?(:clj Exception :cljs :default) e {:refusal e}))
              _ (when-let [refusal (:refusal inferred)] (throw refusal))
              value-type (:type inferred)]
          (cond
            ;; ADR 0353 floor :row-operations: dissoc on a record shrinks it.
            (row-op-record value-type)
            (row-op-rewrite op rewritten-args locals signatures form)
            (= :document value-type)
            (reduce (fn [accumulated key]
                      (list 'document-dissoc accumulated
                            (as-document-key key locals signatures)))
                    receiver keys)
            (not (canonical-typed-map-type? value-type))
            (reject! (str "dissoc requires a record or a canonical typed map "
                          "[:map key-type value-type]; got " (pr-str value-type)
                          ". A typed set answers to typed-set-disj, and the "
                          "bounded keyword map has no removal primitive at all")
                     form :kotoba.error/map-dissoc-receiver)
            :else
            (reduce (fn [accumulated key]
                      (list 'typed-map-dissoc value-type accumulated key))
                    receiver keys)))

        ;; ADR 0353 floor :row-operations: select-keys and merge exist only
        ;; as row operations on a record.
        (contains? '#{select-keys merge} op)
        (let [rewritten-args
              (mapv #(rewrite-record-projection % locals signatures schemas) args)
              receiver-type (infer-expression-type (first rewritten-args) locals signatures)]
          (if (row-op-record receiver-type)
            (row-op-rewrite op rewritten-args locals signatures form)
            (row-op-not-record! op (first rewritten-args) receiver-type form)))

        ;; `conj` and `disj` on a typed set. The receiver carries the item
        ;; type, so neither head assumes `:keyword` -- a `typed-set-new [:set
        ;; :i64]` answers them too, and only a `#{...}` LITERAL is keyword-only.
        ;; Folded left over the items, like `dissoc`, because both are variadic
        ;; in Clojure and `typed-set-conj`/`typed-set-disj` return the set type.
        (contains? set-operations op)
        (let [rewritten-args
              (mapv #(rewrite-record-projection % locals signatures schemas) args)
              [receiver & items] rewritten-args
              ;; See `contains?` above: this arm REFUSES, so swallowing the
              ;; receiver's own refusal would replace a precise message with
              ;; `got nil`. The exception is carried out and rethrown.
              inferred (try {:type (infer-expression-type receiver locals signatures)}
                            (catch #?(:clj Exception :cljs :default) e {:refusal e}))
              _ (when-let [refusal (:refusal inferred)] (throw refusal))
              value-type (:type inferred)
              conj? (= op 'conj)
              primitive (if conj? 'typed-set-conj 'typed-set-disj)]
          (when-not (seq items)
            (reject! (str op " requires a set and at least one item")
                     form :kotoba.error/set-operation-arity))
          (cond
            ;; `conj` on a bounded vector appends at the END, which is what
            ;; Clojure's `conj` does to a vector and what `vector-conj` /
            ;; `vector-f64-conj` already are. Until 2026-09-25 this arm knew
            ;; only the typed set and told the author to spell the vector
            ;; primitive by hand, so `(conj (filterv p v) x)` -- ordinary
            ;; Clojure -- was refused. `disj` stays set-only: it has no vector
            ;; meaning in Clojure either.
            (and conj? (= :vector-i64 value-type))
            (do (doseq [item items]
                  (note-list-item-type! (first args) (try (infer-expression-type item locals signatures)
                                                          (catch #?(:clj Exception :cljs :default) _ nil))))
                (reduce (fn [accumulated item] (list 'vector-conj accumulated item))
                        receiver items))

            (and conj? (= :vector-f64 value-type))
            (reduce (fn [accumulated item] (list 'vector-f64-conj accumulated item))
                    receiver items)

            ;; `conj` on a `[:list T]` appends at the end, like a vector, through
            ;; the run-time-length constructor `typed-list-conj`.
            (and conj? (canonical-list-type? value-type))
            (do (doseq [item items]
                  (note-list-item-type! (first args) (try (infer-expression-type item locals signatures)
                                                          (catch #?(:clj Exception :cljs :default) _ nil))
                                        value-type))
                (reduce (fn [accumulated item] (list 'typed-list-conj value-type accumulated item))
                        receiver items))

            :else
            (do
              (when-not (typed-set-type? value-type)
                (reject! (str op " requires a typed set [:set item-type]"
                              (when conj? " or a bounded :vector-i64 / :vector-f64")
                              "; got " (pr-str value-type)
                              ". A bounded vector answers to vector-conj, and a "
                              "canonical typed map answers to typed-map-assoc and "
                              "typed-map-dissoc")
                         form (if conj?
                                :kotoba.error/set-conj-receiver
                                :kotoba.error/set-disj-receiver)))
              (reduce (fn [accumulated item]
                        (list primitive value-type accumulated item))
                      receiver items))))

        (= op 'vector-drop)
        (let [rewritten-args
              (mapv #(rewrite-record-projection % locals signatures schemas) args)
              [value drop-count] rewritten-args
              value-type (try
                           (infer-expression-type value locals signatures)
                           (catch #?(:clj Exception :cljs :default) _ nil))]
          (cond
            (heterogeneous-vector-type? value-type)
            (do
              (when-not (= 2 (count rewritten-args))
                (reject! "heterogeneous vector drop requires a value and one literal count"
                         form :kotoba.error/hetero-vector-slice-index))
              (let [item-types (second value-type)
                    host-index (heterogeneous-vector-slice-index!
                                drop-count item-types form)
                    suffix-types (subvec item-types host-index)
                    suffix-type [:vector suffix-types]
                    value-name (synthetic "hetero-slice")]
                ;; Heterogeneous vectors already expose exact static indexed
                ;; projection and construction. Rebuild the bounded suffix
                ;; from those primitives, binding VALUE once so a general
                ;; source `(vector-drop expression n)` keeps ordinary
                ;; single-evaluation semantics.
                (list 'let [value-name value]
                      (list* 'hetero-vector-new suffix-type
                             (mapv (fn [index]
                                     (list 'hetero-vector-at value-type value-name index))
                                   (range host-index (count item-types)))))))

            (= :vector-f64 value-type)
            (cons 'vector-f64-drop rewritten-args)

            :else
            (cons op rewritten-args)))

        (= op 'nth)
        (let [rewritten-args
              (mapv #(rewrite-record-projection % locals signatures schemas) args)
              value-type (try
                           (infer-expression-type (first rewritten-args)
                                                  locals signatures)
                           (catch #?(:clj Exception :cljs :default) _ nil))]
          (cond
            ;; `(nth doc i)` on a `:document`: element I, nil out of range.
            (and (= :document value-type) (= 2 (count rewritten-args)))
            (list doc-nth-helper-name (first rewritten-args) (second rewritten-args))

            (heterogeneous-vector-type? value-type)
            (do
              (when-not (<= 2 (count rewritten-args) 3)
                (reject! "heterogeneous vector nth requires a value, one literal index, and an optional default"
                         form :kotoba.error/hetero-vector-index))
              (let [host-index
                    (heterogeneous-vector-index! (second rewritten-args)
                                                 (second value-type) form)
                    item-type (nth (second value-type) host-index)]
                (when (= 3 (count rewritten-args))
                  (let [default (nth rewritten-args 2)]
                    (require-expression-type!
                     (infer-expression-type default locals signatures)
                     item-type default))))
              (list 'hetero-vector-at value-type
                    (first rewritten-args) (second rewritten-args)))

            (= :vector-i64 value-type)
            (do
              (when-not (<= 2 (count rewritten-args) 3)
                (reject! "vector nth requires value, index, and optional default" form))
              (cons (if (= 3 (count rewritten-args)) 'vector-get 'vector-at)
                    rewritten-args))

            (= :vector-f64 value-type)
            (do
              (when-not (<= 2 (count rewritten-args) 3)
                (reject! "vector nth requires value, index, and optional default" form))
              (cons (if (= 3 (count rewritten-args)) 'vector-f64-get 'vector-f64-at)
                    rewritten-args))

            ;; The legacy pair chain -- `list`, `cons`, `take`, a variadic
            ;; rest. Without a default an index outside the chain traps in
            ;; `pair-first` of the empty chain, as vector nth without a
            ;; default traps; with one it answers the default. See
            ;; `list-drop-helper`.
            (and (= :i64 value-type)
                 (not (nonzero-integer-literal? (first rewritten-args))))
            (do
              (when-not (<= 2 (count rewritten-args) 3)
                (reject! "list nth requires value, index, and optional default" form))
              (let [[items index default] rewritten-args
                    walked (list list-drop-helper-name items index)]
                (when (= 3 (count rewritten-args))
                  (require-expression-type!
                   (infer-expression-type default locals signatures)
                   :i64 default))
                (if (= 3 (count rewritten-args))
                  (let [rest-name (synthetic "nth_rest")]
                    (list 'let [rest-name walked]
                          (list 'if (list '= rest-name 0)
                                default
                                (list 'pair-first rest-name))))
                  (list 'pair-first walked))))

            ;; A receiver `nth` does not index. Before this the arm fell
            ;; through to `(cons op ...)` and validation reported `operation
            ;; has no admitted lowering` -- true of `nth` on nothing, since
            ;; `nth` on a bounded vector has been lowered since the vector
            ;; landed. Only receivers this profile can NAME are refused here;
            ;; an unknown or not-yet-inferred receiver (nil) still passes
            ;; through, so an earlier invalid binding keeps reporting its own
            ;; error rather than this one.
            ;; A `[:list T]` indexes through `typed-list-nth`, the accessor
            ;; that arrived with `keys`/`vals` -- their projection IS a list,
            ;; and a projection nothing can read an element out of is a value
            ;; no program can use. There is no defaulting form, because there
            ;; is no list `vector-get`: the three-argument shape is refused
            ;; rather than silently dropping the default the author wrote.
            (canonical-list-type? value-type)
            (do (when-not (= 2 (count rewritten-args))
                  (reject! (str "nth on a canonical [:list T] takes a value "
                                "and an index and has no defaulting form; "
                                "typed-list-nth traps on an index out of "
                                "range, as vector nth without a default does")
                           form :kotoba.error/nth-receiver))
                (list 'typed-list-nth value-type
                      (first rewritten-args) (second rewritten-args)))

            (collection-head-advice value-type)
            (reject! (str "nth indexes a bounded vector; got "
                          (pr-str value-type) ". "
                          (collection-head-advice value-type))
                     form :kotoba.error/nth-receiver)

            :else (cons op rewritten-args)))

        ;; `count` on any admitted collection.
        ;;
        ;; Declared admitted on three backends by `lang/guest-grammar.edn` and
        ;; by `surface-status.edn` `:persistent-collection-semantics`, and
        ;; implemented on none of them: measured 2026-09-03 against sema
        ;; `df383ba0`, `(count [7 8 9])` was refused `operation has no
        ;; admitted lowering` -- on a vector, a list, a set, a typed map, the
        ;; keyword map and a string alike. Every primitive it needs was
        ;; already there and already returning `:i64`.
        (contains? collection-count-operations op)
        (let [rewritten-args
              (mapv #(rewrite-record-projection % locals signatures schemas) args)
              receiver (first rewritten-args)
              ;; See `contains?` above: this arm REFUSES, so swallowing the
              ;; receiver's own refusal would replace a precise message with
              ;; `got nil`. The exception is carried out and rethrown.
              inferred (when (= 1 (count rewritten-args))
                         (try {:type (infer-expression-type receiver locals signatures)}
                              (catch #?(:clj Exception :cljs :default) e {:refusal e})))
              _ (when-let [refusal (:refusal inferred)] (throw refusal))
              value-type (:type inferred)]
          (when-not (= 1 (count rewritten-args))
            (reject! "count requires exactly one collection"
                     form :kotoba.error/count-arity))
          (cond
            (= :vector-i64 value-type) (list 'vector-count receiver)
            (= :vector-f64 value-type) (list 'vector-f64-count receiver)
            (heterogeneous-vector-type? value-type)
            (list 'hetero-vector-count value-type receiver)
            (typed-set-type? value-type) (list 'typed-set-count value-type receiver)
            (= :document value-type) (list 'document-count receiver)
            (canonical-typed-map-type? value-type)
            (list 'typed-map-count value-type receiver)
            ;; `vector-count` walks a `[:list T]` carrier, for any item type,
            ;; and has since the carrier landed. Measured 2026-09-03:
            ;; `(vector-count (typed-list-new [:list :string] "a" "b"))` is 2.
            ;; The refusal this arm used to raise for a list said the type had
            ;; "no accessor primitive at all", which was wrong about counting;
            ;; the count was reachable by hand and only the friendly head was
            ;; missing. That is why no `typed-list-count` was added for it.
            (canonical-list-type? value-type) (list 'vector-count receiver)
            ;; The legacy pair chain: `(list ...)`, `cons`, a variadic rest
            ;; parameter. See `list-count-helper`. A chain is typed `:i64`,
            ;; so the type cannot tell `(count rest)` from `(count n)`. A
            ;; nonzero integer LITERAL can never be a chain and keeps the
            ;; refusal below (0 is the empty chain `(list)` desugars to); any
            ;; other `:i64` that is not one traps in the walk.
            (and (= :i64 value-type) (not (nonzero-integer-literal? receiver)))
            (list list-count-helper-name receiver)
            :else
            (reject! (str "count requires a bounded vector, a typed set or a "
                          "canonical typed map; got " (pr-str value-type) "."
                          (if-let [advice (collection-head-advice value-type)]
                            (str " " advice)
                            ""))
                     form :kotoba.error/count-receiver)))

        ;; `peek` and `pop` on a bounded vector -- Clojure's END.
        ;;
        ;; In Clojure these two are RECEIVER-DEPENDENT: on a vector `peek` is
        ;; the last item and `pop` is every item but the last; on a list
        ;; `peek` is the first and `pop` is the rest. This profile has both a
        ;; bounded vector and a `[:list T]`, so the reading cannot be picked
        ;; once and applied everywhere. What each receiver does:
        ;;
        ;;   bounded i64/f64 vector  the END. `(vector-at v (- (count v) 1))`
        ;;                           and `(vector-take v (- (count v) 1))`.
        ;;   the legacy i64 pair chain
        ;;                           REFUSED, and this is the ambiguous one.
        ;;                           The pair chain is this profile's list, so
        ;;                           Clojure's list reading would say `peek` is
        ;;                           `pair-first` -- but the pair chain is
        ;;                           typed `:i64`, which is also the type of
        ;;                           every ordinary integer, so `(peek 5)` and
        ;;                           `(peek some-chain)` are the same program
        ;;                           to this frontend. Answering either way
        ;;                           would read an integer as a heap pair or
        ;;                           refuse a chain that is a list. The head
        ;;                           that says which one is meant already
        ;;                           exists and is unambiguous: `first` and
        ;;                           `rest`, which lower to exactly the pair
        ;;                           accessors. So this refuses and names them.
        ;;   [:list T]               REFUSED: it has `vector-count` and
        ;;                           `typed-list-nth` but no rear operation and
        ;;                           no drop, so neither reading is buildable.
        ;;   typed set, typed map, keyword map, string
        ;;                           REFUSED, naming each one's own primitives.
        ;;
        ;; EMPTINESS. Clojure's `pop` on an empty collection throws and `peek`
        ;; returns nil. Neither is available: emptiness is not statically
        ;; known here, and there is no nil in this profile to answer with. Of
        ;; the four shapes that were open -- a not-found argument as
        ;; `(nth v i default)` takes, a trap, a typed abort, or refusing the
        ;; operation -- this takes the TRAP, because that is what the
        ;; neighbours already do: `vector-at` traps out of range, `vector-drop`
        ;; traps, `typed-set-nth` traps, and `nth` WITHOUT a default is
        ;; already the empty-vector trap spelled differently. `pop` needs no
        ;; special case at all for it: an empty vector makes the count 0 and
        ;; the argument -1, and -1 is out of `vector-take`'s range.
        ;;
        ;; The cost is real and is this: a program that does not know its
        ;; vector is non-empty cannot ask these two heads safely, and must
        ;; write `(if (= (count v) 0) ... (peek v))` -- the guard `count` made
        ;; spellable on 2026-09-03. An `[:option T]` return would have carried
        ;; the emptiness in the type instead, and was not taken: it would make
        ;; `peek` the only collection head that does, `(peek (pop v))` would
        ;; stop composing, and `[:option T]` on an `if` arm was measured the
        ;; same day to make wasm32 refuse a whole project. A `(peek v
        ;; not-found)` arity is the cheap widening if one is ever wanted --
        ;; `vector-get` is already the primitive for it -- and is deliberately
        ;; not added here without a caller asking for it.
        (contains? vector-end-operations op)
        (let [rewritten-args
              (mapv #(rewrite-record-projection % locals signatures schemas) args)
              receiver (first rewritten-args)
              ;; As in `count`: this arm REFUSES, so swallowing the receiver's
              ;; own refusal would replace a precise message with `got nil`.
              inferred (when (= 1 (count rewritten-args))
                         (try {:type (infer-expression-type receiver locals signatures)}
                              (catch #?(:clj Exception :cljs :default) e {:refusal e})))
              _ (when-let [refusal (:refusal inferred)] (throw refusal))
              value-type (:type inferred)
              peek? (= op 'peek)
              code (if peek? :kotoba.error/peek-receiver :kotoba.error/pop-receiver)]
          (when-not (= 1 (count rewritten-args))
            (reject! (str op " requires exactly one collection")
                     form (if peek?
                            :kotoba.error/peek-arity
                            :kotoba.error/pop-arity)))
          (if-let [[at-op count-op take-op]
                   (case value-type
                     :vector-i64 '[vector-at vector-count vector-take]
                     :vector-f64 '[vector-f64-at vector-f64-count vector-f64-take]
                     nil)]
            ;; The receiver is bound ONCE. Both readings need it twice -- for
            ;; the count and for the index -- and duplicating the expression
            ;; would evaluate it twice, which for a receiver that traps means
            ;; trapping twice and for one that costs fuel means paying twice.
            ;; This is the shape the heterogeneous `vector-drop` arm above
            ;; already uses for the same reason.
            (let [value-name (synthetic (if peek? "peek" "pop"))
                  last-index (list '- (list count-op value-name) 1)]
              (list 'let [value-name receiver]
                    (if peek?
                      (list at-op value-name last-index)
                      (list take-op value-name last-index))))
            (reject! (str (if peek? "peek" "pop")
                          " takes from the END of a bounded vector, as it does"
                          " in Clojure; got " (pr-str value-type) ". "
                          (or (collection-head-advice value-type)
                              (str "The legacy i64 pair chain is this "
                                   "profile's list, and Clojure reads peek "
                                   "and pop on a list from the FRONT -- but "
                                   "a pair chain and an ordinary integer are "
                                   "the same type here, so that reading "
                                   "cannot be told from reading an integer as "
                                   "a pair. Write first and rest, which lower "
                                   "to pair-first and pair-second and say "
                                   "which was meant")))
                     form code)))

        ;; `keys` and `vals` on a canonical typed map.
        ;;
        ;; Both answer a `[:list T]` in the map's own entry order -- the order
        ;; `typed-map-entry-at` walks -- so `(nth (keys m) i)` and
        ;; `(nth (vals m) i)` name the two halves of one entry. Neither is a
        ;; set: a map's keys are distinct and its VALUES are not, so a set
        ;; carrier for `vals` would silently drop every repeated value and
        ;; answer a shorter collection than the map has entries.
        (contains? map-projection-operations op)
        (let [rewritten-args
              (mapv #(rewrite-record-projection % locals signatures schemas) args)
              receiver (first rewritten-args)
              inferred (when (= 1 (count rewritten-args))
                         (try {:type (infer-expression-type receiver locals signatures)}
                              (catch #?(:clj Exception :cljs :default) e {:refusal e})))
              _ (when-let [refusal (:refusal inferred)] (throw refusal))
              value-type (:type inferred)
              keys? (= op 'keys)
              code (if keys? :kotoba.error/keys-receiver :kotoba.error/vals-receiver)]
          (when-not (= 1 (count rewritten-args))
            (reject! (str op " requires exactly one map")
                     form (if keys?
                            :kotoba.error/keys-arity
                            :kotoba.error/vals-arity)))
          (cond
            (canonical-typed-map-type? value-type)
            (list (if keys? 'typed-map-keys 'typed-map-vals) value-type receiver)

            ;; a `:document` map: its keys / values, as a document vector
            (= :document value-type)
            (list (if keys? doc-keys-helper-name doc-vals-helper-name) receiver)

            :else
            (reject! (str (if keys? "keys" "vals")
                          " projects a canonical typed map; got "
                          (pr-str value-type) ". "
                          (if (= :map value-type)
                            (str "The legacy keyword-keyed bounded map answers "
                                 "to get and assoc and has no projection "
                                 "primitive; write the canonical [:map K V] "
                                 "with typed-map-new to project it")
                            (or (collection-head-advice value-type)
                                (str "Only a canonical [:map K V] has a key "
                                     "and value projection"))))
                     form code)))

        ;; `first` / `second` / `rest` on a bounded vector.
        ;;
        ;; These three desugar to `pair-first` / `pair-first` of `pair-second`
        ;; / `pair-second` before any type is known, so the dispatch has to
        ;; happen on the PAIR heads, here, where the receiver's type is
        ;; inferable. That is also why the fix reaches a `pair-first` written
        ;; literally in the source: after desugaring there is one head, not
        ;; two, and the language authority's own `collections/higher_order`
        ;; fixture spells it that way over a `filter` result -- which is a
        ;; bounded vector, not the pair chain the fixture was written against.
        ;;
        ;; `vector-at` and `vector-drop` are exactly Clojure's `first` and
        ;; `rest` for a vector, and both were already lowered. An EMPTY vector
        ;; traps rather than answering nil, as `nth` without a default does;
        ;; there is no nil in this profile to answer with.
        ;;
        ;; Every OTHER receiver passes through unchanged -- the pair accessors
        ;; are the closure, lazy-cell, cursor and destructuring vocabulary of
        ;; this desugarer, all of them i64 pairs -- so a program that does not
        ;; call one on a vector lowers byte for byte as before.
        (contains? '#{pair-first pair-second} op)
        (let [rewritten-args
              (mapv #(rewrite-record-projection % locals signatures schemas) args)
              receiver (first rewritten-args)
              value-type (when (= 1 (count rewritten-args))
                           (try (infer-expression-type receiver locals signatures)
                                (catch #?(:clj Exception :cljs :default) _ nil)))
              first? (= op 'pair-first)]
          (cond
            ;; `first` / `rest` on a `:document` (a dynamic EDN tree): element 0,
            ;; and everything after it as a vector. `second` is `first` of
            ;; `rest`, so it composes.
            (= :document value-type)
            (if first?
              (list doc-nth-helper-name receiver 0)
              (list doc-rest-helper-name receiver))

            (= :vector-i64 value-type)
            (if first? (list 'vector-at receiver 0) (list 'vector-drop receiver 1))

            ;; ADR 0353 floor :record-list-sequence: `first` of a [:list T]
            ;; is [:option T] -- absent on an empty list, which Clojure
            ;; answers nil -- read through the list's own accessor. The
            ;; receiver is bound once. `rest` of a list stays refused: the
            ;; list has no drop.
            (and first? (canonical-list-type? value-type))
            (let [items (synthetic "first_list")
                  option-type [:option (second value-type)]]
              (list 'let [items receiver]
                    (list 'if (list '< 0 (list 'vector-count items))
                          (list 'option-some-of option-type
                                (list 'typed-list-nth value-type items 0))
                          (list 'option-none-of option-type))))

            (= :vector-f64 value-type)
            (if first?
              (list 'vector-f64-at receiver 0)
              (list 'vector-f64-drop receiver 1))

            (collection-head-advice value-type)
            (reject! (str (if first? "first (pair-first)" "rest (pair-second)")
                          " reads a pair chain or a bounded vector; got "
                          (pr-str value-type) ". "
                          (collection-head-advice value-type))
                     form (if first?
                            :kotoba.error/pair-first-receiver
                            :kotoba.error/pair-second-receiver))

            :else (cons op rewritten-args)))

        ;; ADR 0353 floor :record-list-sequence: the exits of a fused
        ;; `first` search, resolved by the sequence searched. A bounded vector
        ;; keeps what `(first (filter ..))` always answered on it -- the item,
        ;; and the trap `(vector-at <empty result> 0)` raised when nothing
        ;; was found, index 0 of an empty vector -- and a [:list T] answers
        ;; [:option T].
        (contains? '#{__kotoba_seq_found __kotoba_seq_absent} op)
        (let [[items item] (mapv #(rewrite-record-projection % locals signatures schemas) args)
              value-type (infer-expression-type items locals signatures)
              found? (= op '__kotoba_seq_found)]
          (cond
            (canonical-list-type? value-type)
            (if found?
              (list 'option-some-of [:option (second value-type)] item)
              (list 'option-none-of [:option (second value-type)]))
            found? item
            (= :vector-f64 value-type) (list 'vector-f64-at (list 'vector-f64-new) 0)
            :else (list 'vector-at (list 'vector-new) 0)))

        ;; Type-directed numeric resolution: `(+ a b)` on two f64 operands is
        ;; `(f64-add a b)`, on two f32 `(f32-add a b)`; i64 operands are left
        ;; exactly as written, so a program without floats is byte-identical
        ;; before and after this branch. Runs here for the same reason
        ;; `option-or` does: the operand types are known and the descriptor is
        ;; derivable, so the author writes one spelling. Variadic and chained
        ;; comparison forms have already been desugared to binary calls, so
        ;; `(< a b c)` on f64 reaches this as two `<` forms.
        ;; `=` on two `:string` operands is `string=?` (see the `=` arm of
        ;; `infer-call-type-impl`, adr-2609242330). Every other `=` falls
        ;; through to the numeric resolution below, unchanged.
        (and (= op '=) (= 2 (count args))
             (every? #(= :string (try (infer-expression-type % locals signatures)
                                      (catch #?(:clj Exception :cljs :default) _ nil)))
                     args))
        (with-meta (apply list 'string=?
                          (map #(rewrite-record-projection % locals signatures schemas) args))
          {:kotoba.diag/source-head '=})

        ;; ADR 0353 floor :integer-str: `str` is the nested `string-concat` of
        ;; its parts, an :i64 part its decimal digits (`string-from-i64`'s
        ;; printer, injected after this pass). A part of any other type was
        ;; refused by name in `infer-call-type-impl`.
        (= op 'str)
        (let [parts (mapv (fn [arg]
                            (let [part (rewrite-record-projection arg locals signatures schemas)
                                  type (infer-expression-type part locals signatures)]
                              (str-part-type! type part)
                              (if (= :i64 type)
                                ;; `desugar/string-from-i64-helper-name` =
                                ;; '__kotoba_string_from_i64; quoted here because
                                ;; desugar depends on record-projection, not the
                                ;; reverse (same as infer's quote of the name).
                                (list '__kotoba_string_from_i64 part)
                                part)))
                          args)]
          (reduce (fn [acc part] (list 'string-concat acc part))
                  (first parts) (rest parts)))

        ;; `true?` / `integer?` (adr-2609242330): see
        ;; `library-predicate-answer!`. A module's own
        ;; function of the same name wins, as it does in inference.
        (= op '__kotoba_document_of)
        (let [operand (rewrite-record-projection (first args) locals signatures schemas)
              constructor (document-of-constructor!
                           (infer-expression-type operand locals signatures) operand)]
          (if (= :identity constructor) operand (list constructor operand)))

        (and (contains? library-predicate-heads op) (not (contains? signatures op)))
        (let [operand (rewrite-record-projection (first args) locals signatures schemas)
              operand-type (infer-expression-type operand locals signatures)
              answer (library-predicate-answer! op operand-type operand)]
          ;; A constant answer still evaluates the operand (it may be a call
          ;; that traps); `do` keeps it, and keeps the result a form. A
          ;; document is bound once and asked its kind.
          (case answer
            :operand operand
            :negated (list 'bool-not operand)
            :present (option-presence-test operand operand-type)
            :document (let [tmp (synthetic "type-predicate")]
                        (list 'let [tmp operand]
                              (rewrite-record-projection
                               (library-predicate-document-test op tmp)
                               (assoc locals tmp :document) signatures schemas)))
            (list 'do operand answer)))

        (contains? type-directed-numeric-heads op)
        (let [rewritten (mapv #(rewrite-record-projection % locals signatures schemas) args)
              operand-type (fn [arg] (try (infer-expression-type arg locals signatures)
                                          (catch #?(:clj Exception :cljs :default) _ nil)))
              types (mapv operand-type rewritten)
              ;; An f32 operand puts its sibling decimal literal in an `:f32`
              ;; context, the same exact-or-refused narrowing `(f32-add x 1.5)`
              ;; already gets through `contextual-f32-argument-indexes`. The
              ;; literal reaches this pass as the closed `(f64-from-bits N)`
              ;; form desugar produced; nothing but that shape is touched.
              rewritten (if (first-truthy #{:f32} types)
                          (mapv (fn [arg type]
                                  (if (and (= :f64 type) (f64-bits-literal-form? arg))
                                    (list 'f32-from-bits
                                          (f32-literal-bits! (value/i64-bits-to-f64 (second arg))))
                                    arg))
                                rewritten types)
                          rewritten)
              types (if (first-truthy #{:f32} types) (mapv operand-type rewritten) types)]
          (if (and (seq types) (every? #{:f64 :f32} types) (apply = types))
            (resolve-float-operator op (first types) rewritten)
            (cons op rewritten)))

        :else
        ;; Force recursive rewrites while the per-analysis protocol dispatch
        ;; binding is active. A lazy `map` here deferred nested protocol calls
        ;; until validation, after the binding had unwound.
        (cons op (mapv #(rewrite-record-projection % locals signatures schemas) args))))))))

;; The same, with a refusal answered by the form unchanged (the row pass probes with it)
#?(:kotoba
(defn rewrite-record-projection-or [ctx [:ref :ie/ctx] body [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (try (rp-r-form (rp-rewrite (rp-g ctx sigs (ctx-schemas ctx) (form/form-map (form/no-forms))) body locals 0))
       (catch [:ref :fe/err] e body)))
   :default nil)

#?(:kotoba
(defn rp-functions [g [:ref :ana/g] functions [:ref :form/r] i :i64 n :i64 acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of functions))
    (form/form-vec acc)
    (let [f (form/nth-of functions i)
          r (rp-rewrite g (fget f :body) (zip-locals (fget f :params) (fget f :param-types)) n)]
      (rp-functions g functions (+ i 1) (rp-r-n r) (form/append-form acc (fput f :body (rp-r-form r)))))))
   :default nil)

#?(:kotoba
;; Apply `rewrite-record-projection` to every function body (one counter for the whole list).
(defn rewrite-record-projections [ctx [:ref :ie/ctx] functions [:ref :form/r] schemas [:ref :form/r] dispatch [:ref :form/r]] [:ref :form/r]
  (rp-functions (rp-g ctx (abort-signatures functions) schemas dispatch) functions 0 0 (form/no-forms)))
   :default
(defn rewrite-record-projections
  "Apply `rewrite-record-projection` to every function body. Only modules that
  declare param types can resolve the sugar; untyped modules are left alone and
  a 2-arity `record-get` there fails closed in validation as before."
  ([functions] (rewrite-record-projections functions {} {}))
  ([functions schemas] (rewrite-record-projections functions schemas {}))
  ([functions schemas protocol-dispatch]
   (let [signatures (into {} (map (fn [{:keys [name params param-types result]}]
                                    [name {:params params :param-types param-types
                                           :result result}])
                                  functions))]
     ;; Every body, including a parameterless one. The guard used to be
     ;; `(seq param-types)`, on the reading that a function with no parameters
     ;; has no local types to resolve against -- true for the 2-arity
     ;; `record-get` sugar, and false for everything else this pass does.
     ;;
     ;; A `[:ref :ns/name]` in `record-new`/`record-assoc`/`record-equal`
     ;; resolves through the namespace's `:schemas` map, not through locals, so
     ;; skipping the body left the reference unresolved and validation rejected
     ;; the program:
     ;;
     ;;   (defn f [] [:ref :p/n] (record-new [:ref :p/n] 1 5))
     ;;   -> record constructor must exactly match its descriptor
     ;;   (defn f [x :i64] [:ref :p/n] (record-new [:ref :p/n] x 5))
     ;;   -> compiles
     ;;
     ;; Adding one unused parameter made the same program legal, which is the
     ;; shape of a bug rather than a rule. `rewrite-record-projection` already
     ;; tolerates an empty locals map -- it only consults locals for inference,
     ;; and an untypeable binding is allowed to have no known type there.
     ;; This rewrite may synthesize exact heterogeneous-vector suffix
     ;; bindings after the parse/desugar binding has unwound. Give that pass
     ;; its own source-order counter instead of falling back to gensym, so KIR
     ;; and conformance digests stay reproducible across compiler processes.
     ;; Prefixes are reserved and distinct from earlier desugar temporaries,
     ;; so restarting the counter here cannot collide with authored or
     ;; previously synthesized bindings.
     (binding [*record-protocol-dispatch* protocol-dispatch
               *synthetic-counter* (volatile! 0)]
       (mapv (fn [{:keys [params param-types] :as f}]
               (update f :body rewrite-record-projection
                       (zipmap params param-types) signatures schemas))
             functions))))))
