(ns kotoba.compiler.frontend.export-forms
  #?(:kotoba {:kotoba/export [an-exports an-public-sources]})
  (:require #?@(:kotoba [[kotoba.form :as form]
                         [kotoba.compiler.frontend.base :refer [fget ftruthy? fl-has? fl-nth fl-slice]]
                         [kotoba.compiler.frontend.implicit-exports :refer [implicit-export-exclusions intrinsic-helper-name?]]]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

#?(:kotoba
(defn- ef-set-has? [s [:ref :form/r] x [:ref :form/r]] :bool
  (fl-has? (form/kids-of s) x 0))
   :default nil)

;; the clauses (function parts) named SOURCE-NAME, sorted by logical arity, as the names a multi-arity export expands to
#?(:kotoba
(defn an-expand-export [source-name [:ref :form/r] parts [:ref :form/r]] [:ref :form/r]
  (let [clauses (an-clauses-of parts source-name 0 (form/no-forms))]
    (if (> (vector-count clauses) 1)
      (form/form-vec (an-clause-names (an-sort-clauses clauses 0 (form/no-forms)) 0 (form/no-forms)))
      (form/form-vec (form/one-form source-name)))))
   :default nil)

#?(:kotoba
(defn an-clauses-of [parts [:ref :form/r] sn [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of parts))
    acc
    (an-clauses-of parts sn (+ i 1) (if (form/eq (fget (form/nth-of parts i) :source-name) sn) (form/append-form acc (form/nth-of parts i)) acc))))
   :default nil)

#?(:kotoba
(defn an-clause-key [c [:ref :form/r]] :i64
  (let [la (fget c :logical-arity)]
    (if (ftruthy? la) (form/int-value la) 0)))
   :default nil)

#?(:kotoba
(defn an-insert-clause [xs [:list [:ref :form/r]] c [:ref :form/r] i :i64] [:list [:ref :form/r]]
  (if (or (>= i (vector-count xs)) (> (an-clause-key (fl-nth xs i)) (an-clause-key c)))
    (fl-slice xs i (vector-count xs) (form/append-form (fl-slice xs 0 i (form/no-forms)) c))
    (an-insert-clause xs c (+ i 1))))
   :default nil)

#?(:kotoba
(defn an-sort-clauses [clauses [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (vector-count clauses))
    acc
    (an-sort-clauses clauses (+ i 1) (an-insert-clause acc (fl-nth clauses i) 0))))
   :default nil)

#?(:kotoba
(defn an-clause-names [clauses [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (vector-count clauses))
    acc
    (an-clause-names clauses (+ i 1) (form/append-form acc (fget (fl-nth clauses i) :name)))))
   :default nil)

#?(:kotoba
(defn an-export-names [exports [:ref :form/r] parts [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of exports))
    acc
    (an-export-names exports parts (+ i 1) (form/append-many acc (form/kids-of (an-expand-export (form/nth-of exports i) parts))))))
   :default nil)

#?(:kotoba
(defn an-public-sources [parts [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of parts))
    acc
    (let [p (form/nth-of parts i)]
      (an-public-sources parts (+ i 1) (if (and (ftruthy? (fget p :public?)) (not (fl-has? acc (fget p :source-name) 0))) (form/append-form acc (fget p :source-name)) acc)))))
   :default nil)

#?(:kotoba
(defn an-any-private-non-intrinsic? [parts [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of parts))
    false
    (let [p (form/nth-of parts i)]
      (or (and (not (ftruthy? (fget p :public?))) (not (intrinsic-helper-name? (fget p :source-name))))
          (an-any-private-non-intrinsic? parts (+ i 1))))))
   :default nil)

#?(:kotoba
(defn an-names-without [fns [:ref :form/r] excluded [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of fns))
    acc
    (let [n (fget (form/nth-of fns i) :name)]
      (an-names-without fns excluded (+ i 1) (if (ef-set-has? excluded n) acc (form/append-form acc n))))))
   :default nil)

#?(:kotoba
(defn an-all-names [fns [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of fns))
    acc
    (an-all-names fns (+ i 1) (form/append-form acc (fget (form/nth-of fns i) :name)))))
   :default nil)

;; the exports of the module: the namespace's list expanded, the public functions, or every function but the implicit exclusions
#?(:kotoba
(defn an-exports [ns-info [:ref :form/r] parts [:ref :form/r] parsed [:ref :form/r] aet [:ref :form/r]] [:ref :form/r]
  (let [e (fget ns-info :exports)]
    (cond
      (ftruthy? e) (form/form-vec (an-export-names e parts 0 (form/no-forms)))
      (an-any-private-non-intrinsic? parts 0) (form/form-vec (an-export-names (form/form-vec (an-public-sources parts 0 (form/no-forms))) parts 0 (form/no-forms)))
      :else (form/form-vec (an-names-without parsed (implicit-export-exclusions parsed aet) 0 (form/no-forms))))))
   :default nil)

