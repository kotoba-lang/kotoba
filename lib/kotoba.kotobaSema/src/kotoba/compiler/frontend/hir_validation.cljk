(ns kotoba.compiler.frontend.hir-validation
  #?(:kotoba {:kotoba/export [valid?]})
  (:require #?@(:kotoba [[kotoba.form :as form]
                         [kotoba.compiler.frontend.base :refer [fget fl-has?]]]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

#?(:kotoba
(defn- hv-set-has? [s [:ref :form/r] x [:ref :form/r]] :bool
  (fl-has? (form/kids-of s) x 0))
   :default nil)

#?(:kotoba
(defn- hv-set-add [s [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
  (if (fl-has? (form/kids-of s) x 0)
    s
    (form/form-set (form/append-form (form/kids-of s) x))))
   :default nil)

#?(:kotoba
(defn- hv-empty-set [] [:ref :form/r] (form/form-set (form/no-forms)))
   :default nil)

#?(:kotoba
(defn- hv-map-has? [m [:ref :form/r] k :keyword] :bool
  (form/form-has? m (form/keyword-form k)))
   :default nil)

#?(:kotoba
(defn- hv-module-key? [k [:ref :form/r]] :bool
  (or (form/eq k (form/keyword-form :format))
      (form/eq k (form/keyword-form :namespace))
      (form/eq k (form/keyword-form :schemas))
      (form/eq k (form/keyword-form :schema-identities))
      (form/eq k (form/keyword-form :entry))
      (form/eq k (form/keyword-form :exports))
      (form/eq k (form/keyword-form :result))
      (form/eq k (form/keyword-form :effects))
      (form/eq k (form/keyword-form :named-operations))
      (form/eq k (form/keyword-form :language-profile))
      (form/eq k (form/keyword-form :functions))))
   :default nil)

#?(:kotoba
(defn- hv-function-key? [k [:ref :form/r]] :bool
  (or (form/eq k (form/keyword-form :name))
      (form/eq k (form/keyword-form :params))
      (form/eq k (form/keyword-form :result))
      (form/eq k (form/keyword-form :effects))
      (form/eq k (form/keyword-form :body))
      (form/eq k (form/keyword-form :source-name))
      (form/eq k (form/keyword-form :param-types))
      (form/eq k (form/keyword-form :result-inferred?))
      (form/eq k (form/keyword-form :effects-ceiling))
      (form/eq k (form/keyword-form :closure-param-indexes))
      (form/eq k (form/keyword-form :i64-pair-chain-param-indexes))
      (form/eq k (form/keyword-form :closure-result?))
      (form/eq k (form/keyword-form :lazy-thunk?))
      (form/eq k (form/keyword-form :loop-helper?))
      (form/eq k (form/keyword-form :callable-param-contracts))
      (form/eq k (form/keyword-form :callable-result-contract))))
   :default nil)

#?(:kotoba
(defn- hv-keys-valid? [m [:ref :form/r] i :i64 module? :bool] :bool
  (if (>= i (form/count-of m))
    true
    (let [k (form/nth-of m i)]
      (and (form/is-keyword? k)
           (if module? (hv-module-key? k) (hv-function-key? k))
           (hv-keys-valid? m (+ i 2) module?)))))
   :default nil)

#?(:kotoba
(defn- hv-closed-map? [m [:ref :form/r] module? :bool] :bool
  (and (form/is-map? m)
       (= 0 (rem (form/count-of m) 2))
       (hv-keys-valid? m 0 module?)))
   :default nil)

#?(:kotoba
(defn- hv-bounded-kids-count [kids [:list [:ref :form/r]] i :i64 depth :i64 nodes :i64] :i64
  (if (>= i (vector-count kids))
    nodes
    (let [next-nodes (hv-bounded-form (typed-list-nth [:list [:ref :form/r]] kids i) depth nodes)]
      (if (< next-nodes 0) -1 (hv-bounded-kids-count kids (+ i 1) depth next-nodes)))))
   :default nil)

#?(:kotoba
(defn- hv-bounded-form [x [:ref :form/r] depth :i64 nodes :i64] :i64
  (if (or (> depth 256) (>= nodes 1000000))
    -1
    (hv-bounded-kids-count (form/kids-of x) 0 (+ depth 1) (+ nodes 1))))
   :default nil)

#?(:kotoba
(defn- hv-portable? [x [:ref :form/r]] :bool
  (>= (hv-bounded-form x 0 0) 0))
   :default nil)

#?(:kotoba
(defn- hv-symbols-valid? [xs [:ref :form/r] i :i64 seen [:ref :form/r]] :bool
  (if (>= i (form/count-of xs))
    true
    (let [x (form/nth-of xs i)]
      (and (form/is-symbol? x)
           (not (hv-set-has? seen x))
           (hv-symbols-valid? xs (+ i 1) (hv-set-add seen x))))))
   :default nil)

#?(:kotoba
(defn- hv-effects-valid? [effects [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of effects))
    true
    (let [effect (form/nth-of effects i)
          cap-call? (and (form/is-vec? effect)
                         (= (form/count-of effect) 2)
                         (form/eq (form/nth-of effect 0) (form/keyword-form :cap/call))
                         (form/is-int? (form/nth-of effect 1))
                         (>= (form/int-value (form/nth-of effect 1)) 0))]
      (and (or (form/eq effect (form/keyword-form :abort))
               (form/eq effect (form/keyword-form :state))
               cap-call?)
           (hv-effects-valid? effects (+ i 1))))))
   :default nil)

#?(:kotoba
(defn- hv-effects-subset? [effects [:ref :form/r] ceiling [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of effects))
    true
    (and (hv-set-has? ceiling (form/nth-of effects i))
         (hv-effects-subset? effects ceiling (+ i 1)))))
   :default nil)

#?(:kotoba
(defn- hv-effects-equal? [a [:ref :form/r] b [:ref :form/r]] :bool
  (and (= (form/count-of a) (form/count-of b))
       (hv-effects-subset? a b 0)
       (hv-effects-subset? b a 0)))
   :default nil)

#?(:kotoba
(defn- hv-indexes-valid? [indexes [:ref :form/r] i :i64 parameter-count :i64 seen [:ref :form/r]] :bool
  (if (>= i (form/count-of indexes))
    true
    (let [x (form/nth-of indexes i)]
      (and (form/is-int? x)
           (>= (form/int-value x) 0)
           (< (form/int-value x) parameter-count)
           (not (hv-set-has? seen x))
           (hv-indexes-valid? indexes (+ i 1) parameter-count (hv-set-add seen x))))))
   :default nil)

#?(:kotoba
(defn- hv-contract-keys-valid? [contracts [:ref :form/r] i :i64 parameter-count :i64] :bool
  (if (>= i (form/count-of contracts))
    true
    (let [index (form/nth-of contracts i)]
      (and (form/is-int? index)
           (>= (form/int-value index) 0)
           (< (form/int-value index) parameter-count)
           (hv-contract-keys-valid? contracts (+ i 2) parameter-count)))))
   :default nil)

#?(:kotoba
(defn- hv-function-valid? [f [:ref :form/r] format [:ref :form/r]] :bool
  (let [name (fget f :name)
        source-name (fget f :source-name)
        params (fget f :params)
        param-types (fget f :param-types)
        effects (fget f :effects)
        ceiling (fget f :effects-ceiling)
        contracts (fget f :callable-param-contracts)
        typed? (form/eq format (form/keyword-form :kotoba.hir/v3))
        closure-indexes (fget f :closure-param-indexes)
        pair-indexes (fget f :i64-pair-chain-param-indexes)]
    (and (hv-closed-map? f false)
         (hv-map-has? f :name)
         (hv-map-has? f :params)
         (hv-map-has? f :result)
         (hv-map-has? f :effects)
         (hv-map-has? f :body)
         (form/is-symbol? name)
         (or (form/is-nil? source-name) (form/is-symbol? source-name))
         (form/is-vec? params)
         (hv-symbols-valid? params 0 (hv-empty-set))
         (if typed?
           (and (form/is-vec? param-types)
                (= (form/count-of params) (form/count-of param-types)))
           (not (hv-map-has? f :param-types)))
         (form/is-set? effects)
         (hv-effects-valid? effects 0)
         (if (hv-map-has? f :effects-ceiling)
           (and (form/is-set? ceiling)
                (hv-effects-valid? ceiling 0)
                (hv-effects-subset? effects ceiling 0))
           true)
         (if (hv-map-has? f :closure-param-indexes)
           (and (form/is-vec? closure-indexes)
                (hv-indexes-valid? closure-indexes 0 (form/count-of params) (hv-empty-set)))
           true)
         (if (hv-map-has? f :i64-pair-chain-param-indexes)
           (and (form/is-vec? pair-indexes)
                (hv-indexes-valid? pair-indexes 0 (form/count-of params) (hv-empty-set)))
           true)
         (if (hv-map-has? f :closure-result?) (form/is-bool? (fget f :closure-result?)) true)
         (if (hv-map-has? f :lazy-thunk?) (form/is-bool? (fget f :lazy-thunk?)) true)
         (if (hv-map-has? f :loop-helper?) (form/is-bool? (fget f :loop-helper?)) true)
         (if (hv-map-has? f :result-inferred?)
           (or (form/is-nil? (fget f :result-inferred?)) (form/is-bool? (fget f :result-inferred?)))
           true)
         (if (hv-map-has? f :callable-param-contracts)
           (and (form/is-map? contracts)
                (= 0 (rem (form/count-of contracts) 2))
                (hv-contract-keys-valid? contracts 0 (form/count-of params)))
           true)
         (not (form/is-nil? (fget f :body)))
         (hv-portable? (fget f :result))
         (or (not typed?) (hv-portable? param-types))
         (or (not (hv-map-has? f :callable-result-contract))
             (hv-portable? (fget f :callable-result-contract)))
         (or (not (hv-map-has? f :callable-param-contracts))
             (hv-portable? contracts))
         (hv-portable? (fget f :body)))))
   :default nil)

#?(:kotoba
(defn- hv-functions-valid? [functions [:ref :form/r] i :i64 format [:ref :form/r] names [:ref :form/r]] :bool
  (if (>= i (form/count-of functions))
    true
    (let [f (form/nth-of functions i)
          name (fget f :name)]
      (and (hv-function-valid? f format)
           (not (hv-set-has? names name))
           (hv-functions-valid? functions (+ i 1) format (hv-set-add names name))))))
   :default nil)

#?(:kotoba
(defn- hv-function-names [functions [:ref :form/r] i :i64 names [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of functions))
    names
    (hv-function-names functions (+ i 1) (hv-set-add names (fget (form/nth-of functions i) :name)))))
   :default nil)

#?(:kotoba
(defn- hv-exports-valid? [exports [:ref :form/r] i :i64 names [:ref :form/r] seen [:ref :form/r]] :bool
  (if (>= i (form/count-of exports))
    true
    (let [name (form/nth-of exports i)]
      (and (form/is-symbol? name)
           (hv-set-has? names name)
           (not (hv-set-has? seen name))
           (hv-exports-valid? exports (+ i 1) names (hv-set-add seen name))))))
   :default nil)

#?(:kotoba
(defn- hv-effect-union [row [:ref :form/r] i :i64 effects [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of row))
    effects
    (hv-effect-union row (+ i 1) (hv-set-add effects (form/nth-of row i)))))
   :default nil)

#?(:kotoba
(defn- hv-all-effects [functions [:ref :form/r] i :i64 effects [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of functions))
    effects
    (let [row (fget (form/nth-of functions i) :effects)
          next-effects (hv-effect-union row 0 effects)]
      (hv-all-effects functions (+ i 1) next-effects))))
   :default nil)

#?(:kotoba
(defn- hv-function-by-name [functions [:ref :form/r] i :i64 name [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of functions))
    (form/nil-form)
    (let [f (form/nth-of functions i)]
      (if (form/eq name (fget f :name)) f (hv-function-by-name functions (+ i 1) name)))))
   :default nil)

#?(:kotoba
(defn- hv-exported? [exports [:ref :form/r] i :i64 name [:ref :form/r]] :bool
  (if (>= i (form/count-of exports))
    false
    (or (form/eq (form/nth-of exports i) name)
        (hv-exported? exports (+ i 1) name))))
   :default nil)

#?(:kotoba
(defn- hv-named-operations-valid? [ops [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of ops))
    true
    (and (form/is-keyword? (form/nth-of ops i))
         (hv-named-operations-valid? ops (+ i 1)))))
   :default nil)

#?(:kotoba
(defn valid? [hir [:ref :form/r]] :bool
  (let [format (fget hir :format)
        namespace (fget hir :namespace)
        schemas (fget hir :schemas)
        identities (fget hir :schema-identities)
        entry (fget hir :entry)
        exports (fget hir :exports)
        result (fget hir :result)
        effects (fget hir :effects)
        operations (fget hir :named-operations)
        profile (fget hir :language-profile)
        functions (fget hir :functions)
        names (if (form/is-vec? functions) (hv-function-names functions 0 (hv-empty-set)) (hv-empty-set))
        entry-function (if (or (form/is-nil? entry) (not (form/is-vec? functions)))
                         (form/nil-form)
                         (hv-function-by-name functions 0 entry))]
    (and (hv-closed-map? hir true)
         (hv-map-has? hir :format)
         (hv-map-has? hir :namespace)
         (hv-map-has? hir :schemas)
         (hv-map-has? hir :schema-identities)
         (hv-map-has? hir :entry)
         (hv-map-has? hir :exports)
         (hv-map-has? hir :result)
         (hv-map-has? hir :effects)
         (hv-map-has? hir :named-operations)
         (hv-map-has? hir :language-profile)
         (hv-map-has? hir :functions)
         (or (form/eq format (form/keyword-form :kotoba.hir/v2))
             (form/eq format (form/keyword-form :kotoba.hir/v3)))
         (or (form/is-nil? namespace) (form/is-symbol? namespace))
         (or (form/is-nil? schemas) (form/is-map? schemas))
         (or (form/is-nil? identities) (form/is-map? identities))
         (or (form/is-nil? profile) (form/is-keyword? profile))
         (form/is-vec? functions)
         (> (form/count-of functions) 0)
         (hv-functions-valid? functions 0 format (hv-empty-set))
         (form/is-vec? exports)
         (hv-exports-valid? exports 0 names (hv-empty-set))
         (or (form/is-nil? entry)
             (and (form/is-symbol? entry)
                  (hv-set-has? names entry)
                  (hv-exported? exports 0 entry)))
         (if (form/is-nil? entry)
           (form/is-nil? result)
           (form/eq result (fget entry-function :result)))
         (form/is-set? effects)
         (hv-effects-valid? effects 0)
         (hv-effects-equal? effects (hv-all-effects functions 0 (hv-empty-set)))
         (form/is-set? operations)
         (hv-named-operations-valid? operations 0)
         (hv-portable? schemas)
         (hv-portable? identities))))
   :default nil)

