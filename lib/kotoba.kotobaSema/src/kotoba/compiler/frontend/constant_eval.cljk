;; Kotoba constant-fold probes and execution stay inside typed Form modules.
(ns kotoba.compiler.frontend.constant-eval
  {:kotoba/export [probe-program eval-constant]}
  (:require [kotoba.form :as form]
            [kotoba.runtime.evaluator :as evaluator])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                      [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
             :runtime/eval-out [:record :runtime/eval-out
                                [[:ok :bool] [:value [:ref :form/r]]
                                 [:error :string] [:fuel :i64]]]}))

(defn- prior-def-forms [prior [:ref :form/r] index :i64
                        forms [:list [:ref :form/r]]]
  [:list [:ref :form/r]]
  (if (>= index (form/count-of prior))
    forms
    (let [entry (form/nth-of prior index)
          declaration (form/form-seq
                       (form/three-forms (form/symbol-form "def")
                                         (form/nth-of entry 0)
                                         (form/nth-of entry 1)))]
      (prior-def-forms prior (+ index 1)
                       (form/append-form forms declaration)))))

(defn probe-program [prior [:ref :form/r] value [:ref :form/r]]
  [:ref :form/r]
  "Build the same typed probe shape used by the host KIR constant oracle."
  (let [function-name (form/symbol-form "kotoba-fold-value")
        namespace-form
        (form/form-seq
         (form/three-forms
          (form/symbol-form "ns")
          (form/symbol-form "kotoba.constant-fold.probe")
          (form/form-map
           (form/two-forms
            (form/keyword-form :kotoba/export)
            (form/form-vec (form/one-form function-name))))))
        parameter-vector (form/form-vec (form/no-forms))
        function-form
        (form/form-seq
         (form/append-form
          (form/three-forms (form/symbol-form "defn") function-name parameter-vector)
          value))
        forms (prior-def-forms prior 0 (form/one-form namespace-form))]
    (form/form-vec (form/append-form forms function-form))))

(defn- prior-globals [prior [:ref :form/r] index :i64
                      globals [:ref :form/r]]
  [:ref :form/r]
  (if (>= index (form/count-of prior))
    globals
    (let [entry (form/nth-of prior index)]
      (prior-globals prior (+ index 1)
                     (form/assoc-form globals
                                      (form/nth-of entry 0)
                                      (form/nth-of entry 1))))))

(defn eval-constant [value [:ref :form/r] prior [:ref :form/r] fuel :i64]
  [:ref :runtime/eval-out]
  "Evaluate a previously admitted, function-free constant expression using
  the Kotoba runtime evaluator and its shared fuel counter."
  (evaluator/eval-expression
   value (prior-globals prior 0 (form/form-map (form/no-forms))) fuel))
