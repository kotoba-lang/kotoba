(ns kotoba.compiler.frontend.inference-signatures
  "Pure signature preparation helpers for result inference."
  #?(:kotoba {:kotoba/export [repeat-i64-types with-default-param-types inference-dispatchers]})
  (:require #?@(:kotoba [[kotoba.form :as form]])
            [kotoba.compiler.frontend.base :refer [#?@(:kotoba [fget fput ftruthy?] :default [])]]
            #?@(:kotoba [[kotoba.compiler.frontend.closure-types :refer [invoke-dispatcher-name]]]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

#?(:kotoba
(defn repeat-i64-types [n :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (<= n 0)
    acc
    (repeat-i64-types (- n 1) (form/append-form acc (form/keyword-form :i64)))))
   :default nil)

#?(:kotoba
(defn with-default-param-types [fns [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of fns))
    (form/form-vec acc)
    (let [f (form/nth-of fns i)]
      (with-default-param-types fns (+ i 1)
                                (form/append-form acc (if (ftruthy? (fget f :param-types))
                                                        f
                                                        (fput f :param-types
                                                              (form/form-vec
                                                               (repeat-i64-types (form/count-of (fget f :params))
                                                                                 (form/no-forms))))))))))
   :default nil)

#?(:kotoba
(defn- inference-arg-names [arity :i64 i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i arity)
    acc
    (inference-arg-names arity (+ i 1)
                         (form/append-form acc
                                           (form/symbol-form
                                            (string-concat "__kotoba_inference_arg_"
                                                           (string-from-i64 i)))))))
   :default nil)

#?(:kotoba
(defn inference-dispatchers [requested [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :form/r]
  "Build signature-only functions for requested closure dispatchers."
  (if (>= i (form/count-of requested))
    (form/form-vec acc)
    (let [key (form/nth-of requested i)
          result-type (form/nth-of key 0)
          arity (form/int-value (form/nth-of key 1))
          param-types (if (> (form/count-of key) 2) (form/nth-of key 2) (form/nil-form))
          name (invoke-dispatcher-name result-type arity param-types)
          params (form/form-vec
                  (form/cons-onto (form/symbol-form "__kotoba_inference_closure")
                                  (inference-arg-names arity 0 (form/no-forms))))
          types (if (ftruthy? param-types)
                  (form/form-vec
                   (form/cons-onto (form/keyword-form :i64) (form/kids-of param-types)))
                  (form/form-vec (repeat-i64-types (+ arity 1) (form/no-forms))))
          signature-function (fput (fput (fput (fput (form/form-map (form/no-forms)) :name name)
                                                  :params params)
                                            :param-types types)
                                      :result result-type)
          with-result-flag (fput signature-function :result-inferred? (form/bool-form false))
          function-form (fput with-result-flag :body (form/int-form 0))]
      (inference-dispatchers requested (+ i 1) (form/append-form acc function-form)))))
   :default nil)
