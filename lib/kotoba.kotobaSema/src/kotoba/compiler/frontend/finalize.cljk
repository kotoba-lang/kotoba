(ns kotoba.compiler.frontend.finalize
  #?(:kotoba {:kotoba/export [finish-hir]})
  (:require #?@(:kotoba [[kotoba.form :as form]
                         [kotoba.compiler.frontend.base :refer [capability-id->name check-abort-facet-unwind! fget fkw fl-add fl-has? fl-nth fl-slice fput ftruthy? form-text pr-form]]
                         [kotoba.compiler.frontend-tables :as tables]
                         [kotoba.compiler.frontend.hir-values :as hir-values]
                         [kotoba.compiler.frontend.effect-inference :refer [infer-effects]]
                         [kotoba.compiler.frontend.state-ability :refer [state-refuse-impure-handler!]]]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]] [:phase :string] [:data [:ref :form/r]]]]})))

#?(:kotoba
(defn- fin-empty-set [] [:ref :form/r] (form/form-set (form/no-forms)))
   :default nil)

#?(:kotoba
(defn- fin-empty-map [] [:ref :form/r] (form/form-map (form/no-forms)))
   :default nil)

#?(:kotoba
(defn- fin-set-has? [s [:ref :form/r] x [:ref :form/r]] :bool
  (fl-has? (form/kids-of s) x 0))
   :default nil)

#?(:kotoba
(defn- fin-set-add [s [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
  (if (fin-set-has? s x) s (form/form-set (form/append-form (form/kids-of s) x))))
   :default nil)

#?(:kotoba
(defn- fin-set-union [a [:ref :form/r] b [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of b)) a
      (fin-set-union (fin-set-add a (form/nth-of b i)) b (+ i 1))))
   :default nil)

#?(:kotoba
(defn- fin-union-all [tables [:list [:ref :form/r]] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (vector-count tables))
    acc
    (fin-union-all tables (+ i 1) (fin-set-union acc (fl-nth tables i) 0))))
   :default nil)

#?(:kotoba
(defn- fin-fail [bad? :bool msg :string code :string form [:ref :form/r]] :i64
  (if bad?
    (throw (record-new [:ref :fe/err] msg code form "subset" (form/nil-form)))
    0))
   :default nil)

#?(:kotoba
(defn- fin-fail-phase [bad? :bool msg :string code :string form [:ref :form/r]
                      phase :string data [:ref :form/r]] :i64
  (if bad?
    (throw (record-new [:ref :fe/err] msg code form phase data))
    0))
   :default nil)

#?(:kotoba
(defn- fin-sym-is? [f [:ref :form/r] name :string] :bool
  (and (form/is-symbol? f) (string=? (form/symbol-value f) name)))
   :default nil)

#?(:kotoba
(defn- fin-insert-kw [xs [:list [:ref :form/r]] x [:ref :form/r] i :i64] [:list [:ref :form/r]]
  (if (or (>= i (vector-count xs)) (> (string-compare (form-text (fl-nth xs i)) (form-text x)) 0))
    (fl-slice xs i (vector-count xs) (form/append-form (fl-slice xs 0 i (form/no-forms)) x))
    (fin-insert-kw xs x (+ i 1))))
   :default nil)

#?(:kotoba
(defn- fin-sort-kws [xs [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of xs))
    (form/form-set acc)
    (fin-sort-kws xs (+ i 1) (fin-insert-kw acc (form/nth-of xs i) 0))))
   :default nil)

#?(:kotoba
(defn- fin-set-difference [a [:ref :form/r] b [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of a))
    (form/form-set acc)
    (fin-set-difference a b (+ i 1) (if (fin-set-has? b (form/nth-of a i)) acc (form/append-form acc (form/nth-of a i))))))
   :default nil)

#?(:kotoba
(defn- fin-typed-heads [] [:ref :form/r]
  (let [l0 (form/no-forms)
        l1 (form/append-form l0 (tables/typed-map-operations))
        l2 (form/append-form l1 (tables/typed-safe-value-operations))
        l3 (form/append-form l2 (tables/parametric-result-operations))
        l4 (form/append-form l3 (tables/variant-operations))
        l5 (form/append-form l4 (tables/generic-option-operations))
        l6 (form/append-form l5 (tables/canonical-list-operations))
        l7 (form/append-form l6 (tables/bytes-operations))
        l8 (form/append-form l7 (tables/heterogeneous-vector-operations))
        l9 (form/append-form l8 (tables/typed-set-operations))
        l10 (form/append-form l9 (tables/canonical-typed-map-operations))
        l11 (form/append-form l10 (tables/record-operations))
        l12 (form/append-form l11 (tables/typed-vector-operations))
        l13 (form/append-form l12 (tables/typed-f64-vector-operations))
        l14 (form/append-form l13 (tables/document-fixed-operations))
        l15 (form/append-form l14 (tables/document-variadic-operations))
        l16 (form/append-form l15 (tables/i32-operations))
        l17 (form/append-form l16 (tables/f64-operations))
        l18 (form/append-form l17 (tables/f32-operations))
        l19 (form/append-form l18 (tables/decimal-operations))
        extra (form/form-set (form/two-forms (form/symbol-form "vector-new") (form/symbol-form "vector-f64-new")))]
    (fin-set-union (fin-union-all l19 0 (fin-empty-set)) extra 0)))
   :default nil)
#?(:kotoba
(defn- fin-scalar-types [] [:ref :form/r]
  (form/edn-form "#{:bool :f32 :f64 :string :keyword :map :bytes :option-i64 :result-i64 :vector-i64 :vector-f64 :string-index :disjoint-set-i64 :document}"))
   :default nil)
#?(:kotoba
(defn- fin-result-scalar-types [] [:ref :form/r]
  (form/edn-form "#{:f32 :f64 :string :keyword :map :bytes :option-i64 :result-i64 :vector-i64 :vector-f64 :string-index :disjoint-set-i64 :document}"))
   :default nil)
#?(:kotoba
(defn- fin-effect-name [effect [:ref :form/r]] [:ref :form/r]
  (if (and (form/is-vec? effect) (> (form/count-of effect) 1))
    (let [n (form/form-get (capability-id->name) (form/nth-of effect 1))]
      (if (form/is-nil? n) effect n))
    effect))
   :default nil)
#?(:kotoba
(defn- fin-effect-names [row [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of row))
    acc
    (fin-effect-names row (+ i 1) (fl-add acc (fin-effect-name (form/nth-of row i))))))
   :default nil)
#?(:kotoba
(defn- fin-sorted-effect-set [row [:ref :form/r]] [:ref :form/r]
  (fin-sort-kws (form/form-vec (fin-effect-names row 0 (form/no-forms))) 0 (form/no-forms)))
   :default nil)
#?(:kotoba
(defn- fin-effects-of-fn [function-effects [:ref :form/r] name [:ref :form/r]] [:ref :form/r]
  (let [e (form/form-get function-effects name)]
    (if (form/is-nil? e) (fin-empty-set) e)))
   :default nil)
#?(:kotoba
(defn- fin-handler-purity [fns [:ref :form/r] i :i64 function-effects [:ref :form/r] handlers [:ref :form/r]] :i64
  (if (>= i (form/count-of fns))
    0
    (let [f (form/nth-of fns i)
          clause (fget f :state-handler-clause)
          row (fin-effects-of-fn function-effects (fget f :name))
          u_1 (fin-handler-purity-one clause row f handlers)]
      (fin-handler-purity fns (+ i 1) function-effects handlers))))
   :default nil)
#?(:kotoba
(defn- fin-handler-purity-one [clause [:ref :form/r] row [:ref :form/r] f [:ref :form/r] handlers [:ref :form/r]] :i64
  (if (and (ftruthy? clause) (> (form/count-of row) 0))
    (state-refuse-impure-handler! (fget (form/form-get handlers (fget clause :handler)) :name) (fget clause :op) (fin-sorted-effect-set row) (fget f :body))
    0))
   :default nil)
#?(:kotoba
(defn- fin-thunk-effects [fns [:ref :form/r] i :i64 function-effects [:ref :form/r]] :i64
  (if (>= i (form/count-of fns))
    0
    (let [f (form/nth-of fns i)
          u_1 (fin-fail (and (ftruthy? (fget f :lazy-thunk?)) (> (form/count-of (fin-effects-of-fn function-effects (fget f :name))) 0))
                     "lazy sequence thunks must be effect-free because forcing is non-memoized" "kotoba.error/subset-reject" (fget f :name))]
      (fin-thunk-effects fns (+ i 1) function-effects))))
   :default nil)
#?(:kotoba
(defn- fin-excess-ops [excess [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of excess))
    acc
    (fin-excess-ops excess (+ i 1) (let [e (form/nth-of excess i)]
                                   (if (form/is-vec? e)
                                     (let [n (form/form-get (capability-id->name) (form/nth-of e 1))] (if (form/is-nil? n) acc (fl-add acc n)))
                                     (fl-add acc e))))))
   :default nil)
#?(:kotoba
(defn- fin-ceiling-fail [f [:ref :form/r] inferred [:ref :form/r] ceiling [:ref :form/r] excess [:ref :form/r]] :i64
  (let [ops (fin-sort-kws (form/form-vec (fin-excess-ops excess 0 (form/no-forms))) 0 (form/no-forms))
        sn (fget f :source-name)
        data (form/assoc-form (form/assoc-form (form/assoc-form (form/assoc-form
                  (form/assoc-form (fin-empty-map) (fkw "phase") (fkw "effect-ceiling"))
                  (fkw "function") (if (ftruthy? sn) sn (fget f :name)))
                  (fkw "inferred") inferred)
                  (fkw "ceiling") ceiling)
                  (fkw "excess") excess)
        msg (string-concat "inferred effects exceed declared effect ceiling"
                           (string-concat (if (ftruthy? sn) (string-concat " for " (form-text sn)) "")
                                          (if (> (form/count-of ops) 0) (string-concat ": " (pr-form ops)) "")))]
    (fin-fail-phase true msg "kotoba.error/effect-ceiling" (fget f :body)
                    "effect-ceiling" data)))
   :default nil)
#?(:kotoba
(defn- fin-ceilings [fns [:ref :form/r] i :i64 function-effects [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of fns))
    (form/nil-form)
    (let [f (form/nth-of fns i)
          ceiling (fget f :effects-ceiling)
          inferred (fin-effects-of-fn function-effects (fget f :name))
          excess (if (ftruthy? ceiling) (fin-set-difference inferred ceiling 0 (form/no-forms)) (fin-empty-set))]
      (if (> (form/count-of excess) 0)
        (form/form-vec (fl-add (fl-add (fl-add (fl-add (form/no-forms) f) inferred) ceiling) excess))
        (fin-ceilings fns (+ i 1) function-effects)))))
   :default nil)
#?(:kotoba
(defn- fin-check-ceiling-error [error [:ref :form/r]] :i64
  (if (form/is-nil? error)
    0
    (fin-ceiling-fail (form/nth-of error 0) (form/nth-of error 1)
                      (form/nth-of error 2) (form/nth-of error 3))))
   :default nil)
#?(:kotoba
(defn- fin-finish-functions [fns [:ref :form/r] i :i64 function-effects [:ref :form/r] typed? :bool acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of fns))
    (form/form-vec acc)
    (let [f0 (hir-values/erase-callable-field-types (form/nth-of fns i))
          f1 (fput f0 :effects (fin-effects-of-fn function-effects (fget f0 :name)))
          f2 (form/dissoc-form (form/dissoc-form (form/dissoc-form (form/dissoc-form (form/dissoc-form (form/dissoc-form f1 (form/keyword-form :param-types-inferred))
                                                                                                     (form/keyword-form :abort-error-type))
                                                                                    (form/keyword-form :abort-own-throw?))
                                                                   (form/keyword-form :abort-catches?))
                                                  (form/keyword-form :state-handler))
                               (form/keyword-form :state-handler-clause))
          f3 (if typed? f2 (form/dissoc-form f2 (form/keyword-form :param-types)))]
      (fin-finish-functions fns (+ i 1) function-effects typed? (form/append-form acc f3)))))
   :default nil)
#?(:kotoba
(defn- fin-main-result [parsed [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of parsed))
    (form/nil-form)
    (let [f (form/nth-of parsed i)]
      (if (fin-sym-is? (fget f :name) "main") (fget f :result) (fin-main-result parsed (+ i 1))))))
   :default nil)
#?(:kotoba
(defn- fin-all-effects [function-effects [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= (+ i 1) (form/count-of function-effects))
    acc
    (fin-all-effects function-effects (+ i 2) (fin-set-union acc (form/nth-of function-effects (+ i 1)) 0))))
   :default nil)
#?(:kotoba
(defn- fin-sorted-set-of [used [:ref :form/r] local-state :bool] [:ref :form/r]
  (let [base (fin-sort-kws (form/form-vec (form/kids-of used)) 0 (form/no-forms))]
    (if local-state (fin-set-add base (form/keyword-form :local-state)) base)))
   :default nil)
#?(:kotoba
(defn finish-hir [parsed [:ref :form/r] ns-info [:ref :form/r] used-caps [:ref :form/r]
                  local-state :bool flags [:ref :form/r] handlers [:ref :form/r]
                  exports [:ref :form/r] entry [:ref :form/r]] [:ref :form/r]
  (let [has-entry (not (form/is-nil? entry))
        schemas (fget ns-info :schemas)
        typed? (hir-values/typed? ns-info parsed (fin-scalar-types) (fin-result-scalar-types) (fin-typed-heads))
        function-effects (infer-effects parsed)
        u_20 (check-abort-facet-unwind! (form/kids-of parsed) function-effects)
        u_21 (fin-handler-purity parsed 0 function-effects handlers)
        u_22 (fin-thunk-effects parsed 0 function-effects)
        ceiling-error (fin-ceilings parsed 0 function-effects)
        u_23 (fin-check-ceiling-error ceiling-error)
        functions (fin-finish-functions parsed 0 function-effects typed? (form/no-forms))
        named-ops (fin-sorted-set-of used-caps local-state)
        effects (fin-all-effects function-effects 0 (fin-empty-set))
        profile (fget flags :language-profile)
        u_24 (fin-fail (and (form/eq profile (form/keyword-form :pure-product)) (> (form/count-of effects) 0)) "pure-product profile requires empty effects" "kotoba.error/pure-product-effects" effects)]
    (fput (fput (fput (fput (fput (fput (fput (fput (fput (fput (fput (form/form-map (form/no-forms)) :format (form/keyword-form (if typed? :kotoba.hir/v3 :kotoba.hir/v2)))
                                                          :namespace (fget ns-info :namespace))
                                                    :schemas (hir-values/erase-callable-field-types schemas))
                                              :schema-identities (fget ns-info :schema-identities))
                                        :entry entry)
                                  :exports exports)
                            :result (if has-entry (fin-main-result parsed 0) (form/nil-form)))
                      :effects effects)
                :named-operations named-ops)
          :language-profile profile)
    :functions functions)))
   :default nil)
