#?(:kotoba
(defn ie-hetero-items [ctx [:ref :ie/ctx] form [:ref :form/r] i :i64 item-types [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/ctx]
