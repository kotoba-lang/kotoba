#?(:kotoba
(defn ie-arm-typed-value-item [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] which :i64] [:ref :ie/r]
  (let [type (a form 0)
