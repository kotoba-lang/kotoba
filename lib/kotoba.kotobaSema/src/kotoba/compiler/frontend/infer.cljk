   :default nil)

#?(:kotoba
(defn ie-arm-hetero-at [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
