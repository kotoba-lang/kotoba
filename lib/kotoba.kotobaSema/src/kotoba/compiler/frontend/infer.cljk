    (ie-r type c2)))
   :default nil)

#?(:kotoba
(defn set-item-mismatch! [type [:ref :form/r] expected [:ref :form/r] actual [:ref :form/r] item [:ref :form/r]] [:ref :form/r]
  (throw (fe-reject-data (str "set item type mismatch: this set is " (pr-form type)
                              ", so every item must be " (pr-form expected)
                              "; this one is " (pr-form actual)
                              ". A `#{...}` literal is always [:set :keyword]: a set "
                              "literal of another item type, and one mixing item types, "
                              "are both outside the bounded profile. Write "
                              "(typed-set-new [:set item-type] item ...) for any other "
                              "item type.")
                         "kotoba.error/subset-reject" item (expected-actual-data expected actual))))
   :default nil)

#?(:kotoba
(defn ie-set-items [ctx [:ref :ie/ctx] form [:ref :form/r] i :i64 type [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/ctx]
  (if (>= i (argc form))
    ctx
    (let [c1 (ie-set-item! ctx type (a form i) locals sigs)]
      (ie-set-items c1 form (+ i 1) type locals sigs))))
   :default nil)

#?(:kotoba
(defn ie-arm-typed-set-new [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
        _ (type-valid! type)
        c1 (ie-set-items ctx form 1 type locals sigs)]
    (ie-r type c1)))
   :default nil)

#?(:kotoba
(defn ie-arm-typed-set-item [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] result [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
        _ (type-valid! type)
        c1 (ie-expect ctx (a form 1) type locals sigs)
        c2 (ie-set-item! c1 type (a form 2) locals sigs)]
    (ie-r (if (form/is-nil? result) type result) c2)))
   :default nil)

#?(:kotoba
(defn ie-map-entries [ctx [:ref :ie/ctx] form [:ref :form/r] i :i64 key-type [:ref :form/r] value-type [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/ctx]
  (if (>= (+ i 1) (argc form))
    ctx
    (let [c1 (ie-expect ctx (a form i) key-type locals sigs)
          c2 (ie-expect c1 (a form (+ i 1)) value-type locals sigs)]
      (ie-map-entries c2 form (+ i 2) key-type value-type locals sigs))))
   :default nil)

#?(:kotoba
(defn ie-arm-typed-map-new [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
        key-type (form/nth-of type 1)
        value-type (form/nth-of type 2)
        _ (type-valid! type)
        c1 (ie-map-entries ctx form 1 key-type value-type locals sigs)]
    (ie-r type c1)))
   :default nil)

#?(:kotoba
(defn ie-arm-typed-map-key [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] result [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
        _ (type-valid! type)
        c1 (ie-expect ctx (a form 1) type locals sigs)
        c2 (ie-expect c1 (a form 2) (form/nth-of type 1) locals sigs)]
    (ie-r (if (form/is-nil? result) type result) c2)))
   :default nil)

#?(:kotoba
(defn ie-arm-typed-map-assoc [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
        _ (type-valid! type)
        c1 (ie-expect ctx (a form 1) type locals sigs)
        c2 (ie-expect c1 (a form 2) (form/nth-of type 1) locals sigs)
        c3 (ie-expect c2 (a form 3) (form/nth-of type 2) locals sigs)]
    (ie-r type c3)))
   :default nil)

#?(:kotoba
(defn ie-arm-typed-map-keys [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] keys? :bool] [:ref :ie/r]
  (let [type (a form 0)
        _ (type-valid! type)
        c1 (ie-expect ctx (a form 1) type locals sigs)]
    (ie-r (form/vec2 (tk :list) (if keys? (form/nth-of type 1) (form/nth-of type 2))) c1)))
   :default nil)

#?(:kotoba
(defn ie-arm-typed-map-entry-at [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
        _ (type-valid! type)
        c1 (ie-expect ctx (a form 1) type locals sigs)
        c2 (ie-expect c1 (a form 2) (tk :i64) locals sigs)]
    (ie-r (option-of (form/vec2 (tk :vector) (form/vec2 (form/nth-of type 1) (form/nth-of type 2)))) c2)))
   :default nil)

#?(:kotoba
(defn err-with-use-site [e [:ref :fe/err] use-site [:ref :form/r]] [:ref :fe/err]
  (record-new [:ref :fe/err] (record-get [:ref :fe/err] e :msg) (record-get [:ref :fe/err] e :code)
              (record-get [:ref :fe/err] e :form) (record-get [:ref :fe/err] e :phase)
              (form/assoc-form (record-get [:ref :fe/err] e :data) (form/keyword-form :kotoba.error/use-site) use-site)))
   :default nil)

#?(:kotoba
(defn use-site-rethrow [e [:ref :fe/err] op [:ref :form/r] args [:ref :form/r]] [:ref :ie/r]
  (let [data (record-get [:ref :fe/err] e :data)
        phase (record-get [:ref :fe/err] e :phase)]
    (if (and (not (string=? phase ""))
             (not (form/form-has? data (form/keyword-form :kotoba.error/use-site)))
             (fl-has? (form/kids-of args) (record-get [:ref :fe/err] e :form) 0))
      (throw (err-with-use-site e (call-form op args)))
      (throw e))))
   :default nil)

#?(:kotoba
(defn args3 [value [:ref :form/r] key [:ref :form/r] default [:ref :form/r]] [:ref :form/r]
  (form/form-vec (form/append-form (form/append-form (form/one-form value) key) default)))
   :default nil)

#?(:kotoba
(defn ie-map-get-call [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (ie-call-top ctx (form/symbol-form "map-get")
               (args3 (a form 0) (a form 1) (if (= 3 (argc form)) (a form 2) (form/int-form 0)))
               locals sigs))
   :default nil)

#?(:kotoba
(defn ie-arm-destructure-get [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [value (a form 0)
        key (a form 1)
        default (a form 2)
        r (ie-infer ctx value locals sigs)
        value-type (ie-type r)
        descriptor (resolve-ref-type value-type (ctx-schemas ctx))
        c1 (ie-ctx r)]
    (cond
      (canonical-typed-map-type? value-type)
      (let [_ (req! (= 3 (argc form)) "typed-map destructuring requires an :or default" "kotoba.error/destructure-default" form)
            c2 (ie-expect c1 key (form/nth-of value-type 1) locals sigs)
            c3 (ie-expect c2 default (form/nth-of value-type 2) locals sigs)]
        (ie-r (form/nth-of value-type 2) c3))
      (record-type? descriptor)
      (let [ft (record-field-type descriptor key (ctx-schemas ctx))
            _ (req! (ftruthy? ft) "record field is not declared" "kotoba.error/record-field" form)]
        (ie-r ft c1))
      :else (ie-map-get-call c1 form locals sigs))))
   :default nil)

#?(:kotoba
(defn literal-default? [default [:ref :form/r]] :bool
  (or (form/is-symbol? default) (form/is-keyword? default) (form/is-string? default)
      (form/is-bool? default) (kotoba-integer? default) (form/is-f64? default)))
   :default nil)

#?(:kotoba
(defn default-literal! [default [:ref :form/r] key [:ref :form/r] descriptor [:ref :form/r] form [:ref :form/r]] :i64
  (if (literal-default? default)
    0
    (throw (fe-reject (str "the default of " (pr-form key) " on record " (form-text (form/nth-of descriptor 1))
                           " is never evaluated, because the record has that field:"
                           " write the default as a literal or a local")
                      "kotoba.error/record-projection-unresolved" form))))
   :default nil)

#?(:kotoba
(defn ie-arm-get [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [value (a form 0)
        key (a form 1)
        default (a form 2)
        r (ie-infer ctx value locals sigs)
        value-type (ie-type r)
        descriptor (resolve-ref-type value-type (ctx-schemas ctx))
        c1 (ie-ctx r)]
    (cond
      (ty? value-type :document)
      (if (= 3 (argc form)) (ie-r (tk :document) c1) (ie-r (option-of (tk :document)) c1))
      (canonical-typed-map-type? value-type)
      (let [c2 (ie-expect c1 key (form/nth-of value-type 1) locals sigs)]
        (if (= 3 (argc form))
          (let [c3 (ie-expect c2 default (form/nth-of value-type 2) locals sigs)]
            (ie-r (form/nth-of value-type 2) c3))
          (ie-r (option-of (form/nth-of value-type 2)) c2)))
      (and (record-type? descriptor) (= 3 (argc form)) (form/is-keyword? key))
      (record-get-default-type c1 descriptor key default form locals sigs)
      (record-type? descriptor)
      (let [_ (req! (= 2 (argc form)) "record get requires a value and one keyword field" "kotoba.error/record-projection-unresolved" form)
            ft (record-field-type descriptor key (ctx-schemas ctx))
            _ (req! (ftruthy? ft) "record field is not declared" "kotoba.error/record-field" form)]
        (ie-r ft c1))
      :else (ie-map-get-call c1 form locals sigs))))
   :default nil)

#?(:kotoba
(defn ie-arg0-type [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (if (= 1 (argc form))
    (ie-infer ctx (a form 0) locals sigs)
    (ie-r (form/nil-form) ctx)))
   :default nil)

#?(:kotoba
(defn ie-default-call [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (ie-call-top ctx (form/nth-of form 0) (vec-of form) locals sigs))
   :default nil)

#?(:kotoba
(defn ie-arm-count [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [r (ie-arg0-type ctx form locals sigs)
        t (ie-type r)]
    (if (or (ty? t :vector-i64) (ty? t :vector-f64) (heterogeneous-vector-type? t) (typed-set-type? t)
            (canonical-typed-map-type? t) (canonical-list-type? t))
      (ie-r (tk :i64) (ie-ctx r))
      (ie-default-call (ie-ctx r) form locals sigs))))
   :default nil)

#?(:kotoba
(defn ie-arm-peek-pop [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] peek? :bool] [:ref :ie/r]
  (let [r (ie-arg0-type ctx form locals sigs)
        t (ie-type r)
        c1 (ie-ctx r)]
    (cond
      (ty? t :vector-i64) (ie-r (if peek? (tk :i64) (tk :vector-i64)) c1)
      (ty? t :vector-f64) (ie-r (if peek? (tk :f64) (tk :vector-f64)) c1)
      :else (ie-default-call c1 form locals sigs))))
   :default nil)

#?(:kotoba
(defn ie-arm-keys-vals [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] keys? :bool] [:ref :ie/r]
  (let [r (ie-arg0-type ctx form locals sigs)
        t (ie-type r)
        c1 (ie-ctx r)]
    (cond
      (canonical-typed-map-type? t)
      (ie-r (form/vec2 (tk :list) (if keys? (form/nth-of t 1) (form/nth-of t 2))) c1)
      (ty? t :document) (ie-r (tk :document) c1)
      :else (ie-default-call c1 form locals sigs))))
   :default nil)

#?(:kotoba
(defn ie-arm-pair [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] first? :bool] [:ref :ie/r]
  (let [r (ie-arg0-type ctx form locals sigs)
        t (ie-type r)
        c1 (ie-ctx r)]
    (cond
      (ty? t :vector-i64) (ie-r (if first? (tk :i64) (tk :vector-i64)) c1)
      (ty? t :vector-f64) (ie-r (if first? (tk :f64) (tk :vector-f64)) c1)
      (ty? t :document) (ie-r (tk :document) c1)
      :else (ie-default-call c1 form locals sigs))))
   :default nil)

#?(:kotoba
(defn nth-arity! [form [:ref :form/r] msg :string code :string] :i64
  (req! (and (<= 2 (argc form)) (<= (argc form) 3)) msg code form))
   :default nil)

#?(:kotoba
(defn ie-nth-call [ctx [:ref :ie/ctx] form [:ref :form/r] name-3 :string name-2 :string locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [_ (nth-arity! form "vector nth requires value, index, and optional default" "kotoba.error/subset-reject")]
    (ie-call-top ctx (form/symbol-form (if (= 3 (argc form)) name-3 name-2)) (vec-of form) locals sigs)))
   :default nil)

#?(:kotoba
(defn ie-nth-hetero [ctx [:ref :ie/ctx] form [:ref :form/r] value-type [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [_ (nth-arity! form "heterogeneous vector nth requires a value, one literal index, and an optional default" "kotoba.error/hetero-vector-index")
        item-types (form/nth-of value-type 1)
        host-index (hvi! (a form 1) item-types form)
        item-type (form/nth-of item-types host-index)]
    (if (= 3 (argc form))
      (let [c1 (ie-expect ctx (a form 2) item-type locals sigs)]
        (ie-r item-type c1))
      (ie-r item-type ctx))))
   :default nil)

#?(:kotoba
(defn ie-arm-nth [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [r (ie-infer ctx (a form 0) locals sigs)
        value-type (ie-type r)
        c1 (ie-ctx r)]
    (cond
      (and (ty? value-type :document) (= 2 (argc form))) (ie-r (tk :document) c1)
      (heterogeneous-vector-type? value-type) (ie-nth-hetero c1 form value-type locals sigs)
      (ty? value-type :vector-i64) (ie-nth-call c1 form "vector-get" "vector-at" locals sigs)
      (ty? value-type :vector-f64) (ie-nth-call c1 form "vector-f64-get" "vector-f64-at" locals sigs)
      (canonical-list-type? value-type)
      (if (= 2 (argc form))
        (ie-r (form/nth-of value-type 1) c1)
        (ie-default-call c1 form locals sigs))
      :else (ie-default-call c1 form locals sigs))))
   :default nil)

#?(:kotoba
(defn ie-arm-record-new [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
        fields (form/nth-of type 2)
        _ (type-valid! type)
        c1 (ie-record-items ctx form fields 0 locals sigs)]
    (ie-r type c1)))
   :default nil)

#?(:kotoba
(defn ie-record-items [ctx [:ref :ie/ctx] form [:ref :form/r] fields [:ref :form/r] i :i64 locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/ctx]
  (if (or (>= i (form/count-of fields)) (>= (+ i 1) (argc form)))
    ctx
    (let [pair (form/nth-of fields i)
          item (a form (+ i 1))
          r (ie-infer ctx item locals sigs)
          _ (require-field-value-type! (ie-type r) (form/nth-of pair 1) item (form/nth-of pair 0))]
      (ie-record-items (ie-ctx r) form fields (+ i 1) locals sigs))))
   :default nil)

#?(:kotoba
(defn declared-field-type [fields [:ref :form/r] field [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of fields))
    (form/nil-form)
    (let [pair (form/nth-of fields i)]
      (if (and (form/eq (form/nth-of pair 0) field) (ftruthy? (form/nth-of pair 1)))
        (form/nth-of pair 1)
        (declared-field-type fields field (+ i 1))))))
   :default nil)

#?(:kotoba
(defn record-get-parts [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (if (= 2 (argc form))
    (let [r (ie-infer ctx (a form 0) locals sigs)
          _ (req! (record-type? (ie-type r))
                  (str "record-get without a type descriptor requires a record value; got " (pr-form (ie-type r)))
                  "kotoba.error/subset-reject" form)]
      (ie-r (form/vec3 (ie-type r) (a form 0) (a form 1)) (ie-ctx r)))
    (ie-r (form/vec3 (a form 0) (a form 1) (a form 2)) ctx)))
   :default nil)

#?(:kotoba
(defn ie-arm-record-get [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [pr (record-get-parts ctx form locals sigs)
        parts (ie-type pr)
        type (form/nth-of parts 0)
        value (form/nth-of parts 1)
        field (form/nth-of parts 2)
        field-type (declared-field-type (form/nth-of type 2) field 0)
        _ (type-valid! type)
        c1 (ie-expect (ie-ctx pr) value type locals sigs)]
    (ie-r (if (callable-type? field-type) (tk :i64) field-type) c1)))
   :default nil)

#?(:kotoba
(defn ie-arm-record-assoc [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
        field (a form 2)
        replacement (a form 3)
        field-type (declared-field-type (form/nth-of type 2) field 0)
        _ (type-valid! type)
        c1 (ie-expect ctx (a form 1) type locals sigs)
        r (ie-infer c1 replacement locals sigs)
        _ (require-field-value-type! (ie-type r) field-type replacement replacement)]
    (ie-r type (ie-ctx r))))
   :default nil)

#?(:kotoba
(defn arm-spec-entry [ctx [:ref :ie/ctx] op [:ref :form/r]] [:ref :form/r]
  (tables/table-get (form/form-get (ctx-tbl ctx) (form/keyword-form :arm-specs)) op))
   :default nil)

#?(:kotoba
(defn ie-seq [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [op (form/nth-of form 0)
        h (if (form/is-symbol? op) (form/symbol-value op) "")
        spec (arm-spec-entry ctx op)]
    (if (and (form/is-symbol? op) (ftruthy? spec))
      (ie-arm-spec ctx form locals sigs spec)
      (ie-seq-head ctx h form locals sigs))))
   :default nil)

#?(:kotoba
(defn ie-seq-head [ctx [:ref :ie/ctx] h :string form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (cond
    (string=? h "let") (ie-arm-let ctx form locals sigs)
    (string=? h "__kotoba_absent") (ie-arm-absent ctx form)
    (string=? h "__kotoba_present") (ie-arm-present ctx form locals sigs)
    (string=? h "if") (ie-arm-if ctx form locals sigs)
    (string=? h "do") (ie-arm-do ctx form locals sigs)
    (string=? h "__kotoba_state_op") (ie-arm-state-op ctx form locals sigs)
    (string=? h "__kotoba_state_with") (ie-arm-state-with ctx form locals sigs)
    (string=? h "throw") (ie-arm-throw ctx form locals sigs)
    (string=? h "try") (ie-arm-try ctx form locals sigs)
    :else (ie-seq-head2 ctx h form locals sigs)))
   :default nil)

#?(:kotoba
(defn ie-seq-head2 [ctx [:ref :ie/ctx] h :string form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (cond
    (string=? h "typed-cap-call") (ie-arm-typed-cap-call ctx form locals sigs)
    (string=? h "result-ok-of") (ie-arm-payload ctx form locals sigs 1 (form/nil-form))
    (string=? h "result-err-of") (ie-arm-payload ctx form locals sigs 2 (form/nil-form))
    (string=? h "result-ok?-of") (ie-arm-validated-value ctx form locals sigs (tk :bool))
    (string=? h "result-value-of") (ie-arm-value-fallback ctx form locals sigs 1)
    (string=? h "result-error-of") (ie-arm-value-fallback ctx form locals sigs 2)
    (string=? h "result-match-of") (ie-arm-result-match ctx form locals sigs)
    (string=? h "variant-new") (ie-arm-variant-new ctx form locals sigs)
    (string=? h "variant-match") (ie-arm-variant-match ctx form locals sigs)
    (string=? h "option-some-of") (ie-arm-payload ctx form locals sigs 1 (form/nil-form))
    (string=? h "option-none-of") (ie-arm-option-none ctx form)
    (string=? h "option-some?-of") (ie-arm-validated-value ctx form locals sigs (tk :bool))
    (string=? h "option-value-of") (ie-arm-value-fallback ctx form locals sigs 1)
    (string=? h "option-match") (ie-arm-option-match ctx form locals sigs)
    (string=? h "typed-list-new") (ie-arm-typed-list-new ctx form locals sigs)
    (string=? h "typed-list-nth") (ie-arm-typed-value-index ctx form locals sigs (form/nil-form))
    (string=? h "typed-list-conj") (ie-arm-typed-value-item ctx form locals sigs 1)
    (string=? h "hetero-vector-new") (ie-arm-hetero-new ctx form locals sigs)
    (string=? h "hetero-vector-count") (ie-arm-validated-value ctx form locals sigs (tk :i64))
    (string=? h "hetero-vector-at") (ie-arm-hetero-at ctx form locals sigs)
    (string=? h "__kotoba_destructure_get") (ie-arm-destructure-get ctx form locals sigs)
    (string=? h "get") (ie-arm-get ctx form locals sigs)
    (string=? h "count") (ie-arm-count ctx form locals sigs)
    (string=? h "peek") (ie-arm-peek-pop ctx form locals sigs true)
    (string=? h "pop") (ie-arm-peek-pop ctx form locals sigs false)
    (string=? h "keys") (ie-arm-keys-vals ctx form locals sigs true)
    (string=? h "vals") (ie-arm-keys-vals ctx form locals sigs false)
    (string=? h "pair-first") (ie-arm-pair ctx form locals sigs true)
    (string=? h "pair-second") (ie-arm-pair ctx form locals sigs false)
    (string=? h "nth") (ie-arm-nth ctx form locals sigs)
    :else (ie-seq-head3 ctx h form locals sigs)))
   :default nil)

#?(:kotoba
(defn ie-arm-option-none [ctx [:ref :ie/ctx] form [:ref :form/r]] [:ref :ie/r]
  (let [_ (type-valid! (a form 0))]
    (ie-r (a form 0) ctx)))
   :default nil)

#?(:kotoba
(defn ie-seq-head3 [ctx [:ref :ie/ctx] h :string form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (cond
    (string=? h "hetero-vector-assoc") (ie-arm-hetero-assoc ctx form locals sigs)
    (string=? h "hetero-vector-equal") (ie-arm-typed-two ctx form locals sigs (tk :i64))
    (string=? h "typed-set-new") (ie-arm-typed-set-new ctx form locals sigs)
    (string=? h "typed-set-count") (ie-arm-validated-value ctx form locals sigs (tk :i64))
    (string=? h "typed-set-contains") (ie-arm-typed-set-item ctx form locals sigs (tk :bool))
    (string=? h "typed-set-conj") (ie-arm-typed-set-item ctx form locals sigs (form/nil-form))
    (string=? h "typed-set-disj") (ie-arm-typed-set-item ctx form locals sigs (form/nil-form))
    (string=? h "typed-set-equal") (ie-arm-typed-two ctx form locals sigs (tk :i64))
    (string=? h "typed-set-nth") (ie-arm-typed-value-index ctx form locals sigs (form/nil-form))
    (string=? h "typed-map-new") (ie-arm-typed-map-new ctx form locals sigs)
    (string=? h "typed-map-count") (ie-arm-validated-value ctx form locals sigs (tk :i64))
    (string=? h "typed-map-contains") (ie-arm-typed-map-key ctx form locals sigs (tk :bool))
    (string=? h "typed-map-get") (ie-arm-typed-map-get ctx form locals sigs)
    (string=? h "typed-map-entry-at") (ie-arm-typed-map-entry-at ctx form locals sigs)
    (string=? h "typed-map-keys") (ie-arm-typed-map-keys ctx form locals sigs true)
    (string=? h "typed-map-vals") (ie-arm-typed-map-keys ctx form locals sigs false)
    (string=? h "typed-map-assoc") (ie-arm-typed-map-assoc ctx form locals sigs)
    (string=? h "typed-map-dissoc") (ie-arm-typed-map-key ctx form locals sigs (form/nil-form))
    (string=? h "typed-map-equal") (ie-arm-typed-two ctx form locals sigs (tk :i64))
    (string=? h "record-new") (ie-arm-record-new ctx form locals sigs)
    (string=? h "record-get") (ie-arm-record-get ctx form locals sigs)
    (string=? h "record-assoc") (ie-arm-record-assoc ctx form locals sigs)
    (string=? h "record-equal") (ie-arm-typed-two ctx form locals sigs (tk :i64))
    :else (ie-default-call ctx form locals sigs)))
   :default nil)

#?(:kotoba
(defn ie-arm-typed-map-get [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
        _ (type-valid! type)
        c1 (ie-expect ctx (a form 1) type locals sigs)
        c2 (ie-expect c1 (a form 2) (form/nth-of type 1) locals sigs)]
    (ie-r (option-of (form/nth-of type 2)) c2)))
   :default nil)

#?(:kotoba
(defn ie-set-item! [ctx [:ref :ie/ctx] type [:ref :form/r] item [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/ctx]
  (let [expected (form/nth-of type 1)
        r (ie-infer ctx item locals sigs)
        actual (ie-type r)]
    (if (or (form/eq actual (abort-bottom-form)) (same-expression-type? actual expected))
      (let [_ (require-expression-type! actual expected item)]
        (ie-ctx r))
      (let [_ (set-item-mismatch! type expected actual item)]
        (ie-ctx r)))))
   :default
(defn require-set-item-type!
  "Require `item` to be the item type of set type `type`, and say which set
  when it is not.

  A `#{...}` literal always lowers to `[:set :keyword]` -- the desugar
  hard-codes the descriptor -- so `#{:a (+ 1 1)}`, `#{1 2}` and
  `(conj #{:a} 2)` were all refused `expression type mismatch: expected
  keyword, got i64`, which names neither the set nor the rule. That message was
  the whole report on the language authority's own set conformance fixture,
  which is written with a heterogeneous literal and therefore cannot be
  admitted at all; a reader had no way to learn that from it.

  `:kotoba.error/expected`/`:actual` are carried through unchanged and with the
  same `form`: `infer-absent-parameter-types` reads a refused operand's
  required type out of this ex-data rather than out of the prose, so narrowing
  the prose must not narrow the data."
  [type item locals signatures]
  (let [expected (second type)
        actual (infer-expression-type item locals signatures)]
    (if (or (= actual abort-bottom) (same-expression-type? actual expected))
      (require-expression-type! actual expected item)
      (reject! (str "set item type mismatch: this set is " (pr-str type)
                    ", so every item must be " (pr-str expected)
                    "; this one is " (pr-str actual)
                    ". A `#{...}` literal is always [:set :keyword]: a set "
                    "literal of another item type, and one mixing item types, "
                    "are both outside the bounded profile. Write "
                    "(typed-set-new [:set item-type] item ...) for any other "
                    "item type.")
               item :kotoba.error/subset-reject
               {:kotoba.error/expected expected
                :kotoba.error/actual actual})))))

;; --- row operations (ADR 0353 floor :row-operations) ----------------------
;;
;; assoc / dissoc / merge / select-keys on a RECORD are row operations: the
;; result is a record type read off the receiver's fields and the operation,
;; never the keyword->i64 pair map. A field assoc'ed that the record has keeps
;; the record's type, and the value must be that field's type (no coercion);
;; a field it does not have EXTENDS the record; dissoc and select-keys SHRINK
;; it and name only fields it has; merge assoc's every field of each right
;; operand (a record, or a keyword-keyed map literal), and a field both sides
;; have is one type. A result whose fields differ from the receiver's is the
;; anonymous closed record a map literal with those fields lowers to
;; (`map-literal-record-type`, fields in key order), so `(assoc {:a "x"} :b 1)`
;; and `{:a "x" :b 1}` are one type. `rewrite-record-projection` elaborates
;; each to record-new / record-get / record-assoc: nothing new reaches KIR or
;; a backend.

#?(:kotoba nil :default (def row-operation-heads tables/row-operation-heads))

#?(:kotoba nil :default (def ^:dynamic *row-op-schemas*
  "The module's schemas for the whole analysis: `*schemas*` is bound only
  around some passes, and a row operation is typed and elaborated in others."
  nil))

#?(:kotoba
(defn row-op-record [type [:ref :form/r] schemas [:ref :form/r] row-schemas [:ref :form/r]] [:ref :form/r]
  (let [record (if (and (schema-ref-type? type) (form/is-nil? (form/form-get schemas (form/nth-of type 1))))
                 (let [found (form/form-get row-schemas (form/nth-of type 1))]
                   (if (form/is-nil? found) type found))
                 (resolve-ref-type type schemas))]
    (if (record-type? record) record (form/nil-form))))
   :default
(defn row-op-record
  "The record descriptor TYPE is (a declared `[:ref ..]` resolved), or nil."
  [type]
  (let [record (if (and (schema-ref-type? type) (not (get *schemas* (second type))))
                 (get (some-> *row-op-schemas* deref) (second type) type)
                 (resolve-ref-type type))]
    (when (record-type? record) record))))

#?(:kotoba
(defn row-op-name [type [:ref :form/r] schemas [:ref :form/r] row-schemas [:ref :form/r]] [:ref :form/r]
  (form/nth-of (row-op-record type schemas row-schemas) 1))
   :default
(defn row-op-name [type]
  (second (row-op-record type))))

#?(:kotoba
(defn row-op-field-type [fields [:ref :form/r] field [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of fields))
    (form/nil-form)
    (let [pair (form/nth-of fields i)]
      (if (and (form/eq (form/nth-of pair 0) field) (ftruthy? (form/nth-of pair 1)))
        (form/nth-of pair 1)
        (row-op-field-type fields field (+ i 1))))))
   :default
(defn row-op-field-type [fields field]
  (first-truthy (fn [[k t]] (when (= k field) t)) fields)))

#?(:kotoba
(defn row-op-key! [op :string type [:ref :form/r] key [:ref :form/r] form [:ref :form/r] schemas [:ref :form/r] row-schemas [:ref :form/r]] :i64
  (if (form/is-keyword? key)
    0
    (throw (fe-reject (str op " on record " (form-text (row-op-name type schemas row-schemas)) " needs keyword literal fields: "
                           "a record's fields are static; " (use-site-text key) " is not a keyword literal")
                      "kotoba.error/row-operation-shape" form))))
   :default
(defn row-op-key! [op type key form]
  (when-not (keyword? key)
    (reject! (str op " on record " (row-op-name type) " needs keyword literal fields: "
                  "a record's fields are static; " (use-site-text key) " is not a keyword literal")
             form :kotoba.error/row-operation-shape))))

#?(:kotoba
(defn row-op-field! [op :string type [:ref :form/r] fields [:ref :form/r] key [:ref :form/r] form [:ref :form/r] schemas [:ref :form/r] row-schemas [:ref :form/r]] :i64
  (let [_ (row-op-key! op type key form schemas row-schemas)
        _ (row-op-field-missing! op type fields key form schemas row-schemas)]
    0))
   :default
(defn row-op-field! [op type fields key form]
  (row-op-key! op type key form)
  (when-not (row-op-field-type fields key)
    (reject! (str op " names field " key ", which record " (row-op-name type)
                  " does not have: a row shrinks only by fields it has")
             form :kotoba.error/row-field-missing
             {:kotoba.error/field key :kotoba.error/actual type}))))

#?(:kotoba
(defn row-op-assoc-fields [fields [:ref :form/r] entries [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of entries))
    fields
    (let [entry (form/nth-of entries i)
          key (form/nth-of entry 0)
          type (form/nth-of entry 1)
          existing (row-op-field-type fields key 0)]
      (if (ftruthy? existing)
        (let [_ (require-expression-type! type existing (form/nth-of entry 2))]
          (row-op-assoc-fields fields entries (+ i 1)))
        (row-op-assoc-fields (form/form-vec (form/append-form (form/kids-of fields) (form/vec2 key type))) entries (+ i 1))))))
   :default
(defn row-op-assoc-fields
  "FIELDS with every `[key type form]` of ENTRIES assoc'ed: an existing field
  keeps its type and the value must be it; a new one is appended."
  [fields entries]
  (reduce (fn [fields [key type form]]
            (if-let [existing (row-op-field-type fields key)]
              (do (require-expression-type! type existing form) fields)
              (conj fields [key type])))
          fields entries)))

#?(:kotoba
(defn row-op-literal-entries [form [:ref :form/r]] [:ref :form/r]
  (if (and (form/is-seq? form) (sym-is? (form/nth-of form 0) "map-new") (row-op-literal-keys? form 1))
    (form/form-vec (row-op-literal-pairs form 1 (form/no-forms)))
    (form/nil-form)))
   :default
(defn row-op-literal-entries
  "`[[key value] ...]` of a keyword-keyed map literal as desugared
  (`(map-new :k v ...)`), or nil."
  [form]
  (when (and (seq? form) (= 'map-new (first form))
             (every? keyword? (take-nth 2 (rest form))))
    (mapv vec (partition 2 (rest form))))))

#?(:kotoba
(defn row-op-fields [ctx [:ref :ie/ctx] op [:ref :form/r] args [:ref :form/r] types [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] form [:ref :form/r]] [:ref :ie/r]
  (let [receiver-type (form/nth-of types 0)
        schemas (ctx-schemas ctx)
        row-schemas (ctx-row-schemas ctx)
        fields (form/form-vec (form/kids-of (form/nth-of (row-op-record receiver-type schemas row-schemas) 2)))
        o (form-text op)]
    (cond
      (string=? o "map-assoc")
      (ie-r (row-op-assoc-entries! receiver-type args types 1 form schemas row-schemas fields) ctx)
      (or (string=? o "dissoc") (string=? o "select-keys"))
      (let [ks (form/form-vec (form/rest-list args))
            _ (row-op-fields-each! o receiver-type fields ks 0 form schemas row-schemas)
            kept (row-op-filter fields ks (string=? o "select-keys") 0 (form/no-forms))
            _ (row-op-nonempty! o receiver-type kept form schemas row-schemas)]
        (ie-r (form/form-vec kept) ctx))
      (string=? o "merge")
      (row-op-merge-args ctx receiver-type args types 1 locals sigs form fields)
      :else (ie-r fields ctx))))
   :default
(defn row-op-fields
  "The fields of the record OP makes from ARGS, whose types are TYPES; the
  first is a record."
  [op args types locals signatures form]
  (let [receiver-type (first types)
        fields (vec (nth (row-op-record receiver-type) 2))]
    (case op
      map-assoc
      (row-op-assoc-fields
       fields
       (map (fn [[key value] [_ value-type]]
              (row-op-key! "assoc" receiver-type key form)
              [key value-type value])
            (partition 2 (rest args)) (partition 2 (rest types))))
      (dissoc select-keys)
      (let [keys (rest args)]
        (doseq [key keys] (row-op-field! op receiver-type fields key form))
        (let [kept (if (= op 'dissoc)
                     (remove (fn [[k _]] (first-truthy #{k} keys)) fields)
                     (filter (fn [[k _]] (first-truthy #{k} keys)) fields))]
          (when (empty? kept)
            (reject! (str op " leaves record " (row-op-name receiver-type)
                          " with no field, and a record has at least one")
                     form :kotoba.error/row-operation-shape))
          (vec kept)))
      merge
      (reduce (fn [fields [arg type]]
                (if-let [entries (row-op-literal-entries arg)]
                  (row-op-assoc-fields
                   fields (map (fn [[k v]] [k (infer-expression-type v locals signatures) v])
                               entries))
                  (if-let [record (row-op-record type)]
                    (row-op-assoc-fields fields (map (fn [[k t]] [k t arg]) (nth record 2)))
                    (reject! (str "merge onto record " (row-op-name receiver-type)
                                  " takes records and keyword-keyed map literals; "
                                  (use-site-text arg) " is "
                                  (if (keyword? type) (name type) (pr-str type)))
                             form :kotoba.error/row-operation-shape
                             {:kotoba.error/actual type}))))
              fields (map vector (rest args) (rest types)))))))

#?(:kotoba
(defn row-op-result-type [receiver-type [:ref :form/r] fields [:ref :form/r] schemas [:ref :form/r] row-schemas [:ref :form/r]] [:ref :form/r]
  (if (form/eq (form/form-set (form/kids-of (form/nth-of (row-op-record receiver-type schemas row-schemas) 2)))
               (form/form-set (form/kids-of fields)))
    receiver-type
    (map-literal-record-type (form/form-vec (sort-by-key-text fields 0 (form/no-forms))))))
   :default
(defn row-op-result-type
  "RECEIVER-TYPE itself when FIELDS are its fields, else the anonymous closed
  record of FIELDS."
  [receiver-type fields]
  (if (= (set (nth (row-op-record receiver-type) 2)) (set fields))
    receiver-type
    (map-literal-record-type (vec (sort-by first (map-literal-key-order :keyword) fields))))))

#?(:kotoba
(defn row-op-not-record! [op :string receiver [:ref :form/r] type [:ref :form/r] form [:ref :form/r]] :i64
  (throw (fe-reject-data (str op " is a row operation on a record; " (use-site-text receiver) " is " (type-text type))
                         "kotoba.error/row-operation-receiver" form
                         (form/form-map (form/append-form (form/append-form (form/no-forms) (form/keyword-form :kotoba.error/actual)) type)))))
   :default
(defn row-op-not-record! [op receiver type form]
  (reject! (str op " is a row operation on a record; " (use-site-text receiver) " is "
                (if (keyword? type) (name type) (pr-str type)))
           form :kotoba.error/row-operation-receiver
           {:kotoba.error/actual type})))

#?(:kotoba
(defn ie-call-top [ctx [:ref :ie/ctx] op [:ref :form/r] args [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (try (ie-call ctx op args locals sigs)
       (catch [:ref :fe/err] e (use-site-rethrow e op args))))
   :default
(defn infer-call-type
  "`infer-call-type-impl`, with the call named on any refusal it raises about
  one of its own arguments: a rejection whose `:form` is one of ARGS and that
  no inner call has already claimed gets `:kotoba.error/use-site (op ...)`.
  The innermost call wins, so the site is the operation that actually
  required the type. `infer-absent-parameter-types` reads it to name both
  disagreeing uses of a parameter; nothing else changes -- same message,
  same code, same span."
  [op args locals signatures]
  (try (infer-call-type-impl op args locals signatures)
       (catch #?(:clj Throwable :cljs :default) error
         (let [data (ex-data error)]
           (if (and (:phase data)
                    (not (contains? data :kotoba.error/use-site))
                    (first-truthy #(= % (:form data)) args))
             (throw (ex-info (ex-message error)
                             (assoc data :kotoba.error/use-site (cons op args))))
             (throw error)))))))

#?(:kotoba nil :default (def library-predicate-heads tables/library-predicate-heads))

#?(:kotoba
(defn library-predicate-static-answer [o :string type [:ref :form/r]] [:ref :form/r]
  (let [map-type? (or (record-type? type) (canonical-typed-map-type? type) (ty? type :map))
        vector-type? (or (heterogeneous-vector-type? type) (ty? type :vector-i64) (ty? type :vector-f64))
        set-type? (typed-set-type? type)
        list-type? (canonical-list-type? type)]
    (cond
      (string=? o "true?") (if (ty? type :bool) (tk :operand) (form/bool-form false))
      (string=? o "false?") (if (ty? type :bool) (tk :negated) (form/bool-form false))
      (string=? o "boolean?") (form/bool-form (ty? type :bool))
      (string=? o "integer?") (form/bool-form (ty? type :i64))
      (string=? o "string?") (form/bool-form (ty? type :string))
      (string=? o "keyword?") (form/bool-form (ty? type :keyword))
      (string=? o "symbol?") (form/bool-form (ty? type :symbol))
      (string=? o "map?") (form/bool-form map-type?)
      (string=? o "vector?") (form/bool-form vector-type?)
      (string=? o "set?") (form/bool-form set-type?)
      (or (string=? o "list?") (string=? o "seq?")) (form/bool-form list-type?)
      (string=? o "coll?") (form/bool-form (or map-type? vector-type? set-type? list-type?))
      :else (form/bool-form false))))
   :default
(defn library-predicate-static-answer
  "What `(op x)` is for a value of the static, non-document TYPE: :operand
  (the bool itself), :negated, true or false."
  [op type]
  (let [map-type? (or (record-type? type) (canonical-typed-map-type? type) (= :map type))
        vector-type? (or (heterogeneous-vector-type? type)
                         (contains? #{:vector-i64 :vector-f64} type))
        set-type? (typed-set-type? type)
        list-type? (canonical-list-type? type)]
    (case op
      true? (if (= :bool type) :operand false)
      false? (if (= :bool type) :negated false)
      boolean? (= :bool type)
      integer? (= :i64 type)
      string? (= :string type)
      keyword? (= :keyword type)
      symbol? (= :symbol type)
      map? map-type?
      vector? vector-type?
      set? set-type?
      (list? seq?) list-type?
      coll? (or map-type? vector-type? set-type? list-type?)))))

#?(:kotoba nil :default (def document-of-constructors tables/document-of-constructors))

#?(:kotoba
(defn document-of-constructor! [c [:ref :ie/ctx] type [:ref :form/r] operand [:ref :form/r]] [:ref :form/r]
  (cond
    (ty? type :document) (tk :identity)
    (ie-tbl-has? c :document-of-constructors type) (ie-tbl-get c :document-of-constructors type)
    :else (throw (fe-reject (str "ex-info data value " (pr-form operand) " has type " (pr-form type)
                                 ", which has no document form here: a data map value must be an "
                                 "i64, string, keyword, bool, f64 or document")
                            "kotoba.error/library-head-document" operand))))
   :default
(defn document-of-constructor!
  "The constructor that makes a value of TYPE a document, `:identity` for a
  document, or a refusal naming the type."
  [type operand]
  (cond (= :document type) :identity
        (contains? document-of-constructors type) (get document-of-constructors type)
        :else (reject! (str "ex-info data value " (pr-str operand) " has type " (pr-str type)
                            ", which has no document form here: a data map value must be an "
                            "i64, string, keyword, bool, f64 or document")
                       operand :kotoba.error/library-head-document))))

#?(:kotoba
(defn library-predicate-answer! [op [:ref :form/r] type [:ref :form/r] operand [:ref :form/r]] [:ref :form/r]
  (let [o (form-text op)]
    (cond
      (ty? type :document) (tk :document)
      (and (schema-ref-type? type) (or (string=? o "map?") (string=? o "coll?")))
      (throw (fe-reject (str o " on " (pr-form type) " is not decided here: a schema reference "
                             "names a record or a variant, and only a record is a map; project "
                             "the value through its declared type")
                        "kotoba.error/library-head-document" (form/form-seq (form/append-form (form/one-form op) operand))))
      (or (option-vector-type? type) (ty? type :option-i64))
      (let [payload (if (ty? type :option-i64) (tk :i64) (form/nth-of type 1))]
        (if (or (ty? payload :document) (ty? payload :bool))
          (throw (fe-reject (str o " on " (pr-form type) " depends on the value, not the type: "
                                 "bind the payload first (when-let / if-let) and ask the payload")
                            "kotoba.error/library-head-document" (form/form-seq (form/append-form (form/one-form op) operand))))
          (if (form/eq (library-predicate-static-answer o payload) (form/bool-form true))
            (tk :present)
            (form/bool-form false))))
      :else (library-predicate-static-answer o type))))
   :default
(defn library-predicate-answer!
  "What `(op x)` is for an operand of TYPE: :operand, :negated, true, false,
  :document (ask its kind) or :present (ask an option's presence)."
  [op type operand]
  (cond
    (= :document type) :document
    (and (schema-ref-type? type) (contains? '#{map? coll?} op))
    (reject! (str op " on " (pr-str type) " is not decided here: a schema reference "
                  "names a record or a variant, and only a record is a map; project "
                  "the value through its declared type")
             (list op operand) :kotoba.error/library-head-document)
    (or (option-vector-type? type) (= :option-i64 type))
    (let [payload (if (= :option-i64 type) :i64 (second type))]
      (if (or (= :document payload) (= :bool payload))
        (reject! (str op " on " (pr-str type) " depends on the value, not the type: "
                      "bind the payload first (when-let / if-let) and ask the payload")
                 (list op operand) :kotoba.error/library-head-document)
        (if (true? (library-predicate-static-answer op payload)) :present false)))
    :else (library-predicate-static-answer op type))))

#?(:kotoba
(defn ie-call [c [:ref :ie/ctx] op [:ref :form/r] args [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [tr (ie-infer-args c args 0 locals sigs (form/no-forms))]
    (ie-call-cond (ie-ctx tr) op args (ie-type tr) locals sigs)))
   :default
(defn infer-call-type-impl [op args locals signatures]
  (let [types (mapv #(infer-expression-type % locals signatures) args)]
    (cond
      (contains? arithmetic op)
      (if (contains? '#{+ - *} op)
        (numeric-operand-type! op args types)
        (do (doseq [[arg type] (map vector args types)]
              (require-expression-type! type :i64 arg))
            :i64))

      (contains? float-division-heads op)
      (let [type (numeric-operand-type! op args types)]
        (when (= :i64 type)
          (reject! "/ has no i64 reading -- integer division is quot; / resolves to f64-div or f32-div by operand type"
                   (cons op args) :kotoba.error/numeric-type-mismatch))
        type)

      (contains? i64-operations op)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :i64 arg))
          :i64)

      (contains? i32-operations op)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :i64 arg))
          :i64)

      (= op '=)
      (if (first-truthy #{:f64 :f32} types)
        ;; Float equality resolves to `f64-eq`/`f32-eq` (IEEE: NaN is never
        ;; equal); a float next to an i64 or the other float width is the
        ;; mixed-type rejection, not "outside the safe value profile".
        (do (numeric-operand-type! op args types) :bool)
        (do (when-not (= (first types) (second types))
              (reject! "equality operands must have the same value type" args))
            ;; `:string` joined 2026-09-25 (superproject adr-2609242330): two
            ;; `:string` operands are `string=?` -- byte equality, the head
            ;; that already lowers everywhere -- and `rewrite-record-projection`
            ;; writes it so before any backend sees `=`.
            (when-not (or (contains? #{:i64 :keyword :bool :option-i64 :result-i64 :vector-i64 :string} (first types))
                          (parametric-result-type? (first types)))
              (reject! (str "equality type is outside the safe value profile"
                            (condp = (first types)
                              :string " -- use string=? for string equality"
                              ""))
                       args))
            :bool))

      (contains? '#{js-nullish? js-truthy? js-strict-equal? js-typeof js-array?} op)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :js-value arg))
          (if (= op 'js-typeof) :string :bool))

      (= op 'js-bool-value)
      (do (require-expression-type! (first types) :bool (first args)) :js-value)

      (= op 'js-undefined) :js-value

      (= op 'js-capture-new)
      (do (require-expression-type! (first types) :js-value (first args))
          (require-expression-type! (second types) :i64 (second args)) :i64)

      (= op 'js-capture-value)
      (do (require-expression-type! (first types) :i64 (first args)) :js-value)

      (= op 'bool-not)
      (do (require-expression-type! (first types) :bool (first args)) :bool)

      (= op 'option-some)
      (do (require-expression-type! (first types) :i64 (first args)) :option-i64)

      (= op 'option-none) :option-i64

      (= op 'option-some?)
      (do (require-expression-type! (first types) :option-i64 (first args)) :bool)

      (= op 'option-value)
      (do (require-expression-type! (first types) :option-i64 (first args))
          (require-expression-type! (second types) :i64 (second args))
          :i64)

      (contains? '#{result-ok result-err} op)
      (do (require-expression-type! (first types) :i64 (first args)) :result-i64)

      (= op 'result-ok?)
      (do (require-expression-type! (first types) :result-i64 (first args)) :bool)

      (contains? '#{result-value result-error} op)
      (do (require-expression-type! (first types) :result-i64 (first args))
          (require-expression-type! (second types) :i64 (second args))
          :i64)

      ;; `(vector-alloc n)` -- n zeros.
      ;;
      ;; `vector-new` is variadic, so a million-slot struct of arrays
      ;; would need a million arguments, and the literal limit refuses
      ;; that long before the item limit does. Correct -- nobody writes a
      ;; book as a literal -- and it left no way to allocate one at all.
      ;; This is the shape `torihiki.slab/alloc` has.
      (= op 'vector-alloc)
      (do (require-expression-type! (nth types 0) :i64 (nth args 0))
          :vector-i64)

      (= op 'vector-new)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :i64 arg))
          :vector-i64)

      (= op 'vector-count)
      (do
        (when-not (or (= :vector-i64 (first types))
                      (canonical-list-type? (first types)))
          (require-expression-type! (first types) :vector-i64 (first args)))
        :i64)

      (= op 'vector-get)
      (do (require-expression-type! (nth types 0) :vector-i64 (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1))
          (require-expression-type! (nth types 2) :i64 (nth args 2)) :i64)

      (= op 'vector-at)
      (do (require-expression-type! (nth types 0) :vector-i64 (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1)) :i64)

      (= op 'vector-drop)
      (do (require-expression-type! (nth types 0) :vector-i64 (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1)) :vector-i64)

      ;; `vector-drop`'s mirror, and typed identically: both take a bounded
      ;; vector and a count and answer a bounded vector. Which END they keep
      ;; is not a type-level difference, which is why one arm is a copy of the
      ;; other and not a variation on it.
      (= op 'vector-take)
      (do (require-expression-type! (nth types 0) :vector-i64 (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1)) :vector-i64)

      ;; `vector-assoc!` types identically, because it IS the same
      ;; operation: the bang only tells a backend it may lower the update
      ;; to a store, and `check-affine-writes!` is what earns that. A
      ;; different type here would make the bang a different operation,
      ;; which is exactly what the KIR interpreter refuses to let it
      ;; become.
      (contains? '#{vector-assoc vector-assoc!} op)
      (do (require-expression-type! (nth types 0) :vector-i64 (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1))
          (require-expression-type! (nth types 2) :i64 (nth args 2)) :vector-i64)

      (= op 'vector-conj)
      (do (require-expression-type! (nth types 0) :vector-i64 (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1)) :vector-i64)

      (= op 'vector-f64-new)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :f64 arg))
          :vector-f64)

      (= op 'vector-f64-count)
      (do (require-expression-type! (first types) :vector-f64 (first args)) :i64)

      (= op 'vector-f64-get)
      (do (require-expression-type! (nth types 0) :vector-f64 (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1))
          (require-expression-type! (nth types 2) :f64 (nth args 2)) :f64)

      (= op 'vector-f64-at)
      (do (require-expression-type! (nth types 0) :vector-f64 (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1)) :f64)

      (= op 'vector-f64-drop)
      (do (require-expression-type! (nth types 0) :vector-f64 (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1)) :vector-f64)

      (= op 'vector-f64-take)
      (do (require-expression-type! (nth types 0) :vector-f64 (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1)) :vector-f64)

      (= op 'vector-f64-assoc)
      (do (require-expression-type! (nth types 0) :vector-f64 (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1))
          (require-expression-type! (nth types 2) :f64 (nth args 2)) :vector-f64)

      (= op 'vector-f64-conj)
      (do (require-expression-type! (nth types 0) :vector-f64 (nth args 0))
          (require-expression-type! (nth types 1) :f64 (nth args 1)) :vector-f64)

      (= op 'string-index-new) :string-index
      (= op 'string-index-count)
      (do (require-expression-type! (first types) :string-index (first args)) :i64)
      (= op 'string-index-contains)
      (do (require-expression-type! (nth types 0) :string-index (nth args 0))
          (require-expression-type! (nth types 1) :string (nth args 1)) :bool)
      (= op 'string-index-get)
      (do (require-expression-type! (nth types 0) :string-index (nth args 0))
          (require-expression-type! (nth types 1) :string (nth args 1)) [:option :i64])
      (= op 'string-index-assoc)
      (do (require-expression-type! (nth types 0) :string-index (nth args 0))
          (require-expression-type! (nth types 1) :string (nth args 1))
          (require-expression-type! (nth types 2) :i64 (nth args 2)) :string-index)
      (= op 'disjoint-set-i64-new)
      (do (require-expression-type! (first types) :i64 (first args)) :disjoint-set-i64)
      (= op 'disjoint-set-i64-count)
      (do (require-expression-type! (first types) :disjoint-set-i64 (first args)) :i64)
      (= op 'disjoint-set-i64-union)
      (do (require-expression-type! (nth types 0) :disjoint-set-i64 (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1))
          (require-expression-type! (nth types 2) :i64 (nth args 2))
          [:option :disjoint-set-i64])

      (= op 'document-null) :document
      (= op 'document-bool)
      (do (require-expression-type! (first types) :bool (first args)) :document)
      (= op 'document-i64)
      (do (require-expression-type! (first types) :i64 (first args)) :document)
      (= op 'document-f64)
      (do (require-expression-type! (first types) :f64 (first args)) :document)
      (= op 'document-string)
      (do (require-expression-type! (first types) :string (first args)) :document)
      (= op 'document-keyword)
      (do (require-expression-type! (first types) :keyword (first args)) :document)
      (= op 'document-symbol)
      (do (require-expression-type! (first types) :symbol (first args)) :document)
      (= op 'document-vector)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :document arg)) :document)
      (= op 'document-list)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :document arg)) :document)
      (= op 'document-set)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :document arg)) :document)
      (= op 'document-map)
      (do (doseq [[[key-form item-form] [key-type item-type]]
                  (map vector (partition 2 args) (partition 2 types))]
            (when-not (contains? #{:keyword :document} key-type)
              (reject! "document-map key must be keyword or document" key-form))
            (require-expression-type! item-type :document item-form)) :document)
      (= op 'document-count)
      (do (require-expression-type! (first types) :document (first args)) :i64)
      (= op 'document-kind)
      (do (require-expression-type! (first types) :document (first args)) :keyword)
      (= op 'document-sha256)
      (do (require-expression-type! (first types) :document (first args)) :string)
      (= op 'document-print)
      (do (require-expression-type! (first types) :document (first args)) :string)
      (= op 'document-read)
      (do (require-expression-type! (first types) :string (first args)) :document)
      (= op 'document-edn-print)
      (do (require-expression-type! (first types) :document (first args)) :string)
      (= op 'document-edn-read)
      (do (require-expression-type! (first types) :string (first args)) :document)
      (= op 'document-vector-at)
      (do (require-expression-type! (nth types 0) :document (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1)) [:option :document])
      (= op 'document-list-at)
      (do (require-expression-type! (nth types 0) :document (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1)) [:option :document])
      (= op 'document-map-entry-at)
      (do (require-expression-type! (nth types 0) :document (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1)) [:option :document])
      (= op 'document-vector-assoc)
      (do (require-expression-type! (nth types 0) :document (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1))
          (require-expression-type! (nth types 2) :document (nth args 2)) :document)
      (= op 'document-vector-conj)
      (do (require-expression-type! (nth types 0) :document (nth args 0))
          (require-expression-type! (nth types 1) :document (nth args 1)) :document)
      (= op 'document-vector-drop)
      (do (require-expression-type! (nth types 0) :document (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1)) :document)
      (= op 'document-vector-remove)
      (do (require-expression-type! (nth types 0) :document (nth args 0))
          (require-expression-type! (nth types 1) :i64 (nth args 1)) :document)
      (= op 'document-vector-sort)
      (do (require-expression-type! (nth types 0) :document (nth args 0)) :document)
      (= op 'document-contains)
      (do (require-expression-type! (nth types 0) :document (nth args 0))
          (when-not (contains? #{:keyword :document} (nth types 1))
            (reject! "document map key must be keyword or document" (nth args 1))) :bool)
      (= op 'document-equal?)
      (do (require-expression-type! (nth types 0) :document (nth args 0))
          (require-expression-type! (nth types 1) :document (nth args 1)) :bool)
      (= op 'document-set-contains?)
      (do (require-expression-type! (nth types 0) :document (nth args 0))
          (require-expression-type! (nth types 1) :document (nth args 1)) :bool)
      (= op 'document-get)
      (do (require-expression-type! (nth types 0) :document (nth args 0))
          (when-not (contains? #{:keyword :document} (nth types 1))
            (reject! "document map key must be keyword or document" (nth args 1))) [:option :document])
      (= op 'document-assoc)
      (do (require-expression-type! (nth types 0) :document (nth args 0))
          (when-not (contains? #{:keyword :document} (nth types 1))
            (reject! "document map key must be keyword or document" (nth args 1)))
          (require-expression-type! (nth types 2) :document (nth args 2)) :document)
      (= op 'document-dissoc)
      (do (require-expression-type! (nth types 0) :document (nth args 0))
          (when-not (contains? #{:keyword :document} (nth types 1))
            (reject! "document map key must be keyword or document" (nth args 1))) :document)
      (= op 'document-merge)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :document arg)) :document)
      (= op 'document-string-value)
      (do (require-expression-type! (first types) :document (first args)) [:option :string])
      (= op 'document-keyword-value)
      (do (require-expression-type! (first types) :document (first args)) [:option :keyword])
      (= op 'document-symbol-value)
      (do (require-expression-type! (first types) :document (first args)) [:option :symbol])
      (= op 'document-bool-value)
      (do (require-expression-type! (first types) :document (first args)) [:option :bool])
      (= op 'document-i64-value)
      (do (require-expression-type! (first types) :document (first args)) [:option :i64])
      (= op 'document-f64-value)
      (do (require-expression-type! (first types) :document (first args)) [:option :f64])
      ;; root ADR-2610092310 S2. document-link answers an option: bytes that
      ;; are not one binary CIDv1 make no link (osaho kotoba.kir).
      (= op 'document-bytes)
      (do (require-expression-type! (first types) :bytes (first args)) :document)
      (= op 'document-bytes-value)
      (do (require-expression-type! (first types) :document (first args)) [:option :bytes])
      (= op 'document-link)
      (do (require-expression-type! (first types) :bytes (first args)) [:option :document])
      (= op 'document-link-value)
      (do (require-expression-type! (first types) :document (first args)) [:option :bytes])

      (contains? (disj comparisons '=) op)
      (do (numeric-operand-type! op args types) :bool)

      (contains? heap-operations op)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :i64 arg))
          :i64)

      (contains? kgraph-operations op)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :i64 arg))
          :i64)

      (or (contains? kernel-memory-operations op)
          (contains? kernel-privileged-operations op))
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :i64 arg))
          :i64)

      ;; boot-lit: the argument is a `:string` and the result is an address or
      ;; a count, which are both i64. This clause has to sit BEFORE the
      ;; privileged one would have matched -- it does, because these heads are
      ;; not in that map -- and it requires `:string` rather than `:i64`, which
      ;; is the whole reason they are a separate family.
      (contains? rodata-literal-operations op)
      (do (require-expression-type! (first types) :string (first args))
          :i64)

      (= op 'cap-call)
      (do (require-expression-type! (second types) :i64 (second args)) :i64)

      (= op 'string-byte-length)
      (do (require-expression-type! (first types) :string (first args)) :i64)

      ;; Product Value ABI v1: alias of string-byte-length (UTF-8 byte count;
      ;; same unit as string-substring indices). Prefer this name in pure-product.
      (= op 'string-length)
      (do (require-expression-type! (first types) :string (first args)) :i64)

      ;; The helper `str` of an :i64 part is rewritten to (floor
      ;; :integer-str) is injected after `rewrite-record-projection`, so a
      ;; specialization's result inferred from its rewritten body -- a row
      ;; function returning [(str "w" n) s] (floor
      ;; :row-tuple-element-argument) -- meets it before it is a function of
      ;; this module. It is string-from-i64's printer (the name is
      ;; `desugar/string-from-i64-helper-name` = '__kotoba_string_from_i64;
      ;; quoted here because desugar depends on infer, not the reverse).
      (or (= op 'string-from-i64) (= op '__kotoba_string_from_i64))
      (do (require-expression-type! (first types) :i64 (first args)) :string)

      ;; ADR 0353 floor :integer-str: `str` formats a :string or an :i64
      ;; part; `rewrite-record-projection` writes it as `string-concat` and
      ;; `string-from-i64`. An aggregate is not printed implicitly.
      (= op 'str)
      (do (doseq [[arg type] (map vector args types)]
            (str-part-type! type arg))
          :string)

      ;; T4.2: desugars away; defensive typing if seen pre-desugar.
      (= op 'string-join)
      (do (when (zero? (count args))
            (reject! "string-join requires a separator string" args))
          (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :string arg))
          :string)

      (= op 'bytes-task-byte-count)
      (do (require-expression-type! (first types) [:task [:stream :bytes]] (first args))
          :i64)

      (= op 'task-ready?)
      (do (require-expression-type! (first types) [:task [:stream :bytes]] (first args))
          :i64)

      (= op 'object-cas-won)
      (let [descriptor (first types)
            fields (when (and (vector? descriptor)
                              (= :record (first descriptor)))
                     (nth descriptor 2 nil))]
        (when-not (and (seq fields)
                       (= :bool (second (first fields))))
          (reject! "object-cas-won requires a record whose first field is bool"
                   (first args)))
        :i64)

      (contains? '#{bytes-response-byte-count log-read-byte-count} op)
      (let [descriptor (first types)
            fields (when (and (vector? descriptor) (= :record (first descriptor)))
                     (nth descriptor 2 nil))
            field (if (= op 'bytes-response-byte-count) (first fields) (second fields))]
        (when-not (= :string (second field))
          (reject! (str op " requires a record bytes field") (first args)))
        :i64)

      (= op 'bool-result)
      (do (require-expression-type! (first types) :bool (first args)) :i64)

      (= op 'http-response-status)
      (let [descriptor (first types)
            fields (when (and (vector? descriptor) (= :record (first descriptor)))
                     (nth descriptor 2 nil))]
        (when-not (= :i64 (second (first fields)))
          (reject! "http-response-status requires a record status field" (first args)))
        :i64)

      ;; `:bool`, not `:i64`. Profile 5 (compiler ADR 0191) moved comparisons
      ;; and predicates to `:bool` so `and`/`or`/`not` compose and a predicate
      ;; can be written the way Clojure writes one. It carried
      ;; `= < > <= >= not not= zero? pos? neg? empty? some?` and left the two
      ;; string predicates behind — in this same file, where the later
      ;; `string-index-contains` returns `:bool`. So one file typed two
      ;; spellings of the same question differently, a `:bool`-declared
      ;; function could not return a string predicate, and
      ;; `(and (string=? a b) (string=? a c))` was rejected.
      ;;
      ;; The cost of the omission was paid at every call site: authors wrapped
      ;; predicates in `(if p true false)` — ADR 0191's own mechanical
      ;; migration, run backwards.
      (= op 'string=?)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :string arg))
          :bool)

      (= op 'string-concat)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :string arg))
          :string)

      (= op 'string-substring)
      (do (require-expression-type! (first types) :string (first args))
          (doseq [[arg type] (map vector (rest args) (rest types))]
            (require-expression-type! type :i64 arg))
          :string)

      (= op 'string-replace-all)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :string arg))
          :string)

      (= op 'string-contains?)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :string arg))
          :bool)

      (= op 'string-index-of)
      (do (require-expression-type! (first types) :string (first args))
          (require-expression-type! (second types) :string (second args))
          :i64)

      (= op 'string-split-count)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :string arg))
          :i64)

      ;; ABI v7 text heads.
      (= op 'string-compare)
      (do (require-expression-type! (first types) :string (first args))
          (require-expression-type! (second types) :string (second args))
          :i64)

      (= op 'string-fold-ascii)
      (do (require-expression-type! (first types) :string (first args))
          :string)

      (contains? '#{string-find-blank string-skip-blank} op)
      (do (require-expression-type! (first types) :string (first args))
          (require-expression-type! (second types) :i64 (second args))
          :i64)

      ;; ABI v8 line heads.
      (= op 'string-index-of-from)
      (do (require-expression-type! (first types) :string (first args))
          (require-expression-type! (second types) :string (second args))
          (require-expression-type! (nth types 2) :i64 (nth args 2))
          :i64)

      (= op 'string-compare-lines)
      (do (require-expression-type! (first types) :string (first args))
          (require-expression-type! (second types) :i64 (second args))
          (require-expression-type! (nth types 2) :string (nth args 2))
          (require-expression-type! (nth types 3) :i64 (nth args 3))
          :i64)

      ;; ABI v10 range heads.
      (= op 'string-find-byte)
      (do (require-expression-type! (first types) :string (first args))
          (require-expression-type! (second types) :i64 (second args))
          (require-expression-type! (nth types 2) :i64 (nth args 2))
          :i64)

      (= op 'string-append-range)
      (do (require-expression-type! (first types) :string (first args))
          (require-expression-type! (second types) :string (second args))
          (require-expression-type! (nth types 2) :i64 (nth args 2))
          (require-expression-type! (nth types 3) :i64 (nth args 3))
          :string)

      ;; The region's whole safety argument is this one clause: a scalar
      ;; cannot carry a handle out of the region, and every mutable structure
      ;; the body could reach holds numbers. So the body's type is the
      ;; scope's type, and only a scalar is admitted -- by name, so that a
      ;; string body is refused for the reason it is dangerous rather than
      ;; falling out of a type mismatch somewhere downstream.
      (= op 'arena-scope)
      (let [type (first types)]
        (when-not (contains? #{:i64 :bool :f64} type)
          (reject! (str "arena-scope body must be :i64, :bool or :f64, got "
                        (pr-str type)
                        ": a handle would escape the region it is released with")
                   (cons op args) :kotoba.error/arena-scope-body-not-scalar))
        type)

      (= op 'string-code-point-at)
      (do (require-expression-type! (first types) :string (first args))
          (require-expression-type! (second types) :i64 (second args))
          :i64)

      (= op 'string-fold-case)
      (do (require-expression-type! (first types) :string (first args)) :string)

      (= op 'string-upper)
      (do (require-expression-type! (first types) :string (first args)) :string)

      (= op 'keyword-from-string)
      (do (require-expression-type! (first types) :string (first args)) :keyword)

      (= op 'keyword-name)
      (do (require-expression-type! (first types) :keyword (first args)) :string)

      (= op 'symbol)
      (do (require-expression-type! (first types) :string (first args)) :symbol)

      (= op 'xml-path-count)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :string arg))
          :i64)

      (= op 'xml-name-count)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :string arg))
          :i64)

      (= op 'xml-name-text)
      (do (require-expression-type! (nth types 0) :string (nth args 0))
          (require-expression-type! (nth types 1) :string (nth args 1))
          (require-expression-type! (nth types 2) :i64 (nth args 2))
          [:option :string])

      (= op 'xml-path-text)
      (do (require-expression-type! (nth types 0) :string (nth args 0))
          (require-expression-type! (nth types 1) :string (nth args 1))
          (require-expression-type! (nth types 2) :i64 (nth args 2))
          [:option :string])

      (= op 'xml-path-attr)
      (do (require-expression-type! (nth types 0) :string (nth args 0))
          (require-expression-type! (nth types 1) :string (nth args 1))
          (require-expression-type! (nth types 2) :i64 (nth args 2))
          (require-expression-type! (nth types 3) :string (nth args 3))
          [:option :string])

      (= op 'decimal-f64-parse)
      (do (require-expression-type! (first types) :string (first args))
          [:option :f64])

      (= op 'decimal-f64x3-parse)
      (do (require-expression-type! (first types) :string (first args))
          [:option [:vector [:f64 :f64 :f64]]])

      (= op 'f64-to-bits)
      (do (require-expression-type! (first types) :f64 (first args)) :i64)

      (= op 'f64-from-bits)
      (do (require-expression-type! (first types) :i64 (first args)) :f64)

      (contains? '#{i64-to-f64-checked i64-to-f64-rounded} op)
      (do (require-expression-type! (first types) :i64 (first args)) :f64)

      (contains? '#{f64-to-i64-checked f64-to-i64-truncating} op)
      (do (require-expression-type! (first types) :f64 (first args)) :i64)

      (contains? '#{f64-add f64-sub f64-mul f64-div f64-min f64-max} op)
      (do (doseq [[type arg] (map vector types args)]
            (require-expression-type! type :f64 arg))
          :f64)

      (contains? '#{f64-neg f64-abs f64-sqrt f64-sin-quarter-turn f64-cos-quarter-turn
                    f64-sin-bounded f64-cos-bounded f64-exp-near-zero f64-log-near-one} op)
      (do (require-expression-type! (first types) :f64 (first args)) :f64)

      (= op 'f64-atan2-bounded)
      (do (doseq [[type arg] (map vector types args)]
            (require-expression-type! type :f64 arg))
          :f64)

      (contains? '#{f64-exp-bounded f64-log-bounded} op)
      (do (require-expression-type! (first types) :f64 (first args)) :f64)

      (contains? '#{f64-eq f64-lt f64-le f64-gt f64-ge f64-unordered} op)
      (do (doseq [[type arg] (map vector types args)]
            (require-expression-type! type :f64 arg))
          :bool)

      (= op 'f32-to-bits)
      (do (require-expression-type! (first types) :f32 (first args)) :i64)

      (= op 'f32-from-bits)
      (do (require-expression-type! (first types) :i64 (first args)) :f32)

      (= op 'f64-to-f32-rounded)
      (do (require-expression-type! (first types) :f64 (first args)) :f32)

      (= op 'f32-to-f64-exact)
      (do (require-expression-type! (first types) :f32 (first args)) :f64)

      (contains? '#{i64-to-f32-checked i64-to-f32-rounded} op)
      (do (require-expression-type! (first types) :i64 (first args)) :f32)

      (contains? '#{f32-to-i64-checked f32-to-i64-truncating} op)
      (do (require-expression-type! (first types) :f32 (first args)) :i64)

      (contains? '#{f32-add f32-sub f32-mul f32-div f32-min f32-max} op)
      (do (doseq [[type arg] (map vector types args)]
            (require-expression-type! type :f32 arg))
          :f32)

      (contains? '#{f32-neg f32-abs f32-sqrt} op)
      (do (require-expression-type! (first types) :f32 (first args)) :f32)

      (contains? '#{f32-eq f32-lt f32-le f32-gt f32-ge f32-unordered} op)
      (do (doseq [[type arg] (map vector types args)]
            (require-expression-type! type :f32 arg))
          :bool)

      ;; ADR 0353 floor :empty-map-literal (monolith a7ef280 11731-11743).
      ;; A literal with keyword keys is a record, and `{}` has none: no field
      ;; set, no row to extend. What gives it one -- a record or typed map its
      ;; context declares, or the first key an `assoc` puts in it -- has
      ;; already rewritten it by now, so an empty literal reaching here is
      ;; refused rather than becoming the retired keyword->i64 map.
      (and (= op 'map-new) (empty? args))
      (reject! (str "an empty map literal {} has no row to extend: it is not a "
                    "keyword->i64 map any more, and nothing here says its type. "
                    "assoc keys into it ((assoc {} :a 1) is the record {:a 1}), "
                    "write the literal with its fields, or give it a record or "
                    "[:map K V] type from context")
               (list 'map-new) :kotoba.error/empty-map-literal)

      (= op 'map-new)
      (do (doseq [[key-form value-form key-type value-type]
                  (map (fn [[key-form value-form] [key-type value-type]]
                         [key-form value-form key-type value-type])
                       (partition 2 args) (partition 2 types))]
            (require-expression-type! key-type :keyword key-form)
            (require-expression-type! value-type :i64 value-form))
          :map)

      (= op 'map-get)
      (do (require-expression-type! (nth types 0) :map (nth args 0))
          (require-expression-type! (nth types 1) :keyword (nth args 1))
          (require-expression-type! (nth types 2) :i64 (nth args 2))
          :i64)

      ;; ADR 0353 floor :row-operations: on a record receiver these are row
      ;; operations, typed here because a function's result is inferred
      ;; before `rewrite-record-projection` elaborates them.
      (and (contains? row-operation-heads op) (row-op-record (first types)))
      (row-op-result-type (first types)
                          (row-op-fields op args types locals signatures (cons op args)))

      (contains? '#{select-keys merge} op)
      (row-op-not-record! op (first args) (first types) (cons op args))

      ;; `assoc` on a document is a document (the rewrite lowers it to
      ;; document-assoc); typed here so a loop over the result knows its type
      (and (= op 'map-assoc) (= :document (first types)))
      :document

      (= op 'map-assoc)
      (do (require-expression-type! (first types) :map (first args))
          (doseq [[key-form value-form key-type value-type]
                  (map (fn [[key-form value-form] [key-type value-type]]
                         [key-form value-form key-type value-type])
                       (partition 2 (rest args)) (partition 2 (rest types)))]
            (require-expression-type! key-type :keyword key-form)
            (require-expression-type! value-type :i64 value-form))
          :map)

      (contains? signatures op)
      (let [{expected :param-types result :result} (get signatures op)]
        (if (and *loop-helper-recorder* (contains? *loop-helper-names* op))
          ;; Resolution pass: this loop-helper's param-types are not yet known.
          ;; Record the call-site argument types AS its param-types rather than
          ;; checking against the placeholder signature. The (non-recursive)
          ;; enclosing call site is inferred before the helper's own body, so
          ;; the recorded types are the enclosing-scope types of the loop
          ;; bindings' inits and the captured outer variables.
          (vswap! *loop-helper-recorder* assoc op (vec types))
          (doseq [[arg actual wanted] (map vector args types expected)]
            (require-expression-type! actual wanted arg)))
        result)

      ;; `conj` onto a bounded vector is that vector (`rewrite-record-projection`
      ;; writes `vector-conj` / `vector-f64-conj`), and onto a typed set that
      ;; set. Typed HERE because a loop exit is typed before that rewrite runs:
      ;; without this arm `(conj v x)` as a loop exit fell to
      ;; `unknown-operation!`, the exit typing swallowed it, and the helper kept
      ;; its `:i64` placeholder -- `expected vector-i64, got i64` at the loop
      ;; (measured 2026-09-25, adr-2609242330 S5).
      (and (contains? set-operations op) (seq (rest args))
           (or (and (= op 'conj) (contains? #{:vector-i64 :vector-f64} (first types)))
               (typed-set-type? (first types))))
      (first types)

      (= op '__kotoba_document_of)
      (do (document-of-constructor! (first types) (first args)) :document)

      (contains? library-predicate-heads op)
      (do (when-not (= 1 (count args))
            (reject! (str op " requires exactly one operand") (cons op args)
                     :kotoba.error/library-head-shape))
          (library-predicate-answer! op (first types) (first args))
          :bool)

      ;; A friendly capability operation whose result is the same wherever it
      ;; is written (the app-data reads/writes answer text or bytes by NAME).
      ;; It is typed here so the abort passes, which run before named-ability
      ;; elaboration, can see a `try` body that makes one.
      (contains? named-operation-default-results op)
      (get named-operation-default-results op)

      :else (unknown-operation! op op signatures)))))

#?(:kotoba nil :default (def ^:dynamic *absence-tail*
  "True while inferring a tail of the present branch of an absence (see
  `absence-type`): only there does `lenient-branch-join` apply."
  false))

#?(:kotoba
(defn ie-infer [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (if (and (ctx-tail? ctx) (not (tail-form? form)))
    (let [r (ie-infer-impl (ctx-tail ctx false) form locals sigs)]
      (ie-r (ie-type r) (ctx-tail (ie-ctx r) true)))
    (ie-infer-impl ctx form locals sigs)))
   :default
(defn infer-expression-type [form locals signatures]
  (try (if (and *absence-tail*
                (not (and (seq? form) (contains? '#{if let do} (first form)))))
         ;; Leniency reaches only the tail positions `if` / `let` / `do`
         ;; thread; every other form is typed as before.
         (binding [*absence-tail* false] (infer-expression-type-impl form locals signatures))
         (infer-expression-type-impl form locals signatures))
       (catch #?(:clj Throwable :cljs :default) error (internal-failure! error form)))))

#?(:kotoba
(defn infer-expression-type [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (ie-infer ctx form locals sigs))
   :default nil)

#?(:kotoba
(defn zip-locals-from [params [:ref :form/r] ptypes [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (or (>= i (form/count-of params)) (>= i (form/count-of ptypes)))
    acc
    (zip-locals-from params ptypes (+ i 1) (form/assoc-form acc (form/nth-of params i) (form/nth-of ptypes i)))))
   :default nil)

#?(:kotoba
(defn zip-locals [params [:ref :form/r] ptypes [:ref :form/r]] [:ref :form/r]
  (zip-locals-from params ptypes 0 (empty-fmap)))
   :default nil)

#?(:kotoba
(defn fn-signature [f [:ref :form/r]] [:ref :form/r]
  (fput (fput (fput (fput (empty-fmap) :params (fget f :params)) :param-types (fget f :param-types)) :result (fget f :result)) :param-types-inferred (fget f :param-types-inferred)))
   :default nil)

#?(:kotoba
(defn ie-type-of [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (ie-type (ie-infer ctx form locals sigs)))
   :default nil)

#?(:kotoba
(defn record-get-default-type [ctx [:ref :ie/ctx] descriptor [:ref :form/r] key [:ref :form/r] default [:ref :form/r] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [r (ie-infer ctx default locals sigs)
        field-type (record-field-type descriptor key (ctx-schemas ctx))]
    (if (ftruthy? field-type)
      (let [_ (require-expression-type! (ie-type r) field-type default)
            _ (default-literal! default key descriptor form)]
        (ie-r field-type (ie-ctx r)))
      r)))
   :default
(defn record-get-default-type
  "`(get r :k d)` / `(:k r d)` on a record (ADR 0353 floor :literal-typing).
  A record is closed, so whether it has :k is known here: a field it lacks
  answers the default (lowered `(do r d)`), a field it has answers the field
  and the default must be the field's type -- no coercion. The default of a
  field that is present is never evaluated, so it must be a literal or a
  local: anything else is refused by name rather than silently dropped."
  [descriptor key default form locals signatures]
  (let [default-type (infer-expression-type default locals signatures)]
    (if-let [field-type (record-field-type descriptor key)]
      (do (require-expression-type! default-type field-type default)
          (when-not (or (symbol? default) (keyword? default) (string? default)
                        (boolean? default) (kotoba-integer? default)
                        (value/f64-value? default))
            (reject! (str "the default of " (pr-str key) " on record " (second descriptor)
                          " is never evaluated, because the record has that field:"
                          " write the default as a literal or a local")
                     form :kotoba.error/record-projection-unresolved))
          field-type)
      default-type))))

#?(:kotoba
(defn ie-infer-impl [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (cond
    (kotoba-integer? form) (ie-r (tk :i64) ctx)
    (form/is-f64? form) (ie-r (tk :f64) ctx)
    (form/is-string? form) (ie-r (tk :string) ctx)
    (form/is-keyword? form) (ie-r (tk :keyword) ctx)
    (form/is-bool? form) (ie-r (tk :bool) ctx)
    (form/is-symbol? form) (ie-symbol ctx form locals sigs)
    (form/is-seq? form) (ie-seq ctx form locals sigs)
    :else (throw (fe-reject "value has no admitted type" "kotoba.error/subset-reject" form))))
   :default
(defn infer-expression-type-impl [form locals signatures]
  (cond
    (kotoba-integer? form) :i64
    (value/f64-value? form) :f64
    (string? form) :string
    (keyword? form) :keyword
    (boolean? form) :bool
    (symbol? form) (or (get locals form)
                       (unbound-symbol! "unbound symbol has no value type"
                                        form locals signatures))
    (seq? form)
    (let [[op & args] form]
      (case op
        let (let [bindings (first args) body (let-body args form)]
              (loop [pairs (partition 2 bindings) current locals]
                (if-let [[name value] (first pairs)]
                  (let [type (binding [*absence-tail* false]
                               (infer-expression-type value current signatures))
                        type (cond
                               ;; a `reduce` over a `[:list T]` parameter binds
                               ;; the list itself, not a vector-i64
                               (and (bounded-vector-source-binding? name)
                                    (or (canonical-list-type? type) (= :document type)))
                               type

                               (bounded-vector-source-binding? name)
                               (do (require-expression-type! type :vector-i64 value)
                                   :vector-i64)

                               :else type)]
                    (recur (next pairs)
                           ;; local-state slice 1: a cell binding carries the
                           ;; cell's identity in its name, so every rebinding
                           ;; is checked against the type `(atom init)` gave it.
                           (local-state-check-cell-type!
                            name type (assoc current name type) form)))
                  (infer-expression-type body current signatures))))
        __kotoba_absent (case (first args) :nil nil-kind :none none-kind absent-kind)
        ;; `if-let` / `when-let`'s binding before `rewrite-record-projection`
        ;; resolves it (`option-present-value`): an option's payload, or the
        ;; value itself. Typed here so a function whose result passes through
        ;; one has a result before the rewrite (gap 1: `(when-let [x o] v)`).
        __kotoba_present (let [t (infer-expression-type (first args) locals signatures)]
                           (cond (option-vector-type? t) (second t)
                                 (= :option-i64 t) :i64
                                 :else t))
        if (let [[test then else] args
                 tail? *absence-tail*
                 absent-then? (absence-in-tail? then)
                 absent-else? (absence-in-tail? else)
                 test-type (binding [*absence-tail* false]
                             (infer-expression-type test locals signatures))
                 ;; The present branch of an absence is read leniently: an
                 ;; inner `(if c v (recur ...))` meets v's T with the loop's
                 ;; [:option T] (`lenient-branch-join`).
                 then-type (binding [*absence-tail* (or tail? absent-else?)]
                             (infer-expression-type then locals signatures))
                 else-type (binding [*absence-tail* (or tail? absent-then?)]
                             (infer-expression-type else locals signatures))
                 ;; ADR 0353 floor :absence: an option test is presence.
                 ;; `rewrite-record-projection` turns it into the :bool
                 ;; presence test (`option-presence-test`); until then it is
                 ;; typed as the :bool it becomes, so a function whose result
                 ;; passes through `if-let` / `when-let` has a result before
                 ;; the rewrite and its callers can be typed against it.
                 test-type (if (or (option-vector-type? test-type) (= :option-i64 test-type))
                             :bool test-type)]
             ;; ADR 0353 floor :bool-predicates: numbers are never truthy.
             ;; An option test never reaches here (it is presence, rewritten
             ;; by `option-presence-test`), and no predicate answers a number
             ;; (`i64-answer-predicates`), so the only test is `:bool`.
             (when (= :i64 test-type)
               (reject! (str "if test is :i64, and a number is never truthy: "
                             "compare it (for example (not= x 0)) or answer :bool")
                        test))
             (when-not (= :bool test-type)
               (reject! "if test must be bool or an option" test))
             ;; A branch that aborts has no value, so the other branch's type is
             ;; the `if`'s. Two aborting branches make the `if` itself bottom.
             (cond
               (absence-kind? else-type) (absence-type then-type (absence-kind-mode else-type))
               (absence-kind? then-type) (absence-type else-type (absence-kind-mode then-type))
               (= then-type abort-bottom) else-type
               (= else-type abort-bottom) then-type
               (= then-type else-type) then-type
               ;; a closed-schema reference and its nominal descriptor are one
               ;; type (`same-expression-type?`): the join is the reference
               ;; spelling when either branch has it
               (same-expression-type? then-type else-type)
               (if (schema-ref-type? else-type) else-type then-type)
               (and (or tail? absent-then? absent-else?) (lenient-branch-join then-type else-type))
               (lenient-branch-join then-type else-type)
               *lenient-branch-joins?* then-type
               :else (reject! "if branches must have the same value type" form)))
        do (let [tail? *absence-tail*]
             (last (map-indexed (fn [index arg]
                                  (binding [*absence-tail* (and tail? (= index (dec (count args))))]
                                    (infer-expression-type arg locals signatures)))
                                args)))
        ;; State ability, slice 1: an operation resolved to its handler has
        ;; that handler's state type; `put` takes one. A handle has its body's
        ;; type, and its initial state must be the handler's.
        __kotoba_state_op
        (let [[handler-key op & values] args
              state-type (:state-type (get (some-> *state-handlers* deref) handler-key))]
          (when-not state-type
            (reject! (str "state operation names no handler: " handler-key) form
                     :kotoba.error/state-shape))
          (when (= :put op)
            (require-expression-type! (infer-expression-type (first values) locals signatures)
                                      state-type (first values)))
          state-type)
        __kotoba_state_with
        (let [[handler-key init body] args
              state-type (:state-type (get (some-> *state-handlers* deref) handler-key))]
          (when-not state-type
            (reject! (str "handle names no handler: " handler-key) form :kotoba.error/state-shape))
          (require-expression-type! (infer-expression-type init locals signatures) state-type init)
          (infer-expression-type body locals signatures))
        throw
        (let [[value] args]
          (when-not (= 1 (count args))
            (reject! "throw requires exactly one error value" form :kotoba.error/abort-shape))
          (let [error-type (infer-expression-type value locals signatures)]
            (when (= error-type abort-bottom)
              (reject! "throw of a value that itself always aborts" form :kotoba.error/abort-shape))
            (when *abort-throw-types*
              (vswap! *abort-throw-types* conj error-type))
            abort-bottom))
        try
        (let [[body clause] args
              [explicit binder handler] (try-clause-parts clause form)
              thrown (volatile! [])
              body-type (binding [*abort-throw-types* thrown]
                          (infer-expression-type body locals signatures))
              candidates (distinct (into @thrown (abort-callee-error-types body)))
              type-text #(if (keyword? %) (name %) (pr-str %))
              error-type (cond
                           (some? explicit) explicit
                           (> (count candidates) 1)
                           (reject! (str "try body aborts with two different error types: "
                                         (type-text (first candidates)) " and "
                                         (type-text (second candidates)))
                                    form :kotoba.error/abort-error-type)
                           (= 1 (count candidates)) (first candidates)
                           :else abort-unknown-error)
              handler-type (infer-expression-type handler (assoc locals binder error-type) signatures)]
          (cond
            (= body-type abort-bottom) handler-type
            (= handler-type abort-bottom) body-type
            (same-expression-type? body-type handler-type) body-type
            :else (reject! (str "try body and catch handler must have the same value type: "
                                (type-text body-type) " and " (type-text handler-type))
                           form :kotoba.error/abort-value-type)))
        typed-cap-call
        (let [[_ request-type result-type request] args]
          (validate-value-type! request-type)
          (validate-value-type! result-type)
          (require-expression-type! (infer-expression-type request locals signatures)
                                    request-type request)
          result-type)
        result-ok-of
        (let [[type payload] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type payload locals signatures)
                                    (second type) payload)
          type)
        result-err-of
        (let [[type payload] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type payload locals signatures)
                                    (nth type 2) payload)
          type)
        result-ok?-of
        (let [[type result] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type result locals signatures) type result)
          :bool)
        result-value-of
        (let [[type result fallback] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type result locals signatures) type result)
          (require-expression-type! (infer-expression-type fallback locals signatures)
                                    (second type) fallback)
          (second type))
        result-error-of
        (let [[type result fallback] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type result locals signatures) type result)
          (require-expression-type! (infer-expression-type fallback locals signatures)
                                    (nth type 2) fallback)
          (nth type 2))
        result-match-of
        (let [[type result ok-name ok-body err-name err-body] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type result locals signatures) type result)
          (let [ok-type (infer-expression-type ok-body (assoc locals ok-name (second type)) signatures)
                err-type (infer-expression-type err-body (assoc locals err-name (nth type 2)) signatures)]
            (when-not (= ok-type err-type)
              (reject! "result match branches must have the same value type" form))
            ok-type))
        variant-new
        (let [[type tag payload] args
              type (canonical-closure-result-type type)
              payload-type (first-truthy (fn [[case-tag case-type]]
                                   (when (= case-tag tag) case-type))
                                 (nth type 2))]
          (validate-value-type! type)
          (when-not payload-type (reject! "variant constructor tag is not declared" form))
          (require-expression-type! (infer-expression-type payload locals signatures)
                                    payload-type payload)
          type)
        variant-match
        (let [[type value branches] args
              type (canonical-closure-result-type type)
              cases (nth type 2)]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (let [branch-types
                (mapv (fn [[[tag payload-type] [_ binder body]]]
                        (infer-expression-type body (assoc locals binder payload-type) signatures))
                      (map vector cases branches))]
            (when-not (apply = branch-types)
              (reject! "variant match branches must have the same value type" form))
            (first branch-types)))
        option-some-of
        (let [[type payload] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type payload locals signatures)
                                    (second type) payload)
          type)
        option-none-of
        (let [[type] args] (validate-value-type! type) type)
        option-some?-of
        (let [[type value] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          :bool)
        option-value-of
        (let [[type value fallback] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (require-expression-type! (infer-expression-type fallback locals signatures)
                                    (second type) fallback)
          (second type))
        option-match
        (let [[type value none-body some-name some-body] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (let [none-type (infer-expression-type none-body locals signatures)
                some-type (infer-expression-type some-body
                                                 (assoc locals some-name (second type)) signatures)]
            (when-not (= none-type some-type)
              (reject! "option match branches must have the same value type" form))
            none-type))
        typed-list-new
        (let [[type & items] args]
          (validate-value-type! type)
          (doseq [item items]
            (require-expression-type! (infer-expression-type item locals signatures)
                                      (second type) item))
          type)
        typed-list-nth
        (let [[type value index] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (require-expression-type! (infer-expression-type index locals signatures) :i64 index)
          (second type))
        typed-list-conj
        (let [[type value item] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (require-expression-type! (infer-expression-type item locals signatures)
                                    (second type) item)
          type)
        bytes-empty :bytes
        bytes-count
        (let [[value] args]
          (require-expression-type! (infer-expression-type value locals signatures)
                                    :bytes value)
          :i64)
        bytes-at
        ;; The result is the *unsigned* byte, so it widens into i64 rather than
        ;; carrying a narrower byte type the rest of the language does not have.
        ;; Whether the index is in range is a run-time fact, not a typing one:
        ;; backends must bounds-check and trap, never read past the operand.
        (let [[value index] args]
          (require-expression-type! (infer-expression-type value locals signatures)
                                    :bytes value)
          (require-expression-type! (infer-expression-type index locals signatures)
                                    :i64 index)
          :i64)
        bytes-slice
        ;; Half-open [start, end): the result length is `end - start`, so an
        ;; empty slice is `start = end` and no offset is ever one past a byte
        ;; that has to exist. As with bytes-at, `0 <= start <= end <= count` is
        ;; a run-time fact rather than a typing one, and backends must enforce
        ;; it against the *operand's* length -- not against whatever buffer the
        ;; operand happens to live in -- and trap otherwise. A backend that
        ;; returns the subrange as a view rather than a copy must also say so:
        ;; the result then aliases the operand and cannot outlive it.
        (let [[value start end] args]
          (require-expression-type! (infer-expression-type value locals signatures)
                                    :bytes value)
          (require-expression-type! (infer-expression-type start locals signatures)
                                    :i64 start)
          (require-expression-type! (infer-expression-type end locals signatures)
                                    :i64 end)
          :bytes)
        bytes-concat
        ;; The first bytes operation that cannot be answered by pointing into
        ;; an operand: the result is longer than either input, so somewhere to
        ;; put it has to exist. Backends therefore owe three things typing
        ;; cannot check -- that the destination does not overlap either
        ;; operand, that the combined length neither overflows nor exceeds the
        ;; space actually available, and that the cost charged for the join
        ;; grows with the bytes moved rather than with the instruction count.
        ;; A backend whose copy is one bulk instruction satisfies the first two
        ;; and quietly fails the third.
        (let [[left right] args]
          (require-expression-type! (infer-expression-type left locals signatures)
                                    :bytes left)
          (require-expression-type! (infer-expression-type right locals signatures)
                                    :bytes right)
          :bytes)
        bytes-from-vector-i64
        (let [[value] args]
          (require-expression-type! (infer-expression-type value locals signatures)
                                    :vector-i64 value)
          :bytes)
        vector-i64-from-bytes
        (let [[value] args]
          (require-expression-type! (infer-expression-type value locals signatures)
                                    :bytes value)
          :vector-i64)
        string-from-utf8
        (let [[value] args]
          (require-expression-type! (infer-expression-type value locals signatures)
                                    :bytes value)
          :string)
        hetero-vector-new
        (let [[type & items] args
              item-types (second type)]
          (validate-value-type! type)
          (doseq [[item item-type] (map vector items item-types)]
            (require-expression-type! (infer-expression-type item locals signatures)
                                      item-type item))
          type)
        hetero-vector-count
        (let [[type value] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          :i64)
        hetero-vector-at
        (let [[type value index] args
              item-types (second type)
              host-index (heterogeneous-vector-index! index item-types form)]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (nth item-types host-index))
        __kotoba_destructure_get
        (let [[value key default] args
              value-type (infer-expression-type value locals signatures)
              descriptor (resolve-ref-type value-type)]
          (cond
            (canonical-typed-map-type? value-type)
            (do
              (when-not (= 3 (count args))
                (reject! "typed-map destructuring requires an :or default"
                         form :kotoba.error/destructure-default))
              (require-expression-type! (infer-expression-type key locals signatures)
                                        (second value-type) key)
              (require-expression-type! (infer-expression-type default locals signatures)
                                        (nth value-type 2) default)
              (nth value-type 2))

            (record-type? descriptor)
            (or (record-field-type descriptor key)
                (reject! "record field is not declared"
                         form :kotoba.error/record-field))

            :else
            (infer-call-type 'map-get
                             [value key (if (= 3 (count args)) default 0)]
                             locals signatures)))
        get
        (let [[value key default] args
              value-type (infer-expression-type value locals signatures)
              descriptor (resolve-ref-type value-type)]
          (cond
            ;; `get` on a document: an option of the entry, or the entry or the
            ;; default when one is given
            (= :document value-type)
            (if (= 3 (count args)) :document [:option :document])

            (canonical-typed-map-type? value-type)
            (do
              (require-expression-type! (infer-expression-type key locals signatures)
                                        (second value-type) key)
              (if (= 3 (count args))
                (do
                  (require-expression-type!
                   (infer-expression-type default locals signatures)
                   (nth value-type 2) default)
                  (nth value-type 2))
                [:option (nth value-type 2)]))

            (and (record-type? descriptor) (= 3 (count args)) (keyword? key))
            (record-get-default-type descriptor key default form locals signatures)

            (record-type? descriptor)
            (do
              (when-not (= 2 (count args))
                (reject! "record get requires a value and one keyword field"
                         form :kotoba.error/record-projection-unresolved))
              (or (record-field-type descriptor key)
                  (reject! "record field is not declared"
                           form :kotoba.error/record-field)))

            :else
            (infer-call-type 'map-get
                             [value key (if (= 3 (count args)) default 0)]
                             locals signatures)))
        ;; `count` and the pair accessors need a TYPE here as well as a
        ;; lowering below, for the reason `nth` has one: parameter inference
        ;; runs before `rewrite-record-projections`, and it reads a refused
        ;; operand's required type out of the refusal's ex-data. A head that
        ;; only gained a rewrite would still be REFUSED during that earlier
        ;; pass, and the `:kotoba.error/expected :i64` of that refusal was
        ;; then attributed to an unrelated synthesized parameter. Measured
        ;; 2026-09-03: with the rewrite alone,
        ;;   (+ (pair-first [1 4 2]) (reduce add 4 [1 2 3]))
        ;; produced a `reduce` loop helper whose collection parameter was
        ;; typed `:i64` instead of `:vector-i64`, and the program was refused
        ;; naming `__kotoba_reduce_v_1` -- a binding the author never wrote.
        ;; With this arm the helper is typed `:vector-i64` and the program
        ;; runs. `(vector-at [1 4 2] 0)` written by hand always worked, which
        ;; is how the difference was isolated: identical bodies, different
        ;; `:param-types`.
        count
        (let [value-type (when (= 1 (count args))
                           (infer-expression-type (first args) locals signatures))]
          (if (or (= :vector-i64 value-type) (= :vector-f64 value-type)
                  (heterogeneous-vector-type? value-type)
                  (typed-set-type? value-type)
                  (canonical-typed-map-type? value-type)
                  (canonical-list-type? value-type))
            :i64
            (infer-call-type op args locals signatures)))
        ;; `peek`/`pop`/`keys`/`vals` need a type here for the same reason
        ;; `count` and `nth` do: `infer-absent-parameter-types` runs BEFORE
        ;; `rewrite-record-projections` and reads a refused operand's required
        ;; type out of the refusal's ex-data, so a head with only a rewrite is
        ;; still refused during that earlier pass and its expected type is
        ;; attributed to an unrelated synthesized parameter.
        (peek pop)
        (let [value-type (when (= 1 (count args))
                           (infer-expression-type (first args) locals signatures))]
          (case [op value-type]
            [peek :vector-i64] :i64
            [peek :vector-f64] :f64
            [pop :vector-i64] :vector-i64
            [pop :vector-f64] :vector-f64
            (infer-call-type op args locals signatures)))
        (keys vals)
        (let [value-type (when (= 1 (count args))
                           (infer-expression-type (first args) locals signatures))]
          (cond
            (canonical-typed-map-type? value-type)
            [:list (if (= op 'keys) (second value-type) (nth value-type 2))]
            ;; a document map's keys / values are a document vector
            (= :document value-type) :document
            :else (infer-call-type op args locals signatures)))
        (pair-first pair-second)
        (let [value-type (when (= 1 (count args))
                           (infer-expression-type (first args) locals signatures))]
          (if (and (= op 'pair-first) (canonical-list-type? value-type))
            ;; ADR 0353 floor :record-list-sequence: the first item of a
            ;; [:list T], absent on an empty list.
            [:option (second value-type)]
            (case [op value-type]
              [pair-first :vector-i64] :i64
              [pair-first :vector-f64] :f64
              [pair-second :vector-i64] :vector-i64
              [pair-second :vector-f64] :vector-f64
              ;; first / rest of a document are documents
              [pair-first :document] :document
              [pair-second :document] :document
              (infer-call-type op args locals signatures))))
        ;; ADR 0353 floor :record-list-sequence: the two exits of a fused
        ;; `(first (filter p (reverse s)))` search (`desugar-sequence-first`),
        ;; typed by the sequence searched -- see `sequence-first-exit-type`.
        (__kotoba_seq_found __kotoba_seq_absent)
        (sequence-first-exit-type op args locals signatures)
        nth
        (let [[value index & defaults] args
              value-type (infer-expression-type value locals signatures)]
          (cond
            (and (= :document value-type) (= 2 (count args))) :document

            (heterogeneous-vector-type? value-type)
            (do
              (when-not (<= 2 (count args) 3)
                (reject! "heterogeneous vector nth requires a value, one literal index, and an optional default"
                         form :kotoba.error/hetero-vector-index))
              (let [host-index
                    (heterogeneous-vector-index! index (second value-type) form)
                    item-type (nth (second value-type) host-index)]
                (when (= 3 (count args))
                  (let [default (first defaults)]
                    (require-expression-type!
                     (infer-expression-type default locals signatures)
                     item-type default)))
                item-type))

            (= :vector-i64 value-type)
            (do
              (when-not (<= 2 (count args) 3)
                (reject! "vector nth requires value, index, and optional default" form))
              (infer-call-type (if (= 3 (count args)) 'vector-get 'vector-at)
                               args locals signatures))

            (= :vector-f64 value-type)
            (do
              (when-not (<= 2 (count args) 3)
                (reject! "vector nth requires value, index, and optional default" form))
              (infer-call-type (if (= 3 (count args)) 'vector-f64-get 'vector-f64-at)
                               args locals signatures))

            ;; A `[:list T]` indexes through `typed-list-nth`, which has no
            ;; defaulting form -- there is no list `vector-get` -- so the
            ;; two-argument shape is the only one, and the three-argument one
            ;; is refused by the rewrite rather than silently dropping the
            ;; default.
            (canonical-list-type? value-type)
            (if (= 2 (count args)) (second value-type)
                (infer-call-type op args locals signatures))

            :else (infer-call-type op args locals signatures)))
        hetero-vector-assoc
        (let [[type value index item] args
              item-types (second type)
              host-index (heterogeneous-vector-index! index item-types form)]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (require-expression-type! (infer-expression-type item locals signatures)
                                    (nth item-types host-index) item)
          type)
        hetero-vector-equal
        (let [[type left right] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type left locals signatures) type left)
          (require-expression-type! (infer-expression-type right locals signatures) type right)
          :i64)
        typed-set-new
        (let [[type & items] args]
          (validate-value-type! type)
          (doseq [item items]
            (require-set-item-type! type item locals signatures))
          type)
        typed-set-count
        (let [[type value] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          :i64)
        typed-set-contains
        (let [[type value item] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (require-set-item-type! type item locals signatures)
          :bool)
        typed-set-conj
        (let [[type value item] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (require-set-item-type! type item locals signatures)
          type)
        typed-set-disj
        (let [[type value item] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (require-set-item-type! type item locals signatures)
          type)
        typed-set-equal
        (let [[type left right] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type left locals signatures) type left)
          (require-expression-type! (infer-expression-type right locals signatures) type right)
          :i64)
        typed-set-nth
        (let [[type value index] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (require-expression-type! (infer-expression-type index locals signatures) :i64 index)
          (second type))
        typed-map-new
        (let [[type & entries] args
              [key-type value-type] (rest type)]
          (validate-value-type! type)
          (doseq [[key item] (partition 2 entries)]
            (require-expression-type! (infer-expression-type key locals signatures)
                                      key-type key)
            (require-expression-type! (infer-expression-type item locals signatures)
                                      value-type item))
          type)
        typed-map-count
        (let [[type value] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          :i64)
        typed-map-contains
        (let [[type value key] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (require-expression-type! (infer-expression-type key locals signatures)
                                    (second type) key)
          :bool)
        typed-map-get
        (let [[type value key] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (require-expression-type! (infer-expression-type key locals signatures)
                                    (second type) key)
          [:option (nth type 2)])
        typed-map-entry-at
        (let [[type value index] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (require-expression-type! (infer-expression-type index locals signatures) :i64 index)
          [:option [:vector [(second type) (nth type 2)]]])
        ;; `[:list K]` / `[:list V]`. Not `[:set K]` even for the keys, whose
        ;; distinctness a set would carry faithfully: the VALUES are not
        ;; distinct, so the same carrier for `vals` would silently drop every
        ;; repeated value, and one projection typed as a set while the other
        ;; is a list would make `(nth (keys m) i)` and `(nth (vals m) i)` two
        ;; different kinds of index over what is meant to be one entry.
        (typed-map-keys typed-map-vals)
        (let [[type value] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          [:list (if (= op 'typed-map-keys) (second type) (nth type 2))])
        typed-map-assoc
        (let [[type value key item] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (require-expression-type! (infer-expression-type key locals signatures)
                                    (second type) key)
          (require-expression-type! (infer-expression-type item locals signatures)
                                    (nth type 2) item)
          type)
        typed-map-dissoc
        (let [[type value key] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (require-expression-type! (infer-expression-type key locals signatures)
                                    (second type) key)
          type)
        typed-map-equal
        (let [[type left right] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type left locals signatures) type left)
          (require-expression-type! (infer-expression-type right locals signatures) type right)
          :i64)
        record-new
        (let [[type & values] args
              fields (nth type 2)]
          (validate-value-type! type)
          (doseq [[[field field-type] item] (map vector fields values)]
            (require-field-value-type! (infer-expression-type item locals signatures)
                                       field-type item field))
          type)
        record-get
        (let [[type value field] (if (= 2 (count args))
                                   ;; The descriptor-less spelling reaches the
                                   ;; abort passes (they run before
                                   ;; `rewrite-record-projections`); the value's
                                   ;; own type is the descriptor.
                                   (let [value-type (infer-expression-type (first args) locals signatures)]
                                     (when-not (record-type? value-type)
                                       (reject! (str "record-get without a type descriptor requires a record "
                                                     "value; got " (pr-str value-type))
                                                form))
                                     [value-type (first args) (second args)])
                                   args)
              field-type (first-truthy (fn [[declared-field declared-type]]
                                 (when (= declared-field field) declared-type))
                               (nth type 2))]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          ;; a `[:fn ...]` field is read as the closure handle it holds; the
          ;; closure analysis (`infer-closure-refinements`) knows it is one
          (if (callable-type? field-type) :i64 field-type))
        record-assoc
        (let [[type value field replacement] args
              field-type (first-truthy (fn [[declared-field declared-type]]
                                 (when (= declared-field field) declared-type))
                               (nth type 2))]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type value locals signatures) type value)
          (require-field-value-type! (infer-expression-type replacement locals signatures)
                                     field-type replacement replacement)
          type)
        record-equal
        (let [[type left right] args]
          (validate-value-type! type)
          (require-expression-type! (infer-expression-type left locals signatures) type left)
          (require-expression-type! (infer-expression-type right locals signatures) type right)
          :i64)
        ;; boot-scratch: an address is an i64, and its argument is a function
        ;; NAME. Intercepted here rather than in `infer-call-type`, which
        ;; types every argument before it looks at the head -- a symbol there
        ;; is a local reference, so a correct program would be rejected as
        ;; "unbound symbol has no value type" naming the callee.
        kernel-function-address :i64
        (infer-call-type op args locals signatures)))
    :else (reject! "value has no admitted type" form))))

#?(:kotoba nil :default (defn elaborate-named-ability
  "Lower a friendly qualified operation such as `(http/post request)` after
  parameter and result types are known. Request type comes from the lexical
  expression and result type from the typed context; neither is repeated in
  application source. A call without result context fails closed until the
  semantic catalog owns a context-independent result schema."
  [form expected locals signatures used]
  (if-not (seq? form)
    form
    (let [[op & args] form]
      (cond
        (contains? source-operation-registry op)
        (do
          (when-not (= 1 (count args))
            (reject! "named capability operation requires exactly one request" form))
          (when-not (or expected (contains? named-operation-default-results op))
            (reject! "named capability operation requires a typed result context" form))
          (let [expected (or expected (get named-operation-default-results op))
                request (elaborate-named-ability
                         (first args) nil locals signatures used)
                request-type (infer-expression-type request locals signatures)
                capability (get source-operation-registry op)
                id (effect-capability-id
                    (capability-wire-id capability form))]
            (vswap! used conj capability)
            (preserve-form-meta
             form
             (list 'typed-cap-call id request-type expected request))))

        (= op 'let)
        (let [bindings (first args) body (let-body args form)]
          (loop [pairs (partition 2 bindings)
                 current locals
                 out []]
            (if-let [[name value] (first pairs)]
              (let [elaborated
                    (elaborate-named-ability value nil current signatures used)
                    value-type
                    (infer-expression-type elaborated current signatures)]
                (recur (next pairs)
                       (assoc current name value-type)
                       (conj out name elaborated)))
              (preserve-form-meta
               form
               (list 'let (vec out)
                     (elaborate-named-ability
                      body expected current signatures used))))))

        (= op 'if)
        (let [[test then else] (if-parts args form)]
          (preserve-form-meta
           form
           (list 'if
                 (elaborate-named-ability test nil locals signatures used)
                 (elaborate-named-ability then expected locals signatures used)
                 (elaborate-named-ability else expected locals signatures used))))

        (= op 'do)
        (let [last-index (dec (count args))]
          (preserve-form-meta
           form
           (list* 'do
                  (map-indexed
                   (fn [index expression]
                     (elaborate-named-ability
                      expression (when (= index last-index) expected)
                      locals signatures used))
                   args))))

        ;; Lowered pattern forms bind payload names in only their branch
        ;; bodies. Preserve those lexical types while elaborating named
        ;; abilities; generic recursion would otherwise treat the binder as
        ;; unbound when a branch contains any expression whose expected type
        ;; must be inferred (including the `option-value-of` produced from
        ;; `option-or`).
        (= op 'option-match)
        (let [[type value none-body some-name some-body] args]
          (preserve-form-meta
           form
           (list 'option-match type
                 (elaborate-named-ability value type locals signatures used)
                 (elaborate-named-ability none-body expected locals signatures used)
                 some-name
                 (elaborate-named-ability some-body expected
                                          (assoc locals some-name (second type))
                                          signatures used))))

        (= op 'result-match-of)
        (let [[type value ok-name ok-body err-name err-body] args]
          (preserve-form-meta
           form
           (list 'result-match-of type
                 (elaborate-named-ability value type locals signatures used)
                 ok-name
                 (elaborate-named-ability ok-body expected
                                          (assoc locals ok-name (second type))
                                          signatures used)
                 err-name
                 (elaborate-named-ability err-body expected
                                          (assoc locals err-name (nth type 2))
                                          signatures used))))

        (= op 'variant-match)
        (let [[type value branches] args
              payloads (into {} (nth type 2))]
          (preserve-form-meta
           form
           (list 'variant-match type
                 (elaborate-named-ability value type locals signatures used)
                 (mapv (fn [[tag binder body]]
                         [tag binder
                          (elaborate-named-ability body expected
                                                   (assoc locals binder (get payloads tag))
                                                   signatures used)])
                       branches))))

        (= op 'typed-cap-call)
        (let [[id request-type result-type request] args]
          (preserve-form-meta
           form
           (list 'typed-cap-call id request-type result-type
                 (elaborate-named-ability
                  request request-type locals signatures used))))

        ;; The measured hole (2026-09-02). This walked arguments with
        ;; `(map f args expected-arg-types)`, and two-collection `map` stops at
        ;; the SHORTER collection: a call carrying more arguments than the
        ;; callee has parameters came out of this branch SHORTER than it went
        ;; in, and `validate-expr`'s own arity check -- which is correct --
        ;; then measured the shortened form and passed it. `(two 1 2 3)`
        ;; against `(defn- two [a b] ...)` compiled with :ok true and answered
        ;; 3. Same shape as the `let` body and `if` truncations closed the same
        ;; day: a pass rebuilds a form from a destructuring that cannot express
        ;; the surplus, so nothing downstream can see what was dropped.
        ;;
        ;; The count is now checked here, where the fact is known, and the walk
        ;; is indexed rather than zipped so no future disagreement between
        ;; `:params` and `:param-types` can shorten a form again.
        (contains? signatures op)
        (let [{:keys [params param-types]} (get signatures op)
              expected (count params)]
          (when-not (= (count args) expected)
            (reject-call-arity! op expected (count args) form))
          (preserve-form-meta
           form
           (list* op
                  (map-indexed
                   (fn [index argument]
                     (elaborate-named-ability
                      argument (nth param-types index nil) locals signatures used))
                   args))))

        :else
        (preserve-form-meta
         form
         (list* op
                (map #(elaborate-named-ability
                       % nil locals signatures used)
                     args))))))))

#?(:kotoba nil :default (defn elaborate-named-abilities [functions]
  (let [signatures
        (into {} (map (fn [{:keys [name params param-types result]}]
                        [name {:params params
                               :param-types param-types
                               :result result}]))
              functions)
        used (volatile! #{})]
    {:functions
     (mapv (fn [{:keys [params param-types result] :as function}]
             (update function :body
                     #(elaborate-named-ability
                       % result (zipmap params param-types) signatures used)))
           functions)
     :used @used})))

;; ── loop/recur accumulator types (ADR 0027) ─────────────────────────────────
;;
;; A synthesized loop-helper's RESULT was a constant with exactly two possible
;; values: `:i64`, or `:vector-i64` when the T4.5 map/filter desugarings bound
;; `*loop-result-type*`. Nothing read the loop body. So an ordinary
;; Clojure-shaped loop over anything but an integer was refused --
;;
;;   (loop [i 0 acc 0.0] (if (< i 3) (recur (+ i 1) (f64-add acc x)) acc))
;;
;; -- with "expression type mismatch: expected f64, got i64" pointing at the
;; loop's own call site, even though the accumulator's type WAS known:
;; `resolve-loop-helper-param-types` above recovers it from the loop's inits.
;; Only the result type did not read it.
;;
;; It is read here. A loop leaves through its non-`recur` tail exits, so the
;; helper's result is the type those exits agree on. After `replace-recur` a
;; `recur` is a self-call, so "not a recur" is "not a call to this helper".

#?(:kotoba nil :default (def loop-recur-marker
  "The symbol a self-call stands in as while a loop-helper's exits are typed.
  A self-call in TAIL position is a `recur` and is not an exit, so the walker
  drops it; one anywhere else (inside a `variant-match` branch, say) is typed
  from this symbol's binding in `locals`, which is the result type the fixed
  point currently believes -- so such a loop keeps exactly the meaning it had
  before this pass existed."
  '__kotoba_recur_position__))

#?(:kotoba nil :default (defn replace-loop-self-calls
  "BODY with every call to HELPER-NAME replaced by `loop-recur-marker`."
  [form helper-name]
  (cond
    (and (seq? form) (= helper-name (first form))) loop-recur-marker
    (seq? form) (with-meta (apply list (map #(replace-loop-self-calls % helper-name) form))
                  (meta form))
    (vector? form) (mapv #(replace-loop-self-calls % helper-name) form)
    :else form)))

#?(:kotoba nil :default (defn loop-exit-forms
  "The tail exits of a marked loop-helper body, as `[form locals]` pairs.

  `if`, `do` and `let` are tail-transparent -- `let` is the only binding form
  that survives desugaring, so threading it is threading all of them -- and a
  marker in tail position is a `recur`, which leaves the loop's next iteration
  rather than the loop. Everything else is a leaf and is typed whole."
  [form locals signatures]
  (cond
    (= form loop-recur-marker) []

    (seq? form)
    (let [[op & args] form]
      (cond
        (and (= op 'if) (= 3 (count args)))
        (into (loop-exit-forms (second args) locals signatures)
              (loop-exit-forms (nth args 2) locals signatures))

        (and (= op 'do) (seq args))
        (loop-exit-forms (last args) locals signatures)

        (and (= op 'let) (vector? (first args)) (= 2 (count args))
             (even? (count (first args))))
        (loop-exit-forms (second args)
                         (reduce (fn [current [name value]]
                                   (assoc current name
                                          (infer-expression-type value current signatures)))
                                 locals
                                 (partition 2 (first args)))
                         signatures)

        :else [[form locals]]))

    :else [[form locals]])))

#?(:kotoba nil :default (defn loop-type-text [type] (if (keyword? type) (name type) (pr-str type))))

#?(:kotoba nil :default (defn loop-exit-text
  "A tail exit named short enough to read in a one-line refusal."
  [form]
  (let [text (pr-str form)]
    (if (> (count text) 48) (str (subs text 0 45) "...") text))))

#?(:kotoba nil :default (defn loop-helper-exit-type
  "The type a loop-helper leaves through, or nil when nothing here can say.

  Iterated to a fixed point over the marker's own binding, so a loop whose only
  self-call is in tail position (every loop this pass is for) settles in one
  round, and one with a self-call in a non-tail position starts from the result
  it had before and stays there."
  [{:keys [name params param-types body]} signatures]
  (let [marked (replace-loop-self-calls body name)
        environment (zipmap params param-types)]
    (loop [provisional :i64 rounds 0]
      (let [locals (assoc environment loop-recur-marker provisional)
            typed (into []
                        (comp (map (fn [[form form-locals]]
                                     [form (infer-expression-type form form-locals signatures)]))
                              (remove #(= abort-bottom (second %))))
                        (loop-exit-forms marked locals signatures))
            ;; Gap 1 (`absence-type`): an exit that answers nothing -- a
            ;; `when` with no else, a literal nil -- is not a value to agree
            ;; with. The others agree among themselves (a value of T beside
            ;; the loop's own [:option T] is its present answer), and the
            ;; absence decides the loop's type from theirs.
            absent (filter #(absence-kind? (second %)) typed)
            typed (if (seq absent) (vec (remove #(absence-kind? (second %)) typed)) typed)
            present-type (when (seq absent)
                           (reduce (fn [joined [_ type]]
                                     (cond (nil? joined) type
                                           (same-expression-type? type joined) joined
                                           :else (or (lenient-branch-join joined type) joined)))
                                   nil typed))
            first-type (if (seq absent)
                         (absence-type present-type
                                       (let [kinds (set (map second absent))]
                                         (cond (contains? kinds nil-kind) :nil
                                               (contains? kinds none-kind) :none
                                               :else :legacy)))
                         (second (first typed)))
            disagreeing (first (remove #(or (same-expression-type? (second %) first-type)
                                            (and (seq absent)
                                                 (or (= [:option (second %)] first-type)
                                                     (and (option-vector-type? first-type)
                                                          (= (second first-type) (second %))))))
                                       typed))]
        (cond
          ;; Every tail is a `recur`: the loop has no exit to read a type from.
          (and (empty? typed) (empty? absent)) nil

          disagreeing
          (reject! (str "loop exits with two different value types: "
                        (loop-type-text first-type) " from " (loop-exit-text (first (first typed)))
                        " and " (loop-type-text (second disagreeing))
                        " from " (loop-exit-text (first disagreeing)))
                   (first disagreeing)
                   :kotoba.error/loop-exit-type
                   {:kotoba.error/expected first-type
                    :kotoba.error/actual (second disagreeing)})

          (or (= first-type provisional) (>= rounds 4)) first-type
          :else (recur first-type (inc rounds))))))))

#?(:kotoba nil :default (defn loop-helper-result
  "The result type for one loop-helper, refusing a type that cannot be one.

  Every rejection this raises other than its own two is swallowed: a loop body
  with an independent type error must fail where every other body does, in
  `check-value-types!`, with that error's own message -- not as an unreadable
  consequence of typing its exits."
  [helper declared-result signatures]
  (let [own-codes #{:kotoba.error/loop-exit-type :kotoba.error/loop-result-type}
        inferred (try (binding [*lenient-branch-joins?* true]
                        (loop-helper-exit-type helper signatures))
                      (catch #?(:clj Exception :cljs :default) e
                        (if (contains? own-codes (:kotoba.error/code (ex-data e)))
                          (throw e)
                          ::unknown)))]
    (cond
      (= ::unknown inferred) (:result helper)
      (nil? inferred) (:result helper)
      :else
      (do
        ;; A loop is lowered to a real function, so its accumulator has to be a
        ;; value that can be a function RESULT. Name the type and say so rather
        ;; than quietly handing back :i64 -- a silent fallback here is the
        ;; defect this pass exists to remove.
        (try (validate-value-type! inferred)
             (catch #?(:clj Exception :cljs :default) _
               (reject! (str "a loop is lowered to a function and its exits have the type "
                             (loop-type-text inferred)
                             ", which cannot cross a function boundary in this profile")
                        (:body helper) :kotoba.error/loop-result-type
                        {:kotoba.error/actual inferred})))
        (when (and (some? declared-result)
                   (not (same-expression-type? inferred declared-result)))
          (reject! (str "loop result was declared " (loop-type-text declared-result)
                        " and its exits have the type " (loop-type-text inferred))
                   (:body helper) :kotoba.error/loop-result-type
                   {:kotoba.error/expected declared-result
                    :kotoba.error/actual inferred}))
        inferred)))))

#?(:kotoba nil :default (defn loop-helper-signatures [functions]
  (into {} (map (fn [{:keys [name params param-types result]}]
                  [name {:params params :param-types param-types :result (or result :i64)}]))
        functions)))

#?(:kotoba nil :default (defn infer-loop-helper-results
  "Give every synthesized loop-helper the result type its exits have.

  Runs AFTER `resolve-loop-helper-param-types` (the exits are typed in the
  helper's own parameter environment) and to a fixed point, because a nested
  loop's helper is called from the enclosing loop's body: the inner result has
  to settle before the outer body can be read. The rounds up to the last are
  permissive -- an intermediate disagreement is usually a placeholder that has
  not settled yet -- and the last one refuses."
  [functions shapes]
  (if-not (first-truthy :loop-helper? functions)
    functions
    (letfn [(result-of [f fs]
              (loop-helper-result f (:declared-result (get shapes (:name f)))
                                  (loop-helper-signatures fs)))
            (round [fs strict?]
              (mapv (fn [f]
                      (if (:loop-helper? f)
                        (assoc f :result
                               (if strict?
                                 (result-of f fs)
                                 (try (result-of f fs)
                                      (catch #?(:clj Exception :cljs :default) _ (:result f)))))
                        f))
                    fs))]
      (loop [fs functions rounds 0]
        (let [next-fs (round fs false)]
          (if (or (= (mapv :result next-fs) (mapv :result fs)) (>= rounds 4))
            (round next-fs true)
            (recur next-fs (inc rounds)))))))))

#?(:kotoba nil :default (defn check-loop-recur-argument-types!
  "A `recur` argument must have the type of the binding it rebinds.

  `check-value-types!` would catch this too -- a `recur` is a self-call and its
  arguments are checked against the helper's parameter types -- but it would
  report it as a mismatch in a call to `__kotoba_loop_3`, a function the author
  never wrote, at a parameter index they cannot map back to a name. Say which
  loop binding, at which `recur` argument position, instead.

  Every inference here is best-effort: an argument whose type cannot be read
  (because the body has an independent error) is left for `check-value-types!`
  rather than guessed at."
  [functions shapes]
  (let [signatures (loop-helper-signatures functions)]
    (letfn [(infer [form locals]
              (try (infer-expression-type form locals signatures)
                   (catch #?(:clj Exception :cljs :default) _ ::unknown)))
            (walk [helper-name binding-names param-types form locals]
              (when (seq? form)
                (let [[op & args] form]
                  (cond
                    (= op helper-name)
                    (do (doseq [[index argument] (map-indexed vector
                                                              (take (count binding-names) args))]
                          (let [expected (nth param-types index)
                                actual (infer argument locals)]
                            (when-not (or (= ::unknown actual)
                                          (= abort-bottom actual)
                                          (same-expression-type? actual expected))
                              (reject! (str "recur argument " (inc index) " rebinds the loop binding `"
                                            (nth binding-names index) "`, which is "
                                            (loop-type-text expected) ", with an expression of type "
                                            (loop-type-text actual))
                                       argument :kotoba.error/loop-recur-type
                                       {:kotoba.error/expected expected
                                        :kotoba.error/actual actual
                                        :kotoba.error/loop-binding (nth binding-names index)
                                        :kotoba.error/loop-recur-argument (inc index)}))))
                        (doseq [argument args]
                          (walk helper-name binding-names param-types argument locals)))

                    (and (= op 'let) (vector? (first args)) (= 2 (count args))
                         (even? (count (first args))))
                    (let [pairs (partition 2 (first args))]
                      (doseq [[_ value] pairs]
                        (walk helper-name binding-names param-types value locals))
                      (walk helper-name binding-names param-types (second args)
                            (reduce (fn [current [name value]]
                                      (assoc current name (infer value current)))
                                    locals pairs)))

                    :else (doseq [argument args]
                            (walk helper-name binding-names param-types argument locals))))))]
      (doseq [{:keys [name params param-types body loop-helper?]} functions
              :let [bindings (:bindings (get shapes name))]
              :when (and loop-helper? (pos? (or bindings 0)))]
        (walk name (vec (take bindings params)) (vec param-types) body
              (zipmap params param-types)))))
  functions))


#?(:kotoba nil
   :default
   (do
;; ── Kotoba route: the absence and abort passes (ported from the host forms below) ──
;; The host passes read dynamic vars and take lists of function maps; here the inference context is an
;; explicit `:ie/ctx` first argument and a function is a Form map
;; {:name :source-name :params :param-types :result :body :result-inferred? :param-types-inferred
;;  :loop-helper? :lazy-thunk? ...} (docs/selfhost-frontend-typemodel-design.md section 9).

#?(:kotoba
(defn empty-fmap [] [:ref :form/r]
  (form/form-map (form/no-forms)))
   :default nil)

;; the type of FORM, or nil when its inference refuses (the host swallows the refusal the same way)
#?(:kotoba
(defn infer-type-or-nil [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (try (ie-type (ie-infer ctx form locals sigs))
       (catch [:ref :fe/err] e (form/nil-form))))
   :default nil)

;; `(zipmap params types)` as a Form map
#?(:kotoba
(defn zip-locals-from [params [:ref :form/r] ptypes [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (or (>= i (form/count-of params)) (>= i (form/count-of ptypes)))
    acc
    (zip-locals-from params ptypes (+ i 1) (form/assoc-form acc (form/nth-of params i) (form/nth-of ptypes i)))))
   :default nil)

#?(:kotoba
(defn zip-locals [params [:ref :form/r] ptypes [:ref :form/r]] [:ref :form/r]
  (zip-locals-from params ptypes 0 (empty-fmap)))
   :default nil)

;; FORM with its last kid replaced
#?(:kotoba
(defn form-with-last [form [:ref :form/r] new-last [:ref :form/r]] [:ref :form/r]
  (preserve-form-meta form
    (form/form-seq (form/append-form (fl-slice (form/kids-of form) 0 (- (form/count-of form) 1) (form/no-forms)) new-last))))
   :default nil)

#?(:kotoba
(defn absence-let-locals [ctx [:ref :ie/ctx] bindings [:ref :form/r] i :i64 locals [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (if (>= (+ i 1) (form/count-of bindings))
    locals
    (absence-let-locals ctx bindings (+ i 2)
                        (form/assoc-form locals (form/nth-of bindings i)
                                         (infer-type-or-nil ctx (form/nth-of bindings (+ i 1)) locals sigs))
                        sigs)))
   :default nil)

#?(:kotoba
(defn absence-none [marker [:ref :form/r] type [:ref :form/r]] [:ref :form/r]
  (cond
    (ty? type :i64) (form/int-form 0)
    (ty? type :bool) (form/bool-form false)
    (ty? type :option-i64) (form/call0 "option-none")
    (option-vector-type? type) (form/call1 "option-none-of" type)
    :else (legacy-absence marker)))
   :default nil)

#?(:kotoba
(defn absence-leaves [ctx [:ref :ie/ctx] form [:ref :form/r] type [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (cond
    (absence-marker? form) (absence-none form type)
    (and (form/is-seq? form) (sym-is? (form/nth-of form 0) "if") (= 4 (form/count-of form)))
    (preserve-form-meta form
      (form/call3 "if" (form/nth-of form 1)
                  (absence-leaves ctx (form/nth-of form 2) type locals sigs)
                  (absence-leaves ctx (form/nth-of form 3) type locals sigs)))
    (and (form/is-seq? form) (sym-is? (form/nth-of form 0) "let") (= 3 (form/count-of form)) (form/is-vec? (form/nth-of form 1)))
    (preserve-form-meta form
      (form/call2 "let" (form/nth-of form 1)
                  (absence-leaves ctx (form/nth-of form 2) type
                                  (absence-let-locals ctx (form/nth-of form 1) 0 locals sigs) sigs)))
    (and (form/is-seq? form) (sym-is? (form/nth-of form 0) "do") (<= 2 (form/count-of form)))
    (form-with-last form (absence-leaves ctx (form/last-of form) type locals sigs))
    (and (option-vector-type? type) (not (option-vector-type? (form/nth-of type 1))))
    (let [leaf-type (infer-type-or-nil ctx form locals sigs)]
      (if (and (not (form/is-nil? leaf-type)) (same-expression-type? leaf-type (form/nth-of type 1)))
        (form/call2 "option-some-of" type form)
        form))
    :else form))
   :default nil)

#?(:kotoba
(defn absence-tails-legacy [form [:ref :form/r]] [:ref :form/r]
  (cond
    (absence-marker? form) (legacy-absence form)
    (and (form/is-seq? form) (sym-is? (form/nth-of form 0) "if") (= 4 (form/count-of form)))
    (preserve-form-meta form
      (form/call3 "if" (form/nth-of form 1)
                  (absence-tails-legacy (form/nth-of form 2))
                  (absence-tails-legacy (form/nth-of form 3))))
    (and (form/is-seq? form) (or (sym-is? (form/nth-of form 0) "let") (sym-is? (form/nth-of form 0) "do")) (<= 2 (form/count-of form)))
    (form-with-last form (absence-tails-legacy (form/last-of form)))
    :else form))
   :default nil)

;; `[:option :i64]`, the legacy statement type
#?(:kotoba
(defn legacy-option-type? [type [:ref :form/r]] :bool
  (or (ty? type :i64) (form/eq type (form/vec2 (tk :option) (tk :i64)))))
   :default nil)

;; abort passes: signatures, texts, and the function-map accessors
#?(:kotoba
(defn fn-signature [f [:ref :form/r]] [:ref :form/r]
  (fput (fput (fput (fput (empty-fmap) :params (fget f :params)) :param-types (fget f :param-types)) :result (fget f :result)) :param-types-inferred (fget f :param-types-inferred)))
   :default nil)

#?(:kotoba
(defn abort-signatures-from [fs [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of fs))
    acc
    (abort-signatures-from fs (+ i 1)
                           (form/assoc-form acc (fget (form/nth-of fs i) :name) (fn-signature (form/nth-of fs i))))))
   :default nil)

#?(:kotoba
(defn any-body-mentions-abort? [fs [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of fs))
    false
    (if (abort-form-mentions? (fget (form/nth-of fs i) :body))
      true
      (any-body-mentions-abort? fs (+ i 1)))))
   :default nil)

#?(:kotoba
(defn first-aborting-call-in [form [:ref :form/r] known [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of form))
    (form/nil-form)
    (let [r (first-aborting-call (form/nth-of form i) known)]
      (if (form/is-nil? r)
        (first-aborting-call-in form known (+ i 1))
        r))))
   :default nil)

#?(:kotoba
(defn first-aborting-call [form [:ref :form/r] known [:ref :form/r]] [:ref :form/r]
  (if (and (form/is-seq? form) (> (form/count-of form) 0) (form/form-has? known (form/nth-of form 0)))
    (form/nth-of form 0)
    (first-aborting-call-in form known 0)))
   :default nil)

#?(:kotoba
(defn abort-type-text [type [:ref :form/r]] :string
  (type-text type))
   :default nil)

#?(:kotoba
(defn abort-signatures [functions [:ref :form/r]] [:ref :form/r]
  (abort-signatures-from functions 0 (empty-fmap)))
   :default nil)

;; the lexical context a SYNTHESIZED function came from, "" when the author wrote it (or a loop body)
#?(:kotoba
(defn abort-synthesized-context [f [:ref :form/r]] :string
  (cond
    (ftruthy? (fget f :source-name)) ""
    (ftruthy? (fget f :loop-helper?)) ""
    (ftruthy? (fget f :lazy-thunk?)) "a lazy thunk"
    :else "a fn literal"))
   :default nil)

#?(:kotoba
(defn refinable-value-type? [type [:ref :form/r]] :bool
  (if (or (form/is-nil? type) (ty? type :i64))
    false
    (try (let [_ (validate-value-type! type)] true)
         (catch [:ref :fe/err] e false))))
   :default nil)

#?(:kotoba
(defn resolve-absence-if [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] statement? :bool] [:ref :form/r]
  (if (not (and (form/is-seq? form) (sym-is? (form/nth-of form 0) "if") (= 4 (form/count-of form))
                (or (absence-in-tail? (form/nth-of form 2)) (absence-in-tail? (form/nth-of form 3)))))
    form
    (let [type (infer-type-or-nil ctx form locals sigs)]
      (cond
        (or (form/is-nil? type) (absence-kind? type) (form/eq type (abort-bottom-form))) form
        (and statement? (legacy-option-type? type)) (absence-tails-legacy form)
        :else (absence-leaves ctx form type locals sigs)))))
   :default nil)

;; ── result inference ─────────────────────────────────────────────────────────

#?(:kotoba (defn ptfu-param-index "Index of the parameter symbol X in PARAMS, else -1." (x [:ref :form/r] params [:ref :form/r] i :i64) :i64 (if (>= i (form/count-of params)) -1 (if (form/eq x (form/nth-of params i)) i (ptfu-param-index x params (+ i 1))))) :default nil)

#?(:kotoba (defn ptfu-scan "Walk the body forms; accumulate param -> callee param type into ACC." (x [:ref :form/r] params [:ref :form/r] table [:ref :form/r] acc [:ref :form/r]) [:ref :form/r] (if (form/is-seq? x) (let (op (form/nth-of x 0) k (form/count-of x) sig (let [g1 (form/form-get table op)] (if (form/is-nil? g1) (form/form-get table (form/string-form (form/symbol-value op))) g1)) pts (if (form/is-nil? sig) (form/nil-form) (fget sig :param-types)) acc2 (if (form/is-nil? pts) acc (loop (j 1 acc acc) (if (>= j k) acc (recur (+ j 1) (let (a (form/nth-of x j)) (if (and (form/is-symbol? a) (< (- j 1) (form/count-of pts)) (not (ftruthy? (form/form-get acc a)))) (if (< (ptfu-param-index a params 0) 0) acc (form/assoc-form acc a (form/nth-of pts (- j 1)))) acc))))))) (loop (t 1 acc acc2) (if (>= t k) acc (recur (+ t 1) (ptfu-scan (form/nth-of x t) params table acc))))) (if (form/is-vec? x) (loop (u 0 acc acc) (if (>= u (form/count-of x)) acc (recur (+ u 1) (ptfu-scan (form/nth-of x u) params table acc)))) acc))) :default nil)

#?(:kotoba (defn param-types-from-uses-form "Rebuild the param-types form with each parameter type from its first use as a call argument." (body [:ref :form/r] params [:ref :form/r] param-types [:ref :form/r] table [:ref :form/r]) [:ref :form/r] (let (found (ptfu-scan body params table (form/no-forms)) n (form/count-of params)) (loop (i 0 acc (form/no-forms)) (if (>= i n) acc (recur (+ i 1) (form/append-form acc (let (got (form/form-get found (form/nth-of params i))) (if (form/is-nil? got) (form/nth-of param-types i) got)))))))) :default nil)

#?(:kotoba
(defn absent-results-pass-from [ctx [:ref :ie/ctx] fs [:ref :form/r] table [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of fs))
    (form/form-vec acc)
    (let [f (form/nth-of fs i)
          g (if (ftruthy? (fget f :result-inferred?))
              (let [inferred (infer-type-or-nil ctx (fget f :body) (zip-locals (fget f :params) (fget f :param-types)) table)]
                (if (or (form/is-nil? inferred) (ty? inferred :i64))
                  (let [inferred2 (infer-type-or-nil ctx (fget f :body) (zip-locals (fget f :params) (param-types-from-uses-form (fget f :body) (fget f :params) (fget f :param-types) table)) table)]
                    (if (form/is-nil? inferred2) f (fput f :result inferred2)))
                  (fput f :result inferred)))
              f)]
      (absent-results-pass-from ctx fs table (+ i 1) (form/append-form acc g)))))
   :default nil)

#?(:kotoba
(defn infer-absent-results [ctx [:ref :ie/ctx] functions [:ref :form/r]] [:ref :form/r]
  (let [one (absent-results-pass-from ctx functions (abort-signatures functions) 0 (form/no-forms))]
    (absent-results-pass-from ctx one (abort-signatures one) 0 (form/no-forms))))
   :default nil)

;; ── parameter types ──────────────────────────────────────────────────────────

#?(:kotoba
(defn pu-span-form [span :i64] [:ref :form/r]
  (fput (fput (empty-fmap) :line (form/int-form (quot span 4294967296))) :column (form/int-form (rem span 4294967296))))
   :default nil)

#?(:kotoba
(defn pu-use-text [parameter [:ref :form/r] use [:ref :form/r]] :string
  (let [site (fget use :use-site)
        span (form/int-value (fget use :span))
        line (quot span 4294967296)
        column (rem span 4294967296)
        shown (if (ftruthy? site) (use-site-text site) "another use")
        where (if (> span 0) (str " [" (form-text parameter) " at " line ":" column "]") "")]
    (str shown " requires " (type-text (fget use :requires)) where)))
   :default nil)

#?(:kotoba
(defn pu-use-data [use [:ref :form/r]] [:ref :form/r]
  (let [site (fget use :use-site)
        span (form/int-value (fget use :span))
        d0 (fput (fput (empty-fmap) :expected (fget use :expected)) :requires (fget use :requires))
        src (fsource-head site)
        head (if (string=? src "") (form/nth-of site 0) (form/symbol-form src))
        d1 (if (ftruthy? site)
             (fput (fput d0 :operation head) :site (form/string-form (use-site-text site)))
             d0)]
    (if (> span 0) (fput d1 :span (pu-span-form span)) d1)))
   :default nil)

;; the refusal `parameter-use-conflict!` throws, as a value (a call to an aborting function may not sit in a branch)
#?(:kotoba
(defn parameter-use-conflict-error [function [:ref :form/r] parameter [:ref :form/r] first-use [:ref :form/r] second-use [:ref :form/r]] [:ref :fe/err]
  (let [head (str "expression type mismatch: expected " (type-text (fget first-use :expected))
                  ", got " (type-text (fget first-use :actual)))
        who (str " -- parameter " (form-text parameter) " of " (form-text function)
                 " is unannotated and its uses disagree: ")
        uses (str (pu-use-text parameter first-use) ", " (pu-use-text parameter second-use)
                  "; annotate " (form-text parameter))
        span (form/int-value (fget first-use :span))
        d0 (map2 (form/keyword-form :kotoba.error/expected) (fget first-use :expected)
                 (form/keyword-form :kotoba.error/actual) (fget first-use :actual))
        d1 (form/assoc-form (form/assoc-form d0 (form/keyword-form :kotoba.error/function) function)
                            (form/keyword-form :kotoba.error/parameter) parameter)
        d2 (form/assoc-form d1 (form/keyword-form :kotoba.error/uses)
                            (form/vec2 (pu-use-data first-use) (pu-use-data second-use)))
        d3 (if (> span 0) (fput d2 :span (pu-span-form span)) d2)]
    (fe-reject-data (str head who uses) "kotoba.error/parameter-use-conflict" (fget first-use :form) d3)))
   :default nil)

#?(:kotoba
(defn parameter-use-conflict! [function [:ref :form/r] parameter [:ref :form/r] first-use [:ref :form/r] second-use [:ref :form/r]] :i64
  (throw (parameter-use-conflict-error function parameter first-use second-use)))
   :default nil)

#?(:kotoba
(defn param-index-of [params [:ref :form/r] form [:ref :form/r] i :i64] :i64
  (if (>= i (form/count-of params))
    (- 0 1)
    (if (form/eq (form/nth-of params i) form)
      i
      (param-index-of params form (+ i 1)))))
   :default nil)

;; a call-arg refusal names the callee parameter the argument was checked against (enriched by
;; call-param-refusal); decode it into a refinement of that parameter when its provisional :i64
;; disagrees with a refinable argument type
#?(:kotoba
(defn call-site-refinement [data [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
  (let [function (form/form-get data (form/keyword-form :kotoba.error/function))
        marker (form/form-get data (form/keyword-form :kotoba.error/param-index))
        expected (form/form-get data (form/keyword-form :kotoba.error/expected))
        actual (form/form-get data (form/keyword-form :kotoba.error/actual))
        use-site (form/form-get data (form/keyword-form :kotoba.error/use-site))]
    (if (and (not (form/is-nil? function))
             (not (form/is-nil? marker))
             (ty? expected :i64)
             (not (ty? actual :i64))
             (refinable-value-type? actual))
      (fput (fput (fput (fput (empty-fmap) :function function) :index marker) :type actual)
            :first-use
            (fput (fput (fput (fput (fput (fput (empty-fmap) :expected expected) :actual actual) :requires actual) :form form)
                        :span (form/int-form (form/span-of form)))
                  :use-site use-site))
      (form/nil-form))))
   :default nil)

;; a function (or nil) whose unannotated parameter the checker's own refusal says must be something else
#?(:kotoba
(defn refinement-of [ctx [:ref :ie/ctx] f [:ref :form/r] table [:ref :form/r]] [:ref :form/r]
  (try (let [_ (ie-infer ctx (fget f :body) (zip-locals (fget f :params) (fget f :param-types)) table)]
         (form/nil-form))
       (catch [:ref :fe/err] error
         (let [form (record-get [:ref :fe/err] error :form)
               data (record-get [:ref :fe/err] error :data)
               expected (form/form-get data (form/keyword-form :kotoba.error/expected))
               actual (form/form-get data (form/keyword-form :kotoba.error/actual))
               use-site (form/form-get data (form/keyword-form :kotoba.error/use-site))
               index (if (simple-symbol-form? form) (param-index-of (fget f :params) form 0) (- 0 1))]
           (if (and (>= index 0)
                    (fl-has? (form/kids-of (fget f :param-types-inferred)) (form/int-form index) 0)
                    (ty? (form/nth-of (fget f :param-types) index) :i64)
                    (ty? actual :i64)
                    (refinable-value-type? expected))
             (fput (fput (fput (fput (empty-fmap) :function (fget f :name)) :index (form/int-form index)) :type expected)
                   :first-use
                   (fput (fput (fput (fput (fput (fput (empty-fmap) :expected expected) :actual actual) :requires expected) :form form)
                               :span (form/int-form (form/span-of form)))
                         :use-site use-site))
             (call-site-refinement data form))))))
   :default nil)

#?(:kotoba
(defn first-refinement [ctx [:ref :ie/ctx] fs [:ref :form/r] table [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of fs))
    (form/nil-form)
    (let [r (refinement-of ctx (form/nth-of fs i) table)]
      (if (form/is-nil? r)
        (first-refinement ctx fs table (+ i 1))
        r))))
   :default nil)

#?(:kotoba
(defn apply-refinement [fs [:ref :form/r] function [:ref :form/r] index :i64 type [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of fs))
    (form/form-vec acc)
    (let [f (form/nth-of fs i)
          g (if (form/eq (fget f :name) function)
              (fput f :param-types (form-vec-set (fget f :param-types) index type 0 (form/no-forms)))
              f)]
      (apply-refinement fs function index type (+ i 1) (form/append-form acc g)))))
   :default nil)

;; V with element INDEX replaced
#?(:kotoba
(defn form-vec-set [v [:ref :form/r] index :i64 x [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of v))
    (form/form-vec acc)
    (form-vec-set v index x (+ i 1) (form/append-form acc (if (= i index) x (form/nth-of v i))))))
   :default nil)

#?(:kotoba
(defn find-function [fs [:ref :form/r] name [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of fs))
    (form/nil-form)
    (if (form/eq (fget (form/nth-of fs i) :name) name)
      (form/nth-of fs i)
      (find-function fs name (+ i 1)))))
   :default nil)

;; after refining, did the disagreement move onto the same parameter? then both uses are named
#?(:kotoba
(defn second-use-of [ctx [:ref :ie/ctx] refined [:ref :form/r] table [:ref :form/r] index :i64 type [:ref :form/r]] [:ref :form/r]
  (try (let [_ (ie-infer ctx (fget refined :body) (zip-locals (fget refined :params) (fget refined :param-types)) table)]
         (form/nil-form))
       (catch [:ref :fe/err] error
         (let [form (record-get [:ref :fe/err] error :form)
               data (record-get [:ref :fe/err] error :data)
               expected (form/form-get data (form/keyword-form :kotoba.error/expected))
               actual (form/form-get data (form/keyword-form :kotoba.error/actual))
               use-site (form/form-get data (form/keyword-form :kotoba.error/use-site))
               call-index (form/form-get data (form/keyword-form :kotoba.error/param-index))
               callee (form/form-get data (form/keyword-form :kotoba.error/function))
               base (fput (fput (fput (empty-fmap) :expected expected) :use-site use-site)
                         :span (form/int-form (form/span-of form)))]
           (if (not (form/is-nil? call-index))
             (if (and (form/eq callee (fget refined :name))
                      (= (form/int-value call-index) index)
                      (form/eq type expected))
               (fput base :requires actual)
               (form/nil-form))
             (if (and (simple-symbol-form? form)
                      (form/eq form (form/nth-of (fget refined :params) index))
                      (form/eq type actual))
               (fput base :requires expected)
               (form/nil-form)))))))
   :default nil)

;; the same disagreement when it lives in ANOTHER caller's body: a call to the
;; refined function whose argument at INDEX is checked against the refined TYPE
;; and refuses. second-use-of only re-infers the refined function's own body, so
;; without this scan a cross-caller disagreement falls through to the ordinary
;; checker's hard error (tick-33 probe CC1). An argument that is the caller's
;; own still-provisional :i64 parameter is not a disagreement yet -- the fixed
;; point can still refine it -- so only a concrete argument names a second use.
#?(:kotoba
(defn second-call-use-among [ctx [:ref :ie/ctx] fs [:ref :form/r] name [:ref :form/r] table [:ref :form/r] index :i64 type [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of fs))
    (form/nil-form)
    (let [f (form/nth-of fs i)
          use (if (form/eq (fget f :name) name)
                (form/nil-form)
                (try (let [_ (ie-infer ctx (fget f :body) (zip-locals (fget f :params) (fget f :param-types)) table)]
                       (form/nil-form))
                     (catch [:ref :fe/err] error
                       (let [form (record-get [:ref :fe/err] error :form)
                             data (record-get [:ref :fe/err] error :data)
                             expected (form/form-get data (form/keyword-form :kotoba.error/expected))
                             actual (form/form-get data (form/keyword-form :kotoba.error/actual))
                             use-site (form/form-get data (form/keyword-form :kotoba.error/use-site))
                             call-index (form/form-get data (form/keyword-form :kotoba.error/param-index))
                             callee (form/form-get data (form/keyword-form :kotoba.error/function))
                             arg-index (if (simple-symbol-form? form) (param-index-of (fget f :params) form 0) (- 0 1))
                             provisional (and (>= arg-index 0)
                                              (fl-has? (form/kids-of (fget f :param-types-inferred)) (form/int-form arg-index) 0)
                                              (ty? (form/nth-of (fget f :param-types) arg-index) :i64))]
                         (if (and (not (form/is-nil? call-index))
                                  (form/eq callee name)
                                  (= (form/int-value call-index) index)
                                  (form/eq type expected)
                                  (not provisional))
                           (fput (fput (fput (fput (empty-fmap) :expected expected) :requires actual) :use-site use-site)
                                 :span (form/int-form (form/span-of form)))
                           (form/nil-form))))))]
      (if (form/is-nil? use)
        (second-call-use-among ctx fs name table index type (+ i 1))
        use))))
   :default nil)

#?(:kotoba
(defn any-param-inferred? [fs [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of fs))
    false
    (if (ftruthy? (fget (form/nth-of fs i) :param-types-inferred))
      true
      (any-param-inferred? fs (+ i 1)))))
   :default nil)

#?(:kotoba
(defn total-params-from [fs [:ref :form/r] i :i64 acc :i64] :i64
  (if (>= i (form/count-of fs))
    acc
    (total-params-from fs (+ i 1) (+ acc (form/count-of (fget (form/nth-of fs i) :params))))))
   :default nil)

#?(:kotoba
(defn infer-absent-parameter-types-loop [ctx [:ref :ie/ctx] fs [:ref :form/r] budget :i64] [:ref :form/r]
  (if (or (= budget 0) (not (any-param-inferred? fs 0)))
    fs
    (let [r (first-refinement ctx fs (abort-signatures fs) 0)]
      (if (form/is-nil? r)
        fs
        (let [function (fget r :function)
              index (form/int-value (fget r :index))
              type (fget r :type)
              first-use (fget r :first-use)
              applied (apply-refinement fs function index type 0 (form/no-forms))
              refined (find-function applied function 0)
              second-use (let [same (second-use-of ctx refined (abort-signatures applied) index type)]
                           (if (form/is-nil? same)
                             (second-call-use-among ctx applied (fget refined :name) (abort-signatures applied) index type 0)
                             same))]
          (if (ftruthy? second-use)
            (throw (parameter-use-conflict-error function (form/nth-of (fget refined :params) index) first-use second-use))
            (infer-absent-parameter-types-loop ctx applied (- budget 1))))))))
   :default nil)

#?(:kotoba
(defn infer-absent-parameter-types [ctx [:ref :ie/ctx] functions [:ref :form/r]] [:ref :form/r]
  (infer-absent-parameter-types-loop ctx functions
                                     (+ (+ 1 (form/count-of functions)) (total-params-from functions 0 0))))
   :default nil)

;; ── abort-error-type inference ───────────────────────────────────────────────

;; the escaping throw types of BODY as a Form vector, nil when its inference refuses
#?(:kotoba
(defn abort-thrown [ctx [:ref :ie/ctx] body [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (try (let [cc (record-assoc [:ref :ie/ctx] (record-assoc [:ref :ie/ctx] ctx :collect true) :throws (form/no-forms))
             r (ie-infer cc body locals sigs)]
         (form/form-vec (record-get [:ref :ie/ctx] (ie-ctx r) :throws)))
       (catch [:ref :fe/err] e (form/nil-form))))
   :default nil)

;; the first site whose error type is not E, or nil
#?(:kotoba
(defn first-site-not [sites [:list [:ref :form/r]] e [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (vector-count sites))
    (form/nil-form)
    (let [s (fl-nth sites i)]
      (if (same-expression-type? (form/nth-of s 1) e)
        (first-site-not sites e (+ i 1))
        s))))
   :default nil)

#?(:kotoba
(defn some-site-type? [sites [:list [:ref :form/r]] e [:ref :form/r] i :i64] :bool
  (if (>= i (vector-count sites))
    false
    (if (same-expression-type? (form/nth-of (fl-nth sites i) 1) e)
      true
      (some-site-type? sites e (+ i 1)))))
   :default nil)

;; the sites with the first of each distinct error type
#?(:kotoba
(defn unique-type-sites [sites [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (vector-count sites))
    acc
    (let [s (fl-nth sites i)]
      (unique-type-sites sites (+ i 1)
                         (if (some-site-type? acc (form/nth-of s 1) 0) acc (form/append-form acc s))))))
   :default nil)

#?(:kotoba
(defn abort-step [ctx [:ref :ie/ctx] known [:ref :form/r] sigs [:ref :form/r] function [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
  (let [body (fget function :body)
        name (fget function :name)
        label (if (ftruthy? (fget function :source-name)) (fget function :source-name) name)]
    (if (not (abort-escapes? body known))
      acc
      (let [kc (record-assoc [:ref :ie/ctx] ctx :known known)
            thrown (abort-thrown kc body (zip-locals (fget function :params) (fget function :param-types)) sigs)
            own (distinct-forms (form/kids-of thrown) 0 (form/no-forms))
            sites (abort-callee-sites body known)
            propagated (distinct-forms (error-types-from sites 0 (form/no-forms)) 0 (form/no-forms))
            differing (if (= (vector-count own) 1) (first-site-not sites (fl-nth own 0) 0) (form/nil-form))
            uniq (unique-type-sites sites 0 (form/no-forms))]
        (cond
          (form/is-nil? thrown) acc

          (> (vector-count own) 1)
          (throw (fe-reject (str "function " (form-text label) " throws two different error types: "
                                 (abort-type-text (fl-nth own 0)) " and " (abort-type-text (fl-nth own 1)))
                            "kotoba.error/abort-error-type" name))

          (not (form/is-nil? differing))
          (throw (fe-reject (str "function " (form-text label) " throws " (abort-type-text (fl-nth own 0))
                                 " but calls aborting function `" (form-text (form/nth-of differing 0))
                                 "`, which aborts with " (abort-type-text (form/nth-of differing 1)))
                            "kotoba.error/abort-error-type" name))

          (and (= (vector-count own) 0) (> (vector-count propagated) 1))
          (throw (fe-reject (str "function " (form-text label)
                                 " calls aborting functions with two different error types: "
                                 (abort-type-text (form/nth-of (fl-nth uniq 0) 1)) " (`" (form-text (form/nth-of (fl-nth uniq 0) 0)) "`) and "
                                 (abort-type-text (form/nth-of (fl-nth uniq 1) 1)) " (`" (form-text (form/nth-of (fl-nth uniq 1) 0)) "`)")
                            "kotoba.error/abort-error-type" name))

          (> (vector-count own) 0) (form/assoc-form acc name (fl-nth own 0))

          (> (vector-count propagated) 0)
          (if (string=? (abort-synthesized-context function) "")
            (form/assoc-form acc name (fl-nth propagated 0))
            (throw (fe-reject (str "call to aborting function `" (form-text (form/nth-of (fl-nth sites 0) 0)) "` inside "
                                   (abort-synthesized-context function)
                                   " is not admitted in abort slice 1: precondition "
                                   ":checked-lexical-facet-unwind is not met")
                              "kotoba.error/abort-precondition" name)))

          :else acc)))))
   :default nil)

#?(:kotoba
(defn abort-known-from [ctx [:ref :ie/ctx] known [:ref :form/r] sigs [:ref :form/r] fs [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of fs))
    acc
    (let [next (abort-step ctx known sigs (form/nth-of fs i) acc)]
      (abort-known-from ctx known sigs fs (+ i 1) next))))
   :default nil)

#?(:kotoba
(defn abort-result-map [fs [:ref :form/r] known [:ref :form/r]] [:ref :form/r]
  (fput (fput (empty-fmap) :functions fs) :abort-error-types known))
   :default nil)

#?(:kotoba
(defn infer-abort-loop [ctx [:ref :ie/ctx] known [:ref :form/r] functions [:ref :form/r]] [:ref :form/r]
  (let [kc (record-assoc [:ref :ie/ctx] ctx :known known)
        fs (infer-absent-results kc functions)
        sigs (abort-signatures fs)
        next-known (abort-known-from ctx known sigs fs 0 known)]
    (if (form/eq next-known known)
      (abort-result-map fs known)
      (infer-abort-loop ctx next-known fs))))
   :default nil)

;; -> the Form map {:functions fs :abort-error-types {name E}}
#?(:kotoba
(defn infer-abort-error-types [ctx [:ref :ie/ctx] functions [:ref :form/r]] [:ref :form/r]
  (if (any-body-mentions-abort? functions 0)
    (infer-abort-loop ctx (empty-fmap) functions)
    (abort-result-map (infer-absent-results (record-assoc [:ref :ie/ctx] ctx :known (empty-fmap)) functions) (empty-fmap))))
   :default nil)

;; ── abort elaboration ────────────────────────────────────────────────────────
;; `elaborate-aborts` lowers throw/try to result values. The host threads a synthetic-name counter in a dynamic
;; var; here every walk takes the counter N and returns it with the form (`:ae/r`, `:ae/rs`). `:ae/c` carries the
;; inference context (its `known` is the abort-error-types), the signatures and the abort-error-types.

#?(:kotoba
(defn ae-r [form [:ref :form/r] n :i64] [:ref :ae/r]
  (record-new [:ref :ae/r] form n))
   :default nil)

#?(:kotoba
(defn ae-form [r [:ref :ae/r]] [:ref :form/r]
  (record-get [:ref :ae/r] r :form))
   :default nil)

#?(:kotoba
(defn ae-n [r [:ref :ae/r]] :i64
  (record-get [:ref :ae/r] r :n))
   :default nil)

#?(:kotoba
(defn ae-rs [forms [:list [:ref :form/r]] n :i64] [:ref :ae/rs]
  (record-new [:ref :ae/rs] forms n))
   :default nil)

#?(:kotoba
(defn ae-rs-forms [r [:ref :ae/rs]] [:list [:ref :form/r]]
  (record-get [:ref :ae/rs] r :forms))
   :default nil)

#?(:kotoba
(defn ae-rs-n [r [:ref :ae/rs]] :i64
  (record-get [:ref :ae/rs] r :n))
   :default nil)

#?(:kotoba
(defn aec-ctx [c [:ref :ae/c]] [:ref :ie/ctx]
  (record-get [:ref :ae/c] c :ctx))
   :default nil)

#?(:kotoba
(defn aec-sigs [c [:ref :ae/c]] [:ref :form/r]
  (record-get [:ref :ae/c] c :sigs))
   :default nil)

#?(:kotoba
(defn aec-aet [c [:ref :ae/c]] [:ref :form/r]
  (record-get [:ref :ae/c] c :aet))
   :default nil)

;; `(synthetic PREFIX)` with the counter threaded
#?(:kotoba
(defn ae-synthetic [prefix :string n :i64] [:ref :ae/r]
  (let [n1 (+ n 1)]
    (ae-r (form/symbol-form (str "__kotoba_" prefix "_" n1)) n1)))
   :default nil)

#?(:kotoba
(defn ae-type-of [c [:ref :ae/c] form [:ref :form/r] env [:ref :form/r]] [:ref :form/r]
  (ie-type (ie-infer (aec-ctx c) form env (aec-sigs c))))
   :default nil)

;; the error types FORM throws past itself, as a list
#?(:kotoba
(defn ae-thrown [c [:ref :ae/c] form [:ref :form/r] env [:ref :form/r]] [:list [:ref :form/r]]
  (let [cc (record-assoc [:ref :ie/ctx] (record-assoc [:ref :ie/ctx] (aec-ctx c) :collect true) :throws (form/no-forms))
        r (ie-infer cc form env (aec-sigs c))]
    (record-get [:ref :ie/ctx] (ie-ctx r) :throws)))
   :default nil)

#?(:kotoba
(defn ae-scope-error [scope [:ref :form/r]] [:ref :form/r]
  (form/nth-of scope 2))
   :default nil)

;; the refusal for an aborting form that is neither in tail nor let-binding position
#?(:kotoba
(defn ae-refuse-position [c [:ref :ae/c] form [:ref :form/r] scope [:ref :form/r]] [:ref :fe/err]
  (let [callee (first-aborting-call form (aec-aet c))]
    (if (ftruthy? scope)
      (fe-reject (str "abort slice 2 could not A-normalize "
                      (if (form/is-nil? callee) "the throw" (str "the call to `" (form-text callee) "`"))
                      " into tail or let binding position")
                 "kotoba.error/abort-position" form)
      (fe-reject (str "call to aborting function `" (form-text callee)
                      "` in a function that neither catches it nor aborts with the same error type")
                 "kotoba.error/abort-unhandled-call" form))))
   :default nil)

;; walk-plain each of ARGS[i..], in order
#?(:kotoba
(defn ae-plain-args [c [:ref :ae/c] args [:list [:ref :form/r]] i :i64 env [:ref :form/r] scope [:ref :form/r] n :i64 acc [:list [:ref :form/r]]] [:ref :ae/rs]
  (if (>= i (vector-count args))
    (ae-rs acc n)
    (let [r (ae-walk-plain c (fl-nth args i) env scope n)]
      (ae-plain-args c args (+ i 1) env scope (ae-n r) (form/append-form acc (ae-form r))))))
   :default nil)

#?(:kotoba
(defn ae-plain-let-pairs [c [:ref :ae/c] bindings [:ref :form/r] i :i64 body [:ref :form/r] env [:ref :form/r] scope [:ref :form/r] n :i64 out [:list [:ref :form/r]]] [:ref :ae/r]
  (if (>= (+ i 1) (form/count-of bindings))
    (let [br (ae-walk-plain c body env scope n)]
      (ae-r (form/call2 "let" (form/form-vec out) (ae-form br)) (ae-n br)))
    (let [name (form/nth-of bindings i)
          vform (form/nth-of bindings (+ i 1))
          vt (ae-type-of c vform env)
          env2 (form/assoc-form env name vt)
          vr (ae-walk-plain c vform env scope n)]
      (ae-plain-let-pairs c bindings (+ i 2) body env2 scope (ae-n vr)
                          (form/append-form (form/append-form out name) (ae-form vr))))))
   :default nil)

#?(:kotoba
(defn ae-plain-result-match [c [:ref :ae/c] args [:list [:ref :form/r]] env [:ref :form/r] scope [:ref :form/r] n :i64] [:ref :ae/r]
  (let [type (fl-nth args 0)
        ok-name (fl-nth args 2)
        err-name (fl-nth args 4)
        r1 (ae-walk-plain c (fl-nth args 1) env scope n)
        r2 (ae-walk-plain c (fl-nth args 3) (form/assoc-form env ok-name (form/nth-of type 1)) scope (ae-n r1))
        r3 (ae-walk-plain c (fl-nth args 5) (form/assoc-form env err-name (form/nth-of type 2)) scope (ae-n r2))]
    (ae-r (form/call6 "result-match-of" type (ae-form r1) ok-name (ae-form r2) err-name (ae-form r3)) (ae-n r3))))
   :default nil)

#?(:kotoba
(defn ae-plain-option-match [c [:ref :ae/c] args [:list [:ref :form/r]] env [:ref :form/r] scope [:ref :form/r] n :i64] [:ref :ae/r]
  (let [type (fl-nth args 0)
        some-name (fl-nth args 3)
        r1 (ae-walk-plain c (fl-nth args 1) env scope n)
        r2 (ae-walk-plain c (fl-nth args 2) env scope (ae-n r1))
        r3 (ae-walk-plain c (fl-nth args 4) (form/assoc-form env some-name (form/nth-of type 1)) scope (ae-n r2))]
    (ae-r (form/call5 "option-match" type (ae-form r1) (ae-form r2) some-name (ae-form r3)) (ae-n r3))))
   :default nil)

;; a top-level schema reference resolved to its descriptor (the host's `canonical-closure-result-type`)
#?(:kotoba
(defn ae-canonical-type [c [:ref :ae/c] t [:ref :form/r]] [:ref :form/r]
  (let [schemas (ctx-schemas (aec-ctx c))]
    (if (and (schema-ref-type? t) (form/is-map? schemas))
      (let [r (form/form-get schemas (form/nth-of t 1))]
        (if (form/is-nil? r) t r))
      t)))
   :default nil)

#?(:kotoba
(defn ae-variant-branches [c [:ref :ae/c] cases [:ref :form/r] branches [:ref :form/r] i :i64 limit :i64 env [:ref :form/r] scope [:ref :form/r] n :i64 acc [:list [:ref :form/r]]] [:ref :ae/rs]
  (if (>= i limit)
    (ae-rs acc n)
    (let [branch (form/nth-of branches i)
          payload-type (form/nth-of (form/nth-of cases i) 1)
          tag (form/nth-of branch 0)
          binder (form/nth-of branch 1)
          br (ae-walk-plain c (form/nth-of branch 2) (form/assoc-form env binder payload-type) scope n)
          lowered (if (form/is-vec? branch)
                    (form/vec3 tag binder (ae-form br))
                    (form/form-seq (form/three-forms tag binder (ae-form br))))]
      (ae-variant-branches c cases branches (+ i 1) limit env scope (ae-n br) (form/append-form acc lowered)))))
   :default nil)

#?(:kotoba
(defn ae-min [a :i64 b :i64] :i64
  (if (< a b) a b))
   :default nil)

#?(:kotoba
(defn ae-plain-variant-match [c [:ref :ae/c] args [:list [:ref :form/r]] env [:ref :form/r] scope [:ref :form/r] n :i64] [:ref :ae/r]
  (let [type (fl-nth args 0)
        branches (fl-nth args 2)
        cases (form/nth-of (ae-canonical-type c type) 2)
        r1 (ae-walk-plain c (fl-nth args 1) env scope n)
        rs (ae-variant-branches c cases branches 0 (ae-min (form/count-of cases) (form/count-of branches)) env scope (ae-n r1) (form/no-forms))
        lowered (if (form/is-vec? branches) (form/form-vec (ae-rs-forms rs)) (form/form-seq (ae-rs-forms rs)))]
    (ae-r (form/call3 "variant-match" type (ae-form r1) lowered) (ae-rs-n rs))))
   :default nil)

;; the one body of a core `let`, and the three parts of a core `if` (local: an imported aborting function does not propagate)
#?(:kotoba
(defn ae-let-body [args [:list [:ref :form/r]] form [:ref :form/r]] [:ref :form/r]
  (let [n (vector-count args)
        bodies (if (> n 0) (- n 1) 0)]
    (if (= n 2)
      (fl-nth args 1)
      (throw (fe-reject (str "let requires one result expression; got " (string-from-i64 bodies) " (sequence with `do`)")
                        "kotoba.error/let-body-multiple-forms" form)))))
   :default nil)

#?(:kotoba
(defn ae-if-parts [args [:list [:ref :form/r]] form [:ref :form/r]] [:list [:ref :form/r]]
  (let [n (vector-count args)]
    (if (= n 3)
      args
      (throw (fe-reject (str "if requires test, then, else; got " (string-from-i64 n) " arguments") "kotoba.error/if-arity" form)))))
   :default nil)

;; `let` with its one body expression (a refusal otherwise)
#?(:kotoba
(defn ae-plain-let [c [:ref :ae/c] form [:ref :form/r] args [:list [:ref :form/r]] env [:ref :form/r] scope [:ref :form/r] n :i64] [:ref :ae/r]
  (let [body (ae-let-body args form)]
    (ae-plain-let-pairs c (fl-nth args 0) 0 body env scope n (form/no-forms))))
   :default nil)

#?(:kotoba
(defn ae-walk-let [c [:ref :ae/c] form [:ref :form/r] args [:list [:ref :form/r]] env [:ref :form/r] scope [:ref :form/r] n :i64] [:ref :ae/r]
  (let [body (ae-let-body args form)]
    (ae-let-continue c (fl-nth args 0) 0 body env scope n)))
   :default nil)

;; VALUE position: FORM must not abort past itself
#?(:kotoba
(defn ae-walk-plain [c [:ref :ae/c] form [:ref :form/r] env [:ref :form/r] scope [:ref :form/r] n :i64] [:ref :ae/r]
  (cond
    (not (form/is-seq? form)) (ae-r form n)
    (abort-escapes? form (aec-aet c)) (throw (ae-refuse-position c form scope))
    (not (abort-form-mentions? form)) (ae-r form n)
    :else
    (let [op (form/nth-of form 0)
          args (fdrop form 1)
          r (cond
              (sym-is? op "try") (ae-lower-try c form env scope false n)
              (sym-is? op "let") (ae-plain-let c form args env scope n)
              (sym-is? op "result-match-of") (ae-plain-result-match c args env scope n)
              (sym-is? op "option-match") (ae-plain-option-match c args env scope n)
              (sym-is? op "variant-match") (ae-plain-variant-match c args env scope n)
              :else (let [rs (ae-plain-args c args 0 env scope n (form/no-forms))]
                      (ae-r (form/form-seq (form/cons-onto op (ae-rs-forms rs))) (ae-rs-n rs))))]
      (ae-r (preserve-form-meta form (ae-form r)) (ae-n r)))))
   :default nil)

#?(:kotoba
(defn ae-try-error-type [explicit [:ref :form/r] candidates [:list [:ref :form/r]] form [:ref :form/r]] [:ref :form/r]
  (let [disagreeing (if (form/is-nil? explicit) (form/nil-form) (first-site-not-type candidates explicit 0))]
    (cond
      (not (form/is-nil? disagreeing))
      (throw (fe-reject (str "try catches " (abort-type-text explicit) " but its body aborts with " (abort-type-text disagreeing))
                        "kotoba.error/abort-error-type" form))
      (not (form/is-nil? explicit)) explicit
      (= (vector-count candidates) 0)
      (throw (fe-reject "try body cannot abort; there is nothing to catch" "kotoba.error/abort-nothing-to-catch" form))
      (> (vector-count candidates) 1)
      (throw (fe-reject (str "try body aborts with two different error types: "
                             (abort-type-text (fl-nth candidates 0)) " and " (abort-type-text (fl-nth candidates 1)))
                        "kotoba.error/abort-error-type" form))
      :else (fl-nth candidates 0))))
   :default nil)

;; the first type of TYPES that is not EXPLICIT
#?(:kotoba
(defn first-site-not-type [types [:list [:ref :form/r]] explicit [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (vector-count types))
    (form/nil-form)
    (if (same-expression-type? (fl-nth types i) explicit)
      (first-site-not-type types explicit (+ i 1))
      (fl-nth types i))))
   :default nil)

#?(:kotoba
(defn ae-lower-try [c [:ref :ae/c] form [:ref :form/r] env [:ref :form/r] scope [:ref :form/r] tail? :bool n :i64] [:ref :ae/r]
  (let [body (form/nth-of form 1)
        parts (ie-try-parts (form/nth-of form 2) form)
        explicit (form/nth-of parts 0)
        binder (form/nth-of parts 1)
        handler (form/nth-of parts 2)
        thrown (ae-thrown c body env)
        candidates (distinct-forms (form/append-many thrown (abort-callee-error-types body (aec-aet c))) 0 (form/no-forms))
        error-type (ae-try-error-type explicit candidates form)
        value-type (ae-type-of c form env)
        _ (if (form/eq value-type (abort-bottom-form))
            (throw (fe-reject "try body and catch handler both always abort; the try has no value" "kotoba.error/abort-value-type" form))
            0)
        try-scope (form/vec3 (tk :result) value-type error-type)
        br (ae-walk c body env try-scope true n)
        handler-env (form/assoc-form env binder error-type)
        okr (ae-synthetic "abort_ok" (ae-n br))
        ok (ae-form okr)]
    (if (and tail? (ftruthy? scope))
      (let [hr (ae-walk c handler handler-env scope true (ae-n okr))]
        (ae-r (preserve-form-meta form
                (form/call6 "result-match-of" try-scope (ae-form br)
                            ok (form/call2 "result-ok-of" scope ok)
                            binder (ae-form hr)))
              (ae-n hr)))
      (let [hr (ae-walk-plain c handler handler-env scope (ae-n okr))]
        (ae-r (preserve-form-meta form
                (form/call6 "result-match-of" try-scope (ae-form br) ok ok binder (ae-form hr)))
              (ae-n hr))))))
   :default nil)

#?(:kotoba
(defn ae-walk-throw [c [:ref :ae/c] form [:ref :form/r] args [:list [:ref :form/r]] env [:ref :form/r] scope [:ref :form/r] n :i64] [:ref :ae/r]
  (let [vform (fl-nth args 0)
        thrown-type (ae-type-of c vform env)
        wanted (ae-scope-error scope)
        _ (if (same-expression-type? thrown-type wanted)
            0
            (throw (fe-reject (str "throw of " (abort-type-text thrown-type) " inside a scope whose error type is "
                                   (abort-type-text wanted))
                              "kotoba.error/abort-error-type" form)))
        vr (ae-walk-plain c vform env scope n)]
    (ae-r (form/call2 "result-err-of" scope (ae-form vr)) (ae-n vr))))
   :default nil)

#?(:kotoba
(defn ae-walk-if [c [:ref :ae/c] form [:ref :form/r] args [:list [:ref :form/r]] env [:ref :form/r] scope [:ref :form/r] n :i64] [:ref :ae/r]
  (let [parts (ae-if-parts args form)
        tr (ae-walk-plain c (fl-nth parts 0) env scope n)
        thr (ae-walk c (fl-nth parts 1) env scope true (ae-n tr))
        er (ae-walk c (fl-nth parts 2) env scope true (ae-n thr))]
    (ae-r (form/call3 "if" (ae-form tr) (ae-form thr) (ae-form er)) (ae-n er))))
   :default nil)

#?(:kotoba
(defn ae-do-statements [c [:ref :ae/c] args [:list [:ref :form/r]] i :i64 env [:ref :form/r] scope [:ref :form/r] n :i64 acc [:list [:ref :form/r]]] [:ref :ae/rs]
  (if (>= i (- (vector-count args) 1))
    (ae-rs acc n)
    (let [r (ae-walk-plain c (fl-nth args i) env scope n)]
      (ae-do-statements c args (+ i 1) env scope (ae-n r) (form/append-form acc (ae-form r))))))
   :default nil)

#?(:kotoba
(defn ae-walk-do [c [:ref :ae/c] args [:list [:ref :form/r]] env [:ref :form/r] scope [:ref :form/r] n :i64] [:ref :ae/r]
  (let [rs (ae-do-statements c args 0 env scope n (form/no-forms))
        lr (ae-walk c (fl-nth args (- (vector-count args) 1)) env scope true (ae-rs-n rs))]
    (ae-r (form/form-seq (form/cons-onto (form/symbol-form "do") (form/append-form (ae-rs-forms rs) (ae-form lr))))
          (ae-n lr))))
   :default nil)

#?(:kotoba
(defn ae-let-continue [c [:ref :ae/c] bindings [:ref :form/r] i :i64 body [:ref :form/r] env [:ref :form/r] scope [:ref :form/r] n :i64] [:ref :ae/r]
  (if (>= (+ i 1) (form/count-of bindings))
    (ae-walk c body env scope true n)
    (let [name (form/nth-of bindings i)
          vform (form/nth-of bindings (+ i 1))
          value-type (ae-type-of c vform env)
          env2 (form/assoc-form env name value-type)]
      (if (abort-escapes? vform (aec-aet c))
        (let [_ (if (form/eq value-type (abort-bottom-form))
                  (throw (fe-reject "a let binding value that always aborts binds nothing" "kotoba.error/abort-position" vform))
                  0)
              value-scope (form/vec3 (tk :result) value-type (ae-scope-error scope))
              er (ae-synthetic "abort_err" n)
              err (ae-form er)
              vr (ae-walk c vform env value-scope true (ae-n er))
              cr (ae-let-continue c bindings (+ i 2) body env2 scope (ae-n vr))]
          (ae-r (form/call6 "result-match-of" value-scope (ae-form vr) name (ae-form cr) err
                            (form/call2 "result-err-of" scope err))
                (ae-n cr)))
        (let [wr (ae-walk-plain c vform env scope n)
              cr (ae-let-continue c bindings (+ i 2) body env2 scope (ae-n wr))]
          (ae-r (form/call2 "let" (form/vec2 name (ae-form wr)) (ae-form cr)) (ae-n cr)))))))
   :default nil)

#?(:kotoba
(defn ae-walk-call [c [:ref :ae/c] form [:ref :form/r] op [:ref :form/r] args [:list [:ref :form/r]] env [:ref :form/r] scope [:ref :form/r] n :i64] [:ref :ae/r]
  (if (form/form-has? (aec-aet c) op)
    (let [callee-error (form/form-get (aec-aet c) op)
          wanted (ae-scope-error scope)
          _ (if (same-expression-type? callee-error wanted)
              0
              (throw (fe-reject (str "call to aborting function `" (form-text op) "` inside a scope whose error type is "
                                     (abort-type-text wanted) " but it aborts with " (abort-type-text callee-error))
                                "kotoba.error/abort-error-type" form)))
          rs (ae-plain-args c args 0 env scope n (form/no-forms))]
      (ae-r (form/form-seq (form/cons-onto op (ae-rs-forms rs))) (ae-rs-n rs)))
    (throw (ae-refuse-position c form scope))))
   :default nil)

;; tail position of SCOPE (when both are given): produce an R vform
#?(:kotoba
(defn ae-walk [c [:ref :ae/c] form [:ref :form/r] env [:ref :form/r] scope [:ref :form/r] tail? :bool n :i64] [:ref :ae/r]
  (cond
    (not (and tail? (ftruthy? scope))) (ae-walk-plain c form env scope n)
    (not (abort-escapes? form (aec-aet c)))
    (let [r (ae-walk-plain c form env scope n)]
      (ae-r (form/call2 "result-ok-of" scope (ae-form r)) (ae-n r)))
    :else
    (let [op (form/nth-of form 0)
          args (fdrop form 1)
          r (cond
              (sym-is? op "throw") (ae-walk-throw c form args env scope n)
              (sym-is? op "if") (ae-walk-if c form args env scope n)
              (sym-is? op "do") (ae-walk-do c args env scope n)
              (sym-is? op "let") (ae-walk-let c form args env scope n)
              (sym-is? op "try") (ae-lower-try c form env scope true n)
              :else (ae-walk-call c form op args env scope n))]
      (ae-r (preserve-form-meta form (ae-form r)) (ae-n r)))))
   :default nil)

#?(:kotoba
(defn ae-function [c [:ref :ae/c] f [:ref :form/r] n :i64] [:ref :ae/r]
  (let [name (fget f :name)
        label (if (ftruthy? (fget f :source-name)) (fget f :source-name) name)
        result (fget f :result)
        body (fget f :body)
        env (zip-locals (fget f :params) (fget f :param-types))
        aet (aec-aet c)
        error-type (form/form-get aet name)]
    (cond
      (not (form/is-nil? error-type))
      (let [_ (if (and (form/eq result (abort-bottom-form))
                       ;; A HOST-ONLY function's body always aborts by design
                       ;; (issue #785): the annotation the policy asks for is
                       ;; unanswerable, so the refusal is skipped for it.
                       (not (ftruthy? (fget f :host-only?))))
                (throw (fe-reject (str "function " (form-text label) " always aborts; annotate the result type it would return")
                                  "kotoba.error/abort-result" name))
                0)
            scope (form/vec3 (tk :result) result error-type)
            wr (ae-walk c body env scope true n)]
        (ae-r (fput (fput (fput (fput f :result scope) :abort-error-type error-type)
                          :abort-own-throw? (form/bool-form (abort-escapes? body (empty-fmap))))
                    :body (ae-form wr))
              (ae-n wr)))

      (abort-escapes? body (empty-fmap))
      (let [_ (ae-type-of c body env)]
        (throw (fe-reject (str "function " (form-text label) " throws but its error type could not be inferred")
                          "kotoba.error/abort-error-type" name)))

      (or (abort-escapes? body aet) (abort-form-mentions? body))
      (let [wr (ae-walk c body env (form/nil-form) true n)
            f2 (fput f :body (ae-form wr))]
        (ae-r (if (abort-form-mentions? body) (fput f2 :abort-catches? (form/bool-form true)) f2)
              (ae-n wr)))

      :else (ae-r f n))))
   :default nil)

#?(:kotoba
(defn ae-functions [c [:ref :ae/c] fs [:ref :form/r] i :i64 n :i64 acc [:list [:ref :form/r]]] [:ref :ae/rs]
  (if (>= i (form/count-of fs))
    (ae-rs acc n)
    (let [r (ae-function c (form/nth-of fs i) n)]
      (ae-functions c fs (+ i 1) (ae-n r) (form/append-form acc (ae-form r))))))
   :default nil)

;; -> FUNCTIONS (a Form vector) lowered; ABORT-ERROR-TYPES is the Form map {name E}
#?(:kotoba
(defn elaborate-aborts [ctx [:ref :ie/ctx] functions [:ref :form/r] abort-error-types [:ref :form/r]] [:ref :form/r]
  (if (and (= (form/count-of abort-error-types) 0) (not (any-body-mentions-abort? functions 0)))
    functions
    (let [c (record-new [:ref :ae/c] (record-assoc [:ref :ie/ctx] ctx :known abort-error-types)
                        (abort-signatures functions) abort-error-types)
          rs (ae-functions c functions 0 0 (form/no-forms))]
      (form/form-vec (ae-rs-forms rs)))))
   :default nil)

;; ── resolving absence markers (gap 1; see `absence-type`) ────────────────────

#?(:kotoba nil :default (defn absence-none
  "What an absent path is once the `if` is known to have TYPE."
  [marker type]
  (cond
    (= :i64 type) 0
    (= :bool type) false
    (= :option-i64 type) '(option-none)
    (option-vector-type? type) (list 'option-none-of type)
    :else (legacy-absence marker))))

#?(:kotoba nil :default (defn absence-leaves
  "FORM with each tail leaf made a value of TYPE: a marker is TYPE's none, a
  value of T is wrapped when TYPE is [:option T], anything else is left for
  the type check that follows."
  [form type locals signatures]
  (cond
    (absence-marker? form) (absence-none form type)

    (and (seq? form) (= 'if (first form)) (= 4 (count form)))
    (with-meta (list 'if (nth form 1)
                     (absence-leaves (nth form 2) type locals signatures)
                     (absence-leaves (nth form 3) type locals signatures))
      (meta form))

    (and (seq? form) (= 'let (first form)) (= 3 (count form)) (vector? (second form)))
    (let [locals' (reduce (fn [current [name value]]
                            (assoc current name
                                   (try (infer-expression-type value current signatures)
                                          (catch #?(:clj Exception :cljs :default) _ nil))))
                          locals (partition 2 (second form)))]
      (with-meta (list 'let (second form) (absence-leaves (nth form 2) type locals' signatures))
        (meta form)))

    (and (seq? form) (= 'do (first form)) (<= 2 (count form)))
    (with-meta (concat (butlast form) [(absence-leaves (last form) type locals signatures)])
      (meta form))

    (and (option-vector-type? type) (not (option-vector-type? (second type))))
    (let [leaf-type (try (infer-expression-type form locals signatures)
                           (catch #?(:clj Exception :cljs :default) _ nil))]
      (if (and (some? leaf-type) (same-expression-type? leaf-type (second type)))
        (list 'option-some-of type form)
        form))

    :else form)))

#?(:kotoba nil :default (defn absence-tails-legacy
  "FORM with each tail marker what the desugar used to write."
  [form]
  (cond
    (absence-marker? form) (legacy-absence form)
    (and (seq? form) (= 'if (first form)) (= 4 (count form)))
    (with-meta (list 'if (nth form 1) (absence-tails-legacy (nth form 2))
                     (absence-tails-legacy (nth form 3)))
      (meta form))
    (and (seq? form) (contains? '#{let do} (first form)) (<= 2 (count form)))
    (with-meta (concat (butlast form) [(absence-tails-legacy (last form))]) (meta form))
    :else form)))

#?(:kotoba nil :default (defn resolve-absence-if
  "An `if` whose children are already resolved: when one of its tails is an
  absence marker, the `if`'s type decides every tail (`absence-type`). Left
  as it is when nothing here can type it. STATEMENT? is true when the value is
  dropped (a non-final `do` form): an :i64 absence there is written as it
  always was, so a statement's code does not change."
  ([form locals signatures] (resolve-absence-if form locals signatures false))
  ([form locals signatures statement?]
   (if-not (and (seq? form) (= 'if (first form)) (= 4 (count form))
                (or (absence-in-tail? (nth form 2)) (absence-in-tail? (nth form 3))))
     form
     (let [type (try (infer-expression-type form locals signatures)
                       (catch #?(:clj Exception :cljs :default) _ nil))]
       (cond
         (or (nil? type) (absence-kind? type) (= abort-bottom type)) form
         (and statement? (contains? #{:i64 [:option :i64]} type)) (absence-tails-legacy form)
         :else (absence-leaves form type locals signatures)))))))

#?(:kotoba nil :default (defn refinable-value-type? [type]
  (and (some? type)
       (not= type :i64)
       (try (do (validate-value-type! type) true)
            (catch #?(:clj Exception :cljs :default) _ false)))))



#?(:kotoba nil :default (defn parameter-use-conflict!
  "Refuse FUNCTION's unannotated PARAMETER whose uses disagree, naming both.

  FIRST-USE is the refusal the provisional `:i64` met (its `:expected` is what
  the pass tried to refine to, its `:form`/`:span` the site the ordinary
  checker would have reported); SECOND-USE is the refusal the refined type
  met on the same parameter. Each carries the `:use-site` `infer-call-type`
  attached, or nil when the requirement came from something other than a call
  (then that use is described, not shown). The message keeps the old head --
  same site, same expected/actual -- so the report lands where it did before
  this pass could say why (lang-h5)."
  [function parameter first-use second-use]
  (let [type-text #(if (keyword? %) (name %) (pr-str %))
        use-text (fn [{:keys [expected use-site span]}]
                   (str (if use-site (use-site-text use-site) "another use")
                        " requires " (type-text expected)
                        (when (and (:line span) (:column span))
                          (str " [" parameter " at " (:line span) ":" (:column span) "]"))))
        use-data (fn [{:keys [expected use-site span]}]
                   (cond-> {:expected expected}
                     use-site (assoc :operation
                                     (let [head (first use-site)]
                                       (or (:kotoba.diag/source-head (meta head)) head))
                                     :site (use-site-text use-site))
                     span (assoc :span span)))]
    (reject! (str "expression type mismatch: expected " (type-text (:expected first-use))
                  ", got " (type-text (:actual first-use))
                  " -- parameter " parameter " of " function
                  " is unannotated and its uses disagree: "
                  (use-text first-use) ", " (use-text second-use)
                  "; annotate " parameter)
             (:form first-use) :kotoba.error/parameter-use-conflict
             (cond-> {:kotoba.error/expected (:expected first-use)
                      :kotoba.error/actual (:actual first-use)
                      :kotoba.error/function function
                      :kotoba.error/parameter parameter
                      :kotoba.error/uses [(use-data first-use) (use-data second-use)]}
               (:span first-use) (assoc :span (:span first-use)))))))

;; mono a7ef280 order: *provisional-parameters* (11040) and row-aliases
;; (14922) precede infer-absent-parameter-types (15637). row-aliases is
;; `defn-` in the monolith; the module cut makes it public so row.cljk's
;; row cluster can refer it (infer <- row would be a require cycle).

#?(:kotoba nil :default (def ^:dynamic ^:private *provisional-parameters*
  "The parameters `infer-absent-parameter-types` is still refining: unannotated,
  and :i64 only because nothing has refused that yet."
  #{}))

#?(:kotoba nil :default (defn row-aliases
  "PARAM and the synthetic names bound to PARAM itself in FORM: `match` binds
  its scrutinee to a `__kotoba_match_N` temp and projects that (floor
  :row-get-and-match), so a read off the temp is a read off PARAM. Only a
  reserved name -- a program cannot write one -- so a binding the author wrote
  stays a rebinding."
  [param form]
  (into #{param}
        (mapcat (fn [x]
                  (when (and (seq? x) (= 'let (first x)) (vector? (second x)))
                    (keep (fn [[b v]] (when (and (= param v) (reserved-binding-name? b)) b))
                          (partition 2 (second x))))))
        (tree-seq coll? seq form))))

#?(:kotoba nil :default (defn infer-absent-parameter-types
  "Give every unannotated parameter the type its body actually requires.

  An absent annotation meant `:i64`, so any function touching a string had to
  annotate EVERY parameter that was not one -- and after per-parameter
  annotation landed, still had to annotate the string ones. `(defn digit [line i]
  (string-substring line i (+ i 1)))` was rejected with `expected string, got
  i64`, naming a constraint the frontend already knew and would not apply.

  The constraint is read from the checker's own refusal rather than from a
  table of operand types. `require-expression-type!` carries the expected and
  actual types in its ex-data and the rejected form is the bare parameter
  symbol, so what a parameter must be is whatever the type checker says it must
  be. A second table would be a second thing to keep in step; there is none.

  Conservative by construction, in three ways, so that no program admitted
  before this means anything different after it:

    - only parameters marked `:param-types-inferred` are touched, never a
      written annotation;
    - a refinement is applied only when the parameter is still provisional
      `:i64` and the checker asked for something else, so a parameter used as
      an i64 stays one;
    - a parameter whose uses disagree is refused here, at the site the
      ordinary checker would have reported (same form, same expected/actual
      head), with both uses named -- `parameter-use-conflict!`. The program
      fails where it failed before this pass existed; what changed is that
      the refusal says why (lang-h5).

  Iterated to a fixed point because one function's refined parameter changes
  what its callers' arguments must be. The budget bounds it at parameters plus
  functions; hitting it leaves the types as they are and the ordinary checker
  reports."
  [functions]
  (let [signature-table
        (fn [fs]
          (into {} (map (fn [{:keys [name params param-types result]}]
                          [name {:params params :param-types param-types :result result}]))
                fs))
        total-params (reduce + 0 (map #(count (:params %)) functions))]
    (loop [fs functions
           budget (+ 1 (count functions) total-params)]
      (if (or (zero? budget) (not-any? #(or (:param-types-inferred %) (:loop-helper? %)) fs))
        fs
        (let [table (signature-table fs)
              refinement
              (first-truthy (fn [{:keys [name params param-types body loop-helper?]
                                  :as function}]
                      ;; A loop helper has no written parameter at all (ADR
                      ;; 0353 floor :record-list-sequence): a capture typed
                      ;; the provisional :i64 off its call site is refined by
                      ;; what the loop body requires, as an unannotated
                      ;; parameter is, and the call site then refines the
                      ;; enclosing function's own parameter -- window-at's
                      ;; point, read as a vector only inside the search.
                      (let [param-types-inferred
                            (if loop-helper?
                              (set (range (count params)))
                              (:param-types-inferred function))]
                      (when (seq param-types-inferred)
                        (try
                          (do (binding [*provisional-parameters*
                                        (set (keep (fn [index]
                                                     (when (= :i64 (nth param-types index))
                                                       (nth params index)))
                                                   param-types-inferred))]
                                (infer-expression-type body (zipmap params param-types) table))
                              nil)
                          (catch #?(:clj Exception :cljs :default) error
                            (let [{:keys [form span]
                                   expected :kotoba.error/expected
                                   actual :kotoba.error/actual
                                   use-site :kotoba.error/use-site} (ex-data error)
                                  ;; A vector-destructured parameter is read
                                  ;; through the synthetic temp bound to it
                                  ;; (`(let [destr-vector p] (nth destr-vector
                                  ;; 0))`, floor :vector-parameter): a refused
                                  ;; temp is a refused parameter.
                                  index (when (simple-symbol? form)
                                          (first (keep-indexed
                                                  (fn [index parameter]
                                                    (when (or (= parameter form)
                                                              (and (simple-symbol? parameter)
                                                                   (contains? (row-aliases parameter body) form)))
                                                      index))
                                                  params)))]
                              (when (and index
                                         (contains? param-types-inferred index)
                                         (= :i64 (nth param-types index))
                                         (= :i64 actual)
                                         (refinable-value-type? expected))
                                {:function name :index index :type expected
                                 :first-use {:expected expected :actual actual
                                             :form form :span span
                                             :use-site use-site}})))))))
                    fs)]
          (if-not refinement
            fs
            (let [{:keys [function index type first-use]} refinement
                  applied (mapv (fn [f]
                                  (if (= function (:name f))
                                    (assoc f :param-types
                                           (assoc (:param-types f) index type))
                                    f))
                                fs)
                  ;; Did refining it move the disagreement onto the same
                  ;; parameter? Then its uses do not agree, and no single type
                  ;; satisfies both: refuse now, at the site the ordinary
                  ;; checker would have reported, naming both uses.
                  refined (first (filter #(= function (:name %)) applied))
                  second-use
                  (let [t (signature-table applied)]
                    (try (do (infer-expression-type (:body refined)
                                                    (zipmap (:params refined) (:param-types refined))
                                                    t)
                             nil)
                         (catch #?(:clj Exception :cljs :default) error
                           (let [{:keys [form]
                                  actual :kotoba.error/actual
                                  expected :kotoba.error/expected
                                  use-site :kotoba.error/use-site} (ex-data error)]
                             (when (and (simple-symbol? form)
                                        (= form (nth (:params refined) index))
                                        (= type actual))
                               {:expected expected :use-site use-site
                                :span (:span (ex-data error))})))))]
              (if second-use
                (parameter-use-conflict! function (nth (:params refined) index)
                                         first-use second-use)
                (recur applied (dec budget)))))))))))

(defn- param-types-from-uses
  "#117: a body whose inference threw under the :i64 parameter seed gets its
  parameter types from their uses as call arguments (the callee's declared
  parameter type at that index). A parameter with no recoverable use keeps the
  seed. Strictly informative; the final check-value-types! is unchanged."
  [body params param-types table]
  (let [found (volatile! {})]
    (letfn [(scan [form]
              (cond
                (seq? form)
                (do (let [op (first form)
                          args (rest form)]
                      (when (and (symbol? op) (contains? table op))
                        (let [pts (:param-types (get table op))]
                          (doseq [[i a] (map-indexed vector args)]
                            (when (and (symbol? a)
                                       (some #{a} params)
                                       pts
                                       (< i (count pts))
                                       (not= :i64 (nth pts i))
                                       (not (contains? @found a)))
                              (vswap! found assoc a (nth pts i)))))))
                    (doseq [a (rest form)] (scan a)))
                (vector? form) (doseq [a form] (scan a))
                :else nil))]
      (scan body))
    (mapv (fn [p t] (get @found p t)) params param-types)))

#?(:kotoba nil :default (defn infer-absent-results
  "Give every unannotated `defn` the result type its body actually has.

  An absent annotation used to mean `:i64`, so an unannotated function could not
  return a predicate once comparisons became `:bool`-typed -- which is most of
  the stdlib, the examples and the test fixtures. Inferring instead is both the
  Clojure reading (no annotation means no constraint) and what keeps a single
  dialect: annotations are for boundaries, not for every function.

  Two passes, because one function's inferred result feeds the next one's
  inference. A body whose type cannot be resolved keeps the `:i64` provisional
  and `check-value-types!` reports the real error."
  [functions]
  (letfn [(sigs [fs]
            (into {} (map (fn [{:keys [name params param-types result]}]
                            [name {:params params :param-types param-types
                                   :result result}]))
                  fs))
          (pass [fs]
            (let [table (sigs fs)]
              (mapv (fn [{:keys [params param-types body result-inferred?] :as f}]
                      (if result-inferred?
                        (if-let [inferred (try (infer-expression-type
                                                body (zipmap params param-types) table)
                                               (catch #?(:clj Exception :cljs :default) _ nil))]
                          (if (and (= inferred :i64) (some #{:i64} param-types))
                            (if-let [inferred2 (try (infer-expression-type
                                                     body (zipmap params (param-types-from-uses body params param-types table)) table)
                                                    (catch #?(:clj Exception :cljs :default) _ nil))]
                              (assoc f :result inferred2)
                              (assoc f :result inferred))
                            (assoc f :result inferred))
                          (if-let [inferred2 (try (infer-expression-type
                                                   body (zipmap params (param-types-from-uses body params param-types table))
                                                   table)
                                                  (catch #?(:clj Exception :cljs :default) _ nil))]
                            (assoc f :result inferred2)
                            f))
                        f))
                    fs)))]
    (-> functions pass pass))))

#?(:kotoba nil :default (defn first-aborting-call
  "The name of the first aborting function FORM calls, for a refusal."
  [form abort-error-types]
  (first-truthy (fn [x] (when (and (seq? x) (contains? abort-error-types (first x))) (first x)))
        (tree-seq coll? seq form))))

#?(:kotoba nil :default (defn abort-synthesized-context
  "The lexical context a SYNTHESIZED function came from -- the description the
  precondition refusal names -- or nil when the author wrote the function.

  A function with no `:source-name` was made by desugaring: a loop / doseq /
  dotimes body becomes `__kotoba_loop_N` (`:loop-helper?`), a lazy thunk and a
  fn literal both become `__kotoba_lambda_N_arityK`, told apart by
  `:lazy-thunk?`. `throw` inside one of those is refused while it is still
  syntax (`abort-lexical-context`, bound during desugaring). An aborting CALL
  cannot be refused there -- which functions abort is not known until the
  fixed point below -- so it is refused when that is known, by the same
  precondition and in the same words."
  [{:keys [source-name loop-helper? lazy-thunk?]}]
  (when-not source-name
    (cond loop-helper? nil
          lazy-thunk? "a lazy thunk"
          :else "a fn literal"))))

#?(:kotoba nil :default (defn abort-type-text [type]
  (if (keyword? type) (name type) (pr-str type))))

#?(:kotoba nil :default (defn abort-signatures [functions]
  (into {} (map (fn [{:keys [name params param-types result]}]
                  [name {:params params :param-types param-types :result result}]))
        functions)))

#?(:kotoba nil :default (defn infer-abort-error-types
  "Result inference and abort-error-type inference, together, to a fixed point.

  A function's error type E is the type of its own escaping throws -- the ones
  no try body between them and the function boundary catches -- AND, since
  slice 2, the error type of every aborting function it calls with no try body
  in between. Propagation is what makes an ordinary caller aborting without
  writing `throw`, and it is why E is now an interprocedural fact: `parse`
  throws, `read` calls `parse`, `main` catches, and only `main` had to say so.

  Everything that can abort a function must agree on ONE E. Three ways to
  disagree, each refused by name:

    own throws disagree        function f throws two different error types
    own throw vs a callee      function f throws X but calls aborting function
                               `g`, which aborts with Y
    two callees               function f calls aborting functions with two
                               different error types

  A SYNTHESIZED function may not acquire E this way. A loop / doseq / dotimes
  body, a lazy thunk and a fn literal all become functions of their own, and
  an abort leaving one of them unwinds a context whose obligations nothing
  checks yet. `throw` there is refused while it is still syntax; an aborting
  call is refused here, citing the same precondition in the same words --
  otherwise slice 2's propagation would quietly admit exactly what slice 1's
  guard was written to stop.

  The two inferences feed each other: a throw's operand may be a call whose
  result is inferred, and a try's binder type is a callee's error type. So
  each round infers absent results with the error types known so far, then
  reads every function's escaping error types with those results; the loop
  ends when a round adds nothing. Propagation therefore advances one call
  edge per round, which terminates because the call graph is finite.

  Returns `{:functions fs :abort-error-types {name E}}`. A module with no
  `throw`/`try` returns exactly `(infer-absent-results functions)` and `{}`."
  [functions]
  (if-not (first-truthy #(abort-form-mentions? (:body %)) functions)
    {:functions (infer-absent-results functions) :abort-error-types {}}
    (loop [known {} fs functions]
      (let [fs (binding [*abort-error-types* known]
                 (infer-absent-results fs))
            sigs (abort-signatures fs)
            next-known
            (reduce
             (fn [acc {:keys [name source-name params param-types body] :as function}]
               ;; Deliberately NOT short-circuiting on a name already in ACC.
               ;; A function that throws gets its E in round one, when nothing
               ;; is known about its callees; the disagreement between its own
               ;; throw and a callee it also calls is only visible in a LATER
               ;; round, and skipping the function once it has an E would have
               ;; meant never looking. Measured 2026-09-02: with the skip in
               ;; place, `(defn- g [x] (if (= x 1) (throw 9) (f x)))` where `f`
               ;; aborts with a string was admitted here and refused much
               ;; later by elaboration, naming a scope rather than the two
               ;; functions. Recomputing is idempotent -- `own` does not move.
               (if (not (abort-escapes? body known))
                 acc
                 (let [thrown (volatile! [])
                       inferred? (binding [*abort-error-types* known
                                           *abort-throw-types* thrown]
                                   (try (do (infer-expression-type body (zipmap params param-types) sigs)
                                            true)
                                        (catch #?(:clj Exception :cljs :default) _ false)))
                       own (distinct @thrown)
                       sites (binding [*abort-error-types* known] (abort-callee-sites body))
                       propagated (distinct (map second sites))
                       label (or source-name name)]
                   (cond
                     (not inferred?) acc

                     (> (count own) 1)
                     (reject! (str "function " label
                                   " throws two different error types: "
                                   (abort-type-text (first own)) " and "
                                   (abort-type-text (second own)))
                              name :kotoba.error/abort-error-type)

                     (and (= 1 (count own))
                          (first-truthy (fn [[_ e]] (not (same-expression-type? e (first own)))) sites))
                     (let [[callee callee-error]
                           (first (remove (fn [[_ e]] (same-expression-type? e (first own))) sites))]
                       (reject! (str "function " label " throws " (abort-type-text (first own))
                                     " but calls aborting function `" callee
                                     "`, which aborts with " (abort-type-text callee-error))
                                name :kotoba.error/abort-error-type))

                     (and (empty? own) (> (count propagated) 1))
                     (let [[[a ae] [b be]] (->> sites
                                                (reduce (fn [seen [callee e]]
                                                          (if (first-truthy (fn [[_ s]] (same-expression-type? s e)) seen)
                                                            seen
                                                            (conj seen [callee e])))
                                                        [])
                                                (take 2))]
                       (reject! (str "function " label
                                     " calls aborting functions with two different error types: "
                                     (abort-type-text ae) " (`" a "`) and "
                                     (abort-type-text be) " (`" b "`)")
                                name :kotoba.error/abort-error-type))

                     (seq own) (assoc acc name (first own))

                     (seq propagated)
                     (if-let [context (abort-synthesized-context function)]
                       (reject! (str "call to aborting function `" (ffirst sites)
                                     "` inside " context
                                     " is not admitted in abort slice 1: precondition "
                                     ":checked-lexical-facet-unwind is not met")
                                name :kotoba.error/abort-precondition)
                       (assoc acc name (first propagated)))

                     :else acc))))
             known fs)]
        (if (= next-known known)
          {:functions fs :abort-error-types known}
          (recur next-known fs)))))))

#?(:kotoba nil :default (defn elaborate-aborts
  "Lower every `throw`/`try` to result values, and every aborting function to
  one that returns `[:result T E]`.

  In a RESULT SCOPE R = `[:result T E]` (an aborting function's body, or a try
  body), a tail expression is produced as an R value: `(throw e)` is
  `(result-err-of R e)`, a plain value is `(result-ok-of R v)`, a call to an
  aborting function with the same E is itself already an R value, and `if`,
  `do` and `let` push the scope into their tail. A `let` whose binding value
  aborts binds it through `result-match-of`: the ok arm continues, the err arm
  re-raises into R. A `try` is one `result-match-of` over its body's R value,
  ok arm the value, err arm the handler with the binder bound to E.

  Anywhere else an aborting form is refused: in a scope that is not a result
  scope with `call to aborting function ... must be inside try or in a
  function that aborts with the same error type`; in a result scope but not
  in tail or let-binding position, with the slice-1 position refusal.

  Every sub-walk is forced (`mapv`, never `map`) inside the `binding` that
  makes the error types visible: a lazy seq realized after it unwinds would
  read `*abort-error-types*` as empty and call a catchable body uncatchable.

  Types are read from the ORIGINAL forms with `infer-expression-type` (which
  types `throw` as bottom and `try` as its join) against the pre-elaboration
  signatures, never from lowered forms, so the two views never disagree."
  [functions abort-error-types]
  (if-not (or (seq abort-error-types)
              (first-truthy #(abort-form-mentions? (:body %)) functions))
    functions
    (let [sigs (abort-signatures functions)]
      (binding [*abort-error-types* abort-error-types
                *synthetic-counter* (volatile! 0)]
        (letfn [(type-of [form env] (infer-expression-type form env sigs))
                (thrown-types [form env]
                  (let [thrown (volatile! [])]
                    (binding [*abort-throw-types* thrown] (type-of form env))
                    @thrown))
                (keep-meta [form result]
                  (if (seq (meta form)) (with-meta result (meta form)) result))
                (scope-error-type [scope] (nth scope 2))
                ;; BACKSTOPS. `a-normalize-aborts` has already moved every
                ;; aborting form it can reach into tail or let-binding
                ;; position, and `infer-abort-error-types` has already given
                ;; every function that calls one an error type of its own. So
                ;; both of these fire only where the normalizer does not
                ;; descend -- a map or set literal holding an aborting call --
                ;; and they say that rather than naming a rule slice 2 lifted.
                (refuse-position! [form scope]
                  (if scope
                    (reject! (str "abort slice 2 could not A-normalize "
                                  (if-let [callee (first-aborting-call form abort-error-types)]
                                    (str "the call to `" callee "`")
                                    "the throw")
                                  " into tail or let binding position")
                             form :kotoba.error/abort-position)
                    (let [callee (first-aborting-call form abort-error-types)]
                      (reject! (str "call to aborting function `" callee
                                    "` in a function that neither catches it nor aborts "
                                    "with the same error type")
                               form :kotoba.error/abort-unhandled-call))))
                (lower-try [form env scope tail?]
                  (let [[body clause] (rest form)
                        [explicit binder handler] (try-clause-parts clause form)
                        candidates (distinct (into (vec (thrown-types body env))
                                                   (abort-callee-error-types body)))
                        disagreeing (when (some? explicit)
                                      (first (remove #(same-expression-type? % explicit) candidates)))
                        error-type (cond
                                     disagreeing
                                     (reject! (str "try catches " (abort-type-text explicit)
                                                   " but its body aborts with "
                                                   (abort-type-text disagreeing))
                                              form :kotoba.error/abort-error-type)
                                     (some? explicit) explicit
                                     (empty? candidates)
                                     (reject! "try body cannot abort; there is nothing to catch"
                                              form :kotoba.error/abort-nothing-to-catch)
                                     (> (count candidates) 1)
                                     (reject! (str "try body aborts with two different error types: "
                                                   (abort-type-text (first candidates)) " and "
                                                   (abort-type-text (second candidates)))
                                              form :kotoba.error/abort-error-type)
                                     :else (first candidates))
                        value-type (type-of form env)
                        _ (when (= value-type abort-bottom)
                            (reject! "try body and catch handler both always abort; the try has no value"
                                     form :kotoba.error/abort-value-type))
                        try-scope [:result value-type error-type]
                        body* (walk body env try-scope true)
                        handler-env (assoc env binder error-type)
                        ok (synthetic "abort_ok")]
                    (keep-meta
                     form
                     (if (and tail? scope)
                       (list 'result-match-of try-scope body*
                             ok (list 'result-ok-of scope ok)
                             binder (walk handler handler-env scope true))
                       (list 'result-match-of try-scope body*
                             ok ok
                             binder (walk-plain handler handler-env scope))))))
                (walk-plain [form env scope]
                  ;; Value position: FORM must not abort past itself.
                  (cond
                    (not (seq? form)) form
                    (abort-escapes? form abort-error-types) (refuse-position! form scope)
                    (not (abort-form-mentions? form)) form
                    :else
                    (let [[op & args] form]
                      (keep-meta
                       form
                       (case op
                         try (lower-try form env scope false)
                         let (let [bindings (first args) body (let-body args form)]
                               (loop [pairs (partition 2 bindings) env env out []]
                                 (if-let [[name value] (first pairs)]
                                   (recur (rest pairs)
                                          (assoc env name (type-of value env))
                                          (conj out name (walk-plain value env scope)))
                                   (list 'let out (walk-plain body env scope)))))
                         result-match-of
                         (let [[type value ok-name ok-body err-name err-body] args]
                           (list 'result-match-of type (walk-plain value env scope)
                                 ok-name (walk-plain ok-body (assoc env ok-name (second type)) scope)
                                 err-name (walk-plain err-body (assoc env err-name (nth type 2)) scope)))
                         option-match
                         (let [[type value none-body some-name some-body] args]
                           (list 'option-match type (walk-plain value env scope)
                                 (walk-plain none-body env scope)
                                 some-name (walk-plain some-body (assoc env some-name (second type)) scope)))
                         variant-match
                         (let [[type value branches] args
                               cases (nth (canonical-closure-result-type type) 2)
                               lowered (mapv (fn [[[_tag payload-type] [tag binder body :as branch]]]
                                              (let [body* (walk-plain body (assoc env binder payload-type) scope)]
                                                (if (vector? branch) [tag binder body*] (list tag binder body*))))
                                            (mapv vector cases branches))]
                           (list 'variant-match type (walk-plain value env scope)
                                 (if (vector? branches) (vec lowered) (apply list lowered))))
                         (cons op (mapv #(walk-plain % env scope) args)))))))
                (walk [form env scope tail?]
                  ;; Tail position of SCOPE (when both are given): produce an R value.
                  (cond
                    (not (and tail? scope)) (walk-plain form env scope)
                    (not (abort-escapes? form abort-error-types))
                    (list 'result-ok-of scope (walk-plain form env scope))
                    :else
                    (let [[op & args] form]
                      (keep-meta
                       form
                       (case op
                         throw
                         (let [[value] args
                               thrown-type (type-of value env)
                               wanted (scope-error-type scope)]
                           (when-not (same-expression-type? thrown-type wanted)
                             (reject! (str "throw of " (abort-type-text thrown-type)
                                           " inside a scope whose error type is "
                                           (abort-type-text wanted))
                                      form :kotoba.error/abort-error-type))
                           (list 'result-err-of scope (walk-plain value env scope)))
                         if
                         (let [[test then else] (if-parts args form)]
                           (list 'if (walk-plain test env scope)
                                 (walk then env scope true)
                                 (walk else env scope true)))
                         do
                         (list* 'do (concat (mapv #(walk-plain % env scope) (butlast args))
                                            [(walk (last args) env scope true)]))
                         let
                         (let [bindings (first args) body (let-body args form)]
                           ((fn continue [pairs env]
                              (if-let [[name value] (first pairs)]
                                (let [value-type (type-of value env)]
                                  (if (abort-escapes? value abort-error-types)
                                    (let [_ (when (= value-type abort-bottom)
                                              (reject! "a let binding value that always aborts binds nothing"
                                                       value :kotoba.error/abort-position))
                                          value-scope [:result value-type (scope-error-type scope)]
                                          err (synthetic "abort_err")]
                                      (list 'result-match-of value-scope (walk value env value-scope true)
                                            name (continue (rest pairs) (assoc env name value-type))
                                            err (list 'result-err-of scope err)))
                                    (list 'let [name (walk-plain value env scope)]
                                          (continue (rest pairs) (assoc env name value-type)))))
                                (walk body env scope true)))
                            (partition 2 bindings) env))
                         try (lower-try form env scope true)
                         (if (contains? abort-error-types op)
                           (let [callee-error (get abort-error-types op)
                                 wanted (scope-error-type scope)]
                             (when-not (same-expression-type? callee-error wanted)
                               (reject! (str "call to aborting function `" op "` inside a scope "
                                             "whose error type is " (abort-type-text wanted)
                                             " but it aborts with " (abort-type-text callee-error))
                                        form :kotoba.error/abort-error-type))
                             (cons op (mapv #(walk-plain % env scope) args)))
                           (refuse-position! form scope)))))))]
          (mapv (fn [{:keys [name source-name params param-types result body] :as function}]
                  (let [env (zipmap params param-types)
                        error-type (get abort-error-types name)]
                    (cond
                      (some? error-type)
                      (do (when (= result abort-bottom)
                            (reject! (str "function " (or source-name name)
                                          " always aborts; annotate the result type it would return")
                                     name :kotoba.error/abort-result))
                          (let [scope [:result result error-type]]
                            (assoc function
                                   :result scope
                                   :abort-error-type error-type
                                   ;; Which of the two ways it became aborting,
                                   ;; so the precondition refusal can say
                                   ;; "throw" only where there is one.
                                   :abort-own-throw? (abort-escapes? body {})
                                   :body (walk body env scope true))))
                      ;; Escaping throws whose type never resolved: run the
                      ;; inference uncaught so the real refusal is the one seen.
                      (abort-escapes? body {})
                      (do (type-of body env)
                          (reject! (str "function " (or source-name name)
                                        " throws but its error type could not be inferred")
                                   name :kotoba.error/abort-error-type))
                      (or (abort-escapes? body abort-error-types)
                          (abort-form-mentions? body))
                      (cond-> (assoc function :body (walk body env nil true))
                        (abort-form-mentions? body) (assoc :abort-catches? true))
                      :else function)))
                functions)))))))

#?(:kotoba nil :default (defn closure-dispatcher-function?
  "The synthetic entry points whose first physical i64 word is a closure pair."
  [function-name]
  (or (= '__kotoba_closure_apply function-name)
      (boolean
       (re-matches #"__kotoba_invoke(?:_.+)?\$arity[0-4]"
                   (str function-name))))))

#?(:kotoba nil :default (defn callable-field-read?
  "`(record-get T v :f)` where T declares :f as `[:fn ...]`."
  [form]
  (and (seq? form) (= 'record-get (first form)) (= 4 (count form))
       (let [type (canonical-closure-result-type (second form))]
         (and (record-type? type)
              (callable-type? (record-field-type type (nth form 3))))))))

#?(:kotoba nil :default (defn callable-field-values
  "The values a `record-new` / `record-assoc` form stores in `[:fn ...]`
  fields."
  [form]
  (when (seq? form)
    (let [[op type & args] form
          type (when (contains? '#{record-new record-assoc} op)
                 (canonical-closure-result-type type))]
      (when (record-type? type)
        (case op
          record-new (keep (fn [[[_ field-type] value]]
                             (when (callable-type? field-type) value))
                           (map vector (nth type 2) args))
          record-assoc (let [[_ field replacement] args]
                         (when (callable-type? (record-field-type type field))
                           [replacement]))))))))

#?(:kotoba nil :default (defn generated-empty-test?
  "`(= __kotoba_... 0)`: the empty test a lazy sequence's desugaring writes."
  [form]
  (and (seq? form) (= '= (first form)) (= 3 (count form))
       (let [[a b] (rest form)
             generated? #(and (symbol? %) (str/starts-with? (str %) "__kotoba_"))
             zero? #(and (kotoba-integer? %) (zero? %))]
         (or (and (generated? a) (zero? b)) (and (zero? a) (generated? b)))))))

#?(:kotoba
   (defn closure-number-operations [] [:ref :form/r]
     (form/form-set
      (form/append-many
       (form/append-many
        (form/append-many (heads-kids (tables/arithmetic))
                          (heads-kids (tables/comparisons)))
        (heads-kids (tables/i64-operations)))
       (heads-kids (tables/i32-operations)))))
   :default
   (def closure-number-operations
     "The operations that read a word as a number, which a closure handle is not
  (ADR 0353 floor :function-values)."
     (into (set/union arithmetic comparisons)
           (concat (keys i64-operations) (keys i32-operations)))))

#?(:kotoba nil :default (defn infer-closure-refinements
  "Infer checked closure positions without adding a public closure value type.

  Closure pairs intentionally remain i64 words in Wasm/native signatures.  The
  refinements tell representation-aware runtimes which of those words must be
  validated as the bounded `(lambda-id, capture-chain)` shape.  Facts only grow:
  dispatcher arguments seed the graph, static calls propagate requirements to
  callers, and closure-valued results propagate back through aliases and return
  positions.  The finite function/parameter graph therefore has a deterministic
  fixed point."
  [functions lambda-infos]
  (let [lambda-ids (mapv :id lambda-infos)
        function-names (set (map :name functions))
        seed
        (into {}
              (map (fn [{:keys [name closure-param-indexes closure-result?
                                callable-param-contracts callable-result-contract]}]
                     [name {:params (cond-> (into (set closure-param-indexes)
                                                  (keys callable-param-contracts))
                                      (closure-dispatcher-function? name) (conj 0))
                            :result? (or (true? closure-result?)
                                         (some? callable-result-contract))}]))
              functions)
        refinement-count-limit
        (+ 1 (count functions) (reduce + (map (comp count :params) functions)))]
    (letfn [(binding-value [env name]
              (get env name))
            (lambda-info-for-id [id]
              (first-truthy #(when (= id (:id %)) %) lambda-infos))
            (pair-chain-values [form]
              (loop [chain form values []]
                (cond
                  (and (kotoba-integer? chain) (zero? chain)) values
                  (and (seq? chain) (= 'pair (first chain)) (= 3 (count chain)))
                  (recur (nth chain 2) (conj values (second chain)))
                  :else nil)))
            (closure-literal? [form]
              (and (seq? form)
                   (= 'pair (first form))
                   (= 3 (count form))
                   (kotoba-integer? (second form))
                   ;; NBB represents guest i64 literals as JavaScript BigInt,
                   ;; which cannot be hashed by the CLJS persistent-set UID
                   ;; path. Lambda IDs are bounded by max-functions, so a
                   ;; deterministic linear scan avoids hashing arbitrary pair
                   ;; payloads without widening the analysis.
                   (first-truthy #(= % (second form)) lambda-ids)))
            (zero-tested-symbol [form]
              (when (and (seq? form) (= '= (first form)) (= 3 (count form)))
                (let [[left right] (rest form)]
                  (cond
                    (and (symbol? left) (kotoba-integer? right) (zero? right)) left
                    (and (symbol? right) (kotoba-integer? left) (zero? left)) right
                    :else nil))))
            (expression-status [function-name form env param-indexes facts seen]
              (cond
                (closure-literal? form) :closure
                (symbol? form)
                (if (contains? seen form)
                  :unknown
                  (if-let [{bound-form :form bound-env :env bound-status :status}
                           (binding-value env form)]
                    ;; The binding loop below already ran this exact query when
                    ;; it bound the name, so the answer is carried on the entry
                    ;; rather than re-derived. Re-deriving is what made this
                    ;; quadratic: a chain of K bindings each referring to the
                    ;; previous one costs O(i) to resolve at binding i, so the
                    ;; loop paid sum(i) = O(K^2) walks of the same forms.
                    (or bound-status
                        (expression-status function-name bound-form bound-env
                                           param-indexes facts (conj seen form)))
                    (if (contains? (get-in facts [function-name :params] #{})
                                   (get param-indexes form))
                      :closure
                      :unknown)))
                (seq? form)
                (let [[op & args] form]
                  (cond
                    (= op 'let)
                    (let [bindings (first args) body (let-body args form)]
                      (loop [pairs (partition 2 bindings) current env]
                        (if-let [[name value] (first pairs)]
                          (let [status (expression-status function-name value current
                                                          param-indexes facts seen)]
                            (if (= :trap status)
                              :trap
                              (recur (next pairs)
                                     (assoc current name {:form value
                                                          :env current
                                                          :status status}))))
                          (expression-status function-name body current param-indexes
                                             facts seen))))

                    (= op 'if)
                    (let [[test then else] args
                          test-status (expression-status function-name test env
                                                         param-indexes facts seen)]
                      (if (= :trap test-status)
                        :trap
                        (let [then-status (expression-status function-name then env
                                                             param-indexes facts seen)
                              else-status (expression-status function-name else env
                                                             param-indexes facts seen)
                              statuses (set [then-status else-status])]
                          (cond
                            (= statuses #{:trap}) :trap
                            (and (contains? statuses :closure)
                                 (every? #{:closure :trap} statuses)) :closure
                            :else :unknown))))

                    (= op 'do)
                    (loop [remaining args]
                      (if-let [value (first remaining)]
                        (let [status (expression-status function-name value env
                                                        param-indexes facts seen)]
                          (if (or (= :trap status) (nil? (next remaining)))
                            status
                            (recur (next remaining))))
                        :unknown))

                    (and (= op 'quot) (= args '(1 0))) :trap

                    ;; a `[:fn ...]` record field holds a closure (ADR 0353
                    ;; floor :function-values)
                    (callable-field-read? form) :closure

                    :else
                    (let [arg-statuses (mapv #(expression-status
                                              function-name % env param-indexes facts seen)
                                             args)]
                      (cond
                        (first-truthy #{:trap} arg-statuses) :trap
                        (and (contains? function-names op)
                             (get-in facts [op :result?])) :closure
                        :else :unknown))))
                :else :unknown))
            (analyze-pass [facts]
              (let [next-facts (volatile! facts)]
                (letfn [(mark-param! [function-name index]
                          (when (some? index)
                            (vswap! next-facts update-in
                                    [function-name :params] (fnil conj #{}) index)))
                        (mark-result! [function-name]
                          (vswap! next-facts assoc-in [function-name :result?] true))
                        (require-closure! [function-name form env param-indexes
                                           narrowed seen]
                          (when-not (= :trap (expression-status
                                             function-name form env param-indexes
                                             @next-facts seen))
                            (cond
                              (closure-literal? form) nil
                              (symbol? form)
                              (when-not (or (contains? narrowed form)
                                            (contains? seen form))
                                (if-let [{bound-form :form bound-env :env}
                                         (binding-value env form)]
                                  (require-closure! function-name bound-form bound-env
                                                    param-indexes narrowed
                                                    (conj seen form))
                                  (mark-param! function-name
                                               (get param-indexes form))))
                              (seq? form)
                              (let [[op & args] form]
                                (cond
                                  (= op 'let)
                                  (let [bindings (first args) body (let-body args form)]
                                    (loop [pairs (partition 2 bindings) current env]
                                      (if-let [[name value] (first pairs)]
                                        (recur (next pairs)
                                               (assoc current name {:form value
                                                                    :env current}))
                                        (require-closure! function-name body current
                                                          param-indexes narrowed seen))))
                                  (= op 'if)
                                  (doseq [branch (rest args)]
                                    (require-closure! function-name branch env
                                                      param-indexes narrowed seen))
                                  (= op 'do)
                                  (when-let [tail (last args)]
                                    (require-closure! function-name tail env
                                                      param-indexes narrowed seen))
                                  (and (contains? function-names op)
                                       (not (closure-dispatcher-function? op)))
                                  (mark-result! op)
                                  :else nil))
                              :else nil)))
                        (scan-calls! [function-name form env param-indexes narrowed]
                          (when (seq? form)
                            (if (closure-literal? form)
                              (let [[_ lambda-id capture-chain] form
                                    {:keys [captures helper]}
                                    (lambda-info-for-id lambda-id)
                                    capture-values (pair-chain-values capture-chain)
                                    capture-count (count captures)]
                                (doseq [capture capture-values]
                                  (scan-calls! function-name capture env param-indexes
                                               narrowed))
                                (doseq [index (get-in @next-facts
                                                     [(:name helper) :params] #{})
                                        :when (< index capture-count)]
                                  (when-let [capture (nth capture-values index nil)]
                                    (require-closure! function-name capture env
                                                      param-indexes narrowed #{}))))
                              (let [[op & args] form]
                                (cond
                                (= op 'let)
                                (let [bindings (first args) body (let-body args form)]
                                  (loop [pairs (partition 2 bindings) current env]
                                    (if-let [[name value] (first pairs)]
                                      (do (scan-calls! function-name value current
                                                       param-indexes narrowed)
                                          (recur (next pairs)
                                                 (assoc current name {:form value
                                                                      :env current})))
                                      (scan-calls! function-name body current
                                                   param-indexes narrowed))))
                                (= op 'if)
                                (let [[test then else] args
                                      nonzero-symbol (zero-tested-symbol test)]
                                  (scan-calls! function-name test env param-indexes narrowed)
                                  (scan-calls! function-name then env param-indexes narrowed)
                                  (scan-calls! function-name else env param-indexes
                                               (cond-> narrowed
                                                 nonzero-symbol (conj nonzero-symbol))))
                                :else
                                (do
                                  (doseq [arg args]
                                    (scan-calls! function-name arg env param-indexes
                                                 narrowed))
                                  ;; A dispatcher multiplexes lambdas whose
                                  ;; argument positions may have different
                                  ;; representation refinements.  Candidate-
                                  ;; specific requirements belong on each
                                  ;; helper entry, not on the shared dispatcher
                                  ;; argument (only its closure handle is a
                                  ;; uniform checked position).
                                  (when (and (contains? function-names op)
                                             (not (closure-dispatcher-function?
                                                   function-name)))
                                    (doseq [index (get-in @next-facts
                                                         [op :params] #{})]
                                      (when-let [arg (nth args index nil)]
                                        (require-closure! function-name arg env
                                                          param-indexes narrowed
                                                          #{}))))))))))]
                  (doseq [{:keys [name params body]} functions]
                    (let [param-indexes (zipmap params (range))]
                      (when (= :closure (expression-status
                                         name body {} param-indexes @next-facts #{}))
                        (mark-result! name))
                      (when (get-in @next-facts [name :result?])
                        (require-closure! name body {} param-indexes #{} #{}))
                      (scan-calls! name body {} param-indexes #{})))
                  @next-facts)))]
      (let [facts
            (loop [facts seed iteration 0]
              (let [next-facts (analyze-pass facts)]
                (cond
                  (= facts next-facts) facts
                  (>= iteration refinement-count-limit)
                  (reject! "closure refinement inference did not converge"
                           {:iterations iteration})
                  :else (recur next-facts (inc iteration)))))]
        ;; ADR 0353 floor :function-values: a closure is a function, not a
        ;; number. Its word stays the one-word i64 handle every dispatcher
        ;; takes, so the refusal is made where the analysis above knows the
        ;; word is a closure: a let-bound fn, a call whose result is one
        ;; (a `[:fn ...]` result contract), a `[:fn ...]` record field.
        (letfn [(refuse-closure-operands! [function-name form env param-indexes]
                  (when (seq? form)
                    (let [[op & args] form]
                      (if (= op 'let)
                        (let [bindings (first args) body (let-body args form)]
                          (loop [pairs (partition 2 bindings) current env]
                            (if-let [[name value] (first pairs)]
                              (do (refuse-closure-operands! function-name value current
                                                            param-indexes)
                                  (recur (next pairs)
                                         (assoc current name {:form value :env current})))
                              (refuse-closure-operands! function-name body current
                                                        param-indexes))))
                        (do
                          (doseq [item (callable-field-values form)]
                            (when-not (closure-literal? item)
                              (reject! (str "a [:fn ...] record field takes a fn literal; "
                                            "this value is not a closure (ADR 0353)")
                                       form :kotoba.error/function-value-field)))
                          ;; The one exemption is generated: a lazy sequence is
                          ;; a closure or 0 (empty), and its desugaring tests
                          ;; `(= __kotoba_lazy_seq_N 0)`. `__kotoba_` is
                          ;; reserved, so no source program reaches this.
                          (when (and (contains? closure-number-operations op)
                                     (not (generated-empty-test? form)))
                            (doseq [arg args]
                              (when (= :closure (expression-status function-name arg env
                                                                   param-indexes facts #{}))
                                (if (= '= op)
                                  (reject! (str "a function value has no equality: (= f g) would "
                                                "compare two closure handles, and equality over "
                                                "handles stays refused (ADR 0353)")
                                           form :kotoba.error/function-value-equality)
                                  (reject! (str "a function value is not a number: " op
                                                " over a closure is refused; call it instead"
                                                " (ADR 0353)")
                                           form :kotoba.error/function-value-arithmetic)))))
                          (doseq [arg args]
                            (refuse-closure-operands! function-name arg env
                                                      param-indexes)))))))]
          (doseq [{:keys [name params body]} functions]
            (refuse-closure-operands! name body {} (zipmap params (range)))))
        (mapv
         (fn [{:keys [name param-types result] :as function}]
           (let [indexes (vec (sort (get-in facts [name :params] #{})))
                 result? (true? (get-in facts [name :result?]))]
             (doseq [index indexes]
               (when-not (= :i64 (nth param-types index nil))
                 (reject! "closure refinement requires an i64 parameter"
                          {:function name :parameter-index index})))
             (when (and result? (not= :i64 result))
               (reject! "closure refinement requires an i64 result"
                        {:function name :result result}))
             (cond-> function
               (seq indexes) (assoc :closure-param-indexes indexes)
               result? (assoc :closure-result? true))))
         functions))))))

;; Total bytes of string literals, and of keyword literals, a module may carry (each occurrence counts, after desugaring). This is a
;; bound on the module's rodata, not on one value: it used to reuse `value/string-value-byte-limit` (64 KiB, the cap on a single runtime
;; string), which the compiler's own linked closure exceeds many times over (amu ADR 0359).
#?(:kotoba nil :default (def max-module-literal-bytes 4194304))

#?(:kotoba nil :default (defn check-value-types! [functions]
  (let [signatures (into {} (map (fn [{:keys [name params param-types result]}]
                                   [name {:params params :param-types param-types
                                          :result result}])
                                 functions))]
    (binding [*numeric-resolution-final* true]
      (doseq [{:keys [name params param-types result body]} functions]
        (let [actual (infer-expression-type body (zipmap params param-types) signatures)]
          (require-expression-type! actual result name))))
    (let [nodes (mapcat #(tree-seq coll? seq (:body %)) functions)
          literal-bytes
          (reduce + 0
                  (map value/utf8-byte-count!
                       (filter string? nodes)))
          keyword-bytes
          (reduce + 0
                  (map (comp value/utf8-byte-count! str)
                       (filter keyword? nodes)))]
      (when (> literal-bytes max-module-literal-bytes)
        (reject! "module string literals exceed UTF-8 byte limit" literal-bytes))
      (when (> keyword-bytes max-module-literal-bytes)
        (reject! "module keyword literals exceed UTF-8 byte limit" keyword-bytes))))))

;; ── Kotoba route: the module passes check-value-types! and elaborate-named-abilities ──
;; (ported from the host forms above and below; the context is the first argument, section 9 of
;; docs/selfhost-frontend-typemodel-design.md. A function is a Form map keyed like the host's.)
;; ---- the module passes over a function list (Kotoba route) ----
#?(:kotoba
(defn- check-value-body! [f [:ref :form/r] ctx [:ref :ie/ctx] sigs [:ref :form/r]] :i64
  (let [body (fget f :body)
        params (fget f :params)
        ptypes (fget f :param-types)
        locals (zip-locals params ptypes)
        res (ie-infer ctx body locals sigs)
        actual (ie-type res)
        result (fget f :result)
        name (fget f :name)]
    (require-expression-type! actual result name)))
   :default nil)

#?(:kotoba
(defn- check-value-bodies! [functions [:ref :form/r] i :i64 ctx [:ref :ie/ctx] sigs [:ref :form/r]] :i64
  (if (>= i (form/count-of functions))
    0
    (let [_ (check-value-body! (form/nth-of functions i) ctx sigs)]
      (check-value-bodies! functions (+ i 1) ctx sigs))))
   :default nil)

;; Total UTF-8 bytes of the string literals (KW? false) or keyword literals (KW? true) of F
#?(:kotoba
(defn- literal-bytes-kids [f [:ref :form/r] i :i64 kw? :bool acc :i64] :i64
  (if (>= i (form/count-of f))
    acc
    (literal-bytes-kids f (+ i 1) kw? (+ acc (literal-bytes (form/nth-of f i) kw?)))))
   :default nil)

#?(:kotoba
(defn- literal-bytes [f [:ref :form/r] kw? :bool] :i64
  (cond
    (form/is-string? f) (if kw? 0 (string-length (form/string-value f)))
    (form/is-keyword? f) (if kw? (string-length (form-text f)) 0)
    :else (literal-bytes-kids f 0 kw? 0)))
   :default nil)

#?(:kotoba
(defn- module-literal-bytes [functions [:ref :form/r] i :i64 kw? :bool acc :i64] :i64
  (if (>= i (form/count-of functions))
    acc
    (module-literal-bytes functions (+ i 1) kw? (+ acc (literal-bytes (fget (form/nth-of functions i) :body) kw?)))))
   :default nil)

;; Total bytes of string literals, and of keyword literals, a module may carry (amu ADR 0359)
#?(:kotoba
(defn- max-module-literal-bytes [] :i64 4194304)
   :default nil)

#?(:kotoba
(defn check-value-types! [ctx [:ref :ie/ctx] functions [:ref :form/r]] :i64
  (let [sigs (abort-signatures functions)
        _ (check-value-bodies! functions 0 (record-assoc [:ref :ie/ctx] ctx :final true) sigs)
        lit (module-literal-bytes functions 0 false 0)
        _ (req! (<= lit (max-module-literal-bytes)) "module string literals exceed UTF-8 byte limit" "kotoba.error/subset-reject" (form/int-form lit))
        kw (module-literal-bytes functions 0 true 0)]
    (req! (<= kw (max-module-literal-bytes)) "module keyword literals exceed UTF-8 byte limit" "kotoba.error/subset-reject" (form/int-form kw))))
   :default nil)

#?(:kotoba
(defn- ie-type-of [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (let [r (ie-infer ctx form locals sigs)]
    (ie-type r)))
   :default nil)

;; ---- elaborate-named-ability(ies) ----
;; A pass answers a pair [form' used'] : the host's `used` volatile is threaded by value (a Form set of capabilities).
;; Style: the arguments of an aborting call are bare locals (the lowering of an aborting call whose argument is an
;; imported call on a let-bound local loses the local).
#?(:kotoba
(defn- el-r [form [:ref :form/r] used [:ref :form/r]] [:ref :form/r]
  (form/vec2 form used))
   :default nil)

#?(:kotoba
(defn- el-form [r [:ref :form/r]] [:ref :form/r]
  (form/nth-of r 0))
   :default nil)

#?(:kotoba
(defn- el-used [r [:ref :form/r]] [:ref :form/r]
  (form/nth-of r 1))
   :default nil)

#?(:kotoba
(defn- el-used-add [used [:ref :form/r] cap [:ref :form/r]] [:ref :form/r]
  (if (fl-has? (form/kids-of used) cap 0)
    used
    (form/form-set (form/append-form (form/kids-of used) cap))))
   :default nil)

#?(:kotoba
(defn- cap-wire-id! [ctx [:ref :ie/ctx] capability [:ref :form/r] form [:ref :form/r]] :i64
  (let [id (ie-tbl-get ctx :capability-registry capability)
        msg (string-concat "cap-call names an unregistered capability: " (form-text capability))
        ok (not (form/is-nil? id))
        _ (req! ok msg "kotoba.error/subset-reject" form)]
    (form/int-value id)))
   :default nil)

#?(:kotoba
(defn- el-arity! [op [:ref :form/r] want :i64 got :i64 form [:ref :form/r]] :i64
  (if (= want got)
    0
    (throw (fe-reject (str "function call arity mismatch: " (form-text op) " takes " (string-from-i64 want)
                           (if (= 1 want) " argument" " arguments") "; got " (string-from-i64 got))
                      "kotoba.error/call-arity" form))))
   :default nil)

#?(:kotoba
(defn- el-arg-expected [mode :i64 expected [:ref :form/r] ptypes [:ref :form/r] i :i64 n :i64] [:ref :form/r]
  (cond
    (= mode 1) (form/nth-of ptypes i)
    (and (= mode 2) (= i (- n 1))) expected
    :else (form/nil-form)))
   :default nil)

;; the arguments of FORM from position I (a form index, 1 = first argument), elaborated; answers [vec used]
;; MODE 0: no expected type, 1: the callee's parameter types, 2: EXPECTED for the last (`do`)
#?(:kotoba
(defn- el-args [ctx [:ref :ie/ctx] form [:ref :form/r] i :i64 mode :i64 expected [:ref :form/r] ptypes [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] used [:ref :form/r] acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of form))
    (el-r (form/form-vec acc) used)
    (let [arg (form/nth-of form i)
          want (el-arg-expected mode expected ptypes (- i 1) (argc form))
          r (ie-elab ctx arg want locals sigs used)
          used2 (el-used r)
          acc2 (form/append-form acc (el-form r))]
      (el-args ctx form (+ i 1) mode expected ptypes locals sigs used2 acc2))))
   :default nil)

;; (op arg'...) with FORM's metadata
#?(:kotoba
(defn- el-call-of [form [:ref :form/r] args-r [:ref :form/r]] [:ref :form/r]
  (let [items (form/kids-of (el-form args-r))
        call (form/form-seq (form/cons-onto (form/nth-of form 0) items))]
    (el-r (preserve-form-meta form call) (el-used args-r))))
   :default nil)

#?(:kotoba
(defn- el-source-op-checks! [ctx [:ref :ie/ctx] form [:ref :form/r] expected [:ref :form/r]] :i64
  (let [op (form/nth-of form 0)
        one (= 1 (argc form))
        _ (req! one "named capability operation requires exactly one request" "kotoba.error/subset-reject" form)
        typed (or (ftruthy? expected) (ie-tbl-has? ctx :named-operation-default-results op))]
    (req! typed "named capability operation requires a typed result context" "kotoba.error/subset-reject" form)))
   :default nil)

#?(:kotoba
(defn- el-source-op [ctx [:ref :ie/ctx] form [:ref :form/r] expected [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] used [:ref :form/r]] [:ref :form/r]
  (let [_ (el-source-op-checks! ctx form expected)
        op (form/nth-of form 0)
        want (if (ftruthy? expected) expected (ie-tbl-get ctx :named-operation-default-results op))
        arg (a form 0)
        none (form/nil-form)
        rq (ie-elab ctx arg none locals sigs used)
        request (el-form rq)
        request-type (ie-type-of ctx request locals sigs)
        capability (ie-tbl-get ctx :source-operation-registry op)
        id (cap-wire-id! ctx capability form)
        idf (form/int-form id)
        call (form/call4 "typed-cap-call" idf request-type want request)]
    (el-r (preserve-form-meta form call) (el-used-add (el-used rq) capability))))
   :default nil)

#?(:kotoba
(defn- el-let-pairs [ctx [:ref :ie/ctx] bindings [:ref :form/r] i :i64 current [:ref :form/r] out [:list [:ref :form/r]] body [:ref :form/r] expected [:ref :form/r] sigs [:ref :form/r] used [:ref :form/r]] [:ref :form/r]
  (if (< (+ i 1) (form/count-of bindings))
    (let [name (form/nth-of bindings i)
          value (form/nth-of bindings (+ i 1))
          none (form/nil-form)
          r (ie-elab ctx value none current sigs used)
          elaborated (el-form r)
          t (ie-type-of ctx elaborated current sigs)
          next-locals (form/assoc-form current name t)
          out2 (form/append-form (form/append-form out name) elaborated)
          used2 (el-used r)]
      (el-let-pairs ctx bindings (+ i 2) next-locals out2 body expected sigs used2))
    (let [r (ie-elab ctx body expected current sigs used)
          e (el-form r)
          vec-out (form/form-vec out)]
      (el-r (form/call2 "let" vec-out e) (el-used r)))))
   :default nil)

#?(:kotoba
(defn- el-let [ctx [:ref :ie/ctx] form [:ref :form/r] expected [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] used [:ref :form/r]] [:ref :form/r]
  (let [body (ie-let-body form)
        bindings (a form 0)
        r (el-let-pairs ctx bindings 0 locals (form/no-forms) body expected sigs used)]
    (el-r (preserve-form-meta form (el-form r)) (el-used r))))
   :default nil)

#?(:kotoba
(defn- el-if [ctx [:ref :ie/ctx] form [:ref :form/r] expected [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] used [:ref :form/r]] [:ref :form/r]
  (let [msg (str "if requires test, then, else; got " (string-from-i64 (argc form)) " arguments")
        ok (= 3 (argc form))
        _ (req! ok msg "kotoba.error/if-arity" form)
        none (form/nil-form)
        test (a form 0)
        then (a form 1)
        else (a form 2)
        r1 (ie-elab ctx test none locals sigs used)
        u1 (el-used r1)
        r2 (ie-elab ctx then expected locals sigs u1)
        u2 (el-used r2)
        r3 (ie-elab ctx else expected locals sigs u2)
        call (form/call3 "if" (el-form r1) (el-form r2) (el-form r3))]
    (el-r (preserve-form-meta form call) (el-used r3))))
   :default nil)

#?(:kotoba
(defn- el-do [ctx [:ref :ie/ctx] form [:ref :form/r] expected [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] used [:ref :form/r]] [:ref :form/r]
  (let [none (form/nil-form)
        r (el-args ctx form 1 2 expected none locals sigs used (form/no-forms))]
    (el-call-of form r)))
   :default nil)

#?(:kotoba
(defn- el-option-match [ctx [:ref :ie/ctx] form [:ref :form/r] expected [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] used [:ref :form/r]] [:ref :form/r]
  (let [mtype (a form 0)
        value (a form 1)
        none-body (a form 2)
        some-name (a form 3)
        some-body (a form 4)
        rv (ie-elab ctx value mtype locals sigs used)
        u1 (el-used rv)
        rn (ie-elab ctx none-body expected locals sigs u1)
        u2 (el-used rn)
        inner (form/assoc-form locals some-name (form/nth-of mtype 1))
        rs (ie-elab ctx some-body expected inner sigs u2)
        call (form/call5 "option-match" mtype (el-form rv) (el-form rn) some-name (el-form rs))]
    (el-r (preserve-form-meta form call) (el-used rs))))
   :default nil)

#?(:kotoba
(defn- el-result-match [ctx [:ref :ie/ctx] form [:ref :form/r] expected [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] used [:ref :form/r]] [:ref :form/r]
  (let [mtype (a form 0)
        value (a form 1)
        ok-name (a form 2)
        ok-body (a form 3)
        err-name (a form 4)
        err-body (a form 5)
        rv (ie-elab ctx value mtype locals sigs used)
        u1 (el-used rv)
        ok-locals (form/assoc-form locals ok-name (form/nth-of mtype 1))
        ro (ie-elab ctx ok-body expected ok-locals sigs u1)
        u2 (el-used ro)
        err-locals (form/assoc-form locals err-name (form/nth-of mtype 2))
        re (ie-elab ctx err-body expected err-locals sigs u2)
        call (form/call6 "result-match-of" mtype (el-form rv) ok-name (el-form ro) err-name (el-form re))]
    (el-r (preserve-form-meta form call) (el-used re))))
   :default nil)

;; (into {} (nth mtype 2)): tag -> payload mtype
#?(:kotoba
(defn- el-payloads [entries [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of entries))
    acc
    (let [entry (form/nth-of entries i)]
      (el-payloads entries (+ i 1) (form/assoc-form acc (form/nth-of entry 0) (form/nth-of entry 1))))))
   :default nil)

#?(:kotoba
(defn- el-variant-branches [ctx [:ref :ie/ctx] branches [:ref :form/r] i :i64 payloads [:ref :form/r] expected [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] used [:ref :form/r] acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of branches))
    (el-r (form/form-vec acc) used)
    (let [br (form/nth-of branches i)
          tag (form/nth-of br 0)
          binder (form/nth-of br 1)
          body (form/nth-of br 2)
          inner (form/assoc-form locals binder (form/form-get payloads tag))
          r (ie-elab ctx body expected inner sigs used)
          used2 (el-used r)
          acc2 (form/append-form acc (form/vec3 tag binder (el-form r)))]
      (el-variant-branches ctx branches (+ i 1) payloads expected locals sigs used2 acc2))))
   :default nil)

#?(:kotoba
(defn- el-variant-match [ctx [:ref :ie/ctx] form [:ref :form/r] expected [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] used [:ref :form/r]] [:ref :form/r]
  (let [mtype (a form 0)
        value (a form 1)
        branches (a form 2)
        entries (form/nth-of mtype 2)
        none-map (empty-fmap)
        payloads (el-payloads entries 0 none-map)
        rv (ie-elab ctx value mtype locals sigs used)
        u1 (el-used rv)
        rb (el-variant-branches ctx branches 0 payloads expected locals sigs u1 (form/no-forms))
        call (form/call3 "variant-match" mtype (el-form rv) (el-form rb))]
    (el-r (preserve-form-meta form call) (el-used rb))))
   :default nil)

#?(:kotoba
(defn- el-typed-cap-call [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] used [:ref :form/r]] [:ref :form/r]
  (let [request (a form 3)
        request-type (a form 1)
        r (ie-elab ctx request request-type locals sigs used)
        call (form/call4 "typed-cap-call" (a form 0) request-type (a form 2) (el-form r))]
    (el-r (preserve-form-meta form call) (el-used r))))
   :default nil)

#?(:kotoba
(defn- el-sig-call [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] used [:ref :form/r]] [:ref :form/r]
  (let [op (form/nth-of form 0)
        sig (form/form-get sigs op)
        want (form/count-of (fget sig :params))
        got (argc form)
        ptypes (fget sig :param-types)
        none (form/nil-form)
        _ (el-arity! op want got form)
        r (el-args ctx form 1 1 none ptypes locals sigs used (form/no-forms))]
    (el-call-of form r)))
   :default nil)

#?(:kotoba
(defn- el-plain-call [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] used [:ref :form/r]] [:ref :form/r]
  (let [none (form/nil-form)
        r (el-args ctx form 1 0 none none locals sigs used (form/no-forms))]
    (el-call-of form r)))
   :default nil)

#?(:kotoba
(defn- ie-elab-seq [ctx [:ref :ie/ctx] form [:ref :form/r] expected [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] used [:ref :form/r]] [:ref :form/r]
  (let [op (form/nth-of form 0)]
    (cond
      (ie-tbl-has? ctx :source-operation-registry op) (el-source-op ctx form expected locals sigs used)
      (sym-is? op "let") (el-let ctx form expected locals sigs used)
      (sym-is? op "if") (el-if ctx form expected locals sigs used)
      (sym-is? op "do") (el-do ctx form expected locals sigs used)
      (sym-is? op "option-match") (el-option-match ctx form expected locals sigs used)
      (sym-is? op "result-match-of") (el-result-match ctx form expected locals sigs used)
      (sym-is? op "variant-match") (el-variant-match ctx form expected locals sigs used)
      (sym-is? op "typed-cap-call") (el-typed-cap-call ctx form locals sigs used)
      (form/form-has? sigs op) (el-sig-call ctx form locals sigs used)
      :else (el-plain-call ctx form locals sigs used))))
   :default nil)

;; Lower a friendly qualified operation such as `(http/post request)` after parameter and result types are known.
;; Answers [form' used'].
#?(:kotoba
(defn- ie-elab [ctx [:ref :ie/ctx] form [:ref :form/r] expected [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] used [:ref :form/r]] [:ref :form/r]
  (if (form/is-seq? form)
    (ie-elab-seq ctx form expected locals sigs used)
    (el-r form used)))
   :default nil)

#?(:kotoba
(defn- el-functions [functions [:ref :form/r] i :i64 ctx [:ref :ie/ctx] sigs [:ref :form/r] used [:ref :form/r] acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of functions))
    (el-r (form/form-vec acc) used)
    (let [f (form/nth-of functions i)
          body (fget f :body)
          result (fget f :result)
          params (fget f :params)
          ptypes (fget f :param-types)
          locals (zip-locals params ptypes)
          r (ie-elab ctx body result locals sigs used)
          used2 (el-used r)
          f2 (fput f :body (el-form r))
          acc2 (form/append-form acc f2)]
      (el-functions functions (+ i 1) ctx sigs used2 acc2))))
   :default nil)

;; {:functions [...] :used #{...}}
#?(:kotoba
(defn elaborate-named-abilities [ctx [:ref :ie/ctx] functions [:ref :form/r]] [:ref :form/r]
  (let [sigs (abort-signatures functions)
        r (el-functions functions 0 ctx sigs (form/form-set (form/no-forms)) (form/no-forms))]
    (form/form-map (tput (tput (form/no-forms) :functions (el-form r)) :used (el-used r)))))
   :default nil)

;; ── Kotoba route: the loop-helper result and recur-type passes (ported from the host forms above) ──
;; ---- loop/recur accumulator types (ADR 0027) ----
#?(:kotoba
(defn- map1 [k [:ref :form/r] v [:ref :form/r]] [:ref :form/r]
  (form/form-map (form/append-form (form/append-form (form/no-forms) k) v)))
   :default nil)

;; The symbol a self-call stands in as while a loop-helper's exits are typed.
#?(:kotoba
(defn- loop-recur-marker [] [:ref :form/r]
  (form/symbol-form "__kotoba_recur_position__"))
   :default nil)

#?(:kotoba
(defn- loop-unknown-form [] [:ref :form/r]
  (form/keyword-form :kotoba.loop/unknown))
   :default nil)

#?(:kotoba
(defn- replace-loop-self-calls-kids [form [:ref :form/r] helper-name [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of form))
    acc
    (let [kid (replace-loop-self-calls (form/nth-of form i) helper-name)]
      (replace-loop-self-calls-kids form helper-name (+ i 1) (form/append-form acc kid)))))
   :default nil)

;; FORM with every call to HELPER-NAME replaced by the marker
#?(:kotoba
(defn- replace-loop-self-calls [form [:ref :form/r] helper-name [:ref :form/r]] [:ref :form/r]
  (cond
    (and (form/is-seq? form) (form/eq helper-name (form/nth-of form 0))) (loop-recur-marker)
    (form/is-seq? form)
    (let [kids (replace-loop-self-calls-kids form helper-name 0 (form/no-forms))]
      (preserve-form-meta form (form/form-seq kids)))
    (form/is-vec? form) (form/form-vec (replace-loop-self-calls-kids form helper-name 0 (form/no-forms)))
    :else form))
   :default nil)

#?(:kotoba
(defn- loop-exit-pair [form [:ref :form/r] locals [:ref :form/r]] [:list [:ref :form/r]]
  (form/one-form (form/vec2 form locals)))
   :default nil)

;; the locals after the bindings of a `let`, each typed in the locals before it (a refused binding refuses)
#?(:kotoba
(defn- loop-let-locals [ctx [:ref :ie/ctx] bindings [:ref :form/r] i :i64 current [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (if (< (+ i 1) (form/count-of bindings))
    (let [name (form/nth-of bindings i)
          value (form/nth-of bindings (+ i 1))
          t (ie-type-of ctx value current sigs)
          next-locals (form/assoc-form current name t)]
      (loop-let-locals ctx bindings (+ i 2) next-locals sigs))
    current))
   :default nil)

;; The tail exits of a marked loop-helper body, as `[form locals]` pairs (a marker in tail position is a `recur`)
#?(:kotoba
(defn- loop-exit-forms [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:list [:ref :form/r]]
  (cond
    (form/eq form (loop-recur-marker)) (form/no-forms)
    (form/is-seq? form) (loop-exit-seq ctx form locals sigs)
    :else (loop-exit-pair form locals)))
   :default nil)

#?(:kotoba
(defn- loop-exit-seq [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:list [:ref :form/r]]
  (let [op (form/nth-of form 0)
        n (argc form)]
    (cond
      (and (sym-is? op "if") (= 3 n))
      (let [then (a form 1)
            else (a form 2)
            xs (loop-exit-forms ctx then locals sigs)
            ys (loop-exit-forms ctx else locals sigs)]
        (form/append-many xs ys))
      (and (sym-is? op "do") (> n 0))
      (let [last-form (form/last-of form)]
        (loop-exit-forms ctx last-form locals sigs))
      (and (sym-is? op "let") (form/is-vec? (a form 0)) (= 2 n) (= 0 (rem (form/count-of (a form 0)) 2)))
      (let [bindings (a form 0)
            body (a form 1)
            inner (loop-let-locals ctx bindings 0 locals sigs)]
        (loop-exit-forms ctx body inner sigs))
      :else (loop-exit-pair form locals))))
   :default nil)

;; A tail exit named short enough to read in a one-line refusal.
#?(:kotoba
(defn- loop-exit-text [form [:ref :form/r]] :string
  (let [text (pr-form form)]
    (if (> (string-length text) 48)
      (str (string-substring text 0 45) "...")
      text)))
   :default nil)

;; the typed exits `[form type]`, an exit that always aborts dropped
#?(:kotoba
(defn- loop-typed-exits [ctx [:ref :ie/ctx] exits [:list [:ref :form/r]] i :i64 sigs [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (vector-count exits))
    acc
    (let [e (fl-nth exits i)
          f (form/nth-of e 0)
          fl (form/nth-of e 1)
          t (ie-type-of ctx f fl sigs)
          acc2 (if (form/eq t (abort-bottom-form)) acc (form/append-form acc (form/vec2 f t)))]
      (loop-typed-exits ctx exits (+ i 1) sigs acc2))))
   :default nil)

;; the entries of TYPED whose type is an absence kind (WANT true) or is not (WANT false)
#?(:kotoba
(defn- loop-filter-absence [typed [:list [:ref :form/r]] i :i64 want :bool acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (vector-count typed))
    acc
    (let [e (fl-nth typed i)
          hit (absence-kind? (form/nth-of e 1))
          keep (if want hit (not hit))]
      (loop-filter-absence typed (+ i 1) want (if keep (form/append-form acc e) acc)))))
   :default nil)

#?(:kotoba
(defn- loop-has-kind? [entries [:list [:ref :form/r]] i :i64 kind [:ref :form/r]] :bool
  (if (>= i (vector-count entries))
    false
    (if (form/eq (form/nth-of (fl-nth entries i) 1) kind)
      true
      (loop-has-kind? entries (+ i 1) kind))))
   :default nil)

#?(:kotoba
(defn- loop-absence-mode [absent [:list [:ref :form/r]]] [:ref :form/r]
  (cond
    (loop-has-kind? absent 0 (nil-kind-form)) (tk :nil)
    (loop-has-kind? absent 0 (none-kind-form)) (tk :none)
    :else (tk :legacy)))
   :default nil)

;; the type the non-absent exits agree on (a value of T beside [:option T] is the present answer)
#?(:kotoba
(defn- loop-present-type [typed [:list [:ref :form/r]] i :i64 joined [:ref :form/r]] [:ref :form/r]
  (if (>= i (vector-count typed))
    joined
    (let [t (form/nth-of (fl-nth typed i) 1)
          lenient (lenient-branch-join joined t)
          next-joined (cond
                        (form/is-nil? joined) t
                        (same-expression-type? t joined) joined
                        (ftruthy? lenient) lenient
                        :else joined)]
      (loop-present-type typed (+ i 1) next-joined))))
   :default nil)

#?(:kotoba
(defn- loop-agrees? [t [:ref :form/r] first-type [:ref :form/r] has-absent :bool] :bool
  (or (same-expression-type? t first-type)
      (and has-absent
           (or (form/eq (option-of t) first-type)
               (and (option-vector-type? first-type) (form/eq (form/nth-of first-type 1) t))))))
   :default nil)

;; the first entry of TYPED that does not agree with FIRST-TYPE, or nil
#?(:kotoba
(defn- loop-disagreeing [typed [:list [:ref :form/r]] i :i64 first-type [:ref :form/r] has-absent :bool] [:ref :form/r]
  (if (>= i (vector-count typed))
    (form/nil-form)
    (let [e (fl-nth typed i)]
      (if (loop-agrees? (form/nth-of e 1) first-type has-absent)
        (loop-disagreeing typed (+ i 1) first-type has-absent)
        e))))
   :default nil)

#?(:kotoba
(defn- loop-exit-error [first-type [:ref :form/r] typed [:list [:ref :form/r]] disagreeing [:ref :form/r]] [:ref :fe/err]
  (let [fexit (form/nth-of (fl-nth typed 0) 0)
        dform (form/nth-of disagreeing 0)
        dtype (form/nth-of disagreeing 1)
        first-text (type-text first-type)
        fexit-text (loop-exit-text fexit)
        dtype-text (type-text dtype)
        dform-text (loop-exit-text dform)
        msg (str "loop exits with two different value types: " first-text " from " fexit-text " and " dtype-text " from " dform-text)
        data (map2 (tk :kotoba.error/expected) first-type (tk :kotoba.error/actual) dtype)]
    (fe-reject-data msg "kotoba.error/loop-exit-type" dform data)))
   :default nil)

#?(:kotoba
(defn- loop-exit-decide [ctx [:ref :ie/ctx] marked [:ref :form/r] environment [:ref :form/r] sigs [:ref :form/r] provisional [:ref :form/r] rounds :i64 typed [:list [:ref :form/r]] absent [:list [:ref :form/r]] first-type [:ref :form/r] disagreeing [:ref :form/r]] [:ref :form/r]
  (cond
    (and (= 0 (vector-count typed)) (= 0 (vector-count absent))) (form/nil-form)
    (not (form/is-nil? disagreeing)) (throw (loop-exit-error first-type typed disagreeing))
    (or (form/eq first-type provisional) (>= rounds 4)) first-type
    :else (loop-exit-round ctx marked environment sigs first-type (+ rounds 1))))
   :default nil)

;; one round of the fixed point over the marker's own binding
#?(:kotoba
(defn- loop-exit-round [ctx [:ref :ie/ctx] marked [:ref :form/r] environment [:ref :form/r] sigs [:ref :form/r] provisional [:ref :form/r] rounds :i64] [:ref :form/r]
  (let [marker (loop-recur-marker)
        locals (form/assoc-form environment marker provisional)
        exits (loop-exit-forms ctx marked locals sigs)
        typed-all (loop-typed-exits ctx exits 0 sigs (form/no-forms))
        absent (loop-filter-absence typed-all 0 true (form/no-forms))
        typed (loop-filter-absence typed-all 0 false (form/no-forms))
        has-absent (> (vector-count absent) 0)
        present-type (if has-absent (loop-present-type typed 0 (form/nil-form)) (form/nil-form))
        first-type (if has-absent
                     (absence-type present-type (loop-absence-mode absent))
                     (if (> (vector-count typed) 0) (form/nth-of (fl-nth typed 0) 1) (form/nil-form)))
        disagreeing (loop-disagreeing typed 0 first-type has-absent)]
    (loop-exit-decide ctx marked environment sigs provisional rounds typed absent first-type disagreeing)))
   :default nil)

;; The type a loop-helper leaves through, or nil when nothing here can say.
#?(:kotoba
(defn- loop-helper-exit-type [ctx [:ref :ie/ctx] helper [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (let [name (fget helper :name)
        body (fget helper :body)
        marked (replace-loop-self-calls body name)
        environment (zip-locals (fget helper :params) (fget helper :param-types))]
    (loop-exit-round ctx marked environment sigs (tk :i64) 0)))
   :default nil)

;; a refusal other than the pass's own two reads as "unknown"
#?(:kotoba
(defn- loop-recover [e [:ref :fe/err]] [:ref :form/r]
  (let [code (record-get [:ref :fe/err] e :code)]
    (if (or (string=? code "kotoba.error/loop-exit-type") (string=? code "kotoba.error/loop-result-type"))
      (throw e)
      (loop-unknown-form))))
   :default nil)

#?(:kotoba
(defn- loop-exit-type-or-unknown [ctx [:ref :ie/ctx] helper [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (try (loop-helper-exit-type ctx helper sigs)
       (catch [:ref :fe/err] e (loop-recover e))))
   :default nil)

#?(:kotoba
(defn- loop-type-invalid? [inferred [:ref :form/r]] :bool
  (try (let [_ (type-valid! inferred)] false)
       (catch [:ref :fe/err] e true)))
   :default nil)

#?(:kotoba
(defn- loop-result-error [helper [:ref :form/r] msg :string data [:ref :form/r]] [:ref :fe/err]
  (fe-reject-data msg "kotoba.error/loop-result-type" (fget helper :body) data))
   :default nil)

#?(:kotoba
(defn- loop-result-valid! [helper [:ref :form/r] inferred [:ref :form/r]] :i64
  (if (loop-type-invalid? inferred)
    (throw (loop-result-error helper
                              (str "a loop is lowered to a function and its exits have the type " (type-text inferred)
                                   ", which cannot cross a function boundary in this profile")
                              (map1 (tk :kotoba.error/actual) inferred)))
    0))
   :default nil)

#?(:kotoba
(defn- loop-result-declared! [helper [:ref :form/r] declared [:ref :form/r] inferred [:ref :form/r]] :i64
  (if (and (not (form/is-nil? declared)) (not (same-expression-type? inferred declared)))
    (throw (loop-result-error helper
                              (str "loop result was declared " (type-text declared) " and its exits have the type " (type-text inferred))
                              (map2 (tk :kotoba.error/expected) declared (tk :kotoba.error/actual) inferred)))
    0))
   :default nil)

#?(:kotoba
(defn- loop-result-checked [helper [:ref :form/r] declared [:ref :form/r] inferred [:ref :form/r]] [:ref :form/r]
  (let [_ (loop-result-valid! helper inferred)
        _ (loop-result-declared! helper declared inferred)]
    inferred))
   :default nil)

;; The result type for one loop-helper, refusing a type that cannot be one.
#?(:kotoba
(defn- loop-helper-result [ctx [:ref :ie/ctx] helper [:ref :form/r] declared [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (let [inferred (loop-exit-type-or-unknown ctx helper sigs)]
    (cond
      (form/eq inferred (loop-unknown-form)) (fget helper :result)
      (form/is-nil? inferred) (fget helper :result)
      :else (loop-result-checked helper declared inferred))))
   :default nil)

#?(:kotoba
(defn- loop-helper-signatures-from [fs [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of fs))
    acc
    (let [f (form/nth-of fs i)
          result (fget f :result)
          base (fn-signature f)
          shown (if (ftruthy? result) result (tk :i64))
          sig (fput base :result shown)
          name (fget f :name)]
      (loop-helper-signatures-from fs (+ i 1) (form/assoc-form acc name sig)))))
   :default nil)

#?(:kotoba
(defn- loop-helper-signatures [functions [:ref :form/r]] [:ref :form/r]
  (loop-helper-signatures-from functions 0 (empty-fmap)))
   :default nil)

#?(:kotoba
(defn- any-loop-helper? [fs [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of fs))
    false
    (if (ftruthy? (fget (form/nth-of fs i) :loop-helper?))
      true
      (any-loop-helper? fs (+ i 1)))))
   :default nil)

#?(:kotoba
(defn- loop-declared-result [shapes [:ref :form/r] name [:ref :form/r]] [:ref :form/r]
  (fget (form/form-get shapes name) :declared-result))
   :default nil)

#?(:kotoba
(defn- loop-result-of [ctx [:ref :ie/ctx] f [:ref :form/r] sigs [:ref :form/r] shapes [:ref :form/r]] [:ref :form/r]
  (let [declared (loop-declared-result shapes (fget f :name))]
    (loop-helper-result ctx f declared sigs)))
   :default nil)

#?(:kotoba
(defn- loop-result-lenient [ctx [:ref :ie/ctx] f [:ref :form/r] sigs [:ref :form/r] shapes [:ref :form/r]] [:ref :form/r]
  (try (loop-result-of ctx f sigs shapes)
       (catch [:ref :fe/err] e (fget f :result))))
   :default nil)

#?(:kotoba
(defn- loop-update-result [ctx [:ref :ie/ctx] f [:ref :form/r] strict :bool sigs [:ref :form/r] shapes [:ref :form/r]] [:ref :form/r]
  (if strict
    (let [r (loop-result-of ctx f sigs shapes)]
      (fput f :result r))
    (let [r (loop-result-lenient ctx f sigs shapes)]
      (fput f :result r))))
   :default nil)

#?(:kotoba
(defn- loop-update-function [ctx [:ref :ie/ctx] f [:ref :form/r] strict :bool sigs [:ref :form/r] shapes [:ref :form/r]] [:ref :form/r]
  (if (ftruthy? (fget f :loop-helper?))
    (loop-update-result ctx f strict sigs shapes)
    f))
   :default nil)

#?(:kotoba
(defn- loop-results-round [ctx [:ref :ie/ctx] fs [:ref :form/r] i :i64 strict :bool sigs [:ref :form/r] shapes [:ref :form/r] acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of fs))
    (form/form-vec acc)
    (let [f (form/nth-of fs i)
          g (loop-update-function ctx f strict sigs shapes)]
      (loop-results-round ctx fs (+ i 1) strict sigs shapes (form/append-form acc g)))))
   :default nil)

#?(:kotoba
(defn- loop-results-of [fs [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of fs))
    (form/form-vec acc)
    (loop-results-of fs (+ i 1) (form/append-form acc (fget (form/nth-of fs i) :result)))))
   :default nil)

#?(:kotoba
(defn- loop-results-fixpoint [ctx [:ref :ie/ctx] fs [:ref :form/r] rounds :i64 shapes [:ref :form/r]] [:ref :form/r]
  (let [sigs (loop-helper-signatures fs)
        next-fs (loop-results-round ctx fs 0 false sigs shapes (form/no-forms))
        same (form/eq (loop-results-of next-fs 0 (form/no-forms)) (loop-results-of fs 0 (form/no-forms)))]
    (if (or same (>= rounds 4))
      (loop-results-final ctx next-fs shapes)
      (loop-results-fixpoint ctx next-fs (+ rounds 1) shapes))))
   :default nil)

#?(:kotoba
(defn- loop-results-final [ctx [:ref :ie/ctx] fs [:ref :form/r] shapes [:ref :form/r]] [:ref :form/r]
  (let [sigs (loop-helper-signatures fs)]
    (loop-results-round ctx fs 0 true sigs shapes (form/no-forms))))
   :default nil)

;; Give every synthesized loop-helper the result type its exits have (to a fixed point; the last round refuses).
#?(:kotoba
(defn infer-loop-helper-results [ctx [:ref :ie/ctx] functions [:ref :form/r] shapes [:ref :form/r]] [:ref :form/r]
  (if (any-loop-helper? functions 0)
    (loop-results-fixpoint ctx functions 0 shapes)
    functions))
   :default nil)

;; ---- check-loop-recur-argument-types! ----
#?(:kotoba
(defn- recur-infer [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (try (ie-type-of ctx form locals sigs)
       (catch [:ref :fe/err] e (loop-unknown-form))))
   :default nil)

#?(:kotoba
(defn- recur-arg-error [index :i64 name [:ref :form/r] expected [:ref :form/r] actual [:ref :form/r] argument [:ref :form/r]] [:ref :fe/err]
  (let [position (+ index 1)
        position-text (string-from-i64 position)
        name-text (form-text name)
        expected-text (type-text expected)
        actual-text (type-text actual)
        msg (str "recur argument " position-text " rebinds the loop binding `" name-text "`, which is " expected-text ", with an expression of type " actual-text)
        data (fput (fput (map2 (tk :kotoba.error/expected) expected (tk :kotoba.error/actual) actual)
                         :kotoba.error/loop-binding name)
                   :kotoba.error/loop-recur-argument (form/int-form position))]
    (fe-reject-data msg "kotoba.error/loop-recur-type" argument data)))
   :default nil)

#?(:kotoba
(defn- recur-arg-ok? [actual [:ref :form/r] expected [:ref :form/r]] :bool
  (or (form/eq actual (loop-unknown-form))
      (form/eq actual (abort-bottom-form))
      (same-expression-type? actual expected)))
   :default nil)

;; the first N arguments of a call to the helper, each against the binding it rebinds
#?(:kotoba
(defn- recur-check-args [ctx [:ref :ie/ctx] form [:ref :form/r] index :i64 names [:ref :form/r] ptypes [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] :i64
  (if (or (>= index (form/count-of names)) (>= index (argc form)))
    0
    (let [expected (form/nth-of ptypes index)
          argument (a form index)
          actual (recur-infer ctx argument locals sigs)
          ok (recur-arg-ok? actual expected)
          _ (recur-arg-ok! ok index (form/nth-of names index) expected actual argument)]
      (recur-check-args ctx form (+ index 1) names ptypes locals sigs))))
   :default nil)

#?(:kotoba
(defn- recur-arg-ok! [ok :bool index :i64 name [:ref :form/r] expected [:ref :form/r] actual [:ref :form/r] argument [:ref :form/r]] :i64
  (if ok 0 (throw (recur-arg-error index name expected actual argument))))
   :default nil)

#?(:kotoba
(defn- recur-walk-args [ctx [:ref :ie/ctx] form [:ref :form/r] i :i64 helper-name [:ref :form/r] names [:ref :form/r] ptypes [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] :i64
  (if (>= i (form/count-of form))
    0
    (let [_ (recur-walk ctx helper-name names ptypes (form/nth-of form i) locals sigs)]
      (recur-walk-args ctx form (+ i 1) helper-name names ptypes locals sigs))))
   :default nil)

;; `let` bindings: each value walked in the outer locals, then the body in the folded locals (a refused value binds unknown)
#?(:kotoba
(defn- recur-let-values [ctx [:ref :ie/ctx] bindings [:ref :form/r] i :i64 helper-name [:ref :form/r] names [:ref :form/r] ptypes [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] :i64
  (if (< (+ i 1) (form/count-of bindings))
    (let [_ (recur-walk ctx helper-name names ptypes (form/nth-of bindings (+ i 1)) locals sigs)]
      (recur-let-values ctx bindings (+ i 2) helper-name names ptypes locals sigs))
    0))
   :default nil)

#?(:kotoba
(defn- recur-let-locals [ctx [:ref :ie/ctx] bindings [:ref :form/r] i :i64 current [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (if (< (+ i 1) (form/count-of bindings))
    (let [name (form/nth-of bindings i)
          t (recur-infer ctx (form/nth-of bindings (+ i 1)) current sigs)]
      (recur-let-locals ctx bindings (+ i 2) (form/assoc-form current name t) sigs))
    current))
   :default nil)

#?(:kotoba
(defn- recur-walk-let [ctx [:ref :ie/ctx] form [:ref :form/r] helper-name [:ref :form/r] names [:ref :form/r] ptypes [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] :i64
  (let [bindings (a form 0)
        body (a form 1)
        _ (recur-let-values ctx bindings 0 helper-name names ptypes locals sigs)
        inner (recur-let-locals ctx bindings 0 locals sigs)]
    (recur-walk ctx helper-name names ptypes body inner sigs)))
   :default nil)

#?(:kotoba
(defn- recur-walk [ctx [:ref :ie/ctx] helper-name [:ref :form/r] names [:ref :form/r] ptypes [:ref :form/r] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] :i64
  (if (form/is-seq? form)
    (let [op (form/nth-of form 0)]
      (cond
        (form/eq op helper-name)
        (let [_ (recur-check-args ctx form 0 names ptypes locals sigs)]
          (recur-walk-args ctx form 1 helper-name names ptypes locals sigs))
        (and (sym-is? op "let") (form/is-vec? (a form 0)) (= 2 (argc form)) (= 0 (rem (form/count-of (a form 0)) 2)))
        (recur-walk-let ctx form helper-name names ptypes locals sigs)
        :else (recur-walk-args ctx form 1 helper-name names ptypes locals sigs)))
    0))
   :default nil)

#?(:kotoba
(defn- recur-check-function [ctx [:ref :ie/ctx] f [:ref :form/r] shapes [:ref :form/r] sigs [:ref :form/r]] :i64
  (let [name (fget f :name)
        bindings (fget (form/form-get shapes name) :bindings)
        n (if (form/is-int? bindings) (form/int-value bindings) 0)]
    (if (and (ftruthy? (fget f :loop-helper?)) (> n 0))
      (let [params (fget f :params)
            names (form/form-vec (fl-slice (form/kids-of params) 0 n (form/no-forms)))
            ptypes (fget f :param-types)
            locals (zip-locals params ptypes)]
        (recur-walk ctx name names ptypes (fget f :body) locals sigs))
      0)))
   :default nil)

#?(:kotoba
(defn- recur-check-functions [ctx [:ref :ie/ctx] fs [:ref :form/r] i :i64 shapes [:ref :form/r] sigs [:ref :form/r]] :i64
  (if (>= i (form/count-of fs))
    0
    (let [_ (recur-check-function ctx (form/nth-of fs i) shapes sigs)]
      (recur-check-functions ctx fs (+ i 1) shapes sigs))))
   :default nil)

;; A `recur` argument must have the type of the binding it rebinds. Answers FUNCTIONS.
#?(:kotoba
(defn check-loop-recur-argument-types! [ctx [:ref :ie/ctx] functions [:ref :form/r] shapes [:ref :form/r]] [:ref :form/r]
  (let [sigs (loop-helper-signatures functions)
        _ (recur-check-functions ctx functions 0 shapes sigs)]
    functions))
   :default nil)

#?(:kotoba
(defn- cs-set-empty [] [:ref :form/r]
  (form/form-set (form/no-forms)))
   :default nil)

#?(:kotoba
(defn- cs-set-has? [s [:ref :form/r] x [:ref :form/r]] :bool
  (fl-has? (form/kids-of s) x 0))
   :default nil)

#?(:kotoba
(defn- cs-set-add [s [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
  (if (fl-has? (form/kids-of s) x 0)
    s
    (form/form-set (form/append-form (form/kids-of s) x))))
   :default nil)

;; ── Kotoba route: resolve-loop-helper-param-types (the analyze.cljk host form; here because the context and the ie- passes live in this module) ──
;; ---- resolve-loop-helper-param-types (analyze.cljk) ----
;; A loop-helper has no param-type annotations: its parameters' types are the argument types of its (unique,
;; non-recursive) call site. Each round infers every function whose param types are known, with the context
;; recording (`:recording`, `:names` the unresolved helpers, `:recorded` name -> argument types); enclosing callers
;; resolve first, nested loops converge. Fixes: a refusal inside a body drops the recordings that body made before it.
#?(:kotoba
(defn- lh-names [functions [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of functions))
    acc
    (let [f (form/nth-of functions i)]
      (lh-names functions (+ i 1) (if (ftruthy? (fget f :loop-helper?)) (cs-set-add acc (fget f :name)) acc)))))
   :default nil)

#?(:kotoba
(defn- lh-unresolved [helper-names [:ref :form/r] resolved [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of helper-names))
    acc
    (let [name (form/nth-of helper-names i)]
      (lh-unresolved helper-names resolved (+ i 1) (if (form/form-has? resolved name) acc (cs-set-add acc name))))))
   :default nil)

#?(:kotoba
(defn- lh-placeholder [params [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of params))
    (form/form-vec acc)
    (lh-placeholder params (+ i 1) (form/append-form acc (tk :i64)))))
   :default nil)

;; the parameter types a function is inferred under in this round
#?(:kotoba
(defn- lh-param-types [f [:ref :form/r] helper-names [:ref :form/r] resolved [:ref :form/r]] [:ref :form/r]
  (let [name (fget f :name)
        declared (fget f :param-types)]
    (cond
      (form/form-has? resolved name) (form/form-get resolved name)
      (cs-set-has? helper-names name) (lh-placeholder (fget f :params) 0 (form/no-forms))
      (ftruthy? declared) declared
      :else (lh-placeholder (fget f :params) 0 (form/no-forms)))))
   :default nil)

#?(:kotoba
(defn- lh-round-sigs [functions [:ref :form/r] i :i64 helper-names [:ref :form/r] resolved [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of functions))
    acc
    (let [f (form/nth-of functions i)
          ptypes (lh-param-types f helper-names resolved)
          result (fget f :result)
          shown (if (ftruthy? result) result (tk :i64))
          sig (fput (fput (fput (empty-fmap) :params (fget f :params)) :param-types ptypes) :result shown)]
      (lh-round-sigs functions (+ i 1) helper-names resolved (form/assoc-form acc (fget f :name) sig)))))
   :default nil)

;; the context after inferring F's body (the recordings it made), or CTX when the body is refused
#?(:kotoba
(defn- lh-infer-body [ctx [:ref :ie/ctx] f [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/ctx]
  (try (lh-infer-body-ctx ctx f sigs)
       (catch [:ref :fe/err] e (lh-partial ctx f sigs 0 (record-get [:ref :ie/ctx] ctx :recorded)))))
   :default nil)

;; The host keeps the recordings a refused body made before it was refused (a volatile outlives the throw). Here they are
;; recovered by re-running the body with a record limit K = 0, 1, ...: a run that reaches record K+1 throws it as pending
;; (HAVE is the recordings so far), a run refused before that has exactly the recordings HAVE.
#?(:kotoba
(defn- lh-partial [ctx [:ref :ie/ctx] f [:ref :form/r] sigs [:ref :form/r] k :i64 have [:ref :form/r]] [:ref :ie/ctx]
  (let [limited (record-assoc [:ref :ie/ctx] (record-assoc [:ref :ie/ctx] ctx :rec-limit k) :rec-count 0)]
    (try (let [done (lh-infer-body-ctx limited f sigs)]
           (lh-with-recorded ctx have))
         (catch [:ref :fe/err] e (lh-partial-next ctx f sigs k have e)))))
   :default nil)

#?(:kotoba
(defn- lh-partial-next [ctx [:ref :ie/ctx] f [:ref :form/r] sigs [:ref :form/r] k :i64 have [:ref :form/r] e [:ref :fe/err]] [:ref :ie/ctx]
  (if (string=? (record-get [:ref :fe/err] e :code) "kotoba.internal/record-limit")
    (let [pending (fget (record-get [:ref :fe/err] e :data) :pending)
          next-have (form/assoc-form have (form/nth-of pending 0) (form/nth-of pending 1))]
      (lh-partial ctx f sigs (+ k 1) next-have))
    (lh-with-recorded ctx have)))
   :default nil)

#?(:kotoba
(defn- lh-with-recorded [ctx [:ref :ie/ctx] have [:ref :form/r]] [:ref :ie/ctx]
  (record-assoc [:ref :ie/ctx] ctx :recorded have))
   :default nil)

#?(:kotoba
(defn- lh-infer-body-ctx [ctx [:ref :ie/ctx] f [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/ctx]
  (let [sig (form/form-get sigs (fget f :name))
        ptypes (fget sig :param-types)
        locals (zip-locals (fget f :params) ptypes)
        body (fget f :body)
        r (ie-infer ctx body locals sigs)]
    (ie-ctx r)))
   :default nil)

#?(:kotoba
(defn- lh-round-bodies [ctx [:ref :ie/ctx] functions [:ref :form/r] i :i64 helper-names [:ref :form/r] resolved [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/ctx]
  (if (>= i (form/count-of functions))
    ctx
    (let [f (form/nth-of functions i)
          name (fget f :name)
          run (or (not (cs-set-has? helper-names name)) (form/form-has? resolved name))
          next-ctx (if run (lh-infer-body ctx f sigs) ctx)]
      (lh-round-bodies next-ctx functions (+ i 1) helper-names resolved sigs))))
   :default nil)

;; RESOLVED with every recorded name -> types merged over it
#?(:kotoba
(defn- lh-merge [resolved [:ref :form/r] recorded [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of recorded))
    resolved
    (lh-merge (form/assoc-form resolved (form/nth-of recorded i) (form/nth-of recorded (+ i 1))) recorded (+ i 2))))
   :default nil)

#?(:kotoba
(defn- lh-round [ctx [:ref :ie/ctx] functions [:ref :form/r] helper-names [:ref :form/r] resolved [:ref :form/r]] [:ref :form/r]
  (let [sigs (lh-round-sigs functions 0 helper-names resolved (empty-fmap))
        names (lh-unresolved helper-names resolved 0 (cs-set-empty))
        start (record-assoc [:ref :ie/ctx] (record-assoc [:ref :ie/ctx] (record-assoc [:ref :ie/ctx] ctx :names names) :recording true) :recorded (empty-fmap))
        end (lh-round-bodies start functions 0 helper-names resolved sigs)]
    (lh-merge resolved (record-get [:ref :ie/ctx] end :recorded) 0)))
   :default nil)

;; T4.5 map/filter/reduce overlay `:known-types` from the shapes: the source is :vector-i64 by construction
#?(:kotoba
(defn- lh-overlay [known [:ref :form/r] params [:ref :form/r] recorded [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (or (>= i (form/count-of params)) (>= i (form/count-of recorded)))
    (form/form-vec acc)
    (let [k (form/form-get known (form/nth-of params i))
          t (if (ftruthy? k) k (form/nth-of recorded i))]
      (lh-overlay known params recorded (+ i 1) (form/append-form acc t)))))
   :default nil)

#?(:kotoba
(defn- lh-final-types [f [:ref :form/r] shapes [:ref :form/r] resolved [:ref :form/r]] [:ref :form/r]
  (let [name (fget f :name)
        params (fget f :params)
        found (form/form-get resolved name)
        recorded (if (form/is-nil? found) (lh-placeholder params 0 (form/no-forms)) found)
        known (fget (form/form-get shapes name) :known-types)]
    (if (ftruthy? known)
      (lh-overlay known params recorded 0 (form/no-forms))
      recorded)))
   :default nil)

#?(:kotoba
(defn- lh-finish [functions [:ref :form/r] i :i64 helper-names [:ref :form/r] shapes [:ref :form/r] resolved [:ref :form/r] acc [:list [:ref :form/r]]] [:ref :form/r]
  (if (>= i (form/count-of functions))
    (form/form-vec acc)
    (let [f (form/nth-of functions i)
          g (if (cs-set-has? helper-names (fget f :name)) (fput f :param-types (lh-final-types f shapes resolved)) f)]
      (lh-finish functions (+ i 1) helper-names shapes resolved (form/append-form acc g)))))
   :default nil)

#?(:kotoba
(defn- lh-fixpoint [ctx [:ref :ie/ctx] functions [:ref :form/r] helper-names [:ref :form/r] shapes [:ref :form/r] resolved [:ref :form/r]] [:ref :form/r]
  (let [next-resolved (lh-round ctx functions helper-names resolved)]
    (if (or (= (form/count-of next-resolved) (form/count-of helper-names))
            (= (form/count-of next-resolved) (form/count-of resolved)))
      (lh-finish functions 0 helper-names shapes next-resolved (form/no-forms))
      (lh-fixpoint ctx functions helper-names shapes next-resolved))))
   :default nil)

;; Give every loop-helper its :param-types. Answers FUNCTIONS with them filled in.
#?(:kotoba
(defn resolve-loop-helper-param-types [ctx [:ref :ie/ctx] functions [:ref :form/r] shapes [:ref :form/r]] [:ref :form/r]
  (let [helper-names (lh-names functions 0 (cs-set-empty))]
    (if (= 0 (form/count-of helper-names))
      functions
      (lh-fixpoint ctx functions helper-names shapes (empty-fmap)))))
   :default nil)

   ))


;; --- main-only preservation forms (a7ef280 monolith), host twins only ---
;; str / sequence-first cluster: preserved verbatim (typed twins and wiring are follow-ups).
;; (*provisional-parameters* moved above infer-absent-parameter-types: the
;; host twin now binds it, and a binding form needs the var interned earlier.)

#?(:kotoba nil :default (defn str-part-type!
  "ADR 0353 floor :integer-str: a part `str` formats is a :string or an
  :i64. Anything else is refused by what it is -- there is no implicit
  printing of an aggregate, and no coercion of anything else.

  An unannotated parameter that is :i64 only provisionally is required to be
  a :string, as it was when `str` was `string-concat`: refinement reads that
  refusal and types the parameter :string. A string-building function's
  text parameter (browser.text-edit's insert-text) stays a string; an :i64
  `str` formats is one its source types -- a field, a literal, arithmetic,
  an annotated parameter."
  [type part]
  (when (and (= :i64 type) (contains? *provisional-parameters* part))
    (require-expression-type! type :string part))
  (when-not (contains? #{:string :i64} type)
    (reject! (str "str of "
                  (cond
                    (and (vector? type) (= :record (first type))) "a record"
                    (or (contains? #{:vector-i64 :vector-f64} type)
                        (and (vector? type) (contains? #{:vector :list} (first type))))
                    "a vector"
                    (or (= :option-i64 type)
                        (and (vector? type) (= :option (first type))))
                    "an option"
                    :else (pr-str type))
                  " is refused: str formats a string or an i64, and an aggregate "
                  "is not printed implicitly")
             part :kotoba.error/str-part-type))))

#?(:kotoba nil :default (defn- sequence-first-exit-type
  "ADR 0353 floor :record-list-sequence: the type of an exit of a fused
  `first` search over `items`. Over a [:list T], [:option T]; over a bounded
  i64 / f64 vector the item's type. An unannotated parameter (the provisional
  :i64) is required to be the :vector-i64 its callers pass, as `nth` does;
  any other receiver is refused by name."
  [op [items] locals signatures]
  (let [value-type (infer-expression-type items locals signatures)]
    (cond
      (canonical-list-type? value-type) [:option (second value-type)]
      (= :vector-i64 value-type) :i64
      (= :vector-f64 value-type) :f64
      (= :i64 value-type) (require-expression-type! value-type :vector-i64 items)
      :else (reject! (str "first of filter / remove / reverse searches a bounded "
                          "vector or a [:list T]; got " (pr-str value-type))
                     items :kotoba.error/sequence-first-receiver)))))

;; --- list-note cluster (a7ef280 monolith), host twins only ---
;; Moved from desugar.cljk's main-only preservation forms (M11): the
;; `conj` arms of record-projection's rewrite call `note-list-item-type!`,
;; and record-projection cannot require desugar (desugar requires it).
;; The analysis state lives here with the other analyze-bound vars
;; (`*state-handlers*`, `*row-op-schemas*`), and `analyze-forms*` binds
;; `*module-list-inferred*` / `*list-item-notes*`. Preserved verbatim
;; except `^:private` / `defn-` dropped on the names other modules now
;; refer (as `list-field-read-key` already was in desugar).

#?(:kotoba nil :default (def ^:dynamic *list-item-notes* nil))

#?(:kotoba nil :default (def ^:dynamic *module-list-fields* {}))

#?(:kotoba nil :default (def ^:dynamic *module-list-inferred* {}))

#?(:kotoba nil :default (defn list-field-read-key
  "The keyword key RECEIVER reads, `(record-get m k)` / `(get m k)` / `(k m)`,
  or nil."
  [receiver]
  (when (seq? receiver)
    (let [[op & args] receiver]
      (cond
        (and (contains? '#{record-get get} op) (keyword? (last args))) (last args)
        (and (keyword? op) (= 1 (count args))) op
        :else nil)))))

#?(:kotoba nil :default (defn note-list-item-type!
  "floor :list-item-from-expression: an item of type T is conj'd onto the field
  RECEIVER reads. Noted when that is an open `[]` key and T is known and not
  `:i64`. Floor :record-list-field-literal: onto a record-lists key T is
  noted, and where its list is known to be LIST-TYPE `[:list R]`, R before
  it, so a T /= R is a second type at the key (`:record-conflicts`)."
  ([receiver t] (note-list-item-type! receiver t nil))
  ([receiver t list-type]
   (when-let [notes *list-item-notes*]
     (when-let [k (list-field-read-key receiver)]
       (when (and (some? t) (not= :i64 t))
         (cond
           (contains? (:open *module-list-fields*) k)
           (vswap! notes conj [k t])

           (contains? (:record-lists *module-list-fields*) k)
           (if (canonical-list-type? list-type)
             (vswap! notes conj [k (second list-type)] [k t])
             (vswap! notes conj [k t])))))))))
