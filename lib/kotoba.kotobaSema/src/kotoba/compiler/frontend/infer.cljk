#?(:kotoba
(defn ie-spec-expect [ctx [:ref :ie/ctx] form [:ref :form/r] types [:ref :form/r] i :i64 locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/ctx]
  (if (>= i (form/count-of types))
    ctx
    (let [c1 (ie-expect ctx (a form i) (form/nth-of types i) locals sigs)]
