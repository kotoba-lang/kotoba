#?(:kotoba
(defn ie-new-ctx [schemas [:ref :form/r] row-schemas [:ref :form/r] handlers [:ref :form/r]] [:ref :ie/ctx]
  (record-new [:ref :ie/ctx] schemas row-schemas handlers false false (form/nil-form) false (form/nil-form)
              false (form/no-forms) (form/nil-form) (ie-tables) (- 0 1) 0))
   :default nil)

#?(:kotoba
(defn call-form [op [:ref :form/r] args [:ref :form/r]] [:ref :form/r]
  (form/form-seq (form/cons-onto op (form/kids-of args))))
   :default nil)

#?(:kotoba
(defn type-valid! [type [:ref :form/r]] :i64
  (let [r (vt/validate-type type 0 0)]
    (if (vt/outcome-ok? r)
      (vt/outcome-nodes r)
      (throw (fe-reject (vt/outcome-msg r) (vt/outcome-code r) type)))))
   :default nil)

#?(:kotoba
(defn ie-infer-t [ctx [:ref :ie/ctx] tail :bool form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [r (ie-infer (ctx-tail ctx tail) form locals sigs)]
    (ie-r (ie-type r) (ctx-tail (ie-ctx r) (ctx-tail? ctx)))))
   :default nil)

#?(:kotoba
(defn ie-expect [ctx [:ref :ie/ctx] x [:ref :form/r] expected [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/ctx]
  (let [r (ie-infer ctx x locals sigs)
        _ (require-expression-type! (ie-type r) expected x)]
    (ie-ctx r)))
   :default nil)

#?(:kotoba
(defn ie-infer-args [ctx [:ref :ie/ctx] args [:ref :form/r] i :i64 locals [:ref :form/r] sigs [:ref :form/r] acc [:list [:ref :form/r]]] [:ref :ie/r]
  (if (>= i (form/count-of args))
    (ie-r (form/form-vec acc) ctx)
    (let [r (ie-infer ctx (form/nth-of args i) locals sigs)]
      (ie-infer-args (ie-ctx r) args (+ i 1) locals sigs (form/append-form acc (ie-type r))))))
   :default nil)

#?(:kotoba
(defn vec-of [rest-from [:ref :form/r]] [:ref :form/r]
  (form/form-vec (form/rest-list rest-from)))
   :default nil)

#?(:kotoba
(defn use-site-kids [f [:ref :form/r] i :i64 acc :string] :string
  (if (>= i (form/count-of f))
    acc
    (use-site-kids f (+ i 1) (str acc (if (> i 0) " " "") (use-site-text (form/nth-of f i))))))
   :default nil)

#?(:kotoba
(defn form-text-any [f [:ref :form/r]] :string
  (if (form/is-int? f) (string-from-i64 (form/int-value f)) (form/symbol-value f)))
   :default nil)

#?(:kotoba
(defn use-site-text [form [:ref :form/r]] :string
  (cond
    (form/is-seq? form)
    (let [head (form/nth-of form 0)
          src (fsource-head form)
          shown (if (string=? src "") (use-site-text head) src)]
      ;; `use-site-kids` puts the separator BEFORE each kid it prints, so none is added here
      (str "(" shown (use-site-kids form 1 "") ")"))
    (form/is-vec? form) (str "[" (use-site-kids form 0 "") "]")
    (or (form/is-int? form) (form/is-symbol? form)) (form-text-any form)
    :else (pr-form form)))
   :default
(defn use-site-text
  "FORM as a diagnostic shows it: the head the source wrote when the lowering
  table renamed it (`:kotoba.diag/source-head`, see `desugar-expr`), integers
  through `str` so a ClojureScript BigInt prints as its digits, everything
  else as `pr-str` would."
  [form]
  (cond
    (seq? form)
    (let [head (first form)
          shown (or (:kotoba.diag/source-head (meta head)) head)]
      (str "(" (str/join " " (map use-site-text (cons shown (rest form)))) ")"))
    (vector? form) (str "[" (str/join " " (map use-site-text form)) "]")
    (kotoba-integer? form) (str form)
    (symbol? form) (str form)
    :else (pr-str form))))

#?(:kotoba
(defn row-op-field-missing! [op :string type [:ref :form/r] fields [:ref :form/r] key [:ref :form/r] form [:ref :form/r] schemas [:ref :form/r] row-schemas [:ref :form/r]] :i64
  (if (ftruthy? (row-op-field-type fields key 0))
    0
    (throw (fe-reject-data (str op " names field " (form-text key) ", which record "
                                (form-text (row-op-name type schemas row-schemas))
                                " does not have: a row shrinks only by fields it has")
                           "kotoba.error/row-field-missing" form
                           (map2 (form/keyword-form :kotoba.error/field) key (form/keyword-form :kotoba.error/actual) type)))))
   :default nil)

#?(:kotoba
(defn row-op-literal-keys? [f [:ref :form/r] i :i64] :bool
  (if (>= i (form/count-of f))
    true
    (and (form/is-keyword? (form/nth-of f i)) (row-op-literal-keys? f (+ i 2)))))
   :default nil)

#?(:kotoba
(defn row-op-literal-pairs [f [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= (+ i 1) (form/count-of f))
    acc
    (row-op-literal-pairs f (+ i 2) (form/append-form acc (form/vec2 (form/nth-of f i) (form/nth-of f (+ i 1)))))))
   :default nil)

#?(:kotoba
(defn row-op-keep? [field [:ref :form/r] keys [:ref :form/r]] :bool
  (fl-has? (form/kids-of keys) (form/nth-of field 0) 0))
   :default nil)

#?(:kotoba
(defn row-op-filter [fields [:ref :form/r] keys [:ref :form/r] keep :bool i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of fields))
    acc
    (let [field (form/nth-of fields i)
          hit (row-op-keep? field keys)]
      (row-op-filter fields keys keep (+ i 1) (if (= hit keep) (form/append-form acc field) acc)))))
   :default nil)

#?(:kotoba
(defn row-op-fields-each! [op :string receiver-type [:ref :form/r] fields [:ref :form/r] ks [:ref :form/r] i :i64 form [:ref :form/r] schemas [:ref :form/r] row-schemas [:ref :form/r]] :i64
  (if (>= i (form/count-of ks))
    0
    (let [_ (row-op-field! op receiver-type fields (form/nth-of ks i) form schemas row-schemas)]
      (row-op-fields-each! op receiver-type fields ks (+ i 1) form schemas row-schemas))))
   :default nil)

#?(:kotoba
(defn row-op-nonempty! [op :string receiver-type [:ref :form/r] kept [:list [:ref :form/r]] form [:ref :form/r] schemas [:ref :form/r] row-schemas [:ref :form/r]] :i64
  (if (> (vector-count kept) 0)
    0
    (throw (fe-reject (str op " leaves record " (form-text (row-op-name receiver-type schemas row-schemas))
                           " with no field, and a record has at least one")
                      "kotoba.error/row-operation-shape" form))))
   :default nil)

#?(:kotoba
(defn row-op-assoc-entries! [receiver-type [:ref :form/r] args [:ref :form/r] types [:ref :form/r] i :i64 form [:ref :form/r] schemas [:ref :form/r] row-schemas [:ref :form/r] fields [:ref :form/r]] [:ref :form/r]
  (if (>= (+ i 1) (form/count-of args))
    fields
    (let [key (form/nth-of args i)
          value (form/nth-of args (+ i 1))
          value-type (form/nth-of types (+ i 1))
          _ (row-op-key! "assoc" receiver-type key form schemas row-schemas)
          one (form/vec3 key value-type value)
          next-fields (row-op-assoc-fields fields (form/form-vec (form/one-form one)) 0)]
      (row-op-assoc-entries! receiver-type args types (+ i 2) form schemas row-schemas next-fields))))
   :default nil)

#?(:kotoba
(defn row-op-merge-record! [receiver-type [:ref :form/r] arg [:ref :form/r] type [:ref :form/r] form [:ref :form/r] schemas [:ref :form/r] row-schemas [:ref :form/r]] [:ref :form/r]
  (throw (fe-reject-data (str "merge onto record " (form-text (row-op-name receiver-type schemas row-schemas))
                              " takes records and keyword-keyed map literals; "
                              (use-site-text arg) " is " (type-text type))
                         "kotoba.error/row-operation-shape" form
                         (form/form-map (form/append-form (form/append-form (form/no-forms) (form/keyword-form :kotoba.error/actual)) type)))))
   :default nil)

#?(:kotoba
(defn row-op-record-entries [rec-fields [:ref :form/r] arg [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of rec-fields))
    acc
    (let [pair (form/nth-of rec-fields i)]
      (row-op-record-entries rec-fields arg (+ i 1) (form/append-form acc (form/vec3 (form/nth-of pair 0) (form/nth-of pair 1) arg))))))
   :default nil)

#?(:kotoba
(defn row-op-literal-fields [ctx [:ref :ie/ctx] entries [:ref :form/r] i :i64 locals [:ref :form/r] sigs [:ref :form/r] fields [:ref :form/r]] [:ref :ie/r]
  (if (>= i (form/count-of entries))
    (ie-r fields ctx)
    (let [entry (form/nth-of entries i)
          r (ie-infer ctx (form/nth-of entry 1) locals sigs)
          next-fields (row-op-assoc-fields fields (form/form-vec (form/one-form (form/vec3 (form/nth-of entry 0) (ie-type r) (form/nth-of entry 1)))) 0)]
      (row-op-literal-fields (ie-ctx r) entries (+ i 1) locals sigs next-fields))))
   :default nil)

#?(:kotoba
(defn row-op-merge-args [ctx [:ref :ie/ctx] receiver-type [:ref :form/r] args [:ref :form/r] types [:ref :form/r] i :i64 locals [:ref :form/r] sigs [:ref :form/r] form [:ref :form/r] fields [:ref :form/r]] [:ref :ie/r]
  (if (>= i (form/count-of args))
    (ie-r fields ctx)
    (let [arg (form/nth-of args i)
          type (form/nth-of types i)
          entries (row-op-literal-entries arg)
          record (row-op-record type (ctx-schemas ctx) (ctx-row-schemas ctx))]
      (if (ftruthy? entries)
        (let [r (row-op-literal-fields ctx entries 0 locals sigs fields)]
          (row-op-merge-args (ie-ctx r) receiver-type args types (+ i 1) locals sigs form (ie-type r)))
        (if (ftruthy? record)
          (row-op-merge-args ctx receiver-type args types (+ i 1) locals sigs form
                             (row-op-assoc-fields fields (form/form-vec (row-op-record-entries (form/nth-of record 2) arg 0 (form/no-forms))) 0))
          (let [_ (row-op-merge-record! receiver-type arg type form (ctx-schemas ctx) (ctx-row-schemas ctx))]
            (ie-r fields ctx)))))))
   :default nil)

#?(:kotoba
(defn insert-by-key-text [xs [:list [:ref :form/r]] x [:ref :form/r] i :i64] [:list [:ref :form/r]]
  (if (>= i (vector-count xs))
    (form/append-form xs x)
    (if (> (string-compare (form-text (form/nth-of (fl-nth xs i) 0)) (form-text (form/nth-of x 0))) 0)
      (fl-slice xs i (vector-count xs) (form/append-form (fl-slice xs 0 i (form/no-forms)) x))
      (insert-by-key-text xs x (+ i 1)))))
   :default nil)

#?(:kotoba
(defn sort-by-key-text [fields [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of fields))
    acc
    (sort-by-key-text fields (+ i 1) (insert-by-key-text acc (form/nth-of fields i) 0))))
   :default nil)

#?(:kotoba
(defn spec-key-op? [c [:ref :ie/ctx] run :i64 op [:ref :form/r]] :bool
  (and (form/is-symbol? op) (form/form-has? (form/nth-of (form/form-get (ctx-tbl c) (form/keyword-form :specs)) run) op)))
   :default nil)

#?(:kotoba
(defn spec-all! [from :i64 expected [:ref :form/r] args [:ref :form/r] types [:ref :form/r] i :i64] :i64
  (if (or (>= i (form/count-of args)) (>= i (form/count-of types)))
    0
    (let [_ (if (>= i from)
              (require-expression-type! (form/nth-of types i) expected (form/nth-of args i))
              0)]
      (spec-all! from expected args types (+ i 1)))))
   :default nil)

#?(:kotoba
(defn spec-checks! [checks [:ref :form/r] i :i64 args [:ref :form/r] types [:ref :form/r]] :i64
  (if (>= i (form/count-of checks))
    0
    (let [check (form/nth-of checks i)
          _ (if (form/is-keyword? (form/nth-of check 0))
              (spec-all! (form/int-value (form/nth-of check 1)) (form/nth-of check 2) args types 0)
              (require-expression-type! (form/nth-of types (form/int-value (form/nth-of check 0)))
                                        (form/nth-of check 1)
                                        (form/nth-of args (form/int-value (form/nth-of check 0)))))]
      (spec-checks! checks (+ i 1) args types))))
   :default nil)

#?(:kotoba
(defn ie-call-spec [c [:ref :ie/ctx] run :i64 op [:ref :form/r] args [:ref :form/r] types [:ref :form/r]] [:ref :ie/r]
  (let [entry (form/form-get (form/nth-of (form/form-get (ctx-tbl c) (form/keyword-form :specs)) run) op)
        _ (spec-checks! (form/nth-of entry 0) 0 args types)]
    (ie-r (form/nth-of entry 1) c)))
   :default nil)

#?(:kotoba
(defn all-i64! [args [:ref :form/r] types [:ref :form/r]] :i64
  (spec-all! 0 (tk :i64) args types 0))
   :default nil)

#?(:kotoba
(defn ie-call-arith [c [:ref :ie/ctx] op [:ref :form/r] args [:ref :form/r] types [:ref :form/r]] [:ref :ie/r]
  (if (or (sym-is? op "+") (sym-is? op "-") (sym-is? op "*"))
    (let [t (numeric-operand-type! op args types (ctx-final? c))]
      (ie-r t c))
    (let [_ (all-i64! args types)]
      (ie-r (tk :i64) c))))
   :default nil)

#?(:kotoba
(defn fdiv-check! [t [:ref :form/r] op [:ref :form/r] args [:ref :form/r]] :i64
  (if (ty? t :i64)
    (throw (fe-reject "/ has no i64 reading -- integer division is quot; / resolves to f64-div or f32-div by operand type"
                      "kotoba.error/numeric-type-mismatch" (call-form op args)))
    0))
   :default nil)

#?(:kotoba
(defn ie-call-fdiv [c [:ref :ie/ctx] op [:ref :form/r] args [:ref :form/r] types [:ref :form/r]] [:ref :ie/r]
  (let [t (numeric-operand-type! op args types (ctx-final? c))
        _ (fdiv-check! t op args)]
    (ie-r t c)))
   :default nil)

#?(:kotoba
(defn ie-call-all-i64 [c [:ref :ie/ctx] args [:ref :form/r] types [:ref :form/r]] [:ref :ie/r]
  (let [_ (all-i64! args types)]
    (ie-r (tk :i64) c)))
   :default nil)

#?(:kotoba
(defn float-in-types? [types [:ref :form/r]] :bool
  (not (form/is-nil? (first-float-type types 0))))
   :default nil)

#?(:kotoba
(defn eq-same-type! [args [:ref :form/r] types [:ref :form/r]] :i64
  (if (form/eq (form/nth-of types 0) (form/nth-of types 1))
    0
    (throw (fe-reject "equality operands must have the same value type" "kotoba.error/subset-reject" args))))
   :default nil)

#?(:kotoba
(defn eq-safe-profile! [args [:ref :form/r] types [:ref :form/r]] :i64
  (let [t0 (form/nth-of types 0)]
    (if (or (ty? t0 :i64) (ty? t0 :keyword) (ty? t0 :bool) (ty? t0 :option-i64) (ty? t0 :result-i64)
            (ty? t0 :vector-i64) (ty? t0 :string) (parametric-result-type? t0))
      0
      (throw (fe-reject (str "equality type is outside the safe value profile"
                             (if (ty? t0 :string) " -- use string=? for string equality" ""))
                        "kotoba.error/subset-reject" args)))))
   :default nil)

#?(:kotoba
(defn ie-call-eq [c [:ref :ie/ctx] op [:ref :form/r] args [:ref :form/r] types [:ref :form/r]] [:ref :ie/r]
  (if (float-in-types? types)
    (let [_ (numeric-operand-type! op args types (ctx-final? c))]
      (ie-r (tk :bool) c))
    (let [_ (eq-same-type! args types)
          _ (eq-safe-profile! args types)]
      (ie-r (tk :bool) c))))
   :default nil)

#?(:kotoba
(defn vc-check! [t [:ref :form/r] arg [:ref :form/r]] :i64
  (if (or (ty? t :vector-i64) (canonical-list-type? t))
    0
    (require-expression-type! t (tk :vector-i64) arg)))
   :default nil)

#?(:kotoba
(defn doc-key-check! [key-type [:ref :form/r] key-form [:ref :form/r] message :string] :i64
  (if (or (ty? key-type :keyword) (ty? key-type :document))
    0
    (throw (fe-reject message "kotoba.error/subset-reject" key-form))))
   :default nil)

#?(:kotoba
(defn docmap-each! [args [:ref :form/r] types [:ref :form/r] i :i64] :i64
  (if (>= (+ i 1) (form/count-of args))
    0
    (let [_ (doc-key-check! (form/nth-of types i) (form/nth-of args i) "document-map key must be keyword or document")
          _ (require-expression-type! (form/nth-of types (+ i 1)) (tk :document) (form/nth-of args (+ i 1)))]
      (docmap-each! args types (+ i 2)))))
   :default nil)

#?(:kotoba
(defn pairs-each! [args [:ref :form/r] types [:ref :form/r] i :i64 kt [:ref :form/r] vt [:ref :form/r]] :i64
  (if (>= (+ i 1) (form/count-of args))
    0
    (let [_ (require-expression-type! (form/nth-of types i) kt (form/nth-of args i))
          _ (require-expression-type! (form/nth-of types (+ i 1)) vt (form/nth-of args (+ i 1)))]
      (pairs-each! args types (+ i 2) kt vt))))
   :default nil)

#?(:kotoba
(defn string-join-check! [args [:ref :form/r]] :i64
  (if (= 0 (form/count-of args))
    (throw (fe-reject "string-join requires a separator string" "kotoba.error/subset-reject" args))
    0))
   :default nil)

#?(:kotoba
(defn record-fields-of [descriptor [:ref :form/r]] [:ref :form/r]
  (if (and (form/is-vec? descriptor) (> (form/count-of descriptor) 0) (ty? (form/nth-of descriptor 0) :record))
    (form/nth-of descriptor 2)
    (form/nil-form)))
   :default nil)

#?(:kotoba
(defn cas-won-check! [fields [:ref :form/r] arg [:ref :form/r]] :i64
  (if (and (> (form/count-of fields) 0) (ty? (form/nth-of (form/nth-of fields 0) 1) :bool))
    0
    (throw (fe-reject "object-cas-won requires a record whose first field is bool" "kotoba.error/subset-reject" arg))))
   :default nil)

#?(:kotoba
(defn bytes-field-check! [o :string field [:ref :form/r] arg [:ref :form/r]] :i64
  (if (ty? (form/nth-of field 1) :string)
    0
    (throw (fe-reject (str o " requires a record bytes field") "kotoba.error/subset-reject" arg))))
   :default nil)

#?(:kotoba
(defn status-field-check! [fields [:ref :form/r] arg [:ref :form/r]] :i64
  (if (ty? (form/nth-of (form/nth-of fields 0) 1) :i64)
    0
    (throw (fe-reject "http-response-status requires a record status field" "kotoba.error/subset-reject" arg))))
   :default nil)

#?(:kotoba
(defn arena-scope-check! [type [:ref :form/r] op [:ref :form/r] args [:ref :form/r]] :i64
  (if (or (ty? type :i64) (ty? type :bool) (ty? type :f64))
    0
    (throw (fe-reject (str "arena-scope body must be :i64, :bool or :f64, got " (pr-form type)
                           ": a handle would escape the region it is released with")
                      "kotoba.error/arena-scope-body-not-scalar" (call-form op args)))))
   :default nil)

;; the call-site attribution on a per-argument refusal: which callee parameter the argument was
;; checked against (and which function). `refinement-of` decodes this to refine the callee's
;; unannotated parameter; the function map itself is not reachable from the call site (only `sigs` is)
#?(:kotoba
(defn call-param-refusal [error [:ref :fe/err] op [:ref :form/r] i :i64] [:ref :fe/err]
  (let [data (record-get [:ref :fe/err] error :data)
        d1 (form/assoc-form data (form/keyword-form :kotoba.error/function) op)
        d2 (form/assoc-form d1 (form/keyword-form :kotoba.error/param-index) (form/int-form i))]
    (record-assoc [:ref :fe/err] error :data d2)))
   :default nil)

#?(:kotoba
(defn signature-checks! [args [:ref :form/r] types [:ref :form/r] expected [:ref :form/r] op [:ref :form/r] inferred [:ref :form/r] i :i64] :i64
  (if (or (>= i (form/count-of args)) (>= i (form/count-of types)) (>= i (form/count-of expected)))
    0
    (let [_ (try (require-expression-type! (form/nth-of types i) (form/nth-of expected i) (form/nth-of args i))
                 (catch [:ref :fe/err] error
                   (throw (if (fl-has? (form/kids-of inferred) (form/int-form i) 0)
                            (call-param-refusal error op i)
                            error))))]
      (signature-checks! args types expected op inferred (+ i 1)))))
   :default nil)

#?(:kotoba
(defn ie-call-signature [c [:ref :ie/ctx] op [:ref :form/r] args [:ref :form/r] types [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [sig (form/form-get sigs op)
        expected (fget sig :param-types)
        result (fget sig :result)]
    (if (and (record-get [:ref :ie/ctx] c :recording) (fl-has? (form/kids-of (record-get [:ref :ie/ctx] c :names)) op 0))
      (ie-record-call c op types result)
      (let [_ (signature-checks! args types expected op (fget sig :param-types-inferred) 0)]
        (ie-r result c)))))
   :default nil)

;; Record the argument TYPES of a call to the unresolved loop-helper OP. A context with a record limit (>= 0) refuses to
;; make record number LIMIT+1 and throws, carrying the recordings so far and the pending one: the host keeps the recordings
;; made before a refusal in a volatile, and this is how `resolve-loop-helper-param-types` recovers them
#?(:kotoba
(defn ie-record-call [c [:ref :ie/ctx] op [:ref :form/r] types [:ref :form/r] result [:ref :form/r]] [:ref :ie/r]
  (let [limit (record-get [:ref :ie/ctx] c :rec-limit)
        made (record-get [:ref :ie/ctx] c :rec-count)
        recorded (record-get [:ref :ie/ctx] c :recorded)]
    (if (and (>= limit 0) (>= made limit))
      (throw (fe-reject-data "record limit" "kotoba.internal/record-limit" op
                             (fput (fput (empty-fmap) :recorded recorded) :pending (form/vec2 op types))))
      (ie-r result (record-assoc [:ref :ie/ctx]
                                 (record-assoc [:ref :ie/ctx] c :recorded (form/assoc-form recorded op types))
                                 :rec-count (+ made 1))))))
   :default nil)

#?(:kotoba
(defn conj-onto? [c [:ref :ie/ctx] op [:ref :form/r] args [:ref :form/r] types [:ref :form/r]] :bool
  (and (ie-tbl-has? c :set-operations op)
       (> (form/count-of args) 1)
       (or (and (sym-is? op "conj") (or (ty? (form/nth-of types 0) :vector-i64) (ty? (form/nth-of types 0) :vector-f64)))
           (typed-set-type? (form/nth-of types 0)))))
   :default nil)

#?(:kotoba
(defn library-head-arity! [op [:ref :form/r] args [:ref :form/r]] :i64
  (if (= 1 (form/count-of args))
    0
    (throw (fe-reject (str (form-text op) " requires exactly one operand") "kotoba.error/library-head-shape" (call-form op args)))))
   :default nil)

#?(:kotoba
(defn ie-call-library [c [:ref :ie/ctx] op [:ref :form/r] args [:ref :form/r] types [:ref :form/r]] [:ref :ie/r]
  (let [_ (library-head-arity! op args)
        _ (library-predicate-answer! op (form/nth-of types 0) (form/nth-of args 0))]
    (ie-r (tk :bool) c)))
   :default nil)

#?(:kotoba
(defn ie-call-row [c [:ref :ie/ctx] op [:ref :form/r] args [:ref :form/r] types [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [r (row-op-fields c op args types locals sigs (call-form op args))]
    (ie-r (row-op-result-type (form/nth-of types 0) (ie-type r) (ctx-schemas c) (ctx-row-schemas c)) (ie-ctx r))))
   :default nil)

#?(:kotoba
(defn ie-call-cond [c [:ref :ie/ctx] op [:ref :form/r] args [:ref :form/r] types [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (cond
    (ie-tbl-has? c :arithmetic op) (ie-call-arith c op args types)
    (ie-tbl-has? c :float-division-heads op) (ie-call-fdiv c op args types)
    (ie-tbl-has? c :i64-operations op) (ie-call-all-i64 c args types)
    (ie-tbl-has? c :i32-operations op) (ie-call-all-i64 c args types)
    (sym-is? op "=") (ie-call-eq c op args types)
    (spec-key-op? c 0 op) (ie-call-spec c 0 op args types)
    (sym-is? op "option-none") (ie-r (tk :option-i64) c)
    (spec-key-op? c 1 op) (ie-call-spec c 1 op args types)
    (sym-is? op "vector-count")
    (let [_ (vc-check! (form/nth-of types 0) (form/nth-of args 0))]
      (ie-r (tk :i64) c))
    (spec-key-op? c 2 op) (ie-call-spec c 2 op args types)
    (sym-is? op "string-index-new") (ie-r (tk :string-index) c)
    (spec-key-op? c 3 op) (ie-call-spec c 3 op args types)
    (sym-is? op "document-null") (ie-r (tk :document) c)
    (spec-key-op? c 4 op) (ie-call-spec c 4 op args types)
    (sym-is? op "document-map")
    (let [_ (docmap-each! args types 0)]
      (ie-r (tk :document) c))
    (spec-key-op? c 5 op) (ie-call-spec c 5 op args types)
    (sym-is? op "document-contains")
    (let [_ (require-expression-type! (form/nth-of types 0) (tk :document) (form/nth-of args 0))
          _ (doc-key-check! (form/nth-of types 1) (form/nth-of args 1) "document map key must be keyword or document")]
      (ie-r (tk :bool) c))
    (spec-key-op? c 6 op) (ie-call-spec c 6 op args types)
    (sym-is? op "document-get")
    (let [_ (require-expression-type! (form/nth-of types 0) (tk :document) (form/nth-of args 0))
          _ (doc-key-check! (form/nth-of types 1) (form/nth-of args 1) "document map key must be keyword or document")]
      (ie-r (option-of (tk :document)) c))
    (sym-is? op "document-assoc")
    (let [_ (require-expression-type! (form/nth-of types 0) (tk :document) (form/nth-of args 0))
          _ (doc-key-check! (form/nth-of types 1) (form/nth-of args 1) "document map key must be keyword or document")
          _ (require-expression-type! (form/nth-of types 2) (tk :document) (form/nth-of args 2))]
      (ie-r (tk :document) c))
    (sym-is? op "document-dissoc")
    (let [_ (require-expression-type! (form/nth-of types 0) (tk :document) (form/nth-of args 0))
          _ (doc-key-check! (form/nth-of types 1) (form/nth-of args 1) "document map key must be keyword or document")]
      (ie-r (tk :document) c))
    (spec-key-op? c 7 op) (ie-call-spec c 7 op args types)
    (and (ie-tbl-has? c :comparisons op) (not (sym-is? op "=")))
    (let [_ (numeric-operand-type! op args types (ctx-final? c))]
      (ie-r (tk :bool) c))
    (ie-tbl-has? c :heap-operations op) (ie-call-all-i64 c args types)
    (ie-tbl-has? c :kgraph-operations op) (ie-call-all-i64 c args types)
    (or (ie-tbl-has? c :kernel-memory-operations op) (ie-tbl-has? c :kernel-privileged-operations op)) (ie-call-all-i64 c args types)
    (ie-tbl-has? c :rodata-literal-operations op)
    (let [_ (require-expression-type! (form/nth-of types 0) (tk :string) (form/nth-of args 0))]
      (ie-r (tk :i64) c))
    (spec-key-op? c 8 op) (ie-call-spec c 8 op args types)
    (sym-is? op "string-join")
    (let [_ (string-join-check! args)
          _ (spec-all! 0 (tk :string) args types 0)]
      (ie-r (tk :string) c))
    (spec-key-op? c 9 op) (ie-call-spec c 9 op args types)
    (sym-is? op "object-cas-won")
    (let [_ (cas-won-check! (record-fields-of (form/nth-of types 0)) (form/nth-of args 0))]
      (ie-r (tk :i64) c))
    (or (sym-is? op "bytes-response-byte-count") (sym-is? op "log-read-byte-count"))
    (let [fields (record-fields-of (form/nth-of types 0))
          field (if (sym-is? op "bytes-response-byte-count") (form/nth-of fields 0) (form/nth-of fields 1))
          _ (bytes-field-check! (form-text op) field (form/nth-of args 0))]
      (ie-r (tk :i64) c))
    (spec-key-op? c 10 op) (ie-call-spec c 10 op args types)
    (sym-is? op "http-response-status")
    (let [_ (status-field-check! (record-fields-of (form/nth-of types 0)) (form/nth-of args 0))]
      (ie-r (tk :i64) c))
    (spec-key-op? c 11 op) (ie-call-spec c 11 op args types)
    (sym-is? op "arena-scope")
    (let [_ (arena-scope-check! (form/nth-of types 0) op args)]
      (ie-r (form/nth-of types 0) c))
    (spec-key-op? c 12 op) (ie-call-spec c 12 op args types)
    (sym-is? op "map-new")
    (let [_ (pairs-each! args types 0 (tk :keyword) (tk :i64))]
      (ie-r (tk :map) c))
    (spec-key-op? c 13 op) (ie-call-spec c 13 op args types)
    (and (ie-tbl-has? c :row-operation-heads op)
         (ftruthy? (row-op-record (form/nth-of types 0) (ctx-schemas c) (ctx-row-schemas c))))
    (ie-call-row c op args types locals sigs)
    (or (sym-is? op "select-keys") (sym-is? op "merge"))
    (let [_ (row-op-not-record! (form-text op) (form/nth-of args 0) (form/nth-of types 0) (call-form op args))]
      (ie-r (tk :map) c))
    (and (sym-is? op "map-assoc") (ty? (form/nth-of types 0) :document)) (ie-r (tk :document) c)
    (sym-is? op "map-assoc")
    (let [_ (require-expression-type! (form/nth-of types 0) (tk :map) (form/nth-of args 0))
          _ (pairs-each! args types 1 (tk :keyword) (tk :i64))]
      (ie-r (tk :map) c))
    (form/form-has? sigs op) (ie-call-signature c op args types sigs)
    (conj-onto? c op args types) (ie-r (form/nth-of types 0) c)
    (sym-is? op "__kotoba_document_of")
    (let [_ (document-of-constructor! c (form/nth-of types 0) (form/nth-of args 0))]
      (ie-r (tk :document) c))
    (ie-tbl-has? c :library-predicate-heads op) (ie-call-library c op args types)
    (ie-tbl-has? c :named-operation-default-results op) (ie-r (ie-tbl-get c :named-operation-default-results op) c)
    :else (throw (unknown-operation-error op op sigs))))
   :default nil)

#?(:kotoba
(defn a [form [:ref :form/r] i :i64] [:ref :form/r]
  (form/nth-of form (+ i 1)))
   :default nil)

#?(:kotoba
(defn argc [form [:ref :form/r]] :i64
  (- (form/count-of form) 1))
   :default nil)

#?(:kotoba
(defn req! [ok :bool msg :string code :string form [:ref :form/r]] :i64
  (if ok 0 (throw (fe-reject msg code form))))
   :default nil)

#?(:kotoba
(defn canon-type [type [:ref :form/r] schemas [:ref :form/r]] [:ref :form/r]
  (if (and (schema-ref-type? type) (form/is-map? schemas))
    (let [r (form/form-get schemas (form/nth-of type 1))]
      (if (form/is-nil? r) type r))
    type))
   :default nil)

#?(:kotoba
(defn hvi! [index [:ref :form/r] item-types [:ref :form/r] form [:ref :form/r]] :i64
  (if (kotoba-integer? index)
    (let [host-index (form/int-value index)]
      (if (and (<= 0 host-index) (< host-index (form/count-of item-types)))
        host-index
        (throw (fe-reject "heterogeneous vector index must be in range" "kotoba.error/hetero-vector-index-range" form))))
    (throw (fe-reject "heterogeneous vector index must be an integer literal" "kotoba.error/hetero-vector-index" form))))
   :default nil)

#?(:kotoba
(defn tail-form? [form [:ref :form/r]] :bool
  (and (form/is-seq? form)
       (or (sym-is? (form/nth-of form 0) "if") (sym-is? (form/nth-of form 0) "let") (sym-is? (form/nth-of form 0) "do"))))
   :default nil)

#?(:kotoba
(defn ie-symbol [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [t (form/form-get locals form)]
    (if (ftruthy? t)
      (ie-r t ctx)
      (throw (unbound-symbol-error "unbound symbol has no value type" form locals sigs)))))
   :default nil)

#?(:kotoba
(defn ie-let-body [form [:ref :form/r]] [:ref :form/r]
  (let [n (argc form)
        bodies (if (> n 0) (- n 1) 0)
        _ (req! (= bodies 1)
                (str "let requires one result expression; got " (string-from-i64 bodies) " (sequence with `do`)")
                "kotoba.error/let-body-multiple-forms" form)]
    (a form 1)))
   :default nil)

#?(:kotoba
(defn ie-let-type [type [:ref :form/r] name [:ref :form/r] value [:ref :form/r]] [:ref :form/r]
  (if (bounded-vector-source-binding? name)
    (if (or (canonical-list-type? type) (ty? type :document))
      type
      (let [_ (require-expression-type! type (tk :vector-i64) value)]
        (tk :vector-i64)))
    type))
   :default nil)

#?(:kotoba
(defn ie-let-pairs [ctx [:ref :ie/ctx] bindings [:ref :form/r] i :i64 current [:ref :form/r] body [:ref :form/r] form [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (if (< (+ i 1) (form/count-of bindings))
    (let [name (form/nth-of bindings i)
          value (form/nth-of bindings (+ i 1))
          r (ie-infer-t ctx false value current sigs)
          type (ie-let-type (ie-type r) name value)
          next-locals (local-state-check-cell-type! name type (form/assoc-form current name type) form)]
      (ie-let-pairs (ie-ctx r) bindings (+ i 2) next-locals body form sigs))
    (ie-infer ctx body current sigs)))
   :default nil)

#?(:kotoba
(defn ie-arm-let [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [body (ie-let-body form)]
    (ie-let-pairs ctx (a form 0) 0 locals body form sigs)))
   :default nil)

#?(:kotoba
(defn ie-arm-absent [ctx [:ref :ie/ctx] form [:ref :form/r]] [:ref :ie/r]
  (let [k (a form 0)]
    (cond
      (form/eq k (tk :nil)) (ie-r (nil-kind-form) ctx)
      (form/eq k (tk :none)) (ie-r (none-kind-form) ctx)
      :else (ie-r (absent-kind-form) ctx))))
   :default nil)

#?(:kotoba
(defn ie-arm-present [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [r (ie-infer ctx (a form 0) locals sigs)
        t (ie-type r)]
    (cond
      (option-vector-type? t) (ie-r (form/nth-of t 1) (ie-ctx r))
      (ty? t :option-i64) (ie-r (tk :i64) (ie-ctx r))
      :else r)))
   :default nil)

#?(:kotoba
(defn if-test-check! [test-type [:ref :form/r] test [:ref :form/r]] :i64
  (if (ty? test-type :i64)
    (throw (fe-reject (str "if test is :i64, and a number is never truthy: "
                           "compare it (for example (not= x 0)) or answer :bool")
                      "kotoba.error/subset-reject" test))
    (if (ty? test-type :bool)
      0
      (throw (fe-reject "if test must be bool or an option" "kotoba.error/subset-reject" test)))))
   :default nil)

#?(:kotoba
(defn if-join [then-type [:ref :form/r] else-type [:ref :form/r] tail? :bool absent-then? :bool absent-else? :bool form [:ref :form/r]] [:ref :form/r]
  (cond
    (absence-kind? else-type) (absence-type then-type (absence-kind-mode else-type))
    (absence-kind? then-type) (absence-type else-type (absence-kind-mode then-type))
    (form/eq then-type (abort-bottom-form)) else-type
    (form/eq else-type (abort-bottom-form)) then-type
    (form/eq then-type else-type) then-type
    (same-expression-type? then-type else-type) (if (schema-ref-type? else-type) else-type then-type)
    (and (or tail? absent-then? absent-else?) (ftruthy? (lenient-branch-join then-type else-type)))
    (lenient-branch-join then-type else-type)
    :else (throw (fe-reject "if branches must have the same value type" "kotoba.error/subset-reject" form))))
   :default nil)

#?(:kotoba
(defn ie-arm-if [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [test (a form 0)
        then (a form 1)
        else (a form 2)
        tail? (ctx-tail? ctx)
        absent-then? (absence-in-tail? then)
        absent-else? (absence-in-tail? else)
        r1 (ie-infer-t ctx false test locals sigs)
        r2 (ie-infer-t (ie-ctx r1) (or tail? absent-else?) then locals sigs)
        r3 (ie-infer-t (ie-ctx r2) (or tail? absent-then?) else locals sigs)
        test-type (if (or (option-vector-type? (ie-type r1)) (ty? (ie-type r1) :option-i64)) (tk :bool) (ie-type r1))
        _ (if-test-check! test-type test)
        joined (if-join (ie-type r2) (ie-type r3) tail? absent-then? absent-else? form)]
    (ie-r joined (ie-ctx r3))))
   :default nil)

#?(:kotoba
(defn ie-do-each [ctx [:ref :ie/ctx] form [:ref :form/r] i :i64 tail? :bool locals [:ref :form/r] sigs [:ref :form/r] last-type [:ref :form/r]] [:ref :ie/r]
  (if (>= i (argc form))
    (ie-r last-type ctx)
    (let [r (ie-infer-t ctx (and tail? (= i (- (argc form) 1))) (a form i) locals sigs)]
      (ie-do-each (ie-ctx r) form (+ i 1) tail? locals sigs (ie-type r)))))
   :default nil)

#?(:kotoba
(defn ie-arm-do [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (ie-do-each ctx form 0 (ctx-tail? ctx) locals sigs (form/nil-form)))
   :default nil)

#?(:kotoba
(defn state-type-of [ctx [:ref :ie/ctx] handler-key [:ref :form/r]] [:ref :form/r]
  (fget (form/form-get (ctx-handlers ctx) handler-key) :state-type))
   :default nil)

#?(:kotoba
(defn state-handler-check! [state-type [:ref :form/r] prefix :string handler-key [:ref :form/r] form [:ref :form/r]] :i64
  (if (ftruthy? state-type)
    0
    (throw (fe-reject (str prefix (form-text handler-key)) "kotoba.error/state-shape" form))))
   :default nil)

#?(:kotoba
(defn ie-arm-state-op [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [handler-key (a form 0)
        state-type (state-type-of ctx handler-key)
        _ (state-handler-check! state-type "state operation names no handler: " handler-key form)]
    (if (form/eq (a form 1) (tk :put))
      (let [c1 (ie-expect ctx (a form 2) state-type locals sigs)]
        (ie-r state-type c1))
      (ie-r state-type ctx))))
   :default nil)

#?(:kotoba
(defn ie-arm-state-with [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [handler-key (a form 0)
        state-type (state-type-of ctx handler-key)
        _ (state-handler-check! state-type "handle names no handler: " handler-key form)
        c1 (ie-expect ctx (a form 1) state-type locals sigs)]
    (ie-infer c1 (a form 2) locals sigs)))
   :default nil)

#?(:kotoba
(defn throw-shape-check! [form [:ref :form/r]] :i64
  (if (= 1 (argc form))
    0
    (throw (fe-reject "throw requires exactly one error value" "kotoba.error/abort-shape" form))))
   :default nil)

#?(:kotoba
(defn throw-bottom-check! [error-type [:ref :form/r] form [:ref :form/r]] :i64
  (if (form/eq error-type (abort-bottom-form))
    (throw (fe-reject "throw of a value that itself always aborts" "kotoba.error/abort-shape" form))
    0))
   :default nil)

#?(:kotoba
(defn ctx-collect [ctx [:ref :ie/ctx] error-type [:ref :form/r]] [:ref :ie/ctx]
  (if (record-get [:ref :ie/ctx] ctx :collect)
    (record-assoc [:ref :ie/ctx] ctx :throws (form/append-form (record-get [:ref :ie/ctx] ctx :throws) error-type))
    ctx))
   :default nil)

#?(:kotoba
(defn ie-arm-throw [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [_ (throw-shape-check! form)
        r (ie-infer ctx (a form 0) locals sigs)
        _ (throw-bottom-check! (ie-type r) form)]
    (ie-r (abort-bottom-form) (ctx-collect (ie-ctx r) (ie-type r)))))
   :default nil)

#?(:kotoba
(defn ie-try-parts [clause [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
  (let [_ (req! (and (form/is-seq? clause) (sym-is? (form/nth-of clause 0) "catch"))
                "try requires a (catch [error-type] binder handler) clause" "kotoba.error/abort-shape" form)
        parts (- (form/count-of clause) 1)
        _ (req! (or (= parts 2) (= parts 3))
                "catch requires an optional error type, one binder, and one handler expression"
                "kotoba.error/abort-shape" form)
        error-type (if (= parts 3) (form/nth-of clause 1) (form/nil-form))
        binder (form/nth-of clause (- (form/count-of clause) 2))
        handler (form/nth-of clause (- (form/count-of clause) 1))
        _ (req! (and (form/is-symbol? binder) (< (string-find-byte (form/symbol-value binder) 47 0) 0))
                "catch binder must be an unqualified symbol" "kotoba.error/abort-shape" form)]
    (form/vec3 (if (form/eq error-type (tk :default)) (form/nil-form) error-type) binder handler)))
   :default nil)

#?(:kotoba
(defn candidates-from [thrown [:list [:ref :form/r]] callee [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (vector-count callee))
    acc
    (let [t (fl-nth callee i)]
      (candidates-from thrown callee (+ i 1) (if (fl-has? acc t 0) acc (form/append-form acc t))))))
   :default nil)

#?(:kotoba
(defn distinct-forms [xs [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (vector-count xs))
    acc
    (let [t (fl-nth xs i)]
      (distinct-forms xs (+ i 1) (if (fl-has? acc t 0) acc (form/append-form acc t))))))
   :default nil)

#?(:kotoba
(defn try-error-type! [explicit [:ref :form/r] candidates [:list [:ref :form/r]] form [:ref :form/r]] [:ref :form/r]
  (cond
    (not (form/is-nil? explicit)) explicit
    (> (vector-count candidates) 1)
    (throw (fe-reject (str "try body aborts with two different error types: "
                           (type-text (fl-nth candidates 0)) " and " (type-text (fl-nth candidates 1)))
                      "kotoba.error/abort-error-type" form))
    (= (vector-count candidates) 1) (fl-nth candidates 0)
    :else (abort-unknown-error-form)))
   :default nil)

#?(:kotoba
(defn try-join! [body-type [:ref :form/r] handler-type [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
  (cond
    (form/eq body-type (abort-bottom-form)) handler-type
    (form/eq handler-type (abort-bottom-form)) body-type
    (same-expression-type? body-type handler-type) body-type
    :else (throw (fe-reject (str "try body and catch handler must have the same value type: "
                                 (type-text body-type) " and " (type-text handler-type))
                            "kotoba.error/abort-value-type" form))))
   :default nil)

#?(:kotoba
(defn ie-arm-try [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [body (a form 0)
        parts (ie-try-parts (a form 1) form)
        explicit (form/nth-of parts 0)
        binder (form/nth-of parts 1)
        handler (form/nth-of parts 2)
        outer-collect (record-get [:ref :ie/ctx] ctx :collect)
        outer-throws (record-get [:ref :ie/ctx] ctx :throws)
        inner (record-assoc [:ref :ie/ctx] (record-assoc [:ref :ie/ctx] ctx :collect true) :throws (form/no-forms))
        rb (ie-infer inner body locals sigs)
        thrown (record-get [:ref :ie/ctx] (ie-ctx rb) :throws)
        restored (record-assoc [:ref :ie/ctx] (record-assoc [:ref :ie/ctx] (ie-ctx rb) :collect outer-collect) :throws outer-throws)
        candidates (candidates-from thrown (abort-callee-error-types body (record-get [:ref :ie/ctx] ctx :known)) 0 (distinct-forms thrown 0 (form/no-forms)))
        error-type (try-error-type! explicit candidates form)
        rh (ie-infer restored handler (form/assoc-form locals binder error-type) sigs)
        joined (try-join! (ie-type rb) (ie-type rh) form)]
    (ie-r joined (ie-ctx rh))))
   :default nil)

#?(:kotoba
(defn ie-arm-typed-cap-call [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [request-type (a form 1)
        result-type (a form 2)
        _ (type-valid! request-type)
        _ (type-valid! result-type)
        c1 (ie-expect ctx (a form 3) request-type locals sigs)]
    (ie-r result-type c1)))
   :default nil)

#?(:kotoba
(defn ie-arm-payload [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] which :i64 result [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
        _ (type-valid! type)
        c1 (ie-expect ctx (a form 1) (form/nth-of type which) locals sigs)]
    (ie-r (if (form/is-nil? result) type result) c1)))
   :default nil)

#?(:kotoba
(defn ie-arm-validated-value [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] result [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
        _ (type-valid! type)
        c1 (ie-expect ctx (a form 1) type locals sigs)]
    (ie-r (if (form/is-nil? result) type result) c1)))
   :default nil)

#?(:kotoba
(defn ie-arm-value-fallback [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] which :i64] [:ref :ie/r]
  (let [type (a form 0)
        _ (type-valid! type)
        c1 (ie-expect ctx (a form 1) type locals sigs)
        c2 (ie-expect c1 (a form 2) (form/nth-of type which) locals sigs)]
    (ie-r (form/nth-of type which) c2)))
   :default nil)

#?(:kotoba
(defn branch-types-same! [t1 [:ref :form/r] t2 [:ref :form/r] msg :string form [:ref :form/r]] :i64
  (if (form/eq t1 t2)
    0
    (throw (fe-reject msg "kotoba.error/subset-reject" form))))
   :default nil)

#?(:kotoba
(defn ie-arm-result-match [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
        _ (type-valid! type)
        c1 (ie-expect ctx (a form 1) type locals sigs)
        r1 (ie-infer c1 (a form 3) (form/assoc-form locals (a form 2) (form/nth-of type 1)) sigs)
        r2 (ie-infer (ie-ctx r1) (a form 5) (form/assoc-form locals (a form 4) (form/nth-of type 2)) sigs)
        _ (branch-types-same! (ie-type r1) (ie-type r2) "result match branches must have the same value type" form)]
    (ie-r (ie-type r1) (ie-ctx r2))))
   :default nil)

#?(:kotoba
(defn variant-payload-type [cases [:ref :form/r] tag [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of cases))
    (form/nil-form)
    (let [case-pair (form/nth-of cases i)]
      (if (and (form/eq (form/nth-of case-pair 0) tag) (ftruthy? (form/nth-of case-pair 1)))
        (form/nth-of case-pair 1)
        (variant-payload-type cases tag (+ i 1))))))
   :default nil)

#?(:kotoba
(defn variant-declared! [payload-type [:ref :form/r] form [:ref :form/r]] :i64
  (if (ftruthy? payload-type)
    0
    (throw (fe-reject "variant constructor tag is not declared" "kotoba.error/subset-reject" form))))
   :default nil)

#?(:kotoba
(defn ie-arm-variant-new [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [type (canon-type (a form 0) (ctx-schemas ctx))
        payload-type (variant-payload-type (form/nth-of type 2) (a form 1) 0)
        _ (type-valid! type)
        _ (variant-declared! payload-type form)
        c1 (ie-expect ctx (a form 2) payload-type locals sigs)]
    (ie-r type c1)))
   :default nil)

#?(:kotoba
(defn variant-branches [ctx [:ref :ie/ctx] cases [:ref :form/r] branches [:ref :form/r] i :i64 locals [:ref :form/r] sigs [:ref :form/r] acc [:list [:ref :form/r]]] [:ref :ie/r]
  (if (or (>= i (form/count-of cases)) (>= i (form/count-of branches)))
    (ie-r (form/form-vec acc) ctx)
    (let [case-pair (form/nth-of cases i)
          branch (form/nth-of branches i)
          r (ie-infer ctx (form/nth-of branch 2) (form/assoc-form locals (form/nth-of branch 1) (form/nth-of case-pair 1)) sigs)]
      (variant-branches (ie-ctx r) cases branches (+ i 1) locals sigs (form/append-form acc (ie-type r))))))
   :default nil)

#?(:kotoba
(defn all-same! [types [:ref :form/r] i :i64 msg :string form [:ref :form/r]] :i64
  (if (>= (+ i 1) (form/count-of types))
    0
    (if (form/eq (form/nth-of types i) (form/nth-of types (+ i 1)))
      (all-same! types (+ i 1) msg form)
      (throw (fe-reject msg "kotoba.error/subset-reject" form)))))
   :default nil)

#?(:kotoba
(defn ie-arm-variant-match [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [type (canon-type (a form 0) (ctx-schemas ctx))
        cases (form/nth-of type 2)
        _ (type-valid! type)
        c1 (ie-expect ctx (a form 1) type locals sigs)
        rb (variant-branches c1 cases (a form 2) 0 locals sigs (form/no-forms))
        _ (all-same! (ie-type rb) 0 "variant match branches must have the same value type" form)]
    (ie-r (form/nth-of (ie-type rb) 0) (ie-ctx rb))))
   :default nil)

#?(:kotoba
(defn ie-arm-option-match [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
        _ (type-valid! type)
        c1 (ie-expect ctx (a form 1) type locals sigs)
        r1 (ie-infer c1 (a form 2) locals sigs)
        r2 (ie-infer (ie-ctx r1) (a form 4) (form/assoc-form locals (a form 3) (form/nth-of type 1)) sigs)
        _ (branch-types-same! (ie-type r1) (ie-type r2) "option match branches must have the same value type" form)]
    (ie-r (ie-type r1) (ie-ctx r2))))
   :default nil)

#?(:kotoba
(defn ie-items-expect [ctx [:ref :ie/ctx] form [:ref :form/r] i :i64 expected [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/ctx]
  (if (>= i (argc form))
    ctx
    (let [c1 (ie-expect ctx (a form i) expected locals sigs)]
      (ie-items-expect c1 form (+ i 1) expected locals sigs))))
   :default nil)

#?(:kotoba
(defn ie-arm-typed-list-new [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
        _ (type-valid! type)
        c1 (ie-items-expect ctx form 1 (form/nth-of type 1) locals sigs)]
