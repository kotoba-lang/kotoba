#?(:kotoba
(defn ie-arm-typed-value-index [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] result [:ref :form/r]] [:ref :ie/r]
  (let [type (a form 0)
