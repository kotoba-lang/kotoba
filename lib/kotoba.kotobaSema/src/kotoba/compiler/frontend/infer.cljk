#?(:kotoba
(defn ie-arm-spec [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r] entry [:ref :form/r]] [:ref :ie/r]
  (let [c1 (ie-spec-expect ctx form (form/nth-of entry 0) 0 locals sigs)]
