(ns kotoba.compiler.frontend.infer
  "Module `infer` of kotoba.compiler.frontend, cut from the original namespace by amu refactor split (97 forms, 3398 lines). Depends on: base, kernel-region, closure-types, expand, namespace-defs."
  ;; the Kotoba-route interface: the names the other frontend modules, kotoba.sema and the native guests use
  ;; (the linked project export bound is 1024 clauses, ADR 0363 port)
  #?(:kotoba {:kotoba/export [absence-in-tail? argc ctx-row-schemas ctx-schemas document-of-constructor! empty-fmap fn-signature ie-new-ctx infer-expression-type kw-head? legacy-absence library-predicate-answer! nominal-type-identity option-vector-type? record-field-type record-get-default-type require-expression-type! row-op-fields row-op-literal-entries row-op-not-record! row-op-record row-op-result-type same-expression-type? use-site-text ie-type-of zip-locals a abort-bottom-form abort-callee-error-types abort-callee-sites absence-kind? absence-type distinct-forms error-types-from ie-ctx ie-infer ie-let-body ie-tbl-get ie-tbl-has? ie-try-parts ie-type lenient-branch-join map2 nil-kind-form none-kind-form option-of req! sym-is? tk tput ty? type-text type-valid!]})
  (:require #?@(:kotoba [] :default [[kotoba.lang.coll :as set]])
            [kotoba.lang.text :as str]
            [kotoba.compiler.frontend-tables :as tables]
            [kotoba.kir.value :as value]
            #?@(:kotoba [[kotoba.form :as form] [kotoba.compiler.value-type :as vt]])
            [kotoba.compiler.frontend.base :refer [abort-escapes? abort-form-mentions? capability-wire-id effect-capability-id if-parts let-body reject! reject-call-arity! source-operation-registry try-clause-parts #?@(:kotoba [capability-registry fe-reject fe-reject-data form-text pr-form ascii-digit-code? simple-symbol-form? fput fget ftruthy? fsource-head fl-has? fl-nth fl-slice fdrop] :default [synthetic first-truthy *synthetic-counter*])]]
            [kotoba.compiler.frontend.kernel-region :refer [absence-marker? map-literal-record-type #?@(:kotoba [] :default [map-literal-key-order kernel-memory-operations])]]
            [kotoba.compiler.frontend.closure-types :refer [callable-type? canonical-closure-result-type canonical-list-type? canonical-typed-map-type? heterogeneous-vector-type? parametric-result-type? record-type? schema-ref-type? typed-set-type? validate-value-type! variant-type? #?@(:kotoba [] :default [*schemas*])]]
            [kotoba.compiler.frontend.expand :refer [kotoba-integer? preserve-form-meta]]
            [kotoba.compiler.frontend.namespace-defs :refer [heterogeneous-vector-index! internal-failure! unbound-symbol! unknown-operation! #?@(:kotoba [] :default [arithmetic comparisons float-division-heads heap-operations i32-operations i64-operations kernel-privileged-operations kgraph-operations reserved-binding-name? rodata-literal-operations set-operations]) #?@(:kotoba [heads-kids unbound-symbol-error unknown-operation-error])]])
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]
                                 ;; a refusal: the Kotoba-route `reject!` throws one (ADR 0007)
                                 :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]] [:phase :string] [:data [:ref :form/r]]]]
                                 ;; the desugar env and its results (docs/selfhost-frontend-typemodel-design.md 1.2)
                                 :fe/env [:record :fe/env [[:counter :i64] [:result [:ref :form/r]] [:none :bool] [:arities [:ref :form/r]] [:lexical [:ref :form/r]] [:types [:ref :form/r]] [:docfns [:ref :form/r]] [:loop-counter :i64] [:tbl [:ref :form/r]] [:schemas [:ref :form/r]] [:lazy :bool] [:abort-ctx :string] [:used-caps [:ref :form/r]] [:options [:ref :form/r]] [:helpers [:ref :form/r]] [:shapes [:ref :form/r]] [:lambda-counter :i64] [:lambdas [:ref :form/r]] [:loop-result [:ref :form/r]] [:loop-known [:ref :form/r]] [:dispatchers [:ref :form/r]] [:uses-apply :bool] [:uses-lazy :bool] [:contracts [:ref :form/r]]]]
                                 :fe/dr [:record :fe/dr [[:env [:ref :fe/env]] [:form [:ref :form/r]]]]
                                 :fe/drs [:record :fe/drs [[:env [:ref :fe/env]] [:forms [:list [:ref :form/r]]]]]
                                 ;; the inference context: the host's dynamic vars of infer.cljk, threaded by value
                                 :ie/ctx [:record :ie/ctx [[:schemas [:ref :form/r]] [:row-schemas [:ref :form/r]] [:handlers [:ref :form/r]] [:final :bool] [:tail :bool] [:names [:ref :form/r]] [:recording :bool] [:recorded [:ref :form/r]] [:collect :bool] [:throws [:list [:ref :form/r]]] [:known [:ref :form/r]] [:tbl [:ref :form/r]] [:rec-limit :i64] [:rec-count :i64]]]
                                 :ie/r [:record :ie/r [[:type [:ref :form/r]] [:ctx [:ref :ie/ctx]]]]
                                 ;; abort elaboration: the walk results (form + synthetic-name counter) and its context
                                 :ae/r [:record :ae/r [[:form [:ref :form/r]] [:n :i64]]]
                                 :ae/rs [:record :ae/rs [[:forms [:list [:ref :form/r]]] [:n :i64]]]
                                 :ae/c [:record :ae/c [[:ctx [:ref :ie/ctx]] [:sigs [:ref :form/r]] [:aet [:ref :form/r]]]]})))

;; forward references inside this module (the cut keeps the original form order)
#?(:kotoba
(defn same-expression-type? [actual [:ref :form/r] expected [:ref :form/r]] :bool
  (or (form/eq actual expected)
      (and (or (schema-ref-type? actual) (schema-ref-type? expected))
           (form/eq (nominal-type-identity actual) (nominal-type-identity expected))
           (not (form/is-nil? (nominal-type-identity actual))))))
   :default
(declare same-expression-type? infer-expression-type use-site-text infer-call-type-impl infer-expression-type-impl str-part-type! sequence-first-exit-type))


#?(:kotoba nil :default (def named-operation-default-results tables/named-operation-default-results))
#?(:kotoba nil :default (def float-arithmetic-resolution tables/float-arithmetic-resolution))
#?(:kotoba nil :default (def explicit-numeric-conversions tables/explicit-numeric-conversions))

#?(:kotoba nil :default (def ^:dynamic *state-handlers*
  "The module's state handlers, `{handler-keyword {:name :state-type
  :clauses}}`, in a volatile bound per analysis. Read by inference to type the
  resolved state heads."))

;; A synthesized loop-helper carries no param-type annotations (its captured
;; outer variables have types only knowable at its call site). During the
;; param-type resolution pass (resolve-loop-helper-param-types) these two are
;; bound so that infer-call-type, on reaching a still-unresolved loop-helper
;; call, RECORDS the argument types instead of type-checking the arguments
;; against the (placeholder) declared param-types. Both nil in the normal
;; check-value-types! pass, so ordinary type-checking is unchanged.
#?(:kotoba nil :default (def ^:dynamic *lenient-branch-joins?* nil))
#?(:kotoba nil :default (def ^:dynamic *loop-helper-names* nil))
#?(:kotoba nil :default (def ^:dynamic *loop-helper-recorder* nil))

;; Bound to a volatile vector by whatever wants the types of the `throw`s a
;; form can reach WITHOUT crossing a try body. `infer-expression-type`'s `try`
;; case rebinds it around the body, so a throw inside a try is collected by
;; that try and never reaches the outer collector; a throw in the handler is
;; outside the body and does reach it. Unbound (nil) everywhere else, where a
;; throw is typed and not recorded.
#?(:kotoba nil :default (def ^:dynamic *abort-throw-types* nil))

;; Function name -> the error type it aborts with, for the functions that do.
;; Bound while the abort passes and their inference run; empty elsewhere.
#?(:kotoba nil :default (def ^:dynamic *abort-error-types* {}))

;; The static type of `(throw e)`: it has no value, so it unifies with either
;; branch of an `if`. It never reaches HIR -- an aborting function is lowered
;; to `[:result T E]` before any pass that writes HIR sees it.
#?(:kotoba
(defn abort-bottom-form [] [:ref :form/r] (form/keyword-form :kotoba.abort/bottom))
   :default
(def abort-bottom :kotoba.abort/bottom))

;; The catch binder's provisional type while a callee's error type is not yet
;; known (the abort passes iterate to a fixed point). Nothing unifies with it,
;; so a handler that reads the binder before its type is known refuses -- and
;; the fixed point retries -- rather than reading it as anything.
#?(:kotoba
(defn abort-unknown-error-form [] [:ref :form/r] (form/keyword-form :kotoba.abort/unknown-error))
   :default
(def abort-unknown-error :kotoba.abort/unknown-error))

#?(:kotoba
(defn sym-is? [x [:ref :form/r] name :string] :bool
  (and (form/is-symbol? x) (string=? (form/symbol-value x) name)))
   :default nil)

;; Empty Form map shared by inference and the later absence/abort passes.
#?(:kotoba
(defn empty-fmap [] [:ref :form/r]
  (form/form-map (form/no-forms)))
   :default nil)

#?(:kotoba
(defn form-list-has? [xs [:list [:ref :form/r]] x [:ref :form/r] i :i64] :bool
  (if (>= i (vector-count xs))
    false
    (if (form/eq (typed-list-nth [:list [:ref :form/r]] xs i) x)
      true
      (form-list-has? xs x (+ i 1)))))
   :default nil)

#?(:kotoba
(defn abort-add [op [:ref :form/r] known [:ref :form/r] out [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (let [t (form/form-get known op)]
    (if (form/is-nil? t)
      out
      (if (form-list-has? out (form/vec2 op t) 0)
        out
        (form/append-form out (form/vec2 op t))))))
   :default nil)

#?(:kotoba
(defn abort-walk-kids [x [:ref :form/r] i :i64 known [:ref :form/r] out [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of x))
    out
    (abort-walk-kids x (+ i 1) known (abort-walk (form/nth-of x i) known out))))
   :default nil)

#?(:kotoba
(defn abort-walk [x [:ref :form/r] known [:ref :form/r] out [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (cond
    (form/is-seq? x)
    (if (= 0 (form/count-of x))
      out
      (cond
        (sym-is? (form/nth-of x 0) "fn") out
        (sym-is? (form/nth-of x 0) "try") (abort-walk (form/last-of (form/nth-of x 2)) known out)
        :else (abort-walk-kids x 1 known (abort-add (form/nth-of x 0) known out))))
    (or (form/is-vec? x) (form/is-set? x) (form/is-map? x)) (abort-walk-kids x 0 known out)
    :else out))
   :default nil)

#?(:kotoba
(defn abort-callee-sites [form [:ref :form/r] known [:ref :form/r]] [:list [:ref :form/r]]
  (abort-walk form known (form/no-forms)))
   :default
(defn abort-callee-sites
  "`[[callee error-type] ...]`, in source order, for the aborting functions
  FORM calls with no try body in between. A try's handler is walked -- what it
  throws leaves the try -- and its body is not: that body's aborts are the
  try's own to catch. A `fn` literal's body is NOT walked: an aborting call
  there belongs to the lambda that body becomes, not to the function the
  literal appears in. (Lambda lifting has already run by the time the abort
  passes do, so that clause is a backstop rather than the usual route.)"
  [form]
  (let [known *abort-error-types* out (volatile! [])]
    (letfn [(walk [x]
              (cond
                (seq? x)
                (let [[op & args] x]
                  (cond
                    (= op 'fn) nil
                    (= op 'try) (walk (last (second args)))
                    :else
                    (do (when-let [error-type (get known op)]
                          (vswap! out conj [op error-type]))
                        (doseq [arg args] (walk arg)))))
                (coll? x) (doseq [item x] (walk item))))]
      (walk form)
      (distinct @out)))))

#?(:kotoba
(defn error-types-from [sites [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (vector-count sites))
    acc
    (let [t (form/nth-of (typed-list-nth [:list [:ref :form/r]] sites i) 1)]
      (error-types-from sites (+ i 1) (if (form-list-has? acc t 0) acc (form/append-form acc t))))))
   :default nil)

#?(:kotoba
(defn abort-callee-error-types [form [:ref :form/r] known [:ref :form/r]] [:list [:ref :form/r]]
  (error-types-from (abort-callee-sites form known) 0 (form/no-forms)))
   :default
(defn abort-callee-error-types
  "The error types of `abort-callee-sites`, deduplicated in source order."
  [form]
  (distinct (map second (abort-callee-sites form)))))

#?(:kotoba
(defn bounded-vector-source-binding? [name [:ref :form/r]] :bool
  (let [s (form-text name)]
    (or (and (str/starts-with? s "__kotoba_map_source_")
             (not (str/starts-with? s "__kotoba_map_sources_")))
        (str/starts-with? s "__kotoba_filter_v_")
        (str/starts-with? s "__kotoba_reduce_v_")
        (str/starts-with? s "__kotoba_mapindexed_v_"))))
   :default
(defn bounded-vector-source-binding?
  "True for the synthetic collection binding T4.5 map/filter/reduce emit.

  Inference must require the INIT to be `:vector-i64` (form = the author's
  collection) rather than inferring the binding from a provisional `:i64`
  and then refusing the binding name inside the loop helper. Packed
  `map_sources` is a heterogeneous vector and is deliberately excluded."
  [name]
  (let [s (str name)]
    (or (and (str/starts-with? s "__kotoba_map_source_")
             (not (str/starts-with? s "__kotoba_map_sources_")))
        (str/starts-with? s "__kotoba_filter_v_")
        (str/starts-with? s "__kotoba_reduce_v_")
        (str/starts-with? s "__kotoba_mapindexed_v_")))))

;; Absence markers (gap 1 of the selfhost foundation): see `absence-type`.
#?(:kotoba
(defn absent-kind-form [] [:ref :form/r] (form/keyword-form :kotoba.absence/absent))
   :default
(def absent-kind :kotoba.absence/absent))
#?(:kotoba
(defn none-kind-form [] [:ref :form/r] (form/keyword-form :kotoba.absence/none))
   :default
(def none-kind :kotoba.absence/none))
#?(:kotoba
(defn nil-kind-form [] [:ref :form/r] (form/keyword-form :kotoba.absence/nil))
   :default
(def nil-kind :kotoba.absence/nil))

#?(:kotoba
(defn kw-form-is? [t [:ref :form/r] k :keyword] :bool
  (form/eq t (form/keyword-form k)))
   :default nil)

#?(:kotoba
(defn absence-kind-mode [kind [:ref :form/r]] [:ref :form/r]
  (cond
    (form/eq kind (absent-kind-form)) (form/keyword-form :legacy)
    (form/eq kind (none-kind-form)) (form/keyword-form :none)
    (form/eq kind (nil-kind-form)) (form/keyword-form :nil)
    :else (form/nil-form)))
   :default
(defn absence-kind-mode [kind]
  (get {absent-kind :legacy none-kind :none nil-kind :nil} kind)))

#?(:kotoba
(defn absence-kind? [type [:ref :form/r]] :bool
  (or (form/eq type (absent-kind-form)) (form/eq type (none-kind-form)) (form/eq type (nil-kind-form))))
   :default
(defn absence-kind? [type] (contains? #{absent-kind none-kind nil-kind} type)))

#?(:kotoba
(defn absence-in-tail? [form [:ref :form/r]] :bool
  (cond
    (absence-marker? form) true
    (not (form/is-seq? form)) false
    (and (sym-is? (form/nth-of form 0) "if") (= 4 (form/count-of form)))
    (or (absence-in-tail? (form/nth-of form 2)) (absence-in-tail? (form/nth-of form 3)))
    (and (sym-is? (form/nth-of form 0) "let") (<= 3 (form/count-of form))) (absence-in-tail? (form/last-of form))
    (and (sym-is? (form/nth-of form 0) "do") (<= 2 (form/count-of form))) (absence-in-tail? (form/last-of form))
    :else false))
   :default
(defn absence-in-tail?
  "A marker in a tail position of FORM (through `if`, `let`, `do`)."
  [form]
  (cond
    (absence-marker? form) true
    (not (seq? form)) false
    (and (= 'if (first form)) (= 4 (count form)))
    (or (absence-in-tail? (nth form 2)) (absence-in-tail? (nth form 3)))
    (and (= 'let (first form)) (<= 3 (count form))) (absence-in-tail? (last form))
    (and (= 'do (first form)) (<= 2 (count form))) (absence-in-tail? (last form))
    :else false)))

#?(:kotoba
(defn legacy-absence [marker [:ref :form/r]] [:ref :form/r]
  (if (form/eq (form/nth-of marker 1) (form/keyword-form :nil))
    (form/call0 "option-none")
    (form/int-form 0)))
   :default
(defn legacy-absence
  "What the desugar wrote before markers existed."
  [marker]
  (if (= :nil (second marker)) '(option-none) 0)))

;; the vector's first element is the keyword NAME
#?(:kotoba
   (defn kw-head? [t [:ref :form/r] name :string] :bool
     (and (form/is-vec? t) (> (form/count-of t) 0)
          (form/is-keyword? (form/nth-of t 0))
          (string=? (document-edn-print (document-keyword (form/keyword-value (form/nth-of t 0))))
                    (string-concat ":" name))))
   :default nil)

;; the type of FIELD in a fields vector [[:f T] ...], from index I; nil when absent
#?(:kotoba
   (defn record-field-lookup [fields [:ref :form/r] field [:ref :form/r] i :i64] [:ref :form/r]
     (if (>= i (form/count-of fields))
       (form/nil-form)
       (let [pair (form/nth-of fields i)]
         (if (form/eq (form/nth-of pair 0) field)
           (form/nth-of pair 1)
           (record-field-lookup fields field (+ i 1))))))
   :default nil)

#?(:kotoba
   (defn resolve-ref-type [type [:ref :form/r] schemas [:ref :form/r]] [:ref :form/r]
     ;; `*schemas*` is an explicit argument on this route (the :fe/env schemas field)
     (if (and (form/is-vec? type) (= 2 (form/count-of type))
              (kw-head? type "ref") (form/is-map? schemas))
       (let [resolved (form/form-get schemas (form/nth-of type 1))]
         (if (form/is-nil? resolved) type resolved))
       type))
   :default
(defn resolve-ref-type
  "Expand `[:ref :schema/name]` through `*schemas*` when available."
  [type]
  (if (and (vector? type)
           (= 2 (count type))
           (= :ref (first type))
           (map? *schemas*))
    (or (get *schemas* (second type)) type)
    type)))

#?(:kotoba
   (defn record-field-type [rec-type [:ref :form/r] field [:ref :form/r]
                             schemas [:ref :form/r]] [:ref :form/r]
     (let [rec (resolve-ref-type rec-type schemas)]
       (if (and (record-type? rec) (form/is-keyword? field))
         (record-field-lookup (form/nth-of rec 2) field 0)
         (form/nil-form))))
   :default
(defn record-field-type
  "Field type from a record descriptor or `[:ref …]` schema name, else nil."
  [rec-type field]
  (let [rec (resolve-ref-type rec-type)]
    (when (and (record-type? rec) (keyword? field))
      (first-truthy (fn [[k t]] (when (= k field) t))
            (nth rec 2))))))

#?(:kotoba
   (defn option-vector-type? [type [:ref :form/r]] :bool
     (vt/option-type? type))
   :default
(defn option-vector-type?
  "Parametric option `[:option T]`, not the legacy monomorphic `:option-i64`."
  [type]
  (and (vector? type)
       (= 2 (count type))
       (= :option (first type)))))

;; ── expression-level absence (gap 1 of the selfhost foundation) ─────────────
;;
;; superproject adr-2609242330, amu ladder floor :expression-absence. A `when`
;; (or an `if` / `if-not` / `when-not` / `when-let` / `if-let` / `when-some` /
;; `if-some` / `cond`) with no else, and a literal `nil` in a branch, answer
;; nothing on that path. Until 2026-09-26 the desugar wrote the i64 `0` there
;; (and `nil` was `(option-none)`, the i64 option), so every such form whose
;; present value was not an i64 was refused -- "if branches must have the same
;; value type", or "loop exits with two different value types: bool ... and
;; i64 from 0", the second selfhost wall (first-truthy).
;;
;; The desugar now writes a MARKER and the type of the present branch decides:
;;
;;   present :i64, no else   -> 0, exactly as before (CID-stable; pinned by
;;                              the :absence gate `(+ (when o 100) ...)`)
;;   present :bool           -> false (nil and false are both logical false)
;;   present [:option T]     -> that option's none (flattened, as Clojure's
;;                              nil-punning reads it)
;;   present T, anything else-> [:option T]: the present value is wrapped
;;                              `(option-some-of [:option T] v)` and the absent
;;                              path is `(option-none-of [:option T])`
;;   a literal nil beside :i64 -> [:option :i64]; beside :option-i64 or
;;                              [:option :i64] -> `(option-none)`, as before
;;
;; When nothing can type the present branch the marker becomes exactly what
;; the desugar used to write (0, or `(option-none)` for a literal nil), so a
;; program this change cannot type means what it meant before.
#?(:kotoba
(defn option-of [t [:ref :form/r]] [:ref :form/r]
  (form/vec2 (form/keyword-form :option) t))
   :default nil)

#?(:kotoba
(defn absence-type [present [:ref :form/r] mode [:ref :form/r]] [:ref :form/r]
  (cond
    (or (form/is-nil? present) (absence-kind? present) (form/eq present (abort-bottom-form)))
    (if (or (form/eq mode (form/keyword-form :nil)) (form/eq present (nil-kind-form)))
      (form/keyword-form :option-i64)
      (if (or (form/eq mode (form/keyword-form :none)) (form/eq present (none-kind-form)))
        (option-of (form/keyword-form :i64))
        (form/keyword-form :i64)))
    (form/eq present (form/keyword-form :i64))
    (if (form/eq mode (form/keyword-form :legacy)) (form/keyword-form :i64) (option-of (form/keyword-form :i64)))
    (form/eq present (form/keyword-form :bool)) (form/keyword-form :bool)
    (or (option-vector-type? present) (form/eq present (form/keyword-form :option-i64))) present
    :else (option-of present)))
   :default
(defn absence-type
  "The type of an `if` whose one path is absent and whose other path has type
  PRESENT. MODE is the marker's: :legacy, :none or :nil (`absence-marker`)."
  [present mode]
  (cond
    (or (nil? present) (absence-kind? present) (= abort-bottom present))
    (if (or (= :nil mode) (= nil-kind present)) :option-i64
        (if (or (= :none mode) (= none-kind present)) [:option :i64] :i64))
    (= :i64 present) (if (= :legacy mode) :i64 [:option :i64])
    (= :bool present) :bool
    (or (option-vector-type? present) (= :option-i64 present)) present
    :else [:option present])))

#?(:kotoba
(defn lenient-branch-join [a [:ref :form/r] b [:ref :form/r]] [:ref :form/r]
  (cond
    (and (option-vector-type? b) (form/eq a (form/nth-of b 1))) b
    (and (option-vector-type? a) (form/eq b (form/nth-of a 1))) a
    :else (form/nil-form)))
   :default
(defn lenient-branch-join
  "Inside the present branch of an absence, `(if c v (recur ...))` joins a
  value of type T with the loop's [:option T] answer: the value is the
  present answer, wrapped when the marker is resolved. Nil when the two do
  not meet that way."
  [a b]
  (cond
    (and (option-vector-type? b) (= a (second b))) b
    (and (option-vector-type? a) (= b (second a))) a
    :else nil)))

#?(:kotoba
(defn digits-end [s :string i :i64] :i64
  (if (and (< i (string-length s)) (ascii-digit-code? (string-code-point-at s i)))
    (digits-end s (+ i 1))
    i))
   :default nil)

#?(:kotoba
(defn cell-parts-scan [rest-text :string] [:ref :form/r]
  (let [n (string-length rest-text)
        a (digits-end rest-text 0)]
    (if (or (= a 0) (>= a n) (not (= 95 (string-code-point-at rest-text a))))
      (form/nil-form)
      (let [b (digits-end rest-text (+ a 1))]
        (if (or (= b (+ a 1)) (>= (+ b 1) n) (not (= 95 (string-code-point-at rest-text b))))
          (form/nil-form)
          (form/vec2 (form/string-form (string-substring rest-text 0 a))
                     (form/string-form (string-substring rest-text (+ b 1) n))))))))
   :default nil)

#?(:kotoba
(defn local-state-cell-parts [value [:ref :form/r]] [:ref :form/r]
  (if (simple-symbol-form? value)
    (let [text (form/symbol-value value)]
      (if (str/starts-with? text "__kotoba_cell_")
        (cell-parts-scan (string-substring text 14 (string-length text)))
        (form/nil-form)))
    (form/nil-form)))
   :default
(defn local-state-cell-parts
  "`[cell-id source-name]` for a cell binding symbol, else nil."
  [value]
  (when (simple-symbol? value)
    (let [text (name value)]
      (when (str/starts-with? text "__kotoba_cell_")
        (let [m (re-matches #"(\d+)_(\d+)_(.+)" (subs text (count "__kotoba_cell_")))]
          (when m [(nth m 1) (nth m 3)])))))))

#?(:kotoba
(defn kw-name [k [:ref :form/r]] :string
  (let [txt (form-text k)
        body (string-substring txt 1 (string-length txt))
        slash (string-find-byte body 47 0)]
    (if (< slash 0) body (string-substring body (+ slash 1) (string-length body)))))
   :default nil)

#?(:kotoba
(defn type-text [t [:ref :form/r]] :string
  (if (form/is-keyword? t) (kw-name t) (pr-form t)))
   :default nil)

#?(:kotoba
(defn local-state-type-text [type [:ref :form/r]] :string
  (type-text type))
   :default
(defn local-state-type-text [type]
  (if (keyword? type) (name type) (pr-str type))))

#?(:kotoba
(defn cell-type-mismatch! [cell-name [:ref :form/r] known [:ref :form/r] type [:ref :form/r] form [:ref :form/r]] :i64
  (if (and (not (form/is-nil? known)) (not (same-expression-type? known type)))
    (throw (fe-reject (str "atom `" (form/string-value cell-name) "` is " (local-state-type-text known)
                           "; this rebinding is " (local-state-type-text type)
                           " (atom slice 1 requires one type per cell)")
                      "kotoba.error/local-state-cell-type" form))
    0))
   :default nil)

#?(:kotoba
(defn local-state-check-cell-type! [name [:ref :form/r] type [:ref :form/r] locals [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
  (let [parts (local-state-cell-parts name)]
    (if (form/is-nil? parts)
      locals
      (let [key (form/symbol-form (str "__kotoba_cellty_" (form/string-value (form/nth-of parts 0))))
            known (form/form-get locals key)
            _ (cell-type-mismatch! (form/nth-of parts 1) known type form)]
        (form/assoc-form locals key (if (form/is-nil? known) type known))))))
   :default
(defn local-state-check-cell-type!
  "Tie every rebinding of one cell to the type its `(atom init)` gave it.

  The cell's identity survives desugaring in the binding NAME, so this runs
  where let bindings are typed rather than in the elaboration, which has no
  types yet. The recorded type rides in `locals` under a key no source symbol
  can spell, so it is threaded exactly as far as the bindings are."
  [name type locals form]
  (if-let [[id cell-name] (local-state-cell-parts name)]
    (let [key (symbol (str "__kotoba_cellty_" id))
          known (get locals key)]
      (when (and known (not (same-expression-type? known type)))
        (reject! (str "atom `" cell-name "` is " (local-state-type-text known)
                      "; this rebinding is " (local-state-type-text type)
                      " (atom slice 1 requires one type per cell)")
                 form :kotoba.error/local-state-cell-type))
      (assoc locals key (or known type)))
    locals)))

#?(:kotoba
(defn nominal-type-identity [type [:ref :form/r]] [:ref :form/r]
  (cond
    (schema-ref-type? type) (form/nth-of type 1)
    (or (record-type? type) (variant-type? type)) (form/nth-of type 1)
    :else (form/nil-form)))
   :default
(defn nominal-type-identity [type]
  (cond
    (schema-ref-type? type) (second type)
    (or (record-type? type) (variant-type? type)) (second type)
    :else nil)))

#?(:kotoba nil :default (defn same-expression-type?
  "Exact structural equality remains the default. A closed-schema reference
  and its fully declared nominal descriptor are interchangeable only by the
  same qualified identity; analyze verifies every inline descriptor carrying
  a declared identity against the namespace's authoritative schema first."
  [actual expected]
  (or (= actual expected)
      (and (or (schema-ref-type? actual) (schema-ref-type? expected))
           (= (nominal-type-identity actual)
              (nominal-type-identity expected))
           (some? (nominal-type-identity actual))))))

#?(:kotoba
(defn map2 [k1 [:ref :form/r] v1 [:ref :form/r] k2 [:ref :form/r] v2 [:ref :form/r]] [:ref :form/r]
  (form/form-map (form/append-form (form/append-form (form/append-form (form/append-form (form/no-forms) k1) v1) k2) v2)))
   :default nil)

#?(:kotoba
(defn expected-actual-data [expected [:ref :form/r] actual [:ref :form/r]] [:ref :form/r]
  (map2 (form/keyword-form :kotoba.error/expected) expected (form/keyword-form :kotoba.error/actual) actual))
   :default nil)

#?(:kotoba
(defn require-not-bottom! [actual [:ref :form/r] form [:ref :form/r]] :i64
  (if (form/eq actual (abort-bottom-form))
    (throw (fe-reject (str "abort slice 1 admits throw and calls to aborting functions "
                           "only in tail position or as a let binding value; the throw is in neither")
                      "kotoba.error/abort-position" form))
    0))
   :default nil)

#?(:kotoba
(defn require-not-legacy-map! [actual [:ref :form/r] expected [:ref :form/r] form [:ref :form/r]] :i64
  (if (and (form/eq actual (form/keyword-form :map)) (canonical-typed-map-type? expected))
    (throw (fe-reject-data (str "this value is the legacy pair-map, whose type is `map` and not "
                                (pr-form expected)
                                ". A map literal keeps the legacy representation when its keys are "
                                "keywords and when it is empty; only :i64 and :string literals are "
                                "retyped. Read and write it through get / assoc / contains? / dissoc, "
                                "or build the typed map with (typed-map-new " (pr-form expected) " ...)")
                           "kotoba.error/subset-reject" form (expected-actual-data expected actual)))
    0))
   :default nil)

#?(:kotoba
(defn require-same-type! [actual [:ref :form/r] expected [:ref :form/r] form [:ref :form/r]] :i64
  (if (same-expression-type? actual expected)
    0
    (throw (fe-reject-data (str "expression type mismatch: expected " (type-text expected)
                                ", got " (type-text actual))
                           "kotoba.error/subset-reject" form (expected-actual-data expected actual)))))
   :default nil)

#?(:kotoba
(defn require-expression-type! [actual [:ref :form/r] expected [:ref :form/r] form [:ref :form/r]] :i64
  (let [_ (require-not-bottom! actual form)
        _ (require-not-legacy-map! actual expected form)
        _ (require-same-type! actual expected form)]
    0))
   :default
(defn require-expression-type! [actual expected form]
  ;; Bottom is only ever the type of a `throw`, and a throw whose value is
  ;; REQUIRED to be something is a throw in a position slice 1 does not
  ;; admit (an operand, a test, a loop init). Say that, rather than
  ;; "expected i64, got bottom".
  (when (= actual abort-bottom)
    (reject! (str "abort slice 1 admits throw and calls to aborting functions "
                  "only in tail position or as a let binding value; the throw is in neither")
             form :kotoba.error/abort-position))
  ;; The legacy pair-map against a canonical typed map. This is a DECISION,
  ;; not a defect, and the generic sentence below reads like a defect.
  ;; ADR 0012 decision 1: a keyword-keyed literal keeps the legacy untagged
  ;; pair-map byte for byte, because that is the representation `map-get`,
  ;; `map-assoc` and every `match` map pattern are written against; `:i64` and
  ;; `:string` literals are the ones that were RETYPED to `typed-map-new`.
  ;; `{}` is legacy for the same reason -- it has no key type of its own.
  ;;
  ;; So `(let [m {:a 1}] (typed-map-count [:map :keyword :i64] m))` is refused
  ;; correctly and `(let [m {1 10}] (typed-map-count [:map :i64 :i64] m))` is
  ;; admitted correctly, and until now the two answers looked like the same
  ;; kind of fact about the same kind of program. Name the decision instead.
  (when (and (= :map actual) (canonical-typed-map-type? expected))
    (reject! (str "this value is the legacy pair-map, whose type is `map` and not "
                  (pr-str expected)
                  ". A map literal keeps the legacy representation when its keys are "
                  "keywords and when it is empty; only :i64 and :string literals are "
                  "retyped. Read and write it through get / assoc / contains? / dissoc, "
                  "or build the typed map with (typed-map-new " (pr-str expected) " ...)")
             form :kotoba.error/subset-reject
             {:kotoba.error/expected expected :kotoba.error/actual actual}))
  (when-not (same-expression-type? actual expected)
    (let [type-text #(if (keyword? %) (name %) (pr-str %))]
      ;; The types travel as DATA as well as prose. `infer-absent-parameter-types`
      ;; reads them from here rather than parsing the message, so refining a
      ;; parameter cannot drift from what the checker actually requires -- there
      ;; is no second table of operand types to keep in step, because there is
      ;; no second table.
      (reject! (str "expression type mismatch: expected " (type-text expected)
                    ", got " (type-text actual))
               form :kotoba.error/subset-reject
               {:kotoba.error/expected expected :kotoba.error/actual actual})))))

#?(:kotoba
(defn closure-literal-form? [form [:ref :form/r]] :bool
  (and (form/is-seq? form) (sym-is? (form/nth-of form 0) "pair") (= 3 (form/count-of form))
       (kotoba-integer? (form/nth-of form 1))))
   :default
(defn closure-literal-form?
  "The shape a lifted `fn` lowers to, `(pair <lambda-id> <captures>)`. Only
  the shape: `infer-closure-refinements`, which knows the module's lambda
  ids, refuses a `[:fn ...]` field given anything that is not a closure."
  [form]
  (and (seq? form) (= 'pair (first form)) (= 3 (count form))
       (kotoba-integer? (second form)))))

#?(:kotoba
(defn require-field-value-type! [actual [:ref :form/r] expected [:ref :form/r] item [:ref :form/r] form [:ref :form/r]] :i64
  (if (and (callable-type? expected) (form/eq actual (form/keyword-form :i64)) (closure-literal-form? item))
    0
    (require-expression-type! actual expected form)))
   :default
(defn require-field-value-type!
  "A record field's value against the field's declared type. A `[:fn ...]`
  field takes a fn literal, whose word is the i64 closure handle (ADR 0353
  floor :function-values)."
  [actual expected item form]
  (when-not (and (callable-type? expected) (= :i64 actual) (closure-literal-form? item))
    (require-expression-type! actual expected form))))

#?(:kotoba nil :default (def ^:dynamic *numeric-resolution-final*
  "True only inside `check-value-types!`. Before that pass, a plain numeric
  operator on float operands TYPES as the float (that is what lets an
  unannotated parameter be refined to `:f64` from `(+ p 1.5)`, and a result be
  inferred), and `rewrite-record-projection` then rewrites it to the typed
  operation. At the final check the rewrite has already run, so a plain
  operator that still has float operands is one the rewrite could not see the
  types of in time; typing it as f64 there would let KIR execute i64 `+` on a
  double. Fail closed instead."
  false))

#?(:kotoba
(defn spell-conversions [names [:ref :form/r] i :i64 acc :string] :string
  (if (>= i (form/count-of names))
    acc
    (spell-conversions names (+ i 1)
                       (str acc (if (> i 0) " or " "") "(" (form-text (form/nth-of names i)) " x)"))))
   :default nil)

#?(:kotoba
(defn numeric-conversion-spelling [from [:ref :form/r] to [:ref :form/r]] :string
  (spell-conversions (form/form-get (tables/explicit-numeric-conversions) (form/vec2 from to)) 0 ""))
   :default
(defn numeric-conversion-spelling [from to]
  (str/join " or " (map #(str "(" % " x)") (get explicit-numeric-conversions [from to])))))

#?(:kotoba
(defn mixed-numeric-message [op [:ref :form/r] dominant [:ref :form/r] other [:ref :form/r]] :string
  (str (form-text op) " operands must share one numeric type; got " (kw-name dominant) " and "
       (kw-name other) " -- there is no implicit conversion: write "
       (numeric-conversion-spelling other dominant) " to convert the "
       (kw-name other) " into " (kw-name dominant) ", or "
       (numeric-conversion-spelling dominant other) " to convert the "
       (kw-name dominant) " into " (kw-name other)))
   :default
(defn mixed-numeric-message [op dominant other]
  (str op " operands must share one numeric type; got " (name dominant) " and "
       (name other) " -- there is no implicit conversion: write "
       (numeric-conversion-spelling other dominant) " to convert the "
       (name other) " into " (name dominant) ", or "
       (numeric-conversion-spelling dominant other) " to convert the "
       (name dominant) " into " (name other))))

#?(:kotoba
(defn first-float-type [types [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of types))
    (form/nil-form)
    (let [t (form/nth-of types i)]
      (if (or (form/eq t (form/keyword-form :f64)) (form/eq t (form/keyword-form :f32)))
        t
        (first-float-type types (+ i 1))))))
   :default nil)

#?(:kotoba
(defn numeric-i64-each! [args [:ref :form/r] types [:ref :form/r] i :i64] :i64
  (if (or (>= i (form/count-of args)) (>= i (form/count-of types)))
    0
    (let [_ (require-expression-type! (form/nth-of types i) (form/keyword-form :i64) (form/nth-of args i))]
      (numeric-i64-each! args types (+ i 1)))))
   :default nil)

#?(:kotoba
(defn numeric-mixed-one! [op [:ref :form/r] float-type [:ref :form/r] type [:ref :form/r] arg [:ref :form/r]] :i64
  (if (form/eq type float-type)
    0
    (if (or (form/eq type (form/keyword-form :i64)) (form/eq type (form/keyword-form :f32)) (form/eq type (form/keyword-form :f64)))
      (throw (fe-reject-data (mixed-numeric-message op float-type type) "kotoba.error/numeric-type-mismatch" arg
                             (expected-actual-data float-type type)))
      (require-expression-type! type float-type arg))))
   :default nil)

#?(:kotoba
(defn numeric-float-each! [op [:ref :form/r] float-type [:ref :form/r] args [:ref :form/r] types [:ref :form/r] i :i64] :i64
  (if (or (>= i (form/count-of args)) (>= i (form/count-of types)))
    0
    (let [_ (numeric-mixed-one! op float-type (form/nth-of types i) (form/nth-of args i))]
      (numeric-float-each! op float-type args types (+ i 1)))))
   :default nil)

#?(:kotoba
(defn numeric-final! [op [:ref :form/r] float-type [:ref :form/r] args [:ref :form/r] final :bool] :i64
  (if final
    (throw (fe-reject (str (form-text op) " on " (kw-name float-type) " operands was not resolved to "
                           (form-text (form/form-get (form/form-get (tables/float-arithmetic-resolution) float-type) op))
                           " before the final type check -- the operand types were"
                           " not statically known when the type-directed rewrite"
                           " ran; bind the operands with let, or write the typed"
                           " operation directly")
                      "kotoba.error/numeric-resolution-unresolved"
                      (form/form-seq (form/cons-onto op (form/kids-of args)))))
    0))
   :default nil)

#?(:kotoba
(defn numeric-operand-type! [op [:ref :form/r] args [:ref :form/r] types [:ref :form/r] final :bool] [:ref :form/r]
  (let [float-type (first-float-type types 0)]
    (if (form/is-nil? float-type)
      (let [_ (numeric-i64-each! args types 0)]
        (form/keyword-form :i64))
      (let [_ (numeric-float-each! op float-type args types 0)
            _ (numeric-final! op float-type args final)]
        float-type))))
   :default
(defn numeric-operand-type!
  "The one numeric type every operand of the plain operator OP shares.

  No float operand: the i64 reading, exactly as before this resolution
  existed. Otherwise the FIRST float operand type is the dominant one and every
  other operand must already be that type; a numeric operand of another type
  is rejected with the message that names both types and the explicit
  conversions, carrying `:kotoba.error/expected`/`:actual` so
  `infer-absent-parameter-types` can refine a provisional-i64 parameter to the
  float its sibling operand demands."
  [op args types]
  (let [float-type (first-truthy #{:f64 :f32} types)]
    (if (nil? float-type)
      (do (doseq [[arg type] (map vector args types)]
            (require-expression-type! type :i64 arg))
          :i64)
      (do (doseq [[arg type] (map vector args types)]
            (when-not (= type float-type)
              (if (contains? #{:i64 :f32 :f64} type)
                (reject! (mixed-numeric-message op float-type type) arg
                         :kotoba.error/numeric-type-mismatch
                         {:kotoba.error/expected float-type
                          :kotoba.error/actual type})
                (require-expression-type! type float-type arg))))
          (when *numeric-resolution-final*
            (reject! (str op " on " (name float-type) " operands was not resolved to "
                          (get-in float-arithmetic-resolution [float-type op])
                          " before the final type check -- the operand types were"
                          " not statically known when the type-directed rewrite"
                          " ran; bind the operands with let, or write the typed"
                          " operation directly")
                     (cons op args) :kotoba.error/numeric-resolution-unresolved))
          float-type)))))

#?(:kotoba
(defn ty? [x [:ref :form/r] k :keyword] :bool
  (form/eq x (form/keyword-form k)))
   :default nil)

#?(:kotoba
(defn tk [k :keyword] [:ref :form/r]
  (form/keyword-form k))
   :default nil)

#?(:kotoba
(defn ie-r [type [:ref :form/r] ctx [:ref :ie/ctx]] [:ref :ie/r]
  (record-new [:ref :ie/r] type ctx))
   :default nil)

#?(:kotoba
(defn ie-type [r [:ref :ie/r]] [:ref :form/r]
  (record-get [:ref :ie/r] r :type))
   :default nil)

#?(:kotoba
(defn ie-ctx [r [:ref :ie/r]] [:ref :ie/ctx]
  (record-get [:ref :ie/r] r :ctx))
   :default nil)

#?(:kotoba
(defn ctx-tail? [c [:ref :ie/ctx]] :bool
  (record-get [:ref :ie/ctx] c :tail))
   :default nil)

#?(:kotoba
(defn ctx-tail [c [:ref :ie/ctx] tail :bool] [:ref :ie/ctx]
  (record-assoc [:ref :ie/ctx] c :tail (if tail true false)))
   :default nil)

#?(:kotoba
(defn ctx-final? [c [:ref :ie/ctx]] :bool
  (record-get [:ref :ie/ctx] c :final))
   :default nil)

#?(:kotoba
(defn ctx-schemas [c [:ref :ie/ctx]] [:ref :form/r]
  (record-get [:ref :ie/ctx] c :schemas))
   :default nil)

#?(:kotoba
(defn ctx-row-schemas [c [:ref :ie/ctx]] [:ref :form/r]
  (record-get [:ref :ie/ctx] c :row-schemas))
   :default nil)

#?(:kotoba
(defn ctx-handlers [c [:ref :ie/ctx]] [:ref :form/r]
  (record-get [:ref :ie/ctx] c :handlers))
   :default nil)

#?(:kotoba
(defn ctx-tbl [c [:ref :ie/ctx]] [:ref :form/r]
  (record-get [:ref :ie/ctx] c :tbl))
   :default nil)

#?(:kotoba
(defn ie-tbl-has? [c [:ref :ie/ctx] k :keyword x [:ref :form/r]] :bool
  (tables/table-has? (form/form-get (ctx-tbl c) (form/keyword-form k)) x))
   :default nil)

#?(:kotoba
(defn ie-tbl-get [c [:ref :ie/ctx] k :keyword x [:ref :form/r]] [:ref :form/r]
  (tables/table-get (form/form-get (ctx-tbl c) (form/keyword-form k)) x))
   :default nil)

#?(:kotoba
(defn tput [acc [:list [:ref :form/r]] k :keyword v [:ref :form/r]] [:list [:ref :form/r]]
  (form/append-form (form/append-form acc (form/keyword-form k)) v))
   :default nil)

#?(:kotoba
(defn ie-tables [] [:ref :form/r]
  (let [m1 (form/no-forms)
        m2 (tput m1 :arithmetic (tables/arithmetic))
        m3 (tput m2 :float-division-heads (tables/float-division-heads))
        m4 (tput m3 :i64-operations (tables/i64-operations))
        m5 (tput m4 :i32-operations (tables/i32-operations))
        m6 (tput m5 :comparisons (tables/comparisons))
        m7 (tput m6 :heap-operations (tables/heap-operations))
        m8 (tput m7 :kgraph-operations (tables/kgraph-operations))
        m9 (tput m8 :kernel-memory-operations (tables/kernel-memory-operations))
        m10 (tput m9 :kernel-privileged-operations (tables/kernel-privileged-operations))
        m11 (tput m10 :rodata-literal-operations (tables/rodata-literal-operations))
        m12 (tput m11 :set-operations (tables/set-operations))
        m13 (tput m12 :named-operation-default-results (tables/named-operation-default-results))
        m14 (tput m13 :library-predicate-heads (tables/library-predicate-heads))
        m15 (tput m14 :row-operation-heads (tables/row-operation-heads))
        m16 (tput m15 :document-of-constructors (tables/document-of-constructors))
        m17 (tput m16 :float-arithmetic-resolution (tables/float-arithmetic-resolution))
        m18 (tput m17 :explicit-numeric-conversions (tables/explicit-numeric-conversions))
        m19 (tput m18 :arm-specs (form/edn-form "{bytes-empty [[] :bytes] bytes-count [[:bytes] :i64] bytes-at [[:bytes :i64] :i64] bytes-slice [[:bytes :i64 :i64] :bytes] bytes-concat [[:bytes :bytes] :bytes] bytes-from-vector-i64 [[:vector-i64] :bytes] vector-i64-from-bytes [[:bytes] :vector-i64] string-from-utf8 [[:bytes] :string] kernel-function-address [[] :i64]}"))
