;; Constant alias resolution and lexical substitution for the frontend.
;; Kept separate so native self-analysis can check these transforms independently.
(ns kotoba.compiler.frontend.constant-substitution
  #?(:kotoba {:kotoba/export [resolve-constant-aliases! substitute-constants]})
  (:require #?@(:kotoba [[kotoba.form :as form]])
            [kotoba.compiler.frontend.base :refer [reject! #?@(:kotoba [fl-has? fl-slice fmeta-from])]]
            [kotoba.compiler.frontend.closure-types :refer [type-alias-form?]]
            [kotoba.compiler.frontend.expand :refer [binding-symbols]])
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]] [:phase :string] [:data [:ref :form/r]]]]
                                 :ana/r [:record :ana/r [[:form [:ref :form/r]] [:aux [:ref :form/r]] [:n :i64]]]})))

#?(:kotoba nil :default (declare substitute-bindings substitute-constants))

#?(:kotoba
(defn an-sym-is? [f [:ref :form/r] name :string] :bool
  (and (form/is-symbol? f) (string=? (form/symbol-value f) name)))
   :default nil)

#?(:kotoba
(defn an-set-has? [s [:ref :form/r] x [:ref :form/r]] :bool
  (fl-has? (form/kids-of s) x 0))
   :default nil)

#?(:kotoba
(defn an-set-add [s [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
  (if (an-set-has? s x) s (form/form-set (form/append-form (form/kids-of s) x))))
   :default nil)

#?(:kotoba
(defn an-error [msg :string code :string source [:ref :form/r]] [:ref :fe/err]
  (record-new [:ref :fe/err] msg code source "subset" (form/nil-form)))
   :default nil)

#?(:kotoba
(defn an-fail [bad? :bool msg :string code :string source [:ref :form/r]] :i64
  (if bad? (throw (an-error msg code source)) 0))
   :default nil)

#?(:kotoba
(defn an-r [form [:ref :form/r] aux [:ref :form/r] n :i64] [:ref :ana/r]
  (record-new [:ref :ana/r] form aux n))
   :default nil)

#?(:kotoba
(defn an-r-form [r [:ref :ana/r]] [:ref :form/r] (record-get [:ref :ana/r] r :form))
   :default nil)

#?(:kotoba
(defn an-r-aux [r [:ref :ana/r]] [:ref :form/r] (record-get [:ref :ana/r] r :aux))
   :default nil)

#?(:kotoba
(defn an-seq2 [head :string a [:ref :form/r] b [:ref :form/r]] [:ref :form/r]
  (form/form-seq (form/three-forms (form/symbol-form head) a b)))
   :default nil)

#?(:kotoba
(defn an-resolve-alias [value [:ref :form/r] constants [:ref :form/r] resolving [:ref :form/r]] [:ref :form/r]
  (let [nm (if (form/is-symbol? value) value (form/nth-of value 1))
        u_1 (an-fail (not (form/form-has? constants nm)) "constant alias must name a declared constant" "kotoba.error/subset-reject" value)
        u_2 (an-fail (an-set-has? resolving nm) "constant aliases must be acyclic" "kotoba.error/subset-reject" value)]
    (resolve-constant-aliases! (form/form-get constants nm) constants (an-set-add resolving nm))))
   :default nil)

#?(:kotoba
(defn an-alias-kids [value [:ref :form/r] i :i64 constants [:ref :form/r] resolving [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of value))
    acc
    (an-alias-kids value (+ i 1) constants resolving
                     (form/append-form acc (resolve-constant-aliases! (form/nth-of value i) constants resolving)))))
   :default nil)

#?(:kotoba
;; a constant alias (a symbol or an alias form) resolved to the constant it names, acyclically
(defn resolve-constant-aliases! [value [:ref :form/r] constants [:ref :form/r] resolving [:ref :form/r]] [:ref :form/r]
  (cond
    (type-alias-form? value) (an-resolve-alias value constants resolving)
    (form/is-symbol? value) (an-resolve-alias value constants resolving)
    (form/is-vec? value) (form/form-vec (an-alias-kids value 0 constants resolving (form/no-forms)))
    (form/is-map? value) (form/form-map (an-alias-kids value 0 constants resolving (form/no-forms)))
    :else value))
   :default
(defn resolve-constant-aliases!
  ([value constants] (resolve-constant-aliases! value constants #{}))
  ([value constants resolving]
   (cond
     (type-alias-form? value)
     (let [name (second value)]
       (when-not (contains? constants name)
         (reject! "constant alias must name a declared constant" value))
       (when (contains? resolving name)
         (reject! "constant aliases must be acyclic" value))
       (resolve-constant-aliases! (get constants name) constants (conj resolving name)))
     (symbol? value)
     (do
       (when-not (contains? constants value)
         (reject! "constant alias must name a declared constant" value))
       (when (contains? resolving value)
         (reject! "constant aliases must be acyclic" value))
       (resolve-constant-aliases! (get constants value) constants
                                  (conj resolving value)))
     (vector? value) (mapv #(resolve-constant-aliases! % constants resolving) value)
     (map? value) (into (empty value)
                        (map (fn [[key item]]
                               [(resolve-constant-aliases! key constants resolving)
                                (resolve-constant-aliases! item constants resolving)]))
                        value)
     :else value))))

#?(:kotoba
(defn an-bound-add [bound [:ref :form/r] syms [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of syms))
    bound
    (an-bound-add (an-set-add bound (form/nth-of syms i)) syms (+ i 1))))
   :default nil)

#?(:kotoba
(defn an-sub-pairs [op [:ref :form/r] bindings [:ref :form/r] i :i64 constants [:ref :form/r] bound [:ref :form/r] out [:list [:ref :form/r]]] [:ref :ana/r]
  (if (>= (+ i 1) (form/count-of bindings))
    (an-r (form/form-vec out) bound 0)
    (let [pattern (form/nth-of bindings i)
          value (substitute-constants (form/nth-of bindings (+ i 1)) constants bound)]
      (an-sub-pairs op bindings (+ i 2) constants (an-bound-add bound (binding-symbols pattern) 0)
                    (form/append-form (form/append-form out pattern) value)))))
   :default nil)

#?(:kotoba
;; substitute inside the bindings of a let / loop: the out vector and the bound set after them
(defn substitute-bindings [op [:ref :form/r] bindings [:ref :form/r] constants [:ref :form/r] bound [:ref :form/r]] [:ref :ana/r]
  (let [_ (an-fail (not (and (form/is-vec? bindings) (= 0 (rem (form/count-of bindings) 2))))
                   (if (an-sym-is? op "let") "let requires an even binding vector" "loop requires an even binding vector")
                   "kotoba.error/subset-reject" bindings)]
    (an-sub-pairs op bindings 0 constants bound (form/no-forms))))
   :default
(defn substitute-bindings
  [op bindings constants bound]
  (when-not (and (vector? bindings) (even? (count bindings)))
    (reject! (case op
               let "let requires an even binding vector"
               loop "loop requires an even binding vector")
             bindings))
  (loop [pairs (partition 2 bindings) bound bound out []]
    (if-let [[pattern value] (first pairs)]
      (recur (next pairs)
             (into bound (binding-symbols pattern))
             (conj out pattern (substitute-constants value constants bound)))
      [out bound]))))

#?(:kotoba
(defn an-sub-kids [form [:ref :form/r] i :i64 constants [:ref :form/r] bound [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of form))
    acc
    (an-sub-kids form (+ i 1) constants bound (form/append-form acc (substitute-constants (form/nth-of form i) constants bound)))))
   :default nil)

#?(:kotoba
(defn an-sub-let [form [:ref :form/r] op [:ref :form/r] constants [:ref :form/r] bound [:ref :form/r]] [:ref :form/r]
  (let [sb (substitute-bindings op (form/nth-of form 1) constants bound)
        body (an-sub-kids form 2 constants (an-r-aux sb) (form/no-forms))]
    (form/form-seq (form/cons-onto op (form/cons-onto (an-r-form sb) body)))))
   :default nil)

#?(:kotoba
(defn an-sub-try [form [:ref :form/r] op [:ref :form/r] constants [:ref :form/r] bound [:ref :form/r]] [:ref :form/r]
  (let [n (form/count-of form)
        clause (form/nth-of form 2)
        binder (if (and (form/is-seq? clause) (> (form/count-of clause) 2)) (form/nth-of clause (- (form/count-of clause) 2)) (form/nil-form))]
    (if (and (= n 3) (form/is-seq? clause) (an-sym-is? (form/nth-of clause 0) "catch") (form/is-symbol? binder))
      (an-sub-try-catch form constants bound clause binder)
      (let [kids (an-sub-kids form 1 constants bound (form/no-forms))]
        (form/form-seq (form/cons-onto op kids))))))
   :default nil)

#?(:kotoba
(defn an-sub-try-catch [form [:ref :form/r] constants [:ref :form/r] bound [:ref :form/r] clause [:ref :form/r] binder [:ref :form/r]] [:ref :form/r]
  (let [hbody (form/nth-of clause (- (form/count-of clause) 1))
        head-part (fl-slice (form/kids-of clause) 0 (- (form/count-of clause) 1) (form/no-forms))
        sub-handler (substitute-constants hbody constants (an-set-add bound binder))
        sub-body (substitute-constants (form/nth-of form 1) constants bound)]
    (an-seq2 "try" sub-body (form/form-seq (form/append-form head-part sub-handler)))))
   :default nil)

#?(:kotoba
;; Lexically substitute closed top-level constants without replacing call heads or names shadowed by params/let/loop bindings.
(defn substitute-constants [form [:ref :form/r] constants [:ref :form/r] bound [:ref :form/r]] [:ref :form/r]
  (cond
    (form/is-symbol? form)
    (if (and (not (an-set-has? bound form)) (form/form-has? constants form)) (form/form-get constants form) form)
    (and (form/is-seq? form) (> (form/count-of form) 0))
    (let [op (form/nth-of form 0)
          result (cond
                   (an-sym-is? op "quote") form
                   (or (an-sym-is? op "let") (an-sym-is? op "loop")) (an-sub-let form op constants bound)
                   (an-sym-is? op "try") (an-sub-try form op constants bound)
                   :else (form/form-seq (form/cons-onto op (an-sub-kids form 1 constants bound (form/no-forms)))))]
      (fmeta-from form result))
    (form/is-vec? form) (form/form-vec (an-sub-kids form 0 constants bound (form/no-forms)))
    (form/is-set? form) (form/form-set (an-sub-kids form 0 constants bound (form/no-forms)))
    (form/is-map? form) (form/form-map (an-sub-kids form 0 constants bound (form/no-forms)))
    :else form))
   :default
(defn substitute-constants
  "Lexically substitute closed top-level constants without replacing call
  heads or names shadowed by params/let/loop bindings."
  [form constants bound]
  (cond
    (symbol? form) (if (and (not (contains? bound form))
                            (contains? constants form))
                     (get constants form)
                     form)
    (seq? form)
    (let [[op & args] form
          result (case op
                   quote form
                   (let loop) (let [[bindings & body] args
                                    [bindings' bound'] (substitute-bindings op bindings constants bound)]
                                (list* op bindings'
                                       (map #(substitute-constants % constants bound') body)))
                   ;; The catch binder shadows a constant of the same name in
                   ;; the handler, exactly as a let binding would.
                   try (let [[body clause] args]
                         (if (and (seq? clause) (= 'catch (first clause))
                                  (symbol? (last (butlast clause))))
                           (let [binder (last (butlast clause))
                                 handler (last clause)]
                             (list 'try (substitute-constants body constants bound)
                                   (concat (butlast clause)
                                           [(substitute-constants handler constants (conj bound binder))])))
                           (list* op (map #(substitute-constants % constants bound) args))))
                   (list* op (map #(substitute-constants % constants bound) args)))]
      (if (seq (meta form)) (with-meta result (meta form)) result))
    (vector? form) (mapv #(substitute-constants % constants bound) form)
    (set? form) (set (map #(substitute-constants % constants bound) form))
    (map? form) (into (empty form)
                      (map (fn [[k v]] [(substitute-constants k constants bound)
                                       (substitute-constants v constants bound)]))
                      form)
    :else form)))
