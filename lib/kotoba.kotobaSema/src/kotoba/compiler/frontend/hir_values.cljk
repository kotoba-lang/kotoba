(ns kotoba.compiler.frontend.hir-values
  #?(:kotoba {:kotoba/export [typed? erase-callable-field-types]})
  (:require #?@(:kotoba [[kotoba.form :as form]
                         [kotoba.compiler.frontend.base :refer [fget ftruthy? fmeta-from]]
                         [kotoba.compiler.frontend.closure-types :refer [callable-type? record-type? structured-type?]]]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

#?(:kotoba
(defn- set-has? [set [:ref :form/r] value [:ref :form/r]] :bool
  (form/form-has? set value))
   :default nil)

#?(:kotoba
(defn- param-typed? [types [:ref :form/r] index :i64 scalars [:ref :form/r]] :bool
  (if (>= index (form/count-of types))
    false
    (or (set-has? scalars (form/nth-of types index))
        (structured-type? (form/nth-of types index))
        (param-typed? types (+ index 1) scalars))))
   :default nil)

#?(:kotoba
(defn- body-typed-kids? [node [:ref :form/r] index :i64 heads [:ref :form/r]] :bool
  (if (>= index (form/count-of node))
    false
    (or (body-typed? (form/nth-of node index) heads)
        (body-typed-kids? node (+ index 1) heads))))
   :default nil)

#?(:kotoba
(defn- body-typed? [node [:ref :form/r] heads [:ref :form/r]] :bool
  (or (form/is-string? node) (form/is-keyword? node)
      (and (form/is-seq? node) (> (form/count-of node) 0)
           (set-has? heads (form/nth-of node 0)))
      (body-typed-kids? node 0 heads)))
   :default nil)

#?(:kotoba
(defn- closure-marked? [function [:ref :form/r]] :bool
  (or (> (form/count-of (fget function :closure-param-indexes)) 0)
      (> (form/count-of (fget function :i64-pair-chain-param-indexes)) 0)
      (ftruthy? (fget function :closure-result?))))
   :default nil)

#?(:kotoba
(defn- any-typed-function? [functions [:ref :form/r] index :i64
                            scalars [:ref :form/r] result-scalars [:ref :form/r]
                            heads [:ref :form/r]] :bool
  (if (>= index (form/count-of functions))
    false
    (let [function (form/nth-of functions index)]
      (or (param-typed? (fget function :param-types) 0 scalars)
          (set-has? result-scalars (fget function :result))
          (structured-type? (fget function :result))
          (body-typed? (fget function :body) heads)
          (any-typed-function? functions (+ index 1) scalars result-scalars heads)))))
   :default nil)

#?(:kotoba
(defn- any-closure-marked? [functions [:ref :form/r] index :i64] :bool
  (if (>= index (form/count-of functions))
    false
    (or (closure-marked? (form/nth-of functions index))
        (any-closure-marked? functions (+ index 1)))))
   :default nil)

#?(:kotoba
(defn typed? [ns-info [:ref :form/r] functions [:ref :form/r]
              scalars [:ref :form/r] result-scalars [:ref :form/r]
              heads [:ref :form/r]] :bool
  (or (> (form/count-of (fget ns-info :schemas)) 0)
      (any-closure-marked? functions 0)
      (any-typed-function? functions 0 scalars result-scalars heads)))
   :default nil)

#?(:kotoba
(defn- erase-fields [fields [:ref :form/r] index :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= index (form/count-of fields))
    acc
    (let [field (form/nth-of fields index)
          type (form/nth-of field 1)]
      (erase-fields fields (+ index 1)
                    (form/append-form
                     acc
                     (form/vec2 (form/nth-of field 0)
                                (if (callable-type? type)
                                  (form/keyword-form :i64)
                                  (erase-callable-field-types type))))))))
   :default nil)

#?(:kotoba
(defn- all-pairs? [fields [:ref :form/r] index :i64] :bool
  (if (>= index (form/count-of fields))
    true
    (and (form/is-vec? (form/nth-of fields index))
         (= 2 (form/count-of (form/nth-of fields index)))
         (all-pairs? fields (+ index 1)))))
   :default nil)

#?(:kotoba
(defn- any-callable-field? [fields [:ref :form/r] index :i64] :bool
  (if (>= index (form/count-of fields))
    false
    (or (callable-type? (form/nth-of (form/nth-of fields index) 1))
        (any-callable-field? fields (+ index 1)))))
   :default nil)

#?(:kotoba
(defn- erase-descriptor? [node [:ref :form/r]] :bool
  (and (record-type? node)
       (> (form/count-of node) 2)
       (form/is-keyword? (form/nth-of node 1))
       (form/is-vec? (form/nth-of node 2))
       (all-pairs? (form/nth-of node 2) 0)
       (any-callable-field? (form/nth-of node 2) 0)))
   :default nil)

#?(:kotoba
(defn- erase-kids [node [:ref :form/r] index :i64 values-only? :bool
                   acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= index (form/count-of node))
    acc
    (erase-kids node (+ index 1) values-only?
                (form/append-form
                 acc
                 (if (and values-only? (= 0 (rem index 2)))
                   (form/nth-of node index)
                   (erase-callable-field-types (form/nth-of node index)))))))
   :default nil)

#?(:kotoba
(defn- set-nth-from [node [:ref :form/r] index :i64 at :i64
                     value [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= index (form/count-of node))
    acc
    (set-nth-from node (+ index 1) at value
                  (form/append-form acc (if (= index at) value (form/nth-of node index))))))
   :default nil)

#?(:kotoba
(defn- set-nth [node [:ref :form/r] at :i64 value [:ref :form/r]] [:ref :form/r]
  (form/form-vec (set-nth-from node 0 at value (form/no-forms))))
   :default nil)

#?(:kotoba
(defn erase-callable-field-types [node [:ref :form/r]] [:ref :form/r]
  (cond
    (erase-descriptor? node)
    (fmeta-from node (set-nth node 2 (form/form-vec (erase-fields (form/nth-of node 2) 0 (form/no-forms)))))
    (form/is-map? node) (fmeta-from node (form/form-map (erase-kids node 0 true (form/no-forms))))
    (form/is-vec? node) (fmeta-from node (form/form-vec (erase-kids node 0 false (form/no-forms))))
    (form/is-seq? node) (fmeta-from node (form/form-seq (erase-kids node 0 false (form/no-forms))))
    :else node))
   :default nil)
