(ns kotoba.compiler.frontend.infer-bridge
  "Narrow Kotoba-only import surface for the frontend analyzer's inference passes."
  {:kotoba/export [abort-signatures abort-type-text check-loop-recur-argument-types!
                   check-value-types! elaborate-aborts elaborate-named-abilities
                   infer-abort-error-types infer-absent-parameter-types
                   infer-absent-results infer-closure-refinements infer-type-or-nil
                   ie-new-ctx legacy-absence resolve-absence-if
                   resolve-loop-helper-param-types same-expression-type?
                   use-site-text zip-locals infer-loop-helper-results
                   absence-in-tail?]}
  (:require [kotoba.compiler.frontend.infer :as infer]
            [kotoba.compiler.frontend.infer-closure :as closure]
            [kotoba.compiler.frontend.infer-passes :as passes]
            [kotoba.compiler.frontend.infer-loop :as infer-loop]
            [kotoba.compiler.frontend.infer-loop-recur :as infer-loop-recur]
            [kotoba.compiler.frontend.infer-loop-params :as infer-loop-params])
  #?(:kotoba
     (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                :ie/ctx [:record :ie/ctx [[:schemas [:ref :form/r]] [:row-schemas [:ref :form/r]]
                                          [:handlers [:ref :form/r]] [:final :bool] [:tail :bool]
                                          [:names [:ref :form/r]] [:recording :bool]
                                          [:recorded [:ref :form/r]] [:collect :bool]
                                          [:throws [:list [:ref :form/r]]]
                                          [:known [:ref :form/r]] [:tbl [:ref :form/r]]
                                          [:rec-limit :i64] [:rec-count :i64]]]})))

#?(:kotoba
   (defn infer-closure-refinements [ctx [:ref :ie/ctx] functions [:ref :form/r]
                                    lambda-infos [:ref :form/r]] [:ref :form/r]
     (closure/infer-closure-refinements ctx functions lambda-infos))
   :default nil)

#?(:kotoba
   (defn infer-type-or-nil [ctx [:ref :ie/ctx] form [:ref :form/r]
                            locals [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
     (passes/infer-type-or-nil ctx form locals sigs))
   :default nil)

#?(:kotoba
   (defn abort-signatures [functions [:ref :form/r]] [:ref :form/r]
     (passes/abort-signatures functions))
   :default nil)

#?(:kotoba
   (defn abort-type-text [type [:ref :form/r]] :string
     (passes/abort-type-text type))
   :default nil)

#?(:kotoba
   (defn resolve-absence-if [ctx [:ref :ie/ctx] form [:ref :form/r]
                             locals [:ref :form/r] sigs [:ref :form/r]
                             statement? :bool] [:ref :form/r]
     (passes/resolve-absence-if ctx form locals sigs statement?))
   :default nil)

#?(:kotoba
   (defn infer-absent-results [ctx [:ref :ie/ctx] functions [:ref :form/r]] [:ref :form/r]
     (passes/infer-absent-results ctx functions))
   :default nil)

#?(:kotoba
   (defn infer-absent-parameter-types [ctx [:ref :ie/ctx] functions [:ref :form/r]] [:ref :form/r]
     (passes/infer-absent-parameter-types ctx functions))
   :default nil)

#?(:kotoba
   (defn infer-abort-error-types [ctx [:ref :ie/ctx] functions [:ref :form/r]] [:ref :form/r]
     (passes/infer-abort-error-types ctx functions))
   :default nil)

#?(:kotoba
   (defn elaborate-aborts [ctx [:ref :ie/ctx] functions [:ref :form/r]
                           abort-error-types [:ref :form/r]] [:ref :form/r]
     (passes/elaborate-aborts ctx functions abort-error-types))
   :default nil)

#?(:kotoba
   (defn check-value-types! [ctx [:ref :ie/ctx] functions [:ref :form/r]] :i64
     (passes/check-value-types! ctx functions))
   :default nil)

#?(:kotoba
   (defn elaborate-named-abilities [ctx [:ref :ie/ctx] functions [:ref :form/r]] [:ref :form/r]
     (passes/elaborate-named-abilities ctx functions))
   :default nil)

#?(:kotoba
   (defn infer-loop-helper-results [ctx [:ref :ie/ctx] functions [:ref :form/r]
                                    shapes [:ref :form/r]] [:ref :form/r]
     (infer-loop/infer-loop-helper-results ctx functions shapes))
   :default nil)

#?(:kotoba
   (defn check-loop-recur-argument-types! [ctx [:ref :ie/ctx] functions [:ref :form/r]
                                           shapes [:ref :form/r]] [:ref :form/r]
     (infer-loop-recur/check-loop-recur-argument-types! ctx functions shapes))
   :default nil)

#?(:kotoba
   (defn resolve-loop-helper-param-types [ctx [:ref :ie/ctx] functions [:ref :form/r]
                                          shapes [:ref :form/r]] [:ref :form/r]
     (infer-loop-params/resolve-loop-helper-param-types ctx functions shapes))
   :default nil)

#?(:kotoba
   (defn absence-in-tail? [form [:ref :form/r]] :bool
     (infer/absence-in-tail? form))
   :default nil)

#?(:kotoba
   (defn ie-new-ctx [schemas [:ref :form/r] row-schemas [:ref :form/r]
                     handlers [:ref :form/r]] [:ref :ie/ctx]
     (infer/ie-new-ctx schemas row-schemas handlers))
   :default nil)

#?(:kotoba
   (defn legacy-absence [marker [:ref :form/r]] [:ref :form/r]
     (infer/legacy-absence marker))
   :default nil)

#?(:kotoba
   (defn same-expression-type? [actual [:ref :form/r] expected [:ref :form/r]] :bool
     (infer/same-expression-type? actual expected))
   :default nil)

#?(:kotoba
   (defn use-site-text [form [:ref :form/r]] :string
     (infer/use-site-text form))
   :default nil)

#?(:kotoba
   (defn zip-locals [params [:ref :form/r] ptypes [:ref :form/r]] [:ref :form/r]
     (infer/zip-locals params ptypes))
   :default nil)
