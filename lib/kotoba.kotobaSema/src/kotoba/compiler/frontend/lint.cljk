(ns kotoba.compiler.frontend.lint
  #?(:kotoba {:kotoba/export [lint lint-forms]})
  (:require [kotoba.form :as form]
            [kotoba.compiler.frontend.analyze :as analyze]
            [kotoba.compiler.frontend.base :refer [form-span #?@(:kotoba [fget fkw fput form-text simple-symbol-form?])]]
            [kotoba.compiler.frontend.expand :refer [kotoba-integer?]]
            [kotoba.compiler.frontend.infer :refer [use-site-text]])
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                         :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]]
                                                   [:phase :string] [:data [:ref :form/r]]]]
                         :ana/ir [:record :ana/ir [[:ok :bool] [:val [:ref :form/r]] [:err [:ref :fe/err]]]]
                         :lint/frame [:record :lint/frame [[:node [:ref :form/r]]
                                                           [:parent [:ref :form/r]]
                                                           [:parent-plus :bool]]]})))

#?(:kotoba
(defn- sym-is? [value [:ref :form/r] name :string] :bool
  (and (form/is-symbol? value) (string=? (form/symbol-value value) name)))
   :default nil)

#?(:kotoba
(defn- has-dunder? [text :string] :bool
  (>= (string-index-of-from text "__" 0) 0))
   :default nil)

#?(:kotoba
(defn- zero-literal? [value [:ref :form/r]] :bool
  (and (kotoba-integer? value) (= 0 (form/int-value value))))
   :default nil)

#?(:kotoba
(defn- sunk-call-form? [value [:ref :form/r]] :bool
  (and (form/is-seq? value)
       (> (form/count-of value) 0)
       (simple-symbol-form? (form/nth-of value 0))
       (not (or (sym-is? (form/nth-of value 0) "if")
                (sym-is? (form/nth-of value 0) "let")
                (sym-is? (form/nth-of value 0) "do")
                (sym-is? (form/nth-of value 0) "fn")
                (sym-is? (form/nth-of value 0) "quote")))))
   :default nil)

#?(:kotoba
(defn- zero-multiply? [value [:ref :form/r]] :bool
  (and (form/is-seq? value)
       (= 3 (form/count-of value))
       (sym-is? (form/nth-of value 0) "*")
       (let [a (form/nth-of value 1)
             b (form/nth-of value 2)]
         (or (and (zero-literal? a) (sunk-call-form? b))
             (and (zero-literal? b) (sunk-call-form? a))))))
   :default nil)

#?(:kotoba
(defn- span-map [span :i64] [:ref :form/r]
  (fput (fput (form/form-map (form/no-forms)) :line
              (form/int-form (quot span 4294967296)))
        :column (form/int-form (rem span 4294967296))))
   :default nil)

#?(:kotoba
(defn- finding-message [site [:ref :form/r] function [:ref :form/r]
                        call [:ref :form/r]] :string
  (string-concat
   (use-site-text site)
   (string-concat " in "
    (string-concat
     (form-text function)
     (string-concat " sequences "
      (string-concat
       (use-site-text call)
       (string-concat " by multiplying it by zero: "
        (string-concat
         (form-text (form/nth-of call 0))
         " runs for its effect and its value is discarded"))))))))
   :default nil)

#?(:kotoba
(defn- lint-note [function [:ref :form/r] site [:ref :form/r]
                  product [:ref :form/r] acc [:list [:ref :form/r]]]
  [:list [:ref :form/r]]
  (let [a (form/nth-of product 1)
        b (form/nth-of product 2)
        call (if (sunk-call-form? a) a b)
        span (form-span site)
        finding (fput
                 (fput
                  (fput
                   (fput
                    (fput
                     (fput (form/form-map (form/no-forms))
                           :code (fkw "kotoba.lint/zero-multiply-sequencing"))
                     :severity (fkw "warning"))
                    :function function)
                   :sunk-call (form/nth-of call 0))
                  :message (form/string-form (finding-message site function call)))
                 :span (if (= span 0) (form/nil-form) (span-map span)))]
    (form/append-form
     acc
     (if (= span 0)
       (form/dissoc-form finding (form/keyword-form :span))
       finding))))
   :default nil)

#?(:kotoba
(defn- walk-frame [node [:ref :form/r] parent [:ref :form/r]
                   parent-plus? :bool] [:ref :lint/frame]
  (record-new [:ref :lint/frame] node parent parent-plus?))
   :default nil)

#?(:kotoba
(defn- push-children [pending [:list [:ref :lint/frame]]
                      parent [:ref :form/r] start :i64 parent-plus? :bool]
  [:list [:ref :lint/frame]]
  (loop [index (- (form/count-of parent) 1) output pending]
    (if (< index start)
      output
      (recur (- index 1)
             (typed-list-conj [:list [:ref :lint/frame]] output
                              (walk-frame (form/nth-of parent index)
                                          parent parent-plus?))))))
   :default nil)

#?(:kotoba
(defn- drop-last-frame [pending [:list [:ref :lint/frame]]]
  [:list [:ref :lint/frame]]
  (let [length (vector-count pending)]
    (loop [index 0 output (typed-list-new [:list [:ref :lint/frame]])]
      (if (>= index (- length 1))
        output
        (recur (+ index 1)
               (typed-list-conj [:list [:ref :lint/frame]] output
                                (typed-list-nth [:list [:ref :lint/frame]] pending index)))))))
   :default nil)

#?(:kotoba
(defn- collection-form? [value [:ref :form/r]] :bool
  (or (form/is-seq? value) (form/is-vec? value)
      (form/is-set? value) (form/is-map? value)))
   :default nil)

#?(:kotoba
(defn- walk-findings [function [:ref :form/r]
                      pending [:list [:ref :lint/frame]]
                      findings [:list [:ref :form/r]]]
  [:ref :form/r]
  (if (= (vector-count pending) 0)
    (form/form-vec findings)
    (let [frame (typed-list-nth [:list [:ref :lint/frame]] pending
                                (- (vector-count pending) 1))
          node (record-get [:ref :lint/frame] frame :node)
          parent (record-get [:ref :lint/frame] frame :parent)
          parent-plus? (record-get [:ref :lint/frame] frame :parent-plus)
          multiply? (zero-multiply? node)
          plus? (and (not multiply?) (form/is-seq? node)
                     (> (form/count-of node) 0)
                     (sym-is? (form/nth-of node 0) "+"))
          findings-next (if multiply?
                          (lint-note function (if parent-plus? parent node)
                                     node findings)
                          findings)
          pending-rest (drop-last-frame pending)
          pending-next (if (collection-form? node)
                         (push-children pending-rest node
                                        (if multiply? 1 0)
                                        (and (not multiply?) plus?))
                         pending-rest)]
      (walk-findings function pending-next findings-next))))
   :default nil)

#?(:kotoba
(defn- zero-multiply-findings [function [:ref :form/r] body [:ref :form/r]]
  [:ref :form/r]
  (walk-findings function
                 (typed-list-conj [:list [:ref :lint/frame]]
                                  (typed-list-new [:list [:ref :lint/frame]])
                                  (walk-frame body body false))
                 (form/no-forms)))
   :default nil)

#?(:kotoba
(defn- lint-functions [functions [:ref :form/r] index :i64
                       findings [:list [:ref :form/r]]]
  [:ref :form/r]
  (if (>= index (form/count-of functions))
    (form/form-vec findings)
    (let [function (form/nth-of functions index)
          name (fget function :name)
          next-findings (if (has-dunder? (form-text name))
                          findings
                          (form/append-many
                           findings
                           (form/kids-of (zero-multiply-findings name
                                                                  (fget function :body)))))]
      (lint-functions functions (+ index 1) next-findings))))
   :default nil)

#?(:kotoba
(defn- lint-result [analysis [:ref :ana/ir]] [:ref :ana/ir]
  (if (record-get [:ref :ana/ir] analysis :ok)
    (record-new [:ref :ana/ir]
                true
                (lint-functions
                 (fget (record-get [:ref :ana/ir] analysis :val) :functions)
                 0 (form/no-forms))
                (record-get [:ref :ana/ir] analysis :err))
    analysis))
   :default nil)

#?(:kotoba
(defn lint [source :string opts [:ref :form/r]] [:ref :ana/ir]
  (lint-result (analyze/analyze source opts)))
   :default nil)

#?(:kotoba
(defn lint-forms [source-forms [:ref :form/r] opts [:ref :form/r]]
  [:ref :ana/ir]
  (lint-result (analyze/analyze-forms* source-forms opts)))
   :default nil)
