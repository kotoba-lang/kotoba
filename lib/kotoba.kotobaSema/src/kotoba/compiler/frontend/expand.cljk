(ns kotoba.compiler.frontend.expand
  "Module `expand` of kotoba.compiler.frontend, cut from the original namespace by amu refactor split (57 forms, 1564 lines). Depends on: base, closure-types."
  ;; the Kotoba-route interface: the names the other frontend modules, kotoba.sema and the native guests use
  ;; (the linked project export bound is 1024 clauses, ADR 0363 port)
  #?(:kotoba {:kotoba/export [all-distinct? binding-symbols expand-closed-multimethod-forms expand-defn-parts expand-record-protocol-forms expand-state-ability-forms kotoba-integer? max-function-docstring-chars max-parameters max-symbol-chars preserve-form-meta rewrite-pure-application-forms state-rebuild-seq valid-name? variadic-params?]})
  (:require #?@(:kotoba [] :default [[kotoba.lang.coll :as set]])
            [kotoba.lang.text :as str]
            [kotoba.compiler.frontend-tables :as tables]
            #?@(:kotoba [[kotoba.form :as form]])
            #?@(:cljs [[kotoba.kir.cljs-i64 :as i64]])
            [kotoba.compiler.frontend.base :refer [capability-registry #?@(:kotoba [] :default [reject!]) #?@(:kotoba [fdistinct? fdrop fget fhas? fhead fhead-is? fkw fl-add fl-distinct? fl-drop fl-has? fl-nth fl-slice fmeta-from fname fnamespace fprivate-symbol? frebuild-seq fput fsym fsymbols-into ftruthy? fwith-source-head form-text pr-form simple-symbol-form?] :default [first-truthy])]]
            [kotoba.compiler.frontend.closure-types :refer [callable-type? max-record-fields record-type? resolve-type-alias! structured-type? type-alias-form? typed-param-parts validate-value-type! variant-type?]])
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]
                                 ;; a refusal: the Kotoba-route `reject!` throws one (ADR 0007)
                                 :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]] [:phase :string] [:data [:ref :form/r]]]]
                                 ;; the desugar env and its results (docs/selfhost-frontend-typemodel-design.md 1.2)
                                 :fe/env [:record :fe/env [[:counter :i64] [:result [:ref :form/r]] [:none :bool] [:arities [:ref :form/r]] [:lexical [:ref :form/r]] [:types [:ref :form/r]] [:docfns [:ref :form/r]] [:loop-counter :i64] [:tbl [:ref :form/r]] [:schemas [:ref :form/r]] [:lazy :bool] [:abort-ctx :string] [:used-caps [:ref :form/r]] [:options [:ref :form/r]] [:helpers [:ref :form/r]] [:shapes [:ref :form/r]] [:lambda-counter :i64] [:lambdas [:ref :form/r]] [:loop-result [:ref :form/r]] [:loop-known [:ref :form/r]] [:dispatchers [:ref :form/r]] [:uses-apply :bool] [:uses-lazy :bool] [:contracts [:ref :form/r]]]]
                                 :fe/dr [:record :fe/dr [[:env [:ref :fe/env]] [:form [:ref :form/r]]]]
                                 :fe/drs [:record :fe/drs [[:env [:ref :fe/env]] [:forms [:list [:ref :form/r]]]]]})))

;; forward references inside this module (the cut keeps the original form order)
#?(:kotoba nil :default (declare rewrite-state-ability-form binding-symbols rewrite-record-constructors rewrite-record-member-access*))


#?(:kotoba
   (defn member-of? [xs [:list [:ref :form/r]] x [:ref :form/r] i :i64 end :i64] :bool
     (if (>= i end)
       false
       (if (form/eq (typed-list-nth [:list [:ref :form/r]] xs i) x) true (member-of? xs x (+ i 1) end))))
   :default nil)
#?(:kotoba
   (defn max-arity-clauses [] :i64 8)
   :default
(def max-arity-clauses 8))
#?(:kotoba
   (defn max-parameters [] :i64 64)
   :default
(def max-parameters 64))
#?(:kotoba
   (defn max-symbol-chars [] :i64 128)
   :default
(def max-symbol-chars 128))
#?(:kotoba
   (defn max-function-docstring-chars [] :i64 65536)
   :default
(def max-function-docstring-chars 65536))

#?(:kotoba
   (defn kotoba-integer? [form [:ref :form/r]] :bool (form/is-int? form))
   :default
(defn kotoba-integer?
  "True for a value that is (or stands for) a `.kotoba` integer literal --
  plain `integer?` on `:clj`. On `:cljs` a literal may be EITHER a JS
  `bigint` (read from `.kotoba` source via `kotoba.compiler.kotoba-reader`)
  OR a plain cljs number (synthesized directly by this namespace's own
  desugaring, e.g. `desugar-and`'s vacuous `1`, `when`'s trailing `0`, `get`'s
  default `0` -- ordinary Clojure literals in THIS file's source, never
  routed through the reader) -- both are valid until
  `kotoba.kir/eval-expr` coerces every literal to `bigint` via
  `cljs-i64/->bigint` at the single point it enters the runtime value
  stream. Plain cljs `integer?`/`int?` do not recognize `bigint`
  (confirmed live), so this checks both forms explicitly."
  [form]
  #?(:clj (integer? form) :cljs (or (i64/bigint-value? form) (integer? form)))))

;; ADR-544 step 1 (pure S-expression core + cljk surface): the pure head set
;; (lam app rel query perform handle ref) is admitted as DESUGARING source
;; forms. Each admitted head lowers onto machinery the frontend already has,
;; so NOTHING new reaches validation, inference or any backend -- a pure-head
;; module produces the HIR its clojure-shaped twin produces.
;;
;;   (lam [params] body...)   -> (fn [params] body...)      lambda lift
;;   (app f a...)             -> (f a...)                   prefix application
;;   (ref name)               -> name                       definition reference
;;   (perform :kind/op v...)  -> (cap-call :kind/op v...)    capability call
;;
;; `rel query handle` are NOT given a lowering here. They stay rejected with
;; `operation has no admitted lowering`. Naming them in this comment is not
;; admitting them: `rel`/`query` need a relational value model this compiler
;; does not have, and `handle` needs an effect handler, which is a different
;; thing from the abort ability's `try`/`catch` (lang/abort-ability.edn) and
;; has no primitive to desugar onto. A head with no existing primitive cannot
;; be "desugared to existing primitives", so it waits.
;;
;; `ref` is deliberately narrow. It takes ONE simple symbol and evaluates to
;; that symbol -- it is the pure spelling of naming a definition, not a
;; content-address dereference. `(ref cid:...)` from the ADR's identity
;; pipeline is a later slice and needs the retrieved-definition machinery;
;; admitting a wider `ref` now would mean admitting a spelling whose meaning
;; is not yet decided.
;;
;; `perform` is the pure spelling of `cap-call` and carries exactly its
;; authority -- no more. The capability keyword is resolved by the existing
;; `resolve-capability-keyword!` against the registry, the namespace's
;; declared `:capabilities` set is checked against it by the existing
;; declare-then-check, and because this rewrite runs BEFORE
;; `check-pure-product-source-forms!` a `perform` in a `:pure-product` module
;; is already a `cap-call` when that check reads the tree -- so it is refused
;; by the head set that already refuses `cap-call`, with no second list to
;; keep in step. The NUMERIC id form is not admitted: wire ids are ABI, not
;; source vocabulary (ADR-2607279200 Consequences).
;;
;; The rewrite runs on the SEXPR tree right after read-forms, BEFORE
;; reject-reserved-source-symbols! and check-pure-product-source-forms!, so
;; the rest of the compiler (desugar, validate, lift-lambda) sees only the
;; already-lowered forms. Per the language's structural semantics, `quote` is
;; skipped (it is structural-only; a quoted lam is not a call).


#?(:kotoba nil :default
(def ^:dynamic *pure-definition-names*
  "The top-level names a module defines, collected before the pure-head
  rewrite walks it. `(ref name)` is admitted only for a name in this set.

  Why the restriction exists, and why it is not incidental: `ref` is ALSO
  Clojure's STM constructor, and this language forbids it --
  `lang/surface-status.edn` `:no-ambient-mutation` names `ref` on the
  `:authority` shielding axis and `lang/guest-grammar.edn` `:forbidden-heads`
  lists it beside `dosync`, `locking`, `volatile!`, `var` and `binding`.
  Because this rewrite runs BEFORE `forbidden-heads` is consulted, an
  unrestricted pure `ref` would silently take that refusal away: measured
  2026-09-06 against kotoba-sema a2f86f87, `(let [r (ref n)] n)` was
  ADMITTED, where before slice 2 it was refused
  `dynamic loading, interop, mutation, and metaprogramming are forbidden`.

  A definition name is the one shape the two readings do not share. STM's
  `(ref x)` takes an INITIAL VALUE; ADR-544's `(ref name)` names a
  definition. Restricting to names the module actually defines keeps the pure
  reading and gives every other shape its security refusal back.

  Names introduced by `defrecord` / `defmulti` / `defdesugar` expansion are
  NOT here: those passes run after this one. `(ref <generated-name>)` is
  refused, which is the fail-closed direction."))

;; A refusal is an abort (ADR 0007). An aborting function imported from another module passes its
;; abort on through a plain call (ADR 0363), so validate-value-type!, resolve-type-alias! and
;; typed-param-parts are called directly.
#?(:kotoba
   (defn fe-reject [msg :string code :string form [:ref :form/r]] [:ref :fe/err]
     (record-new [:ref :fe/err] msg code form "subset" (form/nil-form)))
   :default nil)

#?(:kotoba
   (defn require-k [ok :bool msg :string code :string form [:ref :form/r]] :i64
     (if ok 0 (throw (fe-reject msg code form))))
   :default nil)


;; ---- pure application heads (lam app ref rel query handle perform) ----
;; The Kotoba reading over Form records. `*pure-definition-names*` is the NAMES argument
;; (a Form list of the module's top-level definition names). The native pre-scan leaves a
;; top-level form untouched when it contains none of the heads this pass rewrites.

#?(:kotoba
   (defn state-ability-operations [] [:ref :form/r]
     (form/edn-form "{:state/get 0 :state/put 1}"))
   :default nil)

#?(:kotoba
   (defn state-ability-perform-form? [form [:ref :form/r]] :bool
     (and (fhead-is? form "perform")
          (form/form-has? (state-ability-operations) (form/nth-of form 1))))
   :default nil)

#?(:kotoba
   (defn state-ability-handle-form? [form [:ref :form/r]] :bool
     (and (fhead-is? form "handle") (= 3 (form/count-of form))
          (fhead-is? (form/nth-of form 2) "with")))
   :default nil)

#?(:kotoba
   (defn- ex-rewrite-kids [kids [:list [:ref :form/r]] i :i64 names [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count kids))
       acc
       (ex-rewrite-kids kids (+ i 1) names (form/append-form acc (rewrite-pure-app-form (fl-nth kids i) names)))))
   :default nil)

;; the rewritten forms of the arguments after the head
#?(:kotoba
   (defn- ex-rewrite-args [form [:ref :form/r] names [:ref :form/r]] [:list [:ref :form/r]]
     (ex-rewrite-kids (form/kids-of form) 1 names (form/no-forms)))
   :default nil)

#?(:kotoba
   (defn rewrite-pure-app-form [form [:ref :form/r] names [:ref :form/r]] [:ref :form/r]
     (cond
       (form/is-seq? form)
       (let [head (fhead form)]
         (cond
           (string=? head "quote") form
           (or (state-ability-perform-form? form) (state-ability-handle-form? form))
           (frebuild-seq form (ex-rewrite-kids (form/kids-of form) 0 names (form/no-forms)))
           (string=? head "lam")
           (fmeta-from form (form/form-seq (form/cons-onto (fsym "fn") (ex-rewrite-args form names))))
           (string=? head "app")
           ;; `(app)` used to rewrite to `()`; the operator is what is absent, so say so here
           (let [ok (require-k (> (form/count-of form) 1) "app requires an operator: (app f arg ...)"
                               "kotoba.error/pure-app-operator" form)]
             (fmeta-from form (form/form-seq (ex-rewrite-args form names))))
           (string=? head "ref")
           (let [ok (require-k (and (= 2 (form/count-of form))
                                    (simple-symbol-form? (form/nth-of form 1))
                                    (fl-has? (form/kids-of names) (form/nth-of form 1) 0))
                               (str "ref names one definition this module defines: "
                                    "(ref name). Every other shape of `ref` is Clojure's "
                                    "STM constructor, and state must not be ambient")
                               "kotoba.error/ambient-forbidden" form)]
             (fmeta-from form (form/nth-of form 1)))
           (string=? head "rel")
           (let [ok (require-k (= 4 (form/count-of form)) "rel asserts one datom: (rel entity attribute value)"
                               "kotoba.error/pure-rel-arity" form)]
             (fmeta-from form (form/form-seq (form/cons-onto (fsym "kgraph-assert!") (ex-rewrite-args form names)))))
           (string=? head "query")
           (let [ok (require-k (= 3 (form/count-of form))
                               (str "query reads one datom: (query entity attribute). "
                                    "It is a point read, not a pattern query -- there is "
                                    "no relational pattern form in this language yet")
                               "kotoba.error/pure-query-arity" form)]
             (fmeta-from form (form/form-seq (form/cons-onto (fsym "kgraph-get") (ex-rewrite-args form names)))))
           (string=? head "handle")
           (fwith-source-head (fmeta-from form (form/form-seq (form/cons-onto (fsym "try") (ex-rewrite-args form names)))) "handle")
           (string=? head "perform")
           (let [ok (require-k (and (> (form/count-of form) 1)
                                    (form/is-keyword? (form/nth-of form 1))
                                    (not (string=? (fnamespace (form/nth-of form 1)) "")))
                               (str "perform names one registered capability keyword: "
                                    "(perform :kind/op value ...)")
                               "kotoba.error/pure-perform-capability" form)
                 rewritten-args (ex-rewrite-kids (form/kids-of form) 2 names (form/no-forms))
                 rewritten (form/form-seq (form/cons-onto (fsym "cap-call") (form/cons-onto (form/nth-of form 1) rewritten-args)))]
             ;; The head the AUTHOR wrote stays on the rewritten form, so a refusal names it
             (fwith-source-head (fmeta-from form rewritten) "perform"))
           :else
           (frebuild-seq form (ex-rewrite-kids (form/kids-of form) 0 names (form/no-forms)))))
       (or (form/is-vec? form) (form/is-map? form))
       (record-assoc [:ref :form/r] form :kids (ex-rewrite-kids (form/kids-of form) 0 names (form/no-forms)))
       :else form))
   :default nil)

;; the names a module's top level defines, read syntactically
#?(:kotoba
   (defn- ex-definition-names [forms [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count forms))
       acc
       (let [f (fl-nth forms i)
             h (fhead f)]
         (ex-definition-names forms (+ i 1)
                              (if (and (or (string=? h "def") (string=? h "defn") (string=? h "defn-"))
                                       (simple-symbol-form? (form/nth-of f 1)))
                                (form/append-form acc (form/nth-of f 1))
                                acc)))))
   :default nil)

#?(:kotoba
   (defn top-level-definition-names [forms [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (ex-definition-names forms 0 (form/no-forms)))
   :default nil)

#?(:kotoba
   (defn- ex-contains-pure-app-head-kids? [kids [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count kids))
       false
       (or (ex-contains-pure-app-head? (fl-nth kids i))
           (ex-contains-pure-app-head-kids? kids (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn- ex-contains-pure-app-head? [form [:ref :form/r]] :bool
     (cond
       (form/is-seq? form)
       (if (fhead-is? form "quote")
         false
         (or (fhead-is? form "lam")
             (fhead-is? form "app")
             (fhead-is? form "ref")
             (fhead-is? form "rel")
             (fhead-is? form "query")
             (fhead-is? form "handle")
             (fhead-is? form "perform")
             (ex-contains-pure-app-head-kids? (form/kids-of form) 0)))
       (or (form/is-vec? form) (form/is-map? form))
       (ex-contains-pure-app-head-kids? (form/kids-of form) 0)
       :else false))
   :default nil)

#?(:kotoba
   (defn- ex-rewrite-forms [forms [:list [:ref :form/r]] i :i64 names [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count forms))
       acc
       (let [form (fl-nth forms i)
             rewritten (if (ex-contains-pure-app-head? form)
                         (rewrite-pure-app-form form names)
                         form)]
         (ex-rewrite-forms forms (+ i 1) names (form/append-form acc rewritten)))))
   :default nil)

#?(:kotoba
   (defn rewrite-pure-application-forms [forms [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (ex-rewrite-forms forms 0 (form/form-vec (top-level-definition-names forms)) (form/no-forms)))
   :default nil)

;; The ONE expression a `defn` / `defn-` / `fn` body is, from the one or more forms the author
;; wrote: several collapse to `do`, which takes the first form's location
#?(:kotoba
   (defn implicit-do-body [forms [:list [:ref :form/r]]] [:ref :form/r]
     (if (= 1 (vector-count forms))
       (fl-nth forms 0)
       (let [collapsed (form/form-seq (form/cons-onto (fsym "do") forms))
             first-span (form/span-of (fl-nth forms 0))]
         (if (= 0 first-span) collapsed (record-assoc [:ref :form/r] collapsed :span first-span)))))
   :default nil)

;; One monomorphic [params body] for a `[fixed ... & rest]` clause at ARITY. PARTS is a Form map
;; {:fixed :rest-name :body :min-arity}; the surplus arguments become positional parameters named
;; under PREFIX and REST is bound to the `(list ...)` of exactly those
#?(:kotoba
   (defn- ex-extras [prefix :string i :i64 n :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i n)
       acc
       (ex-extras prefix (+ i 1) n (form/append-form acc (fsym (string-concat prefix (string-from-i64 i)))))))
   :default nil)

#?(:kotoba
   (defn specialize-variadic-clause [parts [:ref :form/r] arity :i64 prefix :string] [:ref :form/r]
     (let [fixed (fget parts :fixed)
           base (if (fhas? parts :min-arity) (form/int-value (fget parts :min-arity)) (form/count-of fixed))
           extras (ex-extras prefix 0 (- arity base) (form/no-forms))]
       (form/vec2 (form/form-vec (form/append-many (form/kids-of fixed) extras))
                  (form/call2 "let" (form/vec2 (fget parts :rest-name) (form/form-seq (form/cons-onto (fsym "list") extras)))
                              (fget parts :body)))))
   :default nil)

#?(:kotoba
   (defn valid-name? [value [:ref :form/r]] :bool
     (and (simple-symbol-form? value) (<= (string-length (fname value)) (max-symbol-chars))))
   :default nil)

#?(:kotoba
   (defn preserve-form-meta [source [:ref :form/r] result [:ref :form/r]] [:ref :form/r]
     (fmeta-from source result))
   :default nil)


;; ---- state ability ----
#?(:kotoba
   (defn state-clause-function-name [handler [:ref :form/r] op [:ref :form/r]] [:ref :form/r]
     (fsym (str "__kotoba_state_" (form-text handler) "_" (fname op))))
   :default nil)

#?(:kotoba
   (defn- ex-state-kids [kids [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count kids))
       acc
       (ex-state-kids kids (+ i 1) (form/append-form acc (rewrite-state-ability-form (fl-nth kids i))))))
   :default nil)

;; Rewrite FORM's children
#?(:kotoba
   (defn state-rewrite-children [form [:ref :form/r]] [:ref :form/r]
     (cond
       (form/is-seq? form) (frebuild-seq form (ex-state-kids (form/kids-of form) 0 (form/no-forms)))
       (or (form/is-vec? form) (form/is-map? form))
       (record-assoc [:ref :form/r] form :kids (ex-state-kids (form/kids-of form) 0 (form/no-forms)))
       :else form))
   :default nil)

;; `(perform :state/get)` -> `(__kotoba_state_perform :get)`, `(perform :state/put v)` ->
;; `(__kotoba_state_perform :put v)`, `(handle body (with h init))` -> `(__kotoba_state_handle :h init body)`
#?(:kotoba
   (defn rewrite-state-ability-form [form [:ref :form/r]] [:ref :form/r]
     (cond
       (fhead-is? form "quote") form
       (state-ability-perform-form? form)
       (let [op (form/nth-of form 1)
             values (fdrop form 2)
             expected (form/int-value (form/form-get (state-ability-operations) op))
             ok (require-k (= expected (vector-count values))
                           (str "perform " (form-text op) " takes "
                                (if (= expected 0) "no value" "exactly one value")
                                "; got " (string-from-i64 (vector-count values)))
                           "kotoba.error/state-shape" form)]
         (frebuild-seq form (form/cons-onto (fsym "__kotoba_state_perform")
                                            (form/cons-onto (fkw (fname op))
                                                            (ex-state-kids values 0 (form/no-forms))))))
       (state-ability-handle-form? form)
       (let [body (form/nth-of form 1)
             clause (form/nth-of form 2)
             handler (form/nth-of clause 1)
             init (form/nth-of clause 2)
             ok (require-k (and (simple-symbol-form? handler) (= 3 (form/count-of clause)))
                           "handle installs one handler with one initial state: (handle body (with handler init))"
                           "kotoba.error/state-shape" form)]
         (frebuild-seq form (form/append-form (form/append-form (form/two-forms (fsym "__kotoba_state_handle") (fkw (fname handler)))
                                                                (rewrite-state-ability-form init))
                                              (rewrite-state-ability-form body))))
       :else (state-rewrite-children form)))
   :default nil)

#?(:kotoba
   (defn state-clause-parameters [] [:ref :form/r]
     (form/edn-form "{:get 1 :put 2}"))
   :default nil)

;; Inside ONE handler clause body, `(resume value state)` becomes the reserved head; a resume of
;; any other arity is refused by its own name
#?(:kotoba
   (defn- ex-resume-kids [kids [:list [:ref :form/r]] i :i64 handler [:ref :form/r] op [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count kids))
       acc
       (ex-resume-kids kids (+ i 1) handler op (form/append-form acc (state-resume-rewrite (fl-nth kids i) handler op)))))
   :default nil)

#?(:kotoba
   (defn state-resume-rewrite [form [:ref :form/r] handler [:ref :form/r] op [:ref :form/r]] [:ref :form/r]
     (cond
       (fhead-is? form "quote") form
       (fhead-is? form "resume")
       (let [ok (require-k (= 3 (form/count-of form))
                           (str "resume takes the resumed value and the next state: (resume value state); handler "
                                (form-text handler) " clause " (fname op) " passes "
                                (string-from-i64 (- (form/count-of form) 1)))
                           "kotoba.error/state-resume" form)]
         (frebuild-seq form (form/three-forms (fsym "__kotoba_state_resume")
                                              (state-resume-rewrite (form/nth-of form 1) handler op)
                                              (state-resume-rewrite (form/nth-of form 2) handler op))))
       (form/is-seq? form) (frebuild-seq form (ex-resume-kids (form/kids-of form) 0 handler op (form/no-forms)))
       (form/is-vec? form) (fmeta-from form (record-assoc [:ref :form/r] form :kids (ex-resume-kids (form/kids-of form) 0 handler op (form/no-forms))))
       :else form))
   :default nil)

;; One clause of a defhandler: {:op :params :body}
#?(:kotoba
   (defn- ex-handler-clause [clause [:ref :form/r] handler [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (let [ok (require-k (and (form/is-seq? clause) (form/is-symbol? (form/nth-of clause 0))
                              (form/is-vec? (form/nth-of clause 1)) (> (form/count-of clause) 2))
                         (str "handler " (form-text handler) " clause must be (op [state value ...] body): " (pr-form clause))
                         "kotoba.error/state-handler-shape" form)
           body (fdrop clause 2)]
       (fput (fput (fput (form/form-map (form/no-forms)) :op (fkw (fname (form/nth-of clause 0))))
                   :params (form/nth-of clause 1))
             :body (if (< 1 (vector-count body)) (form/form-seq (form/cons-onto (fsym "do") body)) (fl-nth body 0)))))
   :default nil)

#?(:kotoba
   (defn- ex-handler-clauses [clauses [:list [:ref :form/r]] i :i64 handler [:ref :form/r] form [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count clauses))
       acc
       (ex-handler-clauses clauses (+ i 1) handler form (form/append-form acc (ex-handler-clause (fl-nth clauses i) handler form)))))
   :default nil)

;; the :op of each parsed clause
#?(:kotoba
   (defn- ex-handler-ops [parsed [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count parsed))
       acc
       (ex-handler-ops parsed (+ i 1) (form/append-form acc (fget (fl-nth parsed i) :op)))))
   :default nil)

#?(:kotoba
   (defn- ex-ops-text [ops [:list [:ref :form/r]] i :i64 acc :string] :string
     (if (>= i (vector-count ops))
       acc
       (ex-ops-text ops (+ i 1) (string-concat (if (> i 0) (string-concat acc ", ") acc) (fname (fl-nth ops i))))))
   :default nil)

;; each clause takes the state, then the operation's values
#?(:kotoba
   (defn- ex-handler-params-ok [parsed [:list [:ref :form/r]] i :i64 handler [:ref :form/r] form [:ref :form/r]] :i64
     (if (>= i (vector-count parsed))
       0
       (let [c (fl-nth parsed i)
             op (fget c :op)
             params (fget c :params)
             expected (form/int-value (form/form-get (state-clause-parameters) op))
             ok (require-k (and (= expected (form/count-of params))
                                (ex-all-simple? params 0)
                                (fdistinct? params 0))
                           (str "handler " (form-text handler) " does not match the :state ability: its " (fname op)
                                " clause takes " (if (= 1 expected) "[state]" "[state value]")
                                ", got " (pr-form params))
                           "kotoba.error/state-handler-type" form)]
         (ex-handler-params-ok parsed (+ i 1) handler form))))
   :default nil)

#?(:kotoba
   (defn- ex-all-simple? [xs [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of xs))
       true
       (and (simple-symbol-form? (form/nth-of xs i)) (ex-all-simple? xs (+ i 1)))))
   :default nil)

;; (p state-type ...) for each parameter
#?(:kotoba
   (defn- ex-typed-params [params [:ref :form/r] state-type [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of params))
       acc
       (ex-typed-params params state-type (+ i 1)
                        (form/append-form (form/append-form acc (form/nth-of params i)) state-type))))
   :default nil)

#?(:kotoba
   (defn- ex-handler-defns [parsed [:list [:ref :form/r]] i :i64 handler [:ref :form/r] state-type [:ref :form/r] form [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count parsed))
       acc
       (let [c (fl-nth parsed i)
             op (fget c :op)
             name (state-clause-function-name handler op)
             body0 (rewrite-state-ability-form (fget c :body))
             body (state-resume-rewrite body0 handler op)
             d (form/form-seq (form/append-form (form/append-form (form/two-forms (fsym "defn-") name)
                                                                  (form/form-vec (ex-typed-params (fget c :params) state-type 0 (form/no-forms))))
                                                body))]
         (ex-handler-defns parsed (+ i 1) handler state-type form (form/append-form acc (fmeta-from form d))))))
   :default nil)

;; {op {:fn name}} for the handler's clauses
#?(:kotoba
   (defn- ex-handler-clause-map [parsed [:list [:ref :form/r]] i :i64 handler [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (vector-count parsed))
       acc
       (let [op (fget (fl-nth parsed i) :op)]
         (ex-handler-clause-map parsed (+ i 1) handler
                                (form/assoc-form acc op (fput (form/form-map (form/no-forms)) :fn (state-clause-function-name handler op)))))))
   :default nil)

;; One `(defhandler name doc? [:state S] (get [s] body) (put [s v] body))` form ->
;; {:handler {:name :state-type :clauses} :defns [...]}
#?(:kotoba
   (defn parse-defhandler [form [:ref :form/r]] [:ref :form/r]
     (let [handler (form/nth-of form 1)
           ok1 (require-k (and (simple-symbol-form? handler) (valid-name? handler))
                          "defhandler requires a handler name: (defhandler name [:state S] (get [s] ...) (put [s v] ...))"
                          "kotoba.error/state-handler-shape" form)
           more0 (fdrop form 2)
           more (if (and (> (vector-count more0) 0) (form/is-string? (fl-nth more0 0))) (fl-drop more0 1) more0)
           signature (if (> (vector-count more) 0) (fl-nth more 0) (form/nil-form))
           clauses (fl-drop more 1)
           ok2 (require-k (and (form/is-vec? signature) (= 2 (form/count-of signature)) (form/is-keyword? (form/nth-of signature 0)))
                          (str "defhandler " (form-text handler) " requires an ability signature: [:state S]")
                          "kotoba.error/state-handler-shape" form)
           ok3 (require-k (form/eq (form/nth-of signature 0) (form/keyword-form :state))
                          (str "defhandler supports only the :state ability in state slice 1; "
                               (form-text handler) " names " (pr-form (form/nth-of signature 0)))
                          "kotoba.error/state-handler-shape" form)
           state-type (form/nth-of signature 1)
           ok4 (validate-value-type! state-type)
           parsed (ex-handler-clauses clauses 0 handler form (form/no-forms))
           ops (ex-handler-ops parsed 0 (form/no-forms))
           ok5 (require-k (and (= 2 (vector-count ops)) (fl-has? ops (form/keyword-form :get) 0) (fl-has? ops (form/keyword-form :put) 0))
                          (str "handler " (form-text handler) " does not match the :state ability: it must define exactly get and put, once each; it defines "
                               (if (> (vector-count ops) 0) (ex-ops-text ops 0 "") "nothing"))
                          "kotoba.error/state-handler-type" form)
           ok6 (ex-handler-params-ok parsed 0 handler form)]
       (fput (fput (form/form-map (form/no-forms)) :handler
                   (fput (fput (fput (form/form-map (form/no-forms)) :name handler) :state-type state-type)
                         :clauses (ex-handler-clause-map parsed 0 handler (form/form-map (form/no-forms)))))
             :defns (form/form-vec (ex-handler-defns parsed 0 handler state-type form (form/no-forms))))))
   :default nil)

;; does the form mention any of the state ability's source forms?
#?(:kotoba
   (defn- ex-mentions-state? [f [:ref :form/r]] :bool
     (if (or (fhead-is? f "defhandler") (state-ability-perform-form? f) (state-ability-handle-form? f))
       true
       (ex-mentions-state-kids? (form/kids-of f) 0)))
   :default nil)

#?(:kotoba
   (defn- ex-mentions-state-kids? [kids [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count kids))
       false
       (if (ex-mentions-state? (fl-nth kids i)) true (ex-mentions-state-kids? kids (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn- ex-state-forms [forms [:list [:ref :form/r]] i :i64 out [:list [:ref :form/r]] handlers [:ref :form/r]] [:ref :form/r]
     (if (>= i (vector-count forms))
       (fput (fput (form/form-map (form/no-forms)) :forms (form/form-vec out)) :handlers handlers)
       (let [f (fl-nth forms i)]
         (if (fhead-is? f "defhandler")
           (let [parsed (parse-defhandler f)
                 handler (fget parsed :handler)
                 key (fkw (fname (fget handler :name)))
                 ok (require-k (not (form/form-has? handlers key))
                               (str "duplicate handler name: " (form-text (fget handler :name)))
                               "kotoba.error/state-handler-shape" f)]
             (ex-state-forms forms (+ i 1) (form/append-many out (form/kids-of (fget parsed :defns)))
                             (form/assoc-form handlers key handler)))
           (ex-state-forms forms (+ i 1) (form/append-form out (rewrite-state-ability-form f)) handlers)))))
   :default nil)

;; Source-level expansion of the state ability: a Form map {:forms :handlers}; a module that
;; mentions none of it comes back unchanged with no handlers
#?(:kotoba
   (defn expand-state-ability-forms [forms [:list [:ref :form/r]]] [:ref :form/r]
     (if (ex-mentions-state-kids? forms 0)
       (ex-state-forms forms 0 (form/no-forms) (form/form-map (form/no-forms)))
       (fput (fput (form/form-map (form/no-forms)) :forms (form/form-vec forms)) :handlers (form/form-map (form/no-forms)))))
   :default nil)

;; every element of CEILING (a set Form) is a keyword
#?(:kotoba
   (defn- ex-all-keywords? [xs [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of xs))
       true
       (and (form/is-keyword? (form/nth-of xs i)) (ex-all-keywords? xs (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn- ex-ceiling-rows [ceiling [:ref :form/r] i :i64 form [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of ceiling))
       acc
       (let [kw (form/nth-of ceiling i)
             id (form/form-get (capability-registry) kw)
             ok (require-k (or (not (form/is-nil? id)) (form/eq kw (form/keyword-form :state)))
                           (str "effect ceiling names unregistered capability: " (form-text kw))
                           "kotoba.error/subset-reject" form)]
         (ex-ceiling-rows ceiling (+ i 1) form
                          (form/append-form acc (if (form/is-nil? id)
                                                  kw
                                                  (form/vec2 (form/keyword-form :cap/call) id)))))))
   :default nil)

;; Translate a public effect ceiling declared as capability keywords into the same
;; `[:cap/call id]` row shape `infer-effects` produces; nil stays nil
#?(:kotoba
   (defn normalize-effect-ceiling [ceiling [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (if (form/is-nil? ceiling)
       (form/nil-form)
       (let [ok (require-k (and (form/is-set? ceiling) (> (form/count-of ceiling) 0) (ex-all-keywords? ceiling 0))
                           "effect ceiling must be a non-empty set of capability keywords"
                           "kotoba.error/subset-reject" form)]
         (form/form-set (ex-ceiling-rows ceiling 0 form (form/no-forms))))))
   :default nil)


;; ---- defn declarations ----
#?(:kotoba
   (defn- ex-absent [] [:ref :form/r] (form/keyword-form :kotoba.expand/absent))
   :default nil)

;; Parse Kotoba's bounded function declaration shape: an optional docstring, the parameter vector,
;; an optional result type, an optional `{:effects #{...}}` ceiling, then the body. Answers a Form
;; map {:name :raw-params :result :body ...}; the body is a Form vector of one or more forms
;; collapsed to one `do` when several were written.
#?(:kotoba
   (defn- ex-type-position? [f [:ref :form/r]] :bool
     (or (form/is-keyword? f) (structured-type? f) (type-alias-form? f)))
   :default nil)

#?(:kotoba
   (defn- ex-ceiling-map? [f [:ref :form/r]] :bool
     (and (form/is-map? f) (form/form-has? f (form/keyword-form :effects))
          (= 2 (form/count-of f))))
   :default nil)

#?(:kotoba
   (defn defn-parts [form [:ref :form/r] constants [:ref :form/r]] [:ref :form/r]
     (let [name (form/nth-of form 1)
           declaration0 (fdrop form 2)
           has-doc (and (> (vector-count declaration0) 0) (form/is-string? (fl-nth declaration0 0)))
           docstring (if has-doc (fl-nth declaration0 0) (form/nil-form))
           declaration (if has-doc (fl-drop declaration0 1) declaration0)
           raw-params (if (> (vector-count declaration) 0) (fl-nth declaration 0) (form/nil-form))
           tail0 (fl-drop declaration 1)
           typed (and (> (vector-count tail0) 0) (ex-type-position? (fl-nth tail0 0)))
           result (if typed (resolve-type-alias! (fl-nth tail0 0) constants) (ex-absent))
           tail (if typed (fl-drop tail0 1) tail0)
           ceiling-form (if (> (vector-count tail) 0) (fl-nth tail 0) (form/nil-form))
           has-ceiling (ex-ceiling-map? ceiling-form)
           effects-ceiling (if has-ceiling
                             (normalize-effect-ceiling (fget ceiling-form :effects) form)
                             (form/nil-form))
           body0 (if has-ceiling (fl-drop tail 1) tail)
           body (if (< 1 (vector-count body0)) (form/one-form (implicit-do-body body0)) body0)
           ok1 (require-k (or (form/is-nil? docstring) (<= (string-length (form/string-value docstring)) (max-function-docstring-chars)))
                          "function docstring exceeds admission limit" "kotoba.error/subset-reject" docstring)
           absent (form/eq result (ex-absent))
           ok2 (if absent 0 (validate-value-type! result))
           callable (and (not absent) (callable-type? result))
           p0 (fput (fput (fput (fput (form/form-map (form/no-forms)) :name name) :raw-params raw-params)
                     :result (if (or absent callable) (form/keyword-form :i64) result))
                    :body (form/form-vec body))
           p1 (if absent (fput p0 :result-inferred? (form/bool-form true)) p0)
           p2 (if callable (fput p1 :callable-result-contract result) p1)]
       (if (ftruthy? effects-ceiling) (fput p2 :effects-ceiling effects-ceiling) p2)))
   :default nil)

;; every clause of DECLARATION (from I) is a list headed by a vector
#?(:kotoba
   (defn- ex-all-clauses? [declaration [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count declaration))
       true
       (let [c (fl-nth declaration i)]
         (and (form/is-seq? c) (form/is-vec? (form/nth-of c 0)) (ex-all-clauses? declaration (+ i 1))))))
   :default nil)

#?(:kotoba
   (defn multi-arity-declaration? [declaration [:list [:ref :form/r]]] :bool
     (and (> (vector-count declaration) 0) (ex-all-clauses? declaration 0)))
   :default nil)

#?(:kotoba
   (defn abi-arity-name [source-name [:ref :form/r] arity :i64] [:ref :form/r]
     (fsym (str (fname source-name) "$arity$" (string-from-i64 arity))))
   :default nil)

#?(:kotoba
   (defn variadic-params? [raw-params [:ref :form/r]] :bool
     (and (form/is-vec? raw-params) (fl-has? (form/kids-of raw-params) (fsym "&") 0)))
   :default nil)

;; the index of the `&` in a parameter vector, -1 when absent
#?(:kotoba
   (defn- ex-amp-index [raw-params [:ref :form/r] i :i64] :i64
     (if (>= i (form/count-of raw-params))
       -1
       (if (form/eq (form/nth-of raw-params i) (fsym "&")) i (ex-amp-index raw-params (+ i 1)))))
   :default nil)

;; the patterns of PARTS (typed-param-parts maps)
#?(:kotoba
   (defn- ex-part-symbols [parts [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of parts))
       acc
       (ex-part-symbols parts (+ i 1) (fsymbols-into (fget (form/nth-of parts i) :pattern) acc))))
   :default nil)

;; Read `[fixed ... & rest]` for a defn clause: a Form map {:fixed :rest-name :min-arity}
#?(:kotoba
   (defn variadic-clause-parts [raw-params [:ref :form/r] constants [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (let [amp (ex-amp-index raw-params 0)
           ok1 (require-k (= amp (- (form/count-of raw-params) 2))
                          "variadic defn requires [fixed ... & rest]: `&` must be followed by exactly one rest name and nothing else"
                          "kotoba.error/subset-reject" raw-params)
           fixed (form/form-vec (fl-slice (form/kids-of raw-params) 0 amp (form/no-forms)))
           rest-name (form/last-of raw-params)
           fixed-parts (typed-param-parts fixed constants)
           min-arity (form/count-of fixed-parts)
           ok2 (require-k (and (valid-name? rest-name) (not (form/eq rest-name (fsym "&"))))
                           "variadic defn requires [fixed ... & rest]: the rest name must be a simple symbol"
                           "kotoba.error/subset-reject" raw-params)
           ok3 (require-k (not (fl-has? (ex-part-symbols fixed-parts 0 (form/no-forms)) rest-name 0))
                          (str "variadic rest name " (form-text rest-name) " shadows a fixed parameter of the same clause")
                          "kotoba.error/subset-reject" raw-params)
           ok4 (require-k (<= min-arity (max-parameters))
                          "function parameters exceed ABI-supported arity" "kotoba.error/max-parameters" raw-params)]
       (fput (fput (fput (form/form-map (form/no-forms)) :fixed fixed) :rest-name rest-name)
             :min-arity (form/int-form min-arity))))
   :default nil)



;; ---- expand-defn-parts ----
#?(:kotoba
   (defn- ex-defn-raws [declaration [:list [:ref :form/r]] i :i64 op [:ref :form/r] source-name [:ref :form/r] constants [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count declaration))
       acc
       (let [clause (fl-nth declaration i)
             full (form/form-seq (form/cons-onto op (form/cons-onto source-name (form/kids-of clause))))]
         (ex-defn-raws declaration (+ i 1) op source-name constants (form/append-form acc (defn-parts full constants))))))
   :default nil)

;; the raw clauses that are (VARIADIC? true) / are not variadic
#?(:kotoba
   (defn- ex-select-raws [raws [:list [:ref :form/r]] variadic? :bool i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count raws))
       acc
       (let [raw (fl-nth raws i)]
         (ex-select-raws raws variadic? (+ i 1)
                         (if (= variadic? (variadic-params? (fget raw :raw-params))) (form/append-form acc raw) acc)))))
   :default nil)

#?(:kotoba
   (defn- ex-fixed-clauses [raws [:list [:ref :form/r]] i :i64 source-name [:ref :form/r] public? :bool constants [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count raws))
       acc
       (let [raw (fl-nth raws i)]
         (ex-fixed-clauses raws (+ i 1) source-name public? constants
                           (form/append-form acc
                                             (fput (fput (fput raw :source-name source-name)
                                                         :logical-arity (form/int-form (form/count-of (typed-param-parts (fget raw :raw-params) constants))))
                                                   :public? (form/bool-form public?)))))))
   :default nil)

#?(:kotoba
   (defn- ex-clause-arities [clauses [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count clauses))
       acc
       (ex-clause-arities clauses (+ i 1) (form/append-form acc (fget (fl-nth clauses i) :logical-arity)))))
   :default nil)

;; the called arities within [MIN, max-parameters]
#?(:kotoba
   (defn- ex-used-arities [call-arities [:ref :form/r] i :i64 min :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of call-arities))
       acc
       (let [a (form/int-value (form/nth-of call-arities i))]
         (ex-used-arities call-arities (+ i 1) min
                          (if (and (<= min a) (<= a (max-parameters))) (fl-add acc (form/int-form a)) acc)))))
   :default nil)

;; the smallest arity from A through max-parameters that no fixed clause holds, -1 when none
#?(:kotoba
   (defn- ex-first-free [fixed [:list [:ref :form/r]] a :i64] :i64
     (if (> a (max-parameters))
       -1
       (if (fl-has? fixed (form/int-form a) 0) (ex-first-free fixed (+ a 1)) a)))
   :default nil)

#?(:kotoba
   (defn- ex-insert-int [xs [:list [:ref :form/r]] x [:ref :form/r] i :i64] [:list [:ref :form/r]]
     (if (or (>= i (vector-count xs)) (> (form/int-value (fl-nth xs i)) (form/int-value x)))
       (fl-slice xs i (vector-count xs) (form/append-form (fl-slice xs 0 i (form/no-forms)) x))
       (ex-insert-int xs x (+ i 1))))
   :default nil)

;; the called arities not held by a fixed clause, plus the first free one, ascending
#?(:kotoba
   (defn- ex-variadic-arities [used [:list [:ref :form/r]] always :i64 fixed [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count used))
       (if (and (>= always 0) (not (fl-has? acc (form/int-form always) 0)))
         (ex-insert-int acc (form/int-form always) 0)
         acc)
       (let [a (fl-nth used i)]
         (ex-variadic-arities used always fixed (+ i 1)
                              (if (fl-has? fixed a 0) acc (ex-insert-int acc a 0))))))
   :default nil)

#?(:kotoba
   (defn- ex-variadic-clauses [raw [:ref :form/r] parts [:ref :form/r] arities [:list [:ref :form/r]] i :i64 source-name [:ref :form/r] public? :bool acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count arities))
       acc
       (let [arity (form/int-value (fl-nth arities i))
             body (fget raw :body)
             first-body (if (> (form/count-of body) 0) (form/nth-of body 0) (form/nil-form))
             spec (specialize-variadic-clause (fput parts :body first-body) arity "__kotoba_rest_arg_")
             clause (fput (fput (fput (fput (fput (fput raw :raw-params (form/nth-of spec 0))
                                                  :body (if (= 1 (form/count-of body)) (form/form-vec (form/one-form (form/nth-of spec 1))) body))
                                            :source-name source-name)
                                      :logical-arity (form/int-form arity))
                                :public? (form/bool-form public?))
                          :variadic? (form/bool-form true))]
         (ex-variadic-clauses raw parts arities (+ i 1) source-name public? (form/append-form acc clause)))))
   :default nil)

#?(:kotoba
   (defn- ex-rename-clauses [clauses [:list [:ref :form/r]] i :i64 source-name [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count clauses))
       acc
       (let [c (fl-nth clauses i)]
         (ex-rename-clauses clauses (+ i 1) source-name
                            (form/append-form acc (fput c :name (abi-arity-name source-name (form/int-value (fget c :logical-arity)))))))))
   :default nil)

;; The multi-arity / variadic path of expand-defn-parts: one monomorphic clause per arity
#?(:kotoba
   (defn- ex-defn-clauses [form [:ref :form/r] op [:ref :form/r] source-name [:ref :form/r] declaration [:list [:ref :form/r]] public? :bool constants [:ref :form/r] call-arities [:ref :form/r]] [:ref :form/r]
     (let [declaration2 (if (multi-arity-declaration? declaration) declaration (form/one-form (form/form-seq declaration)))
           ok1 (require-k (<= (vector-count declaration2) (max-arity-clauses))
                          "multi-arity clause count exceeds admission limit" "kotoba.error/subset-reject" form)
           raws (ex-defn-raws declaration2 0 op source-name constants (form/no-forms))
           fixed-raws (ex-select-raws raws false 0 (form/no-forms))
           variadic-raws (ex-select-raws raws true 0 (form/no-forms))
           ok2 (require-k (<= (vector-count variadic-raws) 1) "defn admits at most one variadic clause"
                          "kotoba.error/subset-reject" form)
           fixed-clauses (ex-fixed-clauses fixed-raws 0 source-name public? constants (form/no-forms))
           fixed-arities (ex-clause-arities fixed-clauses 0 (form/no-forms))
           variadic-clauses
           (if (> (vector-count variadic-raws) 0)
             (let [raw (fl-nth variadic-raws 0)
                   parts (variadic-clause-parts (fget raw :raw-params) constants form)
                   min-arity (form/int-value (fget parts :min-arity))
                   used (ex-used-arities call-arities 0 min-arity (form/no-forms))
                   always (ex-first-free fixed-arities min-arity)
                   arities (ex-variadic-arities used always fixed-arities 0 (form/no-forms))]
               (ex-variadic-clauses raw parts arities 0 source-name public? (form/no-forms)))
             (form/no-forms))
           clauses (form/append-many fixed-clauses variadic-clauses)
           arities (ex-clause-arities clauses 0 (form/no-forms))
           ok3 (require-k (fl-distinct? arities) "duplicate multi-arity clause" "kotoba.error/subset-reject" form)]
       (if (and (= 1 (vector-count clauses)) (fhas? (fl-nth clauses 0) :variadic?))
         (form/form-vec (form/one-form (form/dissoc-form (fl-nth clauses 0) (form/keyword-form :variadic?))))
         (form/form-vec (ex-rename-clauses clauses 0 source-name (form/no-forms))))))
   :default nil)

;; Return one or more monomorphic clauses (Form maps) for a source defn. CALL-ARITIES is this
;; name's set of called arities
#?(:kotoba
   (defn expand-defn-parts [form [:ref :form/r] constants [:ref :form/r] call-arities [:ref :form/r]] [:ref :form/r]
     (let [op (form/nth-of form 0)
           source-name (form/nth-of form 1)
           declaration0 (fdrop form 2)
           ok1 (require-k (valid-name? source-name) "invalid function name" "kotoba.error/subset-reject" form)
           has-doc (and (> (vector-count declaration0) 0) (form/is-string? (fl-nth declaration0 0)))
           docstring (if has-doc (fl-nth declaration0 0) (form/nil-form))
           declaration (if has-doc (fl-drop declaration0 1) declaration0)
           public? (and (fhead-is? form "defn") (not (fprivate-symbol? source-name)))
           ok2 (require-k (or (not has-doc) (<= (string-length (form/string-value docstring)) (max-function-docstring-chars)))
                          "function docstring exceeds admission limit" "kotoba.error/subset-reject" docstring)
           ok3 (require-k (not (string-contains? (fname source-name) "$arity$"))
                          "function name uses reserved multi-arity ABI marker" "kotoba.error/subset-reject" source-name)
           first-decl (if (> (vector-count declaration) 0) (fl-nth declaration 0) (form/nil-form))]
       (if (and (not (multi-arity-declaration? declaration)) (not (variadic-params? first-decl)))
         (form/form-vec (form/one-form (fput (fput (defn-parts form constants) :source-name source-name)
                                             :public? (form/bool-form public?))))
         (ex-defn-clauses form op source-name declaration public? constants call-arities))))
   :default nil)

#?(:kotoba
   (defn binding-symbols [pattern [:ref :form/r]] [:ref :form/r]
     (form/form-set (fsymbols-into pattern (form/no-forms))))
   :default nil)


;; ---- closed multimethods ----
#?(:kotoba
   (defn closed-multimethod-literal? [value [:ref :form/r]] :bool
     (or (form/is-int? value) (form/is-keyword? value) (form/is-bool? value) (form/is-string? value)))
   :default nil)

;; the forms of FORMS (from I) headed by HEAD
#?(:kotoba
   (defn- ex-select-head [forms [:list [:ref :form/r]] head :string i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count forms))
       acc
       (let [f (fl-nth forms i)]
         (ex-select-head forms head (+ i 1) (if (fhead-is? f head) (form/append-form acc f) acc)))))
   :default nil)

;; an unqualified symbol
#?(:kotoba
   (defn- ex-plain-symbol? [f [:ref :form/r]] :bool
     (and (form/is-symbol? f) (string=? (fnamespace f) "")))
   :default nil)

#?(:kotoba
   (defn- ex-all-plain-symbols? [xs [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of xs))
       true
       (and (ex-plain-symbol? (form/nth-of xs i)) (ex-all-plain-symbols? xs (+ i 1)))))
   :default nil)

;; the names of FORMS (their second element)
#?(:kotoba
   (defn- ex-second-of-all [forms [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count forms))
       acc
       (ex-second-of-all forms (+ i 1) (form/append-form acc (form/nth-of (fl-nth forms i) 1)))))
   :default nil)

;; defmulti declarations: {name {:form :dispatch}}
#?(:kotoba
   (defn- ex-multi-declarations [declarations [:list [:ref :form/r]] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (vector-count declarations))
       acc
       (let [f (fl-nth declarations i)
             name (form/nth-of f 1)
             dispatch (form/nth-of f 2)
             ok (require-k (and (ex-plain-symbol? name) (ex-plain-symbol? dispatch) (= 3 (form/count-of f)))
                           "defmulti requires an unqualified name and one unqualified dispatch function symbol"
                           "kotoba.error/subset-reject" f)]
         (ex-multi-declarations declarations (+ i 1)
                                (form/assoc-form acc name (fput (fput (form/form-map (form/no-forms)) :form f) :dispatch dispatch))))))
   :default nil)

;; each defmethod is well formed and names a declared defmulti
#?(:kotoba
   (defn- ex-check-methods [methods [:list [:ref :form/r]] i :i64 declarations [:ref :form/r]] :i64
     (if (>= i (vector-count methods))
       0
       (let [f (fl-nth methods i)
             name (form/nth-of f 1)
             dispatch-value (form/nth-of f 2)
             params (form/nth-of f 3)
             ok1 (require-k (form/form-has? declarations name) "defmethod requires a matching defmulti declaration"
                            "kotoba.error/subset-reject" f)
             ok2 (require-k (closed-multimethod-literal? dispatch-value)
                            "defmethod dispatch value must be a bounded literal or :default"
                            "kotoba.error/subset-reject" f)
             ok3 (require-k (and (form/is-vec? params) (<= (form/count-of params) (max-parameters))
                                 (ex-all-plain-symbols? params 0) (fdistinct? params 0))
                            "defmethod parameters must be a unique vector of unqualified symbols within the ABI arity"
                            "kotoba.error/subset-reject" f)
             ok4 (require-k (> (form/count-of f) 4) "defmethod requires at least one body expression"
                            "kotoba.error/subset-reject" f)]
         (ex-check-methods methods (+ i 1) declarations))))
   :default nil)

;; the defmethod forms of NAME
#?(:kotoba
   (defn- ex-methods-of [methods [:list [:ref :form/r]] name [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count methods))
       acc
       (let [f (fl-nth methods i)]
         (ex-methods-of methods name (+ i 1) (if (form/eq (form/nth-of f 1) name) (form/append-form acc f) acc)))))
   :default nil)

;; every method uses the first method's parameter vector
#?(:kotoba
   (defn- ex-same-params [methods [:list [:ref :form/r]] params [:ref :form/r] i :i64] :i64
     (if (>= i (vector-count methods))
       0
       (let [ok (require-k (form/eq params (form/nth-of (fl-nth methods i) 3))
                           "all defmethods must use the same parameter vector" "kotoba.error/subset-reject" (fl-nth methods i))]
         (ex-same-params methods params (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn- ex-method-body [method [:ref :form/r]] [:ref :form/r]
     (let [body (fdrop method 4)]
       (if (= 1 (vector-count body))
         (fl-nth body 0)
         (form/form-seq (form/cons-onto (fsym "do") body)))))
   :default nil)

;; the dispatch-value and body pairs of the non-default methods, then the default body
#?(:kotoba
   (defn- ex-method-clauses [methods [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]] default-body [:ref :form/r]] [:list [:ref :form/r]]
     (if (>= i (vector-count methods))
       (if (form/is-nil? default-body) acc (form/append-form acc default-body))
       (let [m (fl-nth methods i)]
         (ex-method-clauses methods (+ i 1)
                            (if (form/eq (form/nth-of m 2) (form/keyword-form :default))
                              acc
                              (form/append-form (form/append-form acc (form/nth-of m 2)) (ex-method-body m)))
                            default-body))))
   :default nil)

#?(:kotoba
   (defn- ex-default-method-body [methods [:list [:ref :form/r]] i :i64] [:ref :form/r]
     (if (>= i (vector-count methods))
       (form/nil-form)
       (let [m (fl-nth methods i)]
         (if (form/eq (form/nth-of m 2) (form/keyword-form :default))
           (ex-method-body m)
           (ex-default-method-body methods (+ i 1))))))
   :default nil)

#?(:kotoba
   (defn- ex-dispatch-values [methods [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count methods))
       acc
       (ex-dispatch-values methods (+ i 1) (form/append-form acc (form/nth-of (fl-nth methods i) 2)))))
   :default nil)

;; the generated `(defn name params (case (dispatch params...) clauses...))`
#?(:kotoba
   (defn- ex-generated-multi [name [:ref :form/r] decl [:ref :form/r] methods [:list [:ref :form/r]]] [:ref :form/r]
     (let [form (fget decl :form)
           ok1 (require-k (> (vector-count methods) 0) "defmulti requires at least one closed-world defmethod"
                          "kotoba.error/subset-reject" form)
           params (form/nth-of (fl-nth methods 0) 3)
           ok2 (ex-same-params methods params 0)
           ok3 (require-k (fl-distinct? (ex-dispatch-values methods 0 (form/no-forms)))
                           "duplicate defmethod dispatch value" "kotoba.error/subset-reject" (form/form-vec methods))
           clauses (ex-method-clauses methods 0 (form/no-forms) (ex-default-method-body methods 0))
           scrutinee (form/form-seq (form/cons-onto (fget decl :dispatch) (form/kids-of params)))]
       (form/form-seq (form/append-form (form/append-form (form/two-forms (fsym "defn") name) params)
                                        (form/form-seq (form/cons-onto (fsym "case") (form/cons-onto scrutinee clauses)))))))
   :default nil)

;; the output forms: each defmulti becomes its generated defn, each defmethod disappears
#?(:kotoba
   (defn- ex-multi-output [forms [:list [:ref :form/r]] i :i64 declarations [:ref :form/r] methods [:list [:ref :form/r]] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count forms))
       acc
       (let [f (fl-nth forms i)]
         (ex-multi-output forms (+ i 1) declarations methods
                          (cond
                            (fhead-is? f "defmulti")
                            (let [name (form/nth-of f 1)]
                              (form/append-form acc (ex-generated-multi name (form/form-get declarations name)
                                                                         (ex-methods-of methods name 0 (form/no-forms)))))
                            (fhead-is? f "defmethod") acc
                            :else (form/append-form acc f))))))
   :default nil)

#?(:kotoba
   (defn expand-closed-multimethod-forms [forms [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (let [declarations (ex-select-head forms "defmulti" 0 (form/no-forms))
           methods (ex-select-head forms "defmethod" 0 (form/no-forms))
           names (ex-second-of-all declarations 0 (form/no-forms))
           ok1 (require-k (fl-distinct? names) "duplicate defmulti declaration" "kotoba.error/subset-reject" (form/form-vec declarations))
           by-name (ex-multi-declarations declarations 0 (form/form-map (form/no-forms)))
           ok2 (ex-check-methods methods 0 by-name)]
       (ex-multi-output forms 0 by-name methods (form/no-forms))))
   :default nil)


;; ---- protocols and records ----
;; A protocol declaration's method forms with the trailing docstring of a method removed
#?(:kotoba
   (defn- ex-strip-docs [tail [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count tail))
       acc
       (let [m (fl-nth tail i)]
         (ex-strip-docs tail (+ i 1)
                        (form/append-form acc
                                          (if (and (form/is-seq? m) (> (form/count-of m) 2) (form/is-string? (form/last-of m)))
                                            (form/form-seq (fl-slice (form/kids-of m) 0 (- (form/count-of m) 1) (form/no-forms)))
                                            m))))))
   :default nil)

#?(:kotoba
   (defn protocol-documentation-stripped [tail [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (ex-strip-docs tail 0 (form/no-forms)))
   :default nil)

;; Split a protocol method parameter vector into its names and their value types, as a Form map
;; {:names :types}; nil when it is not names with optional types
#?(:kotoba
   (defn- ex-param-parts [params [:ref :form/r] i :i64 names [:list [:ref :form/r]] types [:list [:ref :form/r]]] [:ref :form/r]
     (if (>= i (form/count-of params))
       (fput (fput (form/form-map (form/no-forms)) :names (form/form-vec names)) :types (form/form-vec types))
       (let [param (form/nth-of params i)]
         (if (form/is-symbol? param)
           (let [nxt (form/nth-of params (+ i 1))
                 typed (and (< (+ i 1) (form/count-of params)) (or (form/is-keyword? nxt) (form/is-vec? nxt)))]
             (if typed
               (ex-param-parts params (+ i 2) (form/append-form names param) (form/append-form types nxt))
               (ex-param-parts params (+ i 1) (form/append-form names param) (form/append-form types (form/nil-form)))))
           (form/nil-form)))))
   :default nil)

#?(:kotoba
   (defn protocol-method-param-parts [params [:ref :form/r]] [:ref :form/r]
     (if (form/is-vec? params)
       (ex-param-parts params 0 (form/no-forms) (form/no-forms))
       (form/nil-form)))
   :default nil)

;; the trailing docstring of each method of TAIL (a string after the signature)
#?(:kotoba
   (defn- ex-method-docs [tail [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count tail))
       acc
       (let [m (fl-nth tail i)]
         (ex-method-docs tail (+ i 1)
                         (if (and (form/is-seq? m) (> (form/count-of m) 2) (form/is-string? (form/last-of m)))
                           (form/append-form acc (form/last-of m))
                           acc)))))
   :default nil)

#?(:kotoba
   (defn- ex-docs-bounded [docs [:list [:ref :form/r]] i :i64 head [:ref :form/r] form [:ref :form/r]] :i64
     (if (>= i (vector-count docs))
       0
       (let [doc (fl-nth docs i)
             ok (require-k (or (not (form/is-string? doc)) (<= (string-length (form/string-value doc)) (max-function-docstring-chars)))
                           (str (form-text head) " docstring exceeds admission limit")
                           "kotoba.error/protocol-declaration" form)]
         (ex-docs-bounded docs (+ i 1) head form))))
   :default nil)

;; a method signature `(name [this ...])` of a protocol declaration is bounded
#?(:kotoba
   (defn- ex-method-signature-ok? [m [:ref :form/r]] :bool
     (and (form/is-seq? m) (= 2 (form/count-of m)) (valid-name? (form/nth-of m 0))
          (form/is-vec? (form/nth-of m 1)) (> (form/count-of (form/nth-of m 1)) 0)
          (let [parts (protocol-method-param-parts (form/nth-of m 1))]
            (and (not (form/is-nil? parts))
                 (<= (form/count-of (fget parts :names)) (max-parameters))
                 (ex-all-valid-names? (fget parts :names) 0)
                 (or (= 0 (form/count-of (fget parts :types))) (form/is-nil? (form/nth-of (fget parts :types) 0)))))))
   :default nil)

#?(:kotoba
   (defn- ex-all-valid-names? [xs [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of xs))
       true
       (and (valid-name? (form/nth-of xs i)) (ex-all-valid-names? xs (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn- ex-all-signatures-ok? [methods [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count methods))
       true
       (and (ex-method-signature-ok? (fl-nth methods i)) (ex-all-signatures-ok? methods (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn- ex-method-names [methods [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count methods))
       acc
       (ex-method-names methods (+ i 1) (form/append-form acc (form/nth-of (fl-nth methods i) 0)))))
   :default nil)

;; {method-name parts} for each method
#?(:kotoba
   (defn- ex-method-parts [methods [:list [:ref :form/r]] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (vector-count methods))
       acc
       (let [m (fl-nth methods i)]
         (ex-method-parts methods (+ i 1) (form/assoc-form acc (form/nth-of m 0) (protocol-method-param-parts (form/nth-of m 1)))))))
   :default nil)

;; every non-nil declared type of the parts of M is a valid value type
#?(:kotoba
   (defn- ex-validate-types [types [:ref :form/r] i :i64] :i64
     (if (>= i (form/count-of types))
       0
       (let [t (form/nth-of types i)
             ok (if (form/is-nil? t) 0 (validate-value-type! t))]
         (ex-validate-types types (+ i 1)))))
   :default nil)

#?(:kotoba
   (defn- ex-validate-part-types [parts [:ref :form/r] j :i64] :i64
     (if (>= (+ j 1) (form/count-of parts))
       0
       (let [ok (ex-validate-types (fget (form/nth-of parts (+ j 1)) :types) 0)]
         (ex-validate-part-types parts (+ j 2)))))
   :default nil)

;; {method-name (names or types)} projected from PARTS
#?(:kotoba
   (defn- ex-project-parts [parts [:ref :form/r] key :keyword j :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= (+ j 1) (form/count-of parts))
       acc
       (ex-project-parts parts key (+ j 2) (form/assoc-form acc (form/nth-of parts j) (fget (form/nth-of parts (+ j 1)) key)))))
   :default nil)

#?(:kotoba
   (defn protocol-form->info [form [:ref :form/r]] [:ref :form/r]
     (let [head (form/nth-of form 0)
           protocol-name (form/nth-of form 1)
           tail0 (fdrop form 2)
           has-doc (and (> (vector-count tail0) 0) (form/is-string? (fl-nth tail0 0)))
           protocol-doc (if has-doc (fl-nth tail0 0) (form/nil-form))
           tail (if has-doc (fl-drop tail0 1) tail0)
           method-docs (ex-method-docs tail 0 (form/no-forms))
           methods (protocol-documentation-stripped tail)
           ok1 (ex-docs-bounded (form/cons-onto protocol-doc method-docs) 0 head form)
           names (ex-method-names methods 0 (form/no-forms))
           ok2 (require-k (and (valid-name? protocol-name)
                               (> (vector-count methods) 0)
                               (ex-all-signatures-ok? methods 0)
                               (fl-distinct? names))
                          (str (form-text head) " requires unique bounded (method [this ...]) signatures")
                          "kotoba.error/protocol-declaration" form)
           parts (ex-method-parts methods 0 (form/form-map (form/no-forms)))
           ok3 (ex-validate-part-types parts 0)]
       (fput (fput (fput (form/form-map (form/no-forms)) :name protocol-name)
                   :methods (ex-project-parts parts :names 0 (form/form-map (form/no-forms))))
             :param-types (ex-project-parts parts :types 0 (form/form-map (form/no-forms))))))
   :default nil)

;; ---- record field parts ----
#?(:kotoba
   (defn- ex-any-keyword? [xs [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of xs))
       false
       (if (form/is-keyword? (form/nth-of xs i)) true (ex-any-keyword? xs (+ i 1)))))
   :default nil)

;; some odd-position element (a field's type) is a structured type
#?(:kotoba
   (defn- ex-any-structured-type? [xs [:ref :form/r] i :i64] :bool
     (if (>= (+ i 1) (form/count-of xs))
       false
       (if (structured-type? (form/nth-of xs (+ i 1))) true (ex-any-structured-type? xs (+ i 2)))))
   :default nil)

#?(:kotoba
   (defn- ex-field-part [name [:ref :form/r] type [:ref :form/r]] [:ref :form/r]
     (fput (fput (form/form-map (form/no-forms)) :name name) :type type))
   :default nil)

#?(:kotoba
   (defn- ex-typed-fields [fields [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= (+ i 1) (form/count-of fields))
       acc
       (let [field (form/nth-of fields i)
             type (form/nth-of fields (+ i 1))
             ok1 (require-k (valid-name? field) "defrecord field names must be unique unqualified symbols"
                            "kotoba.error/record-declaration" field)
             ok2 (validate-value-type! type)]
         (ex-typed-fields fields (+ i 2) (form/append-form acc (ex-field-part field type))))))
   :default nil)

#?(:kotoba
   (defn- ex-untyped-fields [fields [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of fields))
       acc
       (let [field (form/nth-of fields i)
             ok (require-k (valid-name? field) "defrecord field names must be unique unqualified symbols"
                           "kotoba.error/record-declaration" field)]
         (ex-untyped-fields fields (+ i 1) (form/append-form acc (ex-field-part field (form/keyword-form :i64)))))))
   :default nil)

#?(:kotoba
   (defn record-field-parts [fields [:ref :form/r] form [:ref :form/r]] [:list [:ref :form/r]]
     (let [typed (or (ex-any-keyword? fields 0)
                     (and (= 0 (rem (form/count-of fields) 2)) (ex-any-structured-type? fields 0)))]
       (if typed
         (let [ok (require-k (= 0 (rem (form/count-of fields) 2)) "typed defrecord fields require alternating name/type pairs"
                             "kotoba.error/record-declaration" form)]
           (ex-typed-fields fields 0 (form/no-forms)))
         (ex-untyped-fields fields 0 (form/no-forms)))))
   :default nil)

;; ---- extension implementations ----
;; the method names of a protocol info (keys of its :methods map)
#?(:kotoba
   (defn- ex-map-keys [m [:ref :form/r] j :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= (+ j 1) (form/count-of m))
       acc
       (ex-map-keys m (+ j 2) (form/append-form acc (form/nth-of m j)))))
   :default nil)

;; the first element of each method form
#?(:kotoba
   (defn- ex-form-heads [forms [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count forms))
       acc
       (ex-form-heads forms (+ i 1) (form/append-form acc (form/nth-of (fl-nth forms i) 0)))))
   :default nil)

;; A and B hold the same elements
#?(:kotoba
   (defn- ex-same-members? [a [:list [:ref :form/r]] b [:list [:ref :form/r]]] :bool
     (and (ex-subset? a b 0) (ex-subset? b a 0)))
   :default nil)

#?(:kotoba
   (defn- ex-subset? [a [:list [:ref :form/r]] b [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count a))
       true
       (and (fl-has? b (fl-nth a i) 0) (ex-subset? a b (+ i 1)))))
   :default nil)

;; declared type or the given one (:i64 when neither), per parameter
#?(:kotoba
   (defn- ex-param-types [declared [:ref :form/r] given [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (or (>= i (form/count-of declared)) (>= i (form/count-of given)))
       acc
       (let [g (form/nth-of given i)
             d (form/nth-of declared i)]
         (ex-param-types declared given (+ i 1)
                         (form/append-form acc (if (ftruthy? g) g (if (ftruthy? d) d (form/keyword-form :i64))))))))
   :default nil)

#?(:kotoba
   (defn- ex-impl-method [method-form [:ref :form/r] protocol [:ref :form/r] protocol-name [:ref :form/r] record [:ref :form/r] record-name [:ref :form/r]] [:ref :form/r]
     (let [method-name (form/nth-of method-form 0)
           params (form/nth-of method-form 1)
           body (fdrop method-form 2)
           declared-params (form/form-get (fget protocol :methods) method-name)
           ok1 (require-k (form/is-vec? params) "protocol method parameters must be a vector"
                          "kotoba.error/protocol-method" method-form)
           parts (protocol-method-param-parts params)
           names (if (form/is-nil? parts) params (fget parts :names))
           ok2 (require-k (and (ftruthy? declared-params) (= (form/count-of names) (form/count-of declared-params)))
                          "protocol method does not match its declaration"
                          "kotoba.error/protocol-method" method-form)
           ok3 (require-k (and (not (form/is-nil? parts))
                               (ex-all-valid-names? (fget parts :names) 0)
                               (fdistinct? (fget parts :names) 0)
                               (or (= 0 (form/count-of (fget parts :types))) (form/is-nil? (form/nth-of (fget parts :types) 0))))
                          "protocol method parameters must be unique unqualified symbols"
                          "kotoba.error/protocol-method" method-form)
           ok4 (ex-validate-types (form/form-vec (fl-drop (form/kids-of (fget parts :types)) 1)) 0)
           ok5 (require-k (= 1 (vector-count body)) "protocol method must contain one result expression"
                          "kotoba.error/protocol-method" method-form)]
       (fput (fput (fput (fput (fput (fput (fput (form/form-map (form/no-forms)) :protocol protocol-name)
                                                 :method method-name)
                                           :record record-name)
                                     :record-type (fget record :descriptor))
                               :params (fget parts :names))
                         :param-types (form/form-vec (ex-param-types (form/form-get (fget protocol :param-types) method-name)
                                                                     (fget parts :types) 0 (form/no-forms))))
                   :body (fl-nth body 0))))
   :default nil)

#?(:kotoba
   (defn- ex-impl-methods [method-forms [:list [:ref :form/r]] i :i64 protocol [:ref :form/r] protocol-name [:ref :form/r] record [:ref :form/r] record-name [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count method-forms))
       acc
       (ex-impl-methods method-forms (+ i 1) protocol protocol-name record record-name
                        (form/append-form acc (ex-impl-method (fl-nth method-forms i) protocol protocol-name record record-name)))))
   :default nil)

;; protocols / records are Form maps keyed by name; method-forms a Form list of `(method [this ...] body)`
#?(:kotoba
   (defn extension-implementations [protocols [:ref :form/r] records [:ref :form/r] protocol-name [:ref :form/r] record-name [:ref :form/r] method-forms [:list [:ref :form/r]] whole-form [:ref :form/r]] [:list [:ref :form/r]]
     (let [protocol (form/form-get protocols protocol-name)
           record (form/form-get records record-name)
           declared-methods (if (form/is-nil? protocol) (form/no-forms) (ex-map-keys (fget protocol :methods) 0 (form/no-forms)))
           implemented-methods (ex-form-heads method-forms 0 (form/no-forms))
           ok1 (require-k (and (ftruthy? protocol) (ftruthy? record) (> (vector-count method-forms) 0))
                          "protocol extension requires a declared protocol, record, and methods"
                          "kotoba.error/protocol-extension" whole-form)
           ok2 (require-k (and (fl-distinct? implemented-methods) (ex-same-members? declared-methods implemented-methods))
                          "protocol extension must implement every declared method exactly once"
                          "kotoba.error/protocol-extension" whole-form)]
       (ex-impl-methods method-forms 0 protocol protocol-name record record-name (form/no-forms))))
   :default nil)


;; ---- record constructors and member access ----
;; the rewritten kids of FORM from I (record constructors under the two constructor tables)
#?(:kotoba
   (defn- ex-rc-kids [kids [:list [:ref :form/r]] i :i64 by-map [:ref :form/r] by-wide [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count kids))
       acc
       (ex-rc-kids kids (+ i 1) by-map by-wide
                   (form/append-form acc (rewrite-record-constructors (fl-nth kids i) by-map by-wide)))))
   :default nil)

;; the keywords (name field) of each field symbol
#?(:kotoba
   (defn- ex-field-keys [fields [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of fields))
       acc
       (ex-field-keys fields (+ i 1) (form/append-form acc (fkw (fname (form/nth-of fields i)))))))
   :default nil)

;; the keys of a map Form (even positions)
#?(:kotoba
   (defn- ex-map-key-list [m [:ref :form/r]] [:list [:ref :form/r]] (ex-map-keys m 0 (form/no-forms)))
   :default nil)

;; the leading elements of XS up to (not including) the last
#?(:kotoba
   (defn- ex-butlast [xs [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (fl-slice xs 0 (- (vector-count xs) 1) (form/no-forms)))
   :default nil)

;; the rewritten values of the declared fields of a literal map, in field order
#?(:kotoba
   (defn- ex-field-values [form [:ref :form/r] keys [:list [:ref :form/r]] i :i64 by-map [:ref :form/r] by-wide [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count keys))
       acc
       (ex-field-values form keys (+ i 1) by-map by-wide
                        (form/append-form acc (rewrite-record-constructors (form/form-get form (fl-nth keys i)) by-map by-wide)))))
   :default nil)

;; test/result pairs of CLAUSES (without the final default), the result positions rewritten
#?(:kotoba
   (defn- ex-record-pairs [clauses [:list [:ref :form/r]] i :i64 n :i64 record [:ref :form/r] by-map [:ref :form/r] by-wide [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= (+ i 1) n)
       acc
       (ex-record-pairs clauses (+ i 2) n record by-map by-wide
                        (form/append-form (form/append-form acc (fl-nth clauses i))
                                          (rewrite-record-map-expression (fl-nth clauses (+ i 1)) record by-map by-wide)))))
   :default nil)

;; cond clauses: even positions are tests (rewritten), odd positions are results (record-valued)
#?(:kotoba
   (defn- ex-record-cond [clauses [:list [:ref :form/r]] i :i64 record [:ref :form/r] by-map [:ref :form/r] by-wide [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count clauses))
       acc
       (ex-record-cond clauses (+ i 1) record by-map by-wide
                       (form/append-form acc
                                         (if (= 1 (rem i 2))
                                           (rewrite-record-map-expression (fl-nth clauses i) record by-map by-wide)
                                           (rewrite-record-constructors (fl-nth clauses i) by-map by-wide))))))
   :default nil)

;; let bindings: odd positions are initializers (rewritten)
#?(:kotoba
   (defn- ex-record-let-bindings [bindings [:ref :form/r] i :i64 by-map [:ref :form/r] by-wide [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of bindings))
       acc
       (ex-record-let-bindings bindings (+ i 1) by-map by-wide
                               (form/append-form acc (if (= 1 (rem i 2))
                                                       (rewrite-record-constructors (form/nth-of bindings i) by-map by-wide)
                                                       (form/nth-of bindings i))))))
   :default nil)

;; a body: all but the last rewritten as expressions, the last record-valued
#?(:kotoba
   (defn- ex-record-body [body [:list [:ref :form/r]] i :i64 record [:ref :form/r] by-map [:ref :form/r] by-wide [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count body))
       acc
       (ex-record-body body (+ i 1) record by-map by-wide
                       (form/append-form acc (if (= i (- (vector-count body) 1))
                                               (rewrite-record-map-expression (fl-nth body i) record by-map by-wide)
                                               (rewrite-record-constructors (fl-nth body i) by-map by-wide))))))
   :default nil)

;; Lower a computed, but statically closed, map expression to one nominal record value. Record
;; context propagates only through result positions.
#?(:kotoba
   (defn rewrite-record-map-expression [form [:ref :form/r] record [:ref :form/r] by-map [:ref :form/r] by-wide [:ref :form/r]] [:ref :form/r]
     (let [fields (fget record :fields)
           descriptor (fget record :descriptor)
           head (fhead form)]
       (cond
         (form/is-map? form)
         (let [field-keys (ex-field-keys fields 0 (form/no-forms))
               ok (require-k (ex-same-members? field-keys (ex-map-key-list form))
                             "map-> record construction requires exactly the declared fields"
                             "kotoba.error/record-map-constructor" form)]
           (form/form-seq (form/append-many (form/two-forms (fsym "record-new") descriptor)
                                            (ex-field-values form field-keys 0 by-map by-wide (form/no-forms)))))

         (or (string=? head "if") (string=? head "if-not"))
         (let [ok (require-k (= 4 (form/count-of form)) "computed map-> if requires both record-valued branches"
                             "kotoba.error/record-map-constructor" form)]
           (fmeta-from form (form/form-seq (form/append-form (form/append-form (form/two-forms (form/nth-of form 0)
                                                                                                (rewrite-record-constructors (form/nth-of form 1) by-map by-wide))
                                                                               (rewrite-record-map-expression (form/nth-of form 2) record by-map by-wide))
                                                             (rewrite-record-map-expression (form/nth-of form 3) record by-map by-wide)))))

         (or (string=? head "if-let") (string=? head "if-some"))
         (let [bnd (form/nth-of form 1)
               ok (require-k (and (= 4 (form/count-of form)) (form/is-vec? bnd) (= 2 (form/count-of bnd)))
                             "computed map-> binding conditional requires one binding and both record-valued branches"
                             "kotoba.error/record-map-constructor" form)]
           (fmeta-from form (form/form-seq (form/append-form (form/append-form (form/two-forms (form/nth-of form 0)
                                                                                                (form/vec2 (form/nth-of bnd 0)
                                                                                                           (rewrite-record-constructors (form/nth-of bnd 1) by-map by-wide)))
                                                                               (rewrite-record-map-expression (form/nth-of form 2) record by-map by-wide))
                                                             (rewrite-record-map-expression (form/nth-of form 3) record by-map by-wide)))))

         (string=? head "cond")
         (let [clauses (fdrop form 1)
               n (vector-count clauses)
               ok (require-k (and (= 0 (rem n 2)) (> n 1) (form/eq (fl-nth clauses (- n 2)) (form/keyword-form :else)))
                             "computed map-> cond requires a final :else record value"
                             "kotoba.error/record-map-constructor" form)]
           (fmeta-from form (form/form-seq (form/cons-onto (fsym "cond") (ex-record-cond clauses 0 record by-map by-wide (form/no-forms))))))

         (string=? head "case")
         (let [clauses (fdrop form 2)
               n (vector-count clauses)
               ok (require-k (= 1 (rem n 2)) "computed map-> case requires a default record value"
                             "kotoba.error/record-map-constructor" form)
               pairs (ex-record-pairs clauses 0 (- n 1) record by-map by-wide (form/no-forms))]
           (fmeta-from form (form/form-seq (form/cons-onto (fsym "case")
                                                           (form/cons-onto (rewrite-record-constructors (form/nth-of form 1) by-map by-wide)
                                                                           (form/append-form pairs (rewrite-record-map-expression (fl-nth clauses (- n 1)) record by-map by-wide)))))))

         (string=? head "condp")
         (let [clauses (fdrop form 3)
               n (vector-count clauses)
               ok (require-k (and (ftruthy? (form/nth-of form 1)) (ftruthy? (form/nth-of form 2)) (= 1 (rem n 2)))
                             "computed map-> condp requires a predicate, dispatch, and default record value"
                             "kotoba.error/record-map-constructor" form)
               pairs (ex-record-pairs clauses 0 (- n 1) record by-map by-wide (form/no-forms))]
           (fmeta-from form (form/form-seq (form/cons-onto (fsym "condp")
                                                           (form/cons-onto (rewrite-record-constructors (form/nth-of form 1) by-map by-wide)
                                                                           (form/cons-onto (rewrite-record-constructors (form/nth-of form 2) by-map by-wide)
                                                                                           (form/append-form pairs (rewrite-record-map-expression (fl-nth clauses (- n 1)) record by-map by-wide))))))))

         (string=? head "let")
         (let [bindings (form/nth-of form 1)
               body (fdrop form 2)
               ok (require-k (and (form/is-vec? bindings) (= 0 (rem (form/count-of bindings) 2)) (> (vector-count body) 0))
                             "computed map-> let requires bindings and a result expression"
                             "kotoba.error/record-map-constructor" form)]
           (fmeta-from form (form/form-seq (form/cons-onto (fsym "let")
                                                           (form/cons-onto (form/form-vec (ex-record-let-bindings bindings 0 by-map by-wide (form/no-forms)))
                                                                           (ex-record-body body 0 record by-map by-wide (form/no-forms)))))))

         (string=? head "do")
         (let [body (fdrop form 1)
               ok (require-k (> (vector-count body) 0) "computed map-> do requires a result expression"
                             "kotoba.error/record-map-constructor" form)]
           (fmeta-from form (form/form-seq (form/cons-onto (fsym "do") (ex-record-body body 0 record by-map by-wide (form/no-forms))))))

         :else
         (let [ok (require-k false (str "map-> record construction requires an exact map or a closed "
                                        "control expression of exact maps")
                             "kotoba.error/record-map-constructor" form)]
           form))))
   :default nil)

#?(:kotoba
   (defn rewrite-record-constructors [form [:ref :form/r] by-map [:ref :form/r] by-wide [:ref :form/r]] [:ref :form/r]
     (cond
       (form/is-seq? form)
       (let [op (if (> (form/count-of form) 0) (form/nth-of form 0) (form/nil-form))
             args (fdrop form 1)]
         (fmeta-from
          form
          (cond
            (fhead-is? form "quote") form
            (form/form-has? by-map op)
            (let [record (form/form-get by-map op)
                  ok (require-k (= 1 (vector-count args)) "map-> record construction requires one map expression"
                                "kotoba.error/record-map-constructor" form)]
              (rewrite-record-map-expression (fl-nth args 0) record by-map by-wide))
            (form/form-has? by-wide op)
            (let [record (form/form-get by-wide op)
                  ok (require-k (= (form/count-of (fget record :fields)) (vector-count args))
                                "positional record construction must exactly match the declared fields"
                                "kotoba.error/record-positional-constructor" form)]
              (form/form-seq (form/append-many (form/two-forms (fsym "record-new") (fget record :descriptor))
                                               (ex-rc-kids args 0 by-map by-wide (form/no-forms)))))
            :else
            (form/form-seq (form/cons-onto op (ex-rc-kids args 0 by-map by-wide (form/no-forms)))))))
       (or (form/is-vec? form) (form/is-map? form) (form/is-set? form))
       (record-assoc [:ref :form/r] form :kids (ex-rc-kids (form/kids-of form) 0 by-map by-wide (form/no-forms)))
       :else form))
   :default nil)

;; ---- member access ----
;; does PATTERN bind RECEIVER?
#?(:kotoba
   (defn- ex-binds? [pattern [:ref :form/r] receiver [:ref :form/r]] :bool
     (fl-has? (form/kids-of (binding-symbols pattern)) receiver 0))
   :default nil)

;; Rewrite sequential binding values while tracking whether a pattern shadows the receiver; the
;; answer is a Form vector [bindings active?]
#?(:kotoba
   (defn- ex-record-bindings [bindings [:ref :form/r] j :i64 receiver [:ref :form/r] descriptor [:ref :form/r] active? :bool acc [:list [:ref :form/r]]] [:ref :form/r]
     (if (>= (+ j 1) (form/count-of bindings))
       (form/vec2 (form/form-vec acc) (form/bool-form active?))
       (let [pattern (form/nth-of bindings j)
             value (form/nth-of bindings (+ j 1))]
         (ex-record-bindings bindings (+ j 2) receiver descriptor
                             (and active? (not (ex-binds? pattern receiver)))
                             (form/append-form (form/append-form acc pattern)
                                               (rewrite-record-member-access* value receiver descriptor active?))))))
   :default nil)

#?(:kotoba
   (defn rewrite-record-bindings [bindings [:ref :form/r] receiver [:ref :form/r] descriptor [:ref :form/r] active? :bool] [:ref :form/r]
     (ex-record-bindings bindings 0 receiver descriptor active? (form/no-forms)))
   :default nil)

#?(:kotoba
   (defn- ex-ra-kids [kids [:list [:ref :form/r]] i :i64 receiver [:ref :form/r] descriptor [:ref :form/r] active? :bool acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count kids))
       acc
       (ex-ra-kids kids (+ i 1) receiver descriptor active?
                   (form/append-form acc (rewrite-record-member-access* (fl-nth kids i) receiver descriptor active?)))))
   :default nil)

#?(:kotoba
   (defn rewrite-record-fn-clause [clause [:ref :form/r] receiver [:ref :form/r] descriptor [:ref :form/r] active? :bool named-receiver? :bool] [:ref :form/r]
     (let [params (form/nth-of clause 0)
           body-active (and active? (not named-receiver?) (form/is-vec? params) (not (ex-binds? params receiver)))]
       (if (form/is-vec? params)
         (fmeta-from clause (form/form-seq (form/cons-onto params (ex-ra-kids (fdrop clause 1) 0 receiver descriptor body-active (form/no-forms)))))
         clause)))
   :default nil)

#?(:kotoba
   (defn- ex-fn-clauses [clauses [:list [:ref :form/r]] i :i64 receiver [:ref :form/r] descriptor [:ref :form/r] active? :bool named-receiver? :bool acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count clauses))
       acc
       (ex-fn-clauses clauses (+ i 1) receiver descriptor active? named-receiver?
                      (form/append-form acc (rewrite-record-fn-clause (fl-nth clauses i) receiver descriptor active? named-receiver?)))))
   :default nil)

;; loop bindings: values rewritten, patterns kept; the body is active unless a pattern shadows
#?(:kotoba
   (defn- ex-loop-bindings [bindings [:ref :form/r] j :i64 receiver [:ref :form/r] descriptor [:ref :form/r] active? :bool acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= (+ j 1) (form/count-of bindings))
       acc
       (ex-loop-bindings bindings (+ j 2) receiver descriptor active?
                         (form/append-form (form/append-form acc (form/nth-of bindings j))
                                           (rewrite-record-member-access* (form/nth-of bindings (+ j 1)) receiver descriptor active?)))))
   :default nil)

#?(:kotoba
   (defn- ex-loop-shadows? [bindings [:ref :form/r] j :i64 receiver [:ref :form/r]] :bool
     (if (>= (+ j 1) (form/count-of bindings))
       false
       (if (ex-binds? (form/nth-of bindings j) receiver) true (ex-loop-shadows? bindings (+ j 2) receiver))))
   :default nil)

#?(:kotoba
   (defn- ex-ra-call [form [:ref :form/r] receiver [:ref :form/r] descriptor [:ref :form/r]] [:ref :form/r]
     (let [op (form/nth-of form 0)
           args (fdrop form 1)
           head (fhead form)]
       (cond
         (string=? head "quote") form
         (and (string=? head "get")
              (<= 2 (vector-count args)) (<= (vector-count args) 3)
              (form/eq receiver (fl-nth args 0))
              (form/is-keyword? (fl-nth args 1)))
         (form/call3 "record-get" descriptor receiver (fl-nth args 1))
         (string=? head "let")
         (let [bindings (if (> (vector-count args) 0) (fl-nth args 0) (form/nil-form))]
           (if (and (form/is-vec? bindings) (= 0 (rem (form/count-of bindings) 2)))
             (let [r (rewrite-record-bindings bindings receiver descriptor true)
                   body-active (form/bool-value (form/nth-of r 1))]
               (form/form-seq (form/cons-onto op (form/cons-onto (form/nth-of r 0)
                                                                 (ex-ra-kids (fl-drop args 1) 0 receiver descriptor body-active (form/no-forms))))))
             (form/form-seq (form/cons-onto op (ex-ra-kids args 0 receiver descriptor true (form/no-forms))))))
         (string=? head "loop")
         (let [bindings (if (> (vector-count args) 0) (fl-nth args 0) (form/nil-form))]
           (if (and (form/is-vec? bindings) (= 0 (rem (form/count-of bindings) 2)))
             (let [bindings2 (form/form-vec (ex-loop-bindings bindings 0 receiver descriptor true (form/no-forms)))
                   body-active (not (ex-loop-shadows? bindings 0 receiver))]
               (form/form-seq (form/cons-onto (fsym "loop") (form/cons-onto bindings2
                                                                            (ex-ra-kids (fl-drop args 1) 0 receiver descriptor body-active (form/no-forms))))))
             (form/form-seq (form/cons-onto (fsym "loop") (ex-ra-kids args 0 receiver descriptor true (form/no-forms))))))
         (string=? head "fn")
         (let [named (and (> (vector-count args) 0) (form/is-symbol? (fl-nth args 0)))
               fn-name (if named (fl-nth args 0) (form/nil-form))
               clauses (if named (fl-drop args 1) args)
               named-receiver (form/eq receiver fn-name)
               first-clause (if (> (vector-count clauses) 0) (fl-nth clauses 0) (form/nil-form))]
           (if (form/is-vec? first-clause)
             ;; (fn [params] body...): the clause is the params and the body together
             (let [rewritten (rewrite-record-fn-clause (form/form-seq clauses) receiver descriptor true named-receiver)]
               (form/form-seq (form/cons-onto (fsym "fn")
                                              (form/append-many (if named (form/one-form fn-name) (form/no-forms))
                                                                (form/kids-of rewritten)))))
             (form/form-seq (form/cons-onto (fsym "fn")
                                            (form/append-many (if named (form/one-form fn-name) (form/no-forms))
                                                              (ex-fn-clauses clauses 0 receiver descriptor true named-receiver (form/no-forms)))))))
         :else
         (form/form-seq (form/cons-onto op (ex-ra-kids args 0 receiver descriptor true (form/no-forms)))))))
   :default nil)



#?(:kotoba
   (defn rewrite-record-member-access* [form [:ref :form/r] receiver [:ref :form/r] descriptor [:ref :form/r] active? :bool] [:ref :form/r]
     (if (not active?)
       form
       (cond
         (form/is-seq? form) (fmeta-from form (ex-ra-call form receiver descriptor))
         (or (form/is-vec? form) (form/is-map? form) (form/is-set? form))
         (record-assoc [:ref :form/r] form :kids (ex-ra-kids (form/kids-of form) 0 receiver descriptor true (form/no-forms)))
         :else form)))
   :default nil)

#?(:kotoba
   (defn rewrite-record-member-access [form [:ref :form/r] receiver [:ref :form/r] descriptor [:ref :form/r]] [:ref :form/r]
     (rewrite-record-member-access* form receiver descriptor true))
   :default nil)

;; ---- record, extend-type and extend-protocol forms ----
;; the sections of an extension: [protocol-name methods] pairs, each protocol name followed by
;; its leading seq forms. Answers a Form vector of [name methods-vec].
#?(:kotoba
   (defn- ex-leading-seqs [xs [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (and (< i (vector-count xs)) (form/is-seq? (fl-nth xs i)))
       (ex-leading-seqs xs (+ i 1) (form/append-form acc (fl-nth xs i)))
       acc))
   :default nil)

#?(:kotoba
   (defn- ex-extension-groups [remaining [:list [:ref :form/r]] whole-form [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (= 0 (vector-count remaining))
       acc
       (let [protocol-name (fl-nth remaining 0)
             methods (ex-leading-seqs remaining 1 (form/no-forms))
             ok (require-k (and (form/is-symbol? protocol-name) (> (vector-count methods) 0))
                           "protocol extension section requires a protocol name and methods"
                           "kotoba.error/protocol-extension" whole-form)]
         (ex-extension-groups (fl-drop remaining (+ 1 (vector-count methods))) whole-form
                              (form/append-form acc (form/vec2 protocol-name (form/form-vec methods)))))))
   :default nil)

#?(:kotoba
   (defn protocol-extension-groups [extra [:list [:ref :form/r]] whole-form [:ref :form/r]] [:list [:ref :form/r]]
     (ex-extension-groups extra whole-form (form/no-forms)))
   :default nil)

;; the implementations of each group of GROUPS for RECORD-NAME
#?(:kotoba
   (defn- ex-group-impls [groups [:list [:ref :form/r]] i :i64 protocols [:ref :form/r] records [:ref :form/r] record-name [:ref :form/r] whole-form [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count groups))
       acc
       (let [g (fl-nth groups i)]
         (ex-group-impls groups (+ i 1) protocols records record-name whole-form
                         (form/append-many acc (extension-implementations protocols records (form/nth-of g 0) record-name
                                                                          (form/kids-of (form/nth-of g 1)) whole-form))))))
   :default nil)

#?(:kotoba
   (defn extend-type-form->implementations [protocols [:ref :form/r] records [:ref :form/r] form [:ref :form/r]] [:list [:ref :form/r]]
     (let [record-name (form/nth-of form 1)
           extra (fdrop form 2)
           ok (require-k (and (ftruthy? (form/form-get records record-name)) (> (vector-count extra) 0))
                         "extend-type requires one declared record and bounded protocol sections"
                         "kotoba.error/protocol-extension" form)]
       (ex-group-impls (protocol-extension-groups extra form) 0 protocols records record-name form (form/no-forms))))
   :default nil)

;; Read one `(extend-protocol Protocol Record (method ...) ... default (method ...))`: a Form map
;; {:protocol :implementations :default-methods :form}
#?(:kotoba
   (defn- ex-protocol-sections [remaining [:list [:ref :form/r]] protocols [:ref :form/r] records [:ref :form/r] protocol-name [:ref :form/r] form [:ref :form/r] implementations [:list [:ref :form/r]] default-methods [:ref :form/r]] [:ref :form/r]
     (if (= 0 (vector-count remaining))
       (fput (fput (fput (fput (form/form-map (form/no-forms)) :protocol protocol-name)
                         :implementations (form/form-vec implementations))
                   :default-methods default-methods)
             :form form)
       (let [record-name (fl-nth remaining 0)
             methods (ex-leading-seqs remaining 1 (form/no-forms))
             ok1 (require-k (and (form/is-symbol? record-name) (> (vector-count methods) 0))
                            "extend-protocol type section requires a record name and methods"
                            "kotoba.error/protocol-extension" form)
             rest-sections (fl-drop remaining (+ 1 (vector-count methods)))]
         (if (fsym= record-name "default")
           (let [ok2 (require-k (form/is-nil? default-methods) "extend-protocol permits at most one default section"
                                "kotoba.error/protocol-extension" form)]
             (ex-protocol-sections rest-sections protocols records protocol-name form implementations (form/form-vec methods)))
           (ex-protocol-sections rest-sections protocols records protocol-name form
                                 (form/append-many implementations
                                                   (extension-implementations protocols records protocol-name record-name methods form))
                                 default-methods)))))
   :default nil)

#?(:kotoba
   (defn fsym= [f [:ref :form/r] text :string] :bool
     (and (form/is-symbol? f) (string=? (form/symbol-value f) text)))
   :default nil)

#?(:kotoba
   (defn extend-protocol-form->info [protocols [:ref :form/r] records [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (let [protocol-name (form/nth-of form 1)
           sections (fdrop form 2)
           ok (require-k (and (ftruthy? (form/form-get protocols protocol-name)) (> (vector-count sections) 0))
                         "extend-protocol requires one declared protocol and bounded type sections"
                         "kotoba.error/protocol-extension" form)]
       (ex-protocol-sections sections protocols records protocol-name form (form/no-forms) (form/nil-form))))
   :default nil)

;; the implementations of every group for the record being declared, all under {record-name record}
#?(:kotoba
   (defn- ex-record-impls [groups [:list [:ref :form/r]] i :i64 protocols [:ref :form/r] records [:ref :form/r] record-name [:ref :form/r] whole-form [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count groups))
       acc
       (let [g (fl-nth groups i)]
         (ex-record-impls groups (+ i 1) protocols records record-name whole-form
                          (form/append-many acc (extension-implementations protocols records (form/nth-of g 0) record-name
                                                                           (form/kids-of (form/nth-of g 1)) whole-form))))))
   :default nil)

;; the field parts' names
#?(:kotoba
   (defn- ex-part-names [parts [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count parts))
       acc
       (ex-part-names parts (+ i 1) (form/append-form acc (fget (fl-nth parts i) :name)))))
   :default nil)

#?(:kotoba
   (defn record-form->info [namespace-symbol [:ref :form/r] protocols [:ref :form/r] form [:ref :form/r]] [:ref :form/r]
     (let [record-name (form/nth-of form 1)
           fields (form/nth-of form 2)
           extra (fdrop form 3)
           ok1 (require-k (and (valid-name? record-name) (form/is-vec? fields))
                          "defrecord requires a bounded name and field vector"
                          "kotoba.error/record-declaration" form)
           field-parts (record-field-parts fields form)
           field-names (ex-part-names field-parts 0 (form/no-forms))
           typed? (not (form/eq fields (form/form-vec field-names)))
           ok2 (require-k (and (<= (vector-count field-parts) (max-record-fields)) (fl-distinct? field-names))
                          (str "defrecord requires at most " (string-from-i64 (max-record-fields)) " unique fields")
                          "kotoba.error/record-declaration" form)
           descriptor (record-descriptor namespace-symbol record-name (form/form-vec field-parts))
           groups (protocol-extension-groups extra form)
           record (fput (fput (fput (fput (fput (form/form-map (form/no-forms)) :name record-name)
                                          :fields (form/form-vec field-names))
                                    :field-parts (form/form-vec field-parts))
                              :typed? (form/bool-form typed?))
                        :descriptor descriptor)
           implementations (ex-record-impls groups 0 protocols (form/assoc-form (form/form-map (form/no-forms)) record-name record)
                                            record-name form (form/no-forms))]
       (fput record :implementations (form/form-vec implementations))))
   :default nil)


;; ---- expand-record-protocol-forms ----
;; a map name -> info of INFOS (maps carrying :name); duplicate names are reported by the caller
#?(:kotoba
   (defn- ex-infos-by-name [infos [:list [:ref :form/r]] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (vector-count infos))
       acc
       (let [info (fl-nth infos i)]
         (ex-infos-by-name infos (+ i 1) (form/assoc-form acc (fget info :name) info)))))
   :default nil)

#?(:kotoba
   (defn- ex-map-infos [forms [:list [:ref :form/r]] i :i64 kind :i64 a [:ref :form/r] b [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count forms))
       acc
       (let [f (fl-nth forms i)]
         (ex-map-infos forms (+ i 1) kind a b
                       (form/append-form acc
                                         (cond
                                           (= kind 0) (protocol-form->info f)
                                           (= kind 1) (record-form->info a b f)
                                           :else (extend-protocol-form->info a b f)))))))
   :default nil)

#?(:kotoba
   (defn- ex-extend-type-impls [forms [:list [:ref :form/r]] i :i64 protocols [:ref :form/r] records [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count forms))
       acc
       (ex-extend-type-impls forms (+ i 1) protocols records
                             (form/append-many acc (extend-type-form->implementations protocols records (fl-nth forms i))))))
   :default nil)

;; the concatenation of KEY's list of each info
#?(:kotoba
   (defn- ex-concat-key [infos [:list [:ref :form/r]] key :keyword i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count infos))
       acc
       (ex-concat-key infos key (+ i 1) (form/append-many acc (form/kids-of (fget (fl-nth infos i) key))))))
   :default nil)

;; the method names (keys of each protocol's :methods map)
#?(:kotoba
   (defn- ex-all-method-names [infos [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count infos))
       acc
       (ex-all-method-names infos (+ i 1) (form/append-many acc (ex-map-keys (fget (fl-nth infos i) :methods) 0 (form/no-forms))))))
   :default nil)

#?(:kotoba
   (defn- ex-declared-function-names [forms [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count forms))
       acc
       (let [f (fl-nth forms i)]
         (ex-declared-function-names forms (+ i 1)
                                     (if (or (fhead-is? f "defn") (fhead-is? f "defn-")) (form/append-form acc (form/nth-of f 1)) acc)))))
   :default nil)

#?(:kotoba
   (defn- ex-intersects? [a [:list [:ref :form/r]] b [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count a))
       false
       (if (fl-has? b (fl-nth a i) 0) true (ex-intersects? a b (+ i 1)))))
   :default nil)

;; the identity [protocol method record] of each implementation
#?(:kotoba
   (defn- ex-impl-identities [impls [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count impls))
       acc
       (let [m (fl-nth impls i)]
         (ex-impl-identities impls (+ i 1)
                             (form/append-form acc (form/form-vec (form/three-forms (fget m :protocol) (fget m :method) (fget m :record))))))))
   :default nil)

;; the infos whose :default-methods is set
#?(:kotoba
   (defn- ex-default-infos [infos [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count infos))
       acc
       (let [info (fl-nth infos i)]
         (ex-default-infos infos (+ i 1) (if (ftruthy? (fget info :default-methods)) (form/append-form acc info) acc)))))
   :default nil)

#?(:kotoba
   (defn- ex-info-keys [infos [:list [:ref :form/r]] key :keyword i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count infos))
       acc
       (ex-info-keys infos key (+ i 1) (form/append-form acc (fget (fl-nth infos i) key)))))
   :default nil)

;; the records of EXPLICIT implementations of PROTOCOL
#?(:kotoba
   (defn- ex-implemented-records [impls [:list [:ref :form/r]] protocol [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count impls))
       acc
       (let [m (fl-nth impls i)]
         (ex-implemented-records impls protocol (+ i 1)
                                 (if (form/eq (fget m :protocol) protocol) (fl-add acc (fget m :record)) acc)))))
   :default nil)

;; the default section specialized for each record that has no explicit implementation
#?(:kotoba
   (defn- ex-default-for-records [record-infos [:list [:ref :form/r]] i :i64 protocols [:ref :form/r] records [:ref :form/r] protocol [:ref :form/r] default-methods [:ref :form/r] form [:ref :form/r] implemented [:list [:ref :form/r]] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count record-infos))
       acc
       (let [name (fget (fl-nth record-infos i) :name)]
         (ex-default-for-records record-infos (+ i 1) protocols records protocol default-methods form implemented
                                 (if (fl-has? implemented name 0)
                                   acc
                                   (form/append-many acc (extension-implementations protocols records protocol name
                                                                                    (form/kids-of default-methods) form)))))))
   :default nil)

#?(:kotoba
   (defn- ex-default-impls [default-infos [:list [:ref :form/r]] i :i64 record-infos [:list [:ref :form/r]] protocols [:ref :form/r] records [:ref :form/r] explicit [:list [:ref :form/r]] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count default-infos))
       acc
       (let [info (fl-nth default-infos i)
             protocol (fget info :protocol)
             default-methods (fget info :default-methods)
             form (fget info :form)
             ok1 (require-k (> (vector-count record-infos) 0)
                            "extend-protocol default has no declared record specialization targets"
                            "kotoba.error/protocol-extension" form)
             ;; validate the section even when every record has an explicit implementation
             checked (extension-implementations protocols records protocol (fget (fl-nth record-infos 0) :name)
                                                (form/kids-of default-methods) form)
             implemented (ex-implemented-records explicit protocol 0 (form/no-forms))]
         (ex-default-impls default-infos (+ i 1) record-infos protocols records explicit
                           (form/append-many acc (ex-default-for-records record-infos 0 protocols records protocol default-methods form implemented (form/no-forms)))))))
   :default nil)

#?(:kotoba
   (defn- ex-name-impls [impls [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count impls))
       acc
       (ex-name-impls impls (+ i 1)
                      (form/append-form acc (fput (fl-nth impls i) :impl-name
                                                  (fsym (string-concat "__kotoba_protocol_impl_" (string-from-i64 i))))))))
   :default nil)

;; (defn ->Name params descriptor (record-new descriptor fields...)) for each record narrow enough to be first-class
#?(:kotoba
   (defn- ex-typed-ctor-params [field-parts [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of field-parts))
       acc
       (let [p (form/nth-of field-parts i)]
         (ex-typed-ctor-params field-parts (+ i 1) (form/append-form (form/append-form acc (fget p :name)) (fget p :type))))))
   :default nil)

#?(:kotoba
   (defn- ex-constructor [r [:ref :form/r]] [:ref :form/r]
     (let [fields (fget r :fields)
           descriptor (fget r :descriptor)
           params (if (form/bool-value (fget r :typed?))
                    (form/form-vec (ex-typed-ctor-params (fget r :field-parts) 0 (form/no-forms)))
                    fields)
           body (form/form-seq (form/cons-onto (fsym "record-new") (form/cons-onto descriptor (form/kids-of fields))))]
       (form/form-seq (form/append-form (form/append-form (form/append-form (form/two-forms (fsym "defn") (fsym (string-concat "->" (form-text (fget r :name))))) params)
                                                          descriptor)
                                        body))))
   :default nil)

#?(:kotoba
   (defn- ex-constructors [records [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count records))
       acc
       (let [r (fl-nth records i)]
         (ex-constructors records (+ i 1)
                          (if (<= (form/count-of (fget r :fields)) (max-parameters))
                            (form/append-form acc (ex-constructor r))
                            acc)))))
   :default nil)

;; [param type] per parameter: the receiver (index 0) is typed by the record, the rest by their declared types
#?(:kotoba
   (defn- ex-impl-params [params [:ref :form/r] param-types [:ref :form/r] record-type [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of params))
       acc
       (ex-impl-params params param-types record-type (+ i 1)
                       (form/append-form (form/append-form acc (form/nth-of params i))
                                         (if (= i 0) record-type (form/nth-of param-types i))))))
   :default nil)

#?(:kotoba
   (defn- ex-impl-defs [impls [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count impls))
       acc
       (let [m (fl-nth impls i)
             params (fget m :params)
             record-type (fget m :record-type)
             typed-params (form/form-vec (ex-impl-params params (fget m :param-types) record-type 0 (form/no-forms)))]
         (ex-impl-defs impls (+ i 1)
                       (form/append-form acc
                                         (form/form-seq (form/append-form (form/append-form (form/two-forms (fsym "defn-") (fget m :impl-name)) typed-params)
                                                                          (rewrite-record-member-access (fget m :body) (form/nth-of params 0) record-type))))))))
   :default nil)

;; {record-keyword impl-name} for the implementations of METHOD-NAME
#?(:kotoba
   (defn- ex-method-impls [impls [:list [:ref :form/r]] method-name [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (vector-count impls))
       acc
       (let [m (fl-nth impls i)]
         (ex-method-impls impls method-name (+ i 1)
                          (if (form/eq (fget m :method) method-name)
                            (form/assoc-form acc (form/nth-of (fget m :record-type) 1) (fget m :impl-name))
                            acc)))))
   :default nil)

;; {method-name {:arity n :implementations {...}}} over every protocol's methods
#?(:kotoba
   (defn- ex-dispatch-methods [protocol-infos [:list [:ref :form/r]] pi :i64 impls [:list [:ref :form/r]] acc [:ref :form/r]] [:ref :form/r]
     (if (>= pi (vector-count protocol-infos))
       acc
       (let [methods (fget (fl-nth protocol-infos pi) :methods)]
         (ex-dispatch-methods protocol-infos (+ pi 1) impls (ex-dispatch-one methods 0 impls acc)))))
   :default nil)

#?(:kotoba
   (defn- ex-dispatch-one [methods [:ref :form/r] j :i64 impls [:list [:ref :form/r]] acc [:ref :form/r]] [:ref :form/r]
     (if (>= (+ j 1) (form/count-of methods))
       acc
       (let [name (form/nth-of methods j)
             params (form/nth-of methods (+ j 1))]
         (ex-dispatch-one methods (+ j 2) impls
                          (form/assoc-form acc name
                                           (fput (fput (form/form-map (form/no-forms)) :arity (form/int-form (form/count-of params)))
                                                 :implementations (ex-method-impls impls name 0 (form/form-map (form/no-forms)))))))))
   :default nil)

;; {map->Name record} for each record
#?(:kotoba
   (defn- ex-map-ctors [records [:list [:ref :form/r]] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (vector-count records))
       acc
       (let [r (fl-nth records i)]
         (ex-map-ctors records (+ i 1) (form/assoc-form acc (fsym (string-concat "map->" (form-text (fget r :name)))) r)))))
   :default nil)

;; {->Name record} for each record too wide to be a first-class constructor
#?(:kotoba
   (defn- ex-wide-ctors [records [:list [:ref :form/r]] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (vector-count records))
       acc
       (let [r (fl-nth records i)]
         (ex-wide-ctors records (+ i 1)
                        (if (> (form/count-of (fget r :fields)) (max-parameters))
                          (form/assoc-form acc (fsym (string-concat "->" (form-text (fget r :name)))) r)
                          acc)))))
   :default nil)

;; some subform of T is a record or variant type
#?(:kotoba
   (defn- ex-inline-nominal? [t [:ref :form/r]] :bool
     (if (or (record-type? t) (variant-type? t)) true (ex-inline-nominal-kids? (form/kids-of t) 0)))
   :default nil)

#?(:kotoba
   (defn- ex-inline-nominal-kids? [kids [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count kids))
       false
       (if (ex-inline-nominal? (fl-nth kids i)) true (ex-inline-nominal-kids? kids (+ i 1)))))
   :default nil)

;; some field type of the descriptor `[:record id [[field type] ...]]` holds an inline nominal type
#?(:kotoba
   (defn- ex-fields-inline-nominal? [fields [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of fields))
       false
       (if (ex-inline-nominal? (form/nth-of (form/nth-of fields i) 1)) true (ex-fields-inline-nominal? fields (+ i 1)))))
   :default nil)

;; {record-keyword descriptor}: a record whose fields already use closed schema edges
#?(:kotoba
   (defn- ex-record-schemas [records [:list [:ref :form/r]] i :i64 acc [:ref :form/r]] [:ref :form/r]
     (if (>= i (vector-count records))
       acc
       (let [descriptor (fget (fl-nth records i) :descriptor)]
         (ex-record-schemas records (+ i 1)
                            (if (ex-fields-inline-nominal? (form/nth-of descriptor 2) 0)
                              acc
                              (form/assoc-form acc (form/nth-of descriptor 1) descriptor))))))
   :default nil)

;; the forms that are not declarations, constructors rewritten
#?(:kotoba
   (defn- ex-ordinary-forms [forms [:list [:ref :form/r]] i :i64 by-map [:ref :form/r] by-wide [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count forms))
       acc
       (let [f (fl-nth forms i)
             h (fhead f)
             declaration (or (string=? h "defrecord") (string=? h "defprotocol") (string=? h "definterface")
                             (string=? h "extend-type") (string=? h "extend-protocol"))]
         (ex-ordinary-forms forms (+ i 1) by-map by-wide
                            (if declaration acc (form/append-form acc (rewrite-record-constructors f by-map by-wide)))))))
   :default nil)

#?(:kotoba
   (defn- ex-namespace-symbol [forms [:list [:ref :form/r]] i :i64] [:ref :form/r]
     (if (>= i (vector-count forms))
       (fsym "kotoba.user")
       (let [f (fl-nth forms i)]
         (if (fhead-is? f "ns")
           (form/nth-of f 1)
           (ex-namespace-symbol forms (+ i 1))))))
   :default nil)

;; the protocol-declaration forms of FORMS
#?(:kotoba
   (defn- ex-protocol-forms [forms [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count forms))
       acc
       (let [f (fl-nth forms i)]
         (ex-protocol-forms forms (+ i 1)
                            (if (and (form/is-seq? f) (tables/protocol-declaration-heads-has? (form/nth-of f 0)))
                              (form/append-form acc f)
                              acc)))))
   :default nil)

;; Expand defrecord / defprotocol / extend-type / extend-protocol: a Form map
;; {:forms :dispatch :record-schemas}
#?(:kotoba
   (defn expand-record-protocol-forms [forms [:list [:ref :form/r]]] [:ref :form/r]
     (let [namespace-symbol (ex-namespace-symbol forms 0)
           protocol-forms (ex-protocol-forms forms 0 (form/no-forms))
           protocol-infos (ex-map-infos protocol-forms 0 0 (form/nil-form) (form/nil-form) (form/no-forms))
           protocols (ex-infos-by-name protocol-infos 0 (form/form-map (form/no-forms)))
           ok1 (require-k (= (form/count-of protocols) (* 2 (vector-count protocol-infos))) "duplicate protocol name"
                          "kotoba.error/protocol-declaration" (form/form-vec protocol-forms))
           method-names (ex-all-method-names protocol-infos 0 (form/no-forms))
           ok2 (require-k (fl-distinct? method-names) "protocol method names must be unique within a namespace"
                          "kotoba.error/protocol-declaration" (form/form-vec protocol-forms))
           ok3 (require-k (not (ex-intersects? method-names (ex-declared-function-names forms 0 (form/no-forms)) 0))
                          "protocol method names must not collide with declared functions"
                          "kotoba.error/protocol-declaration" (form/form-vec protocol-forms))
           record-forms (ex-select-head forms "defrecord" 0 (form/no-forms))
           record-infos (ex-map-infos record-forms 0 1 namespace-symbol protocols (form/no-forms))
           records (ex-infos-by-name record-infos 0 (form/form-map (form/no-forms)))
           ok4 (require-k (= (form/count-of records) (* 2 (vector-count record-infos))) "duplicate record name"
                          "kotoba.error/record-declaration" (form/form-vec record-forms))
           extend-type-forms (ex-select-head forms "extend-type" 0 (form/no-forms))
           extend-type-impls (ex-extend-type-impls extend-type-forms 0 protocols records (form/no-forms))
           extend-protocol-forms (ex-select-head forms "extend-protocol" 0 (form/no-forms))
           extend-protocol-infos (ex-map-infos extend-protocol-forms 0 2 protocols records (form/no-forms))
           default-infos (ex-default-infos extend-protocol-infos 0 (form/no-forms))
           ok5 (require-k (fl-distinct? (ex-info-keys default-infos :protocol 0 (form/no-forms)))
                          "extend-protocol permits one default section per protocol"
                          "kotoba.error/protocol-extension" (form/form-vec extend-protocol-forms))
           explicit (form/append-many (form/append-many (ex-concat-key record-infos :implementations 0 (form/no-forms)) extend-type-impls)
                                      (ex-concat-key extend-protocol-infos :implementations 0 (form/no-forms)))
           ok6 (require-k (fl-distinct? (ex-impl-identities explicit 0 (form/no-forms))) "duplicate protocol method implementation"
                          "kotoba.error/protocol-extension" (form/form-vec explicit))
           default-impls (ex-default-impls default-infos 0 record-infos protocols records explicit (form/no-forms))
           implementations (form/append-many explicit default-impls)
           ok7 (require-k (fl-distinct? (ex-impl-identities implementations 0 (form/no-forms))) "duplicate protocol method implementation"
                          "kotoba.error/protocol-extension" (form/form-vec implementations))
           named (ex-name-impls implementations 0 (form/no-forms))
           constructors (ex-constructors record-infos 0 (form/no-forms))
           impl-defs (ex-impl-defs named 0 (form/no-forms))
           dispatch (fput (form/form-map (form/no-forms)) :methods
                          (ex-dispatch-methods protocol-infos 0 named (form/form-map (form/no-forms))))
           map-constructors (ex-map-ctors record-infos 0 (form/form-map (form/no-forms)))
           wide (ex-wide-ctors record-infos 0 (form/form-map (form/no-forms)))
           schemas (ex-record-schemas record-infos 0 (form/form-map (form/no-forms)))
           rewritten (ex-ordinary-forms forms 0 map-constructors wide (form/no-forms))]
       (fput (fput (fput (form/form-map (form/no-forms)) :forms (form/form-vec (form/append-many (form/append-many rewritten constructors) impl-defs)))
                   :dispatch dispatch)
             :record-schemas schemas)))
   :default nil)

#?(:kotoba nil :default
(defn nothing-rewritten?
  "True when every rewritten child is the very object it started as.
  `identical?` and not `=`, because the point is to return the ORIGINAL
  collection rather than an equal copy: an equal copy of a map literal is a
  rebuilt map, and rebuilding is what hashes."
  [originals rewritten]
  (and (= (count originals) (count rewritten))
       (every? true? (map identical? originals rewritten)))))

;; State ability, slice 1 (kotoba-lang `lang/state-ability.edn`). The two
;; operations of the pure ability `state`, and how many values each takes.
;; `(perform :state/get)` and `(perform :state/put v)` are NOT capability
;; calls: they are answered by a handler written in the language, so this
;; rewrite leaves them (and `(handle body (with handler init))`) for
;; `expand-state-ability-forms`, which runs after the reserved-prefix check.
;; `:state/transact` is a host capability of the same kind name and still
;; takes the `cap-call` route.
#?(:kotoba nil :default
(def state-ability-operations {:state/get 0 :state/put 1}))

#?(:kotoba nil :default
(defn state-ability-perform-form? [form]
  (and (seq? form) (= 'perform (first form))
       (contains? state-ability-operations (second form)))))

#?(:kotoba nil :default
(defn state-ability-handle-form? [form]
  (and (seq? form) (= 'handle (first form)) (= 3 (count form))
       (let [clause (nth form 2)]
         (and (seq? clause) (= 'with (first clause)))))))

#?(:kotoba nil :default
(defn rewrite-pure-app-form [form]
  (cond
    (seq? form)
    (let [head (first form)]
      (cond
        (= 'quote head)
        form
        (or (state-ability-perform-form? form) (state-ability-handle-form? form))
        (let [rewritten (mapv rewrite-pure-app-form form)]
          (if (nothing-rewritten? form rewritten)
            form
            (with-meta (apply list rewritten) (meta form))))
        (= 'lam head)
        (let [rewritten (cons 'fn (mapv rewrite-pure-app-form (rest form)))]
          (with-meta rewritten (meta form)))
        (= 'app head)
        ;; `(app)` used to rewrite to `()`, and an empty call form is not a
        ;; shape any later pass names -- the operator went missing and the
        ;; message came from whatever tripped over the hole first. Refuse it
        ;; here, where the operator is the thing that is absent.
        (do (when (empty? (rest form))
              (reject! "app requires an operator: (app f arg ...)"
                       form :kotoba.error/pure-app-operator))
            (let [rewritten (apply list (mapv rewrite-pure-app-form (rest form)))]
              (with-meta rewritten (meta form))))
        (= 'ref head)
        (let [arguments (rest form)]
          (when-not (and (= 1 (count arguments))
                         (simple-symbol? (first arguments))
                         (contains? *pure-definition-names* (first arguments)))
            (reject! (str "ref names one definition this module defines: "
                          "(ref name). Every other shape of `ref` is Clojure's "
                          "STM constructor, and state must not be ambient")
                     form :kotoba.error/ambient-forbidden))
          ;; The span of the `(ref name)` form, not of the bare symbol: a
          ;; later refusal about this name should point at what the author
          ;; wrote. `vary-meta` rather than `with-meta` so a symbol that
          ;; already carries reader metadata keeps it.
          (vary-meta (first arguments) merge (meta form)))
        ;; `rel` / `query` -- the relational pair, onto the kgraph, which is
        ;; the language's only relational plane (ADR-2607198300 calls it "the
        ;; language's in-mem EAVT view"). `rel` asserts a datom, `query` reads
        ;; one back.
        ;;
        ;; This adds NO authority. Measured 2026-09-06: `kgraph-assert!` and
        ;; `kgraph-get` are both already admitted under
        ;; `:language-profile :pure-product`, so a module can do this today by
        ;; spelling the primitives; the pure heads are a second spelling of an
        ;; operation the profile already permits.
        ;;
        ;; `query` inherits the primitive's sentinel: `kgraph-get` answers
        ;; i64 MIN for an absent (e,a). It is NOT wrapped in an `[:option T]`
        ;; here, and that is deliberate -- a datom whose value IS i64 MIN is
        ;; indistinguishable from an absent one, so an option would promise a
        ;; totality the store does not have. Hiding a real ambiguity behind a
        ;; type is worse than carrying it in the open.
        (= 'rel head)
        (let [arguments (rest form)]
          (when-not (= 3 (count arguments))
            (reject! "rel asserts one datom: (rel entity attribute value)"
                     form :kotoba.error/pure-rel-arity))
          (with-meta (list* 'kgraph-assert! (mapv rewrite-pure-app-form arguments))
            (meta form)))
        (= 'query head)
        (let [arguments (rest form)]
          (when-not (= 2 (count arguments))
            (reject! (str "query reads one datom: (query entity attribute). "
                          "It is a point read, not a pattern query -- there is "
                          "no relational pattern form in this language yet")
                     form :kotoba.error/pure-query-arity))
          (with-meta (list* 'kgraph-get (mapv rewrite-pure-app-form arguments))
            (meta form)))
        ;; `handle` -- the elimination form for the one ability a guest can
        ;; actually handle.
        ;;
        ;; Kotoba has two: capability effects, whose answer comes from the HOST
        ;; and which a guest is not permitted to intercept, and `:abort`
        ;; (lang/abort-ability.edn), which `try` eliminates. `handle` is `try`.
        ;;
        ;; That this cannot reach the capability half is not a convention, it
        ;; is enforced, and it was measured before this landed: `(try (cap-call
        ;; :clock/now 0) (catch e 7))` is refused `try body cannot abort; there
        ;; is nothing to catch`, because a cap-call contributes no `:abort` to
        ;; the row. So the pure spelling inherits exactly that refusal --
        ;; `handle` cannot be used to intercept an effect the host answers.
        ;;
        ;; `perform` and `handle` are therefore NOT a matched pair here, and
        ;; the asymmetry is real rather than hidden: `perform` introduces a
        ;; capability effect that only the host answers, `handle` eliminates
        ;; the abort ability. Recorded in lang/surface-status.edn.
        (= 'handle head)
        (let [rewritten (cons 'try (mapv rewrite-pure-app-form (rest form)))]
          (with-meta rewritten
            (assoc (meta form) :kotoba/pure-source-head 'handle)))
        (= 'perform head)
        (let [arguments (rest form)]
          (when-not (and (seq arguments)
                         (keyword? (first arguments))
                         (namespace (first arguments)))
            (reject! (str "perform names one registered capability keyword: "
                          "(perform :kind/op value ...)")
                     form :kotoba.error/pure-perform-capability))
          (let [rewritten (list* 'cap-call (first arguments)
                                 (mapv rewrite-pure-app-form (rest arguments)))]
            ;; The head the AUTHOR wrote, kept on the rewritten form. Without
            ;; it a `:pure-product` module containing `perform` was refused
            ;; `form outside pure-product profile: cap-call` -- naming a head
            ;; that is nowhere in the source, because by the time that check
            ;; reads the tree the rewrite has already happened. The refusal
            ;; itself was right; only the word was wrong.
            (with-meta rewritten
              (assoc (meta form) :kotoba/pure-source-head 'perform))))
        :else
        (let [rewritten (mapv rewrite-pure-app-form form)]
          (if (nothing-rewritten? form rewritten)
            form
            (with-meta (apply list rewritten) (meta form))))))
    (vector? form)
    (let [rewritten (mapv rewrite-pure-app-form form)]
      (if (nothing-rewritten? form rewritten) form rewritten))
    (map? form)
    ;; REBUILDING a map literal is not free, and it is not free in a way only
    ;; one runtime shows. `(into {} ...)` over nine or more entries produces a
    ;; PersistentHashMap, which HASHES its keys -- and a `.kotoba` integer
    ;; literal is a JS bigint under ClojureScript, which `cljs.core/hash`
    ;; cannot tag. So rebuilding every literal unconditionally turned every
    ;; i64-keyed map literal of nine entries or more into
    ;; `Cannot create property 'closure_uid_...' on bigint '0'` -- an internal
    ;; failure -- under nbb, while the JVM rebuilt the same literal and went on
    ;; to admit or refuse it correctly. Measured 2026-09-06: the portable suite
    ;; has 0 failures at 9a23bbc~1 and 2 at 9a23bbc, both of them
    ;; `a-typed-literal-is-bounded-by-the-typed-map-entry-limit`. Nine is the
    ;; array-map -> hash-map transition, which is why eight entries were fine.
    ;;
    ;; So: walk the entries as a seq (that hashes nothing), and return the
    ;; ORIGINAL map when no child changed. A module with no pure head in it
    ;; now leaves this pass as the identical object it entered as, which is
    ;; what a no-op should mean. When a child DID change, the map is rebuilt
    ;; with `array-map`, which keeps the reader's own flat representation and
    ;; its insertion order instead of promoting to a hashed one.
    (let [entries (seq form)
          rewritten (mapv (fn [entry]
                            [(rewrite-pure-app-form (key entry))
                             (rewrite-pure-app-form (val entry))])
                          entries)]
      (if (every? true? (map (fn [entry [k v]]
                               (and (identical? (key entry) k)
                                    (identical? (val entry) v)))
                             entries rewritten))
        form
        (with-meta (apply array-map (mapcat identity rewritten)) (meta form))))
    :else
    form)))

#?(:kotoba nil :default
(defn top-level-definition-names
  "The names a module's top level defines, read syntactically. This runs
  before any expansion, so it sees exactly the `def` / `defn` / `defn-` an
  author wrote."
  [forms]
  (into #{}
        (keep (fn [form]
                (when (and (seq? form)
                           (contains? '#{def defn defn-} (first form))
                           (simple-symbol? (second form)))
                  (second form))))
        forms)))

#?(:kotoba nil :default
(defn rewrite-pure-application-forms [forms]
  (binding [*pure-definition-names* (top-level-definition-names forms)]
    (mapv rewrite-pure-app-form forms))))

#?(:kotoba nil :default
(defn implicit-do-body
  "The ONE expression a `defn` / `defn-` / `fn` body is, from the one or more
  forms the author wrote.

  `lang/guest-grammar.edn` `:implicit-body-forms` puts `defn`, `defn-` and
  `fn` in `:sequences` (2026-09-12, adr-2609111900): several body forms
  collapse to `do`, exactly as `let`'s do in `sequenced-body` above, and for
  the same reason -- `do` is a first-class head that keeps a kernel store or
  a cap-call in non-final position alive, where a nested `let` would make it
  an unused binding. `(defn f [x] a b)` and `(defn f [x] (do a b))` are one
  function with one body; the same forms, so the same HIR and the same CID.

  Until 2026-09-12 every one of those sites REFUSED a second form (`function
  must contain one result expression`, `single-arity fn value requires
  exactly one body`, `map fn must contain one result expression; ...`). That
  was IMPLEMENTATION STATE, not a property: the collapse adds no semantics
  the `do` head does not already have. Measured against the compiler's own
  225 sources (lang/selfhost-distance.edn, measurement 14): 14 modules were
  refused at exactly this sentence, and 272 `defn` forms carry a guard
  `(when-not ok (throw ...))` before their result.

  An EMPTY body is not this function's to answer: every caller refuses it
  first, with the sentence it always had, and hands only a non-empty seq
  here. The `do` takes the first form's reader metadata (its location), the
  forms themselves keep their own."
  [forms]
  (if (= 1 (count forms))
    (first forms)
    (let [m (meta (first forms))
          collapsed (apply list 'do forms)]
      (if (seq m) (with-meta collapsed m) collapsed)))))

#?(:kotoba nil :default
(defn specialize-variadic-clause
  "One monomorphic `[params body]` for a `[fixed ... & rest]` clause at ARITY.

  This is THE lowering of a variadic clause, and there is one of it: the `fn`
  profile has specialized `(fn [a & r] ...)` this way since closures were
  admitted (`lang/surface-status.edn` `:first-class-closure-values`: \"[fixed ... &
  rest] specialized through closure arity 4; rest is a pair-chain\"), and a
  variadic `defn` (2026-09-12) reuses it rather than lowering `&` a second
  way. The surplus arguments become ordinary positional parameters named
  under the reserved prefix, and REST is bound to the pair-chain `(list ...)`
  of exactly those parameters -- so at arity `(count fixed)` it is `(list)`,
  the empty chain, and `first` / `second` / `rest` / `empty?` / `cons` and
  `apply`'s trailing argument all read it as they read any other list value.

  PREFIX keeps the two callers' synthetic names apart in a linked source,
  where a lambda's clause and a defn's clause can sit side by side; the
  names themselves are never user-writable (`reject-reserved-source-symbols!`).

  MIN-ARITY is the number of fixed PARAMETERS, which is `(count fixed)` for a
  lambda and fewer for a defn whose fixed items carry `[name :type]`
  annotations; the caller that knows the difference says so."
  [{:keys [fixed rest-name body min-arity]} arity prefix]
  (let [extras (mapv #(symbol (str prefix %))
                     (range (- arity (or min-arity (count fixed)))))]
    [(into (vec fixed) extras)
     (list 'let [rest-name (apply list 'list extras)] body)])))

#?(:kotoba nil :default
(defn uniqueness-key
  "A stand-in for `v` that is safe to HASH on every runtime.

   ClojureScript cannot hash a JS `bigint`: `cljs.core/hash` reaches
   `goog.getUid`, which sets a property on the object, and a bigint is a
   primitive. It throws `Cannot create property 'closure_uid_...' on bigint`.

   That would be a curiosity if `distinct` hashed everything, but it does not
   -- up to eight elements it stays linear and compares with `=`, so the
   throw only appears from the NINTH. Measured 2026-08-24 on nbb 1.5.212:

     (case i 0 .. 7 default)   compiles
     (case i 0 .. 8 default)   Cannot create property 'closure_uid_...'
     (case x :a .. :i default) compiles      ;; keywords hash fine
     the same 64-arm case on the JVM          compiles

   A `.kotoba` integer literal is a bigint on ClojureScript and a Long on the
   JVM, so this was ClojureScript-only, and only for integer dispatch values.
   The visible cost was in the source people write: `aiueos/kotoba/sha256.kotoba`
   spells SHA-256's 64 round constants as a 63-deep nested `if`, which is what
   is left when `case` is not available for a constant table.

   Integers are keyed by their decimal text, which is identical on both
   runtimes (`(str 5)`, `(str 5N)` and `(str (bigint 5))` are all \"5\"), and
   tagged so that the integer 5 does not collide with the string \"5\" or the
   keyword :5."
  [v]
  (if (kotoba-integer? v) [::integer (str v)] [::literal v])))

#?(:kotoba
   (defn all-distinct? [xs [:list [:ref :form/r]] i :i64] :bool
     (if (>= i (vector-count xs))
       true
       (and (not (member-of? xs (typed-list-nth [:list [:ref :form/r]] xs i) 0 i)) (all-distinct? xs (+ i 1)))))
   :default
(defn all-distinct?
  "Uniqueness over values that may include `.kotoba` integer literals."
  [xs]
  (= (count xs) (count (distinct (map uniqueness-key xs))))))

#?(:kotoba nil :default
(defn valid-name? [value]
  (and (simple-symbol? value) (<= (count (name value)) max-symbol-chars))))

#?(:kotoba nil :default
(defn preserve-form-meta [source result]
  (if-let [m (meta source)]
    (with-meta result m)
    result)))

#?(:kotoba
(defn state-rebuild-seq [form [:ref :form/r] items [:list [:ref :form/r]]] [:ref :form/r]
  (fmeta-from form (form/form-seq items)))
   :default
(defn state-rebuild-seq [form items]
  (if (seq (meta form)) (with-meta (apply list items) (meta form)) (apply list items))))

#?(:kotoba nil :default
(defn state-clause-function-name [handler op]
  (symbol (str "__kotoba_state_" handler "_" (name op)))))

#?(:kotoba nil :default
(defn state-rewrite-children
  "Rewrite FORM's children, returning FORM itself when none changed: a map or
  set literal rebuilt needlessly would hash its keys, which a ClojureScript
  bigint literal cannot survive (see `rewrite-pure-app-form`)."
  [form]
  (cond
    (seq? form)
    (let [items (mapv rewrite-state-ability-form form)]
      (if (every? true? (map identical? form items)) form (state-rebuild-seq form items)))
    (vector? form)
    (let [items (mapv rewrite-state-ability-form form)]
      (if (every? true? (map identical? form items)) form (with-meta items (meta form))))
    (map? form)
    (let [entries (seq form)
          items (mapv (fn [e] [(rewrite-state-ability-form (key e)) (rewrite-state-ability-form (val e))]) entries)]
      (if (every? true? (map (fn [e [k v]] (and (identical? (key e) k) (identical? (val e) v))) entries items))
        form
        (with-meta (apply array-map (mapcat identity items)) (meta form))))
    :else form)))

#?(:kotoba nil :default
(defn rewrite-state-ability-form
  "`(perform :state/get)` -> `(__kotoba_state_perform :get)`,
  `(perform :state/put v)` -> `(__kotoba_state_perform :put v)`,
  `(handle body (with h init))` -> `(__kotoba_state_handle :h init body)`.
  Everything else is walked and returned identical when nothing changed."
  [form]
  (cond
    (and (seq? form) (= 'quote (first form))) form
    (state-ability-perform-form? form)
    (let [[_ op & values] form
          expected (get state-ability-operations op)]
      (when-not (= expected (count values))
        (reject! (str "perform " op " takes "
                      (if (zero? expected) "no value" "exactly one value")
                      "; got " (count values))
                 form :kotoba.error/state-shape))
      (state-rebuild-seq form (list* '__kotoba_state_perform (keyword (name op))
                                     (map rewrite-state-ability-form values))))
    (state-ability-handle-form? form)
    (let [[_ body clause] form
          [_ handler init & extra] clause]
      (when-not (and (simple-symbol? handler) (= 3 (count clause)) (empty? extra))
        (reject! "handle installs one handler with one initial state: (handle body (with handler init))"
                 form :kotoba.error/state-shape))
      (state-rebuild-seq form (list '__kotoba_state_handle (keyword (name handler))
                                    (rewrite-state-ability-form init)
                                    (rewrite-state-ability-form body))))
    :else (state-rewrite-children form))))

#?(:kotoba nil :default
(def state-clause-parameters
  "The parameters each clause of a :state handler takes: the current state,
  then the operation's values."
  {:get 1 :put 2}))

#?(:kotoba nil :default
(defn state-resume-rewrite
  "Inside ONE handler clause body, `(resume value state)` becomes the reserved
  head; a resume of any other arity is refused here, by its own name."
  [form handler op]
  (cond
    (and (seq? form) (= 'quote (first form))) form
    (and (seq? form) (= 'resume (first form)))
    (do (when-not (= 3 (count form))
          (reject! (str "resume takes the resumed value and the next state: (resume value state); handler "
                        handler " clause " (name op) " passes " (dec (count form)))
                   form :kotoba.error/state-resume))
        (state-rebuild-seq form (list '__kotoba_state_resume
                                      (state-resume-rewrite (nth form 1) handler op)
                                      (state-resume-rewrite (nth form 2) handler op))))
    (seq? form) (state-rebuild-seq form (map #(state-resume-rewrite % handler op) form))
    (vector? form) (with-meta (mapv #(state-resume-rewrite % handler op) form) (meta form))
    :else form)))

#?(:kotoba nil :default
(defn parse-defhandler
  "One `(defhandler name doc? [:state S] (get [s] body) (put [s v] body))`
  form -> `{:handler {...} :defns [...]}`. Each clause becomes a private defn
  whose parameters are typed by the handler's state type."
  [form]
  (let [[_ handler & more] form
        _ (when-not (and (simple-symbol? handler) (valid-name? handler))
            (reject! "defhandler requires a handler name: (defhandler name [:state S] (get [s] ...) (put [s v] ...))"
                     form :kotoba.error/state-handler-shape))
        more (if (string? (first more)) (rest more) more)
        [signature & clauses] more]
    (when-not (and (vector? signature) (= 2 (count signature)) (keyword? (first signature)))
      (reject! (str "defhandler " handler " requires an ability signature: [:state S]")
               form :kotoba.error/state-handler-shape))
    (when-not (= :state (first signature))
      (reject! (str "defhandler supports only the :state ability in state slice 1; "
                    handler " names " (pr-str (first signature)))
               form :kotoba.error/state-handler-shape))
    (let [state-type (second signature)
          _ (validate-value-type! state-type)
          parsed (mapv (fn [clause]
                         (when-not (and (seq? clause) (symbol? (first clause))
                                        (vector? (second clause)) (seq (drop 2 clause)))
                           (reject! (str "handler " handler " clause must be (op [state value ...] body): "
                                         (pr-str clause))
                                    form :kotoba.error/state-handler-shape))
                         (let [op (keyword (name (first clause)))
                               params (second clause)
                               body (drop 2 clause)]
                           {:op op :params params
                            :body (if (< 1 (count body)) (cons 'do body) (first body))}))
                       clauses)
          ops (mapv :op parsed)]
      (when-not (and (= (set ops) (set (keys state-clause-parameters)))
                     (= (count ops) (count (distinct ops))))
        (reject! (str "handler " handler " does not match the :state ability: it must define exactly get and put, once each; it defines "
                      (if (seq ops) (str/join ", " (map name ops)) "nothing"))
                 form :kotoba.error/state-handler-type))
      (doseq [{:keys [op params]} parsed]
        (let [expected (get state-clause-parameters op)]
          (when-not (and (= expected (count params)) (every? simple-symbol? params)
                         (= (count params) (count (distinct params))))
            (reject! (str "handler " handler " does not match the :state ability: its " (name op)
                          " clause takes " (if (= 1 expected) "[state]" "[state value]")
                          ", got " (pr-str params))
                     form :kotoba.error/state-handler-type))))
      {:handler {:name handler :state-type state-type
                 :clauses (into {} (map (fn [{:keys [op]}]
                                          [op {:fn (state-clause-function-name handler op)}]))
                                parsed)}
       :defns (mapv (fn [{:keys [op params body]}]
                      (with-meta
                        (list 'defn- (state-clause-function-name handler op)
                              (vec (mapcat (fn [p] [p state-type]) params))
                              (state-resume-rewrite (rewrite-state-ability-form body) handler op))
                        (meta form)))
                    parsed)}))))

#?(:kotoba nil :default
(defn expand-state-ability-forms
  "Source-level expansion of the state ability. Returns `{:forms :handlers}`;
  a module that mentions none of it comes back as the identical vector with
  no handlers, so it lowers to the bytes it did before the ability existed."
  [forms]
  (if-not (first-truthy (fn [x] (or (and (seq? x) (= 'defhandler (first x)))
                                    (state-ability-perform-form? x)
                                    (state-ability-handle-form? x)))
                        (tree-seq coll? seq forms))
    {:forms forms :handlers {}}
    (let [out (reduce (fn [{:keys [forms handlers]} form]
                        (if (and (seq? form) (= 'defhandler (first form)))
                          (let [{:keys [handler defns]} (parse-defhandler form)
                                key (keyword (name (:name handler)))]
                            (when (contains? handlers key)
                              (reject! (str "duplicate handler name: " (:name handler))
                                       form :kotoba.error/state-handler-shape))
                            {:forms (into forms defns) :handlers (assoc handlers key handler)})
                          {:forms (conj forms (rewrite-state-ability-form form)) :handlers handlers}))
                      {:forms [] :handlers {}}
                      forms)]
      out))))

#?(:kotoba nil :default
(defn normalize-effect-ceiling
  "Translate a public effect ceiling declared as capability keywords into the
  same `[:cap/call id]` row shape `infer-effects` produces."
  [ceiling form]
  (when (some? ceiling)
    (when-not (and (set? ceiling) (seq ceiling) (every? keyword? ceiling))
      (reject! "effect ceiling must be a non-empty set of capability keywords" form))
    (into #{}
          (map (fn [kw]
                 (if-let [id (get capability-registry kw)]
                   [:cap/call id]
                   ;; The pure ability `state` (lang/state-ability.edn) is a
                   ;; row member of its own, not a capability.
                   (if (= :state kw)
                     :state
                     (reject! (str "effect ceiling names unregistered capability: " kw)
                              form)))))
          ceiling))))

#?(:kotoba nil :default
(defn defn-parts
  "Parse Kotoba's bounded function declaration shape. A docstring is inert
  metadata and is deliberately discarded before lowering. An optional result
  keyword follows the parameter vector: `(defn f [s :string] :string s)`.
  An optional public effect ceiling map may follow the result (or params):
  `(defn f [x] {:effects #{:clock/now}} (clock/now x))`. Inferred effects
  outside that ceiling fail closed. Other attributes remain outside the profile."
  [form constants]
  (let [[_ name & declaration] form
        [docstring declaration] (if (string? (first declaration))
                                  [(first declaration) (rest declaration)]
                                  [nil declaration])
        raw-params (first declaration)
        tail (rest declaration)
        [result tail] (if (or (keyword? (first tail))
                              (structured-type? (first tail))
                              (type-alias-form? (first tail)))
                        [(resolve-type-alias! (first tail) constants) (rest tail)]
                        ;; No annotation: `:i64` is provisional. `infer-absent-results`
                        ;; replaces it with the body's inferred type, so an
                        ;; unannotated `defn` can return a predicate.
                        [::absent tail])
        ceiling-form (first tail)
        [effects-ceiling body]
        (if (and (map? ceiling-form)
                 (contains? ceiling-form :effects)
                 (= #{:effects} (set (keys ceiling-form))))
          [(normalize-effect-ceiling (:effects ceiling-form) form) (rest tail)]
          [nil tail])
        ;; Several body forms are ONE `do` from here on (`implicit-do-body`;
        ;; guest-grammar `:implicit-body-forms :sequences` holds defn since
        ;; 2026-09-12), so every later reader of `:body` -- the variadic
        ;; specialization, the affine check, the elaboration site that
        ;; refuses `function must contain one result expression` -- sees a
        ;; one-form seq. An empty body is left empty: that refusal is still
        ;; the empty body's, with the sentence it always had.
        body (if (< 1 (count body)) (list (implicit-do-body body)) body)]
    (when (and docstring (> (count docstring) max-function-docstring-chars))
      (reject! "function docstring exceeds admission limit" docstring))
    (when-not (= ::absent result) (validate-value-type! result))
    (cond-> {:name name :raw-params raw-params
             :result (if (or (= ::absent result) (callable-type? result)) :i64 result)
             :body body}
      (= ::absent result) (assoc :result-inferred? true)
      (callable-type? result) (assoc :callable-result-contract result)
      effects-ceiling (assoc :effects-ceiling effects-ceiling)))))

#?(:kotoba nil :default
(defn multi-arity-declaration?
  [declaration]
  (and (seq declaration)
       (every? #(and (seq? %) (vector? (first %))) declaration))))

#?(:kotoba nil :default
(defn abi-arity-name [source-name arity]
  (symbol (str (name source-name) "$arity$" arity))))

#?(:kotoba nil :default
(defn variadic-params? [raw-params]
  (and (vector? raw-params) (boolean (first-truthy #(= '& %) raw-params)))))

#?(:kotoba nil :default
(defn variadic-clause-parts
  "Read `[fixed ... & rest]` for a defn clause: the fixed items (which may
  carry `[name :type]` annotations and destructuring patterns, exactly as a
  fixed-arity defn's may), the rest name, and the number of fixed
  PARAMETERS. Every malformed spelling is refused by name."
  [raw-params constants form]
  (let [amp-index (first (keep-indexed #(when (= '& %2) %1) raw-params))]
    (when-not (= amp-index (- (count raw-params) 2))
      (reject! "variadic defn requires [fixed ... & rest]: `&` must be followed by exactly one rest name and nothing else"
               raw-params))
    (let [fixed (subvec raw-params 0 amp-index)
          rest-name (peek raw-params)
          fixed-parts (typed-param-parts fixed constants)
          min-arity (count fixed-parts)]
      ;; `&` is a simple symbol to `valid-name?`; measured before this line
      ;; existed, `(defn- f [a & &] a)` was admitted with a rest named `&`.
      (when-not (and (valid-name? rest-name) (not= '& rest-name))
        (reject! "variadic defn requires [fixed ... & rest]: the rest name must be a simple symbol"
                 raw-params))
      (when (contains? (set (mapcat #(binding-symbols (:pattern %)) fixed-parts)) rest-name)
        (reject! (str "variadic rest name " rest-name " shadows a fixed parameter of the same clause")
                 raw-params))
      (when (> min-arity max-parameters)
        (reject! "function parameters exceed ABI-supported arity" raw-params
                 :kotoba.error/max-parameters))
      {:fixed fixed :rest-name rest-name :min-arity min-arity}))))

#?(:kotoba nil :default
(defn expand-defn-parts
  "Return one or more monomorphic clauses for a source defn. Multi-arity is
  syntax-only: every call is resolved before HIR and no backend performs
  argument-count dispatch (ADR 0017).

  A `[fixed ... & rest]` clause is multi-arity syntax too (2026-09-12). In a
  closed module every call of the function is known, so the clause is
  specialized -- by the `fn` profile's own lowering, `specialize-variadic-
  clause` -- once per arity a call site uses, from the fixed count through
  `max-parameters`, plus the smallest arity no fixed clause holds, so the
  body is analyzed even when nothing calls it. An arity nothing calls is not
  emitted. CALL-ARITIES is this name's set of called arities
  (`variadic-call-arities`).

  Until 2026-09-12 the single-arity path READ `&` AS A PARAMETER: measured at
  6f49a83, `(defn f [a & r] r)` compiled as a three-parameter function whose
  second parameter was named `&`, so `(f 1 2 3)` answered 3 and `(f 1 2)` was
  refused `f takes 3 arguments`. It accepted the source and answered the
  wrong thing; the multi-arity path refused the same clause by name. Both
  paths now go through this one."
  [form constants call-arities]
  (let [[op source-name & declaration0] form
        ;; The name is checked HERE, before anything reads it, because the
        ;; very next line calls `(name source-name)` and `name` is defined on
        ;; a symbol / keyword / string and nothing else. Measured 2026-09-03
        ;; on amu 57ba0ee0, fifteen shapes reached it and raised a raw host
        ;; error -- `(defn)` and `(defn nil [] 0)` (nil), `(defn 42 [] 0)`,
        ;; `(defn 1.5 [] 0)`, `(defn true [] 0)`, `(defn [f] [] 0)`,
        ;; `(defn {} [] 0)`, `(defn #{} [] 0)`, `(defn (f) [] 0)`, the same
        ;; nine under `defn-`, and the multi-arity spellings -- so
        ;; `Doesn't support name: 42` left as exit 70 `internal compiler
        ;; error`. `(defn "f" [] 0)` and `(defn :f [] 0)` did NOT crash, only
        ;; because `name` happens to accept a string and a keyword; they were
        ;; refused 200 lines later with `invalid function name`. One arity of
        ;; the same declaration was guarded and the others were not.
        ;;
        ;; The wording is that sibling's, verbatim, and so is the code. A
        ;; caller who wrote a name that is not a bounded simple symbol gets
        ;; one sentence for that fact whichever non-symbol they wrote; a
        ;; second phrasing here would only mean the compiler knew two things
        ;; where there is one.
        ;;
        ;; Rejecting on FORM rather than on the name is what gives the reader
        ;; somewhere to act: `nil`, `42` and `{}` carry no reader metadata, so
        ;; a refusal pointed at the name has no span at all. The offending
        ;; value travels in `ex-data` instead, where the CLI envelope does not
        ;; copy it.
        _ (when-not (valid-name? source-name)
            (reject! "invalid function name" form :kotoba.error/subset-reject
                     {:function source-name}))
        [docstring declaration] (if (string? (first declaration0))
                                  [(first declaration0) (rest declaration0)]
                                  [nil declaration0])
        ;; Public is the head AND the name's metadata. `(defn ^:private h
        ;; ...)` is `defn-` spelled the way Clojure spells it; until
        ;; 2026-09-11 the reader could not read it at all (`kotoba-reader`'s
        ;; `\^` arm), and once it could, deciding on the head alone would
        ;; have compiled a declared-private function as public -- the one
        ;; outcome worse than refusing it. Every OTHER metadata key
        ;; (`:no-doc`, `:tag`, `:deprecated`, anything) is documentation to
        ;; this analyzer and is not read. The name keeps its metadata: a
        ;; symbol with metadata is equal to itself, so `valid-name?` and the
        ;; name-keyed maps below see the same symbol they always did
        ;; (`reader_metadata_test` measures this rather than assumes it).
        public? (and (= op 'defn) (not (:private (meta source-name))))]
    (when (and docstring (> (count docstring) max-function-docstring-chars))
      (reject! "function docstring exceeds admission limit" docstring))
    (when (re-find #"\$arity\$" (name source-name))
      (reject! "function name uses reserved multi-arity ABI marker" source-name))
    (cond
      (and (not (multi-arity-declaration? declaration))
           (not (variadic-params? (first declaration))))
      [(assoc (defn-parts form constants) :source-name source-name :public? public?)]

      :else
      (let [;; A single variadic clause is the multi-arity declaration of
            ;; one clause, and takes the same path.
            declaration (if (multi-arity-declaration? declaration)
                          declaration
                          [(apply list declaration)])]
        (when (> (count declaration) max-arity-clauses)
          (reject! "multi-arity clause count exceeds admission limit" form))
        (let [raws (mapv (fn [clause]
                           (defn-parts (list* op source-name clause) constants))
                         declaration)
              fixed-raws (remove #(variadic-params? (:raw-params %)) raws)
              variadic-raws (filter #(variadic-params? (:raw-params %)) raws)
              _ (when (> (count variadic-raws) 1)
                  (reject! "defn admits at most one variadic clause" form))
              fixed-clauses
              (mapv (fn [raw]
                      (assoc raw :source-name source-name
                             :logical-arity (count (typed-param-parts (:raw-params raw) constants))
                             :public? public?))
                    fixed-raws)
              fixed-arities (set (map :logical-arity fixed-clauses))
              variadic-clauses
              (when-let [raw (first variadic-raws)]
                (let [{:keys [min-arity] :as parts}
                      (variadic-clause-parts (:raw-params raw) constants form)
                      ;; The body is a one-form seq (`defn-parts` collapsed
                      ;; several forms to one `do`); an empty clause keeps its
                      ;; shape so `function must contain one result
                      ;; expression` still names it downstream.
                      body (:body raw)
                      used (set (filter #(<= min-arity % max-parameters) call-arities))
                      always (first (remove fixed-arities (range min-arity (inc max-parameters))))
                      arities (sort (remove fixed-arities (cond-> used always (conj always))))]
                  (mapv (fn [arity]
                          (let [[params body*]
                                (specialize-variadic-clause
                                 (assoc parts :body (first body)) arity "__kotoba_rest_arg_")]
                            (assoc raw :raw-params params
                                   :body (if (= 1 (count body)) [body*] body)
                                   :source-name source-name :logical-arity arity
                                   :public? public? :variadic? true)))
                        arities)))
              clauses (into fixed-clauses variadic-clauses)
              arities (mapv :logical-arity clauses)]
          (when-not (= (count arities) (count (distinct arities)))
            (reject! "duplicate multi-arity clause" form))
          (if (and (= 1 (count clauses)) (:variadic? (first clauses)))
            ;; One specialization of a variadic clause is one ordinary
            ;; function: the plain name, as the linker writes a one-clause
            ;; export, so its interface and CID are those of the fixed-arity
            ;; defn an author would have written by hand.
            [(dissoc (first clauses) :variadic?)]
            (mapv #(assoc % :name (abi-arity-name source-name (:logical-arity %))) clauses))))))))

#?(:kotoba nil :default
(defn binding-symbols [pattern]
  (->> (tree-seq coll? seq pattern)
       (filter symbol?)
       (remove #{'&})
       set)))

#?(:kotoba nil :default
(defn closed-multimethod-literal? [value]
  (or (kotoba-integer? value) (keyword? value) (boolean? value) (string? value))))

#?(:kotoba nil :default
(defn expand-closed-multimethod-forms [forms]
  (let [declarations (filter #(and (seq? %) (= 'defmulti (first %))) forms)
        methods (filter #(and (seq? %) (= 'defmethod (first %))) forms)
        declaration-names (mapv second declarations)]
    (when-not (= (count declaration-names) (count (distinct declaration-names)))
      (reject! "duplicate defmulti declaration" declarations))
    (let [declarations-by-name
          (into {}
                (map (fn [form]
                       (let [[_ name dispatch & extra] form]
                         (when-not (and (symbol? name) (nil? (namespace name))
                                        (symbol? dispatch) (nil? (namespace dispatch))
                                        (empty? extra))
                           (reject! "defmulti requires an unqualified name and one unqualified dispatch function symbol"
                                    form))
                         [name {:form form :dispatch dispatch}]))
                     declarations))
          methods-by-name
          (group-by second methods)]
      (doseq [form methods]
        (let [[_ name dispatch-value params & body] form]
          (when-not (contains? declarations-by-name name)
            (reject! "defmethod requires a matching defmulti declaration" form))
          (when-not (closed-multimethod-literal? dispatch-value)
            (reject! "defmethod dispatch value must be a bounded literal or :default" form))
          (when-not (and (vector? params) (<= (count params) max-parameters)
                         (every? #(and (symbol? %) (nil? (namespace %))) params)
                         (= (count params) (count (distinct params))))
            (reject! "defmethod parameters must be a unique vector of unqualified symbols within the ABI arity"
                     form))
          (when (empty? body)
            (reject! "defmethod requires at least one body expression" form))))
      (let [expanded
            (into {}
                  (map
                   (fn [[name {:keys [dispatch form]}]]
                     (let [method-forms (get methods-by-name name)]
                       (when (empty? method-forms)
                         (reject! "defmulti requires at least one closed-world defmethod" form))
                       (let [params (nth (first method-forms) 3)
                             _ (doseq [method method-forms]
                                 (when-not (= params (nth method 3))
                                   (reject! "all defmethods must use the same parameter vector"
                                            method)))
                             values (mapv #(nth % 2) method-forms)
                             ;; Same hashing hazard as `case`: a dispatch
                             ;; value may be an integer literal, which is a
                             ;; bigint on ClojureScript.
                             _ (when-not (all-distinct? values)
                                 (reject! "duplicate defmethod dispatch value" method-forms))
                             default-method (first (filter #(= :default (nth % 2))
                                                           method-forms))
                             ordinary (remove #(= :default (nth % 2)) method-forms)
                             body-form (fn [method]
                                         (let [body (drop 4 method)]
                                           (if (= 1 (count body))
                                             (first body)
                                             (list* 'do body))))
                             clauses (mapcat (fn [method]
                                               [(nth method 2) (body-form method)])
                                             ordinary)
                             clauses (cond-> (vec clauses)
                                       default-method (conj (body-form default-method)))
                             generated (list 'defn name params
                                             (list* 'case
                                                    (list* dispatch params)
                                                    clauses))]
                         [name generated])))
                   declarations-by-name))]
        (into [] (remove nil?)
              (map (fn [form]
                     (cond
                       (and (seq? form) (= 'defmulti (first form)))
                       (get expanded (second form))

                       (and (seq? form) (= 'defmethod (first form)))
                       nil

                       :else form))
                   forms)))))))

#?(:kotoba nil :default (def protocol-declaration-heads tables/protocol-declaration-heads))

#?(:kotoba nil :default
(defn protocol-documentation-stripped
  "A protocol declaration's method forms, with Clojure's two DOCUMENTATION
  positions removed: a leading string after the protocol name, and a trailing
  string after a method's parameter vector.

  Both are documentation and neither reaches dispatch. Nothing about the
  bounded closed-world profile depends on their absence -- `ns` and `defn`
  both admit a docstring under `max-*-docstring-chars`, and a protocol was
  the one declaration head that did not.

  Measured 2026-09-11 at 90baa17, through `amu check --jvm-free`:

      (defprotocol IP (-scan [this pattern]))                  exit 0
      (defprotocol IP \"the one operation\" (-scan [this p]))   exit 65
      (defprotocol IP (-scan [this pattern] \"method doc\"))     exit 65

  with `defprotocol requires unique bounded (method [this ...]) signatures`
  for both -- a message about SIGNATURES, raised by a string that is not one.
  A reader given that sentence looks at the parameter vectors.

  The cost was not cosmetic. The four `:kotoba.error/protocol-declaration`
  findings in the Q9 wave-1 corpus all came from ONE declaration --
  `datom.source/IPatternSource`, whose docstring states the three invariants
  every implementation must satisfy -- and the only way past it was to delete
  that text. A migration that requires deleting the contract to compile is
  narrowing the component, which is what ADR-q9 forbids.

  Stripping is deliberately narrow. A trailing string is removed only from a
  method form that has MORE than the two elements a signature needs, so a
  malformed `(m \"doc\")` still arrives malformed rather than being quietly
  rewritten into `(m)`, and a non-string trailing element -- `(m [this] 42)`
  -- is not touched at all."
  [tail]
  (mapv (fn [m]
          (if (and (seq? m) (> (count m) 2) (string? (last m)))
            (butlast m)
            m))
        tail)))

#?(:kotoba nil :default
(defn protocol-method-param-parts
  "Split a protocol method parameter vector into its names and their value
  types. `[this chunk :bytes n]` -> names [this chunk n], types [nil :bytes nil].

  A parameter may be followed by ONE type (a keyword or a structured type
  vector); an untyped non-receiver parameter is :i64, as it always was. The
  receiver (first parameter) takes no type: it is the record the method is
  dispatched on. Returns nil for a vector that is not names-with-optional-types
  so the callers' existing `bounded (method [this ...])` refusal fires."
  [params]
  (when (vector? params)
    (loop [remaining (seq params) names [] types []]
      (if (empty? remaining)
        {:names names :types types}
        (let [param (first remaining)
              more (next remaining)]
          (if (symbol? param)
            (if (and more (or (keyword? (first more)) (vector? (first more))))
              (recur (next more) (conj names param) (conj types (first more)))
              (recur more (conj names param) (conj types nil)))
            nil)))))))

#?(:kotoba nil :default
(defn protocol-form->info [form]
  (let [[head protocol-name & tail0] form
        [protocol-doc tail] (if (string? (first tail0))
                              [(first tail0) (rest tail0)]
                              [nil tail0])
        method-docs (keep (fn [m] (when (and (seq? m) (> (count m) 2) (string? (last m)))
                                    (last m)))
                          tail)
        methods (protocol-documentation-stripped tail)]
    ;; Bounded like every other docstring in the profile. An unbounded one
    ;; would be the one place a program could carry arbitrary bytes into a
    ;; declaration, and the limit is the same one `defn` applies.
    (doseq [doc (cons protocol-doc method-docs)]
      (when (and doc (> (count doc) max-function-docstring-chars))
        (reject! (str head " docstring exceeds admission limit")
                 form :kotoba.error/protocol-declaration)))
    (when-not (and (valid-name? protocol-name)
                   (seq methods)
                   (every? #(and (seq? %)
                                 (= 2 (count %))
                                 (valid-name? (first %))
                                 (vector? (second %))
                                 (seq (second %))
                                 (let [{:keys [names types]}
                                       (protocol-method-param-parts (second %))]
                                   (and names
                                        (<= (count names) max-parameters)
                                        (every? valid-name? names)
                                        (nil? (first types)))))
                           methods)
                   (= (count methods) (count (distinct (map first methods)))))
      (reject! (str head " requires unique bounded (method [this ...]) signatures")
               form :kotoba.error/protocol-declaration))
    (let [parts (into {} (map (fn [[method-name params]]
                                [method-name (protocol-method-param-parts params)]))
                      methods)]
      (doseq [{:keys [types]} (vals parts)
              type types
              :when type]
        (validate-value-type! type))
      {:name protocol-name
       :methods (into {} (map (fn [[method-name _]]
                                [method-name (:names (get parts method-name))]))
                      methods)
       :param-types (into {} (map (fn [[method-name _]]
                                    [method-name (:types (get parts method-name))]))
                          methods)}))))

#?(:kotoba
   (defn record-descriptor-fields [parts [:ref :form/r] i :i64
                                    acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (form/count-of parts))
       acc
       (let [part (form/nth-of parts i)
             field-name (form/form-get part (form/keyword-form :name))
             field-type (form/form-get part (form/keyword-form :type))]
         (record-descriptor-fields
          parts (+ i 1)
          (form/append-form
           acc
           (form/form-vec
            (form/two-forms
             (form/keyword-form (keyword-from-string (form/symbol-value field-name)))
             field-type)))))))
   :default nil)

#?(:kotoba
   (defn record-descriptor [namespace-symbol [:ref :form/r] record-name [:ref :form/r]
                             field-parts [:ref :form/r]] [:ref :form/r]
     (form/form-vec
      (form/three-forms
       (form/keyword-form :record)
       (form/keyword-form
        (keyword-from-string
         (string-concat (form/symbol-value namespace-symbol)
                        (string-concat "/" (form/symbol-value record-name)))))
       (form/form-vec (record-descriptor-fields field-parts 0 (form/no-forms))))))
   :default
(defn record-descriptor [namespace-symbol record-name field-parts]
  [:record (keyword (str namespace-symbol) (name record-name))
   (mapv (fn [{field-name :name field-type :type}]
           [(keyword (name field-name)) field-type])
         field-parts)]))

#?(:kotoba nil :default
(defn record-field-parts [fields form]
  (let [typed? (or (first-truthy keyword? fields)
                   (and (even? (count fields))
                        (first-truthy structured-type? (map second (partition 2 fields)))))]
    (if typed?
      (do
        (when-not (even? (count fields))
          (reject! "typed defrecord fields require alternating name/type pairs"
                   form :kotoba.error/record-declaration))
        (mapv (fn [[field type]]
                (when-not (valid-name? field)
                  (reject! "defrecord field names must be unique unqualified symbols"
                           field :kotoba.error/record-declaration))
                (validate-value-type! type)
                {:name field :type type})
              (partition 2 fields)))
      (mapv (fn [field]
              (when-not (valid-name? field)
                (reject! "defrecord field names must be unique unqualified symbols"
                         field :kotoba.error/record-declaration))
              {:name field :type :i64})
            fields)))))

#?(:kotoba nil :default
(defn extension-implementations
  [protocols records protocol-name record-name method-forms whole-form]
  (let [protocol (get protocols protocol-name)
        record (get records record-name)
        declared-methods (set (keys (:methods protocol)))
        implemented-methods (mapv first method-forms)]
    (when-not (and protocol record (seq method-forms))
      (reject! "protocol extension requires a declared protocol, record, and methods"
               whole-form :kotoba.error/protocol-extension))
    (when-not (and (= (count implemented-methods)
                      (count (distinct implemented-methods)))
                   (= declared-methods (set implemented-methods)))
      (reject! "protocol extension must implement every declared method exactly once"
               whole-form :kotoba.error/protocol-extension))
    (mapv
     (fn [[method-name params & body :as method-form]]
       (let [declared-params (get-in protocol [:methods method-name])]
         ;; One code, four sentences. This was a single `and` of five
         ;; conditions behind `protocol method does not match its
         ;; declaration`, and that sentence was wrong for the one cause that
         ;; occurs in the Q9 corpus. Measured 2026-09-11 at 9b153c7:
         ;;
         ;;   (area [this] (+ 1 1) (:side this))       refused, "does not match its declaration"
         ;;   (area [this] (do (+ 1 1) (:side this)))  admitted
         ;;
         ;; The declaration matched perfectly; the body had two expressions.
         ;; `defn` refuses the same shape as `function must contain one
         ;; result expression`. A reader handed the protocol sentence
         ;; compares parameter vectors and finds nothing (real instance:
         ;; `datom.source/CountingSource`, `(-scan [_ pattern] (swap! calls
         ;; inc) (let ...))`).
         ;;
         ;; What is admitted does not move: the single-expression rule is
         ;; the profile's, `defn` has it too, and explicit `do` is the
         ;; spelling. The order is `defn`'s -- parameters before body -- so
         ;; a method wrong in both places is told about its parameters
         ;; first, as a function would be. `vector?` is checked before
         ;; anything counts PARAMS, because `(count 'this)` is a host error.
         (when-not (vector? params)
           (reject! "protocol method parameters must be a vector"
                    method-form :kotoba.error/protocol-method))
         ;; `[this chunk :bytes]`: a non-receiver parameter may carry its type
         ;; (see `protocol-method-param-parts`); the declaration's type is the
         ;; default, an untyped parameter is :i64.
         (let [{:keys [names types] :as parts} (protocol-method-param-parts params)]
           (when-not (and declared-params
                          (= (count (or names params)) (count declared-params)))
             (reject! "protocol method does not match its declaration"
                      method-form :kotoba.error/protocol-method))
           (when-not (and parts
                          (every? valid-name? names)
                          (= (count names) (count (distinct names)))
                          (nil? (first types)))
             (reject! "protocol method parameters must be unique unqualified symbols"
                      method-form :kotoba.error/protocol-method))
           (doseq [type (rest types)
                   :when type]
             (validate-value-type! type)))
         (when-not (= 1 (count body))
           (reject! "protocol method must contain one result expression"
                    method-form :kotoba.error/protocol-method))
         {:protocol protocol-name
          :method method-name
          :record record-name
          :record-type (:descriptor record)
          :params (:names (protocol-method-param-parts params))
          :param-types (mapv (fn [declared given]
                               (or given declared :i64))
                             (get-in protocol [:param-types method-name])
                             (:types (protocol-method-param-parts params)))
          :body (first body)}))
     method-forms))))

#?(:kotoba nil :default
(defn protocol-extension-groups [extra whole-form]
  (loop [remaining extra out []]
    (if (empty? remaining)
      out
      (let [protocol-name (first remaining)
            [methods tail] (split-with seq? (rest remaining))]
        (when-not (and (symbol? protocol-name) (seq methods))
          (reject! "protocol extension section requires a protocol name and methods"
                   whole-form :kotoba.error/protocol-extension))
        (recur tail (conj out [protocol-name methods])))))))

#?(:kotoba nil :default
(defn extend-type-form->implementations
  "Read one `(extend-type Record Protocol (method [this ...] body) ...)`.

  The mirror of `extend-protocol-form->info` below, and it exists for the same
  reason that one does: to say up front what the form NEEDS, instead of
  letting an empty section list mean `nothing to check`.

  Measured 2026-09-03 at 5917518b, `extend-type` was the only member of this
  family that ADMITTED a malformed declaration. `(extend-type)`,
  `(extend-type nil)` and `(extend-type 42)` all exited 0. The arm destructured
  `record-name` and `extra`, handed `extra` to `protocol-extension-groups` --
  whose loop returns `[]` on the first iteration when the remainder is empty --
  and `mapcat` over no groups called nothing. Nothing else in the arm ever
  looked at `record-name`. The whole-source pass then removed the form along
  with the well-formed declarations, so the program compiled with the
  extension the caller wrote silently absent: the HIR was byte-identical to
  the same program with the line deleted, even next to a declared record and a
  declared protocol.

  The sentence is `extend-protocol`'s with its two nouns swapped, because the
  two forms differ only in which side is named first and a second phrasing
  would mean the compiler knew two things where there is one. It is raised on
  the FORM, so the span points somewhere the reader can act -- `nil`, `42` and
  `{}` carry no reader metadata of their own.

  Eager on purpose. The caller used to build these with a lazy `mapcat`, which
  is survivable while every refusal inside is reached during realisation, but
  a guard whose `reject!` fires outside the sequence that forced it is a guard
  that looks like it works."
  [protocols records form]
  (let [[_ record-name & extra] form]
    (when-not (and (get records record-name) (seq extra))
      (reject! "extend-type requires one declared record and bounded protocol sections"
               form :kotoba.error/protocol-extension))
    (into [] (mapcat (fn [[protocol-name methods]]
                       (extension-implementations protocols records protocol-name
                                                  record-name methods form)))
          (protocol-extension-groups extra form)))))

#?(:kotoba nil :default
(defn extend-protocol-form->info [protocols records form]
  (let [[_ protocol-name & sections] form]
    (when-not (and (get protocols protocol-name) (seq sections))
      (reject! "extend-protocol requires one declared protocol and bounded type sections"
               form :kotoba.error/protocol-extension))
    (loop [remaining sections implementations [] default-methods nil]
      (if (empty? remaining)
        {:protocol protocol-name
         :implementations implementations
         :default-methods default-methods
         :form form}
        (let [record-name (first remaining)
              [methods tail] (split-with seq? (rest remaining))]
          (when-not (and (symbol? record-name) (seq methods))
            (reject! "extend-protocol type section requires a record name and methods"
                     form :kotoba.error/protocol-extension))
          (if (= 'default record-name)
            (do
              (when default-methods
                (reject! "extend-protocol permits at most one default section"
                         form :kotoba.error/protocol-extension))
              (recur tail implementations methods))
            (recur tail
                   (into implementations
                         (extension-implementations protocols records protocol-name
                                                    record-name methods form))
                   default-methods))))))))

#?(:kotoba nil :default
(defn record-form->info [namespace-symbol protocols form]
  (let [[_ record-name fields & extra] form]
    (when-not (and (valid-name? record-name)
                   (vector? fields))
      (reject! "defrecord requires a bounded name and field vector"
               form :kotoba.error/record-declaration))
    (let [field-parts (record-field-parts fields form)
          field-names (mapv :name field-parts)
          typed? (not= fields field-names)
          _ (when-not (and (<= (count field-parts) max-record-fields)
                           (= (count field-names) (count (distinct field-names))))
              (reject! (str "defrecord requires at most " max-record-fields
                            " unique fields")
                       form :kotoba.error/record-declaration))
          descriptor (record-descriptor namespace-symbol record-name field-parts)
          groups (protocol-extension-groups extra form)
          record {:name record-name
                  :fields field-names
                  :field-parts field-parts
                  :typed? typed?
                  :descriptor descriptor}
          implementations
          (mapcat (fn [[protocol-name methods]]
                    (extension-implementations protocols {record-name record}
                                               protocol-name record-name methods form))
                  groups)]
      (assoc record :implementations implementations)))))

#?(:kotoba nil :default
(defn rewrite-record-map-expression
  "Lower a computed, but statically closed, map expression to one nominal
  record value.

  Record context propagates only through result positions. Binding values,
  tests, and non-final `do` expressions keep their ordinary meaning. Every
  reachable leaf must still be a literal map with exactly the declared fields;
  this admits heterogeneous records without introducing a dynamically typed
  map representation or runtime field guessing."
  [form {:keys [fields descriptor]}
   records-by-map-constructor records-by-wide-positional-constructor]
  (let [field-keys (mapv (comp keyword name) fields)
        rewrite #(rewrite-record-constructors
                  % records-by-map-constructor
                  records-by-wide-positional-constructor)
        recur-result #(rewrite-record-map-expression
                       % {:fields fields :descriptor descriptor}
                       records-by-map-constructor
                       records-by-wide-positional-constructor)]
    (cond
      (map? form)
      (do
        (when-not (= (set field-keys) (set (keys form)))
          (reject! "map-> record construction requires exactly the declared fields"
                   form :kotoba.error/record-map-constructor))
        (list* 'record-new descriptor
               (map (fn [field-key] (rewrite (get form field-key))) field-keys)))

      (and (seq? form) (contains? '#{if if-not} (first form)))
      (let [[op test then else :as parts] form]
        (when-not (= 4 (count parts))
          (reject! "computed map-> if requires both record-valued branches"
                   form :kotoba.error/record-map-constructor))
        (preserve-form-meta
         form
         (list op (rewrite test) (recur-result then) (recur-result else))))

      (and (seq? form) (contains? '#{if-let if-some} (first form)))
      (let [[op binding then else :as parts] form]
        (when-not (and (= 4 (count parts))
                       (vector? binding) (= 2 (count binding)))
          (reject! "computed map-> binding conditional requires one binding and both record-valued branches"
                   form :kotoba.error/record-map-constructor))
        (preserve-form-meta
         form
         (list op [(first binding) (rewrite (second binding))]
               (recur-result then) (recur-result else))))

      (and (seq? form) (= 'cond (first form)))
      (let [clauses (vec (rest form))]
        (when-not (and (even? (count clauses))
                       (= :else (nth clauses (- (count clauses) 2) nil)))
          (reject! "computed map-> cond requires a final :else record value"
                   form :kotoba.error/record-map-constructor))
        (preserve-form-meta
         form
         (list* 'cond
                (map-indexed (fn [index item]
                               (if (odd? index) (recur-result item) (rewrite item)))
                             clauses))))

      (and (seq? form) (= 'case (first form)))
      (let [[_ dispatch & clauses] form]
        (when-not (odd? (count clauses))
          (reject! "computed map-> case requires a default record value"
                   form :kotoba.error/record-map-constructor))
        (preserve-form-meta
         form
         (list* 'case (rewrite dispatch)
                (concat
                 (mapcat (fn [[test result]] [test (recur-result result)])
                         (partition 2 (butlast clauses)))
                 [(recur-result (last clauses))]))))

      (and (seq? form) (= 'condp (first form)))
      (let [[_ predicate dispatch & clauses] form]
        (when-not (and predicate dispatch (odd? (count clauses)))
          (reject! "computed map-> condp requires a predicate, dispatch, and default record value"
                   form :kotoba.error/record-map-constructor))
        (preserve-form-meta
         form
         (list* 'condp (rewrite predicate) (rewrite dispatch)
                (concat
                 (mapcat (fn [[test result]] [test (recur-result result)])
                         (partition 2 (butlast clauses)))
                 [(recur-result (last clauses))]))))

      (and (seq? form) (= 'let (first form)))
      (let [[_ bindings & body] form]
        (when-not (and (vector? bindings) (even? (count bindings)) (seq body))
          (reject! "computed map-> let requires bindings and a result expression"
                   form :kotoba.error/record-map-constructor))
        (preserve-form-meta
         form
         (list* 'let
                (mapv (fn [index item]
                        (if (odd? index) (rewrite item) item))
                      (range) bindings)
                (concat (map rewrite (butlast body))
                        [(recur-result (last body))]))))

      (and (seq? form) (= 'do (first form)))
      (let [body (rest form)]
        (when-not (seq body)
          (reject! "computed map-> do requires a result expression"
                   form :kotoba.error/record-map-constructor))
        (preserve-form-meta
         form
         (list* 'do (concat (map rewrite (butlast body))
                            [(recur-result (last body))]))))

      :else
      (reject! (str "map-> record construction requires an exact map or a closed "
                    "control expression of exact maps")
               form :kotoba.error/record-map-constructor)))))

#?(:kotoba nil :default
(defn rewrite-record-constructors
  [form records-by-map-constructor records-by-wide-positional-constructor]
  (cond
    (seq? form)
    (let [[op & args] form]
      (preserve-form-meta
       form
       (cond
        (= 'quote op) form

        (contains? records-by-map-constructor op)
        (let [record (get records-by-map-constructor op)]
          (when-not (= 1 (count args))
            (reject! "map-> record construction requires one map expression"
                     form :kotoba.error/record-map-constructor))
          (rewrite-record-map-expression
           (first args) record
           records-by-map-constructor records-by-wide-positional-constructor))

        (contains? records-by-wide-positional-constructor op)
        (let [{:keys [fields descriptor]} (get records-by-wide-positional-constructor op)]
          (when-not (= (count fields) (count args))
            (reject! "positional record construction must exactly match the declared fields"
                     form :kotoba.error/record-positional-constructor))
          (list* 'record-new descriptor
                 (mapv #(rewrite-record-constructors
                         % records-by-map-constructor
                         records-by-wide-positional-constructor)
                       args)))

        :else
        (list* op (mapv #(rewrite-record-constructors
                         % records-by-map-constructor
                         records-by-wide-positional-constructor)
                       args)))))
    (vector? form) (mapv #(rewrite-record-constructors
                          % records-by-map-constructor
                          records-by-wide-positional-constructor)
                         form)
    (map? form) (into (empty form)
                      (map (fn [[k v]]
                             [(rewrite-record-constructors
                               k records-by-map-constructor
                               records-by-wide-positional-constructor)
                              (rewrite-record-constructors
                               v records-by-map-constructor
                               records-by-wide-positional-constructor)]))
                      form)
    (set? form) (set (map #(rewrite-record-constructors
                            % records-by-map-constructor
                            records-by-wide-positional-constructor)
                          form))
    :else form)))

#?(:kotoba nil :default
(defn rewrite-record-bindings
  "Rewrite sequential binding values while tracking whether PATTERN shadows the
  record receiver.  A binding is not visible in its own initializer, but is
  visible to every initializer and body expression that follows it."
  [bindings receiver descriptor active?]
  (loop [remaining (partition 2 bindings)
         active? active?
         rewritten []]
    (if-let [[pattern value] (first remaining)]
      (recur (next remaining)
             (and active? (not (contains? (binding-symbols pattern) receiver)))
             (conj rewritten pattern
                   (rewrite-record-member-access* value receiver descriptor active?)))
      [(vec rewritten) active?]))))

#?(:kotoba nil :default
(defn rewrite-record-fn-clause
  [clause receiver descriptor active? named-receiver?]
  (let [[params & body] clause
        body-active? (and active?
                          (not named-receiver?)
                          (vector? params)
                          (not (contains? (binding-symbols params) receiver)))]
    (if (vector? params)
      (preserve-form-meta
       clause
       (list* params
              (mapv #(rewrite-record-member-access* % receiver descriptor body-active?)
                    body)))
      clause))))

#?(:kotoba nil :default
(defn rewrite-record-member-access*
  [form receiver descriptor active?]
  (if-not active?
    form
    (cond
      (seq? form)
      (let [[op & args] form]
        (preserve-form-meta
         form
         (cond
           (= 'quote op) form

           (and (= 'get op)
                (<= 2 (count args) 3)
                (= receiver (first args))
                (keyword? (second args)))
           (list 'record-get descriptor receiver (second args))

           (= 'let op)
           (let [[bindings & body] args]
             (if (and (vector? bindings) (even? (count bindings)))
               (let [[bindings' body-active?]
                     (rewrite-record-bindings bindings receiver descriptor active?)]
                 (list* op bindings'
                        (mapv #(rewrite-record-member-access* % receiver descriptor body-active?)
                              body)))
               (list* op (mapv #(rewrite-record-member-access* % receiver descriptor active?)
                               args))))

           (= 'loop op)
           (let [[bindings & body] args]
             (if (and (vector? bindings) (even? (count bindings)))
               (let [pairs (partition 2 bindings)
                     bindings' (vec (mapcat
                                     (fn [[pattern value]]
                                       [pattern
                                        (rewrite-record-member-access*
                                         value receiver descriptor active?)])
                                     pairs))
                     body-active? (and active?
                                       (not-any? #(contains? (binding-symbols %) receiver)
                                                 (map first pairs)))]
                 (list* 'loop bindings'
                        (mapv #(rewrite-record-member-access* % receiver descriptor body-active?)
                              body)))
               (list* 'loop
                      (mapv #(rewrite-record-member-access* % receiver descriptor active?)
                            args))))

           (= 'fn op)
           (let [named? (symbol? (first args))
                 fn-name (when named? (first args))
                 clauses (if named? (rest args) args)
                 named-receiver? (= receiver fn-name)]
             (if (vector? (first clauses))
               (let [[params & body] clauses
                     clause (list* params body)
                     rewritten (rewrite-record-fn-clause clause receiver descriptor
                                                         active? named-receiver?)]
                 (list* 'fn (concat (when named? [fn-name]) rewritten)))
               (list* 'fn
                      (concat (when named? [fn-name])
                              (mapv #(rewrite-record-fn-clause % receiver descriptor
                                                               active? named-receiver?)
                                    clauses)))))

           :else
           (list* op (mapv #(rewrite-record-member-access* % receiver descriptor active?)
                           args)))))
      (vector? form) (mapv #(rewrite-record-member-access* % receiver descriptor active?) form)
      (map? form) (into (empty form)
                        (map (fn [[k v]] [(rewrite-record-member-access* k receiver descriptor active?)
                                         (rewrite-record-member-access* v receiver descriptor active?)]))
                        form)
      (set? form) (set (map #(rewrite-record-member-access* % receiver descriptor active?) form))
      :else form))))

#?(:kotoba nil :default
(defn rewrite-record-member-access [form receiver descriptor]
  (rewrite-record-member-access* form receiver descriptor true)))

#?(:kotoba nil :default
(defn expand-record-protocol-forms [forms]
  (let [namespace-symbol (or (first-truthy (fn [form]
                                     (when (and (seq? form) (= 'ns (first form)))
                                       (second form)))
                                   forms)
                             (symbol "kotoba.user"))
        protocol-forms (filter #(and (seq? %)
                                     (contains? protocol-declaration-heads (first %)))
                               forms)
        protocol-infos (mapv protocol-form->info protocol-forms)
        protocols (into {} (map (juxt :name identity)) protocol-infos)
        _ (when-not (= (count protocols) (count protocol-infos))
            (reject! "duplicate protocol name" protocol-forms
                     :kotoba.error/protocol-declaration))
        method-names (mapcat (comp keys :methods) protocol-infos)
        _ (when-not (= (count method-names) (count (distinct method-names)))
            (reject! "protocol method names must be unique within a namespace"
                     protocol-forms :kotoba.error/protocol-declaration))
        declared-function-names
        (into #{} (keep (fn [form]
                          (when (and (seq? form)
                                     (contains? '#{defn defn-} (first form)))
                            (second form)))) forms)
        _ (when (seq (set/intersection (set method-names) declared-function-names))
            (reject! "protocol method names must not collide with declared functions"
                     protocol-forms :kotoba.error/protocol-declaration))
        record-forms (filter #(and (seq? %) (= 'defrecord (first %))) forms)
        record-infos (mapv #(record-form->info namespace-symbol protocols %) record-forms)
        records (into {} (map (juxt :name identity)) record-infos)
        _ (when-not (= (count records) (count record-infos))
            (reject! "duplicate record name" record-forms :kotoba.error/record-declaration))
        extend-type-forms (filter #(and (seq? %) (= 'extend-type (first %))) forms)
        extend-type-impls
        (into [] (mapcat #(extend-type-form->implementations protocols records %))
              extend-type-forms)
        extend-protocol-forms
        (filter #(and (seq? %) (= 'extend-protocol (first %))) forms)
        extend-protocol-infos
        (mapv #(extend-protocol-form->info protocols records %) extend-protocol-forms)
        default-infos (filter :default-methods extend-protocol-infos)
        default-protocols (map :protocol default-infos)
        _ (when-not (= (count default-protocols) (count (distinct default-protocols)))
            (reject! "extend-protocol permits one default section per protocol"
                     extend-protocol-forms :kotoba.error/protocol-extension))
        explicit-implementations
        (vec (concat (mapcat :implementations record-infos)
                     extend-type-impls
                     (mapcat :implementations extend-protocol-infos)))
        explicit-identities (map (juxt :protocol :method :record)
                                 explicit-implementations)
        _ (when-not (= (count explicit-identities)
                       (count (distinct explicit-identities)))
            (reject! "duplicate protocol method implementation" explicit-implementations
                     :kotoba.error/protocol-extension))
        default-implementations
        (mapcat
         (fn [{:keys [protocol default-methods form]}]
           (when-not (seq record-infos)
             (reject! "extend-protocol default has no declared record specialization targets"
                      form :kotoba.error/protocol-extension))
           ;; Validate the section even when every record has an explicit
           ;; implementation and the default therefore emits no function.
           (extension-implementations protocols records protocol
                                      (:name (first record-infos))
                                      default-methods form)
           (let [implemented-records
                 (into #{}
                       (keep (fn [{implemented-protocol :protocol record :record}]
                               (when (= protocol implemented-protocol) record)))
                       explicit-implementations)]
             (mapcat (fn [{:keys [name]}]
                       (when-not (contains? implemented-records name)
                         (extension-implementations protocols records protocol name
                                                    default-methods form)))
                     record-infos)))
         default-infos)
        implementations (vec (concat explicit-implementations
                                     default-implementations))
        identities (map (juxt :protocol :method :record) implementations)
        _ (when-not (= (count identities) (count (distinct identities)))
            (reject! "duplicate protocol method implementation" implementations
                     :kotoba.error/protocol-extension))
        named-impls (mapv #(assoc %1 :impl-name
                                  (symbol (str "__kotoba_protocol_impl_" %2)))
                          implementations (range))
        constructors
        (into []
              (keep (fn [{:keys [name fields field-parts typed? descriptor]}]
                      ;; A positional constructor with more than max-parameters
                      ;; is still valid as direct record syntax, but it cannot
                      ;; become a first-class function without lying about the
                      ;; bounded callable ABI. Wide direct calls are rewritten
                      ;; below; map->Type remains available at every width.
                      (when (<= (count fields) max-parameters)
                        (let [params (if typed?
                                       (vec (mapcat (juxt :name :type) field-parts))
                                       fields)]
                          (list 'defn (symbol (str "->" name)) params descriptor
                                (list* 'record-new descriptor fields)))))
                    record-infos))
        impl-defs
        (mapv (fn [{:keys [impl-name params param-types record-type body]}]
                (let [typed-params
                      (vec (mapcat (fn [index param param-type]
                                     [param (if (zero? index) record-type param-type)])
                                   (range) params param-types))]
                  (list 'defn- impl-name typed-params
                        (rewrite-record-member-access body (first params) record-type))))
              named-impls)
        dispatch
        {:methods (into {}
                        (map (fn [[method-name params]]
                               [method-name {:arity (count params)
                                             :implementations
                                             (into {}
                                                   (keep (fn [{:keys [method record-type impl-name]}]
                                                           (when (= method method-name)
                                                             [(second record-type) impl-name])))
                                                   named-impls)}]))
                        (mapcat :methods protocol-infos))}
        map-constructors
        (into {} (map (fn [{:keys [name] :as record}]
                        [(symbol (str "map->" name)) record]))
              record-infos)
        wide-positional-constructors
        (into {} (keep (fn [{:keys [name fields] :as record}]
                         (when (> (count fields) max-parameters)
                           [(symbol (str "->" name)) record])))
              record-infos)
        record-schemas
        ;; A defrecord whose fields already use closed schema edges can expose
        ;; its nominal identity as [:ref :ns/Type]. Keep legacy declarations
        ;; with nested inline nominal descriptors source-compatible: those
        ;; descriptors are valid record values, but are intentionally not
        ;; inserted into the stricter closed schema graph.
        (into {} (keep (fn [{:keys [descriptor]}]
                         (let [field-types (map second (nth descriptor 2))
                               inline-nominal?
                               (first-truthy (fn [field-type]
                                       (first-truthy #(or (record-type? %)
                                                  (variant-type? %))
                                             (tree-seq coll? seq field-type)))
                                     field-types)]
                           (when-not inline-nominal?
                             [(second descriptor) descriptor]))))
              record-infos)
        declarations '#{defrecord defprotocol definterface extend-type extend-protocol}
        ordinary (remove #(and (seq? %) (contains? declarations (first %))) forms)
        rewritten (mapv #(rewrite-record-constructors
                          % map-constructors wide-positional-constructors)
                        ordinary)]
    {:forms (into rewritten (concat constructors impl-defs))
     :dispatch dispatch
     :record-schemas record-schemas})))
