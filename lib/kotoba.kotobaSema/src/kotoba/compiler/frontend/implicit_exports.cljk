(ns kotoba.compiler.frontend.implicit-exports
  #?(:kotoba {:kotoba/export [intrinsic-helper-name? implicit-export-exclusions]})
  (:require #?@(:kotoba [[kotoba.form :as form]
                         [kotoba.compiler.frontend.base :refer [fget ftruthy? fl-add fl-has? fl-nth]]]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

#?(:kotoba
(defn intrinsic-helper-name? [name [:ref :form/r]] :bool
  (and (form/is-symbol? name)
       (let [s (form/symbol-value name)]
         (or (and (>= (string-length s) 19) (string=? (string-substring s 0 19) "__kotoba_intrinsic_"))
             (and (>= (string-length s) 13) (string=? (string-substring s 0 13) "__kotoba_doc_"))))))
   :default nil)

#?(:kotoba
(defn- ih-empty-set [] [:ref :form/r]
  (form/form-set (form/no-forms)))
   :default nil)

#?(:kotoba
(defn- ih-set-has? [s [:ref :form/r] x [:ref :form/r]] :bool
  (fl-has? (form/kids-of s) x 0))
   :default nil)

#?(:kotoba
(defn- ih-set-add [s [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
  (if (ih-set-has? s x)
    s
    (form/form-set (form/append-form (form/kids-of s) x))))
   :default nil)

#?(:kotoba
(defn- ih-heads-kids [kids [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (vector-count kids))
    acc
    (ih-heads-kids kids (+ i 1) (ih-heads (fl-nth kids i) acc))))
   :default nil)

#?(:kotoba
(defn- ih-heads [form [:ref :form/r] acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (let [acc2 (if (and (form/is-seq? form) (> (form/count-of form) 0) (form/is-symbol? (form/nth-of form 0)))
               (fl-add acc (form/nth-of form 0))
               acc)]
    (ih-heads-kids (form/kids-of form) 0 acc2)))
   :default nil)

#?(:kotoba
(defn- ih-loop-helper? [by-name [:ref :form/r] name [:ref :form/r]] :bool
  (ftruthy? (fget (form/form-get by-name name) :loop-helper?)))
   :default nil)

#?(:kotoba
(defn- ih-set-union [a [:ref :form/r] b [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of b))
    a
    (ih-set-union (ih-set-add a (form/nth-of b i)) b (+ i 1))))
   :default nil)

#?(:kotoba
(defn- ih-add-loop-calls [by-name [:ref :form/r] calls [:list [:ref :form/r]] j :i64 seen [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
  (if (>= j (vector-count calls))
    acc
    (let [c (fl-nth calls j)]
      (ih-add-loop-calls by-name calls (+ j 1) seen
                         (if (and (ih-loop-helper? by-name c) (not (ih-set-has? seen c))) (ih-set-add acc c) acc)))))
   :default nil)

#?(:kotoba
(defn- ih-next-frontier [by-name [:ref :form/r] frontier [:ref :form/r] i :i64 seen [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of frontier))
    acc
    (ih-next-frontier by-name frontier (+ i 1) seen
                      (ih-add-loop-calls by-name (ih-heads (fget (form/form-get by-name (form/nth-of frontier i)) :body) (form/no-forms)) 0 seen acc))))
   :default nil)

#?(:kotoba
(defn- ih-owned-step [by-name [:ref :form/r] frontier [:ref :form/r] seen [:ref :form/r]] [:ref :form/r]
  (if (= 0 (form/count-of frontier))
    seen
    (let [seen2 (ih-set-union seen frontier 0)
          next (ih-next-frontier by-name frontier 0 seen2 (ih-empty-set))]
      (ih-owned-step by-name next seen2))))
   :default nil)

#?(:kotoba
(defn- ih-initial-frontier [functions [:ref :form/r] by-name [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of functions))
    acc
    (let [f (form/nth-of functions i)]
      (ih-initial-frontier functions by-name (+ i 1)
                           (if (intrinsic-helper-name? (fget f :name))
                             (ih-add-loop-calls by-name (ih-heads (fget f :body) (form/no-forms)) 0 (ih-empty-set) acc)
                             acc)))))
   :default nil)

#?(:kotoba
(defn- ih-by-name [functions [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of functions))
    acc
    (ih-by-name functions (+ i 1) (form/assoc-form acc (fget (form/nth-of functions i) :name) (form/nth-of functions i)))))
   :default nil)

#?(:kotoba
(defn- ih-exclusion-names [functions [:ref :form/r] i :i64 by-name [:ref :form/r] owned [:ref :form/r] aet [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of functions))
    acc
    (let [name (fget (form/nth-of functions i) :name)]
      (ih-exclusion-names functions (+ i 1) by-name owned aet
                          (if (or (intrinsic-helper-name? name) (ih-set-has? owned name)
                                  (and (ih-loop-helper? by-name name) (form/form-has? aet name)))
                            (ih-set-add acc name)
                            acc)))))
   :default nil)

#?(:kotoba
(defn implicit-export-exclusions [functions [:ref :form/r] abort-error-types [:ref :form/r]] [:ref :form/r]
  (let [by-name (ih-by-name functions 0 (form/form-map (form/no-forms)))
        owned (ih-owned-step by-name (ih-initial-frontier functions by-name 0 (ih-empty-set)) (ih-empty-set))]
    (ih-exclusion-names functions 0 by-name owned abort-error-types (ih-empty-set))))
   :default nil)
