(ns kotoba.compiler.frontend.effect-inference
  #?(:kotoba {:kotoba/export [infer-effects]})
  (:require #?@(:kotoba [[kotoba.form :as form]
                         [kotoba.compiler.frontend.base :refer [effect-capability-id fget fput fl-has? ftruthy?]]]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

#?(:kotoba
(defn- ei-sym-is? [f [:ref :form/r] name :string] :bool
  (and (form/is-symbol? f) (string=? (form/symbol-value f) name)))
   :default nil)

#?(:kotoba
(defn- ei-set-has? [s [:ref :form/r] x [:ref :form/r]] :bool
  (fl-has? (form/kids-of s) x 0))
   :default nil)

#?(:kotoba
(defn- ei-set-add [s [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
  (if (ei-set-has? s x)
    s
    (form/form-set (form/append-form (form/kids-of s) x))))
   :default nil)

#?(:kotoba
(defn- ei-empty-set [] [:ref :form/r]
  (form/form-set (form/no-forms)))
   :default nil)

#?(:kotoba
(defn- ei-empty-map [] [:ref :form/r]
  (form/form-map (form/no-forms)))
   :default nil)

#?(:kotoba
(defn- ei-facts-kids [form [:ref :form/r] i :i64 names [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of form))
    acc
    (ei-facts-kids form (+ i 1) names (ei-facts-walk (form/nth-of form i) names acc))))
   :default nil)

#?(:kotoba
(defn- ei-cap-effect [id [:ref :form/r]] [:ref :form/r]
  (form/vec2 (form/keyword-form :cap/call) (form/int-form (effect-capability-id (form/int-value id)))))
   :default nil)

#?(:kotoba
(defn- ei-facts-walk [x [:ref :form/r] names [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
  (cond
    (and (form/is-seq? x) (> (form/count-of x) 0))
    (let [op (form/nth-of x 0)]
      (cond
        (ei-sym-is? op "cap-call")
        (ei-facts-walk (form/nth-of x 2)
                       names
                       (fput acc :effects (ei-set-add (fget acc :effects) (ei-cap-effect (form/nth-of x 1)))))
        (ei-sym-is? op "typed-cap-call")
        (ei-facts-walk (form/nth-of x 4)
                       names
                       (fput acc :effects (ei-set-add (fget acc :effects) (ei-cap-effect (form/nth-of x 1)))))
        (ei-set-has? names op)
        (ei-facts-kids x 1 names (fput acc :calls (ei-set-add (fget acc :calls) op)))
        :else (ei-facts-kids x 1 names acc)))
    (or (form/is-seq? x) (form/is-vec? x) (form/is-set? x) (form/is-map? x)) (ei-facts-kids x 0 names acc)
    :else acc))
   :default nil)

#?(:kotoba
(defn- ei-direct-facts [body [:ref :form/r] function-names [:ref :form/r]] [:ref :form/r]
  (ei-facts-walk body function-names
                 (fput (fput (ei-empty-map) :effects (ei-empty-set)) :calls (ei-empty-set))))
   :default nil)

#?(:kotoba
(defn- ei-names-set [functions [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of functions))
    acc
    (ei-names-set functions (+ i 1) (ei-set-add acc (fget (form/nth-of functions i) :name)))))
   :default nil)

;; Each function's direct facts, with :abort and :state taken only from the marks left by earlier passes.
#?(:kotoba
(defn- ei-direct-all [functions [:ref :form/r] i :i64 names [:ref :form/r] acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of functions))
    acc
    (let [f (form/nth-of functions i)
          facts (ei-direct-facts (fget f :body) names)
          e1 (if (ftruthy? (fget f :abort-error-type)) (ei-set-add (fget facts :effects) (form/keyword-form :abort)) (fget facts :effects))
          e2 (if (ftruthy? (fget f :state-handler)) (ei-set-add e1 (form/keyword-form :state)) e1)]
      (ei-direct-all functions (+ i 1) names (form/assoc-form acc (fget f :name) (fput facts :effects e2))))))
   :default nil)

#?(:kotoba
(defn- ei-effects-of [inferred [:ref :form/r] name [:ref :form/r]] [:ref :form/r]
  (let [e (form/form-get inferred name)]
    (if (form/is-nil? e) (ei-empty-set) e)))
   :default nil)

;; The effects of callees from INFERRED without :abort and :state.
#?(:kotoba
(defn- ei-callee-effects [inferred [:ref :form/r] calls [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of calls))
    acc
    (ei-callee-effects inferred calls (+ i 1)
                       (ei-set-union-skip acc (ei-effects-of inferred (form/nth-of calls i)) 0))))
   :default nil)

#?(:kotoba
(defn- ei-set-union-skip [acc [:ref :form/r] more [:ref :form/r] i :i64] [:ref :form/r]
  (if (>= i (form/count-of more))
    acc
    (let [x (form/nth-of more i)]
      (ei-set-union-skip (if (or (form/eq x (form/keyword-form :abort)) (form/eq x (form/keyword-form :state))) acc (ei-set-add acc x)) more (+ i 1)))))
   :default nil)

#?(:kotoba
(defn- ei-effects-round [direct [:ref :form/r] inferred [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= (+ i 1) (form/count-of direct))
    acc
    (let [name (form/nth-of direct i)
          facts (form/nth-of direct (+ i 1))]
      (ei-effects-round direct inferred (+ i 2)
                        (form/assoc-form acc name (ei-callee-effects inferred (fget facts :calls) 0 (fget facts :effects)))))))
   :default nil)

#?(:kotoba
(defn- ei-effects-initial [direct [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= (+ i 1) (form/count-of direct))
    acc
    (ei-effects-initial direct (+ i 2) (form/assoc-form acc (form/nth-of direct i) (fget (form/nth-of direct (+ i 1)) :effects)))))
   :default nil)

#?(:kotoba
(defn- ei-effects-fix [direct [:ref :form/r] inferred [:ref :form/r]] [:ref :form/r]
  (let [next (ei-effects-round direct inferred 0 (ei-empty-map))]
    (if (form/eq inferred next) inferred (ei-effects-fix direct next))))
   :default nil)

#?(:kotoba
;; Every function's effect row (name -> set), to a fixed point over the call graph; :abort and :state do not propagate.
(defn infer-effects [functions [:ref :form/r]] [:ref :form/r]
  (let [names (ei-names-set functions 0 (ei-empty-set))
        direct (ei-direct-all functions 0 names (ei-empty-map))]
    (ei-effects-fix direct (ei-effects-initial direct 0 (ei-empty-map)))))
   :default nil)
