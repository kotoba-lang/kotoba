(ns kotoba.compiler.frontend.infer-loop-recur
  "Kotoba-native loop-helper recur argument checks split from frontend.infer."
  #?(:kotoba {:kotoba/export [check-loop-recur-argument-types!]})
  (:require #?@(:kotoba [[kotoba.form :as form]])
            [kotoba.compiler.frontend.base :refer [#?@(:kotoba [fe-reject-data fget fl-has? fl-slice form-text fput ftruthy?] :default [])]]
            #?@(:kotoba [[kotoba.compiler.frontend.infer :refer [a abort-bottom-form argc empty-fmap fn-signature ie-type-of map2 same-expression-type? sym-is? tk type-text zip-locals]]]))

  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                          [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                                 :fe/err [:record :fe/err [[:msg :string] [:code :string] [:form [:ref :form/r]] [:phase :string] [:data [:ref :form/r]]]]
                                 :ie/ctx [:record :ie/ctx [[:schemas [:ref :form/r]] [:row-schemas [:ref :form/r]] [:handlers [:ref :form/r]] [:final :bool] [:tail :bool] [:names [:ref :form/r]] [:recording :bool] [:recorded [:ref :form/r]] [:collect :bool] [:throws [:list [:ref :form/r]]] [:known [:ref :form/r]] [:tbl [:ref :form/r]] [:rec-limit :i64] [:rec-count :i64]]]})))

;; Recur checking shares only these small loop-signature helpers with result inference.
#?(:kotoba
(defn- loop-unknown-form [] [:ref :form/r]
  (form/keyword-form :kotoba.loop/unknown))
   :default nil)

#?(:kotoba
(defn- loop-helper-signatures-from [fs [:ref :form/r] i :i64 acc [:ref :form/r]] [:ref :form/r]
  (if (>= i (form/count-of fs))
    acc
    (let [f (form/nth-of fs i)]
      (loop-helper-signatures-from fs (+ i 1)
                                   (if (form/eq (fget f :loop-helper?) (form/bool-form true))
                                     (form/assoc-form acc (fget f :name) (fn-signature f))
                                     acc)))))
   :default nil)

#?(:kotoba
(defn- loop-helper-signatures [functions [:ref :form/r]] [:ref :form/r]
  (loop-helper-signatures-from functions 0 (empty-fmap)))
   :default nil)

#?(:kotoba
(defn- recur-infer [ctx [:ref :ie/ctx] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (try (ie-type-of ctx form locals sigs)
       (catch [:ref :fe/err] e (loop-unknown-form))))
   :default nil)

#?(:kotoba
(defn- recur-arg-error [index :i64 name [:ref :form/r] expected [:ref :form/r] actual [:ref :form/r] argument [:ref :form/r]] [:ref :fe/err]
  (let [position (+ index 1)
        position-text (string-from-i64 position)
        name-text (form-text name)
        expected-text (type-text expected)
        actual-text (type-text actual)
        msg (str "recur argument " position-text " rebinds the loop binding `" name-text "`, which is " expected-text ", with an expression of type " actual-text)
        data (fput (fput (map2 (tk :kotoba.error/expected) expected (tk :kotoba.error/actual) actual)
                         :kotoba.error/loop-binding name)
                   :kotoba.error/loop-recur-argument (form/int-form position))]
    (fe-reject-data msg "kotoba.error/loop-recur-type" argument data)))
   :default nil)

#?(:kotoba
(defn- recur-arg-ok? [actual [:ref :form/r] expected [:ref :form/r]] :bool
  (or (form/eq actual (loop-unknown-form))
      (form/eq actual (abort-bottom-form))
      (same-expression-type? actual expected)))
   :default nil)

;; the first N arguments of a call to the helper, each against the binding it rebinds
#?(:kotoba
(defn- recur-check-args [ctx [:ref :ie/ctx] form [:ref :form/r] index :i64 names [:ref :form/r] ptypes [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] :i64
  (if (or (>= index (form/count-of names)) (>= index (argc form)))
    0
    (let [expected (form/nth-of ptypes index)
          argument (a form index)
          actual (recur-infer ctx argument locals sigs)
          ok (recur-arg-ok? actual expected)
          _ (recur-arg-ok! ok index (form/nth-of names index) expected actual argument)]
      (recur-check-args ctx form (+ index 1) names ptypes locals sigs))))
   :default nil)

#?(:kotoba
(defn- recur-arg-ok! [ok :bool index :i64 name [:ref :form/r] expected [:ref :form/r] actual [:ref :form/r] argument [:ref :form/r]] :i64
  (if ok 0 (throw (recur-arg-error index name expected actual argument))))
   :default nil)

#?(:kotoba
(defn- recur-walk-args [ctx [:ref :ie/ctx] form [:ref :form/r] i :i64 helper-name [:ref :form/r] names [:ref :form/r] ptypes [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] :i64
  (if (>= i (form/count-of form))
    0
    (let [_ (recur-walk ctx helper-name names ptypes (form/nth-of form i) locals sigs)]
      (recur-walk-args ctx form (+ i 1) helper-name names ptypes locals sigs))))
   :default nil)

;; `let` bindings: each value walked in the outer locals, then the body in the folded locals (a refused value binds unknown)
#?(:kotoba
(defn- recur-let-values [ctx [:ref :ie/ctx] bindings [:ref :form/r] i :i64 helper-name [:ref :form/r] names [:ref :form/r] ptypes [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] :i64
  (if (< (+ i 1) (form/count-of bindings))
    (let [_ (recur-walk ctx helper-name names ptypes (form/nth-of bindings (+ i 1)) locals sigs)]
      (recur-let-values ctx bindings (+ i 2) helper-name names ptypes locals sigs))
    0))
   :default nil)

#?(:kotoba
(defn- recur-let-locals [ctx [:ref :ie/ctx] bindings [:ref :form/r] i :i64 current [:ref :form/r] sigs [:ref :form/r]] [:ref :form/r]
  (if (< (+ i 1) (form/count-of bindings))
    (let [name (form/nth-of bindings i)
          t (recur-infer ctx (form/nth-of bindings (+ i 1)) current sigs)]
      (recur-let-locals ctx bindings (+ i 2) (form/assoc-form current name t) sigs))
    current))
   :default nil)

#?(:kotoba
(defn- recur-walk-let [ctx [:ref :ie/ctx] form [:ref :form/r] helper-name [:ref :form/r] names [:ref :form/r] ptypes [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] :i64
  (let [bindings (a form 0)
        body (a form 1)
        _ (recur-let-values ctx bindings 0 helper-name names ptypes locals sigs)
        inner (recur-let-locals ctx bindings 0 locals sigs)]
    (recur-walk ctx helper-name names ptypes body inner sigs)))
   :default nil)

#?(:kotoba
(defn- recur-walk [ctx [:ref :ie/ctx] helper-name [:ref :form/r] names [:ref :form/r] ptypes [:ref :form/r] form [:ref :form/r] locals [:ref :form/r] sigs [:ref :form/r]] :i64
  (if (form/is-seq? form)
    (let [op (form/nth-of form 0)]
      (cond
        (form/eq op helper-name)
        (let [_ (recur-check-args ctx form 0 names ptypes locals sigs)]
          (recur-walk-args ctx form 1 helper-name names ptypes locals sigs))
        (and (sym-is? op "let") (form/is-vec? (a form 0)) (= 2 (argc form)) (= 0 (rem (form/count-of (a form 0)) 2)))
        (recur-walk-let ctx form helper-name names ptypes locals sigs)
        :else (recur-walk-args ctx form 1 helper-name names ptypes locals sigs)))
    0))
   :default nil)

#?(:kotoba
(defn- recur-check-function [ctx [:ref :ie/ctx] f [:ref :form/r] shapes [:ref :form/r] sigs [:ref :form/r]] :i64
  (let [name (fget f :name)
        bindings (fget (form/form-get shapes name) :bindings)
        n (if (form/is-int? bindings) (form/int-value bindings) 0)]
    (if (and (ftruthy? (fget f :loop-helper?)) (> n 0))
      (let [params (fget f :params)
            names (form/form-vec (fl-slice (form/kids-of params) 0 n (form/no-forms)))
            ptypes (fget f :param-types)
            locals (zip-locals params ptypes)]
        (recur-walk ctx name names ptypes (fget f :body) locals sigs))
      0)))
   :default nil)

#?(:kotoba
(defn- recur-check-functions [ctx [:ref :ie/ctx] fs [:ref :form/r] i :i64 shapes [:ref :form/r] sigs [:ref :form/r]] :i64
  (if (>= i (form/count-of fs))
    0
    (let [_ (recur-check-function ctx (form/nth-of fs i) shapes sigs)]
      (recur-check-functions ctx fs (+ i 1) shapes sigs))))
   :default nil)

;; A `recur` argument must have the type of the binding it rebinds. Answers FUNCTIONS.
#?(:kotoba
(defn check-loop-recur-argument-types! [ctx [:ref :ie/ctx] functions [:ref :form/r] shapes [:ref :form/r]] [:ref :form/r]
  (let [sigs (loop-helper-signatures functions)
        _ (recur-check-functions ctx functions 0 shapes sigs)]
    functions))
   :default nil)

#?(:kotoba
(defn- cs-set-empty [] [:ref :form/r]
  (form/form-set (form/no-forms)))
   :default nil)

#?(:kotoba
(defn- cs-set-has? [s [:ref :form/r] x [:ref :form/r]] :bool
  (fl-has? (form/kids-of s) x 0))
   :default nil)

#?(:kotoba
(defn- cs-set-add [s [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
  (if (fl-has? (form/kids-of s) x 0)
    s
    (form/form-set (form/append-form (form/kids-of s) x))))
   :default nil)

