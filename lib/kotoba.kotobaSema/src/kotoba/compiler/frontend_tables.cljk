   (defn document-head-set [] [:ref :form/r]
     (form/edn-form "#{merge select-keys get-in assoc-in update empty? some every? concat keep into}"))
   :default
   (def document-head-set
     "Clojure heads rewritten to primitives when their collection is a `:document`."
     '#{merge select-keys get-in assoc-in update empty? some every? concat keep into}))

#?(:kotoba
   (defn i64-answer-predicates [] [:ref :form/r]
     (form/edn-form "#{record-equal hetero-vector-equal typed-set-equal typed-map-equal task-ready? object-cas-won}"))
   :default
   (def i64-answer-predicates
     "ADR 0353 floor :bool-predicates (amends ADR 0028). The predicate primitives
     whose KIR operation still answers the legacy 0/1 `:i64`. The backends
     (kotoba-wasm `typed`, kotoba-script, kotoba-native) type these operations
     as `:i64` and are not changed; the LANGUAGE answers `:bool`, because every
     source occurrence is elaborated once to `(= op 1)`. With that, no predicate
     a program can write answers a number, and `if` refuses an `:i64` test."
     '#{record-equal hetero-vector-equal typed-set-equal typed-map-equal
        task-ready? object-cas-won}))

#?(:kotoba
   (defn local-state-write-heads [] [:ref :form/r]
     (form/edn-form "#{atom swap! reset!}"))
   :default
