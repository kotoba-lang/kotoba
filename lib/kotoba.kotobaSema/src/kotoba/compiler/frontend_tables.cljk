   :default
   (def document-constructor-heads
     '#{document-vector document-list document-map document-set document-null
        document-assoc document-dissoc document-merge document-vector-conj
        document-vector-drop document-string document-keyword document-symbol
        document-i64 document-bool document-f64 document-read document-edn-read
        __kotoba_document_of}))

