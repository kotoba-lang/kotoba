     '#{cap-call typed-cap-call assert! retract! observe! facet-enter! facet-leave!}))

#?(:kotoba
   (defn row-operation-heads [] [:ref :form/r]
     (form/edn-form "#{map-assoc dissoc select-keys merge}"))
   :default
   (def row-operation-heads '#{map-assoc dissoc select-keys merge}))

;; Type predicates (superproject adr-2609242330). Clojure's answers are
;; questions about a value's TYPE -- `(true? x)` is "x is the boolean true",
;; `(integer? x)` "x is an integer", `(map? x)` "x is a map" -- and here a
;; value's type is static EXCEPT inside a `:document`, the one value whose
;; shape is decided at run time. So:
;;   on a static type  -> decided here, as Clojure answers for a value of that
;;                 type: `(true? b)` on :bool is b, `(false? b)` is (not b),
;;                 every other type answers a constant; the operand is still
;;                 evaluated (2026-09-25, true? / integer?).
;;   on [:option T]    -> presence when T answers true, false when T answers
;;                 false (nil is none of these types); refused by name when
;;                 T's own answer depends on the value (:bool, :document).
;;   on a :document    -> the node's run-time kind, `(document-kind d)`, which
;;                 every backend that has documents already answers
;;                 (2026-09-26, gap 3 of the selfhost foundation; this was
;;                 refused by name until then). `nil?` / `some?` on a
;;                 document are the :null kind (see the option-some? arm of
;;                 `rewrite-record-projection`).
;; A module's own function of the same name wins, in inference and rewrite.
#?(:kotoba
   (defn library-predicate-heads [] [:ref :form/r]
     (form/edn-form "#{true? false? integer? boolean? string? keyword? symbol? map? vector? set? list? seq? coll?}"))
   :default
   (def library-predicate-heads
     '#{true? false? integer? boolean? string? keyword? symbol?
        map? vector? set? list? seq? coll?}))

#?(:kotoba
   (defn library-predicate-document-kinds [] [:ref :form/r]
     (form/edn-form "{true? #{:bool} false? #{:bool} integer? #{:i64} boolean? #{:bool} string? #{:string} keyword? #{:keyword} symbol? #{:symbol} map? #{:map} vector? #{:vector} set? #{:set} list? #{:list} seq? #{:list} coll? #{:vector :list :set :map}}"))
   :default
   (def library-predicate-document-kinds
     "The `document-kind` answers each predicate is true for (true? / false?
     read the bool payload instead)."
     '{true? #{:bool} false? #{:bool} integer? #{:i64} boolean? #{:bool}
       string? #{:string} keyword? #{:keyword} symbol? #{:symbol}
       map? #{:map} vector? #{:vector} set? #{:set} list? #{:list} seq? #{:list}
       coll? #{:vector :list :set :map}}))

#?(:kotoba
   (defn document-of-constructors [] [:ref :form/r]
     (form/edn-form "{:i64 document-i64 :string document-string :keyword document-keyword :bool document-bool :f64 document-f64}"))
   :default
   (def document-of-constructors
     "`__kotoba_document_of` (written only by `ex-info-data-argument`): the
     document constructor for a value of each scalar type."
     '{:i64 document-i64 :string document-string :keyword document-keyword
       :bool document-bool :f64 document-f64}))

#?(:kotoba
   (defn row-binding-heads [] [:ref :form/r]
     (form/edn-form "#{option-match result-match-of variant-match}"))
   :default
   (def row-binding-heads
     "Desugared heads that bind names in their arguments. Inside them the walk
     forgets what it knew about the names they bind."
     '#{option-match result-match-of variant-match}))

#?(:kotoba
   (defn state-perform-heads [] [:ref :form/r]
     (form/edn-form "#{__kotoba_state_perform __kotoba_state_op}"))
   :default
   (def state-perform-heads
     "The two reserved heads a performed operation passes through: unresolved
     (straight from source) and resolved to the handler that answers it."
     '#{__kotoba_state_perform __kotoba_state_op}))

#?(:kotoba
   (defn state-handle-heads [] [:ref :form/r]
     (form/edn-form "#{__kotoba_state_handle __kotoba_state_with}"))
   :default
   (def state-handle-heads
     '#{__kotoba_state_handle __kotoba_state_with}))

#?(:kotoba
   (defn stateful-def-heads [] [:ref :form/r]
     (form/edn-form "#{atom delay volatile! agent promise future}"))
   :default
   (def stateful-def-heads
     "Heads that allocate module-level STATE or defer EVALUATION. Refused at a
     `def` as a property -- this is the ambient-authority half the language
     authority forbids -- and refused by name so the sentence says what to do.
     `ref` is deliberately NOT here: `(ref name)` is the pure core's definition
     reference (surface-status :no-ambient-mutation
     :admitted-via-pure-core-elaboration), and STM's `(ref x)` is refused by
     the elaboration that admits the other shape, `:kotoba.error/ambient-
     forbidden`, which the probe below raises unchanged."
     '#{atom delay volatile! agent promise future}))

#?(:kotoba
   (defn effectful-def-heads [] [:ref :form/r]
     (form/edn-form "#{cap-call typed-cap-call}"))
   :default
   (def effectful-def-heads
     "Heads that name an effect directly at a `def`."
     '#{cap-call typed-cap-call}))

;; Heads whose meaning the rest of the frontend depends on. A template may not
;; take one of these names: the expansion pass runs before every other pass, so
;; it would be rewriting the language out from under them.
#?(:kotoba
   (defn structural-heads [] [:ref :form/r]
     (form/edn-form "#{ns def defn defn- defmulti defmethod defrecord defprotocol definterface extend-type extend-protocol defdesugar if let let* do fn loop recur quote var recur-to}"))
   :default
   (def structural-heads
     '#{ns def defn defn- defmulti defmethod defrecord defprotocol definterface
        extend-type extend-protocol defdesugar
        if let let* do fn loop recur quote var recur-to}))

#?(:kotoba
   (defn protocol-declaration-heads [] [:ref :form/r]
     (form/edn-form "#{defprotocol definterface}"))
   :default
   (def protocol-declaration-heads
     "The two heads `expand-record-protocol-forms` reads with
     `protocol-form->info`.
   
     It exists so the refusal can spell the head the CALLER wrote. Measured
     2026-09-03 at 5917518b, `(definterface)` answered
   
         defprotocol requires unique bounded (method [this ...]) signatures
   
     which names a form the caller did not write and sends them to the wrong
     place to fix it. One arm serving two heads is the right shape -- an
     interface and a protocol ARE the same declaration here -- but the sentence
     has to say which one arrived.
   
     Spelling a value read from source into a message is safe here for the reason
     `definition-heads` gives about itself: a form reaches `protocol-form->info`
     only because the filter in `expand-record-protocol-forms` MATCHED its head
     against one of these two literals, so the head cannot be anything a program
     chose. The error CODE stays a literal regardless -- the head travels in the
     sentence, never in `:kotoba.error/code`."
     '#{defprotocol definterface}))

;; ---- heads read from lang/guest-grammar.edn ------------------------------
;;
;; Host: the frontend keeps reading the classpath resource itself (JVM only;
;; ClojureScript cannot read a resource synchronously and answers empty), so the
;; sets below are NOT what the host analyser consults. They are the Kotoba
;; route's copy: a Kotoba module has no classpath, so the values the JVM reads
;; from the vendored grammar are embedded here. `frontend-tables-test` compares
;; them with the resource, so a grammar bump that is not carried here fails a
;; test instead of silently changing what the self-hosted compiler refuses.

#?(:kotoba
   (defn grammar-declared-heads [] [:ref :form/r]
     (form/edn-form "#{* + - -> ->> / < <= = > >= alloc alloc-checked and apply arena-scope as-> assert assoc atom-local bit-and bit-or bit-shift-left bit-shift-right bit-xor byte-at byte-store! bytes bytes-at bytes-concat bytes-count bytes-empty bytes-from-vector-i64 bytes-len bytes-ptr bytes-slice call-indirect cap-acquire case closed-multimethod cond cond->> condp conj cons contains? count data-host-arg dataspace dec defdesugar disj dissoc do document doseq dotimes drop empty? eval expression-absence f32 f32* f32+ f32- f32-add f32-div f32-max f32-min f32-mul f32-sub f32< f32<= f32= f32> f32>= f32div f32neg f32sqrt f64-add f64-div f64-max f64-min f64-mul f64-sub filter first fn fn-ref get has-capability? host-i64-roundtrip i32-store! i64 i64* i64+ i64- i64and i64or i64shl i64shr i64ushr i64xor if-let if-not if-some inc inline-fn-callback integer? interface-contract invoke kernel-atomic-add-u32 kernel-atomic-add-u64 kernel-boot-info kernel-cli kernel-cmpxchg-u32 kernel-cmpxchg-u64 kernel-configure-double-fault-ist kernel-configure-page-fault-recovery kernel-cpuid-eax kernel-cpuid-ebx kernel-cpuid-ecx kernel-cpuid-edx kernel-dequant-dot-ptq1-0 kernel-dequant-dot-q4-k kernel-dequant-dot-q6-k kernel-dequant-dot-q8-0 kernel-dot-f32 kernel-double-fault-handler-address kernel-fence-full kernel-fence-load kernel-fence-store kernel-hlt kernel-in-u32 kernel-in-u8 kernel-invlpg kernel-isr-entry-address kernel-jump-to kernel-load-gdt-tss kernel-load-idt kernel-load-ptr kernel-load-u16 kernel-load-u16-16k kernel-load-u16-4k kernel-load-u16-64k kernel-load-u32 kernel-load-u32-16k kernel-load-u32-4k kernel-load-u32-64k kernel-load-u64 kernel-load-u64-16k kernel-load-u64-4k kernel-load-u64-64k kernel-load-u8 kernel-load-u8-16k kernel-load-u8-4k kernel-load-u8-64k kernel-out-u32 kernel-out-u8 kernel-page-fault-handler-address kernel-page-fault-recovery-handler-address kernel-pause kernel-probe-double-fault kernel-probe-guard-write kernel-probe-nx-execute kernel-probe-recoverable-guard-write kernel-probe-text-write kernel-rdtsc kernel-rdtscp kernel-read-cr0 kernel-read-cr2 kernel-read-cr3 kernel-read-cr4 kernel-read-cs kernel-read-msr kernel-rt-timer-handler-address kernel-scratch-region kernel-sti kernel-store-u16 kernel-store-u16-16k kernel-store-u16-4k kernel-store-u16-64k kernel-store-u32 kernel-store-u32-16k kernel-store-u32-4k kernel-store-u32-64k kernel-store-u64 kernel-store-u64-16k kernel-store-u64-4k kernel-store-u64-64k kernel-store-u8 kernel-store-u8-16k kernel-store-u8-4k kernel-store-u8-64k kernel-subregion kernel-swapgs kernel-system-table kernel-try-lock-u32 kernel-uefi-alloc-region kernel-uefi-call2 kernel-uefi-call4 kernel-uefi-call6 kernel-undefined-opcode-handler-address kernel-unlock-u32 kernel-write-cr0 kernel-write-cr3 kernel-write-cr4 kernel-write-msr kernel-xchg-u32 kernel-xchg-u64 kernel-xgetbv kernel-xsetbv keys keyword-literal keyword? lazy-cons lazy-empty? lazy-filter lazy-first lazy-map lazy-rest list loop-recur map map-indexed map-literal match max mem-byte-at mem-i32-at memory-grow memory-pages min mod neg? nested-destructuring not not= nth option-or or pair pair-first pair-second peek pop portable-string-symbol-values pos? protocol-dispatch protocol-extension pure-s-expression-core quot record-constructor reduce rem rest result-err? result-ok? result-status result-value result-write! second set-literal slice-get slice-length slice-load-u16 slice-load-u32 slice-load-u64 slice-load-u8 slice-of-u16 slice-of-u32 slice-of-u64 slice-of-u8 slice-set! slice-store-u16 slice-store-u32 slice-store-u64 slice-store-u8 slice-sub some-> some->> state-ability str-len str-ptr string-append-range string-compare string-compare-lines string-concat string-contains? string-equality string-find-blank string-find-byte string-fold-ascii string-from-utf8 string-host-arg string-index-of string-index-of-from string-length string-skip-blank string-split-count string-substring string= string? symbol symbol? take throw true? try type-directed-arithmetic type-predicates typed-capability-call unsigned-bit-shift-right vals variadic-comparison vector-i64-from-bytes vector-literal when when-let when-not when-some zero?}"))
   :default
   (def grammar-declared-heads
     "Every head `lang/guest-grammar.edn` names (`:admitted-builtins`, the
     `:sugar` keys, `:arithmetic`, `:comparisons`, `:predicates`, the float
     `:arithmetic`), as the JVM frontend reads them."
     '#{* + - -> ->> / < <= = > >= alloc alloc-checked and apply arena-scope
       as-> assert assoc atom-local bit-and bit-or bit-shift-left
       bit-shift-right bit-xor byte-at byte-store! bytes bytes-at bytes-concat
       bytes-count bytes-empty bytes-from-vector-i64 bytes-len bytes-ptr
       bytes-slice call-indirect cap-acquire case closed-multimethod cond
       cond->> condp conj cons contains? count data-host-arg dataspace dec
       defdesugar disj dissoc do document doseq dotimes drop empty? eval
       expression-absence f32 f32* f32+ f32- f32-add f32-div f32-max f32-min
       f32-mul f32-sub f32< f32<= f32= f32> f32>= f32div f32neg f32sqrt f64-add
       f64-div f64-max f64-min f64-mul f64-sub filter first fn fn-ref get
       has-capability? host-i64-roundtrip i32-store! i64 i64* i64+ i64- i64and
       i64or i64shl i64shr i64ushr i64xor if-let if-not if-some inc
       inline-fn-callback integer? interface-contract invoke
       kernel-atomic-add-u32 kernel-atomic-add-u64 kernel-boot-info kernel-cli
       kernel-cmpxchg-u32 kernel-cmpxchg-u64 kernel-configure-double-fault-ist
       kernel-configure-page-fault-recovery kernel-cpuid-eax kernel-cpuid-ebx
       kernel-cpuid-ecx kernel-cpuid-edx kernel-dequant-dot-ptq1-0
       kernel-dequant-dot-q4-k kernel-dequant-dot-q6-k kernel-dequant-dot-q8-0
       kernel-dot-f32 kernel-double-fault-handler-address kernel-fence-full
       kernel-fence-load kernel-fence-store kernel-hlt kernel-in-u32
       kernel-in-u8 kernel-invlpg kernel-isr-entry-address kernel-jump-to
       kernel-load-gdt-tss kernel-load-idt kernel-load-ptr kernel-load-u16
       kernel-load-u16-16k kernel-load-u16-4k kernel-load-u16-64k
       kernel-load-u32 kernel-load-u32-16k kernel-load-u32-4k
       kernel-load-u32-64k kernel-load-u64 kernel-load-u64-16k
       kernel-load-u64-4k kernel-load-u64-64k kernel-load-u8 kernel-load-u8-16k
       kernel-load-u8-4k kernel-load-u8-64k kernel-out-u32 kernel-out-u8
       kernel-page-fault-handler-address
       kernel-page-fault-recovery-handler-address kernel-pause
       kernel-probe-double-fault kernel-probe-guard-write
       kernel-probe-nx-execute kernel-probe-recoverable-guard-write
       kernel-probe-text-write kernel-rdtsc kernel-rdtscp kernel-read-cr0
       kernel-read-cr2 kernel-read-cr3 kernel-read-cr4 kernel-read-cs
       kernel-read-msr kernel-rt-timer-handler-address kernel-scratch-region
       kernel-sti kernel-store-u16 kernel-store-u16-16k kernel-store-u16-4k
       kernel-store-u16-64k kernel-store-u32 kernel-store-u32-16k
       kernel-store-u32-4k kernel-store-u32-64k kernel-store-u64
       kernel-store-u64-16k kernel-store-u64-4k kernel-store-u64-64k
       kernel-store-u8 kernel-store-u8-16k kernel-store-u8-4k
       kernel-store-u8-64k kernel-subregion kernel-swapgs kernel-system-table
       kernel-try-lock-u32 kernel-uefi-alloc-region kernel-uefi-call2
       kernel-uefi-call4 kernel-uefi-call6
       kernel-undefined-opcode-handler-address kernel-unlock-u32
       kernel-write-cr0 kernel-write-cr3 kernel-write-cr4 kernel-write-msr
       kernel-xchg-u32 kernel-xchg-u64 kernel-xgetbv kernel-xsetbv keys
       keyword-literal keyword? lazy-cons lazy-empty? lazy-filter lazy-first
       lazy-map lazy-rest list loop-recur map map-indexed map-literal match max
       mem-byte-at mem-i32-at memory-grow memory-pages min mod neg?
       nested-destructuring not not= nth option-or or pair pair-first
       pair-second peek pop portable-string-symbol-values pos?
       protocol-dispatch protocol-extension pure-s-expression-core quot
       record-constructor reduce rem rest result-err? result-ok? result-status
       result-value result-write! second set-literal slice-get slice-length
       slice-load-u16 slice-load-u32 slice-load-u64 slice-load-u8 slice-of-u16
       slice-of-u32 slice-of-u64 slice-of-u8 slice-set! slice-store-u16
       slice-store-u32 slice-store-u64 slice-store-u8 slice-sub some-> some->>
       state-ability str-len str-ptr string-append-range string-compare
       string-compare-lines string-concat string-contains? string-equality
       string-find-blank string-find-byte string-fold-ascii string-from-utf8
       string-host-arg string-index-of string-index-of-from string-length
       string-skip-blank string-split-count string-substring string= string?
       symbol symbol? take throw true? try type-directed-arithmetic
       type-predicates typed-capability-call unsigned-bit-shift-right vals
       variadic-comparison vector-i64-from-bytes vector-literal when when-let
       when-not when-some zero?}))

;; The heads the Kotoba-route `reserved-function-names` (namespace_defs) adds to the union of the operation tables
;; (agent ARENA 2026-10-04: a table of its own so that the membership test is generated, see the generated block).
#?(:kotoba
   (defn reserved-extra-heads [] [:ref :form/r]
     (form/edn-form "#{atom swap! reset! deref let if cap-call typed-cap-call ns defn defn- some some? nil? option-or vector-i64 vector-f64 vector-new vector-f64-new hetero-vector typed-set record match-result match-variant match-option}"))
   :default
   (def reserved-extra-heads
     '#{atom swap! reset! deref let if cap-call typed-cap-call ns defn defn- some some? nil? option-or vector-i64 vector-f64 vector-new vector-f64-new hetero-vector typed-set record match-result match-variant match-option}))

#?(:kotoba
   (defn forbidden-heads [] [:ref :form/r]
     (form/edn-form "#{. .. agent alter-var-root binding compile defmacro dosync future import load load-file load-string locking new ns-resolve pmap read-string ref require resolve send send-off set! use var volatile!}"))
   :default
   (def forbidden-heads
     "The frontend's literal forbidden set plus the grammar's `:forbidden-heads`,
     as the JVM frontend computes it."
     '#{. .. agent alter-var-root binding compile defmacro dosync future import
       load load-file load-string locking new ns-resolve pmap read-string ref
       require resolve send send-off set! use var volatile!}))

;; ---- the capability catalog the Kotoba route sees ----------------------------
;;
;; The frontend derives these from `capability-registry-cljs-fallback` when it
;; cannot read the catalog resource (ClojureScript, and a Kotoba module, which
;; has no classpath). These three are that derivation, written out; the test
;; compares them with what the frontend derives.

#?(:kotoba
   (defn capability-catalog-fallback [] [:ref :form/r]
     (form/edn-form "{:capabilities {:can/frame {:source-operation can/frame :effect :can/frame :compiler-wire-id 29}
                    :cli/args {:source-operation cli/args :effect :cli/args :compiler-wire-id 38}
                    :clock/now {:source-operation clock/now :effect :clock/now :compiler-wire-id 7}
                    :code/eval {:source-operation code/eval :effect :code/eval :compiler-wire-id 30}
                    :dataspace/transact {:source-operation dataspace/transact :effect :dataspace/transact :compiler-wire-id 24}
                    :entropy/draw {:source-operation entropy/draw :effect :entropy/draw :compiler-wire-id 23}
                    :env/read {:source-operation env/read :effect :env/read :compiler-wire-id 33}
                    :fs/app-data {:source-operation fs/app-data :effect :fs/app-data :compiler-wire-id 35}
                    :fs/app-data-bytes {:source-operation fs/app-data-bytes :effect :fs/app-data-bytes :compiler-wire-id 35}
                    :fs/browse {:source-operation fs/browse :effect :fs/browse :compiler-wire-id 34}
                    :fs/browse-dir {:source-operation fs/browse-dir :effect :fs/browse-dir :compiler-wire-id 36}
                    :fs/transact {:source-operation fs/transact :effect :fs/transact :compiler-wire-id 19}
                    :git/run {:source-operation git/run :effect :git/run :compiler-wire-id 22}
                    :gpu/compute {:source-operation gpu/compute :effect :gpu/compute :compiler-wire-id 42}
                    :hash/sha256 {:source-operation hash/sha256 :effect :hash/sha256 :compiler-wire-id 3}
                    :http/accept {:source-operation http/accept :effect :http/accept :compiler-wire-id 17}
                    :http/get-stream {:source-operation http/get-stream :effect :http/get-stream :compiler-wire-id 13}
                    :http/post {:source-operation http/post :effect :http/post :compiler-wire-id 4}
                    :http/reply {:source-operation http/reply :effect :http/reply :compiler-wire-id 18}
                    :identity/sign {:source-operation identity/sign :effect :identity/sign :compiler-wire-id 1}
                    :identity/verify {:source-operation identity/verify :effect :identity/verify :compiler-wire-id 2}
                    :io/read {:source-operation io/read :effect :io/read :compiler-wire-id 41}
                    :io/write {:source-operation io/write :effect :io/write :compiler-wire-id 37}
                    :io/write-error {:source-operation io/write-error :effect :io/write-error :compiler-wire-id 39}
                    :link/frame {:source-operation link/frame :effect :link/frame :compiler-wire-id 28}
                    :llm/generate {:source-operation llm/generate :effect :llm/generate :compiler-wire-id 11}
                    :log/append {:source-operation log/append :effect :log/append :compiler-wire-id 6}
                    :log/read {:source-operation log/read :effect :log/read :compiler-wire-id 5}
                    :net/accept {:source-operation net/accept :effect :net/accept :compiler-wire-id 44}
                    :net/datagram {:source-operation net/datagram :effect :net/datagram :compiler-wire-id 27}
                    :net/dial {:source-operation net/dial :effect :net/dial :compiler-wire-id 45}
                    :net/listen {:source-operation net/listen :effect :net/listen :compiler-wire-id 43}
                    :net/read {:source-operation net/read :effect :net/read :compiler-wire-id 46}
                    :net/write {:source-operation net/write :effect :net/write :compiler-wire-id 47}
                    :object/compare-and-set-ref {:source-operation object/compare-and-set-ref :effect :object/compare-and-set-ref :compiler-wire-id 16}
                    :object/get-stream {:source-operation object/get-stream :effect :object/get-stream :compiler-wire-id 14}
                    :object/put-block {:source-operation object/put-block :effect :object/put-block :compiler-wire-id 15}
                    :process/spawn {:source-operation process/spawn :effect :process/spawn :compiler-wire-id 20}
                    :screen/act {:source-operation screen/act :effect :screen/act :compiler-wire-id 32}
                    :screen/observe {:source-operation screen/observe :effect :screen/observe :compiler-wire-id 31}
                    :secret/get {:source-operation secret/get :effect :secret/get :compiler-wire-id 21}
                    :state/transact {:source-operation state/transact :effect :state/transact :compiler-wire-id 8}
                    :storage/transact {:source-operation storage/transact :effect :storage/transact :compiler-wire-id 12}
                    :stream/accept {:source-operation stream/accept :effect :stream/accept :compiler-wire-id 25}
                    :stream/send {:source-operation stream/send :effect :stream/send :compiler-wire-id 26}
                    :sys/cwd {:source-operation sys/cwd :effect :sys/cwd :compiler-wire-id 40}
                    :ui/commit {:source-operation ui/commit :effect :ui/commit :compiler-wire-id 9}
                    :ui/next-event {:source-operation ui/next-event :effect :ui/next-event :compiler-wire-id 10}}}"))
   :default
   (def capability-catalog-fallback
     "`{:capabilities {name {:source-operation :effect :compiler-wire-id}}}` built from the fallback registry."
     '{:capabilities {:can/frame {:source-operation can/frame :effect :can/frame :compiler-wire-id 29}
                    :cli/args {:source-operation cli/args :effect :cli/args :compiler-wire-id 38}
                    :clock/now {:source-operation clock/now :effect :clock/now :compiler-wire-id 7}
                    :code/eval {:source-operation code/eval :effect :code/eval :compiler-wire-id 30}
                    :dataspace/transact {:source-operation dataspace/transact :effect :dataspace/transact :compiler-wire-id 24}
                    :entropy/draw {:source-operation entropy/draw :effect :entropy/draw :compiler-wire-id 23}
                    :env/read {:source-operation env/read :effect :env/read :compiler-wire-id 33}
                    :fs/app-data {:source-operation fs/app-data :effect :fs/app-data :compiler-wire-id 35}
                    :fs/app-data-bytes {:source-operation fs/app-data-bytes :effect :fs/app-data-bytes :compiler-wire-id 35}
                    :fs/browse {:source-operation fs/browse :effect :fs/browse :compiler-wire-id 34}
                    :fs/browse-dir {:source-operation fs/browse-dir :effect :fs/browse-dir :compiler-wire-id 36}
                    :fs/transact {:source-operation fs/transact :effect :fs/transact :compiler-wire-id 19}
                    :git/run {:source-operation git/run :effect :git/run :compiler-wire-id 22}
                    :gpu/compute {:source-operation gpu/compute :effect :gpu/compute :compiler-wire-id 42}
                    :hash/sha256 {:source-operation hash/sha256 :effect :hash/sha256 :compiler-wire-id 3}
                    :http/accept {:source-operation http/accept :effect :http/accept :compiler-wire-id 17}
                    :http/get-stream {:source-operation http/get-stream :effect :http/get-stream :compiler-wire-id 13}
                    :http/post {:source-operation http/post :effect :http/post :compiler-wire-id 4}
                    :http/reply {:source-operation http/reply :effect :http/reply :compiler-wire-id 18}
                    :identity/sign {:source-operation identity/sign :effect :identity/sign :compiler-wire-id 1}
                    :identity/verify {:source-operation identity/verify :effect :identity/verify :compiler-wire-id 2}
                    :io/read {:source-operation io/read :effect :io/read :compiler-wire-id 41}
                    :io/write {:source-operation io/write :effect :io/write :compiler-wire-id 37}
                    :io/write-error {:source-operation io/write-error :effect :io/write-error :compiler-wire-id 39}
                    :link/frame {:source-operation link/frame :effect :link/frame :compiler-wire-id 28}
                    :llm/generate {:source-operation llm/generate :effect :llm/generate :compiler-wire-id 11}
                    :log/append {:source-operation log/append :effect :log/append :compiler-wire-id 6}
                    :log/read {:source-operation log/read :effect :log/read :compiler-wire-id 5}
                    :net/accept {:source-operation net/accept :effect :net/accept :compiler-wire-id 44}
                    :net/datagram {:source-operation net/datagram :effect :net/datagram :compiler-wire-id 27}
                    :net/dial {:source-operation net/dial :effect :net/dial :compiler-wire-id 45}
                    :net/listen {:source-operation net/listen :effect :net/listen :compiler-wire-id 43}
                    :net/read {:source-operation net/read :effect :net/read :compiler-wire-id 46}
                    :net/write {:source-operation net/write :effect :net/write :compiler-wire-id 47}
