;; `(arena-scope body)` -- superproject ADR-2609160044, context ABI v6. On
;; native every handle and byte allocated while BODY runs is released
;; afterwards; the reference interpreter answers the body's value. The
;; body's type is held to :i64 / :bool / :f64 in `infer-call-type-impl`,
;; which is what makes the release safe: no handle can be the result.
#?(:kotoba
   (defn region-operations [] [:ref :form/r]
     (form/edn-form "{arena-scope 1}"))
   :default
   (def region-operations '{arena-scope 1}))

#?(:kotoba
   (defn lazy-sequence-operations [] [:ref :form/r]
     (form/edn-form "#{lazy-cons lazy-first lazy-rest lazy-empty? lazy-map lazy-filter take drop}"))
   :default
   (def lazy-sequence-operations
     '#{lazy-cons lazy-first lazy-rest lazy-empty? lazy-map lazy-filter take drop}))

#?(:kotoba
   (defn string-operations [] [:ref :form/r]
     (form/edn-form "{string-byte-length 1 string-length 1 string-from-i64 1 bytes-task-byte-count 1 task-ready? 1 object-cas-won 1 bytes-response-byte-count 1 bool-result 1 http-response-status 1 log-read-byte-count 1 string=? 2 string-concat 2 string-substring 3 string-replace-all 3 string-contains? 2 string-split-count 2 string-index-of 2 string-compare 2 string-fold-ascii 1 string-find-blank 2 string-skip-blank 2 string-index-of-from 3 string-compare-lines 4 string-find-byte 3 string-append-range 4 string-fold-case 1 string-upper 1 string-code-point-at 2 keyword-from-string 1 keyword-name 1 symbol 1}"))
   :default
   (def string-operations '{string-byte-length 1 string-length 1 string-from-i64 1
                            bytes-task-byte-count 1 task-ready? 1
                            object-cas-won 1
                            bytes-response-byte-count 1 bool-result 1
                            http-response-status 1 log-read-byte-count 1
                            string=? 2 string-concat 2 string-substring 3
                            string-replace-all 3 string-contains? 2 string-split-count 2
                            string-index-of 2
                            ;; ABI v7 text heads (2026-09-16): byte order, an
                            ;; ASCII-only fold, and the blank scan pair.
                            string-compare 2 string-fold-ascii 1
                            string-find-blank 2 string-skip-blank 2
                            ;; ABI v8 line heads (2026-09-16): an absolute search
                            ;; from an offset, and byte order of two lines named
                            ;; by their start offsets.
                            string-index-of-from 3 string-compare-lines 4
                            ;; ABI v10 range heads (2026-09-16): no view taken,
                            ;; none minted.
                            string-find-byte 3 string-append-range 4
                            string-fold-case 1 string-upper 1
                            string-code-point-at 2
                            keyword-from-string 1 keyword-name 1 symbol 1}))

