       f32-neg 1 f32-abs 1 f32-sqrt 1
       f32-eq 2 f32-lt 2 f32-le 2 f32-gt 2 f32-ge 2 f32-unordered 2}))

;; Type-directed name resolution for the plain numeric operators (2026-09-02).
;; `+ - * / < <= > >= =` are one spelling each; the operand types choose the
;; typed operation the way Unison resolves `+` to `Nat.+` or `Float.+`:
;; i64 operands stay the i64 forms KIR already executes, f64 operands lower to
;; `f64-add`/`f64-lt`/..., f32 operands to the `f32-*` family. Only the plain
;; spelling is overloaded -- `f64-add` and friends remain valid so a typed or
;; ABI boundary can still name its operation exactly.
;;
;; There is NO implicit conversion. An i64 next to an f64, or an f32 next to
;; an f64, is a rejection that names both types and the explicit conversion
;; operations the author has to choose between, because widening and
;; narrowing each have two spellings (`-checked` vs `-rounded`/`-truncating`)
;; and choosing one silently would decide overflow and rounding behaviour
;; the source never wrote. `quot` and the bit operations are integer-only and
;; are not overloaded; `/` has no i64 reading at all (integer division is
;; `quot`), so it resolves only through a float operand type.
#?(:kotoba
   (defn type-directed-numeric-heads [] [:ref :form/r]
     (form/edn-form "#{+ - * / < <= > >= =}"))
   :default
   (def type-directed-numeric-heads '#{+ - * / < <= > >= =}))

#?(:kotoba
   (defn float-division-heads [] [:ref :form/r]
     (form/edn-form "#{/}"))
   :default
   (def float-division-heads '#{/}))

#?(:kotoba
   (defn float-arithmetic-resolution [] [:ref :form/r]
     (form/edn-form "{:f64 {+ f64-add - f64-sub * f64-mul / f64-div < f64-lt <= f64-le > f64-gt >= f64-ge = f64-eq} :f32 {+ f32-add - f32-sub * f32-mul / f32-div < f32-lt <= f32-le > f32-gt >= f32-ge = f32-eq}}"))
   :default
   (def float-arithmetic-resolution
     "Plain operator -> typed operation, per float operand type."
     {:f64 '{+ f64-add - f64-sub * f64-mul / f64-div
             < f64-lt <= f64-le > f64-gt >= f64-ge = f64-eq}
      :f32 '{+ f32-add - f32-sub * f32-mul / f32-div
             < f32-lt <= f32-le > f32-gt >= f32-ge = f32-eq}}))

#?(:kotoba
   (defn float-negation-resolution [] [:ref :form/r]
     (form/edn-form "{:f64 f64-neg :f32 f32-neg}"))
   :default
   (def float-negation-resolution '{:f64 f64-neg :f32 f32-neg}))

#?(:kotoba
   (defn explicit-numeric-conversions [] [:ref :form/r]
     (form/edn-form "{[:i64 :f64] [i64-to-f64-checked i64-to-f64-rounded] [:f64 :i64] [f64-to-i64-checked f64-to-i64-truncating] [:i64 :f32] [i64-to-f32-checked i64-to-f32-rounded] [:f32 :i64] [f32-to-i64-checked f32-to-i64-truncating] [:f32 :f64] [f32-to-f64-exact] [:f64 :f32] [f64-to-f32-rounded]}"))
   :default
   (def explicit-numeric-conversions
     "[from to] -> the explicit conversion operations that take FROM to TO. Read
     from `f64-operations`/`f32-operations`; the message that names them is
     pinned by test, so a rename there must be a rename here."
     {[:i64 :f64] '[i64-to-f64-checked i64-to-f64-rounded]
      [:f64 :i64] '[f64-to-i64-checked f64-to-i64-truncating]
      [:i64 :f32] '[i64-to-f32-checked i64-to-f32-rounded]
      [:f32 :i64] '[f32-to-i64-checked f32-to-i64-truncating]
      [:f32 :f64] '[f32-to-f64-exact]
      [:f64 :f32] '[f64-to-f32-rounded]}))

#?(:kotoba
   (defn definition-heads [] [:ref :form/r]
     (form/edn-form "#{ns def defn defn- defrecord defprotocol definterface extend-type extend-protocol defdesugar defmulti defmethod}"))
   :default
   (def definition-heads
     "The closed set of heads `analyze*` dispatches a TOP-LEVEL form on.
   
     Its only job is to be the spellable vocabulary for `definition-failure!`,
     the way `reserved-function-names` is for `internal-failure!`. The rule that
     set enforces -- nothing a user chose may ride out in a `:kotoba.error/code`
     -- holds here for a stronger reason than membership: a form reaches the
     definition layer only because `analyze*` MATCHED its head against one of
     these literals, so the value passed to the guard cannot be anything else.
   
     Saying it separately is what makes that true. `def`, `defrecord`,
     `defprotocol`, `definterface`, `extend-type`, `extend-protocol`,
     `defdesugar`, `defmulti` and `defmethod` are NOT in
     `reserved-function-names` -- a program is not forbidden to name a function
     `def` -- so widening `internal-failure!`'s vocabulary to cover them would
     have let a user-chosen function name reach the envelope from the expression
     chokepoints. Two vocabularies, two call sites, no overlap."
     '#{ns def defn defn- defrecord defprotocol definterface
        extend-type extend-protocol defdesugar defmulti defmethod}))

#?(:kotoba
   (defn pure-product-disallowed-heads [] [:ref :form/r]
     (form/edn-form "#{cap-call typed-cap-call assert! retract! observe! facet-enter! facet-leave! doseq dotimes defmulti defmethod throw try catch future pmap agent send send-off atom swap! reset! deref condp cond-> cond->> some-> some->> as-> -> ->>}"))
   :default
   (def pure-product-disallowed-heads
     "Control / ambient heads rejected under `:language-profile :pure-product`
     even when the general subset might admit them (see pure-product-profile.edn)."
     '#{cap-call typed-cap-call assert! retract! observe! facet-enter! facet-leave!
        doseq dotimes defmulti defmethod throw try catch
        future pmap agent send send-off
        ;; local-state slice 1 left forbidden-heads on 2026-09-02; naming the
        ;; heads here keeps the pure-product surface exactly what it was.
        atom swap! reset! deref
        condp cond-> cond->> some-> some->> as-> -> ->>}))

#?(:kotoba
   (defn non-shadowable-special-heads [] [:ref :form/r]
     (form/edn-form "#{let if do fn loop recur}"))
   :default
   (def non-shadowable-special-heads '#{let if do fn loop recur}))

#?(:kotoba
   (defn str-integer-heads [] [:ref :form/r]
     (form/edn-form "#{+ - * quot mod rem inc dec count string-length string-byte-length bit-and bit-or bit-xor bit-shift-left bit-shift-right vector-count vector-at}"))
   :default
   (def str-integer-heads
     "Call heads whose value is an i64 wherever they are admitted, so `str` may
     print them without a declared type."
     '#{+ - * quot mod rem inc dec count string-length string-byte-length
        bit-and bit-or bit-xor bit-shift-left bit-shift-right
        vector-count vector-at}))

#?(:kotoba
   (defn intrinsic-helper-heads [] [:ref :form/r]
     (form/edn-form "{subvec [__kotoba_intrinsic_subvec [__kotoba_intrinsic_subvec]] string-to-utf8 [__kotoba_intrinsic_string_to_utf8 [__kotoba_intrinsic_string_to_utf8]] subvec-from [__kotoba_intrinsic_subvec_from [__kotoba_intrinsic_subvec_from]] string-code-unit-count [__kotoba_intrinsic_code_unit_count [__kotoba_intrinsic_code_unit_count]] string-code-unit-at [__kotoba_intrinsic_code_unit_at [__kotoba_intrinsic_code_unit_at]] subs [__kotoba_intrinsic_subs [__kotoba_intrinsic_code_unit_offset __kotoba_intrinsic_subs]] subs-from [__kotoba_intrinsic_subs_from [__kotoba_intrinsic_code_unit_offset __kotoba_intrinsic_subs_from]] ex-info [__kotoba_intrinsic_ex_info [__kotoba_intrinsic_ex_info]] ex-message [__kotoba_intrinsic_ex_message [__kotoba_intrinsic_ex_message]] ex-data [__kotoba_intrinsic_ex_data [__kotoba_intrinsic_ex_data]] string-parse-i64 [__kotoba_intrinsic_parse_i64 [__kotoba_intrinsic_parse_i64]] parse-long [__kotoba_intrinsic_parse_long [__kotoba_intrinsic_parse_i64 __kotoba_intrinsic_parse_long]]}"))
   :default
   (def intrinsic-helper-heads
     "Surface head -> [helper it calls, every helper definition it needs, in
     source order]."
     '{subvec [__kotoba_intrinsic_subvec [__kotoba_intrinsic_subvec]]
       string-to-utf8 [__kotoba_intrinsic_string_to_utf8 [__kotoba_intrinsic_string_to_utf8]]
       ;; not a surface head: the arity-2 half of `subvec`, recorded by the
       ;; renaming so its one helper is appended.
       subvec-from [__kotoba_intrinsic_subvec_from [__kotoba_intrinsic_subvec_from]]
       string-code-unit-count [__kotoba_intrinsic_code_unit_count [__kotoba_intrinsic_code_unit_count]]
       string-code-unit-at [__kotoba_intrinsic_code_unit_at [__kotoba_intrinsic_code_unit_at]]
       subs [__kotoba_intrinsic_subs [__kotoba_intrinsic_code_unit_offset __kotoba_intrinsic_subs]]
       ;; not a surface head: the arity-2 half of `subs`, as `subvec-from` is.
       subs-from [__kotoba_intrinsic_subs_from [__kotoba_intrinsic_code_unit_offset __kotoba_intrinsic_subs_from]]
       ex-info [__kotoba_intrinsic_ex_info [__kotoba_intrinsic_ex_info]]
       ex-message [__kotoba_intrinsic_ex_message [__kotoba_intrinsic_ex_message]]
       ex-data [__kotoba_intrinsic_ex_data [__kotoba_intrinsic_ex_data]]
       string-parse-i64 [__kotoba_intrinsic_parse_i64 [__kotoba_intrinsic_parse_i64]]
       parse-long [__kotoba_intrinsic_parse_long
                   [__kotoba_intrinsic_parse_i64 __kotoba_intrinsic_parse_long]]}))

#?(:kotoba
   (defn intrinsic-helper-order [] [:ref :form/r]
     (form/edn-form "[__kotoba_intrinsic_subvec __kotoba_intrinsic_subvec_from __kotoba_intrinsic_string_to_utf8 __kotoba_intrinsic_code_unit_count __kotoba_intrinsic_code_unit_at __kotoba_intrinsic_code_unit_offset __kotoba_intrinsic_subs __kotoba_intrinsic_subs_from __kotoba_intrinsic_ex_info __kotoba_intrinsic_ex_message __kotoba_intrinsic_ex_data __kotoba_intrinsic_parse_i64 __kotoba_intrinsic_parse_long]"))
   :default
   (def intrinsic-helper-order
     '[__kotoba_intrinsic_subvec __kotoba_intrinsic_subvec_from
       __kotoba_intrinsic_string_to_utf8
       __kotoba_intrinsic_code_unit_count __kotoba_intrinsic_code_unit_at
       __kotoba_intrinsic_code_unit_offset __kotoba_intrinsic_subs __kotoba_intrinsic_subs_from
       __kotoba_intrinsic_ex_info __kotoba_intrinsic_ex_message __kotoba_intrinsic_ex_data
       __kotoba_intrinsic_parse_i64 __kotoba_intrinsic_parse_long]))

#?(:kotoba
   (defn map-literal-value-constructors [] [:ref :form/r]
     (form/edn-form "{typed-map-new :map typed-set-new :set record-new :record hetero-vector-new :vector option-some-of :option option-none-of :option}"))
   :default
   (def map-literal-value-constructors
     "Canonical constructors that DECLARE the type of the value they build, as
     their first argument, and the descriptor head each one must produce.
   
     Every head here is a reserved name (they are unioned into `reserved-names`
     through `canonical-typed-map-operations`, `typed-set-operations`,
     `record-operations` and `heterogeneous-vector-operations`), so a user
     function cannot shadow one and make this read a descriptor off an unrelated
     call. The descriptor's own head is checked as well, so a malformed first
     argument falls through to `nil` -- unknown -- rather than becoming a map
     value type nothing validated."
     '{typed-map-new :map
       typed-set-new :set
       record-new :record
       hetero-vector-new :vector
       option-some-of :option
       option-none-of :option}))

