   (defn document-returning-heads [] [:ref :form/r]
     (form/edn-form "#{keys vals rest next first second nth assoc dissoc merge select-keys update get-in assoc-in map mapv filter filterv remove concat keep into}"))
   :default
   (def document-returning-heads
     "Heads whose answer is a `:document` when their receiver is one."
     '#{keys vals rest next first second nth assoc dissoc merge select-keys update
        get-in assoc-in map mapv filter filterv remove concat keep into}))

