#?(:kotoba
   (defn local-state-scope-heads [] [:ref :form/r]
     (form/edn-form "#{fn fn* loop recur doseq dotimes lazy-seq}"))
   :default
   (def local-state-scope-heads
     "Heads that open a scope no cell can be threaded through: the body may run
     zero times, many times, or later, so a rebinding chain cannot express it."
     '#{fn fn* loop recur doseq dotimes lazy-seq}))

#?(:kotoba
   (defn local-state-conditional-heads [] [:ref :form/r]
     (form/edn-form "#{and or if-not when-not if-let when-let if-some when-some some-> some->> cond-> cond->> condp match try catch throw assert -> ->> as->}"))
   :default
   (def local-state-conditional-heads
     "Heads whose operands are not all evaluated, or whose expansion moves them.
     Hoisting a write out of one would make it unconditional, so a write inside
     is refused rather than silently promoted."
     '#{and or if-not when-not if-let when-let if-some when-some
        some-> some->> cond-> cond->> condp match try catch throw assert
        -> ->> as->}))

#?(:kotoba
   (defn local-state-effect-heads [] [:ref :form/r]
     (form/edn-form "#{cap-call typed-cap-call assert! retract! observe! facet-enter! facet-leave!}"))
   :default
