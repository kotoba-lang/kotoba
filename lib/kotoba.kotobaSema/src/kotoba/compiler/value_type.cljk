(ns kotoba.compiler.value-type
  "The frontend's `validate-value-type!` and the predicates it needs
  (`closure-result-type?`, `callable-type?`, the structured-type shapes), as a
  Kotoba-route module over `kotoba.form`. Selfhost core rewrite S3, slice 2b
  (docs/selfhost-core-rewrite-plan-20260930.md).

  A value type is data (a keyword, or a vector headed by a keyword), so on this
  route it is a `:form/r` tree, exactly as `kotoba.compiler.validate-expr` reads
  an expression. Kotoba cannot catch, and the host's `reject!` throws, so a
  refusal is a value: `:vx/r` {ok code msg nodes}, where `nodes` is the running
  TYPE-node counter the host keeps in a volatile (`max-type-nodes`), threaded
  through the calls instead. The message and the code are the host's, byte for
  byte; the differential (scripts/selfhost-wall/vx-diff.sh) compares them.

  `closure-result-type?` is the helper the callable-type arm of
  `validate-value-type!` asks whether a parameter or result type is admitted as
  a closure RESULT type. On the host it lives in the inference layer and reads
  the dynamic `*schemas*`; here it is the `{}`-schemas call the arm makes (the
  only one this pass can make), so it needs nothing but this module's own
  descriptors: `closure-default-value-expr` is reduced to the one fact its
  callers read (`some?`), plus whether the result is TRUTHY, because the host
  reads the parametric-result and variant arms through `if-let` / `when-let`,
  where a default of `false` (the `:bool` default) counts as none."
  {:kotoba/export [outcome-ok? outcome-code outcome-msg outcome-nodes callable-type? stream-type? task-type? slice-type? schema-ref-type? linear-resource-type? validate-type closure-result-type? list-type? set-type? map-type? record-type?
                   hetero-type? option-type? variant-type? result-type? qualified-keyword?
                   record-declares-field? hetero-item-count record-field-count]}
  (:require [kotoba.form :as form])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                       [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
             :vx/r [:record :vx/r [[:ok :bool] [:code :string] [:msg :string] [:nodes :i64]]]}))

;; ---- results -------------------------------------------------------------

(defn- pass [nodes :i64] [:ref :vx/r]
  (record-new [:ref :vx/r] true "" "" nodes))

(defn- refuse [code :string msg :string nodes :i64] [:ref :vx/r]
  (record-new [:ref :vx/r] false code msg nodes))

(defn- reject [msg :string nodes :i64] [:ref :vx/r]
  (refuse "kotoba.error/subset-reject" msg nodes))

(defn- r-ok? [r [:ref :vx/r]] :bool (record-get [:ref :vx/r] r :ok))

;; the public reading of a result, for callers in other modules
(defn outcome-ok? [r [:ref :vx/r]] :bool (record-get [:ref :vx/r] r :ok))
(defn outcome-code [r [:ref :vx/r]] :string (record-get [:ref :vx/r] r :code))
(defn outcome-msg [r [:ref :vx/r]] :string (record-get [:ref :vx/r] r :msg))
(defn outcome-nodes [r [:ref :vx/r]] :i64 (record-get [:ref :vx/r] r :nodes))
(defn- r-nodes [r [:ref :vx/r]] :i64 (record-get [:ref :vx/r] r :nodes))

;; ---- shapes over forms ------------------------------------------------------

(defn- kw-name [f [:ref :form/r]] :string (keyword-name (form/keyword-value f)))

(defn- kw-is? [f [:ref :form/r] name :string] :bool
  (and (form/is-keyword? f) (string=? (kw-name f) name)))

;; a vector of exactly N elements headed by the keyword NAME
(defn- head-of? [t [:ref :form/r] name :string n :i64] :bool
  (and (form/is-vec? t) (= (form/count-of t) n) (kw-is? (form/nth-of t 0) name)))

(defn qualified-keyword? [f [:ref :form/r]] :bool
  (form/keyword-has-namespace? f))

(defn callable-type? [t [:ref :form/r]] :bool
  (and (form/is-vec? t) (>= (form/count-of t) 2) (<= (form/count-of t) 6)
       (kw-is? (form/nth-of t 0) "fn")))

(defn result-type? [t [:ref :form/r]] :bool (head-of? t "result" 3))
(defn variant-type? [t [:ref :form/r]] :bool (head-of? t "variant" 3))
(defn option-type? [t [:ref :form/r]] :bool (head-of? t "option" 2))
(defn list-type? [t [:ref :form/r]] :bool (head-of? t "list" 2))
(defn stream-type? [t [:ref :form/r]] :bool (head-of? t "stream" 2))
(defn task-type? [t [:ref :form/r]] :bool (head-of? t "task" 2))
(defn hetero-type? [t [:ref :form/r]] :bool (head-of? t "vector" 2))
(defn set-type? [t [:ref :form/r]] :bool (head-of? t "set" 2))
(defn map-type? [t [:ref :form/r]] :bool (head-of? t "map" 3))
(defn record-type? [t [:ref :form/r]] :bool (head-of? t "record" 3))
(defn slice-type? [t [:ref :form/r]] :bool (head-of? t "slice" 2))
(defn schema-ref-type? [t [:ref :form/r]] :bool
  (and (head-of? t "ref" 2) (qualified-keyword? (form/nth-of t 1))))

(defn linear-resource-type? [t [:ref :form/r]] :bool
  (or (stream-type? t) (task-type? t)))

;; `value-types`: the bare keywords a value type may be
(defn- value-type-name? [nm :string] :bool
  (or (string=? nm "i64") (string=? nm "f32") (string=? nm "f64") (string=? nm "string")
      (string=? nm "keyword") (string=? nm "symbol") (string=? nm "map") (string=? nm "bool")
      (string=? nm "bytes") (string=? nm "option-i64") (string=? nm "result-i64")
      (string=? nm "vector-i64") (string=? nm "vector-f64") (string=? nm "string-index")
      (string=? nm "disjoint-set-i64") (string=? nm "document")))

;; `closure-flat-result-types`
(defn- flat-result-name? [nm :string] :bool
  (or (string=? nm "i64") (string=? nm "bool") (string=? nm "f32") (string=? nm "f64")
      (string=? nm "string") (string=? nm "bytes") (string=? nm "vector-i64")
      (string=? nm "vector-f64") (string=? nm "document")))

(defn- floating-kw? [f [:ref :form/r]] :bool
  (or (kw-is? f "f32") (kw-is? f "f64")))

;; fields / cases: a vector of [keyword X] pairs, unique by keyword, 1..LIMIT entries
(defn- pairs-unique? [xs [:ref :form/r]] :bool
  (let [n (form/count-of xs)]
    (loop [i 0]
      (if (>= i n)
        true
        (if (loop [j (+ i 1)]
              (if (>= j n)
                false
                (if (form/eq (form/nth-of (form/nth-of xs i) 0) (form/nth-of (form/nth-of xs j) 0)) true (recur (+ j 1)))))
          false
          (recur (+ i 1)))))))

(defn- pairs-shaped? [xs [:ref :form/r]] :bool
  (let [n (form/count-of xs)]
    (loop [i 0]
      (if (>= i n)
        true
        (let [p (form/nth-of xs i)]
          (if (and (form/is-vec? p) (= (form/count-of p) 2) (form/is-keyword? (form/nth-of p 0)))
            (recur (+ i 1))
            false))))))

(defn- pairs-ok? [xs [:ref :form/r] limit :i64] :bool
  (and (form/is-vec? xs) (> (form/count-of xs) 0) (<= (form/count-of xs) limit)
       (pairs-shaped? xs) (pairs-unique? xs)))

;; is FIELD one of the record TYPE's declared field names (the host's
;; `(first-truthy #{field} (map first fields))`)
(defn record-declares-field? [t [:ref :form/r] field [:ref :form/r]] :bool
  (let [fields (form/nth-of t 2)
        n (form/count-of fields)]
    (and (form/is-keyword? field)
         (loop [i 0]
           (if (>= i n)
             false
             (if (form/eq (form/nth-of (form/nth-of fields i) 0) field) true (recur (+ i 1))))))))

(defn hetero-item-count [t [:ref :form/r]] :i64 (form/count-of (form/nth-of t 1)))
(defn record-field-count [t [:ref :form/r]] :i64 (form/count-of (form/nth-of t 2)))

;; ---- closure-result-type? -----------------------------------------------------
;;
;; The host asks `(some? (closure-default-value-expr type))`. KIND 0 is nil (no
;; inhabitant), 1 is an inhabitant that is FALSE (the `:bool` default), 2 is a
;; truthy one. `if-let` / `when-let` (parametric results, variants) need 2;
;; `every? some?` (records, heterogeneous vectors) and the final `some?` need >0.

(defn- all-inhabited? [xs [:ref :form/r] second? :bool] :bool
  (let [n (form/count-of xs)]
    (loop [i 0]
      (if (>= i n)
        true
        (let [x (form/nth-of xs i)
              t (if second? (form/nth-of x 1) x)]
          (if (> (default-kind t) 0) (recur (+ i 1)) false))))))

(defn- any-truthy-case? [cases [:ref :form/r]] :bool
  (let [n (form/count-of cases)]
    (loop [i 0]
      (if (>= i n)
        false
        (if (= (default-kind (form/nth-of (form/nth-of cases i) 1)) 2) true (recur (+ i 1)))))))

(defn- default-kind [t [:ref :form/r]] :i64
  (cond
    (form/is-keyword? t)
    (if (kw-is? t "bool") 1 (if (value-type-name? (kw-name t)) 2 0))
    (option-type? t) 2
    (list-type? t) 2
    (set-type? t) 2
    (map-type? t) 2
    (result-type? t)
    (if (or (= (default-kind (form/nth-of t 1)) 2) (= (default-kind (form/nth-of t 2)) 2)) 2 0)
    (hetero-type? t) (if (all-inhabited? (form/nth-of t 1) false) 2 0)
    (variant-type? t) (if (any-truthy-case? (form/nth-of t 2)) 2 0)
    (record-type? t) (if (all-inhabited? (form/nth-of t 2) true) 2 0)
    :else 0))

(defn closure-result-type? [t [:ref :form/r]] :bool
  (and (r-ok? (validate-type t 0 0))
       (or (and (form/is-keyword? t) (flat-result-name? (kw-name t)))
           (and (or (record-type? t) (option-type? t) (result-type? t) (variant-type? t)
                    (list-type? t) (hetero-type? t) (set-type? t) (map-type? t))
                (> (default-kind t) 0)))))

;; ---- validate-value-type! -----------------------------------------------------

;; validate every type in XS from index I at DEPTH, in order, stopping at the first refusal
(defn- vt-each [xs [:ref :form/r] i :i64 depth :i64 nodes :i64 pairs? :bool] [:ref :vx/r]
  (let [len (form/count-of xs)]
    (loop [j i n nodes]
      (if (>= j len)
        (pass n)
        (let [x (form/nth-of xs j)
              r (validate-type (if pairs? (form/nth-of x 1) x) depth n)]
          (if (r-ok? r) (recur (+ j 1) (r-nodes r)) r))))))

;; the node accounting of a record / variant: 2 + 2 per entry, then the limit
(defn- charge-entries [xs [:ref :form/r] nodes :i64] :i64
  (+ nodes (+ 2 (* 2 (form/count-of xs)))))

(defn- node-limit [n :i64] [:ref :vx/r]
  (refuse "kotoba.error/value-type-node-limit" "value type exceeds node limit" n))

(defn- vt-slice [t [:ref :form/r] n :i64] [:ref :vx/r]
  (let [element (form/nth-of t 1)]
    (cond
      (kw-is? element "f32")
      (reject-with "kotoba.error/slice-element-not-admitted"
                   "slice element type is declared but not admitted: no native element load exists for :f32" n)
      (not (and (form/is-keyword? element)
                (or (kw-is? element "u8") (kw-is? element "u16") (kw-is? element "u32") (kw-is? element "u64"))))
      (reject-with "kotoba.error/slice-element-type"
                   "slice element type must be one of [:u16 :u32 :u64 :u8]" n)
      :else (pass n))))

(defn- reject-with [code :string msg :string n :i64] [:ref :vx/r]
  (refuse code msg n))

(defn- vt-callable-params [params [:ref :form/r] i :i64 t [:ref :form/r] depth :i64 nodes :i64] [:ref :vx/r]
  (if (>= i (form/count-of params))
    (pass nodes)
    (let [p (form/nth-of params i)]
      (if (or (callable-type? p) (linear-resource-type? p))
        (reject-with "kotoba.error/callable-parameter-type"
                     "callable parameter types cannot be callable or linear resources" nodes)
        (let [r (validate-type p (+ depth 1) nodes)]
          (if (not (r-ok? r))
            r
            (if (or (schema-ref-type? p) (closure-result-type? p))
              (vt-callable-params params (+ i 1) t depth (r-nodes r))
              (reject-with "kotoba.error/callable-parameter-type"
                           "callable parameter type is outside the admitted dispatcher profile (a parameter type is admitted exactly when it is admitted as a closure result type)"
                           (r-nodes r)))))))))

(defn- vt-callable-result [res [:ref :form/r] depth :i64 nodes :i64] [:ref :vx/r]
  (if (or (callable-type? res) (linear-resource-type? res))
    (reject-with "kotoba.error/callable-result-type"
                 "callable results cannot be callable or linear resources" nodes)
    (let [r (validate-type res (+ depth 1) nodes)]
      (if (not (r-ok? r))
        r
        (if (or (schema-ref-type? res) (closure-result-type? res))
          r
          (reject-with "kotoba.error/callable-result-type"
                       "callable result type is outside the admitted dispatcher profile" (r-nodes r)))))))

(defn- clause-shaped? [c [:ref :form/r]] :bool
  (and (form/is-vec? c) (= (form/count-of c) 2)
       (form/is-vec? (form/nth-of c 0))
       (<= (form/count-of (form/nth-of c 0)) 4)))

(defn- clauses-ok? [t [:ref :form/r]] :bool
  (let [n (form/count-of t)]
    (and (loop [i 1]
           (if (>= i n)
             true
             (if (clause-shaped? (form/nth-of t i)) (recur (+ i 1)) false)))
         (loop [i 1]
           (if (>= i n)
             true
             (if (loop [j (+ i 1)]
                   (if (>= j n)
                     false
                     (if (= (form/count-of (form/nth-of (form/nth-of t i) 0))
                            (form/count-of (form/nth-of (form/nth-of t j) 0)))
                       true
                       (recur (+ j 1)))))
               false
               (recur (+ i 1))))))))

(defn- vt-clauses [t [:ref :form/r] i :i64 depth :i64 nodes :i64] [:ref :vx/r]
  (if (>= i (form/count-of t))
    (pass nodes)
    (let [clause (form/nth-of t i)
          rp (vt-callable-params (form/nth-of clause 0) 0 t depth nodes)]
      (if (not (r-ok? rp))
        rp
        (let [rr (vt-callable-result (form/nth-of clause 1) depth (r-nodes rp))]
          (if (r-ok? rr)
            (vt-clauses t (+ i 1) depth (r-nodes rr))
            rr))))))

(defn- vt-callable [t [:ref :form/r] depth :i64 n :i64] [:ref :vx/r]
  (if (clauses-ok? t)
    (vt-clauses t 1 depth n)
    (reject-with "kotoba.error/callable-type"
                 "callable type requires one to five unique [parameter-types result-type] clauses" n)))

(defn- vt-one [t [:ref :form/r] depth :i64 n :i64] [:ref :vx/r]
  (validate-type (form/nth-of t 1) (+ depth 1) n))

(defn- vt-hetero [t [:ref :form/r] depth :i64 n :i64] [:ref :vx/r]
  (let [items (form/nth-of t 1)]
    (if (not (and (form/is-vec? items) (<= (form/count-of items) 32)))
      (reject-with "kotoba.error/hetero-vector-type" "heterogeneous vector types must be a bounded vector" n)
      (if (> (+ n 1) 512)
        (node-limit (+ n 1))
        (vt-each items 0 (+ depth 1) (+ n 1) false)))))

(defn- vt-map [t [:ref :form/r] depth :i64 n :i64] [:ref :vx/r]
  (cond
    (floating-kw? (form/nth-of t 1))
    (reject-with "kotoba.error/floating-map-kv"
                 (str "map key type :" (kw-name (form/nth-of t 1))
                      " has no portable key identity: NaN compares unequal to itself, and +0.0 and -0.0 are equal while differing in bits, so neither the entry order nor duplicate-key detection is decidable")
                 n)
    (floating-kw? (form/nth-of t 2))
    (reject-with "kotoba.error/floating-map-kv"
                 (str "map value type :" (kw-name (form/nth-of t 2)) " is outside the structured scalar ABI")
                 n)
    :else
    (let [rk (validate-type (form/nth-of t 1) (+ depth 1) n)]
      (if (r-ok? rk)
        (validate-type (form/nth-of t 2) (+ depth 1) (r-nodes rk))
        rk))))

;; record (limit 32) and variant (limit 32): id, entries, node charge, then each entry's type
(defn- vt-entries [t [:ref :form/r] depth :i64 n :i64 id-msg :string id-code :string
                   entries-msg :string entries-code :string] [:ref :vx/r]
  (let [xs (form/nth-of t 2)]
    (cond
      (not (qualified-keyword? (form/nth-of t 1))) (reject-with id-code id-msg n)
      (not (pairs-ok? xs 32)) (reject-with entries-code entries-msg n)
      :else
      (let [m (charge-entries xs n)]
        (if (> m 512)
          (node-limit m)
          (vt-each xs 0 (+ depth 1) m true))))))

(defn validate-type [t [:ref :form/r] depth :i64 nodes :i64] [:ref :vx/r]
  (let [n (+ nodes 1)]
    (cond
      (> n 512) (node-limit n)
      (> depth 64) (refuse "kotoba.error/value-type-depth-limit" "value type exceeds depth limit" n)
      (callable-type? t) (vt-callable t depth n)
      (and (form/is-keyword? t) (value-type-name? (kw-name t))) (pass n)
      (schema-ref-type? t) (pass n)
      (slice-type? t) (vt-slice t n)
      (result-type? t)
      (let [r (validate-type (form/nth-of t 1) (+ depth 1) n)]
        (if (r-ok? r) (validate-type (form/nth-of t 2) (+ depth 1) (r-nodes r)) r))
      (option-type? t) (vt-one t depth n)
      (list-type? t) (vt-one t depth n)
      (stream-type? t)
      (if (kw-is? (form/nth-of t 1) "bytes")
        (vt-one t depth n)
        (reject "stream payload must be bytes" n))
      (task-type? t)
      (if (stream-type? (form/nth-of t 1))
        (vt-one t depth n)
        (reject "task payload must be a stream resource" n))
      (hetero-type? t) (vt-hetero t depth n)
      (set-type? t)
      (if (floating-kw? (form/nth-of t 1))
        (reject-with "kotoba.error/floating-set-item"
                     "direct floating set items are outside the structured scalar ABI" n)
        (vt-one t depth n))
      (map-type? t) (vt-map t depth n)
      (record-type? t)
      (vt-entries t depth n "record type id must be a qualified keyword" "kotoba.error/record-type-id"
                  "record fields must be a non-empty unique bounded vector" "kotoba.error/record-fields")
      (variant-type? t)
      (vt-entries t depth n "variant type id must be a qualified keyword" "kotoba.error/variant-type-id"
                  "variant cases must be a non-empty unique bounded vector" "kotoba.error/variant-cases")
      :else (reject-with "kotoba.error/value-type-outside-profile" "value type is outside the safe profile" n))))
