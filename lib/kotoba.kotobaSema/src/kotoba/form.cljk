#?(:kotoba (defn is-map? [f [:ref :form/r]] :bool (form-is-map? f)))
#?(:kotoba (defn is-true? [f [:ref :form/r]] :bool (form-is-true? f)))
#?(:kotoba (defn count-of [f [:ref :form/r]] :i64 (form-count-of f)))
