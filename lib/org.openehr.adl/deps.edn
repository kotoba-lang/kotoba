;; No dependencies. ADL is a textual grammar over strings; a leaf that
;; dragged in an XML/YAML/JSON library or an RM-object framework would
;; defeat the point, which is that this workspace can hold a real openEHR
;; archetype parser without also holding a Java/Ruby/Python archetype
;; toolchain behind it.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
