;; Port of murakumo.artifact-protocol (artifact_protocol.cljk), Kotoba-native.
;; Named divergences:
;;   - version, operations and release-actions are defs in the source. A def
;;     cannot be exported (E2005), so they are zero-argument fns; the two sets
;;     are :document sets of keywords.
;;   - messages are :document maps. An absent key reads as null (the source
;;     reads nil). (= a b) on two values compares their canonical EDN text,
;;     since document equality is not a builtin.
;;   - request: fields that are not a map leave the base message unchanged.
(ns murakumo.artifact-protocol
  (:export [version operations release-actions request valid-request?
            response valid-response?]))

(defn version [] :i64 1)

(defn operations [] :document
  (document-set (document-keyword :begin) (document-keyword :chunk)
                (document-keyword :commit) (document-keyword :abort)))

(defn release-actions [] :document
  (document-set (document-keyword :deploy) (document-keyword :rollback)))

(defn- gv [m :document k :keyword] :document
  (option-value-of [:option :document] (document-get m k) (document-null)))

(defn- is-map [d :document] :bool
  (= (document-kind d) :map))

(defn- is-string [d :document] :bool
  (= (document-kind d) :string))

(defn- is-version [d :document] :bool
  (and (= (document-kind d) :i64)
       (= (option-value-of [:option :i64] (document-i64-value d) 0) (version))))

(defn- is-keyword-of [d :document k :keyword] :bool
  (and (= (document-kind d) :keyword)
       (= (option-value-of [:option :keyword] (document-keyword-value d) :none) k)))

(defn- doc-equal [a :document b :document] :bool
  (string=? (document-edn-print a) (document-edn-print b)))

(defn request [operation :document fields :document] :document
  (let [base (document-map :murakumo.artifact/version (document-i64 (version))
                           :murakumo.artifact/type (document-keyword :request)
                           :murakumo.artifact/operation operation)]
    (if (= (document-kind fields) :map)
      (document-merge base fields)
      base)))

(defn- request-core? [m :document] :bool
  (and (is-version (gv m :murakumo.artifact/version))
       (is-keyword-of (gv m :murakumo.artifact/type) :request)
       (document-set-contains? (operations) (gv m :murakumo.artifact/operation))
       (document-set-contains? (release-actions) (gv m :murakumo.artifact/release-action))
       (is-map (gv m :murakumo.artifact/issued-capability))))

(defn- request-strings? [m :document] :bool
  (and (is-string (gv m :murakumo.artifact/node))
       (is-string (gv m :murakumo.artifact/bundle-cid))
       (is-string (gv m :murakumo.artifact/revision))
       (is-string (gv m :murakumo.artifact/environment))
       (is-string (gv m :murakumo.artifact/verdict-cid))
       (is-string (gv m :murakumo.artifact/transfer-id))
       (is-string (gv m :murakumo.artifact/object-cid))))

(defn valid-request? [m :document] :bool
  (and (is-map m)
       (request-core? m)
       (request-strings? m)))

(defn response [operation :document node :document result :document] :document
  (document-map :murakumo.artifact/version (document-i64 (version))
                :murakumo.artifact/type (document-keyword :response)
                :murakumo.artifact/operation operation
                :murakumo.artifact/node node
                :murakumo.artifact/result result))

(defn valid-response? [m :document operation :document node :document] :bool
  (and (is-map m)
       (is-version (gv m :murakumo.artifact/version))
       (is-keyword-of (gv m :murakumo.artifact/type) :response)
       (doc-equal (gv m :murakumo.artifact/operation) operation)
       (doc-equal (gv m :murakumo.artifact/node) node)
       (= (document-kind (gv (gv m :murakumo.artifact/result) :ok?)) :bool)))
