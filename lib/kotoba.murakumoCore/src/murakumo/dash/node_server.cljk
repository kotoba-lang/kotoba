(ns murakumo.dash.node-server
  "Node host adapter (kbb engine) for the dashboard's HTTP server.

  Contract split, by design: `kotoba.lang.http.host.node` is OUTBOUND-only
  (its ns docstring says so), and `kotoba.lang.http.host.httpkit` is :clj-only
  (`org.httpkit.server`). The dashboard's documented entry `kbb -M:dash` needs
  a *serving* host on the SCI-on-node runtime, so this is the injected host for
  that route only: ring handler fn -> node:http server. It is not a general
  HTTP library — request maps carry the keys murakumo.dash's handler reads
  (:uri, :query-string), responses are the ring maps murakumo.dash.state builds
  ({:status :headers :body}). Added 2026-10-25 so the documented command runs."
  (:require ["node:http" :as node-http]))

(defn run-server
  "Start a node:http server for ring `handler` with {:port port}. Mirrors
  org.httpkit.server/run-server's (handler opts) call shape and returns a
  zero-argument stop fn."
  [handler {:keys [port]}]
  (let [server
        (.createServer
         node-http
         (fn [req res]
           (let [url (.-url req)
                 qi (let [i (.indexOf url "?")] (if (>= i 0) (subs url (inc i)) nil))
                 uri (let [i (.indexOf url "?")] (if (>= i 0) (subs url 0 i) url))
                 ring-req {:uri uri :query-string qi :request-method :get}
                 resp (try
                        (handler ring-req)
                        (catch :default e
                          {:status 500
                           :headers {"content-type" "text/plain"}
                           :body (str "dashboard handler error: " (.-message e))}))]
             (.writeHead res
                         (or (:status resp 200))
                         (clj->js (into {} (map (fn [[k v]] [(name k) (str v)]))
                                        (:headers resp))))
             (.end res (str (:body resp ""))))))]
    (.listen server (or port 8899))
    (fn [] (.close server))))
