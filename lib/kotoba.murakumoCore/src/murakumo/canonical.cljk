(ns murakumo.canonical
  "Deterministic EDN encoding for content identities and signatures."
  (:require [kotoba.bytes :as kbytes]))

(defn value [x]
  (cond
    (map? x) (into (sorted-map) (map (fn [[k v]] [k (value v)])) x)
    (set? x) (vec (sort-by pr-str (map value x)))
    (sequential? x) (mapv value x)
    :else x))

(defn string [x]
  #?(:clj
     (binding [*print-namespace-maps* false
               *print-length* nil
               *print-level* nil
               *print-meta* false
               *print-readably* true]
       (pr-str (value x)))
     :cljs
     (binding [*print-namespace-maps* false
               *print-length* nil
               *print-level* nil
               *print-meta* false]
       (pr-str (value x)))))

(defn encode-bytes [x]
  #?(:clj (kbytes/utf8-bytes (string x))
     ;; kbb represents byte[] as a signed Int8Array; same UTF-8 bytes as the JVM.
     :cljs (let [u8 (.encode (js/TextEncoder.) (string x))]
             (js/Int8Array. (.-buffer u8) (.-byteOffset u8) (.-byteLength u8)))))
