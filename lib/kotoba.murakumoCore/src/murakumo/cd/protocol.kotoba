;; Port of murakumo.cd.protocol (protocol.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from protocol.cljk:
;;   - `version` and `actions` are zero-arg functions (def cannot be exported).
;;   - `valid-request?` / `valid-response?` compare fields with document-equal?
;;     against the expected typed value, so an i64 version never equals a
;;     non-i64 one; `string?`/`map?`/`boolean?` tests use the document kinds.

(ns murakumo.cd.protocol
  (:export [version actions request valid-request? response valid-response?]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- string-doc? [d :document] :bool
  (option-some?-of [:option :string] (document-string-value d)))

(defn- i64-doc-is? [d :document n :i64] :bool
  (document-equal? d (document-i64 n)))

(defn version [] :i64
  1)

(defn actions [] :document
  (document-set (document-keyword :deploy)
                (document-keyword :health)
                (document-keyword :rollback)))

(defn request [action :document node :document issued-capability :document artifact-cid :document environment :document verdict-cid :document revision :document] :document
  (document-map :murakumo.cd/version (document-i64 (version))
                :murakumo.cd/type (document-keyword :request)
                :murakumo.cd/action action
                :murakumo.cd/node node
                :murakumo.cd/issued-capability issued-capability
                :murakumo.cd/artifact-cid artifact-cid
                :murakumo.cd/environment environment
                :murakumo.cd/verdict-cid verdict-cid
                :murakumo.cd/revision revision))

(defn valid-request? [m :document] :bool
  (and (map? m)
       (i64-doc-is? (field m :murakumo.cd/version) (version))
       (document-equal? (field m :murakumo.cd/type) (document-keyword :request))
       (document-set-contains? (actions) (field m :murakumo.cd/action))
       (string-doc? (field m :murakumo.cd/node))
       (map? (field m :murakumo.cd/issued-capability))
       (string-doc? (field m :murakumo.cd/artifact-cid))
       (string-doc? (field m :murakumo.cd/environment))
       (string-doc? (field m :murakumo.cd/verdict-cid))
       (string-doc? (field m :murakumo.cd/revision))))

(defn response [action :document node :document result :document] :document
  (document-map :murakumo.cd/version (document-i64 (version))
                :murakumo.cd/type (document-keyword :response)
                :murakumo.cd/action action
                :murakumo.cd/node node
                :murakumo.cd/result result))

(defn valid-response? [m :document action :document node :document] :bool
  (and (map? m)
       (i64-doc-is? (field m :murakumo.cd/version) (version))
       (document-equal? (field m :murakumo.cd/type) (document-keyword :response))
       (document-equal? (field m :murakumo.cd/action) action)
       (document-equal? (field m :murakumo.cd/node) node)
       (map? (field m :murakumo.cd/result))
       (option-some?-of [:option :bool]
                        (document-bool-value (field (field m :murakumo.cd/result) :ok?)))))
