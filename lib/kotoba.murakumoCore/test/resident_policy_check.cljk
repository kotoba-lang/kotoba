(require '[murakumo.infer.resident :as r])
(def lane {:ready true :group "gpu"})
(def a (r/admit {:groups {} :jobs {}} lane "job-one" "digest" 0 100))
(assert (= 200 (:status a)))
(assert (= 429 (:status (r/admit (:state a) lane "job-two" "other" 0 100))))
(assert (= 409 (:status (r/admit (:state a) lane "job-one" "digest" 0 100))))
(assert (= 422 (:status (r/admit (:state a) lane "job-one" "changed" 0 100))))
(assert (empty? (:groups (r/finish (:state a) "job-one" :failed))))
(assert (not (r/heal-eligible? {:ready false :failures 2 :restart-argv ["true"]} 2000000)))
(assert (r/heal-eligible? {:ready false :failures 3 :restart-argv ["true"]} 2000000))
(assert (not (r/heal-eligible? {:ready false :failures 3 :restart-argv ["true"] :last-heal 1999999} 2000000)))
(assert (not (r/valid-output-budget? {:max_tokens -100})))
(assert (not (r/valid-output-budget? {:max_tokens "999"})))
(def vision {:max-image-tokens 1024 :max-images 1 :context 4096 :model "vision"})
(def image-body {:model "vision" :messages [{:role "user" :content [{:type "image_url" :image_url {:url (str "data:image/png;base64," (apply str (repeat 400000 "A")))}}]}]})
(assert (< (r/request-input-tokens vision image-body 400200) 1600))
(assert (nil? (r/request-input-tokens {} image-body 400200)))
(assert (nil? (r/request-input-tokens vision (assoc-in image-body [:messages 0 :content 0 :image_url :url] "https://example.com/private.png") 200)))
(assert (nil? (r/request-input-tokens vision (update-in image-body [:messages 0 :content] #(vec (concat % %))) 800400)))
(assert (= 1234 (r/request-input-tokens vision {:messages [{:content "text"}]} 1234)))
(assert (not (r/eligible? vision {:model "vision" :input-tokens nil :max-tokens 32})))
(println :policy-tests-passed)
