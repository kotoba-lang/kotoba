(ns image-worker-receipt-test
  (:require [murakumo.infer.image-worker :as w] ["node:assert/strict" :as a]))
(let [original (.-fetch js/globalThis)
      cfg {:base "https://image-receipt.test" :token "fixture" :name "jacob-qwen-image21-metal"}
      claim {:id "11111111-1111-4111-8111-111111111111" :attempt 1 :lease-token "fixture-fence" :deadline (+ (js/Date.now) 60000)}
      lost (atom false) uploads (atom 0) receipts (atom 0)
      reply (fn [status body] (js/Promise.resolve (js/Response. (js/JSON.stringify (clj->js body)) #js {:status status})))]
  (set! (.-fetch js/globalThis)
        (fn [url opts]
          (let [body (js->clj (js/JSON.parse (.-body opts)) :keywordize-keys true)]
            (a/equal (:worker body) (:name cfg)) (a/equal (:attempt body) 1) (a/equal (:lease-token body) "fixture-fence")
            (if (.endsWith url "/done")
              (do (swap! uploads inc) (reset! lost true) (js/Promise.reject (js/Error. "Reply lost after commit")))
              (do (swap! receipts inc) (reply 200 {:accepted true}))))))
  (-> (w/acknowledge! cfg claim "fixture-image" lost)
      (.then (fn [r]
               (a/equal (:status r) 200) (a/equal @uploads 1) (a/equal @receipts 1)
               ;; An unknown receipt cannot authorize stale work, even with a200.
               (set! (.-fetch js/globalThis) (fn [_ _] (reply 200 {:accepted false})))
               (-> (w/acknowledge! cfg claim "fixture-image" lost)
                   (.then (fn [_] (throw (js/Error. "Unknown receipt accepted stale work"))))
                   (.catch (fn [e] (a/match (.-message e) #"lease expired"))))))
      (.then (fn [_]
               (reset! lost false) (reset! uploads 0) (reset! receipts 0)
               (set! (.-fetch js/globalThis)
                     (fn [url _]
                       (if (.endsWith url "/done")
                         (if (= 1 (swap! uploads inc)) (js/Promise.reject (js/Error. "No commit")) (reply 200 {:accepted true}))
                         (do (swap! receipts inc) (reply 202 {:accepted false})))))
               (w/acknowledge! cfg claim "fixture-image" lost)))
      (.then (fn [r] (a/equal (:status r) 200) (a/equal @uploads 2) (a/equal @receipts 1)
               (println "Commit receipt: lost reply confirmed, stale work refused, pending upload retried.")))
      (.catch (fn [e] (println (.-message e)) (set! (.-exitCode js/process) 1)))
      (.finally #(set! (.-fetch js/globalThis) original))))
