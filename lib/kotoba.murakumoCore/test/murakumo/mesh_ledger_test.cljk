(ns murakumo.mesh-ledger-test
  (:require [kotoba.test :refer [deftest is]]
            [murakumo.mesh.ledger :as ledger]))

(def did-a "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK")
(def did-b "did:key:z6MknGc3ocHs3zdPiJbnaaqDi58NGb4pk1Sp9WxWufuXSdxf")

(defn- node [did status & {:as extra}] (merge {:id "x" :did did :status status} extra))

(deftest parse-accepts-a-good-ledger-and-refuses-everything-else
  (is (= {:admit :auto-on-mesh :nodes {"a" {:status "authorized"}}}
         (:ledger (ledger/parse "{:admit :auto-on-mesh :nodes {\"a\" {:status \"authorized\"}}}"))))
  (is (= {:nodes {}} (:ledger (ledger/parse "{}"))))
  (doseq [bad ["" "{" "[]" "{:nodes []}" "{:nodes {\"a\" {:status \"bogus\"}}}" "{:nodes {a {:status \"authorized\"}}}" "nil"]]
    (is (:error (ledger/parse bad)) (pr-str bad))))

(deftest serialize-round-trips
  (let [l {:admit :auto-on-mesh :nodes {"a" (node did-a "authorized" :address "10.77.0.2")}}]
    (is (= l (:ledger (ledger/parse (ledger/serialize l)))))))

(deftest revoke-by-name-or-did-records-when
  (let [l {:nodes {"a" (node did-a "authorized")}}
        r1 (ledger/revoke l "a" {:now-ms 5 :reason "lost"})
        r2 (ledger/revoke l did-a {:now-ms 5})]
    (is (= ["a"] (:revoked r1)))
    (is (= "revoked" (get-in r1 [:ledger :nodes "a" :status])))
    (is (= 5 (get-in r1 [:ledger :nodes "a" :revoked-ms])))
    (is (= "lost" (get-in r1 [:ledger :nodes "a" :revoked-reason])))
    (is (= ["a"] (:revoked r2)))))

(deftest revoke-reports-unknown-and-repeat
  (let [l {:nodes {"a" (node did-a "revoked")}}]
    (is (= :not-found (:error (ledger/revoke l "zzz" {:now-ms 1}))))
    (is (= :already-revoked (:error (ledger/revoke l "a" {:now-ms 1}))))))

(deftest sync-adds-what-the-seed-admitted
  (let [local {:admit :auto-on-mesh :nodes {"old" (node did-a "authorized")}}
        remote {:nodes {"new" (node did-b "authorized" :address "10.77.0.2")}}
        {:keys [local report]} (ledger/sync-plan local remote)]
    (is (= ["new"] (:added report)))
    (is (= 2 (count (:nodes local))))
    (is (= :auto-on-mesh (:admit local)))))

(deftest the-seeds-admit-flag-is-never-imported
  (let [{:keys [local]} (ledger/sync-plan {:nodes {}} {:admit :auto-on-mesh :nodes {}})]
    (is (not (contains? local :admit)))))

(deftest a-local-revocation-wins-over-the-seed-and-is-pushed-to-it
  (let [local {:nodes {"a" (node did-a "revoked")}}
        remote {:nodes {"a" (node did-a "authorized")}}
        {:keys [local remote report]} (ledger/sync-plan local remote)]
    (is (= "revoked" (get-in local [:nodes "a" :status])))
    (is (= "revoked" (get-in remote [:nodes "a" :status])))
    (is (= ["a"] (:revoked-on-seed report)))))

(deftest a-seed-revocation-reaches-the-operator
  (let [{:keys [local report]} (ledger/sync-plan {:nodes {"a" (node did-a "authorized")}}
                                                 {:nodes {"a" (node did-a "revoked")}})]
    (is (= "revoked" (get-in local [:nodes "a" :status])))
    (is (= ["a"] (:updated report)))))

(deftest revoked-is-never-undone-by-a-sync
  (let [{:keys [local report]} (ledger/sync-plan {:nodes {"a" (node did-a "revoked")}}
                                                 {:nodes {"a" (node did-a "pending")}})]
    (is (= "revoked" (get-in local [:nodes "a" :status])))))

(deftest a-revoked-did-is-revoked-on-the-seed-even-under-another-name
  (let [{:keys [remote]} (ledger/sync-plan {:nodes {"a" (node did-a "revoked")}}
                                           {:nodes {"renamed" (node did-a "authorized")}})]
    (is (= "revoked" (get-in remote [:nodes "renamed" :status])))))

(deftest a-key-change_on_an_authorized_name_is_a_conflict_not_a_merge
  (let [{:keys [local report]} (ledger/sync-plan {:nodes {"a" (node did-a "authorized")}}
                                                 {:nodes {"a" (node did-b "authorized")}})]
    (is (= ["a"] (:conflicts report)))
    (is (= did-a (get-in local [:nodes "a" :did])))))

(deftest sync-is-idempotent
  (let [local {:nodes {"a" (node did-a "authorized")}}
        remote {:nodes {"b" (node did-b "authorized" :address "10.77.0.2")}}
        once (ledger/sync-plan local remote)
        twice (ledger/sync-plan (:local once) (:remote once))]
    (is (ledger/changed? (:report once)))
    (is (not (ledger/changed? (:report twice))))
    (is (= (:local once) (:local twice)))))
