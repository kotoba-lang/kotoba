(ns murakumo.infer.topology-quorum-test
  "ADR-2610071730 P5b: k-of-n operator signatures on the signed topology. Offline."
  (:require [cljs.test :refer [deftest is testing run-tests]]
            [murakumo.infer.replicated-topology :as topo]
            ["node:crypto" :as crypto] ["node:fs" :as fs] ["node:os" :as os] ["node:path" :as path]))

(defn- kp [] (let [k (.generateKeyPairSync crypto "ed25519")]
               {:pub (.export (.-publicKey k) #js {:type "spki" :format "pem"})
                :priv (.export (.-privateKey k) #js {:type "pkcs8" :format "pem"})}))
(def k1 (kp)) (def k2 (kp)) (def k3 (kp))
(def payload {:schema 1 :revision 3
              :nodes [{:node "n0" :url "http://100.64.0.1:8796" :enabled true :owner-id "00000000-0000-0000-0000-000000000000" :roles []}]
              :gateways [{:node "g" :url "http://100.64.0.2:8797" :enabled true}]
              :policies {:minimum-replicas {:mishima 1}}})
(defn- sig [k] (.toString (.sign crypto nil (js/Buffer.from (topo/encoded payload)) (:priv k)) "base64url"))
(def trust {:keys {"a" (:pub k1) "b" (:pub k2) "c" (:pub k3)} :threshold 2})

(deftest quorum
  (is (thrown? js/Error (topo/verify! {:payload payload :signatures [{:key "a" :signature (sig k1)}]} trust false))
      "one key is not enough")
  (is (some? (topo/verify! {:payload payload :signatures [{:key "a" :signature (sig k1)} {:key "c" :signature (sig k3)}]} trust false)))
  (is (thrown? js/Error (topo/verify! {:payload payload :signatures [{:key "a" :signature (sig k1)} {:key "a" :signature (sig k1)}]} trust false))
      "the same key twice counts once")
  (is (thrown? js/Error (topo/verify! {:payload payload :signatures [{:key "a" :signature (sig k1)} {:key "b" :signature (sig k3)}]} trust false))
      "a signature under the wrong key id does not count")
  (is (some? (topo/verify! {:payload payload :signature (sig k2) :signatures [{:key "a" :signature (sig k1)}]} trust false))
      "a legacy single signature counts for the key it verifies against")
  (testing "the historical single key still works"
    (is (some? (topo/verify! {:payload payload :signature (sig k1)} (:pub k1) false)))
    (is (thrown? js/Error (topo/verify! {:payload payload :signature (sig k2)} (:pub k1) false)))))

(deftest quorum-keys-are-distinct
  (let [d (.mkdtempSync fs (.join path (.tmpdir os) "quorum-keys-"))
        f (fn [n k] (let [p (.join path d n)] (.writeFileSync fs p (:pub k)) p))
        a (f "a.pem" k1) b (f "b.pem" k2) a2 (f "a2.pem" k1)]
    (is (= 2 (:threshold (topo/trust-of {:topology-public-keys {:a a :b b} :topology-threshold 2}))))
    (is (thrown? js/Error (topo/trust-of {:topology-public-keys {:a a :b a2} :topology-threshold 2}))
        "one key under two ids would count twice")
    (.rmSync fs d #js {:recursive true :force true})))

(defmethod cljs.test/report [:cljs.test/default :end-run-tests] [m]
  (when-not (cljs.test/successful? m) (set! (.-exitCode js/process) 1)))

(run-tests)
