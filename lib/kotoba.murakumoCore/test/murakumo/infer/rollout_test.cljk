(ns murakumo.infer.rollout-test
  "ADR-2610071730 P5a: the wave gate. Offline."
  (:require [cljs.test :refer [deftest is testing run-tests]]
            [murakumo.infer.rollout :as r]))

(def target (apply str (repeat 64 "a")))
(def old (apply str (repeat 64 "b")))
(def now 100000000)
(def intent {"agents" {"resident" {"sha256" target "waves" [["n0"] ["n1" "n2"]] "settle-ms" 1000}}})
(defn- doc [& {:as m}] (merge {"at" (- now 1000) "release" (subs target 0 16) "lanes" {"t" {"ready" true}} "started-at" (- now 5000)} m))

(deftest decisions
  (is (= :none (:state (r/decide {} "n0" old nil {} now))))
  (is (= :at-target (:state (r/decide intent "n0" target nil {} now))))
  (is (= :not-in-rollout (:state (r/decide intent "zz" old nil {} now))))
  (is (= :upgrade (:state (r/decide intent "n0" old nil {} now))) "wave 0 has no gate")
  (testing "wave 1 waits for wave 0 to run the target, ready and settled"
    (is (= :waiting (:state (r/decide intent "n1" old nil {} now))))
    (is (= :waiting (:state (r/decide intent "n1" old nil {"n0" (doc "release" (subs old 0 16))} now))))
    (is (= :waiting (:state (r/decide intent "n1" old nil {"n0" (doc "lanes" {"t" {"ready" false}})} now))))
    (is (= :waiting (:state (r/decide intent "n1" old nil {"n0" (doc "started-at" (- now 10))} now))) "not settled")
    (is (= :waiting (:state (r/decide intent "n1" old nil {"n0" (doc "at" (- now r/gate-freshness-ms 1))} now)))
        "a report older than the gate's freshness does not open the next wave (crashed after reporting)")
    (is (= :upgrade (:state (r/decide intent "n1" old nil {"n0" (doc)} now)))))
  (testing "a different dependency set blocks"
    (is (= :blocked (:state (r/decide (assoc-in intent ["agents" "resident" "package-sha256"] "x") "n0" old "y" {} now))))))

(defmethod cljs.test/report [:cljs.test/default :end-run-tests] [m]
  (when-not (cljs.test/successful? m) (set! (.-exitCode js/process) 1)))

(run-tests)
