(ns murakumo.infer.hermes-fast-test
  (:require [kotoba.test :refer [deftest is testing]]
            [murakumo.infer.hermes-fast :as fast]))

(def healthy
  {:provider "custom"
   :model "mishima"
   :api_calls 1
   :completed true
   :failed false
   :partial false
   :interrupted false})

(deftest cold-and-warm-receipts-count-the-same-prompt-budget
  (is (:pass? (fast/qualify (assoc healthy :input_tokens 7900 :cache_read_tokens 0) true)))
  (is (:pass? (fast/qualify (assoc healthy :input_tokens 20 :cache_read_tokens 7980) true)))
  (is (= 8000 (:prompt-tokens
               (fast/qualify (assoc healthy :input_tokens 20 :cache_read_tokens 7980) true)))))

(deftest cached-prefix-does-not-hide-an-oversized-prompt
  (let [result (fast/qualify (assoc healthy :input_tokens 23 :cache_read_tokens 17060) true)]
    (is (false? (:pass? result)))
    (is (= 17083 (:prompt-tokens result)))
    (is (= :prompt-ceiling (-> result :failed first :gate)))))

(deftest missing-measurement-is-not-green
  (doseq [usage [(dissoc healthy :input_tokens)
                 (assoc healthy :input_tokens 1 :cache_read_tokens nil)
                 (assoc healthy :input_tokens -1 :cache_read_tokens 0)]]
    (let [result (fast/qualify usage true)]
      (is (false? (:pass? result)))
      (is (some #(= :measured-prompt-tokens (:gate %)) (:failed result))))))

(deftest primary-only-and-completion-gates-name-the-reason
  (doseq [[usage gate]
          [[(assoc healthy :input_tokens 1 :cache_read_tokens 0 :provider "fallback") :primary-provider]
           [(assoc healthy :input_tokens 1 :cache_read_tokens 0 :model "other") :primary-model]
           [(assoc healthy :input_tokens 1 :cache_read_tokens 0 :api_calls 2) :single-api-call]
           [(assoc healthy :input_tokens 1 :cache_read_tokens 0 :completed false) :completed-turn]
           [(assoc healthy :input_tokens 1 :cache_read_tokens 0 :failed true) :no-failure]
           [(assoc healthy :input_tokens 1 :cache_read_tokens 0 :partial true) :no-partial-result]
           [(assoc healthy :input_tokens 1 :cache_read_tokens 0 :interrupted true) :not-interrupted]]]
    (let [result (fast/qualify usage true)]
      (is (false? (:pass? result)))
      (is (some #(= gate (:gate %)) (:failed result))))))

(deftest correctness-is-a-hard-gate
  (let [result (fast/qualify (assoc healthy :input_tokens 1 :cache_read_tokens 0) false)]
    (is (false? (:pass? result)))
    (is (= :exact-response (-> result :failed first :gate)))))

(deftest live-run-requires-measured-wall-time
  (doseq [wall-ms [nil -1]]
    (let [result (fast/qualify-run
                  (assoc healthy :input_tokens 791 :cache_read_tokens 0)
                  true wall-ms)]
      (is (false? (:pass? result)))
      (is (= :measured-wall-time (-> result :failed first :gate))))))

(deftest live-run-enforces-wall-deadline-boundary
  (let [usage (assoc healthy :input_tokens 791 :cache_read_tokens 0)]
    (is (:pass? (fast/qualify-run usage true 90000)))
    (let [result (fast/qualify-run usage true 90001)]
      (is (false? (:pass? result)))
      (is (= :wall-deadline (-> result :failed first :gate))))))
