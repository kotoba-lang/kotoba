(ns murakumo.mesh-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.text :as str]
            [murakumo.mesh :as mesh]))

(def pass "0123456789abcdef0123456789abcdef")

(defn- ledger [& {:as extra}]
  (merge {:admit :auto-on-mesh :nodes {"seed" {:id "seed" :status "authorized" :did "did:key:zSeed" :address "10.77.0.1"}}}
         extra))

(defn- req [& {:as extra}]
  (merge {:did "did:key:zB" :node-name "b" :now-ms 1000 :proof-valid? true} extra))

(deftest wpa-conf-is-sae-with-protected-management-frames
  (let [c (mesh/wpa-supplicant-conf {:passphrase pass})]
    (is (str/includes? c "mode=5"))
    (is (str/includes? c "key_mgmt=SAE"))
    (is (str/includes? c "ieee80211w=2"))
    (is (str/includes? c "frequency=5180"))
    (is (str/includes? c (str "psk=\"" pass "\"")))))

(deftest a-weak-passphrase-is-refused-not-rendered
  (is (thrown? Exception (mesh/wpa-supplicant-conf {:passphrase "short"})))
  (is (thrown? Exception (mesh/wpa-supplicant-conf {:passphrase (str pass "\"}")})))
  (is (false? (mesh/valid-passphrase? nil))))

(deftest iface-script-refuses-a-radio-without-mesh-point
  (let [s (mesh/mesh-iface-script {})]
    (is (str/includes? s "mesh point"))
    (is (str/includes? s "exit 3"))
    (is (str/includes? s "type mp"))))

(deftest a-proved-joiner-is-auto-admitted-with-an-address
  (let [v (mesh/admit (ledger) (req))]
    (is (= :grant (:decision v)))
    (is (= :auto-on-mesh (:reason v)))
    (is (= "authorized" (get-in v [:ledger :nodes "b" :status])))
    (is (= "10.77.0.2" (get-in v [:ledger :nodes "b" :address])))))

(deftest addresses-are-not-reused
  (let [v1 (mesh/admit (ledger) (req))
        v2 (mesh/admit (:ledger v1) (req :did "did:key:zC" :node-name "c"))]
    (is (= "10.77.0.3" (get-in v2 [:ledger :nodes "c" :address])))))

(deftest without-the-opt-in-a-join-stays-pending
  (let [l (dissoc (ledger) :admit)
        v (mesh/admit l (req))]
    (is (= :pending (:decision v)))
    (is (= "pending" (get-in v [:ledger :nodes "b" :status])))))

(deftest no-proof-no-entry
  (let [l (ledger)
        v (mesh/admit l (req :proof-valid? false))]
    (is (= :deny (:decision v)))
    (is (= :no-proof-of-possession (:reason v)))
    (is (= l (:ledger v)) "a refused join leaves the ledger untouched")))

(deftest a-revoked-did-cannot-return-with-a-valid-proof
  (let [l (mesh/revoke (:ledger (mesh/admit (ledger) (req))) "b")
        v (mesh/admit l (req))]
    (is (= :deny (:decision v)))
    (is (= :did-revoked (:reason v)))))

(deftest a-trusted-name-cannot-be-taken-by-another-key
  (let [v (mesh/admit (ledger) (req :node-name "seed" :did "did:key:zEvil"))]
    (is (= :deny (:decision v)))
    (is (= :node-name-taken-by-another-key (:reason v)))
    (is (= "authorized" (get-in v [:ledger :nodes "seed" :status])))))

(deftest a-rejoin-by-the-same-key-is-idempotent
  (let [v1 (mesh/admit (ledger) (req))
        v2 (mesh/admit (:ledger v1) (req))]
    (is (= :grant (:decision v2)))
    (is (= :already-authorized (:reason v2)))
    (is (= (:ledger v1) (:ledger v2)))))

(deftest malformed-requests-are-denied
  (is (= :malformed-request (:reason (mesh/admit (ledger) (req :did nil)))))
  (is (= :malformed-request (:reason (mesh/admit (ledger) (req :node-name ""))))))

(deftest a-full-subnet-denies-instead-of-wrapping
  (let [full (into {} (map (fn [n] [(str "n" n) {:id (str "n" n) :status "authorized"
                                                   :did (str "d" n) :address (str "10.77.0." n)}])
                            (range 2 255)))
        v (mesh/admit (ledger :nodes full) (req))]
    (is (= :deny (:decision v)))
    (is (= :mesh-subnet-full (:reason v)))))

(deftest the-proof-message-binds-every-field-and-carries-a-domain
  (let [m (mesh/proof-message {:nonce "n" :endpoint "http://10.77.0.1:7077/enroll"
                               :did "did:key:zX" :node-name "b"})]
    (is (str/starts-with? m "murakumo-mesh-enroll/v1\n"))
    (doseq [f ["n" "http://10.77.0.1:7077/enroll" "did:key:zX" "b"]]
      (is (str/includes? m f)))
    (is (not= m (mesh/proof-message {:nonce "n2" :endpoint "http://10.77.0.1:7077/enroll"
                                     :did "did:key:zX" :node-name "b"})))))

(deftest only-ed25519-did-keys-are-accepted
  (is (mesh/did-key? "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK"))
  (is (not (mesh/did-key? "did:key:zQ3shokFTS3brHcDQrn82RUDfCZESWL1ZdCEJwekUDPQiYBme")) "secp256k1")
  (is (not (mesh/did-key? "did:web:example.com")))
  (is (not (mesh/did-key? nil)))
  (is (not (mesh/did-key? "did:key:z6Mk$(id)"))))
