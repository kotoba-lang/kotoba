(ns murakumo.onboard-window-test
  "Every transition is pinned, and each refusal names its own reason, so a rule that
  stops discriminating cannot pass by closing for a different cause."
  (:require [murakumo.onboard-window :as w]
            [kotoba.test :refer [deftest is testing]]))

(def codes (atom ["AAAAA2" "BBBBB2" "CCCCC2" "DDDDD2" "EEEEE2" "FFFFF2" "GGGGG2"]))
(defn next-code [] (let [c (first @codes)] (swap! codes rest) c))
(defn fresh [& {:as o}]
  (reset! codes ["AAAAA2" "BBBBB2" "CCCCC2" "DDDDD2" "EEEEE2" "FFFFF2" "GGGGG2"])
  (w/start (merge {:now-ms 1000 :ttl-ms 60000 :max-attempts 3 :rand-code next-code} o)))

(def profile {:ssid "DemoNet" :security :wpa2-personal :passphrase "demo-pass-1234"})

(deftest a-window-starts-open-with-a-code-and-a-deadline
  (let [s (fresh)]
    (is (= {:state :open :code "AAAAA2" :attempts 0 :max-attempts 3
            :started-ms 1000 :deadline-ms 61000} s))))

(deftest it-closes-when-its-time-is-up-and-not-before
  (let [s (fresh)]
    (is (= s (w/tick s 60999)) "one millisecond early")
    (is (= (assoc s :state :closed :reason :timeout) (w/tick s 61000)))
    (testing "the clock never rotates the code"
      (is (= "AAAAA2" (:code (w/tick s 30000)))))
    (testing "a window that is already received is not closed by the clock"
      (let [received (:session (w/heard s profile next-code))]
        (is (= received (w/tick received 999999)))))))

(deftest a-profile-that-opens-ends-the-window
  (let [{:keys [session effect]} (w/heard (fresh) profile next-code)]
    (is (= :received effect))
    (is (= :received (:state session)))
    (is (= profile (:profile session)))))

(deftest noise-and-the-boxs-own-beacon-are-not-attempts
  (let [s (fresh)]
    (is (= {:session s :effect nil} (w/heard s {:error :not-a-profile} next-code)))
    (is (= 0 (:attempts s)))))

(deftest every-failed-attempt-rotates-the-code-and-the-last-closes
  (let [s0 (fresh)
        r1 (w/heard s0 {:error :cannot-open} next-code)
        r2 (w/heard (:session r1) {:error :cannot-open} next-code)
        r3 (w/heard (:session r2) {:error :cannot-open} next-code)]
    (is (= :rotated (:effect r1)))
    (is (= "BBBBB2" (:code (:session r1))) "the next code, not the old one")
    (is (= 1 (:attempts (:session r1))))
    (is (= :rotated (:effect r2)))
    (is (= "CCCCC2" (:code (:session r2))))
    (is (= :closed (:effect r3)))
    (is (= {:state :closed :reason :too-many-attempts :attempts 3}
           (select-keys (:session r3) [:state :reason :attempts])))))

(deftest a-binding-refusal-counts-as-an-attempt-too
  ;; a wrong code or fingerprint reaches the box as :bad-code/:bad-fingerprint from
  ;; murakumo.onboard/open; it is somebody trying, so it is an attempt like any other
  (let [{:keys [effect session]} (w/heard (fresh) {:error :bad-fingerprint} next-code)]
    (is (= :rotated effect))
    (is (= 1 (:attempts session)))))

(deftest a-closed-or-received-window-ignores-everything
  (let [closed (assoc (fresh) :state :closed :reason :timeout)
        received (:session (w/heard (fresh) profile next-code))]
    (doseq [s [closed received]
            r [profile {:error :cannot-open} {:error :not-a-profile}]]
      (is (= {:session s :effect nil} (w/heard s r next-code))))))
