(ns murakumo.web-backends-test
  (:require [kotoba.test :refer [deftest is]]
            [murakumo.web.backends :as b]))

(deftest wikipedia-results-map-titles-to-article-urls
  (let [doc {:query {:search [{:title "Distributed hash table" :snippet "A <span class=\"searchmatch\">DHT</span> &amp; more"}
                              {:title "叢雲" :snippet "x"}
                              {:title "C++ (language)" :snippet ""}
                              {:title "" :snippet "dropped"}]}}
        r (b/wikipedia-results doc "en")]
    (is (= 3 (count r)))
    (is (= "https://en.wikipedia.org/wiki/Distributed_hash_table" (:url (first r))))
    (is (= "A DHT & more" (:snippet (first r))))
    (is (= "https://en.wikipedia.org/wiki/%E5%8F%A2%E9%9B%B2" (:url (second r))))
    (is (= "https://en.wikipedia.org/wiki/C%2B%2B_(language)" (:url (nth r 2))))))

(deftest hn-results-fall-back-to-the-item-page
  (let [r (b/hn-results {:hits [{:title "A" :url "https://a.example/x" :objectID "1"}
                                {:title "Ask HN" :url nil :objectID "2" :story_text "<p>hi &amp; bye</p>"}
                                {:title "" :url "https://z" :objectID "3"}]})]
    (is (= ["https://a.example/x" "https://news.ycombinator.com/item?id=2"] (mapv :url r)))
    (is (= "hi & bye" (:snippet (second r))))))

(deftest malformed-documents-give-no-results
  (is (= [] (b/wikipedia-results {} "en")))
  (is (= [] (b/hn-results nil))))
