;; Test for murakumo.artifact-protocol. main returns the number of failed cases.
(ns murakumo.artifact-protocol-test
  (:export [main])
  (:require [murakumo.artifact-protocol :as ap]))

(defn- chk-bool [got :bool want :bool] :i64
  (if (= got want) 0 1))
(defn- chk-i64 [got :i64 want :i64] :i64
  (if (= got want) 0 1))

(defn- good-fields [] :document
  (document-map :murakumo.artifact/release-action (document-keyword :deploy)
                :murakumo.artifact/node (document-string "n1")
                :murakumo.artifact/issued-capability (document-map :cap (document-string "c"))
                :murakumo.artifact/bundle-cid (document-string "b")
                :murakumo.artifact/revision (document-string "r")
                :murakumo.artifact/environment (document-string "prod")
                :murakumo.artifact/verdict-cid (document-string "v")
                :murakumo.artifact/transfer-id (document-string "t")
                :murakumo.artifact/object-cid (document-string "o")))

(defn- cases-request [] :i64
  (let [req (ap/request (document-keyword :begin) (good-fields))
        c1 (chk-bool (ap/valid-request? req) true)
        c2 (chk-i64 (if (ap/valid-request? (ap/request (document-keyword :bogus) (good-fields))) 0 1) 1)
        c3 (chk-bool (ap/valid-request? (document-map)) false)
        c4 (chk-i64 (if (ap/valid-request? (document-map :murakumo.artifact/version (document-i64 2)
                                                         :murakumo.artifact/type (document-keyword :request)
                                                         :murakumo.artifact/operation (document-keyword :begin)))
                      0 1) 1)
        noname (ap/request (document-keyword :commit)
                           (document-map :murakumo.artifact/release-action (document-keyword :rollback)
                                         :murakumo.artifact/node (document-i64 7)
                                         :murakumo.artifact/issued-capability (document-map)
                                         :murakumo.artifact/bundle-cid (document-string "b")
                                         :murakumo.artifact/revision (document-string "r")
                                         :murakumo.artifact/environment (document-string "e")
                                         :murakumo.artifact/verdict-cid (document-string "v")
                                         :murakumo.artifact/transfer-id (document-string "t")
                                         :murakumo.artifact/object-cid (document-string "o")))
        c5 (chk-bool (ap/valid-request? noname) false)
        c6 (chk-i64 (document-count (ap/operations)) 4)]
    (+ c1 (+ c2 (+ c3 (+ c4 (+ c5 c6)))))))

(defn- cases-response [] :i64
  (let [res (ap/response (document-keyword :begin) (document-string "n1")
                         (document-map :ok? (document-bool true)))
        c1 (chk-bool (ap/valid-response? res (document-keyword :begin) (document-string "n1")) true)
        c2 (chk-bool (ap/valid-response? res (document-keyword :chunk) (document-string "n1")) false)
        c3 (chk-bool (ap/valid-response? res (document-keyword :begin) (document-string "n2")) false)
        bad (ap/response (document-keyword :begin) (document-string "n1") (document-map :ok? (document-string "yes")))
        c4 (chk-bool (ap/valid-response? bad (document-keyword :begin) (document-string "n1")) false)
        c5 (chk-i64 (ap/version) 1)]
    (+ c1 (+ c2 (+ c3 (+ c4 c5))))))

(defn main [] :i64
  (+ (cases-request) (cases-response)))
