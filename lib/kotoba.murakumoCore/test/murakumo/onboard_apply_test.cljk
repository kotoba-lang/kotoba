(ns murakumo.onboard-apply-test
  (:require [kotoba.test :refer [deftest is]]
            [murakumo.onboard-device :as device]
            ["node:fs" :as fs] ["node:os" :as os] ["node:path" :as path]))

(deftest profile-application-reports-networkmanager-failures-and-keeps-files-private
  (let [dir (.mkdtempSync fs (.join path (.tmpdir os) "onboard-apply-"))
        tmp (.join path dir "murakumo-onboard.nmconnection.tmp")
        p (.join path dir "murakumo-onboard.nmconnection")
        calls (atom [])
        profile {:ssid "Home Wi-Fi" :security :wpa2-personal :passphrase "test-password"}
        opts {:profile profile :keyfile-dir dir :reload? true}]
    (try
      (.writeFileSync fs tmp "unrelated" #js {:mode 0644})
      (is (= {:applied? false :reason :nm-reload-failed}
             (device/apply-profile! (assoc opts :run-nmcli (fn [args] (swap! calls conj args) 7)))))
      (is (= [["connection" "reload"]] @calls))
      (is (= {:applied? false :reason :nm-activation-failed}
             (device/apply-profile! (assoc opts :run-nmcli #(if (= ["connection" "reload"] %) 0 9)))))
      (is (= {:applied? true} (device/apply-profile! (assoc opts :run-nmcli (constantly 0)))))
      (is (= {:applied? true} (device/apply-profile! (assoc opts :reload? false :run-nmcli #(throw (js/Error. "must not call"))))))
      (is (= 0600 (bit-and (.-mode (.statSync fs p)) 0777)))
      (is (= "unrelated" (.readFileSync fs tmp "utf8")))
      (is (= {:applied? false :reason :ssid-not-framing-safe}
             (device/apply-profile! (assoc opts :profile (assoc profile :ssid "line\nbreak")))))
      (finally (.rmSync fs dir #js {:recursive true :force true})))))
