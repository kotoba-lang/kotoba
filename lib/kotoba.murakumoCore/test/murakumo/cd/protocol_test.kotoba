(ns murakumo.cd.protocol-test (:export [main]) (:require [murakumo.cd.protocol :as p]))

(defn- ok [b :bool] :i64
  (if b 0 1))

(defn- req [] :document
  (p/request (document-keyword :deploy) (document-string "n1") (document-map)
             (document-string "cid") (document-string "prod") (document-string "v1") (document-string "r1")))

(defn- resp [ok? :bool] :document
  (p/response (document-keyword :deploy) (document-string "n1") (document-map :ok? (document-bool ok?))))

(defn- request-checks [] :i64
  (+ (ok (= (p/version) 1))
     (ok (p/valid-request? (req)))
     (ok (not (p/valid-request? (document-assoc (req) :murakumo.cd/action (document-keyword :bogus)))))
     (ok (not (p/valid-request? (document-assoc (req) :murakumo.cd/version (document-i64 2)))))))

(defn- response-checks [] :i64
  (+ (ok (p/valid-response? (resp true) (document-keyword :deploy) (document-string "n1")))
     (ok (not (p/valid-response? (resp true) (document-keyword :deploy) (document-string "n2"))))
     (ok (not (p/valid-response? (p/response (document-keyword :deploy) (document-string "n1") (document-map))
                                 (document-keyword :deploy) (document-string "n1"))))))

(defn main [] :i64
  (+ (request-checks) (response-checks)))
