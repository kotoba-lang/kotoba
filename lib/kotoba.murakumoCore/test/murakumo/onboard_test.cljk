(ns murakumo.onboard-test
  "Pinned to the golden vector in kotoba-lang/grant `test/vectors/acoustic-onboard.edn`
  (fixed TEST keys). Its message is also opened by node:crypto and by WebCrypto in
  that repository, so the box, the helper and the browser are checked against the
  same bytes. Every refusal names its own reason."
  (:require [murakumo.onboard :as onboard]
            [kotoba.bytes :as kbytes]
            [kotoba.test :refer [deftest is testing]]))

(def device-seed "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff")
(def ephemeral-seed "ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100")
(def code "K7QX3M")
(def fp "2c3b85f8")
(def label-secret "AAECAwQFBgcICQoLDA0ODw")
(def profile {:ssid "Home-WiFi-5G" :security :wpa2-personal :passphrase "correct horse battery"})
(def device-public-key "1ekGUFKTlUnQVazwPzSCAFeOPtK2XrapZWRHF2G6T1Q")
(def message-hex "574a52f593172fa3a7184e79ec52ffddcf8b6062c9a69054a606f07532e255746d3deb7673ad933e36d654e0c43b37ec1d18187c40f19675d84c3fb967f57295bd261e283f0e6603c4115ddb37889cc0bb0f1459")

(def device-key (onboard/private-key-from-seed device-seed))

(defn- sealed [& {:as overrides}]
  (onboard/seal (merge {:device-key device-public-key :code code :fp fp
                        :label-secret label-secret :profile profile
                        :ephemeral-seed ephemeral-seed}
                       overrides)))

(defn- opened [message & {:as overrides}]
  (onboard/open (merge {:private-key device-key :code code :fp fp
                        :label-secret label-secret :message message}
                       overrides)))

(deftest sealing-reproduces-the-golden-message
  (is (= message-hex (kbytes/hex (sealed)))
      "same device key, same ephemeral seed, same bytes as the vector other runtimes open"))

(deftest the-box-opens-the-golden-message
  (is (= profile (opened (kbytes/unhex message-hex)))))

(deftest a-fresh-seal-opens-and-differs-every-time
  (let [a (sealed :ephemeral-seed nil) b (sealed :ephemeral-seed nil)]
    (is (= profile (opened a)))
    (is (= profile (opened b)))
    (is (not= a b) "a fresh ephemeral key per message, since the IV is derived and must never repeat")))

(deftest a-generated-device-key-matches-its-public-half
  (let [{:keys [private-key public-key]} (onboard/generate-device-key)
        message (onboard/seal {:device-key public-key :code code :fp fp
                               :label-secret label-secret :profile profile})]
    (is (= 43 (count public-key)))
    (is (= profile (onboard/open {:private-key private-key :code code :fp fp
                                  :label-secret label-secret :message message})))))

(deftest an-envelope-opens-only-for-the-box-session-and-label-it-was-made-for
  (let [message (kbytes/unhex message-hex)]
    (testing "sealed without knowing the label secret (what a bystander who heard the beacon can do)"
      (is (= {:error :cannot-open}
             (opened (sealed :label-secret "AAAAAAAAAAAAAAAAAAAAAA")))))
    (testing "opened with another label secret"
      (is (= {:error :cannot-open} (opened message :label-secret "AAAAAAAAAAAAAAAAAAAAAA"))))
    (testing "replayed into another session"
      (is (= {:error :cannot-open} (opened message :code "ABCDEF"))))
    (testing "meant for another box"
      (is (= {:error :cannot-open} (opened message :fp "00000000"))))
    (testing "another device key"
      (is (= {:error :cannot-open}
             (opened message :private-key (:private-key (onboard/generate-device-key))))))
    (testing "one flipped bit in the ciphertext"
      (is (= {:error :cannot-open} (opened (update message 40 bit-xor 1)))))
    (testing "one flipped bit in the tag"
      (is (= {:error :cannot-open} (opened (update message (dec (count message)) bit-xor 1)))))))

(deftest what-is-not-a-profile-is-not-opened
  (is (= {:error :not-a-profile} (opened (kbytes/utf8-encode (str "mk1|" code "|" fp "|" device-public-key))))
      "its own beacon heard back from the speaker")
  (is (= {:error :not-a-profile} (opened [])))
  (is (= {:error :bad-code} (opened (kbytes/unhex message-hex) :code "bad"))))

(deftest a-profile-that-cannot-be-sent-is-refused-before-any-crypto
  (is (= {:error :passphrase-length} (sealed :profile (assoc profile :passphrase "short"))))
  (is (= {:error :too-long-for-sound}
         (sealed :profile {:ssid (apply str (repeat 26 "a")) :security :wpa2-personal
                           :passphrase (apply str (repeat 62 "b"))})))
  (is (= {:error :bad-device-key} (sealed :device-key "short")))
  (is (= {:error :bad-label-secret} (sealed :label-secret "short"))))

(deftest the-fingerprint-is-the-start-of-the-dids-sha-256
  ;; pinned: sha256("did:key:z6MkTestDevice") = 6d7a… computed independently
  (is (= 8 (count (onboard/device-fingerprint "did:key:z6MkTestDevice"))))
  (is (= (onboard/device-fingerprint "did:key:z6MkTestDevice")
         (onboard/device-fingerprint "did:key:z6MkTestDevice")))
  (is (not= (onboard/device-fingerprint "did:key:z6MkTestDevice")
            (onboard/device-fingerprint "did:key:z6MkOtherDevice"))))
