(ns murakumo.fleet.ctl-test
  "ADR-2610071730 P4: the kubectl-shaped views. Offline."
  (:require [cljs.test :refer [deftest is testing run-tests]]
            [murakumo.fleet.ctl :as ctl]))

(def now 10000000)
(defn- p [& {:as m}] (merge {"at" now "lanes" {"text" {"ready" true}} "release" "r1" "topology" {"revision" 5}} m))

(deftest node-status
  (is (= "Ready" (ctl/node-status (p) now)))
  (is (= "NotReady" (ctl/node-status (p "lanes" {"text" {"ready" false}}) now)))
  (is (= "Stale" (ctl/node-status (p "at" (- now (* 6 60 1000))) now))))

(deftest rollout
  (is (:converged? (ctl/rollout-status {"a" (p) "b" (p)} nil now)))
  (let [r (ctl/rollout-status {"a" (p) "b" (p "release" "r2")} nil now)]
    (is (not (:converged? r)))
    (is (= {"r1" ["a"] "r2" ["b"]} (:releases r))))
  (testing "stale reports and missing expected nodes are not converged"
    (is (not (:converged? (ctl/rollout-status {"a" (p "at" (- now (* 10 60 1000)))} nil now))))
    (is (= ["c"] (:missing (ctl/rollout-status {"a" (p) "b" (p)} #{"a" "b" "c"} now))))
    (is (not (:converged? (ctl/rollout-status {} nil now))) "no report is not success"))
  (testing "with a target, agreement on the old release or revision is not rolled out"
    (let [docs {"a" (p) "b" (p)} rev (get-in (p) ["topology" "revision"])]
      (is (not (:converged? (ctl/rollout-status docs nil now {:release "r2" :revision rev}))))
      (is (not (:converged? (ctl/rollout-status docs nil now {:release "r1" :revision (inc (or rev 0))}))))
      (is (:converged? (ctl/rollout-status docs nil now {:release "r1" :revision rev}))))))

(deftest review-fixes
  (is (re-find #"added" (ctl/diff-line {:what "node" :name "x" :change "added"})))
  (is (= 300 (ctl/parse-positive nil 300)))
  (is (thrown? js/Error (ctl/parse-positive "abc" 300)))
  (is (thrown? js/Error (ctl/parse-positive "-5" 300)))
  (is (= "http://100.64.0.1:8796" (ctl/base-url "http://100.64.0.1:8796//")))
  (is (ctl/trusted-endpoint? "http://100.64.0.1:8796" false))
  (is (not (ctl/trusted-endpoint? "https://evil.example.com" false)) "the fleet token never goes to a non-fleet URL")
  (is (not (ctl/trusted-endpoint? "http://127.0.0.1:8796" false)))
  (is (= #{"a"} (ctl/expected-nodes {"nodes" [{"node" "a" "enabled" true} {"node" "b" "enabled" false}]})))
  (let [live {"revision" 1 "nodes" [{"node" "a" "url" "http://100.64.0.1:8796" "enabled" true}] "gateways" [{"node" "g"}]}]
    (is (some #(= "url" (:field %)) (ctl/intent-diff live (assoc-in live ["nodes" 0 "url"] "http://100.64.0.2:8796"))))
    (is (some #(= "gateways" (:what %)) (ctl/intent-diff live (assoc live "gateways" []))))))

(deftest diff-and-cordon
  (let [live {"revision" 5 "nodes" [{"node" "a" "enabled" true} {"node" "b" "enabled" true}] "policies" {"x" 1}}
        intent (assoc live "revision" 6 "spec-version" 2 "classes" {"c" {}})
        c (ctl/cordon intent "a" true)]
    (is (= 7 (get c "revision")))
    (is (true? (get-in c ["nodes" 0 "cordoned"])))
    (is (nil? (get-in (ctl/cordon c "a" false) ["nodes" 0 "cordoned"])) "uncordon removes the mark")
    (let [d (ctl/intent-diff live c)]
      (is (some #(and (= "a" (:name %)) (= "cordoned" (:field %)) (true? (:to %))) d))
      (is (some #(= "classes" (:what %)) d))
      (is (some #(and (= "revision" (:what %)) (= 7 (:to %))) d)))
    (is (thrown? js/Error (ctl/cordon intent "zz" true)))
    (testing "a removed node shows as refused"
      (is (some #(re-find #"refused" (str (:change %))) (ctl/intent-diff live (update intent "nodes" pop)))))))

(defmethod cljs.test/report [:cljs.test/default :end-run-tests] [m]
  (when-not (cljs.test/successful? m) (set! (.-exitCode js/process) 1)))

(run-tests)
