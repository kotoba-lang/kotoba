(ns murakumo.mesh-rotate-test
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.lang.text :as str]
            [murakumo.mesh.install :as install]
            [murakumo.mesh.rotate :as rotate]))

(def pass "ffffffffffffffffffffffffffffffff")

(def ledger {:nodes {"b" {:status "authorized" :did "d1" :mesh? true}
                     "c" {:status "authorized" :did "d2" :mesh? true}
                     "gone" {:status "revoked" :did "d3"}
                     "wait" {:status "pending" :did "d4"}
                     "nohost" {:status "authorized" :did "d5" :mesh? true}}})

(def hosts {"b" "root@b" "c" "root@c" "gone" "root@gone" "wait" "root@wait"})

(deftest revoked-and-pending-nodes-are-not-given-the-new-secret
  (let [t (rotate/targets ledger {:host-map hosts :seed-host "root@seed"})]
    (is (= ["b" "c" "seed"] (map :name (:nodes t))))
    (is (= ["gone"] (get-in t [:skipped :revoked])))
    (is (= ["wait"] (get-in t [:skipped :pending])))
    (is (not-any? #{"root@gone" "root@wait"} (map :host (:nodes t))))))

(deftest the-seed-is-last-and-a-node-with-no-host-is-reported-not-guessed
  (let [t (rotate/targets ledger {:host-map hosts :seed-host "root@seed"})]
    (is (= :seed (:role (last (:nodes t)))))
    (is (= ["nohost"] (:unresolved t)))))

(deftest hosts-come-from-the-fleet-with-explicit-pairs-winning
  (is (= {"a" "ha" "b" "override"}
         (rotate/host-map {:nodes [{:name "a" :host "ha"} {:name "b" :host "hb"} {:name "nohost-key"}]}
                          {"b" "override"}))))

(deftest pairs-are-parsed-strictly
  (is (= ["node-b" "root@100.1.2.3"] (rotate/parse-pair "node-b=root@100.1.2.3")))
  (doseq [bad ["x" "=h" "a=" "A=h" "a=h;id" "a=$(id)" nil]]
    (is (nil? (rotate/parse-pair bad)) (pr-str bad))))

(deftest only-a-valid-passphrase-can-be-generated
  (is (= pass (rotate/generate-passphrase pass)))
  (is (thrown? Exception (rotate/generate-passphrase "short")))
  (is (thrown? Exception (rotate/generate-passphrase (str pass "\"; id #")))))

(deftest progress-is-kept-and-resumes-with-what-is-left
  (let [t (:nodes (rotate/targets ledger {:host-map hosts :seed-host "root@seed"}))
        s0 (rotate/new-state pass 1)
        s1 (-> s0 (rotate/mark-done "b" nil) (rotate/mark-done "b" nil))]
    (is (= ["b"] (:done s1)) "marking twice is the same as once")
    (is (= ["c" "seed"] (map :name (rotate/remaining s1 t))))
    (is (not (rotate/complete? s1 t [])))
    (is (rotate/complete? (-> s1 (rotate/mark-done "c" nil) (rotate/mark-done "seed" "murakumo-mesh:v1:x")) t []))
    (is (not (rotate/complete? (-> s1 (rotate/mark-done "c" nil) (rotate/mark-done "seed" nil)) t ["nohost"]))
        "an unreachable node blocks completion until it is fixed or revoked")))

(deftest the-node-script-writes-atomically-and-verifies-the-unit
  (let [s (rotate/rotate-script {:role :node})]
    (is (not (str/includes? s pass)) "the new passphrase is not in the script")
    (is (str/includes? s "IFS= read -r MESH_PASSPHRASE"))
    (is (str/includes? s "mesh.env.new"))
    (is (str/includes? s "mv /etc/murakumo/wpa-mesh.conf.new /etc/murakumo/wpa-mesh.conf"))
    (is (str/includes? s "chmod 600 /etc/murakumo/wpa-mesh.conf.new"))
    (is (str/includes? s "FAILED: murakumo-mesh-wpa.service not active"))
    (is (str/includes? s "mesh is not installed on this node"))
    (is (not (str/includes? s "JOIN_TOKEN")) "only the seed prints a token")))

(deftest the-seed-script-also-rewrites-and-prints-the-join-token
  (let [s (rotate/rotate-script {:role :seed})]
    (is (str/includes? s "$4=p"))
    (is (str/includes? s "mesh-join-token.new"))
    (is (str/includes? s "JOIN_TOKEN="))))

(deftest hostile-values-never-reach-the-shell
  (is (thrown? Exception (rotate/stdin-for "short")))
  (is (thrown? Exception (rotate/stdin-for (str pass "\n; id"))))
  (is (thrown? Exception (rotate/rotate-script {:role :node :iface "mesh0; id"})))
  (is (thrown? Exception (rotate/peers-script {:iface "x y"}))))

(deftest the-passphrase-is-piped-as-one-line
  (is (= (str pass "\n") (rotate/stdin-for pass))))

(deftest peers-are-read-from-the-printed-line
  (is (= 2 (rotate/peers-from-output "noise\nPEERS=2\n")))
  (is (= 0 (rotate/peers-from-output "PEERS=0")))
  (is (nil? (rotate/peers-from-output "nothing"))))

(deftest the-rotated-token-is-still-a-valid-token-shape
  ;; field 4 (1-based) of a token is the passphrase; the awk rewrite targets it
  (let [t (install/format-token {:passphrase "0123456789abcdef0123456789abcdef"})
        parts (str/split t #":")]
    (is (= "0123456789abcdef0123456789abcdef" (nth parts 3)))
    (is (install/parse-token (str/join ":" (assoc (vec parts) 3 pass))))))
