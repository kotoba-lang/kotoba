(ns murakumo.web-robots-test
  (:require [kotoba.test :refer [deftest is]]
            [murakumo.web.robots :as robots]))

(def txt
  (str "# comment\n"
       "User-agent: *\nDisallow: /private/\nAllow: /private/open/\nDisallow: /*.pdf$\nCrawl-delay: 2\n\n"
       "User-agent: badbot\nUser-agent: worse\nDisallow: /\n\n"
       "User-agent: murakumo-web\nDisallow: /nomurakumo\n"))

(deftest groups-merge-consecutive-agents
  (let [g (robots/parse txt)]
    (is (= 3 (count g)))
    (is (= #{"badbot" "worse"} (:agents (second g))))))

(deftest our-named-group-overrides-star
  (let [g (robots/parse txt)]
    (is (false? (robots/allowed? g "/nomurakumo/x")))
    ;; the * group's /private/ rule does not apply to us: a named group replaces it
    (is (true? (robots/allowed? g "/private/x")))))

(deftest star-group-rules-when-no-named-group
  (let [g (remove #(contains? (:agents %) "murakumo-web") (robots/parse txt))]
    (is (false? (robots/allowed? g "/private/x")))
    (is (true? (robots/allowed? g "/private/open/x")))     ; longer Allow wins
    (is (false? (robots/allowed? g "/a/b.pdf")))
    (is (true? (robots/allowed? g "/a/b.pdf?x=1")))         ; $ anchors
    (is (true? (robots/allowed? g "/public")))
    (is (= 2000 (robots/crawl-delay-ms g)))))

(deftest allow-wins-a-tie-and-empty-disallow-allows
  (let [g (robots/parse "User-agent: *\nAllow: /x\nDisallow: /x\nDisallow:\n")]
    (is (true? (robots/allowed? g "/x")))
    (is (true? (robots/allowed? g "/anything")))))

(deftest robots-txt-itself-is-always-fetchable
  (let [g (robots/parse "User-agent: *\nDisallow: /\n")]
    (is (false? (robots/allowed? g "/a")))
    (is (true? (robots/allowed? g "/robots.txt")))))

(deftest availability-semantics-follow-rfc-9309
  (is (= :parsed (:basis (robots/for-status 200 "User-agent: *\nDisallow: /a\n"))))
  (is (true? (robots/allowed? (:groups (robots/for-status 404 "")) "/a")))
  (is (true? (robots/allowed? (:groups (robots/for-status 403 "")) "/a")))
  (is (false? (robots/allowed? (:groups (robots/for-status 503 "")) "/a")))
  (is (false? (robots/allowed? (:groups (robots/for-status nil "")) "/a"))))

(deftest unknown-lines-do-not-end-a-user-agent-run
  ;; previously a Sitemap line emptied our group and everything became allowed
  (let [g (robots/parse "User-agent: murakumo-web\nSitemap: https://x/s.xml\nUser-agent: other\nDisallow: /\n")]
    (is (false? (robots/allowed? g "/a")))))

(deftest only-the-exact-product-token-names-our-group
  (let [g (robots/parse "User-agent: web\nDisallow: /partial\n\nUser-agent:\nDisallow: /empty\n\nUser-agent: *\nDisallow: /star\n")]
    (is (true? (robots/allowed? g "/partial")))
    (is (true? (robots/allowed? g "/empty")))
    (is (false? (robots/allowed? g "/star"))))
  (let [g (robots/parse "USER-AGENT: Murakumo-Web\nDisallow: /me\n\nUser-agent: *\nDisallow: /star\n")]
    (is (false? (robots/allowed? g "/me")))
    (is (true? (robots/allowed? g "/star")))))       ; our named group replaces *

(deftest a-leading-bom-does-not_drop_the_first_group
  (let [g (robots/parse "﻿User-agent: *\nDisallow: /x\n")]
    (is (false? (robots/allowed? g "/x")))))
