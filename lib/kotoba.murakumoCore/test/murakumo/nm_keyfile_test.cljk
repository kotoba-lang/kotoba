(ns murakumo.nm-keyfile-test
  "The keyfile text is the interface to NetworkManager, so it is pinned as literals rather
  than rebuilt from the same expression under test."
  (:require [murakumo.nm-keyfile :as nm]
            [kotoba.test :refer [deftest is testing]]))

(def uuid "0b1c2d3e-4f50-4a6b-8c7d-9e0f1a2b3c4d")

(deftest a-wpa2-profile-is-pinned
  (is (= (str "[connection]\nid=murakumo-onboard\nuuid=" uuid "\ntype=wifi\nautoconnect=true\n"
              "\n[wifi]\nmode=infrastructure\nssid=DemoNet\n"
              "\n[wifi-security]\nkey-mgmt=wpa-psk\npsk=demo-pass-1234\n"
              "\n[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n")
         (nm/keyfile {:ssid "DemoNet" :security :wpa2-personal :passphrase "demo-pass-1234"} uuid))))

(deftest wpa3-uses-sae
  (is (re-find #"key-mgmt=sae\n"
               (nm/keyfile {:ssid "DemoNet" :security :wpa3-personal :passphrase "demo-pass-1234"} uuid))))

(deftest an-open-network-has-no-security-section
  (let [text (nm/keyfile {:ssid "CafeNet" :security :open} uuid)]
    (is (re-find #"ssid=CafeNet\n" text))
    (is (not (re-find #"wifi-security|psk" text)))))

(deftest a-value-that-could-start-another-line-is-refused
  (is (= {:error :ssid-not-framing-safe}
         (nm/keyfile {:ssid "Net\n[connection]\nid=evil" :security :wpa2-personal :passphrase "demo-pass-1234"} uuid)))
  (is (= {:error :passphrase-not-framing-safe}
         (nm/keyfile {:ssid "DemoNet" :security :wpa2-personal :passphrase "demo-pass\npsk=other"} uuid)))
  (is (= {:error :unknown-security}
         (nm/keyfile {:ssid "DemoNet" :security :wep :passphrase "demo-pass-1234"} uuid))))
