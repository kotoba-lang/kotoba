(ns murakumo.poi-core-test
  (:require [kotoba.test :refer [deftest is testing]]
            [murakumo.poi.core :as poi]))

(deftest supply-constants
  (testing "the MGA and the subsidy make up the 2.1B cap"
    (is (= (* 2100000000 poi/base-per-kumo) (+ poi/subsidy-total-base poi/mga-base)))
    (is (= (* 105000000 poi/base-per-kumo) poi/mga-base))))

(deftest next-bitcoin-halving
  (is (= 1050000 (poi/next-bitcoin-halving 966000)))
  (is (= 1260000 (poi/next-bitcoin-halving 1050000)))
  (is (= 1260000 (poi/next-bitcoin-halving 1259999))))

(deftest vcu
  (is (= 918 (poi/uvcu-text {:p-active-m 27000 :t-in 55 :t-out 4 :cached 42}))
      "2 · 27,000M · (4 + 13 uncached) / 1000")
  (is (= 5400 (poi/uvcu-text {:p-active-m 27000 :t-in 10 :t-out 100 :cached 50}))
      "cached beyond t-in never goes negative")
  (is (= 294912 (poi/uvcu-diffusion {:p-m 2000 :latent 9216 :steps 8 :cfg 1}))))

(deftest subsidy-schedule
  (let [g 1013000 n 1050000
        at #(poi/subsidy-at {:height % :genesis g :next-halving n})]
    (is (= 0 (at 1000000)) "nothing before genesis")
    (testing "ADR example: ≈ 8,077 KUMO per block, halving to ≈ 4,038 on Bitcoin's block"
      (is (= 8076 (quot (at 1013000) poi/base-per-kumo)))
      (is (= (at 1013000) (at 1049999)))
      (is (= 4038 (quot (at 1050000) poi/base-per-kumo)))
      (is (= (quot (at 1050000) 2) (at 1260000)))
      (is (= (quot (at 1260000) 2) (at 1470000))))
    (testing "the subsidy over all eras stays within 1.995B"
      (let [r0 (poi/subsidy-r0 {:genesis g :next-halving n})
            total (+ (* r0 (- n g))
                     (reduce + (for [k (range 1 64)]
                                 (* (poi/halve-n {:amount r0 :n k}) poi/halving-interval))))]
        (is (<= total poi/subsidy-total-base))
        (is (> total (* 0.999 poi/subsidy-total-base)) "and loses under 0.1% to rounding")))))

(deftest subsidy-split
  (let [s (poi/split-subsidy {:height 1013000 :genesis 1013000 :next-halving 1050000
                              :fees-uusd 2500000 :price-uusd 50000})]
    (is (= (:subsidy s) (+ (:treasury s) (:verification s) (:production s))) "split conserves")
    (is (= (:production s) (+ (:customer-pool s) (:capacity-pool s))) "pools conserve")
    (is (= 50000000 (:customer-pool s)) "$2.50 of fees at $0.05/KUMO caps the customer pool at 50 KUMO"))
  (testing "treasury share sunsets 210,000 blocks after genesis"
    (is (zero? (:treasury (poi/split-subsidy {:height 1223000 :genesis 1013000 :next-halving 1050000})))))
  (testing "no reference price, no customer pool: all production pays proven capacity"
    (let [s (poi/split-subsidy {:height 1013000 :genesis 1013000 :next-halving 1050000 :fees-uusd 2500000})]
      (is (zero? (:customer-pool s)))
      (is (= (:production s) (:capacity-pool s))))))

(deftest guards
  (testing "ADR-261010b §6: λ = 1, c = 10% → washing loses money below s ≈ 52.6%"
    (is (true? (poi/wash-unprofitable? {:s-bp 5000 :c-bp 1000 :fee 100 :e 100})))
    (is (true? (poi/wash-unprofitable? {:s-bp 5260 :c-bp 1000 :fee 100 :e 100})))
    (is (false? (poi/wash-unprofitable? {:s-bp 5300 :c-bp 1000 :fee 100 :e 100}))))
  (is (false? (poi/mature? {:settled 100 :now 243})))
  (is (true? (poi/mature? {:settled 100 :now 244})) "maturity is 144 blocks")
  (is (= [1001 1501] [(poi/season0-points {:uvcu 1001 :btc-proven 0})
                      (poi/season0-points {:uvcu 1001 :btc-proven 1})]))
  (is (true? (poi/verify-pass? {:matched 3 :total 4 :min-num 3 :min-den 4})))
  (is (false? (poi/verify-pass? {:matched 2 :total 4 :min-num 3 :min-den 4})))
  (is (false? (poi/verify-pass? {:matched 0 :total 0 :min-num 3 :min-den 4}))))

(deftest pro-rata-conserves
  (is (= 1000 (reduce + (vals (poi/pro-rata 1000 {"a" 1 "b" 1 "c" 1})))))
  (is (= {} (poi/pro-rata 1000 {"a" 0}))))
