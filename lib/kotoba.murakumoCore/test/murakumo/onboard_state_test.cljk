(ns murakumo.onboard-state-test
  "The state directory is where the label secret and the box's decryption key live, so what
  may be read and what is deleted when the claim goes through is pinned. The listening loop
  is covered end to end, with real ggwave PCM, by test/onboard_device_test.mjs."
  (:require [murakumo.onboard-state :as dev]
            [murakumo.onboard :as onboard]
            [kotoba.test :refer [deftest is testing]]
            ["node:fs" :as fs] ["node:os" :as os] ["node:path" :as path]))

(def ls "AAECAwQFBgcICQoLDA0ODw")

(defn- tmpdir [] (.mkdtempSync fs (.join path (.tmpdir os) "onboard-state-")))
(defn- put! [dir name text mode] (.writeFileSync fs (.join path dir name) text #js {:mode mode}))
(defn- mode-of [dir name] (bit-and (.-mode (.statSync fs (.join path dir name))) 511))

(deftest a-box-without-a-label-secret-does-not-beacon
  (is (= {:error :no-label-secret} (dev/label-secret (tmpdir)))))

(deftest the-label-secret-is-read-when-private-and-well-formed
  (let [d (tmpdir)]
    (put! d "label-secret" (str ls "\n") 384)
    (is (= {:label-secret ls} (dev/label-secret d)) "a trailing newline from an editor is tolerated")))

(deftest a-label-secret-others-can-read-is-refused-not-used
  (let [d (tmpdir)]
    (put! d "label-secret" ls 420)                      ; 0644
    (is (thrown? js/Error (dev/label-secret d)))))

(deftest a-malformed-label-secret-is-named
  (let [d (tmpdir)]
    (put! d "label-secret" "short" 384)
    (is (= {:error :bad-label-secret} (dev/label-secret d)))))

(deftest the-device-key-is-created-private-and-then-stable
  (let [d (tmpdir)
        a (dev/load-device-key! d)
        b (dev/load-device-key! d)]
    (is (= 384 (mode-of d "device-key.pem")))
    (is (= (onboard/public-key-b64url a) (onboard/public-key-b64url b))
        "the same key on the next boot, so a sender that heard an earlier beacon still fits")))

(deftest the-claim-retires-the-secrets-and-keeps-the-box-quiet
  (let [d (tmpdir)]
    (put! d "label-secret" ls 384)
    (dev/load-device-key! d)
    (dev/store-envelope! d {:code "K7QX3M" :fp "2c3b85f8" :message [87 1 2 3]})
    (is (= 384 (mode-of d "envelope.json")))
    (dev/retire! d)
    (doseq [n ["label-secret" "device-key.pem" "envelope.json"]]
      (is (not (.existsSync fs (.join path d n))) n))
    (is (= {:error :window-closed} (dev/label-secret d)))
    (testing "retiring twice, or an empty directory, is harmless"
      (dev/retire! d)
      (is (= {:error :window-closed} (dev/label-secret d))))))

(deftest the-stored-envelope-is-the-message-not-a-passphrase
  (let [d (tmpdir)]
    (dev/store-envelope! d {:code "K7QX3M" :fp "2c3b85f8" :message [87 1 2 3]})
    (let [text (.readFileSync fs (.join path d "envelope.json") "utf8")]
      (is (re-find #"\"suite\":\"x25519-hkdf-sha256-aes-256-gcm-v1-acoustic\"" text))
      (is (re-find #"\"message\":\"VwECAw==\"" text) "the four bytes as base64"))))
