(ns murakumo.poi-receipt-test
  (:require [kotoba.test :refer [deftest is testing]]
            [murakumo.infer.poi-receipt :as pr]
            [murakumo.infer.observation :as observation]
            [murakumo.poi.ledger :as ledger]
            ["node:fs" :as fs] ["node:os" :as os] ["node:path" :as path]))

(def json-body
  (str "{\"choices\":[{\"message\":{\"content\":\"ok\"}}],"
       "\"usage\":{\"completion_tokens\":4,\"prompt_tokens\":55,\"prompt_tokens_details\":{\"cached_tokens\":42}},"
       "\"timings\":{\"cache_n\":42,\"prompt_n\":13,\"prompt_ms\":1202.0,\"predicted_n\":4,\"predicted_ms\":305.6}}"))

(def sse-body
  (str "data: {\"choices\":[{\"delta\":{\"content\":\"o\"}}]}\n\n"
       "data: {\"choices\":[{\"delta\":{}}],\"timings\":{\"cache_n\":10,\"prompt_n\":20,\"prompt_ms\":900.0,\"predicted_n\":7,\"predicted_ms\":700.0}}\n\n"
       "data: [DONE]\n\n"))

(deftest usage-from-json-and-sse
  (is (= {:t-in 55 :t-out 4 :cached 42 :prompt-ms 1202.0 :predicted-ms 305.6} (pr/usage-of json-body)))
  (testing "a stream without usage falls back to llama.cpp timings"
    (is (= {:t-in 30 :t-out 7 :cached 10 :prompt-ms 900.0 :predicted-ms 700.0} (pr/usage-of sse-body))))
  (is (nil? (pr/usage-of "{\"error\":\"busy\"}")))
  (is (nil? (pr/usage-of "not json"))))

(deftest tail-keeps-the-end
  (let [t (reduce pr/tail "" (repeat 3000 "abcd"))]
    (is (= pr/tail-bytes (count t)))
    (is (= "abcd" (subs t (- (count t) 4))))))

(deftest signed-receipts-round-trip
  (let [dir (.mkdtempSync fs (.join path (.tmpdir os) "poi-receipt-"))
        key (observation/node-key! (.join path dir "node.key"))
        file (.join path dir "r.jsonl")
        payload (pr/receipt {:node "zebulun" :did (:did key) :job "job_12345678" :lane "mishima"
                             :model "mishima" :at 1000}
                            (pr/usage-of json-body))]
    (is (true? (pr/append! file key payload)))
    (let [[doc] (pr/since file 0)]
      (is (= "zebulun" (get-in doc [:payload :node])))
      (is (= 4 (get-in doc [:payload :t-out])))
      (is (nil? (get-in doc [:payload :content])) "no prompt or output is recorded")
      (is (true? (ledger/signed? doc)) "the coordinator can verify it against the node's did"))
    (is (= [] (pr/since file 1000)) "since is exclusive")))
