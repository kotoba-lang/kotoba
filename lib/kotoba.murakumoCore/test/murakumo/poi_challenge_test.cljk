(ns murakumo.poi-challenge-test
  (:require [kotoba.test :refer [deftest is testing async]]
            [murakumo.poi.challenge :as challenge]
            [murakumo.infer.poi-receipt :as pr]
            [murakumo.infer.observation :as observation]
            [murakumo.poi.ledger :as ledger]
            ["node:fs" :as fs] ["node:os" :as os] ["node:path" :as path] ["node:http" :as http]))

(def topology
  {"nodes" [{"node" "judah" "enabled" true "url" "http://100.113.200.45:8796/"}
            {"node" "levi" "url" "http://100.102.78.81:9796"}
            {"node" "off" "enabled" false "url" "http://100.1.1.1:8796"}
            {"node" "no-url" "enabled" true}]})

(deftest topology-residents
  (is (= {"100.113.200.45" {:name "judah" :url "http://100.113.200.45:8796"}
          "100.102.78.81" {:name "levi" :url "http://100.102.78.81:9796"}}
         (challenge/topology-residents topology))
      "enabled nodes with a URL, keyed by host, trailing slash dropped"))

(deftest resident-url
  (testing "the topology's resident URL wins over the head's model-server port"
    (is (= "http://100.102.78.81:9796"
           (challenge/resident-url {:url "http://100.102.78.81:8094"
                                    :resident-url "http://100.102.78.81:9796/"}))))
  (testing "a head the topology does not name uses the default resident port"
    (is (= "http://100.96.122.69:8796"
           (challenge/resident-url {:url "http://100.96.122.69:8094"})))))

(defn- tmp [prefix] (.mkdtempSync fs (.join path (.tmpdir os) prefix)))

(deftest collect-reads-receipts-from-the-resident-url
  (async done
    (let [node-dir (tmp "poi-node-")
          node-key (observation/node-key! (.join path node-dir "node.key"))
          file (.join path node-dir "r.jsonl")
          _ (pr/append! file node-key
                        (pr/receipt {:node "levi" :did (:did node-key) :job "job_12345678"
                                     :lane "mishima" :model "mishima" :at 1000}
                                    {:t-in 55 :t-out 4 :cached 42}))
          paths (atom [])
          server (.createServer http
                                (fn [req res]
                                  (swap! paths conj (.-url req))
                                  (.end res (js/JSON.stringify
                                             (clj->js {:node "levi" :did (:did node-key)
                                                       :receipts (pr/since file 0)})))))]
      (.listen server 0 "127.0.0.1"
               (fn []
                 (let [port (.-port (.address server))
                       dir (tmp "poi-coord-")
                       key (observation/node-key! (.join path dir "coordinator.key"))
                       ;; the model server is on another port; only the resident serves receipts
                       head {:name "levi" :url "http://127.0.0.1:1"
                             :resident-url (str "http://127.0.0.1:" port)}]
                   (-> (challenge/collect! dir key [head])
                       (.then (fn [result]
                                (is (= {"levi" 1} result))
                                (is (= ["/poi/receipts?since=0"] @paths))
                                (is (= (:did node-key) (get (ledger/node-dids dir) "levi")))))
                       (.catch (fn [e] (is false (str e))))
                       (.finally (fn [] (.close server) (done))))))))))
