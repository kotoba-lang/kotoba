(ns murakumo.settle
  "Test support: assert on a value that is a Promise on kbb.

   bonsai.repo/persist! (and everything that continues after a snapshot, via
   murakumo.blob/then) returns the value on the JVM and a js/Promise on kbb.
   `settle` runs `check` on the value directly on the JVM, and as an async
   test on kbb, so a test body reads the same on both hosts. It must be the
   last form of the deftest body."
  (:require #?(:clj [kotoba.test :refer [is]]
               :cljs [cljs.test :refer [is async] :include-macros true])))

(defn settle [x check]
  #?(:clj (check x)
     :cljs (async done
             (-> (js/Promise.resolve x)
                 (.then check)
                 (.catch (fn [e] (is (nil? e) (str "settled with an error: " (ex-message e)))))
                 (.then (fn [_] (done)))))))
