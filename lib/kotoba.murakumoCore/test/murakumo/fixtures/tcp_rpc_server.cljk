(ns murakumo.fixtures.tcp-rpc-server
  "A child-process RPC server for the tcp-driver tests: the client under test is synchronous
  and would block the event loop of any server hosted in the same process.
  Usage: <script> echo|silent. Prints the listening line, then serves until killed."
  (:require [murakumo.overlay.tcp-driver :as tcp]))

(let [mode (first *command-line-args*)
      request {:type "murakumo.overlay.adapter-request" :version 1 :transport :tcp
               :session {:overlay "test" :node "n1"} :connect {:host "127.0.0.1" :port 0}}
      handler (fn [payload]
                (cond
                  (= :boom payload) (throw (ex-info "handler failed" {}))
                  (= "silent" mode) (js/Promise. (fn [_ _] nil))   ; never answers: not used, see below
                  :else {:echo payload}))]
  (if (= "silent" mode)
    ;; accept and say nothing: a raw server, so the client's timeout is what is measured
    (let [net (js/require "node:net")
          server (.createServer net (fn [socket] (.on socket "error" (fn [_] nil))))]
      (.listen server 0 "127.0.0.1" (fn [] (println (pr-str {:ok? true :mode :listening :listen {:port (.-port (.address server))}})))))
    (-> (tcp/start-rpc-server! request handler)
        (.then (fn [{:keys [port]}]
                 (println (pr-str {:ok? true :mode :listening :listen {:port port}}))))
        (.catch (fn [e] (println (pr-str {:ok? false :error (.-message e)})) (js/process.exit 1))))))
