(ns murakumo.fleet-ps-test
  "fleet ps parsing, on probe output captured from joseph (M4 16 GB head) on
  2026-09-25 -- verbatim, not a hand-written approximation. It pins: numbers
  come back as numbers (a string :free-pct sorts and compares wrongly without
  throwing), the model server's ctx / KV / flash-attn / parallel are read from
  its own argv, and a node process started by `npm exec` under a launchd job
  is attributed to that job through its parent pid."
  (:require [kotoba.test :refer [deftest is testing run-tests]]
            [kotoba.lang.text :as str]
            [murakumo.fleet-ps :as fp]))

(def joseph "HOST=josephnoMac-mini
OS=Darwin
MEM_BYTES=17179869184
FREE_PCT=74
SWAP_USED_MB=31391.31
PROC	32640	1	2678688	/Users/Shared/murakumo/mishima/bin/llama-server -m /Users/Shared/murakumo/mishima/model/Ternary-Bonsai-2-27B-PTQ1_0.gguf --host 100.82.123.35 --port 8094 --ctx-size 32768 --parallel 1 -ngl 999 --no-webui -fa on -ctk q8_0 -ctv q8_0
PROC	1113	1	2340496	/Users/joseph/.murakumo/bin/kotoba-server
PROC	97852	1	970544	node /Users/joseph/.inga/releases/inga-origin-20260911/engine/cli.js --config /Users/joseph/.inga/releases/inga-origin-20260911/source-only.edn --classpath /Users/joseph/.inga/releases/inga-origin-20260911/inga/src:/Users/joseph/.inga/releases/inga-origin-20260911/inga-node/src:/Users/joseph/.inga/releases/inga-origin-20260911/text/src:/Users/joseph/.inga/releases/inga-origin-20260911/kotobase-client/src:/Users/joseph/.inga/releases/inga-origin-20260911/sha2/src:/Users/joseph/.inga/releases/inga-origin-20260911/kotobase-storage/src /Users/joseph/.inga/releases/inga-origin-20260911/inga-node/script/run.cljk
PROC	1181	1108	893376	node /Users/joseph/.npm/_npx/f77abc9b469a86df/node_modules/.bin/nbb --classpath src:inga/src script/run.cljs
MODEL	32640	1	2678688	/Users/Shared/murakumo/mishima/bin/llama-server -m /Users/Shared/murakumo/mishima/model/Ternary-Bonsai-2-27B-PTQ1_0.gguf --host 100.82.123.35 --port 8094 --ctx-size 32768 --parallel 1 -ngl 999 --no-webui -fa on -ctk q8_0 -ctv q8_0
SERVICE	com.gftd.inga-node.read-audit.w4	running	1108
SERVICE	com.gftd.inga.reservation.20260911.w4	running	97852
SERVICE	com.murakumo.kotoba-mesh	running	1113
SERVICE	com.murakumo.mishima	running	32640
SERVICE	com.murakumo.sysctl-baseline	not running	
SERVICE	ai.gftd.cloudflared	not-loaded	
SERVICE	com.gftd.inga-node.read-audit.w4	not-loaded	
")

(deftest parse-probe-reads-numbers-and-rows
  (let [p (fp/parse-probe joseph)]
    (is (= "josephnoMac-mini" (:host p)))
    (is (= "Darwin" (:os p)))
    (is (number? (:mem-bytes p)))
    (is (= 17179869184 (:mem-bytes p)))
    (is (number? (:free-pct p)))
    (is (number? (:swap-used-mb p)))
    (is (= 1 (count (:models p))))
    (is (= 4 (count (:procs p))))
    (is (every? number? (map :rss-kb (:procs p))))
    ;; 7, not 6: com.gftd.inga-node.read-audit.w4 is both a running system
    ;; daemon and a never-loaded user agent plist on joseph
    (is (= 7 (count (:services p))))))

(deftest model-argv
  (let [a (fp/parse-model-cmd (:cmd (first (:models (fp/parse-probe joseph)))))]
    (is (= "llama-server" (:engine a)))
    (is (= "Ternary-Bonsai-2-27B-PTQ1_0.gguf" (:model a)))
    (is (= 32768 (:ctx a)))
    (is (= 1 (:parallel a)))
    (is (= ["q8_0" "q8_0"] [(:kv-k a) (:kv-v a)]))
    (is (= "on" (:flash-attn a)))
    (is (= ["100.82.123.35" 8094] [(:host a) (:port a)]))))

(deftest owner-through-parent-pid
  (let [p (fp/parse-probe joseph)
        by-pid (into {} (map (juxt :pid identity) (:procs p)))]
    (testing "launchd job pid is the process itself"
      (is (= "com.murakumo.kotoba-mesh" (fp/owner-label (:services p) (by-pid 1113))))
      (is (= "com.gftd.inga.reservation.20260911.w4" (fp/owner-label (:services p) (by-pid 97852)))))
    (testing "npm exec wrapper is the launchd job; node is its child"
      (is (= "com.gftd.inga-node.read-audit.w4" (fp/owner-label (:services p) (by-pid 1181)))))))

(deftest unit-states-keep-the-whole-word
  (let [s (into {} (map (juxt :label :state) (:services (fp/parse-probe joseph))))]
    (is (= "running" (s "com.murakumo.mishima")))
    (is (= "not running" (s "com.murakumo.sysctl-baseline")))
    (is (= "not-loaded" (s "ai.gftd.cloudflared")))))

(deftest render-and-exit-code
  (let [node {:name "joseph" :ip "100.82.123.35"}
        ok (fp/render-node {:node node :probe (fp/parse-probe joseph)
                            :slots {32640 {:n-ctx 32768 :busy 0 :total 1}}})]
    (is (str/includes? ok "ctx 32768  kv q8_0/q8_0  fa on  parallel 1"))
    (is (str/includes? ok "slots 0/1 busy"))
    (is (str/includes? ok "[com.gftd.inga-node.read-audit.w4]"))
    (is (str/includes? ok "kotoba-server  [com.murakumo.kotoba-mesh]")))
  (is (str/includes? (fp/render-node {:node {:name "jacob" :ip "100.117.208.83"} :error "ssh exit 255"})
                     "UNREACHABLE  ssh exit 255"))
  (is (= 0 (fp/exit-code [{:probe {}}])))
  (is (= 1 (fp/exit-code [{:probe {}} {:error "x"}])))
  (is (= 2 (fp/exit-code []))))

(run-tests)
