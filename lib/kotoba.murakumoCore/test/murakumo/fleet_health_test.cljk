(ns murakumo.fleet-health-test
  "Offline tests for `murakumo fleet health`: did:key envelope verification
  and the problem assessment. No network, no tailscale."
  (:require [cljs.test :refer [deftest is testing run-tests]]
            [murakumo.fleet-health :as fh]
            ["node:crypto" :as crypto]))

(def ^:private b58 "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz")

(defn- base58
  "Plain-number base58 (byte-at-a-time carry), so the test needs no BigInt ops."
  [bytes]
  (let [digits (reduce (fn [digits b]
                         (loop [[d & more] digits carry b out []]
                           (if (nil? d)
                             (loop [c carry out out] (if (pos? c) (recur (quot c 58) (conj out (mod c 58))) out))
                             (let [x (+ (* d 256) carry)] (recur more (quot x 58) (conj out (mod x 58)))))))
                       [] (array-seq bytes))]
    (apply str (map #(.charAt b58 %) (reverse digits)))))

(defn- signed [payload]
  (let [kp (crypto/generateKeyPairSync "ed25519")
        der (.export (.-publicKey kp) #js {:type "spki" :format "der"})
        raw (.subarray der (- (.-length der) 32))
        did (str "did:key:z" (base58 (js/Buffer.concat #js [(js/Buffer.from #js [0xed 0x01]) raw])))
        p (js/JSON.stringify (clj->js payload))]
    {"payload" p "did" did "sig" (.toString (crypto/sign nil (js/Buffer.from p) (.-privateKey kp)) "base64")}))

(deftest verifies-did-key-envelopes
  (let [env (signed {"did" "x" "load" 0})]
    (is (= 0 (get (fh/verify-envelope env) "load")))
    (is (nil? (fh/verify-envelope (assoc env "payload" "{\"load\":1}"))) "tampered payload")
    (is (nil? (fh/verify-envelope (assoc env "did" "did:key:zNotAKey"))) "bad did")))

(deftest assesses-problems
  (let [ok-peer {:status :ok :info {"agent_models" ["mishima"]
                                    "health" {"pressure_level" 1 "mem_free_pct" 40 "tcp_time_wait" 10
                                              "revision" "aaa" "rails" [{"name" "r" "ok" true "agent" true}]}}}]
    (is (= [] (fh/problems {:online true :peer ok-peer} true "aaa")))
    (testing "expected peer offline / down"
      (is (re-find #"offline" (first (fh/problems {:online false :last-seen "t" :peer {:status :offline}} true "aaa"))))
      (is (re-find #"peer down" (first (fh/problems {:online true :peer {:status :down}} true "aaa")))))
    (testing "a node outside the mesh is not a problem for having no peer"
      (is (= [] (fh/problems {:online true :peer {:status :down}} false "aaa"))))
    (testing "pressure, port exhaustion, rails, revision drift"
      (let [p (fh/problems {:online true
                            :peer (update-in ok-peer [:info "health"] merge
                                             {"pressure_level" 4 "tcp_time_wait" 71472 "revision" "bbb"
                                              "rails" [{"name" "r" "ok" false "agent" true}]})}
                           true "aaa")]
        (is (some #(re-find #"CRITICAL" %) p))
        (is (some #(re-find #"TIME_WAIT" %) p))
        (is (some #(re-find #"rail down" %) p))
        (is (some #(re-find #"revision bbb" %) p))))))

(defmethod cljs.test/report [:cljs.test/default :end-run-tests] [m]
  (when-not (cljs.test/successful? m) (set! (.-exitCode js/process) 1)))

(run-tests)
