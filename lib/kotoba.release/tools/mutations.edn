;; One mutation per invariant. `:find` must occur EXACTLY ONCE in `:file`.
;;
;; ## SCOPE
;;
;; Covers `kotoba.release.admission`, the namespace the 2026-08-18
;; `.clj` → `.cljc` conversion moved: that every authority is actually
;; consulted, that each failure is reported under its OWN name rather than
;; merely as "denied", that the artifact digest binds the receipts and the
;; envelope, and that `admit!` refuses rather than returning.
;;
;; It does NOT cover `kotoba.release.tag` or `kotoba.release.cli`, which are
;; still `.clj` (see `tag.clj`'s docstring for why), and it does NOT cover
;; the eight `kotoba.security.*` evaluators — those belong to
;; `kotoba-lang/security` and are measured there. A clean run here means
;; "the admission decision is measured", not "release assurance is
;; measured".
;;
;; ⚠ These mutations drive `kbb -M:test`, which on this repo runs the
;; `.clj` suites too. `test/run_portable.cljk` runs the admission suite
;; under nbb and this harness does not invoke it. There is no reader
;; conditional in `admission.cljc` at all — that is the point of it — so
;; there is no `:cljs` branch here for a mutation to miss.
[{:id :a-denied-request-is-refused-not-returned
  :invariant "admit! throws rather than handing back a denial"
  :file "src/kotoba/release/admission.cljk"
  :find "(when-not (:release/allowed? result)"
  :replace "(when-not true"}

 {:id :allowed-means-no-violations-at-all
  :invariant ":release/allowed? is (empty? violations), not (some?)"
  :file "src/kotoba/release/admission.cljk"
  :find "{:release/allowed? (empty? violations)"
  :replace "{:release/allowed? (some? violations)"}

 {:id :the-capability-is-scoped-to-the-release-audience
  :invariant "a token minted for another audience does not admit a release"
  :file "src/kotoba/release/admission.cljk"
  :find ":audience :kotoba-lang/release"
  :replace ":audience :anything-at-all"}

 {:id :the-capability-is-scoped-to-the-publish-action
  :invariant "a token for some other action does not admit a publish"
  :file "src/kotoba/release/admission.cljk"
  :find ":action :release/publish\n                 :resource repository"
  :replace ":action :release/read\n                 :resource repository"}

 {:id :the-telemetry-receipt-is-bound-to-this-artifact
  :invariant "a valid receipt for a DIFFERENT artifact is not evidence"
  :file "src/kotoba/release/admission.cljk"
  :find "(not= artifact-digest (:qualification/artifact-digest telemetry-result))"
  :replace "false"}

 {:id :the-restore-attestation-is-bound-to-this-artifact
  :invariant "same, for the restore drill's attestation"
  :file "src/kotoba/release/admission.cljk"
  :find "(not= artifact-digest\n                (:qualification/artifact-digest restore-attestation-result))"
  :replace "false"}

 {:id :the-envelope-is-bound-to-this-artifact
  :invariant "a well-formed hybrid envelope over other bytes is not evidence"
  :file "src/kotoba/release/admission.cljk"
  :find "(not= artifact-digest (:envelope/artifact-digest artifact-envelope))"
  :replace "false"}

 {:id :a-transport-failure-is-named-a-transport-failure
  :invariant "violations are distinct diagnoses, not one interchangeable
              'denied' — an audit record that calls a forged approval a
              transport problem is wrong even though the request is refused
              either way"
  :file "src/kotoba/release/admission.cljk"
  :find "(conj :release-transport)"
  :replace "(conj :signed-capability)"}

 {:id :the-abac-action-carries-the-publish-capability
  :invariant "the policy is asked about publishing, not about nothing"
  :file "src/kotoba/release/admission.cljk"
  :find ":capabilities #{:artifact/publish}"
  :replace ":capabilities #{}"}

 {:id :the-abac-resource-is-the-repository-being-released
  :invariant "the policy is asked about THIS repository"
  :file "src/kotoba/release/admission.cljk"
  :find "{:id repository}"
  :replace "{:id \"kotoba-lang/somewhere-else\"}"}

 {:id :the-approvals-are-bound-to-the-request-digest
  :invariant "approvals for another artifact do not carry over"
  :file "src/kotoba/release/admission.cljk"
  :find "(assoc approval-context\n                                  :request-digest artifact-digest)"
  :replace "approval-context"}

 {:id :the-hardware-evidence-is-actually-consulted
  :invariant "the signing-hardware result reaches the violation list"
  :file "src/kotoba/release/admission.cljk"
  :find "(not (:hardware-signing/qualified? hardware-result))"
  :replace "false"}

 {:id :the-report-names-the-repository
  :invariant "the returned decision says what it was about"
  :file "src/kotoba/release/admission.cljk"
  :find ":release/repository repository"
  :replace ":release/repository nil"}

 {:id :the-report-carries-the-hardware-result
  :invariant "each sub-result is in the record an auditor reads"
  :file "src/kotoba/release/admission.cljk"
  :find ":release/hardware-signing hardware-result"
  :replace ":release/hardware-signing nil"}]
