(ns rtc.media-test (:export [main]) (:require [rtc.media :as p]))

(defn- ok [b :bool] :i64
  (if b 0 1))

(defn- default-expected [] :document
  (document-map :audio (document-bool true) :video (document-bool true)
                :video-width (document-i64 640) :video-height (document-i64 480)
                :frame-rate (document-i64 30)))

(defn- constraint-checks [] :i64
  (+ (ok (document-equal? (p/media-constraints-default) (default-expected)))
     (ok (document-equal? (p/audio-only-constraints)
                          (document-map :audio (document-bool true) :video (document-bool false)
                                        :video-width (document-i64 640) :video-height (document-i64 480)
                                        :frame-rate (document-i64 30))))
     (ok (document-equal? (p/hd-video-constraints)
                          (document-map :audio (document-bool true) :video (document-bool true)
                                        :video-width (document-i64 1280) :video-height (document-i64 720)
                                        :frame-rate (document-i64 30))))))

(defn- override-checks [] :i64
  (+ (ok (document-equal? (p/media-constraints (document-map :video-width (document-i64 800) :audio (document-null)))
                          (document-map :audio (document-null) :video (document-bool true)
                                        :video-width (document-i64 800) :video-height (document-i64 480)
                                        :frame-rate (document-i64 30))))
     (ok (document-set-contains? (p/media-kinds) (document-keyword :screen-share)))
     (ok (document-set-contains? (p/track-states) (document-keyword :muted)))))

(defn- stats-checks [] :i64
  (ok (document-equal? (p/track-stats)
                       (document-map :bytes-sent (document-i64 0) :bytes-received (document-i64 0)
                                     :packets-lost (document-i64 0) :jitter-ms (document-f64 0.0)
                                     :round-trip-ms (document-f64 0.0)))))

(defn main [] :i64
  (+ (constraint-checks) (override-checks) (stats-checks)))
