;; Port of rtc.media (media.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from media.cljk:
;;   - The source's 0-arity `media-constraints` is `media-constraints-default`.
;;   - `media-kinds` and `track-states` are zero-arg functions (sets).
;;   - Defaults follow Clojure `:or` semantics: a default applies only when
;;     the key is absent; a present null value is kept as given.
;;   - The f64 counters are built with document-f64; no f64 arithmetic is done.

(ns rtc.media
  (:export [media-kinds track-states media-constraints media-constraints-default
            audio-only-constraints hd-video-constraints track-stats]))

(defn- or-default [m :document k :keyword d :document] :document
  (if (map? m)
    (option-or (document-get m k) d)
    d))

(defn media-kinds [] :document
  (document-set (document-keyword :audio)
                (document-keyword :video)
                (document-keyword :screen-share)))

(defn track-states [] :document
  (document-set (document-keyword :active)
                (document-keyword :muted)
                (document-keyword :ended)))

(defn media-constraints [opts :document] :document
  (document-map :audio (or-default opts :audio (document-bool true))
                :video (or-default opts :video (document-bool true))
                :video-width (or-default opts :video-width (document-i64 640))
                :video-height (or-default opts :video-height (document-i64 480))
                :frame-rate (or-default opts :frame-rate (document-i64 30))))

(defn media-constraints-default [] :document
  (media-constraints (document-map)))

(defn audio-only-constraints [] :document
  (media-constraints (document-map :audio (document-bool true)
                                   :video (document-bool false))))

(defn hd-video-constraints [] :document
  (media-constraints (document-map :audio (document-bool true)
                                   :video (document-bool true)
                                   :video-width (document-i64 1280)
                                   :video-height (document-i64 720)
                                   :frame-rate (document-i64 30))))

(defn track-stats [] :document
  (document-map :bytes-sent (document-i64 0)
                :bytes-received (document-i64 0)
                :packets-lost (document-i64 0)
                :jitter-ms (document-f64 0.0)
                :round-trip-ms (document-f64 0.0)))
