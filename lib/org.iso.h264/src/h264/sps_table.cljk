(ns h264.sps-table
  "Table-driven counterpart of `h264.sps/parse`, built to be COMPARED with it
   rather than to replace it. `h264.sps` stays the shipping parser; this
   namespace exists so the compression claim in docs/adr can be judged on
   evidence (test/h264/syntax_equivalence_test.cljk asserts the two agree,
   field for field, on this repo's real fixtures and on synthetic
   high-profile streams the incumbent's own tests never reach).

   The split is the standard's own:

     §7.3.2.1.1 syntax     -> resources/h264/syntax/sps.edn   (DATA)
     generic reader        -> h264.syntax                     (CODE, reused)
     §7.3.2.1.1.1 escape   -> `scaling-list-escape` below      (CODE, 8 lines)
     §7.4.2.1.1 semantics  -> `semantics` below                   (CODE, 12 lines)

   `semantics` reproduces `h264.sps/parse`'s arithmetic EXACTLY, including
   where that arithmetic departs from §7.4.2.1.1 (see the ChromaArrayType
   note on `crop-unit-x`). Equivalence with the incumbent is the claim being
   tested; silently \"fixing\" the incumbent inside the challenger would
   destroy the only evidence this file is here to produce."
  (:require [h264.expgolomb :as eg]
            [h264.syntax :as syntax]
            [kotoba.lang.edn :as edn]
            #?(:clj [kotoba.io :as io])))

(defn scaling-list-escape
  "ISO/IEC 14496-10 §7.3.2.1.1.1 scaling_list( ). Consumes the right number
   of bits and discards the values, matching `h264.sps`'s own scope.

   This is the honest exit door from the table. The standard prints
   scaling_list( ) as a table, but three of its lines are ASSIGNMENTS
   (lastScale/nextScale/useDefaultScalingMatrixFlag), not (name, descriptor,
   condition) rows: the loop's continuation depends on a running value the
   loop itself computes. No (name, descriptor, condition) triple determines
   that. Only `delta_scale se(v)` and the `if( nextScale != 0 )` gate are
   declarative; the rest is a state machine and lives here."
  [r vals _args]
  (let [size (nth _args 1)]
    (loop [j 0 last-scale 8 next-scale 8]
      (if (>= j size)
        vals
        (if (zero? next-scale)
          (recur (inc j) last-scale next-scale)
          (let [delta (eg/se! r)
                ns2   (mod (+ last-scale delta 256) 256)]
            (recur (inc j) (if (zero? ns2) last-scale ns2) ns2)))))))

(def escapes {:h264/scaling-list scaling-list-escape})

(defn semantics
  "ISO/IEC 14496-10 §7.4.2.1.1 semantics over the raw §7.3.2.1.1 element map
   `e`, producing the map shape `h264.sps/parse` returns.

   Twelve lines, and they are the honest cost of the design: none of this is
   in the syntax table, because none of it is in §7.3. Claiming otherwise
   would be the lie the ADR is written to avoid."
  [e]
  (let [cfi             (:chroma_format_idc e)
        frame-mbs-only? (= 1 (:frame_mbs_only_flag e))
        ;; NOTE: mirrors h264.sps/parse exactly. §7.4.2.1.1 additionally says
        ;; CropUnitX = 1 / CropUnitY = 2 - frame_mbs_only_flag when
        ;; ChromaArrayType == 0 (monochrome, or separate_colour_plane_flag);
        ;; neither this nor the incumbent implements that case. Kept
        ;; divergent-together on purpose — see the namespace docstring.
        sub-width-c     (if (= cfi 3) 1 2)
        sub-height-c    (if (= cfi 1) 2 (if (= cfi 3) 1 1))
        crop-unit-x     sub-width-c
        crop-unit-y     (* sub-height-c (if frame-mbs-only? 1 2))
        width  (- (* (inc (:pic_width_in_mbs_minus1 e)) 16)
                  (* crop-unit-x (+ (:frame_crop_left_offset e) (:frame_crop_right_offset e))))
        height (- (* (if frame-mbs-only? 1 2) (inc (:pic_height_in_map_units_minus1 e)) 16)
                  (* crop-unit-y (+ (:frame_crop_top_offset e) (:frame_crop_bottom_offset e))))]
    {:profile-idc (:profile_idc e)
     :level-idc   (:level_idc e)
     :chroma-format-idc cfi
     :frame-mbs-only? frame-mbs-only?
     :width  width
     :height height
     :log2-max-frame-num-minus4 (:log2_max_frame_num_minus4 e)
     :pic-order-cnt-type (:pic_order_cnt_type e)
     ;; absent from the element map unless pic_order_cnt_type == 0, which is
     ;; exactly the incumbent's nil
     :log2-max-pic-order-cnt-lsb-minus4 (:log2_max_pic_order_cnt_lsb_minus4 e)}))

(defn elements
  "Read the raw §7.3.2.1.1 syntax-element map from an unescaped SPS RBSP
   (NAL header byte at index 0, this repo's convention) using `table`."
  [table rbsp]
  (syntax/read-bytes rbsp table escapes))

(defn parse
  "Table-driven equivalent of `h264.sps/parse`."
  [table rbsp]
  (semantics (elements table rbsp)))

(defn load-table
  "Load resources/h264/syntax/sps.edn. Reading a classpath resource is
   host-specific and that seam is the one place this design is not portable
   data: :clj uses io/resource + slurp, :cljs reads the file from disk
   relative to the repo root. The reader itself (h264.syntax) is pure cljc
   and takes the table as an argument."
  []
  (edn/read-string
   #?(:clj (slurp (io/resource "h264/syntax/sps.edn"))
      :cljs (str (.readFileSync (js/require "fs") "resources/h264/syntax/sps.edn")))))
