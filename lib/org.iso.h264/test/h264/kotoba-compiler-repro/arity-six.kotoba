(ns arity-six (:export [f]))
;; Reproduction 2. Not a defect: guest-grammar.edn's :admission-limits sets
;; :max-parameters 5, and the frontend enforces it. Recorded because it is the
;; constraint that forced this repo's kernel to be the 1-D transform operator
;; rather than the 2-D one: sixteen coefficients cannot cross as parameters.
(defn f [a :i64 b :i64 c :i64 d :i64 e :i64 g :i64] :i64
  (+ a (+ b (+ c (+ d (+ e g))))))
