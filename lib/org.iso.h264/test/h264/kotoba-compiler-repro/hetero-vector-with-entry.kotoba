(ns hetero-vector-with-entry (:export [main]))
;; Discriminator for reproduction 4. The JVM compiler path
;; (`kbb -M:kotoba`, which this repo's CI uses) rejects the entryless
;; wasm32-hetero-vector.kotoba with a DIFFERENT and informative diagnostic:
;;   :error :target, :message "entryless libraries currently require the
;;   kotoba-script web target", :details {:phase :target
;;                                        :target :wasm32-browser-kotoba-v1}
;; This file has an entry, so that explanation does not apply to it — and
;; `bin/amu compile --target wasm32` still exits 70 with the bare
;; :kotoba/internal-error "internal compiler error". So on the nbb path the
;; trigger really is `hetero-vector-at`, and the generic message is hiding it.
(def pair-type [:vector [:i64 :i64]])
(defn main [] :i64
  (hetero-vector-at pair-type (hetero-vector pair-type 42 7) 0))
