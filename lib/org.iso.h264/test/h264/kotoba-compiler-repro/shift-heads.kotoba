(ns shift-heads (:export [f]))
;; Reproduction 1. `bit-shift-right` is listed in
;; kotoba-lang/kotoba-lang lang/guest-grammar.edn :admitted-builtins, but the
;; amu frontend has no admitted lowering for it. Same for bit-shift-left,
;; unsigned-bit-shift-right, mod, rem, min, max and `/`. `quot`, `bit-and`,
;; `bit-or`, `bit-xor`, `inc`, `dec`, `cond` and `case` from the same set are
;; admitted. Swap the body for any of those names to see the same rejection.
(defn f [a :i64] :i64 (bit-shift-right a 6))
