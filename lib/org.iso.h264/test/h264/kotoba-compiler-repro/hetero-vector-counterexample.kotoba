(ns hetero-vector-counterexample (:export [f]))
;; The counterexample that localises reproduction 4. Same tuple type, same
;; construction, no `hetero-vector-at` — compiles to wasm32 with exit 0.
(def pair-type [:vector [:i64 :i64]])
(def res-type [:result [:alias pair-type] :keyword])
(defn f [a :i64] [:alias res-type]
  (result-ok-of res-type (hetero-vector pair-type a a)))
