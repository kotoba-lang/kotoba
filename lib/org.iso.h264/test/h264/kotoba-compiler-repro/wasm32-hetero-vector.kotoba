(ns wasm32-hetero-vector (:export [f]))
;; Reproduction 4, MINIMAL. `amu compile --target wasm32` (and
;; --target wasm32-browser) exits 70 with
;;   {:code :kotoba/internal-error, :message "internal compiler error"}
;; on this four-line file. `amu check` on the same file exits 0, and
;; `--target aarch64` rejects it for the expected typed-value reason rather
;; than crashing.
;;
;; The trigger is `hetero-vector-at`, not the tuple type itself:
;; hetero-vector-counterexample.kotoba constructs the same
;; [:vector [:i64 :i64]] value and compiles to wasm32 cleanly. So does
;; src/h264/rbsp.kotoba, and so does a plain [:result :i64 :keyword].
;;
;; This is why src/h264/expgolomb.kotoba, whose result type is
;; [:result [:vector [:i64 :i64]] :keyword] and which reads every result with
;; hetero-vector-at, cannot be compiled to wasm32 through bin/amu, while the
;; scalar kernels in src/h264/{quant,transform}.kotoba can.
(def pair-type [:vector [:i64 :i64]])
(defn f [a :i64 b :i64] :i64
  (hetero-vector-at pair-type (hetero-vector pair-type a b) 0))
