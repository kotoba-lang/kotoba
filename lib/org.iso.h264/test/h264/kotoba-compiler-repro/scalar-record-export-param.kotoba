(ns scalar-record-export-param (:export [pick build]))
;; Reproduction 3b. The same aggregate shape as vector-export-param.kotoba,
;; spelled as a scalar record, compiles for aarch64 AND wasm32. On wasm it
;; pulls in the 45-function kotoba:typed host import surface; the scalar-only
;; kernels in src/h264 emit a module with zero imports.
(def q4 [:record :repro/q4 [[:a :i64] [:b :i64] [:c :i64] [:d :i64]]])
(defn build [a :i64 b :i64 c :i64 d :i64] [:alias q4] (record q4 a b c d))
(defn pick [v [:alias q4] k :i64] :i64
  (cond (= k 0) (record-get q4 v :a) (= k 1) (record-get q4 v :b)
        (= k 2) (record-get q4 v :c) :else (record-get q4 v :d)))
