(ns native-sixteen-field-record (:export [pick]))
;; Reproduction 3c, and the most useful of the three for this repo's next
;; step. A record with SIXTEEN :i64 fields compiles for aarch64 with exit 0,
;; and `amu extract-native --symbol pick` reports `:arity 2` — the whole
;; aggregate crosses the native boundary as ONE argument. So a full 4x4
;; coefficient block CAN reach a native export, and the five-parameter limit
;; is not the last word on it; what stopped this repo's kernel from taking
;; the 2-D transform in one call is that a record makes the WASM artifact
;; pull in the 45-function kotoba:typed import surface, which would cost the
;; zero-import property the scalar kernels have.
(def blk [:record :repro/blk
          [[:c0 :i64] [:c1 :i64] [:c2 :i64] [:c3 :i64]
           [:c4 :i64] [:c5 :i64] [:c6 :i64] [:c7 :i64]
           [:c8 :i64] [:c9 :i64] [:c10 :i64] [:c11 :i64]
           [:c12 :i64] [:c13 :i64] [:c14 :i64] [:c15 :i64]]])
(defn pick [v [:alias blk] k :i64] :i64
  (cond (= k 0) (record-get blk v :c0) (= k 1) (record-get blk v :c1)
        (= k 14) (record-get blk v :c14) :else (record-get blk v :c15)))
