(ns vector-export-param (:export [sum-at]))
;; Reproduction 3a. A :vector-i64 parameter compiles for wasm32 and
;; wasm32-browser and is rejected by aarch64 and x86_64. Paired with
;; scalar-record-export-param.kotoba, which is the same shape of aggregate and
;; IS accepted natively.
(defn sum-at [xs :vector-i64 k :i64] :i64
  (+ (vector-at xs k) (vector-count xs)))
