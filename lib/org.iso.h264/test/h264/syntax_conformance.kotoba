(ns h264.syntax-conformance
  (:require [h264.syntax :as syntax])
  (:export [main]))

;; ISO/IEC 14496-10 §7.3.2.1.1 seq_parameter_set_data( ) as DATA, in the guest
;; grammar's inert document form. This is the same table as
;; resources/h264/syntax/sps.edn, and the same bytes as
;; test/h264/sps_conformance.kotoba -- a real libx264 baseline SPS. The point
;; of the exercise is that these rows are the only thing a new codec adds.

(def state-type [:vector [:document :i64]])
(def state-result-type [:result [:alias state-type] :keyword])
(def i64-result-type [:result :i64 :keyword])

(defn sps-table [] :document
  (document
   [[:u 8 :nal_header_byte]
    [:u 8 :profile_idc]
    [:u 1 :constraint_set0_flag]
    [:u 1 :constraint_set1_flag]
    [:u 1 :constraint_set2_flag]
    [:u 1 :constraint_set3_flag]
    [:u 1 :constraint_set4_flag]
    [:u 1 :constraint_set5_flag]
    [:u 2 :reserved_zero_2bits]
    [:u 8 :level_idc]
    [:ue :seq_parameter_set_id]
    [:when [:in [:var :profile_idc]
            [100 110 122 244 44 83 86 118 128 138 139 134 135]]
     [[:ue :chroma_format_idc]
      [:when [:= [:var :chroma_format_idc] 3]
       [[:u 1 :separate_colour_plane_flag]]]
      [:ue :bit_depth_luma_minus8]
      [:ue :bit_depth_chroma_minus8]
      [:u 1 :qpprime_y_zero_transform_bypass_flag]
      [:u 1 :seq_scaling_matrix_present_flag]
      [:when [:= [:var :seq_scaling_matrix_present_flag] 1]
       [[:for [:if [:not= [:var :chroma_format_idc] 3] 8 12]
         [[:u 1 [:vec :seq_scaling_list_present_flag]]
          [:when [:= [:at :seq_scaling_list_present_flag [:idx]] 1]
           [[:escape :h264/scaling-list [:if [:< [:idx] 6] 16 64]]]]]]]]]
     [[:infer :chroma_format_idc 1]]]
    [:ue :log2_max_frame_num_minus4]
    [:ue :pic_order_cnt_type]
    [:when [:= [:var :pic_order_cnt_type] 0]
     [[:ue :log2_max_pic_order_cnt_lsb_minus4]]]
    [:when [:= [:var :pic_order_cnt_type] 1]
     [[:u 1 :delta_pic_order_always_zero_flag]
      [:se :offset_for_non_ref_pic]
      [:se :offset_for_top_to_bottom_field]
      [:ue :num_ref_frames_in_pic_order_cnt_cycle]
      [:for [:var :num_ref_frames_in_pic_order_cnt_cycle]
       [[:se [:vec :offset_for_ref_frame]]]]]]
    [:ue :max_num_ref_frames]
    [:u 1 :gaps_in_frame_num_value_allowed_flag]
    [:ue :pic_width_in_mbs_minus1]
    [:ue :pic_height_in_map_units_minus1]
    [:u 1 :frame_mbs_only_flag]
    [:when [:= [:var :frame_mbs_only_flag] 0]
     [[:u 1 :mb_adaptive_frame_field_flag]]]
    [:u 1 :direct_8x8_inference_flag]
    [:u 1 :frame_cropping_flag]
    [:when [:= [:var :frame_cropping_flag] 1]
     [[:ue :frame_crop_left_offset]
      [:ue :frame_crop_right_offset]
      [:ue :frame_crop_top_offset]
      [:ue :frame_crop_bottom_offset]]
     [[:infer :frame_crop_left_offset 0]
      [:infer :frame_crop_right_offset 0]
      [:infer :frame_crop_top_offset 0]
      [:infer :frame_crop_bottom_offset 0]]]]))

(defn expect
  [state [:alias state-type] k :keyword want :i64 ok-code :i64 bad-code :i64] :i64
  (match-result (syntax/read-i64 state k) i64-result-type
    (ok value (if (= value want) ok-code bad-code))
    (err reason bad-code)))

(defn check-elements [state [:alias state-type]] :i64
  ;; the values the JVM reader produced for these exact bytes, and the exact
  ;; bit the reader must stop at; a table-driven read that lands anywhere else
  ;; is wrong even if every surfaced field happens to look right
  (if (= 54 (hetero-vector-at state-type state 1))
    (if (= 1 (expect state :profile_idc 66 1 0))
      (if (= 1 (expect state :level_idc 10 1 0))
        (if (= 1 (expect state :pic_width_in_mbs_minus1 3 1 0))
          (if (= 1 (expect state :pic_height_in_map_units_minus1 2 1 0))
            (if (= 1 (expect state :pic_order_cnt_type 2 1 0))
              (if (= 1 (expect state :chroma_format_idc 1 1 0))
                (if (= 1 (expect state :frame_cropping_flag 0 1 0))
                  (if (= 1 (expect state :max_num_ref_frames 3 1 0))
                    42 8) 7) 6) 5) 4) 3) 2) 1)
    9))

(defn main [] :i64
  (match-result
    (syntax/read-structure (sps-table)
      (vector-i64 103 66 192 10 217 4 123 1 16 0 0 0 16 0 0 0 160 241 34 100 128))
    state-result-type
    (ok state (check-elements state))
    (err reason
      (if (= reason :eof) 90
        (if (= reason :unread-syntax-element) 91
          (if (= reason :non-relational-condition) 92
            (if (= reason :unknown-row-operator) 93
              (if (= reason :syntax-element-not-expressible) 94
                (if (= reason :no-handler-for-escape) 95 99)))))))))
