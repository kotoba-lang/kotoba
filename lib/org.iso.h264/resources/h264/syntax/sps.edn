;; ISO/IEC 14496-10 (ITU-T H.264) §7.3.2.1.1 seq_parameter_set_data( )
;; transcribed as DATA. Row order, descriptors and presence conditions are
;; the standard's; nothing here is this repo's invention. Read by the
;; generic h264.syntax reader; §7.4 semantics (derived width/height,
;; SubWidthC/SubHeightC, CropUnitX/Y) deliberately live in code, in
;; h264.sps-table, exactly where the standard puts them.
{:syntax/id   :h264/seq-parameter-set-data
 :syntax/spec "ISO/IEC 14496-10 §7.3.2.1.1 seq_parameter_set_data( )"

 ;; This repo's convention (see h264.sps/parse, h264.rbsp/unescape): the
 ;; 1-byte NAL header is INCLUDED at index 0 of the RBSP handed to a parser,
 ;; so the first row consumes it. It is §7.3.1 nal_unit( ), not §7.3.2.1.1.
 :syntax/preamble-note
 "row 0 consumes the NAL header byte, matching h264.rbsp/unescape's convention"

 ;; Coverage stops where h264.sps/parse stops, so the equivalence test is a
 ;; clean claim rather than a claim about rows nobody compares. Everything
 ;; after frame_cropping in §7.3.2.1.1 is vui_parameters_present_flag and
 ;; §E.1.1 vui_parameters( ), which the incumbent does not read either.
 :syntax/truncated-at :vui_parameters_present_flag

 :syntax/rows
 [[:u 8 :nal_header_byte]

  [:u 8 :profile_idc]
  ;; the standard prints these as seven separate rows, not one u(8); the
  ;; table follows the standard, and consumes the same eight bits.
  [:u 1 :constraint_set0_flag]
  [:u 1 :constraint_set1_flag]
  [:u 1 :constraint_set2_flag]
  [:u 1 :constraint_set3_flag]
  [:u 1 :constraint_set4_flag]
  [:u 1 :constraint_set5_flag]
  [:u 2 :reserved_zero_2bits]
  [:u 8 :level_idc]
  [:ue :seq_parameter_set_id]

  [:when [:in [:var :profile_idc]
          #{100 110 122 244 44 83 86 118 128 138 139 134 135}]
   [[:ue :chroma_format_idc]
    [:when [:= [:var :chroma_format_idc] 3]
     [[:u 1 :separate_colour_plane_flag]]]
    [:ue :bit_depth_luma_minus8]
    [:ue :bit_depth_chroma_minus8]
    [:u 1 :qpprime_y_zero_transform_bypass_flag]
    [:u 1 :seq_scaling_matrix_present_flag]
    [:when [:= [:var :seq_scaling_matrix_present_flag] 1]
     [[:for [:if [:not= [:var :chroma_format_idc] 3] 8 12]
       [[:u 1 [:vec :seq_scaling_list_present_flag]]
        ;; §7.3.2.1.1: if( seq_scaling_list_present_flag[ i ] )
        ;;   i < 6 ? scaling_list( ScalingList4x4[ i ], 16, .. )
        ;;         : scaling_list( ScalingList8x8[ i - 6 ], 64, .. )
        ;; scaling_list( )'s body (§7.3.2.1.1.1) is a lastScale/nextScale
        ;; state machine, not descriptor rows — hence [:escape], not a
        ;; pretence that it is declarative.
        [:when [:= [:at :seq_scaling_list_present_flag [:idx]] 1]
         [[:escape :h264/scaling-list
           [:idx]
           [:if [:< [:idx] 6] 16 64]]]]]]]]]
   ;; §7.4.2.1.1: "When chroma_format_idc is not present, it shall be
   ;; inferred to be equal to 1 (4:2:0)."
   [[:infer :chroma_format_idc 1]]]

  [:ue :log2_max_frame_num_minus4]
  [:ue :pic_order_cnt_type]
  [:when [:= [:var :pic_order_cnt_type] 0]
   [[:ue :log2_max_pic_order_cnt_lsb_minus4]]]
  [:when [:= [:var :pic_order_cnt_type] 1]
   [[:u 1 :delta_pic_order_always_zero_flag]
    [:se :offset_for_non_ref_pic]
    [:se :offset_for_top_to_bottom_field]
    [:ue :num_ref_frames_in_pic_order_cnt_cycle]
    [:for [:var :num_ref_frames_in_pic_order_cnt_cycle]
     [[:se [:vec :offset_for_ref_frame]]]]]]

  [:ue :max_num_ref_frames]
  [:u 1 :gaps_in_frame_num_value_allowed_flag]
  [:ue :pic_width_in_mbs_minus1]
  [:ue :pic_height_in_map_units_minus1]
  [:u 1 :frame_mbs_only_flag]
  [:when [:= [:var :frame_mbs_only_flag] 0]
   [[:u 1 :mb_adaptive_frame_field_flag]]]
  [:u 1 :direct_8x8_inference_flag]
  [:u 1 :frame_cropping_flag]
  [:when [:= [:var :frame_cropping_flag] 1]
   [[:ue :frame_crop_left_offset]
    [:ue :frame_crop_right_offset]
    [:ue :frame_crop_top_offset]
    [:ue :frame_crop_bottom_offset]]
   ;; §7.4.2.1.1: when frame_cropping_flag is 0, the four offsets are
   ;; inferred to be 0.
   [[:infer :frame_crop_left_offset 0]
    [:infer :frame_crop_right_offset 0]
    [:infer :frame_crop_top_offset 0]
    [:infer :frame_crop_bottom_offset 0]]]]}
