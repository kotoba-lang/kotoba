;; Upstream IPLD Schema DSL constructs, and what this implementation does with
;; each one. Measured 2026-08-17, not asserted from the parser's keyword list.
;;
;; :status is one of
;;   :round-trips  a representative representation value was decoded to its
;;                 logical form through `representation->logical!`
;;   :rejected     refused, with the code under :code
;;
;; The distinction that makes this table worth having: parsing, compiling and
;; round-tripping are three different answers to "is it supported", and they
;; disagree. Every construct below parses. All but one compiles. That is why a
;; coverage claim taken from `dsl/parse`, or from a test count, would be wrong
;; -- the first probe of this table read the parser and concluded that
;; stringjoin, listpairs and copy were all equally fine.
;;
;; What :round-trips does NOT mean: spec conformance. It means one
;; representative value survived one direction. Widening that into a corpus is
;; P1-1 and P1-3 of ADR-2608170400; this table is P1-2 and claims only what it
;; measured.
{:format :ipld.schema-dsl-coverage/v1
 :measured-at "2026-08-17"
 :measured-through "ipld.schema/representation->logical!"
 :constructs
 [{:construct :struct/map          :upstream "struct ... (default)"        :status :round-trips}
  {:construct :struct/tuple        :upstream "representation tuple"        :status :round-trips}
  {:construct :struct/stringpairs  :upstream "representation stringpairs"  :status :round-trips}
  {:construct :struct/stringjoin   :upstream "representation stringjoin"   :status :round-trips}
  {:construct :struct/listpairs    :upstream "representation listpairs"    :status :round-trips}
  {:construct :field/optional      :upstream "optional"                    :status :round-trips}
  {:construct :field/nullable      :upstream "nullable"                    :status :round-trips}
  {:construct :field/implicit      :upstream "(implicit \"...\")"          :status :round-trips}
  {:construct :field/rename        :upstream "(rename \"...\")"            :status :round-trips}
  {:construct :map/map             :upstream "{K:V} (default)"             :status :round-trips}
  {:construct :map/stringpairs     :upstream "representation stringpairs"  :status :round-trips}
  {:construct :map/listpairs       :upstream "representation listpairs"    :status :round-trips}
  {:construct :union/keyed         :upstream "representation keyed"        :status :round-trips}
  {:construct :union/kinded        :upstream "representation kinded"       :status :round-trips}
  {:construct :union/envelope      :upstream "representation envelope"     :status :round-trips}
  {:construct :union/inline        :upstream "representation inline"       :status :round-trips}
  {:construct :union/stringprefix  :upstream "representation stringprefix" :status :round-trips}
  {:construct :union/bytesprefix   :upstream "representation bytesprefix"  :status :round-trips}
  {:construct :enum/string         :upstream "enum (default)"              :status :round-trips}
  {:construct :enum/int            :upstream "representation int"          :status :round-trips}
  {:construct :type/any            :upstream "any"                         :status :round-trips}
  {:construct :type/link           :upstream "&T"                          :status :round-trips}
  {:construct :type/list           :upstream "[T]"                         :status :round-trips}
  {:construct :type/advanced       :upstream "representation advanced X"   :status :round-trips}
  ;; The two that are not implemented, named rather than left to be discovered.
  {:construct :type/copy           :upstream "type A = copy B"
   :status :rejected :code :unknown-record
   :note "refused while parsing; the DSL has no copy declaration"}
  {:construct :unit/empty          :upstream "unit representation empty"
   :status :rejected :code :invalid-unit-representation
   :note "parses, then refused while compiling"}]}
