;; DAG-CBOR canonical / invalid corpus. P1-1 of ADR-2608170400.
;;
;; :canonical rows are the one encoding DAG-CBOR permits for that node; the
;; test requires encode to produce exactly these bytes and decode to return
;; exactly that node.
;;
;; :invalid rows are byte strings a conforming reader must refuse. Three of
;; them were accepted before this corpus existed, and they are the reason it
;; does: `18 05`, out-of-order map keys, and duplicate map keys all decode
;; cleanly into a value the encoder would have written differently. A codec
;; that accepts them lets two byte strings denote one value while carrying
;; different CIDs, which is the one thing a content-addressed identity layer
;; cannot afford.
;;
;; Bytes are unsigned ints so the file stays host-neutral.
{:format :ipld.dag-cbor-corpus/v1
 :measured-at "2026-08-17"
 :canonical
 [{:name :null    :node nil          :bytes [0xf6]}
  {:name :false   :node false        :bytes [0xf4]}
  {:name :true    :node true         :bytes [0xf5]}
  {:name :int-0   :node 0            :bytes [0x00]}
  {:name :int-1   :node 1            :bytes [0x01]}
  {:name :int-23  :node 23           :bytes [0x17]}
  {:name :int-24  :node 24           :bytes [0x18 0x18]}
  {:name :int-neg :node -1           :bytes [0x20]}
  {:name :float   :node 1.5          :bytes [0xfb 0x3f 0xf8 0x00 0x00 0x00 0x00 0x00 0x00]}
  {:name :string-empty :node ""      :bytes [0x60]}
  {:name :string  :node "s"          :bytes [0x61 0x73]}
  {:name :bytes-empty :bytes-node [] :bytes [0x40]}
  {:name :bytes   :bytes-node [1 2]  :bytes [0x42 0x01 0x02]}
  {:name :list-empty :node []        :bytes [0x80]}
  {:name :list    :node [1 2]        :bytes [0x82 0x01 0x02]}
  {:name :map-empty :node {}         :bytes [0xa0]}
  {:name :map     :node {"a" 1}      :bytes [0xa1 0x61 0x61 0x01]}
  ;; DAG-CBOR orders map keys by length first, then bytewise.
  {:name :map-key-order :node {"b" 1 "aa" 2}
   :bytes [0xa2 0x61 0x62 0x01 0x62 0x61 0x61 0x02]}
  {:name :link    :link-node "bafkqaaa"
   :bytes [0xd8 0x2a 0x45 0x00 0x01 0x55 0x00 0x00]}]
 :invalid
 [{:name :truncated-byte-string   :bytes [0x41]}
  {:name :trailing-bytes          :bytes [0x41 0x05 0x05]}
  {:name :non-canonical-int       :bytes [0x18 0x05]
   :note "reads as 5; canonical is 05"}
  {:name :indefinite-length-array :bytes [0x9f 0x01 0xff]}
  {:name :indefinite-length-map   :bytes [0xbf 0x61 0x61 0x01 0xff]}
  {:name :tag-other-than-42       :bytes [0xc0 0x61 0x61]}
  {:name :tag-42-non-bytes        :bytes [0xd8 0x2a 0x01]}
  {:name :tag-42-missing-prefix   :bytes [0xd8 0x2a 0x43 0x01 0x02 0x03]}
  {:name :map-non-string-key      :bytes [0xa1 0x01 0x01]}
  {:name :map-keys-out-of-order   :bytes [0xa2 0x61 0x62 0x01 0x61 0x61 0x01]
   :note "reads as a map; canonical orders a before b"}
  {:name :map-duplicate-keys      :bytes [0xa2 0x61 0x61 0x01 0x61 0x61 0x02]
   :note "reads as last-wins"}
  {:name :half-float              :bytes [0xf9 0x3c 0x00]}
  {:name :undefined               :bytes [0xf7]}]}
