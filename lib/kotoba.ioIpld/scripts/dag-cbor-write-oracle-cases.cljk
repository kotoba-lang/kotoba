;; scripts/dag-cbor-write-oracle-cases.cljk -- ipld.dag-cbor-write (pure Kotoba)
;; against ipld.core/encode (the .cljk oracle), case by case.
;;
;;   NODE_PATH=<node_modules with @noble/hashes> \
;;     kbb --backend sci --classpath "src:$(kbb -Spath)" scripts/dag-cbor-write-oracle-cases.cljk
;;
;; Every row is an assertion in src/ipld/dag_cbor_write.kotoba's test-*: the
;; value, then the bytes that file expects.

(require '[ipld.core :as ipld])

(def cases
  [[0 [0]] [23 [23]] [24 [24 24]] [255 [24 255]] [256 [25 1 0]] [65536 [26 0 1 0 0]]
   [-1 [32]] [-100 [56 99]]
   ["" [96]] ["seq" [99 115 101 113]] ["日本" [102 230 151 165 230 156 172]]
   [nil [246]] [true [245]] [false [244]]
   [(ipld/link "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku")
    [216 42 88 37 0 1 85 18 32 227 176 196 66 152 252 28 20 154 251 244 200 153 111 185 36 39 174 65 228 100 155 147 76 164 149 153 27 120 82 184 85]]
   [[1 "a" nil] [131 1 97 97 246]]
   [{"state" "s" "prev" nil "seq" 0} [163 99 115 101 113 0 100 112 114 101 118 246 101 115 116 97 116 101 97 115]]
   [{"authority" 1 "lamport" 2 "causes" 3 "actor" 4 "state" 5 "prev" 6 "seq" 7}
    [167 99 115 101 113 7 100 112 114 101 118 6 101 97 99 116 111 114 4 101 115 116 97 116 101 5 102 99 97 117 115 101 115 3 103 108 97 109 112 111 114 116 2 105 97 117 116 104 111 114 105 116 121 1]]])

(let [enc (fn [x] (vec (map #(bit-and % 0xff) (ipld/encode x))))
      bad (remove (fn [[x expected]] (= expected (enc x))) cases)]
  (doseq [[x e] bad] (println "DISAGREE" (pr-str x) "expected" e "oracle" (enc x)))
  (println (str "SCANNED\t" (count cases) "\tcases; " (- (count cases) (count bad)) " agree"))
  (when (or (empty? cases) (seq bad)) (js/process.exit 1)))
