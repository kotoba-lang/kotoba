;; Bounded fail-closed subset of kotoba.value.v1, not an authority decision.
;; Supports nil, bool, safe integer, string, ASCII keyword, bytes, vectors,
;; lists, sets and maps. Float, int64, symbol and IPLD link are refused.
(ns kotoba.value.native-validate
 (:require [cbor.codec :as cbor] [cbor.value :as value])
 (:export [validate]))
(defn- child [v [:ref :cbor/value] i :i64] [:ref :cbor/value]
 (if (and (= (value/kind v) :array) (>= i 0) (< i (vector-count (value/children v))))
  (typed-list-nth [:list [:ref :cbor/value]] (value/children v) i) (value/null-value)))
(defn- same? [a :vector-i64 b :vector-i64] :bool
 (and (= (vector-count a) (vector-count b))
  (loop [i 0] (if (= i (vector-count a)) true (and (= (vector-at a i) (vector-at b i)) (recur (+ i 1)))))))
(defn- before? [a :vector-i64 b :vector-i64] :bool
 (let [na (vector-count a) nb (vector-count b)]
  (cond (< na nb) true (> na nb) false
   :else (loop [i 0] (if (= i na) false
    (cond (< (vector-at a i) (vector-at b i)) true (> (vector-at a i) (vector-at b i)) false :else (recur (+ i 1))))))))
(defn- name? [s :string] :bool
 (let [n (string-length s)]
  (and (> n 0) (<= n 512)
   (loop [i 0 slash false]
    (if (= i n) (not= (string-code-point-at s (- n 1)) 47)
     (let [c (string-code-point-at s i)]
      (cond (= c 47) (and (> i 0) (not slash) (recur (+ i 1) true))
            (or (and (>= c 48) (<= c 57)) (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122)) (= c 45) (= c 46) (= c 95) (= c 63) (= c 33) (= c 42) (= c 43)) (recur (+ i 1) slash)
            :else false)))))))
(defn- items [xs [:list [:ref :cbor/value]] i :i64 depth :i64 sorted :bool pairs :bool prev :vector-i64] :bool
 (if (= i (vector-count xs)) true
  (let [item (typed-list-nth [:list [:ref :cbor/value]] xs i)
        k (if pairs (child item 0) item) v (if pairs (child item 1) (value/null-value))]
   (if (and pairs (or (not= (value/kind item) :array) (not= (vector-count (value/children item)) 2))) (throw :invalid-map-entry)
    (let [checked (walk k (+ depth 1)) checked-val (if pairs (walk v (+ depth 1)) true)
          enc (cbor/encode-checked k)]
     (if (not (result-ok?-of [:result :vector-i64 :keyword] enc)) (throw :invalid-value)
      (let [wire (result-value-of [:result :vector-i64 :keyword] enc [])]
       (if (and sorted (> i 0) (not (before? prev wire))) (throw :noncanonical-order)
        (items xs (+ i 1) depth sorted pairs wire)))))))))
(defn- walk [node [:ref :cbor/value] depth :i64] :bool
 (if (> depth 32) (throw :depth-limit)
  (let [tag (child node 0) v (child node 1) code (value/number tag) kind (value/kind v)]
   (if (or (not= (value/kind node) :array) (not= (vector-count (value/children node)) 2) (not= (value/kind tag) :int)) (throw :invalid-form)
    (cond (= code 0) (if (= kind :null) true (throw :invalid-form))
          (= code 1) (if (= kind :bool) true (throw :invalid-form))
          (= code 2) (if (and (= kind :int) (>= (value/number v) -9007199254740991) (<= (value/number v) 9007199254740991)) true (throw :invalid-form))
          (= code 4) (if (= kind :text) true (throw :invalid-form))
          (= code 5) (if (and (= kind :text) (name? (value/text v))) true (throw :unsupported-name))
          (= code 7) (if (= kind :bytes) true (throw :invalid-form))
          (or (= code 16) (= code 17) (= code 18) (= code 19))
           (if (or (not= kind :array) (> (vector-count (value/children v)) 1024)) (throw :invalid-collection)
            (items (value/children v) 0 depth (or (= code 18) (= code 19)) (= code 19) []))
          :else (throw :unsupported-type))))))
(defn validate [wire :vector-i64] [:result :bool :keyword]
 (try (if (or (< (vector-count wire) 1) (> (vector-count wire) 65536)) (throw :invalid-bound)
       (let [d (cbor/decode-checked wire)]
        (if (not (result-ok?-of [:result [:ref :cbor/value] :keyword] d)) (throw :invalid-cbor)
         (let [v (result-value-of [:result [:ref :cbor/value] :keyword] d (value/null-value)) e (cbor/encode-checked v)]
          (if (or (not (result-ok?-of [:result :vector-i64 :keyword] e)) (not (same? wire (result-value-of [:result :vector-i64 :keyword] e [])))) (throw :noncanonical-cbor)
           (result-ok-of [:result :bool :keyword] (walk v 0)))))))
  (catch :keyword e (result-err-of [:result :bool :keyword] e))))
