(ns ipld.canonical-value-bytes-test
  (:require #?(:clj [clojure.test :refer [deftest is]]
               :cljs [cljs.test :refer [deftest is] :include-macros true])
            [ipld.value :as value]
            [kotoba.value.codec :as codec]
            [multiformats.core :as mf]))
(defn bytes-of [xs]
  #?(:clj (byte-array (map unchecked-byte xs))
     :cljs (js/Uint8Array. (clj->js xs))))
(defn problem [f]
  (try (f) nil (catch #?(:clj Exception :cljs :default) e (:problem (ex-data e)))))
(deftest reject-noncanonical-wire-with-its-own-cid
  ;; nil = [0, nil]; both encodings below decode to the same generic CBOR,
  ;; but the type code and enclosing array must use their shortest encoding.
  (doseq [bad [[0x82 0x18 0x00 0xf6] [0x98 0x02 0x00 0xf6]]]
    (let [wire (bytes-of bad) cid (mf/cidv1-dag-cbor wire)]
      (is (= :value/non-canonical-bytes (problem #(value/decode-value wire))))
      (is (= :value/non-canonical-bytes (problem #(codec/verify-value-cid cid wire))))))
  (doseq [v [nil true false 0 -1 "text" :a [1 nil :b] {:a [1 2]} #{:a :b}]]
    (let [wire (codec/encode-value v)]
      (is (= v (codec/decode-value wire)))
      (is (= v (codec/verify-value-cid (codec/value-cid v) wire))))))
