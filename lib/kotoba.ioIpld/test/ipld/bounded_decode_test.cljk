(ns ipld.bounded-decode-test
  (:require #?(:clj [clojure.test :refer [deftest is]]
               :cljs [cljs.test :refer [deftest is] :include-macros true])
            [ipld.core :as ipld]
            [ipld.dag-json :as dag-json]
            [multiformats.core :as mf]))
(defn bytes-of [xs]
  #?(:clj (byte-array (map unchecked-byte xs))
     :cljs (js/Uint8Array. (clj->js xs))))
(defn kind [f] (try (f) nil (catch #?(:clj Exception :cljs :default) e (or (:type (ex-data e)) (:ipld/problem (ex-data e))))))
(def limits {:max-bytes 16384 :max-depth 32 :max-items 1000})
(deftest canonical-bounded-compatibility
  (let [node {"root" [1 true nil {"leaf" "value"}]} wire (ipld/encode node)]
    (is (= node (ipld/decode wire) (ipld/decode-bounded wire limits))))
  (is (= :non-canonical-dag-cbor
         (kind #(ipld/decode-bounded (bytes-of [0x18 0x01]) limits))))
  (is (= :cbor/resource-limit
         (kind #(ipld/decode-bounded (bytes-of (concat (repeat 10000 0x81) [0xf6])) limits)))))

(deftest bounded-verified-read
  (let [node {"child" [1 2 3]} {:keys [cid bytes]} (ipld/node->block node)
        get-fn {cid bytes}]
    (is (= node (ipld/get-node-bounded get-fn cid limits)))
    (is (nil? (ipld/get-node-bounded (constantly nil) cid limits)))
    (is (= :ipld/cid-mismatch
           (kind #(ipld/get-node-bounded (constantly (ipld/encode 1)) cid limits))))
    (is (= :cbor/resource-limit
           (kind #(ipld/get-node-bounded get-fn cid (assoc limits :max-bytes 1)))))
    (is (= :cbor/resource-limit
           (kind #(ipld/get-node-bounded get-fn cid (assoc limits :max-depth 0)))))
    (is (= :cbor/invalid-limit
           (kind #(ipld/get-node-bounded (constantly nil) cid {}))))))

(deftest bounded-codec-dispatch
  (let [raw (bytes-of [1 2 3]) raw-cid (mf/cidv1 mf/codec-raw (mf/multihash-sha256 raw))
        json (dag-json/encode {"a" 1}) json-cid (mf/cidv1 dag-json/codec (mf/multihash-sha256 json))]
    (is (identical? raw (ipld/get-node-bounded {raw-cid raw} raw-cid limits)))
    (is (= :cbor/resource-limit (kind #(ipld/get-node-bounded {raw-cid raw} raw-cid (assoc limits :max-bytes 2)))))
    (is (= :ipld/unsupported-bounded-codec (kind #(ipld/get-node-bounded {json-cid json} json-cid limits))))))


(deftest bounded-read-validates-cid-before-provider
  (let [calls (atom [])
        provider (fn [cid] (swap! calls conj cid) nil)
        raw (bytes-of [1 2 3])
        valid (mf/cidv1-raw raw)
        json (dag-json/encode {"a" 1})
        unsupported (mf/cidv1 dag-json/codec (mf/multihash-sha256 json))
        truncated (mf/cidv1 mf/codec-raw (bytes-of [0x12 0x20 1]))
        wrong-hash (mf/cidv1 mf/codec-raw (bytes-of (concat [0x13 0x20] (repeat 32 0))))]
    (doseq [bad ["not-a-cid" "b" truncated wrong-hash (str valid "a")]]
      (is (= :ipld/invalid-cid (kind #(ipld/get-node-bounded provider bad limits))))
      (is (empty? @calls)))
    (is (= :ipld/unsupported-bounded-codec (kind #(ipld/get-node-bounded provider unsupported limits))))
    (is (empty? @calls))
    (is (nil? (ipld/get-node-bounded provider valid limits)))
    (is (= [valid] @calls))))


(deftest oversized-cid-refused-before-decoding
  (let [parser-calls (atom 0) provider-calls (atom 0)
        oversized (str "b" (apply str (repeat 100000 "a")))]
    (with-redefs [mf/cid->parts (fn [_] (swap! parser-calls inc) {:error :invalid})]
      (is (= :ipld/invalid-cid
             (kind #(ipld/get-node-bounded (fn [_] (swap! provider-calls inc) nil)
                                          oversized limits)))))
    (is (zero? @parser-calls))
    (is (zero? @provider-calls))))
