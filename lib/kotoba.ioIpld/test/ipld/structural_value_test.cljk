(ns ipld.structural-value-test
  (:require #?(:clj [clojure.test :refer [deftest is]]
               :cljs [cljs.test :refer [deftest is] :include-macros true])
            [kotoba.value.codec :as codec]
            [multiformats.core :as mf]))

(def limits {:max-bytes 16384 :max-depth 32 :max-items 1000})
(defn bytes-of [xs]
  #?(:clj (byte-array (map unchecked-byte xs))
     :cljs (js/Uint8Array. (clj->js xs))))
(defn error-kind [f]
  (try (f) nil
       (catch #?(:clj Exception :cljs :default) e
         (or (:type (ex-data e)) (:problem (ex-data e))))))

(deftest canonical-values-and-cids
  (doseq [v [nil true false 0 -1 "text" :a [1 nil :b] {:a [1 2]} #{:a :b}]]
    (let [b (codec/encode-value v)]
      (is (= v (codec/decode-structurally-bounded b limits)))
      (is (= v (codec/verify-value-cid-structurally-bounded (codec/value-cid v) b limits)))))
  (let [b (codec/encode-value nil)]
    (is (= :value/cid-mismatch (error-kind #(codec/verify-value-cid-structurally-bounded (codec/value-cid true) b limits))))))

(deftest adversarial-input-rejected-before-value-decoding
  (let [nil-wire (codec/encode-value nil)
        deep (bytes-of (concat (repeat 10000 0x81) [0xf6]))
        huge (bytes-of [0x9a 0xff 0xff 0xff 0xff])
        bad (bytes-of [0x82 0x18 0x00 0xf6])]
    (doseq [opts [(assoc limits :max-bytes 1) (assoc limits :max-depth 0) (assoc limits :max-items 1)]]
      (is (= :cbor/resource-limit (error-kind #(codec/decode-structurally-bounded nil-wire opts)))))
    (doseq [wire [deep huge]]
      (is (= :cbor/resource-limit (error-kind #(codec/decode-structurally-bounded wire limits)))))
    (is (= :value/non-canonical-bytes (error-kind #(codec/verify-value-cid-structurally-bounded (mf/cidv1-dag-cbor bad) bad limits))))
    (is (= :cbor/invalid-limit (error-kind #(codec/decode-structurally-bounded nil-wire {}))))
    (is (thrown? #?(:clj Exception :cljs js/Error) (codec/decode-structurally-bounded (bytes-of [0x82 0x00]) limits)))))
