(ns ipld.patch-check
  ;; The eight fixtures of the IPLD Patch spec (ipld/ipld specs/patch/
  ;; fixtures/fixtures-1.md), plus the refusals this implementation had to
  ;; decide because the spec does not, run as a self-check inside Kotoba.
  ;;
  ;; `main` returns the NUMBER of failing checks, not a boolean: a boolean
  ;; cannot tell one regression from a broken build.
  (:require [ipld.patch :as patch])
  (:export [main f1 f2 f3 f4 f5 f6 f7 f8 d1 d2 d3 d4 d5 d6 d7 d8 d9]))

(defn applied [subject :string ops :string] [:result :document :keyword]
  (patch/apply-ops (document-edn-read subject) (document-edn-read ops)))

(defn expect-doc [subject :string ops :string want :string] :i64
  (let [r (app (ref applied) subject ops)]
    (if (result-ok?-of [:result :document :keyword] r)
      (if (document-equal? (result-value-of [:result :document :keyword] r (document-null))
                           (document-edn-read want))
        0
        1)
      1)))

(defn expect-err [subject :string ops :string want :keyword] :i64
  (let [r (app (ref applied) subject ops)]
    (if (result-ok?-of [:result :document :keyword] r)
      1
      (if (= (result-error-of [:result :document :keyword] r :patch/none) want) 0 1))))

;; --- the eight fixtures ---------------------------------------------------

(defn f1 [] :i64
  (app (ref expect-doc) "{\"foo\" \"bar\"}"
              "[{\"op\" \"add\" \"path\" \"/baz\" \"value\" \"qux\"}]"
              "{\"foo\" \"bar\" \"baz\" \"qux\"}"))

(defn f2 [] :i64
  (app (ref expect-doc) "[\"bar\" \"baz\"]"
              "[{\"op\" \"add\" \"path\" \"/1\" \"value\" \"qux\"}]"
              "[\"bar\" \"qux\" \"baz\"]"))

(defn f3 [] :i64
  (app (ref expect-doc) "{\"baz\" \"qux\" \"foo\" \"bar\"}"
              "[{\"op\" \"remove\" \"path\" \"/baz\"}]"
              "{\"foo\" \"bar\"}"))

(defn f4 [] :i64
  (app (ref expect-doc) "{\"baz\" \"qux\" \"foo\" \"bar\"}"
              "[{\"op\" \"replace\" \"path\" \"/baz\" \"value\" \"boo\"}]"
              "{\"baz\" \"boo\" \"foo\" \"bar\"}"))

(defn f5 [] :i64
  (app (ref expect-doc) "{\"foo\" {\"bar\" \"baz\" \"waldo\" \"fred\"} \"qux\" {\"corge\" \"grault\"}}"
              "[{\"op\" \"copy\" \"from\" \"/foo/waldo\" \"path\" \"/qux/thud\"}]"
              "{\"foo\" {\"bar\" \"baz\" \"waldo\" \"fred\"} \"qux\" {\"corge\" \"grault\" \"thud\" \"fred\"}}"))

(defn f6 [] :i64
  (app (ref expect-doc) "{\"foo\" {\"bar\" \"baz\" \"waldo\" \"fred\"} \"qux\" {\"corge\" \"grault\"}}"
              "[{\"op\" \"move\" \"from\" \"/foo/waldo\" \"path\" \"/qux/thud\"}]"
              "{\"foo\" {\"bar\" \"baz\"} \"qux\" {\"corge\" \"grault\" \"thud\" \"fred\"}}"))

(defn f7 [] :i64
  (app (ref expect-doc) "{\"baz\" \"qux\" \"foo\" [\"a\" 2 \"c\"]}"
              "[{\"op\" \"test\" \"path\" \"/baz\" \"value\" \"qux\"} {\"op\" \"test\" \"path\" \"/foo/1\" \"value\" 2} {\"op\" \"add\" \"path\" \"/bar\" \"value\" \"zar\"}]"
              "{\"baz\" \"qux\" \"foo\" [\"a\" 2 \"c\"] \"bar\" \"zar\"}"))

(defn f8 [] :i64
  ;; The failing test aborts the whole sequence: the add that follows it must
  ;; not appear. Asserting the refusal keyword rather than only that it failed.
  (app (ref expect-err) "{\"baz\" \"qux\" \"foo\" [\"a\" 2 \"c\"]}"
              "[{\"op\" \"test\" \"path\" \"/baz\" \"value\" \"qux\"} {\"op\" \"test\" \"path\" \"/foo/1\" \"value\" 3} {\"op\" \"add\" \"path\" \"/bar\" \"value\" \"zar\"}]"
              :patch/test-failed))

;; --- the decisions --------------------------------------------------------

(defn d1 [] :i64
  ;; parents are not created
  (app (ref expect-err) "{}" "[{\"op\" \"add\" \"path\" \"/a/b\" \"value\" 1}]" :patch/path-not-found))

(defn d2 [] :i64
  ;; replace needs a target, add does not
  (+ (app (ref expect-err) "{}" "[{\"op\" \"replace\" \"path\" \"/a\" \"value\" 1}]" :patch/path-not-found)
     (app (ref expect-doc) "{}" "[{\"op\" \"add\" \"path\" \"/a\" \"value\" 1}]" "{\"a\" 1}")))

(defn d3 [] :i64
  ;; list indices are canonical decimal
  (+ (app (ref expect-err) "[\"a\" \"b\"]" "[{\"op\" \"replace\" \"path\" \"/01\" \"value\" \"z\"}]" :patch/list-index-not-canonical)
     (+ (app (ref expect-err) "[\"a\" \"b\"]" "[{\"op\" \"replace\" \"path\" \"/x\" \"value\" \"z\"}]" :patch/list-index-not-a-number)
        (app (ref expect-err) "[\"a\" \"b\"]" "[{\"op\" \"add\" \"path\" \"/3\" \"value\" \"z\"}]" :patch/list-index-out-of-range))))

(defn d4 [] :i64
  ;; index == length appends
  (app (ref expect-doc) "[\"a\" \"b\"]" "[{\"op\" \"add\" \"path\" \"/2\" \"value\" \"z\"}]" "[\"a\" \"b\" \"z\"]"))

(defn d5 [] :i64
  ;; move refuses to move a node into its own child
  (app (ref expect-err) "{\"a\" {\"b\" {}}}" "[{\"op\" \"move\" \"from\" \"/a\" \"path\" \"/a/b/c\"}]" :patch/move-into-own-child))

(defn d6 [] :i64
  ;; the root path and a relative path are refused
  (+ (app (ref expect-err) "{\"a\" 1}" "[{\"op\" \"replace\" \"path\" \"\" \"value\" 2}]" :patch/root-path-unsupported)
     (app (ref expect-err) "{\"a\" 1}" "[{\"op\" \"replace\" \"path\" \"a\" \"value\" 2}]" :patch/path-not-absolute)))

(defn d7 [] :i64
  ;; ~1 is read literally rather than as a separator
  (app (ref expect-doc) "{\"a/b\" 1}" "[{\"op\" \"add\" \"path\" \"/a~1b\" \"value\" 2}]" "{\"a/b\" 1 \"a~1b\" 2}"))

(defn d8 [] :i64
  ;; a path cannot descend through a scalar, and an unknown op is refused
  (+ (app (ref expect-err) "{\"a\" 1}" "[{\"op\" \"add\" \"path\" \"/a/b\" \"value\" 2}]" :patch/path-through-scalar)
     (app (ref expect-err) "{}" "[{\"op\" \"upsert\" \"path\" \"/a\" \"value\" 1}]" :patch/unknown-operation)))

(defn d9 [] :i64
  ;; the negative half of fixture 1: a wrong value must not compare equal
  (if (= (app (ref expect-doc) "{\"foo\" \"bar\"}"
                     "[{\"op\" \"add\" \"path\" \"/baz\" \"value\" \"WRONG\"}]"
                     "{\"foo\" \"bar\" \"baz\" \"qux\"}")
         1)
    0
    1))

(defn main [] :i64
  (+ (app (ref f1)) (app (ref f2)) (app (ref f3)) (app (ref f4)) (app (ref f5)) (app (ref f6)) (app (ref f7)) (app (ref f8)) (app (ref d1)) (app (ref d2)) (app (ref d3)) (app (ref d4)) (app (ref d5)) (app (ref d6)) (app (ref d7)) (app (ref d8)) (app (ref d9))))
