{:paths ["src" "resources"]
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/json {:local/root "../kotoba.json"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/fmt {:local/root "../kotoba.fmt"}}
 :aliases
 {:cli {:main-opts ["-m" "kotoba.user-test.cli"]}
  :mcp {:extra-deps
        {org.clojure/data.json {:mvn/version "2.5.1"}
         io.github.kotoba-lang/org-anthropic-mcp
         {:git/url "https://github.com/kotoba-lang/org-anthropic-mcp.git"
          :git/sha "9b343e64139763d66c2a3969669bc03f73b32a46"}}
        :main-opts ["-m" "kotoba.user-test.mcp"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
