;; No third-party dependencies. RTP/RTCP (RFC 3550) is fixed-width integers
;; packed into a byte stream plus a handful of arithmetic identities (24-bit
;; signed wraparound, 16-bit sequence-number "more recent than", an
;; exponential jitter estimator). All of that is `bit-and`/`bit-or`/
;; `bit-shift-left`/`unsigned-bit-shift-right` on plain integers — nothing a
;; library would improve on, and nothing that should require installing one.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
