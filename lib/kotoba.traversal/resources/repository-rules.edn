;; This repository's entry in the kotoba.repository-role-rules taxonomy.
;; ADR-2607266000 / ADR-2607299000.
{:schema "kotoba.repository-role-rules.v0"
 :this-repo
 {:name "traversal"
  :tier :t5
  :role :library
  ;; A reordering that skips or repeats an element is not slow, it is wrong,
  ;; so every order here is checked to be a permutation. And a planner that
  ;; measures is no longer a pure function of its inputs.
  :must-not [:emit-non-bijective-orders :probe-hardware :run-benchmarks]
  :depends-on ["kotoba-lang/machine"]}}
