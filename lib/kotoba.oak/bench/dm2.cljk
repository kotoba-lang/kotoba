(ns dm2-bench
  "Wall time of `oak.semantic/materialize :owl2-rl` over the DoDAF DM2 2.02
  ontology (the Mithril Form served at https://mithril.fund/ontology/dm2/2.02)
  plus a deterministic synthetic instance graph.

    kbb --backend sci --classpath <oak/src:owl2/src:deps> bench/dm2.cljk <dm2-form-file> [individuals] [edges]

  Exit 2 (not 0) when the form file is missing or yields no axioms, so an
  absent input never reads as a fast run."
  (:require [clojure.edn :as edn]
            [oak.semantic :as oak]))

(def fs (js/require "fs"))

(def vocab
  {:rdfs/sub-class-of :rdfs/subClassOf
   :rdfs/sub-property-of :rdfs/subPropertyOf
   :rdfs/domain :rdfs/domain
   :rdfs/range :rdfs/range})

(defn- as-vec [v] (if (vector? v) v [v]))

(defn form->triples
  "The OWL axioms of a Mithril ontology form as oak triples. Declarations
  become rdf:type owl:Class / owl:ObjectProperty; sh:* shape rows are not
  OWL and are left out."
  [form]
  (let [graph (:graph (apply hash-map (rest form)))]
    (vec
     (for [row graph
           :let [kind (first row)
                 m (apply hash-map (rest row))
                 id (:id m)]
           t (concat
              [(oak/triple id :rdf/type (case kind
                                          owl/class :owl/Class
                                          owl/object-property :owl/ObjectProperty
                                          :owl/Thing))]
              (for [[k p] vocab
                    o (as-vec (get m k))
                    :when o]
                (oak/triple id p o)))]
       t))))

(defn- lcg [seed] (mod (+ (* seed 1103515245) 12345) 2147483648))

(defn instances
  "n individuals typed with a DM2 class, and e object-property assertions
  between them, chosen by a fixed LCG so every run sees the same graph."
  [axioms n e]
  (let [classes (vec (sort (distinct (keep #(when (= :owl/Class (:o %)) (:s %)) axioms))))
        props (vec (sort (distinct (keep #(when (= :owl/ObjectProperty (:o %)) (:s %)) axioms))))
        ind (fn [i] (str "urn:dm2-bench:i" i))]
    (loop [i 0 seed 42 acc []]
      (cond
        (< i n) (let [s (lcg seed)]
                  (recur (inc i) s (conj acc (oak/triple (ind i) :rdf/type (nth classes (mod s (count classes)))))))
        (< i (+ n e)) (let [s1 (lcg seed) s2 (lcg s1) s3 (lcg s2)]
                        (recur (inc i) s3
                               (conj acc (oak/triple (ind (mod s1 n)) (nth props (mod s2 (count props)))
                                                     (ind (mod s3 n))))))
        :else acc))))

(defn- now [] (js/Date.now))

(let [[path n e] *command-line-args*
      n (js/parseInt (or n "1000"))
      e (js/parseInt (or e "2000"))]
  (when-not (and path (.existsSync fs path))
    (println "REFUSING: no DM2 form file at" (pr-str path))
    (js/process.exit 2))
  (let [form (edn/read-string (.readFileSync fs path "utf8"))
        axioms (form->triples form)
        data (instances axioms n e)
        asserted (set (concat axioms data))]
    (when (empty? axioms) (println "REFUSING: 0 axioms") (js/process.exit 2))
    (println "SCANNED\taxioms" (count axioms) "instance-triples" (count data) "asserted" (count asserted))
    (let [t0 (now)
          legacy (oak/materialize :owl2-rl asserted)
          t1 (now)]
      (println "legacy\tms" (- t1 t0) "entailed" (count legacy))
      (let [t2 (now)
            r (oak/entail :owl2-rl asserted {})
            t3 (now)
            r2 (oak/entail :owl2-rl asserted {:schema? false})
            t4 (now)
            missing (remove (:graph r) legacy)]
        (println "full\tms" (- t3 t2) "entailed" (count (:graph r))
                 "rounds" (get-in r [:counts :rounds])
                 "inconsistencies" (count (:inconsistencies r))
                 "subClassOf-triples" (count (filter #(= :rdfs/subClassOf (:p %)) (:graph r))))
        (println "full-no-schema\tms" (- t4 t3) "entailed" (count (:graph r2)))
        (println "legacy-not-in-full\t" (count missing))
        (when (seq missing)
          (println "  e.g." (pr-str (take 3 missing)))
          (js/process.exit 1))))))
