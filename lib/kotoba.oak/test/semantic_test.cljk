(ns semantic-test
  (:require [cljs.test :refer [deftest is run-tests testing]]
            [oak.semantic :as semantic]))

(deftest owl2-rl-and-sparql-compose
  (let [triples [(semantic/triple :procurement :rdfs/subClassOf :tender)
                 (semantic/triple :t-open :rdf/type :procurement)
                 (semantic/triple :t-open :status :open)
                 (semantic/triple :t-closed :rdf/type :tender)
                 (semantic/triple :t-closed :status :closed)]
        plan [:sparql/project [:?t]
              [:sparql/bgp [:?t :rdf/type :tender]
               [:?t :status :open]]]]
    (is (= [{'?t :t-open}]
           (semantic/execute :owl2-rl plan triples))
        "the answer needs both derived OWL type and SPARQL BGP join")))

(deftest unsupported-owl-profile-is-not-approximated
  (testing "OWL 2 DL cannot silently run as RL"
    (try
      (semantic/materialize :owl2-dl [])
      (is false "expected a refusal")
      (catch :default e
        (is (= :oak/unsupported-owl-profile (:code (ex-data e))))))))

(deftest candidates-come-through-owl-entailment
  (let [ontology [[:goal :goal/x]
                  [:component :query/good :query [:sparql/bgp]]
                  [:permits :goal/x :query :query/good]]
        candidates (semantic/candidates-for-role ontology :goal/x :query)]
    (is (= [{:id :query/good :permitted? true}] candidates))))

(deftest ontology-shape-plan-translates-to-the-shacl-engine-abi
  (is (= {:target :tender
          :shape {:shacl/type :node-shape
                  :property [{:path :id :datatype :string
                              :min-count 1 :max-count 1}
                             {:path :status :datatype :keyword
                              :min-count 1 :max-count 1
                              :in [:open :closed]}]}}
         (semantic/shape-plan->shacl
          [:shacl/node :tender
           [:shacl/property :id :string 1 1]
           [:shacl/property :status :keyword 1 1
            [:shacl/in :open :closed]]]))))

(deftest unsupported-shacl-constraints-are-not-ignored
  (try
    (semantic/shape-plan->shacl
     [:shacl/node :tender
      [:shacl/property :id :string 1 1 [:shacl/pattern "T-[0-9]+"]]])
    (is false "expected a refusal")
    (catch :default e
      (is (= :oak/unsupported-shacl-constraint (:code (ex-data e)))))))

(deftest unknown-shacl-datatypes-cannot-reach-the-engine-default
  (try
    (semantic/shape-plan->shacl
     [:shacl/node :tender [:shacl/property :id :future-datatype 1 1]])
    (is false "expected a refusal")
    (catch :default e
      (is (= :oak/invalid-shacl-property-operands (:code (ex-data e)))))))

(def ^:private zoo
  [(semantic/triple :cat :rdfs/subClassOf :mammal)
   (semantic/triple :mammal :rdfs/subClassOf :animal)
   (semantic/triple :has-mother :rdfs/subPropertyOf :has-parent)
   (semantic/triple :has-parent :rdfs/domain :mammal)
   (semantic/triple :felix :rdf/type :cat)
   (semantic/triple :felix :has-mother :tama)])

(deftest two-arity-materialize-is-the-legacy-closure-unchanged
  (testing "the exact set the triple-rules path returned before entail existed"
    (is (= #{[:cat :rdfs/subClassOf :mammal] [:mammal :rdfs/subClassOf :animal]
             [:has-mother :rdfs/subPropertyOf :has-parent] [:has-parent :rdfs/domain :mammal]
             [:felix :rdf/type :cat] [:felix :has-mother :tama]
             [:felix :has-parent :tama] [:felix :rdf/type :mammal] [:felix :rdf/type :animal]}
           (set (map (juxt :s :p :o) (semantic/materialize :owl2-rl zoo)))))))

(deftest entail-emits-schema-entailments-and-is-a-superset
  (let [legacy (semantic/materialize :owl2-rl zoo)
        r (semantic/entail :owl2-rl zoo)]
    (is (= :owl.rl (:engine r)))
    (is (true? (:consistent? r)))
    (is (contains? (:graph r) (semantic/triple :cat :rdfs/subClassOf :animal)) "scm-sco")
    (is (contains? (:graph r) (semantic/triple :has-mother :rdfs/domain :mammal)) "scm-dom2")
    (is (not (contains? legacy (semantic/triple :cat :rdfs/subClassOf :animal)))
        "the legacy arity does not grow schema triples")
    (is (= #{} (reduce disj legacy (:graph r))) "legacy closure is contained in the complete one")
    (is (= (:graph r) (semantic/materialize :owl2-rl zoo {})))))

(deftest inconsistency-is-structured-data-or-a-structured-refusal
  (let [bad (conj zoo (semantic/triple :cat :owl/disjointWith :animal))
        r (semantic/entail :owl2-rl bad)]
    (is (false? (:consistent? r)))
    (is (= [:cax-dw] (map :rule (:inconsistencies r))))
    (is (= #{(semantic/triple :felix :rdf/type :cat) (semantic/triple :felix :rdf/type :animal)
             (semantic/triple :cat :owl/disjointWith :animal)}
           (set (:triples (first (:inconsistencies r))))))
    (try
      (semantic/materialize :owl2-rl bad {})
      (is false "expected a refusal")
      (catch :default e
        (is (= :oak/owl-inconsistent (:code (ex-data e))))
        (is (= [:cax-dw] (map :rule (:inconsistencies (ex-data e)))))))
    (is (contains? (semantic/materialize :owl2-rl bad {:allow-inconsistent? true})
                   (semantic/triple :felix :rdf/type :animal)))))

(deftest capability-lists-are-exported
  (is (contains? semantic/supported-owl-rules :prp-spo2))
  (is (not (contains? semantic/supported-owl-rules :eq-ref)))
  (is (contains? semantic/supported-owl-vocabulary "http://www.w3.org/2002/07/owl#hasKey"))
  (try
    (semantic/entail :owl2-dl zoo)
    (is false "expected a refusal")
    (catch :default e
      (is (= :oak/unsupported-owl-profile (:code (ex-data e)))))))

(defmethod cljs.test/report [:cljs.test/default :end-run-tests] [m]
  (set! (.-exitCode js/process) (if (cljs.test/successful? m) 0 1)))

(run-tests)
