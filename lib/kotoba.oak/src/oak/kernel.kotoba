(ns oak.kernel
  (:export [main schema-digest oak-call
            call-declare call-relate call-related call-census
            app-ontology app-ontology-digest compile-app compile-app-transaction query-app run-app
            compile-tender-app-at compile-tender-app-effect-at compile-tender-app
            run-tender-app-event run-tender-app])
  (:capabilities #{:dataspace/transact}))

;; ---------------------------------------------------------------- S, the schema

(defn schema-doc [] :document
  [[:entity :agency]
   [:entity :tender]
   [:entity :supplier]
   [:relation :issued-by :tender :agency]
   [:relation :awarded-to :tender :supplier]])

(defn schema-digest [] :string (document-sha256 (schema-doc)))

;; ---------------------------------------------------------------- document helpers

(defn at [d :document i :i64] :document
  (option-or (document-vector-at d i) (document-null)))

(defn kw-at [d :document i :i64] :keyword
  (option-or (document-keyword-value (at d i)) :oak/none))

(defn field [m :document k :string] :document
  (option-or (document-get m (document-symbol (symbol k))) (document-null)))

(defn field-str [m :document k :string] :string
  (option-or (document-string-value (field m k)) ""))

(defn field-kw [m :document k :string] :keyword
  (option-or (document-keyword-value (field m k)) :oak/none))

;; ---------------------------------------------------------------- S lookups

(defn entity-scan [s :document i :i64 t :keyword] :bool
  (if (= i (document-count s))
    false
    (let [row (at s i)]
      (if (document-equal? (at row 0) (document-keyword :entity))
        (if (document-equal? (at row 1) (document-keyword t))
          true
          (entity-scan s (+ i 1) t))
        (entity-scan s (+ i 1) t)))))

(defn entity-declared? [t :keyword] :bool
  (entity-scan (schema-doc) 0 t))

(defn relation-scan [s :document i :i64 r :keyword slot :i64] :keyword
  (if (= i (document-count s))
    :oak/none
    (let [row (at s i)]
      (if (document-equal? (at row 0) (document-keyword :relation))
        (if (document-equal? (at row 1) (document-keyword r))
          (kw-at row slot)
          (relation-scan s (+ i 1) r slot))
        (relation-scan s (+ i 1) r slot)))))

(defn relation-domain [r :keyword] :keyword (relation-scan (schema-doc) 0 r 2))
(defn relation-range [r :keyword] :keyword (relation-scan (schema-doc) 0 r 3))

;; ---------------------------------------------------------------- the KG plane
;;
;; Exactly two observe patterns exist, so the kit's 64-observer ceiling is not
;; a function of how many entities the caller asks about.

(defn ds-bindings [r [:variant :kotoba.dataspace/result
                      [[:asserted [:record :kotoba.dataspace/asserted
                                   [[:count :i64] [:notices :document]]]]
                       [:retracted [:record :kotoba.dataspace/retracted [[:count :i64]]]]
                       [:matches [:record :kotoba.dataspace/matches
                                  [[:bindings :document] [:notices :document]]]]
                       [:facet [:record :kotoba.dataspace/facet [[:id :i64]]]]
                       [:error [:record :kotoba.dataspace/error
                                [[:code :keyword] [:message :string]]]]]]] :document
  (match-variant r
    [:variant :kotoba.dataspace/result
     [[:asserted [:record :kotoba.dataspace/asserted
                  [[:count :i64] [:notices :document]]]]
      [:retracted [:record :kotoba.dataspace/retracted [[:count :i64]]]]
      [:matches [:record :kotoba.dataspace/matches
                 [[:bindings :document] [:notices :document]]]]
      [:facet [:record :kotoba.dataspace/facet [[:id :i64]]]]
      [:error [:record :kotoba.dataspace/error
               [[:code :keyword] [:message :string]]]]]]
    (:asserted x (document-vector))
    (:retracted x (document-vector))
    (:matches x (record-get x :bindings))
    (:facet x (document-vector))
    (:error x (document-vector))))

(defn ds-written [r [:variant :kotoba.dataspace/result
                     [[:asserted [:record :kotoba.dataspace/asserted
                                  [[:count :i64] [:notices :document]]]]
                      [:retracted [:record :kotoba.dataspace/retracted [[:count :i64]]]]
                      [:matches [:record :kotoba.dataspace/matches
                                 [[:bindings :document] [:notices :document]]]]
                      [:facet [:record :kotoba.dataspace/facet [[:id :i64]]]]
                      [:error [:record :kotoba.dataspace/error
                               [[:code :keyword] [:message :string]]]]]]] :i64
  (match-variant r
    [:variant :kotoba.dataspace/result
     [[:asserted [:record :kotoba.dataspace/asserted
                  [[:count :i64] [:notices :document]]]]
      [:retracted [:record :kotoba.dataspace/retracted [[:count :i64]]]]
      [:matches [:record :kotoba.dataspace/matches
                 [[:bindings :document] [:notices :document]]]]
      [:facet [:record :kotoba.dataspace/facet [[:id :i64]]]]
      [:error [:record :kotoba.dataspace/error
               [[:code :keyword] [:message :string]]]]]]
    (:asserted x (record-get x :count))
    (:retracted x 0)
    (:matches x 0)
    (:facet x 0)
    (:error x -1)))

(defn all-types [] :document
  (ds-bindings (observe! (document-vector (document-keyword :is-a)
                                          (document-keyword :?e)
                                          (document-keyword :?t)))))

(defn all-facts [] :document
  (ds-bindings (observe! (document-vector (document-keyword :fact)
                                          (document-keyword :?s)
                                          (document-keyword :?r)
                                          (document-keyword :?o)))))

(defn type-scan [b :document i :i64 e :string] :keyword
  (if (= i (document-count b))
    :oak/untyped
    (let [row (at b i)]
      (if (string=? (field-str row "?e") e)
        (field-kw row "?t")
        (type-scan b (+ i 1) e)))))

(defn type-of [e :string] :keyword (type-scan (all-types) 0 e))

(defn census-scan [b :document i :i64 t :keyword n :i64] :i64
  (if (= i (document-count b))
    n
    (if (= (field-kw (at b i) "?t") t)
      (census-scan b (+ i 1) t (+ n 1))
      (census-scan b (+ i 1) t n))))

(defn objects-scan [b :document i :i64 s :string r :keyword acc :document] :document
  (if (= i (document-count b))
    acc
    (let [row (at b i)]
      (if (string=? (field-str row "?s") s)
        (if (= (field-kw row "?r") r)
          (objects-scan b (+ i 1) s r
                        (document-vector-conj acc (document-string (field-str row "?o"))))
          (objects-scan b (+ i 1) s r acc))
        (objects-scan b (+ i 1) s r acc)))))

;; ---------------------------------------------------------------- capacity
;;
;; A query result is one document, and a document container holds at most 32
;; items (`document-container-item-limit`), so a graph larger than that has
;; facts the kernel can no longer read back. The provider does not answer
;; "too many" -- it traps while encoding, which the guest cannot catch,
;; because refusing to observe is not one of the outcomes the kit has. So the
;; ceiling is enforced on the WRITE side instead: the kernel does not admit a
;; fact it would afterwards be unable to report.

(defn capacity [] :i64 32)

(defn at-capacity? [rows :document] :bool
  (if (= (document-count rows) (capacity)) true false))

;; ---------------------------------------------------------------- outcomes

(defn evidence [kind :keyword subject :document] :document
  (document-vector (document-string (schema-digest))
                   (document-keyword kind)
                   subject))

(defn ok [value :document ev :document]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (variant-new
   [:variant :oak/outcome
    [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
     [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
   :ok
   (record-new [:record :oak/ok [[:value :document] [:evidence :document]]] value ev)))

(defn rejected [code :keyword detail :string]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (variant-new
   [:variant :oak/outcome
    [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
     [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
   :rejected
   (record-new [:record :oak/rejected [[:code :keyword] [:detail :string]]] code detail)))

;; ------------------------------------------------ executable app ontology
;;
;; This is the experiment's source language.  There is no source-text hole:
;; every value the probabilistic elaborator may choose, every SHACL-like input
;; constraint, the SPARQL-like read algebra, the view, the action, its effect,
;; and the implementation binding are rows in this document.  The compiler
;; below only accepts identifiers connected to the goal by `:permits` rows.
;;
;; `:binds` names the DefCID measured for `do-declare` on the compiler baseline
;; that introduced this experiment.  It is evidence, not ambient dispatch: the
;; runtime still reaches the definition only through the closed `:op/declare`
;; opcode and `oak-call`'s admission path.

(defn app-ontology-doc [] :document
  [[:goal :goal/tender-intake]
   [:component :reasoner/owl2-rl :reasoner
    [:owl2/profile :owl2-rl
     [:owl2/engine "kotoba-lang/org-w3-owl2"]
     [:owl2/semantics :least-fixpoint]
     [:owl2/outside-profile :reject]]]
   [:component :shape/tender-input :shape
    [:shacl/node :tender
     [:shacl/property :id :string 1 1]
     [:shacl/property :status :keyword 1 1
      [:shacl/in :open :closed]]]]
   [:component :query/open-tenders :query
    [:sparql/project [:?t]
     [:sparql/bgp [:?t :rdf/type :tender]
                  [:?t :status :open]]]]
   [:component :view/tender-form :view
    [:view/form :shape/tender-input]]
   [:component :action/declare-tender :action
    [:action/input :shape/tender-input]]
   [:component :effect/dataspace-transact :effect
    [:effect/capability :dataspace/transact]]
   [:component :impl/oak-declare :implementation
    [:implementation/export :do-declare]]
   [:binds :impl/oak-declare
    "bafyreiggpt55m7ke7qy7f2fxscdo4zq3pnq7gbssvrlqcwp6ofngp66xka"]
   [:permits :goal/tender-intake :shape :shape/tender-input]
   [:permits :goal/tender-intake :reasoner :reasoner/owl2-rl]
   [:permits :goal/tender-intake :query :query/open-tenders]
   [:permits :goal/tender-intake :view :view/tender-form]
   [:permits :goal/tender-intake :action :action/declare-tender]
   [:permits :goal/tender-intake :effect :effect/dataspace-transact]
   [:permits :goal/tender-intake :implementation :impl/oak-declare]
   [:requires :view/tender-form :shape :shape/tender-input]
   [:requires :view/tender-form :query :query/open-tenders]
   [:requires :query/open-tenders :reasoner :reasoner/owl2-rl]
   [:requires :action/declare-tender :shape :shape/tender-input]
   [:implements :impl/oak-declare :action/declare-tender]
   [:dispatch :action/declare-tender :event/submit
    :op/declare :tender :effect/dataspace-transact]
   ;; Confidence is an ontology admission rule, not a model-global constant.
   ;; The trained OpenJev model is measured OOD on this ontology; structural
   ;; coherence and exact graph permissions remain mandatory at every floor.
   [:confidence-floor :reasoner 6000]
   [:confidence-floor :shape 8000]
   [:confidence-floor :query 8000]
   [:confidence-floor :view 8000]
   [:confidence-floor :action 8000]
   [:confidence-floor :effect 6000]
   [:confidence-floor :implementation 8000]])

(defn app-ontology [] :document (app-ontology-doc))

(defn app-ontology-digest [] :string
  (document-sha256 (app-ontology-doc)))

(defn app-row-scan [d :document i :i64 head :keyword a :keyword slot :i64] :keyword
  (if (= i (document-count d))
    :oak/none
    (let [row (at d i)]
      (if (= (kw-at row 0) head)
        (if (= (kw-at row 1) a)
          (kw-at row slot)
          (app-row-scan d (+ i 1) head a slot))
        (app-row-scan d (+ i 1) head a slot)))))

(defn app-goal? [goal :keyword] :bool
  (= (app-row-scan (app-ontology-doc) 0 :goal goal 1) goal))

(defn component-kind [id :keyword] :keyword
  (app-row-scan (app-ontology-doc) 0 :component id 2))

(defn component-row-scan [d :document i :i64 id :keyword] :document
  (if (= i (document-count d))
    (document-null)
    (let [row (at d i)]
      (if (= (kw-at row 0) :component)
        (if (= (kw-at row 1) id)
          row
          (component-row-scan d (+ i 1) id))
        (component-row-scan d (+ i 1) id)))))

(defn component-digest [id :keyword] :string
  (document-sha256 (component-row-scan (app-ontology-doc) 0 id)))

(defn component-body [id :keyword] :document
  (at (component-row-scan (app-ontology-doc) 0 id) 3))

(defn binding-scan [d :document i :i64 implementation :keyword] :string
  (if (= i (document-count d))
    ""
    (let [row (at d i)]
      (if (= (kw-at row 0) :binds)
        (if (= (kw-at row 1) implementation)
          (option-or (document-string-value (at row 2)) "")
          (binding-scan d (+ i 1) implementation))
        (binding-scan d (+ i 1) implementation)))))

(defn implementation-binds? [implementation :keyword action :keyword] :bool
  (= (app-row-scan (app-ontology-doc) 0 :implements implementation 2) action))

(defn permitted-scan [d :document i :i64 goal :keyword role :keyword id :keyword] :bool
  (if (= i (document-count d))
    false
    (let [row (at d i)]
      (if (= (kw-at row 0) :permits)
        (if (= (kw-at row 1) goal)
          (if (= (kw-at row 2) role)
            (if (= (kw-at row 3) id)
              true
              (permitted-scan d (+ i 1) goal role id))
            (permitted-scan d (+ i 1) goal role id))
          (permitted-scan d (+ i 1) goal role id))
        (permitted-scan d (+ i 1) goal role id)))))

(defn permitted? [goal :keyword role :keyword id :keyword] :bool
  (permitted-scan (app-ontology-doc) 0 goal role id))

(defn required-scan [d :document i :i64 consumer :keyword role :keyword id :keyword] :bool
  (if (= i (document-count d))
    false
    (let [row (at d i)]
      (if (= (kw-at row 0) :requires)
        (if (= (kw-at row 1) consumer)
          (if (= (kw-at row 2) role)
            (if (= (kw-at row 3) id)
              true
              (required-scan d (+ i 1) consumer role id))
            (required-scan d (+ i 1) consumer role id))
          (required-scan d (+ i 1) consumer role id))
        (required-scan d (+ i 1) consumer role id)))))

(defn required? [consumer :keyword role :keyword id :keyword] :bool
  (required-scan (app-ontology-doc) 0 consumer role id))

(defn confidence-floor-scan [d :document i :i64 role :keyword] :i64
  (if (= i (document-count d))
    -1
    (let [row (at d i)]
      (if (= (kw-at row 0) :confidence-floor)
        (if (= (kw-at row 1) role)
          (option-or (document-i64-value (at row 2)) -1)
          (confidence-floor-scan d (+ i 1) role))
        (confidence-floor-scan d (+ i 1) role)))))

(defn confidence-floor [role :keyword] :i64
  (confidence-floor-scan (app-ontology-doc) 0 role))

;; Jev-shaped decisions are finite rows:
;;   [:choice role candidate confidence-basis-points]
;; More than one candidate per role is allowed.  Compilation takes the highest
;; probability pointer; no token or source string is generated.

(defn choice-best-id-scan [d :document i :i64 role :keyword best :keyword score :i64] :keyword
  (if (= i (document-count d))
    best
    (let [row (at d i)]
      (if (= (kw-at row 0) :choice)
        (if (= (kw-at row 1) role)
          (let [n (option-or (document-i64-value (at row 3)) 0)]
            (if (> n score)
              (choice-best-id-scan d (+ i 1) role (kw-at row 2) n)
              (choice-best-id-scan d (+ i 1) role best score)))
          (choice-best-id-scan d (+ i 1) role best score))
        (choice-best-id-scan d (+ i 1) role best score)))))

(defn choice-best-score-scan [d :document i :i64 role :keyword best :i64] :i64
  (if (= i (document-count d))
    best
    (let [row (at d i)]
      (if (= (kw-at row 0) :choice)
        (if (= (kw-at row 1) role)
          (let [n (option-or (document-i64-value (at row 3)) 0)]
            (if (> n best)
              (choice-best-score-scan d (+ i 1) role n)
              (choice-best-score-scan d (+ i 1) role best)))
          (choice-best-score-scan d (+ i 1) role best))
        (choice-best-score-scan d (+ i 1) role best)))))

(defn choice-id [d :document role :keyword] :keyword
  (choice-best-id-scan d 0 role :oak/none -1))

(defn choice-score [d :document role :keyword] :i64
  (choice-best-score-scan d 0 role -1))

(defn choice-score-count-scan [d :document i :i64 role :keyword score :i64 n :i64] :i64
  (if (= i (document-count d))
    n
    (let [row (at d i)]
      (if (= (kw-at row 0) :choice)
        (if (= (kw-at row 1) role)
          (if (= (option-or (document-i64-value (at row 3)) -1) score)
            (choice-score-count-scan d (+ i 1) role score (+ n 1))
            (choice-score-count-scan d (+ i 1) role score n))
          (choice-score-count-scan d (+ i 1) role score n))
        (choice-score-count-scan d (+ i 1) role score n)))))

(defn choice-unambiguous? [d :document role :keyword] :bool
  (= (choice-score-count-scan d 0 role (choice-score d role) 0) 1))

(defn role-admitted? [goal :keyword decisions :document role :keyword] :bool
  (let [id (choice-id decisions role)
        score (choice-score decisions role)
        floor (confidence-floor role)]
    (if (= id :oak/none)
      false
      (if (< floor 0)
        false
        (if (< score floor)
          false
          (if (> score 10000)
            false
            (if (choice-unambiguous? decisions role)
              (if (= (component-kind id) role)
                (permitted? goal role id)
                false)
              false)))))))

(defn selection-coherent? [decisions :document] :bool
  (let [reasoner (choice-id decisions :reasoner)
        shape (choice-id decisions :shape)
        query (choice-id decisions :query)
        view (choice-id decisions :view)
        action (choice-id decisions :action)
        effect (choice-id decisions :effect)
        implementation (choice-id decisions :implementation)]
    (if (required? query :reasoner reasoner)
      (if (required? view :shape shape)
        (if (required? view :query query)
          (if (required? action :shape shape)
            (if (implementation-binds? implementation action)
              (= (app-row-scan (app-ontology-doc) 0 :dispatch action 5) effect)
              false)
            false)
          false)
        false)
      false)))

(defn all-roles-admitted? [goal :keyword decisions :document] :bool
  (if (role-admitted? goal decisions :reasoner)
    (if (role-admitted? goal decisions :shape)
      (if (role-admitted? goal decisions :query)
        (if (role-admitted? goal decisions :view)
          (if (role-admitted? goal decisions :action)
            (if (role-admitted? goal decisions :effect)
              (if (role-admitted? goal decisions :implementation)
                (selection-coherent? decisions)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn app-transaction [goal :keyword decisions :document] :document
  (document-vector (document-keyword :oak.transaction/v1)
                   (document-keyword goal)
                   (document-string (app-ontology-digest))
                   decisions))

(defn transaction-goal [transaction :document] :keyword
  (kw-at transaction 1))

(defn transaction-decisions [transaction :document] :document
  (at transaction 3))

(defn transaction-valid? [transaction :document] :bool
  (if (= (document-count transaction) 4)
    (if (= (kw-at transaction 0) :oak.transaction/v1)
      (let [goal (transaction-goal transaction)
            decisions (transaction-decisions transaction)]
        (if (string=? (option-or (document-string-value (at transaction 2)) "")
                      (app-ontology-digest))
          (if (app-goal? goal)
            (all-roles-admitted? goal decisions)
            false)
          false))
      false)
    false))

;; The execution value is the code that Jev is allowed to synthesize.  It is
;; not source text or a function name: it is a closed, typed ontology value
;; spanning the six canonical runtime planes.  The runtime re-derives this
;; exact value from the current ontology before admitting an effect.

(defn execution-ir [goal :keyword decisions :document] :document
  (let [shape (choice-id decisions :shape)
        action (choice-id decisions :action)
        effect (choice-id decisions :effect)
        implementation (choice-id decisions :implementation)
        event (app-row-scan (app-ontology-doc) 0 :dispatch action 2)
        op (app-row-scan (app-ontology-doc) 0 :dispatch action 3)
        target (app-row-scan (app-ontology-doc) 0 :dispatch action 4)
        capability (kw-at (component-body effect) 1)]
    (document-vector
     (document-vector (document-keyword :execution/version)
                      (document-keyword :oak.execution/v1))
     (document-vector (document-keyword :execution/state)
                      (document-keyword shape))
     (document-vector (document-keyword :execution/transaction)
                      (document-keyword action)
                      (document-keyword event))
     (document-vector (document-keyword :execution/capability)
                      (document-keyword effect)
                      (document-keyword capability))
     (document-vector (document-keyword :execution/causal-link)
                      (document-keyword event)
                      (document-keyword op))
     (document-vector (document-keyword :execution/effect)
                      (document-keyword op)
                      (document-keyword target))
     (document-vector (document-keyword :execution/implementation)
                      (document-keyword implementation)
                      (document-string (binding-scan (app-ontology-doc) 0 implementation))))))

(defn execution-ir-valid? [ir :document goal :keyword decisions :document] :bool
  (document-equal? ir (execution-ir goal decisions)))

(defn ir-keyword-scan [ir :document i :i64 key :keyword slot :i64] :keyword
  (if (= i (document-count ir))
    :oak/none
    (let [row (at ir i)]
      (if (= (kw-at row 0) key)
        (kw-at row slot)
        (ir-keyword-scan ir (+ i 1) key slot)))))

(defn app-manifest [transaction :document] :document
  (let [goal (transaction-goal transaction)
        decisions (transaction-decisions transaction)
        ir (execution-ir goal decisions)]
   (document-vector
   (document-vector (document-keyword :app/goal) (document-keyword goal))
   (document-vector (document-keyword :app/transaction)
                    (document-string (document-sha256 transaction))
                    transaction)
   (document-vector (document-keyword :app/reasoner)
                    (document-keyword (choice-id decisions :reasoner))
                    (document-string (component-digest (choice-id decisions :reasoner))))
   (document-vector (document-keyword :app/shape)
                    (document-keyword (choice-id decisions :shape))
                    (document-string (component-digest (choice-id decisions :shape))))
   (document-vector (document-keyword :app/query)
                    (document-keyword (choice-id decisions :query))
                    (document-string (component-digest (choice-id decisions :query))))
   (document-vector (document-keyword :app/view)
                    (document-keyword (choice-id decisions :view))
                    (document-string (component-digest (choice-id decisions :view))))
   (document-vector (document-keyword :app/action)
                    (document-keyword (choice-id decisions :action))
                    (document-string (component-digest (choice-id decisions :action))))
   (document-vector (document-keyword :app/effect)
                    (document-keyword (choice-id decisions :effect))
                    (document-string (component-digest (choice-id decisions :effect))))
   (document-vector (document-keyword :app/implementation)
                    (document-keyword (choice-id decisions :implementation))
                    (document-string (component-digest (choice-id decisions :implementation)))
                    (document-string (binding-scan (app-ontology-doc) 0
                                                   (choice-id decisions :implementation))))
   (document-vector (document-keyword :app/ontology)
                    (document-string (app-ontology-digest)))
   (document-vector (document-keyword :app/execution)
                    (document-string (document-sha256 ir))
                    ir))))

(defn compile-app-transaction [transaction :document]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (if (transaction-valid? transaction)
    (let [manifest (app-manifest transaction)]
      (ok manifest (evidence :compile-app-transaction manifest)))
    (rejected :oak/invalid-app-transaction
              "transaction version, ontology digest, goal, or typed selections are invalid")))

(defn compile-app [goal :keyword decisions :document]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (if (app-goal? goal)
    (if (all-roles-admitted? goal decisions)
      (compile-app-transaction (app-transaction goal decisions))
      (rejected :oak/incomplete-app-decision
                "choice missing, ambiguous, outside 0.80..1.00, wrong kind, incoherent, or not permitted"))
    (rejected :oak/unknown-app-goal "goal is absent from the ontology")))

(defn manifest-value-scan [m :document i :i64 key :keyword] :keyword
  (if (= i (document-count m))
    :oak/none
    (let [row (at m i)]
      (if (= (kw-at row 0) key)
        (kw-at row 1)
        (manifest-value-scan m (+ i 1) key)))))

(defn manifest-string-scan [m :document i :i64 key :keyword] :string
  (if (= i (document-count m))
    ""
    (let [row (at m i)]
      (if (= (kw-at row 0) key)
        (option-or (document-string-value (at row 1)) "")
        (manifest-string-scan m (+ i 1) key)))))

(defn manifest-slot-string-scan [m :document i :i64 key :keyword slot :i64] :string
  (if (= i (document-count m))
    ""
    (let [row (at m i)]
      (if (= (kw-at row 0) key)
        (option-or (document-string-value (at row slot)) "")
        (manifest-slot-string-scan m (+ i 1) key slot)))))

(defn manifest-slot-document-scan [m :document i :i64 key :keyword slot :i64] :document
  (if (= i (document-count m))
    (document-null)
    (let [row (at m i)]
      (if (= (kw-at row 0) key)
        (at row slot)
        (manifest-slot-document-scan m (+ i 1) key slot)))))

(defn manifest-row-size-scan [m :document i :i64 key :keyword size :i64] :bool
  (if (= i (document-count m))
    false
    (let [row (at m i)]
      (if (= (kw-at row 0) key)
        (= (document-count row) size)
        (manifest-row-size-scan m (+ i 1) key size)))))

;; The digest check is separate from the role check.  The component validator
;; intentionally re-reads each selected component's digest from the
;; manifest, so a caller cannot keep an allowed identifier and swap its body.

(defn manifest-component-valid-scan [m :document i :i64 key :keyword role :keyword goal :keyword] :bool
  (if (= i (document-count m))
    false
    (let [row (at m i)]
      (if (= (kw-at row 0) key)
        (let [id (kw-at row 1)
              digest (option-or (document-string-value (at row 2)) "")
              size (if (= role :implementation) 4 3)]
          (if (= (document-count row) size)
            (if (= (component-kind id) role)
              (if (permitted? goal role id)
                (string=? digest (component-digest id))
                false)
              false)
            false))
        (manifest-component-valid-scan m (+ i 1) key role goal)))))

(defn manifest-selections-match? [m :document decisions :document] :bool
  (if (= (manifest-value-scan m 0 :app/reasoner) (choice-id decisions :reasoner))
    (if (= (manifest-value-scan m 0 :app/shape) (choice-id decisions :shape))
      (if (= (manifest-value-scan m 0 :app/query) (choice-id decisions :query))
        (if (= (manifest-value-scan m 0 :app/view) (choice-id decisions :view))
          (if (= (manifest-value-scan m 0 :app/action) (choice-id decisions :action))
            (if (= (manifest-value-scan m 0 :app/effect) (choice-id decisions :effect))
              (= (manifest-value-scan m 0 :app/implementation)
                 (choice-id decisions :implementation))
              false)
            false)
          false)
        false)
      false)
    false))

(defn manifest-implementation-valid? [m :document] :bool
  (let [implementation (manifest-value-scan m 0 :app/implementation)
        action (manifest-value-scan m 0 :app/action)
        binding (binding-scan (app-ontology-doc) 0 implementation)]
    (if (string=? binding "")
      false
      (if (implementation-binds? implementation action)
        (string=? (manifest-slot-string-scan m 0 :app/implementation 3) binding)
        false))))

(defn manifest-components-valid? [m :document goal :keyword] :bool
  (if (manifest-component-valid-scan m 0 :app/reasoner :reasoner goal)
    (if (manifest-component-valid-scan m 0 :app/shape :shape goal)
      (if (manifest-component-valid-scan m 0 :app/query :query goal)
        (if (manifest-component-valid-scan m 0 :app/view :view goal)
          (if (manifest-component-valid-scan m 0 :app/action :action goal)
            (if (manifest-component-valid-scan m 0 :app/effect :effect goal)
              (if (manifest-component-valid-scan
                   m 0 :app/implementation :implementation goal)
                (manifest-implementation-valid? m)
                false)
              false)
            false)
          false)
        false)
      false)
    false))

(defn manifest-provenance-valid? [m :document goal :keyword transaction :document ir :document] :bool
  (let [decisions (transaction-decisions transaction)]
    (if (manifest-row-size-scan m 0 :app/transaction 3)
      (if (transaction-valid? transaction)
        (if (= goal (transaction-goal transaction))
          (if (string=? (manifest-string-scan m 0 :app/transaction)
                        (document-sha256 transaction))
            (if (manifest-selections-match? m decisions)
              (if (manifest-row-size-scan m 0 :app/execution 3)
                (if (string=? (manifest-string-scan m 0 :app/execution)
                              (document-sha256 ir))
                  (execution-ir-valid? ir goal decisions)
                  false)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn manifest-valid? [m :document] :bool
  (let [goal (manifest-value-scan m 0 :app/goal)
        transaction (manifest-slot-document-scan m 0 :app/transaction 2)
        ir (manifest-slot-document-scan m 0 :app/execution 2)]
    (if (= (document-count m) 11)
      (if (manifest-row-size-scan m 0 :app/goal 2)
        (if (app-goal? goal)
          (if (manifest-row-size-scan m 0 :app/ontology 2)
            (if (string=? (manifest-string-scan m 0 :app/ontology) (app-ontology-digest))
              (if (manifest-provenance-valid? m goal transaction ir)
                (manifest-components-valid? m goal)
                false)
              false)
            false)
          false)
        false)
      false)))

(defn query-app [manifest :document]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (if (manifest-valid? manifest)
    (let [query (manifest-value-scan manifest 0 :app/query)
          reasoner (manifest-value-scan manifest 0 :app/reasoner)
          shape (manifest-value-scan manifest 0 :app/shape)]
      (ok (document-vector (component-body reasoner)
                           (component-body shape)
                           (component-body query)
                           (manifest-slot-document-scan manifest 0 :app/execution 2))
          (evidence :query-app
                    (document-vector (document-keyword reasoner)
                                     (document-keyword shape)
                                     (document-keyword query)))))
    (rejected :oak/invalid-app-manifest "manifest is not derived from the current ontology")))

(defn dispatch-scan [d :document i :i64 action :keyword event :keyword slot :i64] :keyword
  (if (= i (document-count d))
    :oak/none
    (let [row (at d i)]
      (if (= (kw-at row 0) :dispatch)
        (if (= (kw-at row 1) action)
          (if (= (kw-at row 2) event)
            (kw-at row slot)
            (dispatch-scan d (+ i 1) action event slot))
          (dispatch-scan d (+ i 1) action event slot))
        (dispatch-scan d (+ i 1) action event slot)))))

(defn shacl-in-scan [constraint :document i :i64 value :keyword] :bool
  (if (= i (document-count constraint))
    false
    (if (= (kw-at constraint i) value)
      true
      (shacl-in-scan constraint (+ i 1) value))))

(defn shacl-constraint-valid? [constraint :document value :document] :bool
  (if (= (kw-at constraint 0) :oak/none)
    true
    (if (= (kw-at constraint 0) :shacl/in)
      (if (option-some? (document-keyword-value value))
        (shacl-in-scan constraint 1
                       (option-or (document-keyword-value value) :oak/none))
        false)
      false)))

(defn shacl-value-type-valid? [value :document type :keyword] :bool
  (if (= type :string)
    (option-some? (document-string-value value))
    (if (= type :keyword)
      (option-some? (document-keyword-value value))
      false)))

(defn shacl-property-valid? [input :document property :document] :bool
  (let [name (kw-at property 1)
        type (kw-at property 2)
        min-count (option-or (document-i64-value (at property 3)) 0)
        max-count (option-or (document-i64-value (at property 4)) 0)
        found (document-get input (document-keyword name))]
    (if (option-some? found)
      (if (< max-count 1)
        false
        (let [value (option-or found (document-null))]
          (if (shacl-value-type-valid? value type)
            (shacl-constraint-valid?
             (if (> (document-count property) 5) (at property 5) (document-vector))
             value)
            false)))
      (= min-count 0))))

(defn shacl-properties-valid-scan [body :document i :i64 input :document] :bool
  (if (= i (document-count body))
    true
    (let [property (at body i)]
      (if (= (kw-at property 0) :shacl/property)
        (if (shacl-property-valid? input property)
          (shacl-properties-valid-scan body (+ i 1) input)
          false)
        false))))

(defn shacl-shape-valid? [shape :keyword input :document target :keyword] :bool
  (let [body (component-body shape)]
    (if (= (kw-at body 0) :shacl/node)
      (if (= (kw-at body 1) target)
        (shacl-properties-valid-scan body 2 input)
        false)
      false)))

(defn run-app [manifest :document event :keyword input :document]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (if (manifest-valid? manifest)
    (let [ir (manifest-slot-document-scan manifest 0 :app/execution 2)
          shape (ir-keyword-scan ir 0 :execution/state 1)
          expected-event (ir-keyword-scan ir 0 :execution/transaction 2)
          effect (ir-keyword-scan ir 0 :execution/capability 1)
          op (ir-keyword-scan ir 0 :execution/effect 1)
          arg (ir-keyword-scan ir 0 :execution/effect 2)]
      (if (= event expected-event)
        (if (= op :op/declare)
          (if (= effect (manifest-value-scan manifest 0 :app/effect))
          (if (shacl-shape-valid? shape input arg)
            (do-declare
             (option-or (document-string-value
                         (option-or (document-get input (document-keyword :id))
                                    (document-null))) "")
             arg)
            (rejected :oak/shape-violation "input does not satisfy the selected SHACL shape"))
          (rejected :oak/effect-mismatch "selected effect does not admit the action"))
          (rejected :oak/unknown-app-event "execution IR contains no admitted operation"))
        (rejected :oak/unknown-app-event "event does not match the typed execution transaction")))
    (rejected :oak/invalid-app-manifest "manifest is not derived from the current ontology")))

(defn tender-decisions-at-floors [action-confidence :i64 effect-confidence :i64] :document
  (document-vector
   (document-vector (document-keyword :choice) (document-keyword :reasoner)
                    (document-keyword :reasoner/owl2-rl) (document-i64 9000))
   (document-vector (document-keyword :choice) (document-keyword :shape)
                    (document-keyword :shape/tender-input) (document-i64 9700))
   (document-vector (document-keyword :choice) (document-keyword :query)
                    (document-keyword :query/open-tenders) (document-i64 9400))
   (document-vector (document-keyword :choice) (document-keyword :view)
                    (document-keyword :view/tender-form) (document-i64 9300))
   (document-vector (document-keyword :choice) (document-keyword :action)
                    (document-keyword :action/declare-tender) (document-i64 action-confidence))
   (document-vector (document-keyword :choice) (document-keyword :effect)
                    (document-keyword :effect/dataspace-transact) (document-i64 effect-confidence))
   (document-vector (document-keyword :choice) (document-keyword :implementation)
                    (document-keyword :impl/oak-declare) (document-i64 9800))))

(defn tender-decisions-at [action-confidence :i64] :document
  (tender-decisions-at-floors action-confidence 9950))

(defn compile-tender-app-at [action-confidence :i64]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (compile-app :goal/tender-intake (tender-decisions-at action-confidence)))

(defn compile-tender-app-effect-at [effect-confidence :i64]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (compile-app :goal/tender-intake
               (tender-decisions-at-floors 9900 effect-confidence)))

(defn compile-tender-app []
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (compile-tender-app-at 9900))

(defn run-tender-app-event [event :keyword entity :string status :keyword]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (let [compiled (compile-tender-app)]
    (match-variant compiled
      [:variant :oak/outcome
       [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
        [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
      (:ok x (run-app (record-get x :value) event
                      (document-map :id (document-string entity)
                                    :status (document-keyword status))))
      (:rejected x compiled))))

(defn run-tender-app [entity :string status :keyword]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (run-tender-app-event :event/submit entity status))

;; ---------------------------------------------------------------- F, the functions
;;
;; Every one of these is reached only after `oak-call` has admitted the request
;; against S. Nothing here is exported.

(defn do-declare [e :string t :keyword]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (if (entity-declared? t)
    (if (at-capacity? (all-types))
      (rejected :oak/graph-at-capacity e)
      (let [written (ds-written (assert! (document-vector (document-keyword :is-a)
                                                          (document-string e)
                                                          (document-keyword t))))]
        (ok (document-i64 written)
            (evidence :declare (document-vector (document-string e) (document-keyword t))))))
    (rejected :oak/unknown-entity-type e)))

(defn do-relate [s :string r :keyword o :string]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (let [dom (relation-domain r)]
    (if (= dom :oak/none)
      (rejected :oak/unknown-relation s)
      (let [rng (relation-range r)
            st (type-of s)
            ot (type-of o)]
        (if (= st :oak/untyped)
          (rejected :oak/untyped-subject s)
          (if (= ot :oak/untyped)
            (rejected :oak/untyped-object o)
            (if (= st dom)
              (if (= ot rng)
                (if (at-capacity? (all-facts))
                  (rejected :oak/graph-at-capacity s)
                  (let [written (ds-written
                                 (assert! (document-vector (document-keyword :fact)
                                                           (document-string s)
                                                           (document-keyword r)
                                                           (document-string o))))]
                    (ok (document-i64 written)
                        (evidence :relate (document-vector (document-string s)
                                                           (document-keyword r)
                                                           (document-string o))))))
                (rejected :oak/range-violation o))
              (rejected :oak/domain-violation s))))))))

(defn do-related [s :string r :keyword]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (if (= (relation-domain r) :oak/none)
    (rejected :oak/unknown-relation s)
    (ok (objects-scan (all-facts) 0 s r (document-vector))
        (evidence :related (document-vector (document-string s) (document-keyword r))))))

(defn do-census [t :keyword]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (if (entity-declared? t)
    (ok (document-i64 (census-scan (all-types) 0 t 0))
        (evidence :census (document-keyword t)))
    (rejected :oak/unknown-entity-type "census")))

;; ---------------------------------------------------------------- the kernel entry
;;
;; The single door. An agent produces a value of the call variant and nothing
;; else; it never holds the dataspace capability and never names a pattern.

(defn oak-call [call [:variant :oak/call
                      [[:declare [:record :oak/declare [[:entity :string] [:type :keyword]]]]
                       [:relate [:record :oak/relate
                                 [[:subject :string] [:relation :keyword] [:object :string]]]]
                       [:related [:record :oak/related
                                  [[:subject :string] [:relation :keyword]]]]
                       [:census [:record :oak/census [[:type :keyword]]]]]]]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (match-variant call
    [:variant :oak/call
     [[:declare [:record :oak/declare [[:entity :string] [:type :keyword]]]]
      [:relate [:record :oak/relate
                [[:subject :string] [:relation :keyword] [:object :string]]]]
      [:related [:record :oak/related
                 [[:subject :string] [:relation :keyword]]]]
      [:census [:record :oak/census [[:type :keyword]]]]]]
    (:declare x (do-declare (record-get x :entity) (record-get x :type)))
    (:relate x (do-relate (record-get x :subject) (record-get x :relation)
                          (record-get x :object)))
    (:related x (do-related (record-get x :subject) (record-get x :relation)))
    (:census x (do-census (record-get x :type)))))

(defn main [] 0)

;; ---------------------------------------------------------------- the browser door
;;
;; A host cannot hand the kernel a call value. `browser-host.mjs` admits a
;; compound argument only if the host itself minted it, and the constructors it
;; exposes are vector-i64, vector-f64, string-index, disjoint-set-i64, document
;; and bytes -- there is no record and no variant among them. So a call
;; originating outside the guest has to arrive as scalars and be assembled
;; here.
;;
;; This is a second ENTRY, not a second kernel: each of these builds the call
;; value and hands it to `oak-call`, so S is still consulted in exactly one
;; place and nothing below gains a way to reach the dataspace unadmitted.

(defn call-declare [e :string t :keyword]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (oak-call (variant-new [:variant :oak/call
   [[:declare [:record :oak/declare [[:entity :string] [:type :keyword]]]]
    [:relate [:record :oak/relate
              [[:subject :string] [:relation :keyword] [:object :string]]]]
    [:related [:record :oak/related
               [[:subject :string] [:relation :keyword]]]]
    [:census [:record :oak/census [[:type :keyword]]]]]] :declare
                         (record-new [:record :oak/declare
                                      [[:entity :string] [:type :keyword]]] e t))))

(defn call-relate [s :string r :keyword o :string]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (oak-call (variant-new [:variant :oak/call
   [[:declare [:record :oak/declare [[:entity :string] [:type :keyword]]]]
    [:relate [:record :oak/relate
              [[:subject :string] [:relation :keyword] [:object :string]]]]
    [:related [:record :oak/related
               [[:subject :string] [:relation :keyword]]]]
    [:census [:record :oak/census [[:type :keyword]]]]]] :relate
                         (record-new [:record :oak/relate
                                      [[:subject :string] [:relation :keyword]
                                       [:object :string]]] s r o))))

(defn call-related [s :string r :keyword]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (oak-call (variant-new [:variant :oak/call
   [[:declare [:record :oak/declare [[:entity :string] [:type :keyword]]]]
    [:relate [:record :oak/relate
              [[:subject :string] [:relation :keyword] [:object :string]]]]
    [:related [:record :oak/related
               [[:subject :string] [:relation :keyword]]]]
    [:census [:record :oak/census [[:type :keyword]]]]]] :related
                         (record-new [:record :oak/related
                                      [[:subject :string] [:relation :keyword]]] s r))))

(defn call-census [t :keyword]
  [:variant :oak/outcome
   [[:ok [:record :oak/ok [[:value :document] [:evidence :document]]]]
    [:rejected [:record :oak/rejected [[:code :keyword] [:detail :string]]]]]]
  (oak-call (variant-new [:variant :oak/call
   [[:declare [:record :oak/declare [[:entity :string] [:type :keyword]]]]
    [:relate [:record :oak/relate
              [[:subject :string] [:relation :keyword] [:object :string]]]]
    [:related [:record :oak/related
               [[:subject :string] [:relation :keyword]]]]
    [:census [:record :oak/census [[:type :keyword]]]]]] :census
                         (record-new [:record :oak/census [[:type :keyword]]] t))))
