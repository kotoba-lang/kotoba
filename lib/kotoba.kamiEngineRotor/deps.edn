{:paths ["src"]
 ;; Reduced-order rotor solver on the shared, purpose-split libs.
 ;; Registers :rom-rotor on the cae-solver contract; turns a multirotor's
 ;; per-rotor thrust requirement into a sized rotor (diameter, RPM, shaft
 ;; power, torque) that motor.solver/size-for-power can then size a motor for.
 ;; A blade-resolved kami-cfd solve registers a higher-fidelity kind on the
 ;; same contract later.
 :deps {
        io.github.kotoba-lang/test
        {:local/root "../kotoba.test"}io.github.kotoba-lang/datom
        {:local/root "../kotoba.datom"}
        io.github.kotoba-lang/kami-engine-cae-solver {:local/root "../kotoba.kamiEngineCaeSolver"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
