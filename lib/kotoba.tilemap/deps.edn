{:paths ["src"]
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/process {:local/root "../kotoba.process"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :aliases {:test {:extra-paths ["test"]
                  ;; kotoba-lang/amu is a TEST-ONLY dependency: it is needed by
                  ;; the tests that compile src/tilemap.kotoba and compare it with
                  ;; src/tilemap.cljk (ADR 0001 as amended, and ADR-2608134800 in
                  ;; com-junkawasaki/root). Consumers require only the .cljc and must
                  ;; not be made to drag the compiler in behind it — kotoba-lang/css,
                  ;; /dsl-core, /async and /postfx set the same boundary.
                  :extra-deps {
                               io.github.kotoba-lang/amu
                               {:git/url "https://github.com/kotoba-lang/amu.git"
                                :git/sha "c3be07fb38bf457a159a2b304152e18693f9b0b6"}}}}}
