(ns tilemap
  (:export [main empty-tile solid-tile tile-empty? tile-solid? tile-layer
            layer-get layer-set tilemap add-layer world-to-tile tile-to-world
            solid? layer-to-instances]))

(defn field [value :document key :keyword] :document
  (option-or (document-get value key) (document-null)))
(defn doc-i64 [value :document] :i64
  (option-or (document-i64-value value) 0))
(defn doc-f64 [value :document] :f64
  (option-or (document-f64-value value) 0.0))

(defn empty-tile [] :document
  (document-map :id (document-i64 0) :flags (document-i64 0)))
(defn solid-tile [id :i64] :document
  (document-map :id (document-i64 id) :flags (document-i64 1)))
(defn tile-empty? [tile :document] :bool
  (if (= (doc-i64 (field tile :id)) 0) true false))
(defn tile-solid? [tile :document] :bool
  (if (= (bit-and (doc-i64 (field tile :flags)) 1) 0) false true))

(defn tile-layer [name :string width :i64 height :i64] :document
  (let [checked-width (if (> width 0) width (quot 1 0))
        checked-height (if (> height 0) height (quot 1 0))]
    (document-map :name (document-string name)
                  :width (document-i64 checked-width)
                  :height (document-i64 checked-height)
                  :tiles (document-vector)
                  :visible (document-bool true)
                  :opacity (document-f64 1.0)
                  :z-order (document-i64 0))))

(defn entry-x [entry :document] :i64 (doc-i64 (field entry :x)))
(defn entry-y [entry :document] :i64 (doc-i64 (field entry :y)))
(defn find-entry-index [entries :document size :i64 index :i64 x :i64 y :i64] :i64
  (if (= index size)
    -1
    (let [entry (option-or (document-vector-at entries index) (document-null))]
      (if (and (= x (entry-x entry)) (= y (entry-y entry)))
        index
        (find-entry-index entries size (+ index 1) x y)))))

(defn layer-entry-index [layer :document x :i64 y :i64] :i64
  (let [entries (field layer :tiles)]
    (find-entry-index entries (document-count entries) 0 x y)))

(defn in-bounds? [layer :document x :i64 y :i64] :bool
  (if (and (>= x 0) (>= y 0)
           (< x (doc-i64 (field layer :width)))
           (< y (doc-i64 (field layer :height)))) true false))

(defn layer-get [layer :document x :i64 y :i64] :document
  (if (in-bounds? layer x y)
    (let [index (layer-entry-index layer x y)]
      (if (>= index 0)
        (field (option-or (document-vector-at (field layer :tiles) index)
                          (document-null)) :tile)
        (empty-tile)))
    (empty-tile)))

(defn layer-set [layer :document x :i64 y :i64 tile :document] :document
  (if (in-bounds? layer x y)
    (let [entries (field layer :tiles)
          index (layer-entry-index layer x y)]
      (if (tile-empty? tile)
        (if (>= index 0)
          (document-assoc layer :tiles (document-vector-remove entries index))
          layer)
        (let [entry (document-map :x (document-i64 x) :y (document-i64 y) :tile tile)]
          (document-assoc layer :tiles
            (if (>= index 0)
              (document-vector-assoc entries index entry)
              (document-vector-conj entries entry))))))
    layer))

(defn tilemap [tile-size :f64] :document
  (let [checked (if (f64-lt 0.0 tile-size) tile-size (f64-div 1.0 0.0))]
    (document-map :tile-size (document-f64 checked) :layers (document-vector))))
(defn add-layer [tile-map :document layer :document] :document
  (document-assoc tile-map :layers
    (document-vector-conj (field tile-map :layers) layer)))

(defn floor-f64 [value :f64] :i64
  (let [truncated (f64-to-i64-truncating value)
        restored (i64-to-f64-checked truncated)]
    (if (and (f64-lt value 0.0) (bool-not (f64-eq value restored)))
      (- truncated 1)
      truncated)))

(defn world-to-tile [tile-map :document position :document] :document
  (let [size (doc-f64 (field tile-map :tile-size))
        x (doc-f64 (option-or (document-vector-at position 0) (document-null)))
        y (doc-f64 (option-or (document-vector-at position 1) (document-null)))]
    (document-vector (document-i64 (floor-f64 (f64-div x size)))
                     (document-i64 (floor-f64 (f64-div y size))))))

(defn tile-to-world [tile-map :document tile-x :i64 tile-y :i64] :document
  (let [size (doc-f64 (field tile-map :tile-size))]
    (document-vector
      (document-f64 (f64-mul (f64-add (i64-to-f64-checked tile-x) 0.5) size))
      (document-f64 (f64-mul (f64-add (i64-to-f64-checked tile-y) 0.5) size)))))

(defn solid-layers? [layers :document size :i64 index :i64 tile-x :i64 tile-y :i64] :bool
  (if (= index size)
    false
    (let [layer (option-or (document-vector-at layers index) (document-null))]
      (if (tile-solid? (layer-get layer tile-x tile-y))
        true
        (solid-layers? layers size (+ index 1) tile-x tile-y)))))

(defn solid? [tile-map :document tile-x :i64 tile-y :i64] :bool
  (if (or (< tile-x 0) (< tile-y 0))
    false
    (let [layers (field tile-map :layers)]
      (solid-layers? layers (document-count layers) 0 tile-x tile-y))))

(defn instance-for [entry :document tile-size :f64] :document
  (let [tile (field entry :tile)]
    (document-vector
      (document-f64 (f64-mul (i64-to-f64-checked (entry-x entry)) tile-size))
      (document-f64 (f64-mul (i64-to-f64-checked (entry-y entry)) tile-size))
      (document-f64 tile-size)
      (document-f64 (i64-to-f64-checked (doc-i64 (field tile :id)))))))

(defn build-instances [entries :document size :i64 index :i64
                       tile-size :f64 output :document] :document
  (if (= index size)
    output
    (let [entry (option-or (document-vector-at entries index) (document-null))
          empty (tile-empty? (field entry :tile))]
      (if empty
        (build-instances entries size (+ index 1) tile-size output)
        (build-instances entries size (+ index 1) tile-size
          (document-vector-conj output (instance-for entry tile-size)))))))

(defn layer-to-instances [tile-map :document layer-index :i64] :document
  (let [layer (option-or (document-vector-at (field tile-map :layers) layer-index)
                         (document-null))
        entries (field layer :tiles)
        size (document-count entries)
        tile-size (doc-f64 (field tile-map :tile-size))]
    (build-instances entries size 0 tile-size (document-vector))))

(defn main [] :i64
  (let [layer (layer-set (tile-layer "ground" 10 10) 5 3 (solid-tile 1))
        map (add-layer (tilemap 16.0) layer)]
    (if (solid? map 5 3) 0 1)))
