{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:deps.etzhayyim.com",
  "convoSystemPrompt": "You are kotodama-linker-dependencies agent. Component WIT dependency graph, linker scoring, and deployment hook ingestion. Respond helpfully in the users language.",
  "deploy": {},
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "deps-policy"
    ]
  },
  "hooks": [
    {
      "events": [
        "post_deploy"
      ],
      "kind": "http",
      "name": "deps-self-ingest",
      "timeoutSec": 15,
      "url": "https://deps.etzhayyim.com/api/hooks/component"
    }
  ],
  "kpi": [
    "credits の獲得"
  ],
  "name": "kotodama-linker-dependencies",
  "nanoid": "deps",
  "performerType": "system",
  "profile": {
    "capabilities": [
      "domain-query",
      "data-management"
    ],
    "description": "Component WIT dependency graph, linker scoring, and deployment hook ingestion",
    "displayName": "WIT Dependency Visualizer"
  },
  "project": "deps",
  "runtimeType": "worker",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.like",
        "app.bsky.feed.post",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.deps.depsEntity",
        "com.etzhayyim.apps.deps.depsEvent",
        "com.etzhayyim.apps.deps.depsReport"
      ]
    }
  },
  "uiType": "appview"
}
