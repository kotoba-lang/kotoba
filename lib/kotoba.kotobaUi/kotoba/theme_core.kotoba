(ns theme-core
  ;; No :export: parity harness appends zero-arg case defns via KIR.
  (:schemas {;; T5.2 native guest record: multi-arg pure → single record
             :ui/hex-digit-at [:record :ui/hex-digit-at
                               [[:s :string] [:i :i64]]]
             :ui/hex-byte-at [:record :ui/hex-byte-at
                              [[:s :string] [:i :i64]]]
             :ui/nibble-byte [:record :ui/nibble-byte
                              [[:s :string] [:i :i64]]]
             :ui/rgba-of [:record :ui/rgba-of
                          [[:r :i64] [:g :i64] [:b :i64] [:alpha :string]]]
             :ui/hex-rgba [:record :ui/hex-rgba
                           [[:hex :string] [:alpha :string]]]
             :ui/join-nl [:record :ui/join-nl
                          [[:a :string] [:b :string]]]
             :ui/layer-wrap [:record :ui/layer-wrap
                             [[:layer :string] [:body :string]]]}))

;; A `.kotoba` port of the pure string core of `kotoba-ui.theme` (+ shell
;; class/layout constants) — ADR-2607270100 §10 form A, the final step of
;; css -> html -> shitsuke -> liquid-glass-ui -> kotoba-ui.
;;
;; No capabilities (kotoba/pure). Full theme-css composition still lives on
;; the .cljc side because it joins shitsuke.hig + liquid-glass.style +
;; shell-css host outputs; what is gated here is the unique pure logic
;; this composition layer owns:
;;
;;   - hex->rgba (accent → glass rgba tokens)
;;   - shell class-name + layout constants
;;   - cascade layer-order + layer wrap
;;   - accent → --hig-color-tint / --liquid-glass-accent-* declaration lines
;;
;; hex parsing uses string-code-point-at (ASCII) rather than a digit-index
;; scan: string-substring only accepts literal haystacks. 3-digit #RGB
;; expands via nibble*17 (same as doubling each hex digit).
;; T5.2: multi-arg pure folded into single guest records.

;; --- i64 -> string --------------------------------------------------------

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

;; --- hex digit / byte -----------------------------------------------------
;; Code points: 0-9 = 48-57, A-F = 65-70, a-f = 97-102.

(defn hex-digit-cp [cp :i64] :i64
  (if (if (>= cp 48) (if (<= cp 57) true false) false)
    (- cp 48)
    (if (if (>= cp 97) (if (<= cp 102) true false) false)
      (- cp 87)
      (if (if (>= cp 65) (if (<= cp 70) true false) false)
        (- cp 55)
        0))))

(defn hex-body [hex :string] :string
  (string-replace-all hex "#" ""))

(defn hex-digit-at [x [:ref :ui/hex-digit-at]] :i64
  (let [s (record-get x :s)
        i (record-get x :i)]
    (hex-digit-cp (string-code-point-at s i))))

(defn hex-byte-at [x [:ref :ui/hex-byte-at]] :i64
  (let [s (record-get x :s)
        i (record-get x :i)]
    (+ (* 16 (hex-digit-at (record-new [:ref :ui/hex-digit-at] s i)))
       (hex-digit-at (record-new [:ref :ui/hex-digit-at] s (+ i 1))))))

(defn nibble-byte [x [:ref :ui/nibble-byte]] :i64
  (let [s (record-get x :s)
        i (record-get x :i)]
    (* 17 (hex-digit-at (record-new [:ref :ui/hex-digit-at] s i)))))

(defn rgba-of [x [:ref :ui/rgba-of]] :string
  (let [r (record-get x :r)
        g (record-get x :g)
        b (record-get x :b)
        alpha (record-get x :alpha)]
    (string-concat "rgba("
                   (string-concat (i64-str r)
                                  (string-concat ","
                                                 (string-concat (i64-str g)
                                                                (string-concat ","
                                                                               (string-concat (i64-str b)
                                                                                              (string-concat ","
                                                                                                             (string-concat alpha ")"))))))))))

(defn hex->rgba [x [:ref :ui/hex-rgba]] :string
  (let [hex (record-get x :hex)
        alpha (record-get x :alpha)
        body (hex-body hex)]
    (if (= (string-byte-length body) 3)
      (rgba-of (record-new [:ref :ui/rgba-of]
                           (nibble-byte (record-new [:ref :ui/nibble-byte] body 0))
                           (nibble-byte (record-new [:ref :ui/nibble-byte] body 1))
                           (nibble-byte (record-new [:ref :ui/nibble-byte] body 2))
                           alpha))
      (rgba-of (record-new [:ref :ui/rgba-of]
                           (hex-byte-at (record-new [:ref :ui/hex-byte-at] body 0))
                           (hex-byte-at (record-new [:ref :ui/hex-byte-at] body 2))
                           (hex-byte-at (record-new [:ref :ui/hex-byte-at] body 4))
                           alpha)))))

;; Default glass accent alphas (mirror liquid-glass.tokens defaults).
(defn accent-tint [hex :string] :string
  (hex->rgba (record-new [:ref :ui/hex-rgba] hex "0.55")))

(defn accent-tint-strong [hex :string] :string
  (hex->rgba (record-new [:ref :ui/hex-rgba] hex "0.85")))

;; --- CSS declaration lines for a themed accent ----------------------------

(defn join-nl [x [:ref :ui/join-nl]] :string
  (let [a (record-get x :a)
        b (record-get x :b)]
    (string-concat a (string-concat "\n" b))))

(defn hig-tint-decl [hex :string] :string
  (string-concat "  --hig-color-tint: "
                 (string-concat hex ";")))

(defn glass-accent-tint-decl [hex :string] :string
  (string-concat "  --liquid-glass-accent-tint: "
                 (string-concat (accent-tint hex) ";")))

(defn glass-accent-strong-decl [hex :string] :string
  (string-concat "  --liquid-glass-accent-tint-strong: "
                 (string-concat (accent-tint-strong hex) ";")))

(defn accent-decls [hex :string] :string
  (join-nl
   (record-new [:ref :ui/join-nl]
               (hig-tint-decl hex)
               (join-nl
                (record-new [:ref :ui/join-nl]
                            (glass-accent-tint-decl hex)
                            (glass-accent-strong-decl hex))))))

;; --- cascade layer --------------------------------------------------------

(defn layer-order-css [] :string
  "@layer kotoba.hig, kotoba.glass;")

(defn layer-wrap [x [:ref :ui/layer-wrap]] :string
  (let [layer (record-get x :layer)
        body (record-get x :body)]
    (string-concat "@layer "
                   (string-concat layer
                                  (string-concat " {\n"
                                                 (string-concat body "\n}"))))))

(defn theme-header [accent-body :string] :string
  (join-nl
   (record-new [:ref :ui/join-nl]
               (layer-order-css)
               (layer-wrap (record-new [:ref :ui/layer-wrap]
                                       "kotoba.hig" accent-body)))))

;; --- shell class + layout constants ---------------------------------------
;; Mirrors kotoba-ui.shell.style public constants / class-name.

(defn shell-class [component :string] :string
  (string-concat "kotoba-shell__" component))

(defn readable-max-width [] :string "680px")
(defn grid-min-width [] :string "260px")
(defn sidebar-width [] :string "260px")
(defn sidebar-breakpoint [] :string "768px")

(defn appearance-value [mode :string] :string
  ;; mode is "auto" | "light" | "dark". auto -> empty (omit attribute).
  (if (string=? mode "light")
    "light"
    (if (string=? mode "dark")
      "dark"
      "")))

(defn main []
  (string-byte-length
   (join-nl
    (record-new [:ref :ui/join-nl]
                (theme-header (accent-decls "#FF3CAC"))
                (shell-class "hero")))))
