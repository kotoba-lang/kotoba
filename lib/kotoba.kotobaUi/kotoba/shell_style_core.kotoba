(ns shell-style-core
  ;; No :export: parity harness appends zero-arg case defns via KIR
  ;; (same convention as kotoba/theme_core.kotoba).
  (:schemas {;; T5.2 native guest record: multi-arg pure -> single record.
             :sh/class-join [:record :sh/class-join
                             [[:base :string] [:extra :string]]]
             :sh/hero-wash [:record :sh/hero-wash
                            [[:token :string] [:percent :string]]]
             :sh/shell-css [:record :sh/shell-css
                            [[:rules :string] [:responsive :string]]]}))

;; A `.kotoba` port of the pure string core of `kotoba-ui.shell.style` and
;; `kotoba-ui.product` — ADR-2607270100 section 10 form A, continuing the
;; kotoba-ui step after kotoba/theme_core.kotoba (which already carries
;; shell-class + the four layout constants).
;;
;; No capabilities (kotoba/pure). What is gated here is the string logic
;; those two namespaces own themselves:
;;
;;   - the `@layer kotoba.hig { rules \n media \n }` wrapper of shell-css
;;   - the three composed declaration VALUES in shell-rules that are built
;;     from a layout constant rather than written out literally
;;     (grid auto-fill track, sidebar column pair, hero accent wash)
;;   - the sidebar-collapse media condition
;;   - the two class-joining helpers (product/classes, shell/cls) that decide
;;     how a consumer :class opt is appended to a component's own class
;;
;; DELIBERATELY host-side, and why (see the parity test ns docstring):
;;   - shell-rules            : 22 [selector decls-map] pairs. A collection
;;                              literal past every typed-map / heterogeneous
;;                              vector bound, and transcription rather than a
;;                              decision.
;;   - responsive-css / shell-css bodies
;;                            : fold a rule collection through css.core/media
;;                              and css.core/css (already ported in
;;                              kotoba-lang/css); only the wrapper is here.
;;   - metric / empty-state / data-table
;;                            : hiccup builders (document plane), and
;;                              data-table folds rows/columns.
;;   - product-css            : a static 12-line CSS constant. Data entry.
;;   - class-opt->str / css-value
;;                            : dispatch on the runtime type of the opt
;;                              (string / keyword / sequential).
;;
;; nil vs "": the .cljc helpers take a nil-able `extra` (and, for cls, a
;; nil-able `base`) and test it with `seq`. :string has no nil, so absent is
;; modelled as "" here — `seq` is nil for both nil and "", so the two agree.

;; --- values composed from a layout constant --------------------------------
;; Each of these is the exact declaration value that appears in shell-rules;
;; the parity test reads it back out of the live rule set, not out of a
;; literal copied into the test.

(defn max-width-condition [breakpoint :string] :string
  ;; responsive-css: (str "(max-width: " sidebar-breakpoint ")")
  ;; Also the shape kotoba-ui.core documents for app-owned media queries, so
  ;; an app switches in lockstep with the shell instead of inventing a second
  ;; breakpoint beside it.
  (string-join "" "(max-width: " breakpoint ")"))

(defn grid-autofill-columns [min-width :string] :string
  ;; .kotoba-shell__grid :grid-template-columns
  (string-join "" "repeat(auto-fill, minmax(" min-width ", 1fr))"))

(defn sidebar-columns [width :string] :string
  ;; .kotoba-shell__app--with-sidebar .kotoba-shell__app-body
  ;; :grid-template-columns
  (string-concat width " minmax(0, 1fr)"))

(defn hero-wash-background [x [:ref :sh/hero-wash]] :string
  ;; .kotoba-shell__hero :background — a color-mix() over a token, never a
  ;; literal gradient color, so it follows the theme accent and both
  ;; appearances. token is the custom property name without var(), e.g.
  ;; "--hig-color-tint"; percent is the mix percentage without "%".
  (let [token (record-get x :token)
        percent (record-get x :percent)]
    (string-join ""
                 "radial-gradient(80% 70% at 50% 0%,color-mix(in srgb, var("
                 token
                 ") "
                 percent
                 "%, transparent) 0%,transparent 70%)")))

;; --- the shell-css layer wrapper -------------------------------------------

(defn shell-layer-css [x [:ref :sh/shell-css]] :string
  ;; shell-css: rules and the media block are rendered host-side by
  ;; css.core; this is the wrapper shell.style writes itself. The layer name
  ;; is hard-coded exactly as in the .cljc — shell rules are structural, so
  ;; they always land in kotoba.hig, never kotoba.glass.
  (let [rules (record-get x :rules)
        responsive (record-get x :responsive)]
    (string-join "" "@layer kotoba.hig {\n" rules "\n" responsive "\n}")))

;; --- class joining ---------------------------------------------------------

(defn product-classes [x [:ref :sh/class-join]] :string
  ;; kotoba-ui.product/classes — base always present, extra optional.
  ;;
  ;; OBSERVED, NOT FIXED HERE: the two surfaces disagree about what a
  ;; consumer :class opt may be. kotoba-ui.shell normalises it first through
  ;; class-opt->str (string / keyword / vector of those), so
  ;; (stack {:class [:a :b]}) yields "kotoba-shell__stack a b". product has no
  ;; such step, so (metric {:class [:a :b]}) stringifies the vector into the
  ;; class attribute: "kotoba-product__metric [:a :b]". Only the string case
  ;; is ported; normalising is a runtime-type dispatch and stays host-side
  ;; either way. Recorded for a later slice — changing it is a behaviour
  ;; change to src/, out of scope here.
  (let [base (record-get x :base)
        extra (record-get x :extra)]
    (if (= (string-length extra) 0)
      base
      (string-join "" base " " extra))))

(defn shell-cls [x [:ref :sh/class-join]] :string
  ;; kotoba-ui.shell/cls — same join, but base is optional too: a component
  ;; whose generated attrs carry no :class yields the consumer opt alone,
  ;; with no leading space.
  (let [base (record-get x :base)
        extra (record-get x :extra)]
    (if (= (string-length extra) 0)
      base
      (if (= (string-length base) 0)
        extra
        (string-join "" base " " extra)))))

(defn main []
  (string-byte-length
   (shell-layer-css
    (record-new [:ref :sh/shell-css]
                (grid-autofill-columns "260px")
                (max-width-condition "768px")))))
