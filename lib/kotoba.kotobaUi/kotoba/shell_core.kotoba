(ns shell-core
  (:export [class-name modifier-name spacing-var
            readable-max-width grid-min-width sidebar-width sidebar-breakpoint]))

;; The class convention and the layout constants of `kotoba-ui.shell.style` —
;; the fifth and last repo of the design-system migration (ADR-2607270100 §10:
;; css → html → shitsuke → liquid-glass-ui → kotoba-ui).
;;
;; Ported by poolside/laguna-s-2.1 through kotoba-code's scripts/orbench and
;; gated by kotoba -M inspect / -M test (jvm-kir, js, wasm) / aarch64 native,
;; plus test/kotoba_ui/kotoba_shell_parity_test.cljk.
;;
;; DELIBERATELY NOT HERE:
;;   * the class-join helper — `shell-cls` in kotoba/shell_style_core.kotoba
;;     already is it. One rule, one home.
;;   * anything from theme_core.kotoba (accent / hex / CSS layers).
;;   * the rule VALUES (grid-template-columns, media conditions): those are in
;;     shell_style_core and take a constant as a parameter. This module is
;;     where that parameter's value lives, so the two compose rather than
;;     restate each other — `shell_style_core/main` currently inlines "260px"
;;     and "768px" as literals and can now call these instead.
;;
;; `grid-min-width` and `sidebar-width` are both "260px" today. They stay two
;; functions because they are two decisions — widening the sidebar must not
;; drag the card grid with it.
;;
;; What stays .cljc: the keyword -> string coercion, the :class opt that may be
;; a vector, the :attrs merge, and all hiccup assembly. Nothing here throws.
;; Word-typed throughout, so this qualifies for :aarch64-kotoba-v1 as written.

(defn class-name [component :string] :string
  (string-concat "kotoba-shell__" component))

(defn modifier-name [base :string modifier :string] :string
  (string-concat (string-concat base "--") modifier))

(defn spacing-var [k :string] :string
  (string-concat (string-concat "var(--hig-spacing-" k) ")"))

(defn readable-max-width [] :string "680px")
(defn grid-min-width [] :string "260px")
(defn sidebar-width [] :string "260px")
(defn sidebar-breakpoint [] :string "768px")
