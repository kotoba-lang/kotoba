(ns run-tests
  "The host-independent slice of kotoba-ui on SCI, run from this dir:
   kbb --backend sci run-tests.cljk (paths come from nbb.edn).

  The shipped KIR decision core is registered from the classpath resource
  (shitsuke's resources dir is on nbb.edn paths), mirroring shitsuke's own
  with-core pattern -- SCI has no classpath resource fallback otherwise.

  The 4 kotoba_*_parity_test namespaces are NOT run here: they need
  kotoba.compiler with lazily-required packaging namespaces (amu-side
  change, JUN-380 F1). They load and pass in scratch with that change;
  wire them in once it lands."
  (:require [cljs.test :as t]
            [kotoba.lang.edn :as edn]
            [shitsuke.kotoba-oracle :as oracle]
            [kotoba-ui.core-test]
            [kotoba-ui.shell-test]
            [kotoba-ui.theme-test]
            [kotoba-ui.backdrop-test]
            [kotoba-ui.design-quality-gate-test]))

(oracle/register-kir!
 :hiccup-core
 (edn/read-string
  (slurp (clojure.java.io/resource "shitsuke/oracle/hiccup-core.kir.edn"))))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println (str "\nnbb: " (:test m) " tests, " (:pass m) " passed, "
                (:fail m) " failed, " (:error m) " errors"))
  (when-not (t/successful? m)
    (set! (.-exitCode js/process) 1)))

(t/run-tests 'kotoba-ui.core-test
             'kotoba-ui.shell-test
             'kotoba-ui.theme-test
             'kotoba-ui.backdrop-test
             'kotoba-ui.design-quality-gate-test)
