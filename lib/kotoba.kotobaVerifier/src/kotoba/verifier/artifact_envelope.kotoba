;; Bounded first native slice of verify-artifact!: outer KExe schema shape,
;; format tag, KIR digest shape, and claimed/runtime effect-set agreement.
;; The optional :oracle marker is validated here. Canonical seal and KIR hash
;; identity are composed below; full runtime semantics remain separate work.
(ns kotoba.verifier.artifact-envelope
  {:kotoba/export [kexe-header-shape? code-bytes-shape? kexe-integrity? kexe-compatibility-match? kexe-module-outline? kexe-function-identities-match? kexe-function-boundaries-valid? kexe-function-effects-valid? kexe-function-record-shapes-valid? kexe-function-bodies-resource-valid? kexe-function-core-operations-valid? kexe-function-effects-match?]}
  (:require [kotoba.artifact.core :as artifact]
            [kotoba.kir.compatibility :as compatibility]
            [kotoba.kir.float-usage :as float-usage]))

(defn- field [value :document key :keyword] :document
  (option-value-of [:option :document] (document-get value key) (document-null)))

(defn- map-keys-within? [value :document allowed :document] :bool
  (and (= (document-kind value) :map)
       (loop [entry-index 0]
         (if (= entry-index (document-count value)) true
           (let [entry (option-value-of [:option :document]
                         (document-map-entry-at value entry-index) (document-vector))
                 key (option-value-of [:option :document]
                       (document-vector-at entry 0) (document-null))]
             (and (loop [index 0]
                    (if (= index (document-count allowed)) false
                      (if (document-equal? key
                            (option-value-of [:option :document]
                              (document-vector-at allowed index) (document-null)))
                        true
                        (recur (+ index 1)))))
                  (recur (+ entry-index 1))))))))

(defn- exact-fields? [value :document fields :document] :bool
  (and (= (document-kind value) :map)
       (= (document-count value) (document-count fields))
       (loop [entry-index 0]
         (if (= entry-index (document-count value)) true
           (let [entry (option-value-of [:option :document]
                         (document-map-entry-at value entry-index) (document-vector))
                 key (option-value-of [:option :document]
                       (document-vector-at entry 0) (document-null))]
             (and (loop [field-index 0]
                    (if (= field-index (document-count fields)) false
                      (if (document-equal? key
                            (option-value-of [:option :document]
                              (document-vector-at fields field-index) (document-null)))
                        true
                        (recur (+ field-index 1)))))
                  (recur (+ entry-index 1))))))))

(defn- map-has-key? [value :document key :document] :bool
  (and (= (document-kind value) :map)
       (loop [entry-index 0]
         (if (= entry-index (document-count value)) false
           (let [entry (option-value-of [:option :document]
                         (document-map-entry-at value entry-index) (document-vector))
                 entry-key (option-value-of [:option :document]
                              (document-vector-at entry 0) (document-null))]
             (or (document-equal? key entry-key)
                 (recur (+ entry-index 1))))))))

(defn- simple-symbol-name? [value :document] :bool
  (if (not (= (document-kind value) :symbol)) false
    (let [printed (document-edn-print value)]
      (and (> (string-length printed) 0)
           (<= (string-length printed) 128)
           (< (string-find-byte printed 47 0) 0)))))

(defn- digest-shape? [value :document] :bool
  (if (not (= (document-kind value) :string)) false
    (let [text (option-value-of [:option :string] (document-string-value value) "")]
      (and (= (string-length text) 64)
           (loop [i 0]
             (if (= i 64) true
               (let [c (string-code-point-at text i)]
                 (and (or (and (>= c 48) (<= c 57))
                          (and (>= c 97) (<= c 102)))
                      (recur (+ i 1))))))))))

(defn- code-byte? [code :document index :i64] :bool
  (let [item (option-value-of [:option :document]
                (document-vector-at code index) (document-null))
        value (document-i64-value item)]
    (and (option-some?-of [:option :i64] value)
         (<= 0 (option-value-of [:option :i64] value 0))
         (<= (option-value-of [:option :i64] value 0) 255))))

(defn code-bytes-shape? [code :document] :bool
  (and (= (document-kind code) :vector)
       (<= 1 (document-count code))
       (<= (document-count code) 1048576)
       (loop [index 0]
         (if (= index (document-count code)) true
           (and (code-byte? code index)
                (recur (+ index 1)))))))

(defn- inconclusive-trap? [trap :document] :bool
  (or (document-equal? trap (document-keyword :budget/fuel))
      (document-equal? trap (document-keyword :budget/cells))
      (document-equal? trap (document-keyword :budget/bytes))
      (document-equal? trap (document-keyword :budget/frames))
      (document-equal? trap (document-keyword :budget/gas))
      (document-equal? trap (document-keyword :host/stack-exhausted))))

(defn- valid-oracle-marker? [kexe :document] :bool
  (let [oracle (field kexe :oracle)
        limits (field kexe :limits)
        fields (document-vector (document-keyword :status)
                                (document-keyword :trap)
                                (document-keyword :fuel))]
    (if (not (exact-fields? oracle fields)) false
      (if (not (= (document-kind limits) :map)) false
        (and (document-equal? (field oracle :status) (document-keyword :inconclusive))
             (inconclusive-trap? (field oracle :trap))
             (document-equal? (field oracle :fuel) (field limits :fuel))
             (= (document-kind (field kexe :value)) :null))))))

(defn- capability-call-effect? [effect :document] :bool
  (if (not (= (document-kind effect) :vector)) false
    (if (not (= (document-count effect) 2)) false
      (let [tag (option-value-of [:option :document]
                   (document-vector-at effect 0) (document-null))
            raw-id (option-value-of [:option :document]
                      (document-vector-at effect 1) (document-null))
            id (document-i64-value raw-id)]
        (and (document-equal? tag (document-keyword :cap/call))
             (option-some?-of [:option :i64] id)
             (<= 0 (option-value-of [:option :i64] id 0))
             (<= (option-value-of [:option :i64] id 0) 255))))))

(defn- valid-effect? [effect :document] :bool
  (or (document-equal? effect (document-keyword :state))
      (document-equal? effect (document-keyword :abort))
      (capability-call-effect? effect)))

(defn- effects-shape? [effects :document] :bool
  (and (= (document-kind effects) :set)
       (loop [index 0]
         (if (= index (document-count effects)) true
           (let [effect (option-value-of [:option :document]
                          (document-set-at effects index) (document-null))]
             (and (valid-effect? effect)
                  (recur (+ index 1))))))))

(defn kexe-header-shape? [kexe :document] :bool
  (let [fields (document-vector
                 (document-keyword :format) (document-keyword :target)
                 (document-keyword :target-profile) (document-keyword :value)
                 (document-keyword :kir-sha256) (document-keyword :lowering)
                 (document-keyword :fuel-abi) (document-keyword :context-abi)
                 (document-keyword :effects) (document-keyword :limits)
                 (document-keyword :code) (document-keyword :program)
                 (document-keyword :exports) (document-keyword :compatibility)
                 (document-keyword :sha256))
        inconclusive-fields (document-vector-conj fields (document-keyword :oracle))]
    (if (not (or (exact-fields? kexe fields)
                 (exact-fields? kexe inconclusive-fields))) false
      (let [program (field kexe :program)]
        (and (document-equal? (field kexe :format) (document-keyword :kotoba.kexe/v1))
             (digest-shape? (field kexe :kir-sha256))
             (code-bytes-shape? (field kexe :code))
             (= (document-kind program) :map)
             (effects-shape? (field kexe :effects))
             (document-equal? (field kexe :effects) (field program :effects))
             (or (= (document-count kexe) 15)
                 (valid-oracle-marker? kexe)))))))

;; This closes the first artifact identity boundary in native Kotoba: schema,
;; effect/code shape, canonical artifact seal, and the claimed KIR digest all
;; have to agree before runtime verification is attempted. `artifact/core`
;; supplies the canonical Kotoba seal and SHA-256 implementation; callers must
;; still perform the full runtime/ABI/compatibility verification separately.
(defn kexe-integrity? [kexe :document] :bool
  (and (kexe-header-shape? kexe)
       (artifact/valid-seal? kexe)
       (document-equal? (field kexe :kir-sha256)
                        (document-string (artifact/sha256 (field kexe :program))))))

(defn- compatibility-field [expected [:map :keyword :document] key :keyword] :document
  (option-value-of [:option :document]
    (typed-map-get [:map :keyword :document] expected key)
    (document-null)))

;; Re-derive the descriptor's structural, target and value-ABI fields from the
;; KExe. A budget-exhausted float scan refuses metadata validation instead of
;; trusting the artifact's claimed ABI.
(defn kexe-compatibility-match? [kexe :document] :bool
  (let [program (field kexe :program)
        kir-format (field program :format)
        typed-values? (document-equal? kir-format (document-keyword :kotoba.kir/v4))
        float-mask (float-usage/float-use-mask program)
        value-abi (if (< float-mask 0)
                    (document-null)
                    (if (or (= float-mask 1) (= float-mask 3))
                      (document-keyword :kotoba.typed/mixed-f32-f64-v3)
                      (if (= float-mask 2)
                        (document-keyword :kotoba.typed/mixed-f64-v2)
                        (if typed-values?
                          (document-keyword :kotoba.typed/externref-v1)
                          (document-keyword :kotoba.i64/direct-v1)))))
        profile (field kexe :target-profile)
        hir-format (if typed-values?
                     (document-keyword :kotoba.hir/v3)
                     (document-keyword :kotoba.hir/v2))
        expected (compatibility/descriptor
                   (document-map
                     :hir-format hir-format
                     :kir-format kir-format
                     :target (field kexe :target)
                     :target-profile profile
                     :value-abi value-abi))
        actual (field kexe :compatibility)
        fields (document-vector
                 (document-keyword :format) (document-keyword :compiler)
                 (document-keyword :language) (document-keyword :hir)
                 (document-keyword :kir) (document-keyword :target)
                 (document-keyword :runtime) (document-keyword :value-abi)
                 (document-keyword :tender-role) (document-keyword :tender-contract))]
    (and (>= float-mask 0)
         (exact-fields? actual fields)
         (document-equal? (field actual :format) (compatibility-field expected :format))
         (document-equal? (field actual :compiler) (compatibility-field expected :compiler))
         (document-equal? (field actual :language) (compatibility-field expected :language))
         (document-equal? (field actual :hir) (compatibility-field expected :hir))
         (document-equal? (field actual :kir) (compatibility-field expected :kir))
         (document-equal? (field actual :target) (compatibility-field expected :target))
         (document-equal? (field actual :runtime) (compatibility-field expected :runtime))
         (document-equal? (field actual :value-abi) (compatibility-field expected :value-abi))
         (document-equal? (field actual :tender-role) (compatibility-field expected :tender-role))
         (document-equal? (field actual :tender-contract) (compatibility-field expected :tender-contract)))))

;; First Kotoba-native port of verify-runtime!'s KIR module-outline boundary.
;; This does not validate function bodies, per-function ABI details, the full
;; entry-result type allowlist, schema/gas-schedule contents, backend
;; re-emission, or the entry's sealed result value.
(defn kexe-module-outline? [program :document] :bool
  (if (not (= (document-kind program) :map)) false
    (let [allowed (document-vector
                  (document-keyword :format) (document-keyword :entry)
                  (document-keyword :exports) (document-keyword :signature)
                  (document-keyword :effects) (document-keyword :functions)
                  (document-keyword :schemas) (document-keyword :gas-schedule))
        entry (field program :entry)
        exports (field program :exports)
        signature (field program :signature)
        functions (field program :functions)
        effects (field program :effects)
        has-entry? (not= (document-kind entry) :null)
        valid-entry? (and (document-equal? entry (document-symbol (symbol "main")))
                          (= (document-kind signature) :map)
                          (= (document-count signature) 2)
                          (= (document-kind (field signature :params)) :vector)
                          (= (document-count (field signature :params)) 0)
                          (or (= (document-kind (field signature :result)) :keyword)
                              (= (document-kind (field signature :result)) :vector)))
        valid-library? (and (not has-entry?)
                            (= (document-kind signature) :null)
                            (= (document-kind exports) :vector)
                            (> (document-count exports) 0))
        exports-shape? (and (= (document-kind exports) :vector)
                            (loop [index 0]
                              (if (= index (document-count exports)) true
                                (and (= (document-kind
                                          (option-value-of [:option :document]
                                            (document-vector-at exports index) (document-null)))
                                        :symbol)
                                     (recur (+ index 1))))))]
      (and (map-keys-within? program allowed)
         (or (document-equal? (field program :format) (document-keyword :kotoba.kir/v3))
             (document-equal? (field program :format) (document-keyword :kotoba.kir/v4)))
         exports-shape?
         (or valid-entry? valid-library?)
         (and (= (document-kind functions) :vector)
              (<= 1 (document-count functions))
              (<= (document-count functions) 1024))
         (effects-shape? effects)
         (or (= (document-kind (field program :schemas)) :null)
             (= (document-kind (field program :schemas)) :map))
         (or (= (document-kind (field program :gas-schedule)) :null)
             (= (document-kind (field program :gas-schedule)) :map))))))

(defn- function-identity-shape? [function :document] :bool
  (and (= (document-kind function) :map)
       (= (document-kind (field function :name)) :symbol)
       (= (document-kind (field function :params)) :vector)))

(defn- function-name-present? [functions :document name :document] :bool
  (loop [index 0]
    (if (= index (document-count functions)) false
      (let [function (option-value-of [:option :document]
                       (document-vector-at functions index) (document-null))]
        (or (document-equal? (field function :name) name)
            (recur (+ index 1)))))))

(defn- function-name-collision-from? [functions :document left-index :i64] :bool
  (let [left (option-value-of [:option :document]
               (document-vector-at functions left-index) (document-null))
        left-name (field left :name)]
    (loop [right-index (+ left-index 1)]
      (if (= right-index (document-count functions)) false
        (let [right (option-value-of [:option :document]
                      (document-vector-at functions right-index) (document-null))]
          (or (document-equal? left-name (field right :name))
              (recur (+ right-index 1))))))))

(defn- unique-function-names? [functions :document] :bool
  (loop [left-index 0]
    (if (= left-index (document-count functions)) true
      (and (not (function-name-collision-from? functions left-index))
           (recur (+ left-index 1))))))

(defn- export-collision-from? [exports :document left-index :i64] :bool
  (let [left (option-value-of [:option :document]
               (document-vector-at exports left-index) (document-null))]
    (loop [right-index (+ left-index 1)]
      (if (= right-index (document-count exports)) false
        (let [right (option-value-of [:option :document]
                      (document-vector-at exports right-index) (document-null))]
          (or (document-equal? left right)
              (recur (+ right-index 1))))))))

(defn- unique-exports? [exports :document] :bool
  (loop [left-index 0]
    (if (= left-index (document-count exports)) true
      (and (not (export-collision-from? exports left-index))
           (recur (+ left-index 1))))))

(defn- all-exports-defined? [exports :document functions :document] :bool
  (loop [index 0]
    (if (= index (document-count exports)) true
      (let [name (option-value-of [:option :document]
                   (document-vector-at exports index) (document-null))]
        (and (function-name-present? functions name)
             (recur (+ index 1)))))))

;; Port of verify-program!'s function/export identity gate. It deliberately
;; stops before per-function ABI, body, effect inference and call-graph checks.
(defn kexe-function-identities-match? [program :document] :bool
  (if (not (kexe-module-outline? program)) false
    (let [functions (field program :functions)
          exports (field program :exports)
          entry (field program :entry)
          main-name (document-symbol (symbol "main"))
          functions-shaped?
          (loop [index 0]
            (if (= index (document-count functions)) true
              (and (function-identity-shape?
                     (option-value-of [:option :document]
                       (document-vector-at functions index) (document-null)))
                   (recur (+ index 1)))))]
      (and functions-shaped?
           (unique-function-names? functions)
           (unique-exports? exports)
           (all-exports-defined? exports functions)
           (or (= (document-kind entry) :null)
               (and (document-equal? entry main-name)
                    (function-name-present? functions main-name)
                    (loop [index 0]
                      (if (= index (document-count functions)) false
                        (let [function (option-value-of [:option :document]
                                         (document-vector-at functions index) (document-null))]
                          (if (document-equal? (field function :name) main-name)
                            (and (= (document-count (field function :params)) 0)
                                 (loop [export-index 0]
                                   (if (= export-index (document-count exports)) false
                                     (if (document-equal? (option-value-of [:option :document]
                                                         (document-vector-at exports export-index)
                                                         (document-null)) main-name)
                                       true
                                       (recur (+ export-index 1))))))
                            (recur (+ index 1))))))))))))

(defn- vector-item [value :document index :i64] :document
  (option-value-of [:option :document] (document-vector-at value index) (document-null)))

(defn- list-item [value :document index :i64] :document
  (option-value-of [:option :document] (document-list-at value index) (document-null)))

(defn- function-index [functions :document name :document] :i64
  (loop [index 0]
    (if (= index (document-count functions)) -1
      (if (document-equal? (field (vector-item functions index) :name) name)
        index
        (recur (+ index 1))))))

(defn- name-in-vector? [names :document name :document] :bool
  (loop [index 0]
    (if (= index (document-count names)) false
      (or (document-equal? (vector-item names index) name)
          (recur (+ index 1))))))

(defn- capability-effects-subset? [callee-effects :document caller-effects :document] :bool
  (loop [index 0]
    (if (= index (document-count callee-effects)) true
      (let [effect (option-value-of [:option :document]
                     (document-set-at callee-effects index) (document-null))]
        (and (or (document-equal? effect (document-keyword :state))
                 (document-equal? effect (document-keyword :abort))
                 (document-set-contains? caller-effects effect))
             (recur (+ index 1)))))))

(defn- type-tag? [type :document tag :keyword] :bool
  (and (= (document-kind type) :vector)
       (> (document-count type) 0)
       (document-equal? (vector-item type 0) (document-keyword tag))))

(defn- qualified-keyword? [value :document] :bool
  (if (not (= (document-kind value) :keyword)) false
    (let [printed (document-edn-print value)]
      (>= (string-find-byte printed 47 0) 0))))

(defn- pair-key-collision-from? [pairs :document left-index :i64] :bool
  (let [left-key (vector-item (vector-item pairs left-index) 0)]
    (loop [right-index (+ left-index 1)]
      (if (= right-index (document-count pairs)) false
        (or (document-equal? left-key (vector-item (vector-item pairs right-index) 0))
            (recur (+ right-index 1)))))))

(defn- unique-pair-keys? [pairs :document] :bool
  (loop [left-index 0]
    (if (= left-index (document-count pairs)) true
      (and (not (pair-key-collision-from? pairs left-index))
           (recur (+ left-index 1))))))

;; Single-recursive-descriptor port of the independent native ABI type tables
;; in verify-program!. `mode` keeps the record/word/handle recurrences explicit
;; without importing the compiler's admission predicate into the verifier.
;; Function identity, closure-index, pair-chain, result-refinement and effect
;; checks remain separate verifier slices.
(defn- native-kir-type? [type :document mode :keyword depth :i64] :bool
  (if (= mode :qualified-ref)
    (and (type-tag? type :ref)
         (= (document-count type) 2)
         (qualified-keyword? (vector-item type 1)))
    (if (= mode :word-value)
      (or (document-equal? type (document-keyword :i64))
          (document-equal? type (document-keyword :bool))
          (document-equal? type (document-keyword :string))
          (document-equal? type (document-keyword :keyword))
          (document-equal? type (document-keyword :document))
          (document-equal? type (document-keyword :option-i64))
          (document-equal? type (document-keyword :result-i64))
          (and (<= depth 8)
               (type-tag? type :option)
               (= (document-count type) 2)
               (or (native-kir-type? (vector-item type 1) :word-value (+ depth 1))
                   (native-kir-type? (vector-item type 1) :scalar-record 0)))
          (and (<= depth 8)
               (type-tag? type :set)
               (= (document-count type) 2)
               (or (native-kir-type? (vector-item type 1) :word-value (+ depth 1))
                   (native-kir-type? (vector-item type 1) :scalar-record 0)))
          (and (<= depth 8)
               (type-tag? type :result)
               (= (document-count type) 3)
               (native-kir-type? (vector-item type 1) :word-value (+ depth 1))
               (native-kir-type? (vector-item type 2) :word-value (+ depth 1))))
      (if (= mode :scalar-record)
        (and (< depth 32)
             (type-tag? type :record)
             (= (document-count type) 3)
             (qualified-keyword? (vector-item type 1))
             (= (document-kind (vector-item type 2)) :vector)
             (<= (document-count (vector-item type 2)) 32)
             (unique-pair-keys? (vector-item type 2))
             (loop [index 0]
               (let [fields (vector-item type 2)]
                 (if (= index (document-count fields)) true
                   (let [pair (vector-item fields index)
                         item-type (vector-item pair 1)]
                     (and (= (document-kind pair) :vector)
                          (= (document-count pair) 2)
                          (= (document-kind (vector-item pair 0)) :keyword)
                          (or (document-equal? item-type (document-keyword :i64))
                              (document-equal? item-type (document-keyword :bool))
                              (document-equal? item-type (document-keyword :string))
                              (document-equal? item-type (document-keyword :keyword))
                              (document-equal? item-type (document-keyword :document))
                              (native-kir-type? item-type :word-value (+ depth 1))
                              (native-kir-type? item-type :qualified-ref 0)
                              (document-equal? item-type (document-keyword :vector-i64))
                              (and (type-tag? item-type :list)
                                   (= (document-count item-type) 2)
                                   (native-kir-type? item-type :handle 0))
                              (native-kir-type? item-type :scalar-record (+ depth 1)))
                          (recur (+ index 1))))))))
        (if (= mode :variant-boundary)
          (and (type-tag? type :variant)
               (= (document-count type) 3)
               (qualified-keyword? (vector-item type 1))
               (= (document-kind (vector-item type 2)) :vector)
               (<= 1 (document-count (vector-item type 2)))
               (<= (document-count (vector-item type 2)) 32)
               (unique-pair-keys? (vector-item type 2))
               (loop [index 0]
                 (let [cases (vector-item type 2)]
                   (if (= index (document-count cases)) true
                     (let [pair (vector-item cases index)
                           payload (vector-item pair 1)]
                       (and (= (document-kind pair) :vector)
                            (= (document-count pair) 2)
                            (= (document-kind (vector-item pair 0)) :keyword)
                            (or (document-equal? payload (document-keyword :i64))
                                (document-equal? payload (document-keyword :bool))
                                (native-kir-type? payload :scalar-record 0))
                            (recur (+ index 1))))))))
          (if (= mode :boundary)
            (or (document-equal? type (document-keyword :i64))
                (document-equal? type (document-keyword :bool))
                (document-equal? type (document-keyword :string))
                (document-equal? type (document-keyword :keyword))
                (document-equal? type (document-keyword :document))
                (document-equal? type (document-keyword :f64))
                (native-kir-type? type :word-value 0)
                (and (native-kir-type? type :scalar-record 0)
                     (not (native-kir-type? type :private-handle 0)))
                (native-kir-type? type :variant-boundary 0)
                (native-kir-type? type :qualified-ref 0))
            (if (= mode :private-handle)
              (if (document-equal? type (document-keyword :vector-i64)) true
                (if (and (type-tag? type :record) (= (document-count type) 3)
                         (= (document-kind (vector-item type 2)) :vector))
                  (loop [index 0]
                    (let [fields (vector-item type 2)]
                      (if (= index (document-count fields)) false
                        (let [pair (vector-item fields index)]
                          (or (document-equal? (vector-item pair 1) (document-keyword :vector-i64))
                              (native-kir-type? (vector-item pair 1) :private-handle 0)
                              (recur (+ index 1)))))))
                  false))
              (if (= mode :handle-member)
                (and (= (document-kind type) :vector)
                     (= (document-count type) 2)
                     (= (document-kind (vector-item type 0)) :keyword)
                     (native-kir-type? (vector-item type 1) :handle (+ depth 1)))
                (if (= mode :handle)
                  (or (native-kir-type? type :word-value 0)
                      (native-kir-type? type :scalar-record 0)
                      (document-equal? type (document-keyword :vector-i64))
                      (native-kir-type? type :qualified-ref 0)
                      (and (<= depth 32)
                           (or (type-tag? type :record) (type-tag? type :variant))
                           (= (document-count type) 3)
                           (qualified-keyword? (vector-item type 1))
                           (= (document-kind (vector-item type 2)) :vector)
                           (<= 1 (document-count (vector-item type 2)))
                           (<= (document-count (vector-item type 2)) 32)
                           (unique-pair-keys? (vector-item type 2))
                           (loop [index 0]
                             (let [members (vector-item type 2)]
                               (if (= index (document-count members)) true
                                 (and (native-kir-type? (vector-item members index) :handle-member depth)
                                      (recur (+ index 1)))))))
                      (and (<= depth 32)
                           (type-tag? type :vector)
                           (= (document-count type) 2)
                           (= (document-kind (vector-item type 1)) :vector)
                           (<= 1 (document-count (vector-item type 1)))
                           (<= (document-count (vector-item type 1)) 32)
                           (loop [index 0]
                             (let [members (vector-item type 1)]
                               (if (= index (document-count members)) true
                                 (and (native-kir-type? (vector-item members index) :handle (+ depth 1))
                                      (recur (+ index 1)))))))
                      (and (<= depth 32)
                           (type-tag? type :option)
                           (= (document-count type) 2)
                           (or (document-equal? (vector-item type 1) (document-keyword :bytes))
                               (native-kir-type? (vector-item type 1) :handle (+ depth 1))))
                      (and (<= depth 32)
                           (type-tag? type :list)
                           (= (document-count type) 2)
                           (native-kir-type? (vector-item type 1) :handle (+ depth 1)))
                      (and (<= depth 32)
                           (type-tag? type :map)
                           (= (document-count type) 3)
                           (or (document-equal? (vector-item type 1) (document-keyword :i64))
                               (document-equal? (vector-item type 1) (document-keyword :bool))
                               (document-equal? (vector-item type 1) (document-keyword :string))
                               (document-equal? (vector-item type 1) (document-keyword :keyword)))
                           (native-kir-type? (vector-item type 2) :handle (+ depth 1)))
                      (and (<= depth 32)
                           (type-tag? type :result)
                           (= (document-count type) 3)
                           (native-kir-type? (vector-item type 1) :handle (+ depth 1))
                           (native-kir-type? (vector-item type 2) :handle (+ depth 1))))
                  false)))))))))

(defn- native-function-type? [type :document exported? :bool] :bool
  (or (native-kir-type? type :boundary 0)
      (document-equal? type (document-keyword :vector-i64))
      (document-equal? type (document-keyword :bytes))
      (and (not exported?)
           (or (document-equal? type (document-keyword :vector-f64))
               (document-equal? type (document-keyword :string-index))
               (native-kir-type? type :handle 0)))))

(defn kexe-function-effects-valid? [program :document] :bool
  (if (not (kexe-module-outline? program)) false
    (let [functions (field program :functions)]
      (loop [index 0]
        (if (= index (document-count functions)) true
          (let [function (vector-item functions index)]
            (and (effects-shape? (field function :effects))
                 (recur (+ index 1)))))))))

(defn- closure-index-list-valid? [indexes :document params :document param-types :document]
  :bool
  (and (= (document-kind indexes) :vector)
       (loop [index 0]
         (if (= index (document-count indexes)) true
           (let [raw (vector-item indexes index)
                 decoded (document-i64-value raw)]
             (and (option-some?-of [:option :i64] decoded)
                  (let [value (option-value-of [:option :i64] decoded -1)]
                    (and (<= 0 value)
                         (< value (document-count params))
                         (or (= (document-kind param-types) :null)
                             (document-equal? (vector-item param-types value)
                                              (document-keyword :i64)))
                         (or (= index 0)
                             (< (option-value-of [:option :i64]
                                  (document-i64-value (vector-item indexes (- index 1))) -1)
                                value))
                         (recur (+ index 1))))))))))

(defn- index-present? [indexes :document value :i64] :bool
  (loop [index 0]
    (if (= index (document-count indexes)) false
      (or (document-equal? (vector-item indexes index) (document-i64 value))
          (recur (+ index 1))))))

(defn- pair-chain-index-list-valid? [indexes :document params :document
                                     param-types :document closure-indexes :document] :bool
  (and (closure-index-list-valid? indexes params param-types)
       (loop [index 0]
         (if (= index (document-count indexes)) true
           (and (not (index-present? closure-indexes
                        (option-value-of [:option :i64]
                          (document-i64-value (vector-item indexes index)) -1)))
                (recur (+ index 1)))))))

(defn- function-record-shape-valid? [function :document] :bool
  (let [allowed (document-vector
                  (document-keyword :name) (document-keyword :params)
                  (document-keyword :result) (document-keyword :effects)
                  (document-keyword :body) (document-keyword :param-types)
                  (document-keyword :closure-param-indexes)
                  (document-keyword :i64-pair-chain-param-indexes)
                  (document-keyword :closure-result?))
        required (document-vector
                   (document-keyword :name) (document-keyword :params)
                   (document-keyword :result) (document-keyword :effects)
                   (document-keyword :body))
        params (field function :params)
        param-types (field function :param-types)
        closure-indexes (if (map-has-key? function (document-keyword :closure-param-indexes))
                          (field function :closure-param-indexes) (document-vector))
        pair-chain-indexes (field function :i64-pair-chain-param-indexes)]
    (and (= (document-kind function) :map)
         (map-keys-within? function allowed)
         (loop [index 0]
           (if (= index (document-count required)) true
             (and (map-has-key? function (vector-item required index))
                  (recur (+ index 1)))))
         (function-identity-shape? function)
         (simple-symbol-name? (field function :name))
         (<= (document-count params) 64)
         (loop [index 0]
           (if (= index (document-count params)) true
             (let [name (vector-item params index)]
               (and (simple-symbol-name? name)
                    (not (loop [prior 0]
                           (if (= prior index) false
                             (or (document-equal? name (vector-item params prior))
                                 (recur (+ prior 1))))))
                    (recur (+ index 1))))))
         (effects-shape? (field function :effects))
         (or (not (map-has-key? function (document-keyword :param-types)))
             (and (= (document-kind param-types) :vector)
                  (= (document-count param-types) (document-count params))))
         (or (not (map-has-key? function (document-keyword :closure-param-indexes)))
             (closure-index-list-valid? closure-indexes params param-types))
         (or (not (map-has-key? function (document-keyword :i64-pair-chain-param-indexes)))
             (pair-chain-index-list-valid? pair-chain-indexes params param-types closure-indexes))
         (or (not (map-has-key? function (document-keyword :closure-result?)))
             (and (document-equal? (field function :closure-result?) (document-bool true))
                  (document-equal? (field function :result) (document-keyword :i64)))))))

(defn kexe-function-record-shapes-valid? [program :document] :bool
  (if (not (kexe-module-outline? program)) false
    (let [functions (field program :functions)]
      (loop [index 0]
        (if (= index (document-count functions)) true
          (and (function-record-shape-valid? (vector-item functions index))
               (recur (+ index 1))))))))

(defn- typed-field [name :keyword type :document] :document
  (document-vector (document-keyword name) type))

(defn- typed-record [name :keyword fields :document] :document
  (document-vector (document-keyword :record) (document-keyword name) fields))

(defn- typed-variant [name :keyword fields :document] :document
  (document-vector (document-keyword :variant) (document-keyword name) fields))

(defn- clock-request-type [] :document
  (typed-variant :kotoba.clock/request
    (document-vector (typed-field :wall (document-keyword :bool))
                     (typed-field :monotonic (document-keyword :bool)))))

(defn- clock-result-type [] :document
  (typed-variant :kotoba.clock/result
    (document-vector
      (typed-field :wall
        (typed-record :kotoba.clock/wall
          (document-vector (typed-field :unix-millis (document-keyword :i64))
                           (typed-field :observation-sequence (document-keyword :i64)))))
      (typed-field :monotonic
        (typed-record :kotoba.clock/monotonic
          (document-vector (typed-field :nanos (document-keyword :i64))
                           (typed-field :observation-sequence (document-keyword :i64)))))
      (typed-field :error
        (typed-record :kotoba.clock/error
          (document-vector (typed-field :code (document-keyword :keyword))
                           (typed-field :message (document-keyword :string))))))))

(defn- dataspace-request-type [] :document
  (typed-variant :kotoba.dataspace/request
    (document-vector
      (typed-field :assert
        (typed-record :kotoba.dataspace/assert
          (document-vector (typed-field :assertion (document-keyword :document))
                           (typed-field :facet (document-keyword :i64)))))
      (typed-field :retract
        (typed-record :kotoba.dataspace/retract
          (document-vector (typed-field :assertion (document-keyword :document))
                           (typed-field :facet (document-keyword :i64)))))
      (typed-field :observe
        (typed-record :kotoba.dataspace/observe
          (document-vector (typed-field :pattern (document-keyword :document))
                           (typed-field :facet (document-keyword :i64)))))
      (typed-field :facet-enter (document-keyword :bool))
      (typed-field :facet-leave (document-keyword :i64)))))

(defn- dataspace-result-type [] :document
  (typed-variant :kotoba.dataspace/result
    (document-vector
      (typed-field :asserted
        (typed-record :kotoba.dataspace/asserted
          (document-vector (typed-field :count (document-keyword :i64))
                           (typed-field :notices (document-keyword :document)))))
      (typed-field :retracted
        (typed-record :kotoba.dataspace/retracted
          (document-vector (typed-field :count (document-keyword :i64)))))
      (typed-field :matches
        (typed-record :kotoba.dataspace/matches
          (document-vector (typed-field :bindings (document-keyword :document))
                           (typed-field :notices (document-keyword :document)))))
      (typed-field :facet
        (typed-record :kotoba.dataspace/facet
          (document-vector (typed-field :id (document-keyword :i64)))))
      (typed-field :error
        (typed-record :kotoba.dataspace/error
          (document-vector (typed-field :code (document-keyword :keyword))
                           (typed-field :message (document-keyword :string))))))))

(defn- ui-commit-request-type [] :document
  (typed-record :kotoba.ui/commit-request
    (document-vector
      (typed-field :base-revision (document-keyword :i64))
      (typed-field :nodes
        (document-vector (document-keyword :set)
          (typed-record :kotoba.ui/node
            (document-vector
              (typed-field :id (document-keyword :keyword))
              (typed-field :parent (document-vector (document-keyword :option) (document-keyword :keyword)))
              (typed-field :kind (document-keyword :keyword))
              (typed-field :text (document-keyword :string)))))))))

(defn- ui-commit-result-type [] :document
  (typed-record :kotoba.ui/commit-result
    (document-vector (typed-field :revision (document-keyword :i64))
                     (typed-field :node-count (document-keyword :i64)))))

(defn- ui-event-request-type [] :document
  (typed-record :kotoba.ui/event-request
    (document-vector (typed-field :after-revision (document-keyword :i64)))))

(defn- ui-event-result-type [] :document
  (document-vector (document-keyword :option)
    (typed-record :kotoba.ui/event
      (document-vector (typed-field :revision (document-keyword :i64))
                       (typed-field :target (document-keyword :keyword))
                       (typed-field :kind (document-keyword :keyword))
                       (typed-field :value (document-keyword :string))))))

(defn- native-provider-contract? [cap-id :i64 request-type :document result-type :document] :bool
  (or (and (= cap-id 7)
           (document-equal? request-type (clock-request-type))
           (document-equal? result-type (clock-result-type)))
      (and (= cap-id 24)
           (document-equal? request-type (dataspace-request-type))
           (document-equal? result-type (dataspace-result-type)))
      (and (= cap-id 9)
           (document-equal? request-type (ui-commit-request-type))
           (document-equal? result-type (ui-commit-result-type)))
      (and (= cap-id 10)
           (document-equal? request-type (ui-event-request-type))
           (document-equal? result-type (ui-event-result-type)))))

(defn- typed-capability-pair-valid? [cap-id :i64 request-type :document result-type :document] :bool
  (or
    (and (document-equal? request-type (document-keyword :i64))
         (document-equal? result-type (document-keyword :i64)))
    (and (document-equal? request-type (document-keyword :string))
         (document-equal? result-type (document-keyword :string)))
    (and (document-equal? request-type (document-keyword :option-i64))
         (document-equal? result-type (document-keyword :option-i64)))
    (and (document-equal? request-type (document-keyword :result-i64))
         (document-equal? result-type (document-keyword :result-i64)))
    (native-provider-contract? cap-id request-type result-type)))

(defn- cap-effect-of-call [form :document arity :i64] :document
  (if (or (not (= (document-kind form) :list))
          (not (= (document-count form) arity))) (document-null)
    (let [decoded (document-i64-value (list-item form 1))]
      (if (not (option-some?-of [:option :i64] decoded)) (document-null)
        (let [id (option-value-of [:option :i64] decoded -1)]
          (if (<= 0 id 255)
            (document-vector (document-keyword :cap/call) (document-i64 id))
            (document-null)))))))

(defn- capability-call-valid? [form :document] :bool
  (if (not (= (document-kind form) :list)) false
    (let [operator (list-item form 0)
          cap-call (document-symbol (symbol "cap-call"))
          typed-cap-call (document-symbol (symbol "typed-cap-call"))]
      (if (document-equal? operator cap-call)
        (and (= (document-count form) 3)
             (not (= (document-kind (cap-effect-of-call form 3)) :null)))
        (if (document-equal? operator typed-cap-call)
          (let [effect (cap-effect-of-call form 5)
                request-type (list-item form 2)
                result-type (list-item form 3)
                id-value (document-i64-value (list-item form 1))]
            (and (= (document-count form) 5)
                 (not (= (document-kind effect) :null))
                 (option-some?-of [:option :i64] id-value)
                 (typed-capability-pair-valid?
                   (option-value-of [:option :i64] id-value -1)
                   request-type result-type)))
          true)))))

(defn- body-capability-calls-valid? [form :document depth :i64] :bool
  (if (> depth 256) false
    (let [kind (document-kind form)]
      (if (= kind :list)
        (if (not (capability-call-valid? form)) false
          (loop [index 1]
            (if (= index (document-count form)) true
              (if (body-capability-calls-valid? (list-item form index) (+ depth 1))
                (recur (+ index 1)) false))))
        (if (or (= kind :vector) (= kind :set) (= kind :map))
          (loop [index 0]
            (if (= index (document-count form)) true
              (let [item (if (= kind :vector) (vector-item form index)
                           (if (= kind :set)
                             (option-value-of [:option :document] (document-set-at form index) (document-null))
                             (option-value-of [:option :document] (document-map-entry-at form index) (document-vector))))]
                (if (body-capability-calls-valid? item (+ depth 1))
                  (recur (+ index 1)) false))))
          true)))))

(defn- body-container-effect-witness? [form :document functions :document
                                      effect :document visited :document depth :i64
                                      start :i64] :bool
  (let [kind (document-kind form)]
    (loop [index start]
      (if (= index (document-count form)) false
        (let [item (if (= kind :list) (list-item form index)
                     (if (= kind :vector) (vector-item form index)
                       (if (= kind :set)
                         (option-value-of [:option :document] (document-set-at form index) (document-null))
                         (option-value-of [:option :document] (document-map-entry-at form index) (document-vector))))) ]
          (or (body-effect-witness? item functions effect visited (+ depth 1))
              (recur (+ index 1))))))))

(defn- body-list-effect-witness? [form :document functions :document effect :document
                                 visited :document depth :i64] :bool
  (if (= (document-count form) 0) false
    (let [operator (list-item form 0)
          cap-call (document-symbol (symbol "cap-call"))
          typed-cap-call (document-symbol (symbol "typed-cap-call"))]
      (if (document-equal? operator cap-call)
        (let [found (cap-effect-of-call form 3)]
          (or (and (not (= (document-kind found) :null))
                   (document-equal? found effect))
              (and (= (document-count form) 3)
                   (body-effect-witness? (list-item form 2) functions effect visited (+ depth 1)))))
        (if (document-equal? operator typed-cap-call)
          (let [found (cap-effect-of-call form 5)]
            (or (and (not (= (document-kind found) :null))
                     (document-equal? found effect))
                (and (= (document-count form) 5)
                     (body-effect-witness? (list-item form 4) functions effect visited (+ depth 1)))))
          (let [callee-index (function-index functions operator)]
            (if (< callee-index 0)
              (body-container-effect-witness? form functions effect visited depth 1)
              (let [callee (vector-item functions callee-index)
                    callee-name (field callee :name)
                    callee-visited (document-vector-conj visited callee-name)]
                (or (and (not (name-in-vector? visited callee-name))
                         (body-effect-witness? (field callee :body) functions effect callee-visited (+ depth 1)))
                    (body-container-effect-witness? form functions effect visited depth 1))))))))))

(defn- body-effect-witness? [form :document functions :document effect :document
                             visited :document depth :i64] :bool
  (if (> depth 256) false
    (let [kind (document-kind form)]
      (if (= kind :list)
        (body-list-effect-witness? form functions effect visited depth)
        (if (or (= kind :vector) (= kind :set) (= kind :map))
          (body-container-effect-witness? form functions effect visited depth 0)
          false)))))

(defn- body-container-effects-covered? [form :document functions :document
                                       declared :document visited :document depth :i64
                                       start :i64] :bool
  (let [kind (document-kind form)]
    (loop [index start]
      (if (= index (document-count form)) true
        (let [item (if (= kind :list) (list-item form index)
                     (if (= kind :vector) (vector-item form index)
                       (if (= kind :set)
                         (option-value-of [:option :document] (document-set-at form index) (document-null))
                         (option-value-of [:option :document] (document-map-entry-at form index) (document-vector))))) ]
          (and (body-effects-covered? item functions declared visited (+ depth 1))
               (recur (+ index 1))))))))

(defn- body-list-effects-covered? [form :document functions :document declared :document
                                  visited :document depth :i64] :bool
  (if (= (document-count form) 0) false
    (let [operator (list-item form 0)
          cap-call (document-symbol (symbol "cap-call"))
          typed-cap-call (document-symbol (symbol "typed-cap-call"))]
      (if (document-equal? operator cap-call)
        (let [effect (cap-effect-of-call form 3)]
          (and (not (= (document-kind effect) :null))
               (document-set-contains? declared effect)
               (body-effects-covered? (list-item form 2) functions declared visited (+ depth 1))))
        (if (document-equal? operator typed-cap-call)
          (let [effect (cap-effect-of-call form 5)]
            (and (not (= (document-kind effect) :null))
                 (document-set-contains? declared effect)
                 (body-effects-covered? (list-item form 4) functions declared visited (+ depth 1))))
          (let [callee-index (function-index functions operator)]
            (if (< callee-index 0)
              (body-container-effects-covered? form functions declared visited depth 1)
              (let [callee (vector-item functions callee-index)
                    callee-name (field callee :name)
                    callee-effects (field callee :effects)
                    callee-visited (document-vector-conj visited callee-name)]
                (and (capability-effects-subset? callee-effects declared)
                     (or (name-in-vector? visited callee-name)
                         (body-effects-covered? (field callee :body) functions callee-effects
                                                callee-visited (+ depth 1)))
                     (body-container-effects-covered? form functions declared visited depth 1))))))))))

(defn- body-effects-covered? [form :document functions :document declared :document
                              visited :document depth :i64] :bool
  (if (> depth 256) false
    (let [kind (document-kind form)]
      (if (= kind :list)
        (body-list-effects-covered? form functions declared visited depth)
        (if (or (= kind :vector) (= kind :set) (= kind :map))
          (body-container-effects-covered? form functions declared visited depth 0)
          true)))))

(defn- body-resource-push [pending :document nodes :i64 child :document depth :i64] :document
  (if (>= (+ nodes (document-count pending)) 50000) (document-null)
    (document-vector-conj pending (document-vector child (document-i64 depth)))))

(defn- body-resource-children [form :document pending :document nodes :i64 depth :i64] :document
  (let [kind (document-kind form)
        child-depth (+ depth 1)]
    (if (or (= kind :list) (= kind :vector) (= kind :set))
      (loop [index 0 current pending]
        (if (= index (document-count form)) current
          (let [child (if (= kind :list) (list-item form index)
                        (if (= kind :vector) (vector-item form index)
                          (option-value-of [:option :document]
                            (document-set-at form index) (document-null))))
                pushed (body-resource-push current nodes child child-depth)]
            (if (= (document-kind pushed) :null) (document-null)
              (recur (+ index 1) pushed)))))
      (if (= kind :map)
        (loop [index 0 current pending]
          (if (= index (document-count form)) current
            (let [entry (option-value-of [:option :document]
                          (document-map-entry-at form index) (document-vector))
                  key (option-value-of [:option :document]
                         (document-vector-at entry 0) (document-null))
                  value (option-value-of [:option :document]
                           (document-vector-at entry 1) (document-null))
                  with-key (body-resource-push current nodes key child-depth)
                  with-value (if (= (document-kind with-key) :null) (document-null)
                               (body-resource-push with-key nodes value child-depth))]
              (if (= (document-kind with-value) :null) (document-null)
                (recur (+ index 1) with-value)))))
        pending))))

;; Iterative native walk avoids consuming one host frame per nested KIR form.
;; The node cap counts structural document nodes, including operator/tag nodes,
;; so it conservatively bounds expressions before the reference 50,000 limit.
(defn- body-literals-bounded? [form :document nodes :i64] :i64
  (loop [pending (document-vector (document-vector form (document-i64 0))) index 0]
    (if (= index (document-count pending)) (+ nodes (document-count pending))
      (let [item (option-value-of [:option :document]
                   (document-vector-at pending index) (document-vector))
            current (option-value-of [:option :document]
                      (document-vector-at item 0) (document-null))
            depth (option-value-of [:option :i64]
                    (document-i64-value
                      (option-value-of [:option :document]
                        (document-vector-at item 1) (document-null))) -1)
            kind (document-kind current)
            literal-bytes
            (if (= kind :string)
              (string-byte-length
                (option-value-of [:option :string] (document-string-value current) ""))
              (if (= kind :keyword)
                (string-byte-length (document-edn-print current))
                0))]
        (if (or (< depth 0) (> depth 256) (> literal-bytes 65536)
                (and (= index 0) (>= nodes 50000))) -1
          (let [expanded (body-resource-children current pending nodes depth)]
            (if (= (document-kind expanded) :null) -1
              (if (and (= index 0) (> (+ nodes 1) 50000)) -1
                (recur expanded (+ index 1))))))))))

(defn- function-bodies-resource-count [functions :document] :i64
  (loop [index 0 nodes 0]
    (if (= index (document-count functions)) nodes
      (let [next-nodes (body-literals-bounded?
                         (field (vector-item functions index) :body) nodes)]
        (if (< next-nodes 0) -1
          (recur (+ index 1) next-nodes))))))

(defn kexe-function-bodies-resource-valid? [program :document] :bool
  (if (not (kexe-module-outline? program)) false
    (>= (function-bodies-resource-count (field program :functions)) 0)))

;; Independently re-derive the core scalar operator arities admitted by the
;; reference verifier. Other operation families remain separate slices.
(defn- core-operation-arity-valid? [form :document] :bool
  (if (not (= (document-kind form) :list)) true
    (let [operator (list-item form 0)
          arity (- (document-count form) 1)
          variadic (or (document-equal? operator (document-symbol (symbol "+")))
                       (document-equal? operator (document-symbol (symbol "-")))
                       (document-equal? operator (document-symbol (symbol "*"))))
          binary (or (document-equal? operator (document-symbol (symbol "quot")))
                     (document-equal? operator (document-symbol (symbol "bit-xor")))
                     (document-equal? operator (document-symbol (symbol "bit-and")))
                     (document-equal? operator (document-symbol (symbol "bit-or")))
                     (document-equal? operator (document-symbol (symbol "=")))
                     (document-equal? operator (document-symbol (symbol "<")))
                     (document-equal? operator (document-symbol (symbol ">")))
                     (document-equal? operator (document-symbol (symbol "<=")))
                     (document-equal? operator (document-symbol (symbol ">="))))
          unary (or (document-equal? operator (document-symbol (symbol "bool-not")))
                    (document-equal? operator (document-symbol (symbol "bit-not")))
                    (document-equal? operator (document-symbol (symbol "i32-wrap")))
                    (document-equal? operator (document-symbol (symbol "u32-wrap"))))
          i64-shift (or (document-equal? operator (document-symbol (symbol "i64-shift-left")))
                        (document-equal? operator (document-symbol (symbol "i64-shift-right")))
                        (document-equal? operator (document-symbol (symbol "u64-shift-right"))))
          i32-binary (or (document-equal? operator (document-symbol (symbol "i32-wrapping-add")))
                         (document-equal? operator (document-symbol (symbol "i32-wrapping-mul")))
                         (document-equal? operator (document-symbol (symbol "i32-xor"))))
          i32-shift (or (document-equal? operator (document-symbol (symbol "i32-shift-left")))
                        (document-equal? operator (document-symbol (symbol "i32-shift-right")))
                        (document-equal? operator (document-symbol (symbol "u32-shift-right"))))
          i64-minmax (or (document-equal? operator (document-symbol (symbol "min")))
                         (document-equal? operator (document-symbol (symbol "max"))))
          shift-count (document-i64-value (list-item form 2))]
      (if variadic (> arity 0)
        (if (or binary i32-binary i64-minmax) (= arity 2)
          (if unary (= arity 1)
            (if i64-shift
              (and (= arity 2) (option-some?-of [:option :i64] shift-count)
                   (<= 0 (option-value-of [:option :i64] shift-count -1))
                   (<= (option-value-of [:option :i64] shift-count -1) 63))
              (if i32-shift
                (and (= arity 2) (option-some?-of [:option :i64] shift-count)
                     (<= 0 (option-value-of [:option :i64] shift-count -1))
                     (<= (option-value-of [:option :i64] shift-count -1) 31))
                true))))))))

(defn- function-body-core-operations-valid? [body :document] :bool
  (loop [pending (document-vector (document-vector body (document-i64 0))) index 0]
    (if (= index (document-count pending)) true
      (let [item (option-value-of [:option :document]
                   (document-vector-at pending index) (document-vector))
            current (option-value-of [:option :document]
                      (document-vector-at item 0) (document-null))
            expanded (body-resource-children current pending 0 0)]
        (and (core-operation-arity-valid? current)
             (not (= (document-kind expanded) :null))
             (recur expanded (+ index 1)))))))

(defn kexe-function-core-operations-valid? [program :document] :bool
  (if (not (kexe-module-outline? program)) false
    (let [functions (field program :functions)]
      (loop [index 0]
        (if (= index (document-count functions)) true
          (and (function-body-core-operations-valid?
                 (field (vector-item functions index) :body))
               (recur (+ index 1))))))))

(defn- function-cap-effects-realized? [function :document functions :document] :bool
  (let [effects (field function :effects)
        name (field function :name)
        body (field function :body)
        visited (document-vector name)]
    (loop [index 0]
      (if (= index (document-count effects)) true
        (let [effect (option-value-of [:option :document]
                       (document-set-at effects index) (document-null))]
          (and (or (not (type-tag? effect :cap/call))
                   (body-effect-witness? body functions effect visited 0))
               (recur (+ index 1))))))))

(defn- effect-set-subset? [subset :document superset :document] :bool
  (loop [index 0]
    (if (= index (document-count subset)) true
      (if (document-set-contains? superset
            (option-value-of [:option :document] (document-set-at subset index) (document-null)))
        (recur (+ index 1)) false))))

(defn- effect-in-functions? [functions :document effect :document] :bool
  (loop [index 0]
    (if (= index (document-count functions)) false
      (if (document-set-contains? (field (vector-item functions index) :effects) effect)
        true
        (recur (+ index 1))))))

(defn- function-effect-row-matches? [functions :document module-effects :document] :bool
  (let [function-effects-fit?
        (loop [function-index 0]
          (if (= function-index (document-count functions)) true
            (if (effect-set-subset? (field (vector-item functions function-index) :effects) module-effects)
              (recur (+ function-index 1)) false)))
        module-effects-fit?
        (loop [effect-index 0]
          (if (= effect-index (document-count module-effects)) true
            (let [effect (option-value-of [:option :document]
                           (document-set-at module-effects effect-index) (document-null))]
              (if (effect-in-functions? functions effect)
                (recur (+ effect-index 1)) false))))]
    (and function-effects-fit? module-effects-fit?)))

(defn kexe-function-effects-match? [program :document] :bool
  (if (or (not (kexe-module-outline? program))
          (not (kexe-function-record-shapes-valid? program))
          (not (kexe-function-bodies-resource-valid? program))
          (not (kexe-function-core-operations-valid? program))) false
    (let [functions (field program :functions)
          module-effects (field program :effects)]
      (let [function-bodies-fit?
            (loop [index 0]
              (if (= index (document-count functions)) true
                (let [function (vector-item functions index)
                      name (field function :name)
                      effects (field function :effects)]
                  (if (and (body-capability-calls-valid? (field function :body) 0)
                           (body-effects-covered? (field function :body) functions effects
                                                  (document-vector name) 0))
                    (if (function-cap-effects-realized? function functions)
                      (recur (+ index 1)) false)
                    false))))]
        (if function-bodies-fit?
          (function-effect-row-matches? functions module-effects)
          false)))))

(defn kexe-function-boundaries-valid? [program :document] :bool
  (if (not (kexe-module-outline? program)) false
    (let [functions (field program :functions)
          exports (field program :exports)
          entry (field program :entry)]
      (loop [index 0]
        (if (= index (document-count functions)) true
          (let [function (vector-item functions index)
                name (field function :name)
                exported?
                (loop [export-index 0]
                  (if (= export-index (document-count exports)) false
                    (or (document-equal? name (vector-item exports export-index))
                        (recur (+ export-index 1)))))
                is-entry? (document-equal? name entry)
                params (field function :params)
                result (field function :result)
                result-ok? (or (document-equal? result (document-keyword :i64))
                               (document-equal? result (document-keyword :bool))
                               (document-equal? result (document-keyword :string))
                               (document-equal? result (document-keyword :f64))
                               (and exported? (not is-entry?) (= (document-count params) 0)
                                    (or (document-equal? result (document-keyword :vector-i64))
                                        (document-equal? result (document-keyword :vector-f64))))
                               (native-function-type? result exported?))]
            (and (function-identity-shape? function)
                 (<= (document-count params) 64)
                 result-ok?
                 (loop [param-index 0]
                   (if (= param-index (document-count params)) true
                     (and (= (document-kind (vector-item params param-index)) :symbol)
                          (recur (+ param-index 1)))))
                 (loop [param-index 0]
                   (if (= param-index (document-count params)) true
                     (let [param-name (vector-item params param-index)]
                       (and (not (loop [prior-index 0]
                                   (if (= prior-index param-index) false
                                     (or (document-equal? param-name (vector-item params prior-index))
                                         (recur (+ prior-index 1))))))
                            (recur (+ param-index 1))))))
                 (or (= (document-kind (field function :param-types)) :null)
                     (let [param-types (field function :param-types)]
                       (and (= (document-kind param-types) :vector)
                            (= (document-count param-types) (document-count params))
                            (loop [param-index 0]
                              (if (= param-index (document-count param-types)) true
                                (and (native-function-type? (vector-item param-types param-index) exported?)
                                     (recur (+ param-index 1))))))))
                 (recur (+ index 1)))))))))
