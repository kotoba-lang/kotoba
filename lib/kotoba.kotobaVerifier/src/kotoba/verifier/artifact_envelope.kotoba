;; Bounded first native slice of verify-artifact!: outer KExe schema shape,
;; format tag, KIR digest shape, and claimed/runtime effect-set agreement.
;; The optional :oracle marker is validated here. Seal integrity, KIR hash
;; value, and runtime semantics remain separate work.
(ns kotoba.verifier.artifact-envelope
  {:kotoba/export [kexe-header-shape? code-bytes-shape?]})

(defn- field [value :document key :keyword] :document
  (option-value-of [:option :document] (document-get value key) (document-null)))

(defn- exact-fields? [value :document fields :document] :bool
  (and (= (document-kind value) :map)
       (= (document-count value) (document-count fields))
       (loop [entry-index 0]
         (if (= entry-index (document-count value)) true
           (let [entry (option-value-of [:option :document]
                         (document-map-entry-at value entry-index) (document-vector))
                 key (option-value-of [:option :document]
                       (document-vector-at entry 0) (document-null))]
             (and (loop [field-index 0]
                    (if (= field-index (document-count fields)) false
                      (if (document-equal? key
                            (option-value-of [:option :document]
                              (document-vector-at fields field-index) (document-null)))
                        true
                        (recur (+ field-index 1)))))
                  (recur (+ entry-index 1))))))))

(defn- digest-shape? [value :document] :bool
  (if (not (= (document-kind value) :string)) false
    (let [text (option-value-of [:option :string] (document-string-value value) "")]
      (and (= (string-length text) 64)
           (loop [i 0]
             (if (= i 64) true
               (let [c (string-code-point-at text i)]
                 (and (or (and (>= c 48) (<= c 57))
                          (and (>= c 97) (<= c 102)))
                      (recur (+ i 1))))))))))

(defn- code-byte? [code :document index :i64] :bool
  (let [item (option-value-of [:option :document]
                (document-vector-at code index) (document-null))
        value (document-i64-value item)]
    (and (option-some?-of [:option :i64] value)
         (<= 0 (option-value-of [:option :i64] value 0))
         (<= (option-value-of [:option :i64] value 0) 255))))

(defn code-bytes-shape? [code :document] :bool
  (and (= (document-kind code) :vector)
       (<= 1 (document-count code))
       (<= (document-count code) 1048576)
       (loop [index 0]
         (if (= index (document-count code)) true
           (and (code-byte? code index)
                (recur (+ index 1)))))))

(defn- inconclusive-trap? [trap :document] :bool
  (or (document-equal? trap (document-keyword :budget/fuel))
      (document-equal? trap (document-keyword :budget/cells))
      (document-equal? trap (document-keyword :budget/bytes))
      (document-equal? trap (document-keyword :budget/frames))
      (document-equal? trap (document-keyword :budget/gas))
      (document-equal? trap (document-keyword :host/stack-exhausted))))

(defn- valid-oracle-marker? [kexe :document] :bool
  (let [oracle (field kexe :oracle)
        limits (field kexe :limits)
        fields (document-vector (document-keyword :status)
                                (document-keyword :trap)
                                (document-keyword :fuel))]
    (if (not (exact-fields? oracle fields)) false
      (if (not (= (document-kind limits) :map)) false
        (and (document-equal? (field oracle :status) (document-keyword :inconclusive))
             (inconclusive-trap? (field oracle :trap))
             (document-equal? (field oracle :fuel) (field limits :fuel))
             (= (document-kind (field kexe :value)) :null))))))

(defn kexe-header-shape? [kexe :document] :bool
  (let [fields (document-vector
                 (document-keyword :format) (document-keyword :target)
                 (document-keyword :target-profile) (document-keyword :value)
                 (document-keyword :kir-sha256) (document-keyword :lowering)
                 (document-keyword :fuel-abi) (document-keyword :context-abi)
                 (document-keyword :effects) (document-keyword :limits)
                 (document-keyword :code) (document-keyword :program)
                 (document-keyword :exports) (document-keyword :compatibility)
                 (document-keyword :sha256))
        inconclusive-fields (document-vector-conj fields (document-keyword :oracle))]
    (if (not (or (exact-fields? kexe fields)
                 (exact-fields? kexe inconclusive-fields))) false
      (let [program (field kexe :program)]
        (and (document-equal? (field kexe :format) (document-keyword :kotoba.kexe/v1))
             (digest-shape? (field kexe :kir-sha256))
             (code-bytes-shape? (field kexe :code))
             (= (document-kind program) :map)
             (document-equal? (field kexe :effects) (field program :effects))
             (or (= (document-count kexe) 15)
                 (valid-oracle-marker? kexe)))))))
