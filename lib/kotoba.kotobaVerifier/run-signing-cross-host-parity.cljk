(ns run-signing-cross-host-parity
  "Strict entry for the Ed25519 cross-host parity gate
  (kotoba.verifier-signing-cross-host-parity-test). Run it on BOTH hosts:

    nbb:  CP=$(kbb -Spath -M:test); OSAHO=$(printf '%s' "$CP" | tr ':' '\n' | grep '/osaho/' | head -1);
          REST=$(printf '%s' "$CP" | tr ':' '\n' | grep -v '/osaho/' | paste -sd: -)
          kbb --backend sci --classpath "src:test:$OSAHO:$REST" run-signing-cross-host-parity.cljk
    JVM:  sh scripts/jvm-cljk-run.sh run-signing-cross-host-parity.cljk

  (The osaho hoist on the nbb line is measured: kotoba.kir otherwise
  resolves to kotoba-kir's kir.cljc, which lacks max-fuel -- see
  kotoba.verifier-signing-cross-host-parity-test's sibling-command.)

  Each run spawns the other host as the signing worker, so one run already
  covers both directions of key and signature exchange; the two runs together
  are the parity evidence. Exit codes: 0 every case ran and passed, 1 a case
  failed, 2 a case could not run (sibling host unavailable) -- a case not run
  is not a case passed."
  (:require [kotoba.test :as t]
            [kotoba.verifier-signing-cross-host-parity-test :as parity]))

#?(:clj (defmethod t/report :summary [m]
          (println (str "jvm: " (:test m) " tests, " (:pass m) " passed, "
                        (:fail m) " failed, " (:error m) " errors"))
          (cond
            (pos? (+ (:fail m) (:error m))) (System/exit 1)
            @parity/skipped (do (println "jvm: case NOT run: " @parity/skipped)
                                (System/exit 2))))
   :cljs (defmethod t/report [:cljs.test/default :end-run-tests] [m]
           (println (str "nbb: " (:test m) " tests, " (:pass m) " passed, "
                         (:fail m) " failed, " (:error m) " errors"))
           (cond
             (pos? (+ (or (:fail m) 0) (or (:error m) 0)))
             (set! (.-exitCode js/process) 1)
             @parity/skipped (do (println "nbb: case NOT run: " @parity/skipped)
                                 (set! (.-exitCode js/process) 2)))))

(t/run-tests 'kotoba.verifier-signing-cross-host-parity-test)
