#!/bin/sh
set -eu

REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
LIB_ROOT="$REPO_ROOT/lib/kotoba.kotobaVerifier"
AMU_CLI=${AMU_CLI:?set AMU_CLI to the pinned native Amu CLI}
EXPECTED_AMU_CLI_SHA256=ae94dc99ffe489ef77cb5eb0044bea1d2500a4273d45c55bcf57b887994f390a
OUT_DIR=${OUT_DIR:?set OUT_DIR to a new directory under github/workspaces}

case "$AMU_CLI" in
  /*) ;;
  *) printf '%s\n' "AMU_CLI must be an absolute path" >&2; exit 2 ;;
esac
case "$OUT_DIR" in
  /Users/junkawasaki/github/workspaces/*) ;;
  *) printf '%s\n' "OUT_DIR must stay under github/workspaces" >&2; exit 2 ;;
esac
if [ ! -x "$AMU_CLI" ]; then
  printf '%s\n' "Amu CLI is missing or not executable: $AMU_CLI" >&2
  exit 2
fi
if [ -e "$OUT_DIR" ]; then
  printf '%s\n' "refusing to overwrite existing output: $OUT_DIR" >&2
  exit 2
fi
AMU_CLI_SHA256=$(shasum -a 256 "$AMU_CLI" | cut -d ' ' -f 1)
if [ "$AMU_CLI_SHA256" != "$EXPECTED_AMU_CLI_SHA256" ]; then
  printf '%s\n' "unexpected Amu CLI digest: $AMU_CLI_SHA256" >&2
  exit 2
fi

mkdir -p "$OUT_DIR"
cp "$LIB_ROOT/test/native/signing_wire_probe.kotoba" "$OUT_DIR/signing_wire_probe.kotoba"
ENTRY="$OUT_DIR/signing_wire_probe.kotoba"
ED25519="$REPO_ROOT/lib/org.ietf.ed25519/kotoba/ed25519/selfhost.kotoba"
ARTIFACT="$REPO_ROOT/lib/kotoba.artifact/src/kotoba/artifact/core.kotoba"
BASE64="$REPO_ROOT/lib/kotoba.bytes/src/kotoba/bytes/base64.kotoba"
NATIVE_SIGNING="$LIB_ROOT/src/kotoba/verifier/native_signing.kotoba"
SHA256="$REPO_ROOT/lib/kotoba.ioMultiformats/src/multiformats/sha256.kotoba"

sha() { shasum -a 256 "$1" | cut -d ' ' -f 1; }
cat > "$OUT_DIR/signing-wire.ksl" <<EOF
KSL2
entry $ENTRY
module ed25519.selfhost $ED25519
module kotoba.artifact.core $ARTIFACT
module kotoba.bytes.base64 $BASE64
module kotoba.verifier.native-signing $NATIVE_SIGNING
module multiformats.sha256 $SHA256
module native.signing.probe $ENTRY
file $(sha "$ENTRY") $ENTRY
file $(sha "$ARTIFACT") $ARTIFACT
file $(sha "$BASE64") $BASE64
file $(sha "$SHA256") $SHA256
file $(sha "$NATIVE_SIGNING") $NATIVE_SIGNING
file $(sha "$ED25519") $ED25519
EOF

LOCK="$OUT_DIR/signing-wire.ksl"
PROGRAM="$OUT_DIR/signing-wire.macho"
"$AMU_CLI" check "$ENTRY" --source-lock "$LOCK"
"$AMU_CLI" compile "$ENTRY" --source-lock "$LOCK" -o "$PROGRAM"
codesign --verify --strict "$PROGRAM"
DIRECT_RESULT=$("$PROGRAM")
if [ "$DIRECT_RESULT" != 0 ]; then
  printf 'direct native signing probe failed: %s\n' "$DIRECT_RESULT" >&2
  exit 1
fi
AMU_RESULT=$("$AMU_CLI" run "$PROGRAM")
if [ "$AMU_RESULT" != 0 ]; then
  printf 'Amu artifact run failed: %s\n' "$AMU_RESULT" >&2
  exit 1
fi

printf 'format: kotoba.verifier.native-signing-selfhost.v1\n'
printf 'amu_cli_sha256: %s\n' "$AMU_CLI_SHA256"
printf 'source_lock_sha256: %s\n' "$(sha "$LOCK")"
printf 'program_sha256: %s\n' "$(sha "$PROGRAM")"
printf 'direct_native_result: %s\n' "$DIRECT_RESULT"
printf 'amu_artifact_run_result: %s\n' "$AMU_RESULT"
printf 'qualification: bounded adapter wire/runtime check; not verifier library or launcher qualification\n'
