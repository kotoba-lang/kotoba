(ns kotoba.verifier-arena-scope-test
  "`(arena-scope body)` at the verifier -- superproject ADR-2609160044.

  The frontend types the body; this verifier re-derives the rule on shape,
  conservatively, so that a string-, vector- or record-valued body is refused
  here by name even if the frontend were wrong. Both directions, with the
  reason literal pinned."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.verifier]))

(defn- program
  "A module whose zero-arity `main` is BODY; the scope under test may also
  sit in `scoped`, a one-parameter function whose parameter type is
  PARAM-TYPE, which `main` calls."
  ([body] (program body 'scoped-unused :i64 nil))
  ([body scoped-name param-type scoped-body]
   {:format :kotoba.kir/v4 :entry 'main :exports ['main]
    :signature {:params [] :result :i64} :effects #{}
    :functions (cond-> [{:name 'helper :params ['s] :param-types [:string] :result :string :effects #{}
                         :body 's}
                        {:name 'count-of :params ['s] :param-types [:string] :result :i64 :effects #{}
                         :body '(string-byte-length s)}]
                 scoped-body (conj {:name scoped-name :params ['x] :param-types [param-type]
                                    :result :i64 :effects #{} :body scoped-body})
                 true (conj {:name 'main :params [] :param-types [] :result :i64 :effects #{}
                             :body body}))}))

(defn- rejection [program]
  (try (#'kotoba.verifier/verify-program! program)
       nil
       (catch :default e
         (when-not (= :verify (:phase (ex-data e)))
           (throw e))
         (ex-message e))))

(def ^:private reason
  "runtime KIR arena-scope body rejected: not scalar -- a handle would escape the region it is released with")

(deftest scalar-shaped-bodies-are-admitted
  (doseq [body ['(arena-scope 42)
                '(arena-scope (+ 1 2))
                '(arena-scope (string-byte-length (string-concat "a" "b")))
                '(arena-scope (string-index-of "abc" "b"))
                '(arena-scope (if (= 1 1) 1 0))
                '(arena-scope (do (string-concat "a" "b") 7))
                '(arena-scope (let [s (string-concat "a" "b") n (string-byte-length s)] n))
                '(arena-scope (count-of "abc"))
                '(arena-scope (arena-scope 1))
                '(+ 1 (arena-scope (* 2 3)))]]
    (testing (pr-str body)
      (is (nil? (rejection (program body)))))))

(deftest a-scalar-parameter-is-admitted-and-a-string-parameter-is-not
  (is (nil? (rejection (program '(scoped 1) 'scoped :i64 '(arena-scope (+ x 1))))))
  (is (= reason (rejection (program '(scoped "a") 'scoped :string '(arena-scope x))))))

(deftest handle-valued-bodies-are-refused-by-name
  (doseq [body ['(arena-scope (string-concat "a" "b"))
                '(arena-scope "abc")
                '(arena-scope (helper "abc"))
                '(arena-scope (let [s (string-concat "a" "b")] s))
                '(arena-scope (if (= 1 1) "a" "b"))
                '(arena-scope (do 1 (string-concat "a" "b")))
                '(arena-scope (vector-new 1 2))]]
    (testing (pr-str body)
      (is (= reason (rejection (program body)))))))

(deftest the-arity-is-one
  (is (= "runtime KIR region operation arity rejected"
         (rejection (program '(arena-scope 1 2))))))
