(ns kotoba.verifier-typed-map-test
  "amu ADR 0353 floor :native-hiccup-node at the verifier.

  A `[:map K V]` of one-word keys and values is a native handle -- the
  `[:list T]` arena, keys and values interleaved -- so the hiccup elem's
  `[:map :keyword :string]` attrs reach the oracle through the language's
  schema table. new / count / contains / get / assoc / dissoc are re-derived;
  a key type native code cannot compare by content, an arity off by one,
  and `typed-map-equal` (equality over a map handle) stay refused."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.verifier]))

(def ^:private attrs-type [:map :keyword :string])
(def ^:private attrs (list 'typed-map-new attrs-type :class "c" :id "w1"))

(defn- program [body]
  {:format :kotoba.kir/v3 :entry 'main :exports ['main]
   :signature {:params [] :result :i64} :effects #{}
   :functions [{:name 'main :params [] :result :i64 :effects #{} :body body}
               {:name 'size :params ['m] :param-types [attrs-type] :result :i64
                :effects #{} :body (list 'typed-map-count attrs-type 'm)}]})

(defn- rejection [body]
  (try (#'kotoba.verifier/verify-program! (program body))
       nil
       (catch :default e
         (when-not (= :verify (:phase (ex-data e)))
           (throw e))
         (ex-message e))))

(deftest typed-map-operations-are-re-derived
  (doseq [body [(list 'size attrs)
                (list 'typed-map-count attrs-type attrs)
                (list 'if (list 'typed-map-contains attrs-type attrs :id) 1 0)
                (list 'string-byte-length
                      (list 'option-value-of [:option :string]
                            (list 'typed-map-get attrs-type attrs :class) "none"))
                (list 'size (list 'typed-map-assoc attrs-type attrs :class "d"))
                (list 'size (list 'typed-map-dissoc attrs-type attrs :class))
                '(typed-map-count [:map :i64 [:option :i64]] (typed-map-new [:map :i64 [:option :i64]]))]]
    (is (nil? (rejection body)) (pr-str body))))

(def ^:private rec '[:record :t/r [[:a :i64] [:b :i64]]])
(def ^:private other '[:record :t/other [[:a :i64] [:b :i64]]])

(defn- record-value [fallback]
  (list 'record-get rec
        (list 'option-value-of [:option rec]
              (list 'typed-map-get [:map :keyword rec]
                    (list 'typed-map-new [:map :keyword rec] :x (list 'record-new rec 4 9))
                    :x)
              fallback)
        :b))

(deftest a-record-read-out-of-a-map-is-that-record
  (is (nil? (rejection (record-value (list 'record-new rec 1 2)))))
  (testing "a default of another record is not that record"
    (is (= "runtime KIR record projection rejected"
           (rejection (record-value (list 'record-new other 1 2)))))))

(deftest what-stays-refused
  (testing "a key native code cannot compare by content"
    (is (= "runtime KIR typed-map operation rejected"
           (rejection '(typed-map-count [:map [:vector [:i64 :i64]] :i64]
                                        (typed-map-new [:map [:vector [:i64 :i64]] :i64]))))))
  (testing "a dangling key"
    (is (= "runtime KIR typed-map operation rejected"
           (rejection (list 'typed-map-count attrs-type (list 'typed-map-new attrs-type :class))))))
  (testing "a wrong arity"
    (is (= "runtime KIR typed-map operation rejected"
           (rejection (list 'typed-map-count attrs-type attrs 1)))))
  (testing "no equality over a map handle"
    (is (= "runtime KIR operation rejected"
           (rejection (list 'if (list 'typed-map-equal attrs-type attrs attrs) 1 0)))))
  (testing "past the reference's 31 entries"
    (is (= "runtime KIR typed-map literal exceeds the entry limit"
           (rejection (list 'typed-map-count [:map :i64 :i64]
                            (cons 'typed-map-new (cons [:map :i64 :i64] (range 64)))))))))
