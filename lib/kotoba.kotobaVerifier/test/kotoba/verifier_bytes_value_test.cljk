(ns kotoba.verifier-bytes-value-test
  "`:bytes` and the string constructor pass runtime KIR verification (context
  ABI v11, 2026-09-25, superproject adr-2609242330), on this verifier's own
  table: every head with its KIR arity, a wrong arity refused BY THE BYTES
  ARITY MESSAGE (a head in no table at all is refused too, by the terminal
  `runtime KIR operation rejected` -- asserting only rejection would pass with
  the table removed), and a bytes-valued `arena-scope` body refused because a
  bytes value is a handle."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.verifier]))

(defn- program [body]
  {:format :kotoba.kir/v3 :entry 'main :exports ['main]
   :signature {:params [] :result :i64} :effects #{}
   :functions [{:name 'main :params [] :result :i64 :effects #{} :body body}]})

(defn- rejection [body]
  (try (#'kotoba.verifier/verify-program! (program body)) nil
       (catch :default e (ex-message e))))

(def ^:private bytes-of '(bytes-from-vector-i64 (vector-new 104 105)))

(deftest every-bytes-head-verifies
  (doseq [body [(list 'bytes-count bytes-of)
                (list 'bytes-at bytes-of 0)
                (list 'bytes-count (list 'bytes-slice bytes-of 0 1))
                (list 'bytes-count (list 'bytes-concat bytes-of '(bytes-empty)))
                (list 'vector-count (list 'vector-i64-from-bytes bytes-of))
                (list 'string-byte-length (list 'string-from-utf8 bytes-of))]]
    (testing (pr-str body)
      (is (nil? (rejection body))))))

(deftest a-wrong-arity-is-refused-by-the-bytes-arity-check
  (doseq [body ['(string-byte-length (string-from-utf8))
                (list 'bytes-count (list 'bytes-from-vector-i64 '(vector-new 1) '(vector-new 2)))
                (list 'bytes-count (list 'bytes-slice bytes-of 0))]]
    (testing (pr-str body)
      (is (= "runtime KIR bytes operation arity rejected" (rejection body))))))

(deftest a-bytes-value-cannot-leave-an-arena-scope
  (is (some? (rejection (list 'bytes-count (list 'arena-scope bytes-of))))))
