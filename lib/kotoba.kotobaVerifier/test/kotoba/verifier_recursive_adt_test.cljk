(ns kotoba.verifier-recursive-adt-test
  "Aggregate ABI v8 at the verifier: a recursive variant, the heterogeneous
  vector holding its children, and a recursive schema table carried by the
  program. Each is re-derived here without calling the producer. Both
  directions, with the refusal literal pinned."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.verifier]))

(def ^:private node
  '[:variant :t/node [[:leaf :i64] [:branch [:vector [[:ref :t/node] [:ref :t/node]]]]]])
(def ^:private children '[:vector [[:ref :t/node] [:ref :t/node]]])

(defn- sum-body [index]
  (list 'variant-match node 'n
        [[:leaf 'x 'x]
         [:branch 'p (list '+ (list 'sum (list 'hetero-vector-at children 'p 0))
                           (list 'sum (list 'hetero-vector-at children 'p index)))]]))

(def ^:private main-body
  (list 'sum (list 'variant-new node :branch
                   (list 'hetero-vector-new children
                         (list 'variant-new node :leaf 20)
                         (list 'variant-new node :leaf 22)))))

(defn- program [& {:keys [index exports schemas] :or {index 1 exports ['main]}}]
  (cond-> {:format :kotoba.kir/v4 :entry 'main :exports exports
           :signature {:params [] :result :i64} :effects #{}
           :functions [{:name 'sum :params ['n] :param-types [node] :result :i64
                        :effects #{} :body (sum-body index)}
                       {:name 'main :params [] :param-types [] :result :i64
                        :effects #{} :body main-body}]}
    schemas (assoc :schemas schemas)))

(defn- rejection [program]
  (try (#'kotoba.verifier/verify-program! program)
       nil
       (catch :default e
         (when-not (= :verify (:phase (ex-data e)))
           (throw e))
         (ex-message e))))

(deftest a-recursive-variant-through-a-heterogeneous-vector-verifies
  (is (nil? (rejection (program))))
  (is (nil? (rejection (program :schemas {:t/node node})))))

(deftest refusals-name-their-reason
  (testing "an index outside the declared positions"
    (is (= "runtime KIR heterogeneous vector operation rejected"
           (rejection (program :index 2)))))
  (testing "an exported function keeps the host-validated boundary"
    (is (= "runtime KIR function shape rejected"
           (rejection (program :exports ['main 'sum])))))
  (testing "a schema table that is not recursive is not the producer's to attach"
    (is (some? (rejection (program :schemas {:t/point '[:record :t/point [[:x :i64]]]})))))
  (testing "a declared record a signature names carries its table (amu ADR 0353 :native-record-boundary)"
    (let [point '[:record :t/point [[:x :i64]]]
          record-program {:format :kotoba.kir/v4 :entry 'main :exports ['main]
                          :signature {:params [] :result :i64} :effects #{}
                          :functions [{:name 'x-of :params ['p] :param-types '[[:ref :t/point]]
                                       :result :i64 :effects #{} :body (list 'record-get point 'p :x)}
                                      {:name 'main :params [] :param-types [] :result :i64 :effects #{}
                                       :body (list 'x-of (list 'record-new point 7))}]}]
      (is (nil? (rejection (assoc record-program :schemas {:t/point point}))))
      (is (= "runtime KIR module shape rejected"
             (rejection (assoc record-program :schemas {:t/other '[:record :t/other [[:x :i64]]]}))))))
  (testing "matching a node against a different variant"
    (is (= "runtime KIR variant dispatch rejected"
           (rejection
            (assoc-in (program) [:functions 0 :body]
                      (list 'variant-match '[:variant :t/other [[:leaf :i64] [:more [:ref :t/other]]]] 'n
                            [[:leaf 'x 'x] [:more 'm 0]])))))))
