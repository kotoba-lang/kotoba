(ns kotoba.verifier-signing-cross-host-worker
  "One kotoba.verifier.signing operation on one host, for
  kotoba.verifier-signing-cross-host-parity-test.

  This file is loaded BY PATH on both hosts -- `sh scripts/jvm-cljk-run.sh`
  (real JVM, the `:clj` reader branch, java.security Ed25519) and
  `kbb --backend sci` (the Node engine, the `:cljs` branch, node:crypto) --
  so the cross-host test exercises the SAME code on each host rather than a
  re-implementation of it.

  Protocol: read one EDN request map from the file named in argv 1, perform
  exactly one signing operation, write one EDN response map to argv 2. Every
  response carries :host (:jvm or :nbb) and :version so the caller can prove
  which implementation answered. The body below only runs when the two
  arguments name its scratch files, so merely loading this namespace (a test
  suite scan) does nothing."
  (:require [kotoba.lang.edn :as edn]
            [kotoba.verifier.signing :as signing]))

(defn host-identity []
  #?(:clj {:host :jvm :version (System/getProperty "java.version")}
     :cljs {:host :nbb :version (str (.-version js/process))}))

(defn respond [req]
  (let [base (host-identity)]
    (case (:op req)
      :host base
      :generate-keypair (assoc base :key (signing/generate-keypair))
      :sign-value (assoc base :signature
                         (signing/sign-value (:key req) (:value req)))
      :verify-value (assoc base :valid?
                           (boolean (signing/verify-value (:public-key req)
                                                          (:value req)
                                                          (:signature req))))
      :valid-key? (assoc base :valid? (boolean (signing/valid-key? (:key req))))
      :valid-verification-key? (assoc base :valid?
                                      (boolean (signing/valid-verification-key? (:key req))))
      :signer-id (assoc base :signer (signing/signer-id (:public-key req)))
      (assoc base :ok? false :error (str "unknown worker op " (pr-str (:op req)))))))

(let [args (vec *command-line-args*)]
  (when (and (= 2 (count args))
             (every? #(and (string? %) (re-find #"signing-cross-host" %)) args))
    (let [[req-file resp-file] args
          outcome (try {:ok? true :result (respond (edn/read-string (slurp req-file)))}
                       (catch #?(:clj Exception :cljs :default) e
                         {:ok? false :error (ex-message e)}))]
      (spit resp-file (pr-str outcome))
      (when-not (:ok? outcome)
        #?(:clj (System/exit 1)
           :cljs (set! (.-exitCode js/process) 1))))))
