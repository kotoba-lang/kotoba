(ns kotoba.verifier-record-operations-test
  "amu ADR 0353 floor :native-record-operations at the verifier.

  kotoba-sema elaborates a row operation to `record-assoc`, or to
  `(record-get T (let [receiver m] (record-new T ..)) :f)`, and a row join
  projects `(record-get T (if c m n) :f)`. The projection's operand was
  resolved only as a construction, a local, a call or an exact SROA if, so
  every such program was refused as a projection -- hand-written too. Now a
  let denotes what its body denotes, an if whose two arms denote one record
  denotes it, and `record-assoc` is checked with `record-get`'s discipline:
  the operand must BE the record the update names. Both directions, with the
  refusal literal pinned."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.verifier]))

(def ^:private rec '[:record :t/r [[:a :i64] [:b :i64]]])
(def ^:private one '[:record :t/one [[:a :i64]]])
(def ^:private other '[:record :t/other [[:a :i64] [:b :i64]]])

(defn- program
  "A `main` whose body is BODY, beside an `mk` that returns a `:t/r` handle
  declared RESULT (expanded or by reference)."
  [body & {:keys [result] :or {result rec}}]
  {:format :kotoba.kir/v3 :entry 'main :exports ['main]
   :signature {:params [] :result :i64} :effects #{}
   :functions [{:name 'main :params [] :result :i64 :effects #{} :body body}
               {:name 'mk :params [] :result result :effects #{}
                :body (list 'record-new rec 4 9)}]})

(defn- rejection [body & options]
  (try (#'kotoba.verifier/verify-program! (apply program body options))
       nil
       (catch :default e
         (when-not (= :verify (:phase (ex-data e)))
           (throw e))
         (ex-message e))))

(def ^:private shrunk
  "`(dissoc (mk) :b)` as kotoba-sema elaborates it."
  (list 'let ['recv '(mk)] (list 'record-new one (list 'record-get rec 'recv :a))))

(deftest a-row-operation-elaboration-is-projectable
  (doseq [result [rec '[:ref :t/r]]]
    (testing (str "through a let operand, mk declared " (pr-str result))
      (is (nil? (rejection (list 'record-get one shrunk :a) :result result)))
      (is (nil? (rejection (list 'let ['m shrunk] (list 'record-get one 'm :a))
                           :result result))
          "and named by a binding"))
    (testing (str "through an if whose arms are one record, mk declared " (pr-str result))
      (is (nil? (rejection (list 'record-get rec '(if (= 1 1) (mk) (mk)) :b) :result result)))
      (is (nil? (rejection (list 'record-get rec (list 'if '(= 1 1) '(mk) (list 'record-new rec 1 2)) :a)
                           :result result))
          "a call's arm and a construction's arm name the same record"))
    (testing (str "an update, mk declared " (pr-str result))
      (is (nil? (rejection (list 'record-get rec (list 'record-assoc rec '(mk) :a 7) :a)
                           :result result)))
      (is (nil? (rejection (list 'let ['m (list 'record-assoc rec '(mk) :b 3)]
                                 (list 'record-get rec 'm :b))
                           :result result))))))

(deftest what-the-operand-is-still-decides
  (testing "an if whose arms are two records is not one record"
    (is (= "runtime KIR record projection rejected"
           (rejection (list 'record-get rec (list 'if '(= 1 1) '(mk) (list 'record-new other 1 2)) :a)))))
  (testing "a let whose body is not a record"
    (is (= "runtime KIR record projection rejected"
           (rejection (list 'record-get rec (list 'let ['h '(mk)] 7) :a)))))
  (testing "a projection of a schema the let's body is not"
    (is (= "runtime KIR record projection rejected"
           (rejection (list 'record-get rec shrunk :a)))))
  ;; Bound and unused, so no projection of the update refuses it first.
  (testing "an update names the record its operand is"
    (is (= "runtime KIR record update rejected"
           (rejection (list 'let ['m (list 'record-assoc other '(mk) :a 7)] 0))))
    (is (= "runtime KIR record update rejected"
           (rejection (list 'let ['m (list 'record-assoc rec 7 :a 7)] 0)))
        "an i64 is not a record")
    (is (= "runtime KIR record update rejected"
           (rejection (list 'let ['m (list 'record-assoc rec '(mk) :z 7)] 0)))
        "a field the record does not declare"))
  (testing "a projection of an update of another record"
    (is (= "runtime KIR record projection rejected"
           (rejection (list 'record-get other (list 'record-assoc rec '(mk) :a 7) :a))))))

(defn- param-rejection
  "`f` takes a `:t/r` handle M and answers BODY; `main` calls it."
  [body]
  (try (#'kotoba.verifier/verify-program!
        {:format :kotoba.kir/v3 :entry 'main :exports ['main]
         :signature {:params [] :result :i64} :effects #{}
         :functions [{:name 'main :params [] :result :i64 :effects #{}
                      :body (list 'f (list 'record-new rec 4 9))}
                     {:name 'f :params ['m] :param-types [rec] :result :i64 :effects #{}
                      :body body}]})
       nil
       (catch :default e
         (when-not (= :verify (:phase (ex-data e)))
           (throw e))
         (ex-message e))))

(deftest a-let-naming-a-record-parameter-binds-its-handle
  ;; `(dissoc m :b)` on a row parameter, as kotoba-sema elaborates it.
  (is (nil? (param-rejection
             (list 'record-get one
                   (list 'let ['recv 'm] (list 'record-new one (list 'record-get rec 'recv :a)))
                   :a))))
  ;; amu ADR 0353 floor :native-handles: a let-bound record local forwards
  ;; too, so a rebinding names the record the let bound -- not the parameter.
  (testing "a let that rebinds the parameter's name names the record it binds"
    (is (nil? (param-rejection
               (list 'let ['m (list 'record-new rec 1 2) 'r 'm] (list 'record-get rec 'r :a)))))
    (is (= "runtime KIR record projection rejected"
           (param-rejection
            (list 'let ['m (list 'record-new other 1 2) 'r 'm] (list 'record-get rec 'r :a)))))))

(deftest a-let-naming-an-update-of-a-parameter-binds-that-record
  ;; amu ADR 0353 floor :native-rebound-row-update: `(let [s (update s :a
  ;; inc)] (update s :b inc))` on a row parameter, as kotoba-sema elaborates
  ;; it. The let names an update of the parameter, so it binds the record the
  ;; update names, and the second update's operand IS that record.
  (let [first-update (list 'record-assoc rec 'm :a (list '+ (list 'record-get rec 'm :a) 1))
        second-update (fn [type]
                        (list 'record-assoc type 't :b (list '+ (list 'record-get type 't :b) 1)))]
    (is (nil? (param-rejection (list 'record-get rec (list 'let ['t first-update] (second-update rec)) :b))))
    (is (nil? (param-rejection
               (list 'let ['t first-update 'u (list 'record-assoc rec 't :a 3)]
                     (list 'record-get rec 'u :a))))
        "and an update of that name, named again")
    (testing "refused: the second update naming another record"
      (is (= "runtime KIR record update rejected"
             (param-rejection (list 'let ['t first-update] (second-update other))))))
    (testing "refused: the first update naming another record than the parameter's"
      (is (= "runtime KIR record update rejected"
             (param-rejection
              (list 'let ['t (list 'record-assoc other 'm :a 1)] (second-update other))))))))
