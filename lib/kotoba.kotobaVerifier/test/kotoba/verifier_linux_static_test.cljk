(ns kotoba.verifier-linux-static-test
  "The static ELF verifier (superproject adr-2609251400 C2), on whichever
  host runs it.

  The fixture is `examples/recursive-list.kotoba` compiled by amu to
  `aarch64-linux-static` with `--artifact object` (the sealed artifact EDN
  rather than the image). Its image was executed on Linux aarch64 when the
  target landed and printed 500500, as the kexe loader does; the test does not
  claim execution, only that the verifier re-derives that image and refuses
  every other one.

  Re-emitted 2026-10-10 from its own sealed :program by kotoba-native
  34c42ec9 when this repository's pin advanced (1728 -> 1796 bytes) and
  resealed. That image has NOT been run on Linux since: no Linux host was at
  hand."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.edn :as edn]
            [kotoba.native.linux-static :as linux-static]
            [kotoba.verifier.linux-static :as verifier]
            #?(:clj [kotoba.io :as io])
            #?(:cljs ["node:fs" :as fs])
            #?(:cljs ["node:path" :as path])))

;; What amu's reader hands a verifier on the cljs host: every integer a
;; bigint (see verifier_native_artifact_test for why a fixture read any other
;; way lies).
(defn- guest-numbers [artifact]
  #?(:clj artifact
     :cljs (letfn [(walk [v]
                     (cond
                       (and (number? v) (js/Number.isInteger v)) (js/BigInt v)
                       (map? v) (into (empty v) (map (fn [[k x]] [k (walk x)])) v)
                       (vector? v) (mapv walk v)
                       (set? v) (into #{} (map walk) v)
                       :else v))]
             (walk artifact))))

(defn- read-fixture [name]
  (guest-numbers
   (edn/read-string
    #?(:clj (slurp (io/resource (str "fixtures/" name)))
       :cljs (fs/readFileSync (path/join "resources" "fixtures" name) "utf8")))))

;; kotoba-lang lang/limits.edn :profile/native, reduced to what the packager
;; reads (amu passes the real one).
(def profile
  {:fuel {:trap :budget/fuel}
   :cells {:trap :budget/cells :default {:value 4096} :pair-arena-max {:value 67108864}}
   :bytes {:trap :budget/bytes :default {:value 65536} :max {:value 1073741824}}
   :static-elf {:admitted-slots {:value [:pair-new :pair-first :pair-second :string-equal
                                         :string-concat :string-substring :string-index-of
                                         :typed-cap-call]}
                :capability-handlers {:value {7 :clock/now 20 :process/spawn 23 :entropy/draw
                                              33 :env/read 34 :fs/browse 35 :fs/app-data
                                              37 :io/write 38 :cli/args 39 :io/write-error 41 :io/read}}
                :unimplemented-slot-trap :slot/unimplemented
                ;; :capability/refused since adr-2609251400 C3's second half
                ;; (the packager requires it of an image with handlers)
                :exit-codes {:value {:ok 0 :trap/signal 120 :budget/fuel 122 :budget/cells 123
                                     :budget/bytes 124 :slot/unimplemented 125
                                     :capability/refused 126}}}})

(defn- reason [f]
  (try (f) nil (catch #?(:clj Exception :cljs :default) e (:reason (ex-data e)))))

(deftest a-static-elf-verifies-and-every-other-image-is-refused
  (let [artifact (read-fixture "aarch64-linux-static-list.kexe")
        image (:bytes (linux-static/package artifact profile))
        report (verifier/verify-image! artifact image profile)]
    (testing "the packaged image verifies"
      (is (:ok report))
      (is (= :aarch64-linux-static-kotoba-v1 (:target report)))
      (is (= {:cells 4096 :bytes 65536} (:budgets report)))
      (is (= :implemented (get-in report [:slots :pair-new])))
      (is (= :traps (get-in report [:slots :vector-conj]))))
    (testing "parsed without the packager: no interpreter, no dynamic section"
      (let [{:keys [type machine segments]} (verifier/image-facts image)]
        (is (= [2 0xb7] [type machine]))
        (is (not-any? #(contains? #{2 3} (:type %)) segments))))
    (testing "one byte of the prelude"
      (is (= :image-not-rederived
             (reason #(verifier/verify-image! artifact (update image 0x1010 bit-xor 1) profile)))))
    (testing "one byte of the program"
      (is (= :image-not-rederived
             (reason #(verifier/verify-image!
                       artifact (update image (:code-offset report) bit-xor 1) profile)))))
    (testing "a truncated image"
      (is (= :image-not-rederived
             (reason #(verifier/verify-image! artifact (subvec image 0 4096) profile)))))
    (testing "an image baked with another budget than the profile names"
      (is (= :image-not-rederived
             (reason #(verifier/verify-image!
                       artifact image (assoc-in profile [:cells :default :value] 100))))))
    (testing "a kexe artifact is not a static ELF"
      (is (= :not-linux-static
             (reason #(verifier/verify-image! (read-fixture "aarch64-demo.kexe") image profile)))))))

;; C3 (superproject adr-2609251400): a program with capability effects. The
;; fixture is a two-effect program (:io/write 37, :cli/args 38) compiled by amu
;; to aarch64-linux-static with --artifact object, and the two decision
;; artifacts amu compiles for aarch64 from tools/kexe_loader_decisions.kotoba
;; and tools/linux_static_handlers.kotoba (the text of amu's
;; kotoba.compiler.linux-static-handlers). Execution is amu
;; scripts/test-linux-static-handlers.cljk's, on Linux, against kexe + loader.
;;
;; Read WITHOUT `guest-numbers`: that walk makes every integer a bigint, and
;; amu's reader does not -- it narrows the structural indexes back
;; (cli-support `narrow-structural-indexes`), among them the effect wire ids.
;; Walked, the effect set of this fixture no longer equals the one its
;; program derives and the artifact is refused ("runtime KIR function effects
;; rejected", measured 2026-09-25), which is a fact about the walk, not the
;; verifier. The packager here is handed what amu's compile hands it.
(defn- read-plain [name]
  (edn/read-string
   #?(:clj (slurp (io/resource (str "fixtures/" name)))
      :cljs (fs/readFileSync (path/join "resources" "fixtures" name) "utf8"))))

(deftest a-static-elf-with-handlers-re-derives-their-code-too
  (let [artifact (read-plain "aarch64-linux-static-io.kexe")
        options {:handlers {:decisions (read-plain "aarch64-kexe-loader-decisions.kexe")
                            :handlers (read-plain "aarch64-linux-static-handlers.kexe")}}
        packaged (linux-static/package artifact profile options)
        image (:bytes packaged)
        report (verifier/verify-image! artifact image profile options)]
    (testing "the packaged image verifies, with its grant and its decision code"
      (is (:ok report))
      (is (= [37 38] (:grant report)))
      ;; no :process/spawn in the effects: the spawn grant reported is the
      ;; empty one (adr-2609251400 C3, second half)
      (is (= {:programs [] :path-lookup false :env []} (:spawn report)))
      (is (= :implemented (get-in report [:slots :typed-cap-call])))
      (is (= [:decisions :handlers] (mapv :which (:decision-code report)))))
    (testing "one byte of the handler decision code"
      (let [at (:address (first (:decision-code report)))]
        (is (= :image-not-rederived
               (reason #(verifier/verify-image! artifact (update image at bit-xor 1) profile options))))))
    (testing "one more bit in the sealed allow mask"
      (is (= :image-not-rederived
             (reason #(verifier/verify-image! artifact (update image (+ (:data-offset packaged) 16 4) bit-or 0x80)
                                              profile options)))))
    (testing "a handler artifact whose code is not its program's"
      (is (= :handler-artifact
             (reason #(verifier/verify-image! artifact image profile
                                              (update-in options [:handlers :handlers :code] (comp vec reverse)))))))
    (testing "the image of a narrower grant is not the image of this one"
      (is (= :image-not-rederived
             (reason #(verifier/verify-image! artifact image profile (assoc options :grant #{37}))))))))
