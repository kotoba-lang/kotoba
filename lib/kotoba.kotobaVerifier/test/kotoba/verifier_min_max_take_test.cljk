(ns kotoba.verifier-min-max-take-test
  "i64 `min` / `max` and `vector-take` (and its f64 twin) in the verifier's
  own tables (2026-09-26, superproject adr-2609242330, selfhost stage 2).

  The frontend declares `min` and `max` strictly binary and KIR evaluates
  both, and it declares `vector-take` beside `vector-drop`; this verifier's
  independently re-derived tables carried none of them, so every native
  artifact using one was refused -- the drift `bit-or` had, in the same safe
  direction. Both directions are pinned by reason literal: two operands are
  admitted, any other count is refused by the arity reason of the family."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.verifier]))

(defn- guest-int
  "N as this host represents a `.kotoba` integer literal."
  [n]
  #?(:clj (long n) :cljs (js/BigInt n)))

(defn- program [body]
  {:format :kotoba.kir/v3 :entry 'main :exports ['main]
   :signature {:params [] :result :i64} :effects #{}
   :functions [{:name 'main :params [] :result :i64 :effects #{} :body body}]})

(defn- rejection
  "The ex-message `verify-program!` refused BODY with, or nil if it passed. A
  throw that is not a verification refusal is re-thrown: a negative case that
  goes red for another reason has not demonstrated the gate."
  [body]
  (try (#'kotoba.verifier/verify-program! (program body))
       nil
       (catch :default e
         (when-not (= :verify (:phase (ex-data e)))
           (throw e))
         (ex-message e))))

(def ^:private i64-arity "runtime KIR i64 operation arity rejected")
(def ^:private vector-arity "runtime KIR vector operation arity rejected")

(defn- vec4 []
  (list 'vector-new (guest-int 1) (guest-int 2) (guest-int 3) (guest-int 4)))

(deftest min-and-max-are-admitted-with-two-operands
  (doseq [op '[min max]]
    (is (nil? (rejection (list op (guest-int 3) (guest-int -7)))) (str op))
    (is (nil? (rejection (list op (list op (guest-int 1) (guest-int 2)) (guest-int 0)))) (str op " nested"))))

(deftest min-and-max-refuse-any-other-operand-count-by-name
  (doseq [op '[min max]
          args [[] [(guest-int 1)] [(guest-int 1) (guest-int 2) (guest-int 3)]]]
    (is (= i64-arity (rejection (apply list op args))) (str op " " (count args)))))

(deftest vector-take-is-admitted-beside-vector-drop
  (is (nil? (rejection (list 'vector-count (list 'vector-take (vec4) (guest-int 2))))))
  (is (nil? (rejection (list 'vector-count (list 'vector-drop (vec4) (guest-int 2)))))
      "the neighbour it mirrors"))

(deftest vector-take-refuses-any-other-operand-count-by-name
  (is (= vector-arity (rejection (list 'vector-count (list 'vector-take (vec4))))))
  (is (= vector-arity (rejection (list 'vector-count
                                       (list 'vector-take (vec4) (guest-int 1) (guest-int 2)))))))
