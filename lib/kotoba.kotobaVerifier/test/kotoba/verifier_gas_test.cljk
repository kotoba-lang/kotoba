(ns kotoba.verifier-gas-test
  "Context ABI v12 (superproject adr-2610092340 D12): a native program that
  carries a `:gas-schedule` is charged by it (kotoba-native charge-gas), its
  code decrements the gas word at 384 after checking the version is 12, so
  its artifact must say v12 with `:gas-offset 384`; a program without one
  stays exactly v11. The re-emission check is what ties the schedule to the
  code: the debits are reproduced from the program's own schedule."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.artifact.core :as artifact]
            [kotoba.kir :as kotoba.kir]
            [kotoba.kir.compatibility :as compatibility]
            [kotoba.kir.target :as target]
            [kotoba.native.x86-64 :as x86-64]
            [kotoba.verifier :as verifier]))

(defn- native-artifact
  "verifier_test's helper, with the program's `:gas-schedule` kept and the
  context ABI it declares passed in."
  [kir context-abi-overrides]
  (let [fuel 512
        program (select-keys kir [:format :entry :exports :signature
                                  :effects :functions :gas-schedule])
        emitted (x86-64/emit-program program)
        profile (target/profile :x86_64-kotoba-v1)]
    (artifact/seal
     {:format :kotoba.kexe/v1
      :target :x86_64-kotoba-v1
      :target-profile profile
      :value (when (and (empty? (:effects program)) (some? (:entry program)))
               (kotoba.kir/execute program (:entry program) [] {:fuel fuel}))
      :kir-sha256 (artifact/sha256 program)
      :lowering :runtime-sysv-v1
      :fuel-abi {:mode :hidden-context-r9 :initial fuel}
      :context-abi (merge {:version 11 :fuel-offset 8 :allow-bitmap-offset 16
                    :allow-bitmap-bytes 32 :cap-call-offset 48
                    :pair-new-offset 56 :pair-first-offset 64
                    :pair-second-offset 72 :pair-capacity 4096
                    :kgraph-assert-offset 80 :kgraph-get-offset 88
                    :kgraph-count-offset 96 :kgraph-entity-at-offset 104
                    :kgraph-capacity 4096
                    :string-equal-offset 112 :string-concat-offset 120
                    :typed-cap-call-offset 128
                    :string-substring-offset 136
                    :string-code-point-at-offset 144
                    :string-pool-capacity 65536
                    :vector-new-empty-offset 152 :vector-conj-offset 160
                    :vector-count-offset 168 :vector-at-offset 176
                    :vector-assoc-offset 184 :vector-drop-offset 192
                    :vector-alloc-offset 200
                    :vector-assoc-in-place-offset 208
                    :string-index-of-offset 216
                    :arena-enter-offset 224 :arena-leave-offset 232
                    :string-compare-offset 240 :string-fold-ascii-offset 248
                    :string-find-blank-offset 256 :string-skip-blank-offset 264
                    :string-index-of-from-offset 272 :string-compare-lines-offset 280
                    :pair-used-pointer-offset 288 :pairs-base-offset 296
                    :pair-validated-base-offset 304
                    :vector-used-pointer-offset 312 :vectors-base-offset 320
                    :vector-items-base-offset 328
                    :string-find-byte-offset 336 :string-append-range-offset 344
                    :string-from-utf8-offset 352 :bytes-from-vector-offset 360
                    :bytes-slice-offset 368 :bytes-concat-offset 376
                    :vector-capacity 4096
                    :vector-item-capacity 65536}
                          context-abi-overrides)
      :effects (:effects program)
      :compatibility
      (compatibility/descriptor
       {:hir-format (if (= :kotoba.kir/v4 (:format program))
                      :kotoba.hir/v3 :kotoba.hir/v2)
        :kir-format (:format program)
        :target :x86_64-kotoba-v1 :target-profile profile
        :value-abi (if (= :kotoba.kir/v4 (:format program))
                     :kotoba.typed/externref-v1 :kotoba.i64/direct-v1)})
      :limits {:memory-bytes 65536 :fuel fuel :stack-bytes 4096}
      :code (mapv #(bit-and (int %) 0xff) (:code emitted))
      :program program
      :exports (:exports emitted)})))

(def v0 {:gas-schedule/id :kotoba.gas/v0-draft :gas-schedule/version 0
         :call 1 :default 1 :weights {}})

(def unmetered
  {:format :kotoba.kir/v3 :entry 'main :exports ['main]
   :signature {:params [] :result :i64} :effects #{}
   :functions [{:name 'main :params [] :result :i64 :effects #{}
                :body '(+ 1 (* 2 3))}]})

(def metered (assoc unmetered :gas-schedule v0))

(def v12 {:version 12 :gas-offset 384})

(defn- refusal [artifact]
  (try (verifier/verify-artifact! artifact) :admitted
       (catch #?(:clj Exception :cljs :default) e (ex-message e))))

;; kotoba-native's charge-gas refuses a schedule it cannot price by -- or a
;; bigint one -- while EMITTING, so a bad schedule cannot reach this verifier
;; by being compiled. It can reach it by being written into a sealed program
;; afterwards, which is what these cases do: build from a good program, then
;; replace the program's schedule and reseal.
(defn- with-program-schedule
  "The artifact with its program's schedule replaced, its program identity
  (:kir-sha256) recomputed to match, and resealed -- so the refusal under test
  is the verifier's verdict on the schedule, not an identity mismatch."
  [artifact schedule]
  (let [program (assoc (:program artifact) :gas-schedule schedule)]
    (artifact/seal (assoc artifact :program program :kir-sha256 (artifact/sha256 program)))))

(deftest a-metered-program-is-admitted-at-v12-and-only-there
  (is (= :admitted (refusal (native-artifact metered v12))))
  (is (re-find #"execution context ABI is not admitted"
               (str (refusal (native-artifact metered {}))))
      "its code would decrement host state at 384 on a v11 loader"))

(deftest an-unmetered-program-stays-v11
  (is (= :admitted (refusal (native-artifact unmetered {}))))
  (is (re-find #"execution context ABI is not admitted"
               (str (refusal (native-artifact unmetered v12))))))

(deftest the-schedule-and-the-code-cannot-disagree
  (testing "code charged by one schedule, program naming another"
    ;; `+` is a head this program evaluates, so its weight is in the code (the
    ;; debit's immediate); a :call weight would not be -- the program calls
    ;; no function -- and that schedule would rightly be admitted.
    (is (not= :admitted (refusal (with-program-schedule (native-artifact metered v12)
                                                        (assoc v0 :weights {'+ 5}))))))
  (testing "a metered program whose code carries no debits"
    (is (not= :admitted (refusal (with-program-schedule (native-artifact unmetered v12) v0))))))

(deftest a-schedule-the-program-could-not-be-priced-by-is-refused
  (doseq [bad [(assoc v0 :default 0) (assoc v0 :call 0) (dissoc v0 :gas-schedule/id)
               (assoc v0 :weights {'+ -1})]]
    (is (re-find #"module shape"
                 (str (refusal (with-program-schedule (native-artifact metered v12) bad))))
        (pr-str bad))))

#?(:cljs
   (deftest a-schedule-read-back-as-bigints-is-not-a-shape-error
     ;; A sealed artifact read back from disk carries every integer as a
     ;; JavaScript bigint (measured 2026-10-09 through `amu extract-native`).
     ;; Such a schedule is admitted -- the verifier narrows it for re-emission
     ;; -- and a bigint 0 default is still a shape refusal.
     (let [big (-> v0
                   (update :default js/BigInt) (update :call js/BigInt)
                   (update :gas-schedule/version js/BigInt))]
       (is (= :admitted (refusal (with-program-schedule (native-artifact metered v12) big))))
       (is (re-find #"module shape"
                    (str (refusal (with-program-schedule (native-artifact metered v12)
                                                         (assoc big :default (js/BigInt 0))))))
           "a bigint still has to be positive"))))
