(ns kotoba.verifier-document-operations-test
  "Native `:document` operations pass runtime KIR verification (gap 2 of the
  selfhost foundation, superproject adr-2609242330): kotoba-native lowers them
  onto the string slots and its emitted document helpers
  (`kotoba.native.document`), and this verifier re-derives its own table of
  them rather than reading the backend's.

  Pinned: every lowered operation verifies at its arity; a wrong arity is
  refused by the arity message (not the terminal one, so the test fails if
  the table is removed); the operations native does not lower -- f64, the
  digest, the hex codec -- are refused as unknown."
  (:require [kotoba.lang.error :as kerror] [kotoba.test :refer [deftest is testing]]
            [kotoba.verifier]))

(defn- program [body]
  {:format :kotoba.kir/v3 :entry 'main :exports ['main]
   :signature {:params [] :result :i64} :effects #{}
   :functions [{:name 'main :params [] :result :i64 :effects #{}
                :body (list 'let ['d body] 0)}]})

(defn- rejection [body]
  (try (#'kotoba.verifier/verify-program! (program body)) nil
       (catch kerror/ExceptionInfo e (ex-message e))))

(def ^:private m '(document-map :a (document-i64 1)))
(def ^:private v '(document-vector (document-i64 1)))
(def ^:private bs '(bytes-from-vector-i64 (vector-new 1 2)))

(deftest the-lowered-document-operations-verify
  (doseq [body ['(document-null) '(document-bool true) '(document-string "s")
                '(document-keyword :k) v '(document-list) '(document-set (document-i64 1)) m
                (list 'document-count m) (list 'document-kind v) (list 'document-equal? m m)
                (list 'document-get m :a) (list 'document-contains m :a)
                (list 'document-vector-at v 0) (list 'document-map-entry-at m 0)
                (list 'document-vector-conj v '(document-null))
                (list 'document-vector-drop v 1) (list 'document-vector-sort v)
                (list 'document-assoc m :b '(document-null)) (list 'document-dissoc m :a)
                (list 'document-merge m m) '(document-i64-value (document-i64 1))
                (list 'document-edn-print m)
                ;; :bytes and :link (root ADR-2610092310 S4)
                (list 'document-bytes bs)
                (list 'option-value-of [:option :bytes]
                      (list 'document-bytes-value (list 'document-bytes bs)) '(bytes-empty))
                (list 'document-link bs)
                (list 'option-value-of [:option :bytes]
                      (list 'document-link-value (list 'document-bytes bs)) '(bytes-empty))]]
    (testing (pr-str body)
      (is (nil? (rejection body))))))

(deftest the-bytes-and-link-operations-have-arity-one
  (doseq [body ['(document-bytes) '(document-link) '(document-bytes-value)
                (list 'document-link-value '(document-null) '(document-null))]]
    (testing (pr-str body)
      (is (= "runtime KIR document operation arity rejected" (rejection body))))))

(deftest a-wrong-arity-is-refused-by-the-arity-check
  (doseq [body ['(document-map :a) '(document-count) '(document-get (document-null))
                '(document-merge) '(document-null (document-null))]]
    (testing (pr-str body)
      (is (= "runtime KIR document operation arity rejected" (rejection body))))))

(deftest what-native-does-not-lower-is-refused
  (doseq [body ['(document-f64 1) '(document-f64-value (document-null))
                '(document-sha256 (document-null)) '(document-print (document-null))
                '(document-read "6e")]]
    (testing (pr-str body)
      (is (= "runtime KIR operation rejected" (rejection body))))))
