(ns native.kexe-compatibility.probe
  {:kotoba/export [main]}
  (:require [kotoba.kir.compatibility :as compatibility]
            [kotoba.verifier.artifact-envelope :as verifier]))

(defn descriptor-field [descriptor [:map :keyword :document] key :keyword] :document
  (option-value-of [:option :document]
    (typed-map-get [:map :keyword :document] descriptor key)
    (document-null)))

(defn compatibility-document [kir-format :document hir-format :document
                              target :document profile :document value-abi :document] :document
  (let [descriptor
        (compatibility/descriptor
          (document-map :kir-format kir-format :hir-format hir-format
                        :target target :target-profile profile :value-abi value-abi))]
    (document-map
      :format (descriptor-field descriptor :format)
      :compiler (descriptor-field descriptor :compiler)
      :language (descriptor-field descriptor :language)
      :hir (descriptor-field descriptor :hir)
      :kir (descriptor-field descriptor :kir)
      :target (descriptor-field descriptor :target)
      :runtime (descriptor-field descriptor :runtime)
      :value-abi (descriptor-field descriptor :value-abi)
      :tender-role (descriptor-field descriptor :tender-role)
      :tender-contract (descriptor-field descriptor :tender-contract))))

(defn kexe [kir-format :document target :document profile :document
            value-abi :document compatibility :document] :document
  (document-map
    :program (document-map :format kir-format)
    :target target
    :target-profile profile
    :compatibility compatibility))

(defn main [] :i64
  (let [kir-v4 (document-keyword :kotoba.kir/v4)
        hir-v3 (document-keyword :kotoba.hir/v3)
        target (document-keyword :aarch64-kotoba-v1)
        profile (document-map :runtime (document-keyword :normal)
                              :execution (document-keyword :native))
        abi (document-keyword :kotoba.typed/externref-v1)
        expected (compatibility-document kir-v4 hir-v3 target profile abi)
        valid (kexe kir-v4 target profile abi expected)
        wrong-profile (document-assoc valid :target-profile
                        (document-map :runtime (document-keyword :normal)
                                      :execution (document-keyword :javascript)))
        wrong-abi (document-assoc valid :compatibility
                    (document-assoc expected :value-abi (document-keyword :kotoba.i64/direct-v1)))
        wrong-hir (document-assoc valid :compatibility
                    (document-assoc expected :hir (document-keyword :kotoba.hir/v2)))
        extra-field (document-assoc valid :compatibility
                      (document-assoc expected :extra (document-bool true)))
        bad-tender (document-assoc valid :compatibility
                     (document-assoc expected :tender-contract (document-keyword :kotoba.cljs-host/v1)))
        kir-v3 (document-keyword :kotoba.kir/v3)
        hir-v2 (document-keyword :kotoba.hir/v2)
        word-abi (document-keyword :kotoba.i64/direct-v1)
        legacy-profile (document-map :runtime (document-keyword :normal)
                                     :execution (document-keyword :process))
        legacy-expected (compatibility-document kir-v3 hir-v2 target legacy-profile word-abi)
        legacy (kexe kir-v3 target legacy-profile word-abi legacy-expected)]
    (if (and (verifier/kexe-compatibility-match? valid abi)
             (verifier/kexe-compatibility-match? legacy word-abi)
             (not (verifier/kexe-compatibility-match? wrong-profile abi))
             (not (verifier/kexe-compatibility-match? wrong-abi abi))
             (not (verifier/kexe-compatibility-match? wrong-hir abi))
             (not (verifier/kexe-compatibility-match? extra-field abi))
             (not (verifier/kexe-compatibility-match? bad-tender abi)))
      0
      1)))
