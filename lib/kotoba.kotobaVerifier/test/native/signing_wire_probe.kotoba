(ns native.signing.probe {:kotoba/export [main]}
  (:require [kotoba.verifier.native-signing :as signing]))

(defn main [] :i64
  (let [public-key "MCowBQYDK2VwAyEA11qYAYKxCrfVS/7TyWQHOg7hcvPapiMlrwIaaPcHURo="
        signature "NWtFq7A1u5aKmlc+lsrX2EjCPAN2pPeIIIwGrWkMYMtudw4ZakJ8L6zKXS1UXwG8EKPYt9EUKIL4K/NFIq2oBQ=="
        changed-signature "MWtFq7A1u5aKmlc+lsrX2EjCPAN2pPeIIIwGrWkMYMtudw4ZakJ8L6zKXS1UXwG8EKPYt9EUKIL4K/NFIq2oBQ=="
        malformed-spki "MCowBQYDK2VxAyEA11qYAYKxCrfVS/7TyWQHOg7hcvPapiMlrwIaaPcHURo="
        unpadded-spki "MCowBQYDK2VwAyEA11qYAYKxCrfVS/7TyWQHOg7hcvPapiMlrwIaaPcHURo"
        value (document-string "hello")]
    (if (and (signing/valid-verification-key? public-key)
             (= (signing/signer-id public-key)
                "3da1e77060352b1343f12d9433bb6df0a47f1df386c9c42b161b51c921c29908")
             (signing/verify-value public-key value signature)
             (not (signing/verify-value public-key value changed-signature))
             (not (signing/verify-value public-key value "!!"))
             (not (signing/verify-value public-key value "AA=="))
             (not (signing/valid-verification-key? unpadded-spki))
             (not (signing/valid-verification-key? malformed-spki))
             (not (signing/verify-value malformed-spki value signature)))
      0
      1)))
