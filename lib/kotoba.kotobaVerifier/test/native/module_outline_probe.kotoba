(ns native.module-outline.probe
  {:kotoba/export [main]}
  (:require [kotoba.verifier.artifact-envelope :as verifier]))

(defn function-record [name :symbol params :document] :document
  (document-map :name (document-symbol name) :params params))

(defn entry-module [kir-format :document] :document
  (document-map
    :format kir-format
    :entry (document-symbol (symbol "main"))
    :exports (document-vector)
    :signature (document-map :params (document-vector) :result (document-keyword :i64))
    :effects (document-set)
    :functions (document-vector (function-record (symbol "main") (document-vector)))))

(defn library-module [kir-format :document] :document
  (document-map
    :format kir-format
    :exports (document-vector (document-symbol (symbol "lookup")))
    :effects (document-set)
    :functions (document-vector (function-record (symbol "lookup") (document-vector)))))

(defn typed-function-record [name :symbol params :document result :document param-types :document] :document
  (document-assoc
    (document-assoc (function-record name params) :result result)
    :param-types param-types))

(defn boundary-module [functions :document exports :document] :document
  (document-assoc
    (document-assoc (entry-module (document-keyword :kotoba.kir/v4)) :functions functions)
    :exports exports))

(defn effect-module [effects :document] :document
  (let [main-function (document-assoc
                        (typed-function-record (symbol "main") (document-vector)
                          (document-keyword :i64) (document-vector))
                        :effects (document-set))
        worker (document-assoc
                 (typed-function-record (symbol "worker") (document-vector)
                   (document-keyword :i64) (document-vector))
                 :effects effects)]
    (boundary-module (document-vector main-function worker)
                     (document-vector (document-symbol (symbol "main"))
                                      (document-symbol (symbol "worker"))))))

(defn shaped-function [params :document param-types :document] :document
  (document-assoc
    (document-assoc
      (typed-function-record (symbol "main") params (document-keyword :i64) param-types)
      :effects (document-set))
    :body (document-i64 0)))

(defn one-function-module [function :document] :document
  (boundary-module (document-vector function)
                   (document-vector (document-symbol (symbol "main")))))


(defn main [] :i64
  (let [v3 (entry-module (document-keyword :kotoba.kir/v3))
        v4 (entry-module (document-keyword :kotoba.kir/v4))
        library (library-module (document-keyword :kotoba.kir/v4))
        bad-format (document-assoc v3 :format (document-keyword :kotoba.kir/v2))
        extra-key (document-assoc v3 :untrusted (document-bool true))
        wrong-entry (document-assoc v3 :entry (document-symbol (symbol "start")))
        parameterized-entry (document-assoc v3 :signature
                           (document-map :params (document-vector (document-keyword :i64))
                                         :result (document-keyword :i64)))
        missing-signature-field (document-assoc v3 :signature
                                 (document-map :params (document-vector)
                                               :extra (document-keyword :i64)))
        no-functions (document-assoc v3 :functions (document-vector))
        no-exports (document-assoc library :exports (document-vector))
        library-with-signature (document-assoc library :signature
                                  (document-map :params (document-vector)
                                                :result (document-keyword :i64)))
        non-symbol-export (document-assoc library :exports
                            (document-vector (document-string "lookup")))
        wrong-effects (document-assoc v3 :effects (document-vector))
        wrong-schemas (document-assoc v3 :schemas (document-vector))
        wrong-gas-schedule (document-assoc v3 :gas-schedule (document-string "open"))
        valid-entry (document-assoc v3 :exports
                       (document-vector (document-symbol (symbol "main"))))
        valid-library (library-module (document-keyword :kotoba.kir/v4))
        duplicate-functions (document-assoc valid-entry :functions
                             (document-vector
                               (function-record (symbol "main") (document-vector))
                               (function-record (symbol "main") (document-vector))))
        export-without-function (document-assoc valid-entry :functions
                                 (document-vector
                                   (function-record (symbol "helper") (document-vector))))
        duplicate-exports (document-assoc valid-library :exports
                            (document-vector (document-symbol (symbol "lookup"))
                                             (document-symbol (symbol "lookup"))))
        entry-with-parameters (document-assoc valid-entry :functions
                                (document-vector
                                  (function-record (symbol "main")
                                    (document-vector (document-symbol (symbol "arg"))))))
        missing-main (document-assoc valid-entry :functions
                       (document-vector
                         (function-record (symbol "helper") (document-vector))))
        malformed-function-name (document-assoc valid-entry :functions
                                  (document-vector
                                    (document-map :name (document-string "main")
                                                  :params (document-vector))))
        boundary-main (typed-function-record (symbol "main") (document-vector)
                                                       (document-keyword :i64)
                                                       (document-vector))
        valid-boundary (typed-function-record (symbol "echo")
                         (document-vector (document-symbol (symbol "x")))
                         (document-keyword :bool)
                         (document-vector (document-keyword :bool)))
        valid-word-value (typed-function-record (symbol "word")
                            (document-vector (document-symbol (symbol "x")))
                            (document-vector (document-keyword :option) (document-keyword :i64))
                            (document-vector (document-vector (document-keyword :option)
                                                              (document-keyword :bool))))
        valid-f64-boundary (typed-function-record (symbol "float")
                               (document-vector (document-symbol (symbol "x")))
                               (document-keyword :i64)
                               (document-vector (document-keyword :f64)))
        valid-exported-codec (typed-function-record (symbol "codec")
                                 (document-vector (document-symbol (symbol "x")))
                                 (document-keyword :i64)
                                 (document-vector (document-keyword :vector-i64)))
        valid-record (typed-function-record (symbol "record")
                        (document-vector (document-symbol (symbol "x")))
                        (document-keyword :i64)
                        (document-vector
                          (document-vector (document-keyword :record)
                                           (document-keyword :probe/point)
                                           (document-vector
                                             (document-vector (document-keyword :x) (document-keyword :i64))
                                             (document-vector (document-keyword :label) (document-keyword :string))))))
        invalid-unqualified-ref (typed-function-record (symbol "bad-ref")
                                  (document-vector (document-symbol (symbol "x")))
                                  (document-keyword :i64)
                                  (document-vector
                                    (document-vector (document-keyword :ref) (document-keyword :plain))))
        invalid-f32-param (typed-function-record (symbol "bad-f32")
                             (document-vector (document-symbol (symbol "x")))
                             (document-keyword :i64)
                             (document-vector (document-keyword :f32)))
        bad-f32-param-types
        (option-value-of [:option :document]
          (document-get invalid-f32-param (document-keyword :param-types)) (document-null))
        bad-f32-param-kind (document-kind bad-f32-param-types)
        bad-f32-param-count (document-count bad-f32-param-types)
        bad-f32-param-value
        (option-value-of [:option :document] (document-vector-at bad-f32-param-types 0)
                         (document-null))
        valid-internal-handle (typed-function-record (symbol "internal")
                                (document-vector (document-symbol (symbol "x")))
                                (document-keyword :i64)
                                (document-vector (document-keyword :vector-i64)))
        valid-exported-copy (typed-function-record (symbol "copy") (document-vector)
                              (document-keyword :vector-i64) (document-vector))
        invalid-exported-handle (typed-function-record (symbol "bad-handle")
                                   (document-vector (document-symbol (symbol "x")))
                                   (document-keyword :i64)
                                   (document-vector (document-keyword :vector-f64)))
        bad-ref-module (boundary-module (document-vector boundary-main invalid-unqualified-ref)
                                        (document-vector (document-symbol (symbol "main"))
                                                          (document-symbol (symbol "bad-ref"))))
        bad-f32-module (boundary-module (document-vector boundary-main invalid-f32-param)
                                        (document-vector (document-symbol (symbol "main"))
                                                          (document-symbol (symbol "bad-f32"))))
        internal-module (boundary-module (document-vector boundary-main valid-internal-handle)
                                         (document-vector (document-symbol (symbol "main"))))
        export-copy-module (boundary-module (document-vector boundary-main valid-exported-copy)
                                            (document-vector (document-symbol (symbol "main"))
                                                               (document-symbol (symbol "copy"))))
        bad-handle-module (boundary-module (document-vector boundary-main invalid-exported-handle)
                                           (document-vector (document-symbol (symbol "main"))
                                                           (document-symbol (symbol "bad-handle"))))
        valid-effects-module (effect-module
          (document-set (document-keyword :state) (document-keyword :abort)
                        (document-vector (document-keyword :cap/call) (document-i64 0))
                        (document-vector (document-keyword :cap/call) (document-i64 255))))
        invalid-effect-modules (document-vector
          (effect-module (document-set (document-keyword :unknown)))
          (effect-module (document-set (document-vector (document-keyword :cap/call) (document-i64 -1))))
          (effect-module (document-set (document-vector (document-keyword :cap/call) (document-i64 256))))
          (effect-module (document-set (document-vector (document-keyword :cap/call) (document-keyword :not-i64))))
          (effect-module (document-set (document-vector (document-keyword :cap/call))))
          (effect-module (document-set (document-vector (document-keyword :cap/call) (document-i64 1) (document-i64 2)))))
        two-params (document-vector (document-symbol (symbol "left"))
                                    (document-symbol (symbol "right")))
        two-i64-types (document-vector (document-keyword :i64) (document-keyword :i64))
        valid-shape-function (document-assoc
          (document-assoc (shaped-function two-params two-i64-types)
            :closure-param-indexes (document-vector (document-i64 0)))
          :i64-pair-chain-param-indexes (document-vector (document-i64 1)))
        valid-shape-module (one-function-module valid-shape-function)
        invalid-shape-modules (document-vector
          (one-function-module (document-assoc valid-shape-function :untrusted (document-bool true)))
          (one-function-module (document-dissoc valid-shape-function :body))
          (one-function-module (document-assoc valid-shape-function :closure-param-indexes
                                (document-vector (document-i64 1) (document-i64 0))))
          (one-function-module (document-assoc valid-shape-function :closure-param-indexes
                                (document-vector (document-i64 2))))
          (one-function-module (document-assoc valid-shape-function :i64-pair-chain-param-indexes
                                (document-vector (document-i64 0))))
          (one-function-module (document-assoc valid-shape-function :i64-pair-chain-param-indexes
                                (document-vector (document-i64 1) (document-i64 1))))
          (one-function-module (document-assoc valid-shape-function :closure-result? (document-bool false)))
          (one-function-module (document-assoc valid-shape-function :name
                                (document-symbol (symbol "pkg/main"))))
          (one-function-module (document-assoc valid-shape-function :name
                                (document-symbol (symbol "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"))))
          (one-function-module (document-dissoc valid-shape-function :effects)))
        valid-boundary-module
        (boundary-module (document-vector boundary-main valid-boundary valid-word-value valid-record
                                          valid-f64-boundary valid-exported-codec)
                         (document-vector (document-symbol (symbol "main"))
                                          (document-symbol (symbol "echo"))
                                          (document-symbol (symbol "word"))
                                          (document-symbol (symbol "record"))
                                          (document-symbol (symbol "float"))
                                          (document-symbol (symbol "codec"))))]
    (cond
      (not (verifier/kexe-module-outline? v3)) 1
      (not (verifier/kexe-module-outline? v4)) 2
      (not (verifier/kexe-module-outline? library)) 3
      (verifier/kexe-module-outline? (document-string "not a module")) 4
      (verifier/kexe-module-outline? bad-format) 5
      (verifier/kexe-module-outline? extra-key) 6
      (verifier/kexe-module-outline? wrong-entry) 7
      (verifier/kexe-module-outline? parameterized-entry) 8
      (verifier/kexe-module-outline? missing-signature-field) 9
      (verifier/kexe-module-outline? no-functions) 10
      (verifier/kexe-module-outline? no-exports) 11
      (verifier/kexe-module-outline? library-with-signature) 12
      (verifier/kexe-module-outline? non-symbol-export) 13
      (verifier/kexe-module-outline? wrong-effects) 14
      (verifier/kexe-module-outline? wrong-schemas) 15
      (verifier/kexe-module-outline? wrong-gas-schedule) 16
      (not (verifier/kexe-function-identities-match? valid-entry)) 17
      (not (verifier/kexe-function-identities-match? valid-library)) 18
      (verifier/kexe-function-identities-match? duplicate-functions) 19
      (verifier/kexe-function-identities-match? export-without-function) 20
      (verifier/kexe-function-identities-match? duplicate-exports) 21
      (verifier/kexe-function-identities-match? entry-with-parameters) 22
      (verifier/kexe-function-identities-match? missing-main) 23
      (verifier/kexe-function-identities-match? malformed-function-name) 24
      (not (verifier/kexe-function-boundaries-valid? valid-boundary-module)) 25
      (verifier/kexe-function-boundaries-valid? bad-ref-module) 26
      (verifier/kexe-function-boundaries-valid? bad-f32-module) 27
      (not (verifier/kexe-function-boundaries-valid? internal-module)) 28
      (not (verifier/kexe-function-boundaries-valid? export-copy-module)) 29
      (verifier/kexe-function-boundaries-valid? bad-handle-module) 30
      (not (verifier/kexe-function-effects-valid? valid-effects-module)) 35
      (loop [index 0]
        (if (= index (document-count invalid-effect-modules)) false
          (or (verifier/kexe-function-effects-valid?
                (option-value-of [:option :document]
                  (document-vector-at invalid-effect-modules index) (document-null)))
              (recur (+ index 1))))) 36
      (not (verifier/kexe-function-record-shapes-valid? valid-shape-module)) 37
      (loop [index 0]
        (if (= index (document-count invalid-shape-modules)) false
          (or (verifier/kexe-function-record-shapes-valid?
                (option-value-of [:option :document]
                  (document-vector-at invalid-shape-modules index) (document-null)))
              (recur (+ index 1))))) 38
      :else 0)))
