(ns native.compatibility.probe
  {:kotoba/export [main]}
  (:require [kotoba.kir.compatibility :as compatibility]))

(defn tender-contract [runtime :document execution :document] :document
  (let [descriptor
        (compatibility/descriptor
          (document-map
            :hir-format (document-keyword :kotoba.hir/v3)
            :kir-format (document-keyword :kotoba.kir/v4)
            :target (document-keyword :aarch64-kotoba-v1)
            :target-profile (document-map :runtime runtime :execution execution)
            :value-abi (document-keyword :kotoba.typed/externref-v1)))]
    (option-value-of [:option :document]
      (typed-map-get [:map :keyword :document] descriptor :tender-contract)
      (document-null))))

(defn main [] :i64
  (let [descriptor
        (compatibility/descriptor
          (document-map
            :hir-format (document-keyword :kotoba.hir/v3)
            :kir-format (document-keyword :kotoba.kir/v4)
            :target (document-keyword :aarch64-kotoba-v1)
            :target-profile (document-map :runtime (document-keyword :normal)
                                          :execution (document-keyword :native))
            :value-abi (document-keyword :kotoba.typed/externref-v1)))
        native-contract (option-value-of [:option :document]
                         (typed-map-get [:map :keyword :document] descriptor :tender-contract)
                         (document-null))]
    (if (and (= (compatibility/schema) :kotoba.compatibility/v1)
             (= (compatibility/compiler-version) "kotoba-compiler/1")
             (= (compatibility/language-version) :kotoba.language/safe-v1)
             (= (compatibility/tender-role) :kototama/component-tender-v1)
             (document-equal? native-contract (document-keyword :kotoba.supervisor/v1))
             (document-equal? (tender-contract (document-keyword :kotoba-linux-static-prelude-v1)
                                               (document-keyword :native))
                              (document-keyword :kotoba.linux-static/v1))
             (document-equal? (tender-contract (document-keyword :normal) (document-keyword :javascript)) (document-keyword :kotoba.restricted-esm/v1))
             (document-equal? (tender-contract (document-keyword :normal) (document-keyword :wasm)) (document-keyword :kotoba.capability-host/v1))
             (document-equal? (tender-contract (document-keyword :normal) (document-keyword :process)) (document-keyword :kotoba.aiueos-process/v1))
             (document-equal? (tender-contract (document-keyword :normal) (document-keyword :kernel)) (document-keyword :kotoba.aiueos-kernel/v1))
             (document-equal? (tender-contract (document-keyword :normal) (document-keyword :firmware)) (document-keyword :kotoba.aiueos-firmware/v1))
             (document-equal? (tender-contract (document-keyword :normal) (document-keyword :cljs)) (document-keyword :kotoba.cljs-host/v1))
             (document-equal? (tender-contract (document-keyword :normal) (document-keyword :other)) (document-keyword :kotoba.unsupported/v1)))
      0
      1)))
