(ns native.module-outline.resource-bounds
  {:kotoba/export [main]}
  (:require [kotoba.verifier.artifact-envelope :as verifier]))

(defn ascii-bytes [doublings :i64] :string
  (loop [text "a" index 0]
    (if (= index doublings) text
      (recur (string-concat text text) (+ index 1)))))

(defn function-record [body :document] :document
  (document-assoc
    (document-assoc
      (document-assoc
        (document-map :name (document-symbol (symbol "main"))
                      :params (document-vector))
        :result (document-keyword :i64))
      :param-types (document-vector))
    :body body))

(defn program-of [body :document] :document
  (document-map
    :format (document-keyword :kotoba.kir/v4)
    :entry (document-symbol (symbol "main"))
    :exports (document-vector (document-symbol (symbol "main")))
    :signature (document-map :params (document-vector) :result (document-keyword :i64))
    :effects (document-set)
    :functions (document-vector
      (document-assoc (function-record body) :effects (document-set)))))

(defn main [] :i64
  (let [at-limit (program-of (document-string (ascii-bytes 16)))
        over-limit (program-of
          (document-string (string-concat (ascii-bytes 16) "a")))
        valid-add (program-of
          (document-list (document-symbol (symbol "+"))
                         (document-i64 1) (document-i64 2) (document-i64 3)))
        valid-quot (program-of
          (document-list (document-symbol (symbol "quot"))
                         (document-i64 8) (document-i64 2)))
        valid-compare (program-of
          (document-list (document-symbol (symbol ">="))
                         (document-i64 2) (document-i64 1)))
        valid-bool-not (program-of
          (document-list (document-symbol (symbol "bool-not"))
                         (document-bool true)))
        valid-bit-or (program-of
          (document-list (document-symbol (symbol "bit-or"))
                         (document-i64 1) (document-i64 2)))
        valid-i64-shift (program-of
          (document-list (document-symbol (symbol "i64-shift-left"))
                         (document-i64 1) (document-i64 63)))
        valid-i32-shift (program-of
          (document-list (document-symbol (symbol "u32-shift-right"))
                         (document-i64 1) (document-i64 31)))
        valid-i32-add (program-of
          (document-list (document-symbol (symbol "i32-wrapping-add"))
                         (document-i64 1) (document-i64 2)))
        over-i64-shift (program-of
          (document-list (document-symbol (symbol "u64-shift-right"))
                         (document-i64 1) (document-i64 64)))
        over-i32-shift (program-of
          (document-list (document-symbol (symbol "i32-shift-left"))
                         (document-i64 1) (document-i64 32)))
        dynamic-i64-shift (program-of
          (document-list (document-symbol (symbol "i64-shift-right"))
                         (document-i64 1) (document-symbol (symbol "count"))))
        valid-f64-min (program-of
          (document-list (document-symbol (symbol "f64-min"))
                         (document-i64 1) (document-i64 2)))
        valid-f32-sqrt (program-of
          (document-list (document-symbol (symbol "f32-sqrt")) (document-i64 4)))
        valid-float-convert (program-of
          (document-list (document-symbol (symbol "f64-to-f32-rounded")) (document-i64 4)))
        unary-f64-add (program-of
          (document-list (document-symbol (symbol "f64-add")) (document-i64 4)))
        binary-f32-sqrt (program-of
          (document-list (document-symbol (symbol "f32-sqrt"))
                         (document-i64 4) (document-i64 9)))
        zero-f32-convert (program-of
          (document-list (document-symbol (symbol "f32-to-f64-exact"))))
        valid-option-none (program-of
          (document-list (document-symbol (symbol "option-none"))))
        valid-option-value (program-of
          (document-list (document-symbol (symbol "option-value"))
                         (document-i64 1) (document-i64 0)))
        valid-result-err (program-of
          (document-list (document-symbol (symbol "result-err")) (document-i64 1)))
        valid-result-error (program-of
          (document-list (document-symbol (symbol "result-error"))
                         (document-i64 1) (document-i64 0)))
        unary-option-value (program-of
          (document-list (document-symbol (symbol "option-value")) (document-i64 1)))
        unary-result-error (program-of
          (document-list (document-symbol (symbol "result-error")) (document-i64 1)))
        nonzero-option-none (program-of
          (document-list (document-symbol (symbol "option-none")) (document-i64 1)))
        zero-result-ok (program-of
          (document-list (document-symbol (symbol "result-ok"))))
        valid-pair (program-of
          (document-list (document-symbol (symbol "pair"))
                         (document-i64 1) (document-i64 2)))
        valid-pair-first (program-of
          (document-list (document-symbol (symbol "pair-first")) (document-i64 1)))
        valid-pair-second (program-of
          (document-list (document-symbol (symbol "pair-second")) (document-i64 1)))
        unary-pair (program-of
          (document-list (document-symbol (symbol "pair")) (document-i64 1)))
        binary-pair-first (program-of
          (document-list (document-symbol (symbol "pair-first"))
                         (document-i64 1) (document-i64 2)))
        zero-pair-second (program-of
          (document-list (document-symbol (symbol "pair-second"))))
        zero-add (program-of
          (document-list (document-symbol (symbol "+"))))
        unary-quot (program-of
          (document-list (document-symbol (symbol "quot")) (document-i64 8)))
        unary-bit-xor (program-of
          (document-list (document-symbol (symbol "bit-xor")) (document-i64 8)))
        ternary-compare (program-of
          (document-list (document-symbol (symbol "<"))
                         (document-i64 1) (document-i64 2) (document-i64 3)))
        binary-bool-not (program-of
          (document-list (document-symbol (symbol "bool-not"))
                         (document-i64 1) (document-i64 0)))]
    (cond
      (not (verifier/kexe-function-effects-match? at-limit)) 1
      (verifier/kexe-function-effects-match? over-limit) 2
      (not (verifier/kexe-function-bodies-resource-valid? at-limit)) 3
      (verifier/kexe-function-bodies-resource-valid? over-limit) 4
      (not (verifier/kexe-function-effects-match? valid-add)) 5
      (not (verifier/kexe-function-effects-match? valid-quot)) 6
      (not (verifier/kexe-function-effects-match? valid-compare)) 7
      (not (verifier/kexe-function-effects-match? valid-bool-not)) 8
      (not (verifier/kexe-function-effects-match? valid-bit-or)) 9
      (not (verifier/kexe-function-effects-match? valid-i64-shift)) 10
      (not (verifier/kexe-function-effects-match? valid-i32-shift)) 11
      (not (verifier/kexe-function-effects-match? valid-i32-add)) 12
      (verifier/kexe-function-effects-match? over-i64-shift) 13
      (verifier/kexe-function-effects-match? over-i32-shift) 14
      (verifier/kexe-function-effects-match? dynamic-i64-shift) 15
      (not (verifier/kexe-function-effects-match? valid-f64-min)) 16
      (not (verifier/kexe-function-effects-match? valid-f32-sqrt)) 17
      (not (verifier/kexe-function-effects-match? valid-float-convert)) 18
      (verifier/kexe-function-effects-match? unary-f64-add) 19
      (verifier/kexe-function-effects-match? binary-f32-sqrt) 20
      (verifier/kexe-function-effects-match? zero-f32-convert) 21
      (verifier/kexe-function-core-operations-valid? zero-add) 22
      (verifier/kexe-function-core-operations-valid? unary-quot) 23
      (verifier/kexe-function-core-operations-valid? unary-bit-xor) 24
      (verifier/kexe-function-effects-match? ternary-compare) 25
      (verifier/kexe-function-effects-match? binary-bool-not) 26
      (not (verifier/kexe-function-effects-match? valid-option-none)) 27
      (not (verifier/kexe-function-effects-match? valid-option-value)) 28
      (not (verifier/kexe-function-effects-match? valid-result-err)) 29
      (not (verifier/kexe-function-effects-match? valid-result-error)) 30
      (verifier/kexe-function-effects-match? unary-option-value) 31
      (verifier/kexe-function-effects-match? unary-result-error) 32
      (verifier/kexe-function-effects-match? nonzero-option-none) 33
      (verifier/kexe-function-effects-match? zero-result-ok) 34
      (not (verifier/kexe-function-effects-match? valid-pair)) 35
      (not (verifier/kexe-function-effects-match? valid-pair-first)) 36
      (not (verifier/kexe-function-effects-match? valid-pair-second)) 37
      (verifier/kexe-function-effects-match? unary-pair) 38
      (verifier/kexe-function-effects-match? binary-pair-first) 39
      (verifier/kexe-function-effects-match? zero-pair-second) 40
      :else 0)))
