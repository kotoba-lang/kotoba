(ns native.module-outline.resource-bounds
  {:kotoba/export [main]}
  (:require [kotoba.verifier.artifact-envelope :as verifier]))

(defn ascii-bytes [doublings :i64] :string
  (loop [text "a" index 0]
    (if (= index doublings) text
      (recur (string-concat text text) (+ index 1)))))

(defn function-record [body :document] :document
  (document-assoc
    (document-assoc
      (document-assoc
        (document-map :name (document-symbol (symbol "main"))
                      :params (document-vector))
        :result (document-keyword :i64))
      :param-types (document-vector))
    :body body))

(defn program-of [body :document] :document
  (document-map
    :format (document-keyword :kotoba.kir/v4)
    :entry (document-symbol (symbol "main"))
    :exports (document-vector (document-symbol (symbol "main")))
    :signature (document-map :params (document-vector) :result (document-keyword :i64))
    :effects (document-set)
    :functions (document-vector
      (document-assoc (function-record body) :effects (document-set)))))

(defn main [] :i64
  (let [at-limit (program-of (document-string (ascii-bytes 16)))
        over-limit (program-of
          (document-string (string-concat (ascii-bytes 16) "a")))
        valid-add (program-of
          (document-list (document-symbol (symbol "+"))
                         (document-i64 1) (document-i64 2) (document-i64 3)))
        valid-quot (program-of
          (document-list (document-symbol (symbol "quot"))
                         (document-i64 8) (document-i64 2)))
        valid-compare (program-of
          (document-list (document-symbol (symbol ">="))
                         (document-i64 2) (document-i64 1)))
        valid-bool-not (program-of
          (document-list (document-symbol (symbol "bool-not"))
                         (document-bool true)))
        valid-bit-or (program-of
          (document-list (document-symbol (symbol "bit-or"))
                         (document-i64 1) (document-i64 2)))
        valid-i64-shift (program-of
          (document-list (document-symbol (symbol "i64-shift-left"))
                         (document-i64 1) (document-i64 63)))
        valid-i32-shift (program-of
          (document-list (document-symbol (symbol "u32-shift-right"))
                         (document-i64 1) (document-i64 31)))
        valid-i32-add (program-of
          (document-list (document-symbol (symbol "i32-wrapping-add"))
                         (document-i64 1) (document-i64 2)))
        over-i64-shift (program-of
          (document-list (document-symbol (symbol "u64-shift-right"))
                         (document-i64 1) (document-i64 64)))
        over-i32-shift (program-of
          (document-list (document-symbol (symbol "i32-shift-left"))
                         (document-i64 1) (document-i64 32)))
        dynamic-i64-shift (program-of
          (document-list (document-symbol (symbol "i64-shift-right"))
                         (document-i64 1) (document-symbol (symbol "count"))))
        zero-add (program-of
          (document-list (document-symbol (symbol "+"))))
        unary-quot (program-of
          (document-list (document-symbol (symbol "quot")) (document-i64 8)))
        unary-bit-xor (program-of
          (document-list (document-symbol (symbol "bit-xor")) (document-i64 8)))
        ternary-compare (program-of
          (document-list (document-symbol (symbol "<"))
                         (document-i64 1) (document-i64 2) (document-i64 3)))
        binary-bool-not (program-of
          (document-list (document-symbol (symbol "bool-not"))
                         (document-i64 1) (document-i64 0)))]
    (cond
      (not (verifier/kexe-function-effects-match? at-limit)) 1
      (verifier/kexe-function-effects-match? over-limit) 2
      (not (verifier/kexe-function-bodies-resource-valid? at-limit)) 3
      (verifier/kexe-function-bodies-resource-valid? over-limit) 4
      (not (verifier/kexe-function-effects-match? valid-add)) 5
      (not (verifier/kexe-function-effects-match? valid-quot)) 6
      (not (verifier/kexe-function-effects-match? valid-compare)) 7
      (not (verifier/kexe-function-effects-match? valid-bool-not)) 8
      (not (verifier/kexe-function-effects-match? valid-bit-or)) 9
      (not (verifier/kexe-function-effects-match? valid-i64-shift)) 10
      (not (verifier/kexe-function-effects-match? valid-i32-shift)) 11
      (not (verifier/kexe-function-effects-match? valid-i32-add)) 12
      (verifier/kexe-function-effects-match? over-i64-shift) 13
      (verifier/kexe-function-effects-match? over-i32-shift) 14
      (verifier/kexe-function-effects-match? dynamic-i64-shift) 15
      (verifier/kexe-function-core-operations-valid? zero-add) 16
      (verifier/kexe-function-core-operations-valid? unary-quot) 17
      (verifier/kexe-function-core-operations-valid? unary-bit-xor) 18
      (verifier/kexe-function-effects-match? ternary-compare) 19
      (verifier/kexe-function-effects-match? binary-bool-not) 20
      :else 0)))
