(ns native.float-usage.probe
  {:kotoba/export [main]}
  (:require [kotoba.kir.float-usage :as float-usage]))

(defn program [param-types :document result :document body :document] :document
  (document-map
    :functions
    (document-vector
      (document-map :param-types param-types :result result :body body))))

(defn main [] :i64
  (let [empty-types (document-vector)
        no-floats (program empty-types (document-keyword :i64)
                     (document-list (document-symbol (symbol "i64-add"))
                                    (document-i64 2) (document-i64 3)))
        f32-parameter (program (document-vector (document-keyword :f32))
                         (document-keyword :i64) (document-list))
        f64-result (program empty-types (document-keyword :f64) (document-list))
        f64-body (program empty-types (document-keyword :i64)
                    (document-list (document-symbol (symbol "f64-add"))
                                   (document-i64 1) (document-i64 2)))
        f32-conversion (program empty-types (document-keyword :i64)
                          (document-list (document-symbol (symbol "f64-to-f32-rounded"))
                                         (document-i64 1)))
        both-widths (program (document-vector (document-keyword :f64))
                       (document-keyword :i64)
                       (document-list (document-symbol (symbol "f32-add"))
                                      (document-i64 1) (document-i64 2)))
        nested (program empty-types (document-keyword :i64)
                  (document-map :nested
                    (document-vector
                      (document-list (document-symbol (symbol "f64-log-bounded"))
                                     (document-i64 1)))))
        unrelated-head (program empty-types (document-keyword :i64)
                          (document-list (document-symbol (symbol "call"))
                            (document-list (document-symbol (symbol "f32-sqrt"))
                                           (document-i64 1))))]
    (cond
      (not (= (float-usage/float-use-mask no-floats) 0)) 1
      (not (= (float-usage/float-use-mask f32-parameter) 1)) 2
      (not (= (float-usage/float-use-mask f64-result) 2)) 3
      (not (= (float-usage/float-use-mask f64-body) 2)) 4
      (not (= (float-usage/float-use-mask f32-conversion) 1)) 5
      (not (= (float-usage/float-use-mask both-widths) 3)) 6
      (not (= (float-usage/float-use-mask nested) 2)) 7
      (not (= (float-usage/float-use-mask unrelated-head) 1)) 8
      (float-usage/uses-f32? no-floats) 9
      (float-usage/uses-f64? no-floats) 10
      :else 0)))
