(ns native.artifact-envelope.probe
  {:kotoba/export [main]}
  (:require [kotoba.artifact.core :as artifact]
            [kotoba.verifier.artifact-envelope :as verifier]))

(defn main [] :i64
  (let [effects (document-set (document-keyword :state))
        program (document-map :effects effects)
        kexe (document-map
               :format (document-keyword :kotoba.kexe/v1)
               :target (document-keyword :x86_64-kotoba-v1)
               :target-profile (document-map)
               :value (document-i64 42)
               :kir-sha256 (document-string (artifact/sha256 program))
               :lowering (document-keyword :runtime-sysv-v1)
               :fuel-abi (document-map)
               :context-abi (document-map)
               :effects effects
               :limits (document-map :fuel (document-i64 100))
               :code (document-vector (document-i64 0) (document-i64 255))
               :program program
               :exports (document-map)
               :compatibility (document-map)
               :sha256 (document-string "seal"))
        abort-effects (document-set (document-keyword :abort))
        abort-kexe (document-assoc
                     (document-assoc kexe :effects abort-effects)
                     :program (document-map :effects abort-effects))
        empty-effects (document-set)
        empty-effects-kexe (document-assoc
                             (document-assoc kexe :effects empty-effects)
                             :program (document-map :effects empty-effects))
        cap-effects (document-set
                      (document-vector (document-keyword :cap/call) (document-i64 0))
                      (document-vector (document-keyword :cap/call) (document-i64 255)))
        cap-kexe (document-assoc
                   (document-assoc kexe :effects cap-effects)
                   :program (document-map :effects cap-effects))
        valid-oracle-kexe
          (document-assoc
            (document-assoc kexe :value (document-null))
            :oracle (document-map
                      :status (document-keyword :inconclusive)
                      :trap (document-keyword :budget/fuel)
                      :fuel (document-i64 100)))
        malformed-oracle-kexe (document-assoc kexe :oracle (document-map))]
    (let [sealed-kexe (artifact/seal (document-dissoc kexe :sha256))
          tampered-kexe (document-assoc sealed-kexe :target-profile (document-map :changed (document-bool true)))
          mismatched-kir-kexe
            (artifact/seal
              (document-assoc (document-dissoc sealed-kexe :sha256)
                :kir-sha256
                (document-string "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")))]
    (if (and (verifier/kexe-header-shape? kexe)
             (verifier/kexe-integrity? sealed-kexe)
             (not (verifier/kexe-integrity? tampered-kexe))
             (not (verifier/kexe-integrity? mismatched-kir-kexe))
             (verifier/kexe-header-shape? abort-kexe)
             (verifier/kexe-header-shape? empty-effects-kexe)
             (verifier/kexe-header-shape? cap-kexe)
             (verifier/kexe-header-shape? valid-oracle-kexe)
             (verifier/kexe-header-shape?
               (document-assoc valid-oracle-kexe :oracle
                 (document-map :status (document-keyword :inconclusive)
                               :trap (document-keyword :budget/cells) :fuel (document-i64 100))))
             (verifier/kexe-header-shape?
               (document-assoc valid-oracle-kexe :oracle
                 (document-map :status (document-keyword :inconclusive)
                               :trap (document-keyword :budget/bytes) :fuel (document-i64 100))))
             (verifier/kexe-header-shape?
               (document-assoc valid-oracle-kexe :oracle
                 (document-map :status (document-keyword :inconclusive)
                               :trap (document-keyword :budget/frames) :fuel (document-i64 100))))
             (verifier/kexe-header-shape?
               (document-assoc valid-oracle-kexe :oracle
                 (document-map :status (document-keyword :inconclusive)
                               :trap (document-keyword :budget/gas) :fuel (document-i64 100))))
             (verifier/kexe-header-shape?
               (document-assoc valid-oracle-kexe :oracle
                 (document-map :status (document-keyword :inconclusive)
                               :trap (document-keyword :host/stack-exhausted) :fuel (document-i64 100))))
             (not (verifier/kexe-header-shape? (document-assoc kexe :extra (document-bool true))))
             (not (verifier/kexe-header-shape? (document-dissoc kexe :code)))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :format (document-keyword :kotoba.kexe/v2))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :kir-sha256 (document-string "ABC"))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :kir-sha256 (document-i64 7))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :effects (document-set))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :effects (document-set (document-keyword :network)))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :effects
                      (document-set (document-vector (document-keyword :cap/call) (document-i64 -1))))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :effects
                      (document-set (document-vector (document-keyword :cap/call) (document-i64 256))))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :effects
                      (document-set (document-vector (document-keyword :cap/call) (document-string "1"))))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :effects
                      (document-set (document-vector (document-keyword :cap/call))))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :effects (document-vector (document-keyword :state)))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :program (document-map :effects (document-set)))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :program (document-string "bad"))))
             (not (verifier/kexe-header-shape? malformed-oracle-kexe))
             (not (verifier/kexe-header-shape?
                    (document-assoc valid-oracle-kexe :oracle
                      (document-map :status (document-keyword :failed)
                                    :trap (document-keyword :budget/fuel)
                                    :fuel (document-i64 100)))))
             (not (verifier/kexe-header-shape?
                    (document-assoc valid-oracle-kexe :oracle
                      (document-map :status (document-keyword :inconclusive)
                                    :trap (document-keyword :other)
                                    :fuel (document-i64 100)))))
             (not (verifier/kexe-header-shape?
                    (document-assoc valid-oracle-kexe :oracle
                      (document-map :status (document-keyword :inconclusive)
                                    :trap (document-keyword :budget/fuel)
                                    :fuel (document-i64 99)))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :oracle
                      (document-map :status (document-keyword :inconclusive)
                                    :trap (document-keyword :budget/fuel)
                                    :fuel (document-i64 100)))))
             (not (verifier/kexe-header-shape?
                    (document-assoc valid-oracle-kexe :oracle
                      (document-map :status (document-keyword :inconclusive)
                                    :trap (document-keyword :budget/fuel)))))
             (not (verifier/kexe-header-shape?
                    (document-assoc valid-oracle-kexe :oracle
                      (document-map :status (document-keyword :inconclusive)
                                    :trap (document-keyword :budget/fuel)
                                    :fuel (document-i64 100)
                                    :extra (document-bool true)))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :code (document-vector))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :code (document-vector (document-i64 -1)))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :code (document-vector (document-i64 256)))))
             (not (verifier/kexe-header-shape?
                    (document-assoc kexe :code (document-vector (document-string "0")))))
             (not (verifier/kexe-header-shape? (document-vector))))
      0
      1))))
