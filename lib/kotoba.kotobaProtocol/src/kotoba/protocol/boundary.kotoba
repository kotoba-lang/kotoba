;; Port of kotoba.protocol.boundary (boundary.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from boundary.cljk:
;;   - The constants are zero-argument functions (boundary-schema,
;;     canonical-encoding, wire-order, wire-forms, rules-inherited,
;;     forbidden-carriers), as Kotoba has no def export.
;;   - forbidden-carriers is a :document set; rules-inherited and wire-order
;;     are :document vectors of keywords.
;;   - wire-form returns document-null where the source returns nil.

(ns kotoba.protocol.boundary
  (:export [boundary-schema canonical-encoding wire-order wire-forms
            rules-inherited forbidden-carriers wire-form]))

(defn boundary-schema [] :keyword :kotoba.lisp-machine/boundary-v1)

(defn canonical-encoding [] :keyword :tagged-dag-cbor-vector)

(defn wire-order [] :document
  (document-vector (document-keyword :canonical-bytes) (document-keyword :cid) (document-keyword :decode)))

(defn wire-forms [] :document
  (document-map
   :value (document-map :shape (document-keyword (canonical-encoding))
                        :portable (document-vector (document-keyword :nil) (document-keyword :boolean)
                                                   (document-keyword :integer) (document-keyword :bytes)
                                                   (document-keyword :text) (document-keyword :keyword)
                                                   (document-keyword :list) (document-keyword :vector)
                                                   (document-keyword :map) (document-keyword :set)
                                                   (document-keyword :cid) (document-keyword :address)
                                                   (document-keyword :result))
                        :host-object (document-bool false))
   :message (document-map :shape (document-keyword (canonical-encoding))
                          :required (document-vector (document-keyword :chain-id) (document-keyword :sender)
                                                     (document-keyword :recipient) (document-keyword :method)
                                                     (document-keyword :params) (document-keyword :value)
                                                     (document-keyword :nonce) (document-keyword :fuel-limit)
                                                     (document-keyword :epoch))
                          :identity (document-keyword :cid-of-canonical-message))
   :receipt (document-map :shape (document-keyword (canonical-encoding))
                          :required (document-vector (document-keyword :machine-spec) (document-keyword :implementation)
                                                     (document-keyword :profile) (document-keyword :message-cid)
                                                     (document-keyword :program-cid) (document-keyword :state-before)
                                                     (document-keyword :state-after) (document-keyword :outcome)
                                                     (document-keyword :fuel-used) (document-keyword :events)
                                                     (document-keyword :authority-decision))
                          :forbidden (document-vector (document-keyword :raw-biscuit) (document-keyword :private-key)
                                                      (document-keyword :ambient-host-handle)))))

(defn rules-inherited [] :document
  (document-vector (document-keyword :judgment-free) (document-keyword :unknown-shape-fail-closed)
                   (document-keyword :canonical-bytes-before-cid) (document-keyword :versioned-wire-keys-preserved)
                   (document-keyword :no-secrets) (document-keyword :host-object-transparent)))

(defn forbidden-carriers [] :document
  (document-set (document-keyword :raw-biscuit) (document-keyword :private-key)
                (document-keyword :ambient-host-handle) (document-keyword :secret)
                (document-keyword :provider-handle)))

(defn wire-form [name :document] :document
  (option-or (document-get (wire-forms) name) (document-null)))
