(ns kotoba.protocol.boundary
  "境界の形（:kotoba.lisp-machine/boundary-v1）の wire 宣言。
  正本は kotoba-lang/kotoba-lang docs/adr/ADR-kotoba-lisp-machine-contract-decisions.md D1。

  この repo の規約どおり**宣言 (data) と検証 (テスト) だけ**を持つ。bytes/CID の実装は
  既存 codec owner (io-multiformats / io-ipld / dag-cbor)、profile layout は abi、
  中立の shape は kotoba-core-contracts の boundary_contract.edn。判定は rule Form と
  grant が行い、この wire は判断を持たない (judgment-free)。")

(def boundary-schema :kotoba.lisp-machine/boundary-v1)

(def canonical-encoding
  "境界を越える value / message / receipt の正規形。"
  :tagged-dag-cbor-vector)

(def wire-order
  "書き込みは canonical bytes を作ってから CID。読み込みは CID 検証後に decode。"
  [:canonical-bytes :cid :decode])

(def wire-forms
  "境界の value-wire domain を通る 3 つの形。required / forbidden は
  kototama/spec/kototama-vm-v1.edn の :message / :receipt に対応する。"
  {:value {:shape canonical-encoding
           :portable [:nil :boolean :integer :bytes :text :keyword
                      :list :vector :map :set :cid :address :result]
           :host-object false}
   :message {:shape canonical-encoding
             :required [:chain-id :sender :recipient :method :params
                        :value :nonce :fuel-limit :epoch]
             :identity :cid-of-canonical-message}
   :receipt {:shape canonical-encoding
             :required [:machine-spec :implementation :profile :message-cid
                        :program-cid :state-before :state-after :outcome
                        :fuel-used :events :authority-decision]
             :forbidden [:raw-biscuit :private-key :ambient-host-handle]}})

(def rules-inherited
  "wire が矛盾してはならない境界の 6 rules。"
  [:judgment-free
   :unknown-shape-fail-closed
   :canonical-bytes-before-cid
   :versioned-wire-keys-preserved
   :no-secrets
   :host-object-transparent])

(def forbidden-carriers
  "いかなる wire 形でも載せないもの (no-secrets)。"
  #{:raw-biscuit :private-key :ambient-host-handle :secret :provider-handle})

(defn wire-form
  "name (:value / :message / :receipt) の wire 宣言を返す。無ければ nil —
  未知 shape は fail closed する側 (呼び出し元) の仕事で、この lookup は
  黙って代用しない。"
  [name]
  (get wire-forms name))
