(ns kotoba.protocol.credential-test
  (:require [cljs.test :as t]
            [kotoba.protocol.credential :as cred]))

(t/deftest credential-predicate-algebra
  (t/testing "predicate? and make-predicate"
    (let [pfn (fn [_] {:ok true})
          p   (cred/make-predicate pfn)]
      (t/is (cred/predicate? p))
      (t/is (= {:ok true} ((:verify-fn p) :any)))
      (t/is (not (cred/predicate? {:verify-fn "not-a-fn"})))))

  (t/testing "and-pred"
    (let [pt  (cred/make-predicate (fn [_] {:ok true}))
          pf  (cred/make-predicate (fn [_] {:ok false}))
          perr (cred/make-predicate (fn [_] {:error :bad}))]
      (t/is (= {:ok true}
               ((:verify-fn (cred/and-pred pt pt)) :any)))
      (t/is (= {:ok false}
               ((:verify-fn (cred/and-pred pt pf)) :any)))
      (t/is (= {:error :bad}
               ((:verify-fn (cred/and-pred perr pt)) :any)))
      (t/is (= {:error :bad}
               ((:verify-fn (cred/and-pred pt perr)) :any)))))

  (t/testing "or-pred"
    (let [pt  (cred/make-predicate (fn [_] {:ok true}))
          pf  (cred/make-predicate (fn [_] {:ok false}))
          perr (cred/make-predicate (fn [_] {:error :bad}))]
      (t/is (= {:ok true}
               ((:verify-fn (cred/or-pred pt pf)) :any)))
      (t/is (= {:ok false}
               ((:verify-fn (cred/or-pred pf pf)) :any)))
      (t/is (= {:error :bad}
               ((:verify-fn (cred/or-pred perr pf)) :any)))
      (t/is (= {:ok true}
               ((:verify-fn (cred/or-pred pt perr)) :any)))))

  (t/testing "not-pred"
    (let [pt  (cred/make-predicate (fn [_] {:ok true}))
          pf  (cred/make-predicate (fn [_] {:ok false}))
          perr (cred/make-predicate (fn [_] {:error :bad}))]
      (t/is (= {:ok false}
               ((:verify-fn (cred/not-pred pt)) :any)))
      (t/is (= {:ok true}
               ((:verify-fn (cred/not-pred pf)) :any)))
      (t/is (= {:error :bad}
               ((:verify-fn (cred/not-pred perr)) :any))))))