(ns kotoba.protocol.boundary-test
  "境界の形の wire 宣言が「判断を持たない」ことと、kototama の required/forbidden と
  食い違わないことを固定する。宣言の drift はここで露見させる。"
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.protocol.boundary :as boundary]))

(deftest boundary-schema-and-encoding
  (is (= :kotoba.lisp-machine/boundary-v1 boundary/boundary-schema))
  (is (= :tagged-dag-cbor-vector boundary/canonical-encoding))
  (is (= [:canonical-bytes :cid :decode] boundary/wire-order))
  (testing "書き込み順は canonical bytes → CID (kototama :canonical-bytes-before-cid と同じ規則)"
    (is (= :canonical-bytes (first boundary/wire-order)))))

(deftest boundary-wire-forms
  (is (= #{:value :message :receipt} (set (keys boundary/wire-forms))))
  (testing "message の required は kototama :message と一致"
    (is (= [:chain-id :sender :recipient :method :params
            :value :nonce :fuel-limit :epoch]
           (-> (boundary/wire-form :message) :required))))
  (testing "receipt の required / forbidden は kototama :receipt と一致"
    (is (= [:machine-spec :implementation :profile :message-cid
            :program-cid :state-before :state-after :outcome
            :fuel-used :events :authority-decision]
           (-> (boundary/wire-form :receipt) :required)))
    (is (= [:raw-biscuit :private-key :ambient-host-handle]
           (-> (boundary/wire-form :receipt) :forbidden))))
  (testing "value は host object を越えない"
    (is (false? (-> (boundary/wire-form :value) :host-object))))
  (testing "wire-form は未知の形に代用しない (fail closed は呼び出し元)"
    (is (nil? (boundary/wire-form :unknown)))))

(deftest boundary-rules-and-forbidden-carriers
  (is (= [:judgment-free
          :unknown-shape-fail-closed
          :canonical-bytes-before-cid
          :versioned-wire-keys-preserved
          :no-secrets
          :host-object-transparent]
         boundary/rules-inherited))
  (testing "秘密はどの wire 形でも載せない (no-secrets)"
    (is (every? boundary/forbidden-carriers
                [:raw-biscuit :private-key :ambient-host-handle :secret :provider-handle]))))
