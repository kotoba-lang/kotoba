(ns kotoba.protocol.accountability-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.protocol.accountability :as acc]
            [kotoba.protocol.govern :as govern]
            [kotoba.protocol.graph :as graph]))

(def ^:private policy-cid "ipfs://bafybeidl5t4ztktqmfcqrfqpio6qf64n6t65a7inkz2pa6jq4tyqwfjfhy")
(def ^:private other-ref "ipfs://bafkreibm6jg3ux5qumhcn2b3flc3tyu6dmlb4xa7u5bf44yegnrjhc4yeq")
(def ^:private did "did:key:z6MkoPd1PVGGf5gTMGy4nZNrBMszzfaeaNmZfSzgAZZNhDWq")
(def ^:private cid "bafybeidl5t4ztktqmfcqrfqpio6qf64n6t65a7inkz2pa6jq4tyqwfjfhy")
(def ^:private raw-cid "bafkreibm6jg3ux5qumhcn2b3flc3tyu6dmlb4xa7u5bf44yegnrjhc4yeq")

(def ^:private policy
  (assoc (acc/default-policy
          {:effective-from 100
           :params {:param/value-threshold {:min 0}}
           :actions {:infra/operate :holds-others-data
                     :sealed/request-other-key :intrudes-privacy
                     :content/read :self-sovereign
                     :content/post :expression
                     :code/publish :irreversible-spread
                     :value/transfer {:externality :value-transfer
                                      :escalate {:above :param/value-threshold
                                                 :to :t3}}}})
         :policy/id policy-cid))

(def ^:private profile
  {:profile/policy policy-cid
   :profile/scope {:kind :jurisdiction :ref "example"}
   :profile/effective-from 200
   :profile/params {:param/value-threshold 1000
                    :param/notice-max-days 90}
   :profile/authorizers [{:kind :court-order :issuer-set "example-courts"}]
   :profile/tier-raises {:code/publish :t3}})

(def ^:private bound {:policy policy :profile profile})

;; ── L0 vocabulary ───────────────────────────────────────────────────────────

(deftest tiers-are-ordered-and-only-t2-t3-have-a-path
  (is (= [:t0 :t1 :t2 :t3] acc/tier-order))
  (is (= (set acc/tier-order) (set (keys acc/tiers))))
  (is (acc/tier>= :t3 :t1))
  (is (not (acc/tier>= :t1 :t3)))
  (is (not (acc/tier>= :t9 :t0)) "unknown is never sufficient")
  (is (= :t3 (acc/max-tier :t1 :t3 :t0)))
  (is (= #{:t0 :t1}
         (set (for [[t {:keys [disclosure-path?]}] acc/tiers
                    :when (false? disclosure-path?)]
                t)))))

(deftest every-externality-default-is-at-or-above-its-floor
  (doseq [[e {:keys [floor default]}] acc/externalities]
    (is (acc/tier? floor) (str e))
    (is (acc/tier>= default floor) (str e))))

(deftest power-externalities-are-floored-at-t3
  (doseq [e [:holds-others-data :intrudes-privacy :restricts-rights :root-of-trust]]
    (is (= :t3 (acc/floor-of e)))))

;; ── L1 policy ───────────────────────────────────────────────────────────────

(deftest default-policy-is-valid
  (is (= [] (acc/policy-errors policy))))

(deftest policy-cannot-sink-a-power-act-below-its-floor
  (let [p (assoc-in policy [:policy/actions :infra/operate :tier] :t1)]
    (is (= :l0/power-acts-always-logged
           (:invariant (first (acc/policy-errors p)))))))

(deftest policy-cannot-loosen-disclosure-floors
  (let [p (assoc-in policy [:policy/params :param/disclosure-k :min] 2)]
    (is (some #(= :l0/disclosure-threshold-floor (:invariant %))
              (acc/policy-errors p)))))

(deftest policy-notice-must-expire
  (let [p (assoc-in policy [:policy/params :param/notice-max-days] {:min 0})]
    (is (some #(= :l0/notice-must-expire (:invariant %))
              (acc/policy-errors p)))))

(deftest policy-rejects-unknown-keys-and-wrong-l0
  (is (some #(= :unknown-key (:error %))
            (acc/policy-errors (assoc policy :policy/override-l0 true))))
  (is (some #(= :l0-mismatch (:error %))
            (acc/policy-errors (assoc policy :policy/l0 "kotoba/accountability/v0")))))

(deftest escalation-must-raise-and-name-a-declared-param
  (is (some #(= :escalate-not-a-raise (:error %))
            (acc/policy-errors
             (assoc-in policy [:policy/actions :value/transfer :escalate :to] :t0))))
  (is (some #(= :escalate-param-undeclared (:error %))
            (acc/policy-errors
             (assoc-in policy [:policy/actions :value/transfer :escalate :above]
                       :param/nope)))))

;; ── L2 profile ──────────────────────────────────────────────────────────────

(deftest profile-is-valid
  (is (= [] (acc/profile-errors policy profile))))

(deftest profile-cannot-lower-a-tier
  (let [pr (assoc-in profile [:profile/tier-raises :infra/operate] :t1)]
    (is (= :l0/profile-cannot-break-l0
           (:invariant (first (acc/profile-errors policy pr)))))))

(deftest profile-cannot-name-anything-outside-its-keys
  (let [pr (assoc profile :profile/disclosure-paths {:t1 :court-order})]
    (is (= :unknown-key (:error (first (acc/profile-errors policy pr)))))))

(deftest profile-params-stay-inside-policy-range
  (is (some #(= :param-out-of-range (:error %))
            (acc/profile-errors policy (assoc-in profile [:profile/params :param/notice-max-days] 9999))))
  (is (some #(= :param-undeclared (:error %))
            (acc/profile-errors policy (assoc-in profile [:profile/params :param/nope] 1)))))

(deftest profile-cannot-predate-its-policy
  (is (some #(= :l0/no-retroactive-raise (:invariant %))
            (acc/profile-errors policy (assoc profile :profile/effective-from 50)))))

(deftest profile-must-point-at-its-policy
  (is (some #(= :policy-mismatch (:error %))
            (acc/profile-errors policy (assoc profile :profile/policy other-ref)))))

;; ── requirement and meet ────────────────────────────────────────────────────

(deftest requirement-reads-policy-then-profile-raise
  (is (= {:tier :t0} (acc/requirement bound :content/read {:at 300})))
  (is (= {:tier :t3} (acc/requirement bound :infra/operate {:at 300})))
  (is (= {:tier :t3} (acc/requirement bound :code/publish {:at 300}))
      "policy says :t2, profile raises to :t3"))

(deftest value-escalates-above-the-profile-threshold
  (is (= {:tier :t1} (acc/requirement bound :value/transfer {:at 300 :value 10})))
  (is (= {:tier :t3} (acc/requirement bound :value/transfer {:at 300 :value 5000}))))

(deftest unset-threshold-escalates-rather-than-allows
  (is (= {:tier :t3} (acc/requirement {:policy policy} :value/transfer {:at 300 :value 10})))
  (is (= {:tier :t3} (acc/requirement bound :value/transfer {:at 300}))))

(deftest act-before-the-binding-is-retroactive
  (is (= :retroactive (:error (acc/requirement bound :content/read {:at 150}))))
  (is (= :act-time-required (:error (acc/requirement bound :content/read {})))))

(deftest unknown-action-fails-closed
  (is (= :unknown-action (:error (acc/requirement bound :nope/act {:at 300})))))

(deftest meet-takes-the-stricter-binding
  (let [strict (assoc-in profile [:profile/tier-raises :content/post] :t2)]
    (is (= {:tier :t2}
           (acc/meet [bound {:policy policy :profile strict}] :content/post {:at 300})))
    (is (= :accountability-unbound (:error (acc/meet [] :content/post {:at 300}))))))

(deftest decide-denies-a-short-tier-and-defaults-held-to-t0
  (is (= :allow (acc/decide {:action :content/read :accountability [bound]
                             :context {:at 300}})))
  (is (= {:deny :tier-insufficient :required :t3 :held :t1}
         (acc/decide {:action :infra/operate :tier :t1 :accountability [bound]
                      :context {:at 300}}))))

;; ── disclosure ──────────────────────────────────────────────────────────────

(defn- trustee [i j o]
  {:did did :jurisdiction j :org o :i i})

(def ^:private diverse
  {:k 3 :trustees [(trustee 0 "a" "w") (trustee 1 "b" "x") (trustee 2 "c" "y")
                   (trustee 3 "d" "z") (trustee 4 "e" "v")]})

(deftest trustee-set-floors-and-diversity
  (is (= [] (acc/trustee-set-errors diverse)))
  (is (some #(= :l0/trustee-diversity (:invariant %))
            (acc/trustee-set-errors
             (assoc-in diverse [:trustees 1 :jurisdiction] "a")))
      "2 of 5 in one jurisdiction exceeds 1/3")
  (is (some #(= :l0/disclosure-threshold-floor (:invariant %))
            (acc/trustee-set-errors (assoc diverse :k 2)))))

(def ^:private request
  {:act-tier :t2
   :evidence {:act policy-cid :warrant other-ref}
   :authorizer {:kind :court-order}
   :trustee-set diverse
   :log-entry other-ref})

(deftest disclosure-admits-only-t2-with-evidence-authorizer-and-log
  (is (= [] (acc/disclosure-errors profile request)))
  (testing "t0 and t1 have no path at all"
    (doseq [t [:t0 :t1]]
      (is (= :no-disclosure-path
             (:error (first (acc/disclosure-errors profile (assoc request :act-tier t))))))))
  (is (some #(= :authorizer-not-in-profile (:error %))
            (acc/disclosure-errors profile (assoc request :authorizer {:kind :community-tribunal}))))
  (is (some #(= :l0/disclosure-always-logged (:invariant %))
            (acc/disclosure-errors profile (dissoc request :log-entry)))))

;; ── govern integration ──────────────────────────────────────────────────────

(deftest govern-without-action-is-unchanged
  (is (= :allow (govern/decide (govern/intent {:author did :graph-owner did
                                               :from cid :to raw-cid})))))

(deftest govern-runs-tier-check-after-the-chain-check
  (let [st (graph/put-node (graph/store) {:cid cid :body "A"})
        short (govern/intent {:author did :graph-owner did :from cid :to raw-cid
                              :action :infra/operate :tier :t1
                              :accountability [bound] :context {:at 300}})
        enough (assoc short :tier :t3)
        out (govern/write-overlay st short)]
    (is (= :governor-denied (:error out)))
    (is (= :tier-insufficient (:reason out)))
    (is (= (:actions st) (:actions (:store out))))
    (is (nil? (:error (govern/write-overlay st enough))))))

(deftest govern-named-action-without-binding-is-deny
  (is (= :accountability-unbound
         (:deny (govern/decide (govern/intent {:author did :graph-owner did
                                               :from cid :to raw-cid
                                               :action :content/read
                                               :context {:at 300}}))))))

;; ── R1: policy composition ──────────────────────────────────────────────────

(deftest compose-takes-stricter-tier-and-intersects-params
  (let [other (-> policy
                  (assoc :policy/effective-from 400)
                  (assoc-in [:policy/actions :content/post :tier] :t2)
                  (assoc-in [:policy/params :param/notice-max-days] {:min 0 :max 30})
                  (assoc-in [:policy/actions :vote/cast] {:externality :anonymity-is-value :tier :t0}))
        {p :policy :as out} (acc/compose-policies [policy other])]
    (is (nil? (:error out)))
    (is (= :t2 (get-in p [:policy/actions :content/post :tier])))
    (is (= :t0 (get-in p [:policy/actions :vote/cast :tier])))
    (is (= {:min 0 :max 30} (get-in p [:policy/params :param/notice-max-days])))
    (is (= 400 (:policy/effective-from p)))
    (is (nil? (:policy/id p)) "composed is derived, not adopted")))

(deftest compose-fails-closed
  (is (= :no-policies (:error (acc/compose-policies []))))
  (is (= :invalid-policy
         (:error (acc/compose-policies [policy (assoc policy :policy/l0 "x")]))))
  (is (= :param-range-empty
         (:error (acc/compose-policies
                  [policy (assoc-in policy [:policy/params :param/notice-max-days] {:min 400 :max 500})])))))

;; ── R1: receipt visibility ──────────────────────────────────────────────────

(deftest self-access-is-owner-only-everything-else-operator
  (is (= :owner-only (acc/receipt-visibility {:accessor did :owner did})))
  (is (= :operator (acc/receipt-visibility {:accessor did :owner "did:key:z6MkpTHR8VHsExkJxkgDwbwisfb5Tq2mWiwWjcmSKqU2E"})))
  (is (= :operator (acc/receipt-visibility {:accessor nil :owner did})))
  (is (= :operator (acc/receipt-visibility {:accessor "kotobase.net" :owner "kotobase.net"}))
      "a hostname is never an owner"))

(deftest owner-only-receipt-carries-no-reader-metadata
  (is (= [] (acc/receipt-errors {:visibility :owner-only :graph cid
                                 :operation "key:requestShare" :ts-unix 1})))
  (is (= :owner-only-receipt-leaks
         (:error (first (acc/receipt-errors {:visibility :owner-only :graph cid
                                             :operation "datom:q" :ts-unix 1
                                             :accessor did :purpose "x"}))))))
