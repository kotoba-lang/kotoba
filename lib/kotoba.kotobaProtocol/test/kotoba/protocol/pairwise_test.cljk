(ns kotoba.protocol.pairwise-test
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.protocol.pairwise :as pw]))

(def ^:private root "did:key:z6MkoPd1PVGGf5gTMGy4nZNrBMszzfaeaNmZfSzgAZZNhDWq")
(def ^:private d1 "did:key:z6MkpTHR8VHsExkJxkgDwbwisfb5Tq2mWiwWjcmSKqU2E")
(def ^:private d2 "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK")
(def ^:private ipns-name (str "k51qzi5uqu5d" (apply str (repeat 50 "a"))))
(def ^:private c1 "net.example.forum")
(def ^:private c2 (str "ipns://" ipns-name))

(deftest context-grammar
  (is (pw/context? c1))
  (is (pw/context? c2))
  (is (not (pw/context? "my forum")))
  (is (not (pw/context? "https://example.net/forum")) "a location is not a context")
  (is (= c2 (pw/context-for-graph ipns-name)))
  (is (nil? (pw/context-for-graph ""))))

(deftest derivation-constants-are-fixed
  (is (= {:salt "kotoba/pairwise/v1" :info c1 :length 32 :curve :ed25519}
         (pw/derivation c1)))
  (is (= :not-a-context (:error (pw/derivation "free text")))))

(deftest a-clean-binding-set
  (is (= [] (pw/binding-errors root [{:context c1 :did d1} {:context c2 :did d2}]))))

(deftest one-did-in-two-contexts-links-them
  (is (= :linked-across-contexts
         (:error (first (pw/binding-errors root [{:context c1 :did d1} {:context c2 :did d1}]))))))

(deftest root-is-never-a-pairwise-did
  (is (= :root-exposed (:error (first (pw/binding-errors root [{:context c1 :did root}]))))))

(deftest a-context-is-bound-once
  (is (= :context-rebound
         (:error (first (pw/binding-errors root [{:context c1 :did d1} {:context c1 :did d2}]))))))

(deftest linkability-stays-inside-one-context
  (is (pw/linkable? {:context c1 :did d1} {:context c1 :did d1}))
  (is (not (pw/linkable? {:context c1 :did d1} {:context c2 :did d1})))
  (is (pw/same-principal? [{:context c1 :did d1} {:context c2 :did d2}] d1 d2))
  (is (not (pw/same-principal? [{:context c1 :did d1}] d1 d2))))
