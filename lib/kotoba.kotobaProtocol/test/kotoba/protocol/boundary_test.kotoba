(ns kotoba.protocol.boundary-test
  (:export [main])
  (:require [kotoba.protocol.boundary :as b]))

(defn- expect [got :bool want :bool] :i64
  (if (= got want) 0 1))

(defn- field [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn main [] :i64
  (let [msg (b/wire-form (document-keyword :message))
        rcpt (b/wire-form (document-keyword :receipt))
        val (b/wire-form (document-keyword :value))]
    (+ (expect (document-equal? (document-keyword (b/boundary-schema)) (document-keyword :kotoba.lisp-machine/boundary-v1)) true)
       (expect (document-equal? (document-keyword (b/canonical-encoding)) (document-keyword :tagged-dag-cbor-vector)) true)
       (expect (= (document-count (b/wire-order)) 3) true)
       (expect (= (document-count (field msg :required)) 9) true)
       (expect (= (document-count (field rcpt :required)) 11) true)
       (expect (= (document-count (field rcpt :forbidden)) 3) true)
       (expect (document-equal? (field msg :identity) (document-keyword :cid-of-canonical-message)) true)
       (expect (= (document-count (field val :portable)) 13) true)
       (expect (= (document-kind (field val :host-object)) :bool) true)
       (expect (= (document-count (b/rules-inherited)) 6) true)
       (expect (= (document-count (b/forbidden-carriers)) 5) true)
       (expect (= (document-kind (b/wire-form (document-keyword :nope))) :null) true))))
