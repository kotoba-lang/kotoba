(ns triage.classify-test
  (:require [kotoba.test :refer [deftest is testing]]
            [triage.classify :as c]))

(deftest strip-fence-removes-code-fences
  (is (= "{\"a\":1}" (c/strip-fence "```json\n{\"a\":1}\n```")))
  (is (= "{\"a\":1}" (c/strip-fence "  {\"a\":1}  "))))

(deftest extract-json-tolerates-noise
  ;; parse-fn を注入（テストでは「JSON 風文字列をそのまま map に」する偽 parser）
  (let [fake (fn [s] (if (= s "{ok}") {:ok true} (throw (ex-info "bad" {}))))]
    (testing "前後にゴミがあっても最初の { から最後の } を拾う"
      (is (= {:ok true} (c/extract-json fake "preamble {ok} trailing"))))
    (testing "valid JSON 不在なら nil"
      (is (nil? (c/extract-json fake "no braces here"))))))

(deftest select-known-drops-hallucinated-ids
  (let [items [{:id "a"} {:id "b"}]
        sugg  [{:itemId "a" :policy "todo"}
               {:itemId "zzz" :policy "archive"}   ; 捏造 id
               {:itemId "b" :policy "snooze"}]]
    (is (= ["a" "b"] (mapv :itemId (c/select-known items sugg))))))

(deftest build-prompt-includes-items
  (let [p (c/build-prompt [{:id "x1" :from "a@b.c" :subject "件名" :date "2026" :snippet "本文"}])]
    (is (re-find #"itemId: x1" p))
    (is (re-find #"件名" p))))
