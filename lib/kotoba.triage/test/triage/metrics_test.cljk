(ns triage.metrics-test
  (:require [kotoba.test :refer [deftest is testing]]
            [triage.metrics :as m]))

(def rows
  [{:id "a" :expected "todo"      :got "todo"    :conf "high" :ok true}
   {:id "b" :expected "todo"      :got "archive" :conf "high" :ok false}   ; hazard
   {:id "c" :expected "waiting"   :got "todo"    :conf "low"  :ok false}   ; low ⇒ not hazard
   {:id "d" :expected "reply_llm" :got "snooze"  :conf "high" :ok false}]) ; snooze ⇒ not hazard

(def labels
  ["reply_llm" "todo" "waiting" "done" "archive" "unsubscribe" "investigate" "snooze"])

(deftest auto-apply-hazard-only-high-wrong-non-safe
  (is (= ["b"] (mapv :id (m/auto-apply-hazard rows))))
  (testing "safe-label を変えられる: snooze を safe から外すと d も hazard"
    (is (= #{"b" "d"} (set (mapv :id (m/auto-apply-hazard rows "todo")))))))

(deftest per-label-recall-precision
  (let [pl (m/per-label rows labels)]
    (is (= 2 (get-in pl ["todo" :support])))
    (is (= 2 (get-in pl ["todo" :predicted])))
    (is (= 1 (get-in pl ["todo" :tp])))
    (is (= 0.5 (get-in pl ["todo" :recall])))
    (is (= 0.5 (get-in pl ["todo" :precision])))
    (testing "0 件のラベルは nil（0除算回避）"
      (is (nil? (get-in pl ["done" :recall])))
      (is (nil? (get-in pl ["done" :precision]))))))

(deftest zero-support-lists-untested
  (is (= #{"done" "archive" "unsubscribe" "investigate" "snooze"}
         (set (m/zero-support rows labels)))))

(deftest confusion-counts
  (let [c (m/confusion rows)]
    (is (= 1 (get-in c ["todo" "todo"])))
    (is (= 1 (get-in c ["todo" "archive"])))))

(deftest summary-and-report
  (let [s (m/summary rows labels)]
    (is (= 4 (:total s)))
    (is (= 1 (:correct s)))
    (is (= 0.25 (:accuracy s)))
    (is (= ["b"] (:hazard s))))
  (let [r (m/report-str rows labels)]
    (is (string? r))
    (is (re-find #"auto-apply hazard: 1" r))))
