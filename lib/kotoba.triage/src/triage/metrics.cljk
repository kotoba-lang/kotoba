(ns triage.metrics
  "分類 eval の多次元メトリクス（純粋・可搬・zero-dep）。

  単一スカラー accuracy だけでは「校正された分類器」と「golden への丸暗記」を
  区別できず、自動確定（auto-apply）される *high-confidence で誤り* な危険ケースも、
  0 件しか出ないラベル（未テスト）も見えない。本 ns は eval の row 列からそれらを計測する。

  入力 row（汎用形・ドメイン非依存）:
    {:id \"...\" :expected \"todo\" :got \"todo\" :conf \"high\" :ok true}
  expected / got / conf は文字列（got/conf は nil 可）。clojure.core + clojure.string のみで
  JVM/bb/cljs 可搬（reader 条件分岐なし・format 不使用）。"
  (:require [kotoba.lang.text :as str]))

(defn auto-apply-hazard
  "自動確定してしまう誤り = high-confidence かつ \"safe ラベル\"（既定 snooze）以外かつ不正解。
  safe-label を変えれば任意のドメインに適用できる。危険な row を返す。"
  ([rows] (auto-apply-hazard rows "snooze"))
  ([rows safe-label]
   (->> rows
        (filter (fn [{:keys [ok conf got]}]
                  (and (not ok)
                       (= conf "high")
                       (some? got)
                       (not= got safe-label))))
        vec)))

(defn confusion
  "{expected {got count}} の混同行列。got が nil の場合は \"(none)\" に寄せる。"
  [rows]
  (reduce (fn [m {:keys [expected got]}]
            (update-in m [expected (or got "(none)")] (fnil inc 0)))
          {}
          rows))

(defn- safe-div [num den]
  (when (pos? den) (/ (double num) den)))

(defn per-label
  "ラベルごとに {:support :predicted :tp :recall :precision}。
  support=expected の件数, predicted=got の件数, tp=両方一致かつ正解。
  recall=tp/support, precision=tp/predicted（0 除算は nil）。"
  [rows labels]
  (into {}
        (map (fn [p]
               (let [support   (count (filter #(= (:expected %) p) rows))
                     predicted (count (filter #(= (:got %) p) rows))
                     tp        (count (filter #(and (= (:expected %) p)
                                                    (= (:got %) p)
                                                    (:ok %))
                                              rows))]
                 [p {:support support
                     :predicted predicted
                     :tp tp
                     :recall (safe-div tp support)
                     :precision (safe-div tp predicted)}])))
        labels))

(defn zero-support
  "golden に expected として一度も現れないラベル（＝eval で未テスト）。"
  [rows labels]
  (let [seen (set (map :expected rows))]
    (vec (remove seen labels))))

(defn summary
  "全メトリクスを 1 マップに。host はこれを好きな形（md/edn/stdout）で出力する。"
  ([rows labels] (summary rows labels "snooze"))
  ([rows labels safe-label]
   {:total      (count rows)
    :correct    (count (filter :ok rows))
    :accuracy   (safe-div (count (filter :ok rows)) (count rows))
    :hazard     (mapv :id (auto-apply-hazard rows safe-label))
    :zero-support (zero-support rows labels)
    :per-label  (per-label rows labels)
    :confusion  (confusion rows)}))

;; ---- portable formatting helpers（cljs に format が無いため自前） --------------
(defn- pad-right [s n]
  (let [s (str s)] (if (< (count s) n) (str s (apply str (repeat (- n (count s)) " "))) s)))

(defn- pad-left [s n]
  (let [s (str s)] (if (< (count s) n) (str (apply str (repeat (- n (count s)) " ")) s) s)))

(defn- pct [x]
  (if (nil? x) "  - " (pad-left (str (Math/round (* 100.0 (double x))) "%") 4)))

(defn report-str
  "人間可読な追記用テキストブロック（既存の accuracy 出力の後ろに置く想定）。"
  ([rows labels] (report-str rows labels "snooze"))
  ([rows labels safe-label]
   (let [hazards (auto-apply-hazard rows safe-label)
         pl      (per-label rows labels)
         zs      (zero-support rows labels)]
     (str
      "\n--- metrics -------------------------------------------------\n"
      "auto-apply hazard: " (count hazards)
      " 件（high-confidence で誤り・" safe-label " 以外＝自動確定が誤適用）\n"
      (apply str
             (for [{:keys [id expected got]} hazards]
               (str "  ! " (pad-right id 6) " exp=" (pad-right expected 11)
                    " got=" (pad-right (or got "(none)") 11) "\n")))
      "zero-support: " (if (seq zs) (str/join ", " zs) "なし")
      "（golden に expected が無く未テスト）\n"
      "per-label (support / recall / precision):\n"
      (apply str
             (for [p labels
                   :let [{:keys [support predicted tp recall precision]} (get pl p)]]
               (str "  " (pad-right p 11)
                    " sup=" (pad-right support 2)
                    " pred=" (pad-right predicted 2)
                    " tp=" (pad-right tp 2)
                    "  R=" (pct recall)
                    "  P=" (pct precision) "\n")))))))
