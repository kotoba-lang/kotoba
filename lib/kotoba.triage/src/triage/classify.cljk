(ns triage.classify
  "LLM 分類カーネルの可搬コア（zero-dep）。

  ドメイン非依存: ラベル集合・system プロンプト・JSON schema は呼び出し側が config で
  与える。モデル呼び出し（chat-fn）と JSON parse（parse-fn）は host が注入する
  （JVM は cheshire+curl、cljs は fetch+JSON.parse など）。本 ns 自体は I/O も
  サードパーティ依存も持たない純粋な文字列/データ処理だけ。

  config = {:system \"...\" :schema {...} :labels [\"todo\" ...]}"
  (:require [kotoba.lang.text :as str]))

(defn strip-fence
  "```json ... ``` のコードフェンスを剥がす。"
  [s]
  (-> (str s) str/trim
      (str/replace #"(?i)^```(?:json)?\s*" "")
      (str/replace #"\s*```\s*$" "")))

(defn extract-json
  "緩い JSON 抽出: フェンス除去 → 最初の { から最後の } まで。parse-fn(string)->data を注入。
  parse-fn が例外を投げたら nil。"
  [parse-fn s]
  (let [c (strip-fence s)]
    (letfn [(try-parse [x] (try (parse-fn x) (catch #?(:clj Exception :cljs :default) _ nil)))]
      (or (try-parse c)
          (let [a (str/index-of c "{") b (str/last-index-of c "}")]
            (when (and a b (< a b)) (try-parse (subs c a (inc b)))))))))

(defn build-prompt
  "items -> ユーザープロンプト文字列。各 item は {:id :from :subject :date :snippet}。"
  [items]
  (str "## 振り分け対象\n"
       (str/join "\n\n"
                 (map (fn [{:keys [id from subject date snippet]}]
                        (let [sn (or snippet "")]
                          (str "### itemId: " id "\n"
                               "From: " from "\n"
                               "Subject: " subject "\n"
                               "Date: " date "\n"
                               "Snippet: " (subs sn 0 (min 300 (count sn))))))
                      items))))

(defn select-known
  "提案を入力 item の id 集合に絞る（モデルが捏造した id を捨てる）。"
  [items suggestions]
  (let [known (set (map (comp str :id) items))]
    (filterv #(known (str (:itemId %))) suggestions)))

(defn suggest
  "items -> [{:itemId :policy :confidence :reason}]。
  chat-fn = (fn [system user schema] -> raw-string)（schema=nil で plain）。
  parse-fn = (fn [string] -> data)。schema 失敗時は schema 埋込みで 1 回 retry。"
  [{:keys [system schema]} chat-fn parse-fn items]
  (when (seq items)
    (let [user   (build-prompt items)
          raw    (try (chat-fn system user schema)
                      (catch #?(:clj Exception :cljs :default) _ nil))
          parsed (or (when raw (extract-json parse-fn raw))
                     (extract-json
                      parse-fn
                      (chat-fn system
                               (str user "\n\n## 出力形式（厳守）\n"
                                    "次の JSON Schema に従う JSON のみ。表・コードフェンス・説明文は禁止。")
                               nil)))]
      (select-known items (:suggestions parsed)))))
