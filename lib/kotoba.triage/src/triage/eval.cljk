(ns triage.eval
  "golden セットに対する分類精度評価の可搬ハーネス（zero-dep）。

  モデル呼び出しは suggest-fn として注入する（host が Ollama/Anthropic/langchain を束ねる）。
  golden case = {:expected \"todo\" :item {:id ... :subject ... ...}}。

  org に欠けていた「golden→accuracy/ラベル別/混同/hazard」計測を 1 か所に集約する。"
  (:require [triage.metrics :as m]))

(defn rows
  "suggest-fn(items)->[{:itemId :policy :confidence}] と cases から eval row 列を作る。
  純粋: suggest-fn さえ決まれば結果は決定的。"
  [suggest-fn cases]
  (let [items (mapv :item cases)
        sugg  (suggest-fn items)
        by-id (into {} (map (juxt (comp str :itemId) identity)) sugg)]
    (mapv (fn [{:keys [expected item]}]
            (let [s (get by-id (str (:id item)))]
              {:id       (str (:id item))
               :expected expected
               :got      (:policy s)
               :conf     (:confidence s)
               :reason   (:reason s)
               :ok       (= (:policy s) expected)}))
          cases)))

(defn run
  "cases を評価して {:rows :summary} を返す。labels はメトリクス計算に使うラベル全集合。"
  ([suggest-fn cases labels] (run suggest-fn cases labels "snooze"))
  ([suggest-fn cases labels safe-label]
   (let [rs (rows suggest-fn cases)]
     {:rows rs
      :summary (m/summary rs labels safe-label)})))
