{:paths ["src"]
 ;; Zero runtime deps, including crypto. Signing and hashing are injected
 ;; capabilities — see dnssec.sign's docstring — so this library never holds or
 ;; touches a zone-signing key, and the serialization (the half that actually
 ;; breaks) is testable with no crypto at all.
 ;; dnssec.canonical and dnssec.sign remain crypto-free — the dependency below
 ;; is used only by dnssec.provider, the REFERENCE injection. A caller with an
 ;; HSM or a key store passes its own sign-fn/digest-fn and never loads it.
 ;; kotoba-lang/ed25519 was renamed to kotoba-lang/org-ietf-ed25519. The old
 ;; name still redirects, so the old coordinate kept resolving -- but
 ;; tools.deps dedupes by the coordinate SYMBOL, so any closure that also
 ;; reaches the repository under its current name gets ed25519.core twice,
 ;; from two checkouts at two shas. The :git/sha is unchanged; it is the same
 ;; repository. The explicit :git/url is dropped rather than rewritten:
 ;; io.github.<org>/<name> derives it, so carrying it only creates a second
 ;; place for the name to go stale, which is exactly what happened here.
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/org-ietf-ed25519 {:local/root "../org.ietf.ed25519"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {
                      ;; The Kotoba compiler and KIR interpreter, so
                      ;; `kotoba/dnssec/canonical.kotoba` is driven by the
                      ;; suite rather than described by it.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "2cb7d3f18205eadb3791441d3c3e09d9eb9b1a22"}
                      io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.osaho"}}}}}
