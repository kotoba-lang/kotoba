;; 楽天銀行 — 入出金明細, column mapping for the tabular (CSV) export.
;;
;; Pairs with `kotoba-lang/statement-fetch`'s
;; `jp-rakuten-bank.transaction-detail-ja.edn`, which drives the browser to the
;; download. That flow retrieves a **PDF**; turning a PDF into rows is a host
;; capability kakeibo deliberately does not own (see README, "What this does not
;; do"). Use this mapping with the CSV export, or with rows produced by whatever
;; extracts a table from the PDF.
;;
;; `:mapping/unverified true` follows statement-fetch's `:step/unverified`
;; convention: the column *labels* below have not been confirmed against a real
;; export by the author of this file. Confirm them against one header row before
;; trusting an ingest — a wrong label yields plausible-looking transactions,
;; which `kakeibo.tx/validate-mapping` cannot detect. It can only detect a
;; missing column.
;;
;; Contains structure only — no account number, no balance, no payee.

{:mapping/institution :jp-rakuten-bank
 :mapping/document    :transaction-detail-ja
 :mapping/unverified  true

 ;; The account keyword is local naming, not an account number. Override it
 ;; per household; nothing in this repository should identify an account.
 :mapping/account     :acct/rakuten-ordinary

 :mapping/currency    "JPY"
 :mapping/scale       1          ; JPY has no subunit
 :mapping/date-order  :ymd

 :mapping/columns
 {:date        "取引日"
  :description "入出金先内容"
  :in          "入金金額"
  :out         "出金金額"}}
