;; Example category rules — a starting shape, not anybody's actual spending.
;;
;; Ordered: the first rule whose `:rule/match` holds entirely wins. Put the
;; specific rules above the broad ones, and remember that every match is
;; recorded as `:tx/category-rule`, so a wrong category is always traceable to
;; the rule that produced it.
;;
;; Deliberately no model runs here. A language model asked to categorize a
;; statement line produces a confident answer with no way for anything
;; downstream to tell a correct one from an invented one — and these numbers
;; land in a double-entry ledger. An unmatched transaction stays
;; `:uncategorized` and shows up in `kakeibo.category/coverage`, which is the
;; working list for the next rule you write.

[{:rule/id :cat/utilities
  :rule/category :utilities
  :rule/match {:description/regex "東京電力|東京ガス|水道局"
               :amount/sign :negative}}

 {:rule/id :cat/telecom
  :rule/category :telecom
  :rule/match {:description/contains ["NTT" "ドコモ" "SOFTBANK" "ソフトバンク" "KDDI" "AU "]
               :amount/sign :negative}}

 {:rule/id :cat/groceries
  :rule/category :groceries
  :rule/match {:description/contains ["スーパー" "SUPER" "まいばす" "業務スーパー"]
               :amount/sign :negative}}

 {:rule/id :cat/convenience
  :rule/category :convenience
  :rule/match {:description/contains ["セブンイレブン" "ファミリーマート" "ローソン"]
               :amount/sign :negative}}

 {:rule/id :cat/transport
  :rule/category :transport
  :rule/match {:description/contains ["JR" "SUICA" "PASMO" "メトロ"]
               :amount/sign :negative}}

 ;; Rent is matched by size rather than payee: a landlord's name is not a
 ;; stable string, and a large recurring outflow is the actual signal. Listed
 ;; late so a large utilities or telecom bill is not swept up as rent.
 {:rule/id :cat/rent
  :rule/category :rent
  :rule/match {:amount/sign :negative :amount/min-magnitude 80000}}

 {:rule/id :cat/income
  :rule/category :income
  :rule/match {:amount/sign :positive}}]
