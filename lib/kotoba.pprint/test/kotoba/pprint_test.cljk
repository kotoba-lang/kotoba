(ns kotoba.pprint-test
  "kotoba.pprint against clojure.pprint itself -- the oracle for
  scripts/migrate-clojure-pprint-to-kotoba-pprint.cljk (com-junkawasaki/root),
  which rewrites only the namespace token and so needs `pprint` to print the
  same BYTES: callers write its output into files, compare it in tests and
  diff it in gates.

  Both directions: every corpus value prints identically (with and without
  *print-length* / *print-level* bound, which kbb's clojure.pprint ignores),
  and two different printers -- one-line pr-str, and this printer with its
  margin moved from 72 to 80 -- are shown to DIFFER on the same corpus, so an
  agreement here is a measurement.

  Runs where clojure.pprint is cljs.pprint (kbb / nbb, ClojureScript). This
  file requires clojure.pprint on purpose; the codemod refuses a file that
  requires both namespaces."
  (:require [kotoba.test :refer [deftest is testing]]
            [clojure.pprint :as cpp]
            [kotoba.pprint :as pp]
            [kotoba.pprint-corpus :as corpus]))

(def ^:private values (vec (concat (corpus/fixed-cases) (corpus/corpus 600))))

(defn- oracle [v] (with-out-str (cpp/pprint v)))

(deftest pprint-is-byte-identical-to-clojure-pprint
  (let [n (count values)
        agree (fn [f] (count (filter #(= (oracle %) (f %)) values)))]
    (testing "the corpus is not trivially one-line"
      (is (< 150 (count (filter #(re-find #"\n." (oracle %)) values)))))
    (testing "pprint-str and pprint (through with-out-str) on every value"
      (is (= n (agree pp/pprint-str)))
      (is (= n (agree #(with-out-str (pp/pprint %))))))
    (testing "printer bindings are ignored, as kbb's clojure.pprint ignores them"
      (doseq [[pl pv] [[3 nil] [nil 2] [1 1]]]
        (is (= n (count (filter #(= (binding [*print-length* pl *print-level* pv] (oracle %))
                                    (binding [*print-length* pl *print-level* pv] (with-out-str (pp/pprint %))))
                                values))))))
    (testing "the other direction: a different printer is caught"
      (is (< (agree #(str (pr-str %) "\n")) n))
      (is (< (agree #(binding [pp/*print-right-margin* 80] (pp/pprint-str %))) n)))))

(deftest pprint-pinned-bytes
  (testing "the trailing blank cljs.pprint leaves on lines the final flush breaks"
    (is (= (str "{0 \"value-0\",\n 1 \"value-1\",\n 2 \"value-2\",\n 3 \"value-3\",\n"
                " 4 \"value-4\",\n 5 \"value-5\",\n 6 \"value-6\",\n 7 \"value-7\", \n"
                " 8 \"value-8\", \n 9 \"value-9\", \n 10 \"value-10\", \n 11 \"value-11\"}\n")
           (pp/pprint-str (zipmap (range 12) (map #(str "value-" %) (range 12)))))))
  (testing "boundary: a one-line print of 72 columns stays on one line, 73 breaks (measured)"
    (is (= 1 (count (re-seq #"\n" (pp/pprint-str [(apply str (repeat 66 "x")) 1])))))
    (is (= (oracle [(apply str (repeat 66 "x")) 1]) (pp/pprint-str [(apply str (repeat 66 "x")) 1])))
    (is (= (oracle [(apply str (repeat 67 "x")) 1]) (pp/pprint-str [(apply str (repeat 67 "x")) 1])))
    (is (= 2 (count (re-seq #"\n" (pp/pprint-str [(apply str (repeat 67 "x")) 1]))))))
  (testing "namespaced maps are not lifted, records print as maps, the rest is pr-str"
    (is (= "{:a/b 1, :a/c 2}\n" (pp/pprint-str {:a/b 1 :a/c 2})))
    (is (= "#queue [1 2]\n" (pp/pprint-str #?(:cljs #queue [1 2] :clj (conj clojure.lang.PersistentQueue/EMPTY 1 2)))))
    (is (= "'x\n" (pp/pprint-str '(quote x))))
    (is (= "nil\n" (pp/pprint-str nil))))
  (testing "*print-right-margin* is honoured when bound (kbb's clojure.pprint does not
            expose it, so these bytes are pinned from this printer, not the oracle)"
    (is (= "[1 2 3]\n" (binding [pp/*print-right-margin* 7] (pp/pprint-str [1 2 3]))))
    (is (= "[1\n 2 \n 3]\n" (binding [pp/*print-right-margin* 6] (pp/pprint-str [1 2 3]))))
    (is (= "[1\n 2\n 3]\n" (binding [pp/*print-right-margin* 5] (pp/pprint-str [1 2 3]))))))
