(ns kotoba.pprint-corpus
  "A deterministic corpus of values for the pprint oracle: a seeded linear
  congruential generator (no host RNG, so every run and every runtime sees
  the same values) building nested maps / vectors / sets / lists / quoted
  forms of scalars, at widths chosen to land on both sides of the 72-column
  margin.")

(defn- lcg [seed] (mod (+ (* seed 1103515245) 12345) 2147483648))

(def ^:private words ["a" "bb" "ccc" "value" "value-10" "a longer string with spaces"
                      "x y" "" "tab\there" "new\nline" "quote\"d" "unicode-日本語"])

(defn- gen
  "[value next-seed]"
  [seed depth]
  (let [s1 (lcg seed) r (mod (quot s1 65536) 100)]
    (if (or (>= depth 4) (< r 45))
      (let [s2 (lcg s1) k (mod (quot s2 65536) 12)]
        [(case k
           0 nil
           1 (mod (quot s2 7) 100000)
           2 (- (mod (quot s2 3) 1000))
           3 (keyword (nth words (mod s2 (count words)) "k"))
           4 (keyword "ns.part" (str "key" (mod s2 50)))
           5 (nth words (mod (quot s2 11) (count words)))
           6 (symbol (str "sym" (mod s2 9)))
           7 true
           8 false
           9 (/ (mod s2 1000) 8.0)
           10 (keyword (str "k" (mod s2 30)))
           11 (str "value-" (mod s2 40)))
         s2])
      (let [s2 (lcg s1)
            n (mod (quot s2 65536) (if (< depth 2) 14 6))
            kind (mod (quot s2 4096) 6)
            [items s3] (loop [i 0 s s2 acc []]
                         (if (= i n) [acc s]
                             (let [[v s'] (gen s (inc depth))] (recur (inc i) s' (conj acc v)))))]
        [(case kind
           0 (vec items)
           1 (into {} (map vector (map #(if (map? %) (str "m" (hash %)) %) items) (reverse items)))
           2 (set items)
           3 (apply list items)
           4 (zipmap (map #(keyword (str "k" %)) (range n)) items)
           5 (list 'quote (vec items)))
         s3]))))

(defn corpus [n]
  (loop [i 0 seed 42 acc []]
    (if (= i n) acc
        (let [[v s] (gen seed 0)] (recur (inc i) (lcg s) (conj acc v))))))

(defn width-boundary
  "Vectors of one string whose one-line print is exactly `w` columns wide."
  [w]
  ;; [\"xxx\"] = 4 + len
  [(apply str (repeat (- w 4) "x"))])

(defn fixed-cases []
  (concat
   [nil 1 "s" :k 'sym [] {} #{} '() '(quote x) '(quote x y) '(var f)
    (zipmap (range 12) (map #(str "value-" %) (range 12)))
    (vec (range 40))
    {:a {:b {:c {:d {:e (vec (range 30))}}}}}
    (list 1 (list 2 (list 3 (range 25))))
    #{:alpha :beta :gamma :delta :epsilon :zeta :eta :theta :iota :kappa :lambda :mu}
    [(apply str (repeat 100 "y"))]]
   (for [w [69 70 71 72 73 74]] (width-boundary w))
   (for [w [69 70 71 72 73 74]] {:k (apply str (repeat (- w 7) "z"))})
   (for [w [30 31 32 33]] (vec (repeat 3 {:key (apply str (repeat w "q"))})))))
