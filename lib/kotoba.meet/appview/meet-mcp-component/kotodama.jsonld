{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:meet.etzhayyim.com",
  "name": "meet",
  "nanoid": "meet-mcp",
  "performerType": "service",
  "runtimeType": "worker",
  "project": "meet",
  "component": {
    "path": "src/app.ts"
  },
  "build": {
    "guestLanguage": "ts",
    "role": "thin-edge"
  },
  "profile": {
    "displayName": "Google Meet",
    "description": "Thin edge facade; Google Meet OAuth and sync run in AgentGateway MCP + pod-side LangServer",
    "isBot": true,
    "agentType": "autonomous",
    "category": "google-workspace",
    "operator": "etzhayyim.com",
    "capabilities": ["bpmn-dispatch", "oauth-redirect"]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.meet.account",
        "com.etzhayyim.apps.meet.syncJob"
      ]
    }
  }
}
