(ns kotoba.yaml
  "YAML emission for EDN, with local tags — the surface `kotoba-lang/ocio`
  is written against.

  This namespace did not exist. `ocio` declared `io.github.kotoba-lang/yaml`
  as its only dependency and required `kotoba.yaml` from every one of its
  functions, and the repository behind that coordinate held a LICENSE and a
  scaffold README. The consequence was not a failing test — it was that
  `kbb -M:test` could not build a classpath at all, so the OCIO config
  builders had never been loaded, let alone run, and the repository looked
  finished from the outside.

  What is emitted is the block subset YAML configs are written in: nested
  mappings, block sequences, and local tags (`!<ColorSpace>`) which OCIO uses
  and which most emitters do not offer. It is not a general YAML writer —
  anchors, aliases, flow style, multi-document streams and folded scalars are
  all absent, and `yaml` says so by refusing rather than by emitting
  something that parses to a different value."
  (:require [kotoba.lang.text :as string]))

(defn ytag
  "Attach a YAML local tag to a value: `!<kind>`."
  [kind value] {::tag kind ::val value})

(defn tagged? [x] (and (map? x) (contains? x ::tag)))

(defn- scalar? [x]
  (or (nil? x) (string? x) (number? x) (boolean? x) (keyword? x) (symbol? x)))

(defn- render-scalar [x]
  (cond
    (nil? x) "null"
    (keyword? x) (name x)
    (symbol? x) (str x)
    (boolean? x) (str x)
    (number? x) (str x)
    (string? x) (if (or (= "" x)
                        (re-find #"^[-?:,\[\]{}#&*!|>'\"%@`]" x)
                        (string/includes? x ": ")
                        (string/includes? x "\n")
                        (re-matches #"(?i)true|false|null|~|[-+]?[0-9.]+([eE][-+]?[0-9]+)?" x))
                  (str "\"" (string/replace x "\"" "\\\"") "\"")
                  x)))

(defn- render-key [k] (if (keyword? k) (name k) (str k)))

(declare emit-map emit-seq)

(defn- pad [n] (apply str (repeat n " ")))

(defn- emit-value
  "Lines for `v` appearing after `prefix` at `indent`. Scalars go on the prefix
  line; everything else opens a block underneath it."
  [prefix v indent]
  (cond
    (scalar? v) [(str prefix (render-scalar v))]
    (tagged? v) (into [(str prefix "!<" (::tag v) ">")]
                      (emit-value "" (::val v) indent))
    (map? v) (emit-map v indent)
    (sequential? v) (emit-seq v indent)
    :else (throw (ex-info (str "kotoba.yaml cannot emit a " (type v)
                               " — this is the block subset (mappings, sequences,"
                               " scalars, local tags), not all of YAML")
                          {:value v}))))

(defn- emit-map [m indent]
  (mapcat (fn [[k v]]
            (let [prefix (str (pad indent) (render-key k) ": ")]
              (if (or (scalar? v) (tagged? v))
                (emit-value prefix v (+ indent 2))
                (cons (string/trimr prefix) (emit-value "" v (+ indent 2))))))
          m))

(defn- emit-seq [xs indent]
  (mapcat (fn [x]
            (let [prefix (str (pad indent) "- ")]
              (cond
                (scalar? x) [(str prefix (render-scalar x))]
                (tagged? x) (into [(str prefix "!<" (::tag x) ">")]
                                  (emit-value "" (::val x) (+ indent 2)))
                :else (cons (string/trimr prefix) (emit-value "" x (+ indent 2))))))
          xs))

(defn yaml
  "Emit `x` as a YAML document (no trailing newline, no `---`)."
  [x]
  (string/join "\n" (emit-value "" x 0)))
