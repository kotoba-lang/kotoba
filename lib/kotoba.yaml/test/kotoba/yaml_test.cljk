(ns kotoba.yaml-test
  "The emitter is checked by PARSING BACK what it wrote, with a parser it does
  not share code with (clj-yaml / SnakeYAML). An emitter checked only against
  its own expected strings agrees with itself; it does not agree with YAML."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.text :as str]
            [clj-yaml.core :as y]
            [kotoba.yaml :as yaml]))

(defn- reparse [s] (y/parse-string (str/replace s #"!<[A-Za-z0-9_]+>" "")))

(deftest block-subset-shapes
  (is (= "active_displays:\n  - sRGB" (yaml/yaml {:active_displays ["sRGB"]})))
  (is (= "roles:\n  default: raw" (yaml/yaml {:roles {:default "raw"}})))
  (is (= {::yaml/tag "View" ::yaml/val {:name "ACES"}} (yaml/ytag "View" {:name "ACES"})))
  (testing "a tag on a sequence item indents its properties under the dash"
    (is (= "views:\n  - !<View>\n    name: ACES\n    colorspace: ACEScg"
           (yaml/yaml {:views [(yaml/ytag "View" {:name "ACES" :colorspace "ACEScg"})]})))))

(deftest round-trips-through-a-parser-it-does-not-own
  (let [value {:ocio_profile_version 2
               :description "a config with awkward scalars"
               :roles {:scene_linear "ACEScg" :default "raw"}
               :flags {:isdata true :missing nil :count 3 :ratio -0.0055746}
               :active_displays ["sRGB" "Rec.709"]
               :nested {:a {:b {:c ["deep" "er"]}}}}
        parsed (reparse (yaml/yaml value))]
    (is (= 2 (:ocio_profile_version parsed)))
    (is (= "ACEScg" (get-in parsed [:roles :scene_linear])))
    (is (true? (get-in parsed [:flags :isdata])))
    (is (nil? (get-in parsed [:flags :missing])))
    (is (= 3 (get-in parsed [:flags :count])))
    (is (< (Math/abs (- (get-in parsed [:flags :ratio]) -0.0055746)) 1e-12))
    (is (= ["sRGB" "Rec.709"] (vec (:active_displays parsed))))
    (is (= ["deep" "er"] (vec (get-in parsed [:nested :a :b :c]))))))

(deftest strings-that-would-parse-as-something-else-are-quoted
  ;; The failure this prevents is silent: `version: 2` and `version: "2"` are
  ;; both valid YAML and mean different things, so an emitter that does not
  ;; quote round-trips a string into a number and nobody sees an error.
  (doseq [s ["2" "true" "null" "3.14" "-1" "yes: no" "" "*anchor" "#hash"]]
    (let [parsed (reparse (yaml/yaml {:v s}))]
      (is (= s (:v parsed)) (str "the string " (pr-str s) " came back as "
                                 (pr-str (:v parsed))))))
  (testing "and a genuine number still comes back a number"
    (is (= 2 (:v (reparse (yaml/yaml {:v 2})))))))

(deftest it-refuses-what-it-cannot-write
  ;; The subset is the honest part. Emitting a set as if it were a sequence
  ;; would produce a document that parses — into a value with a different
  ;; ordering than the one handed in.
  (is (thrown? clojure.lang.ExceptionInfo (yaml/yaml {:v #{1 2 3}})))
  (is (str/includes? (try (yaml/yaml {:v #{1}}) (catch clojure.lang.ExceptionInfo e (.getMessage e)))
                     "block subset")))
