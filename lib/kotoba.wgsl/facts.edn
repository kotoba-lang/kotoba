;; Regulatory source register for kotoba-lang/wgsl — WGSL-as-data.
;;
;; This repository is the SSfT for hiccup → WGSL (ADR-2607102200): it maps
;; data into WGSL source text. Every mapping claim in src/kami/wgsl rests on
;; the WGSL specification — which document defines the syntax this library
;; emits. Until this file existed, nothing in the repository traced that
;; obligation to the document it comes from. This is that list.
;;
;; Shape is tx-data (a vector of entity maps), like every other EDN corpus in
;; this workspace, so it loads with
;;   (d/transact conn (edn/read-string (slurp "facts.edn")))
;; :source/id is the join key. A document or page not in this table has NO
;; spec-basis for this repository -- extend the table, never invent an id or
;; a URL.
;;
;; VERIFIED BY `nbb scripts/verify-facts.cljk`, which re-fetches every entry.
;; Each carries a :source/verify tag naming WHICH check establishes it:
;;   :page-identity  2xx, final URL still the page asked for, declared
;;                   charset, and the <title> recorded below.
;;   :page-text      All of :page-identity, plus every string in
;;                   :page/must-contain present in the de-tagged body.
;;
;; NO LAW IS CITED AND NO STANDARDS-BODY PDF IS CITED. This register's
;; authority surface is the WGSL editor's draft served by GitHub Pages, and
;; the gpuweb repository that produces it. Nothing here asserts Japanese
;; legal obligations, NIST conformance, or article-level spec text, because
;; none of that was read.
;;
;; WHY THE W3C PUBLICATION SURFACE IS NOT CITED. www.w3.org/TR/WGSL/ is the
;; W3C's own copy of the same specification. Measured 2026-09-01: a scripted
;; client receives HTTP 403 with a 5681-byte Cloudflare "Just a moment..."
;; challenge body from that host -- the authority declining to answer, not a
;; verdict about the URL. Not-cited is not absent: the :coverage entity below
;; records the refusal so a reader knows it was looked for and measured, not
;; overlooked.
;;
;; HOST ASSUMPTIONS ARE MEASURED AT RUN TIME, NOT DATED IN A COMMENT.
;; The :host-behaviour entities say what each host does with a path that does
;; not exist, and the verifier re-measures that on every run. A dated note
;; saying "measured to refuse correctly" degrades into a constant the moment
;; it is written; a declaration the run re-measures cannot.
;;
;; Claims stop at the level actually checked -- document identity, and for
;; the :page-text entry the strings read on 2026-09-01. No grammar rule, no
;; algorithm mapping, and no conformance claim is asserted, because none of
;; that was read.

[
 ;; ── What each host does with a path that does not exist ────────────────────
 ;; Re-measured on every run. A change here invalidates the check that rests
 ;; on it, which is the point of writing it down as data.

 {:source/id "host.gpuweb-github-io"
  :source/kind :host-behaviour
  :host/name "gpuweb.github.io"
  :host/missing-path :refuses
  :host/missing-status 404
  :source/note "Re-measured 2026-09-01: a nonexistent path answers 404 with a
                9379-byte GitHub Pages 404 page at the requested URL, no
                redirect, charset utf-8. The spec page itself answers 200 with
                title `WebGPU Shading Language` (3092729 bytes). :refuses
                because the path is answered with a real status-and-body that
                is not the page asked for."}

 {:source/id "host.github-com"
  :source/kind :host-behaviour
  :host/name "github.com"
  :host/missing-path :refuses
  :host/missing-status 404
  :source/note "Re-measured 2026-09-01: a nonexistent repository path answers
                404 with GitHub's real Not Found page (304029 bytes) at the
                requested URL, no redirect. The repository page and the blob
                view cited below both answer 200 at the requested URL. :refuses
                because the path is answered with a real status-and-body that
                is not the page asked for."}

 ;; ── Coverage of what this register does NOT cite ─────────────────────────

 {:source/id "coverage.wgsl"
  :source/kind :coverage
  :coverage/entries 3
  :coverage/by-verify {:page-identity 2 :page-text 1}
  :source/note "2 :page-identity entries, 1 :page-text entry, and 2
                :host-behaviour entities. NOT CITED: www.w3.org/TR/WGSL/ --
                measured 2026-09-01 it answers HTTP 403 with a Cloudflare
                'Just a moment...' challenge body to a scripted client, so
                the W3C publication surface could not be measured. The
                editor's draft at gpuweb.github.io carries the same
                specification text and is what this register cites. Also not
                cited: the raw Bikeshed source
                (raw.githubusercontent.com/gpuweb/gpuweb/main/wgsl/index.bs,
                measured 200 / 924796 bytes / text/plain) -- it is a
                title-less plain-text document, and this register's
                :page-identity check reads a <title>. A future entry for it
                needs its own verify mode, not a title invented for it."}

 ;; ── The specification this library implements ────────────────────────────
 ;; Titles and strings are exactly what the hosts returned at retrieval time,
 ;; re-verified 2026-09-01.

 {:source/id "page.gpuweb-wgsl-spec"
  :source/kind :page
  :source/title "WebGPU Shading Language"
  :source/publisher "GPU for the Web Community Group (gpuweb, editor's draft)"
  :source/url "https://gpuweb.github.io/gpuweb/wgsl/"
  :page/title "WebGPU Shading Language"
  :source/verify :page-identity
  :source/retrieved-at "2026-09-01"
  :source/covers #{:wgsl-specification :syntax-reference}
  :source/note "The WGSL editor's draft -- the document the syntax this
                library emits is defined by. 3092729 bytes, charset utf-8,
                served at the requested URL with no redirect. Charset is left
                undeclared so the entry joins the verifier's :page-identity
                self-test pool -- a declared charset that the host always
                honours is a constant the check never tests."}

 {:source/id "page.gpuweb-repo"
  :source/kind :page
  :source/title "GitHub - gpuweb/gpuweb: Where the GPU for the Web work happens! · GitHub"
  :source/publisher "gpuweb (GitHub)"
  :source/url "https://github.com/gpuweb/gpuweb"
  :page/title "GitHub - gpuweb/gpuweb: Where the GPU for the Web work happens! · GitHub"
  :source/verify :page-identity
  :source/retrieved-at "2026-09-01"
  :source/covers #{:spec-development-repository :wgsl-issues}
  :source/note "The gpuweb repository -- where WGSL itself is developed, and
                where the issues that change the syntax land before the draft
                picks them up. 300801 bytes, charset utf-8, served at the
                requested URL with no redirect. Charset is left undeclared so
                this entry joins the self-test pool alongside
                page.gpuweb-wgsl-spec -- two distinct hosts, so the
                :page branches of the self-tests do not all burst one host."}

 {:source/id "page.gpuweb-wgsl-bikeshed-source"
  :source/kind :page
  :source/title "gpuweb/wgsl/index.bs at main · gpuweb/gpuweb · GitHub"
  :source/publisher "gpuweb (GitHub)"
  :source/url "https://github.com/gpuweb/gpuweb/blob/main/wgsl/index.bs"
  :page/title "gpuweb/wgsl/index.bs at main · gpuweb/gpuweb · GitHub"
  :page/charset "utf-8"
  :source/verify :page-text
  :page/must-contain ["gpuweb/wgsl/index.bs" "main · gpuweb/gpuweb"]
  :source/retrieved-at "2026-09-01"
  :source/covers #{:spec-source-document}
  :source/note "GitHub's rendered view of wgsl/index.bs, the Bikeshed source
                document of the specification. 231530 bytes, charset utf-8,
                served at the requested URL with no redirect. Title and the
                must-contain strings were all read at retrieval time (the
                second needle is the breadcrumb `main · gpuweb/gpuweb`); the
                needles discriminate this specific blob view from a generic
                GitHub 404/error/repo page. The source text itself is not
                embedded in the served HTML -- the needles name the document
                and its location, not its contents."}
]
