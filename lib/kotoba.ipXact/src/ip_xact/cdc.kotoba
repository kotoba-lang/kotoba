;; Port of ip-xact.cdc (cdc.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from cdc.cljk:
;;   - crossing-types, synchronizer-types and cdc-violation-kinds are zero-arg
;;     functions (sets).
;;   - analyze-cdc: a missing :width reads as 0 and skips the multi-bit check;
;;     the source throws (nil > 1) there.
;;   - The fifo-async check is kept as in the source. Its crossing-type is only
;;     ever :single-bit or :multi-bit, so that branch never fires there either.

(ns ip-xact.cdc
  (:export [crossing-types synchronizer-types cdc-violation-kinds
            cdc-crossing cdc-violation cdc-report clock-domain cdc-signal analyze-cdc]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- truthy-doc? [d :document] :bool
  (not (or (document-equal? d (document-null))
           (document-equal? d (document-bool false)))))

(defn crossing-types [] :document
  (document-set (document-keyword :single-bit)
                (document-keyword :multi-bit)
                (document-keyword :handshake)
                (document-keyword :fifo-async)))

(defn synchronizer-types [] :document
  (document-set (document-keyword :two-ff)
                (document-keyword :three-ff)
                (document-keyword :gray-code)
                (document-keyword :mux-sync)))

(defn cdc-violation-kinds [] :document
  (document-set (document-keyword :missing-synchronizer)
                (document-keyword :convergence-issue)
                (document-keyword :reconvergence-issue)
                (document-keyword :glitch-prone)))

(defn cdc-crossing [signal-name :document from-clock :document to-clock :document crossing-type :document synchronizer :document] :document
  (document-map :signal-name signal-name
                :from-clock from-clock
                :to-clock to-clock
                :crossing-type crossing-type
                :synchronizer synchronizer))

(defn cdc-violation [signal :document issue :document] :document
  (document-map :signal signal :issue issue))

(defn cdc-report [crossings :document violations :document] :document
  (document-map :crossings crossings
                :violations violations))

(defn clock-domain [name :document freq-mhz :document] :document
  (document-map :name name :freq-mhz freq-mhz))

(defn cdc-signal [sig :document] :document
  (document-map :name (field sig :name)
                :source-clock (field sig :source-clock)
                :dest-clock (field sig :dest-clock)
                :width (field sig :width)
                :has-synchronizer (field sig :has-synchronizer)
                :synchronizer (field sig :synchronizer)))

(defn- clock-known? [clocks :document name :document i :i64] :bool
  (if (>= i (document-count clocks))
    false
    (if (document-equal? (field (option-or (document-vector-at clocks i) (document-null)) :name) name)
      true
      (clock-known? clocks name (+ i 1)))))

(defn- width-of [sig :document] :i64
  (option-or (document-i64-value (field sig :width)) 0))

(defn- analyze-loop [signals :document clocks :document i :i64 crossings :document violations :document] :document
  (if (>= i (document-count signals))
    (cdc-report crossings violations)
    (let [sig (option-or (document-vector-at signals i) (document-null))
          src (field sig :source-clock)
          dst (field sig :dest-clock)
          width (width-of sig)
          synchronized (truthy-doc? (field sig :has-synchronizer))
          synchronizer (field sig :synchronizer)
          single (document-equal? (field sig :width) (document-i64 1))
          crossing-type (if single (document-keyword :single-bit) (document-keyword :multi-bit))]
      (if (or (document-equal? src dst)
              (not (clock-known? clocks src 0))
              (not (clock-known? clocks dst 0)))
        (analyze-loop signals clocks (+ i 1) crossings violations)
        (let [name (field sig :name)
              crossing (cdc-crossing name src dst crossing-type synchronizer)
              crossings2 (document-vector-conj crossings crossing)
              violations2 (if synchronized
                            violations
                            (document-vector-conj violations
                                                  (cdc-violation name (document-keyword :missing-synchronizer))))
              glitch (and (> width 1)
                          (not (document-equal? synchronizer (document-keyword :gray-code)))
                          (not (document-equal? crossing-type (document-keyword :fifo-async)))
                          synchronized)
              violations3 (if glitch
                            (document-vector-conj violations2
                                                  (cdc-violation name (document-keyword :glitch-prone)))
                            violations2)]
          (analyze-loop signals clocks (+ i 1) crossings2 violations3))))))

(defn analyze-cdc [signals :document clocks :document] :document
  (analyze-loop signals clocks 0 (document-vector) (document-vector)))
