(ns ip-xact.cdc-test (:export [main]) (:require [ip-xact.cdc :as p]))

(defn- ok [b :bool] :i64
  (if b 0 1))

(defn- sig [n :string src :string dst :string width :i64 has-sync :bool sync :document] :document
  (document-map :name (document-string n)
                :source-clock (document-string src)
                :dest-clock (document-string dst)
                :width (document-i64 width)
                :has-synchronizer (document-bool has-sync)
                :synchronizer sync))

(defn- clocks [] :document
  (document-vector (p/clock-domain (document-string "clk1") (document-f64 100.0))
                   (p/clock-domain (document-string "clk2") (document-f64 200.0))))

(defn- signals [] :document
  (document-vector (sig "a" "clk1" "clk1" 1 true (document-keyword :two-ff))
                   (sig "b" "clk1" "clk2" 1 true (document-keyword :two-ff))
                   (sig "c" "clk1" "clk2" 1 false (document-keyword :two-ff))
                   (sig "d" "clk1" "clk2" 8 true (document-keyword :two-ff))
                   (sig "e" "clk1" "clk2" 8 true (document-keyword :gray-code))
                   (sig "f" "clk1" "nope" 1 true (document-keyword :two-ff))))

(defn- expected-report [] :document
  (p/cdc-report
   (document-vector (p/cdc-crossing (document-string "b") (document-string "clk1") (document-string "clk2")
                                    (document-keyword :single-bit) (document-keyword :two-ff))
                    (p/cdc-crossing (document-string "c") (document-string "clk1") (document-string "clk2")
                                    (document-keyword :single-bit) (document-keyword :two-ff))
                    (p/cdc-crossing (document-string "d") (document-string "clk1") (document-string "clk2")
                                    (document-keyword :multi-bit) (document-keyword :two-ff))
                    (p/cdc-crossing (document-string "e") (document-string "clk1") (document-string "clk2")
                                    (document-keyword :multi-bit) (document-keyword :gray-code)))
   (document-vector (p/cdc-violation (document-string "c") (document-keyword :missing-synchronizer))
                    (p/cdc-violation (document-string "d") (document-keyword :glitch-prone)))))

(defn main [] :i64
  (ok (document-equal? (p/analyze-cdc (signals) (clocks)) (expected-report))))
