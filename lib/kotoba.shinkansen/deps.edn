{:paths ["src"]
 ;; No :local/root here. This library is consumed as a :git/sha dependency
 ;; (app-kotoba-cloud, 2026-09-15) and a consumer's tools.deps resolves a
 ;; :local/root relative to ITS git cache — "Local lib content-address not
 ;; found: ~/.gitlibs/libs/io.github.kotoba-lang/shinkansen/content-address"
 ;; was the measured failure. The former content-address / io-ipld /
 ;; io-multiformats roots were also unused: no src ns requires them (the CID
 ;; hash function is injected into shinkansen.state; see jp-go-dds's deps.edn
 ;; for the same rule stated from the library side). If a real dependency on
 ;; them appears, declare it as :git/sha.
 :deps {
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
