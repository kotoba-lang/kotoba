(ns bench-report
  "bench/results/<run>.edn → docs/bench.md + docs/index.html (the GitHub Pages
  site). Every number on both comes from the results file, so the published
  page cannot drift from the run; the framework versions come from
  bench/package.json, which is what `npm i --prefix bench` installed.

  Refuses (exit 2, nothing written) when the results file has no medians or
  any median is invalid — a page must not publish a run the harness itself
  marked INVALID.

  Run (from the repo root; the classpath is jp-go-dds and what it needs):
    kbb --backend sci --classpath <K>/jp-go-digital-design-system/src:<K>/html/src:<K>/css/src:<K>/text/src \\
        bench/report.cljk bench/results/2026-09-23-meta.edn
  with K = the superproject's orgs/kotoba-lang (KOTOBA_LANG). The page's
  stylesheet is the vendored DADS css, read from K."
  (:require [cljs.reader :as edn]
            [clojure.string :as str]
            [jp-go-dds.core :as dds]
            [jp-go-dds.page :as page]
            [jp-go-dds.tokens :as tokens]
            ["node:fs" :as fs]
            ["node:path" :as path]))

(def frameworks
  "Display order and names; `:pkg` names the bench/package.json entry whose
   version is shown (nil = the Node built-in)."
  [{:fw "shinkansen" :label "shinkansen" :pkg nil :note "this repo"}
   {:fw "node-http" :label "node:http" :pkg nil :note "raw Node, no framework"}
   {:fw "fastify" :label "Fastify" :pkg "fastify"}
   {:fw "hono" :label "Hono" :pkg "hono"}
   {:fw "express" :label "Express" :pkg "express"}
   {:fw "nextjs" :label "Next.js" :pkg "next"}
   {:fw "nuxt" :label "Nuxt" :pkg "nuxt"}])

(def scenarios
  [{:scenario "static" :label "Static page" :what "GET / — an 11.6 KB prerendered page, 200 + ETag"}
   {:scenario "304" :label "Revalidation (304)" :what "GET / with If-None-Match = that ETag"}
   {:scenario "ssr" :label "SSR, data unchanged" :what "GET /todos/t3 — rendered from path params + loaded data"}
   {:scenario "ssr-miss" :label "SSR, data changes every request" :what "GET /live — nothing may be answered from memory"}])

;; ── model ─────────────────────────────────────────────────────────────────

(defn- read-results [file]
  (let [r (edn/read-string (str (fs/readFileSync file "utf8")))]
    (when (or (empty? (:medians r)) (some (complement :valid?) (:medians r)))
      (println (str "REFUSE\t" file ": no medians, or a median the harness marked INVALID"))
      (set! (.-exitCode js/process) 2)
      (throw (js/Error. "refused")))
    r))

(defn- versions []
  (let [deps (js->clj (.-dependencies (js/JSON.parse (fs/readFileSync "bench/package.json" "utf8"))))]
    (fn [pkg] (get deps pkg))))

(defn- cell [medians fw sc] (some #(when (and (= fw (:fw %)) (= sc (:scenario %))) %) medians))

(defn- rows
  "Per scenario: each framework's cpu-us, rps, p99, the lowest cpu-us, and
   the ratio to shinkansen."
  [{:keys [medians]}]
  (for [{:keys [scenario] :as sc} scenarios]
    (let [cs (for [f frameworks :let [m (cell medians (:fw f) scenario)] :when m] (merge f m))
          best (apply min (map :cpu-us cs))
          ours (:cpu-us (some #(when (= "shinkansen" (:fw %)) %) cs))]
      (assoc sc :cells (for [c cs] (assoc c :best? (= best (:cpu-us c))
                                          :x-ours (when ours (/ (:cpu-us c) ours))))))))

(defn- fmt-us [x] (let [v (/ (js/Math.round (* 10 x)) 10)] (.toLocaleString v "en-US" #js {:minimumFractionDigits 1 :maximumFractionDigits 1})))
(defn- fmt-int [x] (.toLocaleString (js/Math.round x) "en-US"))
(defn- fmt-x [x] (if (< (js/Math.abs (- x 1)) 0.005) "1.0×" (str (.toFixed x (if (< x 10) 1 0)) "×")))

;; ── facts the prose states, computed (never typed) ─────────────────────────

(defn- facts [{:keys [medians load]}]
  (let [cpu (fn [fw sc] (:cpu-us (cell medians fw sc)))
        ratio (fn [a b] (when (and a b) (/ a b)))
        la (:loadavg load)]
    {:miss-vs-node (ratio (cpu "shinkansen" "ssr-miss") (cpu "node-http" "ssr-miss"))
     :miss-vs-next (ratio (cpu "nextjs" "ssr-miss") (cpu "shinkansen" "ssr-miss"))
     :loadavg (when (seq la) (.toFixed (first la) 0))}))

(defn- honest-lines [r]
  (let [{:keys [miss-vs-node miss-vs-next loadavg]} (facts r)]
    [(str "Already-answered URLs come from a table of pre-encoded bytes: the ETag is the CID of those bytes, "
          "so the answer is a value. That is where the static and 304 numbers come from.")
     (str "When the data changes on every request, shinkansen costs " (fmt-x miss-vs-node)
          " the CPU of plain node:http: the app's render and the CID encoding run interpreted (kbb/sci), "
          "the others run V8-JIT'd JavaScript."
          (when miss-vs-next
            (if (> miss-vs-next 1)
              (str " Next.js costs " (fmt-x miss-vs-next) " of shinkansen there.")
              (str " Next.js is below it there (" (fmt-x (/ 1 miss-vs-next)) ")."))))
     (str "Compiling that render instead (.kotoba, amu --target js) is not a way out yet: after "
          "kotoba-lang/kotoba-script#103 (fixed; it was ~50× slower) it measures ~3–6× the interpreted .cljc, "
          "the rest being per-call type checks (#104). See bench/README.md.")
     (str "Next.js and Nuxt serve the same bytes through Route Handlers and Nitro server routes, each with its best "
          "documented static option. Next.js's force-static route ignores If-None-Match, so its 304 runs on a dynamic handler.")
     (str "The machine was shared"
          (if loadavg (str " (1-minute load average " loadavg " when the run finished)") "")
          ". CPU per response holds up under that; requests per second does not.")]))

;; ── markdown ──────────────────────────────────────────────────────────────

(defn- md [{:keys [measured-at machine load] :as r} version-of source]
  (let [rs (rows r)
        head (str "| | " (str/join " | " (map :label frameworks)) " |\n"
                  "|---|" (str/join "" (repeat (count frameworks) "---:|")) "\n")]
    (str
     "# shinkansen benchmark\n\n"
     "<!-- GENERATED by bench/report.cljk from " source " — do not edit; re-run the report -->\n\n"
     "Server CPU time per response, in microseconds (median of " (:rounds load) " interleaved rounds; "
     "**lower is better**, best in bold). Measured " (subs measured-at 0 10) " on "
     (:cpus machine) " CPUs, Node " (:node machine) ", " (:connections load) " connections, "
     (:duration load) " s per run.\n\n"
     head
     (str/join
      (for [{:keys [label cells]} rs]
        (str "| " label " | "
             (str/join " | " (for [f frameworks
                                   :let [c (some #(when (= (:fw f) (:fw %)) %) cells)]]
                               (cond (nil? c) "—"
                                     (:best? c) (str "**" (fmt-us (:cpu-us c)) "**")
                                     :else (fmt-us (:cpu-us c)))))
             " |\n")))
     "\nRequests per second (what the load generator saw — moves with everything else on the machine; "
     "rank by CPU above):\n\n"
     head
     (str/join
      (for [{:keys [label cells]} rs]
        (str "| " label " | "
             (str/join " | " (for [f frameworks :let [c (some #(when (= (:fw f) (:fw %)) %) cells)]]
                               (if c (fmt-int (:rps c)) "—")))
             " |\n")))
     "\n## What each scenario is\n\n"
     (str/join (for [{:keys [label what]} scenarios] (str "- **" label "** — " what "\n")))
     "\n## Versions\n\n"
     (str/join (for [{:keys [label pkg note]} frameworks]
                 (str "- " label " " (if pkg (version-of pkg) (if (= label "shinkansen") "(this commit)" (:node machine)))
                      (when note (str " — " note)) "\n")))
     "\n## Reading it honestly\n\n"
     (str/join (for [l (honest-lines r)] (str "- " l "\n")))
     "\n"
     "Method, fixtures and how to re-run: [bench/README.md](https://github.com/kotoba-lang/shinkansen/blob/main/bench/README.md). "
     "Raw medians: [" source "](https://github.com/kotoba-lang/shinkansen/blob/main/" source ").\n")))

;; ── html (jp-go-dds) ──────────────────────────────────────────────────────

(def app-css
  ;; the --hig-* contract only (tokens/bridge-css resolves it on DADS)
  (str ".bench-best{font-weight:700}"
       ".bench-num{text-align:end;font-variant-numeric:tabular-nums;white-space:nowrap}"
       ".bench-bar{display:block;height:var(--hig-spacing-1);margin-top:var(--hig-spacing-1);"
       "background:var(--hig-color-tint);border-radius:var(--hig-radius-xs)}"
       ".bench-scroll{overflow-x:auto}"
       ".bench-note{color:var(--hig-color-secondary-label)}"
       ;; phones: the tables scroll inside their own box; give the page its edge back
       "@media (max-width:480px){.dds-ext-container{padding-inline:var(--hig-spacing-2)}"
       ".bench-num{font-size:var(--hig-text-footnote-font-size)}}"))

(defn- cpu-cell [{:keys [cpu-us best? x-ours]} worst]
  [:span
   [:span {:class (str "bench-num" (when best? " bench-best"))}
    (fmt-us cpu-us) (when best? " (best)")]
   ;; a bar per cell, linear against the slowest in the table: a log scale
   ;; drew 36 µs and 205 µs nearly the same length (looked at, 2026-09-23)
   [:span {:class "bench-bar" :aria-hidden "true"
           :style (str "width:" (.toFixed (max 1 (* 100 (/ cpu-us worst))) 1) "%")}]])

(defn- scenario-table [{:keys [label what cells]}]
  (let [worst (apply max (map :cpu-us cells))]
    (dds/section {:title label}
                 [:p {:class "bench-note"} what]
                 [:div {:class "bench-scroll"}
                  (dds/table {:caption (str label " — server CPU per response (µs, lower is better)")
                              :headers ["Framework" "CPU µs / response" "vs shinkansen" "Requests / s" "p99 ms"]
                              :row-header? true
                              :rows (for [c (sort-by :cpu-us cells)]
                                      [(:label c)
                                       (cpu-cell c worst)
                                       [:span {:class "bench-num"} (if (:x-ours c) (fmt-x (:x-ours c)) "—")]
                                       [:span {:class "bench-num"} (fmt-int (:rps c))]
                                       [:span {:class "bench-num"} (str (:p99 c))]])})])))

(defn- html [{:keys [measured-at machine load] :as r} version-of source]
  (let [css (str (fs/readFileSync (path/join (or (.-KOTOBA_LANG js/process.env) "../../com-junkawasaki/orgs/kotoba-lang")
                                             "jp-go-digital-design-system/resources/jp_go_dds/dds.css") "utf8"))]
    (page/->page
     {:title "shinkansen benchmark"
      :description "Server CPU per response: shinkansen vs node:http, Fastify, Hono, Express, Next.js and Nuxt."
      :lang "en"
      :css css
      :dark? true
      :app-css (str tokens/bridge-css "\n" app-css)}
     [:main
      (dds/container
       [:h1 "shinkansen benchmark"]
       [:p "Server CPU per response vs six Node frameworks, same bytes, same load. Lower is better."]
       [:details
        [:summary "Run"]
        [:p (subs measured-at 0 10) " · " (:cpus machine) " CPUs · Node " (:node machine)
         " · " (:connections load) " connections · " (:duration load) " s × " (:rounds load) " rounds (median)"]]
       (for [s (rows r)] (scenario-table s))
       (dds/section {:title "Reading it honestly"}
                    (into [:ul] (for [l (honest-lines r)] [:li l])))
       (dds/section {:title "Versions"}
                    [:ul (for [{:keys [label pkg]} frameworks]
                           [:li label " " (if pkg (version-of pkg) (if (= label "shinkansen") "(this commit)" (:node machine)))])])
       [:p
        (dds/link {:href "https://github.com/kotoba-lang/shinkansen/blob/main/bench/README.md"} "Method and fixtures")
        " · "
        (dds/link {:href (str "https://github.com/kotoba-lang/shinkansen/blob/main/" source)} "Raw medians")
        " · "
        (dds/link {:href "https://github.com/kotoba-lang/shinkansen"} "Source")])])))

(defn -main [source]
  (let [r (read-results source)
        v (versions)]
    (fs/mkdirSync "docs" #js {:recursive true})
    (fs/writeFileSync "docs/bench.md" (md r v source))
    (fs/writeFileSync "docs/index.html" (html r v source))
    ;; serve files as they are (no Jekyll: SPEC.md etc. stay raw, _-prefixed paths survive)
    (fs/writeFileSync "docs/.nojekyll" "")
    (println (str "WROTE\tdocs/bench.md\t" (.-length (fs/readFileSync "docs/bench.md"))))
    (println (str "WROTE\tdocs/index.html\t" (.-length (fs/readFileSync "docs/index.html"))))))

(if-let [src (first *command-line-args*)]
  (-main src)
  (do (println "usage: bench/report.cljk bench/results/<run>.edn") (set! (.-exitCode js/process) 2)))
