(ns shinkansen-server
  "Bench fixture: the reference app on `shinkansen.serve`, production ctx
  (no dev reload), seeded with `SEED` todos so the :ssr routes render a
  real list. Prints `PORT<TAB>n` once listening and writes the fixture the
  competitor servers serve (same home bytes, same todos) to `FIXTURE`.

  Run: kbb --backend sci --classpath <shinkansen src:examples + siblings> bench/shinkansen_server.cljk"
  (:require [reference-app :as app]
            [shinkansen.serve :as serve]
            ["node:fs" :as fs]))

(let [env js/process.env
      port (js/parseInt (or (.-PORT env) "0"))
      seed (js/parseInt (or (.-SEED env) "20"))
      ctx0 (app/make-ctx)
      state (get-in ctx0 [:app :state])
      n (atom 0)
      ;; /live: data changes on every request (ssr-miss), so the station
      ;; table may never answer it — render + CID per request
      ctx (-> ctx0
              (update-in [:tree :children] conj {:path "live" :document :live})
              (assoc-in [:documents :live]
                        {:mode :ssr
                         :load-fn (fn [_] {:n (swap! n inc) :todos (get-in @state [:db :todos])})
                         :render-fn (fn [_ {:keys [n todos]}]
                                      (str app/head "<h1>live " n "</h1><ul>"
                                           (apply str (for [t todos]
                                                        (str "<li>" (app/esc (:text t)) (when (:done t) " ✓") "</li>")))
                                           "</ul></body></html>"))}))]
  (swap! state assoc-in [:db :todos]
         (vec (for [i (range seed)]
                {:id (str "t" (inc i)) :text (str "todo <" (inc i) "> & more") :done (even? i)})))
  (when-let [f (.-FIXTURE env)]
    (fs/writeFileSync f (js/JSON.stringify
                         (clj->js {:home app/home-html
                                   :todos (get-in @state [:db :todos])
                                   :height 0}))))
  (-> (serve/start {:ctx ctx :port port :host "127.0.0.1"})
      (.then (fn [{:keys [port]}] (println (str "PORT\t" port))))))
