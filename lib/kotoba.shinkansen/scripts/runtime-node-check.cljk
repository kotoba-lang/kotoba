(ns runtime-node-check
  "Executes the interaction runtime string in this Node process against a
  minimal document/fetch double and asserts what a static needle test
  cannot: that streamRun delivers frames from BOTH wire shapes (SSE
  `data:` lines and newline-delimited JSON), that a host-supplied fetch is
  used, that a non-2xx response reaches onError unread, and that
  locale.format fills placeholders with Intl numbers for <html lang>.
  Prints `SCANNED<TAB>n` (n = checks executed); exit 1 on any failure,
  2 when node itself refused to run the runtime.

  Run: kbb --backend sci --classpath src scripts/runtime-node-check.cljk"
  (:require [shinkansen.interaction :as i]
            [clojure.string :as str]))

(def harness
  (str
   "var frames=[];var closes=0;var errors=[];var fetched=[];var listeners={};"
   "globalThis.document={cookie:'',documentElement:{getAttribute:function(k){return k==='lang'?'en':null;},setAttribute:function(){},removeAttribute:function(){}},addEventListener:function(t,f){(listeners[t]=listeners[t]||[]).push(f);},removeEventListener:function(){},querySelectorAll:function(){return [];}};"
   "globalThis.location={protocol:'http:',assign:function(){},reload:function(){}};"
   "globalThis.window=globalThis;globalThis.matchMedia=function(){return {matches:false,addEventListener:function(){}};};"
   "globalThis.CustomEvent=function(t,o){this.type=t;this.detail=o&&o.detail;};globalThis.document.dispatchEvent=function(){};"
   "globalThis.localStorage={getItem:function(){return null;},setItem:function(){},removeItem:function(){}};"
   "function body(text){var enc=new TextEncoder();var chunks=[enc.encode(text.slice(0,7)),enc.encode(text.slice(7))];var i=0;"
   "return {getReader:function(){return {read:function(){if(i<chunks.length)return Promise.resolve({done:false,value:chunks[i++]});return Promise.resolve({done:true});}};}};}"
   "globalThis.fetch=function(url,opts){fetched.push(url);if(url==='/sse')return Promise.resolve({ok:true,body:body('data: {\"event\":\"a\"}\\n: keepalive\\ndata: [DONE]\\ndata: {\"event\":\"b\"}\\n')});"
   "if(url==='/ndjson')return Promise.resolve({ok:true,body:body('{\"type\":\"delta\",\"content\":\"x\"}\\n\\n{\"type\":\"done\"}\\n')});"
   "if(url.indexOf('/live-stream')===0)return Promise.resolve({ok:true,body:body('data: {\"kind\":\"heartbeat\",\"cursor\":9}\\n')});"
   "return Promise.resolve({ok:false,status:403,json:function(){return Promise.resolve({error:{type:'invalid-csrf'}});}});};"
   ;; a DOM double for the live patcher: insertBefore / removeChild / firstChild / nextSibling / parentNode,
   ;; and a <select> with options (Array.from over .options, hasAttribute, remove)
   "function Node(tag){this.tagName=tag;this.children=[];this.parentNode=null;this.attrs={};this.textContent='';}"
   "Object.defineProperty(Node.prototype,'firstChild',{get:function(){return this.children[0]||null;}});"
   "Object.defineProperty(Node.prototype,'nextSibling',{get:function(){if(!this.parentNode)return null;var c=this.parentNode.children;return c[c.indexOf(this)+1]||null;}});"
   "Node.prototype.insertBefore=function(el,ref){if(el.parentNode)el.parentNode.removeChild(el);var i=ref?this.children.indexOf(ref):this.children.length;if(i<0)i=this.children.length;this.children.splice(i,0,el);el.parentNode=this;return el;};"
   "Node.prototype.appendChild=function(el){return this.insertBefore(el,null);};"
   "Node.prototype.removeChild=function(el){var i=this.children.indexOf(el);if(i>=0)this.children.splice(i,1);el.parentNode=null;return el;};"
   "Node.prototype.remove=function(){if(this.parentNode)this.parentNode.removeChild(this);};"
   "Node.prototype.hasAttribute=function(k){return k in this.attrs;};Node.prototype.setAttribute=function(k,v){this.attrs[k]=v;};Node.prototype.getAttribute=function(k){return this.attrs[k]||null;};"
   "Object.defineProperty(Node.prototype,'options',{get:function(){return this.children;}});"
   "Object.defineProperty(Node.prototype,'value',{get:function(){return this._value||(this.children[0]&&this.children[0]._value)||'';},set:function(v){this._value=v;}});"
   "globalThis.document.createElement=function(tag){return new Node(tag);};globalThis.document.querySelector=function(){return null;};globalThis.document.hidden=false;"
   "globalThis.setTimeout=function(){return 0;};globalThis.clearTimeout=function(){};"
   i/runtime
   "var S=globalThis.shinkansen;"
   ;; --- live: node identity survives frames; order, removal, options
   "var mount=new Node('tbody');var creates=0,patches=0;"
   "var L=S.live(mount,{key:function(r){return r.id;},create:function(r){creates++;var n=new Node('tr');n.textContent=r.id+':'+r.n;return n;},patch:function(el,r){patches++;el.textContent=r.id+':'+r.n;},"
   "view:function(rows){return rows.slice().sort(function(a,b){return b.at-a.at;});}});"
   "L.apply({kind:'snapshot',cursor:1,rows:[{id:'a',n:1,at:1},{id:'b',n:1,at:2}]});"
   "var nodeA=mount.children[1],nodeB=mount.children[0];var liveOrder1=mount.children.map(function(c){return c.textContent;}).join(',');var creates1=creates;"
   "L.apply({kind:'delta',cursor:2,upsert:[{id:'a',n:2,at:1},{id:'c',n:1,at:3}],remove:['b']});"
   "var liveOrder2=mount.children.map(function(c){return c.textContent;}).join(',');var sameA=mount.children[1]===nodeA;var bGone=nodeB.parentNode===null;"
   "var patchesBefore=patches;L.apply({kind:'snapshot',cursor:3,rows:[{id:'a',n:2,at:1},{id:'c',n:1,at:3}]});var noopPatches=patches-patchesBefore;"
   "L.apply({kind:'heartbeat',cursor:4});var liveCursor=L.cursor();var liveRefused=L.apply({kind:'bogus'});"
   "var sel=new Node('select');var all=new Node('option');all._value='all';all.attrs['data-fixed']='';sel.appendChild(all);sel.value='all';"
   "var opt1=L.options(sel,['m1','m2']);var chosen=sel.value;sel.value='m2';var opt2=L.options(sel,['m1','m2']);var kept=sel.value;var opt3=L.options(sel,['m2','m3']);var after=sel.value;"
   "var liveOut={creates:creates,creates1:creates1,patches:patches,order1:liveOrder1,order2:liveOrder2,sameA:sameA,bGone:bGone,noopPatches:noopPatches,cursor:liveCursor,refused:liveRefused,opt:[opt1,opt2,opt3],chosen:chosen,kept:kept,after:after,rows:L.rows().length};"
   ;; --- live: a hidden document fetches nothing (paused); shown again, it connects at once with its cursor
   "document.hidden=true;var states=[];var L2=S.live(new Node('tbody'),{key:function(r){return r.id;},create:function(){return new Node('tr');},patch:function(){},stream:'/live-stream',onState:function(s){states.push(s.state+(s.reason?'/'+s.reason:''));}});"
   "L2.apply({kind:'snapshot',cursor:5,rows:[]});var fetchedHidden=fetched.filter(function(u){return String(u).indexOf('/live-stream')===0;}).length;"
   "document.hidden=false;(listeners.visibilitychange||[]).forEach(function(f){f();});"
   "var fetchedShown=fetched.filter(function(u){return String(u).indexOf('/live-stream')===0;});"
   "S.streamRun('/sse',{onEvent:function(f){frames.push('sse:'+f.event);},onClose:function(){closes++;}});"
   "S.streamRun('/ndjson',{onEvent:function(f){frames.push('nd:'+f.type);},onClose:function(){closes++;}});"
   "S.streamRun(function(opts){fetched.push('fn'+(opts.signal?'+signal':''));return fetch('/denied',opts);},{onError:function(e){errors.push(e.status+':'+(e.response&&typeof e.response.json));},onClose:function(){closes++;}});"
   "var fmt=S.locale.format('{phase} {seconds}s {n} {missing} {gone}',{phase:'model',seconds:1234.5,n:7,gone:null});"
   "globalThis.__later=function(){liveOut.hidden={fetchedHidden:fetchedHidden,fetchedShown:fetchedShown,states:states,cursor:L2.cursor()};process.stdout.write(JSON.stringify({frames:frames,closes:closes,errors:errors,fetched:fetched,fmt:fmt,lang:S.locale.lang(),live:liveOut}));};"
   "Promise.resolve().then(function(){return new Promise(function(res){var t=require('timers');t.setTimeout(res,50);});}).then(globalThis.__later);"))

(def cp (js/require "child_process"))
(def res (.spawnSync cp "node" #js ["-e" harness] #js {:encoding "utf8"}))
(when-not (zero? (.-status res))
  (println "REFUSE node exited" (.-status res) (.-stderr res))
  (js/process.exit 2))
(def out (js->clj (js/JSON.parse (.-stdout res)) :keywordize-keys true))
(def checks
  [["sse frames a,b (DONE and comment skipped)" (= ["sse:a" "sse:b"] (filter #(str/starts-with? % "sse:") (:frames out)))]
   ["ndjson frames delta,done (blank line skipped)" (= ["nd:delta" "nd:done"] (filter #(str/starts-with? % "nd:") (:frames out)))]
   ["every stream closed once" (= 3 (:closes out))]
   ["host fetch fn received opts with signal" (some #{"fn+signal"} (:fetched out))]
   ["non-2xx reaches onError with the unread response" (= ["403:function"] (:errors out))]
   ["format: Intl number for lang=en, hole visible, nil blank" (= "model 1,234.5s 7 {missing} " (:fmt out))]
   ["lang() reads <html lang>" (= "en" (:lang out))]
   ;; live regions (shinkansen.live)
   ["live: a snapshot creates one node per row, in the view's order" (and (= 2 (get-in out [:live :creates1])) (= "b:1,a:1" (get-in out [:live :order1])))]
   ["live: a delta patches the changed row IN PLACE (same node), inserts the new one where the order says, removes by id"
    (and (true? (get-in out [:live :sameA])) (true? (get-in out [:live :bGone])) (= "c:1,a:2" (get-in out [:live :order2])) (= 3 (get-in out [:live :creates])) (= 1 (get-in out [:live :patches])))]
   ["live: a byte-identical snapshot patches nothing" (= 0 (get-in out [:live :noopPatches]))]
   ["live: a heartbeat advances the cursor; a bogus frame is refused" (and (= 4 (get-in out [:live :cursor])) (false? (get-in out [:live :refused])) (= 2 (get-in out [:live :rows])))]
   ["live: options rebuilt only when the set changed, the chosen value kept, the fixed option first"
    (and (= [true false true] (get-in out [:live :opt])) (= "all" (get-in out [:live :chosen])) (= "m2" (get-in out [:live :kept])) (= "m2" (get-in out [:live :after])))]
   ["live: a hidden document fetches nothing and says so (paused/hidden)"
    (and (= 0 (get-in out [:live :hidden :fetchedHidden])) (= "paused/hidden" (first (get-in out [:live :hidden :states]))))]
   ["live: shown again, it connects at once with its cursor and goes live"
    (and (= ["/live-stream?since=5"] (get-in out [:live :hidden :fetchedShown])) (= ["paused/hidden" "live"] (get-in out [:live :hidden :states])) (= 9 (get-in out [:live :hidden :cursor])))]])
(doseq [[label ok] checks] (println (if ok "ok  " "FAIL") label))
(println (str "SCANNED\t" (count checks)))
(when (some (complement second) checks)
  (println (pr-str out))
  (js/process.exit 1))
