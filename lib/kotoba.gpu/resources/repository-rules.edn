;; This repository's entry in the kotoba.repository-role-rules taxonomy.
;; ADR-2607266000 / ADR-2607299000.
{:schema "kotoba.repository-role-rules.v0"
 :this-repo
 {:name "gpu"
  :tier :t5
  :role :library
  ;; kami.gpu answers "can this backend run this pass"; kami.gpu.launch
  ;; answers "given that it can, what shape should the dispatch be". Neither
  ;; opens a device, and neither reimplements a space-filling curve that
  ;; kotoba-lang/traversal already owns.
  :must-not [:open-a-device :execute-shaders :reimplement-traversal-orders]
  :depends-on ["kotoba-lang/machine" "kotoba-lang/traversal"]}}
