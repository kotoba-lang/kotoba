;; No dependencies. PROFINET's RT frame layer and DCP are a FrameID, an
;; APDU trailer bitfield, and a TLV block walker — a leaf that dragged a
;; raw socket / real-time NIC driver binding behind it would defeat the
;; point, the same reasoning org-modbus, org-can-cia-canopen and
;; org-ethercat give for having none.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
