{:paths ["src"]
 ;; Zero-dep and pure on purpose. A consumer pulls this in by :git/sha, and
 ;; a :local/root in :deps only resolves inside the monorepo checkout —
 ;; kotoba-lang/reservation hit exactly that failure mode when
 ;; cloud-itonami-isic-7990 consumed it as a git dependency.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
