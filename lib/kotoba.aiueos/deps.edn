{:paths ["src" "resources"]
 ;; The decision plane left this repository on 2026-08-21 (root
 ;; ADR-2608219500). `grant` decides whether a component may run; what is
 ;; still here is the machine that runs it. The edge is one-way and the
 ;; require graph is checkable: nothing in `grant` requires `aiueos`.
 ;;
 ;; `abi` is no longer a direct dependency -- `grant.component-abi` and
 ;; `grant.contract` were the only namespaces that used it, and they moved.
 ;; It still arrives transitively through `grant`; it is not restated here,
 ;; because a dependency nothing in this repository requires is a claim
 ;; about the wrong repository.
 :deps {
        io.github.kotoba-lang/ffi {:local/root "../kotoba.ffi"}
        io.github.kotoba-lang/vmm {:local/root "../kotoba.vmm"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/process {:local/root "../kotoba.process"}
        io.github.kotoba-lang/pprint {:local/root "../kotoba.pprint"}
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/grant {:local/root "../kotoba.grant"}
        io.github.kotoba-lang/security {:local/root "../kotoba.security"}
        io.github.kotoba-lang/org-ietf-tls {:local/root "../org.ietf.tls"}
        io.github.kotoba-lang/http {:local/root "../kotoba.http"}
        io.github.kotoba-lang/window-session-state {:local/root "../kotoba.windowSessionState"}
        io.github.kotoba-lang/org-chainagnostic-cacao {:local/root "../org.chainagnostic.cacao"}}
 :aliases
  {:test {:extra-paths ["test"]
          :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         ;; TEST-ONLY. The compiler and the KIR interpreter drive
         ;; `tcp-seq-acceptable.kotoba`; org-ietf-tcp supplies the reference
         ;; implementation it is checked against. None of the three is linked
         ;; into anything this repo ships.
         :extra-deps {
                      io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.osaho"}
                      ;; TEST-ONLY, and pinned directly rather than taken
                      ;; through amu, because the admission verifiers need the
                      ;; `kernel-object-entries` row for
                      ;; `kotoba_aiueos_cid_v1_admit`. Closest-wins puts this
                      ;; ahead of amu's own kotoba-native pin.
                      io.github.kotoba-lang/kotoba-native
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.kotobaNative"}
                      ;; The repository was renamed compiler -> amu. One
                      ;; repository reachable under two coordinates is what the
                      ;; workspace's dep-coordinate-identity detector exists to
                      ;; catch, so the coordinate follows the name.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "09f4dcddedc088594ced1319c2d0d45ac93a86a4"}
                      io.github.kotoba-lang/org-ietf-tcp
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/org.ietf.tcp"}
                      ;; TEST-ONLY, and the whole point of it is that it is a
                      ;; DIFFERENT implementation: `aiueos.sha256-stream-parity-test`
                      ;; re-derives every digest the three streaming SHA-256
                      ;; contracts assert, from the message each contract
                      ;; describes, so a transcription error in a contract is
                      ;; caught by something that did not read the contract's
                      ;; answer. Pure `.cljc`; nothing this repo ships links it.
                      io.github.kotoba-lang/org-nist-sha2
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/gov.nist.sha2"}
                      ;; Hosted kami IR constructors (kami.webgpu.ir). The
                      ;; browser executor stays cljs; this is the JVM floor.
                      io.github.kotoba-lang/webgpu
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.webgpu"}}}

   ;; The security adoption verifier (CI: `kbb -M:security-adoption`)
   ;; loads every entrypoint in security-adoption.edn to prove the
   ;; entrypoint-to-control dependency edges. `aiueos.phone-bind` transitively
   ;; requires `aiueos.compositor.desktop` -> `kami.webgpu.ir`, which is only
   ;; on the test classpath, so the verifier runs with the hosted kami IR
   ;; floor added (same pin as the test alias).
   ;; CI's anonymous test suite (ci.yml: `kbb -M:ci`). org-ietf-tcp is
   ;; PRIVATE (issues #273/#274), so a GitHub Actions runner cannot resolve
   ;; the :test classpath -- "could not read Username for
   ;; 'https://github.com'" kills the run before a single test executes.
   ;; :ci names the same dep set :test-fleet uses (every one anonymously
   ;; fetchable; fleet_alias_test pins that discipline) and narrows the run
   ;; excluding at selection time (-r regex, as :test-fleet does — -e would
   ;; still require every test ns) the two namespaces whose `ns` forms require
   ;; tcp.seq/tcp.reassemble at load time. The full
   ;; :test suite still runs them for anyone with credentials, and
   ;; fleet_alias_test's `the-full-alias-still-carries-what-the-fleet-cannot`
   ;; keeps org-ietf-tcp in :test.
   :ci {:extra-paths ["test"]
        :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
        :extra-deps {
                     io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.osaho"}
                     io.github.kotoba-lang/kotoba-native
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.kotobaNative"}
                     io.github.kotoba-lang/amu
                     {:git/url "https://github.com/kotoba-lang/amu.git"
                      :git/sha "09f4dcddedc088594ced1319c2d0d45ac93a86a4"}
                     io.github.kotoba-lang/webgpu
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.webgpu"}
                     io.github.kotoba-lang/org-nist-sha2
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/gov.nist.sha2"}}}



   ;; The fleet's suite. It used to be `:test` minus `-e :upstream-blocked`,
   ;; which dropped exactly one test whose twelve failures ADR-0050 established
   ;; as correct and amu#625/#626 owned. Both are answered as of 2026-08-20 --
   ;; #625 landed as a lock rather than a compare-exchange -- so the twelve are
   ;; declared rather than silently unbuilt and nothing is excluded here.
   ;;
   ;; It exists so a murakumo fleet gate can be green when the repository is
   ;; healthy. Lowering a threshold to get there would have been the other
   ;; option, and it would have made every future failure invisible instead of
   ;; one known one explicit (ADR-0063).
   :test-fleet {:extra-paths ["test"]
                :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                :extra-deps {
                             io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.osaho"}
                             io.github.kotoba-lang/kotoba-native
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.kotobaNative"}
                             io.github.kotoba-lang/amu
                             {:git/url "https://github.com/kotoba-lang/amu.git"
                              :git/sha "09f4dcddedc088594ced1319c2d0d45ac93a86a4"}
                             ;; Same reason as in `:test`, and it has to be here
                             ;; too: this alias selects every `aiueos.*`
                             ;; namespace except one, so
                             ;; `sha256-stream-parity-test` runs on the fleet
                             ;; and would fail to LOAD without it -- which reads
                             ;; as a broken test rather than a missing pin.
                             ;; org-nist-sha2 is PUBLIC, unlike org-ietf-tcp,
                             ;; so a credential-free node can resolve it
                             ;; (ADR-0068).
                             io.github.kotoba-lang/org-nist-sha2
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/gov.nist.sha2"}
                             io.github.kotoba-lang/webgpu
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.webgpu"}
                             }}

   ;; The nbb admission runner (os/aiueos/scripts/verify-admissions.cljk).
   ;; A SEPARATE alias with its OWN amu pin on purpose: the runner needs
   ;; kotoba.compiler.project's ClojureScript printer fix (amu#714), while
   ;; :test keeps the compiler the committed value-runtime verdicts were
   ;; measured against. Advancing :test instead would have moved that pin 255
   ;; commits and re-measured ten receipts as a side effect of adding a runner.
   ;; ADVANCED 2026-09-02 (ADR-0139). The previous pin (0085e138) predates
   ;; amu#742, so `project/link-source` could not link a module a kernel object
   ;; imports -- and all three streaming SHA-256 contracts are two-module
   ;; projects. ADR-0135's "Not done" named advancing this as the next change;
   ;; this is it. `hkdf-sha256-v1.edn` runs on this pin too, which is what
   ;; ADR-0135 could only do by passing a closure in by hand.
   :verify-admissions
   {:extra-deps {io.github.kotoba-lang/amu
                 {:git/url "https://github.com/kotoba-lang/amu.git"
                  :git/sha "09f4dcddedc088594ced1319c2d0d45ac93a86a4"}
                 ;; Pinned explicitly, not taken through amu: amu's own pin
                 ;; predates `kir/execute`'s optional memory image, and without
                 ;; it every vector traps `:kernel-memory-unavailable`. The
                 ;; runner refuses rather than reporting a pass in that case,
                 ;; which is how this was caught.
                 ;;
                 ;; ADVANCED 2026-09-02 for the RTL8125 driver objects, and the
                 ;; FRONTEND had to move with it. At the pins this alias carried
                 ;; before, `kernel-fence-load` / `kernel-fence-store` /
                 ;; `kernel-rdtsc` (the SYSOPS slice) have no entry in
                 ;; `kotoba.compiler.frontend`'s operator table, so
                 ;; `sema/analyze` refuses the whole module with `operation has
                 ;; no admitted type signature` -- four of the six driver
                 ;; objects could not be lowered at all, let alone executed, and
                 ;; a runner that cannot lower an object cannot report anything
                 ;; about it.
                 ;;
                 ;; `kotoba-sema` is pinned to the SHA amu's own `deps.edn`
                 ;; names at the tip this repo's objects are compiled with, so
                 ;; the frontend that admits a program here is the frontend that
                 ;; admitted the `.o`. Pinning it directly rather than advancing
                 ;; the amu above keeps that amu's ClojureScript printer fix,
                 ;; which is the reason this alias exists.
                 ;;
                 ;; Advanced 2026-09-16 (ADR-0221) e42b74ef -> b8b01d09 and
                 ;; osaho 08bdab8b -> 7dfafd78, the shas amu d7189340's lock
                 ;; names: the older frontend did not yet admit `bytes-literal`
                 ;; as a kernel region root, so the dequant core's grid reads
                 ;; -- which amu compiles and links -- were refused by the
                 ;; oracle with `kernel-region-provenance`.
                 io.github.kotoba-lang/kotoba-sema
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.kotobaSema"}
                 io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.osaho"}}}











