(ns aiueos.kotoba-browser-smoke
  "Exercise the AIUEOS app desktop through Kotoba Browser's native surface path.

   App state and pointer routing are Kotoba reducers. This host-side entrypoint
   reports the retained frame; it is not a claim that the current Amu kernel
   presents that frame on a GOP framebuffer."
  (:require [aiueos.session.native-desktop :as aiueos]))

(defn- click-at
  [session x y]
  (aiueos/dispatch-input
   session {:event/type :pointer/click :x x :y y}))

(defn- frame-bounded?
  [result]
  (let [frame (:frame result)
        [width height] (:frame/viewport frame)
        rectangles (filter #(and (= :rect (:draw/op %))
                                 (number? (:x %)) (number? (:y %))
                                 (number? (:w %)) (number? (:h %)))
                           (:frame/draw-ops frame))]
    (and (seq rectangles)
         (every? (fn [{:keys [x y w h]}]
                   (and (<= 0 x) (<= 0 y)
                        (<= (+ x w) width)
                        (<= (+ y h) height)))
                 rectangles))))

(defn- launch-from-launcher
  [session slot]
  (click-at session (+ 20 (* 102 slot)) 40))

(defn- launch-from-dock
  [session slot]
  (let [[width height] (get-in session [:surface :surface/viewport])
        app-count (count (get-in session [:surface :surface/apps]))
        dock-width (+ 12 (* app-count 72))
        centered-left (quot (- width dock-width) 2)
        dock-left (if (< centered-left 12) 12 centered-left)]
    (click-at session
              (+ dock-left 6 (* 72 slot) 32)
              (- height 40))))

(defn- close-window
  [session]
  (let [[x y w _h] (get-in session [:surface :surface/windows 0 :window/rect])]
    (click-at session (+ x w -14) (+ y 14))))

(defn -main
  [& _]
  (let [initial-result (aiueos/start-session {:viewport [1280 800]})
        initial (:session initial-result)
        frame (:frame initial-result)
        apps (get-in initial [:surface :surface/apps])
        launch-results
        (mapv (fn [slot app]
                (let [from-launcher (launch-from-launcher initial slot)
                      from-dock (launch-from-dock initial slot)
                      from-dock-again (launch-from-dock (:session from-dock) slot)
                      closed (close-window (:session from-dock-again))
                      launcher-session (:session from-launcher)
                      dock-session (:session from-dock)
                      reopened-session (:session from-dock-again)
                      closed-session (:session closed)
                      launcher-open? (= (:app/id app)
                                        (get-in launcher-session
                                                [:surface :surface/windows 0 :window/app-id]))
                      dock-open? (= (:app/id app)
                                    (get-in dock-session
                                            [:surface :surface/windows 0 :window/app-id]))
                      relaunch-reuses-window?
                      (and (= 1 (count (get-in reopened-session [:surface :surface/windows])))
                           (= (get-in dock-session [:surface :surface/windows 0 :window/id])
                              (get-in reopened-session
                                      [:surface :surface/windows 0 :window/id])))
                      layout-bounded? (every? frame-bounded?
                                             [from-launcher from-dock from-dock-again closed])
                      close-works? (and (empty? (get-in closed-session
                                                        [:surface :surface/windows]))
                                        (nil? (get-in closed-session
                                                      [:surface :surface/focus])))
                      presented? (and (= :frame/present
                                        (get-in closed [:effects 0 :backend/op]))
                                      (= 4 (get-in closed-session
                                                   [:desktop :desktop/frame-sequence]))
                                      layout-bounded?
                                      close-works?)]
                  {:app/id (:app/id app)
                   :launcher-open? launcher-open?
                   :dock-open? dock-open?
                   :relaunch-reuses-window? relaunch-reuses-window?
                   :close-works? close-works?
                   :layout-bounded? layout-bounded?
                   :frame-sequence (get-in closed-session
                                            [:desktop :desktop/frame-sequence])
                   :frame-presented? presented?
                   :opened? (and launcher-open? dock-open? presented?
                                 relaunch-reuses-window?)}))
              (range)
              apps)
        ok? (and (seq (:frame/draw-ops frame))
                 (= :frame/present (get-in initial-result [:effects 0 :backend/op]))
                 (= 4 (count apps))
                 (every? :opened? launch-results))]
    (println (pr-str {:outcome (if ok? :admitted :refused)
                      :engine :kotoba-lang/browser
                      :renderer :browser.surface+cssom.layout
                      :interaction :browser.input
                      :host-contract :browser.desktop-backend/v1
                      :host-runtime :kbb/kotoba-node
                      :javascript-required? false
                      :kernel-framebuffer :not-connected
                      :apps (mapv :app/id apps)
                      :launch-results launch-results
                      :dock-apps (count apps)
                      :draw-ops (count (:frame/draw-ops frame))
                      :frame-sequence (:frame-sequence (last launch-results))
                      :native-boot-claim? false}))
    (when-not ok? (System/exit 1))))
