{
  "schema": "itonami.dapp.v1",
  "id": "updates",
  "dock": 17,
  "title": "Updates",
  "category": "system",
  "install": "os-image",
  "entry": "os/aiueos/native/dapps-entry.kotoba",
  "core": "os/aiueos/native/dapps.kotoba",
  "localCore": "Update manager: shows installed versions, channel and policy, and runs the staged signed-image update (AWAI-122) with its rollback copy.",
  "localState": {
    "policy": "draft-store-or-ram",
    "installedVersions": "draft-store-or-ram",
    "rollbackCopy": "esp"
  },
  "dns": "never",
  "offline": "local-core",
  "remoteOperations": [
    {
      "operation": "check-updates",
      "service": "user-chosen update origin",
      "endpoint": "full https origin shown before the request",
      "data": [
        "installed version ids",
        "channel"
      ],
      "consent": "each-operation",
      "state": "not-implemented"
    },
    {
      "operation": "download-update",
      "service": "user-chosen update origin",
      "endpoint": "full https origin shown before the request",
      "data": [
        "image CID"
      ],
      "consent": "each-operation",
      "state": "not-implemented"
    }
  ],
  "native": {
    "window": "not-implemented",
    "note": "frame ABI has window ids 1..4 only (ADR-0283)"
  },
  "adr": "90-docs/adr/0283-default-itonami-apps-installer-and-update-manager.md",
  "localCoreState": "planned"
}
