{
  "schema": "itonami.dapp.v1",
  "id": "itonami-apps",
  "dock": 16,
  "title": "Itonami Apps",
  "ui": {
    "document": "itonami-apps"
  },
  "category": "store",
  "install": "os-image",
  "entry": "os/aiueos/native/dapps-entry.kotoba",
  "core": "os/aiueos/native/dapps.kotoba",
  "localCore": "App store: lists the signed app catalog and installs an app from it. The catalog and each app are fetched only after fresh approval and admitted by digest and signature.",
  "localState": {
    "installed": "draft-store-or-ram",
    "catalogHead": "draft-store-or-ram"
  },
  "dns": "never",
  "offline": "local-core",
  "remoteOperations": [
    {
      "operation": "fetch-catalog",
      "service": "user-chosen app catalog origin",
      "endpoint": "full https origin shown before the request",
      "data": [
        "catalog id",
        "installed app ids"
      ],
      "consent": "each-operation",
      "state": "not-implemented"
    },
    {
      "operation": "download-app",
      "service": "user-chosen artifact origin",
      "endpoint": "full https origin shown before the request",
      "data": [
        "app CID"
      ],
      "consent": "each-operation",
      "state": "not-implemented"
    }
  ],
  "native": {
    "window": "not-implemented",
    "note": "frame ABI has window ids 1..4 only (ADR-0283)"
  },
  "adr": "90-docs/adr/0283-default-itonami-apps-installer-and-update-manager.md",
  "localCoreState": "planned"
}
