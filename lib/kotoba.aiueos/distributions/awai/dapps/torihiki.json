{
  "schema": "itonami.dapp.v1",
  "id": "torihiki",
  "dock": 18,
  "title": "Torihiki",
  "category": "default",
  "install": "os-image",
  "entry": "os/aiueos/native/dapps-entry.kotoba",
  "core": "os/aiueos/native/dapps.kotoba",
  "localCore": "Exchange client (devnet and demo accounts only): shows quotes and the user's own order drafts locally. No real-money trading, custody or settlement.",
  "localState": {
    "orderDrafts": "draft-store-or-ram",
    "watchlist": "draft-store-or-ram"
  },
  "dns": "never",
  "offline": "local-core",
  "remoteOperations": [
    {
      "operation": "read-quotes",
      "service": "user-chosen torihiki devnet endpoint",
      "endpoint": "full origin chosen by the user",
      "data": [
        "market symbols"
      ],
      "consent": "each-operation",
      "state": "not-implemented"
    },
    {
      "operation": "submit-order",
      "service": "user-chosen torihiki devnet endpoint",
      "endpoint": "full origin chosen by the user",
      "data": [
        "order (symbol, side, size, price)",
        "device key signature"
      ],
      "consent": "each-operation",
      "state": "blocked-owner-decision"
    }
  ],
  "native": {
    "window": "not-implemented",
    "note": "frame ABI has window ids 1..4 only (ADR-0283)"
  },
  "adr": "90-docs/adr/0284-user-signed-install-update-and-delete-of-itonami-dapps.md",
  "localCoreState": "planned"
}
