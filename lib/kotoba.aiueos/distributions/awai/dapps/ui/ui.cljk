;; JUN-805 / JUN-808: the UI of the new Itonami dapps as kotoba-lang/html
;; hiccup documents plus a kotoba-lang/css sheet. This is the single source of
;; their UI: the hosted session emits it as HTML (JUN-809), and the native
;; desktop is meant to render the same documents through the shared browser
;; render (JUN-810, blocked on JUN-93). Nothing here is drawn by hand-written JS.
;;
;; Dynamic parts are declarative: `data-bind` names a value the dapp core
;; supplies, `data-action` names an operation the dapp core handles. The only
;; code outside this file is the host binder for those attributes.
;;
;; Run (one-shot local oracle, not CI; record the run as dated evidence):
;;   kbb --backend sci --classpath <html>/src:<css>/src:<kotoba.json>/src \
;;       distributions/awai/dapps/ui/ui.cljk <out-dir>
(require '[kotoba.html :as h]
         '[css.core :as c]
         '[kotoba.json :as json]
         '[clojure.string :as str])

(def dapps-dir "distributions/awai/dapps/")

(defn read-json [path] (json/read-str (slurp path) :key-fn keyword))

(def records
  (->> (.listFiles (java.io.File. dapps-dir))
       (filter #(.endsWith (.getName %) ".json"))
       (map #(read-json (.getPath %)))
       (sort-by :dock)))

(def policy (read-json "distributions/awai/update-policy.json"))

;; Presentation of each new app: icon, state label, lede (ja).
(def ui
  {"browser"      {:icon "B"  :state "Browser"   :lede "ローカル文書を Kotoba Browser で開きます。"}
   "yotei"        {:icon "予" :state "Calendar"  :lede "予定をこの端末の署名付きレコードとして持ちます。"}
   "shakai"       {:icon "社" :state "Social"    :lede "Aozora の送信箱とタイムラインを読みます。"}
   "saifu"        {:icon "財" :state "Wallet"    :lede "端末鍵の表示と署名の検証のみ。取引の署名・送信・決済はしません。"}
   "bunsho"       {:icon "文" :state "Documents" :lede "文書作成 (Word 相当)。"}
   "hyokeisan"    {:icon "表" :state "Sheets"    :lede "表計算 (Excel 相当)。"}
   "zuhyo"        {:icon "図" :state "Slides"    :lede "図表とスライド (PowerPoint 相当)。"}
   "tokei"        {:icon "時" :state "Clock"     :lede "時計。"}
   "wifi"         {:icon "W"  :state "Network"   :lede "ネットワーク状態。"}
   "bluetooth"    {:icon "BT" :state "Devices"   :lede "Bluetooth の状態。"}
   "settei"       {:icon "設" :state "Settings"  :lede "設定と、アプリごとの同意の確認。"}
   "itonami-apps" {:icon "+"  :state "Store"     :lede "アプリを探して入れます。"}
   "updates"      {:icon "更" :state "Updates"   :lede "OS とアプリの更新を管理します。"}})

(def mode-label
  {"manual"       "手動"
   "notify"       "通知のみ（既定）"
   "auto-stage"   "承認後に自動で取得"
   "auto-install" "承認後に自動で取得・次回起動で適用"})

(def new-apps (filter #(contains? ui (:id %)) records))

(defn op-names [r] (map :operation (:remoteOperations r)))

;; --- launcher, dock ---------------------------------------------------------

(defn tile [r]
  (let [{:keys [icon]} (ui (:id r))]
    [:a {:class "desktop-app" :href (str "#" (:id r)) :data-app (:id r)
         :data-cat (:category r) :aria-label (:title r)}
     [:span {:class "desktop-app-icon" :aria-hidden "true" :data-cat (:category r)} icon]
     [:span {:class "desktop-app-label"} (:title r)]]))

(defn dock-tile [r]
  (let [{:keys [icon]} (ui (:id r))]
    [:a {:class "dock-app" :href (str "#" (:id r)) :data-app (:id r) :data-cat (:category r)
         :data-dock-default (if (contains? #{"browser" "settei" "itonami-apps"} (:id r)) "true" "false")
         :aria-label (:title r) :hidden true}
     [:span {:class "dock-app-icon" :aria-hidden "true" :data-cat (:category r)} icon]
     [:span {:class "dock-app-label"} (:title r)]]))

;; --- windows ----------------------------------------------------------------

(defn heading [level text]
  [(if (= level 1) :h1 :h2) {:class "dads-heading" :data-size (if (= level 1) "32" "24")} text])

(defn request-button [label op service]
  [:button {:class "dads-button" :type "button" :data-type "solid-fill" :data-size "md"
            :data-action "request" :data-op op :data-service service} label])

(defn notice [r]
  [:p {:class "app-empty-state"}
   (str "この AIUEOS ビルドには " (:title r) " の本体がまだ入っていません。外部操作: "
        (if (seq (op-names r)) (str (str/join ", " (op-names r)) "（毎回承認）") "なし"))])

(defn app-body [r]
  (case (:id r)
    "tokei" [[:pre {:class "session-out" :data-bind "clock"} ""]]
    "wifi" [[:pre {:class "session-out" :data-bind "net"} ""]
            [:p {:class "app-empty-state"} "参加するには承認が必要です（このビルドでは未登録）。"]]
    "bluetooth" [[:pre {:class "session-out" :data-bind "bluetooth"} ""]
                 [:p {:class "app-empty-state"} "ペアリングには承認が必要です（このビルドでは未登録）。"]]
    "settei" (into [(heading 2 "同意の確認")]
                   (for [x records]
                     [:p (str (:title x) ": "
                              (if (seq (op-names x))
                                (str (str/join ", " (op-names x)) "（毎回承認）")
                                "外部操作なし"))]))
    "itonami-apps" (concat
                    [(heading 2 "Dock")]
                    (for [x new-apps]
                      [:p (:title x) " "
                       [:button {:class "dads-button" :type "button" :data-type "outline"
                                 :data-action "pin" :data-app (:id x)} "Dock に置く"]])
                    [(heading 2 "入っているアプリ")]
                    (for [x records]
                      [:p (:title x) "（OS イメージ内蔵）"])
                    [(heading 2 "カタログから入れる")
                     [:p {:class "app-empty-state"}
                      "カタログの接続先と署名鍵はまだ登録されていません。登録されるまで、取得・インストールはできません。"]
                     (request-button "カタログを確認する" "fetch-catalog" "Itonami アプリカタログ")
                     [:div {:data-slot "result"}]])
    "updates" (concat
               [(heading 2 "更新ポリシー")]
               (for [m (:modes policy)]
                 [:label [:input {:type "radio" :name "update-mode" :value (:id m)
                                  :data-action "set-update-mode"}]
                  (str " " (mode-label (:id m)))])
               [[:p {:class "app-empty-state"}
                 "「自動」でも予定が出すのは確認のプロンプトだけです。確認・取得・適用は、それぞれ毎回承認します。"]
                [:p {:class "app-empty-state"}
                 "更新元の接続先はまだ登録されていません。登録されるまで、確認・取得・適用はできません。"]
                (request-button "更新を確認する" "check-updates" "Itonami 更新サービス")
                [:div {:data-slot "result"}]
                [:pre {:class "session-out"}
                 (str "チャンネル: " (:defaultChannel policy)
                      "\n署名: Ed25519（ポスト量子 ML-DSA-65 は未対応）\nロールバック: 直前のイメージを保持")]])
    [(notice r)]))

(defn window [r]
  (let [{:keys [state lede]} (ui (:id r))
        id (:id r)]
    [:section {:id id :class "dds-ext-section session-view" :data-view id :hidden true}
     [:article {:class "app-window"}
      [:header {:class "app-window-head"}
       [:a {:class "window-close" :href "#desktop" :aria-label "Close app"} "×"]
       [:span {:class "app-window-title"} (:title r)]
       [:span {:class "window-spacer"} ""]
       [:span {:class "app-window-state"} state]]
      (into [:div {:class "app-window-body"}
             (heading 1 (:title r))
             [:p {:class "session-lede"} lede]]
            (concat
             [(into [:div {:class "dds-ext-card"}] (app-body r))]
             [[:a {:class "app-return" :href "#desktop"} "デスクトップへ"]]))]]))

;; Operation approval, shown before any external operation. The host fills the
;; bound fields and wires Allow/Deny; denial sends nothing.
(def approval
  [:template {:id "dapp-approval"}
   [:div {:class "app-empty-state" :role "alertdialog"}
    [:p {:data-bind "approval-title"} ""]
    [:p {:data-bind "approval-detail"} ""]
    [:button {:class "dads-button" :type "button" :data-type "solid-fill" :data-action "approve"} "許可"]
    [:button {:class "dads-button" :type "button" :data-type "outline" :data-action "deny"} "拒否"]]])

(def sheet
  {:rules
   [[".desktop-app-icon[data-cat=\"default\"],.dock-app-icon[data-cat=\"default\"]"
     {:color "var(--color-primitive-purple-700)" :background "var(--color-primitive-purple-50)"
      :border-color "var(--color-primitive-purple-200)"}]
    [".desktop-app-icon[data-cat=\"system\"],.dock-app-icon[data-cat=\"system\"]"
     {:color "var(--color-primitive-orange-800)" :background "var(--color-primitive-orange-50)"
      :border-color "var(--color-primitive-orange-200)"}]
    [".desktop-app-icon[data-cat=\"store\"],.dock-app-icon[data-cat=\"store\"]"
     {:color "var(--color-primitive-green-800)" :background "var(--color-primitive-green-50)"
      :border-color "var(--color-primitive-green-200)"}]]})

(let [out (first *command-line-args*)
      only (fn [pred] (filter pred new-apps))]
  (assert out "usage: ui.cljk <out-dir>")
  (.mkdirs (java.io.File. out))
  (assert (every? mode-label (map :id (:modes policy))) "mode without a label")
  (spit (str out "/tiles.html") (str/join "\n" (map #(h/html (tile %)) new-apps)))
  (spit (str out "/dock.html") (str/join "\n" (map #(h/html (dock-tile %)) new-apps)))
  (spit (str out "/windows.html")
        (str (str/join "\n" (map #(h/html (window %)) new-apps)) "\n" (h/html approval)))
  (spit (str out "/dapp-ui.css") (c/css sheet))
  (println "DAPP_UI_GENERATED" (count new-apps)))
