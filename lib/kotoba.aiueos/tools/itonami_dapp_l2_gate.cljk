;; tools/itonami_dapp_l2_gate.cljk — the itonami dapp L2 gate (JUN-124 / JUN-116).
;;
;; Runs aiueos.itonami-dapp-bundle-test + aiueos.itonami-dapp-selfhost-test and
;; judges the run by COUNT, not by "no failures". Why: the kbb test-runner
;; substitution (`kbb -M:test -n aiueos.itonami-dapp-bundle-test`, measured
;; 2026-10-20) loads the namespace and reports "Ran 0 tests containing 0
;; assertions. 0 failures, 0 errors." with exit 0 — a run that measured
;; nothing scoring the same as a clean run (the 8-questions rule: the
;; self-check returns counts, not booleans). These tests need the JVM compat
;; route (Chicory + cheshire are Maven jars; kbb loads no jars), so the gate
;; pins that route AND a floor on how many tests must have executed.
;;
;; Floor: ITONAMI_DAPP_L2_FLOOR, default 5 (the suite's recorded size at
;; landing, 2026-10-20: 5 tests / 51 assertions on aiueos origin/main 54ac566).
;; Raise it when the suite grows; it only ever catches shrinkage.
;;
;; Run through the registry (a tasks.edn entry is not a registration until
;; something invoked it this way):
;;   kbb --backend sci scripts/run-task.cljk itonami-dapp-l2-test
;; KOTOBA_AMU_ROOT must point at an amu checkout (default <parent>/amu).
(ns itonami-dapp-l2-gate
  (:require [clojure.test :as t]))

(defn -main [& _]
  (require 'aiueos.itonami-dapp-bundle-test 'aiueos.itonami-dapp-selfhost-test)
  (let [floor (Long/parseLong (or (System/getenv "ITONAMI_DAPP_L2_FLOOR") "5"))
        r (t/run-tests 'aiueos.itonami-dapp-bundle-test
                       'aiueos.itonami-dapp-selfhost-test)
        ran (:test r 0)
        bad? (or (pos? (+ (:fail r 0) (:error r 0))) (< ran floor))]
    (println (str "itonami-dapp-l2-gate: ran " ran " tests, "
                  (:pass r 0) " pass, " (:fail r 0) " fail, "
                  (:error r 0) " error; floor " floor))
    (System/exit (if bad? 1 0))))
