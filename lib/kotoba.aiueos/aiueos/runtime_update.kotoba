;; aiueos.runtime-update -- blue/green runtime update decisions as a pure
;; Kotoba guest (oracle: src/aiueos/runtime_update.cljk).
;;
;; Signed blue/green updates for the Kototama inference runtime: bundles are
;; pulled as immutable signed objects into an inactive runtime slot, probed
;; beside the active runtime, switched without a kernel reboot. The oracle's
;; local decisions, arithmetic and keywords, become the guest:
;;
;;   health-status          the three runtime signals (:runtime-admission
;;                          :model-bind :murakumo-result) collapsed without
;;                          treating absence as success
;;   manifest-local-errors  schema, sequence, architecture and runtime-ABI
;;                          faults -- same vocabulary as the oracle
;;
;; The regexes (sha256 / immutable-url) and the grant.ota / grant.update
;; publisher closures stay in the host, exactly as aiueos/os_update.kotoba
;; records. Measured bounds stated: :container-items 32 (2 artifact kinds,
;; 4 flags, 3 signals), max-parameters 5 (flags travel as an i64 vector).
;;
;; Compile (single file, JVM-free):
;;   kotoba compile aiueos/runtime_update.kotoba --target wasm32-browser --output runtime_update.wasm

(ns aiueos.runtime-update
  (:export [health-status manifest-local-errors artifact-set-error?]))

;; --- element access ----------------------------------------------------------

(defn- at [v :document i :i64] :i64
  (option-value-of [:option :i64]
    (document-i64-value (option-value-of [:option :document] (document-vector-at v i) (document-i64 0)))
    0))

;; --- health-status -----------------------------------------------------------
;; signals: i64 codes, 0 = false, 1 = true, 2 = absent/unknown.
;; (some false?) -> :fail, (every? true?) -> :pass, :else :unknown.

(defn- scan-signals [signals :document i :i64] :keyword
  (if (>= i 3)
    :pass
    (let [v (at signals i)]
      (if (= v 0)
        :fail
        (if (= v 1)
          (scan-signals signals (+ i 1))
          :unknown)))))

(defn health-status [signals :document] :keyword
  (scan-signals signals 0))

;; --- manifest-local-errors ---------------------------------------------------
;; Non-regex faults, the oracle's vocabulary:
;;   :schema :sequence :incompatible-architecture :incompatible-aiueos-abi
;;   :incompatible-runtime-abi :artifact-set :duplicate-artifact-kind
;;   :unknown-artifact-kind
;;
;; flags: 0 schema-ok, 1 arch-eq, 2 abi-ok, 3 runtime-abi-ok
;; artifact-kinds: 0 component, 1 guest, 2+ unknown.

(defn- push-error [errs :document kw :keyword] :document
  (document-vector-conj errs (document-keyword kw)))

(defn- flag [flags :document i :i64] :bool
  (= (at flags i) 1))

(defn- kinds-include [kinds :document want :i64 i :i64] :bool
  (if (>= i (document-count kinds))
    false
    (if (= (at kinds i) want)
      true
      (kinds-include kinds want (+ i 1)))))

(defn- kinds-contain-all [kinds :document i :i64] :bool
  (if (>= i 2)
    true
    (if (kinds-include kinds i 0)
      (kinds-contain-all kinds (+ i 1))
      false)))

(defn- kinds-distinct [kinds :document i :i64 j :i64] :bool
  (if (>= i (document-count kinds))
    true
    (if (>= j (document-count kinds))
      (kinds-distinct kinds (+ i 1) 0)
      (if (if (= i j) false (= (at kinds i) (at kinds j)))
        false
        (kinds-distinct kinds i (+ j 1))))))

(defn- kinds-all-known [kinds :document i :i64] :bool
  (if (>= i (document-count kinds))
    true
    (if (if (= (at kinds i) 0) true (= (at kinds i) 1))
      (kinds-all-known kinds (+ i 1))
      false)))

(defn manifest-local-errors
  [flags :document sequence :i64 artifact-kinds :document] :document
  (let [errs (document-vector)
        e0 (if (kinds-all-known artifact-kinds 0)
             errs (push-error errs :unknown-artifact-kind))
        e1 (if (flag flags 0) e0 (push-error e0 :schema))
        e2 (if (> sequence 0) e1 (push-error e1 :sequence))
        e3 (if (flag flags 1) e2 (push-error e2 :incompatible-architecture))
        e4 (if (flag flags 2) e3 (push-error e3 :incompatible-aiueos-abi))
        e5 (if (flag flags 3) e4 (push-error e4 :incompatible-runtime-abi))
        e6 (if (kinds-contain-all artifact-kinds 0) e5 (push-error e5 :artifact-set))
        e7 (if (kinds-distinct artifact-kinds 0 1) e6 (push-error e6 :duplicate-artifact-kind))]
    e7))

(defn artifact-set-error? [artifact-kinds :document] :bool
  (if (kinds-contain-all artifact-kinds 0)
    (if (kinds-distinct artifact-kinds 0 1)
      false
      true)
    true))
