;; aiueos.qr -- QR Code (ISO/IEC 18004) byte-mode encoder as a pure Kotoba
;; guest. Standalone: there is NO :require; every dependency lives host-side.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile aiueos/qr.kotoba --target wasm32-browser --output qr.wasm
;;   (run from lib/kotoba.aiueos/)
;;
;; (a) Oracle namespace
;;     The oracle is aiueos.qr in src/aiueos/qr.cljk (kotoba-lang/kotoba,
;;     lib/kotoba.aiueos/, blob 6cbc9bbe, 363 lines). The .cljk is untouched:
;;     this file is an addition, never a rewrite. The algorithm follows
;;     io.nayuki/qrcodegen 1.8.0 step for step -- version-capacity tables,
;;     Reed-Solomon divisor, codeword placement and penalty rules -- so the
;;     automatic mask choice is the same one qrcodegen makes, not merely a
;;     decodable one. The qrcodegen JVM jar stays the hosted adapter's
;;     dependency and the JVM oracle (aiueos.qr-test compares every module
;;     against it); it is not replaced by this guest.
;;
;; (b) ex-info -> :error mapping table (no guest path throws; ADR-2608650000)
;;     oracle (ex-info "qr data must be bytes 0..255" {:reason :not-bytes})
;;       -> {:status :error :reason :not-bytes}
;;     oracle (ex-info "unknown qr ecc level" {:reason :ecc :ecc e})
;;       -> {:status :error :reason :ecc :ecc <echoed keyword>}
;;     oracle nil (does not fit in :max-version; "caller must refuse, not
;;     truncate") -> {:status :error :reason :does-not-fit}
;;     ascii-bytes oracle nil -> [:option :string] none
;;     terminal-lines overflow (finished rendering > 65,536 bytes)
;;       -> [:option :string] none (fail-closed; host renders instead)
;;     success -> {:status :ok :version <i64> :ecc <keyword> :mask <i64>
;;                 :size <i64> :grid <string>}
;;     :not-bytes note (recorded divergence): the guest reads payload bytes
;;     through string-to-utf8 + bytes-at (the grammar's own byte-access
;;     pattern), so any code point >= 0x80 -- a multi-byte UTF-8 sequence --
;;     is refused as :not-bytes. On the accepted range (exactly what
;;     ascii-bytes admits, 0x20..0x7E) the byte stream is identical to the
;;     oracle's (vec data) of ints 0..255. Widen later via a code-point
;;     indexed read when one is verified; the oracle accepts 0x80..0xFF ints
;;     where this guest refuses, and nothing in aiueos can observe it.
;;
;; (c) Bounds that shaped the port (measured amu admission bounds)
;;     max-parameters 5: dc-step/am-step/tl-line-step/aei-* run at exactly 5;
;;     the oracle's 6-name line-penalty loop is packed into one i64
;;     cr = color*1024 + run (run <= size <= 177 < 1024); mask-fn closures
;;     became the 4-param mask-pred.
;;     :container-items 32: the 41-entry capacity tables are chunked 32+9 per
;;     row (bounds-driven split, NOT semantics); the ECC block vector is one
;;     strided :bytes blob (stride short-len+1, <= 3755 bytes) instead of a
;;     >32-entry container; history is 7, alignment positions <= 7; the bit
;;     stream, codewords and grid travel as strings/:bytes, never as
;;     unbounded container literals. document-map entry limit 32 (status docs
;;     are <= 6 entries).
;;     string-value 65,536: the grid is <= 62,658 chars at v40 (2 chars per
;;     module, 2*177*177); terminal-lines tracks the running length and
;;     returns none before any string can exceed 65,536.
;;     i64 shifts eliminated (MEASURED amu asymmetry: i64-shift-left/right
;;     are rejected by the js/wasm emitters, so amu test aborts): every shift
;;     count in the oracle is a literal and every shifted value non-negative,
;;     so each site is spelled (* x 2^k) / (quot x 2^k) with literal powers
;;     of two -- bit-at is a case tree over (quot x 2^k), k = 0..17.
;;     mod/rem -> mod-n x n = (- x (* n (quot x n))); / -> quot; min/max ->
;;     same-typed nested ifs; no regex (positional scans via bytes-at /
;;     string-substring); count never on strings (string-length/bytes-count);
;;     booleans travel as i64 0/1 end-to-end (no bool/i64 equality); if
;;     branches are same-typed; every defn is defined before its first use;
;;     document accessors return [:option ...] and are double-wrapped with
;;     option-value-of; no capability lines (pure guest, :effects #{}).
;;
;; (d) Reader-conditional resolutions and reshape ledger
;;     qr.cljk contains exactly ONE reader-conditional form (line 344, in
;;     ascii-bytes), with two branches:
;;       #?(:clj (int (.charAt ^String s (int i))))   ; JVM: char -> int
;;       #?(:cljs (.charCodeAt s i))                  ; CLJS: code unit
;;     Both branches resolve to the guest's positional ASCII byte read
;;       (bytes-at (string-to-utf8 s) i)
;;     (the run #119 correction: there is no code-point constructor and
;;     string-code-point-at indexing is byte-or-code-point-unverified, so the
;;     spec's earlier string-code-point-at spelling was replaced by the
;;     grammar's own byte-access pattern). Equal to both branches on every
;;     input, not just accepted ones: a string is accepted iff all its code
;;     points lie in 0x20..0x7E, and UTF-8 bytes of any other code point are
;;     < 0x20 or >= 0x80 -- exactly where charAt/charCodeAt would refuse.
;;     Reversible: the cljc parity test asserts equality of ascii-bytes output
;;     (the validated string / its absence) between the oracle fn and the
;;     compiled guest on the same inputs. No other reader conditional or
;;     platform-conditional site exists in qr.cljk (grep #? -> 1 hit).
;;     Reshape ledger (each reversible, mirrored in the PR body):
;;       - oracle byte sequences (ints 0..255) -> the first-class :bytes type
;;         read via bytes-at; payload strings convert ONCE via string-to-utf8.
;;       - modules [[bool]] -> one grid :string of 2-char cells '0'/'1'
;;         (dark flag, function flag), row-major at 2*(y*size+x); dark =
;;         (quot cell 2). Max 62,658 chars at v40.
;;       - terminal-lines [[string]] (dim strings) -> one "\n"-joined string;
;;         ESC/NL chars are built via string-from-utf8 of single bytes (no
;;         escape literals); overflow -> none.
;;       - encode-bytes 2-arity + options map -> one 5-param fn
;;         (data :string ecc :keyword min-version :i64 max-version :i64
;;         mask [:option :i64]); the oracle's defaults (:medium 1 40
;;         automatic) travel at call sites; mask absent = automatic.
;;       - mask-fn (returns closures) -> mask-pred nested-if (computed
;;         lambdas forbidden).
;;       - bit? (boolean) -> bit-at :i64 0/1.
;;       - ascii-bytes (bytes vector) -> the validated string itself in
;;         [:option :string] (encode-bytes takes the string directly).
;;       - the 4 computed defs (ecc-ordinal, ecc-format-bits,
;;         ecc-codewords-per-block, num-error-correction-blocks) -> fns.
;;       - add-ecc-and-interleave's block vector -> one strided :bytes blob;
;;         the placeholder-nil short-block trick is preserved exactly (slot
;;         short-len-ecc-len is skipped for the first n-short blocks).
;;       - alignment-positions returns a :vector-i64 (<= 7 entries); the
;;         capacity table rows are :vector-i64 chunks of 32+9 read with
;;         vector-at (registry-confirmed: vector-at [:vector-i64 :i64] -> :i64).

(ns aiueos.qr
  (:export [encode-bytes ascii-bytes terminal-lines main
            test-capacity test-gf-mul test-rs-remainder
            test-encode-bytes test-ascii-bytes test-terminal-lines
            test-round-trip test-boundary test-error-status test-mod-quot]))

;; --- scalar helpers ----------------------------------------------------------

(defn- mod-n [x :i64 n :i64] :i64
  (- x (* n (quot x n))))

(defn- magnitude [x :i64] :i64
  (if (< x 0) (- 0 x) x))

(defn- bit-at [x :i64 i :i64] :i64
  (if (= i 0) (bit-and (quot x 1) 1)
    (if (= i 1) (bit-and (quot x 2) 1)
      (if (= i 2) (bit-and (quot x 4) 1)
        (if (= i 3) (bit-and (quot x 8) 1)
          (if (= i 4) (bit-and (quot x 16) 1)
            (if (= i 5) (bit-and (quot x 32) 1)
              (if (= i 6) (bit-and (quot x 64) 1)
                (if (= i 7) (bit-and (quot x 128) 1)
                  (if (= i 8) (bit-and (quot x 256) 1)
                    (if (= i 9) (bit-and (quot x 512) 1)
                      (if (= i 10) (bit-and (quot x 1024) 1)
                        (if (= i 11) (bit-and (quot x 2048) 1)
                          (if (= i 12) (bit-and (quot x 4096) 1)
                            (if (= i 13) (bit-and (quot x 8192) 1)
                              (if (= i 14) (bit-and (quot x 16384) 1)
                                (if (= i 15) (bit-and (quot x 32768) 1)
                                  (if (= i 16) (bit-and (quot x 65536) 1)
                                    (if (= i 17) (bit-and (quot x 131072) 1)
                                      0)))))))))))))))))))

(defn- single-byte [v :i64] :bytes
  (bytes-from-vector-i64 (vector-new v)))

;; --- capacity tables (oracle computed defs -> fns; chunks 32+9) --------------

(defn- ecc-ordinal [ecc :keyword] :i64
  (if (= ecc :low) 0
    (if (= ecc :medium) 1
      (if (= ecc :quartile) 2
        (if (= ecc :high) 3 -1)))))

(defn- ecc-format-bits [ecc :keyword] :i64
  (if (= ecc :low) 1
    (if (= ecc :medium) 0
      (if (= ecc :quartile) 3
        (if (= ecc :high) 2 0)))))

(defn- ecc-cp-block [row :i64 ver :i64] :i64
  (if (= row 0)
    (let [a (vector-new -1 7 10 15 20 26 18 20 24 30 18 20 24 26 30 22 24 28 30 28 28 28 28 30 30 26 28 30 30 30 30 30)
          b (vector-new 30 30 30 30 30 30 30 30 30)]
      (if (< ver 32) (vector-at a ver) (vector-at b (- ver 32))))
    (if (= row 1)
      (let [a (vector-new -1 10 16 26 18 24 16 18 22 22 26 30 22 22 24 24 28 28 26 26 26 26 28 28 28 28 28 28 28 28 28 28)
            b (vector-new 28 28 28 28 28 28 28 28 28)]
        (if (< ver 32) (vector-at a ver) (vector-at b (- ver 32))))
      (if (= row 2)
        (let [a (vector-new -1 13 22 18 26 18 24 18 22 20 24 28 26 24 20 30 24 28 28 26 30 28 30 30 30 30 28 30 30 30 30 30)
              b (vector-new 30 30 30 30 30 30 30 30 30)]
          (if (< ver 32) (vector-at a ver) (vector-at b (- ver 32))))
        (let [a (vector-new -1 17 28 22 16 22 28 26 26 24 28 24 28 22 24 24 30 28 28 26 28 30 24 30 30 30 30 30 30 30 30 30)
              b (vector-new 30 30 30 30 30 30 30 30 30)]
          (if (< ver 32) (vector-at a ver) (vector-at b (- ver 32))))))))

(defn- num-ec-blocks [row :i64 ver :i64] :i64
  (if (= row 0)
    (let [a (vector-new -1 1 1 1 1 1 2 2 2 2 4 4 4 4 4 6 6 6 6 7 8 8 9 9 10 12 12 12 13 14 15 16)
          b (vector-new 17 18 19 19 20 21 22 24 25)]
      (if (< ver 32) (vector-at a ver) (vector-at b (- ver 32))))
    (if (= row 1)
      (let [a (vector-new -1 1 1 1 2 2 4 4 4 5 5 5 8 9 9 10 10 11 13 14 16 17 17 18 20 21 23 25 26 28 29 31)
            b (vector-new 33 35 37 38 40 43 45 47 49)]
        (if (< ver 32) (vector-at a ver) (vector-at b (- ver 32))))
      (if (= row 2)
        (let [a (vector-new -1 1 1 2 2 4 4 6 6 8 8 8 10 12 16 12 17 16 18 21 20 23 23 25 27 29 34 34 35 38 40 43)
              b (vector-new 45 48 51 53 56 59 62 65 68)]
          (if (< ver 32) (vector-at a ver) (vector-at b (- ver 32))))
        (let [a (vector-new -1 1 1 2 4 4 4 5 6 8 8 11 11 16 16 18 16 19 21 25 25 25 34 30 32 35 37 40 42 45 48 51)
              b (vector-new 54 57 60 63 66 70 74 77 81)]
          (if (< ver 32) (vector-at a ver) (vector-at b (- ver 32))))))))

(defn- num-raw-data-modules [ver :i64] :i64
  (let [r0 (+ (* (+ (* 16 ver) 128) ver) 64)]
    (if (>= ver 2)
      (let [n (+ (quot ver 7) 2)
            r1 (- r0 (- (* (- (* 25 n) 10) n) 55))]
        (if (>= ver 7) (- r1 36) r1))
      (if (>= ver 7) (- r0 36) r0))))

(defn- block-ecc-len [ver :i64 ecc :keyword] :i64
  (ecc-cp-block (ecc-ordinal ecc) ver))

(defn- num-blocks [ver :i64 ecc :keyword] :i64
  (num-ec-blocks (ecc-ordinal ecc) ver))

(defn- num-data-codewords [ver :i64 ecc :keyword] :i64
  (- (quot (num-raw-data-modules ver) 8)
     (* (block-ecc-len ver ecc) (num-blocks ver ecc))))

(defn- char-count-bits [ver :i64] :i64
  (if (<= ver 9) 8 16))

(defn- data-bits-needed [ver :i64 n-bytes :i64] :i64
  (+ 4 (char-count-bits ver) (* 8 n-bytes)))

;; --- GF(256) -----------------------------------------------------------------

(defn- gf-mul-step [i :i64 z :i64 x :i64 y :i64] :i64
  (loop [i i z z x x y y] (if (< i 0)
    z
    (let [z1 (bit-xor (* z 2) (* (quot z 128) 0x11D))
          z2 (bit-and z1 0x1FF)
          z3 (if (= (bit-at y i) 1) (bit-xor z2 x) z2)]
      (recur (- i 1) z3 x y)))))

(defn- gf-mul [x :i64 y :i64] :i64
  (gf-mul-step 7 0 x y))

;; --- Reed-Solomon (divisor and remainder travel as :bytes) -------------------

(defn- zeros-bytes [n :i64 acc :bytes] :bytes
  (loop [n n acc acc] (if (<= n 0) acc (recur (- n 1) (bytes-concat acc (single-byte 0))))))

(defn- rsd-inner [result :bytes j :i64 root :i64 degree :i64] :bytes
  (loop [result result j j root root degree degree] (if (>= j degree)
    result
    (let [v0 (gf-mul (bytes-at result j) root)
          v1 (if (< (+ j 1) degree) (bit-xor v0 (bytes-at result (+ j 1))) v0)
          part (bytes-concat (bytes-slice result 0 j) (single-byte v1))
          r2 (bytes-concat part (bytes-slice result (+ j 1) degree))]
      (recur r2 (+ j 1) root degree)))))

(defn- rsd-step [i :i64 root :i64 result :bytes degree :i64] :bytes
  (loop [i i root root result result degree degree] (if (= i degree)
    result
    (recur (+ i 1) (gf-mul root 2) (rsd-inner result 0 root degree) degree))))

(defn- rs-divisor [degree :i64] :bytes
  (rsd-step 0 1 (bytes-concat (zeros-bytes (- degree 1) (bytes-empty)) (single-byte 1)) degree))

(defn- rsr-shift [result :bytes degree :i64] :bytes
  (bytes-concat (bytes-slice result 1 degree) (single-byte 0)))

(defn- rsr-xor [shifted :bytes j :i64 factor :i64 out :bytes divisor :bytes] :bytes
  (loop [shifted shifted j j factor factor out out divisor divisor] (if (>= j (bytes-count divisor))
    out
    (recur shifted (+ j 1) factor
             (bytes-concat out (single-byte (bit-xor (bytes-at shifted j)
                                                     (gf-mul (bytes-at divisor j) factor))))
             divisor))))

(defn- rsr-step [data :bytes i :i64 result :bytes divisor :bytes] :bytes
  (loop [data data i i result result divisor divisor] (if (>= i (bytes-count data))
    result
    (let [factor (bit-xor (bytes-at data i) (bytes-at result 0))
          shifted (rsr-shift result (bytes-count divisor))]
      (recur data (+ i 1) (rsr-xor shifted 0 factor (bytes-empty) divisor) divisor)))))

(defn- rs-remainder [data :bytes divisor :bytes] :bytes
  (rsr-step data 0 (zeros-bytes (bytes-count divisor) (bytes-empty)) divisor))

;; --- codewords (bit stream is a '0'/'1' :string; output is :bytes) -----------

(defn- bitstr-at [bits :string i :i64] :i64
  (if (string=? (string-substring bits i (+ i 1)) "1") 1 0))

(defn- pb-step [bits :string value :i64 j :i64] :string
  (loop [bits bits value value j j] (if (< j 0)
    bits
    (recur (string-concat bits (if (= (bit-at value j) 1) "1" "0")) value (- j 1)))))

(defn- push-bits [bits :string value :i64 n :i64] :string
  (pb-step bits value (- n 1)))

(defn- push-bytes [bits :string db :bytes i :i64] :string
  (loop [bits bits db db i i] (if (>= i (bytes-count db))
    bits
    (recur (push-bits bits (bytes-at db i) 8) db (+ i 1)))))

(defn- pack-step [bits :string p :i64 k :i64 acc :i64] :i64
  (loop [bits bits p p k k acc acc] (if (>= k 8)
    acc
    (recur bits (+ p 1) (+ k 1) (+ (* 2 acc) (bitstr-at bits p))))))

(defn- bits-to-bytes [bits :string i :i64 out :bytes] :bytes
  (loop [bits bits i i out out] (if (>= i (string-length bits))
    out
    (recur bits (+ i 8) (bytes-concat out (single-byte (pack-step bits i 0 0)))))))

(defn- pad-codewords [out :bytes target :i64 toggle :i64] :bytes
  (loop [out out target target toggle toggle] (if (>= (bytes-count out) target)
    out
    (recur (bytes-concat out (single-byte (if (= toggle 0) 236 17)))
                   target (mod-n (+ toggle 1) 2)))))

(defn- data-codewords [ver :i64 ecc :keyword data :string] :bytes
  (let [db (string-to-utf8 data)
        n (bytes-count db)
        cap (* 8 (num-data-codewords ver ecc))
        b0 (push-bits "" 4 4)
        b1 (push-bits b0 n (char-count-bits ver))
        b2 (push-bytes b1 db 0)
        rest (- cap (string-length b2))
        term (if (< rest 4) rest 4)
        b3 (push-bits b2 0 term)
        b4 (push-bits b3 0 (mod-n (- 8 (mod-n (string-length b3) 8)) 8))
        out (bits-to-bytes b4 0 (bytes-empty))]
    (pad-codewords out (quot cap 8) 0)))

;; --- add-ecc-and-interleave (blocks in one strided :bytes blob) --------------

(defn- aei-block [data :bytes k :i64 dlen :i64 placeholder :i64 divisor :bytes] :bytes
  (let [dat (bytes-slice data k (+ k dlen))
        ecc (rs-remainder dat divisor)
        mid (if (= placeholder 1) (single-byte 0) (bytes-empty))]
    (bytes-concat (bytes-concat dat mid) ecc)))

(defn- aei-blocks [data :bytes ver :i64 ecc :keyword i :i64 acc :bytes] :bytes
  (loop [data data ver ver ecc ecc i i acc acc] (let [nblocks (num-blocks ver ecc)
        ecc-len (block-ecc-len ver ecc)
        raw (quot (num-raw-data-modules ver) 8)
        n-short (- nblocks (mod-n raw nblocks))
        short-len (quot raw nblocks)
        base (- short-len ecc-len)]
    (if (>= i nblocks)
      acc
      (let [dlen (if (< i n-short) base (+ base 1))
            k (+ (* i base) (if (< i n-short) 0 (- i n-short)))
            ph (if (< i n-short) 1 0)
            bb (aei-block data k dlen ph (rs-divisor ecc-len))]
        (recur data ver ecc (+ i 1) (bytes-concat acc bb)))))))

(defn- aei-inter [blob :bytes ver :i64 ecc :keyword t :i64 out :bytes] :bytes
  (loop [blob blob ver ver ecc ecc t t out out] (let [nblocks (num-blocks ver ecc)
        raw (quot (num-raw-data-modules ver) 8)
        n-short (- nblocks (mod-n raw nblocks))
        short-len (quot raw nblocks)
        stride (+ short-len 1)
        total (* stride nblocks)]
    (if (>= t total)
      out
      (let [i (quot t nblocks)
            j (mod-n t nblocks)
            skip (if (= i (- short-len (block-ecc-len ver ecc)))
                   (if (< j n-short) 1 0)
                   0)]
        (recur blob ver ecc (+ t 1)
                   (if (= skip 1)
                     out
                     (bytes-concat out (single-byte (bytes-at blob (+ (* j stride) i)))))))))))

(defn- add-ecc-and-interleave [ver :i64 ecc :keyword data :bytes] :bytes
  (aei-inter (aei-blocks data ver ecc 0 (bytes-empty)) ver ecc 0 (bytes-empty)))

;; --- grid (one '0'/'1' :string, 2 chars per module: dark, function) ----------

(defn- row-of [n :i64 pair :string acc :string] :string
  (loop [n n pair pair acc acc] (if (<= n 0) acc (recur (- n 1) pair (string-concat acc pair)))))

(defn- grid-rows [row :string n :i64 acc :string] :string
  (loop [row row n n acc acc] (if (<= n 0) acc (recur row (- n 1) (string-concat acc row)))))

(defn- grid-cell [g :string size :i64 x :i64 y :i64] :i64
  (let [idx (* 2 (+ (* y size) x))
        d (if (string=? (string-substring g idx (+ idx 1)) "1") 1 0)
        f (if (string=? (string-substring g (+ idx 1) (+ idx 2)) "1") 1 0)]
    (+ (* 2 d) f)))

(defn- grid-set [g :string idx :i64 cell :i64] :string
  (let [d (quot cell 2)
        f (- cell (* 2 d))
        pair (string-concat (if (= d 1) "1" "0") (if (= f 1) "1" "0"))
        head (string-substring g 0 idx)
        tail (string-substring g (+ idx 2) (string-length g))]
    (string-concat (string-concat head pair) tail)))

(defn- alp-step [i :i64 n :i64 size :i64 step :i64 acc :vector-i64] :vector-i64
  (loop [i i n n size size step step acc acc] (if (>= i n)
    acc
    (recur (+ i 1) n size step
              (vector-assoc acc i
                            (if (= i 0)
                              6
                              (- (- size 7) (* (- (- n 1) i) step))))))))

(defn- alignment-positions [ver :i64 size :i64] :vector-i64
  (if (= ver 1)
    (vector-alloc 0)
    (let [n (+ (quot ver 7) 2)
          step (* 2 (quot (+ (* ver 8) (* n 3) 5) (- (* n 4) 4)))]
      (alp-step 0 n size step (vector-alloc n)))))

;; --- format bits / version bits ----------------------------------------------
;; bit-or has no arm in the ESM emitter (MEASURED: amu compile --target js
;; fails "unsupported KIR operation: bit-or" while wasm32 compiles), so the
;; oracle's three bit-or sites use the exact identity
;;   a | b = (a XOR b) XOR (a AND b)
;; for non-negative i64 -- no semantic change, no new primitive.

(defn- or-bits [a :i64 b :i64] :i64
  (bit-xor (bit-xor a b) (bit-and a b)))

(defn- fmt-step [r :i64 k :i64] :i64
  (loop [r r k k] (if (>= k 10)
    r
    (recur (bit-xor (* r 2) (* (quot r 512) 0x537)) (+ k 1)))))

(defn- format-bits [ecc :keyword mask :i64] :i64
  (let [data (or-bits (* (ecc-format-bits ecc) 8) mask)]
    (bit-xor (or-bits (* data 1024) (bit-and (fmt-step data 0) 0x3FF)) 0x5412)))

(defn- dfb-a [g :string size :i64 bits :i64 i :i64] :string
  (loop [g g size size bits bits i i] (if (>= i 6)
    g
    (recur (grid-set g (* 2 (+ (* i size) 8)) (bit-at bits i)) size bits (+ i 1)))))

(defn- dfb-b [g :string size :i64 bits :i64] :string
  (grid-set (grid-set (grid-set g (* 2 (+ (* 7 size) 8)) (bit-at bits 6))
                      (* 2 (+ (* 8 size) 8)) (bit-at bits 7))
            (* 2 (+ (* 8 size) 7)) (bit-at bits 8)))

(defn- dfb-c [g :string size :i64 bits :i64 i :i64] :string
  (loop [g g size size bits bits i i] (if (>= i 15)
    g
    (recur (grid-set g (* 2 (+ (* 8 size) (- 14 i))) (bit-at bits i)) size bits (+ i 1)))))

(defn- dfb-d [g :string size :i64 bits :i64 i :i64] :string
  (loop [g g size size bits bits i i] (if (>= i 8)
    g
    (recur (grid-set g (* 2 (+ (* 8 size) (- (- size 1) i))) (bit-at bits i)) size bits (+ i 1)))))

(defn- dfb-e [g :string size :i64 bits :i64 i :i64] :string
  (loop [g g size size bits bits i i] (if (>= i 15)
    g
    (recur (grid-set g (* 2 (+ (* (+ (- size 15) i) size) 8)) (bit-at bits i)) size bits (+ i 1)))))

(defn- draw-format-bits [g :string size :i64 ecc :keyword mask :i64] :string
  (let [bits (format-bits ecc mask)
        g1 (dfb-a g size bits 0)
        g2 (dfb-b g1 size bits)
        g3 (dfb-c g2 size bits 9)
        g4 (dfb-d g3 size bits 0)
        g5 (dfb-e g4 size bits 8)]
    (grid-set g5 (* 2 (+ (* (- size 8) size) 8)) 3)))

(defn- dv-rem [r :i64 k :i64] :i64
  (loop [r r k k] (if (>= k 12)
    r
    (recur (bit-xor (* r 2) (* (quot r 2048) 0x1F25)) (+ k 1)))))

(defn- dv-step [g :string size :i64 bits :i64 i :i64] :string
  (loop [g g size size bits bits i i] (if (>= i 18)
    g
    (let [a (+ (- size 11) (mod-n i 3))
          c (quot i 3)
          d (bit-at bits i)
          g1 (grid-set g (* 2 (+ (* c size) a)) (+ (* 2 d) 1))
          g2 (grid-set g1 (* 2 (+ (* a size) c)) (+ (* 2 d) 1))]
      (recur g2 size bits (+ i 1))))))

(defn- draw-version [g :string size :i64 ver :i64] :string
  (if (< ver 7)
    g
    (let [bits (or-bits (* ver 4096) (bit-and (dv-rem ver 0) 0xFFF))]
      (dv-step g size bits 0))))

;; --- function patterns -------------------------------------------------------

(defn- df-scan [g :string size :i64 cx :i64 cy :i64 t :i64] :string
  (loop [g g size size cx cx cy cy t t] (if (>= t 81)
    g
    (let [dy (- (quot t 9) 4)
          dx (- (mod-n t 9) 4)
          x (+ cx dx)
          y (+ cy dy)
          mdx (magnitude dx)
          mdy (magnitude dy)
          d (if (> mdx mdy) mdx mdy)
          inb (if (if (> x -1) (< x size) false)
                (if (if (> y -1) (< y size) false) 1 0)
                0)
          dark (if (if (not= d 2) (not= d 4) false) 1 0)
          g1 (if (= inb 1)
               (grid-set g (* 2 (+ (* y size) x)) (+ (* 2 dark) 1))
               g)]
      (recur g1 size cx cy (+ t 1))))))

(defn- draw-finder [g :string size :i64 cx :i64 cy :i64] :string
  (df-scan g size cx cy 0))

(defn- da-scan [g :string size :i64 cx :i64 cy :i64 t :i64] :string
  (loop [g g size size cx cx cy cy t t] (if (>= t 25)
    g
    (let [dy (- (quot t 5) 2)
          dx (- (mod-n t 5) 2)
          x (+ cx dx)
          y (+ cy dy)
          mdx (magnitude dx)
          mdy (magnitude dy)
          d (if (> mdx mdy) mdx mdy)
          dark (if (= d 1) 0 1)]
      (recur (grid-set g (* 2 (+ (* y size) x)) (+ (* 2 dark) 1))
               size cx cy (+ t 1))))))

(defn- draw-alignment [g :string size :i64 cx :i64 cy :i64] :string
  (da-scan g size cx cy 0))

(defn- fp-timing [g :string size :i64 i :i64] :string
  (loop [g g size size i i] (if (>= i size)
    g
    (let [e (if (= (mod-n i 2) 0) 1 0)
          g1 (grid-set g (* 2 (+ (* i size) 6)) (+ (* 2 e) 1))
          g2 (grid-set g1 (* 2 (+ (* 6 size) i)) (+ (* 2 e) 1))]
      (recur g2 size (+ i 1))))))

(defn- fp-align [g :string size :i64 pos :vector-i64 n :i64 t :i64] :string
  (loop [g g size size pos pos n n t t] (if (>= t (* n n))
    g
    (let [i (quot t n)
          j (mod-n t n)
          skip (if (if (if (= i 0) (= j 0) false) true
                      (if (if (= i 0) (= j (- n 1)) false) true
                        (if (= i (- n 1)) (= j 0) false)))
                 1
                 0)]
      (recur (if (= skip 1)
                  g
                  (draw-alignment g size (vector-at pos i) (vector-at pos j)))
                size pos n (+ t 1))))))

(defn- function-patterns [ver :i64 ecc :keyword] :string
  (let [size (+ 17 (* 4 ver))
        g (grid-rows (row-of size "00" "") size "")
        g1 (fp-timing g size 0)
        g2 (draw-finder g1 size 3 3)
        g3 (draw-finder g2 size (- size 4) 3)
        g4 (draw-finder g3 size 3 (- size 4))
        pos (alignment-positions ver size)
        n (vector-count pos)
        g5 (fp-align g4 size pos n 0)
        g6 (draw-format-bits g5 size ecc 0)]
    (draw-version g6 size ver)))

;; --- codeword placement (zigzag state machine; never materialises coords) ----

(defn- dc-step [g :string k :i64 i :i64 cw :bytes size :i64] :string
  (loop [g g k k i i cw cw size size] (let [pairs (quot (- size 1) 2)
        total (* 8 (bytes-count cw))
        scan (* 2 (* size pairs))]
    (if (if (>= k scan) true (>= i total))
      g
      (let [j (bit-and k 1)
            vert (mod-n (quot k 2) size)
            p (quot (quot k 2) size)
            raw (- (- size 1) (* 2 p))
            right (if (<= raw 6) (- raw 1) raw)
            x (- right j)
            upward (if (= (bit-and (+ right 1) 2) 0) 1 0)
            y (if (= upward 1) (- (- size 1) vert) vert)
            cell (grid-cell g size x y)
            fn (if (= (- cell (* 2 (quot cell 2))) 1) 1 0)]
        (if (= fn 1)
          (recur g (+ k 1) i cw size)
          (let [dark (bit-at (bytes-at cw (quot i 8)) (- 7 (mod-n i 8)))
                g1 (grid-set g (* 2 (+ (* y size) x)) (* 2 dark))]
            (recur g1 (+ k 1) (+ i 1) cw size))))))))

(defn- draw-codewords [g :string cw :bytes size :i64] :string
  (dc-step g 0 0 cw size))

;; --- mask and penalty --------------------------------------------------------

(defn- mask-pred [mask :i64 x :i64 y :i64] :i64
  (if (= mask 0) (if (= (mod-n (+ x y) 2) 0) 1 0)
    (if (= mask 1) (if (= (mod-n y 2) 0) 1 0)
      (if (= mask 2) (if (= (mod-n x 3) 0) 1 0)
        (if (= mask 3) (if (= (mod-n (+ x y) 3) 0) 1 0)
          (if (= mask 4) (if (= (mod-n (+ (quot x 3) (quot y 2)) 2) 0) 1 0)
            (if (= mask 5) (if (= (+ (mod-n (* x y) 2) (mod-n (* x y) 3)) 0) 1 0)
              (if (= mask 6) (if (= (mod-n (+ (mod-n (* x y) 2) (mod-n (* x y) 3)) 2) 0) 1 0)
                (if (= (mod-n (+ (mod-n (+ x y) 2) (mod-n (* x y) 3)) 2) 0) 1 0)))))))))

(defn- am-step [g :string size :i64 mask :i64 t :i64 out :string] :string
  (loop [g g size size mask mask t t out out] (if (>= t (* size size))
    out
    (let [x (mod-n t size)
          y (quot t size)
          cell (grid-cell g size x y)
          d (quot cell 2)
          f (- cell (* 2 d))
          flip (if (if (= f 0) (= (mask-pred mask x y) 1) false) 1 0)
          nd (if (= flip 1) (- 1 d) d)
          pair (string-concat (if (= nd 1) "1" "0") (if (= f 1) "1" "0"))]
      (recur g size mask (+ t 1) (string-concat out pair))))))

(defn- apply-mask [g :string size :i64 mask :i64] :string
  (am-step g size mask 0 ""))

(defn- history-add [size :i64 h :vector-i64 run :i64] :vector-i64
  (let [h0 (vector-at h 0)
        r (if (= h0 0) (+ run size) run)]
    (vector-new r (vector-at h 0) (vector-at h 1) (vector-at h 2)
                (vector-at h 3) (vector-at h 4) (vector-at h 5))))

(defn- history-count [h :vector-i64] :i64
  (let [n (vector-at h 1)
        core (if (if (> n 0) (= (vector-at h 2) n) false)
               (if (= (vector-at h 3) (* n 3))
                 (if (= (vector-at h 4) n) (if (= (vector-at h 5) n) 1 0) 0)
                 0)
               0)
        s1 (if (= core 1) (if (>= (vector-at h 0) (* n 4)) (if (>= (vector-at h 6) n) 1 0) 0) 0)
        s2 (if (= core 1) (if (>= (vector-at h 6) (* n 4)) (if (>= (vector-at h 0) n) 1 0) 0) 0)]
    (+ s1 s2)))

(defn- lp-end [size :i64 h :vector-i64 run :i64 score :i64 color :i64] :i64
  (let [h1 (if (= color 1) (history-add size h run) h)
        run2 (if (= color 1) 0 run)
        h2 (history-add size h1 (+ run2 size))]
    (+ score (* 40 (history-count h2)))))

(defn- line-penalty-step [line :string cr :i64 i :i64 h :vector-i64 score :i64] :i64
  (loop [line line cr cr i i h h score score] (let [size (string-length line)]
    (if (>= i size)
      (lp-end size h (mod-n cr 1024) score (quot cr 1024))
      (let [c (if (string=? (string-substring line i (+ i 1)) "1") 1 0)
            color (quot cr 1024)
            run (mod-n cr 1024)]
        (if (= c color)
          (let [run2 (+ run 1)
                score2 (if (= run2 5) (+ score 3) (if (> run2 5) (+ score 1) score))]
            (recur line (+ (* color 1024) run2) (+ i 1) h score2))
          (let [h1 (history-add size h run)
                score2 (if (= color 1) score (+ score (* 40 (history-count h1))))]
            (recur line (+ (* c 1024) 1) (+ i 1) h1 score2))))))))

(defn- line-penalty [line :string] :i64
  (line-penalty-step line 0 0 (vector-new 0 0 0 0 0 0 0) 0))

(defn- row-str [g :string size :i64 y :i64 t :i64 out :string] :string
  (loop [g g size size y y t t out out] (if (>= t size)
    out
    (recur g size y (+ t 1)
             (string-concat out (if (= (quot (grid-cell g size t y) 2) 1) "1" "0"))))))

(defn- col-str [g :string size :i64 x :i64 t :i64 out :string] :string
  (loop [g g size size x x t t out out] (if (>= t size)
    out
    (recur g size x (+ t 1)
             (string-concat out (if (= (quot (grid-cell g size x t) 2) 1) "1" "0"))))))

(defn- pen-rows [g :string size :i64 y :i64 score :i64] :i64
  (loop [g g size size y y score score] (if (>= y size)
    score
    (recur g size (+ y 1) (+ score (line-penalty (row-str g size y 0 "")))))))

(defn- pen-cols [g :string size :i64 x :i64 score :i64] :i64
  (loop [g g size size x x score score] (if (>= x size)
    score
    (recur g size (+ x 1) (+ score (line-penalty (col-str g size x 0 "")))))))

(defn- pen-blocks [g :string size :i64 t :i64 count :i64] :i64
  (loop [g g size size t t count count] (if (>= t (* (- size 1) (- size 1)))
    (* 3 count)
    (let [y (quot t (- size 1))
          x (mod-n t (- size 1))
          c (grid-cell g size x y)
          eq (if (if (= c (grid-cell g size (+ x 1) y))
                   (if (= c (grid-cell g size x (+ y 1)))
                     (= c (grid-cell g size (+ x 1) (+ y 1)))
                     false)
                   false)
               1
               0)]
      (recur g size (+ t 1) (+ count eq))))))

(defn- pen-dark [g :string size :i64 t :i64 count :i64] :i64
  (loop [g g size size t t count count] (if (>= t (* size size))
    count
    (let [x (mod-n t size)
          y (quot t size)
          d (quot (grid-cell g size x y) 2)]
      (recur g size (+ t 1) (+ count d))))))

(defn- penalty [g :string size :i64] :i64
  (let [rows (pen-rows g size 0 0)
        cols (pen-cols g size 0 0)
        blocks (pen-blocks g size 0 0)
        dark (pen-dark g size 0 0)
        total (* size size)
        k (- (quot (+ (magnitude (- (* dark 20) (* total 10))) total -1) total) 1)]
    (+ rows cols blocks (* 10 k))))

;; --- document field access (every accessor returns [:option ...]) ------------

(defn- dg [d :document k :keyword] :document
  (option-value-of [:option :document] (document-get d k) (document-null)))

(defn- field-kw [d :document k :keyword] :keyword
  (option-value-of [:option :keyword] (document-keyword-value (dg d k)) :none))

(defn- field-i64 [d :document k :keyword] :i64
  (option-value-of [:option :i64] (document-i64-value (dg d k)) 0))

(defn- field-str [d :document k :keyword] :string
  (option-value-of [:option :string] (document-string-value (dg d k)) ""))

;; --- public: encode-bytes ----------------------------------------------------

(defn- bytes-ok? [b :bytes i :i64] :bool
  (loop [b b i i] (if (>= i (bytes-count b))
    true
    (if (>= (bytes-at b i) 128) false (recur b (+ i 1))))))

(defn- ver-fit [ver :i64 n :i64 ecc :keyword] :bool
  (if (< n (if (<= ver 9) 256 65536))
    (<= (data-bits-needed ver n) (* 8 (num-data-codewords ver ecc)))
    false))

(defn- ver-search [n :i64 ecc :keyword ver :i64 hi :i64] :i64
  (loop [n n ecc ecc ver ver hi hi] (if (> ver hi)
    -1
    (if (ver-fit ver n ecc) ver (recur n ecc (+ ver 1) hi)))))

(defn- mask-scores [base :string size :i64 ecc :keyword m :i64 acc :vector-i64] :vector-i64
  (loop [base base size size ecc ecc m m acc acc] (if (>= m 8)
    acc
    (let [p (penalty (draw-format-bits (apply-mask base size m) size ecc m) size)]
      (recur base size ecc (+ m 1) (vector-assoc acc m p))))))

(defn- mask-pick [scores :vector-i64 m :i64 best :i64 best-score :i64] :i64
  (loop [scores scores m m best best best-score best-score] (if (>= m 8)
    best
    (let [p (vector-at scores m)]
      (if (< p best-score)
        (recur scores (+ m 1) m p)
        (recur scores (+ m 1) best best-score))))))

(defn- mask-search [base :string size :i64 ecc :keyword] :i64
  (let [s (mask-scores base size ecc 0 (vector-alloc 8))]
    (mask-pick s 1 0 (vector-at s 0))))

(defn encode-bytes [data :string ecc :keyword min-version :i64 max-version :i64 mask [:option :i64]] :document
  (let [db (string-to-utf8 data)
        n (bytes-count db)]
    (if (if (bytes-ok? db 0) false true)
      (document-map :status (document-keyword :error) :reason (document-keyword :not-bytes))
      (if (< (ecc-ordinal ecc) 0)
        (document-map :status (document-keyword :error) :reason (document-keyword :ecc)
                      :ecc (document-keyword ecc))
        (let [ver (ver-search n ecc min-version max-version)]
          (if (< ver 0)
            (document-map :status (document-keyword :error) :reason (document-keyword :does-not-fit))
            (let [size (+ 17 (* 4 ver))
                  cw (add-ecc-and-interleave ver ecc (data-codewords ver ecc data))
                  base (draw-codewords (function-patterns ver ecc) cw size)
                  mv (option-value-of [:option :i64] mask -1)
                  m (if (< mv 0) (mask-search base size ecc) mv)
                  g (draw-format-bits (apply-mask base size m) size ecc m)]
              (document-map
               :status (document-keyword :ok)
               :version (document-i64 ver)
               :ecc (document-keyword ecc)
               :mask (document-i64 m)
               :size (document-i64 size)
               :grid (document-string g)))))))))

;; --- public: ascii-bytes (the single reader-conditional's resolution) --------

(defn- ascii-scan [b :bytes i :i64] :bool
  (loop [b b i i] (if (>= i (bytes-count b))
    true
    (let [c (bytes-at b i)]
      (if (if (>= c 32) (<= c 126) false) (recur b (+ i 1)) false)))))

(defn ascii-bytes [s :string] [:option :string]
  (if (ascii-scan (string-to-utf8 s) 0)
    (document-string-value (document-string s))
    (document-string-value (document-null))))

;; --- public: terminal-lines --------------------------------------------------

(defn- esc-s [] :string
  (string-from-utf8 (single-byte 27)))

(defn- nl-s [] :string
  (string-from-utf8 (single-byte 10)))

;; The overflow sentinel is byte 1 (SOH): valid single-byte UTF-8 (measured:
;; string-from-utf8 of byte 0xFF traps utf8/invalid-byte on jvm-kir and is a
;; test trap on js/wasm), and no rendered line can equal it -- rendered output
;; is spaces (0x20), ESC (0x1B), '[', '0', '7', 'm' and NL (0x0A) only. The
;; sentinel never escapes: terminal-lines maps it to [:option :string] none.
(defn- overflow-mark [] :string
  (string-from-utf8 (single-byte 1)))

(defn- spaces-n [n :i64 acc :string] :string
  (loop [n n acc acc] (if (<= n 0) acc (recur (- n 1) (string-concat acc " ")))))

(defn- tl-run [dark :i64 n :i64] :string
  (let [cells (spaces-n (* 2 n) "")]
    (if (= dark 1)
      cells
      (string-concat (esc-s)
                     (string-concat "[7m" (string-concat cells (string-concat (esc-s) "[0m")))))))

(defn- tl-dark [g :string size :i64 x :i64 y :i64] :i64
  (let [xd (- x 4)
        yd (- y 4)]
    (if (if (if (> xd -1) (< xd size) false) (if (if (> yd -1) (< yd size) false) true false) false)
      (quot (grid-cell g size xd yd) 2)
      0)))

(defn- tl-line-step [g :string size :i64 y :i64 st :i64 out :string] :string
  (loop [g g size size y y st st out out] (let [dim (+ size 8)
        run (mod-n st 1024)
        rest (quot st 1024)
        color (mod-n rest 2)
        x (quot rest 2)]
    (if (>= x dim)
      (if (> run 0) (string-concat out (tl-run color run)) out)
      (let [c (tl-dark g size x y)]
        (if (= run 0)
          (recur g size y (+ (* (+ (* (+ x 1) 2) c) 1024) 1) out)
          (if (= c color)
            (recur g size y (+ (* (+ (* (+ x 1) 2) color) 1024) (+ run 1)) out)
            (recur g size y (+ (* (+ (* (+ x 1) 2) c) 1024) 1)
                          (string-concat out (tl-run color run))))))))))

(defn- tl-line [g :string size :i64 y :i64] :string
  (tl-line-step g size y 0 ""))

(defn- tl-lines [g :string size :i64 y :i64 out :string] :string
  (loop [g g size size y y out out] (let [dim (+ size 8)]
    (if (>= y dim)
      out
      (let [line (tl-line g size y)
            need (+ (string-length out) (if (> y 0) 1 0) (string-length line))]
        (if (> need 65536)
          (overflow-mark)
          (recur g size (+ y 1)
                    (if (> y 0) (string-concat out (string-concat (nl-s) line)) line))))))))

(defn terminal-lines [grid :string size :i64] [:option :string]
  (let [r (tl-lines grid size 0 "")]
    (if (string=? r (overflow-mark))
      (document-string-value (document-null))
      (document-string-value (document-string r)))))

;; --- main (entryless-library guard; browser host requires main -> i64) -------

(defn main [] :i64
  (let [r (encode-bytes "https://example.com/" :medium 1 40 (document-i64-value (document-null)))]
    (if (= (field-kw r :status) :ok) (field-i64 r :size) -1)))

;; --- test helpers (decode side; used only by the test-* defns) ---------------
;; The guest is an encoder; the "decode" below reads the encoded form back
;; through the same positional primitives (bit-at / bytes-at), giving a true
;; encode/decode round trip over the internal representations (bit stream,
;; codeword bytes, grid cells, RS remainder). a-pow doubles a string k times
;; (tail-recursive, depth <= 11) for exact-length boundary fixtures.

(defn- a-pow [acc :string k :i64] :string
  (loop [acc acc k k] (if (> k 0)
    (recur (string-concat acc acc) (- k 1))
    acc)))

(defn- cw-bit [cw :bytes pos :i64] :i64
  (bit-at (bytes-at cw (quot pos 8)) (- 7 (mod-n pos 8))))

(defn- dec-byte-k [cw :bytes pos :i64 k :i64 acc :i64] :i64
  (loop [cw cw pos pos k k acc acc] (if (>= k 8)
    acc
    (recur cw (+ pos 1) (+ k 1) (+ (* 2 acc) (cw-bit cw pos))))))

(defn- dec-byte [cw :bytes pos :i64] :i64
  (dec-byte-k cw pos 0 0))

(defn- dec-payload [cw :bytes pos :i64 n :i64 acc :string] :string
  (loop [cw cw pos pos n n acc acc] (if (<= n 0)
    acc
    (recur cw (+ pos 8) (- n 1)
                 (string-concat acc (string-from-utf8 (single-byte (dec-byte cw pos))))))))

;; --- tests (exported; and-chains of equalities) ------------------------------

(defn test-capacity [] :bool
  (and (= 208 (num-raw-data-modules 1))
       (= 359 (num-raw-data-modules 2))
       (= 29648 (num-raw-data-modules 40))
       (= 19 (num-data-codewords 1 :low))
       (= 16 (num-data-codewords 1 :medium))
       (= 13 (num-data-codewords 1 :quartile))
       (= 9 (num-data-codewords 1 :high))
       (= 34 (num-data-codewords 2 :low))
       (= 8 (char-count-bits 1))
       (= 16 (char-count-bits 10))
       (= 7 (block-ecc-len 1 :low))
       (= 1 (num-blocks 1 :low))
       (= 25 (num-blocks 40 :low))
       (= 28 (data-bits-needed 1 2))))

(defn test-gf-mul [] :bool
  (and (= 29 (gf-mul 2 128))
       (= 29 (gf-mul 128 2))
       (= 0 (gf-mul 0 200))
       (= 85 (gf-mul 85 1))
       (= 85 (gf-mul 1 85))
       (= 4 (gf-mul 2 2))
       (= (gf-mul 85 200) (gf-mul 200 85))
       (= (gf-mul (gf-mul 85 200) 17) (gf-mul 85 (gf-mul 200 17)))))

(defn test-rs-remainder [] :bool
  (let [div (rs-divisor 7)
        dat (string-to-utf8 "HELLO-QR")
        r (rs-remainder dat div)
        ext (bytes-concat dat r)
        z (rs-remainder ext div)]
    (and (= 7 (bytes-count r))
         (= 0 (bytes-at z 0))
         (= 0 (bytes-at z 1))
         (= 0 (bytes-at z 2))
         (= 0 (bytes-at z 3))
         (= 0 (bytes-at z 4))
         (= 0 (bytes-at z 5))
         (= 0 (bytes-at z 6))
         (= 19 (bytes-count (data-codewords 1 :low "HELLO-QR"))))))

(defn test-encode-bytes [] :bool
  (let [none (document-i64-value (document-null))
        r (encode-bytes "https://example.com/" :medium 1 40 none)
        g (field-str r :grid)
        r3 (encode-bytes "hi" :low 1 40 (document-i64-value (document-i64 3)))
        e1 (encode-bytes "aÿb" :medium 1 40 none)
        e2 (encode-bytes "abc" :bogus 1 40 none)
        e3 (encode-bytes "https://example.com/" :medium 1 1 none)]
    (and (= :ok (field-kw r :status))
         (= 2 (field-i64 r :version))
         (= :medium (field-kw r :ecc))
         (= 25 (field-i64 r :size))
         (= 1 (if (if (>= (field-i64 r :mask) 0) (<= (field-i64 r :mask) 7) false) 1 0))
         (= 3 (grid-cell g 25 0 0))
         (= 3 (grid-cell g 25 8 6))
         (= :ok (field-kw r3 :status))
         (= 1 (field-i64 r3 :version))
         (= 3 (field-i64 r3 :mask))
         (= 21 (field-i64 r3 :size))
         (= :error (field-kw e1 :status))
         (= :not-bytes (field-kw e1 :reason))
         (= :error (field-kw e2 :status))
         (= :ecc (field-kw e2 :reason))
         (= :bogus (field-kw e2 :ecc))
         (= :error (field-kw e3 :status))
         (= :does-not-fit (field-kw e3 :reason)))))

(defn test-ascii-bytes [] :bool
  (let [del (string-concat "a" (string-concat (string-from-utf8 (single-byte 127)) "b"))]
    (and (string=? "A z~" (option-value-of [:option :string] (ascii-bytes "A z~") "<none>"))
         (string=? " ~" (option-value-of [:option :string] (ascii-bytes " ~") "<none>"))
         (string=? "" (option-value-of [:option :string] (ascii-bytes "") "<none>"))
         (string=? "aAb" (option-value-of [:option :string] (ascii-bytes "aAb") "<none>"))
         (string=? "<none>" (option-value-of [:option :string] (ascii-bytes "aÿb") "<none>"))
         (string=? "<none>" (option-value-of [:option :string] (ascii-bytes del) "<none>")))))

(defn test-terminal-lines [] :bool
  (let [esc7 (string-concat (esc-s) "[7m")
        esc0 (string-concat (esc-s) "[0m")
        nl (nl-s)
        row-a (string-concat esc7 (string-concat (spaces-n 18 "") esc0))
        row-c (string-concat esc7
                 (string-concat (spaces-n 8 "")
                   (string-concat esc0
                     (string-concat (spaces-n 2 "")
                       (string-concat esc7
                         (string-concat (spaces-n 8 "") esc0))))))
        an (string-concat row-a nl)
        cn (string-concat row-c nl)
        j2 (string-concat an an)
        j3 (string-concat j2 an)
        j4 (string-concat j3 an)
        j5 (string-concat j4 cn)
        j6 (string-concat j5 an)
        j7 (string-concat j6 an)
        j8 (string-concat j7 an)
        expect (string-concat j8 row-a)
        r (option-value-of [:option :string] (terminal-lines "10" 1) "<none>")
        big (row-of 177 "11" "")
        rbig (option-value-of [:option :string]
                              (terminal-lines (grid-rows big 177 "") 177)
                              "<none>")]
    (and (string=? expect r)
         (= 250 (string-length r))
         (string=? "<none>" rbig))))

(defn test-round-trip [] :bool
  (let [d1 "HELLO-QR"
        d2 "A"
        c1 (data-codewords 1 :low d1)
        c2 (data-codewords 1 :low d2)
        c0 (data-codewords 1 :low "")
        p1 (dec-payload c1 12 (bytes-count (string-to-utf8 d1)) "")
        p2 (dec-payload c2 12 1 "")
        p0 (dec-payload c0 12 0 "")
        bs (push-bits "" 165 8)
        bb (bits-to-bytes bs 0 (bytes-empty))
        g0 (grid-rows (row-of 21 "00" "") 21 "")
        g1 (grid-set g0 (* 2 (+ (* 3 21) 5)) 3)
        g2 (grid-set g1 (* 2 (+ (* 20 21) 20)) 2)
        div (rs-divisor 10)
        dat (string-to-utf8 "round-trip-check")
        r (rs-remainder dat div)
        z (rs-remainder (bytes-concat dat r) div)]
    (and (string=? d1 p1)
         (string=? d2 p2)
         (string=? "" p0)
         (= 64 (dec-byte c1 0))
         (= 19 (bytes-count c1))
         (= 19 (bytes-count c0))
         (string=? "10100101" bs)
         (= 165 (dec-byte bb 0))
         (= 1 (bytes-count bb))
         (= 3 (grid-cell g2 21 5 3))
         (= 2 (grid-cell g2 21 20 20))
         (= 0 (grid-cell g2 21 0 0))
         (= 0 (grid-cell g1 21 20 20))
         (= 10 (bytes-count r))
         (= 0 (bytes-at z 0))
         (= 0 (bytes-at z 1))
         (= 0 (bytes-at z 2))
         (= 0 (bytes-at z 3))
         (= 0 (bytes-at z 4))
         (= 0 (bytes-at z 5))
         (= 0 (bytes-at z 6))
         (= 0 (bytes-at z 7))
         (= 0 (bytes-at z 8))
         (= 0 (bytes-at z 9)))))

(defn test-boundary [] :bool
  (let [p256 (a-pow " " 8)
        p512 (a-pow " " 9)
        p2048 (a-pow " " 11)
        p128 (a-pow " " 7)
        p64 (a-pow " " 6)
        p32 (a-pow " " 5)
        p8 (a-pow " " 3)
        p4 (a-pow " " 2)
        p2 (a-pow " " 1)
        w100 (string-concat (string-concat p64 p32) p4)
        w2954 (string-concat (string-concat p2048 p512)
                             (string-concat (string-concat p256 p128) (string-concat p8 p2)))
        none (document-i64-value (document-null))
        e (encode-bytes "" :low 1 40 none)
        s (encode-bytes "A" :low 1 40 none)
        p17 (encode-bytes "0123456789ABCDEFG" :low 1 1 none)
        p18 (encode-bytes "0123456789ABCDEFGH" :low 1 1 none)
        m (encode-bytes w100 :low 1 40 none)
        t (encode-bytes w2954 :low 1 40 none)]
    (and (= 100 (string-length w100))
         (= 2954 (string-length w2954))
         (= :ok (field-kw e :status))
         (= 1 (field-i64 e :version))
         (= 21 (field-i64 e :size))
         (= :ok (field-kw s :status))
         (= 1 (field-i64 s :version))
         (= :ok (field-kw p17 :status))
         (= 1 (field-i64 p17 :version))
         (= :error (field-kw p18 :status))
         (= :does-not-fit (field-kw p18 :reason))
         (= :ok (field-kw m :status))
         (= 5 (field-i64 m :version))
         (= 37 (field-i64 m :size))
         (= 1 (if (ver-fit 40 2953 :low) 1 0))
         (= 0 (if (ver-fit 40 2954 :low) 1 0))
         (= :error (field-kw t :status))
         (= :does-not-fit (field-kw t :reason)))))

(defn test-error-status [] :bool
  (let [none (document-i64-value (document-null))
        e1 (encode-bytes "aÿb" :medium 1 40 none)
        e2 (encode-bytes "abc" :bogus 1 40 none)
        e3 (encode-bytes "0123456789ABCDEFGH" :low 1 1 none)
        del (string-concat "a" (string-concat (string-from-utf8 (single-byte 127)) "b"))
        a1 (option-value-of [:option :string] (ascii-bytes "aÿb") "<none>")
        a2 (option-value-of [:option :string] (ascii-bytes del) "<none>")
        big (row-of 177 "11" "")
        tl (option-value-of [:option :string] (terminal-lines (grid-rows big 177 "") 177) "<none>")]
    (and (= :error (field-kw e1 :status))
         (= :not-bytes (field-kw e1 :reason))
         (= :error (field-kw e2 :status))
         (= :ecc (field-kw e2 :reason))
         (= :bogus (field-kw e2 :ecc))
         (= :error (field-kw e3 :status))
         (= :does-not-fit (field-kw e3 :reason))
         (string=? "<none>" a1)
         (string=? "<none>" a2)
         (string=? "<none>" tl))))

(defn test-mod-quot [] :bool
  (and (= 1 (mod-n 10 3))
       (= 0 (mod-n 9 3))
       (= 0 (mod-n 0 2))
       (= 4 (mod-n 25 7))
       (= 0 (mod-n 21 21))
       (= 2 (mod-n 100 7))
       (= 8 (mod-n 8 9))
       (= 3 (quot 10 3))
       (= 0 (quot 0 5))
       (= 3 (quot 7 2))
       (= 37 (+ (* 5 (quot 37 5)) (mod-n 37 5)))
       (= 255 (+ (* 16 (quot 255 16)) (mod-n 255 16)))))
