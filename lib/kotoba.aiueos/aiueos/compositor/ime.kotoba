;; aiueos.compositor.ime -- romaji conversion core as a pure Kotoba guest
;; (oracle: src/aiueos/compositor/ime.cljk).
;;
;; The oracle's mora table (111 entries, measured) exceeds the 32-entry
;; document-map limit by 3.5x, so the table splits into four chunk maps
;; scanned in order -- the oracle's single get becomes four gets behind one
;; lookup, and the split is stated here so nobody reads it as semantics.
;;
;; convert-buf: greedy longest mora from the start, remainder stays in the
;; buffer. sokuon (consonant doubling before a k/s/t/p mora) emits the
;; small tsu first -- same rule as the oracle.
;;
;; The key-event state machine (handle-key) stays in the oracle for now:
;; its string work is heavier and the conversion core is the decision the
;; compositor's kana gate needs. Compile (single file, JVM-free):
;;   kotoba compile aiueos/compositor/ime.kotoba --target wasm32-browser --output ime.wasm

(ns aiueos.compositor.ime
  (:export [lookup convert-buf]))

(defn- opt [d :document k :document] :document
  (option-value-of [:option :document] (document-get d k) (document-null)))

(defn- mora-0 [] :document
  (document-map (document-string "a") (document-string "あ") (document-string "i") (document-string "い") (document-string "u") (document-string "う") (document-string "e") (document-string "え") (document-string "o") (document-string "お") (document-string "ka") (document-string "か") (document-string "ki") (document-string "き") (document-string "ku") (document-string "く") (document-string "ke") (document-string "け") (document-string "ko") (document-string "こ") (document-string "sa") (document-string "さ") (document-string "si") (document-string "し") (document-string "su") (document-string "す") (document-string "se") (document-string "せ") (document-string "so") (document-string "そ") (document-string "shi") (document-string "し") (document-string "ta") (document-string "た") (document-string "ti") (document-string "ち") (document-string "tu") (document-string "つ") (document-string "te") (document-string "て") (document-string "to") (document-string "と") (document-string "chi") (document-string "ち") (document-string "tsu") (document-string "つ") (document-string "na") (document-string "な") (document-string "ni") (document-string "に") (document-string "nu") (document-string "ぬ") (document-string "ne") (document-string "ね") (document-string "no") (document-string "の") (document-string "ha") (document-string "は") (document-string "hi") (document-string "ひ") (document-string "hu") (document-string "ふ") (document-string "he") (document-string "へ")))

(defn- mora-1 [] :document
  (document-map (document-string "ho") (document-string "ほ") (document-string "fu") (document-string "ふ") (document-string "ma") (document-string "ま") (document-string "mi") (document-string "み") (document-string "mu") (document-string "む") (document-string "me") (document-string "め") (document-string "mo") (document-string "も") (document-string "ya") (document-string "や") (document-string "yu") (document-string "ゆ") (document-string "yo") (document-string "よ") (document-string "ra") (document-string "ら") (document-string "ri") (document-string "り") (document-string "ru") (document-string "る") (document-string "re") (document-string "れ") (document-string "ro") (document-string "ろ") (document-string "wa") (document-string "わ") (document-string "wo") (document-string "を") (document-string "nn") (document-string "ん") (document-string "n'") (document-string "ん") (document-string "ga") (document-string "が") (document-string "gi") (document-string "ぎ") (document-string "gu") (document-string "ぐ") (document-string "ge") (document-string "げ") (document-string "go") (document-string "ご") (document-string "za") (document-string "ざ") (document-string "zi") (document-string "じ") (document-string "zu") (document-string "ず") (document-string "ze") (document-string "ぜ") (document-string "zo") (document-string "ぞ") (document-string "ji") (document-string "じ") (document-string "da") (document-string "だ") (document-string "di") (document-string "ぢ")))

(defn- mora-2 [] :document
  (document-map (document-string "du") (document-string "づ") (document-string "de") (document-string "で") (document-string "do") (document-string "ど") (document-string "ba") (document-string "ば") (document-string "bi") (document-string "び") (document-string "bu") (document-string "ぶ") (document-string "be") (document-string "べ") (document-string "bo") (document-string "ぼ") (document-string "pa") (document-string "ぱ") (document-string "pi") (document-string "ぴ") (document-string "pu") (document-string "ぷ") (document-string "pe") (document-string "ぺ") (document-string "po") (document-string "ぽ") (document-string "kya") (document-string "きゃ") (document-string "kyu") (document-string "きゅ") (document-string "kyo") (document-string "きょ") (document-string "sha") (document-string "しゃ") (document-string "shu") (document-string "しゅ") (document-string "sho") (document-string "しょ") (document-string "cha") (document-string "ちゃ") (document-string "chu") (document-string "ちゅ") (document-string "cho") (document-string "ちょ") (document-string "nya") (document-string "にゃ") (document-string "nyu") (document-string "にゅ") (document-string "nyo") (document-string "にょ") (document-string "hya") (document-string "ひゃ") (document-string "hyu") (document-string "ひゅ") (document-string "hyo") (document-string "ひょ") (document-string "mya") (document-string "みゃ") (document-string "myu") (document-string "みゅ") (document-string "myo") (document-string "みょ") (document-string "rya") (document-string "りゃ")))

(defn- mora-3 [] :document
  (document-map (document-string "ryu") (document-string "りゅ") (document-string "ryo") (document-string "りょ") (document-string "gya") (document-string "ぎゃ") (document-string "gyu") (document-string "ぎゅ") (document-string "gyo") (document-string "ぎょ") (document-string "ja") (document-string "じゃ") (document-string "ju") (document-string "じゅ") (document-string "jo") (document-string "じょ") (document-string "bya") (document-string "びゃ") (document-string "byu") (document-string "びゅ") (document-string "byo") (document-string "びょ") (document-string "pya") (document-string "ぴゃ") (document-string "pyu") (document-string "ぴゅ") (document-string "pyo") (document-string "ぴょ") (document-string ".") (document-string "。")))

(defn- try-chunk-0 [k :string] :document
  (opt (mora-0) (document-string k)))
(defn- try-chunk-1 [k :string] :document
  (opt (mora-1) (document-string k)))
(defn- try-chunk-2 [k :string] :document
  (opt (mora-2) (document-string k)))
(defn- try-chunk-3 [k :string] :document
  (opt (mora-3) (document-string k)))
(defn- lookup-3 [k :string] :document
  (try-chunk-3 k))

(defn- lookup-2 [k :string] :document
  (let [hit (try-chunk-2 k)]
    (if (= (document-count hit) 0)
      (lookup-3 k)
      hit)))

(defn- lookup-1 [k :string] :document
  (let [hit (try-chunk-1 k)]
    (if (= (document-count hit) 0)
      (lookup-2 k)
      hit)))

(defn- lookup-0 [k :string] :document
  (let [hit (try-chunk-0 k)]
    (if (= (document-count hit) 0)
      (lookup-1 k)
      hit)))

(defn lookup [k :string] :document
  (lookup-0 k))

;; convert-buf: greedy longest mora from the start. The oracle tries lengths
;; 3 then 2 then 1; sokuon doubles the first consonant into a small tsu and
;; recurses on the rest. Returns :preedit and the unconsumed :buf.


(defn- is-blank [s :string] :bool
  (= (string-length s) 0))

(defn- try-len [s :string n :i64] :document
  (lookup (string-substring s 0 n)))

(defn- conv-loop [s :string out :string] :document
  (if (is-blank s)
    (document-map :preedit (document-string out) :buf (document-string ""))
    (if (and (>= (string-length s) 2)
             (= (document-count (lookup (string-substring s 0 1))) 0)
             (= (document-count (lookup (string-substring s 1 2))) 0))
      (conv-loop (string-substring s 1 (string-length s))
                 (string-concat out "っ"))
      (let [hit3 (try-len s 3)
            hit2 (if (= (document-count hit3) 0) (try-len s 2) hit3)
            hit (if (= (document-count hit2) 0) (try-len s 1) hit2)]
        (if (= (document-count hit) 0)
          (document-map :preedit (document-string out) :buf (document-string s))
          (let [plen (if (= (document-count hit3) 0)
                       (if (= (document-count hit2) 0) 1 2)
                       3)]
            (conv-loop (string-substring s plen (string-length s))
                       (option-value-of [:option :string] (document-string-value hit) ""))))))))

(defn convert-buf [buf :string] :document
  (conv-loop buf ""))
