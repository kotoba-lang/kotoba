;; aiueos.hardware-qualification -- fail-closed boot receipt classification
;; as a pure Kotoba guest (oracle: src/aiueos/hardware_qualification.cljk).
;;
;; A QEMU result is conformance evidence, never qualification of a physical
;; machine. The guest owns the classification: every required capability is
;; named independently so a static GOP frame cannot pass for a working
;; desktop and PCI enumeration cannot pass for a usable driver. Fail-closed:
;; absence is missing, never inferred from nearby evidence.
;;
;; The observed set arrives as an 11-bit vector (one i64 per capability,
;; 1 = observed):
;;   0 uefi-removable-boot   1 gop-visible-diagnostics  2 acpi-admitted
;;   3 pci-inventory         4 nvme-read                5 xhci-hid-keyboard
;;   6 physical-ethernet-link 7 encrypted-data-roundtrip
;;   8 installer-safety-gates 9 nvme-write (destructive)
;;  10 internal-install (destructive)
;;
;; Destructive capabilities count only when destructive-test? is explicitly
;; true -- an ordinary diagnostic boot must leave it false, and a destructive
;; marker without that authority is itself a refusal reason.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile aiueos/hardware_qualification.kotoba --target wasm32-browser --output hq.wasm

(ns aiueos.hardware-qualification
  (:export [qualify]))

(defn- at [v :document i :i64] :i64
  (option-value-of [:option :i64]
    (document-i64-value (option-value-of [:option :document] (document-vector-at v i) (document-i64 0)))
    0))

;; missing-scan: any required capability (0..8) absent -> true.
(defn- any-required-missing [observed :document i :i64] :bool
  (if (> i 8)
    false
    (if (= (at observed i) 1)
      (any-required-missing observed (+ i 1))
      true)))

(defn- destructive-observed [observed :document i :i64] :bool
  (if (> i 10)
    false
    (if (= (at observed i) 1)
      true
      (destructive-observed observed (+ i 1)))))

(defn- push-reason [errs :document kw :keyword] :document
  (document-vector-conj errs (document-keyword kw)))

(defn qualify
  [format-ok? :bool physical? :bool machine-bound? :bool
   destructive-test? :i64 observed :document] :document
  (let [errs (document-vector)
        e1 (if format-ok? errs (push-reason errs :invalid-format))
        e2 (if physical? e1 (push-reason e1 :not-physical-boot))
        e3 (if machine-bound? e2 (push-reason e2 :machine-identity-missing))
        e4 (if (any-required-missing observed 0)
             (push-reason e3 :required-capabilities-missing) e3)
        e5 (if (if (destructive-observed observed 9) (= destructive-test? 1) false)
             e4
             (push-reason e4 :destructive-marker-without-authority))]
    (document-map
     :qualified (document-keyword (if (= (document-count e5) 0) :yes :no))
     :reasons e5)))
