;; aiueos.network-bootstrap -- first-boot network decisions as a pure Kotoba guest
;; (oracle: namespace aiueos.network-bootstrap, src/aiueos/network_bootstrap.cljk
;; in lib/kotoba.aiueos).
;;
;; The oracle answers two questions separately -- may an interface carry first
;; boot (bootstrap-decision) and may it be recorded as the machine's own network
;; (durable?) -- and the receipt keeps them apart. The guest owns the whole
;; decision surface: the interface-class table, tether membership, the
;; addressing-refusal ladder, the ranking rule and the receipt/summary shapes.
;; Interface enumeration and I/O stay in the host; probe facts arrive as
;; :document fields. Pure: decisions in, decisions out.
;;
;; ex-info -> :error mapping (throw is forbidden; the oracle itself contains
;; zero throw/ex-info forms and encodes failure as {:ok false :reason kw},
;; which is preserved here; the rows below cover boundary cases where Clojure
;; would throw or NPE on malformed data -- each becomes an :error status):
;;   summary on a non-receipt / missing or unknown :state    -> [:error :bad-receipt]
;;   summary when :reason/:class is not a known keyword      -> [:error :bad-receipt]
;;   select with more than 32 candidates (bounds) or a
;;     non-vector candidate container                        -> [:error :bad-candidates]
;;   receipt on a selection document missing :ok             -> [:error :bad-selection]
;;   bootstrap-decision on a missing/mistyped field          -> NOT an error:
;;     [:option ...] unwrap defaults fail closed (carrier false, class
;;     absent, addressing absent) and the ladder yields the oracle refusals;
;;     absent/unrecognised addressing stay value-level
;;     (:addressing-unknown / :addressing-unrecognised).
;; [:error <kw>] is spelled as a document {:error <kw>} in the :document
;; fns (select, receipt) and as the literal string ":error :bad-receipt" in
;; summary (whose oracle return is a string).
;;
;; Bounds: max 5 parameters per defn; :container-items 32 (candidate,
;; refused, alternatives, :owed and :must-not vectors all fit; select refuses
;; more than 32 candidates with [:error :bad-candidates]).
;;
;; Divergences from the oracle, deliberate and recorded:
;;   - (:require [kotoba.lang.text :as str]) dropped -- standalone guest,
;;     namespace-require-needs-project; str/join becomes the join-refused
;;     loop. Dependencies are pushed to the host side.
;;   - interface-classes (computed def -- def-value-not-constant) becomes the
;;     interface-class-found? predicate plus the interface-class fn;
;;     tether-classes (set) becomes the tether-class? predicate; class-rank
;;     (zipmap def) becomes the class-rank fn (99 default preserved).
;;   - bootstrap-decision keeps one arity ([iface opts]); the oracle's
;;     1-arity convenience is dropped -- callers pass an empty document.
;;     addressing-refusal takes (addressing static-allowed?) positionally and
;;     returns the :ok sentinel where the oracle returns nil.
;;   - result key :ok? is renamed :ok; :aiueos.network-bootstrap/state is
;;     renamed :state; booleans ride documents as i64 0/1 (guest idiom).
;;   - keyword `name` becomes the kw-name ladder over the reachable
;;     vocabulary (no keyword-name builtin assumed); no regex literals
;;     anywhere -- positional scanning only.
;;   - select's third sort key (interface name, oracle sort-by on
;;     (str (:name i))) is dropped: no char-code accessor is admitted for a
;;     positional string<? scan, so ties on (durability, class-rank) keep
;;     probe input order -- stable and deterministic.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile aiueos/network_bootstrap.kotoba --target wasm32-browser --output network_bootstrap.wasm

(ns aiueos.network-bootstrap
  (:export [interface-class tether-class? bootstrap-decision durable?
            select receipt summary
            test-addressing-refusal-ladder test-bootstrap-decision-pci
            test-bootstrap-decision-tether test-bootstrap-decision-unknown-class
            test-durable?-ephemeral-false test-select-ranking
            test-receipt-owed test-summary-refused test-summary-bootstrapped
            test-accessor-fail-closed test-interface-class-table
            test-tether-class-matrix test-error-paths test-summary-join-two]))

;; --- document accessors ------------------------------------------------------
;; Built-in document accessors return [:option ...]; these unwrap with a
;; fail-closed default so a missing or mistyped field never throws.

(defn- dg [d :document k :keyword] :document
  (option-value-of [:option :document] (document-get d k) (document-null)))

(defn- ds [d :document k :keyword] :string
  (option-value-of [:option :string] (document-string-value (dg d k)) ""))

(defn- di [d :document k :keyword] :i64
  (option-value-of [:option :i64] (document-i64-value (dg d k)) 0))

(defn- di-or [d :document k :keyword dflt :i64] :i64
  (option-value-of [:option :i64] (document-i64-value (dg d k)) dflt))

(defn- dkw [d :document k :keyword] :keyword
  (option-value-of [:option :keyword] (document-keyword-value (dg d k)) :__absent))

(defn- flag [d :document k :keyword] :bool
  (= (di d k) 1))

(defn- empty-doc [] :document
  (document-map))

(defn- elt [v :document i :i64] :document
  ;; fail-closed default is an empty map, not document-null: the null document
  ;; traps document-count ("document-container-required"), so an out-of-range
  ;; elt must still yield a countable container (0 items).
  (option-value-of [:option :document] (document-vector-at v i) (document-map)))

(defn- error-doc [k :keyword] :document
  (document-map :error (document-keyword k)))

;; --- keyword-name ladder -----------------------------------------------------
;; (name kw) stand-in: the reachable vocabulary of states, refusal reasons and
;; interface classes, in the oracle's spelling.

(defn- kw-name [k :keyword] :string
  (if (= k :refused) "refused"
  (if (= k :bootstrapped) "bootstrapped"
  (if (= k :no-interface-class) "no-interface-class"
  (if (= k :unknown-interface-class) "unknown-interface-class"
  (if (= k :class-not-admitted-for-bootstrap) "class-not-admitted-for-bootstrap"
  (if (= k :no-carrier) "no-carrier"
  (if (= k :static-addressing-not-authorised) "static-addressing-not-authorised"
  (if (= k :link-local-only-is-not-a-network) "link-local-only-is-not-a-network"
  (if (= k :no-address) "no-address"
  (if (= k :addressing-unknown) "addressing-unknown"
  (if (= k :addressing-unrecognised) "addressing-unrecognised"
  (if (= k :no-admissible-interface) "no-admissible-interface"
  (if (= k :pci-ethernet) "pci-ethernet"
  (if (= k :usb-ethernet-adapter) "usb-ethernet-adapter"
  (if (= k :usb-cdc-ncm) "usb-cdc-ncm"
  (if (= k :usb-cdc-ecm) "usb-cdc-ecm"
  (if (= k :usb-rndis) "usb-rndis"
  (if (= k :usb-ipheth) "usb-ipheth"
  (if (= k :wifi-sta) "wifi-sta"
  (if (= k :loopback) "loopback"
  (if (= k :unknown) "unknown"
  "unknown"))))))))))))))))))))))

;; --- interface classes -------------------------------------------------------
;; The oracle's interface-classes table, positional. `:bootstrap` -- may the
;; class carry first boot (i64 1/0). `:durability` -- :durable is a link that
;; belongs to this machine; :ephemeral is a link that belongs to someone who
;; will leave. The :unknown entry is present on purpose and earns nothing: an
;; interface we cannot classify must not fall through to the same answer as
;; one we examined and admitted.

(defn- interface-class-found? [class :keyword] :bool
  (if (= class :pci-ethernet) true
  (if (= class :usb-ethernet-adapter) true
  (if (= class :usb-cdc-ncm) true
  (if (= class :usb-cdc-ecm) true
  (if (= class :usb-rndis) true
  (if (= class :usb-ipheth) true
  (if (= class :wifi-sta) true
  (if (= class :loopback) true
  (if (= class :unknown) true
  false))))))))))

(defn interface-class [class :keyword] :document
  (if (= class :pci-ethernet)
    (document-map :bootstrap (document-i64 1)
                  :durability (document-keyword :durable)
                  :note (document-string "an ethernet port on this machine"))
  (if (= class :usb-ethernet-adapter)
    (document-map :bootstrap (document-i64 1)
                  :durability (document-keyword :ephemeral)
                  :note (document-string "a USB NIC dongle: a real link, but removable hardware"))
  (if (= class :usb-cdc-ncm)
    (document-map :bootstrap (document-i64 1)
                  :durability (document-keyword :ephemeral)
                  :note (document-string "USB tether, CDC-NCM (Android, and iPhone over USB-C)"))
  (if (= class :usb-cdc-ecm)
    (document-map :bootstrap (document-i64 1)
                  :durability (document-keyword :ephemeral)
                  :note (document-string "USB tether, CDC-ECM"))
  (if (= class :usb-rndis)
    (document-map :bootstrap (document-i64 1)
                  :durability (document-keyword :ephemeral)
                  :note (document-string "USB tether, RNDIS (Android)"))
  (if (= class :usb-ipheth)
    (document-map :bootstrap (document-i64 1)
                  :durability (document-keyword :ephemeral)
                  :note (document-string "USB tether, Apple ipheth; needs a Trust tap on the phone"))
  (if (= class :wifi-sta)
    (document-map :bootstrap (document-i64 0)
                  :durability (document-keyword :durable)
                  :note (document-string "no native Wi-Fi driver yet; R0 does not bootstrap over Wi-Fi"))
  (if (= class :loopback)
    (document-map :bootstrap (document-i64 0)
                  :durability (document-keyword :ephemeral)
                  :note (document-string "never a bootstrap path"))
    (document-map :bootstrap (document-i64 0)
                  :durability (document-keyword :ephemeral)
                  :note (document-string "unclassified: refused rather than guessed")))))))))))

;; The classes that are a phone sharing its connection.

(defn tether-class? [class :keyword] :bool
  (if (= class :usb-cdc-ncm) true
  (if (= class :usb-cdc-ecm) true
  (if (= class :usb-rndis) true
  (if (= class :usb-ipheth) true
  false)))))

;; --- addressing-refusal ------------------------------------------------------
;; An interface can be up and still not be on a network. These are the states
;; that look like success from a distance:
;;   :link-local-only  a 169.254/16 or fe80::/10 address. The interface has an
;;                     address, `ip addr` prints it, and nothing routes.
;;   :none             no address at all.
;;   :static           allowed, but only when the caller says it meant it.
;; Returns the :ok sentinel where the oracle returns nil.

(defn- addressing-refusal [addressing :keyword static-allowed? :bool] :keyword
  (if (= addressing :dhcp) :ok
  (if (= addressing :static)
    (if static-allowed? :ok :static-addressing-not-authorised)
  (if (= addressing :link-local-only) :link-local-only-is-not-a-network
  (if (= addressing :none) :no-address
  (if (= addressing :__absent) :addressing-unknown
  :addressing-unrecognised))))))

;; --- class-rank --------------------------------------------------------------
;; The oracle's (zipmap [...] (range)) table, as a fn. 99 preserves
;; (get class-rank k 99).

(defn- class-rank [class :keyword] :i64
  (if (= class :pci-ethernet) 0
  (if (= class :usb-ethernet-adapter) 1
  (if (= class :usb-cdc-ncm) 2
  (if (= class :usb-cdc-ecm) 3
  (if (= class :usb-rndis) 4
  (if (= class :usb-ipheth) 5
  99)))))))

;; --- bootstrap-decision ------------------------------------------------------
;; May this interface carry first boot? Returns
;; {:ok 1 :class ... :durability ... :tether? ...} or
;; {:ok 0 :reason <keyword>} (with :class where the oracle carries it).
;; Fail-closed: a class this table does not list is :unknown-interface-class,
;; not a pass.

(defn bootstrap-decision [iface :document opts :document] :document
  (let [cls (dkw iface :class)]
    (if (= cls :__absent)
      (document-map :ok (document-i64 0)
                    :reason (document-keyword :no-interface-class))
    (if (interface-class-found? cls)
      (let [spec (interface-class cls)]
        (if (flag spec :bootstrap)
        (if (flag iface :carrier?)
          (let [r (addressing-refusal (dkw iface :addressing) (flag opts :static-allowed?))]
            (if (= r :ok)
              (document-map
                :ok (document-i64 1)
                :class (document-keyword cls)
                :durability (document-keyword (dkw spec :durability))
                :tether? (document-i64 (if (tether-class? cls) 1 0)))
              (document-map
                :ok (document-i64 0)
                :reason (document-keyword r)
                :class (document-keyword cls))))
          (document-map
            :ok (document-i64 0)
            :reason (document-keyword :no-carrier)
            :class (document-keyword cls)))
        (document-map
          :ok (document-i64 0)
          :reason (document-keyword :class-not-admitted-for-bootstrap)
          :class (document-keyword cls))))
      (document-map
        :ok (document-i64 0)
        :reason (document-keyword :unknown-interface-class)
        :class (document-keyword cls))))))

;; --- durable? ----------------------------------------------------------------
;; May this interface be recorded as the machine's own network? Admitting an
;; interface to carry first boot does not answer this, and answering it with
;; the same value is the mistake this namespace exists to prevent.

(defn durable? [iface :document] :bool
  (let [d (bootstrap-decision iface (empty-doc))]
    (if (if (flag d :ok) (= (dkw d :durability) :durable) false) true false)))

;; --- select: ranking ---------------------------------------------------------
;; Order: durable before ephemeral, then the class table's order. The third
;; oracle key (interface name) is dropped -- see header; ties keep probe
;; input order.

(defn- d-rank [e :document] :i64
  (if (= (dkw (dg e :decision) :durability) :durable) 0 1))

(defn- c-rank [e :document] :i64
  (class-rank (dkw e :class)))

(defn- less? [a :document b :document] :bool
  (let [da (d-rank a) db (d-rank b)]
    (if (< da db) true
    (if (< db da) false
    (< (c-rank a) (c-rank b))))))

(defn- insert-tail [ranked :document i :i64 out :document] :document
  (if (>= i (document-count ranked))
    out
    (insert-tail ranked (+ i 1) (document-vector-conj out (elt ranked i)))))

(defn- insert-scan [ranked :document e :document i :i64 out :document] :document
  (if (>= i (document-count ranked))
    (document-vector-conj out e)
    (if (less? e (elt ranked i))
      (insert-tail ranked i (document-vector-conj out e))
      (insert-scan ranked e (+ i 1) (document-vector-conj out (elt ranked i))))))

(defn- rank-all [admitted :document i :i64 ranked :document] :document
  (if (>= i (document-count admitted))
    ranked
    (rank-all admitted (+ i 1)
              (insert-scan ranked (elt admitted i) 0 (document-vector)))))

(defn- judge-all [ifaces :document opts :document i :i64
                  admitted :document refused :document] :document
  (if (>= i (document-count ifaces))
    (document-map :admitted admitted :refused refused)
    (let [iface (elt ifaces i)
          decision (bootstrap-decision iface opts)]
      (if (flag decision :ok)
        (judge-all ifaces opts (+ i 1)
                   (document-vector-conj admitted (document-assoc iface :decision decision))
                   refused)
        (judge-all ifaces opts (+ i 1) admitted
                   (document-vector-conj refused
                     (document-map
                       :name (document-string (ds iface :name))
                       :reason (document-keyword (dkw decision :reason)))))))))

(defn- tail-all [v :document i :i64 out :document] :document
  (if (>= i (document-count v))
    out
    (tail-all v (+ i 1) (document-vector-conj out (elt v i)))))

;; --- select ------------------------------------------------------------------
;; Choose the bootstrap interface from probed candidates. Unlike the install
;; target disk this RANKS rather than refuses when more than one candidate
;; qualifies: writing the wrong disk destroys data, so install-v1 refuses
;; ambiguity; choosing the wrong link is corrected by choosing again.
;; Returns {:ok 1 :chosen {...} :alternatives [...] :refused [...]} or
;; {:ok 0 :reason :no-admissible-interface :refused [...]}.

(defn select [ifaces :document opts :document] :document
  ;; [:error :bad-candidates] covers a non-vector candidate container (the
  ;; reachable trigger) and more than 32 candidates (bounds; kept as defence in
  ;; depth -- the runtime refuses >32-item vectors with
  ;; document-vector-too-large, so no in-guest construction reaches it).
  (if (vector? ifaces)
    (if (> (document-count ifaces) 32)
      (error-doc :bad-candidates)
      (let [j (judge-all ifaces opts 0 (document-vector) (document-vector))
          admitted (dg j :admitted)
          refused (dg j :refused)
          ranked (rank-all admitted 0 (document-vector))]
      (if (= (document-count ranked) 0)
        (document-map
          :ok (document-i64 0)
          :reason (document-keyword :no-admissible-interface)
          :refused refused)
        (document-map
          :ok (document-i64 1)
          :chosen (elt ranked 0)
          :alternatives (tail-all ranked 1 (document-vector))
          :refused refused))))
    (error-doc :bad-candidates)))

;; --- receipt -----------------------------------------------------------------
;; What first boot records about how it got on the network. :durable? is
;; stated on its own line rather than implied by the class, because the
;; operator reading this later is asking exactly one question: is this
;; machine still reachable if the phone leaves? When the answer is no, the
;; receipt says what is still owed.

(defn- names-all [v :document i :i64 out :document] :document
  (if (>= i (document-count v))
    out
    (names-all v (+ i 1)
               (document-vector-conj out (document-string (ds (elt v i) :name))))))

(defn receipt [selection :document] :document
  (let [ok (di-or selection :ok (- 0 1))]
    (if (= ok (- 0 1))
      (error-doc :bad-selection)
    (if (= ok 0)
      (document-map
        :state (document-keyword :refused)
        :reason (document-keyword (dkw selection :reason))
        :refused (dg selection :refused))
      (let [c (dg selection :chosen)
            d (dg c :decision)
            durable (= (dkw d :durability) :durable)
            base (document-map
                   :state (document-keyword :bootstrapped)
                   :interface (document-string (ds c :name))
                   :class (document-keyword (dkw c :class))
                   :tether? (document-i64 (di d :tether?))
                   :durable? (document-i64 (if durable 1 0))
                   :alternatives (names-all (dg selection :alternatives) 0 (document-vector))
                   :refused (dg selection :refused))]
        (if durable
          base
          (document-assoc
            (document-assoc base :owed
              (document-vector
                (document-keyword :durable-network-not-yet-established)
                (document-keyword :phone-may-disconnect-at-any-time)))
            :must-not
            (document-vector
              (document-keyword :record-this-interface-as-the-machine-network)))))))))

;; --- summary -----------------------------------------------------------------
;; One line for the console. Says which of the two questions was answered.

(defn- join-refused [refused :document i :i64 acc :string] :string
  (if (>= i (document-count refused))
    acc
    (let [e (elt refused i)
          piece (string-concat (ds e :name) (string-concat "=" (kw-name (dkw e :reason))))]
      (join-refused refused (+ i 1)
        (if (= i 0) piece (string-concat acc (string-concat ", " piece)))))))

(defn summary [r :document] :string
  (let [st (dkw r :state)]
    (if (= st :refused)
      (let [refused (dg r :refused)
            head (string-concat "no bootstrap interface: " (kw-name (dkw r :reason)))]
        (if (> (document-count refused) 0)
          (string-concat head
            (string-concat " ("
              (string-concat (join-refused refused 0 "") ")")))
          head))
    (if (= st :bootstrapped)
      (string-concat "bootstrapped on "
        (string-concat (ds r :interface)
          (string-concat " ("
            (string-concat (kw-name (dkw r :class))
              (string-concat "); "
                (if (flag r :durable?)
                  "durable"
                  "EPHEMERAL -- this machine has no network of its own yet"))))))
      ":error :bad-receipt"))))

;; --- tests -------------------------------------------------------------------

(defn test-addressing-refusal-ladder [] :bool
  (and (= (addressing-refusal :dhcp false) :ok)
       (= (addressing-refusal :static true) :ok)
       (= (addressing-refusal :static false) :static-addressing-not-authorised)
       (= (addressing-refusal :link-local-only false) :link-local-only-is-not-a-network)
       (= (addressing-refusal :none false) :no-address)
       (= (addressing-refusal :__absent false) :addressing-unknown)
       (= (addressing-refusal :port-knob false) :addressing-unrecognised)))

(defn test-bootstrap-decision-pci [] :bool
  (let [d (bootstrap-decision
            (document-map :class (document-keyword :pci-ethernet)
                          :carrier? (document-i64 1)
                          :addressing (document-keyword :dhcp))
            (empty-doc))]
    (and (= (di d :ok) 1)
         (= (dkw d :durability) :durable)
         (= (di d :tether?) 0)
         (= (dkw d :class) :pci-ethernet))))

(defn test-bootstrap-decision-tether [] :bool
  (let [d (bootstrap-decision
            (document-map :class (document-keyword :usb-rndis)
                          :carrier? (document-i64 1)
                          :addressing (document-keyword :dhcp))
            (empty-doc))]
    (and (= (di d :ok) 1)
         (= (dkw d :durability) :ephemeral)
         (= (di d :tether?) 1))))

(defn test-bootstrap-decision-unknown-class [] :bool
  (let [d1 (bootstrap-decision
             (document-map :class (document-keyword :parallel-port)
                           :carrier? (document-i64 1)
                           :addressing (document-keyword :dhcp))
             (empty-doc))
        d2 (bootstrap-decision
             (document-map :carrier? (document-i64 1)
                           :addressing (document-keyword :dhcp))
             (empty-doc))]
    (and (= (di d1 :ok) 0)
         (= (dkw d1 :reason) :unknown-interface-class)
         (= (di d2 :ok) 0)
         (= (dkw d2 :reason) :no-interface-class))))

(defn test-durable?-ephemeral-false [] :bool
  ;; NB: (= <bool> <bool>) is avoided deliberately -- it emits a Wasm module
  ;; that fails self-validation; bool results are used directly or negated.
  (and (not (durable? (document-map :class (document-keyword :usb-rndis)
                                   :carrier? (document-i64 1)
                                   :addressing (document-keyword :dhcp))))
       (durable? (document-map :class (document-keyword :pci-ethernet)
                               :carrier? (document-i64 1)
                               :addressing (document-keyword :dhcp)))))

(defn test-select-ranking [] :bool
  (let [sel (select
              (document-vector
                (document-map :name (document-string "tether0")
                              :class (document-keyword :usb-rndis)
                              :carrier? (document-i64 1)
                              :addressing (document-keyword :dhcp))
                (document-map :name (document-string "eth0")
                              :class (document-keyword :pci-ethernet)
                              :carrier? (document-i64 1)
                              :addressing (document-keyword :dhcp))
                (document-map :name (document-string "lo")
                              :class (document-keyword :loopback)
                              :carrier? (document-i64 1)
                              :addressing (document-keyword :dhcp)))
              (empty-doc))]
    (and (= (di sel :ok) 1)
         (string=? (ds (dg sel :chosen) :name) "eth0")
         (= (document-count (dg sel :alternatives)) 1)
         (string=? (ds (elt (dg sel :alternatives) 0) :name) "tether0")
         (= (document-count (dg sel :refused)) 1))))

(defn test-receipt-owed [] :bool
  (let [sel (select
              (document-vector
                (document-map :name (document-string "tether0")
                              :class (document-keyword :usb-cdc-ncm)
                              :carrier? (document-i64 1)
                              :addressing (document-keyword :dhcp)))
              (empty-doc))
        r (receipt sel)]
    (and (= (dkw r :state) :bootstrapped)
         (= (di r :durable?) 0)
         (= (document-count (dg r :owed)) 2)
         (= (document-count (dg r :must-not)) 1))))

(defn test-summary-refused [] :bool
  (string=?
    (summary (document-map
               :state (document-keyword :refused)
               :reason (document-keyword :no-carrier)
               :refused (document-vector
                          (document-map :name (document-string "lo")
                                        :reason (document-keyword :class-not-admitted-for-bootstrap)))))
    "no bootstrap interface: no-carrier (lo=class-not-admitted-for-bootstrap)"))

(defn test-summary-bootstrapped [] :bool
  (and
    (string=?
      (summary (document-map
                 :state (document-keyword :bootstrapped)
                 :interface (document-string "eth0")
                 :class (document-keyword :pci-ethernet)
                 :durable? (document-i64 1)))
      "bootstrapped on eth0 (pci-ethernet); durable")
    (string=?
      (summary (document-map
                 :state (document-keyword :bootstrapped)
                 :interface (document-string "tether0")
                 :class (document-keyword :usb-rndis)
                 :durable? (document-i64 0)))
      "bootstrapped on tether0 (usb-rndis); EPHEMERAL -- this machine has no network of its own yet")))

;; --- tests: entry points, fail-closed accessors, error paths, scans -------
;; Direct coverage of the exported entry points (interface-class /
;; tether-class? were previously exercised only indirectly), the [:option
;; ...] fail-closed accessor defaults on missing and mistyped fields, the
;; :error status paths (bad-selection / bad-receipt / bad-candidates), the
;; refused receipt of an all-refused selection, and the multi-entry
;; positional scans. The card's character-level string scanning and
;; mod/quot arithmetic clauses are VACUOUS for this guest: the oracle
;; (src/aiueos/network_bootstrap.cljk) contains zero char/substring/quot/mod
;; forms -- its scans are the positional document-vector loops exercised
;; here (judge-all / rank-all / tail-all / names-all / join-refused), and
;; there is no main: this is a library guest whose entry points are the
;; exported fns and these test-* defs.

(defn test-accessor-fail-closed [] :bool
  (and (and (= (dkw (empty-doc) :state) :__absent)
            (string=? (ds (empty-doc) :name) "")
            (= (di (empty-doc) :ok) 0)
            (= (di-or (empty-doc) :ok 7) 7)
            (not (flag (empty-doc) :carrier?)))
       (and (= (document-count (elt (document-vector) 0)) 0)
            (string=? (ds (document-map :x (document-i64 1)) :x) "")
            (= (di (document-map :x (document-keyword :y)) :x) 0)
            (= (dkw (document-map :x (document-i64 1)) :x) :__absent))))

(defn test-interface-class-table [] :bool
  (and (and (= (di (interface-class :pci-ethernet) :bootstrap) 1)
            (= (dkw (interface-class :pci-ethernet) :durability) :durable)
            (= (di (interface-class :wifi-sta) :bootstrap) 0)
            (= (dkw (interface-class :wifi-sta) :durability) :durable)
            (= (dkw (interface-class :usb-ipheth) :durability) :ephemeral))
       (and (= (di (interface-class :unknown) :bootstrap) 0)
            (= (dkw (interface-class :unknown) :durability) :ephemeral)
            (= (di (interface-class :parallel-port) :bootstrap) 0)
            (= (dkw (interface-class :parallel-port) :durability) :ephemeral)
            (string=? (ds (interface-class :parallel-port) :note)
                      "unclassified: refused rather than guessed"))))

(defn test-tether-class-matrix [] :bool
  (and (and (tether-class? :usb-cdc-ncm)
            (tether-class? :usb-cdc-ecm)
            (tether-class? :usb-rndis)
            (tether-class? :usb-ipheth))
       (and (not (tether-class? :pci-ethernet))
            (not (tether-class? :wifi-sta))
            (not (tether-class? :unknown))
            (not (tether-class? :parallel-port)))))

(defn test-error-paths [] :bool
  (and (and (= (dkw (receipt (empty-doc)) :error) :bad-selection)
            (string=? (summary (empty-doc)) ":error :bad-receipt")
            (string=? (summary (document-map :state (document-keyword :halted)))
                      ":error :bad-receipt")
            ;; :bad-candidates via its reachable trigger, a non-vector
            ;; candidate container (the >32 bounds branch is untestable in
            ;; guest: >32-item vectors trap document-vector-too-large).
            (= (dkw (select (document-map :x (document-i64 1)) (empty-doc))
                    :error)
               :bad-candidates)
            (= (dkw (select (document-i64 7) (empty-doc)) :error)
               :bad-candidates))
       (let [r (receipt
                 (select (document-vector
                           (document-map :name (document-string "lo")
                                         :class (document-keyword :loopback)
                                         :carrier? (document-i64 1)
                                         :addressing (document-keyword :dhcp)))
                         (empty-doc)))]
         (and (= (dkw r :state) :refused)
              (= (dkw r :reason) :no-admissible-interface)))))

(defn test-summary-join-two [] :bool
  (and (string=?
         (summary (document-map
                    :state (document-keyword :refused)
                    :reason (document-keyword :no-admissible-interface)
                    :refused (document-vector
                               (document-map :name (document-string "lo")
                                             :reason (document-keyword :class-not-admitted-for-bootstrap))
                               (document-map :name (document-string "eth1")
                                             :reason (document-keyword :no-carrier)))))
         "no bootstrap interface: no-admissible-interface (lo=class-not-admitted-for-bootstrap, eth1=no-carrier)")
       (string=?
         (summary (document-map
                    :state (document-keyword :refused)
                    :reason (document-keyword :no-admissible-interface)
                    :refused (document-vector
                               (document-map :name (document-string "eth1")
                                             :reason (document-keyword :no-carrier))
                               (document-map :name (document-string "lo")
                                             :reason (document-keyword :class-not-admitted-for-bootstrap)))))
         "no bootstrap interface: no-admissible-interface (eth1=no-carrier, lo=class-not-admitted-for-bootstrap)")))
