;; aiueos.bare-metal -- P2 boot classification as a pure Kotoba guest
;; (oracle: src/aiueos/bare_metal.cljk).
;;
;; p2-result classifies a bare-metal boot. The oracle's cond is three
;; booleans and a keyword answer -- exactly the arithmetic-and-keywords
;; shape. The serial regexes (AIUEOS_HTTP_PROBE / AIUEOS_CERTVERIFY_PROBE
;; line matching) stay in the host, which hands the guest the outcome as
;; booleans: a serial log cannot be a bounded guest value.
;;
;; host-fetched? is for tests -- the command never sets it. If it is true
;; and the guest serial has no HTTP+CID, the reason is
;; :host-fetch-does-not-count even if leftover would have been something
;; else: that is the discrimination this gate exists to keep.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile aiueos/bare_metal.kotoba --target wasm32-browser --output bare_metal.wasm

(ns aiueos.bare-metal
  (:export [p2-result]))

(defn p2-result
  [qemu-unmeasured? :bool host-fetched? :bool guest-http? :i64] :document
  (if qemu-unmeasured?
    (document-map
     :green (document-keyword :no)
     :exit (document-i64 3)
     :reason (document-keyword :unmeasured))
    (if (if host-fetched? (= guest-http? 0) false)
      (document-map
       :green (document-keyword :no)
       :exit (document-i64 1)
       :reason (document-keyword :host-fetch-does-not-count))
      (if (= guest-http? 1)
        (document-map
         :green (document-keyword :yes)
         :exit (document-i64 0)
         :reason (document-keyword :guest-http))
        (document-map
         :green (document-keyword :no)
         :exit (document-i64 1)
         :reason (document-keyword :http-absent))))))
