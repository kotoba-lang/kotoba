;; aiueos.virtio -- virtio protocol decision arithmetic as a pure Kotoba guest
;; (oracle: src/aiueos/virtio.cljk).
;;
;; The oracle is the ~85% of the retired Rust module that was already pure;
;; the guest carries the decision arithmetic at the protocol's heart:
;;
;;   interrupt-status decoding   which bits are used-ring /
;;                               config-change / unknown, by bit-and --
;;                               the bit ops the wasm backend admits
;;   device-type mapping         virtio mmio device id -> device type code
;;   irq-line validation         a line number of zero is refused
;;
;; The MMIO register table, the regs seam and the queue/descriptor state
;; machines stay in the oracle: :container-items 32 cannot hold a descriptor
;; chain, and raw MMIO access is the VFIO seam -- mechanism by the oracle's
;; own statement.
;;
;; bit-not has no admitted lowering (measured); unknown-bits is spelled as
;; an equality on the two known bits' mask.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile aiueos/virtio.kotoba --target wasm32-browser --output virtio.wasm

(ns aiueos.virtio
  (:export [interrupt-status-none? interrupt-status-used-ring?
            interrupt-status-config-change? interrupt-status-unknown?
            device-type-from-id irq-line-valid?]))

(def used-ring-bit 1)
(def config-change-bit 2)
(def known-bits 3)

;; --- interrupt status --------------------------------------------------------

(defn interrupt-status-none? [bits :i64] :bool
  (= bits 0))

(defn interrupt-status-used-ring? [bits :i64] :bool
  (if (= (bit-and bits used-ring-bit) 0) false true))

(defn interrupt-status-config-change? [bits :i64] :bool
  (if (= (bit-and bits config-change-bit) 0) false true))

;; The oracle's bit-not form: (bit-and bits (bit-not 3)). Without bit-not
;; (measured), unknown means neither known bit is the whole story -- the
;; answer is (not= (bit-and bits known-bits) bits).
(defn interrupt-status-unknown? [bits :i64] :bool
  (if (= (bit-and bits known-bits) bits) false true))

;; --- device type -------------------------------------------------------------
;; virtio mmio device ids: 1 network, 2 block, 3 console, 16 gpu, 18 input.
;; Returns the oracle's device-type as an i64 code (0 network, 1 block,
;; 2 console, 3 gpu, 4 input) or 99 unknown.

(defn device-type-from-id [id :i64] :i64
  (if (= id 1) 0
      (if (= id 2) 1
          (if (= id 3) 2
              (if (= id 16) 3
                  (if (= id 18) 4
                      99))))))

;; --- irq line ----------------------------------------------------------------

(defn irq-line-valid? [line :i64] :bool
  (if (= line 0) false true))
