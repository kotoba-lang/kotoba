;; aiueos.pid1 -- argv0 boot-condition check as a pure Kotoba guest
;; (oracle: src/aiueos/pid1.cljk).
;;
;; pid1-argv0? is the kernel's rdinit=/init contract: argv0's basename is
;; exactly "init". The oracle splits on a regex; the guest scans positionally
;; -- the last path segment after the final '/' (or the whole string when
;; there is none) compared with string=?. Pure by the oracle's own design:
;; the caller supplies the string, nothing touches /proc.
;;
;; The anchor loading, signal handling and reboot(2) syscall stay in the
;; host -- file I/O and FFM are mechanism.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile aiueos/pid1.kotoba --target wasm32-browser --output pid1.wasm

(ns aiueos.pid1
  (:export [pid1-argv0?]))

(defn- char-at [s :string i :i64] :string
  (string-substring s i (+ i 1)))

;; find the last '/': scan forward, keep the latest index (or -1).
(defn- last-slash [s :string n :i64 i :i64 best :i64] :i64
  (if (>= i n)
    best
    (last-slash s n (+ i 1)
                (if (string=? (char-at s i) "/") i best))))

(defn- tail-eq-init [s :string start :i64] :bool
  ;; the substring from start must be exactly "init"
  (if (string=? (string-substring s start (string-length s)) "init")
    true
    false))

(defn pid1-argv0? [argv0 :string] :bool
  (let [n (string-length argv0)
        slash (last-slash argv0 n 0 (- 0 1))]
    (if (< slash 0)
      (tail-eq-init argv0 0)
      (if (>= (+ slash 1) n)
        false
        (tail-eq-init argv0 (+ slash 1))))))
