;; aiueos.vm -- boot-plan validation as a pure Kotoba guest
;; (oracle: src/aiueos/vm.cljk).
;;
;; The oracle's plan validates and defaults every QEMU flag before the JVM
;; caller turns it into an argv. The validation DECISIONS are product
;; semantics and become the guest:
;;
;;   unknown architecture / unknown graphics / unknown console
;;   :display requires :graphics "virtio-gpu"
;;
;; The argv building itself is string plumbing over host paths -- mechanism
;; -- and stays in the oracle, as does the process spawn. Flags arrive as
;; i64 codes (0 none, 1 virtio-gpu, 2 pl011, 3 virtio-console, 4 aarch64,
;; 5 x86_64); the guest answers 0 = valid or the fault keyword.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile aiueos/vm.kotoba --target wasm32-browser --output vm.wasm

(ns aiueos.vm
  (:export [plan-errors]))

(defn- plan-errors-loop
  [arch :i64 graphics :i64 console :i64 display :i64 errs :document] :document
  (let [e1 (if (if (= arch 4) true (= arch 5))
             errs
             (document-vector-conj errs (document-keyword :unknown-architecture)))
        e2 (if (if (= graphics 0) true (= graphics 1))
             e1
             (document-vector-conj e1 (document-keyword :unknown-graphics)))
        e3 (if (if (= console 2) true (= console 3))
             e2
             (document-vector-conj e2 (document-keyword :unknown-console)))
        e4 (if (if (= graphics 0) (= display 0) true)
             e3
             (document-vector-conj e3 (document-keyword :display-requires-graphics)))]
    e4))

(defn plan-errors
  [arch :i64 graphics :i64 console :i64 display :i64] :document
  (plan-errors-loop arch graphics console display (document-vector)))
