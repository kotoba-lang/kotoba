;; aiueos.model-channel -- continuity + boot decision as a pure Kotoba guest
;; (oracle: src/aiueos/model_channel.cljk).
;;
;; The oracle decides whether a verified IPNS head may replace the locally
;; committed model; network and disk drivers are ports. This guest owns the
;; two decisions that are arithmetic and keywords, not bytes:
;;
;;   continuity-errors  the sequence history rules -- :rollback,
;;                      :sequence-equivocation, :broken-history,
;;                      :unexpected-genesis-parent
;;   boot-decision      an update plan is not proof of activation; a caller
;;                      sets :activation-committed? only after the separate
;;                      device-side transaction
;;
;; The CID regexes and the manifest shape checks stay in the host -- the
;; guest receives CID EQUALITY as booleans (cid-eq?/previous-eq?/has-prev?),
;; because a CID string cannot be a bounded guest value and a pattern that
;; can match the wire shape can match a great deal else.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile aiueos/model_channel.kotoba --target wasm32-browser --output model_channel.wasm

(ns aiueos.model-channel
  (:export [continuity-errors boot-decision]))

;; --- continuity-errors -------------------------------------------------------
;; Inputs: head-sequence, last-sequence (0 = none), cid-eq? (head cid ==
;; state last cid), previous-eq? (manifest previous == state last cid),
;; has-prev? (manifest carries a previous cid), has-last-cid? (state
;; carries a committed cid).

(defn- push-error [errs :document kw :keyword] :document
  (document-vector-conj errs (document-keyword kw)))

;; flags: 0 has-last-cid?, 1 cid-eq?, 2 previous-eq?, 3 has-prev?
;; (1 = true, 0 = false). max-parameters is 5 (measured), so the four
;; booleans travel as one i64 flags vector beside the two sequences.

(defn- flag [flags :document i :i64] :bool
  (= (option-value-of [:option :i64]
       (document-i64-value (option-value-of [:option :document] (document-vector-at flags i) (document-i64 0)))
       0)
     1))

(defn continuity-errors
  [head-sequence :i64 last-sequence :i64 flags :document] :document
  (let [errs (document-vector)
        e1 (if (< head-sequence last-sequence)
             (push-error errs :rollback) errs)
        e2 (if (if (if (= head-sequence last-sequence) (flag flags 0) false)
               (if (flag flags 1) false true)
               false)
             (push-error e1 :sequence-equivocation) e1)
        e3 (if (if (if (> head-sequence last-sequence) (flag flags 0) false)
               (if (flag flags 2) false true)
               false)
             (push-error e2 :broken-history) e2)
        e4 (if (if (= last-sequence 0) (flag flags 3) false)
             (push-error e3 :unexpected-genesis-parent) e3)]
    e4))

;; --- boot-decision -----------------------------------------------------------
;; Inputs: plan-current? (update-plan status is :current),
;; plan-activated? (activation-committed?), has-plan? (a plan exists),
;; has-state-artifact? (committed model present locally).

(defn boot-decision
  [has-plan? :bool plan-current? :bool plan-activated? :bool
   has-state-artifact? :bool] :document
  (if (if has-plan? (if plan-current? true plan-activated?) false)
    (document-map
     :boot (document-keyword :admitted-channel)
     :status (document-keyword :current))
    (if has-state-artifact?
      (document-map
       :boot (document-keyword :last-known-good)
       :status (document-keyword :offline-or-refused))
      (document-map
       :boot (document-keyword :without-model)
       :status (document-keyword :no-admitted-model)))))
