;; aiueos.device-auth -- proof-problem decision chain as a pure Kotoba guest
;; (oracle: src/aiueos/device_auth.cljk).
;;
;; The oracle's docstring states the guest's shape: a pure ceremony, never
;; trusting a browser-supplied verified=true, never handling a private
;; passkey. The guest owns the decision chain the verifier's result must
;; pass -- every refusal reason, in the oracle's order and vocabulary:
;;
;;   :challenge/not-issued :challenge/already-consumed :challenge/expired
;;   :challenge/mismatch :method/unsupported :authority/not-verified
;;   :passkey/user-not-present :passkey/user-not-verified
;;   :passkey/rp-id-mismatch :passkey/origin-mismatch
;;   :passkey/clone-signal :phone/passkey-required :phone/not-approved
;;   :phone/device-identity-required :account/did-required
;;   :account/principal-id-required
;;
;; Every arm of the oracle's cond is equality, keyword membership or a
;; boolean flag -- arithmetic and keywords. State arrives pre-extracted;
;; strings ride as equality booleans (a challenge string cannot be a
;; bounded guest value). The chain is a LINEAR SCAN over numbered checks,
;; each a small (state, flags, method) function -- no deep nesting, so a
;; reader can diff the order against the oracle line by line.
;;
;; The cryptographic verification is the injected authority port --
;; mechanism -- and stays in the host. The guest never sees a signature.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile aiueos/device_auth.kotoba --target wasm32-browser --output device_auth.wasm

(ns aiueos.device-auth
  (:export [proof-problem]))

(defn- at [v :document i :i64] :i64
  (option-value-of [:option :i64]
    (document-i64-value (option-value-of [:option :document] (document-vector-at v i) (document-i64 0)))
    0))

(defn- f1 [flags :document i :i64] :bool
  (= (at flags i) 1))

;; problem codes, in the oracle's cond order (0 = clean, continue):
(defn- kw [c :i64] :keyword
  (if (= c 1) :challenge/not-issued
    (if (= c 2) :challenge/already-consumed
    (if (= c 3) :challenge/expired
    (if (= c 4) :challenge/mismatch
    (if (= c 5) :method/unsupported
    (if (= c 6) :authority/not-verified
    (if (= c 7) :passkey/user-not-present
    (if (= c 8) :passkey/user-not-verified
    (if (= c 9) :passkey/rp-id-mismatch
    (if (= c 10) :passkey/origin-mismatch
    (if (= c 11) :passkey/clone-signal
    (if (= c 12) :phone/passkey-required
    (if (= c 13) :phone/not-approved
    (if (= c 14) :phone/device-identity-required
    (if (= c 15) :account/did-required
      :account/principal-id-required))))))))))))))))

;; check-1: state and time arms.
(defn- check-1 [state-issued? :bool now-ms :i64 expires-at-ms :i64 flags :document] :i64
  (if (if state-issued? false true) 1
    (if (f1 flags 0) 2
      (if (>= now-ms expires-at-ms) 3
        (if (= (at flags 1) 0) 4 0)))))

;; check-2: method membership (0 passkey, 1 phone-scan, else unsupported).
(defn- check-2 [method :i64] :i64
  (if (= method 0) 0
    (if (= method 1) 0 5)))

(defn- check-3 [flags :document] :i64
  (if (= (at flags 2) 0) 6 0))

(defn- check-4 [flags :document] :i64
  (if (= (at flags 3) 0) 7 0))

(defn- check-5 [flags :document] :i64
  (if (= (at flags 4) 0) 8 0))

(defn- check-6 [flags :document] :i64
  (if (= (at flags 5) 0) 9 0))

(defn- check-7 [flags :document] :i64
  (if (= (at flags 6) 0) 10 0))

;; check-8: the method-specific arms -- passkey clone signal, then the
;; phone chain (passkey-verified / approved / device identity).
(defn- check-8 [method :i64 flags :document] :i64
  (if (= method 0)
    (if (= (at flags 7) 0) 11 0)
    (if (= method 1)
      (if (= (at flags 8) 0) 12
        (if (= (at flags 9) 0) 13
          (if (= (at flags 10) 0) 14 0)))
      0)))

(defn- check-9 [flags :document] :i64
  (if (= (at flags 11) 0) 15 0))

(defn- check-10 [flags :document] :i64
  (if (= (at flags 12) 0) 16 0))

(defn- scan [state-issued? :bool now-ms :i64 expires-at-ms :i64 method :i64 flags :document] :i64
  (let [c1 (check-1 state-issued? now-ms expires-at-ms flags)]
    (if (> c1 0) c1
      (let [c2 (check-2 method)]
        (if (> c2 0) c2
          (let [c3 (check-3 flags)]
            (if (> c3 0) c3
              (let [c4 (check-4 flags)]
                (if (> c4 0) c4
                  (let [c5 (check-5 flags)]
                    (if (> c5 0) c5
                      (let [c6 (check-6 flags)]
                        (if (> c6 0) c6
                          (let [c7 (check-7 flags)]
                            (if (> c7 0) c7
                              (let [c8 (check-8 method flags)]
                                (if (> c8 0) c8
                                  (let [c9 (check-9 flags)]
                                    (if (> c9 0) c9
                                      (check-10 flags))))))))))))))))))))

(defn proof-problem
  [state-issued? :bool now-ms :i64 expires-at-ms :i64
   method :i64 flags :document] :keyword
  (kw (scan state-issued? now-ms expires-at-ms method flags)))
