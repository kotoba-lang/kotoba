;; aiueos.image -- boot-input validation decisions as a pure Kotoba guest
;; (oracle: src/aiueos/image.cljk).
;;
;; validate-boot-inputs! fails before packaging an initramfs which cannot
;; execute /init. The DECISION -- which missing or malformed input is a
;; refusal and with what name -- is the guest's; the file existence and ELF
;; magic checks themselves are filesystem mechanism and stay in the oracle,
;; which hands over presence booleans:
;;
;;   inputs: 0 system, 1 jre-dir, 2 jar, 3 runtime-root (1 = present)
;;   java-exec-ok?  the staged JRE has an executable bin/java
;;   java-elf-ok?   that bin/java is a Linux ELF executable
;;   jar-regular?   the aiueos jar is a regular file
;;
;; Compile (single file, JVM-free):
;;   kotoba compile aiueos/image.kotoba --target wasm32-browser --output image.wasm

(ns aiueos.image
  (:export [boot-input-errors]))

(defn- at [v :document i :i64] :i64
  (option-value-of [:option :i64]
    (document-i64-value (option-value-of [:option :document] (document-vector-at v i) (document-i64 0)))
    0))

(defn- push-err [errs :document kw :keyword] :document
  (document-vector-conj errs (document-keyword kw)))

(defn- missing-kw [i :i64] :keyword
  (if (= i 0) :missing-system
      (if (= i 1) :missing-jre-dir
          :missing-jar)))

(defn- input-errors [inputs :document i :i64 errs :document] :document
  (if (> i 2)
    errs
    (input-errors inputs (+ i 1)
                  (if (= (at inputs i) 1)
                    errs
                    (push-err errs (missing-kw i))))))

(defn boot-input-errors
  [inputs :document java-exec-ok? :i64 java-elf-ok? :i64
   jar-regular? :i64 runtime-root-dir? :i64] :document
  (let [e1 (input-errors inputs 0 (document-vector))
        e2 (if (= java-exec-ok? 1) e1 (push-err e1 :jre-no-executable-java))
        e3 (if (= java-elf-ok? 1) e2 (push-err e2 :jre-java-not-elf))
        e4 (if (= runtime-root-dir? 1) e3 (push-err e3 :runtime-root-required))
        e5 (if (= jar-regular? 1) e4 (push-err e4 :jar-not-regular-file))]
    e5))
