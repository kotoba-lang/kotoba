(ns aiueos.office-sha64-qemu-test
  (:export [main])
  (:require [aiueos.sha256 :as sha]
            [aiueos.sha256-64k :as sha64]))

;; The fixture uses only a fresh kernel-owned pool; no disk or key is read.
(defn fill [input :i64 i :i64] :i64
  (if (= i 65536) 1
    (let [w (kernel-store-u8-64k input 65536 i (bit-and (+ (* i 17) 123) 255))]
      (fill input (+ i 1)))))
(defn length-at [i :i64] :i64
  (case i 0 0 1 1 2 55 3 56 4 63 5 64 6 65 7 1024 8 12288 9 35000 10 65536 0))
(defn run [input :i64 receipt :i64 work :i64 i :i64] :i64
  (if (= i 11) 1
    (let [n (length-at i) output (kernel-subregion receipt 4096 (+ 64 (* i 32)) 32)
          ok (sha64/aiueos-sha256-64k input n output 32 work 4096)]
      (if (= ok 1) (run input receipt work (+ i 1)) 0))))
(defn words-equal [a :i64 b :i64 at :i64] :bool
  (if (= at 32) true
    (and (= (kernel-load-u32-4k a 32 at) (kernel-load-u32-4k b 32 at))
         (words-equal a b (+ at 4)))))
(defn main [] :i64
  (let [off (kernel-cli) pool (kernel-application-pool)
        input (kernel-subregion pool 8388608 0 65536)
        receipt (kernel-owned-page 0) work (kernel-owned-page 1)
        old-output (kernel-subregion receipt 4096 448 32)
        expected (kernel-subregion receipt 4096 320 32)
        invalid (kernel-subregion receipt 4096 512 32)
        init (fill input 0)
        marker (kernel-store-u32-4k invalid 32 0 0x5a1bc2d3)
        output31 (kernel-subregion invalid 32 0 31)
        work351 (kernel-subregion work 4096 0 351)
        input-output (kernel-subregion input 65536 0 32)
        input-work (kernel-subregion input 65536 128 352)
        work-output (kernel-subregion work 4096 0 32)
        too-long (sha64/aiueos-sha256-64k input 65537 invalid 32 work 4096)
        negative (sha64/aiueos-sha256-64k input -1 invalid 32 work 4096)
        short-out (sha64/aiueos-sha256-64k input 64 output31 31 work 4096)
        short-work (sha64/aiueos-sha256-64k input 64 invalid 32 work351 351)
        alias-io (sha64/aiueos-sha256-64k input 64 input-output 32 work 4096)
        alias-iw (sha64/aiueos-sha256-64k input 64 invalid 32 input-work 352)
        alias-ow (sha64/aiueos-sha256-64k input 64 work-output 32 work 4096)
        invalid-ok (and (= too-long 0) (= negative 0) (= short-out 0) (= short-work 0)
                        (= alias-io 0) (= alias-iw 0) (= alias-ow 0)
                        (= (kernel-load-u32-4k invalid 32 0) 0x5a1bc2d3))
        cases (run input receipt work 0)
        old-input (kernel-subregion input 65536 0 12288)
        old (sha/aiueos-sha256 old-input 12288 old-output work 4096)
        same (words-equal old-output expected 0)
        a (kernel-store-u64-4k receipt 4096 8 (if (= cases 1) 1 0))
        b (kernel-store-u64-4k receipt 4096 16 (if invalid-ok 1 0))
        c (kernel-store-u64-4k receipt 4096 24 (if (and (= old 1) same) 1 0))
        done (kernel-store-u64-4k receipt 4096 0 0x315445474944464f)]
    (loop [spin 0] (let [pause (kernel-pause)] (recur (+ spin 1))))))
