(def ^:private screen-lock-ok
  "AIUEOS_GUEST_BROWSER_SCREEN_LOCK_OK events=30 locked=1 swallowed=press,key wrong-pin=refused right-pin=unlocked session=restored\r\n")

(deftest guest-browser-screen-lock-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok
                  (apply str (map max-line shape-rows)) shape-ok
                  (apply str (map max-line press-rows)) press-lines pressed-ok)
        mn (apply str (map min-line min-rows))
        pre (str base mn min-reg-lines minimize-ok)
        lines (apply str (map lock-line lock-rows))
        states (apply str (map lock-state-line lock-state-rows))
        ok (str pre lines states screen-lock-ok)]
    (testing "locked, swallowed, refused, unlocked, session restored: green"
      (let [r (guest/classify "guest-browser-screen-lock" {:serial ok})]
        (is (= :guest-browser-screen-lock (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "the minimize gate still reads its own lines with the lock lines present"
      (is (= :guest-browser-minimize (:reason (guest/classify "guest-browser-minimize" {:serial ok})))))
    (testing "a window drawn while locked is red"
      (let [bad (.replace states "n=70 locked=1 bars=0" "n=70 locked=1 bars=3")]
        (is (not (:green? (guest/classify "guest-browser-screen-lock" {:serial (str pre lines bad screen-lock-ok)}))))))
    (testing "a wrong PIN that unlocks is red"
      (let [bad (.replace states "n=79 locked=1 bars=0 dots=0 denied=1" "n=79 locked=0 bars=0 dots=0 denied=0")]
        (is (not (:green? (guest/classify "guest-browser-screen-lock" {:serial (str pre lines bad screen-lock-ok)}))))))
    (testing "a right PIN that does not unlock is red"
      (let [bad (.replace states "n=89 locked=0" "n=89 locked=1")]
        (is (not (:green? (guest/classify "guest-browser-screen-lock" {:serial (str pre lines bad screen-lock-ok)}))))))
    (testing "a pointer press that changed the session while locked is red, and says which frame"
      (let [bad (.replace lines "n=67 src=1 at=456,146 reduce=0 windows=3 focus=4 stack=314" "n=67 src=1 at=456,146 reduce=0 windows=3 focus=1 stack=341")
            r (guest/classify "guest-browser-screen-lock" {:serial (str pre bad states screen-lock-ok)})]
        (is (= :screen-lock-differs-from-model (:reason r)))
        (is (= 67 (:n (:kernel (:first-difference r)))))))
    (testing "it needs the minimize gate green first"
      (is (= :no-minimize (:reason (guest/classify "guest-browser-screen-lock" {:serial (str lines states screen-lock-ok)})))))
    (testing "the OK line missing is not green, no lines is absent, unmeasured is exit 3"
      (is (= :screen-lock-ok-missing (:reason (guest/classify "guest-browser-screen-lock" {:serial (str pre lines states)}))))
      (is (= :guest-browser-screen-lock-absent (:reason (guest/classify "guest-browser-screen-lock" {:serial (str pre screen-lock-ok)}))))
      (is (= 3 (:exit (guest/classify "guest-browser-screen-lock" {:serial ok :qemu-unmeasured? true})))))))

