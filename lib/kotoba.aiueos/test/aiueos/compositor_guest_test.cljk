(def ^:private selection-ok
  "AIUEOS_GUEST_BROWSER_SELECTION_OK events=17 answers=44444000000000000 max-sel=2 body=48 focus=4 scroll=100 chain=2b46197d sel-chain=cb830579 ops=217 text-px=1058 hash=6ca5ee4a\r\n")

(deftest guest-browser-selection-classifier
  (testing "seventeen frames, the selection up to 2 and deleted, the model's censuses: green"
    (let [r (guest/classify "guest-browser-selection"
                            {:serial (str cursor-ok-line focus-ok scroll-lines scroll-ok selection-lines selection-ok)})]
      (is (= :guest-browser-selection (:reason r)))
      (is (= 0 (:exit r)))
      (is (= [:caret-only-at-the-end :one-selection-at-a-time :no-arrows-in-a-composition
              :shift-does-not-case-letters :opaque-highlight]
             (:leftover r)))))
  (testing "the selection needs the wheel stage first"
    (is (= :no-scroll
           (:reason (guest/classify "guest-browser-selection"
                                    {:serial (str cursor-ok-line focus-ok selection-lines selection-ok)})))))
  (testing "an OK line with a frame line missing is not green"
    (is (= :selection-lines-missing
           (:reason (guest/classify "guest-browser-selection"
                                    {:serial (str cursor-ok-line focus-ok scroll-lines scroll-ok
                                                  (.replace selection-lines "FRAME n=17 " "FRAME n=71 ")
                                                  selection-ok)})))))
  (testing "an OK line without the GO line is not green"
    (is (= :selection-lines-missing
           (:reason (guest/classify "guest-browser-selection"
                                    {:serial (str cursor-ok-line focus-ok scroll-lines scroll-ok
                                                  (.replace selection-lines "SELECTION_GO" "SELECTION_G0")
                                                  selection-ok)})))))
  (testing "a census that misses is red, by name"
    (is (= :census-miss
           (:reason (guest/classify "guest-browser-selection"
                                    {:serial (str cursor-ok-line focus-ok scroll-lines scroll-ok selection-lines
                                                  "AIUEOS_GUEST_BROWSER_SELECTION leftover=census-miss off=3 chain=00000000 sel-chain=00000000 sel=0 shift=0\r\n")})))))
  (testing "missing events are red, by name"
    (is (= :events-missing
           (:reason (guest/classify "guest-browser-selection"
                                    {:serial (str cursor-ok-line focus-ok scroll-lines scroll-ok
                                                  "AIUEOS_GUEST_BROWSER_SELECTION leftover=events-missing events=5 frames=5\r\n")})))))
  (testing "the wheel's OK line alone is not the selection"
    (is (= :guest-browser-selection-absent
           (:reason (guest/classify "guest-browser-selection"
                                    {:serial (str cursor-ok-line focus-ok scroll-lines scroll-ok)})))))
  (testing "unanswered QEMU is exit 3"
    (is (= 3 (:exit (guest/classify "guest-browser-selection" {:qemu-unmeasured? true})))))
  (testing "tablet profile, with the wheel's wall clock and more"
    (is (= {"AIUEOS_GUEST_BROWSER" "1" "AIUEOS_QEMU_TIMEOUT" "2700"} (guest/extra-env "guest-browser-selection")))))

