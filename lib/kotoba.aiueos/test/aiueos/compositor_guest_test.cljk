(defn- edit-line [[n key text caret sel ops px h]]
  (str "AIUEOS_GUEST_BROWSER_EDIT n=" n " key=" key " text=" text " caret=" caret " sel=" sel
       " ops=" ops " text-px=" px " hash=" h "\r\n"))

(deftest guest-browser-text-edit-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok
                  (apply str (map max-line shape-rows)) shape-ok
                  (apply str (map max-line press-rows)) press-lines pressed-ok)
        mn (apply str (map min-line min-rows))
        pre (str base mn min-reg-lines minimize-ok)
        lines (apply str (map lock-line lock-rows))
        states (apply str (map lock-state-line lock-state-rows))
        lock-part (str pre lines states screen-lock-ok)
        so (apply str (map so-line so-rows))
        so-states (apply str (map lock-state-line so-lock-rows))
        through-sign-out (str lock-part so so-states (so-state-lines 0) sign-out-ok)
        rg (apply str (map ring-line ring-rows))
        through-ring (str through-sign-out rg "AIUEOS_GUEST_BROWSER_RING_OK events=28\r\n")
        ed (apply str (map edit-line edit-rows))
        edit-ok "AIUEOS_GUEST_BROWSER_EDIT_OK events=72\r\n"
        ok (str through-ring ed edit-ok)
        run (fn [serial] (guest/classify "guest-browser-text-edit" {:serial serial}))]
    (testing "typed, moved by word and line, inserted, selected, deleted, undone: green"
      (let [r (run ok)]
        (is (= :guest-browser-text-edit (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "a Ctrl+Right that stops at the wrong place is red, and says which frame"
      (let [r (run (.replace ok "n=18 key=425 text=ab_cd caret=5" "n=18 key=425 text=ab_cd caret=3"))]
        (is (= :text-edit-differs-from-model (:reason r)))
        (is (= 18 (:n (:kernel (:first-difference r)))))))
    (testing "an undo that restores nothing is red"
      (is (= :text-edit-differs-from-model
             (:reason (run (.replace ok "n=44 key=177 text=ab_cd caret=4" "n=44 key=177 text=abd caret=2"))))))
    (testing "a selection that is not the one asked for is red"
      (is (= :text-edit-differs-from-model
             (:reason (run (.replace ok "sel=2,4" "sel=2,3"))))))
    (testing "it needs the keyboard-only gate green first"
      (is (= :no-keyboard-only (:reason (run (str ed edit-ok))))))
    (testing "the OK line missing is not green, no lines is absent, unmeasured is exit 3"
      (is (= :text-edit-ok-missing (:reason (run (str through-ring ed)))))
      (is (= :guest-browser-text-edit-absent (:reason (run (str through-ring edit-ok)))))
      (is (= 3 (:exit (guest/classify "guest-browser-text-edit" {:serial ok :qemu-unmeasured? true})))))))

(deftest guest-browser-clock-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok
                  (apply str (map max-line shape-rows)) shape-ok
                  (apply str (map max-line press-rows)) press-lines pressed-ok)
        mn (apply str (map min-line min-rows))
        pre (str base mn min-reg-lines minimize-ok)
        lines (apply str (map lock-line lock-rows))
        states (apply str (map lock-state-line lock-state-rows))
        lock-part (str pre lines states screen-lock-ok)
        so (apply str (map so-line so-rows))
        so-states (apply str (map lock-state-line so-lock-rows))
        through-sign-out (str lock-part so so-states (so-state-lines 0) sign-out-ok)
        rg (apply str (map ring-line ring-rows))
        through-ring (str through-sign-out rg "AIUEOS_GUEST_BROWSER_RING_OK events=28\r\n")
        ed (apply str (map edit-line edit-rows))
        through-edit (str through-ring ed "AIUEOS_GUEST_BROWSER_EDIT_OK events=72\r\n")
        clock (str "AIUEOS_GUEST_BROWSER_CLOCK_RTC set=12:34 read=12:34\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK n=1 status=0 net=0 ops=77 text-px=668 hash=bed963dd\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK n=2 status=755 net=0 ops=82 text-px=755 hash=9eb22e19\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK n=3 status=755 net=3 ops=88 text-px=892 hash=c9fc0d1c\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK_OK frames=3\r\n")
        ok (str through-edit clock)
        run (fn [serial] (guest/classify "guest-browser-clock" {:serial serial}))]
    (testing "set, read back, drawn as five glyphs: green"
      (let [r (run ok)]
        (is (= :guest-browser-clock (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "a clock that reads back differently is red"
      (is (= :clock-did-not-read-back (:reason (run (.replace ok "read=12:34" "read=12:35"))))))
    (testing "a clock frame that is not the model's is red"
      (is (= :clock-differs-from-model (:reason (run (.replace ok "n=2 status=755 net=0 ops=82" "n=2 status=755 net=0 ops=81"))))))
    (testing "an attached NIC that is not online is red, offline frames still compare to the model"
      (is (= :nic-attached-but-not-online
             (:reason (run (.replace (.replace (.replace ok "net=3 ops=88" "net=1 ops=89") "text-px=892" "text-px=902") "c9fc0d1c" "cb8b3900")))))
      (is (= :clock-differs-from-model
             (:reason (run (.replace ok "net=3 ops=88" "net=2 ops=88"))))))
    (testing "it needs the text-edit gate green first"
      (is (= :no-text-edit (:reason (run clock)))))
    (testing "the OK line missing is not green, no lines is absent, unmeasured is exit 3"
      (is (= :clock-ok-missing (:reason (run (.replace ok "AIUEOS_GUEST_BROWSER_CLOCK_OK frames=3\r\n" "")))))
      (is (= :guest-browser-clock-absent (:reason (run through-edit))))
      (is (= 3 (:exit (guest/classify "guest-browser-clock" {:serial ok :qemu-unmeasured? true})))))))

(deftest guest-browser-layout-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok
                  (apply str (map max-line shape-rows)) shape-ok
                  (apply str (map max-line press-rows)) press-lines pressed-ok)
        mn (apply str (map min-line min-rows))
        pre (str base mn min-reg-lines minimize-ok)
        lines (apply str (map lock-line lock-rows))
        states (apply str (map lock-state-line lock-state-rows))
        lock-part (str pre lines states screen-lock-ok)
        so (apply str (map so-line so-rows))
        so-states (apply str (map lock-state-line so-lock-rows))
        through-sign-out (str lock-part so so-states (so-state-lines 0) sign-out-ok)
        rg (apply str (map ring-line ring-rows))
        through-ring (str through-sign-out rg "AIUEOS_GUEST_BROWSER_RING_OK events=28\r\n")
        ed (apply str (map edit-line edit-rows))
        through-edit (str through-ring ed "AIUEOS_GUEST_BROWSER_EDIT_OK events=72\r\n")
        clock (str "AIUEOS_GUEST_BROWSER_CLOCK_RTC set=12:34 read=12:34\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK n=1 status=0 net=0 ops=77 text-px=668 hash=bed963dd\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK n=2 status=755 net=0 ops=82 text-px=755 hash=9eb22e19\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK n=3 status=755 net=3 ops=88 text-px=892 hash=c9fc0d1c\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK_OK frames=3\r\n")
        ok (str through-edit clock)
        want @#'guest/layout-want
        line (fn [{:keys [n key layout text caret ops px hash]}]
               (str "AIUEOS_GUEST_BROWSER_LAYOUT n=" n " key=" key " text=" text " layout=" layout " caret=" caret " sel=-"
                    " ops=" ops " text-px=" px " hash=" hash "\r\n"))
        lay (fn [rows] (str (apply str (map line rows)) "AIUEOS_GUEST_BROWSER_LAYOUT_OK events=36\r\n"))
        good (str ok (lay want))
        run (fn [serial] (guest/classify "guest-browser-layout" {:serial serial}))]
    (testing "US characters, F9, JIS characters, F9 back, all equal to the model: green"
      (let [r (run good)]
        (is (= :guest-browser-layout (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "a layout that did not switch is red"
      (is (= :layout-differs-from-model
             (:reason (run (str ok (lay (map #(if (>= (:n %) 19) (assoc % :layout 0) %) want))))))))
    (testing "the same characters on the wrong layout are red even if the table were altered to agree"
      (is (= :layout-differs-from-model
             (:reason (run (.replace good "text=ab_c|@2A:\"\"*@+e" "text=ab_c|@2A:\"\"*\"+e"))))))
    (testing "it needs the clock gate green first"
      (is (= :no-clock (:reason (run (lay want))))))
    (testing "the OK line missing is not green, no lines is absent, unmeasured is exit 3"
      (is (= :layout-ok-missing (:reason (run (.replace good "AIUEOS_GUEST_BROWSER_LAYOUT_OK events=36\r\n" "")))))
      (is (= :guest-browser-layout-absent (:reason (run ok))))
      (is (= 3 (:exit (guest/classify "guest-browser-layout" {:serial good :qemu-unmeasured? true})))))))

(deftest guest-browser-notify-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok
                  (apply str (map max-line shape-rows)) shape-ok
                  (apply str (map max-line press-rows)) press-lines pressed-ok)
        mn (apply str (map min-line min-rows))
        pre (str base mn min-reg-lines minimize-ok)
        lines (apply str (map lock-line lock-rows))
        states (apply str (map lock-state-line lock-state-rows))
        lock-part (str pre lines states screen-lock-ok)
        so (apply str (map so-line so-rows))
        so-states (apply str (map lock-state-line so-lock-rows))
        through-sign-out (str lock-part so so-states (so-state-lines 0) sign-out-ok)
        rg (apply str (map ring-line ring-rows))
        through-ring (str through-sign-out rg "AIUEOS_GUEST_BROWSER_RING_OK events=28\r\n")
        ed (apply str (map edit-line edit-rows))
        through-edit (str through-ring ed "AIUEOS_GUEST_BROWSER_EDIT_OK events=72\r\n")
        clock (str "AIUEOS_GUEST_BROWSER_CLOCK_RTC set=12:34 read=12:34\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK n=1 status=0 net=0 ops=77 text-px=668 hash=bed963dd\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK n=2 status=755 net=0 ops=82 text-px=755 hash=9eb22e19\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK n=3 status=755 net=3 ops=88 text-px=892 hash=c9fc0d1c\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK_OK frames=3\r\n")
        ok (str through-edit clock)
        want @#'guest/layout-want
        line (fn [{:keys [n key layout text caret ops px hash]}]
               (str "AIUEOS_GUEST_BROWSER_LAYOUT n=" n " key=" key " text=" text " layout=" layout " caret=" caret " sel=-"
                    " ops=" ops " text-px=" px " hash=" hash "\r\n"))
        lay (fn [rows] (str (apply str (map line rows)) "AIUEOS_GUEST_BROWSER_LAYOUT_OK events=36\r\n"))
        good (str ok (lay want))
        nwant @#'guest/notify-want
        nline (fn [{:keys [n key notes panel ops px hash]}]
                (str "AIUEOS_GUEST_BROWSER_NOTIFY n=" n " key=" key " notes=" notes " panel=" panel
                     " ops=" ops " text-px=" px " hash=" hash "\r\n"))
        nlay (fn [rows] (str (apply str (map nline rows)) "AIUEOS_GUEST_BROWSER_NOTIFY_OK events=12\r\n"))
        full (str good (nlay nwant))
        run (fn [serial] (guest/classify "guest-browser-notify" {:serial serial}))]
    (testing "raised, shown, dismissed, listed and closed, all equal to the model: green"
      (let [r (run full)]
        (is (= :guest-browser-notify (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "a dismiss that did nothing is red"
      (is (= :notify-differs-from-model
             (:reason (run (str good (nlay (map #(if (= (:n %) 4) (assoc % :notes "1100" :ops 100 :px 1088 :hash "132f00a4") %) nwant))))))))
    (testing "it needs the layout gate green first"
      (is (= :no-layout (:reason (run (nlay nwant))))))
    (testing "the OK line missing is not green, no lines is absent, unmeasured is exit 3"
      (is (= :notify-ok-missing (:reason (run (.replace full "AIUEOS_GUEST_BROWSER_NOTIFY_OK events=12\r\n" "")))))
      (is (= :guest-browser-notify-absent (:reason (run good))))
      (is (= 3 (:exit (guest/classify "guest-browser-notify" {:serial full :qemu-unmeasured? true})))))))

(deftest guest-browser-passkey-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok
                  (apply str (map max-line shape-rows)) shape-ok
                  (apply str (map max-line press-rows)) press-lines pressed-ok)
        mn (apply str (map min-line min-rows))
        pre (str base mn min-reg-lines minimize-ok)
        lines (apply str (map lock-line lock-rows))
        states (apply str (map lock-state-line lock-state-rows))
        lock-part (str pre lines states screen-lock-ok)
        so (apply str (map so-line so-rows))
        so-states (apply str (map lock-state-line so-lock-rows))
        through-sign-out (str lock-part so so-states (so-state-lines 0) sign-out-ok)
        rg (apply str (map ring-line ring-rows))
        through-ring (str through-sign-out rg "AIUEOS_GUEST_BROWSER_RING_OK events=28\r\n")
        ed (apply str (map edit-line edit-rows))
        through-edit (str through-ring ed "AIUEOS_GUEST_BROWSER_EDIT_OK events=72\r\n")
        clock (str "AIUEOS_GUEST_BROWSER_CLOCK_RTC set=12:34 read=12:34\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK n=1 status=0 net=0 ops=77 text-px=668 hash=bed963dd\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK n=2 status=755 net=0 ops=82 text-px=755 hash=9eb22e19\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK n=3 status=755 net=3 ops=88 text-px=892 hash=c9fc0d1c\r\n"
                   "AIUEOS_GUEST_BROWSER_CLOCK_OK frames=3\r\n")
        ok (str through-edit clock)
        want @#'guest/layout-want
        line (fn [{:keys [n key layout text caret ops px hash]}]
               (str "AIUEOS_GUEST_BROWSER_LAYOUT n=" n " key=" key " text=" text " layout=" layout " caret=" caret " sel=-"
                    " ops=" ops " text-px=" px " hash=" hash "\r\n"))
        lay (fn [rows] (str (apply str (map line rows)) "AIUEOS_GUEST_BROWSER_LAYOUT_OK events=36\r\n"))
        good (str ok (lay want))
        nwant @#'guest/notify-want
        nline (fn [{:keys [n key notes panel ops px hash]}]
                (str "AIUEOS_GUEST_BROWSER_NOTIFY n=" n " key=" key " notes=" notes " panel=" panel
                     " ops=" ops " text-px=" px " hash=" hash "\r\n"))
        nlay (fn [rows] (str (apply str (map nline rows)) "AIUEOS_GUEST_BROWSER_NOTIFY_OK events=12\r\n"))
        full (str good (nlay nwant))
        pwant @#'guest/passkey-want
        pline (fn [{:keys [n key locked denied ops px hash]}]
                (str "AIUEOS_GUEST_BROWSER_PASSKEY n=" n " key=" key " locked=" locked " denied=" denied
                     " ops=" ops " text-px=" px " hash=" hash "\r\n"))
        reg "AIUEOS_GUEST_BROWSER_PASSKEY_REG ready=1 created=1 pub=0123456789abcdef\r\n"
        tries (str "AIUEOS_GUEST_BROWSER_PASSKEY_TRY n=1 key=other-device signed=1 verified=0 session=none\r\n"
                   "AIUEOS_GUEST_BROWSER_PASSKEY_TRY n=2 key=device signed=1 verified=1 session=00112233445566ff\r\n")
        pass (str reg tries (apply str (map pline pwant)) "AIUEOS_GUEST_BROWSER_PASSKEY_OK events=10 tries=2 accepted=1\r\n")
        run (fn [serial] (guest/classify "guest-browser-passkey" {:serial serial}))]
    (testing "another device's passkey refused, this device's accepted, the frames equal to the model: green"
      (let [r (run (str full pass))]
        (is (= :guest-browser-passkey (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "another device's passkey that verified is red"
      (is (= :other-device-passkey-not-refused-or-own-not-verified
             (:reason (run (str full (.replace pass "key=other-device signed=1 verified=0" "key=other-device signed=1 verified=1")))))))
    (testing "this device's passkey that did not verify is red"
      (is (= :other-device-passkey-not-refused-or-own-not-verified
             (:reason (run (str full (.replace pass "key=device signed=1 verified=1" "key=device signed=1 verified=0")))))))
    (testing "a session id that is not eight bytes is red"
      (is (= :other-device-passkey-not-refused-or-own-not-verified
             (:reason (run (str full (.replace pass "session=00112233445566ff" "session=0011")))))))
    (testing "a lock that did not open is red"
      (is (= :passkey-differs-from-model
             (:reason (run (str full (.replace pass "n=9 key=249 locked=0 denied=0" "n=9 key=249 locked=1 denied=0")))))))
    (testing "no registered device key is red"
      (is (= :no-registered-device-key (:reason (run (str full (.replace pass "ready=1" "ready=0")))))))
    (testing "it needs the notification gate green first"
      (is (= :no-notify (:reason (run pass)))))
    (testing "no lines is absent, unmeasured is exit 3"
      (is (= :guest-browser-passkey-absent (:reason (run full))))
      (is (= 3 (:exit (guest/classify "guest-browser-passkey" {:serial (str full pass) :qemu-unmeasured? true})))))))
