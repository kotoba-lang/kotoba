(defn- min-line [[n src at red focus stack ops px hash]]
  (str "AIUEOS_GUEST_BROWSER_MAX n=" n " src=" src " at=" at " reduce=" red
       " windows=3 focus=" focus " stack=" stack " rect=272,132,240,200 ops=" ops " text-px=" px " hash=" hash "\r\n"))

(def ^:private min-reg-lines
  (apply str (for [[n r c d y x] [[35 1 2 1 1 0] [36 1 2 1 1 0] [37 1 2 1 1 0] [38 1 2 1 1 0] [39 0 3 0 0 0] [40 0 3 0 0 0] [41 1 2 1 1 0] [42 1 2 1 1 0] [43 0 3 0 0 0] [44 0 3 0 0 0] [45 0 3 0 0 0] [46 1 2 1 1 0] [47 1 2 1 1 0] [48 1 2 1 1 0] [49 0 3 0 0 0] [50 0 3 0 0 0] [51 1 2 1 1 0] [52 1 2 1 1 0] [53 9 0 2 2 1] [54 9 0 2 2 1] [55 9 0 2 2 1] [56 9 0 2 2 1] [57 8 2 1 1 0] [58 8 2 1 1 0] [59 0 3 0 0 0] [60 0 3 0 0 0]]]
               (str "AIUEOS_GUEST_BROWSER_MIN n=" n " reg=" r " minctl=" c " dockbar=" d " tray=" y " dis=" x "\r\n"))))

(def ^:private minimize-ok
  "AIUEOS_GUEST_BROWSER_MINIMIZE_OK events=26 minimized=1 hit-through=4 restored=1 tray=restored alt-minus=minimized close-disabled=refused\r\n")

(deftest guest-browser-minimize-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok
                  (apply str (map max-line shape-rows)) shape-ok
                  (apply str (map max-line press-rows)) press-lines pressed-ok)
        mn (apply str (map min-line min-rows))
        ok (str base mn min-reg-lines minimize-ok)]
    (testing "minimized, not hit, restored from the dock: green"
      (let [r (guest/classify "guest-browser-minimize" {:serial ok})]
        (is (= :guest-browser-minimize (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "the earlier gates still read their own lines with the minimize lines present"
      (is (= :guest-browser-pressed-state (:reason (guest/classify "guest-browser-pressed-state" {:serial ok})))))
    (testing "a window that is still drawn after the press is red, and says which frame"
      (let [bad (-> (vec min-rows) (assoc-in [0 6] 192) (assoc-in [1 6] 192))
            r (guest/classify "guest-browser-minimize" {:serial (str base (apply str (map min-line bad)) min-reg-lines minimize-ok)})]
        (is (= :minimize-differs-from-model (:reason r)))
        (is (= 35 (:n (:kernel (:first-difference r)))))))
    (testing "a press that lands on the minimized window (answer 1) is red"
      (let [bad (-> (vec min-rows) (assoc-in [2 3] 1) (assoc-in [2 4] 1))]
        (is (not (:green? (guest/classify "guest-browser-minimize"
                                          {:serial (str base (apply str (map min-line bad)) min-reg-lines minimize-ok)}))))))
    (testing "a register that does not mark the window, or does not clear it on restore, is red"
      (is (= :minimized-register-differs-from-model
             (:reason (guest/classify "guest-browser-minimize"
                                      {:serial (str base mn (.replace min-reg-lines "n=35 reg=1" "n=35 reg=0") minimize-ok)}))))
      (is (= :minimized-register-differs-from-model
             (:reason (guest/classify "guest-browser-minimize"
                                      {:serial (str base mn (.replace min-reg-lines "n=39 reg=0" "n=39 reg=1") minimize-ok)})))))
    (testing "it needs the pressed-state gate green first"
      (is (= :no-pressed-state (:reason (guest/classify "guest-browser-minimize" {:serial (str mn min-reg-lines minimize-ok)})))))
    (testing "the OK line missing is not green, no lines is absent, unmeasured is exit 3"
      (is (= :minimize-ok-missing (:reason (guest/classify "guest-browser-minimize" {:serial (str base mn min-reg-lines)}))))
      (is (= :guest-browser-minimize-absent (:reason (guest/classify "guest-browser-minimize" {:serial (str base minimize-ok)}))))
      (is (= 3 (:exit (guest/classify "guest-browser-minimize" {:serial ok :qemu-unmeasured? true})))))))

