  (testing "tablet profile, with the dictionary's wall clock and more"
    (is (= {"AIUEOS_GUEST_BROWSER" "1" "AIUEOS_QEMU_TIMEOUT" "1080"} (guest/extra-env "guest-browser-cursor")))))

