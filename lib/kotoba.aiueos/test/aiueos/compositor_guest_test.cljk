  (testing "named reds"
    (doseq [[line reason] [["AIUEOS_GUEST_BROWSER_CURSOR leftover=events-missing events=2 frames=2\r\n" :events-missing]
                           ["AIUEOS_GUEST_BROWSER_CURSOR leftover=census-miss off=5 before=0 chain=0badf00d fill=ffffff\r\n" :census-miss]
                           ["" :guest-browser-cursor-absent]]]
