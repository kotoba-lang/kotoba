(ns aiueos.compositor-guest-test
  "nbb-loadable classifiers for KERNEL.ELF guest compositor gates (ADR-0100).

  `kbb -M:test` of compositor_test.clj still covers hosted HTML/QEMU
  argv. This ns is the second runtime: the gate command must not need a
  JVM, hosted WM serial must stay red, and unanswered QEMU is exit 3."
  (:require [aiueos.compositor.guest :as guest]
            [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]]))

(deftest gate-cmd-is-nbb-not-clojure
  (doseq [p guest/guest-profiles]
    (let [cmd (guest/gate-cmd p)]
      (is (str/starts-with? cmd "kbb --backend sci --classpath src scripts/compositor-guest.cljk "))
      (is (str/ends-with? cmd p))
      (is (not (str/includes? cmd "clojure -M"))
          "guest evidence must not be a JVM alias"))))

(deftest guest-session-serial-is-green-without-jvm-wm
  (testing "KERNEL.ELF packed front 2 restore is green"
    (is (guest/guest-session-ok?
         "AIUEOS_GUEST_SESSION_OK restored-front=2 packed=2 kotoba-front=2 hit=2\n"))
    (is (:green? (guest/guest-session-result
                  {:serial "AIUEOS_GUEST_SESSION_OK restored-front=2 packed=2 kotoba-front=2 hit=2\n"}))))
  (testing "hosted JVM WM serial does not count"
    (let [r (guest/guest-session-result {:serial "AIUEOS_COMPOSITOR_WM_OK\n"})]
      (is (not (:green? r)))
      (is (= 1 (:exit r)))
      (is (= :hosted-wm-does-not-count (:reason r))))
    (let [r (guest/guest-session-result {:hosted-wm? true :serial ""})]
      (is (= :hosted-wm-does-not-count (:reason r)))))
  (testing "unmeasured is exit 3, not a silent pass"
    (let [r (guest/guest-session-result {:qemu-unmeasured? true})]
      (is (= 3 (:exit r)))
      (is (= :unmeasured (:reason r)))))
  (testing "unknown profile is unmeasured, not a pass"
    (let [r (guest/classify "not-a-profile" {:serial "AIUEOS_GUEST_SESSION_OK restored-front=2 packed=2 kotoba-front=2 hit=2\n"})]
      (is (not (:green? r)))
      (is (= 3 (:exit r))))))

(deftest nbb-html-command-is-not-clojure-substring
  (is (not (str/includes? (guest/gate-cmd "guest-ime") "clojure -M:compositor guest-ime")))
  (is (str/includes? (guest/gate-cmd "guest-session") "guest-session")))

;; Guest browser desktop (ADR-0223). The reason each red names is pinned, not
;; only that it is red.
(def ^:private browser-frame-ok
  "AIUEOS_GUEST_BROWSER_FRAME_OK ops=5 overlap=d8e7ff win1-title=dde2ea surface=1280x800\r\n")

(def ^:private browser-input-ok
  "AIUEOS_GUEST_BROWSER_INPUT_OK eventq-used=1 kind=pointer-down px=60 py=50 hit=1 front=1 overlap=ffffff win1-title=d8e7ff\r\n")

(deftest guest-browser-frame-classifier
  (testing "the presented Kotoba frame is green, with the text leftover named"
    (let [r (guest/classify "guest-browser-frame" {:serial browser-frame-ok})]
      (is (:green? r))
      (is (= 0 (:exit r)))
      (is (= [:no-text-raster] (:leftover r)))))
  (testing "each named red keeps its own reason"
    (doseq [[line reason]
            [["AIUEOS_GUEST_BROWSER_FRAME leftover=frame-refused reason=-4\r\n" :frame-refused]
             ["AIUEOS_GUEST_BROWSER_FRAME leftover=fb-too-small\r\n" :fb-too-small]
             ["AIUEOS_GUEST_BROWSER_FRAME leftover=key-order-paint\r\n" :key-order-paint]
             ["AIUEOS_GUEST_BROWSER_FRAME leftover=colour-miss ops=5 overlap=ffffff win1-title=dde2ea\r\n" :colour-miss]
             ["AIUEOS_GUEST_PAINT_OK boot-overlap=2 raised-overlap=1 key-order=0\r\n" :guest-browser-frame-absent]]]
      (let [r (guest/classify "guest-browser-frame" {:serial line})]
        (is (not (:green? r)) line)
        (is (= 1 (:exit r)))
        (is (= reason (:reason r)) line))))
  (testing "a frame line with the wrong overlap colour is not green"
    (is (not (guest/guest-browser-frame-ok?
              "AIUEOS_GUEST_BROWSER_FRAME_OK ops=5 overlap=eef1f5 win1-title=dde2ea surface=1280x800\r\n"))))
  (testing "hosted WM serial does not count, unanswered QEMU is exit 3"
    (is (= :hosted-wm-does-not-count
           (:reason (guest/classify "guest-browser-frame"
                                    {:serial (str browser-frame-ok "AIUEOS_COMPOSITOR_WM_OK\n")}))))
    (is (= 3 (:exit (guest/classify "guest-browser-frame" {:qemu-unmeasured? true}))))))

(deftest guest-browser-input-classifier
  (testing "a tablet press reduced by Kotoba and redrawn is green"
    (let [r (guest/classify "guest-browser-input" {:serial (str browser-frame-ok browser-input-ok)})]
      (is (:green? r))
      (is (= :guest-browser-pointer-raise (:reason r)))))
  (testing "input without a presented frame is red for that reason"
    (let [r (guest/classify "guest-browser-input" {:serial browser-input-ok})]
      (is (not (:green? r)))
      (is (= :no-presented-frame (:reason r)))))
  (testing "each named red keeps its own reason"
    (doseq [[line reason]
            [["AIUEOS_GUEST_BROWSER_INPUT leftover=no-pointer-event tablets=0\r\n" :no-pointer-event]
             ["AIUEOS_GUEST_BROWSER_INPUT leftover=pointer-miss px=900 py=700\r\n" :pointer-miss]
             ["AIUEOS_GUEST_BROWSER_INPUT leftover=raise-not-painted\r\n" :raise-not-painted]
             ["AIUEOS_GUEST_BROWSER_INPUT leftover=vector-miss hit=2 overlap=d8e7ff\r\n" :vector-miss]
             ["" :guest-browser-input-absent]]]
      (let [r (guest/classify "guest-browser-input" {:serial (str browser-frame-ok line)})]
        (is (not (:green? r)) line)
        (is (= reason (:reason r)) line))))
  (testing "the synthetic keyboard gate alone is not a pointer"
    (is (not (:green? (guest/classify "guest-browser-input"
                                      {:serial (str browser-frame-ok
                                                    "AIUEOS_GUEST_INPUT_OK eventq-used=1 synthetic=0\r\n")})))))
  (testing "the profile boots with the tablet, the frame profile with nothing extra"
    (is (= {"AIUEOS_GUEST_BROWSER" "1"} (guest/extra-env "guest-browser-input")))
    (is (nil? (guest/extra-env "guest-browser-frame")))))

;; Guest browser desktop with text (ADR-0224).
(def ^:private browser-text-ok
  "AIUEOS_GUEST_BROWSER_TEXT_OK ops=70 text-px=1079 hash=89910f34 font-bytes=267208 surface=1280x800\r\n")

(deftest guest-browser-text-classifier
  (testing "the model's census on a 1280x800 surface is green"
    (let [r (guest/classify "guest-browser-text" {:serial browser-text-ok})]
      (is (:green? r))
      (is (= :guest-browser-text (:reason r)))))
  (testing "a census that differs from the model is red for that reason"
    (doseq [[line reason]
            [["AIUEOS_GUEST_BROWSER_TEXT leftover=census-miss ops=57 text-px=1083 hash=d2e7456a font-bytes=267208 surface=1280x800\r\n" :census-miss]
             ["AIUEOS_GUEST_BROWSER_TEXT leftover=font-absent\r\n" :font-absent]
             ["AIUEOS_GUEST_BROWSER_TEXT leftover=frame-refused reason=-6\r\n" :frame-refused]
             ["AIUEOS_GUEST_BROWSER_TEXT leftover=present-refused\r\n" :present-refused]
             ["AIUEOS_GUEST_BROWSER_FRAME_OK ops=5 overlap=d8e7ff win1-title=dde2ea surface=1280x800\r\n" :guest-browser-text-absent]]]
      (let [r (guest/classify "guest-browser-text" {:serial line})]
        (is (not (:green? r)) line)
        (is (= reason (:reason r)) line))))
  (testing "the right numbers on another surface size are not the pinned answer"
    (is (not (guest/guest-browser-text-ok?
              "AIUEOS_GUEST_BROWSER_TEXT_OK ops=70 text-px=1079 hash=89910f34 font-bytes=267208 surface=1024x768\r\n"))))
  (testing "raised needs the text frame first, then its own census"
    (is (= :no-text-frame
           (:reason (guest/classify "guest-browser-text-raised"
                                    {:serial "AIUEOS_GUEST_BROWSER_TEXT_RAISED_OK hit=1 ops=70 text-px=880 hash=b9f96599\r\n"}))))
    (is (:green? (guest/classify "guest-browser-text-raised"
                                 {:serial (str browser-text-ok
                                               "AIUEOS_GUEST_BROWSER_TEXT_RAISED_OK hit=1 ops=70 text-px=880 hash=b9f96599\r\n")})))
    (is (= :no-pointer-event
           (:reason (guest/classify "guest-browser-text-raised" {:serial browser-text-ok}))))
    (is (= {"AIUEOS_GUEST_BROWSER" "1"} (guest/extra-env "guest-browser-text-raised")))))

;; Guest browser typing (ADR-0225).
(def ^:private raised-ok
  (str browser-text-ok
       "AIUEOS_GUEST_BROWSER_TEXT_RAISED_OK hit=1 ops=70 text-px=880 hash=b9f96599\r\n"))

(deftest guest-browser-type-classifier
  (testing "the IME's commit, redrawn, matches the model"
    (let [r (guest/classify "guest-browser-type"
                            {:serial (str raised-ok "AIUEOS_GUEST_BROWSER_TYPE_OK presses=19 committed=5 ops=75 text-px=1068 hash=a92b8f58\r\n")})]
      (is (:green? r))
      (is (= :guest-browser-type (:reason r)))))
  (testing "typing needs the raised text frame first"
    (is (= :no-raised-text-frame
           (:reason (guest/classify "guest-browser-type"
                                    {:serial "AIUEOS_GUEST_BROWSER_TYPE_OK presses=19 committed=5 ops=75 text-px=1068 hash=a92b8f58\r\n"})))))
  (testing "each named red keeps its reason"
    (doseq [[line reason]
            [["AIUEOS_GUEST_BROWSER_TYPE leftover=keys-missing presses=4\r\n" :keys-missing]
             ["AIUEOS_GUEST_BROWSER_TYPE leftover=census-miss committed=4 refused=0 ops=61 text-px=1030 hash=00000000\r\n" :census-miss]
             ["" :guest-browser-type-absent]]]
      (is (= reason (:reason (guest/classify "guest-browser-type" {:serial (str raised-ok line)}))) line)))
  (testing "a different commit count is not the pinned answer"
    (is (not (:green? (guest/classify "guest-browser-type"
                                      {:serial (str raised-ok "AIUEOS_GUEST_BROWSER_TYPE_OK presses=19 committed=4 ops=62 text-px=1052 hash=7caecfe8\r\n")})))))
  (testing "the profile is the tablet one"
    (is (= {"AIUEOS_GUEST_BROWSER" "1"} (guest/extra-env "guest-browser-type")))))

;; Guest browser preedit (ADR-0227).
(def ^:private typed-ok
  (str raised-ok "AIUEOS_GUEST_BROWSER_TYPE_OK presses=19 committed=5 ops=75 text-px=1068 hash=a92b8f58\r\n"))

(deftest guest-browser-preedit-classifier
  (testing "the ruled composition and its commit, both matching the model, are green"
    (is (:green? (guest/classify "guest-browser-preedit"
                                 {:serial (str typed-ok "AIUEOS_GUEST_BROWSER_PREEDIT_OK shown-ops=67 shown-px=1146 shown-hash=566a1c8f committed=2 ops=77 text-px=1128 hash=193030b3\r\n")}))))
  (testing "preedit needs the typing frame first"
    (is (= :no-typing-frame
           (:reason (guest/classify "guest-browser-preedit"
                                    {:serial "AIUEOS_GUEST_BROWSER_PREEDIT_OK shown-ops=67 shown-px=1146 shown-hash=566a1c8f committed=2 ops=77 text-px=1128 hash=193030b3\r\n"})))))
  (testing "named reds"
    (doseq [[line reason] [["AIUEOS_GUEST_BROWSER_PREEDIT leftover=keys-missing presses=1\r\n" :keys-missing]
                           ["AIUEOS_GUEST_BROWSER_PREEDIT leftover=census-miss stray=0 committed=2 ops=64 text-px=1052 hash=7caecfe8\r\n" :census-miss]
                           ["" :guest-browser-preedit-absent]]]
      (is (= reason (:reason (guest/classify "guest-browser-preedit" {:serial (str typed-ok line)}))) line)))
  (testing "a shown frame without its rule (same px as typed) is not green"
    (is (not (:green? (guest/classify "guest-browser-preedit"
                                      {:serial (str typed-ok "AIUEOS_GUEST_BROWSER_PREEDIT_OK shown-ops=66 shown-px=1116 shown-hash=c9f528cb committed=2 ops=64 text-px=1112 hash=63e3fe67\r\n")})))))
  (testing "tablet profile"
    (is (= {"AIUEOS_GUEST_BROWSER" "1"} (guest/extra-env "guest-browser-preedit")))))

;; Guest browser IME toggle (ADR-0228).
(def ^:private preedit-ok
  (str typed-ok "AIUEOS_GUEST_BROWSER_PREEDIT_OK shown-ops=67 shown-px=1146 shown-hash=566a1c8f committed=2 ops=77 text-px=1128 hash=193030b3\r\n"))

(deftest guest-browser-ime-toggle-classifier
  (testing "latin while off, kana once back on, matching the model, is green"
    (is (:green? (guest/classify "guest-browser-ime-toggle"
                                 {:serial (str preedit-ok "AIUEOS_GUEST_BROWSER_IME_TOGGLE_OK presses=7 off=0 latin=2 committed=1 ime=1 ops=80 text-px=1205 hash=322e206e\r\n")}))))
  (testing "the toggle needs the preedit frame first"
    (is (= :no-preedit-frame
           (:reason (guest/classify "guest-browser-ime-toggle"
                                    {:serial (str typed-ok "AIUEOS_GUEST_BROWSER_IME_TOGGLE_OK presses=7 off=0 latin=2 committed=1 ime=1 ops=80 text-px=1205 hash=322e206e\r\n")})))))
  (testing "named reds"
    (doseq [[line reason] [["AIUEOS_GUEST_BROWSER_IME_TOGGLE leftover=keys-missing presses=3\r\n" :keys-missing]
                           ["AIUEOS_GUEST_BROWSER_IME_TOGGLE leftover=census-miss miss=2 off=1 latin=0 committed=1 ime=0 ops=67 text-px=1189 hash=4aaf87ee\r\n" :census-miss]
                           ["" :guest-browser-ime-toggle-absent]]]
      (is (= reason (:reason (guest/classify "guest-browser-ime-toggle" {:serial (str preedit-ok line)}))) line)))
  (testing "a toggle the IME never saw (kana where latin should be) is not green"
    (is (not (:green? (guest/classify "guest-browser-ime-toggle"
                                      {:serial (str preedit-ok "AIUEOS_GUEST_BROWSER_IME_TOGGLE_OK presses=7 off=1 latin=0 committed=1 ime=1 ops=67 text-px=1189 hash=4aaf87ee\r\n")})))))
  (testing "tablet profile"
    (is (= {"AIUEOS_GUEST_BROWSER" "1"} (guest/extra-env "guest-browser-ime-toggle")))))

;; Guest browser titlebar drag (ADR-0229).
(def ^:private toggle-ok
  (str preedit-ok "AIUEOS_GUEST_BROWSER_IME_TOGGLE_OK presses=7 off=0 latin=2 committed=1 ime=1 ops=80 text-px=1205 hash=322e206e\r\n"))

(deftest guest-browser-drag-classifier
  (testing "press, three moves, release, a stray move: moved by the delta, matching the model, is green"
    (is (:green? (guest/classify "guest-browser-drag"
                                 {:serial (str toggle-ok "AIUEOS_GUEST_BROWSER_DRAG_OK events=6 answers=111100 from=32,32 to=272,132 capture=0 ops=80 text-px=1947 hash=523440e0\r\n")}))))
  (testing "the drag needs the ime-toggle frame first"
    (is (= :no-ime-toggle-frame
           (:reason (guest/classify "guest-browser-drag"
                                    {:serial (str preedit-ok "AIUEOS_GUEST_BROWSER_DRAG_OK events=6 answers=111100 from=32,32 to=272,132 capture=0 ops=80 text-px=1947 hash=523440e0\r\n")})))))
  (testing "named reds"
    (doseq [[line reason] [["AIUEOS_GUEST_BROWSER_DRAG leftover=events-missing events=1 off=0 frame=67\r\n" :events-missing]
                           ["AIUEOS_GUEST_BROWSER_DRAG leftover=census-miss off=0 front=1 to=32,32 capture=1 ops=67 text-px=1189 hash=4aaf87ee\r\n" :census-miss]
                           ["" :guest-browser-drag-absent]]]
      (is (= reason (:reason (guest/classify "guest-browser-drag" {:serial (str toggle-ok line)}))) line)))
  (testing "a window that did not move (the pre-drag census) is not green"
    (is (not (:green? (guest/classify "guest-browser-drag"
                                      {:serial (str toggle-ok "AIUEOS_GUEST_BROWSER_DRAG_OK events=6 answers=111100 from=32,32 to=32,32 capture=0 ops=67 text-px=1189 hash=4aaf87ee\r\n")})))))
  (testing "tablet profile"
    (is (= {"AIUEOS_GUEST_BROWSER" "1"} (guest/extra-env "guest-browser-drag")))))

;; Guest browser resize (ADR-0230).
(def ^:private drag-ok
  (str toggle-ok "AIUEOS_GUEST_BROWSER_DRAG_OK events=6 answers=111100 from=32,32 to=272,132 capture=0 ops=80 text-px=1947 hash=523440e0\r\n"))

(deftest guest-browser-resize-classifier
  (testing "handle press, three moves (one clamped), release, a stray move: resized, matching the model, is green"
    (is (:green? (guest/classify "guest-browser-resize"
                                 {:serial (str drag-ok "AIUEOS_GUEST_BROWSER_RESIZE_OK events=6 answers=111100 clamp=120x80 size=240x200 at=272,132 capture=0 ops=80 text-px=1947 hash=523440e0\r\n")}))))
  (testing "the resize needs the drag frame first"
    (is (= :no-drag-frame
           (:reason (guest/classify "guest-browser-resize"
                                    {:serial (str toggle-ok "AIUEOS_GUEST_BROWSER_RESIZE_OK events=6 answers=111100 clamp=120x80 size=240x200 at=272,132 capture=0 ops=80 text-px=1947 hash=523440e0\r\n")})))))
  (testing "named reds"
    (doseq [[line reason] [["AIUEOS_GUEST_BROWSER_RESIZE leftover=events-missing events=1 off=0 frame=67\r\n" :events-missing]
                           ["AIUEOS_GUEST_BROWSER_RESIZE leftover=census-miss off=0 clamp=36x76 size=240x200 at=272,132 capture=0 ops=80 text-px=1947 hash=523440e0\r\n" :census-miss]
                           ["" :guest-browser-resize-absent]]]
      (is (= reason (:reason (guest/classify "guest-browser-resize" {:serial (str drag-ok line)}))) line)))
  (testing "an unclamped resize (the clamp field differs) is not green"
    (is (not (:green? (guest/classify "guest-browser-resize"
                                      {:serial (str drag-ok "AIUEOS_GUEST_BROWSER_RESIZE_OK events=6 answers=111100 clamp=36x76 size=240x200 at=272,132 capture=0 ops=80 text-px=1947 hash=523440e0\r\n")})))))
  (testing "a window that did not resize (the drag census) is not green"
    (is (not (:green? (guest/classify "guest-browser-resize"
                                      {:serial (str drag-ok "AIUEOS_GUEST_BROWSER_RESIZE_OK events=6 answers=111100 clamp=120x80 size=720x540 at=272,132 capture=0 ops=80 text-px=1947 hash=523440e0\r\n")})))))
  (testing "tablet profile"
    (is (= {"AIUEOS_GUEST_BROWSER" "1"} (guest/extra-env "guest-browser-resize")))))

;; Guest browser event loop (ADR-0231).
(def ^:private resize-ok
  (str drag-ok "AIUEOS_GUEST_BROWSER_RESIZE_OK events=6 answers=111100 clamp=120x80 size=240x200 at=272,132 capture=0 ops=80 text-px=1947 hash=523440e0\r\n"))

(def ^:private loop-frames
  (apply str (for [n (range 1 10)] (str "AIUEOS_GUEST_BROWSER_LOOP_FRAME n=" n " src=key answer=0 ops=69 text-px=1958 hash=f7326f2e\r\n"))))

(def ^:private loop-ok
  "AIUEOS_GUEST_BROWSER_LOOP_OK events=9 frames=9 answers=001220001 focus=2 at=196,172 capture=0 chain=b185dff1 ops=82 text-px=901 hash=7b0f9b05 idle-min=")

(deftest guest-browser-event-loop-classifier
  (testing "nine interleaved events, a frame after each, the model's chain, the loop waiting: green"
    (is (= :guest-browser-event-loop
           (:reason (guest/classify "guest-browser-event-loop"
                                    {:serial (str resize-ok loop-frames loop-ok "1734\r\n")})))))
  (testing "the loop needs the resize frame first"
    (is (= :no-resize-frame
           (:reason (guest/classify "guest-browser-event-loop"
                                    {:serial (str drag-ok loop-frames loop-ok "1734\r\n")})))))
  (testing "an event that arrived before the loop polled (idle-min=0) is not a running loop"
    (is (= :loop-not-waiting
           (:reason (guest/classify "guest-browser-event-loop"
                                    {:serial (str resize-ok loop-frames loop-ok "0\r\n")})))))
  (testing "a frame line missing (one frame for two events) is not green"
    (is (= :frame-lines-missing
           (:reason (guest/classify "guest-browser-event-loop"
                                    {:serial (str resize-ok (subs loop-frames 0 (* 8 (quot (count loop-frames) 9)))
                                                  loop-ok "1734\r\n")})))))
  (testing "a chain that is not the model's (one frame drawn from stale state) is not green"
    (is (not (:green? (guest/classify "guest-browser-event-loop"
                                      {:serial (str resize-ok loop-frames
                                                    "AIUEOS_GUEST_BROWSER_LOOP_OK events=9 frames=9 answers=001220001 focus=2 at=196,172 capture=0 chain=00000000 ops=69 text-px=890 hash=6bd523d7 idle-min=1734\r\n")})))))
  (testing "named reds"
    (doseq [[line reason] [["AIUEOS_GUEST_BROWSER_LOOP leftover=events-missing events=4 frames=4\r\n" :events-missing]
                           ["AIUEOS_GUEST_BROWSER_LOOP leftover=census-miss off=1 frames=9 chain=0badf00d focus=1 front=2 at=196,172 capture=0\r\n" :census-miss]
                           ["" :guest-browser-event-loop-absent]]]
      (is (= reason (:reason (guest/classify "guest-browser-event-loop" {:serial (str resize-ok line)}))) line)))
  (testing "tablet profile"
    (is (= {"AIUEOS_GUEST_BROWSER" "1" "AIUEOS_QEMU_TIMEOUT" "600"} (guest/extra-env "guest-browser-event-loop")))))

;; Guest browser caret (ADR-0232).
(def ^:private loop-ok-line
  (str resize-ok loop-frames loop-ok "1734\r\n"))

(def ^:private caret-frames
  (apply str (for [n (range 1 6)] (str "AIUEOS_GUEST_BROWSER_CARET_FRAME n=" n " key=14 answer=0 ops=68 caret=418,214 text-px=867 hash=d039564f\r\n"))))

(def ^:private caret-ok
  "AIUEOS_GUEST_BROWSER_CARET_OK keys=5 answers=00000 body=13 caret=418,214 chain=62295970 ops=80 text-px=867 hash=d039564f\r\n")

(deftest guest-browser-caret-classifier
  (testing "five keys, a frame after each ending with the caret, the model's chain: green"
    (let [r (guest/classify "guest-browser-caret" {:serial (str loop-ok-line caret-frames caret-ok)})]
      (is (= :guest-browser-caret (:reason r)))
      (is (= 0 (:exit r)))))
  (testing "the caret needs the event loop first, waiting"
    (is (= :no-event-loop
           (:reason (guest/classify "guest-browser-caret"
                                    {:serial (str resize-ok caret-frames caret-ok)}))))
    (is (= :no-event-loop
           (:reason (guest/classify "guest-browser-caret"
                                    {:serial (str resize-ok loop-frames loop-ok "0\r\n" caret-frames caret-ok)})))))
  (testing "a frame line missing is not green"
    (is (= :frame-lines-missing
           (:reason (guest/classify "guest-browser-caret"
                                    {:serial (str loop-ok-line (subs caret-frames 0 (* 4 (quot (count caret-frames) 5)))
                                                  caret-ok)})))))
  (testing "Backspace that did not delete (body=14, the hosted IME's consumed Backspace) is not green"
    (is (not (:green? (guest/classify "guest-browser-caret"
                                      {:serial (str loop-ok-line caret-frames
                                                    "AIUEOS_GUEST_BROWSER_CARET_OK keys=5 answers=00000 body=14 caret=418,214 chain=62295970 ops=80 text-px=867 hash=d039564f\r\n")})))))
  (testing "named reds"
    (doseq [[line reason] [["AIUEOS_GUEST_BROWSER_CARET leftover=keys-missing keys=2 frames=2\r\n" :keys-missing]
                           ["AIUEOS_GUEST_BROWSER_CARET leftover=census-miss off=5 frames=5 chain=0badf00d body=13 romaji=0 preedit=0\r\n" :census-miss]
                           ["" :guest-browser-caret-absent]]]
      (is (= reason (:reason (guest/classify "guest-browser-caret" {:serial (str loop-ok-line line)}))) line)))
  (testing "tablet profile, with the loop's wall clock and more"
    (is (= {"AIUEOS_GUEST_BROWSER" "1" "AIUEOS_QEMU_TIMEOUT" "720"} (guest/extra-env "guest-browser-caret")))))

;; Guest browser launcher and close (ADR-0233).
(def ^:private caret-ok-line
  (str loop-ok-line caret-frames caret-ok))

(def ^:private launch-frames
  (apply str (for [n (range 1 9)] (str "AIUEOS_GUEST_BROWSER_LAUNCH_FRAME n=" n " src=4 at=820,186 answer=0 windows=2 focus=3 ops=112 text-px=776 hash=98b595bd\r\n"))))

(def ^:private launch-ok
  "AIUEOS_GUEST_BROWSER_LAUNCH_OK events=8 answers=30203030 windows=2 stack=1,3 focus=3 chain=2845aee9 ops=112 text-px=776 hash=98b595bd\r\n")

(deftest guest-browser-launch-classifier
  (testing "eight tablet batches, a frame after each, the oracle's answers and the model's chain: green"
    (let [r (guest/classify "guest-browser-launch" {:serial (str caret-ok-line launch-frames launch-ok)})]
      (is (= :guest-browser-launch (:reason r)))
      (is (= 0 (:exit r)))
      (is (= [:one-window-per-app :the-last-window-stays :no-app-registry-beyond-the-slots] (:leftover r)))))
  (testing "the launcher needs the caret first"
    (is (= :no-caret
           (:reason (guest/classify "guest-browser-launch"
                                    {:serial (str loop-ok-line launch-frames launch-ok)})))))
  (testing "a frame line missing is not green"
    (is (= :frame-lines-missing
           (:reason (guest/classify "guest-browser-launch"
                                    {:serial (str caret-ok-line (subs launch-frames 0 (* 7 (quot (count launch-frames) 8)))
                                                  launch-ok)})))))
  (testing "a close that did not move the focus (answers 30303030) is not green"
    (is (not (:green? (guest/classify "guest-browser-launch"
                                      {:serial (str caret-ok-line launch-frames
                                                    "AIUEOS_GUEST_BROWSER_LAUNCH_OK events=8 answers=30303030 windows=2 stack=1,3 focus=3 chain=2845aee9 ops=112 text-px=776 hash=98b595bd\r\n")})))))
  (testing "named reds"
    (doseq [[line reason] [["AIUEOS_GUEST_BROWSER_LAUNCH leftover=events-missing events=3 frames=3\r\n" :events-missing]
                           ["AIUEOS_GUEST_BROWSER_LAUNCH leftover=census-miss off=2 frames=8 chain=0badf00d windows=2 stack=1,3 focus=3\r\n" :census-miss]
                           ["" :guest-browser-launch-absent]]]
      (is (= reason (:reason (guest/classify "guest-browser-launch" {:serial (str caret-ok-line line)}))) line)))
  (testing "tablet profile, with the caret's wall clock and more"
    (is (= {"AIUEOS_GUEST_BROWSER" "1" "AIUEOS_QEMU_TIMEOUT" "840"} (guest/extra-env "guest-browser-launch")))))

;; Guest browser dictionary (ADR-0235).
(def ^:private launch-ok-line
  (str caret-ok-line launch-frames launch-ok))

(def ^:private dict-lines
  (str "AIUEOS_GUEST_BROWSER_DICT_GO keys=5 dictionary-bytes=189892\r\n"
       "AIUEOS_GUEST_BROWSER_DICT_SHOWN keys=5 converting=1 record=44512 preedit=1 cp=23665 ops=114 text-px=834 hash=e85b42b2\r\n"
       "AIUEOS_GUEST_BROWSER_DICT_NEXT keys=11\r\n"))

(def ^:private dict-ok
  "AIUEOS_GUEST_BROWSER_DICT_OK keys=16 answers=0000000010000001 record=44512 committed=23665,20767 shown-ops=87 shown-px=834 shown-hash=e85b42b2 ops=114 text-px=915 hash=eaa427b3\r\n")

(deftest guest-browser-dictionary-classifier
  (testing "やま converts on its record, 山 and 償 committed, the model's censuses: green"
    (let [r (guest/classify "guest-browser-dictionary" {:serial (str launch-ok-line dict-lines dict-ok)})]
      (is (= :guest-browser-dictionary (:reason r)))
      (is (= 0 (:exit r)))
      (is (= [:single-kanji-candidates :okurigana-unmarked :no-learning] (:leftover r)))))
  (testing "the dictionary needs the launcher first"
    (is (= :no-launch
           (:reason (guest/classify "guest-browser-dictionary"
                                    {:serial (str caret-ok-line dict-lines dict-ok)})))))
  (testing "an OK line without the SHOWN line is not green"
    (is (= :dictionary-lines-missing
           (:reason (guest/classify "guest-browser-dictionary"
                                    {:serial (str launch-ok-line
                                                  "AIUEOS_GUEST_BROWSER_DICT_GO keys=5 dictionary-bytes=189892\r\n"
                                                  dict-ok)})))))
  (testing "a boot without the dictionary (Space commits kana: bytes 0, not converting) is not green"
    (is (= :dictionary-lines-missing
           (:reason (guest/classify "guest-browser-dictionary"
                                    {:serial (str launch-ok-line
                                                  "AIUEOS_GUEST_BROWSER_DICT_GO keys=5 dictionary-bytes=0\r\n"
                                                  "AIUEOS_GUEST_BROWSER_DICT_SHOWN keys=5 converting=0 record=0 preedit=0 cp=0 ops=112 text-px=776 hash=98b595bd\r\n"
                                                  dict-ok)})))))
  (testing "named reds"
    (doseq [[line reason] [["AIUEOS_GUEST_BROWSER_DICT leftover=keys-missing keys=5\r\n" :keys-missing]
                           ["AIUEOS_GUEST_BROWSER_DICT leftover=census-miss off=1 ops=87 text-px=915 hash=0badf00d body=23665,0\r\n" :census-miss]
                           ["" :guest-browser-dictionary-absent]]]
      (is (= reason (:reason (guest/classify "guest-browser-dictionary" {:serial (str launch-ok-line dict-lines line)}))) line)))
  (testing "tablet profile, with the launcher's wall clock and more"
    (is (= {"AIUEOS_GUEST_BROWSER" "1" "AIUEOS_QEMU_TIMEOUT" "960"} (guest/extra-env "guest-browser-dictionary")))))

;; Guest browser pointer (ADR-0236).
(def ^:private dict-ok-line
  (str launch-ok-line dict-lines dict-ok))

