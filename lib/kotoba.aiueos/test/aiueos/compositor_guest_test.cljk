(defn- ring-line [[n key ring w f st mn top ops px h]]
  (str "AIUEOS_GUEST_BROWSER_RING n=" n " key=" key " ring=" ring " windows=" w " focus=" f " stack=" st
       " min=" mn " top=" top " ops=" ops " text-px=" px " hash=" h "\r\n"))

(deftest guest-browser-keyboard-only-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok
                  (apply str (map max-line shape-rows)) shape-ok
                  (apply str (map max-line press-rows)) press-lines pressed-ok)
        mn (apply str (map min-line min-rows))
        pre (str base mn min-reg-lines minimize-ok)
        lines (apply str (map lock-line lock-rows))
        states (apply str (map lock-state-line lock-state-rows))
        lock-part (str pre lines states screen-lock-ok)
        so (apply str (map so-line so-rows))
        so-states (apply str (map lock-state-line so-lock-rows))
        through-sign-out (str lock-part so so-states (so-state-lines 0) sign-out-ok)
        rg (apply str (map ring-line ring-rows))
        ring-ok "AIUEOS_GUEST_BROWSER_RING_OK events=28\r\n"
        ok (str through-sign-out rg ring-ok)
        run (fn [serial] (guest/classify "guest-browser-keyboard-only" {:serial serial}))]
    (testing "every control reached and activated from the keyboard: green"
      (let [r (run ok)]
        (is (= :guest-browser-keyboard-only (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "an Enter that opened no window is red, and says which frame"
      (let [r (run (.replace ok "n=5 key=113 ring=2 windows=2 focus=2 stack=12" "n=5 key=113 ring=2 windows=1 focus=1 stack=1"))]
        (is (= :keyboard-only-differs-from-model (:reason r)))
        (is (= 5 (:n (:kernel (:first-difference r)))))))
    (testing "a ring that stopped before the tray is red"
      (is (= :keyboard-only-differs-from-model
             (:reason (run (.replace ok "n=21 key=257 ring=8" "n=21 key=257 ring=0"))))))
    (testing "a pointer event among the keys is red"
      (is (= :keyboard-only-differs-from-model
             (:reason (run (.replace ok "n=1 key=257" "n=1 key=1"))))))
    (testing "it needs the sign-out gate green first"
      (is (= :no-sign-out (:reason (run (str rg ring-ok))))))
    (testing "the OK line missing is not green, no lines is absent, unmeasured is exit 3"
      (is (= :keyboard-only-ok-missing (:reason (run (str through-sign-out rg)))))
      (is (= :guest-browser-keyboard-only-absent (:reason (run (str through-sign-out ring-ok)))))
      (is (= 3 (:exit (guest/classify "guest-browser-keyboard-only" {:serial ok :qemu-unmeasured? true})))))))

