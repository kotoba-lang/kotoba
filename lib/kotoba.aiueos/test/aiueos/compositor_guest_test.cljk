   [102 1 0 3 0]
   [103 1 0 4 0]
   [104 1 0 4 0]
   [105 0 3 0 0]
   [106 0 3 0 0]])

(defn- so-state-lines [body]
  (apply str (for [n (range 90 107)]
               (str "AIUEOS_GUEST_BROWSER_SIGNOUT n=" n
                    (if (<= n 92) " body=57 scroll=0 maxrect=0 minreg=0 windows=3 focus=4"
                        (str " body=" body " scroll=0 maxrect=0 minreg=0 windows=1 focus=1"))
                    "\r\n"))))

(def ^:private sign-out-ok
  "AIUEOS_GUEST_BROWSER_SIGN_OUT_OK events=16 session=zeroed locked=1 pin=signed-in clean=windows-1\r\n")

(deftest guest-browser-sign-out-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok
                  (apply str (map max-line shape-rows)) shape-ok
                  (apply str (map max-line press-rows)) press-lines pressed-ok)
        mn (apply str (map min-line min-rows))
        pre (str base mn min-reg-lines minimize-ok)
        lines (apply str (map lock-line lock-rows))
        states (apply str (map lock-state-line lock-state-rows))
        lock-part (str pre lines states screen-lock-ok)
        so (apply str (map so-line so-rows))
        so-states (apply str (map lock-state-line so-lock-rows))
        ok (str lock-part so so-states (so-state-lines 0) sign-out-ok)]
    (testing "signed out, the session zeroed, signed in to a clean session: green"
      (let [r (guest/classify "guest-browser-sign-out" {:serial ok})]
        (is (= :guest-browser-sign-out (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "the lock gate still reads its own lines with the sign-out lines present"
      (is (= :guest-browser-screen-lock (:reason (guest/classify "guest-browser-screen-lock" {:serial ok})))))
    (testing "a session that still has body words after the sign-out is red"
      (is (= :session-not-zeroed
             (:reason (guest/classify "guest-browser-sign-out"
                                      {:serial (str lock-part so so-states (so-state-lines 3) sign-out-ok)})))))
    (testing "no data before the sign-out proves nothing and is red"
      (is (= :no-session-data-before-sign-out
             (:reason (guest/classify "guest-browser-sign-out"
                                      {:serial (str lock-part so so-states
                                                    (.replace (so-state-lines 0) "body=57" "body=0") sign-out-ok)})))))
    (testing "a clean session that is not the model's is red"
      (let [bad (.replace so "n=105 src=0 at=456,146 reduce=none windows=1" "n=105 src=0 at=456,146 reduce=none windows=2")]
        (is (= :sign-out-differs-from-model
               (:reason (guest/classify "guest-browser-sign-out" {:serial (str lock-part bad so-states (so-state-lines 0) sign-out-ok)}))))))
    (testing "it needs the screen-lock gate green first"
      (is (= :no-screen-lock (:reason (guest/classify "guest-browser-sign-out" {:serial (str so so-states (so-state-lines 0) sign-out-ok)})))))
    (testing "the OK line missing is not green, no lines is absent, unmeasured is exit 3"
      (is (= :sign-out-ok-missing (:reason (guest/classify "guest-browser-sign-out" {:serial (str lock-part so so-states (so-state-lines 0))}))))
      (is (= :guest-browser-sign-out-absent (:reason (guest/classify "guest-browser-sign-out" {:serial (str lock-part sign-out-ok)}))))
      (is (= 3 (:exit (guest/classify "guest-browser-sign-out" {:serial ok :qemu-unmeasured? true})))))))

(defn- settings-serial
  "rows: guest-browser-settings-want rows; the OK line says how many key events (rows minus the opening frame)"
  [boot-line rows]
  (str boot-line
       (apply str (map (fn [{:keys [n key at hc ops pct net px hash written stored]}]
                         (str "AIUEOS_GUEST_BROWSER_SETTINGS n=" n " key=" key " at=" at " hc=" hc " ops=" ops " pct=" pct " net=" net
                              " win=2,2 text-px=" px " hash=" hash " written=" written " stored=" stored "\r\n"))
                       rows))
       "AIUEOS_GUEST_BROWSER_SETTINGS_OK events=" (dec (count rows)) "\r\n"))

(deftest guest-browser-settings-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok
                  (apply str (map max-line shape-rows)) shape-ok
                  (apply str (map max-line press-rows)) press-lines pressed-ok)
        mn (apply str (map min-line min-rows))
        pre (str base mn min-reg-lines minimize-ok)
        lines (apply str (map lock-line lock-rows))
        states (apply str (map lock-state-line lock-state-rows))
        lock-part (str pre lines states screen-lock-ok)
        so (apply str (map so-line so-rows))
        so-states (apply str (map lock-state-line so-lock-rows))
        through-sign-out (str lock-part so so-states (so-state-lines 0) sign-out-ok)
        w1 @#'guest/settings-want-1
        w2 @#'guest/settings-want-2
        boot1 (settings-serial "AIUEOS_GUEST_BROWSER_SETTINGS_BOOT valid=0 contrast=0 scale=100 net=0\r\n" w1)
        boot2 (str through-sign-out (settings-serial "AIUEOS_GUEST_BROWSER_SETTINGS_BOOT valid=1 contrast=1 scale=125 net=1\r\n" w2))
        run (fn [opts] (guest/classify "guest-browser-settings" opts))]
    (testing "three changes made and written on the first boot, read back on the second: green"
      (let [r (run {:serial boot2 :serial1 boot1})]
        (is (= :guest-browser-settings (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "a second boot that did not find the record is red"
      (is (= :second-boot-did-not-read-the-settings
             (:reason (run {:serial (.replace boot2 "valid=1 contrast=1 scale=125 net=1" "valid=0 contrast=0 scale=100 net=0") :serial1 boot1})))))
    (testing "a second boot that did not read the network setting is red"
      (is (= :second-boot-did-not-read-the-settings
             (:reason (run {:serial (.replace boot2 "scale=125 net=1" "scale=125 net=0") :serial1 boot1})))))
    (testing "a second boot told by clicks and not by the volume is red"
      (is (= :second-boot-differs-from-model
             (:reason (run {:serial (.replace boot2 "at=0,0" "at=200,171") :serial1 boot1})))))
    (testing "a first boot whose clicks missed the lines is red"
      (is (= :first-boot-differs-from-model
             (:reason (run {:serial boot2 :serial1 (.replace boot1 "at=200,131" "at=200,100")})))))
    (testing "a first boot that already had a record proves nothing and is red"
      (is (= :first-boot-had-a-record
             (:reason (run {:serial boot2 :serial1 (.replace boot1 "valid=0 contrast=0 scale=100 net=0" "valid=1 contrast=1 scale=125 net=1")})))))
    (testing "a change that was not written is red"
      (is (= :first-boot-differs-from-model
             (:reason (run {:serial boot2 :serial1 (.replace boot1 "written=3 stored=1" "written=2 stored=1")})))))
    (testing "frames off the model are red"
      (is (= :second-boot-differs-from-model
             (:reason (run {:serial (.replace boot2 "pct=125" "pct=100") :serial1 boot1})))))
    (testing "it needs the sign-out gate green first"
      (is (= :no-sign-out (:reason (run {:serial (settings-serial "AIUEOS_GUEST_BROWSER_SETTINGS_BOOT valid=1 contrast=1 scale=125 net=1\r\n" w2)
                                         :serial1 boot1})))))
    (testing "no lines is absent, unmeasured is exit 3"
      (is (= :guest-browser-settings-absent (:reason (run {:serial through-sign-out :serial1 boot1}))))
      (is (= 3 (:exit (run {:serial boot2 :serial1 boot1 :qemu-unmeasured? true})))))))

(deftest guest-browser-backup-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok
                  (apply str (map max-line shape-rows)) shape-ok
                  (apply str (map max-line press-rows)) press-lines pressed-ok)
        mn (apply str (map min-line min-rows))
        pre (str base mn min-reg-lines minimize-ok)
        lines (apply str (map lock-line lock-rows))
        states (apply str (map lock-state-line lock-state-rows))
        lock-part (str pre lines states screen-lock-ok)
        so (apply str (map so-line so-rows))
        so-states (apply str (map lock-state-line so-lock-rows))
        through-sign-out (str lock-part so so-states (so-state-lines 0) sign-out-ok)
        w1 @#'guest/settings-want-1
        w2 @#'guest/settings-want-2
        s1 (str through-sign-out
                (settings-serial "AIUEOS_GUEST_BROWSER_SETTINGS_BOOT valid=0 contrast=0 scale=100 net=0\r\n" w1)
                "AIUEOS_GUEST_BROWSER_PASSKEY_REG ready=1 created=1 pub=aabbccddeeff0011\r\n")
        s1 (.replace s1 "SETTINGS_OK events=6" "SETTINGS_OK events=6")
        cycle (str "AIUEOS_GUEST_BROWSER_BACKUP_TAKE settings=1111111111111111 passkey=2222222222222222\r\n"
                   "AIUEOS_GUEST_BROWSER_BACKUP_WIPE settings-valid=0 passkey-blank=1\r\n"
                   "AIUEOS_GUEST_BROWSER_BACKUP_RESTORE settings=1111111111111111 passkey=2222222222222222 settings-valid=1 contrast=1 scale=125 net=1 pub=aabbccddeeff0011 key-signs=1\r\n"
                   "AIUEOS_GUEST_BROWSER_BACKUP_OK sectors=2 byte-for-byte\r\n")
        good (str s1 cycle)
        run (fn [serial] (guest/classify "guest-browser-backup" {:serial serial}))]
    (testing "backed up, wiped, restored byte for byte, same settings, same key: green"
      (let [r (run good)]
        (is (= :guest-browser-backup (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "a wipe that left the settings is red"
      (is (= :wipe-did-not-remove-the-data (:reason (run (.replace good "settings-valid=0 passkey-blank=1" "settings-valid=1 passkey-blank=1"))))))
    (testing "restored bytes that differ are red"
      (is (= :restored-bytes-differ (:reason (run (.replace good "RESTORE settings=1111111111111111" "RESTORE settings=1111111111111112"))))))
    (testing "restored settings that differ are red"
      (is (= :restored-settings-differ (:reason (run (.replace good "contrast=1 scale=125 net=1" "contrast=0 scale=125 net=1"))))))
    (testing "a restored key that is another key is red"
      (is (= :restored-key-differs (:reason (run (.replace good "pub=aabbccddeeff0011 key-signs" "pub=aabbccddeeff0012 key-signs"))))))
    (testing "a restored key that does not sign is red"
      (is (= :restored-key-differs (:reason (run (.replace good "key-signs=1" "key-signs=0"))))))
    (testing "no OK line is not green; no cycle is absent; unmeasured is exit 3"
      (is (= :backup-ok-missing (:reason (run (.replace good "AIUEOS_GUEST_BROWSER_BACKUP_OK sectors=2 byte-for-byte\r\n" "")))))
      (is (= :guest-browser-backup-absent (:reason (run s1))))
      (is (= 3 (:exit (guest/classify "guest-browser-backup" {:serial good :qemu-unmeasured? true})))))))

(deftest guest-browser-audio-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok
                  (apply str (map max-line shape-rows)) shape-ok
                  (apply str (map max-line press-rows)) press-lines pressed-ok)
        mn (apply str (map min-line min-rows))
        pre (str base mn min-reg-lines minimize-ok)
        lines (apply str (map lock-line lock-rows))
        states (apply str (map lock-state-line lock-state-rows))
        lock-part (str pre lines states screen-lock-ok)
        so (apply str (map so-line so-rows))
        so-states (apply str (map lock-state-line so-lock-rows))
        through-sign-out (str lock-part so so-states (so-state-lines 0) sign-out-ok)
        w1 @#'guest/settings-want-1
        w2 @#'guest/settings-want-2
        s1 (str through-sign-out
                (settings-serial "AIUEOS_GUEST_BROWSER_SETTINGS_BOOT valid=0 contrast=0 scale=100 net=0\r\n" w1)
                "AIUEOS_GUEST_BROWSER_PASSKEY_REG ready=1 created=1 pub=aabbccddeeff0011\r\n")
        s1 (.replace s1 "SETTINGS_OK events=6" "SETTINGS_OK events=6")
        cycle (str "AIUEOS_GUEST_BROWSER_BACKUP_TAKE settings=1111111111111111 passkey=2222222222222222\r\n"
                   "AIUEOS_GUEST_BROWSER_BACKUP_WIPE settings-valid=0 passkey-blank=1\r\n"
                   "AIUEOS_GUEST_BROWSER_BACKUP_RESTORE settings=1111111111111111 passkey=2222222222222222 settings-valid=1 contrast=1 scale=125 net=1 pub=aabbccddeeff0011 key-signs=1\r\n"
                   "AIUEOS_GUEST_BROWSER_BACKUP_OK sectors=2 byte-for-byte\r\n")
        good (str s1 cycle)
        audio (str "AIUEOS_GUEST_BROWSER_AUDIO_REG ready=1 streams=2\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_GO events=4\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_PLAY n=1 vol=100 frames=26460 accepted=1\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_VOLUME n=1 key=457 vol=75\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_VOLUME n=2 key=456 vol=75\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_VOLUME n=3 key=457 vol=50\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_VOLUME n=4 key=456 vol=50\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_PLAY n=2 vol=50 frames=26460 accepted=1\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_OK plays=2 volumes=100,50\r\n")
        good (str s1 cycle audio)
        ;; a WAV: 44100 Hz stereo S16, each burst 0.1 s silence + 0.4 s of a 440 Hz sine at the given amplitude + 0.1 s silence
        wav (fn [amps]
              (let [rate 44100 per (* rate 0.6) n (* per (count amps)) bytes (js/Uint8Array. (+ 44 (* 4 n)))
                    put32 (fn [off v] (doseq [k (range 4)] (aset bytes (+ off k) (bit-and (js/Math.floor (/ v (js/Math.pow 256 k))) 255))))
                    put16 (fn [off v] (aset bytes off (bit-and v 255)) (aset bytes (inc off) (bit-and (bit-shift-right v 8) 255)))]
                (doseq [[o t] [[0 "RIFF"] [8 "WAVE"] [12 "fmt "] [36 "data"]]] (doseq [k (range 4)] (aset bytes (+ o k) (.charCodeAt t k))))
                (put32 4 (+ 36 (* 4 n))) (put32 16 16) (put16 20 1) (put16 22 2) (put32 24 rate) (put32 28 (* rate 4)) (put16 32 4) (put16 34 16) (put32 40 (* 4 n))
                (dotimes [i n]
                  (let [b (js/Math.floor (/ i per)) k (- i (* b per))
                        v (if (and (>= k (* rate 0.1)) (< k (* rate 0.5)))
                            (js/Math.round (* (nth amps b) 32767 (js/Math.sin (* 2 js/Math.PI 440 (/ k rate)))))
                            0)
                        u (bit-and v 65535)]
                    (put16 (+ 44 (* 4 i)) u) (put16 (+ 46 (* 4 i)) u)))
                bytes))
        run (fn [serial w] (guest/classify "guest-browser-audio" {:serial serial :wav w}))]
    (testing "two 440 Hz bursts, the second at half the level, volume keys and plays as the kernel printed them: green"
      (let [r (run good (wav [1.0 0.5]))]
        (is (= :guest-browser-audio (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "a second burst at the same level is red (the volume did not take effect)"
      (is (= :second-burst-not-at-half-level (:reason (run good (wav [1.0 1.0]))))))
    (testing "a quiet first burst is red"
      (is (= :first-burst-not-at-full-level (:reason (run good (wav [0.3 0.15]))))))
    (testing "a WAV with one burst is red"
      (is (= :wav-does-not-hold-two-bursts (:reason (run good (wav [1.0]))))))
    (testing "no WAV is red, a non-WAV is red"
      (is (= :no-wav (:reason (run good nil))))
      (is (= :not-a-wav (:reason (run good (js/Uint8Array. 100))))))
    (testing "the kernel's word alone is not enough: a wrong volume line is red"
      (is (= :volume-keys-wrong (:reason (run (.replace good "key=457 vol=50" "key=457 vol=75") (wav [1.0 0.5]))))))
    (testing "it needs the backup gate green first; no card is absent; unmeasured is exit 3"
      (is (= :no-backup (:reason (run (str s1 audio) (wav [1.0 0.5])))))
      (is (= :guest-browser-audio-absent (:reason (run (str s1 cycle) (wav [1.0 0.5])))))
      (is (= 3 (:exit (guest/classify "guest-browser-audio" {:serial good :wav (wav [1.0 0.5]) :qemu-unmeasured? true})))))))

(deftest guest-browser-suspend-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok
                  (apply str (map max-line shape-rows)) shape-ok
                  (apply str (map max-line press-rows)) press-lines pressed-ok)
        mn (apply str (map min-line min-rows))
        pre (str base mn min-reg-lines minimize-ok)
        lines (apply str (map lock-line lock-rows))
        states (apply str (map lock-state-line lock-state-rows))
        lock-part (str pre lines states screen-lock-ok)
        so (apply str (map so-line so-rows))
        so-states (apply str (map lock-state-line so-lock-rows))
        through-sign-out (str lock-part so so-states (so-state-lines 0) sign-out-ok)
        w1 @#'guest/settings-want-1
        w2 @#'guest/settings-want-2
        s1 (str through-sign-out
                (settings-serial "AIUEOS_GUEST_BROWSER_SETTINGS_BOOT valid=0 contrast=0 scale=100 net=0\r\n" w1)
                "AIUEOS_GUEST_BROWSER_PASSKEY_REG ready=1 created=1 pub=aabbccddeeff0011\r\n")
        s1 (.replace s1 "SETTINGS_OK events=6" "SETTINGS_OK events=6")
        cycle (str "AIUEOS_GUEST_BROWSER_BACKUP_TAKE settings=1111111111111111 passkey=2222222222222222\r\n"
                   "AIUEOS_GUEST_BROWSER_BACKUP_WIPE settings-valid=0 passkey-blank=1\r\n"
                   "AIUEOS_GUEST_BROWSER_BACKUP_RESTORE settings=1111111111111111 passkey=2222222222222222 settings-valid=1 contrast=1 scale=125 net=1 pub=aabbccddeeff0011 key-signs=1\r\n"
                   "AIUEOS_GUEST_BROWSER_BACKUP_OK sectors=2 byte-for-byte\r\n")
        good (str s1 cycle)
        audio (str "AIUEOS_GUEST_BROWSER_AUDIO_REG ready=1 streams=2\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_GO events=4\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_PLAY n=1 vol=100 frames=26460 accepted=1\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_VOLUME n=1 key=457 vol=75\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_VOLUME n=2 key=456 vol=75\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_VOLUME n=3 key=457 vol=50\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_VOLUME n=4 key=456 vol=50\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_PLAY n=2 vol=50 frames=26460 accepted=1\r\n"
                   "AIUEOS_GUEST_BROWSER_AUDIO_OK plays=2 volumes=100,50\r\n")
        good (str s1 cycle audio)
        ;; a WAV: 44100 Hz stereo S16, each burst 0.1 s silence + 0.4 s of a 440 Hz sine at the given amplitude + 0.1 s silence
        wav (fn [amps]
              (let [rate 44100 per (* rate 0.6) n (* per (count amps)) bytes (js/Uint8Array. (+ 44 (* 4 n)))
                    put32 (fn [off v] (doseq [k (range 4)] (aset bytes (+ off k) (bit-and (js/Math.floor (/ v (js/Math.pow 256 k))) 255))))
                    put16 (fn [off v] (aset bytes off (bit-and v 255)) (aset bytes (inc off) (bit-and (bit-shift-right v 8) 255)))]
                (doseq [[o t] [[0 "RIFF"] [8 "WAVE"] [12 "fmt "] [36 "data"]]] (doseq [k (range 4)] (aset bytes (+ o k) (.charCodeAt t k))))
                (put32 4 (+ 36 (* 4 n))) (put32 16 16) (put16 20 1) (put16 22 2) (put32 24 rate) (put32 28 (* rate 4)) (put16 32 4) (put16 34 16) (put32 40 (* 4 n))
                (dotimes [i n]
                  (let [b (js/Math.floor (/ i per)) k (- i (* b per))
                        v (if (and (>= k (* rate 0.1)) (< k (* rate 0.5)))
                            (js/Math.round (* (nth amps b) 32767 (js/Math.sin (* 2 js/Math.PI 440 (/ k rate)))))
                            0)
                        u (bit-and v 65535)]
                    (put16 (+ 44 (* 4 i)) u) (put16 (+ 46 (* 4 i)) u)))
                bytes))
        susp (str "AIUEOS_GUEST_BROWSER_SUSPEND_GO ops=86 hash=19247745 state=0badc0de\r\n"
                  "AIUEOS_GUEST_BROWSER_SUSPEND_ENTER screen=black\r\n"
                  "AIUEOS_GUEST_BROWSER_SUSPEND_RESUME ops=86 hash=19247745 state=0badc0de frame-intact=1 state-intact=1\r\n")
        ev {:before-sha "aa" :during-sha "bb" :after-sha "aa" :during-black? true :before-black? false :resume-ms 1400}
        run (fn [serial e] (guest/classify "guest-browser-suspend" {:serial serial :wav (wav [1.0 0.5]) :suspend e}))]
    (testing "black while asleep, the same screen before and after, resumed in 1.4 s: green"
      (let [r (run (str good susp) ev)]
        (is (= :guest-browser-suspend (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "a sleeping screen that is not black is red"
      (is (= :sleeping-screen-not-black (:reason (run (str good susp) (assoc ev :during-black? false))))))
    (testing "a screen after resume that differs from the one before is red"
      (is (= :screen-after-resume-differs (:reason (run (str good susp) (assoc ev :after-sha "cc"))))))
    (testing "a resume of three seconds or more is red"
      (is (= :resume-too-slow (:reason (run (str good susp) (assoc ev :resume-ms 3000))))))
    (testing "a kernel that saw its frame or state change is red"
      (is (= :frame-or-state-changed (:reason (run (str good (.replace susp "state-intact=1" "state-intact=0")) ev)))))
    (testing "an awake screen that was black is red"
      (is (= :awake-screen-was-black (:reason (run (str good susp) (assoc ev :before-black? true))))))
    (testing "no host evidence is red; the audio gate is needed; no lines is absent; unmeasured is exit 3"
      (is (= :no-host-evidence (:reason (run (str good susp) nil))))
      (is (= :no-audio (:reason (run (str s1 cycle susp) ev))))
      (is (= :guest-browser-suspend-absent (:reason (run good ev))))
      (is (= 3 (:exit (guest/classify "guest-browser-suspend" {:serial (str good susp) :wav (wav [1.0 0.5]) :suspend ev :qemu-unmeasured? true})))))))

