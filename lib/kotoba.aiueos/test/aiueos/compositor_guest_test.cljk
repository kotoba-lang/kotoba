(defn- scale-line [[n key pct vw vh win ops px h]]
  (str "AIUEOS_GUEST_BROWSER_SCALE n=" n " key=" key " pct=" pct " vw=" vw " vh=" vh " win=" win
       " ops=" ops " text-px=" px " hash=" h "\r\n"))

(def ^:private scale-ok "AIUEOS_GUEST_BROWSER_SCALE_OK events=16\r\n")

(deftest guest-browser-ui-scale-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok
                  (apply str (map max-line shape-rows)) shape-ok
                  (apply str (map max-line press-rows)) press-lines pressed-ok)
        mn (apply str (map min-line min-rows))
        pre (str base mn min-reg-lines minimize-ok)
        lines (apply str (map lock-line lock-rows))
        states (apply str (map lock-state-line lock-state-rows))
        lock-part (str pre lines states screen-lock-ok)
        so (apply str (map so-line so-rows))
        so-states (apply str (map lock-state-line so-lock-rows))
        through-sign-out (str lock-part so so-states (so-state-lines 0) sign-out-ok)
        sc (apply str (map scale-line scale-rows))
        ok (str through-sign-out sc scale-ok)
        run (fn [serial] (guest/classify "guest-browser-ui-scale" {:serial serial}))]
    (testing "scaled in two steps, held at 150, back to 100 and restored: green"
      (let [r (run ok)]
        (is (= :guest-browser-ui-scale (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "a window that leaves the viewport is red (and so is anything the model does not say)"
      (is (= :ui-scale-differs-from-model
             (:reason (run (.replace ok "pct=150 vw=853 vh=533 win=0,28,853,505" "pct=150 vw=853 vh=533 win=0,28,1024,612"))))))
    (testing "a scale that did not change the frame is red"
      (is (= :ui-scale-differs-from-model
             (:reason (run (.replace ok "pct=125 vw=1024 vh=640 win=0,28,1024,612 ops=70 text-px=1536" "pct=125 vw=1024 vh=640 win=0,28,1024,612 ops=70 text-px=582"))))))
    (testing "a fourth step past 150 would be red"
      (is (= :ui-scale-differs-from-model
             (:reason (run (.replace ok "n=8 key=53 pct=150 vw=853" "n=8 key=53 pct=175 vw=731"))))))
    (testing "it needs the sign-out gate green first"
      (is (= :no-sign-out (:reason (run (str sc scale-ok))))))
    (testing "the OK line missing is not green, no lines is absent, unmeasured is exit 3"
      (is (= :ui-scale-ok-missing (:reason (run (str through-sign-out sc)))))
      (is (= :guest-browser-ui-scale-absent (:reason (run (str through-sign-out scale-ok)))))
      (is (= 3 (:exit (guest/classify "guest-browser-ui-scale" {:serial ok :qemu-unmeasured? true})))))))

