  "AIUEOS_GUEST_BROWSER_CLIPBOARD_OK events=22 requests=4 admitted=3 refused=1 copied=3 pasted=3,3 clip=3 body=51 focus=4 chain=9098b95f sel-chain=356612c5 ops=218 text-px=1080 hash=76577905\r\n")

(deftest guest-browser-clipboard-classifier
  (testing "twenty-two frames, four requests, three admitted, one refused: green"
    (let [r (guest/classify "guest-browser-clipboard"
                            {:serial (str cursor-ok-line focus-ok scroll-lines scroll-ok selection-lines selection-ok
                                          clipboard-lines clipboard-ok)})]
      (is (= :guest-browser-clipboard (:reason r)))
      (is (= 0 (:exit r)))
      (is (= [:text-only-clipboard :no-other-ctrl-shortcuts :no-clipboard-in-a-composition
              :grant-set-by-the-stage :no-host-clipboard]
             (:leftover r)))))
  (testing "the clipboard needs the selection stage first"
    (is (= :no-selection
           (:reason (guest/classify "guest-browser-clipboard"
                                    {:serial (str cursor-ok-line focus-ok scroll-lines scroll-ok
                                                  clipboard-lines clipboard-ok)})))))
  (testing "an OK line with a frame line missing is not green"
    (is (= :clipboard-lines-missing
           (:reason (guest/classify "guest-browser-clipboard"
                                    {:serial (str cursor-ok-line focus-ok scroll-lines scroll-ok selection-lines selection-ok
                                                  (.replace clipboard-lines "FRAME n=22 " "FRAME n=77 ")
                                                  clipboard-ok)})))))
  (testing "an OK line naming a different broker count is not green"
    (is (= :guest-browser-clipboard-absent
           (:reason (guest/classify "guest-browser-clipboard"
                                    {:serial (str cursor-ok-line focus-ok scroll-lines scroll-ok selection-lines selection-ok
                                                  clipboard-lines
                                                  (.replace clipboard-ok "admitted=3 refused=1" "admitted=4 refused=0"))})))))
  (testing "a census that misses is red, by name (the object before ADR-0241 types C and V)"
    (is (= :census-miss
           (:reason (guest/classify "guest-browser-clipboard"
                                    {:serial (str cursor-ok-line focus-ok scroll-lines scroll-ok selection-lines selection-ok
                                                  "AIUEOS_GUEST_BROWSER_CLIPBOARD leftover=census-miss off=13 chain=7137f641 sel-chain=c20c1401 requests=0 admitted=0 clip=0 ctrl=0\r\n")})))))
  (testing "missing events are red, by name"
    (is (= :events-missing
           (:reason (guest/classify "guest-browser-clipboard"
                                    {:serial (str cursor-ok-line focus-ok scroll-lines scroll-ok selection-lines selection-ok
                                                  "AIUEOS_GUEST_BROWSER_CLIPBOARD leftover=events-missing events=9 frames=9\r\n")})))))
  (testing "the selection's OK line alone is not the clipboard"
    (is (= :guest-browser-clipboard-absent
           (:reason (guest/classify "guest-browser-clipboard"
                                    {:serial (str cursor-ok-line focus-ok scroll-lines scroll-ok selection-lines selection-ok)})))))
  (testing "unanswered QEMU is exit 3"
    (is (= 3 (:exit (guest/classify "guest-browser-clipboard" {:qemu-unmeasured? true})))))
  (testing "tablet profile, with the selection's wall clock and more"
    (is (= {"AIUEOS_GUEST_BROWSER" "1" "AIUEOS_QEMU_TIMEOUT" "3000"} (guest/extra-env "guest-browser-clipboard")))))

;; Guest browser damage (ADR-0242). The lines are the serial of the first boot
;; of these sources to reach the stage (QEMU tcg + OVMF, 2026-09-26); their
;; rectangles and censuses are the frame model's damage frames.

(def ^:private damage-lines
  (str
       "AIUEOS_GUEST_BROWSER_DAMAGE_GO events=5\r\n"
       "AIUEOS_GUEST_BROWSER_DAMAGE_FRAME n=1 src=3 key=0 answer=0 focus=4 ops=218 text-px=1080 hash=362c4193 damage=300,300,32,22 bytes=2816\r\n"
       "AIUEOS_GUEST_BROWSER_DAMAGE_FULL n=1 shown=whole\r\n"
       "AIUEOS_GUEST_BROWSER_DAMAGE_FRAME n=2 src=0 key=225 answer=0 focus=4 ops=218 text-px=1080 hash=362c4193 damage=0,0,0,0 bytes=0\r\n"
       "AIUEOS_GUEST_BROWSER_DAMAGE_FULL n=2 shown=whole\r\n"
       "AIUEOS_GUEST_BROWSER_DAMAGE_FRAME n=3 src=0 key=61 answer=1 focus=1 ops=219 text-px=2330 hash=5581e21a damage=80,80,652,716 bytes=1867328\r\n"
       "AIUEOS_GUEST_BROWSER_DAMAGE_FULL n=3 shown=whole\r\n"
       "AIUEOS_GUEST_BROWSER_DAMAGE_FRAME n=4 src=0 key=60 answer=0 focus=1 ops=219 text-px=2330 hash=5581e21a damage=0,0,0,0 bytes=0\r\n"
       "AIUEOS_GUEST_BROWSER_DAMAGE_FULL n=4 shown=whole\r\n"
       "AIUEOS_GUEST_BROWSER_DAMAGE_FRAME n=5 src=0 key=224 answer=0 focus=1 ops=219 text-px=2330 hash=5581e21a damage=0,0,0,0 bytes=0\r\n"
       "AIUEOS_GUEST_BROWSER_DAMAGE_FULL n=5 shown=whole\r\n"
       "AIUEOS_GUEST_BROWSER_DAMAGE_RUN shows=110 partial=66 empty=43 whole=1 refused=0 bytes=34076936 whole-bytes=450560000\r\n"))

(def ^:private damage-ok
  "AIUEOS_GUEST_BROWSER_DAMAGE_OK events=5 partial=2 empty=3 bytes=1870144 whole-bytes=20480000 focus=1 chain=6653b143 ops=219 text-px=2330 hash=5581e21a\r\n")

(defn- shots
  "Five frames' screendumps: damage digest = whole-screen digest unless
  `differs`, frame 3 onward raised unless `still`."
  [& {:keys [differs still stale]}]
  (mapv (fn [n]
          (let [d (if (and (not still) (>= n 3)) "17ef" "f91a")
                s {:fresh? (not= n stale) :header-ok? true :digest d}]
            {:damage (if (= n differs) (assoc s :digest "aa2f") s) :full s}))
        (range 1 6)))

(defn- damage-serial [& more]
  (apply str cursor-ok-line focus-ok scroll-lines scroll-ok selection-lines selection-ok
         clipboard-lines clipboard-ok more))

(deftest guest-browser-damage-classifier
  (testing "five frames, their rectangles, every damage screendump its whole screen: green"
    (let [r (guest/classify "guest-browser-damage"
                            {:serial (damage-serial damage-lines damage-ok) :damage-shots (shots)})]
      (is (= :guest-browser-damage (:reason r)))
      (is (= 0 (:exit r)))
      (is (= [:one-rectangle-per-frame :slot-by-slot-not-smallest :no-vsync-or-fence :tcg-only]
             (:leftover r)))))
  (testing "the damage needs the clipboard stage first"
    (is (= :no-clipboard
           (:reason (guest/classify "guest-browser-damage"
                                    {:serial (str cursor-ok-line focus-ok scroll-lines scroll-ok selection-lines selection-ok
                                                  damage-lines damage-ok)
                                     :damage-shots (shots)})))))
  (testing "a damage screendump that is not its whole screen is red, by name (h - 1 transferred)"
    (is (= :display-differs
           (:reason (guest/classify "guest-browser-damage"
                                    {:serial (damage-serial damage-lines damage-ok) :damage-shots (shots :differs 3)})))))
  (testing "a raise the display never showed is red"
    (is (= :display-still
           (:reason (guest/classify "guest-browser-damage"
                                    {:serial (damage-serial damage-lines damage-ok) :damage-shots (shots :still true)})))))
  (testing "a screendump older than the boot is not measured, not a pass"
    (let [r (guest/classify "guest-browser-damage"
                            {:serial (damage-serial damage-lines damage-ok) :damage-shots (shots :stale 4)})]
      (is (= :display-unmeasured (:reason r)))
      (is (= 3 (:exit r)))))
  (testing "no screendumps at all is not measured"
    (is (= 3 (:exit (guest/classify "guest-browser-damage"
                                    {:serial (damage-serial damage-lines damage-ok) :damage-shots nil})))))
  (testing "a rectangle that is not the model's is not green"
    (is (= :damage-lines-missing
           (:reason (guest/classify "guest-browser-damage"
                                    {:serial (damage-serial (.replace damage-lines "damage=80,80,652,716" "damage=0,0,1280,800")
                                                            damage-ok)
                                     :damage-shots (shots)})))))
  (testing "an OK line naming different bytes is not green"
    (is (= :guest-browser-damage-absent
           (:reason (guest/classify "guest-browser-damage"
                                    {:serial (damage-serial damage-lines (.replace damage-ok "bytes=1870144" "bytes=20480000"))
                                     :damage-shots (shots)})))))
  (testing "the clipboard's OK line alone is not the damage"
    (is (= :guest-browser-damage-absent
           (:reason (guest/classify "guest-browser-damage" {:serial (damage-serial) :damage-shots (shots)})))))
  (testing "unanswered QEMU is exit 3"
    (is (= 3 (:exit (guest/classify "guest-browser-damage" {:qemu-unmeasured? true})))))
  (testing "tablet profile, with the clipboard's wall clock and more"
    (is (= {"AIUEOS_GUEST_BROWSER" "1" "AIUEOS_QEMU_TIMEOUT" "3300"} (guest/extra-env "guest-browser-damage")))))

(def ^:private hot-lines
  (apply str
         (concat (map (fn [n] (str "AIUEOS_GUEST_BROWSER_HOT stage=cursor n=" n " hot=0\r\n")) (range 1 6))
                 (map (fn [n] (str "AIUEOS_GUEST_BROWSER_HOT stage=focus n=" n " hot=1\r\n")) (range 1 13))
                 (map (fn [n] (str "AIUEOS_GUEST_BROWSER_HOT stage=scroll n=" n " hot=" (if (<= n 3) 1 0) "\r\n"))
                      (range 1 18)))))

(deftest guest-browser-hover-classifier
  (let [base (str cursor-ok-line focus-ok scroll-lines scroll-ok)]
    (testing "none over the background, one over button 2, one over button 4 until the pointer leaves: green"
      (let [r (guest/classify "guest-browser-hover" {:serial (str base hot-lines)})]
        (is (= :guest-browser-hover (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "a control that stays hot after the pointer left is red, and says where"
      (let [r (guest/classify "guest-browser-hover"
                              {:serial (str base (.replace hot-lines "stage=scroll n=9 hot=0" "stage=scroll n=9 hot=1"))})]
        (is (= :hover-differs-from-model (:reason r)))
        (is (= ["scroll" 9 1] (:kernel (:first-difference r))))))
    (testing "a hot control where the pointer never was is red"
      (is (= :hover-differs-from-model
             (:reason (guest/classify "guest-browser-hover"
                                      {:serial (str base (.replace hot-lines "stage=cursor n=2 hot=0" "stage=cursor n=2 hot=1"))})))))
    (testing "a missing frame is red"
      (is (= :hover-differs-from-model
             (:reason (guest/classify "guest-browser-hover"
                                      {:serial (str base (.replace hot-lines "stage=focus n=12 " "stage=focus n=120 "))})))))
    (testing "no hot lines is absent, not green"
      (is (= :guest-browser-hover-absent (:reason (guest/classify "guest-browser-hover" {:serial base})))))
    (testing "it needs the scroll gate green first"
      (is (= :no-scroll (:reason (guest/classify "guest-browser-hover" {:serial (str cursor-ok-line hot-lines)})))))
    (testing "an unmeasured boot is exit 3"
      (is (= 3 (:exit (guest/classify "guest-browser-hover" {:serial base :qemu-unmeasured? true})))))))

(def ^:private hc-lines
  (str "AIUEOS_GUEST_BROWSER_HC n=1 mode=1 bg=00ffffff ink=00000000 bars=00ffffff,00d0d0d0,00ffd400 ops=219 text-px=2330 hash=5581e21a\r\n"
       "AIUEOS_GUEST_BROWSER_HC n=2 mode=1 bg=00ffffff ink=00000000 bars=00ffffff,00d0d0d0,00ffd400 ops=219 text-px=2330 hash=5581e21a\r\n"
       "AIUEOS_GUEST_BROWSER_HC n=3 mode=0 bg=00f1f1f2 ink=00333333 bars=00f1f1f2,00e6e6e6,00cccccc ops=219 text-px=2330 hash=5581e21a\r\n"
       "AIUEOS_GUEST_BROWSER_HC n=4 mode=0 bg=00f1f1f2 ink=00333333 bars=00f1f1f2,00e6e6e6,00cccccc ops=219 text-px=2330 hash=5581e21a\r\n"))

(def ^:private hc-ok
  "AIUEOS_GUEST_BROWSER_UIUX_OK events=4 palette=default-high-contrast-default\r\n")

(deftest guest-browser-contrast-arithmetic
  (testing "WCAG 2 contrast ratios: black on white is 21:1, white on white 1:1"
    (is (< (js/Math.abs (- 21.0 (guest/contrast-ratio 0x000000 0xffffff))) 1e-9))
    (is (< (js/Math.abs (- 1.0 (guest/contrast-ratio 0xffffff 0xffffff))) 1e-9)))
  (testing "the high-contrast pairs are well above 7:1; the default pair is above it too, by less"
    (is (>= (guest/contrast-ratio 0x000000 0xffd400) 14.6))
    (is (>= (guest/contrast-ratio 0x000000 0xd0d0d0) 13.6))
    (is (>= (guest/contrast-ratio 0x000000 0xe0e0e0) 15.9))
    (is (> (guest/contrast-ratio 0x333333 0xcccccc) 7.0))
    (is (< (guest/contrast-ratio 0x333333 0xcccccc) 8.0))))

(deftest guest-browser-high-contrast-classifier
  (let [base damage-ok]
    (testing "palette on, off, with the model's colours and every ratio >= 7: green"
      (let [r (guest/classify "guest-browser-high-contrast" {:serial (str base hc-lines hc-ok)})]
        (is (= :guest-browser-high-contrast (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "a palette whose ink is too close to the titlebar is red, by the ratio and not by a list"
      (let [bad (.replace hc-lines "bars=00ffffff,00d0d0d0,00ffd400" "bars=00ffffff,00d0d0d0,00202020")
            r (guest/classify "guest-browser-high-contrast" {:serial (str base bad hc-ok)})]
        (is (= :contrast-below-7 (:reason r)))))
    (testing "the palette staying on after the second F10 is red, and says where"
      (let [r (guest/classify "guest-browser-high-contrast"
                              {:serial (str base (.replace hc-lines "HC n=4 mode=0 bg=00f1f1f2 ink=00333333 bars=00f1f1f2,00e6e6e6,00cccccc"
                                                           "HC n=4 mode=1 bg=00ffffff ink=00000000 bars=00ffffff,00d0d0d0,00ffd400") hc-ok)})]
        (is (= :hc-differs-from-model (:reason r)))
        (is (= 4 (:n (:kernel (:first-difference r)))))))
    (testing "the OK line missing is not green"
      (is (= :uiux-ok-missing (:reason (guest/classify "guest-browser-high-contrast" {:serial (str base hc-lines)})))))
    (testing "no HC lines is absent"
      (is (= :guest-browser-high-contrast-absent (:reason (guest/classify "guest-browser-high-contrast" {:serial base})))))
    (testing "it needs the damage gate first"
      (is (= :no-damage (:reason (guest/classify "guest-browser-high-contrast" {:serial (str hc-lines hc-ok)})))))
    (testing "an unmeasured boot is exit 3"
      (is (= 3 (:exit (guest/classify "guest-browser-high-contrast" {:serial base :qemu-unmeasured? true})))))))

(def ^:private key-rows
  ;; n key answer reduce ring windows focus stack at ops text-px hash
  [[5 257 0 "none" 1 4 1 "3241" "4,0" 223 2330 "5581e21a"]
   [6 256 0 "none" 1 4 1 "3241" "4,0" 223 2330 "5581e21a"]
   [7 257 0 "none" 2 4 1 "3241" "106,0" 223 2330 "5581e21a"]
   [8 256 0 "none" 2 4 1 "3241" "106,0" 223 2330 "5581e21a"]
   [9 169 0 "none" 2 4 1 "3241" "106,0" 223 2330 "5581e21a"]
   [10 257 0 "none" 1 4 1 "3241" "4,0" 223 2330 "5581e21a"]
   [11 256 0 "none" 1 4 1 "3241" "4,0" 223 2330 "5581e21a"]
   [12 168 0 "none" 1 4 1 "3241" "4,0" 223 2330 "5581e21a"]
   [13 257 0 "none" 2 4 1 "3241" "106,0" 223 2330 "5581e21a"]
   [14 256 0 "none" 2 4 1 "3241" "106,0" 223 2330 "5581e21a"]
   [15 113 385038 "2" 2 4 2 "3412" "106,0" 223 1209 "fc93d38d"]
   [16 112 0 "none" 2 4 2 "3412" "106,0" 223 1209 "fc93d38d"]
   [17 5 1261662 "1" 2 3 1 "341" "106,0" 192 2330 "5581e21a"]
   [18 4 0 "none" 2 3 1 "341" "106,0" 192 2330 "5581e21a"]])

(defn- key-line [[n key ans red ring win foc stack at ops px hash] & {:keys [ringc] :or {ringc "001a56db"}}]
  (str "AIUEOS_GUEST_BROWSER_KEY n=" n " key=" key " answer=" ans " reduce=" red " ring=" ring
       " windows=" win " focus=" foc " stack=" stack " rings=4 at=" at " ringc=" ringc
       " bar=00f1f1f2 face=00e6e6e6 ops=" ops " text-px=" px " hash=" hash "\r\n"))

(def ^:private key-lines-ok (apply str (map key-line key-rows)))
(def ^:private keys-ok
  "AIUEOS_GUEST_BROWSER_KEYS_OK events=18 ring=2 stack=341 focus=1\r\n")

(deftest guest-browser-focus-ring-classifier
  (testing "the ring on button 1, 2, back to 1 with Shift, 2, with the model's censuses and contrast >= 3: green"
    (let [r (guest/classify "guest-browser-focus-ring" {:serial (str key-lines-ok keys-ok)})]
      (is (= :guest-browser-focus-ring (:reason r)))
      (is (= 0 (:exit r)))))
  (testing "Shift+F6 that does not go back (the ring stays on 2) is red, and says which frame"
    (let [bad (assoc-in (vec key-rows) [5 4] 2)
          r (guest/classify "guest-browser-focus-ring"
                            {:serial (str (apply str (map key-line bad)) keys-ok)})]
      (is (= :guest-browser-focus-ring-differs-from-model (:reason r)))
      (is (= 10 (:n (:kernel (:first-difference r)))))))
  (testing "a ring drawn at the wrong control is red"
    (let [bad (assoc-in (vec key-rows) [2 8] "4,0")]
      (is (= :guest-browser-focus-ring-differs-from-model
             (:reason (guest/classify "guest-browser-focus-ring"
                                      {:serial (str (apply str (map key-line bad)) keys-ok)}))))))
  (testing "a ring whose colour is too close to the launcher bar is red by the ratio"
    (let [lines (apply str (map #(key-line % :ringc "00e8e8e8") key-rows))
          r (guest/classify "guest-browser-focus-ring" {:serial (str lines keys-ok)})]
      (is (= :ring-contrast-below-3 (:reason r)))))
  (testing "the OK line missing is not green"
    (is (= :keys-ok-missing (:reason (guest/classify "guest-browser-focus-ring" {:serial key-lines-ok})))))
  (testing "no key lines is absent"
    (is (= :guest-browser-focus-ring-absent (:reason (guest/classify "guest-browser-focus-ring" {:serial keys-ok})))))
  (testing "an unmeasured boot is exit 3"
    (is (= 3 (:exit (guest/classify "guest-browser-focus-ring" {:serial (str key-lines-ok keys-ok) :qemu-unmeasured? true}))))))

(deftest guest-browser-keyboard-activate-classifier
  (testing "Enter presses button 2 (window 2 raised, focused), Escape closes it (the one on top focused): green"
    (let [r (guest/classify "guest-browser-keyboard-activate" {:serial (str key-lines-ok keys-ok)})]
      (is (= :guest-browser-keyboard-activate (:reason r)))
      (is (= 0 (:exit r)))))
  (testing "Enter that does nothing (the stack and focus unchanged) is red, and says which frame"
    (let [bad (-> (vec key-rows) (assoc-in [10 6] 1) (assoc-in [10 7] "3241") (assoc-in [10 3] "none"))
          r (guest/classify "guest-browser-keyboard-activate"
                            {:serial (str (apply str (map key-line bad)) keys-ok)})]
      (is (= :guest-browser-keyboard-activate-differs-from-model (:reason r)))
      (is (= 15 (:n (:kernel (:first-difference r)))))))
  (testing "Escape that leaves four windows is red"
    (let [bad (-> (vec key-rows) (assoc-in [12 5] 4) (assoc-in [12 7] "3412"))]
      (is (= :guest-browser-keyboard-activate-differs-from-model
             (:reason (guest/classify "guest-browser-keyboard-activate"
                                      {:serial (str (apply str (map key-line bad)) keys-ok)}))))))
  (testing "the keyboard answering with a different press than the pointer's is red"
    (let [bad (assoc-in (vec key-rows) [10 2] 385039)]
      (is (= :guest-browser-keyboard-activate-differs-from-model
             (:reason (guest/classify "guest-browser-keyboard-activate"
                                      {:serial (str (apply str (map key-line bad)) keys-ok)}))))))
  (testing "no key lines is absent, and an unmeasured boot is exit 3"
    (is (= :guest-browser-keyboard-activate-absent
           (:reason (guest/classify "guest-browser-keyboard-activate" {:serial keys-ok}))))
    (is (= 3 (:exit (guest/classify "guest-browser-keyboard-activate"
                                    {:serial (str key-lines-ok keys-ok) :qemu-unmeasured? true}))))))

(def ^:private max-rows
  ;; n src at reduce rect ops text-px hash
  [[19 1 "380,142" 1 "272,132,240,200" 192 2330 "e5cb1929"]
   [20 4 "380,142" 0 "272,132,240,200" 192 2330 "e5cb1929"]
   [21 1 "380,142" 1 "0,28,1280,720" 191 1699 "3b18fc9c"]
   [22 4 "380,142" 0 "0,28,1280,720" 191 1699 "3b18fc9c"]
   [23 1 "380,40" 1 "0,28,1280,720" 191 1699 "71c4138e"]
   [24 4 "380,40" 0 "0,28,1280,720" 191 1699 "71c4138e"]
   [25 1 "380,40" 1 "272,132,240,200" 192 2330 "b4362763"]
   [26 4 "380,40" 0 "272,132,240,200" 192 2330 "b4362763"]])

(defn- max-line [[n src at red rect ops px hash]]
  (str "AIUEOS_GUEST_BROWSER_MAX n=" n " src=" src " at=" at " reduce=" red
       " windows=3 focus=1 stack=341 rect=" rect " ops=" ops " text-px=" px " hash=" hash "\r\n"))

(def ^:private max-ok
  "AIUEOS_GUEST_BROWSER_MAX_OK events=8 maximized=0,28,1280,720 restored=272,132,240,200\r\n")

(deftest guest-browser-window-maximize-classifier
  (let [ok (str (apply str (map max-line max-rows)) max-ok)]
    (testing "a double press maximizes, a second restores the exact rect: green"
      (let [r (guest/classify "guest-browser-window-maximize" {:serial ok})]
        (is (= :guest-browser-window-maximize (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "a second press that does not maximize is red, and says which frame"
      (let [bad (assoc-in (vec max-rows) [2 4] "272,132,240,200")
            r (guest/classify "guest-browser-window-maximize"
                              {:serial (str (apply str (map max-line bad)) max-ok)})]
        (is (= :window-maximize-differs-from-model (:reason r)))
        (is (= 21 (:n (:kernel (:first-difference r)))))))
    (testing "a restore to a different rect is red even if the list matches itself"
      (let [bad (-> (vec max-rows) (assoc-in [6 4] "272,133,240,200") (assoc-in [7 4] "272,133,240,200"))]
        (is (not (:green? (guest/classify "guest-browser-window-maximize"
                                          {:serial (str (apply str (map max-line bad)) max-ok)}))))))
    (testing "the OK line missing is not green"
      (is (= :max-ok-missing (:reason (guest/classify "guest-browser-window-maximize"
                                                      {:serial (apply str (map max-line max-rows))})))))
    (testing "no MAX lines is absent, and an unmeasured boot is exit 3"
      (is (= :guest-browser-window-maximize-absent
             (:reason (guest/classify "guest-browser-window-maximize" {:serial max-ok}))))
      (is (= 3 (:exit (guest/classify "guest-browser-window-maximize" {:serial ok :qemu-unmeasured? true})))))))

(def ^:private ctl-rows
  [[27 1 "476,146" 1 "0,28,1280,720" 191 1699 "2eebb0d8"]
   [28 4 "476,146" 0 "0,28,1280,720" 191 1699 "2eebb0d8"]
   [29 0 "476,146" 1 "272,132,240,200" 192 2330 "7c707d0d"]
   [30 0 "476,146" "none" "272,132,240,200" 192 2330 "7c707d0d"]])

(def ^:private ctl-ok
  "AIUEOS_GUEST_BROWSER_MAX_CTL_OK events=4 control=press f11=restore\r\n")

(deftest guest-browser-maximize-control-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok)
        ctl (apply str (map max-line ctl-rows))
        ok (str base ctl ctl-ok)]
    (testing "a press on the control maximizes, F11 restores the exact rect: green"
      (let [r (guest/classify "guest-browser-maximize-control" {:serial ok})]
        (is (= :guest-browser-maximize-control (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "a control press that does not maximize is red, and says which frame"
      (let [bad (assoc-in (vec ctl-rows) [0 4] "272,132,240,200")
            r (guest/classify "guest-browser-maximize-control"
                              {:serial (str base (apply str (map max-line bad)) ctl-ok)})]
        (is (= :maximize-control-differs-from-model (:reason r)))
        (is (= 27 (:n (:kernel (:first-difference r)))))))
    (testing "an F11 that restores to another rect is red"
      (let [bad (-> (vec ctl-rows) (assoc-in [2 4] "272,133,240,200") (assoc-in [3 4] "272,133,240,200"))]
        (is (not (:green? (guest/classify "guest-browser-maximize-control"
                                          {:serial (str base (apply str (map max-line bad)) ctl-ok)}))))))
    (testing "it needs the double-press gate green first"
      (is (= :no-window-maximize
             (:reason (guest/classify "guest-browser-maximize-control" {:serial (str ctl ctl-ok)})))))
    (testing "the OK line missing is not green, no lines is absent, unmeasured is exit 3"
      (is (= :max-ctl-ok-missing (:reason (guest/classify "guest-browser-maximize-control" {:serial (str base ctl)}))))
      (is (= :guest-browser-maximize-control-absent
             (:reason (guest/classify "guest-browser-maximize-control" {:serial (str base ctl-ok)}))))
      (is (= 3 (:exit (guest/classify "guest-browser-maximize-control" {:serial ok :qemu-unmeasured? true})))))))

(def ^:private shape-rows
  [[31 3 "500,320" 0 "272,132,240,200" 185 2343 "c2fbd1ab"]
   [32 3 "380,142" 0 "272,132,240,200" 192 2330 "e5cb1929"]])

(def ^:private shape-ok
  "AIUEOS_GUEST_BROWSER_CURSOR_SHAPE_OK events=2 handle=resize away=arrow\r\n")

(deftest guest-browser-cursor-shape-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok)
        shape (apply str (map max-line shape-rows))
        ok (str base shape shape-ok)]
    (testing "the resize cursor over the handle and the arrow back: green"
      (let [r (guest/classify "guest-browser-cursor-shape" {:serial ok})]
        (is (= :guest-browser-cursor-shape (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "the double-press and control gates still read their own lines with the shape lines present"
      (is (= :guest-browser-maximize-control (:reason (guest/classify "guest-browser-maximize-control" {:serial ok})))))
    (testing "a pointer that stays an arrow over the handle is red, and says which frame"
      (let [bad (assoc-in (vec shape-rows) [0 5] 186)
            bad (assoc-in bad [0 6] 2330)
            bad (assoc-in bad [0 7] "e5cb1929")
            r (guest/classify "guest-browser-cursor-shape" {:serial (str base (apply str (map max-line bad)) shape-ok)})]
        (is (= :cursor-shape-differs-from-model (:reason r)))
        (is (= 31 (:n (:kernel (:first-difference r)))))))
    (testing "a pointer that does not go back to the arrow is red even if both lines agree with each other"
      (let [bad (-> (vec shape-rows) (assoc-in [1 5] 179) (assoc-in [1 6] 2343) (assoc-in [1 7] "c2fbd1ab"))]
        (is (not (:green? (guest/classify "guest-browser-cursor-shape"
                                          {:serial (str base (apply str (map max-line bad)) shape-ok)}))))))
    (testing "it needs the maximize-control gate green first"
      (is (= :no-maximize-control (:reason (guest/classify "guest-browser-cursor-shape" {:serial (str shape shape-ok)})))))
    (testing "the OK line missing is not green, no lines is absent, unmeasured is exit 3"
      (is (= :cursor-shape-ok-missing (:reason (guest/classify "guest-browser-cursor-shape" {:serial (str base shape)}))))
      (is (= :guest-browser-cursor-shape-absent (:reason (guest/classify "guest-browser-cursor-shape" {:serial (str base shape-ok)}))))
      (is (= 3 (:exit (guest/classify "guest-browser-cursor-shape" {:serial ok :qemu-unmeasured? true})))))))

(def ^:private press-rows
  [[33 1 "54,14" 1 "272,132,240,200" 192 2322 "d3d22b31"]
   [34 4 "54,14" 0 "272,132,240,200" 192 2322 "d3d22b31"]])

(def ^:private press-lines
  "AIUEOS_GUEST_BROWSER_PRESS n=33 pressed=1 hot=0\r\nAIUEOS_GUEST_BROWSER_PRESS n=34 pressed=0 hot=1\r\n")

(def ^:private pressed-ok
  "AIUEOS_GUEST_BROWSER_PRESSED_OK events=2 down=pressed up=hot\r\n")

(deftest guest-browser-pressed-state-classifier
  (let [base (str (apply str (map max-line max-rows)) max-ok (apply str (map max-line ctl-rows)) ctl-ok
                  (apply str (map max-line shape-rows)) shape-ok)
        mx (apply str (map max-line press-rows))
        ok (str base mx press-lines pressed-ok)]
    (testing "pressed while down, hot after: green"
      (let [r (guest/classify "guest-browser-pressed-state" {:serial ok})]
        (is (= :guest-browser-pressed-state (:reason r)))
        (is (= 0 (:exit r)))))
    (testing "the earlier gates still read their own lines with the press lines present"
      (is (= :guest-browser-cursor-shape (:reason (guest/classify "guest-browser-cursor-shape" {:serial ok})))))
    (testing "a control that is not pressed while the button is down is red, and says which frame"
      (let [r (guest/classify "guest-browser-pressed-state"
                              {:serial (str base mx (.replace press-lines "n=33 pressed=1 hot=0" "n=33 pressed=0 hot=1") pressed-ok)})]
        (is (= :pressed-colour-differs-from-model (:reason r)))
        (is (= 33 (first (:kernel (:first-difference r)))))))
    (testing "a control that stays pressed after the release is red"
      (is (= :pressed-colour-differs-from-model
             (:reason (guest/classify "guest-browser-pressed-state"
                                      {:serial (str base mx (.replace press-lines "n=34 pressed=0 hot=1" "n=34 pressed=1 hot=0") pressed-ok)})))))
    (testing "a press that changes the window state off the model is red"
      (let [bad (assoc-in (vec press-rows) [0 4] "0,28,1280,720")]
        (is (= :pressed-state-differs-from-model
               (:reason (guest/classify "guest-browser-pressed-state"
                                        {:serial (str base (apply str (map max-line bad)) press-lines pressed-ok)}))))))
    (testing "it needs the cursor-shape gate green first"
      (is (= :no-cursor-shape (:reason (guest/classify "guest-browser-pressed-state" {:serial (str mx press-lines pressed-ok)})))))
    (testing "the OK line missing is not green, no lines is absent, unmeasured is exit 3"
      (is (= :pressed-ok-missing (:reason (guest/classify "guest-browser-pressed-state" {:serial (str base mx press-lines)}))))
      (is (= :guest-browser-pressed-state-absent (:reason (guest/classify "guest-browser-pressed-state" {:serial (str base pressed-ok)}))))
      (is (= 3 (:exit (guest/classify "guest-browser-pressed-state" {:serial ok :qemu-unmeasured? true})))))))

