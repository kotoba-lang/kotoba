(ns aiueos.office-journal-probe-test
  (:export [main])
  (:require [aiueos.native.office-journal-probe :as journal]))

;; Only the dedicated synthetic disk, fresh QEMU pool and owned pages.
(defn- fill [p :i64 length :i64 seed :i64 i :i64] :i64
  (if (= i length) 1
    (let [w (kernel-store-u8-64k p 65536 i (bit-and (+ (* i 17) seed) 255))]
      (fill p length seed (+ i 1)))))
(defn- valid [p :i64 length :i64 seed :i64 i :i64] :bool
  (if (= i length) true
    (and (= (kernel-load-u8-64k p 65536 i) (bit-and (+ (* i 17) seed) 255))
         (valid p length seed (+ i 1)))))
(defn- saved? [app :i64 rev :i64 len :i64 seed :i64 data :i64 page :i64 scratch :i64 work :i64] :bool
  (let [r (journal/load app data page scratch work)]
    (and (= r rev) (= (kernel-load-u64-4k work 4096 96) len)
         (valid data len seed 0))))
(defn main [] :i64
  (let [off (kernel-cli) pool (kernel-application-pool)
        data (kernel-subregion pool 8388608 0 65536)
        readbuf (kernel-subregion pool 8388608 65536 65536)
        receipt (kernel-owned-page 0)
        page (kernel-subregion (kernel-owned-page 1) 4096 0 512)
        scratch (kernel-subregion (kernel-owned-page 2) 4096 0 512)
        work (kernel-owned-page 3)
        rev (journal/load 1 readbuf page scratch work)
        phase (cond (= rev 0) 1 (= rev 1) 2 (= rev 2) 3 :else 4)
        outcome
          (cond
            (= phase 1)
              (let [a (fill data 35000 19 0)
                    saved (journal/save 1 data 35000 0 readbuf page scratch work)
                    b (fill data 701 31 0)
                    other (journal/save 2 data 701 0 readbuf page scratch work)
                    c (fill data 1025 47 0)
                    third (journal/save 3 data 1025 0 readbuf page scratch work)]
                (and (= saved 1) (= other 1) (= third 1)
                     (saved? 1 1 35000 19 readbuf page scratch work)
                     (saved? 2 1 701 31 readbuf page scratch work)
                     (saved? 3 1 1025 47 readbuf page scratch work)))
            (= phase 2)
              (let [old (saved? 1 1 35000 19 readbuf page scratch work)
                    a (fill data 34068 79 0)
                    stale (journal/save 1 data 34068 0 readbuf page scratch work)
                    saved (journal/save 1 data 34068 1 readbuf page scratch work)]
                (and old (= stale 0) (= saved 1)
                     (saved? 1 2 34068 79 readbuf page scratch work)
                     (saved? 2 1 701 31 readbuf page scratch work)
                     (saved? 3 1 1025 47 readbuf page scratch work)))
            (= phase 3)
              (and (saved? 1 2 34068 79 readbuf page scratch work)
                   (saved? 2 1 701 31 readbuf page scratch work)
                   (saved? 3 1 1025 47 readbuf page scratch work))
            :else (= rev -1))
        x (kernel-store-u64-4k receipt 4096 8 phase)
        y (kernel-store-u64-4k receipt 4096 16 (if outcome 1 0))
        done (kernel-store-u64-4k receipt 4096 0 0x314c4e52554f4a4f)]
    (loop [spin 0] (let [pause (kernel-pause)] (recur (+ spin 1))))))
