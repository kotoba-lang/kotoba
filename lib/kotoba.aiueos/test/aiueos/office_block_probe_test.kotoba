(ns aiueos.office-block-probe-test
  (:export [main])
  (:require [aiueos.native.office-block-probe :as disk]))

;; QEMU-only synthetic sectors. The sentinel is written last, after all
;; three 35 KiB fixture regions have been written, flushed and read back.
(defn pattern [sector :i64 at :i64] :i64
  (bit-xor (+ (* sector 128) (quot at 4)) 0xa55a19c3))
(defn fill [page :i64 sector :i64 at :i64] :i64
  (if (= at 512) 1
    (let [w (kernel-store-u32-4k page 512 at (pattern sector at))]
      (fill page sector (+ at 4)))))
(defn valid [page :i64 sector :i64 at :i64] :bool
  (if (= at 512) true
    (and (= (kernel-load-u32-4k page 512 at) (pattern sector at))
         (valid page sector (+ at 4)))))
(defn clear [page :i64 at :i64] :i64
  (if (= at 512) 1
    (let [w (kernel-store-u32-4k page 512 at 0)] (clear page (+ at 4)))))
(defn transfer [page :i64 scratch :i64 sector :i64 writing :bool] :i64
  (if (= sector 215) 1
    (if writing
      (if (and (= (fill page sector 0) 1) (= (disk/write page scratch sector) 1))
        (transfer page scratch (+ sector 1) writing) 0)
      (if (and (= (disk/read page scratch sector) 1) (valid page sector 0))
        (transfer page scratch (+ sector 1) writing) 0))))
(defn main [] :i64
  (let [off (kernel-cli) receipt (kernel-owned-page 0)
        page (kernel-subregion (kernel-owned-page 1) 4096 0 512)
        overlap (kernel-subregion (kernel-owned-page 1) 4096 4 512)
        scratch (kernel-subregion (kernel-owned-page 2) 4096 0 512)
        loaded (disk/read page scratch 1)
        existing (if (= loaded 1) (kernel-load-u32-4k page 512 0) 0)
        phase (cond (= loaded 0) 3 (= existing 0) 1 (= existing 0x314b424f) 2 :else 4)
        guards (and (= (disk/read page scratch 0) 0) (= (disk/write page scratch 0) 0)
                    (= (disk/read page scratch 2048) 0) (= (disk/write page scratch 2048) 0)
                    (= (disk/write page scratch -1) 0) (= (disk/write page page 8) 0)
                    (= (disk/read page overlap 8) 0))
        outcome (cond (= phase 1)
                  (if (and (= (transfer page scratch 8 true) 1)
                           (= (fill page 2047 0) 1) (= (disk/write page scratch 2047) 1))
                    (let [zero (clear page 0) w (kernel-store-u32-4k page 512 0 0x314b424f)]
                      (disk/write page scratch 1)) 0)
                  (= phase 2) (if (and (= (transfer page scratch 8 false) 1)
                                       (= (disk/read page scratch 2047) 1) (valid page 2047 0)) 1 0)
                  (= phase 3) (if (and (= (disk/write page scratch 8) 0)
                                        (= (disk/read page scratch 0) 0)
                                        (= (disk/write page scratch 2048) 0)) 1 0)
                  :else 0)
        a (kernel-store-u64-4k receipt 4096 8 phase)
        b (kernel-store-u64-4k receipt 4096 16 (if guards outcome 0))
        c (kernel-store-u64-4k receipt 4096 24 207)
        done (kernel-store-u64-4k receipt 4096 0 0x314b434f4c424f)]
    (loop [spin 0] (let [pause (kernel-pause)] (recur (+ spin 1))))))
