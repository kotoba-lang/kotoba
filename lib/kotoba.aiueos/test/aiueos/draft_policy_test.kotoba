(ns aiueos.draft-policy-test (:export [main]) (:require [aiueos.draft-policy :as p]))
(defn entry [k :string v :string] :document (document-vector (document-string k) (document-string v)))
(defn draft [program :string base :document state :string entries :document] :document
  (document-map :version (document-i64 1) :program (document-string program) :base base
                :baseState (document-string state) :entries entries))
(defn main [] :i64
  (let [id "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        base (document-string "old") visible (document-vector (document-string "body"))
        good (draft id base "state😀" (document-vector (entry "body" "雪😀")))
        dup (draft id base "state😀" (document-vector (entry "body" "x") (entry "body" "y")))
        absent (draft id base "state😀" (document-vector (entry "other" "x")))
        bad-id (draft "not-a-hash" base "state😀" (document-vector (entry "body" "x")))
        missing (document-map :version (document-i64 1) :program (document-string id)
                              :baseState (document-string "state😀") :entries (document-vector (entry "body" "x")))
        wrongtype (draft id base "state😀" (document-string "not a vector"))
        nullbase (draft id (document-null) "state😀" (document-vector (entry "body" "x")))
        meta-good (document-vector (document-vector (document-string "body") (document-i64 2)))
        meta-bad (document-vector (document-string "not a pair"))]
    (if (and (= (p/classify good 100 id base "state😀" visible true 100) 2)
             (= (p/classify good 100 id base "state😀" visible false 100) 1)
             (= (p/classify good 100 id base "changed" visible true 100) 1)
             (= (p/classify good 100 id (document-null) "state😀" visible true 100) 1)
             (= (p/classify nullbase 100 id (document-null) "state😀" visible true 100) 2)
             (= (p/classify dup 100 id base "state😀" visible true 100) 0)
             (= (p/classify absent 100 id base "state😀" visible true 100) 1)
             (= (p/classify bad-id 100 id base "state😀" visible true 100) 0)
             (= (p/classify missing 100 id base "state😀" visible true 100) 0)
             (= (p/classify wrongtype 100 id base "state😀" visible true 100) 0)
             (= (p/classify good 1000001 id base "state😀" visible true 100) 0)
             (= (p/classify good 100 id base "state😀" visible true 6) 0)
             (= (p/classify good 100 id base "state😀" visible true 7) 2)
             (= (p/classify-chunks 100 id "string" "old" "state😀" id "string" "old" "state😀"
                  meta-good (document-null) "4:body" 1 true 7) 2)
             (= (p/classify-chunks 100 id "string" "old" "state😀" id "string" "old" "state😀"
                  meta-bad (document-null) "4:body" 1 true 7) 0)
             (= (p/classify-chunks 100 id "string" "old" "state😀" id "string" "old" "state😀"
                  (document-null) (document-string "bad tail") "4:body" 1 true 7) 0)) 0 1)))
