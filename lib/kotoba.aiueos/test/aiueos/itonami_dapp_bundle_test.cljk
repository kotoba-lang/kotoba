(ns aiueos.itonami-dapp-bundle-test
  "L2 evidence for itonami dapp bundles (Linear JUN-116): the judgment-core
  guests landed in cloud-itonami/{kaikei,app-resource-flow,app-credits} run
  through aiueos's own grant -> Chicory execute path, and their judgment
  suites (`test-*` exports) pass ON the aiueos runtime.

  Each wasm is the real `amu compile --target wasm32-browser` output of the
  named repo file on main (2026-10-19), base64-pinned exactly like
  `notes-wasm-b64` above -- this repo's .gitignore excludes *.wasm, and these
  fixtures are small enough to inline. The manifest declares
  `:aiueos/wasm-sha256`, so `execute`'s ADR-0003 artifact-integrity gate is
  exercised (tampered bytes deny before any capability decision).

  The bundles are pure (`:effects #{}`, `:aiueos/imports #{}`): grant with
  the default policy must admit them because they request no capability at
  all. Judgment values are read from the guests' own zero-arity `test-*`
  exports (1 = pass, the same contract `amu test` uses). Run both L2
  namespaces through the count-judged gate
  `kbb --backend sci scripts/run-task.cljk itonami-dapp-l2-test` -- the kbb
  test-runner substitution finds 0 tests in this namespace and reports green
  (measured 2026-10-20)."
  (:require [kotoba.bytes :as kbytes]
            [aiueos.execute :as execute]
            [grant.graph :as graph]
            [grant.policy :as policy]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.text :as str]))

(defn b64->bytes [s]
  (kbytes/base64-decode-bytes (str/replace s "\n" "")))

;; cloud-itonami/kaikei main aiueos/kaikei_journal.wasm
;; (journal-entry validation / trial-balance guest)
(def kaikei-wasm-b64
  "")
(def kaikei-sha256 "6c05bfe2cc988d9d4eb17a7813b452e920a3f29f6081e6ae21485dc205a48a84")
(def ^:private kaikei-judgment-exports
  ["test-valid-entry" "test-empty" "test-odd-buffer" "test-negative"
   "test-zero-line" "test-both-sides" "test-unbalanced" "test-entry-balanced"
   "test-ledger-balanced" "test-account-net"])

;; cloud-itonami/app-resource-flow main aiueos/resource_flow_journal.wasm
;; (flow anomaly / sankey node-value guest)
(def resource-flow-wasm-b64
  "")
(def resource-flow-sha256 "6dea15a2cedc14d134481ab52fa4db39c4ad9cddffa512ded14a0d6ad869e749")
(def ^:private resource-flow-judgment-exports
  ["test-valid-flows" "test-empty" "test-bad-length" "test-negative"
   "test-zero-amount" "test-self-flow" "test-node-in-out" "test-node-value"
   "test-net-position"])

;; cloud-itonami/app-credits main aiueos/credits_membrane.cljk -> wasm
;; (3-unit membrane judgment guest)
(def credits-wasm-b64
  "")
(def credits-sha256 "321c4d78324951dce8ec4b3d6ad3740eed53abca819f7215c36b1beca5d2c441")
(def ^:private credits-judgment-exports
  ["test-ext-bot-exchange" "test-mint-into-labour" "test-bot-to-labour"
   "test-labour-out-refused" "test-kumo-yata-forbidden" "test-self-refused"
   "test-unknown-refused" "test-x402-burn"])

(def empty-graph (graph/build []))

(defn dapp-manifest [component sha]
  {:aiueos/component component :aiueos/kind :app :aiueos/trust :untrusted
    :aiueos/imports #{} :aiueos/effects #{}
    :aiueos/wasm-sha256 sha
    :aiueos/limits {:memory-pages 16 :fuel 5000000}})

(def bundles
  [{:name "kaikei" :component :app/kaikei :sha kaikei-sha256
     :wasm-fn (fn [] (b64->bytes kaikei-wasm-b64))
     :exports kaikei-judgment-exports}
   {:name "resource-flow" :component :app/resource-flow :sha resource-flow-sha256
     :wasm-fn (fn [] (b64->bytes resource-flow-wasm-b64))
     :exports resource-flow-judgment-exports}
   {:name "credits" :component :app/credits :sha credits-sha256
     :wasm-fn (fn [] (b64->bytes credits-wasm-b64))
     :exports credits-judgment-exports}])

#?(:clj
   (deftest itonami-dapp-bundles-grant-on-aiueos
     (doseq [{:keys [name component sha wasm-fn]} bundles]
       (testing (str name " bundle: default policy grants a pure app")
         (let [m (dapp-manifest component sha)
               result (execute/execute m empty-graph policy/default-policy (wasm-fn))]
           (is (= :grant (:aiueos/decision result))))))))

#?(:clj
   (defn- call-export [instance export]
     (aget ^longs (.apply (.export instance export) (long-array 0)) 0)))

;; ---------------------------------------------------------------------------
;; L2 measured state (2026-10-19, this test as written on the JVM via
;; tools/cljk_loader.cljk): the credits bundle is i64/direct ABI (KIR v3,
;; no host imports) and completes the whole aiueos path -- grant, Chicory
;; `main`, and every judgment export. The kaikei and resource-flow bundles
;; compile to KIR v4 / :kotoba.typed/externref-v1 and import
;; `kotoba.typed` `literal`; aiueos's execute host implements the KERNEL
;; import set, not the typed-value host (`kotoba:typed/*` in
;; amu/runtime/browser-host.mjs), so Chicory refuses to link. That refusal
;; is the product here: the gap is named and pinned, not papered over.
;; When the typed-value host lands in aiueos.execute, flip test 3 into the
;; same positive assertions test 2 makes.
;; ---------------------------------------------------------------------------
#?(:clj
   (deftest credits-bundle-completes-the-aiueos-path
     (let [{:keys [wasm-fn exports]} (nth bundles 2)
           m (dapp-manifest :app/credits credits-sha256)
           result (execute/execute m empty-graph policy/default-policy (wasm-fn))]
       (testing "grant then Chicory runs main"
         (is (= :grant (:aiueos/decision result)))
         (is (= 0 (:aiueos.execute/result result))))
       (testing "every judgment export passes on the aiueos runtime"
         (let [instance (execute/instantiate (wasm-fn) (atom []) (atom {})
                                             execute/default-quota
                                             execute/default-fuel
                                             execute/default-memory-pages
                                             (fn [_] false)
                                             #{})]
           (doseq [e exports]
             (is (= 1 (call-export instance e)) (str "credits/" e " must pass"))))))))

#?(:clj
   (deftest typed-value-bundles-refuse-with-a-named-import
     (doseq [idx [0 1]]
       (let [{:keys [name wasm-fn]} (nth bundles idx)]
         (testing (str name ": v4/externref bundle refuses on the missing kotoba.typed host, named")
           (is (thrown-with-msg?
                com.dylibso.chicory.wasm.UnlinkableException
                #"kotoba:typed.literal"
                (execute/instantiate (wasm-fn) (atom []) (atom {})
                                     execute/default-quota
                                     execute/default-fuel
                                     execute/default-memory-pages
                                     (fn [_] false)
                                     #{}))))))))
