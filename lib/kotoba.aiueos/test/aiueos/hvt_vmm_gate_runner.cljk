(ns aiueos.hvt-vmm-gate-runner
  "Run just the vmm call-site gate (test/aiueos/hvt_vmm_gate_test.cljk).

  A dedicated entry because the kbb test-runner substitution loads EVERY
  namespace under test/ and the aggregate load is red on main for unrelated
  reasons (measured 2026-10-19: `anchors_chain_test` fails analysis with
  `Unable to resolve symbol: image/plan` before any test runs).

  Verdict source: `kotoba.test/run-tests` returns nil on this host, a
  `:reporter` installed through `set-env!` never fires, and a redefined
  `inc-report-counter!` never runs (all measured 2026-10-19) -- the host
  runner moves its counters through `cljs.test/update-current-env!`, so that
  is the tap. Counters are snapshotted after every update.

  Exit codes, by the 8-question rule: 0 = the gate ran and passed; 1 = the
  gate ran and failed; 2 = no readable verdict (nothing ran, or the counters
  are unreadable) -- a gate that cannot count its own result must not exit
  like a green one."
  (:require [kotoba.test :as t]
            [cljs.test :as ct]
            [aiueos.hvt-vmm-gate-test])
  (:gen-class))

(defn -main [& _]
  (let [seen (atom nil)
        orig ct/update-current-env!]
    (with-redefs [ct/update-current-env!
                  (fn [& args]
                    (let [r (apply orig args)]
                      (reset! seen (get (ct/get-current-env) :report-counters))
                      r))]
      (t/run-tests 'aiueos.hvt-vmm-gate-test))
    (let [{:keys [test fail error] :as counters} @seen
          bad (+ (or fail 0) (or error 0))]
      (println :gate-counters (pr-str counters))
      (System/exit (cond
                     (or (nil? counters) (not (pos? (or test 0)))) 2
                     (pos? bad) 1
                     :else 0)))))
