(ns aiueos.itonami-dapp-selfhost-test
  "L2 evidence, path 2 (JUN-124): itonami dapp bundles run on their DECLARED
  host contract -- `kototama-browser-host-v1` / `kotoba.typed/externref-v1`,
  whose typed-value host (`kotoba:typed/*`) is implemented by amu's selfhost
  runtime (`amu/runtime/browser-host.mjs`, the same host `amu test`'s js/wasm
  probes run on). aiueos's role here is admission: `grant.broker` decides
  BEFORE any execution, and the selfhost run happens only after :grant.

  The Chicory kernel host in `aiueos.execute` deliberately does NOT grow a
  second typed-value implementation (owner decision 2026-10-19): the kernel
  path's named refusal for `kotoba.typed/literal` stays pinned in
  `itonami-dapp-bundle-test`.

  The runner program is generated at test time (amu's node-run does the same);
  no raw JS is committed. AMU root: KOTOBA_AMU_ROOT env, else the west
  sibling `../amu`. A missing host is a NAMED failure, never a pass.

  Run (JVM):
    KOTOBA_AMU_ROOT=<amu checkout> \\
    java -cp \"$(clojure -Spath -M:test)\" clojure.main \\
      -i <kotoba>/tools/cljk_loader.cljk \\
      -e \"(require 'aiueos.itonami-dapp-selfhost-test 'clojure.test) (clojure.test/run-tests 'aiueos.itonami-dapp-selfhost-test)\"

  The registered way to run both L2 namespaces is the count-judged gate:
  `kbb --backend sci scripts/run-task.cljk itonami-dapp-l2-test` (the kbb
  test-runner substitution runs 0 tests of these namespaces and still reports
  green -- measured 2026-10-20; the gate's floor makes that a failure)."
  (:require [kotoba.bytes :as kbytes]
            [aiueos.itonami-dapp-bundle-test :as fix]
            [grant.broker :as broker]
            [grant.graph :as graph]
            [grant.policy :as policy]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.text :as str]
            #?(:clj [cheshire.core :as json])
            #?(:clj [clojure.java.shell :as sh])
            #?(:clj [clojure.java.io :as io])))

#?(:clj
   (defn- amu-host-mjs []
     (let [root (or (System/getenv "KOTOBA_AMU_ROOT")
                    (str (.getParent (.getCanonicalFile (io/file "."))) "/amu"))
           f (io/file root "runtime/browser-host.mjs")]
       (when-not (.exists f)
         (throw (ex-info "amu selfhost host not found: KOTOBA_AMU_ROOT must point at the amu checkout"
                         {:aiueos.itonami-dapp-selfhost-test/reason :selfhost-host-missing
                          :looked-at (str f)})))
       (.getCanonicalPath f))))

#?(:clj
   (def runner-js
     "const host = await import(process.env.KOTOBA_HOST_MJS);
const bytes = new Uint8Array(await (await import('node:fs/promises')).readFile(process.argv[2]));
const names = JSON.parse(process.argv[3]);
const loaded = await host.instantiateKotoba(bytes, {allowCapabilities: []});
const inst = loaded.instance;
const out = [];
for (const name of names) {
  try { out.push({test: name, value: String(inst.exports[name]())}); }
  catch (e) { out.push({test: name, error: String(e)}); }
}
console.log(JSON.stringify(out));"))

#?(:clj
   (defn- selfhost-run
     "Run WASM-BYTES' zero-arity EXPORTS on the amu selfhost host. Returns a
     map of export name -> its stringified value (bigint-safe)."
     [wasm-bytes exports]
     (let [tmp (doto (io/file (System/getProperty "java.io.tmpdir")
                              (str "kotoba-selfhost-" (System/nanoTime)))
                 (.mkdirs))
           wasm-file (io/file tmp "bundle.wasm")
           runner-file (io/file tmp "runner.mjs")
           _ (io/copy (java.io.ByteArrayInputStream. wasm-bytes) wasm-file)
           _ (spit runner-file runner-js)
           env (assoc (into {} (System/getenv))
                      "KOTOBA_HOST_MJS" (str "file://" (amu-host-mjs)))
           res (sh/sh "node" (.getCanonicalPath runner-file)
                      (.getCanonicalPath wasm-file)
                      (json/generate-string (mapv name exports))
                      :env env)]
       (when-not (zero? (:exit res))
         (throw (ex-info "selfhost node run failed"
                         {:reason :selfhost-run-failed
                          :exit (:exit res) :out (:out res) :err (:err res)})))
       (into {} (map (fn [row] [(keyword (:test row)) (or (:value row) (str "ERR:" (:error row)))])
                     (json/parse-string (str/trim (:out res)) true))))))

#?(:clj
   (defn- grant [bundle]
     (broker/verify-admission (fix/dapp-manifest (:component bundle) (:sha bundle))
                              fix/empty-graph policy/default-policy)))

#?(:clj
   (deftest admission-grants-every-bundle-before-any-execution
     (doseq [{:keys [name] :as bundle} fix/bundles]
       (testing (str name ": aiueos admission grants a pure app")
         (is (= :grant (:aiueos/decision (grant bundle))))))))

#?(:clj
   (deftest bundles-run-their-judgment-suites-on-the-selfhost-host
     (doseq [{:keys [name wasm-fn exports] :as bundle} fix/bundles]
       (testing (str name ": aiueos :grant first, then kototama-browser-host-v1 runs every judgment export")
         (is (= :grant (:aiueos/decision (grant bundle))))
         (let [results (selfhost-run (wasm-fn) (into ["main"] exports))]
           (is (= "0" (:main results)) (str name "/main"))
           (doseq [e exports]
             (is (= "1" (get results (keyword e))) (str name "/" e " must pass on selfhost"))))))))
