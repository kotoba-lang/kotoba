(ns aiueos.office-view-native-test
  (:export [main])
  (:capabilities [:cli/args :io/write])
  (:require [aiueos.office-view :as view]))
(defn index-number [s :string] :i64
  (let [b (vector-i64-from-bytes (string-to-utf8 s)) n (vector-count b)]
    (if (or (< n 1) (> n 3)) -1
      (loop [i 0 x 0]
        (if (= i n) x
          (let [c (vector-at b i)]
            (if (or (< c 48) (> c 57)) -1 (recur (+ i 1) (+ (* x 10) (- c 48))))))))))
(defn dtext [d :document k :keyword] :string
  (option-value-of [:option :string]
    (document-string-value (option-value-of [:option :document] (document-get d k) (document-null))) ""))
(defn main [] :i64
  (let [wire (typed-cap-call :cli/args :string :string "0")
        mode (typed-cap-call :cli/args :string :string "1")]
    (if (string=? mode "action")
      (let [index (index-number (typed-cap-call :cli/args :string :string "2"))
            kind (typed-cap-call :cli/args :string :string "3")
            value (typed-cap-call :cli/args :string :string "4")
            event (view/action wire index kind value)]
        (if (not (option-some?-of [:option :document] event)) 3
          (let [v (option-value-of [:option :document] event (document-null))
                output (typed-cap-call :io/write :string :string
                         (string-concat (dtext v :route) (string-concat "|" (string-concat (dtext v :kind)
                           (string-concat "|" (string-concat (dtext v :target)
                             (string-concat "|" (string-concat (dtext v :value) "\n"))))))))] 0)))
      (let [result (view/decode wire)]
        (if (not (option-some?-of [:option :vector-i64] result)) 3
          (let [nodes (option-value-of [:option :vector-i64] result (vector-alloc 0))
                tag (string-substring wire (vector-at nodes 1) (vector-at nodes 2))
                summary (if (and (string=? mode "inspect") (> (vector-at nodes 0) 1))
                          (string-substring wire (vector-at nodes 27) (vector-at nodes 28))
                          (string-concat (string-from-i64 (vector-at nodes 0)) (string-concat ":" tag)))
                out (typed-cap-call :io/write :string :string (string-concat summary "\n"))] 0))))))
