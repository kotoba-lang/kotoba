(ns aiueos.update-policy-test (:export [main]) (:require [aiueos.update-policy :as p]))

;; JUN-813: exhaustive over mode 0..3, event 0..2, stage 0..3, endpoint 0..1,
;; admitted 0..1 (192 states) plus fixed cases. main returns 0 when every check
;; holds, else the number of the first failed check. scripts/check-update-policy-native.py
;; mutates the policy and requires this test to fail for each mutant.

(defn bit [acts :i64 m :i64] :bool (> (bit-and acts m) 0))

;; Invariants of one state; returns 0 when they hold, else a code 1..99.
(defn state-ok [mode :i64 event :i64 stage :i64 endpoint :i64 admitted :i64] :i64
  (let [a (p/next-actions mode event stage endpoint admitted)
        prompts (bit-and a 7)]
    (cond
      (and (= mode 0) (> prompts 0)) 1
      (and (bit a 1) (not (and (= event 1) (>= mode 1) (= stage 0) (= endpoint 1)))) 2
      (and (bit a 2) (not (and (>= mode 2) (= stage 1) (= admitted 1) (= endpoint 1)))) 3
      (and (bit a 2) (= mode 1)) 4
      (and (bit a 4) (not (and (= event 2) (= mode 3) (= stage 2) (= admitted 1)))) 5
      (and (= event 1) (bit a 4)) 6
      (and (= endpoint 0) (bit a 27)) 7
      (and (bit a 16) (= admitted 0)) 8
      (and (bit a 32) (= admitted 0)) 9
      (and (bit a 32) (not (= stage 2))) 10
      (and (not (= (bit-and (p/next-actions mode 0 stage endpoint admitted) 56) (bit-and a 56)))) 11
      (and (= event 1) (= stage 1) (= admitted 1) (= endpoint 1) (>= mode 2) (not (bit a 2))) 12
      (and (= event 1) (= stage 0) (= endpoint 1) (>= mode 1) (not (bit a 1))) 13
      (and (= event 2) (= mode 3) (= stage 2) (= admitted 1) (not (bit a 4))) 14
      :else 0)))

;; may-run over every state, every requested op and every approval; returns 0 or a code.
(defn run-ok [mode :i64 event :i64 stage :i64 endpoint :i64 admitted :i64 op :i64 approved :i64 fresh :i64] :i64
  (let [r (p/may-run mode event stage endpoint admitted op approved fresh)
        a (p/next-actions mode event stage endpoint admitted)
        offered (case op 1 (bit-and a 9) 2 (bit-and a 18) 3 (bit-and a 36) 0)]
    (cond
      (and (= r 1) (not (= fresh 1))) 20
      (and (= r 1) (not (= approved op))) 21
      (and (= r 1) (= offered 0)) 22
      (and (= r 1) (= op 0)) 23
      (and (= fresh 1) (= approved op) (> op 0) (> offered 0) (= r 0)) 24
      :else 0)))

(defn loop-states [i :i64 acc :i64] :i64
  (if (or (> acc 0) (= i 192)) acc
    (loop-states (+ i 1)
      (state-ok (mod (quot i 48) 4) (mod (quot i 16) 3) (mod (quot i 4) 4) (mod (quot i 2) 2) (mod i 2)))))

(defn loop-runs [i :i64 acc :i64] :i64
  (if (or (> acc 0) (= i 12288)) acc
    (loop-runs (+ i 1)
      (run-ok (mod (quot i 3072) 4) (mod (quot i 1024) 3) (mod (quot i 256) 4) (mod (quot i 128) 2) (mod (quot i 64) 2)
              (mod (quot i 16) 4) (mod (quot i 4) 4) (mod i 2)))))

(defn main [] :i64
  (let [states (loop-states 0 0)
        runs (loop-runs 0 0)]
    (cond
      (> states 0) states
      (> runs 0) runs
      ;; image admission: kernel result codes 1, 10, 9 and 0
      (not (= (p/image-admission 1 5 3) 1)) 30
      (not (= (p/image-admission 0 5 3) 1)) 31
      (not (= (p/image-admission 2 5 3) 0)) 32
      (not (= (p/image-admission 3 5 3) 0)) 33
      (not (= (p/image-admission 2 5 5) 9)) 34
      (not (= (p/image-admission 2 4 5) 9)) 35
      (not (= (p/image-admission 2 5 -1) 10)) 36
      (not (= (p/image-admission 2 5 0) 0)) 37
      (not (= (p/image-admission 1 5 -1) 1)) 38
      ;; check verdict (ADR-0286 Amendment 6 table)
      (not (= (p/check-verdict 1 1 7 5) 2)) 40
      (not (= (p/check-verdict 1 1 5 5) 1)) 41
      (not (= (p/check-verdict 1 1 4 5) 1)) 42
      (not (= (p/check-verdict 1 2 7 5) 4)) 43
      (not (= (p/check-verdict 1 3 7 5) 4)) 44
      (not (= (p/check-verdict 1 4 7 5) 4)) 45
      (not (= (p/check-verdict 1 2 5 5) 3)) 46
      (not (= (p/check-verdict 0 1 7 5) 3)) 47
      (not (= (p/check-verdict 0 2 7 5) 3)) 48
      ;; fixed policy-file cases
      (not (= (p/next-actions 1 1 0 1 0) 9)) 50
      (not (= (p/next-actions 0 1 0 1 0) 8)) 51
      (not (= (p/next-actions 2 1 1 1 1) 26)) 52
      (not (= (p/next-actions 3 2 2 0 1) 36)) 53
      (not (= (p/next-actions 2 2 2 0 1) 32)) 54
      (not (= (p/next-actions 1 1 1 1 1) 24)) 55
      (not (= (p/next-actions 1 1 0 0 0) 0)) 56
      :else 0)))
