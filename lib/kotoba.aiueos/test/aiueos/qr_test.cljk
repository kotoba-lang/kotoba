(ns aiueos.qr-test
  "aiueos.qr against qrcodegen 1.8.0 (the hosted adapter's encoder).

  Portable: one fixed vector produced by qrcodegen, compared module for module,
  plus the structural floors (finder corners, the dark module, quiet zone,
  capacity refusal). JVM only: the same jar the hosted adapter links, driven
  directly, over every ECC level, forced and automatic masks, and data lengths
  that walk the version range -- so a table typo in any version is red here,
  not on a phone that will not scan."
  (:require [aiueos.qr :as qr]
            [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]])
  #?(:clj (:import [io.nayuki.qrcodegen QrCode QrCode$Ecc QrSegment])))

(def approval-url "https://auth.kotoba.cloud/aiueos/device?flow=Ab-_09")

;; qrcodegen 1.8.0: encodeSegments([makeBytes(url)], MEDIUM, 1, 40, -1, false)
;; -> version 4, mask 6. Row-major, 1 = dark.
(def fixed-rows
  [
    "111111101101011001100010001111111"
    "100000101111111010110010101000001"
    "101110101110111100000101001011101"
    "101110100101001010101001001011101"
    "101110101101000110000000101011101"
    "100000100111101111010111001000001"
    "111111101010101010101010101111111"
    "000000000100010110100011000000000"
    "100111111010001001000000110010111"
    "011110000001011101110011100011100"
    "010001110010110110001101111011111"
    "010111001101010010111001110100111"
    "010100111111010001001000011100000"
    "011111011101101001111101000101100"
    "110000100101100101011000001000100"
    "110100010011101010001001010011101"
    "101001111111111100011010111111000"
    "010001000001001101010000001010101"
    "001100110011010101110011100101111"
    "100111001101110000011000000011100"
    "111011111101001110111010100101010"
    "100100001100111000011011000111100"
    "101110101100000001001111101000111"
    "101001001010000101000011010000111"
    "111011110101101010011000111110011"
    "000000001011101111100101100010100"
    "111111101000011101010101101010100"
    "100000101000001101111001100011110"
    "101110101101000011000111111110010"
    "101110101001010011110100110100111"
    "101110100010110101010000100111011"
    "100000100101011000100010001111111"
    "111111101101101111100001111110000"
   ])

(defn- rows [sym]
  (mapv (fn [row] (apply str (map #(if % "1" "0") row))) (:modules sym)))

(deftest fixed-vector-matches-qrcodegen
  (let [sym (qr/encode-bytes (qr/ascii-bytes approval-url))]
    (is (= 4 (:version sym)))
    (is (= 6 (:mask sym)))
    (is (= 33 (:size sym)))
    (is (= fixed-rows (rows sym)))))

(deftest one-flipped-module-is-seen
  ;; the control for the test above: the comparison can fail
  (let [sym (qr/encode-bytes (qr/ascii-bytes approval-url))
        broken (update-in sym [:modules 20 20] not)]
    (is (not= fixed-rows (rows broken)))))

(deftest structure
  (let [sym (qr/encode-bytes (qr/ascii-bytes approval-url))
        m (:modules sym)
        s (:size sym)]
    (testing "three finder corners, dark 7x7 ring"
      (doseq [[x y] [[0 0] [(- s 7) 0] [0 (- s 7)]]]
        (is (every? true? (for [i (range 7)] (get-in m [y (+ x i)]))))))
    (testing "the always-dark module beside the lower-left finder"
      (is (true? (get-in m [(- s 8) 8]))))))

(deftest capacity-is-refused-not-truncated
  (is (nil? (qr/encode-bytes (repeat 400 65) {:max-version 10})))
  (is (some? (qr/encode-bytes (repeat 213 65) {:max-version 10})))
  (is (nil? (qr/encode-bytes (repeat 214 65) {:max-version 10}))
      "v10-M holds exactly 213 bytes; 214 is one past the boundary"))

(deftest non-ascii-is-refused
  (is (nil? (qr/ascii-bytes "https://example/é")))
  (is (nil? (qr/ascii-bytes "a\nb")))
  (is (= [104 105] (qr/ascii-bytes "hi"))))

(deftest terminal-lines-quiet-zone-and-polarity
  (let [sym (qr/encode-bytes (qr/ascii-bytes approval-url))
        lines (qr/terminal-lines sym)]
    (is (= (+ 33 8) (count lines)))
    (testing "quiet-zone rows are one light run of 2 x 41 cells"
      (is (= (str "\u001b[7m" (apply str (repeat 82 " ")) "\u001b[0m") (first lines))))
    (testing "row 4 starts with the finder: 4 light modules then 7 dark"
      (is (str/starts-with?
           (nth lines 4)
           (str "\u001b[7m" (apply str (repeat 8 " ")) "\u001b[0m"
                (apply str (repeat 14 " "))))))))

#?(:clj
   (deftest oracle-over-levels-masks-and-versions
     (let [ecls {:low QrCode$Ecc/LOW :medium QrCode$Ecc/MEDIUM
                 :quartile QrCode$Ecc/QUARTILE :high QrCode$Ecc/HIGH}
           cases (concat
                  (for [ecc (keys ecls)
                        n [1 17 43 88 150 260 500 1200 2300]]
                    [ecc -1 n])
                  (for [m (range 8)] [:medium m 88]))]
       (doseq [[ecc mask n] cases]
         (let [data (mapv #(+ 33 (mod (* 7 %) 90)) (range n))
               oracle (try (QrCode/encodeSegments
                            [(QrSegment/makeBytes (byte-array (map byte data)))]
                            (ecls ecc) 1 40 mask false)
                           (catch io.nayuki.qrcodegen.DataTooLongException _ nil))
               mine (qr/encode-bytes data (cond-> {:ecc ecc} (>= mask 0) (assoc :mask mask)))]
           (testing (str ecc " mask=" mask " n=" n)
             (if (nil? oracle)
               (is (nil? mine))
               (do (is (= (.-version oracle) (:version mine)))
                   (is (= (.-mask oracle) (:mask mine)))
                   (is (= (vec (for [y (range (.-size oracle))]
                                 (vec (for [x (range (.-size oracle))]
                                        (.getModule oracle x y)))))
                          (:modules mine)))))))))))
