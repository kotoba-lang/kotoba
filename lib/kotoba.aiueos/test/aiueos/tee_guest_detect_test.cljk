;; `tee-guest-detect.kotoba` -- the guest's own TDX / SEV-SNP self-report,
;; driven through the KIR interpreter against expectations computed by
;; hand from the vendors' specifications (Intel TDX module CPUID leaf
;; 0x21; AMD 24593 CPUID Fn8000_001F). The C probes the registers; this
;; object owns the decision; this test owns the expectation.
;;
;; The route is the tcp-seq parity route: compile the source with amu at
;; test time, execute the KIR, compare. No committed object is claimed
;; here -- the .o and its digest land in build-uefi.sh when the CPUID
;; probe in `kernel/cpu.c` gets its call site, which is a kernel change
;; and belongs to its own commit.

(ns ^:ci-anon aiueos.tee-guest-detect-test
  (:require [kotoba.io :as io]
            [kotoba.test :refer [deftest is]]
            [kotoba.compiler.core :as compiler]
            [kotoba.kir :as ir]))

(def ^:private source-file
  (io/file "os" "aiueos" "kotoba" "tee-guest-detect.kotoba"))

(defn- source-available?
  "Fails rather than skips. A `when`-guard here reports green on a
  checkout without the object, which is a skip wearing a pass."
  []
  (let [present? (io/exists? source-file)]
    (is present? (str "kotoba object not found at " source-file))
    present?))

(def ^:private kir
  (delay (:kir (compiler/compile-source (slurp source-file) :wasm32-kotoba-v1 {}))))

(defn- call [f args]
  (ir/execute @kir f args))

;; -- constants the C compares its probe against --------------------------

(deftest constants-are-the-vendors
  (is (= 21 (call 'tdx-guest-p [])))
  (is (= 2147483695 (call 'snp-cpuid-leaf [])))  ;; Fn8000_001F
  (is (= 4261412864 (call 'tdvf-range-floor []))) ;; 0xFE000000
  (is (= 4294967296 (call 'tdvf-range-ceiling []))))

;; -- in-tdvf-range: every branch, at its boundary ------------------------

(deftest tdvf-range-branches
  ;; below the floor: refuse
  (is (= 0 (call 'in-tdvf-range [(dec 4261412864) 1048576])))
  ;; exactly at the floor with a legal 1 MiB window: admit
  (is (= 1 (call 'in-tdvf-range [4261412864 1048576])))
  ;; under 1 MiB is not a firmware image
  (is (= 0 (call 'in-tdvf-range [4261412864 (dec 1048576)])))
  ;; exactly 1 MiB ending exactly at 4 GiB: admit (the top boundary)
  (is (= 1 (call 'in-tdvf-range [(- 4294967296 1048576) 1048576])))
  ;; one byte past 4 GiB: refuse
  (is (= 0 (call 'in-tdvf-range [(- 4294967296 1048576)
                                                  (+ 1048576 1)]))))

;; -- tdx-detect: the conjunction is the claim ----------------------------

(deftest tdx-detect-conjunction
  ;; leaf absent: refuse regardless of firmware
  (is (= 0 (call 'tdx-detect [0 4286578688 8388608])))
  (is (= 0 (call 'tdx-detect [1 1000 1000])))
  ;; leaf present + a TDVF-shaped window: admit
  (is (= 1 (call 'tdx-detect [1 4286578688 8388608]))))

;; -- snp-detect: both bits or nothing ------------------------------------

(deftest snp-detect-conjunction
  ;; neither bit
  (is (= 0 (call 'snp-detect [0])))
  ;; SEV only (plain SEV or SEV-ES launch, not SNP)
  (is (= 0 (call 'snp-detect [1])))
  ;; SNP only (a word that would be malformed from the real leaf, but the
  ;; decision must still refuse it)
  (is (= 0 (call 'snp-detect [2])))
  ;; both: SEV bit and SNP bit
  (is (= 1 (call 'snp-detect [3]))))
