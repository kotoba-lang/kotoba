;; Device profile: Google Pixel 10 Pro Fold ("rango"), Android 17 build CP3A.261005.005.
;; Data only. It records what was read from the device and what each driver must
;; cover. It adds no driver, no boot path, no qualification claim, and it never
;; changes the device. Tracked as JUN-862.
;;
;; Every fact carries its basis:
;;   :measured    read through `adb shell` on 2026-11-06 (getprop, getevent, dumpsys,
;;                pm list features, ls /sys/class, ls /dev/block/by-name)
;;   :inferred    derived from a measured value by a stated rule; check before relying on it
;;   :unverified  not read from this unit; a driver must not assume it
;; Per-unit identifiers (serial, MAC, BSSID, SSID, IP, Bluetooth address) are left out.
{:device.profile/version 1
 :device/id :google/rango
 :device/marketing-name "Pixel 10 Pro Fold"
 :device/qualification :none
 :device/aiueos-install :not-attempted

 :soc
 {:name        {:value "Google Tensor G5" :basis :measured :source "ro.soc.model"}
  :board       {:value "laguna" :basis :measured :source "ro.board.platform"}
  :isa         {:value :aarch64 :abi "arm64-v8a" :basis :measured}
  :cores       {:value 8 :basis :measured :source "/proc/cpuinfo"
                :implementer 0x41
                ;; part ids as read: 0xd80 x2, 0xd82 x1, 0xd87 x5
                :parts {0xd80 2 0xd82 1 0xd87 5}
                :microarchitecture {:value {0xd80 "Cortex-A520" 0xd82 "Cortex-X4" 0xd87 "Cortex-A725"}
                                    :basis :inferred
                                    :rule "Arm's public MIDR part-number assignment"}}
  :memory-kib  {:value 15948932 :basis :measured :source "/proc/meminfo MemTotal"}
  :gpu         {:value :powervr :basis :measured :source "ro.hardware.egl and ro.hardware.vulkan"
                :model :unverified}}

 :boot
 {:android {:release "17" :sdk 37 :basis :measured}
  :kernel  {:value "6.6.127-android15-8" :page-size 4096 :basis :measured :source "uname -a"}
  :slot    {:value "_a" :scheme :ab :basis :measured}
  :bootloader-version {:value "deepspace-17.4-16119390" :basis :measured :source "ro.bootloader"}
  :locked  {:value true :basis :measured :source "ro.boot.flash.locked and ro.boot.vbmeta.device_state"}
  :verified-boot-state {:value :green :basis :measured}
  :treble  {:value true :basis :measured}
  :oem-unlock-allowed :unverified
  :boot-protocol
  {:value :android-abl-fastboot
   :basis :inferred
   :rule "partitions abl_a/b, bl31, tzsw, gsa_*, pvmfw, boot, init_boot, dtbo; no ESP and no UEFI variable store was observed"
   :uefi :not-evidenced}
  :partitions
  {:basis :measured :source "/dev/block/by-name"
   :ab ["abl" "bl31" "boot" "cap" "cpm" "dbc" "dbl" "dpm" "dram_init_0..9" "dram_phy" "dram_train"
        "dtbo" "gc" "gdmc" "gsa_bl1" "gsa_fw" "init_boot" "modem" "pvmfw" "tzsw"]
   :single ["bl_data" "blenv" "devinfo" "efs" "efs_backup" "frp" "klog" "metadata" "mfg_data"
            "misc" "modem_userdata" "persist" "pinfo" "rdbl" "super" "trusty_persist"
            "trusty_userdata" "ufs_internal"]
   :block-devices ["sda" "sdb" "sdc" "sdd"]
   :storage-class {:value :ufs :basis :inferred :rule "sd* LUNs under scsi_host, no mmcblk or nvme namespace in by-name"}}}

 :displays
 [{:id :inner :size [2076 2152] :refresh-hz 120 :basis :measured :source "dumpsys display"}
  {:id :outer :size [1080 2364] :refresh-hz 120 :density-dpi 390 :basis :measured :source "dumpsys display, wm density"}]
 :panel-controllers :unverified

 :touch
 [{:name "fst2"
   :node "/dev/input/event5"
   :bus :spi :sysfs "/sys/devices/platform/db23000.spi/spi_master/spi19/spi19.0"
   :multitouch {:slots 14 :x-max 20759 :y-max 21519 :pressure-max 127 :tool-types 3
                :tilt true :props [:direct] :basis :measured :source "getevent -pl"}
   :display {:value :inner :basis :inferred
             :rule "axis ranges are 10x the inner panel size (2076x2152)"}}
  {:name "synaptics_tcm_touch"
   :node "/dev/input/event4"
   :bus :spi :sysfs "/sys/devices/platform/db33000.spi/spi_master/spi20/spi20.0"
   :multitouch {:slots 10 :x-max 10799 :y-max 23639 :pressure-max 255 :wake-key true
                :props [:direct] :basis :measured :source "getevent -pl"}
   :display {:value :outer :basis :inferred
             :rule "axis ranges are 10x the outer panel size (1080x2364)"}}]

 :wifi
 {:interfaces       {:value ["wlan0" "wlan1"] :basis :measured :source "/sys/class/net"}
  :standard-in-use  {:value :ieee-802.11ax :basis :measured
                     :note "one association; says nothing about what the radio supports"}
  :features         {:value [:sta :p2p :hotspot :aware :rtt :passpoint :pno
                             :sta+sta-concurrency :sta+ap-concurrency]
                     :basis :measured :source "dumpsys wifi"}
  :chip             :unverified
  :bus              :unverified
  :firmware         :unverified
  :needed-for-aiueos [:scan :wpa2-wpa3-sta :dhcp :regulatory-domain :firmware-load]}

 :bluetooth
 {:features [:classic :le :channel-sounding] :basis :measured :source "pm list features"
  :profiles-enabled
  {:value [:a2dp-source :avrcp-target :hfp-ag :hid-host :hid-device :pan :pbap :map :gatt
           :le-audio-bap-unicast :le-audio-broadcast :csip :vcp :hap :asha :ccp :mcp]
   :basis :measured :source "bluetooth.profile.* properties"}
  :a2dp-offload true
  :controller :unverified
  :transport :unverified
  :needed-for-aiueos [:hci :le-scan-connect :hid-host :firmware-load]}

 :cellular
 {:telephony true :esim true :satellite true :basis :measured :source "pm list features"
  :data-interfaces {:value "rmnet0..29" :basis :measured}
  :modem-partitions ["modem_a" "modem_b" "modem_userdata"]
  :needed-for-aiueos :out-of-scope-for-first-boot}

 :other-hardware
 {:fingerprint   {:value "goodix" :basis :measured :source "goodix_fp class and goodix_fingerprint input node"}
  :haptics       {:value "cs40l26" :basis :measured :source "cs40l26_input"}
  :nfc           {:value true :secure-element true :basis :measured}
  :uwb           {:value true :basis :measured}
  :gnss          {:value true :basis :measured}
  :usb           {:host true :accessory true :typec true :basis :measured}
  :camera        {:front true :back true :basis :measured}
  :sensors       {:value [:accelerometer :gyroscope :compass :barometer :light :proximity
                          :hinge-angle :step-counter :step-detector :head-tracker]
                  :basis :measured :source "pm list features"}
  :sysfs-classes {:value ["drm" "backlight" "goog_touch_interface" "touch_offload" "synaptics_tcm"
                          "edgetpu" "gxp" "aoc" "gsa" "lwis" "video4linux" "thermal" "power_supply"
                          "remoteproc" "rfkill" "sound" "typec" "ieee80211" "bluetooth" "gnss" "nfc"]
                  :basis :measured :source "ls /sys/class"}}

 :first-boot-driver-set
 {:required   [:uart-or-fastboot-console :ufs :display-outer :touch-outer :power-button-gpio :timer-irq-gic :pmic-minimal]
  :second     [:display-inner :touch-inner :hinge-angle :battery-charger :usb-gadget]
  :third      [:wifi :bluetooth]
  :deferred   [:cellular :camera :gpu :nfc :uwb :gnss :fingerprint :haptics :edgetpu]
  :basis      :design
  :note       "ordering is a proposal in docs/devices/google-pixel-10-pro-fold-rango.md, not a measurement"}}
