#!/usr/bin/env kbb
;; The Bonsai profile of the C translation, graded on the host (ADR-0222).
;;
;;   kbb --backend sci os/aiueos/scripts/smoke-bonsai-runtime-translation.cljk
;;
;; `kernel/qwen35_runtime.c` compiled with -DAIUEOS_QWEN35_KOTOBA_ADMISSION
;; -DAIUEOS_QWEN35_TRANSLATION_ONLY is ONLY the workspace -> struct
;; translation, which is why it links on an aarch64 workstation that cannot
;; execute the x86-64 objects. This script hands that translation the Bonsai
;; workspaces and requires the struct to be the one the graph contract
;; describes.
;;
;; Neither side of the comparison is written here:
;;
;;   INPUT  -- `:expect-plan-hex` of the admitted vector of
;;             contracts/qwen35-gguf-kv-scan-v1.edn (144 bytes) and
;;             contracts/qwen35-tensor-table-bind-v1.edn (28,160 bytes).
;;             Both were computed independently in python from the real
;;             artifact header and are pinned to what the OBJECTS produce by
;;             `run-task.cljk bonsai-admission-contracts`, which executes them
;;             in the KIR oracle over the sha256-pinned header. This gate
;;             therefore does not need the 11 MB fixture, and it is not
;;             evidence about the objects -- that contract is.
;;
;;   EXPECT -- contracts/bonsai2-qwen35-runtime-v1.edn, the graph contract,
;;             rendered below into the expectations file the C reads. A number
;;             typed in this file or in tests/bonsai_runtime_translation.c
;;             would be a third copy of the artifact and the one nobody
;;             checks.
;;
;; Exit 3 (not 1) when this machine could not ask the question: no C compiler,
;; or a contract missing the workspace it must carry. "Could not measure" and
;; "measured and refused" are different answers.

(require '[clojure.edn :as edn])
(def fs (js/require "node:fs"))
(def os (js/require "node:os"))
(def path (js/require "node:path"))
(def cp (js/require "node:child_process"))

(def aiueos (.resolve path (.dirname path *file*) ".."))

(defn- die [& msg]
  (binding [*out* *err*] (apply println (cons "error:" msg)))
  (.exit js/process 1))

(defn- unmeasured [& msg]
  (binding [*out* *err*] (apply println (cons "unmeasured:" msg)))
  (.exit js/process 3))

(defn- contract [name]
  (let [file (.join path aiueos "contracts" name)]
    (when-not (.existsSync fs file) (unmeasured "no contract" file))
    (edn/read-string (.readFileSync fs file "utf8"))))

;; ------------------------------------------------- the objects' workspaces

(defn- admitted-workspace [name]
  (let [c (contract name)
        declared (get-in c [:verification :memory :plan-bytes])
        carrying (filter :expect-plan-hex (:vectors c))]
    (when-not (= 1 (count carrying))
      (unmeasured name "carries" (count carrying)
                  "vectors with an expected workspace; this gate needs exactly one"))
    (let [v (first carrying)
          hex (:expect-plan-hex v)
          bytes (js/Buffer.from hex "hex")]
      (when-not (zero? (:expected v))
        (unmeasured name "the vector carrying the workspace is not the admitted one"))
      (when-not (= declared (.-length bytes))
        (die name "declares a" declared "byte workspace and carries"
             (.-length bytes)))
      (when-not (= (* 2 declared) (count hex))
        (die name "the hex is not" declared "whole bytes"))
      {:bytes bytes :length declared :vector (:name v)})))

(def kv (admitted-workspace "qwen35-gguf-kv-scan-v1.edn"))
(def tt (admitted-workspace "qwen35-tensor-table-bind-v1.edn"))
(println "WORKSPACE kv" (:vector kv) (:length kv) "bytes, tensor-table"
         (:vector tt) (:length tt) "bytes")

;; ------------------------------------------------------- the graph contract

(def graph (contract "bonsai2-qwen35-runtime-v1.edn"))
(def artifact (:artifact graph))
(def architecture (:architecture graph))
(def attention (:attention architecture))
(def linear (:linear-attention architecture))
(def codecs (:codecs graph))
(def type-counts (:tensor-types graph))

;; GGUF's own type word for f32 is 0; the two the Bonsai profile adds carry
;; theirs in the contract's :codecs, so they are read rather than typed.
(defn- ggml-type [kind]
  (if (= kind :f32) 0 (or (get-in codecs [kind :ggml-type])
                          (die "the contract gives no ggml type for" kind))))

(def scalars
  (concat
   [["artifact-bytes" (:bytes artifact)]
    ["metadata-count" (:metadata-count artifact)]
    ["metadata-end" (:metadata-end artifact)]
    ["tensor-count" (:tensor-count artifact)]
    ["tensor-info-end" (:tensor-info-end artifact)]
    ["data-offset" (:data-offset artifact)]
    ["last-tensor-offset" (get-in artifact [:last-tensor :offset])]
    ["last-tensor-end" (get-in artifact [:last-tensor :end])]
    ;; The struct's `block_count` is the metadata's block count, which is the
    ;; trunk plus the MTP head: 65 for Qwen3.8, 64 here because there is none.
    ["block-count" (+ (:trunk-layers architecture) (:nextn-layers architecture))]
    ["trunk-layers" (:trunk-layers architecture)]
    ["linear-layers" (:linear-attention-layers architecture)]
    ["full-layers" (:full-attention-layers architecture)]
    ["full-attention-interval" (:full-attention-interval architecture)]
    ["nextn-layers" (:nextn-layers architecture)]
    ["embedding" (:embedding architecture)]
    ["feed-forward" (:feed-forward architecture)]
    ["vocabulary" (:vocabulary architecture)]
    ["context" (:context architecture)]
    ["attention-query-heads" (:query-heads attention)]
    ["attention-kv-heads" (:key-value-heads attention)]
    ["attention-head-dimension" (:head-dimension attention)]
    ["rope-dimensions" (:rope-dimensions attention)]
    ["linear-key-heads" (:key-heads linear)]
    ["linear-value-heads" (:value-heads linear)]
    ["linear-state-size" (:state-size linear)]
    ["linear-inner-size" (:inner-size linear)]
    ["linear-convolution-kernel" (:convolution-kernel linear)]
    ["type-count-f32" (:f32 type-counts)]
    ["type-count-bf16" (:bf16 type-counts)]
    ["type-count-ptq1-0" (:ptq1-0 type-counts)]
    ["ptq1-0-ggml-type" (ggml-type :ptq1-0)]
    ["bf16-ggml-type" (ggml-type :bf16)]]
   (map-indexed (fn [i v] [(str "rope-section-" i) v])
                (:rope-sections attention))))

(doseq [[name value] scalars]
  (when-not (number? value) (die "the graph contract gives no" name)))

;; ------------------------------------------------ the object's role numbers
;;
;; The tensor-table workspace stores a ROLE ID and `qwen35_slot` in the C is
;; the id -> field half of the mapping. To grade that half the gate needs the
;; id -> NAME half, and it is DECODED out of the object's own literal tables
;; rather than transcribed here: `role-length` gives the length of role i and
;; `role-word` the little-endian 8-byte words of its name. A transcription
;; would agree with a swapped pair in the C, which is the defect this exists
;; to catch (ffn_gate and ffn_up have the same shape and the same type, so
;; nothing but the name tells them apart).

(def role-source
  (.readFileSync fs (.join path aiueos "kotoba" "qwen35-tensor-table-bind.kotoba")
                 "utf8"))

(defn- literal-table [fn-name]
  (let [m (re-find (re-pattern (str "\\(defn " fn-name " \\[i\\]([\\s\\S]*?)\\n\\n"))
                   role-source)
        body (or (second m) "")]
    (into {} (map (fn [[_ i v]] [(js/parseInt i 10) v])
                  (re-seq #"\(=\s+i\s+(\d+)\)\s+(\d+)" body)))))

(def role-lengths (literal-table "role-length"))
(def role-words (literal-table "role-word"))
(when (empty? role-words)
  (die "the object's role-word table did not parse; this gate cannot name a role"))

;; The word is a 64-bit little-endian pack of eight name bytes and exceeds
;; 2^53, so it is read as a BigInt and taken apart as hex. No arithmetic is
;; done on it.
(defn- word-bytes [decimal]
  (let [hex (.padStart (.toString (js/BigInt decimal) 16) 16 "0")]
    (vec (reverse (for [i (range 8)]
                    (js/parseInt (.substring hex (* 2 i) (+ 2 (* 2 i))) 16))))))

(def role-names
  (vec (for [r (range 27)]
         (let [length (js/parseInt (get role-lengths r "0") 10)]
           (apply str (for [i (range length)]
                        (let [word (get role-words (+ (* r 4) (quot i 8)))]
                          (js/String.fromCharCode
                           (nth (word-bytes (or word "0")) (mod i 8))))))))))

(when-not (= 27 (count (distinct role-names)))
  (die "the object's tables decode to" (count (distinct role-names))
       "distinct role names, not 27:" (pr-str role-names)))
(when (some empty? role-names)
  (die "a role name decoded empty:" (pr-str role-names)))

(def role-kinds [[:every-layer "every"]
                 [:linear-attention-layer "linear"]
                 [:full-attention-layer "full"]
                 [:non-block "model"]])

(def role-lines
  (for [[key kind] role-kinds
        [name [dims type-kind]] (sort-by first (get (:tensor-roles graph) key))]
    (do
      (when-not (and (vector? dims) (<= 1 (count dims) 2))
        (die "role" name "has" (count dims) "dimensions"))
      [kind name (count dims) (first dims) (or (second dims) 0)
       (ggml-type type-kind)])))

;; The contract's own identity, checked before the C is handed anything: the
;; role table must cover every record exactly once. 48 x 9 + 16 x 6 + 64 x 5
;; + 3 = 851. A role table that does not add up would make the C's "one field
;; per record" assertion unreachable rather than false.
(def role-total
  (let [n (fn [kind] (count (filter #(= kind (first %)) role-lines)))]
    (+ (* (:linear-attention-layers architecture) (n "linear"))
       (* (:full-attention-layers architecture) (n "full"))
       (* (:trunk-layers architecture) (n "every"))
       (n "model"))))
(when-not (= role-total (:tensor-count artifact))
  (die "the contract's roles cover" role-total "records, not"
       (:tensor-count artifact)))

;; The two tables must be talking about the same graph: every role the
;; contract names has to be one of the object's 27, and what is left over has
;; to be exactly the four MTP roles this artifact does not carry. A contract
;; role the object cannot produce would make its expectation unreachable.
(def contract-role-names (set (map second role-lines)))
(when-not (every? (set role-names) contract-role-names)
  (die "the contract names roles the object does not:"
       (pr-str (remove (set role-names) contract-role-names))))
(when-not (= 4 (- (count role-names) (count contract-role-names)))
  (die "the object has" (count role-names) "roles and the contract"
       (count contract-role-names) "; the difference is not the four MTP roles"))

(println "EXPECTATIONS" (count scalars) "scalars," (count role-lines)
         "roles covering" role-total "records,"
         (count role-names) "role ids decoded from the object")

;; ----------------------------------------------------------------- the gate

(defn- which [program]
  (let [r (.spawnSync cp "sh" #js ["-c" (str "command -v " program)]
                      #js {:encoding "utf8"})]
    (when (zero? (.-status r)) (.trim (.-stdout r)))))

(def cc (or (.-CC js/process.env) "cc"))
(when-not (which cc) (unmeasured cc "is required to build this gate"))

(def work (.mkdtempSync fs (.join path (.tmpdir os) "aiueos-bonsai-translation-")))
(def kv-file (.join path work "bonsai-kv-plan.bin"))
(def tt-file (.join path work "bonsai-tensor-plan.bin"))
(def expect-file (.join path work "expectations.txt"))
(.writeFileSync fs kv-file (:bytes kv))
(.writeFileSync fs tt-file (:bytes tt))
(.writeFileSync fs expect-file
                (str "# rendered from contracts/bonsai2-qwen35-runtime-v1.edn\n"
                     (apply str (for [[name value] scalars]
                                  (str "n " name " " value "\n")))
                     (apply str (for [[kind name ndims d0 d1 type] role-lines]
                                  (str "role " kind " " name " " ndims " "
                                       d0 " " d1 " " type "\n")))
                     (apply str (map-indexed (fn [i name] (str "id " (inc i) " " name "\n"))
                                             role-names))))

(defn- run [& argv]
  (let [r (.spawnSync cp (first argv) (clj->js (rest argv))
                      #js {:stdio "inherit"})]
    (when-not (zero? (.-status r))
      (die (first argv) "exited" (.-status r)))))

(def flags ["-std=c11" "-O2" "-Wall" "-Wextra" "-Werror"])
(apply run (concat [cc] flags
                   ["-DAIUEOS_QWEN35_KOTOBA_ADMISSION"
                    "-DAIUEOS_QWEN35_TRANSLATION_ONLY"
                    "-c" "-o" (.join path work "translation.o")
                    (.join path aiueos "kernel" "qwen35_runtime.c")]))
(apply run (concat [cc] flags
                   [(.join path aiueos "tests" "bonsai_runtime_translation.c")
                    (.join path work "translation.o")
                    "-o" (.join path work "bonsai-runtime-translation")]))

(def result
  (.spawnSync cp (.join path work "bonsai-runtime-translation")
              #js [expect-file kv-file tt-file]
              #js {:encoding "utf8"}))
(print (.-stdout result))
(binding [*out* *err*] (print (.-stderr result)))
(when-not (zero? (.-status result))
  (die "the Bonsai translation gate exited" (.-status result)))
(when-not (.includes (.-stdout result) "AIUEOS_BONSAI_TRANSLATION_OK")
  (die "the gate exited 0 without printing its marker"))
(.rmSync fs work #js {:recursive true :force true})
