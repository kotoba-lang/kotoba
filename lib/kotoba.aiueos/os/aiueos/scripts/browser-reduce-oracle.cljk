#!/usr/bin/env kbb
;; The expected answers of os/aiueos/contracts/browser-reduce-v1.edn's success
;; vectors, taken from kotoba-lang/browser itself (ADR-0223, 0229, 0230):
;; browser.input/actions-for-event reduces each event against the input state
;; (pointer capture) and browser.surface/apply-actions applies the actions.
;; Neither browser-reduce.kotoba nor the kernel's C is consulted.
;;
;;   kbb --backend sci --classpath "$(cd ../browser && kbb -Spath)":os/aiueos/scripts \
;;     os/aiueos/scripts/browser-reduce-oracle.cljk            ; print the vectors
;;   ... browser-reduce-oracle.cljk --check os/aiueos/contracts/browser-reduce-v1.edn
;;
;; The 128-byte state is encoded as browser-reduce.kotoba's header says: words
;; 0..4 abi n focus vw vh, 5..24 id x y w h per window bottom first, 25 capture
;; kind (0 none, 1 drag, 2 resize), 26 captured id, 27 28 the drag offset or
;; the resize origin, 29 30 the resize's start size.
;;
;; One deliberate difference, and it is printed, not hidden: a move whose new
;; origin is below 0 is stored by browser.surface; the object refuses it (-6)
;; and changes nothing, because the u32 surface has no negative coordinate.
;;
;; Launcher and close (ADR-0233). browser.surface has the actions
;; (`launch-app`, `close-window`) but not the geometry: its window-node has no
;; close control and its launcher is a DOM row cssom lays out. The geometry
;; below is the kernel's, written here apart from the object: word 31 is the
;; app register (bit k-1 = app k); with it not 0, a press on a window at least
;; 40 wide inside x + w - 24 .. x + w - 8, y + 6 .. y + 22 (inclusive) is
;; :window/close, and a press on no window inside launcher button k
;; (x 6 + 102(k-1) .. + 96, y 2 .. 26) of a registered app is :app/launch. Both
;; clear the capture. What the actions DO is browser.surface's. Printed
;; differences: the launched window's id is the app's slot k, not open-window's
;; "w<n>"; a launch of an app whose window is open focuses it (the oracle
;; opens a second window); a close of the last window is refused (-8); a launch
;; whose default rect leaves the viewport is refused (-9).
;;
;; Window focus by id (ADR-0237): kind 5 is browser.surface's :window/focus
;; action applied as it is -- apply-action, nothing of browser.input -- with
;; the id the event names. The answer is that id when it is in the stack, 0
;; when it is not (focus-window leaves the surface as it was). browser.input
;; has no shortcut that yields this action; Alt+Tab's rule (the bottom
;; window) is the key object's and has its own vectors in browser-ime-v2.
;;
;; Wheel scroll (ADR-0238): kinds 6 and 7 are browser.input's :pointer/wheel
;; at (a, b) with delta-y +20 and -20 -- one notch, one line; the kernel's
;; choice -- and browser.surface applies the :window/scroll it yields (to the
;; window under the pointer, no focus, no raise, capture untouched; offset
;; clamped at 0). These vectors pass the whole 8192-byte surface: words
;; 2040..2043 are window id 1..4's vertical offset (`:window/scroll`'s second
;; element; 0 for an id with no window), seeded and asserted at byte 8160.
;; Printed differences: an offset past 65535 is refused (-12) where
;; browser.surface would store it; a close drops the offset with the window,
;; as browser.surface does, so the closed id's word reads 0.
;;
;; --check: exit 0 every generated vector equals the contract's vector of the
;; same name (seed, args, expected, expected memory); 1 one differs or is
;; missing; 2 could not run. It prints COMPARED<TAB>n; n = 0 is exit 2.
;; When browser.input cannot be loaded (the classpath lacks kotoba-lang/browser
;; or its deps), nbb stops before this file runs: exit 1 with no COMPARED line
;; -- read the line, not only the exit code.
(ns browser-reduce-oracle
  (:require [browser.input :as input]
            [browser.surface :as surface]
            [clojure.edn :as edn]
            ["node:fs" :as fs]))

(defn- hex [words]
  (let [buf (js/Buffer.alloc 128)]
    (doseq [[i v] (map-indexed vector words)] (.writeUInt32LE buf v (* 4 i)))
    (.toString buf "hex")))

(defn- hex-scroll [{:keys [surface]}]
  (let [buf (js/Buffer.alloc 16)
        ws (:surface/windows surface)]
    (doseq [id [1 2 3 4]
            :let [win (first (filter #(= id (:window/id %)) ws))]]
      (.writeUInt32LE buf (or (second (:window/scroll win)) 0) (* 4 (dec id))))
    (.toString buf "hex")))

(defn- encode [{:keys [surface input vw vh] :as w}]
  (let [ws (:surface/windows surface)
        cap (:pointer/capture input)]
    (hex (concat [1 (count ws) (:surface/focus surface) vw vh]
                 (mapcat (fn [w] (cons (:window/id w) (:window/rect w))) ws)
                 (repeat (* 5 (- 4 (count ws))) 0)
                 (case (:kind cap)
                   :drag [1 (:window-id cap) (first (:offset cap)) (second (:offset cap)) 0 0]
                   :resize (into [2 (:window-id cap)] (concat (:origin cap) (:start-size cap)))
                   [0 0 0 0 0 0])
                 [(or (:apps w) 0)]))))

(defn- world [focus rects]
  {:surface {:surface/windows (mapv (fn [[id x y w h]] {:window/id id :window/rect [x y w h]}) rects)
             :surface/focus focus}
   :input (input/empty-state)
   :vw 1280 :vh 800})

(def two (world 2 [[1 32 32 720 540] [2 96 72 640 480]]))
(defn- shell [w apps] (assoc w :apps apps))
(def three (world 3 [[1 32 32 720 540] [2 96 72 640 480] [3 400 300 300 200]]))
;; After the kernel's drag (ADR-0229): window 1 raised and moved to (272, 132).
(def dragged (world 1 [[2 96 72 640 480] [1 272 132 720 540]]))
;; After the kernel's caret (ADR-0232): window 1 resized, window 2 moved and
;; raised by the event loop.
(def caret (world 2 [[1 272 132 240 200] [2 196 172 640 480]]))

(def ^:private kinds {:pointer/down 1 :keyboard/key 2 :pointer/move 3 :pointer/up 4
                      :window/focus 5 :pointer/wheel-down 6 :pointer/wheel-up 7})

(defn- scrolled
  "w with window id's vertical offset at y."
  [w id y]
  (update-in w [:surface :surface/windows]
             (fn [ws] (mapv #(if (= id (:window/id %)) (assoc % :window/scroll [0 y]) %) ws))))

(declare step-plain wheel-step)

(defn- in-close? [[px py] [x y w _h]]
  (and (>= w 40) (<= (- (+ x w) 24) px (- (+ x w) 8)) (<= (+ y 6) py (+ y 22))))

(defn- button-at [apps [px py]]
  (when (<= 2 py 26)
    (first (filter #(and (pos? (bit-and apps (bit-shift-left 1 (dec %))))
                         (<= (+ 6 (* 102 (dec %))) px (+ 6 (* 102 (dec %)) 96)))
                   [1 2 3 4]))))

(defn- chrome-step
  "A press on the kernel's chrome, or nil when the press is not on it."
  [{:keys [surface input apps vw vh] :as w} point]
  (let [hit (input/window-at surface point)
        input' (assoc input :pointer/position point :pointer/capture nil)]
    (cond
      (and hit (in-close? point (:window/rect hit)))
      (if (= 1 (count (:surface/windows surface)))
        [w -8]
        (let [s (surface/apply-action surface {:action :window/close :window-id (:window/id hit)})]
          [(assoc w :surface s :input input') (:surface/focus s)]))

      hit nil

      :else
      (when-let [k (button-at apps point)]
        (cond
          (some #(= k (:window/id %)) (:surface/windows surface))
          (let [s (surface/apply-action surface {:action :window/focus :window-id k})]
            [(assoc w :surface s :input input') k])

          (or (< vw 600) (< vh 440)) [w -9]

          :else
          (let [s (surface/apply-action
                   (assoc surface :surface/apps [{:app/id k}] :surface/next-window-id 1)
                   {:action :app/launch :app-id k})
                s (-> s
                      (update :surface/windows
                              (fn [ws] (mapv #(if (= "w1" (:window/id %)) (assoc % :window/id k) %) ws)))
                      (assoc :surface/focus k))]
            [(assoc w :surface s :input input') k]))))))

(defn- step
  "Reduce one event through the oracle: [world' answer]."
  [{:keys [surface input apps] :as w} [t a b]]
  (or (when (= t :window/focus)
        (let [s (surface/apply-action surface {:action :window/focus :window-id a})]
          [(assoc w :surface s)
           (if (some #(= a (:window/id %)) (:surface/windows surface)) a 0)]))
      (when (#{:pointer/wheel-down :pointer/wheel-up} t)
        (wheel-step w [t a b]))
      (when (and (= t :pointer/down) (pos? (or apps 0)))
        (chrome-step w [a b]))
      (step-plain w [t a b])))

(defn- wheel-step
  "browser.input :pointer/wheel, one notch (delta-y +-20), through
  browser.surface; the kernel refuses an offset past 65535."
  [{:keys [surface input] :as w} [t a b]]
  (let [{input' :input actions :actions}
        (input/actions-for-event surface input {:event/type :pointer/wheel :x a :y b
                                                :delta-x 0
                                                :delta-y (if (= t :pointer/wheel-down) 20 -20)})
        act (first actions)
        surface' (surface/apply-actions surface actions)
        after (some #(when (= (:window-id act) (:window/id %)) (second (:window/scroll %)))
                    (:surface/windows surface'))]
    (if (and act (> after 65535))
      [w -12]
      [(assoc w :surface surface' :input input') (if act (:window-id act) 0)])))

(defn- step-plain
  [{:keys [surface input] :as w} [t a b]]
  (let [ev (if (= t :keyboard/key)
             {:event/type :keyboard/key :key a}
             {:event/type t :x a :y b})
        {input' :input actions :actions} (input/actions-for-event surface input ev)
        surface' (surface/apply-actions surface actions)
        act (first actions)
        answer (case t
                 :pointer/down (if act (:window-id act) 0)
                 :keyboard/key (:surface/focus surface)
                 :pointer/move (if act (:window-id act) 0)
                 :pointer/up 0)
        negative? (some neg? (:position act))]
    (if negative?
      [w -6]
      [(assoc w :surface surface' :input input') answer])))

(defn- run [w events] (reduce (fn [w e] (first (step w e))) w events))

;; Every tablet event and window-manager focus of the kernel's stages from the
;; launcher (ADR-0233) to the end of Alt+Tab (ADR-0237), in order.
(def ^:private focus-cycle-events
  [[:pointer/down 258 14] [:pointer/up 258 14] [:pointer/down 584 94] [:pointer/up 584 94]
   [:pointer/down 258 14] [:pointer/up 258 14] [:pointer/down 820 186] [:pointer/up 820 186]
   [:pointer/move 400 300] [:pointer/move 700 450] [:pointer/move 1276 796]
   [:pointer/down 1000 600] [:pointer/up 1000 600]
   [:pointer/down 150 14] [:pointer/up 150 14] [:window/focus 1] [:window/focus 3] [:window/focus 2]])

;; name, starting world, events before the one under test, the event.
(def cases
  [[:pointer-down-in-window-1-titlebar-raises-and-captures-a-drag two [] [:pointer/down 40 40]]
   [:pointer-down-on-the-overlap-hits-the-front two [] [:pointer/down 100 80]]
   [:pointer-down-on-the-inclusive-far-corner two [] [:pointer/down 752 572]]
   [:pointer-down-one-past-the-corner-misses two [] [:pointer/down 753 572]]
   [:pointer-down-on-the-bare-desktop-misses two [] [:pointer/down 1000 700]]
   [:pointer-down-raises-from-the-bottom-of-three three [] [:pointer/down 40 40]]
   [:key-goes-to-the-focused-window two [] [:keyboard/key 30 1]]
   [:titlebar-foot-is-inclusive two [] [:pointer/down 40 60]]
   [:one-below-the-titlebar-captures-nothing two [] [:pointer/down 40 61]]
   [:a-body-press-clears-the-capture two [[:pointer/down 40 40]] [:pointer/down 200 300]]
   [:a-resize-handle-press-clears-the-capture two [[:pointer/down 40 40]] [:pointer/down 752 572]]
   [:a-miss-leaves-the-capture two [[:pointer/down 40 40]] [:pointer/down 1000 700]]
   [:move-under-a-drag-moves-by-the-delta two [[:pointer/down 40 40]] [:pointer/move 140 90]]
   [:second-move-is-from-the-press-not-the-last-move two [[:pointer/down 40 40] [:pointer/move 140 90]] [:pointer/move 300 150]]
   [:dragging-window-2-leaves-window-1 two [[:pointer/down 100 80]] [:pointer/move 50 40]]
   [:move-to-the-origin two [[:pointer/down 40 40]] [:pointer/move 8 8]]
   [:move-one-past-the-origin-is-refused two [[:pointer/down 40 40]] [:pointer/move 7 8]]
   [:move-without-a-capture-moves-nothing two [] [:pointer/move 500 500]]
   [:up-clears-the-capture two [[:pointer/down 40 40] [:pointer/move 140 90]] [:pointer/up 140 90]]
   [:move-after-up-moves-nothing two [[:pointer/down 40 40] [:pointer/move 140 90] [:pointer/up 140 90]] [:pointer/move 400 400]]
   [:the-kernel-drag two [[:pointer/down 60 50] [:pointer/down 60 50] [:pointer/move 140 90] [:pointer/move 220 120]] [:pointer/move 300 150]]
   ;; ADR-0230: the resize capture. Window 1's handle is x 736..752, y 556..572.
   [:a-handle-press-captures-a-resize two [] [:pointer/down 745 565]]
   [:the-handle-corner-is-inclusive two [] [:pointer/down 736 556]]
   [:one-left-of-the-handle-captures-nothing two [] [:pointer/down 735 572]]
   [:one-above-the-handle-captures-nothing two [] [:pointer/down 752 555]]
   [:a-titlebar-press-replaces-a-resize two [[:pointer/down 752 572]] [:pointer/down 40 40]]
   [:a-handle-press-replaces-a-drag two [[:pointer/down 40 40]] [:pointer/down 752 572]]
   [:resize-grows-by-the-travel two [[:pointer/down 752 572]] [:pointer/move 800 600]]
   [:second-resize-move-is-from-the-press two [[:pointer/down 752 572] [:pointer/move 800 600]] [:pointer/move 700 500]]
   [:width-121-is-not-clamped two [[:pointer/down 752 572]] [:pointer/move 153 572]]
   [:width-120-exactly two [[:pointer/down 752 572]] [:pointer/move 152 572]]
   [:width-119-clamps-to-120 two [[:pointer/down 752 572]] [:pointer/move 151 572]]
   [:height-81-is-not-clamped two [[:pointer/down 752 572]] [:pointer/move 752 113]]
   [:height-79-clamps-to-80 two [[:pointer/down 752 572]] [:pointer/move 752 111]]
   [:travel-past-the-size-clamps-not-wraps two [[:pointer/down 752 572]] [:pointer/move 0 0]]
   [:resizing-window-2-leaves-window-1 two [[:pointer/down 730 545]] [:pointer/move 830 645]]
   [:up-clears-a-resize two [[:pointer/down 752 572] [:pointer/move 800 600]] [:pointer/up 800 600]]
   [:move-after-a-resize-up-resizes-nothing two [[:pointer/down 752 572] [:pointer/move 800 600] [:pointer/up 800 600]] [:pointer/move 900 700]]
   [:the-kernel-resize-clamps dragged [[:pointer/down 984 664] [:pointer/move 784 564]] [:pointer/move 300 200]]
   [:the-kernel-resize dragged [[:pointer/down 984 664] [:pointer/move 784 564] [:pointer/move 300 200]] [:pointer/move 504 324]]
   ;; ADR-0233: launcher and close. Register 7 = apps 1 2 3. Button 3 is
   ;; x 210..306; window 1's close control x 728..744, y 38..54 (window 2 is
   ;; below y 72 there); window 3 of `three` has x 676..692, y 306..322.
   [:a-launcher-press-opens-the-app-on-top-focused (shell two 7) [] [:pointer/down 258 14]]
   [:the-launcher-button-top-left-is-inclusive (shell two 7) [] [:pointer/down 210 2]]
   [:the-launcher-button-bottom-right-is-inclusive (shell two 7) [] [:pointer/down 306 26]]
   [:one-right-of-a-launcher-button-misses (shell two 7) [] [:pointer/down 307 14]]
   [:one-below-the-launcher-buttons-misses (shell two 7) [] [:pointer/down 258 27]]
   [:an-unregistered-app-has-no-button (shell two 7) [] [:pointer/down 360 14]]
   [:without-a-register-the-launcher-is-bare-desktop two [] [:pointer/down 258 14]]
   [:launching-an-open-app-raises-and-focuses-it (shell two 7) [] [:pointer/down 54 14]]
   [:a-launch-clears-a-capture (shell two 7) [[:pointer/down 40 40]] [:pointer/down 258 14]]
   [:a-fourth-launch-fills-the-stack (shell three 15) [] [:pointer/down 360 14]]
   [:a-close-of-the-focused-window-focuses-the-top (shell three 7) [] [:pointer/down 684 314]]
   [:a-close-of-an-unfocused-window-keeps-the-focus (shell two 7) [] [:pointer/down 736 46]]
   [:a-close-from-the-bottom-of-three-shifts-the-stack (shell three 7) [] [:pointer/down 736 46]]
   [:the-close-control-top-left-is-inclusive (shell two 7) [] [:pointer/down 728 38]]
   [:the-close-control-bottom-right-is-inclusive (shell two 7) [] [:pointer/down 744 54]]
   [:one-right-of-the-close-control-is-titlebar (shell two 7) [] [:pointer/down 745 46]]
   [:one-left-of-the-close-control-is-titlebar (shell two 7) [] [:pointer/down 727 46]]
   [:one-below-the-close-control-is-titlebar (shell two 7) [] [:pointer/down 736 55]]
   [:without-a-register-the-close-control-is-titlebar two [] [:pointer/down 736 46]]
   [:a-window-under-40-wide-has-no-close-control (shell (world 2 [[1 32 32 720 540] [2 800 100 39 100]]) 7) [] [:pointer/down 820 110]]
   [:a-close-clears-a-capture (shell two 7) [[:pointer/down 100 80]] [:pointer/down 736 46]]
   [:closing-the-last-window-is-refused (shell (world 1 [[1 32 32 720 540]]) 7) [] [:pointer/down 736 46]]
   [:a-launch-past-the-viewport-is-refused (assoc (shell two 7) :vw 599) [] [:pointer/down 258 14]]
   [:the-kernel-launch (shell caret 7) [] [:pointer/down 258 14]]
   [:the-kernel-close-of-3 (shell caret 7) [[:pointer/down 258 14] [:pointer/up 258 14]] [:pointer/down 584 94]]
   [:the-kernel-close-of-2 (shell caret 7) [[:pointer/down 258 14] [:pointer/up 258 14] [:pointer/down 584 94] [:pointer/up 584 94] [:pointer/down 258 14] [:pointer/up 258 14]] [:pointer/down 820 186]]
   ;; ADR-0237: :window/focus by id (kind 5), the action Alt+Tab becomes.
   [:a-focus-action-raises-the-bottom-of-two two [] [:window/focus 1]]
   [:a-focus-action-on-the-top-keeps-the-stack two [] [:window/focus 2]]
   [:a-focus-action-raises-the-bottom-of-three three [] [:window/focus 1]]
   [:a-focus-action-raises-the-middle-of-three three [] [:window/focus 2]]
   [:a-focus-action-of-an-unknown-id-changes-nothing two [] [:window/focus 3]]
   [:a-focus-action-of-id-0-changes-nothing two [] [:window/focus 0]]
   [:a-focus-action-of-id-5-changes-nothing (world 1 [[1 32 32 720 540]]) [] [:window/focus 5]]
   [:a-focus-action-keeps-a-drag-capture two [[:pointer/down 100 80]] [:window/focus 1]]
   [:a-focus-action-keeps-a-resize-capture two [[:pointer/down 730 545]] [:window/focus 1]]
   [:a-focus-action-keeps-the-app-register (shell three 7) [] [:window/focus 1]]
   [:a-focus-action-in-a-full-stack (shell (world 4 [[1 32 32 720 540] [2 96 72 640 480] [3 400 300 300 200] [4 80 80 520 360]]) 15) [] [:window/focus 1]]
   [:three-bottom-focuses-rotate-three-back (shell three 7) [[:window/focus 1] [:window/focus 2]] [:window/focus 3]]
   [:the-kernel-focus-cycle (shell caret 7)
    (pop focus-cycle-events)
    [:window/focus 2]]
   ;; ADR-0238: the wheel, over the whole surface (state-bytes 8192). In `two`
   ;; (40, 300) is window 1 alone, (400, 300) window 2 over window 1.
   [:a-wheel-over-the-back-window-scrolls-it-without-focus-or-raise two [] [:pointer/wheel-down 40 300] :surface]
   [:a-wheel-over-the-front-window-scrolls-it two [] [:pointer/wheel-down 400 300] :surface]
   [:a-wheel-on-the-bare-desktop-scrolls-nothing two [] [:pointer/wheel-down 1000 700] :surface]
   [:a-wheel-on-the-inclusive-far-corner two [] [:pointer/wheel-down 752 572] :surface]
   [:a-wheel-one-past-the-corner-misses two [] [:pointer/wheel-down 753 572] :surface]
   [:a-wheel-over-a-launcher-button-launches-nothing (shell two 7) [] [:pointer/wheel-down 258 14] :surface]
   [:a-wheel-up-at-0-stays-at-0 two [] [:pointer/wheel-up 400 300] :surface]
   [:a-wheel-up-after-two-downs two [[:pointer/wheel-down 400 300] [:pointer/wheel-down 400 300]] [:pointer/wheel-up 400 300] :surface]
   [:a-wheel-up-from-10-clamps-at-0 (scrolled two 2 10) [] [:pointer/wheel-up 400 300] :surface]
   [:each-window-keeps-its-own-offset two [[:pointer/wheel-down 40 300]] [:pointer/wheel-down 400 300] :surface]
   [:a-wheel-keeps-a-drag-capture two [[:pointer/down 100 80]] [:pointer/wheel-down 40 300] :surface]
   [:a-wheel-keeps-a-resize-capture two [[:pointer/down 730 545]] [:pointer/wheel-down 40 300] :surface]
   [:an-offset-follows-its-window-when-raised (scrolled two 1 40) [] [:pointer/down 40 300] :surface]
   [:an-offset-at-65515-reaches-65535 (scrolled two 2 65515) [] [:pointer/wheel-down 400 300] :surface]
   [:an-offset-past-65535-is-refused (scrolled two 2 65516) [] [:pointer/wheel-down 400 300] :surface]
   [:an-offset-past-65535-can-still-go-up (scrolled two 2 65535) [] [:pointer/wheel-up 400 300] :surface]
   [:a-close-drops-the-closed-windows-offset (shell (scrolled three 3 40) 7) [] [:pointer/down 684 314] :surface]
   [:a-close-keeps-the-other-offsets (shell (scrolled (scrolled three 1 20) 3 40) 7) [] [:pointer/down 684 314] :surface]
   [:a-launch-after-a-close-opens-at-0 (shell (scrolled three 3 40) 7) [[:pointer/down 684 314] [:pointer/up 684 314]] [:pointer/down 258 14] :surface]
   [:the-kernel-scroll-miss (assoc (run (shell caret 7) focus-cycle-events) :apps 15)
    [[:pointer/down 360 14] [:pointer/up 360 14]] [:pointer/wheel-down 360 14] :surface]
   [:the-kernel-scroll-down (assoc (run (shell caret 7) focus-cycle-events) :apps 15)
    (into [[:pointer/down 360 14] [:pointer/up 360 14] [:pointer/wheel-down 360 14] [:pointer/move 300 300]]
          (repeat 5 [:pointer/wheel-down 300 300]))
    [:pointer/wheel-down 300 300] :surface]
   [:the-kernel-scroll-back (assoc (run (shell caret 7) focus-cycle-events) :apps 15)
    (-> [[:pointer/down 360 14] [:pointer/up 360 14] [:pointer/wheel-down 360 14] [:pointer/move 300 300]]
        (into (repeat 6 [:pointer/wheel-down 300 300]))
        (into (repeat 6 [:pointer/wheel-up 300 300])))
    [:pointer/wheel-up 300 300] :surface]])

(defn vectors []
  (for [[nm w0 before [t a b :as ev] whole] cases
        :let [w (run w0 before)
              [w' answer] (step w ev)]]
    (if whole
      {:name nm
       :seed [{:offset 0 :hex (encode w)} {:offset 8160 :hex (hex-scroll w)}]
       :args [:state 8192 (kinds t) a (or b 0)]
       :expected answer
       :expect-memory [{:label :state :offset 0 :hex (encode w')}
                       {:label :scroll :offset 8160 :hex (hex-scroll w')}]}
      {:name nm
       :seed [{:offset 0 :hex (encode w)}]
       :args [:state 128 (kinds t) a (or b 0)]
       :expected answer
       :expect-memory [{:label :state :offset 0 :hex (encode w')}]})))

(def ^:private args (vec (remove #(= "--" %) *command-line-args*)))

(if (= "--check" (first args))
  (let [contract (try (edn/read-string (str (.readFileSync fs (second args))))
                      (catch :default e (.error js/console "COULD-NOT-RUN" (str e)) (.exit js/process 2)))
        by-name (into {} (map (juxt :name identity)) (:vectors contract))
        gen (vectors)
        bad (remove #(= % (select-keys (by-name (:name %)) [:name :seed :args :expected :expect-memory])) gen)]
    (println (str "COMPARED\t" (count gen)))
    (doseq [v bad] (println "DIFFERS" (:name v)))
    (.exit js/process (cond (zero? (count gen)) 2 (seq bad) 1 :else 0)))
  (doseq [v (vectors)] (prn v)))
