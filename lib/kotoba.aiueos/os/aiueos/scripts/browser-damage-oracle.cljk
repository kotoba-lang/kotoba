;; Vectors for os/aiueos/contracts/browser-damage-v1.edn (ADR-0242), written
;; from the rule in the ADR -- not from browser-damage.kotoba and not from the
;; C -- and checked against painting:
;;
;;   kbb --backend sci os/aiueos/scripts/browser-damage-oracle.cljk          prints the vectors
;;   kbb --backend sci os/aiueos/scripts/browser-damage-oracle.cljk --check <contract>
;;
;; For each success vector the answer's rectangle must contain every pixel
;; that painting the previous list and the current one (rects filled, a glyph
;; as its whole width x 16 box) leaves different. --check compares the
;; contract's vectors with these and prints COMPARED <n>; exit 0 all equal,
;; 1 one differs, 2 could not run (0 compared is 2, not a pass).

(ns browser-damage-oracle
  (:require [clojure.edn :as edn]
            ["node:fs" :as fs]))

(def ops-at 0)
(def shadow-at 6272)

(defn- op-box [[k x y a b]]
  (if (= k 1) [x y (+ x a) (+ y b)] [x y (+ x b) (+ y 16)]))

(defn answer
  "[slots-that-differ [x y w h]] for painting `cur` after `prev` (nil: none)."
  [prev cur vw vh]
  (if (nil? prev)
    [(count cur) [0 0 vw vh]]
    (let [js (vec (filter #(not= (get prev %) (get cur %)) (range (max (count prev) (count cur)))))
          bs (for [j js o [(get prev j) (get cur j)] :when o] (op-box o))]
      (if (empty? js)
        [0 [0 0 0 0]]
        (let [x0 (min vw (reduce min (map #(nth % 0) bs))) y0 (min vh (reduce min (map #(nth % 1) bs)))
              x1 (min vw (reduce max (map #(nth % 2) bs))) y1 (min vh (reduce max (map #(nth % 3) bs)))]
          [(count js) [x0 y0 (- x1 x0) (- y1 y0)]])))))

(defn- paint [ops vw vh]
  (let [px (vec (repeat (* vw vh) 0))]
    (reduce (fn [px [k x y a b c]]
              (let [[x0 y0 x1 y1] (op-box [k x y a b])]
                (reduce (fn [px i] (assoc px i (if (= k 1) c (+ 16777216 a))))
                        px
                        (for [yy (range y0 (min y1 vh)) xx (range x0 (min x1 vw))] (+ (* yy vw) xx)))))
            px ops)))

(defn- contains-painted-difference? [prev cur vw vh [x y w h]]
  (let [a (paint (or prev []) vw vh) b (paint cur vw vh)]
    (every? (fn [i] (or (= (a i) (b i))
                        (and (nil? prev) true)
                        (let [px (mod i vw) py (quot i vw)]
                          (and (<= x px) (< px (+ x w)) (<= y py) (< py (+ y h))))))
            (range (* vw vh)))))

(defn- u32-hex [ws]
  (apply str (map (fn [w] (let [b (js/Buffer.alloc 4)] (.writeUInt32LE b w 0) (.toString b "hex"))) ws)))

(defn- shadow-words [prev vw vh]
  (into [(count (or prev [])) 0 0 0 0 vw vh 0] (mapcat identity (or prev []))))

(defn success [nm prev cur vw vh]
  (let [[d [x y w h]] (answer prev cur vw vh)]
    (when-not (contains-painted-difference? prev cur vw vh [x y w h])
      (throw (ex-info "the rule's answer misses a painted difference" {:vector nm})))
    {:name nm
     :seed [{:offset ops-at :hex (u32-hex (mapcat identity cur))}
            {:offset shadow-at :hex (u32-hex (shadow-words prev vw vh))}]
     :args [:ops 6264 :shadow 8192 (count cur)]
     :expected d
     :expect-memory [{:label :shadow :offset shadow-at
                      :hex (u32-hex (into [(count cur) x y w h vw vh 0] (mapcat identity cur)))}]}))

(defn refusal [nm prev cur vw vh args expected]
  (let [sh (shadow-words prev vw vh)]
    {:name nm
     :seed [{:offset ops-at :hex (u32-hex (mapcat identity cur))}
            {:offset shadow-at :hex (u32-hex sh)}]
     :args args
     :expected expected
     :expect-memory [{:label :shadow-untouched :offset shadow-at :hex (u32-hex sh)}]}))

(def base [[1 0 0 64 48 16119544] [1 4 4 30 20 16777215] [2 8 6 3 8 1118481]])

(defn- rects [n] (vec (for [i (range n)] [1 (mod i 60) (mod (quot i 60) 40) 4 8 i])))

(def vectors
  (let [moved (assoc base 1 [1 10 12 30 20 16777215])
        recoloured (assoc-in base [1 5] 14215167)
        reglyphed (assoc-in base [2 3] 4)
        narrow (assoc base 2 [2 8 6 3 16 1118481])
        grown (conj base [1 50 30 6 6 255])
        two (-> base (assoc 1 [1 4 4 30 21 16777215]) (conj [1 60 40 2 2 1]))
        past (conj base [1 56 44 20 20 7])
        many (rects 261)
        many-last (assoc many 260 [1 1 1 1 1 1])]
    [(success :no-previous-frame-is-the-whole-viewport nil base 64 48)
     (success :the-same-list-sends-nothing base base 64 48)
     (success :a-moved-rect-sends-where-it-was-and-where-it-is base moved 64 48)
     (success :a-colour-change-sends-the-rect base recoloured 64 48)
     (success :a-changed-glyph-sends-its-width-by-16 base reglyphed 64 48)
     (success :a-glyph-width-change-sends-both-widths base narrow 64 48)
     (success :an-op-added-sends-its-box base grown 64 48)
     (success :an-op-removed-sends-where-it-was grown base 64 48)
     (success :two-changes-send-their-union base two 64 48)
     (success :a-box-past-the-viewport-is-cut base past 64 48)
     (success :261-ops-after-none nil many 64 48)
     (success :261-ops-the-last-changed many many-last 64 48)
     (success :261-ops-all-changed many (mapv (fn [[k x y a b c]] [k x y a b (inc c)]) many) 64 48)
     (refusal :null-ops-refused base base 64 48 [0 6264 :shadow 8192 3] -1)
     (refusal :null-shadow-refused base base 64 48 [:ops 6264 0 8192 3] -1)
     (refusal :a-shadow-not-8192-bytes-refused base base 64 48 [:ops 6264 :shadow 8188 3] -1)
     (refusal :count-0-refused base base 64 48 [:ops 6264 :shadow 8192 0] -2)
     (refusal :count-262-refused base base 64 48 [:ops 6264 :shadow 8192 262] -2)
     (refusal :ops-bytes-under-count-refused base base 64 48 [:ops 71 :shadow 8192 3] -2)
     (refusal :a-shadow-without-a-width-refused base base 0 48 [:ops 6264 :shadow 8192 3] -3)
     (refusal :a-shadow-without-a-height-refused base base 64 0 [:ops 6264 :shadow 8192 3] -3)
     (let [v (refusal :a-previous-count-past-261-refused base base 64 48 [:ops 6264 :shadow 8192 3] -3)]
       (-> v
           (assoc-in [:seed 1 :hex] (str (u32-hex [262]) (subs (get-in v [:seed 1 :hex]) 8)))
           (assoc-in [:expect-memory 0 :hex] (str (u32-hex [262]) (subs (get-in v [:seed 1 :hex]) 8)))))
     (refusal :a-current-op-of-kind-3-refused base (assoc-in base [2 0] 3) 64 48 [:ops 6264 :shadow 8192 3] -4)
     (refusal :a-previous-op-of-kind-0-refused (assoc-in base [1 0] 0) base 64 48 [:ops 6264 :shadow 8192 3] -4)]))

(let [args (vec (remove #(= "--" %) *command-line-args*))]
  (if (= "--check" (first args))
    (let [contract (try (edn/read-string (str (.readFileSync fs (get args 1))))
                        (catch :default e (println "COULD-NOT-RUN" (str e)) (.exit js/process 2)))
          theirs (into {} (map (juxt :name identity) (:vectors contract)))
          mine vectors
          diffs (for [v mine :let [t (theirs (:name v))]
                      :when (not= (select-keys v [:seed :args :expected :expect-memory])
                                  (select-keys t [:seed :args :expected :expect-memory]))]
                  (:name v))]
      (println (str "COMPARED\t" (count (filter #(theirs (:name %)) mine))))
      (doseq [d diffs] (println "DIFFERS" d))
      (.exit js/process (cond (zero? (count theirs)) 2 (seq diffs) 1 :else 0)))
    (doseq [v vectors] (prn v))))
