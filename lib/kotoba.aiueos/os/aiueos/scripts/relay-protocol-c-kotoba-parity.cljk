;; native/relay_{line,text}.kotoba and kotoba/relay-hello-payload.kotoba are TWO
;; Kotoba implementations of one wire line: the generated template pair serves
;; debug_link.kotoba and murakumo-join-plan.kotoba, the kernel object serves
;; pci.c's rtl8125 relay qualification. Until 2026-09-11 the second one was C
;; (kernel/relay_protocol.c) and this gate compiled it as the oracle; ADR-0215
;; retired the C, so the oracle is now the bytes that C produced, RECORDED in
;; os/aiueos/contracts/relay-hello-v1.edn (vector :hello-1) and executed
;; against the kernel object's source by verify-admissions.cljk. This gate
;; keeps the drift alarm between the template pair and that record: edit
;; relay_text.kotoba alone, or the recorded line alone, and it goes red.
;;
;; The comparison masks the two VARIABLE fields (boot=, mac=) because the
;; template side stores a skeleton and overwrites them in place, so a template
;; carries '0' where the record carries a value. Everything outside those two
;; spans -- the banner, the separators, the profile suffix, and the total
;; length -- is compared byte for byte.
;;
;; Usage: kbb --backend sci os/aiueos/scripts/relay-protocol-c-kotoba-parity.cljk
(ns relay-protocol-c-kotoba-parity
  (:require ["fs" :as fs] ["path" :as path]))

(def repo (path/resolve (path/join (path/dirname *file*) ".." ".." "..")))
(def aiueos (path/join repo "os" "aiueos"))
(def relay-text (path/join aiueos "native" "relay_text.kotoba"))
(def hello-contract (path/join aiueos "contracts" "relay-hello-v1.edn"))

;; "AIUEOS_NODE_HELLO_V1 boot=" is 26 bytes, then 16 hex; " mac=" is 5, then 17.
(def boot-span [26 42])
(def mac-span [47 64])
(def hello-kind 0)

(defn die [code & msg]
  (js/console.error (apply str msg))
  (js/process.exit code))

(defn template-words
  "The packed i64 words of template `kind` from the generated Kotoba source.

  relay_text.kotoba is generated and stores each line as ASCII packed eight
  bytes to an i64, low byte first, inside a nest of `(if (= index N) <word>`.
  Reading the words rather than the comment above them is deliberate: the
  comment is prose and the words are what the board transmits."
  [kind]
  (let [text (fs/readFileSync relay-text "utf8")
        block (second (re-find (re-pattern (str "\\(if \\(= kind " kind "\\)([\\s\\S]*?)\\n\\n"))
                               text))]
    (when-not block
      (die 2 "REFUSED: no template block for kind " kind " in " relay-text))
    (let [ws (map #(js/BigInt (second %))
                  (re-seq #"\(if \(= index \d+\) (\d+)" block))]
      (when (empty? ws)
        (die 2 "REFUSED: template block for kind " kind " parsed to zero words"))
      ws)))

(defn words->bytes [words]
  (js/Buffer.from
   (into-array
    (for [w words
          i (range 8)
          :let [c (js/Number (js/BigInt.asUintN 8 (/ w (js/BigInt (js/Math.pow 2 (* 8 i))))))]
          :when (pos? c)]
      c))))

(defn mask
  "Overwrite the variable spans with '0', the byte the skeleton carries."
  [buf]
  (let [copy (js/Buffer.from buf)]
    (doseq [[from to] [boot-span mac-span]
            i (range from to)]
      (aset copy i 48))
    copy))

(defn recorded-oracle
  "The 91 bytes kernel/relay_protocol.c produced for ADR-0213's inputs, as the
  contract records them (vector :hello-1 of relay-hello-v1.edn). The record is
  what verify-admissions.cljk executes the kernel object against, so reading
  it here rather than a second copy keeps one oracle for both checks."
  []
  (let [c (cljs.reader/read-string (fs/readFileSync hello-contract "utf8"))
        v (first (filter #(= :hello-1 (:name %)) (:vectors c)))
        hex (some :hex (:expect-memory v))]
    (when-not (string? hex)
      (die 2 "REFUSED: relay-hello-v1.edn carries no :hello-1 expect-memory hex"))
    (js/Buffer.from hex "hex")))

(defn -main []
  (let [kot (words->bytes (template-words hello-kind))
        c (recorded-oracle)
        masked (mask c)
        agree? (zero? (.compare js/Buffer masked kot))
        ;; Discrimination, every run. A comparison that has only ever agreed is
        ;; indistinguishable from one that always agrees.
        flipped (let [b (js/Buffer.from c)] (aset b (dec (.-length b)) 88) (mask b))
        in-field (let [b (js/Buffer.from c)] (aset b 30 57) (mask b))
        neg-fixed (zero? (.compare js/Buffer flipped kot))
        neg-var (zero? (.compare js/Buffer in-field kot))]
    (println (str "RELAY-PARITY recorded-bytes=" (.-length c)
                  " kotoba-bytes=" (.-length kot)
                  " agree=" agree?))
    (println (str "  record" (pr-str (.toString c "utf8"))))
    (println (str "  kotoba" (pr-str (.toString kot "utf8"))))
    (println (str "DISCRIMINATES fixed-byte-flipped=" neg-fixed " (false required)"
                  " variable-field-changed=" neg-var " (true required)"))
    (println "SCANNED 3")
    (if (and agree? (not neg-fixed) neg-var)
      (do (println "RELAY-PARITY-OK the recorded C line and the Kotoba template are the same wire format")
          (js/process.exit 0))
      (do (js/console.error "FAIL the template and the recorded line disagree")
          (js/process.exit 1)))))

(-main)
