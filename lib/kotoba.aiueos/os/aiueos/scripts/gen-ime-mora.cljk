#!/usr/bin/env kbb
;; The romaji table of browser-ime.kotoba (ADR-0225), generated from the hosted
;; IME oracle's own `aiueos.compositor.ime/mora`, so the kernel object and the
;; oracle cannot hold two tables that drift.
;;
;;   kbb --backend sci --classpath src:../text/src os/aiueos/scripts/gen-ime-mora.cljk --write
;;   kbb --backend sci --classpath src:../text/src os/aiueos/scripts/gen-ime-mora.cljk --check
;;
;; It rewrites (or compares) the region between `;; BEGIN GENERATED MORA` and
;; `;; END GENERATED MORA` in os/aiueos/kotoba/browser-ime.kotoba. Each romaji
;; key of 1..3 ASCII bytes, packed big-endian into one integer, becomes one
;; arm of `mora1` / `mora2` / `mora3`, returning the kana packed as cp1 * 65536 + cp2 (cp2 = 0 for one kana), or 0.
;;
;; Exit 0 written / identical, 1 --check differs, 2 could not run (no markers,
;; an entry that is not ASCII or longer than 3, a kana longer than 2).
(ns gen-ime-mora
  (:require [aiueos.compositor.ime :as ime]
            [kotoba.lang.text :as str]
            ["node:fs" :as fs]))

(def ^:private target "os/aiueos/kotoba/browser-ime.kotoba")
(def ^:private begin ";; BEGIN GENERATED MORA")
(def ^:private end ";; END GENERATED MORA")

(defn- die [code msg] (.error js/console msg) (.exit js/process code))

(defn- cps [s] (mapv #(.codePointAt % 0) (js/Array.from s)))

(defn- packed [kana]
  (let [v (cps kana)]
    (when-not (<= 1 (count v) 2) (die 2 (str "COULD-NOT-RUN kana longer than 2: " kana)))
    (+ (* (first v) 65536) (or (second v) 0))))

(defn- key-of [bs]
  (reduce (fn [k b] (+ (* k 256) b)) 0 bs))

(defn- arm-chain [entries]
  ;; entries: [[[bytes...] packed] ...] -> one `if` per entry on the packed
  ;; key `k`, 0 when nothing matches
  (reduce (fn [else [bs v]]
            (str "(if (= k " (key-of bs) ") " v "\n    " else ")"))
          "0"
          (reverse entries)))

(defn- section []
  (let [entries (for [[k v] (sort-by key ime/mora)
                      :let [bs (mapv #(.charCodeAt k %) (range (count k)))]]
                  (do (when (or (> (count bs) 3) (some #(> % 127) bs))
                        (die 2 (str "COULD-NOT-RUN romaji key is not 1..3 ASCII: " k)))
                      [bs (packed v)]))
        by-len (group-by (comp count first) entries)]
    (str begin "\n"
         ";; " (count entries) " entries from aiueos.compositor.ime/mora.\n"
         ";; k is the key's bytes packed big-endian: a, a*256+b, a*65536+b*256+c.\n"
         "(defn mora1 [k]\n  " (arm-chain (by-len 1)) ")\n\n"
         "(defn mora2 [k]\n  " (arm-chain (by-len 2)) ")\n\n"
         "(defn mora3 [k]\n  " (arm-chain (by-len 3)) ")\n"
         end)))

(let [args (vec *command-line-args*)
      mode (first (if (= "--" (first args)) (rest args) args))
      text (.readFileSync fs target "utf8")
      i (.indexOf text begin)
      j (.indexOf text end)]
  (when (or (neg? i) (neg? j) (< j i)) (die 2 "COULD-NOT-RUN the generated-mora markers are missing"))
  (let [fresh (str (subs text 0 i) (section) (subs text (+ j (count end))))]
    (case mode
      "--write" (do (.writeFileSync fs target fresh) (println "MORA-WRITTEN" target))
      "--check" (if (= fresh text) (println "MORA-CHECK identical") (die 1 "MORA-CHECK differs"))
      (die 2 "usage: gen-ime-mora.cljk --write|--check"))))
