(ns aiueos.native.bluetooth-hci
  ;; Bounded USB HCI Command Complete framing; no H4 prefix, ACL, pairing
  ;; or peer input admission. A successful response must match this command.
  (:export [command-complete self-check]))
(defn byte [v i] (bit-and (u64-shift-right v (* i 8)) 255))
(defn command-complete [head length opcode expected]
  (if (and (>= length 6) (<= length 64) (= length expected)
           (>= opcode 0) (<= opcode 65535)
           (= (byte head 0) 14) (= (byte head 1) (- length 2))
           (> (byte head 2) 0)
           (= (+ (byte head 3) (* (byte head 4) 256)) opcode)
           (= (byte head 5) 0)) 1 0))
(defn bit [ok :bool n :i64] :i64 (if ok n 0))
(defn self-check []
  (let [reset 0x0000000c0301040e version 0x0609001001010c0e]
    (+ (bit (= (command-complete reset 6 3075 6) 1) 1)
    (+ (bit (= (command-complete version 14 4097 14) 1) 2)
    (+ (bit (= (command-complete reset 5 3075 6) 0) 4)
    (+ (bit (= (command-complete (+ reset 256) 6 3075 6) 0) 8)
    (+ (bit (= (command-complete reset 6 3076 6) 0) 16)
    (+ (bit (= (command-complete (+ reset 1099511627776) 6 3075 6) 0) 32)
    (+ (bit (= (command-complete (+ reset 1) 6 3075 6) 0) 64)
    (+ (bit (= (command-complete (- reset 65536) 6 3075 6) 0) 128)
    (+ (bit (= (command-complete reset 7 3075 6) 0) 256)
    (+ (bit (= (command-complete reset 6 -1 6) 0) 512)
    (+ (bit (= (command-complete reset 65 3075 65) 0) 1024)
       (bit (= (command-complete version 13 4097 14) 0) 2048))))))))))))))
