(ns aiueos.native.nvme-state
  ;; A file-backed adapter for the existing diagnostic draft/key codec.
  ;; STATE.BIN has five separate 4KiB records: immutable provisioning marker,
  ;; publication head, two alternating slots, passphrase-sealed key. No raw
  ;; seed, passphrase, approval, lease or device handle is persisted.
  ;; Page addresses are read from a checked FAT32 file; boot never creates it.
  ;; Context 700 ready, 701/702 file byte offset. NVMe/ESP own 600..699.
  (:require [aiueos.native.storage-state :as storage]
            [aiueos.native.nvme :as nvme]
            [aiueos.native.esp :as esp])
  (:export [mount provision read-record write-record active ready word read-at write-at]))
(defn w [ctx i] (storage/word ctx i))
(defn p [ctx i v] (storage/put-word ctx i v))
(defn active [] (= (w (kernel-browser-context) 86) 6))
(defn mount [create]
  (let [ctx (kernel-browser-context)
        offset (if (= create 1) (esp/create-state ctx) (esp/state-file ctx))]
    (do (p ctx 700 (if (> offset 0) 1 0))
        (p ctx 701 (bit-and offset 4294967295)) (p ctx 702 (u64-shift-right offset 32))
        (nvme/open-window ctx 0 0) (if (> offset 0) 1 0))))
(defn provision [] (mount 1))
(defn copy-in [page length i]
  (if (>= i 512) 1
    (do (kernel-store-u8 page length i
         (kernel-load-u8-4k (kernel-subregion (kernel-owned-window 4 20480) 20480 16384 4096) 4096 i))
        (copy-in page length (+ i 1)))))
(defn copy-out [page length i]
  (if (>= i 4096) 1
    (do (kernel-store-u8-4k (kernel-subregion (kernel-owned-window 4 20480) 20480 16384 4096) 4096 i
          (if (< i 512) (kernel-load-u8 page length i) 0))
        (copy-out page length (+ i 1)))))
;; The offset must come from esp/record-file's checked fixed20KiB admission.
;; These are privileged kernel mechanisms, not an app-supplied disk capability.
(defn read-at [page length sector offset]
  (let [ctx (kernel-browser-context)]
    (if (or (<= offset 0) (not (= (bit-and offset 4095) 0))
            (< sector 0) (> sector 4) (not (= length 512))) -60
      (if (= (nvme/read-4k ctx (+ offset (* sector 4096))) 0)
        (do (p ctx 650 0) (p ctx 651 0) (copy-in page length 0)) -61))))
(defn write-at [page length sector offset]
  (let [ctx (kernel-browser-context) at (+ offset (* sector 4096))]
    (if (or (<= offset 0) (not (= (bit-and offset 4095) 0))
            (< sector 1) (> sector 4) (not (= length 512))) -62
      (do (copy-out page length 0)
          (nvme/open-window ctx at (+ at 4096))
          (let [written (nvme/write-span ctx at (+ (kernel-owned-window 4 20480) 16384) 4096)
                flushed (if (= written 0) (nvme/flush ctx) -1)]
            (do (nvme/open-window ctx 0 0) (p ctx 650 0) (p ctx 651 0)
                (if (and (= written 0) (= flushed 0)) 1 -63)))))))
(defn read-record [page length sector]
  (let [ctx (kernel-browser-context)]
    (if (not (= (w ctx 700) 1)) -60
      (read-at page length sector (+ (w ctx 701) (* (w ctx 702) 4294967296))))))
(defn write-record [page length sector]
  (let [ctx (kernel-browser-context)]
    (if (not (= (w ctx 700) 1)) -62
      (write-at page length sector (+ (w ctx 701) (* (w ctx 702) 4294967296))))))

(defn ready [] (w (kernel-browser-context) 700))
(defn word [ctx i] (w ctx i))
