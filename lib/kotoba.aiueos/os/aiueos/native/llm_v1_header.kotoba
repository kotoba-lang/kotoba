(ns aiueos.native.llm-v1-header
  (:export [aiueos-llm-v1-header-valid]))

;; Proposed native transport header for the canonical llm-v1 kit (wire 11).
;; The host owns the model allowlist, approval ticket, and all memory regions.
;; Validating guest bytes here never grants any of those authorities.
;;
;; Little-endian 64-byte header:
;;   0 magic "KLM1", 4 version 1, 8 wire 11,
;;   12 model keyword bytes, 16 system bytes, 20 prompt bytes,
;;   24 max output tokens, 28 temperature milli,
;;   32 total payload bytes, 36 result text capacity,
;;   40..63 canonical zero.
;; The payload count is model + system + prompt. The three values occupy
;; separate checked regions, each at most 64 KiB; the result has another
;; checked region. No pointer or grant comes from this header.

(defn aiueos-llm-v1-header-valid [header :i64 header-bytes :i64] :i64
  (if (not= header-bytes 64) 0
    (let [model-bytes (kernel-load-u32 header header-bytes 12)
          system-bytes (kernel-load-u32 header header-bytes 16)
          prompt-bytes (kernel-load-u32 header header-bytes 20)
          max-output-tokens (kernel-load-u32 header header-bytes 24)
          temperature-milli (kernel-load-u32 header header-bytes 28)
          payload-bytes (kernel-load-u32 header header-bytes 32)
          result-capacity (kernel-load-u32 header header-bytes 36)]
      (if (and (= (kernel-load-u32 header header-bytes 0) 827149387)
               (= (kernel-load-u32 header header-bytes 4) 1)
               (= (kernel-load-u32 header header-bytes 8) 11)
               (> model-bytes 0) (<= model-bytes 65536)
               (<= system-bytes 65536)
               (<= prompt-bytes 65536)
               (>= max-output-tokens 1) (<= max-output-tokens 4096)
               (<= temperature-milli 2000)
               (= payload-bytes (+ model-bytes system-bytes prompt-bytes))
               (> result-capacity 0) (<= result-capacity 65536)
               (= (kernel-load-u32 header header-bytes 40) 0)
               (= (kernel-load-u32 header header-bytes 44) 0)
               (= (kernel-load-u32 header header-bytes 48) 0)
               (= (kernel-load-u32 header header-bytes 52) 0)
               (= (kernel-load-u32 header header-bytes 56) 0)
               (= (kernel-load-u32 header header-bytes 60) 0))
        1 0))))
