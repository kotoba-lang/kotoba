(ns aiueos.native.value-call-gate-probe
  (:require [aiueos.native.kernel :as kernel]
            [aiueos.value-runtime-entry :as runtime]
            [aiueos.value-runtime-syscall-plan :as syscall]
            [aiueos.value-runtime-domain :as domain]
            [aiueos.value-runtime-capability-table :as capability]
            [aiueos.value-runtime-provider-policy :as provider]
            [aiueos.value-runtime-provider-transport :as transport]
            [aiueos.value-runtime-cas-verify :as cas]
            [aiueos.value-handle-arena :as handles])
  (:export [main aiueos-isr-6 aiueos-value-runtime-entry aiueos-value-runtime-syscall-plan
            aiueos-value-runtime-publish-domain
            aiueos-value-runtime-provider-status
            aiueos-value-runtime-capability-grant
            aiueos-value-runtime-provider-claim
            aiueos-value-runtime-provider-complete
            aiueos-value-runtime-cas-verify]))

;; C-free integration image root. The ordinary boot entry remains the native
;; kernel's main function; the ValueRuntime entry is linked into the same
;; sealed KIR/native image instead of being supplied as a foreign object.

;; A namespace export is a linker interface. The image root must explicitly
;; retain the kernel's actual vector-6 callback in its interrupt entry table.
(defn aiueos-isr-6 [vector :i64 error :i64 rip :i64 rsp :i64] :i64
  (kernel/aiueos-isr-6 vector error rip rsp))

(defn aiueos-value-runtime-entry
  [arena :i64 entry-profile :i64 user-page :i64
   kernel-request :i64 cap-table :i64] :i64
  (runtime/aiueos-value-runtime-entry
   arena entry-profile user-page kernel-request cap-table))

(defn aiueos-value-runtime-syscall-plan
  [number :i64 domain :i64 pointer :i64 user-rip :i64 user-rsp :i64] :i64
  (syscall/aiueos-value-runtime-syscall-plan
   number domain pointer user-rip user-rsp))

(defn aiueos-value-runtime-publish-domain [current-domain :i64] :i64
  (domain/aiueos-value-runtime-publish-domain current-domain))

(defn aiueos-value-runtime-provider-status
  [generation :i64 active :i64] :i64
  (provider/aiueos-value-runtime-provider-status generation active))

(defn aiueos-value-runtime-capability-grant
  [action :i64 slot :i64 generation :i64 rights :i64 owner :i64] :i64
  (provider/aiueos-value-runtime-capability-grant
   action slot generation rights owner))

(defn aiueos-value-runtime-provider-complete
  [ticket :i64 route-domain :i64 block :i64
   block-length :i64 descriptor :i64] :i64
  (transport/aiueos-value-runtime-provider-complete
   ticket route-domain block block-length descriptor))

(defn aiueos-value-runtime-provider-claim [] :i64
  (transport/aiueos-value-runtime-provider-claim))

(defn aiueos-value-runtime-cas-verify
  [block :i64 block-length :i64 expected :i64
   output :i64 workspace :i64] :i64
  (cas/aiueos-value-runtime-cas-verify
   block block-length expected output workspace))

(defn- retain-kernel [] :i64 (kernel/main))
(defn- all-one? [record :i64 length :i64 index :i64] :bool
  (if (= index 16) true
    (and (= (kernel-load-u64-4k record length (* index 8)) 1)
         (all-one? record length (+ index 1)))))
(defn main [] :i64
  (let [record (kernel-owned-page 0)
        published (kernel-value-runtime-invoke 2 73 0 0 0 0)
        status (kernel-value-runtime-invoke 3 1 1 0 0 0)
        r0 (kernel-store-u64-4k record 4096 0 (if (and (= published 73) (= status 65537)) 1 0))
        arena (kernel-value-runtime-arena 73)
        page (kernel-value-domain-request-page 73)
        request (kernel-value-runtime-request)
        table (kernel-value-runtime-capability-table)
        profile (+ (* 73 65536) (* 4096 4294967296) (* 104 281474976710656))
        handle (handles/aiueos-value-handle-arena arena 4096 1 0 38654705671)
        r1 (kernel-store-u64-4k record 4096 8 (if (and (= handle 1) (> page 0) (> request 0)) 1 0))
        invalid-id (kernel-value-runtime-invoke 8 0 0 0 0 0)
        negative-id (kernel-value-runtime-invoke -1 0 0 0 0 0)
        r2 (kernel-store-u64-4k record 4096 16 (if (and (= invalid-id 0) (= negative-id 0) (= (kernel-current-domain) 73)) 1 0))
        sentinel (kernel-store-u64 request 96 0 99)
        bad-arena (kernel-value-runtime-invoke 0 4096 profile page request table)
        r3 (kernel-store-u64-4k record 4096 24 (if (and (= bad-arena 0) (= (kernel-load-u64 request 96 0) 99)) 1 0))
        bad-page (kernel-value-runtime-invoke 0 arena profile record request table)
        r4 (kernel-store-u64-4k record 4096 32 (if (and (= bad-page 0) (= (kernel-load-u64 request 96 0) 99)) 1 0))
        bad-request (kernel-value-runtime-invoke 0 arena profile page record table)
        r5 (kernel-store-u64-4k record 4096 40 (if (and (= bad-request 0) (= (kernel-load-u64 request 96 0) 99)) 1 0))
        bad-table (kernel-value-runtime-invoke 0 arena profile page request record)
        r6 (kernel-store-u64-4k record 4096 48 (if (and (= bad-table 0) (= (kernel-load-u64 request 96 0) 99)) 1 0))
        bad-profile (kernel-value-runtime-invoke 0 arena (+ profile 65536) page request table)
        r7 (kernel-store-u64-4k record 4096 56 (if (and (= bad-profile 0) (= (kernel-load-u64 request 96 0) 99)) 1 0))
        magic (kernel-store-u32-4k page 4096 0 1364350539)
        version (kernel-store-u8-4k page 4096 4 1)
        operation (kernel-store-u8-4k page 4096 5 3)
        requested-handle (kernel-store-u32-4k page 4096 8 handle)
        entered (kernel-value-runtime-invoke 0 arena profile page request table)
        r8 (kernel-store-u64-4k record 4096 64 (if (= entered 72057594037927943) 1 0))
        block-page (kernel-owned-page 1)
        block (kernel-subregion block-page 4096 0 3)
        digest-page (kernel-owned-page 2)
        expected (kernel-subregion digest-page 4096 0 32)
        a (kernel-store-u8 block 3 0 97) b (kernel-store-u8 block 3 1 98) c (kernel-store-u8 block 3 2 99)
        h0 (kernel-store-u64 expected 32 0 -1527000031757436742)
        h1 (kernel-store-u64 expected 32 8 2531777658719584577)
        h2 (kernel-store-u64 expected 32 16 -7171393520880516176)
        h3 (kernel-store-u64 expected 32 24 -5974868289610903372)
        scratch (kernel-value-runtime-cas-scratch)
        output (kernel-subregion scratch 384 0 32)
        workspace (kernel-subregion scratch 384 32 352)
        verified (kernel-value-runtime-invoke 7 block 3 expected output workspace)
        r9 (kernel-store-u64-4k record 4096 72 (if (= verified 1) 1 0))
        invalid-expected (kernel-value-runtime-invoke 7 block 3 4096 output workspace)
        r10 (kernel-store-u64-4k record 4096 80 (if (= invalid-expected 0) 1 0))
        invalid-output (kernel-value-runtime-invoke 7 block 3 expected record workspace)
        r11 (kernel-store-u64-4k record 4096 88 (if (and (= invalid-output 0) (= (kernel-load-u64-4k record 4096 0) 1)) 1 0))
        invalid-block (kernel-value-runtime-invoke 6 1 18702 4096 3 38654705671)
        invalid-length (kernel-value-runtime-invoke 6 1 18702 block 12289 38654705671)
        r12 (kernel-store-u64-4k record 4096 96 (if (and (= invalid-block 0) (= invalid-length 0)) 1 0))
        claim (kernel-value-runtime-invoke 5 0 0 0 0 0)
        r13 (kernel-store-u64-4k record 4096 104 (if (= claim 0) 1 0))
        plan (kernel-value-runtime-invoke 1 5 73 page 4194304 5242880)
        r14 (kernel-store-u64-4k record 4096 112 (if (= plan profile) 1 0))
        stale-cap (kernel-value-runtime-invoke 4 1 1 1 1 73)
        cap (kernel-value-runtime-invoke 4 1 1 0 1 73)
        r15 (kernel-store-u64-4k record 4096 120 (if (and (= stale-cap 0) (= cap (+ 1 65536 (* 2 4294967296) 281474976710656))) 1 0))]
    (if (all-one? record 4096 0) 42 0)))
