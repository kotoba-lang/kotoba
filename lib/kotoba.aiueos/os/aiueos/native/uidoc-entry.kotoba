(ns aiueos.native.uidoc-entry
  (:require [aiueos.native.desktop :as desktop]
            [aiueos.value-runtime-entry :as runtime]
            [aiueos.value-runtime-syscall-plan :as syscall]
            [aiueos.value-runtime-domain :as domain]
            [aiueos.value-runtime-capability-table :as capability]
            [aiueos.value-runtime-provider-policy :as provider]
            [aiueos.value-runtime-provider-transport :as transport]
            [aiueos.value-runtime-cas-verify :as cas]
            [cssom.flow-k :refer [fk-run fk-height fk-word fk-off]]
            [cssom.draw-k :refer [dk-run dk-word]]
            [cssom.uidoc-k :refer [ud-run ud-word]])
  (:export [main aiueos-value-runtime-entry aiueos-value-runtime-syscall-plan
            aiueos-value-runtime-publish-domain aiueos-value-runtime-provider-status
            aiueos-value-runtime-capability-grant aiueos-value-runtime-provider-claim
            aiueos-value-runtime-provider-complete aiueos-value-runtime-cas-verify]))

(defn aiueos-value-runtime-entry [a :i64 p :i64 u :i64 r :i64 c :i64] :i64
  (runtime/aiueos-value-runtime-entry a p u r c))
(defn aiueos-value-runtime-syscall-plan [n :i64 d :i64 p :i64 i :i64 s :i64] :i64
  (syscall/aiueos-value-runtime-syscall-plan n d p i s))
(defn aiueos-value-runtime-publish-domain [d :i64] :i64
  (domain/aiueos-value-runtime-publish-domain d))
(defn aiueos-value-runtime-provider-status [g :i64 a :i64] :i64
  (provider/aiueos-value-runtime-provider-status g a))
(defn aiueos-value-runtime-capability-grant [a :i64 s :i64 g :i64 r :i64 o :i64] :i64
  (provider/aiueos-value-runtime-capability-grant a s g r o))
(defn aiueos-value-runtime-provider-claim [] :i64
  (transport/aiueos-value-runtime-provider-claim))
(defn aiueos-value-runtime-provider-complete [t :i64 r :i64 b :i64 n :i64 d :i64] :i64
  (transport/aiueos-value-runtime-provider-complete t r b n d))
(defn aiueos-value-runtime-cas-verify [b :i64 n :i64 e :i64 o :i64 w :i64] :i64
  (cas/aiueos-value-runtime-cas-verify b n e o w))

;; JUN-856 (ADR-0287): before the desktop starts the kernel runs the UI-document front end (cssom.uidoc-k: the compact UI document in pages 13 and 14 of the
;; owned window becomes the style slice's wire stream at 0..16383) and then the existing layout slice (cssom.flow-k) and draw slice (cssom.draw-k) on it, over
;; the cases handed in through fw_cfg (file opt/aiueos/uidoc, only under a hypervisor, as native/draw-entry): [count:2 big endian] then per case
;; [document length:2 big endian] [viewport width:4 big endian, Q6 raw] [document bytes] [wire length:2 big endian] [canonical wire stream bytes]. The wire
;; stream of a case is the DIRECT path: the existing input of the draw gate, loaded into the window as draw-entry does (length 0: the case has none).
;; Word 99 of the browser context holds the marker "UD01" (1430532145), written last, and word 319 the case count. Everything else leaves over the debug
;; console (I/O port 0xe9; QEMU -debugcon file:...): "UDSTART!", then per case the bytes A5 5A, case index (4 bytes little endian), front-end status (4,
;; signed: the wire stream length or the negative refusal), text nodes (4), text bytes (4) (both 0 when the front end refused); when the front end ran:
;; the wire stream it wrote (that many bytes), then the PATH record; when the case has a canonical wire stream: the PATH record of the direct path. PATH
;; record: layout status (4, signed), element count, offending element + 1, document height (4, signed), draw status (4, signed), then for each element 22
;; words of the box table (as layout-entry), then, when the layout ran, the raw words of the draw-list region (the header slot and as many op slots as
;; header word 1 says, 8 words of 4 bytes little endian per slot); finally "UDEND!!!".
(defn in! [i v] (kernel-store-u8-16k (kernel-subregion (kernel-owned-window 0 61440) 61440 0 16384) 16384 i v))
(defn in13! [i v]
  (if (< i 4096)
    (kernel-store-u8-4k (kernel-subregion (kernel-owned-window 0 61440) 61440 53248 4096) 4096 i v)
    (kernel-store-u8-4k (kernel-subregion (kernel-owned-window 0 61440) 61440 57344 4096) 4096 (- i 4096) v)))
(defn put-u32 [ctx at v] (kernel-store-u32 (kernel-subregion ctx 8192 at 4) 4 0 v))

(defn fw-min [a b] (if (< a b) a b))
(defn fw-byte [] (kernel-in-u8 1297))
(defn fw-skip [n] (if (<= n 0) 1 (let [b (fw-byte)] (fw-skip (- n (+ 1 (* 0 b)))))))
(defn fw-be [n acc] (if (= n 0) acc (fw-be (- n 1) (+ (* acc 256) (fw-byte)))))
;; "opt/aiueos/uidoc" and its NUL
(defn fw-name-byte [i] (case i 0 111 1 112 2 116 3 47 4 97 5 105 6 117 7 101 8 111 9 115 10 47 11 117 12 105 13 100 14 111 15 99 0))
(defn fw-name [i ok]
  (if (>= i 56) ok
    (let [b (fw-byte)]
      (fw-name (+ i 1) (if (and (= ok 1) (or (>= i 18) (= b (fw-name-byte i)))) 1 0)))))
(defn fw-find [left]
  (if (<= left 0) 0
    (let [size (fw-be 4 0)
          sel (fw-be 2 0)
          skip (fw-skip 2)
          hit (fw-name 0 1)]
      (if (= (+ hit (* 0 (+ size skip))) 1) sel (fw-find (- left 1))))))
(defn fw-signature [i]
  (if (>= i 4) 1 (if (= (fw-byte) (case i 0 81 1 69 2 77 85)) (fw-signature (+ i 1)) 0)))
(defn fw-select []
  (if (= (bit-and (kernel-cpuid-ecx 1 0) 2147483648) 0) 0
    (do (kernel-out-u16 1296 0)
        (if (= (fw-signature 0) 0) 0
          (do (kernel-out-u16 1296 25)
              (let [sel (fw-find (fw-min (fw-be 4 0) 256))]
                (if (= sel 0) 0 (do (kernel-out-u16 1296 sel) 1))))))))

;; copy n stream bytes into the window; bytes past the 16384th are read and dropped
(defn load-case [i n]
  (if (>= i n) 1
    (let [b (fw-byte)]
      (load-case (+ i 1) (+ n (* 0 (if (< i 16384) (in! i b) 0)))))))
;; copy n document bytes into pages 13 and 14; bytes past the 8192nd are read and dropped
(defn load-doc [i n]
  (if (>= i n) 1
    (let [b (fw-byte)]
      (load-doc (+ i 1) (+ n (* 0 (if (< i 8192) (in13! i b) 0)))))))

;; debug console
(defn dc [b] (kernel-out-u8 233 b))
(defn dc32 [v] (+ (dc (bit-and v 255)) (+ (dc (bit-and (u64-shift-right v 8) 255)) (+ (dc (bit-and (u64-shift-right v 16) 255)) (dc (bit-and (u64-shift-right v 24) 255))))))
(defn dc-tag [i]
  (if (>= i 8) 1 (dc-tag (+ i (+ 1 (* 0 (dc (case i 0 85 1 68 2 83 3 84 4 65 5 82 6 84 33)))))))) 
(defn dc-end [i]
  (if (>= i 8) 1 (dc-end (+ i (+ 1 (* 0 (dc (case i 0 85 1 68 2 69 3 78 4 68 33)))))))) 
(defn dc-words [n k]
  (if (>= k 22) 1
    (dc-words n (+ k (+ 1 (* 0 (dc32 (bit-and (fk-word (kernel-owned-window 0 61440) 61440 n k) 4294967295))))))))
(defn dc-nodes [n nn]
  (if (>= n nn) 1 (dc-nodes (+ n (+ 1 (* 0 (dc-words n 0)))) nn)))

(defn dc-slot [s i]
  (if (>= i 8) 1 (dc-slot s (+ i (+ 1 (* 0 (dc32 (dk-word (kernel-owned-window 0 61440) 61440 s i))))))))
(defn dc-slots [s n] (if (> s n) 1 (dc-slots (+ s (+ 1 (* 0 (dc-slot s 0)))) n)))
;; the n bytes of the wire stream the front end wrote
(defn dc-bytes [i n]
  (if (>= i n) 1
    (dc-bytes (+ i (+ 1 (* 0 (dc (kernel-load-u8-16k (kernel-subregion (kernel-owned-window 0 61440) 61440 0 16384) 16384 i))))) n)))

;; layout and draw over the stream of len bytes in the window, then the PATH record
(defn path [len vw]
  (let [r (fk-run (kernel-owned-window 0 61440) 61440 len vw)
        nn (if (>= r 0) r 0)
        d (if (>= r 0) (dk-run (kernel-owned-window 0 61440) 61440) 0)
        dn (if (>= r 0) (dk-word (kernel-owned-window 0 61440) 61440 0 1) 0)
        dh (if (>= r 0) (bit-and (fk-height (kernel-owned-window 0 61440) 61440) 4294967295) 0)
        off (fk-off (kernel-owned-window 0 61440) 61440)
        c (+ (dc32 (bit-and r 4294967295)) (+ (dc32 nn) (+ (dc32 off) (+ (dc32 dh) (dc32 (bit-and d 4294967295))))))
        e (dc-nodes 0 nn)
        f (if (>= r 0) (dc-slots 0 dn) 0)]
    (+ 1 (* 0 (+ c (+ e f))))))

(defn direct [vw]
  (let [wl (fw-be 2 0)]
    (if (= wl 0) 1
      (let [l (load-case 0 wl)] (+ 1 (* 0 (+ l (path wl vw))))))))

(defn run-case [ctx k]
  (let [dl (fw-be 2 0)
        vw (fw-be 4 0)
        l (load-doc 0 dl)
        u (ud-run (kernel-owned-window 0 61440) 61440 dl)
        tx (if (>= u 0) (ud-word (kernel-owned-window 0 61440) 61440 2) 0)
        tb (if (>= u 0) (ud-word (kernel-owned-window 0 61440) 61440 3) 0)
        h (+ (dc 165) (+ (dc 90) (+ (dc32 k) (+ (dc32 (bit-and u 4294967295)) (+ (dc32 tx) (dc32 tb))))))
        s (if (>= u 0) (dc-bytes 0 u) 0)
        a (if (>= u 0) (path u vw) 0)
        b (direct vw)]
    (+ 1 (* 0 (+ l (+ h (+ s (+ a b))))))))
(defn cases [ctx k count] (if (>= k count) 1 (cases ctx (+ k 1 (* 0 (run-case ctx k))) count)))

(defn uidoc-selftest []
  (let [ctx (kernel-browser-context)
        sel (fw-select)]
    (if (= sel 1)
      (let [count (fw-be 2 0)
            t (dc-tag 0)
            done (cases ctx 0 (fw-min count 480))
            e (dc-end 0)
            w (put-u32 ctx 1276 count)]
        (put-u32 ctx 396 (+ 1430532145 (* 0 (+ done (+ w (+ t e)))))))
      0)))

(defn main [] :i64
  (let [width (kernel-framebuffer-width)
        registered (kernel-register-value-domain 73)
        published (kernel-publish-current-domain 73)
        enabled (kernel-value-enable-user)]
    (if (and (> width 0) (> registered 0) (= published 73) (= enabled 1))
      (do (uidoc-selftest) (desktop/goal-model-main)) 0)))
