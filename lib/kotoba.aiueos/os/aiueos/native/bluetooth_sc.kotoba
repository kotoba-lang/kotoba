(ns aiueos.native.bluetooth-sc
  ;; Core v6.1 Vol3 H 2.2.5..8. All CMAC strings are big endian internally;
  ;; SMP/HCI integer fields are reversed explicitly at their boundary.
  ;; CPU-only state 544..703 is owned by the single admitted BLE radio.
  (:require [aiueos.native.xhci :as usb] [aiueos.native.bluetooth-le :as le])
  (:export [cmac f4 f5 f6 random self-check]))
(defn b [i] (usb/ble-state i))
(defn p [i v] (usb/ble-put i (bit-and v 255)))
(defn fill [off n v] (if (= n 0) 1 (do (p off v) (fill (+ off 1) (- n 1) v))))
(defn copy [src dst n] (if (= n 0) 1 (do (p dst (b src)) (copy (+ src 1) (+ dst 1) (- n 1)))))
(defn reverse-copy [src dst n i]
  (if (>= i n) 1 (do (p (+ dst i) (b (+ src (- (- n 1) i)))) (reverse-copy src dst n (+ i 1)))))
(defn aes-params [i]
  (if (>= i 16) 1
    (do (usb/ble-param i (b (- 559 i))) (usb/ble-param (+ 16 i) (b (- 687 i))) (aes-params (+ i 1)))))
(defn aes-out [i]
  (if (>= i 16) 1 (do (p (+ 688 i) (le/packet (- 21 i))) (aes-out (+ i 1)))))
(defn aes [] (do (aes-params 0) (if (= (le/command 8215 32 22) 1) (aes-out 0) 0)))
(defn shift [i]
  (if (>= i 16) 1
    (do (p (+ 656 i) (+ (* (b (+ 656 i)) 2) (if (< i 15) (quot (b (+ 657 i)) 128) 0))) (shift (+ i 1)))))
(defn subkey []
  (let [carry (quot (b 656) 128)]
    (do (shift 0) (if (= carry 1) (p 671 (bit-xor (b 671) 135)) 0) 1)))
(defn block [offset n last i]
  (if (>= i 16) 1
    (let [at (+ offset i)
          message (if (< at n) (b (+ 560 at)) (if (= at n) 128 0))]
      (do (p (+ 672 i) (bit-xor (b (+ 688 i))
             (bit-xor message (if (= last 1) (b (+ 656 i)) 0))))
          (block offset n last (+ i 1))))))
(defn blocks [offset n]
  (let [last (if (>= (+ offset 16) n) 1 0)]
    (do (block offset n last 0)
        (if (not (= (aes) 1)) 0
          (if (= last 1) 1 (blocks (+ offset 16) n))))))
(defn cmac [key message n dst]
  (if (or (< n 0) (> n 80)) 0
    (do (copy key 544 16) (copy message 560 n) (fill 672 16 0)
        (if (not (= (aes) 1)) 0
          (do (copy 688 656 16) (subkey)
              (if (or (= n 0) (not (= (mod n 16) 0))) (subkey) 0)
              (fill 688 16 0)
              (if (= (blocks 0 n) 1) (copy 688 dst 16) 0))))))
(defn f4 [u v nonce z dst]
  (do (reverse-copy u 560 32 0) (reverse-copy v 592 32 0) (p 624 z)
      (reverse-copy nonce 544 16 0)
      (if (= (cmac 544 560 65 640) 1) (reverse-copy 688 dst 16 0) 0)))
(defn salt []
  (do (p 544 108) (p 545 136) (p 546 131) (p 547 145) (p 548 170) (p 549 245) (p 550 165) (p 551 56)
      (p 552 96) (p 553 55) (p 554 11) (p 555 219) (p 556 90) (p 557 96) (p 558 131) (p 559 190)))
(defn f5-message [n1 n2 a1 a2 counter]
  (do (p 560 counter) (p 561 98) (p 562 116) (p 563 108) (p 564 101)
      (reverse-copy n1 565 16 0) (reverse-copy n2 581 16 0)
      (copy a1 597 7) (copy a2 604 7) (p 611 1) (p 612 0)))
(defn f5 [w n1 n2 a1 a2 mackey ltk]
  (do (salt) (reverse-copy w 560 32 0)
      (if (not (= (cmac 544 560 32 640) 1)) 0
        (do (copy 640 544 16) (f5-message n1 n2 a1 a2 0)
            (if (not (= (cmac 544 560 53 mackey) 1)) 0
              (do (f5-message n1 n2 a1 a2 1)
                  (if (= (cmac 544 560 53 640) 1) (reverse-copy 640 ltk 16 0) 0)))))))
(defn f6 [mackey n1 n2 r iocap a1 a2 dst]
  (do (reverse-copy n1 560 16 0) (reverse-copy n2 576 16 0) (reverse-copy r 592 16 0)
      (reverse-copy iocap 608 3 0) (copy a1 611 7) (copy a2 618 7)
      (if (= (cmac mackey 560 65 640) 1) (reverse-copy 688 dst 16 0) 0)))
(defn random [dst n]
  (if (= n 0) 1
    (if (or (< n 0) (not (= (mod n 8) 0))) 0
      (if (not (= (le/command 8216 0 14) 1)) 0
        (do (random-copy dst 0) (random (+ dst 8) (- n 8)))))))
(defn random-copy [dst i]
  (if (>= i 8) 1 (do (p (+ dst i) (le/packet (+ 6 i))) (random-copy dst (+ i 1)))))
(defn vector-key [i] (case i 0 43 1 126 2 21 3 22 4 40 5 174 6 210 7 166 8 171 9 247 10 21 11 136 12 9 13 207 14 79 15 60 0))
(defn vector-msg [i] (case i 0 107 1 193 2 190 3 226 4 46 5 64 6 159 7 150 8 233 9 61 10 126 11 17 12 115 13 147 14 23 15 42 16 174 17 45 18 138 19 87 20 30 21 3 22 172 23 156 24 158 25 183 26 111 27 172 28 69 29 175 30 142 31 81 32 48 33 200 34 28 35 70 36 163 37 92 38 228 39 17 40 229 41 251 42 193 43 25 44 26 45 10 46 82 47 239 48 246 49 159 50 36 51 69 52 223 53 79 54 155 55 23 56 173 57 43 58 65 59 123 60 230 61 108 62 55 63 16 0))
(defn vector-u [i] (case i 0 32 1 176 2 3 3 210 4 242 5 151 6 190 7 44 8 94 9 44 10 131 11 167 12 233 13 249 14 165 15 185 16 239 17 244 18 145 19 17 20 172 21 244 22 253 23 219 24 204 25 3 26 1 27 72 28 14 29 53 30 157 31 230 0))
(defn vector-v [i] (case i 0 85 1 24 2 139 3 61 4 50 5 246 6 187 7 154 8 144 9 10 10 252 11 251 12 238 13 212 14 231 15 42 16 89 17 203 18 154 19 194 20 241 21 157 22 124 23 251 24 107 25 79 26 221 27 73 28 244 29 127 30 197 31 253 0))
(defn vector-n1 [i] (case i 0 213 1 203 2 132 3 84 4 209 5 119 6 115 7 62 8 255 9 255 10 178 11 236 12 113 13 43 14 174 15 171 0))
(defn vector-n2 [i] (case i 0 166 1 232 2 231 3 204 4 37 5 167 6 95 7 110 8 33 9 101 10 131 11 247 12 255 13 61 14 196 15 207 0))
(defn vector-w [i] (case i 0 236 1 2 2 52 3 163 4 87 5 200 6 173 7 5 8 52 9 16 10 16 11 166 12 10 13 57 14 125 15 155 16 153 17 121 18 107 19 19 20 180 21 248 22 102 23 241 24 134 25 141 26 52 27 243 28 115 29 191 30 166 31 152 0))
(defn vector-a1 [i] (case i 0 0 1 86 2 18 3 55 4 55 5 191 6 206 0))
(defn vector-a2 [i] (case i 0 0 1 167 2 19 3 112 4 45 5 207 6 193 0))
(defn vector-r [i] (case i 0 18 1 163 2 52 3 59 4 180 5 83 6 187 7 84 8 8 9 218 10 66 11 210 12 12 13 45 14 15 15 200 0))
(defn vector-io [i] (case i 0 1 1 1 2 2 0))
(defn vector [which i]
  (case which 0 (vector-key i) 1 (vector-msg i) 2 (vector-u i) 3 (vector-v i) 4 (vector-n1 i)
    5 (vector-n2 i) 6 (vector-w i) 7 (vector-a1 i) 8 (vector-a2 i) 9 (vector-r i) (vector-io i)))
(defn stage [which dst n reverse i]
  (if (>= i n) 1
    (do (p (+ dst i) (vector which (if (= reverse 1) (- (- n 1) i) i))) (stage which dst n reverse (+ i 1)))))
(defn equal [dst expected n i diff]
  (if (>= i n) (if (= diff 0) 1 0)
    (equal dst expected n (+ i 1) (bit-or diff (bit-xor (b (+ dst i)) (expected-byte expected i))))))
(defn expected-0 [i] (case i 0 187 1 29 2 105 3 41 4 233 5 89 6 55 7 40 8 127 9 163 10 125 11 18 12 155 13 117 14 103 15 70 0))
(defn expected-1 [i] (case i 0 7 1 10 2 22 3 180 4 107 5 77 6 65 7 68 8 247 9 155 10 221 11 157 12 208 13 74 14 40 15 124 0))
(defn expected-2 [i] (case i 0 223 1 166 2 103 3 71 4 222 5 154 6 230 7 48 8 48 9 202 10 50 11 97 12 20 13 151 14 200 15 39 0))
(defn expected-3 [i] (case i 0 81 1 240 2 190 3 191 4 126 5 59 6 157 7 146 8 252 9 73 10 116 11 23 12 121 13 54 14 60 15 254 0))
(defn expected-4 [i] (case i 0 45 1 135 2 116 3 169 4 190 5 161 6 237 7 241 8 28 9 189 10 169 11 7 12 241 13 22 14 201 15 242 0))
(defn expected-5 [i] (case i 0 41 1 101 2 241 3 118 4 161 5 8 6 74 7 2 8 253 9 63 10 106 11 32 12 206 13 99 14 110 15 32 0))
(defn expected-6 [i] (case i 0 56 1 10 2 117 3 148 4 181 5 34 6 5 7 152 8 35 9 205 10 215 11 105 12 17 13 121 14 134 15 105 0))
(defn expected-7 [i] (case i 0 97 1 143 2 149 3 218 4 9 5 11 6 108 7 210 8 197 9 232 10 208 11 156 12 152 13 115 14 196 15 227 0))
(defn expected-byte [which i]
  (case which 0 (expected-0 i) 1 (expected-1 i) 2 (expected-2 i) 3 (expected-3 i)
    4 (expected-4 i) 5 (expected-5 i) 6 (expected-6 i) (expected-7 i)))
(defn cmac-test [n expected]
  (do (stage 0 544 16 0 0) (stage 1 560 64 0 0)
      (if (= (cmac 544 560 n 640) 1) (equal 640 expected 16 0 0) 0)))
(defn self-check []
  (let [a (cmac-test 0 0) b (cmac-test 16 1) c (cmac-test 40 2) d (cmac-test 64 3)]
    (do (stage 2 384 32 1 0) (stage 3 416 32 1 0) (stage 4 448 16 1 0)
        (let [e (if (= (f4 384 416 448 0 480) 1) (equal 480 4 16 0 0) 0)]
          (do (stage 6 224 32 1 0) (stage 5 464 16 1 0) (stage 7 704 7 0 0) (stage 8 711 7 0 0)
              (let [derived (f5 224 448 464 704 711 512 496)
                    f (if (= derived 1) (equal 512 5 16 0 0) 0)
                    g (if (= derived 1) (equal 496 6 16 0 0) 0)]
                (do (stage 9 480 16 1 0) (stage 10 528 3 1 0)
                    (let [h (if (= (f6 512 448 464 480 528 704 711 496) 1) (equal 496 7 16 0 0) 0)]
                      (+ a (* b 2) (* c 4) (* d 8) (* e 16) (* f 32) (* g 64) (* h 128))))))))))
