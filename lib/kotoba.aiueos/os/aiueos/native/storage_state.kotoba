(ns aiueos.native.storage-state
  ;; In profile 6 crypto uses context bytes2048..3071. Keep controller queues,
  ;; ESP cursors and the mounted file outside that scratch: owned page9 bytes3584..3995,
  ;; after xHCI host state0..1535 and draft scratch1536..3583. Other profiles keep
  ;; their existing diagnostic layout. This is volatile state, never a record.
  (:export [word put-word]))
(defn separate [ctx i]
  (and (>= i 600) (<= i 702)
       (= (kernel-load-u32 (kernel-subregion ctx 8192 344 4) 4 0) 6)))
(defn word [ctx i]
  (if (separate ctx i)
    (kernel-load-u32 (kernel-subregion (kernel-owned-window 9 4096) 4096 (+ 3584 (* (- i 600) 4)) 4) 4 0)
    (kernel-load-u32 (kernel-subregion ctx 8192 (* i 4) 4) 4 0)))
(defn put-word [ctx i value]
  (if (separate ctx i)
    (kernel-store-u32 (kernel-subregion (kernel-owned-window 9 4096) 4096 (+ 3584 (* (- i 600) 4)) 4) 4 0 value)
    (kernel-store-u32 (kernel-subregion ctx 8192 (* i 4) 4) 4 0 value)))
