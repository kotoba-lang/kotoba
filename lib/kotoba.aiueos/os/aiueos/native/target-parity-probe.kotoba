(ns target-parity-probe
  (:export [main]))

;; The bootable half of the target-parity smoke: the same `accumulate` as
;; `target-parity-core.kotoba`, run at two sizes, each bracketed by
;; `kernel-rdtsc`, with both deltas printed to the 0xE9 debug console.
;;
;; Under plain TCG those deltas are a HOST-time clock, not a count: aiueos
;; ADR-0165 measured four runs of one fixture at ratios 1.17 / 1.45 / 1.55 /
;; 1.57 and named the spread as the load. Measured here 2026-09-10, two runs of
;; THIS probe printed 00004268/000032C8 and 00003E80/000036B0 -- a ~30% spread
;; in which the 30-iteration fold reads HIGHER than the 60-iteration one, which
;; is the ordering a clock cannot have and a translator can.
;;
;; Under `-icount shift=0,sleep=off` the same deltas become a deterministic
;; function of executed guest instructions: three runs printed
;; 000001EB/000003AC byte for byte, and a third size lands where a line through
;; the first two predicts (30 -> 491, 60 -> 940, 90 -> 1390; 15.0 per
;; iteration over a fixed 42). That is why the smoke both requires icount for
;; its number and boots once WITHOUT it -- a determinism claim that never saw
;; the noisy arm is a claim about one configuration.
;;
;; TWO sizes, not one: the difference cancels the fixed cost of the bracket
;; itself, the same shape ADR-0165 used. `warm` runs first and is not timed --
;; ADR-0165 measured that without it a 256-element fold reported 788,000 ticks
;; against a 4096-element fold's 279,000, because the first pass through a
;; sequence pays for QEMU to translate it and that cost exceeds the loop.

(defn accumulate [i limit acc]
  (if (< i limit)
    (accumulate (+ i 1) limit (+ acc (* i 3)))
    acc))

(defn hex-digit [value]
  (if (< value 10) (+ 48 value) (+ 55 value)))

(defn emit-digit [value divisor]
  (kernel-out-u8 233 (hex-digit (bit-and (quot value divisor) 15))))

(defn emit-u32 [value]
  (let [d7 (emit-digit value 268435456)
        d6 (emit-digit value 16777216)
        d5 (emit-digit value 1048576)
        d4 (emit-digit value 65536)
        d3 (emit-digit value 4096)
        d2 (emit-digit value 256)
        d1 (emit-digit value 16)
        d0 (emit-digit value 1)]
    1))

;; 30 and 60 iterations. The ceiling is fuel, not taste: `--fuel 1048576` is
;; `kotoba.kir/max-fuel`, fuel is charged to the CALLER per step (ADR-0204), so
;; a self-recursive chain multiplies its body by its depth. Measured
;; 2026-09-10 on `x86_64-linux`: depth 100 compiles, depth 200 exits 70
;; `fuel-exhausted`. Three calls share that ceiling here.
(defn main []
  (let [warm (accumulate 0 30 0)
        s0 (kernel-rdtsc)
        small (accumulate 0 30 0)
        s1 (kernel-rdtsc)
        l0 (kernel-rdtsc)
        large (accumulate 0 60 0)
        l1 (kernel-rdtsc)
        small-elapsed (- s1 s0)
        large-elapsed (- l1 l0)
        printed-small (emit-u32 (bit-and small-elapsed 4294967295))
        printed-large (emit-u32 (bit-and large-elapsed 4294967295))
        m0 (kernel-out-u8 233 73)
        m1 (kernel-out-u8 233 80)]
    ;; One exit value per check, so a failure names itself instead of
    ;; collapsing into "something was wrong". isa-debug-exit reports
    ;; (value << 1) | 1, so 16 -> 33.
    (kernel-out-u32 244
                    (if (and (= warm 1305) (= small 1305) (= large 5310))
                      (if (and (= printed-small 1) (= printed-large 1)
                               (= m0 73) (= m1 80))
                        ;; Both brackets must have advanced, or the difference
                        ;; the smoke takes is a difference of nothing.
                        (if (and (> small-elapsed 0) (> large-elapsed 0))
                          ;; The larger fold must cost more. Under icount this
                          ;; is arithmetic; under a host clock it is the check
                          ;; that catches the inversion documented above.
                          (if (> large-elapsed small-elapsed) 16 25)
                          24)
                        23)
                      22))))
