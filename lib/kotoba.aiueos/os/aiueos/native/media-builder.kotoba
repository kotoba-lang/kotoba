;; Native unity fragment, assembled with the exact Amu 00/01/02 helpers.
;; A deterministic8MiB GPT/FAT16 VM diagnostic image, never a disk installer.
;; The caller-supplied digest names GUIDs; admission compares exact EFI bytes.
(def MEDIA-BYTES 8388608)
(def MEDIA-PART 1048576)
(def MEDIA-FAT 1049088)
(def MEDIA-FAT-BYTES 28672)
(def MEDIA-ROOT 1106432)
(def MEDIA-DATA 1122816)
(def MEDIA-FILE 1123840)
(defn- media-put [D :vector-i64 at :i64 value :i64 n :i64] :vector-i64
  (loop [i 0]
    (if (= i n) (mem-keep D)
      (let [w (mem-set D (+ at i) (bit-and (u64-shift-right value (* 8 i)) 255))]
        (recur (inc i))))))
(defn- media-get [D :vector-i64 at :i64 n :i64] :i64
  (loop [i 0 value 0]
    (if (= i n) value
      (recur (inc i) (bit-or value (i64-shift-left (vector-at D (+ at i)) (* i 8)))))))
(defn- media-copy [D :vector-i64 at :i64 S :vector-i64 n :i64] :vector-i64
  (loop [i 0]
    (if (= i n) (mem-keep D)
      (let [w (mem-set D (+ at i) (vector-at S i))] (recur (inc i))))))
(defn- media-same? [D :vector-i64 at :i64 S :vector-i64 n :i64] :bool
  (loop [i 0]
    (cond (= i n) true (not= (vector-at D (+ at i)) (vector-at S i)) false :else (recur (inc i)))))
(defn- media-text [D :vector-i64 at :i64 S :string] :vector-i64
  (io-bput-str D S 0 (string-length S) at))
(defn- media-text? [D :vector-i64 at :i64 S :string] :bool
  (loop [i 0]
    (cond (= i (string-length S)) true
          (not= (vector-at D (+ at i)) (string-code-point-at S i)) false
          :else (recur (inc i)))))
;; Binary FS2 E reads are bounded below the byte-value limit. Neither a
;; multi-MiB EFI nor the disk is ever returned as one capability byte value.
(defn- media-slice [path :string offset :i64 n :i64] :vector-i64
  (vector-i64-from-bytes
    (typed-cap-call :fs/app-data :string :bytes
      (string-concat (io-fs2-header 69 path)
        (string-concat (mem-u2dec offset) (string-concat ":" (mem-u2dec n)))))))
(defn- media-ack? [B :vector-i64 n :i64] :bool
  (and (= (vector-count B) (+ n 5)) (= (vector-at B 0) 0)
       (= (vector-at B 1) 70) (= (vector-at B 2) 83)
       (= (vector-at B 3) 50) (= (vector-at B 4) 0)))
(defn- media-field [S :string wanted :i64] :string
  (loop [at 0 field 0]
    (if (>= at (string-length S)) ""
      (let [end (loop [i at]
                  (if (or (= i (string-length S)) (= (string-code-point-at S i) 32)) i (recur (inc i))))]
        (if (= field wanted) (string-substring S at end) (recur (inc end) (inc field)))))))
(defn- media-read [path :string n :i64] :vector-i64
  (let [stat (io-fs2-text 70 path "") size (media-field stat 1)]
  (if (or (not (string=? size (mem-u2dec n))) (not (string=? (media-field stat 3) "0"))) (vector-alloc 0)
  (loop [at 0 D (vector-alloc n)]
    (if (= at n)
      D
      (let [count (io-min 262144 (- n at)) B (media-slice path at count)]
        (if (not (media-ack? B count)) (vector-alloc 0)
          (let [copied (loop [i 0]
                         (if (= i count) D
                           (let [w (mem-set D (+ at i) (vector-at B (+ i 5)))]
                             (recur (inc i)))))]
            (recur (+ at count) copied)))))))))
(defn- media-size? [S :string] :bool
  (and (> (string-length S) 0) (<= (string-length S) 7)
    (loop [i 0]
      (cond (= i (string-length S)) true
            (or (< (string-code-point-at S i) 48) (> (string-code-point-at S i) 57)) false
            :else (recur (inc i))))))
(defn- media-hex [c :i64] :i64
  (cond (and (>= c 48) (<= c 57)) (- c 48)
        (and (>= c 97) (<= c 102)) (- c 87)
        (and (>= c 65) (<= c 70)) (- c 55) :else -1))
(defn- media-digest? [S :string] :bool
  (and (= (string-length S) 64)
    (loop [i 0]
      (cond (= i 64) true (< (media-hex (string-code-point-at S i)) 0) false :else (recur (inc i))))))
(defn- media-guid [S :string start :i64] :vector-i64
  (let [G (vector-alloc 16)
        copied (loop [i 0]
                 (if (= i 16) G
                   (let [at (+ start (* i 2))
                         w (mem-set G i (+ (* 16 (media-hex (string-code-point-at S at)))
                                           (media-hex (string-code-point-at S (inc at)))))]
                     (recur (inc i)))))]
    (-> G (mem-set 7 (bit-or 128 (bit-and (vector-at G 7) 15)))
          (mem-set 8 (bit-or 128 (bit-and (vector-at G 8) 63))))))
(defn- media-crc-byte [value :i64 count :i64] :i64
  (if (= count 0) value
    (media-crc-byte (bit-xor (quot value 2) (if (= (bit-and value 1) 1) 3988292384 0)) (dec count))))
(defn- media-crc [D :vector-i64 base :i64 n :i64 skip :i64] :i64
  (loop [i 0 value 4294967295]
    (if (= i n) (bit-xor value 4294967295)
      (let [byte (if (and (>= skip 0) (>= i skip) (< i (+ skip 4))) 0 (vector-at D (+ base i)))]
        (recur (inc i) (media-crc-byte (bit-xor value byte) 8))))))
(defn- media-partition [D :vector-i64 guid :vector-i64] :vector-i64
  (let [entry 1024
        written (-> D (media-put entry 0x11d2f81fc12a7328 8)
                      (media-put (+ entry 8) 0x3bc93ec9a0004bba 8)
                      (media-copy (+ entry 16) guid 16)
                      (media-put (+ entry 32) 2048 8) (media-put (+ entry 40) 16350 8))
        named (loop [i 0]
                (if (= i 15) D
                  (let [w (media-put D (+ entry 56 (* i 2)) (string-code-point-at "Awai Native EFI" i) 2)]
                    (recur (inc i)))))]
    D))
(defn- media-header [D :vector-i64 lba :i64 entries :i64 guid :vector-i64] :vector-i64
  (let [at (* lba 512)
        fields (-> D (media-text at "EFI PART") (media-put (+ at 8) 65536 4)
                     (media-put (+ at 12) 92 4) (media-put (+ at 24) lba 8)
                     (media-put (+ at 32) (if (= lba 1) 16383 1) 8)
                     (media-put (+ at 40) 34 8) (media-put (+ at 48) 16350 8)
                     (media-copy (+ at 56) guid 16) (media-put (+ at 72) entries 8)
                     (media-put (+ at 80) 128 4) (media-put (+ at 84) 128 4)
                     (media-put (+ at 88) (media-crc D 1024 16384 -1) 4))]
    (media-put fields (+ at 16) (media-crc fields at 92 16) 4)))
(defn- media-directory [D :vector-i64 at :i64 name :string cluster :i64 size :i64] :vector-i64
  (-> D (media-text at name) (media-put (+ at 11) (if (= size 0) 16 32) 1)
        (media-put (+ at 16) 33 2) (media-put (+ at 18) 33 2) (media-put (+ at 24) 33 2)
        (media-put (+ at 26) cluster 2) (media-put (+ at 28) size 4)))
(defn- media-build [E :vector-i64 digest :string] :vector-i64
  (let [D (vector-alloc MEDIA-BYTES) disk (media-guid digest 0) partition (media-guid digest 32)
        mbr (-> D (media-put 440 (media-get disk 0 4) 4)
                  (media-put 446 0x00020000 4) (media-put 450 0xffffffee 4)
                  (media-put 454 1 4) (media-put 458 16383 4) (media-put 510 43605 2)
                  (media-partition partition))
        entries (loop [i 0]
                  (if (= i 16384) D
                    (let [w (mem-set D (+ (* 16351 512) i) (vector-at D (+ 1024 i)))]
                      (recur (inc i)))))
        headers (-> D (media-header 1 2 disk) (media-header 16383 16351 disk))
        bpb (-> D (media-put MEDIA-PART 0x903ceb 3) (media-text (+ MEDIA-PART 3) "KOTOBA  ")
                  (media-put (+ MEDIA-PART 11) 512 2) (media-put (+ MEDIA-PART 13) 1 1)
                  (media-put (+ MEDIA-PART 14) 1 2) (media-put (+ MEDIA-PART 16) 2 1)
                  (media-put (+ MEDIA-PART 17) 512 2) (media-put (+ MEDIA-PART 19) 14303 2)
                  (media-put (+ MEDIA-PART 21) 248 1) (media-put (+ MEDIA-PART 22) 56 2)
                  (media-put (+ MEDIA-PART 24) 63 2) (media-put (+ MEDIA-PART 26) 255 2)
                  (media-put (+ MEDIA-PART 28) 2048 4) (media-put (+ MEDIA-PART 36) 128 1)
                  (media-put (+ MEDIA-PART 38) 41 1) (media-put (+ MEDIA-PART 39) (media-get disk 0 4) 4)
                  (media-text (+ MEDIA-PART 43) "AWAI_NATIVE") (media-text (+ MEDIA-PART 54) "FAT16   ")
                  (media-put (+ MEDIA-PART 62) 0xfdebf4fa 4) (media-put (+ MEDIA-PART 510) 43605 2))
        fat (-> D (media-put MEDIA-FAT 65528 2) (media-put (+ MEDIA-FAT 2) 65535 2)
                  (media-put (+ MEDIA-FAT 4) 65535 2) (media-put (+ MEDIA-FAT 6) 65535 2))
        clusters (quot (+ (vector-count E) 511) 512)
        chain (loop [i 0]
                (if (= i clusters) D
                  (let [w (media-put D (+ MEDIA-FAT (* (+ i 4) 2)) (if (= (inc i) clusters) 65535 (+ i 5)) 2)]
                    (recur (inc i)))))
        mirror (loop [i 0]
                 (if (= i MEDIA-FAT-BYTES) D
                   (let [w (mem-set D (+ MEDIA-FAT MEDIA-FAT-BYTES i) (vector-at D (+ MEDIA-FAT i)))]
                     (recur (inc i)))))
        dirs (-> D (media-directory MEDIA-ROOT "EFI        " 2 0)
                   (media-directory MEDIA-DATA ".          " 2 0)
                   (media-directory (+ MEDIA-DATA 32) "..         " 0 0)
                   (media-directory (+ MEDIA-DATA 64) "BOOT       " 3 0)
                   (media-directory (+ MEDIA-DATA 512) ".          " 3 0)
                   (media-directory (+ MEDIA-DATA 544) "..         " 2 0)
                   (media-directory (+ MEDIA-DATA 576) "BOOTX64 EFI" 4 (vector-count E)))]
    (media-copy D MEDIA-FILE E (vector-count E))))
(defn- media-header? [D :vector-i64 lba :i64 entries :i64 guid :vector-i64] :bool
  (let [at (* lba 512)]
    (and (= (media-get D at 8) 0x5452415020494645)
         (= (media-get D (+ at 8) 4) 65536) (= (media-get D (+ at 12) 4) 92)
         (= (media-get D (+ at 16) 4) (media-crc D at 92 16))
         (= (media-get D (+ at 20) 4) 0) (= (media-get D (+ at 24) 8) lba)
         (= (media-get D (+ at 32) 8) (if (= lba 1) 16383 1))
         (= (media-get D (+ at 40) 8) 34) (= (media-get D (+ at 48) 8) 16350)
         (media-same? D (+ at 56) guid 16) (= (media-get D (+ at 72) 8) entries)
         (= (media-get D (+ at 80) 4) 128) (= (media-get D (+ at 84) 4) 128)
         (= (media-get D (+ at 88) 4) (media-crc D (* entries 512) 16384 -1)))))
(defn- media-valid? [D :vector-i64 E :vector-i64 digest :string] :bool
  (and (= (vector-count D) MEDIA-BYTES)
    (let [disk (media-guid digest 0) partition (media-guid digest 32) n (vector-count E)
          clusters (quot (+ n 511) 512)]
      (and (= (media-get D 510 2) 43605) (= (media-get D 450 1) 238)
           (= (media-get D 454 4) 1) (= (media-get D 458 4) 16383)
           (media-header? D 1 2 disk) (media-header? D 16383 16351 disk)
           (= (media-get D 1024 8) 0x11d2f81fc12a7328)
           (= (media-get D 1032 8) 0x3bc93ec9a0004bba)
           (media-same? D 1040 partition 16)
           (= (media-get D 1056 8) 2048) (= (media-get D 1064 8) 16350)
           (loop [i 0]
             (cond (= i 16384) true
                   (not= (vector-at D (+ 1024 i)) (vector-at D (+ (* 16351 512) i))) false :else (recur (inc i))))
           (= (media-get D (+ MEDIA-PART 11) 2) 512) (= (media-get D (+ MEDIA-PART 13) 1) 1)
           (= (media-get D (+ MEDIA-PART 14) 2) 1) (= (media-get D (+ MEDIA-PART 16) 1) 2)
           (= (media-get D (+ MEDIA-PART 17) 2) 512) (= (media-get D (+ MEDIA-PART 19) 2) 14303)
           (= (media-get D (+ MEDIA-PART 22) 2) 56) (= (media-get D (+ MEDIA-PART 28) 4) 2048)
           (= (media-get D (+ MEDIA-PART 510) 2) 43605)
           (loop [i 0]
             (cond (= i MEDIA-FAT-BYTES) true
                   (not= (vector-at D (+ MEDIA-FAT i)) (vector-at D (+ MEDIA-FAT MEDIA-FAT-BYTES i))) false
                   :else (recur (inc i))))
           (= (media-get D MEDIA-FAT 2) 65528) (= (media-get D (+ MEDIA-FAT 2) 2) 65535)
           (= (media-get D (+ MEDIA-FAT 4) 2) 65535) (= (media-get D (+ MEDIA-FAT 6) 2) 65535)
           (loop [i 0]
             (cond (= i clusters) true
                   (not= (media-get D (+ MEDIA-FAT (* (+ i 4) 2)) 2) (if (= (inc i) clusters) 65535 (+ i 5))) false
                   :else (recur (inc i))))
           (media-text? D MEDIA-ROOT "EFI        ")
           (media-text? D (+ MEDIA-DATA 64) "BOOT       ")
           (media-text? D (+ MEDIA-DATA 576) "BOOTX64 EFI")
           (= (media-get D (+ MEDIA-ROOT 11) 1) 16)
           (= (media-get D (+ MEDIA-DATA 64 11) 1) 16)
           (= (media-get D (+ MEDIA-DATA 576 11) 1) 32)
           (= (media-get D (+ MEDIA-ROOT 26) 2) 2)
           (= (media-get D (+ MEDIA-DATA 64 26) 2) 3)
           (= (media-get D (+ MEDIA-DATA 576 26) 2) 4)
           (= (media-get D (+ MEDIA-DATA 576 28) 4) n)
           (media-same? D MEDIA-FILE E n)))))
(defn- media-efi? [E :vector-i64] :bool
  (and (>= (vector-count E) 512) (<= (vector-count E) 6291456)
       (= (media-get E 0 2) 23117)
       (let [pe (media-get E 60 4)]
         (and (>= pe 64) (<= pe (- (vector-count E) 264))
              (= (media-get E pe 4) 17744) (= (media-get E (+ pe 4) 2) 34404)
              (= (media-get E (+ pe 24) 2) 523) (= (media-get E (+ pe 24 68) 2) 10)))))
(defn- seed-main [] :i64
  (if (or (not= (io-argc) 5) (not (media-digest? (io-arg 3))) (not (media-size? (io-arg 4)))
          (not= (media-crc [49 50 51 52 53 54 55 56 57] 0 9 -1) 3421780262))
    (let [w (io-err "native-media: invalid arguments or CRC32 self-check\n")] 1)
    (let [size-text (io-arg 4) size (mem-parse-dec size-text 0 (string-length size-text))
          E (if (and (>= size 512) (<= size 6291456)) (media-read (io-arg 1) size) (vector-alloc 0))
          operation (io-arg 0) path (io-arg 2) digest (io-arg 3)]
      (if (not (media-efi? E)) (let [w (io-err "native-media: EFI admission refused\n")] 1)
        (if (string=? operation "build")
          (if (= (io-exists path) 1) (let [w (io-err "native-media: output exists\n")] 1)
            (let [D (media-build E digest) written (io-write-bytes D path 0 MEDIA-BYTES)
                  readback (media-read path MEDIA-BYTES)]
              (if (and (= written MEDIA-BYTES) (media-valid? readback E digest))
                (let [w (io-out "PASS_NATIVE_GPT_FAT16_BUILD\n")] 0)
                (let [w (io-err "native-media: readback refused\n")] 1))))
          (if (string=? operation "verify")
            (let [D (media-read path MEDIA-BYTES)]
              (if (media-valid? D E digest) (let [w (io-out "PASS_NATIVE_GPT_FAT16_VERIFY\n")] 0)
                (let [w (io-err "native-media: invalid GPT/FAT/EFI\n")] 1)))
            (let [w (io-err "native-media: unsupported operation\n")] 1)))))))
