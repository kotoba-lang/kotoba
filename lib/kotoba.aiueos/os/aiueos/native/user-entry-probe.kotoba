(ns aiueos.native.user-entry-probe
  (:require [aiueos.native.kernel :as kernel]
            [aiueos.value-runtime-entry :as runtime]
            [aiueos.value-runtime-syscall-plan :as syscall]
            [aiueos.value-runtime-domain :as domain]
            [aiueos.value-runtime-capability-table :as capability]
            [aiueos.value-runtime-provider-policy :as provider]
            [aiueos.value-runtime-provider-transport :as transport]
            [aiueos.value-runtime-cas-verify :as cas]
            [aiueos.value-handle-arena :as handles])
  (:export [main aiueos-value-runtime-entry aiueos-value-runtime-syscall-plan
            aiueos-value-runtime-publish-domain
            aiueos-value-runtime-provider-status
            aiueos-value-runtime-capability-grant
            aiueos-value-runtime-provider-claim
            aiueos-value-runtime-provider-complete
            aiueos-value-runtime-cas-verify]))

;; C-free integration image root. The ordinary boot entry remains the native
;; kernel's main function; the ValueRuntime entry is linked into the same
;; sealed KIR/native image instead of being supplied as a foreign object.

;; The v3 profile owns vector6's controlled #UD entry. Keep the legacy kernel
;; declaration in the retained graph, without exporting a conflicting vector.
(defn aiueos-isr-6 [vector :i64 error :i64 rip :i64 rsp :i64] :i64
  (kernel/aiueos-isr-6 vector error rip rsp))

(defn aiueos-value-runtime-entry
  [arena :i64 entry-profile :i64 user-page :i64
   kernel-request :i64 cap-table :i64] :i64
  (runtime/aiueos-value-runtime-entry
   arena entry-profile user-page kernel-request cap-table))

(defn aiueos-value-runtime-syscall-plan
  [number :i64 domain :i64 pointer :i64 user-rip :i64 user-rsp :i64] :i64
  (syscall/aiueos-value-runtime-syscall-plan
   number domain pointer user-rip user-rsp))

(defn aiueos-value-runtime-publish-domain [current-domain :i64] :i64
  (domain/aiueos-value-runtime-publish-domain current-domain))

(defn aiueos-value-runtime-provider-status
  [generation :i64 active :i64] :i64
  (provider/aiueos-value-runtime-provider-status generation active))

(defn aiueos-value-runtime-capability-grant
  [action :i64 slot :i64 generation :i64 rights :i64 owner :i64] :i64
  (provider/aiueos-value-runtime-capability-grant
   action slot generation rights owner))

(defn aiueos-value-runtime-provider-complete
  [ticket :i64 route-domain :i64 block :i64
   block-length :i64 descriptor :i64] :i64
  (transport/aiueos-value-runtime-provider-complete
   ticket route-domain block block-length descriptor))

(defn aiueos-value-runtime-provider-claim [] :i64
  (transport/aiueos-value-runtime-provider-claim))

(defn aiueos-value-runtime-cas-verify
  [block :i64 block-length :i64 expected :i64
   output :i64 workspace :i64] :i64
  (cas/aiueos-value-runtime-cas-verify
   block block-length expected output workspace))

;; Hardware-entry mechanism probe; user bytes below are fixed ISA vectors,
;; not a qualified application compiler or scheduler.
(defn- retain-kernel [] :i64 (kernel/main))
(defn- byte! [code :i64 index :i64 value :i64] :i64
  (let [written (kernel-store-u8-4k code 4096 index value)]
    (if (= (kernel-load-u8-4k code 4096 index) value) 1 0)))
(defn- word! [code :i64 index :i64 value :i64 count :i64] :i64
  (if (= count 8) 1
    (if (= (byte! code (+ index count) (bit-and (u64-shift-right value (* count 8)) 255)) 1)
      (word! code index value (+ count 1)) 0)))
(defn- user-code [code :i64 request :i64 context :i64 mode :i64] :i64
  (if (or (= mode 6) (= mode 7))
    (if (= mode 6)
      (let [a (byte! code 0 176) b (byte! code 1 80) c (byte! code 2 102)
            d (byte! code 3 186) e (byte! code 4 233) f (byte! code 5 0)
            g (byte! code 6 238) h (byte! code 7 235) i (byte! code 8 254)]
        (if (= (+ a b c d e f g h i) 9) 1 0))
      (let [a (byte! code 0 15) b (byte! code 1 52)
            c (byte! code 2 235) d (byte! code 3 254)]
        (if (= (+ a b c d) 4) 1 0)))
  (if (and (>= mode 1) (<= mode 3))
    (let [target (if (= mode 1) context (if (= mode 2) request (+ code 8192)))
          a (byte! code 0 72) b (byte! code 1 184) pointer (word! code 2 target 0)
          x (byte! code 10 (if (= mode 1) 72 (if (= mode 2) 255 198)))
          y (byte! code 11 (if (= mode 1) 139 (if (= mode 2) 224 0)))
          z (byte! code 12 (if (= mode 3) 1 0))
          loop0 (byte! code 13 235) loop1 (byte! code 14 254)]
      (if (= (+ a b pointer x y z loop0 loop1) 8) 1 0))
    (let [a0 (byte! code 0 73) a1 (byte! code 1 185) forged-r9 (word! code 2 1234605616436508552 0)
          a10 (byte! code 10 72) a11 (byte! code 11 191)
          pointer (word! code 12 (if (= mode 4) context request) 0)
          a20 (byte! code 20 184) number (byte! code 21 (if (= mode 5) 2 5))
          n22 (byte! code 22 0) n23 (byte! code 23 0) n24 (byte! code 24 0)
          a25 (byte! code 25 15) a26 (byte! code 26 5)
          a27 (byte! code 27 72) a28 (byte! code 28 191) output (word! code 29 request 0)
          a37 (byte! code 37 72) a38 (byte! code 38 137) a39 (byte! code 39 135)
          a40 (byte! code 40 128) a41 (byte! code 41 0) a42 (byte! code 42 0) a43 (byte! code 43 0)
          a44 (byte! code 44 76) a45 (byte! code 45 137) a46 (byte! code 46 143)
          a47 (byte! code 47 136) a48 (byte! code 48 0) a49 (byte! code 49 0) a50 (byte! code 50 0)
          a51 (byte! code 51 235) a52 (byte! code 52 254)]
      (if (= (+ a0 a1 forged-r9 a10 a11 pointer a20 number n22 n23 n24 a25 a26 a27 a28 output
                a37 a38 a39 a40 a41 a42 a43 a44 a45 a46 a47 a48 a49 a50 a51 a52) 32) 1 0)))))
(defn main [] :i64
  (let [published (kernel-value-runtime-invoke 2 73 0 0 0 0)
        arena (kernel-value-runtime-arena 73)
        request (kernel-value-domain-request-page 73)
        code (kernel-value-domain-code-page 73)
        stack (kernel-value-domain-stack-page 73)
        context (- (kernel-value-runtime-request) 32896)
        handle (handles/aiueos-value-handle-arena arena 4096 1 0 38654705671)
        record (kernel-owned-page 0)
        marker (kernel-store-u64-4k record 4096 0 42)
        mode (kernel-in-u8 233)
        recorded-mode (kernel-store-u64-4k record 4096 8 mode)
        magic (kernel-store-u32-4k request 4096 0 1364350539)
        version (kernel-store-u8-4k request 4096 4 1)
        operation (kernel-store-u8-4k request 4096 5 3)
        requested-handle (kernel-store-u32-4k request 4096 8 handle)
        program (user-code code request context mode)
        enabled (if (and (= published 73) (= handle 1) (> code 0) (> stack code)
                         (= marker 42) (= recorded-mode mode) (= program 1))
                  (kernel-value-enable-user) 0)
        program-status (kernel-store-u64-4k record 4096 16 program)
        enabled-status (kernel-store-u64-4k record 4096 24 enabled)]
    (if (= enabled 1) (kernel-value-enter-user 73) 0)))
