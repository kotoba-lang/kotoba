(ns aiueos.native.ed-entry
  (:require [aiueos.native.kernel :as kernel]
            [aiueos.native.desktop :as desktop]
            [aiueos.value-runtime-entry :as runtime]
            [aiueos.value-runtime-syscall-plan :as syscall]
            [aiueos.value-runtime-domain :as domain]
            [aiueos.value-runtime-capability-table :as capability]
            [aiueos.value-runtime-provider-policy :as provider]
            [aiueos.value-runtime-provider-transport :as transport]
            [aiueos.value-runtime-cas-verify :as cas]
            [aiueos.ed25519 :as ed])
  (:export [main aiueos-value-runtime-entry aiueos-value-runtime-syscall-plan
            aiueos-value-runtime-publish-domain aiueos-value-runtime-provider-status
            aiueos-value-runtime-capability-grant aiueos-value-runtime-provider-claim
            aiueos-value-runtime-provider-complete aiueos-value-runtime-cas-verify]))

;; Preserve the actual kernel graph; v3 owns the controlled #UD vector.
(defn legacy-kernel-undefined [v :i64 e :i64 p :i64 s :i64] :i64
  (kernel/aiueos-isr-6 v e p s))
(defn aiueos-value-runtime-entry [a :i64 p :i64 u :i64 r :i64 c :i64] :i64
  (runtime/aiueos-value-runtime-entry a p u r c))
(defn aiueos-value-runtime-syscall-plan [n :i64 d :i64 p :i64 i :i64 s :i64] :i64
  (syscall/aiueos-value-runtime-syscall-plan n d p i s))
(defn aiueos-value-runtime-publish-domain [d :i64] :i64
  (domain/aiueos-value-runtime-publish-domain d))
(defn aiueos-value-runtime-provider-status [g :i64 a :i64] :i64
  (provider/aiueos-value-runtime-provider-status g a))
(defn aiueos-value-runtime-capability-grant [a :i64 s :i64 g :i64 r :i64 o :i64] :i64
  (provider/aiueos-value-runtime-capability-grant a s g r o))
(defn aiueos-value-runtime-provider-claim [] :i64
  (transport/aiueos-value-runtime-provider-claim))
(defn aiueos-value-runtime-provider-complete [t :i64 r :i64 b :i64 n :i64 d :i64] :i64
  (transport/aiueos-value-runtime-provider-complete t r b n d))
(defn aiueos-value-runtime-cas-verify [b :i64 n :i64 e :i64 o :i64 w :i64] :i64
  (cas/aiueos-value-runtime-cas-verify b n e o w))
;; W3d/W3e slices (ADR-0277): before the desktop starts the kernel derives Ed25519 public keys and signs three
;; short messages with the RFC 8032 section 7.1 seeds, keys first (see below). The kernel derives Ed25519 public keys from three
;; RFC 8032 section 7.1 test seeds with aiueos.ed25519 and leaves 128 bytes per case (the first 32 are the
;; encoded public key) in the browser context from word 320, for the QEMU gate. Word 99 is the marker,
;; written last. The seeds are the published test vectors: no device key exists, nothing is signed.
(defn seed-flat [i]
  (case i 0 157 1 97 2 177 3 157 4 239 5 253 6 90 7 96 8 186 9 132 10 74 11 244 12 146 13 236 14 44 15 196 16 68 17 73 18 197 19 105 20 123 21 50 22 105 23 25 24 112 25 59 26 172 27 3 28 28 29 174 30 127 31 96 32 76 33 205 34 8 35 155 36 40 37 255 38 150 39 218 40 157 41 182 42 195 43 70 44 236 45 17 46 78 47 15 48 91 49 138 50 49 51 159 52 53 53 171 54 166 55 36 56 218 57 140 58 246 59 237 60 79 61 184 62 166 63 251 64 197 65 170 66 141 67 244 68 63 69 159 70 131 71 123 72 237 73 183 74 68 75 47 76 49 77 220 78 183 79 177 80 102 81 211 82 133 83 53 84 7 85 111 86 9 87 75 88 133 89 206 90 58 91 46 92 11 93 68 94 88 95 247 0))

;; A one-byte kernel-subregion keeps the size operand at 1: kernel-store-u8 (the plain tier) traps with #UD
;; at run time when the size is above 512, and the compiler does not check that (JUN-483). A tiered form
;; (kernel-store-u8-16k for up to 16384) would also work on the whole region.
(defn put8 [ctx at v] (kernel-store-u8 (kernel-subregion ctx 8192 at 1) 1 0 v))

(defn fill-seed [ctx k i]
  (if (>= i 32) 0
    (let [x (put8 ctx (+ 1024 i) (seed-flat (+ (* k 32) i)))]
      (fill-seed ctx k (+ i (+ 1 (* 0 x)))))))

(defn run-case [ctx k]
  (let [f (fill-seed ctx k 0)]
    (+ 1 (* 0 (+ f (ed/aiueos-ed25519-pubkey
                     (kernel-subregion ctx 8192 1024 32)
                     (kernel-subregion ctx 8192 (+ 1280 (* k 128)) 128)
                     (kernel-subregion ctx 8192 4096 4096)
                     (kernel-subregion ctx 8192 1088 64)))))))

;; signing: message bytes of the three RFC 8032 section 7.1 vectors (lengths 0, 1, 2), signatures 64 bytes each
;; at ctx byte 3072 + 64 k (words 768..), the 1024-byte working buffer at ctx byte 2048.
(defn msg-flat [i]
  (case i 0 0 1 0 2 114 3 0 4 175 5 130 0))
(defn msg-len [k] (case k 0 0 1 1 2))

(defn fill-sign [ctx k i]
  (if (>= i 32) 0
    (let [x (put8 ctx (+ 2048 i) (seed-flat (+ (* k 32) i)))]
      (fill-sign ctx k (+ i (+ 1 (* 0 x)))))))
(defn fill-msg [ctx k i]
  (if (>= i 2) 0
    (let [x (put8 ctx (+ 2304 i) (msg-flat (+ (* k 2) i)))]
      (fill-msg ctx k (+ i (+ 1 (* 0 x)))))))

(defn sign-case [ctx k]
  (let [f (fill-sign ctx k 0)
        m (fill-msg ctx k 0)]
    (+ 1 (* 0 (+ f (+ m (ed/aiueos-ed25519-sign
                          (kernel-subregion ctx 8192 2048 1024) (msg-len k)
                          (kernel-subregion ctx 8192 (+ 3072 (* k 64)) 64)
                          (kernel-subregion ctx 8192 4096 4096))))))))

(defn put-result [ctx i value]
  (kernel-store-u32 (kernel-subregion ctx 8192 (* i 4) 4) 4 0 value))

(defn ed-selftest []
  (let [ctx (kernel-browser-context)
        r0 (run-case ctx 0)
        r1 (run-case ctx 1)
        r2 (run-case ctx 2)
        s0 (sign-case ctx 0)
        s1 (sign-case ctx 1)
        s2 (sign-case ctx 2)]
    (put-result ctx 99 (+ 1162097205 (* 0 (+ r0 (+ r1 (+ r2 (+ s0 (+ s1 s2))))))))))

(defn main [] :i64
  ;; Consent gate image (ADR-0275 W1): the goal-model profile, whose Itonami Enter
  ;; opens the consent surface. The root explicitly selects the image's private GOP/Browser profile.
  ;; PCI/GOP/font sealing happens before any Kotoba body receives a region.
  (let [width (kernel-framebuffer-width)
        registered (kernel-register-value-domain 73)
        published (kernel-publish-current-domain 73)
        enabled (kernel-value-enable-user)]
    (if (and (> width 0) (> registered 0) (= published 73) (= enabled 1))
      (do (ed-selftest) (desktop/goal-model-main)) 0)))
