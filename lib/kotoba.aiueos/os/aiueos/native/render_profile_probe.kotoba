(ns aiueos.native.render-profile-probe
  (:require [aiueos.native.render-profile :as profile]
            [aiueos.native.bluetooth-sc :as sc]
            [aiueos.native.hid-mouse :as mouse]
            [aiueos.browser-frame2 :as frame]
            [aiueos.native.bluetooth-legacy :as legacy])
  (:export [run]))
(defn table-byte [table i]
  (if (< table 11) (sc/vector table i) (sc/expected-byte (- table 11) i)))
(defn emit [ctx table i]
  (if (= table 19) 1
    (if (= i 64) (emit ctx (+ table 1) 0)
      (do (kernel-store-u8 (kernel-subregion ctx 8192 (+ 1024 (* table 64) i) 1) 1 0 (table-byte table i))
          (emit ctx table (+ i 1))))))
(defn bounds [ctx table]
  (if (= table 19) 1
    (do (kernel-store-u8 (kernel-subregion ctx 8192 (+ 2240 (* table 2)) 1) 1 0 (table-byte table -1))
        (kernel-store-u8 (kernel-subregion ctx 8192 (+ 2241 (* table 2)) 1) 1 0 (table-byte table 64))
        (bounds ctx (+ table 1)))))
(defn mouse-byte [table i] (if (= table 0) (mouse/vector-16 i) (mouse/vector-12 i)))
(defn mouse-emit [ctx table i]
  (if (= table 2) 1
    (if (= i 80) (mouse-emit ctx (+ table 1) 0)
      (do (kernel-store-u8 (kernel-subregion ctx 8192 (+ 2304 (* table 80) i) 1) 1 0 (mouse-byte table i))
          (mouse-emit ctx table (+ i 1))))))
(defn mouse-bounds [ctx table]
  (if (= table 2) 1
    (do (kernel-store-u8 (kernel-subregion ctx 8192 (+ 2464 (* table 2)) 1) 1 0 (mouse-byte table -1))
        (kernel-store-u8 (kernel-subregion ctx 8192 (+ 2465 (* table 2)) 1) 1 0 (mouse-byte table 80))
        (mouse-bounds ctx (+ table 1)))))
(defn text-emit [ctx line index]
  (if (= line 51) 1
    (if (= index 24) (text-emit ctx (+ line 1) 0)
      (do (kernel-store-u32 (kernel-subregion ctx 8192 (+ 2560 (* line 96) (* index 4)) 4) 4 0 (frame/lit-word line index))
          (text-emit ctx line (+ index 1))))))
(defn text-bounds [ctx line]
  (if (= line 51)
    (do (kernel-store-u32 (kernel-subregion ctx 8192 7864 4) 4 0 (frame/lit-word -1 0))
        (kernel-store-u32 (kernel-subregion ctx 8192 7868 4) 4 0 (frame/lit-word 51 0)))
    (do (kernel-store-u32 (kernel-subregion ctx 8192 (+ 7456 (* line 8)) 4) 4 0 (frame/lit-word line -1))
        (kernel-store-u32 (kernel-subregion ctx 8192 (+ 7460 (* line 8)) 4) 4 0 (frame/lit-word line 24))
        (text-bounds ctx (+ line 1)))))
(defn legacy-emit [table i]
  (if (= table 9) 1
    (if (= i 32) (legacy-emit (+ table 1) 0)
      (do (kernel-store-u8 (kernel-subregion (kernel-browser-surface) 8192 (+ 1024 (* table 32) i) 1) 1 0 (legacy/vector-data table i))
          (legacy-emit table (+ i 1))))))
(defn legacy-bounds [table]
  (if (= table 9) 1
    (do (kernel-store-u8 (kernel-subregion (kernel-browser-surface) 8192 (+ 1312 (* table 2)) 1) 1 0 (legacy/vector-data table -1))
        (kernel-store-u8 (kernel-subregion (kernel-browser-surface) 8192 (+ 1313 (* table 2)) 1) 1 0 (legacy/vector-data table 32))
        (legacy-bounds (+ table 1)))))
(defn park [] (do (kernel-pause) (park)))
(defn run [] :i64
  (let [ctx (kernel-browser-context) irq (kernel-cli)]
    (do (frame/aiueos-browser-frame2 (kernel-browser-surface) 8192 (kernel-native-font) 524288)
        (kernel-store-u32-16k (kernel-desktop-effects) 16384 512 1515870810)
        (profile/start) (emit ctx 0 0) (profile/tile-time 120 (profile/read64 88)) (profile/phase 92)
        (bounds ctx 0) (mouse-emit ctx 0 0) (mouse-bounds ctx 0) (text-emit ctx 0 0) (text-bounds ctx 0) (legacy-emit 0 0) (legacy-bounds 0) (profile/phase 94) (profile/mode 0) (profile/composed)
        (profile/tile-time 122 (profile/read64 90))
        (profile/phase 98) (profile/finish)
        (kernel-store-u32 (kernel-subregion ctx 8192 296 4) 4 0
          (+ (if (> (profile/read64 100) 0) 1 0)
             (if (= (profile/value 108) 1) 2 0)
             (if (= (profile/value 110) 1) 4 0)
             (if (= (profile/value 111) 0) 8 0)
             (if (and (> (profile/read64 124) 0) (> (profile/read64 126) 0)) 16 0)
             (if (= (profile/value 128) 1515870810) 32 0)))
        (kernel-store-u32 (kernel-subregion ctx 8192 316 4) 4 0 (+ 1 (* irq 0)))
        (park))))
