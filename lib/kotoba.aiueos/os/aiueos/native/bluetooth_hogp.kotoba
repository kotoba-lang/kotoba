                (fail 71)) (fail (+ 512 (r 4))))
            (case state
              1 (if (and (= op 17) (or (= (r 1) 6) (= (r 1) 20)) (= (mod (- (w 2) 2) (r 1)) 0)) (services 2 (r 1)) (fail 72))
              2 (if (and (= op 9) (or (= (r 1) 7) (= (r 1) 21)) (= (mod (- (w 2) 2) (r 1)) 0)) (chars 2 (r 1)) (fail 73))
              3 (if (and (= op 5) (or (= (r 1) 1) (= (r 1) 2))) (descriptors 2 (if (= (r 1) 1) 4 18)) (fail 74))
              4 (if (and (= op 11) (= (w 2) 3))
                  (if (= (r 2) 1) (do (p16 1764 (r 1)) (read-map)) (choose-input (+ (u16 1766) 1))) (fail 75))
              5 (if (or (and (= (w 22) 10) (= op 11)) (and (= (w 22) 12) (= op 13))) (map-part) (fail 76))
              6 (if (and (= op 19) (= (w 2) 1)) (do (put 21 7) (put 0 15) (fill 1792 32 0) (p16 1770 0) (p16 1772 0) 1) (fail 77))
              0)))))))
(defn next-key [i] :i64
  (if (and (= (u16 1770) 1) (= (w 0) 15) (= (le/word 11) 1))
    (hid/new-key (load-report 1800 0 0) (load-report 1792 0 0) i) 0))
(defn acknowledge [] :i64 (p16 1770 0))
(defn quarantine [] :i64 (do (p16 1770 0) (p16 1772 1)))
;; USB HID short-item parser, bounded to1024 bytes and the selected Report ID.
;; Admit only modifiers8/reserved8/six-key-array48. No NKRO guess or ID byte.
(defn item-value [at n i acc] :i64
  (if (= i n) acc (item-value at n (+ i 1) (+ acc (i64-shift-left (usb/ble-map (+ at i)) (* i 8))))))
(defn map-input [bits mask page size count minusage maxusage flags] :i64
  (let [width (* size count)]
    (if (and (= bits 0) (= page 7) (= size 1) (= count 8) (= minusage 224) (= maxusage 231) (= (bit-and flags 7) 2)) 1
      (if (and (= bits 8) (= width 8) (= (bit-and flags 1) 1)) 2
        (if (and (= bits 16) (= page 7) (= size 8) (= count 6) (= (bit-and flags 7) 0)) 4 0)))))
(defn map-items [at n selected id page size count minusage maxusage bits mask fuel] :i64
  (if (= at n) (if (and (= bits 64) (= mask 7)) 1 0)
    (if (or (> at n) (= fuel 0)) 0
      (let [prefix (usb/ble-map at) len (case (bit-and prefix 3) 3 4 (bit-and prefix 3))
            next (+ at 1 len) typ (bit-and (quot prefix 4) 3) tag (quot prefix 16)]
        (if (or (= prefix 254) (> next n)) 0
          (let [v (item-value (+ at 1) len 0 0)]
            (if (= typ 1)
              (case tag
                0 (map-items next n selected id v size count minusage maxusage bits mask (- fuel 1))
                7 (map-items next n selected id page v count minusage maxusage bits mask (- fuel 1))
                8 (if (or (= v 0) (> v 255)) 0 (map-items next n selected v page size count minusage maxusage bits mask (- fuel 1)))
                9 (map-items next n selected id page size v minusage maxusage bits mask (- fuel 1))
                10 0 11 0
                (map-items next n selected id page size count minusage maxusage bits mask (- fuel 1)))
              (if (= typ 2)
                (map-items next n selected id page size count (if (= tag 1) v minusage) (if (= tag 2) v maxusage) bits mask (- fuel 1))
                (if (and (= typ 0) (= tag 8) (= id selected))
                  (let [part (map-input bits mask page size count minusage maxusage v)]
                    (if (= part 0) 0 (map-items next n selected id page size count 0 0 (+ bits (* size count)) (bit-or mask part) (- fuel 1))))
                  (map-items next n selected id page size count (if (= typ 0) 0 minusage) (if (= typ 0) 0 maxusage) bits mask (- fuel 1)))))))))))
(defn report-layout [selected n] :i64
  (if (or (< n 1) (> n 1024)) 0 (map-items 0 n selected 0 0 0 0 0 0 0 0 1024)))

(defn map-vector [i] :i64
  (case i 0 5 1 1 2 9 3 6 4 161 5 1 6 133 7 1 8 5 9 7 10 25 11 224 12 41 13 231
    14 21 15 0 16 37 17 1 18 117 19 1 20 149 21 8 22 129 23 2 24 117 25 8 26 149 27 1
    28 129 29 1 30 149 31 6 32 117 33 8 34 21 35 0 36 37 37 101 38 5 39 7 40 25 41 0
    42 41 43 101 44 129 45 0 46 192 0))
(defn stage-map [i] :i64
  (if (>= i 47) 1 (do (usb/ble-map-put i (map-vector i)) (stage-map (+ i 1)))))
(defn test-bit [v bit] :i64 (if (= v 1) bit 0))
(defn self-check [] :i64
  (do (put 0 15) (put 12 1) (put 16 42) (le/put 11 1)
      (let [a (test-bit (admit 42 262144 8) 1)
            b (test-bit (- 1 (admit 43 262144 8)) 2)
            c (test-bit (- 1 (admit 42 262144 7)) 4)
            d (test-bit (- 1 (admit 42 262400 8)) 8)
            e (test-bit (- 1 (admit 42 65536 8)) 16)]
        (do (put 12 0)
            (let [f (test-bit (- 1 (admit 42 262144 8)) 32)]
              (do (put 12 1) (le/put 11 0)
                  (let [g (test-bit (- 1 (admit 42 262144 8)) 64)]
                    (do (le/put 11 1) (put 0 5)
                        (let [h (test-bit (- 1 (admit 42 262144 8)) 128)]
                          (do (stage-map 0)
                              (+ a b c d e f g h
                                 (test-bit (report-layout 1 47) 256)
                                 (test-bit (- 1 (report-layout 2 47)) 512)
                                 (test-bit (- 1 (report-layout 1 45)) 1024)
                                 (test-bit (- 1 (report-layout 1 1025)) 2048)
                                 (test-bit (- 1 (hid/new-key 262144 262144 2)) 4096)
                                 (test-bit (if (= (hid/new-key 0 262144 2) 30) 1 0) 8192))))))))))))
