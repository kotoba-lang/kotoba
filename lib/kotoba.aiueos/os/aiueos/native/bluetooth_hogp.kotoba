;; USB HID short-item parser, bounded to1024 bytes and the selected Report ID.
;; Admit only modifiers8/reserved8/six-key-array48. No NKRO guess or ID byte.
(defn item-value [at n i acc] :i64
  (if (= i n) acc (item-value at n (+ i 1) (+ acc (i64-shift-left (usb/ble-map (+ at i)) (* i 8))))))
(defn map-input [bits mask page size count minusage maxusage flags] :i64
  (let [width (* size count)]
    (if (and (= bits 0) (= page 7) (= size 1) (= count 8) (= minusage 224) (= maxusage 231) (= (bit-and flags 7) 2)) 1
      (if (and (= bits 8) (= width 8) (= (bit-and flags 1) 1)) 2
        (if (and (= bits 16) (= page 7) (= size 8) (= count 6) (= (bit-and flags 7) 0)) 4 0)))))
(defn map-items [at n selected id page size count minusage maxusage bits mask fuel] :i64
  (if (= at n) (if (and (= bits 64) (= mask 7)) 1 0)
    (if (or (> at n) (= fuel 0)) 0
      (let [prefix (usb/ble-map at) len (case (bit-and prefix 3) 3 4 (bit-and prefix 3))
            next (+ at 1 len) typ (bit-and (quot prefix 4) 3) tag (quot prefix 16)]
        (if (or (= prefix 254) (> next n)) 0
          (let [v (item-value (+ at 1) len 0 0)]
            (if (= typ 1)
              (case tag
                0 (map-items next n selected id v size count minusage maxusage bits mask (- fuel 1))
                7 (map-items next n selected id page v count minusage maxusage bits mask (- fuel 1))
                8 (if (or (= v 0) (> v 255)) 0 (map-items next n selected v page size count minusage maxusage bits mask (- fuel 1)))
                9 (map-items next n selected id page size v minusage maxusage bits mask (- fuel 1))
                10 0 11 0
                (map-items next n selected id page size count minusage maxusage bits mask (- fuel 1)))
              (if (= typ 2)
                (map-items next n selected id page size count (if (= tag 1) v minusage) (if (= tag 2) v maxusage) bits mask (- fuel 1))
                (if (and (= typ 0) (= tag 8) (= id selected))
                  (let [part (map-input bits mask page size count minusage maxusage v)]
                    (if (= part 0) 0 (map-items next n selected id page size count 0 0 (+ bits (* size count)) (bit-or mask part) (- fuel 1))))
                  (map-items next n selected id page size count (if (= typ 0) 0 minusage) (if (= typ 0) 0 maxusage) bits mask (- fuel 1)))))))))))
(defn report-layout [selected n] :i64
  (if (or (< n 1) (> n 1024)) 0 (map-items 0 n selected 0 0 0 0 0 0 0 0 1024)))

