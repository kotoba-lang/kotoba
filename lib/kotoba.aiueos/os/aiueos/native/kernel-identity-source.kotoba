;; Native unity fragment, assembled after the exact Amu seed 00/01/02 and 03-source-sha256 helpers (JUN-555).
;; Writes os/aiueos's kernel/initramfs identity C source: the bytes the retired
;; inline Python (identity `PY`) in scripts/build-uefi.sh wrote for the same files.
;; argv: output kernel kernel-bytes initramfs initramfs-bytes; names are beneath the FD 3 scope. The inputs
;; are read in bounded FS2 slices and hashed with seed 03's SHA-256.
(def KID-MAX-BYTES 67108864)
(defn- kid-ack? [B :vector-i64 n :i64] :bool
  (and (= (vector-count B) (+ n 5)) (= (vector-at B 0) 0)
       (= (vector-at B 1) 70) (= (vector-at B 2) 83)
       (= (vector-at B 3) 50) (= (vector-at B 4) 0)))
(defn- kid-decimal? [S :string] :bool
  (and (> (string-length S) 0) (<= (string-length S) 10)
       (loop [i 0]
         (cond (= i (string-length S)) true
               (or (< (string-code-point-at S i) 48) (> (string-code-point-at S i) 57)) false
               :else (recur (inc i))))))
;; the whole file of n bytes in bounded FS2 slices, or [-1] on a refused slice. On
;; this Amu root FS2 whole-file reads and stat trap, so the runner passes the exact
;; size of its private staged copy (@size:NAME); reading past the end traps (exit 133).
(defn- kid-read [path :string size-text :string] :vector-i64
  (let [n (if (kid-decimal? size-text) (mem-parse-dec size-text 0 (string-length size-text)) -1)]
    (if (or (< n 0) (> n KID-MAX-BYTES)) [-1]
      (loop [at 0 D (vector-alloc n)]
        (if (= at n) D
          (let [count (io-min 262144 (- n at))
                B (vector-i64-from-bytes
                    (typed-cap-call :fs/app-data :string :bytes
                      (string-concat (io-fs2-header 69 path)
                        (string-concat (mem-u2dec at) (string-concat ":" (mem-u2dec count))))))]
            (if (not (kid-ack? B count)) [-1]
              (recur (+ at count)
                (loop [i 0 V D]
                  (if (= i count) V (recur (inc i) (vector-assoc! V (+ at i) (vector-at B (+ i 5))))))))))))))
(defn- kid-values [hex :string] :string
  (loop [i 0 acc ""]
    (if (= i 32) acc
      (recur (inc i)
        (string-concat acc (string-concat (if (= i 0) "0x" ",0x") (string-substring hex (* 2 i) (+ 2 (* 2 i)))))))))
(defn- kid-refused? [V :vector-i64] :bool (and (= (vector-count V) 1) (< (vector-at V 0) 0)))
(defn- seed-main [] :i64
  (if (not= (io-argc) 5)
    (let [w (io-err "error: kernel identity source takes output kernel bytes initramfs bytes\n")] 1)
    (let [path (io-arg 0) K (kid-read (io-arg 1) (io-arg 2)) I (kid-read (io-arg 3) (io-arg 4))]
      (cond (or (kid-refused? K) (kid-refused? I))
            (let [w (io-err "error: kernel or initramfs size is invalid or a slice was refused\n")] 1)
            (= (io-exists path) 1) (let [w (io-err "error: kernel identity source output exists\n")] 1)
            :else
            (let [kh (sh-bytes K) ih (sh-bytes I)
                  text (string-concat "#include <stdint.h>\n"
                         (string-concat (string-concat "const uint8_t aiueos_expected_kernel_sha256[32]={"
                                                       (string-concat (kid-values kh) "};\n"))
                           (string-concat "const uint8_t aiueos_expected_initramfs_sha256[32]={"
                                          (string-concat (kid-values ih) "};\n"))))
                  V (vector-i64-from-bytes (string-to-utf8 text))
                  n (vector-count V)
                  written (if (and (= (string-length kh) 64) (= (string-length ih) 64))
                            (io-write-bytes V path 0 n) 0)
                  B (io-read-bytes path)]
              (if (and (= written n) (= (vector-count B) n)
                       (loop [i 0]
                         (cond (= i n) true
                               (not= (vector-at B i) (vector-at V i)) false
                               :else (recur (inc i)))))
                0
                (let [w (io-err "error: kernel identity source readback differs\n")] 1)))))))
