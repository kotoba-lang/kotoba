(ns aiueos.native.hid-mouse
  ;; HID1.11 short items, mouse Application collection, Report Reference ID.
  ;; Descriptor/map and selected layout are separate from packet bytes.
  ;; Relative signed8/12/16-bit axes,1..8 buttons, optional wheel/AC Pan.
  (:require [aiueos.native.xhci :as usb])
  (:export [layout boot valid field set-report report ingress pending acknowledge quarantine reset self-check]))
(defn b [i] :i64 (usb/ble-state i))
(defn p [i v] :i64 (usb/ble-put i (bit-and v 255)))
(defn g [i] :i64 (usb/ble-hid-state i))
(defn put [i v] :i64 (usb/ble-hid-put i v))
(defn signed [v n] :i64
  (if (>= v (i64-shift-left 1 (- (* n 8) 1))) (- v (i64-shift-left 1 (* n 8))) v))
(defn minimum [] :i64 (if (>= (g 5) 2147483648) (- (g 5) 4294967296) (g 5)))
(defn clear [i end] :i64 (if (>= i end) 1 (do (p i 0) (clear (+ i 1) end))))
(defn clear-state [i] :i64 (if (>= i 64) 1 (do (put i 0) (clear-state (+ i 1)))))
(defn mask [n] :i64 (if (= n 64) -1 (- (i64-shift-left 1 n) 1)))
(defn store64 [dst value i] :i64
  (if (= i 8) 1 (do (p (+ dst i) (u64-shift-right value (* i 8))) (store64 dst value (+ i 1)))))
(defn load64 [src i value] :i64
  (if (= i 8) value (load64 src (+ i 1) (bit-or value (i64-shift-left (b (+ src i)) (* i 8))))))
(defn reset [] :i64 (clear 1840 1888))
(defn report [] :i64 (load64 1864 0 0))
(defn set-report [value] :i64 (store64 1864 value 0))
(defn value [at n i acc] :i64
  (if (= i n) acc (value at n (+ i 1) (+ acc (i64-shift-left (usb/ble-map (+ at i)) (* i 8))))))
(defn local-reset [] :i64 (do (put 7 0) (put 8 0) (put 9 0)))
(defn usage [i] :i64
  (if (> (g 7) 0) (if (< i (g 7)) (g (+ 16 i)) -1)
    (if (and (> (g 8) 0) (<= (+ (g 8) i) (g 9))) (+ (g 8) i) -1)))
(defn push-copy [i to-stack] :i64
  (if (> i 6) 1
    (do (if (= to-stack 1) (put (+ 32 (+ (* (g 15) 6) (- i 1))) (g i))
           (put i (g (+ 32 (+ (* (g 15) 6) (- i 1))))))
        (push-copy (+ i 1) to-stack))))
(defn global [tag v n] :i64
  (case tag
    0 (if (> v 65535) 0 (do (put 2 v) 1))
    1 (if (= n 0) 0 (do (put 5 (signed v n)) 1))
    2 (if (= n 0) 0 (do (put 6 (if (< (minimum) 0) (signed v n) v)) 1))
    7 (do (put 3 v) 1)
    8 (if (or (= v 0) (> v 255)) 0 (do (put 1 v) 1))
    9 (do (put 4 v) 1)
    10 (if (>= (g 15) 4) 0 (do (push-copy 1 1) (put 15 (+ (g 15) 1)) 1))
    11 (if (= (g 15) 0) 0 (do (put 15 (- (g 15) 1)) (push-copy 1 0) 1))
    1))
(defn local [tag v] :i64
  (case tag
    0 (if (>= (g 7) 8) 0 (do (put (+ 16 (g 7)) v) (put 7 (+ (g 7) 1)) 1))
    1 (do (put 8 v) 1) 2 (do (put 9 v) 1) 10 0 1))
(defn button-usages [i] :i64
  (if (= i (g 4)) 1
    (if (= (usage i) (+ i 1)) (button-usages (+ i 1)) 0)))
(defn buttons [flags] :i64
  (if (and (= (g 2) 9) (= (g 3) 1) (>= (g 4) 1) (<= (g 4) 8)
           (= (minimum) 0) (= (g 6) 1) (= (bit-and flags 7) 2)
           (= (bit-and (g 11) 1) 0) (= (button-usages 0) 1))
    (do (p 1846 (g 10)) (p 1847 (g 4)) (put 11 (bit-or (g 11) 1)) 1) 0))
(defn axis-range [] :i64
  (if (and (or (= (g 3) 8) (= (g 3) 12) (= (g 3) 16))
           (= (g 6) (- (i64-shift-left 1 (- (g 3) 1)) 1))
           (or (= (minimum) (- 0 (i64-shift-left 1 (- (g 3) 1))))
               (= (minimum) (- 1 (i64-shift-left 1 (- (g 3) 1)))))) 1 0))
(defn axis [usage offset] :i64
  (let [kind (if (= (g 2) 1) (case usage 48 0 49 1 56 2 -1)
               (if (and (= (g 2) 12) (= usage 568)) 3 -1))]
    (if (or (< kind 0) (not (= (axis-range) 1))
            (not (= (bit-and (g 11) (i64-shift-left 1 (+ kind 1))) 0))) 0
      (do (p (+ 1848 (* kind 2)) offset) (p (+ 1849 (* kind 2)) (g 3))
          (p (+ 1856 kind) (if (= (minimum) (- 1 (i64-shift-left 1 (- (g 3) 1)))) 1 0))
          (put 11 (bit-or (g 11) (i64-shift-left 1 (+ kind 1)))) 1))))
(defn axes [i flags] :i64
  (if (= i (g 4)) 1
    (if (or (not (= (bit-and flags 7) 6))
            (not (= (axis (usage i) (+ (g 10) (* i (g 3)))) 1))) 0 (axes (+ i 1) flags))))
(defn input [flags] :i64
  (if (not (= (g 1) (g 0))) 1
    (if (or (= (g 13) 0) (< (g 3) 1) (> (g 3) 32) (< (g 4) 1) (> (g 4) 64)
            (> (+ (g 10) (* (g 3) (g 4))) 64)) 0
      (let [width (* (g 3) (g 4))
            accepted (if (= (bit-and flags 1) 1)
                       (store64 1880 (bit-or (load64 1880 0 0) (i64-shift-left (mask width) (g 10))) 0)
                       (if (= (g 2) 9) (buttons flags) (axes 0 flags)))]
        (if (= accepted 1) (do (put 10 (+ (g 10) width)) 1) 0)))))
(defn main-item [tag v] :i64
  (let [ok (case tag
            8 (input v)
            10 (if (>= (g 12) 16) 0
                 (do (put 12 (+ (g 12) 1))
                     (if (and (= v 1) (= (g 2) 1) (= (usage 0) 2)) (put 13 (g 12)) 0) 1))
            12 (if (= (g 12) 0) 0
                 (do (if (= (g 13) (g 12)) (put 13 0) 0) (put 12 (- (g 12) 1)) 1)) 1)]
    (do (local-reset) ok)))
(defn items [at n fuel] :i64
  (if (= at n)
    (if (and (= (g 12) 0) (= (g 15) 0) (= (bit-and (g 11) 7) 7)
             (> (g 10) 0) (= (mod (g 10) 8) 0))
      (do (p 1845 (quot (g 10) 8)) 1) 0)
    (if (or (= fuel 0) (> at n)) 0
      (let [prefix (usb/ble-map at) len (case (bit-and prefix 3) 3 4 (bit-and prefix 3))
            typ (bit-and (quot prefix 4) 3) tag (quot prefix 16) next (+ at len 1)]
        (if (or (= prefix 254) (> next n)) 0
          (let [v (value (+ at 1) len 0 0)
                ok (case typ 0 (main-item tag v) 1 (global tag v len) 2 (local tag v) 0)]
            (if (= ok 1) (items next n (- fuel 1)) 0)))))))
(defn layout [id n] :i64
  (do (clear-state 0) (clear 1845 1860) (store64 1880 0 0) (put 0 id)
      (if (or (< id 0) (> id 255) (< n 1) (> n 1024)) 0
        (if (= (items 0 n 1024) 1) 1 (do (clear 1845 1860) 0)))))
(defn boot [] :i64
  (do (clear 1845 1860) (p 1845 3) (p 1846 0) (p 1847 3)
      (p 1848 8) (p 1849 8) (p 1850 16) (p 1851 8) (store64 1880 248 0) 1))
(defn extract [report offset n] :i64
  (if (= n 0) 0 (bit-and (u64-shift-right report offset) (mask n))))
(defn axis-value [report kind] :i64
  (let [offset (b (+ 1848 (* kind 2))) n (b (+ 1849 (* kind 2)))
        raw (extract report offset n)]
    (if (= n 0) 0 (if (>= raw (i64-shift-left 1 (- n 1))) (- raw (i64-shift-left 1 n)) raw))))
(defn axis-valid [report kind] :i64
  (let [n (b (+ 1849 (* kind 2)))]
    (if (= n 0) 1
      (if (and (= (b (+ 1856 kind)) 1) (= (axis-value report kind) (- 0 (i64-shift-left 1 (- n 1))))) 0 1))))
(defn valid [report n] :i64
  (if (and (> (b 1845) 0) (= n (b 1845)) (<= n 8) (= (bit-and report (load64 1880 0 0)) 0)
           (= (axis-valid report 0) 1) (= (axis-valid report 1) 1)
           (= (axis-valid report 2) 1) (= (axis-valid report 3) 1)) 1 0))
(defn field [i] :i64
  (if (= i 0) (extract (report) (b 1846) (b 1847))
    (if (and (>= i 1) (<= i 4)) (axis-value (report) (- i 1)) 0)))
(defn pending [] :i64 (b 1861))
(defn acknowledge [] :i64 (p 1861 0))
(defn quarantine [] :i64 (do (p 1861 0) (p 1862 1)))
(defn ingress [value n] :i64
  (if (not (= (valid value n) 1)) 0
    (if (= (b 1862) 1)
      (do (if (= (extract value (b 1846) (b 1847)) 0) (p 1862 0) 0) 0)
      (do (set-report (bit-and value (mask (* n 8)))) (p 1861 1) 1))))
(defn vector-16 [i] :i64 (case i 0 5 1 1 2 9 3 2 4 161 5 1 6 133 7 2 8 9 9 1 10 161 11 0 12 5 13 9 14 25 15 1 16 41 17 5 18 21 19 0 20 37 21 1 22 149 23 5 24 117 25 1 26 129 27 2 28 149 29 1 30 117 31 3 32 129 33 1 34 5 35 1 36 9 37 48 38 9 39 49 40 22 41 1 42 128 43 38 44 255 45 127 46 117 47 16 48 149 49 2 50 129 51 6 52 9 53 56 54 21 55 129 56 37 57 127 58 117 59 8 60 149 61 1 62 129 63 6 64 5 65 12 66 10 67 56 68 2 69 129 70 6 71 192 72 192 0))
(defn vector-12 [i] :i64 (case i 0 5 1 1 2 9 3 2 4 161 5 1 6 133 7 3 8 9 9 1 10 161 11 0 12 5 13 9 14 25 15 1 16 41 17 3 18 21 19 0 20 37 21 1 22 149 23 3 24 117 25 1 26 129 27 2 28 149 29 1 30 117 31 5 32 129 33 1 34 5 35 1 36 9 37 48 38 9 39 49 40 22 41 1 42 248 43 38 44 255 45 7 46 117 47 12 48 149 49 2 50 129 51 6 52 9 53 56 54 21 55 129 56 37 57 127 58 117 59 8 60 149 61 1 62 129 63 6 64 192 65 192 0))
(defn stage [kind i n] :i64
  (if (= i n) 1
    (do (usb/ble-map-put i (if (= kind 16) (vector-16 i) (vector-12 i))) (stage kind (+ i 1) n))))
(defn bit [ok :bool n :i64] :i64 (if ok n 0))
(defn self-check [] :i64
  (let [s16 (stage 16 0 73) a (layout 2 73)
        raw 0x01ff0104fed401 b (valid raw 7) stored (set-report raw)
        c (if (= (field 0) 1) 1 0) d (if (= (field 1) -300) 1 0)
        e (if (= (field 2) 260) 1 0) f (if (and (= (field 3) -1) (= (field 4) 1)) 1 0)
        g (- 1 (valid raw 6)) h (- 1 (valid (bit-or raw 32) 7))
        j (- 1 (valid 0x01ff0104800001 7)) k (- 1 (layout 1 73))
        l (- 1 (layout 2 72)) mutated (usb/ble-map-put 51 2) m (- 1 (layout 2 73))
        s12 (stage 12 0 66) n (layout 3 66) stored12 (set-report 0x0212cfe701)
        o (if (and (= (valid (report) 5) 1) (= (field 1) -25) (= (field 2) 300) (= (field 3) 2)) 1 0)
        q (do (quarantine)
              (if (= (ingress 0x0212cfe701 5) 0)
                (if (= (ingress 0 5) 0)
                  (if (and (= (ingress 0x0212cfe701 5) 1) (= (pending) 1)) 1 0) 0) 0))
        sb (boot) storedboot (set-report 0x02ff01)
        z (if (and (= (valid (report) 3) 1) (= (field 1) -1) (= (field 2) 2)
                   (= (valid 0x02ff09 3) 0) (= (valid 0x02ff01 4) 0)) 1 0)]
    (+ (bit (= a 1) 1) (bit (= b 1) 2) (bit (= c 1) 4) (bit (= d 1) 8)
       (bit (= e 1) 16) (bit (= f 1) 32) (bit (= g 1) 64) (bit (= h 1) 128)
       (bit (= j 1) 256) (bit (= k 1) 512) (bit (= l 1) 1024) (bit (= m 1) 2048)
       (bit (= n 1) 4096) (bit (= o 1) 8192) (bit (= q 1) 16384) (bit (= z 1) 32768))))
