(ns aiueos.native.draft-store
  (:require [aiueos.sha256 :as sha])
  (:export [restore commit commit-result store-key load-key erase-key main]))

;; Local diagnostic transport, NOT the D2 image codec or signed head authority.
;; Only the explicitly provisioned 64KiB primary-slave ATA medium is writable.
;; The boot medium (primary master) is never selected. No automatic formatting.
;; Sector0 is an immutable opt-in marker; sector1 publishes a verified slot.
;; Slots2/3 alternate. Write slot -> FLUSH -> readback -> publish head -> FLUSH.
;; A crash before head publication retains the last committed slot. A corrupt
;; published head/slot refuses rather than silently selecting an older slot.
;; Slot v1 stores only Goal. Slot v2 also stores one explicitly diagnostic
;; local-model token, bound to its Goal and prior generation. No key, grant,
;; lease, device handle or app authority is serialized here.
;; Scratch is confined to browser-context bytes512..2559. Renderer/input
;; words0..84 end at340. DMA slots and the CPU RX snapshot are never borrowed.

(defn word [page offset]
  (kernel-load-u32-4k page 512 offset))
(defn put [page offset value]
  (kernel-store-u32-4k page 512 offset value))
(defn zero [page offset]
  (if (>= offset 512) 1
    (do (put page offset 0) (zero page (+ offset 4)))))
(defn zeroed [page offset]
  (if (>= offset 512) 1
    (if (= (word page offset) 0) (zeroed page (+ offset 4)) 0)))
(defn reserved-zero [page offset end]
  (if (>= offset end) 1
    (if (= (word page offset) 0)
      (reserved-zero page (+ offset 4) end) 0)))

(defn ready [remaining data]
  (let [status (kernel-in-u8 503)]
    (if (or (= status 0) (= status 255)) -1
      (if (= remaining 0) -2
        (if (= (bit-and status 128) 128)
          (ready (- remaining 1) data)
          (if (> (bit-and status 33) 0) -3
            (if (or (= data 0) (= (bit-and status 8) 8)) 1
              (ready (- remaining 1) data))))))))

(defn select [sector command]
  (if (or (< sector 0) (> sector 4)) -4
    (do (kernel-out-u8 502 240)
        (kernel-in-u8 1014) (kernel-in-u8 1014)
        (kernel-in-u8 1014) (kernel-in-u8 1014)
        (if (= (ready 65536 0) 1)
          (do (kernel-out-u8 1014 2)
              (kernel-out-u8 498 1)
              (kernel-out-u8 499 sector)
              (kernel-out-u8 500 0)
              (kernel-out-u8 501 0)
              (kernel-out-u8 503 command)
              (ready 65536 1)) -5))))

(defn transfer-read [page offset]
  (if (>= offset 512) 1
    (do (put page offset (kernel-in-u32 496))
        (transfer-read page (+ offset 4)))))
(defn transfer-write [page offset]
  (if (>= offset 512) 1
    (do (kernel-out-u32 496 (word page offset))
        (transfer-write page (+ offset 4)))))
;; The provisioning marker alone is not device identity: a larger disk can
;; carry the same first sector. IDENTIFY DEVICE is read-only and must report
;; exactly the dedicated 128-sector scratch medium before any slot access.
;; Port 502 always selects the primary slave; the boot master is untouched.
(defn scratch-size [page]
  (if (= (select 0 236) 1)
    (if (= (transfer-read page 0) 1)
      (if (= (ready 65536 0) 1)
        (if (= (word page 120) 128) 1 -14)
        -15)
      -16)
    -17))
(defn read-sector [page sector]
  (if (= (select sector 32) 1)
    (if (= (transfer-read page 0) 1) (ready 65536 0) -6) -7))
(defn write-sector [page sector]
  (if (or (= sector 0) (> sector 3) (< sector 1)) -8
    (if (= (select sector 48) 1)
      (if (= (transfer-write page 0) 1)
        (if (= (ready 65536 0) 1)
          (do (kernel-out-u8 503 231) (ready 65536 0)) -9) -10) -11)))

(defn provisioned [page]
  (if (= (scratch-size page) 1)
    (if (= (read-sector page 0) 1)
      (if (and (= (word page 0) 0x49415741)
               (= (word page 4) 0x54465244)
               (= (word page 8) 1)
               (= (word page 12) 128)) 1 -12) -13)
    -18))

(defn copy [source dest offset length]
  (if (>= offset length) 1
    (do (kernel-store-u8-4k dest 512 offset
                          (kernel-load-u8-4k source 512 offset))
        (copy source dest (+ offset 1) length))))
(defn equal [a b offset length]
  (if (>= offset length) 1
    (if (= (kernel-load-u8-4k a 512 offset)
           (kernel-load-u8-4k b 512 offset))
      (equal a b (+ offset 1) length) 0)))

(defn hash-slot [page work]
  (sha/aiueos-sha256
   (kernel-subregion page 512 0 480) 480
   (kernel-subregion page 512 480 32)
   (kernel-subregion work 512 0 352) 352))
(defn verify-slot [page work]
  (let [expected (kernel-subregion (kernel-browser-context) 8192 2048 512)
        copied (copy page expected 0 512)]
    (if (and (= copied 1) (= (hash-slot page work) 1))
      (if (= (equal page expected 480 512) 1) 1 -14) -15)))

(defn diagnostic-token? [token]
  (or (= token 32) (and (>= token 97) (<= token 122))))
(defn result-record-valid [slot generation]
  (if (= (word slot 4) 1)
    (= (reserved-zero slot 16 32) 1)
    (and (= (word slot 4) 2)
         (= (word slot 16) 1)
         (diagnostic-token? (word slot 20))
         (= (word slot 24) (- generation 1))
         (= (word slot 28) 0))))

(defn load-head [head slot work]
  (if (= (provisioned head) 1)
    (if (= (read-sector head 1) 1)
      (if (= (word head 0) 0)
        (if (= (zeroed head 0) 1) 0 -16)
        (if (and (= (word head 0) 0x31484457)
                 (= (word head 4) 1)
                 (> (word head 8) 0)
                 (<= (word head 8) 4294967294)
                 (= (reserved-zero head 16 480) 1)
                 (= (word head 12) (+ 2 (mod (word head 8) 2))))
          (let [generation (word head 8)]
            (if (= (read-sector slot (word head 12)) 1)
              (if (= (verify-slot slot work) 1)
                (if (and (= (word slot 0) 0x31544457)
                         (result-record-valid slot generation)
                         (= (word slot 8) generation)
                         (= (equal head slot 480 512) 1)
                         (<= (word slot 12) 51)
                         (= (reserved-zero slot (+ 32 (* (word slot 12) 4)) 480) 1)
                         (= (valid-goal slot 0 (word slot 12)) 1)) generation -17) -18) -19)) -20)) -21) -22))

(defn valid-goal [slot index length]
  (if (>= index length) 1
    (let [cp (word slot (+ 32 (* index 4)))]
      (if (or (= cp 32) (and (>= cp 97) (<= cp 122)))
        (valid-goal slot (+ index 1) length) 0))))
(defn restore-goal [surface slot index length]
  (if (>= index length)
    (do (kernel-store-u32
         (kernel-subregion surface 8192 (* (+ 236 length) 4) 4) 4 0 0)
        (kernel-store-u32
         (kernel-subregion surface 8192 8152 4) 4 0 (+ 12 length)) 1)
    (do (kernel-store-u32
         (kernel-subregion surface 8192 (* (+ 236 index) 4) 4) 4 0
         (word slot (+ 32 (* index 4))))
        (restore-goal surface slot (+ index 1) length))))
(defn restore [surface]
  (let [head (kernel-subregion (kernel-browser-context) 8192 512 512)
        slot (kernel-subregion (kernel-browser-context) 8192 1024 512)
        work (kernel-subregion (kernel-browser-context) 8192 1536 512)
        generation (load-head head slot work)]
    (if (> generation 0)
      (if (= (valid-goal slot 0 (word slot 12)) 1)
        (do (restore-goal surface slot 0 (word slot 12))
            (kernel-store-u32
             (kernel-subregion (kernel-browser-context) 8192 356 4) 4 0
             (if (= (word slot 4) 2) (word slot 20) 0))
            generation) -23)
      generation)))

(defn capture-goal [surface slot index length]
  (if (>= index length) 1
    (do (put slot (+ 32 (* index 4))
             (kernel-load-u32
              (kernel-subregion surface 8192 (* (+ 236 index) 4) 4) 4 0))
        (capture-goal surface slot (+ index 1) length))))
(defn commit [surface expected-generation]
  (let [head (kernel-subregion (kernel-browser-context) 8192 512 512)
        slot (kernel-subregion (kernel-browser-context) 8192 1024 512)
        work (kernel-subregion (kernel-browser-context) 8192 1536 512)
        actual (load-head head slot work)
        length (- (kernel-load-u32
                   (kernel-subregion surface 8192 8152 4) 4 0) 12)]
    (if (or (< actual 0) (not (= actual expected-generation))) -24
      (if (or (< length 0) (> length 51) (>= actual 4294967294)) -25
        (let [generation (+ actual 1)
              sector (+ 2 (mod generation 2))]
          (do (zero slot 0)
              (put slot 0 0x31544457) (put slot 4 1)
              (put slot 8 generation) (put slot 12 length)
              (capture-goal surface slot 0 length)
              (if (= (valid-goal slot 0 length) 1)
                (if (= (hash-slot slot work) 1)
                  (if (= (write-sector slot sector) 1)
                    (do (copy slot work 0 512)
                        (if (= (read-sector slot sector) 1)
                          (if (= (equal slot work 0 512) 1)
                            (do (zero head 0)
                                (put head 0 0x31484457) (put head 4 1)
                                (put head 8 generation) (put head 12 sector)
                                (copy slot head 480 512)
                                (if (= (write-sector head 1) 1)
                                  (let [expected (kernel-subregion (kernel-browser-context) 8192 2048 512)]
                                    (do (copy head expected 0 512)
                                        (if (= (read-sector head 1) 1)
                                          (if (= (equal head expected 0 512) 1)
                                            generation -32) -33))) -26))
                            -27) -28)) -29) -30) -31)))))))

;; A diagnostic result is committed only for the already saved Goal. The
;; active v1 slot remains untouched until a new v2 slot and head read back.
;; A second result for the same Goal is refused even if a caller re-enters.
(defn matches-saved-goal [slot index length]
  (if (>= index length) 1
    (let [surface (kernel-browser-surface)
          shown (kernel-load-u32
                 (kernel-subregion surface 8192 (* (+ 236 index) 4) 4) 4 0)]
      (if (= shown (word slot (+ 32 (* index 4))))
        (matches-saved-goal slot (+ index 1) length) 0))))
(defn commit-result [expected-generation token]
  (let [head (kernel-subregion (kernel-browser-context) 8192 512 512)
        slot (kernel-subregion (kernel-browser-context) 8192 1024 512)
        work (kernel-subregion (kernel-browser-context) 8192 1536 512)
        actual (load-head head slot work)
        length (word slot 12)
        surface (kernel-browser-surface)
        shown-length (- (kernel-load-u32
                         (kernel-subregion surface 8192 8152 4) 4 0) 12)]
    (if (or (<= actual 0) (not (= actual expected-generation))
            (not (= (word slot 4) 1)) (not (diagnostic-token? token))
            (not (= shown-length length))
            (not (= (matches-saved-goal slot 0 length) 1))
            (>= actual 4294967294)) -34
      (let [generation (+ actual 1)
            sector (+ 2 (mod generation 2))]
        (do (copy slot work 0 512)
            (zero slot 0)
            (put slot 0 0x31544457) (put slot 4 2)
            (put slot 8 generation) (put slot 12 length)
            (put slot 16 1) (put slot 20 token)
            (put slot 24 actual)
            (copy work slot 32 (+ 32 (* length 4)))
            (if (= (hash-slot slot work) 1)
              (if (= (write-sector slot sector) 1)
                (do (copy slot work 0 512)
                    (if (= (read-sector slot sector) 1)
                      (if (= (equal slot work 0 512) 1)
                        (do (zero head 0)
                            (put head 0 0x31484457) (put head 4 1)
                            (put head 8 generation) (put head 12 sector)
                            (copy slot head 480 512)
                            (if (= (write-sector head 1) 1)
                              (let [expected (kernel-subregion
                                              (kernel-browser-context) 8192
                                              2048 512)]
                                (do (copy head expected 0 512)
                                    (if (= (read-sector head 1) 1)
                                      (if (= (equal head expected 0 512) 1)
                                        generation -32) -33))) -26))
                        -27) -28)) -29) -30))))))
;; ADR-0277 W3f: the sealed device-key blob has a sector of its own (4), outside the draft slots 2/3 and
;; the head 1. Record: word 0 "KSL1" (0x314c534b), word 1 version 1, word 2 length 64, bytes 16..79 the blob
;; of aiueos.keyseal (salt16 || ct32 || tag16), word 3 (bytes 12..15) the count of unlock/forget attempts made with a
;; wrong or unfinished passphrase since the last success (written before the KDF runs, cleared on success), every
;; other byte zero. Only the sealed blob is stored, never a
;; seed or a passphrase. Write -> FLUSH -> read back and compare before it counts as stored. The same
;; provisioning and IDENTIFY rules apply as for the draft slots. Scratch: browser-context bytes 1536..2559 (not the public key scratch at 1280).
(defn pack-key-page [page ctx i]
  (if (>= i 64) 1
    (do (kernel-store-u8-4k page 512 (+ 16 i)
                            (kernel-load-u8 (kernel-subregion ctx 8192 (+ 3392 i) 1) 1 0))
        (pack-key-page page ctx (+ i 1)))))
(defn unpack-key-page [page ctx i]
  (if (>= i 64) 1
    (do (kernel-store-u8 (kernel-subregion ctx 8192 (+ 3392 i) 1) 1 0
                         (kernel-load-u8-4k page 512 (+ 16 i)))
        (unpack-key-page page ctx (+ i 1)))))
(defn write-key-sector [page]
  (if (= (select 4 48) 1)
    (if (= (transfer-write page 0) 1)
      (if (= (ready 65536 0) 1)
        (do (kernel-out-u8 503 231) (ready 65536 0)) -9) -10) -11))

;; 1 when the blob at ctx 3392..3455 was written and read back identical; negative otherwise (-40: no
;; provisioned scratch medium, the key then stays in RAM only).
(defn store-key []
  (let [ctx (kernel-browser-context)
        page (kernel-subregion ctx 8192 1536 512)
        check (kernel-subregion ctx 8192 2048 512)]
    (if (= (provisioned page) 1)
      (do (zero page 0)
          (put page 0 0x314c534b) (put page 4 1) (put page 8 64)
          (put page 12 (kernel-load-u32 (kernel-subregion ctx 8192 400 4) 4 0))
          (pack-key-page page ctx 0)
          (copy page check 0 512)
          (if (= (write-key-sector page) 1)
            (if (= (read-sector page 4) 1)
              (if (= (equal page check 0 512) 1) 1 -41) -42) -43))
      -40)))

;; 1 when a valid key record was read into ctx 3392..3455; 0 when the slot is empty or malformed (nothing
;; copied); negative when there is no provisioned medium.
(defn load-key []
  (let [ctx (kernel-browser-context)
        page (kernel-subregion ctx 8192 1536 512)]
    (if (= (provisioned page) 1)
      (if (= (read-sector page 4) 1)
        (if (and (= (word page 0) 0x314c534b) (= (word page 4) 1) (= (word page 8) 64)
                 (= (reserved-zero page 80 512) 1))
          (do (unpack-key-page page ctx 0)
              (kernel-store-u32 (kernel-subregion ctx 8192 400 4) 4 0 (word page 12))
              1) 0)
        -44)
      -40)))

;; ADR-0278 step 2: Forget. Overwrite the key sector with zeros, read it back and compare: 1 when sector 4 reads
;; back all zero, negative otherwise (-40: no provisioned medium). Only the sealed blob record is erased.
(defn erase-key []
  (let [ctx (kernel-browser-context)
        page (kernel-subregion ctx 8192 1536 512)
        check (kernel-subregion ctx 8192 2048 512)]
    (if (= (provisioned page) 1)
      (do (zero page 0) (zero check 0)
          (if (= (write-key-sector page) 1)
            (if (= (read-sector page 4) 1)
              (if (= (equal page check 0 512) 1) 1 -45) -46) -47))
      -40)))

(defn main [] :i64 0)
