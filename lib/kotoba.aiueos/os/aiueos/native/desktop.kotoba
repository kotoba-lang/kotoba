(ns aiueos.native.desktop
  (:require [aiueos.browser-frame2 :as browser-frame]
            [aiueos.session.app-catalog :as app-catalog]
            [aiueos.native.draft-store :as draft-store]
            [aiueos.ed25519 :as ed]
            [aiueos.keyseal :as ks])
  (:export [main workspace-main goal-main goal-draft-main goal-model-main
            show-diagnostic-result]))

;; Guest-specific desktop adapter. The hosted AIUEOS session uses the actual
;; browser.surface + cssom.layout pipeline; this module currently consumes the
;; separate aiueos.browser-frame2 behavior mirror because the Amu selfhost
;; module graph cannot yet link Browser's cssom.layout dependency. It supplies
;; the framebuffer raster pass and input loop in Kotoba.

(defn load64-boot [boot offset]
  (+ (kernel-load-u8 boot 160 offset)
     (* (kernel-load-u8 boot 160 (+ offset 1)) 256)
     (* (kernel-load-u8 boot 160 (+ offset 2)) 65536)
     (* (kernel-load-u8 boot 160 (+ offset 3)) 16777216)
     (* (kernel-load-u8 boot 160 (+ offset 4)) 4294967296)
     (* (kernel-load-u8 boot 160 (+ offset 5)) 1099511627776)
     (* (kernel-load-u8 boot 160 (+ offset 6)) 281474976710656)
     (* (kernel-load-u8 boot 160 (+ offset 7)) 72057594037927936)))

(defn load32-boot [boot offset]
  (+ (kernel-load-u8 boot 160 offset)
     (* (kernel-load-u8 boot 160 (+ offset 1)) 256)
     (* (kernel-load-u8 boot 160 (+ offset 2)) 65536)
     (* (kernel-load-u8 boot 160 (+ offset 3)) 16777216)))

(defn word [region i]
  (kernel-load-u32 (kernel-subregion region 8192 (* i 4) 4) 4 0))

(defn put-word [region i value]
  (kernel-store-u32 (kernel-subregion region 8192 (* i 4) 4) 4 0 value))

(defn clear-surface [s index]
  (if (>= index 2048)
    0
    (do (put-word s index 0)
        (clear-surface s (+ index 1)))))

(defn font-u16 [font font-bytes offset]
  (let [chunk-offset (* (quot offset 16384) 16384)
        chunk-length 16384]
    (kernel-load-u16-16k
     (kernel-subregion font 524288 chunk-offset chunk-length)
     chunk-length (- offset chunk-offset))))

(defn framebuffer-pixel [fb fb-bytes offset ctx]
  (let [page (kernel-framebuffer-page (quot offset 4096))]
    (kernel-store-u32-4k page 4096 (mod offset 4096) (word ctx 6))))

(defn gop-color [ctx rgb]
  ;; GOP format 0 stores R,G,B bytes; frame2 colours are 0xRRGGBB. Format 1
  ;; stores B,G,R and uses that word directly on little-endian x86.
  (if (= (word ctx 43) 0)
    (+ (bit-and (quot rgb 65536) 255)
       (* (bit-and (quot rgb 256) 255) 256)
       (* (bit-and rgb 255) 65536))
    rgb))

(defn glyph-mask-start [width]
  ;; The font stores 8-pixel glyph rows in the low byte and 16-pixel rows
  ;; across the whole word. Start at the matching most-significant glyph bit.
  (if (= width 8) 128 32768))

;; Work words in the renderer context:
;;   0..9 rectangle cursor/bounds, 10..11 glyph row and mask
;;   30 current op, 31 op count, 32..37 saved op, 40..45 GOP metadata
(defn fill-row [s fb fb-bytes ctx offset]
  (if (>= offset (word ctx 8))
    0
    (do (framebuffer-pixel fb fb-bytes offset ctx)
        (fill-row s fb fb-bytes ctx (+ offset 4)))))

(defn fill-rect [s fb fb-bytes ctx row]
  (if (>= row (word ctx 9))
    0
    (do (put-word ctx 0 row)
        (put-word ctx 8
                  (* (+ (* row (word ctx 42))
                        (word ctx 2) (word ctx 4)) 4))
        (fill-row s fb fb-bytes ctx
                  (* (+ (* row (word ctx 42)) (word ctx 2)) 4))
        (fill-rect s fb fb-bytes ctx (+ row 1)))))

(defn paint-glyph-pixels [s font fb fb-bytes ctx]
  (if (>= (word ctx 4) 16)
    0
    (do (if (= (word ctx 5) 0)
          (do (put-word ctx 10
                        (font-u16 font (word ctx 45)
                                  (+ (word ctx 38) (* (word ctx 4) 2))))
              (put-word ctx 11 (glyph-mask-start (word ctx 34))))
          0)
        (if (= (bit-and (quot (word ctx 10) (word ctx 11)) 1) 1)
          (framebuffer-pixel
           fb fb-bytes
           (* (+ (* (+ (word ctx 33) (word ctx 4)) (word ctx 42))
                 (word ctx 32) (word ctx 5)) 4)
           ctx)
          0)
        (if (>= (+ (word ctx 5) 1) (word ctx 34))
          (do (put-word ctx 4 (+ (word ctx 4) 1))
              (put-word ctx 5 0)
              (paint-glyph-pixels s font fb fb-bytes ctx))
          (do (put-word ctx 5 (+ (word ctx 5) 1))
              (put-word ctx 11 (quot (word ctx 11) 2))
              (paint-glyph-pixels s font fb fb-bytes ctx))))))

(defn present-ops [s font fb fb-bytes ctx]
  (if (>= (word ctx 30) (word ctx 31))
    0
    (let [slot (+ 480 (* 6 (word ctx 30)))
          kind (word s slot)
          x (word s (+ slot 1))
          y (word s (+ slot 2))
          a (word s (+ slot 3))
          b (word s (+ slot 4))
          rgb (word s (+ slot 5))]
      (do (put-word ctx 32 x)
          (put-word ctx 33 y)
          (put-word ctx 34 a)
          (put-word ctx 35 b)
          (put-word ctx 36 (gop-color ctx rgb))
          (if (= kind 1)
            (do (put-word ctx 2 x)
                (put-word ctx 3 y)
                (put-word ctx 4 a)
                (put-word ctx 5 b)
                (put-word ctx 6 (word ctx 36))
                (put-word ctx 9 (+ y b))
                (fill-rect s fb fb-bytes ctx y))
            (do (put-word ctx 32 x)
                (put-word ctx 33 y)
                (put-word ctx 34 b)
                (put-word ctx 38 (+ 16 (* 4 (word s 424)) (* 32 a)))
                (put-word ctx 4 0)
                (put-word ctx 5 0)
                (put-word ctx 6 (word ctx 36))
                (put-word ctx 11 (glyph-mask-start (word ctx 34)))
                (paint-glyph-pixels s font fb fb-bytes ctx)))
          (put-word ctx 30 (+ (word ctx 30) 1))
          (present-ops s font fb fb-bytes ctx)))))

(defn present-frame [s font fb fb-bytes ctx]
  (put-word ctx 78 (+ (word ctx 78) 1))
  (put-word ctx 30 0)
  (put-word ctx 31
            (browser-frame/aiueos-browser-frame2
             s 8192 font (word ctx 45)))
  (let [result (if (< (word ctx 31) 0) 0 (present-ops s font fb fb-bytes ctx))]
    (do (put-word ctx 79 (+ (word ctx 79) 1)) result)))

(defn seed-app-label [s id index]
  (let [slot (+ 32 (* 32 (- id 1)))
        label-length (app-catalog/app-title-length id)]
    (if (>= index label-length)
      (put-word s (+ slot index) 0)
      (do (put-word s (+ slot index)
                    (app-catalog/app-title-codepoint id index))
          (seed-app-label s id (+ index 1))))))

(defn seed-app-labels [s id]
  (if (> id (app-catalog/app-count))
    0
    (do (seed-app-label s id 0)
        (seed-app-labels s (+ id 1)))))

;; The local bigram call is diagnostic. Make its single-byte result visible
;; without presenting it as a completed agent turn or reusing an approval.
(defn diagnostic-title [s token]
  (do (seed-app-label s 2 0)
      (put-word s 71 32) (put-word s 72 100)
      (put-word s 73 101) (put-word s 74 109)
      (put-word s 75 111) (put-word s 76 32)
      (put-word s 77 token) (put-word s 78 0)
      1))
(defn show-diagnostic-result [token]
  (if (not (or (= token 32) (and (>= token 97) (<= token 122)))) 0
    (let [surface (kernel-browser-surface)
          context (kernel-browser-context)
          stride (kernel-framebuffer-stride)
          height (kernel-framebuffer-height)]
      (do (diagnostic-title surface token)
          (present-frame surface (kernel-native-font) 0
                         (* (* stride height) 4) context)))))

(defn seed-app-body [s id index]
  (let [slot (+ 160 (* 64 (- id 1)))
        body-length (app-catalog/app-body-length id)]
    (if (>= index body-length)
      (put-word s (+ slot index) 0)
      (do (put-word s (+ slot index)
                    (app-catalog/app-body-codepoint id index))
          (seed-app-body s id (+ index 1))))))

(defn seed-app-bodies [s id]
  (if (> id (app-catalog/app-count))
    0
    (do (seed-app-body s id 0)
        (seed-app-bodies s (+ id 1)))))

(defn seed-desktop [s width height]
  (do (put-word s 0 1)
      (put-word s 1 0)
      (put-word s 2 0)
      (put-word s 3 width)
      (put-word s 4 height)
      (put-word s 31 15)
      (seed-app-labels s 1)
      (seed-app-bodies s 1)
      (put-word s 2038 (app-catalog/app-body-length 2))
      (put-word s 2046 41)
      (put-word s 2047 40)))

(defn window-open? [s id index]
  (if (>= index (word s 1))
    0
    (if (= (word s (+ 5 (* index 5))) id)
      1
      (window-open? s id (+ index 1)))))

(defn window-index [s id index]
  (if (>= index (word s 1))
    -1
    (if (= (word s (+ 5 (* index 5))) id)
      index
      (window-index s id (+ index 1)))))

;; Height bit 16 hides an existing window without discarding its geometry or
;; body. No new surface word, approval state or app instance is allocated.
(defn last-visible-id [s index]
  (if (< index 0) 0
    (let [slot (+ 5 (* index 5))]
      (if (< (word s (+ slot 4)) 65536) (word s slot)
        (last-visible-id s (- index 1))))))

(defn first-visible-index [s index]
  (if (>= index (word s 1)) -1
    (if (< (word s (+ 9 (* index 5))) 65536) index
      (first-visible-index s (+ index 1)))))

(defn minimize-focused [s]
  (let [index (window-index s (word s 2) 0)]
    (if (< index 0) 0
      (let [slot (+ 9 (* index 5))
            height (word s slot)]
        (if (>= height 65536) 0
          (do (put-word s slot (+ height 65536))
              (put-word s 2 (last-visible-id s (- (word s 1) 1)))
              1))))))

(defn shift-window-left [s current end]
  (if (>= current end)
    0
    (let [slot (+ 5 (* current 5))
          next (+ slot 5)]
      (do (put-word s slot (word s next))
          (put-word s (+ slot 1) (word s (+ next 1)))
          (put-word s (+ slot 2) (word s (+ next 2)))
          (put-word s (+ slot 3) (word s (+ next 3)))
          (put-word s (+ slot 4) (word s (+ next 4)))
          (shift-window-left s (+ current 1) end)))))

(defn focus-window [s index]
  (if (< index 0)
    0
    (let [count (word s 1)
          slot (+ 5 (* index 5))
          id (word s slot)
          x (word s (+ slot 1))
          y (word s (+ slot 2))
          width (word s (+ slot 3))
          height (word s (+ slot 4))
          last-index (- count 1)
          last-slot (+ 5 (* last-index 5))]
      (do (put-word s 2 id)
          (put-word s (+ slot 4) (mod height 65536))
          (if (< index last-index)
            (do (shift-window-left s index last-index)
                (put-word s last-slot id)
                (put-word s (+ last-slot 1) x)
                (put-word s (+ last-slot 2) y)
                (put-word s (+ last-slot 3) width)
                (put-word s (+ last-slot 4) (mod height 65536)))
            0)
          1))))

(defn remove-window-at [s index current count id]
  (if (>= (+ current 1) count)
    (let [new-count (- count 1)
          fallback (if (= new-count 0)
                     0
                     (last-visible-id s (- new-count 1)))]
      (do (put-word s 1 new-count)
          (if (= (word s 2) id)
            (put-word s 2 fallback)
            0)
          (put-word s (+ 5 (* current 5)) 0)
          (put-word s (+ 6 (* current 5)) 0)
          (put-word s (+ 7 (* current 5)) 0)
          (put-word s (+ 8 (* current 5)) 0)
          (put-word s (+ 9 (* current 5)) 0)
          1))
    (let [slot (+ 5 (* current 5))
          next (+ slot 5)]
      (do (put-word s slot (word s next))
          (put-word s (+ slot 1) (word s (+ next 1)))
          (put-word s (+ slot 2) (word s (+ next 2)))
          (put-word s (+ slot 3) (word s (+ next 3)))
          (put-word s (+ slot 4) (word s (+ next 4)))
          (remove-window-at s index (+ current 1) count id)))))

(defn close-app [s id]
  (let [index (window-index s id 0)]
    (if (< index 0)
      0
      (remove-window-at s index index (word s 1) id))))

(defn cycle-window [s]
  ;; The focused window is at the top of the stack. Tab cycles only through
  ;; visible windows; a launcher key or dock click explicitly restores one.
  (focus-window s (first-visible-index s 0)))

(defn launch-app [s id width height]
  (if (= (window-open? s id 0) 1)
    (focus-window s (window-index s id 0))
    (if (>= (word s 1) 4)
      0
      (let [index (word s 1)
            slot (+ 5 (* index 5))
            window-width (if (> width 896) 880 (- width 16))
            window-height (if (> height 600) 560 (- height 72))
            room-x (- width window-width)
            room-y (- height window-height)
            cascade-x (if (> room-x 60) 18 (quot room-x 4))
            cascade-y (if (> (- room-y 46) 54) 18 (quot (- room-y 46) 4))
            base-x (quot (- room-x (* 3 cascade-x)) 2)
            base-y (if (> height 620) 44 36)
            x (+ base-x (* index cascade-x))
            y (+ base-y (* index cascade-y))]
        (do (put-word s 1 (+ index 1))
            (put-word s 2 id)
            (put-word s slot id)
            (put-word s (+ slot 1) x)
            (put-word s (+ slot 2) y)
            (put-word s (+ slot 3) window-width)
            (put-word s (+ slot 4) window-height))))))

(defn goal-codepoint [code]
  ;; PS/2 set-1 make codes. The native goal draft accepts lowercase ASCII and
  ;; spaces only; no host text service, model call, or implicit network access.
  (case code
    16 113 17 119 18 101 19 114 20 116 21 121 22 117 23 105 24 111 25 112
    30 97 31 115 32 100 33 102 34 103 35 104 36 106 37 107 38 108
    44 122 45 120 46 99 47 118 48 98 49 110 50 109 57 32 0))

(defn edit-itonami-goal [s code]
  (let [length (word s 2038)
        slot (+ 224 length)
        cp (goal-codepoint code)]
    (if (= code 14)
      (if (> length 12)
        (do (put-word s (- slot 1) 0)
            (put-word s 2038 (- length 1))
            1)
        0)
      (if (and (> cp 0) (< length 63))
        (do (put-word s slot cp)
            (put-word s (+ slot 1) 0)
            (put-word s 2038 (+ length 1))
            1)
        0))))

;; This title is owned by the native host. It identifies the local operation
;; and the Goal data being read while the user makes a fresh Y/N choice. It is
;; not a reusable capability and never enters the draft store.
(defn model-confirm-title [s index]
  (let [cp (case index
             0 65 1 73 2 85 3 69 4 79 5 83 6 32 7 108 8 111 9 99
             10 97 11 108 12 32 13 109 14 111 15 100 16 101 17 108
             18 32 19 71 20 111 21 97 22 108 23 63 24 32 25 121
             26 47 27 110 0)]
    (do (put-word s (+ 64 index) cp)
        (if (< index 28) (model-confirm-title s (+ index 1)) 1))))


;; ADR-0277 W3: the device key. F8 opens a consent request of its own kind (word 2039 bit 1);
;; only Allow (Y or the button) draws a 32-byte seed with kernel-rdrand (guarded by CPUID, and a draw
;; of 0 means no entropy: the request fails closed and no key exists), derives the Ed25519 public key
;; and signs a fixed proof message with it. The seed stays in guest RAM (context bytes 3712..3743, outside the draft store's scratch 512..2559): it is
;; never displayed, never persisted and never leaves the device. The home then shows the first three
;; public-key bytes. ctx bytes: seed 3712, hash scratch 1088, public key 1280 (128-byte scratch),
;; signing buffer 2048 (1024), proof message at buffer+256, signature 3072 (64), workspace 4096 (4096).
;; One-byte subregions on purpose: the plain kernel-load-u8/kernel-store-u8 tier traps with #UD at run
;; time when its size operand is above 512, and the compiler does not check that (JUN-483). Do not pass
;; the whole 8192-byte context as the region of a plain-tier access.
(defn ctx-byte [ctx at] (kernel-load-u8 (kernel-subregion ctx 8192 at 1) 1 0))
(defn put-ctx8 [ctx at v]
  (let [stored (kernel-store-u8 (kernel-subregion ctx 8192 at 1) 1 0 v)]
    (+ 1 (* 0 stored))))

(defn store-draw [ctx at v i]
  (if (= i 8) 1
    (let [stored (put-ctx8 ctx (+ at i) (bit-and (u64-shift-right v (* 8 i)) 255))]
      (store-draw ctx at v (+ i 1 (* 0 stored))))))

;; 1 when four non-zero 64-bit draws were stored at ctx 3712..3743, else 0 (nothing stored on failure)
(defn draw-seed [ctx flags]
  (if (= (bit-and flags 1) 0) 0
    (let [d0 (kernel-rdrand) d1 (kernel-rdrand) d2 (kernel-rdrand) d3 (kernel-rdrand)]
      (if (or (= d0 0) (or (= d1 0) (or (= d2 0) (= d3 0)))) 0
        (let [a (store-draw ctx 3712 d0 0) b (store-draw ctx 3720 d1 0)
              c (store-draw ctx 3728 d2 0) d (store-draw ctx 3736 d3 0)]
          (+ 1 (* 0 (+ a (+ b (+ c d))))))))))

(defn proof-byte [i]
  (case i 0 105 1 116 2 111 3 110 4 97 5 109 6 105 7 45 8 119 9 51 10 45 11 107 12 101 13 121 14 45 15 112 16 114 17 111 18 111 19 102 0))

(defn copy-seed-and-proof [ctx i]
  (if (= i 32) 1
    (let [a (put-ctx8 ctx (+ 2048 i) (ctx-byte ctx (+ 3712 i)))
          b (put-ctx8 ctx (+ 2304 i) (proof-byte i))]
      (copy-seed-and-proof ctx (+ i 1 (* 0 (+ a b)))))))

(defn derive-and-sign [ctx]
  (let [pk (ed/aiueos-ed25519-pubkey (kernel-subregion ctx 8192 3712 32)
                                     (kernel-subregion ctx 8192 1280 128)
                                     (kernel-subregion ctx 8192 4096 4096)
                                     (kernel-subregion ctx 8192 1088 64))
        cp (copy-seed-and-proof ctx 0)
        sg (ed/aiueos-ed25519-sign (kernel-subregion ctx 8192 2048 1024) 20
                                   (kernel-subregion ctx 8192 3072 64)
                                   (kernel-subregion ctx 8192 4096 4096))]
    (+ 1 (* 0 (+ pk (+ cp sg))))))

;; Allow on the key request opens the passphrase request (ctx word 87 = 4; word 2039 bits 0, 1 and 31 with
;; bit 6 clear, the typed length in bits 7..11); no entropy is drawn and no key exists until the passphrase is
;; confirmed. Returns 1.
(defn allow-key [s ctx]
  (do (put-word ctx 87 4) (put-word ctx 95 0) (put-word s 2039 (+ (word s 2039) 2147483648)) 1))

(defn deny-key [s ctx]
  (do (put-word ctx 87 0) (put-word s 2039 (- (word s 2039) 3)) (put-word ctx 94 3) 1))

;; F8 with no key: a sealed key on the scratch disk (ctx word 96 = 1, word 2039 bit 7 = "locked") opens the unlock
;; request (the passphrase panel with bit 13 set, ctx word 98 = 1); otherwise the key request.
(defn open-key-request [s ctx]
  (if (and (= (word ctx 87) 0) (= (bit-and (quot (word s 2039) 64) 1) 0))
    (if (= (word ctx 96) 1)
      (do (put-word ctx 87 4) (put-word ctx 95 0) (put-word ctx 98 1)
          (put-word s 2039 (+ (word s 2039) (+ 2147483651 8192))) 1)
      (do (put-word ctx 87 2) (put-word s 2039 (+ (word s 2039) 3)) 1))
    0))


;; ADR-0277 W3, consent-bound signing: F7 opens a consent request of the sign kind (word 2039 bits 0, 1 and
;; 31; ctx word 87 = 3) once a device key exists. Only Allow signs a fixed 20-byte test challenge with the
;; key's seed (ctx 3712), the signature lands at ctx 3200 (64 bytes) and ctx word 94 becomes 4; Deny closes the
;; request, signs nothing and leaves 3200..3263 zero (ctx word 94 = 5). No app asks for a signature yet: the
;; trigger is the key and the challenge is a constant.
(defn challenge-byte [i]
  (case i 0 105 1 116 2 111 3 110 4 97 5 109 6 105 7 45 8 119 9 51 10 45 11 115 12 105 13 103 14 110 15 45 16 116 17 101 18 115 19 116 0))

(defn copy-seed-and-challenge [ctx i]
  (if (= i 32) 1
    (let [a (put-ctx8 ctx (+ 2048 i) (ctx-byte ctx (+ 3712 i)))
          b (put-ctx8 ctx (+ 2304 i) (challenge-byte i))]
      (copy-seed-and-challenge ctx (+ i 1 (* 0 (+ a b)))))))

(defn sign-challenge [ctx]
  (let [cp (copy-seed-and-challenge ctx 0)
        sg (ed/aiueos-ed25519-sign (kernel-subregion ctx 8192 2048 1024) 20
                                   (kernel-subregion ctx 8192 3200 64)
                                   (kernel-subregion ctx 8192 4096 4096))]
    (+ 1 (* 0 (+ cp sg)))))

(defn sign-count-step [s]
  (if (< (bit-and (quot (word s 2039) 4) 15) 15) 4 0))

(defn allow-sign [s ctx]
  (let [d (sign-challenge ctx)]
    (do (put-word ctx 87 0)
        (put-word s 2039 (+ (- (word s 2039) 2147483651) (sign-count-step s)))
        (put-word ctx 94 4)
        (+ 1 (* 0 d)))))

(defn deny-sign [s ctx]
  (do (put-word ctx 87 0) (put-word s 2039 (- (word s 2039) 2147483651)) (put-word ctx 94 5) 1))

(defn open-sign-request [s ctx]
  (if (and (= (word ctx 87) 0) (= (bit-and (quot (word s 2039) 64) 1) 1))
    (do (put-word ctx 87 3) (put-word s 2039 (+ (word s 2039) 2147483651)) 1)
    0))

;; ADR-0277 W3f: the passphrase request. Keys a-z and space (the goal alphabet) append up to 24 characters
;; (shown as stars), Backspace removes one, Enter confirms from 4 characters, Esc or the Cancel button cancels
;; and wipes the buffer; every other key is swallowed. Confirm draws the seed (rdrand; 0 fails closed), draws a
;; 16-byte salt, derives the public key and the proof signature as before, and seals the seed under the
;; passphrase with aiueos.keyseal into the 64-byte blob at ctx 3392 (words 848..863), RAM only for now. The
;; passphrase buffer (ctx 3328..3359) is wiped on every exit. ctx word 95 holds the typed length.
(defn wipe-pass [ctx i]
  (if (>= i 32) 0
    (let [x (put-ctx8 ctx (+ 3328 i) 0)]
      (wipe-pass ctx (+ i (+ 1 (* 0 x)))))))

(defn set-pass-flags [s old new]
  (put-word s 2039 (+ (- (word s 2039) (* old 256)) (* new 256))))

(defn pass-type [s ctx cp]
  (let [n (word ctx 95)]
    (if (>= n 24) 1
      (let [x (put-ctx8 ctx (+ 3328 n) cp)]
        (do (set-pass-flags s n (+ n 1)) (put-word ctx 95 (+ n 1)) (+ 1 (* 0 x)))))))

(defn pass-back [s ctx]
  (let [n (word ctx 95)]
    (if (<= n 0) 1
      (let [x (put-ctx8 ctx (+ 3328 (- n 1)) 0)]
        (do (set-pass-flags s n (- n 1)) (put-word ctx 95 (- n 1)) (+ 1 (* 0 x)))))))

(defn pass-close [s ctx extra code]
  (let [n (word ctx 95)
        w (wipe-pass ctx 0)]
    (do (put-word s 2039 (+ (- (word s 2039) (+ (+ 2147483651 (* n 256)) (if (= (word ctx 98) 1) 8192 0))) extra))
        (put-word ctx 87 0) (put-word ctx 95 0) (put-word ctx 98 0) (put-word ctx 94 code)
        (+ 1 (* 0 w)))))

(defn pass-cancel [s ctx] (pass-close s ctx 0 6))

(defn draw-salt [ctx]
  (let [d0 (kernel-rdrand) d1 (kernel-rdrand)]
    (if (or (= d0 0) (= d1 0)) 0
      (let [a (store-draw ctx 3360 d0 0) b (store-draw ctx 3368 d1 0)]
        (+ 1 (* 0 (+ a b)))))))

(defn copy-salt-blob [ctx i]
  (if (>= i 16) 0
    (let [x (put-ctx8 ctx (+ 3392 i) (ctx-byte ctx (+ 3360 i)))]
      (copy-salt-blob ctx (+ i (+ 1 (* 0 x)))))))

(defn kdf-rounds [ctx salt-off k-off msg-off n]
  (if (<= n 0) 1
    (let [r (ks/aiueos-keyseal-round (kernel-subregion ctx 8192 salt-off 16) (kernel-subregion ctx 8192 k-off 64)
                                     (kernel-subregion ctx 8192 msg-off 128) (kernel-subregion ctx 8192 4096 4096))]
      (kdf-rounds ctx salt-off k-off msg-off (- n (+ 1 (* 0 r)))))))

;; K into ctx[k-off .. k-off+64) from the 32-byte padded passphrase at pass-off and the salt at salt-off
(defn kdf-run [ctx pass-off salt-off k-off msg-off iters]
  (let [f (ks/aiueos-keyseal-first (kernel-subregion ctx 8192 pass-off 32) (kernel-subregion ctx 8192 salt-off 16)
                                   (kernel-subregion ctx 8192 k-off 64) (kernel-subregion ctx 8192 msg-off 128)
                                   (kernel-subregion ctx 8192 4096 4096))
        r (kdf-rounds ctx salt-off k-off msg-off (- iters 1))]
    (+ 1 (* 0 (+ f r)))))

(defn seal-key [ctx]
  (let [d (kdf-run ctx 3328 3360 3456 3520 1024)
        z (ks/aiueos-keyseal-seal-with-k (kernel-subregion ctx 8192 3360 16) (kernel-subregion ctx 8192 3712 32)
                                         (kernel-subregion ctx 8192 3392 64) (kernel-subregion ctx 8192 3456 64)
                                         (kernel-subregion ctx 8192 3520 128) (kernel-subregion ctx 8192 4096 4096))]
    (+ 1 (* 0 (+ d z)))))

(defn wipe-range [ctx at n i]
  (if (>= i n) 0
    (let [x (put-ctx8 ctx (+ at i) 0)]
      (wipe-range ctx at n (+ i (+ 1 (* 0 x)))))))

(defn seed-diff [ctx i acc]
  (if (>= i 32) acc
    (seed-diff ctx (+ i 1) (bit-or acc (bit-xor (ctx-byte ctx (+ 3712 i)) (ctx-byte ctx (+ 3648 i)))))))

;; Read-back before the key is declared: open the fresh blob under the same passphrase into ctx 3648..3679 and
;; compare with the seed; 1 only when the tag matched and the seed is identical. The copy is wiped.
(defn verify-seal [ctx]
  (let [d (kdf-run ctx 3328 3360 3456 3520 1024)
        z (ks/aiueos-keyseal-open-with-k (kernel-subregion ctx 8192 3360 16) (kernel-subregion ctx 8192 3392 64)
                                         (kernel-subregion ctx 8192 3648 32) (kernel-subregion ctx 8192 3456 64)
                                         (kernel-subregion ctx 8192 3520 128) (kernel-subregion ctx 8192 4096 4096))
        diff (seed-diff ctx 0 0)
        w (wipe-range ctx 3648 32 0)]
    (if (and (= z 1) (= diff 0)) (+ 1 (* 0 (+ d w))) 0)))

(defn create-confirm [s ctx]
  (let [n (word ctx 95)]
    (if (or (< n 4) (> n 24)) 1
      (let [ok (draw-seed ctx (word ctx 90))
            sk (if (= ok 1) (draw-salt ctx) 0)]
        (if (and (= ok 1) (= sk 1))
          (let [d (derive-and-sign ctx)
                b (copy-salt-blob ctx 0)
                z (seal-key ctx)
                v (verify-seal ctx)
                fp (+ (* 65536 (ctx-byte ctx 1280)) (+ (* 256 (ctx-byte ctx 1281)) (ctx-byte ctx 1282)))]
            (if (= v 1)
              (let [st (draft-store/store-key)]
                (do (put-word ctx 97 (if (> st 0) 1 0))
                    (+ (pass-close s ctx (+ 68 (* fp 128)) 1) (* 0 (+ d (+ b z))))))
              (+ (wipe-range ctx 3712 32 0) (+ (wipe-range ctx 3392 64 0) (pass-close s ctx 0 7)))))
          (pass-close s ctx 0 2))))))

;; Unlock: the blob read from the disk at boot (ctx 3392) is opened under the typed passphrase; the tag decides.
;; A wrong passphrase releases nothing (the seed output is wiped), the key stays locked (ctx word 94 = 8); the
;; right one restores the seed, derives the public key and signs the proof again (ctx word 94 = 9).
(defn copy-blob-salt [ctx i]
  (if (>= i 16) 0
    (let [x (put-ctx8 ctx (+ 3360 i) (ctx-byte ctx (+ 3392 i)))]
      (copy-blob-salt ctx (+ i (+ 1 (* 0 x)))))))

(defn unlock-confirm [s ctx]
  (let [n (word ctx 95)]
    (if (or (< n 4) (> n 24)) 1
      (let [cs (copy-blob-salt ctx 0)
            d (kdf-run ctx 3328 3360 3456 3520 1024)
            z (ks/aiueos-keyseal-open-with-k (kernel-subregion ctx 8192 3360 16) (kernel-subregion ctx 8192 3392 64)
                                             (kernel-subregion ctx 8192 3712 32) (kernel-subregion ctx 8192 3456 64)
                                             (kernel-subregion ctx 8192 3520 128) (kernel-subregion ctx 8192 4096 4096))]
        (if (= z 1)
          (let [dd (derive-and-sign ctx)
                fp (+ (* 65536 (ctx-byte ctx 1280)) (+ (* 256 (ctx-byte ctx 1281)) (ctx-byte ctx 1282)))]
            (do (put-word ctx 96 0)
                (+ (pass-close s ctx (+ (- 68 128) (* fp 128)) 9) (* 0 (+ cs (+ d dd))))))
          (+ (wipe-range ctx 3712 32 0) (pass-close s ctx 0 8)))))))

(defn pass-confirm [s ctx]
  (if (= (word ctx 98) 1) (unlock-confirm s ctx) (create-confirm s ctx)))

(defn pass-pending [s code ctx]
  (if (= code 1) (pass-cancel s ctx)
    (if (= code 28) (pass-confirm s ctx)
      (if (= code 14) (pass-back s ctx)
        (if (> (goal-codepoint code) 0) (pass-type s ctx (goal-codepoint code)) 0)))))

(defn allow-pending [s ctx]
  (if (= (word ctx 87) 3) (allow-sign s ctx)
    (if (= (word ctx 87) 4) (pass-confirm s ctx) (allow-key s ctx))))
(defn deny-pending [s ctx]
  (if (= (word ctx 87) 3) (deny-sign s ctx)
    (if (= (word ctx 87) 4) (pass-cancel s ctx) (deny-key s ctx))))

(defn key-pending [s code ctx]
  (if (= (word ctx 87) 4) (pass-pending s code ctx)
    (if (= code 21) (allow-pending s ctx)
      (if (or (= code 49) (= code 1)) (deny-pending s ctx) 0))))

(defn reduce-key [s code ctx]
  (if (>= (word ctx 87) 2) (key-pending s code ctx)
  (if (and (= (word ctx 86) 4) (= (word ctx 87) 1))
    (if (= code 21)
      (do (put-word ctx 87 0) (put-word s 2039 (+ (word s 2039) 3)) (put-word ctx 88 1) (put-word ctx 85 1) 1)
      (if (or (= code 49) (= code 1))
        (do (put-word ctx 87 0) (put-word s 2039 (- (word s 2039) 1)) (seed-app-label s 2 0) 1)
        0))
  (if (and (= (word ctx 86) 4) (= (word s 2) 2)
           (= code 28) (> (word s 2038) 12))
    (do (put-word ctx 87 1) (put-word s 2039 (+ (word s 2039) 1)) (model-confirm-title s 0) 1)
  (if (and (or (= (word ctx 86) 2) (= (word ctx 86) 3)) (= (word s 2) 2)
           (= code 28) (> (word s 2038) 12))
    (do (put-word ctx 85 1) 1)
  (if (and (= (word ctx 84) 1) (= (word s 2) 2) (= code 63))
    (let [generation (draft-store/commit s (word ctx 80))]
      (do (put-word ctx 82 generation)
          (if (> generation 0) (put-word ctx 80 generation) 0)
          1))
  (if (and (= (word s 2) 2)
           (or (= code 14) (> (goal-codepoint code) 0)))
    (let [changed (edit-itonami-goal s code)]
      (if (= changed 1)
        (do (put-word ctx 89 0) (seed-app-label s 2 0) 1)
        0))
  (if (= code 1)
    (close-app s (word s 2))
    (if (= code 15)
      (cycle-window s)
      (if (= code 2) (launch-app s 1 (word ctx 40) (word ctx 41))
        (if (= code 3) (launch-app s 2 (word ctx 40) (word ctx 41))
          (if (= code 4) (launch-app s 3 (word ctx 40) (word ctx 41))
            (if (= code 5) (launch-app s 4 (word ctx 40) (word ctx 41))
              (if (= code 67) (collapse-focused s (word ctx 41))
                (if (= code 64) (minimize-focused s)
                  (if (= code 66) (open-key-request s ctx) (if (= code 65) (open-sign-request s ctx) 0)))))))))))))))))

(defn clamp-coordinate [value extent]
  (if (< value 0) 0
    (if (>= value extent) (- extent 1) value)))

;; ADR-0275 W1: the pointer half of the consent surface. The rectangles are
;; browser_frame2's `consent` geometry (panel 480 x 224 centred; Allow at
;; panel + (24, 164), Deny at panel + (180, 164), both 140 x 36). While a
;; request is pending every press is consumed here, so no window, launcher or
;; dock under the panel can be clicked. Allow and Deny do exactly what Y and
;; N/Esc do.
(defn in-rect [x y rx ry rw rh]
  (and (>= x rx) (< x (+ rx rw)) (>= y ry) (< y (+ ry rh))))

(defn consent-click [s ctx x y]
  (let [px (quot (- (word ctx 40) 480) 2)
        py (quot (- (word ctx 41) 224) 2)]
    (if (in-rect x y (+ px 24) (+ py 164) 140 36)
      (if (>= (word ctx 87) 2) (allow-pending s ctx)
        (do (put-word ctx 87 0) (put-word s 2039 (+ (word s 2039) 3)) (put-word ctx 88 1) (put-word ctx 85 1) 1))
      (if (in-rect x y (+ px 180) (+ py 164) 140 36)
        (if (>= (word ctx 87) 2) (deny-pending s ctx)
          (do (put-word ctx 87 0) (put-word s 2039 (- (word s 2039) 1)) (seed-app-label s 2 0) 1))
        0))))

(defn hit-launcher [x id]
  (let [left (+ 6 (* 102 (- id 1)))]
    (if (and (>= x left) (< x (+ left 96)))
      id
      (if (>= id 4) 0 (hit-launcher x (+ id 1))))))

(defn hit-dock [x y width height id]
  (let [panel-left (quot (- width 184) 2)
        icon-left (+ panel-left 8 (* 44 (- id 1)))
        icon-top (- height 46)]
    (if (and (>= x icon-left) (< x (+ icon-left 36))
             (>= y icon-top) (< y (- height 10)))
      id
      (if (>= id 4) 0 (hit-dock x y width height (+ id 1))))))

(defn hit-window-index [s x y index]
  (if (< index 0)
    -1
    (let [slot (+ 5 (* index 5))
          wx (word s (+ slot 1))
          wy (word s (+ slot 2))
          ww (word s (+ slot 3))
          wh (word s (+ slot 4))]
      (if (and (< wh 65536) (>= x wx) (< x (+ wx ww))
               (>= y wy) (< y (+ wy wh)))
        index
        (hit-window-index s x y (- index 1))))))

(defn titlebar-drag-id [s x y width height]
  (if (or (< y 28) (>= y (- height 52)))
    0
    (let [index (hit-window-index s x y (- (word s 1) 1))]
      (if (< index 0)
        0
        (let [slot (+ 5 (* index 5))
              id (word s slot)
              wx (word s (+ slot 1))
              wy (word s (+ slot 2))
              ww (word s (+ slot 3))]
          (if (and (< y (+ wy 28))
                   (not (and (> ww 40)
                             (>= x (+ wx (- ww (if (>= ww 80) 64 44))))
                             (< x (+ wx (- ww 8)))
                             (>= y (+ wy 6))
                             (< y (+ wy 22)))))
            id
            0))))))

(defn clamp-between [value minimum maximum]
  (if (< value minimum) minimum
    (if (> value maximum) maximum value)))

(defn move-window-id [s id dx dy width height]
  (let [index (window-index s id 0)]
    (if (< index 0)
      0
      (let [slot (+ 5 (* index 5))
            x (word s (+ slot 1))
            y (word s (+ slot 2))
            window-width (word s (+ slot 3))
            window-height (word s (+ slot 4))]
        (if (>= window-height 65536) 0
        (do (put-word s (+ slot 1)
                      (clamp-between (+ x dx) 0 (- width window-width)))
            (put-word s (+ slot 2)
                      (clamp-between (+ y dy) 28 (- height window-height)))
            1))))))

;; Collapse (roll up to the titlebar): the validated minimum window height is 29.
;; Unrolling restores launch-app's height and keeps the window on screen. A
;; click on the control left of close, or F9 (scancode 67), toggles it.
(defn full-height [height]
  (if (> height 600) 560 (- height 72)))

(defn toggle-collapse [s index height]
  (let [slot (+ 5 (* index 5))
        y (word s (+ slot 2))
        h (word s (+ slot 4))]
    (if (= h 29)
      (let [full (full-height height)]
        (do (put-word s (+ slot 4) full)
            (put-word s (+ slot 2) (if (> (+ y full) height) (- height full) y))
            1))
      (do (put-word s (+ slot 4) 29) 1))))

(defn collapse-focused [s height]
  (let [index (window-index s (word s 2) 0)]
    (if (< index 0) 0 (toggle-collapse s index height))))

(defn click-window [s ctx]
  (let [index (hit-window-index s (word ctx 50) (word ctx 51)
                                (- (word s 1) 1))]
    (if (< index 0)
      0
      (let [slot (+ 5 (* index 5))
            id (word s slot)
            x (word ctx 50)
            y (word ctx 51)
            wx (word s (+ slot 1))
            wy (word s (+ slot 2))
            ww (word s (+ slot 3))]
        (if (and (>= ww 80)
                 (>= x (+ wx (- ww 64)))
                 (< x (+ wx (- ww 48)))
                 (>= y (+ wy 6))
                 (< y (+ wy 22)))
          (do (focus-window s index) (minimize-focused s))
        (if (and (> ww 40)
                 (>= x (+ wx (- ww 44)))
                 (< x (+ wx (- ww 28)))
                 (>= y (+ wy 6))
                 (< y (+ wy 22)))
          (toggle-collapse s index (word ctx 41))
          (if (and (> ww 40)
                   (>= x (+ wx (- ww 24)))
                   (< x (+ wx (- ww 8)))
                   (>= y (+ wy 6))
                   (< y (+ wy 22)))
            (close-app s id)
            (focus-window s index))))))))

(defn click-launcher [s ctx]
  (if (< (word ctx 51) 28)
    (let [id (hit-launcher (word ctx 50) 1)]
      (if (> id 0)
        (launch-app s id (word ctx 40) (word ctx 41))
        0))
    (if (>= (word ctx 51) (- (word ctx 41) 52))
      (let [id (hit-dock (word ctx 50) (word ctx 51)
                         (word ctx 40) (word ctx 41) 1)]
        (if (> id 0)
          (launch-app s id (word ctx 40) (word ctx 41))
          (click-window s ctx)))
      (click-window s ctx))))

(defn apply-mouse-packet [s ctx]
  (let [raw-x (word ctx 65)
        raw-y (word ctx 66)
        dx (if (>= raw-x 128) (- raw-x 256) raw-x)
        dy (if (>= raw-y 128) (- raw-y 256) raw-y)
        old-x (word ctx 50)
        old-y (word ctx 51)
        x (clamp-coordinate (+ old-x dx) (word ctx 40))
        y (clamp-coordinate (- old-y dy) (word ctx 41))
        left (bit-and (word ctx 64) 1)]
    (do (put-word ctx 75 (+ (word ctx 75) 1))
        (put-word ctx 50 x)
        (put-word ctx 51 y)
        (put-word s 2046 (+ x 1))
        (put-word s 2047 y)
        (if (and (= left 1) (= (word ctx 67) 0))
          (if (> (word ctx 87) 0)
            (consent-click s ctx x y)
            (let [drag-id (titlebar-drag-id s x y (word ctx 40) (word ctx 41))]
              (do (put-word ctx 76 (+ (word ctx 76) 1))
                (click-launcher s ctx)
                (put-word ctx 71
                          drag-id))))
          (if (and (= left 1) (> (word ctx 71) 0) (= (word ctx 87) 0))
            (move-window-id s (word ctx 71) (- x old-x) (- y old-y)
                            (word ctx 40) (word ctx 41))
            (if (= left 0) (put-word ctx 71 0) 0)))
        (put-word ctx 67 left)
        1)))

(defn consume-mouse-byte [s ctx byte]
  (if (= byte 250)
    0
    (if (= (word ctx 63) 0)
      (if (= (bit-and byte 8) 8)
        (do (put-word ctx 64 byte)
            (put-word ctx 63 1)
            0)
        0)
    (if (= (word ctx 63) 1)
      (do (put-word ctx 65 byte)
          (put-word ctx 63 2)
          0)
      (do (put-word ctx 66 byte)
          (put-word ctx 63 0)
          (apply-mouse-packet s ctx))))))

(defn poll-input [s ctx]
  (do (put-word ctx 68 (kernel-in-u8 100))
      (if (= (bit-and (word ctx 68) 1) 0)
        0
        (do (put-word ctx 69 (kernel-in-u8 96))
            (if (= (bit-and (word ctx 68) 32) 32)
              (consume-mouse-byte s ctx (word ctx 69))
              (if (or (= (word ctx 69) 0) (>= (word ctx 69) 128))
                0
                (do (put-word ctx 73 (+ (word ctx 73) 1))
                    (put-word ctx 77 (word ctx 69))
                    (reduce-key s (word ctx 69) ctx) 1)))))))

(defn wait-controller [remaining]
  (if (= (bit-and (kernel-in-u8 100) 2) 0)
    1
    (if (= remaining 0)
      0
      (wait-controller (- remaining 1)))))

(defn enable-mouse []
  (do (wait-controller 4096)
      (kernel-out-u8 100 168)
      (wait-controller 4096)
      (kernel-out-u8 100 212)
      (wait-controller 4096)
      (kernel-out-u8 96 244)
      0))

(defn desktop-loop [s font fb fb-bytes ctx]
  (do (put-word ctx 70 (poll-input s ctx))
      (if (> (word ctx 70) 0)
        (present-frame s font fb fb-bytes ctx)
        0)
      (if (= (word ctx 85) 1)
        1
        (do (kernel-pause)
            (desktop-loop s font fb fb-bytes ctx)))))

;; W3a (ADR-0277): which hardware entropy instructions the CPU reports. Word 90 of
;; the context: bit 0 = RDRAND (CPUID.1:ECX bit 30), bit 1 = RDSEED (CPUID.7:EBX
;; bit 18), bit 2 = the CPUID leaf 7 exists. Only availability is read; the
;; compiler has no intrinsic that executes RDRAND/RDSEED yet, so no byte is drawn.
(defn entropy-flags []
  (let [max-leaf (kernel-cpuid-eax 0 0)
        rdrand (if (= (bit-and (kernel-cpuid-ecx 1 0) 1073741824) 0) 0 1)
        leaf7 (if (>= max-leaf 7) 1 0)
        rdseed (if (and (= leaf7 1) (not (= (bit-and (kernel-cpuid-ebx 7 0) 262144) 0))) 1 0)]
    (+ rdrand (+ (* rdseed 2) (* leaf7 4)))))

;; W3a (ADR-0277): one hardware draw, only when CPUID reported RDRAND (flags bit 0);
;; executing it on a CPU without it would raise #UD. Returns the low 32 bits of
;; the 64-bit draw, or 0 when the instruction is absent or kept reporting
;; failure (kernel-rdrand returns 0 then): 0 means "no entropy", never a value.
(defn entropy-draw [flags]
  (if (= (bit-and flags 1) 1)
    (bit-and (kernel-rdrand) 4294967295)
    0))

(defn run-desktop [profile]
  (let [boot (kernel-boot-info)
        prefix (kernel-subregion boot 16544 0 160)
        width (kernel-framebuffer-width)
        height (kernel-framebuffer-height)
        stride (kernel-framebuffer-stride)
        pixel-format (kernel-framebuffer-format)
        fb-bytes (* (* stride height) 4)
        font-bytes 524288]
    (if (and (= (load64-boot prefix 8) 6)
             (= (load32-boot prefix 128) width) (> (kernel-read-cr3) 0))
      (let [surface (kernel-browser-surface)
            context (kernel-browser-context)
            font (kernel-native-font)]
        (do (put-word context 40 width)
            (put-word context 41 height)
            (put-word context 42 stride)
            (put-word context 43 pixel-format)
            (put-word context 45 font-bytes)
            (put-word context 50 40)
            (put-word context 51 40)
            (put-word context 63 0)
            (put-word context 67 0)
            (put-word context 71 0)
            (put-word context 72 0x31545844)
            (put-word context 73 0)
            (put-word context 75 0)
            (put-word context 76 0)
            (put-word context 77 0)
            (put-word context 78 0)
            (put-word context 79 0)
            (put-word context 80 0)
            (put-word context 81 0)
            (put-word context 82 0)
            (put-word context 84 (if (or (= profile 1) (= profile 3) (= profile 4)) 1 0))
            (put-word context 85 0)
            (put-word context 86 profile)
            (put-word context 87 0)
            (put-word context 88 0)
            (put-word context 89 0)
            (put-word context 90 (entropy-flags))
            (put-word context 91 (entropy-draw (word context 90)))
            (put-word context 92 (entropy-draw (word context 90)))
            (enable-mouse)
            (clear-surface surface 0)
            (seed-desktop surface width height)
            (if (or (= profile 1) (= profile 3) (= profile 4))
              (let [generation (draft-store/restore surface)]
                (do (put-word surface 229 108)
                    (put-word surface 230 111)
                    (put-word surface 231 99)
                    (put-word surface 232 97)
                    (put-word surface 233 108)
                    (put-word context 81 generation)
                    (if (> generation 0) (put-word context 80 generation) 0)
                    (if (and (= profile 4) (> (word context 89) 0))
                      (diagnostic-title surface (word context 89))
                      0)
                    (if (= profile 4)
                      (if (= (draft-store/load-key) 1)
                        (do (put-word context 96 1) (put-word surface 2039 128))
                        0)
                      0)))
              0)
            (present-frame surface font 0 fb-bytes context)
            (desktop-loop surface font 0 fb-bytes context)))
      (kernel-hlt))))

(defn main [] (run-desktop 0))
(defn workspace-main [] (run-desktop 1))
(defn goal-main [] (run-desktop 2))
(defn goal-draft-main [] (run-desktop 3))
(defn goal-model-main [] (run-desktop 4))
