                  (draw-glyph s font fb fb-bytes ctx (+ x (bit-and b 255)) y (quot a 65536) (quot b 256)))
              (draw-glyph s font fb fb-bytes ctx x y a b))))
          (put-word ctx 30 (+ (word ctx 30) 1))
          (present-ops s font fb fb-bytes ctx)))))

(defn present-frame [s font fb fb-bytes ctx]
  (clock-step ctx)
  (put-word ctx 115 (word ctx 111))
  (if (< (word ctx 79) 2) (debug-log ctx 33 (word ctx 79)) 0)
  (update-effects s ctx)
  (if (< (word ctx 79) 2) (debug-log ctx 34 0) 0)
  (inertia-step s ctx)
  (put-word ctx 78 (+ (word ctx 78) 1))
  ;; Pointer y keeps visual-only flags above its low 16-bit coordinate:
  ;; press, reduced effects and dock selection. These never carry authority.
  (put-word s 2047 (+ (word ctx 51) (* (word ctx 67) 65536)
                     (* (word ctx 99) 131072) (* (dock-selection) 262144)))
  (put-word ctx 30 0)
  (put-word ctx 31
            (browser-frame/aiueos-browser-frame2
             s 8192 font (word ctx 45)))
  ;; The stored count is u32: a negative renderer result wraps above 259.
  ;; Never walk that value as an op count, even after a refused material/frame.
  (put-word (kernel-subregion (kernel-desktop-effects) 16384 0 8192) 56 (if (> (word ctx 31) 259) (word ctx 31) 0))
  (if (< (word ctx 79) 2) (debug-log ctx 35 (word ctx 31)) 0)
  (let [result (if (> (word ctx 31) 259) 0
                 (do (frame-damage s ctx)
                     (if (< (word ctx 79) 2)
                       (debug-log ctx 36 (+ (* (word ctx 20) 281474976710656) (* (word ctx 21) 4294967296)
                                            (* (word ctx 22) 65536) (word ctx 23))) 0)
                     (if (and (< (word ctx 20) (word ctx 22)) (< (word ctx 21) (word ctx 23)))
                       (present-ops s font fb fb-bytes ctx) 0)
                     (if (< (word ctx 79) 2) (debug-log ctx 37 (word ctx 30)) 0)
                     (cache-ops s 0 (* (word ctx 31) 6))
                     (let [state (kernel-subregion (kernel-desktop-effects) 16384 0 8192)]
                       (do (put-word state 48 (word ctx 31)) (put-word state 49 1)))))]
    (do (clock-step ctx)
        (put-word ctx 116 (- (word ctx 111) (word ctx 115)))
        (if (> (word ctx 116) (word ctx 122)) (put-word ctx 122 (word ctx 116)) 0)
        (if (> (word ctx 116) 16)
          (put-word ctx 120 (+ (word ctx 120) (quot (word ctx 116) 16))) 0)
        (if (> (word ctx 117) 0)
          (do (if (> (- (+ (word ctx 111) 1) (word ctx 117)) (word ctx 118))
                (put-word ctx 118 (- (+ (word ctx 111) 1) (word ctx 117))) 0)
              (put-word ctx 117 0)) 0)
        (put-word ctx 119 (+ (word ctx 119) 1))
        (put-word ctx 114 (+ (word ctx 111) 16))
        (put-word ctx 79 (+ (word ctx 79) 1)) result)))

(defn seed-app-label [s id index]
  (let [slot (+ 32 (* 32 (- id 1)))
        label-length (app-catalog/app-title-length id)]
    (if (>= index label-length)
      (put-word s (+ slot index) 0)
      (do (put-word s (+ slot index)
                    (app-catalog/app-title-codepoint id index))
          (seed-app-label s id (+ index 1))))))

(defn seed-app-labels [s id]
  (if (> id (app-catalog/app-count))
    0
    (do (seed-app-label s id 0)
        (seed-app-labels s (+ id 1)))))

;; The local bigram call is diagnostic. Make its single-byte result visible
;; without presenting it as a completed agent turn or reusing an approval.
(defn diagnostic-title [s token]
  (do (seed-app-label s 2 0)
      (put-word s 71 32) (put-word s 72 100)
      (put-word s 73 101) (put-word s 74 109)
      (put-word s 75 111) (put-word s 76 32)
      (put-word s 77 token) (put-word s 78 0)
      1))
(defn show-diagnostic-result [token]
  (if (not (or (= token 32) (and (>= token 97) (<= token 122)))) 0
    (let [surface (kernel-browser-surface)
          context (kernel-browser-context)
          stride (kernel-framebuffer-stride)
          height (kernel-framebuffer-height)]
      (do (diagnostic-title surface token)
          (present-frame surface (kernel-native-font) 0
                         (* (* stride height) 4) context)))))

(defn seed-app-body [s id index]
  (let [slot (+ 160 (* 64 (- id 1)))
        body-length (app-catalog/app-body-length id)]
    (if (>= index body-length)
      (put-word s (+ slot index) 0)
      (do (put-word s (+ slot index)
                    (app-catalog/app-body-codepoint id index))
          (seed-app-body s id (+ index 1))))))

(defn seed-app-bodies [s id]
  (if (> id (app-catalog/app-count))
    0
    (do (seed-app-body s id 0)
        (seed-app-bodies s (+ id 1)))))

(defn seed-desktop [s width height]
  (do (put-word s 0 1)
      (put-word s 1 0)
      (put-word s 2 0)
      (put-word s 3 width)
      (put-word s 4 height)
      (put-word s 31 15)
      (seed-app-labels s 1)
      (seed-app-bodies s 1)
      (put-word s 2038 (app-catalog/app-body-length 2))
      (put-word s 2046 41)
      (put-word s 2047 40)))

(defn window-open? [s id index]
  (if (>= index (word s 1))
    0
    (if (= (word s (+ 5 (* index 5))) id)
      1
      (window-open? s id (+ index 1)))))

(defn window-index [s id index]
  (if (>= index (word s 1))
    -1
    (if (= (word s (+ 5 (* index 5))) id)
      index
      (window-index s id (+ index 1)))))

;; Height bit 16 hides an existing window without discarding its geometry or
;; body. No new surface word, approval state or app instance is allocated.
(defn last-visible-id [s index]
  (if (< index 0) 0
    (let [slot (+ 5 (* index 5))]
      (if (< (word s (+ slot 4)) 65536) (word s slot)
        (last-visible-id s (- index 1))))))

(defn first-visible-index [s index]
  (if (>= index (word s 1)) -1
    (if (< (word s (+ 9 (* index 5))) 65536) index
      (first-visible-index s (+ index 1)))))

(defn minimize-focused [s]
  (let [index (window-index s (word s 2) 0)]
    (if (< index 0) 0
      (let [slot (+ 9 (* index 5))
            height (word s slot)]
        (if (>= height 65536) 0
          (do (put-word s slot (+ height 65536))
              (put-word s 2 (last-visible-id s (- (word s 1) 1)))
              1))))))

(defn shift-window-left [s current end]
  (if (>= current end)
    0
    (let [slot (+ 5 (* current 5))
          next (+ slot 5)]
      (do (put-word s slot (word s next))
          (put-word s (+ slot 1) (word s (+ next 1)))
          (put-word s (+ slot 2) (word s (+ next 2)))
          (put-word s (+ slot 3) (word s (+ next 3)))
          (put-word s (+ slot 4) (word s (+ next 4)))
          (shift-window-left s (+ current 1) end)))))

(defn focus-window [s index]
  (if (< index 0)
    0
    (let [count (word s 1)
          slot (+ 5 (* index 5))
          id (word s slot)
          x (word s (+ slot 1))
          y (word s (+ slot 2))
          width (word s (+ slot 3))
          height (word s (+ slot 4))
          last-index (- count 1)
          last-slot (+ 5 (* last-index 5))]
      (do (put-word s 2 id)
          (put-word s (+ slot 4) (mod height 65536))
          (if (< index last-index)
            (do (shift-window-left s index last-index)
                (put-word s last-slot id)
                (put-word s (+ last-slot 1) x)
                (put-word s (+ last-slot 2) y)
                (put-word s (+ last-slot 3) width)
                (put-word s (+ last-slot 4) (mod height 65536)))
            0)
          1))))

(defn remove-window-at [s index current count id]
  (if (>= (+ current 1) count)
    (let [new-count (- count 1)
          fallback (if (= new-count 0)
                     0
                     (last-visible-id s (- new-count 1)))]
      (do (put-word s 1 new-count)
          (if (= (word s 2) id)
            (put-word s 2 fallback)
            0)
          (put-word s (+ 5 (* current 5)) 0)
          (put-word s (+ 6 (* current 5)) 0)
          (put-word s (+ 7 (* current 5)) 0)
          (put-word s (+ 8 (* current 5)) 0)
          (put-word s (+ 9 (* current 5)) 0)
          1))
    (let [slot (+ 5 (* current 5))
          next (+ slot 5)]
      (do (put-word s slot (word s next))
          (put-word s (+ slot 1) (word s (+ next 1)))
          (put-word s (+ slot 2) (word s (+ next 2)))
          (put-word s (+ slot 3) (word s (+ next 3)))
          (put-word s (+ slot 4) (word s (+ next 4)))
          (remove-window-at s index (+ current 1) count id)))))

(defn close-app [s id]
  (let [index (window-index s id 0)]
    (if (< index 0)
      0
      (remove-window-at s index index (word s 1) id))))

(defn cycle-window [s]
  ;; The focused window is at the top of the stack. Tab cycles only through
  ;; visible windows; a launcher key or dock click explicitly restores one.
  (focus-window s (first-visible-index s 0)))

(defn launch-app [s id width height]
  (if (= (window-open? s id 0) 1)
    (focus-window s (window-index s id 0))
    (if (>= (word s 1) 4)
      0
      (let [index (word s 1)
            slot (+ 5 (* index 5))
            window-width (if (> width 896) 880 (- width 16))
            window-height (if (> height 600) 560 (- height 72))
            room-x (- width window-width)
            room-y (- height window-height)
            cascade-x (if (> room-x 60) 18 (quot room-x 4))
            cascade-y (if (> (- room-y 46) 54) 18 (quot (- room-y 46) 4))
            base-x (quot (- room-x (* 3 cascade-x)) 2)
            base-y (if (> height 620) 44 36)
            x (+ base-x (* index cascade-x))
            y (+ base-y (* index cascade-y))]
        (do (put-word s 1 (+ index 1))
            (put-word s 2 id)
            (put-word s slot id)
            (put-word s (+ slot 1) x)
            (put-word s (+ slot 2) y)
            (put-word s (+ slot 3) window-width)
            (put-word s (+ slot 4) window-height))))))

(defn goal-codepoint [code]
  ;; PS/2 set-1 make codes. The native goal draft accepts lowercase ASCII and
  ;; spaces only; no host text service, model call, or implicit network access.
  (case code
    16 113 17 119 18 101 19 114 20 116 21 121 22 117 23 105 24 111 25 112
    30 97 31 115 32 100 33 102 34 103 35 104 36 106 37 107 38 108
    44 122 45 120 46 99 47 118 48 98 49 110 50 109 57 32 0))

(defn edit-itonami-goal [s code]
  (let [length (word s 2038)
        slot (+ 224 length)
        cp (goal-codepoint code)]
    (if (= code 14)
      (if (> length 12)
        (do (put-word s (- slot 1) 0)
            (put-word s 2038 (- length 1))
            1)
        0)
      (if (and (> cp 0) (< length 63))
        (do (put-word s slot cp)
            (put-word s (+ slot 1) 0)
            (put-word s 2038 (+ length 1))
            1)
        0))))

;; This title is owned by the native host. It identifies the local operation
;; and the Goal data being read while the user makes a fresh Y/N choice. It is
;; not a reusable capability and never enters the draft store.
(defn model-confirm-title [s index]
  (let [cp (case index
             0 65 1 73 2 85 3 69 4 79 5 83 6 32 7 108 8 111 9 99
             10 97 11 108 12 32 13 109 14 111 15 100 16 101 17 108
             18 32 19 71 20 111 21 97 22 108 23 63 24 32 25 121
             26 47 27 110 0)]
    (do (put-word s (+ 64 index) cp)
        (if (< index 28) (model-confirm-title s (+ index 1)) 1))))


;; ADR-0277 W3: the device key. F8 opens a consent request of its own kind (word 2039 bit 1);
;; only Allow (Y or the button) draws a 32-byte seed with kernel-rdrand (guarded by CPUID, and a draw
;; of 0 means no entropy: the request fails closed and no key exists), derives the Ed25519 public key
;; and signs a fixed proof message with it. The seed stays in guest RAM (context bytes 3712..3743, outside the draft store's scratch 512..2559): it is
;; never displayed, never persisted and never leaves the device. The home then shows the first three
;; public-key bytes. ctx bytes: seed 3712, hash scratch 1088, public key 1280 (128-byte scratch),
;; signing buffer 2048 (1024), proof message at buffer+256, signature 3072 (64), workspace 4096 (4096).
;; One-byte subregions on purpose: the plain kernel-load-u8/kernel-store-u8 tier traps with #UD at run
;; time when its size operand is above 512, and the compiler does not check that (JUN-483). Do not pass
;; the whole 8192-byte context as the region of a plain-tier access.
(defn ctx-byte [ctx at] (kernel-load-u8 (kernel-subregion ctx 8192 at 1) 1 0))
(defn put-ctx8 [ctx at v]
  (let [stored (kernel-store-u8 (kernel-subregion ctx 8192 at 1) 1 0 v)]
    (+ 1 (* 0 stored))))

(defn store-draw [ctx at v i]
  (if (= i 8) 1
    (let [stored (put-ctx8 ctx (+ at i) (bit-and (u64-shift-right v (* 8 i)) 255))]
      (store-draw ctx at v (+ i 1 (* 0 stored))))))

;; JUN-482 health check: a source that repeats itself is stuck. Any two equal 64-bit draws refuse the
;; draw; for a working source that happens with probability about 2^-61 per draw, so it never refuses
;; one by chance in practice (a repetition-count test in the spirit of NIST SP 800-90B 4.4.1).
(defn draws-distinct? [d0 d1 d2 d3]
  (not (or (= d0 d1) (or (= d0 d2) (or (= d0 d3) (or (= d1 d2) (or (= d1 d3) (= d2 d3))))))))

;; 1 when four non-zero, pairwise different 64-bit draws were stored at ctx 3712..3743, else 0
;; (nothing stored on failure)
(defn draw-seed [ctx flags]
  (if (= (bit-and flags 1) 0) 0
    (let [d0 (kernel-rdrand) d1 (kernel-rdrand) d2 (kernel-rdrand) d3 (kernel-rdrand)]
      (if (or (or (= d0 0) (or (= d1 0) (or (= d2 0) (= d3 0)))) (not (draws-distinct? d0 d1 d2 d3))) 0
        (let [a (store-draw ctx 3712 d0 0) b (store-draw ctx 3720 d1 0)
              c (store-draw ctx 3728 d2 0) d (store-draw ctx 3736 d3 0)]
          (+ 1 (* 0 (+ a (+ b (+ c d))))))))))

(defn proof-byte [i]
  (case i 0 105 1 116 2 111 3 110 4 97 5 109 6 105 7 45 8 119 9 51 10 45 11 107 12 101 13 121 14 45 15 112 16 114 17 111 18 111 19 102 0))

(defn copy-seed-and-proof [ctx i]
  (if (= i 32) 1
    (let [a (put-ctx8 ctx (+ 2048 i) (ctx-byte ctx (+ 3712 i)))
          b (put-ctx8 ctx (+ 2304 i) (proof-byte i))]
      (copy-seed-and-proof ctx (+ i 1 (* 0 (+ a b)))))))

;; The proof signature is checked with aiueos.ed25519's verifier under the public key just derived, before the key counts
;; (ADR-0278, JUN-518): a fault in the derivation or the signing (or the verifier) makes derive-and-sign return 0.
(defn copy-ctx-bytes [ctx dst src n i]
  (if (>= i n) 0
    (let [x (put-ctx8 ctx (+ dst i) (ctx-byte ctx (+ src i)))]
      (copy-ctx-bytes ctx dst src n (+ i (+ 1 (* 0 x)))))))
(defn fill-proof-message [ctx i]
  (if (>= i 20) 0
    (let [x (put-ctx8 ctx (+ 2144 i) (proof-byte i))]
      (fill-proof-message ctx (+ i (+ 1 (* 0 x)))))))
(defn verify-own-proof [ctx]
  (let [a (copy-ctx-bytes ctx 2048 1280 32 0)
        b (copy-ctx-bytes ctx 2080 3072 64 0)
        c (fill-proof-message ctx 0)
        v (ed/aiueos-ed25519-verify (kernel-subregion ctx 8192 2048 1024) 20 (kernel-subregion ctx 8192 4096 4096))]
    (+ v (* 0 (+ a (+ b c))))))

(defn derive-and-sign [ctx]
  (let [pk (ed/aiueos-ed25519-pubkey (kernel-subregion ctx 8192 3712 32)
                                     (kernel-subregion ctx 8192 1280 128)
                                     (kernel-subregion ctx 8192 4096 4096)
                                     (kernel-subregion ctx 8192 1088 64))
        cp (copy-seed-and-proof ctx 0)
        sg (ed/aiueos-ed25519-sign (kernel-subregion ctx 8192 2048 1024) 20
                                   (kernel-subregion ctx 8192 3072 64)
                                   (kernel-subregion ctx 8192 4096 4096))
        vp (verify-own-proof ctx)]
    (+ vp (* 0 (+ pk (+ cp sg))))))

;; Allow on the key request opens the passphrase request (ctx word 87 = 4; word 2039 bits 0, 1 and 31 with
;; bit 6 clear, the typed length in bits 7..11); no entropy is drawn and no key exists until the passphrase is
;; confirmed. Returns 1.
(defn allow-key [s ctx]
  (do (put-word ctx 87 4) (put-word ctx 95 0) (put-word s 2039 (+ (word s 2039) 2147483648)) 1))

(defn deny-key [s ctx]
  (do (put-word ctx 87 0) (put-word s 2039 (- (word s 2039) 3)) (put-word ctx 94 3) 1))

;; F8 with no key: a sealed key on the scratch disk (ctx word 96 = 1, word 2039 bit 7 = "locked") opens the unlock
;; request (the passphrase panel with bit 13 set, ctx word 98 = 1); otherwise the key request.
(defn open-key-request [s ctx]
  (if (and (= (word ctx 87) 0) (= (bit-and (quot (word s 2039) 64) 1) 0))
    (if (= (word ctx 96) 1)
      (do (put-word ctx 87 4) (put-word ctx 95 0) (put-word ctx 98 1)
          (put-word s 2039 (+ (word s 2039) (+ 2147483651 8192))) 1)
      (do (put-word ctx 87 2) (put-word s 2039 (+ (word s 2039) 3)) 1))
    0))


;; ADR-0277 W3, consent-bound signing: F7 opens a consent request of the sign kind (word 2039 bits 0, 1 and
;; 31; ctx word 87 = 3) once a device key exists. Only Allow signs a fixed 20-byte test challenge with the
;; key's seed (ctx 3712), the signature lands at ctx 3200 (64 bytes) and ctx word 94 becomes 4; Deny closes the
;; request, signs nothing and leaves 3200..3263 zero (ctx word 94 = 5). No app asks for a signature yet: the
;; trigger is the key and the challenge is a constant.
(defn challenge-byte [i]
  (case i 0 105 1 116 2 111 3 110 4 97 5 109 6 105 7 45 8 119 9 51 10 45 11 115 12 105 13 103 14 110 15 45 16 116 17 101 18 115 19 116 0))

(defn copy-seed-and-challenge [ctx i]
  (if (= i 32) 1
    (let [a (put-ctx8 ctx (+ 2048 i) (ctx-byte ctx (+ 3712 i)))
          b (put-ctx8 ctx (+ 2304 i) (challenge-byte i))]
      (copy-seed-and-challenge ctx (+ i 1 (* 0 (+ a b)))))))

(defn sign-challenge [ctx]
  (let [cp (copy-seed-and-challenge ctx 0)
        sg (ed/aiueos-ed25519-sign (kernel-subregion ctx 8192 2048 1024) 20
                                   (kernel-subregion ctx 8192 3200 64)
                                   (kernel-subregion ctx 8192 4096 4096))]
    (+ 1 (* 0 (+ cp sg)))))

(defn sign-count-step [s]
  (if (< (bit-and (quot (word s 2039) 4) 15) 15) 4 0))

(defn allow-sign [s ctx]
  (let [d (if (= (word s 30) 1) (dapps/aozora-sign s ctx) (sign-challenge ctx))
        k (put-word s 30 0)]
    (do (put-word ctx 87 0)
        (put-word s 2039 (+ (- (word s 2039) 2147483651) (sign-count-step s)))
        (put-word ctx 94 4)
        (+ 1 (* 0 (+ d k))))))

(defn deny-sign [s ctx]
  (do (put-word ctx 87 0) (put-word s 30 0) (put-word s 2039 (- (word s 2039) 2147483651)) (put-word ctx 94 5) 1))

(defn open-sign-request [s ctx]
  (if (and (= (word ctx 87) 0) (= (bit-and (quot (word s 2039) 64) 1) 1))
    (do (put-word ctx 87 3) (put-word s 2039 (+ (word s 2039) 2147483651)) 1)
    0))

;; ADR-0277 W3f: the passphrase request. Keys a-z and space (the goal alphabet) append up to 24 characters
;; (shown as stars), Backspace removes one, Enter confirms from 4 characters, Esc or the Cancel button cancels
;; and wipes the buffer; every other key is swallowed. Confirm draws the seed (rdrand; 0 fails closed), draws a
;; 16-byte salt, derives the public key and the proof signature as before, and seals the seed under the
;; passphrase with aiueos.keyseal into the 64-byte blob at ctx 3392 (words 848..863), RAM only for now. The
;; passphrase buffer (ctx 3328..3359) is wiped on every exit. ctx word 95 holds the typed length.
(defn wipe-pass [ctx i]
  (if (>= i 32) 0
    (let [x (put-ctx8 ctx (+ 3328 i) 0)]
      (wipe-pass ctx (+ i (+ 1 (* 0 x)))))))

(defn set-pass-flags [s old new]
  (put-word s 2039 (+ (- (word s 2039) (* old 256)) (* new 256))))

(defn pass-type [s ctx cp]
  (let [n (word ctx 95)]
    (if (>= n 24) 1
      (let [x (put-ctx8 ctx (+ 3328 n) cp)]
        (do (set-pass-flags s n (+ n 1)) (put-word ctx 95 (+ n 1)) (+ 1 (* 0 x)))))))

(defn pass-back [s ctx]
  (let [n (word ctx 95)]
    (if (<= n 0) 1
      (let [x (put-ctx8 ctx (+ 3328 (- n 1)) 0)]
        (do (set-pass-flags s n (- n 1)) (put-word ctx 95 (- n 1)) (+ 1 (* 0 x)))))))

(defn pass-close [s ctx extra code]
  (let [n (word ctx 95)
        w (wipe-pass ctx 0)]
    (do (put-word s 2039 (+ (- (word s 2039) (+ (+ 2147483651 (* n 256)) (if (= (word ctx 98) 1) 8192 (if (= (word ctx 98) 2) 16384 0)))) extra))
        (put-word ctx 87 0) (put-word ctx 95 0) (put-word ctx 98 0) (put-word ctx 94 code)
        (+ 1 (* 0 w)))))

(defn pass-cancel [s ctx] (pass-close s ctx 0 6))

(defn draw-salt [ctx]
  (let [d0 (kernel-rdrand) d1 (kernel-rdrand)]
    (if (or (= d0 0) (or (= d1 0) (= d0 d1))) 0
      (let [a (store-draw ctx 3360 d0 0) b (store-draw ctx 3368 d1 0)]
        (+ 1 (* 0 (+ a b)))))))

(defn copy-salt-blob [ctx i]
  (if (>= i 16) 0
    (let [x (put-ctx8 ctx (+ 3392 i) (ctx-byte ctx (+ 3360 i)))]
      (copy-salt-blob ctx (+ i (+ 1 (* 0 x)))))))

(defn kdf-rounds [ctx salt-off k-off msg-off n]
  (if (<= n 0) 1
    (let [r (ks/aiueos-keyseal-round (kernel-subregion ctx 8192 salt-off 16) (kernel-subregion ctx 8192 k-off 64)
                                     (kernel-subregion ctx 8192 msg-off 128) (kernel-subregion ctx 8192 4096 4096))]
      (kdf-rounds ctx salt-off k-off msg-off (- n (+ 1 (* 0 r)))))))

;; K into ctx[k-off .. k-off+64) from the 32-byte padded passphrase at pass-off and the salt at salt-off
(defn kdf-run [ctx pass-off salt-off k-off msg-off iters]
  (let [f (ks/aiueos-keyseal-first (kernel-subregion ctx 8192 pass-off 32) (kernel-subregion ctx 8192 salt-off 16)
                                   (kernel-subregion ctx 8192 k-off 64) (kernel-subregion ctx 8192 msg-off 128)
                                   (kernel-subregion ctx 8192 4096 4096))
        r (kdf-rounds ctx salt-off k-off msg-off (- iters 1))]
    (+ 1 (* 0 (+ f r)))))

(defn seal-key [ctx]
  (let [d (kdf-run ctx 3328 3360 3456 3520 1024)
        z (ks/aiueos-keyseal-seal-with-k (kernel-subregion ctx 8192 3360 16) (kernel-subregion ctx 8192 3712 32)
                                         (kernel-subregion ctx 8192 3392 64) (kernel-subregion ctx 8192 3456 64)
                                         (kernel-subregion ctx 8192 3520 128) (kernel-subregion ctx 8192 4096 4096))]
    (+ 1 (* 0 (+ d z)))))

(defn wipe-range [ctx at n i]
  (if (>= i n) 0
    (let [x (put-ctx8 ctx (+ at i) 0)]
      (wipe-range ctx at n (+ i (+ 1 (* 0 x)))))))

(defn seed-diff [ctx i acc]
  (if (>= i 32) acc
    (seed-diff ctx (+ i 1) (bit-or acc (bit-xor (ctx-byte ctx (+ 3712 i)) (ctx-byte ctx (+ 3648 i)))))))

;; Read-back before the key is declared: open the fresh blob under the same passphrase into ctx 3648..3679 and
;; compare with the seed; 1 only when the tag matched and the seed is identical. The copy is wiped.
(defn verify-seal [ctx]
  (let [d (kdf-run ctx 3328 3360 3456 3520 1024)
        z (ks/aiueos-keyseal-open-with-k (kernel-subregion ctx 8192 3360 16) (kernel-subregion ctx 8192 3392 64)
                                         (kernel-subregion ctx 8192 3648 32) (kernel-subregion ctx 8192 3456 64)
                                         (kernel-subregion ctx 8192 3520 128) (kernel-subregion ctx 8192 4096 4096))
        diff (seed-diff ctx 0 0)
        w (wipe-range ctx 3648 32 0)]
    (if (and (= z 1) (= diff 0)) (+ 1 (* 0 (+ d w))) 0)))

(defn create-confirm [s ctx]
  (let [n (word ctx 95)]
    (if (or (< n 4) (> n 24)) 1
      (let [ok (draw-seed ctx (word ctx 90))
            sk (if (= ok 1) (draw-salt ctx) 0)]
        (if (and (= ok 1) (= sk 1))
          (let [d (derive-and-sign ctx)
                b (copy-salt-blob ctx 0)
                z (seal-key ctx)
                v (verify-seal ctx)
                fp (+ (* 65536 (ctx-byte ctx 1280)) (+ (* 256 (ctx-byte ctx 1281)) (ctx-byte ctx 1282)))]
            (if (and (= v 1) (= d 1))
              (let [st (draft-store/store-key)]
                (do (put-word ctx 97 (if (> st 0) 1 0))
                    (+ (pass-close s ctx (+ 68 (* fp 128)) 1) (* 0 (+ d (+ b z))))))
              (+ (wipe-range ctx 3712 32 0) (+ (wipe-range ctx 3392 64 0) (pass-close s ctx 0 7)))))
          (pass-close s ctx 0 2))))))

;; Unlock: the blob read from the disk at boot (ctx 3392) is opened under the typed passphrase; the tag decides.
;; A wrong passphrase releases nothing (the seed output is wiped), the key stays locked (ctx word 94 = 8); the
;; right one restores the seed, derives the public key and signs the proof again (ctx word 94 = 9).
(defn copy-blob-salt [ctx i]
  (if (>= i 16) 0
    (let [x (put-ctx8 ctx (+ 3360 i) (ctx-byte ctx (+ 3392 i)))]
      (copy-blob-salt ctx (+ i (+ 1 (* 0 x)))))))

;; ADR-0278 step 3: failed attempts are counted in the key record (ctx word 100, word 3 of sector 4): the count is
;; raised and written BEFORE the KDF runs (so cutting the power during a guess does not save the guess), and cleared
;; on success. A wrong passphrase also sets word 2039 bit 15 for the home ("Key: wrong passphrase"); the flag is for
;; the session only. There is no delay yet (a guest time source is not chosen); the counter records, it does not slow.
(defn count-attempt [ctx]
  (do (put-word ctx 100 (+ (word ctx 100) 1)) (draft-store/store-key)))
;; ADR-0278 step 3, the delay: after the 3rd failed attempt each further attempt is refused (not blocked: the desktop
;; keeps running) until a deadline in TSC cycles, 2^30 << (attempts - 3) (the shift is capped at 9). The deadline is
;; ctx words 101 (low 32 bits) and 102 (high 32 bits), RAM only; a boot with 3 or more attempts in the key record
;; sets it from the boot, so a reboot does not skip the wait. A refused attempt is not counted and runs no KDF
;; (ctx word 94 = 15, word 2039 bit 16 = "wait"). The TSC frequency is not known to the guest (not calibrated), so
;; this is a delay in cycles and only about a second per 2^30 cycles at 1 GHz.
(defn penalty-cycles [a]
  (if (< a 3) 0 (i64-shift-left 1073741824 (if (> (- a 3) 9) 9 (- a 3)))))
(defn set-deadline [ctx a]
  (let [p (penalty-cycles a)]
    (if (= p 0)
      (do (put-word ctx 101 0) (put-word ctx 102 0))
      (let [d (+ (kernel-rdtsc) p)]
        (do (put-word ctx 101 (bit-and d 4294967295)) (put-word ctx 102 (quot d 4294967296)))))))
(defn deadline-pending [ctx]
  (let [d (+ (* (word ctx 102) 4294967296) (word ctx 101))]
    (if (and (> d 0) (< (kernel-rdtsc) d)) 1 0)))
(defn set-wait-flag [s on]
  (put-word s 2039 (+ (- (word s 2039) (* 65536 (bit-and (quot (word s 2039) 65536) 1))) (* 65536 on))))
(defn delay-refuse [s ctx]
  (let [r (pass-close s ctx 0 15)
        sf (set-wait-flag s 1)]
    (+ r (* 0 sf))))
(defn clear-attempts [ctx]
  (do (put-word ctx 101 0) (put-word ctx 102 0)
      (if (> (word ctx 100) 0) (do (put-word ctx 100 0) (draft-store/store-key)) 0)))
(defn set-wrong-flag [s on]
  (put-word s 2039 (+ (- (word s 2039) (* 32768 (bit-and (quot (word s 2039) 32768) 1))) (* 32768 on))))

(defn unlock-confirm [s ctx]
  (let [n (word ctx 95)]
    (if (or (< n 4) (> n 24)) 1
     (if (= (deadline-pending ctx) 1) (delay-refuse s ctx)
      (let [ca (count-attempt ctx)
            cs (copy-blob-salt ctx 0)
            d (kdf-run ctx 3328 3360 3456 3520 1024)
            z (ks/aiueos-keyseal-open-with-k (kernel-subregion ctx 8192 3360 16) (kernel-subregion ctx 8192 3392 64)
                                             (kernel-subregion ctx 8192 3712 32) (kernel-subregion ctx 8192 3456 64)
                                             (kernel-subregion ctx 8192 3520 128) (kernel-subregion ctx 8192 4096 4096))]
        (if (= z 1)
          (let [dd (derive-and-sign ctx)
                fp (+ (* 65536 (ctx-byte ctx 1280)) (+ (* 256 (ctx-byte ctx 1281)) (ctx-byte ctx 1282)))
                cl (if (= dd 1) (clear-attempts ctx) 0)
                sf (set-wrong-flag s 0)
                sw (set-wait-flag s 0)]
            (if (= dd 1)
              (do (put-word ctx 96 0)
                  (+ (pass-close s ctx (+ (- 68 128) (* fp 128)) 9) (* 0 (+ cs (+ d (+ dd (+ cl (+ sf (+ sw ca)))))))))
              (+ (wipe-range ctx 3712 32 0) (pass-close s ctx 0 16))))
          (let [w (wipe-range ctx 3712 32 0)
                r (pass-close s ctx 0 8)
                sf (set-wrong-flag s 1)
                sw (set-wait-flag s 0)
                dl (set-deadline ctx (word ctx 100))]
            (+ r (* 0 (+ w (+ sf (+ sw (+ dl ca)))))))))))))

;; ADR-0278 step 2: Forget (F10, only while the key is locked, so the typed length and the fingerprint never share
;; bits). It is a passphrase request of its own kind (ctx word 98 = 2, word 2039 bit 14): the passphrase must open
;; the stored blob (the tag decides) before anything is erased; then sector 4 is zeroed and read back, the blob and
;; the salt leave RAM, and the desktop is as on a first boot without a key (word 94 = 12). A wrong passphrase
;; changes nothing (word 94 = 13); a failed erase keeps the locked key (word 94 = 14).
(defn open-forget-request [s ctx]
  (if (and (= (word ctx 87) 0) (= (word ctx 96) 1) (= (bit-and (quot (word s 2039) 64) 1) 0))
    (do (put-word ctx 87 4) (put-word ctx 95 0) (put-word ctx 98 2)
        (put-word s 2039 (+ (word s 2039) (+ 2147483651 16384))) 1)
    0))

(defn forget-confirm [s ctx]
  (let [n (word ctx 95)]
    (if (or (< n 4) (> n 24)) 1
     (if (= (deadline-pending ctx) 1) (delay-refuse s ctx)
      (let [ca (count-attempt ctx)
            cs (copy-blob-salt ctx 0)
            d (kdf-run ctx 3328 3360 3456 3520 1024)
            z (ks/aiueos-keyseal-open-with-k (kernel-subregion ctx 8192 3360 16) (kernel-subregion ctx 8192 3392 64)
                                             (kernel-subregion ctx 8192 3712 32) (kernel-subregion ctx 8192 3456 64)
                                             (kernel-subregion ctx 8192 3520 128) (kernel-subregion ctx 8192 4096 4096))
            w (wipe-range ctx 3712 32 0)]
        (if (= z 1)
          (let [st (draft-store/erase-key)]
            (if (> st 0)
              (let [w2 (wipe-range ctx 3392 64 0) w3 (wipe-range ctx 3360 16 0) sf (set-wrong-flag s 0) sw (set-wait-flag s 0)]
                (do (put-word ctx 96 0) (put-word ctx 97 0) (put-word ctx 100 0) (put-word ctx 101 0) (put-word ctx 102 0)
                    (+ (pass-close s ctx -128 12) (* 0 (+ cs (+ d (+ w (+ w2 (+ w3 (+ sf (+ sw ca)))))))))))
              (pass-close s ctx 0 14)))
          (let [r (pass-close s ctx 0 13) sf (set-wrong-flag s 1) sw (set-wait-flag s 0) dl (set-deadline ctx (word ctx 100))]
            (+ r (* 0 (+ sf (+ sw (+ dl ca))))))))))))

(defn pass-confirm [s ctx]
  (if (= (word ctx 98) 1) (unlock-confirm s ctx)
    (if (= (word ctx 98) 2) (forget-confirm s ctx) (create-confirm s ctx))))


;; ADR-0278 step 2: Lock (F6). With a key present and stored on the disk (ctx word 97 = 1) it wipes everything
;; secret from RAM (the seed, the public key scratch, the signatures, the signing buffer and the Ed25519/SHA
;; workspace) and returns to the locked state of a boot with a stored key (ctx word 96 = 1, word 2039 = the Allow
;; count and bit 7); ctx word 94 = 11. A key that is not stored would be lost, so Lock refuses it and changes
;; nothing (word 94 = 10). Nothing is written to the disk. It does nothing while a request is open.
(defn lock-wipe [ctx]
  (let [a (wipe-range ctx 3712 32 0) b (wipe-range ctx 1280 128 0) c (wipe-range ctx 2048 1024 0)
        d (wipe-range ctx 3072 64 0) e (wipe-range ctx 3200 64 0) f (wipe-range ctx 4096 4096 0)]
    (+ 1 (* 0 (+ a (+ b (+ c (+ d (+ e f)))))))))

(defn lock-key [s ctx]
  (if (and (= (word ctx 87) 0) (= (bit-and (quot (word s 2039) 64) 1) 1))
    (if (= (word ctx 97) 1)
      (let [w (lock-wipe ctx)
            count (bit-and (quot (word s 2039) 4) 15)]
        (do (put-word s 2039 (+ (* count 4) 128))
            (put-word ctx 96 1) (put-word ctx 94 11)
            (+ 1 (* 0 w))))
      (do (put-word ctx 94 10) 1))
    0))

(defn pass-pending [s code ctx]
  (if (= code 1) (pass-cancel s ctx)
    (if (= code 28) (pass-confirm s ctx)
      (if (= code 14) (pass-back s ctx)
        (if (> (goal-codepoint code) 0) (pass-type s ctx (goal-codepoint code)) 0)))))

(defn allow-pending [s ctx]
  (if (= (word ctx 87) 3) (allow-sign s ctx)
    (if (= (word ctx 87) 4) (pass-confirm s ctx) (allow-key s ctx))))
(defn deny-pending [s ctx]
  (if (= (word ctx 87) 3) (deny-sign s ctx)
    (if (= (word ctx 87) 4) (pass-cancel s ctx) (deny-key s ctx))))

(defn key-pending [s code ctx]
  (if (= (word ctx 87) 4) (pass-pending s code ctx)
    (if (= code 21) (allow-pending s ctx)
      (if (or (= code 49) (= code 1)) (deny-pending s ctx) 0))))


;; AWAI-120 / ADR-0282: Allow on the Itonami local-model request. Profile 4 hands the approved request to the
;; v5 user domain (ctx word 85 ends the desktop loop). The dapps profile (5) has no user domain: it asks the same
;; bounded micro model in place, shows the token in the Itonami title as profile 4's result does, records the run
;; in Murakumo and stays in the loop. Nothing is sent; the dapps profile has no network driver.
(defn allow-model [s ctx]
  (if (>= (word ctx 86) 5)
    (let [token (dapps/local-token s)]
      (do (put-word ctx 87 0) (put-word s 2039 (+ (word s 2039) 3))
          (if (> token 0)
            (do (diagnostic-title s token) (dapps/murakumo-record s ctx token))
            (seed-app-label s 2 0))
          1))
    (do (put-word ctx 87 0) (put-word s 2039 (+ (word s 2039) 3)) (put-word ctx 88 1) (put-word ctx 85 1) 1)))

(defn select-dock [s ctx step]
  (let [old (dock-selection)
        current (if (= old 0) (if (= (word s 2) 0) 1 (word s 2)) old)
        next (+ current step)]
    (do (set-dock-selection (if (and (= old 0) (= (word s 2) 0)) (if (< step 0) 4 1) (if (< next 1) 4 (if (> next 4) 1 next)))) 1)))

(defn activate-dock [s ctx]
  (let [id (dock-selection)]
    (do (set-dock-selection 0)
        (launch-app s id (word ctx 40) (word ctx 41)))))

(defn launch-key [s ctx id]
  (do (set-dock-selection 0) (launch-app s id (word ctx 40) (word ctx 41))))

(defn no-agent-title-codepoint [index]
  ;; The diagnostic card cannot submit a turn. Tell the operator on Enter
  ;; without discarding or pretending to queue the RAM-only draft.
  (case index
    0 32 1 40 2 110 3 111 4 32 5 97 6 103 7 101 8 110 9 116 10 41
    0))

(defn show-no-agent-title [s index]
  (let [codepoint (no-agent-title-codepoint index)]
    (do (put-word s (+ 71 index) codepoint)
        (if (= codepoint 0) 1
          (show-no-agent-title s (+ index 1))))))

(defn reduce-key [s code ctx]
  (if (>= (word ctx 87) 2) (key-pending s code ctx)
  (if (and (>= (word ctx 86) 4) (= (word ctx 87) 1))
    (if (= code 21)
      (allow-model s ctx)
      (if (or (= code 49) (= code 1))
        (do (put-word ctx 87 0) (put-word s 2039 (- (word s 2039) 1)) (seed-app-label s 2 0) 1)
        0))
  (if (= code 61)
    (let [state (kernel-subregion (kernel-desktop-effects) 16384 0 8192)]
      (do (put-word state 50 (- 1 (word state 50))) (put-word state 49 0) 1))
  (if (= code 62) (do (put-word ctx 125 (- 1 (word ctx 125)))
                     (put-word (kernel-subregion (kernel-desktop-effects) 16384 0 8192) 49 0) 1)
  (if (= code 87) (do (put-word ctx 105 (- 1 (word ctx 105))) (audio/stop) 1)
  (if (= code 88) (do (put-word ctx 106 (mod (+ (word ctx 106) 25) 125)) (audio/stop) 1)
  (if (= code 75) (select-dock s ctx -1)
  (if (= code 77) (select-dock s ctx 1)
  (if (= code 59) (do (put-word ctx 99 (- 1 (word ctx 99))) 1)
  (if (and (> (dock-selection) 0) (= code 28)) (activate-dock s ctx)
  (if (and (> (dock-selection) 0) (= code 1)) (do (set-dock-selection 0) 1)
  (if (and (>= (word ctx 86) 4) (= (word s 2) 2)
           (= code 28) (> (word s 2038) 12))
    (do (put-word ctx 87 1) (put-word s 2039 (+ (word s 2039) 1)) (model-confirm-title s 0) 1)
  (if (and (>= (word ctx 86) 5) (= (word s 2) 3) (= code 28))
    (dapps/yataverse-store s ctx)
  (if (and (>= (word ctx 86) 5) (= (word s 2) 4) (= code 28))
    (if (= (dapps/aozora-enter s ctx) 1)
      (do (put-word s 30 1)
          (if (= (open-sign-request s ctx) 1) 1 (do (put-word s 30 0) 0)))
      1)
  (if (and (or (= (word ctx 86) 2) (= (word ctx 86) 3)) (= (word s 2) 2)
           (= code 28) (> (word s 2038) 12))
    (do (put-word ctx 85 1) 1)
  (if (and (= (word ctx 84) 1) (= (word s 2) 2) (= code 63))
    (let [mounted (if (and (= (word ctx 86) 6) (= (state/ready) 0)) (state/provision) 0)
          generation (+ (draft-store/commit s (word ctx 80)) (* 0 mounted))]
      (do (put-word ctx 82 generation)
          (if (> generation 0) (put-word ctx 80 generation) 0)
          1))
  (if (and (= (word s 2) 2)
           (or (= code 14) (> (goal-codepoint code) 0)))
    (let [changed (edit-itonami-goal s code)]
      (if (= changed 1)
        (do (set-dock-selection 0) (put-word ctx 89 0) (seed-app-label s 2 0) 1)
        0))
  (if (and (= (word s 2) 2) (= code 28))
    (do (show-no-agent-title s 0) 1)
  (if (= code 1)
    (close-app s (word s 2))
    (if (= code 15)
      (do (set-dock-selection 0) (cycle-window s))
      (if (= code 2) (launch-key s ctx 1)
        (if (= code 3) (launch-key s ctx 2)
          (if (= code 4) (launch-key s ctx 3)
            (if (= code 5) (launch-key s ctx 4)
              (if (= code 67) (collapse-focused s (word ctx 41))
                (if (= code 60) (minimize-focused s)
                  (if (= code 66) (open-key-request s ctx) (if (= code 65) (open-sign-request s ctx) (if (= code 64) (lock-key s ctx) (if (= code 68) (open-forget-request s ctx) 0)))))))))))))))))))))))))))))))

(defn clamp-coordinate [value extent]
  (if (< value 0) 0
    (if (>= value extent) (- extent 1) value)))

;; ADR-0275 W1: the pointer half of the consent surface. The rectangles are
;; browser_frame2's `consent` geometry (panel 480 x 224 centred; Allow at
;; panel + (24, 164), Deny at panel + (180, 164), both 140 x 36). While a
;; request is pending every press is consumed here, so no window, launcher or
;; dock under the panel can be clicked. Allow and Deny do exactly what Y and
;; N/Esc do.
(defn in-rect [x y rx ry rw rh]
  (and (>= x rx) (< x (+ rx rw)) (>= y ry) (< y (+ ry rh))))

(defn consent-click [s ctx x y]
  (let [px (quot (- (word ctx 40) 480) 2)
        py (quot (- (word ctx 41) 224) 2)]
    (if (in-rect x y (+ px 24) (+ py 164) 140 36)
      (if (>= (word ctx 87) 2) (allow-pending s ctx)
        (allow-model s ctx))
      (if (in-rect x y (+ px 180) (+ py 164) 140 36)
        (if (>= (word ctx 87) 2) (deny-pending s ctx)
          (do (put-word ctx 87 0) (put-word s 2039 (- (word s 2039) 1)) (seed-app-label s 2 0) 1))
        0))))

(defn hit-launcher [x id]
  (let [left (+ 6 (* 102 (- id 1)))]
    (if (and (>= x left) (< x (+ left 96)))
      id
      (if (>= id 4) 0 (hit-launcher x (+ id 1))))))

(defn hit-dock [x y width height id]
  (let [panel-left (quot (- width 184) 2)
        icon-left (+ panel-left 8 (* 44 (- id 1)))
        icon-top (- height 46)]
    (if (and (>= x (- icon-left 4)) (< x (+ icon-left 40))
             (>= y (- icon-top 6)) (< y (- height 6)))
      id
      (if (>= id 4) 0 (hit-dock x y width height (+ id 1))))))

(defn hit-home [s x y width height id]
  (if (or (< width 760) (< height 560) (not (= (word s 2) 0))) 0
    (let [left (+ (quot (- width 704) 2) (* 176 (- id 1)))
          top (quot (- height 240) 2)]
      (if (in-rect x y (- left 4) (- top 6) 168 190) id
        (if (>= id 4) 0 (hit-home s x y width height (+ id 1)))))))

(defn hit-window-index [s x y index]
  (if (< index 0)
    -1
    (let [slot (+ 5 (* index 5))
          wx (word s (+ slot 1))
          wy (word s (+ slot 2))
          ww (word s (+ slot 3))
          wh (word s (+ slot 4))]
      (if (and (< wh 65536) (>= x wx) (< x (+ wx ww))
               (>= y wy) (< y (+ wy wh)))
        index
        (hit-window-index s x y (- index 1))))))

(defn titlebar-drag-id [s x y width height]
  (if (or (< y 28) (>= y (- height 52)))
    0
    (let [index (hit-window-index s x y (- (word s 1) 1))]
      (if (< index 0)
        0
        (let [slot (+ 5 (* index 5))
              id (word s slot)
              wx (word s (+ slot 1))
              wy (word s (+ slot 2))
              ww (word s (+ slot 3))]
          (if (and (< y (+ wy 28))
                   (not (and (> ww 40)
                             (>= x (+ wx (- ww (if (>= ww 80) 64 44))))
                             (< x (+ wx (- ww 8)))
                             (>= y (+ wy 6))
                             (< y (+ wy 22)))))
            id
            0))))))

(defn clamp-between [value minimum maximum]
  (if (< value minimum) minimum
    (if (> value maximum) maximum value)))

(defn move-window-id [s id dx dy width height]
  (let [index (window-index s id 0)]
    (if (< index 0)
      0
      (let [slot (+ 5 (* index 5))
            x (word s (+ slot 1))
            y (word s (+ slot 2))
            window-width (word s (+ slot 3))
            window-height (word s (+ slot 4))]
        (if (>= window-height 65536) 0
        (do (put-word s (+ slot 1)
                      (clamp-between (+ x dx) 0 (- width window-width)))
            (put-word s (+ slot 2)
                      (clamp-between (+ y dy) 28 (- height window-height)))
            1))))))

(defn inertia-step [s ctx]
  (let [state (kernel-subregion (kernel-desktop-effects) 16384 0 8192)
        id (word state 32) age (- (word ctx 111) (word state 33))]
    (if (= id 0) 0
      (if (or (> (word ctx 87) 0) (= (word ctx 99) 1) (= (word ctx 110) 0))
        (put-word state 32 0)
        (let [dx (effects/inertia (- (word state 34) 512) age)
              dy (effects/inertia (- (word state 35) 512) age)]
          (do (move-window-id s id (- dx (- (word state 36) 64))
                              (- dy (- (word state 37) 64))
                              (word ctx 40) (word ctx 41))
              (put-word state 36 (+ dx 64)) (put-word state 37 (+ dy 64))
              (if (>= age 180) (put-word state 32 0) (put-word ctx 103 1))))))))

(defn drag-sample [ctx dx dy]
  (let [state (kernel-subregion (kernel-desktop-effects) 16384 0 8192)
        dt (- (word ctx 111) (word state 38))]
    (do (put-word state 34 (+ 512 (if (and (> dt 0) (< dt 100))
                                  (clamp-between (quot (* dx 1000) dt) -200 200) 0)))
        (put-word state 35 (+ 512 (if (and (> dt 0) (< dt 100))
                                  (clamp-between (quot (* dy 1000) dt) -200 200) 0)))
        (put-word state 38 (word ctx 111)))))

(defn drag-release [ctx]
  (let [state (kernel-subregion (kernel-desktop-effects) 16384 0 8192)
        age (- (word ctx 111) (word state 38))]
    (if (and (> (word ctx 71) 0) (= (word ctx 87) 0) (= (word ctx 99) 0)
             (>= age 0) (< age 180))
      (let [vx (quot (* (- (word state 34) 512) (- 180 age)) 180)
            vy (quot (* (- (word state 35) 512) (- 180 age)) 180)]
        (if (and (= vx 0) (= vy 0)) 0
          (do (put-word state 32 (word ctx 71))
              (put-word state 33 (word ctx 111))
              (put-word state 34 (+ vx 512)) (put-word state 35 (+ vy 512))
              (put-word state 36 64) (put-word state 37 64)))) 0)))

;; Collapse (roll up to the titlebar): the validated minimum window height is 29.
;; Unrolling restores launch-app's height and keeps the window on screen. A
;; click on the control left of close, or F9 (scancode 67), toggles it.
(defn full-height [height]
  (if (> height 600) 560 (- height 72)))

(defn toggle-collapse [s index height]
  (let [slot (+ 5 (* index 5))
        y (word s (+ slot 2))
        h (word s (+ slot 4))]
    (if (= h 29)
      (let [full (full-height height)]
        (do (put-word s (+ slot 4) full)
            (put-word s (+ slot 2) (if (> (+ y full) height) (- height full) y))
            1))
      (do (put-word s (+ slot 4) 29) 1))))

(defn collapse-focused [s height]
  (let [index (window-index s (word s 2) 0)]
    (if (< index 0) 0 (toggle-collapse s index height))))

;; The home's key button (browser_frame2 key-button draws the same rectangle): the action of the Key row, like F8 / F6.
;; Lock refuses a key that is not stored (it would be lost), as F6 does.
(defn key-button-action [s ctx]
  (if (= (bit-and (quot (word s 2039) 64) 1) 1)
    (lock-key s ctx)
    (open-key-request s ctx)))

(defn click-window [s ctx]
  (let [index (hit-window-index s (word ctx 50) (word ctx 51)
                                (- (word s 1) 1))]
    (if (< index 0)
      0
      (let [slot (+ 5 (* index 5))
            id (word s slot)
            x (word ctx 50)
            y (word ctx 51)
            wx (word s (+ slot 1))
            wy (word s (+ slot 2))
            ww (word s (+ slot 3))]
        (if (and (>= ww 80)
                 (>= x (+ wx (- ww 64)))
                 (< x (+ wx (- ww 48)))
                 (>= y (+ wy 6))
                 (< y (+ wy 22)))
          (do (focus-window s index) (minimize-focused s))
        (if (and (> ww 40)
                 (>= x (+ wx (- ww 44)))
                 (< x (+ wx (- ww 28)))
                 (>= y (+ wy 6))
                 (< y (+ wy 22)))
          (toggle-collapse s index (word ctx 41))
          (if (and (> ww 40)
                   (>= x (+ wx (- ww 24)))
                   (< x (+ wx (- ww 8)))
                   (>= y (+ wy 6))
                   (< y (+ wy 22)))
            (close-app s id)
            (if (and (= id 2) (= (word s 2) 2) (> (word s (+ slot 4)) 270) (>= ww 200) (= (word ctx 87) 0)
                     (in-rect x y (+ wx 14) (+ wy 232) 150 26))
              (key-button-action s ctx)
              (if (and (= id 2) (= (word s 2) 2) (> (word s (+ slot 4)) 270) (>= ww 200) (= (word ctx 87) 0)
                       (= (bit-and (quot (word s 2039) 64) 1) 0) (= (bit-and (quot (word s 2039) 128) 1) 1)
                       (in-rect x y (+ wx 174) (+ wy 232) 110 26))
                (open-forget-request s ctx)
                (focus-window s index))))))))))

(defn click-launcher [s ctx]
  (if (< (word ctx 51) 28)
    (let [id (hit-launcher (word ctx 50) 1)]
      (if (> id 0)
        (launch-app s id (word ctx 40) (word ctx 41))
        0))
    (if (>= (word ctx 51) (- (word ctx 41) 52))
      (let [id (hit-dock (word ctx 50) (word ctx 51)
                         (word ctx 40) (word ctx 41) 1)]
        (if (> id 0)
          (launch-app s id (word ctx 40) (word ctx 41))
          (click-window s ctx)))
      (let [id (hit-home s (word ctx 50) (word ctx 51) (word ctx 40) (word ctx 41) 1)]
        (if (> id 0) (launch-app s id (word ctx 40) (word ctx 41))
          (click-window s ctx))))))

(defn apply-mouse-packet [s ctx]
  (let [raw-x (word ctx 65)
        raw-y (word ctx 66)
        dx (if (>= raw-x 128) (- raw-x 256) raw-x)
        dy (if (>= raw-y 128) (- raw-y 256) raw-y)
        old-x (word ctx 50)
        old-y (word ctx 51)
        x (clamp-coordinate (+ old-x dx) (word ctx 40))
        y (clamp-coordinate (- old-y dy) (word ctx 41))
        left (bit-and (word ctx 64) 1)]
    (do (put-word ctx 75 (+ (word ctx 75) 1))
        (set-dock-selection 0)
        (put-word ctx 50 x)
        (put-word ctx 51 y)
        (put-word s 2046 (+ x 1))
        (put-word s 2047 y)
        (if (and (= left 1) (= (word ctx 67) 0))
          (if (> (word ctx 87) 0)
            (consent-click s ctx x y)
            (let [drag-id (titlebar-drag-id s x y (word ctx 40) (word ctx 41))]
              (do (put-word (kernel-subregion (kernel-desktop-effects) 16384 0 8192) 32 0)
                (drag-sample ctx 0 0)
                (put-word ctx 76 (+ (word ctx 76) 1))
                (let [old-focus (word s 2) old-count (word s 1)
                      result (click-launcher s ctx)]
                  (if (or (not (= old-focus (word s 2))) (not (= old-count (word s 1))))
                    (sound-event ctx (if (< (word s 1) old-count) 3 2)) (+ 0 (* 0 result))))
                (put-word ctx 71
                          drag-id))))
          (if (and (= left 1) (> (word ctx 71) 0) (= (word ctx 87) 0))
            (do (drag-sample ctx (- x old-x) (- y old-y))
                (move-window-id s (word ctx 71) (- x old-x) (- y old-y)
                                (word ctx 40) (word ctx 41)))
            (if (= left 0) (do (drag-release ctx) (put-word ctx 71 0)) 0)))
        (put-word ctx 67 left)
        1)))

(defn consume-mouse-byte [s ctx byte]
  (if (= byte 250)
    0
    (if (= (word ctx 63) 0)
      (if (= (bit-and byte 8) 8)
        (do (put-word ctx 64 byte)
            (put-word ctx 63 1)
            0)
        0)
    (if (= (word ctx 63) 1)
      (do (put-word ctx 65 byte)
          (put-word ctx 63 2)
          0)
      (do (put-word ctx 66 byte)
          (put-word ctx 63 0)
          (apply-mouse-packet s ctx))))))

;; USB HID goes through the same desktop reducers as PS/2. Stop a report on
;; a modal transition; other keys in that report cannot approve the new panel.
(defn usb-keys [s ctx d i]
  (if (>= i 8) 0
    (let [code (usb/next-key d i) pending (word ctx 87)]
      (if (= code 0) (usb-keys s ctx d (+ i 1))
        (do (put-word ctx 73 (+ (word ctx 73) 1)) (put-word ctx 77 code)
            (reduce-key s code ctx)
            (if (not (= pending (word ctx 87))) (do (usb/quarantine) 1)
              (+ 1 (usb-keys s ctx d (+ i 1)))))))))
(defn ble-keys [s ctx i]
  (if (>= i 8) 0
    (let [code (hogp/next-key i) pending (word ctx 87)]
      (if (= code 0) (ble-keys s ctx (+ i 1))
        (do (put-word ctx 73 (+ (word ctx 73) 1)) (put-word ctx 77 code)
            (reduce-key s code ctx)
            (if (not (= pending (word ctx 87))) (do (hogp/quarantine) 1)
              (+ 1 (ble-keys s ctx (+ i 1)))))))))
(defn usb-input [s ctx]
  (let [ble-ready (hogp/poll) ble-changed (if (= ble-ready 1) (ble-keys s ctx 2) 0)
        ble-ack (if (= ble-ready 1) (hogp/acknowledge) 0) ready (usb/poll)]
    (if (<= ready 0) ble-changed
      (let [d (- ready 1) kind (usb/report-kind d)
            changed (if (= kind 1) (usb-keys s ctx d 2)
                      (if (and (= kind 2) (>= (usb/report-length d) 3)
                               (= (bit-and (usb/report-byte d 0) 248) 0))
                        (do (put-word ctx 64 (usb/report-byte d 0))
                            (put-word ctx 65 (usb/report-byte d 1))
                            ;; USB positive Y is down; PS/2 positive Y is up.
                            (put-word ctx 66 (mod (- 256 (usb/report-byte d 2)) 256))
                            (apply-mouse-packet s ctx)) 0))]
        (+ changed ble-changed (* 0 (usb/acknowledge d)))))))

(defn poll-input [s ctx]
  (do (put-word ctx 68 (kernel-in-u8 100))
      (if (or (= (word ctx 68) 255) (= (bit-and (word ctx 68) 1) 0))
        0
        (do (put-word ctx 69 (kernel-in-u8 96))
            (if (= (bit-and (word ctx 68) 32) 32)
              (consume-mouse-byte s ctx (word ctx 69))
              (if (or (= (word ctx 69) 0) (>= (word ctx 69) 128))
                0
                (do (put-word ctx 73 (+ (word ctx 73) 1))
                    (put-word ctx 77 (word ctx 69))
                    (put-word (kernel-subregion (kernel-desktop-effects) 16384 0 8192) 32 0)
                    (let [old-focus (word s 2) old-windows (word s 1)
                          old-pending (word ctx 87) old-choice (dock-selection)
                          result (reduce-key s (word ctx 69) ctx)]
                      (if (and (> result 0)
                               (or (not (= old-focus (word s 2)))
                                   (not (= old-windows (word s 1)))
                                   (not (= old-pending (word ctx 87)))
                                   (and (> old-choice 0) (= (dock-selection) 0))))
                        (sound-event ctx (if (or (= (word ctx 69) 1) (= (word ctx 69) 49)) 3 2)) 0)) 1)))))))

(defn wait-controller [remaining]
  (if (= (bit-and (kernel-in-u8 100) 2) 0)
    1
    (if (= remaining 0)
      0
      (wait-controller (- remaining 1)))))

(defn enable-mouse []
  (do (wait-controller 4096)
      (kernel-out-u8 100 168)
      (wait-controller 4096)
      (kernel-out-u8 100 212)
      (wait-controller 4096)
      (kernel-out-u8 96 244)
      0))

(defn discard-queued-input [ctx remaining]
  (if (or (= remaining 0) (= (bit-and (kernel-in-u8 100) 1) 0)) 0
    (let [discarded (kernel-in-u8 96)]
      (do (put-word ctx 63 0)
          (discard-queued-input ctx (- remaining (+ 1 (* 0 discarded))))))))

(defn drain-input [s ctx remaining changed]
  (if (or (= remaining 0) (= (word ctx 85) 1)
          (= (kernel-in-u8 100) 255)
          (= (bit-and (kernel-in-u8 100) 1) 0)) changed
    (let [pending (word ctx 87)
          result (poll-input s ctx)]
      (do (put-word ctx 121 (+ (word ctx 121) 1))
          ;; A newly displayed operation cannot consume the remainder of the
          ;; old hardware batch as its choice. Flush available bytes and draw
          ;; the modal panel before returning to ordinary ingress.
          (if (not (= pending (word ctx 87)))
            (do (discard-queued-input ctx 256) 1)
            (drain-input s ctx (- remaining 1) (if (> result 0) 1 changed)))))))

;; AWAI-119 stage 3: the debug entry polls signed remote commands once per turn
;; and re-announces the boot nonce (KDBG 0xc000) every 4096 turns. A key
;; command is handled exactly as a keyboard make code.
(defn remote-geometry [ctx]
  (+ (word ctx 40) (+ (* (word ctx 41) 65536)
                      (+ (* (word ctx 42) 4294967296) (* (word ctx 43) 281474976710656)))))
(defn remote-step [s font fb fb-bytes ctx]
  (let [r (remote/poll ctx (remote-geometry ctx))]
    (if (= r 1)
      (do (usb/quarantine) (discard-queued-input ctx 256) 0)
    (if (>= r 256)
      (do (put-word ctx 73 (+ (word ctx 73) 1))
          (put-word ctx 77 (- r 256))
          (reduce-key s (- r 256) ctx)
          (present-frame s font fb fb-bytes ctx))
      0))))

;; AWAI-122 stage 1: the debug entry probes the NVMe controller once, read
;; only (native/nvme.kotoba), and reports KDBG 0xc100 result | PCI slot << 16,
;; 0xc101 namespace 1 blocks, 0xc102 log2 block size | VS << 8, 0xc103 the
;; first 8 bytes of LBA 1 ("EFI PART" on a GPT disk), 0xc104..0xc108 the model.
;; AWAI-122 stage 2: then the installed loader on the ESP (native/esp.kotoba):
;; 0xc110 result | path << 8 | FAT type << 16, 0xc111 file size, 0xc112..0xc115
;; its SHA-256 (8 bytes each, in digest order).
;; AWAI-122 stage 3: first the signed-image verifier's self-test (native/update.kotoba):
;; 0xc118 verdict (7 = pass) | the three results << 8. It runs before the probe
;; because the Ed25519 verifier's buffer (context bytes 2048..3071) covers the
;; NVMe and ESP words 600..699.
;; AWAI-122 stage 4: after the ESP report, update/qemu-hook (only under QEMU with
;; the gate's fw_cfg file) installs the self-test fixture and reports 0xc130..
(defn storage-word64 [ctx i] (+ (state/word ctx i) (* (state/word ctx (+ i 1)) 4294967296)))
(defn esp-digest [ctx i]
  (if (>= i 4) 1
    (do (dbg/log (+ 49426 i) (+ (* (state/word ctx (+ 680 (* i 2))) 4294967296) (state/word ctx (+ 681 (* i 2)))))
        (esp-digest ctx (+ i 1)))))
(defn nvme-model [ctx i]
  (if (>= i 5) 1
    (do (dbg/log (+ 49412 i) (storage-word64 ctx (+ 620 (* i 2)))) (nvme-model ctx (+ i 1)))))
(defn nvme-report [ctx]
  (let [t (update/self-test ctx)
        logged (dbg/log 49432 (+ t (* (state/word ctx 189) 256)))
        r (+ (nvme/probe ctx) (* 0 logged))]
    (do (dbg/log 49408 (+ r (* (state/word ctx 601) 65536)))
        (dbg/log 49409 (storage-word64 ctx 607))
        (dbg/log 49410 (+ (state/word ctx 609) (* (state/word ctx 606) 256)))
        (dbg/log 49411 (storage-word64 ctx 630))
        (nvme-model ctx 0)
        (esp/run ctx)
        (dbg/log 49424 (+ (state/word ctx 676) (+ (* (state/word ctx 677) 256) (* (state/word ctx 662) 65536))))
        (dbg/log 49425 (state/word ctx 675))
        (esp-digest ctx 0)
        (if (> (update/qemu-hook ctx) 0) (update/install-report ctx) 0)
        r)))

(defn desktop-loop [s font fb fb-bytes ctx]
  (do (if (= (word ctx 128) 1)
        (do (put-word ctx 129 (+ (word ctx 129) 1))
            (remote-step s font fb fb-bytes ctx)
            (if (= (bit-and (word ctx 129) 4095) 0)
              (do (debug-log ctx 3840 (+ (* (word ctx 79) 4294967296) (word ctx 129)))
                  (dbg/log 49152 (remote/nonce ctx))
                  (dbg/log 49167 (remote/rx-stats ctx))
                  (dbg/log 49166 (dbg/rx-descriptor))) 0)) 0)
      (clock-step ctx)
      (put-word ctx 70 (+ (drain-input s ctx 64 0)
                         (if (= (word ctx 86) 6) (usb-input s ctx) 0)))
      (if (> (word ctx 70) 0)
        (do (if (= (word ctx 117) 0) (put-word ctx 117 (+ (word ctx 111) 1)) 0)
            (present-frame s font fb fb-bytes ctx))
        (if (and (= (word ctx 103) 1) (> (word ctx 110) 0)
                 (>= (word ctx 111) (word ctx 114)))
          (present-frame s font fb fb-bytes ctx) 0))
      (if (= (word ctx 85) 1) 1
        (do (kernel-pause) (desktop-loop s font fb fb-bytes ctx)))))

;; W3a (ADR-0277): which hardware entropy instructions the CPU reports. Word 90 of
;; the context: bit 0 = RDRAND (CPUID.1:ECX bit 30), bit 1 = RDSEED (CPUID.7:EBX
;; bit 18), bit 2 = the CPUID leaf 7 exists. Only availability is read; the
;; compiler has no intrinsic that executes RDRAND/RDSEED yet, so no byte is drawn.
(defn entropy-flags []
  (let [max-leaf (kernel-cpuid-eax 0 0)
        rdrand (if (= (bit-and (kernel-cpuid-ecx 1 0) 1073741824) 0) 0 1)
        leaf7 (if (>= max-leaf 7) 1 0)
        rdseed (if (and (= leaf7 1) (not (= (bit-and (kernel-cpuid-ebx 7 0) 262144) 0))) 1 0)]
    (+ rdrand (+ (* rdseed 2) (* leaf7 4)))))

;; W3a (ADR-0277): one hardware draw, only when CPUID reported RDRAND (flags bit 0);
;; executing it on a CPU without it would raise #UD. Returns the low 32 bits of
;; the 64-bit draw, or 0 when the instruction is absent or kept reporting
;; failure (kernel-rdrand returns 0 then): 0 means "no entropy", never a value.
(defn entropy-draw [flags]
  (if (= (bit-and flags 1) 1)
    (bit-and (kernel-rdrand) 4294967295)
    0))

(defn run-desktop-mode [profile debug]
  (let [boot (kernel-boot-info)
        prefix (kernel-subregion boot 16544 0 160)
        width (kernel-framebuffer-width)
        height (kernel-framebuffer-height)
        stride (kernel-framebuffer-stride)
        pixel-format (kernel-framebuffer-format)
        fb-bytes (* (* stride height) 4)
        font-bytes 524288]
    (if (and (= (load64-boot prefix 8) 6)
             (= (load32-boot prefix 128) width) (> (kernel-read-cr3) 0))
      (let [surface (kernel-browser-surface)
            context (kernel-browser-context)
            font (kernel-native-font)
            ;; Existing fixture entries publish word99 and CID words100..103
            ;; before the desktop starts. Preserve these before UI/effect init.
            probe-marker (word context 99)
            probe-code0 (word context 100) probe-code1 (word context 101)
            probe-code2 (word context 102) probe-code3 (word context 103)]
        (do (put-word context 128 debug)
            (put-word context 129 0)
            (put-word context 131 0)

            (put-word context 42 stride)
            (put-word context 43 pixel-format)
            (put-word context 40 width)
            (put-word context 41 height)
            (put-word64 context 136 (if (= debug 1) (dbg/start) 0))
            (debug-log context 1 (word64 context 136))
            (debug-log context 2 (+ (* width 4294967296) (* height 65536) stride))
            (put-word context 40 width)
            (put-word context 41 height)
            (put-word context 42 stride)
            (put-word context 43 pixel-format)
            (put-word context 45 font-bytes)
            (put-word context 50 40)
            (put-word context 51 40)
            (put-word context 63 0)
            (put-word context 67 0)
            (put-word context 71 0)
            (put-word context 72 0x31545844)
            (put-word context 73 0)
            (put-word context 75 0)
            (put-word context 76 0)
            (put-word context 77 0)
            (put-word context 78 0)
            (put-word context 79 0)
            (put-word context 80 0)
            (put-word context 81 0)
            (put-word context 82 0)
            (put-word context 84 (if (or (= profile 1) (= profile 3) (>= profile 4)) 1 0))
            (put-word context 85 0)
            (put-word context 86 profile)
            (put-word context 87 0)
            (put-word context 88 0)
            (put-word context 89 0)
            (put-word context 99 0)
            (put-word context 100 0)
            (put-word context 90 (entropy-flags))
            (put-word context 91 (entropy-draw (word context 90)))
            (put-word context 92 (entropy-draw (word context 90)))
            (if (= debug 1) (remote/init context (word context 90)) 0)
            (if (= debug 1) (nvme-report context) 0)
            (if (= profile 6) (state/mount 0) 0)
            (clear-surface (kernel-subregion (kernel-desktop-effects) 16384 0 8192) 0)
            ;; Effects words51..55 are observation-only fixture results,
            ;; separate from preferences, motion, blur/cache and audio DMA.
            (let [state (kernel-subregion (kernel-desktop-effects) 16384 0 8192)]
              (do (put-word state 51 probe-marker)
                  (put-word state 52 probe-code0) (put-word state 53 probe-code1)
                  (put-word state 54 probe-code2) (put-word state 55 probe-code3)))
            (put-word (kernel-subregion (kernel-desktop-effects) 16384 0 8192) 0 0x31584645)
            (put-word context 24 0)
            (put-word (kernel-subregion (kernel-desktop-effects) 16384 0 8192) 57 (effects/self-check))
            (put-word context 103 0) (put-word context 104 0)
            (put-word context 105 0) (put-word context 106 25)
            (put-word context 107 0) (put-word context 108 0)
            (put-word context 109 0)
            (put-word context 110 (initialize-clock context 2))
            (debug-log context 3 (word context 110))
            (put-word context 111 1000)
            (save-tsc context (kernel-rdtsc))
            (put-word context 114 0) (put-word context 117 0)
            (put-word context 118 0) (put-word context 119 0)
            (put-word context 120 0) (put-word context 121 0)
            (put-word context 122 0) (put-word context 123 0)
            (put-word context 124 0) (put-word context 125 1)
            (put-word (kernel-subregion (kernel-desktop-effects) 16384 0 8192)
                      1 (blur-self-check surface context))
            (debug-log context 4 0)
            (put-word context 107 (audio/initialize))
            (debug-log context 5 (word context 107))
            (enable-mouse)
            (debug-log context 6 (kernel-in-u8 100))
            (if (= profile 6) (do (put-word context 138 (usb/start))
                                  (put-word context 139 (usb/self-check))
                                  (debug-log context 49472 (usb/result))
                                  (debug-log context 49473 (usb/devices))
                                  (debug-log context 49474 (usb/diagnostic 0))
                                  (debug-log context 49475 (usb/diagnostic 1))
                                  (debug-log context 49476 (usb/diagnostic 2))
                                  (debug-log context 49477 (usb/diagnostic 3))
                                  (debug-log context 49478 (usb/diagnostic 4))
                                  (debug-log context 49479 (usb/diagnostic 5))
                                  (debug-log context 49480 (usb/diagnostic 6))
                                  (debug-log context 49481 (usb/diagnostic 7))
                                  (usb-controller-logs context 0)
                                  (usb-device-logs context 0)
                                  (usb-hub-logs context 1)
                                  (if (= (word context 128) 1) (usb-inventory-logs context 0 0) 0)) 0)
            (clear-surface surface 0)
            (seed-desktop surface width height)
            (debug-log context 7 0)
            (if (or (= profile 5) (= profile 6)) (dapps/init surface context) 0)
            (if (or (= profile 1) (= profile 3) (>= profile 4))
              (let [generation (draft-store/restore surface)]
                (do (put-word surface 229 108)
                    (put-word surface 230 111)
                    (put-word surface 231 99)
                    (put-word surface 232 97)
                    (put-word surface 233 108)
                    (put-word context 81 generation)
                    (if (> generation 0) (put-word context 80 generation) 0)
                    (if (and (= profile 4) (> (word context 89) 0))
                      (diagnostic-title surface (word context 89))
                      0)
                    (if (>= profile 4)
                      (if (= (draft-store/load-key) 1)
                        (do (put-word context 96 1) (put-word context 97 1) (put-word surface 2039 128)
                            (set-deadline context (word context 100)))
                        0)
                      0)))
              0)
            (if (= profile 6) (dapps/refresh surface context) 0)
            (debug-log context 8 (present-frame surface font 0 fb-bytes context))
            (desktop-loop surface font 0 fb-bytes context)))
      (kernel-hlt))))

(defn run-desktop [profile] (run-desktop-mode profile 0))
(defn main [] (run-desktop 0))
(defn debug-main [] (run-desktop-mode 0 1))
(defn workspace-main [] (run-desktop 1))
(defn goal-main [] (run-desktop 2))
(defn goal-draft-main [] (run-desktop 3))
(defn goal-model-main [] (run-desktop 4))
;; AWAI-120 / ADR-0282: the installed itonami dapps, offline (profile 5).
(defn dapps-main [] (run-desktop 5))
(defn input-main [] (run-desktop-mode 6 1))
