(ns aiueos.native.desktop
  (:require [browser.effects :as effects]
            [aiueos.native.audio :as audio]
            [aiueos.browser-frame2 :as browser-frame]
            [aiueos.session.app-catalog :as app-catalog]
            [aiueos.native.draft-store :as draft-store]
            [aiueos.ed25519 :as ed]
            [aiueos.keyseal :as ks]
            [aiueos.native.rtl8168-debug :as dbg]
            [aiueos.native.remote-cmd :as remote]
            [aiueos.native.nvme :as nvme]
            [aiueos.native.nvme-state :as state]
            [aiueos.native.esp :as esp]
            [aiueos.native.update :as update]
            [aiueos.native.dapps :as dapps]
            [aiueos.native.xhci :as usb]
            [aiueos.native.bluetooth-hogp :as hogp])
  (:export [main workspace-main goal-main goal-draft-main goal-model-main
            show-diagnostic-result debug-main dapps-main input-main]))

;; AWAI-119: context word128 is 1 only in the opt-in debug entry; every
;; debug-log is then one RTL8168 broadcast record (tag, value). The default
;; entries never set it and send nothing (W8 idle-silent is unchanged).
;; Because the board's RTL8168 has not yet put a frame on the wire, the debug
;; entry also draws its progress straight into the GOP framebuffer: one 5x5
;; square per drawing op on the bottom row (op index = square index), and
;; the RTL8168 start word (context word130) as 64 squares above it, bit 63
;; first, green = 1, red = 0. No font, material or blur code is involved.
(defn debug-square-row [ctx x y row color]
  (if (>= row 5) 0
    (let [offset (* (+ (* (+ y row) (word ctx 42)) x) 4)
          page (kernel-framebuffer-page (quot offset 4096))]
      (do (kernel-store-u32-4k page 4096 (mod offset 4096) color)
          (if (= (mod (+ offset 4) 4096) 0) 0
            (kernel-store-u32-4k page 4096 (mod (+ offset 4) 4096) color))
          (debug-square-row ctx x y (+ row 1) color)))))

(defn debug-square [ctx x y color column]
  (if (>= column 4) 0
    (do (debug-square-row ctx (+ x column) y 0 color)
        (debug-square ctx x y color (+ column 2)))))

(defn debug-square-at [ctx index row color]
  (let [per-row (quot (- (word ctx 40) 8) 6)
        x (+ 4 (* 6 (mod index per-row)))
        y (- (word ctx 41) (* 8 (+ row 1 (* 2 (quot index per-row)))))]
    (if (and (> per-row 0) (> y 0)) (debug-square ctx x y color 0) 0)))

(defn debug-bits [ctx bit]
  (if (>= bit 64) 0
    (do (debug-square-at ctx bit 1
          (gop-color ctx (if (= (bit-and (u64-shift-right (word64 ctx 136) (- 63 bit)) 1) 1)
                           65280 16711680)))
        (debug-bits ctx (+ bit 1)))))

;; Context words are u32; 64-bit debug values use a low/high pair.
(defn put-word64 [ctx i value]
  (do (put-word ctx i (bit-and value 4294967295))
      (put-word ctx (+ i 1) (bit-and (u64-shift-right value 32) 4294967295))))
(defn word64 [ctx i]
  (bit-or (word ctx i) (i64-shift-left (word ctx (+ i 1)) 32)))

;; The crumb: context words140..171 (physical RW base + WG-CONTEXT + 560),
;; which the --netlog loader reads on the next boot after a watchdog reset.
;; kernel-wbinvd writes it back to DRAM; GOP memory is cleared by the
;; firmware on reset. 0 magic "AIUEKDBG", 1 record count, 2 last tag,
;; 3 last value, 4 RTL8168 start word, 5 op index, 6 frames presented,
;; 7 loop turns.
(defn crumb-put [ctx index value] (put-word64 ctx (+ 140 (* 2 index)) value))

(defn crumb [ctx tag value]
  (if (= (word ctx 128) 0) 0
    (do (put-word ctx 131 (+ (word ctx 131) 1))
        (crumb-put ctx 0 5134741615232239937)
        (crumb-put ctx 1 (word ctx 131))
        (crumb-put ctx 2 tag)
        (crumb-put ctx 3 value)
        (crumb-put ctx 4 (word64 ctx 136))
        (crumb-put ctx 5 (word ctx 30))
        (crumb-put ctx 6 (word ctx 79))
        (crumb-put ctx 7 (word ctx 129))
        (kernel-wbinvd))))

(defn debug-log [ctx tag value]
  (if (= (word ctx 128) 1)
    (do (crumb ctx tag value)
        (if (>= tag 4096)
          (do (debug-square-at ctx (- tag 4096) 0 (gop-color ctx 1118481))
              (if (= tag 4097) (debug-bits ctx 0) 0)) 0)
        (dbg/log tag value)) 0))

(defn usb-port-logs [ctx host port]
  (if (> port (min 16 (bit-and (quot (usb/controller-diagnostic host 1) 16777216) 255))) 1
    (do (debug-log ctx (+ 49664 (+ (* host 32) (* (- port 1) 2))) (usb/port-state host port))
        (debug-log ctx (+ 49665 (+ (* host 32) (* (- port 1) 2))) (usb/port-stage host port))
        (usb-port-logs ctx host (+ port 1)))))
(defn usb-controller-logs [ctx host]
  (if (>= host (usb/attempts)) 1
    (do (debug-log ctx (+ 49488 (* host 2)) (usb/controller-diagnostic host 6))
        (debug-log ctx (+ 49489 (* host 2)) (usb/controller-diagnostic host 7))
        (usb-port-logs ctx host 1) (usb-controller-logs ctx (+ host 1)))))
;; c280 + host*32: BDF, eight public capability fields, then sixteen
;; read-only PORTSC values. Unavailable fields are all ones; no report bytes.
(defn usb-inventory-fields [ctx slot host field]
  (if (>= field 24) 1
    (do (debug-log ctx (+ 49793 (+ (* host 32) field)) (usb/inventory slot field))
        (usb-inventory-fields ctx slot host (+ field 1)))))
(defn usb-inventory-logs [ctx from host]
  (if (>= host 8) 1
    (let [slot (usb/next-controller from)]
      (if (< slot 0) 1
        (do (debug-log ctx (+ 49792 (* host 32)) slot)
            (usb-inventory-fields ctx slot host 0)
            (usb-inventory-logs ctx (+ slot 1) (+ host 1)))))))
(defn usb-device-logs [ctx d]
  (if (>= d 3) 1
    (do (debug-log ctx (+ 49504 (* d 4)) (usb/device-diagnostic d 0))
        (debug-log ctx (+ 49505 (* d 4)) (usb/device-diagnostic d 1))
        (debug-log ctx (+ 49506 (* d 4)) (usb/device-diagnostic d 2))
        (debug-log ctx (+ 49507 (* d 4)) (usb/device-diagnostic d 3))
        (usb-device-logs ctx (+ d 1)))))
(defn usb-hub-logs [ctx port]
  (if (> port (usb/hub-ports)) 1
    (do (debug-log ctx (+ 49760 (* (- port 1) 2)) (usb/hub-port-state port))
        (debug-log ctx (+ 49761 (* (- port 1) 2)) (usb/hub-port-stage port))
        (usb-hub-logs ctx (+ port 1)))))

;; Guest-specific desktop adapter. The hosted AIUEOS session uses the actual
;; browser.surface + cssom.layout pipeline; this module currently consumes the
;; separate aiueos.browser-frame2 behavior mirror because the Amu selfhost
;; module graph cannot yet link Browser's cssom.layout dependency. It supplies
;; the framebuffer raster pass and input loop in Kotoba.

(defn load64-boot [boot offset]
  (+ (kernel-load-u8 boot 160 offset)
     (* (kernel-load-u8 boot 160 (+ offset 1)) 256)
     (* (kernel-load-u8 boot 160 (+ offset 2)) 65536)
     (* (kernel-load-u8 boot 160 (+ offset 3)) 16777216)
     (* (kernel-load-u8 boot 160 (+ offset 4)) 4294967296)
     (* (kernel-load-u8 boot 160 (+ offset 5)) 1099511627776)
     (* (kernel-load-u8 boot 160 (+ offset 6)) 281474976710656)
     (* (kernel-load-u8 boot 160 (+ offset 7)) 72057594037927936)))

(defn load32-boot [boot offset]
  (+ (kernel-load-u8 boot 160 offset)
     (* (kernel-load-u8 boot 160 (+ offset 1)) 256)
     (* (kernel-load-u8 boot 160 (+ offset 2)) 65536)
     (* (kernel-load-u8 boot 160 (+ offset 3)) 16777216)))

(defn word [region i]
  (kernel-load-u32 (kernel-subregion region 8192 (* i 4) 4) 4 0))

(defn put-word [region i value]
  (kernel-store-u32 (kernel-subregion region 8192 (* i 4) 4) 4 0 value))

(defn dock-selection []
  (word (kernel-subregion (kernel-desktop-effects) 16384 0 8192) 29))
(defn set-dock-selection [value]
  (put-word (kernel-subregion (kernel-desktop-effects) 16384 0 8192) 29 value))

(defn clear-surface [s index]
  (if (>= index 2048)
    0
    (do (put-word s index 0)
        (clear-surface s (+ index 1)))))

;; Effects metadata uses ONLY context words 102..127 (bytes 408..511).
;; The draft store owns bytes 512..2559 and key state owns bytes 2560..4095.
;; 101/102 belong to the key-attempt deadline; effects words56/57 hold the
;; renderer error and shared-effects self-check. Context 103 is active,
;; 104 discontinuities, 105 mute, 106 volume,
;; 107 audio readiness, 108 last semantic event, 109 event count;
;; 110 ticks/ms (0=refused), 111 ms, 112/113 last TSC, 114 frame deadline,
;; 115/116 frame start/duration, 117 input time+1, 118 max input-to-present,
;; 119 timed frames, 120 missed deadlines, 121 input bytes drained,
;; 122 max frame ms, 123 blur rows, 124 over-budget blur ops, 125 blur switch,
;; 126/127 calibration samples. The separate guarded 16KiB desktop-effects
;; region owns motion state, immutable blur rows and audio DMA. It is entirely
;; disjoint from the Browser/IME surface, draft store, key state and crypto.
;; First 8KiB: metadata/channels, retained-list cache and blur scratch.
;; Second 8KiB: finite audio DMA followed by the retained-list cache tail.
(defn tsc-value [ctx]
  (+ (word ctx 112) (* (word ctx 113) 4294967296)))

(defn save-tsc [ctx now]
  (do (put-word ctx 112 (bit-and now 4294967295))
      (put-word ctx 113 (quot now 4294967296))))

(defn pit-wait [remaining]
  (if (= (bit-and (kernel-in-u8 97) 32) 32) 1
    (if (= remaining 0) 0
      (do (kernel-pause) (pit-wait (- remaining 1))))))

(defn calibrate-clock []
  ;; PIT channel 2, mode 0, speaker disabled; 23864 / 1193182 ~= 20 ms.
  ;; Its independently advancing output calibrates TSC. Never label raw TSC ms.
  (let [saved (kernel-in-u8 97)
        gate-low (kernel-out-u8 97 (bit-and saved 252))
        mode (kernel-out-u8 67 176)
        lo (kernel-out-u8 66 56)
        hi (kernel-out-u8 66 93)
        start (kernel-rdtsc)
        gate-high (kernel-out-u8 97 (+ (bit-and saved 252) 1))
        ready (pit-wait 20000000)
        latched (kernel-out-u8 67 128)
        finish (kernel-rdtsc)
        count-lo (kernel-in-u8 66)
        count-hi (kernel-in-u8 66)
        ticks (mod (+ 23864 65536 (- 0 (+ count-lo (* count-hi 256)))) 65536)
        restored (kernel-out-u8 97 saved)]
    ;; Count the actual PIT interval, including a late poll. Dividing by a
    ;; nominal20ms mislabeled host-preemption delay as a changed TSC rate.
    ;; Refuse ambiguous/overlong intervals and retry independently at boot.
    (if (and (= ready 1) (> finish start) (>= ticks 23864) (< ticks 60000))
      (+ (quot (* (- finish start) 1193182) (* ticks 1000))
         (* 0 (+ gate-low mode lo hi gate-high latched restored))) 0)))

(defn initialize-clock [ctx attempts]
  (let [a (calibrate-clock) b (calibrate-clock)
        difference (if (> a b) (- a b) (- b a))]
    (do (put-word ctx 126 a) (put-word ctx 127 b)
        (if (and (> a 1000) (< a 100000000) (> b 1000)
                 (< (* difference 100) (* a 5))) (quot (+ a b) 2)
          (if (> attempts 0) (initialize-clock ctx (- attempts 1)) 0)))))

(defn clock-step [ctx]
  (let [now (kernel-rdtsc)
        before (tsc-value ctx)
        scale (word ctx 110)
        elapsed (if (and (> scale 0) (>= now before)) (quot (- now before) scale) 0)]
    (if (or (< now before) (> elapsed 1000))
      (do (save-tsc ctx now)
          (put-word ctx 104 (+ (word ctx 104) 1))
          ;; Settle motions after a discontinuity; never replay missed frames.
          (put-word ctx 111 (+ (word ctx 111) (if (> elapsed 1000) elapsed 1000))) 1)
      (if (> elapsed 0)
        (do (save-tsc ctx (+ before (* elapsed scale)))
            (put-word ctx 111 (+ (word ctx 111) elapsed)) 1) 0))))

(defn sound-event [ctx event]
  ;; Semantic events never grant authority. The native adapter emits a finite
  ;; local PCM buffer only when its identified device is ready; else silence.
  (if (or (= (word ctx 105) 1) (= (word ctx 106) 0)) 0
    (do (put-word ctx 108 event) (put-word ctx 109 (+ (word ctx 109) 1))
        (audio/play event (word ctx 106) (word ctx 105)))))

(defn motion-target [s ctx k]
  (let [left (+ (quot (- (word ctx 40) 184) 2) 8 (* 44 (- k 1)))
        home-x (+ (quot (- (word ctx 40) 704) 2) (* 176 (- k 1)))
        x (word ctx 50) y (word ctx 51)
        chosen (if (> (dock-selection) 0) (if (= (dock-selection) k) 1 0)
                 (if (or (and (>= x (- left 4)) (< x (+ left 40))
                              (>= y (- (word ctx 41) 52)) (< y (word ctx 41)))
                         (and (= (word s 2) 0) (>= (word ctx 40) 760)
                              (>= (word ctx 41) 560)
                              (>= x (- home-x 4)) (< x (+ home-x 164))
                              (>= y (- (quot (- (word ctx 41) 240) 2) 6))
                              (< y (+ (quot (- (word ctx 41) 240) 2) 184)))) 1 0))]
    (if (> (word ctx 87) 0) 0
      (if (= chosen 1) (if (= (word ctx 67) 1) 384 1024) 0))))

(defn motion-channels [s ctx k]
  (if (> k 4) 0
    (let [state (kernel-subregion (kernel-desktop-effects) 16384 0 8192)
          slot (+ 128 (* (- k 1) 6))
          semantic (motion-target s ctx k)
          target (if (= (word ctx 99) 1) 0 semantic)
          changed (not (= target (word state (+ slot 1))))
          elapsed (- (word ctx 111) (word state (+ slot 2)))
          prior (effects/spring (word state slot) (word state (+ slot 1)) elapsed 0)
          old (if (< prior 0) 0 (if (> prior 1152) 1152 prior))]
      (do (if (and (> semantic 0) (= (word state (+ slot 4)) 0))
            (sound-event ctx 1) 0)
          (put-word state (+ slot 4) semantic)
          (if changed
            (do (put-word state slot old) (put-word state (+ slot 1) target)
                (put-word state (+ slot 2) (word ctx 111))
                0) 0)
          (let [age (- (word ctx 111) (word state (+ slot 2)))
                snap (if (or (= (word ctx 99) 1) (> (word ctx 87) 0)
                             (= (word ctx 110) 0)) 1 0)
                raw (effects/spring (word state slot) target age snap)
                value (if (< raw 0) 0 (if (> raw 1152) 1152 raw))]
            (do (if (= snap 1)
                      (do (put-word state slot target)
                          (put-word state (+ slot 2) (- (word ctx 111) 200))) 0)
                (put-word state (+ slot 3) value)
                (if (and (= snap 0) (< age 200) (not (= (word state slot) target)))
                  (put-word ctx 103 1) 0)))
          (motion-channels s ctx (+ k 1))))))

(defn update-effects [s ctx]
  (let [state (kernel-subregion (kernel-desktop-effects) 16384 0 8192)]
    (do (put-word state 24 (word ctx 105)) (put-word state 25 (word ctx 106))
        (put-word state 26 (word ctx 125)) (put-word state 27 (word ctx 99))
        (put-word state 28 (word ctx 107))
        (put-word ctx 103 0) (motion-channels s ctx 1))))

(defn font-u16 [font font-bytes offset]
  (let [chunk-offset (* (quot offset 16384) 16384)
        chunk-length 16384]
    (kernel-load-u16-16k
     (kernel-subregion font 524288 chunk-offset chunk-length)
     chunk-length (- offset chunk-offset))))

;; Previous retained list: exactly 259*24=6216 bytes, split around the fixed
;; blur/audio buffers. First 3072 bytes at effects+1024; remaining 3144 at
;; effects+12800. Audio ends at12800, blur occupies4096..8015. No image growth.
(defn cached-op-word [index]
  (let [offset (if (< index 768) (+ 1024 (* index 4))
                 (+ 12800 (* (- index 768) 4)))]
    (kernel-load-u32 (kernel-subregion (kernel-desktop-effects) 16384 offset 4) 4 0)))

(defn cache-ops [s index end]
  (if (>= index end) 0
    (let [offset (if (< index 768) (+ 1024 (* index 4))
                   (+ 12800 (* (- index 768) 4)))
          stored (kernel-store-u32 (kernel-subregion (kernel-desktop-effects) 16384 offset 4)
                                    4 0 (word s (+ 480 index)))]
      (cache-ops s (+ index (+ 1 (* 0 stored))) end))))

(defn damage-rect [ctx x y w h]
  (do (if (< x (word ctx 20)) (put-word ctx 20 x) 0)
      (if (< y (word ctx 21)) (put-word ctx 21 y) 0)
      (if (> (+ x w) (word ctx 22)) (put-word ctx 22 (+ x w)) 0)
      (if (> (+ y h) (word ctx 23)) (put-word ctx 23 (+ y h)) 0)))

(defn intersects-damage [ctx x y w h]
  (if (and (< x (word ctx 22)) (> (+ x w) (word ctx 20))
           (< y (word ctx 23)) (> (+ y h) (word ctx 21))) 1 0))

(defn op-differs [s index field]
  (if (>= field 6) 0
    (if (not (= (word s (+ 480 (* index 6) field)) (cached-op-word (+ (* index 6) field)))) 1
      (op-differs s index (+ field 1)))))

;; Paired glyphs use op3; their packed widths form one 16px-high damage box.
(defn op-width [kind a b]
  (if (= kind 2) b (if (= kind 3) (+ (bit-and b 255) (quot b 256)) a)))
(defn op-height [kind b] (if (or (= kind 2) (= kind 3)) 16 b))

(defn list-damage [s ctx index old-count]
  (if (and (>= index (word ctx 31)) (>= index old-count)) 0
    (do (if (or (>= index old-count) (>= index (word ctx 31))
                (= (op-differs s index 0) 1))
          (do (if (< index old-count)
                (let [base (* index 6) kind (cached-op-word base)]
                  (damage-rect ctx (cached-op-word (+ base 1)) (cached-op-word (+ base 2))
                    (op-width kind (cached-op-word (+ base 3)) (cached-op-word (+ base 4)))
                    (op-height kind (cached-op-word (+ base 4))))) 0)
              (if (< index (word ctx 31))
                (let [base (+ 480 (* index 6)) kind (word s base)]
                  (damage-rect ctx (word s (+ base 1)) (word s (+ base 2))
                    (op-width kind (word s (+ base 3)) (word s (+ base 4)))
                    (op-height kind (word s (+ base 4))))) 0)) 0)
        (list-damage s ctx (+ index 1) old-count))))

(defn blur-damage-pass [s ctx index]
  (if (>= index (word ctx 31)) 0
    (let [base (+ 480 (* index 6)) kind (word s base)
          x (word s (+ base 1)) y (word s (+ base 2))
          w (word s (+ base 3)) h (word s (+ base 4))]
      (do (if (and (= kind 4) (<= w 192) (<= h 192)
                   (< (quot (word s (+ base 5)) 16777216) 255)
                   (= (word ctx 125) 1)
                   (= (intersects-damage ctx (- x 2) (- y 2) (+ w 4) (+ h 4)) 1))
            (damage-rect ctx (if (< x 2) 0 (- x 2)) (if (< y 2) 0 (- y 2))
                         (+ w (if (< x 2) x 2) 2) (+ h (if (< y 2) y 2) 2)) 0)
          (blur-damage-pass s ctx (+ index 1))))))

(defn close-blur-damage [s ctx remaining]
  (if (= remaining 0)
    ;; Pathological dependency chains use full redraw; never under-invalidate.
    (do (put-word ctx 20 0) (put-word ctx 21 0)
        (put-word ctx 22 (word ctx 40)) (put-word ctx 23 (word ctx 41)))
    (let [a (word ctx 20) b (word ctx 21) c (word ctx 22) d (word ctx 23)]
      (do (blur-damage-pass s ctx 0)
          (if (and (= a (word ctx 20)) (= b (word ctx 21))
                   (= c (word ctx 22)) (= d (word ctx 23))) 0
            (close-blur-damage s ctx (- remaining 1)))))))

(defn frame-damage [s ctx]
  (let [state (kernel-subregion (kernel-desktop-effects) 16384 0 8192)]
    (do (put-word ctx 24 1)
        (if (or (= (word state 49) 0) (= (word state 50) 1))
          (do (put-word ctx 20 0) (put-word ctx 21 0)
              (put-word ctx 22 (word ctx 40)) (put-word ctx 23 (word ctx 41)))
          (do (put-word ctx 20 (word ctx 40)) (put-word ctx 21 (word ctx 41))
              (put-word ctx 22 0) (put-word ctx 23 0)
              (list-damage s ctx 0 (word state 48))
              (close-blur-damage s ctx 8)))
        (if (> (word ctx 22) (word ctx 40)) (put-word ctx 22 (word ctx 40)) 0)
        (if (> (word ctx 23) (word ctx 41)) (put-word ctx 23 (word ctx 41)) 0))))

(defn framebuffer-pixel [fb fb-bytes offset ctx]
  (let [x (mod (quot offset 4) (word ctx 42))
        y (quot (quot offset 4) (word ctx 42))]
    (if (or (= (word ctx 24) 0) (= (intersects-damage ctx x y 1 1) 1))
      (let [page (kernel-framebuffer-page (quot offset 4096))]
        (kernel-store-u32-4k page 4096 (mod offset 4096) (word ctx 6))) 0)))

(defn gop-color [ctx rgb]
  ;; GOP format 0 stores R,G,B bytes; frame2 colours are 0xRRGGBB. Format 1
  ;; stores B,G,R and uses that word directly on little-endian x86.
  (if (= (word ctx 43) 0)
    (+ (bit-and (quot rgb 65536) 255)
       (* (bit-and (quot rgb 256) 255) 256)
       (* (bit-and rgb 255) 65536))
    rgb))

(defn glyph-mask-start [width]
  ;; The font stores 8-pixel glyph rows in the low byte and 16-pixel rows
  ;; across the whole word. Start at the matching most-significant glyph bit.
  (if (= width 8) 128 32768))

;; Work words in the renderer context:
;;   0..9 rectangle cursor/bounds, 10..11 glyph row and mask
;;   30 current op, 31 op count, 32..37 saved op, 40..45 GOP metadata
(defn fill-page-span [page offset end color]
  (if (>= offset end) 0
    (if (and (= (mod offset 8) 0) (<= (+ offset 64) end))
      (let [pair (+ color (* color 4294967296))
            a (kernel-store-u64-4k page 4096 offset pair)
            b (kernel-store-u64-4k page 4096 (+ offset 8) pair)
            c (kernel-store-u64-4k page 4096 (+ offset 16) pair)
            d (kernel-store-u64-4k page 4096 (+ offset 24) pair)
            e (kernel-store-u64-4k page 4096 (+ offset 32) pair)
            f (kernel-store-u64-4k page 4096 (+ offset 40) pair)
            g (kernel-store-u64-4k page 4096 (+ offset 48) pair)
            h (kernel-store-u64-4k page 4096 (+ offset 56) pair)]
        (fill-page-span page (+ offset (+ 64 (* 0 (+ a b c d e f g h)))) end color))
      (let [stored (kernel-store-u32-4k page 4096 offset color)]
        (fill-page-span page (+ offset (+ 4 (* 0 stored))) end color)))))

(defn fill-row [s fb fb-bytes ctx offset]
  (if (>= offset (word ctx 8)) 0
    (let [row (quot offset (* (word ctx 42) 4))
          clipped (= (word ctx 24) 1)
          left (* (+ (* row (word ctx 42)) (word ctx 20)) 4)
          right (* (+ (* row (word ctx 42)) (word ctx 22)) 4)
          first (if (and clipped (< offset left)) left offset)
          last (if (and clipped (< right (word ctx 8))) right (word ctx 8))]
      (if (or (>= first last) (and clipped (or (< row (word ctx 21)) (>= row (word ctx 23))))) 0
        (let [page (kernel-framebuffer-page (quot first 4096))
              limit (* (+ (quot first 4096) 1) 4096)
              end (if (< last limit) last limit)]
          (do (fill-page-span page (mod first 4096) (- end (- limit 4096)) (word ctx 6))
              (fill-row s fb fb-bytes ctx end)))))))

(defn fill-rect [s fb fb-bytes ctx row]
  (if (and (= (word ctx 24) 1) (< row (word ctx 21)))
    (fill-rect s fb fb-bytes ctx (word ctx 21))
    (if (or (>= row (word ctx 9)) (and (= (word ctx 24) 1) (>= row (word ctx 23))))
    0
    (do (put-word ctx 0 row)
        (put-word ctx 8
                  (* (+ (* row (word ctx 42))
                        (word ctx 2) (word ctx 4)) 4))
        (fill-row s fb fb-bytes ctx
                  (* (+ (* row (word ctx 42)) (word ctx 2)) 4))
        (fill-rect s fb fb-bytes ctx (+ row 1))))))

;; Native material ops: rounded solid (3), alpha-tinted glass (4), rounded
;; RGB565 gradient (5), rectangular RGB565 gradient (6). All coordinates and
;; colours come from the retained list. No timer, network or host UI is used.
(defn blend-rgb [under over alpha]
  (+ (* (quot (+ (* (bit-and (quot under 65536) 255) (- 255 alpha))
                  (* (bit-and (quot over 65536) 255) alpha)) 255) 65536)
     (* (quot (+ (* (bit-and (quot under 256) 255) (- 255 alpha))
                  (* (bit-and (quot over 256) 255) alpha)) 255) 256)
     (quot (+ (* (bit-and under 255) (- 255 alpha))
              (* (bit-and over 255) alpha)) 255)))

(defn rgb565 [v]
  (+ (* (quot (* (bit-and (quot v 2048) 31) 255) 31) 65536)
     (* (quot (* (bit-and (quot v 32) 63) 255) 63) 256)
     (quot (* (bit-and v 31) 255) 31)))

(defn corner-inset [radius edge x]
  (if (or (>= edge radius) (>= x radius)) x
    (let [dx (- (- radius 1) x)
          dy (- (- radius 1) edge)]
      (if (<= (+ (* dx dx) (* dy dy)) (* radius radius)) x
        (corner-inset radius edge (+ x 1))))))

(defn blend-page-span [page ctx offset end]
  (if (>= offset end) 0
    (let [under (kernel-load-u32-4k page 4096 offset)
          color (if (and (= (word ctx 19) 1) (= under (word ctx 17)))
                  (word ctx 18) (blend-rgb under (word ctx 6) (word ctx 12)))
          stored (kernel-store-u32-4k page 4096 offset color)]
      (do (put-word ctx 17 under) (put-word ctx 18 color) (put-word ctx 19 1)
          (blend-page-span page ctx (+ offset (+ 4 (* 0 stored))) end)))))

(defn blend-row [ctx offset]
  (if (>= offset (word ctx 8)) 0
    (let [row (quot offset (* (word ctx 42) 4))
          clipped (= (word ctx 24) 1)
          left (* (+ (* row (word ctx 42)) (word ctx 20)) 4)
          right (* (+ (* row (word ctx 42)) (word ctx 22)) 4)
          first (if (and clipped (< offset left)) left offset)
          last (if (and clipped (< right (word ctx 8))) right (word ctx 8))]
      (if (or (>= first last) (and clipped (or (< row (word ctx 21)) (>= row (word ctx 23))))) 0
        (let [page (kernel-framebuffer-page (quot first 4096))
              limit (* (+ (quot first 4096) 1) 4096)
              end (if (< last limit) last limit)]
          (do (blend-page-span page ctx (mod first 4096) (- end (- limit 4096)))
              (blend-row ctx end)))))))

;; Bounded separable 5x5 backdrop blur for navigation/control surfaces <=192px.
;; Five rows retain ORIGINAL horizontal-filtered backdrop pixels. A scanline
;; is replaced only after its future halo row was captured; no output feeds
;; back into a subsequent sample. Viewport edges extend the nearest pixel.
;; Large titlebars keep tint; ctx124 exposes the explicit resource fallback.
(defn bounded-coordinate [v extent]
  (if (< v 0) 0 (if (>= v extent) (- extent 1) v)))

(defn backdrop-pixel [ctx x y]
  (let [px (bounded-coordinate x (word ctx 40))
        py (bounded-coordinate y (word ctx 41))
        offset (* (+ (* py (word ctx 42)) px) 4)
        page (kernel-framebuffer-page (quot offset 4096))]
    (kernel-load-u32-4k page 4096 (mod offset 4096))))

(defn channel-average5 [a b c d e shift]
  (quot (+ (bit-and (quot a shift) 255) (bit-and (quot b shift) 255)
           (bit-and (quot c shift) 255) (bit-and (quot d shift) 255)
           (bit-and (quot e shift) 255)) 5))

(defn average5 [a b c d e]
  (+ (* (channel-average5 a b c d e 65536) 65536)
     (* (channel-average5 a b c d e 256) 256)
     (channel-average5 a b c d e 1)))

(defn capture-blur-row [ctx state source-row ring-row x]
  (if (>= x (word ctx 4)) 0
    (let [px (+ (word ctx 2) x)
          color (average5 (backdrop-pixel ctx (- px 2) source-row)
                          (backdrop-pixel ctx (- px 1) source-row)
                          (backdrop-pixel ctx px source-row)
                          (backdrop-pixel ctx (+ px 1) source-row)
                          (backdrop-pixel ctx (+ px 2) source-row))]
      (do (put-word state (+ 1024 (* ring-row 196) x) color)
          (capture-blur-row ctx state source-row ring-row (+ x 1))))))

(defn seed-blur-rows [ctx index]
  (if (>= index 5) 0
    (do (capture-blur-row ctx (kernel-subregion (kernel-desktop-effects) 16384 0 8192)
                          (+ (word ctx 3) (- index 2)) index 0)
        (seed-blur-rows ctx (+ index 1)))))

(defn blur-row [ctx state row x end]
  (if (>= x end) 0
    (let [index (+ 1024 x)
          under (average5 (word state index) (word state (+ index 196))
                          (word state (+ index 392)) (word state (+ index 588))
                          (word state (+ index 784)))
          offset (* (+ (* row (word ctx 42)) (word ctx 2) x) 4)
          page (kernel-framebuffer-page (quot offset 4096))
          stored (kernel-store-u32-4k page 4096 (mod offset 4096)
                                     (blend-rgb under (word ctx 6) (word ctx 12)))]
      (blur-row ctx state row (+ x (+ 1 (* 0 stored))) end))))

(defn blur-rows [ctx local]
  (if (>= local (word ctx 5)) 0
    (let [bottom (- (- (word ctx 5) 1) local)
          edge (if (< local bottom) local bottom)
          inset (corner-inset (word ctx 13) edge 0)]
      (do (blur-row ctx (kernel-subregion (kernel-desktop-effects) 16384 0 8192)
                    (+ (word ctx 3) local) inset (- (word ctx 4) inset))
          ;; The row about to leave the ring was already sampled. Capture
          ;; y+3 before its framebuffer row can be overwritten by the blur.
          (if (< (+ local 1) (word ctx 5))
            (capture-blur-row ctx (kernel-subregion (kernel-desktop-effects) 16384 0 8192)
                              (+ (word ctx 3) local 3) (mod local 5) 0) 0)
          (put-word ctx 123 (+ (word ctx 123) 1))
          (blur-rows ctx (+ local 1))))))

(defn material-rows [s fb fb-bytes ctx row]
  (if (and (= (word ctx 24) 1) (< row (word ctx 21)))
    (material-rows s fb fb-bytes ctx (word ctx 21))
    (if (or (>= row (word ctx 9)) (and (= (word ctx 24) 1) (>= row (word ctx 23)))) 0
    (let [local (- row (word ctx 3))
          bottom (- (- (word ctx 5) 1) local)
          edge (if (< local bottom) local bottom)
          inset (corner-inset (word ctx 13) edge 0)
          offset (* (+ (* row (word ctx 42)) (+ (word ctx 2) inset)) 4)]
      (do (if (and (= (word ctx 79) 0) (= (bit-and row 15) 0))
            (debug-log ctx (+ 8192 row) (kernel-rdtsc)) 0)
