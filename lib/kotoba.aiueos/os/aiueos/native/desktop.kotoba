            (put-word ctx 6
              (gop-color ctx (blend-rgb (rgb565 (bit-and (word ctx 37) 65535))
                                        (rgb565 (quot (word ctx 37) 65536))
                                        (if (<= (word ctx 5) 1) 0
                                          (quot (* local 255) (- (word ctx 5) 1))))))
            0)
          (put-word ctx 8 (* (+ (* row (word ctx 42))
                               (- (+ (word ctx 2) (word ctx 4)) inset)) 4))
          ;; Exact last-pixel cache: the source tint/alpha is fixed for a row.
          ;; Uniform runs need one blend, with no approximation of text below.
          (put-word ctx 19 0)
          (if (= (word ctx 12) 255) (fill-row s fb fb-bytes ctx offset)
            (blend-row ctx offset))
          (material-rows s fb fb-bytes ctx (+ row 1)))))))

(defn material-rect [s fb fb-bytes ctx]
  (let [rw (quot (word ctx 4) 2)
        rh (quot (word ctx 5) 2)
        radius (if (< rw rh) rw rh)]
    (do (put-word ctx 12 (if (= (word ctx 15) 4) (quot (word ctx 37) 16777216) 255))
        (put-word ctx 13 (if (= (word ctx 15) 6) 0 (if (> radius 12) 12 radius)))
        (if (and (= (word ctx 15) 4) (< (word ctx 12) 255)
                 (= (word ctx 125) 1) (<= (word ctx 4) 192)
                 (<= (word ctx 5) 192) (= (word ctx 87) 0))
          (do (seed-blur-rows ctx 0) (blur-rows ctx 0))
          (do (if (and (= (word ctx 15) 4) (< (word ctx 12) 255)
                       (= (word ctx 125) 1))
                (put-word ctx 124 (+ (word ctx 124) 1)) 0)
              (material-rows s fb fb-bytes ctx (word ctx 3)))))))

(defn blur-test-stripes [s ctx x]
  (if (>= x 80) 0
    (do (put-word ctx 2 x) (put-word ctx 3 0) (put-word ctx 4 1)
        (put-word ctx 5 40) (put-word ctx 9 40)
        (put-word ctx 6 (if (= (mod x 2) 0) 0 16777215))
        (fill-rect s 0 0 ctx 0) (blur-test-stripes s ctx (+ x 1)))))

(defn blur-self-check [s ctx]
  ;; A native pixel oracle against fixed, independently derived values. The
  ;; first regular frame replaces this small boot fixture before desktop use.
  ;; 5x5 black/white stripes -> 102/153; white tint alpha128 -> 178/204.
  (do (blur-test-stripes s ctx 0)
      (put-word ctx 2 8) (put-word ctx 3 4) (put-word ctx 4 64)
      (put-word ctx 5 32) (put-word ctx 15 4)
      (put-word ctx 6 16777215) (put-word ctx 37 0x80ffffff)
      (material-rect s 0 0 ctx)
      (let [a (backdrop-pixel ctx 20 16) b (backdrop-pixel ctx 21 16)
            outside (backdrop-pixel ctx 0 16)]
        (do (put-word ctx 87 1)
            (blur-test-stripes s ctx 0)
            (put-word ctx 2 8) (put-word ctx 3 4) (put-word ctx 4 64)
            (put-word ctx 5 32) (put-word ctx 15 4)
            (put-word ctx 6 16777215) (put-word ctx 37 0x80ffffff)
            (material-rect s 0 0 ctx)
            (let [plain (backdrop-pixel ctx 20 16)]
              (do (put-word ctx 87 0)
                  (if (and (= a 0xb2b2b2) (= b 0xcccccc)
                           (= outside 0) (= plain 0x808080)) 1 0)))))))

(defn paint-glyph-pixels [s font fb fb-bytes ctx]
  (if (>= (word ctx 4) 16)
    0
    (do (if (= (word ctx 5) 0)
          (do (put-word ctx 10
                        (font-u16 font (word ctx 45)
                                  (+ (word ctx 38) (* (word ctx 4) 2))))
              (put-word ctx 11 (glyph-mask-start (word ctx 34))))
          0)
        (if (= (bit-and (quot (word ctx 10) (word ctx 11)) 1) 1)
          (framebuffer-pixel
           fb fb-bytes
           (* (+ (* (+ (word ctx 33) (word ctx 4)) (word ctx 42))
                 (word ctx 32) (word ctx 5)) 4)
           ctx)
          0)
        (if (>= (+ (word ctx 5) 1) (word ctx 34))
          (do (put-word ctx 4 (+ (word ctx 4) 1))
              (put-word ctx 5 0)
              (paint-glyph-pixels s font fb fb-bytes ctx))
          (do (put-word ctx 5 (+ (word ctx 5) 1))
              (put-word ctx 11 (quot (word ctx 11) 2))
              (paint-glyph-pixels s font fb fb-bytes ctx))))))

(defn draw-glyph [s font fb fb-bytes ctx x y gi gw]
  (do (put-word ctx 32 x)
      (put-word ctx 33 y)
      (put-word ctx 34 gw)
      (put-word ctx 38 (+ 16 (* 4 (word s 424)) (* 32 gi)))
      (put-word ctx 4 0)
      (put-word ctx 5 0)
      (put-word ctx 6 (word ctx 36))
      (put-word ctx 11 (glyph-mask-start (word ctx 34)))
      (paint-glyph-pixels s font fb fb-bytes ctx)))

(defn present-ops [s font fb fb-bytes ctx]
  (if (>= (word ctx 30) (word ctx 31))
    0
    (let [slot (+ 480 (* 6 (word ctx 30)))
          kind (word s slot)
          x (word s (+ slot 1))
          y (word s (+ slot 2))
          a (word s (+ slot 3))
          b (word s (+ slot 4))
          rgb (word s (+ slot 5))]
      (do (if (< (word ctx 79) 2)
            (debug-log ctx (+ 4096 (word ctx 30))
                       (+ (* kind 72057594037927936) (* (bit-and x 65535) 1099511627776)
                          (* (bit-and y 65535) 16777216) (bit-and a 16777215))) 0)
          (put-word ctx 32 x)
          (put-word ctx 33 y)
          (put-word ctx 34 a)
          (put-word ctx 35 b)
          (put-word ctx 36 (gop-color ctx (bit-and rgb 16777215)))
          (put-word ctx 37 rgb)
          (if (and (= (word ctx 24) 1)
                   (= (intersects-damage ctx x y (op-width kind a b) (op-height kind b)) 0)) 0
          (if (or (= kind 1) (= kind 7) (and (>= kind 4) (<= kind 6)))
            (do (put-word ctx 2 x)
                (put-word ctx 3 y)
                (put-word ctx 4 a)
                (put-word ctx 5 b)
                (put-word ctx 6 (word ctx 36))
                (put-word ctx 9 (+ y b))
                (if (= kind 1) (fill-rect s fb fb-bytes ctx y)
                  (do (put-word ctx 15 kind) (material-rect s fb fb-bytes ctx))))
            (if (= kind 3)
