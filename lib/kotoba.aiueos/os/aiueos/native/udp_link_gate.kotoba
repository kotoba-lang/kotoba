;; JUN-757: isolated raw-link qualification, not a Kekkai/SSH server.
;; Public fixture10.77.0.1:22088 ->10.77.0.2:22089, exact peer MAC.
;; Echo10 admitted UDP frames through actual NIC descriptors. No app approval,
;; key, socket service or production network authority is introduced.
(ns aiueos.native.udp-link-gate
  (:require [aiueos.native.rtl8139-cplus :as nic] [aiueos.native.ipv4-udp :as udp])
  (:export [run]))
(defn p [i v] (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0 v))
(defn word [i] (kernel-load-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0))
(defn check [yes :bool] :i64 (if yes 1 (do (p 75 (+ (word 75) 1)) 0)))
(defn b [i] (kernel-load-u8-4k (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 1536) 1536 i))
(defn copy-in [i size]
  (if (>= i size) 1
    (do (kernel-store-u8-4k (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 1536) 1536 i (nic/rx-byte i))
        (copy-in (+ i 1) size))))
(defn endpoint? [description]
  (and (> description 0) (= (udp/source-port description) 22088) (= (udp/destination-port description) 22089)
       (= (b 6) 2) (= (b 7) 0) (= (b 8) 0) (= (b 9) 0) (= (b 10) 0) (= (b 11) 1)
       (= (b 26) 10) (= (b 27) 77) (= (b 28) 0) (= (b 29) 1)
       (= (b 30) 10) (= (b 31) 77) (= (b 32) 0) (= (b 33) 2)))
(defn reply-byte [i start]
  (if (< i 6) (b (+ i 6))
    (if (< i 12) (b (- i 6))
      (if (and (>= i 26) (< i 30)) (b (+ i 4))
        (if (and (>= i 30) (< i 34)) (b (- i 4))
          (if (and (>= i start) (< i (+ start 2))) (b (+ i 2))
            (if (and (>= i (+ start 2)) (< i (+ start 4))) (b (- i 2)) (b i))))))))
(defn reply [i size start]
  (if (>= i size) 1 (do (check (= (nic/tx-byte i (reply-byte i start)) 1)) (reply (+ i 1) size start))))
(defn received [size]
  (do (copy-in 0 size)
      (let [description (udp/parse (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 1536) 1536 size)]
        (if (endpoint? description)
          (do (p 85 (udp/payload-offset description)) (p 86 (udp/payload-length description))
              (reply 0 size (- (udp/payload-offset description) 8))
              (if (= (nic/send (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 size) 1)
                (p 78 (+ (word 78) 1)) (do (p 75 (+ (word 75) 1)) (p 79 2))))
          (p 88 (+ (word 88) 1))))
      (nic/release (kernel-subregion (kernel-browser-context) 8192 1024 512) 512)
      (p 84 (+ (word 84) 1))))
(defn canary []
  (and (= (b 1535) 61)
       (= (kernel-load-u8-4k (kernel-subregion (kernel-owned-window 10 16384) 16384 4096 4096) 4096 1514) 71)
       (= (kernel-load-u8-4k (kernel-subregion (kernel-owned-window 10 16384) 16384 12288 4096) 4096 1536) 81)))
(defn park [] (do (kernel-pause) (park)))
(defn poll []
  (if (or (>= (word 78) 10) (= (word 79) 2))
    (do (p 76 (if (= (word 78) 10) 1 0)) (p 77 (if (canary) 1 0)) (p 79 2) (park))
    (let [size (nic/rx-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512)]
      (do (if (> size 0) (do (p 83 (+ (word 83) 1)) (received size))
            (if (< size 0) (do (p 87 (+ (word 87) 1)) (nic/release (kernel-subregion (kernel-browser-context) 8192 1024 512) 512)
                              (p 84 (+ (word 84) 1))) 0))
          (kernel-pause) (poll)))))
(defn run [] :i64
  (do (kernel-cli) (p 74 0) (p 75 0) (p 76 0) (p 77 0) (p 78 0) (p 79 0)
      (p 83 0) (p 84 0) (p 87 0) (p 88 0)
      (if (and (> (kernel-register-value-domain 73) 0) (= (kernel-publish-current-domain 73) 73)
               (= (kernel-value-enable-user) 1) (> (kernel-value-domain-request-page 73) 0))
        (do (kernel-store-u8-4k (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 1536) 1536 1535 61)
            (kernel-store-u8-4k (kernel-subregion (kernel-owned-window 10 16384) 16384 4096 4096) 4096 1514 71)
            (kernel-store-u8-4k (kernel-subregion (kernel-owned-window 10 16384) 16384 12288 4096) 4096 1536 81)
            (p 74 (nic/start (kernel-subregion (kernel-browser-context) 8192 1024 512) 512))
            (check (= (nic/rx-byte -1) -1)) (check (= (nic/rx-byte 1536) -1))
            (check (= (nic/tx-byte -1 0) 0)) (check (= (nic/tx-byte 1514 0) 0)) (check (= (nic/tx-byte 0 256) 0))
            (check (= (nic/send (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 59) 0))
            (check (= (nic/send (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 1515) 0))
            (if (= (word 74) 1) (do (p 79 1) (poll)) (do (p 75 (+ (word 75) 1)) (p 79 2) (park))))
        (do (p 75 1) (p 79 2) (park)))))
