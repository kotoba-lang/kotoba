(ns aiueos.native.cid-entry
  (:require [aiueos.native.kernel :as kernel]
            [aiueos.native.desktop :as desktop]
            [aiueos.value-runtime-entry :as runtime]
            [aiueos.value-runtime-syscall-plan :as syscall]
            [aiueos.value-runtime-domain :as domain]
            [aiueos.value-runtime-capability-table :as capability]
            [aiueos.value-runtime-provider-policy :as provider]
            [aiueos.value-runtime-provider-transport :as transport]
            [aiueos.value-runtime-cas-verify :as cas]
            [aiueos.cid-v1-admit :as cid])
  (:export [main aiueos-value-runtime-entry aiueos-value-runtime-syscall-plan
            aiueos-value-runtime-publish-domain aiueos-value-runtime-provider-status
            aiueos-value-runtime-capability-grant aiueos-value-runtime-provider-claim
            aiueos-value-runtime-provider-complete aiueos-value-runtime-cas-verify]))

;; Preserve the actual kernel graph; v3 owns the controlled #UD vector.
(defn legacy-kernel-undefined [v :i64 e :i64 p :i64 s :i64] :i64
  (kernel/aiueos-isr-6 v e p s))
(defn aiueos-value-runtime-entry [a :i64 p :i64 u :i64 r :i64 c :i64] :i64
  (runtime/aiueos-value-runtime-entry a p u r c))
(defn aiueos-value-runtime-syscall-plan [n :i64 d :i64 p :i64 i :i64 s :i64] :i64
  (syscall/aiueos-value-runtime-syscall-plan n d p i s))
(defn aiueos-value-runtime-publish-domain [d :i64] :i64
  (domain/aiueos-value-runtime-publish-domain d))
(defn aiueos-value-runtime-provider-status [g :i64 a :i64] :i64
  (provider/aiueos-value-runtime-provider-status g a))
(defn aiueos-value-runtime-capability-grant [a :i64 s :i64 g :i64 r :i64 o :i64] :i64
  (provider/aiueos-value-runtime-capability-grant a s g r o))
(defn aiueos-value-runtime-provider-claim [] :i64
  (transport/aiueos-value-runtime-provider-claim))
(defn aiueos-value-runtime-provider-complete [t :i64 r :i64 b :i64 n :i64 d :i64] :i64
  (transport/aiueos-value-runtime-provider-complete t r b n d))
(defn aiueos-value-runtime-cas-verify [b :i64 n :i64 e :i64 o :i64 w :i64] :i64
  (cas/aiueos-value-runtime-cas-verify b n e o w))
;; W4 slice (ADR-0275): before the desktop starts, the kernel decides four CID
;; questions with the shipped aiueos.cid-v1-admit and leaves the codes in the
;; browser context for the QEMU gate to read. The block is "abc"; its raw
;; CIDv1 is 01 55 12 20 + sha256("abc"). Codes: 0 admits, 8 digest mismatch,
;; 4 wrong multihash code, 3 codec not permitted. Words 100..103 hold the
;; results and word 99 the marker, written last. Nothing here opens a URL: the
;; desktop has no network and no ipfs:// scheme handler yet.
(defn cid-byte [i]
  (case i 0 1 1 85 2 18 3 32 4 186 5 120 6 22 7 191 8 143 9 1 10 207 11 234 12 65 13 65 14 64 15 222 16 93 17 174 18 34 19 35 20 176 21 3 22 97 23 163 24 150 25 23 26 122 27 156 28 180 29 16 30 255 31 97 32 242 33 0 34 21 35 173 0))

(defn put8 [ctx at v] (kernel-store-u8 (kernel-subregion ctx 8192 at 1) 1 0 v))

(defn fill-cid [ctx i]
  (if (>= i 36) 0
    (let [stored (put8 ctx (+ 512 i) (cid-byte i))]
      (fill-cid ctx (+ i (+ 1 (* 0 stored)))))))

(defn fill-block [ctx last]
  (let [a (put8 ctx 576 97)
        b (put8 ctx 577 98)
        c (put8 ctx 578 last)]
    (+ a (+ b c))))

(defn run-admit [ctx]
  (cid/aiueos-cid-v1-admit (kernel-subregion ctx 8192 512 36) 36
                           (kernel-subregion ctx 8192 576 3) 3
                           (kernel-subregion ctx 8192 640 416)))

(defn put-result [ctx i value]
  (kernel-store-u32 (kernel-subregion ctx 8192 (* i 4) 4) 4 0 value))

(defn cid-selftest []
  (let [ctx (kernel-browser-context)
        filled (fill-cid ctx 0)
        good (fill-block ctx 99)
        r0 (run-admit ctx)
        flipped (fill-block ctx 100)
        r1 (run-admit ctx)
        restored (fill-block ctx 99)
        bad-mh (put8 ctx 514 19)
        r2 (run-admit ctx)
        mh-back (put8 ctx 514 18)
        bad-codec (put8 ctx 513 86)
        r3 (run-admit ctx)
        codec-back (put8 ctx 513 85)
        w0 (put-result ctx 100 r0)
        w1 (put-result ctx 101 r1)
        w2 (put-result ctx 102 r2)
        w3 (put-result ctx 103 r3)]
    (put-result ctx 99 (+ 1128875057 (* 0 (+ filled (+ good (+ flipped (+ restored (+ bad-mh (+ mh-back (+ bad-codec (+ codec-back (+ w0 (+ w1 (+ w2 w3))))))))))))))))

(defn main [] :i64
  ;; CID gate image (ADR-0275 W4 slice): runs the CID self-test, then the goal-model profile. The root explicitly selects the image's private GOP/Browser profile.
  ;; PCI/GOP/font sealing happens before any Kotoba body receives a region.
  (let [width (kernel-framebuffer-width)
        registered (kernel-register-value-domain 73)
        published (kernel-publish-current-domain 73)
        enabled (kernel-value-enable-user)]
    (if (and (> width 0) (> registered 0) (= published 73) (= enabled 1))
      (do (cid-selftest) (desktop/goal-model-main)) 0)))
