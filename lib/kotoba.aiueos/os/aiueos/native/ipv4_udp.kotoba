;; JUN-757: bounded Ethernet-II/IPv4/UDP admission, no IO or authority.
;; parse(frame,actual-capacity,wire-bytes), wire excludes Ethernet FCS.
;; Up to1514 Ethernet bytes /1500 IP bytes. IPv4 options are included in the
;; checksum; fragmented/reserved-flag packets refuse pending reassembly.
;; IPv4 UDP checksum0 is permitted; nonzero checksums cover the pseudoheader.
;; Return0 refuses. Otherwise bits0..7 payload offset,8..23 payload length,
;;24..39 source port,40..55 destination port. This does not authenticate peers.
(ns aiueos.native.ipv4-udp
  (:export [parse payload-offset payload-length source-port destination-port]))
(defn- b [frame capacity i] (kernel-load-u8-64k frame capacity i))
(defn- be [frame capacity i] (+ (* (b frame capacity i) 256) (b frame capacity (+ i 1))))
(defn- fold [sum]
  (if (> sum 65535) (fold (+ (bit-and sum 65535) (u64-shift-right sum 16))) sum))
(defn- sum [frame capacity i end acc]
  (if (>= i end) (fold acc)
    (sum frame capacity (+ i 2) end
      (+ acc (* (b frame capacity i) 256) (if (< (+ i 1) end) (b frame capacity (+ i 1)) 0)))))
(defn- udp [frame capacity header total]
  (and (= (be frame capacity (+ 14 header 4)) (- total header))
       (>= (- total header) 8)
       (or (= (be frame capacity (+ 14 header 6)) 0)
           (= (sum frame capacity (+ 14 header) (+ 14 total)
                (+ (be frame capacity 26) (be frame capacity 28) (be frame capacity 30) (be frame capacity 32) 17 (- total header))) 65535))))
(defn- describe [frame capacity header total]
  (+ (+ 22 header) (* (- total header 8) 256)
     (* (be frame capacity (+ 14 header)) 16777216)
     (* (be frame capacity (+ 14 header 2)) 1099511627776)))
(defn parse [frame capacity bytes]
  (if (and (>= capacity 0) (<= capacity 65536) (>= bytes 42) (<= bytes 1514) (<= bytes capacity))
    (if (and (= (be frame capacity 12) 2048) (= (quot (b frame capacity 14) 16) 4)
             (>= (mod (b frame capacity 14) 16) 5) (> (b frame capacity 22) 0) (= (b frame capacity 23) 17))
      (let [header (* (mod (b frame capacity 14) 16) 4) total (be frame capacity 16)]
        (if (and (>= total (+ header 8)) (<= total 1500) (<= (+ 14 total) bytes)
                 (= (bit-and (be frame capacity 20) 49151) 0)
                 (= (sum frame capacity 14 (+ 14 header) 0) 65535) (udp frame capacity header total))
          (describe frame capacity header total) 0)) 0) 0))
(defn payload-offset [description] (if (<= description 0) -1 (bit-and description 255)))
(defn payload-length [description] (if (<= description 0) -1 (bit-and (u64-shift-right description 8) 65535)))
(defn source-port [description] (if (<= description 0) -1 (bit-and (u64-shift-right description 24) 65535)))
(defn destination-port [description] (if (<= description 0) -1 (bit-and (u64-shift-right description 40) 65535)))
