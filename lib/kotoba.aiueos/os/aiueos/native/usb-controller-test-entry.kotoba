(ns aiueos.native.usb-controller-test-entry
  ;; Native integration fixture: QEMU has an empty first xHCI and a second
  ;; with keyboard/mouse. Exercise the same selection used by signed debug.
  (:require [aiueos.native.xhci :as usb]
            [aiueos.native.bluetooth-hci :as hci]
            [aiueos.native.bluetooth-hogp :as hogp]
            [aiueos.native.hid-mouse :as mouse])
  (:export [main]))
(defn marker [off v]
  (kernel-store-u32-4k (kernel-owned-window 9 4096) 4096 off v))
(defn value [off]
  (kernel-load-u32-4k (kernel-owned-window 9 4096) 4096 off))
(defn bit [ok :bool n :i64] :i64 (if ok n 0))
(defn hex-digit [n] (kernel-out-u8 233 (+ n (if (< n 10) 48 87))))
(defn park [] (do (kernel-hlt) (park)))
(defn protocol-test [] :i64
  ;; Return to the empty host before borrowing unused output contexts. No
  ;; live HID endpoint owns the CPU/Report Map/parser fixture bytes.
  (let [empty (usb/select-controller (usb/next-controller 0))]
    (if (and (= empty 15) (= (usb/devices) 0))
      (do (marker 200 1)
          (let [result (hogp/self-check)] (do (marker 200 0) result))) 0)))
(defn tx-ownership-test [] :i64
  (do (marker 200 1) (marker 212 1) (usb/ble-tx 0 170)
      (let [ready (usb/ble-tx-ready)]
        (do (marker 212 0) (usb/ble-tx 0 187)
            (let [busy (usb/ble-tx-ready)
                  kept (kernel-load-u8-16k (kernel-owned-window 0 16384) 16384 5120)]
              (do (marker 212 1) (usb/ble-tx 0 204)
                  (let [reused (kernel-load-u8-16k (kernel-owned-window 0 16384) 16384 5120)]
                    (do (marker 200 0)
                        (if (and (= ready 1) (= busy 0) (= kept 170) (= reused 204)) 1 0)))))))))
(defn mouse-protocol-test [] :i64
  (do (marker 200 1)
      (let [parsed (mouse/self-check) gated (hogp/mouse-gate-check)]
        (do (marker 200 0)
            (kernel-out-u8 233 77) (kernel-out-u8 233 79) (kernel-out-u8 233 85) (kernel-out-u8 233 83) (kernel-out-u8 233 69)
            (kernel-out-u8 233 32) (hex-digit (bit-and (quot parsed 4096) 15))
            (hex-digit (bit-and (quot parsed 256) 15)) (hex-digit (bit-and (quot parsed 16) 15)) (hex-digit (bit-and parsed 15))
            (kernel-out-u8 233 32) (hex-digit (bit-and (quot gated 16) 15)) (hex-digit (bit-and gated 15)) (kernel-out-u8 233 10)
            (if (and (= parsed 65535) (= gated 255) (= (hogp/transport-check) 63) (= (tx-ownership-test) 1)) 1 0)))))
(defn main [] :i64
  (let [irq (kernel-cli) initial (usb/start) devices (usb/devices)
        first (usb/next-controller 0) second (usb/next-controller (+ first 1))
        a (marker 1536 305419896) b (marker 3584 2271560481)
        bad-range (usb/select-controller 65536) bad-class (usb/select-controller 0)
        kept (usb/devices) empty (usb/select-controller first) empty-count (usb/devices)
        active (usb/select-controller second) active-count (usb/devices)
        bt-refused (usb/probe-bluetooth second) bt-check (usb/bluetooth-diagnostic 8)
        failed (marker 0 8) refused-failed (usb/select-controller first)
        preserved (usb/diagnostic 6) restored (marker 0 15)
        base (+ (bit (= initial 15) 1) (+ (bit (= devices 2) 2)
             (+ (bit (= bad-range -1) 4) (+ (bit (= bad-class -1) 8)
             (+ (bit (= kept 2) 16) (+ (bit (and (= empty 15) (= empty-count 0)) 32)
             (+ (bit (and (= active 15) (= active-count 2)) 64)
             (+ (bit (= (value 1536) 305419896) 128)
                (bit (= (value 3584) 2271560481) 256)))))))))
        legacy (+ base (+ (bit (and (= refused-failed -2) (= preserved second)) 512)
                     (+ (bit (= bt-check 262143) 1024) (+ (bit (= bt-refused 17) 2048)
                     (+ (bit (= (hci/command-complete 0x000000100201440e 70 4098 70) 1) 4096)
                        (bit (= (hci/command-complete 0x000000100201440e 512 4098 512) 0) 8192))))))
        mask (+ legacy (bit (= (protocol-test) 16383) 16384) (bit (= (mouse-protocol-test) 1) 32768)) ]
    (do (kernel-out-u8 233 85) (kernel-out-u8 233 83)
        (kernel-out-u8 233 66) (kernel-out-u8 233 83)
        (kernel-out-u8 233 69) (kernel-out-u8 233 76) (kernel-out-u8 233 32)
        (hex-digit (bit-and (quot mask 4096) 15))
        (hex-digit (bit-and (quot mask 256) 15))
        (hex-digit (bit-and (quot mask 16) 15)) (hex-digit (bit-and mask 15))
        (kernel-out-u8 233 10) (+ (* 0 (+ irq (+ a (+ b (+ failed restored))))) (park)))))
