(ns aiueos.native.audio
  (:require [browser.effects :as effects]
            [capability.dma.map :as dma])
  (:export [initialize play stop]))

;; Bounded Intel 8086:2415 AC97 stereo-output adapter. No capture, IRQ,
;; networking, host beep, asset download or legacy C implementation. Only the
;; exact identified PCI function is written. Absent/failed devices stay silent.
;; Effects bytes8192..12799 own BDL + PCM exclusively. The compositor's
;; retained-list cache begins at12800 and is never part of a DMA descriptor.
(defn get [i]
  (kernel-load-u32 (kernel-subregion (kernel-subregion (kernel-desktop-effects) 16384 0 8192) 8192 (* i 4) 4) 4 0))
(defn put [i v]
  (kernel-store-u32 (kernel-subregion (kernel-subregion (kernel-desktop-effects) 16384 0 8192) 8192 (* i 4) 4) 4 0 v))
(defn config-read [address offset]
  (let [selected (kernel-out-u32 3320 (+ address offset))]
    (+ (kernel-in-u32 3324) (* 0 selected))))
(defn find-device [function]
  (if (>= function 256) 0
    (let [address (+ 2147483648 (* function 256))]
      (if (= (config-read address 0) 0x24158086) address
        (find-device (+ function 1))))))
(defn ready [base remaining]
  (if (= (bit-and (kernel-in-u32 (+ base 48)) 256) 256) 1
    (if (= remaining 0) 0
      (do (kernel-pause) (ready base (- remaining 1))))))
(defn initialize []
  (let [address (find-device 0)]
    (if (= address 0) 0
      (let [a (config-read address 16) b (config-read address 20)
            nam (bit-and a 65532) nabm (bit-and b 65532)]
        (if (and (= (bit-and a 4294901760) 0) (= (bit-and b 4294901760) 0)
                 (= (bit-and a 1) 1) (= (bit-and b 1) 1)
                 (> nam 0) (< nam 64512) (> nabm 0) (< nabm 65280))
          (let [command (config-read address 4)
                selected (kernel-out-u32 3320 (+ address 4))
                enabled (kernel-out-u16 3324 (bit-or (bit-and command 65535) 5))
                reset (kernel-out-u32 (+ nabm 44) 2)
                is-ready (ready nabm 1000000)]
            (if (= is-ready 1)
              (do (kernel-out-u16 nam 0)
                  (kernel-out-u16 (+ nam 2) 0)
                  (kernel-out-u16 (+ nam 24) 0)
                  (kernel-out-u8 (+ nabm 27) 2)
                  (put 16 nam) (put 17 nabm) (put 18 1)
                  (+ 1 (* 0 (+ selected enabled reset)))) 0)) 0)))))

(defn stop []
  (if (= (get 18) 1) (kernel-out-u8 (+ (get 17) 27) 0) 0))

(defn pcm [data event volume frame]
  (if (>= frame 1024) 0
    (let [sample (effects/sample event frame volume 0)
          bits (if (< sample 0) (+ sample 65536) sample)
          stored (kernel-store-u32-4k
                   (kernel-subregion data 8192 512 4096) 4096 (* frame 4)
                   (+ bits (* bits 65536)))]
      (pcm data event volume (+ frame (+ 1 (* 0 stored)))))))

(defn play [event volume muted]
  (if (or (= muted 1) (= volume 0)) (do (stop) 0)
    (if (= (get 18) 0) 0
      (let [base (get 17)]
        (if (= (bit-and (kernel-in-u8 (+ base 22)) 1) 0)
          (do (put 20 (+ (get 20) 1)) 0)
          (let [data (kernel-subregion (kernel-desktop-effects) 16384 8192 8192)
                reset (kernel-out-u8 (+ base 27) 2)
                generated (pcm data event volume 0)
                address (kernel-store-u32 (kernel-subregion data 8192 0 4) 4 0 (+ data 512))
                length (kernel-store-u32 (kernel-subregion data 8192 4 4) 4 0 2048)
                fenced (dma/release-fence)
                bdl (kernel-out-u32 (+ base 16) data)
                status (kernel-out-u16 (+ base 22) 28)
                last (kernel-out-u8 (+ base 21) 0)
                start (kernel-out-u8 (+ base 27) 1)]
            (do (put 19 (+ (get 19) 1))
                (+ 1 (* 0 (+ reset generated address length fenced bdl status last start))))))))))
