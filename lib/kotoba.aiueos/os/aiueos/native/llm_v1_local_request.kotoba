(ns aiueos.native.llm-v1-local-request
  (:require [aiueos.native.llm-v1-request-shape :as request])
  (:export [aiueos-llm-v1-local-request-valid]))

;; Translate the already checked, OS-copied user-v4 Goal into the bounded
;; llm-v1 request shape. All six regions come from one kernel-owned scratch
;; page and are disjoint. This is a local diagnostic model identity, not a
;; provider grant or a general native :llm/generate implementation.
(defn- put-word [page :i64 offset :i64 value :i64] :bool
  (let [written (kernel-store-u32-4k page 4096 offset value)]
    (= (+ (kernel-load-u32-4k page 4096 offset) (* 0 written)) value)))

(defn- put-byte [page :i64 offset :i64 value :i64] :bool
  (let [written (kernel-store-u8-4k page 4096 offset value)]
    (= (+ (kernel-load-u8-4k page 4096 offset) (* 0 written)) value)))

(defn- clear-header [page :i64 offset :i64] :bool
  (if (= offset 64) true
    (and (put-word page offset 0)
         (clear-header page (+ offset 4)))))

(defn- clear-prompt [page :i64 index :i64] :bool
  (if (= index 51) true
    (and (put-byte page (+ 80 index) 0)
         (clear-prompt page (+ index 1)))))

(defn- copy-prompt [source :i64 page :i64 length :i64 index :i64] :bool
  (if (= index length) true
    (and (put-byte page (+ 80 index) (kernel-load-u8 source 104 (+ 12 index)))
         (copy-prompt source page length (+ index 1)))))

(defn aiueos-llm-v1-local-request-valid
  [source :i64 source-bytes :i64 prompt-bytes :i64] :i64
  (if (or (not= source-bytes 104) (< prompt-bytes 1) (> prompt-bytes 51)) 0
    (let [page (kernel-owned-page 0)
          header (kernel-subregion page 4096 0 64)
          model (kernel-subregion page 4096 64 6)
          system (kernel-subregion page 4096 72 0)
          prompt (kernel-subregion page 4096 80 prompt-bytes)
          selected (kernel-subregion page 4096 136 6)
          result (kernel-subregion page 4096 256 64)]
      (if (and (clear-header page 0)
               (put-word page 0 827149387) ; KLM1
               (put-word page 4 1)
               (put-word page 8 11)
               (put-word page 12 6)
               (put-word page 16 0)
               (put-word page 20 prompt-bytes)
               (put-word page 24 1)
               (put-word page 28 0)
               (put-word page 32 (+ 6 prompt-bytes))
               (put-word page 36 64)
               (put-byte page 64 58) (put-byte page 65 108)
               (put-byte page 66 111) (put-byte page 67 99)
               (put-byte page 68 97) (put-byte page 69 108)
               (put-byte page 136 58) (put-byte page 137 108)
               (put-byte page 138 111) (put-byte page 139 99)
               (put-byte page 140 97) (put-byte page 141 108)
               (clear-prompt page 0)
               (copy-prompt source page prompt-bytes 0)
               (= (request/aiueos-llm-v1-request-shape-valid
                    header 64 model 6 system 0 prompt prompt-bytes
                    selected 6 result 64) 1))
        1 0))))
