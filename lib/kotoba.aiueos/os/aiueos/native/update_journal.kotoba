(ns aiueos.native.update-journal
  ;; AWAI-122: privileged, crash-ordered metadata in OSMETA.BIN, disjoint
  ;; from STATE.BIN and EFI images. Marker0, publication1, alternating2/3;
  ;; each512-byte record occupies its own4KiB file page. No boot formatting.
  ;; Only callers that already verified an artifact may prepare its version/
  ;; digest; only callers with real boot-health evidence may confirm it.
  ;; This is not artifact verification, a boot selector, TPM anti-rollback,
  ;; auto-download or a user approval. Those integration gates remain open.
  ;; Borrow draft scratch1536..3583 only while draft/key operations are idle.
  ;; Context212..223 holds offset/status and public release fields; no keys.
  (:require [aiueos.native.esp :as esp]
            [aiueos.native.nvme-state :as io]
            [aiueos.sha256 :as sha])
  (:export [mount load initialize prepare trial confirm rollback policy field]))

(defn w [page at]
  (kernel-load-u32-4k (kernel-subregion (kernel-owned-window 9 4096) 4096 (+ 1536 (* page 512)) 512) 512 at))
(defn p [page at v]
  (kernel-store-u32-4k (kernel-subregion (kernel-owned-window 9 4096) 4096 (+ 1536 (* page 512)) 512) 512 at v))
(defn wide [page at] (+ (w page at) (* (w page (+ at 4)) 4294967296)))
(defn put64 [page at v]
  (do (p page at (bit-and v 4294967295)) (p page (+ at 4) (u64-shift-right v 32))))
(defn c [i]
  (kernel-load-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0))
(defn cp [i v]
  (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0 v))
(defn offset [] (+ (c 212) (* (c 213) 4294967296)))
(defn result [code] (do (cp 214 code) code))
(defn field [i] (if (and (>= i 0) (< i 12)) (c (+ 212 i)) 0))
(defn zero [page i end]
  (if (>= i end) 1 (do (p page i 0) (zero page (+ i 4) end))))
(defn zeros [page i end]
  (if (>= i end) 1 (if (= (w page i) 0) (zeros page (+ i 4) end) 0)))
(defn copy [src dst i end]
  (if (>= i end) 1 (do (p dst i (w src i)) (copy src dst (+ i 4) end))))
(defn equal [a b i end]
  (if (>= i end) 1 (if (= (w a i) (w b i)) (equal a b (+ i 4) end) 0)))
(defn digest-copy [src src-at dst dst-at i]
  (if (>= i 32) 1
    (do (p dst (+ dst-at i) (kernel-load-u32 src 32 (+ src-at i)))
        (digest-copy src src-at dst dst-at (+ i 4)))))
(defn digest-same [digest page at i]
  (if (>= i 32) 1
    (if (= (kernel-load-u32 digest 32 i) (w page (+ at i)))
      (digest-same digest page at (+ i 4)) 0)))
(defn hash [page]
  (sha/aiueos-sha256 (kernel-subregion (kernel-owned-window 9 4096) 4096 (+ 1536 (* page 512)) 480) 480
    (kernel-subregion (kernel-owned-window 9 4096) 4096 (+ 2016 (* page 512)) 32) (kernel-subregion (kernel-owned-window 9 4096) 4096 3072 352) 352))
(defn verified [page]
  (do (copy page 2 0 512)
      (if (= (hash page) 1) (equal page 2 480 512) 0)))
(defn cache []
  (do (cp 215 (w 0 8)) (cp 216 (w 0 16)) (cp 217 (w 0 12))
      (cp 218 (w 0 32)) (cp 219 (w 0 36))
      (cp 220 (w 0 24)) (cp 221 (w 0 28))
      (cp 222 (w 0 40)) (cp 223 (w 0 44))))
(defn version? [v] (and (> v 0) (<= v 9223372036854775807)))
(defn valid []
  (let [r 0 phase (w r 16) active (wide r 24) floor (wide r 32) candidate (wide r 40)]
    (and (= (w r 0) 0x534a534f) (= (w r 4) 1)
         (> (w r 8) 0) (<= (w r 8) 4294967294) (<= (w r 12) 7)
         (version? active) (version? floor) (>= floor active)
         (= (zeros r 48 64) 1) (= (zeros r 128 480) 1)
         (not (= (zeros r 64 96) 1))
         (if (or (= phase 0) (= phase 3))
           (and (= candidate 0) (= (w r 20) 0) (= (zeros r 96 128) 1)
                (if (= phase 3) (> floor active) true))
           (and (or (= phase 1) (= phase 2)) (version? candidate)
                (> candidate active) (= candidate floor)
                (= (w r 20) (- phase 1)) (not (= (zeros r 96 128) 1)))))))
(defn mount [create]
  (let [ctx (kernel-browser-context)
        at (if (= create 1) (esp/create-record-file ctx 6) (esp/record-file ctx 6))]
    (do (cp 212 (bit-and at 4294967295)) (cp 213 (u64-shift-right at 32))
        (if (> at 0) (result 1) (result -70)))))
(defn load []
  (do (cp 215 0)
    (if (<= (offset) 0) (result -70)
      (if (not (= (io/read-at (kernel-subregion (kernel-owned-window 9 4096) 4096 2048 512) 512 0 (offset)) 1)) (result -71)
        (if (not (and (= (w 1 0) 0x5055534f) (= (w 1 4) 0x4154454d)
                      (= (w 1 8) 1) (= (w 1 12) 128) (= (zeros 1 16 512) 1))) (result -72)
          (if (not (= (io/read-at (kernel-subregion (kernel-owned-window 9 4096) 4096 2048 512) 512 1 (offset)) 1)) (result -73)
            (if (= (zeros 1 0 512) 1) (result 0)
              (let [generation (w 1 8) sector (w 1 12)]
                (if (not (and (= (w 1 0) 0x484a534f) (= (w 1 4) 1)
                              (> generation 0) (<= generation 4294967294)
                              (= sector (+ 2 (mod generation 2))) (= (zeros 1 16 480) 1))) (result -74)
                  (if (not (= (io/read-at (kernel-subregion (kernel-owned-window 9 4096) 4096 1536 512) 512 sector (offset)) 1)) (result -75)
                    (if (not (and (= (verified 0) 1) (valid) (= (w 0 8) generation)
                                  (= (equal 0 1 480 512) 1))) (result -76)
                      (do (cache) (result generation)))))))))))))
(defn publish [generation]
  (if (or (<= generation 0) (> generation 4294967294)) (result -77)
    (do (p 0 8 generation)
      (if (not (valid)) (result -78)
        (if (not (= (hash 0) 1)) (result -79)
          (let [sector (+ 2 (mod generation 2)) saved (copy 0 2 0 512)]
            (if (not (= (io/write-at (kernel-subregion (kernel-owned-window 9 4096) 4096 1536 512) 512 sector (offset)) 1)) (result -80)
              (if (not (= (io/read-at (kernel-subregion (kernel-owned-window 9 4096) 4096 1536 512) 512 sector (offset)) 1)) (result -81)
                (if (not (= (+ (equal 0 2 0 512) (* saved 0)) 1)) (result -82)
                  (do (zero 1 0 512) (p 1 0 0x484a534f) (p 1 4 1)
                      (p 1 8 generation) (p 1 12 sector) (copy 0 1 480 512)
                      (copy 1 2 0 512)
                      (if (not (= (io/write-at (kernel-subregion (kernel-owned-window 9 4096) 4096 2048 512) 512 1 (offset)) 1)) (result -83)
                        (if (not (= (io/read-at (kernel-subregion (kernel-owned-window 9 4096) 4096 2048 512) 512 1 (offset)) 1)) (result -84)
                          (if (= (equal 1 2 0 512) 1)
                            (do (cache) (result generation)) (result -85))))))))))))))
(defn initialize [floor version flags digest]
  (let [current (load)]
    (if (or (not (= current 0)) (not (version? floor)) (not (version? version))
            (< floor version) (< flags 0) (> flags 7)) (result -86)
      (do (zero 0 0 512) (p 0 0 0x534a534f) (p 0 4 1)
          (p 0 12 flags) (put64 0 24 version) (put64 0 32 floor)
          (digest-copy digest 0 0 64 0) (publish 1)))))
(defn prepare [version digest]
  (let [current (load)]
    (if (<= current 0) current
      (if (or (not (or (= (w 0 16) 0) (= (w 0 16) 3)))
              (not (version? version)) (<= version (wide 0 32))) (result -87)
        (do (p 0 16 1) (put64 0 32 version) (put64 0 40 version)
            (digest-copy digest 0 0 96 0) (publish (+ current 1)))))))
(defn trial []
  (let [current (load)]
    (if (<= current 0) current
      (if (not (= (w 0 16) 1)) (result -88)
        (do (p 0 16 2) (p 0 20 1) (publish (+ current 1)))))))
(defn confirm [version digest]
  (let [current (load)]
    (if (<= current 0) current
      (if (not (and (= (w 0 16) 2) (= version (wide 0 40))
                    (= (digest-same digest 0 96 0) 1))) (result -89)
        (do (put64 0 24 version) (digest-copy digest 0 0 64 0)
            (p 0 16 0) (p 0 20 0) (put64 0 40 0)
            (zero 0 96 128) (publish (+ current 1)))))))
(defn rollback []
  (let [current (load)]
    (if (<= current 0) current
      (if (not (= (w 0 16) 2)) (result -90)
        (do (p 0 16 3) (p 0 20 0) (put64 0 40 0)
            (zero 0 96 128) (publish (+ current 1)))))))
(defn policy [flags]
  (let [current (load)]
    (if (<= current 0) current
      (if (or (< flags 0) (> flags 7)) (result -91)
        (do (p 0 12 flags) (publish (+ current 1)))))))
