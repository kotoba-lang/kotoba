(ns aiueos.native.mldsa-sample-entry
  (:require [aiueos.native.desktop :as desktop]
            [aiueos.value-runtime-entry :as runtime]
            [aiueos.value-runtime-syscall-plan :as syscall]
            [aiueos.value-runtime-domain :as domain]
            [aiueos.value-runtime-capability-table :as capability]
            [aiueos.value-runtime-provider-policy :as provider]
            [aiueos.value-runtime-provider-transport :as transport]
            [aiueos.value-runtime-cas-verify :as cas]
            [aiueos.mldsa-sample :refer [sm-expand-a sm-sample-in-ball sm-hint-unpack sm-unpack sm-rsub sm-pack]])
  (:export [main aiueos-value-runtime-entry aiueos-value-runtime-syscall-plan
            aiueos-value-runtime-publish-domain aiueos-value-runtime-provider-status
            aiueos-value-runtime-capability-grant aiueos-value-runtime-provider-claim
            aiueos-value-runtime-provider-complete aiueos-value-runtime-cas-verify]))

;; Kernel-v3 owns the controlled fault shim. Keep the actual desktop and
;; eight ValueRuntime exports, without the unused diagnostic kernel graph.
(defn aiueos-value-runtime-entry [a :i64 p :i64 u :i64 r :i64 c :i64] :i64
  (runtime/aiueos-value-runtime-entry a p u r c))
(defn aiueos-value-runtime-syscall-plan [n :i64 d :i64 p :i64 i :i64 s :i64] :i64
  (syscall/aiueos-value-runtime-syscall-plan n d p i s))
(defn aiueos-value-runtime-publish-domain [d :i64] :i64
  (domain/aiueos-value-runtime-publish-domain d))
(defn aiueos-value-runtime-provider-status [g :i64 a :i64] :i64
  (provider/aiueos-value-runtime-provider-status g a))
(defn aiueos-value-runtime-capability-grant [a :i64 s :i64 g :i64 r :i64 o :i64] :i64
  (provider/aiueos-value-runtime-capability-grant a s g r o))
(defn aiueos-value-runtime-provider-claim [] :i64
  (transport/aiueos-value-runtime-provider-claim))
(defn aiueos-value-runtime-provider-complete [t :i64 r :i64 b :i64 n :i64 d :i64] :i64
  (transport/aiueos-value-runtime-provider-complete t r b n d))
(defn aiueos-value-runtime-cas-verify [b :i64 n :i64 e :i64 o :i64 w :i64] :i64
  (cas/aiueos-value-runtime-cas-verify b n e o w))
;; JUN-813 stage 3 (ADR-0286): before the desktop starts the kernel runs the region-based ML-DSA sampling and packing module and leaves
;; the evidence in the browser context. The 4096-byte window is context bytes 4096..8191 (sponge at 0, rho at 512, c-tilde at 544, hint
;; bytes at 640, hint bitmap at 704, polynomial slots 1..3 at 1024 each). Records k = 0..9 are at context byte 1280 + 64 k: eight
;; leading values as u32, then the low and high words of a 40-bit checksum (sum of (i + 1) * v[i]):
;;   0 ExpandA(s 0, r 0) slot 1   1 ExpandA(s 4, r 5) slot 2   2 SampleInBall slot 3   3 unpack 10 bits   4 unpack 20 bits
;;   5 that after rsub 524288     6 unpack 4 bits              7 pack 4 bits (128 bytes at 896)   8 pack 10 bits (320 bytes at 2048)
;;   9 hint bitmap (192 bytes at 704).
;; Record 10 holds four u32 results of sm-hint-unpack: the valid hint bytes (1), and three malformed ones (0).
;; Word 99 is the marker "SM01", written last.
(defn wb [ctx at] (kernel-load-u8-4k (kernel-subregion ctx 8192 4096 4096) 4096 at))
(defn wb! [ctx at v] (kernel-store-u8-4k (kernel-subregion ctx 8192 4096 4096) 4096 at v))
(defn put-u32 [ctx at v] (kernel-store-u32 (kernel-subregion ctx 8192 at 4) 4 0 v))
(defn poly-at [ctx slot i] (kernel-load-u32-4k (kernel-subregion ctx 8192 4096 4096) 4096 (+ (* 1024 slot) (* 4 i))))

(defn fill-rho [ctx i] (if (= i 32) 1 (fill-rho ctx (+ i 1 (* 0 (wb! ctx (+ 512 i) (bit-and (+ (* i 11) 5) 255)))))))
(defn fill-ct [ctx i] (if (= i 48) 1 (fill-ct ctx (+ i 1 (* 0 (wb! ctx (+ 544 i) (bit-and (+ (* i 13) 1) 255)))))))
(defn fill-src [ctx i] (if (= i 640) 1 (fill-src ctx (+ i 1 (* 0 (wb! ctx (+ 3072 i) (bit-and (+ (* i 37) 11) 255)))))))
(defn hint-clear [ctx i] (if (= i 61) 1 (hint-clear ctx (+ i 1 (* 0 (wb! ctx (+ 640 i) 0))))))
;; valid hint bytes: row limits 3 3 4 6 6 8 at 55..60 and positions 3 9 200 | 7 | 8 255 | 0 100; variant 1..3 breaks one rule
(defn hint-set [ctx variant]
  (do (hint-clear ctx 0)
      (wb! ctx 640 3) (wb! ctx 641 9) (wb! ctx 642 200) (wb! ctx 643 7) (wb! ctx 644 8) (wb! ctx 645 255) (wb! ctx 646 0) (wb! ctx 647 100)
      (wb! ctx 695 3) (wb! ctx 696 3) (wb! ctx 697 4) (wb! ctx 698 6) (wb! ctx 699 6) (wb! ctx 700 8)
      (if (= variant 1) (wb! ctx 641 3) 0)
      (if (= variant 2) (wb! ctx 660 1) 0)
      (if (= variant 3) (wb! ctx 697 2) 0)
      1))

(defn csum-poly [ctx slot i acc]
  (if (>= i 256) acc (csum-poly ctx slot (+ i 1) (+ acc (* (+ i 1) (poly-at ctx slot i))))))
(defn csum-bytes [ctx off n i acc]
  (if (>= i n) acc (csum-bytes ctx off n (+ i 1) (+ acc (* (+ i 1) (wb ctx (+ off i)))))))
(defn copy-poly [ctx slot k i]
  (if (>= i 8) 1 (copy-poly ctx slot k (+ i 1 (* 0 (put-u32 ctx (+ (+ 1280 (* 64 k)) (* 4 i)) (poly-at ctx slot i)))))))
(defn copy-bytes [ctx off k i]
  (if (>= i 8) 1 (copy-bytes ctx off k (+ i 1 (* 0 (put-u32 ctx (+ (+ 1280 (* 64 k)) (* 4 i)) (wb ctx (+ off i))))))))
(defn finish-record [ctx k c]
  (let [lo (put-u32 ctx (+ 1280 (+ (* 64 k) 32)) (bit-and c 4294967295))
        hi (put-u32 ctx (+ 1280 (+ (* 64 k) 36)) (u64-shift-right c 32))]
    (+ 1 (* 0 (+ lo hi)))))
(defn record-poly [ctx slot k] (+ (copy-poly ctx slot k 0) (* 0 (finish-record ctx k (csum-poly ctx slot 0 0)))))
(defn record-bytes [ctx off n k] (+ (copy-bytes ctx off k 0) (* 0 (finish-record ctx k (csum-bytes ctx off n 0 0)))))

(defn sample-selftest []
  (let [ctx (kernel-browser-context)
        f1 (fill-rho ctx 0)
        f2 (fill-ct ctx 0)
        a0 (sm-expand-a (kernel-subregion ctx 8192 4096 4096) 4096 1 0 0)
        r0 (record-poly ctx 1 0)
        a1 (sm-expand-a (kernel-subregion ctx 8192 4096 4096) 4096 2 4 5)
        r1 (record-poly ctx 2 1)
        b (sm-sample-in-ball (kernel-subregion ctx 8192 4096 4096) 4096 3)
        r2 (record-poly ctx 3 2)
        f3 (fill-src ctx 0)
        u1 (sm-unpack (kernel-subregion ctx 8192 4096 4096) 4096 3072 10 1)
        r3 (record-poly ctx 1 3)
        u2 (sm-unpack (kernel-subregion ctx 8192 4096 4096) 4096 3072 20 2)
        r4 (record-poly ctx 2 4)
        s2 (sm-rsub (kernel-subregion ctx 8192 4096 4096) 4096 2 524288)
        r5 (record-poly ctx 2 5)
        u3 (sm-unpack (kernel-subregion ctx 8192 4096 4096) 4096 3072 4 1)
        r6 (record-poly ctx 1 6)
        p1 (sm-pack (kernel-subregion ctx 8192 4096 4096) 4096 1 4 896)
        r7 (record-bytes ctx 896 128 7)
        u4 (sm-unpack (kernel-subregion ctx 8192 4096 4096) 4096 3072 10 1)
        p2 (sm-pack (kernel-subregion ctx 8192 4096 4096) 4096 1 10 2048)
        r8 (record-bytes ctx 2048 320 8)
        h0 (hint-set ctx 0)
        hv (sm-hint-unpack (kernel-subregion ctx 8192 4096 4096) 4096)
        r9 (record-bytes ctx 704 192 9)
        h1 (hint-set ctx 1)
        e1 (sm-hint-unpack (kernel-subregion ctx 8192 4096 4096) 4096)
        h2 (hint-set ctx 2)
        e2 (sm-hint-unpack (kernel-subregion ctx 8192 4096 4096) 4096)
        h3 (hint-set ctx 3)
        e3 (sm-hint-unpack (kernel-subregion ctx 8192 4096 4096) 4096)
        w0 (put-u32 ctx 1920 hv)
        w1 (put-u32 ctx 1924 e1)
        w2 (put-u32 ctx 1928 e2)
        w3 (put-u32 ctx 1932 e3)
        ok (+ a0 (+ a1 (+ b (+ u1 (+ u2 (+ s2 (+ u3 (+ p1 (+ u4 p2)))))))))]
    (put-u32 ctx 396 (+ 1397567537 (* 0 (+ f1 (+ f2 (+ f3 (+ ok (+ r0 (+ r1 (+ r2 (+ r3 (+ r4 (+ r5 (+ r6 (+ r7 (+ r8 (+ r9 (+ h0 (+ h1 (+ h2 (+ h3 (+ w0 (+ w1 (+ w2 w3))))))))))))))))))))))))))

(defn main [] :i64
  (let [width (kernel-framebuffer-width)
        registered (kernel-register-value-domain 73)
        published (kernel-publish-current-domain 73)
        enabled (kernel-value-enable-user)]
    (if (and (> width 0) (> registered 0) (= published 73) (= enabled 1))
      (do (sample-selftest) (desktop/goal-model-main)) 0)))
