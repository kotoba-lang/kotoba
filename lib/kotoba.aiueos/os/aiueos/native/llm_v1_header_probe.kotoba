(ns aiueos.native.llm-v1-header-probe
  (:require [aiueos.native.kernel :as kernel]
            [aiueos.native.llm-v1-header :as llm]
            [aiueos.native.llm-v1-request-shape :as request]
            [aiueos.native.llm-v1-result-shape :as completion]
            [aiueos.native.llm-v1-ticket :as ticket])
  (:export [main aiueos-isr-6]))

;; Runs the real header validator in a C-free AIUEOS kernel image. Page 0 is
;; the host-owned test header, page 1 is a 21-word request receipt and page 12
;; is a six-word result receipt. This
;; neither dispatches wire 11 nor executes a model.
(defn- retain-kernel [] :i64 (kernel/main))
(defn aiueos-isr-6 [vector :i64 error :i64 rip :i64 rsp :i64] :i64
  (kernel/aiueos-isr-6 vector error rip rsp))

(defn- put-word [page :i64 offset :i64 value :i64] :bool
  (let [written (kernel-store-u32-4k page 4096 offset value)]
    (= (+ (kernel-load-u32-4k page 4096 offset) (* 0 written)) value)))

(defn- clear-words [page :i64 offset :i64 end :i64] :bool
  (if (= offset end) true
    (and (put-word page offset 0)
         (clear-words page (+ offset 4) end))))

(defn- put-byte [page :i64 offset :i64 value :i64] :bool
  (let [written (kernel-store-u8-4k page 4096 offset value)]
    (= (+ (kernel-load-u8-4k page 4096 offset) (* 0 written)) value)))

(defn- fill-ascii [page :i64 start :i64 end :i64] :bool
  (loop [index start]
    (if (= index end) true
      (if (put-byte page index 97) (recur (+ index 1)) false))))

(defn- initialize-model [model :i64 selected :i64 prompt :i64] :bool
  (and (put-byte model 0 58) (put-byte model 1 108)
       (put-byte model 2 111) (put-byte model 3 99)
       (put-byte model 4 97) (put-byte model 5 108)
       (put-byte selected 0 58) (put-byte selected 1 108)
       (put-byte selected 2 111) (put-byte selected 3 99)
       (put-byte selected 4 97) (put-byte selected 5 108)
       (put-byte prompt 0 104) (put-byte prompt 1 101)
       (put-byte prompt 2 108) (put-byte prompt 3 108)
       (put-byte prompt 4 111)))

(defn- initialize-result [header :i64 text :i64 finish :i64] :bool
  (and (clear-words header 0 64)
       (put-word header 0 827477067)
       (put-word header 4 1)
       (put-word header 8 11)
       (put-word header 12 1)
       (put-word header 16 2)
       (put-word header 20 5)
       (put-word header 24 0)
       (put-word header 28 0)
       (put-word header 32 7)
       (put-word header 40 1)
       (put-word header 48 0)
       (put-word header 52 7)
       (put-byte text 0 111) (put-byte text 1 107)
       (put-byte finish 0 58) (put-byte finish 1 115)
       (put-byte finish 2 116) (put-byte finish 3 111)
       (put-byte finish 4 112)))

(defn- initialize-error [header :i64 code :i64 message :i64] :bool
  (and (put-word header 12 2)
       (put-word header 16 0)
       (put-word header 20 0)
       (put-word header 24 8)
       (put-word header 28 4)
       (put-word header 32 0)
       (put-word header 40 0)
       (put-word header 48 1)
       (put-word header 52 12)
       (put-byte code 0 58) (put-byte code 1 116)
       (put-byte code 2 105) (put-byte code 3 109)
       (put-byte code 4 101) (put-byte code 5 111)
       (put-byte code 6 117) (put-byte code 7 116)
       (put-byte message 0 98) (put-byte message 1 117)
       (put-byte message 2 115) (put-byte message 3 121)))

(defn- initialize-header [header :i64] :bool
  (and (clear-words header 0 64)
       (put-word header 0 827149387)
       (put-word header 4 1)
       (put-word header 8 11)
       (put-word header 12 6)
       (put-word header 16 0)
       (put-word header 20 5)
       (put-word header 24 16)
       (put-word header 28 0)
       (put-word header 32 11)
       (put-word header 36 64)))

(defn- header-valid [header :i64] :i64
  (llm/aiueos-llm-v1-header-valid
   (kernel-subregion header 4096 0 64) 64))

;; The wire field carries the keyword's full printed bytes, including ':'.
;; 512 bytes are admitted and 513 are refused; missing ':' also refuses.
(defn- model-keyword-boundary
  [header :i64 model :i64 selected :i64 system :i64
   prompt :i64 result :i64] :bool
  (and (fill-ascii model 6 513) (fill-ascii selected 6 513)
       (put-word header 12 512) (put-word header 32 517)
       (= (request/aiueos-llm-v1-request-shape-valid
            (kernel-subregion header 4096 0 64) 64
            (kernel-subregion model 4096 0 512) 512
            (kernel-subregion system 4096 0 0) 0
            (kernel-subregion prompt 4096 0 5) 5
            (kernel-subregion selected 4096 0 512) 512
            (kernel-subregion result 4096 0 64) 64) 1)
       (put-byte model 512 97) (put-byte selected 512 97)
       (put-word header 12 513) (put-word header 32 518)
       (= (header-valid header) 0)
       (put-word header 12 6) (put-word header 32 11)
       (put-byte model 0 120)
       (= (request/aiueos-llm-v1-request-shape-valid
            (kernel-subregion header 4096 0 64) 64
            (kernel-subregion model 4096 0 6) 6
            (kernel-subregion system 4096 0 0) 0
            (kernel-subregion prompt 4096 0 5) 5
            (kernel-subregion selected 4096 0 6) 6
            (kernel-subregion result 4096 0 64) 64) 0)
       (put-byte model 0 58)
       (put-word header 12 1) (put-word header 32 6)
       (= (header-valid header) 0)
       (put-word header 12 6) (put-word header 32 11)))

(defn- finish-keyword-boundary
  [result-header :i64 request-header :i64 text :i64 finish :i64
   code :i64 message :i64] :bool
  (and (fill-ascii finish 5 513)
       (put-word result-header 20 512) (put-word result-header 52 514)
       (= (completion/aiueos-llm-v1-result-shape-valid
            (kernel-subregion result-header 4096 0 64) 64
            (kernel-subregion request-header 4096 0 64) 64
            (kernel-subregion text 4096 0 2) 2
            (kernel-subregion finish 4096 0 512) 512
            (kernel-subregion code 4096 0 0) 0
            (kernel-subregion message 4096 0 0) 0) 1)
       (put-word result-header 20 513) (put-word result-header 52 515)
       (= (completion/aiueos-llm-v1-result-shape-valid
            (kernel-subregion result-header 4096 0 64) 64
            (kernel-subregion request-header 4096 0 64) 64
            (kernel-subregion text 4096 0 2) 2
            (kernel-subregion finish 4096 0 513) 513
            (kernel-subregion code 4096 0 0) 0
            (kernel-subregion message 4096 0 0) 0) 0)
       (put-word result-header 20 5) (put-word result-header 52 7)
       (put-byte finish 0 120)
       (= (completion/aiueos-llm-v1-result-shape-valid
            (kernel-subregion result-header 4096 0 64) 64
            (kernel-subregion request-header 4096 0 64) 64
            (kernel-subregion text 4096 0 2) 2
            (kernel-subregion finish 4096 0 5) 5
            (kernel-subregion code 4096 0 0) 0
            (kernel-subregion message 4096 0 0) 0) 0)
       (put-byte finish 0 58)))

(defn- code-keyword-boundary
  [result-header :i64 request-header :i64 text :i64 finish :i64
   code :i64 message :i64] :bool
  (and (fill-ascii code 8 513)
       (put-word result-header 24 512) (put-word result-header 52 516)
       (= (completion/aiueos-llm-v1-result-shape-valid
            (kernel-subregion result-header 4096 0 64) 64
            (kernel-subregion request-header 4096 0 64) 64
            (kernel-subregion text 4096 0 0) 0
            (kernel-subregion finish 4096 0 0) 0
            (kernel-subregion code 4096 0 512) 512
            (kernel-subregion message 4096 0 4) 4) 1)
       (put-word result-header 24 513) (put-word result-header 52 517)
       (= (completion/aiueos-llm-v1-result-shape-valid
            (kernel-subregion result-header 4096 0 64) 64
            (kernel-subregion request-header 4096 0 64) 64
            (kernel-subregion text 4096 0 0) 0
            (kernel-subregion finish 4096 0 0) 0
            (kernel-subregion code 4096 0 513) 513
            (kernel-subregion message 4096 0 4) 4) 0)
       (put-word result-header 24 8) (put-word result-header 52 12)
       (put-byte code 0 120)
       (= (completion/aiueos-llm-v1-result-shape-valid
            (kernel-subregion result-header 4096 0 64) 64
            (kernel-subregion request-header 4096 0 64) 64
            (kernel-subregion text 4096 0 0) 0
            (kernel-subregion finish 4096 0 0) 0
            (kernel-subregion code 4096 0 8) 8
            (kernel-subregion message 4096 0 4) 4) 0)
       (put-byte code 0 58)))

(defn- record-check [receipt :i64 slot :i64 valid :bool] :bool
  (and valid (put-word receipt (* slot 8) 1)))

(defn- bad-field [header :i64 receipt :i64 slot :i64
                  offset :i64 bad :i64 original :i64] :bool
  (and (put-word header offset bad)
       (record-check receipt slot (= (header-valid header) 0))
       (put-word header offset original)))

;; Page 13 is a volatile host ticket and its separate 12-word receipt; page
;; 14 is the request digest. Neither page is mapped into a user process.
(defn- ticket-empty? [ticket :i64 index :i64] :bool
  (if (= index 9) true
    (and (= (kernel-load-u64 ticket 72 (* index 8)) 0)
         (ticket-empty? ticket (+ index 1)))))
(defn- ticket-checks [state :i64 digest :i64] :bool
  (let [t (kernel-subregion state 4096 0 72)
        d (kernel-subregion digest 4096 0 32)]
    (and (clear-words state 0 72)
         (clear-words state 256 352)
         (put-word digest 0 0x12345678)
         (put-word digest 4 0x23456789)
         (put-word digest 8 0x3456789a)
         (put-word digest 12 0x456789ab)
         (put-word digest 16 0x56789abc)
         (put-word digest 20 0x6789abcd)
         (put-word digest 24 0x789abcde)
         (put-word digest 28 0x89abcdef)
         (record-check state 32
           (= (ticket/aiueos-llm-v1-ticket-issue t 72 1 73 17 5 9 d 32) 1))
         (record-check state 33
           (and (= (ticket/aiueos-llm-v1-ticket-consume t 72 73 17 5 9 d 32) 1)
                (ticket-empty? t 0)))
         (record-check state 34
           (and (= (kernel-load-u64 t 72 0) 0)
                (= (ticket/aiueos-llm-v1-ticket-consume t 72 73 17 5 9 d 32) 0)))
         (record-check state 35
           (and (= (ticket/aiueos-llm-v1-ticket-issue t 72 1 73 17 5 9 d 32) 1)
                (= (ticket/aiueos-llm-v1-ticket-consume t 72 73 17 5 10 d 32) 0)
                (ticket-empty? t 0)
                (= (ticket/aiueos-llm-v1-ticket-consume t 72 73 17 5 9 d 32) 0)))
         (record-check state 36
           (and (= (ticket/aiueos-llm-v1-ticket-issue t 72 1 73 17 5 9 d 32) 1)
                (= (ticket/aiueos-llm-v1-ticket-consume t 72 73 17 6 9 d 32) 0)
                (= (ticket/aiueos-llm-v1-ticket-consume t 72 73 17 5 9 d 32) 0)))
         (record-check state 37
           (and (= (ticket/aiueos-llm-v1-ticket-issue t 72 1 73 17 5 9 d 32) 1)
                (= (ticket/aiueos-llm-v1-ticket-consume t 72 74 17 5 9 d 32) 0)
                (= (ticket/aiueos-llm-v1-ticket-consume t 72 73 17 5 9 d 32) 0)))
         (record-check state 38
           (and (= (ticket/aiueos-llm-v1-ticket-issue t 72 1 73 17 5 9 d 32) 1)
                (= (ticket/aiueos-llm-v1-ticket-consume t 72 73 18 5 9 d 32) 0)
                (= (ticket/aiueos-llm-v1-ticket-consume t 72 73 17 5 9 d 32) 0)))
         (record-check state 39
           (and (= (ticket/aiueos-llm-v1-ticket-issue t 72 1 73 17 5 9 d 32) 1)
                (put-word digest 0 0x12345679)
                (= (ticket/aiueos-llm-v1-ticket-consume t 72 73 17 5 9 d 32) 0)
                (put-word digest 0 0x12345678)
                (= (ticket/aiueos-llm-v1-ticket-consume t 72 73 17 5 9 d 32) 0)))
         (record-check state 40
           (and (= (ticket/aiueos-llm-v1-ticket-issue t 72 1 73 17 5 9 d 32) 1)
                (= (ticket/aiueos-llm-v1-ticket-issue t 72 0 73 17 5 9 d 32) 0)
                (ticket-empty? t 0)
                (= (ticket/aiueos-llm-v1-ticket-consume t 72 73 17 5 9 d 32) 0)))
         (record-check state 41
           (= (ticket/aiueos-llm-v1-ticket-issue
                t 72 1 73 17 5 9 (kernel-subregion state 4096 40 32) 32) 0))
         (record-check state 42
           (= (ticket/aiueos-llm-v1-ticket-issue t 72 1 73 17 5 9 d 31) 0))
         (record-check state 43
           (and (= (ticket/aiueos-llm-v1-ticket-issue t 72 1 73 17 5 9 d 32) 1)
                (= (ticket/aiueos-llm-v1-ticket-consume t 72 73 17 5 9 d 31) 0)
                (= (ticket/aiueos-llm-v1-ticket-consume t 72 73 17 5 9 d 32) 0))))))

(defn main [] :i64
  (let [header (kernel-owned-page 0)
        receipt (kernel-owned-page 1)
        model (kernel-owned-page 2)
        selected (kernel-owned-page 3)
        result (kernel-owned-page 4)
        system (kernel-owned-page 5)
        prompt (kernel-owned-page 6)
        result-header (kernel-owned-page 7)
        result-text (kernel-owned-page 8)
        finish (kernel-owned-page 9)
        code (kernel-owned-page 10)
        message (kernel-owned-page 11)
        result-receipt (kernel-owned-page 12)
        ticket-state (kernel-owned-page 13)
        ticket-digest (kernel-owned-page 14)]
    (if (and (initialize-header header)
             (clear-words receipt 0 168)
             (clear-words result-receipt 0 48)
             (initialize-model model selected prompt)
             (initialize-result result-header result-text finish)
             (record-check receipt 0 (= (header-valid header) 1))
             (bad-field header receipt 1 0 0 827149387)
             (bad-field header receipt 2 8 12 11)
             (bad-field header receipt 3 32 9 11)
             (bad-field header receipt 4 24 0 16)
             (bad-field header receipt 5 28 2001 0)
             (bad-field header receipt 6 40 1 0)
             (bad-field header receipt 7 16 65537 0)
             (bad-field header receipt 8 20 65537 5)
             (bad-field header receipt 9 36 65537 64)
             (bad-field header receipt 10 12 0 6)
             (bad-field header receipt 10 12 513 6)
             (bad-field header receipt 11 36 0 64)
             (record-check receipt 12
               (= (request/aiueos-llm-v1-request-shape-valid
                    (kernel-subregion header 4096 0 64) 64
                    (kernel-subregion model 4096 0 6) 6
                    (kernel-subregion system 4096 0 0) 0
                    (kernel-subregion prompt 4096 0 5) 5
                    (kernel-subregion selected 4096 0 6) 6
                    (kernel-subregion result 4096 0 64) 64) 1))
             (model-keyword-boundary
               header model selected system prompt result)
             (put-byte selected 1 120)
             (record-check receipt 13
               (and (= (request/aiueos-llm-v1-request-shape-valid
                         (kernel-subregion header 4096 0 64) 64
                         (kernel-subregion model 4096 0 6) 6
                         (kernel-subregion system 4096 0 0) 0
                         (kernel-subregion prompt 4096 0 5) 5
                         (kernel-subregion selected 4096 0 6) 6
                         (kernel-subregion result 4096 0 64) 64) 0)
                    ;; The model bytes match exactly here; only the two
                    ;; region roles alias, so the call must still refuse.
                    (= (request/aiueos-llm-v1-request-shape-valid
                         (kernel-subregion header 4096 0 64) 64
                         (kernel-subregion model 4096 0 6) 6
                         (kernel-subregion system 4096 0 0) 0
                         (kernel-subregion prompt 4096 0 5) 5
                         (kernel-subregion model 4096 0 6) 6
                         (kernel-subregion result 4096 0 64) 64) 0)))
             (put-byte selected 1 108)
             (record-check receipt 14
               (and (= (request/aiueos-llm-v1-request-shape-valid
                         (kernel-subregion header 4096 0 64) 64
                         (kernel-subregion model 4096 0 6) 6
                         (kernel-subregion system 4096 0 0) 0
                         (kernel-subregion prompt 4096 0 4) 4
                         (kernel-subregion selected 4096 0 6) 6
                         (kernel-subregion result 4096 0 64) 64) 0)
                    ;; Even an empty system region has its own root.
                    (= (request/aiueos-llm-v1-request-shape-valid
                         (kernel-subregion header 4096 0 64) 64
                         (kernel-subregion model 4096 0 6) 6
                         (kernel-subregion prompt 4096 0 0) 0
                         (kernel-subregion prompt 4096 0 5) 5
                         (kernel-subregion selected 4096 0 6) 6
                         (kernel-subregion result 4096 0 64) 64) 0)))
             (record-check receipt 15
               (and (= (request/aiueos-llm-v1-request-shape-valid
                         (kernel-subregion header 4096 0 64) 64
                         (kernel-subregion model 4096 0 6) 6
                         (kernel-subregion system 4096 0 0) 0
                         (kernel-subregion prompt 4096 0 5) 5
                         (kernel-subregion selected 4096 0 6) 6
                         (kernel-subregion result 4096 0 63) 63) 0)
                    (= (request/aiueos-llm-v1-request-shape-valid
                         (kernel-subregion header 4096 0 64) 64
                         (kernel-subregion model 4096 0 6) 6
                         (kernel-subregion system 4096 0 0) 0
                         (kernel-subregion prompt 4096 0 5) 5
                         (kernel-subregion selected 4096 0 6) 6
                         (kernel-subregion prompt 4096 0 64) 64) 0)
                    ;; Different roots still overlap within the prompt page.
                    (= (request/aiueos-llm-v1-request-shape-valid
                         (kernel-subregion header 4096 0 64) 64
                         (kernel-subregion model 4096 0 6) 6
                         (kernel-subregion system 4096 0 0) 0
                         (kernel-subregion prompt 4096 0 5) 5
                         (kernel-subregion selected 4096 0 6) 6
                         (kernel-subregion prompt 4096 1 64) 64) 0)))
             (put-byte model 1 120)
             (record-check receipt 16
               (= (request/aiueos-llm-v1-request-shape-valid
                    (kernel-subregion header 4096 0 64) 64
                    (kernel-subregion model 4096 0 6) 6
                    (kernel-subregion system 4096 0 0) 0
                    (kernel-subregion prompt 4096 0 5) 5
                    (kernel-subregion selected 4096 0 6) 6
                    (kernel-subregion result 4096 0 64) 64) 0))
             (put-byte model 1 108)
             ;; U+1F600 followed by ASCII is valid; then reject invalid lead,
             ;; overlong three-byte form, and a scalar above U+10FFFF.
             (put-byte prompt 0 240) (put-byte prompt 1 159)
             (put-byte prompt 2 152) (put-byte prompt 3 128)
             (put-byte prompt 4 51)
             (record-check receipt 17
               (= (request/aiueos-llm-v1-request-shape-valid
                    (kernel-subregion header 4096 0 64) 64
                    (kernel-subregion model 4096 0 6) 6
                    (kernel-subregion system 4096 0 0) 0
                    (kernel-subregion prompt 4096 0 5) 5
                    (kernel-subregion selected 4096 0 6) 6
                    (kernel-subregion result 4096 0 64) 64) 1))
             (put-byte prompt 0 192)
             (record-check receipt 18
               (= (request/aiueos-llm-v1-request-shape-valid
                    (kernel-subregion header 4096 0 64) 64
                    (kernel-subregion model 4096 0 6) 6
                    (kernel-subregion system 4096 0 0) 0
                    (kernel-subregion prompt 4096 0 5) 5
                    (kernel-subregion selected 4096 0 6) 6
                    (kernel-subregion result 4096 0 64) 64) 0))
             (put-byte prompt 0 224) (put-byte prompt 1 128)
             (record-check receipt 19
               (= (request/aiueos-llm-v1-request-shape-valid
                    (kernel-subregion header 4096 0 64) 64
                    (kernel-subregion model 4096 0 6) 6
                    (kernel-subregion system 4096 0 0) 0
                    (kernel-subregion prompt 4096 0 5) 5
                    (kernel-subregion selected 4096 0 6) 6
                    (kernel-subregion result 4096 0 64) 64) 0))
             (put-byte prompt 0 244) (put-byte prompt 1 144)
             (put-byte prompt 2 128) (put-byte prompt 3 128)
             (record-check receipt 20
               (= (request/aiueos-llm-v1-request-shape-valid
                    (kernel-subregion header 4096 0 64) 64
                    (kernel-subregion model 4096 0 6) 6
                    (kernel-subregion system 4096 0 0) 0
                    (kernel-subregion prompt 4096 0 5) 5
                    (kernel-subregion selected 4096 0 6) 6
                    (kernel-subregion result 4096 0 64) 64) 0))
             (put-byte prompt 0 104) (put-byte prompt 1 101)
             (put-byte prompt 2 108) (put-byte prompt 3 108)
             (put-byte prompt 4 111)
             ;; A bounded completion is accepted; unknown tag, excessive
             ;; usage and malformed text are refused before user copy-back.
             (record-check result-receipt 0
               (and (= (completion/aiueos-llm-v1-result-shape-valid
                        (kernel-subregion result-header 4096 0 64) 64
                        (kernel-subregion header 4096 0 64) 64
                        (kernel-subregion result-text 4096 0 2) 2
                        (kernel-subregion finish 4096 0 5) 5
                        (kernel-subregion code 4096 0 0) 0
                        (kernel-subregion message 4096 0 0) 0) 1)
                    ;; Both views contain valid UTF-8; only region isolation
                    ;; may reject this overlap.
                    (= (completion/aiueos-llm-v1-result-shape-valid
                        (kernel-subregion result-header 4096 0 64) 64
                        (kernel-subregion header 4096 0 64) 64
                        (kernel-subregion finish 4096 0 2) 2
                        (kernel-subregion finish 4096 0 5) 5
                        (kernel-subregion code 4096 0 0) 0
                        (kernel-subregion message 4096 0 0) 0) 0)
                    ;; The inactive :error code has zero length but must not
                    ;; alias the active text root.
                    (= (completion/aiueos-llm-v1-result-shape-valid
                        (kernel-subregion result-header 4096 0 64) 64
                        (kernel-subregion header 4096 0 64) 64
                        (kernel-subregion result-text 4096 0 2) 2
                        (kernel-subregion finish 4096 0 5) 5
                        (kernel-subregion result-text 4096 0 0) 0
                        (kernel-subregion message 4096 0 0) 0) 0)))
             (finish-keyword-boundary
               result-header header result-text finish code message)
             (put-word result-header 12 3)
             (record-check result-receipt 1
               (= (completion/aiueos-llm-v1-result-shape-valid
                  (kernel-subregion result-header 4096 0 64) 64
                  (kernel-subregion header 4096 0 64) 64
                  (kernel-subregion result-text 4096 0 2) 2
                  (kernel-subregion finish 4096 0 5) 5
                  (kernel-subregion code 4096 0 0) 0
                  (kernel-subregion message 4096 0 0) 0) 0))
             (put-word result-header 12 1)
             (put-word result-header 40 17)
             (record-check result-receipt 2
               (= (completion/aiueos-llm-v1-result-shape-valid
                  (kernel-subregion result-header 4096 0 64) 64
                  (kernel-subregion header 4096 0 64) 64
                  (kernel-subregion result-text 4096 0 2) 2
                  (kernel-subregion finish 4096 0 5) 5
                  (kernel-subregion code 4096 0 0) 0
                  (kernel-subregion message 4096 0 0) 0) 0))
             (put-word result-header 40 1)
             (put-byte result-text 0 192)
             (record-check result-receipt 3
               (= (completion/aiueos-llm-v1-result-shape-valid
                  (kernel-subregion result-header 4096 0 64) 64
                  (kernel-subregion header 4096 0 64) 64
                  (kernel-subregion result-text 4096 0 2) 2
                  (kernel-subregion finish 4096 0 5) 5
                  (kernel-subregion code 4096 0 0) 0
                  (kernel-subregion message 4096 0 0) 0) 0))
             (put-byte result-text 0 111)
             (initialize-error result-header code message)
             (record-check result-receipt 4
               (= (completion/aiueos-llm-v1-result-shape-valid
                  (kernel-subregion result-header 4096 0 64) 64
                  (kernel-subregion header 4096 0 64) 64
                  (kernel-subregion result-text 4096 0 0) 0
                  (kernel-subregion finish 4096 0 0) 0
                  (kernel-subregion code 4096 0 8) 8
                  (kernel-subregion message 4096 0 4) 4) 1))
             (code-keyword-boundary
               result-header header result-text finish code message)
             (put-word result-header 48 2)
             (record-check result-receipt 5
               (= (completion/aiueos-llm-v1-result-shape-valid
                  (kernel-subregion result-header 4096 0 64) 64
                  (kernel-subregion header 4096 0 64) 64
                  (kernel-subregion result-text 4096 0 0) 0
                  (kernel-subregion finish 4096 0 0) 0
                  (kernel-subregion code 4096 0 8) 8
                  (kernel-subregion message 4096 0 4) 4) 0))
             (initialize-result result-header result-text finish)
             (ticket-checks ticket-state ticket-digest))
      42 0)))
