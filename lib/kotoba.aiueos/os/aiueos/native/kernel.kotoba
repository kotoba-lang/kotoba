                            (kernel-out-u32 244 (+ 96 pre-cr3-nic-status))))
                        (if (and (prepare-page-tables page-table-root pdpt pd pt)
                                 (= (allow-loader-exec
                                     pd (load64-boot-far boot 16544 16368)) 1)
                                 (prepare-low-page-table pt rx-limit rw-start)
                                 (prepare-rtl-page-tables
                                  pdpt rtl-directory-a rtl-directory-b bar-a bar-b))
                            (if (and (enable-page-protection)
                                     ;; MASK INTERRUPTS FIRST. Between the CR3
                                     ;; load and `install-page-fault-idt` below,
                                     ;; the firmware's IDT is still the live one
                                     ;; -- and every one of its handlers sits
                                     ;; above 2 MiB, which this map has just
                                     ;; made NX. Any interrupt delivered in that
                                     ;; window vectors into a page that cannot
                                     ;; be fetched: #PF, whose firmware handler
                                     ;; is equally unfetchable, so it recurses
                                     ;; until the stack is gone and the machine
                                     ;; triple faults.
                                     ;;
                                     ;; That is not hypothetical. It is what the
                                     ;; roughly one-run-in-five QEMU abort was,
                                     ;; measured 2026-09-09 with -d int: a
                                     ;; healthy run logs 157 events, all APIC
                                     ;; timer; the aborted run logs 97,886, of
                                     ;; which the first 149 are the same timer
                                     ;; and the 150th is a #PF. Tick 149 is the
                                     ;; only one whose IP is in guest text
                                     ;; (0x125058) rather than firmware -- the
                                     ;; tick that arrived after the switch. The
                                     ;; error code is 0x11 throughout: present,
                                     ;; instruction fetch.
                                     ;;
                                     ;; Nothing re-enables interrupts here. The
                                     ;; guest runs to its own return with them
                                     ;; masked, which is what it did in every
                                     ;; run that already passed -- it just did
                                     ;; it by not being interrupted rather than
                                     ;; by saying so.
                                     (= (kernel-cli) 0)
                                     (activate-page-tables page-table-root)
                                     (= (kernel-configure-page-fault-recovery
                                         frame-page stack-page) 1)
                                     (= (install-page-fault-idt
                                         reusable-page rx-limit) 1)
                                     ;; #UD and #GP, into the SAME table the
                                     ;; page-fault installer just loaded --
                                     ;; gates 6 and 13 are at offsets 96 and
                                     ;; 208, inside its limit of 239, so this
                                     ;; adds entries without touching the
                                     ;; descriptor. Installed after it on
                                     ;; purpose: the table must be live before
                                     ;; these gates mean anything.
                                     (= (install-fault-gate
                                         reusable-page 6
                                         (kernel-isr-entry-address 6)) 1))
                              (let [page-marker (serial/trace-byte 80)
                                    root-marker (serial/trace-byte 82)
                                    cr3-marker (serial/trace-byte 67)
                                    idt-marker (serial/trace-byte 68)
                                    ;; IS THIS A STEP, OR A BOOT?
                                    ;;
                                    ;; The tender re-enters `main` without a
                                    ;; platform reset (ADR-0204/0205 step 2),
                                    ;; and measured 2026-09-08 the SECOND entry
                                    ;; died in 60 ms, twice. A re-entry is not
                                    ;; a reboot: the machine it starts on is
                                    ;; not the machine a reboot starts on, and
                                    ;; two things below only make sense from
                                    ;; cold.
                                    ;;
                                    ;; No flag has to be stored anywhere. The
                                    ;; state is already in the hardware: CR3
                                    ;; holds the firmware's tables on a real
                                    ;; boot and holds OURS from
                                    ;; `activate-page-tables` onward, and
                                    ;; nothing between entries puts it back.
                                    ;; `activate-page-tables` compares
                                    ;; `kernel-read-cr3` against this same
                                    ;; region to check its own work, so the
                                    ;; comparison is the one the machine
                                    ;; already trusts.
                                    step? (= cr3 page-table-root)
                                    ;; `page-fault-probe` takes a DELIBERATE
                                    ;; page fault to prove recovery works. That
                                    ;; is a cold-boot assertion; taking it again
                                    ;; while the NIC holds live DMA is asking
                                    ;; the machine to survive something it was
                                    ;; never asked to survive. 424242 is
                                    ;; `recoverable-frame-valid`'s own bypass.
                                    probe (if step? 424242 (page-fault-probe))
                                    core-ok (and (= page-marker 80)
                                                 (= root-marker 82)
                                                 (= cr3-marker 67)
                                                 (= idt-marker 68)
                                                 (= (recoverable-frame-valid
                                                     frame-page stack-page probe) 1))
                                    ;; And do not re-qualify a NIC that is
                                    ;; already up: qualification RESETS the
                                    ;; device, and the previous step's rings and
                                    ;; descriptors are still live. 0 is the
                                    ;; status a good qualification returns.
                                    nic-status (if step?
                                                 0
                                                 (if core-ok
                                                   (qualify-rtl8125
                                                    bar-a bar-b rtl-dma-pages)
                                                   -2))
                                    nic-marker (if (= nic-status 0)
                                                 (serial/trace-byte 78)
                                                 (if (>= nic-status 0)
                                                   ;; 'Q', not 'F'. Three
                                                   ;; different things emit
                                                   ;; 'F' on this port: this
                                                   ;; marker, the loader's
                                                   ;; :fail arm, and
                                                   ;; kotoba-native's
                                                   ;; fail-closed-receipt --
                                                   ;; and the last of those
                                                   ;; also writes 0x1f to the
                                                   ;; debug-exit port, which
                                                   ;; is where exit 63 comes
                                                   ;; from. The collision is
                                                   ;; why exit 63 was read for
                                                   ;; days as a guest status:
                                                   ;; the trailing byte looked
                                                   ;; like this line.
                                                   (serial/trace-byte 81)
                                                   0))]
                                (kernel-out-u32 244
                                                (+ (if core-ok 16 17)
                                                   (* 0 nic-marker))))
                              (kernel-out-u32 244 24))
                          (kernel-out-u32 244 23)))
                      ;; 'l' -- this ladder is a failure exit, so say which
                      ;; writer produced the status. Without it a numeric exit
                      ;; code has to be matched back to one of nine call sites
                      ;; by hand, and the trailing bytes cannot help: the guest
                      ;; keeps running after it writes the port, so everything
                      ;; printed AFTER a write is a race. A byte printed BEFORE
                      ;; one is not.
                      (kernel-out-u32 244
                                      (if (= (serial/trace-byte 108) 108)
                                      (if (not (= owned-status 0))
                                        owned-status
                                        (if (not (= extra-status 0))
                                          extra-status
                                          (if (not (= nic-owned-status 0))
                                            nic-owned-status
                                            nic-pages-status))) 0))))
              (kernel-out-u32 244 20)))
          (kernel-out-u32 244 19)))
      (kernel-out-u32 244 18))))
