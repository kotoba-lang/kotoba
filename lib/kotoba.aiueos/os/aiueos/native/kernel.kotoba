                          ;; zero means both the earlier ARP/UDP receipt and the
                          ;; new 8443 SYN/SYN-ACK exchange completed.
                          (if (= pre-cr3-nic-status 0)
                            ;; Gate N2 tranche one (ADR-0134): with the
                            ;; diagnostics qualification green under the
                            ;; known-good pre-CR3 mapping, install the stream
                            ;; profile's 4-descriptor RX ring, arm the TCB, and
                            ;; run one bounded ESTABLISHED-state receive window
                            ;; on the fixed 4-tuple. The wire status is honest:
                            ;; 192 + 99 (0x123) = a delivery+ACK ran, 192 + 21 =
                            ;; the ring is live but the peer sent nothing inside
                            ;; the window, 192 + 30/26/25 = the specific stream
                            ;; fault. Diagnostics codes 96..96+0 stay untouched.
                            (let [stream-mmio (kernel-pci-mmio 2 0 0 bar-a 512)
                                  stream-win (kernel-subregion rtl-dma-pages
                                                               16384 0 16384)
                                  ;; The stream's three CPU-side buffers, in
                                  ;; ONE region with fixed offsets (log +0,
                                  ;; tx +4096, staging +8192) so that no two of
                                  ;; them can be the same page by accident.
                                  ;; They were three separately-computed
                                  ;; addresses, and two of them landed on the
                                  ;; same page for months: tx-frame and staging
                                  ;; were both rtl-dma-pages + 8192, which is
                                  ;; also the stream's rx-buffer-a. Worse,
                                  ;; stream-log built its receipt in the TX
                                  ;; frame, so the SYN was overwritten between
                                  ;; being built and being submitted -- which
                                  ;; the Mac measured as `0 connection request`
                                  ;; over ~363,000 attempts (ADR-0156).
                                  ;;
                                  ;; page-table-root, pdpt and pd are the free
                                  ;; pages here and they are contiguous. Only
                                  ;; prepare-page-tables installs them, and that
                                  ;; runs in the CR3 arm, not this one;
                                  ;; prepare-owned-pages has already zeroed
                                  ;; them. They sit below the bus3 window
                                  ;; (pages 4..7) and far below rtl-dma-pages
                                  ;; (pages 10..13).
                                  stream-scratch (kernel-owned-window 1 12288)
                                  stream-log-frame (kernel-subregion
                                                    stream-scratch 12288 0 4096)
                                  stream-tcb (kernel-owned-page 11)
                                  ring-status (stream/rx-ring-init
                                               stream-mmio rtl-dma-pages)
                                  ;; A STEP KEEPS ITS TCB. `tcb-init` zeroes
                                  ;; the block, including the boot-nonce slot
                                  ;; and the cycle counter, and the tender
                                  ;; re-enters `main` every ~76 ms -- so with
                                  ;; it the board drew a FRESH NONCE PER STEP
                                  ;; and announced itself as a new node
                                  ;; thirteen times a second. Measured
                                  ;; 2026-09-09: 54 hellos and 55 entries from
                                  ;; two image loads, which buried the relay's
                                  ;; single-flight mint under a burst it was
                                  ;; never shaped for (its window was derived
                                  ;; for one hello per 20 s) and turned every
                                  ;; enrolment into a 401.
                                  ;;
                                  ;; The nonce slot is already written once and
                                  ;; reused while non-zero; it was the
                                  ;; re-initialisation underneath it that made
                                  ;; that pointless. Keeping the block also
                                  ;; keeps `cycles`, which gates the hello on
                                  ;; `(= cycles 0)` -- so the hello returns to
                                  ;; once per COLD BOOT, which is what it
                                  ;; always meant.
                                  ;;
                                  ;; Same CR3 test as the page-fault probe and
                                  ;; the NIC qualification: the hardware
                                  ;; already knows whether init has run.
                                  tcb-status (if (= cr3 page-table-root)
                                               0
                                               (if (= ring-status 0)
                                                 (stream/tcb-init stream-tcb 2715820034)
                                                 1))
                                  stream-status
                                  (if (and (= ring-status 0) (= tcb-status 0))
                                    0
                                    (if (not (= ring-status 0)) 97 98))]
                              ;; Plan A-2: the stream runs resident — every
                              ;; cycle re-arms, connects, receives, and logs
                              ;; over UDP. The screen write happens before
                              ;; entering the loop; outcomes ride STREAM_C.
                              ;; LAN2 debug plane, step 1. The census (B7 7F
                              ;; 7F, read on the K16 2026-09-06) said bus3
                              ;; answers config space, decodes its BAR, has
                              ;; MEM-SPACE and BUS-MASTER set, reads back its
                              ;; revision and MAC, and has PHY link -- so the
                              ;; NIC can DMA. What it still lacked was a
                              ;; loader-OWNED window.
                              ;;
                              ;; This branch never replaces CR3 (bar-a > 0, so
                              ;; prepare-page-tables / activate-page-tables are
                              ;; in the other arm), which leaves pt,
                              ;; reusable-page, frame-page and stack-page
                              ;; allocated by the loader, zeroed by
                              ;; prepare-owned-pages / prepare-extra-pages, and
                              ;; idle for the life of this branch. They are
                              ;; four contiguous pages = the 16 KiB bus3 needs.
                              ;;
                              ;; Six bytes ride the known-good bus2 netlog once
                              ;; before the resident loop: B7 sentinel, bus3
                              ;; census, bus2 census (control), B8 sentinel,
                              ;; debug-init status, debug-send status. Phase 1
                              ;; observed none of this and was therefore
                              ;; useless whatever the wire did (ADR-0156).
                              (do (kernel-out-u32 244 (+ 192 stream-status))
                                  (let [census-b (rtl/bus-probe 3)
                                        census-a (rtl/bus-probe 2)
                                        mark (stream/stream-log
                                              stream-win stream-mmio
                                              stream-log-frame 183)
                                        logged-b (stream/stream-log
                                                  stream-win stream-mmio
                                                  stream-log-frame
                                                  (+ census-b (* 0 mark)))
                                        logged-a (stream/stream-log
                                                  stream-win stream-mmio
                                                  stream-log-frame
                                                  (+ census-a (* 0 logged-b)))
                                        bus3-dma-pages (kernel-owned-window 4 16384)
                                        bus3-mmio (kernel-pci-mmio 3 0 0 bar-b 512)
                                        ;; 6 = bar-b never decoded, so there is
                                        ;; no MMIO to init. Distinct from every
                                        ;; code debug-init itself returns.
                                        dbg-init (if (> bar-b 0)
                                                   (debug/debug-init
                                                    3 bus3-mmio bus3-dma-pages)
                                                   6)
                                        ;; 7 = not attempted, because init
                                        ;; refused. Never confuse "skipped"
                                        ;; with "sent".
                                        ;; What the PHY reports, as DD <hi>
                                        ;; DD <lo> -- the same one-DA-per-byte
                                        ;; shape the MAC block uses, and for
                                        ;; the same reason (lang-h9b: a raw
                                        ;; byte on this wire is a sentinel
                                        ;; somewhere). Emitted before the
                                        ;; greeting, because the greeting's
                                        ;; status is only meaningful beside it.
                                        phy-hi-mark (if (= dbg-init 0)
                                                      (stream/stream-log
                                                       stream-win stream-mmio
                                                       stream-log-frame 221)
                                                      0)
                                        phy-hi (if (= dbg-init 0)
                                                 (stream/stream-log
                                                  stream-win stream-mmio
                                                  stream-log-frame
                                                  (+ (debug/debug-phy-byte
                                                      bus3-mmio 0)
                                                     (* 0 phy-hi-mark)))
                                                 0)
                                        phy-lo-mark (if (= dbg-init 0)
                                                      (stream/stream-log
                                                       stream-win stream-mmio
                                                       stream-log-frame
                                                       (+ 221 (* 0 phy-hi)))
                                                      0)
                                        phy-lo (if (= dbg-init 0)
                                                 (stream/stream-log
                                                  stream-win stream-mmio
                                                  stream-log-frame
                                                  (+ (debug/debug-phy-byte
                                                      bus3-mmio 1)
                                                     (* 0 phy-lo-mark)))
                                                 0)
                                        dbg-sent (if (= dbg-init 0)
                                                   (+ (debug/debug-send
                                                       bus3-mmio bus3-dma-pages)
                                                      (* 0 phy-lo))
                                                   7)
                                        hdr (if (= dbg-init 0)
                                              (dump-bus3-ip-header
                                               stream-win stream-mmio
                                               stream-log-frame
                                               bus3-dma-pages 14)
                                              0)
                                        mark-b (stream/stream-log
                                                stream-win stream-mmio
                                                stream-log-frame
                                                (+ 184 (* 0 (+ logged-a hdr))))
                                        logged-init (stream/stream-log
                                                     stream-win stream-mmio
                                                     stream-log-frame
                                                     (+ dbg-init (* 0 mark-b)))
                                        ;; bus3's MAC as six DA <byte> PAIRS
                                        ;; (12 datagrams). The Mac cannot reach
                                        ;; 10.10.10.2 without it, because this
                                        ;; plane answers UDP and not ARP.
                                        ;; Emitted once, only when bus3 came up
                                        ;; ready. One DA before EVERY byte: the
                                        ;; wire is one byte per datagram, and
                                        ;; with a single DA followed by six
                                        ;; positional bytes a MAC byte FC was
                                        ;; read as the FC checksum verdict
                                        ;; (measured 2026-09-07, lang-h9b).
                                        ;; After a DA the reader consumes
                                        ;; exactly one byte, whatever its value.
                                        mark-c (if (= dbg-init 0)
                                                 (stream/stream-log
                                                  stream-win stream-mmio
                                                  stream-log-frame
                                                  (+ 218 (* 0 logged-init)))
                                                 0)
                                        m0 (if (= dbg-init 0)
                                             (stream/stream-log
                                              stream-win stream-mmio
                                              stream-log-frame
                                              (+ (debug/debug-mac-byte
                                                  bus3-mmio 0)
                                                 (* 0 mark-c)))
                                             0)
                                        da1 (if (= dbg-init 0)
                                              (stream/stream-log
                                               stream-win stream-mmio
                                               stream-log-frame
                                               (+ 218 (* 0 m0)))
                                              0)
                                        m1 (if (= dbg-init 0)
                                             (stream/stream-log
                                              stream-win stream-mmio
                                              stream-log-frame
                                              (+ (debug/debug-mac-byte
                                                  bus3-mmio 1)
                                                 (* 0 da1)))
                                             0)
                                        da2 (if (= dbg-init 0)
                                              (stream/stream-log
                                               stream-win stream-mmio
                                               stream-log-frame
                                               (+ 218 (* 0 m1)))
                                              0)
                                        m2 (if (= dbg-init 0)
                                             (stream/stream-log
                                              stream-win stream-mmio
                                              stream-log-frame
                                              (+ (debug/debug-mac-byte
                                                  bus3-mmio 2)
                                                 (* 0 da2)))
                                             0)
                                        da3 (if (= dbg-init 0)
                                              (stream/stream-log
                                               stream-win stream-mmio
                                               stream-log-frame
                                               (+ 218 (* 0 m2)))
                                              0)
                                        m3 (if (= dbg-init 0)
                                             (stream/stream-log
                                              stream-win stream-mmio
                                              stream-log-frame
                                              (+ (debug/debug-mac-byte
                                                  bus3-mmio 3)
                                                 (* 0 da3)))
                                             0)
                                        da4 (if (= dbg-init 0)
                                              (stream/stream-log
                                               stream-win stream-mmio
                                               stream-log-frame
                                               (+ 218 (* 0 m3)))
                                              0)
                                        m4 (if (= dbg-init 0)
                                             (stream/stream-log
                                              stream-win stream-mmio
                                              stream-log-frame
                                              (+ (debug/debug-mac-byte
                                                  bus3-mmio 4)
                                                 (* 0 da4)))
                                             0)
                                        da5 (if (= dbg-init 0)
                                              (stream/stream-log
                                               stream-win stream-mmio
                                               stream-log-frame
                                               (+ 218 (* 0 m4)))
                                              0)
                                        m5 (if (= dbg-init 0)
                                             (stream/stream-log
                                              stream-win stream-mmio
                                              stream-log-frame
                                              (+ (debug/debug-mac-byte
                                                  bus3-mmio 5)
                                                 (* 0 da5)))
                                             0)]
                                    (stream/stream-log stream-win stream-mmio
                                                       stream-log-frame
                                                       (+ dbg-sent (* 0 m5)))
                                    ;; LAN2 stays in the loop only if bus3 came
                                    ;; up ready. On a board without the second
                                    ;; NIC bus3-mmio is 0, and the loop must
                                    ;; never dereference it -- so the gate is
                                    ;; the init status, not the pointer.
                                    ;; Arm the chipset watchdog before the
                                    ;; loop that will kick it. D3 says it is
                                    ;; running, D4 that the platform refused --
                                    ;; not an Intel PCH, no ACPI base, or a
                                    ;; locked TCO. D4 is not a failure to act
                                    ;; on here: it means the board still needs
                                    ;; a human, which is what it needed before.
                                    (let [wd (watchdog/tco-base)
                                          wd-armed (watchdog/arm wd)
                                          ;; D3 armed, D5 armed after a
                                          ;; previous timeout, D4 refused.
                                          ;;
                                          ;; THREE COPIES, for the reason
                                          ;; ADR-0203 already recorded about
                                          ;; DE: this wire is fire-and-forget
                                          ;; UDP, one datagram per byte, and a
                                          ;; single copy of a byte that decides
                                          ;; an interpretation is a byte whose
                                          ;; absence means nothing. Measured
                                          ;; 2026-09-08: a boot that armed the
                                          ;; watchdog delivered NEITHER mark,
                                          ;; and the question "did it arm?"
                                          ;; could not be answered at all.
                                          ;; Refused? say WHICH refusal.
                                          ;; D4 not-Intel, D6 no ACPI base,
                                          ;; D2 the halt bit would not clear.
                                          wd-why (if (= wd-armed 0)
                                                   (watchdog/refusal)
                                                   0)
                                          wd-byte (if (= wd-armed 0)
