                                          ;; belongs to one boot only.
                                          prev-fault (kernel-load-u8-4k
                                                      reusable-page 4096 1024)
                                          fault-cleared (kernel-store-u8-4k
                                                         reusable-page 4096 1024
                                                         (* 0 prev-fault))
                                          fault-byte (if (= prev-fault 6) 208
                                                       (if (= prev-fault 13) 209 0))
                                          fm1 (if (= fault-byte 0) 0
                                                (stream/stream-log
                                                 stream-win stream-mmio
                                                 stream-log-frame
                                                 (+ fault-byte (* 0 fault-cleared))))
                                          fm2 (if (= fault-byte 0) 0
                                                (stream/stream-log
                                                 stream-win stream-mmio
                                                 stream-log-frame
                                                 (+ fault-byte (* 0 fm1))))
                                          fm3 (if (= fault-byte 0) 0
                                                (stream/stream-log
                                                 stream-win stream-mmio
                                                 stream-log-frame
                                                 (+ fault-byte (* 0 fm2))))
                                          wd-m1 (stream/stream-log
                                                 stream-win stream-mmio
                                                 stream-log-frame
                                                 (+ wd-byte (* 0 fm3)))
                                          wd-m2 (stream/stream-log
                                                 stream-win stream-mmio
                                                 stream-log-frame
                                                 (+ wd-byte (* 0 wd-m1)))
                                          wd-mark (stream/stream-log
                                                   stream-win stream-mmio
                                                   stream-log-frame
                                                   (+ wd-byte (* 0 wd-m2)))
                                          bus3-ready (if (= dbg-init 0) 1 0)]
                                      (stream/stream-resident
                                       stream-win
                                       stream-mmio
                                       stream-scratch
                                       bus3-dma-pages
                                       bus3-ready
                                       ;; The sequencing multiply rides the
                                       ;; CYCLE COUNT, not the DMA region: a
                                       ;; kernel memory base must NAME a region
                                       ;; rather than compute one, and
                                       ;; `(+ bus3-dma-pages (* 0 wd-mark))`
                                       ;; computes one. Refused at :subset with
