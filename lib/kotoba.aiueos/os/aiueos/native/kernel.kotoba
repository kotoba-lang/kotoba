(ns aiueos.native.kernel
  ;; The live root links main and the explicit vector-6 callback. Namespace
  ;; exports are linker interfaces; only the selected image root owns the
  ;; actual boot/interrupt ABI entries.
  (:require [native.watchdog :as watchdog]
             [native.rtl8125 :as rtl]
            [native.serial :as serial]
            [native.tcp-stream :as stream]
            [native.debug-link :as debug])
  (:export [main aiueos-isr-6]))

;; Gate N2 (ADR-0134): the persistent TCP byte stream runtime profile links
;; into the same closed module graph as the diagnostics profile. `main` still
;; runs only rtl/qualify -- the diagnostics path is byte-identical in behavior
;; -- but the stream profile's module (its RX ring re-layout, bounded TCB,
;; ESTABLISHED-state receive and the org-ietf-tcp seq/reassemble cores) is
;; compiled, linked and receipt-recorded in every N2-era artifact. The
;; physical tranche wires its entry into the post-qualification flow.

;; The compiler-emitted loader keeps the final UEFI memory map in a bounded
;; region directly after the 160-byte boot-info prefix. The kernel derives that
;; region; it never turns the pointer stored by firmware into authority.
(defn dump-bus3-ip-header [win mmio log-frame bus3-dma index]
  ;; DD <byte> for offsets 14..33 of the last bus3 frame: the whole IPv4 header
  ;; as it sits in the buffer the NIC transmitted from. One DD per byte, the
  ;; shape lang-h9b requires, because any of these bytes can be a sentinel.
  (if (> index 33)
    1
    (let [mark (stream/stream-log win mmio log-frame 221)
          b (stream/stream-log win mmio log-frame
                               (+ (debug/debug-frame-byte bus3-dma index)
                                  (* 0 mark)))]
      (+ (dump-bus3-ip-header win mmio log-frame bus3-dma (+ index 1))
         (* 0 b)))))

(defn load64 [base length offset]
  (+ (kernel-load-u8-16k base length offset)
     (* (kernel-load-u8-16k base length (+ offset 1)) 256)
     (* (kernel-load-u8-16k base length (+ offset 2)) 65536)
     (* (kernel-load-u8-16k base length (+ offset 3)) 16777216)
     (* (kernel-load-u8-16k base length (+ offset 4)) 4294967296)
     (* (kernel-load-u8-16k base length (+ offset 5)) 1099511627776)
     (* (kernel-load-u8-16k base length (+ offset 6)) 281474976710656)
     (* (kernel-load-u8-16k base length (+ offset 7)) 72057594037927936)))

(defn load64-boot-far [boot boot-length offset]
  ;; Boot-info v5 has a160-byte header, followed by the16KiB map. Pass the
  ;; original region length explicitly; a loaded address grants no authority.
  (let [window (kernel-subregion boot boot-length 160 16384)]
    (load64 window 16384 offset)))

(defn allow-loader-exec [pd loader-text]
  (let [index (quot loader-text 2097152)]
    (if (and (> loader-text 0) (< index 512))
      (let [value (+ (* index 2097152) 131)]
        (if (= (store64-page pd (* index 8) value) 1) 1 0))
      1)))

(defn load64-boot [base length offset]
  (let [header (kernel-subregion base length 0 160)]
    (kernel-load-u64 header 160 offset)))

(defn load32-boot [base length offset]
  (let [header (kernel-subregion base length 0 160)]
    (kernel-load-u32 header 160 offset)))

;; Keep only one effectful write live at a time.  This uses less sealed fuel
;; than retaining sixteen store results and reducing them after the writes.
;; The store proves the byte writable (an out-of-range store traps); it does
;; NOT prove it zero -- a kernel store returns its operand, so `(= stored 0)`
;; here was a tautology (lang-h13). The byte is not read back per iteration:
;; that is one extra load for every byte of every page against the sealed
;; fuel budget, and the publication gates read the pages they depend on.
(defn zero-page [page offset]
  (if (= offset 4096)
    1
    (let [stored (kernel-store-u8-4k page 4096 offset 0)]
      (if (= 0 (* 0 stored))
        (zero-page page (+ offset 1))
        0))))

;; One byte per bounded allocator slot is deliberately simple: zero means
;; free, one means owned.  The state lives in an allocator page rather than in
;; transient scalar control flow, so later claims observe earlier decisions.
(defn claim-slot [state slot]
  (if (= (kernel-load-u8-4k state 4096 slot) 0)
    (let [claimed (kernel-store-u8-4k state 4096 slot 1)]
      (if (= (+ (kernel-load-u8-4k state 4096 slot) (* 0 claimed)) 1) 1 0))
    0))

(defn release-slot [state slot]
  (if (= (kernel-load-u8-4k state 4096 slot) 1)
    (let [released (kernel-store-u8-4k state 4096 slot 0)]
      (if (= (+ (kernel-load-u8-4k state 4096 slot) (* 0 released)) 0) 1 0))
    0))

(defn load64-page [page offset]
  (+ (kernel-load-u8-4k page 4096 offset)
     (* (kernel-load-u8-4k page 4096 (+ offset 1)) 256)
     (* (kernel-load-u8-4k page 4096 (+ offset 2)) 65536)
     (* (kernel-load-u8-4k page 4096 (+ offset 3)) 16777216)
     (* (kernel-load-u8-4k page 4096 (+ offset 4)) 4294967296)
     (* (kernel-load-u8-4k page 4096 (+ offset 5)) 1099511627776)
     (* (kernel-load-u8-4k page 4096 (+ offset 6)) 281474976710656)
     (* (kernel-load-u8-4k page 4096 (+ offset 7)) 72057594037927936)))

;; Page-table entries are little-endian u64 values.  Keeping this in Kotoba
;; avoids introducing a C helper or widening the privileged intrinsic surface.
(defn store64-page [page offset value]
  (let [s0 (kernel-store-u8-4k page 4096 offset (bit-and value 255))
        s1 (kernel-store-u8-4k page 4096 (+ offset 1) (bit-and (quot value 256) 255))
        s2 (kernel-store-u8-4k page 4096 (+ offset 2) (bit-and (quot value 65536) 255))
        s3 (kernel-store-u8-4k page 4096 (+ offset 3) (bit-and (quot value 16777216) 255))
        s4 (kernel-store-u8-4k page 4096 (+ offset 4) (bit-and (quot value 4294967296) 255))
        s5 (kernel-store-u8-4k page 4096 (+ offset 5) (bit-and (quot value 1099511627776) 255))
        s6 (kernel-store-u8-4k page 4096 (+ offset 6) (bit-and (quot value 281474976710656) 255))
        s7 (kernel-store-u8-4k page 4096 (+ offset 7) (bit-and (quot value 72057594037927936) 255))]
    (if (= (load64-page page offset) value)
      (+ 1 (* 0 (+ s0 s1 s2 s3 s4 s5 s6 s7)))
      0)))

;; NX lives in byte 7, so it is installed without pretending signed i64
;; literals are unsigned page-table entries.
(defn store64-nx-page [page offset value]
  (if (and (= (store64-page page offset value) 1)
           (= 0 (* 0 (kernel-store-u8-4k page 4096 (+ offset 7) 128)))
           (= (kernel-load-u8-4k page 4096 (+ offset 7)) 128))
    1
    0))

;; PDE 0 points to a 4 KiB PT.  The remaining 2 MiB leaves preserve the first
;; GiB identity map but are RW+NX rather than executable.
(defn fill-identity-pd [page index]
  (if (= index 512)
    1
    (let [value (+ (* index 2097152) 131)]
      (if (= (store64-nx-page page (* index 8) value) 1)
        (fill-identity-pd page (+ index 1))
        0))))

(defn fill-low-pt [page index rx-limit rw-start]
  (if (= index 512)
    1
    (let [physical (* index 4096)
          offset (* index 8)
          stored (if (= index 256)
                   (store64-page page offset 0)
                   (if (and (>= physical 1052672) (< physical rx-limit))
                     (store64-page page offset (+ physical 1))
                     (if (and (>= physical rx-limit) (< physical rw-start))
                       (store64-page page offset 0)
                       (store64-nx-page page offset (+ physical 3)))))]
      (if (= stored 1)
        (fill-low-pt page (+ index 1) rx-limit rw-start)
        0))))

(defn five-distinct [a b c d e]
  (and (> a 0) (> b 0) (> c 0) (> d 0) (> e 0)
       ;; AllocateAnyPages may legally place loader-owned scratch above the
       ;; first GiB. Keep the same 512 GiB physical-authority ceiling enforced
       ;; by main and kernel-subregion instead of retaining the old low-RAM
       ;; conventional-memory scan limit.
       (< e 549755813888)
       (not (= a b)) (not (= a c)) (not (= a d)) (not (= a e))
       (not (= b c)) (not (= b d)) (not (= b e))
       (not (= c d)) (not (= c e)) (not (= d e))))

(defn zero-five-status [state pml4 pdpt pd pt]
  (if (not (= (zero-page state 0) 1)) 30
    ;; UNREACHABLE, and so are 30 and 32-34 below. `zero-page` cannot return
    ;; anything but 1: its failure branch is guarded by `(= 0 (* 0 stored))`,
    ;; which is true for every value of `stored`. The same shape makes 25-27
    ;; in prepare-extra-pages and 79-84 in prepare-nic-pages unreachable.
    ;;
    ;; Nor could it be otherwise. `kernel-store-u8-4k` returns its operand, so
    ;; there is no failure value to test, and an out-of-range offset does not
    ;; return at all -- the emitter compares the declared length against the
    ;; op's profile maximum and falls through to UD2.
    ;;
    ;; The real check is the readback immediately below (35-39), which loads
    ;; the last byte and compares it. That one can fail and says so.
    ;;
    ;; Left in place rather than deleted: removing them renumbers a status
    ;; vocabulary that receipts and ADRs already quote. Marked instead, so the
    ;; next reader does not spend a run waiting for a code that cannot arrive
    ;; -- which is what happened here on 2026-09-09, when exit 63 was
    ;; attributed to this branch and a label was put on it.
    (if (not (= (zero-page pml4 0) 1)) 31
      (if (not (= (zero-page pdpt 0) 1)) 32
        (if (not (= (zero-page pd 0) 1)) 33
          (if (not (= (zero-page pt 0) 1)) 34
            (if (not (= (kernel-load-u8-4k state 4096 4095) 0)) 35
              (if (not (= (kernel-load-u8-4k pml4 4096 4095) 0)) 36
                (if (not (= (kernel-load-u8-4k pdpt 4096 4095) 0)) 37
                  (if (not (= (kernel-load-u8-4k pd 4096 4095) 0)) 38
                    (if (= (kernel-load-u8-4k pt 4096 4095) 0) 0 39)))))))))))

(defn claim-eight-status [state]
  ;; 71 ("the store did not return 1") was unreachable: a store returns its
  ;; operand (lang-h13). 72 -- the slot does not read back as 1 -- is the check.
  (if (not (= (kernel-load-u8-4k state 4096 0) 0)) 70
    (let [claimed (kernel-store-u8-4k state 4096 0 1)]
      (if (not (= (+ (kernel-load-u8-4k state 4096 0) (* 0 claimed)) 1)) 72
        (if (not (= (claim-slot state 1) 1)) 51
          (if (not (= (claim-slot state 2) 1)) 52
            (if (not (= (claim-slot state 3) 1)) 53
              (if (not (= (claim-slot state 4) 1)) 54
                (if (not (= (claim-slot state 5) 1)) 55
                  (if (not (= (claim-slot state 6) 1)) 56
                    (if (= (claim-slot state 7) 1) 0 57)))))))))))

(defn reclaim-status [state]
  (if (not (= (claim-slot state 1) 0)) 58
    (if (not (= (release-slot state 4) 1)) 59
      (if (not (= (release-slot state 4) 0)) 60
        (if (= (claim-slot state 4) 1) 0 61)))))

(defn ownership-read-status [state]
  (if (not (= (kernel-load-u8-4k state 4096 0) 1)) 62
    (if (not (= (kernel-load-u8-4k state 4096 1) 1)) 63
      (if (not (= (kernel-load-u8-4k state 4096 2) 1)) 64
        (if (not (= (kernel-load-u8-4k state 4096 3) 1)) 65
          (if (not (= (kernel-load-u8-4k state 4096 4) 1)) 66
            (if (not (= (kernel-load-u8-4k state 4096 5) 1)) 67
              (if (not (= (kernel-load-u8-4k state 4096 6) 1)) 68
                (if (= (kernel-load-u8-4k state 4096 7) 1) 0 69)))))))))

(defn ownership-eight-status [state]
  (let [claim-status (claim-eight-status state)]
    (if (not (= claim-status 0))
      claim-status
      (let [reuse-status (reclaim-status state)]
        (if (not (= reuse-status 0))
          reuse-status
          (ownership-read-status state))))))

(defn prepare-owned-pages [state pml4 pdpt pd pt]
  (if (= state 0) 40
    (if (= pml4 0) 41
      (if (= pdpt 0) 42
        (if (= pd 0) 43
          (if (= pt 0) 44
            (let [zero-status (zero-five-status state pml4 pdpt pd pt)]
              (if (not (= zero-status 0))
                zero-status
                (ownership-eight-status state)))))))))

(defn prepare-extra-pages [reusable-page frame-page stack-page]
  (if (not (= (zero-page reusable-page 0) 1))
    25
    (if (not (= (zero-page frame-page 0) 1))
      26
      (if (not (= (zero-page stack-page 0) 1))
        27
        (if (= (kernel-load-u8-4k reusable-page 4096 4095) 0) 0 28)))))

(defn claim-nic-slots-status [state]
  (if (not (= (claim-slot state 8) 1)) 73
    (if (not (= (claim-slot state 9) 1)) 74
      (if (not (= (claim-slot state 10) 1)) 75
        (if (not (= (claim-slot state 11) 1)) 76
          (if (not (= (claim-slot state 12) 1)) 77
            (if (= (claim-slot state 13) 1) 0 78)))))))

(defn prepare-nic-pages [directory-a directory-b dma-pages]
  (let [tx (kernel-subregion dma-pages 16384 0 4096)
        rx (kernel-subregion dma-pages 16384 4096 4096)
        tx-frame (kernel-subregion dma-pages 16384 8192 4096)
        rx-frame (kernel-subregion dma-pages 16384 12288 4096)]
    (if (not (= (zero-page directory-a 0) 1)) 79
      (if (not (= (zero-page directory-b 0) 1)) 80
        (if (not (= (zero-page tx 0) 1)) 81
          (if (not (= (zero-page rx 0) 1)) 82
            (if (not (= (zero-page tx-frame 0) 1)) 83
              (if (= (zero-page rx-frame 0) 1) 0 84))))))))

(defn prepare-rtl-page-tables [pdpt directory-a directory-b bar-a bar-b]
  (if (and (= bar-a 0) (= bar-b 0))
    true
    (if (and (> bar-a 0) (> bar-b 0)
             (= (quot bar-a 1073741824) (quot bar-b 1073741824)))
      (and (= (rtl/install-directory pdpt directory-a bar-a) 1)
           (= (rtl/install-bar-page directory-a bar-b) 1))
      (and (if (> bar-a 0)
             (= (rtl/install-directory pdpt directory-a bar-a) 1)
             true)
           (if (> bar-b 0)
             (= (rtl/install-directory pdpt directory-b bar-b) 1)
             true)))))

(defn qualify-rtl8125 [bar-a bar-b dma-pages]
  (if (> bar-a 0)
    (let [first-result (rtl/qualify 2 bar-a dma-pages)]
      (if (= first-result 0)
        0
        (if (and (> bar-b 0) (= (rtl/quiesce 2 bar-a) 1))
          (rtl/qualify 3 bar-b dma-pages)
          first-result)))
    (if (> bar-b 0) (rtl/qualify 3 bar-b dma-pages) -1)))

(defn prepare-page-tables [pml4 pdpt pd pt]
  (and (= (store64-page pml4 0 (+ pdpt 3)) 1)
       (= (store64-page pdpt 0 (+ pd 3)) 1)
       (= (store64-page pd 0 (+ pt 3)) 1)
       (= (fill-identity-pd pd 1) 1)
       (= (load64-page pml4 0) (+ pdpt 3))
       (= (load64-page pdpt 0) (+ pd 3))
       (= (load64-page pd 0) (+ pt 3))
       (= (kernel-load-u8-4k pd 4096 15) 128)
       (= (kernel-load-u8-4k pd 4096 4095) 128)))

(defn prepare-low-page-table [pt rx-limit rw-start]
  (and (= (fill-low-pt pt 0 rx-limit rw-start) 1)
       (= (load64-page pt 2048) 0)
       (= (load64-page pt 2056) 1052673)
       (= (load64-page pt (* (- (quot rx-limit 4096) 1) 8))
          (- rx-limit 4095))
       (if (< rx-limit rw-start)
         (= (load64-page pt (* (quot rx-limit 4096) 8)) 0)
         true)
       (= (kernel-load-u8-4k pt 4096
                             (+ (* (quot rw-start 4096) 8) 7)) 128)))

(defn enable-page-protection []
  (if (and (>= (kernel-cpuid-eax 2147483648 0) 2147483649)
           (not (= (bit-and (kernel-cpuid-edx 2147483649 0) 1048576) 0)))
    (let [efer (kernel-read-msr 3221225600)
          nxe (bit-or efer 2048)
          efer-written (kernel-write-msr 3221225600 nxe)
          cr0 (kernel-read-cr0)
          wp (bit-or cr0 65536)
          cr0-written (kernel-write-cr0 wp)]
      (and (= efer-written nxe)
           (= (bit-and (kernel-read-msr 3221225600) 2048) 2048)
           (= cr0-written wp)
           (= (bit-and (kernel-read-cr0) 65536) 65536)))
    false))

(defn activate-page-tables [pml4]
  (let [written (kernel-write-cr3 pml4)
        active (kernel-read-cr3)
        flushed (kernel-invlpg 1048576)]
    (and (= written pml4)
         (= (+ active (* 0 flushed)) pml4))))

;; The IDT storage is allocator-owned and remains RW+NX under the replacement
;; map. The backend contributes only the address of its sealed non-returning
;; entry; Kotoba constructs vector 14 and the pseudo-descriptor byte layout.

;; ── the two faults that leave nothing behind ─────────────────────────────
;;
;; A page fault has had a handler and a recovery frame for a long time. #UD and
;; #GP have had neither, so `ud2` (which is how fuel exhaustion ends) and any
;; bad access outside the paging path take the machine straight to a triple
;; fault. It dies silently, and the two instruments that could have said where
;; both die with it: the netlog is fire-and-forget UDP that stops when the
;; machine stops, and the loader's STATUS panel is only reached when `main`
;; RETURNS, which a fault prevents by definition.
;;
;; Measured 2026-09-08: the run ends at 12, 27, 33, 34, 38, 62, 64, 65, 70, 73
;; and 94 cycles across boots -- varying, so not a budget being exhausted at a
;; fixed point -- and not once did anything survive to say why.
;;
;; These two handlers change that in the only way available. They write the
;; vector number into a page that survives a warm reset, then reset the
;; platform. The next boot reads the byte and puts it on the wire. So a fault
;; stops being a death and becomes two facts: the board comes back on its own,
;; and the next boot says which vector killed the last one.
;;
;; Gates 6 and 13 sit at IDT offsets 96 and 208, both inside the limit of 239
;; the page-fault installer already sets, so no descriptor moves.
;;
;; The mark lives at offset1024 of the loader-owned IDT scratch page.
;; ISR entries restore the image context; the bounded constructor obtains
;; slot5 directly, without treating a pointer loaded from boot-info as a root.
(defn record-fault-and-reset [vector]
  ;; The trusted pre-main initializer seals the same loader allocation for
  ;; main and every callback. No helper returns an untracked pointer here.
  (let [page (kernel-owned-page 5)
        ;; Say so on the debug port BEFORE resetting.  A reset under -no-reboot
        ;; makes QEMU exit 0 with the trace simply stopping, which is
        ;; indistinguishable from a triple fault, a firmware dead-loop, or a
        ;; hang -- three different bugs with one appearance.  These two bytes
        ;; are the only thing that tells them apart, and the scratch-page record
        ;; below cannot: it is read by the NEXT boot, and -no-reboot means there
        ;; isn't one.
        bang (serial/trace-byte 33)
        digit (serial/trace-byte (+ 48 (if (< vector 10) vector 9)))
        mark (kernel-store-u8-4k page 4096 1024
                                 (+ vector (* 0 (+ bang digit))))
        ;; 0xCF9 <- 0x06. If the chipset ignores it the machine simply hangs
        ;; as it did before, which is no worse than the state this replaces.
        reset (kernel-out-u8 3321 (+ 6 (* 0 mark)))]
    (+ 0 (* 0 reset))))

;; The native image profile emits a64-vector table. Only #UD is exported
;; by this kernel today; other slots retain their separate canned/absent
;; policies. The callback ABI is (vector,error,rip,rsp), all scalar values.
(defn aiueos-isr-6 [vector error rip rsp]
  (+ (record-fault-and-reset 6) (* 0 (+ vector error rip rsp))))

(defn install-fault-gate [idt-page vector entry]
  (let [selector (kernel-read-cs)
        gate-offset (* vector 16)
        handler-low (bit-and entry 65535)
        handler-mid (bit-and (quot entry 65536) 65535)
        handler-high (bit-and (quot entry 4294967296) 4294967295)
        gate-low (+ handler-low
                    (* selector 65536)
                    (* 142 1099511627776)
                    (* handler-mid 281474976710656))]
    (if (and (> entry 0) (> selector 0) (<= selector 65535)
             (= (store64-page idt-page gate-offset gate-low) 1)
             (= (store64-page idt-page (+ gate-offset 8) handler-high) 1)
             (= (load64-page idt-page gate-offset) gate-low))
      1
      0)))

(defn install-page-fault-idt [idt-page rx-limit]
  (let [handler (kernel-page-fault-handler-address)
        selector (kernel-read-cs)
        handler-low (bit-and handler 65535)
        handler-mid (bit-and (quot handler 65536) 65535)
        handler-high (bit-and (quot handler 4294967296) 4294967295)
        gate-low (+ handler-low
                    (* selector 65536)
                    (* 142 1099511627776)
                    (* handler-mid 281474976710656))]
    ;; The handler is compiler-emitted executable text. Bind it to this exact
    ;; artifact's admitted RX boundary instead of the older 0x10c000 size;
    ;; adding the pure TCP module legitimately grows text within that segment.
    (if (and (>= handler 1052672) (< handler rx-limit)
             (> selector 0) (<= selector 65535)
             (= (store64-page idt-page 224 gate-low) 1)
             (= (store64-page idt-page 232 handler-high) 1)
             (= 0 (* 0 (kernel-store-u8-4k idt-page 4096 512 239)))
             (= 0 (* 0 (kernel-store-u8-4k idt-page 4096 513 0)))
             (= (store64-page idt-page 514 idt-page) 1)
             (= (load64-page idt-page 224) gate-low)
             (= (load64-page idt-page 232) handler-high)
             (= (kernel-load-u8-4k idt-page 4096 512) 239)
             (= (kernel-load-u8-4k idt-page 4096 513) 0)
             (= (load64-page idt-page 514) idt-page))
      (let [descriptor (kernel-subregion idt-page 4096 512 10)]
        (kernel-load-idt descriptor 10))
      0)))

(defn recoverable-frame-valid [frame-page stack-page probe]
  (if (= probe 424242)
    1
    (if (and (= probe 0)
             (= (load64-page frame-page 0) 1048576)
             (= (bit-and (load64-page frame-page 8) 3) 2)
             (> (load64-page frame-page 16) 1052672)
             (= (load64-page frame-page 24) (+ stack-page 4080)))
      (if (= (serial/trace-byte 69) 69) 1 0)
      0)))

;; Mutation scripts replace this exact body with one sealed hardware access.
;; Keeping the positive artifact free of a dormant arbitrary-address branch
;; makes each fault receipt attributable to the compiled probe it contains.
(defn page-fault-probe []
  (+ 424200 42))

(defn main []
  ;; The UART comes up before anything has something to say. It costs seven
  ;; port writes and it is the only transport this kernel has that survives the
  ;; NIC not being ready -- or being reset out from under it.
  (let [_uart (serial/serial-init)
        boot (kernel-boot-info)
        boot-header (kernel-subregion boot 16544 0 160)
        cr3 (kernel-read-cr3)
        map-size (load64-boot boot 16544 24)
        descriptor-size (load64-boot boot 16544 32)
        rx-limit (load64-boot boot 16544 56)
        rw-start (load64-boot boot 16544 64)
        rw-end (load64-boot boot 16544 72)
        scratch-start (load64-boot boot 16544 80)
        scratch-pages (load64-boot boot 16544 88)
        framebuffer-base (load64-boot boot 16544 112)
        framebuffer-size (load64-boot boot 16544 120)
        framebuffer-width (load32-boot boot 16544 128)
        framebuffer-height (load32-boot boot 16544 132)
        framebuffer-stride (load32-boot boot 16544 136)
        framebuffer-format (load32-boot boot 16544 140)
        memory-map (kernel-subregion boot 16544 160 16384)]
    (if (and (> boot 0) (> cr3 0)
             (= (kernel-load-u8 boot-header 160 0) 65)
             (= (kernel-load-u8 boot-header 160 1) 73)
             (= (kernel-load-u8 boot-header 160 2) 85)
             (= (kernel-load-u8 boot-header 160 3) 69)
             (= (kernel-load-u8 boot-header 160 4) 66)
             (= (kernel-load-u8 boot-header 160 5) 79)
             (= (kernel-load-u8 boot-header 160 6) 79)
             (= (kernel-load-u8 boot-header 160 7) 84)
             (= (load64-boot boot 16544 8) 6)
             (= (load64-boot boot 16544 16) memory-map)
             (> map-size 0)
             ;; 16368, not 16384: the last 16 bytes of the map window hold
             ;; the loader's own text address, which the loader writes after
             ;; the map.  A map that reaches them would be read back with its
             ;; tail overwritten, so refuse it instead of trusting the tail.
             (<= map-size 16368)
             (>= descriptor-size 40)
             (<= descriptor-size map-size)
             (> (load64-boot boot 16544 40) 0)
             (> rx-limit 1052672)
             (= (bit-and rx-limit 4095) 0)
             (>= rw-start rx-limit)
             (= (bit-and rw-start 4095) 0)
             (> rw-end rw-start)
             (= (bit-and rw-end 4095) 0)
             (< rw-end 1073741824)
             (> scratch-start 0)
             (= (bit-and scratch-start 4095) 0)
             (= scratch-pages 15)
             ;; GOP is optional for the general boot profile; when present its
             ;; geometry and pixel format must describe a bounded linear mode.
             (or (= framebuffer-base 0)
                 (and (> framebuffer-size 0)
                      (>= framebuffer-width 320)
                      (>= framebuffer-height 200)
                      (>= framebuffer-stride framebuffer-width)
                      (<= framebuffer-format 1)
                      (<= (* (* framebuffer-stride framebuffer-height) 4)
                          framebuffer-size)))
             (<= (+ scratch-start 61440) 549755813888))
      (let [map-marker (serial/trace-byte 77)
            ;; Boot-info v5 carries the exact fifteen-page EfiLoaderData
            ;; allocation made by Amu before the final memory map.
            physical-start scratch-start]
        (if (> physical-start 0)
          (let [second-start (+ physical-start 4096)
                third-start (+ physical-start 8192)
                fourth-start (+ physical-start 12288)
                fifth-start (+ physical-start 16384)
                sixth-start (+ physical-start 20480)
                seventh-start (+ physical-start 24576)
                eighth-start (+ physical-start 28672)
                ninth-start (+ physical-start 32768)
                tenth-start (+ physical-start 36864)
                eleventh-start (+ physical-start 40960)
                twelfth-start (+ physical-start 45056)
                thirteenth-start (+ physical-start 49152)
                fourteenth-start (+ physical-start 53248)
                ;; Fifteen sealed slots0..14; slots15..17 do not exist.
                ;; Slots10..13 own the RX DMA window. Slot14 is the CPU RX
                ;; snapshot, separate from DMA and stream log/TX staging.
                ;; Browser must obtain a distinct image-owned workspace.
                ;; The LAN2 debug plane takes its 16 KiB from
                ;; the pages the CR3 branch would have used instead; see the
                ;; stream branch below (ADR-0156).
                bar-a (rtl/bar-for-bus 2)
                bar-b (rtl/bar-for-bus 3)]
            (if (and (five-distinct physical-start second-start third-start
                                    fourth-start fifth-start)
                     (> sixth-start 0) (< sixth-start 549755813888)
                     (not (= sixth-start physical-start))
                     (not (= sixth-start second-start))
                     (not (= sixth-start third-start))
                     (not (= sixth-start fourth-start))
                     (not (= sixth-start fifth-start))
                     (> seventh-start 0) (> eighth-start 0)
                     (< eighth-start 549755813888)
                     (not (= seventh-start physical-start))
                     (not (= seventh-start second-start))
                     (not (= seventh-start third-start))
                     (not (= seventh-start fourth-start))
                     (not (= seventh-start fifth-start))
                     (not (= seventh-start sixth-start))
                     (not (= eighth-start physical-start))
                     (not (= eighth-start second-start))
                     (not (= eighth-start third-start))
                     (not (= eighth-start fourth-start))
                     (not (= eighth-start fifth-start))
                     (not (= eighth-start sixth-start))
                     (not (= eighth-start seventh-start))
                     (> ninth-start eighth-start)
                     (> tenth-start ninth-start)
                     (> eleventh-start tenth-start)
                     (> twelfth-start eleventh-start)
                     (> thirteenth-start twelfth-start)
                     (> fourteenth-start thirteenth-start)
                     (< fourteenth-start 549755813888))
                  ;; Constructors derive only the sealed loader allocation.
                  ;; Public metadata and literal addresses cannot mint regions.
                  (let [state (kernel-owned-page 0)
                        page-table-root (kernel-owned-page 1)
                        pdpt (kernel-owned-page 2)
                        pd (kernel-owned-page 3)
                        pt (kernel-owned-page 4)
                        reusable-page (kernel-owned-page 5)
                        frame-page (kernel-owned-page 6)
                        stack-page (kernel-owned-page 7)
                        rtl-directory-a (kernel-owned-page 8)
                        rtl-directory-b (kernel-owned-page 9)
                        rtl-dma-pages (kernel-owned-window 10 16384)
                        owned-status (prepare-owned-pages
                                      state page-table-root pdpt pd pt)
                        extra-status (prepare-extra-pages
                                      reusable-page frame-page stack-page)
                        nic-owned-status (if (= owned-status 0)
                                           (claim-nic-slots-status state)
                                           85)
                        nic-pages-status (if (and (= owned-status 0)
                                                  (= extra-status 0)
                                                  (= nic-owned-status 0))
                                           (prepare-nic-pages
                                            rtl-directory-a rtl-directory-b
                                            rtl-dma-pages)
                                           86)]
                    (if (and (= map-marker 77)
                             (= owned-status 0)
                             (= extra-status 0)
                             (= nic-owned-status 0)
                             (= nic-pages-status 0))
                      ;; The UEFI PXE path has just used this BAR and therefore
                      ;; supplies a known-good mapping until CR3 is replaced.
                      ;; Qualify a physical RTL8125 once under that mapping so
                      ;; the wire receipt separates provider faults from faults
                      ;; in AIUEOS's replacement page tables.  The no-device
                      ;; QEMU gate keeps exercising the complete CR3/IDT path.
