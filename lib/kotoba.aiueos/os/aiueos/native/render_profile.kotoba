;; JUN-502: numeric-only renderer profiling in unused effects words88..127.
;; Raw TSC cycles are not display latency. Convert only with a valid calibrated
;; clock; compare QEMU with QEMU and physical hardware with itself.
;; No allocation, new grant, user text, key data, or persistent state.
(ns aiueos.native.render-profile
  (:export [start phase composed finish mode read64 value tile-time]))

(defn value [i]
  (kernel-load-u32-16k (kernel-desktop-effects) 16384 (* i 4)))
(defn put [i v]
  (kernel-store-u32-16k (kernel-desktop-effects) 16384 (* i 4) v))
(defn read64 [i] (+ (value i) (* (value (+ i 1)) 4294967296)))
(defn store64 [i v]
  (do (put i (bit-and v 4294967295)) (put (+ i 1) (u64-shift-right v 32))))
(defn start []
  (let [now (kernel-rdtsc)]
    (do (store64 88 now) (store64 90 now) (put 111 2)
        (store64 120 0) (store64 122 0))))
(defn phase [slot]
  (let [now (kernel-rdtsc) before (read64 90)]
    (do (store64 slot (if (>= now before) (- now before) 0)) (store64 90 now))))
(defn mode [cursor-only] (put 111 cursor-only))
(defn tile-time [slot before]
  (let [now (kernel-rdtsc)]
    (if (>= now before) (store64 slot (+ (read64 slot) (- now before))) 0)))
(defn composed []
  (do (phase 96)
      (if (= (value 111) 0)
        (let [cycles (read64 96)]
          (do (store64 102 cycles)
              (if (> cycles (read64 104)) (store64 104 cycles) 0)
              (put 108 (+ (value 108) 1))))
        (if (= (value 111) 1)
          (do (store64 106 (read64 96)) (put 109 (+ (value 109) 1))) 0))))
(defn finish []
  (let [now (kernel-rdtsc) before (read64 88)]
    (do (store64 100 (if (>= now before) (- now before) 0))
        (if (= (value 111) 0)
          (do (store64 112 (read64 92)) (store64 114 (read64 94))
              (store64 116 (read64 98)) (store64 118 (read64 100))
              (store64 124 (read64 120)) (store64 126 (read64 122))) 0)
        (put 110 (+ (value 110) 1)))))
