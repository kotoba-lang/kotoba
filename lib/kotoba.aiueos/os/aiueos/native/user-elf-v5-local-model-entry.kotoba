(ns aiueos.native.user-elf-v5-local-model-entry
  (:require [aiueos.native.kernel :as kernel]
            [aiueos.native.desktop :as desktop]
            [aiueos.value-runtime-entry :as runtime]
            [aiueos.value-runtime-syscall-plan :as syscall]
            [aiueos.value-runtime-domain :as domain]
            [aiueos.value-runtime-capability-table :as capability]
            [aiueos.value-runtime-provider-policy :as provider]
            [aiueos.value-runtime-provider-transport :as transport]
            [aiueos.value-runtime-cas-verify :as cas]
            [aiueos.sha256 :as sha]
            [aiueos.native.draft-store :as draft-store]
            [aiueos.native.llm-v1-local-request :as llm-local]
            [aiueos.native.llm-v1-ticket :as ticket]
            [native.micro-infer :as model])
  (:export [main aiueos-value-runtime-entry aiueos-value-runtime-syscall-plan
            aiueos-value-runtime-publish-domain
            aiueos-value-runtime-provider-status
            aiueos-value-runtime-capability-grant
            aiueos-value-runtime-provider-claim
            aiueos-value-runtime-provider-complete
            aiueos-value-runtime-cas-verify]))

;; C-free integration image root. The ordinary boot entry remains the native
;; kernel's main function; the ValueRuntime entry is linked into the same
;; sealed KIR/native image instead of being supplied as a foreign object.

;; The v5 profile owns vector6's controlled #UD entry. Keep the legacy kernel
;; declaration in the retained graph, without exporting a conflicting vector.
(defn aiueos-isr-6 [vector :i64 error :i64 rip :i64 rsp :i64] :i64
  (kernel/aiueos-isr-6 vector error rip rsp))

;; Syscall5 receives a trusted domain/page profile from the native handler.
;; The user-v5 compiler still writes the version-2, 104-byte diagnostic request at
;; context+128. It carries the complete bounded Goal, not just its final
;; character. The host consumes the current UI choice before examining the
;; untrusted bytes, so a second call cannot reuse it. The volatile ticket
;; additionally binds this diagnostic call to the staged Goal, process page,
;; domain, diagnostic generation and fixed model identity. It is not a grant
;; for canonical wire 11 or a real model.
(defn- zero-tail? [source :i64 index :i64] :bool
  (if (= index 104) true
    (and (= (kernel-load-u8 source 104 index) 0)
         (zero-tail? source (+ index 1)))))
(defn- prompt-matches? [source :i64 surface :i64 length :i64 index :i64] :bool
  (if (= index length) true
    (let [value (kernel-load-u8 source 104 (+ 12 index))
          shown (surface-word surface (+ 236 index))]
      (and (= value shown)
           (or (= value 32) (and (>= value 97) (<= value 122)))
           (prompt-matches? source surface length (+ index 1))))))
(defn- local-model-syscall
  [arena :i64 profile :i64 user-page :i64
   kernel-request :i64 cap-table :i64] :i64
  (let [offset (bit-and profile 65535)
        expected-profile (+ offset (* 73 65536) (* 4096 4294967296)
                            (* 104 281474976710656))
        context (kernel-browser-context)
        surface (kernel-browser-surface)
        approval (kernel-subregion context 8192 352 4)
        token-slot (kernel-subregion context 8192 356 4)
        ticket-state (kernel-subregion context 8192 384 72)
        was-approved (kernel-load-u32 approval 4 0)
        consumed-approval (kernel-store-u32 approval 4 0 0)
        page (kernel-owned-page 0)
        workspace (kernel-subregion page 4096 0 352)
        digest (kernel-subregion page 4096 512 32)
        goal-page (kernel-value-domain-request-page 73)
        digest-ready (if (> goal-page 0)
                       (sha/aiueos-sha256
                        (kernel-subregion goal-page 4096 256 64) 64
                        digest workspace 352) 0)
        admitted (ticket/aiueos-llm-v1-ticket-consume
                   ticket-state 72 73 (kernel-value-domain-code-page 73)
                   1 1 digest (if (= digest-ready 1) 32 0))]
    (if (and (= was-approved 1)
             (= (kernel-load-u32 approval 4 0) 0)
             (= admitted 1)
             (= profile expected-profile) (<= offset 3992)
             (= (kernel-current-domain) 73)
             (= arena (kernel-value-runtime-arena 73))
             (= user-page (kernel-value-domain-request-page 73))
             (= kernel-request (kernel-value-runtime-request))
             (= cap-table (kernel-value-runtime-capability-table))
             (= (kernel-load-u32 (kernel-subregion context 8192 344 4) 4 0) 4))
      (let [source (kernel-subregion user-page 4096 offset 104)
            body-length (surface-word surface 2038)
            goal-length (- body-length 12)
            last-codepoint (if (> goal-length 0)
                             (surface-word surface (+ 235 goal-length)) 0)
            request-length (kernel-load-u32 source 104 8)]
        (if (and (= (kernel-load-u32 approval 4 0) 0)
                 (= (kernel-load-u32 source 104 0) 1364350539)
                 (= (kernel-load-u8 source 104 4) 2)
                 (= (kernel-load-u8 source 104 5) 6)
                 (= (kernel-load-u8 source 104 6) 0)
                 (= (kernel-load-u8 source 104 7) 0)
                 (> goal-length 0) (<= goal-length 51)
                 (= request-length goal-length)
                 (prompt-matches? source surface goal-length 0)
                 (zero-tail? source (+ 12 goal-length))
                 (= (llm-local/aiueos-llm-v1-local-request-valid
                      source 104 goal-length) 1)
                 (>= last-codepoint 97) (<= last-codepoint 122))
          (let [vocab (model/vocab-index last-codepoint)
                row (if (< vocab 27) (model/micro-infer-row vocab) 0)
                token (if (and (> (model/micro-infer-score row) 0)
                               (> (model/micro-infer-total row) 0))
                        (model/micro-infer-token row) 0)
                expected-generation
                  (kernel-load-u32
                   (kernel-subregion context 8192 320 4) 4 0)
                attempt
                  (if (> token 0)
                    (draft-store/commit-result
                     expected-generation token)
                    -1)
                ;; Require the commit's success result and independently
                ;; re-read its published head and slot before showing it.
                ;; A refused repeat cannot reuse a prior diagnostic token.
                verified
                  (if (= attempt (+ expected-generation 1))
                    (draft-store/restore surface) -34)]
            (if (and (> token 0)
                     (= verified (+ expected-generation 1))
                     (= (kernel-load-u32 token-slot 4 0) token))
              (do (kernel-store-u32
                   (kernel-subregion context 8192 320 4) 4 0 verified)
                  (desktop/show-diagnostic-result token)
                  (if (= (kernel-load-u32
                          (kernel-subregion context 8192 320 4) 4 0)
                         verified)
                    token 0))
              0))
          0))
      0)))

(defn aiueos-value-runtime-entry
  [arena :i64 entry-profile :i64 user-page :i64
   kernel-request :i64 cap-table :i64] :i64
  (let [context (kernel-browser-context)]
    ;; Route every syscall from this diagnostic user profile through the
    ;; one-use admission path. A malformed mode or profile cannot preserve
    ;; the user's prior choice for a corrected second call.
    (if (and (= (kernel-current-domain) 73)
             (= (kernel-load-u32
                  (kernel-subregion context 8192 344 4) 4 0) 4))
      (local-model-syscall
       arena entry-profile user-page kernel-request cap-table)
      (runtime/aiueos-value-runtime-entry
       arena entry-profile user-page kernel-request cap-table))))

(defn aiueos-value-runtime-syscall-plan
  [number :i64 domain :i64 pointer :i64 user-rip :i64 user-rsp :i64] :i64
  (syscall/aiueos-value-runtime-syscall-plan
   number domain pointer user-rip user-rsp))

(defn aiueos-value-runtime-publish-domain [current-domain :i64] :i64
  (domain/aiueos-value-runtime-publish-domain current-domain))

(defn aiueos-value-runtime-provider-status
  [generation :i64 active :i64] :i64
  (provider/aiueos-value-runtime-provider-status generation active))

(defn aiueos-value-runtime-capability-grant
  [action :i64 slot :i64 generation :i64 rights :i64 owner :i64] :i64
  (provider/aiueos-value-runtime-capability-grant
   action slot generation rights owner))

(defn aiueos-value-runtime-provider-complete
  [ticket :i64 route-domain :i64 block :i64
   block-length :i64 descriptor :i64] :i64
  (transport/aiueos-value-runtime-provider-complete
   ticket route-domain block block-length descriptor))

(defn aiueos-value-runtime-provider-claim [] :i64
  (transport/aiueos-value-runtime-provider-claim))

(defn aiueos-value-runtime-cas-verify
  [block :i64 block-length :i64 expected :i64
   output :i64 workspace :i64] :i64
  (cas/aiueos-value-runtime-cas-verify
   block block-length expected output workspace))

;; The opt-in diagnostic profile commits a saved Goal and one local result
;; token to the marked draft disk. It does not serialize code, authority,
;; approval, lease or user pages.
;; The local model confirmation is transient and never restored as authority.
;; The dual-payload EFI keeps the font in its first 512 KiB and the user-v5
;; slot in its second. The compiler-provided region root is limited to the
;; second half; whole-ELF SHA-256 and exact segment layout are checked here.
;; The 256 KiB RW user region is mapped but this legacy diagnostic only
;; initializes and calls through its first 4 KiB. It is not a signed app
;; catalogue, typed llm-v1 provider or agent loop.
(defn- digest-ok [payload :i64 length :i64] :bool
  (let [page (kernel-owned-page 0)
        workspace (kernel-subregion page 4096 0 352)
        digest (kernel-subregion page 4096 512 32)
        hashed (sha/aiueos-sha256 payload length digest workspace 352)]
    (and (= hashed 1)
         (= (kernel-load-u64 digest 32 0) 7366730624431529953)
         (= (kernel-load-u64 digest 32 8) 2677909983132734919)
         (= (kernel-load-u64 digest 32 16) 5920012007782228614)
         (= (kernel-load-u64 digest 32 24) 5974140804787782795))))
(defn- copy-segment [payload :i64 length :i64 target :i64 target-length :i64
                     file-offset :i64 count :i64 index :i64] :bool
  (if (= index count) true
    (let [value (kernel-load-u8-16k payload length (+ file-offset index))
          written (kernel-store-u8-4k target target-length index value)]
      (and (= (kernel-load-u8-4k target target-length index) value)
           (copy-segment payload length target target-length file-offset count (+ index 1))))))
(defn- surface-word [surface :i64 index :i64] :i64
  (kernel-load-u32 (kernel-subregion surface 8192 (* index 4) 4) 4 0))
(defn- clear-goal [request :i64 index :i64] :bool
  (if (= index 64) true
    (let [written (kernel-store-u8-4k request 4096 (+ 256 index) 0)]
      (and (= (kernel-load-u8-4k request 4096 (+ 256 index)) 0)
           (clear-goal request (+ index 1))))))
(defn- copy-goal [surface :i64 request :i64 length :i64 index :i64] :bool
  (if (= index length) true
    (let [cp (surface-word surface (+ 236 index))]
      (if (not (or (= cp 32) (and (>= cp 97) (<= cp 122)))) false
        (let [written (kernel-store-u8-4k request 4096 (+ 260 index) cp)]
          (and (= (kernel-load-u8-4k request 4096 (+ 260 index)) cp)
               (copy-goal surface request length (+ index 1))))))))
(defn- write-goal [surface :i64 request :i64] :bool
  (let [body-length (surface-word surface 2038)
        goal-length (- body-length 12)]
    (if (or (<= goal-length 0) (> goal-length 51)) false
      (if (clear-goal request 0)
        (do (kernel-store-u32-4k request 4096 256 goal-length)
            (and (= (kernel-load-u32-4k request 4096 256) goal-length)
                 (copy-goal surface request goal-length 0)))
        false))))
(defn- stage-elf [code :i64 code-length :i64 request :i64 request-length :i64
                 surface :i64] :bool
  (let [slot (kernel-user-slot)
        header (kernel-subregion slot 524288 0 64)
        image (kernel-subregion slot 524288 64 8280)]
    (if (and (= (kernel-load-u64 header 64 0) 0x0031444c50554941)
             (= (kernel-load-u64 header 64 8) 4)
             (= (kernel-load-u64 header 64 16) 8280)
             (= (kernel-load-u64-16k image 8280 0) 0x00010102464c457f)
             (= (kernel-load-u64-16k image 8280 24) code)
             (= (kernel-load-u64-16k image 8280 80) code)
             (= (kernel-load-u64-16k image 8280 136) request)
             (= (kernel-load-u64-16k image 8280 96) 478)
             (= (kernel-load-u64-16k image 8280 152) 88)
             (= (kernel-load-u64-16k image 8280 160) 262144)
             (digest-ok image 8280))
      (and (copy-segment image 8280 code code-length 4096 478 0)
           (copy-segment image 8280 request request-length 8192 88 0)
           (write-goal surface request))
      false)))
(defn main [] :i64
  (let [published (kernel-value-runtime-invoke 2 73 0 0 0 0)
        submitted (if (= published 73) (desktop/goal-model-main) 0)
        code (kernel-value-domain-code-page 73)
        request (kernel-value-domain-request-page 73)
        stack (kernel-value-domain-stack-page 73)
        surface (kernel-browser-surface)
        context (kernel-browser-context)
        approval (kernel-load-u32 (kernel-subregion context 8192 352 4) 4 0)
        staged (if (and (= submitted 1) (= approval 1)
                        (> code 0) (> request code) (> stack request))
                 (stage-elf code 4096 request 4096 surface) false)
        page (kernel-owned-page 0)
        workspace (kernel-subregion page 4096 0 352)
        digest (kernel-subregion page 4096 512 32)
        hashed (if staged
                 (sha/aiueos-sha256
                  (kernel-subregion request 4096 256 64) 64
                  digest workspace 352) 0)
        issued (if (= hashed 1)
                 (ticket/aiueos-llm-v1-ticket-issue
                  (kernel-subregion context 8192 384 72) 72
                  approval 73 code 1 1 digest 32) 0)
        enabled (if (= issued 1) (kernel-value-enable-user) 0)]
    (if (= enabled 1) (kernel-value-enter-user 73) 0)))
