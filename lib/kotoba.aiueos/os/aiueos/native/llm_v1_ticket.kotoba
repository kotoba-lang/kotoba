(ns aiueos.native.llm-v1-ticket
  (:export [aiueos-llm-v1-ticket-issue aiueos-llm-v1-ticket-consume]))

;; Host-owned, volatile one-use admission record for wire 11. The caller must
;; supply a trusted process identity, capability generation, selected model
;; identity, a digest of the canonical request, and a direct approval result.
;; This record is not a capability: the model allowlist, budget, process
;; lifetime and provider dispatch remain separate host checks. Never place
;; this state in a user page or a restored workspace.
;;
;; 72 bytes: magic, domain, process, capability generation, selected model,
;; request digest (four u64 words). All fields are little-endian u64.
(def TICKET-MAGIC 0x31544b4c)

;; Invalidate before comparing, then erase the remaining host-owned record
;; before returning to the provider path. In particular the request digest
;; must not survive a successful call, a mismatch, or an explicit denial.
(defn- clear-state [state :i64 index :i64] :bool
  (if (= index 9) true
    (let [offset (* index 8)
          written (kernel-store-u64 state 72 offset 0)
          zero? (= (kernel-load-u64 state 72 offset) 0)
          rest-clear? (clear-state state (+ index 1))]
      (and zero? rest-clear?))))

(defn- separate? [state :i64 digest :i64] :bool
  (and (> state 0) (> digest 0)
       (if (< state digest) (>= (- digest state) 72)
         (>= (- state digest) 32))))

(defn- digest-equal? [state :i64 digest :i64 index :i64] :bool
  (if (= index 4) true
    (and (= (kernel-load-u64 state 72 (+ 40 (* index 8)))
            (kernel-load-u64 digest 32 (* index 8)))
         (digest-equal? state digest (+ index 1)))))

(defn- copy-digest [state :i64 digest :i64 index :i64] :bool
  (if (= index 4) true
    (let [value (kernel-load-u64 digest 32 (* index 8))
          written (kernel-store-u64 state 72 (+ 40 (* index 8)) value)]
      (and (= (kernel-load-u64 state 72 (+ 40 (* index 8))) value)
           (copy-digest state digest (+ index 1))))))

(defn aiueos-llm-v1-ticket-issue
  [state :i64 state-bytes :i64 approved :i64 domain :i64 process :i64
   capability-generation :i64 selected-model :i64
   request-digest :i64 digest-bytes :i64] :i64
  (if (or (not= state-bytes 72) (<= state 0)) 0
    (let [cleared (clear-state state 0)]
      (if (and cleared
               (= approved 1) (> domain 0) (> process 0)
               (> capability-generation 0) (> selected-model 0)
               (= digest-bytes 32) (separate? state request-digest))
        (let [a (kernel-store-u64 state 72 8 domain)
              b (kernel-store-u64 state 72 16 process)
              c (kernel-store-u64 state 72 24 capability-generation)
              d (kernel-store-u64 state 72 32 selected-model)]
          (if (and (= (kernel-load-u64 state 72 8) domain)
                   (= (kernel-load-u64 state 72 16) process)
                   (= (kernel-load-u64 state 72 24) capability-generation)
                   (= (kernel-load-u64 state 72 32) selected-model)
                   (copy-digest state request-digest 0))
            (let [committed (kernel-store-u64 state 72 0 TICKET-MAGIC)]
              (if (= (kernel-load-u64 state 72 0) TICKET-MAGIC) 1 0))
            (if (clear-state state 0) 0 0)))
        0))))

(defn aiueos-llm-v1-ticket-consume
  [state :i64 state-bytes :i64 domain :i64 process :i64
   capability-generation :i64 selected-model :i64
   request-digest :i64 digest-bytes :i64] :i64
  (if (or (not= state-bytes 72) (<= state 0)) 0
    (let [live (kernel-load-u64 state 72 0)
          invalidated (kernel-store-u64 state 72 0 0)
          matched (and (= (kernel-load-u64 state 72 0) 0)
                       (= live TICKET-MAGIC)
                       (= digest-bytes 32) (separate? state request-digest)
                       (= (kernel-load-u64 state 72 8) domain)
                       (= (kernel-load-u64 state 72 16) process)
                       (= (kernel-load-u64 state 72 24) capability-generation)
                       (= (kernel-load-u64 state 72 32) selected-model)
                       (digest-equal? state request-digest 0))
          erased (clear-state state 0)]
      (if (and matched erased) 1 0))))
