(ns aiueos.native.remote-cmd
  ;; AWAI-119 stage 3: signed remote commands over the RTL8168 debug link.
  ;; Only the opt-in desktop debug entry polls this (context word 128 = 1);
  ;; every other entry has no receive path at all.
  ;;
  ;; A command is one UDP datagram to port 7798 whose 96-byte payload is
  ;;   0  "AIUECMD1"                 8 bytes
  ;;   8  boot nonce                 8 bytes, little endian
  ;;  16  counter                    8 bytes, little endian, > the last one
  ;;  24  command                    4 bytes, little endian
  ;;  28  argument                   4 bytes, little endian
  ;;  32  Ed25519 signature over bytes 0..31
  ;; under the key pinned below (its seed is held on the operator's Mac, never
  ;; in this repository). The nonce is drawn at boot and broadcast as KDBG
  ;; tag 0xc000, so a command signed for an earlier boot is refused, and the
  ;; counter refuses a repeat within the boot.
  ;;   1 ping        reply KDBG 0xc001 = counter
  ;;   2 reboot      reply KDBG 0xc002, then reset through port 0xCF9
  ;;   3 key         reply KDBG 0xc003 = scan code; the desktop handles the
  ;;                 make code as if the keyboard had sent it
  ;;   4 screenshot  frames to UDP 7797 (rtl8168-debug `shot`), then KDBG 0xc004
;;   5 update      pull and verify a signed image (native/update.kotoba, AWAI-122
;;                 stage 3; nothing is written), then KDBG 0xc120.. and 0xc005 =
;;                 the update result
;;   6 install     pull, verify and install a signed image as BOOTX64.EFI
;;                 (native/update.kotoba install, AWAI-122 stage 4), then KDBG
;;                 0xc120.., 0xc130.. and 0xc006 = the install result
  ;; A datagram to 7798 that fails a check is answered with KDBG 0xc0ff =
  ;; reason (2 magic, 3 nonce, 4 counter, 5 signature, 6 command); frames for
  ;; other ports are released silently.
  ;; Classical Ed25519 only: the kernel has no ML-DSA verifier yet, so this
  ;; diagnostic channel is below the repository's post-quantum floor (recorded
  ;; in AWAI-119); it is never part of a non-debug entry.
  ;;
  ;; State: context words 172/173 nonce, 174/175 last counter, 176 accepted,
  ;; 177 refused. The verifier uses context bytes 2048..2175 (key, signature,
  ;; message) and the Ed25519 workspace 4096..8191.
  (:require [aiueos.native.rtl8168-debug :as nic]
            [aiueos.native.render-profile :as profile]
            [aiueos.native.update :as update]
            [aiueos.native.xhci :as usb]
            [aiueos.native.bluetooth-le :as ble]
            [aiueos.native.bluetooth-sc :as sc] [aiueos.native.bluetooth-legacy :as legacy]
            [aiueos.native.bluetooth-hogp :as hogp]
            [aiueos.native.bluetooth-firmware :as firmware]
            [aiueos.ed25519 :as ed])
  (:export [init poll nonce rx-stats run-update pointer-command console-key-command band-valid]))

(defn word [region i]
  (kernel-load-u32 (kernel-subregion region 8192 (* i 4) 4) 4 0))
(defn put-word [region i value]
  (kernel-store-u32 (kernel-subregion region 8192 (* i 4) 4) 4 0 value))
(defn put-word64 [ctx i value]
  (do (put-word ctx i (bit-and value 4294967295))
      (put-word ctx (+ i 1) (bit-and (u64-shift-right value 32) 4294967295))))
(defn word64 [ctx i]
  (bit-or (word ctx i) (i64-shift-left (word ctx (+ i 1)) 32)))
(defn put-byte [ctx at v]
  (let [stored (kernel-store-u8 (kernel-subregion ctx 8192 at 1) 1 0 v)]
    (+ 1 (* 0 stored))))

;; The operator's public key (AWAI-119 debug link).
(defn key-byte [i]
  (bit-and (u64-shift-right (case (quot i 4) 0 3386494703 1 3565542278 2 3240484580 3 958013217 4 3872933539 5 237339020 6 2911591876 7 3684625567 0) (* (mod i 4) 8)) 255))
(defn magic-byte [i] (case i 0 65 1 73 2 85 3 69 4 67 5 77 6 68 7 49 0))

(defn nonce [ctx] (word64 ctx 172))

;; flags: context word 90, bit 0 = RDRAND (desktop entropy-flags).
(defn init [ctx flags]
  (let [drawn (if (= (bit-and flags 1) 1) (kernel-rdrand) 0)
        value (if (= drawn 0) (kernel-rdtsc) drawn)]
    (do (put-word64 ctx 172 value)
        (put-word64 ctx 174 0)
        (put-word ctx 176 0) (put-word ctx 177 0) (put-word ctx 178 0) (put-word ctx 179 0)
        (nic/log 49152 value)
        1)))

(defn payload-byte [i] (nic/rx-byte (+ 42 i)))
(defn payload-le [i n acc]
  (if (= n 0) acc
    (payload-le i (- n 1) (+ (i64-shift-left acc 8) (payload-byte (+ i (- n 1)))))))
(defn magic-ok [i]
  (if (>= i 8) 1
    (if (= (payload-byte i) (magic-byte i)) (magic-ok (+ i 1)) 0)))
(defn for-us []
  (and (>= (nic/rx-length) 142)
       (= (nic/rx-byte 12) 8) (= (nic/rx-byte 13) 0)
       (= (nic/rx-byte 23) 17)
       (= (nic/rx-byte 36) 30) (= (nic/rx-byte 37) 118)))

;; key at 2048, signature at 2080, message at 2144 (aiueos.ed25519 verify).
(defn stage [ctx i]
  (if (>= i 96) 1
    (let [a (put-byte ctx (+ 2048 i)
                      (if (< i 32) (key-byte i)
                        (if (< i 96) (payload-byte i) 0)))]
      (stage ctx (+ i (+ 1 (* 0 a)))))))
(defn stage-message [ctx i]
  (if (>= i 32) 1
    (let [a (put-byte ctx (+ 2144 i) (payload-byte i))]
      (stage-message ctx (+ i (+ 1 (* 0 a)))))))
(defn signature-ok [ctx]
  (let [a (stage ctx 0)
        b (stage-message ctx 0)
        v (ed/aiueos-ed25519-verify (kernel-subregion ctx 8192 2048 1024) 32
                                    (kernel-subregion ctx 8192 4096 4096))]
    (+ v (* 0 (+ a b)))))

(defn refuse [ctx reason]
  (do (put-word ctx 177 (+ (word ctx 177) 1))
      (nic/log 49407 reason)
      0))

;; Command7 selects a PCI xHCI BDF in profile6 only. It never pairs or
;; accepts non-boot input. c007=result; c170..172=active BDF/status/HID count;
;; c180..18b=descriptor metadata for two HID probes and one hub probe.
(defn usb-device-report [d]
  (if (>= d 3) 1
    (do (nic/log (+ 49536 (* d 4)) (usb/device-diagnostic d 0))
        (nic/log (+ 49537 (* d 4)) (usb/device-diagnostic d 1))
        (nic/log (+ 49538 (* d 4)) (usb/device-diagnostic d 2))
        (nic/log (+ 49539 (* d 4)) (usb/device-diagnostic d 3))
        (usb-device-report (+ d 1)))))
;; Per-port enumeration snapshots identify failed links independently of
;; accepted HID count. No reports, keys or peer addresses are emitted.
(defn usb-port-report [port]
  (if (> port (min 16 (bit-and (quot (usb/controller-diagnostic 0 1) 16777216) 255))) 1
    (do (nic/log (+ 49568 (* (- port 1) 2)) (usb/port-state 0 port))
        (nic/log (+ 49569 (* (- port 1) 2)) (usb/port-stage 0 port))
        (usb-port-report (+ port 1)))))
(defn usb-hub-report [port]
  (if (> port (usb/hub-ports)) 1
    (do (nic/log (+ 49600 (* (- port 1) 2)) (usb/hub-port-state port))
        (nic/log (+ 49601 (* (- port 1) 2)) (usb/hub-port-stage port))
        (usb-hub-report (+ port 1)))))
(defn bluetooth-report [i]
  (if (>= i 15) 1
    (do (nic/log (+ 49552 i) (usb/bluetooth-diagnostic i)) (bluetooth-report (+ i 1)))))
(defn ble-report [i]
  (if (>= i 10) 1
    (do (nic/log (+ 49616 i) (ble/diagnostic i)) (ble-report (+ i 1)))))
(defn initialize-ble [ctx argument]
  (let [result (ble/initialize argument)]
    (do (put-word ctx 138 (usb/result)) (ble-report 0)
        (nic/log 49161 result) 1)))
(defn hogp-report [i]
  (if (>= i 16) 1 (do (nic/log (+ 49632 i) (hogp/diagnostic i)) (hogp-report (+ i 1)))))
(defn operate-hogp [command]
  (let [result (case command 11 (hogp/scan) 12 (hogp/connect) 1)]
    (do (hogp-report 0) (nic/log (+ 49152 command) result) 1)))
(defn probe-bluetooth [ctx argument]
  (let [probed (usb/probe-bluetooth argument)]
    (do (put-word ctx 138 (usb/result))
        (nic/log 49520 (usb/diagnostic 6))
        (nic/log 49521 (usb/result)) (nic/log 49522 (usb/devices))
        (usb-device-report 0) (usb-port-report 1) (usb-hub-report 1) (bluetooth-report 0) (nic/log 49160 probed) 1)))
(defn select-usb [ctx argument]
  (let [selected (usb/select-controller argument)]
    (do (put-word ctx 138 (usb/result))
        (nic/log 49520 (usb/diagnostic 6))
        (nic/log 49521 (usb/result)) (nic/log 49522 (usb/devices))
        (usb-device-report 0) (usb-port-report 1) (usb-hub-report 1) (nic/log 49159 selected) 1)))

;; Update SHA scratch overlaps the sealed-key blob at3072..3711. Preserve
;; these bytes in stopped xHCI memory0..639; raw seed3712 and dapps3744+
;; are never touched. Restore BEFORE controller initialization reclaims it.
(defn update-snapshot [ctx restore i]
  (if (>= i 640) 1
    (do (if (= restore 1)
          (kernel-store-u32 (kernel-subregion ctx 8192 (+ 3072 i) 4) 4 0
            (kernel-load-u32-16k (kernel-owned-window 0 16384) 16384 i))
          (kernel-store-u32-16k (kernel-owned-window 0 16384) 16384 i
            (kernel-load-u32 (kernel-subregion ctx 8192 (+ 3072 i) 4) 4 0)))
        (update-snapshot ctx restore (+ i 4)))))
(defn run-update [ctx command]
  (let [input (= (word ctx 86) 6) slot (if input (usb/diagnostic 6) 0)
        stopped (if input (if (= (word ctx 87) 0) (usb/quiesce) 0) 1)]
    (if (= stopped 0) (do (nic/log (+ 49152 command) 51) 0)
      (do (if input (update-snapshot ctx 0 0) 0)
          (nic/rx-release)
          ;; command0 is the trusted component fixture, never admitted by
          ;; execute/check on the wire. It exercises the same borrow/restore
          ;; with the public signature/digest self-test and no disk write.
          (let [result (if (= command 0) (update/self-test ctx)
                         (if (= command 5) (update/pull ctx) (update/install ctx)))
                reported (+ (update/report ctx) (if (= command 6) (update/install-report ctx) 0))
                restored (if input (update-snapshot ctx 1 0) 1)
                resumed (if input (usb/select-controller slot) 0)]
            (do (if input (nic/log 49473 resumed) 0)
                (nic/log (+ 49152 command) (+ result (* 0 (+ reported restored))))
                (if input 1 0)))))))

;; Returns0, 1 after USB selection, or256 + a keyboard make code.
;; An unknown command is refused with reason 6 + 256 * command.
(defn render-report [ctx counter i]
  ;; c380..c397 are numeric renderer counters only, outside USB inventory.
  (if (>= i 24) (do (nic/log 49169 counter) 0)
    (let [v (if (= i 0) (word ctx 110)
              (if (<= i 8) (profile/read64 (+ 90 (* i 2)))
                (if (>= i 16) (profile/read64 (+ 112 (* (- i 16) 2)))
                  (profile/value (case i 9 108 10 109 11 110 12 78 13 79 14 111 15 80 0)))))]
      (do (nic/log (+ 50048 i) v) (render-report ctx counter (+ i 1))))))

;; Remote console ingress uses the same signature/nonce/counter gate. It
;; carries pixels/keys, never a capability approval. Motion/release can cross
;; a modal surface; presses and keys other than Deny/Escape cannot answer it.
(defn pointer-command [ctx argument counter geom]
  (let [x (bit-and argument 8191) y (bit-and (u64-shift-right argument 13) 8191)
        pressed (bit-and (u64-shift-right argument 26) 1)]
    (if (or (< argument 0) (>= argument 134217728) (>= x (bit-and geom 65535))
            (>= y (bit-and (u64-shift-right geom 16) 65535))) (refuse ctx 8)
      (if (and (> (word ctx 87) 0) (= pressed 1)) (refuse ctx 9)
        (do (nic/log 49170 counter) (+ 512 argument))))))
(defn console-key-command [ctx argument counter]
  (if (or (<= argument 0) (>= argument 128)) (refuse ctx 8)
    (if (and (> (word ctx 87) 0) (not (= argument 1)) (not (= argument 49))) (refuse ctx 9)
      (do (nic/log 49171 counter) (+ 256 argument)))))

(defn band-valid [argument geom] :bool
  (let [first (bit-and argument 65535) count (u64-shift-right argument 16)
        width (bit-and geom 65535) height (bit-and (u64-shift-right geom 16) 65535)]
    (and (>= argument 0) (> count 0) (<= count 32) (> width 0) (<= width 3200)
         (<= (+ first count) height))))
(defn band-command [ctx argument counter geom]
  (if (not (band-valid argument geom)) (refuse ctx 8)
    (let [sent (nic/band geom argument (word64 ctx 172) counter)
          expected (* (quot (+ (bit-and geom 65535) 199) 200) (u64-shift-right argument 16))]
      (if (= sent expected) (do (nic/log 49172 counter) 0) (refuse ctx 10)))))

(defn execute [ctx command argument counter geom]
  (do (put-word64 ctx 174 counter)
      (put-word ctx 176 (+ (word ctx 176) 1))
      (if (= command 18) (pointer-command ctx argument counter geom)
      (if (= command 19) (console-key-command ctx argument counter)
      (if (= command 20) (band-command ctx argument counter geom)
      (if (= command 17) (render-report ctx counter 0)
      (if (= command 1) (do (nic/log 49153 counter) 0)
        (if (= command 2)
          (do (nic/log 49154 counter)
              (kernel-out-u8 3321 2)
              (kernel-out-u8 3321 6)
              0)
          (if (and (= command 3) (> argument 0) (< argument 128))
            (do (nic/log 49155 argument) (+ 256 argument))
            (if (= command 4)
              (let [sent (nic/shot (bit-and geom 65535) (bit-and (u64-shift-right geom 16) 65535)
                                   (bit-and (u64-shift-right geom 32) 65535)
                                   (bit-and (u64-shift-right geom 48) 255))]
                (do (nic/log 49156 sent) 0))
              (if (= command 5) (run-update ctx command)
                (if (= command 6) (run-update ctx command)
                  (if (and (= command 7) (= (word ctx 86) 6))
                    (select-usb ctx argument)
                    (if (and (= command 8) (= (word ctx 86) 6))
                      (probe-bluetooth ctx argument)
                      (if (and (= command 9) (= (word ctx 86) 6))
                        (initialize-ble ctx argument)
                        (if (and (= command 10) (= (word ctx 86) 6))
                          (do (nic/log 49162 (if (and (= (usb/ble-diagnostic 0) 1) (= (ble/diagnostic 0) 15)
                                                    (= (hogp/diagnostic 0) 0)) (+ (sc/self-check) (* 256 (legacy/self-check))) 0)) 1)
                        (if (and (>= command 11) (<= command 13) (= (word ctx 86) 6))
                          (operate-hogp command)
                        (if (and (= command 16) (= (word ctx 86) 6))
                          (let [result (firmware/load)]
                            (do (nic/log 49648 (firmware/diagnostic 0)) (nic/log 49649 (firmware/diagnostic 1))
                                (ble-report 0) (nic/log 49168 result) 1))
                        (refuse ctx (+ 6 (* 256 (bit-and command 65535))))))))))))))))))))))

(defn check [ctx geom]
  (if (= (magic-ok 0) 0) (refuse ctx 2)
    (if (not (= (payload-le 8 8 0) (word64 ctx 172))) (refuse ctx 3)
      (let [counter (payload-le 16 8 0)]
        (if (<= counter (word64 ctx 174)) (refuse ctx 4)
          (if (not (= (signature-ok ctx) 1)) (refuse ctx 5)
            (execute ctx (payload-le 24 4 0) (payload-le 28 4 0) counter geom)))))))

;; One poll: nothing (0) unless a frame is waiting. geom packs the
;; framebuffer width, height (<< 16), stride (<< 32) and format (<< 48).
(defn rx-stats [ctx]
  (+ (word ctx 178) (+ (i64-shift-left (word ctx 179) 32) (i64-shift-left (bit-and (word ctx 176) 255) 24))))
(defn poll [ctx geom]
  (if (= (nic/rx-length) 0) 0
    (let [seen (put-word ctx 178 (+ (word ctx 178) 1))
          last (put-word ctx 179 (+ (* (nic/rx-byte 36) 256) (+ (nic/rx-byte 37) (* (bit-and (nic/rx-length) 65535) 65536))))
          result (if (for-us) (check ctx geom) 0)
          released (nic/rx-release)]
      (+ result (* 0 (+ released seen last))))))
