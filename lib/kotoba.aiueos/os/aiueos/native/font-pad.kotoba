;; Unity fragment with Amu's exact native00/01/02 helpers. Preserve the
;; existing licensed font bytes; the native producer owns padding to512KiB.
(defn- font-word [D :vector-i64 at :i64] :i64
  (+ (vector-at D at) (* 256 (vector-at D (+ at 1)))
     (* 65536 (vector-at D (+ at 2))) (* 16777216 (vector-at D (+ at 3)))))
(defn- seed-main [] :i64
  (if (not= (io-argc) 2) 1
    (let [F (io-read-bytes (io-arg 0)) n (if (>= (vector-count F) 16) (font-word F 8) 0)]
      (if (or (< n 1) (> n 14563) (not= (vector-count F) (+ 16 (* n 36)))
              (not= (font-word F 0) 0x46554941) (not= (font-word F 4) 1)
              (= (io-exists (io-arg 1)) 1)) 1
        (let [D (vector-alloc 524288)
              copied (loop [i 0]
                       (if (= i (vector-count F)) D
                         (let [w (mem-set D i (vector-at F i))] (recur (inc i)))))
              written (io-write-bytes copied (io-arg 1) 0 524288)
              readback (io-read-bytes (io-arg 1))
              equal (and (= (vector-count readback) 524288)
                      (loop [i 0]
                        (cond (= i 524288) true
                              (not= (vector-at readback i) (vector-at D i)) false
                              :else (recur (inc i)))))]
          (if equal (let [w (io-out "PASS_NATIVE_FONT_PAD\n")] 0) 1))))))
