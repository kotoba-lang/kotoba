;; Native unity fragment, assembled after the exact Amu seed 00/01/02 helpers (JUN-555).
;; Writes os/aiueos's build-identity C header: the bytes the retired inline
;; Python (PYBUILD) in scripts/build-uefi.sh wrote for the same arguments.
;; argv: output version commit dirty. The output names a file beneath the FD 3
;; scope; nothing else is read or written. Invalid input writes nothing.
;; Bytes go through io-write-bytes: io-write-text traps on the Mac
;; fs2-cli-stdio-general runtime (measured 2026-10-31, Amu root 6235e191).
(defn- bid-digit? [c :i64] :bool (and (>= c 48) (<= c 57)))
(defn- bid-hex? [c :i64] :bool (or (bid-digit? c) (and (>= c 97) (<= c 102))))
(defn- bid-pre? [c :i64] :bool
  (or (bid-digit? c) (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122))
      (= c 46) (= c 45)))
;; end of the run of ASCII digits starting at i
(defn- bid-digits [S :string i :i64] :i64
  (loop [j i]
    (if (and (< j (string-length S)) (bid-digit? (string-code-point-at S j))) (recur (inc j)) j)))
;; one SemVer core number at i followed by `stop` (or the end when stop < 0); returns the index after it or -1
(defn- bid-number [S :string i :i64 stop :i64] :i64
  (let [j (bid-digits S i)]
    (cond (= j i) -1
          (< stop 0) j
          (and (< j (string-length S)) (= (string-code-point-at S j) stop)) (inc j)
          :else -1)))
;; [0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)? over the whole string
(defn- bid-version? [S :string] :bool
  (let [a (bid-number S 0 46) b (if (< a 0) -1 (bid-number S a 46)) c (if (< b 0) -1 (bid-number S b -1))
        n (string-length S)]
    (cond (< c 0) false
          (= c n) true
          (not= (string-code-point-at S c) 45) false
          (= (inc c) n) false
          :else (loop [i (inc c)]
                  (cond (= i n) true
                        (bid-pre? (string-code-point-at S i)) (recur (inc i))
                        :else false)))))
;; [0-9a-f]{40}
(defn- bid-commit? [S :string] :bool
  (and (= (string-length S) 40)
       (loop [i 0]
         (cond (= i 40) true
               (bid-hex? (string-code-point-at S i)) (recur (inc i))
               :else false))))
(defn- bid-header [version :string commit :string dirty :string] :string
  (string-concat "#ifndef AIUEOS_BUILD_IDENTITY_H\n#define AIUEOS_BUILD_IDENTITY_H\n"
    (string-concat (string-concat "#define AIUEOS_BUILD_VERSION \"" (string-concat version "\"\n"))
      (string-concat (string-concat "#define AIUEOS_BUILD_SOURCE_HASH \""
                                    (string-concat (string-substring commit 0 12) "\"\n"))
        (string-concat (string-concat "#define AIUEOS_BUILD_DIRTY_SUFFIX \""
                                      (string-concat (if (string=? dirty "true") "-DIRTY" "") "\"\n"))
          "#endif\n")))))
(defn- seed-main [] :i64
  (if (not= (io-argc) 4)
    (let [w (io-err "error: build-identity header takes output version commit dirty\n")] 1)
    (let [path (io-arg 0) version (io-arg 1) commit (io-arg 2) dirty (io-arg 3)]
      (cond (not (bid-version? version))
            (let [w (io-err "error: os/aiueos/VERSION must be a bounded SemVer string\n")] 1)
            (not (bid-commit? commit))
            (let [w (io-err "error: AIUEOS source commit must be a full lowercase git hash\n")] 1)
            (= (io-exists path) 1)
            (let [w (io-err "error: build-identity header output exists\n")] 1)
            :else
            (let [V (vector-i64-from-bytes (string-to-utf8 (bid-header version commit dirty)))
                  n (vector-count V)
                  written (io-write-bytes V path 0 n)
                  B (io-read-bytes path)]
              (if (and (= written n) (= (vector-count B) n)
                       (loop [i 0]
                         (cond (= i n) true
                               (not= (vector-at B i) (vector-at V i)) false
                               :else (recur (inc i)))))
                0
                (let [w (io-err "error: build-identity header readback differs\n")] 1)))))))
