;; Unity fragment: pinned Amu00/01/02 plus this file; native FS2 CLI only.
;; Preserve the entire font and its extent. Fill a proved unused padding span
;; with unmodified licensed firmware bytes. Runtime verifies its pinned SHA.
(defn- fw-word [D :vector-i64 at :i64] :i64
  (+ (vector-at D at) (* (vector-at D (+ at 1)) 256)
     (* (vector-at D (+ at 2)) 65536) (* (vector-at D (+ at 3)) 16777216)))
(defn- seed-main [] :i64
  (if (not= (io-argc) 4) 1
    (let [F (io-read-bytes (io-arg 0)) W (io-read-bytes (io-arg 1)) C (io-read-bytes (io-arg 2))
          n (if (>= (vector-count F) 16) (fw-word F 8) 0)]
      (if (or (not= (vector-count F) 524288) (< n 1) (> (+ 16 (* n 36)) 327680)
              (not= (fw-word F 0) 0x46554941) (not= (fw-word F 4) 1)
              (not= (vector-count W) 49760) (not= (vector-count C) 6)
              (= (io-exists (io-arg 3)) 1)) 1
        (if (not (loop [i (+ 16 (* n 36))]
                   (cond (= i 524288) true (not= (vector-at F i) 0) false :else (recur (inc i))))) 1
          (let [D (loop [i 0 V F]
                    (if (= i 49760) V (recur (inc i) (vector-assoc! V (+ 327680 i) (vector-at W i)))))
                E (loop [i 0 V D]
                    (if (= i 6) V (recur (inc i) (vector-assoc! V (+ 377440 i) (vector-at C i)))))
                written (io-write-bytes E (io-arg 3) 0 524288)
                B (io-read-bytes (io-arg 3))]
            (if (and (= (vector-count B) 524288)
                     (loop [i 0]
                       (cond (= i 524288) true (not= (vector-at E i) (vector-at B i)) false :else (recur (inc i)))))
              (let [w (io-out "PASS_NATIVE_BLE_PAYLOAD\n")] 0) 1)))))))
