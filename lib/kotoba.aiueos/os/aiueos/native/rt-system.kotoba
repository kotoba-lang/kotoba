(ns aiueos.native.rt-system
  (:require [aiueos.native.rt-kernel :as kernel]
            [aiueos.sha256 :as sha]
            [aiueos.ecdsa-p256 :as ecdsa]
            [aiueos.user-elf-valid :as elf])
  (:export [main]))

(defn load64-boot [boot offset]
  (+ (kernel-load-u8 boot 80 offset)
     (* (kernel-load-u8 boot 80 (+ offset 1)) 256)
     (* (kernel-load-u8 boot 80 (+ offset 2)) 65536)
     (* (kernel-load-u8 boot 80 (+ offset 3)) 16777216)
     (* (kernel-load-u8 boot 80 (+ offset 4)) 4294967296)
     (* (kernel-load-u8 boot 80 (+ offset 5)) 1099511627776)
     (* (kernel-load-u8 boot 80 (+ offset 6)) 281474976710656)
     (* (kernel-load-u8 boot 80 (+ offset 7)) 72057594037927936)))

(defn bytes-equal [left :i64 right :i64 length :i64 index :i64] :bool
  (if (= index length)
    true
    (and (= (kernel-load-u8 left length index)
            (kernel-load-u8 right length index))
         (bytes-equal left right length (+ index 1)))))

(defn signed-plc-admitted [] :bool
  (let [boot (kernel-boot-info)
        payload-pointer (load64-boot boot 56)
        payload-length (load64-boot boot 64)]
    (if (and (= (load64-boot boot 8) 2)
             (= payload-pointer (+ boot 16464))
             (>= payload-length 8456)
             (<= payload-length 12464))
      (let [payload (kernel-subregion boot 28928 16464 payload-length)
            bounds-marker (kernel-out-u8 233 66)
            elf-length (+ (kernel-load-u8-16k payload payload-length 12)
                          (* (kernel-load-u8-16k payload payload-length 13) 256)
                          (* (kernel-load-u8-16k payload payload-length 14) 65536)
                          (* (kernel-load-u8-16k payload payload-length 15) 16777216)
                          (* 0 bounds-marker))]
        (if (and (= (kernel-load-u8-16k payload payload-length 0) 65)
                 (= (kernel-load-u8-16k payload payload-length 1) 73)
                 (= (kernel-load-u8-16k payload payload-length 2) 85)
                 (= (kernel-load-u8-16k payload payload-length 3) 80)
                 (= (kernel-load-u8-16k payload payload-length 4) 76)
                 (= (kernel-load-u8-16k payload payload-length 5) 67)
                 (= (kernel-load-u8-16k payload payload-length 6) 49)
                 (= (kernel-load-u8-16k payload payload-length 7) 0)
                 (= (+ elf-length 176) payload-length)
                 (>= elf-length 8280) (<= elf-length 12288))
          (let [header-marker (kernel-out-u8 233 72)
                signature (kernel-subregion payload payload-length 16 64)
                public-key (kernel-subregion payload payload-length 80 64)
                expected-digest (kernel-subregion payload payload-length 144 32)
                image (kernel-subregion payload payload-length 176 elf-length)
                workspace 1114624
                digest 1116672
                hashed (+ (sha/aiueos-sha256 image elf-length digest workspace 2048)
                          (* 0 header-marker))]
            (if (= hashed 1)
              (let [sha-marker (kernel-out-u8 233 83)
                    digest-ok (bytes-equal digest expected-digest 32 0)]
                (if digest-ok
                  (let [digest-marker (kernel-out-u8 233 68)
                        signature-ok
                        (+ (ecdsa/aiueos-ecdsa-p256-sha256-verify
                            signature digest public-key workspace 2048)
                           (* 0 (+ sha-marker digest-marker)))]
                    (if (= signature-ok 1)
                      (let [signature-marker (kernel-out-u8 233 71)
                            elf-ok (elf/aiueos-user-elf-valid image elf-length)]
                        (and elf-ok (= (* 0 signature-marker) 0)))
                      false))
                  false))
              false))
          false))
      false)))

(defn main [] :i64
  (let [boot (kernel-boot-info)]
    (if (= (load64-boot boot 8) 1)
      (kernel/main)
      (if (signed-plc-admitted)
        (let [external-marker (kernel-out-u8 233 86)]
          (+ (kernel/main) (* 0 external-marker)))
        (kernel-out-u32 244 21)))))
