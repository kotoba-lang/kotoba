(ns aiueos.native.usb-hid
  ;; AWAI-120/121: USB boot HID ingress. Pure report validation and conversion;
  ;; transports (xHCI, a receiver, later Bluetooth HID) never answer consent.
  ;; Keyboard report: modifiers, reserved=0, six usage IDs. ErrorRollOver,
  ;; POSTFail and ErrorUndefined invalidate the WHOLE report. New presses only;
  ;; a held key cannot answer a panel that it just opened.
  (:export [key-code keyboard-valid new-key mouse-valid mouse-delta self-check main]))

(defn byte [r i] (bit-and (u64-shift-right r (* i 8)) 255))
(defn usage-code [u]
  (case u
    4 30 5 48 6 46 7 32 8 18 9 33 10 34 11 35 12 23 13 36
    14 37 15 38 16 50 17 49 18 24 19 25 20 16 21 19 22 31
    23 20 24 22 25 47 26 17 27 45 28 21 29 44
    30 2 31 3 32 4 33 5 34 6 35 7 36 8 37 9 38 10 39 11
    40 28 41 1 42 14 43 15 44 57
    58 59 59 60 60 61 61 62 62 63 63 64 64 65 65 66
    66 67 67 68 68 87 69 88
    79 77 80 75 81 80 82 72 0))
(defn key-code [usage modifiers]
  ;; The current desktop accepts lower-case set-1 make codes only. Modified
  ;; chords stay unhandled instead of turning Ctrl+A or Alt+Y into plain keys.
  (if (= modifiers 0) (usage-code usage) 0))
(defn valid-keys [r i]
  (if (>= i 8) 1
    (if (and (> (byte r i) 0) (< (byte r i) 4)) 0
      (valid-keys r (+ i 1)))))
(defn keyboard-valid [r length]
  (if (and (= length 8) (= (byte r 1) 0)) (valid-keys r 2) 0))
(defn contains [r u i]
  (if (>= i 8) 0
    (if (= (byte r i) u) 1 (contains r u (+ i 1)))))
(defn new-key [previous current i]
  (if (or (< i 2) (>= i 8)) 0
    (let [u (byte current i)]
      (if (or (= u 0) (= (contains previous u 2) 1)) 0
        (key-code u (byte current 0))))))
(defn mouse-valid [r length]
  (if (and (>= length 3) (<= length 8) (= (bit-and (byte r 0) 248) 0)) 1 0))
(defn mouse-delta [v] (if (>= v 128) (- v 256) v))
(defn self-check []
  (+ (if (= (key-code 4 0) 30) 1 0)
     (if (= (key-code 62 0) 63) 2 0)
     (if (= (key-code 28 1) 0) 4 0)
     (if (= (keyboard-valid 262144 8) 1) 8 0)
     (if (= (keyboard-valid 65536 8) 0) 16 0)
     (if (= (keyboard-valid 131072 8) 0) 32 0)
     (if (= (keyboard-valid 196608 8) 0) 64 0)
     (if (= (keyboard-valid 262400 8) 0) 128 0)
     (if (= (keyboard-valid 262144 7) 0) 256 0)
     (if (= (new-key 262144 262144 2) 0) 512 0)
     (if (= (new-key 0 262144 2) 30) 1024 0)
     (if (= (mouse-delta 255) -1) 2048 0)
     (if (= (mouse-delta 128) -128) 4096 0)
     (if (= (mouse-valid 248 3) 0) 8192 0)))
(defn main [] 0)
