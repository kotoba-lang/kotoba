;; Native unity fragment, assembled after the exact Amu seed 00/01/02 and 03-source-sha256 helpers (JUN-555).
;; Writes the test-only zero-cap CPL3 smoke's embedded assembly: the bytes
;; scripts/make-zero-cap-user-embedded-assembly.py wrote for the same inputs.
;; argv: output elf elf-bytes expected-sha256 signature signature-bytes key key-bytes elf-path.
;; elf, signature and key are staged names beneath the FD 3 scope. elf-path is the
;; absolute, symlink-free host path the .incbin line names (the caller resolves it).
;; The capability-free check (verify-kotoba-user-elf.py reporting caps=none) is the
;; caller's, before this runs; everything else the Python refused is refused here.
(defn- zc-ack? [B :vector-i64 n :i64] :bool
  (and (= (vector-count B) (+ n 5)) (= (vector-at B 0) 0)
       (= (vector-at B 1) 70) (= (vector-at B 2) 83)
       (= (vector-at B 3) 50) (= (vector-at B 4) 0)))
(defn- zc-decimal? [S :string] :bool
  (and (> (string-length S) 0) (<= (string-length S) 10)
       (loop [i 0]
         (cond (= i (string-length S)) true
               (or (< (string-code-point-at S i) 48) (> (string-code-point-at S i) 57)) false
               :else (recur (inc i))))))
;; the whole file of n bytes (at most limit) in bounded FS2 slices, or [-1]
(defn- zc-read [path :string size-text :string limit :i64] :vector-i64
  (let [n (if (zc-decimal? size-text) (mem-parse-dec size-text 0 (string-length size-text)) -1)]
    (if (or (< n 0) (> n limit)) [-1]
      (loop [at 0 D (vector-alloc n)]
        (if (= at n) D
          (let [count (io-min 262144 (- n at))
                B (vector-i64-from-bytes
                    (typed-cap-call :fs/app-data :string :bytes
                      (string-concat (io-fs2-header 69 path)
                        (string-concat (mem-u2dec at) (string-concat ":" (mem-u2dec count))))))]
            (if (not (zc-ack? B count)) [-1]
              (recur (+ at count)
                (loop [i 0 V D]
                  (if (= i count) V (recur (inc i) (vector-assoc! V (+ at i) (vector-at B (+ i 5))))))))))))))
(defn- zc-refused? [V :vector-i64] :bool (and (= (vector-count V) 1) (< (vector-at V 0) 0)))
(defn- zc-any? [V :vector-i64] :bool
  (loop [i 0] (cond (= i (vector-count V)) false (not= (vector-at V i) 0) true :else (recur (inc i)))))
;; a path the assembler can quote: ASCII without " \ LF CR (the Python refused those four)
(defn- zc-path? [S :string] :bool
  (and (> (string-length S) 0)
       (loop [i 0]
         (cond (= i (string-length S)) true
               (let [c (string-code-point-at S i)] (or (= c 34) (= c 92) (= c 10) (= c 13) (> c 127))) false
               :else (recur (inc i))))))
(defn- zc-hexd [d :i64] :string (string-substring "0123456789abcdef" d (inc d)))
(defn- zc-hex-value [c :i64] :i64
  (cond (and (>= c 48) (<= c 57)) (- c 48) (and (>= c 97) (<= c 102)) (- c 87) :else 0))
(defn- zc-byte-list [V :vector-i64] :string
  (loop [i 0 acc ""]
    (if (= i (vector-count V)) acc
      (recur (inc i)
        (string-concat acc
          (string-concat (if (= i 0) "0x" ",0x")
            (string-concat (zc-hexd (u64-shift-right (vector-at V i) 4)) (zc-hexd (bit-and (vector-at V i) 15)))))))))
(defn- zc-digest-bytes [hex :string] :vector-i64
  (loop [i 0 V (vector-alloc 32)]
    (if (= i 32) V
      (recur (inc i)
        (vector-assoc! V i (+ (* 16 (zc-hex-value (string-code-point-at hex (* 2 i))))
                              (zc-hex-value (string-code-point-at hex (inc (* 2 i))))))))))
(defn- zc-cat [a :string b :string c :string] :string (string-concat a (string-concat b c)))
(defn- zc-text [path :string digest :string signature :vector-i64 key :vector-i64] :string
  (-> ".section .rodata.zero_cap_user,\"a\",@progbits\n.balign 16\n"
      (string-concat ".global aiueos_zero_cap_elf_start\n.global aiueos_zero_cap_elf_end\naiueos_zero_cap_elf_start:\n")
      (string-concat (zc-cat ".incbin \"" path "\"\n"))
      (string-concat "aiueos_zero_cap_elf_end:\n.balign 16\n.global aiueos_zero_cap_elf_sha256\naiueos_zero_cap_elf_sha256:\n")
      (string-concat (zc-cat ".byte " (zc-byte-list (zc-digest-bytes digest)) "\n"))
      (string-concat ".balign 16\n.global aiueos_zero_cap_signature\naiueos_zero_cap_signature:\n")
      (string-concat (zc-cat ".byte " (zc-byte-list signature) "\n"))
      (string-concat ".balign 16\n.global aiueos_zero_cap_public_key\naiueos_zero_cap_public_key:\n")
      (string-concat (zc-cat ".byte " (zc-byte-list key) "\n"))))
(defn- seed-main [] :i64
  (if (not= (io-argc) 9)
    (let [w (io-err "error: zero-cap embed takes output elf bytes sha256 signature bytes key bytes elf-path\n")] 1)
    (let [path (io-arg 0) E (zc-read (io-arg 1) (io-arg 2) 98304) expected (io-arg 3)
          S (zc-read (io-arg 4) (io-arg 5) 4096) K (zc-read (io-arg 6) (io-arg 7) 4096) elf-path (io-arg 8)
          digest (if (zc-refused? E) "" (sh-bytes E))]
      (cond (or (zc-refused? E) (not (string=? digest expected)))
            (let [w (io-err "error: zero-cap ELF digest or size mismatch\n")] 1)
            (or (zc-refused? S) (zc-refused? K) (not= (vector-count S) 64) (not= (vector-count K) 64) (not (zc-any? K)))
            (let [w (io-err "error: raw P-256 signature and public key are required\n")] 1)
            (not (zc-path? elf-path)) (let [w (io-err "error: ELF path cannot be represented in assembly\n")] 1)
            (= (io-exists path) 1) (let [w (io-err "error: zero-cap embed output exists\n")] 1)
            :else
            (let [V (vector-i64-from-bytes (string-to-utf8 (zc-text elf-path digest S K)))
                  n (vector-count V)
                  written (io-write-bytes V path 0 n)
                  B (io-read-bytes path)]
              (if (and (= written n) (= (vector-count B) n)
                       (loop [i 0]
                         (cond (= i n) true
                               (not= (vector-at B i) (vector-at V i)) false
                               :else (recur (inc i)))))
                (let [w (io-out (string-concat "AIUEOS_ZERO_CAP_USER_EMBED_OK sha256=" (string-concat digest "\n")))] 0)
                (let [w (io-err "error: zero-cap embed readback differs\n")] 1)))))))
