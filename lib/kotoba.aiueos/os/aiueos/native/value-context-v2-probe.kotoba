(ns aiueos.native.value-context-v2-probe
  (:require [aiueos.value-runtime-domain :as domain]
            [aiueos.value-runtime-provider-policy :as policy]
            [aiueos.value-runtime-provider-transport :as transport]
            [aiueos.value-handle-arena :as arena])
  (:export [main]))

;; Exercises the actual linked queue/CAS/arena mechanisms at CPL0. This is
;; neither a user SYSCALL gate nor a complete kernel or canonical-value proof.
(defn- fill-queue [digest :i64 count :i64] :i64
  (if (= count 0) 1
    (if (> (transport/aiueos-value-runtime-provider-submit 14 73 1 digest) 0)
      (fill-queue digest (- count 1)) 0)))
(defn- all-one? [record :i64 length :i64 index :i64] :bool
  (if (= index 12) true
    (and (= (kernel-load-u64-4k record length (* index 8)) 1)
         (all-one? record length (+ index 1)))))
(defn main [] :i64
  (let [record (kernel-owned-page 0)
        bytes (kernel-owned-page 1)
        digest-page (kernel-owned-page 2)
        block (kernel-subregion bytes 4096 0 3)
        digest (kernel-subregion digest-page 4096 0 32)
        a (kernel-store-u8 block 3 0 97)
        b (kernel-store-u8 block 3 1 98)
        c (kernel-store-u8 block 3 2 99)
        h0 (kernel-store-u64 digest 32 0 -1527000031757436742)
        h1 (kernel-store-u64 digest 32 8 2531777658719584577)
        h2 (kernel-store-u64 digest 32 16 -7171393520880516176)
        h3 (kernel-store-u64 digest 32 24 -5974868289610903372)
        first (domain/aiueos-value-runtime-publish-domain 73)
        p73 (kernel-value-runtime-arena 73)
        second (domain/aiueos-value-runtime-publish-domain 74)
        p74 (kernel-value-runtime-arena 74)
        r0 (kernel-store-u64-4k record 4096 0
             (if (and (= first 73) (= second 74) (> p73 0)
                      (= (- p74 p73) 4096)) 1 0))
        bad-domain (domain/aiueos-value-runtime-publish-domain 0)
        unknown (kernel-publish-current-domain 75)
        r1 (kernel-store-u64-4k record 4096 8
             (if (and (= bad-domain 0) (= unknown 0)
                      (= (kernel-current-domain) 74)) 1 0))
        on (policy/aiueos-value-runtime-provider-status 1 1)
        off (policy/aiueos-value-runtime-provider-status 2 0)
        invalid-status (kernel-publish-value-provider-status 65536)
        r2 (kernel-store-u64-4k record 4096 16
             (if (and (= on 65537) (= off 2) (= invalid-status 0)
                      (= (kernel-value-provider-status) 2)) 1 0))
        ticket (transport/aiueos-value-runtime-provider-submit 14 73 1 digest)
        claim (transport/aiueos-value-runtime-provider-claim)
        r3 (kernel-store-u64-4k record 4096 24
             (if (and (= ticket 1)
                      (= claim (+ 1 (* 14 4294967296) (* 73 1099511627776)))) 1 0))
        wrong-route (transport/aiueos-value-runtime-provider-complete ticket 18703 block 3 38654705671)
        wrong-domain (transport/aiueos-value-runtime-provider-complete ticket 18958 block 3 38654705671)
        q (kernel-value-provider-queue)
        r4 (kernel-store-u64-4k record 4096 32
             (if (and (= wrong-route 0) (= wrong-domain 0)
                      (= (kernel-load-u8 q 512 36) 2)) 1 0))
        corrupt (kernel-store-u8 block 3 0 100)
        mismatch (transport/aiueos-value-runtime-provider-complete ticket 18702 block 3 38654705671)
        restore (kernel-store-u8 block 3 0 97)
        r5 (kernel-store-u64-4k record 4096 40
             (if (and (= corrupt 100) (= restore 97) (= mismatch 0)
                      (= (kernel-load-u8 q 512 36) 2)) 1 0))
        invalid-descriptor (transport/aiueos-value-runtime-provider-complete ticket 18702 block 3 0)
        r6 (kernel-store-u64-4k record 4096 48
             (if (and (= invalid-descriptor 0)
                      (= (kernel-load-u8 q 512 36) 2)) 1 0))
        handle (transport/aiueos-value-runtime-provider-complete ticket 18702 block 3 38654705671)
        resolved73 (arena/aiueos-value-handle-arena p73 4096 2 handle 0)
        resolved74 (arena/aiueos-value-handle-arena p74 4096 2 handle 0)
        r7 (kernel-store-u64-4k record 4096 56
             (if (and (= handle 1) (= resolved73 7) (= resolved74 0)
                      (= (kernel-current-domain) 74)
                      (= (kernel-load-u8 q 512 36) 0)) 1 0))
        filled (fill-queue digest 7)
        full (transport/aiueos-value-runtime-provider-submit 14 73 1 digest)
        r8 (kernel-store-u64-4k record 4096 64
             (if (and (= filled 1) (= full 0) (= (kernel-load-u32 q 512 4) 8)) 1 0))
        locked (kernel-try-lock-u32 q 512 0)
        busy (transport/aiueos-value-runtime-provider-claim)
        unlocked (kernel-unlock-u32 q 512 0)
        r9 (kernel-store-u64-4k record 4096 72
             (if (and (= locked 1) (= busy 0) (= unlocked 1)) 1 0))
        freed (kernel-store-u8 q 512 36 0)
        exhausted (kernel-store-u32 q 512 4 4294967295)
        no-wrap (transport/aiueos-value-runtime-provider-submit 14 73 1 digest)
        r10 (kernel-store-u64-4k record 4096 80
              (if (and (= freed 0) (= exhausted 4294967295) (= no-wrap 0)
                       (= (kernel-load-u32 q 512 4) 4294967295)
                       (= (kernel-load-u8 q 512 36) 0)) 1 0))
        third (domain/aiueos-value-runtime-publish-domain 75)
        fourth (domain/aiueos-value-runtime-publish-domain 76)
        fifth (domain/aiueos-value-runtime-publish-domain 77)
        r11 (kernel-store-u64-4k record 4096 88
              (if (and (= third 75) (= fourth 76) (= fifth 0)
                       (= (kernel-current-domain) 76)
                       (= (kernel-value-runtime-arena 73) p73)) 1 0))]
    (if (all-one? record 4096 0) 42 0)))
