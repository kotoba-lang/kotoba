(ns aiueos.native.remote-console-probe
  ;; Pure command-shape/modal-policy component; no NIC wire signature claim.
  (:require [aiueos.native.desktop :as desktop]
            [aiueos.native.rtl8168-debug :as nic]
            [aiueos.native.remote-cmd :as remote])
  (:export [run]))
(defn p [ctx i v] (kernel-store-u32 (kernel-subregion ctx 8192 (* i 4) 4) 4 0 v))
(defn bit [ok :bool value :i64] :i64 (if ok value 0))
(defn park [] (do (kernel-pause) (park)))
(defn run [] :i64
  (let [ctx (kernel-browser-context) irq (kernel-cli) geom (+ 1280 (* 800 65536))
        last (+ 1279 (* 799 8192) 67108864)]
    (do (p ctx 86 6) (p ctx 87 0)
        (if (= (kernel-framebuffer-width) 0) (desktop/input-main) 0)
        (p ctx 74
          (+ (bit (= (remote/pointer-command ctx 0 1 geom) 512) 1)
             (bit (= (remote/pointer-command ctx last 2 geom) (+ 512 last)) 2)
             (bit (= (remote/pointer-command ctx 1280 3 geom) 0) 4)
             (bit (= (remote/pointer-command ctx (* 800 8192) 4 geom) 0) 8)
             (bit (= (remote/pointer-command ctx 134217728 5 geom) 0) 16)
             (bit (= (remote/pointer-command ctx 0 6 0) 0) 32)
             (bit (= (remote/pointer-command ctx -1 7 geom) 0) 64)
             (bit (= (remote/console-key-command ctx 30 8) 286) 128)
             (bit (= (remote/console-key-command ctx 0 9) 0) 256)
             (bit (= (remote/console-key-command ctx 128 10) 0) 512)))
        (p ctx 87 1)
        (p ctx 75
          (+ (bit (= (remote/pointer-command ctx last 11 geom) 0) 1)
             (bit (= (remote/pointer-command ctx 100 12 geom) 612) 2)
             (bit (= (remote/console-key-command ctx 21 13) 0) 4)
             (bit (= (remote/console-key-command ctx 49 14) 305) 8)
             (bit (= (remote/console-key-command ctx 1 15) 257) 16)
             (bit (= (remote/console-key-command ctx 28 16) 0) 32)))
        (p ctx 76
          (+ (bit (remote/band-valid (* 32 65536) geom) 1)
             (bit (remote/band-valid (+ 768 (* 32 65536)) geom) 2)
             (bit (not (remote/band-valid 0 geom)) 4)
             (bit (not (remote/band-valid (* 33 65536) geom)) 8)
             (bit (not (remote/band-valid (+ 769 (* 32 65536)) geom)) 16)
             (bit (not (remote/band-valid -1 geom)) 32)
             (bit (not (remote/band-valid 65536 (* 800 65536))) 64)
             (bit (not (remote/band-valid 65536 (+ 3201 (* 800 65536)))) 128)))
        (nic/band geom 65536 -81985529216486896 81985529216486895)
        (let [frame (kernel-subregion (kernel-owned-window 10 16384) 16384 4096 4096)
              width (kernel-framebuffer-width) height (kernel-framebuffer-height)
              stride (kernel-framebuffer-stride)
              tail (- width (mod width 200))]
          (do (p ctx 77
                (+ (bit (= (kernel-load-u8-4k frame 4096 50) 16) 1)
                   (bit (= (kernel-load-u8-4k frame 4096 57) 254) 2)
                   (bit (= (kernel-load-u8-4k frame 4096 58) 239) 4)
                   (bit (= (kernel-load-u8-4k frame 4096 65) 1) 8)
                   (bit (= (kernel-load-u8-4k frame 4096 72) 32) 16)
                   (bit (= (kernel-load-u8-4k frame 4096 73) 3) 32)))
              (nic/shot-pixels frame (+ width (* height 65536) (* stride 4294967296) 72057594037927936) (- height 1) tail 0)
              (p ctx 78 (+ (bit (= (kernel-load-u32-4k frame 4096 872) 0) 1)
                          (bit (> (mod width 200) 0) 2)))))
        (p ctx 87 0) (p ctx 79 (+ 1 (* irq 0))) (park))))
