(ns aiueos.native.tender-fixture
  ;; A guest that exists to prove ONE thing: that the loader's tender re-enters
  ;; it when it returns 250.
  ;;
  ;; The real kernel never returns 250 under QEMU -- that path belongs to the
  ;; NIC stream, which needs an RTL8125 QEMU does not have -- so the tender's
  ;; re-entry has only ever been observed on the physical K16, as seventeen
  ;; re-entries inferred from a panel status. The mechanism it is built on --
  ;; fuel replenishment, boot-info re-materialisation, the loop-back branch --
  ;; has no test at all. This fixture gives it one without making the real
  ;; guest pretend.
  ;;
  ;; It counts its own entries in the loader-owned scratch page and returns 250
  ;; until it has been called four times, then a terminal status. Each entry
  ;; prints its ordinal, so the trace says how many times the loader came back
  ;; rather than leaving it to be inferred.
  ;; The REAL kernel is required, not replaced. Two reasons, one of them
  ;; measured: the emitter places the RW segment at a fixed 0x108000, so a
  ;; guest whose text is smaller than about 28 KB leaves a gap and
  ;; verify-kotoba-native-kernel.py refuses it for rw_start != rx_limit -- a
  ;; minimal fixture cannot be built through this path at all. Linking the real
  ;; kernel satisfies that honestly rather than by padding.
  ;; The other reason is better: the last entry runs the actual kernel, so the
  ;; run proves the loop AND ends the way a real one does.
  (:require [native.serial :as serial]
            [aiueos.native.kernel :as kernel])
  (:export [main]))

(defn load64-boot [base offset]
  (+ (kernel-load-u8 base 96 offset)
     (* (kernel-load-u8 base 96 (+ offset 1)) 256)
     (* (kernel-load-u8 base 96 (+ offset 2)) 65536)
     (* (kernel-load-u8 base 96 (+ offset 3)) 16777216)
     (* (kernel-load-u8 base 96 (+ offset 4)) 4294967296)
     (* (kernel-load-u8 base 96 (+ offset 5)) 1099511627776)
     (* (kernel-load-u8 base 96 (+ offset 6)) 281474976710656)
     (* (kernel-load-u8 base 96 (+ offset 7)) 72057594037927936)))

(defn main []
  (let [_uart (serial/serial-init)
        boot (kernel-boot-info)
        scratch-start (load64-boot boot 80)
        sixth-start (+ scratch-start 20480)
        ;; `kernel-subregion` inline, and the offset bound to a name first: a
        ;; kernel memory base must NAME a region rather than compute one, and
        ;; both a nested offset expression and a region returned from a helper
        ;; are refused at :subset with :kotoba.error/kernel-region-provenance.
        page (kernel-subregion 4096 549755809792 (- sixth-start 4096) 4096)
        raw (kernel-load-u8-4k page 4096 2048)
        ;; The scratch page is not guaranteed zero on the first entry, so the
        ;; counter is tagged rather than bare: only 200..203 is read as "this
        ;; fixture wrote that", and anything else is entry zero. A bare counter
        ;; would read whatever the loader left as a count and could report the
        ;; loop working on its first call.
        seen (if (and (>= raw 200) (<= raw 203)) (- raw 200) 0)
        mark (serial/trace-byte (+ 48 seen))
        stored (kernel-store-u8-4k page 4096 2048
                                   (+ 201 (+ seen (* 0 mark))))]
    (if (< (+ seen (* 0 stored)) 3)
      ;; 250 is the tender's "call me again".
      250
      ;; Fourth entry: hand over to the real kernel, so the run ends exactly as
      ;; an ordinary one does and the trace carries its markers too.
      (kernel/main))))
