;; Native unity fragment, assembled after the exact Amu seed 00/01/02 and 03-source-sha256 helpers (JUN-555).
;; Writes os/aiueos's embedded-release assembly (EMBEDDED_RELEASE only): the bytes
;; the retired inline Python (PYEMBED) in scripts/build-uefi.sh wrote.
;; argv: output kernel kernel-bytes kernel-path initramfs initramfs-bytes initramfs-path.
;; kernel and initramfs are staged names beneath the FD 3 scope, hashed with seed 03's
;; SHA-256; the two paths are the absolute, symlink-free host paths the .incbin lines
;; name, which the caller resolves and the Python copied verbatim. They are copied
;; verbatim too, but must be ASCII (the Python's ASCII encoding refused anything else).
(def ERA-MAX-BYTES 67108864)
(defn- era-ack? [B :vector-i64 n :i64] :bool
  (and (= (vector-count B) (+ n 5)) (= (vector-at B 0) 0)
       (= (vector-at B 1) 70) (= (vector-at B 2) 83)
       (= (vector-at B 3) 50) (= (vector-at B 4) 0)))
(defn- era-decimal? [S :string] :bool
  (and (> (string-length S) 0) (<= (string-length S) 10)
       (loop [i 0]
         (cond (= i (string-length S)) true
               (or (< (string-code-point-at S i) 48) (> (string-code-point-at S i) 57)) false
               :else (recur (inc i))))))
(defn- era-ascii? [S :string] :bool
  (loop [i 0]
    (cond (= i (string-length S)) true
          (> (string-code-point-at S i) 127) false
          :else (recur (inc i)))))
;; the whole file of n bytes in bounded FS2 slices, or [-1]; see kernel-identity-source.kotoba
(defn- era-read [path :string size-text :string] :vector-i64
  (let [n (if (era-decimal? size-text) (mem-parse-dec size-text 0 (string-length size-text)) -1)]
    (if (or (< n 0) (> n ERA-MAX-BYTES)) [-1]
      (loop [at 0 D (vector-alloc n)]
        (if (= at n) D
          (let [count (io-min 262144 (- n at))
                B (vector-i64-from-bytes
                    (typed-cap-call :fs/app-data :string :bytes
                      (string-concat (io-fs2-header 69 path)
                        (string-concat (mem-u2dec at) (string-concat ":" (mem-u2dec count))))))]
            (if (not (era-ack? B count)) [-1]
              (recur (+ at count)
                (loop [i 0 V D]
                  (if (= i count) V (recur (inc i) (vector-assoc! V (+ at i) (vector-at B (+ i 5))))))))))))))
(defn- era-refused? [V :vector-i64] :bool (and (= (vector-count V) 1) (< (vector-at V 0) 0)))
(defn- era-cat [a :string b :string c :string] :string (string-concat a (string-concat b c)))
(defn- era-text [kh :string ih :string kernel :string initramfs :string] :string
  (-> (era-cat "# aiueos-embedded-kernel-sha256=" kh "\n")
      (string-concat (era-cat "# aiueos-embedded-initramfs-sha256=" ih "\n"))
      (string-concat ".section .rdata,\"dr\"\n.balign 16\n.globl aiueos_embedded_kernel_start\naiueos_embedded_kernel_start:\n")
      (string-concat (era-cat ".incbin \"" kernel "\"\n"))
      (string-concat ".globl aiueos_embedded_kernel_end\naiueos_embedded_kernel_end:\n.balign 16\n.globl aiueos_embedded_initramfs_start\naiueos_embedded_initramfs_start:\n")
      (string-concat (era-cat ".incbin \"" initramfs "\"\n"))
      (string-concat ".globl aiueos_embedded_initramfs_end\naiueos_embedded_initramfs_end:\n")))
(defn- seed-main [] :i64
  (if (not= (io-argc) 7)
    (let [w (io-err "error: embedded-release assembly takes output and two name/bytes/path triples\n")] 1)
    (let [path (io-arg 0) K (era-read (io-arg 1) (io-arg 2)) I (era-read (io-arg 4) (io-arg 5))
          kernel (io-arg 3) initramfs (io-arg 6)]
      (cond (or (era-refused? K) (era-refused? I))
            (let [w (io-err "error: kernel or initramfs size is invalid or a slice was refused\n")] 1)
            (or (not (era-ascii? kernel)) (not (era-ascii? initramfs)))
            (let [w (io-err "error: embedded paths must be ASCII\n")] 1)
            (= (io-exists path) 1) (let [w (io-err "error: embedded-release assembly output exists\n")] 1)
            :else
            (let [kh (sh-bytes K) ih (sh-bytes I)
                  V (vector-i64-from-bytes (string-to-utf8 (era-text kh ih kernel initramfs)))
                  n (vector-count V)
                  written (if (and (= (string-length kh) 64) (= (string-length ih) 64))
                            (io-write-bytes V path 0 n) 0)
                  B (io-read-bytes path)]
              (if (and (= written n) (= (vector-count B) n)
                       (loop [i 0]
                         (cond (= i n) true
                               (not= (vector-at B i) (vector-at V i)) false
                               :else (recur (inc i)))))
                0
                (let [w (io-err "error: embedded-release assembly readback differs\n")] 1)))))))
