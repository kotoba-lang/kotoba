;; Native unity fragment, assembled after the exact Amu seed 00/01/02 helpers (JUN-555).
;; Writes os/aiueos's model-identity C header: the bytes the retired inline
;; Python (PYMODEL) in scripts/build-uefi.sh wrote for the same arguments.
;; argv: output total part0 part1 part2 sha256 min max parts name prefix.
;; Every value is copied verbatim, as the Python did, except the digest, which
;; must be exactly 64 hexadecimal digits and is written as lowercase bytes.
;; Non-ASCII anywhere refuses (the Python's ASCII encoding refused it too).
;; The output names a file beneath the FD 3 scope; invalid input writes nothing.
(defn- mid-hex [c :i64] :i64
  (cond (and (>= c 48) (<= c 57)) (- c 48)
        (and (>= c 97) (<= c 102)) (- c 87)
        (and (>= c 65) (<= c 70)) (- c 55) :else -1))
(defn- mid-digest? [S :string] :bool
  (and (= (string-length S) 64)
       (loop [i 0]
         (cond (= i 64) true
               (< (mid-hex (string-code-point-at S i)) 0) false
               :else (recur (inc i))))))
(defn- mid-ascii? [S :string] :bool
  (loop [i 0]
    (cond (= i (string-length S)) true
          (> (string-code-point-at S i) 127) false
          :else (recur (inc i)))))
(defn- mid-hexd [d :i64] :string (string-substring "0123456789abcdef" d (inc d)))
;; 0xhh,0xhh,... over the 32 digest bytes
(defn- mid-bytes [S :string] :string
  (loop [i 0 acc ""]
    (if (= i 32) acc
      (recur (inc i)
        (string-concat acc
          (string-concat (if (= i 0) "0x" ",0x")
            (string-concat (mid-hexd (mid-hex (string-code-point-at S (* 2 i))))
                           (mid-hexd (mid-hex (string-code-point-at S (inc (* 2 i))))))))))))
(defn- mid-line [a :string b :string c :string] :string (string-concat a (string-concat b c)))
(defn- mid-path [prefix :string n :string] :string
  (mid-line "#define AIUEOS_MODEL_PART" n
    (mid-line "_PATH u\"\\\\EFI\\\\AIUEOS\\\\" prefix (mid-line n ".BIN\"" "\n"))))
(defn- mid-header [total :string part0 :string part1 :string part2 :string digest :string
                   minimum :string maximum :string parts :string name :string prefix :string] :string
  (-> "#ifndef AIUEOS_MODEL_IDENTITY_H\n#define AIUEOS_MODEL_IDENTITY_H\n#include <stdint.h>\n"
      (string-concat (mid-line "#define AIUEOS_MODEL_TOTAL_BYTES " total "ULL\n"))
      (string-concat (mid-line "#define AIUEOS_MODEL_PART0_BYTES " part0 "ULL\n"))
      (string-concat (mid-line "#define AIUEOS_MODEL_PART1_BYTES " part1 "ULL\n"))
      (string-concat (mid-line "#define AIUEOS_MODEL_PART2_BYTES " part2 "ULL\n"))
      (string-concat (mid-line "#define AIUEOS_MODEL_PART_COUNT " parts "U\n"))
      (string-concat (mid-line "#define AIUEOS_MODEL_PARTS_TEXT \"" parts "\"\n"))
      (string-concat (mid-line "#define AIUEOS_MODEL_NAME \"" name "\"\n"))
      (string-concat (mid-path prefix "0"))
      (string-concat (mid-path prefix "1"))
      (string-concat (mid-path prefix "2"))
      (string-concat (mid-line "#define AIUEOS_MODEL_MIN_ADDRESS " minimum "ULL\n"))
      (string-concat (mid-line "#define AIUEOS_MODEL_MAX_ADDRESS " maximum "ULL\n"))
      (string-concat "#ifndef AIUEOS_MODEL_IDENTITY_MACROS_ONLY\n")
      (string-concat (mid-line "static const uint8_t aiueos_expected_model_sha256[32]={" (mid-bytes digest) "};\n"))
      (string-concat "#endif\n#endif\n")))
(defn- seed-main [] :i64
  (if (not= (io-argc) 11)
    (let [w (io-err "error: model-identity header takes output and ten identity values\n")] 1)
    (let [path (io-arg 0)
          ascii (loop [i 1]
                  (cond (= i 11) true (mid-ascii? (io-arg i)) (recur (inc i)) :else false))]
      (cond (not ascii) (let [w (io-err "error: model identity values must be ASCII\n")] 1)
            (not (mid-digest? (io-arg 5)))
            (let [w (io-err "error: model SHA-256 must be 64 hexadecimal digits\n")] 1)
            (= (io-exists path) 1) (let [w (io-err "error: model-identity header output exists\n")] 1)
            :else
            (let [V (vector-i64-from-bytes (string-to-utf8
                      (mid-header (io-arg 1) (io-arg 2) (io-arg 3) (io-arg 4) (io-arg 5)
                                  (io-arg 6) (io-arg 7) (io-arg 8) (io-arg 9) (io-arg 10))))
                  n (vector-count V)
                  written (io-write-bytes V path 0 n)
                  B (io-read-bytes path)]
              (if (and (= written n) (= (vector-count B) n)
                       (loop [i 0]
                         (cond (= i n) true
                               (not= (vector-at B i) (vector-at V i)) false
                               :else (recur (inc i)))))
                0
                (let [w (io-err "error: model-identity header readback differs\n")] 1)))))))
