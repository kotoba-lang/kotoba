(ns aiueos.native.llm-v1-result-shape
  (:require [aiueos.native.llm-v1-header :as request]
            [aiueos.native.llm-v1-utf8 :as utf8])
  (:export [aiueos-llm-v1-result-shape-valid]))

;; Kernel-side candidate for the llm-v1 result transport. This checks bytes
;; after a host provider has produced them; it does not select a provider,
;; establish a grant, or lower the kit's nested value in a user ELF.
;;
;; Little-endian 64-byte result header:
;;   0 magic "KLR1", 4 version 1, 8 wire 11, 12 variant (1 ok, 2 error),
;;   16 text bytes, 20 finish-reason keyword bytes,
;;   24 error-code keyword bytes, 28 error-message bytes,
;;   32 input-token count u64, 40 output-token count u64,
;;   48 retryable u32, 52 total payload bytes, 56..63 canonical zero.
;; Each value occupies a separate checked region of its declared length.
;; The result region ownership and non-aliasing are host obligations.
(defn aiueos-llm-v1-result-shape-valid
  [result-header :i64 result-header-bytes :i64
   request-header :i64 request-header-bytes :i64
   text :i64 text-bytes :i64
   finish :i64 finish-bytes :i64
   code :i64 code-bytes :i64
   message :i64 message-bytes :i64] :i64
  (if (or (not= result-header-bytes 64)
          (not= (request/aiueos-llm-v1-header-valid
                  request-header request-header-bytes) 1)) 0
    (let [tag (kernel-load-u32 result-header result-header-bytes 12)
          declared-text (kernel-load-u32 result-header result-header-bytes 16)
          declared-finish (kernel-load-u32 result-header result-header-bytes 20)
          declared-code (kernel-load-u32 result-header result-header-bytes 24)
          declared-message (kernel-load-u32 result-header result-header-bytes 28)
          input-tokens (kernel-load-u64 result-header result-header-bytes 32)
          output-tokens (kernel-load-u64 result-header result-header-bytes 40)
          retryable (kernel-load-u32 result-header result-header-bytes 48)
          declared-total (kernel-load-u32 result-header result-header-bytes 52)
          max-output-tokens (kernel-load-u32 request-header request-header-bytes 24)
          result-capacity (kernel-load-u32 request-header request-header-bytes 36)]
      (if (and (= (kernel-load-u32 result-header result-header-bytes 0) 827477067)
               (= (kernel-load-u32 result-header result-header-bytes 4) 1)
               (= (kernel-load-u32 result-header result-header-bytes 8) 11)
               (or (= tag 1) (= tag 2))
               (not= text 0) (not= finish 0) (not= code 0)
               (not= message 0)
               (= text-bytes declared-text)
               (= finish-bytes declared-finish)
               (= code-bytes declared-code)
               (= message-bytes declared-message)
               (= declared-total (+ text-bytes finish-bytes code-bytes message-bytes))
               (= (kernel-load-u32 result-header result-header-bytes 56) 0)
               (= (kernel-load-u32 result-header result-header-bytes 60) 0)
               (cond (= tag 1)
                       (and (<= text-bytes 65536)
                            (> finish-bytes 0) (<= finish-bytes 256)
                            (= code-bytes 0) (= message-bytes 0)
                            (>= input-tokens 0)
                            (>= output-tokens 0)
                            (<= output-tokens max-output-tokens)
                            (<= text-bytes result-capacity)
                            (= retryable 0))
                     :else
                       (and (= text-bytes 0) (= finish-bytes 0)
                            (> code-bytes 0) (<= code-bytes 256)
                            (<= message-bytes 65536)
                            (= input-tokens 0) (= output-tokens 0)
                            (<= retryable 1)))
               (utf8/aiueos-llm-v1-utf8-valid text text-bytes)
               (utf8/aiueos-llm-v1-utf8-valid finish finish-bytes)
               (utf8/aiueos-llm-v1-utf8-valid code code-bytes)
               (utf8/aiueos-llm-v1-utf8-valid message message-bytes))
        1 0))))
