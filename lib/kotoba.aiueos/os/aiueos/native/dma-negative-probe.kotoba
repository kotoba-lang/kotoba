(ns aiueos.native.dma-negative-probe
  (:require [aiueos.native.kernel :as kernel])
  (:export [main aiueos-isr-6]))

;; A valid full-graph image returning 42 without exercising the DMA contract.
;; The DMA observer must reject it even though ordinary entry checks pass.
(defn- retain-kernel [] :i64 (kernel/main))
(defn aiueos-isr-6 [vector :i64 error :i64 rip :i64 rsp :i64] :i64
  (kernel/aiueos-isr-6 vector error rip rsp))
(defn main [] :i64 (if (> (kernel-owned-page 0) 0) 42 0))
