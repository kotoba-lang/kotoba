(ns aiueos.native.flex-entry
  (:require [aiueos.native.desktop :as desktop]
            [aiueos.value-runtime-entry :as runtime]
            [aiueos.value-runtime-syscall-plan :as syscall]
            [aiueos.value-runtime-domain :as domain]
            [aiueos.value-runtime-capability-table :as capability]
            [aiueos.value-runtime-provider-policy :as provider]
            [aiueos.value-runtime-provider-transport :as transport]
            [aiueos.value-runtime-cas-verify :as cas]
            [cssom.flex-k :as fk]
            [cssom.flexplace-k :as fp])
  (:export [main aiueos-value-runtime-entry aiueos-value-runtime-syscall-plan
            aiueos-value-runtime-publish-domain aiueos-value-runtime-provider-status
            aiueos-value-runtime-capability-grant aiueos-value-runtime-provider-claim
            aiueos-value-runtime-provider-complete aiueos-value-runtime-cas-verify]))

(defn aiueos-value-runtime-entry [a :i64 p :i64 u :i64 r :i64 c :i64] :i64
  (runtime/aiueos-value-runtime-entry a p u r c))
(defn aiueos-value-runtime-syscall-plan [n :i64 d :i64 p :i64 i :i64 s :i64] :i64
  (syscall/aiueos-value-runtime-syscall-plan n d p i s))
(defn aiueos-value-runtime-publish-domain [d :i64] :i64
  (domain/aiueos-value-runtime-publish-domain d))
(defn aiueos-value-runtime-provider-status [g :i64 a :i64] :i64
  (provider/aiueos-value-runtime-provider-status g a))
(defn aiueos-value-runtime-capability-grant [a :i64 s :i64 g :i64 r :i64 o :i64] :i64
  (provider/aiueos-value-runtime-capability-grant a s g r o))
(defn aiueos-value-runtime-provider-claim [] :i64
  (transport/aiueos-value-runtime-provider-claim))
(defn aiueos-value-runtime-provider-complete [t :i64 r :i64 b :i64 n :i64 d :i64] :i64
  (transport/aiueos-value-runtime-provider-complete t r b n d))
(defn aiueos-value-runtime-cas-verify [b :i64 n :i64 e :i64 o :i64 w :i64] :i64
  (cas/aiueos-value-runtime-cas-verify b n e o w))

;; JUN-932 (JUN-920 follow-up): before the desktop starts the kernel runs flex lines of up to sixteen items (cssom.flex-k, its exact
;; share cssom.fxdiv-k and the placement cssom.flexplace-k, all region code) over the cases handed in through fw_cfg (file
;; opt/aiueos/flex, only under a hypervisor, as native/style-entry): [count:2 big endian] then per case [length:2 big endian] [length
;; bytes of the wire stream of lib/kotoba.cssom/scripts/flex_k_cases.py: 8 little-endian u32 header words, 16 bytes per item].
;; Each case is copied into the first 16384 bytes of the owned window 0 (24576 bytes; a case longer than 16384 is read and
;; dropped past the page, and fx-run then refuses it by its item count). Case k (k < 1000) leaves ONE u32 at browser-context byte
;; 4096 + 4 k: status << 24 | digest24, where status is 0 or the refusal code of fx-run (1 more than 16 items, 2 no item, 3 an item field
;; out of range, 4 net out of range) and digest24 is h <- (257 h + 1 + (v & 0xFFFFFF)) & 0xFFFFFF over 5381 + n, the n final sizes, then
;; (when header word 2 has bit 8) the n justify-content offsets, then (bit 9) the n auto-margin offsets. Word 99 holds the marker
;; "FX01" (1180184625), written last; word 319 the case count. No key, no network, no disk.
(defn in! [i v] (kernel-store-u8-16k (kernel-subregion (kernel-owned-window 0 24576) 24576 0 16384) 16384 i v))
(defn put-u32 [ctx at v] (kernel-store-u32 (kernel-subregion ctx 8192 at 4) 4 0 v))

(defn fw-min [a b] (if (< a b) a b))
(defn fw-byte [] (kernel-in-u8 1297))
(defn fw-skip [n] (if (<= n 0) 1 (let [b (fw-byte)] (fw-skip (- n (+ 1 (* 0 b)))))))
(defn fw-be [n acc] (if (= n 0) acc (fw-be (- n 1) (+ (* acc 256) (fw-byte)))))
;; "opt/aiueos/flex" and its NUL
(defn fw-name-byte [i] (case i 0 111 1 112 2 116 3 47 4 97 5 105 6 117 7 101 8 111 9 115 10 47 11 102 12 108 13 101 14 120 0))
(defn fw-name [i ok]
  (if (>= i 56) ok
    (let [b (fw-byte)]
      (fw-name (+ i 1) (if (and (= ok 1) (or (>= i 16) (= b (fw-name-byte i)))) 1 0)))))
(defn fw-find [left]
  (if (<= left 0) 0
    (let [size (fw-be 4 0)
          sel (fw-be 2 0)
          skip (fw-skip 2)
          hit (fw-name 0 1)]
      (if (= (+ hit (* 0 (+ size skip))) 1) sel (fw-find (- left 1))))))
(defn fw-signature [i]
  (if (>= i 4) 1 (if (= (fw-byte) (case i 0 81 1 69 2 77 85)) (fw-signature (+ i 1)) 0)))
(defn fw-select []
  (if (= (bit-and (kernel-cpuid-ecx 1 0) 2147483648) 0) 0
    (do (kernel-out-u16 1296 0)
        (if (= (fw-signature 0) 0) 0
          (do (kernel-out-u16 1296 25)
              (let [sel (fw-find (fw-min (fw-be 4 0) 256))]
                (if (= sel 0) 0 (do (kernel-out-u16 1296 sel) 1))))))))

;; copy n stream bytes into the window; bytes past the 16384th are read and dropped
(defn load-case [i n]
  (if (>= i n) 1
    (let [b (fw-byte)]
      (load-case (+ i 1) (+ n (* 0 (if (< i 16384) (in! i b) 0)))))))

;; ---- the digest of a solved line ----
(defn hmix [h v] (bit-and (+ (* h 257) (+ 1 (bit-and v 16777215))) 16777215))
(defn sx32 [v] (if (>= v 2147483648) (- v 4294967296) v))
(defn size-hash [n i h]
  (if (>= i n) h
    (size-hash n (+ i 1) (hmix h (fk/fx-size (kernel-owned-window 0 24576) 24576 i)))))
(defn off-hash [n i h]
  (if (>= i n) h
    (off-hash n (+ i 1)
              (hmix h (fp/fp-offset (kernel-owned-window 0 24576) 24576
                                    (+ (bit-and (fk/fx-header (kernel-owned-window 0 24576) 24576 2) 15) (* 16 i))
                                    (sx32 (fk/fx-header (kernel-owned-window 0 24576) 24576 3))
                                    (sx32 (fk/fx-header (kernel-owned-window 0 24576) 24576 4)))))))
(defn auto-hash [n i h]
  (if (>= i n) h
    (auto-hash n (+ i 1)
               (hmix h (fp/fp-auto (kernel-owned-window 0 24576) 24576
                                   (+ (fk/fx-header (kernel-owned-window 0 24576) 24576 5)
                                      (+ (* 65536 (fk/fx-header (kernel-owned-window 0 24576) 24576 6)) (* 4294967296 i)))
                                   (sx32 (fk/fx-header (kernel-owned-window 0 24576) 24576 3))
                                   (sx32 (fk/fx-header (kernel-owned-window 0 24576) 24576 4)))))))
(defn digest [n]
  (let [jm (fk/fx-header (kernel-owned-window 0 24576) 24576 2)
        h1 (size-hash n 0 (bit-and (+ 5381 n) 16777215))
        h2 (if (= (bit-and (u64-shift-right jm 8) 1) 1) (off-hash n 0 h1) h1)]
    (if (= (bit-and (u64-shift-right jm 9) 1) 1) (auto-hash n 0 h2) h2)))
(defn run-case [ctx k]
  (let [len (fw-be 2 0)
        l (load-case 0 len)
        r (fk/fx-run (kernel-owned-window 0 24576) 24576)
        rec (if (>= r 0) (digest r) (* 16777216 (- 0 r)))
        a (put-u32 ctx (+ 4096 (* 4 k)) rec)]
    (+ 1 (* 0 (+ l a)))))
(defn cases [ctx k count] (if (>= k count) 1 (cases ctx (+ k 1 (* 0 (run-case ctx k))) count)))

(defn flex-selftest []
  (let [ctx (kernel-browser-context)
        sel (fw-select)]
    (if (= sel 1)
      (let [count (fw-be 2 0)
            done (cases ctx 0 (fw-min count 1000))
            w (put-u32 ctx 1276 count)]
        (put-u32 ctx 396 (+ 1180184625 (* 0 (+ done w)))))
      0)))

(defn main [] :i64
  (let [width (kernel-framebuffer-width)
        registered (kernel-register-value-domain 73)
        published (kernel-publish-current-domain 73)
        enabled (kernel-value-enable-user)]
    (if (and (> width 0) (> registered 0) (= published 73) (= enabled 1))
      (do (flex-selftest) (desktop/goal-model-main)) 0)))
