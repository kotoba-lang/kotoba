(ns target-parity-core
  (:export [main]))

;; The compute body that the parity smoke compiles TWICE -- once for
;; `x86_64-linux` and once for `x86_64-aiueos-kernel-v1` -- so that the claim
;; "the two targets share one emitter" is measured rather than read off
;; `kotoba.kir.target`'s profile table.
;;
;; It is deliberately free of every kernel operation. `kernel-out-u8`,
;; `kernel-out-u32` and `kernel-rdtsc` are refused outside the aiueos kernel
;; target ("bounded kernel memory operation requires the aiueos kernel
;; target") -- the compiler being right, not a defect, but it means a probe
;; carrying them cannot be built for `x86_64-linux` at all and so cannot be
;; the thing whose bytes are compared. The I/O lives next door in
;; `target-parity-probe.kotoba`, which repeats `accumulate` VERBATIM; the smoke
;; closes that gap by finding these bytes inside the bootable image too, rather
;; than trusting that two copies of a definition emit the same code.
;;
;; `limit` is a PARAMETER of `accumulate` in both files, so the body is one
;; shape whatever bound a caller passes. Note what the artifact's `:value` is
;; and is not: for a call with literal bounds the kexe carries the reference
;; interpreter's answer (measured 2026-09-10: `:value 14850` for a bound of
;; 100), and that is an ORACLE, not evidence that the loop was folded away --
;; the same build emits the loop and the smoke counts 15 guest instructions per
;; iteration executing it.
;;
;; The shape is two functions and one export ON PURPOSE. `:exports` gives
;; `main`'s offset into `:code`, so `accumulate` is exactly `[0, that offset)`
;; and the smoke can name the compute body's bytes without parsing an ELF or
;; guessing a boundary. A third function would leave that arithmetic ambiguous.
;; `main` exists because the aiueos kernel profile names a mandatory entry
;; (`:aiueos_kernel_entry`): compiled without one this file is refused with
;; "entryless libraries currently require the kotoba-script web target, the
;; Wasm target, or an entryless native target".

(defn accumulate [i limit acc]
  (if (< i limit)
    (accumulate (+ i 1) limit (+ acc (* i 3)))
    acc))

(defn main []
  (accumulate 0 30 0))
