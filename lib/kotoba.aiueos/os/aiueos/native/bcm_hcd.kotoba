(ns aiueos.native.bcm-hcd
  ;; Record admission for a Broadcom Bluetooth patch-RAM file (BCM.hcd), the
  ;; firmware the Pixel 10 Pro Fold names in /vendor/etc/bluetooth/firmware_config.json
  ;; (folder vendor/firmware/brcm/, chip_id 123, UART transport).
  ;; Judgment only: it reads no file, touches no UART and loads nothing.
  ;;
  ;; A .hcd file is a run of HCI command records with no H4 type byte:
  ;;   byte 0..1  opcode, little-endian    byte 2  parameter length    then that many bytes
  ;; The opcodes below are the public Broadcom vendor opcodes used by the Linux
  ;; btbcm driver: 0xFC4C Write_RAM, 0xFC4E Launch_RAM, 0xFC18 Update_UART_Baud_Rate.
  ;; NOT verified against this device: the real BCM.hcd is not readable from an
  ;; unprivileged shell, so its record layout, its digest and its RAM address map
  ;; are unmeasured. For that reason this module does not judge Write_RAM target
  ;; addresses, and the digest check stays with the caller's pinned artifact.
  ;; spec/devices/google-rango.edn :bluetooth :firmware is the source of the path.
  (:export [header-size record-size admit-record next-offset is-launch self-check]))
(defn byte [v i] (bit-and (u64-shift-right v (* i 8)) 255))
(defn opcode [head] (+ (byte head 0) (* (byte head 1) 256)))
(defn plen [head] (byte head 2))
(defn header-size [] :i64 3)
;; Total size of the record whose first three bytes are `head`, or 0 when it is
;; not admitted: opcode not in the allow-list, a parameter length the opcode does
;; not allow, or a record that would run past `remaining` bytes of the file.
(defn record-size [head :i64 remaining :i64] :i64
  (let [op (opcode head) n (plen head)]
    (if (and (>= remaining 3)
             (or (and (= op 64588) (>= n 4))
                 (and (= op 64590) (= n 4))
                 (and (= op 64536) (= n 6)))
             (<= (+ 3 n) remaining))
      (+ 3 n) 0)))
(defn admit-record [head :i64 remaining :i64] :i64
  (if (> (record-size head remaining) 0) 1 0))
;; Offset of the next record, or -1 when the step would leave the file.
(defn next-offset [off :i64 size :i64 total :i64] :i64
  (if (and (>= off 0) (> size 0) (<= (+ off size) total)) (+ off size) -1))
;; The last record of a patch file must start the firmware.
(defn is-launch [head :i64] :i64 (if (= (opcode head) 64590) 1 0))
(defn bit [ok :bool n :i64] :i64 (if ok n 0))
(defn self-check []
  (+ (bit (= (record-size 0x04fc4c 7) 7) 1)
  (+ (bit (= (record-size 0x09fc4c 12) 12) 2)
  (+ (bit (= (record-size 0x04fc4e 7) 7) 4)
  (+ (bit (= (record-size 0x06fc18 9) 9) 8)
  (+ (bit (= (record-size 0x03fc4c 6) 0) 16)
  (+ (bit (= (record-size 0x05fc4e 8) 0) 32)
  (+ (bit (= (record-size 0x07fc18 10) 0) 64)
  (+ (bit (= (record-size 0x04fc4c 6) 0) 128)
  (+ (bit (= (record-size 0x04fc4c 2) 0) 256)
  (+ (bit (= (record-size 0x04fc2e 7) 0) 512)
  (+ (bit (= (record-size 0x040c03 7) 0) 1024)
  (+ (bit (= (record-size 0xfffc4c 3) 0) 2048)
  (+ (bit (= (admit-record 0x04fc4e 7) 1) 4096)
  (+ (bit (= (admit-record 0x04fc4e 6) 0) 8192)
  (+ (bit (= (next-offset 0 7 7) 7) 16384)
  (+ (bit (= (next-offset 7 7 13) -1) 32768)
  (+ (bit (= (next-offset -1 3 10) -1) 65536)
  (+ (bit (= (next-offset 0 0 10) -1) 131072)
  (+ (bit (= (is-launch 0x04fc4e) 1) 262144)
     (bit (= (is-launch 0x04fc4c) 0) 524288)))))))))))))))))))))
