(ns aiueos.native.itonami-local-model-user-v2
  (:export [main]))

;; A bounded user-v2 consumer of the native host's one-token local model
;; result. The Goal occupies bytes 0..55 of the 64-byte input region; bytes
;; 60..63 are reserved for the host-verified token in this diagnostic profile.
;; This user program has no model, tool, storage or network authority.
(defn main [request :i64 request-bytes :i64] :i64
  (kernel-load-u32 request request-bytes 60))
