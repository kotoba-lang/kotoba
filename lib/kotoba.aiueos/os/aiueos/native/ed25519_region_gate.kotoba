;; JUN-757: public-only streaming SHA-512/raw Ed25519 authority fixtures.
(ns aiueos.native.ed25519-region-gate
  (:require [aiueos.ed25519-region :as e] [aiueos.ed25519 :refer [aiueos-ed25519-pubkey aiueos-ed25519-sign aiueos-ed25519-verify]] [aiueos.sha512 :refer [aiueos-sha512]] [aiueos.sha512-stream :as stream])
  (:export [run]))
(defn p [i v] (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0 v))
(defn word [i] (kernel-load-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0))
(defn check [yes :bool] :i64 (if yes 1 (do (p 75 (+ (word 75) 1)) 0)))
(defn data [i] (kernel-load-u8 (kernel-subregion (kernel-native-font) 524288 (+ 393216 i) 1) 1 0))
(defn d32 [i] (+ (data i) (* (data (+ i 1)) 256) (* (data (+ i 2)) 65536) (* (data (+ i 3)) 16777216)))
(defn rbyte [at] (kernel-load-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1) 1 0))
(defn rput [at value] (kernel-store-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1) 1 0 value))
(defn fill [at count value i]
  (if (>= i count) 1 (do (rput (+ at i) value) (fill at count value (+ i 1)))))
(defn filled [at count value i] :bool
  (if (>= i count) true (if (= (rbyte (+ at i)) value) (filled at count value (+ i 1)) false)))
(defn copy-data [at start count i]
  (if (>= i count) 1 (do (rput (+ at i) (data (+ start i))) (copy-data at start count (+ i 1)))))
(defn same-data [at start count i] :bool
  (if (>= i count) true (if (= (rbyte (+ at i)) (data (+ start i))) (same-data at start count (+ i 1)) false)))
(defn pattern [i] (mod (+ (* i 17) 3) 256))
(defn message-byte [row i]
  (let [mode (d32 (+ row 24)) count (d32 (+ row 20))]
    (if (= mode 0) (data (+ (d32 (+ row 16)) i))
      (if (and (= mode 2) (= i (- count 1))) (bit-xor (pattern i) 1) (pattern i)))))
(defn message [row i]
  (if (>= i (d32 (+ row 20))) 1 (do (rput (+ 65536 i) (message-byte row i)) (message row (+ i 1)))))
(defn same-message [row i] :bool
  (if (>= i (d32 (+ row 20))) true (if (= (rbyte (+ 65536 i)) (message-byte row i)) (same-message row (+ i 1)) false)))
(defn record-byte [at value] (rput (+ 131072 at) value))
(defn record-word [at value] (kernel-store-u32 (kernel-subregion (kernel-value-domain-request-page 73) 262144 (+ 131072 at) 4) 4 0 value))
(defn log-sha [slot i]
  (if (>= i 64) 1
    (do (record-byte (+ (* slot 64) i) (stream/stream-digest-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608 i))
        (log-sha slot (+ i 1)))))
(defn log-old-sha [slot i]
  (if (>= i 64) 1 (do (record-byte (+ 18432 (* slot 64) i) (rbyte (+ 33280 i))) (log-old-sha slot (+ i 1)))))
(defn sha-size [slot] (if (< slot 258) slot (case slot 258 1023 259 1024 260 4096 261 12288 262 65536 1048576)))
(defn hash-message [count i]
  (if (>= i count) 1
    (do (check (= (stream/stream-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608 (pattern i)) 1))
        (if (< count 12289) (rput (+ 65536 i) (pattern i)) 0) (hash-message count (+ i 1)))))
(defn old-hash [count slot]
  (do (check (= (aiueos-sha512 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 count) count
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 33280 64)
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 28672 4096) 4096) 1)) (log-old-sha slot 0)))
(defn sha-cases [slot]
  (if (>= slot 264) 1
    (do (check (= (stream/stream-init (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608) 1))
        (check (= (stream/stream-digest-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608 0) -1))
        (hash-message (sha-size slot) 0)
        (check (= (stream/stream-finish (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608) 1)) (log-sha slot 0)
        (check (= (stream/stream-finish (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608) 0))
        (check (= (stream/stream-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608 0) 0))
        (check (= (stream/stream-digest-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608 64) -1))
        (if (< slot 262) (old-hash (sha-size slot) slot) 0)
        (check (= (stream/stream-wipe (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608) 1))
        (check (filled 16384 4608 0 0)) (p 80 (+ slot 1)) (sha-cases (+ slot 1)))))
(defn stream-snapshot [i]
  (if (>= i 4608) 1 (do (rput (+ 36864 i) (rbyte (+ 16384 i))) (stream-snapshot (+ i 1)))))
(defn stream-unchanged [i] :bool
  (if (>= i 4608) true
    (if (= (rbyte (+ 36864 i)) (rbyte (+ 16384 i))) (stream-unchanged (+ i 1)) false)))
(defn stream-counter [count used]
  (do (kernel-store-u64 (kernel-subregion (kernel-value-domain-request-page 73) 262144 (+ 16384 4224) 8) 8 0 count)
      (kernel-store-u64 (kernel-subregion (kernel-value-domain-request-page 73) 262144 (+ 16384 4232) 8) 8 0 used)))
(defn stream-guards []
  (do (fill 16384 4608 165 0)
      (check (= (stream/stream-init (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4607) 4607) 0))
      (check (= (stream/stream-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4607) 4607 0) 0))
      (check (= (stream/stream-finish (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4607) 4607) 0))
      (check (= (stream/stream-digest-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4607) 4607 0) -1))
      (check (= (stream/stream-wipe (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4607) 4607) 0))
      (check (filled 16384 4608 165 0))
      (stream/stream-init (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608) (stream-snapshot 0)
      (check (= (stream/stream-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608 -1) 0))
      (check (= (stream/stream-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608 256) 0))
      (check (stream-unchanged 0))
      (check (= (stream/stream-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608 42) 1))
      ;; Synthetic counter arithmetic, not hashing2^61 bytes of real input.
      (stream-counter 2305843009213693953 1)
      (check (= (stream/stream-finish (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608) 1))
      (check (filled (+ 16384 4096 112) 7 0 0)) (check (= (rbyte (+ 16384 4096 119)) 1))
      (check (filled (+ 16384 4096 120) 7 0 0)) (check (= (rbyte (+ 16384 4096 127)) 8))
      (stream/stream-init (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608)
      (stream-counter 9223372036854775807 127) (stream-snapshot 0)
      (check (= (stream/stream-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608 0) 0))
      (check (stream-unchanged 0)) (stream-counter -1 127) (stream-snapshot 0)
      (check (= (stream/stream-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608 0) 0))
      (check (stream-unchanged 0)) (stream/stream-wipe (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 4608) 4608)
      (check (filled 16384 4608 0 0)) (p 82 1)))
(defn verify-case [public-bytes signature-bytes message-bytes]
  (e/verify (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 16384) 16384
    (kernel-subregion (kernel-value-domain-request-page 73) 262144 32768 public-bytes) public-bytes
    (kernel-subregion (kernel-value-domain-request-page 73) 262144 33024 signature-bytes) signature-bytes
    (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 message-bytes) message-bytes))
(defn case-run [index]
  (let [row (+ 64 (* index 40))]
    (do (fill 0 16384 165 0)
        (copy-data 32768 (d32 row) (d32 (+ row 4)) 0) (copy-data 33024 (d32 (+ row 8)) (d32 (+ row 12)) 0)
        (message row 0)
        (let [result (verify-case (d32 (+ row 4)) (d32 (+ row 12)) (d32 (+ row 20)))]
          (do (record-word (+ 36864 (* index 4)) result) (check (= result (d32 (+ row 28))))
              (check (filled 0 16384 (if (= (d32 (+ row 32)) 1) 0 165) 0))))
        (check (same-data 32768 (d32 row) (d32 (+ row 4)) 0))
        (check (same-data 33024 (d32 (+ row 8)) (d32 (+ row 12)) 0)) (check (same-message row 0))
        (p 78 (+ index 1)))))
(defn cases [index]
  (if (>= index (d32 8)) 1 (do (case-run index) (cases (+ index 1)))))
(defn log-legacy [slot i]
  (if (>= i 96) 1
    (do (record-byte (+ 49152 (* slot 96) i) (rbyte (if (< i 32) (+ 32896 i) (+ 33408 (- i 32))))) (log-legacy slot (+ i 1)))))
(defn legacy [slot]
  (if (>= slot 3) (p 74 1)
    (let [at (+ (d32 16) (* slot 192)) count (if (= slot 0) 0 slot)]
      (do (copy-data 32768 at 32 0)
          (check (= (aiueos-ed25519-pubkey (kernel-subregion (kernel-value-domain-request-page 73) 262144 32768 32)
                      (kernel-subregion (kernel-value-domain-request-page 73) 262144 32896 128)
                      (kernel-subregion (kernel-value-domain-request-page 73) 262144 28672 4096)
                      (kernel-subregion (kernel-value-domain-request-page 73) 262144 33280 64)) 1))
          (check (same-data 32896 (+ at 32) 32 0)) (fill 24576 1024 0 0)
          (copy-data 24576 at 32 0) (copy-data 24832 (+ at 128) count 0)
          (check (= (aiueos-ed25519-sign (kernel-subregion (kernel-value-domain-request-page 73) 262144 24576 1024) count
                      (kernel-subregion (kernel-value-domain-request-page 73) 262144 33408 64)
                      (kernel-subregion (kernel-value-domain-request-page 73) 262144 28672 4096)) 1))
          (check (same-data 33408 (+ at 64) 64 0)) (log-legacy slot 0)
          (fill 24576 1024 0 0) (copy-data 24576 (+ at 32) 32 0) (copy-data 24608 (+ at 64) 64 0) (copy-data 24672 (+ at 128) count 0)
          (check (= (aiueos-ed25519-verify (kernel-subregion (kernel-value-domain-request-page 73) 262144 24576 1024) count
                      (kernel-subregion (kernel-value-domain-request-page 73) 262144 28672 4096)) 1))
          (rput 24608 (bit-xor (rbyte 24608) 1))
          (check (= (aiueos-ed25519-verify (kernel-subregion (kernel-value-domain-request-page 73) 262144 24576 1024) count
                      (kernel-subregion (kernel-value-domain-request-page 73) 262144 28672 4096)) 0))
          (p 81 (+ slot 1)) (legacy (+ slot 1))))))
(defn guard-call [work-bytes public-bytes signature-bytes message-bytes]
  (do (fill 0 16384 165 0)
      (check (= (e/verify (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 work-bytes) work-bytes
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 32768 public-bytes) public-bytes
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 33024 signature-bytes) signature-bytes
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 message-bytes) message-bytes) 0))
      (check (filled 0 16384 165 0))))
(defn guards []
  (do (guard-call 16383 32 64 0) (guard-call 16384 31 64 0) (guard-call 16384 33 64 0)
      (guard-call 16384 32 63 0) (guard-call 16384 32 65 0) (guard-call 16384 32 64 65537)
      (fill 0 16384 165 0)
      (check (= (e/verify (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 16384) 16384
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 32) 32
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 33024 64) 64
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 0) 0) 0))
      (check (filled 0 16384 165 0))
      (check (= (e/verify (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 16384) 16384
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 32768 32) 32
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 64) 64
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 0) 0) 0))
      (check (filled 0 16384 165 0))
      (check (= (e/verify (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 16384) 16384
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 32768 32) 32
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 33024 64) 64
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 1) 1) 0))
      (check (filled 0 16384 165 0)) (fill 0 16384 0 0) (p 76 1)))
(defn canary [] :bool
  (and (= (rbyte 16384) 91) (= (rbyte 32767) 92) (= (rbyte 65535) 93) (= (rbyte 196608) 94)))
(defn park [] (do (kernel-pause) (park)))
(defn run [] :i64
  (do (kernel-cli) (p 74 0) (p 75 0) (p 76 0) (p 77 0) (p 78 0) (p 79 0) (p 80 0) (p 81 0)
      (if (and (> (kernel-register-value-domain 73) 0) (= (kernel-publish-current-domain 73) 73)
               (= (kernel-value-enable-user) 1) (> (kernel-value-domain-request-page 73) 0))
        (do (p 100 (bit-and (kernel-value-domain-request-page 73) 4294967295)) (p 101 (u64-shift-right (kernel-value-domain-request-page 73) 32))
            (p 79 1) (legacy 0) (sha-cases 0) (stream-guards)
            (rput 16384 91) (rput 32767 92) (rput 65535 93) (rput 196608 94)
            (cases 0) (guards) (p 77 (if (canary) 1 0)) (p 79 2) (park))
        (do (p 75 1) (p 79 2) (park)))))
