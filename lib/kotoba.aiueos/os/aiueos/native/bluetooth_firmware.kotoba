(ns aiueos.native.bluetooth-firmware
  ;; Pinned unmodified linux-firmware rtl8851bu V2 bundle, eco1/key0 only.
  ;; Its native producer places it in unused font padding327680..377445.
  ;; SHA state reuses the completed xHCI input context only before pairing.
  (:require [aiueos.native.xhci :as usb] [aiueos.native.bluetooth-le :as le]
            [aiueos.native.bluetooth-hogp :as hogp] [aiueos.lib.sha256-stream :as sha])
  (:export [load check-image diagnostic]))
(defn byte [i] :i64
  (if (and (>= i 0) (< i 49766))
    (kernel-load-u8-16k
      (kernel-subregion (kernel-native-font) 524288
        (* (quot (+ 327680 i) 16384) 16384) 16384)
      16384 (mod (+ 327680 i) 16384)) 0))
(defn word [at] :i64 (+ (byte at) (* (byte (+ at 1)) 256) (* (byte (+ at 2)) 65536) (* (byte (+ at 3)) 16777216)))
(defn expected [i] :i64
  (case i 0 0x7fcf88c0 1 0x0b2548a5 2 0xff157102 3 0xa35722db 4 0x5e4be655 5 0xdab1ce8d 6 0x9bddb6df 0x85f88f24))
(defn digest-match [i diff] :i64
  (if (= i 8) (if (= diff 0) 1 0)
    (digest-match (+ i 1) (bit-or diff (bit-xor (expected i)
      (sha/load32 (kernel-subregion (kernel-owned-window 0 16384) 16384 8192 512) (+ 106 i)))))))
(defn digest [] :i64
  (do (sha/sha-init (kernel-subregion (kernel-owned-window 0 16384) 16384 8192 512))
      (sha/sha-blocks (kernel-subregion (kernel-owned-window 0 16384) 16384 8192 512)
        (kernel-subregion (kernel-native-font) 524288 327680 49760) 49760 0 777)
      (sha/sha-final (kernel-subregion (kernel-owned-window 0 16384) 16384 8192 512)
        (kernel-subregion (kernel-native-font) 524288 377408 32) 32)
      (digest-match 0 0)))
(defn check-image [] :i64
  (if (and (= (word 0) 0x54425452) (= (word 4) 0x65726f43)
           (= (word 16) 2) (= (word 20) 1) (= (word 24) 49713)
           (= (word 28) 1) (= (word 32) 3841) (= (word 36) 49701)
           (= (word 49741) 8) (= (word 49745) 0)
           (= (byte 49753) 36) (= (byte 49754) 1) (= (byte 49755) 0)
           (= (word 49756) 0x77fd0451)
           (= (word 49760) 0x8723ab55) (= (byte 49764) 0) (= (byte 49765) 0))
    (digest) 0))
(defn diagnostic [i] :i64 (case i 0 (le/word 14) 1 (le/word 15) 0))
(defn fail [reason] :i64 (do (le/put 14 reason) reason))
(defn params [i n off] :i64
  (if (= i n) 1
    (do (usb/ble-param (+ i 1) (if (< (+ off i) 49701) (byte (+ 40 off i))
                                   (byte (+ 49760 (- (+ off i) 49701)))))
        (params (+ i 1) n off))))
(defn fragment-index [fragment] :i64
  (+ (if (< fragment 128) fragment (+ 1 (mod (- fragment 128) 127))) (if (= fragment 197) 128 0)))
(defn download [fragment] :i64
  (if (= fragment 198) 1
    (let [n (if (= fragment 197) 63 252) idx (fragment-index fragment)]
      (do (le/put 14 (+ 65536 fragment)) (usb/ble-param 0 idx) (params 0 n (* fragment 252))
          (if (and (= (le/command 64544 (+ n 1) 7) 1)
                   (= (bit-and (le/packet 6) 127) (bit-and idx 127)))
            (download (+ fragment 1)) 0)))))
(defn key-id [] :i64
  (do (usb/ble-param 0 16) (usb/ble-param 1 164) (usb/ble-param 2 173) (usb/ble-param 3 0) (usb/ble-param 4 176)
      (if (and (= (le/command 64609 5 8) 1) (= (le/packet 6) 0)) 1 0)))
(defn version [] :i64
  (if (not (= (le/command 4097 0 14) 1)) 0
    (let [revision (+ (le/packet 7) (* (le/packet 8) 256))
          subversion (+ (le/packet 12) (* (le/packet 13) 256))]
      (do (le/put 15 (+ revision (* subversion 65536)))
          (if (and (= (le/packet 6) 12) (= (le/packet 10) 93) (= (le/packet 11) 0)
                   (not (= subversion 34897))) 1 0)))))
(defn load [] :i64
  (if (or (not (= (usb/ble-diagnostic 0) 1)) (not (= (le/diagnostic 0) 15))
          (not (= (hogp/diagnostic 0) 0)) (not (= (le/word 10) 65535))) 1
    (if (not (= (check-image) 1)) (fail 2)
      (if (not (= (key-id) 1)) (fail 3)
        (if (not (= (download 0) 1)) (fail 4)
          (if (not (= (version) 1)) (fail 5)
            (if (not (= (le/command 3075 0 6) 1)) (fail 6)
              (if (= (le/configure) 15) (fail 15) (fail 7)))))))))
