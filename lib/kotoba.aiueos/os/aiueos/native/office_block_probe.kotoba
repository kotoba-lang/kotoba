(ns aiueos.native.office-block-probe (:export [read write]))

;; QEMU-only experimental sector transport. It is not linked into the OS,
;; does not grant a guest disk access and is not a journal or release store.
;; The fixture is a separate primary-slave 2048-sector disk. Sector zero is an
;; immutable marker; the boot disk and the diagnostic/key medium are excluded.
;; A marker and size do not identify or authorize any physical device. Do not
;; link this probe into a live OS or pass it guest-controlled memory addresses.
(defn word [p :i64 at :i64] :i64 (kernel-load-u32-4k p 512 at))
(defn put [p :i64 at :i64 v :i64] :i64 (kernel-store-u32-4k p 512 at v))
(defn ready [left :i64 data :bool] :i64
  (let [s (kernel-in-u8 503)]
    (cond (or (= s 0) (= s 255)) 0 (= left 0) 0
          (not= (bit-and s 128) 0) (ready (- left 1) data)
          (not= (bit-and s 33) 0) 0
          (or (not data) (not= (bit-and s 8) 0)) 1
          :else (ready (- left 1) data))))
(defn select [sector :i64 command :i64] :i64
  (if (or (< sector 0) (>= sector 2048)) 0
    (do (kernel-out-u8 502 240)
        (kernel-in-u8 1014) (kernel-in-u8 1014) (kernel-in-u8 1014) (kernel-in-u8 1014)
        (if (= (ready 65536 false) 1)
          (do (kernel-out-u8 1014 2) (kernel-out-u8 498 1)
              (kernel-out-u8 499 (bit-and sector 255))
              (kernel-out-u8 500 (bit-and (quot sector 256) 255))
              (kernel-out-u8 501 (bit-and (quot sector 65536) 255))
              (kernel-out-u8 503 command) (ready 65536 true)) 0))))
(defn transfer-read [page :i64 at :i64] :i64
  (if (= at 512) 1
    (let [w (put page at (kernel-in-u32 496))]
      (transfer-read page (+ at 4)))))
(defn transfer-write [page :i64 at :i64] :i64
  (if (= at 512) 1
    (do (kernel-out-u32 496 (word page at)) (transfer-write page (+ at 4)))))
(defn raw-read [page :i64 sector :i64] :i64
  (if (= (select sector 32) 1)
    (if (= (transfer-read page 0) 1) (ready 65536 false) 0) 0))
(defn identity [scratch :i64] :i64
  (if (= (select 0 236) 1)
    (if (and (= (transfer-read scratch 0) 1) (= (ready 65536 false) 1))
      (let [lba28 (word scratch 120)
            lba48? (not= (bit-and (kernel-load-u16-4k scratch 512 166) 1024) 0)
            ext (kernel-load-u64-4k scratch 512 200)
            format (kernel-load-u16-4k scratch 512 212)
            large? (and (= (bit-and format 49152) 16384) (not= (bit-and format 4096) 0))]
        (if (and (= lba28 2048) (or (not lba48?) (= ext 2048)) (not large?)) 1 0)) 0) 0))
(defn zero-tail [p :i64 at :i64] :bool
  (if (= at 512) true (and (= (word p at) 0) (zero-tail p (+ at 4)))))
(defn provisioned [scratch :i64] :bool
  (and (= (identity scratch) 1) (= (raw-read scratch 0) 1)
       (= (word scratch 0) 0x4f4e5449) (= (word scratch 4) 0x31464346)
       (= (word scratch 8) 1) (= (word scratch 12) 2048) (zero-tail scratch 16)))
(defn disjoint? [a :i64 b :i64] :bool
  (or (and (<= a b) (>= (- b a) 512)) (and (<= b a) (>= (- a b) 512))))
(defn equal [a :i64 b :i64 at :i64] :bool
  (if (= at 512) true (and (= (word a at) (word b at)) (equal a b (+ at 4)))))
(defn read [page :i64 scratch :i64 sector :i64] :i64
  (if (and (> sector 0) (< sector 2048) (disjoint? page scratch) (provisioned scratch))
    (raw-read page sector) 0))
(defn write [page :i64 scratch :i64 sector :i64] :i64
  (if (and (> sector 0) (< sector 2048) (disjoint? page scratch) (provisioned scratch))
    (if (= (select sector 48) 1)
      (if (and (= (transfer-write page 0) 1) (= (ready 65536 false) 1))
        (do (kernel-out-u8 503 231)
            (if (and (= (ready 65536 false) 1) (= (raw-read scratch sector) 1)
                     (equal page scratch 0)) 1 0)) 0) 0) 0))
