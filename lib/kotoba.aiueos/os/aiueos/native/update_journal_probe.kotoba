(ns aiueos.native.update-journal-probe
  ;; Private filesystem/policy component, never a production/user entry.
  (:require [aiueos.native.update-journal :as journal]
            [aiueos.native.desktop :as desktop]
            [aiueos.native.nvme :as nvme]
            [aiueos.native.esp :as esp])
  (:export [run]))
(defn p [i v] (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0 v))
(defn pattern [base i]
  (if (>= i 32) 1
    (do (kernel-store-u8 (kernel-subregion (kernel-browser-context) 8192 1024 32) 32 i (+ base i)) (pattern base (+ i 1)))))
(defn action [a]
  (if (= a 49)
    (let [state (esp/create-state (kernel-browser-context)) mounted (journal/mount 1)
          bytes (pattern 1 0) init (journal/initialize 4 3 3 (kernel-subregion (kernel-browser-context) 8192 1024 32)) next (pattern 2 0)]
      (do (p 76 state) (p 77 init) (p 78 mounted)
          (journal/prepare 5 (kernel-subregion (kernel-browser-context) 8192 1024 32))))
    (let [mounted (journal/mount 0) loaded (journal/load)]
      (if (<= loaded 0) loaded
        (case a
          50 (journal/trial)
          51 (do (pattern 2 0) (journal/confirm 5 (kernel-subregion (kernel-browser-context) 8192 1024 32)))
          52 (do (pattern 3 0) (journal/prepare 6 (kernel-subregion (kernel-browser-context) 8192 1024 32)) (journal/trial) (journal/rollback))
          53 (journal/policy 7)
          54 (do (pattern 2 0) (journal/prepare 5 (kernel-subregion (kernel-browser-context) 8192 1024 32)))
          55 (do (pattern 1 0) (journal/initialize 1 1 1 (kernel-subregion (kernel-browser-context) 8192 1024 32)))
          56 (journal/policy 8)
          57 (do (pattern 1 0) (journal/confirm 5 (kernel-subregion (kernel-browser-context) 8192 1024 32)))
          65 (do (pattern 3 0) (journal/prepare 4294967297 (kernel-subregion (kernel-browser-context) 8192 1024 32)) (journal/trial) (journal/rollback))
          66 (do (pattern 4 0) (journal/prepare 9223372036854775807 (kernel-subregion (kernel-browser-context) 8192 1024 32)) (journal/trial) (journal/rollback))
          loaded)))))
(defn fw-byte [] (kernel-in-u8 1297))
(defn fw-skip [n] (if (<= n 0) 1 (let [b (fw-byte)] (fw-skip (- n (+ 1 (* 0 b)))))))
(defn fw-be [n acc] (if (= n 0) acc (fw-be (- n 1) (+ (* acc 256) (fw-byte)))))
;; "opt/aiueos/journal" and its NUL
(defn fw-name-byte [i] (case i 0 111 1 112 2 116 3 47 4 97 5 105 6 117 7 101 8 111 9 115 10 47 11 106 12 111 13 117 14 114 15 110 16 97 17 108 0))
(defn fw-name [i ok]
  (if (>= i 56) ok
    (let [b (fw-byte)]
      (fw-name (+ i 1) (if (and (= ok 1) (or (>= i 19) (= b (fw-name-byte i)))) 1 0)))))
(defn fw-find [left]
  (if (<= left 0) 0
    (let [size (fw-be 4 0)
          sel (fw-be 2 0)
          skip (fw-skip 2)
          hit (fw-name 0 1)]
      (if (= (+ hit (* 0 (+ size skip))) 1) sel (fw-find (- left 1))))))
(defn fw-signature [i]
  (if (>= i 4) 1 (if (= (fw-byte) (case i 0 81 1 69 2 77 85)) (fw-signature (+ i 1)) 0)))
(defn fw-request []
  (if (= (bit-and (kernel-cpuid-ecx 1 0) 2147483648) 0) 0
    (do (kernel-out-u16 1296 0)
        (if (= (fw-signature 0) 0) 0
          (do (kernel-out-u16 1296 25)
              (let [sel (fw-find (min (fw-be 4 0) 256))]
                (if (= sel 0) 0 (do (kernel-out-u16 1296 sel) (fw-byte)))))))))

(defn park [] (do (kernel-pause) (park)))
(defn run [] :i64
  (let [irq (kernel-cli) ctx (kernel-browser-context) a (fw-request)]
    (do (p 86 6) (p 75 a)
        (if (= a 254) (desktop/input-main) 0)
        (p 74 (if (not (= (nvme/probe ctx) 15)) -100
                (if (not (= (esp/run ctx) 15)) -101 (action a))))
        (p 79 (+ 1 (* irq 0))) (park))))
