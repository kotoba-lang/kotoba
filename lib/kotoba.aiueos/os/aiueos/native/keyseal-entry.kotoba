(ns aiueos.native.keyseal-entry
  (:require [aiueos.native.kernel :as kernel]
            [aiueos.native.desktop :as desktop]
            [aiueos.value-runtime-entry :as runtime]
            [aiueos.value-runtime-syscall-plan :as syscall]
            [aiueos.value-runtime-domain :as domain]
            [aiueos.value-runtime-capability-table :as capability]
            [aiueos.value-runtime-provider-policy :as provider]
            [aiueos.value-runtime-provider-transport :as transport]
            [aiueos.value-runtime-cas-verify :as cas]
            [aiueos.keyseal :as ks])
  (:export [main aiueos-value-runtime-entry aiueos-value-runtime-syscall-plan
            aiueos-value-runtime-publish-domain aiueos-value-runtime-provider-status
            aiueos-value-runtime-capability-grant aiueos-value-runtime-provider-claim
            aiueos-value-runtime-provider-complete aiueos-value-runtime-cas-verify]))

;; Preserve the actual kernel graph; v3 owns the controlled #UD vector.
(defn legacy-kernel-undefined [v :i64 e :i64 p :i64 s :i64] :i64
  (kernel/aiueos-isr-6 v e p s))
(defn aiueos-value-runtime-entry [a :i64 p :i64 u :i64 r :i64 c :i64] :i64
  (runtime/aiueos-value-runtime-entry a p u r c))
(defn aiueos-value-runtime-syscall-plan [n :i64 d :i64 p :i64 i :i64 s :i64] :i64
  (syscall/aiueos-value-runtime-syscall-plan n d p i s))
(defn aiueos-value-runtime-publish-domain [d :i64] :i64
  (domain/aiueos-value-runtime-publish-domain d))
(defn aiueos-value-runtime-provider-status [g :i64 a :i64] :i64
  (provider/aiueos-value-runtime-provider-status g a))
(defn aiueos-value-runtime-capability-grant [a :i64 s :i64 g :i64 r :i64 o :i64] :i64
  (provider/aiueos-value-runtime-capability-grant a s g r o))
(defn aiueos-value-runtime-provider-claim [] :i64
  (transport/aiueos-value-runtime-provider-claim))
(defn aiueos-value-runtime-provider-complete [t :i64 r :i64 b :i64 n :i64 d :i64] :i64
  (transport/aiueos-value-runtime-provider-complete t r b n d))
(defn aiueos-value-runtime-cas-verify [b :i64 n :i64 e :i64 o :i64 w :i64] :i64
  (cas/aiueos-value-runtime-cas-verify b n e o w))

;; W3f slice (ADR-0277): before the desktop starts the kernel seals a seed under a passphrase with
;; aiueos.keyseal, opens it again with the right passphrase, with a wrong one, and after one ciphertext byte
;; was changed, and leaves the results in the browser context for the QEMU gate. The seed is the public RFC 8032
;; section 7.1 test seed 1, the passphrase and salt are public test values: no device key is sealed. Word 99 is
;; the marker, written last.
;; ctx bytes: pass 1024 (32), salt 1056 (16), seed 1088 (32), blob 1280 (64, words 320..335), k 1408 (64),
;; msg 1472 (128), good open 1664 (32, words 416..423), wrong-passphrase open 1696 (words 424..431),
;; changed-blob open 1728 (words 432..439), wrong pass 1824 (32), changed blob 1856 (64).
;; Status words: 440 seal, 441 good open, 442 wrong-passphrase open, 443 changed-blob open.
(defn seed-flat [i]
  (case i 0 157 1 97 2 177 3 157 4 239 5 253 6 90 7 96 8 186 9 132 10 74 11 244 12 146 13 236 14 44 15 196 16 68 17 73 18 197 19 105 20 123 21 50 22 105 23 25 24 112 25 59 26 172 27 3 28 28 29 174 30 127 31 96 0))
(defn pass-byte [i]
  (case i 0 99 1 111 2 114 3 114 4 101 5 99 6 116 7 32 8 104 9 111 10 114 11 115 12 101 0))
(defn wrong-byte [i]
  (case i 0 99 1 111 2 114 3 114 4 101 5 99 6 116 7 32 8 104 9 111 10 114 11 115 12 102 0))
(defn salt-byte [i] (+ 17 (* 13 i)))

(defn put8 [ctx at v] (kernel-store-u8 (kernel-subregion ctx 8192 at 1) 1 0 v))
(defn get8 [ctx at] (kernel-load-u8 (kernel-subregion ctx 8192 at 1) 1 0))

(defn fill-pass [ctx base n i kind]
  (if (>= i 32) 0
    (let [x (put8 ctx (+ base i) (if (< i n) (if (= kind 0) (pass-byte i) (wrong-byte i)) 0))]
      (fill-pass ctx base n (+ i (+ 1 (* 0 x))) kind))))
(defn fill-salt [ctx i]
  (if (>= i 16) 0
    (let [x (put8 ctx (+ 1056 i) (salt-byte i))]
      (fill-salt ctx (+ i (+ 1 (* 0 x)))))))
(defn fill-seed [ctx i]
  (if (>= i 32) 0
    (let [x (put8 ctx (+ 1088 i) (seed-flat i))]
      (fill-seed ctx (+ i (+ 1 (* 0 x)))))))
(defn fill-blob-salt [ctx i]
  (if (>= i 16) 0
    (let [x (put8 ctx (+ 1280 i) (salt-byte i))]
      (fill-blob-salt ctx (+ i (+ 1 (* 0 x)))))))
(defn copy-blob [ctx i]
  (if (>= i 64) 0
    (let [x (put8 ctx (+ 1856 i) (get8 ctx (+ 1280 i)))]
      (copy-blob ctx (+ i (+ 1 (* 0 x)))))))

(defn kdf-rounds [ctx salt-off k-off msg-off n]
  (if (<= n 0) 1
    (let [r (ks/aiueos-keyseal-round (kernel-subregion ctx 8192 salt-off 16) (kernel-subregion ctx 8192 k-off 64)
                                     (kernel-subregion ctx 8192 msg-off 128) (kernel-subregion ctx 8192 4096 4096))]
      (kdf-rounds ctx salt-off k-off msg-off (- n (+ 1 (* 0 r)))))))

;; K into ctx[k-off .. k-off+64) from the 32-byte padded passphrase at pass-off and the salt at salt-off
(defn kdf-run [ctx pass-off salt-off k-off msg-off iters]
  (let [f (ks/aiueos-keyseal-first (kernel-subregion ctx 8192 pass-off 32) (kernel-subregion ctx 8192 salt-off 16)
                                   (kernel-subregion ctx 8192 k-off 64) (kernel-subregion ctx 8192 msg-off 128)
                                   (kernel-subregion ctx 8192 4096 4096))
        r (kdf-rounds ctx salt-off k-off msg-off (- iters 1))]
    (+ 1 (* 0 (+ f r)))))

(defn do-seal [ctx iters]
  (let [d (kdf-run ctx 1024 1056 1408 1472 iters)
        z (ks/aiueos-keyseal-seal-with-k (kernel-subregion ctx 8192 1056 16) (kernel-subregion ctx 8192 1088 32)
                                         (kernel-subregion ctx 8192 1280 64) (kernel-subregion ctx 8192 1408 64)
                                         (kernel-subregion ctx 8192 1472 128) (kernel-subregion ctx 8192 4096 4096))]
    (+ 1 (* 0 (+ d z)))))
(defn open-at [ctx pass-off blob-off out-off iters]
  (let [d (kdf-run ctx pass-off 1056 1408 1472 iters)
        z (ks/aiueos-keyseal-open-with-k (kernel-subregion ctx 8192 1056 16) (kernel-subregion ctx 8192 blob-off 64)
                                         (kernel-subregion ctx 8192 out-off 32) (kernel-subregion ctx 8192 1408 64)
                                         (kernel-subregion ctx 8192 1472 128) (kernel-subregion ctx 8192 4096 4096))]
    (+ z (* 0 d))))
(defn open-good [ctx iters] (open-at ctx 1024 1280 1664 iters))
(defn open-wrong [ctx iters] (open-at ctx 1824 1280 1696 iters))
(defn open-changed [ctx iters] (open-at ctx 1024 1856 1728 iters))

(defn put-result [ctx i value]
  (kernel-store-u32 (kernel-subregion ctx 8192 (* i 4) 4) 4 0 value))

(defn seal-selftest []
  (let [ctx (kernel-browser-context)
        iters 1024
        a (fill-pass ctx 1024 13 0 0)
        b (fill-pass ctx 1824 13 0 1)
        c (fill-salt ctx 0)
        d (fill-seed ctx 0)
        e (fill-blob-salt ctx 0)
        s (do-seal ctx iters)
        f (copy-blob ctx 0)
        f2 (put8 ctx (+ 1856 20) (bit-xor (get8 ctx (+ 1856 20)) 1))
        g (open-good ctx iters)
        h (open-wrong ctx iters)
        i (open-changed ctx iters)
        r0 (put-result ctx 440 s)
        r1 (put-result ctx 441 g)
        r2 (put-result ctx 442 h)
        r3 (put-result ctx 443 i)]
    (put-result ctx 99 (+ 1263748417 (* 0 (+ a (+ b (+ c (+ d (+ e (+ f (+ f2 (+ r0 (+ r1 (+ r2 r3)))))))))))))))

(defn main [] :i64
  ;; Consent gate image (ADR-0275 W1): the goal-model profile, whose Itonami Enter
  ;; opens the consent surface. The root explicitly selects the image's private GOP/Browser profile.
  ;; PCI/GOP/font sealing happens before any Kotoba body receives a region.
  (let [width (kernel-framebuffer-width)
        registered (kernel-register-value-domain 73)
        published (kernel-publish-current-domain 73)
        enabled (kernel-value-enable-user)]
    (if (and (> width 0) (> registered 0) (= published 73) (= enabled 1))
      (do (seal-selftest) (desktop/goal-model-main)) 0)))
