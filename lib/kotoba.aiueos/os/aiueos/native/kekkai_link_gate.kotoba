;; JUN-757: opt-in NIC + native Kekkai/IK/datagram integration diagnostic.
;; Public Cacophony keys/prologue, fixed synthetic100..101s, fixed peer.
;; NOT an installed app, entropy/roster/consent service, SSH or production NIC.
;; Process40 public probes, report after every RX descriptor repost, then wipe.
(ns aiueos.native.kekkai-link-gate
  (:require [aiueos.native.rtl8139-cplus :as nic] [aiueos.native.ipv4-udp :as udp]
            [kekkai.wire-region :as w] [noise.ik-region :as n] [noise.datagram-region :as d])
  (:export [run]))
(defn p [i v] (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0 v))
(defn word [i] (kernel-load-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0))
(defn check [yes :bool] :i64 (if yes 1 (do (p 75 (+ (word 75) 1)) 0)))
(defn data [i] (kernel-load-u8 (kernel-subregion (kernel-native-font) 524288 393280 512) 512 i))
(defn b [i] (kernel-load-u8-4k (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 1536) 1536 i))
(defn cb [i] (kernel-load-u8-4k (kernel-subregion (kernel-value-domain-request-page 73) 262144 98304 1536) 1536 i))
(defn ob [i] (kernel-load-u8-4k (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 1536) 1536 i))
(defn cp [i v] (kernel-store-u8-4k (kernel-subregion (kernel-value-domain-request-page 73) 262144 229376 1536) 1536 i v))
(defn wire-output [i] (kernel-load-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 (+ 196605 i) 1) 1 0))
(defn fill-wire [i]
  (if (>= i 65539) 1
    (do (if (< i 65536) (kernel-store-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536 i (mod i 256)) 0)
        (kernel-store-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 (+ 196605 i) 1) 1 0 165) (fill-wire (+ i 1)))))
(defn sentinel-wire [i] :bool
  (if (>= i 65539) true (and (= (wire-output i) 165) (sentinel-wire (+ i 1)))))
(defn same-wire [offset i end] :bool
  (if (>= i end) true (and (= (wire-output i) (mod (- i offset) 256)) (same-wire offset (+ i 1) end))))
(defn wire-types [kind]
  (if (> kind 5) 1
    (do (check (= (w/wrap-inner kind (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 31) 31
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 32) 32 31) 32))
        (check (= (w/inner-type (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 32) 32 32) kind))
        (wire-types (+ kind 1)))))
(defn wire-checks []
  (do (fill-wire 0)
      (check (= (w/outer-type (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 0) 0 0) 0))
      (check (= (w/outer-type (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 1) 1 1) 0))
      (check (= (w/outer-type (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 2) 2 2) 0))
      (check (= (w/inner-type (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 0) 0 0) 0))
      (check (= (w/wrap-outer 48 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 0) 0
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 2) 2 0) -1))
      (check (= (w/wrap-inner 1 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 0) 0
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 0) 0 0) -1))
      (check (= (w/wrap-outer 51 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196605 65539) 65539 0) -1))
      (check (= (w/wrap-inner 6 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196605 65539) 65539 0) -1))
      (check (= (w/wrap-outer 48 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 1) 1
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196605 65539) 65539 2) -1))
      (check (= (w/wrap-outer 48 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196605 65539) 65539 65536) -1))
      (check (= (w/wrap-inner 1 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196605 65539) 65539 65536) -1))
      (check (= (w/wrap-outer 48 (kernel-subregion (kernel-value-domain-request-page 73) 262144 196605 65539) 65539
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196605 65539) 65539 1) -1))
      (check (sentinel-wire 0))
      (check (= (w/wrap-outer 50 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 0) 0
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 3) 3 0) 3))
      (check (= (w/outer-type (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 3) 3 3) 50))
      (check (= (w/wrap-outer 48 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196605 65539) 65539 65535) 65538))
      (check (= (w/outer-type (kernel-subregion (kernel-value-domain-request-page 73) 262144 196605 65539) 65539 65538) 48))
      (check (same-wire 3 3 65538)) (check (= (wire-output 65538) 165))
      (check (= (w/wrap-inner 1 (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 65536) 65536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196605 65539) 65539 65535) 65536))
      (check (same-wire 1 1 65536))
      (wire-types 1) (p 92 1)))
(defn seed [i]
  (if (>= i 32) 1
    (do (kernel-store-u8-16k (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192) 8192 (+ 160 i) (data (+ 64 i)))
        (kernel-store-u8-16k (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192) 8192 (+ 224 i) (data (+ 96 i)))
        (kernel-store-u8-16k (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192) 8192 (+ 288 i) (data (+ 160 i))) (seed (+ i 1)))))
(defn prologue [i]
  (if (>= i 9) 1
    (do (check (= (n/prologue-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192) 8192
                   (case i 0 74 1 111 2 104 3 110 4 32 5 71 6 97 7 108 116)) 1)) (prologue (+ i 1)))))
(defn initialize []
  (do (seed 0) (check (= (n/initialize (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192) 8192 0 1) 1))
      (prologue 0) (check (= (n/prologue-finish (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192) 8192) 1))))
(defn copy-in [i size]
  (if (>= i size) 1
    (do (kernel-store-u8-4k (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 1536) 1536 i (nic/rx-byte i)) (copy-in (+ i 1) size))))
(defn endpoint? [description]
  (and (> description 0) (= (udp/source-port description) 22088) (= (udp/destination-port description) 22089)
       (= (b 6) 2) (= (b 7) 0) (= (b 8) 0) (= (b 9) 0) (= (b 10) 0) (= (b 11) 1)
       (= (b 26) 10) (= (b 27) 77) (= (b 28) 0) (= (b 29) 1)
       (= (b 30) 10) (= (b 31) 77) (= (b 32) 0) (= (b 33) 2)))
;; Reply uses a fresh20-byte IPv4 header, swapped endpoints, checksummed UDP.
(defn hi [v] (bit-and (u64-shift-right v 8) 255))
(defn lo [v] (bit-and v 255))
(defn fold [v] (if (> v 65535) (fold (+ (bit-and v 65535) (u64-shift-right v 16))) v))
(defn raw-byte [i count]
  (if (< i 6) (b (+ i 6))
    (if (< i 12) (b (- i 6))
      (if (and (>= i 26) (< i 30)) (b (+ i 4))
        (if (and (>= i 30) (< i 34)) (b (- i 4))
          (if (>= i 42) (if (< i (+ 42 count)) (ob (- i 42)) 0)
            (case i 12 8 13 0 14 69 15 0 16 (hi (+ count 28)) 17 (lo (+ count 28))
              18 (b 18) 19 (b 19) 20 0 21 0 22 64 23 17 24 0 25 0
              34 86 35 73 36 86 37 72 38 (hi (+ count 8)) 39 (lo (+ count 8)) 40 0 41 0 0)))))))
(defn total [i end count acc]
  (if (>= i end) (fold acc)
    (total (+ i 2) end count (+ acc (* (raw-byte i count) 256) (if (< (+ i 1) end) (raw-byte (+ i 1) count) 0)))))
(defn emit [i size count ip-sum udp-sum]
  (if (>= i size) 1
    (do (check (= (nic/tx-byte i (case i 24 (hi ip-sum) 25 (lo ip-sum) 40 (hi udp-sum) 41 (lo udp-sum) (raw-byte i count))) 1))
        (emit (+ i 1) size count ip-sum udp-sum))))
(defn transmit [count]
  (if (or (< count 3) (> count 1472)) 0
    (let [ip-sum (- 65535 (total 14 34 count 0))
          udp-sum (- 65535 (total 34 (+ 42 count) count (+ 17 (+ count 8) (total 26 34 count 0))))]
      (do (emit 0 (if (< count 18) 60 (+ 42 count)) count ip-sum (if (= udp-sum 0) 65535 udp-sum))
          (if (= (nic/send (kernel-subregion (kernel-browser-context) 8192 1024 512) 512 (if (< count 18) 60 (+ 42 count))) 1)
            (do (p 78 (+ (word 78) 1)) 1) (do (p 75 (+ (word 75) 1)) 0))))))
(defn response-plain [i]
  (if (>= i 15) 1 (do (cp i (data (+ 480 i))) (response-plain (+ i 1)))))
(defn save-token [i]
  (if (>= i 32) 1
    (do (kernel-store-u8 (kernel-subregion (kernel-browser-context) 8192 2048 32) 32 i
          (n/token-byte (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192) 8192 i)) (save-token (+ i 1)))))
(defn same-token [i] :bool
  (if (>= i 32) true
    (and (= (kernel-load-u8 (kernel-subregion (kernel-browser-context) 8192 2048 32) 32 i)
            (kernel-load-u8-4k (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 1536) 1536 i)) (same-token (+ i 1)))))
(defn same-plain [i] :bool
  (if (>= i 16) true (and (= (cb i) (data (+ 448 i))) (same-plain (+ i 1)))))
(defn respond-handshake []
  (do (check (same-plain 0)) (response-plain 0)
      (check (= (n/set-length (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192) 8192 15) 1))
      (check (= (n/prepare-write (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192) 8192) 1)) (save-token 0)
      (check (= (n/write-message (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192)
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 229376 15) 15
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 1536) 1536) 63))
      (check (same-token 0)) (check (= (n/status (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192) 8192) 3))
      (check (= (d/from-handshake (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 17408) 17408
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192) 8192
                  (kernel-subregion (kernel-native-font) 524288 393440 32) 32 100) 1))
      (n/wipe (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192) 8192)
      (p 89 2)
      (transmit (w/wrap-outer 49 (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 1536) 1536
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 1536) 1536 63))))
(defn handshake [at count]
  (if (= (word 89) 1)
    (do (n/set-length (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192) 8192 count)
        ;; The published positive packet exercises prepared full-packet read;
        ;; malformed probes exercise the transactional automatic path. This
        ;; fixture selection is not a product peer policy or compiler fix.
        (if (= (word 84) 11)
          (check (= (n/prepare-read (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192)
                     (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1536) 1536) 1)) 0)
        (if (= (n/read-message (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192)
                 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1536) 1536
                 (kernel-subregion (kernel-value-domain-request-page 73) 262144 98304 1536) 1536) 16) (respond-handshake) 0)) 0))
(defn copy-body [i count]
  (if (>= i count) 1 (do (cp i (cb (+ i 1))) (copy-body (+ i 1) count))))
(defn reply-data [kind count]
  (do (copy-body 0 (- count 1))
      (let [plain (w/wrap-inner (if (= kind 2) 3 kind) (kernel-subregion (kernel-value-domain-request-page 73) 262144 229376 1536) 1536
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 98304 1536) 1536 (- count 1))]
        (do (check (= (d/set-length (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 17408) 17408 plain) 1))
            (let [sealed (d/seal (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 17408)
                           (kernel-subregion (kernel-value-domain-request-page 73) 262144 98304 1536) 1536
                           (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 1536) 1536 101)]
              (transmit (w/wrap-outer 50 (kernel-subregion (kernel-value-domain-request-page 73) 262144 131072 1536) 1536
                          (kernel-subregion (kernel-value-domain-request-page 73) 262144 196608 1536) 1536 sealed)))))))
(defn dispatch [count]
  (let [kind (w/inner-type (kernel-subregion (kernel-value-domain-request-page 73) 262144 98304 1536) 1536 count)]
    (if (or (= kind 1) (= kind 2)) (reply-data kind count)
      (if (and (= kind 5) (= count 1)) (do (p 90 (+ (word 90) 1)) 1) 0))))
(defn transport [at count]
  (if (= (word 89) 2)
    (do (check (= (d/advice (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 17408) 17408 101) 0))
        (d/set-length (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 17408) 17408 count)
        (let [plain (d/open (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 17408)
                       (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1536) 1536
                       (kernel-subregion (kernel-value-domain-request-page 73) 262144 98304 1536) 1536 101)]
          (if (>= plain 0) (do (p 91 (+ (word 91) 1)) (dispatch plain)) 0))) 0))
(defn protocol [description]
  (let [at (+ 65536 (udp/payload-offset description)) count (udp/payload-length description)]
    (let [kind (w/outer-type (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1536) 1536 count)]
      (if (= kind 48) (handshake (+ at 3) (- count 3))
        (if (= kind 50) (transport (+ at 3) (- count 3)) 0)))))
(defn received [size]
  (do (copy-in 0 size)
      (let [description (udp/parse (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 1536) 1536 size)]
        (if (and (endpoint? description) (= (protocol description) 1)) 0 (p 88 (+ (word 88) 1))))
      (nic/release (kernel-subregion (kernel-browser-context) 8192 1024 512) 512) (p 84 (+ (word 84) 1))))
(defn zero [at count i] :bool
  (if (>= i count) true
    (and (= (kernel-load-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 at count) count i) 0) (zero at count (+ i 1)))))
(defn park [] (do (kernel-pause) (park)))
(defn poll []
  (if (>= (word 84) 40)
    (do (p 93 1) (n/wipe (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 8192) 8192)
        (p 93 2) (d/wipe (kernel-subregion (kernel-value-domain-request-page 73) 262144 16384 17408) 17408)
        (p 93 3) (p 76 (if (and (zero 0 8192 0) (zero 16384 17408 0)) 1 0))
        (p 93 4) (p 77 (if (and (= (b 1535) 61)
                       (= (kernel-load-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536 8192) 91)
                       (= (kernel-load-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536 16383) 92)
                       (= (kernel-load-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536 33792) 93)
                       (= (kernel-load-u8-4k (kernel-subregion (kernel-owned-window 10 16384) 16384 4096 4096) 4096 1514) 71)
                       (= (kernel-load-u8-4k (kernel-subregion (kernel-owned-window 10 16384) 16384 12288 4096) 4096 1536) 81)) 1 0))
        (p 79 2) (park))
    (let [size (nic/rx-length (kernel-subregion (kernel-browser-context) 8192 1024 512) 512)]
      (do (if (> size 0) (do (p 83 (+ (word 83) 1)) (received size))
            (if (< size 0) (do (p 87 (+ (word 87) 1)) (nic/release (kernel-subregion (kernel-browser-context) 8192 1024 512) 512)
                              (p 84 (+ (word 84) 1))) 0)) (kernel-pause) (poll)))))
(defn run [] :i64
  (do (kernel-cli) (p 74 0) (p 75 0) (p 76 0) (p 77 0) (p 78 0) (p 79 0) (p 83 0) (p 84 0) (p 87 0) (p 88 0) (p 89 1) (p 90 0) (p 91 0) (p 92 0)
      (if (and (> (kernel-register-value-domain 73) 0) (= (kernel-publish-current-domain 73) 73)
               (= (kernel-value-enable-user) 1) (> (kernel-value-domain-request-page 73) 0))
        (do (p 100 (bit-and (kernel-value-domain-request-page 73) 4294967295))
            (p 101 (u64-shift-right (kernel-value-domain-request-page 73) 32))
            (wire-checks) (kernel-store-u8-4k (kernel-subregion (kernel-value-domain-request-page 73) 262144 65536 1536) 1536 1535 61)
            (kernel-store-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536 8192 91)
            (kernel-store-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536 16383 92)
            (kernel-store-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536) 65536 33792 93)
            (kernel-store-u8-4k (kernel-subregion (kernel-owned-window 10 16384) 16384 4096 4096) 4096 1514 71)
            (kernel-store-u8-4k (kernel-subregion (kernel-owned-window 10 16384) 16384 12288 4096) 4096 1536 81)
            (initialize) (p 74 (nic/start (kernel-subregion (kernel-browser-context) 8192 1024 512) 512))
            (if (= (word 74) 1) (do (p 79 1) (poll)) (do (p 75 (+ (word 75) 1)) (p 79 2) (park))))
        (do (p 75 1) (p 79 2) (park)))))
