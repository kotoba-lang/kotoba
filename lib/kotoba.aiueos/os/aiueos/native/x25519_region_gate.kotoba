;; JUN-757: execute the existing, unchanged OS X25519 entry, not a new port.
;; Public RFC7748 + all518 vendored Wycheproof cases; no real device keys.
(ns aiueos.native.x25519-region-gate
  (:require [aiueos.x25519 :as x])
  (:export [run]))
(defn p [i v] (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0 v))
(defn word [i] (kernel-load-u32 (kernel-subregion (kernel-browser-context) 8192 (* i 4) 4) 4 0))
(defn data [n i]
  (kernel-load-u8-4k (kernel-subregion (kernel-native-font) 524288 (+ 393280 (* n 128)) 128) 128 i))
(defn expected-return [n]
  (kernel-load-u32 (kernel-subregion (kernel-native-font) 524288 (+ 393280 (* n 128)) 128) 128 100))
(defn at [i] (kernel-load-u8-4k (kernel-subregion (kernel-browser-context) 8192 1024 1024) 1024 i))
(defn put [i v] (kernel-store-u8-4k (kernel-subregion (kernel-browser-context) 8192 1024 1024) 1024 i v))
(defn seed [n i]
  (if (>= i 64) 1 (do (put i (data n i)) (seed n (+ i 1)))))
(defn fill [i end v]
  (if (>= i end) 1 (do (put i v) (fill (+ i 1) end v))))
(defn same-output [n i]
  (if (>= i 32) 1
    (if (= (at (+ 64 i)) (data n (+ 64 i))) (same-output n (+ i 1)) 0)))
(defn same-input [n i]
  (if (>= i 64) 1
    (if (= (at i) (data n i)) (same-input n (+ i 1)) 0)))
(defn log-output [n i]
  (if (>= i 32) 1
    (do (kernel-store-u8-64k (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 65536)
            65536 (+ (* n 32) i) (at (+ 64 i)))
        (log-output n (+ i 1)))))
(defn invoke [n]
  (kernel-store-u32 (kernel-subregion (kernel-value-domain-request-page 73) 262144 (+ 20000 (* n 4)) 4)
    4 0
    (x/kotoba_aiueos_x25519
      (kernel-subregion (kernel-browser-context) 8192 1024 32) 32
      (kernel-subregion (kernel-browser-context) 8192 1056 32) 32
      (kernel-subregion (kernel-browser-context) 8192 1088 32) 32
      (kernel-subregion (kernel-browser-context) 8192 1152 646) 646)))
(defn returned [n]
  (kernel-load-u32 (kernel-subregion (kernel-value-domain-request-page 73) 262144 (+ 20000 (* n 4)) 4) 4 0))
(defn cases [n]
  (if (>= n 528) 1
    (do (p 72 (+ n 10000)) (seed n 0) (fill 64 96 165) (fill 128 774 90)
        (put 96 91) (put 127 92) (put 774 93)
        (invoke n) (log-output n 0)
        (if (= (same-output n 0) 1) 0 (p 74 (+ (word 74) 1)))
        (if (= (returned n) (expected-return n)) 0 (p 75 (+ (word 75) 1)))
        (if (= (same-input n 0) 1) 0 (p 76 (+ (word 76) 1)))
        (if (and (= (at 96) 91) (= (at 127) 92) (= (at 774) 93)) 0 (p 77 (+ (word 77) 1)))
        (p 78 (+ n 1)) (cases (+ n 1)))))
(defn park [] (do (kernel-pause) (park)))
(defn header? []
  (and (= (kernel-load-u64-4k (kernel-subregion (kernel-native-font) 524288 393216 64) 64 0) 3550869714713784920)
       (= (kernel-load-u32 (kernel-subregion (kernel-native-font) 524288 393216 64) 64 8) 528)))
(defn run [] :i64
  (do (kernel-cli) (p 72 1) (p 74 0) (p 75 0) (p 76 0) (p 77 0) (p 78 0) (p 79 0)
      (if (and (header?) (> (kernel-register-value-domain 73) 0)
               (= (kernel-publish-current-domain 73) 73) (= (kernel-value-enable-user) 1)
               (> (kernel-value-domain-request-page 73) 0))
        (do (p 100 (bit-and (kernel-value-domain-request-page 73) 4294967295))
            (p 101 (quot (kernel-value-domain-request-page 73) 4294967296))
            (p 79 1) (cases 0) (p 79 2) (park))
        (do (p 74 4294967295) (p 79 2) (park)))))
