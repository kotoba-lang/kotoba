(ns native.micro-infer
  ;; aiueos-char-bigram-v1 -- the frozen character bigram of
  ;; os/aiueos/contracts/micro-inference-qualification-v1.edn, reduced from the
  ;; corpus whose SHA-256 is
  ;;   6433aeadc179877f103fdc87672d967d5c68d3f531f8b2bf156e377ad84058cb
  ;; and held here in exactly the form the source of truth
  ;; os/aiueos/contracts/micro-infer-transitions-v1.edn holds it: 27 rows of 27 transition counts,
  ;; vocabulary index 0 = space and 1..26 = a..z.
  ;;
  ;; GENERATED by os/aiueos/tools/gen-micro-infer-table.cljk -- do not edit by
  ;; hand.  `--check` re-derives this file from the C matrix and fails if the
  ;; two have drifted; that check is the only thing that keeps the board's
  ;; answers and the Mac relay's expectations the same model.
  ;;
  ;; WHY NIBBLES.  The native word-typed subset has no arrays and `def` takes
  ;; literals only, so a 729-entry table cannot be written as data.  Every
  ;; count in the matrix is at most 5, so each row packs losslessly into two
  ;; i64 literals of 4-bit fields -- 15 cells in `lo` (bits 0..59, clear of the
  ;; sign bit) and 12 in `hi`.  The board UNPACKS and reduces them at run time;
  ;; the argmax is deliberately NOT precomputed, because a precomputed argmax
  ;; would make this a lookup table and the point of the qualification is that
  ;; the physical K16 performed the reduction.
  ;; The SELF-CHECK lives in native/micro_infer_check.kotoba, not here. The
  ;; native target has a hard 100,000-node lowered-program budget shared by the
  ;; whole kernel, and 27 rows of expected values plus their walk is weight the
  ;; board would carry for a function it never calls.
  (:export [vocab-index vocab-value micro-infer-row micro-infer-token
            micro-infer-score micro-infer-total micro-infer-index]))

;; Vocabulary: 0 = space, 1..26 = a..z.  -1 (returned as 27) is "not in the
;; vocabulary", which the caller must treat as a refusal rather than a token.
(defn vocab-index [value]
  (if (= value 32)
    0
    (if (and (>= value 97) (<= value 122))
      (+ (- value 97) 1)
      27)))

(defn vocab-value [index]
  (if (= index 0) 32 (+ 96 index)))

;; Cells 0..14 of the transition row for `input`.
(defn row-lo [input]
    (if (= input 0) 153123693000654896
     (if (= input 1) 72092915848970241
      (if (= input 2) 0
       (if (= input 3) 1048576
        (if (= input 4) 0
         (if (= input 5) 76561193665298434
          (if (= input 6) 1048576
           (if (= input 7) 1
            (if (= input 8) 0
             (if (= input 9) 216172782113783808
              (if (= input 10) 0
               (if (= input 11) 1
                (if (= input 12) 0
                 (if (= input 13) 1
                  (if (= input 14) 286265361
                   (if (= input 15) 68719476738
                    (if (= input 16) 1048576
                     (if (= input 17) 0
                      (if (= input 18) 17592187093040
                       (if (= input 19) 5
                        (if (= input 20) 137440002048
                         (if (= input 21) 9007199256838144
                          (if (= input 22) 1048576
                           (if (= input 23) 4503599627370496
                            (if (= input 24) 0
                             (if (= input 25) 0
                              0)))))))))))))))))))))))))))

;; Cells 15..26.
(defn row-hi [input]
    (if (= input 0) 65537
     (if (= input 1) 2097152
      (if (= input 2) 0
       (if (= input 3) 0
        (if (= input 4) 0
         (if (= input 5) 1056770
          (if (= input 6) 0
           (if (= input 7) 0
            (if (= input 8) 0
             (if (= input 9) 302120960
              (if (= input 10) 1
               (if (= input 11) 33554432
                (if (= input 12) 0
                 (if (= input 13) 33554434
                  (if (= input 14) 65536
                   (if (= input 15) 135184
                    (if (= input 16) 0
                     (if (= input 17) 0
                      (if (= input 18) 0
                       (if (= input 19) 1099512676352
                        (if (= input 20) 4294967296
                         (if (= input 21) 8192
                          (if (= input 22) 0
                           (if (= input 23) 0
                            (if (= input 24) 0
                             (if (= input 25) 1
                              0)))))))))))))))))))))))))))

;; Scan `cells` 4-bit fields out of `word`, lowest first, starting at
;; vocabulary index `index`.  The accumulator is packed so this stays inside
;; the five-parameter native ABI cap:
;;   acc = best * 65536 + score * 256 + total
;; best <= 26, score <= 5 and total <= 13, so no field can carry into the next.
;; Ties keep the LOWEST vocabulary index (`:tie-break :lowest-vocabulary-index`
;; in the contract), which is what a strict `>` gives when the scan runs
;; upwards from 0.
(defn scan-nibbles [word cells index acc]
  (if (= cells 0)
    acc
    (let [cell (bit-and word 15)
          score (bit-and (quot acc 256) 255)
          keep-best (bit-and acc 16776960)
          next-best (if (> cell score) (+ (* 65536 index) (* 256 cell)) keep-best)]
      (scan-nibbles (quot word 16) (- cells 1) (+ index 1)
                    (+ next-best (+ (bit-and acc 255) cell))))))

;; (best << 16) | (score << 8) | total for the row of vocabulary index `input`.
;; 0 means the row is empty -- the C reference refuses on `!total || !score`
;; and so does every caller here, because a zero row has no next token.
(defn micro-infer-row [input]
  (if (>= input 27)
    0
    (scan-nibbles (row-hi input) 12 15
                  (scan-nibbles (row-lo input) 15 0 0))))

(defn micro-infer-index [row] (bit-and (quot row 65536) 255))
(defn micro-infer-score [row] (bit-and (quot row 256) 255))
(defn micro-infer-total [row] (bit-and row 255))
(defn micro-infer-token [row] (vocab-value (micro-infer-index row)))
