(ns aiueos.native.update
  ;; AWAI-122 stage 3: pull a signed OS image over the RTL8168 debug link and
  ;; verify it. Nothing is written: the image is hashed as it arrives and only
  ;; the verdict is kept. Stage 4 writes the ESP.
  ;;
  ;; A signed image (scripts/aiueos-image.py) is a 128-byte header, then the
  ;; image. The header is a 64-byte manifest
  ;;    0 "AIUEIMG1", 8 version (u64 LE, >= 1), 16 size (u64 LE, 1..32 MiB),
  ;;   24 reserved (zero), 32 SHA-256 of the image
  ;; and an Ed25519 signature over it under the image-signing key pinned below
  ;; (its seed is held on the operator's Mac, never in this repository). The
  ;; signature is checked before any image byte is taken; the image is then
  ;; accepted only if its length and SHA-256 equal the manifest's.
  ;;
  ;; Transport (`pull`, started by remote command 5): one request at a time,
  ;; broadcast to UDP 7796, "AIUEGET1" boot nonce, stream offset (u64 LE),
  ;; length (u32 LE, at most 1024); the answer is a datagram to UDP 7795,
  ;; "AIUEDAT1" nonce offset length, then the bytes. A request is repeated up
  ;; to 8 times (about 2^30 TSC cycles each) before the pull fails. The server
  ;; is untrusted; the nonce only keeps stale answers apart.
  ;;
  ;; `self-test` runs the same verifier on a 5000-byte fixture image signed with
  ;; the RFC 8032 section 7.1 test 1 seed (published, so the fixture proves the
  ;; code path, not a key): it must accept the fixture, refuse it with one
  ;; manifest byte changed (signature) and refuse it with one image byte changed
  ;; (digest), all through the same chunk path the network uses.
  ;;
  ;; AIUEIMG1 is classical Ed25519 only. Rollback protection (JUN-813 stage 5c, ADR-0286
  ;; amendment 4): `admit` reads a hash-checked per-channel version floor from the update
  ;; journal (OSMETA.BIN, see `floor-load` below) and refuses a header whose version is not
  ;; strictly above it (result 9), or when the journal cannot be read (result 10, fail closed,
  ;; never floor 0). The floor is hash-checked, not signed (interim, see the ADR); a board
  ;; gets its journal from scripts/aiueos-provision-esp.py, nothing here creates it.
  ;;
  ;; State: context words 180 result (0 none, 1 signature refused, 2 magic,
  ;; 3 size, 4 version, 5 reserved not zero, 6 chunk out of order, 7 digest
  ;; differs, 14 manifest accepted and image in progress, 15 verified, 20 no
  ;; NIC, 21 no answer, 22 transmit failed), 181/182 version, 183 size, 184
  ;; image bytes taken, 186 repeated requests, 187 stream offset of the last
  ;; failed request, 188 self-test verdict (7 = all three cases as expected),
  ;; 189 self-test results (accept | tampered manifest << 8 | tampered image
  ;; << 16), 190..197 manifest digest words, 200..207 computed digest words.
  ;; The page is owned window slot14 (one page): the header, then the image
  ;; bytes of the current4096-byte block. Input-profile callers must first
  ;; observe xHCI HCHalted before borrowing its scratchpad14; remote-cmd
  ;; preserves the sealed-key blob and restores/reinitializes USB afterwards.
  ;;
  ;; AWAI-122 stage 4, `install` (remote command 6): the same pull, but once the
  ;; manifest is accepted the NVMe driver and ESP walk are run again (the
  ;; verifier's buffer covers their words), the staging file is readied
  ;; (native/esp prepare) and every 4096-byte block is also written into it.
  ;; Only when the stream's SHA-256 matches, the staging file is read back
  ;; from disk and hashed; only when that matches too, esp swap makes it
  ;; BOOTX64.EFI, and the ESP walk must then hash BOOTX64.EFI to the manifest's
  ;; digest. Words 208 install result (15 installed; 1..14 and 20..22 as word
  ;; 180; 40..45 as esp prepare; 46 read-back differs; 47 BOOTX64.EFI after the
  ;; swap differs; 48 a write or flush failed; 49 NVMe or ESP walk not ready),
  ;; 209 write mode, 211 the QEMU hook's request.
  ;; `qemu-hook` is the gate's way in: only under a hypervisor (CPUID.1:ECX
  ;; bit 31) whose fw_cfg (ports 0x510/0x511) carries the file
  ;; opt/aiueos/install, it installs the self-test fixture ("1") or the
  ;; fixture with one image byte changed ("2"). It never installs network data,
  ;; and a physical board has no fw_cfg. The verifier uses context bytes
  ;; 2048..3071 and 4096..8191, SHA-256 bytes 3072..3647 (as native/esp).
  ;;
  ;; JUN-813 stage 5b (ADR-0286 amendment 2): AIUEIMG2. The header is 16384 bytes: the 64-byte manifest (as AIUEIMG1, magic
  ;; "AIUEIMG2"), the entry count u32 at 64 (1..4, bytes 68..127 zero), then up to four 3392-byte entries from byte 128 (key id
  ;; u32, 4 zero bytes, Ed25519 signature 64, ML-DSA-65 signature 3309, 11 zero bytes); the image follows the header. It does not fit
  ;; the 4096-byte page, so it arrives in the same chunks as the image (the first 128 bytes, then pieces that end at the next
  ;; 1 KiB line, so the first is 896 bytes and the rest 1024, none crossing a line) and each byte is consumed as it lands: the manifest into the verifier buffers, the signatures into
  ;; their buffers, and when an entry's last byte lands both of its signatures are verified (aiueos.ed25519 and
  ;; aiueos.mldsa-verify) and counted with aiueos.imgsig (N = 3 pinned slots, M = 2 distinct valid signers). Only after the header
  ;; is admitted are the manifest's size and version checked and the image hashed against its SHA-256.
  ;; `admit` dispatches on header byte 7 ("2" AIUEIMG2, otherwise the AIUEIMG1 path above is unchanged and still takes
  ;; its own checks): AIUEIMG1 stays admissible here until AIUEIMG2 has a production signer set (ADR-0286 retires it only when
  ;; AIUEIMG2 ships), so the self-test above still runs.
  ;; Pinned signers: test=1 uses the TEST keys of aiueos.imgsig-testkeys (self-test and QEMU hook only: their seeds are public);
  ;; test=0, the network paths, uses the PRODUCTION keys of aiueos.imgsig-prodkeys (JUN-813, ADR-0286 amendment 7: a VERIFICATION-ONLY set,
  ;; all three slots kept on one Mac; the keys are compiled in, so rotating them is a new image signed by 2 of the current set).
  ;; Result 8 (no production signer set pinned) is retired: nothing returns it any more.
  ;; Memory: the ML-DSA arena is owned window 4 (20480 bytes: signature at 8192, key at 12288), which the NVMe driver and the ESP
  ;; walk also use (queues, data page). Verifying an entry therefore overwrites them; `restore-storage` re-runs nvme/probe and
  ;; esp/run after any header that ran ML-DSA, before the SHA state is initialised (esp hashes with the same scratch). The Ed25519
  ;; verifier keeps its buffers (context bytes 2048..3071 and 4096..8191; key 2048, signature 2080, manifest 2144), the SHA
  ;; state stays 3072..3647. AIUEIMG2 state words: 212 header length (128 or 16384), 216 count, 218 mask of counted slots, 220 key
  ;; id of the entry in progress, 221 its reserved bytes, 222 its padding, 223 flags (1 size out of range, 2 version below 1),
  ;; 224 size, 225/226 version, 227 header end, 228 ML-DSA ran, 229 stream bytes consumed from the QEMU file, 233 storage walk after
  ;; the cases, 234 marker "UP02", 235 case count, 236.. per case k < 40, two cases per word (even k low 16 bits, odd k high 16 bits): result | counted mask << 8; 230 QEMU truncation flag. New result codes:
  ;; 8 retired (amendment 7); 1 is also "fewer than two distinct valid signers" for AIUEIMG2.
  ;; QEMU hook: fw_cfg file opt/aiueos/update2 (hypervisor only): [count][per case: mode (0 test keys, 1 production, 2 test keys with the stream broken before byte 7200), 16384 header
  ;; bytes, 5000 image bytes]; with no install request every case is run to its verdict, with install request "3" case 0 is installed.
  ;; JUN-813 stage 6 (ADR-0286 amendment 5): AIUECAT1, the signed catalog. The header is the AIUEIMG2 signature block unchanged (the same
  ;; `h2-start` / `h2-loop` / `verify-entry` run on it); the manifest's magic is "AIUECAT1", bytes 16..27 are the body length (128 * count) and
  ;; the entry count (1..64), 28..31 are reserved, and the ML-DSA context is "AIUECAT1". The kind is chosen by the caller (bit 1 of
  ;; `admit`'s test argument: 3 = catalog with the TEST keys, 2 = catalog with the production set), never from the magic.
  ;; The body (128 * count bytes) follows the header at byte 16384 and flows through `chunk-done` like an image (SHA-256 against the manifest);
  ;; each 128-byte entry is checked in the page as its chunk lands (`cat-scan`). Result 16: the hash matches but an entry is refused (flags in
  ;; word 270). A catalog takes no version floor and is not read by anything: QEMU hook opt/aiueos/cat1 only (hypervisor only, `self-test3`).
  ;; Words: 231 kind (1 while a catalog is admitted), 270 entry flags, 271/272 seen dock ids, 300 + k the QEMU case results.
  ;; JUN-813 (ADR-0286 amendment 6): AIUEFRS1, the signed freshness record, and the clock it is judged against. The kind is chosen by the caller (bit 2 of
  ;; `admit`'s test argument: 5 = TEST keys, 4 = production set); the header is the AIUEIMG2 signature block, there is no body, the
  ;; manifest is 0 "AIUEFRS1", 8 latest version, 16 issued-at, 24 valid-until (UTC seconds, lifetime 1 s..30 days), 32 channel (1), 36..63 zero, and the ML-DSA
  ;; context is "AIUEFRS1". After the signatures count (2 of 3) and the structure is sound (result 15), `fresh-verdict` reads the CMOS RTC (`rtc-now`: ports
  ;; 0x70/0x71, update flag awaited, two equal snapshots, BCD/binary and 12/24 hour decoded, refused below the build floor 2026-11-06) and leaves word 273:
  ;; 1 fresh, 2 expired, 3 clock more than a day behind issued-at, 4 no usable clock. Words 274/275 issued-at, 276/277 valid-until, 278 channel, 279/280 the
  ;; clock reading, 365 its status (0 ok, 1 unstable, 2 invalid field, 3 below the floor, 5 RTC lost power), 366..381 two register snapshots. QEMU hooks
  ;; opt/aiueos/fresh (word 400 + k: result | mask << 8 | verdict << 16) and opt/aiueos/clock (probe words 364..399, decoder rows 460 / 464 + k). Not wired to
  ;; anything: no `check`, nothing persisted, the version floor is untouched.
  (:require [aiueos.native.storage-state :as storage]
            [aiueos.native.rtl8168-debug :as nic]
            [aiueos.native.nvme :as nvme]
            [aiueos.native.esp :as esp]
            [aiueos.native.update-journal :as journal]
            [aiueos.ed25519 :refer [aiueos-ed25519-verify]]
            [aiueos.mldsa-verify :refer [mv-mu mv-verify]]
            [aiueos.imgsig :refer [ims-step ims-final ims-bit]]
            [aiueos.imgsig-testkeys :as tk]
            [aiueos.imgsig-prodkeys :as pk]
            [aiueos.lib.sha256-stream :as sha])
  (:export [self-test pull report install install-report qemu-hook confirm-installed]))

(defn word [region i]
  (storage/word region i))
(defn put-word [region i value]
  (storage/put-word region i value))
(defn word64 [ctx i] (+ (word ctx i) (* (word ctx (+ i 1)) 4294967296)))
(defn put-word64 [ctx i value]
  (do (put-word ctx i (bit-and value 4294967295))
      (put-word ctx (+ i 1) (u64-shift-right value 32))))
(defn put-byte [ctx at value] (kernel-store-u8 (kernel-subregion ctx 8192 at 1) 1 0 value))
(defn pg [at] (kernel-load-u8-4k (kernel-owned-window 14 4096) 4096 at))
(defn put-pg [at value] (kernel-store-u8-4k (kernel-owned-window 14 4096) 4096 at value))
(defn pg-le [at n acc]
  (if (= n 0) acc (pg-le at (- n 1) (+ (i64-shift-left acc 8) (pg (+ at (- n 1)))))))
(defn least [a b] (if (< a b) a b))
(defn fail [ctx code] (do (put-word ctx 180 code) code))

;; The image-signing public key (AWAI-122).
(defn key-byte [i]
  (bit-and (u64-shift-right (case (quot i 4) 0 3123322310 1 17327946 2 3041544845 3 2594336413 4 2952473750 5 2496750877 6 1332493053 7 3147839055 0) (* (mod i 4) 8)) 255))
;; RFC 8032 section 7.1 test 1 public key: the self-test only.
(defn test-key-byte [i]
  (bit-and (u64-shift-right (case (quot i 4) 0 26761943 1 3070931330 2 3556658133 3 973563081 4 4084392206 5 623093466 6 1746535087 7 441518071 0) (* (mod i 4) 8)) 255))
(defn magic-byte [i] (case i 0 65 1 73 2 85 3 69 4 73 5 77 6 71 7 49 0))
(defn magic-ok [i] (if (>= i 8) 1 (if (= (pg i) (magic-byte i)) (magic-ok (+ i 1)) 0)))

;; Verifier buffer (context 2048): key 0..31, signature 32..95, manifest 96..159.
(defn stage [ctx test i]
  (if (>= i 160) 1
    (do (put-byte ctx (+ 2048 i)
                  (if (< i 32) (if (= test 1) (test-key-byte i) (key-byte i))
                    (if (< i 96) (pg (+ 32 i)) (pg (- i 96)))))
        (stage ctx test (+ i 1)))))
(defn be-word [at] (+ (* (pg at) 16777216) (+ (* (pg (+ at 1)) 65536) (+ (* (pg (+ at 2)) 256) (pg (+ at 3))))))
(defn save-digest [ctx i]
  (if (>= i 8) 1 (do (put-word ctx (+ 190 i) (be-word (+ 32 (* i 4)))) (save-digest ctx (+ i 1)))))

;; The header is at page bytes 0..127. Returns 14 when the manifest is accepted.
(defn begin [ctx test]
  (let [staged (stage ctx test 0)
        v (aiueos-ed25519-verify (kernel-subregion ctx 8192 2048 1024) 64
                                    (kernel-subregion ctx 8192 4096 4096))
        size (pg-le 16 8 0)
        version (pg-le 8 8 0)]
    (if (not (= (+ v (* 0 staged)) 1)) (fail ctx 1)
      (if (= (magic-ok 0) 0) (fail ctx 2)
        (if (not (= (pg-le 24 8 0) 0)) (fail ctx 5)
          (if (or (<= size 0) (> size 33554432)) (fail ctx 3)
            (if (< version 1) (fail ctx 4)
              (do (put-word64 ctx 181 version)
                  (put-word ctx 183 size)
                  (put-word ctx 184 0)
                  (save-digest ctx 0)
                  (sha/sha-init (kernel-subregion ctx 8192 3072 512))
                  (fail ctx 14)))))))))

;; k whole 64-byte blocks from the start of the page.
(defn absorb [ctx k]
  (sha/sha-blocks (kernel-subregion ctx 8192 3072 512) (kernel-owned-window 14 4096) 4096 0 k))
(defn zero-pad [ctx i]
  (if (>= i 64) 1 (do (put-byte ctx (+ 3584 i) 0) (zero-pad ctx (+ i 1)))))
(defn copy-tail [ctx at i r]
  (if (>= i r) 1 (do (put-byte ctx (+ 3584 i) (pg (+ at i))) (copy-tail ctx at (+ i 1) r))))
(defn put-length [ctx bits i]
  (if (>= i 8) 1
    (do (put-byte ctx (+ 3584 (- 63 i)) (bit-and (u64-shift-right bits (* i 8)) 255))
        (put-length ctx bits (+ i 1)))))
(defn pad-block [ctx]
  (sha/sha-block (kernel-subregion ctx 8192 3072 512) (kernel-subregion ctx 8192 3584 64)))
(defn same-digest [ctx i]
  (if (>= i 8) 1
    (let [h (sha/load32 (kernel-subregion ctx 8192 3072 512) (+ 64 i))]
      (do (put-word ctx (+ 200 i) h)
          (if (= h (word ctx (+ 190 i))) (same-digest ctx (+ i 1))
            (do (same-digest ctx (+ i 1)) 0))))))
;; The last page holds t = size mod 4096 bytes (none when the size is a whole
;; number of pages: chunk-done has absorbed it already).
(defn finish [ctx]
  (let [size (word ctx 183)
        t (bit-and size 4095)
        whole (quot t 64)
        r (bit-and t 63)]
    (do (if (> whole 0) (absorb ctx whole) 0)
        (zero-pad ctx 0)
        (copy-tail ctx (* whole 64) 0 r)
        (put-byte ctx (+ 3584 r) 128)
        (if (< r 56)
          (do (put-length ctx (* size 8) 0) (pad-block ctx))
          (do (pad-block ctx) (zero-pad ctx 0) (put-length ctx (* size 8) 0) (pad-block ctx)))
        (if (= (same-digest ctx 0) 1)
          (if (and (= (word ctx 231) 1) (not (= (word ctx 270) 0))) (fail ctx 16) (fail ctx 15))
          (fail ctx 7)))))

;; ---- JUN-813 stage 6 (ADR-0286 amendment 5): the entries of an AIUECAT1 body, checked as each chunk lands ----
;; Word 231 = 1 while a catalog is being admitted. A body entry is 128 bytes at page byte p: dock id u32 at 0 (19..82, no repeat), title 4..35,
;; manifest CID 36..71, bundle CID 72..107, size u32 at 108 (1..2^25), reserved 112..127 (zero). Word 270 ORs the refusal flags of all entries
;; (1 dock id, 2 duplicate, 4 reserved, 8 title, 16 CID, 32 size); words 271/272 are the seen dock ids (bit id - 19).
(defn cat-nz [from to acc]
  (if (>= from to) acc (cat-nz (+ from 1) to (bit-or acc (if (= (pg from) 0) 0 1)))))
(defn cat-in [x lo hi] (if (and (>= x lo) (<= x hi)) 1 0))
;; 1 when the 32-byte title at p + 4 is not 1..31 printable ASCII, a NUL, then only zeros
(defn cat-title [p i nul bad]
  (if (>= i 32) (bit-or bad (if (= nul 0) 1 0))
    (let [b (pg (+ (+ p 4) i))]
      (if (= nul 0)
        (if (= b 0) (cat-title p (+ i 1) 1 (if (= i 0) 1 bad))
          (cat-title p (+ i 1) 0 (if (or (< b 32) (> b 126)) 1 bad)))
        (cat-title p (+ i 1) 1 (if (= b 0) bad 1))))))
(defn cat-codec [c] (if (= c 85) 1 (if (= c 112) 1 (if (= c 113) 1 0))))
;; 1 when the 36 bytes at q are not the CIDv1 envelope of aiueos.cid-v1-admit (01, codec 55 / 70 / 71, 12, 20)
(defn cat-cid-bad [q]
  (if (and (= (pg q) 1) (and (= (cat-codec (pg (+ q 1))) 1) (and (= (pg (+ q 2)) 18) (= (pg (+ q 3)) 32)))) 0 1))
;; 1 when dock id bit b was already seen, else 0 and it is marked
(defn cat-seen [ctx b]
  (let [w (if (< b 32) 271 272)
        bit (i64-shift-left 1 (bit-and b 31))
        cur (word ctx w)]
    (if (= (bit-and cur bit) 0) (do (put-word ctx w (bit-or cur bit)) 0) 1)))
(defn cat-entry [ctx p]
  (let [d (pg-le p 4 0)
        inr (cat-in d 19 82)
        dup (if (= inr 1) (cat-seen ctx (- d 19)) 0)
        sz (pg-le (+ p 108) 4 0)
        f (+ (- 1 inr)
             (+ (* 2 dup)
                (+ (* 4 (cat-nz (+ p 112) (+ p 128) 0))
                   (+ (* 8 (cat-title p 0 0 0))
                      (+ (* 16 (bit-or (cat-cid-bad (+ p 36)) (cat-cid-bad (+ p 72))))
                         (* 32 (- 1 (cat-in sz 1 33554432))))))))]
    (put-word ctx 270 (bit-or (word ctx 270) f))))
(defn cat-scan [ctx base len j]
  (if (>= (* j 128) len) 1
    (do (cat-entry ctx (+ base (* j 128))) (cat-scan ctx base len (+ j 1)))))

;; In write mode (word 209 = 1) the first n page bytes go to the staging file:
;; 0 done or not in write mode, -1 failed.
(defn stage-out [ctx n]
  (if (or (= n 0) (not (= (word ctx 209) 1))) 0
    (esp/stage-write ctx (kernel-owned-window 14 4096) n)))
;; `len` image bytes have just been put at page byte (taken mod 4096). Chunks
;; are 1024 bytes in order; only the last may be shorter.
(defn chunk-done [ctx len]
  (let [got (word ctx 184)
        size (word ctx 183)
        now (+ got len)]
    (if (not (= (word ctx 180) 14)) (word ctx 180)
      (if (or (<= len 0) (> len 1024) (> now size) (not (= (bit-and got 1023) 0))
              (and (< len 1024) (not (= now size))))
        (fail ctx 6)
        (do (put-word ctx 184 now)
            (if (= (word ctx 231) 1) (cat-scan ctx (bit-and got 4095) len 0) 0)
            (if (< (if (= (bit-and now 4095) 0) (stage-out ctx 4096) 0) 0) (fail ctx 48)
              (do (if (= (bit-and now 4095) 0) (absorb ctx 64) 0)
                  (if (= now size)
                    (if (< (stage-out ctx (bit-and now 4095)) 0) (fail ctx 48) (finish ctx))
                    14))))))))

;; ---- self-test ----
(defn fixture-0 [i]
  (bit-and (u64-shift-right (case (quot i 4) 0 1163217217 1 826756425 2 1 3 0 4 5000 5 0 6 0 7 0 0) (* (mod i 4) 8)) 255))
(defn fixture-1 [i]
  (bit-and (u64-shift-right (case (quot i 4) 0 2665644809 1 1383109128 2 901415744 3 3402659476 4 4162247956 5 3392207019 6 3259255156 7 3559569082 0) (* (mod i 4) 8)) 255))
(defn fixture-2 [i]
  (bit-and (u64-shift-right (case (quot i 4) 0 1266443388 1 464956136 2 4075994401 3 2146069433 4 3436819118 5 1989076000 6 624936739 7 2156270948 0) (* (mod i 4) 8)) 255))
(defn fixture-3 [i]
  (bit-and (u64-shift-right (case (quot i 4) 0 2448288777 1 1864528035 2 2157773324 3 952655157 4 2903862441 5 2006448299 6 1689210914 7 34357346 0) (* (mod i 4) 8)) 255))
(defn fixture-header [i]
  (if (< i 32) (fixture-0 i) (if (< i 64) (fixture-1 (- i 32)) (if (< i 96) (fixture-2 (- i 64)) (fixture-3 (- i 96))))))
;; The fixture image: byte i = (31 i + 7 (i >> 8) + 1) mod 256, 5000 bytes.
(defn fixture-byte [i] (bit-and (+ (* i 31) (+ (* (u64-shift-right i 8) 7) 1)) 255))
(defn put-header [i flip]
  (if (>= i 128) 1
    (do (put-pg i (bit-xor (fixture-header i) (if (= i flip) 1 0))) (put-header (+ i 1) flip))))
(defn fill [base at i n flip]
  (if (>= i n) 1
    (do (put-pg (+ base i) (bit-xor (fixture-byte (+ at i)) (if (= (+ at i) flip) 1 0)))
        (fill base at (+ i 1) n flip))))
(defn feed [ctx at flip]
  (if (or (>= at 5000) (not (= (word ctx 180) 14))) (word ctx 180)
    (let [n (least 1024 (- 5000 at))]
      (do (fill (bit-and at 4095) at 0 n flip)
          (chunk-done ctx n)
          (feed ctx (+ at n) flip)))))
(defn self-run [ctx header-flip image-flip]
  (do (put-word ctx 231 0)
      (put-header 0 header-flip)
      (if (= (begin ctx 1) 14) (feed ctx 0 image-flip) (word ctx 180))))
(defn self-test [ctx]
  (let [off (put-word ctx 209 0)
        a (+ (self-run ctx -1 -1) (* 0 off))
        b (self-run ctx 8 -1)
        c (self-run ctx -1 4097)]
    (do (put-word ctx 189 (+ a (+ (* b 256) (* c 65536))))
        (put-word ctx 188 (+ (if (= a 15) 1 0) (+ (if (= b 1) 2 0) (if (= c 7) 4 0))))
        (put-word ctx 180 0)
        (word ctx 188))))

;; ---- network pull ----
(defn get-byte [i] (case i 0 65 1 73 2 85 3 69 4 71 5 69 6 84 7 49 0))
(defn dat-byte [i] (case i 0 65 1 73 2 85 3 69 4 68 5 65 6 84 7 49 0))
(defn put-le [at value n i]
  (if (>= i n) 1
    (do (nic/put-payload (+ at i) (bit-and (u64-shift-right value (* i 8)) 255))
        (put-le at value n (+ i 1)))))
(defn put-get-magic [i]
  (if (>= i 8) 1 (do (nic/put-payload i (get-byte i)) (put-get-magic (+ i 1)))))
(defn request [nonce offset len]
  (do (put-get-magic 0)
      (put-le 8 nonce 8 0) (put-le 16 offset 8 0) (put-le 24 len 4 0)
      (nic/send 28 7796)))
(defn rx-le [at n acc]
  (if (= n 0) acc (rx-le at (- n 1) (+ (i64-shift-left acc 8) (nic/rx-byte (+ at (- n 1)))))))
(defn dat-magic [i] (if (>= i 8) 1 (if (= (nic/rx-byte (+ 42 i)) (dat-byte i)) (dat-magic (+ i 1)) 0)))
;; A datagram to UDP 7795 answering (nonce, offset) with exactly len bytes.
(defn answer? [nonce offset len]
  (and (>= (nic/rx-length) (+ 70 len))
       (= (nic/rx-byte 12) 8) (= (nic/rx-byte 13) 0) (= (nic/rx-byte 23) 17)
       (= (nic/rx-byte 36) 30) (= (nic/rx-byte 37) 115)
       (= (dat-magic 0) 1) (= (rx-le 50 8 0) nonce) (= (rx-le 58 8 0) offset) (= (rx-le 66 4 0) len)))
(defn copy-in [dst i n]
  (if (>= i n) 1 (do (put-pg (+ dst i) (nic/rx-byte (+ 70 i))) (copy-in dst (+ i 1) n))))
;; 1 when the answer was copied to page byte dst, 0 when none came in time.
(defn wait [nonce offset len dst until]
  (if (> (kernel-rdtsc) until) 0
    (if (= (nic/rx-length) 0) (wait nonce offset len dst until)
      (if (answer? nonce offset len)
        (let [c (copy-in dst 0 len)] (+ (nic/rx-release) (* 0 c)))
        (do (nic/rx-release) (wait nonce offset len dst until))))))
(defn fetch [ctx offset len dst tries]
  (if (>= tries 8) (do (put-word ctx 187 offset) 0)
    (do (if (> tries 0) (put-word ctx 186 (+ (word ctx 186) 1)) 0)
        (if (= (request (word64 ctx 172) offset len) 1)
          (if (= (wait (word64 ctx 172) offset len dst (+ (kernel-rdtsc) 1073741824)) 1) 1
            (fetch ctx offset len dst (+ tries 1)))
          (fetch ctx offset len dst (+ tries 1))))))
;; ---- fw_cfg byte stream (QEMU only): the gate hook and the AIUEIMG2 cases ----
(defn fw-byte [] (kernel-in-u8 1297))
(defn fw-skip [n] (if (<= n 0) 1 (let [b (fw-byte)] (fw-skip (- n (+ 1 (* 0 b)))))))
(defn fw-be [n acc] (if (= n 0) acc (fw-be (- n 1) (+ (* acc 256) (fw-byte)))))
;; which 0 "opt/aiueos/install", 1 "opt/aiueos/update2" (18 bytes and a NUL), 2 "opt/aiueos/cat1" (JUN-813 stage 6), 3 "opt/aiueos/fresh", 4 "opt/aiueos/clock" (amendment 6)
(defn fw-name-byte [which i]
  (if (< i 11) (case i 0 111 1 112 2 116 3 47 4 97 5 105 6 117 7 101 8 111 9 115 10 47 0)
    (if (= which 0) (case i 11 105 12 110 13 115 14 116 15 97 16 108 17 108 0)
      (if (= which 1) (case i 11 117 12 112 13 100 14 97 15 116 16 101 17 50 0)
        (if (= which 2) (case i 11 99 12 97 13 116 14 49 0)
          (if (= which 3) (case i 11 102 12 114 13 101 14 115 15 104 0)
                          (case i 11 99 12 108 13 111 14 99 15 107 0)))))))
(defn fw-name [which i ok]
  (if (>= i 56) ok
    (let [b (fw-byte)]
      (fw-name which (+ i 1) (if (and (= ok 1) (or (>= i 19) (= b (fw-name-byte which i)))) 1 0)))))
(defn fw-find [left which]
  (if (<= left 0) 0
    (let [size (fw-be 4 0)
          sel (fw-be 2 0)
          skip (fw-skip 2)
          hit (fw-name which 0 1)]
      (if (= (+ hit (* 0 (+ size skip))) 1) sel (fw-find (- left 1) which)))))
(defn fw-signature [i]
  (if (>= i 4) 1 (if (= (fw-byte) (case i 0 81 1 69 2 77 85)) (fw-signature (+ i 1)) 0)))
;; 1 when the hypervisor's fw_cfg file `which` is selected (its first byte is next), else 0.
(defn fw-open [which]
  (if (= (bit-and (kernel-cpuid-ecx 1 0) 2147483648) 0) 0
    (do (kernel-out-u16 1296 0)
        (if (= (fw-signature 0) 0) 0
          (do (kernel-out-u16 1296 25)
              (let [sel (fw-find (least (fw-be 4 0) 256) which)]
                (if (= sel 0) 0 (do (kernel-out-u16 1296 sel) 1))))))))
(defn fw-request [] (if (= (fw-open 0) 1) (fw-byte) 0))
(defn fw-fill [dst n i]
  (if (>= i n) 1 (do (put-pg (+ dst i) (fw-byte)) (fw-fill dst n (+ i 1)))))

;; ---- JUN-813 stage 5b: AIUEIMG2, a 16 KiB multi-signer header consumed as it streams ----
(defn sb! [i v] (kernel-store-u8-4k (kernel-subregion (kernel-owned-window 4 20480) 20480 8192 4096) 4096 i v))
(defn pw! [w v] (kernel-store-u32-4k (kernel-subregion (kernel-owned-window 4 20480) 20480 12288 4096) 4096 (* 4 w) v))
(defn nz [b] (if (= b 0) 0 1))
;; JUN-813 stage 6: cat 1 selects the catalog object ("AIUECAT1"), 0 the image ("AIUEIMG2"); the kind is `(cat? test)`, bit 1 of the caller's test
;; argument (bit 0: pinned TEST keys), never read from the magic.
(defn cat? [t] (bit-and (u64-shift-right t 1) 1))
;; JUN-813 (ADR-0286 amendment 6): bit 2 of the caller's test argument selects the freshness record ("AIUEFRS1"); 4 = production set, 5 = TEST keys.
(defn fresh? [t] (bit-and (u64-shift-right t 2) 1))
;; the object kind: 0 image ("AIUEIMG2"), 1 catalog ("AIUECAT1"), 2 freshness record ("AIUEFRS1")
(defn kind-of [t] (if (= (fresh? t) 1) 2 (cat? t)))
(defn pick [c a b] (if (= c 1) a b))
;; k3: the value for a catalog (kind 1), a freshness record (kind 2) or an image (kind 0)
(defn k3 [kind c f i] (if (= kind 1) c (if (= kind 2) f i)))
(defn magic2-byte [kind i] (case i 0 65 1 73 2 85 3 69 4 (k3 kind 67 70 73) 5 (k3 kind 65 82 77) 6 (k3 kind 84 83 71) 7 (k3 kind 49 49 50) 0))
(defn magic2-bad [kind i acc]
  (if (>= i 8) acc (magic2-bad kind (+ i 1) (bit-or acc (nz (bit-xor (pg i) (magic2-byte kind i)))))))
(defn zeros-nz [from to acc]
  (if (>= from to) acc (zeros-nz (+ from 1) to (bit-or acc (nz (pg from))))))
;; M' = 0 || 8 || "AIUEIMG2" || manifest: the 10-byte prefix at S 3392, the manifest after it
;; the ML-DSA context: "AIUEIMG2" for an image, "AIUECAT1" for a catalog, "AIUEFRS1" for a freshness record
(defn mp-prefix-byte [kind i] (case i 1 8 2 65 3 73 4 85 5 69 6 (k3 kind 67 70 73) 7 (k3 kind 65 82 77) 8 (k3 kind 84 83 71) 9 (k3 kind 49 49 50) 0))
(defn mp-prefix [kind i] (if (>= i 10) 1 (do (sb! (+ 3392 i) (mp-prefix-byte kind i)) (mp-prefix kind (+ i 1)))))
(defn copy-manifest [ctx i]
  (if (>= i 64) 1 (do (put-byte ctx (+ 2144 i) (pg i)) (sb! (+ 3402 i) (pg i)) (copy-manifest ctx (+ i 1)))))

;; Overwritten by an entry's verification: the Ed25519 verifier's buffer covers the NVMe/ESP words 600..699 and the ML-DSA arena
;; is the NVMe queues and the ESP data page. Run the driver again (word 228 says a verifier ran).
(defn restore-storage [ctx]
  (if (= (word ctx 228) 0) 0
    (do (nvme/probe ctx) (esp/run ctx) (put-word ctx 228 0))))

;; ---- JUN-813 (ADR-0286 amendment 6): the clock of the freshness record is the CMOS real-time clock, index port 0x70, data port 0x71 ----
;; Nothing else in the native kernel reads a wall clock (the TSC is calibrated against the PIT and only counts since boot). The index byte
;; is written with bit 7 clear, so NMI stays enabled. Words: 365 status of the last `rtc-now` (0 ok, 1 update-in-progress flag stuck or
;; no two equal snapshots, 2 a field out of range or not BCD, 3 earlier than the build floor below, 5 register D bit 7 clear: the RTC lost power),
;; 366..373 and 374..381 two snapshots (seconds, minutes, hours, day, month, year, century register 0x32, register B).
(defn cmos [reg]
  (let [o (kernel-out-u8 112 reg)] (+ (kernel-in-u8 113) (* 0 o))))
(defn rtc-idle [fuel]
  (if (= (bit-and (cmos 10) 128) 0) 1
    (if (= fuel 0) 0 (do (kernel-pause) (rtc-idle (- fuel 1))))))
(defn rtc-snap [ctx at]
  (do (put-word ctx at (cmos 0)) (put-word ctx (+ at 1) (cmos 2)) (put-word ctx (+ at 2) (cmos 4))
      (put-word ctx (+ at 3) (cmos 7)) (put-word ctx (+ at 4) (cmos 8)) (put-word ctx (+ at 5) (cmos 9))
      (put-word ctx (+ at 6) (cmos 50)) (put-word ctx (+ at 7) (cmos 11)) 1))
(defn rtc-same [ctx a b i]
  (if (>= i 8) 1 (if (= (word ctx (+ a i)) (word ctx (+ b i))) (rtc-same ctx a b (+ i 1)) 0)))
;; 1 when the update-in-progress flag was clear, then two snapshots agree and the flag is still clear
(defn rtc-stable [ctx tries]
  (if (= tries 0) 0
    (if (= (rtc-idle 2000000) 0) 0
      (do (rtc-snap ctx 366) (rtc-snap ctx 374)
          (if (and (= (rtc-same ctx 366 374 0) 1) (= (bit-and (cmos 10) 128) 0)) 1
            (rtc-stable ctx (- tries 1)))))))
(defn bcd-ok [v bin] (if (= bin 1) 1 (if (and (<= (bit-and v 15) 9) (<= (u64-shift-right v 4) 9)) 1 0)))
(defn bcd [v bin] (if (= bin 1) v (+ (* (u64-shift-right v 4) 10) (bit-and v 15))))
(defn leap [y] (if (= (mod y 4) 0) (if (= (mod y 100) 0) (if (= (mod y 400) 0) 1 0) 1) 0))
(defn dim [m y] (case m 1 31 2 (+ 28 (leap y)) 3 31 4 30 5 31 6 30 7 31 8 31 9 30 10 31 11 30 12 31 0))
;; days since 1970-01-01 of the proleptic Gregorian date (y >= 1), the era algorithm
(defn civil-days [y m d]
  (let [yy (if (<= m 2) (- y 1) y)
        era (quot yy 400)
        yoe (- yy (* era 400))
        mp (if (> m 2) (- m 3) (+ m 9))
        doy (+ (quot (+ (* 153 mp) 2) 5) (- d 1))
        doe (+ (- (+ (* yoe 365) (quot yoe 4)) (quot yoe 100)) doy)]
    (- (+ (* era 146097) doe) 719468)))
;; UTC seconds since the epoch of the snapshot at word `at`, or 0 when a field is invalid. Register B bit 2 (4): binary, else BCD;
;; bit 1 (2): 24 hour, else 12 hour with bit 7 of the hour byte = PM. A century register outside BCD 19..21 is ignored and 20 assumed.
(defn rtc-unix [ctx at]
  (let [b (word ctx (+ at 7))
        bin (bit-and (u64-shift-right b 2) 1)
        h24 (bit-and (u64-shift-right b 1) 1)
        rh (word ctx (+ at 2))
        hraw (bit-and rh 127)
        pm (bit-and (u64-shift-right rh 7) 1)
        rs (word ctx at) rm (word ctx (+ at 1)) rd (word ctx (+ at 3)) rn (word ctx (+ at 4)) ry (word ctx (+ at 5)) rc (word ctx (+ at 6))
        ok (+ (bcd-ok rs bin) (+ (bcd-ok rm bin) (+ (bcd-ok hraw bin) (+ (bcd-ok rd bin) (+ (bcd-ok rn bin) (bcd-ok ry bin))))))
        s (bcd rs bin) mi (bcd rm bin) hr (bcd hraw bin) d (bcd rd bin) mo (bcd rn bin) yy (bcd ry bin)
        hour (if (= h24 1) hr (+ (mod hr 12) (* pm 12)))
        hok (if (= h24 1) (if (<= hr 23) 1 0) (if (and (>= hr 1) (<= hr 12)) 1 0))
        cc (bcd rc bin)
        century (if (and (= (bcd-ok rc bin) 1) (and (>= cc 19) (<= cc 21))) cc 20)
        y (+ (* century 100) yy)]
    (if (and (= ok 6) (and (= hok 1) (and (<= s 59) (and (<= mi 59) (and (>= mo 1) (and (<= mo 12) (and (>= d 1) (<= d (dim mo y)))))))))
      (+ (* (civil-days y mo d) 86400) (+ (* hour 3600) (+ (* mi 60) s)))
      0)))
;; The build floor: 2026-11-06T00:00:00Z. A clock reading earlier than the date this kernel was written is a dead or reset RTC (the usual
;; reset values are 1970, 1980 or 2000) and is refused, not believed. The constant is bumped by hand; a stale one only loosens this bound.
(defn rtc-now [ctx]
  (if (= (rtc-stable ctx 8) 0) (do (put-word ctx 365 1) 0)
    (if (= (bit-and (cmos 13) 128) 0) (do (put-word ctx 365 5) 0)
      (let [u (rtc-unix ctx 374)]
        (if (= u 0) (do (put-word ctx 365 2) 0)
          (if (< u 1793923200) (do (put-word ctx 365 3) 0)
            (do (put-word ctx 365 0) u)))))))
;; The freshness verdict, word 273: 1 fresh, 2 expired (now after valid-until), 3 the clock is more than a day behind issued-at, 4 no usable clock.
;; The record's own signatures are already counted (the caller). The tolerance of one day (86400 s) on issued-at covers an RTC kept in local time.
;; Words 274/275 issued-at, 276/277 valid-until, 278 channel, 279/280 the clock reading used (0 when none).
(defn fresh-verdict [ctx]
  (let [now (rtc-now ctx)
        issued (word64 ctx 274)
        until (word64 ctx 276)
        st (if (= now 0) 4 (if (> issued (+ now 86400)) 3 (if (> now until) 2 1)))]
    (do (put-word64 ctx 279 now) (put-word ctx 273 st) (fail ctx 15))))

(defn fresh-sok [issued until chan]
  (if (and (>= issued 1) (and (> until issued) (and (<= (- until issued) 2592000) (= chan 1)))) 1 0))
;; Page bytes 0..127 hold the manifest, the count and the zero bytes. 14 when the structure is sound and the
;; entries follow, else a refusal code (2 magic, 5 reserved, 3 count or layout).
(defn h2-start [ctx test]
  (let [kind (kind-of test)
        badm (magic2-bad kind 0 0)
        rsv (if (= kind 1) (zeros-nz 28 32 0) (if (= kind 2) (zeros-nz 36 64 0) (zeros-nz 24 32 0)))
        cnt (pg-le 64 4 0)
        lay (zeros-nz 68 128 0)
        size (pg-le 16 8 0)
        version (pg-le 8 8 0)
        ccount (pg-le 24 4 0)
        until (pg-le 24 8 0)
        chan (pg-le 32 4 0)
        ;; the manifest's length is sound: an image 1..32 MiB, a catalog 128 * its entry count (1..64); a freshness record
        ;; (bytes 16..23 issued-at, 24..31 valid-until, 32..35 channel) has issued-at >= 1, a lifetime of 1 second..30 days and channel 1
        sok (if (= kind 1) (if (and (and (>= ccount 1) (<= ccount 64)) (= size (* ccount 128))) 1 0)
              (if (= kind 2) (fresh-sok size until chan)
                (if (and (> size 0) (<= size 33554432)) 1 0)))]
    (if (not (= badm 0)) (fail ctx 2)
      (if (not (= rsv 0)) (fail ctx 5)
        (if (or (or (< cnt 1) (> cnt 4)) (not (= lay 0))) (fail ctx 3)
          (do (put-word ctx 212 16384)
              (put-word ctx 216 cnt)
              (put-word ctx 218 0)
              (put-word ctx 227 (+ 128 (* cnt 3392)))
              (put-word ctx 223 (+ (if (= sok 1) 0 1) (if (< version 1) 2 0)))
              (put-word ctx 224 (if (and (= sok 1) (not (= kind 2))) size 0))
              (put-word64 ctx 225 (if (< version 1) 0 version))
              (if (= kind 2) (do (put-word64 ctx 274 size) (put-word64 ctx 276 until) (put-word ctx 278 chan)) 0)
              (copy-manifest ctx 0)
              (mp-prefix kind 0)
              (save-digest ctx 0)
              (fail ctx 14)))))))

;; JUN-813 (ADR-0286 amendment 7): bit 0 of the caller's test argument picks the pinned set: 1 the TEST keys, 0 the production keys.
(defn ed-word [test id w] (if (= (bit-and test 1) 1) (tk/ims-ed-word id w) (pk/ims-ed-word id w)))
(defn ml-word [test id w] (if (= (bit-and test 1) 1) (tk/ims-ml-word id w) (pk/ims-ml-word id w)))
(defn load-ed-key [ctx test id w]
  (if (>= w 8) 1 (do (put-word ctx (+ 512 w) (ed-word test id w)) (load-ed-key ctx test id (+ w 1)))))
(defn load-ml-key [test id w]
  (if (>= w 488) 1 (do (pw! w (ml-word test id w)) (load-ml-key test id (+ w 1)))))
;; The entry's last byte has landed: key id (220), reserved (221), padding (222) must be a pinned slot not yet
;; counted with zero reserved/padding bytes; then Ed25519, and only if it verified, ML-DSA-65.
(defn verify-entry [ctx test]
  (let [id (word ctx 220) seen (word ctx 218)]
    (if (or (>= id 3) (or (not (= (word ctx 221) 0)) (or (not (= (word ctx 222) 0))
                                                         (not (= (bit-and seen (ims-bit id)) 0)))))
      0
      (let [flag (put-word ctx 228 1)
            k (load-ed-key ctx test id 0)
            ed (aiueos-ed25519-verify (kernel-subregion ctx 8192 2048 1024) 64
                                      (kernel-subregion ctx 8192 4096 4096))
            ml (if (= (+ ed (* 0 (+ k flag))) 1)
                 (let [kk (load-ml-key test id 0)
                       u (mv-mu (kernel-owned-window 4 20480) 20480 74)
                       v (mv-verify (kernel-owned-window 4 20480) 20480)]
                   (+ v (* 0 (+ kk u))))
                 0)]
        (put-word ctx 218 (ims-step seen id ed ml))))))

;; Header byte h (>= 128), value b. Entry ei = (h - 128) / 3392, offset e within it.
(defn h2-byte [ctx h b test]
  (let [j (- h 128)
        ei (quot j 3392)
        e (- j (* ei 3392))]
    (if (>= ei (word ctx 216)) 0
      (do (if (< e 4) (put-word ctx 220 (if (= e 0) b (+ (word ctx 220) (* b (case e 1 256 2 65536 16777216))))) 0)
          (if (and (>= e 4) (< e 8)) (put-word ctx 221 (if (= e 4) b (bit-or (word ctx 221) b))) 0)
          (if (and (>= e 8) (< e 72)) (put-byte ctx (+ 2072 e) b) 0)
          (if (and (>= e 72) (< e 3381)) (sb! (- e 72) b) 0)
          (if (>= e 3381) (put-word ctx 222 (if (= e 3381) (nz b) (bit-or (word ctx 222) (nz b)))) 0)
          (if (= e 3391) (verify-entry ctx test) 0)
          1))))
(defn h2-consume [ctx h i n test]
  (if (>= i n) 1
    (do (h2-byte ctx (+ h i) (pg (bit-and (+ h i) 4095)) test)
        (h2-consume ctx h (+ i 1) n test))))

;; src 0 the network (stream offset `off`), src 1 the QEMU file. n <= 1024 bytes land at page byte dst.
(defn get-chunk [ctx src off n dst]
  (if (= src 1)
    ;; word 230 = 1 (QEMU case mode 2): the stream breaks before the piece that would pass byte 7200, like a lost network answer
    (if (and (= (word ctx 230) 1) (> (+ (word ctx 229) n) 7200)) 0
      (do (put-word ctx 229 (+ (word ctx 229) n)) (fw-fill dst n 0)))
    (fetch ctx off n dst 0)))
;; Header bytes h .. end in pieces that end at a 1 KiB line, so none crosses the page end.
(defn h2-loop [ctx src h end test]
  (if (>= h end) 1
    (let [n (least (- 1024 (bit-and h 1023)) (- end h))]
      (if (= (get-chunk ctx src h n (bit-and h 4095)) 0) 0
        (do (h2-consume ctx h 0 n test) (h2-loop ctx src (+ h n) end test))))))
(defn h2-admit [ctx]
  (if (not (= (ims-final (word ctx 218)) 1)) (fail ctx 1)
    (if (= (bit-and (word ctx 223) 1) 1) (fail ctx 3)
      (if (= (bit-and (word ctx 223) 2) 2) (fail ctx 4)
        (if (= (word ctx 231) 2) (fresh-verdict ctx)
          (do (put-word64 ctx 181 (+ (word ctx 225) (* (word ctx 226) 4294967296)))
              (put-word ctx 183 (word ctx 224))
              (put-word ctx 184 0)
              (sha/sha-init (kernel-subregion ctx 8192 3072 512))
              (fail ctx 14)))))))
;; The first 128 header bytes are in the page. 14 when the header is admitted and the image is next.
(defn begin2 [ctx src test]
  (let [s (h2-start ctx test)]
    (if (not (= s 14)) s
      (if (= (h2-loop ctx src 128 (word ctx 227) test) 0)
        ;; the stream broke after some entries may have been verified: the verifier left the NVMe/ESP state overwritten
        (do (restore-storage ctx) (fail ctx 21))
        (do (restore-storage ctx) (h2-admit ctx))))))
;; ---- JUN-813 stage 5c (ADR-0286 amendment 4): the hash-checked per-channel version floor ----
;; The floor lives in the update journal (native/update_journal.kotoba, OSMETA.BIN: crash-ordered double slot, SHA-256 checked, NOT
;; signed). `floor-load` re-runs the NVMe driver and the ESP walk (a verifier may have overwritten their words), mounts OSMETA.BIN
;; read-only and loads the journal; it FAILS CLOSED: a missing, unreadable, corrupt, hash-mismatching or never-initialised journal is
;; result 10, never floor 0. Words 256/257 floor, 258 load result (1 ok, 0 failed), 259 advance (0 not tried, 1 advanced, 2 failed),
;; 260/261 floor after the advance, 262 the QEMU provisioning hook's result. The journal writes its public fields to words 212..223,
;; which are this file's header words, so they are cleared after the floor is taken (the verifier sets its own words afterwards).
(defn clear-words [ctx i end]
  (if (>= i end) 1 (do (put-word ctx i 0) (clear-words ctx (+ i 1) end))))
(defn floor-load [ctx]
  (do (put-word ctx 258 0) (put-word ctx 259 0) (put-word ctx 262 0)
      (if (and (= (nvme/probe ctx) 15) (= (esp/run ctx) 15) (> (journal/mount 0) 0) (> (journal/load) 0))
        (let [lo (journal/field 6) hi (journal/field 7)]
          (do (clear-words ctx 213 224)
              (put-word ctx 256 lo) (put-word ctx 257 hi) (put-word ctx 258 1)
              1))
        (do (clear-words ctx 213 224) 0))))
;; The manifest is signed and its version is known (181/182): it must be strictly above the floor. No image byte has been taken.
(defn floor-ok [ctx]
  (> (word64 ctx 181) (word64 ctx 256)))
(defn floor-check [ctx]
  (if (floor-ok ctx) 14 (fail ctx 9)))
;; Fetch the first 128 bytes and dispatch on the magic's last byte: "2" AIUEIMG2, anything else the AIUEIMG1 path.
;; The floor is read first (result 10 when it cannot be) and compared once the header is admitted (result 9).
;; JUN-813 stage 6: a catalog (`(cat? test)`) takes no version floor: that floor is the image channel's (ADR-0286 amendment 4) and a catalog needs its own.
(defn admit-cat [ctx src test]
  (do (put-word ctx 212 128) (put-word ctx 228 0) (put-word ctx 231 1)
      (put-word ctx 270 0) (put-word ctx 271 0) (put-word ctx 272 0)
      (if (= (get-chunk ctx src 0 128 0) 0) (fail ctx 21)
        (begin2 ctx src test))))
(defn admit-fresh [ctx src test]
  (do (put-word ctx 212 128) (put-word ctx 228 0) (put-word ctx 231 2) (put-word ctx 273 0)
      (if (= (get-chunk ctx src 0 128 0) 0) (fail ctx 21)
        (begin2 ctx src test))))
(defn admit [ctx src test]
  (if (= (fresh? test) 1) (admit-fresh ctx src test)
   (if (= (cat? test) 1) (admit-cat ctx src test)
   (if (= (floor-load ctx) 0) (fail ctx 10)
    (do (put-word ctx 212 128) (put-word ctx 228 0) (put-word ctx 231 0)
        (if (= (get-chunk ctx src 0 128 0) 0) (fail ctx 21)
          (let [r (if (= (pg 7) 50) (begin2 ctx src test)
                    (if (= (begin ctx test) 14) 14 (word ctx 180)))]
            (if (= r 14) (floor-check ctx) r))))))))

(defn chunks [ctx at]
  (let [size (word ctx 183)]
    (if (or (>= at size) (not (= (word ctx 180) 14))) (word ctx 180)
      (let [n (least 1024 (- size at))]
        (if (= (fetch ctx (+ (word ctx 212) at) n (bit-and at 4095) 0) 0) (fail ctx 21)
          (do (chunk-done ctx n) (chunks ctx (+ at n))))))))
;; The boot nonce is remote-cmd's (context words 172/173).
(defn pull [ctx]
  (do (put-word ctx 209 0) (put-word ctx 180 0) (put-word ctx 184 0) (put-word ctx 186 0) (put-word ctx 187 0)
      (if (= (nic/link-info) 0) (fail ctx 20)
        (if (= (admit ctx 0 0) 14) (chunks ctx 0) (word ctx 180)))))

;; KDBG 0xc120 result | repeats << 16, 0xc121 version, 0xc122 size | taken << 32,
;; 0xc123 failed offset, 0xc124..0xc127 the computed SHA-256 (8 bytes each).
(defn report-digest [ctx i]
  (if (>= i 4) 1
    (do (nic/log (+ 49444 i) (+ (* (word ctx (+ 200 (* i 2))) 4294967296) (word ctx (+ 201 (* i 2)))))
        (report-digest ctx (+ i 1)))))
(defn report [ctx]
  (do (nic/log 49440 (+ (word ctx 180) (* (word ctx 186) 65536)))
      (nic/log 49441 (word64 ctx 181))
      (nic/log 49442 (+ (word ctx 183) (* (word ctx 184) 4294967296)))
      (nic/log 49443 (word ctx 187))
      (report-digest ctx 0)
      (word ctx 180)))

;; ---- AWAI-122 stage 4: install ----
(defn ifail [ctx code] (do (put-word ctx 208 code) (put-word ctx 209 0) code))
(defn same-words [ctx a b i]
  (if (>= i 8) 1 (if (= (word ctx (+ a i)) (word ctx (+ b i))) (same-words ctx a b (+ i 1)) 0)))
;; After the manifest is accepted: NVMe and the ESP walk again, then the staging
;; file. 0 ready, else an install code.
(defn ready [ctx]
  (if (not (= (nvme/probe ctx) 15)) 49
    (if (not (= (esp/run ctx) 15)) 49
      (esp/prepare ctx (word ctx 183)))))
(defn start-stream [ctx]
  (do (sha/sha-init (kernel-subregion ctx 8192 3072 512))
      (put-word ctx 184 0)
      (put-word ctx 209 1)))
;; The stream is in: flush, read the staging file back, swap, check BOOTX64.EFI.
(defn commit [ctx]
  (let [size (word ctx 183)]
    (do (put-word ctx 209 0)
        (if (not (= (word ctx 180) 15)) (ifail ctx (word ctx 180))
          (if (not (and (= (esp/sync ctx) 1) (= (nvme/flush ctx) 0))) (ifail ctx 48)
            (if (not (and (= (esp/hash-chain ctx (word ctx 699) size) 15) (= (same-words ctx 680 190 0) 1))) (ifail ctx 46)
              (if (not (= (esp/swap ctx size) 1)) (ifail ctx 48)
                (if (and (= (esp/run ctx) 15) (= (word ctx 677) 1) (= (word ctx 675) size)
                         (= (same-words ctx 680 190 0) 1))
                  (ifail ctx 15)
                  (ifail ctx 47)))))))))
;; ---- JUN-813 stage 5c: advance the floor after a committed install ----
;; Order: the floor is advanced AFTER the install is committed (BOOTX64.EFI swapped and re-hashed), never before. A crash between the two
;; leaves the new image installed with the old floor: one repeat install of the same version is admitted, nothing is bricked. Advancing
;; first would turn every failed install into a refused retry. The journal state after an advance is "prepared" (phase 1, floor =
;; candidate = the installed version); nothing confirms it yet (no boot-health evidence exists), so an install that finds an earlier
;; unconfirmed prepare first abandons it through the journal's own trial and rollback transitions (phase 3, floor kept).
(defn put-digest-bytes [i]
  (if (>= i 8) 1
    (let [w (word (kernel-browser-context) (+ 190 i))]
      (do (put-pg (* i 4) (bit-and (u64-shift-right w 24) 255))
          (put-pg (+ (* i 4) 1) (bit-and (u64-shift-right w 16) 255))
          (put-pg (+ (* i 4) 2) (bit-and (u64-shift-right w 8) 255))
          (put-pg (+ (* i 4) 3) (bit-and w 255))
          (put-digest-bytes (+ i 1))))))
(defn abandon-pending [phase]
  (if (= phase 1) (if (> (journal/trial) 0) (if (> (journal/rollback) 0) 1 0) 0)
    (if (= phase 2) (if (> (journal/rollback) 0) 1 0) 1)))
(defn advance [ctx]
  (let [version (word64 ctx 181)
        d (put-digest-bytes 0)]
    (if (and (> (journal/mount 0) 0) (> (journal/load) 0)
             (= (abandon-pending (journal/field 4)) (+ 1 (* 0 d)))
             (> (journal/prepare version (kernel-subregion (kernel-owned-window 14 4096) 4096 0 32)) 0))
      (do (put-word ctx 260 (journal/field 6)) (put-word ctx 261 (journal/field 7)) (put-word ctx 259 1) 1)
      (do (put-word ctx 259 2) 0))))
;; The journal's `confirm` needs boot-health evidence that does not exist yet (nothing boots the installed image and reports back), so nothing calls
;; this: it is the single place the follow-up will, and it also gives the compiler the extent of confirm's digest region. It is not
;; reachable from any remote command, hook or boot path.
(defn confirm-installed []
  (let [ctx (kernel-browser-context) d (put-digest-bytes 0)]
    (if (and (> (journal/mount 0) 0) (> (journal/load) 0))
      (+ (journal/confirm (word64 ctx 181) (kernel-subregion (kernel-owned-window 14 4096) 4096 0 32)) (* 0 d))
      -1)))
;; r is commit's result: only a fully committed install (15) advances the floor; if the advance itself fails the image is installed
;; but the floor is not (50), which the operator must see.
(defn after-commit [ctx r]
  (if (= r 15)
    (if (= (advance ctx) 1) (ifail ctx 15) (ifail ctx 50))
    r))
(defn install [ctx]
  (do (put-word ctx 208 0) (put-word ctx 209 0) (put-word ctx 180 0) (put-word ctx 184 0)
      (put-word ctx 186 0) (put-word ctx 187 0)
      (if (= (nic/link-info) 0) (ifail ctx 20)
        (if (not (= (admit ctx 0 0) 14)) (ifail ctx (word ctx 180))
          (let [r (ready ctx)]
            (if (> r 0) (ifail ctx r)
              (do (start-stream ctx) (chunks ctx 0) (after-commit ctx (commit ctx)))))))))
(defn self-install [ctx flip]
  (do (put-word ctx 208 0) (put-word ctx 209 0) (put-word ctx 180 0) (put-word ctx 231 0)
      (put-header 0 -1)
      (if (not (= (begin ctx 1) 14)) (ifail ctx (word ctx 180))
        (let [r (ready ctx)]
          (if (> r 0) (ifail ctx r)
            (do (start-stream ctx) (feed ctx 0 flip) (commit ctx)))))))

;; KDBG 0xc130 install result | stream result << 8, 0xc131 BOOTX64.EFI first
;; cluster | size << 32 (after the final walk), 0xc132 staging first cluster,
;; 0xc133..0xc136 the final walk's SHA-256 (8 bytes each).
(defn install-digest [ctx i]
  (if (>= i 4) 1
    (do (nic/log (+ 49459 i) (+ (* (word ctx (+ 680 (* i 2))) 4294967296) (word ctx (+ 681 (* i 2)))))
        (install-digest ctx (+ i 1)))))
(defn install-report [ctx]
  (do (nic/log 49456 (+ (word ctx 208) (* (word ctx 180) 256)))
      (nic/log 49457 (+ (word ctx 674) (* (word ctx 675) 4294967296)))
      (nic/log 49458 (word ctx 699))
      (install-digest ctx 0)
      (word ctx 208)))

;; ---- QEMU gate hook (fw_cfg) ----
;; AIUEIMG2 cases from opt/aiueos/update2: [count][per case: mode, 16384 header bytes, 5000 image bytes]. The image of an
;; admitted case flows through chunk-done (digest check); a refused case's stream is skipped to keep the file aligned.
(defn feed2 [ctx at]
  (if (or (>= at (word ctx 183)) (not (= (word ctx 180) 14))) (word ctx 180)
    (let [n (least 1024 (- (word ctx 183) at))]
      (do (get-chunk ctx 1 0 n (bit-and at 4095))
          (chunk-done ctx n)
          (feed2 ctx (+ at n))))))
(defn test-of [mode] (if (= mode 1) 0 1))
(defn run-case2 [ctx k]
  (let [mode (fw-byte)]
    (do (put-word ctx 229 0) (put-word ctx 180 0) (put-word ctx 218 0) (put-word ctx 230 (if (= mode 2) 1 0))
        (let [a (admit ctx 1 (test-of mode))
              hn (- 16384 (word ctx 229))
              hs (fw-skip hn)
              r (if (= a 14) (feed2 ctx 0) (word ctx 180))
              is (fw-skip (- 21384 (+ hn (word ctx 229))))]
          ;; two cases per word: case k at word 236 + k / 2, low half for even k, high half for odd k
          (let [v (+ r (* 256 (word ctx 218)))
                w (+ 236 (quot k 2))]
            (do (put-word ctx w (if (= (bit-and k 1) 0) v (+ (word ctx w) (* 65536 v))))
                (+ 1 (* 0 (+ hs is)))))))))
(defn cases2 [ctx k n]
  (if (>= k n) 1 (do (run-case2 ctx k) (cases2 ctx (+ k 1) n))))
;; ---- JUN-813 stage 6: AIUECAT1 cases from opt/aiueos/cat1: [count][per case: mode (0 test keys, 1 production), 16384 header bytes,
;; 8192 body bytes (only the manifest's length of them are streamed)]. Case k leaves at word 300 + k: result | counted mask << 8 | entry
;; flags << 16 (flags only for result 16). Words 233 the ESP walk afterwards, 234 the marker "CAT1", 235 the count.
(defn run-case3 [ctx k]
  (let [mode (fw-byte)]
    (do (put-word ctx 229 0) (put-word ctx 180 0) (put-word ctx 218 0) (put-word ctx 230 0)
        (let [a (admit ctx 1 (+ 2 (test-of mode)))
              hn (- 16384 (word ctx 229))
              hs (fw-skip hn)
              r (if (= a 14) (feed2 ctx 0) (word ctx 180))
              is (fw-skip (- 24576 (+ hn (word ctx 229))))
              v (+ r (+ (* 256 (word ctx 218)) (* 65536 (if (= r 16) (word ctx 270) 0))))]
          (do (put-word ctx 231 0)
              (put-word ctx (+ 300 k) v)
              (+ 1 (* 0 (+ hs is))))))))
(defn cases3 [ctx k n]
  (if (>= k n) 1 (do (run-case3 ctx k) (cases3 ctx (+ k 1) n))))
(defn self-test3 [ctx]
  (if (= (fw-open 2) 0) 0
    (let [count (fw-byte)]
      (do (cases3 ctx 0 (least count 64))
          (put-word ctx 233 (esp/run ctx))
          (put-word ctx 235 count)
          (put-word ctx 234 1128354865)
          (put-word ctx 180 0)
          count))))
;; ---- JUN-813 amendment 6: AIUEFRS1 freshness records from opt/aiueos/fresh: [count][per case: mode (0 test keys, 1 production), 16384 header bytes];
;; case k leaves at word 400 + k: result | counted mask << 8 | freshness verdict (word 273) << 16. Words 233 the ESP walk afterwards, 234 the marker "FRS1", 235 the count.
(defn run-case4 [ctx k]
  (let [mode (fw-byte)]
    (do (put-word ctx 229 0) (put-word ctx 180 0) (put-word ctx 218 0) (put-word ctx 230 0) (put-word ctx 273 0)
        (let [a (admit ctx 1 (+ 4 (test-of mode)))
              hn (- 16384 (word ctx 229))
              hs (fw-skip hn)
              v (+ (word ctx 180) (+ (* 256 (word ctx 218)) (* 65536 (word ctx 273))))]
          (do (put-word ctx 231 0)
              (put-word ctx (+ 400 k) v)
              (+ 1 (* 0 (+ hs a))))))))
(defn cases4 [ctx k n]
  (if (>= k n) 1 (do (run-case4 ctx k) (cases4 ctx (+ k 1) n))))
(defn self-test4 [ctx]
  (if (= (fw-open 3) 0) 0
    (let [count (fw-byte)]
      (do (cases4 ctx 0 (least count 64))
          (put-word ctx 233 (esp/run ctx))
          (put-word ctx 235 count)
          (put-word ctx 234 1179800369)
          (put-word ctx 180 0)
          count))))
;; opt/aiueos/clock: measure the RTC. 382/383 the clock reading at the start, 384/385 TSC then, 386..391 TSC at the next three changes of
;; the seconds register, 392/393 the clock reading at the end, 394 the four seconds-register values (one byte each), 395 the three wait
;; results (bits 0..2), 364 the marker "CLK1". Registers and status: words 365..381 (see `rtc-now`).
(defn wait-sec [s0 fuel]
  (if (= fuel 0) 0
    (if (and (= (bit-and (cmos 10) 128) 0) (not (= (cmos 0) s0))) 1
      (do (kernel-pause) (wait-sec s0 (- fuel 1))))))
(defn put-tsc [ctx at]
  (let [t (kernel-rdtsc)]
    (do (put-word ctx at (bit-and t 4294967295)) (put-word ctx (+ at 1) (u64-shift-right t 32)) t)))
(defn clock-probe [ctx]
  (let [u0 (rtc-now ctx)
        st0 (word ctx 365)
        r0 (rtc-unix ctx 374)
        t0 (put-tsc ctx 384)
        s0 (cmos 0)
        w1 (wait-sec s0 40000000)
        t1 (put-tsc ctx 386)
        s1 (cmos 0)
        w2 (wait-sec s1 40000000)
        t2 (put-tsc ctx 388)
        s2 (cmos 0)
        w3 (wait-sec s2 40000000)
        t3 (put-tsc ctx 390)
        s3 (cmos 0)
        u3 (rtc-now ctx)]
    (do (put-word64 ctx 382 u0) (put-word64 ctx 392 u3) (put-word ctx 397 st0) (put-word64 ctx 398 r0)
        (put-word ctx 394 (+ s0 (+ (* s1 256) (+ (* s2 65536) (* s3 16777216)))))
        (put-word ctx 395 (+ w1 (+ (* w2 2) (* w3 4))))
        (put-word ctx 364 1129073457)
        (+ 1 (* 0 (+ t0 (+ t1 (+ t2 t3))))))))
;; Synthetic register rows through the same decoder: [n][n rows of 8 bytes: seconds, minutes, hours, day, month, year, century, register B]; the
;; unix time of row k (0 when invalid) is word 464 + k, n <= 40 is word 460.
(defn fw-row [ctx i]
  (if (>= i 8) 1 (do (put-word ctx (+ 366 i) (fw-byte)) (fw-row ctx (+ i 1)))))
(defn clock-rows [ctx k n]
  (if (>= k n) 1
    (do (fw-row ctx 0) (put-word ctx (+ 464 k) (rtc-unix ctx 366)) (clock-rows ctx (+ k 1) n))))
(defn self-test5 [ctx]
  (if (= (fw-open 4) 0) 0
    (let [n (least (fw-byte) 40)]
      (do (put-word ctx 460 n) (clock-rows ctx 0 n) (clock-probe ctx)))))
(defn self-test2 [ctx]
  (if (= (fw-open 1) 0) 0
    (let [count (fw-byte)]
      (do (cases2 ctx 0 (least count 40))
          (put-word ctx 233 (esp/run ctx))
          (put-word ctx 235 count)
          (put-word ctx 234 1431318578)
          (put-word ctx 180 0)
          count))))
;; Install case 0 of the file through the same admit / ready / stream / commit as the network install.
(defn install2 [ctx adv]
  (do (put-word ctx 208 0) (put-word ctx 209 0) (put-word ctx 180 0) (put-word ctx 218 0) (put-word ctx 229 0) (put-word ctx 230 0)
      (if (= (fw-open 1) 0) (ifail ctx 21)
        (do (fw-byte)
            (let [mode (fw-byte)]
              (if (not (= (admit ctx 1 (test-of mode)) 14)) (ifail ctx (word ctx 180))
                (do (fw-skip (- 16384 (word ctx 229)))
                    (let [r (ready ctx)]
                      (if (> r 0) (ifail ctx r)
                        (do (start-stream ctx) (feed2 ctx 0)
                               (if (= adv 1) (after-commit ctx (commit ctx)) (commit ctx))))))))))))
;; Hook request "4": provision OSMETA.BIN (never done at boot or by the network path): floor 4, active 4, a fixed digest. QEMU only.
(defn fill-digest [i] (if (>= i 32) 1 (do (put-pg i (+ 165 i)) (fill-digest (+ i 1)))))
(defn provision [ctx]
  (let [m (journal/mount 1)
        d (fill-digest 0)
        r (if (> m 0) (journal/initialize 4 4 0 (kernel-subregion (kernel-owned-window 14 4096) 4096 0 32)) m)]
    (do (clear-words ctx 213 224) (put-word ctx 208 0)
        (put-word ctx 262 (if (> (+ r (* 0 d)) 0) 1 2))
        1)))
(defn qemu-hook [ctx]
  (let [b (fw-request)]
    (do (put-word ctx 211 b)
        (if (= b 49) (self-install ctx -1)
          (if (= b 50) (self-install ctx 4097)
            (if (= b 51) (install2 ctx 1)
              (if (= b 52) (provision ctx)
                (if (= b 53) (install2 ctx 0)
                  (do (self-test2 ctx) (self-test3 ctx) (self-test4 ctx) (self-test5 ctx) 0)))))))))
