(ns aiueos.native.rango-touch
  ;; Touch contact admission for the Google Pixel 10 Pro Fold ("rango").
  ;; Judgment only: no bus access, no register, no gesture. A driver that reads
  ;; a contact from a controller asks here whether to accept it and where it
  ;; lands on the display. spec/devices/google-rango.edn is the source of every
  ;; number below (read over adb 2026-11-06, `getevent -pl`):
  ;;   controller 0  fst2                 slots 0..13  x 0..20759 y 0..21519 pressure 0..127
  ;;   controller 1  synaptics_tcm_touch  slots 0..9   x 0..10799 y 0..23639 pressure 0..255
  ;; Which display each controller serves (0 inner 2076x2152, 1 outer 1080x2364)
  ;; is INFERRED from the axis ranges being 10x the panel size; scaling below
  ;; uses the measured axis maximum, never the 10x. Not run against a device.
  (:export [admit scale-x scale-y self-check]))
(defn x-max [c :i64] :i64 (case c 0 20759 1 10799 -1))
(defn y-max [c :i64] :i64 (case c 0 21519 1 23639 -1))
(defn p-max [c :i64] :i64 (case c 0 127 1 255 -1))
(defn s-max [c :i64] :i64 (case c 0 13 1 9 -1))
(defn width [c :i64] :i64 (case c 0 2076 1 1080 -1))
(defn height [c :i64] :i64 (case c 0 2152 1 2364 -1))
(defn within [v :i64 hi :i64] :i64 (if (and (>= v 0) (<= v hi)) 1 0))
;; 1 when the contact is inside every measured range of controller c; 0 otherwise.
;; An unknown controller has maxima of -1, so nothing is admitted for it.
(defn admit [c :i64 slot :i64 x :i64 y :i64 pressure :i64] :i64
  (if (and (>= c 0) (<= c 1)
           (= (within slot (s-max c)) 1)
           (= (within x (x-max c)) 1)
           (= (within y (y-max c)) 1)
           (= (within pressure (p-max c)) 1)) 1 0))
;; Pixel position on the controller's display, edge to edge: axis 0 -> 0,
;; axis max -> size-1. Returns -1 for an unknown controller or an out-of-range value.
(defn scale-x [c :i64 x :i64] :i64
  (if (and (>= c 0) (<= c 1) (= (within x (x-max c)) 1))
    (quot (* x (- (width c) 1)) (x-max c)) -1))
(defn scale-y [c :i64 y :i64] :i64
  (if (and (>= c 0) (<= c 1) (= (within y (y-max c)) 1))
    (quot (* y (- (height c) 1)) (y-max c)) -1))
(defn bit [ok :bool n :i64] :i64 (if ok n 0))
(defn self-check []
  (+ (bit (= (admit 0 0 0 0 0) 1) 1)
  (+ (bit (= (admit 0 13 20759 21519 127) 1) 2)
  (+ (bit (= (admit 1 9 10799 23639 255) 1) 4)
  (+ (bit (= (admit 0 14 0 0 0) 0) 8)
  (+ (bit (= (admit 0 0 20760 0 0) 0) 16)
  (+ (bit (= (admit 0 0 0 21520 0) 0) 32)
  (+ (bit (= (admit 0 0 0 0 128) 0) 64)
  (+ (bit (= (admit 1 10 0 0 0) 0) 128)
  (+ (bit (= (admit 1 0 10800 0 0) 0) 256)
  (+ (bit (= (admit 1 0 0 0 256) 0) 512)
  (+ (bit (= (admit 2 0 0 0 0) 0) 1024)
  (+ (bit (= (admit -1 0 0 0 0) 0) 2048)
  (+ (bit (= (admit 0 -1 0 0 0) 0) 4096)
  (+ (bit (= (admit 1 0 -1 0 0) 0) 8192)
  (+ (bit (= (scale-x 0 0) 0) 16384)
  (+ (bit (= (scale-x 0 20759) 2075) 32768)
  (+ (bit (= (scale-y 0 21519) 2151) 65536)
  (+ (bit (= (scale-x 1 10799) 1079) 131072)
  (+ (bit (= (scale-y 1 23639) 2363) 262144)
  (+ (bit (= (scale-x 1 5400) 539) 524288)
  (+ (bit (= (scale-x 1 10800) -1) 1048576)
  (+ (bit (= (scale-y 0 -1) -1) 2097152)
     (bit (= (scale-x 2 0) -1) 4194304))))))))))))))))))))))))
