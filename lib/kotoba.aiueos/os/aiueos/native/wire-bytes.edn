;; wire-bytes.edn -- the ONE table of single-byte trace values the aiueos
;; native kernel emits (lang-h9, Co-Scientist reflect-01; ADR-0156 "Wire bytes
;; (one table -- collisions cost a whole iteration today)").
;;
;; Why this file exists. The values below were literals scattered through
;; tcp_stream.kotoba, kernel.kotoba and debug_link.kotoba. Twice a new trace
;; byte was assigned on top of an existing sentinel (B0/B6/B7/B8 -- ADR-0156)
;; and the collision was found on the wire, at the cost of a board iteration.
;; This registry is the place uniqueness is decided; the verifier
;; os/aiueos/tools/verify-wire-bytes.cljk refuses overlapping values here and
;; reports any literal the sources emit that is not here, or any entry here
;; that no source emits.
;;
;; This is a REGISTRY, not a renumbering. The values are what the receiver
;; (k16-netlog-standalone.py) and ADR-0156 already decode. Do not change a
;; value here without changing it on the wire, in the receiver and in the ADR.
;;
;; Reconciliation 2026-09-07 (source wins; see :disagreements): the SOURCE
;; header comments and ADR-0156 agree on every value both name. The ADR's
;; one-table is missing three bytes the source emits (FA, FB, FC) and the
;; source has no single complete table -- its comments are per function
;; (stream-connect: A1..B0; receive-established: "these are E0-E8 and F1-F9").
;;
;; Shape. One entry per emitted literal or per emitted BASE of an arithmetic
;; form. The kernel emits some bytes as `(+ base dynamic)` -- E0+remaining,
;; 242+decision, 12+result -- and the registry keeps that shape: such an entry
;; has :span (how many consecutive values the base claims) and :offsets (what
;; each claimed value means). A scalar entry has no :span (= 1). Two entries on
;; the same :channel may not overlap in [value, value+span). The same value on
;; two DIFFERENT channels is not a collision (a bus3 UDP payload byte and a
;; netlog byte never share a wire), and the verifier says so rather than
;; flagging it.
;;
;; Channels (which primitive puts the byte where):
;;   :netlog    (stream-log win mmio log-frame <byte>)  -- UDP/7777 receipt on
;;              bus2 to the Mac (10.77.0.1). ONE byte per receipt, low 8 bits
;;              of the status argument (stream-log-byte renders two hex digits).
;;              This is the wire ADR-0156 decodes.
;;   :bus3-udp  (debug-send-byte mmio dma-pages <byte>) -- single-byte UDP/9000
;;              payload on bus3 to the Mac en8 (10.10.10.1).
;;   :port-e9   (kernel-out-u8 233 <byte>)  -- port 0xE9 debug console
;;              (QEMU/Bochs-style); ASCII checkpoint letters during early boot.
;;   :port-cf9  (kernel-out-u8 3321 <byte>) -- port 0xCF9 reset control.
;;
;; NOT covered (deliberately): (kernel-out-u32 244 ...) -- the 0xF4 status
;; word is a u32 built from a dynamic status plus an offset (192+, 96+, 16/17),
;; not a single trace byte; and the 16 ASCII bytes "AIUEOS_STREAM_" that
;; store-stream-log writes around the trace byte (a fixed prefix, not a
;; sentinel).
{:registry/id :aiueos-wire-bytes
 :registry/version 1
 :registry/reconciled "2026-09-07"
 :registry/amended ["2026-09-08 bus3 'R' reboot command: netlog DB (0xDB) / DC (0xDC), bus3-udp 'r' (0x72); :port-cf9 0x06 gains a second emission site"
                    "2026-09-08 the murakumo relay on bus3: netlog D8 (0xD8) announces AIUEOS_NODE_HELLO_V1, and D9's follower gains 8 and 112..123 for AIUEOS_JOB_V1. The relay's own traffic is ASCII LINES on bus3 UDP/9000, not single bytes, so it is deliberately NOT registered on :bus3-udp -- that channel's contract is one byte per datagram and a 91..205 byte line would break every reader of it. The lines are checked against the relay's own regexes by os/aiueos/tools/gen-relay-text.cljk instead."]
 :registry/authorities ["os/aiueos/native/tcp_stream.kotoba (per-function comments)"
                        "os/aiueos/native/kernel.kotoba"
                        "os/aiueos/native/debug_link.kotoba"
                        "90-docs/adr/0156-lan2-bus3-debug-plane-census.md #Wire bytes"]

 ;; The files the verifier scans. A missing file is a refusal (exit 2), not a
 ;; clean scan of fewer files.
 :emitters ["os/aiueos/native/tcp_stream.kotoba"
            "os/aiueos/native/kernel.kotoba"
            "os/aiueos/native/debug_link.kotoba"]

 ;; head symbol (namespace-qualified aliases allowed, e.g. stream/stream-log)
 ;; -> which argument position (0 = head) carries the byte, and the channel.
 ;; kernel-out-u8's channel depends on its port argument.
 :primitives {stream-log      {:byte-arg 4 :channel :netlog}
              ;; Two bus3 emitters, not one: debug-send-byte broadcasts what we
              ;; start, answer-byte replies to the MAC a request came from. The
              ;; split was invisible to this table for exactly one run, and the
              ;; detector said so -- three registered bytes with no emitter.
              debug-send-byte {:byte-arg 3 :channel :bus3-udp}
              answer-byte     {:byte-arg 3 :channel :bus3-udp}
              broadcast-byte  {:byte-arg 3 :channel :bus3-udp}
              kernel-out-u8   {:byte-arg 2 :port-arg 1
                               :ports {233 :port-e9 3321 :port-cf9}}
              ;; The boot markers stopped being literal `kernel-out-u8 233`
              ;; calls on 2026-09-08: they now go through serial/trace-byte,
              ;; which writes the SAME character to 0xE9 and to COM1. The
              ;; detector said so immediately -- three registered port-e9 bytes
              ;; with no emitter -- which is the shape it was built for, and
              ;; the same one it caught when the bus3 emitters split in two.
              ;;
              ;; Registered on :port-e9 rather than a new channel because the
              ;; byte and its meaning are unchanged; what changed is that it
              ;; now also leaves the machine on a wire that exists outside
              ;; QEMU. A reader of either transport sees the same characters.
              trace-byte      {:byte-arg 1 :channel :port-e9}}

 :entries
 [;; ── :netlog  A-series: the active open (stream-connect / receive-syn-ack) ──
  {:channel :netlog :value 161 :hex "A1" :name :syn-built
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "SYN frame built. Followed by 6 DATA bytes (see :data-followers)."}
  {:channel :netlog :value 162 :hex "A2" :name :syn-submitted
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "SYN descriptor submitted to the NIC (logged BEFORE wait-tx-complete, which is why the log frame must not be the TX frame)."}
  {:channel :netlog :value 163 :hex "A3" :name :syn-tx-complete
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "SYN TX completed (OWN cleared)."}
  {:channel :netlog :value 164 :hex "A4" :name :syn-ack-window-expired
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "No SYN-ACK arrived inside the poll window; cycle result 21."}
  {:channel :netlog :value 166 :hex "A6" :name :syn-ack-ports-or-ack-mismatch
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "SYN-ACK admission: ports or ack number did not match -> result 94."}
  {:channel :netlog :value 167 :hex "A7" :name :syn-ack-ipv4-checksum-fault
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "SYN-ACK admission: IPv4 header checksum failed -> result 93."}
  {:channel :netlog :value 168 :hex "A8" :name :syn-ack-tcp-checksum-fault
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "SYN-ACK admission: TCP checksum failed -> result 96."}
  {:channel :netlog :value 169 :hex "A9" :name :handshake-complete
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "stream-connect returned 0; the ESTABLISHED window is about to run. Splits 'never got past connect' from 'receive-established never returned'."}
  {:channel :netlog :value 174 :hex "AE" :name :syn-retransmit-budget-gone
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "tcb-slot-syn-retransmissions reached 0 -> result 21."}
  {:channel :netlog :value 175 :hex "AF" :name :syn-build-failed
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "build-syn-frame returned 0 -> 35-series TX fault."}
  {:channel :netlog :value 176 :hex "B0" :name :syn-submit-failed
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "tx-submit-stream refused the SYN -> 35-series TX fault. NOTE: B0 was ALSO the base of the first (retired) window-entry instrumentation B0+remaining (ADR-0156); that use is gone, this one stays."}

  ;; ── :netlog  B/D-series: boot census and the LAN2 (bus3) debug plane ──────
  {:channel :netlog :value 183 :hex "B7" :name :census-sentinel
   :emitter "os/aiueos/native/kernel.kotoba"
   :meaning "Boot census starts. Followed by 2 DATA bytes: rtl/bus-probe 3 (bus3), rtl/bus-probe 2 (bus2 control). Observed B7 7F 7F."}
  {:channel :netlog :value 184 :hex "B8" :name :bus3-sentinel
   :emitter "os/aiueos/native/kernel.kotoba"
   :meaning "The bus3 (LAN2) bring-up starts here. Followed by 1 DATA byte: debug-init status (0 ready / 6 bar-b never decoded / 9 no MEM-SPACE|BUS-MASTER / 7 MAC implausible / 2 revision unreadable / 8 PHY no link / 10+n rings-start refused n). Then, only if ready, six DA <mac-byte> pairs (12 datagrams). Then 1 DATA byte: debug-send status (0 submitted and OWN cleared / 1 build failed / 5 owned or length rejected / 3 descriptor store did not read back / 4 OWN never cleared / 7 not attempted)."}
  {:channel :netlog :value 217 :hex "D9" :name :bus3-event
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "Sentinel for a bus3 event; the byte AFTER it is debug-tick's value:
              0 nothing, 1 not ours, 2 ring dead, 16+n an ARP request for
              10.10.10.2 answered, 64+n 'P' answered with 'p', 80+n 'R'
              answered with 'r' (the caller then logs DB and resets),
              96+n an unrecognised command answered with '?',
              8 a job request arrived that could not be staged,
              112+n an AIUEOS_JOB_V1 was answered (112 = the result line left
              the NIC; 113 not the shape the relay sends; 114 prompt outside
              \" a-z\"; 115 empty transition row; 116 answer unwritable;
              117 header unbuildable; 118+n submit refused). n is
              submit-bus3-frame's status, 0..5."}
  {:channel :netlog :value 216 :hex "D8" :name :relay-hello-sentinel
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "AIUEOS_NODE_HELLO_V1 was attempted on bus3, once, on the first
             cycle of the run. The byte AFTER it is debug-hello's status:
             0 the line left the NIC / 1 the line could not be written /
             2 the header could not be built / 3 bus3's BAR no longer decodes /
             3+n submit refused with n. Emitted on EVERY first cycle, including
             when it fails, so 'the board never announced itself' and 'the
             board announced itself and the Mac heard nothing' are different
             shapes on this wire. Added 2026-09-08 with the murakumo relay."
   :data-followers 1}
  {:channel :netlog :value 219 :hex "DB" :name :bus3-reboot-command
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "'R' (reboot) arrived on bus3 and was answered 'r' (the D9 <80+n> pair precedes this). The kernel is about to write 0x06 to port 0xCF9 (SYS_RST|RST_CPU) -- the same write the run end does after DE. Order on the wire: D9 <80+n> DB, then either silence (the board reset) or DC (the chipset ignored the write). Added 2026-09-08 (owner: LAN2 carries control so nobody presses the power button)."}
  {:channel :netlog :value 220 :hex "DC" :name :bus3-reboot-ignored
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "The 0xCF9 write requested by 'R' returned: execution continued, so the chipset ignored the reset. The cycle goes on. A reset that did not happen must not look like one that did -- DB without DC is the only shape that means the board went down."}
  {:channel :netlog :value 218 :hex "DA" :name :bus3-mac-sentinel
   :emitter "os/aiueos/native/kernel.kotoba"
   :meaning "ONE MAC byte follows this DA. The kernel emits DA before EVERY byte of bus3's MAC: DA IDR0 DA IDR1 DA IDR2 DA IDR3 DA IDR4 DA IDR5 = 12 datagrams, once, only when debug-init returned ready (would read DA 70 DA 70 DA FC DA 0B DA B6 DA 31 for 70:70:fc:0b:b6:31). A reader consumes exactly one positional byte after each DA, whatever its value -- the MAC can contain FC, B6 or DA itself and the byte after a DA is never a sentinel. Shape changed 2026-09-07 (lang-h9b): the earlier form was one DA followed by six positional bytes, and on the 1-byte-per-datagram wire a MAC byte FC was read as the FC checksum verdict (measured 2026-09-07)."}
  {:channel :netlog :value 221 :hex "DD" :name :bus3-phy-status-sentinel
   :emitter "os/aiueos/native/kernel.kotoba"
   :meaning "Emitted TWICE at boot when bus3 came up ready, each time followed
             by ONE byte of PHYstatus (MMIO 108): DD <hi> DD <lo>. One DD per
             byte for the reason lang-h9b names -- a raw byte on this wire is a
             sentinel somewhere. link-up reads bit 1 of this register; the whole
             register carries the negotiated speed and duplex beside it."
   :data-followers 1}
  {:channel :netlog :value 214 :hex "D6" :name :watchdog-refused-no-acpi-base
   :emitted-by "kernel.kotoba main, three times, immediately before the stream loop"
   :meaning "No watchdog: the LPC bridge IS Intel, but its ACPI base register (0x40 of 00:1f.0) reads zero or outside the I/O range, so the TCO register file is not where this code would look for it. Split out of D4 on 2026-09-08 after the board reported D4 six times and the byte could not say which of three refusals it meant."}
  {:channel :netlog :value 210 :hex "D2" :name :watchdog-refused-halt-locked
   :emitted-by "kernel.kotoba main, three times, immediately before the stream loop"
   :meaning "No watchdog, and this is the interesting one: the LPC bridge is Intel, the ACPI base is sane, the registers are where they should be -- and TCO_TMR_HLT did not read back cleared. The platform is refusing, which is what a No-Reboot strap or a locked-down TCO looks like. Nothing in software fixes this; it is a firmware setting or a board that will not self-reset."}
  {:channel :netlog :value 208 :hex "D0" :name :previous-run-died-on-ud
   :emitted-by "kernel.kotoba main, three times, before the watchdog mark"
   :meaning "The PREVIOUS run on this board ended in #UD, and this boot is reporting it. The #UD handler writes vector 6 to offset 1024 of the IDT page and resets the platform; DRAM survives a warm reset, so the byte is still there when the next boot reads it, and it is cleared once read so the answer belongs to one boot only. #UD is where a spent fuel budget arrives -- the prologue ends an out-of-budget run with ud2 -- so D0 is the first direct evidence this rig has ever had that a run died of exhaustion rather than of something else. Its ABSENCE after a death is equally informative: it means the run did not die on #UD."}
  {:channel :netlog :value 213 :hex "D5" :name :watchdog-armed-after-timeout
   :emitted-by "kernel.kotoba main, three times, immediately before the stream loop"
   :meaning "The watchdog is armed AND the chipset was still holding a timeout status from a previous expiry (TCO1_STS.TIMEOUT at +0x04 bit 3, or TCO2_STS.SECOND_TO_STS at +0x06 bit 1). Read: the previous boot ended because the watchdog fired, not because the board died some other way -- the hardware's own record of why it restarted, read before it is cleared. D3 means armed with no such evidence."}
  {:channel :netlog :value 211 :hex "D3" :name :watchdog-armed
   :emitted-by "kernel.kotoba main, three times, immediately before the stream loop"
   :meaning "The chipset TCO watchdog is counting and the stream loop will kick it once per cycle. From here a run that stops resets the board by itself, which is the whole point: measured 2026-09-08, six power cycles in one afternoon were all this timer's job. Neither remote path could do it -- `k16-control.cljk R` is answered by debug-tick, polled once per stream cycle, so a kernel that stopped cycling never reads it; and the loader's STATUS panel goes to UEFI ConOut, and the loader has no NIC."}
  {:channel :netlog :value 212 :hex "D4" :name :watchdog-refused
   :emitted-by "kernel.kotoba main, three times, immediately before the stream loop"
   :meaning "No watchdog. One of: the LPC bridge at 00:1f.0 is not Intel (vendor != 0x8086), its ACPI base register reads zero or out of range, or TCO_TMR_HLT would not clear on read-back -- a No-Reboot strap or a locked TCO. This is NOT a fault to act on at run time: it means the board still needs a human to power-cycle it, which is exactly what it needed before the watchdog existed. It IS the byte to look for when a board stops coming back on its own."}
  {:channel :netlog :value 215 :hex "D7" :name :run-end-quiesce
   :emitted-by "stream-resident (tcp_stream.kotoba), run end, after the three DEs"
   :meaning "The run ended, the three DEs are submitted, and the kernel is about to WAIT for the last transmit descriptor's Own bit to clear before writing 0xCF9. Added 2026-09-08 after the board froze with DE DE DE on the wire, no STATUS on the panel, and the panel text still on screen -- no POST, so no reset, and `main` never returned. The only statement between the last DE and that return is the 0xCF9 write, so the write is where it stops; 0x06 is a WARM reset and does not reset PCIe, and three fire-and-forget transmits had just been handed to the RTL8125. D7 is emitted BEFORE the drain on purpose: stream-log is itself a DMA submit, so a receipt after the drain would re-arm what was just drained. Read it as: D7 present = the run reached the quiesce; DE present but D7 absent across a whole run = it did not."}
  {:channel :netlog :value 222 :hex "DE" :name :run-end-reset
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "debug-run-cycles exhausted; the run is ending. Until 2026-09-08 evening this meant the kernel was about to write 0xCF9; it now means it is about to drain the last transmit and hand the step back to the tender with 250. Emitted THREE TIMES in a row. This wire is fire-and-forget UDP, one datagram per byte, and DE separates a deliberate end from a death -- measured across 259 runs of the 64-cycle configuration, only 216 carried a DE and 2 of the last 20 did, while the board went on rebooting every ~20 s throughout, which proves those runs ended normally. One lost datagram was reading as a death, and a wedge was attributed to fuel exhaustion on exactly that evidence, wrongly (ADR-0203). Three copies do not make the wire lossless; they make the ABSENCE of DE mean something. Do not use per-boot marker counts to locate where a run ended -- the wire is too lossy, and gap-based boot segmentation misattributes markers across boundaries."}

  ;; ── :netlog  E-series: ESTABLISHED window entry, one byte per tick ───────
  {:channel :netlog :value 224 :hex "E0" :span 9 :name :established-window-entry
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "receive-established entered with `remaining` ticks left, emitted as E0+remaining. A full window reads E8 E7 ... E1; E0 (remaining 0) returns 21 immediately."
   :offsets {0 "E0 remaining 0 (window over -> result 21)" 1 "E1" 2 "E2" 3 "E3" 4 "E4" 5 "E5" 6 "E6" 7 "E7" 8 "E8 first tick of an 8-tick window"}}

  ;; ── :netlog  F-series: per-frame verdicts inside the ESTABLISHED window ──
  {:channel :netlog :value 241 :hex "F1" :name :empty-poll
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "rx-ring-wait-command returned 0 inside the 8000-poll budget: nothing arrived this tick."}
  {:channel :netlog :value 242 :hex "F2" :span 4 :name :frame-verdict-or-accept-decision
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "Two emission forms share this base, as the source is written: the exact literal 242 is the fallback of the verdict chain (verdict 3 = bad descriptor / invalid command word); (+ 242 decision) is accept-decision's non-zero verdict, decision 1..3. F5 is followed by 4 DATA bytes: flags, payload length lo, seg-seq lo, rcv-nxt lo."
   :offsets {0 "F2 bad descriptor (verdict 3): re-arm, step ring head, look again"
             1 "F3 duplicate (decision 1): re-ACK what was delivered"
             2 "F4 queue full (decision 2): delivery stalls inside status 99"
             3 "F5 out-of-window (decision 3): dropped silently per RFC; +4 data bytes"}}
  {:channel :netlog :value 246 :hex "F6" :name :not-ours
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "verdict 4: ethertype/IHL/proto/addresses/ports do not match the 4-tuple (a stray DHCP/ARP broadcast). Costs one tick; the window continues."}
  {:channel :netlog :value 247 :hex "F7" :name :admitted
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "accept-decision 0: the segment is admitted in order."}
  {:channel :netlog :value 248 :hex "F8" :name :staged
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "payload copied to staging (stage-payload-at returned)."}
  {:channel :netlog :value 249 :hex "F9" :name :delivered
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "deliver-held-run advanced the delivered run."}
  {:channel :netlog :value 250 :hex "FA" :name :peer-rst-closed
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "verdict 5: in-window RST from the peer; TCB marked CLOSED, result 100 (ADR-0134 s4). Distinct from the FIN close (which sends our FIN|ACK) and from a window that merely expired."}
  {:channel :netlog :value 251 :hex "FB" :name :syn-in-established
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "verdict 6: a SYN arrived in ESTABLISHED; dropped like a stray frame (re-arm, step head)."}
  {:channel :netlog :value 252 :hex "FC" :name :checksum-failure-in-established
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "verdict 7 (ours = 2): the frame is ours but its IPv4 or TCP checksum failed; dropped. 'A checksum failure is FC on the wire, not F6, so it counts.'"}

  ;; ── :netlog  cycle result: 0x0C + the cycle's result integer ─────────────
  {:channel :netlog :value 12 :hex "0C" :span 101 :name :cycle-result
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "End of every stream-resident cycle: (+ 12 result). result is the stream status / fault integer (21..100), so the byte is 0x21..0x70. Claims [12, 113) so no sentinel may be placed there."
   :offsets {21 "0x21 = 21 window expired / budget gone"
             30 "0x2A = 30 RX ring re-arm failed"
             35 "0x2F.. = 35-series TX faults"
             93 "0x69 = 93 IPv4 checksum fault (after A7)"
             94 "0x6A = 94 ports/ack mismatch (after A6)"
             96 "0x6C = 96 TCP checksum fault (after A8)"
             97 "0x6D = 97 LISTEN (seeding failed; connect not attempted)"
             98 "0x6E = 98 SYN-SENT"
             99 "0x6F = 99 ESTABLISHED (window ended while open)"
             100 "0x70 = 100 CLOSED (FIN|ACK sent, or peer RST via FA)"}}

  ;; ── :bus3-udp  single-byte payloads on LAN2 (debug-send-byte) ────────────
  {:channel :bus3-udp :value 66 :hex "42" :name :hello-B-limited-broadcast
   :emitter "os/aiueos/native/debug_link.kotoba"
   :meaning "The same boot greeting as Z, addressed to 255.255.255.255 instead
             of 10.10.10.1. Both are sent once per boot: a broadcast Ethernet
             frame carrying a unicast IP destination is a shape BSD's ip_input
             rejects, so if B arrives and Z does not, that rule is why this
             plane was never heard."}
  {:channel :bus3-udp :value 90 :hex "5A" :name :hello-Z
   :emitter "os/aiueos/native/debug_link.kotoba"
   :meaning "'Z': the one-shot bring-up datagram debug-send fires after debug-init returned ready."}
  {:channel :bus3-udp :value 112 :hex "70" :name :ping-reply-p
   :emitter "os/aiueos/native/debug_link.kotoba"
   :meaning "'p': answer to a well-formed control datagram carrying 'P' (debug-tick 64+n)."}
  {:channel :bus3-udp :value 114 :hex "72" :name :reboot-ack-r
   :emitter "os/aiueos/native/debug_link.kotoba"
   :meaning "'r': answer to a well-formed control datagram carrying 'R' (debug-tick 80+n). Sent BEFORE the reset (debug-send-byte waits for TX completion), so the Mac holds the acknowledgement before the board goes away; the reset itself is stream-resident's, after DB on bus2. Mac side: os/aiueos/tools/k16-control.cljk R."}
  {:channel :bus3-udp :value 63 :hex "3F" :name :unknown-command
   :emitter "os/aiueos/native/debug_link.kotoba"
   :meaning "'?': answer to a well-formed control datagram whose command byte is not in the closed set (debug-tick 96+n)."}

  ;; ── :port-e9  early-boot ASCII checkpoints on the 0xE9 debug console ─────
  {:channel :port-e9 :value 69 :hex "45" :name :E-recoverable-frame-valid
   :emitter "os/aiueos/native/kernel.kotoba"
   :meaning "'E': the page-fault recovery probe frame validated (recoverable-frame-valid)."}
  {:channel :port-e9 :value 77 :hex "4D" :name :M-boot-info-map-accepted
   :emitter "os/aiueos/native/kernel.kotoba"
   :meaning "'M': boot-info v4's fourteen-page EfiLoaderData scratch allocation accepted (map-marker)."}
  {:channel :port-e9 :value 80 :hex "50" :name :P-page-tables-activated
   :emitter "os/aiueos/native/kernel.kotoba"
   :meaning "'P': page tables prepared and activated (page-marker)."}
  {:channel :port-e9 :value 82 :hex "52" :name :R-root-marker
   :emitter "os/aiueos/native/kernel.kotoba"
   :meaning "'R': page-table root in place (root-marker)."}
  {:channel :port-e9 :value 67 :hex "43" :name :C-cr3-marker
   :emitter "os/aiueos/native/kernel.kotoba"
   :meaning "'C': CR3 loaded (cr3-marker)."}
  {:channel :port-e9 :value 68 :hex "44" :name :D-idt-marker
   :emitter "os/aiueos/native/kernel.kotoba"
   :meaning "'D': page-fault IDT installed (idt-marker)."}
  {:channel :port-e9 :value 78 :hex "4E" :name :N-nic-qualified
   :emitter "os/aiueos/native/kernel.kotoba"
   :meaning "'N': qualify-rtl8125 returned 0 (nic-marker)."}
  {:channel :port-e9 :value 70 :hex "46" :name :F-nic-qualify-fault
   :emitter "os/aiueos/native/kernel.kotoba"
   :meaning "'F': qualify-rtl8125 returned a non-negative fault code (nic-marker)."}

  ;; ── :port-cf9  reset control ─────────────────────────────────────────────
  {:channel :port-cf9 :value 6 :hex "06" :name :sys-rst-rst-cpu
   :emitter "os/aiueos/native/tcp_stream.kotoba"
   :meaning "Deliberate platform reset on port 0xCF9, value 0x06 = SYS_RST|RST_CPU. ONE emission site since 2026-09-08 evening: the bus3 'R' command (after DB); if the chipset ignores it the kernel logs DC and the cycle continues. The run-end site is GONE -- the run now returns 250 and the image tender loop replenishes the budget and re-enters main (ADR-0205 step 2), so a reset is no longer part of the cadence. Consequence to know: a deploy no longer takes effect by itself, because the board stops re-fetching its image; 'R' on bus3 is how a new image is picked up. Three run-end reset variants were measured that day (0x06, 0x06+drain, 0x0E+drain) and every one did a handful of boots and stopped, with a 0..2 spread that the workstation load average -- which moved 30 to 188 in the same session -- more than covers."}]

 ;; Bytes on the :netlog wire that are DATA, not sentinels: emitted through the
 ;; same stream-log primitive but with a computed argument. The verifier counts
 ;; them (SCANNED ... dynamic) and does not try to match them; a reader must
 ;; consume them POSITIONALLY after their sentinel, because their values can
 ;; equal any sentinel (a MAC byte FC is not the FC verdict).
 :data-followers
 [{:after :syn-built :count 6 :what "SYN frame fields, low byte each: be16@12 ethertype, u8@14 v4/IHL, checksum-word@14, checksum-fold of the IPv4 header, be16@24 IPv4 checksum, be16@50 TCP checksum (observed 00 45 00 FF 19 52)"}
  {:after :census-sentinel :count 2 :what "rtl/bus-probe 3, rtl/bus-probe 2 (bit census; qualified = 7F)"}
  {:after :bus3-sentinel :count 1 :what "debug-init status"}
  {:after :bus3-mac-sentinel :count 1 :what "one MAC byte; DA is emitted before each of IDR0..5, so the MAC arrives as six DA <byte> pairs in IDR order"}
  {:after :bus3-sentinel :count 1 :what "debug-send status (after the optional DA pairs)" :note "order on the wire: B8 <init> [DA <m0> DA <m1> DA <m2> DA <m3> DA <m4> DA <m5>] <send>"}
  {:after :bus3-event :count 1 :what "debug-tick value (1 / 2 / 64+n / 80+n / 96+n); when it is 80..87 the sentinel DB follows, then DC only if the reset was ignored"}
  {:after :frame-verdict-or-accept-decision :offset 3 :count 4 :what "F5 only: flags, payload&255, seg-seq&255, rcv-nxt&255"}]

 ;; Where the two authorities disagreed on 2026-09-07, and which won (SOURCE).
 :disagreements
 [{:id :adr-one-table-missing-fa-fb-fc
   :source "tcp_stream.kotoba emits 250 (FA, peer RST -> CLOSED), 251 (FB, SYN in ESTABLISHED), 252 (FC, checksum failure in ESTABLISHED)"
   :adr "ADR-0156 #Wire bytes lists A1..A9 AE AF B0 B7 B8 D9 DA DE E0-E8 F1..F9 0x0C+result and does not list FA, FB, FC (the ADR body mentions F5/F6 only)"
   :resolution "source wins: FA FB FC registered. The ADR table should be regenerated from this file."}
  {:id :source-has-no-single-table
   :source "tcp_stream.kotoba's comments are per function: stream-connect names A1 A2 A3 AE AF B0; receive-established says 'Keep one table of wire bytes; these are E0-E8 and F1-F9'; A4/A6-A9/D9/DE/FA/FB/FC are named only at their emission sites"
   :adr "ADR-0156 has the only single table"
   :resolution "this file is now the single table; the source comments that name bytes remain as local documentation and the verifier checks the LITERALS, not the comments"}
  {:id :f2-f5-share-one-base-in-source
   :source "(+ 242 decision) for F3/F4/F5 and the literal 242 for F2 share the base 242"
   :adr "the ADR lists F2 F3 F4 F5 as four independent bytes"
   :resolution "registered as ONE entry :value 242 :span 4 with :offsets, because that is the shape the source emits; the ADR's four rows are the four offsets"}
  {:id :b0-is-both-live-and-retired
   :source "176 (B0) is live as :syn-submit-failed"
   :adr "ADR-0156 says the first instrumentation used B0 (+remaining) and was retired for E0"
   :resolution "no conflict today (E0 replaced the window-entry use); recorded so nobody re-uses B0+n as a range"}
  {:id :e9-and-cf9-not-in-adr
   :source "kernel-out-u8 233 <'E' 'M' 'P' 'R' 'C' 'D' 'N' 'F'> and kernel-out-u8 3321 6"
   :adr "ADR-0156 is about the bus2/bus3 netlog planes and does not cover port I/O"
   :resolution "not a disagreement; registered on their own channels so a duplicate letter on 0xE9 is caught the same way"}]}
