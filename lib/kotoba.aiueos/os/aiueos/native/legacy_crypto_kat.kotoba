;; Public native diagnostic only. Blob header12 points to3 RFC8032 records
;; (seed32/public32/signature64/message64), header16 to SHA256(abc)32.
;; Uses request page73 scratch0..8191 and assertion counter context word75.
;; Gives retained legacy APIs real checked callers, never dummy ABI stubs.
(ns aiueos.native.legacy-crypto-kat
  (:require [aiueos.ed25519 :refer [aiueos-ed25519-pubkey aiueos-ed25519-sign aiueos-ed25519-verify]]
            [aiueos.lib.sha256-stream :refer [sha-init sha-final]])
  (:export [run]))
(defn- data [i] (kernel-load-u8 (kernel-subregion (kernel-native-font) 524288 (+ 393216 i) 1) 1 0))
(defn- d32 [i] (+ (data i) (* (data (+ i 1)) 256) (* (data (+ i 2)) 65536) (* (data (+ i 3)) 16777216)))
(defn- rb [at] (kernel-load-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1) 1 0))
(defn- rp [at v] (kernel-store-u8 (kernel-subregion (kernel-value-domain-request-page 73) 262144 at 1) 1 0 v))
(defn- check [ok :bool] :i64
  (if ok 1 (do (kernel-store-u32 (kernel-subregion (kernel-browser-context) 8192 300 4) 4 0
                 (+ (kernel-load-u32 (kernel-subregion (kernel-browser-context) 8192 300 4) 4 0) 1)) 0)))
(defn- copy [at source n i]
  (if (>= i n) 1 (do (rp (+ at i) (data (+ source i))) (copy at source n (+ i 1)))))
(defn- equal [at source n i] :bool
  (if (>= i n) true (if (= (rb (+ at i)) (data (+ source i))) (equal at source n (+ i 1)) false)))
(defn- clear [i]
  (if (>= i 1024) 1 (do (rp i 0) (clear (+ i 1)))))
(defn- rfc [slot]
  (if (>= slot 3) 1
    (let [at (+ (d32 12) (* slot 192)) size slot]
      (do (copy 0 at 32 0)
          (check (= (aiueos-ed25519-pubkey (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 32)
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 1024 128)
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 4096 4096)
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 2048 64)) 1))
          (check (equal 1024 (+ at 32) 32 0)) (clear 0) (copy 0 at 32 0) (copy 256 (+ at 128) size 0)
          (check (= (aiueos-ed25519-sign (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 1024) size
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 2048 64)
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 4096 4096)) 1))
          (check (equal 2048 (+ at 64) 64 0)) (clear 0) (copy 0 (+ at 32) 32 0) (copy 32 (+ at 64) 64 0) (copy 96 (+ at 128) size 0)
          (check (= (aiueos-ed25519-verify (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 1024) size
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 4096 4096)) 1)) (rp 32 (bit-xor (rb 32) 1))
          (check (= (aiueos-ed25519-verify (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 1024) size
                    (kernel-subregion (kernel-value-domain-request-page 73) 262144 4096 4096)) 0)) (rfc (+ slot 1))))))
(defn run []
  (do (rp 1024 97) (rp 1025 98) (rp 1026 99)
      (check (= (sha-init (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 512)) 1))
      (check (= (sha-final (kernel-subregion (kernel-value-domain-request-page 73) 262144 0 512)
                  (kernel-subregion (kernel-value-domain-request-page 73) 262144 1024 3) 3) 1))
      (check (equal 424 (d32 16) 32 0)) (rfc 0)))
