;; Native unity fragment, assembled after the exact Amu seed 00/01/02 helpers (JUN-555).
;; Writes os/aiueos's public P-256 SSH authorization header: the bytes
;; scripts/write-ssh-authorized-key-header.py wrote for the same key.
;; argv: output key. The key is x||y in hexadecimal: surrounding whitespace
;; (Python's str.isspace set) is dropped and the 128 digits that remain may be
;; any case; they are written as lowercase bytes. Invalid input writes nothing.
;; Strings here index UTF-8 bytes; string-code-point-at decodes at a lead byte.
(defn- ssh-space? [c :i64] :bool
  (or (and (>= c 9) (<= c 13)) (and (>= c 28) (<= c 32)) (= c 133) (= c 160) (= c 5760)
      (and (>= c 8192) (<= c 8202)) (= c 8232) (= c 8233) (= c 8239) (= c 8287) (= c 12288)))
(defn- ssh-width [c :i64] :i64 (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4))
;; the index after the leading whitespace
(defn- ssh-start [S :string] :i64
  (loop [i 0]
    (if (and (< i (string-length S)) (ssh-space? (string-code-point-at S i)))
      (recur (+ i (ssh-width (string-code-point-at S i)))) i)))
;; the 128 hexadecimal digits from i, or "" unless only whitespace follows them
(defn- ssh-tail-space? [S :string i :i64] :bool
  (loop [j i]
    (cond (= j (string-length S)) true
          (ssh-space? (string-code-point-at S j)) (recur (+ j (ssh-width (string-code-point-at S j))))
          :else false)))
(defn- ssh-hex [c :i64] :i64
  (cond (and (>= c 48) (<= c 57)) (- c 48)
        (and (>= c 97) (<= c 102)) (- c 87)
        (and (>= c 65) (<= c 70)) (- c 55) :else -1))
(defn- ssh-key? [S :string at :i64] :bool
  (and (<= (+ at 128) (string-length S))
       (loop [i 0]
         (cond (= i 128) true
               (< (ssh-hex (string-code-point-at S (+ at i))) 0) false
               :else (recur (inc i))))
       (ssh-tail-space? S (+ at 128))))
(defn- ssh-hexd [d :i64] :string (string-substring "0123456789abcdef" d (inc d)))
;; {0xhh,...} over the 32 bytes whose digits start at at
(defn- ssh-init [S :string at :i64] :string
  (loop [i 0 acc "{"]
    (if (= i 32) (string-concat acc "}")
      (recur (inc i)
        (string-concat acc
          (string-concat (if (= i 0) "0x" ",0x")
            (string-concat (ssh-hexd (ssh-hex (string-code-point-at S (+ at (* 2 i)))))
                           (ssh-hexd (ssh-hex (string-code-point-at S (+ at (inc (* 2 i)))))))))))))
(defn- seed-main [] :i64
  (if (not= (io-argc) 2)
    (let [w (io-err "usage: write-ssh-authorized-key-header.py <x||y hex> <output>\n")] 1)
    (let [path (io-arg 0) key (io-arg 1) at (ssh-start key)]
      (cond (not (ssh-key? key at))
            (let [w (io-err "authorized P-256 key must be exactly 128 hexadecimal characters (x||y)\n")] 1)
            (= (io-exists path) 1) (let [w (io-err "error: SSH header output exists\n")] 1)
            :else
            (let [text (string-concat "/* Generated public authorization material; contains no private key. */\n"
                         (string-concat "#ifndef AIUEOS_SSH_AUTHORIZED_KEY_H\n#define AIUEOS_SSH_AUTHORIZED_KEY_H\n"
                           (string-concat (string-concat "#define AIUEOS_SSH_AUTH_X_INITIALIZER " (ssh-init key at))
                             (string-concat (string-concat "\n#define AIUEOS_SSH_AUTH_Y_INITIALIZER " (ssh-init key (+ at 64)))
                               "\n#endif\n"))))
                  V (vector-i64-from-bytes (string-to-utf8 text))
                  n (vector-count V)
                  written (io-write-bytes V path 0 n)
                  B (io-read-bytes path)]
              (if (and (= written n) (= (vector-count B) n)
                       (loop [i 0]
                         (cond (= i n) true
                               (not= (vector-at B i) (vector-at V i)) false
                               :else (recur (inc i)))))
                0
                (let [w (io-err "error: SSH header readback differs\n")] 1)))))))
