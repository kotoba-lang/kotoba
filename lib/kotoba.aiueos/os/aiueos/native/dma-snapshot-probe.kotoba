(ns aiueos.native.dma-snapshot-probe
  (:require [aiueos.native.kernel :as kernel]
            [native.tcp-stream :as stream])
  (:export [main aiueos-isr-6]))

;; Component execution probe. Retain the complete kernel graph and callback,
;; but execute only the actual RX snapshot implementation. This is not a
;; complete OS boot or a physical NIC qualification.
(defn- retain-kernel [] :i64 (kernel/main))
(defn aiueos-isr-6 [vector :i64 error :i64 rip :i64 rsp :i64] :i64
  (kernel/aiueos-isr-6 vector error rip rsp))

(defn- fill-window [win offset end value]
  (if (= offset end) 1
    (let [stored (kernel-store-u8-16k win 16384 offset value)]
      (if (= (+ (kernel-load-u8-16k win 16384 offset) (* 0 stored)) value)
        (fill-window win (+ offset 1) end value) 0))))

(defn- fill-frame [frame offset value]
  (if (= offset 4096) 1
    (let [stored (kernel-store-u8-4k frame 4096 offset value)]
      (if (= (+ (kernel-load-u8-4k frame 4096 offset) (* 0 stored)) value)
        (fill-frame frame (+ offset 1) value) 0))))

(defn- matches [frame offset end value]
  (if (= offset end) 1
    (if (= (kernel-load-u8-4k frame 4096 offset) value)
      (matches frame (+ offset 1) end value) 0)))

(defn- check-case [win index value]
  (let [frame (kernel-owned-page 14) offset (+ 8192 (* index 2048))
        source (fill-window win offset (+ offset 2048) value)
        dirty (fill-frame frame 0 170)
        copied (stream/snapshot-rx-frame win index 2048)]
    (if (and (= source 1) (= dirty 1) (= copied 1)
             (= (matches frame 0 2048 value) 1)
             (= (matches frame 2048 4096 0) 1)) 1 0)))

(defn- unchanged [status]
  (let [frame (kernel-owned-page 14)]
    (if (and (= status 0) (= (matches frame 0 64 68) 1)
             (= (matches frame 64 4096 0) 1)) 1 0)))

(defn- note [receipt slot value]
  (let [stored (kernel-store-u64-4k receipt 4096 (* slot 8) value)]
    (if (= (+ (kernel-load-u64-4k receipt 4096 (* slot 8)) (* 0 stored)) value)
      value 0)))

(defn main [] :i64
  (let [win (kernel-owned-window 10 16384) receipt (kernel-owned-page 0)
        a (note receipt 0 (check-case win 0 17))
        b (note receipt 1 (check-case win 1 34))
        c (note receipt 2 (check-case win 2 51))
        d (note receipt 3 (check-case win 3 68))
        short (stream/snapshot-rx-frame win 3 64)
        frame (kernel-owned-page 14)
        short-ok (if (and (= short 1) (= (matches frame 0 64 68) 1)
                          (= (matches frame 64 4096 0) 1)) 1 0)
        e (note receipt 4 short-ok)
        f (note receipt 5 (unchanged (stream/snapshot-rx-frame win 4 64)))
        g (note receipt 6 (unchanged (stream/snapshot-rx-frame win 3 2049)))
        h (note receipt 7 (unchanged (stream/snapshot-rx-frame win 3 0)))
        i (note receipt 8 (unchanged (stream/snapshot-rx-frame win -1 64)))
        alias (kernel-owned-window 11 16384)
        j (note receipt 9 (unchanged (stream/snapshot-rx-frame alias 0 64)))]
    (if (and (= a 1) (= b 1) (= c 1) (= d 1) (= e 1)
             (= f 1) (= g 1) (= h 1) (= i 1) (= j 1)) 42 0)))
