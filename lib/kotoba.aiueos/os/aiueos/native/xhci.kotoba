            cleared (control 2 (setup-value 291 20 port 0) 0 0)
            connection (control 2 (setup-value 291 16 port 0) 0 0)]
        (do (hub-port-put port 1 status) (dp devices 0 0) (dp devices 16 0)
            (if (or (< status 0) (not (= cleared 1)) (not (= connection 1)) (not (= (recovery) 1)))
              (do (hub-port-put port 2 32) devices)
