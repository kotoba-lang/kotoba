                                (put 39 (+ (report-byte 0 7) (* (report-byte 0 8) 256)))
                                (put 40 (report-byte 0 9))
                                (put 41 (+ (report-byte 0 10) (* (report-byte 0 11) 256)))
                                (put 42 (+ (report-byte 0 12) (* (report-byte 0 13) 256)))
                                (let [result (rtl-rom)] (do (put 35 result) result))))))))))))))

;; Full LE transport: on this one-port, single-device radio only, output
;; contexts1/2 are unreferenced. 2048..4095 is private host state,4096..4607
;; event IN,4608..5119 ACL IN,5120..5631 ACL OUT,5632..6143 reserved.
;; Completed input-context8192..10303 may hold crypto workspace after the
;; final endpoint configuration. No NVMe/NIC/font/private-draft alias exists.
(defn ble-state [i] (if (and (>= i 0) (< i 2048)) (b (+ 2048 i)) 0))
