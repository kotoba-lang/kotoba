    (do (zero (+ 11520 (* d 64)) (+ 11584 (* d 64)))
        (mput 11648 opcode)
        (if (not (= (control d (setup-value request 0 index 3) 3 0) 1)) -1
          (do (arm d) (hci-wait d opcode expected 200))))))
