;; Explicit HCI identification only. Kind3 never becomes keyboard/mouse input.
;; The command is completed on EP0 before an event transfer is armed, so a
;; synchronous control wait cannot discard its interrupt completion. No ACL,
;; scan, connection, pairing, bond key or firmware-download command is sent.
(defn hci-head [d i acc]
