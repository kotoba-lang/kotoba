      (let [r (start-controller slot) next (if (= host 0) (find (+ slot 1)) -1)]
        (if (and (= r 15) (= (s 18) 0) (>= next 0))
          ;; Never point a second controller at memory still owned by a
          ;; running first controller. A failed halt stops the search.
          (if (= (halt-selected) 1)
            (start-from next (+ host 1)) (fail 4)) r))))
(defn start []
  (let [cleared (clear-state 0) slot (+ (find 0) (* cleared 0))]
    (if (< slot 0) (fail 1) (start-from slot 0))))

;; Signed debug operation, one host at a time. Invalid targets leave the
;; selected host intact. Clear only USB private state, below draft/NVMe1536.
;; This neither enables simultaneous-host input nor pairs Bluetooth devices.
(defn select-mode [slot bluetooth]
  (if (or (< slot 0) (> slot 65535)) -1
    (if (or (= (bit-and (pci slot 0) 65535) 65535)
            (not (= (u64-shift-right (pci slot 8) 8) 787248))) -1
      ;; A failed initialization requires PXE reboot, never speculative DMA reuse.
      (if (or (not (= (s 0) 15)) (< (s 4) 32) (> (s 4) 255)) -2
        (if (not (= (halt-selected) 1)) (fail 16)
          (do (clear-state 0) (put 32 1) (put 34 bluetooth) (start-controller slot)))))))
(defn select-controller [slot] (select-mode slot 0))

