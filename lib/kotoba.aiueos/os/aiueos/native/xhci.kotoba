    (let [request (if (= (ds 0 23) 224) 32 33) index (if (= request 32) 0 (ds 0 7))]
      (do (kernel-store-u8-16k (kernel-owned-window 0 16384) 16384 11648 (bit-and opcode 255))
          (kernel-store-u8-16k (kernel-owned-window 0 16384) 16384 11649 (quot opcode 256))
          (kernel-store-u8-16k (kernel-owned-window 0 16384) 16384 11650 n)
          (control 0 (setup-value request 0 index (+ n 3)) (+ n 3) 0)))))
