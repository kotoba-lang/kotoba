      (put 45 (report-byte d 0))
      (put 46 (+ (report-byte d 3) (* (report-byte d 4) 256)))
      (put 47 (report-length d))
      (if (= (hci/command-complete (hci-head d 0 0) (report-length d) opcode expected) 1) 1 -4)))
