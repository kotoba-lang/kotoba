                            (let [total (hub-at port speed devices)]
                              (do (port-put port 1 (reg off)) (port-put port 2 (ds 2 16))
                                  (ports (+ port 1) total)))))
                      (do (port-put port 1 (reg off))
                          (port-put port 2 (if (= (root-speed-admitted port speed) 1) (ds devices 16) 17))
                          (if (= ok 0) (disable-device devices) 0)
                          (ports (+ port 1) (+ devices ok))))))))))))
