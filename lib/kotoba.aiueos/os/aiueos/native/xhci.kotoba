        (put (+ 54 ch) at)
        (if (= idx 29)
          (do (trb (+ ring 480) (address ring) 0 (+ 6146 cyc))
              (dp 0 field 0) (dp 0 (+ field 1) (- 1 cyc)))
          (dp 0 field (+ idx 1)))
        (dma/release-fence) (rput (+ (s 5) (* (ds 0 0) 4)) ep) 1)))
