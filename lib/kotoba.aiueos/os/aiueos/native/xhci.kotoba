            (hub-scan (+ port 1) (hub-child port devices)))))))
(defn hub-at [root speed devices]
  (let [off (+ (s 4) (+ 1024 (* (- root 1) 16))) val (reg off)]
    (do (rput off (+ (bit-and val 3584) 16))
        (if (or (= (wait-reg off 18 2 2000000) 0) (not (= (recovery) 1)))
          (do (dp 2 16 33) devices)
          (if (= (enumerate 2 root speed 0 0) 1) (hub-scan 1 devices)
            (do (disable-device 2) devices))))))
(defn ports [port devices]
  (if (or (> port (s 8)) (>= devices 2)) devices
    (let [off (+ (s 4) (+ 1024 (* (- port 1) 16))) val (reg off)]
      (do (dp devices 0 0) (dp devices 16 0) (port-put port 0 val)
          (if (= (bit-and val 1) 0) (ports (+ port 1) devices)
            (do (rput off (+ (bit-and val 3584) 16))
                (if (= (wait-reg off 18 2 2000000) 0)
                  (do (port-put port 1 (reg off)) (port-put port 2 16) (ports (+ port 1) devices))
                  (let [speed (bit-and (quot (reg off) 1024) 15)
                        ok (if (= (root-speed-admitted port speed) 1)
                             (if (= (recovery) 1) (enumerate devices port speed 0 0) (enum-fail devices 12)) 0)]
                    (if (= ok 2)
