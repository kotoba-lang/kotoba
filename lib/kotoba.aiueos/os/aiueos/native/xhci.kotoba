    (if (= ready (+ d 1))
      (if (and (> fuel 0) (= (ds d 17) 0xb8500bda)
               (= (hci/ignorable-vendor (hci-head d 0 0) (report-length d)) 1))
        (do (arm d) (hci-wait d opcode expected (- fuel 1)))
        (hci-response d opcode expected))
      (if (= fuel 0) -3
        (if (not (= (recovery) 1)) -2 (hci-wait d opcode expected (- fuel 1)))))))
