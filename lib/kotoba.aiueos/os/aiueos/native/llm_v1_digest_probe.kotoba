(ns aiueos.native.llm-v1-digest-probe
  (:require [aiueos.native.kernel :as kernel]
            [aiueos.native.llm-v1-header :as header]
            [aiueos.sha256 :as sha])
  (:export [main aiueos-isr-6]))

;; Component-only proof that a canonical wire-11 request digest covers both
;; independently rooted 6 KiB text regions. This exceeds the ordinary SHA
;; entry's 12 KiB limit. It does not map a user region or dispatch a model.
(defn- retain-kernel [] :i64 (kernel/main))
(defn aiueos-isr-6 [vector :i64 error :i64 rip :i64 rsp :i64] :i64
  (kernel/aiueos-isr-6 vector error rip rsp))

(defn- put-word [page :i64 offset :i64 value :i64] :bool
  (let [written (kernel-store-u32-4k page 4096 offset value)]
    (= (+ (kernel-load-u32-4k page 4096 offset) (* 0 written)) value)))
(defn- put-byte [page :i64 offset :i64 value :i64] :bool
  (let [written (kernel-store-u8-4k page 4096 offset value)]
    (= (+ (kernel-load-u8-4k page 4096 offset) (* 0 written)) value)))
(defn- fill-window [window :i64 value :i64] :bool
  (loop [index 0]
    (if (= index 6144) true
      (let [written (kernel-store-u8-16k window 16384 index value)]
        (if (= (+ (kernel-load-u8-16k window 16384 index) (* 0 written)) value)
          (recur (+ index 1)) false)))))
(defn- clear-header [page :i64 offset :i64] :bool
  (if (= offset 64) true
    (and (put-word page offset 0) (clear-header page (+ offset 4)))))
(defn- setup-header [page :i64] :bool
  (and (clear-header page 0)
       (put-word page 0 827149387) (put-word page 4 1)
       (put-word page 8 11) (put-word page 12 6)
       (put-word page 16 6144) (put-word page 20 6144)
       (put-word page 24 16) (put-word page 28 0)
       (put-word page 32 12294) (put-word page 36 64)))
(defn- setup-model [page :i64] :bool
  (and (put-byte page 0 58) (put-byte page 1 108)
       (put-byte page 2 111) (put-byte page 3 99)
       (put-byte page 4 97) (put-byte page 5 108)))
(defn- note [page :i64 slot :i64 valid :bool] :bool
  (let [offset (* slot 8)
        value (if valid 1 0)
        written (kernel-store-u64-4k page 4096 offset value)]
    (and valid (= (+ (kernel-load-u64-4k page 4096 offset) (* 0 written)) 1))))
(defn- different? [a :i64 b :i64 index :i64] :bool
  (if (= index 32) false
    (or (not= (kernel-load-u8-4k a 4096 index)
              (kernel-load-u8-4k b 4096 index))
        (different? a b (+ index 1)))))
(defn- digest
  [h :i64 m :i64 s :i64 p :i64 out :i64 work :i64
   model-length :i64 output-length :i64] :i64
  (sha/aiueos-sha256-llm-request
   (kernel-subregion h 4096 0 64) 64
   (kernel-subregion m 4096 0 model-length) model-length
   (kernel-subregion s 16384 0 6144) 6144
   (kernel-subregion p 16384 0 6144) 6144
   (kernel-subregion out 4096 0 output-length) output-length
   (kernel-subregion work 4096 0 352) 352))

(defn main [] :i64
  (let [system (kernel-owned-window 0 16384)
        prompt (kernel-owned-window 4 16384)
        h (kernel-owned-page 8)
        m (kernel-owned-page 9)
        first (kernel-owned-page 10)
        work (kernel-owned-page 11)
        receipt (kernel-owned-page 12)
        changed (kernel-owned-page 13)
        legacy (kernel-owned-page 14)
        ready (and (setup-header h) (setup-model m)
                   (fill-window system 115) (fill-window prompt 112)
                   (= (header/aiueos-llm-v1-header-valid
                       (kernel-subregion h 4096 0 64) 64) 1))]
    (if (not ready) 0
      (let [legacy-valid
              (= (sha/aiueos-sha256
                  (kernel-subregion h 4096 0 64) 64
                  (kernel-subregion legacy 4096 0 32)
                  (kernel-subregion work 4096 0 352) 352) 1)
            a (note receipt 0 (= (digest h m system prompt first work 6 32) 1))
            altered (kernel-store-u8-16k prompt 16384 0 113)
            b (note receipt 1
                    (and (= (digest h m system prompt changed work 6 32) 1)
                         (different? first changed 0)))
            restored (kernel-store-u8-16k prompt 16384 0 112)
            wrong-header (put-word h 20 6143)
            c (note receipt 2
                    (= (digest h m system prompt changed work 6 32) 0))
            header-restored (put-word h 20 6144)
            d (note receipt 3
                    (= (digest h m system prompt changed work 513 32) 0))
            e (note receipt 4
                    (= (digest h m system prompt changed work 1 32) 0))
            f (note receipt 5
                    (= (digest h m system prompt changed work 6 31) 0))]
        (if (and legacy-valid a b c d e f (= altered 113) (= restored 112)
                 wrong-header header-restored) 42 0)))))
