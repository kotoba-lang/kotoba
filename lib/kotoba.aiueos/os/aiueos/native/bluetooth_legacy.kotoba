(ns aiueos.native.bluetooth-legacy
  ;; Core Vol3 H 2.2.3/4: LE Legacy Passkey only. All inputs/outputs wire LE.
  ;; TK336, Na448, Nb464, confirm480, STK/LTK496. No Just Works path.
  ;; Exact preq1984/pres1992, types704/711, addresses144/352. Scratch544..655.
  (:require [aiueos.native.xhci :as usb] [aiueos.native.bluetooth-le :as le])
  (:export [vector-data c1 s1 layout-check self-check]))
(defn b [i] (usb/ble-state i))
(defn p [i v] (usb/ble-put i (bit-and v 255)))
(defn fill [dst n v] (if (= n 0) 1 (do (p dst v) (fill (+ dst 1) (- n 1) v))))
(defn copy [src dst n] (if (= n 0) 1 (do (p dst (b src)) (copy (+ src 1) (+ dst 1) (- n 1)))))
(defn aes-params [key plain i]
  (if (= i 16) 1
    (do (usb/ble-param i (b (+ key i))) (usb/ble-param (+ 16 i) (b (+ plain i))) (aes-params key plain (+ i 1)))))
(defn aes-out [dst i]
  (if (= i 16) 1 (do (p (+ dst i) (le/packet (+ 6 i))) (aes-out dst (+ i 1)))))
(defn aes [key plain dst]
  (do (aes-params key plain 0) (if (= (le/command 8215 32 22) 1) (aes-out dst 0) 0)))
(defn p1-byte [i]
  (if (= i 0) (b 704) (if (= i 1) (b 711) (if (< i 9) (b (+ 1982 i)) (b (+ 1983 i))))))
(defn p2-byte [i]
  (if (< i 6) (b (+ 352 i)) (if (< i 12) (b (+ 138 i)) 0)))
(defn xor-p [src which i]
  (if (= i 16) 1
    (do (p (+ 544 i) (bit-xor (b (+ src i)) (if (= which 1) (p1-byte i) (p2-byte i))))
        (xor-p src which (+ i 1)))))
(defn c1 [nonce dst]
  (do (xor-p nonce 1 0)
      (if (not (= (aes 336 544 640) 1)) 0
        (do (xor-p 640 2 0) (aes 336 544 dst)))))
(defn s1 [responder initiator dst]
  (do (copy initiator 544 8) (copy responder 552 8) (aes 336 544 dst)))
(defn equal [a c n diff]
  (if (= n 0) (if (= diff 0) 1 0)
    (equal (+ a 1) (+ c 1) (- n 1) (bit-or diff (bit-xor (b a) (b c))))))
(defn vector-preq [i]
  (if (or (< i 0) (>= i 7)) 0
    (bit-and (u64-shift-right (case (quot i 8) 0 1978090137846017 0) (* (mod i 8) 8)) 255)))
(defn vector-pres [i]
  (if (or (< i 0) (>= i 7)) 0
    (bit-and (u64-shift-right (case (quot i 8) 0 1407409243292418 0) (* (mod i 8) 8)) 255)))
(defn vector-nonce [i]
  (if (or (< i 0) (>= i 16)) 0
    (bit-and (u64-shift-right (case (quot i 8) 0 7172025625877688032 1 6306118242413670158 0) (* (mod i 8) 8)) 255)))
(defn vector-c1 [i]
  (if (or (< i 0) (>= i 16)) 0
    (bit-and (u64-shift-right (case (quot i 8) 0 -3267557492926628986 1 2170242368442829034 0) (* (mod i 8) 8)) 255)))
(defn vector-r1 [i]
  (if (or (< i 0) (>= i 16)) 0
    (bit-and (u64-shift-right (case (quot i 8) 0 1234605616436508552 1 4237573850073609 0) (* (mod i 8) 8)) 255)))
(defn vector-r2 [i]
  (if (or (< i 0) (>= i 16)) 0
    (bit-and (u64-shift-right (case (quot i 8) 0 -7373874951294615808 1 72623859790382856 0) (* (mod i 8) 8)) 255)))
(defn vector-s1 [i]
  (if (or (< i 0) (>= i 16)) 0
    (bit-and (u64-shift-right (case (quot i 8) 0 6575843344531693666 1 -7340900442778307429 0) (* (mod i 8) 8)) 255)))
(defn vector-p1 [i]
  (if (or (< i 0) (>= i 16)) 0
    (bit-and (u64-shift-right (case (quot i 8) 0 508906757909708801 1 360296766282859015 0) (* (mod i 8) 8)) 255)))
(defn vector-p2 [i]
  (if (or (< i 0) (>= i 16)) 0
    (bit-and (u64-shift-right (case (quot i 8) 0 -6510320830240213578 1 2711790500 0) (* (mod i 8) 8)) 255)))
(defn vector-data [which i]
  (case which 0 (vector-preq i) 1 (vector-pres i) 2 (vector-nonce i) 3 (vector-c1 i) 4 (vector-r1 i) 5 (vector-r2 i) 6 (vector-s1 i) 7 (vector-p1 i) 8 (vector-p2 i) 0))
(defn stage [which dst n i]
  (if (= i n) 1
    (do (p (+ dst i) (case which 0 (vector-preq i) 1 (vector-pres i) 2 (vector-nonce i)
         3 (vector-c1 i) 4 (vector-r1 i) 5 (vector-r2 i) 6 (vector-s1 i) 7 (vector-p1 i) (vector-p2 i)))
        (stage which dst n (+ i 1)))))
(defn vector-addresses [i]
  (if (= i 6) 1 (do (p (+ 144 i) (- 166 i)) (p (+ 352 i) (- 182 i)) (vector-addresses (+ i 1)))))
(defn setup []
  (do (copy 144 2024 6) (copy 352 2030 6) (p 2036 (b 704)) (p 2037 (b 711))
      (vector-addresses 0) (p 704 1) (p 711 0) (stage 0 1984 7 0) (stage 1 1992 7 0) (fill 336 16 0)))
(defn restore []
  (do (copy 2024 144 6) (copy 2030 352 6) (p 704 (b 2036)) (p 711 (b 2037))
      (fill 2024 16 0) (fill 336 16 0) (fill 448 80 0) (fill 544 160 0) (fill 1984 16 0) 1))
(defn layout-loop [i diff]
  (if (= i 16) (if (= diff 0) 1 0)
    (layout-loop (+ i 1) (bit-or diff (bit-or (bit-xor (p1-byte i) (vector-p1 i))
                                                   (bit-xor (p2-byte i) (vector-p2 i)))))))
(defn layout-check [] (do (setup) (let [ok (layout-loop 0 0)] (do (restore) ok))))
(defn self-check []
  (do (setup) (stage 2 448 16 0) (stage 3 464 16 0)
      (let [a (if (= (c1 448 496) 1) (equal 496 464 16 0) 0)]
        (do (p 448 (bit-xor (b 448) 1))
            (let [c (if (= (c1 448 496) 1) (- 1 (equal 496 464 16 0)) 0)]
              (do (stage 4 448 16 0) (stage 5 464 16 0) (stage 6 480 16 0)
                  (let [d (if (= (s1 448 464 496) 1) (equal 496 480 16 0) 0)]
                    (do (restore) (+ a (* c 2) (* d 4))))))))))
