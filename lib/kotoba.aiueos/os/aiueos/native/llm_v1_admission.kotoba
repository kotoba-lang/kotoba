(ns aiueos.native.llm-v1-admission
  (:require [aiueos.native.llm-v1-header :as header]
            [aiueos.native.llm-v1-request-shape :as request]
            [aiueos.native.llm-v1-ticket :as ticket])
  (:export [aiueos-llm-v1-consume-current]))

;; Host-owned 4 KiB admission page: ticket 0..71, magic at 72, grant at 80,
;; remaining output tokens at 88, domain/process/generation/model IDs at
;; 96/104/112/120, fresh digest at 128..159 and SHA workspace at 160..511.
;; The host must fill this page from trusted state, copy each request region
;; into a stable private snapshot, and keep those exact bytes for dispatch.
;; This component grants no capability, chooses no model and dispatches none.
(def ADMISSION-MAGIC 0x3148414c)

(defn- separate-regions? [a :i64 a-bytes :i64 b :i64 b-bytes :i64] :bool
  (and (> a 0) (> b 0) (>= a-bytes 0) (>= b-bytes 0)
       (if (< a b)
         (>= (- b a) (if (= a-bytes 0) 1 a-bytes))
         (>= (- a b) (if (= b-bytes 0) 1 b-bytes)))))

(defn- revoke [state :i64 index :i64] :bool
  (if (= index 9) true
    (let [written (kernel-store-u64 state 72 (* index 8) 0)
          zero? (= (+ (kernel-load-u64 state 72 (* index 8)) (* 0 written)) 0)
          rest-clear? (revoke state (+ index 1))]
      (and zero? rest-clear?))))

(defn aiueos-llm-v1-consume-current
  [wire-header :i64 wire-header-bytes :i64
   model :i64 model-bytes :i64
   system :i64 system-bytes :i64
   prompt :i64 prompt-bytes :i64
   selected-model :i64 selected-model-bytes :i64
   result :i64 result-bytes :i64
   host-page :i64 host-page-bytes :i64] :i64
  (if (not= host-page-bytes 4096) 0
    (let [state (kernel-subregion host-page host-page-bytes 0 72)
          digest (kernel-subregion host-page host-page-bytes 128 32)
          workspace (kernel-subregion host-page host-page-bytes 160 352)
          admitted
            (and (= (kernel-load-u64-4k host-page host-page-bytes 72) ADMISSION-MAGIC)
                 (= (kernel-load-u64-4k host-page host-page-bytes 80) 1)
                 (> (kernel-load-u64-4k host-page host-page-bytes 96) 0)
                 (> (kernel-load-u64-4k host-page host-page-bytes 104) 0)
                 (> (kernel-load-u64-4k host-page host-page-bytes 112) 0)
                 (> (kernel-load-u64-4k host-page host-page-bytes 120) 0)
                 (= (header/aiueos-llm-v1-header-valid
                      wire-header wire-header-bytes) 1)
                 (>= (kernel-load-u64-4k host-page host-page-bytes 88)
                     (kernel-load-u32 wire-header wire-header-bytes 24))
                 (separate-regions? host-page host-page-bytes
                                    wire-header wire-header-bytes)
                 (separate-regions? host-page host-page-bytes model model-bytes)
                 (separate-regions? host-page host-page-bytes system system-bytes)
                 (separate-regions? host-page host-page-bytes prompt prompt-bytes)
                 (separate-regions? host-page host-page-bytes
                                    selected-model selected-model-bytes)
                 (separate-regions? host-page host-page-bytes result result-bytes)
                 (= (request/aiueos-llm-v1-request-digest-valid
                      wire-header wire-header-bytes model model-bytes
                      system system-bytes prompt prompt-bytes
                      selected-model selected-model-bytes result result-bytes
                      digest 32 workspace 352) 1))]
      (if admitted
        (ticket/aiueos-llm-v1-ticket-consume
          state 72
          (kernel-load-u64-4k host-page host-page-bytes 96)
          (kernel-load-u64-4k host-page host-page-bytes 104)
          (kernel-load-u64-4k host-page host-page-bytes 112)
          (kernel-load-u64-4k host-page host-page-bytes 120)
          digest 32)
        (if (revoke state 0) 0 0)))))
