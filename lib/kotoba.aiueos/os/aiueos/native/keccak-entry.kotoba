(ns aiueos.native.keccak-entry
  (:require [aiueos.native.desktop :as desktop]
            [aiueos.value-runtime-entry :as runtime]
            [aiueos.value-runtime-syscall-plan :as syscall]
            [aiueos.value-runtime-domain :as domain]
            [aiueos.value-runtime-capability-table :as capability]
            [aiueos.value-runtime-provider-policy :as provider]
            [aiueos.value-runtime-provider-transport :as transport]
            [aiueos.value-runtime-cas-verify :as cas]
            [aiueos.keccak :refer [kc-init kc-absorb kc-finish kc-squeeze]])
  (:export [main aiueos-value-runtime-entry aiueos-value-runtime-syscall-plan
            aiueos-value-runtime-publish-domain aiueos-value-runtime-provider-status
            aiueos-value-runtime-capability-grant aiueos-value-runtime-provider-claim
            aiueos-value-runtime-provider-complete aiueos-value-runtime-cas-verify]))

;; Kernel-v3 owns the controlled fault shim. Keep the actual desktop and
;; eight ValueRuntime exports, without the unused diagnostic kernel graph.
(defn aiueos-value-runtime-entry [a :i64 p :i64 u :i64 r :i64 c :i64] :i64
  (runtime/aiueos-value-runtime-entry a p u r c))
(defn aiueos-value-runtime-syscall-plan [n :i64 d :i64 p :i64 i :i64 s :i64] :i64
  (syscall/aiueos-value-runtime-syscall-plan n d p i s))
(defn aiueos-value-runtime-publish-domain [d :i64] :i64
  (domain/aiueos-value-runtime-publish-domain d))
(defn aiueos-value-runtime-provider-status [g :i64 a :i64] :i64
  (provider/aiueos-value-runtime-provider-status g a))
(defn aiueos-value-runtime-capability-grant [a :i64 s :i64 g :i64 r :i64 o :i64] :i64
  (provider/aiueos-value-runtime-capability-grant a s g r o))
(defn aiueos-value-runtime-provider-claim [] :i64
  (transport/aiueos-value-runtime-provider-claim))
(defn aiueos-value-runtime-provider-complete [t :i64 r :i64 b :i64 n :i64 d :i64] :i64
  (transport/aiueos-value-runtime-provider-complete t r b n d))
(defn aiueos-value-runtime-cas-verify [b :i64 n :i64 e :i64 o :i64 w :i64] :i64
  (cas/aiueos-value-runtime-cas-verify b n e o w))
;; W3b slice (ADR-0277): before the desktop starts the kernel hashes three messages with
;; aiueos.keccak and leaves the outputs in the browser context for the QEMU gate:
;; "abc" (words 320..335), the 112-byte FIPS 180-4 two-block message (words 336..351) and
;; "abd" (words 352..367, the negative control: it must differ from "abc"). Word 99 is the
;; marker, written last. Nothing is signed; no key exists yet.
;; JUN-813 stage 1 (ADR-0286): the kernel runs the region-based Keccak sponge before the desktop starts. Messages sit in the
;; browser context at byte 1024, the sponge state at byte 4096 (a 4096-byte window). Outputs: SHAKE128("") 32 bytes at byte 1280,
;; SHAKE256("abc") 64 bytes at 1344, SHAKE128 of a 200-byte message squeezed to 400 bytes at 1408 (it crosses the 168-byte rate
;; in both directions). Word 99 is the marker, written last.
(defn put8 [ctx at v] (kernel-store-u8 (kernel-subregion ctx 8192 at 1) 1 0 v))
(defn get8 [ctx at] (kernel-load-u8 (kernel-subregion ctx 8192 at 1) 1 0))

(defn fill-message [ctx i n kind]
  (if (>= i n) 0
    (fill-message ctx (+ i 1 (* 0 (put8 ctx (+ 1024 i)
                                       (if (= kind 1) (case i 0 97 1 98 2 99 0) (mod (+ (* i 7) 3) 256))))) n kind)))
(defn absorb-message [ctx i n]
  (if (>= i n) 1
    (absorb-message ctx (+ i 1 (* 0 (kc-absorb (kernel-subregion ctx 8192 4096 4096) 4096 (get8 ctx (+ 1024 i))))) n)))
(defn squeeze-out [ctx out i n]
  (if (>= i n) 1
    (squeeze-out ctx out (+ i 1 (* 0 (put8 ctx (+ out i) (kc-squeeze (kernel-subregion ctx 8192 4096 4096) 4096)))) n)))
(defn run-shake [ctx rate kind n out outn]
  (let [f (fill-message ctx 0 n kind)
        i (kc-init (kernel-subregion ctx 8192 4096 4096) 4096 rate)
        a (absorb-message ctx 0 n)
        d (kc-finish (kernel-subregion ctx 8192 4096 4096) 4096 31)
        q (squeeze-out ctx out 0 outn)]
    (+ i (* 0 (+ f (+ a (+ d q)))))))

(defn put-result [ctx i value]
  (kernel-store-u32 (kernel-subregion ctx 8192 (* i 4) 4) 4 0 value))

(defn keccak-selftest []
  (let [ctx (kernel-browser-context)
        r0 (run-shake ctx 168 1 0 1280 32)
        r1 (run-shake ctx 136 1 3 1344 64)
        r2 (run-shake ctx 168 2 200 1408 400)]
    (put-result ctx 99 (+ 1262694449 (* 0 (+ r0 (+ r1 r2)))))))

(defn main [] :i64
  (let [width (kernel-framebuffer-width)
        registered (kernel-register-value-domain 73)
        published (kernel-publish-current-domain 73)
        enabled (kernel-value-enable-user)]
    (if (and (> width 0) (> registered 0) (= published 73) (= enabled 1))
      (do (keccak-selftest) (desktop/goal-model-main)) 0)))
