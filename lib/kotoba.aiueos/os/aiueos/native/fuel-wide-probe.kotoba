(ns aiueos.native.fuel-wide-probe
  ;; fuel64: a budget nobody has spent past is a number, not a bound.
  ;;
  ;; kotoba-native ADR 0078 widened the object replenish and kotoba-kir ADR
  ;; 0268 set the ceiling at 2^53-1. Between them, byte goldens on two runtimes
  ;; say the right bytes are emitted and a KIR test says a budget past 2^31 is
  ;; carried rather than truncated. Neither is a claim about a CPU. This is.
  ;;
  ;; It spends 2,200,000,013 fuel -- past 2^31 = 2,147,483,648 -- out of a
  ;; sealed budget of 2,500,000,000, and returns. Under the ceilings that stood
  ;; on 2026-09-02 that budget could not exist: `kotoba.verifier` admitted at
  ;; most 1,048,576, so the compile would have been refused before any machine
  ;; saw it.
  ;;
  ;; THE MARKERS ARE THE MEASUREMENT, not decoration. One character is written
  ;; to the 0xe9 debug console after each stage, so the console says how far a
  ;; run got even when it does not finish -- which is the whole point on a host
  ;; where the only x86-64 available is TCG. QEMU appends to the log file as it
  ;; goes, so a run in progress can be watched.
  ;;
  ;;   F   entered main
  ;;   1   +100,000,001    cumulative      100,000,003
  ;;   2   +400,000,001    cumulative      500,000,005
  ;;   3   +1,000,000,001  cumulative    1,500,000,007
  ;;   4   +700,000,001    cumulative    2,200,000,009   <- past 2^31
  ;;   O   the four burns each returned 0
  ;;
  ;; then exit status 33 (16 << 1 | 1) through isa-debug-exit at 0xf4.
  ;;
  ;; THE CONTROL IS A SECOND IMAGE AT A SMALLER BUDGET. `smoke-qemu-fuel64.cljs`
  ;; compiles this same source twice: once at 2,500,000,000 (enough) and once
  ;; at 2,000,000,000 (not enough, and below 2^31 as well). The second must
  ;; print `F123` and then take vector 6 at the prologue `ud2` -- it must NOT
  ;; print `4`. Without it, "the run finished" would be equally consistent with
  ;; a guard that never fires, and a fuel bound whose guard never fires is not
  ;; a bound at all.
  ;;
  ;; WHY A COUNTDOWN AND NOT SOMETHING USEFUL. The charge is one unit per
  ;; function entry, and on x86-64 a self-tail call keeps its charge (unlike
  ;; the KIR interpreter's `__kotoba_loop_*` trampoline, which is deliberately
  ;; zero-charge, and unlike the AArch64 bulk pre-charge, which prepays a
  ;; proven countdown in one subtraction). So on this backend a self-recursive
  ;; countdown of N really executes N `dec qword [r9+8]`, which is exactly the
  ;; thing that has never been done past 2^31.
  (:export [main]))

;; A direct self-tail call. `kotoba.native.x86-64` turns it into a jump at the
;; frame baseline and emits the entry fuel charge on the recur edge, so this
;; costs one unit per iteration and a constant amount of stack.
(defn burn [n :i64] :i64
  (if (<= n 0) 0 (burn (- n 1))))

(defn main [] :i64
  (let [start (kernel-out-u8 233 70)          ; F
        b1 (burn 100000000)
        m1 (kernel-out-u8 233 (if (= b1 0) 49 88))   ; 1 / X
        b2 (burn 400000000)
        m2 (kernel-out-u8 233 (if (= b2 0) 50 88))   ; 2 / X
        b3 (burn 1000000000)
        m3 (kernel-out-u8 233 (if (= b3 0) 51 88))   ; 3 / X
        b4 (burn 700000000)
        m4 (kernel-out-u8 233 (if (= b4 0) 52 88))   ; 4 / X
        done (kernel-out-u8 233 79)]                 ; O
    ;; `(* 0 ...)` keeps every marker and every burn on the live path without
    ;; changing the status, the same idiom `store-answer-qemu.kotoba` uses.
    (kernel-out-u32 244
      (+ 16 (* 0 (+ start (+ m1 (+ m2 (+ m3 (+ m4 done))))))))))
