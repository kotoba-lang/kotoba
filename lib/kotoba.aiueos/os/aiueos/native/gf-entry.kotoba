(ns aiueos.native.gf-entry
  (:require [aiueos.native.desktop :as desktop]
            [aiueos.value-runtime-entry :as runtime]
            [aiueos.value-runtime-syscall-plan :as syscall]
            [aiueos.value-runtime-domain :as domain]
            [aiueos.value-runtime-capability-table :as capability]
            [aiueos.value-runtime-provider-policy :as provider]
            [aiueos.value-runtime-provider-transport :as transport]
            [aiueos.value-runtime-cas-verify :as cas]
            [aiueos.gf25519 :as gf])
  (:export [main aiueos-value-runtime-entry aiueos-value-runtime-syscall-plan
            aiueos-value-runtime-publish-domain aiueos-value-runtime-provider-status
            aiueos-value-runtime-capability-grant aiueos-value-runtime-provider-claim
            aiueos-value-runtime-provider-complete aiueos-value-runtime-cas-verify]))

;; Kernel-v3 owns the controlled fault shim. Keep the actual desktop and
;; eight ValueRuntime exports, without the unused diagnostic kernel graph.
(defn aiueos-value-runtime-entry [a :i64 p :i64 u :i64 r :i64 c :i64] :i64
  (runtime/aiueos-value-runtime-entry a p u r c))
(defn aiueos-value-runtime-syscall-plan [n :i64 d :i64 p :i64 i :i64 s :i64] :i64
  (syscall/aiueos-value-runtime-syscall-plan n d p i s))
(defn aiueos-value-runtime-publish-domain [d :i64] :i64
  (domain/aiueos-value-runtime-publish-domain d))
(defn aiueos-value-runtime-provider-status [g :i64 a :i64] :i64
  (provider/aiueos-value-runtime-provider-status g a))
(defn aiueos-value-runtime-capability-grant [a :i64 s :i64 g :i64 r :i64 o :i64] :i64
  (provider/aiueos-value-runtime-capability-grant a s g r o))
(defn aiueos-value-runtime-provider-claim [] :i64
  (transport/aiueos-value-runtime-provider-claim))
(defn aiueos-value-runtime-provider-complete [t :i64 r :i64 b :i64 n :i64 d :i64] :i64
  (transport/aiueos-value-runtime-provider-complete t r b n d))
(defn aiueos-value-runtime-cas-verify [b :i64 n :i64 e :i64 o :i64 w :i64] :i64
  (cas/aiueos-value-runtime-cas-verify b n e o w))
;; W3c slice (ADR-0277): before the desktop starts the kernel runs aiueos.gf25519 on three
;; (a, b) pairs and leaves a*b, inv(a), a+b and a-b (32 bytes each, canonical little-endian) in the
;; browser context, 128 bytes per case from word 320, for the QEMU gate. Word 99 is the marker,
;; written last. No key, no point arithmetic, no signature yet.
(defn vec-flat [i]
  (case i 0 255 1 102 2 85 3 68 4 51 5 34 6 17 7 0 8 33 9 67 10 101 11 135 12 169 13 203 14 237 15 15 16 239 17 205 18 171 19 137 20 103 21 69 22 35 23 1 24 136 25 121 26 106 27 91 28 76 29 61 30 46 31 31 32 153 33 136 34 119 35 102 36 85 37 68 38 51 39 34 40 17 41 0 42 255 43 238 44 221 45 204 46 187 47 170 48 33 49 67 50 101 51 135 52 169 53 203 54 237 55 15 56 16 57 50 58 84 59 118 60 152 61 186 62 220 63 126 64 236 65 255 66 255 67 255 68 255 69 255 70 255 71 255 72 255 73 255 74 255 75 255 76 255 77 255 78 255 79 255 80 255 81 255 82 255 83 255 84 255 85 255 86 255 87 255 88 255 89 255 90 255 91 255 92 255 93 255 94 255 95 127 96 236 97 255 98 255 99 255 100 255 101 255 102 255 103 255 104 255 105 255 106 255 107 255 108 255 109 255 110 255 111 255 112 255 113 255 114 255 115 255 116 255 117 255 118 255 119 255 120 255 121 255 122 255 123 255 124 255 125 255 126 255 127 127 128 1 129 0 130 0 131 0 132 0 133 0 134 0 135 0 136 0 137 0 138 0 139 0 140 0 141 0 142 0 143 0 144 0 145 0 146 0 147 0 148 0 149 0 150 0 151 0 152 0 153 0 154 0 155 0 156 0 157 0 158 0 159 0 160 0 161 0 162 0 163 0 164 0 165 0 166 0 167 0 168 0 169 0 170 0 171 0 172 0 173 0 174 0 175 0 176 0 177 0 178 0 179 0 180 0 181 0 182 0 183 0 184 0 185 0 186 0 187 0 188 0 189 0 190 0 191 64 0))

(defn put8 [ctx at v] (kernel-store-u8 (kernel-subregion ctx 8192 at 1) 1 0 v))

(defn fill-vec [ctx k i]
  (if (>= i 32) 0
    (let [x (put8 ctx (+ 1024 i) (vec-flat (+ (* k 64) i)))
          y (put8 ctx (+ 1056 i) (vec-flat (+ (* k 64) (+ 32 i))))]
      (fill-vec ctx k (+ i (+ 1 (* 0 (+ x y))))))))

;; Self-test body (it lives here, not in aiueos.gf25519, so that the library has no entry whose region
;; arguments the compiler cannot trace when another profile links it): a*b, inv(a), a+b, a-b into a
;; 128-byte output (32 bytes each, canonical little-endian). Workspace words: a at 0, b at 16, results 32..80.
(defn byte-at [bytes i] (kernel-load-u8 bytes 32 i))
(defn unpack-loop [ws o bytes i]
  (if (= i 16) 1
    (let [s (gf/st ws (+ o i) (+ (byte-at bytes (* 2 i)) (i64-shift-left (byte-at bytes (+ (* 2 i) 1)) 8)))]
      (unpack-loop ws o bytes (+ i 1 (* 0 s))))))
(defn gf-unpack [ws o bytes]
  (let [u (unpack-loop ws o bytes 0)
        top (gf/st ws (+ o 15) (bit-and (gf/ld ws (+ o 15)) 32767))]
    (+ 1 (* 0 (+ u top)))))

(defn gf-self [a :i64 b :i64 out :i64 ws :i64] :i64
  (let [s (kernel-subregion ws 4096 0 4096)
        ua (gf-unpack s 0 a)
        ub (gf-unpack s 16 b)
        m (gf/gf-mul s 32 0 16)
        v (gf/gf-inv s 48 0)
        ad (gf/gf-add s 64 0 16 0)
        sb (gf/gf-sub s 80 0 16 0)
        p0 (gf/gf-pack s out 0 32)
        p1 (gf/gf-pack s out 32 48)
        p2 (gf/gf-pack s out 64 64)
        p3 (gf/gf-pack s out 96 80)]
    (+ 1 (* 0 (+ ua (+ ub (+ m (+ v (+ ad (+ sb (+ p0 (+ p1 (+ p2 p3)))))))))))))

(defn run-case [ctx k]
  (let [f (fill-vec ctx k 0)]
    (+ 1 (* 0 (+ f (gf-self
                     (kernel-subregion ctx 8192 1024 32) (kernel-subregion ctx 8192 1056 32)
                     (kernel-subregion ctx 8192 (+ 1280 (* k 128)) 128)
                     (kernel-subregion ctx 8192 4096 4096)))))))

(defn put-result [ctx i value]
  (kernel-store-u32 (kernel-subregion ctx 8192 (* i 4) 4) 4 0 value))

(defn gf-selftest []
  (let [ctx (kernel-browser-context)
        r0 (run-case ctx 0)
        r1 (run-case ctx 1)
        r2 (run-case ctx 2)]
    (put-result ctx 99 (+ 1195782709 (* 0 (+ r0 (+ r1 r2)))))))

(defn main [] :i64
  ;; Consent gate image (ADR-0275 W1): the goal-model profile, whose Itonami Enter
  ;; opens the consent surface. The root explicitly selects the image's private GOP/Browser profile.
  ;; PCI/GOP/font sealing happens before any Kotoba body receives a region.
  (let [width (kernel-framebuffer-width)
        registered (kernel-register-value-domain 73)
        published (kernel-publish-current-domain 73)
        enabled (kernel-value-enable-user)]
    (if (and (> width 0) (> registered 0) (= published 73) (= enabled 1))
      (do (gf-selftest) (desktop/goal-model-main)) 0)))
