(ns aiueos.native.itonami-local-model-user-v3
  (:export [main]))

;; The selfhost user-v3 target emits one bounded request to AIUEOS syscall5.
;; It derives the input from the OS-filled Goal region and has no network,
;; storage, generic syscall or ambient capability.
(defn main [request :i64 request-bytes :i64] :i64
  (kernel-local-model-call request request-bytes))
