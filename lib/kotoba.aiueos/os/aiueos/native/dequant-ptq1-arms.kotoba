(ns aiueos.native.dequant-ptq1-arms
  (:export [dot-ptq1-0]))

;; granted regions x dequant, PTQ1_0 (kotoba-native ADR 0088): the fused
;; dequantize-and-dot of Prism's group-128 ternary over two regions the caller
;; granted. Same five-word ABI and reason as amu's `granted-region-dequant` fixture:
;; both bases are parameters, so the program never names an address. What it
;; is for is running ONE instruction's two arms on two machines -- the AVX2 arm
;; where cpuid says AVX2, the legacy arm where it does not -- and comparing
;; each with `kotoba.kir`.

(defn dot-ptq1-0 [wbase :i64 wlen :i64 xbase :i64 xlen :i64 blocks :i64]
  (kernel-dequant-dot-ptq1-0 wbase wlen xbase xlen blocks))
