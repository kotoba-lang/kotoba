(ns aiueos.native.usb-update-probe
  (:require [aiueos.native.remote-cmd :as remote]
            [aiueos.native.xhci :as usb]
            [aiueos.native.update :as update] [aiueos.native.esp :as esp]
            [aiueos.ed25519 :as ed])
  (:export [run]))
(defn run [] :i64
  (let [irq (kernel-cli) width (kernel-framebuffer-width) ctx (kernel-browser-context)]
    (do (p ctx 86 6) (p ctx 87 0)
        (remote/init ctx 0) (remote/poll ctx 0) (remote/nonce ctx) (remote/rx-stats ctx) (update/qemu-hook ctx)
        (esp/state-file ctx) (esp/create-state ctx)
        (ed/aiueos-ed25519-pubkey (kernel-subregion ctx 8192 3712 32)
          (kernel-subregion ctx 8192 1280 128) (kernel-subregion ctx 8192 4096 4096)
          (kernel-subregion ctx 8192 1088 64))
        (ed/aiueos-ed25519-sign (kernel-subregion ctx 8192 2048 1024) 32
          (kernel-subregion ctx 8192 3072 64) (kernel-subregion ctx 8192 4096 4096))
        (let [absent (remote/run-update ctx 0) initial (usb/start)
              seeded (prime ctx 0) ran (remote/run-update ctx 0)
              kept (retained ctx 0) resumed (usb/result)
              count (usb/devices) modal (p ctx 87 2)
              refused (remote/run-update ctx 0)]
          (do (p ctx 74 (+ (if (= absent 0) 1 0)
                          (if (and (= initial 15) (= count 2)) 2 0)
                          (if (and (= ran 1) (= (w ctx 188) 7)) 4 0)
                          (if (= kept 1) 8 0)
                          (if (and (= resumed 15) (= count 2)) 16 0)
                          (if (and (= refused 0) (= (usb/result) 15)
                                   (= (retained ctx 0) 1)) 32 0)))
              (p ctx 75 (+ seeded (* 0 (+ irq width modal))))
              (p ctx 79 1) (poll-input ctx))))))

(defn w [ctx i] (kernel-load-u32 (kernel-subregion ctx 8192 (* i 4) 4) 4 0))
(defn p [ctx i v] (kernel-store-u32 (kernel-subregion ctx 8192 (* i 4) 4) 4 0 v))
(defn pattern [i] (bit-and (+ 0x5a37d129 (* i 37)) 4294967295))
(defn prime [ctx i]
  (if (>= i 256) 1
    (do (p ctx (+ 768 i) (pattern i)) (prime ctx (+ i 1)))))
(defn retained [ctx i]
  (if (>= i 256) 1
    (if (not (= (w ctx (+ 768 i)) (pattern i))) 0 (retained ctx (+ i 1)))))
(defn poll-input [ctx] :i64
  (let [r (usb/poll)]
    (do (if (> r 0)
          (let [d (- r 1)]
            (do (if (and (= (usb/report-kind d) 1) (= (usb/next-key d 2) 30))
                  (p ctx 74 (bit-or (w ctx 74) 64)) 0)
                (if (and (= (usb/report-kind d) 2) (= (usb/report-byte d 1) 20)
                         (= (usb/report-byte d 2) 10))
                  (p ctx 74 (bit-or (w ctx 74) 128)) 0)
                (usb/acknowledge d))) 0)
        (kernel-pause) (poll-input ctx))))
