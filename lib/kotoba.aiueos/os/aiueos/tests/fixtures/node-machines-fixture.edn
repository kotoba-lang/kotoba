;; A registry for the test suite to drive, so the suite does not depend on the
;; live contract's DATA.
;;
;; Why this exists: the first version of test-node-installer pointed at
;; contracts/node-machines-v1.edn itself. That suite went red the moment a real
;; box was measured and its fields stopped being :unverified -- seven cases,
;; all of them asserting a premise ("nobody has measured this box") that the
;; contract is supposed to stop being true of. A test that breaks when the
;; system it guards does its job is testing the wrong thing.
;;
;; So the behaviour cases drive this file, and only the cases that are ABOUT the
;; live contract -- its format, its provenance vocabulary, that it still knows
;; the machines -- read the real one.
;;
;; The two machine ids match the real registry's on purpose: the driver's
;; unknown-machine refusal prints the known ids, and the test pins that text.
{:format :aiueos.node-machines/v1
 :provenance
 {:measured     "read off this machine, by a named command, on a named date"
  :owner-stated "the owner said so; nobody has read it off the box"
  :unverified   "nobody has looked. Not absent, not false -- unmeasured."}
 :defaults
 {:endpoint         "https://murakumo.cloud"
  :username         "aiueos"
  :ubuntu-codename  "noble"
  :iso-architecture :amd64
  :storage          :interactive}
 :required
 {:always   [:hostname :ssh-key]
  :for-unattended-storage [:disk-serial]}
 :machines
 {:amd-6600hs
  {:hostname "aiueos-6600hs"
   :facts
   {:cpu {:value "AMD Ryzen 5 FIXTURE" :provenance :owner-stated :on "2026-09-10"
          ;; FIXTURE-COMMENT-SENTINEL: a per-fact note that a whole-map rewrite
          ;; would delete. One case asserts this exact string survives.
          :same-silicon-as :gmktec-k16}
    :board       {:value nil :provenance :unverified}
    :nic         {:value nil :provenance :unverified
                  :measure-by "the hw-record the install itself writes"}
    :disk-model  {:value nil :provenance :unverified}
    :disk-serial {:value nil :provenance :unverified
                  :measure-by "lsblk -dno NAME,SERIAL,MODEL,SIZE at the box"}
    :nic-count   {:value nil :provenance :unverified}}}
  :gmktec-k16
  {:hostname "aiueos-k16-ubuntu"
   :facts
   {:cpu         {:value "AMD Ryzen 7 7735HS" :provenance :measured :on "2026-09-08"}
    :nic         {:value "Realtek RTL8125B" :provenance :measured :on "2026-08-31"}
    :disk-serial {:value nil :provenance :unverified}}}}}
