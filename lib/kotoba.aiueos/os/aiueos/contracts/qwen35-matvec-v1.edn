;; The declaration kotoba-native's `kernel-object-entries` transcribes, in both
;; `elf64.clj` and `elf64.cljc`.
{:format :aiueos.qwen35-matvec/v1
 :graph {:root aiueos.qwen35-matvec
         :modules [aiueos.qwen35-matvec aiueos.lib.qwen35-dequant-core
                   aiueos.lib.qwen35-grids]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_matvec"
          :imports []
          :required-operations [kernel-load-u8 kernel-load-u32 kernel-store-u32
                                kernel-subregion f32-add f32-sub f32-mul
                                f32-from-bits f32-to-bits i64-to-f32-rounded
                                kernel-dequant-dot-ptq1-0]}
 :arguments [:arena :arena-length :plan :plan-length]

 ;; ONE ARENA, ONE PLAN, AND WHY.
 ;; `kernel-subregion` requires its BASE to be a parameter, a literal or
 ;; `kernel-boot-info`, so weights, input, output and row scratch would need
 ;; four bases and four lengths against an ABI that admits five arguments.
 ;; The caller puts all four in one region and describes them in a 96-byte
 ;; plan; an OFFSET may be computed, and the offsets are 64-bit because the
 ;; model mapping is 10,934,860,704 bytes and a u32 slot would silently
 ;; truncate every tensor past 4 GiB.
 ;;
 ;; Input, output and scratch LENGTHS are derived (cols*4, rows*4, cols*4)
 ;; rather than carried, so the plan cannot state a length that disagrees with
 ;; the count it also states.

 :plan {:bytes 96
        :qtype {:offset 0 :width 4}
        :reserved-0 {:offset 4 :width 4 :must-be 0}
        :rows {:offset 8 :width 8}
        :cols {:offset 16 :width 8}
        :weights-offset {:offset 24 :width 8}
        :weights-bytes {:offset 32 :width 8}
        :input-offset {:offset 40 :width 8}
        :output-offset {:offset 48 :width 8}
        :scratch-offset {:offset 56 :width 8}
        :first-row {:offset 64 :width 8 :inclusive true}
        :end-row {:offset 72 :width 8 :exclusive true}
        :reserved-80 {:offset 80 :width 8 :must-be 0}
        :reserved-88 {:offset 88 :width 8 :must-be 0}}

 ;; THE WORK CEILING IS WHAT MAKES THE FUEL BOUND FINITE.
 ;; 2,097,152 multiply-accumulates per call. A single K16 matvec is larger --
 ;; `ffn_gate` is 17,408 rows of 5,120, 89 million -- so the C chunks, and the
 ;; row range is how a chunk is expressed. It is also how the C's SMP split is
 ;; expressed: `matvec` hands the AP [split, output_count) and keeps
 ;; [0, split). A fuel bound that moved with the tensor would not be a bound,
 ;; and an object that trapped partway through a matrix would leave the output
 ;; half written with no way to tell which half.

 :result {:kind :reason-code :admit 0 :range [-12 -1] :truthy-is-success false}
 :reasons {0 :done
           -1 :null-arena
           -2 :null-plan
           -3 :plan-length-is-not-96
           -4 :a-reserved-slot-is-non-zero
           -5 :type-not-one-of-the-fifteen-ggml-types
           -6 :cols-outside-1-65536-or-not-a-multiple-of-the-block
           -7 :rows-outside-1-1048576
           -8 :weights-bytes-is-not-rows-times-the-row-byte-count
           -9 :row-range-is-not-0-first-end-rows
           -10 :work-above-the-2097152-element-ceiling
           -11 :a-region-runs-past-the-arena
           -12 :a-row-dequantised-to-a-refusal}

 ;; -12 cannot fire. The type is proved by -5, the column count and its block
 ;; multiple by -6, and the row byte count by -8, which together are exactly
 ;; the three things `dequant-run` could refuse. It is kept because deleting a
 ;; check to make a reason reachable is the wrong direction, and declared here
 ;; so the every-reason floor does not have to be weakened to accommodate it.
 :unreachable-by-construction [-12]

 :verification {:node-stack-size 4000
                :fuel 400000000
                :memory {:base 4096 :image-bytes 16384 :arena-offset 0}
                :floors {:minimum-vectors 23
                         :minimum-memory-assertions 5
                         :every-reachable-reason-observed true}}
 :vectors
