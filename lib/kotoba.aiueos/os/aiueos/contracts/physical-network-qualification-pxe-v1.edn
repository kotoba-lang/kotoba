;; Diskless K16 RTL8125 qualification after native-core success.
{:format :aiueos.physical-network-qualification-pxe/v1
 :depends-on :aiueos.physical-qualification-pxe/v1
 :target {:model :gmktec-k16
          :nic {:vendor 0x10ec :device 0x8125}
          :client-ip "10.77.0.10"
          :peer-ip "10.77.0.1"}
 :driver {:mode :uefi-pxe-handoff
          :firmware-phy-calibration :retained
          :rings {:tx 1 :rx 1}
          :interrupts :masked-polling
          :frame :arp-request-reply}
 :success {:uefi-nvram {:state 1 :code 8125}
           :requires [:supported-hardware-revision
                      :valid-unicast-device-mac
                      :link-up
                      :tx-owned-then-complete
                      :rx-owned-then-complete
                      :admitted-arp-reply-from-10.77.0.1]}
 :failure {:uefi-nvram {:state 2 :code-base 8200}
           :bounded? true}
 :safety {:internal-disk-writes? false
          :usb-runtime-writes? false
          :boot-order-writes? false
          :dma-isolation :amd-ivrs-unimplemented-test-only}
 :evidence {:model-smoke "os/aiueos/scripts/smoke-rtl8125-handoff.sh"
            :physical-state :unverified}
 :does-not-prove [:amd-iommu-isolation
                  :dhcp
                  :dns
                  :tls13
                  :murakumo-heartbeat
                  :inference]}
