;; Operator-owned compatibility enrollment after a request-bound K16 hello.
;; The service token remains on the Mac relay and is never sent to or embedded
;; in AIUEOS. The node is deliberately not ready until it completes real work.
{:format :aiueos.murakumo-relay-enrollment/v1
 :depends-on :aiueos.physical-relay-qualification-pxe/v1
 :trigger {:message :AIUEOS_NODE_HELLO_V1
           :requires [:same-boot-nonce :expected-k16-mac]
           :deduplicate-by :boot-nonce}
 :control-plane {:api "https://api.murakumo.cloud"
                 :enroll {:method :post :path "/infer/nodes"
                          :accepted-status #{200 201}}
                 :heartbeat {:method :post
                             :path "/infer/nodes/gmktec-k16/heartbeat"
                             :accepted-status #{201}}
                 :authorization :operator-service-token-on-mac-relay}
 :identity {:required-format :did-key
            :current-custody :mac-relay
            :target-custody :k16-persistent-device-key}
 :reported-state {:node/tier :native
                  :node/connect :mac-relay
                  :node/needs-relay? true
                  :node/ready? false
                  :withheld-until-real-work [:node/model :node/capacity]}
 :safety {:service-token-in-efi? false
          :service-token-on-wire-to-k16? false
          :internal-disk-writes? false}
 :evidence {:server-selftest "os/aiueos/tools/k16-pxe-server.py --selftest"
            :live-control-plane :unverified
            :physical-k16 :unverified}
 :does-not-prove [:device-owned-persistent-key
                  :ready-capacity
                  :job-claim
                  :inference
                  :result-return
                  :heartbeat-renewal
                  :reboot-recovery]}
