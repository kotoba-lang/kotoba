;; The declaration kotoba-native's `kernel-object-entries` transcribes, in both
;; `elf64.clj` and `elf64.cljc`.
{:format :aiueos.qwen35-norm/v1
 :graph {:root aiueos.qwen35-norm
         :modules [aiueos.qwen35-norm]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_norm"
          :imports []
          :required-operations [kernel-load-u32 kernel-store-u32 kernel-subregion
                                f32-add f32-mul f32-div f32-abs f32-sqrt f32-gt
                                f32-from-bits f32-to-bits f32-to-f64-exact
                                f64-add f64-mul f64-div f64-from-bits f64-to-bits
                                f64-to-f32-rounded i64-to-f64-rounded bit-and]}
 :arguments [:mode :a :b :c :d]

 ;; THE ACCUMULATOR IS f64 AND THE PRODUCT IS f32.
 ;; All three reduce `sum += (double)(v[i] * v[i])`: the SQUARE is binary32
 ;; and is then widened. Squaring in f64 would be more accurate and would
 ;; disagree with the C on most inputs.
 ;;
 ;; The two reductions narrow at DIFFERENT POINTS, and that is a difference in
 ;; the answer rather than in the spelling:
 ;;
 ;;   rms_norm        (float)(sum / (double)count) + EPSILON   divide, then cast
 ;;   l2_norm_heads   (float)sum + EPSILON                     cast, then add

 ;; MODE 3 IS MODE 2 WITHOUT THE REFUSALS AND THE FALLBACK (aiueos ADR-0222).
 ;; `linear_attention`'s output norm: the same per-head weighted RMS, but its
 ;; C takes a non-finite square into the sum (scale 0, the head comes out as
 ;; signed zeros) where mode 2 would rescale or refuse. The overflowing-square
 ;; vector is the input the two disagree on. Expectations are printed by
 ;; tests/qwen35_linear_output_norm_oracle.c, the loop as it stood in the C.

 ;; MODE 2 HAS A SECOND PATH. `rms_norm_heads_weighted` rescales by the head's
 ;; largest magnitude when a square overflows binary32, and folds EPSILON by
 ;; the same factor. It is here because it is in the C: dropping it would turn
 ;; an input the C handles into a refusal.

 :result {:kind :reason-code :admit 0 :range [-8 -1] :truthy-is-success false}
 :reasons {0 :done
           -1 :null-a
           -2 :mode-outside-0-3
           -3 :count-or-width-outside-1-65536
           -4 :heads-outside-1-4096-or-heads-times-width-above-262144
           -5 :a-modes-second-region-is-null
           -6 :mode-2-a-value-was-already-non-finite
           -7 :mode-2-the-computed-scale-was-non-finite
           -8 :mode-2-a-scaled-result-was-non-finite}
 :modes {0 :rms-norm 1 :l2-norm-heads 2 :rms-norm-heads-weighted
         3 :linear-output-norm}

 ;; -6, -7 and -8 need a non-finite input or an overflowing scale, which the
 ;; vectors below do not construct: every probe is a finite binary32 built
 ;; from a bounded mantissa and a bounded exponent. They are NOT declared
 ;; unreachable -- they are reachable, and the C reaches them -- they are
 ;; unobserved, and the floor says so rather than being weakened.
 :unobserved-reasons [-6 -7 -8]

 :verification {:node-stack-size 4000
                :fuel 400000000
                :memory {:base 4096 :image-bytes 4096
                         :a-offset 0 :b-offset 1024 :out-offset 2048}
                :floors {:minimum-vectors 8
                         :minimum-memory-assertions 6}}
 :vectors
 [
