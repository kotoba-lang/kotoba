;; K16 OS updates are signed release transactions, never a git checkout pull.
{:format :aiueos.os-update/v1
 :target {:architecture "x86_64"
          :machine "gmktec-k16"
          :minimum-aiueos-abi 4}
 :authority {:decision [:grant.publisher :grant.ota :grant.update]
             :root :threshold-release-root
             :threshold-minimum 2
             :revocation :bitstring-status-list
             :anti-rollback :monotonic-release-sequence
             :anti-freeze :fresh-timestamp}
 :distribution {:transport :https
                :origin "https://ipfs.kotobase.net/ipfs/{cid}"
                :objects :immutable-content-addressed
                :repository-pull? false}
 :artifacts {:required [:loader :kernel :initramfs]
             :admission [:exact-bytes :sha256 :target :minimum-abi]}
 :slots {:layout :two-os-slot
         :write :inactive-only
         :write-order [:inactive-data :flush :full-readback
                       :inactive-header :flush-and-readback]
         :selector :after-full-verification
         :trial-boots 1
         :partial-slot-bootable? false}
 :health {:required [:boot :storage :direct-https :murakumo-node]
          :unknown :wait-bounded
          :failure :rollback
          :timeout-ms 120000
          :success :commit-candidate}
 :recovery {:previous-slot-preserved-until :commit
            :offline :keep-running-last-known-good
            :recovery-usb :independent}
 :current-evidence {:decision-and-negative-tests :implemented
                    :immutable-https-fetch-plan :implemented
                    :host-release-image-primary-recovery :implemented
                    :bare-metal-k16-https-artifact-fetch :not-yet-implemented
                    :bare-metal-k16-os-slot-writer :not-yet-implemented
                    :physical-k16-update :unverified}
 :never [:git-pull-on-device :write-active-slot :activate-before-readback
         :commit-on-unknown-health :treat-pxe-tftp-as-authenticated-update
         :rollback-os-for-runtime-inference-failure]}
