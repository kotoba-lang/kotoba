;; Companion to kotoba-native kernel-object-entries `aiueos-browser-reduce`
;; (guest browser desktop input, ADR-0223).
;;
;; One canonical event, reduced the way kotoba-lang/browser reduces it:
;; pointer/down -> browser.input/window-at (topmost first, inclusive
;; point-in-rect) -> :window/focus -> browser.surface/focus-window (focus AND
;; raise to the end of :surface/windows). A miss is no action. A key goes to
;; the focused window and moves nothing. Same 128-byte state as
;; browser-frame-v1. Every success vector asserts the whole state after the
;; call, so a raise that forgets to shift, or focuses without raising, fails.
;;
;; Pointer capture (ADR-0229): a press in a titlebar captures a drag in words
;; 25..28, pointer/move moves the captured window to (point - offset),
;; pointer/up clears it. The success vectors -- seeds, answers and whole
;; states -- are printed by os/aiueos/scripts/browser-reduce-oracle.cljk from
;; kotoba-lang/browser's browser.input and browser.surface, and `--check`
;; compares them with this file. The one named difference: a move below the
;; origin is refused (-6) where browser.surface would store it.
;;
;; Resize capture (ADR-0230): a press in the 16 px resize handle captures a
;; resize (words 25..30: kind 2, id, press point, size at the press);
;; pointer/move sets the size to the press size plus the pointer's travel,
;; clamped at 120 x 80 (browser.input's `max`), with the origin unchanged.
;;
;; Launcher and close (ADR-0233): word 31 is the app register (bit k-1 = app
;; k). With it not 0, a press on a window's close control (x + w - 24 ..
;; x + w - 8, y + 6 .. y + 22, windows at least 40 wide) is
;; browser.surface/close-window -- the focus goes to the window now on top
;; only if the closed one had it -- and a press on no window inside launcher
;; button k (x 6 + 102(k-1) .. + 96, y 2 .. 26) is browser.surface/launch-app
;; with open-window's default rect (80, 80, 520, 360). Both clear the capture.
;; The geometry is the kernel's (the oracle has none); the oracle script
;; writes it apart from the object and applies browser.surface's actions.
;; Printed differences: one window per app (a launch of an open app raises
;; it), the last window stays (-8), a default rect past the viewport is
;; refused (-9).
;;
;; Window focus by id (ADR-0237): kind 5 is browser.surface's :window/focus
;; applied to the id in a -- the action Alt+Tab becomes once the key object
;; (browser-ime-v2) has chosen the window. Focus and raise as a press does,
;; capture and app register untouched; an id not in the stack changes nothing
;; and answers 0 (focus-window's no-op). Printed by the oracle script like the
;; vectors above.
;;
;; Wheel scroll (ADR-0238): kinds 6 and 7 are browser.input's :pointer/wheel
;; at (a, b), one notch toward the body's end (delta-y +20) or its start
;; (-20). The window under the pointer (window-at, topmost first) scrolls:
;; browser.surface scroll-window, the offset clamped at 0; nothing is focused,
;; raised or captured; a miss scrolls nothing and answers 0. The offsets live
;; in surface words 2040..2043 (window id 1..4), so these vectors pass the
;; whole 8192-byte surface (state-bytes 8192) and assert bytes 8160..8175 as
;; well as the state. Printed by the oracle script. Printed differences: an
;; offset past 65535 is refused (-12); a wheel on the 128-byte state is -10;
;; a hit window whose id has no offset word (outside 1..4) is -11 -- the last
;; two written here by hand, the oracle has neither.
{:format :aiueos.browser-reduce/v1
 :entry aiueos-browser-reduce
 :graph {:root aiueos.browser-reduce
         :modules [aiueos.browser-reduce]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_browser_reduce"
          :imports []
          :required-operations [kernel-load-u32 kernel-store-u32 kernel-subregion]}
 :arguments [:state :state-bytes :kind :a :b]
 :kinds {1 :pointer/down 2 :keyboard/key 3 :pointer/move 4 :pointer/up 5 :window/focus
         6 :pointer/wheel-toward-the-end 7 :pointer/wheel-toward-the-start}
 :result {:kind :window-id-or-reason :miss 0 :range [-12 -1]}
 :reasons {-1 :null-region-or-state-bytes-not-128-or-8192
           -2 :abi-or-window-count-outside-1-4
           -3 :focus-is-not-a-window
           -4 :capture-is-not-none-or-a-drag-or-resize-of-a-window
           -5 :unknown-event-kind
           -6 :move-would-put-the-origin-below-0
           -7 :app-register-past-app-4
           -8 :close-of-the-last-window
           -9 :launch-default-rect-leaves-the-viewport
           -10 :wheel-on-the-128-byte-state
           -11 :wheel-hit-a-window-id-outside-1-4
           -12 :scroll-offset-would-pass-65535}
 :mirrors {:hit "browser.input/window-at"
           :focus "browser.surface/focus-window"
           :capture "browser.input actions-for-event :pointer/down :drag / :resize, :pointer/up"
           :move "browser.input :pointer/move under :drag -> browser.surface/move-window"
           :resize "browser.input :pointer/move under :resize -> browser.surface/resize-window"
           :key "browser.input :keyboard/key on the focused window"
           :launch "browser.surface/launch-app (open-window's default rect) behind the kernel's launcher geometry"
           :close "browser.surface/close-window behind the kernel's close-control geometry"
           :wheel "browser.input :pointer/wheel -> browser.surface/scroll-window (one notch = 20 px, vertical only)"}
 :trusts-caller-for [:no-text-edit :one-window-per-app :the-last-window-stays
                     :one-notch-is-one-line :vertical-only :scroll-ceiling-65535]
 :verification {:node-stack-size 4000
                :fuel 1024
                :memory {:base 4096 :image-bytes 8192
                         :regions {:state 0 :ops 256}}
                :floors {:minimum-vectors 63
                         :minimum-memory-assertions 53
                         :every-reachable-reason-observed true}}
