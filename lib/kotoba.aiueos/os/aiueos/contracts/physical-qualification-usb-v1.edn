;; K16 stage-one physical qualification.  This is deliberately not the SSD
;; installer contract: the only target is the removable USB itself and the
;; native core stops before any block driver can issue a write.
{:format :aiueos.physical-qualification-usb/v1
 :machine-profile :gmktec-k16-ryzen-7-7735hs
 :architecture :x86_64
 :boot-order
 [{:stage :uefi-read-only-hardware-probe
   :exits-boot-services? false
   :observes [:cpu-vendor-family-model
              :gop-visible-stripe
              :uefi-memory-map
              :acpi-rsdp
              :pci-inventory
              :pci-display-network-storage-nvme-class-counts
              :uefi-block-handle-counts]
   :disk-writes :none
   :terminal-marker "AIUEOS_HW_PROBE_DONE exit_boot_services=no disk_writes=none"}
  {:stage :native-core-read-only
   :enters [:aiueos-loader :aiueos-kernel]
   :proves [:loader-kernel-initramfs-integrity
            :kotoba-native-object-execution
            :kernel-owned-paging
            :gop-framebuffer-write-readback
            :physical-page-allocation
            :acpi-madt-admission]
   :stops-before [:iommu :pci-dma :block-driver :network-driver :ssd-install]
   :disk-writes :none
   :success-screen ["AIUEOS K16" "NATIVE CORE OK" "READ ONLY"]
   :terminal-marker
   "AIUEOS_PHYSICAL_QUALIFICATION_OK native-core-v1 disk-writes=none"}]
 :safety {:internal-disk-write-code-reached? false
          :target-selection :none
          :ssd-install :separate-later-operation
          :secure-boot :must-be-disabled-for-unsigned-development-image}
 :does-not-qualify [:amd-iommu
                    :nvme-read
                    :nvme-write
                    :rtl8125-link
                    :wired-dhcp
                    :radeon-native-gpu-driver
                    :murakumo-inference
                    :ssd-boot]
 :ssd-install-gate
 {:requires [:green-native-core-screen
             :photographed-or-transcribed-hardware-probe
             :k16-driver-gap-review
             :exact-internal-ssd-identity
             :fresh-owner-confirmation]
  :current-state :closed}}
