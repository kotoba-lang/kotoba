;; Companion to kotoba-native kernel-object-entries `aiueos-ime-commit`
;; (guest IME, ADR-0090).
{:format :aiueos.ime-commit/v1
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_ime_commit"
          :imports []}
 :arguments [:latin-a :latin-b]

 ;; Unicode codepoint of committed kana, or 0 refuse.
 :result {:kind :value
          :kana-codepoint :i64
          :refuse 0}

 :vectors {:k-then-a :u+304b
           :k-then-i :u+304d
           :a-alone :u+3042
           :latin-echo :refuse}

 :trusts-caller-for [:virtio-input-not-synthetic
                     :native-phase6-compositor]
 :verification {:off-target :impossible
                :reason :kir-refuses-kernel-memory
                :evidence "nbb --classpath src scripts/compositor-guest.cljk guest-ime"}
}
