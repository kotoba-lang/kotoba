;; The declaration kotoba-native's `kernel-object-entries` transcribes, in both
;; `elf64.clj` and `elf64.cljc`.
{:format :aiueos.qwen35-attention/v1
 :graph {:root aiueos.qwen35-attention
         :modules [aiueos.qwen35-attention]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_attention"
          :imports []
          :required-operations [kernel-load-u32 kernel-store-u32
                                kernel-load-u64 kernel-store-u64 kernel-subregion
                                f32-add f32-sub f32-mul f32-div f32-neg
                                f32-ge f32-le f32-gt f32-from-bits f32-to-bits
                                f32-to-f64-exact f64-to-f32-rounded
                                f64-add f64-sub f64-mul f64-eq f64-le f64-ge f64-gt
                                f64-from-bits f64-to-bits i64-to-f32-rounded
                                bit-and bit-or quot]}
 :arguments [:arena :arena-bytes :plan :plan-bytes]

 ;; The arithmetic of `full_attention` (`kernel/qwen35_infer.c:684`):
 ;;
 ;;   0  de-interleave       out[h*D + i] = qg[h*2D + i]                 (:707)
 ;;   1  cached softmax      the whole `if (decode->position)` head loop (:733)
 ;;   2  position zero       out[h*D+i] = value[vh*D+i] * sigmoid(gate)  (:791)

 ;; NOT HERE, and neither omission is schedule. `rope_heads` cannot be ported:
 ;; on x86-64 the C's sine and cosine are the x87 `fsincos` INSTRUCTION, Amu
 ;; emits no x87, and there is no polynomial to transcribe because the C is not
 ;; using one. The KV cache write, its FNV hash and `resolved_cached_key`
 ;; (:542) stay in C because they are custody -- a hash, a shadow copy and a
 ;; repair -- not arithmetic; this object reads the cache the C has already
 ;; resolved, which is what that function returns on every path that does not
 ;; fail. `rms_norm_heads_weighted` is `aiueos-qwen35-norm` and the four
 ;; projections are `aiueos-qwen35-matvec`.

 ;; THE SCORE ACCUMULATES IN f64 AND IN FOUR LANES. `stable_attention_score`
 ;; (:115) widens each binary32 factor to binary64 and reduces
 ;; `(sum0 + sum1) + (sum2 + sum3)` -- `dot_scalar`'s tree, not `dot_avx2`'s.
 ;; The softmax exponent and the denominator then stay binary32. A port that
 ;; reduced left to right, or that kept the products in binary32, agrees on
 ;; small inputs and diverges on the spread of magnitudes below.

 ;; THE GATE TEMPORARY IS NOT PORTED, and that is a proof rather than a guess.
 ;; The C stages each head's gate in `scratch_b[FULL_GATE_TEMP_OFFSET..]`
 ;; before writing the output. The output cannot reach it: head `h`'s output
 ;; occupies `[h*D, (h+1)*D)` and its gate begins at `h*2D + D`, and
 ;; `h*2D + D >= (h+1)*D` for every `h >= 0`, with equality only at `h = 0`.

 ;; THE HEAD DIMENSION IS 256 AND THE KV WIDTH 1024, as requirements and not
 ;; defaults: the interleave stride is `2*D`, the gate of head `h` sits at
 ;; `h*2D + D`, the four-lane score has no tail only because `D` is a multiple
 ;; of four, and a cache row is `kv-width * 4` bytes. The tail loop of
 ;; `stable_attention_score` (:126) is therefore NOT ported -- at `D = 256` it
 ;; runs zero times.

 :result {:kind :reason-code :admit 0 :range [-13 -1] :truthy-is-success false}
 :reasons {0 :done
           -1 :null-arena
           -2 :null-plan
           -3 :plan-length-is-not-96
           -4 :a-slot-this-mode-does-not-use-is-non-zero
           -5 :mode-outside-0-2
           -6 :heads-outside-1-64
           -7 :head-dimension-is-not-256
           -8 :kv-width-is-not-1024-or-group-outside-1-heads
           -9 :position-outside-1-7
           -10 :a-region-runs-past-the-arena
           -11 :a-query-was-non-finite
           -12 :a-key-or-a-score-was-non-finite
           -13 :the-denominator-was-not-positive-or-not-finite}
 :modes {0 :de-interleave 1 :cached-softmax 2 :position-zero}

 ;; -11, -12 and -13 need a non-finite input or a softmax whose weights all
 ;; underflow, which the vectors below do not construct: every probe is a
 ;; finite binary32 built from a bounded mantissa and a bounded exponent. They
 ;; are NOT declared unreachable -- they are reachable, and the C reaches them
 ;; through `finite_values` and `stable_attention_score` -- they are
 ;; unobserved, and the floor says so rather than being weakened.
 :unobserved-reasons [-11 -12 -13]

 ;; MEASURED, not chosen: mode 1 walks 256 elements per head inside a per-head
 ;; and a per-prior recursion, and the `kotoba.kir` interpreter recurses once
 ;; per Kotoba call with no tail-call elimination. Run this one as
 ;;   ulimit -s 65520
 ;;   node --stack-size=60000 "$(command -v nbb)" --classpath ... <this file>
 :verification {:node-stack-size 60000
                :fuel 400000000
                :memory {:base 4096 :image-bytes 45056
                         :arena-offset 0 :arena-bytes 40960 :plan-offset 40960
                         :qg 0 :out 8192 :query 12288
                         :key 16384 :value 24576 :scratch 32768}
                :floors {:minimum-vectors 12
                         :minimum-memory-assertions 3}}
 :vectors
 [
  {:name :deinterleave-2-heads, :mode 0, :heads 2,
   :qg-hex "",
   :expect-out-hex "",
   :expected 0}
  {:name :softmax-2-heads-position-1, :mode 1, :heads 2, :group 1, :position 1,
   :qg-hex "",
   :query-hex "",
   :key-hex "",
   :value-hex "",
   :expect-qg-hex "",
   :expected 0}
  {:name :position-zero-4-heads-group-2, :mode 2, :heads 4, :group 2,
   :qg-hex "",
   :value-hex "",
   :expect-out-hex "",
   :expected 0}

  ;; The refusals. Each moves exactly one thing away from a plan that works.
  {:name :null-arena, :mode 0, :heads 2, :arena-override 0, :expected -1}
  {:name :null-plan, :mode 0, :heads 2, :plan-base-override 0, :expected -2}
  {:name :plan-length-97, :mode 0, :heads 2, :plan-length 97, :expected -3}
  {:name :mode-0-with-a-scratch-slot-set, :mode 0, :heads 2,
   :plan-override {88 1}, :expected -4}
  {:name :mode-1-with-an-output-slot-set, :mode 1, :heads 2, :group 1, :position 1,
   :plan-override {24 8192}, :expected -4}
  {:name :mode-three, :mode 2, :heads 2, :group 1, :plan-override {0 3}, :expected -5}
  {:name :heads-zero, :mode 0, :heads 0, :expected -6}
  {:name :heads-65, :mode 0, :heads 65, :expected -6}
  {:name :head-dimension-128, :mode 0, :heads 2, :plan-override {16 128}, :expected -7}
  {:name :kv-width-512, :mode 1, :heads 2, :group 1, :position 1,
   :plan-override {64 512}, :expected -8}
  {:name :group-zero, :mode 1, :heads 2, :group 0, :position 1, :expected -8}
  {:name :group-above-heads, :mode 2, :heads 2, :group 3, :expected -8}
  {:name :position-zero-in-mode-one, :mode 1, :heads 2, :group 1, :position 0,
   :expected -9}
  {:name :position-eight, :mode 1, :heads 2, :group 1, :position 8, :expected -9}
  ;; 64 heads is 131,072 bytes of interleaved query/gate against a 40,960-byte
  ;; arena. The head count itself is admitted; the region is not.
  {:name :sixty-four-heads-do-not-fit, :mode 0, :heads 64, :expected -10}
 ]}
