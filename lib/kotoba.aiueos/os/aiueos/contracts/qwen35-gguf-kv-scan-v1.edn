{:format :aiueos.qwen35-gguf-kv-scan/v1
 :graph {:root aiueos.qwen35-gguf-kv-scan
         :modules [aiueos.qwen35-gguf-kv-scan]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_gguf_kv_scan"
          :imports []
          :required-operations [kernel-load-u8 kernel-load-u32 kernel-store-u32 kernel-subregion]}
 :arguments [:base :accessible :plan :plan-length]

 ;; ADR-0222 stage A item 3: the Bonsai profile of the metadata admission.
 ;; The Qwen3.8 profile keeps its JVM parity test
 ;; (test/aiueos/qwen35_gguf_kv_scan_parity_test.cljk, fixture built from the
 ;; contract constants, 128-byte workspace pinned in
 ;; tests/fixtures/qwen35-kv-plan.bin); this contract drives the object over
 ;; the REAL Bonsai header in the KIR oracle.
 ;;
 ;; THE IMAGE IS A FILE, NOT HEX. The metadata section is 11,070,652 bytes --
 ;; 248,320 real token strings and 247,587 merges -- and the image used is
 ;; the artifact's first 11,120,992 bytes (through the tensor table, so the
 ;; same file serves `aiueos-qwen35-tensor-table-bind`). It is not committed
 ;; (`tests/fixtures/large/` is ignored); it is the public file's prefix and
 ;; is refetched by HTTP range:
 ;;
 ;;   curl -sL -r 0-11120991 -o os/aiueos/tests/fixtures/large/bonsai2-ptq1-header-11120992.bin \
 ;;     https://huggingface.co/prism-ml/Ternary-Bonsai-2-27B-gguf/resolve/main/Ternary-Bonsai-2-27B-PTQ1_0.gguf
 ;;
 ;; The verifier REFUSES (could-not-run) when the file is absent or its sha256
 ;; is not the one pinned here -- a contract whose fixture is missing must not
 ;; read as green. Patches are applied to the in-memory copy per vector.
 ;;
 ;; MEASURED 2026-09-22 on this workstation (nbb, one core): the 15 vectors
 ;; take ~32 minutes (1,895,891 ms on the first source, 1,918,210 ms on this
 ;; one through `run-task.cljk bonsai-admission-contracts`), of which four are full walks of the 495,907 strings
 ;; (the admitted case and the three refusals that sit after the tokenizer
 ;; arrays: padding token, file type, and the window that ends inside the
 ;; merges) at ~7 minutes each; the other eleven refuse within the first
 ;; 130 KB and cost seconds. A gate that runs this belongs on a tick, not a
 ;; hook.
 ;;
 ;; THE EXPECTED WORKSPACE was computed independently (python over the same
 ;; header: slot semantics per the object's own table, offsets by parsing the
 ;; GGUF), not copied from a run of the object.

 :result {:kind :reason-code :admit 0 :range [-240 -1] :truthy-is-success false}
 :reasons {0 :admitted -1 :null-base -2 :null-workspace -3 :workspace-not-the-profile-s-length
           -4 :window-below-header -5 :magic -6 :version -7 :tensor-count-names-no-profile
           -8 :pair-count-not-the-profile-s -9 :key-past-window -10 :value-past-window
           -11 :unknown-value-did-not-skip -13 :required-keys-not-all-present
           -14 :metadata-end-not-the-profile-s
           -51 :contract-scalar-at-slot-4 -70 :contract-scalar-at-slot-80 -74 :contract-scalar-at-slot-96
           -83 :contract-scalar-at-slot-132 -84 :contract-scalar-at-slot-136
           -201 :general-name-value -225 :merges-array-ran-past-the-window -227 :padding-token-value -230 :file-type-value
           -232 :hadamard-block-size-value -237 :sign-widths-value -238 :sign-values-value
           -239 :inverse-weight-names-value -240 :gdn-v-grouped-value}

 :verification {:node-stack-size 4000
                :fuel 250000000
                :memory {:base 4096
                         :image-file "os/aiueos/tests/fixtures/large/bonsai2-ptq1-header-11120992.bin"
                         :image-sha256 "c2745c0473a980a45c99fe1d2fe85cbbf86f7eca41132d25beb55f249fe703fa"
                         :image-bytes 11120992
                         :plan-offset 11120992
                         :plan-bytes 144}
                :floors {:minimum-vectors 12
                         :minimum-memory-assertions 1
                         :every-reachable-reason-observed false}}
 :vectors
 [
