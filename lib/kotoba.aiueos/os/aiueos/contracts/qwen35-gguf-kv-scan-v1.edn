   :expect-plan-hex "bceca8004000000000000400001400000044000018000000040000000001000000010000100000003000000080000000001800000400000004000000400000000b0000000b0000000a000000000000000000000000ca0300ecc80300eec80300ecc8030032f5010000ca0300a0034c00fe2b5b0023c703009ec8a800ffdfffff30340000007000008f000000ff030000"}
