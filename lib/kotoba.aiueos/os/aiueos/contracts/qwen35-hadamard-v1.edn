;; The declaration kotoba-native's `kernel-object-entries` transcribes, in both
;; `elf64.clj` and `elf64.cljc` (a row `aiueos-qwen35-hadamard`, arity 4).
{:format :aiueos.qwen35-hadamard/v1
 :graph {:root aiueos.qwen35-hadamard
         :modules [aiueos.qwen35-hadamard]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_hadamard"
          :imports []
          :required-operations [kernel-load-u32 kernel-store-u32 kernel-subregion
                                f32-add f32-sub f32-mul f32-from-bits f32-to-bits]}
 :arguments [:arena :arena-length :plan :plan-length]

 ;; WHY THIS OBJECT EXISTS (ADR-0222 stage A item 2). Ternary Bonsai 2's
 ;; 401 folded weights were quantised in a Hadamard-rotated, sign-flipped
 ;; basis (`prism.hadamard.*`, contracts/bonsai2-qwen35-runtime-v1.edn). An
 ;; activation has to enter that basis before every folded matvec and the
 ;; token embedding has to leave it after the lookup; without this transform
 ;; the PTQ1_0 weights the dequant core now decodes multiply the wrong vector.
 ;;
 ;; WHERE THE EXPECTED BYTES COME FROM. `tests/prism_hadamard_oracle.c`: the
 ;; forward and inverse paths of PrismML-Eng/llama.cpp
 ;; @9a9394a895b96003ca842a6041cb28ac49a108f7 (`build_lora_mm`,
 ;; `build_inp_embd`, `ggml_compute_forward_fwht_impl<float>`'s scalar loop,
 ;; whose SIMD pass is the same function bit for bit), `cc -O2` on this
 ;; workstation, 2026-09-22. The 5120- and 6144-wide rows use the REAL sign
 ;; vectors cut from the artifact's `prism.hadamard.sign_values` (file offset
 ;; 13,360; widths 5120 / 6144 / 17408 in that order); the 6144 row carries
 ;; the ssm_out permutation with Bonsai's geometry (hd 128, nk 16, rep 3).
 ;; Inputs are random finite binary32 in [-64, 64). The 17408 width is not a
 ;; vector here (3 x 69,632 bytes of image); the code path is the same as
 ;; 5120's -- more blocks -- and the fuel line below is what covers it.
 ;;
 ;; There is no C twin in `kernel/`, so the QEMU `QWEN-PARITY` self-test
 ;; cannot grade this object; until a Bonsai boot these vectors are its
 ;; whole evidence.

 :plan {:bytes 64
        :mode {:offset 0 :width 4 :values {0 :forward 1 :inverse}}
        :reserved-4 {:offset 4 :width 4 :must-be 0}
        :width {:offset 8 :width 8 :multiple-of 1024 :range [1024 65536]}
        :input-offset {:offset 16 :width 8}
        :signs-offset {:offset 24 :width 8 :element :i32-plus-or-minus-one}
        :output-offset {:offset 32 :width 8 :note "the working buffer; disjoint from input and signs"}
        :perm-hd {:offset 40 :width 8}
        :perm-nk {:offset 48 :width 8}
        :perm-rep {:offset 56 :width 8 :note "<= 1 means no permutation, and then hd and nk must be 0"}}

 :result {:kind :reason-code :admit 0 :range [-10 -1] :truthy-is-success false}
 :reasons {0 :done
           -1 :null-arena
           -2 :null-plan
           -3 :plan-length-is-not-64
           -4 :reserved-slot-is-non-zero
           -5 :mode-is-not-0-or-1
           -6 :width-not-a-multiple-of-1024-in-1024-65536
           -7 :permutation-geometry
           -8 :a-region-runs-past-the-arena
           -9 :output-overlaps-input-or-signs
           -10 :sign-word-is-not-plus-or-minus-one}

 :verification {:node-stack-size 4000
                :fuel 400000000
                :memory {:base 4096 :image-bytes 81920 :arena-offset 0}
                :floors {:minimum-vectors 20
                         :minimum-memory-assertions 7
                         :every-reachable-reason-observed true}}
 :vectors
 [
  {:name :fwd-1024-random-signs, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :expected 0, :expect-output-hex ""}
  {:name :fwd-1024-all-minus-one, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :expected 0, :expect-output-hex ""}
  {:name :inv-1024-random-signs, :mode 1, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :expected 0, :expect-output-hex ""}
  {:name :fwd-2048-random-signs, :mode 0, :width 2048, :perm [0 0 0], :signs-hex "", :input-hex "", :expected 0, :expect-output-hex ""}
  {:name :fwd-5120-real-embedding-signs, :mode 0, :width 5120, :perm [0 0 0], :signs-hex "", :input-hex "", :expected 0, :expect-output-hex ""}
  {:name :inv-5120-real-embedding-signs-token-embd, :mode 1, :width 5120, :perm [0 0 0], :signs-hex "", :input-hex "", :expected 0, :expect-output-hex ""}
  {:name :fwd-6144-real-ssm-out-signs-permuted-128-16-3, :mode 0, :width 6144, :perm [128 16 3], :signs-hex "", :input-hex "", :expected 0, :expect-output-hex ""}
  {:name :fwd-1024-permuted-64-4-4, :mode 0, :width 1024, :perm [64 4 4], :signs-hex "", :input-hex "", :expected 0, :expect-output-hex ""}
  {:name :null-arena, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :arena-base-override 0, :expected -1}
  {:name :null-plan, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :plan-base-override 0, :expected -2}
  {:name :plan-length-is-not-64, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :plan-len-override 60, :expected -3}
  {:name :reserved-slot-non-zero, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :reserved-4 1, :expected -4}
  {:name :mode-2, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :mode-override 2, :expected -5}
  {:name :width-1536-not-a-block-multiple, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :width-override 1536, :expected -6}
  {:name :width-512-below-a-block, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :width-override 512, :expected -6}
  {:name :width-66560-above-ceiling, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :width-override 66560, :expected -6}
  {:name :perm-geometry-does-not-tile-width, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :perm-override [128 16 3], :expected -7}
  {:name :perm-rep-1-with-hd-set, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :perm-override [128 0 1], :expected -7}
  {:name :output-runs-past-the-arena, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :output-offset-override 12288, :expected -8}
  {:name :output-overlaps-input, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :output-offset-override 2048, :expected -9}
  {:name :sign-word-2, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :sign-patch [0 2], :expected -10}
  {:name :sign-word-minus-2, :mode 0, :width 1024, :perm [0 0 0], :signs-hex "", :input-hex "", :sign-patch [1023 -2], :expected -10}
 ]}
