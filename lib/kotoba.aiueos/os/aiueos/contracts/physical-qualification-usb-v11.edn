;; v11 follows the physical K16's v10 code=416 observation.  The transition
;; and final split-W^X roots both loaded and read back successfully, so CR3
;; admission is no longer the unresolved boundary.  The next durable marker
;; failed while entering the first C progress call under the final root.  v11
;; therefore restores the firmware CR3 in a bounded assembly entry before a C
;; prologue, global access, or additional kernel-stack use.
{:format :aiueos.physical-qualification-usb/v11
 :extends "physical-qualification-usb-v10.edn"
 :machine-profile :gmktec-k16-ryzen-7-7735hs
 :observed-input {:image-version 10
                  :physical-result-code 416
                  :meaning :final-root-roundtrip-complete
                  :paging-shape :four-level
                  :sme-c-bit :not-active-in-firmware-cr3
                  :firmware-cet :not-active
                  :firmware-pge :not-active
                  :firmware-pcide :not-active
                  :cr3-load-and-readback :passed
                  :unresolved-boundary [:candidate-root-call-return-address
                                        :qualification-c-entry
                                        :uefi-progress-hand-back]
                  :internal-ssd-writes :none}
 :firmware-first-progress
 {:entry-language :x86-64-assembly
  :sequence [:load-known-firmware-cr3
             :save-candidate-cr3
             :disable-interrupts
             :restore-firmware-cr3
             :call-progress-helper
             :restore-candidate-cr3
             :return]
  :c-code-under-candidate-root false
  :candidate-root-stack-writes :caller-return-address-only
  :uefi-call-root :firmware-cr3
  :finalize-uses-same-entry true}
 :expected-next-evidence
 {:progress-code 448
  :meaning :firmware-first-progress-returned-under-final-root
  :success-code 480}
 :safety {:internal-disk-write-code-reached? false
          :usb-write-scope :same-usb-result-partition-guid
          :uefi-variable-bytes 16
          :ssd-install :separate-later-operation}}
