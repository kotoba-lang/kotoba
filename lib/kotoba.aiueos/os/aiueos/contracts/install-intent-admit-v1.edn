;; The install intent admission, as a contract (install-v1.edn decision 2).
;;
;; `aiueos.install-intent-admit` is the DECISION core of
;; `os/aiueos/scripts/install-intent.cljk verify-intent` -- expiry, release
;; digest, model containment, capacity bounds, transport, serial binding --
;; as a freestanding Kotoba object over one caller-owned 832-byte image. The
;; JSON program keeps reading JSON and printing the named refusals; this
;; object owns the verdict, so the same admission can be reached where no
;; nbb exists. `os/aiueos/scripts/test-install-intent-parity.cljk` feeds the
;; same encoded inputs to both and refuses either way they can disagree.
;;
;; The image layout is stated in the object's header comment and mirrored
;; here in :envelope; the two must agree or the parity gate names the field.
{:format :aiueos.install-intent-admit/v1
 :graph {:root aiueos.install-intent-admit
         :modules [aiueos.sha256 aiueos.install-intent-admit]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_install_intent_admit"
          :imports []
          :required-operations [kernel-load-u8 kernel-subregion]}
 :arguments [:image :image-length]

 :envelope
 {:image-bytes 832
  :why-an-image-not-fields
  "The ABI admits five parameters and the decision reads eleven. One
   caller-owned image with a stated layout keeps the ABI fixed while the
   decision grows, the way cid-v1-admit's scratch does for two pointers."
  :layout
  {:expires-ms 0 :now-ms 8
   :intent-release-disk-sha256 16 :report-image-sha256 48
   :intent-model 80 :report-model 136          ; len i64 + 48B slot each
   :intent-transport 192 :report-transport 216 ; len i64 + 16B slot each
   :report-target-bytes 240 :intent-min-bytes 248 :intent-max-bytes 256
   :flags 264                                   ; bit0 binds serial, bit1 probed
   :intent-serial-digest 272
   :serial-input 304                            ; salt 16B | ':' | padded 64B
   :scratch 400}                                ; 32B digest + 352B sha256 ws
  :missing-field-rule
  "A missing string is a zero length, a missing number is zero, a missing
   serial binding is flag bit0 clear -- what the JSON program reads from a
   JSON nil, this reads from zeros the encoder writes."}

 ;; NOT A BOOLEAN. Zero admits; each non-zero value names the clause that
 ;; refused, numbered in the order install-intent.cljk's verify-intent
 ;; checks. The keyword is the literal the JSON program prints and
 ;; install-v1.edn :intent :refuses lists.
 :result {:kind :reason-code :admit 0 :range [1 9] :truthy-is-success false}
 :reasons {0 :admitted
           1 :intent-expired
           2 :intent-release-digest-mismatch
           3 :target-model-mismatch
           4 :target-capacity-out-of-bounds
           5 :target-transport-unmeasured
           6 :target-transport-mismatch
           7 :target-serial-unmeasured
           8 :target-serial-mismatch
           9 :image-length-not-832}
 :ordering :by-depth-into-the-intent-then-the-report

 ;; Reason 9 is reachable only by a caller that mis-encodes the image; the
 ;; runner always passes :image-bytes. It is declared so the ABI boundary is
 ;; stated, exercised once below so the declaration is not theatre.
 :unreachable-by-construction #{}

 :verification
 {:off-target :executed
  :mechanism :kir-execute-with-a-supplied-memory-image
  :runner "os/aiueos/scripts/verify-admissions.cljk"
  :host :nbb
  :note
  "The JSON program's own suite (test-install-chain.cljk, 22/22) exercises
   the admission through its CLI. This contract executes the DECISION core
   against vectors, so a port mistake shows here as a reason-code mismatch
   and a drift between the two shows in the parity gate."
  :memory {:base 65536 :image-bytes 832}
  :fuel 2000000000
  :floors {:minimum-vectors 16
           :every-reachable-reason-observed true}}

 ;; Every vector encodes an (intent, report, probed-serial) triple. The
 ;; fixture builder in the runner derives the image bytes from these fields;
 ;; the ENCODING is the runner's, the LAYOUT is the contract's.
 :vectors
 [{:name :admits-the-matching-disk
   :expires-in-minutes 60
   :model "PNY CS2241 500GB" :probe-model "PNY CS2241 500GB"
   :transport "nvme" :probe-transport "nvme"
   :capacity [400 600 500]                    ; [min-gb max-gb probed-gb]
   :flags 0 :expected 0}
  {:name :case-and-substring-model-match
   :model "PNY CS2241" :probe-model "pny cs2241 500gb nvme"
   :transport "NVME" :probe-transport "nvme"
   :capacity [400 600 500] :flags 0 :expected 0}
  {:name :serial-bound-and-probed-matches
   :expires-in-minutes 60
   :model "PNY" :probe-model "PNY CS2241 500GB"
   :transport "nvme" :probe-transport "nvme"
   :capacity [400 600 500]
   :serial "PNY-SER-0001" :probe-serial "PNY-SER-0001" :flags 3 :expected 0}
  {:name :serial-probed-with-sysfs-padding
   :model "PNY" :probe-model "PNY"
   :transport "nvme" :probe-transport "nvme"
   :capacity [400 600 500]
   :serial "PNY-SER-0001" :probe-serial "PNY-SER-0001   " :flags 3 :expected 0}
  {:name :expired-by-one-minute
   :expires-in-minutes -1
   :model "PNY" :probe-model "PNY" :transport "nvme" :probe-transport "nvme"
   :capacity [400 600 500] :flags 0 :expected 1}
  {:name :release-digest-one-byte-off
   :model "PNY" :probe-model "PNY" :transport "nvme" :probe-transport "nvme"
   :capacity [400 600 500] :flags 0
   :corrupt :intent-release-digest :expected 2}
  {:name :model-absent-from-intent
   :model "" :probe-model "PNY CS2241 500GB"
   :transport "nvme" :probe-transport "nvme"
   :capacity [400 600 500] :flags 0 :expected 3}
  {:name :model-not-contained-in-probe
   :model "SAMSUNG" :probe-model "PNY CS2241 500GB"
   :transport "nvme" :probe-transport "nvme"
   :capacity [400 600 500] :flags 0 :expected 3}
  {:name :capacity-exactly-min
   :model "PNY" :probe-model "PNY" :transport "nvme" :probe-transport "nvme"
   :capacity [400 600 400] :flags 0 :expected 0}
  {:name :capacity-exactly-max
   :model "PNY" :probe-model "PNY" :transport "nvme" :probe-transport "nvme"
   :capacity [400 600 600] :flags 0 :expected 0}
  {:name :capacity-one-gb-over
   :model "PNY" :probe-model "PNY" :transport "nvme" :probe-transport "nvme"
   :capacity [400 600 601] :flags 0 :expected 4}
  {:name :capacity-one-gb-under
   :model "PNY" :probe-model "PNY" :transport "nvme" :probe-transport "nvme"
   :capacity [400 600 399] :flags 0 :expected 4}
  {:name :transport-unmeasured-in-report
   :model "PNY" :probe-model "PNY"
   :transport "nvme" :probe-transport ""
   :capacity [400 600 500] :flags 0 :expected 5}
  {:name :transport-mismatch
   :model "PNY" :probe-model "PNY"
   :transport "nvme" :probe-transport "sata"
   :capacity [400 600 500] :flags 0 :expected 6}
  {:name :serial-bound-but-nothing-probed
   :model "PNY" :probe-model "PNY" :transport "nvme" :probe-transport "nvme"
   :capacity [400 600 500]
   :serial "PNY-SER-0001" :flags 1 :expected 7}
  {:name :serial-probed-but-differs
   :model "PNY" :probe-model "PNY" :transport "nvme" :probe-transport "nvme"
   :capacity [400 600 500]
   :serial "PNY-SER-0001" :probe-serial "PNY-SER-9999" :flags 3 :expected 8}
  {:name :image-length-not-832
   :model "PNY" :probe-model "PNY" :transport "nvme" :probe-transport "nvme"
   :capacity [400 600 500] :flags 0
   :corrupt :image-length :expected 9}]}
