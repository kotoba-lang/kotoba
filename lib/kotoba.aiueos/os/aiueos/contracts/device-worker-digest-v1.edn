;; The declaration kotoba-native's `kernel-object-entries` transcribes -- in
;; BOTH `elf64.clj` and `elf64.cljc`, because the JVM loads `.clj` first and
;; kotoba-native ADR-0036 keeps the two a twin -- so that the export symbol is
;; stated by the repository that owns the decision.
{:format :aiueos.device-worker-digest/v1
 :graph {:root aiueos.device-worker-digest
         :modules [aiueos.lib.sha256-stream aiueos.device-worker-digest]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_device_worker_digest"
          :imports []
          :required-operations [kernel-load-u8 kernel-store-u8 kernel-subregion]}
 :arguments [:st :st-len :tok :tok-count]

 ;; WHY THIS OBJECT EXISTS.
 ;; `input-sha256` and `output-sha256` are what the device SIGNS about the
 ;; work it did. The server refuses a result whose `output-sha256` does not
 ;; hash the token array that came with it, and refuses a settle whose
 ;; `input-sha256` does not name the job. A device that got the byte form
 ;; wrong would sign a claim about a different computation and be refused
 ;; while the verifier named the wrong cause -- the only thing a verifier can
 ;; say about bytes it did not reconstruct is that the signature failed.
 ;; Deciding what a device asserts about itself is not mechanism, and ADR-0015
 ;; draws the C boundary at mechanism.
 ;;
 ;; It is the object ADR-0137 reserved and could not write: every SHA-256 in
 ;; this repository was capped far below the 131,080 bytes this input can
 ;; reach. `aiueos.lib.sha256-stream` is what unblocked it.

 ;; NOT A BOOLEAN, AND ZERO IS NEVER RETURNED.
 ;; The `aiueos-device-worker-*` convention rather than the `aiueos-sha256-*`
 ;; one, because this object joins that family and its useful answer is a
 ;; NUMBER: how many canonical bytes it hashed. A length and a reason code
 ;; cannot share a non-negative value space, so the reasons are negative. The
 ;; smallest canonical form is four bytes, so zero is not in the value space.
 :result {:kind :length-or-negative-reason
          :admit :positive
          :range [-3 -1]
          :truthy-is-success false
          :zero-is-never-returned true}
 :reasons {-1 :st-len-below-512
           -2 :tok-count-outside-0-32768
           -3 :max-tokens-word-above-4096}

 ;; THE CANONICAL BYTE FORMS, from the SERVER's own specification
 ;; (`docs/device-worker-v3.md`, network-awai/cloud-murakumo-api):
 ;;
 ;;   input-canonical-bytes(tokens, max-tokens)
 ;;     := be32(count) || be32(t_0) || ... || be32(t_{n-1}) || be32(max-tokens)
 ;;   output-canonical-bytes(tokens)
 ;;     := be32(count) || be32(t_0) || ... || be32(t_{m-1})
 ;;
 ;; `be32` is four bytes, unsigned, big-endian, no padding, no separators. The
 ;; leading count is what makes the encoding prefix-free.
 :canonical {:input "be32(count) || be32(t_i)... || be32(max-tokens)"
             :output "be32(count) || be32(t_i)..."
             :widest-input 131080
             :why "4*(32768+2). The protocol caps `:input :tokens` at 32,768
                   ids and `:max-tokens` at 4,096."}

 ;; THE MODE IS `max-tokens`, AND IT IS READ FROM THE STATE REGION.
 ;; The ABI admits five arguments and this uses four; the fifth would have been
 ;; `max-tokens`, and it stays free for `device-worker-body`. Zero means OUTPUT
 ;; digest, and that is not an overload of a legitimate value: the protocol's
 ;; own bound is `1 <= max-tokens <= 4096`.
 :st {:bytes 512
      :layout {:schedule [0 256] :state [256 32] :working [288 32]
               :round-temp [320 32] :length [352 8] :assembly [360 64]
               :digest [424 32] :token-count [456 4] :max-tokens [460 4]
               :reserved [464 48]}
      :caller-writes {:max-tokens 460}
      :object-writes {:token-count 456 :digest 424}}

 ;; THE COUNT PREFIX AND THE SUFFIX ARE SYNTHESISED, NEVER READ.
 ;; `tok` is `4 * tok-count` bytes and nothing else. The leading `be32(count)`
 ;; is built from the ARGUMENT, so a device cannot sign a count that disagrees
 ;; with the array it hashed, and the trailing `be32(max-tokens)` is built from
 ;; the state word rather than copied out of the caller's buffer.
 :synthesised [:count-prefix :max-tokens-suffix]

 :verification
 {:off-target :executed
  :mechanism :kir-execute-with-a-supplied-memory-image
  :runner "os/aiueos/scripts/verify-admissions.cljk"
  :host :nbb
  :node-stack-size 60000
  :memory {:base 65536 :image-bytes 2048 :st-offset 0 :tok-offset 1024}
  :fuel 4000000
  ;; WHERE THE EXPECTED BYTES COME FROM. Four of these are the SERVER's own
  ;; worked examples, printed in `docs/device-worker-v3.md` and pinned there by
  ;; `device_p256_v3_test`. The rest were computed by an implementation that is
  ;; not this one, and every row is re-checked against
  ;; `kotoba-lang/org-nist-sha2` -- the pure `.cljc` reference -- by
  ;; `test/aiueos/sha256_stream_parity_test.cljk`.
  :oracles {:server "network-awai/cloud-murakumo-api docs/device-worker-v3.md"
            :second-implementation "kotoba-lang/org-nist-sha2 (pure cljc)"}
  :floors {:minimum-vectors 10
           :minimum-memory-assertions 7
           :every-reachable-reason-observed true}}

 :vectors
 [{:name :input-one-token
   :tokens [248044] :max-tokens 8
   :expected 12
   :digest-hex "066e21c4d5d605c235fe1a2d9357567cca7f989b97518687535b9789dc558c1b"
   :why "`input-sha256([248044], 8)`, printed verbatim in the server's spec.
         The BOS-only probe the device already sends."}
  {:name :input-four-tokens
   :tokens [248044 9707 11 1879] :max-tokens 64
   :expected 24
   :digest-hex "6d1f26aca9a65756235d79f4246587ffa5192cddab5fd1056d0eff3b5dd2b34a"
   :why "`input-sha256([248044 9707 11 1879], 64)`, the spec's second worked
         example -- and the same digest `main.c`'s DEVCLIENT-PARITY self-test
         already carries as a LITERAL in its protocol 3 context. This object
         now computes it."}
  {:name :output-empty
   :tokens [] :max-tokens 0
   :expected 4
   :digest-hex "df3f619804a92fdb4057192dc43dd748ea778adc52bc498ce80524c014b81119"
   :why "`output-sha256([])`. An aborted generation signs the hash of the
         EMPTY array, not a sentinel -- so the four bytes `00 00 00 00` are a
         real canonical form and not an error case."}
  {:name :output-three-tokens
   :tokens [2005 17 42] :max-tokens 0
   :expected 16
   :digest-hex "bfc850f9c5276dffd405b5f6413ec57703465265dc0747fa9fea07d2aee1b644"
   :why "`output-sha256([2005 17 42])`, the spec's example, and the second
         literal in the DEVCLIENT-PARITY protocol 3 context."}
  {:name :output-one-token
   :tokens [248044] :max-tokens 0
   :expected 8
   :digest-hex "0445e476c5a3a764e3d853b17b61b15820e493b1af1e07a0f47a6856dda5ca57"
   :why "THE SAME TOKEN ARRAY as :input-one-token, with the suffix absent.
         Different length and different digest. An object that read
         `max-tokens` out of the token buffer, or appended it unconditionally,
         would collapse these two."}
  {:name :output-sixty-four-tokens
   :tokens :range-100-163 :max-tokens 0
   :expected 260
   :digest-hex "831250ba4e92a04488cae32edfe857b464dcd5b1dca0e0fc3651df09c042ff4c"
   :why "260 canonical bytes: four full blocks and a four-byte tail. The
         count prefix means block boundaries do NOT line up with token
         boundaries -- block 1 starts four bytes into the array -- which is
         the arithmetic most likely to be off by one."}
  {:name :input-twenty-tokens
   :tokens :range-1-20 :max-tokens 4096
   :expected 88
   :digest-hex "394420ac627eeff6d21f26587c90fa0b12b644db8bd4bb22712e397d48fea94f"
   :why "88 bytes: one full block, then a 24-byte tail whose last four bytes
         are the synthesised suffix. `max-tokens` at its protocol maximum."}

  {:name :st-len-below-512
   :tokens [] :max-tokens 0 :st-len 511
   :expected -1
   :why "Checked first, before anything is written to the caller's region."}
  {:name :tok-count-above-32768
   :tokens [] :max-tokens 0 :tok-count 32769
   :expected -2
   :why "One over the protocol's own `1 <= (count tokens) <= 32768`."}
  {:name :tok-count-negative
   :tokens [] :max-tokens 0 :tok-count -1
   :expected -2
   :why "A negative count would make `4*n` negative and the count prefix
         nonsense; refusing names the cause instead of trapping in
         `kernel-subregion`."}
  {:name :max-tokens-above-4096
   :tokens [] :max-tokens 4097
   :expected -3
   :why "One over the protocol's `1 <= max-tokens <= 4096`. The word is the
         caller's, so it is validated rather than trusted."}]}
