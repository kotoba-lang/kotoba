;; Native K16 -> Murakumo transport qualification with end-to-end TLS and no
;; Mac application termination. The passwordless Mac-side endpoint answers a
;; bounded DNS name and forwards opaque TLS bytes from unprivileged ports; it
;; cannot inspect the signed request or hold a device/account credential.
{:format :aiueos.physical-direct-https-qualification-pxe/v1
 :depends-on :aiueos.physical-network-qualification-pxe/v1
 :target {:model :gmktec-k16
          :nic {:vendor 0x10ec :device 0x8125}
          :client-ip "10.77.0.10"
          :gateway {:ip "10.77.0.1"
                    :roles [:bounded-dns-answerer :opaque-tls-forwarder]
                    :ports {:dns-udp 1053 :tls-tcp 8443}}
          :authority "https://api.murakumo.cloud"
          :sni "api.murakumo.cloud"}
 :request {:method :get
           :path "/infer/queue"
           :accept "application/json"
           :secrets :none
           :mac-application-termination? false
           :mac-opaque-l4-forwarder? true}
 :transport {:dns {:port 1053
                   :qtype :a :bounded-answers [:compressed-name :full-name]}
             :arp {:runtime-refresh :peer-bound-reply
                   :peer-ip "10.77.0.1"
                   :client-ip "10.77.0.10"}
             :tcp {:device-port 8443
                   :upstream-port 443
                   :connections 1 :rx-descriptors 1
                   :connection-reset :bounded-ring-fifo-restart}
             :tls :tls-1.3-aes-128-gcm-x25519
             :tls-end-to-end? true
             :client-entropy :deterministic-qualification-only
             :trust :transport-only
             :certificate-verify :leaf-key-from-same-handshake
             :chain-and-hostname-admission :not-implemented}
 :success {:requires [:admitted-dns-a
                      :runtime-arp-reply-for-10.77.0.10
                      :tcp-three-way-handshake
                      :tls-server-finished
                      :ecdsa-p256-certificate-verify
                      :encrypted-http-response
                      :http-200]
           :uefi-nvram {:state 1 :code 8150}}
 :failure {:uefi-nvram {:state 2 :code-base 8600}
           :bounded? true}
 :safety {:internal-disk-writes? false
          :usb-runtime-writes? false
          :boot-order-writes? false
          :account-token-in-image? false
          :wifi-secret-in-image? false
          :cacao-in-image? false
          :dma-isolation :amd-ivrs-unimplemented-test-only}
 :evidence {:build "os/aiueos/scripts/build-physical-direct-https-pxe.sh"
            :qemu-negative "os/aiueos/scripts/smoke-qemu-physical-direct-https.sh"
            :host-live-profile "os/aiueos/scripts/smoke-tls13-murakumo-profile.sh"
            :physical-state :unverified}
 :does-not-prove [:trusted-https
                  :device-owned-cacao
                  :account-claim
                  :wifi-application
                  :authenticated-murakumo-heartbeat
                  :inference
                  :reboot-recovery]}
