;; The physical K16 may be called "all Kotoba/Amu native" only when every
;; required layer is both implemented in the sealed Kotoba source closure and
;; observed on the physical device. A C-free boot does not imply a C-free NIC,
;; HTTPS stack, or model runtime.
{:format :aiueos.k16-kotoba-native-closure/v1
 :target :gmktec-k16
 :compiler {:repo "kotoba-lang/amu"
            :commit "13d2f5dfe1adeaa99b7e9e6c04fcf8cb8fc15a4b"
            :backend {:repo "kotoba-lang/kotoba-native"
                      :commit "ce85a36d5307e7e019c304caa17daf237abb9b9b"}
            :firmware-entry {:arity 2
                             :arguments [:efi-handle :efi-system-table]
                             :contract :microsoft-x64-two-arity-efi-status-v2}
            :memory-widths [:u8 :u16 :u32 :u64]
            :scalar-f32 {:x86-64 :implemented
                         :aarch64 :implemented
                         :public-f32-abi? false
                         :aggregate-f32? false}}
 :layers
 {:boot {:state :implemented
         :language :kotoba
         :builder :amu
         :entry "native/kernel.kotoba"
         :foreign-code? false
         :qemu-evidence "scripts/smoke-qemu-kotoba-native.sh"
         :scratch-pages {:count 14 :address-offset 80 :pages-offset 88
                         :owner :amu-uefi-loader-data
                         :address-limit-exclusive 549755813888}
         :k16-preflight {:gate :pci-02-00-0-rtl8125
                         :kernel-call :returnable-main-wrapper
                         :checkpoints ["AIUEOS K16 PREFLIGHT ENTER"
                                       "AIUEOS K16 PREFLIGHT RTL8125"]
                         :screen "AIUEOS K16 PREFLIGHT STATUS XX"
                         :terminal :halt-after-status
                         :before :exit-boot-services}
         :physical-k16 {:state :preflight-kernel-entry-passed
                        :evidence "physical-kotoba-native-k16-v1.edn"}}
  :nic {:state :one-shot-native-provider
        :implemented [:rtl8125-pci-discovery :mmio-map :dma-ring-ownership
                      :tx :rx :arp-request-reply :udp-arp-positive-receipt
                      :fixed-mac-udp-failure-diagnostic
                      :static-ipv4-tcp-syn-synack-rst
                      :udp-tcp-positive-receipt]
        :native-source "native/rtl8125.kotoba"
        :receipt {:physical-arp "AIUEOS_NATIVE_ARP_OK"
                  :next-tcp-candidate "AIUEOS_NATIVE_TCP_OK"}
        :diagnostic-receipt "AIUEOS_NATIVE_NIC_XX"
        :diagnostic-status-encoding :two-digit-hexadecimal
        :receipt-destination "10.77.0.1:7777"
        :required [:physical-k16-arp-positive :physical-k16-tcp-positive
                   :persistent-link-recovery]
        :qemu-evidence :bounded-no-device-passed
        :physical-k16 {:state :arp-and-udp-receipt-passed
                       :status-hex "5A"
                       :evidence "physical-kotoba-native-k16-v1.edn"}
        :next-candidate {:state :physical-unverified
                         :screen-success-hex "60"
                         :evidence-contract "pure-kotoba-tcp-k16-v1.edn"}
        :current-reference ["kernel/rtl8125.c" "kernel/rtl8125.h"]
        :contract-repositories ["kotoba-lang/capability-pci-config"
                                "kotoba-lang/capability-mmio-map"
                                "kotoba-lang/capability-dma-map"
                                "kotoba-lang/capability-link-frame"]}
  :https {:state :not-implemented-in-pure-closure
          :implemented [:static-ipv4-tcp-syn-synack-rst
                        :aes128-gcm :hkdf-sha256 :tls13-record]
          :implemented-source ["kotoba/aes128-gcm.kotoba"
                               "kotoba/hkdf-sha256.kotoba"
                               "kotoba/tls13-record.kotoba"]
          :required [:arp :dhcp :dns :tcp :tls13-handshake :https-range
                     :certificate-path-validation :cid-verification]
          :reuse-candidates
          [{:repo "kotoba-lang/org-ietf-dhcp"
            :available :kotoba-client-core
            :missing :bare-metal-frame-integration}
           {:repo "kotoba-lang/org-ietf-tcp"
            :available :kotoba-state-machine-cores
            :missing :bare-metal-segment-engine}
           {:repo "kotoba-lang/org-ietf-tls"
            :available :portable-cljc-handshake
            :missing :amu-firmware-kotoba-port}
           {:repo "kotoba-lang/http"
            :available :portable-http-wire
            :missing :amu-firmware-kotoba-port}]
          :current-reference ["kernel/tls13.c" "kernel/tls_aes_gcm.c"]
          :contract-repositories ["kotoba-lang/capability-net-transport"
                                  "kotoba-lang/capability-crypto-tls"
                                  "kotoba-lang/capability-http-fetch"]}
  :qwen {:state :not-implemented-in-pure-closure
         :implemented [:scalar-f32-native-machine-code
                       :gguf-header-admission-kotoba-object]
         :implemented-source
         ["kotoba/qwen35-gguf-header-valid.kotoba"]
         :required [:large-model-authority :gguf-metadata :quant-decode
                    :threaded-matmul :attention :deltanet :kv-state
                    :tokenizer :sampling :bounded-output]
         :reuse-candidates
         [{:repo "kotoba-lang/inference" :available :runtime-contracts
           :missing :bare-metal-qwen-executor}
          {:repo "kotoba-lang/torch" :available :module-graph-data
           :missing :bare-metal-qwen-kernels}
          {:repo "kotoba-lang/num" :available :hosted-numerical-api
           :missing :amu-avx2-firmware-backend}]
         :current-reference ["kernel/qwen35_infer.c"
                             "kernel/qwen35_quant.c"
                             "kernel/qwen35_runtime.c"]
         :exact-artifact {:file "Qwen3.8-27B-UD-IQ3_XXS.gguf"
                          :bytes 10934860704
                          :sha256 "c0b7c3038681ed2e3040456c1dd45f9858b6c2290bed172c70388a94874f3eee"}}}
 :claim-policy
 {:all-native-ready? false
  :must-have [:boot :nic :https :qwen]
  :requires [:sealed-kotoba-source-closure
             :no-c-or-assembly-inputs
             :reproducible-build
             :qemu-negative-and-positive-gates
             :physical-k16-boot
             :physical-k16-network
             :physical-k16-https
             :exact-qwen-token-and-timing]
  :forbidden-in-final-image ["*.c" "*.S" "*.o" "*.a" :foreign-symbols
                             :dynamic-imports]
  :status :in-progress}}
