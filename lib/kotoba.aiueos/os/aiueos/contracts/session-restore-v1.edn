; Guest sealed-session front restore (ADR-0098). Restore is Kotoba; C mechanism only.
{:format :aiueos.session-restore/v1
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_session_restore"
          :admit-from "kotoba_aiueos_session_restore"}
 :vectors {:boot-front-two :ok
           :empty-session :leftover
           :unknown-surface :leftover
           :always-front :leftover
           :restore-ignored :leftover}
 :trusts-caller-for [:native-phase6-compositor
                     :physical-boot
                     :native-component-runtime]
 :verification {:off-target :impossible
                :reason :kir-refuses-kernel-memory
                :evidence "nbb --classpath src scripts/compositor-guest.cljk guest-session"}
}
