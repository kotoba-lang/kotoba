;; v5 keeps the v4 USB partition, binding, result text, and read-only hardware
;; probe contracts.  It adds durable pre-kernel loader failure evidence after
;; the physical K16 stopped at the v4 loader's initial console line.
{:format :aiueos.physical-qualification-usb/v5
 :extends "physical-qualification-usb-v4.edn"
 :machine-profile :gmktec-k16-ryzen-7-7735hs
 :unchanged [:media-layout
             :result-volume-binding
             :xhci-dbc-read-only-inventory
             :result-text-v4
             :internal-disk-writes-none]
 :loader-failure-return
 {:codes {101 :system-table
          102 :loaded-image
          103 :kernel-buffer
          104 :initramfs-buffer
          105 :kernel-admission-exhausted
          106 :elf-size
          107 :elf-header
          108 :elf-program-table
          109 :elf-segment
          110 :segment-allocation
          111 :elf-entry
          112 :memory-map-buffer
          113 :memory-map
          114 :initramfs-empty
          115 :acpi-rsdp
          116 :gop
          117 :gop-mode
          118 :exit-boot-services}
  :screen true
  :persisted-to :uefi/AIUEOSQualificationResult
  :maximum-bytes 16
  :state :failure
  :collected-by :same-parent-usb-probe
  :collected-without-reboot true
  :result-target :qualification-usb/result/RESULT.LOG}
 :negative-gate
 {:command "os/aiueos/scripts/smoke-qemu-physical-loader-failure.sh"
  :forced-code 190
  :requires [:screen-marker
             :uefi-variable-persisted
             :result-log-failure
             :checker-exit-4
             :write-confined-to-result-partition]}
 :safety {:internal-disk-write-code-reached? false
          :usb-write-scope :same-usb-result-partition-guid
          :uefi-variable-bytes 16
          :ssd-install :separate-later-operation}}
