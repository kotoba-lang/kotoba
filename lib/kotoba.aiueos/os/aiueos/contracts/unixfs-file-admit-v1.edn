;; The declaration kotoba-native's `kernel-object-entries` transcribes, in BOTH
;; `elf64.clj` and `elf64.cljc` (kotoba-native ADR-0036: the JVM loads `.clj`
;; first and the two files are a twin).
{:format :aiueos.unixfs-file-admit/v1
 :graph {:root aiueos.unixfs-file-admit :modules [aiueos.unixfs-file-admit]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_unixfs_file_admit"
          :imports []
          :required-operations [kernel-load-u8-4k]}
 :arguments [:node :node-length :expected-links :expected-filesize]

 ;; WHY. `cid-v1-admit` verifies ONE block against ONE CID, and SHA-256 here
 ;; caps a block at 12,288 bytes. The artifacts this device fetches are a
 ;; 10.9 GB GGUF (ADR-0116) and a multi-megabyte KERNEL.ELF (ADR-0122), and
 ;; the C-free profile maps the first GiB while tracking 256 pages -- so
 ;; "hold more memory" is not the answer. A UnixFS file root names its
 ;; children by CID, which turns an unbounded artifact into bounded blocks
 ;; verified one at a time against a single name. This object decides the
 ;; root; `cid-v1-admit` decides each leaf; the composition is a verified file.

 :accepts
 {:encoding :canonical-go-unixfs-only
  :node {:links-field 2 :data-field 1 :order [:links :data]}
  :link {:hash {:field 1 :bytes 36} :name {:field 2 :must-be-empty true}
         :tsize {:field 3 :varint true}}
  :data {:type {:field 1 :must-be 2 :meaning :file}
         :filesize {:field 3 :varint true}
         :blocksizes {:field 4 :varint true :repeated true}}
  :bounds {:node-bytes [1 4096] :links [0 32] :varint-bytes 5}
  :why-strict
  "A block is content-addressed, so its bytes are already fixed by the CID
   that named it. A parser that accepts a second encoding of the same node
   accepts bytes no CID here will ever name, and pays for it in parser
   surface. `unixfs.file` in `tech-ipfs-specs-unixfs` emits exactly this
   shape and is checked against kubo 0.41."
  :interior-links-are-not-required-to-be-raw
  "Above 174 chunks the root's children are themselves dag-pb nodes. This
   object checks that a link Hash is 36 bytes; which codec those 36 bytes
   carry is `cid-v1-admit`'s question when the child is fetched."
  :five-byte-varint-bound
  "Covers a 32 GiB Tsize. A sixth byte would still be a valid protobuf
   varint, so this is a policy bound and is declared as one."}

 ;; NOT A BOOLEAN. Zero admits; every non-zero value names the clause that
 ;; produced it, and the codes ascend with how far into the node the check
 ;; reaches -- links, then the header, then the two arithmetic identities that
 ;; bind the header to the manifest.
 :result {:kind :reason-code :admit 0 :range [1 17] :truthy-is-success false}
 :reasons {0 :admitted
           1 :node-length-outside-1-to-4096
           2 :link-length-malformed-or-overruns-the-node
           3 :link-hash-is-not-a-36-byte-bytes-field
           4 :link-name-is-not-present-and-empty
           5 :link-tsize-absent-or-malformed
           6 :link-has-trailing-bytes
           7 :link-count-above-32
           8 :data-field-absent
           9 :data-length-malformed
           10 :unixfs-type-is-not-file
           11 :filesize-absent-or-malformed
           12 :blocksize-field-malformed
           13 :node-has-trailing-bytes-after-data
           14 :link-count-is-not-the-expected-one
           15 :filesize-is-not-the-expected-one
           16 :blocksizes-count-is-not-the-link-count
           17 :blocksizes-do-not-sum-to-filesize}
 :ordering :by-depth-into-the-node

 :verification
 {:off-target :executed
  :mechanism :kir-execute-with-a-supplied-memory-image
  :runner "os/aiueos/scripts/verify-admissions.cljk"
  :host :nbb
  :ground-truth
  "The two admitted nodes are real: `unixfs.file/build` in
   tech-ipfs-specs-unixfs produced them, that implementation is pinned
   against kubo 0.41 CIDs, and every refusal vector is one of those two
   nodes with one named byte changed. The root CIDs are
   bafybeidi3txkchykjupk3j4wfbwbzgj3skzhk2ey6hbmkgviaj7vrx4p64 (two leaves)
   and bafybeicfgk73jc55jyh5wtzebapnog537ijtwzhesiwvntivij56tblw5a (three)."
  :memory {:base 65536 :image-bytes 8192 :node-offset 512}
  :fuel 20000000
  :floors {:minimum-vectors 22 :every-reachable-reason-observed true}}

