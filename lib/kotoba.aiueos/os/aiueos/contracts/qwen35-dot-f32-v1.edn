;; The declaration kotoba-native's `kernel-object-entries` transcribes, in both
;; `elf64.clj` and `elf64.cljc`.
{:format :aiueos.qwen35-dot-f32/v1
 :graph {:root aiueos.qwen35-dot-f32
         :modules [aiueos.qwen35-dot-f32]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_dot_f32"
          :imports []
          :required-operations [kernel-load-u32 kernel-subregion
                                f32-add f32-mul f32-from-bits f32-to-bits]}
 :arguments [:a :a-length :b :b-length :count]

 ;; THE ACCUMULATION TREE IS THE CONTRACT.
 ;; Four accumulators stepped four apart, then `(s0+s1)+(s2+s3)`, then a scalar
 ;; tail over whatever `count mod 4` leaves. That is `dot_scalar`
 ;; (`kernel/qwen35_infer.c:234`) and NOT `dot_avx2` (:272), which reduces its
 ;; four lanes LEFT TO RIGHT and therefore computes a different value for every
 ;; count of eight or more. The C has both and picks by `qwen_vector_bits`, so
 ;; naming which one is reproduced is part of the contract rather than a
 ;; detail: an object that matched the other one would disagree with this file
 ;; on every vector below from count 8 up.

 ;; THE ANSWER IS A WORD, NOT A VERDICT.
 ;; The return is the binary32 bit pattern sign-extended from bit 31, which is
 ;; how this backend carries an f32. So a small negative number is a legal
 ;; answer and cannot also be a reason code. The refusals are below -2^32,
 ;; which no f32 pattern reaches.

 ;; `kernel-dot-f32` (kotoba-gmir ADR 0010) is the SIMD swap-in and is not used
 ;; here. Its tree is this one, and it agrees with `dot_scalar` exactly when
 ;; the count is a multiple of eight -- which every Qwen3.5 dimension is (5120,
 ;; 17408, 12288, 10240, 6144, 1024, 256, 128, 64). It differs for
 ;; `count mod 8` in 4..7, because it takes eight elements per step and this
 ;; object takes four; the vectors below at counts 4..7, 12..15 pin that
 ;; boundary so the swap-in cannot be made silently.

 :result {:kind :word :admit :any-f32-bit-pattern
          :refusals {-4294967297 :count-negative
                     -4294967298 :count-above-65536
                     -4294967299 :a-length-is-not-four-times-count
                     -4294967300 :b-length-is-not-four-times-count}}

 :verification {:node-stack-size 4000
                :fuel 400000000
                :memory {:base 4096 :image-bytes 4096
                         :left-offset 0 :right-offset 1024}
                :floors {:minimum-vectors 24}}
 :vectors
