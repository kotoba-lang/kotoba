;; The declaration kotoba-native's `kernel-object-entries` transcribes, in both
;; `elf64.clj` and `elf64.cljc`.
{:format :aiueos.qwen35-recurrent-step/v1
 :graph {:root aiueos.qwen35-recurrent-step
         :modules [aiueos.qwen35-recurrent-step]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_recurrent_step"
          :imports []
          :required-operations [kernel-load-u32 kernel-store-u32 kernel-subregion
                                f32-add f32-sub f32-mul f32-from-bits f32-to-bits
                                bit-and quot]}
 :arguments [:arena :arena-bytes :plan :plan-bytes]

 ;; `recurrent_step` (`kernel/qwen35_infer.c:493`), the gated DeltaNet update
 ;; of ONE linear-attention head's recurrent state:
 ;;
 ;;     S <- decay * S ; delta <- beta * (v - S^T k) ; S <- S + k (x) delta
 ;;     y <- (S^T q) / sqrt(d)
 ;;
 ;; Rows of S are the KEY dimension and columns the VALUE dimension.

 ;; THE REDUCTION IS SEQUENTIAL. Both inner products accumulate one element at
 ;; a time, left to right, in binary32 -- NOT the four-accumulator tree
 ;; `dot_scalar` and `stable_attention_score` use. The tree would disagree with
 ;; the C on most inputs, which is why the vectors below carry a spread of
 ;; magnitudes rather than a spread of mantissas.

 ;; THE DECAY MULTIPLY IS HOISTED out of the `remembered` accumulation. Over
 ;; the whole `v` loop every cell is reached exactly once and always before it
 ;; is read, so doing all `d*d` multiplies first is a loop split rather than a
 ;; reordering of any arithmetic expression. The object does it because
 ;; `[state r v k acc]` already spends the five parameters this dialect admits.

 ;; THE DIMENSION IS A PLAN FIELD, 1..128. `LINEAR_HEAD_DIM` is 128 and K16
 ;; will never pass anything else; the field exists so the object can be RUN
 ;; here. The `kotoba.kir` interpreter recurses once per Kotoba call and has no
 ;; tail-call elimination, so the 16,384-cell decay walk at d=128 exhausts
 ;; node's stack while d=8 executes. Same reason `qwen35-norm-v1.edn` verifies
 ;; a width of 32 rather than 5,120.

 :result {:kind :reason-code :admit 0 :range [-7 -1] :truthy-is-success false}
 :reasons {0 :done
           -1 :null-arena
           -2 :null-plan
           -3 :plan-length-is-not-96
           -4 :a-reserved-slot-is-non-zero
           -5 :dimension-outside-1-128
           -6 :decay-or-beta-is-non-finite
           -7 :a-region-runs-past-the-arena}

 ;; MEASURED, not chosen: at 4000 every vector comes back
 ;; `:host-stack-exhausted true` and the runner refuses rather than reporting a
 ;; pass. Run this one as
 ;;   ulimit -s 65520
 ;;   node --stack-size=60000 "$(command -v nbb)" --classpath ... <this file>
 :verification {:node-stack-size 60000
                :fuel 400000000
                :memory {:base 4096 :image-bytes 4096
                         :arena-offset 0 :arena-bytes 2048 :plan-offset 2048
                         :state 0 :key 1024 :query 1152 :value 1280
                         :correction 1408 :output 1536}
                :floors {:minimum-vectors 8
                         :minimum-memory-assertions 4}}
 :vectors
 [
  {:name :delta-8-decay-half, :dim 8, :decay-bits 1056964608, :beta-bits 1048576000,
   :state-hex "",
   :key-hex "000088c10000f6c0000084c4000000c600006642000060c4000026c60000c040",
   :query-hex "00008044000084c0000028bf00001ebf0000a8c20000d0450000b0c30000d041",
   :value-hex "000090c30000683f000042c00000c8c00000fa440000664500000a41000080bf",
   :expect-state-hex "",
   :expect-output-hex "d27b1d53a3895dd1ac7d73d20d5c94d1dff599508cfb1d53714f3bd07fec9b50",
   :expected 0}
  {:name :delta-12-decay-one, :dim 12, :decay-bits 1065353216, :beta-bits 1061158912,
   :state-hex "",
   :key-hex "0000384300001ac60000f840000000c50000d6c00000c4c50000fac50000f643000030c3000004bf00005cc3000090c1",
   :query-hex "0000c0c10000b84600006cc50000b83e00005cc50000624500004241000040400000b0bf0000a041000028c500009c3e",
   :value-hex "0000424300001445000090c00000d842000040450000403e000000c10000603f000098c5000030420000604300008c45",
   :expect-state-hex "",
   :expect-output-hex "46e84cd6358a81d5de68b1d888353cd74aca7f568a3be9d61ba34d56bbefcc55ef7661d727759b57dbefe358afaecdd8",
   :expected 0}

  ;; The refusals. Each moves exactly one thing.
  {:name :null-arena, :dim 8, :decay-bits 1065353216, :beta-bits 1065353216,
   :arena-override 0, :expected -1}
  {:name :null-plan, :dim 8, :decay-bits 1065353216, :beta-bits 1065353216,
   :plan-base-override 0, :expected -2}
  {:name :plan-length-95, :dim 8, :decay-bits 1065353216, :beta-bits 1065353216,
   :plan-length 95, :expected -3}
  {:name :reserved-slot-88-set, :dim 8, :decay-bits 1065353216, :beta-bits 1065353216,
   :plan-override {88 1}, :expected -4}
  {:name :dimension-zero, :dim 0, :decay-bits 1065353216, :beta-bits 1065353216,
   :expected -5}
  {:name :dimension-129, :dim 129, :decay-bits 1065353216, :beta-bits 1065353216,
   :expected -5}
  ;; 0x7f800000 is +infinity: the exponent field is all ones, which is exactly
  ;; what `finite_float` (:92) rejects.
  {:name :decay-infinite, :dim 8, :decay-bits 2139095040, :beta-bits 1065353216,
   :expected -6}
  {:name :beta-not-a-number, :dim 8, :decay-bits 1065353216, :beta-bits 2143289344,
   :expected -6}
  ;; The state of a 128-wide head is 65,536 bytes and this arena is 2,048.
  {:name :state-runs-past-the-arena, :dim 128, :decay-bits 1065353216, :beta-bits 1065353216,
   :expected -7}
 ]}
