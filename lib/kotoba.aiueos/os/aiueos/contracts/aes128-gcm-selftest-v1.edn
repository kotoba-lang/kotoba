;; The AES-128-GCM boot known-answer test, executed in the `kotoba.kir` oracle
;; (ADR-0220). One vector: a zeroed 1,536-byte scratch region and the answer
;; 0 -- every step of the retired C `aiueos_aes128_gcm_selftest` agreed, over
;; the SAME core module the linked object is built from. Steps 1-5 are
;; declared unreachable: with a correct core no input reaches them, and the
;; core's own contract (aes128-gcm-v1.edn) is where the AEAD is falsified. The
;; short-region refusal (6) is the one refusal a caller can cause.
;;
;; Cost: five table builds and four AEADs over 64 bytes in a ClojureScript
;; interpreter -- minutes, not seconds, and stated rather than hidden.
{:format :aiueos.flat-record/v1
 :entry aiueos-aes128-gcm-selftest
 :graph {:root aiueos.aes128-gcm-selftest
         :modules [aiueos.aes128-gcm-selftest aiueos.lib.aes128-gcm-core]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_aes128_gcm_selftest"
          :imports []
          :required-operations [kernel-subregion kernel-load-u8 kernel-store-u8 kernel-load-u8-4k kernel-store-u8-4k string-code-point-at]}
 :arguments [:scratch :length]

 :result {:kind :verdict :admit 0 :refuse 1 :truthy-is-success false}
 :reasons {0 :all-steps-agree
           1 :empty-message-tag
           2 :message-ciphertext-or-tag
           3 :round-trip
           4 :flipped-tag-not-refused
           5 :aad-tag
           6 :scratch-too-short}
 :unreachable-by-construction [1 2 3 4 5]

 :verification
 {:memory {:base 1048576
           :image-bytes 2048
           :regions {:scratch 0}}
  :fuel 100000000
  :node-stack-size 60000
  :floors {:minimum-vectors 2
           :every-reachable-reason-observed true
           :both-verdicts-observed false}}

 :vectors
 [{:name :known-answers
   :seed []
   :args [:scratch 1536]
   :expected 0}
  {:name :scratch-1535-refused
   :seed []
   :args [:scratch 1535]
   :expected 6}]}
