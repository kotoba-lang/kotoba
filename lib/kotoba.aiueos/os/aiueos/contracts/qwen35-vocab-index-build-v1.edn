;; The declaration kotoba-native's `kernel-object-entries` transcribes -- in
;; BOTH `elf64.clj` and `elf64.cljc`, because the JVM loads `.clj` first and
;; kotoba-native ADR-0036 keeps the two a twin -- so that the export symbol is
;; stated by the repository that owns the decision.
{:format :aiueos.qwen35-vocab-index-build/v1
 :graph {:root aiueos.qwen35-vocab-index-build
         :modules [aiueos.qwen35-vocab-index-build]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_vocab_index_build"
          :imports []
          :required-operations [kernel-load-u8 kernel-load-u32 kernel-store-u32
                                kernel-subregion]}
 :arguments [:model-base :model-length :work-base :work-length]

 ;; WHY THIS OBJECT EXISTS.
 ;; `aiueos-qwen35-gguf-kv-scan` records where `tokenizer.ggml.tokens` and
 ;; `tokenizer.ggml.merges` begin, how many elements each holds and where each
 ;; ends -- six coordinates `kernel/qwen35_runtime.c` computes and throws away.
 ;; This object turns those two arrays into the two lookup tables a BPE
 ;; tokenizer needs, WITHOUT COPYING EITHER: the token strings stay in the
 ;; model mapping and the tables hold a four-byte file offset per id.
 ;;
 ;; There is no C to replace. `kernel/qwen35_infer.c` has no tokenizer at all
 ;; -- its input is a single BOS id (`contracts/qwen38-qwen35-runtime-v1.edn`
 ;; :execution) -- so this is the first half of a capability the K16 image does
 ;; not have, rather than a port of one it does.

 :result {:kind :reason-code :admit 0 :range [-16 -1] :truthy-is-success false}
 :reasons {0 :built
           -1 :null-model-base
           -2 :null-workspace-base
           -3 :workspace-below-the-header
           -4 :vocabulary-count-zero-or-above-1048576
           -5 :merge-count-above-1048576
           -6 :token-array-outside-the-model-window
           -7 :merge-array-outside-the-model-window
           -8 :index-does-not-fit-the-workspace
           -9 :token-string-past-the-window
           -10 :merge-string-past-the-window
           -11 :token-hash-table-would-not-close
           -12 :merge-string-has-no-separator
           -13 :merge-left-side-not-a-vocabulary-token
           -14 :merge-right-side-not-a-vocabulary-token
           -15 :merge-table-would-not-close
           -16 :model-window-above-16-mib}

 ;; -11 AND -15 CANNOT HAPPEN, AND THAT IS AN ARGUMENT RATHER THAN A HOPE.
 ;; Both tables are sized at a power of two AT OR ABOVE TWICE their element
 ;; count and are cleared before either is written, so at least half of every
 ;; table is empty and a linear probe reaches an empty slot in at most half a
 ;; pass. The probe budget carried in the packed `st` argument is belt and
 ;; braces for a workspace that arrived with a corrupted table: without it the
 ;; loop would spin until the fuel bound trapped, and a `ud2` reads as a
 ;; compiler bug rather than as a corrupted argument.
 :unreachable-by-construction [-11 -15]

 ;; -16 IS A FUEL BOUND, NOT A SAFETY BOUND.
 ;; Every token and every merge string is hashed and compared byte by byte, so
 ;; this object's cost is linear in the WINDOW IT IS HANDED rather than in the
 ;; element counts. Handed the whole 10,934,860,704-byte mapping instead of the
 ;; 10,996,640-byte metadata prefix it needs, no finite fuel bound would hold.
 ;; kotoba-native's `qwen-index-fuel?` arm states the same 16 MiB.
 :model-window {:maximum 16777216
                :expected-for-the-artifact 10996640
                :why :the-fuel-bound-is-linear-in-it}

 ;; THE MERGE TABLE IS KEYED BY A PAIR OF IDS; llama.cpp'S IS KEYED BY A PAIR
 ;; OF STRINGS. The two agree exactly when every merge side is itself a
 ;; vocabulary token, because the string->id map is then injective on the keys
 ;; that matter. That is a property of the artifact and not of the format, so
 ;; -13 and -14 CHECK it rather than assuming it.
 :merge-key {:kind :pair-of-token-ids
             :llama-cpp :pair-of-strings
             :precondition-checked [-13 -14]}

 ;; Opposite directions, both transcribed from llama.cpp's loader rather than
 ;; chosen: `token_to_id[word] = i` in ascending i (last wins) against
 ;; `bpe_ranks.emplace(...)` (first wins).
 :duplicate-keys {:token-string :last-id-wins :merge-pair :first-rank-wins}

 :workspace
 {:bytes 128
  :header {0 :magic-0x4B544F4B 4 :vocabulary-count 8 :merge-count
           12 :token-array-file-offset 16 :merge-array-file-offset
           20 :token-offset-table 24 :token-hash-table 28 :token-hash-capacity
           32 :merge-table 36 :merge-table-capacity 40 :index-end
           44 :token-type-file-offset
           48 :input-offset 52 :input-length
           56 :token-output-offset 60 :token-output-capacity 64 :token-output-count
           68 :scratch-offset 72 :scratch-bytes
           76 :id-input-offset 80 :id-input-count
           84 :text-output-offset 88 :text-output-capacity 92 :text-output-length
           96 :scratch-a 100 :scratch-b 104 :scratch-c 108 :scratch-d
           112 :scratch-e 116 :scratch-f 120 :scratch-g 124 :scratch-h}
  :derived {:token-offset-table 128
            :token-hash-table [:+ 128 [:* 4 :vocabulary-count]]
            :merge-table [:+ :token-hash-table [:* 4 :token-hash-capacity]]
            :index-end [:+ :merge-table [:* 12 :merge-table-capacity]]}
  :for-the-artifact {:vocabulary-count 248320 :merge-count 247587
                     :token-hash-capacity 524288 :merge-table-capacity 524288
                     :index-end 9382016}}

 :verification
 {:off-target :executed
  :mechanism :kir-execute-with-a-supplied-memory-image
  :runner "os/aiueos/scripts/verify-admissions.cljk"
  :host :nbb
  ;;   ulimit -s 65520
  ;;   node --stack-size=60000 "$(command -v nbb)" --classpath "$(kbb -Spath -M:verify-admissions)" \
  ;;     os/aiueos/scripts/verify-admissions.cljk os/aiueos/contracts/qwen35-vocab-index-build-v1.edn
  :node-stack-size 60000
  ;; The MINI vocabulary, not the artifact's: seven tokens and two merge rules,
  ;; whose bytes are `:fixture :model-hex` below. The real 248,320-entry array
  ;; needs a GGUF and there is none on the machine that wrote this (measured
  ;; 2026-09-02: no `.gguf` over 10 MB under /Users or /Volumes, no
  ;; llama-tokenize, no llama.cpp under Homebrew). Every table size the object
  ;; derives is derived from the header, so the same code serves both -- which
  ;; is a property of the source and is stated as such rather than measured.
  :memory {:base 65536 :image-bytes 19584
           :work-offset 128 :work-bytes 19456
           :input-offset 512 :output-offset 1536 :output-capacity 64
           :scratch-offset 2048 :scratch-bytes 16384
           :ids-offset 18432 :text-offset 18688 :text-capacity 256}
  :fuel 400000000
  :floors {:minimum-vectors 15
           :minimum-memory-assertions 7
           :every-reachable-reason-observed true}}

 ;; The mini vocabulary, byte for byte. 24 bytes of padding (where a GGUF
 ;; container header would be), then seven length-prefixed strings, then two.
 ;;
 ;;   id 0 "a"   61        id 4 "ab"  6162
 ;;   id 1 "b"   62        id 5 "Ga"  c4a061     (G is U+0120, byte 0x20)
 ;;   id 2 "c"   63        id 6 "あ"  e38182     (not in the byte alphabet)
 ;;   id 3 "G"   c4a0
 ;;   rank 0 "a b"   rank 1 "G a"
 ;;
 ;; Token 6 is there for the DETOKENIZER's -33: a vocabulary entry whose
 ;; codepoints are not in the byte alphabet at all. No input can produce it,
 ;; because every encoded byte is ASCII or a C3/C4 lead.
 :fixture
 {:vocab-count 7 :merge-count 2 :tokens-at 24 :merges-at 93
  :model-hex "0000000000000000000000000000000000000000000000000100000000000000610100000000000000620100000000000000630200000000000000c4a0020000000000000061620300000000000000c4a0610300000000000000e3818203000000000000006120620400000000000000c4a02061"
  ;; Same seven tokens, one malformed merge each.
  :model-hex-no-separator "0000000000000000000000000000000000000000000000000100000000000000610100000000000000620100000000000000630200000000000000c4a0020000000000000061620300000000000000c4a0610300000000000000e3818202000000000000006162"
  :model-hex-unknown-left "0000000000000000000000000000000000000000000000000100000000000000610100000000000000620100000000000000630200000000000000c4a0020000000000000061620300000000000000c4a0610300000000000000e3818203000000000000007a2062"
  :model-hex-unknown-right "0000000000000000000000000000000000000000000000000100000000000000610100000000000000620100000000000000630200000000000000c4a0020000000000000061620300000000000000c4a0610300000000000000e38182030000000000000061207a"}

 :vectors
 [{:name :the-mini-vocabulary-indexes
   :expected 0
   ;; Every derived number, read back out of the workspace, so that what is
   ;; CHECKED is what was WRITTEN rather than what the layout section claims.
   ;; 1263816523 is 0x4B544F4B; 156 = 128 + 4*7; 220 = 156 + 4*16;
   ;; 268 = 220 + 12*4.
   :expect-header {0 1263816523 20 128 24 156 28 16 32 220 36 4 40 268}}

  {:name :null-model-base :model-base 0 :expected -1}
  {:name :null-workspace-base :work-base 0 :expected -2}
  {:name :workspace-below-the-header :work-len 127 :expected -3}
  {:name :zero-vocabulary :vocab-count 0 :expected -4
   :why "An empty vocabulary is not a small one. Nothing downstream can look a
         symbol up in it, and a zero-slot hash table has no empty slot for a
         probe to stop at."}
  {:name :vocabulary-above-the-ceiling :vocab-count 1048577 :expected -4}
  {:name :merges-above-the-ceiling :merge-count 1048577 :expected -5}
  {:name :token-array-outside-the-window :tokens-at 999999 :expected -6}
  {:name :merge-array-outside-the-window :merges-at 999999 :expected -7}
  {:name :the-index-does-not-fit :work-len 200 :expected -8
   :why "The mini index is 268 bytes and 200 is offered. The object refuses
         before clearing anything, so a workspace too small is not a workspace
         partly overwritten."}
  {:name :a-token-string-runs-past-the-window
   :model-len 40 :merge-count 0 :expected -9
   :why "Token 0 ends at 33 and token 1's length prefix would end at 41. The
         merge count is zeroed so that -7, which fires on the same window,
         does not fire first."}
  {:name :a-merge-string-runs-past-the-window
   :model-len 104 :expected -10
   :why "Rank 0 ends at exactly 104; rank 1's length prefix would end at 112."}
  {:name :a-merge-carries-no-separator
   :model-hex :model-hex-no-separator :merge-count 1 :expected -12
   :why "llama.cpp splits at `word.find(' ', 1)`, so a merge with no space at
         index one or beyond has no sides. Its loader records that as the pair
         (\"\", \"\") and carries on; this refuses."}
  {:name :a-merge-names-a-left-side-the-vocabulary-lacks
   :model-hex :model-hex-unknown-left :merge-count 1 :expected -13}
  {:name :a-merge-names-a-right-side-the-vocabulary-lacks
   :model-hex :model-hex-unknown-right :merge-count 1 :expected -14}
  {:name :model-window-above-sixteen-mebibytes
   :model-len 16777217 :expected -16}]}
