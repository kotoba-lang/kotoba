;; AIUEOS K16 xHCI Debug Capability live transport contract.
;; This is a firmware-only connectivity qualification, not native-core or SSD evidence.
{:format :aiueos.dbc-live/v1
 :target {:model :gmktec-k16
          :observed-controller-count 5
          :observed-dbc [{:bdf "e5:00.3" :offset 0x4e0}
                         {:bdf "e5:00.4" :offset 0x4e0}
                         {:bdf "e6:00.0" :offset 0x460}
                         {:bdf "e6:00.3" :offset 0x480}
                         {:bdf "e6:00.4" :offset 0x480}]}
 :transport {:kind :xhci-dbc
             :direction :duplex
             :usb {:vendor-id 0xffff :product-id 0xa11e
                   :host-in-endpoint 0x81 :host-out-endpoint 0x01}
             :target-to-host-ring :dbc-out-transfer-ring
             :host-to-target-ring :dbc-in-transfer-ring
             :host-client :macos-libusb-normal-user}
 :memory {:allocation :uefi-pci-io-common-buffer
          :pages-per-controller 1
          :bytes-per-controller 4096
          :event-ring-trbs 16
          :transfer-ring-trbs 16}
 :network-telemetry
 {:kind :uefi-pxe-base-code-udp
  :host-listen "10.77.0.1:7777"
  :target-address "10.77.0.10"
  :boot-transport :dhcpv4-tftp
  :host-server :macos-normal-user
  :physical-observation
  {:date "2026-08-28"
   :target-mac "70:70:fc:0b:b6:32"
   :efi-bytes 13824
   :state :received-live
   :controllers 5
   :dbc-state {:dce 1 :debug-port 0 :ccs 0 :ped 0 :pls 5 :speed 0 :dcr 0}}
  :control
  {:listen "10.77.0.10:7778"
   :allowed-source "10.77.0.1"
   :authorization :per-boot-nonce
   :commands [:ping :reboot-pxe]
   :reboot-pxe {:boot-current-read? true
                :boot-next-one-shot-write? true
                :boot-order-write? false
                :fail-closed-before-reset? true}
   :physical-state :received-live
   :physical-observation
   {:date "2026-08-28"
    :boot-current 0x0002
    :boot-next 0x0002
    :initial-nonce "0000000e4c3c4a20"
    :returned-nonce "00000008707b3ca0"
    :automatic-pxe-return? true
    :post-return-ping? true
    :efi-bytes 17408
    :efi-sha256 "fcca6d1b174dbd0076e6a685da022577c926437825a6431a4cfd6319058ce924"
    :evidence-sha256 "83c14f82cf1e4159c9cd67ade9a499a2483e54fde1e2ffb6dcbc84e2a6d634de"}}
  :does-not-qualify [:native-core-boot :xhci-dbc-duplex :ssd-install]}
 :safety {:exit-boot-services? false
          :block-io-opened? false
          :internal-disk-writes? false
          :qualification-usb-runtime-writes? false
          :boot-order-writes? false
          :boot-next-one-shot-write? true
          :ssd-install? false}
 :physical-gate {:state :unverified
                 :requires ["AIUEOS_DBC_MAC_CONNECTED direction=duplex"
                            "AIUEOS_DBC_MAC_RX ... AIUEOS_DBC_LIVE"
                            "a later heartbeat with rx>=1"]
                 :meaning :mac-k16-real-time-duplex-only}}
