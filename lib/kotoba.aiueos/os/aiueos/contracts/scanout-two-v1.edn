;; Two virtio-gpu scanouts (ADR-0095). Bind count is Kotoba; C mechanism only.
{:format :aiueos.scanout-two/v1
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_scanout_bind"
          :count-from "kotoba_aiueos_scanout_bind"}
 :vectors {:two-scanouts-bound :ok
           :one-scanout :leftover
           :one-resource :leftover}
 :trusts-caller-for [:native-phase6-compositor
                     :physical-boot
                     :permission-broker]
 :verification {:off-target :impossible
                :reason :kir-refuses-kernel-memory
                :evidence "nbb --classpath src scripts/compositor-guest.cljk guest-scanout-two"}
}
