;; The declaration kotoba-native's `kernel-object-entries` transcribes -- in
;; BOTH `elf64.clj` and `elf64.cljc` -- so that the export symbol is stated by
;; the repository that owns the decision.
{:format :aiueos.qwen35-detokenize/v1
 :graph {:root aiueos.qwen35-detokenize
         :modules [aiueos.qwen35-detokenize]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_detokenize"
          :imports []
          :required-operations [kernel-load-u8 kernel-load-u32
                                kernel-store-u8 kernel-store-u32 kernel-subregion]}
 :arguments [:model-base :model-length :work-base :work-length]

 ;; Same prelude as the tokenizer's, and for the same reason: this object reads
 ;; the token offset table a third object writes, and a kernel object cannot
 ;; call another (ADR-0030).
 :prelude {:graph {:root aiueos.qwen35-vocab-index-build
                   :modules [aiueos.qwen35-vocab-index-build]}
           :entry aiueos-qwen35-vocab-index-build
           :expected 0}

 ;; WHY THIS OBJECT EXISTS.
 ;; A decode loop that cannot turn ids back into bytes has produced nothing a
 ;; person can read. The token offset table is what makes this a lookup rather
 ;; than a walk: token 173,092's string is at a file offset the table already
 ;; holds, so nothing traverses 173,092 length-prefixed strings to find it.

 :result {:kind :reason-code :admit 0 :range [-34 -1] :truthy-is-success false
          :byte-count-goes-to-workspace-slot 92}
 :reasons {0 :detokenized
           -1 :null-model-base
           -2 :null-workspace-base
           -3 :workspace-below-the-header
           -4 :workspace-carries-no-index
           -5 :model-window-above-16-mib
           -6 :more-than-32768-ids
           -7 :id-input-outside-the-workspace
           -8 :text-output-outside-the-workspace
           -9 :index-tables-outside-the-workspace
           -31 :id-at-or-above-the-vocabulary-count
           -32 :token-string-past-the-model-window
           -33 :codepoint-not-in-the-byte-alphabet
           -34 :text-output-capacity-exhausted}

 ;; -9 cannot be reached THROUGH THIS RUNNER: the prelude writes header slot 40
 ;; after `prepare` has built the image. It remains reachable from a caller that
 ;; corrupts the workspace between the two calls.
 :unreachable-by-construction [-9]

 ;; `unicode_utf8_to_byte`: the inverse of the alphabet the tokenizer maps
 ;; into. 33..126, 161..172 and 174..255 stand for themselves; U+0100..U+0143
 ;; carry 0x00..0x20, 0x7F..0xA0 and 0xAD.
 :decoding {:alphabet :gpt2-byte-to-unicode-inverse
            :unmappable-codepoint -33
            :llama-cpp-behaviour "substitutes the literal text [UNK_BYTE_0x..]
                                  and carries on, which then flows to whoever
                                  reads the output"}

 ;; With `tokenizer.ggml.token_type` (header slot 44, 0 = the caller did not
 ;; supply it): 3 CONTROL and 5 UNUSED render as nothing, 4 USER_DEFINED
 ;; renders VERBATIM rather than byte-decoded, everything else is byte-decoded.
 ;; That is `token_to_piece`'s switch with `special = false`.
 ;;
 ;; WITHOUT it every id is byte-decoded, so BOS and EOS come out as their
 ;; literal spellings rather than silently vanishing -- a visible
 ;; `<|endoftext|>` is a bug report and a silently dropped one is a mystery.
 ;;
 ;; ⚠ The GGUF `token_type` values and llama.cpp's own `llama_token_attr` bit
 ;; flags are DIFFERENT enumerations that its loader assigns across without a
 ;; conversion. This object reads the GGUF value, which is what the file
 ;; carries. These vectors set slot 44 to 0; the token_type arms are exercised
 ;; in test/aiueos/qwen35_tokenizer_parity_test.cljk.
 :token-type {:header-slot 44 :absent 0
              3 :renders-nothing 5 :renders-nothing
              4 :verbatim :otherwise :byte-decoded}

 :verification
 {:off-target :executed
  :mechanism :kir-execute-with-a-supplied-memory-image
  :runner "os/aiueos/scripts/verify-admissions.cljk"
  :host :nbb
  :node-stack-size 60000
  :memory {:base 65536 :image-bytes 19584
           :work-offset 128 :work-bytes 19456
           :input-offset 512 :output-offset 1536 :output-capacity 64
           :scratch-offset 2048 :scratch-bytes 16384
           :ids-offset 18432 :text-offset 18688 :text-capacity 256}
  :fuel 400000000
  :floors {:minimum-vectors 12
           :minimum-memory-assertions 6
           :every-reachable-reason-observed true}}

 :fixture
 {:vocab-count 7 :merge-count 2 :tokens-at 24 :merges-at 93
  :model-hex "0000000000000000000000000000000000000000000000000100000000000000610100000000000000620100000000000000630200000000000000c4a0020000000000000061620300000000000000c4a0610300000000000000e3818203000000000000006120620400000000000000c4a02061"}

 :vectors
 ;; id 0 "a"  1 "b"  2 "c"  3 "G"(U+0120, byte 0x20)  4 "ab"  5 "Ga"  6 "あ"
 [{:name :a-merged-token-is-its-bytes
   :ids [4] :expected 0 :expect-text-hex "6162" :expect-text-length 2}
  {:name :the-alphabet-is-inverted-not-copied
   :ids [3 4] :expected 0 :expect-text-hex "206162" :expect-text-length 3
   :why "Token 3's stored bytes are C4 A0 -- U+0120 -- and the byte it stands
         for is 0x20. A detokenizer that copied the stored bytes would emit
         three bytes for the space alone."}
  {:name :three-single-byte-tokens
   :ids [0 1 2] :expected 0 :expect-text-hex "616263" :expect-text-length 3}
  {:name :no-ids-produce-no-bytes
   :ids [] :expected 0 :expect-text-length 0}

  {:name :null-model-base :model-base 0 :expected -1}
  {:name :null-workspace-base :work-base 0 :expected -2}
  {:name :workspace-below-the-header :work-len 127 :expected -3}
  {:name :no-index-in-the-workspace :prelude? false :expected -4}
  {:name :model-window-above-sixteen-mebibytes :model-len 16777217 :expected -5}
  {:name :more-than-thirty-two-kibi-ids :header {80 32769} :expected -6}
  {:name :the-id-input-leaves-the-workspace :header {76 19452 80 64} :expected -7}
  {:name :the-text-output-leaves-the-workspace :header {84 19452 88 256} :expected -8}
  {:name :an-id-at-the-vocabulary-count
   :ids [7] :expected -31
   :why "Seven tokens are ids 0..6. Reading token 7 would read whatever four
         bytes follow the offset table."}
  {:name :a-token-string-past-the-model-window
   :ids [6] :model-len 75 :expected -32
   :why "Token 6's element begins at file offset 82. The window ends at 75, so
         the length prefix itself is outside it."}
  {:name :a-codepoint-that-is-not-in-the-alphabet
   :ids [6] :expected -33
   :why "Token 6 is the three bytes of あ (U+3042), which is not one of the 256
         the alphabet carries. No input can produce this token -- every encoded
         byte is ASCII or a C3/C4 lead -- so it is in the fixture only to reach
         this clause."}
  {:name :the-text-capacity-is-exhausted
   :ids [4] :header {88 1} :expected -34
   :why "Two bytes into one. The refusal is on the second byte."}]}
