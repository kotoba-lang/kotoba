{:format :aiueos.kototama-runtime-update/v1
 :owner :aiueos-base
 :runtime :kototama
 :authority {:decision [:grant.publisher :grant.ota :grant.update]
             :publisher :threshold-release-root
             :anti-rollback :monotonic-runtime-sequence}
 :distribution {:developer-source :west-pinned-release
                :device-pull "https://ipfs.kotobase.net/ipfs/{cid}"
                :immutable? true
                :git-on-device? false}
 :artifacts {:required [:component :guest]
             :admission [:exact-bytes :sha256 :target
                         :minimum-aiueos-abi :minimum-kototama-runtime-abi]}
 :activation {:class :blue-green
              :write :inactive-runtime-only
              :probe-before-switch? true
              :drain-previous-after-switch? true
              :kernel-reboot? false}
 :health {:required [:runtime-admission :model-bind :murakumo-result]
          :unknown :wait-bounded
          :failure :rollback-runtime-only
          :timeout-ms 120000}
 :management {:https-control [:status :restart-runtime]
              :ssh-command-session ["runtime status" "runtime restart"
                                    "system reboot-pxe"]
              :system-control [:reboot-pxe]
              :root-shell? false}
 :current-evidence {:decision-and-negative-tests :implemented
                    :kernel-runtime-supervisor :implemented
                    :murakumo-restart-runtime-control :implemented
                    :ssh-command-dispatch-qemu :implemented
                    :bare-metal-runtime-byte-pull :not-yet-implemented
                    :physical-k16-ssh-listener :unverified}
 :never [:west-pull-on-device :git-pull-on-device :write-active-runtime
         :runtime-failure-reboots-kernel :ssh-root-shell]}
