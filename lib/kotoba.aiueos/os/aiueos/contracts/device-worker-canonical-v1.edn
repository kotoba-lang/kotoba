  ;; --- refusals. One vector per reason, each naming the clause that fires. ---
  {:name :ctx-region-too-small
   :operation :poll :protocol 2 :stop-reason :-
   :sequence 1 :ctx-len 575 :expected -1
   :why "The declared region is one byte short of the fixed layout. Refused
         before a single byte is read, which is why a caller that under-declares
         cannot get a partially written canonical text back."}
  {:name :out-region-too-small
   :operation :poll :protocol 2 :stop-reason :-
   :sequence 1 :out-cap 1023 :expected -2
   :why "1023 is one byte below the widest form plus its ceiling. The object
         does not write what fits and truncate; a truncated canonical text is a
         signature over a different assertion."}
  {:name :protocol-4-is-not-a-protocol
   :operation :poll :protocol 4 :stop-reason :-
   :sequence 1 :expected -3
   :why "`:protocol must be absent for v1, 2, or 3` is the server's literal.
         The device refuses on its own side too: protocol is the one integer
         that decides which job kinds it can settle, and a device that signed a
         4 would be asking for jobs it has no canonical form for."}
  {:name :operation-9-is-not-an-operation
   :operation :poll :operation-code 9 :protocol 2 :stop-reason :-
   :sequence 1 :expected -4
   :why "9 has no name in this protocol, so the vector supplies the byte
         directly rather than the contract inventing a keyword for it."}
  {:name :a-v3-result-must-name-why-it-stopped
   :operation :result :protocol 3 :stop-reason :-
   :sequence 12 :job-id 1788078031098390
   :token 2005 :second-token 17 :generated-tokens 3 :decode-tokens 2
   :first-token-cycles 12000000000 :decode-cycles 24000000000
   :inference-cycles 36000000000 :vector-bits 256 :worker-threads 2
   :output-token-count 3
   :expected -5
   :why "The sentinel `-` on a result. The server calls this `protocol 3 result
         must name the job input it settles`; refusing here means the device
         never spends a signature on a result the server will reject."}
  {:name :a-v2-poll-may-not-carry-a-stop-reason
   :operation :poll :protocol 2 :stop-reason :eos
   :sequence 1 :expected -5
   :why "Protocol 2 has no stop-reason field at all, so the byte must be the
         sentinel. The same reason code, a different clause: `stop-ok` splits
         on the protocol before it splits on the operation."}
  {:name :a-cycle-counter-at-two-to-the-56
   :operation :result :protocol 2 :stop-reason :-
   :sequence 7 :job-id 42 :token 2005 :second-token 17
   :generated-tokens 8 :decode-tokens 7
   :first-token-cycles 72057594037927936 :decode-cycles 56000000000
   :inference-cycles 68000000000 :vector-bits 256 :worker-threads 2
   :expected -6
   :why "2^56 exactly. The decimal writer stops at seventeen digits because
         `digit-at` computes `p * 10` and 10^18 is the largest power of ten
         that stays in i64. A value it cannot render is refused rather than
         rendered short -- a canonical number that lost its high digits is a
         signature over a smaller claim."}
  {:name :protocol-2-carrying-an-output-token-count
   :operation :result :protocol 2 :stop-reason :-
   :sequence 7 :job-id 42 :token 2005 :second-token 17
   :generated-tokens 8 :decode-tokens 7
   :first-token-cycles 12000000000 :decode-cycles 56000000000
   :inference-cycles 68000000000 :vector-bits 256 :worker-threads 2
   :output-token-count 3
   :expected -7
   :why "`protocol 1 and 2 must not carry protocol 3 fields`, enforced on the
         writing side. The v2 canonical form has no slot for the count, so a
         context that carries one is a caller that thinks it is speaking v3."}
  {:name :protocol-2-carrying-a-stop-reason-byte
   :operation :result :protocol 2 :stop-reason-code 3
   :sequence 7 :job-id 42 :token 2005 :second-token 17
   :generated-tokens 8 :decode-tokens 7
   :first-token-cycles 12000000000 :decode-cycles 56000000000
   :inference-cycles 68000000000 :vector-bits 256 :worker-threads 2
   :expected -5
   :why "The other half of the same rule, and it fires as -5 rather than -7
         because `stop-ok` is checked first. Recorded so a reader does not
         expect -7 here."}]}
