  :ECDSA_SIGN :profile     ; main.c:1534  #ifdef AIUEOS_ECDSA_SIGN_KAT
  :PANIC_RECEIPT :profile  ; main.c:3092  #ifdef AIUEOS_CRASH_RECEIPT_SMOKE
  :RANDOM :profile         ; main.c:2934  #ifdef AIUEOS_SSH_LISTEN
  :SSH_KEX :profile        ; main.c:2955  #ifdef AIUEOS_SSH_LISTEN
  :SSH_LISTEN :profile     ; main.c:3539  #ifdef AIUEOS_SSH_LISTEN
  ;; :TSC_CALIBRATED is :profile for a DIFFERENT reason, and the difference is
  ;; worth keeping: its emission is unconditional (main.c, after
  ;; AIUEOS_SERIAL_OK), so the scan above classifies it as ungated. What is
  ;; gated is the VALUE -- uefi/main.c calibrates tsc_hz only under
  ;; `#ifdef AIUEOS_QWEN38_MODEL_HANDOFF`, so in the default build the
