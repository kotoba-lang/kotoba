  :LOADER_MODEL :model-artifact  :MODEL_SLOT :model-artifact
  :MODEL_HANDOFF :model-artifact  :QWEN35_ADMISSION :model-artifact
  :QWEN35_GENERATE :model-artifact  :QWEN35_GRAPH :model-artifact
  :QWEN35_WORKSPACE :model-artifact
  ;; needs a profile nothing here runs
  :NETBOOT_EMBEDDED :profile  :LOADER_RECOVERY :profile
  ;; Attributed 2026-09-10 by MEASUREMENT rather than judgement: each of these
