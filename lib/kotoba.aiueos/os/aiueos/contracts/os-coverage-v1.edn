  ;; walk plus the run11-13 machine config, MEASURED in run-qemu-d1-serial13.py
  ;; (`-machine q35,accel=tcg`, `-cpu max`, ZERO `-device` lines). The run
  ;; presents no virtio device at all, so the vendor=1af4 scan finds nothing
  ;; and every _OK below is unreachable -- structural gate named, not the
  ;; window (ZERO_CAP_USER precedent): the sites also sit below the first
  ;; invoke (:run-window above), but a longer window alone cannot emit these;
  ;; it can only turn the boot into its own FAIL exit.
  ;; VIRTIO_RNG (main.c:5584-85) is behind `if (pci_result < 2)` ->
  ;; AIUEOS_VIRTIO_FAIL rng-queue + qemu_exit(0x73): without a virtio-rng
  ;; device the run can only FAIL, never emit OK. VIRTIO_RNG_MSIX (5589-90)
  ;; additionally needs aiueos_virtio_rng_irq_count == 1 (irq FROM that
  ;; device). VIRTIO_BLK (5649-50) is behind `if ((pci_result & 3) != 3)` ->
  ;; VIRTIO_BLK_FAIL + qemu_exit(0x71); VIRTIO_BLK_MSIX (5667-68) needs
  ;; irq_count >= 5 from its completions. VIRTIO_NET (7539-40) is the OPTIONAL
  ;; link report (aiueos_virtio_net_ready): a boot with no NIC stays green by
  ;; design and the marker stays silent -- presence cannot be reported where
  ;; no device was ever attached.
  ;; SECOND WALL for VIRTIO_BLK/BLK_MSIX, measured and not assumed: run
  ;; configs that DO attach virtio-blk (run-fmt-pair, JUN-34 bisect) currently
  ;; emit AIUEOS_VIRTIO_BLK_FAIL capacity-or-read (regression bisected in
  ;; JUN-34). Attach-a-device is necessary and, for blk today, not sufficient.
  :VIRTIO_RNG :run-config
  :VIRTIO_RNG_MSIX :run-config
  :VIRTIO_BLK :run-config
  :VIRTIO_BLK_MSIX :run-config
  :VIRTIO_NET :run-config
  ;; Display-row context markers with the same gate, kept here so the map does
  ;; not go stale when they re-enter scoring: VIRTIO_GPU (7492, behind
  ;; `pci_result & 8`) and VIRTIO_INPUT (5874-78, behind the `pci_result & 4`
  ;; input-device branch). Context rows are excluded from the tally either way.
  :VIRTIO_GPU :run-config
  :VIRTIO_INPUT :run-config
  ;; Attributed 2026-11-02 (storage region, 13 markers) by the same method,
  ;; with a POSITIVE control this time: the JUN-34 acceptance-chain boot
  ;; (kotoba-rev970, lib/kotoba.aiueos/docs/evidence/
  ;; aiueos-jun31-acceptance-chain-20261024/kernel-serial.log) ran WITH
  ;; virtio-rng + virtio-blk and emitted every marker below in source order:
  ;;   VIRTIO_RNG_OK VIRTIO_RNG_MSIX_OK VIRTIO_BLK_OK VIRTIO_BLK_MSIX_OK ->
  ;;   OBJECT_STORE_OK KOTOBA_APP_ADMISSION_OK KOTOBA_CATALOG_POLICY_SELFTEST_OK
  ;;   JOURNAL_OK OBJECT_TXN_OK KOTOBA_JOURNAL_PLAN_OK KOTOBA_FNV_OK
  ;;   KOTOBA_RECORD_VALIDATION_OK KOTOBA_STORAGE_READ_VALIDATION_OK
  ;;   KOTOBA_STORAGE_WRITE_OK SERVICE_REGISTRY_OK KOTOBA_PCI_PLANNER_OK
  ;; -- which is the flow order of kernel/main.c 5583 -> 5648 -> 5676 -> 5807
  ;; and proves the region is code-complete AND the gates are in series.
  ;; The region is downstream of two fail-stop gates: `if (pci_result < 2)`
  ;; (main.c:5583) -> AIUEOS_VIRTIO_FAIL rng-queue + qemu_exit(0x73), and
  ;; `if ((pci_result & 3) != 3)` (main.c:5648) -> VIRTIO_BLK_FAIL +
  ;; qemu_exit(0x71). run11-13 present NEITHER device -- MEASURED in
  ;; run-qemu-d1-serial13.py: `-machine q35,accel=tcg`, `-cpu max`, and the
  ;; disk on `-drive format=raw,file=IMG` (default if=ide AHCI), ZERO virtio
  ;; devices -- so a longer window alone cannot emit any of the thirteen; it
  ;; can only turn the boot into its own exit 0x73 at the rng gate. Structural
  ;; gate named per the ZERO_CAP_USER precedent (:run-window is stacked
  ;; underneath: the sites are also below the first invoke :4776).
  ;; SECOND WALL for the region, measured and not assumed: runs that DO attach
  ;; virtio-blk today (run-fmt-pair, JUN-34 bisect) emit
  ;; AIUEOS_VIRTIO_BLK_FAIL capacity-or-read and exit 0x71 at :5650, before
  ;; OBJECT_STORE. The acceptance chain above is one of the green passes.
  ;; Local gates named so the labels do not over-claim: OBJECT_STORE (5678-79,
  ;; after fail-stop `!aiueos_object_store_ready()` -> qemu_exit 0x70),
  ;; KOTOBA_APP_ADMISSION (:5686-88, unconditional), JOURNAL (5710-11, after
  ;; two fail-stop checks), OBJECT_TXN (serial :5749, after the F2/UHCI
  ;; blocks), KOTOBA_JOURNAL_PLAN/FNV (5750-53) and the three validation
  ;; serials (5754-56) unconditional, SERVICE_REGISTRY (5805-06, after
  ;; fail-stop `!aiueos_service_registry_ready()`), KOTOBA_PCI_PLANNER (5807,
  ;; serial-only, unconditional). Two carry one runtime condition each --
  ;; KOTOBA_CATALOG_POLICY_SELFTEST (`if (aiueos_catalog_policy_selftest_ok())`)
  ;; and OBJECT_STORE_RESTORE (5693-97, `restored >= 1`: the blank-volume
  ;; initramfs-restore route). The acceptance-chain boot took the PRE-POPULATED
  ;; route and emitted neither, which is a route difference, not a gap.
  :OBJECT_STORE :run-config
  :KOTOBA_APP_ADMISSION :run-config
  :OBJECT_STORE_RESTORE :run-config
  :KOTOBA_CATALOG_POLICY_SELFTEST :run-config
  :JOURNAL :run-config
  :OBJECT_TXN :run-config
  :KOTOBA_JOURNAL_PLAN :run-config
  :KOTOBA_FNV :run-config
  :KOTOBA_RECORD_VALIDATION :run-config
  :KOTOBA_STORAGE_READ_VALIDATION :run-config
  :KOTOBA_STORAGE_WRITE :run-config
  :SERVICE_REGISTRY :run-config
  :KOTOBA_PCI_PLANNER :run-config
  ;; Attributed 2026-11-02 (restart group, 4 markers): all four sit inside
  ;; `if (aiueos_journal_recovered())` (kernel/main.c:5808; the flag is set
  ;; only when a boot finds committed journal state from a previous run --
  ;; kernel/pci.c:339). run11-13 are single clean boots on a volatile
  ;; workspace (guest writes 0, measured; WORKSPACE_OK storage=volatile-ram),
  ;; and the JUN-34 acceptance chain above is ALSO a single clean boot: it
  ;; passes SERVICE_REGISTRY and KOTOBA_PCI_PLANNER and then shows the block
  ;; skipped (no JOURNAL_RECOVERY in its sequence). A restart over a persisted
  ;; journal proves all four and nothing else can -- a two-boot chain like
  ;; CRASH_RECEIPT, without the fault. KOTOBA_OBJECT_REPLAY carries one extra
  ;; condition inside the block (:5827,
  ;; `aiueos_user_object_replay_evidence_ready()`). The :run-config region gate
  ;; above is stacked underneath these too.
  :JOURNAL_RECOVERY :restart-scenario
  :OBJECT_TXN_REPLAY :restart-scenario
  :PERSISTENT_SERVICE_BOOTSTRAP :restart-scenario
  :KOTOBA_OBJECT_REPLAY :restart-scenario
  ;; CORRECTION PENDING (flagged by this walk, not changed here): FS_CREATE/
  ;; FS_RENAME/FS_DELETE/FS_ATOMIC (:5718-22) and OBJECT_STORE_FORMAT (:5684-
  ;; 85), currently :run-window, and IOAPIC (:7778), also :run-window, sit in
  ;; or below the same region and therefore behind the same two virtio gates.
  ;; By the structural-gate-not-window rule above they belong with :run-config;
  ;; APIC_TIMER (:5540) is the one :run-window marker that IS window-only --
  ;; it sits before the rng gate. Next tick should settle this correction so
  ;; the map does not tell run14 that a longer window alone can reach them.
  }

