  ;;   :SSH_KEX_REPLY  pci.c:3120    :SSH_AUTH     main.c:3558
  ;;   :SSH_SESSION    main.c:3563   :SSH_KEX      main.c:2955
  ;;   :SSH_LISTEN     main.c:3539
  ;;
  ;; So in the DEFAULT build none of them can appear at all: the server is not
