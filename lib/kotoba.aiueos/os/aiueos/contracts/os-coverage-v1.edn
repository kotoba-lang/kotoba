  ;; the guest a TCP peer without any external network") and ships
  ;; `-netdev user,...,guestfwd=... -device virtio-net-pci,...` as the
  ;; standard net_args. Every exchange must be kotoba-admitted. run11-13
  ;; attach ZERO -device lines (MEASURED run-qemu-d1-serial13.py:45-48), so
  ;; the link layer cannot even report. POSITIVE control: the same
  ;; qualification receipts emit all three -- IPV4_OK 15, DHCP_OK 17
  ;; (vm-20261024/dhcp + dhcp-suite), TCP_OK 14. Closing = the standard
  ;; smoke net_args: attach the probe-OK virtio-net-pci device under
  ;; user-net+guestfwd -- a config change, same class as VIRTIO_NET.
  :IPV4 :run-config
  :DHCP :run-config
  :TCP :run-config
  ;; Attributed 2026-11-03 (the last three :unclassified: VTD / VTD_IR /
  ;; DMA_POLICY) by MEASUREMENT, not inference. The hold below said the bucket
  ;; depended on a DMAR presence that was UNMEASURED -- so it was measured:
  ;; AIUEOS_TEST_DMAR=1 sh os/aiueos/scripts/smoke-qemu-uefi.sh (the switch at
  ;; smoke-qemu-uefi.sh:338 adds `-device intel-iommu,intremap=on`) on the
  ;; PR-1177 worktree at 82c9295d6 exits 0 (AIUEOS_UEFI_SMOKE_OK), the guest
  ;; firmware presents the table -- uefi-debug.log:21
  ;; AIUEOS_ACPI_RETAIN_OK source=firmware copy=low-identity tables=APIC+DMAR
  ;; -- and the kernel emits all three with qualifying payloads:
  ;; kernel-serial.log:46 AIUEOS_VTD_OK tes=1 root-context-slpt domain=1
  ;; aperture=128MiB, :47 AIUEOS_DMA_POLICY_OK dmar=validated dma=vtd-isolated
  ;; (the :requires-payload "validated" case), :57 AIUEOS_VTD_IR_OK irta=256
  ;; source-validated vector=35 remappable-msix. Negative control, same
  ;; instrument: the 21 qualification receipts on DMAR-less q35 all read
  ;; AIUEOS_DMA_POLICY_OK dmar=absent test-only-unisolated and zero read
  ;; VTD_OK or VTD_IR_OK (0 occurrences across qualification/). Exactly one
  ;; config knob separates the two outcomes -- the DMAR-present run config --
  ;; so all three are :run-config. Emission sites (82c9295d6): the gate is
  ;; aiueos_vtd_initialize (main.c:5501; vtd.c:87-88 VTD_PLAN_ABSENT ->
  ;; return 1 succeeds by design on DMAR-less q35), VTD_OK :5512 and
  ;; DMA_POLICY :5513-5517 hang off its translation_enabled answer;
  ;; VTD_IR_OK (:5671) sits BELOW the blk fail-stop gate (:5647
  ;; qemu_exit 0x71) like the rest of the tail, so it additionally needs the
  ;; standard smoke devices. The K16 transfer caveat is UNCHANGED and is not
  ;; spent by this attribution: the board is AMD -- its table is IVRS, which
  ;; stays :board -- and these three are proved under QEMU emulating Intel
  ;; VT-d, coverage the ledger CAVEAT (2026-09-09) records as non-transferring
  ;; to that silicon. Whether the physical K16's own ACPI carries DMAR is a
  ;; measurement for a powered board and moves no bucket here.
  :VTD :run-config
  :VTD_IR :run-config
  :DMA_POLICY :run-config
  }

