  ;; (kernel/main.c:3949-3951, aiueos_crash_receipt_write_from_fault,
  ;; kernel/pci.c:765). A clean boot must never emit it -- absence here is
  ;; correctness, not a gap. The deterministic exercise is the synthetic
  ;; unexpected ud2 behind #ifdef AIUEOS_FAULT_RECEIPT_SMOKE (main.c:5776-
  ;; 5784). Waits on an induced-fault scenario, not on code someone could
  ;; write.
  :FAULT_RECEIPT :fault-scenario
  ;; CRASH_RECEIPT is the CONSUME half (main.c:5762-5766) and fires only
