  ;; ZERO_CAP_USER cannot be emitted by the default build at all: its emission
  ;; (kernel/main.c:7837) sits inside #ifdef AIUEOS_ZERO_CAP_USER_SMOKE
  ;; (kernel/main.c:7824, block ends :7839). MEASURED by walking back from the
  ;; emission site to its enclosing preprocessor guard, same method as the six
  ;; :profile markers above.
  :ZERO_CAP_USER :profile
  ;; A missing SCENARIO, not a code gap -- a real recovery boot proves both.
  ;; MEASURED: run13 debug13.log line 12 is AIUEOS_RECOVERY_ID_ABSENT (normal
  ;; boot, no RECOVERY.ID on the ESP), while
  ;; qualification/receipts/vm-20261025/h3-recovery-reinstall (2026-10-25,
  ;; commit 7bcfbd73) records AIUEOS_RECOVERY_ID_OK -> RECOVERY_TARGET_FOUND
  ;; and AIUEOS_RECOVERY_REINSTALL_OK boot-chain-restored both green. run11-13
  ;; are the wrong scenario, so 0/N here means "not exercised", not "broken".
  ;; CHANNEL TRAP: both are debug_string only (uefi/main.c:999, :1024) -- outb
  ;; 0xe9 debugcon, never serial -- so a serial evidence log can carry
  ;; RECOVERY_ID_ABSENT but cannot carry the _OK forms even in a recovery boot.
  ;; The debugcon stream is the only witness; scoring this row from serial
  ;; logs alone can never close it.
  :RECOVERY_ID :recovery-scenario
  :RECOVERY_REINSTALL :recovery-scenario
  ;; Emissions that run11-13 never REACHED -- the window closes first. All
