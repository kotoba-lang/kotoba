;; What "AIUEOS installs from a USB stick" means, as checkable data
;; (root ADR adr-2608251418-aiueos-usb-install-and-headless-bootstrap).
;;
;; The USB-boot contract (usb-boot-v1.edn) proves the release image boots as
;; removable media. That is not an install: an install is the one continuous
;; chain from a booted USB to an internal SSD that boots on its own, takes a
;; wired DHCP lease, and accepts one named SSH key from another host. This
;; contract records that chain, the refusal classes that protect it, and --
;; separately, so a green piece is never mistaken for the green whole -- the
;; current state of each exit gate. Gate I0 of the root ADR requires this
;; matrix and the root ADR's matrix to say the same thing.
{:format :aiueos.install-contract/v1
 :profile :bare-metal-uefi
 :architecture :x86_64
 :authority {:installer :aiueos          ; target admission, write/readback, receipts
             :artifact [:amu :kotoba]    ; checked artifacts the installer consumes
             :identity [:grant :device]} ; machine identity, enrollment, revocation

 ;; Decision 1: the product is complete only when this whole chain is proved
 ;; by one release receipt. Each step is also reported alone, and none of the
 ;; individual greens may be summed into "install complete".
 :completion-chain
 [:usb-boots-as-removable-uefi-media
  :installer-probes-hardware-read-only
  :intent-admits-exactly-one-named-whole-internal-disk
  :image-written-and-digest-read-back-through-same-descriptor
  :internal-ssd-boots-with-usb-removed
  :first-boot-takes-wired-dhcp-and-fixes-hostname-and-device-identity
  :external-client-authenticates-with-intent-ssh-key
  :identity-and-ssh-survive-reboot
  :reinserted-usb-refuses-unattended-re-erase]

 ;; Decision 2: unattended install is admitted by an install intent, never by
 ;; "largest disk" or a bare device name. The intent binds these fields; the
 ;; installer refuses when the probed identity does not match.
 :intent {:schema "aiueos.install-intent.v1"
          ;; Two producers, one artifact. install-intent.cljs authors an intent
          ;; ahead of time on another host; guided-install.cljs authors the same
          ;; intent at the machine, from a probe (see :guided below). A second
          ;; intent SHAPE would have been a second admission surface, so there
          ;; is not one -- both write this schema and both are verified by the
          ;; same `install-intent.cljs verify`.
          :created-by ["os/aiueos/scripts/install-intent.cljk"
                       "os/aiueos/installer/live/guided-install.cljk"]
          :binds [:release-receipt-digest
                  :release-disk-digest
                  :machine-profile
                  :target-disk-model
                  :target-disk-capacity-bounds
                  :target-disk-transport
                  :target-disk-serial-sha256 ; comparison value; serial itself never logged
                  :hostname
                  :device-claim-ref
                  :ssh-public-key
                  :ssh-public-key-fingerprint
                  :ssh-authorized-principal
                  :network-policy           ; R0 is :wired-dhcp; Wi-Fi secrets are not a required path
                  :mode                     ; :unattended | :interactive
                  :expires]
          :confirmation :owner-confirmed-phrase ; signing key binding is a later tranche
          :refuses [:intent-expired
                    :intent-release-digest-mismatch
                    :target-model-mismatch
                    :target-capacity-out-of-bounds
                    :target-transport-mismatch
                    :target-serial-mismatch]}

 ;; Decision 3 boundary: the ported installer mechanism (os/aiueos/installer/*,
 ;; legacy .mjs assets with their scope frozen) owns inspection, admission,
 ;; exclusive-open write and readback. New orchestration and gates are nbb.
 ;; The live environment splits the same way: the UKI initramfs is mechanism
 ;; only (mount, drivers, find payload by GPT GUID, extract, hand over) and
 ;; every decision -- target selection, intent admission, destruction -- runs
 ;; from the payload bundle under nbb.
 ;;
 ;; The intent ADMISSION decision also exists as a native Kotoba object
 ;; (os/aiueos/kotoba/install-intent-admit.kotoba, committed .o, contract
 ;; install-intent-admit-v1.edn, parity gate + :install-intent-admit-native
 ;; gate; aiueos ADR-0218). The CLI keeps verdict ownership for the live
 ;; flow via the parity gate -- same cases, same verdicts, machine-checked.
 ;; The object is NOT yet linked into the kernel (that is the next tranche).
 :installer {:mechanism :auditable-linux-live-environment ; install-time only, not a runtime premise
             :live {:uki "os/aiueos/scripts/make-live-installer.py"
                    :kernel :debian-stable-generic ; versions pinned per-build in live-installer-receipt.json
                    :initramfs :mechanism-only     ; busybox + storage modules + lsblk/blkid
                    :decision "os/aiueos/installer/live/install-live.cljk"
                    :target-selection
                    "exactly one whole disk matching the intent's model,
                     transport and capacity bounds, never the boot USB;
                     zero and two-plus both refuse with named reasons"
                    ;; ADR-0239: an interactive intent authored AT THIS
                    ;; CONSOLE installs once the person there types
                    ;; `ERASE <device> FOR AIUEOS`, which install.mjs checks
                    ;; exactly as it checks the unattended one. An interactive
                    ;; intent carried on the stick has nobody to type it and
                    ;; stays a dry run.
                    :interactive {:carried-on-stick :dry-run-report-only
                                  :authored-at-console :install-after-typed-destructive-phrase}
                    :unattended :intent-is-the-owner-confirmation
                    ;; ADR-0239 / ADR-0113: optional, console-authored only.
                    :account-link {:program "os/aiueos/installer/live/account-sync.cljk"
                                   :authority "https://auth.kotoba.cloud"
                                   :method :phone-scan
                                   :qr "src/aiueos/qr.cljk"
                                   :device-keys :generated-on-target-at-install
                                   :stored-in :provision-zone
                                   :declined-or-failed :install-without-account-said-so}}
             ;; What the bundle carries so the scripts on it can LOAD.
             ;; nbb.edn is not on the USB, and a sibling path resolves relative
             ;; to the file it is written in, so the 2026-09-09 move to
             ;; kotoba.lang.text reached every caller in the repository and no
             ;; caller on the medium. Measured broken 2026-09-10, fixed by
             ;; aiueos ADR-0209.
             :bundle {:classpath-root "cp/"           ; same shape as the node bundle beside it
                      :carries [:kotoba-lang-text     ; from the west sibling orgs/kotoba-lang/text
                                :aiueos-installer-guided
                                :kotoba-security      ; orgs/kotoba-lang/security; aiueos.device-auth needs it (ADR-0239)
                                :aiueos-device-auth
                                :aiueos-qr]
                      :passed-by [:init-handover :bin-nbb-shim] ; the shim: hop 2 spawns nbb by name
                      :refuses [:classpath-root-with-no-sources
                                :two-roots-differing-bytes-at-one-path]
                      :test "os/aiueos/scripts/test-install-bundle.cljk"
                      :executed-not-just-built true}
             :legacy-assets ["os/aiueos/installer/install.mjs"
                             "os/aiueos/installer/backends.mjs"
                             "os/aiueos/installer/device-policy.mjs"
                             "os/aiueos/installer/receipt.mjs"
                             "os/aiueos/installer/offline-linux-installer.sh"]
             ;; The guided installer (aiueos ADR-0208): the ubuntu-server
             ;; installer's shape on this contract's admission rules. It is an
             ;; AUTHORING tool, not a second installer -- it opens no block
             ;; device, writes no partition table and erases nothing. What it
             ;; produces is one aiueos.install-intent.v1, which then goes
             ;; through every guard below unchanged.
             ;;
             ;; Until ADR-0239 :interactive above was :dry-run-report-only for
             ;; every interactive intent, including the one the guided program
             ;; had just written -- so the stick that asks could not install.
             :guided {:program "os/aiueos/installer/live/guided-install.cljk"
                      :decision-core "src/aiueos/installer/guided.cljk" ; pure, no host interop
                      :test "os/aiueos/scripts/test-guided-install.cljk" ; 56 cases, offline
                      :modelled-on :ubuntu-server-installer-subiquity
                      :screens [:network :storage :identity :ssh :confirm]
                      :borrowed [:screen-sequence-is-data
                                 :answer-file-may-pre-answer-any-screen
                                 :interactive-sections-with-star
                                 :answers-validated-before-anything-is-probed
                                 :run-emits-the-answer-file-that-reproduces-it]
                      :refused {:device-path-as-a-storage-answer
                                "subiquity admits `path: /dev/sda`; decision 2
                                 does not. The storage screen records the MATCH
                                 the operator's pick implies -- model,
                                 transport, capacity bounds, serial digest --
                                 and the emitted intent carries no /dev/ path."
                                :language-keyboard-mirror-snap-screens
                                "no keymap layer and no package mirror exist in
                                 the live environment; a screen collecting an
                                 answer nothing reads is theatre."}
                      :answers {:schema "aiueos.install-answers.v1"
                                :sections [:network :storage :identity :ssh :confirm]
                                :complete-file-asks-nothing true
                                :partial-file-asks-the-gap true
                                ;; The walk does NOT key off :mode. That field
                                ;; says how the INSTALL runs on the target, not
                                ;; how the intent was authored; keying the walk
                                ;; off it asked an operator nothing and wrote an
                                ;; empty intent (ADR-0208).
                                :confirm-rule
                                "asked whenever any other screen was asked; a
                                 confirmation carried in from a file cannot
                                 confirm a disk chosen a minute ago"}
                      :writes-no-block-device true
                      :authority :none-added
                      ;; Reached two ways: run by hand to author an intent
                      ;; ahead of time, or run BY install-live.cljs on a stick
                      ;; that carries none (ADR-0210).
                      :entry-points ["operator runs it"
                                     "install-live.cljk when install-intent.json is absent"]
                      :probe :read-only-lsblk-nodeps
                      :fake-probe :two-key-gated ; NODE_ENV=test AND AIUEOS_GUIDED_ALLOW_FAKE_PROBE=1
                      :refuses [:answers-schema-unknown
                                :answers-mode-invalid
                                :answers-expiry-out-of-range
                                :answers-interactive-section-unknown
                                :answers-network-policy-unsupported
                                :answers-storage-model-missing
                                :answers-storage-transport-missing
                                :answers-capacity-bounds-missing
                                :answers-capacity-bounds-inverted
                                :answers-hostname-invalid
                                :answers-ssh-key-not-openssh
                                :answers-missing-confirm
                                :answers-confirm-mismatch
                                :no-candidate-disks
                                :guided-storage-pick-out-of-range
                                :guided-storage-match-rejected]
                      :exit-codes {0 :intent-written
                                   2 :refused-with-named-reasons
                                   3 :could-not-answer}}
             :orchestration "os/aiueos/scripts/install-to-disk.cljk"
             :real-writes :linux-only ; exclusive O_EXCL|O_NOFOLLOW block open; macOS inspects only
             :refuses [:partition
                       :removable-or-usb-device
                       :current-boot-or-system-disk
                       :system-disk-unidentifiable
                       :nonempty-target
                       :mounted-target
                       :capacity-smaller-than-image
                       :identity-changed-between-probe-and-open
                       :emptiness-claim-without-inspection]}

 ;; Decision 6: a successful install ends in poweroff, writes a target receipt,
 ;; and the same USB refuses to erase a valid install unattended.
 :target-receipt {:schema "aiueos.install-target-receipt.v1"
                  :location :last-mib-of-target-disk ; outside the written image extent
                  :magic "AIUEOS-INSTALL-RECEIPT-V1"
                  :binds [:intent-sha256 :image-sha256 :installed-at]
                  :repeat-safety
                  "An unattended run that finds a valid target receipt and a
                   valid AIUEOS GPT on the target refuses to install and drops
                   to inspect/rescue. Independently, the non-empty-target
                   refusal already blocks re-erase: the receipt makes the
                   refusal diagnosable, it is not the only thing preventing it."}

 ;; Decision 4: headless bootstrap is declared by reachability, not by the
 ;; presence of a key file in the image. Decision 5: Tailscale comes after the
 ;; first LAN SSH, never on the install critical path.
 ;; The SSH profile, userauth decision, provisioning and reachability floor
 ;; are specified in full in ssh-v1.edn (aiueos ADR-0101). This section keeps
 ;; only the install-side requirements.
 :headless {:contract "os/aiueos/contracts/ssh-v1.edn"
            :requires [:offline-ownership-and-mode-check-of-target-root
                       :sshd-loaded-the-provisioned-config-on-first-boot
                       :external-client-challenge-response-with-intent-key
                       :same-handshake-after-reboot
                       :wrong-key-wrong-user-stale-hostkey-refused-with-reason]
            :provisioning {:record "aiueos.provision.v1"
                           :generated-by "os/aiueos/scripts/make-provision-record.cljk"
                           :placed-by "os/aiueos/scripts/install-to-disk.cljk"
                           :host-key :legacy-ed25519-record
                           :authorized-key :copied-from-intent
                           :state :not-consumed-by-current-p256-server}
            :current-k16-pxe {:host-key :device-p256-uefi-nvram
                              :authorized-key :build-pinned-public-p256
                              :listener :rtl8125-landed-physical-unverified}
            :password-login :not-default
            :recovery :physical-path-required ; re-place authorized key from recovery env; no long-lived shared password baked into the image
            :tailscale {:position :after-first-lan-ssh
                        :auth-key :never-baked-into-image
                        :enrollment :ephemeral-bound-to-device-intent}}

 ;; Install USB artifact (gate I1): one GPT image that still boots exactly the
 ;; release ESP/recovery as removable media, plus a payload partition carrying
 ;; the release image, its receipt, the intent, and the installer bundle. The
 ;; receipt chain closes over all of them.
 ;; Two products from one builder (aiueos ADR-0210). They differ by one
 ;; payload file and by who is allowed to erase a disk without being asked.
 ;; Which one a stick is, is decided from the image alone and cross-checked:
 ;; a payload carrying an intent nobody digested, or digesting one it does not
 ;; carry, is neither product and is refused by name.
 :authoring
 {:authored-ahead-of-time
  {:built-with "--intent <file>"
   :payload-carries :INTENT.JSN
   :install :unattended-when-the-intent-says-so
   :receipt {:intent {:authoring "authored-ahead-of-time" :sha256 :present}}}
  :guided-at-the-machine
  {:built-with "--guided"
   :payload-carries :no-intent
   :install "install-live.cljk finds no intent and runs guided-install.cljk
             with the console attached; the intent it writes goes through the
             SAME fresh-probe verification and the same device-level guards.
             An intent authored ten seconds ago is not more trusted than one
             authored last week."
   :property "a stick that asks cannot be left plugged in and forgotten"
   :receipt {:intent {:authoring "guided-at-the-machine" :sha256 nil}}
   :exit-codes :propagated ; 2 named refusal / 3 could-not-answer, never flattened
   :chain-difference
   "completion-chain step :intent-admits-exactly-one-named-whole-internal-disk
    is preceded by authoring rather than by reading INTENT.JSN; every later
    step is byte-for-byte the same path."}
  :refuses [:guided-and-intent-together
            :neither-guided-nor-intent
            :payload-carries-an-intent-sha256s-does-not-list
            :sha256s-lists-an-intent-the-payload-does-not-carry]}

 :install-usb {:image :aiueos-x86_64-install-usb.img
               :built-by "os/aiueos/scripts/make-install-usb-image.py"
               :receipt {:schema "aiueos.install-usb-receipt.v1"
                         :chain [:release-build-receipt-sha256
                                 :release-disk-sha256
                                 :intent-sha256
                                 :payload-file-sha256s
                                 :usb-image-sha256]}
               :payload-partition {:type :microsoft-basic-data
                                   :filesystem :fat32
                                   :name "aiueos install payload"}
               ;; Two boot modes, chosen at build time and named in the
               ;; receipt's :boot section. aiueos-direct keeps the release
               ;; ESP byte-identical at its original LBAs (the ADR-0019 boot
               ;; claim). live-installer boots the installer UKI from p1 and
               ;; keeps the release RECOVERY volume byte-identical as the
               ;; independent aiueos fallback; the install product boots this
               ;; mode.
               :boot-modes {:aiueos-direct :esp-and-recovery-byte-identical-to-release
                            :live-installer :uki-esp-plus-release-recovery-bytes}
               :flashed-by "os/aiueos/scripts/flash-usb.cljk --image ... --receipt ..."}

 ;; The OTHER install product, and it is not one of this contract's gates.
 ;;
 ;; The bespoke route above is what I0-I7 are about. Alongside it there is a node
 ;; stick that stands on Ubuntu Server (aiueos ADR-0214): the agent goes onto a
 ;; distribution that already boots, because the bespoke initramfs lost to
 ;; hardware rather than to the product. It is recorded HERE only so a reader of
 ;; this contract knows the other route exists; it does not move a gate and is
 ;; not evidence for one. Its own contract is the machine registry.
 :node-stick
 {:registry "os/aiueos/contracts/node-machines-v1.edn"
  :driver "os/aiueos/scripts/make-node-installer.cljk"
  :builder "os/aiueos/scripts/make-node-autoinstall-iso.cljk"
  :evidence "os/aiueos/scripts/test-node-installer.cljk (:node-installer-test)"
  :inherits
  ;; The one rule this contract owns that the other route had to inherit
  ;; outright. "Largest disk" and "first NVMe" are refused here for a reason that
  ;; does not depend on which installer is running, so the node stick's unattended
  ;; mode demands a MEASURED disk serial and otherwise builds the stick that asks.
  [:unattended-install-is-admitted-by-a-statement-not-by-a-guess]
  :differs
  ;; Named rather than implied: the node stick has no install intent, no release
  ;; receipt chain and no target receipt. Subiquity owns the write. Do not read a
  ;; green :node-installer-test as evidence about I1, I2, I3 or I5.
  [:no-intent :no-release-receipt-chain :no-target-receipt :write-owned-by-subiquity]
  :physical :unbuilt}   ; no ISO has been built from it, for any box

 ;; Exit gates. Root ADR adr-2608251418 holds the authoritative wording; the
 ;; values here and there must match (gate I0). Update both or neither.
 :gates
 {:i0-contract {:state :green
                :evidence "this file + root ADR carry the same matrix (2026-08-25)"}
  :i1-artifact {:state :green
                :evidence "make-install-usb-image.py closes release-receipt ->
                           intent -> payload -> usb-image digest chain and
                           verify re-checks it from the image alone"}
  :i2-destructive-guard {:state :green-offline
                         :evidence "ported installer refusals + intent refusals
                                    exercised by scripts/tasks.edn
                                    :installer-test and :install-chain-test;
                                    every refusal asserts its named reason.
                                    Not yet exercised against a live block
                                    device on the install path."}
  :i3-qemu-install {:state :green-qemu
                    :evidence "smoke-qemu-install.cljk re-run 2026-09-15 on the
                               post-kbb-cutover tree: one gate, four boots
                               asserted together -- USB-booted live installer
                               installs to a blank NVMe (intent admitted,
                               readback verified, AIUEOS_INSTALL_OK), the NVMe
                               boots aiueos twice with the USB detached (58
                               markers each), the re-inserted USB refuses with
                               existing-install (exit 4) and the disk digest is
                               unchanged; installed extent equals the release
                               receipt digest. QEMU/OVMF with a VARS pflash; no
                               physical machine yet (I7). The 2026-08-25 green
                               was stale after the 2026-09-09 kotoba.lang.text
                               move (aiueos ADR-0209); this re-run retires that
                               staleness. Two defects were caught BY the re-run
                               (aiueos ADR-0217): the pinned node v26.7.0 needs
                               libatomic.so.1 (shipped via libatomic1), and the
                               bundled nbb had to be the org-babashka-nbb fork
                               1.5.212-cljk.1 -- stock nbb resolves no .cljk and
                               dies on kotoba.lang.text exactly as ADR-0209 did."}
  :i4-headless {:state :red
                :provisioning :landed  ; the static half (ssh-v1.edn, ADR-0101)
                :note "The SSH profile is designed (ssh-v1.edn) and the
                       provisioning half is landed and measured: the installer
                       generates a per-device ed25519 host key on the target
                       and places the intent's authorized key, proved by
                       test-provision-record.cljk (RFC 8032 vector),
                       test-install-chain.cljk (22/22) and the QEMU install
                       gate. I4 stays RED: no sshd, no served handshake. The
                       four blockers (no TCP passive-open, RX depth 1, no
                       entropy/sign primitive, no post-evidence service loop)
                       and the crypto bricks (SHA-512, Ed25519 sign+verify)
                       are named in ssh-v1.edn."}
  :i5-repeat-safety {:state :green-qemu
                     :evidence "fake devices in :install-chain-test, and the
                                full chain in smoke-qemu-install.cljk boot4:
                                unattended re-boot of the same USB against its
                                own installed target refuses (exit 4,
                                existing-install) with the disk byte-identical
                                across the attempt; not yet on hardware"}
  :i6-physical-probe {:state :amber
                      :note "hw-probe tooling ported from the unmerged branch
                             (build-hw-probe.sh, make-hw-probe-image.py); not
                             yet run against the qualification target"}
  :i7-physical-install {:state :red
                        :qualification-target
                        "ASRock B850M Pro RS WiFi White / Ryzen 5 7500F /
                         Intel Arc Pro B70 / PNY 500 GB NVMe -- spec-sheet
                         names; live probe receipt required before any driver
                         claim goes green"}
  :i8-optional-tailnet {:state :red :note "does not block I7"}}}
