;; v7 follows the physical K16's v6 code=209 observation. The loader now marks
;; a successful ExitBootServices handoff, and the qualification kernel persists
;; its last entered initialization stage using the same bounded UEFI variable.
{:format :aiueos.physical-qualification-usb/v7
 :extends "physical-qualification-usb-v6.edn"
 :machine-profile :gmktec-k16-ryzen-7-7735hs
 :observed-input {:image-version 6
                  :physical-result-code 209
                  :meaning :exit-boot-services-or-native-core}
 :post-exit-progress
 {:loader-code 211
  :kernel-codes {220 :kernel-entry
                 221 :early-kotoba-and-initramfs-selftests
                 222 :gdt-idt
                 223 :legacy-pic-disable
                 224 :owned-paging
                 225 :crypto-selftests
                 226 :framebuffer
                 227 :physical-allocator-and-capability-table
                 228 :acpi
                 229 :qualification-finalize}
  :persisted-before-stage true
  :state :incomplete
  :persisted-to :uefi/AIUEOSQualificationResult
  :maximum-bytes 16
  :manual-power-cycle-collector :same-parent-usb-probe}
 :negative-gate
 {:command "os/aiueos/scripts/smoke-qemu-physical-kernel-hang.sh"
  :forced-progress-code 299
  :requires [:first-boot-hangs-after-kernel-entry
             :progress-persisted
             :second-boot-collector
             :result-log-incomplete-code
             :write-confined-to-result-partition]}
 :safety {:internal-disk-write-code-reached? false
          :usb-write-scope :same-usb-result-partition-guid
          :uefi-variable-bytes 16
          :ssd-install :separate-later-operation}}
