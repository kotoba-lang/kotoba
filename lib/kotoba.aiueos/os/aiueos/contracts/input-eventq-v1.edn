;; Companion to virtio-input used-ring (ADR-0093). Envelope fill is C
;; mechanism; inventing the event in C is leftover :synthetic-smoke.
{:format :aiueos.input-eventq/v1
 :native {:target :x86_64-aiueos-kernel-v1
          :export nil
          :event-from "virtio-input used-ring"}
 :vectors {:used-ring-ev-key :ok
           :synthetic-keycode-30 :leftover
           :eventq-empty :leftover}
 :trusts-caller-for [:physical-hid
                     :native-phase6-compositor
                     :one-virtio-gpu-scanout]
 :verification {:off-target :impossible
                :reason :kir-refuses-kernel-memory
                :evidence "nbb --classpath src scripts/compositor-guest.cljk guest-input"}
}