;; The model placement rule, run against the KIR interpreter.
;;
;; `aiueos.uefi.memory/window-reason` decides WHERE the firmware's pages are
;; allowed to be: inside 4 GiB-64 GiB, 2 MiB aligned, and not past the pages
;; the firmware actually handed over. It is the only one of the loader modules
;; that is PURE ARITHMETIC -- no memory window, no firmware call -- so unlike
;; `console` and `memory`'s allocators it can be exercised completely without a
;; machine, and unlike `elf` it needs no fixture bytes.
;;
;; `os/aiueos/scripts/smoke-qemu-uefi-loader.cljk` boots it and asserts five of
;; these verdicts under OVMF. This asserts every reachable one plus the two
;; boundaries the slack rule turns on, in about a second.
;;
;; ADR-0180 (the loader modules), and FIRMWARE-STORE's ADR-0334 for the rule.
{:format :aiueos.uefi-window-reason/v1
 :graph {:root aiueos.uefi.memory :modules [aiueos.uefi.memory]}

 ;; NOT a kernel object: `aiueos.uefi.memory` is a MODULE of the BOOTX64.EFI
 ;; image, so it has no `kotoba_aiueos_*` export and appears in no
 ;; `elf64.cljc` allowlist. `entry` is the function name.
 :native {:target :x86_64-aiueos-uefi-v1
          :entry window-reason
          :module-of "os/aiueos/uefi/loader-probe.kotoba"
          :required-operations []}
 :arguments [:raw-base :raw-pages :want]

 ;; The rule, as `main.c`'s `load_verified_model` computes it: the model is
 ;; mapped in 2 MiB units, so the request is rounded up to a whole number of
 ;; them; the firmware answers with a 4 KiB-aligned base; the loader aligns
 ;; that up to 2 MiB, which moves the END of the block up by the same amount.
 :rule {:page-size 4096 :huge-page-size 2097152
        :min-address 4294967296 :limit 68719476736
        :slack-pages 511
        :slack-derivation "(2 MiB - 4 KiB) / 4 KiB, the most an align-up can consume"}

 ;; NOT A BOOLEAN. ZERO IS THE SUCCESS VALUE.
 :result {:kind :reason-code :admit 0 :range [1 7] :truthy-is-success false}
 :reasons {0 :placeable
           1 :request-empty
           2 :mapped-size-does-not-fit-under-64gib
           3 :firmware-did-not-allocate
           4 :aligned-base-below-4gib
           5 :aligning-moved-the-base-down
           6 :aligned-block-ends-above-64gib
           7 :aligned-block-ends-past-the-pages-given}

 ;; CLAUSE 5 IS DECLARED AND NOT EXERCISED, and saying so is the point.
 ;; It fires when aligning wraps, which needs `raw-base + 2097151` to overflow
 ;; i64 -- and every such base makes `aligned-up` answer a NEGATIVE word, which
 ;; clause 4 refuses first because a negative is below 4 GiB. So clause 5 is
 ;; unreachable through this entry given the clause ORDER, not because the
 ;; arithmetic cannot wrap. That is a property of the ordering and is recorded
 ;; here rather than left as a gap in the observed set; a vector that reached
 ;; it would have to call `aligned-up` directly, which is a different contract
 ;; about a different function.
 :declared-not-exercised {5 :shadowed-by-clause-4}

 :vectors
 [;; --- the refusals, in clause order ---
  {:name :empty-request
   :raw-base 4294967296 :raw-pages 8192 :want 0 :expected 1}
  {:name :one-byte-over-64gib
   :raw-base 4294967296 :raw-pages 8192 :want 68719476737 :expected 2
   :why "68719476736 exactly rounds to 64 GiB and is NOT refused -- the
         ceiling is a limit, not a maximum. One byte more rounds to 64 GiB +
         2 MiB and is."}
  {:name :exactly-64gib-is-not-refused-here
   :raw-base 4294967296 :raw-pages 8192 :want 68719476736 :expected 6
   :why "The other side of that boundary. It passes clause 2 and is caught by
         clause 6 instead, which is the ordering working: 'does not fit at
         all' and 'does not fit HERE' are different sentences."}
  {:name :firmware-refused
   :raw-base 0 :raw-pages 8192 :want 16777216 :expected 3}
  {:name :below-4gib
   :raw-base 1048576 :raw-pages 8192 :want 16777216 :expected 4}
  {:name :zero-base-is-reported-as-a-refusal-not-as-low
   :raw-base 0 :raw-pages 8192 :want 16777216 :expected 3
   :why "Zero is also below 4 GiB. Clause 3 is ahead of clause 4 on purpose,
         because 'the firmware refused' is the useful sentence -- and this is
         the vector that goes red if the two are ever swapped."}
  {:name :ends-above-64gib
   :raw-base 68717379584 :raw-pages 8192 :want 16777216 :expected 6}

  ;; --- the slack rule, which is what a loader gets wrong ---
  {:name :misaligned-base-sized-to-the-mapped-bytes-alone
   :raw-base 4294971392 :raw-pages 4096 :want 16777216 :expected 7
   :why "4 GiB + 4 KiB is 4 KiB-aligned and not 2 MiB-aligned, so aligning up
         moves the base to 4 GiB + 2 MiB and the END past the 4096 pages that
         were asked for. This is the failure the 511-page slack exists for."}
  {:name :misaligned-base-with-the-full-slack
   :raw-base 4294971392 :raw-pages 4607 :want 16777216 :expected 0
   :why "4096 + 511. The aligned block ends at EXACTLY the last byte of the
         allocation, so this is the boundary rather than a comfortable
         margin: it is the vector that says 511 is the right number."}
  {:name :one-page-short-of-the-full-slack
   :raw-base 4294971392 :raw-pages 4606 :want 16777216 :expected 7
   :why "The other side of that boundary. Without it, a slack of 512 -- or of
         any larger number -- passes the vector above and 511 is never shown
         to be exact."}

  ;; --- the admissions ---
  {:name :aligned-base-with-room
   :raw-base 4294967296 :raw-pages 8192 :want 16777216 :expected 0}
  {:name :already-2mib-aligned-needs-no-slack
   :raw-base 4294967296 :raw-pages 4096 :want 16777216 :expected 0
   :why "An aligned base consumes none of the slack, so the exact page count
         is enough. Together with the pair above this says the slack is a
         BOUND on the alignment loss rather than a constant overhead."}
  {:name :one-byte-rounds-up-to-a-whole-huge-page
   :raw-base 4294967296 :raw-pages 512 :want 1 :expected 0
   :why "mapped-bytes(1) is 2 MiB, so 512 pages is exactly enough. A rule that
         mapped the request rather than the rounded size would need one."}
  {:name :one-byte-with-511-pages
   :raw-base 4294967296 :raw-pages 511 :want 1 :expected 7
   :why "And one page fewer is not."}]

 :verification
 {:memory {:base 65536 :image-bytes 64}
  :fuel 100000
  :node-stack-size 4000
  :off-target :interpreter
  :pure-arithmetic true
  :evidence "os/aiueos/scripts/smoke-qemu-uefi-loader.cljk"
  :note "The smoke boots the same module under OVMF and asserts the verdicts
         0 4 3 6 7 as x86-64 machine code. This asserts every reachable
         clause, and both sides of the two boundaries the slack turns on,
         without a firmware."}}
