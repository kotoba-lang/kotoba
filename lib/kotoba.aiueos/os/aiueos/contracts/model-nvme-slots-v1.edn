;; Pure-AIUEOS model cache adapter. The UEFI firmware supplies only the NVMe
;; Block I/O mechanism; AIUEOS owns target admission, streaming verification,
;; A/B state, commit order and recovery.
{:format :aiueos.model-nvme-slots/v1
 :target {:transport :uefi-block-io
          :device-path :nvme-namespace-required
          :media {:logical-partition? true
                  :removable? false
                  :read-only? false
                  :logical-block-bytes 512}
          :admission {:anchor-magic "AIUEOS-MODEL-AB1"
                      :anchor-version 1
                      :partition-size-exact? true
                      :arbitrary-disk-fallback? false}}
 :layout {:metadata-blocks {:anchor 0 :selectors [1 2] :slot-headers [3 4]}
          :data-slots 2
          :data-alignment-bytes 1048576
          :minimum-slot-bytes 10934860800
          :record-checksum :crc32-ieee}
 :update {:source-normal :kotobase-https-cid-stream
          :source-this-qualification :https-range-to-split-fat32-usb
          :target-absent :continue-without-internal-disk-write
          :write-order [:inactive-data :flush :full-readback-sha256
                        :inactive-header :flush-and-readback
                        :alternate-selector :flush-and-readback]
          :activation :highest-valid-selector-with-matching-slot-header
          :interrupted :last-known-good
          :partial-slot-bootable? false}
 :identity {:artifact-bytes :exact
            :artifact-sha256 :exact
            :compiled-qwen38-cell {:bytes 10934860704
                                   :sha256 "c0b7c3038681ed2e3040456c1dd45f9858b6c2290bed172c70388a94874f3eee"}}
 :evidence {:host-state-machine :passed
            :qemu-uefi-nvme-block-io :passed
            :qemu-a-to-b-update :passed
            :qemu-corrupt-update-last-known-good :passed
            :qemu-absent-target-deferred :passed
            :fat32-ranged-fetch-resume :passed
            :physical-k16-nvme-write :unverified
            :physical-k16-https-model-fetch :unverified}
 :safety {:writes-without-anchor? false
          :target-absent-continues-https? true
          :writes-removable-target? false
          :writes-whole-nvme? false
          :writes-windows-partition? false
          :formats-target-at-boot? false}
 :does-not-prove [:native-post-exit-boot-services-nvme-driver
                  :physical-k16-write :physical-k16-model-fetch
                  :qwen38-generation :qwen38-throughput]}
