;; The declaration kotoba-native's `kernel-object-entries` transcribes -- in
;; BOTH `elf64.clj` and `elf64.cljc`, because the JVM loads `.clj` first and
;; kotoba-native ADR-0036 keeps the two a twin -- so that the export symbol is
;; stated by the repository that owns the decision.
{:format :aiueos.aes128-gcm/v1
 :graph {:root aiueos.aes128-gcm
         :modules [aiueos.lib.aes128-gcm-core aiueos.aes128-gcm]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_aes128_gcm"
          :imports []
          :required-operations [kernel-load-u8-4k kernel-store-u8-4k
                                kernel-load-u8-16k kernel-subregion]}
 :arguments [:ctx :ctx-len :data :data-len :mode]

 ;; WHY THIS OBJECT EXISTS.
 ;; `kernel/tls_aes_gcm.c` was 275 lines of C carrying the S-box, the key
 ;; schedule, the cipher, GHASH, CTR and the tag comparison -- the entire
 ;; confidentiality and integrity decision of every TLS 1.3 record this OS
 ;; sends or accepts. ADR-0015 draws the C boundary at MECHANISM. Whether the
 ;; bytes that arrived are the bytes the peer sent, under the key that was
 ;; agreed, is not mechanism; it is the decision the mechanism exists to serve.

 ;; NOT A BOOLEAN. Zero admits; every non-zero value names the clause that
 ;; produced it. The C this replaces returned 1 for success, so a caller
 ;; transcribed unchanged accepts exactly the records this object refuses.
 :result {:kind :reason-code :admit 0 :range [1 5] :truthy-is-success false}
 :reasons {0 :done
           1 :ctx-below-1280
           2 :data-above-12288
           3 :aad-above-64
           4 :mode-neither-seal-nor-open
           5 :tag-mismatch}
 :modes {1 :seal 0 :open}

 :ctx {:bytes 1280
       :key {:offset 0 :bytes 16}
       :nonce {:offset 16 :bytes 12}
       :aad-length {:offset 28 :bytes 1 :maximum 64}
       :tag {:offset 32 :bytes 16 :direction {:seal :written :open :expected}}
       :aad {:offset 64 :bytes 64}
       :workspace {:offset 128 :bytes 1152}
       :why "The ABI admits five parameters. Key, nonce, AAD, tag and every
             scratch buffer therefore share one caller-owned region, leaving
             `data`, its length and `mode` as the other four. A separate
             workspace pointer -- the shape `aiueos-sha256` uses -- would take
             the parameter `mode` needs."}

 ;; The property vectors 9 and 10 below are FOR. `tls_aes_gcm.c` decrypted
 ;; first and compared the tag afterwards, so a forged record left
 ;; attacker-chosen plaintext in the caller's buffer for as long as the caller
 ;; took to check the return value. Nothing exploited it, because every caller
 ;; did check -- but that is a property of today's callers, not of the code.
 ;; This object GHASHes and compares before it decrypts, so a refused record
 ;; leaves `data` holding the ciphertext it arrived as, and the vectors assert
 ;; those bytes rather than merely asserting the reason code.
 :release-order {:seal [:ctr :ghash-aad :ghash-ciphertext :length-block :tag]
                 :open [:ghash-aad :ghash-ciphertext :length-block :tag-compare
                        :ctr-only-if-the-tag-matched]}

 ;; The S-box is DERIVED, not transcribed: the log/antilog pair for generator 3
 ;; is built by 255 doublings, the inverse is `alog[255 - log[x]]`, and the
 ;; affine map is FIPS 197 5.1.1. A transcribed table fails only on the inputs
 ;; that touch a mistyped byte; a wrong construction fails every vector here.
 :sbox {:derived-by :log-antilog-generator-3 :table-in-source false}

 ;; No `i64-shift-left` / `u64-shift-right` anywhere in the object, and that is
 ;; not a style choice. Measured 2026-09-02 against amu b1fdaad2: on the
 ;; JVM-FREE route every i64 shift is refused with "runtime KIR i64 shift count
 ;; rejected", because `kotoba.verifier` re-derives the frontend's literal-count
 ;; rule with `integer?` and ClojureScript lowers the KIR literal to a BigInt,
 ;; for which `integer?` is false. The object uses `quot` and `*` by powers of
 ;; two, which is what `sha256.kotoba` does and what `x25519.kotoba` warns
 ;; about in its timing note.
 :no-i64-shifts {:measured "2026-09-02" :amu "b1fdaad2"
                 :refusal "runtime KIR i64 shift count rejected"}

 :verification
 {:off-target :executed
  :mechanism :kir-execute-with-a-supplied-memory-image
  :runner "os/aiueos/scripts/verify-admissions.cljk"
  :host :nbb
  ;; `--stack-size=4000` is NOT enough for this contract. The ClojureScript
  ;; interpreter recurses once per Kotoba call and this object's GHASH is 4,565
  ;; calls deep per field multiplication; measured 2026-09-02, the first vectors
  ;; of a cold run trapped `:fuel-exhausted` with `:host-stack-exhausted true`
  ;; at 4000 while later ones passed, because V8 shrinks the frames once the
  ;; interpreter tiers up. Run it as
  ;;   ulimit -s 65520
  ;;   node --stack-size=60000 "$(command -v nbb)" --classpath ... \
  ;;     os/aiueos/scripts/verify-admissions.cljk os/aiueos/contracts/aes128-gcm-v1.edn
  ;; The runner refuses rather than reporting a mismatch when it sees that trap.
  :node-stack-size 60000
  :memory {:base 65536 :image-bytes 13840
           :ctx-offset 0 :data-offset 1536}
  :fuel 4000000000
  ;; Measured 2026-09-02 on a machine at load average ~150: 15-120 seconds per
  ;; vector, dominated by the interpreter rather than by the object. The
  ;; largest record here is 64 bytes; the object's bound is 12288, and the cost
  ;; is linear in blocks, so a full record is ~190x one of these. That record
  ;; is NOT executed here and this contract does not claim it was.
  :largest-executed-record-bytes 64
  :floors {:minimum-vectors 15
           :minimum-memory-assertions 16
           :every-reachable-reason-observed true}}

 :vectors
 ;; Every ciphertext and tag below was produced by THREE independent
 ;; implementations that agree byte for byte: `aes.gcm/seal` from
 ;; kotoba-lang/org-nist-aes (pure cljc), OpenSSL through node's
 ;; `crypto.createCipheriv('aes-128-gcm', ...)`, and the C being replaced.
 [{:name :sp800-38d-empty-seal
   :key-hex "00000000000000000000000000000000"
   :nonce-hex "000000000000000000000000"
   :aad-hex "" :data-hex "" :mode 1 :expected 0
   :expect-tag-hex "58e2fccefa7e3061367f1d57a4e7455a"
   :why "SP 800-38D Appendix B test case 1. No data and no AAD, so the tag is
         E_K(J0) xor GHASH of the length block alone -- it exercises the key
         schedule, the derived S-box, H and J0 without any CTR at all, which
         makes it the vector that fails first if the table construction is
         wrong."}
  {:name :sp800-38d-64-byte-seal
   :key-hex "feffe9928665731c6d6a8d0340314de8"
   :nonce-hex "cafebabefacedbaddecaf888"
   :aad-hex ""
   :data-hex "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255"
   :mode 1 :expected 0
   :expect-data-hex "4faa3ccbf07a91cfddce27c8578abaa1ed73bed1c3d08eb8b08021ff5d3549d4a282d3a85835e52d2da9e496273474dcccdbc9a28661dd66b87c441bd9ebbde7"
   :expect-tag-hex "97f7b29118c8fb5494359b191d97003e"
   :why "Four whole blocks. The counter has to advance across all four and the
         GHASH has to absorb all four in order; a keystream reused between
         blocks reproduces block one and fails the other three."}
  {:name :sp800-38d-64-byte-seal-with-aad
   :key-hex "feffe9928665731c6d6a8d0340314de8"
   :nonce-hex "cafebabefacedbaddecaf888"
   :aad-hex "feedfacedeadbeeffeedfacedeadbeefabaddad2"
   :data-hex "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255"
   :mode 1 :expected 0
   :expect-data-hex "4faa3ccbf07a91cfddce27c8578abaa1ed73bed1c3d08eb8b08021ff5d3549d4a282d3a85835e52d2da9e496273474dcccdbc9a28661dd66b87c441bd9ebbde7"
   :expect-tag-hex "2b956e81820664242d50872ba9f521ee"
   :why "Same key, nonce and plaintext as the vector above, so the ciphertext
         is IDENTICAL and only the tag moves. That is the whole point of AAD
         and it is why the pair is here rather than either one alone: a bug
         that folded the AAD into the keystream would change both."}
  {:name :sp800-38d-60-byte-seal-with-aad
   :key-hex "feffe9928665731c6d6a8d0340314de8"
   :nonce-hex "cafebabefacedbaddecaf888"
   :aad-hex "feedfacedeadbeeffeedfacedeadbeefabaddad2"
   :data-hex "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39"
   :mode 1 :expected 0
   :expect-data-hex "4faa3ccbf07a91cfddce27c8578abaa1ed73bed1c3d08eb8b08021ff5d3549d4a282d3a85835e52d2da9e496273474dcccdbc9a28661dd66b87c441b"
   :expect-tag-hex "8f3ad10cd058bd4d5256e7b1a0019a37"
   :why "60 bytes and 20 bytes: BOTH the data and the AAD end mid-block, so the
         zero padding of a partial GHASH block is exercised on both sides at
         once, and the final CTR block is a 12-byte narrowing rather than a
         16-byte one."}
  {:name :tls-record-shaped-seal
   :key-hex "0102030405060708090a0b0c0d0e0f10"
   :nonce-hex "202122232425262728292a2b"
   :aad-hex "1703030023"
   :data-hex "474554202f20485454502f312e310d0a0d0a17"
   :mode 1 :expected 0
   :expect-data-hex "c4b64937ef125ed689b902dcc02d4bca0ab3f0"
   :expect-tag-hex "3ebb7ee4586151db4fec859917d841e8"
   :why "The shape this object actually runs in: a 5-byte TLS 1.3 record header
         as AAD, and an inner plaintext that is an HTTP request followed by the
         0x17 content-type trailer. 0x0023 is 19 + 16, the length the record
         layer writes before it knows the tag."}
  {:name :one-byte-record-seal
   :key-hex "0102030405060708090a0b0c0d0e0f10"
   :nonce-hex "202122232425262728292a2b"
   :aad-hex "1703030011" :data-hex "17" :mode 1 :expected 0
   :expect-data-hex "94"
   :expect-tag-hex "4ae22dba13a4088f5aa4f8da45ca5e03"
   :why "The smallest record TLS 1.3 can produce -- a content type and nothing
         else. One byte narrows to a one-byte subregion, which is the same code
         path as the 768th block of a full record."}
  {:name :sp800-38d-64-byte-open
   :key-hex "feffe9928665731c6d6a8d0340314de8"
   :nonce-hex "cafebabefacedbaddecaf888"
   :aad-hex ""
   :data-hex "4faa3ccbf07a91cfddce27c8578abaa1ed73bed1c3d08eb8b08021ff5d3549d4a282d3a85835e52d2da9e496273474dcccdbc9a28661dd66b87c441bd9ebbde7"
   :tag-hex "97f7b29118c8fb5494359b191d97003e"
   :mode 0 :expected 0
   :expect-data-hex "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255"
   :why "The inverse of the second vector, against the same published bytes
         rather than against whatever this object produced -- a round trip
         through one implementation agrees with itself even when it is wrong."}
  {:name :tls-record-shaped-open
   :key-hex "0102030405060708090a0b0c0d0e0f10"
   :nonce-hex "202122232425262728292a2b"
   :aad-hex "1703030023" :data-hex "c4b64937ef125ed689b902dcc02d4bca0ab3f0"
   :tag-hex "3ebb7ee4586151db4fec859917d841e8"
   :mode 0 :expected 0
   :expect-data-hex "474554202f20485454502f312e310d0a0d0a17"}
  {:name :open-refuses-a-flipped-tag-bit
   :key-hex "feffe9928665731c6d6a8d0340314de8"
   :nonce-hex "cafebabefacedbaddecaf888"
   :aad-hex ""
   :data-hex "4faa3ccbf07a91cfddce27c8578abaa1ed73bed1c3d08eb8b08021ff5d3549d4a282d3a85835e52d2da9e496273474dcccdbc9a28661dd66b87c441bd9ebbde7"
   :tag-hex "97f7b29118c8fb5494359b191d97003f"
   :mode 0 :expected 5
   :expect-data-hex "4faa3ccbf07a91cfddce27c8578abaa1ed73bed1c3d08eb8b08021ff5d3549d4a282d3a85835e52d2da9e496273474dcccdbc9a28661dd66b87c441bd9ebbde7"
   :why "The last tag byte moved by one bit. `:expect-data-hex` is the
         CIPHERTEXT, unchanged: this asserts that nothing was decrypted, which
         is the property the C did not have and the reason code alone does not
         show."}
  {:name :open-refuses-a-flipped-ciphertext-byte
   :key-hex "feffe9928665731c6d6a8d0340314de8"
   :nonce-hex "cafebabefacedbaddecaf888"
   :aad-hex ""
   :data-hex "4eaa3ccbf07a91cfddce27c8578abaa1ed73bed1c3d08eb8b08021ff5d3549d4a282d3a85835e52d2da9e496273474dcccdbc9a28661dd66b87c441bd9ebbde7"
   :tag-hex "97f7b29118c8fb5494359b191d97003e"
   :mode 0 :expected 5
   :expect-data-hex "4eaa3ccbf07a91cfddce27c8578abaa1ed73bed1c3d08eb8b08021ff5d3549d4a282d3a85835e52d2da9e496273474dcccdbc9a28661dd66b87c441bd9ebbde7"
   :why "First ciphertext byte 0x4f -> 0x4e, tag untouched. The refusal has to
         come from GHASH over the ciphertext rather than from the tag bytes
         themselves."}
  {:name :open-refuses-an-aad-the-sender-did-not-authenticate
   :key-hex "0102030405060708090a0b0c0d0e0f10"
   :nonce-hex "202122232425262728292a2b"
   :aad-hex "1703030024" :data-hex "c4b64937ef125ed689b902dcc02d4bca0ab3f0"
   :tag-hex "3ebb7ee4586151db4fec859917d841e8"
   :mode 0 :expected 5
   :expect-data-hex "c4b64937ef125ed689b902dcc02d4bca0ab3f0"
   :why "The record header's declared length changed from 0x23 to 0x24 and
         nothing else. A record layer that computed the AAD from the buffer it
         holds rather than from the bytes on the wire would pass this; the AEAD
         is what makes the header itself unforgeable."}
  {:name :ctx-below-the-required-1280
   :key-hex "00000000000000000000000000000000"
   :nonce-hex "000000000000000000000000"
   :aad-hex "" :data-hex "" :mode 1 :ctx-len 1279 :expected 1
   :why "Refused before the first load, so a caller who sized the region for an
         older layout faults nothing and learns why."}
  {:name :data-above-the-record-bound
   :key-hex "00000000000000000000000000000000"
   :nonce-hex "000000000000000000000000"
   :aad-hex "" :data-hex "" :data-len-override 12289 :mode 1 :expected 2
   :why "12288 is the largest record the 16 KiB load window can cover with the
         object's own bound below it. The length is refused, so no byte of a
         13 KiB buffer is read to find that out."}
  {:name :aad-above-sixty-four
   :key-hex "00000000000000000000000000000000"
   :nonce-hex "000000000000000000000000"
   :aad-hex "" :aad-len-override 65 :data-hex "" :mode 1 :expected 3
   :why "The AAD slot is 64 bytes. A length byte of 65 would read one byte past
         it into the round keys, which is exactly the sort of read the bound
         exists to stop."}
  {:name :mode-two-is-neither-seal-nor-open
   :key-hex "00000000000000000000000000000000"
   :nonce-hex "000000000000000000000000"
   :aad-hex "" :data-hex "" :mode 2 :expected 4
   :why "There is no default direction. A caller who passes a truthy `encrypt`
         flag from the C -- where any non-zero meant encrypt -- is refused
         rather than silently sealing."}]

 ;; A trap is not a reason code. `kernel-subregion` faults on a null base and
 ;; the machine's answer is UD2: the kernel dies rather than seals into nothing.
 :traps
 [{:name :null-data-region
   :key-hex "0102030405060708090a0b0c0d0e0f10"
   :nonce-hex "202122232425262728292a2b"
   :aad-hex "1703030011" :data-hex "17" :mode 1 :data-base-override 0
   :expect-trap :kernel-memory-fault :expect-check :null-base}]}
