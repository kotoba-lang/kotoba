;; Companion to guest WM hit (ADR-0091). Paint is C mechanism; front id
;; is Kotoba `kotoba_aiueos_wm_hit` (ADR-0092).
{:format :aiueos.wm-paint/v1
 :native {:target :x86_64-aiueos-kernel-v1
          :export nil
          :front-from "kotoba_aiueos_wm_hit"}
 :paint {:back-then-front true
         :sample {:x 100 :y 80}}
 :rects {:window-1 {:x 32 :y 32 :w 720 :h 540 :rgb 0x00aa2222}
         :window-2 {:x 96 :y 72 :w 640 :h 480 :rgb 0x0022aa55}}
 :vectors {:boot-front-2 :overlap-is-window-2
           :raised-front-1 :overlap-is-window-1
           :key-order-1-last :leftover
           :always-front-2-last :leftover}
 :trusts-caller-for [:virtio-input-not-synthetic
                     :native-phase6-compositor
                     :one-virtio-gpu-scanout]
 :verification {:off-target :impossible
                :reason :kir-refuses-kernel-memory
                :evidence "nbb --classpath src scripts/compositor-guest.cljk guest-paint"}
}