;; Companion to kotoba-native kernel-object-entries `aiueos-browser-damage`
;; (guest browser desktop damage, ADR-0242).
;;
;; The previous frame's draw list (kept by the caller in the shadow) and this
;; frame's -> the rectangle a present sends: the bounding box of every op, in
;; either list, at a slot where the two differ; the whole viewport after no
;; list; nothing when they are the same. The list is then copied over the
;; previous one. Expected values are os/aiueos/scripts/browser-damage-oracle.cljk's,
;; written from the rule and checked there against painting both lists
;; (`--check` compares this file with it).
;;
;; OPS at :ops, 24 bytes per op (kind x y a b rgb). SHADOW 8192 bytes at
;; :shadow: 0 previous count, 1..4 answer x y w h, 5 viewport w, 6 viewport h,
;; 8 + 6j previous op j. Every vector asserts shadow words 0 .. 8 + 6n: the
;; answer, the viewport and the copied list (and, for a refusal, that none of
;; it moved).
{:format :aiueos.browser-damage/v1
 :entry aiueos-browser-damage
 :graph {:root aiueos.browser-damage
         :modules [aiueos.browser-damage]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_browser_damage"
          :imports []
          :required-operations [kernel-load-u32 kernel-store-u32 kernel-subregion]}
 :arguments [:ops :ops-bytes :shadow :shadow-bytes :count]
 :result {:kind :count-or-reason :success "slots that differ" :range [-4 -1]}
 :reasons {-1 :null-region-or-shadow-not-8192
           -2 :count-outside-1-261-or-ops-bytes-under-count
           -3 :shadow-viewport-zero-or-previous-count-past-261
           -4 :op-kind-not-rect-or-glyph}
 :mirrors {:paint-order "aiueos_desktop_present_ops2: list order, later over earlier"
           :glyph-box "a glyph op sets bits inside x y width 16 (aiueos-font/v1 rows)"}
 :trusts-caller-for [:framebuffer-holds-the-previous-list]
 :verification {:node-stack-size 4000
                :fuel 262144
                :memory {:base 4096 :image-bytes 14464
                         :regions {:ops 0 :shadow 6272}}
                :floors {:minimum-vectors 24
                         :minimum-memory-assertions 24
                         :every-reachable-reason-observed true}}
 :vectors
 [
