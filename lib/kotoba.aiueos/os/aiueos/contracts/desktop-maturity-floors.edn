;; The guest browser desktop's maturity ladder (ADR-0226).
;; Historical hosted ladder: its KBB profiles/receipts below do not qualify the
;; current native chain and must not be executed as a fallback. Current native
;; component evidence and open full-graph/kernel/app/restore gates are recorded
;; in qualification/native-shared-browser-20261025.json and
;; 90-docs/shared-browser-native-progress.md. No floor is closed by that bounded
;; component evidence; retain the original row semantics and historical walls.
;;
;; GOAL: kotoba-lang/browser's surface is the aiueos desktop you can use on
;; KERNEL.ELF -- seen on the display, driven by pointer and keyboard in one
;; running event loop, laid out as browser lays it out -- and then the browser
;; component itself runs there.
;;
;; One floor is closed only by its gate: a `kbb --backend sci --classpath src
;; scripts/compositor-guest.cljk <gate>` profile that
;;   (a) is registered in src/aiueos/compositor/guest.cljk, AND
;;   (b) has its "`<gate>` exit 0 means ..." paragraph in README.md
;; on origin/main. The loop's tick reads exactly those two facts; a floor
;; with no gate yet (:gate nil) is never counted as closed.
;;
;; Order is the order a loop takes them. :needs-a-human floors are skipped by
;; the loop and reported. :blocked-by floors are skipped the same way: a
;; measured wall that another repo must remove first (the compiler, usually),
;; with :reproduce -- the commands that show the wall -- and :until -- what
;; has to be true before a loop takes the floor again. Re-run :reproduce
;; before removing :blocked-by; do not remove it on belief. Editing this file (split a floor, reorder, add one)
;; is part of an iteration when measuring shows the ladder was wrong -- say
;; why in the commit.
{:format :aiueos.desktop-maturity/v1
 :goal "kotoba-lang/browser's surface as the usable aiueos desktop on KERNEL.ELF, then the browser component itself on the kernel"
 :floors
 [{:id :frame :gate "guest-browser-frame" :adr "0223"
   :goal "Kotoba produces and presents the retained draw list; the native kernel presenter writes it to GOP"}
  {:id :pointer :gate "guest-browser-input" :adr "0223"
   :goal "a real virtio-tablet press focuses and raises the topmost window"}
  {:id :text :gate "guest-browser-text" :adr "0224"
   :goal "titles and bodies in Japanese and ASCII from the initramfs font, on the display"}
  {:id :text-raise :gate "guest-browser-text-raised" :adr "0224"
   :goal "a raise re-lays the text in stack order"}
  {:id :typing :gate "guest-browser-type" :adr "0225"
   :goal "virtio-keyboard through the Kotoba IME into the focused window"}
  {:id :preedit :gate "guest-browser-preedit"
   :goal "the composition (preedit) is drawn underlined at the end of the focused body while it is being typed, and disappears on commit"
   :why "typing is blind until Enter; browser.document-input shows composition state"}
  {:id :ime-toggle :gate "guest-browser-ime-toggle"
   :goal "a toggle key (Hankaku/Zenkaku, evdev 41) switches the IME off and on; off sends latin straight in"
   :why "the IME-off path exists in browser-ime but no key reaches it"}
  {:id :drag :gate "guest-browser-drag"
   :goal "press on a titlebar, move, release: the window moves by the pointer delta (browser.input pointer capture :drag)"
   :why "browser.input captures titlebar drags; the kernel reduces only pointer/down"}
  {:id :resize :gate "guest-browser-resize"
   :goal "press on the 16 px resize handle, move, release: the window resizes, clamped at 120x80 (browser.input :resize)"}
  {:id :event-loop :gate "guest-browser-event-loop"
   :goal "one running loop takes interleaved pointer and key events over several seconds and presents a frame after each, instead of one scripted pass"
   :why "every gate so far is a fixed sequence; a desktop is a loop"}
  {:id :caret :gate "guest-browser-caret"
   :goal "the focused body shows a caret; Backspace with an empty preedit deletes the code point before it (browser.text-edit delete-backward)"}
  {:id :launch-close :gate "guest-browser-launch"
   :goal "a launcher row opens a window (:app/launch) and a close control removes it, focus moving to the last remaining window (browser.surface close-window)"}
  {:id :flow-layout :gate "guest-browser-flow-parity"
   :goal "the kernel's body layout equals browser.surface + cssom's draw ops for the same surface, compared op by op against the hosted engine"
   :why "the kernel places text by its own rules today (:no-flow-layout)"}
  {:id :browser-component :gate nil
   :goal "kotoba-lang/browser's surface/input reducers compiled as a whole component and linked into KERNEL.ELF, replacing the mirrored objects"
   :why "the mirrored objects are the migration's scaffold, not its end"
   ;; Measured 2026-09-25 with amu origin/main 2dcaac74 and browser 6cbc1ee;
   ;; re-measured the same day at amu e442e253 (kotoba-sema 05d8bd8a) and
   ;; browser d735c86. `amu check` is target-independent (bin/amu routes
   ;; `check` past --target), so x86_64-aiueos-kernel-v1 and aarch64-macos
   ;; are one measurement. Three walls were ordinary Clojure forms and
   ;; LANDED in the compiler: (:k m) on a map means get (amu#1088), conj on a
   ;; vector appends (amu#1089), remove is filter negated (amu#1092).
   ;; The language decision is settled by Amu ADR 0353: one typed Browser
   ;; source must serve both the hosted engine and the kernel. The measurements
   ;; below are from 2026-09-25; remeasure them against current Browser/Amu
   ;; sources before treating any listed wall as current.
   ;; Remeasured 2026-10-24 with scripts/measure-browser-component.py (amu 74ca4aa6 with its nbb engine, browser/cssom/text/dom-gpu
   ;; copied into a scratch root): browser.surface and browser.text-edit LOCK and LINK as a 11-module graph once kotoba.lang.text
   ;; and kotoba.string are the guest twins of kotoba-lang/lang/compat (the host-regex text library cannot be admitted) and
   ;; kotoba.string.join is added. The kernel target then stops at the first wall: a host regex literal in cssom.core (line 1613).
   ;; cssom.core carries ~59 and cssom.layout ~68 `#"..."` literals, many with groups, alternation and lazy/optional parts, which the
   ;; group-free linear kotoba.lang.bounded-regex cannot take. The wall is therefore a port of cssom's parsing off regex (or a richer
   ;; bounded matcher), not an amu defect; surface/text-edit themselves are clean.
   ;; CORRECTION (same day): the cssom copy measured was the UNCOMMITTED working tree of the owner's cssom checkout (src/cssom/core.cljk
   ;; and layout.cljk, modified since 2026-10-17: about +1750/-775 lines with 143 added #?(:kotoba ...) branches), i.e. a port of cssom
   ;; off host regex is already under way there; the ~127 literals are what that work-in-progress still has outside a :kotoba branch.
   ;; Re-measure against the committed HEAD or the finished port; do not start a second port.
   ;; The five shipped Kotoba objects (browser-reduce, -ime, -frame, -frame2, -damage) on the SELFHOST route, 2026-10-24: compiled with the
   ;; current native root (amu main e8f77af3, `compile <src> --target x86_64-aiueos-kernel-v1`, capability env KEXE_CAP_RESOURCES_35)
   ;; every one is refused E7102 "unsupported object profile or code limit" (details 56, 149, 14, 105, 26; frame2 names `note-text`:
   ;; 6 parameters, the profile admits 5). The seed object route admits exactly ONE exported defn with at most five scalar parameters, so
   ;; these multi-export objects with the `aiueos-browser-*` entry points cannot be built on it yet; rebuilding them there needs the
   ;; profile widened (several exports, more parameters) in amu, then the same rooted-window rules (ADR 0373) applied to their helpers.
   ;; The shipped objects are still the 74ca4aa6 builds.
   ;; Remeasured 2026-10-17 with the available native Amu selfhost image
   ;; (SHA-256 b65fcaf7cab41841249d87369cc6e7396ac40a3fa7a146fbf5abe6162688ee42)
   ;; and a scratch source root containing the current Browser, CSSOM, DOM and
   ;; Kotoba dependencies. The {:kotoba/export [...]} attr-map is now admitted:
   ;; browser.text-edit checks with :ok true and exports [empty-state]. The
   ;; complete browser.surface project graph fails in CSSOM at project-link
   ;; with "invalid constant name"; checking cssom.layout alone gives the
   ;; same refusal. A minimal source probe confirms `(def ^:private x 1)` is
   ;; one trigger for this diagnostic, while `(def x 1)` and a Kotoba reader
   ;; branch that removes host-only private metadata are admitted. Wrapping
   ;; all CSSOM private constants did not clear the module-level refusal, so
   ;; its remaining cause is not yet localized.
   ;; Direct checking the legacy kotoba.wasm.dom.cljk still fails on a top-level
   ;; form outside ns/def/defn/defn-. The dependency checkout now contains a
   ;; typed dom.kotoba/dom_core.kotoba pair, and Amu resolves .kotoba first, but
   ;; its inclusion in the Browser graph has not been measured. The current
   ;; cssom.layout source is 1,083,354 bytes; this check did not establish a
   ;; whole-component compile or native target qualification.
   :blocked-by
   {:repo "kotoba-lang/amu"
    :decision "amu docs/adr/0353-one-typed-source-for-browser-rows-absence-and-budgets.md (accepted: one typed Browser source for hosted and kernel engines)"
    :landed ["wall 3: (:k m) / (:k m d) on the bounded or typed map means get -- kotoba-sema 110cb48e, amu#1088"
             "wall 4: conj on a :vector-i64 / :vector-f64 appends at the end -- kotoba-sema 45913acc, amu#1089"
             "wall 7: remove lowers to filter with the predicate negated -- kotoba-sema 05d8bd8a, amu#1092"
             "2026-10-17: native Amu project check accepts the {:kotoba/export [...]} namespace attr-map; browser.text-edit checks :ok true and exports [empty-state]"]
    :walls
    ["current native selfhost measurement 2026-10-17: cssom.core and cssom.layout project-link fail with \"invalid constant name\". Direct checking the legacy kotoba.wasm.dom.cljk fails with \"only ns, def, defn, and defn- are allowed at top level\"; the dependency checkout now has .kotoba DOM facade/core sources that Amu prefers during project resolution, but their use in the Browser graph is unmeasured. The full browser.surface graph is not admitted yet."
     "the 1 MiB source-bound report is historical: cssom/layout.cljk is now 1,083,354 bytes and the native graph reaches CSSOM link diagnostics, but no whole-component compile has established the source bound's current status"
     "independent build wall: the available native seed image reports module-lock unavailable and refuses x86_64-aiueos-kernel-v1 as a cross-target; the existing C-free desktop artifact was built by Amu's Node/NBB launcher and is not Amu selfhost. Canonical build entrypoints now reject script launchers and bind the native executable SHA-256 into receipts, but no qualifying x86-64 Amu selfhost executable is available"
     "remeasured 2026-10-22 at amu fae61b0e: `scripts/seed/selfhost-bootstrap.py` run on arm64 Linux (podman, python:3.12-alpine) PASSES loaderless (S2=S3 f19ab1c48b54e8ae, G1=G2=G3, 24 cases). The S3 compiler accepts `--target x86_64-aiueos-kernel-v1` for a single source file (`(defn main [] :i64 (+ 40 2))` -> elf64-rel, 115 text bytes), so the kernel target itself is no longer the wall. S3 and the adopted G1 image are single-file compilers only (`seed check|compile|extract-native`); `modules`, `--source-path`, `--emit-module` and `link` trap SIGILL or are refused. The project-capable native CLI (kotoba.compiler.selfhost-cli, 59 modules) is not rebuildable from this repo: its build drivers (docs/evidence/native-selfhost-closure-20261019/scripts) read source roots that exist only in removed codex worktrees (amu-selfhost-only, the runtime overlay, kotoba-runtime-selfhost, artifact-core, hir, text, selfhost-overlay-r9probe). The `invalid constant name` diagnostic string is not in amu's current tree, so it comes from that unlanded source; it cannot be localized or fixed until those sources land in amu."
     "second wall, measured 2026-10-22 at amu fae61b0e: the loaderless selfhost compiler S3 refuses os/aiueos/kotoba/browser-frame2.kotoba for x86_64-aiueos-kernel-v1 with E2101 at byte 11382, the first `(defn sw ...)`, because the seed lineage (seed/*.kotoba, X86_64-LINUX-SELFHOST-MANIFEST) has no kernel region intrinsics. kernel-load-u32 / kernel-store-u32 / kernel-subregion (and the rest of the kernel-* family) exist only in src/kotoba/compiler/frontend_tables.kotoba, which is outside the selfhost closure. Every browser-*.kotoba kernel object is built with these, so none of them can be rebuilt by Amu selfhost until the seed gains them; the existing .o files were built by kotoba-compiler/1. Adding them touches the adopted compiler core (ADR 0370 review order), so it needs its own change with a full self-rebuild and conformance run."]
   :reproduce "with the native image SHA-256 b65fcaf7cab41841249d87369cc6e7396ac40a3fa7a146fbf5abe6162688ee42 and a scratch source root containing the current Browser/CSSOM/DOM/Kotoba dependencies: `amu check browser/text_edit.cljk --source-path <root> --jvm-free` -> :ok true; `amu check browser/surface.cljk --source-path <root> --jvm-free` -> project-link invalid constant name; direct-file `amu check kotoba/wasm/dom.cljk --source-path <root> --jvm-free` -> unsupported top-level form. The direct-file result does not measure project resolution, which now prefers the dependency's .kotoba DOM sources. Do not substitute the Node/NBB launcher for this selfhost measurement."
    :until "the accepted ADR 0353 migration is implemented and amu admits the shared typed Browser surface/input/text-edit source with its CSSOM and DOM dependencies FOR THE KERNEL: the real project entry compiles through `amu compile --target x86_64-aiueos-kernel-v1` -- `amu check` alone is target-independent and stops before native qualification"}}
  ;; Owner decision 2026-09-25: the dictionary is generated in-repo, not
  ;; taken from SKK (GPL). The source is Unicode's Unihan readings, which
  ;; carry the Unicode License v3. Taken 2026-09-25 (ADR-0235): the
  ;; generator reads kJapanese, the same readings in kana, rather than
  ;; kJapaneseOn / kJapaneseKun, which carry them in romaji and fewer of them
  ;; (U+4E0B: 14 against 5).
  {:id :dictionary :gate "guest-browser-dictionary" :adr "0235"
   :goal "Space converts a reading of any length through a kana-kanji dictionary generated in-repo from Unicode Unihan kJapanese (Unicode License v3) for every kanji the desktop font carries; the dictionary travels in the initramfs like the font, the hosted IME oracle reads the same generated file, and the candidates' order is a rule written in the generator"
   :why "the oracle's three readings (か ひ あ) make conversion a demonstration, not an input method; SKK dictionaries are GPL"}
  ;; Extended 2026-09-25 (owner: continue past 13/16). Each floor below is
  ;; a browser behaviour the kernel desktop does not have yet; the order is
  ;; the order the loop takes them.
  {:id :pointer-cursor :gate "guest-browser-cursor" :adr "0236"
   :goal "the pointer is drawn every frame at the tablet position (a sprite laid out by Kotoba as ops, over everything), and moves with the pointer in the event loop"
   :why "the desktop takes a pointer it never shows"}
  {:id :focus-cycle :gate "guest-browser-focus-cycle" :adr "0237"
   :goal "a window-manager shortcut (Alt+Tab, evdev 56 + 15) focuses and raises the next window in stack order, as a :window/focus action through browser-reduce; the key does not reach the body"
   :why "keyboard-only use cannot change the focused window"}
  {:id :scroll :gate "guest-browser-scroll" :adr "0238"
   :goal "a wheel event over a window scrolls its body (browser.surface scroll-window: :window/scroll clamped at 0); the frame clips the scrolled body to the window"
   :why "a body longer than its window is cut, not reachable"}
  {:id :selection :gate "guest-browser-selection" :adr "0240"
   :goal "Shift+Left / Shift+Right extend a selection from the caret in the focused body (browser.text-edit move-caret with :extend?), drawn as a highlight behind the glyphs; Backspace deletes the selection"
   :why "text editing stops at the caret"}
  {:id :clipboard :gate "guest-browser-clipboard" :adr "0241"
   :goal "Ctrl+C copies the selection and Ctrl+V pastes it into the focused body only after the permission broker (broker-admit, ADR-0096) admits :clipboard; a refused grant pastes nothing"
   :why "browser.desktop-backend brokers clipboard; the kernel desktop has no path to it"}
  {:id :damage-present :gate "guest-browser-damage" :adr "0242"
   :goal "a frame transfers and flushes only the rectangle that changed since the last one (virtio-gpu TRANSFER_TO_HOST_2D / RESOURCE_FLUSH with the damage rect), and the display is pixel-identical to a full present"
   :why "every event re-sends 1280 x 800 x 4 bytes"}
  ;; Extended 2026-10-22 (owner: bring the GUI's UIUX maturity to 100%, and
  ;; measure it). The hosted session shell has these (chrome elevation, focus
  ;; rings, aria-current, per-app accents); the kernel desktop has none:
  ;; grep for hover / maximize / minimize / inactive / focus-ring / tooltip in
  ;; os/aiueos/kotoba/browser-*.kotoba and the kernel finds nothing. Each is a
  ;; floor with no gate yet, so none counts as closed until its gate lands.
  {:id :title-active :gate "guest-browser-title-active" :adr "0245"
   :goal "the focused window's titlebar is drawn in the active colour and every other window's in the inactive one, decided by Kotoba from the focus state, and a focus change repaints only the two titlebars"
   :why "CORRECTED 2026-10-22: the behaviour is already in browser-frame2.kotoba (title-rgb and body-rgb take the focus flag; emit-window paints the focused window in 13421772 and the others in 15132390), so the 'four windows look identical' reading was wrong. What is missing is a gate that asserts the two colours on the serial and the screendump, and the damage rectangle of a focus change. The floor stays open until that gate lands; it is a measurement gap, not a missing feature."}
  {:id :hover :gate "guest-browser-hover" :adr "0246"
   :goal "the control under the pointer (close box, resize handle, launcher) is drawn in a hover state decided by Kotoba from the pointer position, and leaves it when the pointer leaves"
   :why "controls give no sign that they take a click"}
  {:id :focus-ring :gate "guest-browser-focus-ring" :adr "0248"
   :goal "keyboard focus on a launcher button or the focused window's close control is drawn as a 2 px ring whose contrast against both neighbours is at least 3:1, and F6 / Shift+F6 move it forward and backward through the controls that exist (Tab belongs to the window switcher and the input method)"
   :why "keyboard-only use cannot see or move focus; the hosted shell has focus rings"}
  {:id :keyboard-activate :gate "guest-browser-keyboard-activate" :adr "0249"
   :goal "Enter or Space on the ring does what a pointer press at the control's centre does (launch), and Escape closes the focused window, as the same pointer/down through browser-reduce as the pointer's (Space shares Enter's path and is not pressed in the gate)"
   :why "every action but typing needs the pointer"}
  {:id :window-maximize :gate "guest-browser-window-maximize" :adr "0250"
   :goal "a double press on a window's titlebar toggles it between its rect and the work area (0, 28, vw, vh - 80), decided by Kotoba in browser-reduce, and the restore returns the exact prior rect; a double press is two presses on the same titlebar with at most three input events between (the order of events, not milliseconds)"
   :why "a window can be moved and resized but not filled"}
  {:id :maximize-control :gate "guest-browser-maximize-control" :adr "0251"
   :goal "a 16 x 16 maximize control in the titlebar, left of the close control, on windows with a launcher at least 160 wide, toggles the window like the double press does, and F11 presses the focused window's control from the keyboard, both through the same browser-reduce pointer/down as the tablet's"
   :why "split from :window-maximize (2026-10-23, ADR-0250): the double press has no visible affordance and no keyboard path"}
  {:id :high-contrast :gate "guest-browser-high-contrast" :adr "0247"
   :goal "a keyboard toggle switches the desktop between the default and a high-contrast palette (text/background contrast >= 7:1), chosen by Kotoba, with the choice kept across frames"
   :why "one fixed palette; the hosted shell follows the design tokens"}
  ;; Extended 2026-10-23 (owner: go on toward 100%, UIUX included). The owner has not fixed what
  ;; 100% is measured against (JUN-90 would); a scorecard of ~40 desktop-shell behaviours puts the
  ;; gated work near a third. Missing and not yet floors: minimize and a window list, pressed and
  ;; disabled states, text / hand / move cursors, tooltips, transitions, text scaling and HiDPI,
  ;; notifications, settings, a colour hierarchy with more separation. Each becomes a floor when it
  ;; is taken, with its gate.
  {:id :cursor-shape :gate "guest-browser-cursor-shape" :adr "0252"
   :goal "over a window's resize handle the pointer is a resize cursor (a diagonal with an L at each end) instead of the arrow, decided by Kotoba from the same handle rule browser-reduce uses, and the arrow comes back exactly when it leaves"
   :why "the pointer is one arrow whatever is under it; nothing says that an edge can be dragged"}
  {:id :pressed-state :gate "guest-browser-pressed-state" :adr "0253"
   :goal "a hot control is drawn pressed while the pointer's button is down over it and hot again after, decided by Kotoba from the button state C keeps in surface word 2033"
   :why "a press gave no sign until it took effect (scorecard row C10)"}
  {:id :minimize :gate "guest-browser-minimize" :adr "0254"
   :goal "a window can be minimized from a control in its titlebar and restored from its dock icon: a minimized window is not drawn and not hit, the focus goes to the topmost window that is not minimized, and the restore raises and focuses it, all decided by Kotoba"
   :why "a window could only be closed or covered; scorecard row C5"}
  {:id :screen-lock :gate "guest-browser-screen-lock" :adr "0258"
   :goal "Ctrl+Alt+L locks the screen: nothing of the session is drawn or reachable (pointer, keys, shell actions), a wrong PIN is refused, the right PIN unlocks and the session is as it was, all decided by Kotoba with C only checking the PIN's hash"
   :why "the desktop could not be locked; scorecard row B2"}
  {:id :p5 :gate nil :needs-a-human "a real machine with an aiueos image; QEMU is not P5"
   :goal "the same desktop on physical hardware"}]}
