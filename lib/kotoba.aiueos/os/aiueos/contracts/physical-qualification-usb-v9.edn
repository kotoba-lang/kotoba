;; v9 follows the physical K16's v8 code=260 observation.  The machine used
;; four-level paging without an inherited SME C-bit and stopped after the last
;; durable marker before CR3.  Make that boundary non-opaque: normalize a
;; firmware-owned CET shadow-stack state, enter through a bounded 1 GiB
;; transition map, then install and validate the final split W^X map.
{:format :aiueos.physical-qualification-usb/v9
 :extends "physical-qualification-usb-v8.edn"
 :machine-profile :gmktec-k16-ryzen-7-7735hs
 :observed-input {:image-version 8
                  :physical-result-code 260
                  :meaning :before-first-owned-cr3
                  :paging-shape :four-level
                  :sme-c-bit :not-active-in-firmware-cr3
                  :proved-through [:kernel-entry :early-selftests :gdt-idt
                                   :legacy-pic-disable :page-tables-built
                                   :nxe-written :write-protect-enabled]
                  :internal-ssd-writes :none}
 :paging-handoff
 {:firmware-state {:la57 :inherit-active
                   :sme-c-bit :inherit-active-from-firmware-cr3
                   :cet-shadow-stack :disable-before-kernel-owned-cr3}
  :transition-map {:coverage :identity-first-1g
                   :leaf-size :2m
                   :permissions :temporary-rwx-supervisor
                   :published-as-kernel-cr3 false
                   :terminal-state :replaced-by-final-split-wx}
  :feature-code-bits {:la57 1 :sme 2 :firmware-cet-observed 4}
  :progress-code-formulas
  {:before-transition-cr3 "260 + feature-bits"
   :after-transition-cr3 "270 + feature-bits"
   :before-final-cr3 "280 + feature-bits"
   :after-final-cr3 "300 + feature-bits"
   :final-wx-validated "310 + feature-bits"}
  :progress-code-ranges [[260 267] [270 277] [280 287] [300 307] [310 317]]}
 :safety {:internal-disk-write-code-reached? false
          :usb-write-scope :same-usb-result-partition-guid
          :uefi-variable-bytes 16
          :ssd-install :separate-later-operation}}
