;; Which link may carry first boot, and which may be recorded as this machine's
;; own network (root ADR adr-2609092800 D6; install-v1 :network-policy).
;;
;; R0 was wired DHCP only. A phone tethered over USB is the keyboard-free way
;; to bootstrap a box with no ethernet run to it: the phone already holds the
;; credential, the cable is already in the box, and nothing is typed. The whole
;; risk of admitting it is that a phone leaves, so this contract keeps two
;; questions apart that a single :ok? would collapse:
;;
;;   bootstrap?  may this link carry first boot
;;   durability  may this link be persisted as the machine's own network
;;
;; The collapse is the failure mode: the box comes up over a phone, the phone
;; walks away, and nothing in the record explains why it went unreachable.
{:format :aiueos.network-bootstrap/v1
 :profile #{:bare-metal-uefi :linux-hosted-pid1}
 :decision-authority "src/aiueos/network_bootstrap.cljk"
 :depends-on :aiueos.install-contract/v1

 ;; What an interface earns by how it presents. :unknown is listed on purpose
 ;; and earns nothing -- an interface we cannot classify must not fall through
 ;; to the same answer as one we examined and admitted.
 :interface-classes
 {:pci-ethernet         {:bootstrap? true  :durability :durable}
  :usb-ethernet-adapter {:bootstrap? true  :durability :ephemeral}
  :usb-cdc-ncm          {:bootstrap? true  :durability :ephemeral :tether? true}
  :usb-cdc-ecm          {:bootstrap? true  :durability :ephemeral :tether? true}
  :usb-rndis            {:bootstrap? true  :durability :ephemeral :tether? true}
  :usb-ipheth           {:bootstrap? true  :durability :ephemeral :tether? true}
  :wifi-sta             {:bootstrap? false :durability :durable}
  :loopback             {:bootstrap? false :durability :ephemeral}
  :unknown              {:bootstrap? false :durability :ephemeral}}

 ;; States that look like success from a distance. :link-local-only is the one
 ;; that matters: the interface has an address, `ip addr` prints it, and
 ;; nothing routes -- a check that could not measure returning the value of a
 ;; check that measured and found nothing wrong (root ADR 2608136000).
 :refusals
 #{:no-interface-class
   :unknown-interface-class
   :class-not-admitted-for-bootstrap
   :no-carrier
   :no-address
   :link-local-only-is-not-a-network
   :addressing-unknown
   :addressing-unrecognised
   :static-addressing-not-authorised
   :no-admissible-interface}

 ;; Unlike the install target disk, ambiguity is RANKED, not refused. The
 ;; asymmetry is about reversibility: writing the wrong disk destroys data, so
 ;; install-v1 refuses two candidates; choosing the wrong link is corrected by
 ;; choosing again, and refusing would strand a machine that has two paths.
 :selection {:refuses-ambiguity? false
             :order [:durability :class-table-order :interface-name]
             :deterministic-for-the-same-probe? true}

 :receipt {:states #{:bootstrapped :refused}
           :fields [:interface :class :tether? :durable? :alternatives :refused]
           :when-ephemeral {:owed [:durable-network-not-yet-established
                                   :phone-may-disconnect-at-any-time]
                            :must-not [:record-this-interface-as-the-machine-network]}}

 ;; What the phone contributes, and what it must never be asked to type. The
 ;; acquisition side is platform-dependent and is NOT settled by this contract;
 ;; see :wifi-acquisition below.
 :tether {:keyboard-input-required? false
          :ipheth-requires-trust-tap-on-phone? true
          :phone-holds-credential? true
          :aiueos-learns-passphrase? false
          :is-the-machine-network? false}

 ;; The Wi-Fi profile the phone seals to the device key (phone_bind.cljc,
 ;; suite x25519-hkdf-sha256-aes-256-gcm-v1) arrives by POLLING the authority,
 ;; so the box must already be online to receive it. That is why a bootstrap
 ;; path exists at all: this contract closes the chicken-and-egg, it does not
 ;; replace the sealed-profile path.
 :wifi-acquisition
 {:phone-to-box-channels [:radio :cable :authority-relay]
  :qr-direction :box-to-phone-only
  :qr-direction-reason "the box has a screen and no camera"
  :r1 {:route :usb-tether :state :contract-only :new-driver-on-hosted? false}
  :r2 {:route :wi-fi-easy-connect-dpp
       :uri-codec "kotoba-lang/org-wi-fi-easy-connect"
       :passphrase-seen-by #{}
       :android-native-configurator? true
       :ios-configurator :unverified
       :state :uri-codec-only}
  :not-taken {:route :softap-captive-portal
              :reason "moves a plaintext passphrase through a page we write, and costs AP mode + DHCP + HTTP to get a weaker property than DPP"}}

 :present-evidence
 {:decision-core :implemented-and-unit-tested
  :contract-matrix-matches-root-adr true
  :hosted-usb-tether-live :unverified
  :bare-metal-usb-host-stack :absent
  :physical-6600hs-probe :not-started
  :dpp-interop :unverified}

 :safety {:ephemeral-link-recorded-as-machine-network? false
          :unknown-interface-class-admitted? false
          :link-local-only-counts-as-online? false}}
