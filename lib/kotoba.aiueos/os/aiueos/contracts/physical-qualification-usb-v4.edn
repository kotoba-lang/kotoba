;; K16 physical qualification with passwordless macOS result retrieval and a
;; read-only xHCI Debug Capability inventory.  Real-time DbC transport remains
;; gated on the physical controller/port result; this contract does not claim
;; that a live USB link exists yet.
{:format :aiueos.physical-qualification-usb/v4
 :machine-profile :gmktec-k16-ryzen-7-7735hs
 :architecture :x86_64
 :media-layout
 [{:partition :boot :gpt-type :efi-system :filesystem :fat32}
  {:partition :recovery :gpt-type :efi-system :filesystem :fat16}
  {:partition :result
   :gpt-type :microsoft-basic-data
   :partition-guid "1cd9b207-12e2-57b7-9702-fd32f64f65ab"
   :filesystem :fat16
   :volume-label "AIUEOS RSLT"
   :files ["AIUEOS.ID" "PROBE.LOG" "RESULT.LOG"]
   :macos-mount :normal-user-volume}]
 :boot-cycle
 [{:stage :uefi-hardware-probe-and-arm-return
   :observes [:cpu-vendor-family-model
              :gop-visible-stripe
              :uefi-memory-map
              :acpi-rsdp
              :pci-inventory
              :xhci-dbc-extended-capability-read-only
              :pci-display-network-storage-nvme-class-counts
              :uefi-block-handle-counts]
   :writes [{:target :qualification-usb/result/PROBE.LOG
             :scope :same-usb-result-partition-guid
             :maximum-bytes 65536}
            {:target :uefi/BootNext
             :scope :current-boot-option :lifetime :one-boot}
            {:target :uefi/AIUEOSQualificationResult
             :value :pending :maximum-bytes 16}]
   :internal-disk-writes :none
   :terminal-marker
   "AIUEOS_HW_PROBE_RETURN_ARMED bootnext=current result=pending"}
  {:stage :native-core
   :enters [:aiueos-loader :aiueos-kernel]
   :proves [:loader-kernel-initramfs-integrity
            :kotoba-native-object-execution
            :kernel-owned-paging
            :gop-framebuffer-write-readback
            :physical-page-allocation
            :acpi-madt-admission]
   :stops-before [:iommu :pci-dma :block-driver :network-driver :ssd-install]
   :writes [{:target :uefi/AIUEOSQualificationResult
             :value [:success :failure]
             :maximum-bytes 16}]
   :internal-disk-writes :none
   :success-screen ["AIUEOS K16" "NATIVE CORE OK" "SSD READ ONLY"]
   :terminal-marker
   "AIUEOS_PHYSICAL_QUALIFICATION_OK native-core-v2 internal-disk-writes=none"}
  {:stage :uefi-result-collector
   :trigger :one-shot-BootNext-after-native-reset
   :reads :uefi/AIUEOSQualificationResult
   :writes [{:target :qualification-usb/result/RESULT.LOG
             :scope :same-usb-result-partition-guid
             :maximum-bytes 1024}]
   :clears [:uefi/AIUEOSQualificationResult]
   :internal-disk-writes :none
   :terminal-marker
   "AIUEOS_PHYSICAL_QUALIFICATION_RESULT_SAVED"}]
 :result-volume-binding
 {:requires [:loaded-image-device-path
             :usb-messaging-parent
             :same-device-path-prefix-before-hard-drive-node
             :gpt-signature-type
             :exact-result-partition-guid
             :exact-AIUEOS.ID-content]
  :fallback-to-other-filesystem false}
 :xhci-dbc
 {:mode :read-only-detection
  :walk-limit 50
  :mmio-read-width :uint32
  :mmio-writes :none
  :success-marker "AIUEOS_HW_PROBE_XHCI_DBC_SUMMARY"
  :live-stream-state :gated-on-physical-present-result-and-port-cable-validation}
 :result-states
 {:success {:state 1 :code 0}
  :failure {:state 2 :codes {1 :physical-memory
                             2 :capability-table
                             3 :acpi-madt}}
  :incomplete {:state 0 :meaning :native-core-did-not-reach-terminal-marker}}
 :safety {:internal-disk-write-code-reached? false
          :internal-disk-target-selection :none
          :usb-write-scope :same-usb-result-partition-guid
          :uefi-variable-bytes 16
          :ssd-install :separate-later-operation
          :secure-boot :must-be-disabled-for-unsigned-development-image}
 :mac-retrieval
 {:administrator-password-required false
  :auto-discovery-volume "/Volumes/AIUEOS RSLT"
  :files ["PROBE.LOG" "RESULT.LOG"]
  :watcher :user-launch-agent
  :success-requires ["state=success"
                     "internal_ssd_writes=none"
                     "qualification_variable_cleared=yes"
                     "AIUEOS_PHYSICAL_QUALIFICATION_RESULT_SAVED state=success"]}
 :does-not-qualify [:xhci-dbc-live-stream
                    :macos-dbc-host-reader
                    :amd-iommu
                    :nvme-read
                    :nvme-write
                    :rtl8125-link
                    :wired-dhcp
                    :radeon-native-gpu-driver
                    :murakumo-inference
                    :ssd-boot]
 :ssd-install-gate
 {:requires [:result-log-success
             :probe-log-reviewed
             :k16-driver-gap-review
             :exact-internal-ssd-identity
             :fresh-owner-confirmation]
  :current-state :closed}}
