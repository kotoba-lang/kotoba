;; The declaration kotoba-native's `kernel-object-entries` transcribes, so that
;; the export symbol 37 linked objects depend on is stated by the repository
;; that owns the decision rather than invented by the one that packages it
;; (kotoba-native#57, ADR-0076).
{:format :aiueos.dhcp-reply-valid/v1
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_dhcp_reply_valid"
          :imports []}
 :arguments [:frame :length :xid :mac :expected-type]

 ;; NOT A BOOLEAN. Zero admits; every non-zero value is a refusal naming the
 ;; clause that produced it. A caller writing `if (validate(...))` -- the shape
 ;; every neighbouring object invites -- admits exactly what this rejects.
 :result {:kind :reason-code
          :admit 0
          :range [1 12]
          :truthy-is-success false}
 :reasons {0 :admitted
           1 :frame-length-outside-283-2048
           2 :ipv4-envelope-or-header-checksum
           3 :udp-ports-length-or-checksum
           4 :not-bootreply-ethernet-6
           5 :foreign-transaction-id
           6 :foreign-hardware-address
           7 :no-magic-cookie
           8 :options-do-not-parse-within-the-frame
           9 :message-type-absent-or-unexpected
           10 :no-server-identifier
           11 :address-and-mask-inconsistent
           12 :lease-absent-or-out-of-range}

 ;; The codes ascend with how far into the frame the check reaches. A caller
 ;; holding several candidate frames may report the largest to name the one that
 ;; got furthest; that is a choice about which refusal to print and not about
 ;; whether to admit.
 :ordering :by-depth-into-the-frame

 :policy {:lease-seconds {:minimum 60 :maximum 2592000}
          :netmask {:minimum 4278190080 :contiguous true :slash-32 :refused}
          :address {:network-address :refused :directed-broadcast :refused
                    :loopback :refused :multicast-and-above :refused}
          :udp-checksum {:zero :accepted
                         :note "RFC 768 makes it optional over IPv4 and zero
                                means not computed. Accepting zero is
                                conformant and is also a hole: anything that
                                can rewrite the payload can zero this field."}
          :identifies-us-by :chaddr
          :not-by :ethernet-destination
          :why "A client with no address is answered by broadcast, so the
                Ethernet header cannot say who a reply is for."}

 ;; NO EXECUTABLE VECTORS, AND THIS IS NOT AN OVERSIGHT. Every other contract in
 ;; this directory carries `:vectors` that a verifier in os/aiueos/scripts/aiueos
 ;; runs through `kir/execute`. That interpreter refuses `kernel-load-u8-4k` with
 ;; `:kernel-memory-unavailable` BY DESIGN -- there is no frame contents it could
 ;; honestly invent -- so an object that parses a frame has no off-target oracle
 ;; at all. Writing vectors nobody can run is the shape ADR-0050 named here.
 ;;
 ;; The evidence is a booted kernel instead: scripts/smoke-qemu-dhcp.sh drives
 ;; four boots against QEMU's own DHCP server, one unmodified and three with the
 ;; reply broken in one named way each, and requires the reason code that names
 ;; what was broken.
 :verification {:off-target :impossible
                :reason :kir-refuses-kernel-memory
                :evidence "os/aiueos/scripts/smoke-qemu-dhcp.sh"
                :cases [{:tamper 1 :breaks :transaction-id :expect-reason 5}
                        {:tamper 2 :breaks :message-type :expect-reason 9}
                        {:tamper 3 :breaks :option-length :expect-reason 8}
                        {:tamper 0 :breaks :nothing :expect :admitted}]}

 :shares-this-gap-with [:net-arp-reply-valid :ipv4-icmp-reply-valid
                        :tcp-segment-valid]}
