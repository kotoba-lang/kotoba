;; The declaration kotoba-native's `kernel-object-entries` transcribes -- in
;; BOTH `elf64.clj` and `elf64.cljc`, because the JVM loads `.clj` first and
;; kotoba-native ADR-0036 keeps the two a twin -- so that the export symbol is
;; stated by the repository that owns the decision.
{:format :aiueos.sha256-stream/v1
 :graph {:root aiueos.sha256-stream
         :modules [aiueos.lib.sha256-stream aiueos.sha256-stream]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_sha256_stream"
          :imports []
          :required-operations [kernel-load-u8 kernel-store-u8 kernel-subregion]}
 :arguments [:mode :st :st-len :src :src-len]

 ;; WHY THIS OBJECT EXISTS, AND WHY IT IS NOT `aiueos-sha256-region`.
 ;; Same core, driven by the caller instead of by a loop. A caller that cannot
 ;; map its whole message -- the UEFI loader reading sectors, a TLS transcript
 ;; hashed as records arrive -- calls this once per 64 bytes and keeps 512
 ;; bytes of state between calls.
 ;;
 ;; A fuel tier is a PER-CALL budget. One symbol serving both shapes would
 ;; hand the single-block call the budget a whole-megabyte call needs, and a
 ;; runaway single-block call could then spend a megabyte's worth of steps
 ;; before the counter noticed. That, and not the code, is why there are two
 ;; objects: they share `aiueos.lib.sha256-stream`, so the compression rounds
 ;; exist once in source.

 ;; NOT A BOOLEAN. ZERO IS THE SUCCESS VALUE.
 :result {:kind :reason-code
          :admit :zero
          :range [1 4]
          :truthy-is-success false}
 :reasons {1 :st-len-below-512
           2 :mode-none-of-0-1-2
           3 :block-mode-src-len-not-exactly-64
           4 :final-mode-src-len-outside-0-63}
 :modes {:init 0 :block 1 :final 2}

 :st {:bytes 512
      :layout {:schedule [0 256] :state [256 32] :working [288 32]
               :round-temp [320 32] :length [352 8] :assembly [360 64]
               :digest [424 32] :reserved [456 56]}}

 ;; THE STATE SURVIVES THE CALL, WHICH IS THE WHOLE CLAIM.
 ;; Every vector here is a SEQUENCE of calls against ONE image, because the
 ;; only thing that distinguishes this object from `aiueos-sha256-region` is
 ;; that call N+1 sees what call N wrote. A per-call runner would check the
 ;; reason codes of a streaming object and none of its streaming.
 :verification
 {:off-target :executed
  :mechanism :kir-execute-with-a-supplied-memory-image
  :runner "os/aiueos/scripts/verify-admissions.cljk"
  :host :nbb
  :node-stack-size 60000
  :memory {:base 65536 :image-bytes 2048 :st-offset 0 :src-offset 1024}
  :fuel 4000000
  :oracles {:published "FIPS 180-4 Appendix B / RFC 6234 section 8.5"
            :second-implementation "kotoba-lang/org-nist-sha2 (pure cljc)"}
  :floors {:minimum-vectors 5
           :minimum-steps 30
           :minimum-memory-assertions 4}}

 :vectors
 [{:name :abc-in-two-calls
   :message-ascii "abc"
   :steps [{:args [0 0 0] :expected 0}
           {:args [2 0 3] :expected 0
            :expect-memory [{:label :digest :offset 424
                             :hex "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"}]}]
   :why "The shortest possible drive: initialise, then finalise three bytes.
         Same answer as FIPS 180-4 Appendix B.1, reached by two calls instead
         of one."}

  {:name :fips-896-bit-in-three-calls
   :message-ascii "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
   :steps [{:args [0 0 0] :expected 0}
           {:args [1 0 64] :expected 0}
           {:args [2 64 48] :expected 0
            :expect-memory [{:label :digest :offset 424
                             :hex "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1"}]}]
   :why "FIPS 180-4 Appendix B.3, driven a block at a time. The length the
         padding commits to (896 bits) is NOT passed to the final call -- it
         is what the object counted, so a `block` call that forgot to advance
         the counter changes this digest and nothing else."}

  {:name :one-thousand-in-seventeen-calls
   :message-bytes 1000 :fill-byte 97
   :steps [{:args [0 0 0] :expected 0}
           {:args [1 0 64] :expected 0}
           {:args [1 64 64] :expected 0}
           {:args [1 128 64] :expected 0}
           {:args [1 192 64] :expected 0}
           {:args [1 256 64] :expected 0}
           {:args [1 320 64] :expected 0}
           {:args [1 384 64] :expected 0}
           {:args [1 448 64] :expected 0}
           {:args [1 512 64] :expected 0}
           {:args [1 576 64] :expected 0}
           {:args [1 640 64] :expected 0}
           {:args [1 704 64] :expected 0}
           {:args [1 768 64] :expected 0}
           {:args [1 832 64] :expected 0}
           {:args [1 896 64] :expected 0}
           {:args [2 960 40] :expected 0
            :expect-memory [{:label :digest :offset 424
                             :hex "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3"}]}]
   :why "Sixteen block calls and a 40-byte tail, and the same digest
         `aiueos-sha256-region` produces for the same 1,000 bytes in ONE call.
         Two objects, one core, one answer."}

  {:name :init-clears-the-length-and-the-state
   :message-ascii "abc"
   :steps [{:args [0 0 0] :expected 0}
           {:args [1 0 64] :expected 0}
           {:args [0 0 0] :expected 0}
           {:args [2 0 3] :expected 0
            :expect-memory [{:label :digest :offset 424
                             :hex "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"}]}]
   :why "A block is absorbed and then thrown away by a second `init`. If
         `init` reset the eight chaining words but not the byte counter, this
         would pad to 67 bytes instead of 3 and the digest would differ. That
         is the whole reason the counter is cleared there and not somewhere
         else."}

  {:name :every-refusal
   :message-bytes 64 :fill-byte 97
   :steps [{:args [0 0 0 511] :expected 1}
           {:args [3 0 0] :expected 2}
           {:args [-1 0 0] :expected 2}
           {:args [1 0 63] :expected 3}
           {:args [1 0 65] :expected 3}
           {:args [2 0 64] :expected 4}
           {:args [2 0 -1] :expected 4}
           {:args [0 0 0] :expected 0}]
   :why "All four reasons, both edges of each range, and one success at the
         end so a run in which the object had simply stopped working is not
         counted as a set of correct refusals. `mode -1` and `mode 3` are both
         refused: the mode test is an equality chain, not a bound, and a
         negative mode that fell through to `final` would pad a state nobody
         initialised."}]}
