{:format :aiueos.value-runtime-cas-verify/v1
 :identity {:cid-version 1 :codec :dag-cbor :multihash :sha2-256
            :digest-bytes 32}
 :graph {:root aiueos.value-runtime-cas-verify
         :modules [aiueos.sha256
                   aiueos.digest-equal
                   aiueos.value-runtime-cas-verify]}
 :input {:block-length {:minimum 1 :maximum 12288}
         :expected-digest-bytes 32
         :output-bytes 32 :workspace-bytes 352}
 :result {1 :digest-match 0 :rejected}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_value_runtime_cas_verify"
          :imports []
          :required-operations [kernel-load-u8-16k kernel-load-u8 kernel-store-u8]}
 :trust-boundary {:integrity-verified true
                  :canonical-value-validation false
                  :queue-request-binding false
                  :handle-installation false}
 ;; The layout the runner writes each vector into, and the floors it refuses to
 ;; report a pass without. Added 2026-08-31 with the runner rewrite: until then
 ;; `verify_value_runtime_cas_verify.clj` computed each answer with
 ;; `java.security.MessageDigest` and compared THAT against `:expected` below,
 ;; so these six vectors passed whatever the compiled object did. The object is
 ;; now executed against a supplied memory image (aiueos ADR-0128).
 :verification
 {:off-target :executed
  :mechanism :kir-execute-with-a-supplied-memory-image
  :runner "os/aiueos/scripts/verify-admissions.cljk"
  :host :nbb
  :memory {:base 65536 :image-bytes 13056
           :expected-offset 0 :output-offset 64
           :workspace-offset 128 :block-offset 512}
  :fuel 400000000
  :floors {:minimum-vectors 6 :both-verdicts-observed true}}

 :vectors
 [{:name :empty-rejected :input-hex "" :expected-digest-hex "" :expected 0}
  {:name :abc-matches
   :input-hex "616263"
   :expected-digest-hex "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
   :expected 1}
  {:name :abc-mismatch
   :input-hex "616263"
   :expected-digest-hex "bb7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
   :expected 0}
  ;; The name is older than the object and outlives its accuracy. There is no
  ;; length check here: `aiueos-value-runtime-cas-verify` passes the literal 32
  ;; to `aiueos-digest-equal`, so a caller who supplies fewer bytes has the
  ;; following thirty read as though they were digest. This vector is refused
  ;; because `ba78` + zeros is not SHA-256("abc"), NOT because two bytes were
  ;; noticed to be two. The old Java-model runner returned 0 here for the
  ;; length reason and agreed by coincidence; executing the object is what
  ;; separated the two.
  {:name :digest-length-rejected
   :input-hex "616263" :expected-digest-hex "ba78" :expected 0
   :refused-for :digest-mismatch :not-for :short-expected-region}
  {:name :maximum-bounded-length :generated-bytes 12288 :fill-byte 0
   :expected-digest-hex "f3cc103136423a57975750907ebc1d367e2985ac6338976d4d5a439f50323f4a"
   :expected 1}
  {:name :oversize-rejected :generated-bytes 12289 :fill-byte 0
   :expected-digest-hex "" :expected 0}]}
