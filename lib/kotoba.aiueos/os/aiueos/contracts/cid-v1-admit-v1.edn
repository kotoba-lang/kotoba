;; The declaration kotoba-native's `kernel-object-entries` transcribes -- in
;; BOTH `elf64.clj` and `elf64.cljc`, because the JVM loads `.clj` first and
;; kotoba-native ADR-0036 keeps the two a twin -- so that the export symbol is
;; stated by the repository that owns the decision.
{:format :aiueos.cid-v1-admit/v1
 :graph {:root aiueos.cid-v1-admit
         :modules [aiueos.sha256 aiueos.cid-v1-admit]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_cid_v1_admit"
          :imports []
          :required-operations [kernel-load-u8 kernel-load-u8-16k
                                kernel-store-u8 kernel-subregion]}
 :arguments [:cid :cid-length :block :block-length :scratch]

 ;; WHY THIS OBJECT EXISTS, stated against its neighbour.
 ;; `value-runtime-cas-verify-v1.edn` declares
 ;;   :identity {:cid-version 1 :codec :dag-cbor :multihash :sha2-256
 ;;              :digest-bytes 32}
 ;; and then takes a 32-byte `expected` digest. Those four fields are asserted
 ;; by the caller and read by nothing. The machine therefore never decides
 ;; WHICH CID it holds, only that some digest it was handed matches -- and
 ;; every artifact this device fetches from `https://ipfs.kotobase.net/ipfs/…`
 ;; (ADR-0118 model channel, ADR-0122 signed A/B OS update) is named by a CID
 ;; whose four prefix bytes nothing here read. This object reads them.
 :envelope
 {:cid-bytes 36 :cid-version 1 :multihash-code 18 :multihash-code-name :sha2-256
  :digest-bytes 32
  :permitted-codecs {85 :raw 112 :dag-pb 113 :dag-cbor}
  :why-those-three "kotobase `PUT /ipfs/:cid` takes raw only; UnixFS file
                    nodes are dag-pb; the value runtime's canonical blocks are
                    dag-cbor."
  :one-byte-codec-only
  "A codec above 0x7f takes two varint bytes and produces a 37-byte CID, which
   reason 1 refuses. That is the correct refusal for this fixed-width envelope
   and it is a bound, not a universal truth about CIDv1. A CIDv0 is a bare
   34-byte multihash with no version byte at all, so it is also refused by
   reason 1 rather than by reason 2."
  :no-required-codec-parameter
  "The codec a caller wants is the codec in the CID the caller passes. A
   requirement that comes from STRUCTURE instead -- `the links of a UnixFS
   file node must be raw leaves` -- belongs to the object that knows the
   structure. The ABI admits five parameters and this is not one of them."}

 :scratch {:bytes 416
           :output {:offset 0 :bytes 32}
           :workspace {:offset 64 :bytes 352}
           :derived-by kernel-subregion
           :why "Two pointers would not fit in five parameters, and deriving
                 both through `kernel-subregion` makes the narrowing checked
                 rather than assumed."}

 ;; NOT A BOOLEAN. Zero admits; every non-zero value is a refusal naming the
 ;; clause that produced it. A caller writing `if (admit(...))` -- the shape
 ;; every neighbouring object invites -- admits exactly what this rejects.
 :result {:kind :reason-code :admit 0 :range [1 8] :truthy-is-success false}
 :reasons {0 :admitted
           1 :cid-length-not-36
           2 :not-cid-version-1
           3 :codec-not-permitted
           4 :multihash-not-sha2-256
           5 :multihash-digest-length-not-32
           6 :block-length-above-12288
           7 :sha256-refused
           8 :digest-mismatch}
 :ordering :by-depth-into-the-cid-then-the-block

 ;; Reason 7 is declared and NOT exercised, and saying so is the point.
 ;; `aiueos-sha256` returns 0 on exactly two conditions: an input above 12288
 ;; bytes, which reason 6 has already refused, and a workspace below 352
 ;; bytes, which cannot happen because the object passes the literal 352. The
 ;; branch is retained so that a later change to either bound cannot silently
 ;; compare against an output buffer nothing wrote. Writing a vector that
 ;; claimed to reach it would be the theatre this contract exists to end.
 :unreachable-by-construction #{7}

 :verification
 {:off-target :executed
  :mechanism :kir-execute-with-a-supplied-memory-image
  :runner "os/aiueos/scripts/verify-admissions.cljk"
  :host :nbb
  :note
  "Until kotoba-kir 10fa46ce every byte-walking object here had NO off-target
   oracle: `kir/execute` refused `kernel-load-u8` outright, so
   `dhcp-reply-valid-v1.edn` writes `:verification {:off-target :impossible}`
   and `verify_value_runtime_cas_verify.clj` re-implements SHA-256 in Java and
   compares THAT to its own expected values -- six vectors that pass whatever
   the compiled object does. This runner executes the object."
  :memory {:base 65536 :image-bytes 13056
           :cid-offset 0 :scratch-offset 64 :block-offset 512}
  :fuel 400000000
  :floors {:minimum-vectors 14
           :every-reachable-reason-observed true}}

 ;; `:cid-hex` is the binary CIDv1, which is what the object reads. `:cid` is
 ;; the base32 multibase name a human can paste into a gateway; it is written
 ;; only where the CID is a real one.
 :vectors
 [{:name :empty-raw-block
   :cid "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
   :cid-hex "01551220e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
   :block-hex "" :expected 0
   :why "An empty block is a real block, and ADR-0082 already fetches this
         exact CID over TLS. The lower length bound is zero, not one."}
  {:name :abc-raw-block
   :cid "bafkreif2pall7dybz7vecqka3zo24irdwabwdi4wc55jznaq75q7eaavvu"
   :cid-hex "01551220ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
   :block-hex "616263" :expected 0}
  {:name :dag-pb-envelope-over-the-same-bytes
   :cid "bafybeif2pall7dybz7vecqka3zo24irdwabwdi4wc55jznaq75q7eaavvu"
   :cid-hex "01701220ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
   :block-hex "616263" :expected 0
   :why "Same digest, different codec, and both are admitted -- which is
         exactly why a caller that needs a raw leaf must compare the CID it
         demanded, not merely the digest. This object admits the envelope; the
         structure decides the codec."}
  {:name :dag-cbor-envelope-over-the-same-bytes
   :cid-hex "01711220ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
   :block-hex "616263" :expected 0}
  {:name :maximum-block
   :cid-hex "01551220f3cc103136423a57975750907ebc1d367e2985ac6338976d4d5a439f50323f4a"
   :block-bytes 12288 :fill-byte 0 :expected 0}
  {:name :one-block-byte-changed
   :cid-hex "01551220ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
   :block-hex "616264" :expected 8}
  {:name :one-digest-byte-changed
   :cid-hex "01551220bb7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
   :block-hex "616263" :expected 8}
  {:name :cid-thirty-five-bytes
   :cid-hex "01551220ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015"
   :block-hex "616263" :expected 1}
  {:name :cid-thirty-seven-bytes-two-byte-codec
   :cid-hex "01a9021220ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
   :block-hex "616263" :expected 1
   :why "0x0129 is dag-json. A two-byte codec varint is a 37-byte CID and this
         envelope is 36."}
  {:name :cid-version-two
   :cid-hex "02551220ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
   :block-hex "616263" :expected 2}
  {:name :unassigned-codec
   :cid-hex "01601220ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
   :block-hex "616263" :expected 3}
  {:name :sha2-512-multihash
   :cid-hex "01551320ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
   :block-hex "616263" :expected 4}
  {:name :digest-length-sixty-four
   :cid-hex "01551240ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
   :block-hex "616263" :expected 5}
  {:name :block-above-the-bound
   :cid-hex "01551220ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
   :block-bytes 12289 :fill-byte 0 :expected 6
   :why "Refused before any block byte is read, so the digest of those 12289
         bytes never enters it."}]

 ;; A trap is not a reason code. `kernel-subregion` faults on a null base, and
 ;; the machine's answer to that is UD2 -- the kernel dies rather than admits.
 ;; The oracle reproduces the fault, so the distinction is testable.
 :traps
 [{:name :null-scratch :scratch 0
   :cid-hex "01551220ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
   :block-hex "616263"
   :expect-trap :kernel-memory-fault :expect-check :null-base}]}
