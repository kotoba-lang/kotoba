;; Online model distribution for pure AIUEOS. USB is boot/recovery media; model
;; weights live as immutable CID blocks in Kotobase and are selected by a
;; verified, monotonic IPNS channel head.
{:format :aiueos.model-channel/v1
 :authority {:storage :kotobase
             :immutable-read "https://ipfs.kotobase.net/ipfs/{cid}"
             :latest-read "https://ipfs.kotobase.net/ipns/{k51-name}"
             :identity :ipns-ed25519
             :transport :https}
 :channel {:name "qwen3.8-27b-k16"
           :head :signed-ipns-record
           :head-admission [:ed25519-signature :validity :monotonic-sequence
                            :same-sequence-same-cid :previous-manifest-cid]
           :manifest :canonical-json-raw-cid
           :target {:architecture "x86_64"
                    :machine "gmktec-k16"
                    :min-aiueos-abi 4}}
 :artifact {:format "gguf-v3"
            :blocks {:codec :raw
                     :multihash :sha2-256
                     :maximum-bytes 99614720
                     :maximum-count 900}
            :admission [:raw-cid-each-block :exact-block-size
                        :whole-artifact-sha256]
            :registry-revision-cid :optional-dag-cbor-link}
 :device-cache {:medium :internal-nvme
                :layout :two-slot
                :download :missing-cids-only
                :activation :atomic-after-full-verification
                :failure :boot-last-known-good
                :partial-slot-bootable? false}
 :usb {:contains [:aiueos-boot :recovery]
       :contains-model-by-default? false
       :offline-model-bundle :explicit-recovery-only}
 :planes {:kotobase [:immutable-model-bytes :revision-cids :signed-head]
          :murakumo [:search-projection :scan :promotion :inference]
          :aiueos [:admission :local-cache :activation :runtime]}
 :current-evidence {:pure-decision-and-tests :implemented
                    :kotobase-ipns-publisher-sequence :implemented
                    :qemu-native-manifest-fetch :not-yet-measured
                    :physical-k16-download :unverified
                    :nvme-two-slot-writer :not-yet-implemented
                    :real-qwen38-generation :absent}}
