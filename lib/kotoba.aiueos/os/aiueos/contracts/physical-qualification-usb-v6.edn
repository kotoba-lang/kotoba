;; v6 retains all v5 terminal failure codes, and also persists the last stage
;; before every firmware call that can hang. A loader watchdog resets the
;; qualification run so BootNext can collect the incomplete progress record.
{:format :aiueos.physical-qualification-usb/v6
 :extends "physical-qualification-usb-v5.edn"
 :machine-profile :gmktec-k16-ryzen-7-7735hs
 :unchanged [:media-layout
             :result-volume-binding
             :xhci-dbc-read-only-inventory
             :result-text-v4
             :loader-failure-codes-v5
             :internal-disk-writes-none]
 :loader-progress-return
 {:codes {201 :loaded-image-protocol
          202 :kernel-buffer
          203 :initramfs-buffer
          204 :kernel-admission
          205 :elf-validation
          206 :segment-allocation
          207 :memory-map-buffer
          208 :gop-discovery
          209 :exit-boot-services-or-native-core}
  :persisted-before-stage true
  :persisted-to :uefi/AIUEOSQualificationResult
  :maximum-bytes 16
  :state :incomplete
  :watchdog-seconds 90
  :watchdog-action :firmware-reset
  :collector :bootnext-same-parent-usb-probe
  :manual-power-cycle-fallback true
  :result-target :qualification-usb/result/RESULT.LOG}
 :negative-gate
 {:command "os/aiueos/scripts/smoke-qemu-physical-loader-hang.sh"
  :forced-progress-code 290
  :test-watchdog-seconds 3
  :requires [:progress-persisted
             :watchdog-reset
             :bootnext-collector
             :result-log-incomplete-code
             :write-confined-to-result-partition]}
 :safety {:internal-disk-write-code-reached? false
          :usb-write-scope :same-usb-result-partition-guid
          :uefi-variable-bytes 16
          :ssd-install :separate-later-operation}}
