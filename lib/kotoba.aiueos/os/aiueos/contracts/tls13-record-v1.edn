;; The declaration kotoba-native's `kernel-object-entries` transcribes -- in
;; BOTH `elf64.clj` and `elf64.cljc`, because the JVM loads `.clj` first and
;; kotoba-native ADR-0036 keeps the two a twin -- so that the export symbol is
;; stated by the repository that owns the decision.
{:format :aiueos.tls13-record/v1
 :graph {:root aiueos.tls13-record
         :modules [aiueos.lib.aes128-gcm-core aiueos.tls13-record]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_tls13_record"
          :imports []
          :required-operations [kernel-load-u8-4k kernel-store-u8-4k
                                kernel-load-u8-16k kernel-subregion]}
 :arguments [:ctx :ctx-len :rec :rec-len :mode]

 ;; WHY THIS OBJECT EXISTS.
 ;; ADR-0132 moved the AEAD into `aes128-gcm.kotoba`; `protect` and `unprotect`
 ;; in `kernel/tls13.c` (:311, :335) stayed, and they are not plumbing. The
 ;; 5-byte header is the ADDITIONAL AUTHENTICATED DATA, so a length taken from
 ;; the wrong place is a forgery the AEAD accepts. The sequence number is XORed
 ;; into the nonce, so a reused sequence is a reused keystream. The inner
 ;; content type is the last non-zero plaintext byte, so a padding strip that
 ;; stops early hands the caller the wrong record type.

 :result {:kind :reason-code :admit 0 :range [1 7] :truthy-is-success false}
 :reasons {0 :done
           1 :ctx-below-1280
           2 :mode-neither-seal-nor-open
           3 :rec-len-outside-22-12310
           4 :seal-plaintext-does-not-fit
           5 :open-length-field-or-body-bound
           6 :open-tag-mismatch
           7 :open-inner-plaintext-is-all-zeros}
 :modes {1 :seal 0 :open}

 ;; A DEAD CLAUSE, measured rather than reasoned about.
 ;; The object refuses `clen < 17` under reason 5, transcribing the same guard
 ;; the C had. It cannot fire: rec-len >= 22 (reason 3) and clen + 5 = rec-len
 ;; (reason 5's first clause) together force clen >= 17. This was found by
 ;; writing a vector for it and watching it come back 3 instead of 5.
 ;;
 ;; Reason 5 is still exercised, by its two live clauses, so this is NOT
 ;; `:unreachable-by-construction` -- that key names a whole reason code and
 ;; would claim more than is true. The clause is kept because it guards
 ;; `(- clen 16)` from going negative if the 22-byte floor is ever lowered,
 ;; and because deleting a check to make a vector reachable is the wrong
 ;; direction.
 :dead-clause {:reason 5 :clause :clen-below-17
               :subsumed-by [:rec-len-below-22 :length-field-disagrees]}

 :ctx {:bytes 1280
       :key {:offset 0 :bytes 16}
       :iv {:offset 16 :bytes 12 :note "the BASE iv; never modified"}
       :tag-scratch {:offset 32 :bytes 16}
       :sequence {:offset 48 :bytes 8 :encoding :big-endian}
       :content-type {:offset 56 :bytes 1 :direction {:seal :read :open :written}}
       :plaintext-length {:offset 58 :bytes 2 :encoding :big-endian
                          :direction {:seal :read :open :written}}
       :record-length {:offset 60 :bytes 2 :encoding :big-endian
                       :direction {:seal :written}}
       :aad {:offset 64 :bytes 64 :note "the 5-byte header occupies 64..69"}
       :derived-nonce {:offset 480 :bytes 12}
       :why-the-nonce-has-its-own-slot
       "The nonce is `iv XOR seq` and a caller sends many records under one
        key. An object that XORed in place would corrupt the IV on the second
        record, and the corruption would look like a peer that stopped
        decrypting rather than like a bug here."}

 ;; The AEAD in this object is `aes128-gcm.kotoba` copied, not imported: a
 ;; kernel object exports one symbol and cannot call another, and a namespace
 ;; declaring `(:require ...)` cannot be packaged for this target at all
 ;; (measured 2026-09-02 against amu b1fdaad2). The copy differs in exactly two
 ;; ways, both stated in the object's header so the two files can be diffed:
 ;; `set-j0` reads the nonce from 480 rather than the IV slot, and `data` is
 ;; spelled `body`.
 :aead {:copied-from "os/aiueos/kotoba/aes128-gcm.kotoba"
        :differences [:nonce-read-from-480 :data-renamed-body]}

 :verification
 {:off-target :executed
  :mechanism :kir-execute-with-a-supplied-memory-image
  :runner "os/aiueos/scripts/verify-admissions.cljk"
  :host :nbb
  ;; See aes128-gcm-v1.edn: 4000 is enough for the ANALYZER and not for the
  ;; INTERPRETER on this object, and the limit is timing-dependent.
  ;;   ulimit -s 65520
  ;;   node --stack-size=60000 "$(command -v nbb)" --classpath ... \
  ;;     os/aiueos/scripts/verify-admissions.cljk os/aiueos/contracts/tls13-record-v1.edn
  :node-stack-size 60000
  :memory {:base 65536 :image-bytes 13600 :ctx-offset 0 :rec-offset 1280}
  :fuel 4000000000
  :largest-executed-record-bytes 72
  :floors {:minimum-vectors 17
           :minimum-memory-assertions 18
           :every-reachable-reason-observed true}}

 :vectors
 ;; The four records below with a `:record-hex` that is not marked synthetic
 ;; are PRINTED IN RFC 8448 section 3, complete and encrypted, beside the
 ;; traffic keys that produced them. They are taken from the extraction
 ;; kotoba-lang/org-ietf-tls keeps at `resources/rfc8448_section3.edn`, whose
 ;; header records the source document's SHA-256.
 ;;
 ;; The SEQUENCE NUMBERS were not guessed: each record was opened with OpenSSL
 ;; through node at sequences 0..3 and the one that authenticated was taken.
 ;; That is how the client alert turns out to be seq 1 (it follows the client's
 ;; application_data on the same key) and the server alert seq 2 (the server's
 ;; NewSessionTickets came first). Non-zero sequences are the whole reason
 ;; those vectors are here: they are what exercises the nonce XOR.
 [{:name :seal-client-application-data-sequence-0
   :mode 1
   :key-hex "17422dda596ed5d9acd890e3c63f5051"
   :iv-hex "5b78923dee08579033e523d9" :sequence 0 :content-type 23
   :plaintext-hex "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"
   :expected 0
   :expect-record-hex "1703030043a23f7054b62c94d0affafe8228ba55cbefacea42f914aa66bcab3f2b9819a8a5b46b395bd54a9a20441e2b62974e1f5a6292a2977014bd1e3deae63aeebb21694915e4"
   :expect-record-length 72
   :why "RFC 8448 s3 `client send application_data record`. The object is
         handed the 50-byte payload and produces the entire 72-byte record --
         header, ciphertext and tag -- byte for byte."}
  {:name :seal-client-alert-sequence-1
   :mode 1
   :key-hex "17422dda596ed5d9acd890e3c63f5051"
   :iv-hex "5b78923dee08579033e523d9" :sequence 1 :content-type 21
   :plaintext-hex "0100" :expected 0
   :expect-record-hex "1703030013c9872760655666b74d7ff1153efd6db6d0b0e3"
   :expect-record-length 24
   :why "The same key with sequence 1. If the nonce XOR were dropped this
         record would still seal, and it would seal WRONG -- which is what
         makes a non-zero sequence worth a vector."}
  {:name :seal-server-application-data-sequence-1
   :mode 1
   :key-hex "9f02283b6c9c07efc26bb9f2ac92e356"
   :iv-hex "cf782b88dd83549aadf1e984" :sequence 1 :content-type 23
   :plaintext-hex "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"
   :expected 0
   :expect-record-hex "17030300432e937e11ef4ac740e538ad36005fc4a46932fc3225d05f82aa1b36e30efaf97d90e6dffc602dcb501a59a8fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d"
   :expect-record-length 72
   :why "The same plaintext as the first vector under the server's key and a
         different sequence, so the two ciphertexts share nothing."}
  {:name :open-client-application-data-sequence-0
   :mode 0
   :key-hex "17422dda596ed5d9acd890e3c63f5051"
   :iv-hex "5b78923dee08579033e523d9" :sequence 0
   :record-hex "1703030043a23f7054b62c94d0affafe8228ba55cbefacea42f914aa66bcab3f2b9819a8a5b46b395bd54a9a20441e2b62974e1f5a6292a2977014bd1e3deae63aeebb21694915e4"
   :expected 0
   :expect-plaintext-hex "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031"
   :expect-content-type 23 :expect-plaintext-length 50}
  {:name :open-client-alert-sequence-1
   :mode 0
   :key-hex "17422dda596ed5d9acd890e3c63f5051"
   :iv-hex "5b78923dee08579033e523d9" :sequence 1
   :record-hex "1703030013c9872760655666b74d7ff1153efd6db6d0b0e3"
   :expected 0 :expect-plaintext-hex "0100"
   :expect-content-type 21 :expect-plaintext-length 2}
  {:name :open-server-alert-sequence-2
   :mode 0
   :key-hex "9f02283b6c9c07efc26bb9f2ac92e356"
   :iv-hex "cf782b88dd83549aadf1e984" :sequence 2
   :record-hex "1703030013b58fd67166ebf599d24720cfbe7efa7a8864a9"
   :expected 0 :expect-plaintext-hex "0100"
   :expect-content-type 21 :expect-plaintext-length 2
   :why "Sequence 2, because the server's NewSessionTickets record and its
         application_data both preceded this one on the same key."}
  {:name :open-a-record-whose-inner-plaintext-is-padded
   :mode 0 :synthetic true
   :key-hex "17422dda596ed5d9acd890e3c63f5051"
   :iv-hex "5b78923dee08579033e523d9" :sequence 3
   :record-hex "170303001605b8c114c49a1e451c03bce282e6dc84a669ec5afd46"
   :expected 0 :expect-plaintext-hex "414243"
   :expect-content-type 22 :expect-plaintext-length 3
   :why "SYNTHETIC -- sealed with OpenSSL for this contract, because RFC 8448
         section 3 contains no padded record. Inner plaintext is 41 42 43 16
         00 00: three content bytes, a handshake content type, and two bytes of
         RFC 8446 5.4 padding. Nothing else here exercises the padding strip,
         and a strip that stops one byte early returns content type 0x00."}
  {:name :open-a-record-whose-inner-plaintext-is-all-zeros
   :mode 0 :synthetic true
   :key-hex "17422dda596ed5d9acd890e3c63f5051"
   :iv-hex "5b78923dee08579033e523d9" :sequence 7
   :record-hex "170303001191ef101c047585e7c6cc9c0b19dfe35f9f"
   :expected 7
   :why "SYNTHETIC, sealed with OpenSSL: a one-byte inner plaintext of 0x00.
         RFC 8446 5.4 says a record whose plaintext is all padding has no
         content type, and the peer must alert. This is reason 7 rather than a
         record of type zero -- the distinction the C's `while (content_len > 0
         && ...) content_len--; if (content_len == 0) return 0;` also made, and
         which a caller reading the type byte without checking the return would
         lose."}
  {:name :open-refuses-the-wrong-sequence-number
   :mode 0
   :key-hex "17422dda596ed5d9acd890e3c63f5051"
   :iv-hex "5b78923dee08579033e523d9" :sequence 1
   :record-hex "1703030043a23f7054b62c94d0affafe8228ba55cbefacea42f914aa66bcab3f2b9819a8a5b46b395bd54a9a20441e2b62974e1f5a6292a2977014bd1e3deae63aeebb21694915e4"
   :expected 6
   :why "The sequence-0 record replayed at sequence 1. This is the vector that
         fails if the nonce XOR is dropped or applied to the wrong bytes, and
         it fails as a TAG MISMATCH rather than as garbage plaintext."}
  {:name :open-refuses-a-flipped-tag-byte
   :mode 0
   :key-hex "17422dda596ed5d9acd890e3c63f5051"
   :iv-hex "5b78923dee08579033e523d9" :sequence 0
   :record-hex "1703030043a23f7054b62c94d0affafe8228ba55cbefacea42f914aa66bcab3f2b9819a8a5b46b395bd54a9a20441e2b62974e1f5a6292a2977014bd1e3deae63aeebb21694915e5"
   :expected 6
   :why "The same record with its last tag byte e4 -> e5."}
  {:name :ctx-below-the-required-1280
   :mode 0 :ctx-len 1279
   :key-hex "17422dda596ed5d9acd890e3c63f5051"
   :iv-hex "5b78923dee08579033e523d9" :sequence 0
   :record-hex "1703030013c9872760655666b74d7ff1153efd6db6d0b0e3"
   :expected 1}
  {:name :mode-two-is-neither
   :mode 2
   :key-hex "17422dda596ed5d9acd890e3c63f5051"
   :iv-hex "5b78923dee08579033e523d9" :sequence 0
   :record-hex "1703030013c9872760655666b74d7ff1153efd6db6d0b0e3"
   :expected 2}
  {:name :rec-len-twenty-one
   :mode 0 :rec-len 21
   :key-hex "17422dda596ed5d9acd890e3c63f5051"
   :iv-hex "5b78923dee08579033e523d9" :sequence 0
   :record-hex "1703030013c9872760655666b74d7ff1153efd6db6d0b0e3"
   :expected 3
   :why "A 5-byte header, one inner byte and a 16-byte tag is 22. Twenty-one
         bytes cannot be a protected record at all."}
  {:name :rec-len-twelve-thousand-three-hundred-eleven
   :mode 0 :rec-len 12311 :record-fill-bytes 12320
   :record-hex "1703030013"
   :key-hex "17422dda596ed5d9acd890e3c63f5051"
   :iv-hex "5b78923dee08579033e523d9" :sequence 0
   :expected 3
   :why "12310 is 5 + 12288 + 1 + 16 -- the largest record whose body fits the
         AEAD's own bound. A conforming peer may send more (RFC 8446 allows
         2^14 + 256), and this refuses it by naming the bound rather than
         trapping."}
  {:name :seal-plaintext-does-not-fit-the-buffer
   :mode 1 :rec-len 72
   :key-hex "17422dda596ed5d9acd890e3c63f5051"
   :iv-hex "5b78923dee08579033e523d9" :sequence 0 :content-type 23
   :plaintext-length-override 100
   :record-fill-bytes 72
   :expected 4
   :why "A 100-byte plaintext needs 122 bytes of record. Refused on the length
         alone, before a byte is written past the end."}
  {:name :open-length-field-disagrees-with-the-buffer
   :mode 0 :rec-len 71
   :key-hex "17422dda596ed5d9acd890e3c63f5051"
   :iv-hex "5b78923dee08579033e523d9" :sequence 0
   :record-hex "1703030043a23f7054b62c94d0affafe8228ba55cbefacea42f914aa66bcab3f2b9819a8a5b46b395bd54a9a20441e2b62974e1f5a6292a2977014bd1e3deae63aeebb21694915e4"
   :expected 5
   :why "The header says 0x43 + 5 = 72 and the caller says 71. Which one is
         right is not this object's decision to make; both are refused."}
  {:name :open-body-above-the-aead-bound
   :mode 0 :rec-len 12310 :record-fill-bytes 12310
   :record-hex "1703033011"
   :key-hex "17422dda596ed5d9acd890e3c63f5051"
   :iv-hex "5b78923dee08579033e523d9" :sequence 0
   :expected 5
   :why "The largest rec-len the object admits, with a length field of 0x3011 =
         12305, so the body would be 12289 -- one past the AEAD's 12288. This
         is the LIVE third clause of reason 5, and reaching it costs nothing
         because the refusal happens before any crypto."}]}
