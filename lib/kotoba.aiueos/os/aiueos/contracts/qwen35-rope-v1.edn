;; The declaration kotoba-native's `kernel-object-entries` transcribes, in both
;; `elf64.clj` and `elf64.cljc`.
{:format :aiueos.qwen35-rope/v1
 :graph {:root aiueos.qwen35-rope
         :modules [aiueos.qwen35-rope]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_rope"
          :imports []
          :required-operations [kernel-load-u32 kernel-store-u32 kernel-subregion
                                f32-add f32-sub f32-mul f32-from-bits f32-to-bits
                                f32-to-f64-exact f64-to-f32-rounded i64-to-f32-rounded
                                f64-add f64-sub f64-mul f64-neg f64-eq
                                f64-from-bits f64-to-bits bit-and bit-or quot]}
 :arguments [:values :values-bytes :heads :position]

 ;; ADR-0222 stage B item 6, the rope stage. The rotary embedding of the
 ;; full-attention heads, in place over the first 64 of each head's 256
 ;; dimensions (pair i = dimensions i and i+32); the other 192 are not
 ;; touched, and every vector's memory assertion covers the WHOLE region, so
 ;; a write past dimension 63 is caught.

 ;; THE REFERENCE IS PRISM LLAMA.CPP, NOT `rope_heads`. The C's sine is x87
 ;; `fsincos`, which amu cannot emit, and its frequencies come from
 ;; `local_exp` rather than the iterated theta_scale product. The expected
 ;; bytes below are `tests/prism_rope_oracle.c`: Prism 9a9394a's
 ;; `ggml_rope_cache_init` + `rotate_pairs` verbatim, with `cosf` / `sinf`
 ;; replaced by a transcription of the language's `f64-cos-bounded` /
 ;; `f64-sin-bounded` evaluated on the widened binary32 angle -- which is
 ;; what the object computes. `--measure`: over the whole admitted domain
 ;; (823,552 angles) that differs from correctly rounded binary64 libm at 5
 ;; sines and 7 cosines. Against glibc cosf/sinf: not measured.

 ;; The vectors are the live geometry -- 1 / 2 / 4 key heads / 24 query heads,
 ;; positions 0, 1, 5, 6, 7 (the kernel's decode stops at 7) -- plus 4,096 and
 ;; the last admitted position, 25,735, where pair 0's angle is 0.93 below the
 ;; intrinsic's domain limit -- and 15,975, the first position whose pair-0
 ;; sine rounds differently if the reduction drops the low part of pi/2 (no
 ;; other vector here can tell a one-part reduction from the two-part one;
 ;; measured by removing it: 14/14 stayed green before this vector existed).
 ;; Its pair 0 is x0 = 0, x1 = 1, so dimension 0 is exactly -sin and the ulp
 ;; is not absorbed by the rotation's rounding (with random inputs it was).
 ;; Input magnitudes span 2^-6..2^5, both signs.

 :result {:kind :reason-code :admit 0 :range [-4 -1] :truthy-is-success false}
 :reasons {0 :done
           -1 :null-values
           -2 :heads-outside-1-64
           -3 :values-bytes-is-not-heads-times-1024
           -4 :position-outside-0-25735}

 :verification {:node-stack-size 4000
                :fuel 400000000
                :memory {:base 4096 :image-bytes 24576 :values-offset 0}
                :floors {:minimum-vectors 15
                         :minimum-memory-assertions 8
                         :every-reachable-reason-observed true}}
 :vectors
 [
  {:name :position-zero, :heads 1, :position 0, :input-hex "", :expect-values-hex "", :expected 0}
  {:name :position-one, :heads 1, :position 1, :input-hex "", :expect-values-hex "", :expected 0}
  {:name :position-five-two-heads, :heads 2, :position 5, :input-hex "", :expect-values-hex "", :expected 0}
  {:name :position-seven-key-heads, :heads 4, :position 7, :input-hex "", :expect-values-hex "", :expected 0}
  {:name :position-six-query-heads, :heads 24, :position 6, :input-hex "", :expect-values-hex "", :expected 0}
  {:name :position-4096, :heads 1, :position 4096, :input-hex "", :expect-values-hex "", :expected 0}
  {:name :position-at-the-ceiling, :heads 1, :position 25735, :input-hex "", :expect-values-hex "", :expected 0}
  {:name :position-15975-needs-the-low-part, :heads 1, :position 15975, :input-hex "", :expect-values-hex "", :expected 0}
  {:name :null-values, :heads 1, :position 1, :values-base-override 0, :expected -1}
  {:name :heads-zero, :heads 0, :position 1, :expected -2}
  {:name :heads-above-the-ceiling, :heads 65, :position 1, :values-bytes-override 66560, :expected -2}
  {:name :values-bytes-short, :heads 2, :position 1, :values-bytes-override 2044, :expected -3}
  {:name :values-bytes-long, :heads 1, :position 1, :values-bytes-override 1028, :expected -3}
  {:name :position-past-the-ceiling, :heads 1, :position 25736, :expected -4}
  {:name :position-negative, :heads 1, :position -1, :expected -4}
 ]}
