;; The K16 pure Kotoba/Amu native profile, and the negative gate that decides
;; whether a link is one (ADR-0131).
;;
;; This contract states an acceptance rule and a MEASURED current position.
;; The C-free boot/memory substrate now boots under QEMU; NIC, HTTPS and Qwen
;; remain open, so that result must not be read as an all-native K16 node.
{:format :aiueos.k16-pure-native-profile/v1
 :target "x86_64-aiueos-kernel-v1"
 :profile {:env "AIUEOS_K16_PURE_NATIVE=1"
           :env-overrides
           {"AIUEOS_K16_PURE_NATIVE_PROVENANCE"
            "manifest to gate against; still checked digest-for-digest"
            "AIUEOS_KOTOBA_LOADER_EFI"
            "a Kotoba/Amu-produced PE32+ loader; its absence is the refusal"
            "AIUEOS_K16_LINK_LIST_OUT"
            "write the ordinary link's exact object list and change nothing else"}
           :entry-point "os/aiueos/scripts/build-k16-pure-native.cljk"
           :bootable-invocation
           "kbb --backend sci os/aiueos/scripts/build-k16-pure-native.cljk --compiler /path/to/pinned-amu"
           :gate "os/aiueos/scripts/k16-pure-native-gate.cljk"
           :provenance "os/aiueos/kotoba/provenance.edn"
           :artifacts {:kernel "aiueos-k16-pure-native-kernel.elf"
                       :link-list "aiueos-k16-pure-native-link-list.txt"
                       :receipt "aiueos-k16-pure-native-receipt.edn"
                       :boot-receipt "aiueos-k16-pure-native-boot-receipt.edn"
                       :loader "k16-pure-native/boot/esp/EFI/BOOT/BOOTX64.EFI"}}

 ;; --- what "pure Kotoba/Amu native" means -------------------------------
 :definition
 "Executable code is deterministically generated from Kotoba source or by the
  Kotoba/Amu toolchain, and no runtime work is delegated to external C/C++ or
  hand-written-ASM implementations. Toolchain-GENERATED fixed stubs (interrupt
  entry sequences, context switch) are allowed if Amu emits them reproducibly.
  Linking a hand-written .S- or .c-derived object is NOT allowed."

 :acceptance
 [{:id :pci-mmio-dma-from-amu
   :condition "PCI configuration, MMIO and DMA are emitted directly by Amu."
   :status :partially-met
   :evidence "native/rtl8125.kotoba now owns the observed K16 BDF probes,
              UC/NX BAR mapping, four owned DMA pages, one TX/RX ring, ARP and
              the bounded static-IP TCP SYN/SYN-ACK/RST path. QEMU proves the
              bounded no-device path; physical K16 ARP/UDP passed with status
              5A, while TCP and persistent link recovery remain unverified.
              kernel/rtl8125.c is retained only as the reference path."}
  {:id :f32-simd-from-amu
   :condition "f32 / SIMD / AVX2 kernels (fused dequant+dot) are emitted by
               Amu, not a C matvec called from Kotoba."
   :status :partially-met
   :evidence "Pinned Amu 3559d82 and kotoba-native ce85a36 admit and emit
              scalar f32 on x86-64 and AArch64. Public f32 ABI, aggregate f32,
              SIMD/AVX2 fused dequant+dot and the complete Qwen graph remain
              closed; the physically measured runtime is still C."}
  {:id :boot-network-tls-are-kotoba
   :condition "Boot, network and TLS/HTTPS are Kotoba/Amu artifacts."
   :status :partially-met
   :evidence "The compiler-emitted PE32+ loader plus native/kernel.kotoba boot
              under QEMU with no C, CRT, linker, imports or foreign objects.
              native/rtl8125.kotoba is linked into that image and owns the
              one-shot PCI/MMIO/DMA/ARP path; the next candidate also owns TCP
              through SYN-ACK admission. tls13.c and tls_aes_gcm.c still own
              the complete physical HTTPS runtime."}
  {:id :foreign-code-negative-gate
   :condition "The pure-native build FAILS if any C/ASM-derived object or
               unknown ELF enters the final link."
   :status :met
   :evidence "os/aiueos/scripts/k16-pure-native-gate.cljk, wired into
              build-uefi.sh under AIUEOS_K16_PURE_NATIVE=1 before zig ld.lld;
              shown in both directions by
              test/aiueos/k16_pure_native_gate_test.cljk."}]

 ;; --- the receipt each object must carry ---------------------------------
 ;;
 ;; Two shapes, because a toolchain stub has no Kotoba source and must not be
 ;; made to pretend it has one.
 :receipt-schema
 {:kotoba-object {:source "<path>.kotoba"
                  :source-sha256 "<64 hex>"
                  :object-sha256 "<64 hex>"
                  :target "x86_64-aiueos-kernel-v1"
                  :compiler {:repo "kotoba-lang/amu"
                             :sha "<40 hex>"
                             :recipe "<path or :unrecorded>"}}
  :toolchain-stub {:producer :amu-toolchain-stub
                   :stub "<keyword, e.g. :interrupt-entry>"
                   :object-sha256 "<64 hex>"
                   :target "x86_64-aiueos-kernel-v1"
                   :compiler {:repo "kotoba-lang/amu" :sha "<40 hex>"}}}

 ;; --- what the gate checks, per class ------------------------------------
 :checks
 {:kotoba-object
  [:exact-section-set          ; {"" .text .data .rela.text .symtab .strtab .shstrtab}
   :text-executable-progbits
   :data-non-executable-progbits
   :symtab-links-strtab
   :zero-undefined-symbols
   :exactly-one-global-func-export
   :export-name-prefix-kotoba-aiueos
   :exactly-one-rela-text-entry
   :reloc-r-x86-64-pc32-addend-minus-4
   :reloc-target-defined-in-data
   :reloc-offset-within-text
   :object-sha256-matches-receipt
   :source-present-and-sha256-matches-receipt
   :compiler-revision-recorded]
  :toolchain-stub
  [:section-set-subset-of-allowed
   :required-sections-present
   :zero-undefined-symbols
   :object-sha256-matches-receipt
   :stub-kind-declared
   :compiler-revision-recorded]}

 ;; --- exit codes ---------------------------------------------------------
 ;;
 ;; 2 and 3 are separate on purpose: root ADR-2608136000's first two questions.
 ;; `scanned=0` is exit 2 and is never a pass.
 :exit-codes {0 :admitted
              2 :could-not-answer
              3 :refused}

 :reason-literals
 {:foreign #{"archive" "not-elf" "elf-type" "machine" "elf-header" "sections"
             "export" "undefined-symbol" "relocation" "receipt-missing"
             "receipt-shape" "c-source" "target" "object-sha256-mismatch"
             "source-missing" "source-sha256-mismatch"}
  ;; NOT a claim of foreign code: the object conforms to the ABI in every
  ;; structural respect and its digests match; what is absent is a record of
  ;; which Amu revision produced it. Refused under its own message
  ;; ("REFUSED unattested-provenance:") so the C/ASM number stays readable.
  :unattested #{"compiler-unrecorded"}}

