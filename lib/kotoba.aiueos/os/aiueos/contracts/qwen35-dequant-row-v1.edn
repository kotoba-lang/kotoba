;; The declaration kotoba-native's `kernel-object-entries` transcribes -- in
;; BOTH `elf64.clj` and `elf64.cljc`, because the JVM loads `.clj` first and
;; kotoba-native ADR-0036 keeps the two a twin.
{:format :aiueos.qwen35-dequant-row/v1
 :graph {:root aiueos.qwen35-dequant-row
         :modules [aiueos.qwen35-dequant-row aiueos.lib.qwen35-dequant-core
                   aiueos.lib.qwen35-grids]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_dequant_row"
          :imports []
          :required-operations [kernel-load-u8 kernel-load-u8-4k kernel-load-u32
                                kernel-store-u32 kernel-subregion bytes-literal
                                f32-add f32-sub f32-mul
                                f32-from-bits f32-to-bits i64-to-f32-rounded]}
 :arguments [:qtype :src :src-length :dst :dst-length]

 ;; WHY THIS OBJECT EXISTS.
 ;; `aiueos_qwen35_dequantize_row` (`kernel/qwen35_quant.c:584`) is the first
 ;; arithmetic every matvec runs and the last place a wrong nibble is cheap to
 ;; find: a swapped scale index or a mis-signed byte does not crash, it shifts
 ;; one weight and the model degrades in a way no bound catches.

 ;; FIFTEEN TYPES (ADR-0221). Until then four -- F32, Q8_0, Q4_K, Q6_K, the
 ;; ones whose equations are pure arithmetic over the block's own bytes -- and
 ;; the codebook families that dominate the artifact (IQ3_XXS 120 tensors,
 ;; IQ3_S 106, IQ4_XS 45, IQ2_S 35, ...) stayed in the C because this dialect
 ;; had no rodata to hold a grid. `bytes-literal` holds them now, packed
 ;; (`aiueos.lib.qwen35-grids`), and the arithmetic of every type lives once in
 ;; `aiueos.lib.qwen35-dequant-core`, shared with `qwen35-matvec`.

 :result {:kind :reason-code :admit 0 :range [-6 -1] :truthy-is-success false}
 :reasons {0 :done
           -1 :null-source
           -2 :null-destination
           -3 :destination-length-not-a-positive-multiple-of-four
           -4 :element-count-above-65536
           -5 :source-length-is-not-the-row-byte-count
           -6 :type-not-one-of-the-seventeen-ggml-types}

 ;; BONSAI (ADR-0222 stage A, 2026-09-22). Two more types: PTQ1_0 (143,
 ;; Prism's group-128 ternary, 28-byte blocks) and BF16 (30). Their expected
 ;; bytes come from a C harness holding `dequantize_row_ptq1_0` VERBATIM from
 ;; PrismML-Eng/llama.cpp @9a9394a895b96003ca842a6041cb28ac49a108f7 (release
 ;; prism-b10709-9a9394a, the engine stream A matched 8/8 tokens against),
 ;; fp16 via IEEE `_Float16`, `cc -O2` on this workstation; BF16 is `bits <<
 ;; 16` and its expectation is written out directly (no arithmetic to get
 ;; wrong). Three PTQ1_0 rows are REAL blocks cut from the public artifact by
 ;; HTTP range (blk.0.attn_gate.weight blocks 0-1 at file offset 567,378,272;
 ;; output.weight block 0 at 11,120,992), one BF16 row is blk.0.ssm_alpha.weight
 ;; at 644,260,384; the rest are random bytes with finite normal fp16 scales,
 ;; one negative. There is NO C twin of these two in `kernel/qwen35_quant.c`,
 ;; so the QEMU `QWEN-PARITY` self-test cannot grade them; the oracle vectors
 ;; are the whole of their evidence until a Bonsai boot.
 ;;
 ;; WHERE THE EXPECTED BYTES COME FROM. The first five vectors: an independent
 ;; re-derivation of the C in ClojureScript over `Float32Array` (ADR-0147).
 ;; The rows added by ADR-0221 (every type, one and two blocks each, plus a
 ;; second Q4_K / Q6_K / Q8_0 row): random block bytes with FINITE NORMAL
 ;; fp16 scales -- a NaN would be canonicalised by the oracle host and could
 ;; not be compared -- run through the compiled C's own
 ;; `aiueos_qwen35_dequantize_row` (`cc -O2`, aiueos 3675014), the bytes it
 ;; wrote recorded bit for bit. Both prove the ALGORITHM; ADR-0147's QEMU
 ;; self-test `QWEN-PARITY dequant` is where the emitted object meets the C
 ;; on the CPU.

