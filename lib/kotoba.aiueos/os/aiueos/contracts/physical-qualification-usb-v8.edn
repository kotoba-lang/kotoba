;; v8 follows the physical K16's v7 code=224 observation. The native kernel
;; reached its own GDT/IDT and disabled the legacy PIC, then stopped inside the
;; replacement paging handoff. Preserve firmware-enabled x86 paging shape and
;; persist sub-stages on both sides of CR3 so another opaque 224 is impossible.
{:format :aiueos.physical-qualification-usb/v8
 :extends "physical-qualification-usb-v7.edn"
 :machine-profile :gmktec-k16-ryzen-7-7735hs
 :observed-input {:image-version 7
                  :physical-result-code 224
                  :meaning :inside-owned-paging
                  :proved-through [:kernel-entry :early-selftests :gdt-idt
                                   :legacy-pic-disable]
                  :internal-ssd-writes :none}
 :paging-handoff
 {:preconditions {:nx :required
                  :la57 :inherit-active
                  :sme-c-bit :inherit-active-from-firmware-cr3}
  :memory {:page-table-pages :encrypted-when-inherited
           :ram-leaves :encrypted-when-inherited
           :mmio-leaves :unencrypted}
  :progress-codes
  {240 :paging-entered
   241 :nx-admitted
   242 :tables-built
   243 :nxe-written
   244 :write-protect-enabled
   260 :before-cr3-4level-plaintext
   261 :before-cr3-5level-plaintext
   262 :before-cr3-4level-sme
   263 :before-cr3-5level-sme
   270 :after-cr3-4level-plaintext
   271 :after-cr3-5level-plaintext
   272 :after-cr3-4level-sme
   273 :after-cr3-5level-sme
   280 :validated-4level-plaintext
   281 :validated-5level-plaintext
   282 :validated-4level-sme
   283 :validated-5level-sme}}
 :safety {:internal-disk-write-code-reached? false
          :usb-write-scope :same-usb-result-partition-guid
          :uefi-variable-bytes 16
          :ssd-install :separate-later-operation}}
