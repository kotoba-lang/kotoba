;; v10 follows the physical K16's v9 code=260 observation.  Because v9 called
;; the progress recorder immediately after loading the transition CR3, that
;; result could not distinguish a CR3/first-fetch fault from a later C call or
;; UEFI SetVariable hand-back failure.  v10 observes each candidate CR3 inline,
;; restores the firmware root, and only then persists the next stage.
{:format :aiueos.physical-qualification-usb/v10
 :extends "physical-qualification-usb-v9.edn"
 :machine-profile :gmktec-k16-ryzen-7-7735hs
 :observed-input {:image-version 9
                  :physical-result-code 260
                  :meaning :last-durable-marker-before-transition-cr3
                  :paging-shape :four-level
                  :sme-c-bit :not-active-in-firmware-cr3
                  :firmware-cet :not-active
                  :unresolved-boundary [:cr3-load :first-candidate-root-fetch
                                        :post-switch-c-call
                                        :uefi-progress-hand-back]
                  :internal-ssd-writes :none}
 :paging-handoff
 {:firmware-state {:la57 :inherit-active
                   :sme-c-bit :inherit-active-from-firmware-cr3
                   :cet :clear
                   :pge :clear-and-flush-global-translations
                   :pcide :clear-after-zero-pcid-reload}
  :feature-code-bits {:la57 1 :sme 2 :firmware-cet 4
                      :firmware-pge 8 :firmware-pcide 16}
  :candidate-root-observation
  {:sequence [:load-candidate-cr3 :read-back-cr3 :restore-firmware-cr3]
   :no-c-call-under-candidate-root true
   :durable-marker-written-under :restored-firmware-root}
  :progress-code-formulas
  {:before-cr4-normalization "320 + feature-bits"
   :after-cr4-normalization "352 + feature-bits"
   :after-transition-root-roundtrip "384 + feature-bits"
   :after-final-root-roundtrip "416 + feature-bits"
   :after-final-root-c-call "448 + feature-bits"
   :final-wx-validated "480 + feature-bits"}
  :progress-code-ranges [[320 351] [352 383] [384 415]
                         [416 447] [448 479] [480 511]]}
 :safety {:internal-disk-write-code-reached? false
          :usb-write-scope :same-usb-result-partition-guid
          :uefi-variable-bytes 16
          :ssd-install :separate-later-operation}}
