;; The declaration kotoba-native's `kernel-object-entries` transcribes.
{:format :aiueos.qwen35-tensor-table-bind/v1
 :graph {:root aiueos.qwen35-tensor-table-bind
         :modules [aiueos.qwen35-tensor-table-bind]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_tensor_table_bind"
          :imports []
          :required-operations [kernel-load-u8 kernel-load-u32 kernel-store-u32 kernel-subregion]}
 :arguments [:table :limit :metadata-end :plan :plan-length]

 ;; ADR-0222 stage A: the Bonsai profile of the tensor-table admission. The
 ;; profile is `metadata-end`, which the caller already passes and the kv-scan
 ;; object derived -- 10,945,379 Qwen3.8 (866 records), 11,070,652 Bonsai
 ;; (851) -- so no argument was added and no workspace slot was spent: the
 ;; entry echoes it into slot 28144 before the walk and every table reads it
 ;; back. The two artifacts share every ROLE SHAPE (checked: all 23 Bonsai
 ;; roles have the dimensions Qwen3.8's have); what differs is the record
 ;; count, the artifact length, the data offset, the ggml types (PTQ1_0 143
 ;; counts in slot 31, which no Qwen type uses; BF16 30), the model-level
 ;; types (token_embd / output are PTQ1_0 here, Q2_K / Q4_K there) and the
 ;; absent MTP layer 64.
 ;;
 ;; THE IMAGE IS THE SAME FILE the kv-scan contract uses -- the artifact's
 ;; first 11,120,992 bytes, through the tensor table -- and the object is
 ;; handed the table alone: base = image + 11,070,652, limit = 50,340.
 ;; `os/aiueos/tests/fixtures/large/` is ignored; `run-task.cljk
 ;; bonsai-admission-fixture` refetches it by range and the verifier refuses
 ;; when it is absent or its sha256 is not the pinned one.
 ;;
 ;; THE EXPECTED WORKSPACE (28,160 bytes: 851 binding slots of 32, the type
 ;; counters, the 65 role masks, the cursor) was computed independently in
 ;; python from the same header, not read back from a run of the object.

 :result {:kind :reason-code :admit 0 :range [-25 -1] :truthy-is-success false}
 :reasons {0 :admitted -1 :null-table -2 :null-workspace -3 :workspace-not-28160
           -4 :metadata-end-names-no-profile -5 :window-below-the-smallest-table
           -13 :type-has-no-block-layout
           -16 :offset-is-not-the-aligned-end-of-the-previous
           -18 :name-names-no-role -20 :dimensions-disagree-with-the-role
           -21 :model-level-tensor-has-the-wrong-type
           -22 :table-did-not-end-where-the-profile-says
           -24 :type-histogram-disagrees -25 :layer-role-set-disagrees}

 :verification {:node-stack-size 4000
                :fuel 250000000
                :memory {:base 4096
                         :image-file "os/aiueos/tests/fixtures/large/bonsai2-ptq1-header-11120992.bin"
                         :image-sha256 "c2745c0473a980a45c99fe1d2fe85cbbf86f7eca41132d25beb55f249fe703fa"
                         :image-bytes 11120992
                         :table-offset 11070652
                         :plan-offset 11120992
                         :plan-bytes 28160}
                :floors {:minimum-vectors 8
                         :minimum-memory-assertions 1
                         :every-reachable-reason-observed false}}
 :vectors
 [
  {:name :bonsai-tensor-table-admitted, :limit 50340, :metadata-end 11070652, :expected 0,
   :expect-plan-hex ""}
  ;; The Qwen3.8 profile's floor is 51,242 bytes of table and the Bonsai one's
  ;; is 50,330: the same window that fills a Bonsai table cannot hold a
  ;; Qwen3.8 one, and the profile is refused on the size before a record is
  ;; read. This is the mix-up vector; -18 below is a name that names no role.
  {:name :qwen-metadata-end-on-a-bonsai-sized-window, :limit 50340, :metadata-end 10945379, :expected -5}
  {:name :first-tensor-name-names-no-role, :limit 50340, :metadata-end 11070652, :patch [[11070660 "78"]], :expected -18}
  {:name :metadata-end-names-no-profile, :limit 50340, :metadata-end 11070653, :expected -4}
  {:name :output-weight-retyped-to-bf16, :limit 50340, :metadata-end 11070652, :patch [[11070693 "1e000000"]], :expected -21}
  {:name :first-tensor-offset-moved-by-32, :limit 50340, :metadata-end 11070652, :patch [[11070697 "2000000000000000"]], :expected -16}
  {:name :ffn-down-first-dimension-is-17409, :limit 50340, :metadata-end 11070652, :patch [[11071022 "0144000000000000"]], :expected -20}
  {:name :a-ggml-type-with-no-block-layout, :limit 50340, :metadata-end 11070652, :patch [[11071038 "20000000"]], :expected -13}
  {:name :window-below-the-smallest-table, :limit 50000, :metadata-end 11070652, :expected -5}
  {:name :null-table, :limit 50340, :metadata-end 11070652, :table-base-override 0, :expected -1}
  {:name :null-workspace, :limit 50340, :metadata-end 11070652, :plan-base-override 0, :expected -2}
  {:name :workspace-not-28160, :limit 50340, :metadata-end 11070652, :plan-len-override 28156, :expected -3}
 ]}
