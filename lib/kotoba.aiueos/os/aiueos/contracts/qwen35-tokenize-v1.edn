;; The declaration kotoba-native's `kernel-object-entries` transcribes -- in
;; BOTH `elf64.clj` and `elf64.cljc` -- so that the export symbol is stated by
;; the repository that owns the decision.
{:format :aiueos.qwen35-tokenize/v1
 :graph {:root aiueos.qwen35-tokenize
         :modules [aiueos.qwen35-tokenize]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_tokenize"
          :imports []
          :required-operations [kernel-load-u8 kernel-load-u32
                                kernel-store-u8 kernel-store-u32 kernel-subregion]}
 :arguments [:model-base :model-length :work-base :work-length]

 ;; THE PRELUDE. This object reads two tables `aiueos-qwen35-vocab-index-build`
 ;; writes, and a kernel object cannot call another (ADR-0030), so the runner
 ;; runs the builder against the same page before each vector. The alternative
 ;; was to transcribe the built tables into this file as hex, which is the
 ;; "a constant rather than a derivation" failure these contracts keep naming.
 ;; A vector opts out with `:prelude? false`, which is how -4 is reached.
 :prelude {:graph {:root aiueos.qwen35-vocab-index-build
                   :modules [aiueos.qwen35-vocab-index-build]}
           :entry aiueos-qwen35-vocab-index-build
           :expected 0}

 ;; WHY THIS OBJECT EXISTS.
 ;; `kernel/qwen35_infer.c` has NO tokenizer. Its input is a single BOS id
 ;; (`contracts/qwen38-qwen35-runtime-v1.edn` :execution :input-token), so the
 ;; K16 image can run a forward pass and cannot be given a prompt. This is that
 ;; missing half, and it is a Kotoba object rather than C because the decision
 ;; of which ids a prompt becomes is the whole of what the model is asked.

 :result {:kind :reason-code :admit 0 :range [-27 -1] :truthy-is-success false
          :count-goes-to-workspace-slot 64}
 :reasons {0 :tokenized
           -1 :null-model-base
           -2 :null-workspace-base
           -3 :workspace-below-the-header
           -4 :workspace-carries-no-index
           -5 :model-window-above-16-mib
           -6 :input-above-32768-bytes
           -7 :input-outside-the-workspace
           -8 :token-output-outside-the-workspace
           -9 :scratch-too-small-or-outside-the-workspace
           -10 :index-tables-outside-the-workspace
           -21 :codepoint-above-u+10ffff
           -24 :chunk-above-512-symbols
           -25 :symbol-not-a-vocabulary-token
           -26 :token-output-capacity-exhausted
           -27 :pre-tokenizer-did-not-advance}

 ;; -27 cannot happen: every one of the eight pre-tokenizer rules ends strictly
 ;; after the position it started at, and the eighth is "consume one codepoint"
 ;; with no condition. -10 cannot be reached THROUGH THIS RUNNER: the prelude
 ;; writes header slot 40 after `prepare` has built the image, so a vector
 ;; cannot leave a corrupted index-end there. It remains reachable from a caller
 ;; that corrupts the workspace between the two calls, which is what the clause
 ;; is for.
 :unreachable-by-construction [-10 -27]

 ;; THE PRE-TOKENIZER IS NOT A REGEX ENGINE, AND llama.cpp'S IS NOT EITHER.
 ;; `tokenizer.ggml.pre` = "qwen35" names the qwen2 pattern; llama.cpp's
 ;; `unicode_regex_split` matches that string against a table of presets and
 ;; dispatches it to `unicode_regex_split_custom_llama3`, a hand-written
 ;; splitter whose number rule is `\p{N}{1,3}`. So the REFERENCE consumes up to
 ;; three digits where the METADATA's regex says one, and "2026" is ["202" "6"]
 ;; rather than four tokens. This object follows the reference, because that is
 ;; what produced the ids the model was trained against.
 :pre-tokenizer
 {:family :qwen2
  :reference-implementation :unicode_regex_split_custom_llama3
  :rules [[1 "(?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])" contraction-end]
          [2 "[^\\r\\n\\p{L}\\p{N}]?\\p{L}+" letters-end]
          [3 "\\p{N}{1,3}" digits-run]
          [4 " ?[^\\s\\p{L}\\p{N}]+[\\r\\n]*" other-end]
          [5 "\\s*[\\r\\n]+" ws-end]
          [6 "\\s+(?!\\S)" ws-end]
          [7 "\\s+" ws-end]
          [8 :no-rule-matched-one-codepoint chunk-end]]
  :classes {:table-ranges 122 :declared-blocks 24 :lookup :balanced-binary-search
            :source "Java \\p{L} and \\p{N}, plus llama.cpp's explicit whitespace set"
            :outside-the-declared-blocks :other
            :consequence "letters and digits of undeclared scripts break a chunk
                          where llama.cpp would not"}}

 ;; Byte-level BPE, `unicode_byte_encoding_process` then the merge loop. The
 ;; word is rebuilt from its CODEPOINTS before the bytes are mapped, so an
 ;; invalid input byte contributes the three bytes of U+FFFD rather than
 ;; itself -- bytes are not bytes here, and this is where that is decided.
 :encoding {:alphabet :gpt2-byte-to-unicode
            :invalid-utf8 :replaced-with-u+fffd-then-encoded
            :symbol :one-per-byte-of-the-normalised-word}

 ;; llama.cpp orders a priority queue by (rank, left index) and skips the
 ;; entries a merge invalidated, which is the same sequence of merges as
 ;; "repeatedly take the live adjacent pair with the lowest rank, leftmost on a
 ;; tie". The queue's other effect is to make each step cheaper; the rank cache
 ;; in the symbol record buys that back without a heap.
 :merge-loop {:order [:rank :leftmost] :rank-cached-in-the-symbol-record true
              :quadratic-in :one-chunk :chunk-bound 512}

 ;; THREE REFUSALS llama.cpp DOES NOT MAKE.
 ;;   -21  it throws out of `unicode_cpt_to_utf8` and aborts the process
 ;;   -24  it has no chunk bound; a finite fuel bound needs one
 ;;   -25  it looks each BYTE of an unresolvable symbol up as a one-character
 ;;        string and SILENTLY DROPS the ones that are not tokens -- for a
 ;;        byte-level vocabulary those are the continuation bytes, so its
 ;;        fallback emits nothing and the text disappears
 :narrower-than-llama-cpp [-21 -24 -25]

 :symbol-scratch
 {:bytes 13312
  :records 512 :record-bytes 24
  :record {0 :offset-into-the-encoded-buffer 4 :length-0-means-merged-away
           8 :next-or-65535 12 :previous-or-65535
           16 :vocabulary-id-or-4294967295 20 :rank-or-2147483647}
  :encoded-buffer {:offset 12288 :bytes 1024}}

 :verification
 {:off-target :executed
  :mechanism :kir-execute-with-a-supplied-memory-image
  :runner "os/aiueos/scripts/verify-admissions.cljk"
  :host :nbb
  :node-stack-size 60000
  ;; The same mini vocabulary the index-build contract uses, and the same
  ;; reason: there is no GGUF on the machine that wrote this. The vectors that
  ;; matter for AGREEMENT WITH llama.cpp are in
  ;; test/aiueos/qwen35_tokenizer_parity_test.cljk, which trains a larger
  ;; fixture and compares against a transcription of `llm_tokenizer_bpe` and
  ;; against java.util.regex. These vectors are the reason codes and a handful
  ;; of ids whose derivation is short enough to state.
  :memory {:base 65536 :image-bytes 19584
           :work-offset 128 :work-bytes 19456
           :input-offset 512 :output-offset 1536 :output-capacity 64
           :scratch-offset 2048 :scratch-bytes 16384
           :ids-offset 18432 :text-offset 18688 :text-capacity 256}
  :fuel 400000000
  :floors {:minimum-vectors 15
           :minimum-memory-assertions 8
           :every-reachable-reason-observed true}}

 :fixture
 {:vocab-count 7 :merge-count 2 :tokens-at 24 :merges-at 93
  :model-hex "0000000000000000000000000000000000000000000000000100000000000000610100000000000000620100000000000000630200000000000000c4a0020000000000000061620300000000000000c4a0610300000000000000e3818203000000000000006120620400000000000000c4a02061"}

 :vectors
 ;; id 0 "a"  1 "b"  2 "c"  3 "G"(U+0120, byte 0x20)  4 "ab"  5 "Ga"  6 "あ"
 ;; rank 0 "a b"   rank 1 "G a"
 [{:name :two-letters-merge
   :input-hex "6162" :expected 0 :expect-ids [4] :expect-id-count 1
   :why "One chunk \"ab\", symbols a and b, the pair (0,1) has rank 0, and the
         merged \"ab\" is token 4."}
  {:name :three-letters-merge-once
   :input-hex "616263" :expected 0 :expect-ids [4 2] :expect-id-count 2
   :why "(b,c) has no rule, so the merge stops after one step."}
  {:name :a-leading-space-joins-the-word-and-the-lower-rank-wins
   :input-hex "206162" :expected 0 :expect-ids [3 4] :expect-id-count 2
   :why "Rule 2's optional prefix takes the space into the chunk. Both pairs
         have rules -- (G,a) rank 1 and (a,b) rank 0 -- so this vector fails if
         the loop takes the leftmost pair rather than the lowest-ranked one."}
  {:name :one-letter-does-not-merge
   :input-hex "61" :expected 0 :expect-ids [0] :expect-id-count 1}
  {:name :the-empty-input-produces-no-ids
   :input-hex "" :expected 0 :expect-id-count 0
   :why "Zero ids and reason zero. A caller that reads the return value as a
         count would see the same 0 for \"nothing to do\" and for \"refused\",
         which is why the count is in the workspace and not the return."}

  {:name :null-model-base :model-base 0 :expected -1}
  {:name :null-workspace-base :work-base 0 :expected -2}
  {:name :workspace-below-the-header :work-len 127 :expected -3}
  {:name :no-index-in-the-workspace :prelude? false :expected -4
   :why "The magic is written LAST by the index build, so a workspace whose
         build refused half way carries no magic and is refused here rather
         than read as a table."}
  {:name :model-window-above-sixteen-mebibytes :model-len 16777217 :expected -5}
  {:name :input-above-thirty-two-kibibytes :header {52 32769} :expected -6}
  {:name :the-input-leaves-the-workspace :header {48 19452 52 64} :expected -7}
  {:name :the-output-leaves-the-workspace :header {56 19452 60 64} :expected -8}
  {:name :scratch-below-thirteen-kibibytes :header {72 13311} :expected -9}
  {:name :scratch-leaves-the-workspace :header {68 19452} :expected -9}
  {:name :a-codepoint-above-the-unicode-range
   :input-hex "f7bfbfbf" :expected -21
   :why "F7 BF BF BF decodes to U+1FFFFF. llama.cpp's decoder admits it -- it
         checks continuation bytes and nothing else -- and then
         `unicode_cpt_to_utf8` throws out of a function nobody catches."}
  {:name :a-chunk-above-five-hundred-and-twelve-symbols
   :input-fill {:byte 97 :count 513} :expected -24
   :why "513 letters with no space, digit or punctuation is one chunk. 512 is
         admitted; the parity test shows both sides of that boundary."}
  {:name :a-symbol-the-vocabulary-lacks
   :input-hex "7a" :expected -25
   :why "\"z\" is not one of the seven. llama.cpp would emit nothing for it."}
  {:name :the-output-capacity-is-exhausted
   :input-hex "616263" :header {60 1} :expected -26
   :why "Two ids into one slot. The refusal is on the SECOND id, so the first
         has already been written -- the count in slot 64 is not updated, which
         is what keeps a partial write from reading as a short answer."}]}
