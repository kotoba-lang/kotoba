;; Companion to kotoba-native kernel-object-entries `aiueos-wm-hit`
;; (guest WM, ADR-0091).
{:format :aiueos.wm-hit/v1
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_wm_hit"
          :imports []}
 :arguments [:surface-count :front-id :px :py]

 ;; Window id of the hit surface, or 0 refuse (one-surface / miss).
 :result {:kind :value
          :window-id :i64
          :refuse 0}

 :vectors {:one-surface :refuse
           :overlap-front-2 :window-2
           :miss-front-at-40-40 :window-1
           :raised-front-1 :window-1
           :key-order-1 :leftover}

 :rects {:window-1 {:x 32 :y 32 :w 720 :h 540}
         :window-2 {:x 96 :y 72 :w 640 :h 480}
         :overlap-point {:x 100 :y 80}
         :win1-only {:x 40 :y 40}}

 :trusts-caller-for [:virtio-input-not-synthetic
                     :native-phase6-compositor
                     :one-guest-scanout]
 :verification {:off-target :impossible
                :reason :kir-refuses-kernel-memory
                :evidence "nbb --classpath src scripts/compositor-guest.cljk guest-wm"}
}
