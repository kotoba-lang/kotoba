;; A fixed, bounded language-model job executed by the physical K16.  This is
;; stronger than a relay echo because the expected output is computed from a
;; frozen transition matrix on the node.  It is not the production GPU/LLM
;; admission gate.
{:format :aiueos.micro-inference-qualification/v1
 :model {:id "aiueos-char-bigram-v1"
         :kind :character-bigram
         :vocabulary " space+a-z"
         :corpus-sha256 "6433aeadc179877f103fdc87672d967d5c68d3f531f8b2bf156e377ad84058cb"
         :prompt-max-bytes 64
         :tie-break :lowest-vocabulary-index}
 :known-answer {:prompt "murakum"
                :token "o"
                :score 2
                :row-total 5}
 :requires [:physical-k16 :same-boot-nonce :claimed-job-id
            :result-persisted-before-ready :fresh-liveness-renewal]
 :transport {:request "AIUEOS_JOB_V1"
             :result "AIUEOS_JOB_RESULT_V1"
             :commit "AIUEOS_JOB_COMMIT_V1"
             :liveness-ping "AIUEOS_NODE_PING_V1"
             :liveness-pong "AIUEOS_NODE_PONG_V1"
             :binds [:boot-nonce :job-id :liveness-sequence]
             :result-fields [:token :score :row-total :inference-cycles]
             ;; Measured 2026-09-08.  This said bus2 (10.77.0.1:7777 <->
             ;; 10.77.0.10:7779) from the day it was written, and bus2 has no
             ;; UDP receive path -- the board can only TRANSMIT there, so no
             ;; job could ever have arrived on the wire this contract named.
             ;; The relay rides LAN2/bus3, whose ring is installed once at
             ;; debug-init and polled every cycle, and where a job request and
             ;; its answer have now crossed four times.
             :relay-udp {:plane :lan2-bus3
                         :server "10.10.10.1:9000"
                         :node "10.10.10.2:9000"
                         :retired {:plane :bus2-netlog
                                   :server "10.77.0.1:7777"
                                   :node "10.77.0.10:7779"
                                   :reason :no-receive-path-on-that-plane}}
             ;; The node announces itself with the MAC of the NIC the
             ;; announcement LEAVES BY, which is bus3.  The relay accepted only
             ;; bus2's until 2026-09-08 and rejected the board's own first
             ;; hello as `unexpected-mac`.
             :node-mac ["70-70-fc-0b-b6-31" "70-70-fc-0b-b6-32"]}
 :murakumo {:enqueue [:post "/infer/queue"]
             :target-field :target-did
             :target-value :node-did
             :observe [:get "/infer/queue?did=<node-did>"]
             :worker-poll [:get "/infer/queue?did=<node-did>"]
             :claim [:post "/infer/queue/:id/claim"]
             :result [:post "/infer/queue/:id/result"]
             :ready-heartbeat [:post "/infer/nodes/gmktec-k16/heartbeat"]}
 :measurement {:native-compute :serialized-tsc-cycle-delta
               :transport-round-trip :mac-monotonic-nanoseconds
               :murakumo-ms :positive-ceiling-of-transport-round-trip
               :native-wall-time :unqualified-until-tsc-frequency-is-measured}
 :worker {:continuous? true
          :kind "aiueos-micro-infer"
          :model "aiueos-char-bigram-v1"
          :admission [:model-exact :bounded-lowercase-prompt
                      :nonempty-transition-row]
          :idle-proof :physical-ping-pong}
 :safety {:internal-disk-writes? false
          :service-token-in-efi? false
          :credential-files-mode "0600"
          :bounded-input? true}
 ;; What has actually crossed the wire, so a reader can tell the specified
 ;; from the demonstrated.  Four prompts chosen by the Mac, four answers the
 ;; board computed, each verified against MURAKUMO_MICRO_INFER_ROWS by the
 ;; relay's own regex; 173 datagrams carrying prompts the board must refuse
 ;; produced zero result lines.  Nothing has been enqueued at, claimed from or
 ;; posted to api.murakumo.cloud -- no credential is configured -- so the
 ;; murakumo half of :requires is UNPROVEN, not met.
 :measured {:date "2026-09-08"
            :image-sha256-prefix "6e6df6bd"
            :answers [{:prompt "murakum" :token "o" :score 2 :row-total 5 :tsc-cycles 1152}
                      {:prompt "aiueos"  :token " " :score 5 :row-total 7 :tsc-cycles 1344}
                      {:prompt "kotoba"  :token "i" :score 2 :row-total 8 :tsc-cycles 800}
                      {:prompt "wave"    :token " " :score 2 :row-total 9 :tsc-cycles 864}]
            :refusals {:datagrams 173 :results 0
                       :prompts ["z" "aQ"]
                       :netlog "D9 73 empty-transition-row, D9 72 outside-vocabulary"}
            :cross-check "bus2 netlog counted D8 00 on 21 boots and D9 70 four times"
            ;; Met later the same day, unattended and with no shared secret:
            ;; the node authenticates every route with a CACAO signed by its
            ;; own did:key.  7 of 7 jobs completed once the dispatcher's
            ;; cadence was derived from the board's measured reachability
            ;; (ADR-0203); the 47 before that failed against a machine that had
            ;; already reset.
            :murakumo {:node-name "gmktec-k16-lan2"
                       :node-did "did:key:z6MkpqcztvoBjMyMD7xdBKhJ96ae2o2TjCttmZfgiSJhXb7g"
                       :credential :cacao-self-signed
                       :trust-tier :community
                       :jobs-completed 7
                       :jobs-failed-before-cadence-fix 47
                       :example-job "1788842600269348"
                       :relay-round-trip-ms 15197}
            :unproven []
            ;; Not met, and not a credential problem: `awai-secure` is admitted
            ;; only through the operator boundary and describes AWAI's own
            ;; hardware, which this board is not.
            :not-claimed [:awai-secure-tier :accepted-admission]}
 :scope :native-micro-inference-qualification
 :does-not-prove [:production-llm :gguf-runtime :gpu-inference
                  :production-throughput :ssd-installation
                  :device-owned-https :device-owned-cacao
                  :network-direct-to-murakumo]}
