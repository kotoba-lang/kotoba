;; K16 physical qualification with a bounded result return path.  Persistent
;; writes are limited to two files on the removable qualification USB and two
;; one-shot UEFI variables.  The native core still stops before every block,
;; network, DMA, NVMe, or internal-SSD driver.
{:format :aiueos.physical-qualification-usb/v2
 :machine-profile :gmktec-k16-ryzen-7-7735hs
 :architecture :x86_64
 :boot-cycle
 [{:stage :uefi-hardware-probe-and-arm-return
   :observes [:cpu-vendor-family-model
              :gop-visible-stripe
              :uefi-memory-map
              :acpi-rsdp
              :pci-inventory
              :pci-display-network-storage-nvme-class-counts
              :uefi-block-handle-counts]
   :writes [{:target :qualification-usb/EFI-AIUEOS-PROBE.LOG
             :scope :same-loaded-image-filesystem}
            {:target :uefi/BootNext
             :scope :current-boot-option :lifetime :one-boot}
            {:target :uefi/AIUEOSQualificationResult
             :value :pending :maximum-bytes 16}]
   :internal-disk-writes :none
   :terminal-marker
   "AIUEOS_HW_PROBE_RETURN_ARMED bootnext=current result=pending"}
  {:stage :native-core
   :enters [:aiueos-loader :aiueos-kernel]
   :proves [:loader-kernel-initramfs-integrity
            :kotoba-native-object-execution
            :kernel-owned-paging
            :gop-framebuffer-write-readback
            :physical-page-allocation
            :acpi-madt-admission]
   :stops-before [:iommu :pci-dma :block-driver :network-driver :ssd-install]
   :writes [{:target :uefi/AIUEOSQualificationResult
             :value [:success :failure]
             :maximum-bytes 16}]
   :internal-disk-writes :none
   :success-screen ["AIUEOS K16" "NATIVE CORE OK" "SSD READ ONLY"]
   :terminal-marker
   "AIUEOS_PHYSICAL_QUALIFICATION_OK native-core-v2 internal-disk-writes=none"}
  {:stage :uefi-result-collector
   :trigger :one-shot-BootNext-after-native-reset
   :reads :uefi/AIUEOSQualificationResult
   :writes [{:target :qualification-usb/EFI-AIUEOS-RESULT.LOG
             :scope :same-loaded-image-filesystem}]
   :clears [:uefi/AIUEOSQualificationResult]
   :internal-disk-writes :none
   :terminal-marker
   "AIUEOS_PHYSICAL_QUALIFICATION_RESULT_SAVED"}]
 :result-states
 {:success {:state 1 :code 0}
  :failure {:state 2 :codes {1 :physical-memory
                             2 :capability-table
                             3 :acpi-madt}}
  :incomplete {:state 0 :meaning :native-core-did-not-reach-terminal-marker}}
 :safety {:internal-disk-write-code-reached? false
          :internal-disk-target-selection :none
          :usb-write-scope :same-loaded-image-filesystem
          :uefi-variable-bytes 16
          :ssd-install :separate-later-operation
          :secure-boot :must-be-disabled-for-unsigned-development-image}
 :mac-retrieval
 {:files ["EFI/AIUEOS/PROBE.LOG" "EFI/AIUEOS/RESULT.LOG"]
  :success-requires ["state=success"
                     "internal_ssd_writes=none"
                     "qualification_variable_cleared=yes"
                     "AIUEOS_PHYSICAL_QUALIFICATION_RESULT_SAVED state=success"]}
 :does-not-qualify [:amd-iommu
                    :nvme-read
                    :nvme-write
                    :rtl8125-link
                    :wired-dhcp
                    :radeon-native-gpu-driver
                    :murakumo-inference
                    :ssd-boot]
 :ssd-install-gate
 {:requires [:result-log-success
             :probe-log-reviewed
             :k16-driver-gap-review
             :exact-internal-ssd-identity
             :fresh-owner-confirmation]
  :current-state :closed}}
