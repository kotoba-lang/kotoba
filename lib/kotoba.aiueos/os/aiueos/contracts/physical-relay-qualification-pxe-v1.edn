;; A request-bound UDP round trip from native AIUEOS to the Mac relay.
;; This is deliberately a diagnostic gate. It proves the physical node can
;; originate and admit an IPv4/UDP response after RTL8125 takeover; it does not
;; authenticate the node to murakumo.cloud or claim inference capacity.
{:format :aiueos.physical-relay-qualification-pxe/v1
 :depends-on :aiueos.physical-network-qualification-pxe/v1
 :target {:model :gmktec-k16
          :node-ip "10.77.0.10"
          :relay {:ip "10.77.0.1" :udp-port 7777}}
 :request {:prefix "AIUEOS_NODE_HELLO_V1"
           :binds [:boot-nonce :device-mac :profile]
           :profile :rtl8125-relay-test}
 :response {:prefix "AIUEOS_NODE_ACK_V1"
            :requires [:same-boot-nonce
                       :accepted-state
                       :ethernet-peer-match
                       :ipv4-address-and-checksum
                       :udp-ports-length-and-checksum]
            :uefi-nvram {:state 1 :code 8130}}
 :failure {:uefi-nvram {:state 2 :code-base 8300}
           :bounded? true}
 :safety {:internal-disk-writes? false
          :usb-runtime-writes? false
          :boot-order-writes? false
          :dma-isolation :amd-ivrs-unimplemented-test-only}
 :evidence {:server-selftest "os/aiueos/tools/k16-pxe-server.py --selftest"
            :physical-state :unverified}
 :scope :diagnostic-only
 :does-not-prove [:persistent-device-identity
                  :authenticated-murakumo-heartbeat
                  :capacity-advertisement
                  :job-claim
                  :inference
                  :result-return]}
