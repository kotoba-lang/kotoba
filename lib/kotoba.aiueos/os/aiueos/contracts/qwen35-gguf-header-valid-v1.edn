;; The declaration kotoba-native's `kernel-object-entries` transcribes.
{:format :aiueos.qwen35-gguf-header-valid/v1
 :graph {:root aiueos.qwen35-gguf-header-valid
         :modules [aiueos.qwen35-gguf-header-valid]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_qwen35_gguf_header_valid"
          :imports []
          :required-operations [kernel-load-u32 kernel-subregion]}
 :arguments [:base :accessible :artifact]

 ;; ADR-0222 stage A item 3: the header object admits TWO artifacts, named by
 ;; their byte length, and the counts follow from the name. The 24-byte images
 ;; here are the real Bonsai header (`GGUF`, v3, 851, 49 -- cut from the public
 ;; file 2026-09-22) and the same 24 bytes with Qwen3.8's counts written in.
 ;; The Qwen3.8 profile's own vectors are the JVM parity test
 ;; (test/aiueos/qwen35_gguf_header_parity_test.cljk); this contract adds the
 ;; Bonsai profile and the four ways the two must not mix.

 :result {:kind :reason-code :admit 0 :range [-8 -1] :truthy-is-success false}
 :reasons {0 :admitted -1 :null-base -2 :window-below-24 -3 :artifact-length-is-neither
           -4 :window-larger-than-artifact -5 :magic -6 :version
           -7 :tensor-count-not-the-profile-s -8 :pair-count-not-the-profile-s}

 :verification {:node-stack-size 4000
                :fuel 100000
                :memory {:base 4096 :image-bytes 64}
                :floors {:minimum-vectors 8
                         :minimum-memory-assertions 0
                         :every-reachable-reason-observed false}}
 :vectors
 [
  {:name :bonsai-header-with-bonsai-length, :header-hex "474755460300000053030000000000003100000000000000", :accessible 24, :artifact 5946648928, :expected 0}
  {:name :qwen-counts-with-qwen-length, :header-hex "474755460300000062030000000000003200000000000000", :accessible 24, :artifact 10934860704, :expected 0}
  {:name :bonsai-header-with-qwen-length, :header-hex "474755460300000053030000000000003100000000000000", :accessible 24, :artifact 10934860704, :expected -7}
  {:name :qwen-counts-with-bonsai-length, :header-hex "474755460300000062030000000000003200000000000000", :accessible 24, :artifact 5946648928, :expected -7}
  {:name :bonsai-tensors-with-qwen-pairs, :header-hex "474755460300000053030000000000003200000000000000", :accessible 24, :artifact 5946648928, :expected -8}
  {:name :neither-length, :header-hex "474755460300000053030000000000003100000000000000", :accessible 24, :artifact 5946648929, :expected -3}
  {:name :window-below-header, :header-hex "474755460300000053030000000000003100000000000000", :accessible 23, :artifact 5946648928, :expected -2}
  {:name :window-past-artifact, :header-hex "474755460300000053030000000000003100000000000000", :accessible 5946648929, :artifact 5946648928, :expected -4}
  {:name :bad-magic, :header-hex "474755470300000053030000000000003100000000000000", :accessible 24, :artifact 5946648928, :expected -5}
  {:name :version-2, :header-hex "474755460200000053030000000000003100000000000000", :accessible 24, :artifact 5946648928, :expected -6}
  {:name :null-base, :header-hex "474755460300000053030000000000003100000000000000", :accessible 24, :artifact 5946648928, :base-override 0, :expected -1}
 ]}
