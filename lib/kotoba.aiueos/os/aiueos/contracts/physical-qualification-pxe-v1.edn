;; Diskless physical K16 native-core qualification transport.
;; The single PE/COFF image embeds the admitted kernel and initramfs.  It is
;; served once, returns to the ordinary control EFI through BootNext, and the
;; control EFI reports the bounded UEFI NVRAM result over the direct link.
{:format :aiueos.physical-qualification-pxe/v1
 :target {:model :gmktec-k16
          :cpu {:vendor :amd :family 25 :model 4}
          :memory-bytes-observed 35185754112
          :gpu {:vendor 0x1002 :device 0x1681}
          :ethernet [{:vendor 0x10ec :device 0x8125 :bdf "02:00.0"}
                     {:vendor 0x10ec :device 0x8125 :bdf "03:00.0"}]
          :nvme {:vendor 0x126f :device 0x2263 :bdf "01:00.0"}}
 :boot {:transport :uefi-pxe
        :artifact :single-pe-coff
        :embedded [:kernel-elf :initramfs]
        :admission :compiled-sha256
        :next-boot :current-pxe-one-shot
        :boot-order-write? false}
 :result {:transport :uefi-nvram
          :bytes 16
          :receiver :pxe-control-efi
          :telemetry :uefi-pxe-base-code-udp
          :retained-until-explicit-collector? true}
 :rtl8125-handoff
 {:device-id 0x10ec8125
  :phase :uefi-pxe-before-exit-boot-services
  :observes [:pci-command :bar :mac :chip-command :tx-config :rx-config
             :phy-status]
  :device-writes? false
  :physical-state :unverified}
 :mac-server {:next-artifact :one-shot
              :fallback :control-efi
              :consume-after :complete-transfer}
 :qemu-evidence
 {:command "os/aiueos/scripts/smoke-qemu-physical-pxe.sh"
  :proves [:deterministic-single-efi
           :embedded-payload-admission
           :native-core-success
           :uefi-nvram-result-recovery
           :control-efi-fallback]
  :does-not-prove [:physical-k16-boot :physical-k16-network]}
 :safety {:internal-disk-writes? false
          :usb-runtime-writes? false
          :ssd-install? false}
 :physical-state :in-progress
 :requires ["AIUEOS_NETBOOT_EMBEDDED_OK kernel+initramfs sha256-v1"
            "AIUEOS_QUALIFICATION_RESULT state=success code=0"
            "subsequent AIUEOS_CONTROL_READY with a new nonce"]}
