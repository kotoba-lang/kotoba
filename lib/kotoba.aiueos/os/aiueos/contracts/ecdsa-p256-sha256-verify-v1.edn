;; Companion to kotoba-native kernel-object-entries
;; `aiueos-ecdsa-p256-sha256-verify` (TLS 1.3 CertificateVerify, ADR-0087).
{:format :aiueos.ecdsa-p256-sha256-verify/v1
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_ecdsa_p256_sha256_verify"
          :imports []}
 :arguments [:sig-64 :digest-32 :pubkey-64 :workspace :workspace-length]

 ;; 1 admits; 0 refuses. PKCS#1 RSA is the wrong scheme for TLS 1.3
 ;; CertificateVerify. Scheme other than ecdsa_secp256r1_sha256 (0x0403)
 ;; is refused in C before this object is called.
 :result {:kind :value
          :admit 1
          :refuse 0}

 :curve :secp256r1
 :hash :sha-256
 :encoding {:sig :r-s-be-32
            :pubkey :uncompressed-qx-qy-be-32}
 :workspace-bytes 2048

 :vectors {:rfc6979-a-2-5-sha256-sample :admit
           :same-with-s-plus-1 :refuse}

 :trusts-caller-for [:certificate-chain-to-anchor]
 :verification {:off-target :impossible
                :reason :kir-refuses-kernel-memory
                :evidence "clojure -M:bare-metal cert-verify"}
}
