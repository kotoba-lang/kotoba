;; The PT_LOAD admission contract, run against the KIR interpreter.
;;
;; `os/aiueos/scripts/smoke-qemu-uefi-loader.cljk` already executes this object
;; as x86-64 machine code under OVMF, and that is the stronger evidence -- but
;; it is also the SLOWER and the NARROWER. A boot costs a minute and asserts six
;; verdicts; this asserts every clause the module can produce, needs no QEMU,
;; and runs in CI beside the other admission objects. The two answer different
;; questions: the smoke says the rules survive being compiled, this says the
;; rules are the rules.
;;
;; ADR-0180.
{:format :aiueos.uefi-elf-admit/v1
 :graph {:root aiueos.uefi.elf :modules [aiueos.uefi.elf]}

 ;; NOT a kernel object. `aiueos.uefi.elf` is a MODULE of the BOOTX64.EFI
 ;; image, linked by amu's project route, so it has no `kotoba_aiueos_*` export
 ;; and appears in no `elf64.cljc` allowlist. `entry` is the function name.
 :native {:target :x86_64-aiueos-uefi-v1
          :entry admit
          :module-of "os/aiueos/uefi/loader-probe.kotoba"
          :required-operations [kernel-load-u8-4k kernel-load-u16-4k
                                kernel-load-u32-4k kernel-load-u64-4k]}
 :arguments [:base :win :image-len]

 ;; WHOSE RULES THESE ARE. amu's `package-embedded-kernel`
 ;; (`src/kotoba/compiler/packaging/pe32plus.cljc:344-351`), not
 ;; `os/aiueos/uefi/main.c:1100-1121`. Where the two disagreed the C was
 ;; looser, and a loader that admitted more than the packager emits would be
 ;; admitting files nothing in this repository produced.
 :rules {:phnum 2 :phentsize 56 :type :ET_EXEC :machine :EM_X86_64
         :flags [5 6] :filesz=memsz true
         :paddr-floor 1048576 :memsz-ceiling 1048576 :paddr+memsz-ceiling 1073741824
         :paddr-alignment 4096 :entry-in :segment-0 :overlap :refused}

 ;; STRICTER THAN BOTH, on purpose. `main.c` casts `kernel_file + elf->phoff`
 ;; to a struct pointer and reads it at whatever alignment; a bounded Kotoba
 ;; load checks alignment LAST and TRAPS, so an unaligned `e_phoff` would kill
 ;; the loader instead of refusing the file. Clauses 8 and 9 prove both bounds
 ;; BEFORE the first program-header byte is read, which turns a trap into a
 ;; verdict. Vector `:unaligned-phoff` is the one that would trap without them.
 :stricter-than-the-c [:phoff-alignment :phoff-extent]

 ;; NOT A BOOLEAN. ZERO IS THE SUCCESS VALUE.
 :result {:kind :reason-code :admit 0 :truthy-is-success false}
 :reasons {0 :admitted
           1 :image-shorter-than-the-elf-header
           2 :magic-not-7f454c46
           3 :not-elfclass64
           4 :not-et-exec
           5 :not-em-x86-64
           6 :phentsize-not-56
           7 :phnum-not-2
           8 :phoff-not-8-aligned
           9 :program-header-table-outside-the-window-or-the-image
           21 :segment-0-not-pt-load    22 :segment-0-filesz-zero
           23 :segment-0-filesz-ne-memsz 24 :segment-0-paddr-below-1mib
           25 :segment-0-memsz-above-1mib 26 :segment-0-paddr-plus-memsz-above-1gib
           27 :segment-0-paddr-unaligned  28 :segment-0-offset-plus-filesz-past-image
           31 :segment-1-not-pt-load    32 :segment-1-filesz-zero
           33 :segment-1-filesz-ne-memsz 34 :segment-1-paddr-below-1mib
           35 :segment-1-memsz-above-1mib 36 :segment-1-paddr-plus-memsz-above-1gib
           37 :segment-1-paddr-unaligned  38 :segment-1-offset-plus-filesz-past-image
           40 :segment-0-flags-not-5
           41 :segment-1-flags-not-6
           42 :entry-not-inside-segment-0
           43 :segments-overlap}

 ;; THE FIXTURE IS A REAL KERNEL. These 176 bytes are the ELF header and both
 ;; program headers of a kernel amu itself produced:
 ;;   amu compile testkernel.kotoba --target x86_64-aiueos-kernel-v1 \
 ;;       --artifact image --fuel 32768 --output TESTKERN.ELF
 ;;   110,872 bytes,
 ;;   sha256 e4a5c9dc3ca03e310d9b8a0924e9e2ce510fb9678335bd2fe6496b7e9c182f1e
 ;; A header invented to pass would only prove the rules agree with themselves.
 :fixture {:kernel-bytes 110872
           :kernel-sha256 "e4a5c9dc3ca03e310d9b8a0924e9e2ce510fb9678335bd2fe6496b7e9c182f1e"
           :e-entry 1052672 :e-phoff 64 :e-phentsize 56 :e-phnum 2
           :segment-0 {:flags 5 :offset 4096  :paddr 1052672 :filesz 160   :memsz 160}
           :segment-1 {:flags 6 :offset 32768 :paddr 1081344 :filesz 77824 :memsz 77824}}
 :image-len 110872
 :header-hex
 ""

 ;; EVERY VECTOR IS THE SAME 176 BYTES WITH ONE FIELD CHANGED, and it names the
 ;; field rather than carrying its own 352-character blob. A contract of opaque
 ;; hex is 352 chances per vector to transcribe one wrong, and a reader cannot
 ;; tell which byte was supposed to be different.
 ;;
 ;; Offsets: e_ident 0, e_type 16, e_machine 18, e_entry 24, e_phoff 32,
 ;; e_phentsize 54, e_phnum 56; program header i at 64 + 56i, and within it
 ;; p_type +0, p_flags +4, p_offset +8, p_paddr +24, p_filesz +32, p_memsz +40.
 :vectors
 [{:name :the-kernel-amu-emitted :patch [] :expected 0
   :why "The positive direction. Without it every refusal below would also
         pass on a module that refused everything."}

  {:name :truncated-below-the-header :patch [] :image-len 63 :expected 1}
  {:name :magic-third-byte :patch [{:offset 2 :u8 0x4d}] :expected 2}
  {:name :elfclass32 :patch [{:offset 4 :u8 1}] :expected 3}
  {:name :et-dyn-not-et-exec :patch [{:offset 16 :u16 3}] :expected 4}
  {:name :em-aarch64 :patch [{:offset 18 :u16 183}] :expected 5}
  {:name :phentsize-64 :patch [{:offset 54 :u16 64}] :expected 6}
  {:name :three-program-headers :patch [{:offset 56 :u16 3}] :expected 7}

  ;; The clause that exists so a misaligned table is a VERDICT and not a trap.
  ;; Without clause 8 this vector kills the loader instead of refusing.
  {:name :unaligned-phoff :patch [{:offset 32 :u64 65}] :expected 8
   :why "e_phoff 65. Clause 8 fires before clause 9, which would also refuse
         this one because 65 + 112 is past the window -- so on its own it does
         not show that clause 8 is load-bearing. The next vector does."}
  {:name :unaligned-phoff-that-fits
   :patch [{:offset 32 :u64 57}] :expected 8
   :why "e_phoff 57: NOT 8-aligned, and 57 + 112 = 169 is inside both the
         window and the image, so clause 9 does not apply. This is the vector
         clause 8 exists for. A bounded Kotoba load checks alignment LAST and
         TRAPS, so without clause 8 the module reads a program header at an
         unaligned offset and the loader dies instead of refusing the file --
         measured: removing the clause turns this vector into a trap, not into
         a different verdict."}
  {:name :phoff-past-the-window :patch [{:offset 32 :u64 4096}] :expected 9}
  {:name :phoff-inside-the-window-but-past-the-image
   :patch [{:offset 32 :u64 128}] :win 4096 :image-len 200 :expected 9
   :why "Separates the two bounds clause 9 proves. The table fits the window
         and not the file, so a check against the window alone admits it."}

  ;; --- segment 0 ---
  {:name :segment-0-not-pt-load :patch [{:offset 64 :u32 2}] :expected 21}
  {:name :segment-0-empty :patch [{:offset 96 :u64 0} {:offset 104 :u64 0}]
   :expected 22
   :why "filesz AND memsz zero, so it is refused for being empty rather than
         for the two disagreeing."}
  {:name :segment-0-filesz-ne-memsz :patch [{:offset 104 :u64 192}] :expected 23}
  {:name :segment-0-below-1mib :patch [{:offset 88 :u64 32768}] :expected 24}
  {:name :segment-0-memsz-above-1mib
   :patch [{:offset 96 :u64 1052672} {:offset 104 :u64 1052672}] :expected 25
   :why "filesz tracks memsz so clause 3 does not fire first. Ordering is part
         of the contract: a reason is only meaningful if the clauses before it
         did not also apply."}
  {:name :segment-0-unaligned-paddr :patch [{:offset 88 :u64 1052673}] :expected 27}
  {:name :segment-0-past-the-image
   :patch [{:offset 72 :u64 110848}] :expected 28
   :why "p_offset 110848 + filesz 160 = 111008, past the 110872-byte file."}

  ;; --- segment 1 ---
  {:name :segment-1-not-pt-load :patch [{:offset 120 :u32 0}] :expected 31}
  {:name :segment-1-filesz-ne-memsz :patch [{:offset 160 :u64 77825}] :expected 33}
  {:name :segment-1-below-1mib
   :patch [{:offset 144 :u64 524288}] :expected 34}
  {:name :segment-1-past-1gib
   :patch [{:offset 144 :u64 1073737728}] :expected 36
   :why "paddr 0x3FFFF000 + memsz 77824 crosses 1 GiB while staying aligned and
         above the floor, so only clause 6 refuses it."}

  ;; --- the whole-file rules ---
  {:name :segment-0-flags-rw :patch [{:offset 68 :u32 6}] :expected 40}
  {:name :segment-1-flags-rwx :patch [{:offset 124 :u32 7}] :expected 41}
  {:name :entry-outside-segment-0 :patch [{:offset 24 :u64 1052832}] :expected 42
   :why "paddr 1052672 + memsz 160 = 1052832, one past the end, so this is the
         boundary rather than a value far away."}
  {:name :entry-just-inside-segment-0 :patch [{:offset 24 :u64 1052831}] :expected 0
   :why "The other side of that boundary. Without it, an off-by-one in the
         comparison passes the vector above and is never seen."}
  {:name :segments-overlap
   :patch [{:offset 144 :u64 1052672}] :expected 43
   :why "Both segments at the same paddr. Every per-segment clause still holds
         -- aligned, above the floor, under the ceilings -- so only the
         non-overlap rule refuses it."}]

 :verification
 {:memory {:base 65536 :image-bytes 512 :header-offset 0}
  :fuel 1000000
  :node-stack-size 4000
  :off-target :interpreter
  :evidence "os/aiueos/scripts/smoke-qemu-uefi-loader.cljk"
  :note "The smoke boots the same module under OVMF and asserts six of these
         verdicts as x86-64 machine code. This contract asserts all of them
         without a firmware."}}
