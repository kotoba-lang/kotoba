;; The declaration kotoba-native's `kernel-object-entries` transcribes -- in
;; BOTH `elf64.clj` and `elf64.cljc`, because the JVM loads `.clj` first and
;; kotoba-native ADR-0036 keeps the two a twin -- so that the export symbol is
;; stated by the repository that owns the decision.
{:format :aiueos.sha256-region/v1
 :graph {:root aiueos.sha256-region
         :modules [aiueos.lib.sha256-stream aiueos.sha256-region]}
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_sha256_region"
          :imports []
          :required-operations [kernel-load-u8 kernel-store-u8 kernel-subregion]}
 :arguments [:st :st-len :src :src-len]

 ;; WHY THIS OBJECT EXISTS.
 ;; `aiueos-sha256` refuses an input above 12,288 bytes and the shared module
 ;; `aiueos/lib/sha256_core.kotoba` hashes at most 192. Both are WHOLE-MESSAGE
 ;; primitives, so both have to see the message through ONE bounded-memory
 ;; window, and the widest window kotoba-native has is 65,536 bytes. Raising a
 ;; constant cannot reach 131,080 bytes (the device-P256 worker's widest
 ;; canonical input) let alone a kernel image; a streaming core can, because it
 ;; narrows one 64-byte view at a time with `kernel-subregion`, which has no
 ;; ceiling of its own.
 ;;
 ;; This is the ONE-CALL form of that core, for a caller that already has the
 ;; whole buffer mapped. `aiueos-sha256-stream` is the incremental form.

 ;; NOT A BOOLEAN. ZERO IS THE SUCCESS VALUE -- the convention of
 ;; `aiueos-hkdf-sha256` and `aiueos-aes128-gcm`, not the `aiueos-qwen35-*`
 ;; positive-length one, because the useful output is bytes in a region and
 ;; there is no length to return.
 :result {:kind :reason-code
          :admit :zero
          :range [1 3]
          :truthy-is-success false}
 :reasons {1 :st-len-below-512
           2 :src-len-negative
           3 :src-len-above-1048576}

 ;; THE CEILING IS 1,048,576 BYTES AND IT IS A FUEL FACT.
 ;; The block loop is bounded by `(quot src-len 64)` -- derived from the
 ;; caller's own length -- and this entry refuses a length above the literal
 ;; before the loop starts, so nothing here is unbounded. Where the literal
 ;; goes is decided by the largest budget the prologue can be given: the
 ;; replenish is a 32-bit immediate, so no object can hold more than
 ;; 2,147,483,647 fuel, and at the measured per-block cost below that is about
 ;; 1.2 million blocks. 1 MiB is 16,384 blocks and its tier clears it 8x.
 ;;
 ;; A 2^32-byte ceiling would be the failure this repository keeps naming: the
 ;; object would accept the argument and `ud2` in its own prologue partway
 ;; through, which surfaces as an unexpected vector 6 and reads as a protocol
 ;; bug rather than a fuel bug.
 :ceiling {:src-len 1048576
           :blocks 16384
           :why "the largest input the largest possible fuel tier covers, with
                 margin; see :fuel below"}

 :st {:bytes 512
      :layout {:schedule [0 256] :state [256 32] :working [288 32]
               :round-temp [320 32] :length [352 8] :assembly [360 64]
               :digest [424 32] :reserved [456 56]}
      :why "512 is a LITERAL inside `aiueos.lib.sha256-stream`, not a
            parameter, exactly as sha256_core's 800 is: the ABI admits five
            arguments and threading a length through every helper spends one
            forever. It is also the cheapest memwidth tier, so every access is
            a base `kernel-load-u8` / `kernel-store-u8`."}

 :verification
 {:off-target :executed
  :mechanism :kir-execute-with-a-supplied-memory-image
  :runner "os/aiueos/scripts/verify-admissions.cljk"
  :host :nbb
  :node-stack-size 60000
  :memory {:base 65536 :image-bytes 2048 :st-offset 0 :src-offset 1024}
  :fuel 4000000
  ;; WHERE THE EXPECTED BYTES COME FROM. The first four are FIPS 180-4's own
  ;; published examples (the empty string, "abc", and the 448-bit and 896-bit
  ;; cases from Appendix B). The rest were computed by an implementation that
  ;; is not this one -- node's `crypto.createHash('sha256')` -- and every one
  ;; of them is also checked against `kotoba-lang/org-nist-sha2`, the pure
  ;; `.cljc` reference, by `test/aiueos/sha256_stream_parity_test.cljk`.
  :oracles {:published "FIPS 180-4 Appendix B / RFC 6234 section 8.5"
            :second-implementation "kotoba-lang/org-nist-sha2 (pure cljc)"}
  ;; MEASURED, by bisecting the fuel each call needs to return, in the
  ;; `kotoba.kir` interpreter. The interpreter charges one unit per Kotoba
  ;; call, which is the same accounting the emitted prologue does. It is a fit,
  ;; not an execution on a CPU; the CPU half is the QEMU boot self-test
  ;; SHA-STREAM-PARITY, and both numbers are reported in ADR-0142.
  :fuel-model {:per-64-byte-block :measured-see-adr-0142
               :fixed :measured-see-adr-0142}
  :floors {:minimum-vectors 12
           :minimum-memory-assertions 9
           :every-reachable-reason-observed true}}

 :vectors
 [{:name :fips-empty
   :message-ascii ""
   :expected 0
   :digest-hex "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
   :why "FIPS 180-4. Zero full blocks: the padding block is the ONLY
         compression, which is the shortest path through `sha-final`."}
  {:name :fips-abc
   :message-ascii "abc"
   :expected 0
   :digest-hex "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
   :why "FIPS 180-4 Appendix B.1."}
  {:name :fips-448-bit
   :message-ascii "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
   :expected 0
   :digest-hex "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
   :why "FIPS 180-4 Appendix B.2. 56 bytes, which is EXACTLY the boundary: the
         0x80 and the 8-byte length no longer fit in one block, so this is the
         `final-long` arm and the object compresses twice for a message that
         never filled a block."}
  {:name :fips-896-bit
   :message-ascii "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
   :expected 0
   :digest-hex "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1"
   :why "FIPS 180-4 Appendix B.3. 112 bytes: one full block through the loop,
         then a 48-byte `final-short` tail."}
  {:name :one-exact-block
   :message-bytes 64 :fill-byte 97
   :expected 0
   :digest-hex "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb"
   :why "The loop runs once and the tail is EMPTY. A padding routine that
         skipped the final block when nothing was left over would produce a
         digest of the first block's state and pass every vector above."}
  {:name :fifty-five
   :message-bytes 55 :fill-byte 97
   :expected 0
   :digest-hex "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318"
   :why "The last length that fits in one padding block."}
  {:name :fifty-six
   :message-bytes 56 :fill-byte 97
   :expected 0
   :digest-hex "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a"
   :why "The first length that does not. 55 and 56 are adjacent and take
         DIFFERENT arms, so an off-by-one in the `< 56` test moves exactly one
         of these two."}
  {:name :sixty-three
   :message-bytes 63 :fill-byte 97
   :expected 0
   :digest-hex "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34"
   :why "The largest tail the object accepts."}
  {:name :one-thousand
   :message-bytes 1000 :fill-byte 97
   :expected 0
   :digest-hex "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3"
   :why "Fifteen loop iterations and a 40-byte tail. This is the only vector
         here that exercises the block loop MORE than twice, which is what
         makes it the expensive one -- see the receipt's :elapsed-ms. Anything
         larger belongs to the QEMU self-test, not to a ClojureScript
         interpreter."}

  {:name :st-len-below-512
   :message-bytes 0 :st-len 511
   :expected 1
   :why "The state region's length IS checked, even though the 512 inside the
         module is a literal. A caller with a smaller buffer would otherwise
         have its own memory written by `store32`."}
  {:name :src-len-negative
   :message-bytes 0 :src-len -1
   :expected 2
   :why "A negative length reaches `kernel-subregion` as a huge unsigned value
         and would trap there. Refusing names the cause."}
  {:name :src-len-above-ceiling
   :message-bytes 0 :src-len 1048577
   :expected 3
   :why "One byte over. The object refuses rather than accepting an argument
         its fuel cannot pay for."}]}
