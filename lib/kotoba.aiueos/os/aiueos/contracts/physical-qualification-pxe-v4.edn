;; v4 follows the PXE-only GOP observation and physical v3 code 251.  The
;; firmware publishes the K16 framebuffer near the top of PML4 slot zero,
;; outside the kernel's obsolete below-3-GiB admission bound.  Admit one
;; framebuffer directory in any otherwise-empty PDPT slot below 512 GiB.
{:format :aiueos.physical-qualification-pxe/v4
 :extends "physical-qualification-pxe-v3.edn"
 :observed-input {:physical-result-code 251
                  :gop {:base 0x7fe0000000
                        :bytes 1996800
                        :width 800
                        :height 600
                        :stride 832
                        :format 1}}
 :framebuffer-map {:pml4-slot 0
                   :pdpt-slot 511
                   :single-pdpt-slot? true
                   :requires-empty-slot? true
                   :leaf-size 0x200000
                   :permissions [:supervisor :write :nx :uncached]
                   :memory-encryption-bit? false}
 :safety {:internal-disk-writes? false
          :usb-runtime-writes? false
          :ssd-install? false}}
