;; Guest clipboard/file-picker admit (ADR-0096). Admit is Kotoba; C mechanism only.
{:format :aiueos.broker-admit/v1
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_broker_admit"
          :admit-from "kotoba_aiueos_broker_admit"}
 :vectors {:clipboard-only-boot :ok
           :always-grant :leftover
           :deny-all :leftover}
 :trusts-caller-for [:native-phase6-compositor
                     :physical-boot
                     :native-component-runtime]
 :verification {:off-target :impossible
                :reason :kir-refuses-kernel-memory
                :evidence "nbb --classpath src scripts/compositor-guest.cljk guest-broker"}
}
