;; Companion declaration to dhcp-reply-valid-v1.edn (kotoba-native#57, ADR-0076).
{:format :aiueos.dhcp-option-u32/v1
 :native {:target :x86_64-aiueos-kernel-v1
          :export "kotoba_aiueos_dhcp_option_u32"
          :imports []}
 :arguments [:frame :length :code]

 :result {:kind :value
          :absent 0
          :requires-option-length 4
          ;; Zero is also a legal 32-bit value. Unambiguous only because every
          ;; option this OS asks for is meaningless as 0.0.0.0 or as a
          ;; zero-second lease, AND because dhcp-reply-valid has already refused
          ;; a reply whose mask, lease or server identifier is missing.
          ;; PRESENCE IS THE ADMISSION'S DECISION, NOT THIS ONE'S.
          :ambiguous-for :options-the-admission-does-not-require}

 :codes {1 :subnet-mask 3 :router 6 :domain-name-server
         51 :lease-time 54 :server-identifier}

 ;; It re-derives the envelope and re-walks the options rather than being told
 ;; where to look. An offset that came from anywhere but a bounded walk is an
 ;; offset nothing has bounded, so there is no parameter a caller could pass
 ;; that would be safe to trust.
 :re-derives [:ipv4-envelope :magic-cookie :options-limit]
 :trusts-caller-for []

 :verification {:off-target :impossible
                :reason :kir-refuses-kernel-memory
                :evidence "os/aiueos/scripts/smoke-qemu-dhcp.sh"
                :note "Exercised indirectly: the address, mask, router, server
                       and lease printed by AIUEOS_DHCP_OK are what this object
                       returned, and the gate compares them with SLIRP's fixed
                       topology."}}
