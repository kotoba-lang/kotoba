 ;; The gaps, each with the probe that shows it. :side says where the
 ;; smallest fix lives. None is in this repository.
 :gaps
 [{:id :native/fuel-fixed-512
   :side :amu
   :where "tools/kexe_loader.c line 2377 `shared->context.fuel = 512;`; bin/kbb_shim.cljs run-native! refuses --fuel by name"
   :probe "kbb-probes/nl_count.kotoba --backend native on debug_link.kotoba (14,789 B)"
   :measured "KEXE_TRAP {:kind :signal :signal :SIGTRAP}, loader status 120 (kbb-probes/measured-native-byte-walk.edn)"
   :needed "a fuel budget the shim can pass (env or argv) and the loader honours; without it no scan of a real source file runs on native"}
  {:id :native/no-browse-provider
   :side :amu
   :where "kexe_loader.c has no wire-34 (:fs/browse) provider; bin/kbb_shim.cljs native-hosted = #{:fs/app-data}"
   :probe "kbb-probes/browse_count.kotoba --backend native"
   :measured "exit 3 :kbb/no-jvm-free-backend `the native backend does not host [:fs/browse]` (kbb-probes/measured-native-browse.edn); js answers 11 entries"
   :needed "opendir/readdir provider for wire 34 (ADR-2609051100 task 5) so a native guest can discover the files a scan is over"}
  {:id :host/file-over-64KiB
   :side :kotoba-and-amu
   :where "bin/kbb_js.cljs max-file-bytes 65536 (the artifact's string-value-bytes limit); kexe_loader.c fs_app_data_read_provider; lib/kbb/fs.kotoba read-file"
   :probe "kbb-probes/nl_count.kotoba --backend js on tcp_stream.kotoba"
   :measured ":denied `file exceeds the guest string limit (83691 > 65536 bytes)` (kbb-probes/measured-js-read-83691-bytes.edn)"
   :needed "a ranged read on wire 35 -- request `<path>RANGE_SEP<offset>:<len>` mirroring the WRITE_SEP form -- in kbb_js.cljs, kexe_loader.c and lib/kbb/fs.kotoba (read-range), so a guest can read one top-level form at a time; the guest string limit itself is not the gap, the whole-file request shape is"}
  {:id :guest/byte-step-trips-code-point-boundary
   :side :kotoba-lang-grammar-or-guest-design
   :where "amu src/kotoba/compiler/backend/cljs.cljc:335 :substring-code-point-boundary; the guest has string-substring / string-index-of / string-split-count / string-byte-length only (guest-grammar.edn)"
   :probe "kbb-probes/nl_count.kotoba --backend js --fuel 100000000 on debug_link.kotoba"
   :measured ":kbb-js/guest-failed string-substring-code-point-boundary after the 14,789-byte read succeeded (kbb-probes/measured-js-byte-walk-fuel-1e8.edn)"
   :needed "either a byte-addressed step (string-byte-at, or string-index-of with a start offset) or a guest tokenizer that only ever cuts at ASCII delimiters found by string-index-of (each step then copies the remainder: O(n) per token). kbb.edn's char-at walk has the same exposure on this corpus"}
  {:id :js/default-fuel
   :side :none
   :where "bin/kbb_js.cljs --fuel"
   :probe "kbb-probes/nl_count.kotoba --backend js (no --fuel)"
   :measured "fuel-exhausted on 14,789 bytes (kbb-probes/measured-js-byte-walk-default-fuel.edn); --fuel 100000000 gets past it"
   :needed "nothing on the js side (the knob exists); the parity claim must state the --fuel used"}
  {:id :guest/single-i64-result
   :side :design
   :where "kbb main returns one i64; the nbb tool prints SCANNED x2, PER-FILE, PER-CLASS, SITE lines and exits 0/1/2"
   :measured "by construction (examples/kbb/* all pack counts into one i64)"
   :needed "pack files*10^7 + forms*10^4 + findings, and let the caller derive exit 0/1/2; SITE lines (file:line + form) are not expressible without a string result or a write capability"}]

 :verify-store-tautology/next
 ["land :native/fuel-fixed-512 + :native/no-browse-provider + ranged read in amu tools/kexe_loader.c (one PR), advance kotoba deps.edn amu pin, widen bin/kbb_shim.cljs native-hosted to #{:fs/app-data :fs/browse}"
  "add read-range to lib/kbb/fs.kotoba and the RANGE_SEP form to bin/kbb_js.cljs (kotoba PR) with a >65536-byte fixture asserted on js AND native"
  "then write os/aiueos/tools/verify-store-tautology.kotoba as a top-level-form tokenizer that cuts only at ASCII delimiters, env of let-bound store operands carried as text, and re-run kbb-probes first: all five receipts must change before the port is attempted"]

 ;; ---------------------------------------------------------------- task 2
 ;; tool -> ops the nbb source uses -> what lib/kbb / the kbb hosts offer today
 ;; -> missing. lib/kbb today: fs (read/write, one file, <= 64 KiB, js+native),
 ;; env (js), browse (names only, js), proc (exit status only, js), git
 ;; (exit + stdout, js), str, edn (text-level, pure). catalog wire ids exist for
 ;; :net/datagram 27 (kit datagram-v1: reference implemented, jit/native
 ;; pending, hosted by neither kbb backend), :clock/now 7, :hash/sha256 3,
 ;; :http/accept 17 / :http/reply 18; no TCP stream client/server capability
 ;; exists in capability-catalog.edn at all.
 :rig-tools
 [{:tool "k16-bridge.cljs"
   :ops ["net/createServer + listen (TCP accept)" "sock.write greeting" "js/setTimeout hold" "resetAndDestroy (RST close)" "net.connect upstream" "sock.on data/close/error pumps"]
   :in-lib-kbb []
   :missing ["TCP listen/accept" "TCP connect" "stream write/read" "close-with-RST" "timer" "long-running event loop (kbb main runs once and returns one i64)"]}
  {:tool "k16-bus3-sink.cljs"
   :ops ["dgram/createSocket udp4 reuseAddr + bind" "on message" "fs.appendFileSync by name per datagram" "Date toISOString" "liveness interval" "process.pid"]
   :in-lib-kbb ["fs/write-file (whole-file replace, <= 64 KiB, no append)"]
   :missing ["UDP bind/receive (:net/datagram wire 27 exists in the catalog, kit datagram-v1 :jit/:native-aot pending, no kbb host provider)" "append-by-name (fs/write-file replaces; appending means read+write and the sink outgrows 64 KiB)" "clock (:clock/now wire 7, not hosted by kbb_js or the loader)" "long-running listener"]}
  {:tool "k16-rig-check.cljs"
   :ops ["dgram/createSocket + send (UDP control)" "net/connect + destroy (TCP control)" "cp/execFileSync ifconfig / netstat / ps / sysctl" "crypto/randomBytes nonce" "crypto/createHash sha256" "fs/readFileSync, openSync/readSync/fstatSync/closeSync (tail a log)" "fs/readdirSync, statSync" "fs/writeFileSync" "setTimeout with promesa"]
   :in-lib-kbb ["fs/read-file (whole file <= 64 KiB; the logs it tails exceed that)" "browse/entries (names only)" "proc/exec (exit status only; the tool parses ifconfig/netstat/ps/sysctl STDOUT)" "fs/write-file"]
   :missing ["UDP send" "TCP connect" "process stdout capture (git/run returns exit+stdout for git only)" "entropy (:entropy/draw wire 23, not hosted)" "sha256 (:hash/sha256 wire 3, not hosted)" "ranged/tail read of a log > 64 KiB" "timer / timeout"]}
  {:tool "verify-wire-bytes.cljs"
   :ops ["fs/readFileSync registry + emitter sources" "cljs.reader read-string of wire-bytes.edn (maps, vectors, keywords, :span ints)" "edamame parse-string-all of .kotoba forms with row metadata" "structural walk: integer literals, (+ N (* 0 ...)), (if ...) branches" "println report, exit 0/1/2"]
   :in-lib-kbb ["fs/read-file" "edn (entry-count / value-of / value-i64 / has-key? / well-formed? -- text level, top-level map only)"]
   :missing ["s-expression reader for .kotoba forms with line numbers (same gap as verify-store-tautology)" "nested EDN access (kbb.edn reads top-level keys only; :entries is a vector of maps)" "byte-safe stepping (tcp_stream.kotoba and kernel.kotoba carry U+2500)" "multi-line report output"]}]}
