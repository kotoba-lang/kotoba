;; kbb probe: count the entries of os/aiueos/native through kbb.browse.
;; Measured 2026-09-07: js answers 11 (10 .kotoba + wire-bytes.edn);
;; native exits 3 -- `the native backend does not host [:fs/browse]`
;; (bin/kbb_shim.cljs native-hosted = #{:fs/app-data}; the pinned
;; kexe_loader.c has no wire-34 provider). Without a listing the native
;; backend cannot discover the files a scan is over.
;; Run: sed "s|__DIR__|$PWD/os/aiueos/native|" on this file and browse_policy.edn,
;; then bin/kbb <copy> --policy <copy> --source-path <kotoba>/lib --backend native|js
(ns probe.browse-count (:require [kbb.browse :as browse]) (:export [main]))

(defn main [] :i64 (browse/entry-count "__DIR__"))
