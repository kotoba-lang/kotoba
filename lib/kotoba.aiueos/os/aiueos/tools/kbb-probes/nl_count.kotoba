;; kbb probe: walk one .kotoba source byte by byte and count newlines.
;; Stands in for the char-stepping every scanner must do. Measured 2026-09-07
;; (kotoba cb70c4464, amu ffd9adfa, kbb-migration-gaps.edn :probes/byte-walk):
;;   --backend js                 fuel-exhausted on debug_link.kotoba (14,789 B)
;;   --backend js --fuel 1e8      string-substring-code-point-boundary
;;                                (the file's comments carry U+2500 box drawing)
;;   --backend native             SIGTRAP (kexe_loader.c fuel is a fixed 512;
;;                                the shim refuses --fuel on native by name)
;; Run (paths must be absolute; the shim chdirs to KBB_HOME):
;;   sed "s|__FILE__|$PWD/os/aiueos/native/debug_link.kotoba|" nl_count.kotoba > /tmp/p.kotoba
;;   sed "s|__DIR__|$PWD/os/aiueos/native|" fs_policy.edn > /tmp/p_policy.edn
;;   AMU_HOME=<amu pin with node_modules> <kotoba>/bin/kbb /tmp/p.kotoba \
;;     --policy /tmp/p_policy.edn --source-path <kotoba>/lib --backend js|native
(ns probe.nl-count (:require [kbb.fs :as fs]) (:export [main]))

(defn count-nl [s :string i :i64 n :i64 acc :i64] :i64
  (if (>= i n)
    acc
    (count-nl s (+ i 1) n
              (if (string=? (string-substring s i (+ i 1)) "\n") (+ acc 1) acc))))

(defn main [] :i64
  (let [c (fs/read-file "__FILE__")]
    (count-nl c 0 (string-byte-length c) 0)))
