(ns aiueos.session.app-catalog
  (:export [app-count app-title-length app-title-codepoint app-body-length app-body-codepoint]))
;; Exact scalar Kotoba counterpart of the compatibility CLJK catalogue.
;; Cards describe unregistered services; they do not execute dapps or infer.
(defn app-count [] :i64 4)
(defn app-title-length [id :i64] :i64 (case id 1 8 2 7 3 9 4 6 0))
(defn app-title-codepoint [id :i64 index :i64] :i64
  (case id
    1 (case index 0 77 1 117 2 114 3 97 4 107 5 117 6 109 7 111 0)
    2 (case index 0 73 1 116 2 111 3 110 4 97 5 109 6 105 0)
    3 (case index 0 89 1 97 2 116 3 97 4 118 5 101 6 114 7 115 8 101 0)
    4 (case index 0 65 1 111 2 122 3 111 4 114 5 97 0) 0))
(defn app-body-length [id :i64] :i64 (case id 1 35 2 12 3 39 4 45 0))
(defn app-body-codepoint [id :i64 index :i64] :i64
  (case id
    1 (case index 0 78 1 111 2 100 3 101 4 32 5 104 6 97 7 114 8 100 9 119 10 97 11 114 12 101 13 10 14 78 15 111 16 116 17 32 18 99 19 111 20 110 21 110 22 101 23 99 24 116 25 101 26 100 27 10 28 79 29 102 30 102 31 108 32 105 33 110 34 101 0)
    2 (case index 0 71 1 111 2 97 3 108 4 32 5 40 6 82 7 65 8 77 9 41 10 58 11 10 0)
    3 (case index 0 68 1 97 2 112 3 112 4 32 5 115 6 112 7 97 8 99 9 101 10 10 11 78 12 111 13 32 14 100 15 97 16 112 17 112 18 32 19 105 20 110 21 115 22 116 23 97 24 108 25 108 26 101 27 100 28 10 29 78 30 111 31 32 32 110 33 101 34 116 35 119 36 111 37 114 38 107 0)
    4 (case index 0 83 1 111 2 99 3 105 4 97 5 108 6 32 7 40 8 65 9 84 10 32 11 80 12 114 13 111 14 116 15 111 16 99 17 111 18 108 19 41 20 10 21 78 22 111 23 116 24 32 25 115 26 105 27 103 28 110 29 101 30 100 31 32 32 105 33 110 34 10 35 78 36 111 37 32 38 110 39 101 40 116 41 119 42 111 43 114 44 107 0) 0))
