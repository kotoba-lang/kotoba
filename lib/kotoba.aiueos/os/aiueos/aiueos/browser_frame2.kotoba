;; Guest browser desktop frame with text: kotoba-lang/browser surface state and
;; its window titles / bodies -> one retained draw list of rects AND glyphs, on
;; KERNEL.ELF (ADR-0224, extending ADR-0223's browser-frame).
;;
;; WHY THIS IS A KOTOBA OBJECT AND NOT A C TABLE
;;
;; Which glyph a code point becomes, where it goes, where a line breaks, what
;; is clipped and what stands in for a missing glyph are layout decisions --
;; browser.surface renders `:window/title` in the titlebar and the document
;; in the body, and cssom decides the lines. The Kotoba native presenter
;; blits the bitmaps this list names (mechanism) and never chooses a glyph or
;; a position.
;;
;; ONE list, window by window in stack order (body rect, titlebar rect, title
;; glyphs, body glyphs), so a back window's text can never be painted over a
;; front window: z-order is the list order, as in ADR-0223.
;;
;; Mirrored from kotoba-lang/browser: z-order and colours as browser-frame;
;; text colour browser.surface default-theme :fg #111111; body line height
;; default-theme :line-height 20; titlebar 28 (browser.input/titlebar-height),
;; title inset 8. Not mirrored: where cssom puts the windows (its workspace
;; stacks them in block flow; here they sit at :window/rect), bidi, combining
;; marks, emphasis.
;;
;; BODY FLOW (ADR-0234): the body is laid out as browser.surface +
;; cssom.layout lay out the window's document -- the body text, each 10 a
;; <br> -- measured with this font (cssom's `:measure-text` hook), compared
;; glyph for glyph against the hosted engine by the guest-browser-flow-parity
;; gate:
;;   - the body box is (x, y + 28); its text starts 14 in from its left and
;;     top (`.window-body` padding 8 plus cssom's default-theme :padding 6 on
;;     the text) and its lines are W = w - 28 wide, 20 apart;
;;   - white space is what cssom's text path collapses, less 10: U+0009 000B
;;     000C 000D 0020 00A0 1680 2000..200A 2028 2029 202F 205F 3000 FEFF; a run
;;     of it is one U+0020;
;;   - with no 10 in the body: only white space draws nothing; a collapsed
;;     body at most W wide is one line as collapsed (a leading or trailing
;;     space kept); a wider one is packed by words;
;;   - with a 10: each 10 ends a line (an empty segment still takes one) and
;;     each segment is packed by words;
;;   - packing by words: a word is a run of non-white-space; the first word of
;;     a line goes whatever its width -- it overflows the right edge, a CJK run
;;     included, because cssom has no break opportunity inside a word; a next
;;     word joins the line after one U+0020 if the line still fits in W, else it
;;     opens the next line.
;; The kernel's two clips, which the hosted engine does not have: a glyph whose
;; foot passes the bottom inset (y + h - 8) or whose right edge passes the
;; viewport is not drawn (the pen still moves).
;;
;; Temporary native constraints, with ADR-0223's removal condition: word types,
;; a bounded u32 surface window, at most five parameters (cursor state lives in
;; the surface's scratch words rather than in arguments).
;;
;; SURFACE (u32 LE words, exactly 8192 bytes):
;;   words 0..31    the browser-frame state: abi=1 n focus vw vh, then
;;                  id x y w h per window, bottom first; ids are 1..4
;;   32 + 32(id-1)  title of window id, up to 32 code points, 0 ends it
;;   160 + 64(id-1) body of window id, up to 64 code points, 0 ends it,
;;                  10 breaks the line
;;   416..430       scratch owned by this object (overwritten every call)
;;   431            Alt held, browser-ime.kotoba's (ADR-0237); not read here
;;   432..479       the input method's state (browser-ime.kotoba); this
;;                  object reads 433 romaji length, 434..441 romaji bytes,
;;                  445 preedit length, 446..477 preedit code points
;;   480 + 6j       op j: kind x y a b rgb
;;                  kind 1 rect:  a = width, b = height
;;                  kind 2 glyph: a = glyph index in the font, b = 8 or 16
;;                  capacity 259 ops (words 480..2033; 261 until ADR-0238,
;;                  260 until ADR-0240)
;;   2034           scratch owned by this object (ADR-0240): the first
;;                  highlighted body index of the window being laid out, 64
;;                  for none
;;   2035           Shift held, browser-ime.kotoba's (ADR-0240); not read here
;;   2036 2037      the selection, browser-ime.kotoba's (ADR-0240): the window
;;                  id it belongs to (0 none) and its length k, the last k code
;;                  points of that window's body
;;   2038           native Itonami RAM goal length (desktop adapter)
;;   2039           not assigned
;;   2040..2043     the vertical scroll offset of window id 1..4
;;                  (browser-reduce.kotoba's, ADR-0238), at most 65535
;;   2044 2045      scratch owned by this object (ADR-0238): the body's top
;;                  clip and the offset of the window being laid out
;;   2046 2047      the pointer (ADR-0236): 2046 is its x + 1, 0 = no
;;                  pointer to draw; 2047 its y. The two words past the
;;                  op capacity, which nothing else reads or writes.
;; Until 2026-09-24 the scratch sat at 400..415, inside window 4's body
;; (352..415): a fourth body longer than 48 code points was read back as the
;; object's own cursor words. Found while laying out the IME state; vector
;; `fourth-window-body-reads-all-64` was red on that layout.
;;
;; COMPOSITION (ADR-0227): while the focused window has a composition, it is
;; laid right after that window's body text -- the preedit code points, then
;; the romaji still in the buffer -- each drawn glyph with a 1 px #111111
;; rule at its foot (y + 17), cut like the body and wrapping glyph by glyph
;; at x + w - 14 (ADR-0234: the composition is not in cssom's document, so it
;; is not packed by words; it continues from wherever the body ended). A commit
;; empties both, so the next frame has neither the glyphs nor the rule.
;; browser.document-input keeps the composition on the text state apart from
;; the committed text; this is where it becomes visible.
;; CARET (ADR-0232): after the focused window's body and composition, one
;; 1 x 16 #111111 rect where the next glyph would go -- cssom.layout's
;; `sel-ops` collapsed selection (`:w 1 :h font-size :color (:fg theme)`) with
;; the caret at the end of the text, which is where browser.text-edit
;; `insert-text` leaves it. It does not wrap by itself: at the right inset it
;; stands in the inset. Not drawn when its foot (y + 16) passes the bottom
;; inset, like a glyph. Only the focused window has one; it does not blink.
;; LAUNCHER AND CLOSE (ADR-0233): word 31 is the app register (bit k-1 = app
;; k, whose title is title slot k). With it 0 nothing below is drawn and every
;; earlier frame is unchanged. With it not 0, right after the background: the
;; launcher row (0, 0, vw, 28) #edf0f5 (browser.surface `.launcher`
;; background), and for each registered app k a button (6 + 102(k-1), 2, 96,
;; 24) in the theme's :button-bg #e4e8ef with the app's title at (x + 6, 6),
;; one line, clipped at x + 90. The row is under every window, as the list
;; order says. And in each window at least 40 wide, after its title, a close
;; control: (x + w - 24, y + 6, 16, 16) #e4e8ef with U+00D7 centred on it in
;; the text colour; the title then clips at x + w - 28. The geometry is the
;; kernel's -- browser.surface's launcher is a DOM row cssom lays out, and its
;; window-node has no close control -- and browser-reduce.kotoba hit-tests
;; the same numbers.
;; POINTER (ADR-0236): with word 2046 not 0, the list ends with the pointer
;; at (x, y) = (word 2046 - 1, word 2047), over everything -- after the last
;; window, so no window, glyph, caret or launcher can cover it. The sprite is
;; the kernel's own (browser.surface draws none: the hosted desktop has the
;; host's cursor): an arrow 12 rows tall with its tip at (x, y), row r
;; (0..11) one #111111 rect (x, y + r, r + 1, 1) and, in rows 2..10, a
;; #ffffff rect (x + 1, y + r, r - 1, 1) over it -- a white arrow with a 1 px
;; outline, its left edge straight down from the tip, its right edge the
;; diagonal, its foot row 11. Clipped to the viewport: a row whose y + r is
;; at or past vh is not drawn, and every rect is cut at vw (a fill left with
;; no width is not drawn). 21 ops unclipped.
;; SCROLL (ADR-0238): window id's body, composition and caret are laid out as
;; above and drawn `offset` = word 2039 + id higher -- browser.surface's
;; `:window/scroll`, which the hosted window-node does not draw (the hosted
;; desktop leaves it to the host's overflow) -- and cut to the window: a glyph,
;; rule or caret whose top is above the top inset (y + 36: the titlebar and
;; the body's 8 px padding, the bottom inset's mirror) is not drawn, like one
;; whose foot passes the bottom inset. The layout runs in unscrolled
;; coordinates (the pen never goes above y + 42) and the offset is taken off
;; only as an op is written, so no coordinate is negative. The title, the close
;; control and the launcher do not scroll. With every offset 0 each frame is
;; the one before ADR-0238.
;; SELECTION (ADR-0240): when word 2036 is the focused window's id and its
;; body has code points, the last k = min(word 2037, the body's length) of them
;; are selected. Each glyph drawn for a selected code point has, right before
;; it, a rect of its own width and 16 high at its place in #b5cdf1 -- cssom.
;; layout's sel-ops highlight, rgba(70,130,220,0.4), over the focused body's
;; #ffffff, since the blit has no alpha -- so the highlight is behind the glyph,
;; as the floor asks, where cssom lays its translucent rect over the text. A
;; collapsed run of white space draws one U+0020 for the code point it is drawn
;; for: the first of the run on a line kept as collapsed, the last before the
;; word it precedes on a line packed by words; a 10 draws nothing. A glyph not
;; drawn (cut by an inset or the viewport) has no highlight. With a selection
;; there is no caret, as sel-ops draws a caret only for a collapsed selection.
;; Composition, title and chrome glyphs are never highlighted.
;; FONT: the aiueos-font/v1 blob (os/aiueos/scripts/make-font.cljk).
;;
;; ABI: [surface surface-bytes font font-bytes] -> op count, or
;;   -1 null region / surface not 8192 bytes   -2 abi or n outside 0..4
;;   -3 focus is not a window id               -4 a rect leaves the viewport
;;   -5 more than 259 ops                      -6 font refused (magic, version,
;;                                                count, length, no U+FFFD)
;;   -7 a window id outside 1..4               -8 the IME's lengths are past
;;                                                its buffers (romaji > 8 or
;;                                                preedit > 32)
;;   -9 the app register has a bit past app 4
;;   -10 the pointer is outside the viewport (word 2046 - 1 >= vw or word
;;       2047 >= vh with word 2046 not 0)
;;   -11 a scroll offset (words 2040..2043) past 65535

(ns aiueos.browser-frame2
  (:export [aiueos-browser-frame2 main]))

;; Scratch words.
;;   416 next op slot   417 cursor x   418 cursor y   419 line left
;;   420 right limit    421 bottom     422 colour     423 font bytes
;;   424 glyph count    425 U+FFFD     426 wrap?      427 overflow
;;   428 char limit     429 b of the next op  430 the body's window width

(defn sw [s i]
  (kernel-load-u32 (kernel-subregion s 8192 (* i 4) 4) 4 0))

(defn sput [s i v]
  (kernel-store-u32 (kernel-subregion s 8192 (* i 4) 4) 4 0 v))

(defn fw [s f i]
  ;; Font blobs are larger than the base 512-byte native load window. Narrow
  ;; to the containing 16 KiB slice before reading the aligned codepoint word.
  (let [offset (* i 4)
        ;; The native image supplies one owned, padded512KiB font region.
        ;; A scalar loaded from surface state cannot grant its extent.
        length 524288
        chunk-offset (* (quot offset 16384) 16384)
        chunk-length 16384]
    (kernel-load-u32-16k
     (kernel-subregion f length chunk-offset chunk-length)
     chunk-length (- offset chunk-offset))))

;; --- ops --------------------------------------------------------------------

(defn put-op [s kind x y a]
  ;; b and rgb come from the caller through scratch 429 and 422.
  (let [j (sw s 416)]
    (if (>= j 259)
      (do (sput s 427 1) 0)
      (let [base (+ 480 (* 6 j))]
        (do (sput s base kind)
            (sput s (+ base 1) x)
            (sput s (+ base 2) y)
            (sput s (+ base 3) a)
            (sput s (+ base 4) (sw s 429))
            (sput s (+ base 5) (sw s 422))
            (sput s 416 (+ j 1))
            0)))))

(defn put-rect [s x y w h]
  (do (sput s 429 h)
      (put-op s 1 x y w)))

(defn put-glyph [s x y gi gw]
  (do (sput s 429 gw)
      (put-op s 2 x y gi)))

;; --- font -------------------------------------------------------------------

(defn bsearch [s f lo hi cp]
  (if (> lo hi) -1
    (let [mid (quot (+ lo hi) 2)
          e (bit-and (fw s f (+ 4 mid)) 16777215)]
      (if (= e cp) mid
        (if (< e cp)
          (bsearch s f (+ mid 1) hi cp)
          (bsearch s f lo (- mid 1) cp))))))

(defn glyph-of [s f cp]
  (let [i (bsearch s f 0 (- (sw s 424) 1) cp)]
    (if (< i 0) (sw s 425) i)))

(defn glyph-width [s f gi]
  (if (> (fw s f (+ 4 gi)) 16777215) 16 8))

(defn fffd-ok [s f n]
  (let [r (bsearch s f 0 (- n 1) 65533)]
    (if (< r 0) 0
      (do (sput s 424 n) (sput s 425 r) 1))))

(defn font-header-ok [s f fb]
  ;; Scratch 407 already holds fb, so `fw` reads inside the font's bounds.
  (let [n (fw s f 2)]
    (if (not (= (fw s f 0) 1179994433)) 0
      (if (not (= (fw s f 1) 1)) 0
        (if (< n 1) 0
          (if (> n 65536) 0
            (if (< fb (+ 16 (* 36 n))) 0
              (fffd-ok s f n))))))))

;; 1179994433 is 0x46554941, "AIUF" little-endian.
(defn font-ok [s f fb]
  (if (< fb 16) 0
    (do (sput s 423 fb)
        (font-header-ok s f fb))))

;; --- text -------------------------------------------------------------------

(defn newline [s]
  (do (sput s 417 (sw s 419))
      (sput s 418 (+ (sw s 418) 20))
      0))

(defn place [s f gi gw]
  ;; The glyph at the cursor, if it fits under the bottom; then advance.
  (do (if (> (+ (sw s 418) 16) (sw s 421))
        0
        (put-glyph s (sw s 417) (sw s 418) gi gw))
      (sput s 417 (+ (sw s 417) gw))
      0))

(defn lay [s f base i]
  (if (>= i (sw s 428)) 0
    (let [cp (sw s (+ base i))]
      (if (= cp 0) 0
        (if (= cp 10)
          (do (newline s) (lay s f base (+ i 1)))
          (let [gi (glyph-of s f cp)
                gw (glyph-width s f gi)]
            (if (> (+ (sw s 417) gw) (sw s 420))
              (if (= (sw s 426) 1)
                (do (newline s) (place s f gi gw) (lay s f base (+ i 1)))
                0)
              (do (place s f gi gw) (lay s f base (+ i 1))))))))))

(defn comp-cp [s i]
  ;; The i-th code point of the composition: preedit, then romaji bytes.
  (if (< i (sw s 445)) (sw s (+ 446 i))
    (sw s (+ 434 (- i (sw s 445))))))

(defn place-ruled [s f gi gw]
  ;; A composition glyph and its rule, if it fits between the top inset
  ;; (scratch 2044) and the bottom; drawn the offset (2045) higher; advance.
  (do (if (> (+ (sw s 418) 16) (sw s 421))
        0
        (if (< (sw s 418) (sw s 2044))
          0
          (do (put-glyph s (sw s 417) (- (sw s 418) (sw s 2045)) gi gw)
              (put-rect s (sw s 417) (+ (- (sw s 418) (sw s 2045)) 17) gw 1))))
      (sput s 417 (+ (sw s 417) gw))
      0))

(defn lay-comp [s f i n]
  (if (>= i n) 0
    (let [gi (glyph-of s f (comp-cp s i))
          gw (glyph-width s f gi)]
      (do (if (> (+ (sw s 417) gw) (sw s 420)) (newline s) 0)
          (place-ruled s f gi gw)
          (lay-comp s f (+ i 1) n)))))

(defn caret [s]
  ;; ADR-0232: 1 x 16 in the text colour at the cursor, if its foot is above
  ;; the bottom inset (and, ADR-0234, it is inside the viewport: an
  ;; overflowing body can leave the cursor past it). It never wraps.
  ;; ADR-0238: nor when its top is above the top inset; drawn the offset higher.
  (if (> (+ (sw s 418) 16) (sw s 421)) 0
    (if (< (sw s 418) (sw s 2044)) 0
      (if (> (+ (sw s 417) 1) (sw s 3)) 0
        (do (sput s 422 1118481)
            (put-rect s (sw s 417) (- (sw s 418) (sw s 2045)) 1 16))))))

(defn text-block [s f base x y]
  ;; Right limit, bottom, wrap and limit are already in scratch.
  (do (sput s 417 x) (sput s 418 y) (sput s 419 x)
      (sput s 422 1118481)
      (lay s f base 0)))

;; --- body flow (ADR-0234) -----------------------------------------------------

(defn ws [cp]
  ;; the white space cssom collapses (a JS regex whitespace class), less 10
  (if (= cp 32) 1 (if (= cp 9) 1 (if (= cp 11) 1 (if (= cp 12) 1 (if (= cp 13) 1
    (if (= cp 160) 1 (if (= cp 5760) 1 (if (< cp 8192) 0 (if (< cp 8203) 1
      (if (= cp 8232) 1 (if (= cp 8233) 1 (if (= cp 8239) 1 (if (= cp 8287) 1
        (if (= cp 12288) 1 (if (= cp 65279) 1 0))))))))))))))))

(defn at [s base i]
  ;; the body's i-th code point, 0 past its end or its limit
  (if (>= i (sw s 428)) 0 (sw s (+ base i))))

(defn adv [s f cp] (glyph-width s f (glyph-of s f cp)))

(defn has-nl [s base i]
  (let [c (at s base i)]
    (if (= c 0) 0 (if (= c 10) 1 (has-nl s base (+ i 1))))))

(defn inked [s base i]
  (let [c (at s base i)]
    (if (= c 0) 0 (if (= (ws c) 1) (inked s base (+ i 1)) 1))))

(defn cwidth [s f base i pws]
  ;; the width of the body with each white-space run one U+0020
  (let [c (at s base i)]
    (if (= c 0) 0
      (if (= (ws c) 1)
        (+ (if (= pws 1) 0 (adv s f 32)) (cwidth s f base (+ i 1) 1))
        (+ (adv s f c) (cwidth s f base (+ i 1) 0))))))

(defn highlight [s gw]
  ;; ADR-0240: the selection behind the glyph about to be written, then the
  ;; text colour back for it
  (do (sput s 422 11914737)
      (put-rect s (sw s 417) (- (sw s 418) (sw s 2045)) gw 16)
      (sput s 422 1118481)))

(defn place-body [s f cp j]
  ;; the glyph for body code point j at the cursor unless it passes the
  ;; bottom, the top inset (ADR-0238) or the viewport, drawn the offset
  ;; higher, with the highlight behind it when j is selected (ADR-0240);
  ;; advance
  (let [gi (glyph-of s f cp)
        gw (glyph-width s f gi)]
    (do (if (> (+ (sw s 418) 16) (sw s 421)) 0
          (if (< (sw s 418) (sw s 2044)) 0
            (if (> (+ (sw s 417) gw) (sw s 3)) 0
              (do (if (>= j (sw s 2034)) (highlight s gw) 0)
                  (put-glyph s (sw s 417) (- (sw s 418) (sw s 2045)) gi gw)))))
        (sput s 417 (+ (sw s 417) gw))
        0)))

(defn verbatim [s f base i pws]
  (let [c (at s base i)]
    (if (= c 0) 0
      (if (= (ws c) 1)
        (do (if (= pws 1) 0 (place-body s f 32 i))
            (verbatim s f base (+ i 1) 1))
        (do (place-body s f c i)
            (verbatim s f base (+ i 1) 0))))))

(defn word-end [s base i]
  (let [c (at s base i)]
    (if (= c 0) i (if (= c 10) i (if (= (ws c) 1) i (word-end s base (+ i 1)))))))

(defn word-width [s f base i e]
  (if (>= i e) 0 (+ (adv s f (at s base i)) (word-width s f base (+ i 1) e))))

(defn emit-run [s f base i e]
  (if (>= i e) 0
    (do (place-body s f (at s base i) i)
        (emit-run s f base (+ i 1) e))))

(defn put-word [s f base i e]
  ;; the first word of a line goes whatever its width; a next one joins after
  ;; a space if the line still fits in W = w - 28, else it opens the next line
  (do (if (= (sw s 417) (sw s 419)) 0
        (if (<= (+ (- (sw s 417) (sw s 419)) (+ (adv s f 32) (word-width s f base i e)))
                (- (sw s 430) 28))
          (place-body s f 32 (- i 1))
          (newline s)))
      (emit-run s f base i e)))

(defn pack [s f base i]
  (let [c (at s base i)]
    (if (= c 0) 0
      (if (= c 10)
        (do (newline s) (pack s f base (+ i 1)))
        (if (= (ws c) 1)
          (pack s f base (+ i 1))
          (let [e (word-end s base i)]
            (do (put-word s f base i e)
                (pack s f base e))))))))

(defn fits [s f base]
  ;; cssom: the collapsed text fits when its width is at most max(0, W)
  (let [cw (cwidth s f base 0 0)
        wm (- (sw s 430) 28)]
    (if (< wm 0)
      (if (= cw 0) 1 0)
      (if (<= cw wm) 1 0))))

(defn flow [s f base]
  (if (= (has-nl s base 0) 1)
    (pack s f base 0)
    (if (= (inked s base 0) 0) 0
      (if (= (fits s f base) 1)
        (verbatim s f base 0 0)
        (pack s f base 0)))))

(defn blen [s base i]
  (if (>= i 64) 64
    (if (= (sw s (+ base i)) 0) i (blen s base (+ i 1)))))

(defn sel-start [s id base]
  ;; ADR-0240: the first selected index of window id's body, 64 for none
  (if (= (sw s 2036) id)
    (let [n (blen s base 0)
          k (if (> (sw s 2037) n) n (sw s 2037))]
      (if (= k 0) 64 (- n k)))
    64))

(defn body-block [s f base x y]
  ;; Right limit, bottom, limit and window width are already in scratch.
  (do (sput s 417 x) (sput s 418 y) (sput s 419 x)
      (sput s 422 1118481)
      (flow s f base)))

;; --- launcher and close (ADR-0233) -------------------------------------------

(defn app-bit [k] (if (= k 1) 1 (if (= k 2) 2 (if (= k 3) 4 8))))

(defn button [s f k]
  (if (= (bit-and (sw s 31) (app-bit k)) 0) 0
    (let [x (+ 6 (* 102 (- k 1)))]
      (do (sput s 422 15001839)
          (put-rect s x 2 96 24)
          (sput s 420 (+ x 90)) (sput s 421 28)
          (sput s 426 0) (sput s 428 32)
          (text-block s f (+ 32 (* 32 (- k 1))) (+ x 6) 6)))))

(defn launcher [s f vw]
  (if (= (sw s 31) 0) 0
    (do (sput s 422 15593717)
        (put-rect s 0 0 vw 28)
        (button s f 1) (button s f 2) (button s f 3) (button s f 4))))

;; The dock follows the same retained-op path as the launcher and windows.
;; App colours and initial glyphs are presentation data; the native presenter
;; still receives only the rectangle and glyph operations produced here.
(defn dock-color [k]
  (if (= k 1) 3900159
    (if (= k 2) 3978018
      (if (= k 3) 10123472 14651230))))

(defn dock-letter [k]
  (if (= k 1) 77 (if (= k 2) 73 (if (= k 3) 89 65))))

(defn dock-icon [s f k vw vh]
  (if (= (bit-and (sw s 31) (app-bit k)) 0) 0
    (let [left (+ (quot (- vw 184) 2) 8 (* 44 (- k 1)))
          top (+ (- vh 52) 6)
          gi (glyph-of s f (dock-letter k))
          gw (glyph-width s f gi)]
      (do (sput s 422 (dock-color k))
          (put-rect s left top 36 36)
          (sput s 422 16777215)
          (put-glyph s (+ left (quot (- 36 gw) 2)) (+ top 10) gi gw)))))

(defn dock [s f vw vh]
  (if (= (sw s 31) 0) 0
    (let [left (quot (- vw 184) 2)
          top (- vh 52)]
      (do (sput s 422 14215167)
          (put-rect s left top 184 48)
          (dock-icon s f 1 vw vh)
          (dock-icon s f 2 vw vh)
          (dock-icon s f 3 vw vh)
          (dock-icon s f 4 vw vh)))))

(defn chrome [s w]
  (if (= (sw s 31) 0) 0 (if (< w 40) 0 1)))

(defn close-control [s f x y w]
  (if (= (chrome s w) 0) 0
    (let [gi (glyph-of s f 215)
          gw (glyph-width s f gi)]
      (do (sput s 422 15001839)
          (put-rect s (- (+ x w) 24) (+ y 6) 16 16)
          (sput s 422 1118481)
          (put-glyph s (+ (- (+ x w) 24) (quot (- 16 gw) 2)) (+ y 6) gi gw)))))

;; --- pointer (ADR-0236) ---------------------------------------------------------

(defn arrow-row [s x y r vw]
  ;; row r: the outline (r + 1 wide), then in rows 2..10 the fill (r - 1 wide
  ;; from x + 1); both cut at vw, a fill with no width left not drawn
  (do (sput s 422 1118481)
      (put-rect s x (+ y r) (if (< (+ r 1) (- vw x)) (+ r 1) (- vw x)) 1)
      (if (< r 2) 0
        (if (> r 10) 0
          (if (< (- vw x) 2) 0
            (do (sput s 422 16777215)
                (put-rect s (+ x 1) (+ y r)
                          (if (< (- r 1) (- vw (+ x 1))) (- r 1) (- vw (+ x 1))) 1)))))))

(defn arrow [s x y r]
  ;; rows r..11 above the viewport's bottom
  (if (> r 11) 0
    (if (>= (+ y r) (sw s 4)) 0
      (do (arrow-row s x y r (sw s 3))
          (arrow s x y (+ r 1))))))

(defn pointer [s]
  (if (= (sw s 2046) 0) 0
    (arrow s (- (sw s 2046) 1) (sw s 2047) 0)))

(defn pointer-ok [s vw vh]
  (if (= (sw s 2046) 0) 1
    (if (> (sw s 2046) vw) 0
      (if (>= (sw s 2047) vh) 0 1))))

;; --- windows ----------------------------------------------------------------

(defn body-rgb [focused] (if (= focused 1) 16777215 15659509))
(defn title-rgb [focused] (if (= focused 1) 14215167 14541546))

(defn window-shadow [s x y w h]
  ;; The shadow belongs to the outside edge only. A filled offset rectangle
  ;; hides the contents of every lower window it overlaps; these clipped
  ;; right and bottom strips keep the retained painter order intact.
  (let [vw (sw s 3)
        vh (sw s 4)
        right-room (- vw (+ x w))
        bottom-room (- vh (+ y h))
        right-width (if (> right-room 3) 3 right-room)
        bottom-height (if (> bottom-room 3) 3 bottom-room)]
    (do (if (> right-width 0)
          (do (sput s 422 10137540)
              (put-rect s (+ x w) (+ y 3) right-width (- h 3)))
          0)
        (if (> bottom-height 0)
          (do (sput s 422 10137540)
              (put-rect s (+ x 3) (+ y h) (- w 3) bottom-height))
          0))))

(defn emit-window [s f k]
  (let [b (+ 5 (* k 5))
        id (sw s b)
        x (sw s (+ b 1))
        y (sw s (+ b 2))
        w (sw s (+ b 3))
        h (sw s (+ b 4))
        focused (if (= id (sw s 2)) 1 0)]
    (do (window-shadow s x y w h)
        (sput s 422 (body-rgb focused))
        (put-rect s x y w h)
        (sput s 422 (title-rgb focused))
        (put-rect s x y w 28)
        ;; title: one line, clipped at the right inset (or before the close
        ;; control), inside the titlebar
        (sput s 420 (- (+ x w) (+ 8 (* 20 (chrome s w))))) (sput s 421 (+ y 28))
        (sput s 426 0) (sput s 428 32)
        (text-block s f (+ 32 (* 32 (- id 1))) (+ x 8) (+ y 6))
        (close-control s f x y w)
        ;; body: cssom's flow from (x + 14, y + 42), cut at the bottom inset;
        ;; the composition after it wraps at x + w - 14 (0 when that is left
        ;; of the viewport: every glyph then wraps, as a negative limit would).
        ;; ADR-0238: laid out unscrolled, so the insets move down by the
        ;; window's offset and each op is written the offset higher.
        (sput s 2045 (sw s (+ 2039 id)))
        (sput s 2044 (+ (+ y 36) (sw s 2045)))
        (sput s 420 (if (< (+ x w) 14) 0 (- (+ x w) 14)))
        (sput s 421 (+ (- (+ y h) 8) (sw s 2045)))
        (sput s 426 1) (sput s 428 64) (sput s 430 w)
        ;; ADR-0240: only the focused window's selection is drawn
        (sput s 2034 (if (= focused 1) (sel-start s id (+ 160 (* 64 (- id 1)))) 64))
        (body-block s f (+ 160 (* 64 (- id 1))) (+ x 14) (+ y 42))
        ;; the composition, only in the focused window, after its body; the
        ;; caret only while nothing is selected (ADR-0240)
        (if (= focused 1)
          (do (lay-comp s f 0 (+ (sw s 445) (sw s 433)))
              (if (= (sw s 2034) 64) (caret s) 0))
          0))))

(defn emit [s f k]
  (if (>= k (sw s 1)) 0
    (do (emit-window s f k)
        (emit s f (+ k 1)))))

;; --- admission --------------------------------------------------------------

(defn has-id [s n k id]
  (if (>= k n) 0
    (if (= (sw s (+ 5 (* k 5))) id) 1
      (has-id s n (+ k 1) id))))

(defn focus-ok [s n]
  (if (= n 0)
    (if (= (sw s 2) 0) 1 0)
    (has-id s n 0 (sw s 2))))

(defn ids-ok [s n k]
  (if (>= k n) 1
    (let [id (sw s (+ 5 (* k 5)))]
      (if (< id 1) 0
        (if (> id 4) 0
          (ids-ok s n (+ k 1)))))))

(defn rect-ok [s k vw vh]
  (let [b (+ 5 (* k 5))
        x (sw s (+ b 1))
        y (sw s (+ b 2))
        w (sw s (+ b 3))
        h (sw s (+ b 4))]
    (if (< w 1) 0
      (if (< h 29) 0
        (if (> (+ x w) vw) 0
          (if (> (+ y h) vh) 0 1))))))

(defn rects-ok [s n k vw vh]
  (if (>= k n) 1
    (if (= (rect-ok s k vw vh) 0) 0
      (rects-ok s n (+ k 1) vw vh))))

(defn scroll-ok [s id]
  (if (> id 4) 1
    (if (> (sw s (+ 2039 id)) 65535) 0
      (scroll-ok s (+ id 1)))))

(defn aiueos-browser-frame2 [s sb f fb]
  (if (= s 0) -1
    (if (= f 0) -1
      (if (not (= sb 8192)) -1
        (let [n (sw s 1)
              vw (sw s 3)
              vh (sw s 4)]
          (if (not (= (sw s 0) 1)) -2
            (if (> n 4) -2
                (if (= (ids-ok s n 0) 0) -7
                  (if (= (focus-ok s n) 0) -3
                    (if (= (rects-ok s n 0 vw vh) 0) -4
                      (if (> (sw s 433) 8) -8
                      (if (> (sw s 445) 32) -8
                      (if (> (sw s 31) 15) -9
                      (if (= (pointer-ok s vw vh) 0) -10
                      (if (= (scroll-ok s 1) 0) -11
                      (if (= (font-ok s f fb) 0) -6
                        (do (sput s 416 0)
                            (sput s 427 0)
                            (sput s 422 9418200)
                            (put-rect s 0 0 vw vh)
                            (launcher s f vw)
                            (emit s f 0)
                            (dock s f vw vh)
                            (pointer s)
                            (if (= (sw s 427) 1) -5 (sw s 416)))))))))))))))))))

(defn main [] 0)
