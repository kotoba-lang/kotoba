 :host {:model "MacBookPro18,4", :cpu "Apple M1 Max", :os "Darwin 25.4.0 arm64"}
 :commit "7bcfbd73a0984b8c0af90c5e11bd7245dbc1042d"
 :verdicts {"create" {:green? true, :reason :marker, :marker "AIUEOS_FS_CREATE_OK"},
            "rename" {:green? true, :reason :marker, :marker "AIUEOS_FS_RENAME_OK"},
            "delete" {:green? true, :reason :marker, :marker "AIUEOS_FS_DELETE_OK"},
            "full-reported-not-corrupted" {:green? true, :reason :marker, :marker "AIUEOS_FS_FULL_REPORTED not-corrupted — the create that does not fit reports the full condition and writes nothing; the table stays valid and the cleanup deletes succeed afterwards"},
            "atomic-table-commit" {:green? true, :reason :marker, :marker "AIUEOS_FS_ATOMIC_OK table-readback-ab — every operation writes the inactive table slot with the next sequence and verifies the read-back before it is live"}}
