(ns synack-probe
  (:export [main]))

(defn seq-core-wrap [x] (bit-and x 4294967295))
(def src-ip 172818433)
(def dst-ip 172818442)
(def iss 2715820034)

;; the same primitives tcp_stream.kotoba restates
(defn frame-be16 [f o]
  (+ (* (kernel-load-u8-4k f 4096 o) 256) (kernel-load-u8-4k f 4096 (+ o 1))))
(defn frame-be32 [f o]
  (+ (* (kernel-load-u8-4k f 4096 o) 16777216)
     (* (kernel-load-u8-4k f 4096 (+ o 1)) 65536)
     (* (kernel-load-u8-4k f 4096 (+ o 2)) 256)
     (kernel-load-u8-4k f 4096 (+ o 3))))
(defn cw [f b l o]
  (if (>= o l) 0
    (+ (* (kernel-load-u8-4k f 4096 (+ b o)) 256)
       (if (< (+ o 1) l) (kernel-load-u8-4k f 4096 (+ b o 1)) 0))))
(defn csum [f b l o t]
  (if (>= o l) t (csum f b l (+ o 2) (+ t (cw f b l o)))))
(defn fold [t]
  (if (<= t 65535) t (fold (+ (bit-and t 65535) (quot t 65536)))))
(defn pseudo [s d l]
  (+ (+ (quot s 65536) (bit-and s 65535))
     (+ (+ (quot d 65536) (bit-and d 65535)) (+ 6 l))))

(defn main []
  (let [f (kernel-subregion 4096 549755809792 8192 4096)
        _st1 (kernel-store-u8-4k f 4096 0 128)
        _st2 (kernel-store-u8-4k f 4096 1 105)
        _st3 (kernel-store-u8-4k f 4096 2 26)
        _st4 (kernel-store-u8-4k f 4096 3 23)
        _st5 (kernel-store-u8-4k f 4096 4 79)
        _st6 (kernel-store-u8-4k f 4096 5 21)
        _st7 (kernel-store-u8-4k f 4096 6 112)
        _st8 (kernel-store-u8-4k f 4096 7 112)
        _st9 (kernel-store-u8-4k f 4096 8 252)
        _st10 (kernel-store-u8-4k f 4096 9 11)
        _st11 (kernel-store-u8-4k f 4096 10 182)
        _st12 (kernel-store-u8-4k f 4096 11 50)
        _st13 (kernel-store-u8-4k f 4096 12 8)
        _st14 (kernel-store-u8-4k f 4096 13 0)
        _st15 (kernel-store-u8-4k f 4096 14 69)
        _st16 (kernel-store-u8-4k f 4096 15 0)
        _st17 (kernel-store-u8-4k f 4096 16 0)
        _st18 (kernel-store-u8-4k f 4096 17 40)
        _st19 (kernel-store-u8-4k f 4096 18 0)
        _st20 (kernel-store-u8-4k f 4096 19 0)
        _st21 (kernel-store-u8-4k f 4096 20 64)
        _st22 (kernel-store-u8-4k f 4096 21 0)
        _st23 (kernel-store-u8-4k f 4096 22 64)
        _st24 (kernel-store-u8-4k f 4096 23 6)
        _st25 (kernel-store-u8-4k f 4096 24 38)
        _st26 (kernel-store-u8-4k f 4096 25 44)
        _st27 (kernel-store-u8-4k f 4096 26 10)
        _st28 (kernel-store-u8-4k f 4096 27 77)
        _st29 (kernel-store-u8-4k f 4096 28 0)
        _st30 (kernel-store-u8-4k f 4096 29 1)
        _st31 (kernel-store-u8-4k f 4096 30 10)
        _st32 (kernel-store-u8-4k f 4096 31 77)
        _st33 (kernel-store-u8-4k f 4096 32 0)
        _st34 (kernel-store-u8-4k f 4096 33 10)
        _st35 (kernel-store-u8-4k f 4096 34 32)
        _st36 (kernel-store-u8-4k f 4096 35 251)
        _st37 (kernel-store-u8-4k f 4096 36 192)
        _st38 (kernel-store-u8-4k f 4096 37 3)
        _st39 (kernel-store-u8-4k f 4096 38 26)
        _st40 (kernel-store-u8-4k f 4096 39 43)
        _st41 (kernel-store-u8-4k f 4096 40 60)
        _st42 (kernel-store-u8-4k f 4096 41 64)
        _st43 (kernel-store-u8-4k f 4096 42 161)
        _st44 (kernel-store-u8-4k f 4096 43 224)
        _st45 (kernel-store-u8-4k f 4096 44 32)
        _st46 (kernel-store-u8-4k f 4096 45 3)
        _st47 (kernel-store-u8-4k f 4096 46 80)
        _st48 (kernel-store-u8-4k f 4096 47 18)
        _st49 (kernel-store-u8-4k f 4096 48 1)
        _st50 (kernel-store-u8-4k f 4096 49 0)
        _st51 (kernel-store-u8-4k f 4096 50 160)
        _st52 (kernel-store-u8-4k f 4096 51 224)
        _st53 (kernel-store-u8-4k f 4096 52 0)
        _st54 (kernel-store-u8-4k f 4096 53 0)
        _st55 (kernel-store-u8-4k f 4096 54 0)
        _st56 (kernel-store-u8-4k f 4096 55 0)
        _st57 (kernel-store-u8-4k f 4096 56 0)
        _st58 (kernel-store-u8-4k f 4096 57 0)
        _st59 (kernel-store-u8-4k f 4096 58 0)
        _st60 (kernel-store-u8-4k f 4096 59 0)
        _st61 (kernel-store-u8-4k f 4096 60 0)
        _st62 (kernel-store-u8-4k f 4096 61 0)
        _st63 (kernel-store-u8-4k f 4096 62 0)
        _st64 (kernel-store-u8-4k f 4096 63 0)
        eth-ok (if (and (>= 60 54) (= (frame-be16 f 12) 2048)) 1 0)
        shape-ok (if (not (= eth-ok 1))
                   0
                   (if (not (= (kernel-load-u8-4k f 4096 14) 69))
                     0
                     (if (not (= (kernel-load-u8-4k f 4096 23) 6))
                       0
                       (if (not (= (frame-be32 f 26) src-ip))
                         0
                         (if (= (frame-be32 f 30) dst-ip) 1 0)))))
        want-ack (seq-core-wrap (+ iss 1))
        ports-ok (if (not (= shape-ok 1))
                   0
                   (if (not (= (frame-be16 f 34) 8443))
                     0
                     (if (not (= (frame-be16 f 36) 49155))
                       0
                       (if (= (frame-be32 f 42) want-ack) 1 0))))
        ipv4-ok (if (not (= ports-ok 1))
                  0
                  (if (= (- 65535 (fold (csum f 14 20 0 0))) 0) 1 0))
        tcp-ok (if (not (= ipv4-ok 1))
                 0
                 (if (= (- 65535 (fold (csum f 34 20 0 (pseudo src-ip dst-ip 20))))
                        0)
                   1
                   0))
        gate (if (not (= eth-ok 1))
               1
               (if (not (= shape-ok 1))
                 2
                 (if (not (= ports-ok 1))
                   3
                   (if (not (= ipv4-ok 1))
                     4
                     (if (not (= tcp-ok 1)) 5 0))))]
    (kernel-out-u32 244 gate))))
