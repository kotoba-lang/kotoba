;; Unity fragment: staged after the exact probe.kotoba core and Amu 00/01/02.
;; Writes a small simulated medium to an FD3-scoped regular file, then opens
;; and reads its persisted bytes through FS2. Never accepts a device path.
(defn- disk-read [path :string len :i64] :vector-i64
  (let [request (string-concat (io-fs2-header 69 path)
                  (string-concat "0:" (mem-u2dec len)))
        data (vector-i64-from-bytes
               (typed-cap-call :fs/app-data :string :bytes request))]
    (if (and (= (vector-count data) (+ 5 len))
             (= (vector-at data 0) 0) (= (vector-at data 1) 70)
             (= (vector-at data 2) 83) (= (vector-at data 3) 50)
             (= (vector-at data 4) 0))
      (loop [i 0 out (vector-alloc len)]
        (if (= i len) out
          (recur (+ i 1) (vector-assoc! out i (vector-at data (+ 5 i))))))
      (vector-alloc 0))))

(defn- disk-case [path :string real :i64] :i64
  (let [buf (fixture-write-all (vector-alloc (* real 4)) 16 real 17 0)
        write (io-write-bytes buf path 0 (* real 4))
        actual (disk-read path (* real 4))]
    (if (not= (vector-count actual) (* real 4)) -1
      (fixture-read-all actual 16 real 17 0 0))))

(defn- seed-main [] :i64
  (let [honest (disk-case "honest.fixture" 16)
        wrap (disk-case "wrap.fixture" 4)]
    (if (and (= honest 0) (> wrap 0))
      (let [w (io-write-bytes [79 75 10] (io-arg 0) 0 3)] 0)
      1)))
