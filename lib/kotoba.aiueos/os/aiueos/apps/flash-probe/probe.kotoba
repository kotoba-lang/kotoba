(ns aiueos.apps.flash-probe
  (:export [main]))

;; Diagnostic sampling core. Sector addresses are logical block numbers, not
;; byte offsets. A real host must supply exclusive I/O and its own consent.
;; The largest admitted geometry is 2^62 sectors, keeping doubling in i64.
;; Result 0 = inconclusive; 1 = observed mismatch; 2 = I/O error;
;; 3 = invalid request. A sample match never proves capacity.
(defn geometry-valid [sectors]
  (and (> sectors 1) (<= sectors 4611686018427387904)))

(defn power-count-from [n p count]
  (if (>= p n) count
    (if (> p (quot n 2)) (+ count 1)
      (power-count-from n (* p 2) (+ count 1)))))

(defn power-count [n]
  (if (geometry-valid n) (power-count-from n 1 0) 0))

(defn sample-count [n]
  (if (geometry-valid n) (+ 2 (power-count n)) 0))

(defn power-at [i value]
  (if (= i 0) value (power-at (- i 1) (* value 2))))

(defn sample-at [n i]
  (let [count (sample-count n)]
    (if (or (< i 0) (>= i count)) -1
      (if (= i 0) 0
        (if (= i (- count 1)) (- n 1)
          (power-at (- i 1) 1))))))

;; Last sector can duplicate a power of two. The host MUST coalesce duplicate
;; addresses before writing; the expected token is based on that address,
;; not its position in the sample list.  A real implementation must use
;; full-block, per-run unpredictable patterns, and flush + reopen/readback.
(defn sampled-result [requested completed mismatches io-errors]
  (if (or (< requested 1) (> requested 64) (< completed 0) (> completed requested)
          (< mismatches 0) (< io-errors 0) (> mismatches completed)
          (> io-errors (- completed mismatches))) 3
    (if (> io-errors 0) 2
      (if (> mismatches 0) 1 0))))

;; Pure wraparound model: after all planned writes, find the last token at
;; the same physical address as the requested sample.  No device is opened.
(defn model-last [n real wanted i last]
  (if (>= i (sample-count n)) last
    (let [addr (sample-at n i)]
      (model-last n real wanted (+ i 1)
                  (if (= (mod addr real) (mod wanted real)) (+ addr 1) last)))))

(defn model-mismatches [n real i count]
  (if (>= i (sample-count n)) count
    (let [addr (sample-at n i)
          observed (model-last n real addr 0 0)]
      (model-mismatches n real (+ i 1)
                        (if (= observed (+ addr 1)) count (+ count 1))))))

;; Native self-test returns the number of failed assertions. The host must
;; execute this actual compiled program, not a reimplementation of the core.
(defn main [] :i64
  (+ (if (= (sample-count 16) 6) 0 1)
     (if (= (sample-at 16 0) 0) 0 1)
     (if (= (sample-at 16 4) 8) 0 1)
     (if (= (sample-at 16 5) 15) 0 1)
     (if (= (sample-at 16 6) -1) 0 1)
     (if (= (sample-count 1) 0) 0 1)
     (if (= (sample-count 4611686018427387905) 0) 0 1)
     (if (= (model-mismatches 16 16 0 0) 0) 0 1)
     (if (> (model-mismatches 16 4 0 0) 0) 0 1)
     (if (= (model-mismatches 17 17 0 0) 0) 0 1)
     (if (= (sampled-result 6 6 1 0) 1) 0 1)
     (if (= (sampled-result 6 6 0 1) 2) 0 1)
     (if (= (sampled-result 6 3 0 0) 0) 0 1)
     (if (= (sampled-result 6 6 0 0) 0) 0 1)
     (if (= (sampled-result 6 7 0 0) 3) 0 1)
     (if (= (sampled-result 65 0 0 0) 3) 0 1)
     (if (= (sampled-result 6 6 6 1) 3) 0 1)
     (if (= (sample-count 4611686018427387904) 64) 0 1)
     (if (> (model-mismatches 4096000000 16777216 0 0) 0) 0 1)
     (if (= (model-mismatches 4096000000 4096000000 0 0) 0) 0 1)))
