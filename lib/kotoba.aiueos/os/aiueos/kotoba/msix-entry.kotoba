;; The MSI-X vector programming of kernel/pci.c's setup_rng_msix and setup_blk_msix in Kotoba (JUN-598): one MSI-X
;; table entry (struct msix_entry: address_low u32 @0, address_high @4, data @8, vector_control @12) and the virtio
;; common configuration (queue_msix_vector u16 @26 of the 56-byte struct virtio_common_cfg), both device memory.
;;
;; program(entry, 16, cfg, 56, address, data, vector): masks the entry (vector_control = 1), writes its message --
;; address_low = address, address_high = 0, data = data -- then assigns the selected queue to the vector
;; (queue_msix_vector = vector) and reads it back. Unmasks the entry (vector_control = 0) and answers 1 only when the
;; device kept the vector; answers 2 with the entry left masked when it did not. One access of each register's own width,
;; in the C's order. Answers 0 with nothing accessed for a null pointer, a wrong length, a vector past 2047 (the table's
;; limit) or an address or data past 32 bits.
(ns aiueos.msix-entry (:export [kotoba_aiueos_msix_program]))
(defn kotoba_aiueos_msix_program [entry :i64 en :i64 cfg :i64 cn :i64 address :i64 data :i64 vector :i64] :i64
  (if (or (= entry 0) (= cfg 0) (not= en 16) (not= cn 56) (< vector 0) (> vector 2047)
          (< address 0) (> address 4294967295) (< data 0) (> data 4294967295)) 0
    (let [w1 (kernel-store-u32 entry en 12 1) w2 (kernel-store-u32 entry en 0 address)
          w3 (kernel-store-u32 entry en 4 0) w4 (kernel-store-u32 entry en 8 data)
          w5 (kernel-store-u16 cfg cn 26 vector) back (kernel-load-u16 cfg cn 26)]
      (if (not= back vector) (+ 2 (* 0 (+ (+ w1 w2) (+ w3 (+ w4 w5)))))
        (let [w6 (kernel-store-u32 entry en 12 0)] (+ 1 (* 0 (+ w6 (+ (+ w1 w2) (+ w3 (+ w4 w5)))))))))))
