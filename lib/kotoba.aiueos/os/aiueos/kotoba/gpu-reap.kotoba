;; One used-ring entry of gpu_ctrl's completion walk of kernel/pci.c in Kotoba (JUN-598): the virtio-gpu control
;; queue, its used ring one 4 KiB page (struct virtq_used, packed, little-endian), the response buffer led by a
;; struct virtio_gpu_ctrl_header (type u32 @0).
;;
;; reap(used, 4096, resp, 24, state, resp-len, expect): state is the driver's consumed position (bits 0..15) and
;; whether this command's response was already seen (bit 16). Reads used element position % 4 (id u32 @4 + 8*slot,
;; length u32 @8 + 8*slot) and answers what the C does with it: 1 when the id is 2, the event buffer; else, when the
;; id is 0 and no response was seen yet, the response -- 3 when its length is under the 24-byte header, 4 when it is
;; past resp-len, 5 when the header's type is not expect (read only then), 2 when it is the expected response; 6 for
;; any other entry. Answers 0 with nothing read for a null pointer, a wrong length, a state past 17 bits, or resp-len
;; or expect past 32 bits.
(ns aiueos.gpu-reap (:export [kotoba_aiueos_gpu_reap]))
(defn- response [r :i64 rn :i64 len :i64 limit :i64 expect :i64] :i64
  (cond (< len 24) 3
        (> len limit) 4
        (not= (kernel-load-u32 r rn 0) expect) 5
        :else 2))
(defn- classify [r :i64 rn :i64 elem :i64 seen :i64 limit-expect :i64] :i64
  (let [id (u64-shift-right elem 32) len (bit-and elem 4294967295)]
    (cond (= id 2) 1
          (and (= id 0) (= seen 0)) (response r rn len (bit-and limit-expect 4294967295) (u64-shift-right limit-expect 32))
          :else 6)))
(defn- elem-at [u :i64 un :i64 slot :i64] :i64
  (let [id (kernel-load-u32-16k u un (+ 4 (* 8 slot))) len (kernel-load-u32-16k u un (+ 8 (* 8 slot)))]
    (bit-or (i64-shift-left id 32) len)))
(defn kotoba_aiueos_gpu_reap [used :i64 un :i64 resp :i64 rn :i64 state :i64 resp-len :i64 expect :i64] :i64
  (if (or (= used 0) (= resp 0) (not= un 4096) (not= rn 24) (< state 0) (> state 131071)
          (< resp-len 0) (> resp-len 4294967295) (< expect 0) (> expect 4294967295)) 0
    (let [elem (elem-at used un (bit-and state 3))]
      (classify resp rn elem (u64-shift-right state 16) (bit-or resp-len (i64-shift-left expect 32))))))
