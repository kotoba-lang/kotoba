;; The ClientHello and ServerHello of kernel/tls13.c in Kotoba (JUN-553): clienthello_build's record, byte for byte (the 157-byte
;; template, the host / random / key patches in the C's order, the key overwriting the template's last 32 bytes), and the validation
;; half of parse_serverhello (the C keeps transcript_add and derive_hs_keys). Every input and output is a (base, length) region; a
;; uint32_t length with a non-zero upper half is refused (0). The template is literal stores: a string literal would be a host call.
;; Private helpers take at most five values, so copy loops pack (destination base, step) into one integer.
(ns aiueos.tls13-hello
  (:export [kotoba_aiueos_tls13_clienthello kotoba_aiueos_tls13_serverhello_parse]))
(defn- canonical? [x :i64] :bool (= (u64-shift-right x 32) 0))
(defn- st [o :i64 on :i64 i :i64 v :i64] :i64 (kernel-store-u8 o on i v))
(defn- b [p :i64 n :i64 i :i64] :i64 (kernel-load-u8-16k p n i))
(defn- be16 [p :i64 n :i64 i :i64] :i64 (+ (* 256 (b p n i)) (b p n (+ i 1))))
;; o[base + i] = s[i] for i < sn, q = base << 32 | i
(defn- copy-at [o :i64 on :i64 s :i64 sn :i64 q :i64] :i64
  (let [base (u64-shift-right q 32) i (bit-and q 4294967295)]
    (if (>= i sn) 0
      (let [w (kernel-store-u8 o on (+ base i) (kernel-load-u8 s sn i))] (copy-at o on s sn (+ (+ q 1) (* 0 w)))))))
(defn- put16 [o :i64 on :i64 i :i64 v :i64] :i64 (+ (st o on i (bit-and (u64-shift-right v 8) 255)) (st o on (+ i 1) (bit-and v 255))))
;; host: the SNI; random: 32 bytes, or a 0-length region to keep the template's; key: the 32-byte X25519 public key.
;; Returns the record length, or 0.
(defn kotoba_aiueos_tls13_clienthello [host :i64 host-len :i64 random :i64 random-len :i64 key :i64 key-len :i64 out :i64 out-len :i64] :i64
  (if (or (not (canonical? host-len)) (not (canonical? random-len)) (not (canonical? key-len)) (not (canonical? out-len))
          (> host-len 255) (> (+ 145 host-len) 256) (> (+ 145 host-len) out-len) (not= key-len 32)
          (and (not= random-len 0) (not= random-len 32))) 0
    (let [total (+ 145 host-len)
        h0 (st out out-len 0 22)
        h1 (st out out-len 1 3)
        h2 (st out out-len 2 1)
        h3 (st out out-len 3 0)
        h4 (st out out-len 4 152)
        h5 (st out out-len 5 1)
        h6 (st out out-len 6 0)
        h7 (st out out-len 7 0)
        h8 (st out out-len 8 148)
        h9 (st out out-len 9 3)
        h10 (st out out-len 10 3)
        h11 (st out out-len 11 161)
        h12 (st out out-len 12 224)
        h13 (st out out-len 13 161)
        h14 (st out out-len 14 224)
        h15 (st out out-len 15 161)
        h16 (st out out-len 16 224)
        h17 (st out out-len 17 161)
        h18 (st out out-len 18 224)
        h19 (st out out-len 19 161)
        h20 (st out out-len 20 224)
        h21 (st out out-len 21 161)
        h22 (st out out-len 22 224)
        h23 (st out out-len 23 161)
        h24 (st out out-len 24 224)
        h25 (st out out-len 25 161)
        h26 (st out out-len 26 224)
        h27 (st out out-len 27 161)
        h28 (st out out-len 28 224)
        h29 (st out out-len 29 161)
        h30 (st out out-len 30 224)
        h31 (st out out-len 31 161)
        h32 (st out out-len 32 224)
        h33 (st out out-len 33 161)
        h34 (st out out-len 34 224)
        h35 (st out out-len 35 161)
        h36 (st out out-len 36 224)
        h37 (st out out-len 37 161)
        h38 (st out out-len 38 224)
        h39 (st out out-len 39 161)
        h40 (st out out-len 40 224)
        h41 (st out out-len 41 161)
        h42 (st out out-len 42 224)
        h43 (st out out-len 43 0)
        h44 (st out out-len 44 0)
        h45 (st out out-len 45 2)
        h46 (st out out-len 46 19)
        h47 (st out out-len 47 1)
        h48 (st out out-len 48 1)
        h49 (st out out-len 49 0)
        h50 (st out out-len 50 0)
        h51 (st out out-len 51 105)
        h52 (st out out-len 52 0)
        h53 (st out out-len 53 0)
        h54 (st out out-len 54 0)
        h55 (st out out-len 55 17)
        h56 (st out out-len 56 0)
        h57 (st out out-len 57 15)
        h58 (st out out-len 58 0)
        h59 (st out out-len 59 0)
        h60 (st out out-len 60 12)
        p3 (put16 out out-len 3 (- total 5))
        p6 (st out out-len 6 (bit-and (u64-shift-right (- total 9) 16) 255))
        p7 (st out out-len 7 (bit-and (u64-shift-right (- total 9) 8) 255))
        p8 (st out out-len 8 (bit-and (- total 9) 255))
        r (if (= random-len 32) (copy-at out out-len random random-len (* 11 4294967296)) 0)
        p50 (put16 out out-len 50 (+ 93 host-len))
        p54 (put16 out out-len 54 (+ 5 host-len))
        p56 (put16 out out-len 56 (+ 3 host-len))
        p59 (put16 out out-len 59 host-len)
        hc (copy-at out out-len host host-len (* 61 4294967296))
        t0 (st out out-len (+ (+ 61 host-len) 0) 0)
        t1 (st out out-len (+ (+ 61 host-len) 1) 10)
        t2 (st out out-len (+ (+ 61 host-len) 2) 0)
        t3 (st out out-len (+ (+ 61 host-len) 3) 4)
        t4 (st out out-len (+ (+ 61 host-len) 4) 0)
        t5 (st out out-len (+ (+ 61 host-len) 5) 2)
        t6 (st out out-len (+ (+ 61 host-len) 6) 0)
        t7 (st out out-len (+ (+ 61 host-len) 7) 29)
        t8 (st out out-len (+ (+ 61 host-len) 8) 0)
        t9 (st out out-len (+ (+ 61 host-len) 9) 13)
        t10 (st out out-len (+ (+ 61 host-len) 10) 0)
        t11 (st out out-len (+ (+ 61 host-len) 11) 8)
        t12 (st out out-len (+ (+ 61 host-len) 12) 0)
        t13 (st out out-len (+ (+ 61 host-len) 13) 6)
        t14 (st out out-len (+ (+ 61 host-len) 14) 4)
        t15 (st out out-len (+ (+ 61 host-len) 15) 3)
        t16 (st out out-len (+ (+ 61 host-len) 16) 8)
        t17 (st out out-len (+ (+ 61 host-len) 17) 4)
        t18 (st out out-len (+ (+ 61 host-len) 18) 4)
        t19 (st out out-len (+ (+ 61 host-len) 19) 1)
        t20 (st out out-len (+ (+ 61 host-len) 20) 0)
        t21 (st out out-len (+ (+ 61 host-len) 21) 43)
        t22 (st out out-len (+ (+ 61 host-len) 22) 0)
        t23 (st out out-len (+ (+ 61 host-len) 23) 3)
        t24 (st out out-len (+ (+ 61 host-len) 24) 2)
        t25 (st out out-len (+ (+ 61 host-len) 25) 3)
        t26 (st out out-len (+ (+ 61 host-len) 26) 4)
        t27 (st out out-len (+ (+ 61 host-len) 27) 0)
        t28 (st out out-len (+ (+ 61 host-len) 28) 16)
        t29 (st out out-len (+ (+ 61 host-len) 29) 0)
        t30 (st out out-len (+ (+ 61 host-len) 30) 11)
        t31 (st out out-len (+ (+ 61 host-len) 31) 0)
        t32 (st out out-len (+ (+ 61 host-len) 32) 9)
        t33 (st out out-len (+ (+ 61 host-len) 33) 8)
        t34 (st out out-len (+ (+ 61 host-len) 34) 104)
        t35 (st out out-len (+ (+ 61 host-len) 35) 116)
        t36 (st out out-len (+ (+ 61 host-len) 36) 116)
        t37 (st out out-len (+ (+ 61 host-len) 37) 112)
        t38 (st out out-len (+ (+ 61 host-len) 38) 47)
        t39 (st out out-len (+ (+ 61 host-len) 39) 49)
        t40 (st out out-len (+ (+ 61 host-len) 40) 46)
        t41 (st out out-len (+ (+ 61 host-len) 41) 49)
        t42 (st out out-len (+ (+ 61 host-len) 42) 0)
        t43 (st out out-len (+ (+ 61 host-len) 43) 51)
        t44 (st out out-len (+ (+ 61 host-len) 44) 0)
        t45 (st out out-len (+ (+ 61 host-len) 45) 38)
        t46 (st out out-len (+ (+ 61 host-len) 46) 0)
        t47 (st out out-len (+ (+ 61 host-len) 47) 36)
        t48 (st out out-len (+ (+ 61 host-len) 48) 0)
        t49 (st out out-len (+ (+ 61 host-len) 49) 29)
        t50 (st out out-len (+ (+ 61 host-len) 50) 0)
        t51 (st out out-len (+ (+ 61 host-len) 51) 32)
        t52 (st out out-len (+ (+ 61 host-len) 52) 1)
        t53 (st out out-len (+ (+ 61 host-len) 53) 2)
        t54 (st out out-len (+ (+ 61 host-len) 54) 3)
        t55 (st out out-len (+ (+ 61 host-len) 55) 4)
        t56 (st out out-len (+ (+ 61 host-len) 56) 5)
        t57 (st out out-len (+ (+ 61 host-len) 57) 6)
        t58 (st out out-len (+ (+ 61 host-len) 58) 7)
        t59 (st out out-len (+ (+ 61 host-len) 59) 8)
        t60 (st out out-len (+ (+ 61 host-len) 60) 9)
        t61 (st out out-len (+ (+ 61 host-len) 61) 10)
        t62 (st out out-len (+ (+ 61 host-len) 62) 11)
        t63 (st out out-len (+ (+ 61 host-len) 63) 12)
        t64 (st out out-len (+ (+ 61 host-len) 64) 13)
        t65 (st out out-len (+ (+ 61 host-len) 65) 14)
        t66 (st out out-len (+ (+ 61 host-len) 66) 15)
        t67 (st out out-len (+ (+ 61 host-len) 67) 16)
        t68 (st out out-len (+ (+ 61 host-len) 68) 17)
        t69 (st out out-len (+ (+ 61 host-len) 69) 18)
        t70 (st out out-len (+ (+ 61 host-len) 70) 19)
        t71 (st out out-len (+ (+ 61 host-len) 71) 20)
        t72 (st out out-len (+ (+ 61 host-len) 72) 21)
        t73 (st out out-len (+ (+ 61 host-len) 73) 22)
        t74 (st out out-len (+ (+ 61 host-len) 74) 23)
        t75 (st out out-len (+ (+ 61 host-len) 75) 24)
        t76 (st out out-len (+ (+ 61 host-len) 76) 25)
        t77 (st out out-len (+ (+ 61 host-len) 77) 26)
        t78 (st out out-len (+ (+ 61 host-len) 78) 27)
        t79 (st out out-len (+ (+ 61 host-len) 79) 28)
        t80 (st out out-len (+ (+ 61 host-len) 80) 29)
        t81 (st out out-len (+ (+ 61 host-len) 81) 30)
        t82 (st out out-len (+ (+ 61 host-len) 82) 31)
        t83 (st out out-len (+ (+ 61 host-len) 83) 32)
        kc (copy-at out out-len key key-len (* (+ 113 host-len) 4294967296))]
      (+ total (* 0 (+ (+ h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13 h14 h15 h16 h17 h18 h19 h20 h21 h22 h23 h24 h25 h26 h27 h28 h29 h30 h31 h32 h33 h34 h35 h36 h37 h38 h39 h40 h41 h42 h43 h44 h45 h46 h47 h48 h49 h50 h51 h52 h53 h54 h55 h56 h57 h58 h59 h60) (+ p3 (+ p6 (+ p7 (+ p8 (+ r (+ p50 (+ p54 (+ p56 (+ p59 (+ hc (+ (+ t0 t1 t2 t3 t4 t5 t6 t7 t8 t9 t10 t11 t12 t13 t14 t15 t16 t17 t18 t19 t20 t21 t22 t23 t24 t25 t26 t27 t28 t29 t30 t31 t32 t33 t34 t35 t36 t37 t38 t39 t40 t41 t42 t43 t44 t45 t46 t47 t48 t49 t50 t51 t52 t53 t54 t55 t56 t57 t58 t59 t60 t61 t62 t63 t64 t65 t66 t67 t68 t69 t70 t71 t72 t73 t74 t75 t76 t77 t78 t79 t80 t81 t82 t83) kc)))))))))))))))))
;; the extension walk: q = off << 32 | end; acc = got-1.3 | got-share << 1 | (offset of the last share's data) << 8; -1 when an
;; extension overruns the block
(defn- walk [hs :i64 n :i64 q :i64 acc :i64] :i64
  (let [off (u64-shift-right q 32) end (bit-and q 4294967295)]
    (if (> (+ off 4) end) acc
      (let [typ (be16 hs n off) elen (be16 hs n (+ off 2)) ed (+ off 4)]
        (if (> (+ (+ off 4) elen) end) -1
          (let [v13 (if (and (= typ 43) (>= elen 2)) (and (= (b hs n (- (+ ed elen) 2)) 3) (= (b hs n (- (+ ed elen) 1)) 4)) false)
                share (if (and (= typ 51) (>= elen 36)) (and (= (be16 hs n ed) 29) (= (be16 hs n (+ ed 2)) 32)) false)
                a1 (if v13 (bit-or acc 1) acc)
                a2 (if share (bit-or (bit-and a1 255) (bit-or 2 (* (+ ed 4) 256))) a1)]
            (walk hs n (+ q (* (+ 4 elen) 4294967296)) a2)))))))
(defn- copy32 [o :i64 on :i64 s :i64 sn :i64 q :i64] :i64
  (let [from (u64-shift-right q 32) i (bit-and q 4294967295)]
    (if (>= i 32) 0
      (let [w (kernel-store-u8 o on i (b s sn (+ from i)))] (copy32 o on s sn (+ (+ q 1) (* 0 w)))))))
;; 1 when hs is a ServerHello the C accepts (TLS 1.3, AES-128-GCM, an X25519 share), with the share in key[0..32); 0 otherwise
(defn kotoba_aiueos_tls13_serverhello_parse [hs :i64 n :i64 key :i64 key-len :i64] :i64
  (if (or (not (canonical? n)) (not (canonical? key-len)) (> n 16384) (< key-len 32) (< n 40)) 0
    (if (or (not= (b hs n 0) 2) (not= (+ (+ (* 65536 (b hs n 1)) (be16 hs n 2)) 4) n) (not= (b hs n 4) 3) (not= (b hs n 5) 3)) 0
      (let [sid (b hs n 38)]
        (if (or (> sid 32) (> (+ (+ 39 sid) 5) n)) 0
          (let [off (+ 39 sid)]
            (if (or (not= (b hs n off) 19) (not= (b hs n (+ off 1)) 1) (not= (b hs n (+ off 2)) 0)) 0
              (let [o2 (+ off 3)]
                (if (> (+ o2 2) n) 0
                  (let [end (+ (+ o2 2) (be16 hs n o2))]
                    (if (not= end n) 0
                      (let [acc (walk hs n (+ (* (+ o2 2) 4294967296) end) 0)]
                        (if (or (< acc 0) (not= (bit-and acc 3) 3)) 0
                          (+ 1 (* 0 (copy32 key key-len hs n (* (u64-shift-right acc 8) 4294967296)))))))))))))))))
