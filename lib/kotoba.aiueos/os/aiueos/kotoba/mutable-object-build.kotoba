;; JUN-552: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form first, takes no test main and exports nothing else. Its `if` wants a bool, so the helpers' 1/0 answers
;; are tested as (= 1 ...), and a window's length must be its base's own, so copy-byte names the 16 it was always passed.
;; The object it writes is unchanged.
(ns aiueos.mutable-object-build (:export [kotoba_aiueos_mutable_object_build]))

(defn- read-u32 [base length index]
  (+ (kernel-load-u8 base length index)
     (* (kernel-load-u8 base length (+ index 1)) 256)
     (* (kernel-load-u8 base length (+ index 2)) 65536)
     (* (kernel-load-u8 base length (+ index 3)) 16777216)))

(defn- write-u32 [base length index value]
  (let [b0 (bit-and value 255)
        b1 (bit-and (quot value 256) 255)
        b2 (bit-and (quot value 65536) 255)
        b3 (bit-and (quot value 16777216) 255)]
    (if (= (kernel-store-u8 base length index b0) b0)
      (if (= (kernel-store-u8 base length (+ index 1) b1) b1)
        (if (= (kernel-store-u8 base length (+ index 2) b2) b2)
          (if (= (kernel-store-u8 base length (+ index 3) b3) b3) 1 0) 0) 0) 0)))

(defn- copy-byte [target source index]
  (let [value (kernel-load-u8 source 16 index)]
    (= (kernel-store-u8 target 16 index value) value)))

(defn- copy-16 [target source]
  (and (copy-byte target source 0)
       (copy-byte target source 1)
       (copy-byte target source 2)
       (copy-byte target source 3)
       (copy-byte target source 4)
       (copy-byte target source 5)
       (copy-byte target source 6)
       (copy-byte target source 7)
       (copy-byte target source 8)
       (copy-byte target source 9)
       (copy-byte target source 10)
       (copy-byte target source 11)
       (copy-byte target source 12)
       (copy-byte target source 13)
       (copy-byte target source 14)
       (copy-byte target source 15)))

(defn- write-object-metadata [object object-length sequence transaction transaction-length]
  (if (= 1 (write-u32 object object-length 0 1330989377))
    (if (= 1 (write-u32 object object-length 4 3230274))
      (if (= 1 (write-u32 object object-length 8 (read-u32 transaction transaction-length 4)))
        (if (= 1 (write-u32 object object-length 12 sequence))
          (if (= 1 (write-u32 object object-length 16 (read-u32 transaction transaction-length 8)))
            (write-u32 object object-length 20 (read-u32 transaction transaction-length 12))
            0) 0) 0) 0) 0))

(defn kotoba_aiueos_mutable_object_build [object object-length sequence transaction transaction-length]
  (if (= 1 (write-object-metadata object object-length sequence transaction transaction-length))
    (if (copy-16 (kernel-subregion object object-length 24 16)
                 (kernel-subregion transaction transaction-length 16 16)) 1 0) 0))

