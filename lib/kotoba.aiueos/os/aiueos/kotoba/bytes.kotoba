;; Byte copy and fill over caller regions (JUN-556): the loops kernel/tls_aes_gcm.c ran in C, for the Kotoba object that
;; replaces it (the default kernel link has no memcpy / memset: kernel/main.c defines them only for AIUEOS_SIZE_BUILD).
;;
;; One byte per step through a one-byte subregion: the object route takes a subregion's length only as a literal, and a
;; u8 window is at most 512 bytes, so this is the form that covers a region of any length with every access bounded.
(ns aiueos.bytes (:export [kotoba_aiueos_bytes_copy kotoba_aiueos_bytes_fill]))
(defn- copy-at [d :i64 dn :i64 s :i64 sn :i64 o :i64] :i64
  (if (>= o dn) 0
    (let [dc (kernel-subregion d dn o 1) sc (kernel-subregion s sn o 1)
          w (kernel-store-u8 dc 1 0 (kernel-load-u8 sc 1 0))]
      (copy-at d dn s sn (+ (+ o 1) (* 0 w))))))
;; d[0..n) <- s[0..n), both regions n bytes. A region copied onto itself is left alone, as the C's gcm_copy did; two
;; different lengths copy nothing. Returns 0.
(defn kotoba_aiueos_bytes_copy [d :i64 dn :i64 s :i64 sn :i64] :i64
  (if (or (= d s) (not= dn sn)) 0 (copy-at d dn s sn 0)))
(defn- fill-at [d :i64 dn :i64 v :i64 o :i64] :i64
  (if (>= o dn) 0
    (let [dc (kernel-subregion d dn o 1) w (kernel-store-u8 dc 1 0 v)]
      (fill-at d dn v (+ (+ o 1) (* 0 w))))))
;; d[0..n) <- the low byte of v. Returns 0.
(defn kotoba_aiueos_bytes_fill [d :i64 dn :i64 v :i64] :i64 (fill-at d dn v 0))
