(ns aiueos.kernel-context-build)

;; The kernel-selector twin of `user-context-build`. Same 160-byte interrupt
;; return frame, same bounded 4 KiB kernel stack, but `iret` lands in a C
;; function at ring 0 rather than in ring 3, so there is no separate user
;; stack: the frame's RSP is the top of this very stack.
;;
;; The C this replaces places the frame differently from the ring-3 one, and
;; the difference is deliberate rather than incidental:
;;
;;   top = (((uintptr_t)stack + 4096) & ~15) - 8;   /* kernel */
;;   top =  ((uintptr_t)stack + 4096) & ~15;        /* user, before this port */
;;
;; The extra -8 models the stack position `call` normally produces (RSP % 16
;; == 8 at function entry), because `iret` here enters an ordinary C function
;; that expects the System V entry invariant. So the frame occupies
;; [top-160, top) and the kernel frame sits EIGHT bytes lower than the ring-3
;; one -- 3928 rather than 3936 from the base of a 16-byte-aligned stack.
;;
;; There is no `bit-not`, so `x & ~15` is written `x - (x & 15)`: masking
;; first keeps the arithmetic away from `quot`'s signed division, and the low
;; four bits of a pointer are the same bits whether the i64 holding it reads
;; as negative (a higher-half kernel address) or not.
;;
;; `user-context-build` does not do this subtraction at all -- it hard-codes
;; 3936, which is only correct while the stack it is handed is already
;; 16-byte aligned. This object computes it, so an unaligned stack produces
;; the same frame the C produced.

;; Field offsets within `struct aiueos_interrupt_context`: fifteen saved GPRs
;; (r15..rax, RDI ninth at 72) then the five words `iret` itself consumes --
;; RIP 120, CS 128, RFLAGS 136, RSP 144, SS 152.

;; Every byte of the frame is zeroed before any field is written. A partially
;; initialised frame is how a stale register value reaches a new task.
(defn zero-frame [stack base index]
  (if (= index 160) 160
    (let [stored (kernel-store-u8-4k stack 4096 (+ base index) 0)]
      (+ stored (zero-frame stack base (+ index 1))))))

;; Little-endian store of one 64-bit field, byte by byte.
;;
;; `quot` emits a SIGNED idivq, and there is no shift operator, so the naive
;; `(quot value 256)` truncates toward zero rather than shifting: for a value
;; with bit 63 set -- a higher-half kernel address, or any pointer at or above
;; 2^63 -- `(quot -1 256)` is 0, and every byte above the first would be
;; written as zero. `user-context-build`'s copy of this helper has exactly that
;; shape and is correct only while every address it stores stays below 2^63.
;;
;; Masking the low eight bits off FIRST makes each division exact, and an
;; exact division by 256 is an arithmetic shift: the sign extension lands in
;; the bits above 55, which are discarded by the `(bit-and .. 255)` that reads
;; the byte. So each `q` holds the true byte of `value` in its low eight bits
;; for the whole unsigned range, at the cost of one `and` per step.
(defn store64 [stack offset value]
  (let [q1 (quot (bit-and value -256) 256)
        q2 (quot (bit-and q1 -256) 256)
        q3 (quot (bit-and q2 -256) 256)
        q4 (quot (bit-and q3 -256) 256)
        q5 (quot (bit-and q4 -256) 256)
        q6 (quot (bit-and q5 -256) 256)
        q7 (quot (bit-and q6 -256) 256)
        s0 (kernel-store-u8-4k stack 4096 offset (bit-and value 255))
        s1 (kernel-store-u8-4k stack 4096 (+ offset 1) (bit-and q1 255))
        s2 (kernel-store-u8-4k stack 4096 (+ offset 2) (bit-and q2 255))
        s3 (kernel-store-u8-4k stack 4096 (+ offset 3) (bit-and q3 255))
        s4 (kernel-store-u8-4k stack 4096 (+ offset 4) (bit-and q4 255))
        s5 (kernel-store-u8-4k stack 4096 (+ offset 5) (bit-and q5 255))
        s6 (kernel-store-u8-4k stack 4096 (+ offset 6) (bit-and q6 255))
        s7 (kernel-store-u8-4k stack 4096 (+ offset 7) (bit-and q7 255))]
    (+ s0 (+ s1 (+ s2 (+ s3 (+ s4 (+ s5 (+ s6 s7)))))))))

;; CS 0x08 is AIUEOS_KERNEL_CODE_SELECTOR, SS 0x10 the matching kernel data
;; selector, and 514 is AIUEOS_INTERRUPT_FLAG (1 << 9) | 2 -- the same RFLAGS
;; the ring-3 frame carries, since the reserved bit and IF do not depend on
;; the ring.
(defn aiueos-kernel-context-build [stack entry argument]
  (let [top (- 4088 (bit-and stack 15))
        base (- top 160)
        zeroed (zero-frame stack base 0)
        argument-sum (store64 stack (+ base 72) argument)
        entry-sum (store64 stack (+ base 120) entry)
        cs-sum (store64 stack (+ base 128) 8)
        flags-sum (store64 stack (+ base 136) 514)
        stack-sum (store64 stack (+ base 144) (+ stack top))
        ss-sum (store64 stack (+ base 152) 16)
        evidence (+ zeroed (+ argument-sum (+ entry-sum
                   (+ cs-sum (+ flags-sum (+ stack-sum ss-sum))))))]
    (if (>= evidence 160) (+ stack base) 0)))

(defn main [] 0)
