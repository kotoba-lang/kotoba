(ns aiueos.page-mapping-plan)

;; A mapping plan packs the 4 KiB virtual page index in the high bits and a
;; hardware-independent permission class in the low two bits:
;; 1 = user RX, 2 = user RW+NX. Kind 4 is an entry-admission query.
;;
;; Two shipped user-ELF layouts (JUN-145, measured 2026-10-26): the packager
;; puts the data segment at file offset 8192 (the layout this kernel shipped
;; with) or 65536 (the current packager) over image base 0x1e0000, so the
;; data virtual address — which kind 3 is GIVEN instead of a byte count — is
;; page 482 (0x1e2000) or page 496 (0x1f0000). Text starts at page 481
;; (0x1e1000) and may take two pages (481, 482) only when data lives on 496;
;; aiueos-user-elf-valid proves that pairing from the program headers before
;; mapping runs — this plan answers per call and cannot see both segments.
;; Two text pages is the ceiling: pages above 482 run into kernel low memory
;; below aiueos_low_end (idt, page tables and process_spaces live there), so
;; the validator's `text <= 8192` and `4096 + text <= data-offset` are the
;; invariants this plan trusts and does not re-derive.
;;
;; kind 3 also admits the argument the current C caller passes — the data
;; segment's filesz, always 88 — because under the layout the old validator
;; pinned, filesz 88 implied p_vaddr 0x1e2000, so 88 still means page 482.
;; That clause keeps a rebuilt object boot-compatible until kernel/loader.c
;; switches kind 3's argument to the program header's p_vaddr (JUN-145 ③).

(defn aiueos-page-mapping-plan [process kind size active existing]
  (if (>= process 8) 0
    (if (= kind 1)
      (if (and (= size 4096) (= active 1) (= existing 0))
        (+ (* (+ 500 process) 4) 2) 0)
      (if (= kind 2)
        (if (and (> size 0) (<= size 8192) (= active 1) (= existing 0))
          (+ (* 481 4) 1) 0)
        (if (= kind 3)
          (if (and (> size 0) (= active 1) (= existing 0)
                   (or (= size 88) (= size 1974272) (= size 2031616)))
            (+ (* (if (= size 88) 482 (quot size 4096)) 4) 2) 0)
          (if (= kind 4)
            (if (and (= active 1) (= existing 1)
                     (>= size 1970176) (< size 1974272)) 1 0)
            0))))))

(defn main [] 0)
