(ns aiueos.qwen35-recurrent-step
  (:export [kotoba_aiueos_qwen35_recurrent_step]))

;; `recurrent_step` (`kernel/qwen35_infer.c:493`) as one kernel object: the
;; gated DeltaNet update of ONE linear-attention head's recurrent state.
;;
;;     S <- decay * S
;;     delta <- beta * (v - S^T k)
;;     S <- S + k (x) delta
;;     y <- (S^T q) / sqrt(d)
;;
;; Rows of `S` are the KEY dimension and columns the VALUE dimension, which is
;; why every cell read below is `state[key * d + value]` and never the
;; transpose.
;;
;; ## One arena, one plan
;;
;; The C takes eight arguments (`head_state`, `key`, `query`, `value`, `decay`,
;; `beta`, `correction`, `output`) and this dialect admits five, of which one
;; is the arena and one the plan. `kernel-subregion` also requires its BASE to
;; be a parameter, a literal or `kernel-boot-info` (amu's
;; `kernel_region_provenance_test`), so six regions could not arrive as six
;; bases in any case. They arrive as OFFSETS into one region instead, which a
;; plan may compute.
;;
;; The offsets are 64-bit because `decode->recurrent` is **150,994,944 bytes**
;; (48 linear slots x 48 heads x 128 x 128 x 4) and sits above the model
;; mapping: a u32 slot would truncate silently.
;;
;;     0   reserved, must be zero                  u32
;;     4   reserved, must be zero                  u32
;;     8   dimension, 1..128                       u64
;;    16   state offset within the arena           u64
;;    24   key offset                              u64
;;    32   query offset                            u64
;;    40   value offset                            u64
;;    48   correction (scratch) offset             u64
;;    56   output offset                           u64
;;    64   decay, a binary32 bit pattern           u64  (high word zero)
;;    72   beta, a binary32 bit pattern            u64  (high word zero)
;;    80   reserved, must be zero                  u64
;;    88   reserved, must be zero                  u64
;;
;; Region LENGTHS are DERIVED from the dimension -- `d*d*4` for the state and
;; `d*4` for each vector -- rather than carried, so the plan cannot state a
;; length that disagrees with the dimension it also states.
;;
;; ### Why the dimension is a field and not the constant 128
;;
;; `LINEAR_HEAD_DIM` is 128 and K16 will never call this with anything else.
;; The field exists so the object can be RUN in the `kotoba.kir` interpreter,
;; which recurses once per Kotoba call and has no tail-call elimination: the
;; 16,384-cell decay walk at d=128 exhausts node's stack, while d=8 is 64
;; cells and executes. The same reason `contracts/qwen35-norm-v1.edn` verifies
;; a width of 32 rather than 5,120. The dimension changes no arithmetic --
;; every loop below is bounded by it and by nothing else.
;;
;; ## Return
;;
;; **Zero is the success value.**
;;
;;    0    the state and the output were written
;;   -1    null arena
;;   -2    null plan
;;   -3    plan length is not 96
;;   -4    a reserved slot is non-zero
;;   -5    the dimension is outside 1..128
;;   -6    decay or beta is non-finite
;;   -7    a region runs past the arena
;;
;; `-6` is a refusal `recurrent_step` does not itself make -- its CALLER does,
;; at `linear_attention:704`
;; (`if (!finite_float(decay) || !finite_float(beta)) return fail_at(...)`).
;; It is here because the two are one composite in the C and because a
;; non-finite decay poisons 65,536 bytes of state that nothing downstream reads
;; back as an error.
;;
;; ## THE DECAY MULTIPLY IS HOISTED, AND THAT IS NOT A REASSOCIATION
;;
;; The C decays a cell inside the `remembered` accumulation:
;;
;;     for (v) { for (k) { cell = S + k*d + v; *cell *= decay;
;;                         remembered += *cell * key[k]; } ... }
;;
;; Over the whole `v` loop every cell `(k, v)` is reached exactly once, so the
;; multiply is applied to each cell exactly once and always BEFORE that cell is
;; read. Doing all `d*d` multiplies first is therefore the same sequence of
;; roundings over the same values -- a loop split, not a reordering of any
;; arithmetic expression. It is done because `[state r v k acc]` already spends
;; five parameters and `decay` would be a sixth.
;;
;; `remembered` is likewise split out and written to the correction slot before
;; `(value[v] - remembered) * beta` narrows it. `remembered` is a `float` in
;; the C, so the round trip through memory is exact.
;;
;; ## The reduction is SEQUENTIAL, not the four-accumulator tree
;;
;; `dot_scalar` (:234) and `stable_attention_score` (:115) both reduce in four
;; accumulators. `recurrent_step` does NOT: both of its inner products
;; accumulate one element at a time, left to right, in binary32. Using the tree
;; here would disagree with the C on most inputs.
;;
;; ## The two inner loops walk a FLAT cell index, and that is a repair
;;
;; Both of them need a row and a column, which is six parameters against the
;; five this dialect admits, so the first draft packed them as `v * 128 + k`
;; with the dimension ceiling as the radix. At `d = 128` -- the only dimension
;; K16 ever passes -- the decoded `k` is `vk mod 128`, which is never 128, so
;; the termination test `k >= d` never fired: an infinite loop, `ud2` at the
;; fuel guard, and `AIUEOS_EXCEPTION_FAIL unexpected-vector vector=6` under
;; QEMU. Every interpreter vector passed, because the interpreter cannot run
;; `d = 128` (see above) and every dimension below the ceiling terminates.
;;
;; The repair removes the radix rather than widening it. A column walk starts
;; at `v` and steps by `d`, so `c >= d*d` is the end and `k` is `c / d`; the
;; rank-one update touches every cell exactly once, so it is one flat loop over
;; `c` with `k = c / d` and `v = c - k*d`. Neither depends on a ceiling.

;; ## amu native object route (JUN-633)
;;
;; The native route takes a window's length only from the window's own region: a literal or the length its owner was
;; given, never a computed one. Every region's length here is computed from dim ((* dim 4), (* dim (* dim 4))), so each
;; element is addressed as a 4-byte window of the arena itself, at the region's offset from the plan plus four times
;; its index; no region-sized window is formed. The kotoba-compiler/1 source's region windows only ever held in-range
;; accesses, and regions-fit still admits every region inside the arena first, so the cells and vectors read and
;; written are the same ones. The plan is read through the length the export was given (plan-length, checked to be
;; 96). A private helper takes at most five parameters, so a region's plan slot shares a word with its index
;; (slot | i << 8), a store's target with its value (si | bits << 32), and a column's position with its running sum
;; (rc | acc << 32). The arithmetic and its order are unchanged.

(defn- f32w [u]
  (if (> u 2147483647) (- u 4294967296) u))

(defn- u32w [v]
  (bit-and v 4294967295))

(defn- plan-u32 [plan pn slot]
  (kernel-load-u32 plan pn slot))

(defn- plan-u64 [plan pn slot]
  (+ (kernel-load-u32 plan pn slot)
     (* 4294967296 (kernel-load-u32 plan pn (+ slot 4)))))

(defn- nonfinite [bits]
  (if (= (bit-and (u32w bits) 2139095040) 2139095040) 1 0))

(defn- dim-of [plan pn] (plan-u64 plan pn 8))

;; element i of the region whose offset is at plan slot `slot` (16 the state, 24 key, 32 query, 40 value, 48 the
;; correction, 56 the output); si = slot | i << 8
(defn- ix [slot i] (bit-or slot (i64-shift-left i 8)))

(defn- at [arena alen plan pn si]
  (f32w (kernel-load-u32 (kernel-subregion arena alen (+ (plan-u64 plan pn (bit-and si 255)) (* (u64-shift-right si 8) 4)) 4) 4 0)))

;; sib = si | bits << 32
(defn- put [arena alen plan pn sib]
  (let [si (bit-and sib 16777215)]
    (kernel-store-u32 (kernel-subregion arena alen (+ (plan-u64 plan pn (bit-and si 255)) (* (u64-shift-right si 8) 4)) 4) 4 0
                      (u64-shift-right sib 32))))

(defn- with [si bits] (bit-or si (i64-shift-left (u32w bits) 32)))

(defn- scale-state [arena alen plan pn c]
  (let [dim (dim-of plan pn)]
    (if (>= c (* dim dim))
      0
      (do (put arena alen plan pn
               (with (ix 16 c)
                     (f32-to-bits (f32-mul (f32-from-bits (at arena alen plan pn (ix 16 c)))
                                           (f32-from-bits (f32w (plan-u32 plan pn 64)))))))
          (scale-state arena alen plan pn (+ c 1))))))

;; sum over the column c, c + dim, ... of the state times the vector at plan slot r; st = (r | c << 8) | acc << 32
(defn- dot-col [arena alen plan pn st]
  (let [dim (dim-of plan pn) rc (bit-and st 16777215) r (bit-and rc 255) c (u64-shift-right rc 8)
        acc (f32w (u64-shift-right st 32))]
    (if (>= c (* dim dim))
      acc
      (dot-col arena alen plan pn
               (with (ix r (+ c dim))
                     (f32-to-bits
                      (f32-add (f32-from-bits acc)
                               (f32-mul (f32-from-bits (at arena alen plan pn (ix 16 c)))
                                        (f32-from-bits (at arena alen plan pn (ix r (quot c dim))))))))))))

(defn- remembered-pass [arena alen plan pn v]
  (if (>= v (dim-of plan pn))
    0
    (do (put arena alen plan pn (with (ix 48 v) (dot-col arena alen plan pn (with (ix 24 v) 0))))
        (remembered-pass arena alen plan pn (+ v 1)))))

(defn- correction-pass [arena alen plan pn v]
  (if (>= v (dim-of plan pn))
    0
    (do (put arena alen plan pn
             (with (ix 48 v)
                   (f32-to-bits
                    (f32-mul (f32-sub (f32-from-bits (at arena alen plan pn (ix 40 v)))
                                      (f32-from-bits (at arena alen plan pn (ix 48 v))))
                             (f32-from-bits (f32w (plan-u32 plan pn 72)))))))
        (correction-pass arena alen plan pn (+ v 1)))))

(defn- rank1-pass [arena alen plan pn c]
  (let [dim (dim-of plan pn)]
    (if (>= c (* dim dim))
      0
      (do (put arena alen plan pn
               (with (ix 16 c)
                     (f32-to-bits
                      (f32-add (f32-from-bits (at arena alen plan pn (ix 16 c)))
                               (f32-mul (f32-from-bits (at arena alen plan pn (ix 24 (quot c dim))))
                                        (f32-from-bits
                                         (at arena alen plan pn (ix 48 (- c (* dim (quot c dim)))))))))))
          (rank1-pass arena alen plan pn (+ c 1))))))

(defn- output-pass [arena alen plan pn v]
  (if (>= v (dim-of plan pn))
    0
    (do (put arena alen plan pn
             (with (ix 56 v)
                   (f32-to-bits
                    (f32-mul (f32-from-bits (dot-col arena alen plan pn (with (ix 32 v) 0)))
                             (f32-from-bits 1035273459)))))
        (output-pass arena alen plan pn (+ v 1)))))

(defn- fits [alen off len]
  (if (< off 0) 0 (if (< len 0) 0 (if (> (+ off len) alen) 0 1))))

(defn- regions-fit [alen plan pn]
  (let [dim (plan-u64 plan pn 8)]
    (if (= 0 (fits alen (plan-u64 plan pn 16) (* dim (* dim 4)))) 0
      (if (= 0 (fits alen (plan-u64 plan pn 24) (* dim 4))) 0
        (if (= 0 (fits alen (plan-u64 plan pn 32) (* dim 4))) 0
          (if (= 0 (fits alen (plan-u64 plan pn 40) (* dim 4))) 0
            (if (= 0 (fits alen (plan-u64 plan pn 48) (* dim 4))) 0
              (fits alen (plan-u64 plan pn 56) (* dim 4)))))))))

(defn- run [arena alen plan pn]
  (do (scale-state arena alen plan pn 0)
      (remembered-pass arena alen plan pn 0)
      (correction-pass arena alen plan pn 0)
      (rank1-pass arena alen plan pn 0)
      (output-pass arena alen plan pn 0)))

(defn kotoba_aiueos_qwen35_recurrent_step [arena arena-length plan plan-length]
  (if (= arena 0) -1
    (if (= plan 0) -2
      (if (not (= plan-length 96)) -3
        (if (not (= (plan-u32 plan plan-length 0) 0)) -4
          (if (not (= (plan-u32 plan plan-length 4) 0)) -4
            (if (not (= (plan-u32 plan plan-length 68) 0)) -4
              (if (not (= (plan-u32 plan plan-length 76) 0)) -4
                (if (not (= (plan-u64 plan plan-length 80) 0)) -4
                  (if (not (= (plan-u64 plan plan-length 88) 0)) -4
                    (if (< (plan-u64 plan plan-length 8) 1) -5
                      (if (> (plan-u64 plan plan-length 8) 128) -5
                        (if (= 1 (nonfinite (plan-u32 plan plan-length 64))) -6
                          (if (= 1 (nonfinite (plan-u32 plan plan-length 72))) -6
                            (if (= 0 (regions-fit arena-length plan plan-length)) -7
                              (run arena arena-length plan plan-length))))))))))))))))
