;; net_build_dns_query_named of kernel/pci.c in Kotoba (JUN-552): one Ethernet / IPv4 / UDP DNS query for a
;; caller-owned question.
;;
;; build(frame, n, rec, rec-len, question, qlen): with 5 <= qlen <= 255 and n = 54 + qlen, writes frame[0..n) and answers
;; n, the C's 14 + total; else writes nothing and answers 0, as the C did for a bad question length. rec is 24 bytes:
;; [0..6) the peer's MAC (destination), [6..12) ours, then little-endian u32s -- [12] src, [16] dst, [20] the server port
;; (low 16 bits). The frame is the C's: zeroed, version 4 IHL 5, total 20 + 8 + 12 + qlen, identification 0, DF, TTL 64,
;; protocol 17, the client port 49154, the transaction 0xa1e0, RD, QDCOUNT 1, the question copied; the IPv4 checksum
;; over the header and the UDP checksum over the pseudo header and the datagram as kotoba_aiueos_ipv4_checksum answers
;; them, a UDP 0 sent as 0xffff (RFC 768). The pseudo header is summed in place. n <= 16384 (amu ADR 0386's windows).
(ns aiueos.dns-query (:export [kotoba_aiueos_dns_query_build]))
(defn- canonical? [x :i64] :bool (= (u64-shift-right x 32) 0))
(defn- b [f :i64 n :i64 i :i64] :i64 (kernel-load-u8-16k f n i))
(defn- put [f :i64 n :i64 i :i64 v :i64] :i64 (kernel-store-u8-16k f n i (bit-and v 255)))
(defn- put16 [f :i64 n :i64 i :i64 v :i64] :i64 (+ (put f n i (u64-shift-right v 8)) (put f n (+ i 1) v)))
(defn- put32 [f :i64 n :i64 i :i64 v :i64] :i64 (+ (put16 f n i (u64-shift-right v 16)) (put16 f n (+ i 2) (bit-and v 65535))))
(defn- r32 [r :i64 rn :i64 i :i64] :i64 (kernel-load-u32 r rn i))
(defn- sum16 [w :i64 wn :i64 off :i64 acc :i64] :i64
  (if (>= off wn) acc
    (let [hi (b w wn off) lo (if (>= (+ off 1) wn) 0 (b w wn (+ off 1)))]
      (sum16 w wn (+ off 2) (+ acc (+ (* 256 hi) lo))))))
(defn- fold [t :i64] :i64 (if (< t 65536) t (fold (+ (bit-and t 65535) (quot t 65536)))))
(defn- csum [s :i64 len :i64] :i64 (if (> len 2048) 65535 (- 65535 (fold s))))
(defn- zero [f :i64 n :i64 i :i64] :i64 (if (>= i n) 0 (let [w (put f n i 0)] (zero f n (+ (+ i 1) (* 0 w))))))
(defn- macs [f :i64 n :i64 r :i64 rn :i64 i :i64] :i64
  (if (>= i 12) 0 (let [v (kernel-load-u8 r rn i) w (put f n i v)] (macs f n r rn (+ (+ i 1) (* 0 w))))))
(defn- copy [f :i64 n :i64 s :i64 sn :i64 i :i64] :i64
  (if (>= i sn) 0 (let [v (b s sn i) w (put f n (+ 54 i) v)] (copy f n s sn (+ (+ i 1) (* 0 w))))))
(defn- head [f :i64 n :i64 r :i64 rn :i64 qlen :i64] :i64
  (let [ul (+ 20 qlen)
        a1 (put16 f n 12 2048) a2 (put f n 14 69) a3 (put16 f n 16 (+ 20 ul)) a4 (put16 f n 20 16384)
        a5 (put f n 22 64) a6 (put f n 23 17) a7 (put32 f n 26 (r32 r rn 12)) a8 (put32 f n 30 (r32 r rn 16))
        a9 (put16 f n 34 49154) b1 (put16 f n 36 (bit-and (r32 r rn 20) 65535)) b2 (put16 f n 38 ul)
        b3 (put16 f n 42 41440) b4 (put16 f n 44 256) b5 (put16 f n 46 1)]
    (+ (+ (+ (+ a1 a2) (+ a3 a4)) (+ (+ a5 a6) (+ a7 a8))) (+ (+ (+ a9 b1) (+ b2 b3)) (+ b4 b5)))))
;; the UDP checksum over the pseudo header and frame[34..34+ul); ul is a parameter so the window's length has a source
(defn- udp-csum [f :i64 n :i64 ul :i64 src :i64 dst :i64] :i64
  (let [u (kernel-subregion f n 34 ul)
        pseudo (+ (+ (u64-shift-right src 16) (bit-and src 65535)) (+ (+ (u64-shift-right dst 16) (bit-and dst 65535)) (+ 17 ul)))
        c (csum (sum16 u ul 0 pseudo) (+ 12 ul))]
    (if (= c 0) 65535 c)))
(defn- checksums [f :i64 n :i64 src :i64 dst :i64] :i64
  (let [h (kernel-subregion f n 14 20) ip (csum (sum16 h 20 0 0) 20)
        w1 (put16 f n 24 ip)
        udp (udp-csum f n (- n 34) src dst)]
    (+ (put16 f n 40 udp) (* 0 w1))))
(defn kotoba_aiueos_dns_query_build [frame :i64 n :i64 rec :i64 rec-len :i64 question :i64 qlen :i64] :i64
  (if (or (= frame 0) (= rec 0) (= question 0) (not (canonical? n)) (not (canonical? qlen)) (< qlen 5) (> qlen 255)
          (> n 16384) (not= n (+ 54 qlen)) (not= rec-len 24)) 0
    (let [w0 (zero frame n 0) w1 (macs frame n rec rec-len 0) w2 (head frame n rec rec-len qlen)
          w3 (copy frame n question qlen 0)
          w4 (checksums frame n (r32 rec rec-len 12) (r32 rec rec-len 16))]
      (+ n (* 0 (+ (+ w0 w1) (+ (+ w2 w3) w4)))))))
