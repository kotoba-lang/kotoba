;; The two peer-bound ARP helpers of kernel/rtl8125.c in Kotoba (JUN-553): aiueos_rtl8125_direct_arp_request (is this frame
;; the peer's who-has for our address, sent to broadcast or to us) and aiueos_rtl8125_direct_arp_reply (build the 42-byte is-at
;; for it). kernel/rtl8125.c keeps their C signatures as wrappers, so pci.c's direct-link path is unchanged.
;;
;; Every frame access is inside the first 42 bytes and goes through a 16 KiB width window over the frame's own length (amu
;; ADR 0386), so a frame longer than 16384 bytes is refused; the C accepted any length >= 42, and the callers' frames are at
;; most AIUEOS_RTL8125_FRAME_CAPACITY. Each MAC arrives with its length, which must be 6 (the wrappers pass 6). A null pointer,
;; a zero address, or a length or address with a non-zero upper half is refused. request returns 1 or 0, reply 42 or 0 (on 0
;; nothing is written).
;;
;; Built by the Amu aiueos kernel object route at amu 65359a09, fuel 4194304.
(ns aiueos.rtl8125-arp
  (:export [kotoba_aiueos_rtl8125_arp_request kotoba_aiueos_rtl8125_arp_reply]))
(defn- canonical? [x :i64] :bool (= (u64-shift-right x 32) 0))
(defn- b [f :i64 n :i64 i :i64] :i64 (kernel-load-u8-16k f n i))
(defn- be16 [f :i64 n :i64 i :i64] :i64 (+ (* 256 (b f n i)) (b f n (+ i 1))))
(defn- be32 [f :i64 n :i64 i :i64] :i64 (+ (* 65536 (be16 f n i)) (be16 f n (+ i 2))))
;; OR of frame[off + i] xor mac[i] over the six bytes, accumulated above bit 16; off and i share the word (acc << 16 | off << 8
;; | i) to stay within five parameters
(defn- mac-diff [f :i64 n :i64 mac :i64 mn :i64 oi :i64] :i64
  (let [off (bit-and (u64-shift-right oi 8) 255) i (bit-and oi 255)]
    (if (>= i 6) (u64-shift-right oi 16)
      (mac-diff f n mac mn (+ (+ oi 1) (* 65536 (bit-xor (b f n (+ off i)) (kernel-load-u8 mac mn i))))))))
(defn- same-mac? [f :i64 n :i64 mac :i64 mn :i64 off :i64] :bool (= (mac-diff f n mac mn (* off 256)) 0))
(defn- bcast? [f :i64 n :i64 i :i64 acc :i64] :bool
  (if (>= i 6) (= acc 255) (bcast? f n (+ i 1) (bit-and acc (b f n i)))))
(defn- args-ok? [p :i64 n :i64 mac-lens :i64 local-ip :i64 peer-ip :i64] :bool
  (and (not= p 0) (canonical? n) (>= n 42) (<= n 16384) (= mac-lens 1542)
       (canonical? local-ip) (canonical? peer-ip) (not= local-ip 0) (not= peer-ip 0)))
(defn kotoba_aiueos_rtl8125_arp_request [frame :i64 frame-length :i64 local-mac :i64 local-len :i64 peer-mac :i64 peer-len :i64 local-ip :i64 peer-ip :i64] :i64
  (if (or (= local-mac 0) (= peer-mac 0) (not (args-ok? frame frame-length (+ (* local-len 256) peer-len) local-ip peer-ip))) 0
    (if (and (or (bcast? frame frame-length 0 255) (same-mac? frame frame-length local-mac local-len 0))
             (same-mac? frame frame-length peer-mac peer-len 6)
             (= (be16 frame frame-length 12) 2054) (= (be16 frame frame-length 14) 1) (= (be16 frame frame-length 16) 2048)
             (= (b frame frame-length 18) 6) (= (b frame frame-length 19) 4) (= (be16 frame frame-length 20) 1)
             (same-mac? frame frame-length peer-mac peer-len 22)
             (= (be32 frame frame-length 28) peer-ip) (= (be32 frame frame-length 38) local-ip)) 1 0)))
(defn- s [f :i64 n :i64 i :i64 v :i64] :i64 (kernel-store-u8-16k f n i v))
(defn- zero [f :i64 n :i64 i :i64] :i64 (if (>= i 42) 0 (let [w (s f n i 0)] (zero f n (+ (+ i 1) (* 0 w))))))
;; mac into frame at two offsets; oi packs (first << 16 | second << 8 | i) to stay within five parameters
(defn- put-mac [f :i64 n :i64 mac :i64 mn :i64 oi :i64] :i64
  (let [i (bit-and oi 255) o1 (u64-shift-right oi 16) o2 (bit-and (u64-shift-right oi 8) 255)]
    (if (>= i 6) 0
      (let [x (kernel-load-u8 mac mn i) a (s f n (+ o1 i) x) c (s f n (+ o2 i) x)]
        (put-mac f n mac mn (+ (+ oi 1) (* 0 (+ a c))))))))
(defn- s32 [f :i64 n :i64 i :i64 v :i64] :i64
  (+ (s f n i (bit-and (u64-shift-right v 24) 255)) (s f n (+ i 1) (bit-and (u64-shift-right v 16) 255))
     (s f n (+ i 2) (bit-and (u64-shift-right v 8) 255)) (s f n (+ i 3) (bit-and v 255))))
(defn kotoba_aiueos_rtl8125_arp_reply [frame :i64 capacity :i64 local-mac :i64 local-len :i64 peer-mac :i64 peer-len :i64 local-ip :i64 peer-ip :i64] :i64
  (if (or (= local-mac 0) (= peer-mac 0) (not (args-ok? frame capacity (+ (* local-len 256) peer-len) local-ip peer-ip))) 0
    (let [z (zero frame capacity 0)
          c (+ (put-mac frame capacity peer-mac peer-len (+ 8192 (* 0 z))) (put-mac frame capacity local-mac local-len 398848))
          w (+ (s frame capacity (+ 12 (* 0 c)) 8) (s frame capacity 13 6) (s frame capacity 15 1) (s frame capacity 16 8)
               (s frame capacity 18 6) (s frame capacity 19 4) (s frame capacity 21 2))
          a (+ (s32 frame capacity (+ 28 (* 0 w)) local-ip) (s32 frame capacity 38 peer-ip))]
      (+ 42 (* 0 a)))))
