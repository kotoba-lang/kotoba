;; p256_did and base58_encode of kernel/device_result.c in Kotoba (JUN-554): the did:key text of a P-256 public key --
;; "did:key:z", then base58btc of the 35-byte multikey 0x80 0x24 (0x02 | y-parity) X, then a NUL.
;;
;; p256_did(pub, pub-len, out, cap): pub is X || Y (64 bytes; any other length is refused). Returns 1 when the whole text
;; and its NUL fit in out[0..cap). When they do not, the bytes that fit are written and 0 is returned, as the C's
;; bounded_buffer did. The base58 is the C's long division over a 64-digit array, so a result that does not fit 64 digits
;; is refused before out is touched (the C's base58_encode failing) -- a 35-byte input never reaches that.
;; A null out, or a length with a non-zero upper half, is refused (0).
;;
;; The C's locals are this object's arrays (amu ADR 0385 / 0387): .bss 0 the base-58 digits, 1 the multikey, 2 the text.
;; Like the C's, not reentrant. Built by the Amu aiueos kernel object route at amu 65359a09, fuel 4194304.
(ns aiueos.p256-did
  (:export [kotoba_aiueos_p256_did]))
(defn- bss-addr-0-64 [] :i64 0)
(defn- bss-addr-1-40 [] :i64 0)
(defn- bss-addr-2-96 [] :i64 0)
(defn- canonical? [x :i64] :bool (= (u64-shift-right x 32) 0))
(defn- dg [i :i64] :i64 (kernel-load-u8 (bss-addr-0-64) 64 i))
(defn- ds [i :i64 v :i64] :i64 (kernel-store-u8 (bss-addr-0-64) 64 i v))
(defn- mk [i :i64] :i64 (kernel-load-u8 (bss-addr-1-40) 40 i))
(defn- ts [i :i64 v :i64] :i64 (kernel-store-u8 (bss-addr-2-96) 96 i v))
(defn- zero [i :i64] :i64 (if (>= i 64) 0 (let [w (ds i 0)] (zero (+ (+ i 1) (* 0 w))))))
(defn- put-x [pub :i64 n :i64 i :i64] :i64
  (if (>= i 32) 0 (let [w (kernel-store-u8 (bss-addr-1-40) 40 (+ 3 i) (kernel-load-u8 pub n i))] (put-x pub n (+ (+ i 1) (* 0 w))))))
;; digits[i] = (digits[i] * 256 + carry) mod 58 for i < dc; returns the carry out of the top digit
(defn- mul-add [i :i64 dc :i64 carry :i64] :i64
  (if (>= i dc) carry
    (let [v (+ (* (dg i) 256) carry) w (ds i (rem v 58))] (mul-add (+ (+ i 1) (* 0 w)) dc (quot v 58)))))
;; append the carry's base-58 digits; the new digit count, or -1 past 64 digits
(defn- push [dc :i64 carry :i64] :i64
  (if (= carry 0) dc
    (if (>= dc 64) -1 (let [w (ds dc (rem carry 58))] (push (+ (+ dc 1) (* 0 w)) (quot carry 58))))))
(defn- enc [j :i64 dc :i64] :i64
  (if (or (< dc 0) (>= j 35)) dc (let [c (mul-add 0 dc (mk j))] (enc (+ j 1) (push dc c)))))
(defn- lead [i :i64] :i64 (if (and (< i 35) (= (mk i) 0)) (lead (+ i 1)) i))
;; the base58btc alphabet, 123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz, as ranges
(defn- alpha [d :i64] :i64
  (cond (< d 9) (+ 49 d) (< d 17) (+ 65 (- d 9)) (< d 22) (+ 74 (- d 17)) (< d 33) (+ 80 (- d 22))
        (< d 44) (+ 97 (- d 33)) :else (+ 109 (- d 44))))
(defn- ones [at :i64 k :i64] :i64 (if (<= k 0) at (let [w (ts at 49)] (ones (+ (+ at 1) (* 0 w)) (- k 1)))))
(defn- digits [at :i64 k :i64] :i64 (if (< k 0) at (let [w (ts at (alpha (dg k)))] (digits (+ (+ at 1) (* 0 w)) (- k 1)))))
;; "did:key:z" at text[0..9)
(defn- prefix [] :i64
  (+ (ts 0 100) (ts 1 105) (ts 2 100) (ts 3 58) (ts 4 107) (ts 5 101) (ts 6 121) (ts 7 58) (ts 8 122)))
(defn- copy-out [p :i64 n :i64 len :i64 i :i64] :i64
  (if (or (>= i len) (>= i n)) 0
    (let [w (kernel-store-u8 p n i (kernel-load-u8 (bss-addr-2-96) 96 i))] (copy-out p n len (+ (+ i 1) (* 0 w))))))
(defn- out-text [out :i64 cap :i64 len :i64] :i64
  (let [c (if (>= cap 96) (copy-out (kernel-subregion out cap 0 96) 96 len 0) (copy-out out cap len 0))]
    (if (> (+ len (* 0 c)) cap) 0 1)))
(defn kotoba_aiueos_p256_did [pub :i64 pub-len :i64 out :i64 cap :i64] :i64
  (if (or (= out 0) (not (canonical? pub-len)) (not (canonical? cap)) (not= pub-len 64)) 0
    (let [m0 (kernel-store-u8 (bss-addr-1-40) 40 0 128)
          m1 (kernel-store-u8 (bss-addr-1-40) 40 1 36)
          y (kernel-load-u8 pub pub-len 63)
          m2 (kernel-store-u8 (bss-addr-1-40) 40 2 (+ 2 (bit-and y 1)))
          x (put-x pub pub-len (* 0 (+ m0 m1 m2)))
          z (zero (* 0 x))
          w (ds 0 (* 0 z))
          dc (enc 0 (+ 1 (* 0 w)))
          l (lead 0)]
      (if (or (< dc 0) (> (+ l dc 1) 64)) 0
        (let [p (prefix)
              a (ones (+ 9 (* 0 p)) l)
              e (digits a (- dc 1))
              n (ts e 0)]
          (out-text out cap (+ e 1 (* 0 n))))))))
