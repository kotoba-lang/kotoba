;; negotiate of kernel/pci.c in Kotoba (JUN-598): the virtio 1.0 feature negotiation over the common configuration
;; registers, in the C's order.
;;
;; negotiate(cfg, 56): with cfg the mapped common configuration (struct virtio_common_cfg, 56 bytes):
;;   device_status (u8 @20) = 0, then = ACK | DRIVER (3); device_feature_select (u32 @0) = 1; if device_feature (u32 @4)
;;   lacks bit 0 (VIRTIO_F_VERSION_1, feature bit 32) answer 0; driver_feature_select (u32 @8) = 1, driver_feature (u32
;;   @12) = 1, select = 0, feature = 0; device_status |= FEATURES_OK (8), read back; answer 1 when the device kept
;;   FEATURES_OK, else 0. Each register access is one load or store of its width, so the device sees the C's sequence.
;; A null cfg or a length other than 56 answers 0 with no access.
(ns aiueos.virtio-negotiate (:export [kotoba_aiueos_virtio_negotiate]))
(defn- features [c :i64 n :i64] :i64
  (let [w1 (kernel-store-u32 c n 8 1) w2 (kernel-store-u32 c n 12 1) w3 (kernel-store-u32 c n 8 0) w4 (kernel-store-u32 c n 12 0)
        s (kernel-load-u8 c n 20) w5 (kernel-store-u8 c n 20 (bit-or s 8)) t (kernel-load-u8 c n 20)]
    (+ (if (= (bit-and t 8) 0) 0 1) (* 0 (+ (+ w1 w2) (+ (+ w3 w4) w5))))))
(defn kotoba_aiueos_virtio_negotiate [cfg :i64 n :i64] :i64
  (if (or (= cfg 0) (not= n 56)) 0
    (let [w1 (kernel-store-u8 cfg n 20 0) w2 (kernel-store-u8 cfg n 20 3) w3 (kernel-store-u32 cfg n 0 1)
          f (kernel-load-u32 cfg n 4)]
      (if (= (bit-and f 1) 0) (* 0 (+ (+ w1 w2) w3)) (features cfg n)))))
