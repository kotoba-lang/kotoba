;; The UDP checksum sum of kernel/pci.c in Kotoba (JUN-552): what net_udp_checksum and net_udp_rx_checksum_ok handed
;; kotoba_aiueos_ipv4_checksum, without copying the pseudo header into net_dhcp_scratch first.
;;
;; sum(frame, n, udp-len): kotoba_aiueos_ipv4_checksum's answer over the 12-byte pseudo header -- the IPv4 source at
;; frame[26..30), the destination at frame[30..34), 0, 17, udp-len big-endian -- followed by frame[34..34 + udp-len):
;; RFC 1071, a trailing odd byte the high half, 0xffff (the checksum object's refusal) when 12 + udp-len > 2048. n must
;; be 34 + udp-len (<= 16384, amu ADR 0386's windows); else, or for a null pointer or a non-canonical value, the answer
;; is 0xffff as well. The C maps it: a send writes it with 0 sent as 0xffff (RFC 768), a receive admits only 0.
(ns aiueos.udp-checksum (:export [kotoba_aiueos_udp_checksum_sum]))
(defn- canonical? [x :i64] :bool (= (u64-shift-right x 32) 0))
(defn- b [f :i64 n :i64 i :i64] :i64 (kernel-load-u8-16k f n i))
(defn- be16 [f :i64 n :i64 i :i64] :i64 (+ (* 256 (b f n i)) (b f n (+ i 1))))
(defn- sum16 [w :i64 wn :i64 off :i64 acc :i64] :i64
  (if (>= off wn) acc
    (let [hi (b w wn off) lo (if (>= (+ off 1) wn) 0 (b w wn (+ off 1)))]
      (sum16 w wn (+ off 2) (+ acc (+ (* 256 hi) lo))))))
(defn- fold [t :i64] :i64 (if (< t 65536) t (fold (+ (bit-and t 65535) (quot t 65536)))))
;; the UDP words of frame[34..34 + ul); ul is a parameter so the window's length has a source
(defn- udp [f :i64 n :i64 ul :i64 pseudo :i64] :i64
  (let [u (kernel-subregion f n 34 ul)] (sum16 u ul 0 pseudo)))
(defn kotoba_aiueos_udp_checksum_sum [frame :i64 n :i64 udp-len :i64] :i64
  (if (or (= frame 0) (not (canonical? n)) (not (canonical? udp-len)) (> n 16384) (not= n (+ 34 udp-len))
          (> (+ 12 udp-len) 2048)) 65535
    (let [pseudo (+ (+ (+ (be16 frame n 26) (be16 frame n 28)) (+ (be16 frame n 30) (be16 frame n 32))) (+ 17 udp-len))]
      (- 65535 (fold (udp frame n udp-len pseudo))))))
