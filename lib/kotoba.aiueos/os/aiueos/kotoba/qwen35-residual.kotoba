;; The residual adds of kernel/qwen35_infer.c in Kotoba (JUN-554): state[i] += x[i] over binary32 vectors, the one
;; operation each layer's FFN, linear attention and full attention end with (amu ADR 0391's native f32: addss under the
;; kernel's MXCSR, round to nearest even, no FTZ / DAZ, x86's default NaN -- the code the C compiles to).
;;
;; add(state, n, x, n): n bytes (8..16384, a multiple of 8) of little-endian binary32 at each; state[i] = state[i] +
;; x[i] for every element, two per 64-bit access (the 16 KiB window tier has no 32-bit store). The C calls it per
;; 16384-byte chunk; every element's add is independent, so the chunking changes no result. Answers 1; 0 with nothing
;; written for a null pointer, unequal lengths or a length outside 8..16384 or not a multiple of 8.
(ns aiueos.qwen35-residual (:export [kotoba_aiueos_qwen35_residual_add]))
(defn- sx [v :i64] :i64 (if (>= v 2147483648) (- v 4294967296) v))
(defn- add-bits [a :i64 b :i64] :i64
  (bit-and (f32-to-bits (f32-add (f32-from-bits (sx a)) (f32-from-bits (sx b)))) 4294967295))
(defn- add-pair [p :i64 q :i64] :i64
  (let [lo (add-bits (bit-and p 4294967295) (bit-and q 4294967295))
        hi (add-bits (u64-shift-right p 32) (u64-shift-right q 32))]
    (bit-or lo (i64-shift-left hi 32))))
(defn- walk [s :i64 sn :i64 x :i64 xn :i64 i :i64] :i64
  (if (>= i sn) 1
    (let [w (kernel-store-u64-16k s sn i (add-pair (kernel-load-u64-16k s sn i) (kernel-load-u64-16k x xn i)))]
      (walk s sn x xn (+ (+ i 8) (* 0 w))))))
(defn kotoba_aiueos_qwen35_residual_add [state :i64 sn :i64 x :i64 xn :i64] :i64
  (if (or (= state 0) (= x 0) (not= sn xn) (< sn 8) (> sn 16384) (not= (bit-and sn 7) 0)) 0
    (walk state sn x xn 0)))
