;; The PCI enumeration decisions of kernel/pci.c in Kotoba (JUN-598): what aiueos_virtio_probe and the RTL8125
;; qualification scan decided about each configuration word. The scan loops, the configuration reads and the driver
;; calls stay C.
;;
;; present(id): 1 unless the vendor (id's low 16 bits) is 0xffff, the bus's "nothing here".
;; functions(header): 8 for a multi-function device (header-type bit 7), else 1.
;; virtio-driver(id): 0 when the vendor is not virtio (0x1af4); else which driver its device ID selects -- 2 RNG
;;   (0x1044 / 0x1005), 3 block (0x1042 / 0x1001), 4 input (0x1052 / 0x1012), 5 GPU (0x1050 / 0x1010), 6 net (0x1041 /
;;   0x1000), 7 sound (0x1059, used only in an AIUEOS_AUDIO build) -- or 1 for another virtio device.
;; probe-result(rng, blk, input, gpu, present, virtio): the cascade main.c reads bit by bit -- 15 all four, 7 RNG block
;;   input, 3 RNG block, 2 RNG, else 1 when anything was present and some of it virtio, else 0. Arguments are 0 / 1
;;   flags and counts.
;; rtl8125(id): 1 for vendor 0x10ec device 0x8125.
(ns aiueos.pci-enum (:export [kotoba_aiueos_pci_present kotoba_aiueos_pci_functions kotoba_aiueos_virtio_driver
                              kotoba_aiueos_virtio_probe_result kotoba_aiueos_pci_rtl8125]))
(defn- vendor [id :i64] :i64 (bit-and id 65535))
(defn- device [id :i64] :i64 (bit-and (u64-shift-right (bit-and id 4294967295) 16) 65535))
(defn kotoba_aiueos_pci_present [id :i64] :i64 (if (= (vendor id) 65535) 0 1))
(defn kotoba_aiueos_pci_functions [header :i64] :i64 (if (= (bit-and header 128) 0) 1 8))
(defn kotoba_aiueos_virtio_driver [id :i64] :i64
  (let [d (device id)]
    (cond (not= (vendor id) 6900) 0
          (or (= d 4164) (= d 4101)) 2
          (or (= d 4162) (= d 4097)) 3
          (or (= d 4178) (= d 4114)) 4
          (or (= d 4176) (= d 4112)) 5
          (or (= d 4161) (= d 4096)) 6
          (= d 4185) 7
          :else 1)))
(defn kotoba_aiueos_virtio_probe_result [rng :i64 blk :i64 input :i64 gpu :i64 present :i64 virtio :i64] :i64
  (cond (and (not= rng 0) (not= blk 0) (not= input 0) (not= gpu 0)) 15
        (and (not= rng 0) (not= blk 0) (not= input 0)) 7
        (and (not= rng 0) (not= blk 0)) 3
        (not= rng 0) 2
        (and (not= present 0) (not= virtio 0)) 1
        :else 0))
(defn kotoba_aiueos_pci_rtl8125 [id :i64] :i64 (if (and (= (vendor id) 4332) (= (device id) 33061)) 1 0))
