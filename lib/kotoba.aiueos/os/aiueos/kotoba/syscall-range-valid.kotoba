;; JUN-600: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form and takes no test main; the predicate is unchanged.
(ns aiueos.syscall-range-valid (:export [kotoba_aiueos_syscall_range_valid]))

(defn kotoba_aiueos_syscall_range_valid [pointer length lower upper]
  (and (> upper lower)
       (> length 0)
       (>= pointer lower)
       (< pointer upper)
       (<= length (- upper pointer))))

