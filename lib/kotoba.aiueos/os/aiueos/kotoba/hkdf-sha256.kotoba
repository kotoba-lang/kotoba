;; JUN-708: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form first, takes no test main, exports nothing else and has no :require, so the sha256-core functions
;; this file used are copied in (marked below). The route refuses a literal window on a region with no paired length
;; (E7106), so every helper takes ctx's length right after ctx; after the old ctx-len check the export narrows ctx to
;; its old 800 bytes with kernel-subregion, so every window is the old one whatever ctx-len is. Locals named key-len,
;; label-len, context-len, out-len and msg-len are key-n, label-n, context-n, out-n and msg-n in the code (they are
;; values, not region lengths). The ABI, the arithmetic and the order of accesses are unchanged.
(ns aiueos.hkdf-sha256 (:export [kotoba_aiueos_hkdf_sha256]))

;; HMAC-SHA256 and HKDF-Expand-Label (RFC 5869 + RFC 8446 7.1) for the
;; freestanding aiueos kernel.
;;
;;   (aiueos-hkdf-sha256 ctx ctx-len mode)
;;
;; This replaces the four static functions `kernel/tls13.c` used to derive
;; every TLS 1.3 key from the X25519 shared secret: `hmac_sha256`,
;; `hkdf_extract`, `hkdf_expand_label` and the HMAC half of `finish_check`.
;; ADR-0015 draws the C boundary at MECHANISM. Which bytes become the traffic
;; key -- and therefore who can read the connection -- is not mechanism.
;;
;; ---------------------------------------------------------------------------
;; NOT A BOOLEAN. ZERO IS THE SUCCESS VALUE.
;; ---------------------------------------------------------------------------
;;     0   done, the output is in ctx at offset 64
;;     1   ctx-len below the 800 bytes this object requires
;;     2   mode is neither 0 (HMAC) nor 1 (Expand-Label)
;;     3   key-len above 64
;;     4   context-len above 64
;;     5   label-len above 16
;;     6   EXPAND-LABEL ONLY: out-len outside 1..32
;;
;; ---------------------------------------------------------------------------
;; TWO MODES, AND HKDF-EXTRACT IS NOT ONE OF THEM
;; ---------------------------------------------------------------------------
;; RFC 5869's Extract is `HMAC(salt, ikm)` with the salt as the KEY. That is
;; mode 0 with the salt in the key slot, so it needs no arm of its own -- and
;; the "empty salt means 32 zero bytes" rule the C implements by substituting a
;; buffer is not a rule at all here: HMAC pads its key to the 64-byte block, so
;; a zero-length salt and a 32-zero salt produce THE SAME padded block and
;; therefore the same output. The contract asserts that with a vector rather
;; than asserting it in prose.
;;
;;   mode 0  HMAC-SHA256(key[0..key-len), context[0..context-len))
;;           -> 32 bytes at ctx+64.  This is Extract, and it is also the
;;              Finished MAC: HMAC(finished_key, transcript_hash).
;;   mode 1  HKDF-Expand-Label(secret, label, context, out-len)
;;           -> out-len bytes at ctx+64, REST ZEROED (see below).
;;
;; ---------------------------------------------------------------------------
;; ONE REGION, BECAUSE THE ABI ADMITS FIVE PARAMETERS -- AND THIS USES THREE
;; ---------------------------------------------------------------------------
;;   ctx offset  bytes  what
;;   ----------  -----  ----------------------------------------------------
;;        0        64   key material.  key-len bytes are used; HMAC pads the
;;                      rest of the 64-byte block with zeros
;;       64        32   output
;;       96         1   key-len, 0..64
;;       97         1   label-len, 0..16 (the label WITHOUT "tls13 ")
;;       98         1   context-len, 0..64
;;       99         1   out-len, 1..32 -- mode 1 only
;;      100        12   reserved
;;      112        16   label bytes
;;      128        64   context bytes (the ikm, the transcript hash, or the
;;                      message being MACed)
;;      192       192   message buffer: the 64-byte padded key block followed
;;                      by the payload
;;      384        32   inner hash
;;      416        32   reserved
;;      448       352   SHA-256 workspace
;;      800             end -- ctx-len must be at least this
;;
;; ---------------------------------------------------------------------------
;; THE OUTPUT IS EXACTLY out-len BYTES. THE C RETURNED 32 AND TRUSTED CALLERS.
;; ---------------------------------------------------------------------------
;; `hkdf_expand_label` in C wrote a 32-byte `full` and copied `out_len` of it
;; to the caller, leaving the other 20 bytes of a 12-byte IV derivation live in
;; its own stack frame. Here bytes at and beyond out-len are ZEROED before
;; return, so a caller that reads the whole 32-byte slot cannot come away with
;; key stream it did not ask for -- and a contract vector can assert the whole
;; slot instead of asserting a prefix and shrugging at the rest.
;;
;; ---------------------------------------------------------------------------
;; A KEY LONGER THAN THE BLOCK IS REFUSED, NOT HASHED
;; ---------------------------------------------------------------------------
;; RFC 2104 says a key longer than the block is replaced by its own hash, and
;; the C implemented that branch. No TLS 1.3 derivation reaches it: every key
;; here is a 32-byte secret or a 32-byte finished key. An unreachable branch in
;; a MAC is a second code path that nothing tests, so this object refuses
;; (reason 3) rather than carrying it.
;;
;; SHA-256 is INLINED rather than required from `aiueos.sha256`. Measured
;; 2026-09-02 against amu b1fdaad2: a namespace that declares `(:require ...)`
;; is a multi-module project, and `amu compile` refuses to package one for
;; `x86_64-aiueos-kernel-v1` at all (`:kotoba.error/namespace-require-needs-
;; project`, and `--unpinned` does not change it). That is why
;; `cid-v1-admit.kotoba` has no committed `.o` beside it. The duplication is
;; the one ADR-0021 already pays for between `ipv4-checksum` and
;; `ipv4-icmp-reply-valid`, and this copy is bounded at 192 message bytes
;; rather than the 12,288 `sha256.kotoba` admits, because HMAC only ever hashes
;; a padded key block plus an info string.

;; --- SHA-256 ---------------------------------------------------------------
;; REQUIRED, not inlined. It used to be copied in here, and this file said
;; why: a namespace declaring `(:require ...)` could not be packaged for
;; `x86_64-aiueos-kernel-v1` at all. amu#742 removed that refusal, so the
;; core moved to `aiueos.lib.sha256-core` and `cl`/`cs`/`sha-run` are
;; imported. The bytes of this object change; the admission vectors do not.


;; --- HMAC ------------------------------------------------------------------

;; Inlined from aiueos/lib/sha256_core.kotoba (the native route has no :require): cl, cs, u32, bxor3, rotr2, rotr6, rotr7, rotr11, rotr13, rotr17, rotr18, rotr19, rotr22, rotr25, shr3, shr10, load32, store32, store-out32, round-k, length-byte, msg-byte, prepare, extend, copy-working, copy-round, round-block, add-state, process-blocks, initialize, emit-output, sha-run.
(defn- cl [ctx ctx-len i] (kernel-load-u8-4k ctx ctx-len i))


(defn- cs [ctx ctx-len i v] (kernel-store-u8-4k ctx ctx-len i v))

(defn- u32 [x] (bit-and x 4294967295))


(defn- bxor3 [a b c] (bit-xor (bit-xor a b) c))


(defn- rotr2 [x] (u32 (+ (quot x 4) (* (bit-and x 3) 1073741824))))


(defn- rotr6 [x] (u32 (+ (quot x 64) (* (bit-and x 63) 67108864))))


(defn- rotr7 [x] (u32 (+ (quot x 128) (* (bit-and x 127) 33554432))))


(defn- rotr11 [x] (u32 (+ (quot x 2048) (* (bit-and x 2047) 2097152))))


(defn- rotr13 [x] (u32 (+ (quot x 8192) (* (bit-and x 8191) 524288))))


(defn- rotr17 [x] (u32 (+ (quot x 131072) (* (bit-and x 131071) 32768))))


(defn- rotr18 [x] (u32 (+ (quot x 262144) (* (bit-and x 262143) 16384))))


(defn- rotr19 [x] (u32 (+ (quot x 524288) (* (bit-and x 524287) 8192))))


(defn- rotr22 [x] (u32 (+ (quot x 4194304) (* (bit-and x 4194303) 1024))))


(defn- rotr25 [x] (u32 (+ (quot x 33554432) (* (bit-and x 33554431) 128))))


(defn- shr3 [x] (quot x 8))


(defn- shr10 [x] (quot x 1024))

(defn- load32 [ctx ctx-len word]
  (let [offset (+ 448 (* word 4))]
    (+ (* (cl ctx ctx-len offset) 16777216)
       (+ (* (cl ctx ctx-len (+ offset 1)) 65536)
          (+ (* (cl ctx ctx-len (+ offset 2)) 256)
             (cl ctx ctx-len (+ offset 3)))))))

(defn- store32 [ctx ctx-len word value]
  (let [offset (+ 448 (* word 4))
        s0 (cs ctx ctx-len offset (bit-and (quot value 16777216) 255))
        s1 (cs ctx ctx-len (+ offset 1) (bit-and (quot value 65536) 255))
        s2 (cs ctx ctx-len (+ offset 2) (bit-and (quot value 256) 255))]
    (+ (cs ctx ctx-len (+ offset 3) (bit-and value 255))
       (* 0 (+ s0 (+ s1 s2))))))

(defn- store-out32 [ctx ctx-len dest word value]
  (let [offset (+ dest (* word 4))
        s0 (cs ctx ctx-len offset (bit-and (quot value 16777216) 255))
        s1 (cs ctx ctx-len (+ offset 1) (bit-and (quot value 65536) 255))
        s2 (cs ctx ctx-len (+ offset 2) (bit-and (quot value 256) 255))]
    (+ (cs ctx ctx-len (+ offset 3) (bit-and value 255))
       (* 0 (+ s0 (+ s1 s2))))))

(defn- round-k [i]
  (if (= i 0) 1116352408 (if (= i 1) 1899447441 (if (= i 2) 3049323471 (if (= i 3) 3921009573
  (if (= i 4) 961987163 (if (= i 5) 1508970993 (if (= i 6) 2453635748 (if (= i 7) 2870763221
  (if (= i 8) 3624381080 (if (= i 9) 310598401 (if (= i 10) 607225278 (if (= i 11) 1426881987
  (if (= i 12) 1925078388 (if (= i 13) 2162078206 (if (= i 14) 2614888103 (if (= i 15) 3248222580
  (if (= i 16) 3835390401 (if (= i 17) 4022224774 (if (= i 18) 264347078 (if (= i 19) 604807628
  (if (= i 20) 770255983 (if (= i 21) 1249150122 (if (= i 22) 1555081692 (if (= i 23) 1996064986
  (if (= i 24) 2554220882 (if (= i 25) 2821834349 (if (= i 26) 2952996808 (if (= i 27) 3210313671
  (if (= i 28) 3336571891 (if (= i 29) 3584528711 (if (= i 30) 113926993 (if (= i 31) 338241895
  (if (= i 32) 666307205 (if (= i 33) 773529912 (if (= i 34) 1294757372 (if (= i 35) 1396182291
  (if (= i 36) 1695183700 (if (= i 37) 1986661051 (if (= i 38) 2177026350 (if (= i 39) 2456956037
  (if (= i 40) 2730485921 (if (= i 41) 2820302411 (if (= i 42) 3259730800 (if (= i 43) 3345764771
  (if (= i 44) 3516065817 (if (= i 45) 3600352804 (if (= i 46) 4094571909 (if (= i 47) 275423344
  (if (= i 48) 430227734 (if (= i 49) 506948616 (if (= i 50) 659060556 (if (= i 51) 883997877
  (if (= i 52) 958139571 (if (= i 53) 1322822218 (if (= i 54) 1537002063 (if (= i 55) 1747873779
  (if (= i 56) 1955562222 (if (= i 57) 2024104815 (if (= i 58) 2227730452 (if (= i 59) 2361852424
  (if (= i 60) 2428436474 (if (= i 61) 2756734187 (if (= i 62) 3204031479 3329325298
  ))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))

(defn- length-byte [length position]
  (let [bits (* length 8)]
    (if (= position 0) (bit-and (quot bits 72057594037927936) 255)
    (if (= position 1) (bit-and (quot bits 281474976710656) 255)
    (if (= position 2) (bit-and (quot bits 1099511627776) 255)
    (if (= position 3) (bit-and (quot bits 4294967296) 255)
    (if (= position 4) (bit-and (quot bits 16777216) 255)
    (if (= position 5) (bit-and (quot bits 65536) 255)
    (if (= position 6) (bit-and (quot bits 256) 255)
      (bit-and bits 255))))))))))

;; The message always lives in this object's own buffer at 192, so unlike
;; `sha256.kotoba`'s `block-byte` there is no separate input region: the padding
;; and the length field are synthesised, never stored.
(defn- msg-byte [ctx ctx-len msg-n base index]
  (let [global (+ base index)
        total (* (quot (+ msg-n 72) 64) 64)
        length-start (- total 8)]
    (if (< global msg-n) (cl ctx ctx-len (+ 192 global))
      (if (= global msg-n) 128
        (if (>= global length-start)
          (length-byte msg-n (- global length-start))
          0)))))

(defn- prepare [ctx ctx-len msg-n base i]
  (if (= i 16) 1
    (let [j (* i 4)
          value (+ (* (msg-byte ctx ctx-len msg-n base j) 16777216)
                   (+ (* (msg-byte ctx ctx-len msg-n base (+ j 1)) 65536)
                      (+ (* (msg-byte ctx ctx-len msg-n base (+ j 2)) 256)
                         (msg-byte ctx ctx-len msg-n base (+ j 3)))))
          stored (store32 ctx ctx-len i value)]
      (prepare ctx ctx-len msg-n base (+ i 1 (* 0 stored))))))

(defn- extend [ctx ctx-len i]
  (if (= i 64) 1
    (let [x (load32 ctx ctx-len (- i 15))
          y (load32 ctx ctx-len (- i 2))
          s0 (bxor3 (rotr7 x) (rotr18 x) (shr3 x))
          s1 (bxor3 (rotr17 y) (rotr19 y) (shr10 y))
          value (u32 (+ (load32 ctx ctx-len (- i 16))
                        (+ s0 (+ (load32 ctx ctx-len (- i 7)) s1))))
          stored (store32 ctx ctx-len i value)]
      (extend ctx ctx-len (+ i 1 (* 0 stored))))))

(defn- copy-working [ctx ctx-len i]
  (if (= i 8) 1
    (let [stored (store32 ctx ctx-len (+ 72 i) (load32 ctx ctx-len (+ 64 i)))]
      (copy-working ctx ctx-len (+ i 1 (* 0 stored))))))

(defn- copy-round [ctx ctx-len i]
  (if (= i 8) 1
    (let [stored (store32 ctx ctx-len (+ 72 i) (load32 ctx ctx-len (+ 80 i)))]
      (copy-round ctx ctx-len (+ i 1 (* 0 stored))))))

(defn- round-block [ctx ctx-len i]
  (if (= i 64) 1
    (let [a (load32 ctx ctx-len 72) b (load32 ctx ctx-len 73)
          c (load32 ctx ctx-len 74) d (load32 ctx ctx-len 75)
          e (load32 ctx ctx-len 76) f (load32 ctx ctx-len 77)
          g (load32 ctx ctx-len 78) h (load32 ctx ctx-len 79)
          sum1 (bxor3 (rotr6 e) (rotr11 e) (rotr25 e))
          choice (bit-xor (bit-and e f) (bit-and (bit-xor e 4294967295) g))
          temp1 (u32 (+ h (+ sum1 (+ choice (+ (round-k i) (load32 ctx ctx-len i))))))
          sum0 (bxor3 (rotr2 a) (rotr13 a) (rotr22 a))
          majority (bxor3 (bit-and a b) (bit-and a c) (bit-and b c))
          temp2 (u32 (+ sum0 majority))
          s7 (store32 ctx ctx-len 87 g) s6 (store32 ctx ctx-len 86 f)
          s5 (store32 ctx ctx-len 85 e) s4 (store32 ctx ctx-len 84 (u32 (+ d temp1)))
          s3 (store32 ctx ctx-len 83 c) s2 (store32 ctx ctx-len 82 b)
          s1 (store32 ctx ctx-len 81 a) s0 (store32 ctx ctx-len 80 (u32 (+ temp1 temp2)))
          copied (copy-round ctx ctx-len 0)]
      (round-block ctx ctx-len
                   (+ i 1 (* 0 (+ s7 (+ s6 (+ s5 (+ s4 (+ s3 (+ s2 (+ s1 (+ s0 copied))))))))))))))

(defn- add-state [ctx ctx-len i]
  (if (= i 8) 1
    (let [stored (store32 ctx ctx-len (+ 64 i)
                          (u32 (+ (load32 ctx ctx-len (+ 64 i))
                                  (load32 ctx ctx-len (+ 72 i)))))]
      (add-state ctx ctx-len (+ i 1 (* 0 stored))))))

(defn- process-blocks [ctx ctx-len msg-n block total]
  (if (= block total) 1
    (let [prepared (prepare ctx ctx-len msg-n (* block 64) 0)
          extended (extend ctx ctx-len 16)
          copied (copy-working ctx ctx-len 0)
          rounded (round-block ctx ctx-len 0)
          added (add-state ctx ctx-len 0)]
      (process-blocks ctx ctx-len msg-n
                      (+ block 1 (* 0 (+ prepared (+ extended (+ copied (+ rounded added))))))
                      total))))

(defn- initialize [ctx ctx-len]
  (let [s0 (store32 ctx ctx-len 64 1779033703) s1 (store32 ctx ctx-len 65 3144134277)
        s2 (store32 ctx ctx-len 66 1013904242) s3 (store32 ctx ctx-len 67 2773480762)
        s4 (store32 ctx ctx-len 68 1359893119) s5 (store32 ctx ctx-len 69 2600822924)
        s6 (store32 ctx ctx-len 70 528734635) s7 (store32 ctx ctx-len 71 1541459225)]
    (+ 1 (* 0 (+ s0 (+ s1 (+ s2 (+ s3 (+ s4 (+ s5 (+ s6 s7)))))))))))

(defn- emit-output [ctx ctx-len dest i]
  (if (= i 8) 1
    (let [stored (store-out32 ctx ctx-len dest i (load32 ctx ctx-len (+ 64 i)))]
      (emit-output ctx ctx-len dest (+ i 1 (* 0 stored))))))

;; SHA-256 of the first `msg-len` bytes of the message buffer, into `dest`.
(defn- sha-run [ctx ctx-len msg-n dest]
  (let [ini (initialize ctx ctx-len)
        proc (process-blocks ctx ctx-len msg-n 0 (quot (+ msg-n 72) 64))
        emit (emit-output ctx ctx-len dest 0)]
    (+ 1 (* 0 (+ ini (+ proc emit))))))

;; RFC 2104: the key is zero-padded to the 64-byte block and XORed with the
;; pad byte. A key shorter than the block and a key of zeros are therefore the
;; same block, which is why HKDF-Extract needs no zero-salt buffer here.
(defn- write-pad-block [ctx ctx-len key-n padbyte i]
  (if (= i 64) 1
    (let [b (if (< i key-n) (cl ctx ctx-len i) 0)
          s (cs ctx ctx-len (+ 192 i) (bit-xor b padbyte))]
      (write-pad-block ctx ctx-len key-n padbyte (+ i 1 (* 0 s))))))

(defn- copy-into-msg [ctx ctx-len src-off n i]
  (if (= i n) 1
    (let [s (cs ctx ctx-len (+ 256 i) (cl ctx ctx-len (+ src-off i)))]
      (copy-into-msg ctx ctx-len src-off n (+ i 1 (* 0 s))))))

;; --- HKDF-Expand-Label info string (RFC 8446 7.1) --------------------------
;; struct { uint16 length; opaque label<7..255>; opaque context<0..255>; }
;; with the label prefixed by "tls13 ", followed by the single counter byte
;; 0x01 because a 32-byte output needs exactly one HMAC round.

(defn- prefix-byte [i]
  (if (= i 0) 116 (if (= i 1) 108 (if (= i 2) 115
  (if (= i 3) 49 (if (= i 4) 51 32))))))

(defn- write-label-prefix [ctx ctx-len i]
  (if (= i 6) 1
    (let [s (cs ctx ctx-len (+ 259 i) (prefix-byte i))]
      (write-label-prefix ctx ctx-len (+ i 1 (* 0 s))))))

(defn- write-label [ctx ctx-len label-n i]
  (if (= i label-n) 1
    (let [s (cs ctx ctx-len (+ 265 i) (cl ctx ctx-len (+ 112 i)))]
      (write-label ctx ctx-len label-n (+ i 1 (* 0 s))))))

(defn- write-context [ctx ctx-len base context-n i]
  (if (= i context-n) 1
    (let [s (cs ctx ctx-len (+ base i) (cl ctx ctx-len (+ 128 i)))]
      (write-context ctx ctx-len base context-n (+ i 1 (* 0 s))))))

;; The info string starts at 256 -- the message buffer at 192 plus the 64-byte
;; padded key block that precedes it.
(defn- build-info [ctx ctx-len label-n context-n out-n]
  (let [h0 (cs ctx ctx-len 256 0)
        h1 (cs ctx ctx-len 257 out-n)
        h2 (cs ctx ctx-len 258 (+ 6 label-n))
        p (write-label-prefix ctx ctx-len 0)
        l (write-label ctx ctx-len label-n 0)
        c0 (cs ctx ctx-len (+ 265 label-n) context-n)
        c (write-context ctx ctx-len (+ 266 label-n) context-n 0)
        t (cs ctx ctx-len (+ 266 (+ label-n context-n)) 1)]
    (+ 1 (* 0 (+ h0 (+ h1 (+ h2 (+ p (+ l (+ c0 (+ c t)))))))))))

(defn- zero-tail [ctx ctx-len i out-n]
  (if (= i 32) 1
    (let [s (if (>= i out-n) (cs ctx ctx-len (+ 64 i) 0) 0)]
      (zero-tail ctx ctx-len (+ i 1 (* 0 s)) out-n))))

(defn- hmac-mode [ctx ctx-len key-n context-n]
  (let [a (write-pad-block ctx ctx-len key-n 54 0)
        b (copy-into-msg ctx ctx-len 128 context-n 0)
        c (sha-run ctx ctx-len (+ 64 context-n) 384)
        d (write-pad-block ctx ctx-len key-n 92 0)
        e (copy-into-msg ctx ctx-len 384 32 0)
        f (sha-run ctx ctx-len 96 64)]
    (+ 1 (* 0 (+ a (+ b (+ c (+ d (+ e f)))))))))

(defn- expand-label-mode [ctx ctx-len key-n label-n context-n]
  (let [out-n (cl ctx ctx-len 99)
        a (write-pad-block ctx ctx-len key-n 54 0)
        b (build-info ctx ctx-len label-n context-n out-n)
        c (sha-run ctx ctx-len (+ 75 (+ label-n context-n)) 384)
        d (write-pad-block ctx ctx-len key-n 92 0)
        e (copy-into-msg ctx ctx-len 384 32 0)
        f (sha-run ctx ctx-len 96 64)
        g (zero-tail ctx ctx-len 0 out-n)]
    (+ 1 (* 0 (+ a (+ b (+ c (+ d (+ e (+ f g))))))))))

(defn kotoba_aiueos_hkdf_sha256 [ctx ctx-len mode]
  (if (< ctx-len 800) 1
    (if (> mode 1) 2
      (if (< mode 0) 2
        (let [c (kernel-subregion ctx ctx-len 0 800)]
        (let [key-n (cl c 800 96)
              label-n (cl c 800 97)
              context-n (cl c 800 98)
              out-n (cl c 800 99)]
          (if (> key-n 64) 3
            (if (> context-n 64) 4
              (if (> label-n 16) 5
                (if (= mode 0)
                  (* 0 (hmac-mode c 800 key-n context-n))
                  (if (= out-n 0) 6
                    (if (> out-n 32) 6
                      (* 0 (expand-label-mode c 800 key-n label-n context-n))))))))))))))
