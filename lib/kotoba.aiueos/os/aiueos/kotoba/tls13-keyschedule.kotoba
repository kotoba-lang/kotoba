;; The TLS 1.3 key schedule of kernel/tls13.c in Kotoba (JUN-553): HMAC-SHA256 (RFC 2104) and HKDF-Expand-Label (RFC 8446 7.1),
;; byte for byte the C's hmac_sha256 and hkdf_expand_label, over the committed SHA-256 object (kotoba_aiueos_sha256).
;;
;; The C's buffers are this object's own arrays (amu ADR 0385), read and written through ordinary windows (ADR 0387):
;;   .high_bss 0: the HMAC block, 64 + 12288 bytes (the C's hmac_block)     .high_bss 1: the SHA-256 workspace, 512 bytes
;;   .bss 0: info, 256 bytes     .bss 1: the hashed key when the key is longer than 64 bytes     .bss 2: the inner digest
;; Like the C's statics they make the entry points non-reentrant: two calls must not run at the same time.
;; A uint32_t length whose register carries a non-zero upper half is refused (0), so the window lengths are the parameters themselves. The limits are the C's: 64 + data length <= 12288, key and info within their buffers.
(ns aiueos.tls13-keyschedule
  (:export [kotoba_aiueos_tls13_hmac kotoba_aiueos_tls13_hkdf_expand_label]))
(defn- extern-kotoba_aiueos_sha256 [in :i64 n :i64 out :i64 ws :i64 wn :i64] :i64 0)
(defn- highbss-addr-0-12352 [] :i64 0)
(defn- highbss-addr-1-512 [] :i64 0)
(defn- bss-addr-0-256 [] :i64 0)
(defn- bss-addr-1-32 [] :i64 0)
(defn- bss-addr-2-32 [] :i64 0)
(defn- canonical? [x :i64] :bool (= (u64-shift-right x 32) 0))
(defn- sha [in :i64 n :i64 out :i64] :i64 (extern-kotoba_aiueos_sha256 in n out (highbss-addr-1-512) 512))
;; block[i] for i < 64: (key[i] or 0) xor x, the key read from the caller's region
(defn- pad-key [k :i64 kn :i64 x :i64 i :i64] :i64
  (if (>= i 64) 0
    (let [b (if (< i kn) (kernel-load-u8 k kn i) 0)
          w (kernel-store-u8-16k (highbss-addr-0-12352) 12352 i (bit-xor b x))]
      (pad-key k kn x (+ (+ i 1) (* 0 w))))))
;; the same with the 32-byte hashed key (.bss 1)
(defn- pad-kh [x :i64 i :i64] :i64
  (if (>= i 64) 0
    (let [b (if (< i 32) (kernel-load-u8 (bss-addr-1-32) 32 i) 0)
          w (kernel-store-u8-16k (highbss-addr-0-12352) 12352 i (bit-xor b x))]
      (pad-kh x (+ (+ i 1) (* 0 w))))))
(defn- pad [k :i64 kn :i64 x :i64] :i64 (if (> kn 64) (pad-kh x 0) (pad-key k kn x 0)))
;; block[64 + i] = d[i] for i < n
(defn- put-data [d :i64 dn :i64 n :i64 i :i64] :i64
  (if (>= i n) 0
    (let [w (kernel-store-u8-16k (highbss-addr-0-12352) 12352 (+ 64 i) (kernel-load-u8-16k d dn i))]
      (put-data d dn n (+ (+ i 1) (* 0 w))))))
;; block[64 + i] = inner[i] for i < 32
(defn- put-inner [i :i64] :i64
  (if (>= i 32) 0
    (let [w (kernel-store-u8-16k (highbss-addr-0-12352) 12352 (+ 64 i) (kernel-load-u8 (bss-addr-2-32) 32 i))]
      (put-inner (+ (+ i 1) (* 0 w))))))
;; a key longer than 64 bytes is hashed first (into .bss 1); 0 when that hash fails
(defn- key-ok [k :i64 kn :i64] :i64 (if (> kn 64) (if (= (sha k kn (bss-addr-1-32)) 0) 0 1) 1))
;; the outer hash, once block[0..64+n) holds ipad || data: inner = H(block), then H(opad || inner) into out
(defn- finish [k :i64 kn :i64 n :i64 out :i64] :i64
  (if (= (sha (highbss-addr-0-12352) (+ 64 n) (bss-addr-2-32)) 0) 0
    (let [a (pad k kn 92) b (put-inner 0)]
      (if (= (sha (highbss-addr-0-12352) (+ 96 (* 0 (+ a b))) out) 0) 0 1))))
(defn kotoba_aiueos_tls13_hmac [key :i64 key-len :i64 data :i64 data-len :i64 out :i64] :i64
  (if (or (not (canonical? key-len)) (not (canonical? data-len)) (> (+ 64 data-len) 12288)) 0
    (if (= (key-ok key key-len) 0) 0
      (let [a (pad key key-len 54) b (put-data data data-len data-len 0)]
        (finish key key-len (+ data-len (* 0 (+ a b))) out)))))
;; info = out_len (be16) || 6 + label_len || "tls13 " || label || ctx_len || ctx || 0x01, at most 256 bytes
(defn- info-label [l :i64 ln :i64 i :i64] :i64
  (if (>= i ln) 0
    (let [w (kernel-store-u8 (bss-addr-0-256) 256 (+ 9 i) (kernel-load-u8 l ln i))] (info-label l ln (+ (+ i 1) (* 0 w))))))
(defn- info-ctx [c :i64 cn :i64 at :i64 i :i64] :i64
  (if (>= i cn) 0
    (let [w (kernel-store-u8 (bss-addr-0-256) 256 (+ at i) (kernel-load-u8 c cn i))] (info-ctx c cn at (+ (+ i 1) (* 0 w))))))
(defn- info-put [i :i64 v :i64] :i64 (kernel-store-u8 (bss-addr-0-256) 256 i v))
;; out[i] = H's digest (.bss 2 is free again; the expand result is written there) for i < n
(defn- put-out [o :i64 on :i64 n :i64 i :i64] :i64
  (if (>= i n) 0
    (let [w (kernel-store-u8 o on i (kernel-load-u8 (bss-addr-2-32) 32 i))] (put-out o on n (+ (+ i 1) (* 0 w))))))
(defn kotoba_aiueos_tls13_hkdf_expand_label [secret :i64 secret-len :i64 label :i64 label-len :i64 ctx :i64 ctx-len :i64 out :i64 out-len :i64] :i64
  (if (or (not (canonical? secret-len)) (not (canonical? label-len)) (not (canonical? ctx-len)) (not (canonical? out-len))
          (> (+ (+ (+ 6 label-len) ctx-len) 4) 256) (> out-len 32)) 0
      (let [a (info-put 0 (u64-shift-right out-len 8)) b (info-put 1 (bit-and out-len 255)) c (info-put 2 (+ 6 label-len))
            d (+ (info-put 3 116) (+ (info-put 4 108) (+ (info-put 5 115) (+ (info-put 6 49) (+ (info-put 7 51) (info-put 8 32))))))
            e (info-label label label-len 0)
            f (info-put (+ 9 label-len) ctx-len)
            g (info-ctx ctx ctx-len (+ 10 label-len) 0)
            n (+ (+ 10 label-len) ctx-len)
            h (info-put n 1)
            z (* 0 (+ a (+ b (+ c (+ d (+ e (+ f (+ g h))))))))]
        (if (= (key-ok secret secret-len) 0) 0
          (let [p (pad secret secret-len 54) q (put-data (bss-addr-0-256) 256 (+ (+ n 1) z) 0)]
            (if (= (finish secret secret-len (+ (+ n 1) (* 0 (+ p q))) (bss-addr-2-32)) 0) 0
              (+ 1 (* 0 (put-out out out-len out-len 0)))))))))
