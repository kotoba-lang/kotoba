;; JUN-708: built on amu's native object route: the namespace form comes first and exports the C name only, with no
;; test main and private helpers. The export takes the stack's length after the stack (kernel/scheduler.c passes
;; AIUEOS_TASK_STACK_BYTES) and every store names it on the 16 KiB tier, where the old object wrote through a literal
;; 4 KiB window (the route has no 4 KiB tier); the zeroing is tail-recursive. The frame is unchanged.
(ns aiueos.user-context-build (:export [kotoba_aiueos_user_context_build]))

;; The interrupt return frame occupies the final 160 bytes of a bounded
;; 4 KiB kernel stack. All unspecified registers are deliberately zero.
(defn- zero-frame [stack stack-length index total]
  (if (= index 160) (+ 160 total)
    (let [stored (kernel-store-u8-16k stack stack-length (+ 3936 index) 0)]
      (zero-frame stack stack-length (+ index 1) (+ total stored)))))

(defn- store64 [stack stack-length offset value]
  ;; Mask the low byte off before each divide. `quot` is a signed idivq that
  ;; truncates toward zero, NOT an arithmetic shift: for a value with bit 63
  ;; set, (quot value 256) rounds the wrong way and every byte above the first
  ;; comes out wrong. Masking first makes each division exact, and an exact
  ;; division IS the shift. Proven by execution, not argument: without the
  ;; mask, entry 0xFFFFFFFF80100000 stored 0x81100000. Harmless while every
  ;; address stored here is below 2^63 -- which a higher-half kernel address
  ;; is not.
  (let [q1 (quot (bit-and value -256) 256)
        q2 (quot (bit-and q1 -256) 256)
        q3 (quot (bit-and q2 -256) 256)
        q4 (quot (bit-and q3 -256) 256)
        q5 (quot (bit-and q4 -256) 256)
        q6 (quot (bit-and q5 -256) 256)
        q7 (quot (bit-and q6 -256) 256)
        s0 (kernel-store-u8-16k stack stack-length offset (bit-and value 255))
        s1 (kernel-store-u8-16k stack stack-length (+ offset 1) (bit-and q1 255))
        s2 (kernel-store-u8-16k stack stack-length (+ offset 2) (bit-and q2 255))
        s3 (kernel-store-u8-16k stack stack-length (+ offset 3) (bit-and q3 255))
        s4 (kernel-store-u8-16k stack stack-length (+ offset 4) (bit-and q4 255))
        s5 (kernel-store-u8-16k stack stack-length (+ offset 5) (bit-and q5 255))
        s6 (kernel-store-u8-16k stack stack-length (+ offset 6) (bit-and q6 255))
        s7 (kernel-store-u8-16k stack stack-length (+ offset 7) (bit-and q7 255))]
    (+ s0 (+ s1 (+ s2 (+ s3 (+ s4 (+ s5 (+ s6 s7)))))))))

(defn kotoba_aiueos_user_context_build [stack stack-length entry argument user-stack]
  (let [zeroed (zero-frame stack stack-length 0 0)
        argument-sum (store64 stack stack-length 4008 argument)
        entry-sum (store64 stack stack-length 4056 entry)
        cs-sum (store64 stack stack-length 4064 35)
        flags-sum (store64 stack stack-length 4072 514)
        stack-sum (store64 stack stack-length 4080 user-stack)
        ss-sum (store64 stack stack-length 4088 27)
        evidence (+ zeroed (+ argument-sum (+ entry-sum
                   (+ cs-sum (+ flags-sum (+ stack-sum ss-sum))))))]
    (if (>= evidence 160) (+ stack 3936) 0)))

