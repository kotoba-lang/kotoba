;; The next character of the frozen bigram model for a prompt -- the
;; qualification inference the physical K16 performs for the murakumo relay.
;;
;; Retires the decision of `kernel/micro_infer.c`'s `aiueos_micro_infer_next`
;; (ADR-0220). The model itself is `native.micro-infer` -- the same module
;; the pure-native kernel's `relay_line` and `debug_link` reduce with, so the
;; C kernel and the pure-native kernel now answer from ONE table (whose source
;; of truth is contracts/micro-infer-transitions-v1.edn). What this object adds
;; is the C's contract around it: the prompt walk (every byte must be in the
;; vocabulary; the LAST byte is the row), the refusal of an empty row, and
;; the result written into a caller-owned 8-byte record:
;;
;;   aiueos-micro-infer-result-record/v1, 8 bytes
;;     0  u8  token         (the next character)
;;     1  u8  input_index   (vocabulary index of the prompt's last byte)
;;     2  u8  output_index  (vocabulary index of the token)
;;     3  u8  zero
;;     4  u16 score
;;     6  u16 total
;;
;; RETURNS 1 and the record when the model answers, else 0 with the record
;; untouched -- the C's int, and the C's struct left alone on refusal.

(ns aiueos.micro-infer-next
  (:require [native.micro-infer :as mi])
  (:export [aiueos-micro-infer-next main]))

(defn last-index [prompt length at input]
  ;; `input` is the vocabulary index of prompt[at-1] (or -1 before the first
  ;; byte); walk to the end, refusing the first byte outside the vocabulary.
  (if (>= at length)
    input
    (let [v (mi/vocab-index (kernel-load-u8 prompt length at))]
      (if (= v 27)
        -1
        (last-index prompt length (+ at 1) v)))))

(defn aiueos-micro-infer-next [prompt length out]
  (if (or (= length 0) (> length 64))
    0
    (let [input (last-index prompt length 0 -1)]
      (if (< input 0)
        0
        (let [row (mi/micro-infer-row input)
              score (mi/micro-infer-score row)
              total (mi/micro-infer-total row)]
          (if (or (= total 0) (= score 0))
            0
            (let [best (mi/micro-infer-index row)
                  stored (+ (kernel-store-u8 out 8 0 (mi/vocab-value best))
                            (kernel-store-u8 out 8 1 input)
                            (kernel-store-u8 out 8 2 best)
                            (kernel-store-u8 out 8 3 0)
                            (kernel-store-u16 out 8 4 score)
                            (kernel-store-u16 out 8 6 total))]
              (+ 1 (* 0 stored)))))))))

(defn main [] 0)
