(ns aiueos.qwen35-tokenize
  ;; `cp-class` is exported so the parity test can classify a codepoint
  ;; directly instead of inferring the table from where a chunk broke. It is
  ;; not an `aiueos-*` name, so kotoba-native's allowlist neither claims it nor
  ;; refuses it, and `package-kernel-object` packages the entry it is asked for.
  (:export [aiueos-qwen35-tokenize cp-class main]))

;; Text -> Qwen3.5 token ids, over the GGUF vocabulary where it lies.
;;
;; This is llama.cpp's `llm_tokenizer_bpe` for a `gpt2` model with the `qwen2`
;; family pre-tokenizer, which is what `tokenizer.ggml.model` = "gpt2" and
;; `tokenizer.ggml.pre` = "qwen35" name in
;; `contracts/qwen38-qwen35-runtime-v1.edn`. Four stages, in this order:
;;
;;   1. decode the input to codepoints (invalid UTF-8 -> U+FFFD, advance one
;;      byte), which is `unicode_cpts_from_utf8`
;;   2. split into pre-tokens by the qwen2 regex, run as an explicit byte
;;      state machine (see the rule table below)
;;   3. re-encode each pre-token canonically and map every BYTE through the
;;      GPT-2 byte-to-unicode alphabet, which is `unicode_byte_encoding_process`
;;   4. merge greedily by rank until no adjacent pair has one, then look each
;;      surviving symbol up in the vocabulary
;;
;; `aiueos-qwen35-vocab-index-build` has already put a string->id table and a
;; (left id, right id)->rank table in the workspace; this object reads them and
;; the token STRINGS, which stay in the model mapping. Nothing is copied.
;;
;; ## Return
;;
;; **Zero is the success value**, and this object does NOT return a count --
;; the count goes to workspace header slot 64, so that a caller cannot read a
;; refusal as "three tokens". Non-zero is a reason code:
;;
;;      0   tokenized; the id count is in header slot 64
;;     -1   null model base
;;     -2   null workspace base
;;     -3   workspace shorter than the 128-byte header
;;     -4   the workspace carries no index (the KTOK magic is absent)
;;     -5   model window above 16,777,216 bytes
;;     -6   input longer than 32,768 bytes
;;     -7   the input does not lie inside the workspace
;;     -8   the token id output does not lie inside the workspace
;;     -9   the symbol scratch does not lie inside the workspace, or is
;;          smaller than 13,312 bytes
;;    -10   the index tables do not lie inside the workspace
;;    -21   a codepoint above U+10FFFF
;;    -24   a pre-tokenizer chunk above 512 byte-symbols
;;    -25   a surviving symbol is not a vocabulary token
;;    -26   the token id output capacity was exhausted
;;    -27   the pre-tokenizer did not advance
;;
;; ## Where this is narrower than llama.cpp, deliberately
;;
;; -21, -24 and -25 are all refusals llama.cpp does not make.
;;
;; -21: `unicode_cpt_to_utf8` throws on a codepoint above U+10FFFF, and
;; `unicode_regex_split` does not catch it, so llama.cpp aborts the process.
;; The four-byte decoder admits up to U+1FFFFF because llama.cpp's does (it
;; checks continuation bytes and nothing else -- no overlong, surrogate or
;; range check), so this is reachable from a five-byte-lead F7 sequence.
;; Refusing names it.
;;
;; -24: the merge loop rescans one chunk's symbol list to find the lowest-rank
;; adjacent pair, and there are as many merges as symbols, so the loop is
;; QUADRATIC IN ONE CHUNK. A finite fuel bound needs a bound on the chunk.
;; 512 byte-symbols is 512 ASCII letters, or about 170 kana or kanji, with no
;; space, digit or punctuation anywhere in the run -- the pre-tokenizer breaks
;; a chunk at any of those. llama.cpp has no such bound and would tokenize what
;; this refuses.
;;
;; -25: llama.cpp falls back to looking up each single BYTE of an unresolvable
;; symbol as a one-character string, and SILENTLY DROPS the bytes that are not
;; in the vocabulary -- for a byte-level vocabulary those are exactly the
;; continuation bytes, so its fallback emits nothing and the text disappears
;; from the token stream. It cannot trigger on a vocabulary whose merge sides
;; are all tokens (which `vocab-index-build` checks), so refusing costs
;; nothing and losing text silently costs everything.
;;
;; Two more divergences that are not refusals:
;;
;; `unicode_tolower` is ASCII-only here, in the contraction rule. The rule
;; compares against `s t m d r v l e`, and no non-ASCII codepoint lowercases
;; to one of those in the Unicode data llama.cpp generates its tables from.
;;
;; The character classes come from a 122-range table generated from Java's
;; `\p{L}` and `\p{N}` over 24 declared blocks (`cp-class` below); llama.cpp's
;; come from a table generated from Python's `unicodedata` over ALL of
;; Unicode. Inside the declared blocks the two agree and the parity test
;; checks every codepoint of them one at a time. OUTSIDE them this object
;; calls every codepoint "other", which is the same bucket as punctuation,
;; symbols, marks and control characters -- so the divergence is confined to
;; letters and digits of undeclared scripts, where it changes where a chunk
;; breaks and therefore which ids come out. The blocks cover Latin, Greek,
;; Cyrillic, Armenian, Hebrew, Arabic, Thai, the Latin/Greek extended
;; additions, super- and subscripts, number forms, enclosed alphanumerics, the
;; CJK radicals, Hiragana, Katakana, Bopomofo, Hangul (Jamo, compatibility
;; Jamo and syllables), the enclosed and compatibility CJK blocks, CJK
;; Unified Ideographs and extensions A through F, the compatibility
;; ideographs, halfwidth and fullwidth forms, mathematical digits and the
;; emoji blocks. The parity test prints how many codepoints of the rest of
;; the BMP it therefore gets wrong, so the size of the blind spot is a
;; measured number rather than a hope.
;;
;; ## The pre-tokenizer rule table
;;
;; The qwen2 regex, as `tokenizer.ggml.pre` names it, is
;;
;;   (?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])
;;   |[^\r\n\p{L}\p{N}]?\p{L}+|\p{N}| ?[^\s\p{L}\p{N}]+[\r\n]*
;;   |\s*[\r\n]+|\s+(?!\S)|\s+
;;
;; but llama.cpp does NOT run it through a regex engine. `unicode_regex_split`
;; matches that string against a table of preset patterns and dispatches the
;; qwen2 one to `unicode_regex_split_custom_llama3`, the same hand-written
;; splitter llama3 uses -- whose number rule is `\p{N}{1,3}`. So the reference
;; implementation consumes UP TO THREE digits where the metadata's regex says
;; one. This object follows the reference implementation, because that is what
;; produced the ids the model was trained against, and says so here because
;; the two readings disagree on "2026" (["202" "6"] against ["2" "0" "2" "6"]).
;;
;; | # | regex fragment                    | function        |
;; |---|-----------------------------------|-----------------|
;; | 1 | `(?:'[sS]\|'[tT]\|'[rR][eE]\|'[vV][eE]\|'[mM]\|'[lL][lL]\|'[dD])` | `contraction-end` |
;; | 2 | `[^\r\n\p{L}\p{N}]?\p{L}+`        | `letters-end`   |
;; | 3 | `\p{N}{1,3}`                      | `digits-run`    |
;; | 4 | ` ?[^\s\p{L}\p{N}]+[\r\n]*`       | `other-end`     |
;; | 5 | `\s*[\r\n]+`                      | `ws-scan` + slot 96 |
;; | 6 | `\s+(?!\S)`                       | `ws-scan` + slot 120 |
;; | 7 | `\s+`                             | `ws-scan`       |
;; | 8 | (no rule matched: one codepoint)  | `chunk-end` tail |
;;
;; Rules 5-7 share one scan because the reference does: it counts the
;; whitespace run once and then decides which of the three it was. Rule 6 is
;; the lookahead -- a run of two or more whitespace codepoints that is NOT at
;; the end of the input gives up its last codepoint, so the next chunk starts
;; with it and rule 4's leading-space clause can pick it up.
;;
;; ## Scratch (workspace header slots 96..124, this object's use)
;;
;;    96  A  needle byte offset (vocabulary lookup) / last CR-LF end (rule 5)
;;   100  B  needle length      (vocabulary lookup) / whitespace count
;;   104  C  chunk start, an input byte offset
;;   108  D  chunk end,   an input byte offset
;;   112  E  symbol count in the current chunk
;;   116  F  write cursor into the encoded-byte buffer
;;   120  G  byte offset of the last whitespace codepoint (rule 6)
;;   124  H  reserved
;;
;; A and B carry two things because the two never overlap: the whitespace scan
;; runs in `chunk-end`, which finishes before `do-chunk` looks a symbol up.
;;
;; ## Symbol scratch
;;
;; 512 records of 24 bytes, then a 1,024-byte encoded-byte buffer: 13,312.
;;
;;    +0  offset into the encoded buffer
;;    +4  length in bytes (0 = merged away)
;;    +8  next symbol index, or 65535
;;   +12  previous symbol index, or 65535
;;   +16  vocabulary id, or 4294967295
;;   +20  rank of the pair (this, next), or 2147483647
;;
;; The rank is CACHED rather than recomputed, which is what keeps the merge
;; loop's inner scan to one load per symbol. A merge changes exactly two
;; ranks, the merged symbol's and its predecessor's, and both are rewritten.
;; Without the cache the scan would do a hash probe per pair and the quadratic
;; term would be ~15x larger.

;; ----------------------------------------------------------------- readers

(defn u32-at [base length off]
  (kernel-load-u32 (kernel-subregion base length off 4) 4 0))

(defn put-u32 [base length off v]
  (kernel-store-u32 (kernel-subregion base length off 4) 4 0 v))

(defn put-u8 [base length off v]
  (kernel-store-u8 (kernel-subregion base length off 1) 1 0 v))

(defn fnv-bytes [reg len i h]
  (if (= i len) h
    (fnv-bytes reg len (+ i 1)
      (bit-and (* (bit-xor h (kernel-load-u8 (kernel-subregion reg len i 1) 1 0))
                  16777619)
               4294967295))))

(defn fnv-step [h b]
  (bit-and (* (bit-xor h b) 16777619) 4294967295))

(defn fnv-u32 [h v]
  (fnv-step (fnv-step (fnv-step (fnv-step h (bit-and v 255))
                                (bit-and (quot v 256) 255))
                      (bit-and (quot v 65536) 255))
            (bit-and (quot v 16777216) 255)))

(defn bytes-eq [a b len i]
  (if (= i len) 1
    (if (= (kernel-load-u8 (kernel-subregion a len i 1) 1 0)
           (kernel-load-u8 (kernel-subregion b len i 1) 1 0))
      (bytes-eq a b len (+ i 1))
      0)))

;; ------------------------------------------------------- character classes
;;
;; 1 letter (\p{L}), 2 number (\p{N}), 3 whitespace, 0 everything else.
;; A balanced search over 122 ranges: seven comparisons, not 122.
;;
;; The whitespace set is llama.cpp's explicit `unicode_vec_whitespace`
;; (TAB..CR, 1C..20, 85, A0, 1680, 2000..200A, 2028, 2029, 202F, 205F, 3000),
;; not Java's `\s`, and it takes priority over the general category -- U+00A0
;; is a separator AND whitespace, and the state machine asks about whitespace.
(defn cp-class [cp]
  (if (< cp 8126)
      (if (< cp 1162)
        (if (< cp 248)
          (if (< cp 170)
            (if (< cp 65)
              (if (< cp 28)
                (if (< cp 9)
                  0
                  (if (<= cp 13) 3
                    0))
                (if (<= cp 32) 3
                  (if (< cp 48)
                  0
                  (if (<= cp 57) 2
                    0))))
              (if (<= cp 90) 1
                (if (< cp 133)
                (if (< cp 97)
                  0
                  (if (<= cp 122) 1
                    0))
                (if (<= cp 133) 3
                  (if (< cp 160)
                  0
                  (if (<= cp 160) 3
                    0))))))
            (if (<= cp 170) 1
              (if (< cp 186)
              (if (< cp 181)
                (if (< cp 178)
                  0
                  (if (<= cp 179) 2
                    0))
                (if (<= cp 181) 1
                  (if (< cp 185)
                  0
                  (if (<= cp 185) 2
                    0))))
              (if (<= cp 186) 1
                (if (< cp 192)
                (if (< cp 188)
                  0
                  (if (<= cp 190) 2
                    0))
                (if (<= cp 214) 1
                  (if (< cp 216)
                  0
                  (if (<= cp 246) 1
                    0))))))))
          (if (<= cp 705) 1
            (if (< cp 895)
            (if (< cp 750)
              (if (< cp 736)
                (if (< cp 710)
                  0
                  (if (<= cp 721) 1
                    0))
                (if (<= cp 740) 1
                  (if (< cp 748)
                  0
                  (if (<= cp 748) 1
                    0))))
              (if (<= cp 750) 1
                (if (< cp 886)
                (if (< cp 880)
                  0
                  (if (<= cp 884) 1
                    0))
                (if (<= cp 887) 1
                  (if (< cp 890)
                  0
                  (if (<= cp 893) 1
                    0))))))
            (if (<= cp 895) 1
              (if (< cp 910)
              (if (< cp 904)
                (if (< cp 902)
                  0
                  (if (<= cp 902) 1
                    0))
                (if (<= cp 906) 1
                  (if (< cp 908)
                  0
                  (if (<= cp 908) 1
                    0))))
              (if (<= cp 929) 1
                (if (< cp 1015)
                (if (< cp 931)
                  0
                  (if (<= cp 1013) 1
                    0))
                (if (<= cp 1153) 1
                  0))))))))
        (if (<= cp 1327) 1
          (if (< cp 3585)
          (if (< cp 1646)
            (if (< cp 1488)
              (if (< cp 1369)
                (if (< cp 1329)
                  0
                  (if (<= cp 1366) 1
                    0))
                (if (<= cp 1369) 1
                  (if (< cp 1376)
                  0
                  (if (<= cp 1416) 1
                    0))))
              (if (<= cp 1514) 1
                (if (< cp 1568)
                (if (< cp 1519)
                  0
                  (if (<= cp 1522) 1
                    0))
                (if (<= cp 1610) 1
                  (if (< cp 1632)
                  0
                  (if (<= cp 1641) 2
                    0))))))
            (if (<= cp 1647) 1
              (if (< cp 1774)
              (if (< cp 1749)
                (if (< cp 1649)
                  0
                  (if (<= cp 1747) 1
                    0))
                (if (<= cp 1749) 1
                  (if (< cp 1765)
                  0
                  (if (<= cp 1766) 1
                    0))))
              (if (<= cp 1775) 1
