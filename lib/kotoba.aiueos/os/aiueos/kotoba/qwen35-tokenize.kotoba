                (if (<= cp 1788) 1
                  (if (< cp 1791)
                  0
                  (if (<= cp 1791) 1
                    0))))))))
          (if (<= cp 3632) 1
            (if (< cp 8016)
            (if (< cp 7680)
              (if (< cp 3648)
