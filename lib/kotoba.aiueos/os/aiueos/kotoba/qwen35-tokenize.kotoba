;; ---------------------------------------------------------- UTF-8 decoding
;;
;; `unicode_cpt_from_utf8`, including what it does NOT check: no overlong
;; form, no surrogate and no range check, only the continuation bytes. A
;; sequence it rejects becomes U+FFFD and advances ONE byte, which is what
;; `unicode_cpts_from_utf8` does with the exception it would otherwise throw.
;;
;; The result is packed as `length * 2097152 + codepoint` so that one call
;; answers both questions; a codepoint is at most 0x1FFFFF = 2097151, so the
;; two never collide, and 0 means "past the end" because a real decode always
;; carries a length of at least one.

(defn cont-ok [reg len p]
  (if (>= p len) 0
    (if (= 128 (bit-and (kernel-load-u8 (kernel-subregion reg len p 1) 1 0) 192)) 1 0)))

(defn cp-dec [reg len p]
  (if (>= p len) 0
    (let [b0 (kernel-load-u8 (kernel-subregion reg len p 1) 1 0)]
      (if (< b0 128) (+ 2097152 b0)
        (if (< b0 192) 2162685
          (if (< b0 224)
            (if (= 0 (cont-ok reg len (+ p 1))) 2162685
              (+ 4194304 (+ (* (bit-and b0 31) 64)
                            (bit-and (kernel-load-u8 (kernel-subregion reg len (+ p 1) 1) 1 0) 63))))
            (if (< b0 240)
              (if (= 0 (if (= 0 (cont-ok reg len (+ p 1))) 0 (cont-ok reg len (+ p 2)))) 2162685
                (+ 6291456 (+ (* (bit-and b0 15) 4096)
                              (+ (* (bit-and (kernel-load-u8 (kernel-subregion reg len (+ p 1) 1) 1 0) 63) 64)
                                 (bit-and (kernel-load-u8 (kernel-subregion reg len (+ p 2) 1) 1 0) 63)))))
              (if (< b0 248)
                (if (= 0 (if (= 0 (cont-ok reg len (+ p 1))) 0
                           (if (= 0 (cont-ok reg len (+ p 2))) 0
                             (cont-ok reg len (+ p 3))))) 2162685
                  (+ 8388608 (+ (* (bit-and b0 7) 262144)
                                (+ (* (bit-and (kernel-load-u8 (kernel-subregion reg len (+ p 1) 1) 1 0) 63) 4096)
                                   (+ (* (bit-and (kernel-load-u8 (kernel-subregion reg len (+ p 2) 1) 1 0) 63) 64)
                                      (bit-and (kernel-load-u8 (kernel-subregion reg len (+ p 3) 1) 1 0) 63))))))
                2162685))))))))

;; 2162685 = 2097152 + 65533: one byte, U+FFFD.

(defn cp-only [reg len p] (bit-and (cp-dec reg len p) 2097151))

(defn next-p [reg len p]
  (let [d (cp-dec reg len p)]
    (if (= d 0) (+ p 1) (+ p (quot d 2097152)))))

;; -1 past the end, which is llama.cpp's all-zero flags: not whitespace, not a
;; letter, not a number, and `as_uint()` false.
(defn cls-at [reg len p]
  (let [d (cp-dec reg len p)]
    (if (= d 0) -1 (cp-class (bit-and d 2097151)))))

;; ------------------------------------------------------- the pre-tokenizer
;;
;; Every function returns the byte offset just past the chunk it matched, or 0
;; for "this rule did not match". Zero is safe as a sentinel because a match
;; always ends strictly after the position it started at.

(defn lower-ascii [c] (if (>= c 65) (if (<= c 90) (+ c 32) c) c))

;; Rule 1: (?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])
(defn contraction-end [reg len p]
  (if (not (= 39 (cp-only reg len p))) 0
    (let [d1 (cp-dec reg len (+ p 1))]
      (if (= d1 0) 0
        (let [c1 (lower-ascii (bit-and d1 2097151))]
          (if (if (= c1 115) true (if (= c1 116) true (if (= c1 109) true (= c1 100))))
            (+ (+ p 1) (quot d1 2097152))
            (let [q (+ (+ p 1) (quot d1 2097152))]
              (let [d2 (cp-dec reg len q)]
                (if (= d2 0) 0
                  (let [c2 (lower-ascii (bit-and d2 2097151))]
                    (if (if (= c2 101)
                          (if (= c1 114) true (= c1 118))
                          (if (= c1 108) (= c2 108) false))
                      (+ q (quot d2 2097152))
                      0)))))))))))

;; Rule 2: [^\r\n\p{L}\p{N}]?\p{L}+
(defn letters-run [reg len p]
  (if (= 1 (cls-at reg len p)) (letters-run reg len (next-p reg len p)) p))

(defn letters-end [reg len p]
  (let [cp (cp-only reg len p)]
    (if (if (= cp 13) true (if (= cp 10) true (= 2 (cls-at reg len p)))) 0
      (let [q (next-p reg len p)]
        (if (if (= 1 (cls-at reg len p)) true (= 1 (cls-at reg len q)))
          (letters-run reg len q)
          0)))))

;; Rule 3: \p{N}{1,3}
(defn digits-run [reg len p n]
  (if (= n 0) p
    (if (= 2 (cls-at reg len p)) (digits-run reg len (next-p reg len p) (- n 1)) p)))

;; Rule 4: ` ?[^\s\p{L}\p{N}]+[\r\n]*`
(defn other-run [reg len p]
  (if (= 0 (cls-at reg len p)) (other-run reg len (next-p reg len p)) p))

(defn crlf-run [reg len p]
  (let [c (cp-only reg len p)]
    (if (if (= c 13) true (= c 10)) (crlf-run reg len (next-p reg len p)) p)))

(defn other-end [reg len p]
  (let [q (if (= 32 (cp-only reg len p)) (next-p reg len p) p)]
    (if (not (= 0 (cls-at reg len q))) 0
      (crlf-run reg len (other-run reg len q)))))

;; Rules 5-7 share one scan: slot 96 keeps the end of the last CR or LF in the
;; run, slot 100 the codepoint count and slot 120 the start of the last
;; whitespace codepoint. The scan returns the end of the run.
(defn ws-scan [reg len wb wl p]
  (if (not (= 3 (cls-at reg len p))) p
    (do (put-u32 wb wl 100 (+ (u32-at wb wl 100) 1))
        (put-u32 wb wl 120 p)
        (if (if (= 13 (cp-only reg len p)) true (= 10 (cp-only reg len p)))
          (put-u32 wb wl 96 (next-p reg len p))
          0)
        (ws-scan reg len wb wl (next-p reg len p)))))

(defn ws-end [reg len wb wl p]
  (do (put-u32 wb wl 96 0)
      (put-u32 wb wl 100 0)
      (put-u32 wb wl 120 0)
      (let [we (ws-scan reg len wb wl p)]
        (if (> (u32-at wb wl 96) 0) (u32-at wb wl 96)
          (if (if (> (u32-at wb wl 100) 1) (< we len) false)
            (u32-at wb wl 120)
            (if (> (u32-at wb wl 100) 0) we
              (next-p reg len p)))))))

(defn chunk-end [reg len wb wl p]
  (let [c1 (contraction-end reg len p)]
    (if (> c1 0) c1
      (let [c2 (letters-end reg len p)]
        (if (> c2 0) c2
          (if (= 2 (cls-at reg len p)) (digits-run reg len p 3)
            (let [c4 (other-end reg len p)]
              (if (> c4 0) c4
                (ws-end reg len wb wl p)))))))))

;; ---------------------------------------------------- the byte-level alphabet
;;
;; `unicode_byte_to_utf8`: 33..126, 161..172 and 174..255 stand for themselves
;; and everything else moves above U+0100, in ascending byte order --
;; 0x00..0x20 to U+0100..U+0120, 0x7F..0xA0 to U+0121..U+0142, 0xAD to U+0143.
;; That is what makes a space print as `Ġ` in a GPT-2 vocabulary.

(defn byte-cp [b]
  (if (< b 33) (+ 256 b)
    (if (< b 127) b
      (if (< b 161) (+ 162 b)
        (if (< b 173) b
          (if (= b 173) 323 b))))))

;; --------------------------------------------------------------- symbols

(defn sym-get [wb wl i f]
  (u32-at wb wl (+ (u32-at wb wl 68) (+ (* i 24) f))))

(defn sym-put [wb wl i f v]
  (put-u32 wb wl (+ (u32-at wb wl 68) (+ (* i 24) f)) v))

;; One raw byte becomes one symbol whose bytes are that byte's place in the
;; alphabet, encoded as UTF-8. Every mapped codepoint is below U+0800, so the
;; encoding is one byte or two and a symbol is never longer than two.
(defn push-byte [wb wl b]
  (let [e (byte-cp b)]
    (let [n (u32-at wb wl 112)]
      (if (>= n 512) -24
        (let [ec (u32-at wb wl 116)]
          (let [encb (+ (u32-at wb wl 68) 12288)]
            (do (if (< e 128)
                  (put-u8 wb wl (+ encb ec) e)
                  (do (put-u8 wb wl (+ encb ec) (+ 192 (quot e 64)))
                      (put-u8 wb wl (+ encb (+ ec 1)) (+ 128 (bit-and e 63)))))
                (sym-put wb wl n 0 ec)
                (sym-put wb wl n 4 (if (< e 128) 1 2))
                (sym-put wb wl n 8 (+ n 1))
                (sym-put wb wl n 12 (if (= n 0) 65535 (- n 1)))
                (sym-put wb wl n 16 4294967295)
                (sym-put wb wl n 20 2147483647)
                (put-u32 wb wl 112 (+ n 1))
                (put-u32 wb wl 116 (+ ec (if (< e 128) 1 2)))
                0)))))))

;; A codepoint contributes the bytes of its CANONICAL encoding, not the bytes
;; it arrived as. That is `unicode_regex_split` rebuilding each word from the
;; codepoint vector before byte-encoding it, and it is why an invalid input
;; byte turns into the three bytes of U+FFFD rather than into itself.
(defn push-cp [wb wl cp]
  (if (< cp 128) (push-byte wb wl cp)
    (if (< cp 2048)
      (let [r (push-byte wb wl (+ 192 (quot cp 64)))]
        (if (< r 0) r (push-byte wb wl (+ 128 (bit-and cp 63)))))
      (if (< cp 65536)
        (let [r (push-byte wb wl (+ 224 (quot cp 4096)))]
          (if (< r 0) r
            (let [s (push-byte wb wl (+ 128 (bit-and (quot cp 64) 63)))]
              (if (< s 0) s (push-byte wb wl (+ 128 (bit-and cp 63)))))))
        (if (> cp 1114111) -21
          (let [r (push-byte wb wl (+ 240 (quot cp 262144)))]
            (if (< r 0) r
              (let [s (push-byte wb wl (+ 128 (bit-and (quot cp 4096) 63)))]
                (if (< s 0) s
                  (let [t (push-byte wb wl (+ 128 (bit-and (quot cp 64) 63)))]
                    (if (< t 0) t
                      (push-byte wb wl (+ 128 (bit-and cp 63))))))))))))))

(defn encode-chunk [reg len wb wl p]
  (if (>= p (u32-at wb wl 108)) 0
    (let [d (cp-dec reg len p)]
      (if (= d 0) 0
        (let [r (push-cp wb wl (bit-and d 2097151))]
          (if (< r 0) r
            (encode-chunk reg len wb wl (+ p (quot d 2097152)))))))))

;; -------------------------------------------------------- vocabulary lookup
;;
;; The needle is in the WORKSPACE (the encoded buffer) and the candidate in the
;; MODEL, so the two comparands come from different regions -- which the byte
;; comparison does not care about, because both arrive as parameters.

(defn tok-slot-eq [mb ml wb wl e]
  (let [pos (u32-at wb wl (+ (u32-at wb wl 20) (* (- e 1) 4)))]
    (let [n (u32-at mb ml pos)]
      (if (not (= n (u32-at wb wl 100))) 0
        (if (= n 0) 1
          (bytes-eq (kernel-subregion mb ml (+ pos 8) n)
                    (kernel-subregion wb wl (u32-at wb wl 96) n)
                    n 0))))))

(defn tok-probe [mb ml wb wl st]
  (if (< st 4194304) -1
    (let [e (u32-at wb wl (+ (u32-at wb wl 24) (* (bit-and st 4194303) 4)))]
      (if (= e 0) -1
        (if (= 1 (tok-slot-eq mb ml wb wl e)) (- e 1)
          (tok-probe mb ml wb wl
                     (+ (* (- (quot st 4194304) 1) 4194304)
                        (bit-and (+ (bit-and st 4194303) 1)
                                 (- (u32-at wb wl 28) 1)))))))))

(defn needle-st [wb wl]
  (+ (* (u32-at wb wl 28) 4194304)
     (bit-and (fnv-bytes (kernel-subregion wb wl (u32-at wb wl 96) (u32-at wb wl 100))
                         (u32-at wb wl 100) 0 2166136261)
              (- (u32-at wb wl 28) 1))))

(defn sym-id [mb ml wb wl i]
  (do (put-u32 wb wl 96 (+ (+ (u32-at wb wl 68) 12288) (sym-get wb wl i 0)))
      (put-u32 wb wl 100 (sym-get wb wl i 4))
      (tok-probe mb ml wb wl (needle-st wb wl))))

;; -------------------------------------------------------------- merge rank

(defn merge-probe [wb wl l r st]
  (if (< st 4194304) 2147483647
    (let [cell (+ (u32-at wb wl 32) (* (bit-and st 4194303) 12))]
      (if (= 0 (u32-at wb wl cell)) 2147483647
        (if (if (= (u32-at wb wl cell) (+ l 1))
              (= (u32-at wb wl (+ cell 4)) r)
              false)
          (u32-at wb wl (+ cell 8))
          (merge-probe wb wl l r
                       (+ (* (- (quot st 4194304) 1) 4194304)
                          (bit-and (+ (bit-and st 4194303) 1)
                                   (- (u32-at wb wl 36) 1)))))))))

(defn merge-st [wb wl l r]
  (+ (* (u32-at wb wl 36) 4194304)
     (bit-and (fnv-u32 (fnv-u32 2166136261 l) r) (- (u32-at wb wl 36) 1))))

(defn pair-rank [wb wl i]
  (let [j (sym-get wb wl i 8)]
    (if (= j 65535) 2147483647
      (let [l (sym-get wb wl i 16)]
        (if (= l 4294967295) 2147483647
          (let [r (sym-get wb wl j 16)]
            (if (= r 4294967295) 2147483647
              (merge-probe wb wl l r (merge-st wb wl l r)))))))))

;; ------------------------------------------------------------ the BPE loop
;;
;; llama.cpp keeps a priority queue of bigrams ordered by (rank, left index)
;; and skips the entries a merge invalidated. That is the same sequence of
;; merges as "repeatedly take the live adjacent pair with the lowest rank,
;; leftmost on a tie", which is what this does -- the queue's only other
;; effect is to make each step cheaper, and the cache in slot +20 buys that
;; back without a heap.

(defn best-scan [wb wl i best brank]
  (if (= i 65535) best
    (let [r (sym-get wb wl i 20)]
      (if (< r brank)
        (best-scan wb wl (sym-get wb wl i 8) i r)
        (best-scan wb wl (sym-get wb wl i 8) best brank)))))

(defn bpe-step [mb ml wb wl n]
  (if (= n 0) 0
    (let [i (best-scan wb wl 0 65535 2147483647)]
      (if (= i 65535) 0
        (let [j (sym-get wb wl i 8)]
          (do (sym-put wb wl i 4 (+ (sym-get wb wl i 4) (sym-get wb wl j 4)))
              (sym-put wb wl i 8 (sym-get wb wl j 8))
              (sym-put wb wl j 4 0)
              (if (= (sym-get wb wl i 8) 65535) 0
                (sym-put wb wl (sym-get wb wl i 8) 12 i))
              (let [id (sym-id mb ml wb wl i)]
                (do (sym-put wb wl i 16 (if (< id 0) 4294967295 id))
                    (sym-put wb wl i 20 (pair-rank wb wl i))
                    (if (= (sym-get wb wl i 12) 65535) 0
                      (sym-put wb wl (sym-get wb wl i 12) 20
                               (pair-rank wb wl (sym-get wb wl i 12))))
                    (bpe-step mb ml wb wl (- n 1))))))))))

;; ------------------------------------------------------------------ emit

(defn emit [wb wl i k]
  (if (= i 65535) k
    (let [id (sym-get wb wl i 16)]
      (if (= id 4294967295) -25
        (if (>= k (u32-at wb wl 60)) -26
          (do (put-u32 wb wl (+ (u32-at wb wl 56) (* k 4)) id)
              (emit wb wl (sym-get wb wl i 8) (+ k 1))))))))

(defn assign-ids [mb ml wb wl i]
  (if (>= i (u32-at wb wl 112)) 0
    (let [id (sym-id mb ml wb wl i)]
      (if (< id 0) -25
        (do (sym-put wb wl i 16 id)
            (assign-ids mb ml wb wl (+ i 1)))))))

(defn assign-ranks [wb wl i]
  (if (>= i (u32-at wb wl 112)) 0
    (do (sym-put wb wl i 20 (pair-rank wb wl i))
        (assign-ranks wb wl (+ i 1)))))

(defn do-chunk [mb ml wb wl]
  (do (put-u32 wb wl 112 0)
      (put-u32 wb wl 116 0)
      (let [r (encode-chunk (kernel-subregion wb wl (u32-at wb wl 48) (u32-at wb wl 52))
                            (u32-at wb wl 52) wb wl (u32-at wb wl 104))]
        (if (< r 0) r
          (let [n (u32-at wb wl 112)]
            (if (= n 0) 0
              (do (sym-put wb wl (- n 1) 8 65535)
                  (let [a (assign-ids mb ml wb wl 0)]
                    (if (< a 0) a
                      (do (assign-ranks wb wl 0)
                          (bpe-step mb ml wb wl n)
                          (let [k (emit wb wl 0 (u32-at wb wl 64))]
                            (if (< k 0) k
                              (do (put-u32 wb wl 64 k) 0)))))))))))))

;; ------------------------------------------------------------- the walk
;;
;; Two levels, because the KIR oracle recurses on its host stack: a 32,768-byte
;; input can hold 32,768 chunks and the interpreter would need that many host
;; frames even though the backends turn a self tail call into a jump.

(defn split-n [mb ml wb wl n]
  (if (= n 0) 0
    (let [p (u32-at wb wl 104)]
      (if (>= p (u32-at wb wl 52)) 0
        (let [e (chunk-end (kernel-subregion wb wl (u32-at wb wl 48) (u32-at wb wl 52))
                           (u32-at wb wl 52) wb wl p)]
          (if (<= e p) -27
            (do (put-u32 wb wl 104 p)
                (put-u32 wb wl 108 e)
                (let [r (do-chunk mb ml wb wl)]
                  (if (< r 0) r
                    (do (put-u32 wb wl 104 e)
                        (split-n mb ml wb wl (- n 1))))))))))))

(defn split-loop [mb ml wb wl remaining]
  (if (= remaining 0) 0
    (if (>= (u32-at wb wl 104) (u32-at wb wl 52)) 0
      (let [c (if (> remaining 256) 256 remaining)]
        (let [r (split-n mb ml wb wl c)]
          (if (< r 0) r (split-loop mb ml wb wl (- remaining c))))))))

;; -------------------------------------------------------------- the entry

(defn run-tokenize [mb ml wb wl]
  (do (put-u32 wb wl 64 0)
      (put-u32 wb wl 104 0)
      (split-loop mb ml wb wl (u32-at wb wl 52))))

(defn aiueos-qwen35-tokenize [mb ml wb wl]
  (if (= mb 0) -1
    (if (= wb 0) -2
      (if (< wl 128) -3
        (if (not (= (u32-at wb wl 0) 1263816523)) -4
          (if (> ml 16777216) -5
            (if (> (u32-at wb wl 52) 32768) -6
              (if (> (+ (u32-at wb wl 48) (u32-at wb wl 52)) wl) -7
                (if (> (+ (u32-at wb wl 56) (* 4 (u32-at wb wl 60))) wl) -8
                  (if (if (< (u32-at wb wl 72) 13312) true
                        (> (+ (u32-at wb wl 68) (u32-at wb wl 72)) wl)) -9
                    (if (> (u32-at wb wl 40) wl) -10
                      (run-tokenize mb ml wb wl))))))))))))

(defn main [] 0)
