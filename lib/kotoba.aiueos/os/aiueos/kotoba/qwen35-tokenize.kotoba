          (if (<= cp 8329) 2
            (if (< cp 12293)
            (if (< cp 8581)
              (if (< cp 8528)
                (if (< cp 8336)
                  0
                  (if (<= cp 8348) 1
                    0))
                (if (<= cp 8578) 2
                  (if (< cp 8579)
                  0
                  (if (<= cp 8580) 1
                    0))))
              (if (<= cp 8585) 2
                (if (< cp 9450)
                (if (< cp 9312)
