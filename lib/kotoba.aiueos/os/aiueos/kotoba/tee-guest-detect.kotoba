(ns tee-guest-detect
  "Is this CPU a TDX or an SEV-SNP confidential VM? The guest's own answer.

  The mechanism (guest `cpuid`, guest RDMSR, the firmware ranges) lives in
  the kernel C; the DECISION lives here, compiled to a Kotoba object and
  called from `kernel/cpu.c`. The split is the same one
  `cpu-feature-nx.kotoba` documents: the C owns the instruction, the
  object owns which leaf, which bit, and what it means.

  Both profiles, from the vendors' specifications:

  * TDX (Intel TDX module, CPUID leaf 0x21): the hypervisor virtualises
    CPUID leaf 0x21 -- \"Intel TDX\" -- for a TD. The older detection route
    (leaf 1 ECX bit 32 / the ASE 0x12 MSR) is not how a TD self-reports:
    inside a TD the hardware masks it, and the guest's trust anchor is the
    TDVF firmware, which reaches the guest only as a measured page range.
    So the answer is leaf 0x21 AND the TDVF range actually mapped --
    a leaf alone would also be settable by a lying plain VM's CPUID, and
    the range alone would also match a plain OVMF image; the conjunction
    is the claim.
  * SEV-SNP (AMD 24593): CPUID Fn8000_001F -- SEV bit (EDX 31), SEV-SNP
    bit (EDX 11; SEV-ES is EDX 10) -- plus the two firmware pages every
    SNP guest owns: the secrets page and the CPUID page, placed by the
    firmware layout this kernel links against.

  Everything returned is 1/0 or a packed code; the C caller maps those to
  its own enums, so the ABI is fixed-width integers on both sides."
  (:export [tdx-guest-p snp-cpuid-leaf
            tdvf-range-floor tdvf-range-ceiling
            snp-secrets-gpa snp-cpuid-gpa
            in-tdvf-range tdx-detect snp-detect]))

;; TDX CPUID leaf 0x21 -- \"Intel TDX\". Vendor string on it is
;; \"Intel(R)TDX    \"; this object receives the boolean the C probe
;; already extracted from the string, because string compare is not a
;; decision and would only restate the C.
(defn tdx-guest-p [] :i64 21)

;; TDVF is mapped just under 4 GiB in the OVMF/TDVF layouts. The precise
;; base comes from the firmware build; the constants here are the floor
;; and ceiling of the region this kernel accepts, and the caller passes
;; the actual mapped base and size for the in-range test.
(defn tdvf-range-floor [] :i64 4261412864)     ;; 0xFE000000
(defn tdvf-range-ceiling [] :i64 4294967296)   ;; 4 GiB

(defn in-tdvf-range [base size] :i64
  (if (< base (tdvf-range-floor))
    0
    (if (< size 1048576)                       ;; a window under 1 MiB is not TDVF
      0
      (if (> (+ base size) (tdvf-range-ceiling))
        0
        1))))

;; SEV-SNP CPUID Fn8000_001F: EDX bit 31 = SEV, bit 11 = SNP. The C probe
;; reads the leaf and hands one packed word here -- SEV in bit 0, SNP in
;; bit 1 -- because two booleans from one register is one fact, not two.
(defn snp-cpuid-leaf [] :i64 2147483695)       ;; Fn8000_001F

(defn snp-secrets-gpa [] :i64 4293918720)      ;; 0xFFC00000 region per layout
(defn snp-cpuid-gpa [] :i64 4294959104)        ;; 0xFFF00000 region per layout

;; The TDX decision: leaf 0x21 virtualised AND the mapped firmware window
;; verifies in-range. Inputs are what the C probe measured, in the order
;; (leaf-21-present, mapped-base, mapped-size).
(defn tdx-detect [leaf-21 mapped-base mapped-size] :i64
  (if (not (= leaf-21 1))
    0
    (if (= (in-tdvf-range mapped-base mapped-size) 1) 1 0)))

;; The SNP decision: SEV bit AND SNP bit in the packed Fn8000_001F word.
;; The secrets
;; and CPUID pages are placed by firmware unconditionally in a valid SNP
;; launch; their absence is a launch failure the firmware already refuses,
;; so the guest's own decision needs only the CPUID conjunction.
;; Input: packed SEV (bit 0) / SNP (bit 1) from the C probe.
(defn snp-detect [packed] :i64
  (if (= (bit-and packed 1) 1)
    (if (= (bit-and packed 2) 2) 1 0)
    0))
