;; The device window of one virtio PCI capability, for kernel/pci.c's map_transport (JUN-598, JUN-600): the BAR's
;; base plus the capability's offset, the address the C then hands to aiueos_map_pci_mmio and keeps as the common
;; configuration or the notify base.
;;
;; window(bar, offset, length): answers bar + offset, or 0 when the window cannot be formed. The C refused only a sum
;; that wrapped past 2^64 (`common_bar + caps->common.offset < common_bar`). Here the arithmetic is signed i64, so the
;; refusal is stated as bounds instead of a wrap test, and the bounds keep every sum far from 2^63:
;;   bar       in 1 .. 2^62    kotoba/pci-bar.o answers 0 for no BAR, and a base past 2^62 (a 64-bit BAR whose high
;;                             word is past 0x3fffffff) is past the 2^40 aperture kotoba/mmio-map-admit.o admits, so
;;                             map_transport failed for it before as well -- only later, in the admission
;;   offset    in 0 .. 2^32-1  struct virtio_pci_cap's offset is a u32
;;   length    in 1 .. 2^32-1  a u32, and kotoba/virtio-cap-valid.o has refused a zero one already
;; A window of 0 is never an answer, because bar is at least 1.
(ns aiueos.virtio-window (:export [kotoba_aiueos_virtio_window]))
(defn kotoba_aiueos_virtio_window [bar :i64 offset :i64 length :i64] :i64
  (if (or (<= bar 0) (> bar 4611686018427387904) (< offset 0) (> offset 4294967295)
          (<= length 0) (> length 4294967295)) 0
    (+ bar offset)))
