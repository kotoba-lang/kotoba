;; virtio_blk_sector_io_ex's completion wait of kernel/pci.c in Kotoba (JUN-598), over amu ADR 0392's
;; kernel-wait-interrupt and ADR 0393's kernel-pause.
;;
;; wait(used, 4096, counter, 8, target, msix, start, rounds): rounds iterations (1..65536) of the C's loop, numbered from
;; start. Each checks completion -- the used index (u16 @2) equals target and, when msix is set, the block interrupt
;; counter (u64 @counter) has reached target, the counter read before the index as the C read them, so a completion
;; it already counted is not missed -- and answers iteration << 2 | 1 then. Else, when the used index has
;; passed target (it differs and (index - target) mod 2^16 < 0x8000, so no later completion can make them equal), it
;; answers index << 2 | 2. Else it waits: halts until the next interrupt (sti; hlt; cli) with msix set, otherwise spins
;; once with pause. After the last iteration's wait it answers 3, so the C calls it again from start + rounds until its
;; own budget is spent. Answers 0 for a null pointer, a wrong length, rounds outside 1..65536, target past 16 bits,
;; msix other than 0 / 1, or start + rounds at or past 2^27 (the C's budget is 10^8).
(ns aiueos.blk-wait (:export [kotoba_aiueos_blk_wait]))
;; state: target bits 0..15, msix bit 16, iteration bits 17..43, rounds left bits 44..60
(defn- wait-rounds [u :i64 un :i64 c :i64 cn :i64 state :i64] :i64
  (let [target (bit-and state 65535) msix (bit-and (u64-shift-right state 16) 1)
        iter (bit-and (u64-shift-right state 17) 134217727) left (bit-and (u64-shift-right state 44) 131071)
        count (kernel-load-u64 c cn 0) index (kernel-load-u16-16k u un 2)]
    (cond (<= left 0) 3
          (and (or (= msix 0) (>= count target)) (= index target)) (+ (* iter 4) 1)
          (and (not= index target) (< (bit-and (- index target) 65535) 32768)) (+ (* index 4) 2)
          (= msix 1) (let [w (kernel-wait-interrupt)]
                       (wait-rounds u un c cn (+ (- state 17592186044416) (+ 131072 (* 0 w)))))
          :else (let [w (kernel-pause)]
                  (wait-rounds u un c cn (+ (- state 17592186044416) (+ 131072 (* 0 w))))))))
(defn kotoba_aiueos_blk_wait [used :i64 un :i64 counter :i64 cn :i64 target :i64 msix :i64 start :i64 rounds :i64] :i64
  (if (or (= used 0) (= counter 0) (not= un 4096) (not= cn 8) (< rounds 1) (> rounds 65536) (< target 0) (> target 65535)
          (< msix 0) (> msix 1) (< start 0) (>= (+ start rounds) 134217728)) 0
    (wait-rounds used un counter cn (+ (+ target (* msix 65536)) (+ (* start 131072) (* rounds 17592186044416))))))
