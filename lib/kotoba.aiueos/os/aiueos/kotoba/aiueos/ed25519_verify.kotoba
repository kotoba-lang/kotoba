;; JUN-757: verification composition over the unchanged canonical OS point
;; and scalar engine. The legacy fixed-message API remains in aiueos.ed25519;
;; this distinct profile consumes the raw-message transcript from streaming SHA.
(ns aiueos.ed25519-verify
  (:require [aiueos.ed25519 :refer [bytes-differ copy-words flip-sign-byte gf-neq l-byte ld8 load-const mod-l point-add point-base point-identity s-lt-l scalar-from-buf scalar-loop unpackneg x-from-buf]] [aiueos.gf25519 :as gf])
  (:export [verify-hash prime-order-key]))
;; Shared equation for a caller-supplied H(R || A || M) in buf448..511.
;; This is an internal-profile building block, not Ed25519ph and not a
;; signature over an arbitrary digest. The caller must compute that exact
;; raw-message transcript; use aiueos.ed25519-region/verify for bounded inputs.
(defn- verify-hash-work [buf :i64 ws :i64] :i64
  (let [sc (kernel-subregion ws 4096 0 4096)
        oks (s-lt-l buf 31)
        x1 (x-from-buf sc buf 448 0)
        m (mod-l sc buf 160)
        d2 (load-const sc 208 0 0)
        un (unpackneg sc buf)]
    (if (and (= oks 1) (= un 1))
      (let [sk (scalar-from-buf sc buf 160 0)
            id1 (point-identity sc)
            l1 (scalar-loop sc 255)
            sv (copy-words sc 440 0 64 0)
            id2 (point-identity sc)
            bs (point-base sc)
            ss (scalar-from-buf sc buf 64 0)
            l2 (scalar-loop sc 255)
            ad (point-add sc 0 440)
            zi (gf/gf-inv sc 256 32)
            tx (gf/gf-mul sc 224 0 256)
            ty (gf/gf-mul sc 240 16 256)
            out (kernel-subregion buf 1024 320 128)
            py (gf/gf-pack sc out 0 240)
            px (gf/gf-pack sc out 32 224)
            fl (flip-sign-byte out)
            diff (bytes-differ buf 320 32 0 0)]
        (+ (if (= diff 0) 1 0) (* 0 (+ x1 (+ m (+ d2 (+ sk (+ id1 (+ l1 (+ sv (+ id2 (+ bs (+ ss (+ l2 (+ ad (+ zi (+ tx (+ ty (+ py (+ px fl))))))))))))))))))))
      0)))

(defn verify-hash [buf length ws workspace-length]
  (if (or (< length 1024) (< workspace-length 4096)) 0
    (verify-hash-work (kernel-subregion buf length 0 1024) (kernel-subregion ws workspace-length 0 4096))))

;; Authority enrollment profile, matching ed25519.selfhost/prime-order-key?:
;; canonical y < p, nonidentity and [L]A = identity. Legacy verify semantics
;; are retained; this stricter API is opt-in. buf1024/ws4096 are caller-owned.
(defn canonical-y [buf i]
  (if (< i 0) 0
    (let [v (if (= i 31) (bit-and (ld8 buf i) 127) (ld8 buf i))
          limit (if (= i 31) 127 (if (= i 0) 237 255))]
      (if (< v limit) 1 (if (> v limit) 0 (canonical-y buf (- i 1)))))))
(defn identity-y [buf i] :bool
  (if (>= i 32) true
    (if (= (if (= i 31) (bit-and (ld8 buf i) 127) (ld8 buf i)) (if (= i 0) 1 0)) (identity-y buf (+ i 1)) false)))
(defn scalar-order [ws i]
  (if (>= i 32) 1 (do (gf/st ws (+ 272 i) (l-byte i)) (scalar-order ws (+ i 1)))))
(defn- prime-order-work [buf :i64 ws :i64] :i64
  (if (and (= (canonical-y buf 31) 1) (not (identity-y buf 0)))
    (let [sc (kernel-subregion ws 4096 0 4096)]
      (if (= (unpackneg sc buf) 1)
        (do (load-const sc 208 0 0) (scalar-order sc 0) (point-identity sc) (scalar-loop sc 255)
            (if (and (= (gf-neq sc buf 0 304) 0) (= (gf-neq sc buf 16 32) 0)) 1 0)) 0)) 0))

(defn prime-order-key [buf length ws workspace-length]
  (if (or (< length 1024) (< workspace-length 4096)) 0
    (prime-order-work (kernel-subregion buf length 0 1024) (kernel-subregion ws workspace-length 0 4096))))

