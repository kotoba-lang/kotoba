(ns aiueos.imgsig (:export [ims-slots ims-required ims-bit ims-step ims-count ims-final]))
;; JUN-813 stage 5a (ADR-0286 amendment 2): the admission rule for an AIUEIMG2 header with several signers.
;; N = 3 pinned signer slots (ids 0..2), M = 2 required. An entry counts only when its key id is a pinned slot that has not
;; already counted and BOTH its Ed25519 and its ML-DSA-65 signature verified; anything else leaves the state unchanged and is never a
;; downgrade. The state is a bit mask of the slots that counted. The byte-level parsing and the two verifiers stay with the caller
;; (the header arrives in pages), so the rule itself is small enough to read at once.
(defn ims-slots [] 3)
(defn ims-required [] 2)
(defn ims-bit [id] (case id 0 1 1 2 2 4 0))
(defn ims-step [seen id ed ml]
  (if (and (< id 3) (and (= ed 1) (= ml 1)))
    (if (= (bit-and seen (ims-bit id)) 0) (bit-or seen (ims-bit id)) seen)
    seen))
(defn ims-count [seen] (+ (bit-and seen 1) (+ (bit-and (u64-shift-right seen 1) 1) (bit-and (u64-shift-right seen 2) 1))))
;; 1 admitted; 4 fewer than M distinct valid signers
(defn ims-final [seen] (if (>= (ims-count seen) 2) 1 4))
