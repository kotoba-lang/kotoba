(ns aiueos.value-runtime-provider-policy
  (:require [aiueos.value-runtime-capability-table :as table])
  (:export [aiueos-value-runtime-provider-status
            aiueos-value-runtime-capability-grant main]))

;; Provider status packs generation[0..15] and active[16]. Generation zero is
;; never published as active. Existing capabilities bind the generation and
;; therefore fail immediately after stop/restart.
(defn aiueos-value-runtime-provider-status
  [generation :i64 active :i64] :i64
  (if (and (> generation 0) (<= generation 65535)
           (or (= active 0) (= active 1)))
    (kernel-publish-value-provider-status
     (+ generation (if (= active 1) 65536 0)))
    0))

(defn grant-rights-valid? [rights :i64] :bool
  (or (= rights 1) (or (= rights 4) (= rights 5))))

(defn aiueos-value-runtime-capability-grant
  [action :i64 slot :i64 generation :i64 rights :i64 owner :i64] :i64
  (let [status (kernel-value-provider-status)
        provider-generation (bit-and status 65535)
        active (bit-and status 65536)]
    (if (= action 1)
      (if (and (= active 65536) (> provider-generation 0)
               (grant-rights-valid? rights))
        (table/aiueos-value-runtime-capability-mutate
         1 slot generation (+ rights (* provider-generation 65536)) owner)
        0)
      (if (= action 2)
        (table/aiueos-value-runtime-capability-mutate
         2 slot generation 0 owner)
        0))))

(defn main [] :i64 0)
