(ns aiueos.value-runtime-cas-verify
  (:require [aiueos.sha256 :as sha]
            [aiueos.digest-equal :as digest])
  (:export [aiueos-value-runtime-cas-verify main]))

;; C-free integrity primitive for a provider-supplied canonical block.
;; EXPECTED is the 32-byte SHA-256 multihash digest from a fixed
;; CIDv1(dag-cbor, sha2-256) envelope. OUTPUT and WORKSPACE are private scratch
;; regions selected by the trusted caller; neither becomes a Handle or Cap.
;; Canonical kotoba.value.v1 decoding and queue-request binding remain separate
;; admission steps and must precede Handle installation.

(defn aiueos-value-runtime-cas-verify
  [block :i64 block-length :i64 expected :i64
   output :i64 workspace :i64] :i64
  (if (and (> block-length 0) (<= block-length 12288))
    (if (= (sha/aiueos-sha256 block block-length output workspace 352) 1)
      (digest/aiueos-digest-equal expected output 32)
      0)
    0))

(defn main [] :i64 0)
