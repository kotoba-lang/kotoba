(ns aiueos.sha512
  (:export [aiueos-sha512 main]))

;; SHA-512 for the freestanding aiueos kernel (FIPS 180-4), mirroring aiueos.sha256: the
;; public entry accepts a bounded 12 KiB message, a 64-byte output and a caller-owned 4096-byte
;; workspace region (only the first 832 bytes are used). Words are u64 in i64 arithmetic: the
;; adds rely on two's-complement wrap-around and the rotates use u64-shift-right, which the
;; guest self-test (FIPS 180-4 vectors, one mutated message) checks. Workspace layout, u64 words:
;; 0..79 message schedule, 80..87 state, 88..95 working variables, 96..103 round copy.
;; Returns 1 on success, 0 when the input or the workspace is out of bounds.
(defn rotr [x n] (bit-or (u64-shift-right x n) (i64-shift-left x (- 64 n))))
(defn bxor3 [a b c] (bit-xor (bit-xor a b) c))
(defn ld [workspace i] (kernel-load-u64-4k workspace 4096 (* i 8)))
(defn st [workspace i value]
  (let [stored (kernel-store-u64-4k workspace 4096 (* i 8) value)]
    (+ 1 (* 0 stored))))

(defn round-k [i]
  (if (= i 0) 4794697086780616226 (if (= i 1) 8158064640168781261 (if (= i 2) -5349999486874862801 (if (= i 3) -1606136188198331460 (if (= i 4) 4131703408338449720 (if (= i 5) 6480981068601479193 (if (= i 6) -7908458776815382629 (if (= i 7) -6116909921290321640 (if (= i 8) -2880145864133508542 (if (= i 9) 1334009975649890238 (if (= i 10) 2608012711638119052 (if (= i 11) 6128411473006802146 (if (= i 12) 8268148722764581231 (if (= i 13) -9160688886553864527 (if (= i 14) -7215885187991268811 (if (= i 15) -4495734319001033068 (if (= i 16) -1973867731355612462 (if (= i 17) -1171420211273849373 (if (= i 18) 1135362057144423861 (if (= i 19) 2597628984639134821 (if (= i 20) 3308224258029322869 (if (= i 21) 5365058923640841347 (if (= i 22) 6679025012923562964 (if (= i 23) 8573033837759648693 (if (= i 24) -7476448914759557205 (if (= i 25) -6327057829258317296 (if (= i 26) -5763719355590565569 (if (= i 27) -4658551843659510044 (if (= i 28) -4116276920077217854 (if (= i 29) -3051310485924567259 (if (= i 30) 489312712824947311 (if (= i 31) 1452737877330783856 (if (= i 32) 2861767655752347644 (if (= i 33) 3322285676063803686 (if (= i 34) 5560940570517711597 (if (= i 35) 5996557281743188959 (if (= i 36) 7280758554555802590 (if (= i 37) 8532644243296465576 (if (= i 38) -9096487096722542874 (if (= i 39) -7894198246740708037 (if (= i 40) -6719396339535248540 (if (= i 41) -6333637450476146687 (if (= i 42) -4446306890439682159 (if (= i 43) -4076793802049405392 (if (= i 44) -3345356375505022440 (if (= i 45) -2983346525034927856 (if (= i 46) -860691631967231958 (if (= i 47) 1182934255886127544 (if (= i 48) 1847814050463011016 (if (= i 49) 2177327727835720531 (if (= i 50) 2830643537854262169 (if (= i 51) 3796741975233480872 (if (= i 52) 4115178125766777443 (if (= i 53) 5681478168544905931 (if (= i 54) 6601373596472566643 (if (= i 55) 7507060721942968483 (if (= i 56) 8399075790359081724 (if (= i 57) 8693463985226723168 (if (= i 58) -8878714635349349518 (if (= i 59) -8302665154208450068 (if (= i 60) -8016688836872298968 (if (= i 61) -6606660893046293015 (if (= i 62) -4685533653050689259 (if (= i 63) -4147400797238176981 (if (= i 64) -3880063495543823972 (if (= i 65) -3348786107499101689 (if (= i 66) -1523767162380948706 (if (= i 67) -757361751448694408 (if (= i 68) 500013540394364858 (if (= i 69) 748580250866718886 (if (= i 70) 1242879168328830382 (if (= i 71) 1977374033974150939 (if (= i 72) 2944078676154940804 (if (= i 73) 3659926193048069267 (if (= i 74) 4368137639120453308 (if (= i 75) 4836135668995329356 (if (= i 76) 5532061633213252278 (if (= i 77) 6448918945643986474 (if (= i 78) 6902733635092675308 7801388544844847127))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))

(defn length-byte [length position]
  (let [bits (* length 8)]
    (if (< position 8) 0
      (bit-and (u64-shift-right bits (* 8 (- 15 position))) 255))))

(defn block-byte [input input-length base index]
  (let [global (+ base index)
        total (* (quot (+ input-length 144) 128) 128)
        length-start (- total 16)]
    (if (< global input-length)
      (kernel-load-u8-16k input input-length global)
      (if (= global input-length) 128
        (if (>= global length-start)
          (length-byte input-length (- global length-start))
          0)))))

(defn word-at [input input-length base j]
  (bit-or (i64-shift-left (block-byte input input-length base j) 56)
  (bit-or (i64-shift-left (block-byte input input-length base (+ j 1)) 48)
  (bit-or (i64-shift-left (block-byte input input-length base (+ j 2)) 40)
  (bit-or (i64-shift-left (block-byte input input-length base (+ j 3)) 32)
  (bit-or (i64-shift-left (block-byte input input-length base (+ j 4)) 24)
  (bit-or (i64-shift-left (block-byte input input-length base (+ j 5)) 16)
  (bit-or (i64-shift-left (block-byte input input-length base (+ j 6)) 8)
          (block-byte input input-length base (+ j 7))))))))))

(defn prepare [input input-length workspace base i]
  (if (= i 16) 1
    (let [stored (st workspace i (word-at input input-length base (* i 8)))]
      (prepare input input-length workspace base (+ i 1 (* 0 stored))))))

(defn extend [workspace i]
  (if (= i 80) 1
    (let [x (ld workspace (- i 15))
          y (ld workspace (- i 2))
          s0 (bxor3 (rotr x 1) (rotr x 8) (u64-shift-right x 7))
          s1 (bxor3 (rotr y 19) (rotr y 61) (u64-shift-right y 6))
          stored (st workspace i (+ (ld workspace (- i 16))
                                    (+ s0 (+ (ld workspace (- i 7)) s1))))]
      (extend workspace (+ i 1 (* 0 stored))))))

(defn copy-working [workspace i]
  (if (= i 8) 1
    (let [stored (st workspace (+ 88 i) (ld workspace (+ 80 i)))]
      (copy-working workspace (+ i 1 (* 0 stored))))))

(defn copy-round [workspace i]
  (if (= i 8) 1
    (let [stored (st workspace (+ 88 i) (ld workspace (+ 96 i)))]
      (copy-round workspace (+ i 1 (* 0 stored))))))

(defn round-block [workspace i]
  (if (= i 80) 1
    (let [a (ld workspace 88) b (ld workspace 89)
          c (ld workspace 90) d (ld workspace 91)
          e (ld workspace 92) f (ld workspace 93)
          g (ld workspace 94) h (ld workspace 95)
          sum1 (bxor3 (rotr e 14) (rotr e 18) (rotr e 41))
          choice (bit-xor (bit-and e f) (bit-and (bit-not e) g))
          temp1 (+ h (+ sum1 (+ choice (+ (round-k i) (ld workspace i)))))
          sum0 (bxor3 (rotr a 28) (rotr a 34) (rotr a 39))
          majority (bxor3 (bit-and a b) (bit-and a c) (bit-and b c))
          temp2 (+ sum0 majority)
          s7 (st workspace 103 g) s6 (st workspace 102 f)
          s5 (st workspace 101 e) s4 (st workspace 100 (+ d temp1))
          s3 (st workspace 99 c) s2 (st workspace 98 b)
          s1 (st workspace 97 a) s0 (st workspace 96 (+ temp1 temp2))
          copied (copy-round workspace 0)]
      (round-block workspace
                   (+ i 1 (* 0 (+ s7 (+ s6 (+ s5 (+ s4 (+ s3 (+ s2 (+ s1 (+ s0 copied))))))))))))))

(defn add-state [workspace i]
  (if (= i 8) 1
    (let [stored (st workspace (+ 80 i) (+ (ld workspace (+ 80 i)) (ld workspace (+ 88 i))))]
      (add-state workspace (+ i 1 (* 0 stored))))))

(defn process-blocks [input input-length workspace block total]
  (if (= block total) 1
    (let [prepared (prepare input input-length workspace (* block 128) 0)
          extended (extend workspace 16)
          copied (copy-working workspace 0)
          rounded (round-block workspace 0)
          added (add-state workspace 0)]
      (process-blocks input input-length workspace
                      (+ block 1 (* 0 (+ prepared (+ extended (+ copied (+ rounded added))))))
                      total))))

(defn initialize [workspace]
  (let [
        s0 (st workspace 80 7640891576956012808)
        s1 (st workspace 81 -4942790177534073029)
        s2 (st workspace 82 4354685564936845355)
        s3 (st workspace 83 -6534734903238641935)
        s4 (st workspace 84 5840696475078001361)
        s5 (st workspace 85 -7276294671716946913)
        s6 (st workspace 86 2270897969802886507)
        s7 (st workspace 87 6620516959819538809)
        done (st workspace 0 0)]
    (+ 1 (* 0 (+ s0 (+ s1 (+ s2 (+ s3 (+ s4 (+ s5 (+ s6 (+ s7 done))))))))))))

(defn out-byte [output at word shift]
  (kernel-store-u8 output 64 at (bit-and (u64-shift-right word shift) 255)))

(defn emit-word [workspace output i]
  (let [w (ld workspace (+ 80 i))
        o (* i 8)
        b0 (out-byte output o w 56) b1 (out-byte output (+ o 1) w 48)
        b2 (out-byte output (+ o 2) w 40) b3 (out-byte output (+ o 3) w 32)
        b4 (out-byte output (+ o 4) w 24) b5 (out-byte output (+ o 5) w 16)
        b6 (out-byte output (+ o 6) w 8) b7 (out-byte output (+ o 7) w 0)]
    (+ 1 (* 0 (+ b0 (+ b1 (+ b2 (+ b3 (+ b4 (+ b5 (+ b6 b7)))))))))))

(defn emit-output [workspace output i]
  (if (= i 8) 1
    (let [stored (emit-word workspace output i)]
      (emit-output workspace output (+ i 1 (* 0 stored))))))

(defn aiueos-sha512 [input input-length output workspace workspace-length]
  (if (or (< input-length 0) (> input-length 12288)) 0
    (if (< workspace-length 4096) 0
      (let [scratch (kernel-subregion workspace workspace-length 0 4096)
            initialized (initialize scratch)
            processed (process-blocks input input-length scratch 0
                                      (quot (+ input-length 144) 128))
            emitted (emit-output scratch output 0)]
        (+ 1 (* 0 (+ initialized (+ processed emitted))))))))

(defn main [] :i64 0)
