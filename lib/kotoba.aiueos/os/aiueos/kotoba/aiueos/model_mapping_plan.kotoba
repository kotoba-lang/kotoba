;; The 2 MiB huge-page mapping plan for a model handed off by the loader:
;; which PDPT slots the identity map of [base, base+size) occupies.
;;
;; Retires the decision of `kernel/model_handoff.c`'s
;; `aiueos_model_mapping_plan` (ADR-0219). The C filled an out-struct; here
;; the plan is WRITTEN INTO A CALLER-OWNED 32-BYTE RECORD and the verdict is
;; the return, because a record cannot be returned across the kernel ABI:
;;
;;   aiueos-model-mapping-plan-record/v1, 32 bytes
;;     0  u64 first_2m
;;     8  u64 last_2m
;;    16  u32 first_pdpt
;;    20  u32 last_pdpt
;;    24  u32 directory_count
;;    28  u32 zero
;;
;; `base` and `size` are the C's uint64_t as bit patterns. Every bound the C
;; checks is far below 2^63, so a negative word here is a value the C would
;; have refused as out of range too; the refusals are written explicitly
;; rather than left to the signed compares.
;;
;; RETURNS 1 and the filled record when the plan exists, else 0 with the
;; record untouched -- which is also what the C did on refusal.

(ns aiueos.model-mapping-plan
  (:export [aiueos-model-mapping-plan plan-verdict main]))

(defn huge-page [] 2097152)
(defn one-gib [] 1073741824)
(defn identity-limit [] 68719476736)          ; 64 GiB
(defn reserved-apic-start [] 3221225472)      ; 3 GiB
(defn reserved-apic-end [] 4294967296)        ; 4 GiB
(defn max-pdpt-directories [] 16)             ; AIUEOS_MODEL_PAGING_PAGES

(defn floor-huge [v] (* (quot v (huge-page)) (huge-page)))

(defn plan-verdict [base size]
  ;; 0 refuses; otherwise (first-pdpt * 256 + directory-count) + 1, which is
  ;; never 0. first-pdpt <= 63 and directory-count <= 16, so the two never
  ;; collide; first_2m / last_2m are re-derived by the writer.
  (if (or (< base 0) (< size 0) (= size 0)
          (not (= (bit-and base (- (huge-page) 1)) 0))
          (< base (one-gib))
          (>= base (identity-limit))
          (> size (- (identity-limit) base)))
    0
    (let [end (+ base size)]
      (if (and (< base (reserved-apic-end)) (> end (reserved-apic-start)))
        0
        (let [first (floor-huge base)
              last (floor-huge (- end 1))
              first-pdpt (quot first (one-gib))
              last-pdpt (quot last (one-gib))
              directories (+ (- last-pdpt first-pdpt) 1)]
          (if (or (= directories 0)
                  (> directories (max-pdpt-directories))
                  (= first-pdpt 0)
                  (and (<= first-pdpt 3) (>= last-pdpt 3)))
            0
            (+ (* first-pdpt 256) directories 1)))))))

(defn store-u64 [out at v]
  ;; two u32 stores; `v` is non-negative here (below 64 GiB)
  (+ (kernel-store-u32 out 32 at (bit-and v 4294967295))
     (kernel-store-u32 out 32 (+ at 4) (quot v 4294967296))))

(defn aiueos-model-mapping-plan [base size out]
  (let [verdict (plan-verdict base size)]
    (if (= verdict 0)
      0
      (let [end (+ base size)
            first (floor-huge base)
            last (floor-huge (- end 1))
            first-pdpt (quot (- verdict 1) 256)
            directories (bit-and (- verdict 1) 255)
            last-pdpt (+ first-pdpt (- directories 1))
            stored (+ (store-u64 out 0 first)
                      (store-u64 out 8 last)
                      (kernel-store-u32 out 32 16 first-pdpt)
                      (kernel-store-u32 out 32 20 last-pdpt)
                      (kernel-store-u32 out 32 24 directories)
                      (kernel-store-u32 out 32 28 0))]
        (+ 1 (* 0 stored))))))

(defn main [] 0)
