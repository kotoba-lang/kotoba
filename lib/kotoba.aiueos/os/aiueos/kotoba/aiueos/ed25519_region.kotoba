;; JUN-757: exact raw-message Ed25519 verification for native netmap inputs.
;; verify(workspace,actual-length,public,32,signature,64,message,actual-bytes).
;; Caller owns16384 bytes. Inputs must be immutable and disjoint from work;
;; input buffers may share read-only storage. Message0..65536 bytes, including
;; the empty message. Public key must have a canonical encoding, be nonidentity
;; and in the prime-order subgroup. This opt-in authority profile retains the
;; legacy verifier API/semantics; it is not Ed25519ph or signing a digest.
;; Return1 accepts,0 refuses. Shape refusals preserve work; all cryptographic
;; paths erase every work byte, even on a bad key/signature. No input writes,
;; heap, IO, key enrollment, authority choice or trusted clock is supplied.
;; No machine-code constant-time or whole-app qualification is claimed.
(ns aiueos.ed25519-region
  (:require [aiueos.ed25519-verify :as e] [aiueos.sha512-stream :as s])
  (:export [verify]))
(defn- separate [work input count]
  (or (= count 0) (<= (+ work 16384) input) (<= (+ input count) work)))
(defn- clear [work i]
  (if (>= i 16384) 1 (do (kernel-store-u8-16k work 16384 i 0) (clear work (+ i 1)))))
(defn- put [work at value] (kernel-store-u8-16k work 16384 at value))
(defn- copy-key [work public signature i]
  (if (>= i 32) 1
    (do (put work (+ 4096 i) (kernel-load-u8 public 32 i))
        (put work (+ 4128 i) (kernel-load-u8 signature 64 i))
        (put work (+ 4160 i) (kernel-load-u8 signature 64 (+ 32 i))) (copy-key work public signature (+ i 1)))))
(defn- hash-prefix [work public signature i]
  (if (>= i 64) 1
    (do (s/stream-byte (kernel-subregion work 16384 5120 4608) 4608
          (if (< i 32) (kernel-load-u8 signature 64 i) (kernel-load-u8 public 32 (- i 32))))
        (hash-prefix work public signature (+ i 1)))))
(defn- hash-message [work message count i]
  (if (>= i count) 1
    (do (s/stream-byte (kernel-subregion work 16384 5120 4608) 4608 (kernel-load-u8-64k message count i))
        (hash-message work message count (+ i 1)))))
(defn- hash-save [work i]
  (if (>= i 64) 1
    (do (put work (+ 4544 i) (s/stream-digest-byte (kernel-subregion work 16384 5120 4608) 4608 i)) (hash-save work (+ i 1)))))
(defn- transcript [work public signature message count]
  (do (s/stream-init (kernel-subregion work 16384 5120 4608) 4608)
      (hash-prefix work public signature 0) (hash-message work message count 0)
      (s/stream-finish (kernel-subregion work 16384 5120 4608) 4608) (hash-save work 0)
      (s/stream-wipe (kernel-subregion work 16384 5120 4608) 4608)
      (e/verify-hash (kernel-subregion work 16384 4096 1024) 1024 (kernel-subregion work 16384 0 4096) 4096)))
(defn- checked [work public signature message count]
  (do (clear work 0) (copy-key work public signature 0)
      (let [ok (if (= (e/prime-order-key (kernel-subregion work 16384 4096 1024) 1024
                         (kernel-subregion work 16384 0 4096) 4096) 1)
                 (transcript work public signature message count) 0)]
        (do (clear work 0) ok))))
(defn verify [work length public public-bytes signature signature-bytes message message-bytes]
  (if (and (>= length 16384) (= public-bytes 32) (= signature-bytes 64) (>= message-bytes 0) (<= message-bytes 65536)
           (separate work public 32) (separate work signature 64) (separate work message message-bytes))
    (checked (kernel-subregion work length 0 16384) (kernel-subregion public public-bytes 0 32)
      (kernel-subregion signature signature-bytes 0 64) message message-bytes) 0))
