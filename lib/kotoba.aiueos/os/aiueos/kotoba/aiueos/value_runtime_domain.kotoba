(ns aiueos.value-runtime-domain
  (:require [aiueos.value-handle-arena :as arena])
  (:export [aiueos-value-runtime-publish-domain main]))

;; The scheduler publishes identity, never location.  The privileged intrinsic
;; v2 binds a domain to one of four non-evicting image-owned arenas before
;; publishing its scalar identity. No v1 offset aliases sealed DMA metadata.
(defn aiueos-value-runtime-publish-domain [domain :i64] :i64
  (if (and (> domain 0) (<= domain 32767))
    (let [page (kernel-register-value-domain domain)]
      (if (> page 0)
        (if (= (arena/aiueos-value-handle-arena page 4096 0 0 0) 1)
          (kernel-publish-current-domain domain) 0)
        0))
    0))

(defn main [] :i64 0)
