(ns aiueos.cid-v1-admit
  (:require [aiueos.sha256 :as sha])
  (:export [aiueos-cid-v1-admit main]))

;; Decides that a block IS the content a binary CIDv1 names.
;;
;; `aiueos.value-runtime-cas-verify` already compares a block against a
;; 32-byte digest, and its contract declares `:identity {:cid-version 1 :codec
;; :dag-cbor :multihash :sha2-256 :digest-bytes 32}` beside it. That
;; declaration is not a check. The caller passes the 32 bytes and asserts the
;; other four fields, so the machine never decides which CID it holds -- only
;; that some digest it was handed matches. Every artifact this device fetches
;; from `https://ipfs.kotobase.net/ipfs/…` (ADR-0118 models, ADR-0122 OS
;; releases) is named by a CID whose four prefix bytes nothing here read.
;;
;; This object reads them, so the CID becomes the identity rather than a URL
;; with a hash beside it.
;;
;; There is deliberately no `required-codec` parameter. The codec the caller
;; wants is the codec in the CID the caller passes; a requirement that comes
;; from STRUCTURE rather than from the CID -- "the links of a UnixFS file node
;; must be raw leaves" -- belongs to the object that knows the structure, not
;; to this one.
;;
;; A 36-byte CID can only carry a one-byte codec: codecs above 0x7f take two
;; varint bytes and produce a 37-byte CID, which reason 1 refuses. That is the
;; right refusal for this fixed-width envelope, and it is a bound rather than
;; a universal truth about CIDv1.

;; 0x55 raw, 0x70 dag-pb, 0x71 dag-cbor. All three are in use here: kotobase's
;; `PUT /ipfs/:cid` takes raw only, UnixFS files are dag-pb, and the value
;; runtime's canonical blocks are dag-cbor.
(defn codec-permitted [codec]
  (if (= codec 85) 1
    (if (= codec 112) 1
      (if (= codec 113) 1 0))))

;; Fixed work: thirty-two iterations whatever the data, with both memory
;; bounds public. The digest occupies CID bytes 4..35.
(defn digest-difference [cid output index difference]
  (if (= index 32) difference
    (digest-difference cid output (+ index 1)
                       (+ difference
                          (bit-xor (kernel-load-u8 cid 36 (+ 4 index))
                                   (kernel-load-u8 output 32 index))))))

;; SCRATCH is one caller-owned 416-byte region: a 32-byte digest output at 0
;; and SHA-256's 352-byte workspace at 64. Two pointers would not fit -- the
;; ABI admits five parameters -- and deriving both through `kernel-subregion`
;; makes the narrowing checked rather than assumed.
(defn hash-and-compare [cid block block-length scratch]
  (let [output (kernel-subregion scratch 416 0 32)
        workspace (kernel-subregion scratch 416 64 352)]
    (if (= (sha/aiueos-sha256 block block-length output workspace 352) 0) 7
      (if (= (digest-difference cid output 0 0) 0) 0 8))))

;; NOT A BOOLEAN. Zero admits; each non-zero value names the clause that
;; produced it, and the codes ascend with how far into the CID and then the
;; block the check reaches. A caller writing `if (admit(...))` -- the shape
;; every neighbouring object invites -- admits exactly what this rejects.
(defn aiueos-cid-v1-admit
  [cid :i64 cid-length :i64 block :i64 block-length :i64 scratch :i64] :i64
  (if (not (= cid-length 36)) 1
    (if (not (= (kernel-load-u8 cid 36 0) 1)) 2
      (if (= (codec-permitted (kernel-load-u8 cid 36 1)) 0) 3
        (if (not (= (kernel-load-u8 cid 36 2) 18)) 4
          (if (not (= (kernel-load-u8 cid 36 3) 32)) 5
            (if (> block-length 12288) 6
              ;; An empty block is a real block --
              ;; `bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku`
              ;; is the raw CID of zero bytes and ADR-0082 already fetches it
              ;; over TLS -- so the lower bound is zero, not one.
              (hash-and-compare cid block block-length scratch))))))))

(defn main [] :i64 0)
