(ns aiueos.uefi.console
  (:export [con-out boot-services put set-attribute clear-screen
            digit-char put-hex64 put-dec put-number]))

;; EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL, for a BOOTX64.EFI written in Kotoba.
;;
;; This is the first of the loader modules that replace `os/aiueos/uefi/main.c`.
;; It stands in for that file's `console_ascii` (:186), `debug_string` and the
;; hex writer the model digest uses -- the parts of the loader that SAY what
;; happened. It needs no writable memory, which is why it could be written
;; before the rest: every string it prints is a literal in this image's own
;; `.text`, reached by `lea` with no relocation (amu ADR-0295).
;;
;; ---------------------------------------------------------------------------
;; PRINTING A NUMBER WITHOUT A BUFFER
;; ---------------------------------------------------------------------------
;; `OutputString` takes a `CHAR16 *`. A C loader builds the digits into a
;; scratch array and passes its address. A Kotoba UEFI application has no
;; address it may write -- `.text` is 0x60000020, read and execute, and
;; `kernel-boot-info` answers the ImageHandle rather than the context.
;;
;; So the digits are not built. There are sixteen ONE-CHARACTER string
;; literals in the pool, `digit-char` selects one by value, and the number is
;; printed one firmware call per digit. Sixteen calls for a 64-bit hex word is
;; more than one call on a buffer, and it is what this image can actually do
;; today. When a writable scratch region exists the buffer form can replace it
;; and this module's callers do not change.
;;
;; ---------------------------------------------------------------------------
;; NON-NEGATIVE ONLY
;; ---------------------------------------------------------------------------
;; `put-hex64` and `put-dec` divide, and Kotoba's `quot` truncates toward zero,
;; so a value with bit 63 set prints nonsense. Every number this loader prints
;; -- addresses under 64 GiB, file offsets, segment sizes, page counts -- is
;; far below 2^63. The i64 shifts that would make the sign irrelevant are
;; refused on the JVM-free route (`kotoba.verifier` tests the shift count with
;; `integer?` and ClojureScript lowers KIR literals to BigInt), which is the
;; same reason `sha256_core.kotoba` rotates with `quot` and `*`.

;; EFI_SYSTEM_TABLE: ConOut at +0x40, BootServices at +0x60.
(defn con-out [system-table]
  (kernel-load-ptr system-table 64))

(defn boot-services [system-table]
  (kernel-load-ptr system-table 96))

;; EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL: OutputString +0x08, SetAttribute +0x28,
;; ClearScreen +0x30. Each returns EFI_STATUS, and 0 is EFI_SUCCESS.
(defn put [out text]
  (kernel-uefi-call2 out 8 out text))

(defn set-attribute [out attribute]
  (kernel-uefi-call2 out 40 out attribute))

;; ClearScreen takes only This. The second operand rides in RDX and the
;; firmware ignores it; under Microsoft x64 the caller owns the frame.
(defn clear-screen [out]
  (kernel-uefi-call2 out 48 out 0))

(defn digit-char [v]
  (if (= v 0) (ucs2 "0")
    (if (= v 1) (ucs2 "1")
      (if (= v 2) (ucs2 "2")
        (if (= v 3) (ucs2 "3")
          (if (= v 4) (ucs2 "4")
            (if (= v 5) (ucs2 "5")
              (if (= v 6) (ucs2 "6")
                (if (= v 7) (ucs2 "7")
                  (if (= v 8) (ucs2 "8")
                    (if (= v 9) (ucs2 "9")
                      (if (= v 10) (ucs2 "A")
                        (if (= v 11) (ucs2 "B")
                          (if (= v 12) (ucs2 "C")
                            (if (= v 13) (ucs2 "D")
                              (if (= v 14) (ucs2 "E")
                                (ucs2 "F")))))))))))))))))

;; Sixteen nibbles, most significant first, no zero suppression: an address
;; printed at a fixed width is easier to compare by eye against a memory map.
;; `place` starts at 16^15 and divides by sixteen until it reaches zero.
(defn put-hex64 [out value place]
  (if (= place 0) 1
    (let [nibble (bit-and (quot value place) 15)
          printed (put out (digit-char nibble))]
      (put-hex64 out value (+ (quot place 16) (* 0 printed))))))

;; Decimal with leading zeros suppressed. `started` is 1 once a non-zero digit
;; has been printed, so `put-dec` of zero prints nothing at all -- `put-number`
;; is the entry that handles it.
(defn put-dec [out value place started]
  (if (= place 0) started
    (let [d (quot value place)
          digit (- d (* 10 (quot d 10)))
          show (if (= started 1) 1 (if (= digit 0) 0 1))
          printed (if (= show 1) (put out (digit-char digit)) 0)]
      (put-dec out value (quot place 10) (+ show (* 0 printed))))))

;; 10^18 is the largest power of ten below 2^63, so this prints up to nineteen
;; digits, which covers every value an i64 can hold without its sign bit.
(defn put-number [out value]
  (if (= value 0)
    (put out (ucs2 "0"))
    (put-dec out value 1000000000000000000 0)))
