(ns aiueos.uefi.exit
  (:export [get-memory-map exit-boot-services map-reason descriptor-min-size]))

;; The exit half of `os/aiueos/uefi/main.c`'s last stretch (:1209-1221): hand
;; the kernel its memory map, take the machine from the firmware, and let the
;; composition do the jump. This is the fifth loader module after
;; `aiueos.uefi.console`, `aiueos.uefi.elf`, `aiueos.uefi.memory` and
;; `aiueos.uefi.fs`.
;;
;; ---------------------------------------------------------------------------
;; WHY THIS MODULE COULD NOT BE WRITTEN BEFORE fwstore
;; ---------------------------------------------------------------------------
;; `GetMemoryMap` takes five operands and four of them are OUT-POINTERS. Until
;; kotoba-gmir ADR-0013 a Kotoba UEFI application had no address it was allowed
;; to write, so the call that answers where memory IS could not be spelled at
;; all. The same `kernel-subregion` / `kernel-uefi-alloc-region` family the fs
;; module stages its answers through closes that: the caller spells the
;; out-slots at the site that declares the window (see `aiueos.uefi.memory`'s
;; note on why the allocation head lives there) and this module makes the
;; calls.
;;
;; ---------------------------------------------------------------------------
;; EXIT BOOT SERVICES IS THE POINT OF NO RETURN
;; ---------------------------------------------------------------------------
;; `exit-boot-services` returning zero ends every boot service: no console, no
;; file system, no allocator. Only port I/O and memory survive, which is why
;; the composition prints everything it wants on the firmware console BEFORE
;; calling it and marks the debug console (port 0xe9) after. A probe that
;; printed after this call would be measuring nothing.
;;
;; `map-key` must come from a `get-memory-map` call that happened AFTER the
;; last allocation, copy or free -- the firmware invalidates the key whenever
;; the map changes. This module does not police that ordering; the composition
;; owns the sequence and is written last-call-before-exit.
;;
;; ---------------------------------------------------------------------------
;; ZERO IS THE SUCCESS VALUE
;; ---------------------------------------------------------------------------
;; `map-reason` follows `aiueos.uefi.elf` and `aiueos.uefi.memory`: zero is
;; admitted and every non-zero value NAMES the clause that refused. The calls
;; return EFI_STATUS, where zero is EFI_SUCCESS, so the two conventions agree.

;; The smallest EFI_MEMORY_DESCRIPTOR this contract accepts
;; (`main.c` walks descriptors of at least this size).
(defn descriptor-min-size [] 48)

;; GetMemoryMap(&MemoryMapSize, MemoryMap, &MapKey, &DescriptorSize,
;; &DescriptorVersion) at EFI_BOOT_SERVICES+0x38. Five operands plus the
;; explicit zero the wide call always stages (`aiueos.uefi.memory` explains the
;; fourth word): the sixth argument slot rides along and the firmware ignores
;; it -- GetMemoryMap takes exactly five.
(defn get-memory-map [bs size-out map-buf key-out descriptor-size-out descriptor-version-out]
  (kernel-uefi-call6 bs 56 size-out map-buf key-out descriptor-size-out
                     descriptor-version-out 0))

;; ExitBootServices(ImageHandle, MapKey) at EFI_BOOT_SERVICES+0xE8 (232).
;; Two operands, so this is the same call shape as `console/clear-screen`.
(defn exit-boot-services [bs image-handle map-key]
  (kernel-uefi-call2 bs 232 image-handle map-key))

;; Zero when the map answered is one this loader may hand a kernel, and
;; otherwise the clause that refused:
;;
;;   1  the firmware refused the call -- status is not EFI_SUCCESS
;;   2  the map is empty -- size answered zero
;;   3  the descriptor size is below sizeof(EFI_MEMORY_DESCRIPTOR) as this
;;      contract reads it (48)
;;   4  the map size is not a whole number of descriptors -- a kernel walking
;;      it by descriptor size would read past its own map on the last entry
;;
;; The order matters. Clause 1 is ahead of the shape checks because "the
;; firmware refused" is the useful sentence, and a refused call may leave the
;; out-slots untouched (holding whatever was stored there before).
(defn map-reason [status map-size descriptor-size]
  (if (= status 0)
    (if (= map-size 0) 2
      (if (< descriptor-size 48) 3
        (if (= (- map-size (* descriptor-size (quot map-size descriptor-size)))
               0)
          0
          4)))
    1))
