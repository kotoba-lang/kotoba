(ns aiueos.lib.sha256-core
  (:export [cl cs sha-run]))

;; SHA-256 over a caller-owned 800-byte context region, for the freestanding
;; aiueos kernel. Ported from `sha256.kotoba` with the workspace re-based into
;; the caller's own region at 448, and bounded at 192 message bytes rather than
;; the 12,288 that object admits, because its callers (HMAC, HKDF-Expand-Label)
;; only ever hash a padded key block plus an info string.
;;
;; This file exists because `hkdf-sha256.kotoba` used to CONTAIN it. Its own
;; comment said why: measured 2026-09-02 against amu b1fdaad2, a namespace
;; declaring `(:require ...)` was refused for `x86_64-aiueos-kernel-v1`
;; outright (`:kotoba.error/namespace-require-needs-project`, unchanged by
;; `--unpinned`), so a kernel object could not import anything and every helper
;; had to be copied into every source that needed it. amu#742 removed that
;; refusal; this is the first import it buys.
;;
;; The rotations are `quot` and `*` by powers of two rather than shifts, for
;; the reason `sha256.kotoba` gives and for one more: measured 2026-09-02,
;; `i64-shift-left` and `u64-shift-right` are refused on the JVM-FREE route
;; entirely ("runtime KIR i64 shift count rejected") because `kotoba.verifier`
;; tests the literal count with `integer?` and ClojureScript lowers KIR
;; literals to BigInt.
;;
;; THE WINDOW LENGTH IS THE LITERAL 800, not a parameter, so a caller with a
;; differently sized context cannot share this module yet. `sha256.kotoba`
;; is exactly that caller: its core is the same rounds against a separate
;; 512-byte workspace region, so it still carries its own copy. Widening this
;; one to take the length is a separate change with its own admission vectors.
;;
;; Exported surface, measured rather than chosen: `cl`, `cs` and `sha-run` are
;; the only three of these 32 functions that `hkdf-sha256.kotoba` still calls.
;; The other 29 stay private to this namespace.

(defn cl [ctx i] (kernel-load-u8-4k ctx 800 i))
(defn cs [ctx i v] (kernel-store-u8-4k ctx 800 i v))

;; --- SHA-256, inlined ------------------------------------------------------
;; Ported from `sha256.kotoba` with the workspace re-based into this object's
;; own region at 448. The rotations are `quot` and `*` by powers of two rather
;; than shifts, for the reason that object gives and for one more: measured
;; 2026-09-02, `i64-shift-left` and `u64-shift-right` are refused on the
;; JVM-FREE route entirely ("runtime KIR i64 shift count rejected") because
;; `kotoba.verifier` tests the literal count with `integer?` and ClojureScript
;; lowers KIR literals to BigInt.

(defn u32 [x] (bit-and x 4294967295))
(defn bxor3 [a b c] (bit-xor (bit-xor a b) c))
(defn rotr2 [x] (u32 (+ (quot x 4) (* (bit-and x 3) 1073741824))))
(defn rotr6 [x] (u32 (+ (quot x 64) (* (bit-and x 63) 67108864))))
(defn rotr7 [x] (u32 (+ (quot x 128) (* (bit-and x 127) 33554432))))
(defn rotr11 [x] (u32 (+ (quot x 2048) (* (bit-and x 2047) 2097152))))
(defn rotr13 [x] (u32 (+ (quot x 8192) (* (bit-and x 8191) 524288))))
(defn rotr17 [x] (u32 (+ (quot x 131072) (* (bit-and x 131071) 32768))))
(defn rotr18 [x] (u32 (+ (quot x 262144) (* (bit-and x 262143) 16384))))
(defn rotr19 [x] (u32 (+ (quot x 524288) (* (bit-and x 524287) 8192))))
(defn rotr22 [x] (u32 (+ (quot x 4194304) (* (bit-and x 4194303) 1024))))
(defn rotr25 [x] (u32 (+ (quot x 33554432) (* (bit-and x 33554431) 128))))
(defn shr3 [x] (quot x 8))
(defn shr10 [x] (quot x 1024))

(defn load32 [ctx word]
  (let [offset (+ 448 (* word 4))]
    (+ (* (cl ctx offset) 16777216)
       (+ (* (cl ctx (+ offset 1)) 65536)
          (+ (* (cl ctx (+ offset 2)) 256)
             (cl ctx (+ offset 3)))))))

(defn store32 [ctx word value]
  (let [offset (+ 448 (* word 4))
        s0 (cs ctx offset (bit-and (quot value 16777216) 255))
        s1 (cs ctx (+ offset 1) (bit-and (quot value 65536) 255))
        s2 (cs ctx (+ offset 2) (bit-and (quot value 256) 255))]
    (+ (cs ctx (+ offset 3) (bit-and value 255))
       (* 0 (+ s0 (+ s1 s2))))))

(defn store-out32 [ctx dest word value]
  (let [offset (+ dest (* word 4))
        s0 (cs ctx offset (bit-and (quot value 16777216) 255))
        s1 (cs ctx (+ offset 1) (bit-and (quot value 65536) 255))
        s2 (cs ctx (+ offset 2) (bit-and (quot value 256) 255))]
    (+ (cs ctx (+ offset 3) (bit-and value 255))
       (* 0 (+ s0 (+ s1 s2))))))

(defn round-k [i]
  (if (= i 0) 1116352408 (if (= i 1) 1899447441 (if (= i 2) 3049323471 (if (= i 3) 3921009573
  (if (= i 4) 961987163 (if (= i 5) 1508970993 (if (= i 6) 2453635748 (if (= i 7) 2870763221
  (if (= i 8) 3624381080 (if (= i 9) 310598401 (if (= i 10) 607225278 (if (= i 11) 1426881987
  (if (= i 12) 1925078388 (if (= i 13) 2162078206 (if (= i 14) 2614888103 (if (= i 15) 3248222580
  (if (= i 16) 3835390401 (if (= i 17) 4022224774 (if (= i 18) 264347078 (if (= i 19) 604807628
  (if (= i 20) 770255983 (if (= i 21) 1249150122 (if (= i 22) 1555081692 (if (= i 23) 1996064986
  (if (= i 24) 2554220882 (if (= i 25) 2821834349 (if (= i 26) 2952996808 (if (= i 27) 3210313671
  (if (= i 28) 3336571891 (if (= i 29) 3584528711 (if (= i 30) 113926993 (if (= i 31) 338241895
  (if (= i 32) 666307205 (if (= i 33) 773529912 (if (= i 34) 1294757372 (if (= i 35) 1396182291
  (if (= i 36) 1695183700 (if (= i 37) 1986661051 (if (= i 38) 2177026350 (if (= i 39) 2456956037
  (if (= i 40) 2730485921 (if (= i 41) 2820302411 (if (= i 42) 3259730800 (if (= i 43) 3345764771
  (if (= i 44) 3516065817 (if (= i 45) 3600352804 (if (= i 46) 4094571909 (if (= i 47) 275423344
  (if (= i 48) 430227734 (if (= i 49) 506948616 (if (= i 50) 659060556 (if (= i 51) 883997877
  (if (= i 52) 958139571 (if (= i 53) 1322822218 (if (= i 54) 1537002063 (if (= i 55) 1747873779
  (if (= i 56) 1955562222 (if (= i 57) 2024104815 (if (= i 58) 2227730452 (if (= i 59) 2361852424
  (if (= i 60) 2428436474 (if (= i 61) 2756734187 (if (= i 62) 3204031479 3329325298
  ))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))

(defn length-byte [length position]
  (let [bits (* length 8)]
    (if (= position 0) (bit-and (quot bits 72057594037927936) 255)
    (if (= position 1) (bit-and (quot bits 281474976710656) 255)
    (if (= position 2) (bit-and (quot bits 1099511627776) 255)
    (if (= position 3) (bit-and (quot bits 4294967296) 255)
    (if (= position 4) (bit-and (quot bits 16777216) 255)
    (if (= position 5) (bit-and (quot bits 65536) 255)
    (if (= position 6) (bit-and (quot bits 256) 255)
      (bit-and bits 255))))))))))

;; The message always lives in this object's own buffer at 192, so unlike
;; `sha256.kotoba`'s `block-byte` there is no separate input region: the padding
;; and the length field are synthesised, never stored.
(defn msg-byte [ctx msg-len base index]
  (let [global (+ base index)
        total (* (quot (+ msg-len 72) 64) 64)
        length-start (- total 8)]
    (if (< global msg-len) (cl ctx (+ 192 global))
      (if (= global msg-len) 128
        (if (>= global length-start)
          (length-byte msg-len (- global length-start))
          0)))))

(defn prepare [ctx msg-len base i]
  (if (= i 16) 1
    (let [j (* i 4)
          value (+ (* (msg-byte ctx msg-len base j) 16777216)
                   (+ (* (msg-byte ctx msg-len base (+ j 1)) 65536)
                      (+ (* (msg-byte ctx msg-len base (+ j 2)) 256)
                         (msg-byte ctx msg-len base (+ j 3)))))
          stored (store32 ctx i value)]
      (prepare ctx msg-len base (+ i 1 (* 0 stored))))))

(defn extend [ctx i]
  (if (= i 64) 1
    (let [x (load32 ctx (- i 15))
          y (load32 ctx (- i 2))
          s0 (bxor3 (rotr7 x) (rotr18 x) (shr3 x))
          s1 (bxor3 (rotr17 y) (rotr19 y) (shr10 y))
          value (u32 (+ (load32 ctx (- i 16))
                        (+ s0 (+ (load32 ctx (- i 7)) s1))))
          stored (store32 ctx i value)]
      (extend ctx (+ i 1 (* 0 stored))))))

(defn copy-working [ctx i]
  (if (= i 8) 1
    (let [stored (store32 ctx (+ 72 i) (load32 ctx (+ 64 i)))]
      (copy-working ctx (+ i 1 (* 0 stored))))))

(defn copy-round [ctx i]
  (if (= i 8) 1
    (let [stored (store32 ctx (+ 72 i) (load32 ctx (+ 80 i)))]
      (copy-round ctx (+ i 1 (* 0 stored))))))

(defn round-block [ctx i]
  (if (= i 64) 1
    (let [a (load32 ctx 72) b (load32 ctx 73)
          c (load32 ctx 74) d (load32 ctx 75)
          e (load32 ctx 76) f (load32 ctx 77)
          g (load32 ctx 78) h (load32 ctx 79)
          sum1 (bxor3 (rotr6 e) (rotr11 e) (rotr25 e))
          choice (bit-xor (bit-and e f) (bit-and (bit-xor e 4294967295) g))
          temp1 (u32 (+ h (+ sum1 (+ choice (+ (round-k i) (load32 ctx i))))))
          sum0 (bxor3 (rotr2 a) (rotr13 a) (rotr22 a))
          majority (bxor3 (bit-and a b) (bit-and a c) (bit-and b c))
          temp2 (u32 (+ sum0 majority))
          s7 (store32 ctx 87 g) s6 (store32 ctx 86 f)
          s5 (store32 ctx 85 e) s4 (store32 ctx 84 (u32 (+ d temp1)))
          s3 (store32 ctx 83 c) s2 (store32 ctx 82 b)
          s1 (store32 ctx 81 a) s0 (store32 ctx 80 (u32 (+ temp1 temp2)))
          copied (copy-round ctx 0)]
      (round-block ctx
                   (+ i 1 (* 0 (+ s7 (+ s6 (+ s5 (+ s4 (+ s3 (+ s2 (+ s1 (+ s0 copied))))))))))))))

(defn add-state [ctx i]
  (if (= i 8) 1
    (let [stored (store32 ctx (+ 64 i)
                          (u32 (+ (load32 ctx (+ 64 i))
                                  (load32 ctx (+ 72 i)))))]
      (add-state ctx (+ i 1 (* 0 stored))))))

(defn process-blocks [ctx msg-len block total]
  (if (= block total) 1
    (let [prepared (prepare ctx msg-len (* block 64) 0)
          extended (extend ctx 16)
          copied (copy-working ctx 0)
          rounded (round-block ctx 0)
          added (add-state ctx 0)]
      (process-blocks ctx msg-len
                      (+ block 1 (* 0 (+ prepared (+ extended (+ copied (+ rounded added))))))
                      total))))

(defn initialize [ctx]
  (let [s0 (store32 ctx 64 1779033703) s1 (store32 ctx 65 3144134277)
        s2 (store32 ctx 66 1013904242) s3 (store32 ctx 67 2773480762)
        s4 (store32 ctx 68 1359893119) s5 (store32 ctx 69 2600822924)
        s6 (store32 ctx 70 528734635) s7 (store32 ctx 71 1541459225)]
    (+ 1 (* 0 (+ s0 (+ s1 (+ s2 (+ s3 (+ s4 (+ s5 (+ s6 s7)))))))))))

(defn emit-output [ctx dest i]
  (if (= i 8) 1
    (let [stored (store-out32 ctx dest i (load32 ctx (+ 64 i)))]
      (emit-output ctx dest (+ i 1 (* 0 stored))))))

;; SHA-256 of the first `msg-len` bytes of the message buffer, into `dest`.
(defn sha-run [ctx msg-len dest]
  (let [ini (initialize ctx)
        proc (process-blocks ctx msg-len 0 (quot (+ msg-len 72) 64))
        emit (emit-output ctx dest 0)]
    (+ 1 (* 0 (+ ini (+ proc emit))))))
