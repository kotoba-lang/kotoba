;; The codebook grids of the IQ quantisation families, PACKED, and the small
;; tables beside them -- what `kernel/qwen35_quant_tables.inc` holds (adapted
;; from ggml-org/llama.cpp @3173a564, MIT), dumped from the compiled C in
;; memory order and then packed here because a program's string literals are
;; capped at 64 KiB of UTF-8 and the hex of the raw tables is ~70 KiB.
;;
;; Every byte of the three IQ2 grids and of `iq1s_grid` takes one of THREE
;; values (measured: {8, 25, 43} for the IQ2 families, {0, 1, 255} for IQ1_S),
;; and every byte of the two IQ3 grids one of EIGHT, so a grid byte is a
;; 2-bit or 4-bit code here, four or two per literal byte, low bits first,
;; and the accessor maps the code back to the value the C's table holds.
;; The packing was round-tripped against every byte of every table before
;; the literals were written; the contracts then check the decoded rows
;; against the C's (ADR-0221).
;;
;; An index into a u64 / u32 entry of the C's table is `entry * 8` /
;; `entry * 4` elements; the byte the C reads as
;; `((const uint8_t *)(grid + idx))[j]` is element `idx * width + j`.

(ns aiueos.lib.qwen35-grids
  (:export [kmask-at ksigns-at iq2xxs-grid-at iq2xs-grid-at iq2s-grid-at
            iq3xxs-grid-at iq3s-grid-at iq1s-grid-at iq4nl-at]))

(defn pow2 [k]
  (if (= k 0) 1 (if (= k 1) 2 (if (= k 2) 4 (if (= k 3) 8 (if (= k 4) 16 (if (= k 5) 32 64)))))))

;; code -> value for the three-valued grids
(defn iq2-value [c] (if (= c 0) 8 (if (= c 1) 25 43)))
(defn iq1-value [c] (if (= c 0) 0 (if (= c 1) 1 -1)))     ; the C reads iq1s_grid as int8
(defn iq3xxs-value [c]
  (if (= c 0) 4 (if (= c 1) 12 (if (= c 2) 20 (if (= c 3) 28 (if (= c 4) 36 (if (= c 5) 44 (if (= c 6) 52 62))))))))
(defn iq3s-value [c] (+ 1 (* 2 c)))

;; element e of a 2-bit-packed literal: byte e/4, bits 2*(e mod 4)
(defn code2 [byte e]
  (bit-and (quot byte (pow2 (* 2 (- e (* 4 (quot e 4)))))) 3))
;; element e of a 4-bit-packed literal: byte e/2, bits 4*(e mod 2)
(defn code4 [byte e]
  (bit-and (quot byte (pow2 (* 4 (- e (* 2 (quot e 2)))))) 15))

(defn kmask-at [j]
  (kernel-load-u8 (bytes-literal "0102040810204080") 8 j))

(defn ksigns-at [i]
  (kernel-load-u8 (bytes-literal "008182038405068788090a8b0c8d8e0f901112931495961718999a1b9c1d1e9fa02122a324a5a62728a9aa2bac2d2eaf30b1b233b43536b7b8393abb3cbdbe3fc04142c344c5c64748c9ca4bcc4d4ecf50d1d253d45556d7d8595adb5cddde5f60e1e263e46566e7e8696aeb6cedee6ff07172f374f5f67778f9fa7bfc7d7eff") 128 i))

(defn iq4nl-at [i]
  (let [v (kernel-load-u8 (bytes-literal "8198adbfcfddeaf6010d192635455971") 16 i)]
    (if (> v 127) (- v 256) v)))

(defn iq2xxs-grid-at [entry j]
  (let [e (+ (* entry 8) j)]
    (iq2-value (code2 (kernel-load-u8 (bytes-literal "") 512 (quot e 4)) e))))

(defn iq2xs-grid-at [entry j]
  (let [e (+ (* entry 8) j)]
    (iq2-value (code2 (kernel-load-u8-4k (bytes-literal "") 1024 (quot e 4)) e))))

(defn iq2s-grid-at [entry j]
  (let [e (+ (* entry 8) j)]
    (iq2-value (code2 (kernel-load-u8-4k (bytes-literal "") 2048 (quot e 4)) e))))

(defn iq1s-grid-at [entry j]
  (let [e (+ (* entry 8) j)]
    (iq1-value (code2 (kernel-load-u8-4k (bytes-literal "") 4096 (quot e 4)) e))))

(defn iq3xxs-grid-at [entry j]
  (let [e (+ (* entry 4) j)]
    (iq3xxs-value (code4 (kernel-load-u8 (bytes-literal "") 512 (quot e 2)) e))))

(defn iq3s-grid-at [entry j]
  (let [e (+ (* entry 4) j)]
    (iq3s-value (code4 (kernel-load-u8-4k (bytes-literal "") 1024 (quot e 2)) e))))

