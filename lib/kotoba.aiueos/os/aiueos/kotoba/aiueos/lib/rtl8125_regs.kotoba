(ns aiueos.lib.rtl8125-regs
  (:export [mmio-ok desc-ok revision-of receive-config]))

;; The four decisions every RTL8125 object shares, in one module rather than
;; copied into six.
;;
;; It exists because of a rule that has nothing to do with register layout: a
;; kernel object exports ONE symbol and cannot call another object, so a driver
;; split across six objects would otherwise carry six copies of "is this a
;; descriptor address" and six copies of "which receive configuration does this
;; revision want". amu#742 made `(:require ...)` work for
;; `x86_64-aiueos-kernel-v1`, and `aiueos.lib.sha256-core` was the first import
;; it bought; this is the second.
;;
;; Register offsets are NOT here. They are literals at their use sites with the
;; hexadecimal in a comment, because a zero-argument `(defn rge-cmd [] 55)` is a
;; charged Kotoba call that returns a constant -- the fuel accounting would then
;; scale with how many registers a function touches, which is exactly the kind
;; of size-dependent cost the fuel comments in kotoba-native warn about. The
;; four things here are DECISIONS, and each is called at most twice per object.
;;
;; Cross-checked against `os/aiueos/kernel/rtl8125.c` and its `rtl8125.h`, whose
;; own header cites the ISC-licensed OpenBSD rge(4) `if_rgereg.h`.

;; Is this a BAR window this driver will touch at all?
;;
;; `aiueos_map_pci_mmio(bar, 4096)` at kernel/pci.c:4056 maps exactly one page
;; per BAR, and the highest register `rtl8125.c` reaches is RGE_RXDESC_HI at
;; 0xe8 (:23). So the length is not merely bounded, it is EXACTLY 4096: a caller
;; who hands over a shorter window has mapped something else, and one who hands
;; over a longer window is claiming a mapping the C never makes.
;;
;; A zero base is refused for the reason the C refuses a null `io->context`
;; (`io_valid`, :125-128) -- there is no device at physical zero -- and a
;; negative base is refused because `bit-and`/`quot` on a negative i64 would
;; make the bounds arithmetic below mean something else. Physical addresses on
;; this path are under 2^40 (see `mmio-map-admit.kotoba`), so nothing legitimate
;; is being turned away.
(defn mmio-ok [base length]
  (if (or (<= base 0) (not (= length 4096))) 0 1))

;; Is this a descriptor ring address the hardware can be pointed at?
;;
;; `aiueos_rtl8125_takeover` (:213-217) refuses a null descriptor and one whose
;; low eight bits are set: `(tx_desc_physical & 0xffU)` and `((uintptr_t)tx &
;; 0xffU)`. Both clauses are the same clause here, because AIUEOS maps physical
;; memory identically and `aiueos_allocate_physical_page` returns a page-aligned
;; address that IS its own physical address -- the C carries the pointer and the
;; physical address separately and checks both, which two arguments of one
;; object cannot do and would not mean anything different if they could.
;;
;; 256 rather than 32: a descriptor is 32 bytes and the hardware would accept
;; 32-byte alignment, but the C asks for 256 and this object is a transcription,
;; not a re-derivation. Relaxing it here would admit rings the C refuses.
(defn desc-ok [base]
  (if (or (<= base 0) (not (= 0 (bit-and base 255)))) 0 1))

;; Which silicon revision is this?
;;
;; `revision_from_txcfg` (:130-138) reads TXCFG (0x40) before the driver has
;; written it and matches the RGE_TXCFG_HWREV field (0x7cf00000). The four
;; values and the codes they map to are `enum aiueos_rtl8125_revision`:
;;
;;   0x60900000 -> 1  RTL8125
;;   0x64100000 -> 2  RTL8125B
;;   0x68800000 -> 3  RTL8125D revision 1
;;   0x68900000 -> 4  RTL8125D revision 2
;;   anything else -> 0, which `takeover` turns into UNSUPPORTED_REVISION
;;
;; The C's comment on `rings_restart` (:166-168) matters for the caller and not
;; for this function: "TXCFG no longer contains usable revision bits after
;; takeover", so this may be asked exactly once, before anything writes 0x40.
(defn revision-of [txcfg]
  (if (= (bit-and txcfg 2096103424) 1620049920)   ; 0x7cf00000, 0x60900000
    1
    (if (= (bit-and txcfg 2096103424) 1678770176) ; 0x64100000
      2
      (if (= (bit-and txcfg 2096103424) 1753219072) ; 0x68800000
        3
        (if (= (bit-and txcfg 2096103424) 1754267648) ; 0x68900000
          4
          0)))))

;; The whole word written to RXCFG (0x44), not just the revision-dependent half.
;;
;; The C splits this in two -- `receive_config` (:140-144) returns the base and
;; `rings_restart` (:200-201) ORs in RGE_RXCFG_INDIVIDUAL (0x02) and
;; RGE_RXCFG_BROADCAST (0x08) -- and the split is what makes the C's own model
;; test assert `0x41000c0a` rather than `0x41000c00`. Joined here because the
;; two halves have exactly one call site between them and the acceptance filter
;; is one decision: this NIC accepts frames addressed to its own MAC and
;; broadcasts, and nothing else. Promiscuous and multicast bits are absent by
;; construction rather than by an omission a reader has to notice.
;;
;;   1  RTL8125       0x41000700 | 0x0a = 0x4100070a
;;   2  RTL8125B      0x41000c00 | 0x0a = 0x41000c0a
;;   3, 4  RTL8125D   0x41200c00 | 0x0a = 0x41200c0a
;;
;; The C's `receive_config` falls through to the 8125D word for ANY revision
;; that is not 1 or 2, and the fall-through is reproduced rather than tightened:
;; the caller has already refused revision 0, and 3 and 4 are the only other
;; values `revision-of` produces.
(defn receive-config [revision]
  (if (= revision 1)
    1090520842                          ; 0x4100070a
    (if (= revision 2)
      1090522122                        ; 0x41000c0a
      1092619274)))                     ; 0x41200c0a
