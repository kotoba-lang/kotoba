;; JUN-757: streaming SHA-512 profile, shared canonical round engine.
(ns aiueos.sha512-stream
  (:require [aiueos.sha512 :refer [add-state copy-working emit-output extend initialize prepare round-block]])
  (:export [stream-init stream-byte stream-finish stream-digest-byte stream-wipe]))
;; JUN-757: caller-owned streaming profile, sharing the exact SHA-512 round
;; engine in aiueos.sha512. Legacy one-shot API/12KiB limit is retained. State4608:
;; existing work0..4095, block4096..4223, byte length4224, used4232,
;; phase4240 (1 active/2 done), digest4256..4319, magic4320.
;; Only API-created states are valid; serialize and keep inputs immutable.
;; No pointers/authority are created; shape refusals preserve all bytes.
(defn- stream-b [st i] (kernel-load-u8-16k st 4608 i))
(defn- stream-p [st i v] (kernel-store-u8-16k st 4608 i v))
(defn- stream-ld [st i] (kernel-load-u64 (kernel-subregion st 4608 i 8) 8 0))
(defn- stream-put [st i v] (kernel-store-u64 (kernel-subregion st 4608 i 8) 8 0 v))
(defn- stream-zero [st i]
  (if (>= i 4608) 1 (do (stream-p st i 0) (stream-zero st (+ i 1)))))
(defn- stream-valid [st phase]
  (and (= (stream-ld st 4320) 1397241138) (= (stream-ld st 4240) phase)
       (>= (stream-ld st 4224) 0) (>= (stream-ld st 4232) 0) (< (stream-ld st 4232) 128)
       (if (= phase 1) (= (stream-ld st 4232) (mod (stream-ld st 4224) 128)) (= (stream-ld st 4232) 0))))
(defn- stream-start [st]
  (do (stream-zero st 0) (initialize (kernel-subregion st 4608 0 4096))
      (stream-put st 4240 1) (stream-put st 4320 1397241138) 1))
(defn stream-init [st length]
  (if (< length 4608) 0 (stream-start (kernel-subregion st length 0 4608))))
(defn- stream-block [st]
  (do (prepare (kernel-subregion st 4608 4096 128) 128 (kernel-subregion st 4608 0 4096) 0 0)
      (extend (kernel-subregion st 4608 0 4096) 16) (copy-working (kernel-subregion st 4608 0 4096) 0)
      (round-block (kernel-subregion st 4608 0 4096) 0) (add-state (kernel-subregion st 4608 0 4096) 0)
      (stream-put st 4232 0) 1))
(defn- stream-append [st value]
  (do (stream-p st (+ 4096 (stream-ld st 4232)) value)
      (stream-put st 4232 (+ (stream-ld st 4232) 1))
      (if (= (stream-ld st 4232) 128) (stream-block st) 1)))
(defn- stream-add [st value]
  (if (and (stream-valid st 1) (>= value 0) (<= value 255) (< (stream-ld st 4224) 9223372036854775807))
    (do (stream-put st 4224 (+ (stream-ld st 4224) 1)) (stream-append st value)) 0))
(defn stream-byte [st length value]
  (if (< length 4608) 0 (stream-add (kernel-subregion st length 0 4608) value)))
(defn- stream-padding [st]
  (if (= (stream-ld st 4232) 112) 1 (do (stream-append st 0) (stream-padding st))))
(defn- stream-length [st i]
  (if (>= i 16) 1
    (do (stream-append st (bit-and (u64-shift-right
          (if (< i 8) (u64-shift-right (stream-ld st 4224) 61) (i64-shift-left (stream-ld st 4224) 3))
          (* 8 (- 7 (mod i 8)))) 255)) (stream-length st (+ i 1)))))
(defn- stream-end [st]
  (if (stream-valid st 1)
    (do (stream-append st 128) (stream-padding st) (stream-length st 0)
        (emit-output (kernel-subregion st 4608 0 4096) (kernel-subregion st 4608 4256 64) 0)
        (stream-put st 4240 2) 1) 0))
(defn stream-finish [st length]
  (if (< length 4608) 0 (stream-end (kernel-subregion st length 0 4608))))
(defn stream-digest-byte [st length i]
  (if (or (< length 4608) (< i 0) (>= i 64)) -1
    (if (stream-valid (kernel-subregion st length 0 4608) 2) (stream-b (kernel-subregion st length 0 4608) (+ 4256 i)) -1)))
(defn stream-wipe [st length]
  (if (< length 4608) 0 (stream-zero (kernel-subregion st length 0 4608) 0)))

