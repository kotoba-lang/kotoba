(ns aiueos.value-runtime-syscall-plan
  (:export [aiueos-value-runtime-syscall-plan main]))

;; Admission decision for the future pure-kernel SYSCALL/SYSRET shim.
;; Assembly derives user-page = pointer - (pointer & 4095) only after this
;; function admits syscall 5, the trusted current domain, the complete 104-byte
;; envelope window, and canonical low-half user RIP/RSP return state.

(defn canonical-user-address? [address :i64] :bool
  (and (> address 0) (< address 140737488355328)))

(defn aiueos-value-runtime-syscall-plan
  [number :i64 domain :i64 pointer :i64 user-rip :i64 user-rsp :i64] :i64
  (let [offset (bit-and pointer 4095)]
    (if (and (= number 5)
             (> domain 0) (<= domain 32767)
             (canonical-user-address? pointer)
             (<= offset 3992)
             (canonical-user-address? user-rip)
             (canonical-user-address? user-rsp))
      (+ offset (* domain 65536) (* 4096 4294967296)
         (* 104 281474976710656))
      0)))

(defn main [] :i64 0)
