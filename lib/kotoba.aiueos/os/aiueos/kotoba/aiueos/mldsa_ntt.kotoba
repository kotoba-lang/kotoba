;; JUN-813 stage 2 (ADR-0286): ML-DSA-65 polynomial arithmetic over a kernel window, no heap.
;; A polynomial is 256 coefficients in [0, q), q = 8380417, stored as little-endian u32 (1024 bytes). The window is 4096 bytes
;; and holds four polynomial slots 0..3 at byte 1024 * slot.
;;   nt-ntt  w length slot        in-place forward NTT (FIPS 204 Algorithm 41)
;;   nt-intt w length slot        in-place inverse NTT including the 256^-1 factor (Algorithm 42)
;;   nt-mul  w length a b dest    dest = a * b coefficient-wise (both in the NTT domain)
;; Each returns 1, or 0 for a window under 4096 bytes or a slot outside 0..3.
;; The NTT table zeta^BitRev8(m), zeta = 1753, is computed (square and multiply) instead of stored. A butterfly group's table
;; index is a function of the loop counters, so no mutable state is kept: forward m = 128/len + start/(2 len), inverse
;; m = 256/len - 1 - start/(2 len). Products of two values below q stay below 2^46.
(ns aiueos.mldsa-ntt
  (:export [nt-ntt nt-intt nt-mul]))

(defn- cf [w off] (kernel-load-u32-4k w 4096 off))
(defn- cf! [w off v] (kernel-store-u32-4k w 4096 off v))
(defn- md [x] (let [r (rem x 8380417)] (if (< r 0) (+ r 8380417) r)))
(defn- mpow [b e acc]
  (if (= e 0) acc
    (mpow (rem (* b b) 8380417) (quot e 2) (if (= (bit-and e 1) 1) (rem (* acc b) 8380417) acc))))
(defn- brv [m i r] (if (= i 8) r (brv (quot m 2) (+ i 1) (+ (* r 2) (bit-and m 1)))))
(defn- zeta [m] (mpow 1753 (brv m 0 0) 1))

;; forward butterflies of one group: positions base + 4 j and base + 4 (j + len)
(defn- fwd-j [w base len start z j]
  (if (>= j (+ start len)) 1
    (let [lo (+ base (* 4 j)) hi (+ base (* 4 (+ j len)))
          t (md (* z (cf w hi)))
          x (cf w lo)]
      (fwd-j w base len start z (+ j 1 (* 0 (+ (cf! w hi (md (- x t))) (cf! w lo (md (+ x t))))))))))
(defn- fwd-start [w base len start]
  (if (>= start 256) 1
    (fwd-start w base len (+ start (* 2 len) (* 0 (fwd-j w base len start (zeta (+ (quot 128 len) (quot start (* 2 len)))) start))))))
(defn- fwd-len [w base len]
  (if (< len 1) 1 (fwd-len w base (+ (quot len 2) (* 0 (fwd-start w base len 0))))))

(defn- inv-j [w base len start z j]
  (if (>= j (+ start len)) 1
    (let [lo (+ base (* 4 j)) hi (+ base (* 4 (+ j len)))
          t (cf w lo) u (cf w hi)]
      (inv-j w base len start z (+ j 1 (* 0 (+ (cf! w lo (md (+ t u))) (cf! w hi (md (* z (- t u)))))))))))
(defn- inv-start [w base len start]
  (if (>= start 256) 1
    (inv-start w base len (+ start (* 2 len)
                             (* 0 (inv-j w base len start (md (- 0 (zeta (- (quot 256 len) (+ 1 (quot start (* 2 len))))))) start))))))
(defn- inv-len [w base len]
  (if (>= len 256) 1 (inv-len w base (+ (* 2 len) (* 0 (inv-start w base len 0))))))
(defn- scale [w base i]
  (if (= i 256) 1 (scale w base (+ i 1 (* 0 (cf! w (+ base (* 4 i)) (md (* (cf w (+ base (* 4 i))) 8347681))))))))
(defn- mul-loop [w a b d i]
  (if (= i 256) 1
    (mul-loop w a b d (+ i 1 (* 0 (cf! w (+ d (* 4 i)) (md (* (cf w (+ a (* 4 i))) (cf w (+ b (* 4 i)))))))))))

(defn- ok [length slot] (and (>= length 4096) (>= slot 0) (<= slot 3)))
(defn nt-ntt [w length slot]
  (if (ok length slot) (fwd-len (kernel-subregion w length 0 4096) (* 1024 slot) 128) 0))
(defn nt-intt [w length slot]
  (if (ok length slot)
    (let [s (kernel-subregion w length 0 4096)] (do (inv-len s (* 1024 slot) 1) (scale s (* 1024 slot) 0)))
    0))
(defn nt-mul [w length a b d]
  (if (and (ok length a) (ok length b) (ok length d))
    (mul-loop (kernel-subregion w length 0 4096) (* 1024 a) (* 1024 b) (* 1024 d) 0)
    0))
