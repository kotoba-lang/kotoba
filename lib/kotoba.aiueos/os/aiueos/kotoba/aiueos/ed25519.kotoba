(ns aiueos.ed25519
  (:require [aiueos.gf25519 :as gf]
            [aiueos.sha512 :as sha])
  (:export [aiueos-ed25519-pubkey aiueos-ed25519-sign aiueos-ed25519-verify main]))

;; Ed25519 public key from a 32-byte seed (RFC 8032 section 5.1.5) for the freestanding aiueos kernel,
;; after TweetNaCl: SHA-512 of the seed, clamp, fixed-window-free double-and-add over extended twisted
;; Edwards coordinates with a constant-time conditional swap (mask select, no branch on the scalar bit),
;; then affine conversion and encoding (y, with the sign of x in the top bit).
;; Workspace words (a caller-owned 4096-byte region, reused after the hash): P 0..63 (X,Y,Z,T of 16 words),
;; Q 64..127, temporaries a,b,c,d,t at 128, 144, 160, 176, 192, the constant 2d at 208, tx 224, ty 240,
;; zi 256, scalar bytes 272..303. The field multiply keeps its own scratch at words 320..431 (see gf25519).
;; No signing, no secret erasure beyond what the caller does, no side-channel claim beyond the swap.

(defn c-d2 [i] (case i 0 61785 1 9906 2 39828 3 60374 4 45398 5 33411 6 5274 7 224 8 53552 9 61171 10 33010 11 6542 12 64743 13 22239 14 55772 15 9222 0))
(defn c-x [i] (case i 0 54554 1 36645 2 11616 3 51542 4 42930 5 38181 6 51040 7 26924 8 56412 9 64982 10 57905 11 49316 12 21502 13 52590 14 14035 15 8553 0))
(defn c-y [i] (case i 0 26200 1 26214 2 26214 3 26214 4 26214 5 26214 6 26214 7 26214 8 26214 9 26214 10 26214 11 26214 12 26214 13 26214 14 26214 15 26214 0))
(defn c-xy [i] (case i 0 56739 1 42423 2 35507 3 28126 4 21237 5 30545 6 40832 7 8432 8 58237 9 25771 10 20110 11 26346 12 30309 13 55179 14 24335 15 26503 0))

(defn c-d [i] (case i 0 30883 1 4953 2 19914 3 30187 4 55467 5 16705 6 2637 7 112 8 59544 9 30585 10 16505 11 36039 12 65139 13 11119 14 27886 15 20995 0))
(defn c-i [i] (case i 0 41136 1 18958 2 6951 3 50414 4 58488 5 44335 6 6150 7 12099 8 55207 9 15867 10 153 11 11085 12 57099 13 20417 14 9344 15 11139 0))

(defn load-const [ws o which i]
  (if (= i 16) 1
    (let [v (if (= which 0) (c-d2 i) (if (= which 1) (c-x i) (if (= which 2) (c-y i) (if (= which 3) (c-xy i) (if (= which 4) (c-d i) (c-i i))))))
          s (gf/st ws (+ o i) v)]
      (load-const ws o which (+ i 1 (* 0 s))))))

(defn set-elem [ws o v i]
  (if (= i 16) 1
    (let [s (gf/st ws (+ o i) (if (= i 0) v 0))]
      (set-elem ws o v (+ i 1 (* 0 s))))))

;; point set: P := (0, 1, 1, 0)
(defn point-identity [ws]
  (let [x (set-elem ws 0 0 0) y (set-elem ws 16 1 0) z (set-elem ws 32 1 0) t (set-elem ws 48 0 0)]
    (+ 1 (* 0 (+ x (+ y (+ z t)))))))

;; Q := base point (X, Y, 1, X*Y)
(defn point-base [ws]
  (let [x (load-const ws 64 1 0) y (load-const ws 80 2 0) z (set-elem ws 96 1 0) t (load-const ws 112 3 0)]
    (+ 1 (* 0 (+ x (+ y (+ z t)))))))

;; constant-time conditional swap of two 64-word points, mask = -b
(defn swap-word [ws p q mask i]
  (if (= i 64) 1
    (let [x (gf/ld ws (+ p i))
          y (gf/ld ws (+ q i))
          t (bit-and mask (bit-xor x y))
          a (gf/st ws (+ p i) (bit-xor x t))
          b (gf/st ws (+ q i) (bit-xor y t))]
      (swap-word ws p q mask (+ i 1 (* 0 (+ a b)))))))

(defn point-swap [ws p q b] (swap-word ws p q (- 0 b) 0))

;; p := p + q (extended coordinates, TweetNaCl add); temporaries a b c d t at 128..207
(defn point-add [ws p q]
  (let [s1 (gf/gf-sub ws 128 (+ p 16) p 0)
        s2 (gf/gf-sub ws 192 (+ q 16) q 0)
        m1 (gf/gf-mul ws 128 128 192)
        a1 (gf/gf-add ws 144 p (+ p 16) 0)
        a2 (gf/gf-add ws 192 q (+ q 16) 0)
        m2 (gf/gf-mul ws 144 144 192)
        m3 (gf/gf-mul ws 160 (+ p 48) (+ q 48))
        m4 (gf/gf-mul ws 160 160 208)
        m5 (gf/gf-mul ws 176 (+ p 32) (+ q 32))
        a3 (gf/gf-add ws 176 176 176 0)
        e (gf/gf-sub ws 192 144 128 0)
        h (gf/gf-add ws 128 144 128 0)
        f (gf/gf-sub ws 144 176 160 0)
        g (gf/gf-add ws 160 176 160 0)
        o0 (gf/gf-mul ws p 192 144)
        o1 (gf/gf-mul ws (+ p 16) 128 160)
        o2 (gf/gf-mul ws (+ p 32) 160 144)
        o3 (gf/gf-mul ws (+ p 48) 192 128)]
    (+ 1 (* 0 (+ s1 (+ s2 (+ m1 (+ a1 (+ a2 (+ m2 (+ m3 (+ m4 (+ m5 (+ a3 (+ e (+ h (+ f (+ g (+ o0 (+ o1 (+ o2 o3)))))))))))))))))))))

(defn scalar-bit [ws i]
  (bit-and (u64-shift-right (gf/ld ws (+ 272 (quot i 8))) (bit-and i 7)) 1))

(defn scalar-loop [ws i]
  (if (< i 0) 1
    (let [b (scalar-bit ws i)
          s1 (point-swap ws 0 64 b)
          a1 (point-add ws 64 0)
          a2 (point-add ws 0 0)
          s2 (point-swap ws 0 64 b)]
      (scalar-loop ws (- i (+ 1 (* 0 (+ s1 (+ a1 (+ a2 s2))))))))))

;; scalar bytes (clamped hash half) into words 272..303
(defn put-scalar [ws hash i]
  (if (= i 32) 1
    (let [v (kernel-load-u8 hash 64 i)
          v2 (if (= i 0) (bit-and v 248) (if (= i 31) (bit-or (bit-and v 127) 64) v))
          s (gf/st ws (+ 272 i) v2)]
      (put-scalar ws hash (+ i 1 (* 0 s))))))

(defn flip-sign-byte [out]
  (let [x (kernel-load-u8 (kernel-subregion out 128 32 1) 1 0)
        y (kernel-load-u8 (kernel-subregion out 128 31 1) 1 0)
        s (kernel-store-u8 (kernel-subregion out 128 31 1) 1 0
                           (bit-xor y (i64-shift-left (bit-and x 1) 7)))]
    (+ 1 (* 0 s))))

;; Encode k*B for the scalar bytes already in words 272..303: out (128 bytes) gets the 32-byte encoding at 0
;; (bytes 32..63 are scratch: the packed x).
(defn basemul-encode [sc out]
  (let [id (point-identity sc)
        bs (point-base sc)
        d2 (load-const sc 208 0 0)
        lp (scalar-loop sc 255)
        zi (gf/gf-inv sc 256 32)
        tx (gf/gf-mul sc 224 0 256)
        ty (gf/gf-mul sc 240 16 256)
        py (gf/gf-pack sc out 0 240)
        px (gf/gf-pack sc out 32 224)
        fl (flip-sign-byte out)]
    (+ 1 (* 0 (+ id (+ bs (+ d2 (+ lp (+ zi (+ tx (+ ty (+ py (+ px fl)))))))))))))

;; out (128 bytes): bytes 0..31 the encoded public key; 32..63 scratch (packed x)
(defn aiueos-ed25519-pubkey [seed :i64 out :i64 ws :i64 hash :i64] :i64
  (let [sc (kernel-subregion ws 4096 0 4096)
        h (sha/aiueos-sha512 seed 32 hash sc 4096)
        ps (put-scalar sc hash 0)
        enc (basemul-encode sc out)]
    (+ 1 (* 0 (+ h (+ ps enc))))))

;; ---- signing (RFC 8032 5.1.6), messages up to 64 bytes ----
;; buf (1024 bytes) layout: 0..31 seed (input), 32..63 prefix, 64..95 A, 96..127 R, 128..159 S,
;; 160..191 k mod L, 192..223 r mod L, 224..255 clamped scalar a, 256..319 message (input),
;; 320..447 pack scratch, 448..511 hash output, 512..703 hash input. Workspace words 440..503 hold the
;; 64-limb integer x of the reductions (the field code uses words below 432).
(defn ld8 [buf at] (kernel-load-u8 (kernel-subregion buf 1024 at 1) 1 0))
(defn st8 [buf at v]
  (let [s (kernel-store-u8 (kernel-subregion buf 1024 at 1) 1 0 v)]
    (+ 1 (* 0 s))))

(defn copy-bytes [buf dst src n i]
  (if (>= i n) 1
    (let [s (st8 buf (+ dst i) (ld8 buf (+ src i)))]
      (copy-bytes buf dst src n (+ i 1 (* 0 s))))))

(defn asr [v k]
  (- (u64-shift-right (+ v 4503599627370496) k) (i64-shift-left 1 (- 52 k))))

(defn lc [j]
  (case j 0 237 1 211 2 245 3 92 4 26 5 99 6 18 7 88 8 214 9 156 10 247 11 162 12 222 13 249 14 222 15 20 31 16 0))

(defn xld [ws i] (gf/ld ws (+ 440 i)))
(defn xst [ws i v] (gf/st ws (+ 440 i) v))

;; x[0..63] := the 64 bytes at buf[at..]
(defn x-from-buf [ws buf at i]
  (if (= i 64) 1
    (let [s (xst ws i (ld8 buf (+ at i)))]
      (x-from-buf ws buf at (+ i 1 (* 0 s))))))

;; x[0..31] := buf[at..]; x[32..63] := 0
(defn x-from-scalar [ws buf at i]
  (if (= i 64) 1
    (let [s (xst ws i (if (< i 32) (ld8 buf (+ at i)) 0))]
      (x-from-scalar ws buf at (+ i 1 (* 0 s))))))

;; x[i + j] += k[i] * a[j]
(defn muladd-inner [ws buf i j]
  (if (= j 32) 1
    (let [s (xst ws (+ i j) (+ (xld ws (+ i j)) (* (ld8 buf (+ 160 i)) (ld8 buf (+ 224 j)))))]
      (muladd-inner ws buf i (+ j 1 (* 0 s))))))
(defn muladd-outer [ws buf i]
  (if (= i 32) 1
    (let [r (muladd-inner ws buf i 0)]
      (muladd-outer ws buf (+ i 1 (* 0 r))))))

;; TweetNaCl modL, pass 1: for i = 63 down to 32
(defn modl-inner [ws i j carry]
  (if (= j (- i 12)) carry
    (let [xj (+ (xld ws j) (- carry (* 16 (* (xld ws i) (lc (- j (- i 32)))))))
          c (asr (+ xj 128) 8)
          s (xst ws j (- xj (i64-shift-left c 8)))]
      (modl-inner ws i (+ j 1 (* 0 s)) c))))
(defn modl-outer [ws i]
  (if (< i 32) 1
    (let [c (modl-inner ws i (- i 32) 0)
          s (xst ws (- i 12) (+ (xld ws (- i 12)) c))
          z (xst ws i 0)]
      (modl-outer ws (- i (+ 1 (* 0 (+ s z))))))))
(defn modl-pass2 [ws j carry]
  (if (= j 32) carry
    (let [xj (+ (xld ws j) (- carry (* (asr (xld ws 31) 4) (lc j))))
          c (asr xj 8)
          s (xst ws j (bit-and xj 255))]
      (modl-pass2 ws (+ j 1 (* 0 s)) c))))
(defn modl-pass3 [ws j carry]
  (if (= j 32) 1
    (let [s (xst ws j (- (xld ws j) (* carry (lc j))))]
      (modl-pass3 ws (+ j 1 (* 0 s)) carry))))
(defn modl-pass4 [ws buf dst i]
  (if (= i 32) 1
    (let [s (xst ws (+ i 1) (+ (xld ws (+ i 1)) (asr (xld ws i) 8)))
          o (st8 buf (+ dst i) (bit-and (xld ws i) 255))]
      (modl-pass4 ws buf dst (+ i 1 (* 0 (+ s o)))))))

;; reduce x (64 limbs) mod L into 32 bytes at buf[dst..]
(defn mod-l [ws buf dst]
  (let [p1 (modl-outer ws 63)
        c (modl-pass2 ws 0 0)
        p3 (modl-pass3 ws 0 c)
        p4 (modl-pass4 ws buf dst 0)]
    (+ 1 (* 0 (+ p1 (+ p3 p4))))))

;; scalar words 272..303 := the 32 bytes at buf[at..]
(defn scalar-from-buf [ws buf at i]
  (if (= i 32) 1
    (let [s (gf/st ws (+ 272 i) (ld8 buf (+ at i)))]
      (scalar-from-buf ws buf at (+ i 1 (* 0 s))))))

;; encode k*B for the scalar at buf[at..] into buf[dst..dst+31] (pack scratch at buf[320..447])
(defn base-encode [ws buf at dst]
  (let [sf (scalar-from-buf ws buf at 0)
        enc (basemul-encode ws (kernel-subregion buf 1024 320 128))
        cp (copy-bytes buf dst 320 32 0)]
    (+ 1 (* 0 (+ sf (+ enc cp))))))

;; hash buf[512 .. 512+n) into buf[448..511]
(defn hash-input [ws buf n]
  (sha/aiueos-sha512 (kernel-subregion buf 1024 512 n) n (kernel-subregion buf 1024 448 64) ws 4096))

(defn sig-out [buf sig i]
  (if (= i 64) 1
    (let [s (kernel-store-u8 (kernel-subregion sig 64 i 1) 1 0 (ld8 buf (+ 96 i)))]
      (sig-out buf sig (+ i 1 (* 0 s))))))

(defn aiueos-ed25519-sign [buf :i64 msglen :i64 sig :i64 ws :i64] :i64
  (let [sc (kernel-subregion ws 4096 0 4096)
        h1 (sha/aiueos-sha512 (kernel-subregion buf 1024 0 32) 32 (kernel-subregion buf 1024 448 64) sc 4096)
        pre (copy-bytes buf 32 480 32 0)
        a0 (copy-bytes buf 224 448 32 0)
        a1 (st8 buf 224 (bit-and (ld8 buf 224) 248))
        a2 (st8 buf 255 (bit-or (bit-and (ld8 buf 255) 127) 64))
        pa (base-encode sc buf 224 64)
        i1 (copy-bytes buf 512 32 32 0)
        i2 (copy-bytes buf 544 256 msglen 0)
        h2 (hash-input sc buf (+ 32 msglen))
        x1 (x-from-buf sc buf 448 0)
        m1 (mod-l sc buf 192)
        pr (base-encode sc buf 192 96)
        j1 (copy-bytes buf 512 96 32 0)
        j2 (copy-bytes buf 544 64 32 0)
        j3 (copy-bytes buf 576 256 msglen 0)
        h3 (hash-input sc buf (+ 64 msglen))
        x2 (x-from-buf sc buf 448 0)
        m2 (mod-l sc buf 160)
        x3 (x-from-scalar sc buf 192 0)
        ma (muladd-outer sc buf 0)
        m3 (mod-l sc buf 128)
        o1 (sig-out buf sig 0)]
    (+ 1 (* 0 (+ h1 (+ pre (+ a0 (+ a1 (+ a2 (+ pa (+ i1 (+ i2 (+ h2 (+ x1 (+ m1 (+ pr (+ j1 (+ j2 (+ j3 (+ h3 (+ x2 (+ m2 (+ x3 (+ ma (+ m3 o1)))))))))))))))))))))))))

;; ---- verification (RFC 8032 5.1.7), messages up to 64 bytes ----
;; buf (1024 bytes) layout: 0..31 A (the public key), 32..63 R, 64..95 S, 96..159 message (inputs); 160..191 k = H(R, A, M) mod L,
;; 320..447 pack scratch (R' is encoded at 320..351), 448..511 hash output, 512..703 hash input. Returns 1 when the
;; signature is valid and 0 for everything else: S not below L, a public key that is not a curve point, or R' != R.
;; The check is [S]B + [k](-A) = R' and R' == R, as in TweetNaCl crypto_sign_open (A is unpacked negated).
;; Workspace words in use (the field code keeps 320..431): P 0..63, Q 64..127, temporaries 128..207, 2d 208, D 224, I 240,
;; c 176, a zero element 304, the saved point 440..503 (free after mod-l).
(defn copy-words [ws dst src n i]
  (if (>= i n) 1
    (let [s (gf/st ws (+ dst i) (gf/ld ws (+ src i)))]
      (copy-words ws dst src n (+ i 1 (* 0 s))))))

(defn unpack-gf [ws o buf at i]
  (if (= i 16) 1
    (let [lo (ld8 buf (+ at (* 2 i)))
          hi (ld8 buf (+ at (+ (* 2 i) 1)))
          v (+ lo (* hi 256))
          s (gf/st ws (+ o i) (if (= i 15) (bit-and v 32767) v))]
      (unpack-gf ws o buf at (+ i 1 (* 0 s))))))

(defn pow-loop [ws c i a]
  (if (< a 0) 1
    (let [m1 (gf/gf-mul ws c c c)
          m2 (if (= a 1) 0 (gf/gf-mul ws c c i))]
      (pow-loop ws c i (- a (+ 1 (* 0 (+ m1 m2))))))))

;; o := i^(2^252 - 3); c is a 16-word scratch element
(defn pow2523 [ws o i c]
  (let [cp (copy-words ws c i 16 0)
        lp (pow-loop ws c i 250)
        o2 (copy-words ws o c 16 0)]
    (+ 1 (* 0 (+ cp (+ lp o2))))))

(defn bytes-differ [buf a b i acc]
  (if (= i 32) acc
    (bytes-differ buf a b (+ i 1) (bit-or acc (bit-xor (ld8 buf (+ a i)) (ld8 buf (+ b i)))))))

;; 1 when the field elements at words x and y differ (compared packed, so the representation does not matter)
(defn gf-neq [ws buf x y]
  (let [p1 (gf/gf-pack ws (kernel-subregion buf 1024 320 128) 0 x)
        p2 (gf/gf-pack ws (kernel-subregion buf 1024 320 128) 32 y)
        d (bytes-differ buf 320 352 0 0)]
    (+ (if (= d 0) 0 1) (* 0 (+ p1 p2)))))

(defn gf-parity [ws buf x]
  (let [p (gf/gf-pack ws (kernel-subregion buf 1024 320 128) 0 x)]
    (+ (bit-and (ld8 buf 320) 1) (* 0 p))))

;; Q := -A in extended coordinates from the 32 bytes at buf[0..]; 1 on success, 0 when A is not a curve point
(defn unpackneg [ws buf]
  (let [d1 (load-const ws 224 4 0)
        i1 (load-const ws 240 5 0)
        z (set-elem ws 96 1 0)
        zr (set-elem ws 304 0 0)
        y (unpack-gf ws 80 buf 0 0)
        m1 (gf/gf-mul ws 0 80 80)
        m2 (gf/gf-mul ws 16 0 224)
        s1 (gf/gf-sub ws 0 0 96 0)
        a1 (gf/gf-add ws 16 96 16 0)
        m3 (gf/gf-mul ws 128 16 16)
        m4 (gf/gf-mul ws 144 128 128)
        m5 (gf/gf-mul ws 160 144 128)
        m6 (gf/gf-mul ws 32 160 0)
        m7 (gf/gf-mul ws 32 32 16)
        pw (pow2523 ws 32 32 176)
        m8 (gf/gf-mul ws 32 32 0)
        m9 (gf/gf-mul ws 32 32 16)
        m10 (gf/gf-mul ws 32 32 16)
        m11 (gf/gf-mul ws 64 32 16)
        m12 (gf/gf-mul ws 48 64 64)
        m13 (gf/gf-mul ws 48 48 16)
        n1 (gf-neq ws buf 48 0)
        m14 (if (= n1 1) (gf/gf-mul ws 64 64 240) 0)
        m15 (gf/gf-mul ws 48 64 64)
        m16 (gf/gf-mul ws 48 48 16)
        n2 (gf-neq ws buf 48 0)]
    (if (= n2 1) 0
      (let [par (gf-parity ws buf 64)
            sign (u64-shift-right (ld8 buf 31) 7)
            ng (if (= par sign) (gf/gf-sub ws 64 304 64 0) 0)
            m17 (gf/gf-mul ws 112 64 80)]
        (+ 1 (* 0 (+ d1 (+ i1 (+ z (+ zr (+ y (+ m1 (+ m2 (+ s1 (+ a1 (+ m3 (+ m4 (+ m5 (+ m6 (+ m7 (+ pw (+ m8 (+ m9 (+ m10 (+ m11 (+ m12 (+ m13 (+ m14 (+ m15 (+ m16 (+ ng m17)))))))))))))))))))))))))))))))

(defn l-byte [i]
  (case i 0 237 1 211 2 245 3 92 4 26 5 99 6 18 7 88 8 214 9 156 10 247 11 162 12 222 13 249 14 222 15 20 31 16 0))

;; 1 when S (buf[64..95], little endian) < L
(defn s-lt-l [buf i]
  (if (< i 0) 0
    (let [sb (ld8 buf (+ 64 i))
          lb (l-byte i)]
      (if (< sb lb) 1 (if (> sb lb) 0 (s-lt-l buf (- i 1)))))))

(defn aiueos-ed25519-verify [buf :i64 msglen :i64 ws :i64] :i64
  (let [sc (kernel-subregion ws 4096 0 4096)
        oks (s-lt-l buf 31)
        c1 (copy-bytes buf 512 32 32 0)
        c2 (copy-bytes buf 544 0 32 0)
        c3 (copy-bytes buf 576 96 msglen 0)
        h (hash-input sc buf (+ 64 msglen))
        x1 (x-from-buf sc buf 448 0)
        m (mod-l sc buf 160)
        d2 (load-const sc 208 0 0)
        un (unpackneg sc buf)]
    (if (and (= oks 1) (= un 1))
      (let [sk (scalar-from-buf sc buf 160 0)
            id1 (point-identity sc)
            l1 (scalar-loop sc 255)
            sv (copy-words sc 440 0 64 0)
            id2 (point-identity sc)
            bs (point-base sc)
            ss (scalar-from-buf sc buf 64 0)
            l2 (scalar-loop sc 255)
            ad (point-add sc 0 440)
            zi (gf/gf-inv sc 256 32)
            tx (gf/gf-mul sc 224 0 256)
            ty (gf/gf-mul sc 240 16 256)
            out (kernel-subregion buf 1024 320 128)
            py (gf/gf-pack sc out 0 240)
            px (gf/gf-pack sc out 32 224)
            fl (flip-sign-byte out)
            diff (bytes-differ buf 320 32 0 0)]
        (+ (if (= diff 0) 1 0) (* 0 (+ c1 (+ c2 (+ c3 (+ h (+ x1 (+ m (+ d2 (+ sk (+ id1 (+ l1 (+ sv (+ id2 (+ bs (+ ss (+ l2 (+ ad (+ zi (+ tx (+ ty (+ py (+ px fl))))))))))))))))))))))))
      0)))

(defn main [] :i64 0)
