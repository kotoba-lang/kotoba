(ns aiueos.value-runtime-entry
  (:require [aiueos.value-runtime-dispatch :as dispatch])
  (:export [aiueos-value-runtime-entry main]))

;; C-free normalized entry for the native ValueRuntime syscall path.
;;
;; Arguments:
;;   arena          process-owned RW/NX Handle page
;;   entry-profile  trusted offset/domain/length lanes supplied by assembly
;;   user-page      current process private 4 KiB page
;;   kernel-request kernel-owned 96-byte scratch envelope
;;   cap-table      bounded 4 KiB capability table
;;
;; The untrusted envelope is exactly 104 bytes at the admitted page offset:
;; request fields 0..23, expected digest 24..55, presented capability handle
;; 56..63, and canonical zero bytes 64..103. The entry copies fields 0..55 and
;; zeroes 56..95 in the
;; kernel envelope, and passes the separately decoded handle to the typed
;; dispatcher. The caller domain exists only in the trusted entry profile.

(defn load-u32-entry [base :i64 length :i64 index :i64] :i64
  (+ (kernel-load-u8 base length index)
     (* (kernel-load-u8 base length (+ index 1)) 256)
     (* (kernel-load-u8 base length (+ index 2)) 65536)
     (* (kernel-load-u8 base length (+ index 3)) 16777216)))

(defn profile-lane-entry [profile :i64 divisor :i64] :i64
  (bit-and (quot profile divisor) 65535))

(defn entry-profile-valid? [profile :i64] :bool
  (let [offset (profile-lane-entry profile 1)
        domain (profile-lane-entry profile 65536)]
    (and (> profile 0)
         (<= offset 3992)
         (> domain 0)
         (<= domain 32767)
         (= (profile-lane-entry profile 4294967296) 4096)
         (= (profile-lane-entry profile 281474976710656) 104))))

(defn copy-prefix!
  [source :i64 destination :i64 index :i64 end :i64] :bool
  (if (= index end)
    true
    (let [byte (kernel-load-u8 source 104 index)]
      (if (= (kernel-store-u8 destination 96 index byte) byte)
        (copy-prefix! source destination (+ index 1) end)
        false))))

(defn zero-suffix! [destination :i64 index :i64 end :i64] :bool
  (if (= index end)
    true
    (if (= (kernel-store-u8 destination 96 index 0) 0)
      (zero-suffix! destination (+ index 1) end)
      false)))

(defn raw-suffix-zero? [source :i64 index :i64 end :i64] :bool
  (if (= index end)
    true
    (if (= (kernel-load-u8 source 104 index) 0)
      (raw-suffix-zero? source (+ index 1) end)
      false)))

(defn capability-handle [source :i64] :i64
  (+ (load-u32-entry source 104 56)
     (* (load-u32-entry source 104 60) 4294967296)))

(defn dispatcher-profile [domain :i64] :i64
  (+ 4096 (* 96 65536) (* 4096 4294967296)
     (* domain 281474976710656)))

(defn aiueos-value-runtime-entry
  [arena :i64 entry-profile :i64 user-page :i64
   kernel-request :i64 cap-table :i64] :i64
  (if (entry-profile-valid? entry-profile)
    (let [offset (profile-lane-entry entry-profile 1)
          domain (profile-lane-entry entry-profile 65536)
          source (kernel-subregion user-page 4096 offset 104)
          handle (capability-handle source)]
      (if (and (raw-suffix-zero? source 64 104)
               (copy-prefix! source kernel-request 0 56)
               (zero-suffix! kernel-request 56 96))
        (dispatch/aiueos-value-runtime-dispatch
         arena (dispatcher-profile domain) kernel-request cap-table handle)
        0))
    0))

(defn main [] :i64 0)
