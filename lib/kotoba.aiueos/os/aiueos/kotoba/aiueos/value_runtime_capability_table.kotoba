(ns aiueos.value-runtime-capability-table
  (:export [aiueos-value-runtime-capability-mutate main]))

;; Slot zero is the table-wide atomic lock. Slots 1..255 are exact 16-byte
;; ValueRuntime capabilities. The private table address is derived only by a
;; kernel intrinsic; callers can request state transitions but cannot supply a
;; replacement address.

(defn read-u16-cap [table index]
  (+ (kernel-load-u8-4k table 4096 index)
     (* (kernel-load-u8-4k table 4096 (+ index 1)) 256)))

(defn read-u32-cap [table index]
  (+ (read-u16-cap table index)
     (* (read-u16-cap table (+ index 2)) 65536)))

(defn write-u16-cap [table index value]
  (if (= (kernel-store-u8-4k table 4096 index (bit-and value 255))
         (bit-and value 255))
    (if (= (kernel-store-u8-4k table 4096 (+ index 1)
                               (bit-and (quot value 256) 255))
           (bit-and (quot value 256) 255))
      1 0)
    0))

(defn write-u32-cap [table index value]
  (if (= (write-u16-cap table index (bit-and value 65535)) 1)
    (write-u16-cap table (+ index 2) (bit-and (quot value 65536) 65535))
    0))

(defn zero-cap-tail [table index end]
  (if (= index end)
    1
    (if (= (kernel-store-u8-4k table 4096 index 0) 0)
      (zero-cap-tail table (+ index 1) end)
      0)))

(defn capability-handle-cap [slot generation rights]
  (+ slot (* generation 65536) (* 2 4294967296)
     (* rights 281474976710656)))

(defn issue-locked [table slot expected-generation grant owner]
  (let [base (* slot 16)
        rights (bit-and grant 65535)
        provider-generation (bit-and (quot grant 65536) 65535)
        generation (read-u16-cap table base)
        state-rights (read-u32-cap table (+ base 4))
        active (bit-and state-rights 65536)
        next-generation (if (= generation 65535) 1 (+ generation 1))]
    (if (and (= active 0)
             (= generation expected-generation)
             (> rights 0) (<= rights 7)
             (> provider-generation 0)
             (> owner 0) (<= owner 32767)
             (= (write-u32-cap table (+ base 4) 0) 1)
             (= (write-u16-cap table base next-generation) 1)
             (= (write-u16-cap table (+ base 2) 2) 1)
             (= (write-u16-cap table (+ base 8) owner) 1)
             (= (write-u16-cap table (+ base 10) provider-generation) 1)
             (= (zero-cap-tail table (+ base 12) (+ base 16)) 1)
             (= (write-u32-cap table (+ base 4) (+ 65536 rights)) 1))
      (capability-handle-cap slot next-generation rights)
      0)))

(defn revoke-locked [table slot expected-generation grant owner]
  (let [base (* slot 16)
        generation (read-u16-cap table base)
        type (read-u16-cap table (+ base 2))
        state-rights (read-u32-cap table (+ base 4))
        active (bit-and state-rights 65536)
        current-owner (read-u16-cap table (+ base 8))]
    (if (and (= grant 0)
             (= generation expected-generation)
             (= type 2) (= active 65536) (= current-owner owner)
             (= (write-u32-cap table (+ base 4) 0) 1)
             (= (write-u16-cap table (+ base 2) 0) 1)
             (= (write-u16-cap table (+ base 8) 0) 1)
             (= (zero-cap-tail table (+ base 10) (+ base 16)) 1))
      1
      0)))

(defn aiueos-value-runtime-capability-mutate
  [action :i64 slot :i64 expected-generation :i64 grant :i64 owner :i64] :i64
  (let [table (kernel-value-runtime-capability-table)]
    (if (and (> table 0) (> slot 0) (< slot 256)
             (<= 0 expected-generation) (<= expected-generation 65535)
             (= (kernel-try-lock-u32 table 4096 0) 1))
      (let [result (if (= action 1)
                     (issue-locked table slot expected-generation grant owner)
                     (if (= action 2)
                       (revoke-locked table slot expected-generation grant owner)
                       0))
            released (kernel-unlock-u32 table 4096 0)]
        (if (= released 1) result 0))
      0)))

(defn main [] :i64 0)
