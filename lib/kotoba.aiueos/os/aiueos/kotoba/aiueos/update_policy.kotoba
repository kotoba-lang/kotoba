(ns aiueos.update-policy
  (:export [image-admission check-verdict next-actions may-run]))

;; JUN-813 (epic JUN-805): the update manager's pure host-side policy. It maps
;; (policy mode, event, stage, ...) to the actions the manager may offer, and it
;; decides whether one requested operation may leave the device. It reads no
;; clock, storage or network and writes nothing. It is NOT part of any kernel
;; image: no entry file requires it, and distributions/awai/update-policy.json
;; remains the source of the mode table (scripts/check-update-policy.py checks
;; this file's constants against it).
;;
;; Rules (distributions/awai/update-policy.json "background"; ADR-0283, ADR-0286):
;;   - A schedule may only raise a prompt. The tick (event 1) never starts an
;;     operation: `next-actions` returns prompts and enabled buttons, never a run.
;;   - Check, download and install are three operations. Each runs only with its
;;     own fresh approval (`may-run`); no mode, event or stage skips it, and an
;;     approval for one operation, or one already used, permits no other.
;;   - Freshness (AIUEFRS1) only decides what `check` may say; it never authorizes
;;     or blocks an install (ADR-0286 Amendment 6). Image admission is the
;;     signature rule and the version floor (Amendments 2 and 4).
;;
;; Encodings. mode: 0 manual, 1 notify (default), 2 auto-stage, 3 auto-install
;; (the order of update-policy.json "modes"; scripts/check-update-manager.py compares both). event: 0 none (the manager is
;; open), 1 schedule tick, 2 boot. stage: 0 idle, 1 update found (a signed image
;; entry is known), 2 staged (downloaded, digest verified), 3 installed.
;; endpoint: 1 when an update origin is registered, else 0. admitted: 1 when the
;; known image entry passed image-admission. op: 1 check, 2 download, 3 install.
;; Result bits of next-actions: 1 prompt to check, 2 prompt to download, 4 prompt
;; to install, 8 button check, 16 button download, 32 button install. A prompt
;; only asks; answering it is an approval of exactly that operation.

;; Kernel result codes of update.kotoba admit: 1 fewer than two distinct valid
;; signers, 9 version not strictly above the floor, 10 floor unreadable (fail
;; closed). `floor` below 0 means the journal could not be read. 0 = admitted.
(defn image-admission [signers :i64 version :i64 floor :i64] :i64
  (cond (< signers 2) 1
        (< floor 0) 10
        (<= version floor) 9
        :else 0))

;; AIUEFRS1 judged against the clock (ADR-0286 Amendment 6): verdict 1 fresh,
;; 2 expired, 3 clock behind, 4 no clock; record 1 when the record was verified,
;; else 0 (missing or refused: contributes no data). Result: 1 up to date,
;; 2 update available, 3 not fresh (cannot tell), 4 not fresh but at least
;; `latest` exists (a verified record is a true lower bound).
(defn check-verdict [record :i64 verdict :i64 latest :i64 installed :i64] :i64
  (cond (not (= record 1)) 3
        (= verdict 1) (if (> latest installed) 2 1)
        (> latest installed) 4
        :else 3))

(defn b [x :bool] :i64 (if x 1 0))

(defn next-actions [mode :i64 event :i64 stage :i64 endpoint :i64 admitted :i64] :i64
  (let [has-endpoint (= endpoint 1)
        ok (= admitted 1)
        prompt-check (b (and (= event 1) (>= mode 1) (= stage 0) has-endpoint))
        prompt-download (b (and (or (= event 0) (= event 1)) (>= mode 2) (= stage 1) ok has-endpoint))
        prompt-install (b (and (= event 2) (= mode 3) (= stage 2) ok))
        button-check (b has-endpoint)
        button-download (b (and (= stage 1) ok has-endpoint))
        button-install (b (and (= stage 2) ok))]
    (+ prompt-check (* 2 prompt-download) (* 4 prompt-install)
       (* 8 button-check) (* 16 button-download) (* 32 button-install))))

;; 1 when `op` may now send its request or write: the user (or an answered
;; prompt) approved exactly this operation, the approval is fresh (not used
;; before), and the operation is offered in this state. The mode is an input only
;; so that no mode can be a bypass: it changes nothing here.
(defn may-run [mode :i64 event :i64 stage :i64 endpoint :i64 admitted :i64 op :i64 approved-op :i64 fresh :i64] :i64
  (let [acts (next-actions mode event stage endpoint admitted)
        offered (case op
                  1 (bit-and acts 9)
                  2 (bit-and acts 18)
                  3 (bit-and acts 36)
                  0)]
    (b (and (= fresh 1) (= approved-op op) (> op 0) (> offered 0)))))
