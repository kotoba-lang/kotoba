(ns aiueos.draft-policy-browser
  (:export [main])
  (:capabilities [:cli/args :io/write])
  (:require [aiueos.draft-policy :as policy]))

;; Transport ABI for a host that has parsed the legacy draft JSON. The host
;; must preserve the original JSON and reject non-scalar UTF-16 strings before
;; passing them here. The policy, not this transport, decides restoration.
(defn arg [i :i64] :string
  (typed-cap-call :cli/args :string :string (string-from-i64 i)))
(defn number [s :string] :i64
  (let [v (vector-i64-from-bytes (string-to-utf8 s)) n (vector-count v)]
    (if (or (= n 0) (> n 7)) -1
      (loop [i 0 x 0]
        (if (= i n) x
          (let [c (vector-at v i)]
            (if (or (< c 48) (> c 57)) -1
              (recur (+ i 1) (+ (* x 10) (- c 48))))))))))
(defn entries [n :i64 initial :document] :document
  (loop [i 0 out initial]
    (if (= i n) out
      (recur (+ i 1)
        (document-vector-conj out (document-vector (document-string (arg (+ 13 (* i 2))))
                                                  (document-i64 (policy/units (arg (+ 14 (* i 2)))))))))))
(defn null-or-string [flag :string value :string] :document
  (if (string=? flag "null") (document-null) (document-string value)))
(defn main [] :i64
  (let [argc (number (typed-cap-call :cli/args :string :string ""))]
    (if (< argc 14) 2
      (let [raw (number (arg 1)) limit (number (arg 2)) allow (arg 3)
        persisted-kind (arg 5) base-kind (arg 9) count (number (arg 12))]
    (if (or (not (string=? (arg 0) "classify"))
            (< raw 0) (> raw 1000000) (< limit 0) (> limit 1000000)
            (not (or (string=? allow "0") (string=? allow "1")))
            (not (or (string=? persisted-kind "null") (string=? persisted-kind "string")))
            (not (or (string=? base-kind "null") (string=? base-kind "string")))
            (< count 0) (> count 33)) 2
      (let [visible-pos (+ 13 (* count 2))]
        (if (>= visible-pos argc) 2
          (let [visible-count (number (arg visible-pos))]
        (if (or (< visible-count 0) (> visible-count 512)
                (not= argc (+ visible-pos 2))) 2
          (let [data (entries (if (> count 32) 32 count) (document-vector))
                tail (if (= count 33) (document-vector (document-string (arg 77))
                                                       (document-i64 (policy/units (arg 78)))) (document-null))
                result (policy/classify-chunks raw (arg 4) persisted-kind (arg 6) (arg 7)
                         (arg 8) base-kind (arg 10) (arg 11) data tail
                         (arg (+ visible-pos 1)) visible-count (string=? allow "1") limit)
                written (typed-cap-call :io/write :string :string
                          (string-concat (string-from-i64 result) "\n"))] 0))))))))))
