;; JUN-708: built on amu's native object route: the namespace form comes first and exports the C name only, with no
;; test main and private helpers. The route proves a window's base only through every call of a helper, so:
;; - every helper that reaches the state takes its length (st-len, or the sb the old helpers already took) after st,
;;   and every window is narrowed from it: w-at / w-put through the 128-byte prefix (their old window), sv-at / sc-at
;;   from the state's own length, which is 8192 whenever they run (each caller tests sb = 8192 first);
;; - a helper keeps at most five parameters: set-capture carries (id, kind) as id * 4 + kind and tray-at (k, i) as
;;   k * 8 + i (kind < 3, i < 5);
;; - vis-count counts with an accumulator (a non-tail self-call is a cycle for the proof), and a call that passes a
;;   helper a region and then an argument with an if binds that argument first (jhN), in the same evaluation order.
;; The ABI, the answers and every byte read and written are unchanged.
(ns aiueos.browser-reduce (:export [kotoba_aiueos_browser_reduce]))

;; Guest browser desktop input: one canonical event -> kotoba-lang/browser
;; surface action, applied to the surface state, on KERNEL.ELF (ADR-0223).
;;
;; WHY THIS IS A KOTOBA OBJECT AND NOT A C TABLE
;;
;; C owns the virtio-input rings and scales a tablet's absolute axes to
;; surface pixels (mechanism). WHICH window a pointer lands on, and what that
;; does to focus and stacking, is the browser guest's decision
;; (kotoba-lang/browser ADR 0002). C never chooses a window.
;;
;; Mirrored from kotoba-lang/browser:
;;   pointer/down  browser.input/actions-for-event: window-at walks
;;                 `:surface/windows` in reverse (topmost first) with an
;;                 inclusive point-in-rect; a hit yields `:window/focus`,
;;                 a miss yields no action.
;;   window/focus  browser.surface/focus-window: set focus AND move the
;;                 window to the end of `:surface/windows` (raise).
;;   keyboard/key  browser.input: `:keyboard/key` on the focused window;
;;                 no geometry changes.
;;   pointer capture (ADR-0229) browser.input: a pointer/down that hits a
;;                 window inside its titlebar (y .. y + 28, inclusive) and
;;                 outside its 16 px resize handle captures `:drag` with the
;;                 offset from the window origin; a hit anywhere else clears
;;                 the capture; a miss leaves it as it was. pointer/move under
;;                 `:drag` is `:window/move` to (point - offset) --
;;                 browser.surface/move-window, which neither focuses nor
;;                 raises. pointer/up clears the capture.
;;   resize capture (ADR-0230) browser.input: a pointer/down inside the 16 px
;;                 resize handle (the last 16 px of both axes, inclusive)
;;                 captures `:resize` with the press point and the window's
;;                 size at the press. pointer/move under `:resize` is
;;                 `:window/resize` to (max 120 (w0 + px - x0)) x
;;                 (max 80 (h0 + py - y0)) -- browser.surface/resize-window,
;;                 which neither focuses, raises nor moves the origin.
;;   launcher and close (ADR-0233) browser.surface launch-app / close-window,
;;                 behind geometry the oracle does not have (its window-node
;;                 has no close control and its launcher is a DOM row laid out
;;                 by cssom): word 31 is the app register -- bit k-1 set means
;;                 app k is registered, and app k's title and document are
;;                 the title and body slots of window id k. With word 31 not
;;                 0, a press that hits a window of at least 40 px width
;;                 inside its close control (x + w - 24 .. x + w - 8,
;;                 y + 6 .. y + 22, inclusive) is `:window/close`: the window
;;                 leaves the stack, and if it had the focus, the focus goes to
;;                 the window now on top (browser.surface close-window); the
;;                 press raises nothing. A press that hits no window inside
;;                 launcher button k (x 6 + 102(k-1) .. + 96, y 2 .. 26,
;;                 inclusive) of a registered app is `:app/launch`: a window
;;                 id k at browser.surface open-window's default rect
;;                 (80, 80, 520, 360) goes on top and takes the focus. Both
;;                 clear the capture: a press on the chrome ends a gesture.
;;                 Named differences: one window per app (a launch of an app
;;                 whose window is open raises and focuses it; the oracle
;;                 opens another window) `:one-window-per-app`; the last
;;                 window cannot be closed (-8; the oracle leaves none)
;;                 `:the-last-window-stays`.
;;   window/focus (ADR-0237) browser.surface focus-window applied to an id
;;                 the event names, not to a hit: the window-manager shortcut
;;                 (Alt+Tab) is decided by browser-ime.kotoba, which answers the
;;                 id to focus, and C hands that id here. The window is focused
;;                 and raised exactly as a press raises it; the capture is left
;;                 as it was (focus-window does not touch browser.input's
;;                 state). An id not in the stack changes nothing and answers 0
;;                 -- focus-window's own no-op for an unknown id.
;;   pointer/wheel (ADR-0238) browser.input :pointer/wheel: window-at (the
;;                 same topmost-first hit as a press) yields `:window/scroll`
;;                 of the window under the pointer -- it neither focuses nor
;;                 raises, and the capture is left as it was; a miss is no
;;                 action. browser.surface scroll-window adds the delta to
;;                 `:window/scroll` and clamps it at 0 (there is no upper
;;                 clamp). The kernel's notch: kind 6 is one notch toward the
;;                 end of the body (delta-y +20, one line), kind 7 one toward
;;                 its start (-20) `:one-notch-is-one-line`; only the vertical
;;                 offset is kept `:vertical-only`. The offsets are not in the
;;                 128-byte state: surface words 2040..2043 hold window id
;;                 1..4's, so a wheel needs the whole 8192-byte surface
;;                 (state-bytes 8192; -10 on 128). An offset past 65535 is
;;                 refused (-12) and changes nothing `:scroll-ceiling-65535`.
;;                 With the whole surface a close zeroes the closed window's
;;                 offset: browser.surface close-window drops the window and
;;                 its scroll with it, and a later launch opens a new one at 0.
;;   minimize (ADR-0254) word 31 bits 4..7 are the minimized register, bit 3 + id for
;;                 window id 1..4 (bits 0..3 are still the app register; the
;;                 register may be up to 255, -7 above). A minimized window
;;                 stays in the stack but is not hit: a press goes to the window
;;                 under it. A press inside the minimize control of a window
;;                 (x + w - 64 .. x + w - 48, y + 6 .. y + 22, inclusive, window
;;                 at least 200 wide, two or more windows visible) raises the
;;                 window, sets its bit and focuses the topmost window that is
;;                 not minimized (the answer). A press inside the dock icon of
;;                 a minimized app (x (vw - 184) / 2 + 8 + 44 (k - 1) .. + 36,
;;                 y vh - 46 .. + 36, inclusive) clears the bit and raises and
;;                 focuses the window; the dock is above every window, so it is
;;                 tried first. A launch of a minimized app does the same, and a
;;                 close that would leave no window visible is refused (-8).
;;                 Named differences: no window list, no animation, no
;;                 keyboard minimize `:dock-restore-only`.
;; Not mirrored: text editing, IME. Named leftover `:no-text-edit`.
;; A move whose origin would be negative is refused (-6) and changes nothing:
;; the u32 surface has no negative coordinate; browser.surface would store it.
;;
;; Same 128-byte u32 state as browser-frame.kotoba (same temporary native
;; constraints -- word types, at most five parameters -- and the same removal
;; condition).
;;
;; STATE (u32 words): 0..4 abi n focus vw vh, 5..24 id x y w h per window
;; (bottom first), 25 capture kind (0 none, 1 drag, 2 resize), 26 captured
;; window id, 27 28 the drag's offset from the window origin or the resize's
;; press point, 29 30 the resize's size at the press (0 for a drag). 31 the
;; app register (ADR-0233): bits 0..3, app k = bit k-1; 0 = no launcher and
;; no close controls.
;;
;; ABI: [state state-bytes kind a b], mutates state in place. state-bytes is
;; 128 (the state alone) or 8192 (the whole surface, whose first 128 bytes are
;; the state; ADR-0238).
;;   kind 1 pointer/down at (a, b) -> focused window id, or 0 on a miss
;;   kind 2 key (a = code, b = value) -> focused window id that receives it
;;   kind 3 pointer/move to (a, b) -> the moved or resized window id, or 0
;;          uncaptured
;;   kind 4 pointer/up -> 0, capture cleared
;;   kind 5 window/focus of window id a (ADR-0237) -> a, focused and raised;
;;          0 and nothing changed when a is not in the stack
;;   kind 6 pointer/wheel one notch toward the body's end at (a, b), kind 7
;;          toward its start (ADR-0238) -> the scrolled window id, or 0 on a
;;          miss; needs state-bytes 8192
;;   (kind 1 with an app register: a close answers the focused window id
;;   after it, a launch the launched app's window id)
;;   -1 null region / wrong size   -2 abi or n out of range
;;   -3 focus is not a window id   -4 capture is not none, or a drag or resize
;;                                    of a window
;;   -5 unknown event kind         -6 the move would put the origin below 0
;;   -7 the app register has a bit past app 4
;;   -8 a close of the last window  -9 a launch whose default rect leaves the
;;                                     viewport
;;   -10 a wheel on the 128-byte state  -11 the wheel hit a window whose id is
;;                                        outside 1..4 (no offset word)
;;   -12 the offset would pass 65535



;; The state size is checked once at the entry (128 or 8192); every word below
;; 32 is inside both.
(defn- w-at [st st-len i]
  (kernel-load-u32 (kernel-subregion (kernel-subregion st st-len 0 128) 128 (* i 4) 4) 4 0))

(defn- w-put [st st-len i v]
  (kernel-store-u32 (kernel-subregion (kernel-subregion st st-len 0 128) 128 (* i 4) 4) 4 0 v))

(defn- has-id [st st-len n k id]
  (if (>= k n) 0
    (if (= (w-at st st-len (+ 5 (* k 5))) id) 1
      (has-id st st-len n (+ k 1) id))))

;; ADR-0254: a window can be minimized. Word 31 bits 4..7 are the minimized register, bit
;; 3 + id for window id 1..4 (the app register is bits 0..3); a minimized window stays in the
;; stack, is neither drawn nor hit, and is restored from its dock icon or its launcher button.
(defn- min-bit [id]
  (if (= id 1) 16 (if (= id 2) 32 (if (= id 3) 64 (if (= id 4) 128 0)))))

(defn- is-min [st st-len id]
  (if (= (bit-and (w-at st st-len 31) (min-bit id)) 0) 0 1))

(defn- vis-count [st st-len n k acc]
  (if (>= k n) acc
    (let [jh1 (+ k 1) jh2 (+ acc (if (= (is-min st st-len (w-at st st-len (+ 5 (* k 5)))) 1) 0 1))] (vis-count st st-len n jh1 jh2))))

;; The id of the topmost window that is not minimized at or below stack index k, or 0.
(defn- top-visible [st st-len k]
  (if (< k 0) 0
    (let [id (w-at st st-len (+ 5 (* k 5)))]
      (if (= (is-min st st-len id) 1) (top-visible st st-len (- k 1)) id))))

(defn- inside [st st-len k px py]
  (let [b (+ 5 (* k 5))
        x (w-at st st-len (+ b 1))
        y (w-at st st-len (+ b 2))
        w (w-at st st-len (+ b 3))
        h (w-at st st-len (+ b 4))]
    (if (= (is-min st st-len (w-at st st-len b)) 1) 0
    (if (< px x) 0
      (if (> px (+ x w)) 0
        (if (< py y) 0
          (if (> py (+ y h)) 0 1)))))))

;; Topmost first. Returns the stack index + 1, or 0.
(defn- hit [st st-len k px py]
  (if (< k 0) 0
    (if (= (inside st st-len k px py) 1) (+ k 1)
      (hit st st-len (- k 1) px py))))

(defn- copy-rec [st st-len from to]
  (let [fb (+ 5 (* from 5))
        tb (+ 5 (* to 5))]
    (do (w-put st st-len tb (w-at st st-len fb))
        (w-put st st-len (+ tb 1) (w-at st st-len (+ fb 1)))
        (w-put st st-len (+ tb 2) (w-at st st-len (+ fb 2)))
        (w-put st st-len (+ tb 3) (w-at st st-len (+ fb 3)))
        (w-put st st-len (+ tb 4) (w-at st st-len (+ fb 4))))))

(defn- shift-down [st st-len k n]
  (if (>= k (- n 1)) 0
    (do (copy-rec st st-len (+ k 1) k)
        (shift-down st st-len (+ k 1) n))))

(defn- raise [st st-len k n]
  (let [b (+ 5 (* k 5))
        id (w-at st st-len b)
        x (w-at st st-len (+ b 1))
        y (w-at st st-len (+ b 2))
        w (w-at st st-len (+ b 3))
        h (w-at st st-len (+ b 4))
        tb (+ 5 (* (- n 1) 5))]
    (do (shift-down st st-len k n)
        (w-put st st-len tb id)
        (w-put st st-len (+ tb 1) x)
        (w-put st st-len (+ tb 2) y)
        (w-put st st-len (+ tb 3) w)
        (w-put st st-len (+ tb 4) h)
        (w-put st st-len 2 id)
        id)))

;; Index of window id in the stack, or -1.
(defn- index-of [st st-len n k id]
  (if (>= k n) -1
    (if (= (w-at st st-len (+ 5 (* k 5))) id) k
      (index-of st st-len n (+ k 1) id))))

(defn- capture-ok [st st-len n]
  (if (= (w-at st st-len 25) 0) 1
    (if (= (w-at st st-len 25) 1) (has-id st st-len n 0 (w-at st st-len 26))
      (if (= (w-at st st-len 25) 2) (has-id st st-len n 0 (w-at st st-len 26)) 0))))

;; browser.input in-resize-handle?: the last 16 px of both axes, inclusive.
(defn- in-handle [st st-len k px py]
  (let [b (+ 5 (* k 5))
        r (+ (w-at st st-len (+ b 1)) (w-at st st-len (+ b 3)))
        f (+ (w-at st st-len (+ b 2)) (w-at st st-len (+ b 4)))]
    (if (< px (- r 16)) 0
      (if (< py (- f 16)) 0 1))))

;; Set the capture for a press on stack index k (before the raise moves it).
(defn- set-capture [st st-len id+kind c d] (let [kind (- id+kind (* 4 (quot id+kind 4))) id+kind-q1 (quot id+kind 4) id id+kind-q1]
  (do (w-put st st-len 25 kind) (w-put st st-len 26 id) (w-put st st-len 27 c) (w-put st st-len 28 d))))

(defn- capture [st st-len k px py]
  (let [b (+ 5 (* k 5))
        x (w-at st st-len (+ b 1))
        y (w-at st st-len (+ b 2))]
    (do (w-put st st-len 29 0) (w-put st st-len 30 0)
        (if (= (in-handle st st-len k px py) 1)
          (do (set-capture st st-len (+ (* (w-at st st-len b) 4) 2) px py)
              (w-put st st-len 29 (w-at st st-len (+ b 3)))
              (w-put st st-len 30 (w-at st st-len (+ b 4))))
          (if (> py (+ y 28))
            (set-capture st st-len (+ (* 0 4) 0) 0 0)
            (set-capture st st-len (+ (* (w-at st st-len b) 4) 1) (- px x) (- py y)))))))

;; --- launcher and close (ADR-0233) -------------------------------------------

(defn- release-all [st st-len]
  (do (set-capture st st-len (+ (* 0 4) 0) 0 0) (w-put st st-len 29 0) (w-put st st-len 30 0)))

;; The close control of stack index k: x + w - 24 .. x + w - 8, y + 6 .. y + 22,
;; inclusive, on a window at least 40 wide.
(defn- in-close [st st-len k px py]
  (let [b (+ 5 (* k 5))
        r (+ (w-at st st-len (+ b 1)) (w-at st st-len (+ b 3)))
        y (w-at st st-len (+ b 2))]
    (if (< (w-at st st-len (+ b 3)) 40) 0
      (if (< px (- r 24)) 0
        (if (> px (- r 8)) 0
          (if (< py (+ y 6)) 0
            (if (> py (+ y 22)) 0 1)))))))

;; --- scroll (ADR-0238) --------------------------------------------------------
;; Window id's vertical offset, surface word 2039 + id. Only called with
;; state-bytes 8192 and id in 1..4.
(defn- sc-at [st st-len id]
  (kernel-load-u32 (kernel-subregion st st-len (* (+ 2039 id) 4) 4) 4 0))

(defn- sc-put [st st-len id v]
  (kernel-store-u32 (kernel-subregion st st-len (* (+ 2039 id) 4) 4) 4 0 v))

(defn- slot-ok [id] (if (< id 1) 0 (if (> id 4) 0 1)))

;; browser.surface scroll-window: (max 0 (+ offset delta)), delta +-20.
(defn- scroll-by [st st-len id down]
  (let [v (sc-at st st-len id)]
    (if (= down 1)
      (if (> (+ v 20) 65535) -12
        (do (sc-put st st-len id (+ v 20)) id))
      (do (let [jh3 (if (< v 20) 0 (- v 20))] (sc-put st st-len id jh3)) id))))

;; browser.input :pointer/wheel: the window under the pointer (k1 = stack
;; index + 1, 0 = a miss) scrolls; nothing is focused, raised or captured.
(defn- wheel [st sb k1 down]
  (if (not (= sb 8192)) -10
    (if (= k1 0) 0
      (let [id (w-at st sb (+ 5 (* (- k1 1) 5)))]
        (if (= (slot-ok id) 0) -11
          (scroll-by st sb id down))))))

;; A closed window's offset goes with it (whole surface only).
(defn- drop-scroll [st sb id]
  (if (= sb 8192)
    (if (= (slot-ok id) 1) (sc-put st sb id 0) 0)
    0))

;; --- maximize (ADR-0250) -------------------------------------------------------
;; A double press on a window's titlebar toggles it between its rect and the work
;; area (0, 28, vw, vh - 80: below the launcher bar, above the dock). Whole
;; surface only. A double press is a second press on the same window's titlebar
;; with at most three input events since the first: the events are counted by C in
;; word 2029 (no clock: the distance is the order of events, not milliseconds).
;; Words: 2010 + 4 (id - 1) .. +3 the rect a maximized window had (x y w h; its
;; w is 0 while the window is not maximized), 2027 the event count of the last
;; titlebar press, 2028 the window it was on (0 none), 2029 the event count now.
(defn- sv-at [st st-len i]
  (kernel-load-u32 (kernel-subregion st st-len (* i 4) 4) 4 0))

(defn- sv-put [st st-len i v]
  (kernel-store-u32 (kernel-subregion st st-len (* i 4) 4) 4 0 v))

(defn- max-saved [id] (+ 2010 (* 4 (- id 1))))

(defn- in-title [st st-len k px py]
  (let [b (+ 5 (* k 5))
        y (w-at st st-len (+ b 2))]
    (if (< py y) 0
      (if (> py (+ y 28)) 0 1))))

;; The press at (px, py) on stack index k is the second of a double press.
(defn- double-press [st sb k px py]
  (if (not (= sb 8192)) 0
    (let [id (w-at st sb (+ 5 (* k 5)))]
      (if (= (slot-ok id) 0) 0
        (if (= (sv-at st sb 2028) id)
          (if (> (- (sv-at st sb 2029) (sv-at st sb 2027)) 3) 0 1)
          0)))))

(defn- note-title-press [st sb k]
  (if (not (= sb 8192)) 0
    (let [id (w-at st sb (+ 5 (* k 5)))]
      (if (= (slot-ok id) 0) 0
        (do (sv-put st sb 2027 (sv-at st sb 2029))
            (sv-put st sb 2028 id)
            0)))))

(defn- toggle-max [st st-len k]
  (let [b (+ 5 (* k 5))
        id (w-at st st-len b)
        s (max-saved id)]
    (do (sv-put st st-len 2028 0)
        (if (= (sv-at st st-len (+ s 2)) 0)
          (do (sv-put st st-len s (w-at st st-len (+ b 1)))
              (sv-put st st-len (+ s 1) (w-at st st-len (+ b 2)))
              (sv-put st st-len (+ s 2) (w-at st st-len (+ b 3)))
              (sv-put st st-len (+ s 3) (w-at st st-len (+ b 4)))
              (w-put st st-len (+ b 1) 0)
              (w-put st st-len (+ b 2) 28)
              (w-put st st-len (+ b 3) (w-at st st-len 3))
              (w-put st st-len (+ b 4) (- (w-at st st-len 4) 80)))
          (do (w-put st st-len (+ b 1) (sv-at st st-len s))
              (w-put st st-len (+ b 2) (sv-at st st-len (+ s 1)))
              (w-put st st-len (+ b 3) (sv-at st st-len (+ s 2)))
              (w-put st st-len (+ b 4) (sv-at st st-len (+ s 3)))
              (sv-put st st-len (+ s 2) 0)))
        (release-all st st-len)
        id)))

(defn- clear-rec [st st-len k]
  (let [b (+ 5 (* k 5))]
    (do (w-put st st-len b 0) (w-put st st-len (+ b 1) 0) (w-put st st-len (+ b 2) 0)
        (w-put st st-len (+ b 3) 0) (w-put st st-len (+ b 4) 0))))

;; browser.surface close-window: remove, and if it had the focus, focus the
;; window now on top.
(defn- close [st sb n k]
  (if (< (vis-count st sb n 0 0) 2) -8
    (let [id (w-at st sb (+ 5 (* k 5)))]
      (do (drop-scroll st sb id)
          (shift-down st sb k n)
          (clear-rec st sb (- n 1))
          (w-put st sb 1 (- n 1))
          (if (= (w-at st sb 2) id)
            (w-put st sb 2 (top-visible st sb (- n 2)))
            0)
          (release-all st sb)
          (w-at st sb 2)))))

(defn- app-bit [k] (if (= k 1) 1 (if (= k 2) 2 (if (= k 3) 4 8))))

;; The app whose launcher button is under (px, py), or 0. Button k (1..4):
;; x 6 + 102(k-1) .. + 96, y 2 .. 26, inclusive, only if app k is registered.
(defn- button-at [st st-len k px py]
  (if (> k 4) 0
    (let [x (+ 6 (* 102 (- k 1)))]
      (if (< px x) 0
        (if (> px (+ x 96))
          (button-at st st-len (+ k 1) px py)
          (if (= (bit-and (w-at st st-len 31) (app-bit k)) 0) 0 k))))))

(defn- on-launcher [st st-len px py]
  (if (< py 2) 0
    (if (> py 26) 0 (button-at st st-len 1 px py))))

;; browser.surface launch-app -> open-window with its default rect
;; [80 80 520 360], on top, focused. One window per app: an open one is raised.
(defn- launch [st st-len n app]
  (if (= (has-id st st-len n 0 app) 1)
    (do (release-all st st-len)
        (w-put st st-len 31 (- (w-at st st-len 31) (* (is-min st st-len app) (min-bit app))))
        (raise st st-len (index-of st st-len n 0 app) n))
    (if (> 600 (w-at st st-len 3)) -9
      (if (> 440 (w-at st st-len 4)) -9
        (let [tb (+ 5 (* n 5))]
          (do (w-put st st-len tb app)
              (w-put st st-len (+ tb 1) 80)
              (w-put st st-len (+ tb 2) 80)
              (w-put st st-len (+ tb 3) 520)
              (w-put st st-len (+ tb 4) 360)
              (w-put st st-len 1 (+ n 1))
              (w-put st st-len 2 app)
              (release-all st st-len)
              app))))))

;; ADR-0251: the maximize control of stack index k: x + w - 44 .. x + w - 28,
;; y + 6 .. y + 22, inclusive, on a window at least 160 wide (with a launcher).
(defn- in-max [st st-len k px py]
  (let [b (+ 5 (* k 5))
        r (+ (w-at st st-len (+ b 1)) (w-at st st-len (+ b 3)))
        y (w-at st st-len (+ b 2))]
    (if (< (w-at st st-len (+ b 3)) 160) 0
      (if (< px (- r 44)) 0
        (if (> px (- r 28)) 0
          (if (< py (+ y 6)) 0
            (if (> py (+ y 22)) 0 1)))))))

;; ADR-0254: the minimize control of stack index k: x + w - 64 .. x + w - 48, y + 6 ..
;; y + 22, inclusive, on a window at least 200 wide when another window is visible.
(defn- in-min [st st-len k px py]
  (let [b (+ 5 (* k 5))
        r (+ (w-at st st-len (+ b 1)) (w-at st st-len (+ b 3)))
        y (w-at st st-len (+ b 2))]
    (if (< (w-at st st-len (+ b 3)) 200) 0
      (if (< (vis-count st st-len (w-at st st-len 1) 0 0) 2) 0
        (if (< px (- r 64)) 0
          (if (> px (- r 48)) 0
            (if (< py (+ y 6)) 0
              (if (> py (+ y 22)) 0 1))))))))

;; Minimize the window raised to the top: its bit goes up, the focus to the topmost visible.
(defn- minimize [st st-len n]
  (let [id (w-at st st-len (+ 5 (* (- n 1) 5)))]
    (do (w-put st st-len 31 (+ (w-at st st-len 31) (min-bit id)))
        (release-all st st-len)
        (w-put st st-len 2 (top-visible st st-len (- n 1)))
        (w-at st st-len 2))))

;; The dock icon of a minimized app under (px, py), or 0: x (vw - 184) / 2 + 8 + 44 (k - 1) ..
;; + 36, y vh - 46 .. + 36, inclusive.
(defn- dock-at [st st-len k px py]
  (if (> k 4) 0
    (let [x (+ (quot (- (w-at st st-len 3) 184) 2) 8 (* 44 (- k 1)))
          y (- (w-at st st-len 4) 46)]
      (if (= (bit-and (w-at st st-len 31) (app-bit k)) 0) (dock-at st st-len (+ k 1) px py)
        (if (= (is-min st st-len k) 0) (dock-at st st-len (+ k 1) px py)
          (if (< px x) (dock-at st st-len (+ k 1) px py)
            (if (> px (+ x 36)) (dock-at st st-len (+ k 1) px py)
              (if (< py y) (dock-at st st-len (+ k 1) px py)
                (if (> py (+ y 36)) (dock-at st st-len (+ k 1) px py) k)))))))))

;; ADR-0255: the tray of minimized windows, bottom left: item i (0 first) is the i-th minimized
;; window by id, 120 x 24 at (6 + 126 i, vh - 30), inclusive. The id under (px, py) from id k on, or 0.
(defn- tray-at [st st-len k+i px py] (let [i (- k+i (* 8 (quot k+i 8))) k+i-q1 (quot k+i 8) k k+i-q1]
  (if (> k 4) 0
    (if (= (is-min st st-len k) 0) (tray-at st st-len (+ (* (+ k 1) 8) i) px py)
      (let [x (+ 6 (* 126 i))
            y (- (w-at st st-len 4) 30)]
        (if (< px x) (tray-at st st-len (+ (* (+ k 1) 8) (+ i 1)) px py)
          (if (> px (+ x 120)) (tray-at st st-len (+ (* (+ k 1) 8) (+ i 1)) px py)
            (if (< py y) (tray-at st st-len (+ (* (+ k 1) 8) (+ i 1)) px py)
              (if (> py (+ y 24)) (tray-at st st-len (+ (* (+ k 1) 8) (+ i 1)) px py) k)))))))))

(defn- restore [st st-len n id]
  (do (release-all st st-len)
      (w-put st st-len 31 (- (w-at st st-len 31) (min-bit id)))
      (raise st st-len (index-of st st-len n 0 id) n)))

(defn- title-press [st sb k px py]
  (if (not (= sb 8192)) 0
    (if (= (in-title st sb k px py) 0) 0
      (if (= (in-handle st sb k px py) 1) 0 1))))

(defn- max-press [st sb k px py]
  (if (not (= sb 8192)) 0 (in-max st sb k px py)))

(defn- press-miss [st st-len n px py]
  (if (= (w-at st st-len 31) 0) 0
    (let [app (on-launcher st st-len px py)]
      (if (= app 0) 0 (launch st st-len n app)))))

(defn- press [st sb k1 px py]
  (let [n (w-at st sb 1)]
    (if (> (dock-at st sb 1 px py) 0) (restore st sb n (dock-at st sb 1 px py))
    (if (> (tray-at st sb (+ (* 1 8) 0) px py) 0) (restore st sb n (tray-at st sb (+ (* 1 8) 0) px py))
    (if (= k1 0) (press-miss st sb n px py)
      (if (= (w-at st sb 31) 0)
        (do (capture st sb (- k1 1) px py)
            (raise st sb (- k1 1) n))
        (if (= (in-close st sb (- k1 1) px py) 1)
          (close st sb n (- k1 1))
          (if (= (in-min st sb (- k1 1) px py) 1)
            (do (raise st sb (- k1 1) n)
                (minimize st sb n))
          (if (= (max-press st sb (- k1 1) px py) 1)
            (do (raise st sb (- k1 1) n)
                (toggle-max st sb (- n 1)))
          (if (= (title-press st sb (- k1 1) px py) 1)
            (if (= (double-press st sb (- k1 1) px py) 1)
              (do (raise st sb (- k1 1) n)
                  (toggle-max st sb (- n 1)))
              (do (note-title-press st sb (- k1 1))
                  (capture st sb (- k1 1) px py)
                  (raise st sb (- k1 1) n)))
            (do (capture st sb (- k1 1) px py)
                (raise st sb (- k1 1) n))))))))))))

(defn- move-to [st st-len k nx ny]
  (let [b (+ 5 (* k 5))]
    (if (< nx 0) -6
      (if (< ny 0) -6
        (do (w-put st st-len (+ b 1) nx)
            (w-put st st-len (+ b 2) ny)
            (w-at st st-len b))))))

;; browser.input :resize: the size at the press plus the pointer's travel
;; from the press point, never below 120 x 80. Signed arithmetic: a travel
;; larger than the size clamps, it does not wrap.
(defn- at-least [v floor]
  (if (< v floor) floor v))

(defn- resize-to [st st-len k px py]
  (let [b (+ 5 (* k 5))]
    (do (w-put st st-len (+ b 3) (at-least (+ (w-at st st-len 29) (- px (w-at st st-len 27))) 120))
        (w-put st st-len (+ b 4) (at-least (+ (w-at st st-len 30) (- py (w-at st st-len 28))) 80))
        (w-at st st-len b))))

(defn- drag [st st-len n px py]
  (if (= (w-at st st-len 25) 0) 0
    (if (= (w-at st st-len 25) 2)
      (resize-to st st-len (index-of st st-len n 0 (w-at st st-len 26)) px py)
      (move-to st st-len (index-of st st-len n 0 (w-at st st-len 26))
               (- px (w-at st st-len 27)) (- py (w-at st st-len 28))))))

(defn- release [st st-len]
  (do (release-all st st-len) 0))

;; browser.surface focus-window by id (ADR-0237): the same raise as a press,
;; without touching the capture; an unknown id is a no-op.
(defn- focus-id [st st-len n id]
  (if (= (has-id st st-len n 0 id) 0) 0
    (raise st st-len (index-of st st-len n 0 id) n)))

(defn kotoba_aiueos_browser_reduce [st sb kind a b]
  (if (= st 0) -1
    (if (= (if (= sb 8192) (sv-at st sb 2030) 0) 1) 0
    (if (= (if (= sb 128) 1 (if (= sb 8192) 1 0)) 0) -1
      (let [abi (w-at st sb 0)
            n (w-at st sb 1)
            focus (w-at st sb 2)]
        (if (not (= abi 1)) -2
          (if (< n 1) -2
            (if (> n 4) -2
              (if (= (has-id st sb n 0 focus) 0) -3
                (if (= (capture-ok st sb n) 0) -4
                  (if (> (w-at st sb 31) 255) -7
                  (if (= kind 1) (press st sb (hit st sb (- n 1) a b) a b)
                    (if (= kind 2) focus
                      (if (= kind 3) (drag st sb n a b)
                        (if (= kind 4) (release st sb)
                          (if (= kind 5) (focus-id st sb n a)
                            (if (= kind 6) (wheel st sb (hit st sb (- n 1) a b) 1)
                              (if (= kind 7) (wheel st sb (hit st sb (- n 1) a b) 0) -5))))))))))))))))))
