;; JUN-600: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form and takes no test main; the predicate is unchanged.
(ns aiueos.service-lifecycle (:export [kotoba_aiueos_service_lifecycle]))

(defn kotoba_aiueos_service_lifecycle [generation restarts event budget]
  (if (= event 2)
    (if (= generation 0)
      (+ 1 4294967296)
      (if (and (> generation 0) (< generation 65535))
        (+ (+ generation (* restarts 65536)) 4294967296)
        0))
    (if (and (> generation 0)
             (< generation 65535)
             (= event 1)
             (< restarts budget))
      (+ (+ (+ generation 1) (* (+ restarts 1) 65536)) 8589934592)
      (if (and (> generation 0) (= event 3))
        (+ (+ generation (* restarts 65536)) 12884901888)
        (if (and (> generation 0) (= event 0))
          (+ generation (* restarts 65536))
          0)))))

