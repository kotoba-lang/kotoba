;; Guest WM decision: which of two overlapping surfaces is hit.
;;
;; WHY THIS IS A KOTOBA OBJECT AND NOT A C TABLE
;;
;; C already copies pixels onto one GOP/virtio-gpu scanout (mechanism).
;; WHICH of two overlapping rects is in front at a point is a compositor
;; decision. Hosted `window-session-state` already does that in the JVM
;; compositor (ADR-0085). That does not count as guest WM. The named
;; leftover after this object is linked is still `:native-compositor-absent`
;; (one guest scanout, virtio-input synthetic, no permission broker, P5).
;;
;; Rects match hosted `boot-desktop` / `overlap-point`:
;;   window 1 session: 32,32 720x540
;;   window 2 guest:   96,72 640x480
;;   overlap (100,80) is inside both. Front at boot is 2.
;;   (40,40) is inside 1 only — returning 2 here is leftover :always-front.
;;
;; Temporary native constraint: word types only, nested `if`, not a map
;; (ADR-2608650000: an unavailable backend is not a reason to remove a
;; specified safe language feature). Remove this header when native has
;; maps. Comparisons are spelled as nested `if` because `if` branches
;; must agree on a value type.
;;
;; ABI: [n front px py]. n is surface count. Returns window id or 0 refuse.
;; Vector:
;;   (1, 2, 100, 80) → 0   one-surface cannot prove stacking
;;   (2, 2, 100, 80) → 2   overlap prefers z-front, not key-order 1
;;   (2, 2,  40, 40) → 1   front misses; back contains
;;   (2, 1, 100, 80) → 1   raise 1 to front
;; Returning 1 at overlap is leftover :z-order-ignored.
;;
;; Not a second compositor west repo. Not hosted JVM WM.

(defn in-win1 [px py]
  (if (< px 32) 0
    (if (< 751 px) 0
      (if (< py 32) 0
        (if (< 571 py) 0 1)))))

(defn in-win2 [px py]
  (if (< px 96) 0
    (if (< 735 px) 0
      (if (< py 72) 0
        (if (< 551 py) 0 1)))))

(defn aiueos-wm-hit [n front px py]
  (if (< n 2) 0
    (if (= front 2)
      (if (= (in-win2 px py) 1) 2
        (if (= (in-win1 px py) 1) 1 0))
      (if (= front 1)
        (if (= (in-win1 px py) 1) 1
          (if (= (in-win2 px py) 1) 2 0))
        0))))

(defn main [] 0)
