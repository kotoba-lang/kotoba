;; JUN-600: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form and takes no test main; the predicate is unchanged.
(ns aiueos.pci-region-valid (:export [kotoba_aiueos_pci_region_valid]))

(defn kotoba_aiueos_pci_region_valid [offset bytes bar-length]
  (and (> bytes 0)
       (<= offset bar-length)
       (<= bytes (- bar-length offset))))

