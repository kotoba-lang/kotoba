;; Admission for the first frame aiueos ever receives from a peer.
;;
;; The virtio-net driver in `kernel/pci.c` owns the mechanism -- queue setup,
;; DMA pages, doorbells, polling the used ring. It does NOT decide whether the
;; bytes that came back are the reply it asked for. That decision lives here,
;; the same split every other admission path in this OS uses (ADR-0015).
;;
;; The frame is an Ethernet II header followed by an ARP packet, which is the
;; smallest exchange that proves a real peer answered: 14 bytes of Ethernet, 28
;; of ARP, and no IP stack anywhere. Every field the reply must have is checked,
;; not just the opcode -- a device model that echoed our own request back would
;; otherwise pass, and that is precisely the failure this gate exists to catch.
;;
;; Offsets, from the frame's first byte:
;;    0..5   destination MAC        14..15  ARP hardware type
;;    6..11  source MAC             16..17  ARP protocol type
;;   12..13  EtherType              18      hardware address length
;;                                  19      protocol address length
;;                                  20..21  ARP opcode
;;                                  22..27  sender MAC
;;                                  28..31  sender IPv4
;;
;; `expected-ip` is the peer's IPv4 as one big-endian i64, so the caller states
;; who it expects to hear from rather than accepting any reply that happens to
;; arrive on the wire.

(defn aiueos-net-u16 [frame offset]
  (+ (* (kernel-load-u8-4k frame 2048 offset) 256)
     (kernel-load-u8-4k frame 2048 (+ offset 1))))

(defn aiueos-net-u32 [frame offset]
  (+ (* (kernel-load-u8-4k frame 2048 offset) 16777216)
     (+ (* (kernel-load-u8-4k frame 2048 (+ offset 1)) 65536)
        (+ (* (kernel-load-u8-4k frame 2048 (+ offset 2)) 256)
           (kernel-load-u8-4k frame 2048 (+ offset 3))))))

(defn aiueos-net-arp-reply-valid [frame length expected-ip]
  (and (>= length 42)
       (<= length 2048)
       ;; EtherType 0x0806 = ARP.
       (= (aiueos-net-u16 frame 12) 2054)
       ;; Hardware type 1 = Ethernet, protocol type 0x0800 = IPv4.
       (= (aiueos-net-u16 frame 14) 1)
       (= (aiueos-net-u16 frame 16) 2048)
       (= (kernel-load-u8-4k frame 2048 18) 6)
       (= (kernel-load-u8-4k frame 2048 19) 4)
       ;; Opcode 2 = reply. A request (1) is what we SENT; admitting it would
       ;; let our own broadcast, looped back by the device model, count as an
       ;; answer.
       (= (aiueos-net-u16 frame 20) 2)
       ;; The reply has to come from the peer we asked about.
       (= (aiueos-net-u32 frame 28) expected-ip)))

(defn main [] 0)
