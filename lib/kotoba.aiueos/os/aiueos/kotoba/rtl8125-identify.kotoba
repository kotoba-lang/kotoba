(ns aiueos.rtl8125-identify
  (:require [aiueos.lib.rtl8125-regs :as reg])
  (:export [aiueos-rtl8125-identify main]))

;; RTL8125 device identity: what silicon is this, and what is its MAC address?
;;
;;   (aiueos-rtl8125-identify mmio-base mmio-length out out-length)
;;
;; This is the first half of `aiueos_rtl8125_takeover` (kernel/rtl8125.c:206-240)
;; -- everything the C does before it fills in `struct aiueos_rtl8125` and calls
;; `rings_restart`. Two MMIO reads and two decisions:
;;
;;   TXCFG  (0x40, u32)  -> `revision_from_txcfg` (:130-138)
;;   MAC0   (0x00, u32)  -\
;;   MAC4   (0x04, u16)  -/  -> `mac_valid` (:146-150)
;;
;; ZERO IS SUCCESS. The non-zero values are `enum aiueos_rtl8125_result`
;; unchanged, so a caller transcribed from the C keeps its meanings:
;;
;;   0  the device is supported and its MAC is usable; `out` has been written
;;   1  AIUEOS_RTL8125_INVALID -- the arguments are not a mapped BAR window and
;;      a 16-byte output region. NO MMIO ACCESS WAS PERFORMED.
;;   2  AIUEOS_RTL8125_UNSUPPORTED_REVISION
;;   3  AIUEOS_RTL8125_INVALID_MAC
;;
;; THE OUTPUT REGION, and why there is one.
;;
;; The C returns its answer by filling in a struct the caller owns. A Kotoba
;; object returns one i64, and a revision plus six MAC bytes is not one i64. So
;; the caller passes a 16-byte region and this writes:
;;
;;   out+0   u32   the revision code, 1..4
;;   out+4   u32   NOT WRITTEN
;;   out+8   u32   MAC0 as read, little-endian: mac[0..3]
;;   out+12  u16   MAC4 as read, little-endian: mac[4..5]
;;
;; so `out+8 .. out+13` is the six-byte MAC in the order it appears on the wire.
;; That is not a coincidence and it is not byte-swapping: the C builds its
;; `uint8_t mac[6]` as `{(uint8_t)mac0, (uint8_t)(mac0>>8), ...}` (:226-227),
;; which on this little-endian machine is exactly the bytes of the two words in
;; memory order. Storing the words and reading bytes back out of them is the
;; same operation with no shifting.
;;
;; Bytes 4..7 and 14..15 are left alone rather than zeroed, because a caller
;; that reads them is reading a field this object does not define, and zeroing
;; would make that read look like an answer.
;;
;; ORDERING. The C reads TXCFG first and returns UNSUPPORTED_REVISION before
;; looking at the MAC. That order is kept, and it is observable: a device with
;; an unrecognised revision produces reason 2 whether or not its MAC is valid.

;; `mac_valid` (kernel/rtl8125.c:146-150), over the two words rather than over
;; six bytes -- the three clauses transcribe exactly because each is a property
;; of the whole 48 bits:
;;
;;   any            OR of all six bytes is non-zero  <=>  mac0 or mac4 non-zero
;;   all_ff != 0xff AND of all six bytes is not 0xff <=>  not (mac0 = 0xffffffff
;;                                                        and mac4 = 0xffff)
;;   !(mac[0] & 1)  the multicast bit of the first byte, which is bit 0 of mac0
;;
;; The last clause is the one worth naming: a MAC with the group bit set is a
;; multicast address, and a NIC that filters on it as its own unicast address
;; accepts frames meant for a group. `all-ones` is refused separately because
;; ff:ff:ff:ff:ff:ff has the group bit set too but reads as "the ROM is absent"
;; rather than "the ROM holds a multicast address".
;;
;; Both arguments arrive from `kernel-load-u32`/`kernel-load-u16`, which
;; zero-extend, so neither can be negative and the comparisons are unsigned in
;; effect as well as in intent.
(defn mac-valid [mac0 mac4]
  (if (and (or (> mac0 0) (> mac4 0))
           (not (and (= mac0 4294967295) (= mac4 65535)))
           (= 0 (bit-and mac0 1)))
    1
    0))

(defn aiueos-rtl8125-identify [mmio-base mmio-length out out-length]
  (if (or (= 0 (reg/mmio-ok mmio-base mmio-length))
          (<= out 0)
          (not (= out-length 16)))
    1
    ;; RGE_TXCFG 0x40 = 64. Read before anything writes it; `rings_restart`
    ;; overwrites this register with RGE_TXCFG_CONFIG and the revision bits do
    ;; not survive, which is why the C captures the revision at takeover and
    ;; `aiueos_rtl8125_restart` reuses the captured value instead of re-reading.
    (let [revision (reg/revision-of (kernel-load-u32-4k mmio-base mmio-length 64))]
      (if (= revision 0)
        2
        ;; RGE_MAC0 0x00 = 0, RGE_MAC4 0x04 = 4.
        (let [mac0 (kernel-load-u32-4k mmio-base mmio-length 0)]
          (let [mac4 (kernel-load-u16-4k mmio-base mmio-length 4)]
            (if (= 0 (mac-valid mac0 mac4))
              3
              (let [a (kernel-store-u32 out out-length 0 revision)]
                (let [b (kernel-store-u32 out out-length 8 mac0)]
                  (let [c (kernel-store-u16 out out-length 12 mac4)]
                    0))))))))))

(defn main [] 0)
