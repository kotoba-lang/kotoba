;; The MADT walk of kernel/acpi.c's aiueos_acpi_initialize in Kotoba (JUN-552): the enabled processors' APIC ids (Local
;; APIC type 0 and x2APIC type 9, at most 256), the I/O APICs (type 1: non-zero, page-aligned, no two with the same GSI
;; base, at most 16), the legacy timer's interrupt source override (type 2, bus 0 source 0), the I/O APIC chosen for the
;; timer (the one whose GSI base is the highest at or below the timer GSI), and whether the machine is usable (at least
;; two enabled processors and that I/O APIC at 0xfec00000). acpi.c keeps the discovered_* globals and copies the record.
;;
;; madt_parse(madt, length, out, out-len): madt is the whole MADT (madt->sdt.length bytes; acpi.c has already checked its
;;   signature, checksum and the 44-byte header). Returns 1 when the table is well formed and the machine usable, else 0.
;;   out[0..1056), little-endian: [0..4) the processor count, [4..8) the enabled processors, [8..12) the timer GSI,
;;   [12..16) the chosen I/O APIC address, [16..20) its GSI base, [32..1056) the APIC ids. The record is what the C's
;;   globals held at the same point: a refused table still reports the processors and timer GSI walked so far (the C
;;   wrote them as it went), and the I/O APIC only once the walk is complete. out is written on every return past the
;;   argument checks.
;; A MADT longer than 16384 bytes is refused (16 KiB windows, amu ADR 0386). A null pointer, out-len below 1056, or a
;; length with a non-zero upper half is refused (0).
;;
;; The record is this object's .bss 0 and the I/O APIC list (address, base pairs) its .bss 1 (amu ADR 0385 / 0387). Like
;; the C's globals, not reentrant. Built by the Amu aiueos kernel object route at amu 65359a09, fuel 4194304.
(ns aiueos.acpi-madt-parse
  (:export [kotoba_aiueos_acpi_madt_parse]))
(defn- bss-addr-0-1056 [] :i64 0)
(defn- bss-addr-1-128 [] :i64 0)
(defn- canonical? [x :i64] :bool (= (u64-shift-right x 32) 0))
(defn- b [t :i64 n :i64 i :i64] :i64 (kernel-load-u8-16k t n i))
(defn- le32 [t :i64 n :i64 i :i64] :i64
  (+ (b t n i) (* 256 (b t n (+ i 1))) (* 65536 (b t n (+ i 2))) (* 16777216 (b t n (+ i 3)))))
(defn- rb [i :i64] :i64 (kernel-load-u8-16k (bss-addr-0-1056) 1056 i))
(defn- rs [i :i64 v :i64] :i64 (kernel-store-u8-16k (bss-addr-0-1056) 1056 i v))
(defn- r32 [at :i64] :i64 (+ (rb at) (* 256 (rb (+ at 1))) (* 65536 (rb (+ at 2))) (* 16777216 (rb (+ at 3)))))
(defn- w32 [at :i64 v :i64] :i64
  (+ (rs at (bit-and v 255)) (rs (+ at 1) (bit-and (u64-shift-right v 8) 255))
     (rs (+ at 2) (bit-and (u64-shift-right v 16) 255)) (rs (+ at 3) (bit-and (u64-shift-right v 24) 255))))
(defn- io-get [k :i64] :i64
  (let [at (* k 4)]
    (+ (kernel-load-u8 (bss-addr-1-128) 128 at) (* 256 (kernel-load-u8 (bss-addr-1-128) 128 (+ at 1)))
       (* 65536 (kernel-load-u8 (bss-addr-1-128) 128 (+ at 2))) (* 16777216 (kernel-load-u8 (bss-addr-1-128) 128 (+ at 3))))))
(defn- io-put [k :i64 v :i64] :i64
  (let [at (* k 4)]
    (+ (kernel-store-u8 (bss-addr-1-128) 128 at (bit-and v 255)) (kernel-store-u8 (bss-addr-1-128) 128 (+ at 1) (bit-and (u64-shift-right v 8) 255))
       (kernel-store-u8 (bss-addr-1-128) 128 (+ at 2) (bit-and (u64-shift-right v 16) 255))
       (kernel-store-u8 (bss-addr-1-128) 128 (+ at 3) (bit-and (u64-shift-right v 24) 255)))))
(defn- zero [i :i64] :i64 (if (>= i 1056) 0 (let [w (rs i 0)] (zero (+ (+ i 1) (* 0 w))))))
;; an enabled processor with this APIC id: appended while there are fewer than 256
(defn- add-cpu [id :i64] :i64
  (let [count (r32 0)]
    (if (>= count 256) 0
      (let [w (w32 (+ 32 (* 4 count)) id) c (w32 0 (+ count 1)) e (w32 4 (+ (r32 4) 1))] (+ w c e)))))
(defn- dup-base? [base :i64 k :i64 count :i64] :bool
  (if (>= k count) false (if (= (io-get (+ (* k 2) 1)) base) true (dup-base? base (+ k 1) count))))
;; the I/O APIC at cur; 0, or -1 for a refused entry. ioc is the count so far (the C's ioapic_count)
(defn- add-ioapic [t :i64 n :i64 cur :i64 ioc :i64] :i64
  (let [address (le32 t n (+ cur 4)) base (le32 t n (+ cur 8))]
    (if (or (= address 0) (not= (bit-and address 4095) 0) (dup-base? base 0 ioc)) -1
      (+ (io-put (* ioc 2) address) (io-put (+ (* ioc 2) 1) base)))))
;; one entry at cur of the given type and length; the I/O APIC count after it, or -1
(defn- entry [t :i64 n :i64 cur :i64 tl :i64 ioc :i64] :i64
  (let [type (u64-shift-right tl 8) len (bit-and tl 255)]
    (cond (= type 0) (if (< len 8) -1
                       (let [w (if (= (bit-and (le32 t n (+ cur 4)) 3) 0) 0 (add-cpu (b t n (+ cur 3))))] (+ ioc (* 0 w))))
          (= type 9) (if (< len 16) -1
                       (let [w (if (= (bit-and (le32 t n (+ cur 8)) 3) 0) 0 (add-cpu (le32 t n (+ cur 4))))] (+ ioc (* 0 w))))
          (= type 1) (if (or (< len 12) (>= ioc 16)) -1
                       (let [r (add-ioapic t n cur ioc)] (if (< r 0) -1 (+ ioc 1))))
          (= type 2) (if (< len 10) -1
                       (let [w (if (and (= (b t n (+ cur 2)) 0) (= (b t n (+ cur 3)) 0)) (w32 8 (le32 t n (+ cur 4))) 0)] (+ ioc (* 0 w))))
          :else ioc)))
;; the entries from cur; the I/O APIC count, or -1
(defn- walk [t :i64 n :i64 cur :i64 ioc :i64] :i64
  (if (>= cur n) ioc
    (if (< (- n cur) 2) -1
      (let [type (b t n cur) len (b t n (+ cur 1))]
        (if (or (< len 2) (< (- n cur) len)) -1
          (let [k (entry t n cur (+ (* type 256) len) ioc)] (if (< k 0) -1 (walk t n (+ cur len) k))))))))
;; the I/O APIC for the timer GSI: the highest base at or below it, the first of equal bases
(defn- select [k :i64 count :i64 timer :i64 chosen :i64] :i64
  (if (>= k count) chosen
    (let [base (io-get (+ (* k 2) 1)) better (and (<= base timer) (or (< chosen 0) (> base (io-get (+ (* chosen 2) 1)))))]
      (select (+ k 1) count timer (if better k chosen)))))
(defn- copy-out [o :i64 on :i64 i :i64] :i64
  (if (>= i 1056) 0 (let [v (rb i) w (kernel-store-u8-16k o on i v)] (copy-out o on (+ (+ i 1) (* 0 w))))))
(defn kotoba_aiueos_acpi_madt_parse [madt :i64 length :i64 out :i64 out-len :i64] :i64
  (if (or (= madt 0) (= out 0) (not (canonical? length)) (not (canonical? out-len)) (< out-len 1056) (> out-len 16384)
          (> length 16384) (< length 44)) 0
    (let [z (zero 0)
          ioc (walk madt length (+ 44 (* 0 z)) 0)
          chosen (if (< ioc 0) -1 (select 0 ioc (r32 8) -1))
          a (if (< chosen 0) 0 (+ (w32 12 (io-get (* chosen 2))) (w32 16 (io-get (+ (* chosen 2) 1)))))
          ok (if (and (>= ioc 0) (>= (r32 4) 2) (= (r32 12) 4273995776)) 1 0)
          w (copy-out out out-len (* 0 a))]
      (+ ok (* 0 w)))))
