;; The value of one four-byte DHCP option, for a frame `dhcp-reply-valid` has
;; already admitted.
;;
;; WHY THIS IS A SEPARATE OBJECT AND NOT A C HELPER
;;
;; Reading a field at a constant offset from an admitted frame is derivation,
;; and C does that already -- the peer's MAC out of an admitted ARP reply
;; (ADR-0021), the peer's sequence number out of an admitted segment
;; (ADR-0022). WHERE a DHCP option sits is not a constant offset. Finding it
;; means walking the same attacker-written chain of (code, length, value)
;; records that `dhcp-reply-valid` walks, with the same opportunity to step off
;; the end of the frame. So it is the same decision, asked a second time about a
;; different record, and it belongs on this side of the boundary.
;;
;; WHY IT RE-WALKS INSTEAD OF BEING TOLD WHERE TO LOOK
;;
;; The admission could have returned the offsets it found. It does not, and the
;; caller cannot pass them in: an offset that came from anywhere but a bounded
;; walk is an offset nothing has bounded. Re-deriving is cheap and it keeps this
;; object's safety independent of whether its caller checked anything.
;;
;; RETURNS
;;
;;   the four bytes as a big-endian integer, or 0 when the option is absent, is
;;   not exactly four bytes long, or the field does not parse within the frame.
;;
;; Zero is also a legal 32-bit value. That is not ambiguous HERE, because every
;; option this OS asks for -- subnet mask, router, lease time, server
;; identifier -- is meaningless as 0.0.0.0 or as a zero-second lease, and
;; `dhcp-reply-valid` has already refused a reply whose mask, lease or server
;; identifier is missing or unusable. PRESENCE IS THE ADMISSION'S DECISION, NOT
;; THIS OBJECT'S. A caller that asks this for an option the admission did not
;; require gets 0 for "absent" and 0 for "present and zero" and cannot tell
;; them apart.

(defn aiueos-dhcpopt-u16 [frame offset]
  (+ (* (kernel-load-u8-4k frame 2048 offset) 256)
     (kernel-load-u8-4k frame 2048 (+ offset 1))))

(defn aiueos-dhcpopt-u32 [frame offset]
  (+ (* (kernel-load-u8-4k frame 2048 offset) 16777216)
     (+ (* (kernel-load-u8-4k frame 2048 (+ offset 1)) 65536)
        (+ (* (kernel-load-u8-4k frame 2048 (+ offset 2)) 256)
           (kernel-load-u8-4k frame 2048 (+ offset 3))))))

;; The same walk as `dhcp-reply-valid.kotoba`'s, duplicated for the reason every
;; other pair of objects here duplicates arithmetic: a kernel object is compiled
;; with host imports disabled and exports exactly one symbol, so one cannot call
;; another. Every step proves the record's header AND its whole value lie below
;; `limit` before advancing past them.
(defn aiueos-dhcpopt-find [frame limit offset code]
  (if (>= offset limit) 0
    (if (= (kernel-load-u8-4k frame 2048 offset) 0)
      (aiueos-dhcpopt-find frame limit (+ offset 1) code)
      (if (= (kernel-load-u8-4k frame 2048 offset) 255) 0
        (if (> (+ offset 2) limit) 0
          (if (> (+ offset 2 (kernel-load-u8-4k frame 2048 (+ offset 1))) limit) 0
            (if (and (= (kernel-load-u8-4k frame 2048 offset) code)
                     (= (kernel-load-u8-4k frame 2048 (+ offset 1)) 4))
              (+ offset 2)
              (aiueos-dhcpopt-find frame limit
                                   (+ offset 2
                                      (kernel-load-u8-4k frame 2048 (+ offset 1)))
                                   code))))))))

;; The envelope is re-established from scratch, assuming nothing a caller might
;; have checked -- the same rule `tcp-segment-valid.kotoba` states. Without it
;; `limit` would come from a total-length field nothing had bounded, and a
;; bounded walk with an unbounded bound is not bounded.
(defn aiueos-dhcp-option-u32 [frame length code]
  (if (or (< length 283) (> length 2048)) 0
    (if (not (= (aiueos-dhcpopt-u16 frame 12) 2048)) 0
      (if (not (= (kernel-load-u8-4k frame 2048 14) 69)) 0
        (if (not (= (kernel-load-u8-4k frame 2048 23) 17)) 0
          (if (< (aiueos-dhcpopt-u16 frame 16) 268) 0
            (if (> (+ (aiueos-dhcpopt-u16 frame 16) 14) length) 0
              (if (not (= (aiueos-dhcpopt-u32 frame 278) 1669485411)) 0
                (if (= (aiueos-dhcpopt-find frame (+ 14 (aiueos-dhcpopt-u16 frame 16))
                                            282 code) 0) 0
                  (aiueos-dhcpopt-u32
                   frame
                   (aiueos-dhcpopt-find frame (+ 14 (aiueos-dhcpopt-u16 frame 16))
                                        282 code)))))))))))

(defn main [] 0)
