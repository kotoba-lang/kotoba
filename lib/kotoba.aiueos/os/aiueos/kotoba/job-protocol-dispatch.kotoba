;; The four AIUEOS wire lines of the murakumo job path -- request, result,
;; commit, liveness -- as ONE kernel object with a mode word, retiring the
;; decisions of `kernel/job_protocol.c` (ADR-0220). The decisions themselves
;; are `aiueos.job-protocol` (moved from native/ where ADR-0212 landed it
;; unwired); this file is the ABI: a kernel object exports one symbol, and
;; seven exports would be seven allowlist rows for one page of protocol.
;;
;;   mode 0  job-request-verdict  (payload length boot-hi boot-lo)  idn*256+plen | 0
;;   mode 1  job-request-prompt   (payload length out capacity)     bytes | 0
;;   mode 2  job-result-write     (out capacity in 0)               line length | 0
;;   mode 3  job-commit-valid     (payload length in 0)             1 | 0
;;   mode 4  node-ping-verdict    (payload length boot-hi boot-lo)  sequence | -1
;;   mode 5  node-pong-write      (out capacity in 0)               line length | 0
;;   mode 6  job-request-id       (payload length out capacity)     id length | 0
;;   other                                                          -2
;;
;; `in` is the 48-byte input record whose layout is the module's header
;; comment; the C packs it. Every region below is `(base length)` with the
;; length carried as the module already spells it (`in` is fixed 48).

(ns aiueos.job-protocol-dispatch
  (:require [aiueos.job-protocol :as jp])
  (:export [aiueos-job-protocol main]))

(defn aiueos-job-protocol [mode a b c d]
  (if (= mode 0) (jp/job-request-verdict a b c d)
    (if (= mode 1) (jp/job-request-prompt a b c d)
      (if (= mode 2) (jp/job-result-write a b c)
        (if (= mode 3) (jp/job-commit-valid a b c)
          (if (= mode 4) (jp/node-ping-verdict a b c d)
            (if (= mode 5) (jp/node-pong-write a b c)
              (if (= mode 6) (jp/job-request-id a b c d)
                -2))))))))

(defn main [] 0)
