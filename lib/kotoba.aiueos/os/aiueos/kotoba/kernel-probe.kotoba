;; JUN-708: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form first and takes no test main. The old source was the test main alone, `(defn main [] 42)`, which the
;; kotoba-compiler/1 route exported as kotoba_aiueos_probe; the probe still answers 42 (kernel/main.c checks it).
(ns aiueos.kernel-probe (:export [kotoba_aiueos_probe]))

(defn kotoba_aiueos_probe [] 42)
