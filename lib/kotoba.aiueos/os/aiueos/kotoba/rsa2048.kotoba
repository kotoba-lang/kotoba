;; JUN-708: built on amu's native object route: the namespace form comes first and exports the C name only, with no
;; test main and private helpers. Every region names its own length (the route refuses a literal-length window on a
;; base with no paired length, E7106): the export is (signature signature-length digest digest-length workspace
;; workspace-length unused), each helper takes the length right after each region it reaches, and the windows use those
;; lengths where they named 256, 32 and 1284. Helpers have at most five parameters on the route, so add-regions carries
;; (i, carry) as i*2 + carry and compare-encoding (difference, position) as difference*512 + position; subtract-modulus
;; binds its borrow flag before the store (the route refuses a branch inside a later argument). After the old
;; workspace-length check, the export narrows each region to its old size with kernel-subregion (256, 32 and 1284
;; bytes), so every window has the old length whatever the caller passes; a signature or digest region shorter than that
;; traps. The arithmetic and the order of every access are unchanged.
(ns aiueos.rsa2048 (:export [kotoba_aiueos_rsa2048_sha256_verify]))

;; Bounded RSA-2048 PKCS#1 v1.5 / SHA-256 admission verifier. All mutable
;; big integers are 64 little-endian u32 limbs in a caller-owned 1284-byte
;; workspace: state, base, temporary, accumulator, doubling power, and one
;; staged carry/borrow limb. Staging is explicit because compiler `let`
;; normalization substitutes expressions rather than retaining mutable values.

(defn- u32 [x] (bit-and x 4294967295))
(defn- unsigned-lt [a b]
  (let [ah (quot a 2147483648) bh (quot b 2147483648)]
    (if (< ah bh) 1
      (if (> ah bh) 0
        (if (< (bit-and a 2147483647) (bit-and b 2147483647)) 1 0)))))
(defn- unsigned-gt [a b]
  (let [ah (quot a 2147483648) bh (quot b 2147483648)]
    (if (> ah bh) 1
      (if (< ah bh) 0
        (if (> (bit-and a 2147483647) (bit-and b 2147483647)) 1 0)))))

(defn- load-word [workspace workspace-len region word]
  (let [offset (* (+ region word) 4)]
    (+ (kernel-load-u8-4k workspace workspace-len offset)
       (+ (* (kernel-load-u8-4k workspace workspace-len (+ offset 1)) 256)
          (+ (* (kernel-load-u8-4k workspace workspace-len (+ offset 2)) 65536)
             (* (kernel-load-u8-4k workspace workspace-len (+ offset 3)) 16777216))))))

(defn- store-word [workspace workspace-len region word value]
  (let [offset (* (+ region word) 4)
        s0 (kernel-store-u8-4k workspace workspace-len offset (bit-and value 255))
        s1 (kernel-store-u8-4k workspace workspace-len (+ offset 1) (bit-and (quot value 256) 255))
        s2 (kernel-store-u8-4k workspace workspace-len (+ offset 2) (bit-and (quot value 65536) 255))]
    (+ (kernel-store-u8-4k workspace workspace-len (+ offset 3)
                               (bit-and (quot value 16777216) 255))
       (* 0 (+ s0 (+ s1 s2))))))

(defn- modulus-word [i]
  (if (= i 0) 239122595 (if (= i 1) 209612937 (if (= i 2) 689232080 (if (= i 3) 416624412 (if (= i 4) 3120127575 (if (= i 5) 2302644090 (if (= i 6) 2401942764 (if (= i 7) 4261111541 (if (= i 8) 3790967962 (if (= i 9) 3888608132 (if (= i 10) 3760645040 (if (= i 11) 2949648395 (if (= i 12) 3047778929 (if (= i 13) 3132907967 (if (= i 14) 1602843412 (if (= i 15) 2083950002 (if (= i 16) 2717864299 (if (= i 17) 571997107 (if (= i 18) 1474260284 (if (= i 19) 3056536549 (if (= i 20) 1967562787 (if (= i 21) 1752364050 (if (= i 22) 746025033 (if (= i 23) 3402092110 (if (= i 24) 4076544317 (if (= i 25) 1512011561 (if (= i 26) 3432481930 (if (= i 27) 715665559 (if (= i 28) 337052630 (if (= i 29) 2856809583 (if (= i 30) 1609522923 (if (= i 31) 813903917 (if (= i 32) 1151884985 (if (= i 33) 2657459718 (if (= i 34) 4155134519 (if (= i 35) 3876850356 (if (= i 36) 2055305563 (if (= i 37) 1599617157 (if (= i 38) 2905614986 (if (= i 39) 1256958944 (if (= i 40) 1899745724 (if (= i 41) 1826860974 (if (= i 42) 1662494574 (if (= i 43) 4179209077 (if (= i 44) 3088519730 (if (= i 45) 2753555068 (if (= i 46) 3098210526 (if (= i 47) 1870042804 (if (= i 48) 3538857249 (if (= i 49) 2825521345 (if (= i 50) 292133305 (if (= i 51) 3339910129 (if (= i 52) 1584841433 (if (= i 53) 192833118 (if (= i 54) 2747573435 (if (= i 55) 3983052000 (if (= i 56) 4254572481 (if (= i 57) 854908057 (if (= i 58) 141405759 (if (= i 59) 496258011 (if (= i 60) 3906781861 (if (= i 61) 3919457879 (if (= i 62) 379235135 3032750945))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))

(defn- signature-word [signature signature-len word]
  (let [offset (- 252 (* word 4))]
    (+ (* (kernel-load-u8-4k signature signature-len offset) 16777216)
       (+ (* (kernel-load-u8-4k signature signature-len (+ offset 1)) 65536)
          (+ (* (kernel-load-u8-4k signature signature-len (+ offset 2)) 256)
             (kernel-load-u8-4k signature signature-len (+ offset 3)))))))

(defn- clear-region [workspace workspace-len region i]
  (if (= i 64) 1
    (let [stored (store-word workspace workspace-len region i 0)]
      (clear-region workspace workspace-len region (+ i 1 (* 0 stored))))))

(defn- copy-region [workspace workspace-len destination source i]
  (if (= i 64) 1
    (let [stored (store-word workspace workspace-len destination i (load-word workspace workspace-len source i))]
      (copy-region workspace workspace-len destination source (+ i 1 (* 0 stored))))))

(defn- load-signature [signature signature-len workspace workspace-len i]
  (if (= i 64) 1
    (let [stored (store-word workspace workspace-len 64 i (signature-word signature signature-len i))]
      (load-signature signature signature-len workspace workspace-len (+ i 1 (* 0 stored))))))

(defn- compare-modulus [workspace workspace-len region i]
  (if (= i -1) 0
    (let [value (load-word workspace workspace-len region i) modulus (modulus-word i)]
      (if (= (unsigned-gt value modulus) 1) 1
        (if (= (unsigned-lt value modulus) 1) -1
          (compare-modulus workspace workspace-len region (- i 1)))))))

(defn- subtract-modulus [workspace workspace-len region i borrow]
  (if (= i 64) borrow
    (let [before (load-word workspace workspace-len region i)
          sub-total (+ (modulus-word i) borrow)
          sub (u32 sub-total)
          flag (if (> sub-total 4294967295) 1
                 (unsigned-lt before sub))
          staged (store-word workspace workspace-len 320 0 flag)
          stored (store-word workspace workspace-len region i
                             (+ (u32 (- before sub)) (* 0 staged)))]
      (subtract-modulus workspace workspace-len region (+ i 1 (* 0 stored))
                        (load-word workspace workspace-len 320 0)))))

(defn- add-regions [workspace workspace-len target source i+carry] (let [i (quot i+carry 2) carry (- i+carry (* 2 (quot i+carry 2)))]
  (if (= i 64) carry
    (let [sum (+ (load-word workspace workspace-len target i)
                 (+ (load-word workspace workspace-len source i) carry))
          staged (store-word workspace workspace-len 320 0 (quot sum 4294967296))
          stored (store-word workspace workspace-len target i (+ (u32 sum) (* 0 staged)))]
      (add-regions workspace workspace-len target source (+ (* (+ i 1 (* 0 stored)) 2) (load-word workspace workspace-len 320 0)))))))

(defn- add-mod [workspace workspace-len target source]
  (let [carry (add-regions workspace workspace-len target source (+ (* 0 2) 0))]
    (if (> carry 0) (subtract-modulus workspace workspace-len target 0 0)
      (if (>= (compare-modulus workspace workspace-len target 63) 0)
        (subtract-modulus workspace workspace-len target 0 0)
        0))))

(defn- bit-divisor [within]
  (if (= within 0) 1 (* 2 (bit-divisor (- within 1)))))

(defn- source-bit [workspace workspace-len region bit]
  (let [word (quot bit 32) within (- bit (* word 32))]
    (bit-and (quot (load-word workspace workspace-len region word) (bit-divisor within)) 1)))

(defn- multiply-bits [workspace workspace-len output source bit]
  (if (= bit 2048)
    (copy-region workspace workspace-len output 192 0)
    (let [added (if (= (source-bit workspace workspace-len source bit) 1)
                  (add-mod workspace workspace-len 192 256) 0)
          doubled (add-mod workspace workspace-len 256 256)]
      (multiply-bits workspace workspace-len output source
                     (+ bit 1 (* 0 (+ added doubled)))))))

(defn- multiply-mod [workspace workspace-len output left right]
  (let [cleared (clear-region workspace workspace-len 192 0)
        powered (copy-region workspace workspace-len 256 left 0)]
    (multiply-bits workspace workspace-len output right (* 0 (+ cleared powered)))))

(defn- exponentiate [workspace workspace-len bit]
  (if (= bit -1) 1
    (let [squared (multiply-mod workspace workspace-len 128 0 0)
          square-copy (copy-region workspace workspace-len 0 128 (* 0 squared))
          multiplied (if (= bit 16)
                       (let [product (multiply-mod workspace workspace-len
                                                   (+ 128 (* 0 square-copy)) 0 64)]
                         (copy-region workspace workspace-len 0 128 (* 0 product)))
                       (if (= bit 0)
                         (let [product (multiply-mod workspace workspace-len
                                                     (+ 128 (* 0 square-copy)) 0 64)]
                           (copy-region workspace workspace-len 0 128 (* 0 product)))
                         (* 0 square-copy)))]
      (exponentiate workspace workspace-len
                    (- bit (+ 1 (* 0 multiplied)))))))

(defn- prefix-byte [i]
  (if (= i 0) 48 (if (= i 1) 49 (if (= i 2) 48 (if (= i 3) 13
  (if (= i 4) 6 (if (= i 5) 9 (if (= i 6) 96 (if (= i 7) 134
  (if (= i 8) 72 (if (= i 9) 1 (if (= i 10) 101 (if (= i 11) 3
  (if (= i 12) 4 (if (= i 13) 2 (if (= i 14) 1 (if (= i 15) 5
  (if (= i 16) 0 (if (= i 17) 4 32)))))))))))))))))))

(defn- encoded-byte [workspace workspace-len position]
  (let [reverse (- 255 position)
        word (quot reverse 4)
        within (- reverse (* word 4))
        divisor (if (= within 0) 1 (if (= within 1) 256
                  (if (= within 2) 65536 16777216)))]
    (bit-and (quot (load-word workspace workspace-len 0 word) divisor) 255)))

(defn- expected-byte [digest digest-len position]
  (if (= position 0) 0
    (if (= position 1) 1
      (if (< position 204) 255
        (if (= position 204) 0
          (if (< position 224) (prefix-byte (- position 205))
            (kernel-load-u8-4k digest digest-len (- position 224))))))))

(defn- compare-encoding [workspace workspace-len digest digest-len difference+position] (let [difference (quot difference+position 512) position (- difference+position (* 512 (quot difference+position 512)))]
  (if (= position 256) difference
    (compare-encoding workspace workspace-len digest digest-len
                      (+ (* (+ difference
                         (bit-xor (encoded-byte workspace workspace-len position)
                                  (expected-byte digest digest-len position))) 512) (+ position 1))))))

(defn kotoba_aiueos_rsa2048_sha256_verify
  [signature signature-length digest digest-length workspace workspace-length unused]
  (if (< workspace-length 1284) 0
    (let [sig (kernel-subregion signature signature-length 0 256) dg (kernel-subregion digest digest-length 0 32)
          ws (kernel-subregion workspace workspace-length 0 1284)]
    (let [loaded (load-signature sig 256 ws 1284 0)]
      (if (>= (compare-modulus ws 1284 64 (+ 63 (* 0 loaded))) 0) 0
        (let [state-clear (clear-region ws 1284 0 0)
              state-one (store-word ws 1284 0 0 (+ 1 (* 0 state-clear)))
              powered (exponentiate ws 1284 (+ 16 (* 0 state-one)))
              difference (compare-encoding ws 1284 dg 32 (+ (* 0 512) (* 0 powered)))]
          (if (= difference 0)
            1 0)))))))
