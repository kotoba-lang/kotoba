;; net_build_arp_request and net_build_icmp_echo of kernel/pci.c in Kotoba (JUN-552): the two 42-byte frames the
;; virtio-net probe sends first.
;;
;; arp(frame, n, macs, macs-len) and icmp(frame, n, macs, macs-len): n must be 42 and macs-len 12 -- macs is the peer's
;; MAC then ours -- else nothing is written and the answer is 0; otherwise frame[0..42) is written and the answer is 42.
;; arp: broadcast from us, EtherType 0x0806, Ethernet / IPv4 / 6 / 4, a request from our MAC and 10.0.2.15 for
;; 10.0.2.2 with the target MAC zero. icmp: to the peer from us, IPv4 version 4 IHL 5, total 28, identification 0, DF,
;; TTL 64, protocol 1, 10.0.2.15 to 10.0.2.2, an echo request with identifier 0xa1e0 and sequence 1, both checksums as
;; kotoba_aiueos_ipv4_checksum answers them. The C keeps the addresses' MACs (the ARP cache).
(ns aiueos.arp-icmp-build (:export [kotoba_aiueos_arp_request_build kotoba_aiueos_icmp_echo_build]))
(defn- b [f :i64 n :i64 i :i64] :i64 (kernel-load-u8 f n i))
(defn- put [f :i64 n :i64 i :i64 v :i64] :i64 (kernel-store-u8 f n i (bit-and v 255)))
(defn- put16 [f :i64 n :i64 i :i64 v :i64] :i64 (+ (put f n i (u64-shift-right v 8)) (put f n (+ i 1) v)))
(defn- put32 [f :i64 n :i64 i :i64 v :i64] :i64 (+ (put16 f n i (u64-shift-right v 16)) (put16 f n (+ i 2) (bit-and v 65535))))
;; frame[at..at+6) = macs[from..from+6)
(defn- mac [f :i64 n :i64 m :i64 mn :i64 at-from :i64] :i64
  (let [at (u64-shift-right at-from 8) from (bit-and at-from 255)
        w (+ (+ (+ (put f n at (b m mn from)) (put f n (+ at 1) (b m mn (+ from 1))))
                (+ (put f n (+ at 2) (b m mn (+ from 2))) (put f n (+ at 3) (b m mn (+ from 3)))))
             (+ (put f n (+ at 4) (b m mn (+ from 4))) (put f n (+ at 5) (b m mn (+ from 5)))))]
    w))
(defn- fill [f :i64 n :i64 at :i64 k :i64 v :i64] :i64
  (if (<= k 0) 0 (let [w (put f n at v)] (fill f n (+ at 1) (- k 1) (+ v (* 0 w))))))
(defn- sum16 [w :i64 wn :i64 off :i64 acc :i64] :i64
  (if (>= off wn) acc
    (let [hi (b w wn off) lo (if (>= (+ off 1) wn) 0 (b w wn (+ off 1)))]
      (sum16 w wn (+ off 2) (+ acc (+ (* 256 hi) lo))))))
(defn- fold [t :i64] :i64 (if (< t 65536) t (fold (+ (bit-and t 65535) (quot t 65536)))))
(defn- ok? [frame :i64 n :i64 macs :i64 mlen :i64] :bool (and (not= frame 0) (not= macs 0) (= n 42) (= mlen 12)))
(defn kotoba_aiueos_arp_request_build [frame :i64 n :i64 macs :i64 macs-len :i64] :i64
  (if (not (ok? frame n macs macs-len)) 0
    (let [w1 (fill frame n 0 6 255) w2 (mac frame n macs macs-len (+ (* 6 256) 6))
          w3 (+ (+ (put16 frame n 12 2054) (put16 frame n 14 1)) (+ (put16 frame n 16 2048) (+ (put frame n 18 6) (put frame n 19 4))))
          w4 (put16 frame n 20 1) w5 (mac frame n macs macs-len (+ (* 22 256) 6))
          w6 (put32 frame n 28 167772687) w7 (fill frame n 32 6 0) w8 (put32 frame n 38 167772674)]
      (+ 42 (* 0 (+ (+ (+ w1 w2) (+ w3 w4)) (+ (+ w5 w6) (+ w7 w8))))))))
(defn kotoba_aiueos_icmp_echo_build [frame :i64 n :i64 macs :i64 macs-len :i64] :i64
  (if (not (ok? frame n macs macs-len)) 0
    (let [w1 (mac frame n macs macs-len 0) w2 (mac frame n macs macs-len (+ (* 6 256) 6))
          w3 (+ (+ (put16 frame n 12 2048) (put frame n 14 69)) (+ (put frame n 15 0) (put16 frame n 16 28)))
          w4 (+ (+ (put16 frame n 18 0) (put16 frame n 20 16384)) (+ (put frame n 22 64) (put frame n 23 1)))
          w5 (+ (+ (put16 frame n 24 0) (put32 frame n 26 167772687)) (put32 frame n 30 167772674))
          h (kernel-subregion frame n 14 20) w6 (put16 frame n 24 (- 65535 (fold (sum16 h 20 0 0))))
          w7 (+ (+ (put frame n 34 8) (put frame n 35 0)) (+ (put16 frame n 36 0) (+ (put16 frame n 38 41440) (put16 frame n 40 1))))
          c (kernel-subregion frame n 34 8) w8 (put16 frame n 36 (- 65535 (fold (sum16 c 8 0 0))))]
      (+ 42 (* 0 (+ (+ (+ w1 w2) (+ w3 w4)) (+ (+ w5 w6) (+ w7 w8))))))))
