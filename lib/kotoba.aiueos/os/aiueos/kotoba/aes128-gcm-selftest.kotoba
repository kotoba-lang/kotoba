;; The boot-time known-answer test of the AES-128-GCM object: SP 800-38D's
;; empty-message tag, the 64-byte message's ciphertext and tag, the
;; round trip, a flipped tag bit REFUSED with the ciphertext left in place
;; (authenticate-before-decrypt is a property of the object and this is the
;; boot-time assertion of it), and the 20-byte-AAD tag.
;;
;; Retires the decision half of `kernel/tls_aes_gcm.c` (ADR-0220): the
;; vectors and the comparisons were C; what stays there is the two
;; marshalling wrappers `tls13.c` and `pci.c` call (copy in, pack the context,
;; invert the reason code once). This object runs the SAME core module
;; (`aiueos.lib.aes128-gcm-core`) the linked `aes128-gcm` object is built
;; from, over a caller-owned 1,536-byte scratch region:
;;
;;   scratch   0..1280   the GCM context, laid out as aes128-gcm.kotoba documents
;;          1280..1344   the 64-byte message / ciphertext
;;
;; RETURNS 0 when every step agrees, else the number of the step that did not:
;;   1  empty message, zero key and nonce: tag != 58e2fcce...455a
;;   2  64-byte message: ciphertext or tag != the recorded vectors
;;   3  open with the right tag did not give the message back
;;   4  open with a flipped tag bit was NOT refused, or touched the buffer
;;   5  20 bytes of AAD: tag != 2b956e81...21ee
;;   6  scratch region shorter than 1,536 bytes
;; The expected bytes are hex literals below, as the C held them.

(ns aiueos.aes128-gcm-selftest
  (:require [aiueos.lib.aes128-gcm-core :as gcm])
  (:export [aiueos-aes128-gcm-selftest main]))

(defn hex-digit [c]
  (if (and (>= c 48) (<= c 57)) (- c 48) (+ (- c 97) 10)))

(defn hex-byte [kind i]
  ;; byte i of literal `kind`
  (let [s (* i 2)]
    (+ (* 16 (hex-digit (lit-char kind s))) (hex-digit (lit-char kind (+ s 1))))))

(defn lit-char [kind i]
  (if (= kind 0) (string-code-point-at "58e2fccefa7e3061367f1d57a4e7455a" i)
    (if (= kind 1) (string-code-point-at "feffe9928665731c6d6a8d0340314de8" i)
      (if (= kind 2) (string-code-point-at "cafebabefacedbaddecaf888" i)
        (if (= kind 3) (string-code-point-at "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255" i)
          (if (= kind 4) (string-code-point-at "4faa3ccbf07a91cfddce27c8578abaa1ed73bed1c3d08eb8b08021ff5d3549d4a282d3a85835e52d2da9e496273474dcccdbc9a28661dd66b87c441bd9ebbde7" i)
            (if (= kind 5) (string-code-point-at "97f7b29118c8fb5494359b191d97003e" i)
              (if (= kind 6) (string-code-point-at "feedfacedeadbeeffeedfacedeadbeefabaddad2" i)
                (string-code-point-at "2b956e81820664242d50872ba9f521ee" i)))))))))

(defn fill [ctx at kind i n]
  ;; ctx[at+i..at+n) <- literal `kind`. Tail-recursive: the store's value is
  ;; folded into the next index with `(* 0 ...)` so the store stays in the
  ;; dependency graph without a frame per byte.
  (if (>= i n)
    0
    (let [stored (gcm/cs ctx (+ at i) (hex-byte kind i))]
      (fill ctx at kind (+ (+ i 1) (* 0 stored)) n))))

(defn fill-data [data at kind i n]
  (if (>= i n)
    0
    (let [stored (kernel-store-u8 data 64 (+ at i) (hex-byte kind i))]
      (fill-data data at kind (+ (+ i 1) (* 0 stored)) n))))

(defn zero-ctx [ctx i]
  (if (>= i 1280)
    0
    (let [stored (gcm/cs ctx i 0)]
      (zero-ctx ctx (+ (+ i 1) (* 0 stored))))))

(defn ctx-differs-from [ctx at kind i acc]
  ;; or-accumulated difference between ctx[at..at+16) and literal `kind`
  ;; (every ctx comparison here is a 16-byte tag)
  (if (>= i 16)
    acc
    (ctx-differs-from ctx at kind (+ i 1)
                      (bit-or acc (bit-xor (gcm/cl ctx (+ at i)) (hex-byte kind i))))))

(defn ctx-differs [ctx at kind] (ctx-differs-from ctx at kind 0 0))

(defn data-differs [data kind i n acc]
  (if (>= i n)
    acc
    (data-differs data kind (+ i 1) n
                  (bit-or acc (bit-xor (kernel-load-u8 data 64 i) (hex-byte kind i))))))

(defn setup [ctx key-kind nonce-kind aad-kind aad-len]
  ;; zero the context, then key, nonce, aad length and aad
  (let [z (zero-ctx ctx 0)
        k (if (< key-kind 0) 0 (fill ctx 0 key-kind 0 16))
        n (if (< nonce-kind 0) 0 (fill ctx 16 nonce-kind 0 12))
        a (gcm/cs ctx 28 aad-len)
        d (if (= aad-len 0) 0 (fill ctx 64 aad-kind 0 aad-len))]
    (+ z k n a d)))

(defn seal [ctx data data-len]
  (let [p (gcm/gcm-prepare ctx 16)]
    (+ (gcm/gcm-seal ctx data data-len (gcm/cl ctx 28)) (* 0 p))))

(defn open [ctx data data-len]
  (let [p (gcm/gcm-prepare ctx 16)]
    (+ (gcm/gcm-open ctx data data-len (gcm/cl ctx 28)) (* 0 p))))

(defn step-5 [ctx data]
  ;; 20 bytes of AAD change the tag only
  (let [s (setup ctx 1 2 6 20)
        f (fill-data data 0 3 0 64)
        r (seal ctx data 64)]
    (if (or (not (= r 0)) (not (= (ctx-differs ctx 32 7) 0)))
      5
      (+ 0 (* 0 (+ s f))))))

(defn step-4 [ctx data]
  ;; re-seal to get the ciphertext, flip the last tag bit, open must refuse
  ;; with reason 5 and leave the ciphertext untouched
  (let [s (setup ctx 1 2 -1 0)
        f (fill-data data 0 3 0 64)
        r (seal ctx data 64)
        flip (gcm/cs ctx 47 (bit-xor (gcm/cl ctx 47) 1))
        o (open ctx data 64)]
    (if (or (not (= r 0)) (not (= o 5)) (not (= (data-differs data 4 0 64 0) 0)))
      4
      (+ (step-5 ctx data) (* 0 (+ s f flip))))))

(defn step-3 [ctx data]
  ;; open the ciphertext with the right tag: the message comes back
  (let [s (setup ctx 1 2 -1 0)
        f (fill-data data 0 4 0 64)
        t (fill ctx 32 5 0 16)
        o (open ctx data 64)]
    (if (or (not (= o 0)) (not (= (data-differs data 3 0 64 0) 0)))
      3
      (+ (step-4 ctx data) (* 0 (+ s f t))))))

(defn step-2 [ctx data]
  ;; the 64-byte message under the recorded key and nonce
  (let [s (setup ctx 1 2 -1 0)
        f (fill-data data 0 3 0 64)
        r (seal ctx data 64)]
    (if (or (not (= r 0))
            (not (= (data-differs data 4 0 64 0) 0))
            (not (= (ctx-differs ctx 32 5) 0)))
      2
      (+ (step-3 ctx data) (* 0 (+ s f))))))

(defn step-1 [ctx data]
  ;; empty message, zero key, zero nonce
  (let [s (setup ctx -1 -1 -1 0)
        r (seal ctx data 0)]
    (if (or (not (= r 0)) (not (= (ctx-differs ctx 32 0) 0)))
      1
      (+ (step-2 ctx data) (* 0 s)))))

(defn aiueos-aes128-gcm-selftest [scratch length]
  (if (< length 1536)
    6
    (step-1 (kernel-subregion scratch length 0 1280)
            (kernel-subregion scratch length 1280 64))))

(defn main [] 0)
