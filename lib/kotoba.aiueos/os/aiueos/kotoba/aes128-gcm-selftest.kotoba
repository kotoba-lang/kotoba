;; JUN-708: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form first, takes no test main and exports nothing else; the logic is unchanged.
(ns aiueos.aes128-gcm-selftest (:export [kotoba_aiueos_aes128_gcm_selftest]))

;; The boot-time known-answer test of the AES-128-GCM object: SP 800-38D's
;; empty-message tag, the 64-byte message's ciphertext and tag, the
;; round trip, a flipped tag bit REFUSED with the ciphertext left in place
;; (authenticate-before-decrypt is a property of the object and this is the
;; boot-time assertion of it), and the 20-byte-AAD tag.
;;
;; Retires the decision half of `kernel/tls_aes_gcm.c` (ADR-0220): the
;; vectors and the comparisons were C; what stays there is the two
;; marshalling wrappers `tls13.c` and `pci.c` call (copy in, pack the context,
;; invert the reason code once). This object runs the SAME core module
;; (`aiueos.lib.aes128-gcm-core`) the linked `aes128-gcm` object is built
;; from, over a caller-owned 1,536-byte scratch region:
;;
;;   scratch   0..1280   the GCM context, laid out as aes128-gcm.kotoba documents
;;          1280..1344   the 64-byte message / ciphertext
;;
;; RETURNS 0 when every step agrees, else the number of the step that did not:
;;   1  empty message, zero key and nonce: tag != 58e2fcce...455a
;;   2  64-byte message: ciphertext or tag != the recorded vectors
;;   3  open with the right tag did not give the message back
;;   4  open with a flipped tag bit was NOT refused, or touched the buffer
;;   5  20 bytes of AAD: tag != 2b956e81...21ee
;;   6  scratch region shorter than 1,536 bytes
;; The expected bytes are hex literals below, as the C held them.



;; Inlined from aiueos/lib/aes128_gcm_core.kotoba (the native route has no :require): cl, cs, xtime, rotl8-1, rotl8-2, rotl8-3, rotl8-4, build-log-tables, build-tables, inv-of, sbox-value, build-sbox, sbox, rcon, key-expand-copy, key-expand-word, key-expand-loop, key-expand, aes-load-state, aes-sub-to-t, shift-src, aes-shift-rows, aes-mix-col, aes-mix, aes-add-round-key, aes-round, aes-rounds, aes-final, aes-encrypt-block, gh-zero-z, gh-copy-h-to-v, gh-xor-v-into-z, gh-shift-v, gh-bit, gh-byte-bits, gh-mult-bytes, gh-copy-z-to-y, gh-mult, gh-xor-aad-block, gh-aad, gh-xor-data-block, gh-data, be64-tail, be64-into, gh-xor-lenblk, gh-final, set-j0, copy-j0-to-ctr, inc32, crypt-block, crypt-all, tag-out, tag-diff, zero-region, gcm-seal, gcm-open, gcm-prepare.
(defn- cl [ctx ctx-len i] (kernel-load-u8-4k ctx ctx-len i))


(defn- cs [ctx ctx-len i v] (kernel-store-u8-4k ctx ctx-len i v))

(defn- xtime [x]
  (bit-and (bit-xor (* x 2)
                    (* (bit-and (quot x 128) 1) 27))
           255))

(defn- rotl8-1 [x] (bit-and (bit-or (* x 2) (quot x 128)) 255))


(defn- rotl8-2 [x] (bit-and (bit-or (* x 4) (quot x 64)) 255))


(defn- rotl8-3 [x] (bit-and (bit-or (* x 8) (quot x 32)) 255))


(defn- rotl8-4 [x] (bit-and (bit-or (* x 16) (quot x 16)) 255))

;; alog[i] = 3^i and log[3^i] = i, for i in 0..254.  The generator 3 is
;; `p ^ xtime(p)`, i.e. p*2 + p in GF(2^8).
(defn- build-log-tables [ctx ctx-len i p]
  (if (= i 255) 1
    (let [a (cs ctx ctx-len (+ 512 i) p)
          l (cs ctx ctx-len (+ 768 p) i)]
      (build-log-tables ctx ctx-len (+ i 1 (* 0 (+ a l))) (bit-xor p (xtime p))))))

;; alog[255] = alog[0] = 1, so that x = 1 (whose log is 0) reaches a written
;; slot through `alog[255 - log[x]]` rather than reading uninitialised memory.
(defn- build-tables [ctx ctx-len]
  (let [b (build-log-tables ctx ctx-len 0 1)
        e (cs ctx ctx-len 767 1)]
    (+ 1 (* 0 (+ b e)))))

(defn- inv-of [ctx ctx-len x]
  (if (= x 0) 0
    (cl ctx ctx-len (+ 512 (- 255 (cl ctx ctx-len (+ 768 x)))))))

;; FIPS 197 5.1.1: b ^ rotl(b,1) ^ rotl(b,2) ^ rotl(b,3) ^ rotl(b,4) ^ 0x63.
(defn- sbox-value [ctx ctx-len x]
  (let [b (inv-of ctx ctx-len x)]
    (bit-and (bit-xor (bit-xor (bit-xor b (rotl8-1 b))
                               (bit-xor (rotl8-2 b) (rotl8-3 b)))
                      (bit-xor (rotl8-4 b) 99))
             255)))

(defn- build-sbox [ctx ctx-len i]
  (if (= i 256) 1
    (let [s (cs ctx ctx-len (+ 1024 i) (sbox-value ctx ctx-len i))]
      (build-sbox ctx ctx-len (+ i 1 (* 0 s))))))

(defn- sbox [ctx ctx-len x] (cl ctx ctx-len (+ 1024 x)))

(defn- rcon [i]
  (if (= i 1) 1 (if (= i 2) 2 (if (= i 3) 4 (if (= i 4) 8
  (if (= i 5) 16 (if (= i 6) 32 (if (= i 7) 64 (if (= i 8) 128
  (if (= i 9) 27 54))))))))))

(defn- key-expand-copy [ctx ctx-len i]
  (if (= i 16) 1
    (let [s (cs ctx ctx-len (+ 128 i) (cl ctx ctx-len i))]
      (key-expand-copy ctx ctx-len (+ i 1 (* 0 s))))))

(defn- key-expand-word [ctx ctx-len i]
  (let [t0 (cl ctx ctx-len (+ 128 (- i 4)))
        t1 (cl ctx ctx-len (+ 128 (- i 3)))
        t2 (cl ctx ctx-len (+ 128 (- i 2)))
        t3 (cl ctx ctx-len (+ 128 (- i 1)))
        turn (= (bit-and i 15) 0)
        u0 (if turn (bit-xor (sbox ctx ctx-len t1) (rcon (quot i 16))) t0)
        u1 (if turn (sbox ctx ctx-len t2) t1)
        u2 (if turn (sbox ctx ctx-len t3) t2)
        u3 (if turn (sbox ctx ctx-len t0) t3)
        s0 (cs ctx ctx-len (+ 128 i) (bit-xor (cl ctx ctx-len (+ 128 (- i 16))) u0))
        s1 (cs ctx ctx-len (+ 128 (+ i 1)) (bit-xor (cl ctx ctx-len (+ 128 (- i 15))) u1))
        s2 (cs ctx ctx-len (+ 128 (+ i 2)) (bit-xor (cl ctx ctx-len (+ 128 (- i 14))) u2))
        s3 (cs ctx ctx-len (+ 128 (+ i 3)) (bit-xor (cl ctx ctx-len (+ 128 (- i 13))) u3))]
    (+ 1 (* 0 (+ s0 (+ s1 (+ s2 s3)))))))

(defn- key-expand-loop [ctx ctx-len i]
  (if (= i 176) 1
    (let [w (key-expand-word ctx ctx-len i)]
      (key-expand-loop ctx ctx-len (+ i 4 (* 0 w))))))

(defn- key-expand [ctx ctx-len]
  (let [c (key-expand-copy ctx ctx-len 0)
        e (key-expand-loop ctx ctx-len 16)]
    (+ 1 (* 0 (+ c e)))))

(defn- aes-load-state [ctx ctx-len in-off i]
  (if (= i 16) 1
    (let [s (cs ctx ctx-len (+ 432 i) (bit-xor (cl ctx ctx-len (+ in-off i)) (cl ctx ctx-len (+ 128 i))))]
      (aes-load-state ctx ctx-len in-off (+ i 1 (* 0 s))))))

(defn- aes-sub-to-t [ctx ctx-len i]
  (if (= i 16) 1
    (let [s (cs ctx ctx-len (+ 416 i) (sbox ctx ctx-len (cl ctx ctx-len (+ 432 i))))]
      (aes-sub-to-t ctx ctx-len (+ i 1 (* 0 s))))))

;; ShiftRows as a permutation of the SubBytes output, column-major, exactly the
;; sixteen assignments the C wrote out by hand.
(defn- shift-src [i]
  (if (= i 0) 0 (if (= i 1) 5 (if (= i 2) 10 (if (= i 3) 15
  (if (= i 4) 4 (if (= i 5) 9 (if (= i 6) 14 (if (= i 7) 3
  (if (= i 8) 8 (if (= i 9) 13 (if (= i 10) 2 (if (= i 11) 7
  (if (= i 12) 12 (if (= i 13) 1 (if (= i 14) 6 11))))))))))))))))

(defn- aes-shift-rows [ctx ctx-len i]
  (if (= i 16) 1
    (let [s (cs ctx ctx-len (+ 432 i) (cl ctx ctx-len (+ 416 (shift-src i))))]
      (aes-shift-rows ctx ctx-len (+ i 1 (* 0 s))))))

(defn- aes-mix-col [ctx ctx-len i]
  (let [a (cl ctx ctx-len (+ 432 i))
        b (cl ctx ctx-len (+ 432 (+ i 1)))
        c (cl ctx ctx-len (+ 432 (+ i 2)))
        d (cl ctx ctx-len (+ 432 (+ i 3)))
        s0 (cs ctx ctx-len (+ 432 i)
               (bit-and (bit-xor (bit-xor (xtime a) (xtime b))
                                 (bit-xor b (bit-xor c d))) 255))
        s1 (cs ctx ctx-len (+ 432 (+ i 1))
               (bit-and (bit-xor (bit-xor a (xtime b))
                                 (bit-xor (xtime c) (bit-xor c d))) 255))
        s2 (cs ctx ctx-len (+ 432 (+ i 2))
               (bit-and (bit-xor (bit-xor a b)
                                 (bit-xor (xtime c) (bit-xor (xtime d) d))) 255))
        s3 (cs ctx ctx-len (+ 432 (+ i 3))
               (bit-and (bit-xor (bit-xor (xtime a) a)
                                 (bit-xor b (bit-xor c (xtime d)))) 255))]
    (+ 1 (* 0 (+ s0 (+ s1 (+ s2 s3)))))))

(defn- aes-mix [ctx ctx-len i]
  (if (= i 16) 1
    (let [m (aes-mix-col ctx ctx-len i)]
      (aes-mix ctx ctx-len (+ i 4 (* 0 m))))))

(defn- aes-add-round-key [ctx ctx-len round i]
  (if (= i 16) 1
    (let [s (cs ctx ctx-len (+ 432 i)
                (bit-xor (cl ctx ctx-len (+ 432 i))
                         (cl ctx ctx-len (+ 128 (+ (* round 16) i)))))]
      (aes-add-round-key ctx ctx-len round (+ i 1 (* 0 s))))))

(defn- aes-round [ctx ctx-len round]
  (let [a (aes-sub-to-t ctx ctx-len 0)
        b (aes-shift-rows ctx ctx-len 0)
        c (aes-mix ctx ctx-len 0)
        d (aes-add-round-key ctx ctx-len round 0)]
    (+ 1 (* 0 (+ a (+ b (+ c d)))))))

(defn- aes-rounds [ctx ctx-len round]
  (if (= round 10) 1
    (let [r (aes-round ctx ctx-len round)]
      (aes-rounds ctx ctx-len (+ round 1 (* 0 r))))))

(defn- aes-final [ctx ctx-len out-off i]
  (if (= i 16) 1
    (let [s (cs ctx ctx-len (+ out-off i)
                (bit-xor (cl ctx ctx-len (+ 432 i)) (cl ctx ctx-len (+ 128 (+ 160 i)))))]
      (aes-final ctx ctx-len out-off (+ i 1 (* 0 s))))))

;; `in-off` and `out-off` may be the same offset: the state lives at 432, so an
;; in-place block (H = E_K(0)) is exact rather than a special case.
(defn- aes-encrypt-block [ctx ctx-len in-off out-off]
  (let [a (aes-load-state ctx ctx-len in-off 0)
        b (aes-rounds ctx ctx-len 1)
        c (aes-sub-to-t ctx ctx-len 0)
        d (aes-shift-rows ctx ctx-len 0)
        e (aes-final ctx ctx-len out-off 0)]
    (+ 1 (* 0 (+ a (+ b (+ c (+ d e))))))))

(defn- gh-zero-z [ctx ctx-len i]
  (if (= i 16) 1
    (let [s (cs ctx ctx-len (+ 384 i) 0)] (gh-zero-z ctx ctx-len (+ i 1 (* 0 s))))))

(defn- gh-copy-h-to-v [ctx ctx-len i]
  (if (= i 16) 1
    (let [s (cs ctx ctx-len (+ 400 i) (cl ctx ctx-len (+ 304 i)))]
      (gh-copy-h-to-v ctx ctx-len (+ i 1 (* 0 s))))))

(defn- gh-xor-v-into-z [ctx ctx-len i]
  (if (= i 16) 1
    (let [s (cs ctx ctx-len (+ 384 i) (bit-xor (cl ctx ctx-len (+ 384 i)) (cl ctx ctx-len (+ 400 i))))]
      (gh-xor-v-into-z ctx ctx-len (+ i 1 (* 0 s))))))

;; V >>= 1 across all 128 bits, most significant byte first.
(defn- gh-shift-v [ctx ctx-len k]
  (if (= k 0)
    (cs ctx ctx-len 400 (quot (cl ctx ctx-len 400) 2))
    (let [s (cs ctx ctx-len (+ 400 k)
                (bit-and (bit-or (quot (cl ctx ctx-len (+ 400 k)) 2)
                                 (* (bit-and (cl ctx ctx-len (+ 400 (- k 1))) 1) 128))
                         255))]
      (gh-shift-v ctx ctx-len (- k 1 (* 0 s))))))

(defn- gh-bit [ctx ctx-len bit]
  (let [lsb (bit-and (cl ctx ctx-len 415) 1)
        x (if (= bit 1) (gh-xor-v-into-z ctx ctx-len 0) 0)
        s (gh-shift-v ctx ctx-len 15)
        r (if (= lsb 1) (cs ctx ctx-len 400 (bit-xor (cl ctx ctx-len 400) 225)) 0)]
    (+ 1 (* 0 (+ x (+ s r))))))

;; The bit index is walked by shifting the byte left, not by a shift whose
;; count depends on the loop counter: this subset admits only literal shift
;; counts, so `(x >> (7 - j))` has no spelling here.
(defn- gh-byte-bits [ctx ctx-len b j]
  (if (= j 8) 1
    (let [r (gh-bit ctx ctx-len (bit-and (quot b 128) 1))]
      (gh-byte-bits ctx ctx-len (bit-and (* b 2) 255) (+ j 1 (* 0 r))))))

(defn- gh-mult-bytes [ctx ctx-len i]
  (if (= i 16) 1
    (let [r (gh-byte-bits ctx ctx-len (cl ctx ctx-len (+ 352 i)) 0)]
      (gh-mult-bytes ctx ctx-len (+ i 1 (* 0 r))))))

(defn- gh-copy-z-to-y [ctx ctx-len i]
  (if (= i 16) 1
    (let [s (cs ctx ctx-len (+ 352 i) (cl ctx ctx-len (+ 384 i)))]
      (gh-copy-z-to-y ctx ctx-len (+ i 1 (* 0 s))))))

(defn- gh-mult [ctx ctx-len]
  (let [a (gh-zero-z ctx ctx-len 0)
        b (gh-copy-h-to-v ctx ctx-len 0)
        c (gh-mult-bytes ctx ctx-len 0)
        d (gh-copy-z-to-y ctx ctx-len 0)]
    (+ 1 (* 0 (+ a (+ b (+ c d)))))))

(defn- gh-xor-aad-block [ctx ctx-len off i limit]
  (if (= i 16) 1
    (let [byte (if (< i limit) (cl ctx ctx-len (+ 64 (+ off i))) 0)
          s (cs ctx ctx-len (+ 352 i) (bit-xor (cl ctx ctx-len (+ 352 i)) byte))]
      (gh-xor-aad-block ctx ctx-len off (+ i 1 (* 0 s)) limit))))

(defn- gh-aad [ctx ctx-len off aad-n]
  (if (>= off aad-n) 1
    (let [rem (- aad-n off)
          limit (if (> rem 16) 16 rem)
          x (gh-xor-aad-block ctx ctx-len off 0 limit)
          m (gh-mult ctx ctx-len)]
      (gh-aad ctx ctx-len (+ off 16 (* 0 (+ x m))) aad-n))))

;; Reads use the 16 KiB window directly: 12288 is inside it, so the data side
;; of GHASH needs no chunking.  Only the STORES in `crypt-all` do, because the
;; store window stops at 4096.
(defn- gh-xor-data-block [ctx ctx-len data data-len off+i] (let [i (- off+i (* 32 (quot off+i 32))) off+i-q1 (quot off+i 32) off off+i-q1]
  (if (= i 16) 1
    (let [idx (+ off i)
          byte (if (< idx data-len) (kernel-load-u8-16k data data-len idx) 0)
          s (cs ctx ctx-len (+ 352 i) (bit-xor (cl ctx ctx-len (+ 352 i)) byte))]
      (gh-xor-data-block ctx ctx-len data data-len (+ (* off 32) (+ i 1 (* 0 s))))))))

(defn- gh-data [ctx ctx-len data data-len off]
  (if (>= off data-len) 1
    (let [x (gh-xor-data-block ctx ctx-len data data-len (+ (* off 32) 0))
          m (gh-mult ctx ctx-len)]
      (gh-data ctx ctx-len data data-len (+ off 16 (* 0 (+ x m)))))))

;; Least significant byte first, so the eight-byte field is written without
;; any literal above 256 -- and therefore without a shift count at all (see the
;; header note on why this object contains no `i64-shift-*`).
(defn- be64-tail [ctx ctx-len off i value]
  (if (= i 8) 1
    (let [s (cs ctx ctx-len (+ off (- 7 i)) (bit-and value 255))]
      (be64-tail ctx ctx-len off (+ i 1 (* 0 s)) (quot value 256)))))

(defn- be64-into [ctx ctx-len off value] (be64-tail ctx ctx-len off 0 value))

(defn- gh-xor-lenblk [ctx ctx-len i]
  (if (= i 16) 1
    (let [s (cs ctx ctx-len (+ 352 i) (bit-xor (cl ctx ctx-len (+ 352 i)) (cl ctx ctx-len (+ 464 i))))]
      (gh-xor-lenblk ctx ctx-len (+ i 1 (* 0 s))))))

(defn- gh-final [ctx ctx-len aad-n data-len]
  (let [a (be64-into ctx ctx-len 464 (* aad-n 8))
        b (be64-into ctx ctx-len 472 (* data-len 8))
        x (gh-xor-lenblk ctx ctx-len 0)
        m (gh-mult ctx ctx-len)]
    (+ 1 (* 0 (+ a (+ b (+ x m)))))))

(defn- set-j0 [ctx ctx-len nonce-off i]
  (if (= i 16) 1
    (let [v (if (< i 12) (cl ctx ctx-len (+ nonce-off i)) (if (= i 15) 1 0))
          s (cs ctx ctx-len (+ 320 i) v)]
      (set-j0 ctx ctx-len nonce-off (+ i 1 (* 0 s))))))

(defn- copy-j0-to-ctr [ctx ctx-len i]
  (if (= i 16) 1
    (let [s (cs ctx ctx-len (+ 336 i) (cl ctx ctx-len (+ 320 i)))]
      (copy-j0-to-ctr ctx ctx-len (+ i 1 (* 0 s))))))

;; inc32 on the last four bytes of the counter block, modulo 2^32 as SP 800-38D
;; specifies -- not modulo 2^128.
(defn- inc32 [ctx ctx-len]
  (let [n (+ (* (cl ctx ctx-len 348) 16777216)
             (+ (* (cl ctx ctx-len 349) 65536)
                (+ (* (cl ctx ctx-len 350) 256) (cl ctx ctx-len 351))))
        m (bit-and (+ n 1) 4294967295)
        s0 (cs ctx ctx-len 348 (bit-and (quot m 16777216) 255))
        s1 (cs ctx ctx-len 349 (bit-and (quot m 65536) 255))
        s2 (cs ctx ctx-len 350 (bit-and (quot m 256) 255))
        s3 (cs ctx ctx-len 351 (bit-and m 255))]
    (+ 1 (* 0 (+ s0 (+ s1 (+ s2 s3)))))))

(defn- crypt-block [ctx ctx-len sub sub-len index]
  (if (>= index sub-len) 1
    (let [k (cl ctx ctx-len (+ 448 index))
          c (kernel-load-u8-4k sub sub-len index)
          s (kernel-store-u8-4k sub sub-len index (bit-xor c k))]
      (crypt-block ctx ctx-len sub sub-len (+ index 1 (* 0 s))))))

;; JUN-708: the last partial block. `pos` runs from the block's offset (a multiple of 16) to data-len, so the
;; keystream index is pos mod 16, as crypt-block's block-local index was.
(defn- crypt-tail [ctx ctx-len data data-len pos]
  (if (>= pos data-len) 1
    (let [k (cl ctx ctx-len (+ 448 (- pos (* 16 (quot pos 16)))))
          c (kernel-load-u8-16k data data-len pos)
          s (kernel-store-u8-16k data data-len pos (bit-xor c k))]
      (crypt-tail ctx ctx-len data data-len (+ pos 1 (* 0 s))))))

;; The store window stops at 4096 and a record may be 12288, so the buffer has
;; to be narrowed through `kernel-subregion` before anything is written to it.
;; The narrowing is ONE CIPHER BLOCK WIDE rather than one 4096-byte chunk, and
;; that is the whole point: with a 4096-wide chunk there is a boundary at 4096
;; that nothing below 4 KiB of plaintext ever crosses, so every cheap vector
;; would exercise a path the real records do not.  At 16 bytes the first block
;; of a 32-byte record takes the identical path as the 768th block of a 12 KiB
;; one, and the last partial block takes the same path a 60-byte record's does.
;;
;; The cost is one bounds-checked narrowing per block instead of per 4096
;; bytes -- 768 extra operations on a full record, against the ~4M the object
;; already spends there.  The keystream index becomes the block-local `index`
;; rather than `index & 15`, so the alignment assumption disappears too.
;;
;; JUN-708: amu's native object route cannot prove the length of a window narrowed to a computed length, so the
;; narrowing is only for full blocks (16 bytes, a literal); the last partial block (fewer than 16 bytes left) is XORed
;; byte by byte over `data`'s own window by crypt-tail, through the 16 KiB tier. Same bytes, same order.
(defn- crypt-all [ctx ctx-len data data-len off]
  (if (>= off data-len) 1
    (let [rem (- data-len off)
          a (inc32 ctx ctx-len)
          b (aes-encrypt-block ctx ctx-len 336 448)
          c (if (< rem 16)
              (crypt-tail ctx ctx-len data data-len off)
              (crypt-block ctx ctx-len (kernel-subregion data data-len off 16) 16 0))]
      (crypt-all ctx ctx-len data data-len (+ off 16 (* 0 (+ a (+ b c))))))))

(defn- tag-out [ctx ctx-len i]
  (if (= i 16) 1
    (let [s (cs ctx ctx-len (+ 32 i) (bit-xor (cl ctx ctx-len (+ 368 i)) (cl ctx ctx-len (+ 352 i))))]
      (tag-out ctx ctx-len (+ i 1 (* 0 s))))))

;; Accumulates every byte's difference before deciding, so the comparison does
;; not return early on the first mismatching byte.
(defn- tag-diff [ctx ctx-len i acc]
  (if (= i 16) acc
    (tag-diff ctx ctx-len (+ i 1)
              (bit-or acc
                      (bit-xor (bit-xor (cl ctx ctx-len (+ 368 i)) (cl ctx ctx-len (+ 352 i)))
                               (cl ctx ctx-len (+ 32 i)))))))

(defn- zero-region [ctx ctx-len off i]
  (if (= i 16) 1
    (let [s (cs ctx ctx-len (+ off i) 0)] (zero-region ctx ctx-len off (+ i 1 (* 0 s))))))

(defn- gcm-seal [ctx ctx-len data data-len aad-n]
  (let [c (crypt-all ctx ctx-len data data-len 0)
        a (gh-aad ctx ctx-len 0 aad-n)
        d (gh-data ctx ctx-len data data-len 0)
        l (gh-final ctx ctx-len aad-n data-len)
        t (tag-out ctx ctx-len 0)]
    (* 0 (+ c (+ a (+ d (+ l t)))))))

(defn- gcm-open [ctx ctx-len data data-len aad-n]
  (let [a (gh-aad ctx ctx-len 0 aad-n)
        d (gh-data ctx ctx-len data data-len 0)
        l (gh-final ctx ctx-len aad-n data-len)
        diff (tag-diff ctx ctx-len 0 0)
        prefix (* 0 (+ a (+ d l)))]
    (if (= diff 0)
      (let [c (crypt-all ctx ctx-len data data-len 0)] (* 0 (+ c prefix)))
      (+ 5 prefix))))

(defn- gcm-prepare [ctx ctx-len nonce-off]
  (let [bt (build-tables ctx ctx-len)
        bs (build-sbox ctx ctx-len 0)
        ke (key-expand ctx ctx-len)
        zh (zero-region ctx ctx-len 304 0)
        h (aes-encrypt-block ctx ctx-len 304 304)
        j (set-j0 ctx ctx-len nonce-off 0)
        ek (aes-encrypt-block ctx ctx-len 320 368)
        cc (copy-j0-to-ctr ctx ctx-len 0)
        zy (zero-region ctx ctx-len 352 0)]
    (+ 1 (* 0 (+ bt (+ bs (+ ke (+ zh (+ h (+ j (+ ek (+ cc zy))))))))))))

;; JUN-708: the eight vectors as byte data (amu's native object route has no string literals). lit-K is byte i of
;; the hex literal lit-char spelled for kind K, from an if-tree of 8-byte little-endian words; hex-byte picks the kind.

;; kind 0: 58e2fccefa7e3061367f1d57a4e7455a (16 bytes, 2 words)
(defn- lit-0-word [w]
  (if (< w 1) 7003237036240724568 6504859929828753206))
(defn- lit-0 [i]
  (bit-and (u64-shift-right (lit-0-word (u64-shift-right i 3)) (* 8 (bit-and i 7))) 255))

;; kind 1: feffe9928665731c6d6a8d0340314de8 (16 bytes, 2 words)
(defn- lit-1-word [w]
  (if (< w 1) 2050093884048539646 -1707654532696282515))
(defn- lit-1 [i]
  (bit-and (u64-shift-right (lit-1-word (u64-shift-right i 3)) (* 8 (bit-and i 7))) 255))

;; kind 2: cafebabefacedbaddecaf888 (12 bytes, 2 words)
(defn- lit-2-word [w]
  (if (< w 1) -5918909708911313206 2298006238))
(defn- lit-2 [i]
  (bit-and (u64-shift-right (lit-2-word (u64-shift-right i 3)) (* 8 (bit-and i 7))) 255))

;; kind 3: d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255 (64 bytes, 8 words)
(defn- lit-3-word [w]
  (if (< w 4) (if (< w 2) (if (< w 1) -1943719987852987943 -7338908407479838299) (if (< w 3) -2668606987991144570 8253463736911678510)) (if (< w 6) (if (< w 5) 5983428571598437404 2717260783255736111) (if (< w 7) 6333764953864759985 6184197765501510586))))
(defn- lit-3 [i]
  (bit-and (u64-shift-right (lit-3-word (u64-shift-right i 3)) (* 8 (bit-and i 7))) 255))

;; kind 4: 4faa3ccbf07a91cfddce27c8578abaa1ed73bed1c3d08eb8b08021ff5d3549d4a282d3a85835e52d2da9e496273474dcccdbc9a28661dd66b87c441bd9ebbde7 (64 bytes, 8 words)
(defn- lit-4-word [w]
  (if (< w 4) (if (< w 2) (if (< w 1) -3489873061614933425 -6792964978310132003) (if (< w 3) -5147947784581778451 -3149927786540334928)) (if (< w 6) (if (< w 5) 3307108156279325346 -2561364943427032787) (if (< w 7) 7412187792606354380 -1747981762651980616))))
(defn- lit-4 [i]
  (bit-and (u64-shift-right (lit-4-word (u64-shift-right i 3)) (* 8 (bit-and i 7))) 255))

;; kind 5: 97f7b29118c8fb5494359b191d97003e (16 bytes, 2 words)
(defn- lit-5-word [w]
  (if (< w 1) 6123708126189516695 4467736981590979988))
(defn- lit-5 [i]
  (bit-and (u64-shift-right (lit-5-word (u64-shift-right i 3)) (* 8 (bit-and i 7))) 255))

;; kind 6: feedfacedeadbeeffeedfacedeadbeefabaddad2 (20 bytes, 3 words)
(defn- lit-6-word [w]
  (if (< w 1) -1171307680602853890 (if (< w 2) -1171307680602853890 3537546667)))
(defn- lit-6 [i]
  (bit-and (u64-shift-right (lit-6-word (u64-shift-right i 3)) (* 8 (bit-and i 7))) 255))

;; kind 7: 2b956e81820664242d50872ba9f521ee (16 bytes, 2 words)
(defn- lit-7-word [w]
  (if (< w 1) 2622228040623494443 -1287477911522684883))
(defn- lit-7 [i]
  (bit-and (u64-shift-right (lit-7-word (u64-shift-right i 3)) (* 8 (bit-and i 7))) 255))

(defn- hex-byte [kind i]
  ;; byte i of vector `kind`
  (if (= kind 0) (lit-0 i) (if (= kind 1) (lit-1 i) (if (= kind 2) (lit-2 i) (if (= kind 3) (lit-3 i) (if (= kind 4) (lit-4 i) (if (= kind 5) (lit-5 i) (if (= kind 6) (lit-6 i) (lit-7 i)))))))))


(defn- fill [ctx ctx-len at kind i+n] (let [n (- i+n (* 256 (quot i+n 256))) i+n-q1 (quot i+n 256) i i+n-q1]
  ;; ctx[at+i..at+n) <- literal `kind`. Tail-recursive: the store's value is
  ;; folded into the next index with `(* 0 ...)` so the store stays in the
  ;; dependency graph without a frame per byte.
  (if (>= i n)
    0
    (let [stored (cs ctx ctx-len (+ at i) (hex-byte kind i))]
      (fill ctx ctx-len at kind (+ (* (+ (+ i 1) (* 0 stored)) 256) n))))))

(defn- fill-data [data data-len at kind i+n] (let [n (- i+n (* 256 (quot i+n 256))) i+n-q1 (quot i+n 256) i i+n-q1]
  (if (>= i n)
    0
    (let [stored (kernel-store-u8 data data-len (+ at i) (hex-byte kind i))]
      (fill-data data data-len at kind (+ (* (+ (+ i 1) (* 0 stored)) 256) n))))))

(defn- zero-ctx [ctx ctx-len i]
  (if (>= i 1280)
    0
    (let [stored (cs ctx ctx-len i 0)]
      (zero-ctx ctx ctx-len (+ (+ i 1) (* 0 stored))))))

(defn- ctx-differs-from [ctx ctx-len at+kind i acc] (let [kind (- at+kind (* 16 (quot at+kind 16))) at+kind-q1 (quot at+kind 16) at at+kind-q1]
  ;; or-accumulated difference between ctx[at..at+16) and literal `kind`
  ;; (every ctx comparison here is a 16-byte tag)
  (if (>= i 16)
    acc
    (ctx-differs-from ctx ctx-len (+ (* at 16) kind) (+ i 1)
                      (bit-or acc (bit-xor (cl ctx ctx-len (+ at i)) (hex-byte kind i)))))))

(defn- ctx-differs [ctx ctx-len at kind] (ctx-differs-from ctx ctx-len (+ (* at 16) kind) 0 0))

(defn- data-differs [data data-len kind+i n acc] (let [i (- kind+i (* 128 (quot kind+i 128))) kind+i-q1 (quot kind+i 128) kind kind+i-q1]
  (if (>= i n)
    acc
    (data-differs data data-len (+ (* kind 128) (+ i 1)) n
                  (bit-or acc (bit-xor (kernel-load-u8 data data-len i) (hex-byte kind i)))))))

(defn- setup [ctx ctx-len key-kind nonce-kind aad-n+aad-kind] (let [aad-kind (- (- aad-n+aad-kind (* 16 (quot aad-n+aad-kind 16))) 1) aad-n+aad-kind-q1 (quot aad-n+aad-kind 16) aad-n aad-n+aad-kind-q1]
  ;; zero the context, then key, nonce, aad length and aad
  (let [z (zero-ctx ctx ctx-len 0)
        k (if (< key-kind 0) 0 (fill ctx ctx-len 0 key-kind (+ (* 0 256) 16)))
        n (if (< nonce-kind 0) 0 (fill ctx ctx-len 16 nonce-kind (+ (* 0 256) 12)))
        a (cs ctx ctx-len 28 aad-n)
        d (if (= aad-n 0) 0 (fill ctx ctx-len 64 aad-kind (+ (* 0 256) aad-n)))]
    (+ z k n a d))))

(defn- seal [ctx ctx-len data data-len]
  (let [p (gcm-prepare ctx ctx-len 16)]
    (+ (gcm-seal ctx ctx-len data data-len (cl ctx ctx-len 28)) (* 0 p))))

(defn- open [ctx ctx-len data data-len]
  (let [p (gcm-prepare ctx ctx-len 16)]
    (+ (gcm-open ctx ctx-len data data-len (cl ctx ctx-len 28)) (* 0 p))))

(defn- step-5 [ctx ctx-len data data-len]
  ;; 20 bytes of AAD change the tag only
  (let [s (setup ctx ctx-len 1 2 (+ (* 20 16) (+ 6 1)))
        f (fill-data data data-len 0 3 (+ (* 0 256) 64))
        r (seal ctx ctx-len data data-len)]
    (if (or (not (= r 0)) (not (= (ctx-differs ctx ctx-len 32 7) 0)))
      5
      (+ 0 (* 0 (+ s f))))))

(defn- step-4 [ctx ctx-len data data-len]
  ;; re-seal to get the ciphertext, flip the last tag bit, open must refuse
  ;; with reason 5 and leave the ciphertext untouched
  (let [s (setup ctx ctx-len 1 2 (+ (* 0 16) (+ -1 1)))
        f (fill-data data data-len 0 3 (+ (* 0 256) 64))
        r (seal ctx ctx-len data data-len)
        flip (cs ctx ctx-len 47 (bit-xor (cl ctx ctx-len 47) 1))
        o (open ctx ctx-len data data-len)]
    (if (or (not (= r 0)) (not (= o 5)) (not (= (data-differs data data-len (+ (* 4 128) 0) 64 0) 0)))
      4
      (+ (step-5 ctx ctx-len data data-len) (* 0 (+ s f flip))))))

(defn- step-3 [ctx ctx-len data data-len]
  ;; open the ciphertext with the right tag: the message comes back
  (let [s (setup ctx ctx-len 1 2 (+ (* 0 16) (+ -1 1)))
        f (fill-data data data-len 0 4 (+ (* 0 256) 64))
        t (fill ctx ctx-len 32 5 (+ (* 0 256) 16))
        o (open ctx ctx-len data data-len)]
    (if (or (not (= o 0)) (not (= (data-differs data data-len (+ (* 3 128) 0) 64 0) 0)))
      3
      (+ (step-4 ctx ctx-len data data-len) (* 0 (+ s f t))))))

(defn- step-2 [ctx ctx-len data data-len]
  ;; the 64-byte message under the recorded key and nonce
  (let [s (setup ctx ctx-len 1 2 (+ (* 0 16) (+ -1 1)))
        f (fill-data data data-len 0 3 (+ (* 0 256) 64))
        r (seal ctx ctx-len data data-len)]
    (if (or (not (= r 0))
            (not (= (data-differs data data-len (+ (* 4 128) 0) 64 0) 0))
            (not (= (ctx-differs ctx ctx-len 32 5) 0)))
      2
      (+ (step-3 ctx ctx-len data data-len) (* 0 (+ s f))))))

(defn- step-1 [ctx ctx-len data data-len]
  ;; empty message, zero key, zero nonce
  (let [s (setup ctx ctx-len -1 -1 (+ (* 0 16) (+ -1 1)))
        r (seal ctx ctx-len (kernel-subregion data data-len 0 0) 0)]
    (if (or (not (= r 0)) (not (= (ctx-differs ctx ctx-len 32 0) 0)))
      1
      (+ (step-2 ctx ctx-len data data-len) (* 0 s)))))

(defn kotoba_aiueos_aes128_gcm_selftest [scratch length]
  (if (< length 1536)
    6
    (step-1 (kernel-subregion scratch length 0 1280) 1280
            (kernel-subregion scratch length 1280 64) 64)))
