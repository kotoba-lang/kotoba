;; JUN-708: the single-file source of digest-equal.o on amu's native object route (aiueos/digest_equal.kotoba stays,
;; as the module value-runtime-cas-verify's project route requires). The namespace form comes first and exports the C
;; name only, with no test main; the digests are read as fixed 32-byte records (below). The answer is unchanged.
(ns aiueos.digest-equal (:export [kotoba_aiueos_digest_equal]))

;; Fixed-work comparison for the 32-byte SHA-256 values admitted by aiuefs.
;; The loop count and memory bounds are public and independent of digest data.

;; The two digests are fixed 32-byte records of the exported function's own parameters (the native route roots a
;; window only in a base with its own length, and these come without one), read as four little-endian words each;
;; the answer is 1 exactly when every byte is equal, as the byte-wise sum of differences was.
(defn- record-load-u64-0-32 [b :i64] :i64 0)
(defn- record-load-u64-8-32 [b :i64] :i64 0)
(defn- record-load-u64-16-32 [b :i64] :i64 0)
(defn- record-load-u64-24-32 [b :i64] :i64 0)

(defn kotoba_aiueos_digest_equal [expected actual length]
  (if (= length 32)
    (if (= (bit-or (bit-or (bit-xor (record-load-u64-0-32 expected) (record-load-u64-0-32 actual))
                           (bit-xor (record-load-u64-8-32 expected) (record-load-u64-8-32 actual)))
                   (bit-or (bit-xor (record-load-u64-16-32 expected) (record-load-u64-16-32 actual))
                           (bit-xor (record-load-u64-24-32 expected) (record-load-u64-24-32 actual))))
           0) 1 0)
    0))
