;; prepare_queue_index of kernel/pci.c in Kotoba (JUN-598): programming one virtio queue through the common configuration
;; registers, in the C's order, and the queue's notify (doorbell) offset.
;;
;; setup(cfg, 56, rec, 56): rec is seven little-endian u64s -- [0] the queue index, [8] the size, [16] the descriptor
;; table, [24] the driver (available) ring, [32] the device (used) ring, [40] the notify multiplier, [48] the notify
;; capability's length. Over cfg (struct virtio_common_cfg): queue_select (u16 @22) = index; refuse when queue_size (u16
;; @24) is below size, else when queue_enable (u16 @28) is already set (it is read only after the size check passed, as
;; the C's || did); queue_size = size; queue_desc / queue_driver / queue_device (u64 @32 / @40 / @48) = the rings;
;; queue_enable = 1; then the doorbell's offset is queue_notify_off (u16 @30) * the multiplier, refused when the 2-byte
;; doorbell does not fit the notify capability. Answers that offset + 1, or 0 when refused. A null pointer or a length
;; other than 56 answers 0 with no access.
(ns aiueos.virtio-queue (:export [kotoba_aiueos_virtio_queue_setup]))
(defn- r [p :i64 pn :i64 i :i64] :i64 (kernel-load-u64 p pn i))
(defn- program [c :i64 n :i64 p :i64 pn :i64] :i64
  (let [w1 (kernel-store-u16 c n 24 (bit-and (r p pn 8) 65535)) w2 (kernel-store-u64 c n 32 (r p pn 16))
        w3 (kernel-store-u64 c n 40 (r p pn 24)) w4 (kernel-store-u64 c n 48 (r p pn 32)) w5 (kernel-store-u16 c n 28 1)
        off (kernel-load-u16 c n 30) mult (bit-and (r p pn 40) 4294967295) len (r p pn 48)
        delta (* off mult)]
    (+ (if (> (+ delta 2) len) 0 (+ delta 1)) (* 0 (+ (+ w1 w2) (+ (+ w3 w4) w5))))))
(defn- enabled [c :i64 n :i64 p :i64 pn :i64] :i64
  (let [en (kernel-load-u16 c n 28)] (if (not= en 0) 0 (program c n p pn))))
(defn kotoba_aiueos_virtio_queue_setup [cfg :i64 n :i64 rec :i64 rec-len :i64] :i64
  (if (or (= cfg 0) (= rec 0) (not= n 56) (not= rec-len 56)) 0
    (let [w (kernel-store-u16 cfg n 22 (bit-and (r rec rec-len 0) 65535)) size (kernel-load-u16 cfg n 24)
          want (bit-and (r rec rec-len 8) 65535)]
      (if (< size want) (* 0 w) (enabled cfg n rec rec-len)))))
