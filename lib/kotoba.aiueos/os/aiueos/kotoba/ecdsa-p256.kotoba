;; JUN-708: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form first, takes no test main and exports nothing else. The route refuses a literal window on a region
;; with no paired length (E7106), so every region names its own length: the export is (sig sig-length digest
;; digest-length pubkey pubkey-length workspace workspace-length), every helper takes the length right after each
;; region it reaches, and six helpers carry two small values in one parameter (a*K + b, unpacked at entry; the route
;; admits five parameters). After the old workspace-length check the export narrows each region to its old size (64, 32,
;; 64, 2048) with kernel-subregion, so every window is the old one; a region shorter than its old size traps. The
;; arithmetic and the order of accesses are unchanged.
(ns aiueos.ecdsa-p256 (:export [kotoba_aiueos_ecdsa_p256_sha256_verify]))

;; Bounded ECDSA P-256 / SHA-256 admission for TLS 1.3 CertificateVerify.
;; ABI: [sig-64 r||s-BE, 64, digest-32, 32, pubkey-64 Qx||Qy-BE, 64, workspace, workspace-length]
;; returns 1 admit / 0 refuse. Workspace must be 2048 bytes.
;;
;; 16 little-endian u16 limbs per 256-bit integer. 16-bit limbs keep every
;; partial product inside signed i64 (x25519.kotoba). let-substitution staging
;; follows rsa2048.kotoba. Five-parameter ceiling.
;;
;; RFC 6979 A.2.5 SHA-256 "sample" must admit; the same vector with s+1 must
;; refuse. PKCS#1 RSA is the wrong scheme for TLS 1.3 CertVerify.

(defn- e-u16 [x] (bit-and x 65535))
(defn- e-pow2 [n] (if (<= n 0) 1 (* 2 (e-pow2 (- n 1)))))

(defn- e-limb [ws ws-len slot i]
  (+ (kernel-load-u8-4k ws ws-len (+ (* slot 32) (* 2 i)))
     (* 256 (kernel-load-u8-4k ws ws-len (+ (* slot 32) (+ (* 2 i) 1))))))

(defn- e-put [ws ws-len slot i v]
  (+ (kernel-store-u8-4k ws ws-len (+ (* slot 32) (* 2 i)) (bit-and v 255))
     (* 0 (kernel-store-u8-4k ws ws-len (+ (* slot 32) (+ (* 2 i) 1))
                              (bit-and (quot v 256) 255)))))

(defn- e-copy [ws ws-len dst src i]
  (if (= i 16) 1
    (e-copy ws ws-len dst src (+ i 1 (* 0 (e-put ws ws-len dst i (e-limb ws ws-len src i)))))))

(defn- e-zero [ws ws-len slot i]
  (if (= i 16) 1
    (e-zero ws ws-len slot (+ i 1 (* 0 (e-put ws ws-len slot i 0))))))

(defn- e-p-limb [i]
  (if (= i 0) 65535 (if (= i 1) 65535 (if (= i 2) 65535 (if (= i 3) 65535
  (if (= i 4) 65535 (if (= i 5) 65535 (if (= i 6) 0 (if (= i 7) 0
  (if (= i 8) 0 (if (= i 9) 0 (if (= i 10) 0 (if (= i 11) 0
  (if (= i 12) 1 (if (= i 13) 0 (if (= i 14) 65535 65535))))))))))))))))

(defn- e-n-limb [i]
  (if (= i 0) 9553 (if (= i 1) 64611 (if (= i 2) 51906 (if (= i 3) 62393
  (if (= i 4) 40580 (if (= i 5) 42775 (if (= i 6) 64173 (if (= i 7) 48358
  (if (= i 8) 65535 (if (= i 9) 65535 (if (= i 10) 65535 (if (= i 11) 65535
  (if (= i 12) 0 (if (= i 13) 0 (if (= i 14) 65535 65535))))))))))))))))

(defn- e-gx-limb [i]
  (if (= i 0) 49814 (if (= i 1) 55448 (if (= i 2) 14661 (if (= i 3) 62625
  (if (= i 4) 13216 (if (= i 5) 11755 (if (= i 6) 32129 (if (= i 7) 30467
  (if (= i 8) 16626 (if (= i 9) 25508 (if (= i 10) 59109 (if (= i 11) 63676
  (if (= i 12) 16967 (if (= i 13) 57644 (if (= i 14) 53746 27415))))))))))))))))

(defn- e-gy-limb [i]
  (if (= i 0) 20981 (if (= i 1) 14271 (if (= i 2) 16488 (if (= i 3) 52150
  (if (= i 4) 24270 (if (= i 5) 27441 (if (= i 6) 13143 (if (= i 7) 11214
  (if (= i 8) 40470 (if (= i 9) 31759 (if (= i 10) 60234 (if (= i 11) 36583
  (if (= i 12) 32667 (if (= i 13) 65050 (if (= i 14) 17122 20451))))))))))))))))

(defn- e-p2-limb [i]
  (if (= i 0) 65533 (if (= i 1) 65535 (if (= i 2) 65535 (if (= i 3) 65535
  (if (= i 4) 65535 (if (= i 5) 65535 (if (= i 6) 0 (if (= i 7) 0
  (if (= i 8) 0 (if (= i 9) 0 (if (= i 10) 0 (if (= i 11) 0
  (if (= i 12) 1 (if (= i 13) 0 (if (= i 14) 65535 65535))))))))))))))))

(defn- e-n2-limb [i]
  (if (= i 0) 9551 (if (= i 1) 64611 (if (= i 2) 51906 (if (= i 3) 62393
  (if (= i 4) 40580 (if (= i 5) 42775 (if (= i 6) 64173 (if (= i 7) 48358
  (if (= i 8) 65535 (if (= i 9) 65535 (if (= i 10) 65535 (if (= i 11) 65535
  (if (= i 12) 0 (if (= i 13) 0 (if (= i 14) 65535 65535))))))))))))))))

;; 2^256 ≡ POLY (mod p). POLY = 2^224 - 2^192 - 2^96 + 1.
(defn- e-poly-limb [i]
  (if (= i 0) 1
    (if (< i 6) 0
      (if (< i 12) 65535
        (if (= i 12) 65534
          (if (= i 13) 65535 0))))))

(defn- e-fill [ws ws-len slot kind i]
  (if (= i 16) 1
    (let [v (if (= kind 0) (e-p-limb i)
              (if (= kind 1) (e-n-limb i)
                (if (= kind 2) (e-gx-limb i)
                  (if (= kind 3) (e-gy-limb i)
                    (if (= kind 4) (e-p2-limb i)
                      (if (= kind 5) (e-n2-limb i)
                        (e-poly-limb i)))))))]
      (e-fill ws ws-len slot kind (+ i 1 (* 0 (e-put ws ws-len slot i v)))))))

(defn- e-load-r [sig sig-len ws ws-len i]
  (if (= i 16) 1
    (let [bo (- 31 (* 2 i))
          v (+ (kernel-load-u8-4k sig sig-len bo)
               (* 256 (kernel-load-u8-4k sig sig-len (- bo 1))))]
      (e-load-r sig sig-len ws ws-len (+ i 1 (* 0 (e-put ws ws-len 2 i v)))))))

(defn- e-load-s [sig sig-len ws ws-len i]
  (if (= i 16) 1
    (let [bo (- 63 (* 2 i))
          v (+ (kernel-load-u8-4k sig sig-len bo)
               (* 256 (kernel-load-u8-4k sig sig-len (- bo 1))))]
      (e-load-s sig sig-len ws ws-len (+ i 1 (* 0 (e-put ws ws-len 3 i v)))))))

(defn- e-load-e [digest digest-len ws ws-len i]
  (if (= i 16) 1
    (let [bo (- 31 (* 2 i))
          v (+ (kernel-load-u8-4k digest digest-len bo)
               (* 256 (kernel-load-u8-4k digest digest-len (- bo 1))))]
      (e-load-e digest digest-len ws ws-len (+ i 1 (* 0 (e-put ws ws-len 4 i v)))))))

(defn- e-load-qx [pub pub-len ws ws-len i]
  (if (= i 16) 1
    (let [bo (- 31 (* 2 i))
          v (+ (kernel-load-u8-4k pub pub-len bo)
               (* 256 (kernel-load-u8-4k pub pub-len (- bo 1))))]
      (e-load-qx pub pub-len ws ws-len (+ i 1 (* 0 (e-put ws ws-len 5 i v)))))))

(defn- e-load-qy [pub pub-len ws ws-len i]
  (if (= i 16) 1
    (let [bo (- 63 (* 2 i))
          v (+ (kernel-load-u8-4k pub pub-len bo)
               (* 256 (kernel-load-u8-4k pub pub-len (- bo 1))))]
      (e-load-qy pub pub-len ws ws-len (+ i 1 (* 0 (e-put ws ws-len 6 i v)))))))

(defn- e-cmp [ws ws-len a b i]
  (if (= i -1) 0
    (let [va (e-limb ws ws-len a i) vb (e-limb ws ws-len b i)]
      (if (> va vb) 1
        (if (< va vb) -1
          (e-cmp ws ws-len a b (- i 1)))))))

(defn- e-is-zero [ws ws-len slot i]
  (if (= i 16) 1
    (if (= (e-limb ws ws-len slot i) 0)
      (e-is-zero ws ws-len slot (+ i 1))
      0)))

(defn- e-sub-mod [ws ws-len dst src i+borrow] (let [borrow (- i+borrow (* 2 (quot i+borrow 2))) i+borrow-q1 (quot i+borrow 2) i i+borrow-q1]
  (if (= i 16) borrow
    (let [before (e-limb ws ws-len dst i)
          sub (+ (e-limb ws ws-len src i) borrow)
          wrapped (e-u16 (- (+ before 65536) (e-u16 sub)))
          new-borrow (if (> sub 65535) 1 (if (< before (e-u16 sub)) 1 0))
          staged (e-put ws ws-len 25 0 new-borrow)
          stored (e-put ws ws-len dst i wrapped)]
      (e-sub-mod ws ws-len dst src (+ (* (+ i 1 (* 0 (+ staged stored))) 2) (e-limb ws ws-len 25 0)))))))

(defn- e-add-limbs [ws ws-len dst src i+carry] (let [carry (- i+carry (* 2 (quot i+carry 2))) i+carry-q1 (quot i+carry 2) i i+carry-q1]
  (if (= i 16) carry
    (let [sum (+ (e-limb ws ws-len dst i) (+ (e-limb ws ws-len src i) carry))
          staged (e-put ws ws-len 25 0 (quot sum 65536))
          stored (e-put ws ws-len dst i (e-u16 sum))]
      (e-add-limbs ws ws-len dst src (+ (* (+ i 1 (* 0 (+ staged stored))) 2) (e-limb ws ws-len 25 0)))))))

(defn- e-add-mod [ws ws-len dst src mod-slot]
  (let [carry (e-add-limbs ws ws-len dst src (+ (* 0 2) 0))]
    (if (> carry 0)
      (e-sub-mod ws ws-len dst mod-slot (+ (* 0 2) 0))
      (if (>= (e-cmp ws ws-len dst mod-slot 15) 0)
        (e-sub-mod ws ws-len dst mod-slot (+ (* 0 2) 0))
        0))))

(defn- e-sub-field [ws ws-len dst src mod-slot]
  (let [borrow (e-sub-mod ws ws-len dst src (+ (* 0 2) 0))]
    (if (> borrow 0)
      (e-add-limbs ws ws-len dst mod-slot (+ (* 0 2) 0))
      0)))

(defn- e-prod-put [ws ws-len k v]
  (if (< k 16) (e-put ws ws-len 23 k v) (e-put ws ws-len 24 (- k 16) v)))
(defn- e-prod-limb [ws ws-len k]
  (if (< k 16) (e-limb ws ws-len 23 k) (e-limb ws ws-len 24 (- k 16))))
(defn- e-prod-clear [ws ws-len k]
  (if (= k 32) 1
    (e-prod-clear ws ws-len (+ k 1 (* 0 (e-prod-put ws ws-len k 0))))))

(defn- e-mul-inner [ws ws-len i j carry]
  (if (= j 16)
    (e-prod-put ws ws-len (+ i 16) carry)
    (let [acc (+ (e-prod-limb ws ws-len (+ i j))
                 (+ (* (e-limb ws ws-len 0 i) (e-limb ws ws-len 1 j)) carry))
          stored (e-prod-put ws ws-len (+ i j) (e-u16 acc))]
      (e-mul-inner ws ws-len i (+ j 1 (* 0 stored)) (quot acc 65536)))))

(defn- e-mul-outer [ws ws-len i]
  (if (= i 16) 1
    (e-mul-outer ws ws-len (+ i 1 (* 0 (e-mul-inner ws ws-len i 0 0))))))

;; NIST P-256 Solinas (FIPS 186-4 D.2.5) on 16-bit limbs. Word-reduce is
;; ~32 scale/sub steps per mul; this is 9 signed adds. Host oracle: 500
;; random products + 200 full 512-bit values, extras in [-3,2]. Slot 18
;; holds POLY during fold. Extra lives in slot 25 limb 3 as 32768+extra.
;; Index 32 means a zero limb of an s-vector.
(defn- e-s2-idx [i] (if (< i 6) 32 (+ i 16)))
(defn- e-s3-idx [i] (if (< i 6) 32 (if (< i 14) (+ i 18) 32)))
(defn- e-s4-idx [i] (if (< i 6) (+ i 16) (if (< i 12) 32 (+ i 16))))
(defn- e-s5-idx [i]
  (if (< i 6) (+ i 18)
    (if (< i 12) (+ i 20)
      (if (< i 14) (+ i 14) (+ i 2)))))
(defn- e-s6-idx [i]
  (if (< i 6) (+ i 22)
    (if (< i 12) 32
      (if (< i 14) (+ i 4) (+ i 6)))))
(defn- e-s7-idx [i]
  (if (< i 8) (+ i 24)
    (if (< i 12) 32
      (if (< i 14) (+ i 6) (+ i 8)))))
(defn- e-s8-idx [i]
  (if (< i 6) (+ i 26)
    (if (< i 12) (+ i 10)
      (if (< i 14) 32 (+ i 10)))))
(defn- e-s9-idx [i]
  (if (< i 4) (+ i 28)
    (if (< i 6) 32
      (if (< i 12) (+ i 12)
        (if (< i 14) 32 (+ i 12))))))

(defn- e-s-idx [which i]
  (if (= which 1) i
    (if (= which 2) (e-s2-idx i)
      (if (= which 3) (e-s3-idx i)
        (if (= which 4) (e-s4-idx i)
          (if (= which 5) (e-s5-idx i)
            (if (= which 6) (e-s6-idx i)
              (if (= which 7) (e-s7-idx i)
                (if (= which 8) (e-s8-idx i)
                  (e-s9-idx i))))))))))

(defn- e-s-limb [ws ws-len which i]
  (let [idx (e-s-idx which i)]
    (if (= idx 32) 0 (e-prod-limb ws ws-len idx))))

(defn- e-get-extra [ws ws-len] (- (e-limb ws ws-len 25 3) 32768))
(defn- e-set-extra [ws ws-len x] (e-put ws ws-len 25 3 (+ x 32768)))

(defn- e-acc-add-s [ws ws-len which i carry]
  (if (= i 16)
    (e-set-extra ws ws-len (+ (e-get-extra ws ws-len) carry))
    (let [sum (+ (e-limb ws ws-len 22 i) (+ (e-s-limb ws ws-len which i) carry))
          staged (e-put ws ws-len 25 0 (quot sum 65536))
          stored (e-put ws ws-len 22 i (e-u16 sum))]
      (e-acc-add-s ws ws-len which (+ i 1 (* 0 (+ staged stored)))
                   (e-limb ws ws-len 25 0)))))

(defn- e-acc-sub-s [ws ws-len which i borrow]
  (if (= i 16)
    (e-set-extra ws ws-len (- (e-get-extra ws ws-len) borrow))
    (let [before (e-limb ws ws-len 22 i)
          sub (+ (e-s-limb ws ws-len which i) borrow)
          wrapped (e-u16 (- (+ before 65536) (e-u16 sub)))
          new-borrow (if (> sub 65535) 1 (if (< before (e-u16 sub)) 1 0))
          staged (e-put ws ws-len 25 0 new-borrow)
          stored (e-put ws ws-len 22 i wrapped)]
      (e-acc-sub-s ws ws-len which (+ i 1 (* 0 (+ staged stored)))
                   (e-limb ws ws-len 25 0)))))

(defn- e-fold-poly [ws ws-len]
  (let [ex (e-get-extra ws ws-len)]
    (if (= ex 0)
      (e-canon-word ws ws-len 28 0)
      (if (> ex 0)
        (let [c (e-add-limbs ws ws-len 22 18 (+ (* 0 2) 0))
              st (e-set-extra ws ws-len (+ (- ex 1) c))]
          (e-fold-poly ws ws-len))
        (let [b (e-sub-mod ws ws-len 22 18 (+ (* 0 2) 0))
              st (e-set-extra ws ws-len (- (+ ex 1) b))]
          (e-fold-poly ws ws-len))))))

(defn- e-reduce-p [ws ws-len z]
  (let [zr (e-zero ws ws-len 22 (* 0 z))
        ex (e-set-extra ws ws-len (* 0 zr))
        py (e-fill ws ws-len 18 6 (* 0 ex))
        a1 (e-acc-add-s ws ws-len 1 0 (* 0 py))
        a2 (e-acc-add-s ws ws-len 2 0 (* 0 a1))
        a2b (e-acc-add-s ws ws-len 2 0 (* 0 a2))
        a3 (e-acc-add-s ws ws-len 3 0 (* 0 a2b))
        a3b (e-acc-add-s ws ws-len 3 0 (* 0 a3))
        a4 (e-acc-add-s ws ws-len 4 0 (* 0 a3b))
        a5 (e-acc-add-s ws ws-len 5 0 (* 0 a4))
        s6 (e-acc-sub-s ws ws-len 6 0 (* 0 a5))
        s7 (e-acc-sub-s ws ws-len 7 0 (* 0 s6))
        s8 (e-acc-sub-s ws ws-len 8 0 (* 0 s7))
        s9 (e-acc-sub-s ws ws-len 9 0 (* 0 s8))]
    (e-fold-poly ws ws-len)))

;; 16-bit word reduction: 32 steps instead of 512 bit-serial steps.
;; Bit-serial exhausted 180s of TCG before RFC 6979 returned (Jacobian
;; formulas were already correct on a host oracle). Slot 17 holds q*mod.
(defn- e-shl16-from [ws ws-len i]
  (if (= i 0) 1
    (let [v (e-limb ws ws-len 22 (- i 1))
          st (e-put ws ws-len 22 i v)]
      (e-shl16-from ws ws-len (- i (+ 1 (* 0 st)))))))

(defn- e-shl16-insert [ws ws-len incoming]
  (let [sh (e-shl16-from ws ws-len 15)
        lo (e-put ws ws-len 22 0 incoming)]
    (* 0 (+ sh lo))))

(defn- e-scale-u16 [ws ws-len mod-slot q i+carry] (let [carry (- i+carry (* 65536 (quot i+carry 65536))) i+carry-q1 (quot i+carry 65536) i i+carry-q1]
  (if (= i 16)
    (e-put ws ws-len 25 2 carry)
    (let [acc (+ (* q (e-limb ws ws-len mod-slot i)) carry)
          st (e-put ws ws-len 17 i (e-u16 acc))]
      (e-scale-u16 ws ws-len mod-slot q (+ (* (+ i 1 (* 0 st)) 65536) (quot acc 65536)))))))

(defn- e-sub-scaled [ws ws-len i borrow]
  (if (= i 16) borrow
    (let [before (e-limb ws ws-len 22 i)
          sub (+ (e-limb ws ws-len 17 i) borrow)
          wrapped (e-u16 (- (+ before 65536) (e-u16 sub)))
          new-borrow (if (> sub 65535) 1 (if (< before (e-u16 sub)) 1 0))
          staged (e-put ws ws-len 25 0 new-borrow)
          stored (e-put ws ws-len 22 i wrapped)]
      (e-sub-scaled ws ws-len (+ i 1 (* 0 (+ staged stored))) (e-limb ws ws-len 25 0)))))

(defn- e-canon-word [ws ws-len mod-slot extra]
  (if (< extra 0)
    (let [c (e-add-limbs ws ws-len 22 mod-slot (+ (* 0 2) 0))]
      (e-canon-word ws ws-len mod-slot (+ extra c)))
    (if (> extra 0)
      (let [b (e-sub-mod ws ws-len 22 mod-slot (+ (* 0 2) 0))]
        (e-canon-word ws ws-len mod-slot (- extra b)))
      (if (>= (e-cmp ws ws-len 22 mod-slot 15) 0)
        (let [b2 (e-sub-mod ws ws-len 22 mod-slot (+ (* 0 2) 0))]
          (e-canon-word ws ws-len mod-slot (* 0 b2)))
        1))))

(defn- e-reduce-word [ws ws-len mod-slot k]
  (if (= k -1) 1
    (let [top (e-limb ws ws-len 22 15)
          ins (e-shl16-insert ws ws-len (e-prod-limb ws ws-len k))
          sc (e-scale-u16 ws ws-len mod-slot top (+ (* 0 65536) (* 0 ins)))
          b (e-sub-scaled ws ws-len (* 0 sc) 0)
          extra (- top (+ (e-limb ws ws-len 25 2) b))
          cn (e-canon-word ws ws-len mod-slot extra)]
      (e-reduce-word ws ws-len mod-slot (- k (+ 1 (* 0 cn)))))))

(defn- e-mul-mod [ws ws-len dst+left right mod-slot] (let [left (- dst+left (* 256 (quot dst+left 256))) dst+left-q1 (quot dst+left 256) dst dst+left-q1]
  (let [c0 (e-copy ws ws-len 0 left 0)
        c1 (e-copy ws ws-len 1 right (* 0 c0))
        cl (e-prod-clear ws ws-len (* 0 c1))
        mu (e-mul-outer ws ws-len (* 0 cl))]
    (if (= mod-slot 28)
      (let [rd (e-reduce-p ws ws-len (* 0 mu))]
        (e-copy ws ws-len dst 22 (* 0 rd)))
      (let [zr (e-zero ws ws-len 22 (* 0 mu))
            rd (e-reduce-word ws ws-len mod-slot (+ 31 (* 0 zr)))]
        (e-copy ws ws-len dst 22 (* 0 rd)))))))

(defn- e-sqr-mod [ws ws-len dst src mod-slot]
  (e-mul-mod ws ws-len (+ (* dst 256) src) src mod-slot))

(defn- e-exp-bit [ws ws-len bit]
  (let [limb (quot bit 16) within (- bit (* limb 16))]
    (bit-and (quot (e-limb ws ws-len 21 limb) (e-pow2 within)) 1)))

(defn- e-exp-loop [ws ws-len dst mod-slot bit]
  (if (= bit -1) (e-copy ws ws-len dst 15 0)
    (let [sq (e-sqr-mod ws ws-len 16 15 mod-slot)
          cp (e-copy ws ws-len 15 16 (* 0 sq))
          mul (if (= (e-exp-bit ws ws-len bit) 1)
                (let [pr (e-mul-mod ws ws-len (+ (* 16 256) 15) 20 mod-slot)]
                  (e-copy ws ws-len 15 16 (* 0 pr)))
                (* 0 cp))]
      (e-exp-loop ws ws-len dst mod-slot (- bit (+ 1 (* 0 mul)))))))

(defn- e-inv-mod [ws ws-len dst src mod-slot+p?] (let [p? (- mod-slot+p? (* 2 (quot mod-slot+p? 2))) mod-slot+p?-q1 (quot mod-slot+p? 2) mod-slot mod-slot+p?-q1]
  (let [b (e-copy ws ws-len 20 src 0)
        e (if (= p? 1) (e-fill ws ws-len 21 4 0) (e-fill ws ws-len 21 5 0))
        one (e-zero ws ws-len 15 (* 0 e))
        s1 (e-put ws ws-len 15 0 (+ 1 (* 0 one)))]
    (e-exp-loop ws ws-len dst mod-slot (+ 255 (* 0 (+ b s1)))))))

;; Jacobian (X:Y:Z) in slots 10/11/29. Affine used 256 Fermat inverses and
;; exhausted even the imm32 fuel ceiling (vector 6). One inverse at the end.
;; Temps 30-47. inv-mod still owns 15/16/20/21. p is slot 28.

(defn- e-dbl-val [ws ws-len slot]
  (e-add-mod ws ws-len slot slot 28))

(defn- e-jac-inf? [ws ws-len]
  (e-is-zero ws ws-len 29 0))

(defn- e-jac-set-inf [ws ws-len]
  (let [zx (e-zero ws ws-len 10 0)
        zy (e-zero ws ws-len 11 (* 0 zx))]
    (e-zero ws ws-len 29 (* 0 zy))))

(defn- e-jac-from-aff [ws ws-len bx by-slot]
  (let [cx (e-copy ws ws-len 10 bx 0)
        cy (e-copy ws ws-len 11 by-slot (* 0 cx))
        z0 (e-zero ws ws-len 29 (* 0 cy))
        z1 (e-put ws ws-len 29 0 1)]
    (* 0 z1)))

;; dbl-2001-b for a = -3. Acc (10,11,29).
(defn- e-dbl-jac [ws ws-len]
  (if (= (e-jac-inf? ws ws-len) 1) 1
    (if (= (e-is-zero ws ws-len 11 0) 1)
      (e-jac-set-inf ws ws-len)
      (let [d (e-sqr-mod ws ws-len 30 29 28)
            g (e-sqr-mod ws ws-len 31 11 28)
            b (e-mul-mod ws ws-len (+ (* 32 256) 10) 31 28)
            xd (e-copy ws ws-len 33 10 (* 0 b))
            s1 (e-sub-field ws ws-len 33 30 28)
            xp (e-copy ws ws-len 34 10 (* 0 s1))
            a1 (e-add-mod ws ws-len 34 30 28)
            pr (e-mul-mod ws ws-len (+ (* 35 256) 33) 34 28)
            al (e-copy ws ws-len 36 35 (* 0 pr))
            t1 (e-add-mod ws ws-len 36 35 28)
            t2 (e-add-mod ws ws-len 36 35 28)
            as (e-sqr-mod ws ws-len 37 36 28)
            bb (e-copy ws ws-len 38 32 (* 0 as))
            m2 (e-dbl-val ws ws-len 38)
            m4 (e-dbl-val ws ws-len 38)
            m8 (e-dbl-val ws ws-len 38)
            x3 (e-copy ws ws-len 47 37 (* 0 m8))
            sx (e-sub-field ws ws-len 47 38 28)
            yz (e-copy ws ws-len 39 11 (* 0 sx))
            az (e-add-mod ws ws-len 39 29 28)
            yz2 (e-sqr-mod ws ws-len 40 39 28)
            z3 (e-copy ws ws-len 41 40 (* 0 yz2))
            sg (e-sub-field ws ws-len 41 31 28)
            sd (e-sub-field ws ws-len 41 30 28)
            b4 (e-copy ws ws-len 42 32 (* 0 sd))
            d1 (e-dbl-val ws ws-len 42)
            d2 (e-dbl-val ws ws-len 42)
            vm (e-copy ws ws-len 43 42 (* 0 d2))
            sv (e-sub-field ws ws-len 43 47 28)
            ar (e-mul-mod ws ws-len (+ (* 44 256) 36) 43 28)
            gg (e-sqr-mod ws ws-len 45 31 28)
            g8 (e-copy ws ws-len 46 45 (* 0 gg))
            e1 (e-dbl-val ws ws-len 46)
            e2 (e-dbl-val ws ws-len 46)
            e3 (e-dbl-val ws ws-len 46)
            y3 (e-copy ws ws-len 11 44 (* 0 e3))
            sy (e-sub-field ws ws-len 11 46 28)
            cx (e-copy ws ws-len 10 47 (* 0 sy))
            cz (e-copy ws ws-len 29 41 (* 0 cx))]
        (* 0 cz)))))

(defn- e-madd-jac [ws ws-len bx by-slot]
  (if (= (e-jac-inf? ws ws-len) 1)
    (e-jac-from-aff ws ws-len bx by-slot)
    (let [z2 (e-sqr-mod ws ws-len 30 29 28)
          u2 (e-mul-mod ws ws-len (+ (* 31 256) bx) 30 28)
          z3 (e-mul-mod ws ws-len (+ (* 32 256) 29) 30 28)
          s2 (e-mul-mod ws ws-len (+ (* 33 256) by-slot) 32 28)
          h (e-copy ws ws-len 34 31 (* 0 s2))
          sh (e-sub-field ws ws-len 34 10 28)
          hh (e-sqr-mod ws ws-len 35 34 28)]
      (if (= (e-is-zero ws ws-len 34 0) 1)
        (if (= (e-cmp ws ws-len 33 11 15) 0)
          (e-dbl-jac ws ws-len)
          (e-jac-set-inf ws ws-len))
        (let [i (e-copy ws ws-len 36 35 0)
              i2 (e-dbl-val ws ws-len 36)
              i4 (e-dbl-val ws ws-len 36)
              j (e-mul-mod ws ws-len (+ (* 37 256) 34) 36 28)
              r (e-copy ws ws-len 38 33 (* 0 j))
              sr (e-sub-field ws ws-len 38 11 28)
              r2 (e-dbl-val ws ws-len 38)
              v (e-mul-mod ws ws-len (+ (* 39 256) 10) 36 28)
              rr (e-sqr-mod ws ws-len 40 38 28)
              x3 (e-copy ws ws-len 47 40 (* 0 rr))
              sj (e-sub-field ws ws-len 47 37 28)
              v2 (e-copy ws ws-len 41 39 (* 0 sj))
              dv (e-dbl-val ws ws-len 41)
              sv (e-sub-field ws ws-len 47 41 28)
              vm (e-copy ws ws-len 42 39 (* 0 sv))
              svm (e-sub-field ws ws-len 42 47 28)
              ry (e-mul-mod ws ws-len (+ (* 43 256) 38) 42 28)
              yj (e-mul-mod ws ws-len (+ (* 44 256) 11) 37 28)
              yj2 (e-dbl-val ws ws-len 44)
              y3 (e-copy ws ws-len 11 43 (* 0 yj2))
              sy (e-sub-field ws ws-len 11 44 28)
              zh (e-copy ws ws-len 45 29 (* 0 sy))
              ah (e-add-mod ws ws-len 45 34 28)
              zh2 (e-sqr-mod ws ws-len 46 45 28)
              nz (e-copy ws ws-len 29 46 (* 0 zh2))
              sz (e-sub-field ws ws-len 29 30 28)
              shh (e-sub-field ws ws-len 29 35 28)
              cx (e-copy ws ws-len 10 47 (* 0 shh))]
          (* 0 cx))))))

(defn- e-scalar-bit [ws ws-len k-slot bit]
  (let [limb (quot bit 16) within (- bit (* limb 16))]
    (bit-and (quot (e-limb ws ws-len k-slot limb) (e-pow2 within)) 1)))

(defn- e-scalarmul [ws ws-len k-slot+bit bx by-slot] (let [bit (- (- k-slot+bit (* 512 (quot k-slot+bit 512))) 1) k-slot+bit-q1 (quot k-slot+bit 512) k-slot k-slot+bit-q1]
  (if (= bit -1) 1
    (let [d (e-dbl-jac ws ws-len)
          a (if (= (e-scalar-bit ws ws-len k-slot bit) 1)
              (e-madd-jac ws ws-len bx by-slot)
              (* 0 d))]
      (e-scalarmul ws ws-len (+ (* k-slot 512) (+ (- bit (+ 1 (* 0 a))) 1)) bx by-slot)))))

(defn- e-to-affine [ws ws-len]
  (if (= (e-jac-inf? ws ws-len) 1) 1
    (let [zi (e-inv-mod ws ws-len 43 29 (+ (* 28 2) 1))
          z2 (e-sqr-mod ws ws-len 44 43 28)
          xa (e-mul-mod ws ws-len (+ (* 10 256) 10) 44 28)
          z3 (e-mul-mod ws ws-len (+ (* 45 256) 44) 43 28)
          ya (e-mul-mod ws ws-len (+ (* 11 256) 11) 45 28)
          zo (e-zero ws ws-len 29 (* 0 ya))
          z1 (e-put ws ws-len 29 0 1)]
      (* 0 z1))))

(defn- e-in-range [ws ws-len slot]
  (if (= (e-is-zero ws ws-len slot 0) 1) 0
    (if (>= (e-cmp ws ws-len slot 27 15) 0) 0 1)))

(defn- e-finish [ws ws-len gate]
  (if (= (+ (e-jac-inf? ws ws-len) (* 0 gate)) 1) 0
    (let [af (e-to-affine ws ws-len)
          fn (e-fill ws ws-len 27 1 (* 0 af))
          one (e-zero ws ws-len 20 (* 0 fn))
          o1 (e-put ws ws-len 20 0 (+ 1 (* 0 one)))
          xn (e-mul-mod ws ws-len (+ (* 22 256) 10) 20 27)]
      (if (= (e-cmp ws ws-len 22 2 15) 0) 1 0))))

(defn- e-combine [ws ws-len gate]
  (let [ia (kernel-load-u8-4k ws ws-len 2045)
        ib (+ (e-jac-inf? ws ws-len) (* 0 gate))]
    (if (= ib 1)
      (if (= ia 1) 0
        (let [rx (e-copy ws ws-len 10 12 0)
              ry (e-copy ws ws-len 11 26 (* 0 rx))
              rz (e-copy ws ws-len 29 48 (* 0 ry))]
          (e-finish ws ws-len (* 0 rz))))
      (if (= ia 1)
        (e-finish ws ws-len 0)
        (let [ad (e-madd-jac ws ws-len 12 26)]
          (e-finish ws ws-len (* 0 ad)))))))

(defn- e-verify-rest [ws ws-len]
  (let [w (e-inv-mod ws ws-len 7 3 (+ (* 27 2) 0))
        u1 (e-mul-mod ws ws-len (+ (* 8 256) 4) 7 27)
        u2 (e-mul-mod ws ws-len (+ (* 9 256) 2) 7 27)
        inf0 (e-jac-set-inf ws ws-len)
        sm1 (e-scalarmul ws ws-len (+ (* 8 512) (+ (+ 255 (* 0 inf0)) 1)) 13 14)
        af1 (e-to-affine ws ws-len)
        cax (e-copy ws ws-len 12 10 (* 0 af1))
        cay (e-copy ws ws-len 26 11 (* 0 cax))
        caz (e-copy ws ws-len 48 29 (* 0 cay))
        ia (kernel-store-u8-4k ws ws-len 2045 (e-jac-inf? ws ws-len))
        inf1 (e-jac-set-inf ws ws-len)
        sm2 (e-scalarmul ws ws-len (+ (* 9 512) (+ (+ 255 (* 0 (+ ia inf1))) 1)) 5 6)]
    (e-combine ws ws-len (* 0 sm2))))

(defn kotoba_aiueos_ecdsa_p256_sha256_verify
  [sig sig-length digest digest-length pubkey pubkey-length workspace workspace-length]
  (if (< workspace-length 2048) 0
    (let [sg (kernel-subregion sig sig-length 0 64) dg (kernel-subregion digest digest-length 0 32)
          pk (kernel-subregion pubkey pubkey-length 0 64) ws (kernel-subregion workspace workspace-length 0 2048)]
    (let [lr (e-load-r sg 64 ws 2048 0)
          ls (e-load-s sg 64 ws 2048 (* 0 lr))
          le (e-load-e dg 32 ws 2048 (* 0 ls))
          lqx (e-load-qx pk 64 ws 2048 (* 0 le))
          lqy (e-load-qy pk 64 ws 2048 (* 0 lqx))
          fn (e-fill ws 2048 27 1 (* 0 lqy))
          fp (e-fill ws 2048 28 0 (* 0 fn))
          gx (e-fill ws 2048 13 2 (* 0 fp))
          gy (e-fill ws 2048 14 3 (* 0 gx))
          ok-r (e-in-range ws 2048 2)
          ok-s (e-in-range ws 2048 3)]
      (if (= (+ ok-r (+ ok-s (* 0 gy))) 2)
        (e-verify-rest ws 2048)
        0)))))
