(ns aiueos.ecdsa-p256
  (:export [aiueos-ecdsa-p256-sha256-verify main]))

;; Bounded ECDSA P-256 / SHA-256 admission for TLS 1.3 CertificateVerify.
;; ABI: [sig-64 r||s-BE, digest-32, pubkey-64 Qx||Qy-BE, workspace, workspace-length]
;; returns 1 admit / 0 refuse. Workspace must be 2048 bytes.
;;
;; 16 little-endian u16 limbs per 256-bit integer. 16-bit limbs keep every
;; partial product inside signed i64 (x25519.kotoba). let-substitution staging
;; follows rsa2048.kotoba. Five-parameter ceiling.
;;
;; RFC 6979 A.2.5 SHA-256 "sample" must admit; the same vector with s+1 must
;; refuse. PKCS#1 RSA is the wrong scheme for TLS 1.3 CertVerify.

(defn e-u16 [x] (bit-and x 65535))
(defn e-pow2 [n] (if (<= n 0) 1 (* 2 (e-pow2 (- n 1)))))

(defn e-limb [ws slot i]
  (+ (kernel-load-u8-4k ws 2048 (+ (* slot 32) (* 2 i)))
     (* 256 (kernel-load-u8-4k ws 2048 (+ (* slot 32) (+ (* 2 i) 1))))))

(defn e-put [ws slot i v]
  (+ (kernel-store-u8-4k ws 2048 (+ (* slot 32) (* 2 i)) (bit-and v 255))
     (* 0 (kernel-store-u8-4k ws 2048 (+ (* slot 32) (+ (* 2 i) 1))
                              (bit-and (quot v 256) 255)))))

(defn e-copy [ws dst src i]
  (if (= i 16) 1
    (e-copy ws dst src (+ i 1 (* 0 (e-put ws dst i (e-limb ws src i)))))))

(defn e-zero [ws slot i]
  (if (= i 16) 1
    (e-zero ws slot (+ i 1 (* 0 (e-put ws slot i 0))))))

(defn e-p-limb [i]
  (if (= i 0) 65535 (if (= i 1) 65535 (if (= i 2) 65535 (if (= i 3) 65535
  (if (= i 4) 65535 (if (= i 5) 65535 (if (= i 6) 0 (if (= i 7) 0
  (if (= i 8) 0 (if (= i 9) 0 (if (= i 10) 0 (if (= i 11) 0
  (if (= i 12) 1 (if (= i 13) 0 (if (= i 14) 65535 65535))))))))))))))))

(defn e-n-limb [i]
  (if (= i 0) 9553 (if (= i 1) 64611 (if (= i 2) 51906 (if (= i 3) 62393
  (if (= i 4) 40580 (if (= i 5) 42775 (if (= i 6) 64173 (if (= i 7) 48358
  (if (= i 8) 65535 (if (= i 9) 65535 (if (= i 10) 65535 (if (= i 11) 65535
  (if (= i 12) 0 (if (= i 13) 0 (if (= i 14) 65535 65535))))))))))))))))

(defn e-gx-limb [i]
  (if (= i 0) 49814 (if (= i 1) 55448 (if (= i 2) 14661 (if (= i 3) 62625
  (if (= i 4) 13216 (if (= i 5) 11755 (if (= i 6) 32129 (if (= i 7) 30467
  (if (= i 8) 16626 (if (= i 9) 25508 (if (= i 10) 59109 (if (= i 11) 63676
  (if (= i 12) 16967 (if (= i 13) 57644 (if (= i 14) 53746 27415))))))))))))))))

(defn e-gy-limb [i]
  (if (= i 0) 20981 (if (= i 1) 14271 (if (= i 2) 16488 (if (= i 3) 52150
  (if (= i 4) 24270 (if (= i 5) 27441 (if (= i 6) 13143 (if (= i 7) 11214
  (if (= i 8) 40470 (if (= i 9) 31759 (if (= i 10) 60234 (if (= i 11) 36583
  (if (= i 12) 32667 (if (= i 13) 65050 (if (= i 14) 17122 20451))))))))))))))))

(defn e-p2-limb [i]
  (if (= i 0) 65533 (if (= i 1) 65535 (if (= i 2) 65535 (if (= i 3) 65535
  (if (= i 4) 65535 (if (= i 5) 65535 (if (= i 6) 0 (if (= i 7) 0
  (if (= i 8) 0 (if (= i 9) 0 (if (= i 10) 0 (if (= i 11) 0
  (if (= i 12) 1 (if (= i 13) 0 (if (= i 14) 65535 65535))))))))))))))))

(defn e-n2-limb [i]
  (if (= i 0) 9551 (if (= i 1) 64611 (if (= i 2) 51906 (if (= i 3) 62393
  (if (= i 4) 40580 (if (= i 5) 42775 (if (= i 6) 64173 (if (= i 7) 48358
  (if (= i 8) 65535 (if (= i 9) 65535 (if (= i 10) 65535 (if (= i 11) 65535
  (if (= i 12) 0 (if (= i 13) 0 (if (= i 14) 65535 65535))))))))))))))))

;; 2^256 ≡ POLY (mod p). POLY = 2^224 - 2^192 - 2^96 + 1.
(defn e-poly-limb [i]
  (if (= i 0) 1
    (if (< i 6) 0
      (if (< i 12) 65535
        (if (= i 12) 65534
          (if (= i 13) 65535 0))))))

(defn e-fill [ws slot kind i]
  (if (= i 16) 1
    (let [v (if (= kind 0) (e-p-limb i)
              (if (= kind 1) (e-n-limb i)
                (if (= kind 2) (e-gx-limb i)
                  (if (= kind 3) (e-gy-limb i)
                    (if (= kind 4) (e-p2-limb i)
                      (if (= kind 5) (e-n2-limb i)
                        (e-poly-limb i)))))))]
      (e-fill ws slot kind (+ i 1 (* 0 (e-put ws slot i v)))))))

(defn e-load-r [sig ws i]
  (if (= i 16) 1
    (let [bo (- 31 (* 2 i))
          v (+ (kernel-load-u8-4k sig 64 bo)
               (* 256 (kernel-load-u8-4k sig 64 (- bo 1))))]
      (e-load-r sig ws (+ i 1 (* 0 (e-put ws 2 i v)))))))

(defn e-load-s [sig ws i]
  (if (= i 16) 1
    (let [bo (- 63 (* 2 i))
          v (+ (kernel-load-u8-4k sig 64 bo)
               (* 256 (kernel-load-u8-4k sig 64 (- bo 1))))]
      (e-load-s sig ws (+ i 1 (* 0 (e-put ws 3 i v)))))))

(defn e-load-e [digest ws i]
  (if (= i 16) 1
    (let [bo (- 31 (* 2 i))
          v (+ (kernel-load-u8-4k digest 32 bo)
               (* 256 (kernel-load-u8-4k digest 32 (- bo 1))))]
      (e-load-e digest ws (+ i 1 (* 0 (e-put ws 4 i v)))))))

(defn e-load-qx [pub ws i]
  (if (= i 16) 1
    (let [bo (- 31 (* 2 i))
          v (+ (kernel-load-u8-4k pub 64 bo)
               (* 256 (kernel-load-u8-4k pub 64 (- bo 1))))]
      (e-load-qx pub ws (+ i 1 (* 0 (e-put ws 5 i v)))))))

(defn e-load-qy [pub ws i]
  (if (= i 16) 1
    (let [bo (- 63 (* 2 i))
          v (+ (kernel-load-u8-4k pub 64 bo)
               (* 256 (kernel-load-u8-4k pub 64 (- bo 1))))]
      (e-load-qy pub ws (+ i 1 (* 0 (e-put ws 6 i v)))))))

(defn e-cmp [ws a b i]
  (if (= i -1) 0
    (let [va (e-limb ws a i) vb (e-limb ws b i)]
      (if (> va vb) 1
        (if (< va vb) -1
          (e-cmp ws a b (- i 1)))))))

(defn e-is-zero [ws slot i]
  (if (= i 16) 1
    (if (= (e-limb ws slot i) 0)
      (e-is-zero ws slot (+ i 1))
      0)))

(defn e-sub-mod [ws dst src i borrow]
  (if (= i 16) borrow
    (let [before (e-limb ws dst i)
          sub (+ (e-limb ws src i) borrow)
          wrapped (e-u16 (- (+ before 65536) (e-u16 sub)))
          new-borrow (if (> sub 65535) 1 (if (< before (e-u16 sub)) 1 0))
          staged (e-put ws 25 0 new-borrow)
          stored (e-put ws dst i wrapped)]
      (e-sub-mod ws dst src (+ i 1 (* 0 (+ staged stored)))
                 (e-limb ws 25 0)))))

(defn e-add-limbs [ws dst src i carry]
  (if (= i 16) carry
    (let [sum (+ (e-limb ws dst i) (+ (e-limb ws src i) carry))
          staged (e-put ws 25 0 (quot sum 65536))
          stored (e-put ws dst i (e-u16 sum))]
      (e-add-limbs ws dst src (+ i 1 (* 0 (+ staged stored)))
                   (e-limb ws 25 0)))))

(defn e-add-mod [ws dst src mod-slot]
  (let [carry (e-add-limbs ws dst src 0 0)]
    (if (> carry 0)
      (e-sub-mod ws dst mod-slot 0 0)
      (if (>= (e-cmp ws dst mod-slot 15) 0)
        (e-sub-mod ws dst mod-slot 0 0)
        0))))

(defn e-sub-field [ws dst src mod-slot]
  (let [borrow (e-sub-mod ws dst src 0 0)]
    (if (> borrow 0)
      (e-add-limbs ws dst mod-slot 0 0)
      0)))

(defn e-prod-put [ws k v]
  (if (< k 16) (e-put ws 23 k v) (e-put ws 24 (- k 16) v)))
(defn e-prod-limb [ws k]
  (if (< k 16) (e-limb ws 23 k) (e-limb ws 24 (- k 16))))
(defn e-prod-clear [ws k]
  (if (= k 32) 1
    (e-prod-clear ws (+ k 1 (* 0 (e-prod-put ws k 0))))))

(defn e-mul-inner [ws i j carry]
  (if (= j 16)
    (e-prod-put ws (+ i 16) carry)
    (let [acc (+ (e-prod-limb ws (+ i j))
                 (+ (* (e-limb ws 0 i) (e-limb ws 1 j)) carry))
          stored (e-prod-put ws (+ i j) (e-u16 acc))]
      (e-mul-inner ws i (+ j 1 (* 0 stored)) (quot acc 65536)))))

(defn e-mul-outer [ws i]
  (if (= i 16) 1
    (e-mul-outer ws (+ i 1 (* 0 (e-mul-inner ws i 0 0))))))

;; NIST P-256 Solinas (FIPS 186-4 D.2.5) on 16-bit limbs. Word-reduce is
;; ~32 scale/sub steps per mul; this is 9 signed adds. Host oracle: 500
;; random products + 200 full 512-bit values, extras in [-3,2]. Slot 18
;; holds POLY during fold. Extra lives in slot 25 limb 3 as 32768+extra.
;; Index 32 means a zero limb of an s-vector.
(defn e-s2-idx [i] (if (< i 6) 32 (+ i 16)))
(defn e-s3-idx [i] (if (< i 6) 32 (if (< i 14) (+ i 18) 32)))
(defn e-s4-idx [i] (if (< i 6) (+ i 16) (if (< i 12) 32 (+ i 16))))
(defn e-s5-idx [i]
  (if (< i 6) (+ i 18)
    (if (< i 12) (+ i 20)
      (if (< i 14) (+ i 14) (+ i 2)))))
(defn e-s6-idx [i]
  (if (< i 6) (+ i 22)
    (if (< i 12) 32
      (if (< i 14) (+ i 4) (+ i 6)))))
(defn e-s7-idx [i]
  (if (< i 8) (+ i 24)
    (if (< i 12) 32
      (if (< i 14) (+ i 6) (+ i 8)))))
(defn e-s8-idx [i]
  (if (< i 6) (+ i 26)
    (if (< i 12) (+ i 10)
      (if (< i 14) 32 (+ i 10)))))
(defn e-s9-idx [i]
  (if (< i 4) (+ i 28)
    (if (< i 6) 32
      (if (< i 12) (+ i 12)
        (if (< i 14) 32 (+ i 12))))))

(defn e-s-idx [which i]
  (if (= which 1) i
    (if (= which 2) (e-s2-idx i)
      (if (= which 3) (e-s3-idx i)
        (if (= which 4) (e-s4-idx i)
          (if (= which 5) (e-s5-idx i)
            (if (= which 6) (e-s6-idx i)
              (if (= which 7) (e-s7-idx i)
                (if (= which 8) (e-s8-idx i)
                  (e-s9-idx i))))))))))

(defn e-s-limb [ws which i]
  (let [idx (e-s-idx which i)]
    (if (= idx 32) 0 (e-prod-limb ws idx))))

(defn e-get-extra [ws] (- (e-limb ws 25 3) 32768))
(defn e-set-extra [ws x] (e-put ws 25 3 (+ x 32768)))

(defn e-acc-add-s [ws which i carry]
  (if (= i 16)
    (e-set-extra ws (+ (e-get-extra ws) carry))
    (let [sum (+ (e-limb ws 22 i) (+ (e-s-limb ws which i) carry))
          staged (e-put ws 25 0 (quot sum 65536))
          stored (e-put ws 22 i (e-u16 sum))]
      (e-acc-add-s ws which (+ i 1 (* 0 (+ staged stored)))
                   (e-limb ws 25 0)))))

(defn e-acc-sub-s [ws which i borrow]
  (if (= i 16)
    (e-set-extra ws (- (e-get-extra ws) borrow))
    (let [before (e-limb ws 22 i)
          sub (+ (e-s-limb ws which i) borrow)
          wrapped (e-u16 (- (+ before 65536) (e-u16 sub)))
          new-borrow (if (> sub 65535) 1 (if (< before (e-u16 sub)) 1 0))
          staged (e-put ws 25 0 new-borrow)
          stored (e-put ws 22 i wrapped)]
      (e-acc-sub-s ws which (+ i 1 (* 0 (+ staged stored)))
                   (e-limb ws 25 0)))))

(defn e-fold-poly [ws]
  (let [ex (e-get-extra ws)]
    (if (= ex 0)
      (e-canon-word ws 28 0)
      (if (> ex 0)
        (let [c (e-add-limbs ws 22 18 0 0)
              st (e-set-extra ws (+ (- ex 1) c))]
          (e-fold-poly ws))
        (let [b (e-sub-mod ws 22 18 0 0)
              st (e-set-extra ws (- (+ ex 1) b))]
          (e-fold-poly ws))))))

(defn e-reduce-p [ws z]
  (let [zr (e-zero ws 22 (* 0 z))
        ex (e-set-extra ws (* 0 zr))
        py (e-fill ws 18 6 (* 0 ex))
        a1 (e-acc-add-s ws 1 0 (* 0 py))
        a2 (e-acc-add-s ws 2 0 (* 0 a1))
        a2b (e-acc-add-s ws 2 0 (* 0 a2))
        a3 (e-acc-add-s ws 3 0 (* 0 a2b))
        a3b (e-acc-add-s ws 3 0 (* 0 a3))
        a4 (e-acc-add-s ws 4 0 (* 0 a3b))
        a5 (e-acc-add-s ws 5 0 (* 0 a4))
        s6 (e-acc-sub-s ws 6 0 (* 0 a5))
        s7 (e-acc-sub-s ws 7 0 (* 0 s6))
        s8 (e-acc-sub-s ws 8 0 (* 0 s7))
        s9 (e-acc-sub-s ws 9 0 (* 0 s8))]
    (e-fold-poly ws)))

;; 16-bit word reduction: 32 steps instead of 512 bit-serial steps.
;; Bit-serial exhausted 180s of TCG before RFC 6979 returned (Jacobian
;; formulas were already correct on a host oracle). Slot 17 holds q*mod.
(defn e-shl16-from [ws i]
  (if (= i 0) 1
    (let [v (e-limb ws 22 (- i 1))
          st (e-put ws 22 i v)]
      (e-shl16-from ws (- i (+ 1 (* 0 st)))))))

(defn e-shl16-insert [ws incoming]
  (let [sh (e-shl16-from ws 15)
        lo (e-put ws 22 0 incoming)]
    (* 0 (+ sh lo))))

(defn e-scale-u16 [ws mod-slot q i carry]
  (if (= i 16)
    (e-put ws 25 2 carry)
    (let [acc (+ (* q (e-limb ws mod-slot i)) carry)
          st (e-put ws 17 i (e-u16 acc))]
      (e-scale-u16 ws mod-slot q (+ i 1 (* 0 st)) (quot acc 65536)))))

(defn e-sub-scaled [ws i borrow]
  (if (= i 16) borrow
    (let [before (e-limb ws 22 i)
          sub (+ (e-limb ws 17 i) borrow)
          wrapped (e-u16 (- (+ before 65536) (e-u16 sub)))
          new-borrow (if (> sub 65535) 1 (if (< before (e-u16 sub)) 1 0))
          staged (e-put ws 25 0 new-borrow)
          stored (e-put ws 22 i wrapped)]
      (e-sub-scaled ws (+ i 1 (* 0 (+ staged stored))) (e-limb ws 25 0)))))

(defn e-canon-word [ws mod-slot extra]
  (if (< extra 0)
    (let [c (e-add-limbs ws 22 mod-slot 0 0)]
      (e-canon-word ws mod-slot (+ extra c)))
    (if (> extra 0)
      (let [b (e-sub-mod ws 22 mod-slot 0 0)]
        (e-canon-word ws mod-slot (- extra b)))
      (if (>= (e-cmp ws 22 mod-slot 15) 0)
        (let [b2 (e-sub-mod ws 22 mod-slot 0 0)]
          (e-canon-word ws mod-slot (* 0 b2)))
        1))))

(defn e-reduce-word [ws mod-slot k]
  (if (= k -1) 1
    (let [top (e-limb ws 22 15)
          ins (e-shl16-insert ws (e-prod-limb ws k))
          sc (e-scale-u16 ws mod-slot top 0 (* 0 ins))
          b (e-sub-scaled ws (* 0 sc) 0)
          extra (- top (+ (e-limb ws 25 2) b))
          cn (e-canon-word ws mod-slot extra)]
      (e-reduce-word ws mod-slot (- k (+ 1 (* 0 cn)))))))

(defn e-mul-mod [ws dst left right mod-slot]
  (let [c0 (e-copy ws 0 left 0)
        c1 (e-copy ws 1 right (* 0 c0))
        cl (e-prod-clear ws (* 0 c1))
        mu (e-mul-outer ws (* 0 cl))]
    (if (= mod-slot 28)
      (let [rd (e-reduce-p ws (* 0 mu))]
        (e-copy ws dst 22 (* 0 rd)))
      (let [zr (e-zero ws 22 (* 0 mu))
            rd (e-reduce-word ws mod-slot (+ 31 (* 0 zr)))]
        (e-copy ws dst 22 (* 0 rd))))))

(defn e-sqr-mod [ws dst src mod-slot]
  (e-mul-mod ws dst src src mod-slot))

(defn e-exp-bit [ws bit]
  (let [limb (quot bit 16) within (- bit (* limb 16))]
    (bit-and (quot (e-limb ws 21 limb) (e-pow2 within)) 1)))

(defn e-exp-loop [ws dst mod-slot bit]
  (if (= bit -1) (e-copy ws dst 15 0)
    (let [sq (e-sqr-mod ws 16 15 mod-slot)
          cp (e-copy ws 15 16 (* 0 sq))
          mul (if (= (e-exp-bit ws bit) 1)
                (let [pr (e-mul-mod ws 16 15 20 mod-slot)]
                  (e-copy ws 15 16 (* 0 pr)))
                (* 0 cp))]
      (e-exp-loop ws dst mod-slot (- bit (+ 1 (* 0 mul)))))))

(defn e-inv-mod [ws dst src mod-slot p?]
  (let [b (e-copy ws 20 src 0)
        e (if (= p? 1) (e-fill ws 21 4 0) (e-fill ws 21 5 0))
        one (e-zero ws 15 (* 0 e))
        s1 (e-put ws 15 0 (+ 1 (* 0 one)))]
    (e-exp-loop ws dst mod-slot (+ 255 (* 0 (+ b s1))))))

;; Jacobian (X:Y:Z) in slots 10/11/29. Affine used 256 Fermat inverses and
;; exhausted even the imm32 fuel ceiling (vector 6). One inverse at the end.
;; Temps 30-47. inv-mod still owns 15/16/20/21. p is slot 28.

(defn e-dbl-val [ws slot]
  (e-add-mod ws slot slot 28))

(defn e-jac-inf? [ws]
  (e-is-zero ws 29 0))

(defn e-jac-set-inf [ws]
  (let [zx (e-zero ws 10 0)
        zy (e-zero ws 11 (* 0 zx))]
    (e-zero ws 29 (* 0 zy))))

(defn e-jac-from-aff [ws bx by-slot]
  (let [cx (e-copy ws 10 bx 0)
        cy (e-copy ws 11 by-slot (* 0 cx))
        z0 (e-zero ws 29 (* 0 cy))
        z1 (e-put ws 29 0 1)]
    (* 0 z1)))

;; dbl-2001-b for a = -3. Acc (10,11,29).
(defn e-dbl-jac [ws]
  (if (= (e-jac-inf? ws) 1) 1
    (if (= (e-is-zero ws 11 0) 1)
      (e-jac-set-inf ws)
      (let [d (e-sqr-mod ws 30 29 28)
            g (e-sqr-mod ws 31 11 28)
            b (e-mul-mod ws 32 10 31 28)
            xd (e-copy ws 33 10 (* 0 b))
            s1 (e-sub-field ws 33 30 28)
            xp (e-copy ws 34 10 (* 0 s1))
            a1 (e-add-mod ws 34 30 28)
            pr (e-mul-mod ws 35 33 34 28)
            al (e-copy ws 36 35 (* 0 pr))
            t1 (e-add-mod ws 36 35 28)
            t2 (e-add-mod ws 36 35 28)
            as (e-sqr-mod ws 37 36 28)
            bb (e-copy ws 38 32 (* 0 as))
            m2 (e-dbl-val ws 38)
            m4 (e-dbl-val ws 38)
            m8 (e-dbl-val ws 38)
            x3 (e-copy ws 47 37 (* 0 m8))
            sx (e-sub-field ws 47 38 28)
            yz (e-copy ws 39 11 (* 0 sx))
            az (e-add-mod ws 39 29 28)
            yz2 (e-sqr-mod ws 40 39 28)
            z3 (e-copy ws 41 40 (* 0 yz2))
            sg (e-sub-field ws 41 31 28)
            sd (e-sub-field ws 41 30 28)
            b4 (e-copy ws 42 32 (* 0 sd))
            d1 (e-dbl-val ws 42)
            d2 (e-dbl-val ws 42)
            vm (e-copy ws 43 42 (* 0 d2))
            sv (e-sub-field ws 43 47 28)
            ar (e-mul-mod ws 44 36 43 28)
            gg (e-sqr-mod ws 45 31 28)
            g8 (e-copy ws 46 45 (* 0 gg))
            e1 (e-dbl-val ws 46)
            e2 (e-dbl-val ws 46)
            e3 (e-dbl-val ws 46)
            y3 (e-copy ws 11 44 (* 0 e3))
            sy (e-sub-field ws 11 46 28)
            cx (e-copy ws 10 47 (* 0 sy))
            cz (e-copy ws 29 41 (* 0 cx))]
        (* 0 cz)))))

(defn e-madd-jac [ws bx by-slot]
  (if (= (e-jac-inf? ws) 1)
    (e-jac-from-aff ws bx by-slot)
    (let [z2 (e-sqr-mod ws 30 29 28)
          u2 (e-mul-mod ws 31 bx 30 28)
          z3 (e-mul-mod ws 32 29 30 28)
          s2 (e-mul-mod ws 33 by-slot 32 28)
          h (e-copy ws 34 31 (* 0 s2))
          sh (e-sub-field ws 34 10 28)
          hh (e-sqr-mod ws 35 34 28)]
      (if (= (e-is-zero ws 34 0) 1)
        (if (= (e-cmp ws 33 11 15) 0)
          (e-dbl-jac ws)
          (e-jac-set-inf ws))
        (let [i (e-copy ws 36 35 0)
              i2 (e-dbl-val ws 36)
              i4 (e-dbl-val ws 36)
              j (e-mul-mod ws 37 34 36 28)
              r (e-copy ws 38 33 (* 0 j))
              sr (e-sub-field ws 38 11 28)
              r2 (e-dbl-val ws 38)
              v (e-mul-mod ws 39 10 36 28)
              rr (e-sqr-mod ws 40 38 28)
              x3 (e-copy ws 47 40 (* 0 rr))
              sj (e-sub-field ws 47 37 28)
              v2 (e-copy ws 41 39 (* 0 sj))
              dv (e-dbl-val ws 41)
              sv (e-sub-field ws 47 41 28)
              vm (e-copy ws 42 39 (* 0 sv))
              svm (e-sub-field ws 42 47 28)
              ry (e-mul-mod ws 43 38 42 28)
              yj (e-mul-mod ws 44 11 37 28)
              yj2 (e-dbl-val ws 44)
              y3 (e-copy ws 11 43 (* 0 yj2))
              sy (e-sub-field ws 11 44 28)
              zh (e-copy ws 45 29 (* 0 sy))
              ah (e-add-mod ws 45 34 28)
              zh2 (e-sqr-mod ws 46 45 28)
              nz (e-copy ws 29 46 (* 0 zh2))
              sz (e-sub-field ws 29 30 28)
              shh (e-sub-field ws 29 35 28)
              cx (e-copy ws 10 47 (* 0 shh))]
          (* 0 cx))))))

(defn e-scalar-bit [ws k-slot bit]
  (let [limb (quot bit 16) within (- bit (* limb 16))]
    (bit-and (quot (e-limb ws k-slot limb) (e-pow2 within)) 1)))

(defn e-scalarmul [ws k-slot bx by-slot bit]
  (if (= bit -1) 1
    (let [d (e-dbl-jac ws)
          a (if (= (e-scalar-bit ws k-slot bit) 1)
              (e-madd-jac ws bx by-slot)
              (* 0 d))]
      (e-scalarmul ws k-slot bx by-slot (- bit (+ 1 (* 0 a)))))))

(defn e-to-affine [ws]
  (if (= (e-jac-inf? ws) 1) 1
    (let [zi (e-inv-mod ws 43 29 28 1)
          z2 (e-sqr-mod ws 44 43 28)
          xa (e-mul-mod ws 10 10 44 28)
          z3 (e-mul-mod ws 45 44 43 28)
          ya (e-mul-mod ws 11 11 45 28)
          zo (e-zero ws 29 (* 0 ya))
          z1 (e-put ws 29 0 1)]
      (* 0 z1))))

(defn e-in-range [ws slot]
  (if (= (e-is-zero ws slot 0) 1) 0
    (if (>= (e-cmp ws slot 27 15) 0) 0 1)))

(defn e-finish [ws gate]
  (if (= (+ (e-jac-inf? ws) (* 0 gate)) 1) 0
    (let [af (e-to-affine ws)
          fn (e-fill ws 27 1 (* 0 af))
          one (e-zero ws 20 (* 0 fn))
          o1 (e-put ws 20 0 (+ 1 (* 0 one)))
          xn (e-mul-mod ws 22 10 20 27)]
      (if (= (e-cmp ws 22 2 15) 0) 1 0))))

(defn e-combine [ws gate]
  (let [ia (kernel-load-u8-4k ws 2048 2045)
        ib (+ (e-jac-inf? ws) (* 0 gate))]
    (if (= ib 1)
      (if (= ia 1) 0
        (let [rx (e-copy ws 10 12 0)
              ry (e-copy ws 11 26 (* 0 rx))
              rz (e-copy ws 29 48 (* 0 ry))]
          (e-finish ws (* 0 rz))))
      (if (= ia 1)
        (e-finish ws 0)
        (let [ad (e-madd-jac ws 12 26)]
          (e-finish ws (* 0 ad)))))))

(defn e-verify-rest [ws]
  (let [w (e-inv-mod ws 7 3 27 0)
        u1 (e-mul-mod ws 8 4 7 27)
        u2 (e-mul-mod ws 9 2 7 27)
        inf0 (e-jac-set-inf ws)
        sm1 (e-scalarmul ws 8 13 14 (+ 255 (* 0 inf0)))
        af1 (e-to-affine ws)
        cax (e-copy ws 12 10 (* 0 af1))
        cay (e-copy ws 26 11 (* 0 cax))
        caz (e-copy ws 48 29 (* 0 cay))
        ia (kernel-store-u8-4k ws 2048 2045 (e-jac-inf? ws))
        inf1 (e-jac-set-inf ws)
        sm2 (e-scalarmul ws 9 5 6 (+ 255 (* 0 (+ ia inf1))))]
    (e-combine ws (* 0 sm2))))

(defn aiueos-ecdsa-p256-sha256-verify
  [sig digest pubkey workspace workspace-length]
  (if (< workspace-length 2048) 0
    (let [lr (e-load-r sig workspace 0)
          ls (e-load-s sig workspace (* 0 lr))
          le (e-load-e digest workspace (* 0 ls))
          lqx (e-load-qx pubkey workspace (* 0 le))
          lqy (e-load-qy pubkey workspace (* 0 lqx))
          fn (e-fill workspace 27 1 (* 0 lqy))
          fp (e-fill workspace 28 0 (* 0 fn))
          gx (e-fill workspace 13 2 (* 0 fp))
          gy (e-fill workspace 14 3 (* 0 gx))
          ok-r (e-in-range workspace 2)
          ok-s (e-in-range workspace 3)]
      (if (= (+ ok-r (+ ok-s (* 0 gy))) 2)
        (e-verify-rest workspace)
        0))))

(defn main [] 0)
