;; One step of kbd_recycle's used-ring reap of kernel/pci.c in Kotoba (JUN-598): the virtio keyboard's four-slot
;; eventq, each ring one 4 KiB page (struct virtq_used / virtq_avail / virtio_input_event, packed, little-endian).
;;
;; reap(used, 4096, avail, 4096, event, 4096, state): state is the driver's next used position (`seen`, bits 0..15) and
;; what it wants back (bits 16..17: 1 the first key press, 2 the first key event of any value, 0 nothing). Reads the id
;; of used element seen % 4 (u32 @4 + 8*slot). An id past 3 names no buffer of this queue and is skipped: answers 1,
;; nothing written. Otherwise reads that event (type u16 @8*id, code u16 @+2, value u32 @+4) and hands the buffer back
;; -- available ring[index % 4] = id (u16 @4 + 2*slot), then the available index + 1 (u16 @2), in that order, so the
;; device never sees an index before its ring entry -- and answers 2 | key << 2: key is the code of a press (type 1,
;; value 1, code not 0) when want is 1, code * 4 + value of a key event (type 1, value 0..2, code not 0) when want is
;; 2, else 0. Answers 0 with nothing read or written for a null pointer, a wrong length or a state past 18 bits.
(ns aiueos.kbd-reap (:export [kotoba_aiueos_kbd_reap]))
(defn- key-of [e :i64 en :i64 id :i64 want :i64] :i64
  (let [at (* id 8) kind (kernel-load-u16-16k e en at) code (kernel-load-u16-16k e en (+ at 2))
        value (kernel-load-u32-16k e en (+ at 4))]
    (cond (or (not= kind 1) (= code 0)) 0
          (and (= want 1) (= value 1)) code
          (and (= want 2) (<= value 2)) (+ (* code 4) value)
          :else 0)))
(defn- hand-back [a :i64 an :i64 id :i64] :i64
  (let [index (kernel-load-u16-16k a an 2)
        w1 (kernel-store-u16-16k a an (+ 4 (* 2 (bit-and index 3))) id)
        w2 (kernel-store-u16-16k a an 2 (bit-and (+ index 1) 65535))]
    (+ w1 w2)))
(defn- step [u un e en state] :i64
  (let [id (kernel-load-u32-16k u un (+ 4 (* 8 (bit-and state 3))))]
    (if (> id 3) -1 (+ (* id 1048576) (key-of e en id (u64-shift-right state 16))))))
(defn kotoba_aiueos_kbd_reap [used :i64 un :i64 avail :i64 an :i64 event :i64 en :i64 state :i64] :i64
  (if (or (= used 0) (= avail 0) (= event 0) (not= un 4096) (not= an 4096) (not= en 4096) (< state 0) (> state 262143)) 0
    (let [s (step used un event en state)]
      (if (< s 0) 1
        (let [w (hand-back avail an (u64-shift-right s 20))] (+ (+ 2 (* 0 w)) (* 4 (bit-and s 1048575))))))))
