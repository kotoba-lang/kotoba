;; kernel/tls_aes_gcm.c in Kotoba (JUN-556): the marshalling between the AEAD object and its kernel callers, and nothing
;; else. The cipher is kotoba_aiueos_aes128_gcm (aes128-gcm.kotoba, ADR-0132); the boot known-answer test is
;; kotoba_aiueos_aes128_gcm_selftest (aes128-gcm-selftest.kotoba, ADR-0220).
;;
;; The same two shapes as the C, and the same inversion in one place:
;; * the AEAD object returns a reason code with 0 for success; these entry points return 1 for success, because
;;   tls13.c and pci.c read `if (!aes(...)) return 0;`;
;; * the AEAD object works in place on one region, so the input is first copied to the output;
;; * it authenticates before it decrypts: a refused record leaves the ciphertext in the output.
;;
;; The 1280-byte context is .bss array 0 and the 1536-byte self-test scratch is .high_bss array 0 (amu ADR 0385); both
;; are handed to externs, never read here. Byte copy and fill are aiueos.bytes (bytes.kotoba). C passes uint32_t
;; lengths in 64-bit registers whose upper half is unspecified, so every length is masked to 32 bits first.
(ns aiueos.tls-aes-gcm
  (:export [aiueos_aes128_gcm_encrypt aiueos_aes128_gcm_decrypt aiueos_aes128_gcm_unwrap aiueos_aes128_gcm_selftest]))
(defn- extern-kotoba_aiueos_aes128_gcm [ctx :i64 n :i64 data :i64 len :i64 seal :i64] :i64 0)
(defn- extern-kotoba_aiueos_aes128_gcm_selftest [scratch :i64 n :i64] :i64 0)
(defn- extern-kotoba_aiueos_bytes_copy [d :i64 dn :i64 s :i64 sn :i64] :i64 0)
(defn- extern-kotoba_aiueos_bytes_fill [d :i64 dn :i64 v :i64] :i64 0)
(defn- bss-addr-0-1280 [] :i64 0)
(defn- highbss-addr-0-1536 [] :i64 0)
(defn- u32 [x :i64] :i64 (bit-and x 4294967295))
(defn- copy [d :i64 s :i64 n :i64] :i64 (extern-kotoba_aiueos_bytes_copy d n s n))
;; key@0, nonce@16, aad length@28, tag@32, aad@64 (aes128-gcm.kotoba's header); everything else zero
(defn- setup [key :i64 nonce :i64 aad :i64 aad-len :i64] :i64
  (let [ctx (bss-addr-0-1280)
        a (extern-kotoba_aiueos_bytes_fill ctx 1280 0)
        b (copy ctx key 16)
        c (copy (+ ctx 16) nonce 12)
        d (extern-kotoba_aiueos_bytes_fill (+ ctx 28) 1 aad-len)]
    (+ (+ a b) (+ c (+ d (copy (+ ctx 64) aad aad-len))))))
(defn aiueos_aes128_gcm_encrypt [key :i64 nonce :i64 aad :i64 aad-len :i64 pt :i64 pt-len :i64 ct :i64 tag :i64] :i64
  (let [al (u32 aad-len) n (u32 pt-len)]
    (if (> al 64) 0
      (let [a (copy ct pt n)
            b (setup key nonce aad al)
            r (extern-kotoba_aiueos_aes128_gcm (bss-addr-0-1280) 1280 ct n 1)]
        (if (not= (+ r (* 0 (+ a b))) 0) 0
          (let [c (copy tag (+ (bss-addr-0-1280) 32) 16)] (+ 1 (* 0 c))))))))
(defn aiueos_aes128_gcm_decrypt [key :i64 nonce :i64 aad :i64 aad-len :i64 ct :i64 ct-len :i64 tag :i64 pt :i64] :i64
  (let [al (u32 aad-len) n (u32 ct-len)]
    (if (> al 64) 0
      (let [a (copy pt ct n)
            b (setup key nonce aad al)
            c (copy (+ (bss-addr-0-1280) 32) tag 16)
            r (extern-kotoba_aiueos_aes128_gcm (bss-addr-0-1280) 1280 pt n 0)]
        (if (= (+ r (* 0 (+ a (+ b c)))) 0) 1 0)))))
;; G3's sector wrap carries no tag: the CTR keystream is its own inverse, so unwrapping is the sealer over the
;; ciphertext with the computed tag discarded (see the C's comment).
(defn aiueos_aes128_gcm_unwrap [key :i64 nonce :i64 ct :i64 ct-len :i64 pt :i64] :i64
  (let [n (u32 ct-len)
        a (copy pt ct n)
        b (setup key nonce 0 0)
        r (extern-kotoba_aiueos_aes128_gcm (bss-addr-0-1280) 1280 pt n 1)]
    (if (= (+ r (* 0 (+ a b))) 0) 1 0)))
(defn aiueos_aes128_gcm_selftest [] :i64
  (let [s (highbss-addr-0-1536)
        a (extern-kotoba_aiueos_bytes_fill s 1536 0)
        r (extern-kotoba_aiueos_aes128_gcm_selftest s 1536)]
    (if (= (+ r (* 0 a)) 0) 1 0)))
