;; net_build_dhcp of kernel/pci.c in Kotoba (JUN-552): the DHCP DISCOVER / REQUEST frame.
;;
;; build(frame, n, mac, mac-len, type, requested, server): n must be 346 and mac-len 6 (our MAC), else nothing is
;; written and the answer is 0; otherwise frame[0..346) is written and the answer is 346, the C's 14 + total. The frame
;; is the C's: zeroed, broadcast from our MAC, IPv4 version 4 IHL 5, total 332, identification 0, DF, TTL 64, protocol 17,
;; 0.0.0.0 to 255.255.255.255, UDP 68 to 67, BOOTREQUEST over Ethernet (hlen 6), transaction 0xa1e05dc0, the broadcast
;; flag, our MAC as chaddr, the magic cookie, then option 53 with type's low byte; when type is 3 (REQUEST) options 50
;; (requested) and 54 (server); then the parameter request list 1 3 6 51 and END. Both checksums as
;; kotoba_aiueos_ipv4_checksum answers them, a UDP 0 sent as 0xffff (RFC 768), the pseudo header summed in place.
(ns aiueos.dhcp-build (:export [kotoba_aiueos_dhcp_build]))
(defn- b [f :i64 n :i64 i :i64] :i64 (kernel-load-u8-16k f n i))
(defn- put [f :i64 n :i64 i :i64 v :i64] :i64 (kernel-store-u8-16k f n i (bit-and v 255)))
(defn- put16 [f :i64 n :i64 i :i64 v :i64] :i64 (+ (put f n i (u64-shift-right v 8)) (put f n (+ i 1) v)))
(defn- put32 [f :i64 n :i64 i :i64 v :i64] :i64 (+ (put16 f n i (u64-shift-right v 16)) (put16 f n (+ i 2) (bit-and v 65535))))
(defn- sum16 [w :i64 wn :i64 off :i64 acc :i64] :i64
  (if (>= off wn) acc
    (let [hi (b w wn off) lo (if (>= (+ off 1) wn) 0 (b w wn (+ off 1)))]
      (sum16 w wn (+ off 2) (+ acc (+ (* 256 hi) lo))))))
(defn- fold [t :i64] :i64 (if (< t 65536) t (fold (+ (bit-and t 65535) (quot t 65536)))))
(defn- fill [f :i64 n :i64 at :i64 k :i64 v :i64] :i64
  (if (<= k 0) 0 (let [w (put f n at v)] (fill f n (+ at 1) (- k 1) (+ v (* 0 w))))))
;; frame[at..at+6) = mac[0..6)
(defn- mac [f :i64 n :i64 m :i64 mn :i64 at :i64] :i64
  (+ (+ (+ (put f n at (kernel-load-u8 m mn 0)) (put f n (+ at 1) (kernel-load-u8 m mn 1)))
        (+ (put f n (+ at 2) (kernel-load-u8 m mn 2)) (put f n (+ at 3) (kernel-load-u8 m mn 3))))
     (+ (put f n (+ at 4) (kernel-load-u8 m mn 4)) (put f n (+ at 5) (kernel-load-u8 m mn 5)))))
(defn- head [f :i64 n :i64] :i64
  (let [a1 (put16 f n 12 2048) a2 (put f n 14 69) a3 (put16 f n 16 332) a4 (put16 f n 20 16384) a5 (put f n 22 64)
        a6 (put f n 23 17) a7 (put32 f n 26 0) a8 (put32 f n 30 4294967295)
        b1 (put16 f n 34 68) b2 (put16 f n 36 67) b3 (put16 f n 38 312)
        b4 (put f n 42 1) b5 (put f n 43 1) b6 (put f n 44 6) b7 (put32 f n 46 2715835840) b8 (put16 f n 52 32768)
        b9 (put32 f n 278 1669485411)]
    (+ (+ (+ (+ a1 a2) (+ a3 a4)) (+ (+ a5 a6) (+ a7 a8))) (+ (+ (+ b1 b2) (+ b3 b4)) (+ (+ (+ b5 b6) (+ b7 b8)) b9)))))
;; options from 282; the request list then END at at
(defn- tail [f :i64 n :i64 at :i64] :i64
  (+ (+ (+ (put f n at 55) (put f n (+ at 1) 4)) (+ (put f n (+ at 2) 1) (put f n (+ at 3) 3)))
     (+ (+ (put f n (+ at 4) 6) (put f n (+ at 5) 51)) (put f n (+ at 6) 255))))
;; options 50 and 54 are written only for a REQUEST: for any other type the same bytes get 0 (they are already 0, and
;; the request list then lands at 285 over them), so no store sits in a branch (amu ADR 0373's rooting)
(defn- options [f :i64 n :i64 type :i64 requested :i64 server :i64] :i64
  (let [r (if (= (bit-and type 255) 3) 1 0)
        w1 (+ (+ (put f n 282 53) (put f n 283 1)) (put f n 284 type))
        w2 (+ (+ (+ (put f n 285 (* 50 r)) (put f n 286 (* 4 r))) (put32 f n 287 (* requested r)))
              (+ (+ (put f n 291 (* 54 r)) (put f n 292 (* 4 r))) (put32 f n 293 (* server r))))
        w3 (tail f n (+ 285 (* 12 r)))]
    (+ (+ w1 w2) w3)))
(defn- udp-csum [f :i64 n :i64 ul :i64] :i64
  (let [u (kernel-subregion f n 34 ul)
        c (- 65535 (fold (sum16 u ul 0 (+ (+ 65535 65535) (+ 17 ul)))))]
    (if (= c 0) 65535 c)))
(defn- checksums [f :i64 n :i64] :i64
  (let [h (kernel-subregion f n 14 20) w1 (put16 f n 24 (- 65535 (fold (sum16 h 20 0 0))))
        w2 (put16 f n 40 (udp-csum f n 312))]
    (+ w1 w2)))
(defn kotoba_aiueos_dhcp_build [frame :i64 n :i64 our-mac :i64 mac-len :i64 type :i64 requested :i64 server :i64] :i64
  (if (or (= frame 0) (= our-mac 0) (not= n 346) (not= mac-len 6)
          (not= (u64-shift-right requested 32) 0) (not= (u64-shift-right server 32) 0)) 0
    (let [w0 (fill frame n 0 346 0) w1 (fill frame n 0 6 255) w2 (mac frame n our-mac mac-len 6)
          w3 (head frame n) w4 (mac frame n our-mac mac-len 70)
          w5 (options frame n type requested server) w6 (checksums frame n)]
      (+ 346 (* 0 (+ (+ (+ w0 w1) (+ w2 w3)) (+ (+ w4 w5) w6)))))))
