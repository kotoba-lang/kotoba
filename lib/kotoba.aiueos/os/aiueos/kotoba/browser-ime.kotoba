;; --- keys -------------------------------------------------------------------

(defn letter-of [code]
  ;; Linux evdev key codes, US layout, lower case. 0 for everything else.
  (if (= code 30) 97 (if (= code 48) 98 (if (= code 46) 99 (if (= code 32) 100
  (if (= code 18) 101 (if (= code 33) 102 (if (= code 34) 103 (if (= code 35) 104
  (if (= code 23) 105 (if (= code 36) 106 (if (= code 37) 107 (if (= code 38) 108
  (if (= code 50) 109 (if (= code 49) 110 (if (= code 24) 111 (if (= code 25) 112
  (if (= code 16) 113 (if (= code 19) 114 (if (= code 31) 115 (if (= code 20) 116
  (if (= code 22) 117 (if (= code 47) 118 (if (= code 17) 119 (if (= code 45) 120
  (if (= code 21) 121 (if (= code 44) 122 0)))))))))))))))))))))))))))

;; --- the focused window's body -----------------------------------------------

(defn body-base [s]
  (+ 160 (* 64 (- (w s 2) 1))))

(defn body-len [s base i]
  (if (>= i 64) 64
    (if (= (w s (+ base i)) 0) i
      (body-len s base (+ i 1)))))

(defn copy-preedit [s base at i n]
  (if (>= i n) 0
    (do (wp s (+ base (+ at i)) (w s (+ 446 i)))
        (copy-preedit s base at (+ i 1) n))))

(defn clear-state [s]
  (do (wp s 433 0) (wp s 445 0) (wp s 442 0) (wp s 443 0) (wp s 444 0) 0))

;; --- the body's editing model (ADR-0263) ----------------------------------------
;; The focused body is a run of code points (0 ends it, 10 breaks the line). Until ADR-0263 the caret was
;; always at its end and a selection was the last k code points. Now the caret is an index:
;;   word 2004  window id * 128 + caret + 1 of the window it belongs to; 0 (or another window's) = the end
;;   word 2005  the selection's anchor + 1 (0 = none); with the caret it bounds the selection
;;   word 2036  the window the selection belongs to; word 2037 its length (kept for ADR-0240's readers)
;;   word 2006  the undo record: window id, kind (1 text was inserted, 2 text was deleted), index, length,
;;              and where the caret goes; the deleted text (up to 32 code points) waits in 446.. which
;;              composing would overwrite, so composing forgets the record
;; With the caret at the end everything below is what it was.
(defn bn [s] (body-len s (body-base s) 0))

(defn caret-ix [s]
  (let [n (bn s) v (w s 2004)]
    (if (= (quot v 128) (w s 2))
      (let [c (- (bit-and v 127) 1)] (if (> c n) n c))
      n)))

(defn set-caret [s c]
  (wp s 2004 (if (< c (bn s)) (+ (* (w s 2) 128) (+ c 1)) 0)))

(defn anchor-ix [s]
  (if (= (w s 2036) (w s 2))
    (let [a (w s 2005) n (bn s)]
      (if (= a 0) -1 (if (> (- a 1) n) n (- a 1))))
    -1))

(defn sel-len [s]
  (let [a (anchor-ix s)]
    (if (< a 0) 0
      (let [c (caret-ix s)] (if (> a c) (- a c) (- c a))))))

(defn sel-lo [s]
  (let [a (anchor-ix s) c (caret-ix s)]
    (if (< a 0) c (if (< a c) a c))))

(defn sel-hi [s]
  (let [a (anchor-ix s) c (caret-ix s)]
    (if (< a 0) c (if (> a c) a c))))

(defn clear-sel [s]
  (do (wp s 2005 0) (wp s 2036 0) (wp s 2037 0) 0))

(defn sync-sel [s]
  (let [k (sel-len s)]
    (if (= k 0) (clear-sel s)
      (do (wp s 2036 (w s 2)) (wp s 2037 k) 0))))

(defn begin-sel [s]
  (if (< (anchor-ix s) 0)
    (do (wp s 2036 (w s 2)) (wp s 2005 (+ (caret-ix s) 1)))
    0))

(defn clear-from [s base i n]
  (if (>= i n) 0
    (do (wp s (+ base i) 0) (clear-from s base (+ i 1) n))))

(defn move-down [s base i n d]
  (if (>= (+ i d) n) 0
    (do (wp s (+ base i) (w s (+ base (+ i d))))
        (move-down s base (+ i 1) n d))))

(defn move-up [s base i at m]
  (if (< i at) 0
    (do (wp s (+ base (+ i m)) (w s (+ base i)))
        (move-up s base (- i 1) at m))))

(defn save-text [s base lo i m]
  (if (>= i m) 0
    (do (wp s (+ 446 i) (w s (+ base (+ lo i))))
        (save-text s base lo (+ i 1) m))))

(defn restore-text [s base at i m]
  (if (>= i m) 0
    (do (wp s (+ base (+ at i)) (w s (+ 446 i)))
        (restore-text s base at (+ i 1) m))))

(defn rec-undo [s kind idx len caret]
  (wp s 2006 (+ (* (w s 2) 8388608)
                (+ (* kind 2097152) (+ (* idx 16384) (+ (* len 128) caret))))))

;; typing in a run is one undo step: an insert right after the recorded one extends it
(defn note-insert [s at m]
  (let [v (w s 2006)
        kind (bit-and (quot v 2097152) 3)
        pidx (bit-and (quot v 16384) 127)
        plen (bit-and (quot v 128) 127)]
    (if (= (quot v 8388608) (w s 2))
      (if (= kind 1)
        (if (= (+ pidx plen) at)
          (rec-undo s 1 pidx (+ plen m) (+ at m))
          (rec-undo s 1 at m (+ at m)))
        (rec-undo s 1 at m (+ at m)))
      (rec-undo s 1 at m (+ at m)))))

(defn del-range [s lo hi]
  (let [base (body-base s) n (bn s) d (- hi lo)]
    (if (<= d 0) 0
      (do (move-down s base lo n d)
          (clear-from s base (- n d) n)
          0))))

(defn ins-room [s at m]
  (let [base (body-base s) n (bn s)]
    (move-up s base (- n 1) at m)))

(defn commit [s]
  ;; The preedit into the body at the caret, whole or not at all.
  (let [base (body-base s)
        n (w s 445)
        at (caret-ix s)
        len (bn s)]
    (if (> (+ len n) 64) -5
      (do (ins-room s at n)
          (copy-preedit s base at 0 n)
          (clear-state s)
          (note-insert s at n)
          (set-caret s (+ at n))
          n))))

(defn drop-selection [s]
  ;; insert-text "" over [lo, hi): the selected code points go (kept for undo when they fit), the
  ;; caret is at lo
  (let [lo (sel-lo s) hi (sel-hi s) base (body-base s) len (- hi lo)]
    (do (if (> len 32) (wp s 2006 0)
          (do (save-text s base lo 0 len) (rec-undo s 2 lo len (+ lo len))))
        (del-range s lo hi)
        (clear-sel s)
        (set-caret s lo)
        0)))

(defn put-latin [s c]
  (let [base (body-base s) n (bn s) at (caret-ix s)]
    (if (>= n 64) -5
      (do (ins-room s at 1)
          (wp s (+ base at) c)
          (note-insert s at 1)
          (set-caret s (+ at 1))
          1))))



;; --- preedit and romaji buffers ----------------------------------------------

(defn pre-push [s cp]
  (let [n (w s 445)]
    (if (>= n 32) (do (wp s 478 1) 0)
      (do (wp s (+ 446 n) cp) (wp s 445 (+ n 1)) 0))))

(defn emit-kana [s r]
  (do (pre-push s (quot r 65536))
      (if (> (bit-and r 65535) 0) (pre-push s (bit-and r 65535)) 0)))

(defn sokuon-letter [c]
  (if (= c 107) 1 (if (= c 115) 1 (if (= c 116) 1 (if (= c 112) 1 (if (= c 99) 1
  (if (= c 103) 1 (if (= c 122) 1 (if (= c 100) 1 (if (= c 98) 1 (if (= c 106) 1 0)))))))))))

(defn b-at [s i] (w s (+ 434 i)))

(defn sokuon-at [s p n]
  (if (< n 2) 0
    (if (not (= (b-at s p) (b-at s (+ p 1)))) 0
      (sokuon-letter (b-at s p)))))

(defn compact [s p i n]
  ;; Move buffer bytes p.. down to 0.., n of them.
  (if (>= i n) (wp s 433 n)
    (do (wp s (+ 434 i) (b-at s (+ p i)))
        (compact s p (+ i 1) n))))

(defn convert-buf [s p]
  (let [n (- (w s 433) p)]
    (if (= n 0) (wp s 433 0)
      (if (= (sokuon-at s p n) 1)
        (do (pre-push s 12387) (convert-buf s (+ p 1)))
        (let [r3 (if (>= n 3)
                   (mora3 (+ (* (b-at s p) 65536) (* (b-at s (+ p 1)) 256) (b-at s (+ p 2))))
                   0)]
          (if (> r3 0) (do (emit-kana s r3) (convert-buf s (+ p 3)))
            (let [r2 (if (>= n 2) (mora2 (+ (* (b-at s p) 256) (b-at s (+ p 1)))) 0)]
              (if (> r2 0) (do (emit-kana s r2) (convert-buf s (+ p 2)))
                (let [r1 (mora1 (b-at s p))]
                  (if (> r1 0) (do (emit-kana s r1) (convert-buf s (+ p 1)))
                    (compact s p 0 n)))))))))))

(defn push-leftover [s i n]
  (if (>= i n) 0
    (do (pre-push s (b-at s i)) (push-leftover s (+ i 1) n))))

(defn flush-preedit [s]
  ;; A lone "n" is "nn"; convert; whatever is left goes in as latin.
  (do (if (= (w s 433) 1)
        (if (= (b-at s 0) 110) (do (wp s 435 110) (wp s 433 2)) 0)
        0)
      (convert-buf s 0)
      (push-leftover s 0 (w s 433))
      (wp s 433 0)))

;; --- the dictionary -----------------------------------------------------------

(defn dw [s d i]
  (kernel-load-u32 (kernel-subregion d (w s 479) (* i 4) 4) 4 0))

(defn dict-there [s d]
  (if (= d 0) 0 (if (= (w s 479) 0) 0 1)))

(defn dict-ok [s d]
  ;; the aiueos-dict/v1 header: magic "AIUD", version 1, N index words
  ;; inside W, W words inside the bytes handed in
  (if (< (w s 479) 16) 0
    (if (not (= (dw s d 0) 1146440001)) 0
      (if (not (= (dw s d 1) 1)) 0
        (if (> (* (dw s d 3) 4) (w s 479)) 0
          (if (> (+ 4 (dw s d 2)) (dw s d 3)) 0 1))))))

(defn rec-ok [s d o]
  ;; record o: L (1..32) reading code points, C (>= 1) candidates, all
  ;; inside W
  (if (= (dict-there s d) 0) 0
    (if (>= (+ o 1) (dw s d 3)) 0
      (if (< (dw s d o) 1) 0
        (if (> (dw s d o) 32) 0
          (if (> (+ (+ o 2) (dw s d o)) (dw s d 3)) 0
            (if (< (dw s d (+ (+ o 1) (dw s d o))) 1) 0
              (if (> (+ (+ (+ o 2) (dw s d o)) (dw s d (+ (+ o 1) (dw s d o)))) (dw s d 3)) 0
                1))))))))

(defn rec-cmp [s d o i]
  ;; record o's reading against the preedit, from code point i: <0 the
  ;; record sorts first, 0 equal, >0 the preedit sorts first
  (if (>= i (dw s d o)) (if (>= i (w s 445)) 0 -1)
    (if (>= i (w s 445)) 1
      (if (< (dw s d (+ (+ o 1) i)) (w s (+ 446 i))) -1
        (if (> (dw s d (+ (+ o 1) i)) (w s (+ 446 i))) 1
          (rec-cmp s d o (+ i 1)))))))

(defn search [s d lo hi]
  ;; the record whose reading is the preedit: its word offset, 0 none,
  ;; -1 a record out of bounds
  (if (>= lo hi) 0
    (let [mid (quot (+ lo hi) 2)
          o (dw s d (+ 4 mid))]
      (if (= (rec-ok s d o) 0) -1
        (let [c (rec-cmp s d o 0)]
          (if (= c 0) o
            (if (< c 0) (search s d (+ mid 1) hi)
              (search s d lo mid))))))))

(defn lookup [s d]
  (if (= (dict-there s d) 0) 0
    (if (= (w s 445) 0) 0
      (search s d 0 (dw s d 2)))))

(defn cand-count [s d o]
  (dw s d (+ (+ o 1) (dw s d o))))

(defn cand-at [s d o i]
  (dw s d (+ (+ (+ o 2) (dw s d o)) i)))

(defn set-preedit-one [s cp]
  (do (wp s 446 cp) (wp s 445 1) 0))

(defn put-reading [s d o i]
  ;; the record's reading back into the preedit
  (if (>= i (dw s d o)) (wp s 445 i)
    (do (wp s (+ 446 i) (dw s d (+ (+ o 1) i)))
        (put-reading s d o (+ i 1)))))

;; --- keys ---------------------------------------------------------------------

(defn cycle [s d o]
  (if (= (rec-ok s d o) 0) -6
    (let [n (cand-count s d o)
          idx (- (+ (w s 443) 1) (* n (quot (+ (w s 443) 1) n)))]
      (do (wp s 443 idx) (set-preedit-one s (cand-at s d o idx))))))

(defn on-space [s d]
  (if (= (w s 442) 1) (cycle s d (w s 444))
    (do (flush-preedit s)
        (let [o (lookup s d)]
          (if (< o 0) -6
            (if (> o 0)
              (do (wp s 442 1) (wp s 444 o) (wp s 443 0)
                  (set-preedit-one s (cand-at s d o 0)))
              (commit s)))))))

(defn on-enter [s]
  (do (if (= (w s 442) 0) (flush-preedit s) 0)
      (commit s)))

(defn cancel [s d]
  (if (= (w s 442) 1)
    (if (= (rec-ok s d (w s 444)) 0) -6
      (do (put-reading s d (w s 444) 0)
          (wp s 442 0) (wp s 443 0) (wp s 444 0) 0))
    (do (wp s 433 0) (wp s 445 0) 0)))

;; --- the selection (ADR-0240) --------------------------------------------------





(defn replace-selection [s]
  (if (> (sel-len s) 0) (drop-selection s) 0))

(defn composing [s]
  (if (> (w s 433) 0) 1 (if (> (w s 445) 0) 1 (if (= (w s 442) 1) 1 0))))

;; --- caret movement and the rest of the editing keys (ADR-0263) -------------------
;; Nothing here acts while a composition is pending. Shift extends the selection from the anchor; without
;; Shift a selection collapses to its near edge on Left / Right.
(defn move-to [s c extend]
  (do (if (= extend 1) (begin-sel s) (clear-sel s))
      (set-caret s c)
      (sync-sel s)
      0))

(defn arrow-key [s left]
  (if (= (composing s) 1) 0
    (let [c (caret-ix s) n (bn s)
          target (if (= left 1) (if (> c 0) (- c 1) 0) (if (< c n) (+ c 1) n))]
      (if (= (w s 2035) 1) (move-to s target 1)
        (if (> (sel-len s) 0)
          (move-to s (if (= left 1) (sel-lo s) (sel-hi s)) 0)
          (move-to s target 0))))))

(defn line-start [s base i]
  (if (<= i 0) 0
    (if (= (w s (+ base (- i 1))) 10) i (line-start s base (- i 1)))))

(defn line-end [s base i n]
  (if (>= i n) n
    (if (= (w s (+ base i)) 10) i (line-end s base (+ i 1) n))))

(defn home-key [s]
  (if (= (composing s) 1) 0
    (move-to s (line-start s (body-base s) (caret-ix s)) (w s 2035))))

(defn end-key [s]
  (if (= (composing s) 1) 0
    (move-to s (line-end s (body-base s) (caret-ix s) (bn s)) (w s 2035))))

(defn wsp [cp] (if (= cp 32) 1 (if (= cp 10) 1 (if (= cp 9) 1 (if (= cp 12288) 1 0)))))

(defn wl-ws [s base i]
  (if (<= i 0) i (if (= (wsp (w s (+ base (- i 1)))) 1) (wl-ws s base (- i 1)) i)))

(defn wl-word [s base i]
  (if (<= i 0) i (if (= (wsp (w s (+ base (- i 1)))) 0) (wl-word s base (- i 1)) i)))

(defn wr-ws [s base i n]
  (if (>= i n) i (if (= (wsp (w s (+ base i))) 1) (wr-ws s base (+ i 1) n) i)))

(defn wr-word [s base i n]
  (if (>= i n) i (if (= (wsp (w s (+ base i))) 0) (wr-word s base (+ i 1) n) i)))

;; Ctrl+Left: to the start of the word at or before the caret; Ctrl+Right: to the end of the next word
(defn word-key [s left]
  (if (= (composing s) 1) 0
    (let [base (body-base s) c (caret-ix s) n (bn s)]
      (move-to s (if (= left 1)
                   (wl-word s base (wl-ws s base c))
                   (wr-word s base (wr-ws s base c n) n))
               (w s 2035)))))

(defn delete-backward [s]
  ;; browser.text-edit delete-backward: the selection goes, else the code point before the caret
  (if (> (sel-len s) 0) (drop-selection s)
    (let [c (caret-ix s) base (body-base s)]
      (if (> c 0)
        (do (save-text s base (- c 1) 0 1)
            (rec-undo s 2 (- c 1) 1 c)
            (del-range s (- c 1) c)
            (set-caret s (- c 1))
            0)
        0))))

(defn delete-forward [s]
  (if (= (composing s) 1) 0
    (if (> (sel-len s) 0) (drop-selection s)
      (let [c (caret-ix s) n (bn s) base (body-base s)]
        (if (< c n)
          (do (save-text s base c 0 1)
              (rec-undo s 2 c 1 c)
              (del-range s c (+ c 1))
              (set-caret s c)
              0)
          0)))))

;; Ctrl+Z: undo the last edit of this window -- a run of typed code points, one commit or paste, one
;; deletion -- once; there is no redo
(defn undo [s]
  (let [v (w s 2006) base (body-base s)
        kind (bit-and (quot v 2097152) 3)
        idx (bit-and (quot v 16384) 127)
        len (bit-and (quot v 128) 127)
        caret (bit-and v 127)]
    (if (not (= (quot v 8388608) (w s 2))) 0
      (if (= kind 1)
        (if (> (+ idx len) (bn s)) 0
          (do (del-range s idx (+ idx len))
              (wp s 2006 0)
              (clear-sel s)
              (set-caret s idx)
              0))
        (if (= kind 2)
          (if (> (+ (bn s) len) 64) 0
            (do (ins-room s idx len)
                (restore-text s base idx 0 len)
                (wp s 2006 0)
                (clear-sel s)
                (set-caret s caret)
                0))
          0)))))






(defn on-backspace [s d]
  (if (= (w s 442) 1) (cancel s d)
    (if (> (w s 433) 0) (do (wp s 433 (- (w s 433) 1)) 0)
      (if (> (w s 445) 0) (do (wp s 445 (- (w s 445) 1)) 0)
        (delete-backward s)))))

(defn on-letter [s c]
  (if (>= (w s 433) 8) -8
    (do (replace-selection s)
        (wp s 2006 0)
        (wp s 2004 0)
        (wp s (+ 434 (w s 433)) c)
        (wp s 433 (+ (w s 433) 1))
        (convert-buf s 0)
        0)))


(defn off-letter [s c]
  (do (replace-selection s)
      (put-latin s c)))

;; --- the clipboard (ADR-0241) --------------------------------------------------

(defn cw [d i]
  (kernel-load-u32 (kernel-subregion d 260 (* i 4) 4) 4 0))

(defn cwp [d i v]
  (kernel-store-u32 (kernel-subregion d 260 (* i 4) 4) 4 0 v))


(defn copy-out [s d from i k]
  ;; from: the surface word of the first selected code point
  (if (>= i k) (do (cwp d 0 k) k)
    (do (cwp d (+ i 1) (w s (+ from i)))
        (copy-out s d from (+ i 1) k))))


(defn paste-in [s d to i n]
  ;; to: the surface word the first pasted code point goes to
  (if (>= i n) n
    (do (wp s (+ to i) (cw d (+ i 1)))
        (paste-in s d to (+ i 1) n))))


(defn copy-sel [s d]
  ;; the selection's text into the clipboard
  (let [k (sel-len s)
        base (body-base s)]
    (if (= k 0) 0
      (copy-out s d (+ base (sel-lo s)) 0 k))))

(defn paste [s d]
  ;; insert-text of the clipboard's text: the selection goes, the text goes in at the caret,
  ;; whole or not at all
  (let [n (cw d 0)
        base (body-base s)
        k (sel-len s)
        len (bn s)]
    (if (= n 0) 0
      (if (> (+ (- len k) n) 64) -5
        (do (replace-selection s)
            (let [at (caret-ix s)]
              (do (ins-room s at n)
                  (paste-in s d (+ base at) 0 n)
                  (note-insert s at n)
                  (set-caret s (+ at n))
                  n)))))))

(defn ctrl-key [s code]
  ;; with Ctrl held: C over a selection asks to write the clipboard, V asks to read it; Left and
  ;; Right move by word, Z undoes; nothing while composing, and no other shortcut
  (if (= (composing s) 1) 0
    (if (= code 46) (if (> (sel-len s) 0) 512 0)
      (if (= code 47) 513
        (if (= code 105) (word-key s 1)
          (if (= code 106) (word-key s 0)
            (if (= code 44) (undo s) 0)))))))

(defn complete [s d db code]
  ;; an admitted request's completion; the clipboard in place of the
  ;; dictionary
  (if (= d 0) -7
    (if (not (= db 260)) -7
      (if (> (cw d 0) 64) -7
        (if (= (composing s) 1) 0
          (if (= code 46) (copy-sel s d)
            (if (= code 47) (paste s d) 0)))))))

(defn toggle [s]
  (do (wp s 432 (if (= (w s 432) 0) 1 0))
      (clear-state s)))


;; ADR-0267: other layouts. Word 1970 is the keyboard layout (0 = US, 1 = JIS), F9 (evdev 67) flips it. With the input
;; method off (English mode) the digit row and the punctuation keys type their characters, Shift selects the second
;; character of a key, and Shift makes a letter upper case. Keys are Linux evdev codes (the physical position), so the
;; layout is what the physical key means: US and JIS differ in the shifted digit row and in the keys at codes 12, 13, 26,
;; 27, 39, 40 and 43. The input-method-on mode is unchanged (letters feed the romaji buffer, symbols are not typed).
(defn layout-toggle [s]
  (do (wp s 1970 (if (= (w s 1970) 0) 1 0)) 0))

(defn pick [s a b c d]
  (if (= (w s 1970) 0)
    (if (= (w s 2035) 1) b a)
    (if (= (w s 2035) 1) d c)))

;; digit d = 0..9 (the key labelled d): its shifted character in US and in JIS (0 = none)
(defn us-shifted [d]
  (if (= d 1) 33 (if (= d 2) 64 (if (= d 3) 35 (if (= d 4) 36 (if (= d 5) 37
  (if (= d 6) 94 (if (= d 7) 38 (if (= d 8) 42 (if (= d 9) 40 41))))))))))

(defn jis-shifted [d]
  (if (= d 1) 33 (if (= d 2) 34 (if (= d 3) 35 (if (= d 4) 36 (if (= d 5) 37
  (if (= d 6) 38 (if (= d 7) 39 (if (= d 8) 40 (if (= d 9) 41 0))))))))))

(defn digit-sym [s code]
  (let [d (if (= code 11) 0 (- code 1))]
    (if (= (w s 2035) 0) (+ 48 d)
      (if (= (w s 1970) 0) (us-shifted d) (jis-shifted d)))))

(defn sym-of [s code]
  (if (< code 2) 0
    (if (< code 12) (digit-sym s code)
      (if (= code 12) (pick s 45 95 45 61)
      (if (= code 13) (pick s 61 43 94 126)
      (if (= code 26) (pick s 91 123 64 96)
      (if (= code 27) (pick s 93 125 91 123)
      (if (= code 39) (pick s 59 58 59 43)
      (if (= code 40) (pick s 39 34 58 42)
      (if (= code 43) (pick s 92 124 93 125)
      (if (= code 51) (pick s 44 60 44 60)
      (if (= code 52) (pick s 46 62 46 62)
      (if (= code 53) (pick s 47 63 47 63) 0)))))))))))))

(defn cased [s c]
  (if (= (w s 2035) 1) (- c 32) c))

(defn key [s d code]
  (let [c (letter-of code)]
    (if (= code 41) (toggle s)
    (if (= code 105) (arrow-key s 1)
    (if (= code 106) (arrow-key s 0)
    (if (= code 102) (home-key s)
    (if (= code 107) (end-key s)
    (if (= code 111) (delete-forward s)
    (if (= (w s 432) 0)
      (if (> c 0) (off-letter s (cased s c))
        (if (> (sym-of s code) 0) (off-letter s (sym-of s code))
        (if (= code 57) (off-letter s 32)
          (if (= code 28) (off-letter s 10)
            (if (= code 14) (delete-backward s) 0)))))
      (if (> c 0) (on-letter s c)
        (if (= code 57) (on-space s d)
          (if (= code 28) (on-enter s)
            (if (= code 14) (on-backspace s d)
              (if (= code 1) (cancel s d) 0))))))))))))))

;; --- admission ----------------------------------------------------------------

(defn has-id [s n k id]
  (if (>= k n) 0
    (if (= (w s (+ 5 (* k 5))) id) 1
      (has-id s n (+ k 1) id))))

(defn hold-alt [s value]
  (do (if (= value 1) (wp s 431 1) (if (= value 0) (wp s 431 0) 0))
      0))

(defn hold-shift [s value]
  (do (if (= value 1) (wp s 2035 1) (if (= value 0) (wp s 2035 0) 0))
      0))

(defn hold-ctrl [s value]
  (do (if (= value 1) (wp s 2038 1) (if (= value 0) (wp s 2038 0) 0))
      0))

(defn ctrl-code [code]
  (if (= code 29) 1 (if (= code 97) 1 0)))

(defn shift-code [code]
  (if (= code 42) 1 (if (= code 54) 1 0)))

;; ADR-0254: Alt+Tab raises the bottom-most window that is not minimized (word 31 bits 4..7).
(defn mbit [id]
  (if (= id 1) 16 (if (= id 2) 32 (if (= id 3) 64 (if (= id 4) 128 0))))) 

(defn first-vis [s n k]
  (if (>= k n) (w s 5)
    (let [id (w s (+ 5 (* k 5)))]
      (if (= (bit-and (w s 31) (mbit id)) 0) id (first-vis s n (+ k 1))))))

(defn wm-key [s code]
  (if (= code 15) (if (= (w s 431) 1) 1 0) 0))

;; ADR-0247: F10 (evdev 68) flips the high-contrast palette, word 2039,
;; browser-frame2.kotoba's. It is no text and no window action: the answer is 0.
;; ADR-0248: the keyboard focus ring and keyboard activation. Word 2032 is the
;; ring (browser-frame2.kotoba draws it): 0 none, 1..4 launcher button k when
;; app k is registered, 5 the focused window's close control when the window is
;; at least 40 wide and there is an app register. F6 moves it forward through
;; the targets that exist and then off; Shift+F6 backward. Enter or Space on a
;; ring target, and Escape for the focused window's close control, do what a
;; pointer press at the control's centre does -- the answer is that press,
;; 65536 + 2048 x + y, for C to hand to browser-reduce as a pointer/down, so
;; the keyboard and the pointer are one action path. Enter and Space with a
;; composition are the input method's, as before.
(defn kbit [k] (if (= k 1) 1 (if (= k 2) 2 (if (= k 3) 4 8))))

(defn idx [s n k id]
  (if (>= k n) -1
    (if (= (w s (+ 5 (* k 5))) id) k
      (idx s n (+ k 1) id))))

(defn close-ok [s]
  (if (= (w s 31) 0) 0
    (let [i (idx s (w s 1) 0 (w s 2))]
      (if (< i 0) 0
        (if (< (w s (+ 8 (* i 5))) 40) 0 1)))))

(defn vis-n [s n k]
  (if (>= k n) 0
    (+ (if (= (bit-and (w s 31) (mbit (w s (+ 5 (* k 5))))) 0) 1 0)
       (vis-n s n (+ k 1)))))

(defn max-exists [s]
  (if (= (w s 31) 0) 0
    (let [i (idx s (w s 1) 0 (w s 2))]
      (if (< i 0) 0
        (if (< (w s (+ 8 (* i 5))) 160) 0 1)))))

(defn min-exists [s]
  (if (= (w s 31) 0) 0
    (let [i (idx s (w s 1) 0 (w s 2))]
      (if (< i 0) 0
        (if (< (w s (+ 8 (* i 5))) 200) 0
          (if (< (vis-n s (w s 1) 0) 2) 0 1))))))

;; ADR-0262: the minimized windows by id (bits 4..7 of word 31) are the tray's buttons, 8 .. 11.
(defn tray-count [s]
  (let [m (quot (w s 31) 16)]
    (+ (bit-and m 1) (+ (bit-and (quot m 2) 1) (+ (bit-and (quot m 4) 1) (bit-and (quot m 8) 1))))))

(defn target-ok [s t]
  (if (< t 1) 0
    (if (< t 5)
      (if (= (bit-and (w s 31) (kbit t)) 0) 0 1)
      (if (= t 5) (close-ok s)
        (if (= t 6) (max-exists s)
          (if (= t 7) (min-exists s)
            (if (> t 11) 0
              (if (< (- t 8) (tray-count s)) 1 0))))))))

(defn next-from [s t]
  (if (> t 11) 0
    (if (= (target-ok s t) 1) t
      (next-from s (+ t 1)))))

(defn prev-from [s t]
  (if (< t 1) 0
    (if (= (target-ok s t) 1) t
      (prev-from s (- t 1)))))

(defn ring-move [s]
  (do (wp s 2032
          (if (= (w s 2035) 1)
            (prev-from s (if (= (w s 2032) 0) 11 (- (w s 2032) 1)))
            (next-from s (+ (w s 2032) 1))))
      0))

(defn press-at [px py] (+ 65536 (+ (* px 2048) py)))

(defn close-press [s]
  (let [i (idx s (w s 1) 0 (w s 2))
        b (+ 5 (* i 5))]
    (press-at (- (+ (w s (+ b 1)) (w s (+ b 3))) 16) (+ (w s (+ b 2)) 14))))


(defn hc-toggle [s]
  (do (wp s 2039 (if (= (w s 2039) 0) 1 0))
      0))

(defn max-key-ok [s]
  (if (= (w s 31) 0) 0
    (let [i (idx s (w s 1) 0 (w s 2))]
      (if (< i 0) 0
        (if (< (w s (+ 8 (* i 5))) 160) 0 1)))))

;; ADR-0251: F11 (evdev 87) presses the focused window's maximize control, as a
;; pointer press at its centre (x + w - 36, y + 14), through browser-reduce.
(defn max-key-press [s]
  (let [i (idx s (w s 1) 0 (w s 2))
        b (+ 5 (* i 5))]
    (press-at (- (+ (w s (+ b 1)) (w s (+ b 3))) 36) (+ (w s (+ b 2)) 14))))

;; ADR-0256: Alt+- (evdev 12) presses the focused window's minimize control as a pointer press at
;; its centre (x + w - 56, y + 14) through browser-reduce, when the control exists: a window at
;; least 200 wide with a launcher while two or more windows are visible.

(defn min-key-ok [s]
  (if (= (w s 431) 0) 0 (min-exists s)))

(defn min-key-press [s]
  (let [i (idx s (w s 1) 0 (w s 2))
        b (+ 5 (* i 5))]
    (press-at (- (+ (w s (+ b 1)) (w s (+ b 3))) 56) (+ (w s (+ b 2)) 14))))

(defn tray-press [s i]
  (press-at (+ 66 (* 126 i)) (- (w s 4) 18)))

(defn ring-press [s]
  (let [t (w s 2032)]
    (if (= (target-ok s t) 0) 0
      (if (= t 5) (close-press s)
        (if (= t 6) (max-key-press s)
          (if (= t 7) (min-key-press s)
            (if (> t 7) (tray-press s (- t 8))
              (press-at (+ 54 (* 102 (- t 1))) 14))))))))

(defn kbd-act [s code]
  (if (= (composing s) 1) 0
    (if (= code 28) (if (= (target-ok s (w s 2032)) 1) 1 0)
      (if (= code 57) (if (= (target-ok s (w s 2032)) 1) 1 0)
        (if (= code 1) (close-ok s) 0)))))

(defn kbd-answer [s code]
  (if (= code 1) (close-press s) (ring-press s)))

;; ADR-0258: the screen lock. Ctrl+Alt+L (evdev 38) sets word 2030; while it is 1 the only keys
;; taken are the PIN's: digits (evdev 2..11) fill word 2031 (7 bits: count in bits 0..2, the number in
;; the rest), Backspace takes one back, Enter with four digits answers 100000000 + the number for C to
;; check against the PIN's hash and send back as a verdict event (value 2, code 1 accepted, 2 refused).
;; Everything else, the shell actions and typing included, is swallowed. Word 2026 is 1 after a refusal
;; until the next digit.
(defn lock-chord [s code]
  (if (= code 38) (if (= (w s 2038) 1) (if (= (w s 431) 1) 1 0) 0) 0))

(defn lock-now [s]
  (do (wp s 2030 1) (wp s 2031 0) (wp s 2026 0) (wp s 2032 0)
      (wp s 25 0) (wp s 26 0) (wp s 27 0) (wp s 28 0) (wp s 29 0) (wp s 30 0)
      (clear-state s)
      0))

;; ADR-0259: sign out. Ctrl+Alt+Q (evdev 16) ends the session: every window body (words 160..415), scroll
;; offset, saved maximize rect, double-press bookkeeping, selection and the minimized register is zeroed, the
;; stack is one fresh window 1 at the default rect with focus, and the screen is locked (the next session
;; starts clean and needs the PIN). The titles are the apps', not the session's, and stay.
(defn signout-chord [s code]
  (if (= code 16) (if (= (w s 2038) 1) (if (= (w s 431) 1) 1 0) 0) 0))

(defn zero-run [s from n]
  (if (= n 0) 0
    (do (wp s from 0) (zero-run s (+ from 1) (- n 1)))))

(defn zero-body [s k]
  (if (= k 4) 0
    (do (zero-run s (+ 160 (* 64 k)) 64) (zero-body s (+ k 1)))))

(defn sign-out-now [s]
  (do (zero-body s 0)
      (zero-run s 2010 16) (zero-run s 2027 3) (zero-run s 2036 2) (zero-run s 2040 4)
      (zero-run s 2004 3) (wp s 432 0)
      (zero-run s 10 15)
      (wp s 5 1) (wp s 6 80) (wp s 7 80) (wp s 8 520) (wp s 9 360)
      (wp s 1 1) (wp s 2 1)
      (wp s 31 (bit-and (w s 31) 15))
      (lock-now s)))

;; ADR-0261: the UI scale. Ctrl+= (evdev 13) and Ctrl+- (evdev 12) step the scale 100 -> 125 -> 150 and back;
;; word 2009 holds it (0 = 100). Kotoba decides the scale and answers 200000000 + the new percent for C, which
;; magnifies what it paints, sets the logical viewport (surface words 3 and 4) to the physical size over the
;; scale, and sends a value-2 key event with code 3 back; `fit-windows` then moves every window into the viewport.
(defn zoom-chord [s code]
  (if (= (w s 2038) 0) 0 (if (= (w s 431) 1) 0 (if (= code 13) 1 (if (= code 12) 1 0)))))

(defn zoom-pct [s] (if (= (w s 2009) 0) 100 (w s 2009)))

(defn zoom-next [s code]
  (if (= code 13) (if (< (zoom-pct s) 150) (+ (zoom-pct s) 25) (zoom-pct s))
    (if (> (zoom-pct s) 100) (- (zoom-pct s) 25) (zoom-pct s))))

(defn zoom-step [s code]
  (let [next (zoom-next s code)]
    (if (= next (zoom-pct s)) 0
      (do (wp s 2009 next) (+ 200000000 next)))))

(defn fit-one [s k]
  (let [b (+ 5 (* k 5))
        vw (w s 3)
        vh (w s 4)
        w1 (if (< (w s (+ b 3)) vw) (w s (+ b 3)) vw)
        h1 (if (< (w s (+ b 4)) (- vh 28)) (w s (+ b 4)) (- vh 28))
        x1 (if (< (w s (+ b 1)) (- vw w1)) (w s (+ b 1)) (- vw w1))
        y1 (if (< (w s (+ b 2)) (- vh h1)) (w s (+ b 2)) (- vh h1))]
    (do (wp s (+ b 1) x1) (wp s (+ b 2) y1) (wp s (+ b 3) w1) (wp s (+ b 4) h1))))

(defn fit-windows [s k]
  (if (>= k (w s 1)) 0
    (do (fit-one s k) (fit-windows s (+ k 1)))))

(defn pin-digit [code]
  (if (< code 2) -1 (if (> code 11) -1 (if (= code 11) 0 (- code 1)))))

(defn pin-count [s] (bit-and (w s 2031) 7))

(defn pin-add [s dg]
  (if (< (pin-count s) 4)
    (do (wp s 2031 (+ (* (+ (* (quot (w s 2031) 8) 10) dg) 8) (+ (pin-count s) 1)))
        (wp s 2026 0)
        0)
    0))

(defn pin-back [s]
  (if (= (pin-count s) 0) 0
    (do (wp s 2031 (+ (* (quot (quot (w s 2031) 8) 10) 8) (- (pin-count s) 1)))
        0)))

(defn locked-key [s code]
  (if (> (pin-digit code) -1) (pin-add s (pin-digit code))
    (if (= code 14) (pin-back s)
;; ADR-0270: on the lock screen F4 (evdev 62) asks C to run the passkey ceremony with this device's key and F3 (61) with a key of another
;; device; the answers are 300000001 and 300000002, and C sends the verdict back as the PIN attempt's does (value-2 key event).
      (if (= code 28) (if (= (pin-count s) 4) (+ 100000000 (quot (w s 2031) 8)) 0)
        (if (= code 62) 300000001
          (if (= code 61) 300000002 0))))))

(defn verdict [s code]
  (if (= code 3) (fit-windows s 0)
  (if (= (w s 2030) 0) 0
    (do (wp s 2031 0)
        (if (= code 1) (do (wp s 2030 0) (wp s 2026 0)) (wp s 2026 1))
        0))))

;; ADR-0268: F8 (evdev 66) dismisses the newest notification still shown (it stays in the list), F7 (evdev 65) opens and closes
;; the list. Neither is text; the answer is 0. The entries are surface words 1971..2002, four of eight words (browser-frame2.kotoba).
(defn newest-shown [s k]
  (if (< k 0) -1
    (if (= (w s (+ 1971 (* 8 k))) 1) k (newest-shown s (- k 1)))))

(defn note-dismiss [s]
  (let [k (newest-shown s 3)]
    (if (< k 0) 0 (do (wp s (+ 1971 (* 8 k)) 2) 0))))

(defn note-panel [s]
  (do (wp s 2003 (if (= (w s 2003) 1) 0 1)) 0))

(defn press [s d ev]
  (if (= (bit-and ev 3) 2) (verdict s (quot ev 4))
  (if (= (quot ev 4) 56) (hold-alt s (bit-and ev 3))
    (if (= (shift-code (quot ev 4)) 1) (hold-shift s (bit-and ev 3))
    (if (= (ctrl-code (quot ev 4)) 1) (hold-ctrl s (bit-and ev 3))
    (if (not (= (bit-and ev 3) 1)) 0
      (if (= (w s 2030) 1) (locked-key s (quot ev 4))
      (if (= (signout-chord s (quot ev 4)) 1) (sign-out-now s)
      (if (= (zoom-chord s (quot ev 4)) 1) (zoom-step s (quot ev 4))
      (if (= (lock-chord s (quot ev 4)) 1) (lock-now s)
      (if (= (quot ev 4) 68) (hc-toggle s)
      (if (= (quot ev 4) 67) (layout-toggle s)
      (if (= (quot ev 4) 66) (note-dismiss s)
      (if (= (quot ev 4) 65) (note-panel s)
      (if (= (quot ev 4) 64) (ring-move s)
      (if (= (quot ev 4) 87) (if (= (max-key-ok s) 1) (max-key-press s) 0)
      (if (= (if (= (quot ev 4) 12) (min-key-ok s) 0) 1) (min-key-press s)
      (if (= (kbd-act s (quot ev 4)) 1) (kbd-answer s (quot ev 4))
      (if (= (wm-key s (quot ev 4)) 1) (+ 256 (first-vis s (w s 1) 0))
        (if (= (w s 2038) 1) (ctrl-key s (quot ev 4))
          (do (wp s 478 0)
              (let [r (key s d (quot ev 4))]
                (if (= (w s 478) 1) -8 r)))))))))))))))))))))))

(defn admitted [s d ev]
  ;; after the surface checks: a dictionary that is there must be
  ;; aiueos-dict/v1 before any key is taken
  (if (= (dict-there s d) 1)
    (if (= (dict-ok s d) 0) -6 (press s d ev))
    (press s d ev)))

(defn aiueos-browser-key [s sb d db ev]
  (if (= s 0) -1
    (if (not (= sb 8192)) -1
      (if (not (= (w s 0) 1)) -2
        (if (< (w s 1) 1) -2
          (if (> (w s 1) 4) -2
            (if (< (w s 2) 1) -3
              (if (> (w s 2) 4) -3
                (if (= (has-id s (w s 1) 0 (w s 2)) 0) -3
                  (if (= (bit-and ev 3) 3) (complete s d db (quot ev 4))
                    (do (wp s 479 (if (= d 0) 0 db))
                        (admitted s d ev))))))))))))

(defn main [] 0)
