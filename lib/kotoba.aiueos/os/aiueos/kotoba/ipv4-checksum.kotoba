;; The one's-complement checksum every IPv4-family header carries (RFC 1071).
;;
;; It is exported on its own because both directions need it: `kernel/pci.c`
;; fills the field in the datagram it sends, and the admission object verifies
;; the field in the one that comes back. Neither computes it itself -- a
;; checksum is a decision about bytes, and C decides nothing (ADR-0015).
;;
;; The complement is applied here rather than left to the caller because of the
;; verification identity it produces: summing a header that already carries a
;; correct checksum yields 0xffff, so the complemented result is 0 exactly when
;; the header is intact. A verifier therefore checks `(= result 0)` and needs to
;; know nothing else about the arithmetic.

(defn aiueos-ipv4-checksum-word [buffer length offset]
  ;; A trailing odd byte is the HIGH half of the final word -- RFC 1071 pads on
  ;; the right, so reading it as the low half would produce a different sum than
  ;; every other implementation on the wire.
  (if (>= (+ offset 1) length)
    (* (kernel-load-u8-4k buffer 2048 offset) 256)
    (+ (* (kernel-load-u8-4k buffer 2048 offset) 256)
       (kernel-load-u8-4k buffer 2048 (+ offset 1)))))

(defn aiueos-ipv4-checksum-sum [buffer length offset total]
  ;; The accumulator is i64 and the input is bounded at 2048 bytes, so the
  ;; carries can be left to pile up and folded once at the end: 1024 words of
  ;; 0xffff is 2^26, nowhere near where the sum would stop being exact.
  (if (>= offset length) total
    (aiueos-ipv4-checksum-sum buffer length (+ offset 2)
                              (+ total (aiueos-ipv4-checksum-word buffer length offset)))))

(defn aiueos-ipv4-checksum-fold [total]
  ;; Three passes always suffice at that bound, but the recursion costs nothing
  ;; and does not have to be re-argued if the bound ever moves.
  (if (< total 65536) total
    (aiueos-ipv4-checksum-fold (+ (bit-and total 65535) (quot total 65536)))))

(defn aiueos-ipv4-checksum [buffer length]
  ;; Out of range returns 0xffff instead of a sum. The loads trap past 2048, so
  ;; something has to stop first; 0xffff is chosen because it is the one value
  ;; the verification identity above can never read as valid, which makes an
  ;; over-long buffer fail closed on the receive side and produce an obviously
  ;; wrong field on the send side rather than a plausible one.
  (if (or (< length 0) (> length 2048)) 65535
    (- 65535 (aiueos-ipv4-checksum-fold
               (aiueos-ipv4-checksum-sum buffer length 0 0)))))

(defn main [] 0)
