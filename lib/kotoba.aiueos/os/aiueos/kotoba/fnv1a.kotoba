;; JUN-600: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form first, takes no test main and exports nothing else; the predicate is unchanged.
(ns aiueos.fnv1a (:export [kotoba_aiueos_fnv1a]))

(defn- aiueos-fnv1a-step [base length index hash]
  (if (= index length)
    hash
    (aiueos-fnv1a-step
      base
      length
      (+ index 1)
      (* (bit-xor hash (kernel-load-u8 base length index)) 16777619))))

(defn kotoba_aiueos_fnv1a [base length]
  (aiueos-fnv1a-step base length 0 2166136261))

