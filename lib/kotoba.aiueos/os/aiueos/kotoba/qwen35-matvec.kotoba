(defn- lit-7 [i]
  (bit-and (u64-shift-right (lit-7-word (u64-shift-right i 3)) (* 8 (bit-and i 7))) 255))

;; table 8: 1024 bytes as 128 little-endian words
(defn- lit-8-word [w]
  (if (< w 64) (if (< w 32) (if (< w 16) (if (< w 8) (if (< w 4) (if (< w 2) (if (< w 1) 1407383473553408 5066622596284423) (if (< w 3) 9288811671846932 18577623344152613)) (if (< w 6) (if (< w 5) 23362770963988549 32651582636163168) (if (< w 7) 72621647814721655 77969741092749572))) (if (< w 12) (if (< w 10) (if (< w 9) 85851134931173664 100488082830393653) (if (< w 11) 145524766311186802 150309918225728007)) (if (< w 14) (if (< w 13) 158754292082475553 166917165193429570) (if (< w 15) 217019900029305427 225746367347491601)))) (if (< w 24) (if (< w 20) (if (< w 18) (if (< w 17) 235316611046900529 247983195454309200) (if (< w 19) 294708780334056309 306249387525538849)) (if (< w 22) (if (< w 21) 360855799298327619 370989662977656068) (if (< w 23) 380278487535125811 437137261762643302))) (if (< w 28) (if (< w 26) (if (< w 25) 464159185956832787 513418071399073536) (if (< w 27) 526929072147007266 1153502051309717332)) (if (< w 30) (if (< w 29) 1158287194634326020 1162509383709954069) (if (< w 31) 1176583227036667953 1224997180731887702))))) (if (< w 48) (if (< w 40) (if (< w 36) (if (< w 34) (if (< w 33) 1229501416025035009 1239353220600500500) (if (< w 35) 1256523340211818817 1302967536014332278)) (if (< w 38) (if (< w 37) 1311130387650449943 1324078447034831424) (if (< w 39) 1371085519777239666 1380092843587212048))) (if (< w 44) (if (< w 42) (if (< w 41) 1396700004654256944 1446240442382488432) (if (< w 43) 1459751438836110356 1513513301123798086)) (if (< w 46) (if (< w 45) 1526743505510274320 1595424495048398130) (if (< w 47) 1657630628126135847 1666638703567574787)))) (if (< w 56) (if (< w 52) (if (< w 50) (if (< w 49) 1688875570328311605 2307285581891182592) (if (< w 51) 2311507770967334919 2316855868540395542)) (if (< w 54) (if (< w 53) 2324737296738426928 2334870468916420677) (if (< w 55) 2377936290679300208 2384410893758767362))) (if (< w 60) (if (< w 58) (if (< w 57) 2392573796933771554 2451121485445669186) (if (< w 59) 2463506530463457799 2474484260715700791)) (if (< w 62) (if (< w 61) 2522617224765907569 2532187520013247237) (if (< w 63) 2544572556429697841 2603120197707572070)))))) (if (< w 96) (if (< w 80) (if (< w 72) (if (< w 68) (if (< w 66) (if (< w 65) 2612409069510730787 2670956753729168498) (if (< w 67) 2689534359902823714 2740200688947570032)) (if (< w 70) (if (< w 69) 2811695741059540513 2829148078687528721) (if (< w 71) 3464165388756068176 3472609711073210389))) (if (< w 76) (if (< w 74) (if (< w 73) 3477957873071632435 3490624388759367751) (if (< w 75) 3536505505759572225 3557897857394749729)) (if (< w 78) (if (< w 77) 3608001227888406898 3625452899795087904) (if (< w 79) 3684282132014838529 3693289451530171171)))) (if (< w 88) (if (< w 84) (if (< w 82) (if (< w 81) 3707363359281591107 3756622309147882499) (if (< w 83) 3775199975442625585 3829525410464412929)) (if (< w 86) (if (< w 85) 3851480750709028146 3964072575360906774) (if (< w 87) 4611746720125171488 4621889624847040516))) (if (< w 92) (if (< w 90) (if (< w 89) 4634274665558327335 4688600186480640112) (if (< w 91) 4698733461737980179 4756154515903824195)) (if (< w 94) (if (< w 93) 4765162539804803587 4783458696761983539) (if (< w 95) 4833280566516531824 4842850853165613856))))) (if (< w 112) (if (< w 104) (if (< w 100) (if (< w 98) (if (< w 97) 4915472440848696320 4974020202379428928) (if (< w 99) 5058745330026300705 5129678132287129184)) (if (< w 102) (if (< w 101) 5769199093378271043 5783836058603114516) (if (< w 103) 5797347020697129031 5841820749928812801))) (if (< w 108) (if (< w 106) (if (< w 105) 5908812262540464417 5924012727342420497) (if (< w 107) 5985375195697926739 6009300886550237991)) (if (< w 110) (if (< w 109) 6061937476006663027 6135685079550546994) (if (< w 111) 6269668474152506705 6922982679791163140)))) (if (< w 120) (if (< w 116) (if (< w 114) (if (< w 113) 6944656399178752021 7017840941111206144) (if (< w 115) 7085677625992307218 7139440162591760994)) (if (< w 118) (if (< w 117) 7224728338974139169 7292564761873507426) (if (< w 119) 7426829687286228320 8072544021446158099))) (if (< w 124) (if (< w 122) (if (< w 121) 8088588309869260832 8147417456179310676) (if (< w 123) 8214971738367422756 8223979835283763716)) (if (< w 126) (if (< w 125) 8300823517542314544 8360215832861831989) (if (< w 127) 8440436540540220435 8574983645318772034))))))))
(defn- lit-8 [i]
  (bit-and (u64-shift-right (lit-8-word (u64-shift-right i 3)) (* 8 (bit-and i 7))) 255))


(defn- g-pow2 [k]
  (if (= k 0) 1 (if (= k 1) 2 (if (= k 2) 4 (if (= k 3) 8 (if (= k 4) 16 (if (= k 5) 32 64)))))))

;; code -> value for the three-valued grids
(defn- iq2-value [c] (if (= c 0) 8 (if (= c 1) 25 43)))
(defn- iq1-value [c] (if (= c 0) 0 (if (= c 1) 1 -1)))     ; the C reads iq1s_grid as int8
(defn- g-iq3xxs-value [c]
  (if (= c 0) 4 (if (= c 1) 12 (if (= c 2) 20 (if (= c 3) 28 (if (= c 4) 36 (if (= c 5) 44 (if (= c 6) 52 62))))))))
(defn- g-iq3s-value [c] (+ 1 (* 2 c)))

;; element e of a 2-bit-packed literal: byte e/4, bits 2*(e mod 4)
(defn- code2 [byte e]
  (bit-and (quot byte (g-pow2 (* 2 (- e (* 4 (quot e 4)))))) 3))
;; element e of a 4-bit-packed literal: byte e/2, bits 4*(e mod 2)
(defn- code4 [byte e]
  (bit-and (quot byte (g-pow2 (* 4 (- e (* 2 (quot e 2)))))) 15))

(defn- kmask-at [j]
  (lit-0 j))

(defn- ksigns-at [i]
  (lit-1 i))

(defn- iq4nl-at [i]
  (let [v (lit-2 i)]
    (if (> v 127) (- v 256) v)))

(defn- iq2xxs-grid-at [entry j]
  (let [e (+ (* entry 8) j)]
    (iq2-value (code2 (lit-3 (quot e 4)) e))))

(defn- iq2xs-grid-at [entry j]
  (let [e (+ (* entry 8) j)]
    (iq2-value (code2 (lit-4 (quot e 4)) e))))

(defn- iq2s-grid-at [entry j]
  (let [e (+ (* entry 8) j)]
    (iq2-value (code2 (lit-5 (quot e 4)) e))))

(defn- iq1s-grid-at [entry j]
  (let [e (+ (* entry 8) j)]
    (iq1-value (code2 (lit-6 (quot e 4)) e))))

(defn- iq3xxs-grid-at [entry j]
  (let [e (+ (* entry 4) j)]
    (g-iq3xxs-value (code4 (lit-7 (quot e 2)) e))))

(defn- iq3s-grid-at [entry j]
  (let [e (+ (* entry 4) j)]
    (g-iq3s-value (code4 (lit-8 (quot e 2)) e))))



;; ------------------------------------------------------------------ readers

(defn- u8-at [base len off]
  (kernel-load-u8 (kernel-subregion base len off 1) 1 0))

(defn- s8-at [base len off]
  (let [v (u8-at base len off)]
    (if (> v 127) (- v 256) v)))

(defn- u16-at [base len off]
  (+ (u8-at base len off) (* 256 (u8-at base len (+ off 1)))))

(defn- u32-at [base len off]
  (+ (u16-at base len off) (* 65536 (u16-at base len (+ off 2)))))

(defn- f32w [u]
  (if (> u 2147483647) (- u 4294967296) u))

(defn- u32w [v]
  (bit-and v 4294967295))

;; A function on this target returns a WORD, never a float value, so every
;; helper below that computes a binary32 hands back its bit pattern
;; (`f32-to-bits`) and the caller re-enters float arithmetic with
;; `(f32-from-bits (f32w bits))`. `i2f` is the one exception: it is an
;; operation used inline, not a function.
;;
;; binary32 constants as bit patterns:
;;   0.5f 1056964608, 0.25f 1048576000, 1.0f 1065353216, -1.0f -1082130432,
;;   0.125f 1040187392, -0.125f -1107296256

;; --------------------------------------------------- fp16 -> binary32 pattern

(defn- fp16-sub [sign m u]
  (if (= (bit-and m 1024) 0)
    (fp16-sub sign (* m 2) (- u 1))
    (bit-or sign (bit-or (* (+ u 127) 8388608) (* (bit-and m 1023) 8192)))))

(defn- fp16-bits [h]
  (let [sign (* (bit-and h 32768) 65536)
        e (bit-and (quot h 1024) 31)
        m (bit-and h 1023)]
    (if (= e 0)
      (if (= m 0) sign (fp16-sub sign m -14))
      (if (= e 31)
        (bit-or sign (bit-or 2139095040 (* m 8192)))
        (bit-or sign (bit-or (* (+ e 112) 8388608) (* m 8192)))))))

(defn- fp16-at [src slen off]
  ;; the fp16 at `off` as a binary32 BIT PATTERN (signed word)
  (f32w (fp16-bits (u16-at src slen off))))

;; ------------------------------------------------------------ small tables
;;
;; `1 << k` for the shift counts the decoders use; this subset admits only
;; literal-count shifts, so a runtime count is a table lookup.

(defn- pow2-hi [k]
  (if (= k 16) 65536 (if (= k 17) 131072 (if (= k 18) 262144 (if (= k 19) 524288
    (if (= k 20) 1048576 (if (= k 21) 2097152 (if (= k 22) 4194304 (if (= k 23) 8388608
      (if (= k 24) 16777216 (if (= k 25) 33554432 (if (= k 26) 67108864 (if (= k 27) 134217728
        (if (= k 28) 268435456 (if (= k 29) 536870912 (if (= k 30) 1073741824 2147483648))))))))))))))))

(defn- pow2 [k]
  ;; 1 << k for k in 0..31 (the widest shift here is `aux32 >> 28`)
  (if (> k 15)
    (pow2-hi k)
    (if (= k 0) 1 (if (= k 1) 2 (if (= k 2) 4 (if (= k 3) 8
      (if (= k 4) 16 (if (= k 5) 32 (if (= k 6) 64 (if (= k 7) 128
        (if (= k 8) 256 (if (= k 9) 512 (if (= k 10) 1024 (if (= k 11) 2048
          (if (= k 12) 4096 (if (= k 13) 8192 (if (= k 14) 16384 32768)))))))))))))))))

(defn- shr [v k] (quot v (pow2 k)))
(defn- shl [v k] (* v (pow2 k)))

;; ------------------------------------------------------- the codebook grids
;;
;; In `aiueos.lib.qwen35-grids`, packed (a program's literals are capped at
;; 64 KiB of UTF-8 and the raw tables' hex is ~70 KiB; every IQ grid byte is
;; one of three or eight values).

;; `(signs & kmask[j]) ? -1.f : 1.f`
(defn- sign-of [signs j]
  ;; +1.0f or -1.0f as a bit pattern
  (if (= (bit-and signs (kmask-at j)) 0) 1065353216 -1082130432))

;; --------------------------------------------------------------- F32 (copy)

(defn- f32-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32 (kernel-subregion dst dn (* i 4) 4) 4 0
                          (kernel-load-u32 (kernel-subregion src slen (* i 4) 4) 4 0))
        (f32-el src slen dst dn (+ i 1)))))

;; ---------------------------------------------------- Q8_0 (34-byte blocks)

(defn- q80-value [src slen base j]
  (f32-to-bits
   (f32-mul (i64-to-f32-rounded (s8-at src slen (+ base (+ 2 j))))
            (f32-from-bits (fp16-at src slen base)))))

(defn- q80-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (u32w (q80-value src slen (* 34 (quot i 32)) (- i (* 32 (quot i 32))))))
        (q80-el src slen dst dn (+ i 1)))))

;; ---------------------------------------------------- Q2_K (84-byte blocks)
;;
;; scales[16] @0, qs[64] @16, d @80, dmin @82. Element r: group n = r/128,
;; t = r%128, j = t/32 (shift 2j), sub = (t%32)/16, l = t%16;
;; is = 8n + 2j + sub, q = qs[32n + 16sub + l];
;; y = (d * (sc & 0xF)) * ((q >> shift) & 3) - (min * (sc >> 4)).

(defn- q2k-value [src slen base r]
  (let [n (quot r 128)
        t (- r (* 128 n))
        j (quot t 32)
        sub (quot (- t (* 32 j)) 16)
        l (- t (* 16 (quot t 16)))
        sc (u8-at src slen (+ base (+ (* 8 n) (+ (* 2 j) sub))))
        q (u8-at src slen (+ base (+ 16 (+ (* 32 n) (+ (* 16 sub) l)))))
        v (bit-and (shr q (* 2 j)) 3)]
    (f32-to-bits
     (f32-sub (f32-mul (f32-mul (f32-from-bits (fp16-at src slen (+ base 80))) (i64-to-f32-rounded (bit-and sc 15)))
                       (i64-to-f32-rounded v))
              (f32-mul (f32-from-bits (fp16-at src slen (+ base 82))) (i64-to-f32-rounded (quot sc 16)))))))

(defn- q2k-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (u32w (q2k-value src slen (* 84 (quot i 256)) (- i (* 256 (quot i 256))))))
        (q2k-el src slen dst dn (+ i 1)))))

;; --------------------------------------------------- Q3_K (110-byte blocks)
;;
;; hmask[32] @0, qs[64] @32, scales[12] @96, d @108. The C unpacks the twelve
;; scale bytes into sixteen int8 scales through four u32 lane operations;
;; per byte `is` (word w = is/4, lane b = is%4) that is:
;;   w0: (s[b]   & 0xf) | ((s[8+b]      & 3) << 4)
;;   w1: (s[4+b] & 0xf) | (((s[8+b] >> 2) & 3) << 4)
;;   w2: (s[b]   >> 4)  | (((s[8+b] >> 4) & 3) << 4)
;;   w3: (s[4+b] >> 4)  | (((s[8+b] >> 6) & 3) << 4)
;; then `scales[is] - 32` as int8 (the unpacked byte is < 64, so signed and
;; unsigned agree).

(defn- q3k-scale [src slen sbase is]
  (let [w (quot is 4)
        b (- is (* 4 w))
        lo (if (= w 0) (bit-and (u8-at src slen (+ sbase b)) 15)
             (if (= w 1) (bit-and (u8-at src slen (+ sbase (+ 4 b))) 15)
               (if (= w 2) (quot (u8-at src slen (+ sbase b)) 16)
                 (quot (u8-at src slen (+ sbase (+ 4 b))) 16))))
        hi (bit-and (shr (u8-at src slen (+ sbase (+ 8 b))) (* 2 w)) 3)]
    (- (bit-or lo (* 16 hi)) 32)))

(defn- q3k-value [src slen base r]
  (let [n (quot r 128)
        t (- r (* 128 n))
        j (quot t 32)
        sub (quot (- t (* 32 j)) 16)
        l (- t (* 16 (quot t 16)))
        is (+ (* 8 n) (+ (* 2 j) sub))
        q (u8-at src slen (+ base (+ 32 (+ (* 32 n) (+ (* 16 sub) l)))))
        hm (u8-at src slen (+ base (+ (* 16 sub) l)))
        mbit (pow2 (+ (* 4 n) j))
        v (- (bit-and (shr q (* 2 j)) 3) (if (= (bit-and hm mbit) 0) 4 0))]
    (f32-to-bits
     (f32-mul (f32-mul (f32-from-bits (fp16-at src slen (+ base 108))) (i64-to-f32-rounded (q3k-scale src slen (+ base 96) is)))
              (i64-to-f32-rounded v)))))

(defn- q3k-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (u32w (q3k-value src slen (* 110 (quot i 256)) (- i (* 256 (quot i 256))))))
        (q3k-el src slen dst dn (+ i 1)))))

;; --------------------------------------------------- Q4_K (144-byte blocks)

(defn- k4-scale [src slen sbase j]
  (if (< j 4)
    (bit-and (u8-at src slen (+ sbase j)) 63)
    (bit-or (bit-and (u8-at src slen (+ sbase (+ j 4))) 15)
            (* 16 (quot (u8-at src slen (+ sbase (- j 4))) 64)))))

(defn- k4-min [src slen sbase j]
  (if (< j 4)
    (bit-and (u8-at src slen (+ sbase (+ j 4))) 63)
    (bit-or (quot (u8-at src slen (+ sbase (+ j 4))) 16)
            (* 16 (quot (u8-at src slen (+ sbase j)) 64)))))

(defn- q4k-value [src slen base r]
  (let [step (quot r 64)
        inner (- r (* 64 step))
        low (< inner 32)
        j (+ (* 2 step) (if low 0 1))
        l (if low inner (- inner 32))
        q (u8-at src slen (+ base (+ 16 (+ (* 32 step) l))))
        v (if low (bit-and q 15) (quot q 16))]
    (f32-to-bits
     (f32-sub (f32-mul (f32-mul (f32-from-bits (fp16-at src slen base))
                                (i64-to-f32-rounded (k4-scale src slen (+ base 4) j)))
                       (i64-to-f32-rounded v))
              (f32-mul (f32-from-bits (fp16-at src slen (+ base 2)))
                       (i64-to-f32-rounded (k4-min src slen (+ base 4) j)))))))

(defn- q4k-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (u32w (q4k-value src slen (* 144 (quot i 256)) (- i (* 256 (quot i 256))))))
        (q4k-el src slen dst dn (+ i 1)))))

;; --------------------------------------------------- Q5_K (176-byte blocks)
;;
;; d @0, dmin @2, scales[12] @4, qh[32] @16, qs[128] @48. Q4_K's shape plus
;; one high bit per element from qh[l], bit 2*step (low half) or 2*step+1.

(defn- q5k-value [src slen base r]
  (let [step (quot r 64)
        inner (- r (* 64 step))
        low (< inner 32)
        j (+ (* 2 step) (if low 0 1))
        l (if low inner (- inner 32))
        q (u8-at src slen (+ base (+ 48 (+ (* 32 step) l))))
        h (u8-at src slen (+ base (+ 16 l)))
        hbit (pow2 (+ (* 2 step) (if low 0 1)))
        v (+ (if low (bit-and q 15) (quot q 16)) (if (= (bit-and h hbit) 0) 0 16))]
    (f32-to-bits
     (f32-sub (f32-mul (f32-mul (f32-from-bits (fp16-at src slen base))
                                (i64-to-f32-rounded (k4-scale src slen (+ base 4) j)))
                       (i64-to-f32-rounded v))
              (f32-mul (f32-from-bits (fp16-at src slen (+ base 2)))
                       (i64-to-f32-rounded (k4-min src slen (+ base 4) j)))))))

(defn- q5k-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (u32w (q5k-value src slen (* 176 (quot i 256)) (- i (* 256 (quot i 256))))))
        (q5k-el src slen dst dn (+ i 1)))))

;; --------------------------------------------------- Q6_K (210-byte blocks)

(defn- pow4 [g]
  (if (= g 0) 1 (if (= g 1) 4 (if (= g 2) 16 64))))

(defn- q6k-value [src slen base r]
  (let [half (quot r 128)
        t (- r (* 128 half))
        grp (quot t 32)
        l (- t (* 32 grp))
        odd (- grp (* 2 (quot grp 2)))
        qv (u8-at src slen (+ base (+ (* 64 half) (+ l (* 32 odd)))))
        nib (if (< grp 2) (bit-and qv 15) (quot qv 16))
        hi (bit-and (quot (u8-at src slen (+ base (+ 128 (+ (* 32 half) l)))) (pow4 grp)) 3)
        q (- (bit-or nib (* 16 hi)) 32)
        sc (s8-at src slen (+ base (+ 192 (+ (* 8 half) (+ (quot l 16) (* 2 grp))))))]
    (f32-to-bits
     (f32-mul (f32-mul (f32-from-bits (fp16-at src slen (+ base 208)))
                       (i64-to-f32-rounded sc))
              (i64-to-f32-rounded q)))))

(defn- q6k-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (u32w (q6k-value src slen (* 210 (quot i 256)) (- i (* 256 (quot i 256))))))
        (q6k-el src slen dst dn (+ i 1)))))

;; ------------------------------------------------ IQ2_XXS (66-byte blocks)
;;
;; d @0, qs[32] u16 @2. Per 32 elements ib32: aux32[0] = u32 at 2 + 8 ib32
;; (its four bytes are the four grid entries), aux32[1] the next u32 (the
;; scale in its top nibble, seven sign bits per l);
;; db = d * (0.5f + (aux32[1] >> 28)) * 0.25f;
;; y = db * grid[j] * sign, grid = iq2xxs_grid[aux8[l]], signs = ksigns[(aux1 >> 7l) & 127].

(defn- iq2xxs-db [src slen base ib32]
  (let [aux1 (u32-at src slen (+ base (+ 2 (+ (* 8 ib32) 4))))]
    (f32-to-bits
     (f32-mul (f32-mul (f32-from-bits (fp16-at src slen base))
                      (f32-add (f32-from-bits 1056964608) (i64-to-f32-rounded (shr aux1 28))))
             (f32-from-bits 1048576000)))))

(defn- iq2xxs-value [src slen base r]
  (let [ib32 (quot r 32)
        t (- r (* 32 ib32))
        l (quot t 8)
        j (- t (* 8 l))
        entry (u8-at src slen (+ base (+ 2 (+ (* 8 ib32) l))))
        aux1 (u32-at src slen (+ base (+ 2 (+ (* 8 ib32) 4))))
        signs (ksigns-at (bit-and (shr aux1 (* 7 l)) 127))]
    (f32-to-bits
     (f32-mul (f32-mul (f32-from-bits (iq2xxs-db src slen base ib32))
                       (i64-to-f32-rounded (iq2xxs-grid-at entry j)))
              (f32-from-bits (sign-of signs j))))))

(defn- iq2xxs-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (u32w (iq2xxs-value src slen (* 66 (quot i 256)) (- i (* 256 (quot i 256))))))
        (iq2xxs-el src slen dst dn (+ i 1)))))

;; ------------------------------------------------- IQ2_XS (74-byte blocks)
;;
;; d @0, qs[32] u16 @2, scales[8] @66. q = qs[4 ib32 + l]: grid entry
;; q & 511, signs ksigns[q >> 9]; db = d * (0.5f + nibble) * 0.25f with the
;; low nibble of scales[ib32] for l < 2 and the high one for l >= 2.

(defn- iq2xs-db [src slen base r]
  (let [ib32 (quot r 32)
        l (quot (- r (* 32 ib32)) 8)
        sc (u8-at src slen (+ base (+ 66 ib32)))
        nib (if (< l 2) (bit-and sc 15) (quot sc 16))]
    (f32-to-bits
     (f32-mul (f32-mul (f32-from-bits (fp16-at src slen base))
                      (f32-add (f32-from-bits 1056964608) (i64-to-f32-rounded nib)))
             (f32-from-bits 1048576000)))))

(defn- iq2xs-value [src slen base r]
  (let [ib32 (quot r 32)
        t (- r (* 32 ib32))
        l (quot t 8)
        j (- t (* 8 l))
        q (u16-at src slen (+ base (+ 2 (* 2 (+ (* 4 ib32) l)))))
        signs (ksigns-at (quot q 512))]
    (f32-to-bits
     (f32-mul (f32-mul (f32-from-bits (iq2xs-db src slen base r))
                       (i64-to-f32-rounded (iq2xs-grid-at (bit-and q 511) j)))
              (f32-from-bits (sign-of signs j))))))

(defn- iq2xs-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (u32w (iq2xs-value src slen (* 74 (quot i 256)) (- i (* 256 (quot i 256))))))
        (iq2xs-el src slen dst dn (+ i 1)))))

;; -------------------------------------------------- IQ2_S (82-byte blocks)
;;
;; d @0, qs[64] @2 (the first 32 are grid bytes, the next 32 the signs),
;; qh[8] @66, scales[8] @74. Grid entry qs[4 ib32 + l] | ((qh[ib32] << (8 - 2l)) & 0x300);
;; signs byte = qs[32 + 4 ib32 + l]; db as IQ2_XS from scales[ib32].

(defn- iq2s-db [src slen base r]
  (let [ib32 (quot r 32)
        l (quot (- r (* 32 ib32)) 8)
        sc (u8-at src slen (+ base (+ 74 ib32)))
        nib (if (< l 2) (bit-and sc 15) (quot sc 16))]
    (f32-to-bits
     (f32-mul (f32-mul (f32-from-bits (fp16-at src slen base))
                      (f32-add (f32-from-bits 1056964608) (i64-to-f32-rounded nib)))
             (f32-from-bits 1048576000)))))

(defn- iq2s-value [src slen base r]
  (let [ib32 (quot r 32)
        t (- r (* 32 ib32))
        l (quot t 8)
        j (- t (* 8 l))
        q (u8-at src slen (+ base (+ 2 (+ (* 4 ib32) l))))
        qh (u8-at src slen (+ base (+ 66 ib32)))
        entry (bit-or q (bit-and (shl qh (- 8 (* 2 l))) 768))
        signs (u8-at src slen (+ base (+ 34 (+ (* 4 ib32) l))))]
    (f32-to-bits
     (f32-mul (f32-mul (f32-from-bits (iq2s-db src slen base r))
                       (i64-to-f32-rounded (iq2s-grid-at entry j)))
              (f32-from-bits (sign-of signs j))))))

(defn- iq2s-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (u32w (iq2s-value src slen (* 82 (quot i 256)) (- i (* 256 (quot i 256))))))
        (iq2s-el src slen dst dn (+ i 1)))))

;; ------------------------------------------------ IQ3_XXS (98-byte blocks)
;;
;; d @0, qs[64] @2, scales_and_signs[32] @66 as u32 per ib32. Per l two grid
;; entries qs[8 ib32 + 2l] (elements 0..3) and qs[8 ib32 + 2l + 1] (4..7),
;; four bytes each from iq3xxs_grid; db = d * (0.5f + (aux32 >> 28)) * 0.5f;
;; signs ksigns[(aux32 >> 7l) & 127], bit j for the first entry, 4 + j for the second.

(defn- iq3xxs-value [src slen base r]
  (let [ib32 (quot r 32)
        t (- r (* 32 ib32))
        l (quot t 8)
        e (- t (* 8 l))
        half (quot e 4)
        j (- e (* 4 half))
        aux (u32-at src slen (+ base (+ 66 (* 4 ib32))))
        entry (u8-at src slen (+ base (+ 2 (+ (* 8 ib32) (+ (* 2 l) half)))))
        signs (ksigns-at (bit-and (shr aux (* 7 l)) 127))
        db (f32-mul (f32-mul (f32-from-bits (fp16-at src slen base))
                             (f32-add (f32-from-bits 1056964608) (i64-to-f32-rounded (shr aux 28))))
                    (f32-from-bits 1056964608))]
    (f32-to-bits
     (f32-mul (f32-mul db (i64-to-f32-rounded (iq3xxs-grid-at entry j)))
              (f32-from-bits (sign-of signs (+ j (* 4 half))))))))

(defn- iq3xxs-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (u32w (iq3xxs-value src slen (* 98 (quot i 256)) (- i (* 256 (quot i 256))))))
        (iq3xxs-el src slen dst dn (+ i 1)))))

;; -------------------------------------------------- IQ3_S (110-byte blocks)
;;
;; d @0, qs[64] @2, qh[8] @66, signs[32] @74, scales[4] @106. Sub-blocks come
;; in pairs: scales[ib32/2]'s low nibble for the even sub-block, high for the
;; odd, db = d * (1 + 2 nibble). Grid entry qs[8 ib32 + 2l + half] |
;; ((qh[ib32] << (8 - 2l - half)) & 256); signs byte = signs[4 ib32 + l],
;; bit j (first entry) or 4 + j (second).

(defn- iq3s-value [src slen base r]
  (let [ib32 (quot r 32)
        t (- r (* 32 ib32))
        l (quot t 8)
        e (- t (* 8 l))
        half (quot e 4)
        j (- e (* 4 half))
        pair (quot ib32 2)
        odd (- ib32 (* 2 pair))
        sc (u8-at src slen (+ base (+ 106 pair)))
        nib (if (= odd 0) (bit-and sc 15) (quot sc 16))
        db (f32-mul (f32-from-bits (fp16-at src slen base)) (i64-to-f32-rounded (+ 1 (* 2 nib))))
        q (u8-at src slen (+ base (+ 2 (+ (* 8 ib32) (+ (* 2 l) half)))))
        qh (u8-at src slen (+ base (+ 66 ib32)))
        entry (bit-or q (bit-and (shl qh (- (- 8 (* 2 l)) half)) 256))
        signs (u8-at src slen (+ base (+ 74 (+ (* 4 ib32) l))))]
    (f32-to-bits
     (f32-mul (f32-mul db (i64-to-f32-rounded (iq3s-grid-at entry j)))
              (f32-from-bits (sign-of signs (+ j (* 4 half))))))))

(defn- iq3s-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (u32w (iq3s-value src slen (* 110 (quot i 256)) (- i (* 256 (quot i 256))))))
        (iq3s-el src slen dst dn (+ i 1)))))

;; -------------------------------------------------- IQ1_S (50-byte blocks)
;;
;; d @0, qs[32] @2, qh[8] u16 @34. dl = d * (2 ((qh >> 12) & 7) + 1);
;; delta = +-0.125f by bit 15 of qh; entry qs[4 ib + l] | (((qh >> 3l) & 7) << 8);
;; y = dl * (grid[j] + delta) with the grid read as int8.

(defn- iq1s-value [src slen base r]
  (let [ib (quot r 32)
        t (- r (* 32 ib))
        l (quot t 8)
        j (- t (* 8 l))
        qh (u16-at src slen (+ base (+ 34 (* 2 ib))))
        dl (f32-mul (f32-from-bits (fp16-at src slen base)) (i64-to-f32-rounded (+ 1 (* 2 (bit-and (shr qh 12) 7)))))
        delta (if (= (bit-and qh 32768) 0) 1040187392 -1107296256)
        entry (bit-or (u8-at src slen (+ base (+ 2 (+ (* 4 ib) l))))
                      (* 256 (bit-and (shr qh (* 3 l)) 7)))]
    (f32-to-bits
     (f32-mul dl (f32-add (i64-to-f32-rounded (iq1s-grid-at entry j)) (f32-from-bits delta))))))

(defn- iq1s-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (u32w (iq1s-value src slen (* 50 (quot i 256)) (- i (* 256 (quot i 256))))))
        (iq1s-el src slen dst dn (+ i 1)))))

;; -------------------------------------------------- IQ1_M (56-byte blocks)
;;
;; qs[32] @0, qh[16] @32, scales[8] @48 read as four u16 sc[0..3]. The block
;; scale is an fp16 assembled from the top nibbles of the four:
;; (sc0 >> 12) | ((sc1 >> 8) & 0xf0) | ((sc2 >> 4) & 0xf00) | (sc3 & 0xf000).
;; Per ib: dl1 = d (2 ((sc[ib/2] >> (6 (ib%2))) & 7) + 1) for l < 2,
;; dl2 with the shift + 3 for l >= 2; entries and deltas from qs[4 ib + l] and
;; qh[2 ib + l/2] (bits 8..10 or 4..6 of the entry; bit 3 or 7 for the delta).

(defn- iq1m-d [src slen base]
  (let [s0 (u16-at src slen (+ base 48))
        s1 (u16-at src slen (+ base 50))
        s2 (u16-at src slen (+ base 52))
        s3 (u16-at src slen (+ base 54))]
    (f32-to-bits
     (f32-from-bits (f32w (fp16-bits (bit-or (shr s0 12)
                                            (bit-or (bit-and (shr s1 8) 240)
                                                    (bit-or (bit-and (shr s2 4) 3840)
                                                            (bit-and s3 61440))))))))))

(defn- iq1m-value [src slen base r]
  (let [ib (quot r 32)
        t (- r (* 32 ib))
        l (quot t 8)
        j (- t (* 8 l))
        sc (u16-at src slen (+ base (+ 48 (* 2 (quot ib 2)))))
        odd (- ib (* 2 (quot ib 2)))
        shift (+ (* 6 odd) (if (< l 2) 0 3))
        dl (f32-mul (f32-from-bits (iq1m-d src slen base)) (i64-to-f32-rounded (+ 1 (* 2 (bit-and (shr sc shift) 7)))))
        q (u8-at src slen (+ base (+ (* 4 ib) l)))
        qh (u8-at src slen (+ base (+ 32 (+ (* 2 ib) (quot l 2)))))
        lowhalf (= (- l (* 2 (quot l 2))) 0)
        entry (bit-or q (bit-and (if lowhalf (shl qh 8) (shl qh 4)) 1792))
        delta (if (= (bit-and qh (if lowhalf 8 128)) 0) 1040187392 -1107296256)]
    (f32-to-bits
     (f32-mul dl (f32-add (i64-to-f32-rounded (iq1s-grid-at entry j)) (f32-from-bits delta))))))

(defn- iq1m-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (u32w (iq1m-value src slen (* 56 (quot i 256)) (- i (* 256 (quot i 256))))))
        (iq1m-el src slen dst dn (+ i 1)))))

;; ------------------------------------------------- IQ4_XS (136-byte blocks)
;;
;; d @0, scales_h u16 @2, scales_l[4] @4, qs[128] @8. ls = (scales_l[ib/2]
;; nibble by ib%2) | (((scales_h >> 2 ib) & 3) << 4); dl = d (ls - 32);
;; y = dl * kvalues_iq4nl[nibble of qs[16 ib + j%16]] (low nibble for j < 16).

(defn- iq4xs-value [src slen base r]
  (let [ib (quot r 32)
        j (- r (* 32 ib))
        sl (u8-at src slen (+ base (+ 4 (quot ib 2))))
        odd (- ib (* 2 (quot ib 2)))
        lo (if (= odd 0) (bit-and sl 15) (quot sl 16))
        sh (u16-at src slen (+ base 2))
        ls (bit-or lo (* 16 (bit-and (shr sh (* 2 ib)) 3)))
        dl (f32-mul (f32-from-bits (fp16-at src slen base)) (i64-to-f32-rounded (- ls 32)))
        jq (if (< j 16) j (- j 16))
        q (u8-at src slen (+ base (+ 8 (+ (* 16 ib) jq))))
        kv (iq4nl-at (if (< j 16) (bit-and q 15) (quot q 16)))]
    (f32-to-bits (f32-mul dl (i64-to-f32-rounded kv)))))

(defn- iq4xs-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (u32w (iq4xs-value src slen (* 136 (quot i 256)) (- i (* 256 (quot i 256))))))
        (iq4xs-el src slen dst dn (+ i 1)))))

;; ------------------------------------------------ PTQ1_0 (28-byte blocks)
;;
;; Prism's group-128 ternary (ggml type 143; ADR-0222 stage A). qs[24] @0
;; (5 trits per byte, 120 values), qh[2] @24 (4 trits per byte, 8 values),
;; d fp16 @26. Same base-3 packing as upstream TQ1_0 with one scale per 128.
;; Port of `dequantize_row_ptq1_0`, PrismML-Enllama.cpp
;; @9a9394a895b96003ca842a6041cb28ac49a108f7 (`ggml/src/ggml-quants.c:2255`,
;; MIT), whose element order is: stage 16 -- qs[m] for n 0..4, m 0..15 (80
;; values); stage 8 -- qs[16 + m] for n 0..4, m 0..7 (40); then qh[h] for
;; n 0..3, h 0..1 (8). A trit is `((uint8)(byte * 3^n) * 3) >> 8` in 0..2 and
;; the value is `(float)(trit - 1) * d` -- one multiply by -1, 0 or +1, so
;; the C's operand order is the only order and the result is exact.
;;
;; Element e of a block: e < 80 -> byte qs[e mod 16], n = e / 16;
;; 80 <= e < 120 -> q = e - 80, byte qs[16 + q mod 8], n = q / 8;
;; e >= 120 -> q = e - 120, byte qh[q mod 2], n = q / 2.

(defn- pow3 [n]
  (if (= n 0) 1 (if (= n 1) 3 (if (= n 2) 9 (if (= n 3) 27 81)))))

(defn- ptq10-trit [byte n]
  ;; ((uint8_t)(byte * pow3[n]) * 3) >> 8
  (quot (* (bit-and (* byte (pow3 n)) 255) 3) 256))

(defn- ptq10-value [src slen base e]
  (let [b (if (< e 80)
               (u8-at src slen (+ base (- e (* 16 (quot e 16)))))
               (if (< e 120)
                 (u8-at src slen (+ base (+ 16 (- (- e 80) (* 8 (quot (- e 80) 8))))))
                 (u8-at src slen (+ base (+ 24 (- (- e 120) (* 2 (quot (- e 120) 2))))))))
        n (if (< e 80) (quot e 16) (if (< e 120) (quot (- e 80) 8) (quot (- e 120) 2)))]
    (f32-to-bits
     (f32-mul (i64-to-f32-rounded (- (ptq10-trit b n) 1))
              (f32-from-bits (fp16-at src slen (+ base 26)))))))

(defn- ptq10-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (u32w (ptq10-value src slen (* 28 (quot i 128)) (- i (* 128 (quot i 128))))))
        (ptq10-el src slen dst dn (+ i 1)))))

;; --------------------------------------------------------- BF16 (2 bytes)
;;
;; ggml type 30: the upper half of a binary32. y = bits << 16, no arithmetic
;; (ggml `ggml_bf16_to_fp32`). Bonsai's `ssm_alpha` / `ssm_beta` projections.

(defn- bf16-el [src slen dst dn i]
  (if (>= i (quot dn 4))
    0
    (do (kernel-store-u32
         (kernel-subregion dst dn (* i 4) 4) 4 0
         (* 65536 (u16-at src slen (* i 2))))
        (bf16-el src slen dst dn (+ i 1)))))

;; ------------------------------------------------------------------ the row
;;
;; `aiueos_qwen35_quant_row_bytes` for all fifteen Qwen3.8 types plus the two
;; Bonsai adds (ADR-0222); -1 for a type not decoded here or a count that is
;; not a multiple of the block, which cannot collide with a real byte count.
;; ggml type ids: F32 0, Q8_0 8, Q2_K 10, Q3_K 11, Q4_K 12, Q5_K 13, Q6_K 14,
;; IQ2_XXS 16, IQ2_XS 17, IQ3_XXS 18, IQ1_S 19, IQ3_S 21, IQ2_S 22, IQ4_XS 23,
;; IQ1_M 29, BF16 30, PTQ1_0 143. The 256-element block table below does not
;; hold BF16 (per element) or PTQ1_0 (128-element blocks); `row-bytes` names
;; them first.

(defn- block-bytes [qtype]
  (if (= qtype 10) 84 (if (= qtype 11) 110 (if (= qtype 12) 144 (if (= qtype 13) 176
    (if (= qtype 14) 210 (if (= qtype 16) 66 (if (= qtype 17) 74 (if (= qtype 18) 98
      (if (= qtype 19) 50 (if (= qtype 21) 110 (if (= qtype 22) 82 (if (= qtype 23) 136
        (if (= qtype 29) 56 -1))))))))))))))

(defn- row-bytes [qtype count]
  (if (= qtype 0) (* count 4)
   (if (= qtype 30) (* count 2)
   (if (= qtype 143)
     (if (= 0 (- count (* 128 (quot count 128)))) (* 28 (quot count 128)) -1)
    (if (= qtype 8)
      (if (= 0 (- count (* 32 (quot count 32)))) (* 34 (quot count 32)) -1)
      (if (< (block-bytes qtype) 0)
        -1
        (if (= 0 (- count (* 256 (quot count 256))))
          (* (block-bytes qtype) (quot count 256))
          -1)))))))

(defn- supported [qtype]
  (if (= qtype 0) 1 (if (= qtype 8) 1 (if (= qtype 30) 1 (if (= qtype 143) 1
    (if (< (block-bytes qtype) 0) 0 1))))))

(defn- dequant-run [qtype src slen dst dn]
  (if (= qtype 0) (f32-el src slen dst dn 0)
   (if (= qtype 30) (bf16-el src slen dst dn 0)
   (if (= qtype 143) (ptq10-el src slen dst dn 0)
    (if (= qtype 8) (q80-el src slen dst dn 0)
      (if (= qtype 10) (q2k-el src slen dst dn 0)
        (if (= qtype 11) (q3k-el src slen dst dn 0)
          (if (= qtype 12) (q4k-el src slen dst dn 0)
            (if (= qtype 13) (q5k-el src slen dst dn 0)
              (if (= qtype 14) (q6k-el src slen dst dn 0)
                (if (= qtype 16) (iq2xxs-el src slen dst dn 0)
                  (if (= qtype 17) (iq2xs-el src slen dst dn 0)
                    (if (= qtype 18) (iq3xxs-el src slen dst dn 0)
                      (if (= qtype 19) (iq1s-el src slen dst dn 0)
                        (if (= qtype 21) (iq3s-el src slen dst dn 0)
                          (if (= qtype 22) (iq2s-el src slen dst dn 0)
                            (if (= qtype 23) (iq4xs-el src slen dst dn 0)
                              (iq1m-el src slen dst dn 0))))))))))))))))))


(defn- plan-u32 [plan pn slot]
  (kernel-load-u32 plan pn slot))

(defn- plan-u64 [plan pn slot]
  (+ (kernel-load-u32 plan pn slot)
     (* 4294967296 (kernel-load-u32 plan pn (+ slot 4)))))

(defn- s32 [u]
  (if (> u 2147483647) (- u 4294967296) u))

(defn- f32-word-at [base blen i]
  (let [u (kernel-load-u32 (kernel-subregion base blen (* i 4) 4) 4 0)]
    (if (> u 2147483647) (- u 4294967296) u)))

(defn- dot-lane [a alen b blen ka]
  (let [k (u64-shift-right ka 32)
        acc (s32 (bit-and ka 4294967295))]
    (if (>= k (* 4 (quot (quot alen 4) 4)))
      acc
      (dot-lane a alen b blen
        (+ (* 4294967296 (+ k 4))
           (u32w
            (f32-to-bits
             (f32-add (f32-from-bits acc)
                      (f32-mul (f32-from-bits (f32-word-at a alen k))
                               (f32-from-bits (f32-word-at b blen k)))))))))))

(defn- dot-tail [a alen b blen ia]
  (let [i (u64-shift-right ia 32)
        acc (s32 (bit-and ia 4294967295))]
    (if (>= i (quot alen 4))
      acc
      (dot-tail a alen b blen
        (+ (* 4294967296 (+ i 1))
           (u32w
            (f32-to-bits
             (f32-add (f32-from-bits acc)
                      (f32-mul (f32-from-bits (f32-word-at a alen i))
                               (f32-from-bits (f32-word-at b blen i)))))))))))

(defn- dot-run [a alen b blen]
  (let [l0 (dot-lane a alen b blen 0)
        l1 (dot-lane a alen b blen 4294967296)
        l2 (dot-lane a alen b blen 8589934592)
        l3 (dot-lane a alen b blen 12884901888)
        start (* 4 (quot (quot alen 4) 4))
        head (u32w
              (f32-to-bits
               (f32-add
                (f32-add (f32-from-bits (s32 l0)) (f32-from-bits (s32 l1)))
                (f32-add (f32-from-bits (s32 l2)) (f32-from-bits (s32 l3))))))]
    (dot-tail a alen b blen (+ (* 4294967296 start) head))))

(defn- dot-row [a alen b blen count]
  (if (= count (* 8 (quot count 8)))
    (if (> count 16384)
      (dot-run a alen b blen)
      (kernel-dot-f32 a alen b blen count))
    (dot-run a alen b blen)))

(defn- fused-ptq1 [qtype cols]
  (if (= qtype 143) (if (> cols 16384) 0 1) 0))

;; One row: the weights of the row (WLEN bytes, the tensor type's row size for ILEN / 4 columns), the input
;; (ILEN bytes of f32) and a scratch row (SLEN = ILEN bytes) the weights are dequantised into. The answer is the
;; row's dot product as f32 bits (0 .. 2^32 - 1), or a refusal below zero.
(defn kotoba_aiueos_qwen35_matvec_row [qtype weights weights-length input input-length scratch scratch-length]
  (if (= weights 0) -1
    (if (= input 0) -2
      (if (= scratch 0) -2
        (if (= (supported qtype) 0) -5
          (if (< input-length 4) -6
            (if (not (= input-length (* 4 (quot input-length 4)))) -6
              (if (> input-length 262144) -6
                (if (not (= scratch-length input-length)) -6
                  (if (< (row-bytes qtype (quot input-length 4)) 0) -6
                    (if (not (= weights-length (row-bytes qtype (quot input-length 4)))) -8
                      (if (= 1 (fused-ptq1 qtype (quot input-length 4)))
                        (u32w (kernel-dequant-dot-ptq1-0 weights weights-length input input-length
                                                            (quot (quot input-length 4) 128)))
                        (let [verdict (dequant-run qtype weights weights-length scratch scratch-length)]
                          (if (not (= verdict 0))
                            -12
                            (u32w (dot-row scratch scratch-length input input-length (quot input-length 4)))))))))))))))))

(defn- fits [alen off len]
  (if (< off 0) 0 (if (< len 0) 0 (if (> (+ off len) alen) 0 1))))

;; The plan check: every refusal the whole-tensor object made, -1 .. -11, and 0 when the plan's rows may be run. The
;; plan is read through its own length (96, checked first), each slot once.
(defn kotoba_aiueos_qwen35_matvec_check [arena arena-length plan plan-length]
  (if (= arena 0) -1
    (if (= plan 0) -2
      (if (not (= plan-length 96)) -3
        (let [qtype (plan-u32 plan plan-length 0)
              rows (plan-u64 plan plan-length 8)
              cols (plan-u64 plan plan-length 16)
              woff (plan-u64 plan plan-length 24)
              wbytes (plan-u64 plan plan-length 32)
              ioff (plan-u64 plan plan-length 40)
              ooff (plan-u64 plan plan-length 48)
              soff (plan-u64 plan plan-length 56)
              first (plan-u64 plan plan-length 64)
              end (plan-u64 plan plan-length 72)
              reserved (+ (plan-u32 plan plan-length 4)
                          (+ (plan-u64 plan plan-length 80) (plan-u64 plan plan-length 88)))]
          (if (not (= reserved 0)) -4
            (if (= (supported qtype) 0) -5
              (if (< cols 1) -6
                (if (> cols 65536) -6
                  (if (< (row-bytes qtype cols) 0) -6
                    (if (< rows 1) -7
                      (if (> rows 1048576) -7
                        (if (not (= wbytes (* rows (row-bytes qtype cols)))) -8
                          (if (< first 0) -9
                            (if (> end rows) -9
                              (if (> first end) -9
                                (if (> (* (- end first) cols) 2097152) -10
                                  (if (= 0 (fits arena-length woff (* rows (row-bytes qtype cols)))) -11
                                    (if (= 0 (fits arena-length ioff (* cols 4))) -11
                                      (if (= 0 (fits arena-length ooff (* rows 4))) -11
                                        (if (= 0 (fits arena-length soff (* cols 4))) -11
                                          0)))))))))))))))))))))
