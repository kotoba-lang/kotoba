  (if (< w 32) (if (< w 16) (if (< w 8) (if (< w 4) (if (< w 2) (if (< w 1) 4785091784081408 9570286648623123) (if (< w 3) 32933066200711217 77125311866798337)) (if (< w 6) (if (< w 5) 86132648562721057 144116768646103361) (if (< w 7) 153124659402113538 159598729898295842))) (if (< w 12) (if (< w 10) (if (< w 9) 216456958664180305 226590732147753735) (if (< w 11) 307375308906103664 360574345798681687)) (if (< w 14) (if (< w 13) 447269587825853703 510603390352361060) (if (< w 15) 1153783526141790019 1162790862981304336)))) (if (< w 24) (if (< w 20) (if (< w 18) (if (< w 17) 1172924043749363760 1229782873821679696) (if (< w 19) 1297900913404547360 1310567424811209232)) (if (< w 22) (if (< w 21) 1378122385605005938 1441454684866220849) (if (< w 23) 1523365801481999365 1666919023170884934))) (if (< w 28) (if (< w 26) (if (< w 25) 2310663277316675392 2316574389268652051) (if (< w 27) 2378781316901642289 2387225639230906629)) (if (< w 30) (if (< w 29) 2409462527468708144 2456469578734248448) (if (< w 31) 2468010215990239776 2527683843075416661))))) (if (< w 48) (if (< w 40) (if (< w 36) (if (< w 34) (if (< w 33) 2617475619079070576 2698823038428194051) (if (< w 35) 2829710916969506561 3468106042725904385)) (if (< w 38) (if (< w 37) 3490905872325947427 3544668396048232704) (if (< w 39) 3603779107529568580 3635023177851417104))) (if (< w 44) (if (< w 42) (if (< w 41) 3767036994940777233 3828680933993624690) (if (< w 43) 3919035707205891413 4618230329744832307)) (if (< w 46) (if (< w 45) 4636245067705040949 4773888410112770420) (if (< w 47) 4847354272392036960 4982463760188916740)))) (if (< w 56) (if (< w 52) (if (< w 50) (if (< w 49) 5120670864285648195 5782991435954407186) (if (< w 51) 5847450253757796464 5940901234534011221)) (if (< w 54) (if (< w 53) 6062781952464999170 6138781235577771047) (if (< w 55) 6927758069244122704 6998981280138682436))) (if (< w 60) (if (< w 58) (if (< w 57) 7147320791918928225 7301009019752440630) (if (< w 59) 8071408350337918515 80846474969847