;; The HTTP response heads of kernel/pci.c in Kotoba (JUN-552): net_http_cid_admit's status line and header terminator,
;; and rtl8125_http_success's status line, over the decrypted TLS application bytes.
;;
;; cid-body(app, n): the offset of the body -- 4 past the first CR LF CR LF -- when n >= 12, app starts "HTTP", app[5]
;; is '1' and app[9..12) is "200", as net_http_cid_admit required before hashing the body; else 0 (no terminator, too
;; short, another status). success(bytes, n): 1 when n >= 12 and bytes starts "HTTP/1.1 2" followed by two digits, as
;; rtl8125_http_success answered; else 0. n above 16384 (amu ADR 0386's windows; the TLS application buffer is 4096
;; bytes), a null pointer or a non-canonical n answers 0. The C keeps the body's SHA-256 and the digest comparison.
(ns aiueos.http-head (:export [kotoba_aiueos_http_cid_body kotoba_aiueos_http_success]))
(defn- canonical? [x :i64] :bool (= (u64-shift-right x 32) 0))
(defn- b [f :i64 n :i64 i :i64] :i64 (kernel-load-u8-16k f n i))
(defn- ok? [p :i64 n :i64] :bool (and (not= p 0) (canonical? n) (<= n 16384) (>= n 12)))
(defn- digit? [c :i64] :bool (and (>= c 48) (<= c 57)))
;; the first i >= at with i + 3 < n and p[i..i+4) = CR LF CR LF, or -1
(defn- crlf2 [p :i64 n :i64 i :i64] :i64
  (if (>= (+ i 3) n) -1
    (let [c0 (b p n i) c1 (b p n (+ i 1)) c2 (b p n (+ i 2)) c3 (b p n (+ i 3))]
      (if (and (= c0 13) (= c1 10) (= c2 13) (= c3 10)) i (crlf2 p n (+ i 1))))))
(defn kotoba_aiueos_http_cid_body [app :i64 n :i64] :i64
  (if (not (ok? app n)) 0
    (let [h (b app n 0) t1 (b app n 1) t2 (b app n 2) p (b app n 3) one (b app n 5)
          s2 (b app n 9) s0 (b app n 10) s00 (b app n 11)]
      (if (or (not= h 72) (not= t1 84) (not= t2 84) (not= p 80) (not= one 49) (not= s2 50) (not= s0 48) (not= s00 48)) 0
        (let [i (crlf2 app n 0)] (if (< i 0) 0 (+ i 4)))))))
(defn kotoba_aiueos_http_success [bytes :i64 n :i64] :i64
  (if (not (ok? bytes n)) 0
    (let [c0 (b bytes n 0) c1 (b bytes n 1) c2 (b bytes n 2) c3 (b bytes n 3) c4 (b bytes n 4) c5 (b bytes n 5)
          c6 (b bytes n 6) c7 (b bytes n 7) c8 (b bytes n 8) c9 (b bytes n 9) d1 (b bytes n 10) d2 (b bytes n 11)]
      (if (and (= c0 72) (= c1 84) (= c2 84) (= c3 80) (= c4 47) (= c5 49) (= c6 46) (= c7 49) (= c8 32) (= c9 50)
               (digit? d1) (digit? d2)) 1 0))))
