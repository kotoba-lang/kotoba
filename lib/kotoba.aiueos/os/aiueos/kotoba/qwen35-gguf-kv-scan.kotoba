(ns aiueos.qwen35-gguf-kv-scan
  (:export [aiueos-qwen35-gguf-kv-scan main]))

;; GGUF v3 metadata admission for the two artifacts this OS admits: the
;; Qwen3.8-27B artifact (`contracts/qwen38-qwen35-runtime-v1.edn`, profile 0)
;; and, since ADR-0222 stage A item 3, Ternary Bonsai 2 27B PTQ1_0
;; (`contracts/bonsai2-qwen35-runtime-v1.edn`, profile 1). A port of
;; `kernel/qwen35_runtime.c`'s `parse_metadata` plus the scalar half of
;; `exact_contract_valid`, with the Bonsai profile's Prism keys added.
;;
;; It walks the 50 (49) key/value pairs between the container header and the
;; tensor table, requires all 31 (40) keys the profile requires with the
;; values it requires, skips every other key by the C's own bounded rules,
;; and writes what it learned into a caller-owned 128-byte (144-byte)
;; workspace. The profile is decided from the container header's counts and
;; every constant follows from it -- see `profile` below.
;;
;; ## Return
;;
;; **Zero is the success value.** Non-zero is a REASON CODE, never a count:
;;
;;      0            admitted
;;     -1            null model base
;;     -2            null workspace
;;     -3            workspace is not the profile's length (128 / 144)
;;     -4            accessible window below the 24-byte header
;;     -5 .. -8      header: magic, version, tensor count (866 / 851 -- any
;;                   other count names no profile), metadata count (50 / 49)
;;     -9            a key string ran past the accessible window
;;    -10            the value that follows a key ran past it
;;    -11            an unknown key's value did not skip (bad type, nesting
;;                   deeper than the C admits, or an element count above the
;;                   C's 1,000,000 ceiling)
;;    -13            not all the profile's required keys were present, or a
;;                   key of the other profile was (a Prism key under profile
;;                   0; `nextn_predict_layers` under profile 1)
;;    -14            the metadata section did not end at 10,945,379 / 11,070,652
;;    -51 .. -85     a contract scalar disagreed; the code is -(50 + slot/4),
;;                   so the workspace slot names the field
;;   -100 .. -140    required key k carried the wrong GGUF value TYPE
;;   -200 .. -240    required key k carried the wrong VALUE, or its value ran
;;                   past the window
;;
;; The header clauses are repeated here rather than delegated to
;; `aiueos-qwen35-gguf-header-valid`: a kernel object exports one symbol and
;; cannot call another (ADR-0030). Their codes are deliberately the SAME
;; -5..-8, so the two objects do not disagree about what a bad magic is called.
;;
;; ## Workspace (128 bytes, u32 little-endian, all written by this object)
;;
;;     0  tensor-table offset (= metadata end)   10945379 / 11070652
;;     4  block_count                                  65 / 64
;;     8  context_length                           262144
;;    12  embedding_length                           5120
;;    16  feed_forward_length                       17408
;;    20  attention.head_count                         24
;;    24  attention.head_count_kv                       4
;;    28  attention.key_length                        256
;;    32  attention.value_length                      256
;;    36  ssm.group_count      (linear key heads)      16
;;    40  ssm.time_step_rank   (linear value heads)    48
;;    44  ssm.state_size                              128
;;    48  ssm.inner_size                             6144
;;    52  ssm.conv_kernel                               4
;;    56  full_attention_interval                       4
;;    60  rope.dimension_count                         64
;;    64  rope.dimension_sections[0]                   11
;;    68  rope.dimension_sections[1]                   11
;;    72  rope.dimension_sections[2]                   10
;;    76  rope.dimension_sections[3]                    0
;;    80  nextn_predict_layers                          1 / 0 (absent)
;;    84  vocabulary                               248320
;;    88  tokenizer bos                            248044
;;    92  tokenizer eos                            248046
;;    96  tokenizer padding                        248055 / 248044
;;   100  token array: file offset of the first element
;;   104  token array: element count               248320
;;   108  token array: file offset just past the last element
;;   112  merge array: file offset of the first element
;;   116  merge array: element count               247587
;;   120  merge array: file offset just past the last element
;;   124  required-key mask (bit 31 = profile)  2147483647 / 4294959103
;;   -- profile 1 only (workspace 144 bytes) --
;;   128  sign array: file offset of the first word     13360
;;   132  sign array: word count                        28672
;;   136  general.file_type                               143
;;   140  required-key mask, keys 31..40                 1023
;;
;; Slots 100..120 are what a later tokenizer stream needs and the C never
;; recorded: `read_expected_array_length` walks those two arrays to prove they
;; parse and then throws the coordinates away, so every later reader would have
;; to walk 495,907 length-prefixed strings again to find where they start.
;;
;; The data-section offset is NOT here. It is `align32(tensor_info_end)`, and
;; `tensor_info_end` is not known until the tensor table has been walked --
;; that is `aiueos-qwen35-tensor-table-bind`'s output, and putting the
;; artifact's expected value here would be transcribing a constant rather than
;; deriving one. Slot 0 is where that walk starts.
;;
;; ## Reading a 10.9 GiB region through a 512-byte window
;;
;; `kernel-load-u32` refuses a declared length above 512, so the region length
;; can never be handed to a load. Every access narrows with `kernel-subregion`
;; first, whose own offset/sub-length check is emitted by the backends -- so a
;; four-byte window at a computed offset is checked rather than asserted.
;;
;; ## Where this is deliberately narrower than the C
;;
;; `qwen35.attention.layer_norm_rms_epsilon` is a float32 and this dialect has
;; no float32, so the range check is done on the IEEE-754 BIT PATTERN, which is
;; monotonic in the value for positive finite floats. That admits exactly the
;; positive floats in [0.0000009f, 0.0000011f]. The C writes
;; `if (epsilon < 0.0000009f || epsilon > 0.0000011f) return 0;` and a NaN
;; compares false against both, so **the C admits NaN here and this object
;; refuses it**. The divergence is in the refusing direction, against a value
;; the admitted artifact does not carry (its epsilon is 1e-6f, bits
;; 897988541), and it is stated rather than discovered.

;; ---------------------------------------------------------------- readers

(defn u8-at [base length off]
  (kernel-load-u8 (kernel-subregion base length off 1) 1 0))

(defn u32-at [base length off]
  (kernel-load-u32 (kernel-subregion base length off 4) 4 0))

;; `low | (high << 32)` in the C. The product wraps modulo 2^64 exactly as the
;; C's uint64_t does, so the BITS agree; what differs is the reading, and every
;; caller that treats this as a length refuses a negative result before using
;; it -- which is the same refusal the C's unsigned comparison performs, since
;; a value at or above 2^63 cannot be a length inside an 11 MB prefix.
(defn u64-at [base length off]
  (+ (u32-at base length off)
     (* (u32-at base length (+ off 4)) 4294967296)))

;; ------------------------------------------------------- literal key table
;;
;; The 41 keys the two profiles require between them, then the eight expected
;; string VALUES (entries 41..48) so that one comparison routine serves both.
;; Eight ASCII bytes per word, five words per entry (an entry is at most 40
;; bytes): the high byte of a key is always below 0x80, so a packed word is a
;; positive i64 and `quot` is exact. The table was generated from the strings
;; and re-derived against the previous 34-entry table byte for byte.
;;
;;  0 general.architecture                     21 tokenizer.ggml.model
;;  1 general.name                             22 tokenizer.ggml.pre
;;  2 qwen35.block_count                       23 tokenizer.ggml.tokens
;;  3 qwen35.context_length                    24 tokenizer.ggml.token_type
;;  4 qwen35.embedding_length                  25 tokenizer.ggml.merges
;;  5 qwen35.feed_forward_length               26 tokenizer.ggml.eos_token_id
;;  6 qwen35.attention.head_count              27 tokenizer.ggml.padding_token_id
;;  7 qwen35.attention.head_count_kv           28 tokenizer.ggml.bos_token_id
;;  8 qwen35.rope.dimension_sections           29 general.quantization_version
;;  9 qwen35.rope.freq_base                    30 general.file_type
;; 10 qwen35.attention.layer_norm_rms_epsilon  -- Bonsai profile only (ADR-0222) --
;; 11 qwen35.attention.key_length              31 prism.hadamard.version
;; 12 qwen35.attention.value_length            32 prism.hadamard.block_size
;; 13 qwen35.nextn_predict_layers (Qwen3.8)    33 prism.hadamard.transform
;; 14 qwen35.ssm.conv_kernel                   34 prism.hadamard.axis
;; 15 qwen35.ssm.state_size                    35 prism.hadamard.sign_mode
;; 16 qwen35.ssm.group_count                   36 prism.hadamard.weight_names
;; 17 qwen35.ssm.time_step_rank                37 prism.hadamard.sign_widths
;; 18 qwen35.ssm.inner_size                    38 prism.hadamard.sign_values
;; 19 qwen35.full_attention_interval           39 prism.hadamard.inverse_weight_names
;; 20 qwen35.rope.dimension_count              40 prism.hadamard.gdn_v_grouped
;; values: 41 "qwen35"  42 "Qwen3.8-27B"  43 "gpt2"  44 "Hf"
;;         45 "normalized-sylvester-walsh-hadamard"  46 "input-last-dimension"
;;         47 "explicit"  48 "token_embd.weight"

