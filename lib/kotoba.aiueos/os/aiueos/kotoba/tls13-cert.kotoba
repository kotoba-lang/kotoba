;; The certificate parsers of kernel/tls13.c in Kotoba (JUN-553): find_p256_point (the leaf key behind the 27-byte P-256 SPKI
;; prefix) and parse_ecdsa_der (a DER ECDSA-Sig-Value into r || s, 32 bytes each), byte for byte the C's, including what the C
;; leaves written when it fails (r is written before s is parsed).
;;
;; Every input is a (base, length) region: the record buffers the C hands in are at most 12288 bytes, so the accesses use the
;; 16 KiB window tier and a region longer than 16384 bytes is refused (0) up front rather than trapping. The outputs are regions
;; too and must be at least 64 bytes, as the C's out[64] / rs[64] are. A uint32_t length with a non-zero upper half is refused.
;; Private helpers take at most five values, so der-int's copy packs (last source index, count, step) into one integer.
(ns aiueos.tls13-cert
  (:export [kotoba_aiueos_tls13_find_p256_point kotoba_aiueos_tls13_parse_ecdsa_der]))
(defn- canonical? [x :i64] :bool (= (u64-shift-right x 32) 0))
(defn- b [p :i64 n :i64 i :i64] :i64 (kernel-load-u8-16k p n i))
(defn- prefix-at? [p :i64 n :i64 i :i64] :bool
  ;; nested pairwise: `and` takes two operands
  (and (= (b p n (+ i 0)) 48) (and (= (b p n (+ i 1)) 89) (and (= (b p n (+ i 2)) 48) (and (= (b p n (+ i 3)) 19) (and (= (b p n (+ i 4)) 6) (and (= (b p n (+ i 5)) 7) (and (= (b p n (+ i 6)) 42) (and (= (b p n (+ i 7)) 134) (and (= (b p n (+ i 8)) 72) (and (= (b p n (+ i 9)) 206) (and (= (b p n (+ i 10)) 61) (and (= (b p n (+ i 11)) 2) (and (= (b p n (+ i 12)) 1) (and (= (b p n (+ i 13)) 6) (and (= (b p n (+ i 14)) 8) (and (= (b p n (+ i 15)) 42) (and (= (b p n (+ i 16)) 134) (and (= (b p n (+ i 17)) 72) (and (= (b p n (+ i 18)) 206) (and (= (b p n (+ i 19)) 61) (and (= (b p n (+ i 20)) 3) (and (= (b p n (+ i 21)) 1) (and (= (b p n (+ i 22)) 7) (and (= (b p n (+ i 23)) 3) (and (= (b p n (+ i 24)) 66) (and (= (b p n (+ i 25)) 0) (= (b p n (+ i 26)) 4))))))))))))))))))))))))))))
;; the first i with i + 27 + 64 <= n where the prefix starts, or -1
(defn- scan [p :i64 n :i64 i :i64] :i64
  (if (> (+ i 91) n) -1 (if (prefix-at? p n i) i (scan p n (+ i 1)))))
(defn- copy64 [s :i64 sn :i64 o :i64 on :i64 k :i64] :i64
  (if (>= k 64) 0 (let [w (kernel-store-u8 o on k (kernel-load-u8 s sn k))] (copy64 s sn o on (+ (+ k 1) (* 0 w))))))
(defn kotoba_aiueos_tls13_find_p256_point [p :i64 n :i64 out :i64 out-len :i64] :i64
  (if (or (not (canonical? n)) (not (canonical? out-len)) (< n 91) (> n 16384) (< out-len 64)) 0
    (let [at (scan p n 0)]
      (if (< at 0) 0
        (let [s (kernel-subregion p n (+ at 27) 64)] (+ 1 (* 0 (copy64 s 64 out out-len 0))))))))
;; while skip + 1 < len and p[at + skip] = 0: skip + 1
(defn- skip-zeros [p :i64 n :i64 at :i64 len :i64 skip :i64] :i64
  (if (and (< (+ skip 1) len) (= (b p n (+ at skip)) 0)) (skip-zeros p n at len (+ skip 1)) skip))
(defn- zero32 [r :i64 rn :i64 k :i64] :i64
  (if (>= k 32) 0 (let [w (kernel-store-u8 r rn k 0)] (zero32 r rn (+ (+ k 1) (* 0 w))))))
;; q = last << 32 | count << 16 | k: r[31 - k] = p[last - k] for k < count (the integer right-aligned, as the C's copy)
(defn- copy-int [p :i64 n :i64 r :i64 rn :i64 q :i64] :i64
  (let [last (u64-shift-right q 32) count (bit-and (u64-shift-right q 16) 65535) k (bit-and q 65535)]
    (if (>= k count) 0
      (let [w (kernel-store-u8 r rn (- 31 k) (b p n (- last k)))] (copy-int p n r rn (+ (+ q 1) (* 0 w)))))))
;; der_int_be32 over p[off..n): the bytes used (2 + len), or 0
(defn- der-int [p :i64 n :i64 off :i64 r :i64 rn :i64] :i64
  (if (or (< (- n off) 2) (not= (b p n off) 2)) 0
    (let [len (b p n (+ off 1))]
      (if (or (not= (bit-and len 128) 0) (= len 0) (> (+ (+ off 2) len) n)) 0
        (let [skip (skip-zeros p n (+ off 2) len 0) count (- len skip)]
          (if (> count 32) 0
            (let [z (zero32 r rn 0)
                  c (copy-int p n r rn (+ (* (+ (+ off 1) len) 4294967296) (* count 65536)))]
              (+ (+ 2 len) (* 0 (+ z c))))))))))
(defn kotoba_aiueos_tls13_parse_ecdsa_der [p :i64 n :i64 rs :i64 rs-len :i64] :i64
  (if (or (not (canonical? n)) (not (canonical? rs-len)) (> n 16384) (< rs-len 64) (< n 8)) 0
    (if (not= (b p n 0) 48) 0
      (let [l1 (b p n 1)]
        (if (or (not= (bit-and l1 128) 0) (not= (+ 2 l1) n)) 0
          (let [r0 (kernel-subregion rs rs-len 0 32) u1 (der-int p n 2 r0 32)]
            (if (= u1 0) 0
              (let [inner (+ 2 u1) r1 (kernel-subregion rs rs-len 32 32) u2 (der-int p n inner r1 32)]
                (if (= u2 0) 0 (if (= (+ inner u2) n) 1 0))))))))))
