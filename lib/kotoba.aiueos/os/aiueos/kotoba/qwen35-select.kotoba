;; select_output_token's selection loop of kernel/qwen35_infer.c in Kotoba (JUN-554), over amu ADR 0391's scalar SSE f32.
;;
;; select(logits, n, state, state-len): walks the n / 4 f32 logits at logits (n <= 16384, n % 4 = 0) in order and keeps
;; the best two, as the C did: a logit above the best moves the best to second and takes its place, else one above the
;; second takes that; ties keep the earlier token. state is 24 bytes, little-endian u32s: [0] the token, [4] the second
;; token, [8] the logit's bits, [12] the second logit's bits, [16] the token of logits[0]. Answers 1, or 0 at the first
;; logit that is not finite (exponent all ones), with the state as the logits before it left it -- the C's early return.
;; A bad argument (a null pointer, a non-canonical or oversized n, n % 4 != 0, state-len != 24) answers 0 untouched.
;; The C keeps the views, the matvec and the chunking into 16 KiB windows.
(ns aiueos.qwen35-select (:export [kotoba_aiueos_qwen35_select]))
(defn- canonical? [x :i64] :bool (= (u64-shift-right x 32) 0))
;; a u32 as the f32 carrier (its 32 bits sign-extended)
(defn- sx [v :i64] :i64 (if (>= v 2147483648) (- v 4294967296) v))
(defn- f [v :i64] :f32 (f32-from-bits (sx v)))
(defn- walk [lg :i64 n :i64 s :i64 sn :i64 i :i64] :i64
  (if (>= i n) 1
    (let [v (kernel-load-u32-16k lg n i)]
      (if (= (bit-and v 2139095040) 2139095040) 0
        (let [tok0 (kernel-load-u32 s sn 0) tok1 (kernel-load-u32 s sn 4)
              b0 (kernel-load-u32 s sn 8) b1 (kernel-load-u32 s sn 12) first (kernel-load-u32 s sn 16)
              tok (bit-and (+ first (u64-shift-right i 2)) 4294967295)
              top (f32-gt (f v) (f b0)) next (and (not top) (f32-gt (f v) (f b1)))
              n0 (if top tok tok0) n1 (if top tok0 (if next tok tok1))
              m0 (if top v b0) m1 (if top b0 (if next v b1))
              w (+ (+ (kernel-store-u32 s sn 0 n0) (kernel-store-u32 s sn 4 n1))
                   (+ (kernel-store-u32 s sn 8 m0) (kernel-store-u32 s sn 12 m1)))]
          (walk lg n s sn (+ (+ i 4) (* 0 w))))))))
(defn kotoba_aiueos_qwen35_select [logits :i64 n :i64 state :i64 state-len :i64] :i64
  (if (or (= logits 0) (= state 0) (not (canonical? n)) (> n 16384) (not= (bit-and n 3) 0) (not= state-len 24)) 0
    (walk logits n state state-len 0)))
