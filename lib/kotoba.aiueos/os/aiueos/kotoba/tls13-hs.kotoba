;; The decisions of kernel/tls13.c's handshake state machine in Kotoba (JUN-553): what consume_hs_messages, process_record
;; and its two unprotect branches do with the next message or record. The C keeps the state (its flags and buffers) and
;; performs the step each export names -- copying, hashing into the transcript, calling the other objects -- the way
;; rtl8125.c sequences its objects (ADR-0140).
;;
;; hs_step(buf, n, flags): the next handshake message in buf[0..n); flags bit 0 certverify_parsed, bit 1
;;   have_server_finished. Returns action | total << 8: 0 fail, 1 need more bytes, 2 Finished, 3 Certificate,
;;   4 CertificateVerify, 5 hash into the transcript (EncryptedExtensions and others before Finished), 6 skip (after Finished).
;; record_step(rec, n, flags): a whole record; flags bit 0 handshake_ready, bit 1 have_sh, bit 2 have_hs_keys. Returns
;;   action | the handshake length << 8: 0 fail, 1 accept, 2 plaintext alert, 3 ServerHello, 4 handshake messages,
;;   5 open with the handshake keys, 6 open with the application keys.
;; inner_step(plain, n, inner, ap): an opened record's inner type; ap is 1 after the handshake. Returns 0 fail, 2 alert
;;   (fatal), 4 handshake messages, 7 post-handshake message (NewSessionTicket and others), 8 application data,
;;   9 close_notify (the alert is recorded but earlier application data stays valid).
;; A length with a non-zero upper half or above 16384 is refused (0).
;;
;; Built by the Amu aiueos kernel object route at amu 65359a09, fuel 4194304.
(ns aiueos.tls13-hs
  (:export [kotoba_aiueos_tls13_hs_step kotoba_aiueos_tls13_record_step kotoba_aiueos_tls13_inner_step]))
(defn- canonical? [x :i64] :bool (= (u64-shift-right x 32) 0))
(defn- ok-len? [n :i64] :bool (and (canonical? n) (<= n 16384)))
(defn- b [p :i64 n :i64 i :i64] :i64 (kernel-load-u8-16k p n i))
(defn- be16 [p :i64 n :i64 i :i64] :i64 (+ (* 256 (b p n i)) (b p n (+ i 1))))
(defn- be24 [p :i64 n :i64 i :i64] :i64 (+ (* 65536 (b p n i)) (be16 p n (+ i 1))))
(defn- hs-action [typ :i64 flags :i64] :i64
  (cond (= typ 20) (if (= (bit-and flags 1) 0) 0 2)
        (= typ 11) 3
        (= typ 15) 4
        (= (bit-and flags 2) 0) 5
        :else 6))
(defn kotoba_aiueos_tls13_hs_step [buf :i64 n :i64 flags :i64] :i64
  (if (or (not (ok-len? n)) (not (canonical? flags))) 0
    (if (< n 4) 1
      (let [total (+ 4 (be24 buf n 1))]
        (if (> total 12288) 0
          (if (< n total) 1
            (let [a (hs-action (b buf n 0) flags)]
              (if (= a 0) 0 (+ a (* total 256))))))))))
(defn kotoba_aiueos_tls13_record_step [rec :i64 n :i64 flags :i64] :i64
  (if (or (not (ok-len? n)) (not (canonical? flags)) (< n 5)) 0
    (let [typ (b rec n 0)]
      (cond (= typ 20) 1
            (= typ 21) 2
            (= typ 22) (cond (not= (bit-and flags 1) 0) 1
                             (= (bit-and flags 2) 0) (+ 3 (* 256 (be16 rec n 3)))
                             :else (+ 4 (* 256 (be16 rec n 3))))
            (= typ 23) (cond (= (bit-and flags 4) 0) 0
                             (= (bit-and flags 1) 0) 5
                             :else 6)
            :else 1))))
(defn kotoba_aiueos_tls13_inner_step [plain :i64 n :i64 inner :i64 ap :i64] :i64
  (if (or (not (ok-len? n)) (not (canonical? inner)) (> inner 255)) 0
    (if (= ap 0)
      (cond (= inner 21) 2 (not= inner 22) 0 :else 4)
      (cond (= inner 21) (if (and (>= n 2) (= (b plain n 0) 1) (= (b plain n 1) 0)) 9 2)
            (not= inner 23) 7
            :else 8))))
