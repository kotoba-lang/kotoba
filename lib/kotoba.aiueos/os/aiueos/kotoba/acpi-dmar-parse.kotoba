;; parse_dmar of kernel/acpi.c in Kotoba (JUN-552): the DMAR table's host address width, its remapping structures and each
;; DRHD's device scopes, and what the kernel learns from them -- the first segment-0 DRHD's register base, segment and
;; INCLUDE_PCI_ALL flag, and the DRHD count. acpi.c keeps the discovered_* globals and copies the record into them.
;;
;; dmar_parse(table, length, out, out-len): table is the whole DMAR (header->length bytes; acpi.c has already checked its
;;   signature and checksum). Returns 1 when the table is well formed, has a DRHD and a segment-0 register base, else 0.
;;   out[0..32): [0] 1 when a segment-0 DRHD was found (set as soon as it is, even if the table is refused later -- the C
;;   wrote its globals at the same point), [1] its INCLUDE_PCI_ALL bit, [2..4) segment, [8..16) register base, [16..20)
;;   the DRHD count (only on success); little-endian. out is written only once the structure walk has run.
;; A table longer than 16384 bytes is refused (16 KiB windows, amu ADR 0386); the C had no bound beyond the table's own
;; length. A null pointer, out-len below 32, or a length with a non-zero upper half is refused (0).
;;
;; The record is this object's .bss 0 until it is copied out (amu ADR 0385 / 0387). Like the C's globals, not reentrant.
;; Built by the Amu aiueos kernel object route at amu 65359a09, fuel 4194304.
(ns aiueos.acpi-dmar-parse
  (:export [kotoba_aiueos_acpi_dmar_parse]))
(defn- bss-addr-0-32 [] :i64 0)
(defn- canonical? [x :i64] :bool (= (u64-shift-right x 32) 0))
(defn- b [t :i64 n :i64 i :i64] :i64 (kernel-load-u8-16k t n i))
(defn- le16 [t :i64 n :i64 i :i64] :i64 (+ (b t n i) (* 256 (b t n (+ i 1)))))
(defn- le64-at [t :i64 n :i64 i :i64 k :i64 acc :i64] :i64
  (if (< k 0) acc (le64-at t n i (- k 1) (+ (* acc 256) (b t n (+ i k))))))
(defn- le64 [t :i64 n :i64 i :i64] :i64 (le64-at t n i 7 0))
(defn- rs [i :i64 v :i64] :i64 (kernel-store-u8 (bss-addr-0-32) 32 i v))
(defn- rl [i :i64] :i64 (kernel-load-u8 (bss-addr-0-32) 32 i))
(defn- zero [i :i64] :i64 (if (>= i 32) 0 (let [w (rs i 0)] (zero (+ (+ i 1) (* 0 w))))))
(defn- put-le [at :i64 v :i64 k :i64] :i64
  (if (>= k 8) 0 (let [w (rs (+ at k) (bit-and (u64-shift-right v (* 8 k)) 255))] (put-le at v (+ (+ k 1) (* 0 w))))))
;; the first segment-0 DRHD: found, INCLUDE_PCI_ALL, segment, register base
(defn- record-first [all :i64 base :i64 seg :i64] :i64
  (+ (rs 0 1) (rs 1 all) (rs 2 (bit-and seg 255)) (rs 3 (u64-shift-right seg 8)) (put-le 8 base 0)))
;; the device scopes in [s, end): each at least 6 bytes, within the DRHD, with an even path; 0 or -1
(defn- scopes [t :i64 n :i64 s :i64 end :i64] :i64
  (if (>= s end) 0
    (if (< (- end s) 6) -1
      (let [l (b t n (+ s 1))]
        (if (or (< l 6) (< (- end s) l) (not= (bit-and (- l 6) 1) 0)) -1 (scopes t n (+ s l) end))))))
(defn- drhd [t :i64 n :i64 cur :i64 len :i64] :i64
  (if (< len 16) -1
    (let [base (le64 t n (+ cur 8)) seg (le16 t n (+ cur 6))]
      (if (or (= base 0) (not= (bit-and base 4095) 0) (not= (u64-shift-right base 52) 0)) -1
        (let [w (if (and (= (rl 0) 0) (= seg 0)) (record-first (bit-and (b t n (+ cur 4)) 1) base seg) 0)]
          (scopes t n (+ (+ cur 16) (* 0 w)) (+ cur len)))))))
;; the remapping structures from cur; the DRHD count, or -1
(defn- walk [t :i64 n :i64 cur :i64 drhds :i64] :i64
  (if (>= cur n) drhds
    (if (< (- n cur) 4) -1
      (let [type (le16 t n cur) len (le16 t n (+ cur 2))]
        (if (or (< len 4) (< (- n cur) len)) -1
          (if (= type 0)
            (let [ok (drhd t n cur len)] (if (< ok 0) -1 (walk t n (+ cur len) (+ drhds 1))))
            (walk t n (+ cur len) drhds)))))))
(defn- copy-out [o :i64 on :i64 i :i64] :i64
  (if (>= i 32) 0 (let [v (rl i) w (kernel-store-u8 o on i v)] (copy-out o on (+ (+ i 1) (* 0 w))))))
(defn kotoba_aiueos_acpi_dmar_parse [table :i64 length :i64 out :i64 out-len :i64] :i64
  (if (or (= table 0) (= out 0) (not (canonical? length)) (not (canonical? out-len)) (< out-len 32) (> out-len 512)
          (> length 16384) (< length 48)) 0
    (let [width (b table length 36)]
      (if (or (< width 31) (> width 63)) 0
        (let [z (zero 0)
              d (walk table length (+ 48 (* 0 z)) 0)
              ok (if (or (<= d 0) (= (rl 0) 0)) 0 1)
              c (if (= ok 1) (+ (rs 16 (bit-and d 255)) (rs 17 (bit-and (u64-shift-right d 8) 255))
                                (rs 18 (bit-and (u64-shift-right d 16) 255)) (rs 19 (bit-and (u64-shift-right d 24) 255))) 0)
              w (copy-out out out-len (* 0 c))]
          (+ ok (* 0 w)))))))
