;; Local APIC timer (JUN-556): the Kotoba form of kernel/apic.c.
;;
;; Compiled by the Amu aiueos kernel object route (x86_64-aiueos-kernel-v1) at
;; amu 819e32802, NOT by the kotoba-native compiler that
;; scripts/reproduce-kotoba-kernel-object.sh pins for the older objects here.
;; kotoba/apic.o is that compiler's output for this file and is linked only
;; when AIUEOS_KOTOBA_APIC=1; the default build still compiles kernel/apic.c.
;;
;; What the object route supplies: D1 extern calls (the two MSR objects), D3/D3b
;; exported data cells (aiueos_apic_timer_ticks, which entry.S increments by
;; name, and aiueos_apic_mmio_base), D4 fixed-address MMIO (the five local-APIC
;; registers 0x20 0xf0 0x320 0x380 0x3e0 at 0xfee00000).
;;
;; NOT VERIFIED BY EXECUTION: no x86 machine ran this object. verify-kotoba-
;; kernel-object.py accepts it; equivalence with apic.c and a QEMU/OVMF boot
;; with the timer firing are still open (see the JUN-556 record).
(ns apic (:export [aiueos_apic_timer_mask aiueos_apic_timer_unmask aiueos_apic_timer_initialize]))
(defn- extern-kotoba_aiueos_msr_read [i :i64] :i64 0)
(defn- extern-kotoba_aiueos_msr_write [i :i64 v :i64] :i64 0)
(defn- cell-load-0 [] :i64 0)
(defn- cell-store-0 [v :i64] :i64 0)
(defn- cell-store-1 [v :i64] :i64 0)
(defn- cell-name-0-aiueos_apic_timer_ticks [] :i64 0)
(defn- cell-name-1-aiueos_apic_mmio_base [] :i64 0)
(defn- mmio-load32-fee00020 [] :i64 0)
(defn- mmio-load32-fee000f0 [] :i64 0)
(defn- mmio-store32-fee000f0 [v :i64] :i64 0)
(defn- mmio-load32-fee00320 [] :i64 0)
(defn- mmio-store32-fee00320 [v :i64] :i64 0)
(defn- mmio-store32-fee00380 [v :i64] :i64 0)
(defn- mmio-store32-fee003e0 [v :i64] :i64 0)
(defn aiueos_apic_timer_mask [] :i64
  (do (mmio-store32-fee00320 (bit-or (mmio-load32-fee00320) 65536))
      (mmio-load32-fee00020)
      0))
(defn aiueos_apic_timer_unmask [] :i64
  (do (mmio-store32-fee00320 (bit-and (mmio-load32-fee00320) 4294901759))
      (mmio-load32-fee00020)
      0))
(defn aiueos_apic_timer_initialize [] :i64
  (let [base (extern-kotoba_aiueos_msr_read 27)]
    (if (not= (bit-and base 4294963200) 4276092928)
      0
      (if (= (extern-kotoba_aiueos_msr_write 27 (bit-or base 2048)) 0)
        0
        (do (cell-store-1 4276092928)
            (cell-store-0 0)
            (mmio-store32-fee000f0 (bit-or (bit-and (mmio-load32-fee000f0) 4294967040) 511))
            (mmio-load32-fee00020)
            (mmio-store32-fee003e0 3)
            (mmio-load32-fee00020)
            (mmio-store32-fee00320 131104)
            (mmio-load32-fee00020)
            (mmio-store32-fee00380 100000)
            (mmio-load32-fee00020)
            (if (= (bit-and (mmio-load32-fee000f0) 511) 511)
              (if (= (bit-and (mmio-load32-fee00320) 131327) 131104) 1 0)
              0))))))
