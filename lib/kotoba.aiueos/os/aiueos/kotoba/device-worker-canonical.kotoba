(ns aiueos.device-worker-canonical
  (:export [aiueos-device-worker-canonical main]))

;; The signed canonical text of the Murakumo device-P256 worker protocol, v2
;; and v3, for the freestanding aiueos kernel.
;;
;;   (aiueos-device-worker-canonical ctx ctx-len out out-cap)
;;
;; This replaces the `put_text`/`canonical_field`/`canonical_number` sequence in
;; `kernel/device_result.c:415-437`. The bytes this object writes are the bytes
;; that get hashed and signed; a field in the wrong order, a decimal with a
;; leading zero, or a sentinel the server does not expect produces a signature
;; the server refuses -- and refuses while naming the wrong cause, because the
;; only thing it can say is that the signature did not verify. Deciding what
;; the device asserts about itself is not mechanism.
;;
;; ---------------------------------------------------------------------------
;; NOT A BOOLEAN, AND ZERO IS NOT THE SUCCESS VALUE EITHER.
;; ---------------------------------------------------------------------------
;; This is the `aiueos-qwen35-*` convention rather than the `aiueos-aes128-gcm`
;; one, and for the reason those three give: the useful answer is a LENGTH, and
;; a length cannot share a value space with a reason code that is also
;; non-negative.
;;
;;    > 0   the number of canonical bytes written into `out`
;;   -1     ctx-len below the 576 bytes this object requires
;;   -2     out-cap below the 1024 bytes this object requires
;;   -3     protocol is neither 2 nor 3
;;   -4     operation is not 1 (poll), 2 (result) or 3 (control-ack)
;;   -5     the stop-reason byte is not the one this protocol and operation
;;          admit: protocol 2 and the two non-result operations require the
;;          sentinel 0; a protocol 3 result requires 1, 2 or 3
;;   -6     a numeric slot's most significant byte is non-zero, i.e. a value at
;;          or above 2^56 that this object's decimal writer cannot render
;;   -7     protocol 2 carrying a protocol 3 field
;;      0   is never returned
;;
;; ---------------------------------------------------------------------------
;; THE INPUT RECORD
;; ---------------------------------------------------------------------------
;; One caller-owned region, fixed layout, 576 bytes. Every number is an
;; 8-byte BIG-ENDIAN value whose most significant byte must be zero, so the
;; admitted range is 0 .. 2^56-1: the widest real field is a cycle counter and
;; the job-id the server hands out is a 16-digit microsecond stamp.
;;
;;   offset  bytes  what
;;   ------  -----  ------------------------------------------------------
;;      0      1    protocol: 2 or 3
;;      1      1    operation: 1 poll, 2 result, 3 control-ack
;;      2      1    stop reason: 0 sentinel, 1 eos, 2 max-tokens, 3 error
;;      3      5    reserved
;;      8      8    sequence
;;     16      8    job-id
;;     24      8    token
;;     32      8    second-token
;;     40      8    generated-tokens
;;     48      8    decode-tokens
;;     56      8    first-token-cycles
;;     64      8    decode-cycles
;;     72      8    inference-cycles
;;     80      8    vector-bits
;;     88      8    worker-threads
;;     96      8    tsc-hz
;;    104      8    output-token-count
;;    112     16    reserved
;;    128     23    node id, exactly "aiueos-k16-" + 12 lower-case hex
;;    151      9    reserved
;;    160    128    uncompressed P-256 public key, 128 lower-case hex
;;    288     16    boot id, 16 lower-case hex
;;    304     64    model sha256, 64 lower-case hex
;;    368     64    input-sha256, 64 lower-case hex   (protocol 3 result only)
;;    432     64    output-sha256, 64 lower-case hex  (protocol 3 result only)
;;    496     32    nonce, 32 lower-case hex
;;    528     48    reserved
;;    576          end -- ctx-len must be at least this
;;
;; ---------------------------------------------------------------------------
;; THE SENTINELS ARE WRITTEN, NOT TRUSTED
;; ---------------------------------------------------------------------------
;; `docs/device-worker-v3.md` gives a poll and a control-ack four sentinel
;; values: both digests are 64 `0` characters, the count is `0` and the stop
;; reason is `-`. This object WRITES them for those two operations and never
;; reads offsets 368, 432, 104 or 2 there. The server's rule is spelled
;; "protocol 3 poll/control must not carry a job output"; a device that copied
;; a stale digest out of its own context would sign a poll that settles a job,
;; and no clause on this side would have fired. Writing them is the only shape
;; in which that cannot happen.
;;
;; The job-id sentinel `-` for a poll is the same argument one protocol version
;; older, and `device_result.c:427` already had it.
;;
;; ---------------------------------------------------------------------------
;; NO STRING LITERALS
;; ---------------------------------------------------------------------------
;; The seven fixed words this form contains live in one generated character
;; table below, addressed by (offset, length). `bytes-literal` answers with the
;; address of bytes the backend placed in an IMAGE, and a kernel `.o` is not an
;; image; there is no other way to name a byte string in this subset. The table
;; is generated by `scripts/gen-device-literal-pool.cljs` rather than
;; transcribed, because 58 nested `if` arms written by hand is exactly the
;; shape where one wrong ASCII code becomes a signature the server refuses for
;; the wrong reason.
;;
;; ---------------------------------------------------------------------------
;; WINDOW LITERALS
;; ---------------------------------------------------------------------------
;; 576 for `ctx` and 1024 for `out`, both literals rather than the parameters
;; beside them, because a helper that carried both window lengths would exceed
;; the five-parameter ABI (`:kotoba.error/max-parameters`, measured
;; 2026-09-02). The parameters are still checked: a caller that declares a
;; smaller region is refused before a single byte is read. The consequence is
;; that the C must allocate EXACTLY these sizes -- a 576-byte context and a
;; 1024-byte canonical buffer -- or the bounds check is measuring the wrong
;; region.
;;
;; 1024 is the ceiling because the widest v3 result is 716 bytes: 20 version,
;; 24 node, 129 public key, 17 boot, 65 model, 21 sequence, 12 operation,
;; 21 job-id, 2 protocol, 210 for the ten metric fields, 21 tsc-hz, 65 + 65
;; digests, 21 count, 11 stop reason, 33 nonce. `DEVICE_CANONICAL_MAX` in
;; `device_result.c` was 512 and must grow with this object.

;; GENERATED by scripts/gen-device-literal-pool.cljs from canonical-pool.txt -- do not hand-edit.
;;   (put-lit out at 0 19)  "aiueos-k16-worker-v"
;;   (put-lit out at 19 4)  "poll"
;;   (put-lit out at 23 6)  "result"
;;   (put-lit out at 29 11)  "control-ack"
;;   (put-lit out at 40 3)  "eos"
;;   (put-lit out at 43 10)  "max-tokens"
;;   (put-lit out at 53 5)  "error"
;; pool length 58
(defn lit [i :i64] :i64 (if (= i 0) 97 (if (= i 1) 105 (if (= i 2) 117 (if (= i 3) 101 (if (= i 4) 111 (if (= i 5) 115 (if (= i 6) 45 (if (= i 7) 107 (if (= i 8) 49 (if (= i 9) 54 (if (= i 10) 45 (if (= i 11) 119 (if (= i 12) 111 (if (= i 13) 114 (if (= i 14) 107 (if (= i 15) 101 (if (= i 16) 114 (if (= i 17) 45 (if (= i 18) 118 (if (= i 19) 112 (if (= i 20) 111 (if (= i 21) 108 (if (= i 22) 108 (if (= i 23) 114 (if (= i 24) 101 (if (= i 25) 115 (if (= i 26) 117 (if (= i 27) 108 (if (= i 28) 116 (if (= i 29) 99 (if (= i 30) 111 (if (= i 31) 110 (if (= i 32) 116 (if (= i 33) 114 (if (= i 34) 111 (if (= i 35) 108 (if (= i 36) 45 (if (= i 37) 97 (if (= i 38) 99 (if (= i 39) 107 (if (= i 40) 101 (if (= i 41) 111 (if (= i 42) 115 (if (= i 43) 109 (if (= i 44) 97 (if (= i 45) 120 (if (= i 46) 45 (if (= i 47) 116 (if (= i 48) 111 (if (= i 49) 107 (if (= i 50) 101 (if (= i 51) 110 (if (= i 52) 115 (if (= i 53) 101 (if (= i 54) 114 (if (= i 55) 114 (if (= i 56) 111 114))))))))))))))))))))))))))))))))))))))))))))))))))))))))))

(defn cl [ctx :i64 i :i64] :i64 (kernel-load-u8-4k ctx 576 i))

;; Every write returns the NEXT index. The store's own result is folded
;; through `(* 0 ...)` and never read: kotoba-native emits no destination
;; register for a bounded store, so its value is undefined on the machine even
;; though the KIR oracle answers with the operand (kotoba-native #112's
;; finding). Multiplying an undefined register by zero is zero on both.
(defn wb [out :i64 at :i64 v :i64] :i64 (+ at 1 (* 0 (kernel-store-u8-4k out 1024 at v))))

;; The eight bytes at `at`, most significant first. Byte 0 is charged 2^56, so
;; a slot whose byte 0 is non-zero denotes a value this object refuses (-6)
;; before `build` runs.
(defn ld64 [ctx :i64 at :i64] :i64
  (+ (* (cl ctx at) 72057594037927936)
     (+ (* (cl ctx (+ at 1)) 281474976710656)
        (+ (* (cl ctx (+ at 2)) 1099511627776)
           (+ (* (cl ctx (+ at 3)) 4294967296)
              (+ (* (cl ctx (+ at 4)) 16777216)
                 (+ (* (cl ctx (+ at 5)) 65536)
                    (+ (* (cl ctx (+ at 6)) 256) (cl ctx (+ at 7))))))))))

(defn put-lit [out :i64 at :i64 from :i64 n :i64] :i64
  (if (= n 0) at (put-lit out (wb out at (lit from)) (+ from 1) (- n 1))))

(defn copy-n [out :i64 at :i64 ctx :i64 from :i64 n :i64] :i64
  (if (= n 0) at (copy-n out (wb out at (cl ctx from)) ctx (+ from 1) (- n 1))))

(defn put-zeros [out :i64 at :i64 n :i64] :i64
  (if (= n 0) at (put-zeros out (wb out at 48) (- n 1))))

;; Decimal. Bounded at seventeen digits because the admitted range stops below
;; 2^56, and 10^17 is the largest power of ten this can multiply by without
;; leaving i64 (`digit-at` computes `p * 10`).
(defn pow10 [n :i64] :i64
  (if (= n 0) 1 (if (= n 1) 10 (if (= n 2) 100 (if (= n 3) 1000
  (if (= n 4) 10000 (if (= n 5) 100000 (if (= n 6) 1000000 (if (= n 7) 10000000
  (if (= n 8) 100000000 (if (= n 9) 1000000000 (if (= n 10) 10000000000
  (if (= n 11) 100000000000 (if (= n 12) 1000000000000
  (if (= n 13) 10000000000000 (if (= n 14) 100000000000000
  (if (= n 15) 1000000000000000 (if (= n 16) 10000000000000000
  100000000000000000))))))))))))))))))

(defn dec-len [v :i64] :i64 (if (< v 10) 1 (+ 1 (dec-len (quot v 10)))))

(defn digit-at [v :i64 p :i64] :i64 (- (quot v p) (* 10 (quot v (* p 10)))))

(defn put-dec-loop [out :i64 at :i64 v :i64 n :i64] :i64
  (if (= n 0) at
    (put-dec-loop out (wb out at (+ 48 (digit-at v (pow10 (- n 1))))) v (- n 1))))

(defn put-dec [out :i64 at :i64 v :i64] :i64 (put-dec-loop out at v (dec-len v)))

;; A newline and then the decimal of the 8-byte slot at `slot`: `canonical_number`.
(defn put-nl-slot [out :i64 ctx :i64 at :i64 slot :i64] :i64 (put-dec out (wb out at 10) (ld64 ctx slot)))

(defn put-op [out :i64 at :i64 op :i64] :i64
  (if (= op 1) (put-lit out at 19 4)
    (if (= op 2) (put-lit out at 23 6) (put-lit out at 29 11))))

(defn put-stop [out :i64 at :i64 code :i64] :i64
  (if (= code 1) (put-lit out at 40 3)
    (if (= code 2) (put-lit out at 43 10)
      (if (= code 3) (put-lit out at 53 5) (wb out at 45)))))

(defn proto-ok [p :i64] :bool (if (= p 2) true (= p 3)))

(defn op-ok [o :i64] :bool (if (= o 1) true (if (= o 2) true (= o 3))))

;; Protocol 2 has no stop-reason field at all, so the byte must be the
;; sentinel. Protocol 3 admits a real reason only on a result.
(defn stop-ok [proto :i64 op :i64 c :i64] :bool
  (if (= proto 2) (= c 0)
    (if (= op 2) (if (> c 0) (< c 4) false) (= c 0))))

(defn slots-ok [ctx :i64 i :i64] :bool
  (if (= i 13) true
    (if (= (cl ctx (+ 8 (* i 8))) 0) (slots-ok ctx (+ i 1)) false)))

;; "v1 and 2 must not carry protocol 3 fields", enforced on the writing side.
(defn v2-violation [ctx :i64] :bool
  (if (= (cl ctx 0) 2)
    (if (= (ld64 ctx 104) 0) (> (cl ctx 2) 0) true)
    false))

;; The four protocol 3 fields. A result names its digests; a poll and a
;; control-ack are given the sentinels this object writes rather than reads.
(defn put-v3 [out :i64 ctx :i64 at :i64 op :i64] :i64
  (let [a (if (= op 2) (copy-n out (wb out at 10) ctx 368 64)
                       (put-zeros out (wb out at 10) 64))
        b (if (= op 2) (copy-n out (wb out a 10) ctx 432 64)
                       (put-zeros out (wb out a 10) 64))
        c (if (= op 2) (put-dec out (wb out b 10) (ld64 ctx 104))
                       (wb out (wb out b 10) 48))
        d (if (= op 2) (put-stop out (wb out c 10) (cl ctx 2))
                       (wb out (wb out c 10) 45))]
    d))

;; The v2 field list verbatim, then -- for protocol 3 -- the four new fields,
;; then the nonce. `docs/device-worker-v3.md` states the order once and this is
;; the only place it is written down on the device side.
(defn build [ctx :i64 out :i64] :i64
  (let [proto (cl ctx 0)
        op (cl ctx 1)
        v (wb out (put-lit out 0 0 19) (+ 48 proto))
        node (copy-n out (wb out v 10) ctx 128 23)
        pub (copy-n out (wb out node 10) ctx 160 128)
        boot (copy-n out (wb out pub 10) ctx 288 16)
        model (copy-n out (wb out boot 10) ctx 304 64)
        seqn (put-nl-slot out ctx model 8)
        oper (put-op out (wb out seqn 10) op)
        job (if (= op 1) (wb out (wb out oper 10) 45)
                         (put-nl-slot out ctx oper 16))
        prot (wb out (wb out job 10) (+ 48 proto))
        tok (put-nl-slot out ctx prot 24)
        tok2 (put-nl-slot out ctx tok 32)
        gen (put-nl-slot out ctx tok2 40)
        dec (put-nl-slot out ctx gen 48)
        ftc (put-nl-slot out ctx dec 56)
        dcc (put-nl-slot out ctx ftc 64)
        inf (put-nl-slot out ctx dcc 72)
        vb (put-nl-slot out ctx inf 80)
        wt (put-nl-slot out ctx vb 88)
        tsc (put-nl-slot out ctx wt 96)
        v3 (if (= proto 3) (put-v3 out ctx tsc op) tsc)]
    (copy-n out (wb out v3 10) ctx 496 32)))

(defn aiueos-device-worker-canonical [ctx :i64 ctx-len :i64 out :i64 out-cap :i64] :i64
  (if (< ctx-len 576) -1
    (if (< out-cap 1024) -2
      (if (proto-ok (cl ctx 0))
        (if (op-ok (cl ctx 1))
          (if (stop-ok (cl ctx 0) (cl ctx 1) (cl ctx 2))
            (if (slots-ok ctx 0)
              (if (v2-violation ctx) -7 (build ctx out))
              -6)
            -5)
          -4)
        -3))))

(defn main [] :i64 0)
