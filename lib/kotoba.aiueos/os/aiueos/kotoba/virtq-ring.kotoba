;; The split-virtqueue ring operations of kernel/pci.c in Kotoba (JUN-598): what the virtio drivers write into a
;; descriptor table and an available ring, and read from a used ring. Each ring is one 4 KiB page (the layout of
;; struct virtq_desc / virtq_avail / virtq_used, packed, little-endian).
;;
;; post(desc, 4096, avail, 4096, rec, 48): rec is six little-endian u64s -- [0] the descriptor slot, [8] its buffer
;; address, [16] length, [24] flags, [32] next, [40] the available-ring position and the new available index packed as
;; position | index << 16. Writes descriptor slot (address u64 @16*slot, length u32 @+8 as two u16 stores -- the 16 KiB
;; window tier has no u32 store, and the device reads a descriptor only after the index publishes it -- flags u16 @+12,
;; next u16 @+14),
;; then ring[position] = slot (u16 @4 + 2*position), then the available index (u16 @2) -- in that order, so the device
;; never sees an index before its ring entry. Answers 1; 0 with nothing written for a slot past the table, a ring
;; position past the page, a null pointer or a wrong length.
;; used-index(used, 4096): the used ring's index (u16 @2). used-elem(used, 4096, slot): element slot's id << 32 |
;; length (u32 @4 + 8*slot and @8 + 8*slot), or -1 for a slot past the page.
(ns aiueos.virtq-ring (:export [kotoba_aiueos_virtq_post kotoba_aiueos_virtq_used_index kotoba_aiueos_virtq_used_elem]))
(defn- r [p :i64 pn :i64 i :i64] :i64 (kernel-load-u64 p pn i))
(defn- write-desc [d :i64 dn :i64 p :i64 pn :i64 at :i64] :i64
  (let [len (bit-and (r p pn 16) 4294967295)
        w1 (kernel-store-u64-16k d dn at (r p pn 8))
        w2 (+ (kernel-store-u16-16k d dn (+ at 8) (bit-and len 65535)) (kernel-store-u16-16k d dn (+ at 10) (u64-shift-right len 16)))
        w3 (kernel-store-u16-16k d dn (+ at 12) (bit-and (r p pn 24) 65535)) w4 (kernel-store-u16-16k d dn (+ at 14) (bit-and (r p pn 32) 65535))]
    (+ (+ w1 w2) (+ w3 w4))))
(defn- push [a :i64 an :i64 p :i64 pn :i64 slot :i64] :i64
  (let [packed (r p pn 40) pos (bit-and packed 65535) index (bit-and (u64-shift-right packed 16) 65535)
        w1 (kernel-store-u16-16k a an (+ 4 (* 2 pos)) slot) w2 (kernel-store-u16-16k a an 2 index)]
    (+ w1 w2)))
(defn kotoba_aiueos_virtq_post [desc :i64 dn :i64 avail :i64 an :i64 rec :i64 rn :i64] :i64
  (if (or (= desc 0) (= avail 0) (= rec 0) (not= dn 4096) (not= an 4096) (not= rn 48)) 0
    (let [slot (r rec rn 0) pos (bit-and (r rec rn 40) 65535)]
      (if (or (> slot 255) (> pos 2045)) 0
        (let [w1 (write-desc desc dn rec rn (* 16 slot)) w2 (push avail an rec rn slot)] (+ 1 (* 0 (+ w1 w2))))))))
(defn kotoba_aiueos_virtq_used_index [used :i64 un :i64] :i64
  (if (or (= used 0) (not= un 4096)) 0 (kernel-load-u16-16k used un 2)))
(defn kotoba_aiueos_virtq_used_elem [used :i64 un :i64 slot :i64] :i64
  (if (or (= used 0) (not= un 4096) (< slot 0) (> slot 510)) -1
    (let [id (kernel-load-u32-16k used un (+ 4 (* 8 slot))) len (kernel-load-u32-16k used un (+ 8 (* 8 slot)))]
      (bit-or (i64-shift-left id 32) len))))
