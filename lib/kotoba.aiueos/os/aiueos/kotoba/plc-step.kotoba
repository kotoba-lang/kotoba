;; The decisions of kernel/plc_runtime.c's scan cycle in Kotoba (JUN-554): what plc_call does with a capability call and
;; whether plc_release may release a scan. The C keeps the runtime struct, the I/O images and plc_safe, and performs the
;; step each export names.
;;
;; call_step(capability, argument, now, state, deadline, budget-end): state is active (bit 0) | watchdog (bit 1) | staged
;;   (bits 2..3); the ticks are the C's uint64_t and compare unsigned. Returns action | fault << 8 | index << 16:
;;   action 0 is a fault (plc_safe(fault), the call returns 0); 1 read input_image[index]; 2 stage the argument's low half
;;   into shadow_output[index]; 3 arm the watchdog; 4 commit the shadow outputs. Faults: 2 capability, 3 stage, 4
;;   watchdog, 5 budget, 6 deadline -- in the C's order of checks.
;; release_step(latched, active, now, next_release): 1 when the scan may be released, else 0 (plc_safe(RELEASE)).
;;
;; Built by the Amu aiueos kernel object route at amu 65359a09, fuel 4194304.
(ns aiueos.plc-step
  (:export [kotoba_aiueos_plc_call_step kotoba_aiueos_plc_release_step]))
(defn- fault [f :i64] :i64 (* f 256))
(defn- ok [action :i64 index :i64] :i64 (+ action (* index 65536)))
(defn- staged [state :i64] :i64 (bit-and (u64-shift-right state 2) 3))
;; unsigned a > b for the C's uint64_t tick comparisons
(defn- above? [a :i64 b :i64] :bool
  (let [ha (u64-shift-right a 63) hb (u64-shift-right b 63)]
    (if (= ha hb) (> a b) (= ha 1))))
(defn- commit [argument :i64 now :i64 state :i64 deadline :i64 budget-end :i64] :i64
  (cond (or (not= argument 2) (not= (staged state) 3)) (fault 3)
        (= (bit-and state 2) 0) (fault 4)
        (above? now deadline) (fault 6)
        (above? now budget-end) (fault 5)
        :else (ok 4 0)))
(defn kotoba_aiueos_plc_call_step [capability :i64 argument :i64 now :i64 state :i64 deadline :i64 budget-end :i64] :i64
  (if (= (bit-and state 1) 0) (fault 2)
    (cond (= capability 16)
            (let [index (bit-and argument 4294967295)] (if (>= index 2) (fault 2) (ok 1 index)))
          (= capability 17)
            (let [index (u64-shift-right argument 32)]
              (if (or (>= index 2) (not= (bit-and (staged state) (if (= index 0) 1 2)) 0)) (fault 3) (ok 2 index)))
          (= capability 19)
            (if (or (not= argument 1) (not= (bit-and state 2) 0)) (fault 4) (ok 3 0))
          (= capability 18) (commit argument now state deadline budget-end)
          :else (fault 2))))
(defn kotoba_aiueos_plc_release_step [latched :i64 active :i64 now :i64 next-release :i64] :i64
  (if (or (not= latched 0) (not= active 0) (not= now next-release)) 0 1))
