(ns aiueos.user-elf-valid
  (:export [kotoba_aiueos_user_elf_valid]))

;; Admission for a catalog user ELF: header, the two program headers, and —
;; only for the data layout that predates JUN-145 — the 88-byte context
;; page. Two things shaped this rewrite (measured 2026-10-26):
;;
;;   READER BOUND. `kernel-load-u8-16k` does not reject a declared length
;;   over 16,384 — it reaches `ud2`, and `ud2` in this kernel is a halt
;;   (acpi-checksum-ok.kotoba:52-67). A catalog extent may be 98,304 bytes
;;   (app-lookup-plan's cap), so the reader is handed `length` clamped to
;;   16,384, and everything this function reads lives in the ELF header and
;;   program headers — offsets 0..175, and one legacy content window at
;;   8192..8279 that only the old layout can have. The rest of a large
;;   image is admitted by arithmetic on header fields, never by reading it.
;;
;;   TWO LAYOUTS. The packager's data segment sits at file offset 8192
;;   (data-offset 2 pages) or 65536 (16 pages, JUN-145); the image base is
;;   0x1e0000, so the data VA is base + offset — page 482 (0x1e2000) or
;;   page 496 (0x1f0000). Text room follows the pairing: data on 482 means
;;   text must stay in its one page (file contiguity gives that for free),
;;   data on 496 leaves text pages 481 and 482 (8,192 bytes — two pages is
;;   the ceiling; page 483+ would shadow kernel .bss below aiueos_low_end).
;;   page-mapping-plan answers per call and cannot see both segments, so
;;   the pairing is proved HERE, from the phdrs, before mapping runs.

;; AMU READER. The Amu x86_64-aiueos-kernel-v1 route has only the aligned
;; `kernel-load-u32-16k` (length <= 16384, index % 4 = 0), so a byte is the
;; shifted aligned word. The clamp above is applied inside `u8`.
;;
;; CAPABILITIES. The legacy-layout context carries the caps bitmap at byte
;; 8208: 60 is the signed legacy profile; 0 is the capability-free scalar
;; profile (Amu #1574), for which the loader mints no runtime or log handle.
;; Any other bitmap (e.g. 1) is refused here.

(defn- u8 [image length offset]
  (let [aligned (- offset (bit-and offset 3))
        word (kernel-load-u32-16k image length aligned)]
    (bit-and (u64-shift-right word (* 8 (- offset aligned))) 255)))

(defn- u16 [image length offset]
  (+ (u8 image length offset) (* (u8 image length (+ offset 1)) 256)))

(defn- u32 [image length offset]
  (+ (u16 image length offset) (* (u16 image length (+ offset 2)) 65536)))

(defn- zero32 [image length offset] (= (u32 image length offset) 0))

(defn- segment [image length base offset filesz]
  (let [address (+ 1966080 offset)
        flags (if (= base 64) 5 6)]
  (and (= (u32 image length base) 1)
       (= (u32 image length (+ base 4)) flags)
       (= (u32 image length (+ base 8)) offset)
       (zero32 image length (+ base 12))
       (= (u32 image length (+ base 16)) address)
       (zero32 image length (+ base 20))
       (= (u32 image length (+ base 24)) address)
       (zero32 image length (+ base 28))
       (= (u32 image length (+ base 32)) filesz)
       (zero32 image length (+ base 36))
       (= (u32 image length (+ base 40)) filesz)
       (zero32 image length (+ base 44))
       (= (u32 image length (+ base 48)) 4096)
       (zero32 image length (+ base 52)))))

(defn- context-zero [image :i64 length :i64 index :i64 end :i64] :bool
  (if (= index end) true
    (and (= (u8 image length index) 0)
         (context-zero image length (+ index 1) end))))

(defn- legacy-context [image length]
  ;; The 8192-window pins as user-smoke has always carried them; byte 8208 is
  ;; the capability bitmap (0 scalar, 60 legacy).
  (and (zero32 image length 8192)
       (zero32 image length 8196)
       (= (u32 image length 8200) 256)
       (zero32 image length 8204)
       (or (= (u8 image length 8208) 0)
           (= (u8 image length 8208) 60))
       (context-zero image length 8209 8240)
       (= (u32 image length 8240) 1970208)
       (zero32 image length 8244)
       (context-zero image length 8248 8272)
       (= (u32 image length 8272) 0)
       (zero32 image length 8276)))

(defn- elf-valid [image length full]
  (and (>= full 8280)
       (= (u32 image length 0) 1179403647)
       (= (u8 image length 4) 2)
       (= (u8 image length 5) 1)
       (= (u8 image length 6) 1)
       (= (u16 image length 16) 2)
       (= (u16 image length 18) 62)
       (= (u32 image length 20) 1)
       (= (u32 image length 24) 1970176)
       (zero32 image length 28)
       (= (u32 image length 32) 64)
       (zero32 image length 36)
       (= (u16 image length 52) 64)
       (= (u16 image length 54) 56)
       (= (u16 image length 56) 2)
       (let [text-size (u32 image length 96)
             data-offset (u32 image length 128)
             data-address (u32 image length 136)]
         (and
          (<= full 98304)
          (<= (+ data-offset 88) full)
          (> text-size 0)
          (<= text-size 8192)
          (<= (+ 4096 text-size) data-offset)
          (segment image length 64 4096 text-size)
          (or (= data-offset 8192) (= data-offset 65536))
          (= data-address (+ 1966080 data-offset))
          (segment image length 120 data-offset 88)
          (or (= data-offset 65536)
              (legacy-context image length))))))

;; READER BOUND: `kernel-load-u32-16k` halts on a length over 16,384, so an
;; image longer than that is read through a 16,384-byte subregion (always in
;; range, since the real length exceeds it) and its real extent is checked
;; arithmetically (`full`). Everything read lives below 8,280. Both calls pass
;; a region with a literal-or-parameter length equal to the region's own.
(defn kotoba_aiueos_user_elf_valid [image length]
  (if (> length 16384)
    (elf-valid (kernel-subregion image length 0 16384) 16384 length)
    (elf-valid image length length)))
