(ns aiueos.qwen35-dot-f32
  (:export [kotoba_aiueos_qwen35_dot_f32]))

;; A four-accumulator f32 dot product, bit-for-bit `dot_scalar`
;; (`kernel/qwen35_infer.c:234`).


;; amu native object route (JUN-633): a window's length operand is its region's own length, so each helper takes a and
;; b with their lengths (a-length = b-length = count * 4 after the checks) and derives count from it; a private helper
;; takes at most five parameters, so a lane's index and its binary32 accumulator share one word (acc | k << 32). The
;; arithmetic and its order are the kotoba-compiler/1 source's: four strided lanes, ((l0 + l1) + (l2 + l3)), then the
;; tail in order.
(defn- f32-word-at [base n4 i]
  (let [u (kernel-load-u32 (kernel-subregion base n4 (* i 4) 4) 4 0)]
    (if (> u 2147483647) (- u 4294967296) u)))

(defn- mac [acc x y]
  (f32-to-bits (f32-add (f32-from-bits acc) (f32-mul (f32-from-bits x) (f32-from-bits y)))))

(defn- u32 [v] (bit-and v 4294967295))

(defn- sx [u] (if (> u 2147483647) (- u 4294967296) u))

(defn- dot-lane [a an b bn state]
  (let [k (u64-shift-right state 32) acc (sx (u32 state)) count (quot an 4)]
    (if (>= k (* 4 (quot count 4)))
      acc
      (dot-lane a an b bn
        (bit-or (u32 (mac acc (f32-word-at a an k) (f32-word-at b bn k))) (i64-shift-left (+ k 4) 32))))))

(defn- dot-tail [a an b bn state]
  (let [i (u64-shift-right state 32) acc (sx (u32 state)) count (quot an 4)]
    (if (>= i count)
      acc
      (dot-tail a an b bn
        (bit-or (u32 (mac acc (f32-word-at a an i) (f32-word-at b bn i))) (i64-shift-left (+ i 1) 32))))))

(defn- lanes [a an b bn]
  (f32-to-bits
    (f32-add
      (f32-add (f32-from-bits (dot-lane a an b bn 0))
               (f32-from-bits (dot-lane a an b bn 4294967296)))
      (f32-add (f32-from-bits (dot-lane a an b bn 8589934592))
               (f32-from-bits (dot-lane a an b bn 12884901888))))))

(defn kotoba_aiueos_qwen35_dot_f32 [a a-length b b-length count]
  (if (< count 0) -4294967297
    (if (> count 65536) -4294967298
      (if (not (= a-length (* count 4))) -4294967299
        (if (not (= b-length (* count 4))) -4294967300
          (dot-tail a a-length b b-length
            (bit-or (u32 (lanes a a-length b b-length)) (i64-shift-left (* 4 (quot count 4)) 32))))))))
