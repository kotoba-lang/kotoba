(ns aiueos.qwen35-attention
  (:export [kotoba_aiueos_qwen35_attention]))

;; The arithmetic of `full_attention` (`kernel/qwen35_infer.c:684`) as one
;; kernel object: the query/gate de-interleave (:707), the **fused softmax**
;; over the KV cache (:733-780), and the position-zero reduction (:791-802).
;;
;; ## What is here and what is NOT
;;
;; | `full_attention` does | where it lives |
;; |---|---|
;; | `rms_norm`, `rms_norm_heads_weighted` | `aiueos-qwen35-norm` (ADR-0148) |
;; | four `matvec` calls | `aiueos-qwen35-matvec` (ADR-0147) |
;; | de-interleave, softmax, position-zero reduction | **here** |
;; | `rope_heads` | stays in C -- `local_sincos` is the x87 `fsincos` |
;; | the KV cache write, its FNV hash, `resolved_cached_key` | stays in C |
;;
;; `rope_heads` is not a schedule item: on x86-64 the C's sine and cosine come
;; from the **`fsincos` instruction**, Amu emits no x87, and there is no
;; polynomial to transcribe because the C is not using one. A Kotoba rope could
;; not be bit-compatible by construction (ADR-0148).
;;
;; The cache is left in C for a different reason: `resolved_cached_key` (:542)
;; is custody, not arithmetic -- an FNV hash, a shadow copy and a repair. This
;; object reads the cache the C has already resolved, which is what
;; `resolved_cached_key` returns on every path that does not fail.
;;
;; ## Modes
;;
;;   0  de-interleave       out[h*D + i] = qg[h*2D + i]
;;   1  cached softmax      the whole `if (decode->position)` head loop
;;   2  position zero       out[h*D + i] = value[vh*D + i] * sigmoid(gate)
;;
;; One object rather than three because all three walk the same interleaved
;; `[query gate]` buffer with the same head geometry, and because the low
;; region of the K16 image cannot hold an object per loop.
;;
;; ## One arena, one plan
;;
;; Six regions and a head geometry against a five-argument ABI, and
;; `kernel-subregion` requires its BASE to be a parameter, a literal or
;; `kernel-boot-info`. So the caller places everything in one region and
;; describes it in a 96-byte plan. Offsets are 64-bit: the decode workspace sits
;; above the model mapping and a u32 slot would truncate silently.
;;
;;     0   mode, 0..2                              u32
;;     4   reserved, must be zero                  u32
;;     8   heads                                   u64  1..64
;;    16   head dimension, must be 256             u64
;;    24   output base (`scratch_c`)               u64  modes 0 and 2
;;    32   query/gate base (`scratch_a`)           u64  all modes
;;    40   mode 1: key cache / mode 2: values      u64
;;    48   mode 1: value cache                     u64
;;    56   mode 1: query base (`scratch_c`)        u64
;;    64   kv width, must be 1024 in mode 1        u64
;;    72   heads per kv head                       u64  modes 1 and 2
;;    80   position, 1..7 in mode 1                u64
;;    88   scratch base, 128 bytes, mode 1         u64
;;
;; The two cache regions are `(position + 1) * kv-width * 4` bytes -- exactly
;; the causal prefix this call reads. `decode->full_key` reserves eight
;; positions per slot; a bound that named eight would admit a plan whose slot
;; does not have them.
;;
;; A slot a mode does not use must be zero, so a plan built for one mode cannot
;; be handed to another and quietly address something.
;;
;; ### Why the head dimension and the KV width are FIXED
;;
;; 256 and 1024 are not defaults, they are requirements. The de-interleave
;; stride is `2 * head-dim`, the gate of head `h` sits at `h*2D + D`, the
;; four-accumulator score has no tail when `D` is a multiple of four, and a
;; cache row is `kv-width * 4` bytes. Admitting other values would mean
;; writing four paths this object has no vector for. The tail loop of
;; `stable_attention_score` (:126) is therefore NOT ported: at `D = 256` it
;; runs zero times.
;;
;; ## Return
;;
;; **Zero is the success value.**
;;
;;    0    every head was written
;;   -1    null arena
;;   -2    null plan
;;   -3    plan length is not 96
;;   -4    a slot this mode does not use is non-zero
;;   -5    mode outside 0..2
;;   -6    heads outside 1..64
;;   -7    head dimension is not 256
;;   -8    kv width is not 1024, or heads-per-kv-head outside 1..heads
;;   -9    position outside 1..7
;;  -10    a region runs past the arena
;;  -11    a query was non-finite            (`FULL_QUERY`, :737)
;;  -12    a key or a score was non-finite   (`FULL_SOFTMAX`, :748)
;;  -13    the denominator was not positive, or not finite (:761)
;;
;; ## THE SCORE ACCUMULATES IN f64 AND IN FOUR LANES
;;
;; `stable_attention_score` (:115) widens each binary32 factor to binary64 and
;; reduces in four accumulators, `(sum0 + sum1) + (sum2 + sum3)`. That is
;; `dot_scalar`'s tree, not `dot_avx2`'s left-to-right one -- the same choice
;; ADR-0147 had to make for `aiueos-qwen35-dot-f32`, and the C has two answers
;; here as well. The softmax exponent is then computed in binary32 and the
;; denominator accumulates in binary32.
;;
;; ## The gate temporary is NOT ported, and that is a proof rather than a guess
;;
;; The C copies each head's gate into `scratch_b[FULL_GATE_TEMP_OFFSET..]`
;; before writing the output, "in case" the output overwrites it. It cannot:
;; head `h`'s output occupies `[h*D, (h+1)*D)` and its gate begins at
;; `h*2D + D`, and `h*2D + D >= (h+1)*D` for every `h >= 0` with equality only
;; at `h = 0`. Every gate is therefore still intact when it is read, and the
;; copy moves a float without rounding it. The object reads the gate in place.

;; --------------------------------------------------------------- word helpers
;; ## amu native object route (JUN-633)
;;
;; The native route takes a window's length only from the length its owner was given, never a computed one, and every
;; region here had a computed length (the gate-and-query block heads * 2048, the key and value slots 4096 * positions,
;; their rows, the scratch). So each element is a 4- or 8-byte window of the arena itself, at its region's offset from
;; the plan plus its index, and the plan is read through plan-length (the export has checked it is 96). The rows and
;; fields read and written are the kotoba-compiler/1 source's, in its order: q row = plan[56] + head * 1024; the key and
;; value rows of position p = plan[40] / plan[48] + 4096 * p + 1024 * kvh; scratch = plan[88] (scores at 8 * prior,
;; weights at 64 + 4 * prior, the max at 96, the denominator at 104); the head's output row = plan[32] + head * 1024
;; and its gate row = plan[32] + head * 2048 + 1024; deinterleave and zero-position as before. regions-fit still admits
;; every region inside the arena first. One difference: the old key and value row windows lay inside the slot window of
;; 4096 * positions, so a kvh past 3 made the last position's row pass its end and trap; the port refuses those rows
;; with -14 instead of trapping. A private helper takes at most five parameters, so small indices share a word with an
;; offset or a bit pattern (head | pe << 8, i | offset << 9, i | weight << 32). The scalar math is unchanged.

(defn- f32w [u]
  (if (> u 2147483647) (- u 4294967296) u))

(defn- u32w [v]
  (bit-and v 4294967295))

(defn- nonfinite [bits]
  (if (= (bit-and (u32w bits) 2139095040) 2139095040) 1 0))

(defn- pow2 [k]
  (if (= k 0) 1 (if (= k 1) 2 (if (= k 2) 4 (if (= k 3) 8 (if (= k 4) 16
  (if (= k 5) 32 (if (= k 6) 64 (if (= k 7) 128 (if (= k 8) 256
  (if (= k 9) 512 (if (= k 10) 1024 (if (= k 11) 2048 (if (= k 12) 4096
  (if (= k 13) 8192 (if (= k 14) 16384 (if (= k 15) 32768 (if (= k 16) 65536
  (if (= k 17) 131072 (if (= k 18) 262144 (if (= k 19) 524288
  (if (= k 20) 1048576 (if (= k 21) 2097152 (if (= k 22) 4194304
  (if (= k 23) 8388608 0)))))))))))))))))))))))))

(defn- trunc-magnitude [b]
  (let [e (- (bit-and (quot b 8388608) 255) 127)]
    (if (< e 0) 0
      (if (> e 23) 0
        (quot (bit-or (bit-and b 8388607) 8388608) (pow2 (- 23 e)))))))

(defn- trunc-f32 [bits]
  (let [b (bit-and bits 4294967295)]
    (if (>= b 2147483648)
      (- 0 (trunc-magnitude (- b 2147483648)))
      (trunc-magnitude b))))

(defn- exp-poly [r]
  (f32-to-bits
   (f32-add
    (f32-add (f32-from-bits 1065353216) (f32-from-bits r))
    (f32-mul (f32-mul (f32-from-bits r) (f32-from-bits r))
             (f32-add (f32-from-bits 1056964608)
                      (f32-mul (f32-from-bits r)
                               (f32-add (f32-from-bits 1042983595)
                                        (f32-mul (f32-from-bits r)
                                                 (f32-add (f32-from-bits 1026206379)
                                                          (f32-mul (f32-from-bits r)
                                                                   (f32-add (f32-from-bits 1007192198)
                                                                            (f32-mul (f32-from-bits r)
                                                                                     (f32-from-bits 985009044)))))))))))))

(defn- exp-from [x e]
  (f32-to-bits
   (f32-mul (f32-from-bits (exp-poly (f32-to-bits
                                      (f32-sub (f32-from-bits x)
                                               (f32-mul (i64-to-f32-rounded e)
                                                        (f32-from-bits 1060205080))))))
            (f32-from-bits (f32w (u32w (* (+ e 127) 8388608)))))))

(defn- exp-clamped [x]
  (exp-from x
            (let [s (f32-to-bits (f32-mul (f32-from-bits x) (f32-from-bits 1069066811)))]
              (if (f32-ge (f32-from-bits s) (f32-from-bits 0))
                (trunc-f32 (f32-to-bits (f32-add (f32-from-bits s) (f32-from-bits 1056964608))))
                (trunc-f32 (f32-to-bits (f32-sub (f32-from-bits s) (f32-from-bits 1056964608))))))))

(defn- local-exp [x]
  (if (f32-le (f32-from-bits x) (f32-from-bits -1028784128))
    0
    (if (f32-ge (f32-from-bits x) (f32-from-bits 1118830592))
      (exp-clamped 1118830592)
      (exp-clamped x))))

(defn- sigmoid [x]
  (if (f32-ge (f32-from-bits x) (f32-from-bits 0))
    (f32-to-bits (f32-div (f32-from-bits 1065353216)
                          (f32-add (f32-from-bits 1065353216)
                                   (f32-from-bits (local-exp (f32-to-bits (f32-neg (f32-from-bits x))))))))
    (f32-to-bits (f32-div (f32-from-bits (local-exp x))
                          (f32-add (f32-from-bits 1065353216) (f32-from-bits (local-exp x)))))))

(defn- score-finite [s]
  (if (f64-eq (f64-from-bits s) (f64-from-bits s))
    (if (f64-le (f64-from-bits s) (f64-from-bits 9218868437227405311))
      (if (f64-ge (f64-from-bits s) (f64-from-bits -4503599627370497)) 1 0)
      0)
    0))

(defn- shifted [d]
  (if (f64-le (f64-from-bits d) (f64-from-bits -4587549539174449152))
    -1028784128
    (if (f64-ge (f64-from-bits d) (f64-from-bits 0))
      0
      (f32-to-bits (f64-to-f32-rounded (f64-from-bits d))))))

(defn- fits [alen off len]
  (if (< off 0) 0 (if (< len 0) 0 (if (> (+ off len) alen) 0 1))))

;; ------------------------------------------------------------ the arena and the plan

(defn- f32-at [arena alen off]
  (f32w (kernel-load-u32 (kernel-subregion arena alen off 4) 4 0)))

(defn- f32-put [arena alen off bits]
  (kernel-store-u32 (kernel-subregion arena alen off 4) 4 0 (u32w bits)))

(defn- u64-at [arena alen off]
  (kernel-load-u64 (kernel-subregion arena alen off 8) 8 0))

(defn- u64-put [arena alen off bits]
  (kernel-store-u64 (kernel-subregion arena alen off 8) 8 0 bits))

(defn- plan-u32 [plan pn slot]
  (kernel-load-u32 plan pn slot))

(defn- plan-u64 [plan pn slot]
  (+ (kernel-load-u32 plan pn slot)
     (* 4294967296 (kernel-load-u32 plan pn (+ slot 4)))))

(defn- any-nonfinite [arena alen off i]
  (if (>= i 256)
    0
    (if (= 1 (nonfinite (f32-at arena alen (+ off (* i 4)))))
      1
      (any-nonfinite arena alen off (+ i 1)))))

;; ------------------------------------------------------------ the softmax head

;; ki = i | k-offset << 9
(defn- score-lane [arena alen qoff ki acc]
  (let [i (bit-and ki 511) koff (u64-shift-right ki 9)]
    (if (>= i 256)
      acc
      (score-lane arena alen qoff (+ ki 4)
                  (f64-to-bits
                   (f64-add (f64-from-bits acc)
                            (f64-mul (f32-to-f64-exact (f32-from-bits (f32-at arena alen (+ qoff (* i 4)))))
                                     (f32-to-f64-exact (f32-from-bits (f32-at arena alen (+ koff (* i 4))))))))))))

(defn- score-bits [arena alen qoff koff]
  (f64-to-bits
   (f64-mul (f64-add (f64-add (f64-from-bits (score-lane arena alen qoff (i64-shift-left koff 9) 0))
                              (f64-from-bits (score-lane arena alen qoff (+ 1 (i64-shift-left koff 9)) 0)))
                     (f64-add (f64-from-bits (score-lane arena alen qoff (+ 2 (i64-shift-left koff 9)) 0))
                              (f64-from-bits (score-lane arena alen qoff (+ 3 (i64-shift-left koff 9)) 0))))
            (f64-from-bits 4589168020290535424))))

;; whether the old key / value row window (1024 bytes at 4096 * p + 1024 * kvh) fits inside its slot window of
;; 4096 * positions -- the old source trapped when it did not
(defn- row-fits [p kvh n]
  (if (> (+ (+ (* 4096 p) (* 1024 kvh)) 1024) (* 4096 n)) 0 1))

;; hp = head | pe << 8, pe = position * 16 | positions
(defn- score-pass [arena alen plan pn hp]
  (let [head (bit-and hp 255) pe (u64-shift-right hp 8)
        p (quot pe 16) n (- pe (* 16 (quot pe 16)))
        kvh (quot head (plan-u64 plan pn 72))
        scr (plan-u64 plan pn 88)
        qoff (+ (plan-u64 plan pn 56) (* head 1024))
        koff (+ (+ (plan-u64 plan pn 40) (* 4096 p)) (* 1024 kvh))]
    (if (>= p n)
      0
      (if (= 0 (row-fits p kvh n))
        -14
        (if (= 1 (any-nonfinite arena alen koff 0))
          -12
          (let [s (score-bits arena alen qoff koff)]
            (if (= 0 (score-finite s))
              -12
              (let [w1 (u64-put arena alen (+ scr (* p 8)) s)
                    w2 (if (f64-gt (f64-from-bits s) (f64-from-bits (u64-at arena alen (+ scr 96))))
                         (u64-put arena alen (+ scr 96) s)
                         0)]
                (score-pass arena alen plan pn (+ (+ hp 4096) (* 0 (+ w1 w2))))))))))))

(defn- weight-pass [arena alen plan pn pe]
  (let [p (quot pe 16) n (- pe (* 16 (quot pe 16))) scr (plan-u64 plan pn 88)]
    (if (>= p n)
      0
      (do (f32-put arena alen (+ scr (+ 64 (* p 4)))
                   (local-exp (shifted (f64-to-bits
                                        (f64-sub (f64-from-bits (u64-at arena alen (+ scr (* p 8))))
                                                 (f64-from-bits (u64-at arena alen (+ scr 96))))))))
          (f32-put arena alen (+ scr 104)
                   (f32-to-bits
                    (f32-add (f32-from-bits (f32-at arena alen (+ scr 104)))
                             (f32-from-bits (f32-at arena alen (+ scr (+ 64 (* p 4))))))))
          (weight-pass arena alen plan pn (+ pe 16))))))

(defn- zero-out [arena alen off i]
  (if (>= i 256)
    0
    (do (f32-put arena alen (+ off (* i 4)) 0)
        (zero-out arena alen off (+ i 1)))))

;; wi = i | weight << 32
(defn- accumulate-row [arena alen ooff voff wi]
  (let [i (bit-and wi 4294967295) w (f32w (u64-shift-right wi 32))]
    (if (>= i 256)
      0
      (do (f32-put arena alen (+ ooff (* i 4))
                   (f32-to-bits
                    (f32-add (f32-from-bits (f32-at arena alen (+ ooff (* i 4))))
                             (f32-mul (f32-from-bits (f32-at arena alen (+ voff (* i 4))))
                                      (f32-from-bits w)))))
          (accumulate-row arena alen ooff voff (+ wi 1))))))

(defn- accumulate-pass [arena alen plan pn hp]
  (let [head (bit-and hp 255) pe (u64-shift-right hp 8)
        p (quot pe 16) n (- pe (* 16 (quot pe 16)))
        kvh (quot head (plan-u64 plan pn 72))
        scr (plan-u64 plan pn 88)
        ooff (+ (plan-u64 plan pn 32) (* head 1024))
        voff (+ (+ (plan-u64 plan pn 48) (* 4096 p)) (* 1024 kvh))]
    (if (>= p n)
      0
      (if (= 0 (row-fits p kvh n))
        -14
        (let [w (f32-to-bits (f32-div (f32-from-bits (f32-at arena alen (+ scr (+ 64 (* p 4)))))
                                      (f32-from-bits (f32-at arena alen (+ scr 104)))))
              r (accumulate-row arena alen ooff voff (i64-shift-left (u32w w) 32))]
          (accumulate-pass arena alen plan pn (+ (+ hp 4096) (* 0 r))))))))

(defn- gate-row [arena alen ooff goff i]
  (if (>= i 256)
    0
    (do (f32-put arena alen (+ ooff (* i 4))
                 (f32-to-bits (f32-mul (f32-from-bits (f32-at arena alen (+ ooff (* i 4))))
                                       (f32-from-bits (sigmoid (f32-at arena alen (+ goff (* i 4))))))))
        (gate-row arena alen ooff goff (+ i 1)))))

(defn- head-softmax [arena alen plan pn head]
  (let [qoff (+ (plan-u64 plan pn 56) (* head 1024))
        scr (plan-u64 plan pn 88)
        ooff (+ (plan-u64 plan pn 32) (* head 1024))
        goff (+ (+ (plan-u64 plan pn 32) (* head 2048)) 1024)
        pe (+ 1 (plan-u64 plan pn 80))]
    (if (= 1 (any-nonfinite arena alen qoff 0))
      -11
      (do (u64-put arena alen (+ scr 96) -4503599627370497)
          (f32-put arena alen (+ scr 104) 0)
          (let [v (score-pass arena alen plan pn (bit-or head (i64-shift-left pe 8)))]
            (if (not (= v 0))
              v
              (do (weight-pass arena alen plan pn pe)
                  (if (f32-gt (f32-from-bits (f32-at arena alen (+ scr 104))) (f32-from-bits 0))
                    (if (= 1 (nonfinite (f32-at arena alen (+ scr 104))))
                      -13
                      (do (zero-out arena alen ooff 0)
                          (let [a (accumulate-pass arena alen plan pn (bit-or head (i64-shift-left pe 8)))]
                            (if (not (= a 0))
                              a
                              (do (gate-row arena alen ooff goff 0)
                                  0)))))
                    -13))))))))

(defn- softmax-heads [arena alen plan pn head]
  (if (>= head (plan-u64 plan pn 8))
    0
    (let [v (head-softmax arena alen plan pn head)]
      (if (not (= v 0))
        v
        (softmax-heads arena alen plan pn (+ head 1))))))

;; ------------------------------------------------------------ deinterleave and position zero

(defn- copy-row [arena alen soff doff i]
  (if (>= i 256)
    0
    (do (f32-put arena alen (+ doff (* i 4)) (f32-at arena alen (+ soff (* i 4))))
        (copy-row arena alen soff doff (+ i 1)))))

(defn- deinterleave-heads [arena alen plan pn head]
  (if (>= head (plan-u64 plan pn 8))
    0
    (do (copy-row arena alen (+ (plan-u64 plan pn 32) (* head 2048)) (+ (plan-u64 plan pn 24) (* head 1024)) 0)
        (deinterleave-heads arena alen plan pn (+ head 1)))))

;; vi = i | value-row offset << 9
(defn- zero-row [arena alen vi goff doff]
  (let [i (bit-and vi 511) voff (u64-shift-right vi 9)]
    (if (>= i 256)
      0
      (do (f32-put arena alen (+ doff (* i 4))
                   (f32-to-bits (f32-mul (f32-from-bits (f32-at arena alen (+ voff (* i 4))))
                                         (f32-from-bits (sigmoid (f32-at arena alen (+ goff (* i 4))))))))
          (zero-row arena alen (+ vi 1) goff doff)))))

(defn- zero-position-heads [arena alen plan pn head]
  (if (>= head (plan-u64 plan pn 8))
    0
    (do (zero-row arena alen
                  (i64-shift-left (+ (plan-u64 plan pn 40) (* (quot head (plan-u64 plan pn 72)) 1024)) 9)
                  (+ (+ (plan-u64 plan pn 32) (* head 2048)) 1024)
                  (+ (plan-u64 plan pn 24) (* head 1024)))
        (zero-position-heads arena alen plan pn (+ head 1)))))

;; ------------------------------------------------------------ admission and dispatch, as before

(defn- regions-fit [alen plan pn]
  (if (= 0 (fits alen (plan-u64 plan pn 32) (* (plan-u64 plan pn 8) 2048))) 0
    (if (= (plan-u32 plan pn 0) 1)
      (if (= 0 (fits alen (plan-u64 plan pn 56) (* (plan-u64 plan pn 8) 1024))) 0
        (if (= 0 (fits alen (plan-u64 plan pn 40) (* 4096 (+ 1 (plan-u64 plan pn 80))))) 0
          (if (= 0 (fits alen (plan-u64 plan pn 48) (* 4096 (+ 1 (plan-u64 plan pn 80))))) 0
            (fits alen (plan-u64 plan pn 88) 128))))
      (if (= 0 (fits alen (plan-u64 plan pn 24) (* (plan-u64 plan pn 8) 1024))) 0
        (if (= (plan-u32 plan pn 0) 0)
          1
          (fits alen (plan-u64 plan pn 40)
                (* (quot (+ (plan-u64 plan pn 8) (- (plan-u64 plan pn 72) 1)) (plan-u64 plan pn 72))
                   1024)))))))

(defn- unused-zero [plan pn]
  (if (= (plan-u32 plan pn 0) 1)
    (if (not (= (plan-u64 plan pn 24) 0)) 0 1)
    (if (not (= (plan-u64 plan pn 48) 0)) 0
      (if (not (= (plan-u64 plan pn 56) 0)) 0
        (if (not (= (plan-u64 plan pn 64) 0)) 0
          (if (not (= (plan-u64 plan pn 80) 0)) 0
            (if (not (= (plan-u64 plan pn 88) 0)) 0
              (if (= (plan-u32 plan pn 0) 2)
                1
                (if (not (= (plan-u64 plan pn 40) 0)) 0
                  (if (not (= (plan-u64 plan pn 72) 0)) 0 1))))))))))

(defn- dispatch [arena alen plan pn]
  (if (= (plan-u32 plan pn 0) 0)
    (deinterleave-heads arena alen plan pn 0)
    (if (= (plan-u32 plan pn 0) 1)
      (softmax-heads arena alen plan pn 0)
      (zero-position-heads arena alen plan pn 0))))

(defn- geometry-checked [arena alen plan pn]
  (if (= 0 (unused-zero plan pn)) -4
    (if (= 0 (regions-fit alen plan pn)) -10
      (dispatch arena alen plan pn))))

(defn- mode-checked [arena alen plan pn]
  (if (= (plan-u32 plan pn 0) 1)
    (if (not (= (plan-u64 plan pn 64) 1024)) -8
      (if (< (plan-u64 plan pn 80) 1) -9
        (if (> (plan-u64 plan pn 80) 7) -9
          (if (< (plan-u64 plan pn 72) 1) -8
            (if (> (plan-u64 plan pn 72) (plan-u64 plan pn 8)) -8
              (geometry-checked arena alen plan pn))))))
    (if (= (plan-u32 plan pn 0) 2)
      (if (< (plan-u64 plan pn 72) 1) -8
        (if (> (plan-u64 plan pn 72) (plan-u64 plan pn 8)) -8
          (geometry-checked arena alen plan pn)))
      (geometry-checked arena alen plan pn))))

(defn kotoba_aiueos_qwen35_attention [arena arena-length plan plan-length]
  (if (= arena 0) -1
    (if (= plan 0) -2
      (if (not (= plan-length 96)) -3
        (if (not (= (plan-u32 plan plan-length 4) 0)) -4
          (if (> (plan-u32 plan plan-length 0) 2) -5
            (if (< (plan-u64 plan plan-length 8) 1) -6
              (if (> (plan-u64 plan plan-length 8) 64) -6
                (if (not (= (plan-u64 plan plan-length 16) 256)) -7
                  (mode-checked arena arena-length plan plan-length))))))))))
