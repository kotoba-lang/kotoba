;; JUN-552: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form first, takes no test main and exports nothing else; the logic is unchanged.
(ns aiueos.object-transaction-route (:export [kotoba_aiueos_object_transaction_route]))

(defn- read-u32 [base length index]
  (+ (kernel-load-u8 base length index)
     (* (kernel-load-u8 base length (+ index 1)) 256)
     (* (kernel-load-u8 base length (+ index 2)) 65536)
     (* (kernel-load-u8 base length (+ index 3)) 16777216)))

(defn- fnv-step [base length index hash]
  (if (= index length)
    hash
    (fnv-step base length (+ index 1)
      (* (bit-xor hash (kernel-load-u8 base length index)) 16777619))))

(defn- fnv [base length]
  (bit-and (fnv-step base length 0 2166136261) 4294967295))

(defn kotoba_aiueos_object_transaction_route [base length]
  (let [sector (read-u32 base length 0)
        version (read-u32 base length 4)
        route (if (= sector 3) 1 (if (= sector 42) 2 3))]
    ;; `and` is a bool, and bool is a type rather than a number, so it cannot
    ;; be multiplied. The old emitter returned 0/1 from `and` and this read as
    ;; arithmetic; `if` says the same thing under the current type discipline.
    (if (and (= length 32)
            (or (and (= sector 3) (or (= version 1) (= version 2)))
                (and (or (= sector 42) (= sector 43)) (= version 3)))
            (= (read-u32 base length 8) 16)
            (= (fnv (kernel-subregion base length 16 16) 16) (read-u32 base length 12)))
      (+ route (* sector 4294967296))
      0)))

