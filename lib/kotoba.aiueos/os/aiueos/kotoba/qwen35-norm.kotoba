(ns aiueos.qwen35-norm
  (:export [kotoba_aiueos_qwen35_norm]))

;; The four normalisations of the Qwen3.5 forward pass: `rms_norm`,
;; `l2_norm_heads`, `rms_norm_heads_weighted` and the output norm of
;; `linear_attention` (`linear_output_norm_c`) in `kernel/qwen35_infer.c`.
;;
;; ## Modes
;;
;;   0  rms_norm                 a=input  b=weights  c=count  d=output
;;   1  l2_norm_heads            a=values b=heads    c=width  d=0   (in place)
;;   2  rms_norm_heads_weighted  a=values b=heads    c=width  d=weights
;;   3  linear output norm       a=values b=heads    c=width  d=weights (in place)
;;
;; Four modes in one object rather than four objects because they are one
;; page of arithmetic with one shared reduction, and each additional export is
;; a row in kotoba-native's closed allowlist plus a fuel tier plus a contract.
;;
;; ## Return
;;
;; **Zero is the success value.**
;;
;;    0    done
;;   -1    null a
;;   -2    mode outside 0..3
;;   -3    count / width outside 1..65536
;;   -4    heads outside 1..4096, or heads * width above 262144
;;   -5    a mode's second region is null
;;   -6    mode 2: a value was already non-finite
;;   -7    mode 2: the computed scale was non-finite
;;   -8    mode 2: a scaled result was non-finite
;;
;; ## THE ACCUMULATOR IS f64 AND THE PRODUCT IS f32
;;
;; All three reduce `sum += (double)(v[i] * v[i])`: the SQUARE is computed in
;; binary32 and then widened. Squaring in f64 would be more accurate and would
;; disagree with the C on most inputs, so this object does exactly what the C
;; does -- `f32-mul` then `f32-to-f64-exact` then `f64-add`.
;;
;; The two reductions then differ in where the narrowing happens, and this is
;; not a detail either:
;;
;;   rms_norm        `(float)(sum / (double)count) + EPSILON`   divide, THEN cast
;;   l2_norm_heads   `(float)sum + EPSILON`                     cast, THEN add
;;
;; ## Mode 2's second path
;;
;; `rms_norm_heads_weighted` has a fallback for a head whose squares overflow
;; binary32: it rescales by the head's largest magnitude and folds EPSILON by
;; the same factor. It is ported because it is in the C, not because it is
;; expected to fire -- and if it were dropped, an input the C handles would
;; come back as a refusal instead of a value.
;;
;; ## Mode 3 is mode 2 WITHOUT the refusals and the fallback
;;
;; `linear_attention`'s output norm (aiueos ADR-0222) is the same per-head
;; weighted RMS, but its C has neither the finiteness refusals nor the rescaled
;; path, and it does not skip a non-finite square -- `sum += (double)(v*v)`
;; takes an infinity into the sum, the scale becomes 0 and the head comes out
;; 0 or NaN. Mode 2 would refuse (-6) or rescale on those inputs, so it is not
;; the same function; mode 3 is. On finite inputs whose squares stay finite
;; the two agree bit for bit (the reduction and the product are the same
;; operations in the same order).
;;
;; The gate `linear_attention` multiplies in afterwards is NOT here: the ABI
;; has no sixth word for its address. The caller applies it with the
;; activation object's mode 4 (`silu(g) * x`), which is the C's
;; `x * silu(g)` because binary32 multiplication is commutative.
;; ## amu native object route (JUN-633)
;;
;; The native route admits a pointer only together with its own length, and a window's length only from that length or
;; a literal. The kotoba-compiler/1 export took bare words -- (mode, a, b, c, d), with b a weight pointer in mode 0 and a
;; head count in modes 1..3 -- and formed per-head windows of computed length. The export is now
;; (mode | heads << 8, a, a-length, w, w-length, o, o-length, count): a is the values (mode 0's input), w the weights
;; (mode 0's b, modes 2 and 3's d), o mode 0's output, count mode 0's count or modes 1..3's width. Every element is a
;; 4-byte window of its own region at (head * width + i) * 4, so no computed-length window is formed. The refusals keep
;; their codes and their order; -9, new, is a length that is not the one the mode's shape gives (heads * width * 4 or
;; count * 4), which the C callers never pass. A private helper takes at most five parameters, so a walk's head, index
;; and width or scale share a word: h | i << 12 | n << 29, or h | i << 12 | scale << 32 (the width then comes from the
;; weights' length), and a head walk's head, count and width h | heads << 13 | width << 26. The arithmetic and its order are unchanged.

(defn- f32w [u]
  (if (> u 2147483647) (- u 4294967296) u))

(defn- u32w [v]
  (bit-and v 4294967295))

(defn- f32-at [base bn idx]
  (f32w (kernel-load-u32 (kernel-subregion base bn (* idx 4) 4) 4 0)))

(defn- f32-put [base bn idx bits]
  (kernel-store-u32 (kernel-subregion base bn (* idx 4) 4) 4 0 (u32w bits)))

(defn- nonfinite [bits]
  (if (= (bit-and (u32w bits) 2139095040) 2139095040) 1 0))

;; st = h | i << 12 | n << 29: head h, index i, width n
(defn- st-h [st] (bit-and st 4095))
(defn- st-i [st] (bit-and (u64-shift-right st 12) 131071))
(defn- st-n [st] (bit-and (u64-shift-right st 29) 131071))
(defn- st-next [st] (+ st 4096))
(defn- st-idx [st] (+ (* (st-h st) (st-n st)) (st-i st)))
(defn- span [h n] (bit-or h (i64-shift-left n 29)))

(defn- any-nonfinite [base bn st]
  (if (>= (st-i st) (st-n st))
    0
    (if (= 1 (nonfinite (f32-at base bn (st-idx st))))
      1
      (any-nonfinite base bn (st-next st)))))

(defn- any-nonfinite-square [base bn st]
  (if (>= (st-i st) (st-n st))
    0
    (if (= 1 (nonfinite (f32-to-bits (f32-mul (f32-from-bits (f32-at base bn (st-idx st)))
                                              (f32-from-bits (f32-at base bn (st-idx st)))))))
      1
      (any-nonfinite-square base bn (st-next st)))))

(defn- sumsq [base bn st acc]
  (if (>= (st-i st) (st-n st))
    acc
    (let [next (if (= 1 (nonfinite (f32-to-bits (f32-mul (f32-from-bits (f32-at base bn (st-idx st)))
                                                         (f32-from-bits (f32-at base bn (st-idx st)))))))
                 acc
                 (f64-to-bits
                  (f64-add (f64-from-bits acc)
                           (f32-to-f64-exact (f32-mul (f32-from-bits (f32-at base bn (st-idx st)))
                                                      (f32-from-bits (f32-at base bn (st-idx st))))))))]
      (sumsq base bn (st-next st) next))))

(defn- sumsq-all [base bn st acc]
  (if (>= (st-i st) (st-n st))
    acc
    (sumsq-all base bn (st-next st)
               (f64-to-bits
                (f64-add (f64-from-bits acc)
                         (f32-to-f64-exact (f32-mul (f32-from-bits (f32-at base bn (st-idx st)))
                                                    (f32-from-bits (f32-at base bn (st-idx st))))))))))

(defn- maxabs [base bn st acc]
  (if (>= (st-i st) (st-n st))
    acc
    (let [next (if (f32-gt (f32-abs (f32-from-bits (f32-at base bn (st-idx st)))) (f32-from-bits acc))
                 (f32-to-bits (f32-abs (f32-from-bits (f32-at base bn (st-idx st)))))
                 acc)]
      (maxabs base bn (st-next st) next))))

(defn- sumsq-scaled [base bn st acc mx]
  (if (>= (st-i st) (st-n st))
    acc
    (sumsq-scaled base bn (st-next st)
                  (f64-to-bits
                   (f64-add (f64-from-bits acc)
                            (f64-mul (f64-div (f32-to-f64-exact (f32-from-bits (f32-at base bn (st-idx st))))
                                              (f32-to-f64-exact (f32-from-bits mx)))
                                     (f64-div (f32-to-f64-exact (f32-from-bits (f32-at base bn (st-idx st))))
                                              (f32-to-f64-exact (f32-from-bits mx))))))
                  mx)))

(defn- copy-f32 [src sn dst dn i]
  (if (>= i (quot sn 4))
    0
    (do (kernel-store-u32 (kernel-subregion dst dn (* i 4) 4) 4 0
                          (kernel-load-u32 (kernel-subregion src sn (* i 4) 4) 4 0))
        (copy-f32 src sn dst dn (+ i 1)))))

(defn- scale-mul [base bn st scale]
  (if (>= (st-i st) (st-n st))
    0
    (do (f32-put base bn (st-idx st)
                 (f32-to-bits (f32-mul (f32-from-bits (f32-at base bn (st-idx st)))
                                       (f32-from-bits scale))))
        (scale-mul base bn (st-next st) scale))))

;; ws = h | i << 12 | scale << 32; the width is the weights' length / 4
(defn- ws-h [ws] (bit-and ws 4095))
(defn- ws-i [ws] (bit-and (u64-shift-right ws 12) 131071))
(defn- ws-scale [ws] (f32w (u64-shift-right ws 32)))
(defn- ws-make [h scale] (bit-or h (i64-shift-left (u32w scale) 32)))

(defn- scale-mul-w [base bn w wn ws]
  (let [n (quot wn 4) i (ws-i ws) idx (+ (* (ws-h ws) n) i)]
    (if (>= i n)
      0
      (do (f32-put base bn idx
                   (f32-to-bits (f32-mul (f32-mul (f32-from-bits (f32-at base bn idx))
                                                  (f32-from-bits (ws-scale ws)))
                                         (f32-from-bits (f32-at w wn i)))))
          (scale-mul-w base bn w wn (+ ws 4096))))))

(defn- scale-mul-w-checked [base bn w wn ws]
  (let [n (quot wn 4) i (ws-i ws) idx (+ (* (ws-h ws) n) i)]
    (if (>= i n)
      0
      (do (f32-put base bn idx
                   (f32-to-bits (f32-mul (f32-mul (f32-from-bits (f32-at base bn idx))
                                                  (f32-from-bits (ws-scale ws)))
                                         (f32-from-bits (f32-at w wn i)))))
          (if (= 1 (nonfinite (f32-at base bn idx)))
            -8
            (scale-mul-w-checked base bn w wn (+ ws 4096)))))))

(defn- rms-scale [sum count]
  (f32-to-bits
   (f32-div (f32-from-bits 1065353216)
            (f32-sqrt (f32-add (f64-to-f32-rounded (f64-div (f64-from-bits sum)
                                                            (i64-to-f64-rounded count)))
                               (f32-from-bits 897988541))))))

(defn- l2-scale [sum]
  (f32-to-bits
   (f32-div (f32-from-bits 1065353216)
            (f32-sqrt (f32-add (f64-to-f32-rounded (f64-from-bits sum))
                               (f32-from-bits 897988541))))))

(defn- rmsw-fallback [base bn st mx]
  (f32-to-bits
   (f32-div (f32-div (f32-from-bits 1065353216) (f32-from-bits mx))
            (f32-sqrt
             (f64-to-f32-rounded
              (f64-add (f64-div (f64-from-bits (sumsq-scaled base bn st 0 mx))
                                (i64-to-f64-rounded (st-n st)))
                       (f64-div (f32-to-f64-exact (f32-from-bits 897988541))
                                (f64-mul (f32-to-f64-exact (f32-from-bits mx))
                                         (f32-to-f64-exact (f32-from-bits mx))))))))))

(defn- rmsw-one [base bn w wn h]
  (let [st (span h (quot wn 4))]
    (if (= 1 (any-nonfinite base bn st))
      -6
      (let [scale (if (= 1 (any-nonfinite-square base bn st))
                    (rmsw-fallback base bn st (maxabs base bn st 0))
                    (rms-scale (sumsq base bn st 0) (quot wn 4)))]
        (if (= 1 (nonfinite scale))
          -7
          (scale-mul-w-checked base bn w wn (ws-make h scale)))))))

;; hh = h | heads << 13 (h reaches heads, up to 4096, so it needs 13 bits)
(defn- rmsw-heads [a an w wn hh]
  (let [h (bit-and hh 8191) heads (u64-shift-right hh 13)]
    (if (>= h heads)
      0
      (let [v (rmsw-one a an w wn h)]
        (if (not (= v 0))
          v
          (rmsw-heads a an w wn (+ hh 1)))))))

(defn- rmsl-one [base bn w wn h]
  (scale-mul-w base bn w wn (ws-make h (rms-scale (sumsq-all base bn (span h (quot wn 4)) 0) (quot wn 4)))))

(defn- rmsl-heads [a an w wn hh]
  (let [h (bit-and hh 8191) heads (u64-shift-right hh 13)]
    (if (>= h heads)
      0
      (do (rmsl-one a an w wn h)
          (rmsl-heads a an w wn (+ hh 1))))))

;; hw = h | heads << 13 | width << 26
(defn- l2-heads [a an hw]
  (let [h (bit-and hw 8191) heads (bit-and (u64-shift-right hw 13) 8191) width (u64-shift-right hw 26)]
    (if (>= h heads)
      0
      (do (scale-mul a an (span h width) (l2-scale (sumsq a an (span h width) 0)))
          (l2-heads a an (+ hw 1))))))

(defn kotoba_aiueos_qwen35_norm [mh a a-length w w-length o o-length c]
  (let [mode (bit-and mh 255) b (u64-shift-right mh 8)]
    (if (= a 0) -1
      (if (< mh 0) -2
        (if (> mode 3) -2
          (if (< c 1) -3
            (if (> c 65536) -3
              (if (= mode 0)
                (if (= w 0) -5
                  (if (= o 0) -5
                    (if (not (= a-length (* c 4))) -9
                      (if (not (= w-length (* c 4))) -9
                        (if (not (= o-length (* c 4))) -9
                          (do (copy-f32 a a-length o o-length 0)
                              (scale-mul-w o o-length w w-length
                                           (ws-make 0 (rms-scale (sumsq a a-length (span 0 c) 0) c)))))))))
                (if (< b 1) -4
                  (if (> b 4096) -4
                    (if (> (* b c) 262144) -4
                      (if (not (= a-length (* b (* c 4)))) -9
                        (if (= mode 1)
                          (l2-heads a a-length (bit-or (i64-shift-left b 13) (i64-shift-left c 26)))
                          (if (= w 0) -5
                            (if (not (= w-length (* c 4))) -9
                              (if (= mode 2)
                                (rmsw-heads a a-length w w-length (i64-shift-left b 13))
                                (rmsl-heads a a-length w w-length (i64-shift-left b 13))))))))))))))))))
