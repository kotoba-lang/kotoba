;; Whether the UDP payload the Mac relay sent back is the ACK for THIS boot.
;;
;;   AIUEOS_NODE_ACK_V1 boot=<16 hex> state=accepted
;;
;; 55 bytes, fixed width. This object retires `kernel/relay_protocol.c`'s
;; `aiueos_relay_ack_payload` + `aiueos_relay_ack_payload_valid` (ADR-0213).
;; The C built the expected line into a scratch buffer and compared; here the
;; expected byte at each index is computed and compared in place, so there is
;; no scratch buffer and no second copy of the line to keep in step.
;;
;; The nonce crosses as two 32-bit halves for the reason
;; `relay-hello-payload.kotoba` gives: words are signed here and the boot
;; nonce is a raw `rdtsc`.
;;
;; RETURNS 1 when the payload is exactly the 55 expected bytes, else 0. A
;; wrong length is refused before the first load, so the load bound (55) is
;; never wider than the payload the caller measured: `rtl8125_server_udp_payload`
;; derives `length` from the UDP header it already admitted, and this object
;; reads only `length` bytes of it.

(ns aiueos.relay-ack-payload-valid
  ;; The export vector is what lets the verifier link this as a project
  ;; module (`verify-admissions.cljk`); the single-file object route ignores it.
  (:export [aiueos-relay-ack-payload-valid main]))

(defn hex-char [value]
  (if (< value 10) (+ 48 value) (+ 87 value)))

(defn nibble [value shift]
  ;; The hex digit at `shift` (0 = most significant of the 8-digit half).
  ;; `value` is a non-negative 32-bit half, so `quot` walks the right way.
  (bit-and (quot value (if (= shift 0) 268435456
                         (if (= shift 1) 16777216
                           (if (= shift 2) 1048576
                             (if (= shift 3) 65536
                               (if (= shift 4) 4096
                                 (if (= shift 5) 256
                                   (if (= shift 6) 16 1))))))))
           15))

(defn expected-char [index nonce-hi nonce-lo]
  ;; Layout: 0..23 banner, 24..31 nonce hi, 32..39 nonce lo, 40..54 suffix.
  (if (< index 24) (string-code-point-at "AIUEOS_NODE_ACK_V1 boot=" index)
    (if (< index 32) (hex-char (nibble nonce-hi (- index 24)))
      (if (< index 40) (hex-char (nibble nonce-lo (- index 32)))
        (string-code-point-at " state=accepted" (- index 40))))))

(defn match-from [payload index nonce-hi nonce-lo]
  (if (>= index 55)
    1
    (if (= (kernel-load-u8 payload 55 index) (expected-char index nonce-hi nonce-lo))
      (match-from payload (+ index 1) nonce-hi nonce-lo)
      0)))

(defn aiueos-relay-ack-payload-valid [payload length nonce-hi nonce-lo]
  (if (or (not (= length 55))
          (< nonce-hi 0) (> nonce-hi 4294967295)
          (< nonce-lo 0) (> nonce-lo 4294967295))
    0
    (match-from payload 0 nonce-hi nonce-lo)))

(defn main [] 0)
