(ns aiueos.value-handle-plan)

;; C-free decision core for the process-local ValueRuntime handle table.
;; The mechanism supplies observed table metadata and applies the returned
;; packed recipe only after rechecking the same entry under its process lock.
;;
;; operation: 0 allocate, 1 resolve, 2 cid-of, 3 release
;; entry-state: exactly 1 means live; every other value fails closed.
;;
;; Result layout (zero means reject):
;;   bits  0..7  action (1 allocate, 2 resolve, 3 cid-of, 4 release)
;;   bits  8..20 selected handle
;;   bits 21..33 next monotonic handle after the action
;;   bits 34..46 live count after the action

(defn pack-plan [action handle next-handle live-count]
  (+ action
     (* handle 256)
     (* next-handle 2097152)
     (* live-count 17179869184)))

(defn aiueos-value-handle-plan
  [operation next-handle live-count handle entry-state]
  (if (= operation 0)
    ;; Slots are never reused. 4097 is the exhausted sentinel after allocating
    ;; handle 4096; a later release decreases live-count but not next-handle.
    (if (and (= handle 0)
             (= entry-state 0)
             (> next-handle 0)
             (<= next-handle 4096)
             (>= live-count 0)
             (< live-count 4096))
      (pack-plan 1 next-handle (+ next-handle 1) (+ live-count 1))
      0)
    (if (and (>= operation 1)
             (<= operation 3)
             (> handle 0)
             (< handle next-handle)
             (<= next-handle 4097)
             (> live-count 0)
             (<= live-count 4096)
             (= entry-state 1))
      (if (= operation 1)
        (pack-plan 2 handle next-handle live-count)
        (if (= operation 2)
          (pack-plan 3 handle next-handle live-count)
          (pack-plan 4 handle next-handle (- live-count 1))))
      0)))

(defn main [] 0)
