;; The 64-bit TSS system descriptor of the GDT (JUN-599): the two words kernel/process.c's aiueos_process_initialize
;; wrote into aiueos_gdt_tss, built here from the TSS's base and limit.
;;
;; build(base, limit, out, 16): writes the 16-byte descriptor to out and answers 1 --
;;   word 0 = limit[15:0] | base[23:0] << 16 | 0x89 << 40 (present, DPL 0, type 9: available 64-bit TSS)
;;            | limit[19:16] << 48 | base[31:24] << 56
;;   word 1 = base[63:32]
;; exactly the C's expression. It answers 0 and writes nothing for an out length that is not 16, a base that is 0 or
;; not canonical (outside -2^47 .. 2^47 - 1), or a limit below 103 (the 104-byte 64-bit TSS) or past 0xfffff (the
;; descriptor's 20 bits). Byte granularity (G = 0) is what the C wrote; it is not a parameter.
(ns aiueos.tss-descriptor (:export [kotoba_aiueos_tss_descriptor_build]))
(defn kotoba_aiueos_tss_descriptor_build [base :i64 limit :i64 out :i64 out-length :i64] :i64
  (if (or (not= out-length 16) (= out 0) (= base 0) (< base -140737488355328) (> base 140737488355327)
          (< limit 103) (> limit 1048575)) 0
    (let [w0 (bit-or (bit-or (bit-and limit 65535) (i64-shift-left (bit-and base 16777215) 16))
                     (bit-or (i64-shift-left 137 40)
                             (bit-or (i64-shift-left (u64-shift-right (bit-and limit 983040) 16) 48)
                                     (i64-shift-left (bit-and (u64-shift-right base 24) 255) 56))))
          w1 (u64-shift-right base 32)
          s0 (kernel-store-u64 out out-length 0 w0)
          s1 (kernel-store-u64 out out-length 8 w1)]
      (+ 1 (* 0 (+ s0 s1))))))
