;; Guest permission-broker decision: admit clipboard or file-picker.
;;
;; WHY THIS IS A KOTOBA OBJECT AND NOT A C TABLE
;;
;; C already has a clipboard scratch (mechanism). WHETHER clipboard or
;; file-picker may run is a grant decision (ADR-0013 Phase 6 permission
;; broker). Hosted `kbb -M:compositor wm` does not count. The named
;; leftover after this object is linked is still
;; `:native-compositor-absent` (native component runtime, P5).
;;
;; ABI: [op granted-op] → 1 admit or 0 refuse.
;; op 1 = clipboard, op 2 = file-picker.
;; Admit only when op equals granted-op and op is 1 or 2.
;; Boot grant is clipboard-only (granted-op = 1).
;; Vector:
;; (1, 1) → 1 clipboard requested and granted
;; (2, 1) → 0 picker requested, clipboard-only grant
;; (1, 0) → 0 empty grant
;; (1, 2) → 0 clipboard requested, picker-only grant
;; Returning 1 for picker when granted-op is 1 is leftover :always-grant.
;;
;; Temporary native constraint: word types only, nested `if`, not a map
;; (ADR-2608650000: an unavailable backend is not a language ceiling).
;; Param names match ime-romaji (`a` `b`).
;;
;; Not a second compositor west repo. Not hosted JVM WM. Not CACAO write.

;; JUN-600: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form and takes no test main; the predicate is unchanged.
(ns aiueos.broker-admit (:export [kotoba_aiueos_broker_admit]))

(defn kotoba_aiueos_broker_admit [a b]
  (if (= a b)
    (if (< a 1) 0
      (if (< a 3) 1
        0))
    0))

