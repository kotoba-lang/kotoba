;; JUN-600: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form and takes no test main; the integer flags are tested as (not (= v 0)), the native route's bool -- the old route's
;; truthiness, which journal-plan-native-diff checks over 0, +-1, 2 and other values; the plan is otherwise unchanged.
(ns aiueos.journal-plan (:export [kotoba_aiueos_journal_plan]))

(defn kotoba_aiueos_journal_plan [valid0 sequence0 valid1 sequence1]
  (if (not (= valid0 0))
    (if (not (= valid1 0))
      (if (> sequence1 sequence0)
        (+ sequence1 8589934593)
        (+ sequence0 12884901889))
      (+ sequence0 12884901889))
    (if (not (= valid1 0))
      (+ sequence1 8589934593)
      1)))

