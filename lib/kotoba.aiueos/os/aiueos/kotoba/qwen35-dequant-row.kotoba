(ns aiueos.qwen35-dequant-row
  (:require [aiueos.lib.qwen35-dequant-core :as dq])
  (:export [aiueos-qwen35-dequant-row main]))

;; One quantised weight row -> `count` binary32 values in a caller-owned
;; workspace. A port of `aiueos_qwen35_dequantize_row`
;; (`kernel/qwen35_quant.c:584`) for the four types this object admits, whose
;; equations come from ggml-org/llama.cpp @3173a564 (MIT) by way of that file.
;;
;; ## Return
;;
;; **Zero is the success value**, the `aiueos-dhcp-reply-valid` convention. A
;; caller that writes `if (dequantize(...))` inverts the decision.
;;
;;    0    the row was written
;;   -1    null source
;;   -2    null destination
;;   -3    destination length is not a positive multiple of four
;;   -4    element count above this object's 65,536 ceiling
;;   -5    source length is not the row byte count for this type and count
;;   -6    quantisation type is not one of the seventeen ggml types the two
;;         admitted artifacts hold (0 8 10 11 12 13 14 16 17 18 19 21 22 23
;;         29, and Bonsai's 30 143 -- ADR-0222)
;;
;; ## Which types
;;
;; All fifteen the Qwen3.8 artifact holds (`contracts/qwen38-qwen35-runtime-v1.edn`
;; `:tensor-types`), since ADR-0221, and the two Ternary Bonsai 2 adds
;; (`contracts/bonsai2-qwen35-runtime-v1.edn`: PTQ1_0 143, BF16 30), since
;; ADR-0222 stage A. Until then this object decoded F32, Q8_0,
;; Q4_K and Q6_K -- the four "whose equations are pure arithmetic over the
;; block's own bytes" -- and the codebook families (IQ3_XXS 120 tensors,
;; IQ3_S 106, IQ4_XS 45, IQ2_S 35, ...) stayed in the C because this dialect
;; had no rodata to hold a grid. It has one now (`bytes-literal`), and the
;; arithmetic of every type lives ONCE in `aiueos.lib.qwen35-dequant-core`,
;; which `qwen35-matvec` shares instead of carrying a second copy.
;;
;; ## The scale is recomputed per element
;;
;; The C hoists `d` and `dmin` out of the element loop; this object reads and
;; converts them again for every element, because a hoisted value would have to
;; travel as a sixth parameter and the ABI admits five. The cost is fuel, not
;; correctness: `fp16-bits` is a pure function of four bytes it re-reads, so
;; every element sees the same `d` the C's hoisted one holds. Measured: 22 fuel
;; per Q4_K element against 6 for the arithmetic alone.
;;
;; ## Rounding
;;
;; Every arithmetic step is binary32 in the same order and with the same
;; operands as the C, so the bytes written are the bytes the C writes. The one
;; place order is load-bearing is Q6_K's `d * sc[is] * q`, which C evaluates
;; left to right as `(d * sc) * q` and this object writes that way.


(defn aiueos-qwen35-dequant-row [qtype src src-length dst dst-length]
  (if (= src 0) -1
    (if (= dst 0) -2
      (if (< dst-length 4) -3
        (if (not (= 0 (- dst-length (* 4 (quot dst-length 4))))) -3
          (if (> (quot dst-length 4) 65536) -4
            (if (= (dq/supported qtype) 0) -6
              (if (not (= src-length (dq/row-bytes qtype (quot dst-length 4)))) -5
                (dq/dequant-run qtype src src-length dst (quot dst-length 4))))))))))

(defn main [] 0)
