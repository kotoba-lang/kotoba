;; RFC 9293 §3.10.7.4: is an arriving segment acceptable against the receive
;; window?
;;
;; `tcp-segment-valid.kotoba` admits a segment from the Ethernet header up --
;; envelope, exact flags, acknowledgement number -- and says of itself that the
;; arity is spent before it reaches this question. So the OS checks that a
;; segment is well-formed and belongs to the peer, and does not check that it
;; falls inside the window. Those are different questions, and only this one
;; keeps an old duplicate out of a synchronised connection.
;;
;; The sequence space wraps at 2^32, so every comparison here is modular. A
;; stack that compares raw integers works until the wrap and then rejects
;; everything for a while, which is the failure that looks like a network
;; problem and is not.
;;
;; Four cases, kept apart rather than collapsed, because the zero-length and
;; zero-window ones are what a hand-written stack drops:
;;
;;   len 0, wnd 0   only an exact match at RCV.NXT
;;   len 0, wnd >0  the sequence must fall in the window
;;   len >0, wnd 0  nothing is acceptable
;;   len >0, wnd >0 either end of the segment must fall in the window
;;
;; ONE SYMBOL, NO CALLS OUT. A kernel object exports one entry and cannot call
;; another (ADR-0030), so the wrap arithmetic below is a copy of what
;; `kotoba-lang/org-ietf-tcp` holds in `kotoba/tcp/seq_core.kotoba`. That copy
;; is checked, not assumed: `tcp_seq_acceptable_parity_test` drives this object
;; through the KIR interpreter against `tcp.seq/acceptable?` over inputs chosen
;; around the wrap.
;;
;; Wrapping is `bit-and` with 2^32-1 rather than `mod` by 2^32. The two agree on
;; every i64 including negative ones, and `-seq` produces negatives on every
;; wrap, so exactness there is load-bearing rather than incidental.

(def aiueos-tcp-seq-mask 4294967295)            ; 2^32 - 1
(def aiueos-tcp-seq-half 2147483648)            ; 2^31

(defn aiueos-tcp-seq-wrap [n]
  (bit-and n aiueos-tcp-seq-mask))

(defn aiueos-tcp-seq-add [a b]
  (aiueos-tcp-seq-wrap (+ a b)))

;; Forward distance from `a` to `b`. Never negative -- that is the property the
;; comparisons below rely on, and the one that makes a naive subtraction wrong.
(defn aiueos-tcp-seq-sub [b a]
  (aiueos-tcp-seq-wrap (- b a)))

;; `a` is before `b` when the forward distance is less than half the space.
;; Equality is not "before", and two numbers exactly 2^31 apart are not ordered
;; at all -- the protocol cannot tell which came first, and this returns false
;; both ways rather than inventing an answer.
(defn aiueos-tcp-seq-lt [a b]
  (let [d (aiueos-tcp-seq-sub b a)]
    (if (> d 0) (if (< d aiueos-tcp-seq-half) 1 0) 0)))

(defn aiueos-tcp-seq-leq [a b]
  (if (= (aiueos-tcp-seq-wrap a) (aiueos-tcp-seq-wrap b)) 1
      (aiueos-tcp-seq-lt a b)))

;; Half-open window [lo, hi).
(defn aiueos-tcp-seq-between [x lo hi]
  (if (= (aiueos-tcp-seq-leq lo x) 1) (aiueos-tcp-seq-lt x hi) 0))

;; The `(> seg-len 1)` guard below is dead, in this object and in the reference
;; both. It differs from a bare `(- seg-len 1)` only at length zero, and length
;; zero takes the other branch, so `end` is computed and discarded. Replacing it
;; leaves every parity assertion green -- that was run. It is kept because the
;; reference keeps it, and it is called out here so nobody reads the parity
;; suite's silence on it as coverage.
(defn aiueos-tcp-seq-acceptable [seg-seq seg-len rcv-nxt rcv-wnd]
  (let [win-end (aiueos-tcp-seq-add rcv-nxt rcv-wnd)
        end (aiueos-tcp-seq-add seg-seq (if (> seg-len 1) (- seg-len 1) 0))]
    (if (= seg-len 0)
      (if (= rcv-wnd 0)
        (if (= (aiueos-tcp-seq-wrap seg-seq) (aiueos-tcp-seq-wrap rcv-nxt)) 1 0)
        (aiueos-tcp-seq-between seg-seq rcv-nxt win-end))
      (if (= rcv-wnd 0)
        0
        (if (= (aiueos-tcp-seq-between seg-seq rcv-nxt win-end) 1) 1
            (aiueos-tcp-seq-between end rcv-nxt win-end))))))

(defn main [] 0)
