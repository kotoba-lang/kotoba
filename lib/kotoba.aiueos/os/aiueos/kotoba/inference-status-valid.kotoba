;; Whether an inference status record may be shown and reported.
;;
;; This object retires the DECISION of `kernel/inference_status.c`'s
;; `aiueos_inference_status_valid` (ADR-0219). The C read seventeen struct
;; fields, three of them `const char *`; a pointer loaded from memory cannot
;; be a region root here (`:kotoba.error/kernel-region-provenance`, ADR-0212),
;; so the struct crosses as ONE FLAT RECORD the C packs and this object reads
;; by offset. The record IS the marshalling contract; the C side that fills it
;; is mechanism and holds no comparison.
;;
;;   aiueos-inference-status-record/v1, 200 bytes
;;     0  u32 abi_version
;;     4  u32 byte_size            (what the caller's struct says)
;;     8  u32 expected_byte_size   (sizeof the struct, the C literal)
;;    12  u32 phase
;;    16  u32 prompt_tokens
;;    20  u32 generated_tokens
;;    24  u32 decode_tokens
;;    28  u32 target_tokens
;;    32  u64 artifact_bytes       (carried, not judged)
;;    40  u64 resident_bytes       (carried, not judged)
;;    48  u64 load_ns
;;    56  u64 prefill_ns
;;    64  u64 decode_ns
;;    72  u64 time_to_first_token_ns
;;    80  u64 compute_cycles
;;    88  u8  status pointer was non-null
;;    89  u8  model pointer was non-null
;;    90  u8  quant pointer was non-null
;;    91  u8  detail pointer was non-null
;;    96  33 bytes of model  -- text[0..32] copied up to and including NUL
;;   129  33 bytes of quant
;;   162  33 bytes of detail
;;   195  5 bytes zero
;;
;; Words are signed. `AIUEOS_INFERENCE_UNMEASURED` (UINT64_MAX) therefore
;; arrives as -1, and the C's `value > 0` on an unsigned duration is `(not (=
;; value 0))` here -- the same predicate, because every non-zero uint64_t is
;; > 0. Token counts are u32 loads and never negative.
;;
;; RETURNS 1 when the record is valid, else 0 -- the C's int.

(ns aiueos.inference-status-valid
  (:export [aiueos-inference-status-valid main]))

(defn record-length [] 200)

(defn text-scan [record at length]
  ;; `bounded_display_text`'s loop: walk while length <= 32 and text[length]
  ;; is not NUL, refusing any byte outside 0x20..0x7e. Returns the length, or
  ;; -1 for a byte outside the printable range.
  (if (> length 32)
    length
    (let [c (kernel-load-u8 record 200 (+ at length))]
      (if (= c 0)
        length
        (if (or (< c 32) (> c 126))
          -1
          (text-scan record at (+ length 1)))))))

(defn text-ok [record at present required]
  ;; 1 = accepted. A null pointer is accepted only when not required.
  (if (= present 0)
    (if (= required 0) 1 0)
    (let [n (text-scan record at 0)]
      (if (or (< n 1) (> n 32)) 0 1))))

(defn measured [value]
  ;; `duration()`: UNMEASURED (-1 here) or any non-zero value.
  (if (= value 0) 0 1))

(defn unmeasured [value] (if (= value -1) 1 0))

(defn aiueos-inference-status-valid [record length]
  (if (not (= length 200))
    0
    (let [non-null (kernel-load-u8 record 200 88)
          abi (kernel-load-u32 record 200 0)
          byte-size (kernel-load-u32 record 200 4)
          expected-size (kernel-load-u32 record 200 8)
          phase (kernel-load-u32 record 200 12)
          prompt (kernel-load-u32 record 200 16)
          generated (kernel-load-u32 record 200 20)
          decode (kernel-load-u32 record 200 24)
          target (kernel-load-u32 record 200 28)
          load-ns (kernel-load-u64 record 200 48)
          prefill-ns (kernel-load-u64 record 200 56)
          decode-ns (kernel-load-u64 record 200 64)
          ttft-ns (kernel-load-u64 record 200 72)
          cycles (kernel-load-u64 record 200 80)]
      (if (or (= non-null 0)
              (not (= abi 2))
              (not (= byte-size expected-size))
              (< phase 1) (> phase 7)
              (= (text-ok record 96 (kernel-load-u8 record 200 89) 1) 0)
              (= (text-ok record 129 (kernel-load-u8 record 200 90) 1) 0)
              (= (text-ok record 162 (kernel-load-u8 record 200 91) 0) 0)
              (> prompt 10000000)
              (> generated 10000000)
              (> decode generated)
              (> target 10000000)
              (and (not (= target 0)) (> generated target))
              (= (measured load-ns) 0) (= (measured prefill-ns) 0)
              (= (measured decode-ns) 0) (= (measured ttft-ns) 0))
        0
        (if (or (and (not (= decode 0)) (= (unmeasured decode-ns) 1))
                (and (= decode 0) (= (unmeasured decode-ns) 0)))
          0
          (if (and (= phase 5)
                   (or (= generated 0)
                       (and (= (unmeasured decode-ns) 1) (= cycles 0))))
            0
            1))))))

(defn main [] 0)
