;; JUN-552: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form first, takes no test main and exports nothing else; the logic is unchanged.
(ns aiueos.copy-in (:export [kotoba_aiueos_copy_in]))

(defn- aiueos-copy-step [source source-length destination destination-length count]
  (if (= count 0)
    1
    (let [index (- count 1)
          value (kernel-load-u8 source source-length index)
          written (kernel-store-u8 destination destination-length index value)]
      (if (= written value)
        (aiueos-copy-step source source-length destination destination-length index)
        0))))

(defn kotoba_aiueos_copy_in [source source-length destination destination-length count]
  (if (and (> count 0)
           (<= source-length 512)
           (<= destination-length 512)
           (<= count source-length)
           (<= count destination-length))
    (aiueos-copy-step source source-length destination destination-length count)
    0))

