;; JUN-708: built on amu's native object route: the namespace form comes first and exports the C name only, with no
;; test main and private helpers. The requested id is a fixed 16-byte record read as two words; the metadata window
;; names the metadata length, which the export now takes right after the metadata. The plan is unchanged.
(ns aiueos.app-lookup-plan (:export [kotoba_aiueos_app_lookup_plan]))

;; Fixed-count application lookup over packed metadata records:
;; id[16], length:u32le, ready:u8. A successful plan packs length in the high
;; bits and one-based object index in the low three bits.
;;
;; The length ceiling follows the catalog extent: 12,288 was the aiuefs app
;; extent until JUN-145's S5 raised it to 98,304 (commit 9a792a0 moved the
;; host builder, the payload buffers, the recovery ELF buffer and loader.c,
;; but not this plan nor its C twin in pci.c -- so a signed 65,904-byte app
;; could be admitted by the filesystem and still never be looked up).

(defn- record-load-u64-0-16 [b :i64] :i64 0)
(defn- record-load-u64-8-16 [b :i64] :i64 0)

(defn- load32le [base length offset]
  (+ (kernel-load-u8 base length offset)
     (+ (* (kernel-load-u8 base length (+ offset 1)) 256)
        (+ (* (kernel-load-u8 base length (+ offset 2)) 65536)
           (* (kernel-load-u8 base length (+ offset 3)) 16777216)))))

(defn- load64le [base length offset index word]
  (if (= index 8) word
    (load64le base length offset (+ index 1)
      (bit-or word (i64-shift-left (kernel-load-u8 base length (+ offset index)) (* index 8))))))

(defn- scan [metadata length id0 id1 state]
  (let [count (bit-and state 7)
        app (bit-and (u64-shift-right state 3) 7)
        plan (u64-shift-right state 6)]
  (if (= app count) plan
    (let [base (* app 21)
          same-id (and (= (load64le metadata length base 0 0) id0)
                       (= (load64le metadata length (+ base 8) 0 0) id1))
          object-length (load32le metadata length (+ base 16))
          ready (kernel-load-u8 metadata length (+ base 20))
          next-plan (if same-id
                      (if (= ready 1)
                        (if (> object-length 0)
                          (if (<= object-length 98304)
                            (+ (+ app 1) (* object-length 8)) 0)
                          0)
                        0)
                      plan)]
      (scan metadata length id0 id1 (+ count (* (+ app 1) 8) (* next-plan 64)))))))

;; The native route roots the metadata window only in a base with its own length, so the export takes the metadata
;; length right after the metadata (kernel/pci.c passes the arguments in this order); the decision is unchanged.
(defn kotoba_aiueos_app_lookup_plan [requested metadata metadata-length count stride]
  (if (< count 1) 0
    (if (> count 4) 0
      (if (not (= stride 21)) 0
        (if (not (= metadata-length (* count stride))) 0
          (scan metadata metadata-length (record-load-u64-0-16 requested) (record-load-u64-8-16 requested) count))))))
