(ns aiueos.sha256-region
  (:require [aiueos.lib.sha256-stream :as sha])
  (:export [aiueos-sha256-region main]))

;; SHA-256 of an arbitrary-length region, in one call, for the freestanding
;; aiueos kernel.
;;
;;   (aiueos-sha256-region st st-len src src-len)
;;
;; ---------------------------------------------------------------------------
;; NOT A BOOLEAN. ZERO IS THE SUCCESS VALUE.
;; ---------------------------------------------------------------------------
;;     0   done -- the 32 raw digest bytes are in `st` at offset 424
;;     1   st-len below the 512 bytes the state region requires
;;     2   src-len negative
;;     3   src-len above the ceiling below
;;
;; ---------------------------------------------------------------------------
;; THE CEILING IS 1,048,576 BYTES, AND IT IS NOT ARBITRARY
;; ---------------------------------------------------------------------------
;; The loop is bounded by `full`, which is `(quot src-len 64)` -- derived from
;; the caller's own length, not from anything ambient -- and this entry refuses
;; a length above a literal before the loop starts. So there is no unbounded
;; loop; the only question is where the literal goes.
;;
;; It goes at 1 MiB because that is what the FUEL can pay for. The prologue's
;; replenish is `mov qword [r11+8], imm32` (kotoba-native `elf64.cljc`), so the
;; largest budget any object can be given is 2,147,483,647. This object was
;; MEASURED at 1,772 fuel per 64-byte block plus 105 fixed (see
;; `contracts/sha256-region-v1.edn`), so the absolute ceiling any fuel tier can
;; reach is about 1,211,000 blocks -- 77 MiB. 1 MiB is 16,384 blocks =
;; 29,032,553 fuel, which the object's 250,000,000 tier clears 8.6x.
;;
;; A 2^32-byte ceiling would be a lie in the shape this repository keeps
;; naming: the object would accept the argument and `ud2` in its prologue
;; partway through, which surfaces as an unexpected vector 6 and reads as a
;; protocol bug rather than a fuel bug. So the ceiling is stated at a value the
;; object can actually reach, and raising it is a fuel re-measurement, not an
;; edit to this number alone.
;;
;; 1 MiB covers both callers that exist: the device-P256 worker's widest
;; canonical input is 131,080 bytes (`4*(32768+2)`; the protocol caps the token
;; array at 32,768), and the UEFI loader's kernel image is under 1 MiB by the
;; link script's own ceiling. It does NOT cover the 10.9 GiB model file; that
;; needs the streaming entry driven by the caller, which is what
;; `aiueos-sha256-stream` is for and why both exist.

(defn aiueos-sha256-region [st st-len src src-len]
  (if (< st-len 512) 1
    (if (< src-len 0) 2
      (if (> src-len 1048576) 3
        (let [full (quot src-len 64)
              rem (- src-len (* full 64))
              i (sha/sha-init st)
              b (sha/sha-blocks st src src-len 0 full)]
          (* 0 (+ i (+ b (sha/sha-final st
                                        (kernel-subregion src src-len (* full 64) rem)
                                        rem)))))))))

(defn main [] 0)
