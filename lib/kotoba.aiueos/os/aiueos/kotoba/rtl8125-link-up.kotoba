;; JUN-708: a single-file source for amu's native object route. The namespace form comes first and exports the C name
;; only, with no test main and private helpers; mmio-ok is inlined from aiueos/lib/rtl8125_regs.kotoba (the route has
;; no :require), and the register load uses the 16 KiB tier with the window's own length (the route has no 4 KiB tier;
;; the export admits only 4096). The answer is unchanged.
(ns aiueos.rtl8125-link-up (:export [kotoba_aiueos_rtl8125_link_up]))

;; Inlined from aiueos/lib/rtl8125_regs.kotoba (the native route has no :require): mmio-ok.
;; Is this a BAR window this driver will touch at all?
;;
;; `aiueos_map_pci_mmio(bar, 4096)` at kernel/pci.c:4056 maps exactly one page
;; per BAR, and the highest register `rtl8125.c` reaches is RGE_RXDESC_HI at
;; 0xe8 (:23). So the length is not merely bounded, it is EXACTLY 4096: a caller
;; who hands over a shorter window has mapped something else, and one who hands
;; over a longer window is claiming a mapping the C never makes.
;;
;; A zero base is refused for the reason the C refuses a null `io->context`
;; (`io_valid`, :125-128) -- there is no device at physical zero -- and a
;; negative base is refused because `bit-and`/`quot` on a negative i64 would
;; make the bounds arithmetic below mean something else. Physical addresses on
;; this path are under 2^40 (see `mmio-map-admit.kotoba`), so nothing legitimate
;; is being turned away.
(defn- mmio-ok [base length]
  (if (or (<= base 0) (not (= length 4096))) 0 1))

;; Does the PHY report a link?
;;
;;   (aiueos-rtl8125-link-up mmio-base mmio-length) -> 0 or 1
;;
;; `aiueos_rtl8125_link_up` (kernel/rtl8125.c:254-257): one u16 read of
;; RGE_PHYSTAT (0x6c) masked with RGE_PHYSTAT_LINK (0x0002).
;;
;; A BOOLEAN, unlike its four zero-is-success neighbours, because the C returned
;; `int` here and every call site is `if (!aiueos_rtl8125_link_up(...))`. Making
;; it a reason code would silently invert every one of them.
;;
;; The C's other two clauses -- `device && device->ready` -- are the caller's
;; and stay there: `ready` is a field of a struct this object does not see, and
;; a caller who asks about a device it has not taken over is asking a question
;; about its own state rather than about the wire.
;;
;; A window this object refuses reads as NO LINK rather than as an error,
;; because that is the shape the C's `int` has and because the failure it
;; produces -- the qualification path reporting error 20 and stopping -- is the
;; safe one. There is no MMIO access on that path.
;;
;; WHY THIS IS ITS OWN OBJECT rather than a clause of `identify`. Link state is
;; the one thing here that CHANGES: `rtl8125_qualify_device` (kernel/pci.c:4078)
;; asks after takeover, and the persistent worker asks again on every reconnect.
;; The revision and the MAC are read once and never again.
(defn kotoba_aiueos_rtl8125_link_up [mmio-base mmio-length]
  (if (= 0 (mmio-ok mmio-base mmio-length))
    0
    ;; RGE_PHYSTAT 0x6c = 108, RGE_PHYSTAT_LINK 0x0002 = 2.
    (if (= 0 (bit-and (kernel-load-u16-16k mmio-base mmio-length 108) 2))
      0
      1)))
