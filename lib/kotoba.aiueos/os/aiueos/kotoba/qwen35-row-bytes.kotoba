;; aiueos_qwen35_quant_row_bytes of kernel/qwen35_quant.c in Kotoba (JUN-554): the bytes of one row of `elements` values of
;; a ggml type, or 0 when the type is not one of the fifteen or the row is not whole blocks. Called on the live forward
;; pass (tensor_row, matvec_range, select_output_token).
;;
;; elements is the C's uint64_t: every test is unsigned -- the f32 overflow check is a shift, the block remainders are
;; masks and the divisions are shifts -- and the products wrap mod 2^64 exactly as the C's do. A type with a non-zero
;; upper half (the C's is a uint32_t) is not one of the fifteen.
;;
;; Built by the Amu aiueos kernel object route at amu 65359a09, fuel 4194304.
(ns aiueos.qwen35-row-bytes
  (:export [kotoba_aiueos_qwen35_row_bytes]))
;; 256-element super-blocks: the block's bytes for each K / IQ type, 0 for any other
(defn- k-block [type :i64] :i64
  (cond (= type 10) 84 (= type 11) 110 (= type 12) 144 (= type 13) 176 (= type 14) 210
        (= type 16) 66 (= type 17) 74 (= type 18) 98 (= type 19) 50 (= type 21) 110
        (= type 22) 82 (= type 23) 136 (= type 29) 56 :else 0))
(defn kotoba_aiueos_qwen35_row_bytes [type :i64 elements :i64] :i64
  (if (= elements 0) 0
    (cond (= type 0) (if (not= (u64-shift-right elements 62) 0) 0 (* elements 4))
          (= type 8) (if (not= (bit-and elements 31) 0) 0 (* (u64-shift-right elements 5) 34))
          :else (let [k (k-block type)]
                  (if (or (= k 0) (not= (bit-and elements 255) 0)) 0 (* (u64-shift-right elements 8) k))))))
