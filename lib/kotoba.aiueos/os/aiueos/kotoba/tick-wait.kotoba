;; plc_runtime.c's wait for the next scan release in Kotoba (JUN-554), over amu ADR 0392's kernel-wait-interrupt.
;;
;; wait(ticks, 8, target, rounds): the APIC timer's tick counter (u64 @ticks) against a release tick. Answers 1 as soon
;; as the counter has reached target; otherwise halts until the next interrupt (sti; hlt; cli) and looks again, at most
;; rounds (1..65536) times, and answers 2 when they run out without the counter reaching target, so the C, whose wait
;; has no budget, calls it again. Each look-then-halt is one iteration of the C's loop. Answers 0 for a null pointer,
;; a wrong length, rounds outside 1..65536, or a target past 2^62.
(ns aiueos.tick-wait (:export [kotoba_aiueos_tick_wait]))
(defn- wait-rounds [c :i64 cn :i64 target :i64 left :i64] :i64
  (let [now (kernel-load-u64 c cn 0)]
    (cond (>= now target) 1
          (<= left 0) 2
          :else (let [w (kernel-wait-interrupt)] (wait-rounds c cn target (- left (+ 1 (* 0 w))))))))
(defn kotoba_aiueos_tick_wait [ticks :i64 tn :i64 target :i64 rounds :i64] :i64
  (if (or (= ticks 0) (not= tn 8) (< rounds 1) (> rounds 65536) (< target 0) (> target 4611686018427387904)) 0
    (wait-rounds ticks tn target rounds)))
