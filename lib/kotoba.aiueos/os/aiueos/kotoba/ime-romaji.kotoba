;; Guest IME decision: two latin bytes → hiragana codepoint.
;;
;; WHY THIS IS A KOTOBA OBJECT AND NOT A C TABLE
;;
;; C already copies EV_KEY into the desktop envelope (mechanism). WHICH
;; roman letters become which kana is a conversion decision. Hosted
;; `aiueos.compositor.ime` already does that conversion in the JVM
;; compositor (ADR-0086). That does not count as guest IME. The named
;; leftover after this object is linked is `:native-compositor-absent`.
;;
;; Temporary native constraint: word types only, nested `if`, not a map
;; (ADR-2608650000: an unavailable backend is not a reason to remove a
;; specified safe language feature). Remove this header when native has
;; maps. `and`/`or` desugar; comparisons are spelled as nested `if`
;; because `if` branches must agree on a value type.
;;
;; ABI: [a b] two latin bytes (0 if absent). Returns Unicode codepoint
;; or 0 refuse. Vector: 107 ('k'), 97 ('a') must return 12363 (U+304B か).
;; Returning the latin bytes themselves is a leak (refuse 0).
;;
;; Not mozc. Not a west IME repo. Not hosted JVM IME.

(defn aiueos-ime-commit [a b]
  (if (= a 107)
    (if (= b 97) 12363
      (if (= b 105) 12365
        0))
    (if (= a 97)
      (if (= b 0) 12354
        0)
      0)))

(defn main [] 0)
