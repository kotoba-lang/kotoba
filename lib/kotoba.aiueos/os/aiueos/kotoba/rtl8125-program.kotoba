;; JUN-708: a single-file source for amu's native object route. The namespace form comes first and exports the C name
;; only, with no test main and private helpers; mmio-ok, desc-ok and receive-config are inlined from aiueos/lib/rtl8125_regs.kotoba (the route has
;; no :require). The logic is unchanged.
(ns aiueos.rtl8125-program (:export [kotoba_aiueos_rtl8125_program]))

;; The RTL8125 register sequence: stop the engine, then point it at new rings
;; and start it again.
;;
;;   (aiueos-rtl8125-program mmio-base mmio-length tx-desc-physical
;;                           rx-desc-physical revision)
;;
;; This is the MMIO half of `rings_restart` (kernel/rtl8125.c:160-204) --
;; everything in that function except the descriptor stores, which
;; `rtl8125-ring-build` owns.
;;
;; ---------------------------------------------------------------------------
;; THE LAST ARGUMENT IS A PHASE AND A REVISION AT THE SAME TIME
;; ---------------------------------------------------------------------------
;;   revision 0     STOP PHASE. Set RGE_CMD_STOP, wait for the transmit FIFO to
;;                  drain, clear RGE_CMD. `tx-desc-physical` and
;;                  `rx-desc-physical` are not read.
;;   revision 1..4  PROGRAM PHASE. Publish the descriptors, load the ring
;;                  addresses, set the receive filter for that silicon
;;                  revision, and enable transmit and receive.
;;
;; That is not an economy, it is the C's own ordering made expressible. The C
;; runs stop -> drain -> clear -> BUILD THE DESCRIPTORS -> program -> enable, in
;; one function, because it can call `bytes_zero` in the middle. A Kotoba object
;; cannot call another object, so the caller has to be the one that interleaves,
;; and to interleave it needs two entries. Two entries need either two symbols
;; or one argument that says which -- and the argument that says which was
;; already there, because the program phase needs the revision and the stop
;; phase does not. Zero is not a revision `revision-of` ever returns.
;;
;; Building the rings BEFORE the stop, to avoid the two-phase call, is not the
;; same program. On a restart the ring registers still point at these very
;; descriptors and the engine may still be running: rewriting a descriptor's
;; address while the hardware owns it is how a frame lands in a buffer the
;; kernel has already handed on. The C stops first for that reason and so does
;; this.
;;
;; ZERO IS SUCCESS. Non-zero is `enum aiueos_rtl8125_result` unchanged:
;;   1  AIUEOS_RTL8125_INVALID       arguments; no MMIO access was performed
;;   4  AIUEOS_RTL8125_FIFO_TIMEOUT  the transmit FIFO never reported empty
;;
;; ---------------------------------------------------------------------------
;; THE DRAIN, AND WHY IT HAS TWO BOUNDS
;; ---------------------------------------------------------------------------
;; The C spins a literal 300,000 times reading RGE_MCUCMD (0xd3) until both
;; RGE_FIFO_EMPTY bits (0x30) are set (:171-178). A spin count is not a timeout:
;; how long 300,000 register reads take depends on the machine, and an MMIO read
;; from a device that has stopped answering is not the same cost as one from a
;; device that is merely busy.
;;
;; So this keeps the C's literal budget AND adds a `kernel-rdtsc` deadline. The
;; budget is what makes the object's cost closed-form -- 300,020 charged calls
;; at the worst shape, which is what its fuel tier is computed from -- and the
;; deadline is what makes the WALL TIME bounded. The deadline can only make the
;; loop end earlier, so it does not move the fuel bound.
;;
;; 2,000,000,000 TSC ticks is between half a second and a second on the machines
;; this kernel runs on, and the constant is deliberately generous: it exists to
;; stop a boot hanging on a wedged device, not to be a tight timing gate. On any
;; machine where 300,000 register reads take less than that, the two bounds
;; agree with the C exactly and the deadline is never the reason the loop ends.
;;
;; A VALUE-SCALED loop -- one whose iteration count came from an argument --
;; would make the fuel bound a function of the caller, and a fuel bound that
;; depends on the caller is not a bound. Both of these are literals.

;; Inlined from aiueos/lib/rtl8125_regs.kotoba (the native route has no :require): mmio-ok, desc-ok, receive-config.
;; Is this a BAR window this driver will touch at all?
;;
;; `aiueos_map_pci_mmio(bar, 4096)` at kernel/pci.c:4056 maps exactly one page
;; per BAR, and the highest register `rtl8125.c` reaches is RGE_RXDESC_HI at
;; 0xe8 (:23). So the length is not merely bounded, it is EXACTLY 4096: a caller
;; who hands over a shorter window has mapped something else, and one who hands
;; over a longer window is claiming a mapping the C never makes.
;;
;; A zero base is refused for the reason the C refuses a null `io->context`
;; (`io_valid`, :125-128) -- there is no device at physical zero -- and a
;; negative base is refused because `bit-and`/`quot` on a negative i64 would
;; make the bounds arithmetic below mean something else. Physical addresses on
;; this path are under 2^40 (see `mmio-map-admit.kotoba`), so nothing legitimate
;; is being turned away.
(defn- mmio-ok [base length]
  (if (or (<= base 0) (not (= length 4096))) 0 1))

;; Is this a descriptor ring address the hardware can be pointed at?
;;
;; `aiueos_rtl8125_takeover` (:213-217) refuses a null descriptor and one whose
;; low eight bits are set: `(tx_desc_physical & 0xffU)` and `((uintptr_t)tx &
;; 0xffU)`. Both clauses are the same clause here, because AIUEOS maps physical
;; memory identically and `aiueos_allocate_physical_page` returns a page-aligned
;; address that IS its own physical address -- the C carries the pointer and the
;; physical address separately and checks both, which two arguments of one
;; object cannot do and would not mean anything different if they could.
;;
;; 256 rather than 32: a descriptor is 32 bytes and the hardware would accept
;; 32-byte alignment, but the C asks for 256 and this object is a transcription,
;; not a re-derivation. Relaxing it here would admit rings the C refuses.
(defn- desc-ok [base]
  (if (or (<= base 0) (not (= 0 (bit-and base 255)))) 0 1))

;; The whole word written to RXCFG (0x44), not just the revision-dependent half.
;;
;; The C splits this in two -- `receive_config` (:140-144) returns the base and
;; `rings_restart` (:200-201) ORs in RGE_RXCFG_INDIVIDUAL (0x02) and
;; RGE_RXCFG_BROADCAST (0x08) -- and the split is what makes the C's own model
;; test assert `0x41000c0a` rather than `0x41000c00`. Joined here because the
;; two halves have exactly one call site between them and the acceptance filter
;; is one decision: this NIC accepts frames addressed to its own MAC and
;; broadcasts, and nothing else. Promiscuous and multicast bits are absent by
;; construction rather than by an omission a reader has to notice.
;;
;;   1  RTL8125       0x41000700 | 0x0a = 0x4100070a
;;   2  RTL8125B      0x41000c00 | 0x0a = 0x41000c0a
;;   3, 4  RTL8125D   0x41200c00 | 0x0a = 0x41200c0a
;;
;; The C's `receive_config` falls through to the 8125D word for ANY revision
;; that is not 1 or 2, and the fall-through is reproduced rather than tightened:
;; the caller has already refused revision 0, and 3 and 4 are the only other
;; values `revision-of` produces.
(defn- receive-config [revision]
  (if (= revision 1)
    1090520842                          ; 0x4100070a
    (if (= revision 2)
      1090522122                        ; 0x41000c0a
      1092619274)))

;; RGE_MCUCMD 0xd3 = 211, RGE_FIFO_EMPTY 0x30 = 48. Returns 0 when the FIFO
;; reported empty and 4 (FIFO_TIMEOUT) when either bound ran out.
(defn- drain [mmio-base mmio-length deadline budget]
  (if (= 48 (bit-and (kernel-load-u8-4k mmio-base mmio-length 211) 48))
    0
    (if (<= budget 0)
      4
      (if (> (kernel-rdtsc) deadline)
        4
        (drain mmio-base mmio-length deadline (- budget 1))))))

;; rtl8125.c:169-179. RGE_CMD 0x37 = 55, RGE_CMD_STOP 0x80 = 128.
;;
;; The C sets its `device->ready = 0` on the timeout path; that field belongs to
;; the caller's struct and the reason code is what tells it to.
(defn- stop-and-drain [mmio-base mmio-length]
  (let [stop (kernel-store-u8-4k mmio-base mmio-length 55
                                 (bit-or (kernel-load-u8-4k mmio-base mmio-length 55)
                                         128))]
    (let [drained (drain mmio-base mmio-length
                         (+ (kernel-rdtsc) 2000000000)
                         300000)]
      (if (> drained 0)
        drained
        (let [clear (kernel-store-u8-4k mmio-base mmio-length 55 0)]
          0)))))

;; rtl8125.c:190-202, in the C's order. The order is the program: the interrupt
;; mask goes to zero before anything else so a half-installed ring cannot raise
;; one, the ring addresses are loaded while the engine is stopped, and RGE_CMD
;; is written LAST because that is the write that starts the hardware reading
;; the descriptors every preceding write described.
;;
;;   0x38 = 56  RGE_IMR        0            mask every interrupt
;;   0x3c = 60  RGE_ISR        0xffffffff   acknowledge everything pending
;;   0x20 = 32  RGE_TXDESC_LO  low 32 bits of the transmit ring
;;   0x24 = 36  RGE_TXDESC_HI  high 32 bits
;;   0xe4 = 228 RGE_RXDESC_LO  low 32 bits of the receive ring
;;   0xe8 = 232 RGE_RXDESC_HI  high 32 bits
;;   0xda = 218 RGE_RXMAXSIZE  2048 = AIUEOS_RTL8125_FRAME_CAPACITY (u16)
;;   0x40 = 64  RGE_TXCFG      0x03000700 = RGE_TXCFG_CONFIG
;;   0x44 = 68  RGE_RXCFG      revision word | individual | broadcast
;;   0x37 = 55  RGE_CMD        0x0c = RGE_CMD_TX | RGE_CMD_RX
;;
;; `quot` by 2^32 rather than a shift for the high halves: the address is
;; non-negative (`desc-ok`), so truncating and flooring agree, and this file
;; does not depend on the shift operators being admitted on every route.
;;
;; The leading store fence is not in the C at this point -- the C issues its
;; release fence at the end of the descriptor stores, which in this split
;; happened in a different object and a different call. Publishing again here
;; costs one instruction and makes the ordering a property of THIS object
;; rather than of the caller's sequencing.
(defn- program-registers [mmio-base mmio-length tx-phys rx-phys revision]
  (let [f (kernel-fence-store)]
    (let [imr (kernel-store-u32-4k mmio-base mmio-length 56 0)]
      (let [isr (kernel-store-u32-4k mmio-base mmio-length 60 4294967295)]
        (let [txlo (kernel-store-u32-4k mmio-base mmio-length 32
                                        (bit-and tx-phys 4294967295))]
          (let [txhi (kernel-store-u32-4k mmio-base mmio-length 36
                                          (quot tx-phys 4294967296))]
            (let [rxlo (kernel-store-u32-4k mmio-base mmio-length 228
                                            (bit-and rx-phys 4294967295))]
              (let [rxhi (kernel-store-u32-4k mmio-base mmio-length 232
                                              (quot rx-phys 4294967296))]
                (let [maxs (kernel-store-u16-4k mmio-base mmio-length 218 2048)]
                  (let [txcfg (kernel-store-u32-4k mmio-base mmio-length 64 50333440)]
                    (let [rxcfg (kernel-store-u32-4k mmio-base mmio-length 68
                                                     (receive-config revision))]
                      (let [cmd (kernel-store-u8-4k mmio-base mmio-length 55 12)]
                        0))))))))))))

(defn kotoba_aiueos_rtl8125_program [mmio-base mmio-length tx-phys rx-phys revision]
  (if (or (= 0 (mmio-ok mmio-base mmio-length))
          (< revision 0)
          (> revision 4))
    1
    (if (= revision 0)
      (stop-and-drain mmio-base mmio-length)
      ;; The descriptor addresses are checked only on the phase that uses them,
      ;; so the stop phase does not require a caller to have allocated rings it
      ;; is about to rebuild.
      (if (or (= 0 (desc-ok tx-phys))
              (= 0 (desc-ok rx-phys)))
        1
        (program-registers mmio-base mmio-length tx-phys rx-phys revision)))))
