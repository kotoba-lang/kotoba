(ns aiueos.sha256-stream
  (:require [aiueos.lib.sha256-stream :as sha])
  (:export [aiueos-sha256-stream main]))

;; The streaming SHA-256 entry for the freestanding aiueos kernel.
;;
;;   (aiueos-sha256-stream mode st st-len src src-len)
;;
;; ---------------------------------------------------------------------------
;; NOT A BOOLEAN. ZERO IS THE SUCCESS VALUE.
;; ---------------------------------------------------------------------------
;; The convention of its two neighbours, `aiueos-aes128-gcm` and
;; `aiueos-hkdf-sha256`, and NOT the `aiueos-qwen35-*` positive-length one:
;; this object's useful output is bytes in a region, so there is no length to
;; return and no value space to share with a reason.
;;
;;     0   done
;;     1   st-len below the 512 bytes the state region requires
;;     2   mode is none of 0, 1, 2
;;     3   mode 1 (block) with src-len other than exactly 64
;;     4   mode 2 (final) with src-len outside 0..63
;;
;; ---------------------------------------------------------------------------
;; THREE MODES
;; ---------------------------------------------------------------------------
;;   0  init   write the eight initial words and a zero length into `st`.
;;             `src` and `src-len` are not read.
;;   1  block  compress EXACTLY ONE 64-byte block from `src` into `st` and
;;             advance the length by 64. This is the hot path: a caller
;;             streaming a megabyte calls it 16,384 times and the state never
;;             leaves its own 512 bytes.
;;   2  final  pad the 0..63 bytes at `src`, append the bit length, compress
;;             the one or two blocks that produces, and write the 32 raw
;;             big-endian digest bytes to `st` at offset 424.
;;
;; The digest is RAW, not hex. Hex is a total injective encoding of it --
;; mechanism, in ADR-0015's sense -- and the C callers that need it already
;; own a hex writer for the model digest.
;;
;; ---------------------------------------------------------------------------
;; WHY THIS IS A SEPARATE OBJECT FROM `aiueos-sha256-region`
;; ---------------------------------------------------------------------------
;; A kernel object exports one symbol and cannot call another, so two objects
;; would mean two copies of the compression function -- except that both
;; import `aiueos.lib.sha256-stream`, which amu#742 made possible, so the
;; rounds exist once in source and the two `.o` files are two INSTANCES of it,
;; not two implementations.
;;
;; What is genuinely different is the FUEL. The prologue's replenish is a
;; per-CALL budget, so folding these two into one symbol would force a
;; single-block call -- the one a driver makes 16,384 times -- to carry the
;; budget a whole-megabyte call needs. That is not a cost (fuel is not
;; consumed by being granted), it is a loss of information: a runaway
;; single-block call would then be able to spend a megabyte's worth of steps
;; before the counter noticed. Two symbols keep the two bounds separate, which
;; is the same argument `elf64.cljc` makes for keeping `canonical` and `body`
;; on separate arms even where their constants agree.

(defn aiueos-sha256-stream [mode st st-len src src-len]
  (if (< st-len 512) 1
    (if (= mode 0) (* 0 (sha/sha-init st))
      (if (= mode 1)
        (if (= src-len 64)
          (* 0 (sha/sha-absorb st (kernel-subregion src src-len 0 64)))
          3)
        (if (= mode 2)
          (if (< src-len 0) 4
            (if (> src-len 63) 4
              (* 0 (sha/sha-final st src src-len))))
          2)))))

(defn main [] 0)
