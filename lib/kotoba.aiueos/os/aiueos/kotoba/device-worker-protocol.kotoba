;; kernel/device_worker_protocol.c in Kotoba (JUN-556).
;;
;; MARSHALLING ONLY, as the C was (ADR-0219): the parse of the murakumo poll response is
;; `device-worker-poll-response.kotoba`, which writes a 32-byte record; this export unpacks that record into the
;; caller's `struct aiueos_device_worker_poll` (40 bytes: u64 job_id@0, u64 control_id@8, u32 bos_token@16, then
;; the four `int` flags at 20, 24, 28, 32, and 4 bytes of padding that the C zeroed with the rest of the struct).
;;
;; Built by the Amu aiueos kernel object route (amu 3a4ecb5c8 + the D6 branch of ADR 0382): the 32-byte scratch
;; buffer the C kept on the stack is cells 0..3 (`cell-addr-0` is handed to the parse object through a D1 extern),
;; the struct is filled with D5 record stores, and the record's bytes 20..23 are the flags. Like the C: a null
;; `http` or `poll` returns 0, a parse that does not return 1 leaves `poll` untouched.
;;
;; EXECUTED, NOT BOOTED: scripts/apic-x86-smoke/ runs this object and the clang-built C under qemu-system-x86_64 (TCG)
;; against a 32-byte copy stub for the parse (9 hand-made records, including all-ones and a short input) and
;; compares the return value and all 40 bytes of the struct: identical; a wrong flag offset is caught.
;; Against the real parse object the contract's own vectors do NOT pass in that harness (the parse alone returns 1 for
;; 4 of the 13 vectors its contract expects 1 for) -- the C and this object agree on those rows too, but that
;; is an open question about the parse object or the harness, not evidence about this file.

(ns dwp (:export [aiueos_device_worker_poll_response]))
(defn- extern-kotoba_aiueos_device_worker_poll_response [h :i64 n :i64 out :i64] :i64 0)
(defn- cell-addr-0 [] :i64 0)
(defn- cell-load-0 [] :i64 0)
(defn- cell-load-1 [] :i64 0)
(defn- cell-load-2 [] :i64 0)
(defn- cell-load-3 [] :i64 0)
(defn- cell-store-0 [v :i64] :i64 0)
(defn- cell-store-1 [v :i64] :i64 0)
(defn- cell-store-2 [v :i64] :i64 0)
(defn- cell-store-3 [v :i64] :i64 0)
(defn- record-store-u64-0-40 [b :i64 v :i64] :i64 0)
(defn- record-store-u64-8-40 [b :i64 v :i64] :i64 0)
(defn- record-store-u32-16-40 [b :i64 v :i64] :i64 0)
(defn- record-store-u32-20-40 [b :i64 v :i64] :i64 0)
(defn- record-store-u32-24-40 [b :i64 v :i64] :i64 0)
(defn- record-store-u32-28-40 [b :i64 v :i64] :i64 0)
(defn- record-store-u32-32-40 [b :i64 v :i64] :i64 0)
(defn- record-store-u32-36-40 [b :i64 v :i64] :i64 0)
(defn- byte-of [w :i64 k :i64] :i64 (bit-and (u64-shift-right w (* 8 k)) 255))
(defn aiueos_device_worker_poll_response [http :i64 length :i64 poll :i64] :i64
  (if (= http 0) 0
    (if (= poll 0) 0
      (do (cell-store-0 0) (cell-store-1 0) (cell-store-2 0) (cell-store-3 0)
          (if (= (extern-kotoba_aiueos_device_worker_poll_response http length (cell-addr-0)) 1)
            (let [w2 (cell-load-2)]
              (do (record-store-u64-0-40 poll (cell-load-0))
                  (record-store-u64-8-40 poll (cell-load-1))
                  (record-store-u32-16-40 poll (bit-and w2 4294967295))
                  (record-store-u32-20-40 poll (byte-of w2 4))
                  (record-store-u32-24-40 poll (byte-of w2 5))
                  (record-store-u32-28-40 poll (byte-of w2 6))
                  (record-store-u32-32-40 poll (byte-of w2 7))
                  (record-store-u32-36-40 poll 0)
                  1))
            0)))))
