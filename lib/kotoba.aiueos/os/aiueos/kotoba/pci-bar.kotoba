;; The PCI BAR arithmetic of kernel/pci.c in Kotoba (JUN-598): read_bar's decode and bar_extent's type check and size,
;; over the configuration words the C reads (the reads, and bar_extent's sizing writes, stay C: they are the protocol).
;;
;; base(low, high, index): read_bar's base, or 0 when it refused -- index >= 6, an I/O BAR (bit 0), a type other than
;; 32-bit (0) or 64-bit (2), a 64-bit BAR at index 5, a base of 0 or 0xfffffff0. high is the next BAR word, used only for
;; a 64-bit BAR. kind(low, index): bar_extent's check before sizing -- 0 refused (index >= 6, an I/O BAR, another type,
;; a 64-bit BAR at index 5), 1 a 32-bit BAR, 2 a 64-bit one. value(low, high): (low & ~0xf) | high << 32 (high 0 for a
;; 32-bit BAR). size(mask-low, mask-high, kind): the extent the all-ones probe read back, (~mask) + 1 over 64 bits for a
;; 64-bit BAR, over 32 bits for a 32-bit one (0 when the mask is 0). Values are bit patterns (u64 as i64).
(ns aiueos.pci-bar (:export [kotoba_aiueos_pci_bar_base kotoba_aiueos_pci_bar_kind kotoba_aiueos_pci_bar_value
                             kotoba_aiueos_pci_bar_size]))
(defn- u32 [x :i64] :i64 (bit-and x 4294967295))
(defn- type-of [low :i64] :i64 (bit-and (u64-shift-right (u32 low) 1) 3))
(defn- kind [low :i64 index :i64] :i64
  (let [t (type-of low)]
    (cond (or (< index 0) (>= index 6)) 0
          (not= (bit-and low 1) 0) 0
          (= t 0) 1
          (and (= t 2) (not= index 5)) 2
          :else 0)))
(defn- value [low :i64 high :i64] :i64
  (bit-or (bit-and (u32 low) 4294967280) (i64-shift-left (u32 high) 32)))
;; an object may not call its own exports (the kernel hands their parameters in), so the exports wrap the helpers
(defn kotoba_aiueos_pci_bar_kind [low :i64 index :i64] :i64 (kind low index))
(defn kotoba_aiueos_pci_bar_value [low :i64 high :i64] :i64 (value low high))
(defn kotoba_aiueos_pci_bar_base [low :i64 high :i64 index :i64] :i64
  (let [k (kind low index)
        v (if (= k 2) (value low high) (bit-and (u32 low) 4294967280))]
    (if (or (= k 0) (= v 0) (= v 4294967280)) 0 v)))
(defn kotoba_aiueos_pci_bar_size [mask-low :i64 mask-high :i64 kind :i64] :i64
  (if (= kind 2)
    (+ (bit-not (value mask-low mask-high)) 1)
    (u32 (+ (bit-not (bit-and (u32 mask-low) 4294967280)) 1))))
