;; tokens * 10^12 / elapsed_ns, in milli-tokens per second -- the rate the
;; status screen and the serial report print.
;;
;; This object retires the arithmetic of `kernel/inference_status.c`'s
;; `aiueos_inference_milli_tokens_per_second` (ADR-0219). The C did it in one
;; unsigned multiply and one unsigned divide; the comment beside it, "token
;; bound above keeps tokens * 1e12 inside uint64_t", is true for C and FALSE
;; for a signed word: tokens in [9223373, 10000000] make the product exceed
;; INT64_MAX. So the product is taken as a 64-bit PATTERN (`*` wraps mod
;; 2^64, measured in the oracle) and the divide is an unsigned restoring
;; division written over signed words, one bit per step, with the unsigned
;; compare spelled as a signed compare after flipping bit 63.
;;
;; `elapsed` is the raw uint64_t nanoseconds as its bit pattern, so
;; AIUEOS_INFERENCE_UNMEASURED (UINT64_MAX) arrives as -1. The result is the
;; C's uint64_t as a bit pattern too: UNMEASURED is returned as -1 and the
;; caller reads it back as UINT64_MAX.
;;
;; Variable-count shifts are not in the subset (ADR-0212), so the division
;; shifts by ONE each step and walks the dividend's bits from the top by
;; shifting the dividend itself; 64 steps with the count carried as a runtime
;; value so fuel is charged per iteration, not statically unrolled.

(ns aiueos.inference-milli-tokens-per-second
  (:export [aiueos-inference-milli-tokens-per-second main]))

(defn top-bit [] (i64-shift-left 1 63))

(defn uge [a b]
  ;; unsigned a >= b over signed words
  (if (>= (bit-xor a (top-bit)) (bit-xor b (top-bit))) 1 0))

(defn udiv-step [n d q r steps]
  ;; restoring division: one dividend bit per step, taken from the top of n.
  ;; `r` never carries bit 63 before the shift: it is at most the top 63 bits
  ;; of n minus multiples of d, so `r2` cannot wrap and the textbook
  ;; "remainder overflowed, subtract anyway" branch is unreachable for a
  ;; 64-bit dividend -- measured absent (a version carrying it could not be
  ;; turned red by any vector) and so not written.
  (if (= steps 0)
    q
    (let [bit (if (< n 0) 1 0)
          n2 (i64-shift-left n 1)
          r2 (bit-or (i64-shift-left r 1) bit)
          take (uge r2 d)
          r3 (if (= take 1) (- r2 d) r2)
          q2 (bit-or (i64-shift-left q 1) take)]
      (udiv-step n2 d q2 r3 (- steps 1)))))

(defn udiv64 [n d steps] (udiv-step n d 0 0 steps))

(defn aiueos-inference-milli-tokens-per-second [tokens elapsed]
  (if (or (= tokens 0) (= elapsed 0) (= elapsed -1)
          (< tokens 0) (> tokens 10000000))
    -1
    ;; 64 steps, spelled from a runtime value so it is a loop and not an
    ;; unrolled literal (ADR-0212, "the fuel model is about static bounds").
    (udiv64 (* tokens 1000000000000) elapsed (+ 63 (quot tokens tokens)))))

(defn main [] 0)
