;; Whether the model the loader handed off is exactly the one this build
;; expects: identity, size, part count, format, paging aperture, admission
;; flags, digest and the GGUF v3 header at its first eight bytes.
;;
;; Retires the decision of `kernel/model_handoff.c`'s
;; `aiueos_model_handoff_validate` (ADR-0219). The C read the boot-info
;; struct through a pointer and the model's header through another; both
;; cross here as ONE flat record the C packs (mechanism, no comparison):
;;
;;   aiueos-model-handoff-record/v1, 192 bytes
;;     0  u8  boot pointer was non-null
;;     1  u8  header pointer was non-null
;;     8  u64 boot.magic
;;    16  u64 boot.version
;;    24  u64 boot.model_base
;;    32  u64 boot.model_size
;;    40  u32 boot.model_part_count
;;    44  u32 boot.model_format
;;    48  u64 boot.model_flags
;;    56  u64 boot.model_paging_base
;;    64  u64 boot.model_paging_pages
;;    72  u64 expected_size
;;    80  u32 expected_parts
;;    88  32 bytes boot.model_sha256
;;   120  32 bytes expected_sha256
;;   152  8 bytes header
;;   160  32 bytes scratch: the mapping plan is written here
;;
;; The magic 0x414955454f53424f is compared as two u32 halves rather than one
;; u64 literal: the KIR oracle host carries words as doubles, so a single
;; 64-bit compare could not tell the magic from the magic with bit 0 flipped
;; (measured: the `:magic-flipped` vector passed a u64 compare). Two 32-bit
;; halves are exact on every host; the flag bits and every version and size
;; bound are small.
;;
;; RETURNS 1 when admitted, else 0.

(ns aiueos.model-handoff-validate
  (:require [aiueos.model-mapping-plan :as plan])
  (:export [aiueos-model-handoff-validate main]))

(defn digests-differ [record i acc]
  (if (= i 32)
    acc
    (digests-differ record (+ i 1)
                    (+ acc (bit-xor (kernel-load-u8 record 192 (+ 88 i))
                                    (kernel-load-u8 record 192 (+ 120 i)))))))

(defn header-version [record]
  (+ (kernel-load-u8 record 192 156)
     (* 256 (kernel-load-u8 record 192 157))
     (* 65536 (kernel-load-u8 record 192 158))
     (* 16777216 (kernel-load-u8 record 192 159))))

(defn aiueos-model-handoff-validate [record length]
  (if (not (= length 192))
    0
    (let [boot (kernel-load-u8 record 192 0)
          header (kernel-load-u8 record 192 1)
          magic-lo (kernel-load-u32 record 192 8)
          magic-hi (kernel-load-u32 record 192 12)
          version (kernel-load-u64 record 192 16)
          model-base (kernel-load-u64 record 192 24)
          model-size (kernel-load-u64 record 192 32)
          parts (kernel-load-u32 record 192 40)
          format (kernel-load-u32 record 192 44)
          flags (kernel-load-u64 record 192 48)
          paging-base (kernel-load-u64 record 192 56)
          paging-pages (kernel-load-u64 record 192 64)
          expected-size (kernel-load-u64 record 192 72)
          expected-parts (kernel-load-u32 record 192 80)]
      (if (or (= boot 0)
              (not (= magic-lo 1330856527))     ; 0x4f53424f
              (not (= magic-hi 1095324997))     ; 0x41495545
              (< version 4) (< version 0)
              (= model-base 0)
              (not (= model-size expected-size))
              (not (= parts expected-parts))
              (not (= format 1))
              (= paging-base 0)
              (not (= (bit-and paging-base 4095) 0))
              (>= paging-base 1073741824) (< paging-base 0)
              (and (< version 5) (not (= paging-pages 16)))
              (not (= flags 3))
              (= header 0))
        0
        (if (= (plan/plan-verdict model-base model-size) 0)
          0
          (if (not (= (digests-differ record 0 0) 0))
            0
            (if (or (not (= (kernel-load-u8 record 192 152) 71))
                    (not (= (kernel-load-u8 record 192 153) 71))
                    (not (= (kernel-load-u8 record 192 154) 85))
                    (not (= (kernel-load-u8 record 192 155) 70)))
              0
              (if (= (header-version record) 3) 1 0))))))))

(defn main [] 0)
