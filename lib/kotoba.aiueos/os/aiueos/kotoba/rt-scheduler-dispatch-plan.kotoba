(ns aiueos.rt-scheduler-dispatch-plan)

;; RT task descriptor v1 (16 bytes, at most 16 descriptors):
;;   0 state: 0 unused, 1 READY, 2 RUNNING, 3 BLOCKED
;;   1 base priority: 1 is most urgent, 255 is least urgent
;;   2 effective priority after the priority-ceiling protocol
;;   3 same-priority policy: 0 FIFO, 1 round-robin
;;   4 remaining execution budget in ticks (zero is ineligible)
;;   5 remaining relative-deadline window in ticks (zero is ineligible)
;;   6 FIFO enqueue sequence (admission prevents wrap while tasks are queued)
;;   7..15 reserved and required to be zero by the descriptor validator.
;;
;; The interrupt entry/exit mechanism is outside this pure policy object.  It
;; calls this function on every release, wakeup and timer interrupt.  Therefore
;; a higher-priority READY task produces a switch recipe immediately rather
;; than waiting for the current task to yield.

(defn eligible-ready [table length slot]
  (let [base (* slot 16)
        task-state (kernel-load-u8 table length base)
        budget (kernel-load-u8 table length (+ base 4))
        deadline (kernel-load-u8 table length (+ base 5))]
    (and (= task-state 1) (> budget 0) (> deadline 0))))

(defn best-ready [table length count slot packed-best]
  (if (>= slot count) packed-best
    (if (eligible-ready table length slot)
      (let [base (* slot 16)
            priority (kernel-load-u8 table length (+ base 2))
            sequence (kernel-load-u8 table length (+ base 6))
            best (bit-and packed-best 255)
            best-priority (bit-and (quot packed-best 256) 255)
            best-sequence (bit-and (quot packed-best 65536) 255)
            better (or (= best 255)
                       (< priority best-priority)
                       (and (= priority best-priority)
                            (< sequence best-sequence)))]
        (if better
          (best-ready table length count (+ slot 1)
                      (+ slot (* priority 256) (* sequence 65536)))
          (best-ready table length count (+ slot 1) packed-best)))
      (best-ready table length count (+ slot 1) packed-best))))

(defn aiueos-scheduler-dispatch-plan [table length count stride state]
  (let [current (bit-and state 255)
        quantum-expired (bit-and (quot state 256) 1)]
    (if (not (and (= length 256) (= count 16) (= stride 16)
                  (< current count))) 0
      (let [packed-best (best-ready table length count 0 16777215)
            best (bit-and packed-best 255)
            current-base (* current 16)
            current-state (kernel-load-u8 table length current-base)
            current-priority (kernel-load-u8 table length (+ current-base 2))
            current-policy (kernel-load-u8 table length (+ current-base 3))
            current-budget (kernel-load-u8 table length (+ current-base 4))
            current-deadline (kernel-load-u8 table length (+ current-base 5))
            current-eligible (and (= current-state 2)
                                  (> current-budget 0)
                                  (> current-deadline 0))
            best-priority (if (= best 255) 255
                            (kernel-load-u8 table length (+ (* best 16) 2)))
            higher (and (not (= best 255)) current-eligible
                        (< best-priority current-priority))
            rotate (and (not (= best 255)) current-eligible
                        (= best-priority current-priority)
                        (= current-policy 1) (= quantum-expired 1))
            selected (if (or (not current-eligible) higher rotate) best current)
            switch-required (if (and (not (= selected 255))
                                     (not (= selected current))) 1 0)
            budget-exhausted (if (and (= current-state 2)
                                      (= current-budget 0)) 1 0)
            deadline-missed (if (and (= current-state 2)
                                     (= current-deadline 0)) 1 0)
            selected-priority (if (= selected 255) 255
                                (kernel-load-u8 table length
                                                (+ (* selected 16) 2)))]
        ;; Return recipe:
        ;; bits 0..7  selected slot + 1 (zero means no runnable task)
        ;; bit 8      context switch required
        ;; bit 9      higher-priority preemption
        ;; bit 10     same-priority round-robin rotation
        ;; bit 11     outgoing task exhausted its budget
        ;; bit 12     outgoing task missed its deadline window
        ;; bits 16..23 selected effective priority
        (if (= selected 255) 0
          (+ (+ selected 1)
             (* switch-required 256)
             (* (if higher 1 0) 512)
             (* (if rotate 1 0) 1024)
             (* budget-exhausted 2048)
             (* deadline-missed 4096)
             (* selected-priority 65536)))))))

(defn main [] 0)
