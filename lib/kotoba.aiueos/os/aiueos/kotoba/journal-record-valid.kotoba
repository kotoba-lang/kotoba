;; JUN-552: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form first, takes no test main and exports nothing else. It roots a window only in a base with its own
;; length, so the 28-byte header hash reads a kernel-subregion of that extent. The predicate is unchanged.
(ns aiueos.journal-record-valid (:export [kotoba_aiueos_journal_record_valid]))

(defn- read-u32 [base length index]
  (+ (kernel-load-u8 base length index)
     (* (kernel-load-u8 base length (+ index 1)) 256)
     (* (kernel-load-u8 base length (+ index 2)) 65536)
     (* (kernel-load-u8 base length (+ index 3)) 16777216)))

(defn- fnv-step [base length index hash]
  (if (= index length)
    hash
    (fnv-step base length (+ index 1)
      (* (bit-xor hash (kernel-load-u8 base length index)) 16777619))))

(defn- fnv [base length]
  (bit-and (fnv-step base length 0 2166136261) 4294967295))

(defn kotoba_aiueos_journal_record_valid [base length]
  (and (= length 64)
       (= (read-u32 base length 0) 1247103297)
       (= (read-u32 base length 4) 3296850)
       (= (read-u32 base length 8) 2)
       (> (read-u32 base length 12) 0)
       (= (read-u32 base length 16) 2)
       (= (read-u32 base length 20) 32)
       (= (fnv (kernel-subregion base length 0 28) 28) (read-u32 base length 28))
       (= (fnv (kernel-subregion base length 32 32) 32) (read-u32 base length 24))))

