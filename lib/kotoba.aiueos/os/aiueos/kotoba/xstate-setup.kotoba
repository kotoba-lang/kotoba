;; qwen35_infer.c's prepare_bsp_extended_state and cpu_has_avx2 in Kotoba (JUN-554), over amu ADR 0389 / 0390's CPU and
;; extended-state intrinsics (JUN-633).
;;
;; prepare(): when CPUID.1:ECX has XSAVE (26) and AVX (28), set CR4.OSFXSR / OSXMMEXCPT / OSXSAVE and OR SSE | AVX (0x6)
;;   into XCR0, as the C does; returns 1 when it did, 0 when the CPU lacks either (nothing is touched). The masks are
;;   literals inside ADR 0390's admitted sets, so the object can set no other CR4 / XCR0 bit and clear none.
;; has_avx2(): 1 when CPUID leaf 7 exists, CPUID.1:ECX has OSXSAVE (27) and AVX (28), XCR0 enables SSE and AVX, and
;;   CPUID.7.0:EBX has AVX2 (5); else 0 -- the C's checks in the C's order.
;;
;; Built by the Amu aiueos kernel object route at amu fe093270 (amu#1716, ADR 0390), fuel 4194304.
(ns aiueos.xstate-setup
  (:export [kotoba_aiueos_prepare_extended_state kotoba_aiueos_cpu_has_avx2]))
(defn- bit [v :i64 n :i64] :i64 (bit-and (u64-shift-right v n) 1))
(defn kotoba_aiueos_prepare_extended_state [] :i64
  (let [c (kernel-cpuid-ecx 1 0)]
    (if (or (= (bit c 26) 0) (= (bit c 28) 0)) 0
      (let [r (kernel-cr4-set-bits 263680) x (kernel-xcr0-set-bits 6)] (+ 1 (* 0 (+ r x)))))))
(defn kotoba_aiueos_cpu_has_avx2 [] :i64
  (if (< (kernel-cpuid-eax 0 0) 7) 0
    (let [c (kernel-cpuid-ecx 1 0)]
      (if (or (= (bit c 27) 0) (= (bit c 28) 0)) 0
        (if (not= (bit-and (kernel-xgetbv) 6) 6) 0
          (bit (kernel-cpuid-ebx 7 0) 5))))))
