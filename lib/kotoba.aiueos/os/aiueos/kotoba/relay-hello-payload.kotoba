;; JUN-708: built on amu's native object route: the namespace form comes first and exports the C name only, with no
;; test main and private helpers. The route has no string literals, so the three texts are byte accessors over 8-byte
;; words (str-0 .. str-2). The out window names the capacity (the export admits 91 and up; kernel/pci.c passes 160)
;; instead of the literal 160, and the export takes the MAC's length after the MAC (kernel/pci.c passes 6). The
;; payload is unchanged.
(ns aiueos.relay-hello-payload (:export [kotoba_aiueos_relay_hello_payload]))

;; The HELLO line a K16 sends the Mac relay, as bytes in the caller's buffer.
;;
;;   AIUEOS_NODE_HELLO_V1 boot=<16 hex> mac=<xx-xx-xx-xx-xx-xx> profile=rtl8125-relay-test
;;
;; 91 bytes, fixed width. This object retires `kernel/relay_protocol.c`'s
;; `aiueos_relay_hello_payload` (ADR-0213): the C wrote the same 91 bytes and
;; was the second implementation of a wire line the Kotoba side already owned
;; (`native/relay_line.kotoba` + `native/relay_text.kotoba`). Those two write
;; into a 4 KiB frame page from MMIO-read MAC registers; this one writes the
;; PAYLOAD ONLY into the small stack buffer `pci.c` hands it, from a six-byte
;; MAC the caller already holds -- the shape the retired C had, so the call
;; site changes by one symbol and two nonce halves.
;;
;; THE NONCE CROSSES AS TWO 32-BIT HALVES. Words are signed on this side
;; (`native/relay_line.kotoba` says why: a set bit 63 makes `quot` walk the
;; wrong way), and the boot nonce is a raw `rdtsc` whose top bit the C never
;; masked. Passing `hi` and `lo` separately keeps both operands below 2^32,
;; so `store-hex` over each is exact for every nonce the C could produce --
;; not only the ones that happen to fit in 60 bits.
;;
;; RETURNS the payload length, 91, or 0 when the caller's buffer cannot hold
;; it. 0 is the refusal the C returned and `rtl8125_build_relay_hello` still
;; reads: `if(!payload_length)return 0;`. The store bound is the literal 160,
;; `AIUEOS_RELAY_HELLO_CAPACITY`, the size of the one buffer the caller
;; declares; the highest index written is 90, so the bound is never reached
;; and a larger buffer is admitted exactly as the C admitted it. The capacity
;; check runs before the first store, so a short buffer is refused without a
;; byte written.
;;
;; EVERY STORE IS READ BACK, as `native/relay_line.kotoba` does: the store
;; returns its operand, so comparing the store's value to `value` would be a
;; tautology. The `(* 0 stored)` term keeps the store in the dependency graph
;; and lets the comparison see only the byte that landed.



;; 'AIUEOS_NODE_HELLO_V1 boot=' (26 bytes) as 4 little-endian words
(defn- str-0-word [w]
  (if (< w 2) (if (< w 1) 5647324057676630337 5497845422250869839) (if (< w 3) 8029744551031103311 15732)))
(defn- str-0 [i]
  (bit-and (u64-shift-right (str-0-word (u64-shift-right i 3)) (* 8 (bit-and i 7))) 255))

;; ' mac=' (5 bytes) as 1 little-endian words
(defn- str-1-word [w]
  263660334368)
(defn- str-1 [i]
  (bit-and (u64-shift-right (str-1-word (u64-shift-right i 3)) (* 8 (bit-and i 7))) 255))

;; ' profile=rtl8125-relay-test' (27 bytes) as 4 little-endian words
(defn- str-2-word [w]
  (if (< w 2) (if (< w 1) 7308332183992823840 3833180351253213757) (if (< w 3) 8371480741688996397 7631717)))
(defn- str-2 [i]
  (bit-and (u64-shift-right (str-2-word (u64-shift-right i 3)) (* 8 (bit-and i 7))) 255))

(defn- lit-length [kind]
  (if (= kind 0) 26
    (if (= kind 1) 5
      (if (= kind 2) 27 0))))

(defn- lit-char [kind index]
  (if (= kind 0) (str-0 index)
    (if (= kind 1) (str-1 index)
      (if (= kind 2) (str-2 index) 0))))

(defn- hex-char [value]
  ;; lowercase: the relay's regexes are [0-9a-f], not [0-9a-fA-F].
  (if (< value 10) (+ 48 value) (+ 87 value)))

(defn- store-byte [out capacity at value]
  (let [stored (kernel-store-u8 out capacity at value)]
    (if (= (+ (kernel-load-u8 out capacity at) (* 0 stored)) value) 1 0)))

(defn- store-lit [out capacity at kind index]
  ;; Literal `kind` from character `index` on. Returns 1 when every byte
  ;; landed and read back, else 0.
  (if (>= index (lit-length kind))
    1
    (if (= (store-byte out capacity (+ at index) (lit-char kind index)) 1)
      (store-lit out capacity at kind (+ index 1))
      0)))

(defn- store-hex [out capacity at value digits]
  ;; `digits` lowercase hex characters, right-aligned: the least significant
  ;; nibble lands at at+digits-1. `value` must be non-negative -- the caller
  ;; guarantees it by passing 32-bit halves.
  (if (= digits 0)
    1
    (if (= (store-byte out capacity (+ at (- digits 1)) (hex-char (bit-and value 15))) 1)
      (store-hex out capacity at (quot value 16) (- digits 1))
      0)))

(defn- store-mac [out capacity mac mac-length index]
  ;; Six octets as xx-xx-xx-xx-xx-xx, 17 bytes; a '-' before every octet but
  ;; the first, so the run ends on a hex digit exactly as the C's append_mac.
  (if (= index 6)
    1
    (let [octet (kernel-load-u8 mac mac-length index)
          base (+ 47 (* index 3))]
      (if (and (or (= index 0) (= (store-byte out capacity (- base 1) 45) 1))
               (= (store-byte out capacity base (hex-char (quot octet 16))) 1)
               (= (store-byte out capacity (+ base 1) (hex-char (bit-and octet 15))) 1))
        (store-mac out capacity mac mac-length (+ index 1))
        0))))

(defn kotoba_aiueos_relay_hello_payload [out capacity nonce-hi nonce-lo mac mac-length]
  ;; Layout: 0..25 banner, 26..41 nonce, 42..46 " mac=", 47..63 MAC,
  ;; 64..90 profile. 91 bytes.
  (if (or (< capacity 91)
          (< nonce-hi 0) (> nonce-hi 4294967295)
          (< nonce-lo 0) (> nonce-lo 4294967295))
    0
    (if (and (= (store-lit out capacity 0 0 0) 1)
             (= (store-hex out capacity 26 nonce-hi 8) 1)
             (= (store-hex out capacity 34 nonce-lo 8) 1)
             (= (store-lit out capacity 42 1 0) 1)
             (= (store-mac out capacity mac mac-length 0) 1)
             (= (store-lit out capacity 64 2 0) 1))
      91
      0)))
