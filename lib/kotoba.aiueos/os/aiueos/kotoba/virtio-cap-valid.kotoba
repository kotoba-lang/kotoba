;; JUN-600: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form and takes no test main; the predicate is unchanged.
(ns aiueos.virtio-cap-valid (:export [kotoba_aiueos_virtio_cap_valid]))

(defn kotoba_aiueos_virtio_cap_valid [pointer cap-length bar offset length]
  (and (>= pointer 64)
       (<= pointer 252)
       (>= cap-length 16)
       (<= cap-length (- 256 pointer))
       (< bar 6)
       (> length 0)
       (<= length (- 4294967295 offset))))

