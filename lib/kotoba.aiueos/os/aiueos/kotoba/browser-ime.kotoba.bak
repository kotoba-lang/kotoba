    (if (= k 45) 821821440
    (if (= k 46) 805437440
    (if (= k 97) 809631744
    (if (= k 101) 810024960
    (if (= k 105) 809762816
    (if (= k 111) 810156032
    (if (= k 117) 809893888
    0)))))))))

