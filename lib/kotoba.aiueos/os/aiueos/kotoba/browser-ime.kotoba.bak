;; END GENERATED MORA

;; --- keys -------------------------------------------------------------------

(defn letter-of [code]
  ;; Linux evdev key codes, US layout, lower case. 0 for everything else.
  (if (= code 30) 97 (if (= code 48) 98 (if (= code 46) 99 (if (= code 32) 100
  (if (= code 18) 101 (if (= code 33) 102 (if (= code 34) 103 (if (= code 35) 104
  (if (= code 23) 105 (if (= code 36) 106 (if (= code 37) 107 (if (= code 38) 108
  (if (= code 50) 109 (if (= code 49) 110 (if (= code 24) 111 (if (= code 25) 112
  (if (= code 16) 113 (if (= code 19) 114 (if (= code 31) 115 (if (= code 20) 116
  (if (= code 22) 117 (if (= code 47) 118 (if (= code 17) 119 (if (= code 45) 120
  (if (= code 21) 121 (if (= code 44) 122 0)))))))))))))))))))))))))))

;; --- the focused window's body -----------------------------------------------

(defn body-base [s]
  (+ 160 (* 64 (- (w s 2) 1))))

(defn body-len [s base i]
  (if (>= i 64) 64
    (if (= (w s (+ base i)) 0) i
      (body-len s base (+ i 1)))))

(defn copy-preedit [s base at i n]
  (if (>= i n) 0
    (do (wp s (+ base (+ at i)) (w s (+ 446 i)))
        (copy-preedit s base at (+ i 1) n))))

(defn clear-state [s]
  (do (wp s 433 0) (wp s 445 0) (wp s 442 0) (wp s 443 0) (wp s 444 0) 0))

(defn commit [s]
  ;; The preedit onto the end of the focused body, whole or not at all.
  (let [base (body-base s)
        at (body-len s base 0)
        n (w s 445)]
    (if (> (+ at n) 64) -5
      (do (copy-preedit s base at 0 n)
          (clear-state s)
          n))))

;; --- preedit and romaji buffers ----------------------------------------------

(defn pre-push [s cp]
  (let [n (w s 445)]
    (if (>= n 32) (do (wp s 478 1) 0)
      (do (wp s (+ 446 n) cp) (wp s 445 (+ n 1)) 0))))

(defn emit-kana [s r]
  (do (pre-push s (quot r 65536))
      (if (> (bit-and r 65535) 0) (pre-push s (bit-and r 65535)) 0)))

(defn sokuon-letter [c]
  (if (= c 107) 1 (if (= c 115) 1 (if (= c 116) 1 (if (= c 112) 1 (if (= c 99) 1
  (if (= c 103) 1 (if (= c 122) 1 (if (= c 100) 1 (if (= c 98) 1 (if (= c 106) 1 0)))))))))))

(defn b-at [s i] (w s (+ 434 i)))

(defn sokuon-at [s p n]
  (if (< n 2) 0
    (if (not (= (b-at s p) (b-at s (+ p 1)))) 0
      (sokuon-letter (b-at s p)))))

(defn compact [s p i n]
  ;; Move buffer bytes p.. down to 0.., n of them.
  (if (>= i n) (wp s 433 n)
    (do (wp s (+ 434 i) (b-at s (+ p i)))
        (compact s p (+ i 1) n))))

(defn convert-buf [s p]
  (let [n (- (w s 433) p)]
    (if (= n 0) (wp s 433 0)
      (if (= (sokuon-at s p n) 1)
        (do (pre-push s 12387) (convert-buf s (+ p 1)))
        (let [r3 (if (>= n 3)
                   (mora3 (+ (* (b-at s p) 65536) (* (b-at s (+ p 1)) 256) (b-at s (+ p 2))))
                   0)]
          (if (> r3 0) (do (emit-kana s r3) (convert-buf s (+ p 3)))
            (let [r2 (if (>= n 2) (mora2 (+ (* (b-at s p) 256) (b-at s (+ p 1)))) 0)]
              (if (> r2 0) (do (emit-kana s r2) (convert-buf s (+ p 2)))
                (let [r1 (mora1 (b-at s p))]
                  (if (> r1 0) (do (emit-kana s r1) (convert-buf s (+ p 1)))
                    (compact s p 0 n)))))))))))

(defn push-leftover [s i n]
  (if (>= i n) 0
    (do (pre-push s (b-at s i)) (push-leftover s (+ i 1) n))))

(defn flush-preedit [s]
  ;; A lone "n" is "nn"; convert; whatever is left goes in as latin.
  (do (if (= (w s 433) 1)
        (if (= (b-at s 0) 110) (do (wp s 435 110) (wp s 433 2)) 0)
        0)
      (convert-buf s 0)
      (push-leftover s 0 (w s 433))
      (wp s 433 0)))

;; --- the dictionary -----------------------------------------------------------

(defn dw [s d i]
  (kernel-load-u32 (kernel-subregion d (w s 479) (* i 4) 4) 4 0))

(defn dict-there [s d]
  (if (= d 0) 0 (if (= (w s 479) 0) 0 1)))

(defn dict-ok [s d]
  ;; the aiueos-dict/v1 header: magic "AIUD", version 1, N index words
  ;; inside W, W words inside the bytes handed in
  (if (< (w s 479) 16) 0
    (if (not (= (dw s d 0) 1146440001)) 0
      (if (not (= (dw s d 1) 1)) 0
        (if (> (* (dw s d 3) 4) (w s 479)) 0
          (if (> (+ 4 (dw s d 2)) (dw s d 3)) 0 1))))))

(defn rec-ok [s d o]
  ;; record o: L (1..32) reading code points, C (>= 1) candidates, all
  ;; inside W
  (if (= (dict-there s d) 0) 0
    (if (>= (+ o 1) (dw s d 3)) 0
      (if (< (dw s d o) 1) 0
        (if (> (dw s d o) 32) 0
          (if (> (+ (+ o 2) (dw s d o)) (dw s d 3)) 0
            (if (< (dw s d (+ (+ o 1) (dw s d o))) 1) 0
              (if (> (+ (+ (+ o 2) (dw s d o)) (dw s d (+ (+ o 1) (dw s d o)))) (dw s d 3)) 0
                1))))))))

(defn rec-cmp [s d o i]
  ;; record o's reading against the preedit, from code point i: <0 the
  ;; record sorts first, 0 equal, >0 the preedit sorts first
  (if (>= i (dw s d o)) (if (>= i (w s 445)) 0 -1)
    (if (>= i (w s 445)) 1
      (if (< (dw s d (+ (+ o 1) i)) (w s (+ 446 i))) -1
        (if (> (dw s d (+ (+ o 1) i)) (w s (+ 446 i))) 1
          (rec-cmp s d o (+ i 1)))))))

(defn search [s d lo hi]
  ;; the record whose reading is the preedit: its word offset, 0 none,
  ;; -1 a record out of bounds
  (if (>= lo hi) 0
    (let [mid (quot (+ lo hi) 2)
          o (dw s d (+ 4 mid))]
      (if (= (rec-ok s d o) 0) -1
        (let [c (rec-cmp s d o 0)]
          (if (= c 0) o
            (if (< c 0) (search s d (+ mid 1) hi)
              (search s d lo mid))))))))

(defn lookup [s d]
  (if (= (dict-there s d) 0) 0
    (if (= (w s 445) 0) 0
      (search s d 0 (dw s d 2)))))

(defn cand-count [s d o]
  (dw s d (+ (+ o 1) (dw s d o))))

(defn cand-at [s d o i]
  (dw s d (+ (+ (+ o 2) (dw s d o)) i)))

(defn set-preedit-one [s cp]
  (do (wp s 446 cp) (wp s 445 1) 0))

(defn put-reading [s d o i]
  ;; the record's reading back into the preedit
  (if (>= i (dw s d o)) (wp s 445 i)
    (do (wp s (+ 446 i) (dw s d (+ (+ o 1) i)))
        (put-reading s d o (+ i 1)))))

;; --- keys ---------------------------------------------------------------------

(defn cycle [s d o]
  (if (= (rec-ok s d o) 0) -6
    (let [n (cand-count s d o)
          idx (- (+ (w s 443) 1) (* n (quot (+ (w s 443) 1) n)))]
      (do (wp s 443 idx) (set-preedit-one s (cand-at s d o idx))))))

(defn on-space [s d]
  (if (= (w s 442) 1) (cycle s d (w s 444))
    (do (flush-preedit s)
        (let [o (lookup s d)]
          (if (< o 0) -6
            (if (> o 0)
              (do (wp s 442 1) (wp s 444 o) (wp s 443 0)
                  (set-preedit-one s (cand-at s d o 0)))
              (commit s)))))))

(defn on-enter [s]
  (do (if (= (w s 442) 0) (flush-preedit s) 0)
      (commit s)))

(defn cancel [s d]
  (if (= (w s 442) 1)
    (if (= (rec-ok s d (w s 444)) 0) -6
      (do (put-reading s d (w s 444) 0)
          (wp s 442 0) (wp s 443 0) (wp s 444 0) 0))
    (do (wp s 433 0) (wp s 445 0) 0)))

;; --- the selection (ADR-0240) --------------------------------------------------

(defn sel-len [s]
  ;; the focused body's selection, clamped to the body as normalize-selection
  ;; clamps it; 0 when there is none or it is another window's
  (if (= (w s 2036) (w s 2))
    (let [n (body-len s (body-base s) 0)]
      (if (> (w s 2037) n) n (w s 2037)))
    0))

(defn set-sel [s k]
  (if (= k 0) (do (wp s 2036 0) (wp s 2037 0) 0)
    (do (wp s 2036 (w s 2)) (wp s 2037 k) 0)))

(defn clear-from [s base i n]
  (if (>= i n) 0
    (do (wp s (+ base i) 0) (clear-from s base (+ i 1) n))))

(defn drop-selection [s]
  ;; insert-text "" over [n - k, n): the selected code points go, the caret
  ;; is at the end of the body again
  (let [base (body-base s)
        n (body-len s base 0)]
    (do (clear-from s base (- n (sel-len s)) n)
        (set-sel s 0))))

(defn replace-selection [s]
  (if (> (sel-len s) 0) (drop-selection s) 0))

(defn composing [s]
  (if (> (w s 433) 0) 1 (if (> (w s 445) 0) 1 (if (= (w s 442) 1) 1 0))))

(defn extend-left [s]
  ;; move-caret -1 :extend? -- one more code point before the end selected,
  ;; none past the start of the body
  (let [k (sel-len s)]
    (if (< k (body-len s (body-base s) 0)) (set-sel s (+ k 1)) 0)))

(defn extend-right [s]
  ;; move-caret +1 :extend? -- the caret back toward the anchor at the end
  (let [k (sel-len s)]
    (if (> k 0) (set-sel s (- k 1)) 0)))

(defn shift-arrow [s left]
  (if (= (w s 2035) 0) 0
    (if (= (composing s) 1) 0
      (if (= left 1) (extend-left s) (extend-right s)))))

(defn delete-backward [s]
  ;; browser.text-edit delete-backward. With a selection (ADR-0240) the
  ;; selection goes. Without one the caret is at the end of the body (where
  ;; insert-text leaves it): the last code point goes. Bodies hold code
  ;; points, so there is no surrogate pair to keep whole.
  (if (> (sel-len s) 0) (drop-selection s)
    (let [base (body-base s)
          at (body-len s base 0)]
      (if (> at 0) (do (wp s (+ base (- at 1)) 0) 0) 0))))

(defn on-backspace [s d]
  (if (= (w s 442) 1) (cancel s d)
    (if (> (w s 433) 0) (do (wp s 433 (- (w s 433) 1)) 0)
      (if (> (w s 445) 0) (do (wp s 445 (- (w s 445) 1)) 0)
        (delete-backward s)))))

(defn on-letter [s c]
  (if (>= (w s 433) 8) -8
    (do (replace-selection s)
        (wp s (+ 434 (w s 433)) c)
        (wp s 433 (+ (w s 433) 1))
        (convert-buf s 0)
        0)))

(defn put-latin [s c]
  (let [base (body-base s)
        at (body-len s base 0)]
    (if (>= at 64) -5
      (do (wp s (+ base at) c) 1))))

(defn off-letter [s c]
  (do (replace-selection s)
      (put-latin s c)))

;; --- the clipboard (ADR-0241) --------------------------------------------------

(defn cw [d i]
  (kernel-load-u32 (kernel-subregion d 260 (* i 4) 4) 4 0))

(defn cwp [d i v]
  (kernel-store-u32 (kernel-subregion d 260 (* i 4) 4) 4 0 v))

(defn ctrl-key [s code]
  ;; with Ctrl held: C over a selection asks to write the clipboard, V asks
  ;; to read it; nothing while composing, and no other shortcut
  (if (= (composing s) 1) 0
    (if (= code 46) (if (> (sel-len s) 0) 512 0)
      (if (= code 47) 513 0))))

(defn copy-out [s d from i k]
  ;; from: the surface word of the first selected code point
  (if (>= i k) (do (cwp d 0 k) k)
    (do (cwp d (+ i 1) (w s (+ from i)))
        (copy-out s d from (+ i 1) k))))

(defn copy-sel [s d]
  ;; the selection's text into the clipboard: the last k code points
  (let [k (sel-len s)
        base (body-base s)]
    (if (= k 0) 0
      (copy-out s d (+ base (- (body-len s base 0) k)) 0 k))))

(defn paste-in [s d to i n]
  ;; to: the surface word the first pasted code point goes to
  (if (>= i n) n
    (do (wp s (+ to i) (cw d (+ i 1)))
        (paste-in s d to (+ i 1) n))))

(defn paste [s d]
  ;; insert-text of the clipboard's text: the selection goes, the text is
  ;; appended at the caret (the end of the body), whole or not at all
  (let [n (cw d 0)
        base (body-base s)
        k (sel-len s)
        at (body-len s base 0)]
    (if (= n 0) 0
      (if (> (+ (- at k) n) 64) -5
        (do (replace-selection s)
            (paste-in s d (+ base (- at k)) 0 n))))))

(defn complete [s d db code]
  ;; an admitted request's completion; the clipboard in place of the
  ;; dictionary
  (if (= d 0) -7
    (if (not (= db 260)) -7
      (if (> (cw d 0) 64) -7
        (if (= (composing s) 1) 0
          (if (= code 46) (copy-sel s d)
            (if (= code 47) (paste s d) 0)))))))

(defn toggle [s]
  (do (wp s 432 (if (= (w s 432) 0) 1 0))
      (clear-state s)))

(defn key [s d code]
  (let [c (letter-of code)]
    (if (= code 41) (toggle s)
    (if (= code 105) (shift-arrow s 1)
    (if (= code 106) (shift-arrow s 0)
    (if (= (w s 432) 0)
      (if (> c 0) (off-letter s c)
        (if (= code 14) (delete-backward s) 0))
      (if (> c 0) (on-letter s c)
        (if (= code 57) (on-space s d)
          (if (= code 28) (on-enter s)
            (if (= code 14) (on-backspace s d)
              (if (= code 1) (cancel s d) 0)))))))))))

;; --- admission ----------------------------------------------------------------

(defn has-id [s n k id]
  (if (>= k n) 0
    (if (= (w s (+ 5 (* k 5))) id) 1
      (has-id s n (+ k 1) id))))

(defn hold-alt [s value]
  (do (if (= value 1) (wp s 431 1) (if (= value 0) (wp s 431 0) 0))
      0))

(defn hold-shift [s value]
  (do (if (= value 1) (wp s 2035 1) (if (= value 0) (wp s 2035 0) 0))
      0))

(defn hold-ctrl [s value]
  (do (if (= value 1) (wp s 2038 1) (if (= value 0) (wp s 2038 0) 0))
      0))

(defn ctrl-code [code]
  (if (= code 29) 1 (if (= code 97) 1 0)))

(defn shift-code [code]
  (if (= code 42) 1 (if (= code 54) 1 0)))

;; ADR-0254: Alt+Tab raises the bottom-most window that is not minimized (word 31 bits 4..7).
(defn mbit [id]
  (if (= id 1) 16 (if (= id 2) 32 (if (= id 3) 64 (if (= id 4) 128 0))))) 

(defn first-vis [s n k]
  (if (>= k n) (w s 5)
    (let [id (w s (+ 5 (* k 5)))]
      (if (= (bit-and (w s 31) (mbit id)) 0) id (first-vis s n (+ k 1))))))

(defn wm-key [s code]
  (if (= code 15) (if (= (w s 431) 1) 1 0) 0))

;; ADR-0247: F10 (evdev 68) flips the high-contrast palette, word 2039,
;; browser-frame2.kotoba's. It is no text and no window action: the answer is 0.
;; ADR-0248: the keyboard focus ring and keyboard activation. Word 2032 is the
;; ring (browser-frame2.kotoba draws it): 0 none, 1..4 launcher button k when
;; app k is registered, 5 the focused window's close control when the window is
;; at least 40 wide and there is an app register. F6 moves it forward through
;; the targets that exist and then off; Shift+F6 backward. Enter or Space on a
;; ring target, and Escape for the focused window's close control, do what a
;; pointer press at the control's centre does -- the answer is that press,
;; 65536 + 2048 x + y, for C to hand to browser-reduce as a pointer/down, so
;; the keyboard and the pointer are one action path. Enter and Space with a
;; composition are the input method's, as before.
(defn kbit [k] (if (= k 1) 1 (if (= k 2) 2 (if (= k 3) 4 8))))

(defn idx [s n k id]
  (if (>= k n) -1
    (if (= (w s (+ 5 (* k 5))) id) k
      (idx s n (+ k 1) id))))

(defn close-ok [s]
  (if (= (w s 31) 0) 0
    (let [i (idx s (w s 1) 0 (w s 2))]
      (if (< i 0) 0
        (if (< (w s (+ 8 (* i 5))) 40) 0 1)))))

(defn target-ok [s t]
  (if (< t 1) 0
    (if (< t 5)
      (if (= (bit-and (w s 31) (kbit t)) 0) 0 1)
      (if (= t 5) (close-ok s) 0))))

(defn next-from [s t]
  (if (> t 5) 0
    (if (= (target-ok s t) 1) t
      (next-from s (+ t 1)))))

(defn prev-from [s t]
  (if (< t 1) 0
    (if (= (target-ok s t) 1) t
      (prev-from s (- t 1)))))

(defn ring-move [s]
  (do (wp s 2032
          (if (= (w s 2035) 1)
            (prev-from s (if (= (w s 2032) 0) 5 (- (w s 2032) 1)))
            (next-from s (+ (w s 2032) 1))))
      0))

(defn press-at [px py] (+ 65536 (+ (* px 2048) py)))

(defn close-press [s]
  (let [i (idx s (w s 1) 0 (w s 2))
        b (+ 5 (* i 5))]
    (press-at (- (+ (w s (+ b 1)) (w s (+ b 3))) 16) (+ (w s (+ b 2)) 14))))

(defn ring-press [s]
  (let [t (w s 2032)]
    (if (= (target-ok s t) 0) 0
      (if (= t 5) (close-press s)
        (press-at (+ 54 (* 102 (- t 1))) 14)))))

(defn hc-toggle [s]
  (do (wp s 2039 (if (= (w s 2039) 0) 1 0))
      0))

(defn max-key-ok [s]
  (if (= (w s 31) 0) 0
    (let [i (idx s (w s 1) 0 (w s 2))]
      (if (< i 0) 0
        (if (< (w s (+ 8 (* i 5))) 160) 0 1)))))

;; ADR-0251: F11 (evdev 87) presses the focused window's maximize control, as a
;; pointer press at its centre (x + w - 36, y + 14), through browser-reduce.
(defn max-key-press [s]
  (let [i (idx s (w s 1) 0 (w s 2))
        b (+ 5 (* i 5))]
    (press-at (- (+ (w s (+ b 1)) (w s (+ b 3))) 36) (+ (w s (+ b 2)) 14))))

;; ADR-0256: Alt+- (evdev 12) presses the focused window's minimize control as a pointer press at
;; its centre (x + w - 56, y + 14) through browser-reduce, when the control exists: a window at
;; least 200 wide with a launcher while two or more windows are visible.
(defn vis-n [s n k]
  (if (>= k n) 0
    (+ (if (= (bit-and (w s 31) (mbit (w s (+ 5 (* k 5))))) 0) 1 0)
       (vis-n s n (+ k 1)))))

(defn min-key-ok [s]
  (if (= (w s 431) 0) 0
    (if (= (w s 31) 0) 0
      (let [i (idx s (w s 1) 0 (w s 2))]
        (if (< i 0) 0
          (if (< (w s (+ 8 (* i 5))) 200) 0
            (if (< (vis-n s (w s 1) 0) 2) 0 1)))))))

(defn min-key-press [s]
  (let [i (idx s (w s 1) 0 (w s 2))
        b (+ 5 (* i 5))]
    (press-at (- (+ (w s (+ b 1)) (w s (+ b 3))) 56) (+ (w s (+ b 2)) 14))))

(defn kbd-act [s code]
  (if (= (composing s) 1) 0
    (if (= code 28) (if (= (target-ok s (w s 2032)) 1) 1 0)
      (if (= code 57) (if (= (target-ok s (w s 2032)) 1) 1 0)
        (if (= code 1) (close-ok s) 0)))))

(defn kbd-answer [s code]
  (if (= code 1) (close-press s) (ring-press s)))

;; ADR-0258: the screen lock. Ctrl+Alt+L (evdev 38) sets word 2030; while it is 1 the only keys
;; taken are the PIN's: digits (evdev 2..11) fill word 2031 (7 bits: count in bits 0..2, the number in
;; the rest), Backspace takes one back, Enter with four digits answers 1000000 + the number for C to
;; check against the PIN's hash and send back as a verdict event (value 2, code 1 accepted, 2 refused).
;; Everything else, the shell actions and typing included, is swallowed. Word 2026 is 1 after a refusal
;; until the next digit.
(defn lock-chord [s code]
  (if (= code 38) (if (= (w s 2038) 1) (if (= (w s 431) 1) 1 0) 0) 0))

(defn lock-now [s]
  (do (wp s 2030 1) (wp s 2031 0) (wp s 2026 0) (wp s 2032 0)
      (wp s 25 0) (wp s 26 0) (wp s 27 0) (wp s 28 0) (wp s 29 0) (wp s 30 0)
      (clear-state s)
      0))

(defn pin-digit [code]
  (if (< code 2) -1 (if (> code 11) -1 (if (= code 11) 0 (- code 1)))))

(defn pin-count [s] (bit-and (w s 2031) 7))

(defn pin-add [s dg]
  (if (< (pin-count s) 4)
    (do (wp s 2031 (+ (* (+ (* (quot (w s 2031) 8) 10) dg) 8) (+ (pin-count s) 1)))
        (wp s 2026 0)
        0)
    0))

(defn pin-back [s]
  (if (= (pin-count s) 0) 0
    (do (wp s 2031 (+ (* (quot (quot (w s 2031) 8) 10) 8) (- (pin-count s) 1)))
        0)))

(defn locked-key [s code]
  (if (> (pin-digit code) -1) (pin-add s (pin-digit code))
    (if (= code 14) (pin-back s)
      (if (= code 28) (if (= (pin-count s) 4) (+ 1000000 (quot (w s 2031) 8)) 0) 0))))

(defn verdict [s code]
  (if (= (w s 2030) 0) 0
    (do (wp s 2031 0)
        (if (= code 1) (do (wp s 2030 0) (wp s 2026 0)) (wp s 2026 1))
        0)))

(defn press [s d ev]
  (if (= (bit-and ev 3) 2) (verdict s (quot ev 4))
  (if (= (quot ev 4) 56) (hold-alt s (bit-and ev 3))
    (if (= (shift-code (quot ev 4)) 1) (hold-shift s (bit-and ev 3))
    (if (= (ctrl-code (quot ev 4)) 1) (hold-ctrl s (bit-and ev 3))
    (if (not (= (bit-and ev 3) 1)) 0
      (if (= (w s 2030) 1) (locked-key s (quot ev 4))
      (if (= (lock-chord s (quot ev 4)) 1) (lock-now s)
      (if (= (quot ev 4) 68) (hc-toggle s)
      (if (= (quot ev 4) 64) (ring-move s)
      (if (= (quot ev 4) 87) (if (= (max-key-ok s) 1) (max-key-press s) 0)
      (if (= (if (= (quot ev 4) 12) (min-key-ok s) 0) 1) (min-key-press s)
      (if (= (kbd-act s (quot ev 4)) 1) (kbd-answer s (quot ev 4))
      (if (= (wm-key s (quot ev 4)) 1) (+ 256 (first-vis s (w s 1) 0))
        (if (= (w s 2038) 1) (ctrl-key s (quot ev 4))
          (do (wp s 478 0)
              (let [r (key s d (quot ev 4))]
                (if (= (w s 478) 1) -8 r))))))))))))))))))

(defn admitted [s d ev]
  ;; after the surface checks: a dictionary that is there must be
  ;; aiueos-dict/v1 before any key is taken
  (if (= (dict-there s d) 1)
    (if (= (dict-ok s d) 0) -6 (press s d ev))
    (press s d ev)))

(defn aiueos-browser-key [s sb d db ev]
  (if (= s 0) -1
    (if (not (= sb 8192)) -1
      (if (not (= (w s 0) 1)) -2
        (if (< (w s 1) 1) -2
          (if (> (w s 1) 4) -2
            (if (< (w s 2) 1) -3
              (if (> (w s 2) 4) -3
                (if (= (has-id s (w s 1) 0 (w s 2)) 0) -3
                  (if (= (bit-and ev 3) 3) (complete s d db (quot ev 4))
                    (do (wp s 479 (if (= d 0) 0 db))
                        (admitted s d ev))))))))))))

(defn main [] 0)
