;; JUN-552: built on amu's native object route, which names the export by its source name (the C symbol), wants the
;; namespace form first, takes no test main and exports nothing else. The object table's hash is taken in place (see
;; fnv-object). The predicate is unchanged.
(ns aiueos.superblock-valid (:export [kotoba_aiueos_superblock_valid]))

(defn- read-u32 [base length index]
  (+ (kernel-load-u8 base length index)
     (* (kernel-load-u8 base length (+ index 1)) 256)
     (* (kernel-load-u8 base length (+ index 2)) 65536)
     (* (kernel-load-u8 base length (+ index 3)) 16777216)))

(defn- fnv-span [base length index end hash]
  (if (= index end) hash
    (fnv-span base length (+ index 1) end
      (* (bit-xor hash (kernel-load-u8 base length index)) 16777619))))

;; JUN-552: the native route roots a window only in a parameter with its own length or in a subregion whose extent is
;; a literal or a parameter, never one read from the block, so the object payload's FNV-1a walks [object-offset,
;; object-offset + object-length) of the superblock itself instead of a subregion of that extent. Same bytes, same
;; order, and the guards above it still hold the span inside the 512-byte block.
(defn- fnv-object [base length start count]
  (bit-and (fnv-span base length start (+ start count) 2166136261) 4294967295))

(defn kotoba_aiueos_superblock_valid [base length]
  (let [object-offset (read-u32 base length 24)
        object-length (read-u32 base length 28)]
    (and (= length 512)
         (= (read-u32 base length 0) 1163217217)
         (= (read-u32 base length 4) 3232582)
         (= (read-u32 base length 8) 3)
         (= (read-u32 base length 12) 108)
         (>= (read-u32 base length 16) 2)
         (<= (read-u32 base length 16) 5)
         (> object-length 0)
         (>= object-offset 36)
         (<= object-offset 512)
         (<= object-length (- 512 object-offset))
         (>= (read-u32 base length 36) 4)
         (>= (read-u32 base length 40) 80)
         (<= (read-u32 base length 40) 272)
         (>= (read-u32 base length 76) 5)
         (= (read-u32 base length 80) 1)
         (= (fnv-object base length object-offset object-length)
            (read-u32 base length 32)))))

