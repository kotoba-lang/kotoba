;; The CPU reads of kernel/qwen35_infer.c and kernel/device_result.c in Kotoba (JUN-554, over the object route's CPU
;; intrinsics of amu ADR 0389 / JUN-633): read_cycles (lfence; rdtsc) and aiueos_cpu_random_bytes (RDRAND words).
;;
;; read_cycles(): the 64-bit time-stamp counter after an lfence, as the C's inline asm read it.
;; cpu_random_bytes(out, n): 1 when out[0..n) was filled from RDRAND, else 0 -- out null, n zero or above 16384, a CPU
;;   without RDRAND (CPUID.1:ECX[30] clear; the instruction would raise #UD), or a word RDRAND would not give. Each word
;;   is kernel-rdrand up to four times (each is ten tries, so forty against the C's thirty-two); kernel-rdrand reports
;;   failure as 0, so a word that is genuinely 0 (probability 2^-64) is also taken as a failure and retried. The bytes of
;;   a word are stored low first, as the C did. On 0, out may hold the words drawn so far, as with the C.
;;
;; Built by the Amu aiueos kernel object route at amu 63557e92 (amu#1714, ADR 0389), fuel 4194304.
(ns aiueos.cpu-reads
  (:export [kotoba_aiueos_read_cycles kotoba_aiueos_cpu_random_bytes]))
(defn kotoba_aiueos_read_cycles [] :i64 (kernel-rdtsc))
(defn- canonical? [x :i64] :bool (= (u64-shift-right x 32) 0))
(defn- word [tries :i64] :i64
  (if (>= tries 4) 0 (let [w (kernel-rdrand)] (if (not= w 0) w (word (+ tries 1))))))
;; store word w's bytes into out[at..) low first, at most until n; the next offset
(defn- put [out :i64 n :i64 at :i64 w :i64 i :i64] :i64
  (if (or (>= i 8) (>= (+ at i) n)) (+ at i)
    (let [x (kernel-store-u8-16k out n (+ at i) (bit-and (u64-shift-right w (* 8 i)) 255))] (put out n at w (+ (+ i 1) (* 0 x))))))
(defn- fill [out :i64 n :i64 at :i64] :i64
  (if (>= at n) 1
    (let [w (word 0)] (if (= w 0) 0 (let [a (put out n at w 0)] (fill out n a))))))
(defn kotoba_aiueos_cpu_random_bytes [out :i64 n :i64] :i64
  (if (or (= out 0) (not (canonical? n)) (= n 0) (> n 16384)) 0
    (if (= (bit-and (u64-shift-right (kernel-cpuid-ecx 1 0) 30) 1) 0) 0 (fill out n 0))))
