;; The interrupt-driven completion wait of kernel/pci.c's virtio RNG driver in Kotoba (JUN-598), over amu ADR 0392's
;; kernel-wait-interrupt.
;;
;; wait(used, 4096, counter, 8, before, want, rounds): rounds times (1..65536): check whether the interrupt counter (u64
;; @counter) differs from before and the used ring's index (u16 @2) equals want -- answer 1 then -- and otherwise wait
;; for the next interrupt (sti; hlt; cli). That is one iteration of the C's loop, check then wait, so calls of R and S
;; rounds are its R + S iterations exactly. Answers 2 after the last round's wait, without checking again, so the C can
;; call it again until its own budget is spent (an object call is bounded by its
;; fuel, the C's 10^8 iterations are not); 0 for a null pointer, a wrong length, rounds outside 1..65536, a want past 16
;; bits, or a before at or past 2^30 (it shares one word with want and the rounds; the RNG takes one interrupt per
;; completion, so a boot does not reach it).
(ns aiueos.virtq-wait (:export [kotoba_aiueos_virtq_wait]))
;; state: want bits 0..15, rounds left bits 16..32, before bits 33..62
(defn- wait-rounds [u :i64 un :i64 c :i64 cn :i64 state :i64] :i64
  (let [want (bit-and state 65535) left (bit-and (u64-shift-right state 16) 131071) before (u64-shift-right state 33)
        count (kernel-load-u64 c cn 0) index (kernel-load-u16-16k u un 2)]
    (cond (<= left 0) 2
          (and (not= count before) (= index want)) 1
          :else (let [w (kernel-wait-interrupt)]
                  (wait-rounds u un c cn (- state (+ 65536 (* 0 w))))))))
(defn kotoba_aiueos_virtq_wait [used :i64 un :i64 counter :i64 cn :i64 before :i64 want :i64 rounds :i64] :i64
  (if (or (= used 0) (= counter 0) (not= un 4096) (not= cn 8) (< rounds 1) (> rounds 65536)
          (< want 0) (> want 65535) (< before 0) (>= before 1073741824)) 0
    (wait-rounds used un counter cn (+ want (+ (* rounds 65536) (* before 8589934592))))))
