;; kernel/job_protocol.c in Kotoba (JUN-553). MARSHALLING ONLY, as the C was (ADR-0220): the four wire lines are decided by
;; kotoba/job-protocol-dispatch.o (kotoba_aiueos_job_protocol, mode word + four arguments); this object packs the 48-byte input
;; record that module's header lays out, hands spans across, and unpacks the answers into the caller's struct.
;;
;; * The 48-byte record is data cells 0..5 (cell-addr-0 is handed to the dispatch object; amu ADR 0382): boot nonce, cycle count,
;;   then score | total << 16 | token << 32 | id length << 40, then sequence | id bytes 0..3 << 32, then id bytes 4..19. Like the
;;   C's stack buffer it is rebuilt in full before every call; unlike it, it is one buffer, so the entry points are not
;;   reentrant (as tls_aes_gcm.c's gcm_ctx was not): two calls must not run at the same time.
;; * struct aiueos_job_request (104 bytes: boot_nonce u64 @0, job_id[21] @8, prompt[64] @29, prompt_length u32 @96) and
;;   struct aiueos_micro_infer_result (8 bytes: token @0, score u16 @4, total u16 @6) are D5 records (amu ADR 0381).
;;   *sequence is a u32 written as an 8-byte record at offset 0 (a record is at least 8 bytes; only bytes 0..3 are touched).
;; * job_id is read as the C reads it: byte k only while bytes 0..k-1 are non-zero, at most 21 bytes; bytes 0..19 go into the
;;   record and the length byte is the count, or 0 when the 21st byte is not the terminator.
;; * request->job_id[id_length] = 0 is a fixed-offset store chosen by id_length (1..20, the bound the dispatch object is given).
;; * uint32_t arguments arrive in 64-bit registers whose upper half is unspecified, so they are masked to 32 bits.
;;
;; Built by the Amu aiueos kernel object route at amu 7a955b61: a Mac root built at that commit reproduces kotoba/job-protocol.o
;; byte for byte. scripts/job-protocol-diff runs it against the C under QEMU (TCG); it has not run in a booted kernel.
(ns aiueos.job-protocol
  (:export [aiueos_job_request_parse aiueos_job_result_payload aiueos_job_commit_valid aiueos_node_ping_parse
            aiueos_node_pong_payload]))
(defn- extern-kotoba_aiueos_job_protocol [mode :i64 a :i64 b :i64 c :i64 d :i64] :i64 0)
