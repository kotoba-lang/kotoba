(defn- record-store-u8-28-104 [b :i64 v :i64] :i64 0)
(defn- record-store-u64-0-104 [b :i64 v :i64] :i64 0)
(defn- record-store-u32-96-104 [b :i64 v :i64] :i64 0)
(defn- record-load-u8-0-8 [b :i64] :i64 0)
(defn- record-load-u16-4-8 [b :i64] :i64 0)
(defn- record-load-u16-6-8 [b :i64] :i64 0)
(defn- record-store-u32-0-8 [b :i64 v :i64] :i64 0)
(defn- u32 [x :i64] :i64 (bit-and x 4294967295))
(defn- hi32 [x :i64] :i64 (u32 (u64-shift-right x 32)))
(defn- nz [x :i64] :i64 (if (= x 0) 0 1))
;; the record's cells: c2 carries score, total, token and the id length; c3 the sequence and id bytes 0..3; c4, c5 bytes 4..19
(defn- pack-head [boot :i64 cycles :i64 c2 :i64] :i64
  (let [a (cell-store-0 boot) b (cell-store-1 cycles) c (cell-store-2 c2)] (* 0 (+ a (+ b c)))))
(defn- pack-tail [seq :i64 i0 :i64 i1 :i64 i2 :i64] :i64
  (let [d (cell-store-3 (+ (u32 seq) (* i0 4294967296))) e (cell-store-4 i1) f (cell-store-5 i2)] (* 0 (+ d (+ e f)))))
(defn- le4 [a :i64 b :i64 c :i64 d :i64] :i64 (+ a (* 256 (+ b (* 256 (+ c (* 256 d)))))))
(defn- le8 [a :i64 b :i64 c :i64 d :i64 e :i64] :i64 (+ (le4 a b c d) (* 4294967296 e)))
(defn aiueos_job_request_parse [payload :i64 length :i64 expected-boot :i64 request :i64] :i64
  (if (or (= payload 0) (= request 0)) 0
    (let [n (u32 length)
          verdict (extern-kotoba_aiueos_job_protocol 0 payload n (hi32 expected-boot) (u32 expected-boot))]
      (if (<= verdict 0) 0
        (let [z (+ (record-store-u8-8-104 request 0) (record-store-u8-9-104 request 0) (record-store-u8-10-104 request 0) (record-store-u8-11-104 request 0) (record-store-u8-12-104 request 0) (record-store-u8-13-104 request 0) (record-store-u8-14-104 request 0) (record-store-u8-15-104 request 0) (record-store-u8-16-104 request 0) (record-store-u8-17-104 request 0) (record-store-u8-18-104 request 0) (record-store-u8-19-104 request 0) (record-store-u8-20-104 request 0) (record-store-u8-21-104 request 0) (record-store-u8-22-104 request 0) (record-store-u8-23-104 request 0) (record-store-u8-24-104 request 0) (record-store-u8-25-104 request 0) (record-store-u8-26-104 request 0) (record-store-u8-27-104 request 0) (record-store-u8-28-104 request 0))
              id (extern-kotoba_aiueos_job_protocol 6 payload n (+ request 8) 20)
              pl (extern-kotoba_aiueos_job_protocol 1 payload n (+ request 29) 64)]
          (if (or (<= (+ id (* 0 z)) 0) (<= pl 0)) 0
            (let [t (cond (= id 1) (record-store-u8-9-104 request 0) (= id 2) (record-store-u8-10-104 request 0) (= id 3) (record-store-u8-11-104 request 0) (= id 4) (record-store-u8-12-104 request 0) (= id 5) (record-store-u8-13-104 request 0) (= id 6) (record-store-u8-14-104 request 0) (= id 7) (record-store-u8-15-104 request 0) (= id 8) (record-store-u8-16-104 request 0) (= id 9) (record-store-u8-17-104 request 0) (= id 10) (record-store-u8-18-104 request 0) (= id 11) (record-store-u8-19-104 request 0) (= id 12) (record-store-u8-20-104 request 0) (= id 13) (record-store-u8-21-104 request 0) (= id 14) (record-store-u8-22-104 request 0) (= id 15) (record-store-u8-23-104 request 0) (= id 16) (record-store-u8-24-104 request 0) (= id 17) (record-store-u8-25-104 request 0) (= id 18) (record-store-u8-26-104 request 0) (= id 19) (record-store-u8-27-104 request 0) (= id 20) (record-store-u8-28-104 request 0) :else 0)
                  b (record-store-u64-0-104 request expected-boot)
                  p (record-store-u32-96-104 request (u32 pl))]
              (+ 1 (* 0 (+ t (+ b p)))))))))))
(defn aiueos_job_result_payload [out :i64 capacity :i64 boot-nonce :i64 job_id :i64 result :i64 inference-cycles :i64] :i64
  (if (or (= out 0) (or (= (u32 capacity) 0) (= result 0))) 0
  (let [j0 (if (= job_id 0) 0 (record-load-u8-0-24 job_id))
        j1 (if (= j0 0) 0 (record-load-u8-1-24 job_id))
        j2 (if (= j1 0) 0 (record-load-u8-2-24 job_id))
        j3 (if (= j2 0) 0 (record-load-u8-3-24 job_id))
        j4 (if (= j3 0) 0 (record-load-u8-4-24 job_id))
        j5 (if (= j4 0) 0 (record-load-u8-5-24 job_id))
        j6 (if (= j5 0) 0 (record-load-u8-6-24 job_id))
        j7 (if (= j6 0) 0 (record-load-u8-7-24 job_id))
        j8 (if (= j7 0) 0 (record-load-u8-8-24 job_id))
        j9 (if (= j8 0) 0 (record-load-u8-9-24 job_id))
        j10 (if (= j9 0) 0 (record-load-u8-10-24 job_id))
        j11 (if (= j10 0) 0 (record-load-u8-11-24 job_id))
        j12 (if (= j11 0) 0 (record-load-u8-12-24 job_id))
        j13 (if (= j12 0) 0 (record-load-u8-13-24 job_id))
        j14 (if (= j13 0) 0 (record-load-u8-14-24 job_id))
        j15 (if (= j14 0) 0 (record-load-u8-15-24 job_id))
        j16 (if (= j15 0) 0 (record-load-u8-16-24 job_id))
        j17 (if (= j16 0) 0 (record-load-u8-17-24 job_id))
        j18 (if (= j17 0) 0 (record-load-u8-18-24 job_id))
        j19 (if (= j18 0) 0 (record-load-u8-19-24 job_id))
        j20 (if (= j19 0) 0 (record-load-u8-20-24 job_id))
        id-count (+ (nz j0) (nz j1) (nz j2) (nz j3) (nz j4) (nz j5) (nz j6) (nz j7) (nz j8) (nz j9) (nz j10) (nz j11) (nz j12) (nz j13) (nz j14) (nz j15) (nz j16) (nz j17) (nz j18) (nz j19) (nz j20))
        id-len (if (> id-count 20) 0 id-count)
        i1 (+ (le4 j4 j5 j6 j7) (* 4294967296 (le4 j8 j9 j10 j11)))
        i2 (+ (le4 j12 j13 j14 j15) (* 4294967296 (le4 j16 j17 j18 j19)))
        i0 (le4 j0 j1 j2 j3)]
    (let [c2 (+ (record-load-u16-4-8 result) (* 65536 (+ (record-load-u16-6-8 result)
                                                   (* 65536 (+ (record-load-u8-0-8 result) (* 256 id-len))))))
          k (+ (pack-head boot-nonce inference-cycles c2) (pack-tail 0 i0 i1 i2))
          r (extern-kotoba_aiueos_job_protocol 2 out (u32 capacity) (+ (cell-addr-0) k) 0)]
      (if (> r 0) (u32 r) 0)))))
