(defn- record-store-u8-9-104 [b :i64 v :i64] :i64 0)
(defn- record-store-u8-10-104 [b :i64 v :i64] :i64 0)
(defn- record-store-u8-11-104 [b :i64 v :i64] :i64 0)
(defn- record-store-u8-12-104 [b :i64 v :i64] :i64 0)
(defn- record-store-u8-13-104 [b :i64 v :i64] :i64 0)
