(defn- record-store-u8-20-104 [b :i64 v :i64] :i64 0)
(defn- record-store-u8-21-104 [b :i64 v :i64] :i64 0)
(defn- record-store-u8-22-104 [b :i64 v :i64] :i64 0)
(defn- record-store-u8-23-104 [b :i64 v :i64] :i64 0)
(defn- record-store-u8-24-104 [b :i64 v :i64] :i64 0)
