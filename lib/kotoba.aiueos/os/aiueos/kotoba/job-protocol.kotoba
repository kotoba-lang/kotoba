(defn aiueos_node_ping_parse [payload :i64 length :i64 expected-boot :i64 sequence :i64] :i64
  (if (or (= payload 0) (= sequence 0)) 0
    (let [v (extern-kotoba_aiueos_job_protocol 4 payload (u32 length) (hi32 expected-boot) (u32 expected-boot))]
      (if (< v 0) 0 (+ 1 (* 0 (record-store-u32-0-8 sequence (u32 v))))))))
(defn aiueos_node_pong_payload [out :i64 capacity :i64 boot-nonce :i64 sequence :i64] :i64
  (if (or (= out 0) (= (u32 capacity) 0)) 0
    (let [k (+ (pack-head boot-nonce 0 0) (pack-tail sequence 0 0 0))
          r (extern-kotoba_aiueos_job_protocol 5 out (u32 capacity) (+ (cell-addr-0) k) 0)]
      (if (> r 0) (u32 r) 0))))
