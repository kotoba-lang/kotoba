(ns pct-oracle (:export [main]))
;; Percent-of-basis rounding, host-native f64 oracle vs exact integer arithmetic.
;; Hosted expression (lib/kotoba.cssom/src/cssom/layout.cljk `percentage-of`, line 3939):
;;   (long (Math/round (* basis (/ pct 100.0))))     pct = Double/parseDouble of the decimal text, basis a number
;; f64 side below: pct = H/100 (H = hundredths of a percent; correctly rounded == parseDouble of the 2-decimal text),
;; then / 100.0, then * basis, then Math.round (floor(x+0.5), done exactly via trunc + fraction test).
;; Fixed side: floor((H*basis + 5000) / 10000), one rounding of the exact rational, i64 only.
;; mode 0: number of (H,basis) pairs where the two differ; mode 1: the SKIP-th differing pair as H*100000+basis.
(def mode 0)
(def skip 0)
(def hmax 30000)
(def bmax 4096)
(defn fl [h :i64 b :i64] :i64
  (let [p (f64-div (i64-to-f64-rounded h) 100.0)
        x (f64-mul (i64-to-f64-rounded b) (f64-div p 100.0))
        t (f64-to-i64-truncating x)
        frac (f64-sub x (i64-to-f64-rounded t))]
    (if (f64-ge frac 0.5) (inc t) t)))
(defn fx [h :i64 b :i64] :i64 (quot (+ (* h b) 5000) 10000))
(defn scan [h :i64 b :i64 n :i64 k :i64] :i64
  (cond (> h hmax) (if (= mode 0) n -1)
        (> b bmax) (scan (inc h) 0 n k)
        (not= (fl h b) (fx h b)) (if (and (= mode 1) (= k skip)) (+ (* h 100000) b) (scan h (inc b) (inc n) (inc k)))
        :else (scan h (inc b) n k)))
(defn main [] :i64 (scan 0 0 0 0))
