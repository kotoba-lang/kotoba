(ns q6-vs-f64-test
  (:require [cssom.block-width :as f64w] [cssom.block-width-q6 :as q6])
  (:export [main]))
;; Differential gate (host native macOS): f64 oracle = lib/kotoba.cssom/src/cssom/block_width.kotoba (existing
;; native port), candidate = Q6 fixed point. Inputs are drawn on the Q6 grid so the f64 side is exact on inputs.
(def mode 0) ; 0: return violation count (42 = none); 1: return max |q6 - f64| in 1/128 px units
(defn rnd [x :i64] :i64 (bit-and (+ (* x 1103515245) 12345) 2147483647))
(defn draw [x :i64] :i64 (let [k (+ 3 (bit-and (i64-shift-right x 20) 15))] (bit-and (i64-shift-right x 3) (- (i64-shift-left 1 k) 1))))
(defn tof [raw :i64] :f64 (f64-mul (i64-to-f64-rounded raw) 0.015625))
(defn bit [f :i64 b :i64] :bool (not= (bit-and (i64-shift-right f b) 1) 0))
;; |a-b| in units of 1/128 px, as i64, from an exact f64 difference (both are multiples of 1/128)
(defn units128 [a :f64 b :f64] :i64
  (let [d (f64-sub a b)] (loop [n 0] (if (f64-lt (f64-mul (i64-to-f64-rounded n) 0.0078125) (if (f64-lt d 0.0) (f64-sub 0.0 d) d)) (recur (inc n)) n))))
(defn cmp [a :f64 raw :i64] :i64 (units128 a (tof raw)))
(defn one [seed :i64] :i64
  (let [s1 (rnd seed) s2 (rnd s1) s3 (rnd s2) s4 (rnd s3) s5 (rnd s4) s6 (rnd s5) s7 (rnd s6) s8 (rnd s7) s9 (rnd s8)
        cb (draw s1) w (draw s2) l (- (draw s3) (draw s9)) r (draw s4) pl (draw s5) pr (draw s6) bl (bit-and (draw s7) 63) br (bit-and (draw s8) 63)
        flags (bit-and (i64-shift-right s9 5) 31)
        x (record [:ref :css.block/input] (tof cb) (tof w) (bit flags 0) (bit flags 1) (tof l) (bit flags 2) (tof r) (bit flags 3)
                  (tof pl) (tof pr) (tof bl) (tof br) (bit flags 4))
        z (f64w/solve x)
        p1 (q6/pack cb w) p2 (q6/pack (+ l 1073741824) (+ r 1073741824)) p3 (q6/pack pl pr) p4 (q6/pack bl br)
        qc (q6/solve-pick (+ 32 flags) p1 p2 p3 p4) qb (q6/solve-pick (+ 64 flags) p1 p2 p3 p4)
        ql (q6/solve-pick (+ 96 flags) p1 p2 p3 p4) qr (q6/solve-pick (+ 128 flags) p1 p2 p3 p4)
        fv (record-get [:ref :css.block/result] z :valid)
        qv (not= qc (q6/invalid))]
    (cond (not= fv qv) 1000
          (not fv) -1
          :else (max (max (cmp (record-get [:ref :css.block/result] z :content) qc) (cmp (record-get [:ref :css.block/result] z :border) qb))
                     (max (cmp (record-get [:ref :css.block/result] z :margin-left) ql) (cmp (record-get [:ref :css.block/result] z :margin-right) qr))))))
(defn sweep [seed :i64 n :i64 worst :i64 bad :i64 valid :i64] :i64
  (if (= n 0) (if (= mode 1) worst (if (= mode 2) valid bad))
    (let [d (one seed)]
      (sweep (rnd (rnd (rnd seed))) (- n 1) (max worst d) (if (> d 1) (inc bad) bad) (if (< d 0) valid (inc valid))))))
(defn main [] :i64
  (let [r (sweep 12345 1000000 0 0 0)] (if (= mode 1) r (if (= r 0) 42 r))))
