(ns cssom.block-width-q6-mut (:export [solve-pick pack invalid]))

;; Measurement prototype (JUN-134 census), NOT a port: CSS 2.2 10.3.3 horizontal equation for a non-replaced
;; block, in Q6 fixed point (1 unit = 1/64 px, the Blink LayoutUnit scale). Scalar i64 only and at most five
;; parameters per function, so it is admitted by x86_64-aiueos-user-v1 (no strings, records or regions there;
;; six parameters are refused with E7102). Two 31-bit Q6 values travel in one i64 (hi*2^32 + lo).
;; Mirrors lib/kotoba.cssom/src/cssom/block_width.kotoba `solve` (f64). A range guard |raw| <= 2^30 (= 2^24 px)
;; replaces the f64 `finite?` test; this module has no multiplication, so its product budget is trivially met.
;; p0 = sel*32 + flags   flags: bit0 width-auto, bit1 border-box, bit2 left-auto, bit3 right-auto, bit4 rtl
;;      sel: 1 content, 2 border, 3 margin-left, 4 margin-right
;; p1 = pack(cb, w)   p2 = pack(left+2^30, right+2^30)   p3 = pack(pl, pr)   p4 = pack(bl, br)
;; Returns INVALID (-2^62) when a guard fails.
(defn invalid [] :i64 -4611686018427387904)
(defn pack [hi :i64 lo :i64] :i64 (+ (i64-shift-left hi 32) lo))
(defn hi [p :i64] :i64 (i64-shift-right p 32))
(defn lo [p :i64] :i64 (bit-and p 4294967295))
(defn in-range? [x :i64] :bool (and (>= x -1073741824) (<= x 1073741824)))
(defn nonneg? [x :i64] :bool (and (>= x 0) (<= x 1073741824)))
(defn max0 [x :i64] :i64 (if (< x 0) 0 x))
(defn flag [f :i64 bit :i64] :bool (not= (bit-and (i64-shift-right f bit) 1) 0))
(defn pick [sel :i64 content :i64 border :i64 l :i64 r :i64] :i64
  (cond (= sel 1) content (= sel 2) border (= sel 3) l :else r))
(defn solve-pick [p0 :i64 p1 :i64 p2 :i64 p3 :i64 p4 :i64] :i64
  (let [sel (i64-shift-right p0 5) flags (bit-and p0 31)
        cb (hi p1) w (lo p1) left (- (hi p2) 1073741824) right (- (lo p2) 1073741824)
        pl (hi p3) pr (lo p3) bl (hi p4) br (lo p4)]
    (if (not (and (nonneg? cb) (nonneg? w) (in-range? left) (in-range? right)
                  (nonneg? pl) (nonneg? pr) (nonneg? bl) (nonneg? br)))
      (invalid)
      (let [auto (flag flags 0) border-box (flag flags 1) left-auto (flag flags 2) right-auto (flag flags 3) rtl (flag flags 4)
            extra (+ (+ pl pr) (+ bl br))
            l0 (if left-auto 0 left) r0 (if right-auto 0 right)
            fixed (if auto 0 (if border-box (max0 (- w extra)) w))
            over (and (not auto) (> (+ (+ (+ fixed extra) l0) r0) cb))
            la (and left-auto (not over) (not auto)) ra (and right-auto (not over) (not auto))
            content (if auto (max0 (- (- (- cb extra) l0) r0)) fixed)
            border (+ content extra)
            remaining (- (- (- cb border) l0) r0)
            half (i64-shift-right remaining 2)
            l (cond (and la ra) half la remaining (and (not ra) rtl) (+ l0 remaining) :else l0)
            r (cond (and la ra) (- remaining half) ra remaining (and (not la) (not rtl)) (+ r0 remaining) :else r0)]
        (if (and (in-range? content) (in-range? border) (in-range? l) (in-range? r))
          (pick sel content border l r)
          (invalid))))))
