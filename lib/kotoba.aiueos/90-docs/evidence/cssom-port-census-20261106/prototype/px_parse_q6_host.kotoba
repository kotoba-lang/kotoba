(ns px-parse-q6-host (:export [main]))
;; user-v2 slice probe: parse "[+-]digits[.digits][px]" from the 64-byte OS-filled request region into Q6 (1/64 px)
;; with round-half-up on the 7th fractional bit. No strings: the text is read as bytes out of u32 words
;; (kernel-load-u32 is the only region primitive user-v2..v5 admit; there is no u8 load).
;; Returns Q6 raw, or -2^62 when the text is outside the grammar / out of the +-2^24 px guard.
(defn byte-at [b :string n :i64 i :i64] :i64 (if (< i (string-length b)) (string-code-point-at b i) 0))
(defn digit? [c :i64] :bool (and (>= c 48) (<= c 57)))
;; integer part: loop over digits, value <= 2^24 guard
(defn int-end [b :string n :i64 i :i64 acc :i64] :i64
  (if (and (< i 60) (digit? (byte-at b n i)) (< acc 16777216)) (int-end b n (+ i 1) (+ (* acc 10) (- (byte-at b n i) 48))) (+ (* acc 4096) i)))
;; fraction: accumulate numerator/denominator up to 6 digits (10^6), result Q6 numerator = round(num*64/den)
(defn frac-q6 [b :string n :i64 i :i64 num :i64 den :i64] :i64
  (if (and (< i 60) (digit? (byte-at b n i)) (< den 1000000))
    (frac-q6 b n (+ i 1) (+ (* num 10) (- (byte-at b n i) 48)) (* den 10))
    (quot (+ (* num 128) den) (* den 2))))
(defn parse [b :string n :i64] :i64
  (let [neg (= (byte-at b n 0) 45)
        s (if (or neg (= (byte-at b n 0) 43)) 1 0)
        ip (int-end b n s 0)
        i (bit-and ip 4095) acc (i64-shift-right ip 12)
        dot (= (byte-at b n i) 46)
        fq (if dot (frac-q6 b n (+ i 1) 0 1) 0)
        raw (+ (* acc 64) fq)]
    (if (or (= i s) (>= acc 16777216)) -4611686018427387904 (if neg (- 0 raw) raw))))

(defn main [] :i64 (if (and (= (parse "12.5px" 64) 800) (= (parse "-3.14159px" 64) -201) (= (parse "0.1px" 64) 6) (= (parse "13.3333px" 64) 853) (= (parse "100" 64) 6400) (= (parse "+7.999px" 64) 512) (= (parse "16777215.99px" 64) 1073741823) (= (parse "0.0078125px" 64) 0) (= (parse "0.0078126px" 64) 0) (= (parse "0.0078120px" 64) 0) (= (parse "11.6667px" 64) 747) (= (parse "1.5" 64) 96) (= (parse "33.33px" 64) 2133) (= (parse "0.5px" 64) 32) (= (parse "0.515625px" 64) 33)) 42 7))
