;; Operator / industrial policy. Separate from `cloud_live.edn` on purpose:
;; consumer session / phone-bind / bare-metal cloud gates must stay green
;; without itonami.cloud in their allowlist (root ADR-2608221625 P4).
;;
;; `kbb -M:cloud-live pin https://itonami.cloud` MEASURES a peer key and
;; prints it; it does not write here. Putting the measured key into this file
;; is a person deciding to trust it for the operator plane.
;;
;; Measured 2026-08-22:
;;   kbb -M:cloud-live pin https://itonami.cloud
;;   host itonami.cloud
;;   spki-sha256 05dcc4819b5cfa486493e6f7b37d1ff72dcd0bf2017ebd1beefc1f8873570c1b
{:aiueos.operator/version 1
 :aiueos.operator/authority "itonami.cloud"
 :aiueos.operator/surface "https://itonami.cloud"
 :aiueos.operator/health-path "/api/health"
 :aiueos.operator/inventory-path "/api/fleet/metrics"
 :aiueos.operator/auth-path "/api/network-awai/cloud-itonami/state"

 :aiueos.policy/net-allow #{"itonami.cloud"}

 :aiueos.cloud/inference-origin "https://itonami.cloud"
 :aiueos.cloud/liveness-path "/api/health"

 :aiueos.cloud/trust-anchors
 {"itonami.cloud"
  {:pins #{"05dcc4819b5cfa486493e6f7b37d1ff72dcd0bf2017ebd1beefc1f8873570c1b"}
   :measured "2026-08-22"
   :fronted-by "cloudflare"
   :how "kbb -M:cloud-live pin https://itonami.cloud"}}

 :aiueos.cloud/require-host-bound-anchors? true}
