 var(--hig-font-text); --hig-text-headline-font-size: calc(17 / 16 * 1rem); --hig-text-headline-font-weight: 600; --hig-text-headline-line-height: calc(22 / 16 * 1rem); --hig-text-large-title-font-family: var(--hig-font-display); --hig-text-large-title-font-size: calc(34 / 16 * 1rem); --hig-text-large-title-font-weight: 400; --hig-text-large-title-line-height: calc(41 / 16 * 1rem); --hig-text-subheadline-font-family: var(--hig-font-text); --hig-text-subheadline-font-size: calc(15 / 16 * 1rem); --hig-text-subheadline-font-weight: 400; --hig-text-subheadline-line-height: calc(20 / 16 * 1rem); --hig-text-title1-font-family: var(--hig-font-display); --hig-text-title1-font-size: calc(28 / 16 * 1rem); --hig-text-title1-font-weight: 400; --hig-text-title1-line-height: calc(34 / 16 * 1rem); --hig-text-title2-font-family: var(--hig-font-display); --hig-text-title2-font-size: calc(22 / 16 * 1rem); --hig-text-title2-font-weight: 400; --hig-text-title2-line-height: calc(28 / 16 * 1rem); --hig-text-title3-font-family: var(--hig-font-display); --hig-text-title3-font-size: calc(20 / 16 * 1rem); --hig-text-title3-font-weight: 400; --hig-text-title3-line-height: calc(25 / 16 * 1rem); --hig-z-float: 40; --hig-z-modal: 60; --hig-z-raised: 1; --hig-z-sticky: 20; --hig-z-toast: 80; }:root { color-scheme: light; }\n.dads-button,.dads-accordion__summary,.dads-menu-list-box__opener,.dads-input-text__input,.dads-textarea__textarea,.dads-checkbox { min-height: 44px; }\nbody { padding-top: env(safe-area-inset-top,0px); padding-left: env(safe-area-inset-left,0px); padding-right: env(safe-area-inset-right,0px); padding-bottom: env(safe-area-inset-bottom,0px); }\n.session-shell{max-width:88rem;margin:0 auto;padding:0 var(--hig-spacing-4) var(--hig-spacing-4);color:var(--hig-color-label);background:var(--hig-color-system-background)}\n.session-shell:has(#desktop:not([hidden])){max-width:88rem}\n.session-main{min-height:calc(100vh - 4rem)}\n.desktop-surface{position:relative;display:flex;flex-direction:column;min-height:min(76vh,48rem);overflow:hidden;border:var(--hig-hairline,1px) solid var(--hig-color-separator);border-radius:var(--hig-radius-xs);background:linear-gradient(145deg,var(--hig-color-tint),var(--hig-color-secondary-system-background) 72%)}\n.desktop-menubar{display:flex;align-items:center;gap:var(--hig-spacing-4);min-height:2.75rem;padding:0 var(--hig-spacing-4);border-bottom:var(--hig-hairline,1px) solid var(--hig-color-separator);background:var(--hig-color-system-background)}\n.desktop-brand{font-weight:700;color:var(--hig-color-label);text-decoration:none}\n.desktop-menubar-app{font-weight:600}\n.desktop-menubar-spacer,.window-spacer{flex:1}\n.desktop-menu-link{color:var(--hig-color-secondary-label);text-decoration:none}\n.desktop-menu-link:hover,.session-nav a:hover{color:var(--hig-color-tint)}\n.desktop-welcome{padding:var(--hig-spacing-6) var(--hig-spacing-6) 0}\n.desktop-welcome h1{margin:0}\n.desktop-app-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(6rem,8rem));gap:var(--hig-spacing-4);padding:var(--hig-spacing-5) var(--hig-spacing-6);align-content:start;flex:1}\n.desktop-app{display:flex;flex-direction:column;align-items:center;gap:var(--hig-spacing-2);padding:var(--hig-spacing-3);color:var(--hig-color-label);text-decoration:none;border-radius:var(--hig-radius-xs)}\n.desktop-app:hover{background:var(--hig-color-secondary-system-background)}\n.desktop-app-icon{display:grid;place-items:center;width:4.25rem;height:4.25rem;border:var(--hig-hairline,1px) solid var(--hig-color-separator);border-radius:var(--hig-radius-xs);background:var(--hig-color-system-background);color:var(--hig-color-tint);font-size:1.75rem;font-weight:700;box-shadow:0 0.25rem 0.75rem var(--hig-color-secondary-system-fill)}\n.desktop-app-label{padding:0 var(--hig-spacing-2);border-radius:var(--hig-radius-xs);background:var(--hig-color-system-background);font-size:var(--hig-text-footnote-font-size)}\n.desktop-dock-wrap{display:flex;justify-content:center;padding:0 var(--hig-spacing-4) var(--hig-spacing-4)}\n.desktop-dock{display:flex;align-items:center;gap:var(--hig-spacing-2);padding:var(--hig-spacing-2);border:var(--hig-hairline,1px) solid var(--hig-color-separator);border-radius:var(--hig-radius-xs);background:var(--hig-color-system-background);box-shadow:0 0.25rem 1rem var(--hig-color-secondary-system-fill)}\n.dock-app{display:flex;flex-direction:column;align-items:center;gap:var(--hig-spacing-1);min-width:4.5rem;padding:var(--hig-spacing-2);border-radius:var(--hig-radius-xs);color:var(--hig-color-label);text-decoration:none}\n.dock-app:hover{background:var(--hig-color-secondary-system-background)}\n.dock-app-icon{display:grid;place-items:center;width:2.75rem;height:2.75rem;border-radius:var(--hig-radius-xs);background:var(--hig-color-secondary-system-background);color:var(--hig-color-tint);font-weight:700;font-size:1.25rem}\n.dock-app-label{font-size:var(--hig-text-caption-1-font-size,0.7rem)}\n.dock-divider{width:var(--hig-hairline,1px);height:2.5rem;background:var(--hig-color-separator);margin:0 var(--hig-spacing-1)}\n.desktop-footer{padding:0 var(--hig-spacing-4) var(--hig-spacing-3);color:var(--hig-color-secondary-label);font-size:var(--hig-text-caption-1-font-size,0.7rem)}\n.app-window{max-width:64rem;margin:var(--hig-spacing-6) auto;overflow:hidden;border:var(--hig-hairline,1px) solid var(--hig-color-separator);border-radius:var(--hig-radius-xs);background:var(--hig-color-system-background);box-shadow:0 0.5rem 2rem var(--hig-color-secondary-system-fill)}\n.app-window-head{display:flex;align-items:center;gap:var(--hig-spacing-3);min-height:2.75rem;padding:0 var(--hig-spacing-3);border-bottom:var(--hig-hairline,1px) solid var(--hig-color-separator);background:var(--hig-color-secondary-system-background)}\n.app-window-title{font-weight:600}\n.app-window-state{color:var(--hig-color-secondary-label);font-size:var(--hig-text-footnote-font-size)}\n.window-close{display:grid;place-items:center;width:1.5rem;height:1.5rem;border:var(--hig-hairline,1px) solid var(--hig-color-separator);border-radius:50%;color:var(--hig-color-label);text-decoration:none}\n.app-window-body{padding:var(--hig-spacing-5)}\n.app-window-body h1{margin-top:0}\n.app-return{display:inline-block;margin-top:var(--hig-spacing-4);color:var(--hig-color-tint)}\n.app-empty-state{padding:var(--hig-spacing-4);border-left:var(--hig-hairline,1px) solid var(--hig-color-tint);background:var(--hig-color-secondary-system-background);color:var(--hig-color-secondary-label)}\n.reader-empty{max-width:42rem;padding:var(--hig-spacing-5);margin:var(--hig-spacing-5) auto;border:var(--hig-hairline,1px) solid var(--hig-color-separator);background:var(--hig-color-secondary-system-background)}\n.wm-stage{position:relative;height:36rem;background:var(--hig-color-secondary-system-background);border-radius:var(--hig-radius-xs);margin:var(--hig-spacing-4) 0;outline:none}\n.ime-bar{min-height:2.75rem;padding:var(--hig-spacing-3);margin:var(--hig-spacing-4) 0;border:var(--hig-hairline,1px) solid var(--hig-color-separator);border-radius:var(--hig-radius-xs);background:var(--hig-color-secondary-system-background);gap:var(--hig-spacing-3);align-items:center}\n.ime-bar .dads-heading{margin:0}\n.ime-bar .dads-button{width:auto;margin:0}\n.wm-window{position:absolute;display:flex;flex-direction:column;background:var(--hig-color-system-background);border:var(--hig-hairline,1px) solid var(--hig-color-separator);border-radius:var(--hig-radius-xs)}\n.wm-window.is-focused{outline:var(--hig-hairline,1px) solid var(--hig-color-label)}\n.wm-window:not(.is-focused) .wm-guest{pointer-events:none}\n.wm-titlebar{min-height:2.75rem;padding:var(--hig-spacing-3);border-bottom:var(--hig-hairline,1px) solid var(--hig-color-separator);background:var(--hig-color-secondary-system-background);gap:var(--hig-spacing-3)}\n.wm-titlebar .dads-heading{margin:0;flex:1}\n.wm-body{flex:1;min-height:8rem;overflow:hidden}\n.wm-guest{width:100%;height:100%;min-height:8rem;padding:var(--hig-spacing-3);background:var(--hig-color-secondary-system-background)}\n.kami-viewport{display:block;width:100%;height:12rem;background:var(--hig-color-secondary-system-background);border-radius:var(--hig-radius-xs);margin:var(--hig-spacing-3) 0}\n.session-chrome{position:sticky;top:0;z-index:1;display:flex;justify-content:space-between;align-items:center;gap:var(--hig-spacing-4);padding:var(--hig-spacing-3) 0;margin-bottom:var(--hig-spacing-3);border-bottom:var(--hig-hairline,1px) solid var(--hig-color-separator);background:var(--hig-color-system-background)}\n.session-brand{font-weight:700;color:var(--hig-color-label);text-decoration:none}\n.session-nav{display:flex;flex-wrap:wrap;gap:var(--hig-spacing-4)}\n.session-nav a{color:var(--hig-color-secondary-label);text-decoration:none;font-size:var(--hig-text-footnote-font-size)}\n.session-lede{color:var(--hig-color-secondary-label);font-size:var(--hig-text-body-font-size,1rem);line-height:var(--hig-text-body-line-height,1.5)}\n.session-out{white-space:pre-wrap;overflow:auto;min-height:var(--hig-spacing-4);padding:var(--hig-spacing-3);background:var(--hig-color-secondary-system-background);border-radius:var(--hig-radius-xs);font-size:var(--hig-text-footnote-font-size)}\n.device-auth-qr{display:block;width:min(100%,18rem);height:auto;margin:var(--hig-spacing-4) auto;image-rendering:pixelated;background:var(--hig-color-system-background)}\n.device-auth-qr[hidden]{display:none!important}\n.session-view[hidden]{display:none!important}\n@media(max-width:40rem){.desktop-app-grid{grid-template-columns:repeat(2,minmax(6rem,8rem));justify-content:space-around}.desktop-menubar{gap:var(--hig-spacing-2);padding:0 var(--hig-spacing-2)}.desktop-menu-link{font-size:var(--hig-text-caption-1-font-size,0.7rem)}.dock-app{min-width:3rem}.dock-app-label{display:none}.session-shell{padding-inline:var(--hig-spacing-2)}}\n.dds-ext-card{margin:var(--hig-spacing-4) 0}\n.session-main .dads-button{width:100%;margin:var(--hig-spacing-3) 0}\n.wm-titlebar .dads-button{width:auto;margin:0}\n:root{--ui-shadow-low:0 1px 2px rgba(0,17,43,0.06),0 2px 8px rgba(0,17,43,0.05);--ui-shadow-mid:0 2px 6px rgba(0,17,43,0.07),0 12px 28px rgba(0,17,43,0.09);--ui-shadow-dock:0 1px 2px rgba(0,17,43,0.06),0 16px 40px rgba(0,17,43,0.12)}\na:focus,button:focus,input:focus,textarea:focus,summary:focus,[tabindex]:focus{outline:2px solid var(--hig-color-tint);outline-offset:2px}\n.desktop-app,.dock-app,.session-nav a,.desktop-menu-link,.window-close{transition:background-color var(--hig-motion-press) linear,color var(--hig-motion-press) linear,box-shadow var(--hig-motion-press) linear}\n.desktop-surface{border-radius:var(--hig-radius-sm);background:linear-gradient(165deg,var(--hig-color-system-background),var(--hig-color-tertiary-system-background) 55%,var(--hig-color-secondary-system-background))}\n.desktop-app-icon{box-shadow:var(--ui-shadow-low)}\n.desktop-app:hover .desktop-app-icon{box-shadow:var(--ui-shadow-mid)}\n.desktop-app-icon[data-app=\"murakumo\"],.dock-app-icon[data-app=\"murakumo\"]{color:var(--color-primitive-purple-700);background:var(--color-primitive-purple-50);border-color:var(--color-primitive-purple-200)}\n.desktop-app-icon[data-app=\"itonami\"],.dock-app-icon[data-app=\"itonami\"]{color:var(--color-primitive-orange-800);background:var(--color-primitive-orange-50);border-color:var(--color-primitive-orange-200)}\n.desktop-app-icon[data-app=\"yataverse\"],.dock-app-icon[data-app=\"yataverse\"]{color:var(--color-primitive-green-800);background:var(--color-primitive-green-50);border-color:var(--color-primitive-green-200)}\n.desktop-app-icon[data-app=\"aozora\"],.dock-app-icon[data-app=\"aozora\"]{color:var(--color-primitive-light-blue-800);background:var(--color-primitive-light-blue-50);border-color:var(--color-primitive-light-blue-200)}\n.dock-app-icon{border:var(--hig-hairline,1px) solid var(--hig-color-separator)}\n.dock-app.is-active .dock-app-icon{box-shadow:0 0 0 2px var(--hig-color-tint)}\n.dock-app.is-active{background:var(--hig-color-quaternary-system-fill)}\n")
(defn css-b [] :string "\n.desktop-dock{border-radius:var(--hig-radius-md);box-shadow:var(--ui-shadow-dock)}\n.app-window{border-radius:var(--hig-radius-sm);box-shadow:var(--ui-shadow-mid)}\n.window-close:hover{background:var(--hig-color-tint);color:var(--hig-color-system-background);border-color:var(--hig-color-tint)}\n.session-nav a[aria-current=\"page\"]{color:var(--hig-color-tint);font-weight:600;border-bottom:2px solid var(--hig-color-tint);padding-bottom:2px}\n.desktop-menu-link[aria-current=\"page\"]{color:var(--hig-color-label);font-weight:600}\n.desktop-welcome h1{letter-spacing:-0.01em}\n.desktop-footer{letter-spacing:0.02em}\n.session-lede{max-width:44rem}\n.session-out{font-family:var(--hig-font-mono);border:var(--hig-hairline,1px) solid var(--hig-color-separator)}\n.session-main .dads-button{max-width:24rem}\n")
(defn js-1 [] :string "\n/* Host binder for the generated dapp UI (JUN-809). The UI itself is the kotoba\n   html/css document in distributions/awai/dapps/ui; this only supplies the\n   values named by data-bind and handles the operations named by data-action.\n   It makes no network request. */\n(function () {\n  function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }\n  function put(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }\n  function pins() {\n    var raw = get(\"itonami.dock\");\n    if (raw) { try { return JSON.parse(raw); } catch (e) {} }\n    var d = []; document.querySelectorAll('.dock-app[data-dock-default=\"true\"]').forEach(function (a) { d.push(a.getAttribute(\"data-app\")); });\n    return d;\n  }\n  function paintDock() {\n    var p = pins();\n    document.querySelectorAll(\".dock-app[data-dock-default]\").forEach(function (a) { a.hidden = p.indexOf(a.getAttribute(\"data-app\")) < 0; });\n    document.querySelectorAll('[data-action=\"pin\"]').forEach(function (b) {\n      b.textContent = p.indexOf(b.getAttribute(\"data-app\")) >= 0 ? \"Dock から外す\" : \"Dock に置く\";\n    });\n  }\n  function bind(name, text) { document.querySelectorAll('[data-bind=\"' + name + '\"]').forEach(function (n) { n.textContent = text; }); }\n  function clock() { bind(\"clock\", new Date().toLocaleString(\"ja-JP\", { hour12: false }) + \"\\n\" + Intl.DateTimeFormat().resolvedOptions().timeZone); }\n  function net() {\n    var c = navigator.connection || {};\n    bind(\"net\", \"接続: \" + (navigator.onLine ? \"あり\" : \"なし\") + \"\\n種類: \" + (c.effectiveType || \"不明\"));\n  }\n  function request(btn) {\n    var slot = btn.parentNode.querySelector('[data-slot=\"result\"]'), tpl = document.getElementById(\"dapp-approval\");\n    if (!slot || !tpl) return;\n    slot.textContent = \"\"; slot.appendChild(tpl.content.cloneNode(true));\n    var op = btn.getAttribute(\"data-op\"), svc = btn.getAttribute(\"data-service\");\n    bind(\"approval-title\", \"承認が必要です: \" + op);\n    bind(\"approval-detail\", \"サービス: \" + svc + \" ／ エンドポイント: 未登録 ／ 送るデータ: 操作名のみ\");\n    slot.querySelector('[data-action=\"approve\"]').addEventListener(\"click\", function () {\n      slot.textContent = op === \"install-update\"
        ? \"このページはブラウザで動き、端末の ESP へ書き込めません。何も実行していません。\"
        : \"この AIUEOS ビルドには \" + svc + \" の接続先がまだ登録されていません。何も送信していません。\";\n    });\n    slot.querySelector('[data-action=\"deny\"]').addEventListener(\"click\", function () { slot.textContent = \"拒否しました。何も送信していません。\"; });\n  }\n  document.addEventListener(\"click\", function (ev) {\n    var t = ev.target.closest && ev.target.closest(\"[data-action]\");\n    if (!t) return;\n    var a = t.getAttribute(\"data-action\");\n    if (a === \"pin\") {\n      var p = pins(), id = t.getAttribute(\"data-app\"), k = p.indexOf(id);\n      if (k >= 0) p.splice(k, 1); else p.push(id);\n      put(\"itonami.dock\", JSON.stringify(p)); paintDock();\n    } else if (a === \"request\") request(t);\n  });\n  document.addEventListener(\"change\", function (ev) {\n    if (ev.target.getAttribute && ev.target.getAttribute(\"data-action\") === \"set-update-mode\") put(\"itonami.update.mode\", ev.target.value);\n  });\n  var mode = get(\"itonami.update.mode\") || \"notify\";\n  document.querySelectorAll('[data-action=\"set-update-mode\"]').forEach(function (r) { r.checked = r.value === mode; });\n  paintDock(); clock(); net(); setInterval(clock, 1000);\n  window.addEventListener(\"online\", net); window.addEventListener(\"offline\", net);\n  var bt = document.querySelector('[data-bind=\"bluetooth\"]');\n  if (bt) bt.textContent = \"Web Bluetooth: \" + (navigator.bluetooth ? \"利用可\" : \"利用不可\");\n  window.__itonamiAppIds = []; document.querySelectorAll(\"section.session-view[data-view]\").forEach(function (s) { window.__itonamiAppIds.push(s.id); });\n})();\n")
(defn js-2 [] :string "window.__aiueosSessionAlive = true;\nwindow.__aiueosSessionState = { bound: false };\nwindow.__aiueosUiEngine = \"kotoba-lang/browser\";\nwindow.__aiueosHostedAdapter = \"html-js-verification-only\";\n\nfunction viewId() {\n  var raw = location.hash || \"#desktop\";\n  var cut = raw.split(\"?\")[0];\n  if (cut === \"#\" || cut === \"#/\" || cut === \"\") return \"#desktop\";\n  if (cut.charAt(1) === \"/\") cut = \"#\" + cut.slice(2);\n  if (cut === \"#operator\") cut = \"#itonami\";\n  return cut;\n}\n\nfunction syncChrome(h) {\n  var links = document.querySelectorAll(\".session-nav a, .desktop-menu-link\");\n  for (var i = 0; i < links.length; i++) {\n    var a = links[i];\n    if ((a.getAttribute(\"href\") || \"\") === h) a.setAttribute(\"aria-current\", \"page\");\n    else a.removeAttribute(\"aria-current\");\n  }\n  var docks = document.querySelectorAll(\".dock-app\");\n  for (var j = 0; j < docks.length; j++) {\n    var d = docks[j];\n    if ((d.getAttribute(\"href\") || \"\") === h) d.className = \"dock-app is-active\";\n    else d.className = \"dock-app\";\n  }\n}\n\nfunction show() {\n  var h = viewId();\n  [\"desktop\", \"murakumo\", \"itonami\", \"yataverse\", \"aozora\", \"session\", \"compositor\", \"setup\", \"manage\", \"devices\"].concat(window.__itonamiAppIds || []).forEach(function (id) {\n    var el = document.getElementById(id);\n    if (el) el.hidden = (\"#\" + id) !== h;\n  });\n  syncChrome(h);\n  if (h === \"#manage\") refreshStatus();\n  if (h === \"#devices\") refreshDevices();\n  if (h === \"#setup\") refreshSetup();\n  if (h === \"#compositor\") refreshDesktop();\n  if (h === \"#session\") refreshGuest();\n  if (h === \"#itonami\") refreshOperator();\n}\n\nfunction pretty(x) {\n  try { return JSON.stringify(typeof x === \"string\" ? JSON.parse(x) : x, null, 2); }\n  catch (e) { return String(x); }\n}\n\nasync function refreshSetup() {\n  var el = document.getElementById(\"qr\");\n  if (!el) return;\n  try {\n    var r = await fetch(\"/setup.json\");\n    var j = await r.json();\n    el.textContent = j.qr || JSON.stringify(j, null, 2);\n  } catch (e) {\n    el.textContent = String(e);\n  }\n}\n\nasync function startDeviceAuth(method) {\n  var el = document.getElementById(\"auth-out\");\n  var approvalWindow = null;\n  if (method === \"passkey\") {\n    approvalWindow = window.open(\"about:blank\", \"aiueos-device-approval\");\n    if (approvalWindow) approvalWindow.opener = null;\n  }\n  if (el) el.textContent = \"単回チャレンジを準備しています…\";\n  try {\n    var r = await fetch(\"/api/device-auth/challenge\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ method: method })\n    });\n    var j = await r.json();\n    if (!r.ok || !j.verification_uri_complete) {\n      if (approvalWindow) approvalWindow.close();\n      if (el) el.textContent = pretty(j);\n      return;\n    }\n    var link = document.getElementById(\"device-auth-link\");\n    if (link) {\n      link.href = j.verification_uri_complete;\n      link.textContent = \"承認ページを開く\";\n      link.hidden = false;\n    }\n    if (method === \"phone-scan\" && j.scan_payload) {\n      var qr = document.getElementById(\"qr\");\n      var qrImage = document.getElementById(\"device-auth-qr\");\n      if (qr) qr.textContent = j.scan_payload;\n      if (qrImage) {\n        qrImage.src = \"/api/device-auth/qr?flow=\" + encodeURIComponent(j.flow_id);\n        qrImage.hidden = false;\n      }\n    }\n    if (method === \"passkey\") {\n      if (approvalWindow) approvalWindow.location.replace(j.verification_uri_complete);\n      else window.open(j.verification_uri_complete, \"_blank\", \"noopener,noreferrer\");\n    }\n    if (el) el.textContent = pretty(j);\n    window.__aiueosDeviceAuth = {\n      expiresAt: j.expires_at_ms,\n      interval: j.poll_interval_seconds || 2\n    };\n    scheduleDeviceAuthPoll(1);\n  } catch (e) {\n    if (approvalWindow) approvalWindow.close();\n    if (el) el.textContent = String(e);\n  }\n}\n\nfunction scheduleDeviceAuthPoll(seconds) {\n  if (window.__aiueosDeviceAuthTimer) {\n    clearTimeout(window.__aiueosDeviceAuthTimer);\n  }\n  window.__aiueosDeviceAuthTimer = setTimeout(pollDeviceAuth, seconds * 1000);\n}\n\nasync function pollDeviceAuth() {\n  var flow = window.__aiueosDeviceAuth;\n  var el = document.getElementById(\"auth-out\");\n  if (!flow) return;\n  if (Date.now() >= flow.expiresAt) {\n    window.__aiueosDeviceAuth = null;\n    if (el) el.textContent = \"承認の有効期限が切れました。もう一度始めてください。\";\n    return;\n  }\n  try {\n    var r = await fetch(\"/api/device-auth/complete\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: \"{}\"\n    });\n    var j = await r.json();\n    if (r.status === 202) {\n      if (el) el.textContent = \"Passkey の確認を待っています…\\n\" + pretty(j);\n      scheduleDeviceAuthPoll(j.interval || flow.interval || 2);\n      return;\n    }\n    window.__aiueosDeviceAuth = null;\n    if (el) el.textContent = pretty(j);\n    if (r.ok && j.decision === \"grant\") {\n      var qr = document.getElementById(\"qr\");\n      var qrImage = document.getElementById(\"device-auth-qr\");\n      var link = document.getElementById(\"device-auth-link\");\n      if (qr) qr.textContent = \"承認済み\";\n      if (qrImage) qrImage.hidden = true;\n      if (link) link.hidden = true;\n      refreshDevicePlan();\n      refreshStatus();\n      refreshDevices();\n    }\n  } catch (e) {\n    if (el) el.textContent = \"認証局への接続を再試行しています…\";\n    scheduleDeviceAuthPoll(flow.interval || 2);\n  }\n}\n\nasync function refreshDevicePlan() {\n  var el = document.getElementById(\"device-plan-out\");\n  if (!el) return;\n  try {\n    var r = await fetch(\"/api/device-auth/plan\");\n    el.textContent = pretty(await r.text());\n  } catch (e) {\n    el.textContent = String(e);\n  }\n}\n\nasync function refreshStatus() {\n  var el = document.getElementById(\"status\");\n  if (!el) return;\n  var r = await fetch(\"/api/status\");\n  el.textContent = await r.text();\n}\n\n\nfunction applyIme(j) {\n  var bar = document.getElementById(\"ime-bar\");\n  var pre = document.getElementById(\"ime-preedit\");\n  var buf = document.getElementById(\"ime-buf\");\n  var tog = document.getElementById(\"ime-toggle\");\n  var cands = document.getElementById(\"ime-candidates\");\n  if (!bar) return;\n  var on = j.on !== undefined ? j.on : j[\"on?\"];\n  bar.setAttribute(\"data-ime\", on ? \"on\" : \"off\");\n  if (pre) pre.textContent = j.preedit || \"\";\n  if (buf) buf.textContent = j.buf || \"\";\n  if (cands) cands.textContent = j.candidates || \"\";\n  if (tog) tog.textContent = on ? \"IME 切\" : \"IME 入\";\n}\n\nfunction bindImeOnce() {\n  if (window.__aiueosImeBound) return;\n  var stage = document.getElementById(\"wm-stage\");\n  var tog = document.getElementById(\"ime-toggle\");\n  window.__aiueosImeBound = true;\n  if (stage) {\n    stage.addEventListener(\"keydown\", function (ev) {\n      if (ev.metaKey || ev.ctrlKey || ev.altKey) return;\n      var k = ev.key;\n      if (!k) return;\n      if (k.length === 1 || k === \"Enter\" || k === \"Escape\" || k === \"Backspace\" || k === \" \") {\n        ev.preventDefault();\n        postKey(k === \" \" ? \"Space\" : k);\n      }\n    });\n  }\n  if (tog) {\n    tog.addEventListener(\"click\", function (ev) {\n      ev.preventDefault();\n      var bar = document.getElementById(\"ime-bar\");\n      var on = bar && bar.getAttribute(\"data-ime\") === \"on\";\n      postIme(!on);\n    });\n  }\n}\n\nfunction bindWmOnce() {\n  if (window.__aiueosWmBound) return;\n  var stage = document.getElementById(\"wm-stage\");\n  if (!stage) return;\n  window.__aiueosWmBound = true;\n  stage.addEventListener(\"click\", function (ev) {\n    var raiseEl = ev.target.closest(\"[data-raise]\");\n    if (raiseEl) {\n      ev.preventDefault();\n      postRaise(raiseEl.getAttribute(\"data-raise\"));\n      return;\n    }\n    if (ev.target.closest(\".wm-guest\")) {\n      var b = stage.getBoundingClientRect();\n      postPointer(Math.round(ev.clientX - b.left), Math.round(ev.clientY - b.top));\n    }\n  });\n}\n\nfunction applyWmWindows(j) {\n  var wins = j.windows || [];\n  wins.forEach(function (w) {\n    var el = document.getElementById(\"wm-window-\" + w.id);\n    if (!el) return;\n    var r = w.rect || {};\n    el.style.left = (r.x || 0) + \"px\";\n    el.style.top = (r.y || 0) + \"px\";\n    el.style.width = (r.w || 320) + \"px\";\n    el.style.height = (r.h || 240) + \"px\";\n    el.style.zIndex = String(w.z || 1);\n    var focused = !!w[\"focused?\"];\n    el.classList.toggle(\"is-focused\", focused);\n    var chip = el.querySelector(\".dads-chip-label\");\n    if (chip) chip.hidden = !focused;\n  });\n}\n\nasync function refreshDesktop() {\n  var el = document.getElementById(\"compositor-out\");\n  var input = document.getElementById(\"wm-input-out\");\n  bindWmOnce();\n  bindImeOnce();\n  try {\n    var r = await fetch(\"/api/compositor/desktop\");\n    var j = await r.json();\n    if (el) el.textContent = JSON.stringify(j, null, 2);\n    applyWmWindows(j);\n    applyIme(j);\n    presentKami(j[\"kami-ir\"] || j.kami_ir || j.kamiIr);\n    if (input && !input.dataset.wmTouched) {\n      input.textContent = pretty({\n        wm: j[\"wm?\"],\n        front: (j[\"z-stack\"] || [])[0],\n        focused: j.focused,\n        ime: j[\"ime-leftover\"],\n        on: j[\"on?\"],\n        preedit: j.preedit,\n        decoration: j.decoration\n      });\n    }\n  } catch (e) {\n    if (el) el.textContent = String(e);\n    if (input) input.textContent = String(e);\n  }\n}\n\nasync function postRaise(id) {\n  var input = document.getElementById(\"wm-input-out\");\n  try {\n    var r = await fetch(\"/api/compositor/raise\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ id: Number(id) })\n    });\n    var j = await r.json();\n    if (input) {\n      input.dataset.wmTouched = \"1\";\n      input.textContent = pretty(j);\n    }\n    await refreshDesktop();\n  } catch (e) {\n    if (input) input.textContent = String(e);\n  }\n}\n\nasync function postKey(key) {\n  var input = document.getElementById(\"wm-input-out\");\n  try {\n    var r = await fetch(\"/api/compositor/key\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ key: key })\n    });\n    var j = await r.json();\n    if (input) {\n      input.dataset.wmTouched = \"1\";\n      input.textContent = pretty(j);\n    }\n    applyIme(j);\n    await refreshDesktop();\n  } catch (e) {\n    if (input) input.textContent = String(e);\n  }\n}\n\nasync function postIme(on) {\n  var input = document.getElementById(\"wm-input-out\");\n  try {\n    var r = await fetch(\"/api/compositor/ime\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ \"on?\": !!on })\n    });\n    var j = await r.json();\n    if (input) {\n      input.dataset.wmTouched = \"1\";\n      input.textContent = pretty(j);\n    }\n    applyIme(j);\n    await refreshDesktop();\n  } catch (e) {\n    if (input) input.textContent = String(e);\n  }\n}\n\nasync function postPointer(x, y) {\n  var input = document.getElementById(\"wm-input-out\");\n  try {\n    var r = await fetch(\"/api/compositor/pointer\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ x: x, y: y })\n    });\n    var j = await r.json();\n    if (input) {\n      input.dataset.wmTouched = \"1\";\n      input.textContent = pretty(j);\n    }\n    await refreshDesktop();\n  } catch (e) {\n    if (input) input.textContent = String(e);\n  }\n}\n\nasync function presentKami(ir) {\n  var canvas = document.getElementById(\"kami-viewport\");\n  var out = document.getElementById(\"kami-out\");\n  if (!canvas || !out) return;\n  var present = window.aiueosKamiPresent;\n  if (typeof present !== \"function\") {\n    out.textContent = JSON.stringify({\n      outcome: \"refused\",\n      reason: \"clear-only-desktop\",\n      engine: \"kami.webgpu\",\n      note: \"beginRenderPass sky-clear is the named red. Executor is kami.webgpu init!/draw!.\"\n    }, null, 2);\n    canvas.setAttribute(\"data-backend\", \"clear-only\");\n    canvas.setAttribute(\"data-executor\", \"absent\");\n    return;\n  }\n  out.textContent = \"kami.webgpu init!…\";\n  try {\n    var result = await present(canvas, ir || {});\n    canvas.setAttribute(\"data-executor\", \"kami.webgpu\");\n    if (result && result.backend) {\n      canvas.setAttribute(\"data-backend\", result.backend);\n    }\n    out.textContent = JSON.stringify(result, null, 2);\n  } catch (e) {\n    canvas.setAttribute(\"data-backend\", \"error\");\n    canvas.setAttribute(\"data-executor\", \"kami.webgpu\");\n    out.textContent = JSON.stringify({\n      outcome: \"unmeasured\",\n      reason: String(e),\n      engine: \"kami.webgpu\"\n    }, null, 2);\n  }\n}\n\nasync function refreshDevices() {\n  var el = document.getElementById(\"devices-out\");\n  if (!el) return;\n  var r = await fetch(\"/api/devices\");\n  el.textContent = await r.text();\n  refreshDevicePlan();\n}\n\nasync function bind() {\n  var ch = await (await fetch(\"/api/challenge\", {\n    method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: \"{}\"\n  })).json();\n  var at = await (await fetch(\"/api/attest\", {\n    method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ nonce: ch.nonce })\n  })).json();\n  var body = JSON.stringify({\n    owner: document.getElementById(\"owner\").value,\n    nonce: ch.nonce,\n    signature: at.signature,\n    path: \"phone-http\"\n  });\n  var res = await fetch(\"/api/bind\", {\n    method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: body\n  });\n  var text = await res.text();\n  document.getElementById(\"bind-out\").textContent = text;\n  window.__aiueosSessionState.bound = res.ok;\n}\n\nasync function cycle() {\n  var res = await fetch(\"/api/power\", {\n    method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ action: \"cycle\" })\n  });\n  document.getElementById(\"cycle-out\").textContent = await res.text();\n  refreshStatus();\n}\n\nasync function readCid() {\n  var el = document.getElementById(\"cid-out\");\n  el.textContent = \"reading via session process…\";\n  var res = await fetch(\"/api/session/read-cid\", {\n    method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: \"{}\"\n  });\n  el.textContent = pretty(await res.text());\n}\n\nasync function runInfer() {\n  var el = document.getElementById(\"infer-out\");\n  el.textContent = \"inferring via session process (murakumo-main)…\";\n  var res = await fetch(\"/api/session/infer\", {\n    method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: \"{}\"\n  });\n  el.textContent = pretty(await res.text());\n}\n\nasync function runMurakumoApp() {\n  var el = document.getElementById(\"app-infer-out\");\n  if (el) el.textContent = \"murakumo-main へ推論を依頼しています…\";\n  try {\n    var res = await fetch(\"/api/session/infer\", {\n      method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: \"{}\"\n    });\n    if (el) el.textContent = pretty(await res.text());\n  } catch (e) {\n    if (el) el.textContent = String(e);\n  }\n}\n\n\nasync function refreshGuest() {\n  var el = document.getElementById(\"guest-out\");\n  var desk = document.getElementById(\"guest-desktop-out\");\n  try {\n    var r = await fetch(\"/api/session/guests\");\n    var text = await r.text();\n    var j = JSON.parse(text);\n    if (el) el.textContent = pretty(j);\n    if (desk) {\n      var g = (j.guests && j.guests[0]) || (j.refused && j.refused[0]) || j;\n      desk.textContent = pretty(g);\n    }\n    if (hSessionEmpty(j)) maybeAutostartGuest(j);\n  } catch (e) {\n    if (el) el.textContent = String(e);\n    if (desk) desk.textContent = String(e);\n  }\n}\n\nfunction hSessionEmpty(j) {\n  return j && j.count === 0 && (!j.guests || j.guests.length === 0)\n    && (!j.refused || j.refused.length === 0);\n}\n\nvar __aiueosGuestAutostarted = false;\nfunction maybeAutostartGuest(j) {\n  if (__aiueosGuestAutostarted) return;\n  if (viewId() !== \"#session\") return;\n  if (!hSessionEmpty(j)) return;\n  __aiueosGuestAutostarted = true;\n  postGuest(\"allow\");\n}\n\nasync function postGuest(grant) {\n  var el = document.getElementById(\"guest-out\");\n  if (el) el.textContent = \"asking grant for app/notes (\" + grant + \")…\";\n  var res = await fetch(\"/api/session/guest\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ grant: grant })\n  });\n  var text = await res.text();\n  if (el) el.textContent = pretty(text);\n  var desk = document.getElementById(\"guest-desktop-out\");\n  if (desk) desk.textContent = pretty(text);\n}\n\nasync function runGuest() { await postGuest(\"allow\"); }\nasync function denyGuest() { await postGuest(\"deny\"); }\n\nasync function refreshOperator() {\n  var el = document.getElementById(\"operator-out\");\n  if (!el) return;\n  try {\n    var r = await fetch(\"/api/session/operator\");\n    el.textContent = pretty(await r.text());\n  } catch (e) {\n    el.textContent = String(e);\n  }\n}\n\nasync function postOperator(grant) {\n  var el = document.getElementById(\"operator-out\");\n  if (el) el.textContent = \"asking operator grant (\" + grant + \") via process…\";\n  var res = await fetch(\"/api/session/operator\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ grant: grant })\n  });\n  if (el) el.textContent = pretty(await res.text());\n}\n\nasync function runOperator() { await postOperator(\"allow\"); }\nasync function denyOperator() { await postOperator(\"deny\"); }\n\nwindow.addEventListener(\"hashchange\", show);\ndocument.getElementById(\"bind\").addEventListener(\"click\", bind);\ndocument.getElementById(\"start-passkey\").addEventListener(\"click\", function () {\n  startDeviceAuth(\"passkey\");\n});\ndocument.getElementById(\"start-phone-scan\").addEventListener(\"click\", function () {\n  startDeviceAuth(\"phone-scan\");\n});\ndocument.getElementById(\"cycle\").addEventListener(\"click\", cycle);\ndocument.getElementById(\"read-cid\").addEventListener(\"click\", readCid);\ndocument.getElementById(\"run-infer\").addEventListener(\"click\", runInfer);\nvar appInfer = document.getElementById(\"app-run-infer\");\nif (appInfer) appInfer.addEventListener(\"click\", runMurakumoApp);\ndocument.getElementById(\"run-guest\").addEventListener(\"click\", runGuest);\ndocument.getElementById(\"deny-guest\").addEventListener(\"click\", denyGuest);\nvar runOp = document.getElementById(\"run-operator\");\nvar denyOp = document.getElementById(\"deny-operator\");\nif (runOp) runOp.addEventListener(\"click\", runOperator);\nif (denyOp) denyOp.addEventListener(\"click\", denyOperator);\nshow();\nrefreshSetup();\n")
(defn js-3 [] :string "/* Torihiki app of the hosted session (JUN-822): devnet / demo only.\n\n   Runs in the user's browser and talks straight to the node endpoint the user\n   typed. It has no default endpoint, sends nothing until the user approves the\n   displayed operation, and signs nothing unless the node says its chain id is a\n   devnet. A denial sends nothing; redirects are refused.\n\n   The signing payload and the account id derivation are the engine's own\n   (torihiki.auth/signing-payload, torihiki.address/derive), written out here\n   because this page has no engine. They are checked against vectors the engine\n   produced (test/session/torihiki-vectors.json, scripts/session-torihiki-test.js);\n   a node whose payload has a different number of fields rejects every signature\n   as bad-signature, so FIELDS below must follow the node's engine version. */\n(function () {\n  \"use strict\";\n\n  var FIELDS = 37; // f0 .. f36 of torihiki.auth/tx-fields at the vectors' engine version\n  var FLOOR = 100000, SPACE = 35184372088832; // torihiki.address\n  var enc = new TextEncoder();\n\n  function b64(buf) {\n    var a = new Uint8Array(buf), s = \"\";\n    for (var i = 0; i < a.length; i++) s += String.fromCharCode(a[i]);\n    return btoa(s);\n  }\n\n  // torihiki.address/derive: the first six bytes of SHA-256 over the base64 text of the key.\n  function deriveAccount(pubB64) {\n    return crypto.subtle.digest(\"SHA-256\", enc.encode(pubB64)).then(function (d) {\n      var b = new Uint8Array(d), acc = 0;\n      for (var i = 0; i < 6; i++) acc = acc * 256 + b[i];\n      return FLOOR + (acc % SPACE);\n    });\n  }\n\n  // torihiki.auth/signing-payload for the transactions this page builds.\n  // Positions: f0 tx, f1 market, f2 side (keyword, so \":buy\"), f3 level, f4 qty, f5 flags, f6 oid.\n  function signingPayload(chain, account, nonce, tx) {\n    var f = [];\n    for (var i = 0; i < FIELDS; i++) f.push(\"\");\n    f[0] = tx.tx;\n    f[1] = tx.market === undefined ? \"\" : String(tx.market);\n    if (tx.side !== undefined) f[2] = \":\" + tx.side;\n    if (tx.level !== undefined) f[3] = String(tx.level);\n    if (tx.qty !== undefined) f[4] = String(tx.qty);\n    if (tx.flags !== undefined) f[5] = String(tx.flags);\n    if (tx.oid !== undefined) f[6] = String(tx.oid);\n    return \"torihiki/tx/v1\\nchain=\" + chain + \"\\naccount=\" + account + \"\\nnonce=\" + nonce + \"\\n\" +\n      f.map(function (v, i) { return \"f\" + i + \"=\" + v; }).join(\"\\n\") + \"\\n\";\n  }\n\n  function signEnvelope(priv, pubB64, chain, account, nonce, tx) {\n    return crypto.subtle.sign({ name: \"Ed25519\" }, priv, enc.encode(signingPayload(chain, account, nonce, tx)))\n      .then(function (sig) { return { tx: tx, account: account, nonce: nonce, pubkey: pubB64, sig: b64(sig) }; });\n  }\n\n  // Only https, or http on this machine. Returns the origin, or null.\n  function endpointOrigin(text) {\n    var u;\n    try { u = new URL(String(text || \"\").trim()); } catch (e) { return null; }\n    var local = u.hostname === \"localhost\" || u.hostname === \"127.0.0.1\" || u.hostname === \"[::1]\";\n    if (u.protocol === \"https:\" || (u.protocol === \"http:\" && local)) return u.origin;\n    return null;\n  }\n\n  function isDevnet(chainId) { return typeof chainId === \"string\" && /devnet/i.test(chainId); }\n\n  // --- pure view models (no DOM; tested in scripts/session-torihiki-test.js) ----\n  // torihiki-chart.candle shape: { h, open, high, low, close, volume }, ticks and lots as integers.\n  function rebucket(span, candles) {\n    var out = [], cur = null;\n    (candles || []).forEach(function (c) {\n      var b = Math.floor(c.h / span) * span;\n      if (cur && cur.h === b) {\n        cur.high = Math.max(cur.high, c.high); cur.low = Math.min(cur.low, c.low);\n        cur.close = c.close; cur.volume += c.volume;\n      } else {\n        cur = { h: b, open: c.open, high: c.high, low: c.low, close: c.close, volume: c.volume };\n        out.push(cur);\n      }\n    });\n    return out;\n  }\n  // Geometry of the candle chart inside a W x H viewBox; empty data gives {empty:true}.\n  function chartModel(cs, o) {\n    o = o || {};\n    var W = o.width || 640, H = o.height || 300, padR = 56, top = 10, priceH = 200, volTop = 220, volH = 58;\n    cs = (cs || []).slice(-(o.max || 120));\n    if (!cs.length) return { empty: true, width: W, height: H };\n    var lo = Infinity, hi = -Infinity, vmax = 0;\n    cs.forEach(function (c) { lo = Math.min(lo, c.low); hi = Math.max(hi, c.high); vmax = Math.max(vmax, c.volume); });\n    if (hi === lo) { hi += 1; lo -= 1; }\n    var pad = (hi - lo) * 0.05; hi += pad; lo -= pad;\n    var plotW = W - padR - 8, step = plotW / cs.length, bw = Math.max(1, Math.min(14, step * 0.7));\n    function y(v) { return top + (hi - v) / (hi - lo) * priceH; }\n    var candles = cs.map(function (c, i) {\n      var cx = 8 + step * (i + 0.5), up = c.close >= c.open;\n      var yo = y(c.open), yc = y(c.close);\n      return { h: c.h, x: cx, w: bw, up: up, yHigh: y(c.high), yLow: y(c.low), yTop: Math.min(yo, yc), bodyH: Math.max(1, Math.abs(yo - yc)),\n               volY: volTop + volH - (vmax ? c.volume / vmax * volH : 0), volH: vmax ? c.volume / vmax * volH : 0 };\n    });\n    var yTicks = [];\n    for (var i = 0; i <= 4; i++) { var v = lo + (hi - lo) * i / 4; yTicks.push({ y: y(v), label: String(Math.round(v)) }); }\n    var xTicks = [], every = Math.max(1, Math.ceil(cs.length / 6));\n    for (var j = 0; j < cs.length; j += every) xTicks.push({ x: candles[j].x, label: String(cs[j].h) });\n    var last = cs[cs.length - 1].close;\n    return { empty: false, width: W, height: H, plotRight: W - padR, candles: candles, yTicks: yTicks, xTicks: xTicks,\n             lastY: y(last), lastLabel: String(last), volTop: volTop, volBottom: volTop + volH };\n  }\n  // Order book rows: nearest the touch first (as the node sends them); bars scaled by cumulative size.\n  function bookModel(book) {\n    var bids = (book && book.bids) || [], asks = (book && book.asks) || [];\n    var max = 0;\n    bids.concat(asks).forEach(function (r) { max = Math.max(max, r.cum || r.qty || 0); });\n    function rows(list) { return list.map(function (r) { return { level: r.level, qty: r.qty, cum: r.cum, pct: max ? Math.round((r.cum || r.qty) / max * 100) : 0 }; }); }\n    var bestBid = bids.length ? bids[0].level : null, bestAsk = asks.length ? asks[0].level : null;\n    return { bids: rows(bids), asks: rows(asks).reverse(), bestBid: bestBid, bestAsk: bestAsk,\n             spread: bestBid !== null && bestAsk !== null ? bestAsk - bestBid : null,\n             mid: bestBid !== null && bestAsk !== null ? (bestAsk + bestBid) / 2 : null };\n  }\n\n  var api = { FIELDS: FIELDS, deriveAccount: deriveAccount, signingPayload: signingPayload,\n              signEnvelope: signEnvelope, rebucket: rebucket, chartModel: chartModel, bookModel: bookModel, endpointOrigin: endpointOrigin, isDevnet: isDevnet };\n  if (typeof module !== \"undefined\" && module.exports) { module.exports = api; return; }\n\n  var root = document.getElementById(\"torihiki\");\n  if (!root) return;\n  function $(sel) { return root.querySelector(sel); }\n  function $$(sel) { return Array.prototype.slice.call(root.querySelectorAll(sel)); }\n  function slot(name) { return $('[data-slot=\"' + name + '\"]'); }\n  function say(text) { slot(\"tk-result\").textContent = text; }\n  function bindTk(name, text) { $$('[data-bind=\"' + name + '\"]').forEach(function (n) { n.textContent = text; }); }\n  function get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }\n  function put(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }\n  function el(tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text !== undefined) n.textContent = text; return n; }\n  var SVGNS = \"http://www.w3.org/2000/svg\";\n  function svg(tag, attrs, text) {\n    var n = document.createElementNS(SVGNS, tag);\n    Object.keys(attrs || {}).forEach(function (k) { n.setAttribute(k, attrs[k]); });\n    if (text !== undefined) n.textContent = text;\n    return n;\n  }\n\n  // --- session key: non-extractable Ed25519 in IndexedDB --------------------\n  function idb() {\n    return new Promise(function (ok, no) {\n      var r = indexedDB.open(\"itonami-torihiki\", 1);\n      r.onupgradeneeded = function () { r.result.createObjectStore(\"keys\"); };\n      r.onsuccess = function () { ok(r.result); };\n      r.onerror = function () { no(r.error); };\n    });\n  }\n  function idbGet(db, k) {\n    return new Promise(function (ok, no) {\n      var q = db.transaction(\"keys\").objectStore(\"keys\").get(k);\n      q.onsuccess = function () { ok(q.result); }; q.onerror = function () { no(q.error); };\n    });\n  }\n  function idbPut(db, k, v) {\n    return new Promise(function (ok, no) {\n      var t = db.transaction(\"keys\", \"readwrite\"); t.objectStore(\"keys\").put(v, k);\n      t.oncomplete = function () { ok(); }; t.onerror = function () { no(t.error); };\n    });\n  }\n  var session = null;\n  function loadSession(create) {\n    if (session) return Promise.resolve(session);\n    return idb().then(function (db) {\n      return idbGet(db, \"session-v1\").then(function (rec) {\n        if (rec) return rec;\n        if (!create) return null;\n        return crypto.subtle.generateKey({ name: \"Ed25519\" }, false, [\"sign\", \"verify\"]).then(function (kp) {\n          return crypto.subtle.exportKey(\"raw\", kp.publicKey).then(function (raw) {\n            var made = { priv: kp.privateKey, pub: b64(raw) };\n            return idbPut(db, \"session-v1\", made).then(function () { return made; });\n          });\n        });\n      });\n    }).then(function (rec) {\n      if (!rec) return null;\n      return deriveAccount(rec.pub).then(function (acc) { session = { priv: rec.priv, pub: rec.pub, account: acc }; return session; });\n    });\n  }\n  function showSession(chain) {\n    var lines = [];\n    lines.push(session ? \"セッション鍵: \" + session.pub.slice(0, 12) + \"…\\nアカウント: \" + session.account : \"セッション鍵: まだありません（最初の操作で端末内に作ります）\");\n    lines.push(\"鍵は端末の外に出ません。ウォレットではなく、devnet 専用の使い捨てです。\");\n    if (chain) lines.push(\"チェーン: \" + chain);\n    bindTk(\"tk-session\", lines.join(\"\\n\"));\n  }\n\n  // --- consent ---------------------------------------------------------------\n  var busy = false, live = null;\n  function approve(title, detail) {\n    return new Promise(function (resolve) {\n      var host = slot(\"tk-approval\"), tpl = document.getElementById(\"dapp-approval\");\n      if (!host || !tpl) { resolve(false); return; }\n      host.textContent = \"\"; host.appendChild(tpl.content.cloneNode(true));\n      var t = host.querySelector('[data-bind=\"approval-title\"]'), d = host.querySelector('[data-bind=\"approval-detail\"]');\n      t.textContent = title; d.textContent = detail; d.style.whiteSpace = \"pre-line\";\n      function done(v) { host.textContent = \"\"; resolve(v); }\n      host.querySelector('[data-action=\"approve\"]').addEventListener(\"click\", function () { done(true); });\n      host.querySelector('[data-action=\"deny\"]').addEventListener(\"click\", function () { done(false); });\n      host.scrollIntoView({ block: \"nearest\" });\n    });\n  }\n\n  // --- requests --------------------------------------------------------------\n  function call(origin, path, opts) {\n    var ctl = new AbortController(), timer = setTimeout(function () { ctl.abort(); }, 10000);\n    var init = { method: (opts && opts.method) || \"GET\", credentials: \"omit\", cache: \"no-store\", redirect: \"error\", signal: ctl.signal };\n    if (opts && opts.body !== undefined) { init.body = JSON.stringify(opts.body); init.headers = { \"content-type\": \"application/json\" }; }\n    return fetch(origin + path, init).then(function (r) {\n      return r.text().then(function (txt) {\n        var j; try { j = JSON.parse(txt); } catch (e) { j = { raw: txt.slice(0, 200) }; }\n        return { status: r.status, json: j };\n      });\n    }).finally(function () { clearTimeout(timer); });\n  }\n  function head(origin) {\n    return call(origin, \"/head\").then(function (r) {\n      var chain = r.json && r.json[\"chain-id\"];\n      if (!isDevnet(chain)) throw new Error(\"このノードのチェーン id は devnet ではありません（\" + chain + \"）。何も署名せず、何も送っていません。\");\n      showSession(chain);\n      return { chain: chain, height: r.json.height };\n    });\n  }\n  function pretty(j) { try { return JSON.stringify(j, null, 2); } catch (e) { return String(j); } }\n  function intField(sel, min) {\n    var e = $(sel), v = e ? e.value.trim() : \"\";\n    if (!/^\\d+$/.test(v) || Number(v) < min || Number(v) > Number.MAX_SAFE_INTEGER) return null;\n    return Number(v);\n  }\n  function currentOrigin() { return endpointOrigin(($(\"#tk-endpoint\") || {}).value); }\n  var BADURL = \"接続先は https のアドレス（この端末の http://localhost も可）で入力してください。何も送っていません。\";\n\n  // --- screens ---------------------------------------------------------------\n  var state = { side: \"buy\", span: 5, candles: [], market: 1 };\n  function fmt(n) { return n === null || n === undefined ? \"—\" : String(n); }\n\n  function renderBook(book) {\n    var m = bookModel(book);\n    function fill(id, rows) {\n      var c = $(id); c.textContent = \"\";\n      if (!rows.length) { c.appendChild(el(\"div\", \"tk-empty\", \"注文がありません\")); return; }\n      rows.forEach(function (r) {\n        var row = el(\"div\", \"tk-row\"), bar = el(\"i\");\n        bar.style.width = r.pct + \"%\";\n        row.appendChild(bar); row.appendChild(el(\"span\", \"\", String(r.level))); row.appendChild(el(\"span\", \"\", String(r.qty))); row.appendChild(el(\"span\", \"\", String(r.cum)));\n        row.setAttribute(\"data-level\", String(r.level)); row.title = \"価格欄に入れる\";\n        c.appendChild(row);\n      });\n    }\n    fill(\"#tk-asks\", m.asks); fill(\"#tk-bids\", m.bids);\n    $(\"#tk-mid\").textContent = m.mid === null ? \"—\" : String(m.mid) + (m.spread !== null ? \"（スプレッド \" + m.spread + \"）\" : \"\");\n    bindTk(\"tk-spread\", m.spread === null ? \"—\" : String(m.spread));\n  }\n  function renderTrades(t) {\n    var c = $(\"#tk-trades\"); c.textContent = \"\";\n    var list = (t && t.trades) || [];\n    if (!list.length) { c.appendChild(el(\"div\", \"tk-empty\", \"約定がありません\")); return; }\n    list.slice(0, 14).forEach(function (x) {\n      var row = el(\"div\", \"tk-row\");\n      row.appendChild(el(\"span\", x.side === 0 ? \"tk-buy-px\" : \"tk-sell-px\", String(x.level)));\n      row.appendChild(el(\"span\", \"\", String(x.qty))); row.appendChild(el(\"span\", \"\", String(x.h)));\n      c.appendChild(row);\n    });\n    bindTk(\"tk-last\", String(list[0].level));\n  }\n  function renderChart() {\n    var host = $(\"#tk-chart\"); host.textContent = \"\";\n    var m = chartModel(rebucket(state.span, state.candles));\n    if (m.empty) { host.appendChild(el(\"div\", \"tk-empty\", \"ローソク足がありません。ライブ表示を始めると、ノードの約定履歴から描きます。\")); return; }\n    var s = svg(\"svg\", { viewBox: \"0 0 \" + m.width + \" \" + m.height, preserveAspectRatio: \"xMidYMid meet\" });\n    m.yTicks.forEach(function (t) {\n      s.appendChild(svg(\"line\", { x1: 8, x2: m.plotRight, y1: t.y, y2: t.y, \"class\": \"grid\" }));\n      if (Math.abs(t.y - m.lastY) > 12) s.appendChild(svg(\"text\", { x: m.plotRight + 6, y: t.y + 4 }, t.label));\n    });\n    m.candles.forEach(function (c) {\n      var cls = c.up ? \"up\" : \"down\";\n      s.appendChild(svg(\"line\", { x1: c.x, x2: c.x, y1: c.yHigh, y2: c.yLow, \"class\": cls }));\n      s.appendChild(svg(\"rect\", { x: c.x - c.w / 2, y: c.yTop, width: c.w, height: c.bodyH, \"class\": cls }));\n      s.appendChild(svg(\"rect\", { x: c.x - c.w / 2, y: c.volY, width: c.w, height: c.volH, \"class\": cls + \" vol\" }));\n    });\n    s.appendChild(svg(\"line\", { x1: 8, x2: m.plotRight, y1: m.lastY, y2: m.lastY, \"class\": \"last\" }));\n    s.appendChild(svg(\"text\", { x: m.plotRight + 6, y: m.lastY - 4 }, m.lastLabel));\n    m.xTicks.forEach(function (t) { s.appendChild(svg(\"text\", { x: t.x, y: m.height - 2, \"text-anchor\": \"middle\" }, t.label)); });\n    host.appendChild(s);\n  }\n  function renderAccount(a) {\n    var c = $(\"#tk-positions\"); c.textContent = \"\";\n    function kv(k, v) { c.appendChild(el(\"span\", \"\", k)); c.appendChild(el(\"b\", \"\", v)); }\n    kv(\"アカウント\", fmt(a.account)); kv(\"担保（cents）\", fmt(a.collateral)); kv(\"エクイティ\", fmt(a.equity));\n    kv(\"使える担保\", fmt(a[\"free-collateral\"])); kv(\"次の nonce\", fmt(a[\"next-nonce\"]));\n    var pos = a.positions || {}, ks = Object.keys(pos);\n    if (!ks.length) kv(\"ポジション\", \"なし\");\n    ks.forEach(function (k) { var p = pos[k]; kv(\"市場 \" + k + \" \" + (p.size >= 0 ? \"ロング\" : \"ショート\"), p.size + \" lot @ \" + p.entry + \"（含み \" + p.unrealized + \"）\"); });\n  }\n  function setSide(side) {\n    state.side = side;\n    $$(\"[data-tk-side]\").forEach(function (b) { b.setAttribute(\"aria-pressed\", b.getAttribute(\"data-tk-side\") === side ? \"true\" : \"false\"); });\n    var b = $(\"#tk-submit\"); b.className = \"tk-submit \" + (side === \"buy\" ? \"tk-submit-buy\" : \"tk-submit-sell\");\n    b.textContent = side === \"buy\" ? \"買い注文を送る\" : \"売り注文を送る\";\n  }\n  function showTab(id) {\n    $$(\"[data-tk-panel]\").forEach(function (p) { p.hidden = p.getAttribute(\"data-tk-panel\") !== id; });\n    $$(\"[data-tk-tab]\").forEach(function (t) { t.setAttribute(\"aria-selected\", t.getAttribute(\"data-tk-tab\") === id ? \"true\" : \"false\"); });\n    if (id === \"chart\") renderChart();\n  }\n  function setStatus(text, on) { var n = $('[data-bind=\"tk-status\"]'); n.textContent = text; n.setAttribute(\"data-live\", on ? \"1\" : \"0\"); }\n\n  // --- the live view: one approved operation, bounded ------------------------\n  var LIVE_EVERY_MS = 3000, LIVE_MAX = 20;\n  function stopLive(why) {\n    if (live) { clearTimeout(live.timer); live = null; }\n    setStatus(why || \"停止中\", false);\n  }\n  function liveRound(origin, m, n) {\n    return head(origin).then(function (h) {\n      bindTk(\"tk-height\", String(h.height));\n      return Promise.all([call(origin, \"/market?id=\" + m), call(origin, \"/book?market=\" + m + \"&depth=10\"),\n                          call(origin, \"/trades?n=14\"), call(origin, \"/candles?span=1&n=300\")]);\n    }).then(function (rs) {\n      var mk = rs[0].json || {};\n      bindTk(\"tk-symbol\", mk.symbol || (\"市場 \" + m));\n      renderBook(rs[1].json); renderTrades(rs[2].json);\n      state.candles = (rs[3].json && rs[3].json.candles) || [];\n      if ($('[data-tk-panel=\"chart\"]').hidden === false) renderChart();\n      setStatus(\"ライブ \" + n + \"/\" + LIVE_MAX, true);\n    });\n  }\n  function startLive() {\n    if (live || busy) { say(\"すでに実行中です。\"); return; }\n    var origin = currentOrigin();\n    if (!origin) { say(BADURL); return; }\n    var m = intField(\"#tk-market\", 1); if (m === null) { say(\"市場 id は 1 以上の整数です。\"); return; }\n    put(\"itonami.torihiki.endpoint\", origin); state.market = m;\n    busy = true;\n    approve(\"承認が必要です: read-quotes（ライブ表示）\",\n      \"サービス: Torihiki devnet\\nエンドポイント: \" + origin + \"\\n操作: read-quotes\\nリクエスト: GET /head, GET /market?id=\" + m + \", GET /book?market=\" + m + \"&depth=10, GET /trades?n=14, GET /candles?span=1&n=300\\n\" +\n      \"回数: \" + LIVE_EVERY_MS / 1000 + \" 秒ごとに最大 \" + LIVE_MAX + \" 回（約 \" + LIVE_EVERY_MS * LIVE_MAX / 1000 + \" 秒）。停止ボタンでいつでも止められます。上限に達すると自動で止まり、続けるには再度承認が要ります。\\n送るデータ: 市場 id \" + m + \"\\n注意: devnet のみ。実資金は扱いません。\")\n      .then(function (ok) {\n        busy = false;\n        if (!ok) { say(\"拒否しました。何も送信していません。\"); return; }\n        var n = 0; live = { timer: null };\n        (function tick() {\n          if (!live) return;\n          n++;\n          liveRound(origin, m, n).then(function () {\n            if (!live) return;\n            if (n >= LIVE_MAX) { stopLive(\"上限に達したので停止しました\"); return; }\n            live.timer = setTimeout(tick, LIVE_EVERY_MS);\n          }).catch(function (e) { stopLive(\"停止しました\"); say(\"ライブ表示を止めました: \" + (e && e.message ? e.message : e)); });\n        })();\n      });\n  }\n\n  // --- one-shot operations ---------------------------------------------------\n  function execute(plan) {\n    if (busy) { say(\"ほかの操作を実行中です。\"); return; }\n    var origin = currentOrigin();\n    if (!origin) { say(BADURL); return; }\n    put(\"itonami.torihiki.endpoint\", origin);\n    busy = true;\n    loadSession(!!plan.needsKey).then(function () {\n      if (plan.needsKey && !session) throw new Error(\"セッション鍵を作れませんでした。\");\n      showSession();\n      var detail = \"サービス: Torihiki devnet\\nエンドポイント: \" + origin + \"\\n操作: \" + plan.op +\n        \"\\nリクエスト: \" + plan.requests(session).join(\", \") + \"\\n送るデータ: \" + plan.data(session) +\n        \"\\n注意: devnet のみ。実資金は扱いません。\";\n      return approve(\"承認が必要です: \" + plan.op, detail);\n    }).then(function (ok) {\n      if (!ok) { say(\"拒否しました。何も送信していません。\"); return null; }\n      return plan.run(origin).then(function (text) { say(text); });\n    }).catch(function (e) {\n      say(\"失敗しました: \" + (e && e.message ? e.message : e));\n    }).finally(function () { busy = false; });\n  }\n  var PLANS = {\n    \"account\": function () {\n      return { op: \"read-account\", needsKey: true,\n        requests: function () { return [\"GET /head\", \"GET /account?id=\" + session.account]; },\n        data: function () { return \"アカウント id \" + session.account; },\n        run: function (origin) {\n          return head(origin).then(function () { return call(origin, \"/account?id=\" + session.account); })\n            .then(function (r) { renderAccount(r.json || {}); return \"口座を読みました (HTTP \" + r.status + \")。「取引」タブの『ポジションと口座』に表示しています。\"; });\n        } };\n    },\n    \"faucet\": function () {\n      return { op: \"request-devnet-funds\", needsKey: true,\n        requests: function () { return [\"GET /head\", \"POST /faucet\"]; },\n        data: function () { return \"アカウント id \" + session.account; },\n        run: function (origin) {\n          return head(origin).then(function () { return call(origin, \"/faucet\", { method: \"POST\", body: { account: session.account } }); })\n            .then(function (r) { return \"devnet 資金の請求 (HTTP \" + r.status + \"):\\n\" + pretty(r.json); });\n        } };\n    },\n    \"submit\": function () {\n      var m = intField(\"#tk-market\", 1), level = intField(\"#tk-price\", 1), qty = intField(\"#tk-size\", 1);\n      if (m === null || level === null || qty === null) { say(\"市場 id・価格（tick）・数量（lot）は 1 以上の整数です。\"); return null; }\n      var flags = ($(\"#tk-post\").checked ? 1 : 0) | ($(\"#tk-ioc\").checked ? 2 : 0) | ($(\"#tk-ro\").checked ? 4 : 0);\n      var side = state.side;\n      return submitPlan({ tx: \"order\", market: m, side: side, level: level, qty: qty, flags: flags },\n        \"注文 \" + (side === \"buy\" ? \"買い\" : \"売り\") + \" 市場 \" + m + \" 価格 \" + level + \" tick 数量 \" + qty + \" lot フラグ \" + flags);\n    },\n    \"cancel-all\": function () {\n      var m = intField(\"#tk-market\", 1); if (m === null) { say(\"市場 id は 1 以上の整数です。\"); return null; }\n      return submitPlan({ tx: \"cancel-all\", market: m }, \"全注文の取消 市場 \" + m);\n    }\n  };\n  function submitPlan(t, label) {\n    return { op: \"submit-order\", needsKey: true,\n      requests: function () { return [\"GET /head\", \"GET /account?id=\" + session.account, \"POST /tx\"]; },\n      data: function () { return label + \"、公開鍵 \" + session.pub.slice(0, 12) + \"…、署名\"; },\n      run: function (origin) {\n        var chain;\n        return head(origin).then(function (h) { chain = h.chain; return call(origin, \"/account?id=\" + session.account); })\n          .then(function (a) {\n            var nonce = (a.json && a.json[\"next-nonce\"]) || 1;\n            return signEnvelope(session.priv, session.pub, chain, session.account, nonce, t);\n          })\n          .then(function (env) { return call(origin, \"/tx\", { method: \"POST\", body: env }); })\n          .then(function (r) { return label + \"\\nノードの返答 (HTTP \" + r.status + \"):\\n\" + pretty(r.json); });\n      } };\n  }\n\n  root.addEventListener(\"click\", function (ev) {\n    var t = ev.target.closest && ev.target.closest(\"[data-tk-tab]\");\n    if (t) { showTab(t.getAttribute(\"data-tk-tab\")); return; }\n    var sd = ev.target.closest && ev.target.closest(\"[data-tk-side]\");\n    if (sd) { setSide(sd.getAttribute(\"data-tk-side\")); return; }\n    var sp = ev.target.closest && ev.target.closest(\"[data-tk-span]\");\n    if (sp) {\n      state.span = Number(sp.getAttribute(\"data-tk-span\"));\n      $$(\"[data-tk-span]\").forEach(function (b) { b.setAttribute(\"aria-pressed\", b === sp ? \"true\" : \"false\"); });\n      renderChart(); return;\n    }\n    var row = ev.target.closest && ev.target.closest(\".tk-row[data-level]\");\n    if (row) { $(\"#tk-price\").value = row.getAttribute(\"data-level\"); return; }\n    var b = ev.target.closest && ev.target.closest(\"[data-tk]\");\n    if (!b) return;\n    var k = b.getAttribute(\"data-tk\");\n    if (k === \"save-endpoint\") {\n      var o = currentOrigin();\n      if (!o) { say(BADURL); return; }\n      put(\"itonami.torihiki.endpoint\", o); $(\"#tk-endpoint\").value = o; say(\"接続先を保存しました（この端末のみ。何も送っていません）: \" + o); return;\n    }\n    if (k === \"live-start\") { startLive(); return; }\n    if (k === \"live-stop\") { if (live) { stopLive(\"停止しました\"); say(\"ライブ表示を止めました。\"); } return; }\n    var plan = PLANS[k] ? PLANS[k]() : null;\n    if (plan) execute(plan);\n  });\n\n  var saved = get(\"itonami.torihiki.endpoint\");\n  if (saved && $(\"#tk-endpoint\")) $(\"#tk-endpoint\").value = saved;\n  setSide(\"buy\"); showTab(\"trade\"); renderBook(null); renderTrades(null);\n  if (!(window.crypto && crypto.subtle && window.indexedDB)) {\n    say(\"このブラウザは Ed25519 の署名か IndexedDB に未対応です。注文は送れません。\");\n  }\n  loadSession(false).then(function () { showSession(); }).catch(function () { showSession(); });\n})();\n")

;; --- page ------------------------------------------------------------------
(defn app-btn [id :string label :string] :string (doc-html (u/action-button id label "solid-fill")))
(defn note [t :string] :string (doc-html (u/note-line t)))

;; Murakumo, Itonami, Yataverse and Aozora are per-app UI documents (session/apps/<id>.kotoba, named by the records' ui.document).
(defn murakumo-window [] :string (am/ui-document))

(defn yataverse-window [] :string (a3/ui-document))
(defn aozora-window [] :string (a4/ui-document))

(defn code [t :string] :string (doc-html (u/code-span t)))
(defn rich [html :string] :string (doc-html (u/rich-line html)))
(defn lede [html :string] :string (doc-html (u/lede-line html)))
(defn card-of [body :string] :string (doc-html (u/ext-card body)))
(defn view [id :string hide :bool body :string] :string (doc-html (u/view-section id hide body)))
(defn out-id [id :string] :string (doc-html (u/out-pre id "")))
(defn k-btn [id :string label :string action :string] :string (doc-html (u/kotoba-button id label action)))

;; Remaining session views on the shared view / card / button / output components.
(defn itonami-view [] :string (ai/ui-document))

(defn session-view [] :string
  (view "session" false
    (string-join "" (heading 1 "今日のシェル")
      (lede (string-join "" (txt "ホストされた aiueos セッションです。CID は ") (code "https://kotobase.net") (txt " から、推論は ") (code "murakumo-main") (txt " 経由で、この文書のボタンがセッション過程に頼んで動かします。 `kbb -M:cloud-live check` は別の CLI で、この gate ではありません。")))
      (card-of (string-join "" (heading 2 "kotobase を読む")
        (note "既定 CID は空バイト列の raw CIDv1。ゲートウェイが 200 と 0 バイトを返し、セッションがハッシュを CID と突き合わせます。")
        (app-btn "read-cid" "CID を読む")
        (out-id "cid-out")))
      (card-of (string-join "" (heading 2 "murakumo で推論する")
        (rich (string-join "" (txt "モデル id は焼きません。alias は ") (code "murakumo-main") (txt "。POST はセッション過程が ") (code "infer.murakumo.cloud") (txt " へ送ります。")))
        (app-btn "run-infer" "推論する")
        (out-id "infer-out")))
      (card-of (string-join "" (heading 2 "notes guest")
        (rich (string-join "" (txt "Kotoba guest ") (code "app/notes") (txt " は grant を通ったときだけこのシェルに現れます。 拒否は ") (code "unresolved-capability") (txt " など grant の理由で、汎用 500 ではありません。")))
        (app-btn "run-guest" "grant して走らせる")
        (app-btn "deny-guest" "grant を拒否する")
        (out-id "guest-out"))))))

(defn setup-view [] :string
  (view "setup" true
    (string-join "" (heading 1 "この機械を追加")
      (lede (txt "Passkey をこの画面で使うか、スマホでコードを読み取ります。どちらも同じアカウント確認を通り、Passkey の秘密鍵は Node へコピーしません。"))
      (card-of (string-join "" (heading 2 "Passkey で続ける")
        (rich (string-join "" (txt "この機械の Kotoba Browser から、") (code "auth.kotoba.cloud") (txt " の Passkey を確認します。")))
        (k-btn "start-passkey" "Passkey で確認" "device-auth/start-passkey")))
      (card-of (string-join "" (heading 2 "スマホで続ける")
        (note "スマホ側でも Passkey を確認してから、この機械を承認します。表示する承認URLにアカウント鍵や端末トークンは含めません。")
        (doc-html (u/qr-image "device-auth-qr" "AIUEOSの端末承認ページを開くQRコード"))
        (out-id "qr")
        (doc-html (u/link-out "device-auth-link" "承認ページを開く"))
        (k-btn "start-phone-scan" "スマホ用コードを準備" "device-auth/start-phone-scan")))
      (doc-html (u/out-pre "auth-out" "polite"))
      (doc-html (u/details-box "hosted 検証用"
        (string-join "" (lede (txt "現在の Mac/QEMU fixture を検証するための非権威経路です。実機の OS アカウント認証には数えません。"))
          (doc-html (u/input-field "owner" "fixture 所有者" "acct:local-demo" "username"))
          (app-btn "bind" "fixture を実行")
          (out-id "bind-out")))))))

(defn manage-view [] :string
  (view "manage" true
    (string-join "" (heading 1 "管理")
      (lede (txt "電源サイクルは電話面から。ゲスト VGA は使いません。"))
      (out-id "status")
      (app-btn "cycle" "電源サイクル")
      (out-id "cycle-out"))))

(defn devices-view [] :string
  (view "devices" true
    (string-join "" (heading 1 "機械")
      (lede (txt "アカウント確認後に端末鍵を証明すると Node 候補へ追加します。Murakumo の ready、Kekkai 接続、SSD キャッシュ同期は、それぞれ実測できるまで別の状態です。"))
      (out-id "device-plan-out")
      (out-id "devices-out"))))

(defn desktop-view [] :string
  (doc-html (u/desktop-view
    (string-concat (fixed-tiles) (dapp-tiles))
    (string-join "" (fixed-docks) (dapp-dock) (doc-html (u/dock-divider)) (settings-dock)))))

(defn compositor [] :string
  (doc-html (u/compositor-view "compositor 過程が window-session-state の 2 枚を重ねます。以下は hosted compositor の検証面です。 ゲスト browser-frame2 / browser-reduce は Kotoba で描画・入力を処理します。")))

(defn page-main [] :string
  (string-join "" (desktop-view) (murakumo-window) (itonami-view) (yataverse-window) (aozora-window) (dapp-windows) (session-view) (compositor) (setup-view) (manage-view) (devices-view)))

;; The doctype is not an element, so it stays a plain string around the rendered <html> tree. The
;; stylesheet, the scripts and the page main are substituted into the tree's slots (see ui-components slot).
(defn fill [s :string name :string text :string] :string
  (string-replace-all s (u/slot name) text))
(defn page [] :string
  (string-join "" "<!DOCTYPE html>\n"
    (fill (fill (fill (fill (fill (doc-html (u/session-document)) "css" (string-join "" (css-a) (dapp-css) (css-b))) "main" (page-main)) "js1" (js-1)) "js2" (js-2)) "js3" (js-3))
    "\n"))

(defn main [] :i64
  (let [w (typed-cap-call :io/write :string :string (page))] 0))
