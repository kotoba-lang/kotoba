            (el "h1" (string-join "" (at "class" "dads-heading") (at "data-size" "32")) (txt "機械"))
            (el "p" (at "class" "session-lede") (txt "アカウント確認後に端末鍵を証明すると Node 候補へ追加します。Murakumo の ready、Kekkai 接続、SSD キャッシュ同期は、それぞれ実測できるまで別の状態です。"))
            (el "pre" (string-join "" (at "id" "device-plan-out") (at "class" "session-out")) "")
            (el "pre" (string-join "" (at "id" "devices-out") (at "class" "session-out")) "")))))))
      (el "script" (at "src" "/kami-presenter.js") "")
      (el "script" "" (js-1))
      (el "script" "" (js-2))))))
    "\n"))

(defn main [] :i64
  (let [w (typed-cap-call :io/write :string :string (page))] 0))
