(ns index (:require [html-hiccup :as h] [ui-components :as u] [app-itonami :as ai] [app-murakumo :as am]
  [app-browser :as a5] [app-yotei :as a6] [app-shakai :as a7] [app-saifu :as a8] [app-bunsho :as a9] [app-hyokeisan :as a10] [app-zuhyo :as a11]
  [app-yataverse :as a3] [app-aozora :as a4]
  [app-tokei :as a12] [app-wifi :as a13] [app-bluetooth :as a14] [app-settei :as a15] [app-itonami-apps :as a16] [app-updates :as a17] [app-torihiki :as a18]))

;; index.kotoba: the hosted session page, authored as Kotoba (JUN-821).
;;
;; HTML is built by string-returning pure functions over the shared components of
;; kotoba.html ui-components (rendered by html-hiccup), so this file needs no
;; capability but the one `main` uses to print the page. `scripts/session-page.py build` runs it
;; with Amu and writes resources/aiueos/session/index.html; `check` refuses a
;; stale page. Text and attribute values are escaped here; the stylesheet and the
;; two inline scripts are carried as exact string constants (raw text elements).

;; --- html ------------------------------------------------------------------

(defn esc [s :string] :string
  (string-replace-all (string-replace-all (string-replace-all (string-replace-all s "&" "&amp;") "<" "&lt;") ">" "&gt;") "\"" "&quot;"))
(defn txt [s :string] :string (esc s))

;; --- app table -------------------------------------------------------------
;; One row per distributions/awai/dapps/<id>.json, by dock id. scripts/session-page.py
;; check refuses a table that differs from those records (id, title, category,
;; operation names). A row's UI presentation (icon, state, lede) exists only for
;; the apps added after the original four.
(defn app-count [] :i64 18)
(defn rec-id [d :i64] :string (case d 1 "murakumo" 2 "itonami" 3 "yataverse" 4 "aozora" 5 "browser" 6 "yotei" 7 "shakai" 8 "saifu" 9 "bunsho" 10 "hyokeisan" 11 "zuhyo" 12 "tokei" 13 "wifi" 14 "bluetooth" 15 "settei" 16 "itonami-apps" 17 "updates" 18 "torihiki" ""))
(defn rec-title [d :i64] :string (case d 1 "Murakumo" 2 "Itonami" 3 "Yataverse" 4 "Aozora" 5 "Browser" 6 "Yotei" 7 "Shakai" 8 "Saifu" 9 "Bunsho" 10 "Hyokeisan" 11 "Zuhyo" 12 "Tokei" 13 "Wi-Fi" 14 "Bluetooth" 15 "Settei" 16 "Itonami Apps" 17 "Updates" 18 "Torihiki" ""))
(defn rec-cat [d :i64] :string (case d 1 "" 2 "" 3 "" 4 "" 5 "default" 6 "default" 7 "default" 8 "default" 9 "default" 10 "default" 11 "default" 12 "system" 13 "system" 14 "system" 15 "system" 16 "store" 17 "system" 18 "default" ""))
(defn rec-ops [d :i64] :string (case d 1 "remote-inference" 2 "" 3 "block-exchange" 4 "publish-post" 5 "fetch-document" 6 "sync-calendar" 7 "fetch-timeline" 8 "read-chain-state" 9 "export-document" 10 "export-sheet" 11 "export-deck" 12 "sync-time" 13 "" 14 "" 15 "" 16 "fetch-catalog, download-app" 17 "check-updates, download-update" 18 "read-quotes, read-account, request-devnet-funds, submit-order" ""))
(defn ui-icon [d :i64] :string (case d 1 "" 2 "" 3 "" 4 "" 5 "B" 6 "予" 7 "社" 8 "財" 9 "文" 10 "表" 11 "図" 12 "時" 13 "W" 14 "BT" 15 "設" 16 "+" 17 "更" 18 "取" ""))
(defn ui-state [d :i64] :string (case d 1 "" 2 "" 3 "" 4 "" 5 "Browser" 6 "Calendar" 7 "Social" 8 "Wallet" 9 "Documents" 10 "Sheets" 11 "Slides" ""))
(defn ui-lede [d :i64] :string (case d 1 "" 2 "" 3 "" 4 "" 5 "ローカル文書を Kotoba Browser で開きます。" 6 "予定をこの端末の署名付きレコードとして持ちます。" 7 "Aozora の送信箱とタイムラインを読みます。" 8 "端末鍵の表示と署名の検証のみ。取引の署名・送信・決済はしません。" 9 "文書作成 (Word 相当)。" 10 "表計算 (Excel 相当)。" 11 "図表とスライド (PowerPoint 相当)。" ""))

;; --- dapp UI: launcher tiles, dock, windows --------------------------------
;; Ported from distributions/awai/dapps/ui/ui.cljk (kbb/SCI). The dynamic parts
;; stay declarative: `data-bind` names a value the host supplies, `data-action`
;; names an operation the host handles; the host binder is js-2.

(defn new-app? [d :i64] :bool (> (string-length (ui-icon d)) 0))

(defn ops-text [d :i64] :string
  (if (= (string-length (rec-ops d)) 0) "なし" (string-concat (rec-ops d) "（毎回承認）")))

(defn doc-html [d :document] :string
  (option-value-of [:option :string] (h/render d 0) ""))

;; Launcher and dock tiles are shared components (kotoba.html ui-components, JUN-856), rendered by html-hiccup.
(defn tile [d :i64] :string
  (doc-html (u/launcher-tile (rec-id d) (rec-title d) (ui-icon d) (rec-cat d))))

(defn dock-default [d :i64] :string
  (if (= (rec-id d) "browser") "true" (if (= (rec-id d) "settei") "true" (if (= (rec-id d) "itonami-apps") "true" "false"))))

(defn dock-tile [d :i64] :string
  (doc-html (u/dock-tile (rec-id d) (rec-title d) (ui-icon d) (rec-cat d) (dock-default d))))

(defn tiles-from [i :i64 acc :string] :string
  (if (> i (app-count)) acc (tiles-from (+ i 1) (if (new-app? i) (string-concat acc (tile i)) acc))))
(defn docks-from [i :i64 acc :string] :string
  (if (> i (app-count)) acc (docks-from (+ i 1) (if (new-app? i) (string-concat acc (dock-tile i)) acc))))
;; Content primitives are shared components (kotoba.html ui-components, JUN-856), rendered by html-hiccup.
(defn heading [level :i64 text :string] :string (doc-html (u/heading level text)))


(defn empty-state [text :string] :string (doc-html (u/empty-state text)))

(defn pin-row [d :i64] :string (doc-html (u/pin-row (rec-title d) (rec-id d))))

(defn pin-rows [i :i64 acc :string] :string
  (if (> i (app-count)) acc (pin-rows (+ i 1) (if (new-app? i) (string-concat acc (pin-row i)) acc))))

(defn consent-rows [d :i64 acc :string] :string
  (if (> d (app-count)) acc
    (consent-rows (+ d 1)
      (string-concat acc
        (doc-html (u/note-line (string-join "" (rec-title d) ": "
                 (if (= (string-length (rec-ops d)) 0) "外部操作なし" (string-concat (rec-ops d) "（毎回承認）")))))))))

(defn builtin-rows [d :i64 acc :string] :string
  (if (> d (app-count)) acc
    (builtin-rows (+ d 1) (string-concat acc (doc-html (u/note-line (string-concat (rec-title d) "（OS イメージ内蔵）")))))))


;; Apps 5..18 have per-app UI documents (session/apps/<id>.kotoba, named by the records' ui.document).
(defn window [d :i64] :string
  (case d
    5 (a5/ui-document (ui-state d) (ui-lede d) (ops-text d))
    6 (a6/ui-document (ui-state d) (ui-lede d) (ops-text d))
    7 (a7/ui-document (ui-state d) (ui-lede d) (ops-text d))
    8 (a8/ui-document (ui-state d) (ui-lede d) (ops-text d))
    9 (a9/ui-document (ui-state d) (ui-lede d) (ops-text d))
    10 (a10/ui-document (ui-state d) (ui-lede d) (ops-text d))
    11 (a11/ui-document (ui-state d) (ui-lede d) (ops-text d))
    12 (a12/ui-document)
    13 (a13/ui-document)
    14 (a14/ui-document)
    15 (a15/ui-document (consent-rows 1 ""))
    16 (a16/ui-document (pin-rows 1 "") (builtin-rows 1 ""))
    17 (a17/ui-document)
    18 (a18/ui-document)
    ""))

;; Operation approval, shown before any external operation. The host fills the
;; bound fields and wires Allow/Deny; denial sends nothing.
(defn approval [] :string (doc-html (u/approval-sheet)))

(defn windows-from [i :i64 acc :string] :string
  (if (> i (app-count)) acc (windows-from (+ i 1) (if (new-app? i) (string-concat acc (window i)) acc))))


;; The four first-party tiles carry no category, no default-dock flag and are not hidden; Settings has no app id.
(defn fixed-tile [id :string title :string icon :string] :string
  (doc-html (u/launcher-tile id title icon "")))
(defn fixed-dock [id :string title :string icon :string] :string
  (doc-html (u/dock-link (string-concat "#" id) id title icon "" "" false)))
(defn fixed-tiles [] :string
  (string-join "" (fixed-tile "murakumo" "Murakumo" "M") (fixed-tile "itonami" "Itonami" "I") (fixed-tile "yataverse" "Yataverse" "Y") (fixed-tile "aozora" "Aozora" "A")))
(defn fixed-docks [] :string
  (string-join "" (fixed-dock "murakumo" "Murakumo" "M") (fixed-dock "itonami" "Itonami" "I") (fixed-dock "yataverse" "Yataverse" "Y") (fixed-dock "aozora" "Aozora" "A")))
(defn settings-dock [] :string
  (doc-html (u/dock-link "#manage" "" "Settings" "⚙" "" "" false)))
(defn dapp-tiles [] :string (tiles-from 1 ""))
(defn dapp-dock [] :string (docks-from 1 ""))
(defn dapp-windows [] :string (string-concat (windows-from 1 "") (approval)))

(defn tk-css [] :string
  (string-join "\n"
    "#torihiki .tk-app{display:grid;gap:12px}"
    "#torihiki .tk-bar{display:flex;flex-wrap:wrap;gap:8px;align-items:end}"
    "#torihiki .tk-badge{padding:2px 10px;border-radius:999px;background:var(--color-primitive-blue-50);color:var(--color-primitive-blue-900);border:1px solid var(--color-primitive-blue-300);font-weight:700;font-size:12px;align-self:center}"
    "#torihiki .tk-endpoint{display:grid;gap:2px;flex:1 1 240px;min-width:0}"
    "#torihiki .tk-endpoint input{width:100%;box-sizing:border-box}"
    "#torihiki .tk-field{display:grid;gap:2px}"
    "#torihiki .tk-field-label,#torihiki .tk-stat-label{font-size:12px;opacity:.7}"
    "#torihiki .tk-field input{width:100%;box-sizing:border-box;padding:8px;font:inherit;font-variant-numeric:tabular-nums;border:1px solid var(--color-neutral-opacity-gray-536);border-radius:6px}"
    "#torihiki .tk-endpoint input{padding:8px;font:inherit;border:1px solid var(--color-neutral-opacity-gray-536);border-radius:6px}"
    "#torihiki .tk-status{font-size:12px;opacity:.8;align-self:center}"
    "#torihiki .tk-status[data-live='1']{color:var(--color-primitive-green-800);opacity:1;font-weight:700}"
    "#torihiki .tk-tabs{display:flex;gap:4px;border-bottom:1px solid var(--color-neutral-opacity-gray-200)}"
    "#torihiki .tk-tab{padding:8px 16px;border:0;border-bottom:3px solid transparent;background:none;font:inherit;font-weight:700;cursor:pointer}"
    "#torihiki .tk-tab[aria-selected='true']{border-bottom-color:var(--color-primitive-blue-800);color:var(--color-primitive-blue-900)}"
    "#torihiki .tk-panel[hidden]{display:none}"
    "#torihiki .tk-market{display:grid;grid-template-columns:96px repeat(4,1fr);gap:12px;align-items:end;margin-bottom:12px}"
    "#torihiki .tk-stat{display:grid}"
    "#torihiki .tk-stat strong{font-size:18px;font-variant-numeric:tabular-nums}"
    "#torihiki .tk-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:12px}"
    "#torihiki .tk-card{border:1px solid var(--color-neutral-opacity-gray-200);border-radius:8px;padding:12px;background:#fff;min-width:0}"
    "#torihiki .tk-h{margin:0 0 8px;font-size:14px}"
    "#torihiki .tk-cols,#torihiki .tk-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;font-variant-numeric:tabular-nums}"
    "#torihiki .tk-cols{font-size:11px;opacity:.65;padding:0 4px}"
    "#torihiki .tk-cols span:not(:first-child),#torihiki .tk-row span:not(:first-of-type){text-align:right}"
    "#torihiki .tk-row{position:relative;padding:2px 4px;font-size:13px;cursor:pointer;border-radius:3px}"
    "#torihiki .tk-row:hover{outline:1px solid var(--color-neutral-opacity-gray-300)}"
    "#torihiki .tk-row i{position:absolute;inset:0 0 0 auto;opacity:.16;pointer-events:none}"
    "#torihiki .tk-row span{position:relative}"
    "#torihiki .tk-asks .tk-row i{background:var(--color-primitive-red-600)}"
    "#torihiki .tk-asks .tk-row span:first-of-type,#torihiki .tk-sell-px{color:var(--color-primitive-red-800)}"
    "#torihiki .tk-bids .tk-row i{background:var(--color-primitive-green-600)}"
    "#torihiki .tk-bids .tk-row span:first-of-type,#torihiki .tk-buy-px{color:var(--color-primitive-green-800)}"
    "#torihiki .tk-mid{text-align:center;padding:6px;font-weight:700;font-variant-numeric:tabular-nums;border-block:1px solid var(--color-neutral-opacity-gray-200);margin:4px 0}"
    "#torihiki .tk-ticket{display:grid;gap:10px;align-content:start}"
    "#torihiki .tk-seg{display:grid;grid-template-columns:1fr 1fr;border-radius:8px;overflow:hidden;border:1px solid var(--color-neutral-opacity-gray-536)}"
    "#torihiki .tk-seg button{padding:10px;border:0;background:#fff;font:inherit;font-weight:700;cursor:pointer}"
    "#torihiki .tk-seg-buy[aria-pressed='true']{background:var(--color-primitive-green-700);color:#fff}"
    "#torihiki .tk-seg-sell[aria-pressed='true']{background:var(--color-primitive-red-700);color:#fff}"
    "#torihiki .tk-flags{display:flex;flex-wrap:wrap;gap:12px}"
    "#torihiki .tk-check{display:flex;gap:6px;align-items:center;font-size:13px}"
    "#torihiki .tk-submit{padding:12px;border:0;border-radius:8px;color:#fff;font:inherit;font-weight:700;cursor:pointer}"
    "#torihiki .tk-submit-buy{background:var(--color-primitive-green-700)}"
    "#torihiki .tk-submit-sell{background:var(--color-primitive-red-700)}"
    "#torihiki .tk-link{border:0;background:none;color:var(--color-primitive-blue-800);text-decoration:underline;cursor:pointer;font:inherit;justify-self:start;padding:0}"
    "#torihiki .tk-tape{grid-column:1}"
    "#torihiki .tk-pos{grid-column:2}"
    "#torihiki .tk-kv{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;font-variant-numeric:tabular-nums;font-size:13px}"
    "#torihiki .tk-kv b{text-align:right}"
    "#torihiki .tk-spans{display:flex;gap:6px;align-items:center;margin-bottom:8px}"
    "#torihiki .tk-spans button{padding:4px 12px;border:1px solid var(--color-neutral-opacity-gray-536);border-radius:6px;background:#fff;font:inherit;cursor:pointer}"
    "#torihiki .tk-spans button[aria-pressed='true']{background:var(--color-primitive-blue-800);color:#fff}"
    "#torihiki .tk-chart svg{width:100%;height:auto;display:block}"
    "#torihiki .tk-chart .up{stroke:var(--color-primitive-green-700);fill:var(--color-primitive-green-700)}"
    "#torihiki .tk-chart .down{stroke:var(--color-primitive-red-700);fill:var(--color-primitive-red-700)}"
    "#torihiki .tk-chart .grid{stroke:var(--color-neutral-opacity-gray-200);stroke-width:1}"
    "#torihiki .tk-chart text{font-size:11px;fill:currentColor;opacity:.7;font-variant-numeric:tabular-nums}"
    "#torihiki .tk-chart .last{stroke:var(--color-primitive-blue-800);stroke-dasharray:4 3;fill:none}"
    "#torihiki .tk-chart .vol{opacity:.35}"
    "#torihiki .tk-note{font-size:12px;opacity:.7;margin:8px 0 0}"
    "#torihiki .tk-actions{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0}"
    "#torihiki .tk-empty{opacity:.6;padding:8px 4px;font-size:13px}"
    "@media (max-width:720px){#torihiki .tk-grid{grid-template-columns:1fr}#torihiki .tk-tape,#torihiki .tk-pos{grid-column:auto}#torihiki .tk-market{grid-template-columns:1fr 1fr}#torihiki .tk-ticket{order:-1}}"))

(defn dapp-css [] :string
  (string-join "\n"
    (tk-css)
    ".desktop-app-icon[data-cat=\"default\"],.dock-app-icon[data-cat=\"default\"] { color: var(--color-primitive-purple-700); background: var(--color-primitive-purple-50); border-color: var(--color-primitive-purple-200); }"
    ".desktop-app-icon[data-cat=\"system\"],.dock-app-icon[data-cat=\"system\"] { color: var(--color-primitive-orange-800); background: var(--color-primitive-orange-50); border-color: var(--color-primitive-orange-200); }"
    ".desktop-app-icon[data-cat=\"store\"],.dock-app-icon[data-cat=\"store\"] { color: var(--color-primitive-green-800); background: var(--color-primitive-green-50); border-color: var(--color-primitive-green-200); }"))

;; --- stylesheet and scripts (exact text; raw-text elements) -----------------
