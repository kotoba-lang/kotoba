(ns index)

;; index.kotoba: the hosted session page, authored as Kotoba (JUN-821).
;;
;; HTML is built by string-returning pure functions: the tree lives in the call
;; graph (the "form A" of kotoba-lang/html), so this file needs no capability but
;; the one `main` uses to print the page. `scripts/session-page.py build` runs it
;; with Amu and writes resources/aiueos/session/index.html; `check` refuses a
;; stale page. Text and attribute values are escaped here; the stylesheet and the
;; two inline scripts are carried as exact string constants (raw text elements).

;; --- html ------------------------------------------------------------------

(defn esc [s :string] :string
  (string-replace-all (string-replace-all (string-replace-all (string-replace-all s "&" "&amp;") "<" "&lt;") ">" "&gt;") "\"" "&quot;"))
(defn txt [s :string] :string (esc s))
(defn at [k :string v :string] :string (string-join "" " " k "=\"" (esc v) "\""))
(defn ab [k :string] :string (string-concat " " k))
(defn el [tag :string attrs :string body :string] :string (string-join "" "<" tag attrs ">" body "</" tag ">"))
(defn void [tag :string attrs :string] :string (string-join "" "<" tag attrs ">"))

;; --- app table -------------------------------------------------------------
;; One row per distributions/awai/dapps/<id>.json, by dock id. scripts/session-page.py
;; check refuses a table that differs from those records (id, title, category,
;; operation names). A row's UI presentation (icon, state, lede) exists only for
;; the apps added after the original four.
(defn app-count [] :i64 18)
(defn rec-id [d :i64] :string (case d 1 "murakumo" 2 "itonami" 3 "yataverse" 4 "aozora" 5 "browser" 6 "yotei" 7 "shakai" 8 "saifu" 9 "bunsho" 10 "hyokeisan" 11 "zuhyo" 12 "tokei" 13 "wifi" 14 "bluetooth" 15 "settei" 16 "itonami-apps" 17 "updates" 18 "torihiki" ""))
(defn rec-title [d :i64] :string (case d 1 "Murakumo" 2 "Itonami" 3 "Yataverse" 4 "Aozora" 5 "Browser" 6 "Yotei" 7 "Shakai" 8 "Saifu" 9 "Bunsho" 10 "Hyokeisan" 11 "Zuhyo" 12 "Tokei" 13 "Wi-Fi" 14 "Bluetooth" 15 "Settei" 16 "Itonami Apps" 17 "Updates" 18 "Torihiki" ""))
(defn rec-cat [d :i64] :string (case d 1 "" 2 "" 3 "" 4 "" 5 "default" 6 "default" 7 "default" 8 "default" 9 "default" 10 "default" 11 "default" 12 "system" 13 "system" 14 "system" 15 "system" 16 "store" 17 "system" 18 "default" ""))
(defn rec-ops [d :i64] :string (case d 1 "remote-inference" 2 "" 3 "block-exchange" 4 "publish-post" 5 "fetch-document" 6 "sync-calendar" 7 "fetch-timeline" 8 "read-chain-state" 9 "export-document" 10 "export-sheet" 11 "export-deck" 12 "sync-time" 13 "" 14 "" 15 "" 16 "fetch-catalog, download-app" 17 "check-updates, download-update" 18 "read-quotes, submit-order" ""))
(defn ui-icon [d :i64] :string (case d 1 "" 2 "" 3 "" 4 "" 5 "B" 6 "予" 7 "社" 8 "財" 9 "文" 10 "表" 11 "図" 12 "時" 13 "W" 14 "BT" 15 "設" 16 "+" 17 "更" 18 "取" ""))
(defn ui-state [d :i64] :string (case d 1 "" 2 "" 3 "" 4 "" 5 "Browser" 6 "Calendar" 7 "Social" 8 "Wallet" 9 "Documents" 10 "Sheets" 11 "Slides" 12 "Clock" 13 "Network" 14 "Devices" 15 "Settings" 16 "Store" 17 "Updates" 18 "Exchange" ""))
(defn ui-lede [d :i64] :string (case d 1 "" 2 "" 3 "" 4 "" 5 "ローカル文書を Kotoba Browser で開きます。" 6 "予定をこの端末の署名付きレコードとして持ちます。" 7 "Aozora の送信箱とタイムラインを読みます。" 8 "端末鍵の表示と署名の検証のみ。取引の署名・送信・決済はしません。" 9 "文書作成 (Word 相当)。" 10 "表計算 (Excel 相当)。" 11 "図表とスライド (PowerPoint 相当)。" 12 "時計。" 13 "ネットワーク状態。" 14 "Bluetooth の状態。" 15 "設定と、アプリごとの同意の確認。" 16 "アプリを探して入れます。" 17 "OS とアプリの更新を管理します。" 18 "取引所クライアント（devnet・デモ口座のみ）。実資金・保管・決済は扱いません。" ""))

;; --- dapp UI: launcher tiles, dock, windows --------------------------------
;; Ported from distributions/awai/dapps/ui/ui.cljk (kbb/SCI). The dynamic parts
;; stay declarative: `data-bind` names a value the host supplies, `data-action`
;; names an operation the host handles; the host binder is js-2.

(defn new-app? [d :i64] :bool (> (string-length (ui-icon d)) 0))

(defn ops-text [d :i64] :string
  (if (= (string-length (rec-ops d)) 0) "なし" (string-concat (rec-ops d) "（毎回承認）")))

(defn tile [d :i64] :string
  (el "a" (string-join "" (at "class" "desktop-app") (at "href" (string-concat "#" (rec-id d))) (at "data-app" (rec-id d)) (at "data-cat" (rec-cat d)) (at "aria-label" (rec-title d)))
    (string-join ""
      (el "span" (string-join "" (at "class" "desktop-app-icon") (at "aria-hidden" "true") (at "data-cat" (rec-cat d))) (txt (ui-icon d)))
      (el "span" (at "class" "desktop-app-label") (txt (rec-title d))))))

(defn dock-default [d :i64] :string
  (if (= (rec-id d) "browser") "true" (if (= (rec-id d) "settei") "true" (if (= (rec-id d) "itonami-apps") "true" "false"))))

(defn dock-tile [d :i64] :string
  (el "a" (string-join "" (at "class" "dock-app") (at "href" (string-concat "#" (rec-id d))) (at "data-app" (rec-id d)) (at "data-cat" (rec-cat d)) (at "data-dock-default" (dock-default d)) (at "aria-label" (rec-title d)) (ab "hidden"))
    (string-join ""
      (el "span" (string-join "" (at "class" "dock-app-icon") (at "aria-hidden" "true") (at "data-cat" (rec-cat d))) (txt (ui-icon d)))
      (el "span" (at "class" "dock-app-label") (txt (rec-title d))))))

(defn tiles-from [i :i64 acc :string] :string
  (if (> i (app-count)) acc (tiles-from (+ i 1) (if (new-app? i) (string-concat acc (tile i)) acc))))
(defn docks-from [i :i64 acc :string] :string
  (if (> i (app-count)) acc (docks-from (+ i 1) (if (new-app? i) (string-concat acc (dock-tile i)) acc))))
(defn heading [level :i64 text :string] :string
  (if (= level 1)
    (el "h1" (string-join "" (at "class" "dads-heading") (at "data-size" "32")) (txt text))
    (el "h2" (string-join "" (at "class" "dads-heading") (at "data-size" "24")) (txt text))))

(defn request-button [label :string op :string service :string] :string
  (el "button" (string-join "" (at "class" "dads-button") (at "type" "button") (at "data-type" "solid-fill") (at "data-size" "md") (at "data-action" "request") (at "data-op" op) (at "data-service" service)) (txt label)))

(defn empty-state [text :string] :string (el "p" (at "class" "app-empty-state") (txt text)))
(defn pre-out [attrs :string text :string] :string (el "pre" (string-concat (at "class" "session-out") attrs) (txt text)))
(defn result-slot [] :string (el "div" (at "data-slot" "result") ""))

(defn notice [d :i64] :string
  (empty-state (string-join "" "この AIUEOS ビルドには " (rec-title d) " の本体がまだ入っていません。外部操作: " (ops-text d))))

(defn pin-row [d :i64] :string
  (el "p" ""
    (string-join ""
      (txt (string-concat (rec-title d) " "))
      (el "button" (string-join "" (at "class" "dads-button") (at "type" "button") (at "data-type" "outline") (at "data-action" "pin") (at "data-app" (rec-id d))) (txt "Dock に置く")))))

(defn pin-rows [i :i64 acc :string] :string
  (if (> i (app-count)) acc (pin-rows (+ i 1) (if (new-app? i) (string-concat acc (pin-row i)) acc))))

(defn consent-rows [d :i64 acc :string] :string
  (if (> d (app-count)) acc
    (consent-rows (+ d 1)
      (string-concat acc
        (el "p" ""
          (txt (string-join "" (rec-title d) ": "
                 (if (= (string-length (rec-ops d)) 0) "外部操作なし" (string-concat (rec-ops d) "（毎回承認）")))))))))

(defn builtin-rows [d :i64 acc :string] :string
  (if (> d (app-count)) acc
    (builtin-rows (+ d 1) (string-concat acc (el "p" "" (txt (string-concat (rec-title d) "（OS イメージ内蔵）")))))))

(defn mode-radio [value :string label :string] :string
  (el "label" ""
    (string-join ""
      (void "input" (string-join "" (at "type" "radio") (at "name" "update-mode") (at "value" value) (at "data-action" "set-update-mode")))
      (txt (string-concat " " label)))))

(defn app-body [d :i64] :string
  (let [id (rec-id d)]
    (if (= id "tokei") (pre-out (at "data-bind" "clock") "")
    (if (= id "wifi") (string-concat (pre-out (at "data-bind" "net") "") (empty-state "参加するには承認が必要です（このビルドでは未登録）。"))
    (if (= id "bluetooth") (string-concat (pre-out (at "data-bind" "bluetooth") "") (empty-state "ペアリングには承認が必要です（このビルドでは未登録）。"))
    (if (= id "settei") (string-concat (heading 2 "同意の確認") (consent-rows 1 ""))
    (if (= id "itonami-apps")
      (string-join "" (heading 2 "Dock") (pin-rows 1 "") (heading 2 "入っているアプリ") (builtin-rows 1 "")
        (heading 2 "カタログから入れる")
        (empty-state "カタログの接続先と署名鍵はまだ登録されていません。登録されるまで、取得・インストールはできません。")
        (request-button "カタログを確認する" "fetch-catalog" "Itonami アプリカタログ")
        (result-slot))
    (if (= id "updates")
      (string-join "" (heading 2 "更新ポリシー")
        (mode-radio "manual" "手動")
        (mode-radio "notify" "通知のみ（既定）")
        (mode-radio "auto-stage" "承認後に自動で取得")
        (mode-radio "auto-install" "承認後に自動で取得・次回起動で適用")
        (empty-state "「自動」でも予定が出すのは確認のプロンプトだけです。確認・取得・適用は、それぞれ毎回承認します。")
        (empty-state "更新元の接続先はまだ登録されていません。登録されるまで、確認・取得・適用はできません。")
        (request-button "更新を確認する" "check-updates" "Itonami 更新サービス")
        (result-slot)
        (pre-out "" "チャンネル: stable\n署名: Ed25519（ポスト量子 ML-DSA-65 は未対応）\nロールバック: 直前のイメージを保持"))
    (if (= id "torihiki")
      (string-join "" (notice d)
        (empty-state "devnet とデモ口座だけを扱います。実資金・保管・決済は扱いません。注文の送信は所有者の判断待ちで、この画面にはありません。")
        (request-button "気配値を読む" "read-quotes" "Torihiki devnet")
        (result-slot))
      (notice d))))))))))

(defn window [d :i64] :string
  (el "section" (string-join "" (at "id" (rec-id d)) (at "class" "dds-ext-section session-view") (at "data-view" (rec-id d)) (ab "hidden"))
    (el "article" (at "class" "app-window")
      (string-join ""
        (el "header" (at "class" "app-window-head")
          (string-join ""
            (el "a" (string-join "" (at "class" "window-close") (at "href" "#desktop") (at "aria-label" "Close app")) (txt "×"))
            (el "span" (at "class" "app-window-title") (txt (rec-title d)))
            (el "span" (at "class" "window-spacer") "")
            (el "span" (at "class" "app-window-state") (txt (ui-state d)))))
        (el "div" (at "class" "app-window-body")
          (string-join ""
            (heading 1 (rec-title d))
            (el "p" (at "class" "session-lede") (txt (ui-lede d)))
            (el "div" (at "class" "dds-ext-card") (app-body d))
            (el "a" (string-join "" (at "class" "app-return") (at "href" "#desktop")) (txt "デスクトップへ"))))))))

;; Operation approval, shown before any external operation. The host fills the
;; bound fields and wires Allow/Deny; denial sends nothing.
(defn approval [] :string
  (el "template" (at "id" "dapp-approval")
    (el "div" (string-join "" (at "class" "app-empty-state") (at "role" "alertdialog"))
      (string-join ""
        (el "p" (at "data-bind" "approval-title") "")
        (el "p" (at "data-bind" "approval-detail") "")
        (el "button" (string-join "" (at "class" "dads-button") (at "type" "button") (at "data-type" "solid-fill") (at "data-action" "approve")) (txt "許可"))
        (el "button" (string-join "" (at "class" "dads-button") (at "type" "button") (at "data-type" "outline") (at "data-action" "deny")) (txt "拒否"))))))

(defn windows-from [i :i64 acc :string] :string
  (if (> i (app-count)) acc (windows-from (+ i 1) (if (new-app? i) (string-concat acc (window i)) acc))))

(defn dapp-tiles [] :string (tiles-from 1 ""))
(defn dapp-dock [] :string (docks-from 1 ""))
(defn dapp-windows [] :string (string-concat (windows-from 1 "") (approval)))

(defn dapp-css [] :string
  (string-join "\n"
    ".desktop-app-icon[data-cat=\"default\"],.dock-app-icon[data-cat=\"default\"] { color: var(--color-primitive-purple-700); background: var(--color-primitive-purple-50); border-color: var(--color-primitive-purple-200); }"
    ".desktop-app-icon[data-cat=\"system\"],.dock-app-icon[data-cat=\"system\"] { color: var(--color-primitive-orange-800); background: var(--color-primitive-orange-50); border-color: var(--color-primitive-orange-200); }"
    ".desktop-app-icon[data-cat=\"store\"],.dock-app-icon[data-cat=\"store\"] { color: var(--color-primitive-green-800); background: var(--color-primitive-green-50); border-color: var(--color-primitive-green-200); }"))

;; --- stylesheet and scripts (exact text; raw-text elements) -----------------
(defn css-a [] :string "/* jp-go-digital-design-system — vendored CSS\n * Source: https://github.com/digital-go-jp/design-system-example-components-html\n * Upstream commit: 3b34f4c3553fa3bee90bfd8b6fe962ac3055107d — MIT License, Copyright (c) 2025 デジタル庁\n * Generated by scripts/vendor.cljk — DO NOT EDIT BY HAND (re-vendor instead). */\n:root {\n  --color-primitive-blue-50: #e8f1fe;\n  --color-primitive-blue-100: #d9e6ff;\n  --color-primitive-blue-200: #c5d7fb;\n  --color-primitive-blue-300: #9db7f9;\n  --color-primitive-blue-400: #7096f8;\n  --color-primitive-blue-500: #4979f5;\n  --color-primitive-blue-600: #3460fb;\n  --color-primitive-blue-700: #264af4;\n  --color-primitive-blue-800: #0031d8;\n  --color-primitive-blue-900: #0017c1;\n  --color-primitive-blue-1000: #00118f;\n  --color-primitive-blue-1100: #000071;\n  --color-primitive-blue-1200: #000060;\n  --color-primitive-light-blue-50: #f0f9ff;\n  --color-primitive-light-blue-100: #dcf0ff;\n  --color-primitive-light-blue-200: #c0e4ff;\n  --color-primitive-light-blue-300: #97d3ff;\n  --color-primitive-light-blue-400: #57b8ff;\n  --color-primitive-light-blue-500: #39abff;\n  --color-primitive-light-blue-600: #008bf2;\n  --color-primitive-light-blue-700: #0877d7;\n  --color-primitive-light-blue-800: #0066be;\n  --color-primitive-light-blue-900: #0055ad;\n  --color-primitive-light-blue-1000: #00428c;\n  --color-primitive-light-blue-1100: #00316a;\n  --color-primitive-light-blue-1200: #00234b;\n  --color-primitive-cyan-50: #e9f7f9;\n  --color-primitive-cyan-100: #c8f8ff;\n  --color-primitive-cyan-200: #99f2ff;\n  --color-primitive-cyan-300: #79e2f2;\n  --color-primitive-cyan-400: #2bc8e4;\n  --color-primitive-cyan-500: #01b7d6;\n  --color-primitive-cyan-600: #00a3bf;\n  --color-primitive-cyan-700: #008da6;\n  --color-primitive-cyan-800: #008299;\n  --color-primitive-cyan-900: #006f83;\n  --color-primitive-cyan-1000: #006173;\n  --color-primitive-cyan-1100: #004c59;\n  --color-primitive-cyan-1200: #003741;\n  --colo