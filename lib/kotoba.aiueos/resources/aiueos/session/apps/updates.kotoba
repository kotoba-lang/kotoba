(ns app-updates (:require [html-hiccup :as h] [ui-components :as u]) (:export [document-id document-title ui-document]))

;; UI document of the dapp record distributions/awai/dapps/updates.json (ui.document, JUN-856).
;; Built from the shared components of kotoba.html ui-components, rendered by html-hiccup.
;; JUN-813: installed version and floor, policy mode, last check, the admission legend (signature m-of-n,
;; freshness verdict, version floor) and the three separately approved operations check / download / install.
;; Static text and bind names only: this page runs in a browser and cannot read the booted device's journal, so
;; it shows no version, floor or candidate it does not have. No update origin is registered (placeholder, owner
;; has not supplied a host); the policy engine is os/aiueos/kotoba/aiueos/update_policy.kotoba.
;; document-id and document-title must equal the record's id and title:
;; scripts/check-dapp-records.py refuses a document that differs from its record.

(defn document-id [] :string "updates")
(defn document-title [] :string "Updates")

(defn- doc-html [d :document] :string
  (option-value-of [:option :string] (h/render d 0) ""))
(defn- empty-state [text :string] :string (doc-html (u/empty-state text)))
(defn- radio [value :string label :string] :string (doc-html (u/mode-radio value label)))
(defn- chip [label :string state :string] :string (doc-html (u/chip label state)))
(defn- out [bind :string text :string] :string (doc-html (u/pre-out bind "" text)))

(defn ui-document [] :string
  (doc-html (u/app-window (document-id) (document-title) "Updates" "OS とアプリの更新を管理します。"
    (string-join "" (doc-html (u/heading 2 "インストール済みの版"))
      (out "update-installed" "OS イメージの版: 未取得\n版の下限（ロールバック防止）: 未取得\nチャンネル: stable")
      (empty-state "このページはブラウザで動き、起動した端末の更新ジャーナル（OSMETA.BIN）を読めません。端末側の更新マネージャーが版と下限を表示します。")
      (doc-html (u/heading 2 "更新ポリシー"))
      (radio "manual" "手動")
      (radio "notify" "通知のみ（既定）")
      (radio "auto-stage" "承認後に自動で取得")
      (radio "auto-install" "承認後に自動で取得・次回起動で適用")
      (empty-state "「自動」でも予定が出すのは確認のプロンプトだけです。確認・取得・適用は、それぞれ毎回承認します。")
      (out "update-policy" "手動: 確認・取得・適用をすべて自分で始める\n通知のみ: 予定が確認のプロンプトを出す。取得・適用は自分で始める\n承認後に自動で取得: 確認の承認のあと、取得のプロンプトを出す。適用は自分で始める\n承認後に自動で取得・次回起動で適用: 取得のあと、次回起動時に適用のプロンプトを出す")
      (doc-html (u/heading 2 "最後の確認"))
      (out "update-last-check" "最後の確認: なし（まだ確認していません）")
      (doc-html (u/heading 2 "署名付きの更新候補"))
      (empty-state "候補はありません。確認の承認と更新元の登録がそろうまで、一覧は空です。")
      (out "update-admission" "署名: 固定された 3 つの署名者のうち 2 つ以上が、Ed25519 と ML-DSA-65 の両方で有効（AIUEIMG2）。AIUEIMG1 は Ed25519 のみ。\n版の下限: 版は記録済みの下限より大きいこと。下限を読めないときは拒否する。\nダイジェスト: SHA-256 が一致するまで何も書かない。")
      (doc-html (u/heading 2 "鮮度の判定（凡例）"))
      (chip "新しい" "fresh")
      (chip "期限切れ" "expired")
      (chip "時計が遅れている" "clock-behind")
      (chip "時計なし" "no-clock")
      (empty-state "鮮度（AIUEFRS1）が決めるのは、確認が「最新版がある」と言えるかどうかだけです。鮮度は取得・適用を許可も拒否もしません。")
      (doc-html (u/heading 2 "操作（それぞれ毎回承認）"))
      (doc-html (u/request-button "更新を確認する" "check-updates" "更新元（未登録）"))
      (doc-html (u/request-button "取得する" "download-update" "更新元（未登録）"))
      (doc-html (u/request-button "適用する" "install-update" "この端末（ローカル書き込み）"))
      (doc-html (u/result-slot))
      (out "update-operations" "確認: 更新元（未登録）／送るデータ: インストール済みの版 ID、チャンネル／毎回承認\n取得: 更新元（未登録）／送るデータ: イメージの CID、チャンネル／毎回承認\n適用: この端末のみ（ネットワークなし）／書くデータ: 検証済みのステージ済みイメージ／毎回承認")
      (empty-state "更新元の接続先はまだ登録されていません。登録されるまで、確認・取得はできません。")
      (out "update-signers" "チャンネル: stable\n署名者: 検証専用の署名者集合（1 台の Mac で保管。保管の分離はありません。配布用ではありません）\nロールバック: 直前のイメージを保持")))))
