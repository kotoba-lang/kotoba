(ns app-updates (:require [html-hiccup :as h] [ui-components :as u]) (:export [document-id document-title ui-document]))

;; UI document of the dapp record distributions/awai/dapps/updates.json (ui.document, JUN-856).
;; Built from the shared components of kotoba.html ui-components, rendered by html-hiccup.
;; document-id and document-title must equal the record's id and title:
;; scripts/check-dapp-records.py refuses a document that differs from its record.

(defn document-id [] :string "updates")
(defn document-title [] :string "Updates")

(defn- doc-html [d :document] :string
  (option-value-of [:option :string] (h/render d 0) ""))
(defn- empty-state [text :string] :string (doc-html (u/empty-state text)))
(defn- radio [value :string label :string] :string (doc-html (u/mode-radio value label)))

(defn ui-document [] :string
  (doc-html (u/app-window (document-id) (document-title) "Updates" "OS とアプリの更新を管理します。"
    (string-join "" (doc-html (u/heading 2 "更新ポリシー"))
      (radio "manual" "手動")
      (radio "notify" "通知のみ（既定）")
      (radio "auto-stage" "承認後に自動で取得")
      (radio "auto-install" "承認後に自動で取得・次回起動で適用")
      (empty-state "「自動」でも予定が出すのは確認のプロンプトだけです。確認・取得・適用は、それぞれ毎回承認します。")
      (empty-state "更新元の接続先はまだ登録されていません。登録されるまで、確認・取得・適用はできません。")
      (doc-html (u/request-button "更新を確認する" "check-updates" "Itonami 更新サービス"))
      (doc-html (u/result-slot))
      (doc-html (u/pre-out "" "" "チャンネル: stable\n署名: Ed25519（ポスト量子 ML-DSA-65 は未対応）\nロールバック: 直前のイメージを保持"))))))
