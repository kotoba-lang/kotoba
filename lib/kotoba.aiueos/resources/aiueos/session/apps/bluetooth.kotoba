(ns app-bluetooth (:require [html-hiccup :as h] [ui-components :as u]) (:export [document-id document-title ui-document]))

;; UI document of the dapp record distributions/awai/dapps/bluetooth.json (ui.document, JUN-856).
;; Built from the shared components of kotoba.html ui-components, rendered by html-hiccup.
;; document-id and document-title must equal the record's id and title:
;; scripts/check-dapp-records.py refuses a document that differs from its record.

(defn document-id [] :string "bluetooth")
(defn document-title [] :string "Bluetooth")

(defn- doc-html [d :document] :string
  (option-value-of [:option :string] (h/render d 0) ""))

(defn ui-document [] :string
  (doc-html (u/app-window (document-id) (document-title) "Devices" "Bluetooth の状態。"
    (doc-html (u/status-body "bluetooth" "ペアリングには承認が必要です（このビルドでは未登録）。")))))
