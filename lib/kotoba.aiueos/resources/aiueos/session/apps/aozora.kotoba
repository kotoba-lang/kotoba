(ns app-aozora (:require [html-hiccup :as h] [ui-components :as u]) (:export [document-id document-title ui-document]))

;; UI document of the dapp record distributions/awai/dapps/aozora.json (ui.document, JUN-856).
;; Built from the shared components of kotoba.html ui-components, rendered by html-hiccup.
;; document-id and document-title must equal the record's id and title:
;; scripts/check-dapp-records.py refuses a document that differs from its record.

(defn document-id [] :string "aozora")
(defn document-title [] :string "Aozora")

(defn- doc-html [d :document] :string
  (option-value-of [:option :string] (h/render d 0) ""))

(defn ui-document [] :string
  (doc-html (u/app-frame (document-id) (document-title) "Reader" "読書アプリ"
    (u/region "reader-empty" "Book shelf"
      (string-join "" (doc-html (u/heading 2 "本棚"))
        (doc-html (u/note-line "ライブラリはまだ空です。"))
        (doc-html (u/empty-state "この AIUEOS ビルドには Aozora のカタログ接続がまだ登録されていません。")))))))
