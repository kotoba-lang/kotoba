(ns app-murakumo (:require [html-hiccup :as h] [ui-components :as u]) (:export [document-id document-title ui-document]))

;; UI document of the dapp record distributions/awai/dapps/murakumo.json (ui.document, JUN-856).
;; Built from the shared components of kotoba.html ui-components, rendered by html-hiccup.
;; document-id and document-title must equal the record's id and title:
;; scripts/check-dapp-records.py refuses a document that differs from its record.

(defn document-id [] :string "murakumo")
(defn document-title [] :string "Murakumo")

(defn- doc-html [d :document] :string
  (option-value-of [:option :string] (h/render d 0) ""))

(defn ui-document [] :string
  (doc-html (u/app-window (document-id) (document-title) "Inference" "推論を kotoba のセッション過程から murakumo-main へ送ります。"
    (string-join "" (doc-html (u/heading 2 "Inference"))
      (doc-html (u/note-line "モデル alias は murakumo-main です。実行結果はこのアプリに表示します。"))
      (doc-html (u/action-button "app-run-infer" "推論する" "solid-fill"))
      (doc-html (u/out-pre "app-infer-out" "polite"))))))
