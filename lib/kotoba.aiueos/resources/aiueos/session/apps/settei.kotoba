(ns app-settei (:require [html-hiccup :as h] [ui-components :as u]) (:export [document-id document-title ui-document]))

;; UI document of the dapp record distributions/awai/dapps/settei.json (ui.document, JUN-856).
;; Built from the shared components of kotoba.html ui-components, rendered by html-hiccup.
;; consent is the already rendered per-app consent lines, built from index.kotoba's app table.
;; document-id and document-title must equal the record's id and title:
;; scripts/check-dapp-records.py refuses a document that differs from its record.

(defn document-id [] :string "settei")
(defn document-title [] :string "Settei")

(defn- doc-html [d :document] :string
  (option-value-of [:option :string] (h/render d 0) ""))

(defn ui-document [consent :string] :string
  (doc-html (u/app-window (document-id) (document-title) "Settings" "設定と、アプリごとの同意の確認。"
    (string-concat (doc-html (u/heading 2 "同意の確認")) consent))))
