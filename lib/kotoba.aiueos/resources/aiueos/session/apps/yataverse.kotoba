(ns app-yataverse (:require [html-hiccup :as h] [ui-components :as u]) (:export [document-id document-title ui-document]))

;; UI document of the dapp record distributions/awai/dapps/yataverse.json (ui.document, JUN-856).
;; Built from the shared components of kotoba.html ui-components, rendered by html-hiccup.
;; document-id and document-title must equal the record's id and title:
;; scripts/check-dapp-records.py refuses a document that differs from its record.

(defn document-id [] :string "yataverse")
(defn document-title [] :string "Yataverse")

(defn- doc-html [d :document] :string
  (option-value-of [:option :string] (h/render d 0) ""))

(defn ui-document [] :string
  (doc-html (u/app-window (document-id) (document-title) "Storage" "データセットと保存領域を扱うアプリです。"
    (string-join "" (doc-html (u/heading 2 "Workspace"))
      (doc-html (u/note-line "AIUEOS のデスクトップから起動しました。"))
      (doc-html (u/empty-state "この AIUEOS ビルドには Yataverse の接続先がまだ登録されていません。"))))))
