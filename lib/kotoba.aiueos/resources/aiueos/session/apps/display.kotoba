(ns app-display (:require [html-hiccup :as h] [ui-components :as u]) (:export [document-id document-title ui-document]))

;; UI document of the dapp record distributions/awai/dapps/display.json (ui.document, JUN-856).
;; Built from the shared components of kotoba.html ui-components, rendered by html-hiccup.
;; document-id and document-title must equal the record's id and title:
;; scripts/check-dapp-records.py refuses a document that differs from its record.

(defn document-id [] :string "display")
(defn document-title [] :string "Display")

(defn- doc-html [d :document] :string
  (option-value-of [:option :string] (h/render d 0) ""))

(defn ui-document [] :string
  (doc-html (u/app-window (document-id) (document-title) "Display" "画面の明るさ。最後の設定が保存されます。"
    (doc-html (u/status-body "display" "最後の設定が保存されます。")))))
