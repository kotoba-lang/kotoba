(ns app-torihiki (:require [html-hiccup :as h] [ui-components :as u]) (:export [document-id document-title ui-document]))

;; UI document of the dapp record distributions/awai/dapps/torihiki.json (ui.document, JUN-856).
;; Built from the shared components of kotoba.html ui-components, rendered by html-hiccup.
;; document-id and document-title must equal the record's id and title:
;; scripts/check-dapp-records.py refuses a document that differs from its record.

(defn document-id [] :string "torihiki")
(defn document-title [] :string "Torihiki")

(defn- doc-html [d :document] :string
  (option-value-of [:option :string] (h/render d 0) ""))
(defn- empty-state [text :string] :string (doc-html (u/empty-state text)))
(defn- pre-bind [bind :string text :string] :string (doc-html (u/pre-out bind "" text)))
(defn- pre-slot [slot :string text :string] :string (doc-html (u/pre-out "" slot text)))

;; Torihiki (devnet / demo only): the screens are markup here; the behaviour is
;; assets/torihiki.js (js-3). Dynamic parts (book, trades, chart, account) are
;; filled by that script from the node the user chose; data-tk names a click.
(defn- tk-button [kind :string tk :string label :string] :string (doc-html (u/tk-button kind tk label)))
(defn- tk-tab [id :string label :string] :string (doc-html (u/tk-tab id label)))
(defn- tk-input [id :string label :string value :string mode :string] :string (doc-html (u/tk-input id label value mode)))
(defn- tk-check [id :string label :string] :string (doc-html (u/tk-check id label)))
(defn- tk-stat [label :string bind :string] :string (doc-html (u/tk-stat label bind)))

(defn- tk-box [cls :string body :string] :string (doc-html (u/tk-box cls body)))
(defn- tk-heading [text :string] :string (doc-html (u/tk-heading text)))
(defn- tk-cols [a :string b :string c :string] :string (doc-html (u/tk-cols a b c)))
(defn- tk-slot [id :string cls :string text :string] :string (doc-html (u/tk-slot id cls text)))
(defn- tk-panel [name :string hide :bool body :string] :string (doc-html (u/tk-panel name hide body)))

(defn- tk-bar [] :string
  (tk-box "tk-bar"
    (string-join ""
      (doc-html (u/tk-badge "devnet"))
      (doc-html (u/tk-endpoint))
      (tk-button "outline" "save-endpoint" "保存")
      (tk-button "solid-fill" "live-start" "ライブ表示")
      (tk-button "outline" "live-stop" "停止")
      (doc-html (u/tk-status-text "停止中")))))

(defn- tk-trade-panel [] :string
  (tk-panel "trade" false
    (string-join ""
      (tk-box "tk-market"
        (string-join ""
          (tk-input "tk-market" "市場 id" "1" "numeric")
          (tk-stat "シンボル" "tk-symbol")
          (tk-stat "直近" "tk-last")
          (tk-stat "スプレッド" "tk-spread")
          (tk-stat "ブロック" "tk-height")))
      (tk-box "tk-grid"
        (string-join ""
          (tk-box "tk-card tk-book"
            (string-join ""
              (tk-heading "板")
              (tk-cols "価格 tick" "数量 lot" "累計")
              (tk-slot "tk-asks" "tk-rows tk-asks" "")
              (tk-slot "tk-mid" "tk-mid" "—")
              (tk-slot "tk-bids" "tk-rows tk-bids" "")))
          (tk-box "tk-card tk-ticket"
            (string-join ""
              (tk-heading "注文")
              (doc-html (u/tk-seg (string-join "" (doc-html (u/tk-side "buy" "true" "買い")) (doc-html (u/tk-side "sell" "false" "売り")))))
              (tk-input "tk-price" "価格（tick）" "" "numeric")
              (tk-input "tk-size" "数量（lot）" "" "numeric")
              (tk-box "tk-flags" (string-join "" (tk-check "tk-post" "post-only") (tk-check "tk-ioc" "IOC") (tk-check "tk-ro" "reduce-only")))
              (doc-html (u/tk-submit "買い注文を送る"))
              (doc-html (u/tk-link "cancel-all" "この市場の全注文を取り消す"))))
          (tk-box "tk-card tk-tape"
            (string-join ""
              (tk-heading "約定")
              (tk-cols "価格 tick" "数量 lot" "ブロック")
              (tk-slot "tk-trades" "tk-rows" "")))
          (tk-box "tk-card tk-pos"
            (string-join ""
              (tk-heading "ポジションと口座")
              (tk-slot "tk-positions" "tk-kv" "口座を読むと表示されます"))))))))

(defn- tk-chart-panel [] :string
  (tk-panel "chart" true
    (string-join ""
      (doc-html (u/tk-spans "足（ブロック数）"
        (string-join "" (doc-html (u/tk-span-choice "1" "false")) (doc-html (u/tk-span-choice "5" "true")) (doc-html (u/tk-span-choice "20" "false")))))
      (tk-box "tk-card"
        (string-join ""
          (doc-html (u/tk-chart-host))
          (doc-html (u/tk-note "横軸はブロック高です（時刻ではありません）。約定のないブロック区間は足を作りません。")))))))

(defn- tk-account-panel [] :string
  (tk-panel "account" true
    (tk-box "tk-card"
      (string-join ""
        (tk-heading "セッション鍵")
        (pre-bind "tk-session" "")
        (tk-box "tk-actions" (string-join "" (tk-button "outline" "account" "口座を読む") (tk-button "outline" "faucet" "devnet 資金を請求")))
        (empty-state "devnet とデモ口座だけを扱います。実資金・保管・決済は扱いません。接続先ノードのチェーン id に devnet が含まれない場合は、署名も送信もしません。操作ごとに承認が要ります。")))))

(defn- torihiki-body [] :string
  (doc-html (u/tk-app
    (string-join ""
      (tk-bar)
      (doc-html (u/tk-tabs (string-join "" (tk-tab "trade" "取引") (tk-tab "chart" "チャート") (tk-tab "account" "口座・鍵"))))
      (tk-trade-panel)
      (tk-chart-panel)
      (tk-account-panel)
      (doc-html (u/data-slot "tk-approval"))
      (pre-slot "tk-result" "")))))

(defn ui-document [] :string
  (doc-html (u/app-window (document-id) (document-title) "Exchange" "取引所クライアント（devnet・デモ口座のみ）。注文はこの端末で署名し、承認した操作だけを送ります。実資金・保管・決済は扱いません。"
    (torihiki-body))))
