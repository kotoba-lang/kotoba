(ns app-shakai (:require [html-hiccup :as h] [ui-components :as u]) (:export [document-id document-title ui-document]))

;; UI document of the dapp record distributions/awai/dapps/shakai.json (ui.document, JUN-856).
;; This AIUEOS build has no Shakai body yet, so the document is the shared notice
;; over the shared app window, as index.kotoba rendered it before; it adds no behaviour.
;; state, lede and ops (the record's operations, already formatted) come from index.kotoba's app table.
;; document-id and document-title must equal the record's id and title:
;; scripts/check-dapp-records.py refuses a document that differs from its record.

(defn document-id [] :string "shakai")
(defn document-title [] :string "Shakai")

(defn- doc-html [d :document] :string
  (option-value-of [:option :string] (h/render d 0) ""))

(defn ui-document [state :string lede :string ops :string] :string
  (doc-html (u/app-window (document-id) (document-title) state lede
    (doc-html (u/empty-state (string-join "" "この AIUEOS ビルドには " (document-title) " の本体がまだ入っていません。外部操作: " ops))))))
