(ns app-itonami (:require [html-hiccup :as h] [ui-components :as u]) (:export [document-id document-title ui-document]))

;; UI document of the dapp record distributions/awai/dapps/itonami.json (ui.document, JUN-856).
;; Built from the shared components of kotoba.html ui-components, rendered by html-hiccup.
;; document-id and document-title must equal the record's id and title:
;; scripts/check-dapp-records.py refuses a document that differs from its record.

(defn document-id [] :string "itonami")
(defn document-title [] :string "Itonami")

(defn- doc-html [d :document] :string
  (option-value-of [:option :string] (h/render d 0) ""))
(defn- esc [s :string] :string
  (string-replace-all (string-replace-all (string-replace-all (string-replace-all s "&" "&amp;") "<" "&lt;") ">" "&gt;") "\"" "&quot;"))
(defn- code [t :string] :string (doc-html (u/code-span t)))

(defn ui-document [] :string
  (doc-html (u/view-section (document-id) true
    (string-join "" (doc-html (u/heading 1 (document-title)))
      (doc-html (u/lede-line (string-join "" (esc "産業側は ") (code "itonami.cloud") (esc "（network-awai/cloud-itonami）です。kotobase でも murakumo でもありません。 grant が無い消費者セッションはここへ HTTP しません。 `#itonami` も同じ面です。"))))
      (doc-html (u/ext-card (string-join "" (doc-html (u/heading 2 "itonami に聞く"))
        (doc-html (u/rich-line (string-join "" (esc "この過程が ") (code "/api/health") (esc " と ") (code "/api/fleet/metrics") (esc " を ") (code "itonami.cloud") (esc " へ GET します。拒否は ") (code "operator-grant-required") (esc " です。"))))
        (doc-html (u/action-button "run-operator" "運用 grant して読む" "solid-fill"))
        (doc-html (u/action-button "deny-operator" "運用 grant を拒否する" "solid-fill"))
        (doc-html (u/out-pre "operator-out" "")))))))))
