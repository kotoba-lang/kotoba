(ns app-otent (:require [html-hiccup :as h] [ui-components :as u]) (:export [document-id document-title ui-document]))

;; UI document of the dapp record distributions/awai/dapps/otent.json (ui.document, JUN-856).
;; Built from the shared components of kotoba.html ui-components, rendered by html-hiccup.
;; document-id and document-title must equal the record's id and title:
;; scripts/check-dapp-records.py refuses a document that differs from its record.

(defn document-id [] :string "otent")
(defn document-title [] :string "Otent")

(defn- doc-html [d :document] :string
  (option-value-of [:option :string] (h/render d 0) ""))

(defn ui-document [] :string
  (doc-html (u/app-window (document-id) (document-title) "Globe" "お天道様。衛星・地震・航空機・船舶を、端末のスナップショットから描きます。取り込みも保持もこの画面ではしません。"
    (string-join ""
      (doc-html (u/pre-out "otent-satellites" "" ""))
      (doc-html (u/pre-out "otent-earthquakes" "" ""))
      (doc-html (u/pre-out "otent-aircraft" "" ""))
      (doc-html (u/pre-out "otent-vessels" "" ""))))))
