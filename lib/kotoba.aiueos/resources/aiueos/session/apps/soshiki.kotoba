(ns app-soshiki (:require [html-hiccup :as h] [ui-components :as u]) (:export [document-id document-title ui-document]))

;; UI document of the dapp record distributions/awai/dapps/soshiki.json (ui.document, JUN-856).
;; Built from the shared components of kotoba.html ui-components, rendered by html-hiccup.
;; The interactive circle chart, role assignment and bot profiles live in the
;; device shell; this document is the declarative session summary over the same record.
;; document-id and document-title must equal the record's id and title:
;; scripts/check-dapp-records.py refuses a document that differs from its record.

(defn document-id [] :string "soshiki")
(defn document-title [] :string "Soshiki")

(defn- doc-html [d :document] :string
  (option-value-of [:option :string] (h/render d 0) ""))

(defn ui-document [] :string
  (doc-html (u/app-window (document-id) (document-title) "Soshiki" "サークルとロールで組織を作り、Botにプロフィールを持たせる。"
    (doc-html (u/status-body "soshiki" "サークルとロールの概要をこのデバイスから読みます。")))))
