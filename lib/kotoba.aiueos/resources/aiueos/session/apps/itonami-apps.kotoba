(ns app-itonami-apps (:require [html-hiccup :as h] [ui-components :as u]) (:export [document-id document-title ui-document]))

;; UI document of the dapp record distributions/awai/dapps/itonami-apps.json (ui.document, JUN-856).
;; Built from the shared components of kotoba.html ui-components, rendered by html-hiccup.
;; pins and builtins are the already rendered Dock and built-in app lines, built from index.kotoba's app table.
;; document-id and document-title must equal the record's id and title:
;; scripts/check-dapp-records.py refuses a document that differs from its record.

(defn document-id [] :string "itonami-apps")
(defn document-title [] :string "Itonami Apps")

(defn- doc-html [d :document] :string
  (option-value-of [:option :string] (h/render d 0) ""))
(defn- empty-state [text :string] :string (doc-html (u/empty-state text)))
(defn- heading [text :string] :string (doc-html (u/heading 2 text)))

(defn ui-document [pins :string builtins :string] :string
  (doc-html (u/app-window (document-id) (document-title) "Store" "アプリを探して入れます。"
    (string-join "" (heading "Dock") pins (heading "入っているアプリ") builtins
      (heading "カタログから入れる")
      (empty-state "カタログの接続先と署名鍵はまだ登録されていません。登録されるまで、取得・インストールはできません。")
      (doc-html (u/request-button "カタログを確認する" "fetch-catalog" "Itonami アプリカタログ"))
      (doc-html (u/result-slot))))))
