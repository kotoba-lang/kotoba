    "guest-broker" "AIUEOS_COMPOSITOR_GUEST_BROKER_OK"
    "guest-session" "AIUEOS_COMPOSITOR_GUEST_SESSION_OK"
    "guest-browser-frame" "AIUEOS_COMPOSITOR_GUEST_BROWSER_FRAME_OK"
    "guest-browser-input" "AIUEOS_COMPOSITOR_GUEST_BROWSER_INPUT_OK"
    "guest-browser-text" "AIUEOS_COMPOSITOR_GUEST_BROWSER_TEXT_OK"
    "guest-browser-text-raised" "AIUEOS_COMPOSITOR_GUEST_BROWSER_TEXT_RAISED_OK"
    "guest-browser-type" "AIUEOS_COMPOSITOR_GUEST_BROWSER_TYPE_OK"
    "guest-browser-preedit" "AIUEOS_COMPOSITOR_GUEST_BROWSER_PREEDIT_OK"
    "guest-browser-ime-toggle" "AIUEOS_COMPOSITOR_GUEST_BROWSER_IME_TOGGLE_OK"
    "guest-browser-drag" "AIUEOS_COMPOSITOR_GUEST_BROWSER_DRAG_OK"
    "guest-browser-resize" "AIUEOS_COMPOSITOR_GUEST_BROWSER_RESIZE_OK"
    "guest-browser-event-loop" "AIUEOS_COMPOSITOR_GUEST_BROWSER_EVENT_LOOP_OK"
