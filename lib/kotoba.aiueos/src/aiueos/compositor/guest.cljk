    "guest-browser-keyboard-activate" (guest-browser-keyboard-activate-result opts)
    "guest-browser-high-contrast" (guest-browser-high-contrast-result opts)
    {:green? false :exit 3 :reason :unmeasured :leftover [:unmeasured]}))

