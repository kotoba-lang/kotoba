    "guest-browser-pressed-state" (guest-browser-pressed-state-result opts)
    "guest-browser-minimize" (guest-browser-minimize-result opts)
    "guest-browser-screen-lock" (guest-browser-screen-lock-result opts)
    "guest-browser-sign-out" (guest-browser-sign-out-result opts)
    "guest-browser-settings" (guest-browser-settings-result opts)
    "guest-touchpad-gestures" (guest-touchpad-gestures-result opts)
    "guest-browser-battery" (guest-browser-battery-result opts)
    "guest-browser-ui-scale" (guest-browser-ui-scale-result opts)
    "guest-browser-keyboard-only" (guest-browser-keyboard-only-result opts)
    "guest-browser-text-edit" (guest-browser-text-edit-result opts)
    "guest-browser-clock" (guest-browser-clock-result opts)
    "guest-browser-layout" (guest-browser-layout-result opts)
    "guest-browser-notify" (guest-browser-notify-result opts)
    "guest-browser-passkey" (guest-browser-passkey-result opts)
    "guest-browser-backup" (guest-browser-backup-result opts)
