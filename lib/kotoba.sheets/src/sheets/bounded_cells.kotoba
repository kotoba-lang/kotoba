(ns sheets.bounded-cells
  (:export [main make-empty put-cell cell-count contains-cell? get-cell-or]))

;; Bounded-profile port of sheets.model's per-tab cell table, scoped to
;; string-valued cells keyed by a bounded {:row :col} integer coordinate --
;; the shape sheets.model-test's own workbook-model fixture exercises
;; (string cells put with put-cell, read back with range-values). Formulas,
;; styles, named ranges, charts, the workbook envelope, and the Transit wire
;; format stay in the CLJC oracle (sheets.model / sheets.wire).
;;
;; The cell table is kotoba-lang/compiler's canonical bounded typed-map
;; ([:map <record> :string], <= 31 entries), the same primitive already
;; production-qualified by kotoba-lang/crdt and by sheets' sibling
;; kotoba-lang/states bounded-model migration -- here with a record key.

(defn coord [row :i64 col :i64] [:record :sheets/coord [[:row :i64] [:col :i64]]]
  (record [:record :sheets/coord [[:row :i64] [:col :i64]]] row col))

(defn make-empty [] [:map [:record :sheets/coord [[:row :i64] [:col :i64]]] :string]
  (typed-map-new [:map [:record :sheets/coord [[:row :i64] [:col :i64]]] :string]))

(defn put-cell [cells [:map [:record :sheets/coord [[:row :i64] [:col :i64]]] :string]
                row :i64 col :i64 text :string]
    [:map [:record :sheets/coord [[:row :i64] [:col :i64]]] :string]
  (typed-map-assoc [:map [:record :sheets/coord [[:row :i64] [:col :i64]]] :string]
                   cells (coord row col) text))

(defn cell-count [cells [:map [:record :sheets/coord [[:row :i64] [:col :i64]]] :string]] :i64
  (typed-map-count [:map [:record :sheets/coord [[:row :i64] [:col :i64]]] :string] cells))

(defn contains-cell? [cells [:map [:record :sheets/coord [[:row :i64] [:col :i64]]] :string]
                       row :i64 col :i64] :bool
  (typed-map-contains [:map [:record :sheets/coord [[:row :i64] [:col :i64]]] :string]
                      cells (coord row col)))

;; String value, defaulting when the cell is empty (typed-map-get returns an
;; option of the value type).
(defn get-cell-or [cells [:map [:record :sheets/coord [[:row :i64] [:col :i64]]] :string]
                   row :i64 col :i64 fallback :string] :string
  (match-option
   (typed-map-get [:map [:record :sheets/coord [[:row :i64] [:col :i64]]] :string]
                  cells (coord row col))
   [:option :string]
   (none fallback)
   (some value value)))

;; Self-conformance: replay sheets.model-test's workbook-model fixture --
;; put "A" at (1,1) and "B" at (1,2), then assert count, membership, and
;; read-back exactly. Returns 42 iff every assertion holds.
(defn main [] :i64
  (let [cells (put-cell (put-cell (make-empty) 1 1 "A") 1 2 "B")]
    (if (= 2 (cell-count cells))
      (if (contains-cell? cells 1 1)
        (if (string=? "A" (get-cell-or cells 1 1 "?"))
          (if (string=? "B" (get-cell-or cells 1 2 "?"))
            (if (contains-cell? cells 5 5)
              1
              (if (string=? "?" (get-cell-or cells 5 5 "?"))
                42
                1))
            1)
          1)
        1)
      1)))
