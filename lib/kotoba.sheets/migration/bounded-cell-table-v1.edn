{:schema "kotoba-sheets-migration/v1"
 :profile :sheets/bounded-cell-table-v1
 :legacy {:source "src/sheets/model.cljk"
          :status :retained-general-oracle}
 :canonical {:kernel-and-conformance "src/sheets/bounded_cells.kotoba"}
 :domain
 {:functions [:coord :make-empty :put-cell :cell-count :contains-cell? :get-cell-or]
  :scope "a single tab's cell table, scoped to string-valued cells keyed by a
          bounded {:row :col} integer coordinate -- exactly the shape
          sheets.model-test's own workbook-model fixture exercises (string
          cells put with put-cell, read back with range-values)."
  :representation "the cell table is kotoba-lang/compiler's canonical bounded
                   typed-map ([:map [:record :sheets/coord ...] :string],
                   max-typed-map-entries 31) with a RECORD key -- the same
                   primitive production-qualified by kotoba-lang/crdt and by
                   the sibling kotoba-lang/states bounded-model migration,
                   here demonstrating a record-keyed (2D integer coordinate)
                   table rather than a string- or i64-keyed one."}
 :excluded [:sheets.model/formulas :sheets.model/styles
            :sheets.model/named-ranges :sheets.model/charts
            :sheets.model/workbook-and-tabs :sheets.model/range-values
            :sheets.validate :sheets.wire]
 :exclusion-reason "not reviewed this pass; formulas, styles, named ranges,
                    charts, the workbook/tab container, range extraction, the
                    validator, and the Transit wire envelope remain the CLJC
                    oracle's responsibility."
 :compiler-findings
 {:typed-map-get-returns-option
  {:description "typed-map-get returns an [:option value-type], not the bare
                 value, so get-cell-or match-options it with a caller-supplied
                 fallback for an absent cell. Working as designed."}
  :typed-map-type-must-be-a-literal
  {:description "typed-map ops require the [:map k v] type as a literal
                 argument at each call site; a let-bound type value is
                 rejected ('value type is outside the safe profile'). Working
                 as designed; the kernel inlines the type literal."}}
 :verification
 {:hand-verified-cases
  "main replays sheets.model-test's workbook-model fixture: put \"A\" at
   (1,1) and \"B\" at (1,2); asserts cell-count 2, membership of (1,1),
   read-back of both cells, absence of (5,5), and the fallback for an empty
   cell. Returns 42 iff all hold."
  :web {:main 42 :required-capabilities []}
  :wasm {:main 42}
  :required-capabilities []}
 :cutover {:bounded-profile-authorized true :general-cljc-oracle-retained true}}
