(ns safetensors.dtype-test
  "F16/BF16 bit-level decode checked against known-good reference values pulled independently
   from the IEEE 754 half-precision and bfloat16 Wikipedia pages (not derived from this repo's
   own encoder) — see ADR-2607051400 Phase 3. Also covers F32/F64 round-trip and the exact
   dtype-label table."
  (:require [kotoba.test :refer [deftest is testing]]
            [safetensors.dtype :as dt]))

;; ---- F16 (IEEE 754 binary16) — https://en.wikipedia.org/wiki/Half-precision_floating-point_format

(deftest f16-reference-values
  (testing "zero"
    (is (= 0.0 (dt/f16-bits->double 0x0000))))
  (testing "one"
    (is (= 1.0 (dt/f16-bits->double 0x3C00))))
  (testing "negative two"
    (is (= -2.0 (dt/f16-bits->double 0xC000))))
  (testing "largest finite (65504)"
    (is (= 65504.0 (dt/f16-bits->double 0x7BFF))))
  (testing "smallest positive subnormal (2^-24)"
    (is (= (Math/pow 2 -24) (dt/f16-bits->double 0x0001))))
  (testing "largest subnormal (1023 * 2^-24)"
    (is (= (* 1023 (Math/pow 2 -24)) (dt/f16-bits->double 0x03FF))))
  (testing "closest value to 1/3"
    (is (= 0.333251953125 (dt/f16-bits->double 0x3555))))
  (testing "+/- infinity"
    (is (= ##Inf (dt/f16-bits->double 0x7C00)))
    (is (= ##-Inf (dt/f16-bits->double 0xFC00)))))

;; ---- BF16 (bfloat16) — https://en.wikipedia.org/wiki/Bfloat16_floating-point_format

(deftest bf16-reference-values
  (testing "one"
    (is (= 1.0 (dt/bf16-bits->double 0x3F80))))
  (testing "two"
    (is (= 2.0 (dt/bf16-bits->double 0x4000))))
  (testing "negative two"
    (is (= -2.0 (dt/bf16-bits->double 0xC000))))
  (testing "pi truncated to bf16 (3.140625)"
    (is (= 3.140625 (dt/bf16-bits->double 0x4049))))
  (testing "zero"
    (is (= 0.0 (dt/bf16-bits->double 0x0000)))))

(deftest f16-and-bf16-are-not-the-same-layout
  ;; the classic bug this ADR calls out by name: same 16-bit width, different exponent/mantissa
  ;; split. 0xC000 happens to be -2.0 in BOTH (exponent field 0b10000 / 0b10000000 both encode
  ;; the same power of two under each format's own bias), so use a value where they diverge.
  (is (not= (dt/f16-bits->double 0x4049) (dt/bf16-bits->double 0x4049))
      "0x4049 must decode differently under F16's 5-bit-exponent/10-bit-mantissa split vs BF16's
       8-bit-exponent/7-bit-mantissa split")
  (is (= 3.140625 (dt/bf16-bits->double 0x4049)))
  (is (not= 3.140625 (dt/f16-bits->double 0x4049))))

;; ---- F32 / F64 round-trip (encode then decode; independent byte-pattern checks are in
;;      core_test.clj's hand-built-bytes test) --------------------------------------------------

(deftest f32-known-bit-patterns
  (is (= 1065353216 (dt/double->f32-bits 1.0)) "1.0 = 0x3F800000")
  (is (= 3212836864 (dt/double->f32-bits -1.0)) "-1.0 = 0xBF800000")
  (is (= 1.0 (dt/f32-bits->double 0x3F800000)))
  (is (= -1.0 (dt/f32-bits->double 0xBF800000)))
  (is (= 0 (dt/double->f32-bits 0.0)))
  (is (= 0.5 (dt/f32-bits->double (dt/double->f32-bits 0.5)))))

(deftest f32-round-trip
  ;; values chosen to be EXACTLY representable in f32's 24-bit (1 implicit + 23 stored) mantissa,
  ;; so exact equality after an encode+decode round-trip is a meaningful check, not a coincidence.
  (doseq [v [0.0 1.0 -1.0 0.5 -0.5 2.0 100.25 -3.140625 1234.5 -0.125 8192.0]]
    (is (= (double v) (dt/f32-bits->double (dt/double->f32-bits v)))
        (str "f32 round-trip for " v))))

(deftest f32-round-trip-lossy-for-values-beyond-24-bit-precision
  ;; f32 only has 24 bits of significand, so a value whose exact binary representation needs
  ;; more nonzero mantissa bits than that is EXPECTED to lose precision through an f32
  ;; round-trip — real, correct float32 behavior (the same thing `numpy.float32(...)` shows),
  ;; not a bug. (1e10 = 2^10 * 5^10 happens to need only 24 significant bits, so it round-trips
  ;; exactly — not a counterexample; 123456789.123 needs far more and does not.)
  (is (not= 123456789.123 (dt/f32-bits->double (dt/double->f32-bits 123456789.123))))
  (is (< (Math/abs (/ (- 123456789.123 (dt/f32-bits->double (dt/double->f32-bits 123456789.123)))
                       123456789.123))
         1e-6)
      "relative error within f32's ~7-significant-digit precision")
  (is (not= 1e-10 (dt/f32-bits->double (dt/double->f32-bits 1e-10))))
  (is (< (Math/abs (/ (- 1e-10 (dt/f32-bits->double (dt/double->f32-bits 1e-10))) 1e-10)) 1e-6)
      "relative error within f32's ~7-significant-digit precision"))

(deftest f64-round-trip
  (doseq [v [0.0 1.0 -1.0 0.5 3.141592653589793 -123456.789 1e100 1e-100]]
    (is (= (double v) (dt/f64-bits->double (dt/double->f64-bits v)))
        (str "f64 round-trip for " v))))

(deftest f16-bf16-round-trip-representable-values
  ;; values chosen to be exactly representable in both formats (no rounding, so round-trip
  ;; equality is a meaningful check rather than an accidental rounding coincidence)
  (doseq [v [0.0 1.0 -1.0 2.0 -2.0 0.5 0.25 100.0 -3.5]]
    (is (= (double v) (dt/f16-bits->double (dt/double->f16-bits v))) (str "f16 round-trip " v))
    (is (= (double v) (dt/bf16-bits->double (dt/double->bf16-bits v))) (str "bf16 round-trip " v))))

;; ---- dtype label table ---------------------------------------------------------------------

(deftest label-table
  (is (= :f32 (dt/label->dtype "F32")))
  (is (= :f16 (dt/label->dtype "F16")))
  (is (= :bf16 (dt/label->dtype "BF16")))
  (is (= :f64 (dt/label->dtype "F64")))
  (is (= :i64 (dt/label->dtype "I64")))
  (is (= :i32 (dt/label->dtype "I32")))
  (is (= :i8 (dt/label->dtype "I8")))
  (is (= :u8 (dt/label->dtype "U8")))
  (is (= :bool (dt/label->dtype "BOOL")))
  (is (= "F32" (dt/dtype->label :f32)))
  (is (= 4 (dt/byte-width :f32)))
  (is (= 2 (dt/byte-width :f16)))
  (is (thrown? clojure.lang.ExceptionInfo (dt/label->dtype "NOT_A_REAL_DTYPE")))
  (testing "known-but-unsupported sub-byte dtypes raise a distinct, clear error"
    (is (thrown-with-msg? clojure.lang.ExceptionInfo #"not yet supported"
                           (dt/label->dtype "F8_E4M3")))))
