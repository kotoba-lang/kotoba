(ns safetensors.json-test
  "Golden tests for the zero-dependency JSON codec — pins that it correctly parses exactly the
   shape a real safetensors header uses (nested objects, arrays of ints, escaped strings,
   __metadata__), plus the escape/number edge cases a hand-rolled parser is most likely to get
   wrong."
  (:require [kotoba.test :refer [deftest is]]
            [safetensors.json :as json]))

(deftest scalars
  (is (= nil (json/parse-json "null")))
  (is (= true (json/parse-json "true")))
  (is (= false (json/parse-json "false")))
  (is (= 0 (json/parse-json "0")))
  (is (= 42 (json/parse-json "42")))
  (is (= -7 (json/parse-json "-7")))
  (is (= 3.5 (json/parse-json "3.5")))
  (is (= -0.5 (json/parse-json "-0.5")))
  (is (= 1000.0 (json/parse-json "1e3")))
  (is (= 150.0 (json/parse-json "1.5e2"))))

(deftest strings-and-escapes
  (is (= "hello" (json/parse-json "\"hello\"")))
  (is (= "" (json/parse-json "\"\"")))
  (is (= "line\nbreak" (json/parse-json "\"line\\nbreak\"")))
  (is (= "a\"b\\c" (json/parse-json "\"a\\\"b\\\\c\"")))
  (is (= "tab\there" (json/parse-json "\"tab\\there\"")))
  (is (= "A" (json/parse-json "\"\\u0041\"")) "unicode escape"))

(deftest arrays-and-objects
  (is (= [] (json/parse-json "[]")))
  (is (= [1 2 3] (json/parse-json "[1,2,3]")))
  (is (= [1 2 3] (json/parse-json "[ 1 , 2 , 3 ]")) "whitespace tolerant")
  (is (= {} (json/parse-json "{}")))
  (is (= {"a" 1 "b" [1 2]} (json/parse-json "{\"a\":1,\"b\":[1,2]}"))))

(deftest a-real-shaped-safetensors-header
  (let [src (str "{\"weight\":{\"dtype\":\"F32\",\"shape\":[2,3],"
                 "\"data_offsets\":[0,24]},"
                 "\"__metadata__\":{\"format\":\"pt\",\"note\":\"say \\\"hi\\\"\"}}")
        parsed (json/parse-json src)]
    (is (= {"dtype" "F32" "shape" [2 3] "data_offsets" [0 24]} (get parsed "weight")))
    (is (= {"format" "pt" "note" "say \"hi\""} (get parsed "__metadata__")))))

(deftest write-json-round-trips-through-parse
  (let [data {"a" 1 "b" [1 2 3] "c" "hi\nthere" "d" nil "e" true "f" {"nested" "map"}}]
    (is (= data (json/parse-json (json/write-json data))))))

(deftest write-json-exact-bytes
  (is (= "{\"a\":1,\"b\":[1,2]}" (json/write-json (sorted-map "a" 1 "b" [1 2]))))
  (is (= "\"say \\\"hi\\\"\"" (json/write-json "say \"hi\""))))
