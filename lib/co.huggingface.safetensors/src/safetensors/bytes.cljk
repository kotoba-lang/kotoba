(ns safetensors.bytes
  "Portable byte-buffer accessors — the .cljc seam between `safetensors.core`'s pure decode
   math and the host's native byte-array type (JVM `byte[]` vs a JS `Uint8Array`). Every
   multi-byte little-endian combiner here uses plain arithmetic (`+`/`*`/`mod`/`quot`), never a
   64-bit bitwise op, so the *same* code is exact on JVM (Clojure auto-promotes integer overflow
   to bignum) and precision-limited-but-correct on ClojureScript (JS doubles are exact integers
   up to 2^53, which covers every offset/length a real safetensors file has ever needed to date;
   documented as a known limit rather than silently wrong).")

;; ---- host byte-array primitives -------------------------------------------------------------

(defn byte-length [b]
  #?(:clj (alength ^bytes b)
     :cljs (.-length b)))

(defn ubyte
  "Unsigned byte value (0-255) at index i."
  [b i]
  #?(:clj (bit-and (aget ^bytes b i) 0xff)
     :cljs (aget b i)))

(defn as-long
  "Coerce any numeric value (incl. a `clojure.lang.BigInt` that happens to fit in a `long` — see
   `u64-le`/`i64-le`'s docstrings) to a primitive-compatible long. Needed because JVM `aset` on a
   `^longs`-hinted array falls back to reflection for a boxed `BigInt` argument, and reflection
   can't coerce `BigInt` into a primitive `long[]` slot even when the value fits."
  [v]
  #?(:clj (long v)
     :cljs v))

(defn byte-array-of [n]
  #?(:clj (byte-array (int n))
     :cljs (js/Uint8Array. n)))

(defn set-byte!
  "Write an unsigned byte value (0-255) at index i."
  [b i v]
  #?(:clj (aset ^bytes b (int i) (unchecked-byte v))
     :cljs (aset b i (bit-and v 0xff))))

(defn slice
  "Byte sub-range [start end) as a fresh byte array of the same host type."
  [b start end]
  #?(:clj (java.util.Arrays/copyOfRange ^bytes b (int start) (int end))
     :cljs (.slice b start end)))

(defn concat-bytes
  "Concatenate a seq of host byte arrays into one fresh byte array."
  [chunks]
  (let [total (reduce + (map byte-length chunks))
        out (byte-array-of total)]
    (loop [cs (seq chunks) off 0]
      (if cs
        (let [c (first cs) n (byte-length c)]
          #?(:clj (System/arraycopy ^bytes c 0 ^bytes out off n)
             :cljs (.set out c off))
          (recur (next cs) (+ off n)))
        out))))

(defn utf8->str [b]
  #?(:clj (String. ^bytes b "UTF-8")
     :cljs (.decode (js/TextDecoder. "utf-8") b)))

(defn str->utf8 [s]
  #?(:clj (.getBytes ^String s "UTF-8")
     :cljs (.encode (js/TextEncoder.) s)))

;; ---- little-endian multi-byte combiners (unsigned magnitude, via arithmetic only) ------------

(defn u16-le [b off]
  (+ (ubyte b off) (* 256 (ubyte b (+ off 1)))))

(defn u32-le [b off]
  (+ (ubyte b off)
     (* 256 (ubyte b (+ off 1)))
     (* 65536 (ubyte b (+ off 2)))
     (* 16777216 (ubyte b (+ off 3)))))

(defn u64-le
  "Unsigned 64-bit magnitude (0..2^64-1) combined from two 32-bit LE halves via `hi*2^32+lo`
   arithmetic — exact on JVM (`+'`/`*'` auto-promote to bignum on overflow instead of throwing),
   exact on any host for values < 2^53."
  [b off]
  #?(:clj (+' (u32-le b off) (*' (u32-le b (+ off 4)) 4294967296))
     :cljs (+ (u32-le b off) (* (u32-le b (+ off 4)) 4294967296))))

;; ---- signed interpretations (two's complement, derived from the unsigned magnitude) ----------

(defn i16-le [b off]
  (let [u (u16-le b off)] (if (>= u 32768) (- u 65536) u)))

(defn i32-le [b off]
  (let [u (u32-le b off)] (if (>= u 2147483648) (- u 4294967296) u)))

(defn i64-le [b off]
  (let [u (u64-le b off)]
    (if (>= u 9223372036854775808)
      #?(:clj (-' u 18446744073709551616) :cljs (- u 18446744073709551616))
      u)))

;; ---- little-endian multi-byte writers (inverse of the readers above) -------------------------

(defn write-u16-le! [b off v]
  (let [v (mod v 65536)]
    (set-byte! b off (mod v 256))
    (set-byte! b (+ off 1) (quot v 256))))

(defn write-u32-le! [b off v]
  (let [v (mod v 4294967296)]
    (loop [i 0 v v]
      (when (< i 4)
        (set-byte! b (+ off i) (mod v 256))
        (recur (inc i) (quot v 256))))))

(defn write-u64-le! [b off v]
  (let [v (mod v 18446744073709551616)]
    (loop [i 0 v v]
      (when (< i 8)
        (set-byte! b (+ off i) (mod v 256))
        (recur (inc i) (quot v 256))))))
