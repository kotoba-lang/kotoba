(ns lg-components-core
  (:export [modifier-name variant-modifier size-modifier
            default-variant default-size]))

;; The decision core of `liquid-glass.components`: **the default variant is
;; silent** (ADR-2607270100 §10, fourth repo of the chain). `:outline` and
;; `:md` emit no modifier at all, which is what keeps every button written
;; before these axes existed rendering byte-identically.
;;
;; Ported by poolside/laguna-s-2.1 through kotoba-code's scripts/orbench and
;; gated by kotoba -M inspect / -M test (jvm-kir, js, wasm) / aarch64 native,
;; plus test/liquid_glass/kotoba_components_parity_test.cljk.
;;
;; This module deliberately does NOT build the `liquid-glass__` prefix.
;; `class-name` already lives in kotoba/style_core.kotoba in this repo; a
;; second copy of that literal would be a second place the prefix can change.
;; The names here are component-relative and the host applies class-name.
;; (The first generated version did duplicate it and passed every test — the
;; battery cannot see a duplicated constant, only a reader can.)
;;
;; What stays .cljc: the keyword -> string coercion, joining with spaces and
;; dropping empties, and all hiccup assembly/retagging. Nothing here throws.
;;
;; Word-typed throughout, so this qualifies for :aarch64-kotoba-v1 as written.

(defn default-variant [] :string "outline")
(defn default-size [] :string "md")

(defn modifier-name [base :string modifier :string] :string
  (string-concat (string-concat base "--") modifier))

(defn variant-modifier [base :string variant :string] :string
  (if (or (string=? variant "") (string=? variant (default-variant)))
    ""
    (modifier-name base variant)))

(defn size-modifier [base :string size :string] :string
  (if (or (string=? size "") (string=? size (default-size)))
    ""
    (modifier-name base size)))
