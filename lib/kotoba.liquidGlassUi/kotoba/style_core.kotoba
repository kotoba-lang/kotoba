(ns liquid-glass-style-core
  ;; No :export: the parity harness appends zero-arg case defns and drives
  ;; them through KIR (same convention as kotoba/tokens_core.kotoba).
  (:schemas {;; T5.2 native guest record: multi-arg pure → single record.
             ;; `btn-sel` is the only multi-arg function in this slice.
             :lg/btn-sel [:record :lg/btn-sel
                          [[:modifier :string] [:suffix :string]]]}))

;; A `.kotoba` port of the string-producing core of `liquid-glass.style`
;; (ADR-2607270100 §10, form A). No capabilities: a CSS declaration value is
;; data → text, so this module sits in kotoba/pure.
;;
;; What is here: the selector builders and the declaration *values* — the
;; strings that actually name this material (the blur+saturate+brightness
;; backdrop chain, the elevation + two-tone rim box-shadow, the focus
;; halo/ring, the specular gradients, the press squash, the overlay
;; enter/exit animation shorthands, the keyframe transforms) — plus the
;; three whole functions whose entire output is a fixed-shape string
;; (`lens-supports-css`, `spring-supports-css`, `layered-css`,
;; `inline-style`).
;;
;; What is NOT here, and why (each of these is a real limit, not a
;; convenience cut):
;;   * every `*-rules` function returns a VECTOR OF [selector decls-map]
;;     PAIRS — a collection fold over ~120 rules, far past
;;     max-heterogeneous-vector-items (32). Host-side.
;;   * `sel` joins over `glass-surface-components` (21) / `ink-components`
;;     (34) / `overlay-components` — a fold over a name list; 34 also
;;     exceeds the vector ceiling outright. Host-side.
;;   * `component-css` / `base-rules-data` / `component-rules` render through
;;     `css.core` (`rule` / `media` / `keyframes` / `css`), which walks
;;     declaration maps in *insertion* order and does its own
;;     breakout-assertion. That renderer belongs to kotoba-lang/css, which
;;     has its own `.kotoba` port; wiring the two together needs cross-repo
;;     project linking that does not exist yet. Host-side.
;;   * `class-name` in the `.cljc` accepts a keyword OR a string and calls
;;     `name` — a runtime type dispatch. This port takes the resolved
;;     string; the keyword arm stays host-side.
;;   * `inline-style-hiccup` returns hiccup, not a string. Document plane.
;;
;; The `prop: value;` assembly inside `lens-supports-css` /
;; `spring-supports-css` mirrors `css.core/rule` for the 1- and 2-entry
;; declaration maps those two functions pass it. Both are gated byte-for-byte
;; against the live `.cljc` output, and both strings are asserted to appear
;; verbatim inside `(style/component-css)`.

;; --- surface / elevation names --------------------------------------------

(defn surface-var-prefix [surface :string] :string
  (string-concat "--liquid-glass-surface-" surface))

;; --- class + selector builders --------------------------------------------

(defn class-name [component :string] :string
  ;; `.cljc` 1-arity after `name` has resolved a keyword to its string.
  (string-concat "liquid-glass__" component))

(defn btn-sel [x [:ref :lg/btn-sel]] :string
  ;; Selector list for both button shapes, optionally with a modifier and/or
  ;; a trailing pseudo. `modifier` is "" for the `.cljc` nil arm.
  (let [modifier (record-get x :modifier)
        suffix (record-get x :suffix)
        m (if (= 1 (string=? modifier ""))
            ;; string=? is typed :i64 (1/0), not :bool — compare to 1 to get
            ;; a :bool for `if`.
            ""
            (string-concat "--" modifier))]
    (string-join "" ".liquid-glass__button" m suffix
                 ",.liquid-glass__icon-button" m suffix)))

;; --- glass material declaration values ------------------------------------

(defn backdrop-filter-value [surface :string] :string
  ;; `(:backdrop-filter (backdrop-decls surface))` — also the
  ;; `-webkit-backdrop-filter` value (the `.cljc` emits the same string
  ;; under both keys).
  (let [p (surface-var-prefix surface)]
    (string-join "" "blur(var(" p "-blur)) saturate(var(" p
                 "-saturate)) brightness(1.05)")))

(defn glass-background-value [surface :string] :string
  ;; `(:background (glass-bg-decls surface))`
  (string-concat "var(" (string-concat (surface-var-prefix surface) "-tint)")))

(defn glass-border-value [surface :string] :string
  ;; `(:border (glass-bg-decls surface))`
  (string-concat "1px solid var("
                 (string-concat (surface-var-prefix surface) "-border)")))

(defn glass-shadow-value [level :string] :string
  ;; `(:box-shadow (glass-shadow-decls level))` — elevation drop-shadow plus
  ;; the asymmetric two-tone rim edge light (top brighter than bottom).
  (string-join "" "var(--liquid-glass-elevation-" level "-shadow),"
               "inset 0 1px 0 rgba(255,255,255,var(--liquid-glass-specular-rim-top-opacity)),"
               "inset 0 -1px 0 rgba(255,255,255,var(--liquid-glass-specular-rim-bottom-opacity))"))

;; --- focus ring -----------------------------------------------------------

(defn focus-halo-value [] :string
  "0 0 0 var(--liquid-glass-focus-halo-width) var(--liquid-glass-focus-halo-color)")

(defn focus-outline-value [] :string
  "var(--liquid-glass-focus-ring-width) solid var(--liquid-glass-focus-ring-color)")

(defn focus-outline-offset-value [] :string
  "var(--liquid-glass-focus-ring-offset)")

(defn focus-box-shadow-value [level :string] :string
  ;; `(:box-shadow (focus-decls level))`. "" is the `.cljc` nil arm (a
  ;; component with no elevation of its own). box-shadow REPLACES rather
  ;; than composes, so a levelled surface has to re-emit its elevation +
  ;; rim under the halo or the glass edge vanishes exactly on focus.
  (let [halo (focus-halo-value)]
    (if (= 1 (string=? level ""))
      halo
      (string-concat halo
                     (string-concat "," (glass-shadow-value level))))))

;; --- motion / transition values -------------------------------------------

(defn base-transition-value [] :string
  (string-join "" "transform var(--liquid-glass-motion-press-duration) var(--liquid-glass-motion-press-easing),"
               "box-shadow var(--liquid-glass-motion-settle-duration) var(--liquid-glass-motion-settle-easing),"
               "filter var(--liquid-glass-motion-press-duration) var(--liquid-glass-motion-press-easing)"))

(defn tab-transition-value [] :string
  (string-join "" "opacity var(--liquid-glass-motion-press-duration) var(--liquid-glass-motion-press-easing),"
               "background var(--liquid-glass-motion-press-duration) var(--liquid-glass-motion-press-easing)"))

(defn press-transform-value [] :string
  ;; A squash (wider + shorter), not a uniform scale — glass giving under a
  ;; fingertip.
  (string-join "" "translateY(0) scaleX(var(--liquid-glass-motion-press-scale-x))"
               " scaleY(var(--liquid-glass-motion-press-scale-y))"))

(defn settle-transition-value [property :string] :string
  ;; The settle shorthand the toggle track / thumb / progress fill /
  ;; disclosure chevron rules all share.
  (string-join "" property
               " var(--liquid-glass-motion-settle-duration) var(--liquid-glass-motion-settle-easing)"))

(defn spring-transition-value [] :string
  "transform var(--liquid-glass-motion-spring-duration) var(--liquid-glass-motion-spring-easing)")

;; --- specular gradients ---------------------------------------------------

(defn specular-before-background [] :string
  ;; The shared `::before` sheen on every glass surface root.
  (string-join "" "radial-gradient(120% 60% at 18% -10%,"
               "rgba(255,255,255,var(--liquid-glass-specular-highlight-opacity)) 0%,rgba(255,255,255,0) 65%)"))

(defn specular-pointer-background [] :string
  ;; The pointer-tracking highlight, gated behind `.liquid-glass-js`.
  (string-join "" "radial-gradient(var(--liquid-glass-specular-pointer-size) circle at "
               "calc(var(--liquid-glass-pointer-x,.5)*100%) "
               "calc(var(--liquid-glass-pointer-y,.5)*100%),"
               "rgba(255,255,255,var(--liquid-glass-specular-pointer-opacity)) 0%,"
               "rgba(255,255,255,0) 70%)"))

;; --- overlay presence animations ------------------------------------------

(defn overlay-enter-animation [keyframe :string] :string
  (string-join "" keyframe " var(--liquid-glass-motion-overlay-enter-duration)"
               " var(--liquid-glass-motion-overlay-enter-easing) both"))

(defn overlay-exit-animation [keyframe :string] :string
  (string-join "" keyframe " var(--liquid-glass-motion-overlay-exit-duration)"
               " var(--liquid-glass-motion-overlay-exit-easing) both"))

;; --- keyframe transforms --------------------------------------------------

(defn sheet-out-transform [] :string
  (string-join "" "translateY(var(--liquid-glass-motion-overlay-enter-distance))"
               " scale(var(--liquid-glass-motion-overlay-enter-scale))"))

(defn alert-out-transform [] :string
  ;; The centering translate is folded into every frame: an animation's
  ;; transform replaces the rule transform, so plain translateY keyframes
  ;; would un-center the alert mid-flight.
  (string-join "" "translate(-50%,calc(-50% + var(--liquid-glass-motion-overlay-enter-distance)))"
               " scale(var(--liquid-glass-motion-overlay-enter-scale))"))

(defn menu-out-transform [] :string
  "scaleY(var(--liquid-glass-motion-overlay-enter-scale-y))")

;; --- whole at-rule blocks -------------------------------------------------

(defn lens-backdrop-value [] :string
  ;; The `.liquid-glass--lens` upgrade: the plain regular backdrop chain with
  ;; the SVG displacement filter appended (blur/saturate stay in the value so
  ;; an engine that parses url() but ignores it at paint still renders the
  ;; plain-blur material).
  (string-concat (backdrop-filter-value "regular") " url(#liquid-glass-lens)"))

(defn lens-supports-css [] :string
  (let [v (lens-backdrop-value)]
    (string-join "" "@supports (backdrop-filter: url(#liquid-glass-lens)) { "
                 ".liquid-glass--lens { backdrop-filter: " v
                 "; -webkit-backdrop-filter: " v "; } }")))

(defn spring-supports-css [] :string
  ;; The `linear()` spring settle upgrade. Three rules; only the button rule
  ;; keeps the box-shadow/filter legs of the base transition.
  (let [spring (spring-transition-value)
        button (string-join "" spring ","
                            "box-shadow var(--liquid-glass-motion-settle-duration) var(--liquid-glass-motion-settle-easing),"
                            "filter var(--liquid-glass-motion-press-duration) var(--liquid-glass-motion-press-easing)")]
    (string-join "" "@supports (transition-timing-function: linear(0, 1)) { "
                 ".liquid-glass__button,.liquid-glass__icon-button { transition: "
                 button "; } .liquid-glass__toggle-thumb { transition: "
                 spring "; } .liquid-glass__disclosure-chevron { transition: "
                 spring "; } }")))

;; --- cascade layer + inline embed -----------------------------------------

(defn layer-order [] :string
  "@layer kotoba.hig, kotoba.glass;")

(defn layered-css [css :string] :string
  ;; `.cljc` 1-arity. The 0-arity (which builds root-css + component-css) is
  ;; host-side — see the collection/renderer notes at the top.
  (string-join "" (layer-order) "\n@layer kotoba.glass {\n" css "\n}"))

(defn inline-style [css :string] :string
  (string-join "" "<style>\n" css "\n</style>"))

(defn main []
  (string-byte-length
   (inline-style
    (layered-css
     (string-concat (lens-supports-css) (spring-supports-css))))))
