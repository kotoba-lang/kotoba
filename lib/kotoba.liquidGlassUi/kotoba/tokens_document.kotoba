(ns liquid-glass-tokens-document
  ;; Delivery 6 fourth cutover (css → html → shitsuke → **liquid-glass-ui**):
  ;; Logical token-group `:document` → `--liquid-glass-*` CSS-var stream.
  ;; Form-A `tokens_core.kotoba` remains oracle. ≤4 value params on recursion.
  ;; Capability-free (kotoba/pure). spring-linear-easing stays host-side.
  ;; T5.2 + document-in-record (compiler 7691b1ae): multi-arg pure with
  ;; :document fields fold into guest records.
  (:schemas {:lgdoc/entry [:record :lgdoc/entry
                           [[:name :keyword] [:value :string]]]
             :lgdoc/group [:record :lgdoc/group
                           [[:group :string] [:entries :document]]]
             :lgdoc/nested [:record :lgdoc/nested
                            [[:group :string] [:name :string] [:props :document]]]
             :lgdoc/render-from [:record :lgdoc/render-from
                                 [[:doc :document] [:index :i64] [:acc :string]]]
             :lgdoc/line-from [:record :lgdoc/line-from
                               [[:group :document] [:entry :document]]]
             :lgdoc/join-nl [:record :lgdoc/join-nl
                             [[:a :string] [:b :string]]]}))

(defn entry [x [:ref :lgdoc/entry]] :document
  (let [name (record-get x :name)
        value (record-get x :value)]
    (document-map :name (document-keyword name)
                  :value (document-string value))))

(defn group-doc [x [:ref :lgdoc/group]] :document
  (let [group (record-get x :group)
        entries (record-get x :entries)]
    (document-map :prefix (document-string "liquid-glass")
                  :group (document-string group)
                  :entries entries)))

(defn nested-doc [x [:ref :lgdoc/nested]] :document
  (let [group (record-get x :group)
        k (record-get x :name)
        props (record-get x :props)]
    (document-map :prefix (document-string "liquid-glass")
                  :group (document-string group)
                  :name (document-string k)
                  :nested (document-bool true)
                  :props props)))

(defn str-field [d :document k :keyword] :string
  (option-or
    (document-string-value
      (option-or (document-get d k) (document-null)))
    ""))

(defn name-of-entry [d :document] :string
  (keyword-name
   (option-or
     (document-keyword-value
       (option-or (document-get d :name) (document-null)))
     :missing)))

(defn value-of-entry [d :document] :string
  (str-field d :value))

(defn entries-of [d :document] :document
  (option-or (document-get d :entries) (document-vector)))

(defn props-of [d :document] :document
  (option-or (document-get d :props) (document-vector)))

(defn nested? [d :document] :bool
  (option-or
    (document-bool-value
      (option-or (document-get d :nested) (document-null)))
    false))

(defn decl [name :string value :string] :string
  (string-concat "  "
                 (string-concat name
                                (string-concat ": "
                                               (string-concat value ";")))))

(defn join-nl [x [:ref :lgdoc/join-nl]] :string
  (let [a (record-get x :a)
        b (record-get x :b)]
    (string-concat a (string-concat "\n" b))))

(defn css-var-name2 [group :string k :string] :string
  (string-concat "--liquid-glass-"
                 (string-concat group (string-concat "-" k))))

(defn scalar-line [x [:ref :lgdoc/line-from]] :string
  (let [d (record-get x :group)
        e (record-get x :entry)]
    (decl (css-var-name2 (str-field d :group) (name-of-entry e))
          (value-of-entry e))))

(defn nested-line [x [:ref :lgdoc/line-from]] :string
  (let [d (record-get x :group)
        e (record-get x :entry)]
    (decl (string-concat (css-var-name2 (str-field d :group) (str-field d :name))
                         (string-concat "-" (name-of-entry e)))
          (value-of-entry e))))

(defn render-entries-from [x [:ref :lgdoc/render-from]] :string
  (let [d (record-get x :doc)
        i (record-get x :index)
        acc (record-get x :acc)
        entries (entries-of d)
        n (document-count entries)]
    (if (>= i n)
      acc
      (let [line (scalar-line
                  (record-new [:ref :lgdoc/line-from]
                              d
                              (option-or (document-vector-at entries i)
                                         (document-null))))
            next (if (string=? acc "") line
                     (join-nl (record-new [:ref :lgdoc/join-nl] acc line)))]
        (render-entries-from
         (record-new [:ref :lgdoc/render-from] d (+ i 1) next))))))

(defn render-props-from [x [:ref :lgdoc/render-from]] :string
  (let [d (record-get x :doc)
        i (record-get x :index)
        acc (record-get x :acc)
        props (props-of d)
        n (document-count props)]
    (if (>= i n)
      acc
      (let [line (nested-line
                  (record-new [:ref :lgdoc/line-from]
                              d
                              (option-or (document-vector-at props i)
                                         (document-null))))
            next (if (string=? acc "") line
                     (join-nl (record-new [:ref :lgdoc/join-nl] acc line)))]
        (render-props-from
         (record-new [:ref :lgdoc/render-from] d (+ i 1) next))))))

(defn render-group [d :document] :string
  (if (nested? d)
    (render-props-from (record-new [:ref :lgdoc/render-from] d 0 ""))
    (render-entries-from (record-new [:ref :lgdoc/render-from] d 0 ""))))

(defn root-css [body :string] :string
  (string-concat ":root {\n"
                 (string-concat body "\n}")))

(defn dark-root-css [body :string] :string
  (string-concat "@media (prefers-color-scheme: dark) {\n:root {\n"
                 (string-concat body "\n}\n}")))

;; --- sample corpora (match form-A tokens_core sample-*) -------------------

(defn sample-radius-doc [] :document
  (group-doc
   (record-new [:ref :lgdoc/group] "radius"
    (document-vector
     (entry (record-new [:ref :lgdoc/entry] :lg "24px"))
     (entry (record-new [:ref :lgdoc/entry] :md "16px"))
     (entry (record-new [:ref :lgdoc/entry] :pill "999px"))
     (entry (record-new [:ref :lgdoc/entry] :sm "10px"))))))

(defn sample-accent-doc [] :document
  (group-doc
   (record-new [:ref :lgdoc/group] "accent"
    (document-vector
     (entry (record-new [:ref :lgdoc/entry] :tint "rgba(10,132,255,0.55)"))
     (entry (record-new [:ref :lgdoc/entry] :tint-strong "rgba(10,132,255,0.85)"))))))

(defn sample-ink-doc [] :document
  (group-doc
   (record-new [:ref :lgdoc/group] "ink"
    (document-vector
     (entry (record-new [:ref :lgdoc/entry] :default "#1c1c1e"))
     (entry (record-new [:ref :lgdoc/entry] :shadow "0 1px 2px rgba(255,255,255,.4)"))))))

(defn sample-lens-doc [] :document
  (group-doc
   (record-new [:ref :lgdoc/group] "lens"
    (document-vector
     (entry (record-new [:ref :lgdoc/entry] :frequency "0.008"))
     (entry (record-new [:ref :lgdoc/entry] :octaves "2"))
     (entry (record-new [:ref :lgdoc/entry] :scale "8"))))))

(defn sample-regular-surface-doc [] :document
  (nested-doc
   (record-new [:ref :lgdoc/nested] "surface" "regular"
    (document-vector
     (entry (record-new [:ref :lgdoc/entry] :blur "20px"))
     (entry (record-new [:ref :lgdoc/entry] :border "rgba(255,255,255,0.35)"))
     (entry (record-new [:ref :lgdoc/entry] :saturate "180%"))
     (entry (record-new [:ref :lgdoc/entry] :tint "rgba(255,255,255,0.14)"))))))

(defn sample-press-motion-doc [] :document
  (nested-doc
   (record-new [:ref :lgdoc/nested] "motion" "press"
    (document-vector
     (entry (record-new [:ref :lgdoc/entry] :duration "120ms"))
     (entry (record-new [:ref :lgdoc/entry] :easing "cubic-bezier(.32,.72,0,1)"))
     (entry (record-new [:ref :lgdoc/entry] :scale-x "1.02"))
     (entry (record-new [:ref :lgdoc/entry] :scale-y ".95"))))))

(defn sample-light-root [] :string
  (root-css
   (join-nl
    (record-new [:ref :lgdoc/join-nl]
                (render-group (sample-regular-surface-doc))
                (join-nl
                 (record-new [:ref :lgdoc/join-nl]
                             (render-group (sample-radius-doc))
                             (join-nl
                              (record-new [:ref :lgdoc/join-nl]
                                          (render-group (sample-accent-doc))
                                          (join-nl
                                           (record-new [:ref :lgdoc/join-nl]
                                                       (render-group (sample-lens-doc))
                                                       (join-nl
                                                        (record-new [:ref :lgdoc/join-nl]
                                                                    (render-group (sample-ink-doc))
                                                                    (render-group (sample-press-motion-doc))))))))))))))

(defn sample-dark-ink-doc [] :document
  (group-doc
   (record-new [:ref :lgdoc/group] "ink"
    (document-vector
     (entry (record-new [:ref :lgdoc/entry] :default "#f5f5f7"))
     (entry (record-new [:ref :lgdoc/entry] :shadow "0 1px 3px rgba(0,0,0,.45)"))))))

(defn sample-dark-regular-surface-doc [] :document
  (nested-doc
   (record-new [:ref :lgdoc/nested] "surface" "regular"
    (document-vector
     (entry (record-new [:ref :lgdoc/entry] :border "rgba(255,255,255,0.12)"))
     (entry (record-new [:ref :lgdoc/entry] :tint "rgba(20,20,24,0.42)"))))))

(defn sample-dark-root [] :string
  (dark-root-css
   (join-nl
    (record-new [:ref :lgdoc/join-nl]
                (render-group (sample-dark-regular-surface-doc))
                (render-group (sample-dark-ink-doc))))))

(defn group-digest [d :document] :string
  (document-sha256 d))

(defn group-print [d :document] :string
  (document-print d))

(defn group-read [s :string] :document
  (document-read s))

(defn main []
  (string-byte-length
   (join-nl
    (record-new [:ref :lgdoc/join-nl]
                (sample-light-root) (sample-dark-root)))))
