(ns liquid-glass-tokens-core
  ;; No :export: parity harness appends zero-arg case defns via KIR.
  (:schemas {;; T5.2 native guest record: multi-arg pure → single record
             :lg/css-var-name [:record :lg/css-var-name
                               [[:group :string] [:k :string]]]
             :lg/decl [:record :lg/decl
                       [[:name :string] [:value :string]]]
             :lg/scalar-decl [:record :lg/scalar-decl
                              [[:group :string] [:k :string] [:value :string]]]
             :lg/nested-decl [:record :lg/nested-decl
                              [[:group :string] [:k :string]
                               [:prop :string] [:value :string]]]
             :lg/join-nl [:record :lg/join-nl
                          [[:a :string] [:b :string]]]
             :lg/group-from [:record :lg/group-from
                             [[:group :string]
                              [:decls [:map :keyword :string]]
                              [:index :i64]
                              [:acc :string]]]
             :lg/group-css [:record :lg/group-css
                            [[:group :string]
                             [:decls [:map :keyword :string]]]]
             :lg/nested-from [:record :lg/nested-from
                              [[:group :string]
                               [:k :string]
                               [:props [:map :keyword :string]]
                               [:index :i64]
                               [:acc :string]]]
             :lg/nested-css [:record :lg/nested-css
                             [[:group :string]
                              [:k :string]
                              [:props [:map :keyword :string]]]]}))

;; A `.kotoba` port of the string-producing core of `liquid-glass.tokens`
;; (ADR-2607270100 §10, form A). No capabilities: token → CSS custom
;; properties is data → text, so this module sits in kotoba/pure.
;;
;; Recursive token maps, deep-merge, and spring-linear-easing (needs f64
;; Math) stay on the .cljc side. This port receives already-resolved
;; (group, name, value) strings / flat `[:map :keyword :string]` groups
;; and composes the same `--liquid-glass-*` declaration lines
;; `liquid-glass.tokens` emits. Nested surface/elevation/specular/motion
;; entries use prop suffixes (`--liquid-glass-surface-regular-blur`).
;;
;; Map walks use `typed-map-entry-at` (sorted by key). Parity is asserted
;; against key-sorted runs of the .cljc original (same finding as
;; css/html/shitsuke).
;; T5.2: multi-arg pure folded into single guest records.

;; --- names + declarations -------------------------------------------------

(defn css-var-name [x [:ref :lg/css-var-name]] :string
  (let [group (record-get x :group)
        k (record-get x :k)]
    (string-concat "--liquid-glass-"
                   (string-concat group
                                  (string-concat "-" k)))))

(defn decl [x [:ref :lg/decl]] :string
  (let [name (record-get x :name)
        value (record-get x :value)]
    (string-concat "  "
                   (string-concat name
                                  (string-concat ": "
                                                 (string-concat value ";"))))))

(defn scalar-decl [x [:ref :lg/scalar-decl]] :string
  (let [group (record-get x :group)
        k (record-get x :k)
        value (record-get x :value)]
    (decl (record-new [:ref :lg/decl]
                      (css-var-name (record-new [:ref :lg/css-var-name] group k))
                      value))))

(defn nested-decl [x [:ref :lg/nested-decl]] :string
  (let [group (record-get x :group)
        k (record-get x :k)
        prop (record-get x :prop)
        value (record-get x :value)]
    (decl (record-new [:ref :lg/decl]
                      (string-concat (css-var-name (record-new [:ref :lg/css-var-name] group k))
                                     (string-concat "-" prop))
                      value))))

(defn join-nl [x [:ref :lg/join-nl]] :string
  (let [a (record-get x :a)
        b (record-get x :b)]
    (string-concat a (string-concat "\n" b))))

;; --- flat group emission (radius, accent, lens, ink) ----------------------

(defn group-from [x [:ref :lg/group-from]] :string
  (let [group (record-get x :group)
        decls (record-get x :decls)
        index (record-get x :index)
        acc (record-get x :acc)]
    (match-option (typed-map-entry-at [:map :keyword :string] decls index)
                  [:option [:vector [:keyword :string]]]
                  (none acc)
                  (some entry
                        (group-from
                         (record-new [:ref :lg/group-from]
                                     group decls (+ index 1)
                                     (if (string=? acc "")
                                       (scalar-decl
                                        (record-new [:ref :lg/scalar-decl]
                                                    group
                                                    (keyword-name
                                                     (hetero-vector-at [:vector [:keyword :string]] entry 0))
                                                    (hetero-vector-at [:vector [:keyword :string]] entry 1)))
                                       (join-nl
                                        (record-new [:ref :lg/join-nl]
                                                    acc
                                                    (scalar-decl
                                                     (record-new [:ref :lg/scalar-decl]
                                                                 group
                                                                 (keyword-name
                                                                  (hetero-vector-at [:vector [:keyword :string]] entry 0))
                                                                 (hetero-vector-at [:vector [:keyword :string]] entry 1))))))))))))

(defn group-css [x [:ref :lg/group-css]] :string
  (let [group (record-get x :group)
        decls (record-get x :decls)]
    (group-from (record-new [:ref :lg/group-from] group decls 0 ""))))

;; Nested expansion: one variant/style name → N prop lines.

(defn nested-from [x [:ref :lg/nested-from]] :string
  (let [group (record-get x :group)
        k (record-get x :k)
        props (record-get x :props)
        index (record-get x :index)
        acc (record-get x :acc)]
    (match-option (typed-map-entry-at [:map :keyword :string] props index)
                  [:option [:vector [:keyword :string]]]
                  (none acc)
                  (some entry
                        (nested-from
                         (record-new [:ref :lg/nested-from]
                                     group k props (+ index 1)
                                     (if (string=? acc "")
                                       (nested-decl
                                        (record-new [:ref :lg/nested-decl]
                                                    group k
                                                    (keyword-name
                                                     (hetero-vector-at [:vector [:keyword :string]] entry 0))
                                                    (hetero-vector-at [:vector [:keyword :string]] entry 1)))
                                       (join-nl
                                        (record-new [:ref :lg/join-nl]
                                                    acc
                                                    (nested-decl
                                                     (record-new [:ref :lg/nested-decl]
                                                                 group k
                                                                 (keyword-name
                                                                  (hetero-vector-at [:vector [:keyword :string]] entry 0))
                                                                 (hetero-vector-at [:vector [:keyword :string]] entry 1))))))))))))

(defn nested-css [x [:ref :lg/nested-css]] :string
  (let [group (record-get x :group)
        k (record-get x :k)
        props (record-get x :props)]
    (nested-from (record-new [:ref :lg/nested-from] group k props 0 ""))))

(defn root-css [body :string] :string
  (string-concat ":root {\n"
                 (string-concat body "\n}")))

;; Dark scheme: redeclare only the scheme-sensitive vars under a media query
;; (same shape as liquid-glass.tokens/dark-css-variables).

(defn dark-root-css [body :string] :string
  (string-concat "@media (prefers-color-scheme: dark) {\n:root {\n"
                 (string-concat body "\n}\n}")))

;; --- representative light / dark sample corpora ---------------------------
;; Slices of default-tokens / dark-tokens used by the parity gate. Full
;; spring-linear-easing and the complete motion matrix stay on the .cljc side.

(defn sample-radius [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :lg "24px" :md "16px" :pill "999px" :sm "10px"))

(defn sample-accent [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :tint "rgba(10,132,255,0.55)"
                 :tint-strong "rgba(10,132,255,0.85)"))

(defn sample-ink [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :default "#1c1c1e"
                 :shadow "0 1px 2px rgba(255,255,255,.4)"))

(defn sample-lens [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :frequency "0.008" :octaves "2" :scale "8"))

(defn sample-regular-surface [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :blur "20px"
                 :border "rgba(255,255,255,0.35)"
                 :saturate "180%"
                 :tint "rgba(255,255,255,0.14)"))

(defn sample-press-motion [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :duration "120ms"
                 :easing "cubic-bezier(.32,.72,0,1)"
                 :scale-x "1.02"
                 :scale-y ".95"))

(defn sample-light-root [] :string
  (root-css
   (join-nl
    (record-new [:ref :lg/join-nl]
                (nested-css (record-new [:ref :lg/nested-css]
                                        "surface" "regular" (sample-regular-surface)))
                (join-nl
                 (record-new [:ref :lg/join-nl]
                             (group-css (record-new [:ref :lg/group-css]
                                                    "radius" (sample-radius)))
                             (join-nl
                              (record-new [:ref :lg/join-nl]
                                          (group-css (record-new [:ref :lg/group-css]
                                                                 "accent" (sample-accent)))
                                          (join-nl
                                           (record-new [:ref :lg/join-nl]
                                                       (group-css (record-new [:ref :lg/group-css]
                                                                              "lens" (sample-lens)))
                                                       (join-nl
                                                        (record-new [:ref :lg/join-nl]
                                                                    (group-css (record-new [:ref :lg/group-css]
                                                                                           "ink" (sample-ink)))
                                                                    (nested-css (record-new [:ref :lg/nested-css]
                                                                                            "motion" "press"
                                                                                            (sample-press-motion)))))))))))))))

(defn sample-dark-ink [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :default "#f5f5f7"
                 :shadow "0 1px 3px rgba(0,0,0,.45)"))

(defn sample-dark-regular-surface [] [:map :keyword :string]
  (typed-map-new [:map :keyword :string]
                 :border "rgba(255,255,255,0.12)"
                 :tint "rgba(20,20,24,0.42)"))

(defn sample-dark-root [] :string
  (dark-root-css
   (join-nl
    (record-new [:ref :lg/join-nl]
                (nested-css (record-new [:ref :lg/nested-css]
                                        "surface" "regular" (sample-dark-regular-surface)))
                (group-css (record-new [:ref :lg/group-css]
                                       "ink" (sample-dark-ink)))))))

(defn main []
  (string-byte-length
   (join-nl
    (record-new [:ref :lg/join-nl]
                (sample-light-root) (sample-dark-root)))))
