;; Port of ctf.model (model.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from model.cljk:
;;   - routes and levels are zero-arg functions (cross-module constants are
;;     not exportable in amu). levels is a :document set.
;;   - `(or (:routes opts) routes)`: nil and false both give the default.
;;   - `(vec routes)` and `(set categories)` are not applied: the given value
;;     is kept as is (a nil categories gives the empty set, as in the source).

(ns ctf.model
  (:export [routes levels request result]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- null-doc? [d :document] :bool
  (string=? (document-edn-print d) (document-edn-print (document-null))))

(defn- or-default [v :document d :document] :document
  (if (or (null-doc? v) (document-equal? v (document-bool false)))
    d
    v))

(defn routes [] :document
  (document-vector (document-keyword :malak) (document-keyword :yabai)))

(defn levels [] :document
  (document-set (document-keyword :clear) (document-keyword :monitor)
                (document-keyword :challenge) (document-keyword :deny)
                (document-keyword :review)))

(defn request [id :document subject :document opts :document] :document
  (document-map :ctf/id id
                :ctf/subject subject
                :ctf/purpose (field opts :purpose)
                :ctf/case-ref (field opts :case-ref)
                :ctf/routes (or-default (field opts :routes) (routes))
                :ctf/requested-at (field opts :requested-at)))

(defn result [req :document route :document level :document opts :document] :document
  (document-map :ctf/id (field req :ctf/id)
                :ctf/route route
                :ctf/level level
                :ctf/score (field opts :score)
                :ctf/categories (or-default (field opts :categories) (document-set))
                :ctf/evidence-ref (field opts :evidence-ref)
                :ctf/asserter (field opts :asserter)
                :ctf/observed-at (field opts :observed-at)
                :ctf/non-adjudicating (document-bool true)))
