;; Port of ctf.datom (datom.cljk), Kotoba-native, :document maps.
;;
;; Each emitter returns a :document vector of one flat-namespaced map, as the
;; source returns a vector of one map. Both are non-adjudicating records.
;;
;; Named divergences from datom.cljk:
;;   - a missing key or a non-map record reads as document-null, as nil is in
;;     the source. Values are kept as given (document-null when absent).
;;   - :db/id of result-datoms: (str id ":" (name route)) in the source. str of
;;     nil is "", a string is itself, any other value is its canonical EDN text;
;;     name of a keyword or string is its name (namespace dropped); any other
;;     route value gives its EDN text (the source throws on it).
;;   - screening-datoms keeps :db/id as the id value (not a string), as the
;;     source does; :ctf/non-adjudicating is always true there.

(ns ctf.datom
  (:export [result-datoms screening-datoms]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- null-doc? [d :document] :bool
  (string=? (document-edn-print d) (document-edn-print (document-null))))

(defn- str-of [v :document] :string
  (if (null-doc? v)
    ""
    (option-or (document-string-value v) (document-edn-print v))))

(defn- name-of [v :document] :string
  (if (option-some?-of [:option :keyword] (document-keyword-value v))
    (keyword-name (option-value-of [:option :keyword] (document-keyword-value v) :none))
    (str-of v)))

(defn result-datoms [r :document] :document
  (document-vector
   (document-map :db/id (document-string (string-concat (str-of (field r :ctf/id))
                                                        (string-concat ":" (name-of (field r :ctf/route)))))
                 :ctf/id (field r :ctf/id)
                 :ctf/route (field r :ctf/route)
                 :ctf/level (field r :ctf/level)
                 :ctf/score (field r :ctf/score)
                 :ctf/categories (field r :ctf/categories)
                 :ctf/evidence-ref (field r :ctf/evidence-ref)
                 :ctf/asserter (field r :ctf/asserter)
                 :ctf/observed-at (field r :ctf/observed-at)
                 :ctf/non-adjudicating (field r :ctf/non-adjudicating))))

(defn screening-datoms [s :document] :document
  (document-vector
   (document-map :db/id (field s :ctf/id)
                 :ctf/status (field s :ctf/status)
                 :ctf/case-ref (field s :ctf/case-ref)
                 :ctf/routes (field s :ctf/routes)
                 :ctf/non-adjudicating (document-bool true))))
