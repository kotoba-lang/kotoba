(ns ctf.model-test (:export [main]) (:require [ctf.model :as m]))

(defn- fstr [d :document k :keyword] :string
  (option-or (document-string-value (option-or (document-get d k) (document-null))) "?"))

(defn- fedn [d :document k :keyword] :string
  (document-edn-print (option-or (document-get d k) (document-null))))

(defn- fcount [d :document k :keyword] :i64
  (document-count (option-or (document-get d k) (document-null))))

(defn- main-case [] :i64
  (let [req (m/request (document-string "C1") (document-string "subj")
                       (document-map :purpose (document-string "p")))
        req2 (m/request (document-string "C2") (document-string "subj")
                        (document-map :routes (document-vector (document-keyword :yabai))))
        res (m/result req (document-keyword :malak) (document-keyword :deny)
                      (document-map :score (document-i64 5)))]
    (+ (if (string=? (fstr req :ctf/id) "C1") 0 1)
       (if (string=? (fstr req :ctf/purpose) "p") 0 1)
       (if (= (fcount req :ctf/routes) 2) 0 1)
       (if (= (fcount req2 :ctf/routes) 1) 0 1)
       (if (string=? (fedn res :ctf/level) ":deny") 0 1)
       (if (string=? (fedn res :ctf/route) ":malak") 0 1)
       (if (string=? (fedn res :ctf/non-adjudicating) "true") 0 1)
       (if (= (fcount res :ctf/categories) 0) 0 1))))

(defn main [] :i64
  (+ (main-case)
     (if (= (document-count (m/routes)) 2) 0 1)
     (if (= (document-count (m/levels)) 5) 0 1)
     (if (document-set-contains? (m/levels) (document-keyword :deny)) 0 1)))
