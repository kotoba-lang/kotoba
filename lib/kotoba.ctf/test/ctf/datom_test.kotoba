(ns ctf.datom-test (:export [main]) (:require [ctf.datom :as p]))

(defn- fstr [d :document k :keyword] :string
  (option-or (document-string-value (option-or (document-get d k) (document-null))) "?"))

(defn- fedn [d :document k :keyword] :string
  (document-edn-print (option-or (document-get d k) (document-null))))

(defn- first-row [v :document] :document
  (option-or (document-vector-at v 0) (document-null)))

(defn- result-case [] :i64
  (let [r (document-map :ctf/id (document-string "CASE-7")
                        :ctf/route (document-keyword :api)
                        :ctf/level (document-i64 2)
                        :ctf/score (document-i64 42)
                        :ctf/categories (document-vector (document-string "pwn"))
                        :ctf/evidence-ref (document-string "ev:1")
                        :ctf/asserter (document-string "bot")
                        :ctf/observed-at (document-string "t0")
                        :ctf/non-adjudicating (document-bool true))
        v (p/result-datoms r)
        d (first-row v)]
    (+ (if (= (document-count v) 1) 0 1)
       (if (string=? (fstr d :db/id) "CASE-7:api") 0 1)
       (if (string=? (fedn d :ctf/score) "42") 0 1)
       (if (string=? (fedn d :ctf/route) ":api") 0 1)
       (if (string=? (fstr d :ctf/evidence-ref) "ev:1") 0 1)
       (if (string=? (fedn d :ctf/non-adjudicating) "true") 0 1)
       (if (string=? (fedn d :ctf/level) "2") 0 1))))

(defn- screening-case [] :i64
  (let [s (document-map :ctf/id (document-string "CASE-7")
                        :ctf/status (document-keyword :open)
                        :ctf/case-ref (document-string "C-1")
                        :ctf/routes (document-vector (document-keyword :api)))
        v (p/screening-datoms s)
        d (first-row v)]
    (+ (if (= (document-count v) 1) 0 1)
       (if (string=? (fstr d :db/id) "CASE-7") 0 1)
       (if (string=? (fedn d :ctf/status) ":open") 0 1)
       (if (string=? (fstr d :ctf/case-ref) "C-1") 0 1)
       (if (string=? (fedn d :ctf/non-adjudicating) "true") 0 1))))

(defn main [] :i64
  (+ (result-case) (screening-case)))
