;; Test for com-backblaze-secure.config. main returns the number of failed cases.
(ns com-backblaze-secure.config-test
  (:export [main])
  (:require [com-backblaze-secure.config :as c]))

(defn- chk [ok :bool] :i64
  (if ok 0 1))

(defn- cfg [] :document
  (document-map :buckets
                (document-map (document-string "photos") (document-map :capabilities (document-edn-read "#{:list :read}"))
                              (document-string "logs") (document-map :capabilities (document-edn-read "#{:write}")))))

(defn- grants [] :i64
  (let [g (cfg)]
    (+ (chk (c/capability-granted? g (document-string "photos") (document-keyword :read)))
       (+ (chk (not (c/capability-granted? g (document-string "photos") (document-keyword :write))))
          (+ (chk (not (c/capability-granted? g (document-string "nope") (document-keyword :read))))
             (chk (c/capability-granted? g (document-string "logs") (document-keyword :write))))))))

(defn- allowed [] :i64
  (let [g (cfg)]
    (+ (chk (document-equal? (c/allowed-buckets g) (document-edn-read "#{\"logs\" \"photos\"}")))
       (+ (chk (document-equal? (c/allowed-buckets-granting g (document-keyword :write)) (document-edn-read "#{\"logs\"}")))
          (chk (document-equal? (c/allowed-buckets-granting g (document-keyword :delete)) (document-edn-read "#{}")))))))

(defn- messages [] :i64
  (let [g (cfg)]
    (+ (chk (document-equal? (c/require-capability! g (document-string "photos") (document-keyword :read)) (document-null)))
       (+ (chk (document-equal? (c/require-capability! g (document-string "photos") (document-keyword :bogus))
                                (document-string "unknown capability: :bogus")))
          (+ (chk (document-equal? (c/require-capability! g (document-string "nope") (document-keyword :read))
                                   (document-string "bucket not allowlisted: \"nope\"")))
             (chk (document-equal? (c/require-capability! g (document-string "photos") (document-keyword :write))
                                   (document-string "capability :write not granted for bucket photos"))))))))

(defn main [] :i64
  (+ (grants) (+ (allowed) (messages))))
