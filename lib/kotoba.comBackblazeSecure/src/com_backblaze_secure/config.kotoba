;; Port of com-backblaze-secure.config (config.cljk), Kotoba-native.
;;
;; Bucket allowlist and capability gate. Pure validation, no I/O.
;; Named divergences:
;;   - allowed-buckets (1 and 2 arity) is split: allowed-buckets returns all
;;     configured buckets, allowed-buckets-granting filters by capability
;;     (a null capability means all buckets, as nil did in the source).
;;   - the result set is built from sorted canonical text (set-of), so it is
;;     sorted like the source's sorted-set.
;;   - "truthy" follows Clojure: a null or false bucket config is absent.
(ns com-backblaze-secure.config
  (:export [capabilities bucket-config capability-granted? allowed-buckets
            allowed-buckets-granting require-capability!]))

(defn- lookup [m :document k :document] :document
  (if (= (document-kind m) :map)
    (option-value-of [:option :document] (document-get m k) (document-null))
    (document-null)))

(defn- item [v :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at v i) (document-null)))

(defn- truthy-doc [d :document] :bool
  (cond (= (document-kind d) :null) false
        (= (document-kind d) :bool) (option-value-of [:option :bool] (document-bool-value d) true)
        :else true))

(defn- display [d :document] :string
  (if (= (document-kind d) :string)
    (option-value-of [:option :string] (document-string-value d) "")
    (document-edn-print d)))

(defn- coll-items [v :document] :document
  (let [t (document-edn-print v)
        n (string-length t)]
    (if (= (document-kind v) :set)
      (document-edn-read (string-concat "[" (string-concat (string-substring t 2 (- n 1)) "]")))
      (document-edn-read (string-concat "[" (string-concat (string-substring t 1 (- n 1)) "]"))))))

;; Canonical set of the items of vector xs. Map keys are kept in canonical
;; text order and deduplicated by document-assoc, so the keys read back in
;; order give the set's canonical text.
(defn- key-at [m :document i :i64] :document
  (option-value-of [:option :document]
                   (document-vector-at (option-value-of [:option :document] (document-map-entry-at m i) (document-null)) 0)
                   (document-null)))

(defn- set-of [xs :document] :document
  (let [n (document-count xs)
        m (loop [i 0 acc (document-map)]
            (if (>= i n)
              acc
              (recur (+ i 1) (document-assoc acc (option-value-of [:option :document] (document-vector-at xs i) (document-null)) (document-null)))))
        k (document-count m)]
    (document-edn-read
     (loop [i 0 acc "#{"]
       (if (>= i k)
         (string-concat acc "}")
         (let [t (document-edn-print (key-at m i))]
           (recur (+ i 1) (if (string=? acc "#{")
                            (string-concat acc t)
                            (string-concat (string-concat acc " ") t)))))))))

(defn capabilities [] :document
  (document-edn-read "#{:delete :list :read :write}"))

(defn bucket-config [config :document bucket :document] :document
  (lookup (lookup config (document-keyword :buckets)) bucket))

(defn capability-granted? [config :document bucket :document capability :document] :bool
  (let [caps (lookup (bucket-config config bucket) (document-keyword :capabilities))]
    (and (= (document-kind caps) :set) (document-set-contains? caps capability))))

(defn allowed-buckets-granting [config :document capability :document] :document
  (let [buckets (lookup config (document-keyword :buckets))
        n (document-count buckets)]
    (loop [i 0 names (document-vector)]
      (if (>= i n)
        (set-of names)
        (let [entry (option-value-of [:option :document] (document-map-entry-at buckets i) (document-null))
              name (item entry 0)]
          (recur (+ i 1)
                 (if (or (= (document-kind capability) :null)
                         (capability-granted? config name capability))
                   (document-vector-conj names name)
                   names)))))))

(defn allowed-buckets [config :document] :document
  (allowed-buckets-granting config (document-null)))

(defn- known-capability? [c :document] :bool
  (document-set-contains? (capabilities) c))

(defn require-capability! [config :document bucket :document capability :document] :document
  (cond
    (not (known-capability? capability))
    (document-string (string-concat "unknown capability: " (document-edn-print capability)))

    (not (truthy-doc (bucket-config config bucket)))
    (document-string (string-concat "bucket not allowlisted: " (document-edn-print bucket)))

    (not (capability-granted? config bucket capability))
    (document-string (string-concat (string-concat (string-concat "capability " (display capability))
                                                   " not granted for bucket ")
                                    (display bucket)))

    :else (document-null)))
