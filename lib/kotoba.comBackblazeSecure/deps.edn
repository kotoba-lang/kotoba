{:paths ["src"]
 ;; The actual server (src/com_backblaze_secure/server.cljk,
 ;; credentials.cljs, b2_cli.cljs, audit.cljs) is Node-only (child_process/fs)
 ;; and runs under nbb — see README for the exact kbb --backend sci --classpath invocation.
 ;; This deps.edn exists so the portable .cljc namespaces (redact.cljc,
 ;; config.cljc — the security-critical pure logic) are also test/lint-able
 ;; on the JVM, same pattern as kotoba-lang/mcp's own deps.edn.
 :deps {
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/mcp {:local/root "../com.anthropic.mcp"}
        io.github.kotoba-lang/secret-resolve {:local/root "../kotoba.secretResolve"}}
 :aliases
 {:test {:extra-paths ["test"]}}}