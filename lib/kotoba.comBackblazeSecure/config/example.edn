;; com-backblaze-secure config — copy to config/com-backblaze-secure.edn
;; (gitignored) and edit. Only buckets listed here are reachable by any MCP
;; tool call; only capabilities listed under a bucket are granted. Adding a
;; bucket/capability here is a deliberate human decision — this server never
;; widens its own access.
;;
;; :credentials follows the exact shape/precedence as this workspace's
;; manifest/repos.edn :b2 :credentials (env → 1password → keychain). Only
;; reference paths/service names go here — never a raw key or secret value.
{:buckets
 {"gftdcojp-m365-annex"
  {;; :list/:read only by default — :write/:delete are opt-in per bucket.
   :capabilities #{:list :read}
   :credentials
   {:order [:env :1password :keychain]
    :env {:key-id "B2_KEY_ID" :app-key "B2_APP_KEY"}
    :1password {:key-id "op://gftdcojp/com-junkawasaki.b2_annex/keyID"
                :app-key "op://gftdcojp/com-junkawasaki.b2_annex/applicationKey"}
    :keychain {:service "b2:gftdcojp-m365-annex"}}}}

 :audit {:path "~/.com-backblaze-secure/audit.jsonl"}}
