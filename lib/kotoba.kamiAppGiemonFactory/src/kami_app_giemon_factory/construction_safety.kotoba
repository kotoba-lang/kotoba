(ns kami-app-giemon-factory.construction-safety
  (:export [validate]))

;; [step-count element-count robot-count, element-id..., robot-id...,
;;  seq robot-id reveal-count reveal-1 reveal-2 ...]
;; Result: -1 malformed, 0 structurally invalid, 1 valid.
(defn robot-base [data :vector-i64] :i64 (+ 3 (vector-at data 1)))
(defn step-base [data :vector-i64] :i64
  (+ 3 (vector-at data 1) (vector-at data 2)))
(defn step-offset [data :vector-i64 index :i64] :i64
  (+ (step-base data) (* index 5)))
(defn positive-range? [data :vector-i64 start :i64 length :i64 index :i64] :bool
  (if (= index length) true
    (if (> (vector-at data (+ start index)) 0)
      (positive-range? data start length (+ index 1)) false)))
(defn unique-elements? [data :vector-i64 left :i64 right :i64] :bool
  (if (= left (vector-at data 1)) true
    (if (= right (vector-at data 1))
      (unique-elements? data (+ left 1) (+ left 2))
      (if (= (vector-at data (+ 3 left)) (vector-at data (+ 3 right))) false
        (unique-elements? data left (+ right 1))))))
(defn unique-robots? [data :vector-i64 left :i64 right :i64] :bool
  (if (= left (vector-at data 2)) true
    (if (= right (vector-at data 2))
      (unique-robots? data (+ left 1) (+ left 2))
      (if (= (vector-at data (+ (robot-base data) left))
             (vector-at data (+ (robot-base data) right))) false
        (unique-robots? data left (+ right 1))))))
(defn element-exists? [data :vector-i64 wanted :i64 index :i64] :bool
  (if (= index (vector-at data 1)) false
    (if (= wanted (vector-at data (+ 3 index))) true
      (element-exists? data wanted (+ index 1)))))
(defn robot-exists? [data :vector-i64 wanted :i64 index :i64] :bool
  (if (= index (vector-at data 2)) false
    (if (= wanted (vector-at data (+ (robot-base data) index))) true
      (robot-exists? data wanted (+ index 1)))))
(defn valid-reveals? [reveal-count-value :i64 reveal-one :i64 reveal-two :i64] :bool
  (if (= reveal-count-value 0)
    (if (= reveal-one 0) (if (= reveal-two 0) true false) false)
    (if (= reveal-count-value 1)
      (if (> reveal-one 0) (if (= reveal-two 0) true false) false)
      (if (= reveal-count-value 2)
        (if (> reveal-one 0) (if (> reveal-two 0) true false) false)
        false))))
(defn valid-step-encoding? [data :vector-i64 index :i64] :bool
  (if (= index (vector-at data 0)) true
    (let [offset (step-offset data index)
          sequence-value (vector-at data offset)
          robot-id-value (vector-at data (+ offset 1))
          reveal-count-value (vector-at data (+ offset 2))
          reveal-one (vector-at data (+ offset 3))
          reveal-two (vector-at data (+ offset 4))]
      (if (or (<= sequence-value 0) (<= robot-id-value 0)) false
        (if (valid-reveals? reveal-count-value reveal-one reveal-two)
          (valid-step-encoding? data (+ index 1)) false)))))
(defn steps-resolve? [data :vector-i64 index :i64] :bool
  (if (= index (vector-at data 0)) true
    (let [offset (step-offset data index)
          sequence-value (vector-at data offset)
          robot-id-value (vector-at data (+ offset 1))
          reveal-count-value (vector-at data (+ offset 2))
          reveal-one (vector-at data (+ offset 3))
          reveal-two (vector-at data (+ offset 4))]
      (if (= sequence-value (+ index 1))
        (if (robot-exists? data robot-id-value 0)
          (if (> reveal-count-value 0)
            (if (element-exists? data reveal-one 0)
              (if (> reveal-count-value 1)
                (if (element-exists? data reveal-two 0)
                  (steps-resolve? data (+ index 1)) false)
                (steps-resolve? data (+ index 1)))
              false)
            (steps-resolve? data (+ index 1)))
          false)
        false))))
(defn validate [data :vector-i64] :i64
  (if (< (vector-count data) 3) -1
    (let [step-count-value (vector-at data 0)
          element-count-value (vector-at data 1)
          robot-count-value (vector-at data 2)]
      (if (or (< step-count-value 0) (> step-count-value 4)) -1
        (if (or (< element-count-value 0) (> element-count-value 8)) -1
          (if (or (< robot-count-value 0) (> robot-count-value 4)) -1
            (if (= (vector-count data)
                   (+ 3 element-count-value robot-count-value
                      (* step-count-value 5)))
              (if (positive-range? data 3 element-count-value 0)
                (if (positive-range? data (robot-base data) robot-count-value 0)
                  (if (unique-elements? data 0 1)
                    (if (unique-robots? data 0 1)
                      (if (valid-step-encoding? data 0)
                        (if (steps-resolve? data 0) 1 0) -1)
                      -1)
                    -1)
                  -1)
                -1)
              -1)))))))
