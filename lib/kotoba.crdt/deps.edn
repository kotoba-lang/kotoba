{:paths ["src" "resources"]
 ;; One dependency, and it is not an implementation detail: it is what makes
 ;; `src/kotoba/crdt/clock.kotoba` the thing that RUNS.
 ;;
 ;; Portable .cljc, still pure data + pure functions — no network, no storage,
 ;; no actor identity. Hosts (kotobase append/read for transport, kotoba.editor
 ;; for undo/redo UI, slides/docs/sheets web events for the concrete document
 ;; schema) own every effect; this package only knows how to merge.
 ;;
 ;; The KIR interpreter is a RUNTIME dependency: `kotoba.crdt.kotoba-oracle`
 ;; executes the shipped `resources/kotoba/crdt/oracle/*.kir.edn` through it, so
 ;; the rules in `clock.kotoba` and `register.kotoba` are what this library runs
 ;; rather than what a test compares against. What it buys is the end of the
 ;; second implementation: `clock.cljc` no longer computes
 ;; `max(local, received) + 1` or the actor tiebreak, and `register.cljc` no
 ;; longer computes the LWW winner — they ask the shipped cores. The COMPILER
 ;; stays test-only (see :test) — it produced the artifacts and never reaches a
 ;; consumer.
 ;;
 ;; `orset.kotoba` and `doc.kotoba` are NOT shipped as artifacts and keep their
 ;; parity gates: both hold a collection whose size is the user's document, and
 ;; the interpreter refuses one past a node limit (measured: 11 orset elements,
 ;; 5 doc entities). That is a property of those cores, not a missing step.
 ;;
 ;; Pinned to the kir the pinned compiler emits for
 ;; (`io.github.kotoba-lang/amu` 1e6dbb17 declares kotoba-kir 838cd77c).
 ;; They have to match: KIR is a versioned document, and an interpreter reading
 ;; a shape its emitter did not write is exactly the failure the artifact was
 ;; supposed to remove.
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/pprint {:local/root "../kotoba.pprint"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.osaho"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "1e6dbb17d314cf45d3dd6796a6a9d5cb84b437b2"}}}
  :coverage {:extra-paths ["test"]
             :extra-deps {
                          ;; The parity, conformance and drift tests compile
                          ;; `.kotoba`; without this the alias cannot even load
                          ;; its test namespaces, which is how it stood before
                          ;; and why it reported nothing at all.
                          io.github.kotoba-lang/amu
                          {:git/url "https://github.com/kotoba-lang/amu.git"
                           :git/sha "1e6dbb17d314cf45d3dd6796a6a9d5cb84b437b2"}}
             :main-opts ["-m" "cloverage.coverage"
                         "--ns-regex" "kotoba\\.crdt\\..*"
                         "--test-ns-regex" "kotoba\\.crdt\\..*-test"
                         "--src-ns-path" "src"
                         "--test-ns-path" "test"
                         "--no-html"
                         "--text"
                         "--fail-threshold" "90"]}}}
