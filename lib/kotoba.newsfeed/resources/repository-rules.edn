;; Which workspace contract this repo claims to satisfy.
;; The authority it is checked against is the superproject's
;; manifest/repository-rules.edn (ADR-2607299000).
{:schema "kotoba.repository-role-rules.v0"
 :vocabulary :name-prefix
 :prefix ""                       ; no prefix — a reusable library
 :role :library
 ;; Not resident. It holds no clock and no loop: something else decides when
 ;; to ingest. loop-ka-production already owns cadence for this fleet, and a
 ;; second scheduler would be a second answer to "is it time yet".
 :execution :none
 :must [:parse-syndication-feeds :normalise-to-article-datoms :rank-per-channel]
 :must-not [:hold-a-loop :hold-a-publishing-key :generate-prose]}
