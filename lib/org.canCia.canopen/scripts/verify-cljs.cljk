#!/usr/bin/env kbb
;; Run the suite on the ClojureScript side.
;;
;; Not a formality. `canopen.pdo`'s bit-packer and `canopen.cob-id`'s
;; 11-bit field composition both use `bit-or`/`bit-shift-left` — safely
;; inside JavaScript's 32-bit signed bitwise range, but the round-trip
;; sweeps are the thing that actually proves it on the runtime whose
;; bitwise operators are the ones with a 32-bit ceiling in the first
;; place.
;;
;;   kbb --backend sci --classpath "$(kbb -A:cljs -Spath)" scripts/verify-cljs.cljk
(ns verify-cljs
  (:require [kotoba.test :as t]
            [canopen.core-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println)
  (if (t/successful? m)
    (println "all checks passed on the ClojureScript path")
    (do (println "FAILED on the ClojureScript path")
        (js/process.exit 1))))

(t/run-tests 'canopen.core-test)
