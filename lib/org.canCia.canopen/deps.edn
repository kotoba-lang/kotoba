;; No dependencies. CANopen's application layer is a COB-ID bitfield, an
;; NMT byte, an SDO command-specifier byte, a PDO bit-packed data stream
;; and an EMCY frame — a leaf that dragged a SocketCAN or vendor CAN
;; driver binding behind it would defeat the point, the same reason
;; org-sae-j1939 (the CAN-based sibling this depends structurally on
;; nothing from, despite sharing a bus) has none either.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
