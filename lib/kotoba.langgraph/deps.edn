{:paths ["src"]
 ;; Only dependency is langchain-clj (itself zero-dep, all .cljc) —
 ;; the same layering as upstream langchain-core / langgraph (ADR-0001).
 ;; Bumped past langchain#7/#8: parse-query's malformed-adjacent-marker
 ;; misparse fix and transact!'s swap!-retry-safety fix (the latter is
 ;; directly consequential here -- datomic-checkpointer's -put! calls
 ;; transact! for every superstep write). Also past langchain#9 (bumps
 ;; kotoba-lang/json to pick up decode's number-grammar validation fix)
 ;; -- consequential for kotoba-checkpoint's XRPC-backed checkpointer,
 ;; which goes through langchain.kotoba-db's JSON codec.
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/json {:local/root "../kotoba.json"}
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/langchain {:local/root "../kotoba.langchain"}}
 :aliases
 {:test {:extra-paths ["test"]}
  ;; local checkout for workspace development (orgs/kotoba-lang/*)
  :dev {:override-deps {io.github.kotoba-lang/langchain
                        {:local/root "../langchain"}}}}}
