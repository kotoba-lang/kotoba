;; The parity fixture for langgraph.core: nine scenarios over one small state
;; graph, each a zero-arity export that folds its final checkpoint into ONE
;; i64 code, and a `test-*` per scenario pinning that code. The oracle side
;; (test/langgraph/core_parity_test.cljk) runs the same nine scenarios through
;; langgraph.graph and folds its result with the same `code`; the two files
;; pin the same literals (test/langgraph/kotoba/expected.edn), which is what
;; parity means here. The guest runs on the KIR interpreter and wasm32 through
;; `amu test --source-path src`, and natively through
;; `scripts/verify-kotoba-core.cljk` (compile -> extract-native -> kexe loader),
;; where each `sN` export is executed and its printed value compared.
;;
;; code = ((((count * 1000 + step) * 10 + status) * 100 + fcount * 10 + f0)
;;         * 1000000) + trace
;;   status: done 1, interrupted 2, running 3, recursion-limit 4,
;;           unknown-node 5, no-entry 6, frontier-overflow 7
;;   fcount / f0: the frontier's length and first node id (0 when empty)
;;   trace: decimal digits of (id + 1) for every node execution, in order
;;
;; state S {count trace}: node 0 adds 1, node 1 adds 10, node 2 adds 100,
;; node 3 adds 1000; every node appends (id + 1) to the trace.
;; graph (node-count 4): 0 -> 1 static; 1 routes to itself while count < 30,
;; then END; 2 -> 3 static; 3 -> END static. Scenarios add edges of their own.
(ns langgraph.kotoba.scenarios
  (:require [langgraph.core :as lg :with {state [:record :langgraph.kotoba.scenarios/S [[:count :i64] [:trace :i64]]]}])
  (:export [main s1 s2 s3 s4 s5 s6 s7 s8 s9
            test-s1 test-s2 test-s3 test-s4 test-s5 test-s6 test-s7 test-s8 test-s9]))

(defrecord S [count :i64 trace :i64])

(defn- node [id :i64 step :i64 s [:record :langgraph.kotoba.scenarios/S [[:count :i64] [:trace :i64]]]] [:record :langgraph.kotoba.scenarios/S [[:count :i64] [:trace :i64]]]
  (->S (+ (:count s) (if (= id 0) 1 (if (= id 1) 10 (if (= id 2) 100 1000))))
       (+ (* 10 (:trace s)) (+ id 1))))

(defn- route [id :i64 s [:record :langgraph.kotoba.scenarios/S [[:count :i64] [:trace :i64]]]] :i64
  (if (= id 1)
    (if (< (:count s) 30) (lg/pack-conj (lg/pack-empty) 1) (lg/pack-conj (lg/pack-empty) (lg/end-id)))
    (lg/no-route)))

;; 0->1, 2->3, 3->END
(defn- edges [] :vector-i64
  (vector-conj (vector-conj (vector-conj (vector-conj (vector-conj (vector-conj (vector-new) 0) 1) 2) 3) 3) (lg/end-id)))

(defn- one [id :i64] :i64 (lg/pack-conj (lg/pack-empty) id))

(defn- g [entry :i64 limit :i64 ib :i64 ia :i64] [:record :langgraph.core/Graph [[:entry :i64] [:limit :i64] [:ibefore :i64] [:iafter :i64] [:node-count :i64]]]
  (lg/graph entry limit ib ia 4))

(defn- status-digit [k :keyword] :i64
  (if (= k :done) 1 (if (= k :interrupted) 2 (if (= k :running) 3 (if (= k :recursion-limit) 4
    (if (= k :unknown-node) 5 (if (= k :no-entry) 6 (if (= k :frontier-overflow) 7 0))))))))

(defn- code [ck [:record :langgraph.core/Ckpt [[:st [:record :langgraph.kotoba.scenarios/S [[:count :i64] [:trace :i64]]]] [:step :i64] [:frontier :i64] [:status :keyword]]]] :i64
  (let [fr (lg/ck-frontier ck)
        fcount (lg/pack-count fr)
        f0 (if (= 0 fcount) 0 (lg/pack-at fr 0))]
    (+ (* (+ (* (+ (* (+ (* (:count (lg/ck-st ck)) 1000) (lg/ck-step ck)) 10) (status-digit (lg/ck-status ck))) 100) (+ (* fcount 10) f0)) 1000000)
       (:trace (lg/ck-st ck)))))

(defn- run [gr [:record :langgraph.core/Graph [[:entry :i64] [:limit :i64] [:ibefore :i64] [:iafter :i64] [:node-count :i64]]]
            e :vector-i64
            ck [:record :langgraph.core/Ckpt [[:st [:record :langgraph.kotoba.scenarios/S [[:count :i64] [:trace :i64]]]] [:step :i64] [:frontier :i64] [:status :keyword]]]]
  [:record :langgraph.core/Ckpt [[:st [:record :langgraph.kotoba.scenarios/S [[:count :i64] [:trace :i64]]]] [:step :i64] [:frontier :i64] [:status :keyword]]]
  (lg/run gr e (fn [id step s] (node id step s)) (fn [id s] (route id s)) ck))

;; s1: entry 0, run to completion: 0, then 1 three times (count 1, 11, 21, 31)
(defn s1 [] :i64
  (let [gr (g (one 0) 25 0 0)]
    (code (run gr (edges) (lg/start gr (->S 0 0))))))

;; s2: fan-out. entry [0 2]: superstep 0 runs 0 then 2; successors [1 3];
;; superstep 1 runs 1 (count -> 111, so 1 routes END) then 3.
(defn s2 [] :i64
  (let [gr (g (lg/pack-conj (one 0) 2) 25 0 0)]
    (code (run gr (edges) (lg/start gr (->S 0 0))))))

;; s3: interrupt-before 1: stops after 0 with frontier [1]
(defn s3 [] :i64
  (let [gr (g (one 0) 25 (one 1) 0)]
    (code (run gr (edges) (lg/start gr (->S 0 0))))))

;; s4: s3 then resume once: 1 runs once, then its self-loop hits the gate again
(defn s4 [] :i64
  (let [gr (g (one 0) 25 (one 1) 0)
        ck1 (run gr (edges) (lg/start gr (->S 0 0)))]
    (code (run gr (edges) ck1))))

;; s5: interrupt-after 0: stops after superstep 0 with frontier [1], step 1
(defn s5 [] :i64
  (let [gr (g (one 0) 25 0 (one 0))]
    (code (run gr (edges) (lg/start gr (->S 0 0))))))

;; s6: recursion limit 2: the self-loop on 1 cannot finish
(defn s6 [] :i64
  (let [gr (g (one 0) 2 0 0)]
    (code (run gr (edges) (lg/start gr (->S 0 0))))))

;; s7: unknown node: entry names node 9 of a 4-node graph
(defn s7 [] :i64
  (let [gr (g (one 9) 25 0 0)]
    (code (run gr (edges) (lg/start gr (->S 0 0))))))

;; s8: update-state on the interrupted thread of s3, then resume to done:
;; count edited to 25 -> 1 runs once (35), routes END
(defn s8 [] :i64
  (let [gr (g (one 0) 25 (one 1) 0)
        ck1 (run gr (edges) (lg/start gr (->S 0 0)))
        ck2 (lg/with-state ck1 (->S 25 (:trace (lg/ck-st ck1))))]
    (code (run gr (edges) ck2))))

;; s9: a finished thread run again continues from the entry with its state
;; and step: 0 (count 32), 1 (42) routes END
(defn s9 [] :i64
  (let [gr (g (one 0) 25 0 0)
        ck1 (run gr (edges) (lg/start gr (->S 0 0)))]
    (code (run gr (edges) ck1))))

(defn main [] :i64 (s1))

(defn test-s1 [] :i64 (if (= (s1) 31004100001222) 1 0))
(defn test-s2 [] :i64 (if (= (s2) 1111002100001324) 1 0))
(defn test-s3 [] :i64 (if (= (s3) 1001211000001) 1 0))
(defn test-s4 [] :i64 (if (= (s4) 11002211000012) 1 0))
(defn test-s5 [] :i64 (if (= (s5) 1001211000001) 1 0))
(defn test-s6 [] :i64 (if (= (s6) 21003411000122) 1 0))
(defn test-s7 [] :i64 (if (= (s7) 519000000) 1 0))
(defn test-s8 [] :i64 (if (= (s8) 35003100000012) 1 0))
(defn test-s9 [] :i64 (if (= (s9) 42006100122212) 1 0))
