(ns unicode.core-test
  (:require [kotoba.test :refer [deftest is testing]]
            [unicode.utf8 :as utf8]
            [unicode.normalize :as norm]))

;; ---- UTF-8 (§3.9) ----------------------------------------------------------

(deftest encode-known-byte-sequences
  ;; U+0041 LATIN CAPITAL LETTER A -> 41
  (is (= [0x41] (utf8/encode 0x41)))
  ;; U+00E9 LATIN SMALL LETTER E WITH ACUTE -> C3 A9
  (is (= [0xC3 0xA9] (utf8/encode 0xE9)))
  ;; U+20AC EURO SIGN -> E2 82 AC
  (is (= [0xE2 0x82 0xAC] (utf8/encode 0x20AC)))
  ;; U+1F600 EMOJI -> F0 9F 98 80
  (is (= [0xF0 0x9F 0x98 0x80] (utf8/encode 0x1F600))))

(deftest encode-rejects-non-scalars
  (testing "surrogates are not scalar values (§3.9 D91)"
    (is (thrown-with-msg? #?(:clj Throwable :cljs js/Error) #"surrogate" (utf8/encode 0xD800)))
    (is (thrown-with-msg? #?(:clj Throwable :cljs js/Error) #"surrogate" (utf8/encode 0xDFFF))))
  (testing "beyond the scalar range"
    (is (thrown-with-msg? #?(:clj Throwable :cljs js/Error) (re-pattern "scalar") (utf8/encode 0x110000)))
    (is (thrown-with-msg? #?(:clj Throwable :cljs js/Error) (re-pattern "scalar") (utf8/encode -1)))))

(deftest decode-round-trips
  (let [cps [0x41 0xE9 0x20AC 0x1F600 0x10FFFF 0x7F 0x80 0x7FF 0x800 0xFFFF]]
    (is (= cps (utf8/decode (mapcat utf8/encode cps))))))

(deftest decode-rejects-malformed-by-definition
  (testing "C0/C1 lead bytes are overlong by definition (Table 3-7)"
    (is (thrown-with-msg? #?(:clj Throwable :cljs js/Error) #"invalid leading byte" (utf8/decode [0xC0 0xAF])))
    (is (thrown-with-msg? #?(:clj Throwable :cljs js/Error) #"invalid leading byte" (utf8/decode [0xC1 0xBF]))))
  (testing "ED A0.. encodes surrogates — not well-formed"
    (is (thrown-with-msg? #?(:clj Throwable :cljs js/Error) #"surrogate" (utf8/decode [0xED 0xA0 0x80]))))
  (testing "F4 90.. is beyond U+10FFFF"
    (is (thrown-with-msg? #?(:clj Throwable :cljs js/Error) #"beyond" (utf8/decode [0xF4 0x90 0x80 0x80]))))
  (testing "overlong 3-byte: E0 80 80 decodes below U+0800"
    (is (thrown-with-msg? #?(:clj Throwable :cljs js/Error) #"overlong" (utf8/decode [0xE0 0x80 0x80]))))
  (testing "overlong 4-byte: F0 80 80 80 decodes below U+10000"
    (is (thrown-with-msg? #?(:clj Throwable :cljs js/Error) #"overlong" (utf8/decode [0xF0 0x80 0x80 0x80]))))
  (testing "truncated sequence"
    (is (thrown-with-msg? #?(:clj Throwable :cljs js/Error) #"malformed" (utf8/decode [0xE2 0x82])))))

;; ---- normalization (§3.11) with a minimal fixture char-db ------------------
;; Fixture characters (code points named so a reviewer can check the Standard):
;;   U+0041 A          starter, ccc 0
;;   U+0301 COMBINING ACUTE ACCENT  ccc 230
;;   U+0316 COMBINING GRAVE ACCENT BELOW ccc 220
;;   U+00C5 LATIN CAPITAL A WITH RING ABOVE — canonical decomposition [U+0041 U+030A]
;;   U+030A COMBINING RING ABOVE  ccc 230
;;   U+FB01 LATIN SMALL LIGATURE FI — compatibility decomposition [U+0066 U+0069]
;; Composition pair in fixture: [U+0041 U+030A] -> U+00C5 (primary composite)

(def fixture-db
  {:ccc {0x0301 230 0x0316 220 0x030A 230}
   :canonical-decomp {0x00C5 [0x0041 0x030A]}
   :compat-decomp {0x00C5 [0x0041 0x030A]
                   0xFB01 [0x0066 0x0069]}
   :composition {[0x0041 0x030A] 0x00C5}})

(deftest canonical-ordering-sorts-by-ccc
  ;; A + acute(230) + below(220): below must come first after the starter
  (is (= [0x41 0x0316 0x0301]
         (norm/canonical-order [0x41 0x0301 0x0316] fixture-db)))
  (testing "equal ccc keeps relative order (stable, §3.12)"
    (is (= [0x41 0x0301 0x030A]
           (norm/canonical-order [0x41 0x0301 0x030A] fixture-db)))))

(deftest nfd-decomposes-and-orders
  (is (= [0x41 0x030A] (norm/nfd [0x00C5] fixture-db)))
  (is (= [0x0041] (norm/nfd [0x41] fixture-db))))

(deftest nfkd-adds-compatibility-decomposition
  (is (= [0x0066 0x0069] (norm/nfkd [0xFB01] fixture-db))))

(deftest nfc-recomposes
  (is (= [0x00C5] (norm/nfc [0x41 0x030A] fixture-db)))
  (testing "non-composable pair stays decomposed"
    (is (= [0x41 0x0316] (norm/nfc [0x41 0x0316] fixture-db)))))

(deftest nfkc-through-compatibility
  ;; FB01 is compatibility-decomposed, then nothing composes it back
  (is (= [0x0066 0x0069] (norm/nfkc [0xFB01] fixture-db))))

(deftest nfc-idempotent
  (let [once (norm/nfc [0x41 0x030A 0x0316] fixture-db)]
    (is (= once (norm/nfc once fixture-db)))))
