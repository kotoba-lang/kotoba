(ns unicode.ucd-test
  (:require [kotoba.test :refer [deftest is]]
            [unicode.ucd :as ucd]
            [unicode.normalize :as norm]))

(def db {:ccc (into {} (map (fn [[cp {:keys [ccc]}]] [cp ccc])) ucd/ccc)
         :canonical-decomp (into {} (map (fn [[cp {:keys [decomp]}]] [cp decomp])) ucd/canonical-decomp)
         :compat-decomp (into {} (map (fn [[cp {:keys [decomp]}]] [cp decomp])) ucd/compat-decomp)
         :composition (ucd/primary-composition)})

(deftest ucd-carries-its-version
  ;; A table that cannot say which Standard it answers to is not usable data.
  (is (seq (get ucd/ucd :ucd/version)))
  (is (seq (get ucd/ucd :ucd/source))))

(deftest real-table-decompositions
  ;; U+00C5 -> A + RING ABOVE (UnicodeData.txt 00C5)
  (is (= [0x41 0x30A] (norm/nfd [0xC5] db)))
  ;; U+00C7 -> C + CEDILLA
  (is (= [0x43 0x327] (norm/nfd [0xC7] db))))

(deftest compatibility-fractions
  ;; U+00BD -> 2 / 3 (compatibility decomposition, <fraction>)
  (is (= [0x32 0x2044 0x33] (norm/nfkd [0xBD] db))))

(deftest primary-composition-excludes-exclusions
  (let [pc (ucd/primary-composition)]
    ;; A + RING ABOVE composes to U+00C5
    (is (= 0xC5 (get pc [0x41 0x30A])))
    ;; every listed exclusion is absent from the composition table
    (doseq [ex ucd/composition-exclusions]
      (is (not (some (fn [[_ cp]] (= cp ex)) pc))))))

(deftest ccc-ordering-through-real-table
  ;; A + acute(230) + cedilla-below? no — use grave-below(220) + acute(230):
  ;; canonical order puts ccc 220 before ccc 230 after the starter.
  (is (= [0x41 0x316 0x301] (norm/canonical-order [0x41 0x301 0x316] db))))
