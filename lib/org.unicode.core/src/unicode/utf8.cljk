;; Clean-room UTF-8 codec. Unicode Standard §3.9 (UTF-8), Table 3-7.
;; Written from the specification: the byte-prefix grammar, the overlong
;; exclusion (D92), and the surrogate exclusion. No tables.
(ns unicode.utf8)

;; ---- encode ---------------------------------------------------------------

(defn encode
  "Unicode scalar value -> UTF-8 bytes. §3.9 D92: surrogates (U+D800..U+DFFF)
   are not scalar values and are rejected, never encoded."
  [cp]
  (cond
    (not (or (and (>= cp 0) (<= cp 0x7F))
             (and (>= cp 0x80) (<= cp 0x7FF))
             (and (>= cp 0x800) (<= cp 0xFFFF))
             (and (>= cp 0x10000) (<= cp 0x10FFFF))))
    (throw (ex-info "not a Unicode scalar value"
                    {:phase :unicode/encode :cp cp}))
    (and (>= cp 0xD800) (<= cp 0xDFFF))
    (throw (ex-info "surrogate code point is not a scalar value (§3.9 D91)"
                    {:phase :unicode/encode :cp cp}))
    (<= cp 0x7F)
    [cp]
    (<= cp 0x7FF)
    [(bit-or 0xC0 (bit-shift-right cp 6))
     (bit-or 0x80 (bit-and cp 0x3F))]
    (<= cp 0xFFFF)
    [(bit-or 0xE0 (bit-shift-right cp 12))
     (bit-or 0x80 (bit-and (bit-shift-right cp 6) 0x3F))
     (bit-or 0x80 (bit-and cp 0x3F))]
    :else
    [(bit-or 0xF0 (bit-shift-right cp 18))
     (bit-or 0x80 (bit-and (bit-shift-right cp 12) 0x3F))
     (bit-or 0x80 (bit-and (bit-shift-right cp 6) 0x3F))
     (bit-or 0x80 (bit-and cp 0x3F))]))

;; ---- decode ---------------------------------------------------------------

(defn- continuation? [b] (and (>= b 0x80) (<= b 0xBF)))

(defn decode-next
  "Decode one sequence at `pos` in `bytes`. Returns [cp next-pos] or
   throws [:error reason pos]. Table 3-7 grammar, overlong excluded."
  [bytes pos]
  (let [b0 (nth bytes pos)]
    (cond
      ;; 1-byte: 0xxxxxxx
      (<= b0 0x7F) [b0 (inc pos)]
      ;; 2-byte: 110xxxxx 10xxxxxx — but NOT C0/C1 (overlong by definition)
      (and (>= b0 0xC2) (<= b0 0xDF))
      (let [b1 (nth bytes (inc pos) nil)]
        (when-not (and b1 (continuation? b1))
          (throw (ex-info "malformed 2-byte sequence: missing continuation"
                          {:phase :unicode/decode :reason :missing-continuation :pos pos})))
        (let [cp (bit-or (bit-shift-left (bit-and b0 0x1F) 6)
                         (bit-and b1 0x3F))]
          (when (< cp 0x80)
            (throw (ex-info "overlong encoding"
                            {:phase :unicode/decode :reason :overlong :pos pos})))
          [cp (+ pos 2)]))
      ;; 3-byte: 1110xxxx 10xxxxxx 10xxxxxx — ED/A0..BF are surrogates
      (and (>= b0 0xE0) (<= b0 0xEF))
      (let [b1 (nth bytes (inc pos) nil)
            b2 (nth bytes (+ pos 2) nil)]
        (when-not (and b1 (continuation? b1) b2 (continuation? b2))
          (throw (ex-info "malformed 3-byte sequence"
                          {:phase :unicode/decode :reason :missing-continuation :pos pos})))
        (let [cp (bit-or (bit-shift-left (bit-and b0 0x0F) 12)
                         (bit-shift-left (bit-and b1 0x3F) 6)
                         (bit-and b2 0x3F))]
          (cond
            (< cp 0x800)
            (throw (ex-info "overlong encoding"
                            {:phase :unicode/decode :reason :overlong :pos pos}))
            (and (>= cp 0xD800) (<= cp 0xDFFF))
            (throw (ex-info "surrogate encoded — not well-formed (§3.9)"
                            {:phase :unicode/decode :reason :surrogate :pos pos}))
            :else [cp (+ pos 3)])))
      ;; 4-byte: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx — F0 90.. is the 0x10000 floor
      (and (>= b0 0xF0) (<= b0 0xF4))
      (let [b1 (nth bytes (inc pos) nil)
            b2 (nth bytes (+ pos 2) nil)
            b3 (nth bytes (+ pos 3) nil)]
        (when-not (and b1 (continuation? b1) b2 (continuation? b2) b3 (continuation? b3))
          (throw (ex-info "malformed 4-byte sequence"
                          {:phase :unicode/decode :reason :missing-continuation :pos pos})))
        (let [cp (bit-or (bit-shift-left (bit-and b0 0x07) 18)
                         (bit-shift-left (bit-and b1 0x3F) 12)
                         (bit-shift-left (bit-and b2 0x3F) 6)
                         (bit-and b3 0x3F))]
          (cond
            (< cp 0x10000)
            (throw (ex-info "overlong encoding"
                            {:phase :unicode/decode :reason :overlong :pos pos}))
            (> cp 0x10FFFF)
            (throw (ex-info "beyond U+10FFFF (§3.9 D800..D8FF excluded)"
                            {:phase :unicode/decode :reason :out-of-range :pos pos}))
            :else [cp (+ pos 4)])))
      ;; C0/C1, F5..FF, or a stray continuation byte
      :else
      (throw (ex-info "invalid leading byte"
                      {:phase :unicode/decode :reason :invalid-lead-byte :pos pos})))))

(defn decode
  "Full decode; throws on the first malformed sequence (no silent U+FFFD)."
  [bytes]
  (loop [pos 0 out []]
    (if (>= pos (count bytes))
      out
      (let [[cp next] (decode-next bytes pos)]
        (recur next (conj out cp))))))
