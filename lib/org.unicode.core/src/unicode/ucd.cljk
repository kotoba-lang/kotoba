;; Versioned UCD table slice — tranche 2.
;;
;; This is REAL Unicode Character Database data for a documented subset,
;; transcribed from UnicodeData.txt of the stated version, with each entry's
;; code point named. It is deliberately small: the point of this file is the
;; SHAPE of a versioned table (source + version + per-entry citations), not
;; coverage. Growth happens by adding entries the same way, never by
;; approximating.
(ns unicode.ucd
  "Unicode Character Database slice. Version-stamped: every consumer can
   assert which standard the data answers to (§3.1 coverage requires it).")

(def ucd
  {:ucd/version "15.0.0"
   :ucd/source "UnicodeData.txt, Unicode Character Database"
   :ucd/transcribed "2026-09-05, by description — no upstream file vendored"})

;; Canonical combining classes (UnicodeData.txt field 3).
(def ccc
  {0x0300 {:name "COMBINING GRAVE ACCENT" :ccc 230}
   0x0301 {:name "COMBINING ACUTE ACCENT" :ccc 230}
   0x030A {:name "COMBINING RING ABOVE" :ccc 230}
   0x0316 {:name "COMBINING GRAVE ACCENT BELOW" :ccc 220}
   0x0327 {:name "COMBINING CEDILLA" :ccc 202}
   0x0328 {:name "COMBINING OGONEK" :ccc 202}})

;; Canonical decompositions (UnicodeData.txt field 5, <canonical> tags only).
(def canonical-decomp
  {0x00C0 {:name "LATIN CAPITAL LETTER A WITH GRAVE" :decomp [0x0041 0x0300]}
   0x00C1 {:name "LATIN CAPITAL LETTER A WITH ACUTE" :decomp [0x0041 0x0301]}
   0x00C5 {:name "LATIN CAPITAL LETTER A WITH RING ABOVE" :decomp [0x0041 0x030A]}
   0x00E0 {:name "LATIN SMALL LETTER A WITH GRAVE" :decomp [0x0061 0x0300]}
   0x00E9 {:name "LATIN SMALL LETTER E WITH ACUTE" :decomp [0x0065 0x0301]}
   0x00C7 {:name "LATIN CAPITAL LETTER C WITH CEDILLA" :decomp [0x0043 0x0327]}
   0x0104 {:name "LATIN CAPITAL LETTER A WITH OGONEK" :decomp [0x0041 0x0328]}})

;; Compatibility decompositions (field 5, <compat>/<fraction> etc. tags).
(def compat-decomp
  {0x00BC {:name "VULGAR FRACTION ONE QUARTER" :decomp [0x0031 0x2044 0x0034]}
   0x00BD {:name "VULGAR FRACTION ONE HALF" :decomp [0x0032 0x2044 0x0033]}
   0xFB01 {:name "LATIN SMALL LIGATURE FI" :decomp [0x0066 0x0069]}})

;; Composition exclusions (Composition_Exclusions.txt, Full_Composition_Exclusion).
;; Script_0028/0029 pairs of Hangul jamo and singleton decompositions; the
;; entries below are the Latin-1 range singletons flagged in the file.
(def composition-exclusions
  #{0x0340 0x0341 0x0343 0x0344 0x0F73 0x0F75 0x0F81})

(defn primary-composition
  "The primary composite table: canonical pairs, excluding those listed in
   composition-exclusions. Derived here so exclusion updates propagate."
  []
  (let [pairs (for [[cp {:keys [decomp]}] canonical-decomp
                    :when (= 2 (count decomp))
                    :let [[a b] decomp]]
                [[a b] cp])]
    (into {} (remove (fn [[_ cp]] (contains? composition-exclusions cp))) pairs)))
