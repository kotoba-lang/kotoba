;; Clean-room normalization-form algorithm model. Unicode §3.11 (Normalization
;; Forms), §3.12 (Canonical Ordering). Table data (canonical combining class,
;; decomposition mapping, composition exclusions) is a CHAR-DB ARGUMENT — this
;; repo specifies the algorithm, not the table mass.
(ns unicode.normalize)

;; ---- canonical ordering (§3.12) --------------------------------------------

(defn canonical-order
  "Reorder combining marks between starters by ascending canonical combining
   class (ccc). Stable for equal ccc (§3.12 D109). char-db: {:ccc {cp c}}"
  [seq* char-db]
  (let [ccc (fn [cp] (get (get char-db :ccc) cp 0))]
    (loop [out []
           pending []      ; combining marks since the last starter
           s seq*]
      (if-let [cp (first s)]
        (if (zero? (ccc cp))
          (recur (into out (sort-by ccc pending)) [cp] (rest s))
          (recur out (conj pending cp) (rest s)))
        ;; trailing group: reorder marks, keep starter first
        (if (empty? pending)
          (into out pending)
          (let [[starter & marks] pending]
            (into (conj out starter) (sort-by ccc marks))))))))

;; ---- decomposition (§3.7 / §3.11 D112-D115) --------------------------------

(defn decompose
  "Recursively apply the decomposition mapping. :nfd uses only canonical
   mappings; :nfkd additionally uses compatibility ones.
   char-db: {:canonical-decomp {cp [c...]}, :compat-decomp {cp [c...]}}"
  [seq* form char-db]
  (let [decomp-tables (if (= form :nfd)
                        (:canonical-decomp char-db)
                        (merge (:canonical-decomp char-db)
                               (:compat-decomp char-db)))]
    (loop [stack (vec (reverse seq*))
           out []]
      (if-let [cp (peek stack)]
        (let [rest (pop stack)
              m (get decomp-tables cp)]
          (if m
            (recur (into rest (reverse m)) out)
            (recur rest (conj out cp))))
        out))))

;; ---- composition (§3.11 F14) -----------------------------------------------

(defn compose
  "Primary composable pairs -> composed character. Composition exclusions
   are part of the char-db table, not special-cased here."
  [seq* char-db]
  (let [comp (get char-db :composition {})]
    (loop [out []
           s seq*]
      (if-let [cp (first s)]
        (let [prev (peek out)
              composed (when prev (get comp [prev cp]))]
          (if composed
            (recur (pop out) (into [composed] (rest s)))
            (recur (conj out cp) (rest s))))
        out))))

;; ---- the four forms (§3.11 D112-D115) --------------------------------------

(defn nfd  [seq* char-db] (canonical-order (decompose seq* :nfd char-db) char-db))
(defn nfkd [seq* char-db] (canonical-order (decompose seq* :nfkd char-db) char-db))

(defn nfc  [seq* char-db] (compose (nfd seq* char-db) char-db))
(defn nfkc [seq* char-db] (compose (nfkd seq* char-db) char-db))
