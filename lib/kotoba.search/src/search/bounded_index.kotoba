(ns search.bounded-index
  (:export [main empty-index add-document doc-count has-doc?
            doc-title-or field-weight-or]))

;; Bounded-profile port of search.model's INDEX STRUCTURE -- the name-keyed
;; document registry (doc-id -> {:title :body}) and the closed field-weight
;; table (:title 4 / :tags 3 / :body 1) -- NOT the search machinery.
;;
;; This header used to say tokenize/score-doc/search "need a codepoint/regex
;; string primitive kotoba-lang/compiler does not yet expose". That was an
;; implementation state, not a property, and it went stale: measured
;; 2026-09-08, string-code-point-at lowers on both backends, and the
;; tokenizer, term-count and score-doc are ported in
;; search/bounded_search.kotoba (migration/bounded-search-machinery-v1.edn).
;; search itself stays the CLJC oracle -- it returns a sorted COLLECTION of
;; scored documents, which this backend has no readable representation for.
;;
;; Uses kotoba-lang/compiler's canonical bounded typed-map -- [:map :string
;; :record] for the registry (record VALUE, same shape spice/atprotocol use)
;; -- and closed keyword membership for the field-weight vocabulary.

(defn make-doc [title :string body :string] [:record :search/doc [[:title :string] [:body :string]]]
  (record [:record :search/doc [[:title :string] [:body :string]]] title body))

(defn empty-index []
    [:map :string [:record :search/doc [[:title :string] [:body :string]]]]
  (typed-map-new [:map :string [:record :search/doc [[:title :string] [:body :string]]]]))

(defn add-document [idx [:map :string [:record :search/doc [[:title :string] [:body :string]]]]
                    id :string d [:record :search/doc [[:title :string] [:body :string]]]]
    [:map :string [:record :search/doc [[:title :string] [:body :string]]]]
  (typed-map-assoc [:map :string [:record :search/doc [[:title :string] [:body :string]]]]
                   idx id d))

(defn doc-count [idx [:map :string [:record :search/doc [[:title :string] [:body :string]]]]] :i64
  (typed-map-count [:map :string [:record :search/doc [[:title :string] [:body :string]]]] idx))

(defn has-doc? [idx [:map :string [:record :search/doc [[:title :string] [:body :string]]]]
                     id :string] :bool
  (typed-map-contains [:map :string [:record :search/doc [[:title :string] [:body :string]]]] idx id))

(defn doc-title-or [idx [:map :string [:record :search/doc [[:title :string] [:body :string]]]]
                         id :string fallback :string] :string
  (match-option
   (typed-map-get [:map :string [:record :search/doc [[:title :string] [:body :string]]]] idx id)
   [:option [:record :search/doc [[:title :string] [:body :string]]]]
   (none fallback)
   (some d (record-get [:record :search/doc [[:title :string] [:body :string]]] d :title))))

;; search.model/default-weights: {:title 4 :tags 3 :body 1}. = types as :i64,
;; so the closed lookup returns the weight directly (fallback for any other
;; field).
(defn field-weight-or [field :keyword fallback :i64] :i64
  (if (= field :title) 4
    (if (= field :tags) 3
      (if (= field :body) 1
        fallback))))

;; Self-conformance: replays search.model-test's seed-index shape -- add
;; "slides" (title "GFTD Slides") and "sheets" (title "GFTD Sheets"), assert
;; count, membership, title read-back, missing-doc fallback, and the closed
;; field weights.
(defn main [] :i64
  (let [idx (add-document (add-document (empty-index)
                            "slides" (make-doc "GFTD Slides" "deck body"))
                          "sheets" (make-doc "GFTD Sheets" "formula body"))]
    (if (= 2 (doc-count idx))
      (if (has-doc? idx "slides")
        (if (string=? "GFTD Slides" (doc-title-or idx "slides" "?"))
          (if (has-doc? idx "missing")
            1
            (if (string=? "?" (doc-title-or idx "missing" "?"))
              (if (= 4 (field-weight-or :title 0))
                (if (= 1 (field-weight-or :body 0))
                  (if (= 0 (field-weight-or :unknown 0))
                    42
                    1)
                  1)
                1)
              1))
          1)
        1)
      1)))
