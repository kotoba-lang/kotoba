(ns search.validate
  ;; Kotoba port of `search.validate` — the same document-problem semantics,
  ;; one problem shape for every finding:
  ;;
  ;;   {:search/severity :error|:warning
  ;;    :search/code     :doc/id-key-mismatch | :doc/missing-title
  ;;    :search/id       the document's map key
  ;;    :search/msg      the same message strings the .cljc emits}
  ;;
  ;; Pure values only: no capability, no host call. The one structural change
  ;; is the index itself. The .cljc walks a map of id -> doc; Kotoba has no
  ;; map-entry iteration, so the guest index carries `:search/docs` as a
  ;; VECTOR of entry documents, each `{:search/entry-key <kw>
  ;; :search/entry-doc <doc>}` — the pair the .cljc `for` destructured.
  ;; `problems` preserves the .cljc's result order by making two passes over
  ;; that vector: every id-key mismatch first, then every missing title,
  ;; entry order intact within each pass.
  (:export [problem problems valid?]))

(defn problem [severity :keyword code :keyword id :keyword msg :string] :document
  (document-map :search/severity (document-keyword severity)
                :search/code (document-keyword code)
                :search/id (document-keyword id)
                :search/msg (document-string msg)))

(defn entry-at [entries :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at entries i)
                   (document-null)))

(defn entry-key [entry :document] :keyword
  ;; Two steps, as the todo-app guest does: unwrap the option-document from
  ;; `document-get`, then read the keyword scalar out of it.
  (option-value-of [:option :keyword]
                   (document-keyword-value
                    (option-value-of [:option :document]
                                     (document-get entry :search/entry-key)
                                     (document-null)))
                   :search/missing))

(defn entry-doc [entry :document] :document
  (option-value-of [:option :document] (document-get entry :search/entry-doc)
                   (document-null)))

(defn doc-id [doc :document] :keyword
  ;; The .cljc reads `(:search/id doc)` directly: an absent key reads as nil,
  ;; which `not=` reports against any map key. The guest fallback keyword
  ;; can never equal a real key, so it reproduces that verdict.
  (option-value-of [:option :keyword]
                   (document-keyword-value
                    (option-value-of [:option :document]
                                     (document-get doc :search/id)
                                     (document-null)))
                   :search/missing))

(defn doc-title [doc :document] :string
  ;; The .cljc warns when the title is nil OR the empty string; both collapse
  ;; to the guest fallback, so one comparison covers both.
  (option-value-of [:option :string]
                   (document-string-value
                    (option-value-of [:option :document]
                                     (document-get doc :search/title)
                                     (document-null)))
                   ""))

(defn mismatch-pass [entries :document i :i64 n :i64 acc :document] :document
  (if (>= i n)
    acc
    (let [entry (entry-at entries i)
          key (entry-key entry)
          id (doc-id (entry-doc entry))]
      (mismatch-pass entries (+ i 1) n
                     (if (not= key id)
                       (document-vector-conj
                        acc
                        (problem :error :doc/id-key-mismatch key
                                 "document key must equal :search/id"))
                       acc)))))

(defn title-pass [entries :document i :i64 n :i64 acc :document] :document
  (if (>= i n)
    acc
    (let [entry (entry-at entries i)
          key (entry-key entry)
          title (doc-title (entry-doc entry))]
      (title-pass entries (+ i 1) n
                  (if (string=? title "")
                    (document-vector-conj
                     acc
                     (problem :warning :doc/missing-title key
                              "document has no title"))
                    acc)))))

(defn problems [idx :document] :document
  (let [entries (option-value-of [:option :document]
                                 (document-get idx :search/docs)
                                 (document-vector))
        n (document-count entries)]
    (title-pass entries 0 n
                (mismatch-pass entries 0 n (document-vector)))))

(defn error-pass [ps :document i :i64 n :i64] :bool
  (if (>= i n)
    true
    (let [p (option-value-of [:option :document]
                             (document-vector-at ps i) (document-null))
          severity (option-value-of [:option :keyword]
                                    (document-keyword-value
                                     (option-value-of [:option :document]
                                                      (document-get p :search/severity)
                                                      (document-null)))
                                    :search/none)]
      (if (= severity :error)
        false
        (error-pass ps (+ i 1) n)))))

(defn valid? [idx :document] :bool
  (let [ps (problems idx)]
    (error-pass ps 0 (document-count ps))))
