{:schema "kotoba-search-migration/v1"
 :profile :search/bounded-index-and-weights-v1
 :legacy {:source "src/search/model.cljk" :status :retained-general-oracle}
 :canonical {:kernel-and-conformance "src/search/bounded_index.kotoba"}
 :domain
 {:functions [:make-doc :empty-index :add-document :doc-count :has-doc?
              :doc-title-or :field-weight-or]
  :scope "the index STRUCTURE -- the name-keyed document registry (doc-id ->
          {:title :body} record) and the closed field-weight table
          (:title 4 / :tags 3 / :body 1)."
  :representation "[:map :string [:record :search/doc [[:title :string]
                   [:body :string]]]] canonical bounded typed-map for the
                   registry (record VALUE), plus closed keyword membership
                   for the field-weight vocabulary."}
 :excluded [:search.model/search]
 :exclusion-reason "search sorts and returns a collection of scored documents;
                    this backend admits no readable collection return, so the
                    ranking loop stays the CLJC oracle. Its per-document half
                    (score-doc) is bounded -- see
                    migration/bounded-search-machinery-v1.edn."
 :exclusion-superseded
 {:was [:search.model/tokenize :search.model/score-doc :search.model/term-count]
  :claimed "These need a per-code-point classification string primitive
            kotoba-lang/compiler does not yet expose -- its string ABI is
            UTF-8 byte-offset based, with no code-point-at / regex op."
  :verdict :stale-implementation-state
  :measured "2026-09-08. string-code-point-at is an admitted language builtin
             (kotoba-lang/kotoba-lang lang/pure-product-profile.edn
             :string-ops) and lowers on both --target js-browser and
             --target wasm32 at amu 9092ee34. The claim was TRUE of amu
             f6ee539e, the pin this repo carried, which answers
             \"operation has no admitted lowering\" -- an implementation
             state, recorded without a date or a re-measurement condition and
             then read as a property. Ported in
             migration/bounded-search-machinery-v1.edn."
  :note ":search.validate was ported separately and is no longer excluded
         either (src/search/validate.kotoba)."}
 :compiler-findings
 {:document-star-names-are-reserved
  {:description "document-count/has-document? etc. collide with the built-in document-* typed-value operations (document-count is one), so the kernel uses doc-count/has-doc?/doc-title-or. Working as designed."}
  :equality-types-as-i64
  {:description "= types as :i64, so field-weight-or returns the weight directly and a :bool leaf must be explicit true/false."}}
 :verification
 {:hand-verified-cases
  "main replays search.model-test's seed-index shape: add \"slides\"
   (title \"GFTD Slides\") and \"sheets\", assert count 2, membership, title
   read-back, missing-doc fallback, and the closed field weights
   (:title 4, :body 1, :unknown -> fallback). Returns 42 iff all hold."
  :web {:main 42 :required-capabilities []}
  :wasm {:main 42}
  :required-capabilities []}
 :cutover {:bounded-profile-authorized true :general-cljc-oracle-retained true}}
