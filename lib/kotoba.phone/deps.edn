{:paths ["src"]
 ;; Sibling libraries are named by GIT COORDINATE, not :local/root.
 ;;
 ;; A library whose :deps use :local/root is not consumable from outside a
 ;; monorepo checkout: tools.deps resolves "../html" relative to the CONSUMER's
 ;; gitlibs directory. Measured 2026-07-30 while wiring cloud-itonami-app through
 ;; kotoba-lang/esim -> card -> phone; each link failed in turn, e.g.
 ;;   Error building classpath. Local lib io.github.kotoba-lang/html not found:
 ;;   ~/.gitlibs/libs/io.github.kotoba-lang/phone/html
 ;; CI passed throughout, because CI cloned the siblings into ../ -- which proves
 ;; only that this compiles NEXT TO them, never that anyone else can use it.
 ;;
 ;; So :deps carry git coordinates, :dev overrides them to sibling checkouts for
 ;; monorepo work, and CI runs the plain git path so a consumability regression
 ;; fails here rather than in a consumer.
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/html {:local/root "../kotoba.html"}
        io.github.kotoba-lang/css {:local/root "../kotoba.css"}}
 :aliases
 {:dev {:override-deps
        {io.github.kotoba-lang/html {:local/root "../html"}
         io.github.kotoba-lang/css  {:local/root "../css"}}}
  :test {:extra-paths ["test"]}}}
