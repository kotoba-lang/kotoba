(ns kotoba.phone.porting-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.phone.numbering :as numbering]
            [kotoba.phone.porting :as porting]))

(def ^:private day (* 24 60 60 1000))
(def ^:private now 1800000000000)

(defn- out-request [& {:keys [msisdn subject changed]}]
  (porting/port-request "P1" (or msisdn "+819012340000") :out
                        "cloud-itonami" "other-operator" (or subject "did:key:z6Sub")
                        :requested-at-ms (or changed now)))

(deftest port-request-shape-test
  (testing "a request between the same two parties is not a port"
    (is (nil? (porting/port-request "P" "+819012340000" :out "A" "A" "s"))))
  (testing "and the issue list says which rule refused"
    (is (= [:porting/donor-is-recipient]
           (mapv :phone/issue (porting/request-issues
                               {:phone/msisdn "+819012340000" :phone/direction :out
                                :phone/donor "A" :phone/recipient "A" :phone/subject "s"})))))
  (testing "malformed number, unknown direction and missing subject are each named"
    (is (= #{:porting/msisdn-invalid :porting/direction-invalid :porting/subject-missing}
           (set (mapv :phone/issue (porting/request-issues
                                    {:phone/msisdn "x" :phone/direction :sideways
                                     :phone/donor "A" :phone/recipient "B"})))))))

(deftest port-out-subject-mismatch-is-refused-test
  (let [records [(numbering/record "+819012340000" :active :subject "did:key:z6Sub")]]
    (testing "the holder may ask"
      (is (empty? (porting/port-out-issues {:records records :request (out-request) :now-ms now}))))
    (testing "somebody else may not -- this is the port-out scam, refused before consent"
      (is (= [:porting/subject-mismatch]
             (mapv :phone/issue
                   (porting/port-out-issues
                    {:records records
                     :request (out-request :subject "did:key:z6Attacker")
                     :now-ms now})))))))

(deftest port-out-reachability-test
  (testing "a number that is not active cannot be ported out"
    (is (= [:transition/unreachable]
           (mapv :phone/issue
                 (porting/port-out-issues
                  {:records [(numbering/record "+819012340000" :suspended :subject "did:key:z6Sub")]
                   :request (out-request) :now-ms now})))))
  (testing "a number this operator has no record of"
    (is (= [:number/not-found]
           (mapv :phone/issue
                 (porting/port-out-issues {:records [] :request (out-request) :now-ms now}))))))

(deftest change-freeze-test
  (let [fresh [(assoc (numbering/record "+819012340000" :active :subject "did:key:z6Sub")
                      :phone/changed-at-ms (- now (* 10 day)))]
        old   [(assoc (numbering/record "+819012340000" :active :subject "did:key:z6Sub")
                      :phone/changed-at-ms (- now (* 90 day)))]]
    (testing "a line that just changed hands may not change hands again"
      (let [issues (porting/port-out-issues {:records fresh :request (out-request) :now-ms now})]
        (is (= [:porting/recently-changed] (mapv :phone/issue issues)))
        (is (= (* 50 day) (:phone/remaining-ms (first issues))))))
    (testing "past the window it may"
      (is (empty? (porting/port-out-issues {:records old :request (out-request) :now-ms now}))))
    (testing "an operator window overrides the default"
      (is (empty? (porting/port-out-issues {:records fresh :request (out-request)
                                            :now-ms now :freeze-days 5}))))
    (testing "an UNKNOWN history does not freeze -- absent data must not become lock-in"
      (is (empty? (porting/port-out-issues
                   {:records [(numbering/record "+819012340000" :active :subject "did:key:z6Sub")]
                    :request (out-request) :now-ms now}))))))

(deftest port-in-test
  (let [request (porting/port-request "P2" "+819012340000" :in
                                      "other-operator" "cloud-itonami" "did:key:z6Sub")]
    (testing "a number we do not have arrives cleanly"
      (is (empty? (porting/port-in-issues {:records [] :request request}))))
    (testing "a number we already hold live cannot arrive from elsewhere"
      (is (= [:porting/already-present]
             (mapv :phone/issue
                   (porting/port-in-issues
                    {:records [(numbering/record "+819012340000" :active :subject "other")]
                     :request request})))))
    (testing "one we previously ported out may come back"
      (is (empty? (porting/port-in-issues
                   {:records [(numbering/record "+819012340000" :ported-out)]
                    :request request}))))
    (testing "direction is checked in both functions"
      (is (= [:porting/direction-mismatch]
             (mapv :phone/issue (porting/port-in-issues {:records [] :request (out-request)}))))
      (is (= [:porting/direction-mismatch]
             (mapv :phone/issue
                   (porting/port-out-issues {:records [] :request request :now-ms now})))))))

(deftest control-change-event-test
  (testing "a port-out is a takeover signal; a port-in is not"
    (is (true? (:phone/takeover? (porting/control-change-event (out-request) now))))
    (is (= :number/port-out (:phone/signal (porting/control-change-event (out-request) now))))
    (let [in (porting/port-request "P3" "+819012340000" :in "other" "cloud-itonami" "s")]
      (is (false? (:phone/takeover? (porting/control-change-event in now))))
      (is (= :number/port-in (:phone/signal (porting/control-change-event in now)))))))
