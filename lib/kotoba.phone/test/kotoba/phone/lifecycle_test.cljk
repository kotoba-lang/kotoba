(ns kotoba.phone.lifecycle-test
  (:require [kotoba.lang.coll :as set]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.phone.lifecycle :as lifecycle]))

(defn- rec [msisdn state & {:keys [subject iccid]}]
  {:phone/msisdn msisdn :phone/state state
   :phone/subject subject :phone/iccid iccid})

(deftest reachability-test
  (testing "each operation is reachable only from its declared states"
    (is (lifecycle/reachable? :assigned :activate))
    (is (not (lifecycle/reachable? :suspended :activate)))
    (is (lifecycle/reachable? :suspended :restore))
    (is (lifecycle/reachable? :active :port-out-request))
    (is (not (lifecycle/reachable? :porting-out :release))))
  (testing "unknown states and operations are never permissive"
    (is (not (lifecycle/reachable? :nonsense :activate)))
    (is (not (lifecycle/reachable? :active :nonsense)))
    (is (nil? (lifecycle/next-state :active :nonsense))))
  (testing "a completed port-out is terminal for this operator"
    (is (lifecycle/terminal? :ported-out))
    (is (= [:state/terminal]
           (mapv :phone/issue (lifecycle/transition-issues :ported-out :activate))))))

(deftest recycling-cannot-be-routed-around-test
  (testing "assign is not reachable from released -- the path runs through quarantine"
    (is (not (lifecycle/reachable? :released :assign)))
    (is (not (lifecycle/reachable? :released :reserve)))
    (is (not (lifecycle/reachable? :quarantined :assign))))
  (testing "recycle refuses unless the elapsed window is stated as a fact"
    (let [records [(rec "+819012340001" :quarantined)]]
      (is (= [:recycle/quarantine-incomplete]
             (mapv :phone/issue
                   (:phone/issues (lifecycle/apply-event records "+819012340001" :recycle)))))
      (is (= [:recycle/quarantine-incomplete]
             (mapv :phone/issue
                   (:phone/issues (lifecycle/apply-event records "+819012340001" :recycle
                                                        {:phone/quarantine-elapsed? nil})))))
      ;; A truthy-but-not-true value does not count either: `true?`, not `if`.
      (is (= [:recycle/quarantine-incomplete]
             (mapv :phone/issue
                   (:phone/issues (lifecycle/apply-event records "+819012340001" :recycle
                                                         {:phone/quarantine-elapsed? "yes"})))))
      (let [ok (lifecycle/apply-event records "+819012340001" :recycle
                                      {:phone/quarantine-elapsed? true})]
        (is (:phone/ok? ok))
        (is (= :unallocated (:phone/to ok))))))
  (testing "a recycled number keeps no trace of who held it"
    (let [records [(rec "+819012340002" :quarantined :subject "did:key:z6Old" :iccid "8981...")]
          ok (lifecycle/apply-event records "+819012340002" :recycle
                                    {:phone/quarantine-elapsed? true})
          r (first (:phone/records ok))]
      (is (:phone/ok? ok))
      (is (nil? (:phone/subject r)))
      (is (nil? (:phone/iccid r))))))

(deftest assign-requires-a-subject-test
  (let [records [(rec "+819012340003" :reserved)]]
    (is (= [:assign/subject-missing]
           (mapv :phone/issue (:phone/issues (lifecycle/apply-event records "+819012340003" :assign)))))
    (is (= [:assign/subject-missing]
           (mapv :phone/issue (:phone/issues (lifecycle/apply-event records "+819012340003" :assign
                                                                   {:phone/subject "  "})))))
    (let [ok (lifecycle/apply-event records "+819012340003" :assign
                                    {:phone/subject "did:key:z6Sub"})]
      (is (:phone/ok? ok))
      (is (= "did:key:z6Sub" (:phone/subject (first (:phone/records ok))))))))

(deftest one-active-msisdn-per-profile-test
  (testing "activating a second number on the same ICCID surfaces the incumbent"
    (let [records [(rec "+819012340004" :active :subject "s" :iccid "ICCID-A")
                   (rec "+819012340005" :assigned :subject "s")]
          out (lifecycle/apply-event records "+819012340005" :activate
                                     {:phone/iccid "ICCID-A"})]
      (is (false? (:phone/ok? out)))
      (is (= [:activate/would-displace] (mapv :phone/issue (:phone/issues out))))
      (is (= "+819012340004" (:phone/incumbent (first (:phone/issues out)))))))
  (testing "a number with no ICCID conflicts with nothing"
    (let [records [(rec "+819012340006" :active :subject "s" :iccid "ICCID-A")
                   (rec "+819012340007" :assigned :subject "s")]]
      (is (:phone/ok? (lifecycle/apply-event records "+819012340007" :activate))))))

(deftest not-found-and-shape-test
  (is (= [:number/not-found]
         (mapv :phone/issue (:phone/issues (lifecycle/apply-event [] "+819012340008" :activate)))))
  (is (= [:transition/unreachable]
         (mapv :phone/issue
               (:phone/issues (lifecycle/apply-event [(rec "+819012340009" :suspended)]
                                                     "+819012340009" :activate))))))

(deftest signal-vocabulary-test
  (testing "port-out is a takeover signal from the REQUEST, not from completion"
    (is (contains? lifecycle/takeover-signals :port-out-request))
    (is (contains? lifecycle/takeover-signals :port-out-complete)))
  (testing "the arriving side is a different worry and a different set"
    (is (contains? lifecycle/provenance-unsettled-signals :port-in))
    (is (contains? lifecycle/provenance-unsettled-signals :recycle))
    (is (empty? (set/intersection lifecycle/takeover-signals
                                  lifecycle/provenance-unsettled-signals))))
  (testing "every signal names a real operation"
    (is (every? #(contains? lifecycle/operations %)
                (into lifecycle/takeover-signals lifecycle/provenance-unsettled-signals)))))

(deftest describe-test
  (is (= "activate: assigned -> active" (lifecycle/describe :assigned :activate)))
  (is (= "activate: refused from suspended (reachable from assigned)"
         (lifecycle/describe :suspended :activate))))
