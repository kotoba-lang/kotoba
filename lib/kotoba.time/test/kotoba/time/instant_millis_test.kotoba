(ns kotoba.time.instant-millis-test (:export [main]) (:require [kotoba.time.instant-millis :as p]))

(defn- ok [b :bool] :i64
  (if b 0 1))

(defn main [] :i64
  (+ (ok (document-equal? (p/instant-millis (document-map :time/instant (document-i64 1700000000000)))
                          (document-i64 1700000000000)))
     (ok (document-equal? (p/instant-millis (document-map)) (document-null)))
     (ok (document-equal? (p/instant-millis (document-string "x")) (document-null)))))
