;; Test for kotoba.time.before. main returns the number of failed cases.
(ns kotoba.time.before-test
  (:export [main])
  (:require [kotoba.time.before :as t]))

(defn- at [i :i64] :document
  (document-map :time/instant (document-i64 i)))
(defn- chk-bool [got :bool want :bool] :i64
  (if (= got want) 0 1))

(defn main [] :i64
  (let [a (chk-bool (t/before? (at 5) (at 9)) true)
        b (chk-bool (t/before? (at 9) (at 5)) false)
        c (chk-bool (t/before? (at 7) (at 7)) false)
        d (chk-bool (t/before? (document-map) (at 9)) false)
        e (chk-bool (t/before? (at 1) (document-map)) false)]
    (+ a (+ b (+ c (+ d e))))))
