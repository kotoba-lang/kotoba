(ns kotoba.time.duration-millis-test (:export [main]) (:require [kotoba.time.duration-millis :as p]))

(defn main [] :i64
  (+ (if (= (p/duration-millis (document-map :time/duration (document-i64 250))) 250) 0 1)
     (if (= (p/duration-millis (document-map)) 0) 0 1)
     (if (= (p/duration-millis (document-map :time/duration (document-string "x"))) 0) 0 1)
     (if (= (p/duration-millis (document-i64 9)) 0) 0 1)))
