;; Port of kotoba.time.instant-millis (instant_millis.cljk), Kotoba-native.
;;
;; Named divergences: none. A missing :time/instant key, or a non-map input,
;; reads as document-null, as nil does in the source.

(ns kotoba.time.instant-millis
  (:export [instant-millis]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn instant-millis [i :document] :document
  (field i :time/instant))
