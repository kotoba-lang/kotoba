;; Kotoba port of lib/kotoba.time/src/kotoba/time/after.cljk.
;;
;; Named divergence: the .cljk takes maps and reads (:time/instant a). Kotoba
;; has no map values and no keyword-call on untyped arguments (E2104), so the
;; port takes the two :time/instant values directly. The comparison is the same.
(ns kotoba.time.after
  (:export [after?]))

(defn after? [a :i64 b :i64] :bool (> a b))
