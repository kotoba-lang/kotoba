(ns kotoba.time.now
  "now -- addressed on its own.

  Split out of kotoba.lang.time on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.time.instant :refer [instant]])
)

(defn now
  "Return the current instant using a HOST-INJECTED `clock` fn. `(clock)` must
  return epoch-millis. Without a clock capability, a cell has no time —
  deny-by-default."
  [clock]
  (instant (clock)))
