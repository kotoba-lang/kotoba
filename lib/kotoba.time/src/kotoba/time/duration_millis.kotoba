;; Port of kotoba.time.duration-millis (duration_millis.cljk), Kotoba-native.
;;
;; A duration is a :document map; the value is its :time/duration i64.
;;
;; Named divergences from duration_millis.cljk:
;;   - the source returns the :time/duration value as-is, whatever its type.
;;     Here an absent, nil or non-i64 value reads as 0 (the source's default
;;     for an absent key).

(ns kotoba.time.duration-millis
  (:export [duration-millis]))

(defn duration-millis [d :document] :i64
  (if (map? d)
    (option-or (document-i64-value (option-or (document-get d :time/duration) (document-null))) 0)
    0))
