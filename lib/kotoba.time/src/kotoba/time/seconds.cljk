(ns kotoba.time.seconds
  "seconds -- addressed on its own.

  Split out of kotoba.lang.time on 2026-09-09 (ADR-2609091200). The unit
  here is the DEFINITION, and this repo's deps.edn names exactly the
  definitions it reaches -- nothing else.
"
  (:require [kotoba.time.duration :refer [duration]]
            [kotoba.time.msecs-per-second :refer [msecs-per-second]])
)

(defn seconds    [n] (duration (* n msecs-per-second)))
