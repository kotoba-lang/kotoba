;; Port of kotoba.time.before (before.cljk), Kotoba-native.
;;
;; before? compares the :time/instant of two time maps. Instants are i64.
;; Named divergence: the source compares with `<` and throws when an instant
;; is nil or not a number; this port returns false when either instant is
;; absent or not an i64 document (a pure function has no exception channel).
(ns kotoba.time.before
  (:export [before?]))

(defn- instant [m :document] :document
  (option-value-of [:option :document] (document-get m :time/instant) (document-null)))

(defn- instant-i64? [m :document] :bool
  (= (document-kind (instant m)) :i64))

(defn- instant-value [m :document] :i64
  (option-value-of [:option :i64] (document-i64-value (instant m)) 0))

(defn before? [a :document b :document] :bool
  (if (and (instant-i64? a) (instant-i64? b))
    (< (instant-value a) (instant-value b))
    false))
