;; Vendored JSON-RPC 2.0 spec vectors. No network. Each test_* is 1 pass / 0 fail.
;; Fresh instantiateKotoba per export so fuel stays at 512.

(defn test-encode-positional [] :i64
  (if (string=?
       (encode (request "subtract" (document [42 23]) (document 1)))
       "{\"id\":1,\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":[42,23]}")
    1
    0))

(defn test-decode-positional [] :i64
  (if (request? (decode "{\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":[42,23],\"id\":1}"))
    1
    0))

(defn test-decode-named [] :i64
  (let [m (decode "{\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":{\"subtrahend\":23,\"minuend\":42},\"id\":3}")]
    (if (and (request? m) (is-kind? (doc-get m :params) "map"))
      1
      0)))

(defn test-notification-no-id [] :i64
  (if (notification? (decode "{\"jsonrpc\":\"2.0\",\"method\":\"update\",\"params\":[1,2,3,4,5]}"))
    1
    0))

(defn test-notification-omitted-params [] :i64
  (if (notification? (decode "{\"jsonrpc\":\"2.0\",\"method\":\"foobar\"}"))
    1
    0))

(defn test-encode-notification [] :i64
  (if (not (string-contains? (encode (notification-no-params "foobar")) "id"))
    1
    0))

(defn test-string-id [] :i64
  (let [m (decode "{\"jsonrpc\":\"2.0\",\"method\":\"foobar\",\"id\":\"1\"}")]
    (if (and (request? m) (is-kind? (doc-get m :id) "string"))
      1
      0)))

(defn test-number-id [] :i64
  (let [m (decode "{\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":[42,23],\"id\":2}")]
    (if (and (request? m) (is-kind? (doc-get m :id) "i64"))
      1
      0)))

(defn test-omitted-params-request [] :i64
  (if (request? (decode "{\"jsonrpc\":\"2.0\",\"method\":\"get_data\",\"id\":\"9\"}"))
    1
    0))

(defn test-method-not-found-response [] :i64
  (let [m (decode "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32601,\"message\":\"Method not found\"},\"id\":\"1\"}")]
    (if (and (error-message? m)
             (string=? (document-edn-print (doc-get (doc-get m :error) :code)) "-32601"))
      1
      0)))

(defn test-parse-error [] :i64
  (let [broken (string-concat "{\"jsonrpc\":\"2.0\",\"method\":\"foobar, " "\"params\":\"bar\",\"baz}")
        m (decode broken)]
    (if (and (error-message? m)
             (string=? (document-edn-print (doc-get (doc-get m :error) :code)) "-32700"))
      1
      0)))

(defn test-invalid-request [] :i64
  (let [m (decode "{\"jsonrpc\":\"2.0\",\"method\":1,\"params\":\"bar\"}")]
    (if (and (error-message? m)
             (string=? (document-edn-print (doc-get (doc-get m :error) :code)) "-32600"))
      1
      0)))

(defn test-empty-batch [] :i64
  (let [m (decode "[]")]
    (if (and (error-message? m)
             (string=? (document-edn-print (doc-get (doc-get m :error) :code)) "-32600"))
      1
      0)))

(defn test-invalid-batch-item [] :i64
  (let [m (decode "[1]")
        item (option-or (document-vector-at m 0) (document {}))]
    (if (and (is-kind? m "vector")
             (string=? (document-edn-print (doc-get (doc-get item :error) :code)) "-32600"))
      1
      0)))

(defn test-success-xor-error [] :i64
  (let [ok (success (document 19) (document 1))
        err (method-not-found (document "1"))]
    (if (and (and (success-message? ok) (not (has-member? ok :error)))
             (and (error-message? err) (not (has-member? err :result))))
      1
      0)))

(defn test-ids-match [] :i64
  (if (ids-match?
       (request "subtract" (document [42 23]) (document 1))
       (success (document 19) (document 1)))
    1
    0))

(defn test-ids-mismatch [] :i64
  (if (not (ids-match?
            (request "subtract" (document [42 23]) (document 1))
            (success (document 19) (document 2))))
    1
    0))

(defn test-standard-codes [] :i64
  (if (and (= (err-parse) -32700)
           (and (= (err-invalid-request) -32600)
                (and (= (err-method-not-found) -32601)
                     (and (= (err-invalid-params) -32602)
                          (= (err-internal) -32603)))))
    1
    0))

(defn test-by-position-vs-by-name [] :i64
  (if (and (is-kind? (doc-get (request "subtract" (document [42 23]) (document 1)) :params) "vector")
           (is-kind? (doc-get (request "subtract" (document {:minuend 42 :subtrahend 23}) (document 4)) :params) "map"))
    1
    0))

(defn test-batch-omits-notifications [] :i64
  (let [decoded (document-vector-conj
                 (document-vector-conj (document [])
                                       (request "sum" (document [1 2]) (document "1")))
                 (notification "notify_hello" (document [7])))
        body (encode-response-batch decoded)]
    (if (and (string-contains? body "sum")
             (not (string-contains? body "notify_hello")))
      1
      0)))

(defn test-all-notification-batch [] :i64
  (let [decoded (document-vector-conj
                 (document-vector-conj (document [])
                                       (notification "notify_sum" (document [1 2 4])))
                 (notification "notify_hello" (document [7])))
        body (encode-response-batch decoded)]
    (if (string=? body "")
      1
      0)))

(defn test-ndjson-line [] :i64
  (let [line (ndjson-encode (request-no-params "ping" (document 1)))
        msg (ndjson-decode-line (ndjson-nth-line line 0))]
    (if (and (request? msg)
             (and (= (ndjson-line-count line) 1)
                  (string-contains? line "\n")))
      1
      0)))

(defn test-ndjson-two-lines [] :i64
  (let [blob (string-concat
              (ndjson-encode (notification-no-params "tick"))
              (ndjson-encode (request-no-params "ping" (document "a"))))]
    (if (and (= (ndjson-line-count blob) 2)
             (string=? (ndjson-nth-line blob 0)
                       (encode (notification-no-params "tick"))))
      1
      0)))

(defn test-json-parse-reject [] :i64
  (if (not (json-parse-ok? "{"))
    1
    0))
