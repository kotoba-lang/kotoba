;; Adapted 2026-10-22: import the preserved org.jsonrpc module.
(ns kotoba.jsonrpc.example.decode
  (:require [org.jsonrpc :as rpc])
  (:export [main]))

(defn main [] :string
  (keyword-name
   (rpc/message-kind
    (rpc/decode "{\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":[42,23],\"id\":1}"))))
