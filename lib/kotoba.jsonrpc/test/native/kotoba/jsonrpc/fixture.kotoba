;; Adapted 2026-10-22: real module import and qualified public calls.
;; Original assertions are retained. Native compilation/execution is pending.
;; Run EVERY exported test in a fresh context with fuel 512; each must return 1.
(ns kotoba.jsonrpc.fixture
  (:require [org.jsonrpc :as rpc])
  (:export [test-encode-positional
            test-decode-positional
            test-decode-named
            test-notification-no-id
            test-notification-omitted-params
            test-encode-notification
            test-string-id
            test-number-id
            test-omitted-params-request
            test-method-not-found-response
            test-parse-error
            test-invalid-request
            test-empty-batch
            test-invalid-batch-item
            test-success-xor-error
            test-ids-match
            test-ids-mismatch
            test-standard-codes
            test-by-position-vs-by-name
            test-batch-omits-notifications
            test-all-notification-batch
            test-ndjson-line
            test-ndjson-two-lines
            test-json-parse-reject]))

(defn- kind-name [d :document] :string
  (keyword-name (document-kind d)))

(defn- is-kind? [d :document k :string] :bool
  (string=? (kind-name d) k))

(defn- option-document-some? [v [:option :document]] :bool
  (if-some [x v]
    true
    false))

(defn- has-member? [m :document k :keyword] :bool
  (option-document-some? (document-get m k)))

(defn- doc-get [m :document k :keyword] :document
  (option-or (document-get m k) (document nil)))

(defn test-encode-positional [] :i64
  (if (string=?
       (rpc/encode (rpc/request "subtract" (document [42 23]) (document 1)))
       "{\"id\":1,\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":[42,23]}")
    1
    0))

(defn test-decode-positional [] :i64
  (if (rpc/request? (rpc/decode "{\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":[42,23],\"id\":1}"))
    1
    0))

(defn test-decode-named [] :i64
  (let [m (rpc/decode "{\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":{\"subtrahend\":23,\"minuend\":42},\"id\":3}")]
    (if (and (rpc/request? m) (is-kind? (doc-get m :params) "map"))
      1
      0)))

(defn test-notification-no-id [] :i64
  (if (rpc/notification? (rpc/decode "{\"jsonrpc\":\"2.0\",\"method\":\"update\",\"params\":[1,2,3,4,5]}"))
    1
    0))

(defn test-notification-omitted-params [] :i64
  (if (rpc/notification? (rpc/decode "{\"jsonrpc\":\"2.0\",\"method\":\"foobar\"}"))
    1
    0))

(defn test-encode-notification [] :i64
  (if (not (string-contains? (rpc/encode (rpc/notification-no-params "foobar")) "id"))
    1
    0))

(defn test-string-id [] :i64
  (let [m (rpc/decode "{\"jsonrpc\":\"2.0\",\"method\":\"foobar\",\"id\":\"1\"}")]
    (if (and (rpc/request? m) (is-kind? (doc-get m :id) "string"))
      1
      0)))

(defn test-number-id [] :i64
  (let [m (rpc/decode "{\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":[42,23],\"id\":2}")]
    (if (and (rpc/request? m) (is-kind? (doc-get m :id) "i64"))
      1
      0)))

(defn test-omitted-params-request [] :i64
  (if (rpc/request? (rpc/decode "{\"jsonrpc\":\"2.0\",\"method\":\"get_data\",\"id\":\"9\"}"))
    1
    0))

(defn test-method-not-found-response [] :i64
  (let [m (rpc/decode "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32601,\"message\":\"Method not found\"},\"id\":\"1\"}")]
    (if (and (rpc/error-message? m)
             (string=? (document-edn-print (doc-get (doc-get m :error) :code)) "-32601"))
      1
      0)))

(defn test-parse-error [] :i64
  (let [broken (string-concat "{\"jsonrpc\":\"2.0\",\"method\":\"foobar, " "\"params\":\"bar\",\"baz}")
        m (rpc/decode broken)]
    (if (and (rpc/error-message? m)
             (string=? (document-edn-print (doc-get (doc-get m :error) :code)) "-32700"))
      1
      0)))

(defn test-invalid-request [] :i64
  (let [m (rpc/decode "{\"jsonrpc\":\"2.0\",\"method\":1,\"params\":\"bar\"}")]
    (if (and (rpc/error-message? m)
             (string=? (document-edn-print (doc-get (doc-get m :error) :code)) "-32600"))
      1
      0)))

(defn test-empty-batch [] :i64
  (let [m (rpc/decode "[]")]
    (if (and (rpc/error-message? m)
             (string=? (document-edn-print (doc-get (doc-get m :error) :code)) "-32600"))
      1
      0)))

(defn test-invalid-batch-item [] :i64
  (let [m (rpc/decode "[1]")
        item (option-or (document-vector-at m 0) (document {}))]
    (if (and (is-kind? m "vector")
             (string=? (document-edn-print (doc-get (doc-get item :error) :code)) "-32600"))
      1
      0)))

(defn test-success-xor-error [] :i64
  (let [ok (rpc/success (document 19) (document 1))
        err (rpc/method-not-found (document "1"))]
    (if (and (and (rpc/success-message? ok) (not (has-member? ok :error)))
             (and (rpc/error-message? err) (not (has-member? err :result))))
      1
      0)))

(defn test-ids-match [] :i64
  (if (rpc/ids-match?
       (rpc/request "subtract" (document [42 23]) (document 1))
       (rpc/success (document 19) (document 1)))
    1
    0))

(defn test-ids-mismatch [] :i64
  (if (not (rpc/ids-match?
            (rpc/request "subtract" (document [42 23]) (document 1))
            (rpc/success (document 19) (document 2))))
    1
    0))

(defn test-standard-codes [] :i64
  (if (and (= (rpc/err-parse) -32700)
           (and (= (rpc/err-invalid-request) -32600)
                (and (= (rpc/err-method-not-found) -32601)
                     (and (= (rpc/err-invalid-params) -32602)
                          (= (rpc/err-internal) -32603)))))
    1
    0))

(defn test-by-position-vs-by-name [] :i64
  (if (and (is-kind? (doc-get (rpc/request "subtract" (document [42 23]) (document 1)) :params) "vector")
           (is-kind? (doc-get (rpc/request "subtract" (document {:minuend 42 :subtrahend 23}) (document 4)) :params) "map"))
    1
    0))

(defn test-batch-omits-notifications [] :i64
  (let [decoded (document-vector-conj
                 (document-vector-conj (document [])
                                       (rpc/request "sum" (document [1 2]) (document "1")))
                 (rpc/notification "notify_hello" (document [7])))
        body (rpc/encode-response-batch decoded)]
    (if (and (string-contains? body "sum")
             (not (string-contains? body "notify_hello")))
      1
      0)))

(defn test-all-notification-batch [] :i64
  (let [decoded (document-vector-conj
                 (document-vector-conj (document [])
                                       (rpc/notification "notify_sum" (document [1 2 4])))
                 (rpc/notification "notify_hello" (document [7])))
        body (rpc/encode-response-batch decoded)]
    (if (string=? body "")
      1
      0)))

(defn test-ndjson-line [] :i64
  (let [line (rpc/ndjson-encode (rpc/request-no-params "ping" (document 1)))
        msg (rpc/ndjson-decode-line (rpc/ndjson-nth-line line 0))]
    (if (and (rpc/request? msg)
             (and (= (rpc/ndjson-line-count line) 1)
                  (string-contains? line "\n")))
      1
      0)))

(defn test-ndjson-two-lines [] :i64
  (let [blob (string-concat
              (rpc/ndjson-encode (rpc/notification-no-params "tick"))
              (rpc/ndjson-encode (rpc/request-no-params "ping" (document "a"))))]
    (if (and (= (rpc/ndjson-line-count blob) 2)
             (string=? (rpc/ndjson-nth-line blob 0)
                       (rpc/encode (rpc/notification-no-params "tick"))))
      1
      0)))

(defn test-json-parse-reject [] :i64
  (if (not (rpc/json-parse-ok? "{"))
    1
    0))
