(def expected-difficulty 10)

(def chain
  "The chain as TLS presents it: leaf first."
  [leaf-der ca-der])

(def chain-pem
  "`testdata/identity.cert`, written by Go's `pkcrypto.WriteCertPEM` from the
  certificates above. Generated by `go run gen_identity.go -pem`, which is
  deterministic — unlike the identity itself — so CI rebuilds it and diffs."
  (str "-----BEGIN CERTIFICATE-----\n"
