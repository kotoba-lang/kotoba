;; Native byte boundary for the existing envelope v1 chunk format (JUN-23).
;; ctx = [version, this chunk's epoch, index, total chunk count]. The caller
;; resolves per-chunk epochs and supplies a fresh, owner-wrapped 32-byte key.
;; This module neither generates nor stores keys and grants no network access.
;; It does not establish owner-only custody: that belongs to the client assembly.
;; AES-GCM is reused unchanged; its table-based native implementation is NOT
;; constant time. This compatibility slice is not production qualification.
(ns envelope.chunk
  (:require [aes.gcm :as gcm])
  (:export [nonce aad seal open]))

(defn- u32 [n :i64] :vector-i64
  (vector-i64 (rem (quot n 16777216) 256) (rem (quot n 65536) 256)
              (rem (quot n 256) 256) (rem n 256)))

(defn- cat [x :vector-i64 y :vector-i64] :vector-i64
  (let [n (vector-count x) m (vector-count y)]
    (loop [i 0 out (vector-alloc (+ n m))]
      (if (= i (+ n m)) out
        (recur (+ i 1) (vector-assoc! out i (if (< i n) (vector-at x i) (vector-at y (- i n)))))))))

(defn nonce [epoch :i64 index :i64] :vector-i64
  ;; Refuse overflow rather than repeat an old epoch's nonce.
  (if (or (< epoch 0) (> epoch 4294967295) (< index 0)) (vector-i64)
    (cat (u32 epoch) (cat (u32 (quot index 4294967296)) (u32 (rem index 4294967296))))))

(defn- valid-context? [object-id :string ctx :vector-i64] :bool
  ;; Check the shape before indexing, independently of boolean lowering.
  (if (not (= (vector-count ctx) 4)) false
    (and (> (string-byte-length object-id) 0)
         (= (vector-at ctx 0) 1)
         (>= (vector-at ctx 1) 0) (<= (vector-at ctx 1) 4294967295)
         (>= (vector-at ctx 2) 0)
         (> (vector-at ctx 3) 0) (< (vector-at ctx 2) (vector-at ctx 3)))))

(defn- utf8 [text :string] :vector-i64
  (vector-i64-from-bytes (string-to-utf8 text)))

(defn- octets? [value :vector-i64] :bool
  (loop [i 0]
    (if (= i (vector-count value)) true
      (if (and (>= (vector-at value i) 0) (<= (vector-at value i) 255))
        (recur (+ i 1)) false))))

(defn aad [object-id :string ctx :vector-i64] :vector-i64
  ;; Exactly envelope.model/chunk-aad, UTF-8 encoded; no new wire format.
  (if (not (valid-context? object-id ctx)) (vector-i64)
    (utf8 (string-concat "kotoba/envelope|1|"
      (string-concat object-id
        (string-concat "|" (string-concat (string-from-i64 (vector-at ctx 1))
          (string-concat "|" (string-concat (string-from-i64 (vector-at ctx 2))
            (string-concat "|" (string-from-i64 (vector-at ctx 3))))))))))))

(defn seal [key :vector-i64 object-id :string ctx :vector-i64 plaintext :vector-i64] :vector-i64
  ;; Empty vector is refusal. Even an empty plaintext produces a 16-byte tag.
  ;; Bound one chunk to the existing default 4 MiB, far below GCM's counter cap.
  (if (or (not (valid-context? object-id ctx)) (not (= (vector-count key) 32))
          (> (vector-count plaintext) 4194304)) (vector-i64)
    ;; Validate the raw key before AES expands its schedule and indexes S-boxes.
    (if (or (not (octets? key)) (not (octets? plaintext))) (vector-i64)
      (gcm/seal key (nonce (vector-at ctx 1) (vector-at ctx 2)) (aad object-id ctx) plaintext))))

(defn open [key :vector-i64 object-id :string ctx :vector-i64 ciphertext :vector-i64] :vector-i64
  ;; [-1] is refusal, distinct from a successfully authenticated empty file.
  ;; The underlying AEAD authenticates before returning any plaintext.
  (if (or (not (valid-context? object-id ctx)) (not (= (vector-count key) 32))
          (< (vector-count ciphertext) 16) (> (vector-count ciphertext) 4194320)) (vector-i64 -1)
    (if (or (not (octets? key)) (not (octets? ciphertext))) (vector-i64 -1)
      (gcm/open key (nonce (vector-at ctx 1) (vector-at ctx 2)) (aad object-id ctx) ciphertext))))
