(ns envelope.hybrid-object-test
  (:require [cljs.test :refer [deftest is async]]
            [envelope.kem :as kem] [envelope.model :as model] [envelope.seal :as seal]
            [kotoba.signal.x25519 :as x25519]))

(defn recipient [id]
  (let [x (x25519/generate-keypair) pq (kem/generate-keypair)]
    {:id id :pub (:pub x) :priv (:priv x) :pq-pub (:pub pq) :pq-priv (:priv pq)}))

(deftest hybrid-object-and-sharing-refuse-downgrade
  (async done
    (let [alice (recipient "alice") bob (recipient "bob")
          content (.encode (js/TextEncoder.) "secret")]
      (-> (seal/seal-object "test:hybrid" [content] [alice] {:envelope/kem model/hybrid-kem})
          (.then (fn [{:keys [envelope chunks]}]
            (let [entry (seal/entry-for envelope "alice")]
              (is (= model/hybrid-kem (:recipient/kem entry)))
              (is (string? (:recipient/pq-ct entry)))
              (is (thrown? :default (seal/unwrap-with envelope (dissoc entry :recipient/kem) (:priv alice))))
              (is (thrown? :default (seal/mint-link envelope entry alice)))
              (-> (seal/open-object envelope entry alice chunks)
                  (.then (fn [plain]
                    (is (= "secret" (.decode (js/TextDecoder.) (first plain))))
                    (seal/share-with envelope entry alice bob)))
                  (.then (fn [shared]
                    (let [entry (seal/entry-for shared "bob")]
                      (is (= model/hybrid-kem (:recipient/kem entry)))
                      (seal/open-object shared entry bob chunks))))
                  (.then (fn [plain] (is (= "secret" (.decode (js/TextDecoder.) (first plain))))))
                  (.then (fn [_]
                    (-> (seal/seal-object "test:missing" [content] [(dissoc bob :pq-pub)]
                                          {:envelope/kem model/hybrid-kem})
                        (.then (fn [_] (is false "missing ML-KEM key accepted"))
                               (fn [_] (is true))))))))))
          (.then (fn [_] (done)))
          (.catch (fn [e] (is false (str e)) (done)))))))
