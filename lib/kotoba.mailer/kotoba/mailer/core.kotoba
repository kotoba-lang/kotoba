;; mailer.core — Pure Kotoba guest (oracle: src/mailer/core.cljk).
;;
;; Provider-agnostic send-request construction. Product semantics live
;; here: which provider a request names, what its capability set is, and
;; what the wire message contains. The HTTP call, the SMTP socket, the
;; secrets and the case-folding stay in the host — mechanism.
;;
;; The oracle's three throw sites (unsupported provider, non-mail/send
;; effect, bodyless message) become status/error pairs returned in the
;; request document — throw is not in the language (ADR-2608650000) and
;; the caller branches on :mailer.request/status.
;;
;; Compile (single file, JVM-free):
;;   kotoba compile kotoba/mailer/core.kotoba --target wasm32-browser --output core.wasm

(ns mailer.core
  (:export [provider-request]))

(defn- dg [d k :keyword] :document
  (option-value-of [:option :document] (document-get d k) (document-null)))

(defn- ds [d k :keyword] :string
  (option-value-of [:option :string] (document-string-value (dg d k)) ""))

(defn- dk [d k :keyword] :keyword
  (option-value-of [:option :keyword]
                   (document-keyword-value (dg d k)) :none))

(defn- body-of [parts :document content-type :string i :i64] :string
  (if (>= i (document-count parts)) ""
      (let [part (option-value-of [:option :document]
                                  (document-vector-at parts i) (document-null))]
        (if (string=? (ds part :mail.part/content-type) content-type)
          (ds part :mail.part/body)
          (body-of parts content-type (+ i 1))))))

(defn- message-wire [m :document] :document
  (let [parts (dg m :mail/parts)
        text (body-of parts "text/plain" 0)
        html (body-of parts "text/html" 0)]
    (if (if (string=? text "") (string=? html "") false)
      ;; bodyless: refuse as a value, byte-identical reason to the oracle's ex-info
      (document-map
       :mailer.request/status (document-keyword :error)
       :mailer.request/error (document-string "mail message has no text/plain or text/html part to send"))
      (document-map
       :mailer.request/status (document-keyword :ok)
       :from (dg m :mail/from)
       :to (dg m :mail/to)
       :cc (dg m :mail/cc)
       :bcc (dg m :mail/bcc)
       :subject (dg m :mail/subject)
       :text (document-string text)
       :html (document-string html)))))

(defn provider-request [provider :keyword effect :document] :document
  (if (not= (dk effect :mail.effect/type) :mail/send)
    (document-map
     :mailer.request/status (document-keyword :error)
     :mailer.request/error (document-string "mailer request requires mail/send effect"))
    (let [wire (message-wire (dg effect :mail.effect/message))]
      (if (= (dk wire :mailer.request/status) :error)
        wire
        (if (= provider :resend)
          (document-assoc
           (document-assoc wire :mailer.request/provider (document-keyword :resend))
           :http/url (document-string "https://api.resend.com/emails"))
          (if (= provider :smtp)
            (document-assoc
             (document-assoc wire :mailer.request/provider (document-keyword :smtp))
             :smtp/action (document-keyword :send))
            (if (= provider :ses)
              (document-assoc
               (document-assoc wire :mailer.request/provider (document-keyword :ses))
               :aws/action (document-keyword :ses-send-email))
              (document-map
               :mailer.request/status (document-keyword :error)
               :mailer.request/error (document-string "unsupported mail provider")))))))))
