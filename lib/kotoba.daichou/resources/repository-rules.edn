;; この repo が主張する契約。正本(照合先)は superproject の
;; manifest/repository-rules.edn(ADR-2607299000)。
{:schema "kotoba.repository-role-rules.v0"
 :vocabulary :name-prefix
 :prefix nil                ; prefix 無し = 再利用ライブラリ
 :role :library
 :execution :none           ; 走るものではない。値と関数だけ
 :must ["core は pure な .cljc(IO 無し)"
        "同じ受領証は nbb と JVM で同じハッシュになる(golden hash を test で固定)"]
 :must-not ["鍵の保管・取得を自前で実装しない(kagi 経路を使う。kagami と同じ流儀)"
            "受領証をクラウドへ送る経路をこの層に持たない(送るかどうかは利用側の判断)"]}
