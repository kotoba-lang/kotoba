{:paths ["src"]
 ;; Market-analogy price prediction over a generic {:cluster :unit :band-low :band-high} item
 ;; shape. Pure .cljc, no deps. First-class runtime is nbb (see bin/predict.cljk, test/); this
 ;; deps.edn exists only for the JVM last-resort compat path (ADR-0016 runtime-priority order).
 :deps {
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
