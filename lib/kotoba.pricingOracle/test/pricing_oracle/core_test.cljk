(ns pricing-oracle.core-test
  "nbb test for pricing-oracle.core. Self-contained-script + manual check/
  js/process.exit shape (this repo's nbb convention, NOT cljs.test).

  Run:  kbb --backend sci test/pricing_oracle/core_test.cljk   (exits non-zero on any mismatch)"
  (:require [pricing-oracle.core :as po]))

(def failures (atom 0))
(defn check [label pass?]
  (if pass?
    (println "PASS " label)
    (do (swap! failures inc) (println "FAIL " label))))

;; ---- median ----
(check "median odd" (= 3.0 (po/median [5 1 3])))
(check "median even" (= 2.5 (po/median [1 2 3 4])))
(check "median nil on empty" (nil? (po/median [])))
(check "median single" (= 7.0 (po/median [7])))

;; ---- known? ----
(check "known? true when both bounds present" (po/known? {:band-low 1 :band-high 2}))
(check "known? false when band-low nil" (not (po/known? {:band-low nil :band-high 2})))
(check "known? false when both nil" (not (po/known? {:band-low nil :band-high nil})))

;; ---- shape-family ----
(check "shape-family per-seat" (= :per-seat (po/shape-family "$/seat/mo")))
(check "shape-family per-unit-managed" (= :per-unit-managed (po/shape-family "$/unit/mo, $150 minimum")))
(check "shape-family enterprise" (= :enterprise-contract (po/shape-family "no self-serve band")))
(check "shape-family per-transaction" (= :per-transaction (po/shape-family "$/mo entry (~1,000 tasks)")))
(check "shape-family fallback" (= :flat-or-other (po/shape-family "flat, unlimited crew")))

;; ---- predict-band: tightest path (same cluster + same unit) ----
(def items-a
  [{:id "a1" :cluster :widgets :unit "$/seat/mo" :band-low 10.0 :band-high 20.0}
   {:id "a2" :cluster :widgets :unit "$/seat/mo" :band-low 20.0 :band-high 30.0}
   {:id "a3" :cluster :widgets :unit "$/seat/mo" :band-low 30.0 :band-high 40.0}
   {:id "gap" :cluster :widgets :unit "$/seat/mo" :band-low nil :band-high nil}])

(let [pred (po/predict-band (last items-a) items-a)]
  (check "predict-band cluster+unit method" (= :cluster-same-unit (:method pred)))
  (check "predict-band cluster+unit median low" (= 20.0 (:predicted-band-low pred)))
  (check "predict-band cluster+unit median high" (= 30.0 (:predicted-band-high pred)))
  (check "predict-band cluster+unit basis-count" (= 3 (:basis-count pred)))
  (check "predict-band cluster+unit confidence medium (n=3<5)" (= :medium (:confidence pred))))

;; ---- predict-band: same cluster, different unit -- beats a cross-cluster same-unit match ----
(def items-a2
  [{:id "a1" :cluster :widgets :unit "$/seat/mo" :band-low 10.0 :band-high 20.0}
   {:id "a2" :cluster :widgets :unit "$/mo/location" :band-low 100.0 :band-high 200.0}
   {:id "a3" :cluster :widgets :unit "$/mo/location" :band-low 300.0 :band-high 400.0}
   {:id "off-cluster" :cluster :gadgets :unit "$/gap-unit/mo" :band-low 999.0 :band-high 999.0}
   {:id "gap" :cluster :widgets :unit "$/gap-unit/mo" :band-low nil :band-high nil}])

(let [pred (po/predict-band (last items-a2) items-a2)]
  (check "predict-band prefers same-cluster over same-unit" (= :cluster-fallback (:method pred)))
  (check "predict-band cluster-fallback basis-count (all 3 same-cluster items)" (= 3 (:basis-count pred)))
  (check "predict-band cluster-fallback medium confidence (n=3>=2)" (= :medium (:confidence pred))))

;; ---- predict-band: falls back to same-unit across clusters ----
(def items-b
  [{:id "b1" :cluster :gadgets :unit "$/seat/mo" :band-low 40.0 :band-high 60.0}
   {:id "gap" :cluster :widgets :unit "$/seat/mo" :band-low nil :band-high nil}])

(let [pred (po/predict-band (last items-b) items-b)]
  (check "predict-band unit-fallback method" (= :unit-fallback (:method pred)))
  (check "predict-band unit-fallback low" (= 40.0 (:predicted-band-low pred))))

;; ---- predict-band: falls back to shape-family across units ----
(def items-c
  [{:id "c1" :cluster :gadgets :unit "$/user/mo" :band-low 5.0 :band-high 15.0}
   {:id "gap" :cluster :widgets :unit "$/seat/mo" :band-low nil :band-high nil}])

(let [pred (po/predict-band (last items-c) items-c)]
  (check "predict-band shape-fallback method" (= :shape-fallback (:method pred)))
  (check "predict-band shape-fallback low" (= 5.0 (:predicted-band-low pred))))

;; ---- predict-band: no comparable anywhere -> nil, not a fabricated number ----
(def items-d
  [{:id "gap" :cluster :widgets :unit "no self-serve band" :band-low nil :band-high nil}])
(check "predict-band nil when no comparable exists" (nil? (po/predict-band (first items-d) items-d)))

;; ---- predict-all-gaps: only gaps come back, known items untouched ----
(let [results (po/predict-all-gaps items-a)]
  (check "predict-all-gaps returns exactly the gaps" (= 1 (count results)))
  (check "predict-all-gaps carries the gap's id" (= "gap" (:id (first results)))))

(let [results (po/predict-all-gaps items-d)]
  (check "predict-all-gaps confidence :none when truly no comparable"
         (= :none (:confidence (first results))))
  (check "predict-all-gaps predicted-band-low nil when truly no comparable"
         (nil? (:predicted-band-low (first results)))))

(println (str "\n" (if (zero? @failures) "ALL PASS" (str @failures " FAILURE(S)"))))
(js/process.exit (if (zero? @failures) 0 1))
