(ns check-engine-dependencies
  (:require [cljs.reader :as edn]
            [clojure.walk :as walk]
            ["node:fs" :as fs]
            ["node:path" :as path]))

(def root (.cwd js/process))
(def imports (js->clj (js/JSON.parse
                       (fs/readFileSync (path/join root "maintenance/engine-source-imports.json") "utf8"))
                     :keywordize-keys true))
(defn read-edn [file] (edn/read-string (fs/readFileSync file "utf8")))
(defn localize [value]
  (walk/postwalk
   (fn [v]
     (if (map? v)
       (if (contains? v 'io.github.kotoba-lang/kotobase-engine-contract)
         (assoc v 'io.github.kotoba-lang/kotobase-engine-contract {:local/root "../.."})
         v)
       v)) value))
(doseq [source (:imports imports)]
  (let [old (read-edn (path/join root "maintenance/original-configs" (:id source) "deps.edn"))
        old-sci (read-edn (path/join root "maintenance/original-configs" (:id source) "nbb.edn"))
        current (read-edn (path/join root (:path source) "deps.edn"))
        sci (read-edn (path/join root (:path source) "nbb.edn"))]
    (assert (= current (localize old)) (str "external EDN dependency/alias drift: " (:id source)))
    (assert (= sci (assoc old-sci :paths (or (:paths old-sci) (:paths old)) :deps (:deps current)))
            (str "SCI settings/graph drift: " (:id source)))))
(println "Three engine projects: only the selected contract root localized; all external EDN values and aliases unchanged; SCI graph synchronized.")
