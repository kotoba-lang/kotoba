(ns kotobase.engine.merge-perf-test
  "Review B-R2-1: merge support must cost nothing on merge-free histories.
  Counts provider block requests for a fresh connection's first read of a
  300-transaction, folded history (main: 321 requests, ~1.3 s)."
  (:require #?(:clj [kotoba.test :refer [deftest is async]]
               :org.babashka/nbb [kotoba.test :refer [deftest is async]]
               :cljs [kotoba.test.cljs :refer-macros [deftest is async]])
            [kotobase.engine :as engine]
            [kotobase.storage.core :as storage]
            [kotobase.storage.memory :as memory]))

(defrecord Counting [inner calls]
  storage/IBlockStore
  (-put-blocks! [_ blocks] (storage/-put-blocks! inner blocks))
  (-get-blocks [_ cids] (swap! calls + 1) (storage/-get-blocks inner cids))
  storage/IRefStore
  (-read-ref [_ name] (storage/-read-ref inner name))
  (-compare-and-set-ref! [_ name e n] (storage/-compare-and-set-ref! inner name e n))
  storage/IBackendCapabilities
  (-capabilities [_] (storage/-capabilities inner)))

(def n 300)

(defn- open [store merge-settings]
  (engine/open (cond-> {:storage store
                        :encrypt-fn #(js/Promise.resolve %)
                        :decrypt-fn #(js/Promise.resolve %)
                        :blind-fn #(js/Promise.resolve (pr-str %))
                        :visible? (constantly true)}
                 merge-settings (assoc :merge merge-settings :trust-scope "perf"))))

(defn- fresh-read [inner merge-settings]
  (let [calls (atom 0)
        t0 (js/Date.now)]
    (-> (engine/q (open (->Counting inner calls) merge-settings) [nil nil nil])
        (.then (fn [rows] {:rows (count rows) :calls @calls
                           :ms (- (js/Date.now) t0)})))))

(deftest merge-free-reads-cost-what-main-costs
  (async done
    (let [inner (memory/memory-store)
          w (open inner nil)]
      (-> (reduce (fn [p i] (.then p (fn [_] (engine/transact! w [[(str "e" i) ":doc/n" (str i)]]))))
                  (js/Promise.resolve nil) (range n))
          (.then (fn [_] (engine/fold! w {:threshold 1})))
          (.then (fn [_]
                   (js/Promise.all
                    #js [(fresh-read inner nil)
                         (fresh-read inner {:database-id "tenant/db" :schema {}
                                            :max-closure 5})])))
          (.then (fn [[without with]]
                   (println "PERF without :merge" (pr-str without) "with :merge" (pr-str with))
                   (is (= n (:rows without) (:rows with)))
                   (is (<= (:calls without) (+ n 21)) "main: 321 requests")
                   (is (= (:calls without) (:calls with))
                       ":merge settings add no cost and no closure cap to linear reads")
                   (done)))
          (.catch (fn [e] (is false (ex-message e)) (done)))))))
