;; Acceptance test for wici.place (port of place.cljk).
;; main returns the number of failed cases (0 = all pass).
(ns wici.place-test
  (:export [main])
  (:require [wici.place :as wp]))

(defn- chk [ok :bool] :i64 (if ok 0 1))
(defn- kv [m :document k :keyword v :document] :document
  (document-assoc m (document-keyword k) v))
(defn- kn [k :keyword] :string (keyword-name k))
(defn- info [vram :i64 used :i64] :document
  (kv (kv (document-map) :vram-bytes (document-i64 vram)) :used-bytes (document-i64 used)))
(defn- devs2 [l :document r :document] :document
  (kv (kv (document-map) :local l) :remote r))

(defn main [] :i64
  (let [both (devs2 (info 8 2) (info 16 0))
        a (chk (string=? (kn (wp/place 5 both)) "local"))
        b (chk (string=? (kn (wp/place 7 both)) "remote"))
        c (chk (string=? (kn (wp/place 20 both)) "none"))
        remote-only (kv (document-map) :remote (info 16 0))
        d (chk (string=? (kn (wp/place 5 remote-only)) "remote"))
        nothing (devs2 (document-null) (document-null))
        e (chk (string=? (kn (wp/place 1 nothing)) "none"))
        no-used (devs2 (kv (document-map) :vram-bytes (document-i64 8)) (document-null))
        f (chk (string=? (kn (wp/place 8 no-used)) "local"))
        g (chk (string=? (kn (wp/place 9 no-used)) "none"))
        exact (devs2 (info 8 8) (document-null))
        h (chk (string=? (kn (wp/place 0 exact)) "local"))]
    (+ a (+ b (+ c (+ d (+ e (+ f (+ g h)))))))))
