(ns wici.wici-test
  (:require [kotoba.test :refer [deftest is testing]]
            [wici.device :as d]
            [wici.remote :as r]
            [wici.place :as place]))

(def kernels
  {"add"   (fn [[a b] _] (mapv + a b))
   "scale" (fn [[a] {:keys [k]}] (mapv #(* k %) a))})

(defn- run-on
  "The same application code, given any device."
  [dev]
  (let [a (d/alloc! dev 16) b (d/alloc! dev 16) o (d/alloc! dev 16)]
    (d/write! dev a [1 2 3])
    (d/write! dev b [10 20 30])
    (d/dispatch! dev "add" [a b] o nil)
    (d/dispatch! dev "scale" [o] o {:k 2})
    (d/read dev o)))

(deftest remote-is-indistinguishable-from-local
  (let [local (d/local {:kernels kernels})
        far   (r/remote (r/loopback (d/local {:kernels kernels})))]
    (is (= [22 44 66] (run-on local)))
    (is (= (run-on local) (run-on far)))))

(deftest remote-errors-look-local
  (let [far (r/remote (r/loopback (d/local {:kernels kernels :vram-bytes 32})))]
    (d/alloc! far 32)
    (is (thrown? #?(:clj Exception :cljs :default) (d/alloc! far 1)))
    (is (thrown? #?(:clj Exception :cljs :default) (d/read far 999)))
    (is (thrown? #?(:clj Exception :cljs :default) (d/dispatch! far "nope" [] 1 nil)))))

(deftest info-crosses-the-wire
  (let [far (r/remote (r/loopback (d/local {:kernels kernels :vram-bytes 100})))]
    (d/alloc! far 40)
    (is (= {:vram-bytes 100 :used-bytes 40 :kernels ["add" "scale"]} (d/info far)))))

(deftest placement
  (let [devs {:local {:vram-bytes 8 :used-bytes 0} :remote {:vram-bytes 1000 :used-bytes 0}}]
    (is (= :local (place/place 4 devs)))
    (is (= :remote (place/place 100 devs)))
    (is (= :none (place/place 5000 devs)))
    (is (= :remote (place/place 100 (assoc devs :local nil))))))
