(ns wici.transport.tcp-test
  (:require [kotoba.test :refer [deftest is async]]
            [wici.device :as d]
            [wici.transport.tcp :as t]))

(def kernels
  {"add"   (fn [[a b] _] (mapv + a b))
   "scale" (fn [[a] {:keys [k]}] (mapv #(* k %) a))})

(defn- rejects-with
  "Promise that resolves after asserting `p` rejected with a message matching `re`."
  [p re]
  (.then p
         (fn [_] (is false "expected rejection"))
         (fn [e] (is (re-find re (ex-message e))))))

(deftest real-socket-roundtrip
  (async done
    (let [server (t/serve! (d/local {:kernels kernels :vram-bytes 64}) 0)
          conn   (t/connect "127.0.0.1" (t/port server))
          dev    (t/device conn)
          finish (fn [] ((:close conn)) (.close server) (done))
          run    (fn [hs]
                   (let [[a b o] (vec hs)]
                     (-> (js/Promise.all #js [((:write! dev) a [1 2 3])
                                              ((:write! dev) b [10 20 30])])
                         (.then (fn [_] ((:dispatch! dev) "add" [a b] o nil)))
                         (.then (fn [_] ((:dispatch! dev) "scale" [o] o {:k 2})))
                         (.then (fn [_] ((:read dev) o)))
                         (.then (fn [r] (is (= [22 44 66] r))))
                         (.then (fn [_] (rejects-with ((:read dev) 999) #"unknown buffer")))
                         (.then (fn [_] (rejects-with ((:alloc! dev) 1000) #"out of device memory")))
                         (.then (fn [_] ((:info dev))))
                         (.then (fn [i] (is (= 48 (:used-bytes i))))))))]
      (-> (js/Promise.all #js [((:alloc! dev) 16) ((:alloc! dev) 16) ((:alloc! dev) 16)])
          (.then run)
          (.then finish finish)))))
