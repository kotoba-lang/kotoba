;; Port of wici.place (place.cljk), Kotoba-native.
;;
;; `devices` is a :document {:local info :remote info-or-nil}; each info is a
;; :document with :vram-bytes and :used-bytes.
;;
;; Named divergences from place.cljk:
;;   - A missing :vram-bytes counts as 0 (the source would throw on the nil
;;     subtraction). A missing :used-bytes counts as 0, as `(:used-bytes i 0)`.
;;   - A nil device and an absent device are both "not present".

(ns wici.place
  (:export [place]))

(defn- fld [m :document k :keyword] :document
  (option-or (document-get m (document-keyword k)) (document-null)))

(defn- present? [d :document] :bool
  (not (string=? (keyword-name (document-kind d)) "null")))

(defn- i64-field [m :document k :keyword dflt :i64] :i64
  (option-or (document-i64-value (fld m k)) dflt))

(defn- free-bytes [info :document] :i64
  (- (i64-field info :vram-bytes 0) (i64-field info :used-bytes 0)))

;; Pick :local or :remote for a workload needing `need-bytes`, or :none.
;; Prefers local (no network hop) when it fits.
(defn place [need-bytes :i64 devices :document] :keyword
  (let [local (fld devices :local)
        remote (fld devices :remote)]
    (cond
      (and (present? local) (<= need-bytes (free-bytes local))) :local
      (and (present? remote) (<= need-bytes (free-bytes remote))) :remote
      :else :none)))
