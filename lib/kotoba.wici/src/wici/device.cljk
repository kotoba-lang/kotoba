(ns wici.device
  "A GPU as an application sees it: allocate, write, read, dispatch.

  The point of WiCi is that the application cannot tell whether the device is
  in the chassis or across the air. So the interface is one protocol, a local
  reference implementation, and (in `wici.remote`) a proxy that satisfies the
  same protocol by sending each call as a message.

  The local device here is a CPU-simulated reference: kernels are plain
  functions registered by name. A real backend replaces `LocalDevice`; nothing
  above this namespace changes.")

(defprotocol IDevice
  (info      [d]                       "Capabilities + memory: {:vram-bytes :used-bytes :kernels}")
  (alloc!    [d n-bytes]               "Reserve a buffer, return its handle (integer).")
  (free!     [d handle]                "Release a buffer.")
  (write!    [d handle data]           "Copy `data` (vector of numbers) into the buffer.")
  (read      [d handle]                "Copy the buffer's contents out.")
  (dispatch! [d kernel in-handles out-handle args]
    "Run `kernel` over the input buffers, writing the output buffer."))

(defn- fail [msg data] (throw (ex-info (str "wici.device: " msg) data)))

(defn local
  "A local reference device. `kernels` maps name -> (fn [inputs args] output-vector)."
  [{:keys [vram-bytes kernels] :or {vram-bytes (* 8 1024 1024 1024)}}]
  (let [st (atom {:next 1 :bufs {} :sizes {}})]
    (reify IDevice
      (info [_]
        {:vram-bytes vram-bytes
         :used-bytes (reduce + 0 (vals (:sizes @st)))
         :kernels (vec (sort (keys kernels)))})
      (alloc! [_ n]
        (let [{:keys [sizes next]} @st
              used (reduce + 0 (vals sizes))]
          (when (> (+ used n) vram-bytes)
            (fail "out of device memory" {:requested n :used used :vram-bytes vram-bytes}))
          (swap! st #(-> % (update :next inc) (assoc-in [:sizes next] n) (assoc-in [:bufs next] [])))
          next))
      (free! [_ h]
        (swap! st #(-> % (update :bufs dissoc h) (update :sizes dissoc h)))
        nil)
      (write! [_ h data]
        (when-not (contains? (:bufs @st) h) (fail "unknown buffer" {:handle h}))
        (swap! st assoc-in [:bufs h] (vec data))
        nil)
      (read [_ h]
        (if-let [b (get-in @st [:bufs h])] b (fail "unknown buffer" {:handle h})))
      (dispatch! [_ k ins out args]
        (let [f (get kernels k)]
          (when-not f (fail "unknown kernel" {:kernel k}))
          (let [bufs (:bufs @st)
                inputs (mapv #(or (get bufs %) (fail "unknown buffer" {:handle %})) ins)]
            (when-not (contains? bufs out) (fail "unknown buffer" {:handle out}))
            (swap! st assoc-in [:bufs out] (vec (f inputs args)))
            nil))))))
