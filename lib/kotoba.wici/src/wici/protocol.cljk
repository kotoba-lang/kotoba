(ns wici.protocol
  "The WiCi wire protocol: device calls as EDN messages.

  One request/response per `IDevice` method. Messages are plain data so any
  transport can carry them — `kotoba.wire` EDN-over-TCP framing, `drpc`, a
  WebSocket, or a function call in a test. Transport is not this
  namespace's concern; `serve` is bytes-agnostic: request map in, response
  map out.

  Errors cross the wire as `{:ok false :error msg}` and are re-thrown by the
  proxy, so a remote failure looks like a local one."
  (:require [wici.device :as d]))

(def version 1)

(defn request [op & {:as args}]
  (merge {:wici version :op op} args))

(defn- serve* [dev {:keys [wici op] :as req}]
  (try
    (if (not= wici version)
      {:ok false :error (str "unsupported protocol version " (pr-str wici))}
      {:ok true
       :result
       (case op
         :info     (d/info dev)
         :alloc    (d/alloc! dev (:bytes req))
         :free     (d/free! dev (:handle req))
         :write    (d/write! dev (:handle req) (:data req))
         :read     (d/read dev (:handle req))
         :dispatch (d/dispatch! dev (:kernel req) (:in req) (:out req) (:args req))
         (throw (ex-info (str "unknown op " (pr-str op)) {:op op})))})
    (catch #?(:clj Exception :cljs :default) e
      {:ok false :error (ex-message e)})))

(defn serve
  "Handle one request against device `dev`. Never throws; failures become
  `{:ok false :error ...}`. A request's `:id` (if any) is echoed on the
  response so an async transport can match replies to calls."
  [dev {:keys [id] :as req}]
  (cond-> (serve* dev req)
    (some? id) (assoc :id id)))
