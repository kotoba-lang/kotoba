(ns wici.place
  "Where should a workload run? The trillion-parameter case: a model that does
  not fit local VRAM is placed on the remote device instead of failing.")

(defn place
  "Pick `:local` or `:remote` for a workload needing `need-bytes`.
  `devices` is {:local info-map :remote info-map-or-nil}. Prefers local (no
  network hop) when it fits; falls back to remote; otherwise `:none`."
  [need-bytes {:keys [local remote]}]
  (let [free (fn [i] (when i (- (:vram-bytes i) (:used-bytes i 0))))]
    (cond
      (and local (<= need-bytes (free local)))   :local
      (and remote (<= need-bytes (free remote))) :remote
      :else                                      :none)))
