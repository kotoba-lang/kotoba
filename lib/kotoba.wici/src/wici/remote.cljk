(ns wici.remote
  "A remote GPU that satisfies `wici.device/IDevice`.

  `(remote transport)` takes any `(fn [request-map] response-map)` and returns
  a device. Application code written against `IDevice` runs unchanged on a
  local or remote device — the WiCi promise, minus the silicon."
  (:require [wici.device :as d]
            [wici.protocol :as p]))

(defn- call [transport op & kvs]
  (let [{:keys [ok result error]} (transport (apply p/request op kvs))]
    (if ok
      result
      (throw (ex-info (str "wici.remote: " error) {:op op :error error})))))

(defn remote [transport]
  (reify d/IDevice
    (info [_] (call transport :info))
    (alloc! [_ n] (call transport :alloc :bytes n))
    (free! [_ h] (call transport :free :handle h))
    (write! [_ h data] (call transport :write :handle h :data (vec data)))
    (read [_ h] (call transport :read :handle h))
    (dispatch! [_ k ins out args]
      (call transport :dispatch :kernel k :in (vec ins) :out out :args args))))

(defn- pr-str-roundtrip [x]
  #?(:clj (clojure.edn/read-string (pr-str x))
     :cljs (cljs.reader/read-string (pr-str x))))

(defn loopback
  "A transport that serves straight into a local device — for tests, and for
  co-located use where no radio is involved. Round-trips through `pr-str` so
  anything not expressible as EDN fails here rather than on the air."
  [dev]
  (fn [req]
    (pr-str-roundtrip (p/serve dev (pr-str-roundtrip req)))))
