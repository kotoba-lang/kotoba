{:paths ["src"]
 ;; kotobase (kotoba-lang/kotobase) provides the IStore/ITransactionalStore
 ;; seam (kotobase.store) and the LocalStore oracle (kotobase.local) that
 ;; kotobase.ethereum.client caches observed chain data through. Pinned to
 ;; the same main SHA kotobase-protocols currently pins (revisioned
 ;; transactional IStore, PR #5).
 ;; kotobase-protocols provides kotobase.protocols.json — the dependency-
 ;; zero JSON encode/parse this repo's HTTP JSON-RPC transport reuses
 ;; rather than re-implementing (ADR-2607172600).
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/kotobase
        {:git/sha "bbf57df9dde5c1869182012860129a598382e088"}
        io.github.kotoba-lang/kotobase-protocols
        {:git/sha "3f65e67896e7d54c2bba1a7514ceeb0f614b9f54"}}
 ;; First-class runtime is nbb/cljs (repo-wide runtime priority):
 ;;   kbb --backend sci --classpath "src:test:<kotobase>/src:<kotobase-protocols>/src" bin/run_tests.cljk
 ;; The :test alias below is the :clj COMPAT suite only (rpc.cljc logic,
 ;; not the .cljs-only HTTP transport) — not the primary execution path.
 :aliases
 {:test {:extra-paths ["test"]}}}
