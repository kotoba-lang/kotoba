;; Port of authentication.model (model.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from model.cljk:
;;   - The three constant sets are zero-argument functions (factor-types,
;;     levels, decisions), as Kotoba has no def export.
;;   - (boolean ok?) is the :bool parameter itself.
;;   - (get opts :required-level :single-factor): an absent key yields the
;;     keyword default, a present key (even null) yields its stored value.
;;   - Missing option keys are stored as document-null, as nil is in the source.

(ns authentication.model
  (:export [factor-types levels decisions factor factor-request request decision]))

(defn factor-types [] :document
  (document-set (document-keyword :password) (document-keyword :webauthn) (document-keyword :passkey)
                (document-keyword :faceid) (document-keyword :touchid) (document-keyword :totp)
                (document-keyword :hotp) (document-keyword :email) (document-keyword :cacao)
                (document-keyword :siwe) (document-keyword :oauth) (document-keyword :oidc)
                (document-keyword :saml) (document-keyword :recovery)))

(defn levels [] :document
  (document-set (document-keyword :none) (document-keyword :single-factor)
                (document-keyword :multi-factor) (document-keyword :phishing-resistant)))

(defn decisions [] :document
  (document-set (document-keyword :authenticated) (document-keyword :challenge) (document-keyword :deny)))

(defn- field [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn factor [id :document type :document ok? :bool opts :document] :document
  (document-map :authn.factor/id id
                :authn.factor/type type
                :authn.factor/ok? (document-bool ok?)
                :authn.factor/subject (field opts :subject)
                :authn.factor/evidence-ref (field opts :evidence-ref)
                :authn.factor/assurance (field opts :assurance)
                :authn.factor/at (field opts :at)))

(defn factor-request [id :document type :document opts :document] :document
  (document-map :authn.factor-request/id id
                :authn.factor-request/type type
                :authn.factor-request/subject (field opts :subject)
                :authn.factor-request/challenge-ref (field opts :challenge-ref)
                :authn.factor-request/purpose (field opts :purpose)
                :authn.factor-request/created-at (field opts :created-at)))

(defn request [id :document subject :document opts :document] :document
  (document-map :authn.request/id id
                :authn.request/subject subject
                :authn.request/required-level (option-or (document-get opts :required-level)
                                                         (document-keyword :single-factor))
                :authn.request/purpose (field opts :purpose)
                :authn.request/created-at (field opts :created-at)))

(defn decision [req :document verdict :document factors :document opts :document] :document
  (document-map :authn.decision/request-id (field req :authn.request/id)
                :authn.decision/subject (field req :authn.request/subject)
                :authn.decision/decision verdict
                :authn.decision/level (field opts :level)
                :authn.decision/factors factors
                :authn.decision/issued-at (field opts :issued-at)))
