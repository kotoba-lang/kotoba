(ns authentication.model-test
  (:export [main])
  (:require [authentication.model :as m]))

(defn- expect [got :bool want :bool] :i64
  (if (= got want) 0 1))

(defn- edn-is [got :document want :string] :i64
  (if (string=? (document-edn-print got) want) 0 1))

(defn- field [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn main [] :i64
  (let [f (m/factor (document-string "f1") (document-keyword :totp) true
                    (document-map :subject (document-string "alice") :at (document-i64 7)))
        f2 (m/factor (document-string "f2") (document-keyword :email) false (document-map))
        r (m/request (document-string "r1") (document-string "alice") (document-map))
        r2 (m/request (document-string "r2") (document-string "bob")
                      (document-map :required-level (document-keyword :multi-factor)))
        d (m/decision r (document-keyword :authenticated) (document-vector f)
                      (document-map :level (document-keyword :multi-factor) :issued-at (document-i64 9)))]
    (+ (expect (= (document-count (m/factor-types)) 14) true)
       (expect (= (document-count (m/levels)) 4) true)
       (expect (= (document-count (m/decisions)) 3) true)
       (edn-is (field f :authn.factor/ok?) "true")
       (edn-is (field f2 :authn.factor/ok?) "false")
       (edn-is (field f :authn.factor/subject) "\"alice\"")
       (expect (= (document-kind (field f :authn.factor/evidence-ref)) :null) true)
       (edn-is (field f :authn.factor/at) "7")
       (edn-is (field r :authn.request/required-level) ":single-factor")
       (edn-is (field r2 :authn.request/required-level) ":multi-factor")
       (edn-is (field d :authn.decision/request-id) "\"r1\"")
       (edn-is (field d :authn.decision/decision) ":authenticated")
       (expect (= (document-count (field d :authn.decision/factors)) 1) true)
       (edn-is (field d :authn.decision/level) ":multi-factor")
       (edn-is (field d :authn.decision/issued-at) "9"))))
