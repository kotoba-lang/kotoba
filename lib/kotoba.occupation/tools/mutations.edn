;; One mutation per invariant. `:find` must occur EXACTLY ONCE in `:file` —
;; `tools/mutate.cljk` refuses otherwise, because a mutation that landed in a
;; comment or a second call site produces a red suite that proves nothing.
;;
;; ## SCOPE
;;
;; Covers the 2026-08-18 `.clj` → `.cljc` conversion: that the registry is
;; compiled in rather than read at runtime, that the generated projection
;; cannot drift from the EDN unnoticed, that the tx-data reconstitution is
;; really happening, that a registry handed in as nil does not flatten into a
;; complete-looking empty lookup, and that the portable SHA-256 that replaced
;; `java.security.MessageDigest` mints the SAME ids the JVM did. It does NOT
;; cover readiness, execution-plan, `route-gap`'s precedence table, the wave
;; assignment, or the ~130 per-actor `*-implemented` assertions — those have
;; 1,318 assertions and no mutations here, so a clean run of this table means
;; "the portability invariants are measured" and NOT "this library is
;; measured".
;;
;; ⚠ These mutations drive `kbb -M:test`. The `:cljs` half is exercised
;; by `test/run_portable.cljk`, which this harness does not run — a mutation
;; that broke only a `:cljs` branch would survive here, and this namespace
;; HAS a `:cljs` branch worth breaking (`utf8-bytes`). It was broken by hand
;; under nbb instead; see the conversion commit message.
;;
;; ⚠ Every mutation here is deliberately chosen to redden a BOUNDED number of
;; tests. That is not squeamishness: `tools/mutate.cljk` runs the suite under
;; Node's `execSync`, whose default `maxBuffer` is 1 MB, and a mutation that
;; reddens most of a suite this size overflows it — Node kills the child with
;; SIGTERM and the harness, correctly given what it can see, treats a
;; signalled child as an interrupted run and scores nothing. That was
;; measured in `kotoba-lang/industry` the same day, where replacing the
;; registry with `{}` produced 434 failures and could not be scored. So
;; `by-id` keyed on the wrong field, and `unblob` not unblobbing, are NOT in
;; this table: both are caught (they redden almost everything) and neither is
;; scoreable here. The narrow `:the-registry-is-the-projection-unaltered`
;; stands in their place.
;;
;; NOT written, with the reason: replacing `([] (occupations (registry)))`
;; with `([] (:occupations (registry)))`. It is a semantic no-op — the
;; one-arg body IS `(:occupations reg)` — so it reddens nothing for every
;; input including nil. The single-path form is still worth having (a guard
;; added to the one-arg form cannot be skipped by the zero-arg one) but it is
;; not an invariant anything can observe today. The same no-op was written
;; and removed in `kotoba-lang/technology` and `kotoba-lang/iso3166`.
[{:id :the-projection-cannot-drift-unnoticed
  :invariant "the generated namespace matches the EDN a human edits"
  :file "src/kotoba/occupation/embedded.cljk"
  :find "Manufacturing Managers"
  :replace "Manufacturing Managers DRIFTED"}

 {:id :the-drift-check-refuses-when-it-cannot-read
  :invariant "a check that could not run must not report a pass"
  :file "test/kotoba/occupation_test.cljk"
  :find "#?(:clj (try (slurp path) (catch Exception _ nil))"
  :replace "#?(:clj (try (slurp (str path \".missing\")) (catch Exception _ nil))"}

 {:id :by-id-does-not-invent-an-empty-index
  :invariant "(into {} …) over nil yields {} — an index over no data"
  :file "src/kotoba/occupation.cljk"
  :find "  ([reg] (when-let [occs (occupations reg)]\n           (into {} (map (juxt :id identity)) occs))))"
  :replace "  ([reg] (into {} (map (juxt :id identity)) (occupations reg))))"}

 {:id :the-registry-is-the-projection-unaltered
  :invariant "the library returns the projection as it is, not a doctored copy"
  :file "src/kotoba/occupation.cljk"
  :find "  (reconstitute-entity embedded/registry-tx))"
  :replace "  (dissoc (reconstitute-entity embedded/registry-tx) :kotoba.registry/id))"}

 {:id :reconstitute-drops-the-datomic-tempid
  :invariant ":db/id is a transaction artefact, not a registry field"
  :file "src/kotoba/occupation.cljk"
  :find "        (dissoc (first tx-data) :db/id)))"
  :replace "        (first tx-data)))"}

 {:id :the-draft-id-hash-is-sha-256
  :invariant "the portable hash mints the ids MessageDigest used to mint"
  :file "src/kotoba/occupation.cljk"
  :find "  (sha2/sha256-hex (utf8-bytes s)))"
  :replace "  (sha2/sha224-hex (utf8-bytes s)))"}

 {:id :the-hash-input-is-utf-8
  :invariant "the encoding is UTF-8, in both runtimes, byte for byte"
  :file "src/kotoba/occupation.cljk"
  :find "(.getBytes ^String s \"UTF-8\")"
  :replace "(.getBytes ^String s \"UTF-16\")"}

 {:id :the-gap-is-canonicalized-before-hashing
  :invariant "key order in the caller's gap map must not change the id"
  :file "src/kotoba/occupation.cljk"
  :find "  (let [canonical-gap (into (sorted-map) gap)]"
  :replace "  (let [canonical-gap gap]"}]
