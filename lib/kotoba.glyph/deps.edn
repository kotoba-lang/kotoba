{:paths ["src" "resources"]
 ;; Zero-dep, portable .cljc. `kotoba.glyph.*` is the CPU-side SDF text-layout
 ;; CONTRACT ported from kami-text (Rust, deleted-not-migrated per
 ;; ADR-2607010930 Phase 4): glyph classification, grapheme/script
 ;; segmentation, atlas rect packing, instanced-quad layout math, and
 ;; capacity/LRU glyph-set management. No font parsing, no rasterization,
 ;; no GPU — those stay host/platform adapter concerns (see README).
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
