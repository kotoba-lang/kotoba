{:work-id "kotoba-capability-machine-example"
 :unit "kotoba/example:kcm"
 :repo "kotoba-lang/example"
 :pin "0000000000000000000000000000000000000000"
 :prompt "Make the smallest capability-safe change and prove it with the declared Kotoba check."
 :machine :kotoba-capability-machine
 :requires [:nbb :node :git]
 :kcm/provider
 {:archive "/absolute/path/to/kotoba-provider.tar"
  :manifest "/absolute/path/to/kotoba-provider.manifest.edn"
  :archive-sha256 "replace-with-provider-archive-sha256"}
 :kcm/identity
 {:definition-closure-cid "bafy-definition-closure"
  :compiler-cid "bafy-compiler-revision"
  :module-lock-cid "bafy-module-lock"
  :target-abi :wasm32-component-v1
  :hostcaps-policy-cid "bafy-deny-by-default-policy"
  :provider-closure-sha256 "replace-with-provider-closure-sha256"
  :runtime-sha256 "replace-with-the-selected-node-runtime-sha256"
  :effects []}
 :kcm/capabilities #{:code/list :code/read :code/edit :build/check :build/compile}
 :kcm/checks
 [{:id :test
   :args ["check" "src/main.kotoba" "--policy" "capability-policy.edn"]
   :pure? true}]
 :kcm/builds
 [{:id :wasm
   :args ["compile" "src/main.kotoba" "--target" "wasm32-wasi"
          "--policy" "capability-policy.edn" "--output" "target/main.wasm"]}]
 :protected-paths [".github/" ".git/" "manifest/" "90-docs/adr/"]}
