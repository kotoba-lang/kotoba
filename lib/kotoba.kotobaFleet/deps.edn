{:paths ["src"]
 ;; Zero-dep, portable .cljc. The fleet-coordination substrate for running many
 ;; terminal coding agents in parallel without git conflict (ADR-2606302000):
 ;; lease (optimistic, lock-server-free) + governor-drain (single git writer) +
 ;; fleet-view, all as append-only datoms on a :db-api. Pure data + pure
 ;; functions; the backend (in-mem MemStore here ≡ langchain.db / kotoba-db in
 ;; production) is injected as a {:transact! :datoms :by :entity} map.
 :deps {
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  ;; contract test that the fleet runs on a real langchain db-api backend
  ;; (langchain.db in-process; same contract as langchain.kotoba-db XRPC). Kept
  ;; off the zero-dep :test path so the core lib stays dependency-free.
  :kotoba {:extra-paths ["test-kotoba"]
           :extra-deps {io.github.kotoba-lang/langchain
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.langchain"}}}
  ;; Source-only classpath for the NBB host. NBB cannot load Maven jars, so
  ;; callers filter `kbb -Spath -M:host-nbb` to directories before passing
  ;; it to `kbb --backend sci --classpath`. Keeping these pins here makes the host selftest
  ;; reproducible from a clean checkout instead of depending on whatever
  ;; happens to exist in ~/.gitlibs.
  :host-nbb
  {:extra-deps
   {io.github.kotoba-lang/langchain
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.langchain"}
    io.github.kotoba-lang/org-chainagnostic-cacao
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/org.chainagnostic.cacao"}
    io.github.kotoba-lang/org-ietf-ed25519
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/org.ietf.ed25519"}
    io.github.kotoba-lang/org-ietf-cbor
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/org.ietf.cbor"}}}
  :kotoba-compiler
  {:replace-deps {io.github.kotoba-lang/amu
                  {:git/url "https://github.com/kotoba-lang/amu.git"
                   :git/sha "78f43e64125e9c4bbe2bfb3a9520ae4b767dc275"}}
   :main-opts ["-m" "kotoba.compiler.cli"]}}}
