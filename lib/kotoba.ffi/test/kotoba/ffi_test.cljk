(ns kotoba.ffi-test
  "Portable tests: run on kbb (SCI/Node) AND on the JVM."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.ffi :as ffi]))

(defn- reason
  "The :kotoba.ffi/error keyword `f` throws, or ::no-throw."
  [f]
  (try (f) ::no-throw
       (catch #?(:clj Exception :cljs :default) e
         (or (:kotoba.ffi/error (ex-data e)) [::foreign-exception (str e)]))))

(deftest type-sizes-and-alignments
  (is (= {:i8 [1 1] :u8 [1 1] :i16 [2 2] :u16 [2 2] :i32 [4 4] :u32 [4 4]
          :i64 [8 8] :f32 [4 4] :f64 [8 8] :ptr [8 8]}
         (into {} (map (fn [t] [t [(ffi/type-size t) (ffi/type-align t)]]))
               [:i8 :u8 :i16 :u16 :i32 :u32 :i64 :f32 :f64 :ptr])))
  (is (ffi/type? :void))
  (is (not (ffi/type? :int)))
  (is (= :unknown-type (reason #(ffi/type-size :int))))
  (is (= :void-has-no-value (reason #(ffi/type-size :void)))))

(deftest value-ranges-at-the-boundary
  (testing "accepted exactly at the edges"
    (is (= 127 (ffi/check-value :i8 127)))
    (is (= -128 (ffi/check-value :i8 -128)))
    (is (= 255 (ffi/check-value :u8 255)))
    (is (= 0 (ffi/check-value :u8 0)))
    (is (= 2147483647 (ffi/check-value :i32 2147483647)))
    (is (= -2147483648 (ffi/check-value :i32 -2147483648)))
    (is (= 4294967295 (ffi/check-value :u32 4294967295))))
  (testing "refused one past the edges"
    (is (= :value-out-of-range (reason #(ffi/check-value :i8 128))))
    (is (= :value-out-of-range (reason #(ffi/check-value :i8 -129))))
    (is (= :value-out-of-range (reason #(ffi/check-value :u8 256))))
    (is (= :value-out-of-range (reason #(ffi/check-value :u8 -1))))
    (is (= :value-out-of-range (reason #(ffi/check-value :i32 2147483648))))
    (is (= :value-out-of-range (reason #(ffi/check-value :u32 4294967296)))))
  (testing "wrong kind"
    (is (= :not-an-integer (reason #(ffi/check-value :i32 1.5))))
    (is (= :not-a-number (reason #(ffi/check-value :f64 "1"))))
    (is (= :void-has-no-value (reason #(ffi/check-value :void 0))))))

(deftest signatures
  (testing "accepted"
    (is (= {:kotoba.ffi/ret :i32 :kotoba.ffi/args [:ptr :i32]} (ffi/signature :i32 [:ptr :i32])))
    (is (= {:kotoba.ffi/ret :void :kotoba.ffi/args []} (ffi/signature-void [])))
    (is (= [:i64] (:kotoba.ffi/args (ffi/signature :i64 '(:i64)))))
    (is (ffi/signature? (ffi/signature :void [:ptr]))))
  (testing "refused by name"
    (is (= :unknown-type (reason #(ffi/signature :int [:i32]))))
    (is (= :unknown-type (reason #(ffi/signature :i32 [:i32 :long]))))
    (is (= :args-not-sequential (reason #(ffi/signature :i32 :i32))))
    (is (= :args-not-sequential (reason #(ffi/signature :i32 #{:i32}))))
    (is (= :args-not-sequential (reason #(ffi/signature :i32 nil))))
    (is (= :void-argument (reason #(ffi/signature :i32 [:ptr :void]))))
    (is (not (ffi/signature? {:ret :i32})))))

;; Hand-computed C layouts (LP64, System V / AAPCS64 natural alignment).
(deftest struct-layouts
  (testing "struct { char c; int i; } -- 3 bytes interior padding"
    (is (= {:size 8 :align 4 :offsets {:c 0 :i 4}}
           (select-keys (ffi/struct-layout [[:c :i8] [:i :i32]]) [:size :align :offsets]))))
  (testing "struct { char a; double d; char b; } -- 7 trailing padding bytes"
    (is (= {:size 24 :align 8 :offsets {:a 0 :d 8 :b 16}}
           (select-keys (ffi/struct-layout [[:a :i8] [:d :f64] [:b :i8]]) [:size :align :offsets]))))
  (testing "struct { short s; char c; } -- trailing padding to 2"
    (is (= {:size 4 :align 2 :offsets {:s 0 :c 2}}
           (select-keys (ffi/struct-layout [[:s :i16] [:c :u8]]) [:size :align :offsets]))))
  (testing "struct { char a, b, c; } -- no padding at all"
    (is (= {:size 3 :align 1 :offsets {:a 0 :b 1 :c 2}}
           (select-keys (ffi/struct-layout [[:a :i8] [:b :i8] [:c :i8]]) [:size :align :offsets]))))
  (testing "nested: struct outer { char x; struct { char c; long l; } in; short y; }"
    (let [inner (ffi/struct-layout [[:c :i8] [:l :i64]])
          outer (ffi/struct-layout [[:x :i8] [:in inner] [:y :i16]])]
      (is (= [16 8] [(:size inner) (:align inner)]))
      (is (= {:size 32 :align 8 :offsets {:x 0 :in 8 :y 24}}
             (select-keys outer [:size :align :offsets])))))
  (testing "struct { int a; char b[3]; void *p; }"
    (is (= {:size 16 :align 8 :offsets {:a 0 :b 4 :p 8}}
           (select-keys (ffi/struct-layout [[:a :i32] [:b [:array :i8 3]] [:p :ptr]]) [:size :align :offsets]))))
  (testing "struct { float f; double d[2]; char c; }"
    (is (= {:size 32 :align 8 :offsets {:f 0 :d 8 :c 24}}
           (select-keys (ffi/struct-layout [[:f :f32] [:d [:array :f64 2]] [:c :i8]]) [:size :align :offsets]))))
  (testing "kvm_userspace_memory_region (linux/kvm.h) -- 32 bytes"
    (is (= {:size 32 :align 8 :offsets {:slot 0 :flags 4 :guest-phys-addr 8 :memory-size 16 :userspace-addr 24}}
           (select-keys (ffi/struct-layout [[:slot :u32] [:flags :u32] [:guest-phys-addr :i64]
                                            [:memory-size :i64] [:userspace-addr :i64]])
                        [:size :align :offsets]))))
  (testing "field records carry offset/size/align"
    (is (= {:name :i :type :i32 :offset 4 :size 4 :align 4}
           (second (:fields (ffi/struct-layout [[:c :i8] [:i :i32]]))))))
  (testing "refused by name"
    (is (= :empty-struct (reason #(ffi/struct-layout []))))
    (is (= :empty-struct (reason #(ffi/struct-layout nil))))
    (is (= :duplicate-field (reason #(ffi/struct-layout [[:a :i8] [:a :i32]]))))
    (is (= :unknown-type (reason #(ffi/struct-layout [[:a :long]]))))
    (is (= :unknown-type (reason #(ffi/struct-layout [[:a "i32"]]))))
    (is (= :void-has-no-value (reason #(ffi/struct-layout [[:a :void]]))))
    (is (= :bad-field (reason #(ffi/struct-layout [[:a]]))))
    (is (= :bad-array-length (reason #(ffi/struct-layout [[:a [:array :i8 0]]]))))))

(def ^:private libc
  (ffi/library {:symbols {"strlen" (ffi/signature :i64 [:ptr])
                          "getpid" (ffi/signature :i32 [])}}))

(deftest declared-binding-table
  (is (= (ffi/signature :i64 [:ptr]) (ffi/declared libc "strlen")))
  (is (= :undeclared-symbol (reason #(ffi/declared libc "system"))))
  (is (= ["getpid" "strlen"] (:declared (try (ffi/declared libc "system")
                                             (catch #?(:clj Exception :cljs :default) e (ex-data e))))))
  (is (= :bad-signature (reason #(ffi/library {:symbols {"f" [:i32 [:i32]]}}))))
  (is (= :bad-symbol-name (reason #(ffi/library {:symbols {:f (ffi/signature :i32 [])}}))))
  (is (= :bad-library (reason #(ffi/library {}))))
  (testing "undeclared is refused before the host is consulted (both hosts)"
    (is (= :undeclared-symbol (reason #(ffi/bind libc nil nil "system"))))))

#?(:cljs
   (deftest every-host-fn-refuses-on-node
     (is (= :node ffi/host))
     (let [calls {'layout #(ffi/layout :i32)
                  'descriptor #(ffi/descriptor (ffi/signature :i32 []))
                  'native-linker #(ffi/native-linker)
                  'default-lookup #(ffi/default-lookup nil)
                  'loader-lookup #(ffi/loader-lookup)
                  'library-lookup #(ffi/library-lookup "/usr/lib/libc.so.6" nil)
                  'load-library! #(ffi/load-library! "/usr/lib/libc.so.6")
                  'find-symbol #(ffi/find-symbol nil "strlen")
                  'find-symbol! #(ffi/find-symbol! nil "strlen")
                  'downcall #(ffi/downcall nil nil (ffi/signature :i32 []))
                  'method-handle #(ffi/method-handle nil)
                  'invoke #(ffi/invoke nil 1 2)
                  'invoke-list #(ffi/invoke-list nil [1 2])
                  'confined-arena #(ffi/confined-arena)
                  'shared-arena #(ffi/shared-arena)
                  'auto-arena #(ffi/auto-arena)
                  'global-arena #(ffi/global-arena)
                  'alloc #(ffi/alloc nil :i32)
                  'alloc-bytes #(ffi/alloc-bytes nil 8)
                  'c-string #(ffi/c-string nil "x")
                  'put! #(ffi/put! nil :i32 0 1)
                  'fetch #(ffi/fetch nil :i32 0)
                  'byte-size #(ffi/byte-size nil)
                  'copy-from! #(ffi/copy-from! nil nil)
                  'of-array #(ffi/of-array (js/Int8Array. 4))
                  'reinterpret #(ffi/reinterpret nil 8)
                  'address #(ffi/address nil)
                  'null-segment #(ffi/null-segment)
                  'segment-string #(ffi/segment-string nil)
                  'as-slice #(ffi/as-slice nil 0 1)
                  'map-file #(ffi/map-file nil "/etc/hosts" 0 1)
                  'bind #(ffi/bind libc nil nil "strlen")}]
       (testing "the census covers every declared host fn"
         (is (= (set ffi/host-fns) (set (keys calls))))
         (is (= 32 (count calls))))
       (doseq [[nm f] calls]
         (let [data (try (f) nil (catch :default e (ex-data e)))]
           (is (= :unsupported-host (:kotoba.ffi/error data)) (str nm))
           (is (= :node (:host data)) (str nm))
           (is (= (keyword (name nm)) (:op data)) (str nm))))
       (testing "3-arity forms refuse too"
         (is (= :unsupported-host (reason #(ffi/alloc-bytes nil 8 8))))
         (is (= :unsupported-host (reason #(ffi/reinterpret nil 8 nil))))))
     (testing "a pure refusal still wins over the host refusal"
       (is (= :unknown-type (reason #(ffi/layout :long)))))
     (testing "predicates answer false instead of refusing"
       (is (false? (ffi/segment? 1)))
       (is (false? (ffi/arena? 1))))))

#?(:clj
   (deftest host-is-jvm
     (is (= :jvm ffi/host))))
