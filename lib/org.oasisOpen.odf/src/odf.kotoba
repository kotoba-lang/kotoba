(ns odf
  (:export [main kind summary paragraph-count paragraph-text]))

(defn includes? [text :string needle :string] :bool
  (if (string=? text (string-replace-all text needle "")) false true))

(defn kind [mimetype :string] :keyword
  (if (includes? mimetype "spreadsheet")
    :ods
    (if (includes? mimetype "presentation")
      :odp
      (if (includes? mimetype "text") :odt :odf))))

(defn paragraph-count [content-xml :string] :i64
  (xml-name-count content-xml "text:p"))

(defn paragraph-text [content-xml :string index :i64] [:option :string]
  (xml-name-text content-xml "text:p" index))

(defn summary [mimetype :string content-xml :string entry-count :i64] :document
  (document-map
    :kind (document-keyword (kind mimetype))
    :entry-count (document-i64 entry-count)
    :paragraph-count (document-i64 (paragraph-count content-xml))))

(defn main [] :i64 0)
