{;; lg-curpus2skill — clj-native port of the Python LangGraph server
 ;; (ADR-2606280030, langgraph-python → langgraph-clj). Scoped to THIS app only
 ;; (does NOT touch the repo-root bb.edn). Pins langgraph-clj / langchain-clj to
 ;; the same SHAs as the repo-root bb.edn so the StateGraph idiom is identical to
 ;; the wave-1 twins (recap / docs / webmk / kyber). cheshire + babashka.http-client
 ;; are bb built-ins.
 ;;
 ;;   src   — lg-curpus2skill.* namespaces (graphs + store + audit + server)
 ;;   test  — lg-curpus2skill.smoke-test (clojure.test)
 ;;
 ;; Run the suite:  bb test   (or:  kbb run_tests.cljk)
 ;; Start server:   bb serve  [PORT]
 :paths ["src" "test"]
 :deps {com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/com-junkawasaki/langgraph-clj"
         :git/sha "c7daa07d4e50f55d7e2a02e4b89dbeb2b200961d"}
        com-junkawasaki/langchain-clj
        {:git/url "https://github.com/com-junkawasaki/langchain-clj"
         :git/sha "2b03859c3ee722b64f3eddd0b615a54019b17c81"}}
 :tasks
 {test  {:doc "Run the lg-curpus2skill clojure.test suite under bb."
         :task (load-file "run_tests.clj")}
  serve {:doc "Start the lg-curpus2skill XRPC/runs HTTP server."
         :requires ([babashka.http-client :as http]
                    [org.httpkit.server :as httpkit]
                    [lg-curpus2skill.audit :as audit]
                    [lg-curpus2skill.server :as server]
                    [lg-curpus2skill.store :as store])
         :task
         (let [env (fn [name default] (or (System/getenv name) default))
               enabled? (fn [name default] (= "1" (env name default)))
               port (Integer/parseInt
                     (or (first *command-line-args*) (env "PORT" "2024")))
               audit-config
               {:disabled? (enabled? "LG_AUDIT_DISABLED" "0")
                :dispatcher-url
                (env "BPMN_DISPATCHER_INTERNAL_URL"
                     "http://bpmn-dispatcher.mitama-udf.svc.cluster.local:8080")
                :internal-secret (env "BPMN_DISPATCHER_INTERNAL_SECRET" "")
                :timeout-ms
                (long (* 1000
                         (Double/parseDouble (env "LG_AUDIT_TIMEOUT_SEC" "3.0"))))}
               store-enabled?
               (or (enabled? "C2S_STORE_ENABLED" "0")
                   (boolean (seq (env "RW_URL" ""))))]
           (binding [audit/*config* audit-config
                     audit/*post!* http/post
                     store/*enabled?* store-enabled?]
             (server/start!
              (fn [_ options]
                (httpkit/run-server
                 (fn [request]
                   (binding [audit/*config* audit-config
                             audit/*post!* http/post
                             store/*enabled?* store-enabled?]
                     (server/handler request)))
                 options))
              {:port port}))
           (deref (promise)))}}}
