;; この repo が満たすと主張する契約。workspace authority は
;; com-junkawasaki/root の manifest/repository-rules.edn（ADR-2607299000）。
;; prefix 無し = :library（authority の :name-prefix vocabulary）。
{:schema "kotoba.repository-role-rules.v0"
 :prefix nil
 :role :library
 :must [:provide-reusable-contract]
 :must-not [:perform-io :bind-to-one-ci-provider]
 :note "west manifest と GitHub 実態の乖離検査。IO はせず findings を data で返す。
        GitHub Actions と murakumo fleet-ci の両方が同じ実装を呼ぶための単一の正本。"}
