;; No dependencies. TOML is a grammar and nothing else; a leaf that dragged a parser
;; combinator library behind it would be more code than the grammar. The
;; one consumer today is a .ts file that ADR-2608260900 retires.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
