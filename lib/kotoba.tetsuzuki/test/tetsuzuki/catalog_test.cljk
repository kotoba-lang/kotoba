(ns tetsuzuki.catalog-test
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer-macros [deftest is testing]])
            [tetsuzuki.catalog :as catalog]
            [tetsuzuki.coverage :as coverage]
            [tetsuzuki.procedure :as procedure]
            [tetsuzuki.vocabulary :as v]))

(deftest catalog-conforms-to-the-full-shape
  (let [r (procedure/conform catalog/procedures :full)]
    (is (:ok? r) (str "違反: " (procedure/explain-violations r)))
    (is (= 18 (:procedures r)))))

(deftest procedure-ids-are-unique-across-jurisdictions
  (is (procedure/unique-ids? catalog/procedures)
      (str "重複: " (procedure/duplicate-ids catalog/procedures))))

(deftest five-jurisdictions-are-covered
  (is (= ["CAN" "DEU" "GBR" "JPN" "USA"] (vec (sort (keys catalog/procedures))))))

(deftest every-lapse-effect-has-a-real-statutory-example
  (testing "5 つの徒過効果すべてに実在の条文の裏付けがある"
    (let [idx (catalog/lapse-effect-index)]
      (is (some #(re-find #"DEU/de-genehmigungsfiktion" %) (:deemed-granted idx))
          "みなし許可: ドイツ VwVfG §42a")
      (is (some #(re-find #"CAN/ca-atip-request" %) (:deemed-refused idx))
          "みなし拒否: カナダ ATIA s.10(3)")
      (is (some #(re-find #"USA/us-foia-request" %) (:exhausts-remedy idx))
          "出訴適格: 米 FOIA")
      (is (some #(re-find #"GBR/gb-foi-request" %) (:exhausts-remedy idx))
          "出訴適格: 英 FOIA")
      (is (some #(re-find #"JPN/jp-shinsei-shobun" %) (:none idx))
          "効果なし: 日本の標準処理期間")
      (is (seq (:forfeits-right idx)) "失権: 各法域の不服申立期間"))))

(deftest germany-and-canada-give-opposite-effects-to-the-same-silence
  (testing "同じ「行政庁が期限内に応答しない」が正反対の効果を持つ"
    (is (= :deemed-granted
           (:proc/lapse-effect (catalog/procedure "DEU" :de-genehmigungsfiktion))))
    (is (= :deemed-refused
           (:proc/lapse-effect (catalog/procedure "CAN" :ca-atip-request))))
    (testing "どちらも行政庁を縛る期限である（同じ列で比較できる）"
      (is (= :authority (:binds (:proc/deadline (catalog/procedure "DEU" :de-genehmigungsfiktion)))))
      (is (= :authority (:binds (:proc/deadline (catalog/procedure "CAN" :ca-atip-request))))))))

(deftest authority-side-deadlines-dominate-general-administration
  (testing "選挙の手続きは全部 filer 側だったが、一般行政は行政庁側が主役"
    (let [b (coverage/who-is-bound)]
      (is (pos? (:authority b)))
      (is (pos? (:filer b)))
      (is (> (:authority b) (:filer b))
          "一般行政では行政庁を縛る期限のほうが多い"))))

(deftest units-are-not-all-calendar-days
  (testing "暦日以外が実在する —— だから単位を型に入れた"
    (let [u (coverage/units-in-use)]
      (is (contains? u :business-days) "米 FOIA")
      (is (contains? u :working-days) "英 FOIA")
      (is (contains? u :months) "独・英・日の不服申立て")
      (is (contains? u :calendar-days) "日本の開示決定・カナダの ATIA"))))

(deftest statute-and-authority-published-are-different
  (testing "日本 §39③ は 30 日以上を法定し、米 APA §553 は数値を置かない"
    (is (= :statute (:source (:proc/deadline (catalog/procedure "JPN" :jp-public-comment)))))
    (is (= :authority-published
           (:source (:proc/deadline (catalog/procedure "USA" :us-notice-and-comment)))))))

(deftest notification-is-not-an-application
  (testing "届出は審査の対象ではない（行政手続法 §37）"
    (let [p (catalog/procedure "JPN" :jp-todokede)]
      (is (= :notification (:proc/kind p)))
      (is (false? (procedure/reviewable? p)))
      (is (= [] (:proc/formal-review p))))))

(deftest unknown-and-none-lapse-effects-are-distinguished
  (testing "「調べた結果 効果が無い」と「調べていない」を分ける"
    (is (= :none (:proc/lapse-effect (catalog/procedure "JPN" :jp-shinsei-shobun))))
    (is (= :unknown (:proc/lapse-effect (catalog/procedure "DEU" :de-ifg-antrag))))))

(deftest uncovered-jurisdiction-is-nil-not-empty
  (is (nil? (catalog/for-jurisdiction "IND")))
  (is (false? (catalog/jurisdiction-covered? "IND")))
  (is (nil? (catalog/procedure "IND" :whatever))))

(deftest coverage-names-the-gaps
  (let [c (coverage/report)]
    (is (= 5 (:count c)))
    (is (= 18 (:procedures c)))
    (is (<= 10 (count (:uncovered-large c))))
    (is (some #(re-find #"IND" %) (:uncovered-large c)))
    (is (seq (:needs-source-check c)))
    (is (re-find #"spec-basis 無し" (:note c)))
    (testing "分野固有カタログが別にあることを明示する"
      (is (re-find #"senkyo" (:note c))))))

(deftest every-vocabulary-value-used-is-in-the-closed-set
  (doseq [[iso3 ps] catalog/procedures [pid p] ps]
    (let [where (str iso3 "/" pid)]
      (is (contains? v/procedure-kinds (:proc/kind p)) where)
      (is (contains? v/lapse-effects (:proc/lapse-effect p)) where)
      (is (contains? v/confidences (:proc/confidence p)) where)
      (when-let [d (:proc/deadline p)]
        (is (contains? v/deadline-binds (:binds d)) where)
        (is (contains? v/deadline-sources (:source d)) where)))))
