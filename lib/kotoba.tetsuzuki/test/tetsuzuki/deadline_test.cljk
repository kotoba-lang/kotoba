(ns tetsuzuki.deadline-test
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer-macros [deftest is testing]])
            [tetsuzuki.catalog :as catalog]
            [tetsuzuki.deadline :as deadline]))

(def cal deadline/default-calendar)

(defn- business-days-between
  "(from, to] の営業日数。"
  [c from to]
  (count (filter #(deadline/business-day? c %) (range (inc from) (inc to)))))

(deftest business-days-are-not-calendar-days
  (let [base 20460
        r (deadline/add-business-days cal base 20)]
    (is (> r (+ base 20)) "営業日 20 日は暦日 20 日より必ず後")
    (is (= 20 (business-days-between cal base r))
        "数えた営業日がちょうど 20")
    (is (deadline/business-day? cal r) "着地日自体も営業日")))

(deftest foia-twenty-business-days-resolves-later-than-naive-calendar
  (testing "米 FOIA を暦日で計算すると、遅れていない agency を遅れていると判定する"
    (let [p (catalog/procedure "USA" :us-foia-request)
          ctx {:anchors {:filing-received 20460} :calendar cal}
          due (deadline/resolve-deadline (:proc/deadline p) ctx)]
      (is (integer? due))
      (is (> due (+ 20460 20)))
      (testing "暦日 20 日目の応答は期限内である"
        (is (= :within (deadline/status (:proc/deadline p) ctx (+ 20460 20))))))))

(deftest business-days-without-a-calendar-do-not-fall-back-to-calendar-days
  (let [p (catalog/procedure "GBR" :gb-foi-request)]
    (is (= :needs-business-calendar
           (deadline/resolve-deadline (:proc/deadline p)
                                      {:anchors {:filing-received 20460}
                                       :calendar nil}))
        "休日カレンダーが無ければ暦日で近似せず止まる")))

(deftest months-are-not-approximated-as-thirty-days
  (let [p (catalog/procedure "JPN" :jp-shinsa-seikyu)]
    (is (= :needs-calendar-date
           (deadline/resolve-deadline (:proc/deadline p)
                                      {:anchors {:disposition-known 20460}}))
        "月は epoch-day では解けない —— 30 日で近似して静かに間違えない")))

(deftest authority-published-is-not-no-deadline
  (testing "「各行政庁が定めて公表する」と「期限が無い」を分ける"
    (let [jp (catalog/procedure "JPN" :jp-shinsei-shobun)
          todokede (catalog/procedure "JPN" :jp-todokede)]
      (is (= :authority-published
             (deadline/resolve-deadline (:proc/deadline jp) {:anchors {}})))
      (is (= :no-deadline
             (deadline/resolve-deadline (:proc/deadline todokede) {:anchors {}}))))))

(deftest unknown-anchor-is-not-no-deadline
  (let [p (catalog/procedure "CAN" :ca-atip-request)]
    (is (= :unknown-anchor
           (deadline/resolve-deadline (:proc/deadline p) {:anchors {}})))
    (is (= 20490
           (deadline/resolve-deadline (:proc/deadline p)
                                      {:anchors {:filing-received 20460}})))))

(deftest at-least-is-a-floor-not-a-ceiling
  (testing "意見公募の 30 日以上は下限。上限型と同じ列に入れると意味が反転する"
    (let [p (catalog/procedure "JPN" :jp-public-comment)]
      (is (= :at-least (:direction (:proc/deadline p))))
      (is (= :authority (:binds (:proc/deadline p)))))))

(deftest status-never-collapses-unresolved-into-within
  (let [p (catalog/procedure "CAN" :ca-atip-request)]
    (is (= :within (deadline/status (:proc/deadline p)
                                    {:anchors {:filing-received 20460}} 20470)))
    (is (= :lapsed (deadline/status (:proc/deadline p)
                                    {:anchors {:filing-received 20460}} 20500)))
    (is (= :unknown-anchor (deadline/status (:proc/deadline p) {:anchors {}} 20470)))
    (is (= :unknown-observation
           (deadline/status (:proc/deadline p)
                            {:anchors {:filing-received 20460}} nil)))))

(deftest lapse-consequence-only-fires-when-lapsed
  (let [p (catalog/procedure "DEU" :de-genehmigungsfiktion)
        ctx {:anchors {:filing-received 20460}}]
    (testing "月単位なので解けず、徒過判定も出ない"
      (is (nil? (deadline/lapse-consequence p ctx 20600))))
    (testing "暦日で書かれた手続きなら徒過効果が出る"
      (let [ca (catalog/procedure "CAN" :ca-atip-request)]
        (is (= :deemed-refused
               (deadline/lapse-consequence ca {:anchors {:filing-received 20460}} 20500)))
        (is (nil? (deadline/lapse-consequence ca {:anchors {:filing-received 20460}} 20470)))))))

(deftest binds-distinguishes-filer-from-authority
  (is (true? (deadline/authority-side? (catalog/procedure "USA" :us-foia-request))))
  (is (false? (deadline/authority-side? (catalog/procedure "DEU" :de-widerspruch))))
  (is (= :filer (deadline/binds (catalog/procedure "GBR" :gb-judicial-review)))))

(deftest weekend-detection-matches-the-epoch
  (testing "1970-01-01 (epoch-day 0) は木曜"
    (is (false? (deadline/weekend? cal 0)))
    (is (true? (deadline/weekend? cal 2)) "1970-01-03 は土曜")
    (is (true? (deadline/weekend? cal 3)) "1970-01-04 は日曜")
    (is (false? (deadline/weekend? cal 4)) "1970-01-05 は月曜")))

(deftest holidays-shift-the-result
  (let [c {:weekend #{2 3} :holidays #{20464 20465}}
        base 20460]
    (is (> (deadline/add-business-days c base 10)
           (deadline/add-business-days cal base 10))
        "祝日を渡すと期限は後ろへずれる")))

(deftest valid-deadline-rejects-open-vocabulary
  (is (true? (deadline/valid-deadline? nil)))
  (is (true? (deadline/valid-deadline?
              {:binds :authority :source :statute :anchor :filing-received
               :offset 20 :unit :business-days :direction :after})))
  (is (false? (deadline/valid-deadline?
               {:binds :authority :source :statute :anchor :made-up
                :offset 20 :unit :business-days :direction :after})))
  (is (false? (deadline/valid-deadline?
               {:source :statute :anchor :filing-received
                :offset 20 :unit :business-days :direction :after}))
      ":binds が無い期限は不可 —— 誰を縛るか不明な期限は使えない"))
