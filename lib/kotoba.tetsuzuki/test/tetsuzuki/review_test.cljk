(ns tetsuzuki.review-test
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer-macros [deftest is testing]])
            [tetsuzuki.catalog :as catalog]
            [tetsuzuki.ooyake :as ooyake]
            [tetsuzuki.review :as review]))

(deftest complete-and-deficient
  (let [p (catalog/procedure "CAN" :ca-atip-request)
        items (:proc/formal-review p)]
    (is (= :complete (review/outcome p items)))
    (is (= :deficient (review/outcome p (drop 1 items))))
    (is (= 1 (count (review/outstanding p (drop 1 items)))))
    (is (true? (review/complete? p items)))
    (is (false? (review/complete? p (drop 1 items))))))

(deftest notification-is-not-reviewable
  (let [p (catalog/procedure "JPN" :jp-todokede)]
    (is (= :not-reviewable (review/outcome p [])))
    (is (= [] (review/outstanding p [])))
    (is (true? (review/complete? p [])) "審査対象でないものを不備扱いしない")
    (is (false? (review/blocking? (review/outcome p []))))))

(deftest unknown-is-nil-not-false
  (testing "「未充足」と「判定できない」を同じ偽値にしない"
    (is (nil? (review/complete? nil [])))
    (is (= :unknown (review/outcome nil [])))
    (is (nil? (review/outstanding nil [])))))

(deftest unknown-blocks
  (testing "知らないまま次の行政行為へ進めない"
    (is (true? (review/blocking? :unknown)))
    (is (true? (review/blocking? :deficient)))
    (is (false? (review/blocking? :complete)))
    (is (false? (review/blocking? :not-reviewable)))))

(deftest deficiency-notice-explains-why
  (let [p (catalog/procedure "CAN" :ca-atip-request)
        n (review/deficiency-notice "CAN" :ca-atip-request p [])]
    (is (= :deficient (:outcome n)))
    (is (seq (:outstanding n)))
    (is (string? (:legal-basis n)))
    (is (re-find #"求めるかどうかは行政庁の判断" (:note n))
        "補正を求めるかどうかを actor が決めない"))
  (testing "届出には届出の説明が出る"
    (let [p (catalog/procedure "JPN" :jp-todokede)
          n (review/deficiency-notice "JPN" :jp-todokede p [])]
      (is (= :not-reviewable (:outcome n)))
      (is (re-find #"到達で義務は履行" (:note n))))))

;; ── ooyake アダプタ ─────────────────────────────────────────────────

(def ooyake-seed-fixture
  "ooyake の実データの形をなぞった最小 fixture（実測 2026-08-07 の 12 属性、
  期限も徒過効果も形式審査項目も持たない）。"
  [{:gov.procedure/id "proc.usa.passport-application"
    :gov.procedure/jurisdiction "usa"
    :gov.procedure/title-en "U.S. passport application"
    :gov.procedure/owner-unit "gov.usa.state"
    :gov.procedure/owner-authority "U.S. Department of State"
    :gov.procedure/required-docs ["DS-11" "proof of citizenship" "photo"]
    :gov.procedure/provenance "https://travel.state.gov/"
    :gov.procedure/sourcing :authoritative
    :gov.procedure/verification-status :unverified-seed
    :gov.procedure/last-verified "2026-06-04"
    :gov.procedure/toritsugi-ref "toritsugi.usa.passport"}
   {:gov.procedure/id "proc.jpn.juminhyo"
    :gov.procedure/jurisdiction "jpn"
    :gov.procedure/title-en "Certificate of residence"
    :gov.procedure/title-local "住民票の写しの交付請求"
    :gov.procedure/owner-unit "gov.jpn.mic"
    :gov.procedure/owner-authority "市区町村"
    :gov.procedure/required-docs ["本人確認書類" "手数料"]
    :gov.procedure/provenance "https://www.soumu.go.jp/"
    :gov.procedure/sourcing :authoritative
    :gov.procedure/verification-status :unverified-seed
    :gov.procedure/last-verified "2026-06-04"
    :gov.procedure/toritsugi-ref "toritsugi.jpn.juminhyo"}])

(deftest ooyake-seeds-are-copied-not-upgraded
  (let [cat (ooyake/seeds->catalog ooyake-seed-fixture)]
    (is (= ["JPN" "USA"] (vec (sort (keys cat)))))
    (testing "無いものを作らない —— 期限も形式審査項目も nil のまま"
      (doseq [[_ ps] cat [_ p] ps]
        (is (nil? (:proc/deadline p)))
        (is (nil? (:proc/formal-review p)))
        (is (nil? (:proc/legal-basis p)))))
    (testing "検証状態を落とさずに運ぶ"
      (is (= :unverified-seed
             (:proc/verification-status (get-in cat ["USA" :proc.usa.passport-application])))))
    (testing "出所を記録する"
      (is (= :ooyake-seed
             (:proc/origin (get-in cat ["JPN" :proc.jpn.juminhyo])))))))

(deftest ooyake-seeds-do-not-conform-and-the-report-says-so
  (let [r (ooyake/promotion-report ooyake-seed-fixture)]
    (is (pos? (:core-violations r))
        "写しただけで適合させない —— 適合しないことが正しい状態")
    (is (= {:unverified-seed 2} (:verification-status r)))
    (is (re-find #"昇格の唯一の経路は条文を確認して" (:note r)))
    (is (some #{:proc/deadline} (:missing-fields r)))
    (is (some #{:proc/lapse-effect} (:missing-fields r)))))

(deftest promotion-requires-verification-and-a-legal-basis
  (let [seed (first ooyake-seed-fixture)]
    (is (false? (ooyake/promotable? seed {:legal-basis "22 U.S.C. §211a"}))
        "未検証 seed は根拠法があっても昇格させない")
    (is (false? (ooyake/promotable?
                 (assoc seed :gov.procedure/verification-status :maintainer-verified)
                 {:legal-basis nil}))
        "検証済みでも根拠法が無ければ昇格させない")
    (is (true? (ooyake/promotable?
                (assoc seed :gov.procedure/verification-status :maintainer-verified)
                {:legal-basis "22 U.S.C. §211a"})))))
