;; nbb テストエントリ。
;;   kbb --backend sci --classpath src:test run_tests.cljk
(ns run-tests
  (:require [cljs.test :as t]
            [tetsuzuki.catalog-test]
            [tetsuzuki.deadline-test]
            [tetsuzuki.review-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println (str "\n" (if (t/successful? m) "PASS" "FAIL")
                " — " (:test m) " tests, " (:pass m) " assertions, "
                (:fail m) " failures, " (:error m) " errors"))
  (when-not (t/successful? m) (js/process.exit 1)))

(t/run-tests 'tetsuzuki.catalog-test
             'tetsuzuki.deadline-test
             'tetsuzuki.review-test)
