(ns tetsuzuki.procedure
  "手続き entry の**形**と、その形への適合検査。

  この repo の値は「日本の情報公開は 30 日」という事実そのものより、
  **どの法域のどの手続きも同じ形で書ける**ことにある。形が共有されて
  いなければ、分野ごとのカタログ（選挙・税・入管・建築…）が別々の語彙で
  増え、法域跨ぎの比較も、期限管理の共通実装も、どちらもできない。

  ## 2 段階の適合

  - **`core`** — 行政手続きのカタログを名乗るなら最低限。名前・根拠法・
    確度・形式審査項目・期限が縛る相手。
  - **`full`** — さらに種類・徒過効果・単位・出典 URL・確認日。

  分野カタログは `core` から入り、`full` へ上げていける。**`core` にすら
  達しないものを『カタログ』と呼ばない。**

  `conform` は**違反を全部返す**（最初の 1 件で止めない）。1 件ずつ直させると
  直す側が全体像を持てない。"
  (:require [kotoba.lang.text :as str]
            [tetsuzuki.deadline :as deadline]
            [tetsuzuki.vocabulary :as v]))

(def core-keys
  "core 適合に必須のキー。"
  #{:proc/name :proc/legal-basis :proc/confidence :proc/formal-review})

(def full-keys
  "full 適合に追加で必須のキー。"
  #{:proc/kind :proc/lapse-effect :proc/source-urls :proc/verified})

(defn- v-core [pid p anchor-set]
  (cond-> []
    (not (string? (:proc/name p)))
    (conj {:proc-id pid :rule :missing-name :detail ":proc/name が文字列でない"})

    (not (string? (:proc/legal-basis p)))
    (conj {:proc-id pid :rule :missing-legal-basis
           :detail ":proc/legal-basis が無い —— 根拠法の無い手続きは創作である"})

    (not (contains? v/confidences (:proc/confidence p)))
    (conj {:proc-id pid :rule :bad-confidence
           :detail (str ":proc/confidence が " (pr-str v/confidences) " に無い")})

    (not (sequential? (:proc/formal-review p)))
    (conj {:proc-id pid :rule :missing-formal-review
           :detail ":proc/formal-review が列でない（空列は可、nil は不可 —— 「審査項目が無い」と「知らない」を分ける）"})

    (not (deadline/valid-deadline? (:proc/deadline p) anchor-set))
    (conj {:proc-id pid :rule :bad-deadline
           :detail ":proc/deadline が閉じた語彙に収まっていない（:binds と :source は必須）"})))

(defn- v-full [pid p]
  (cond-> []
    (not (contains? v/procedure-kinds (:proc/kind p)))
    (conj {:proc-id pid :rule :bad-kind
           :detail (str ":proc/kind が " (pr-str v/procedure-kinds) " に無い")})

    (not (contains? v/lapse-effects (:proc/lapse-effect p)))
    (conj {:proc-id pid :rule :bad-lapse-effect
           :detail ":proc/lapse-effect が閉じた語彙に無い（:unknown も明示的な値である）"})

    (not (seq (:proc/source-urls p)))
    (conj {:proc-id pid :rule :missing-source-urls
           :detail ":proc/source-urls が無い —— 出典の無い記述は検証できない"})

    (not (string? (:proc/verified p)))
    (conj {:proc-id pid :rule :missing-verified
           :detail ":proc/verified（最終確認日）が無い —— 法令は改正される"})))

(defn conform
  "カタログ（`{iso3 {proc-id procedure}}`）が形に適合しているかを検査する。
  `level` は `:core`（既定）か `:full`。**違反を全部返す。**

  戻り値: `{:level .. :procedures n :violations [..] :ok? bool}`"
  ([catalog] (conform catalog :core {}))
  ([catalog level] (conform catalog level {}))
  ([catalog level {:keys [anchors] :or {anchors v/anchors}}]
   (let [vs (vec (for [[iso3 ps] catalog
                       [pid p] ps
                       violation (concat (v-core (str iso3 "/" (name pid)) p anchors)
                                         (when (= :full level)
                                           (v-full (str iso3 "/" (name pid)) p)))]
                   violation))]
     {:level level
      :procedures (reduce + (map count (vals catalog)))
      :violations vs
      :ok? (empty? vs)})))

(defn unique-ids?
  "procedure-id が法域を跨いで一意か。重複は層の切り方の誤り
  （同じ id が 2 法域にあると、どちらの法の話か分からなくなる）。"
  [catalog]
  (let [ids (mapcat (comp keys val) catalog)]
    (= (count ids) (count (distinct ids)))))

(defn duplicate-ids [catalog]
  (let [ids (mapcat (comp keys val) catalog)]
    (vec (sort (map first (filter (fn [[_ n]] (> n 1)) (frequencies ids)))))))

;; ── アクセサ ────────────────────────────────────────────────────────

(defn reviewable?
  "形式審査の対象か。届出（`:notification`）は対象外 ——
  日本の行政手続法 §37 は到達で義務が履行されたものとし、行政庁に諾否の
  余地を残していない。"
  [p]
  (and (not= :not-reviewable (:proc/review-outcome p))
       (not= :notification (:proc/kind p))))

(defn describe [iso3 proc-id p]
  (str iso3 "/" (name proc-id) " — " (:proc/name p)
       " [" (name (or (:proc/kind p) :unknown)) "] "
       (:proc/legal-basis p)
       " / 期限: " (deadline/describe p)
       " / 徒過: " (name (or (:proc/lapse-effect p) :unknown))
       (when (not= :high (:proc/confidence p)) " (confidence: medium — 原文確認要)")))

(defn needs-source-check
  "`:proc/confidence` が `:high` でない手続きを名指しで返す。"
  [catalog]
  (vec (sort (for [[iso3 ps] catalog [pid p] ps
                   :when (not= :high (:proc/confidence p))]
               (str iso3 "/" (name pid))))))

(defn summary-line [catalog]
  (str (count catalog) " 法域 / "
       (reduce + (map count (vals catalog))) " 手続き"
       (let [n (count (needs-source-check catalog))]
         (when (pos? n) (str "、うち " n " 件は confidence が :high でない")))))

(defn ids [catalog]
  (vec (sort (map str (mapcat (comp keys val) catalog)))))

(defn explain-violations
  "`conform` の結果を人間向けの行に落とす。"
  [{:keys [violations]}]
  (mapv (fn [{:keys [proc-id rule detail]}]
          (str proc-id "  " (name rule) ": " detail))
        violations))

(defn conform-report
  "適合検査の 1 行サマリ。CI が読む用。"
  ([catalog level] (conform-report catalog level {}))
  ([catalog level opts]
  (let [r (conform catalog level opts)]
    (str (if (:ok? r) "OK  " "FAIL ")
         (name level) " 適合 — " (:procedures r) " 手続き / 違反 "
         (count (:violations r)) " 件"
         (when-not (:ok? r)
           (str "\n" (str/join "\n" (explain-violations r))))))))
