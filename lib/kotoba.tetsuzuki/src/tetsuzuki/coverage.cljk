(ns tetsuzuki.coverage
  "正直なカバレッジ報告。**収録数だけを見せない。**"
  (:require [kotoba.lang.text :as str]
            [tetsuzuki.catalog :as catalog]
            [tetsuzuki.procedure :as procedure]))

(defn report
  ([] (report catalog/procedures))
  ([cat]
   (let [js (vec (sort (keys cat)))
         n (reduce + (map count (vals cat)))
         low (procedure/needs-source-check cat)]
     {:jurisdictions js
      :count (count js)
      :procedures n
      :needs-source-check low
      :uncovered-large (mapv (fn [e] (str (:iso3 e) " (" (:name e) ", "
                                          (quot (:population e) 1000000) "M)"))
                             catalog/uncovered-large-jurisdictions)
      :lapse-effects (catalog/lapse-effect-index)
      :note (str "収録 " (count js) " 法域 / " n " 手続き。うち "
                 (count low) " 件は :proc/confidence が :high でない。"
                 "人口 1 億超で未収録の法域が "
                 (count catalog/uncovered-large-jurisdictions) " ある。"
                 "**未収録は「手続きが無い」ではなく spec-basis 無しである** —— "
                 "要件を創作してはならない。"
                 "この表が持つのは行政手続法制の一般層だけで、"
                 "分野固有の手続き（選挙は kotoba-lang/senkyo）は別カタログにある。")})))

(defn contrast
  "同じ『行政庁が期限内に応答しなかった』が法域ごとにどう分かれるかを
  1 目で見るための表。**この対比がこの repo の主張そのもの。**"
  []
  (let [idx (catalog/lapse-effect-index)]
    {:index idx
     :lines (mapv (fn [[effect hits]]
                    (str (name effect) ": " (str/join ", " hits)))
                  (sort-by (comp str key) idx))
     :note (str "同じ「応答しなかった」に、ドイツは許可、カナダは拒否、"
                "米英は出訴適格、日本は何も与えない。"
                "期限に効果を持たせない設計では、この 4 つが同じ "
                "「期限を過ぎた」に潰れる。")}))

(defn units-in-use
  "使われている日の単位。暦日以外が実在することの確認。"
  []
  (frequencies (keep (comp :unit :proc/deadline)
                     (mapcat vals (vals catalog/procedures)))))

(defn who-is-bound
  "期限が縛る相手の内訳。**一般行政では行政庁側が主役**であることの確認
  （選挙の手続きは全部 filer 側だった）。"
  []
  (frequencies (keep (comp :binds :proc/deadline)
                     (mapcat vals (vals catalog/procedures)))))
