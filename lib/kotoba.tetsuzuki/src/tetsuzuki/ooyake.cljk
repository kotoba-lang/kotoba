(ns tetsuzuki.ooyake
  "`kotoba-lang/ooyake` の `:gov.procedure/*` seed を、この repo の形へ写す
  アダプタ。

  ## なぜ「取り込む」ではなく「写す」なのか

  ooyake の手続き seed は **157 件すべてが `:unverified-seed`** である
  （実測 2026-09-03。`grep -c ':gov.procedure/id'` は 158 を返すが、
  `gov-units.seed.edn` はその属性を `:schema-tx` でも 1 度宣言しているので、
  数えるなら EDN を読んで `:procedures` を数えること）。これを
  `tetsuzuki.catalog` に混ぜると、条文まで確認した entry と未検証の seed が
  同じ表に並び、**どちらを根拠に期限を計算したのか読めなくなる**。

  そこでこの ns は:

  1. ooyake の形を読める形に**写す**（正本は ooyake に置いたまま）
  2. 検証状態を**落とさずに運ぶ**（`:proc/verification-status`）
  3. 未検証 seed は `:proc/confidence` を持たせず、`core` 適合検査に
     **通らないまま**にする

  3 番目が肝で、「取り込んだら適合した」という嘘をつかない。適合させたい
  なら条文を確認して `tetsuzuki.catalog` へ昇格させる —— それが唯一の経路
  である。

  ## ooyake 側の形（実測）

  `:gov.procedure/{id,jurisdiction,title-en,title-local,owner-unit,
  owner-authority,required-docs,provenance,sourcing,verification-status,
  last-verified,toritsugi-ref}` の 12 属性。**期限も、徒過効果も、形式審査
  項目も持っていない** —— だから ooyake の seed だけでは期限管理ができない。
  これがこの repo が必要な理由の実測的な裏付けである。"
  (:require [kotoba.lang.text :as str]
            [tetsuzuki.procedure :as procedure]))

(def ooyake-attrs
  "ooyake の `:gov.procedure/*` が実際に持つ属性（2026-08-07 実測）。
  **期限・徒過効果・形式審査項目は無い。**"
  #{:gov.procedure/id :gov.procedure/jurisdiction :gov.procedure/title-en
    :gov.procedure/title-local :gov.procedure/owner-unit
    :gov.procedure/owner-authority :gov.procedure/required-docs
    :gov.procedure/provenance :gov.procedure/sourcing
    :gov.procedure/verification-status :gov.procedure/last-verified
    :gov.procedure/toritsugi-ref})

(def missing-in-ooyake
  "ooyake の seed に**無い**もの。この repo が足す部分。"
  #{:proc/deadline :proc/lapse-effect :proc/formal-review :proc/kind
    :proc/confidence})

(defn- iso3->upper [s] (when s (str/upper (str s))))

(defn seed->procedure
  "1 件の ooyake seed を写す。**期限も徒過効果も足さない**（無いものを
  作らない）。`:proc/confidence` は付けないので、この entry は `core`
  適合検査に通らない —— それが正しい状態である。"
  [m]
  {:proc/name (or (:gov.procedure/title-en m) (:gov.procedure/title-local m))
   :proc/name-local (:gov.procedure/title-local m)
   :proc/authority (:gov.procedure/owner-authority m)
   :proc/authority-unit (:gov.procedure/owner-unit m)
   :proc/legal-basis nil
   :proc/required-documents (vec (:gov.procedure/required-docs m))
   :proc/deadline nil
   :proc/formal-review nil
   :proc/verification-status (:gov.procedure/verification-status m)
   :proc/verified (:gov.procedure/last-verified m)
   :proc/source-urls (when-let [p (:gov.procedure/provenance m)] [p])
   :proc/origin :ooyake-seed
   :proc/toritsugi-ref (:gov.procedure/toritsugi-ref m)})

(defn seeds->catalog
  "ooyake の seed 列を `{iso3 {proc-id procedure}}` へ写す。"
  [seeds]
  (reduce (fn [acc m]
            (let [iso3 (iso3->upper (:gov.procedure/jurisdiction m))
                  pid (keyword (str (:gov.procedure/id m)))]
              (assoc-in acc [iso3 pid] (seed->procedure m))))
          {} seeds))

(defn promotion-report
  "写した seed が、この repo の形にどれだけ届いていないかを正直に返す。
  **『取り込んだから使える』と読ませないための報告。**"
  [seeds]
  (let [cat (seeds->catalog seeds)
        n (reduce + (map count (vals cat)))
        conformance (procedure/conform cat :core)
        by-status (frequencies (map :gov.procedure/verification-status seeds))]
    {:jurisdictions (vec (sort (keys cat)))
     :procedures n
     :verification-status by-status
     :core-violations (count (:violations conformance))
     :missing-fields (vec (sort missing-in-ooyake))
     :note (str "ooyake から写した " n " 手続きは core 適合検査に "
                (count (:violations conformance))
                " 件の違反を出す。これは不具合ではなく現在地である —— "
                "ooyake の seed は期限も徒過効果も形式審査項目も持たず、"
                "検証状態も " (pr-str by-status) " である。"
                "**昇格の唯一の経路は条文を確認して tetsuzuki.catalog へ書くこと**で、"
                "写しただけで適合させてはならない。")}))

(defn promotable?
  "その seed を `tetsuzuki.catalog` へ昇格させてよいか。
  検証済みであり、かつ根拠法が判明していることが前提。"
  [m {:keys [legal-basis]}]
  (boolean (and (contains? #{:maintainer-verified :council-verified}
                           (:gov.procedure/verification-status m))
                (string? legal-basis)
                (seq legal-basis))))
