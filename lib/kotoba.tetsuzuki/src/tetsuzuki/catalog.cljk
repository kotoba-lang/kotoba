     :proc/deadline {:binds :filer :source :statute
                     :anchor :disposition-known :offset 30
                     :unit :calendar-days :direction :after}
     :proc/lapse-effect :forfeits-right
     :proc/formal-review ["notice of application" "grounds" "affidavit evidence"]
     :proc/confidence :medium
     :proc/note "決定が通知されてから 30 日。裁判所が期間の延長を認めうる（同項但書）ので、徒過が直ちに絶対的な失権になるとは限らない。"
     :proc/verified "2026-08-07"
     :proc/source-urls ["https://laws-lois.justice.gc.ca/eng/acts/F-7/"]}}})

(def uncovered-large-jurisdictions
  "人口 1 億超で**未収録**の法域。収録数だけを見せて世界を覆っているように
  読ませないために名指しで持つ。"
  [{:iso3 "IND" :name "India" :population 1428000000}
   {:iso3 "CHN" :name "China" :population 1425000000}
   {:iso3 "IDN" :name "Indonesia" :population 277000000}
   {:iso3 "PAK" :name "Pakistan" :population 240000000}
   {:iso3 "NGA" :name "Nigeria" :population 223000000}
   {:iso3 "BRA" :name "Brazil" :population 216000000}
   {:iso3 "BGD" :name "Bangladesh" :population 173000000}
   {:iso3 "RUS" :name "Russia" :population 144000000}
   {:iso3 "MEX" :name "Mexico" :population 128000000}
   {:iso3 "ETH" :name "Ethiopia" :population 127000000}
   {:iso3 "PHL" :name "Philippines" :population 117000000}
   {:iso3 "EGY" :name "Egypt" :population 113000000}])

;; ── 参照 ────────────────────────────────────────────────────────────

(defn jurisdiction-covered? [iso3] (contains? procedures iso3))

(defn for-jurisdiction
  "`iso3` の手続き全部。未収録法域は `nil`（空 map ではない —— 「手続きが
  無い」と「知らない」を同じ値にしない）。"
  [iso3]
  (get procedures iso3))

(defn procedure [iso3 proc-id] (get-in procedures [iso3 proc-id]))

(defn by-kind
  "`iso3` の、種類が `kind` の手続き。"
  [iso3 kind]
  (when-let [ps (for-jurisdiction iso3)]
    (into {} (filter (fn [[_ p]] (= kind (:proc/kind p))) ps))))

(defn authority-bound
  "**行政庁を縛る**期限を持つ手続き。一般行政ではこちらが主役。"
  [iso3]
  (when-let [ps (for-jurisdiction iso3)]
    (into {} (filter (fn [[_ p]] (= :authority (:binds (:proc/deadline p)))) ps))))

(defn with-lapse-effect
  "徒過効果が `effect` の手続きを全法域から集める（法域跨ぎの比較用）。"
  [effect]
  (vec (sort (for [[iso3 ps] procedures [pid p] ps
                   :when (= effect (:proc/lapse-effect p))]
               (str iso3 "/" (name pid))))))

(defn lapse-effect-index
  "徒過効果 -> それを持つ手続き。**同じ『応答しなかった』が法域ごとに
  反対の効果を持つ**ことを 1 目で見るための逆引き。"
  []
  (into {} (for [e v/lapse-effects
                 :let [hits (with-lapse-effect e)]
                 :when (seq hits)]
             [e hits])))
