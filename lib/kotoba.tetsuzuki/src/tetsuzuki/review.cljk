(ns tetsuzuki.review
  "形式審査（formal review）—— 書類が揃っているかの判定。

  **形式審査と実質判断を語彙で分ける。** 形式審査は「申請書の記載事項が
  埋まっているか」「必要書類が添付されているか」であって、「この人に許可を
  与えてよいか」ではない。後者はこの層が扱わない。

  届出（`:notification`）は**そもそも審査の対象ではない** ——
  日本の行政手続法 §37 は届出が到達したときに義務が履行されたものとする。
  申請と同じ完了判定を当てると、行政庁が諾否を決められるかのように
  書けてしまうので、`:not-reviewable` を別の結果として持つ。"
  (:require [tetsuzuki.procedure :as procedure]
            [tetsuzuki.vocabulary :as v]))

(defn outcome
  "形式審査の結果を 4 値で返す。

  - `:not-reviewable` 届出など、審査の対象でない
  - `:unknown`        手続きが表に無く判定できない
  - `:complete`       全項目充足
  - `:deficient`      未充足項目がある"
  [p satisfied]
  (cond
    (nil? p) :unknown
    (not (procedure/reviewable? p)) :not-reviewable
    (nil? (:proc/formal-review p)) :unknown
    :else
    (let [sat (set satisfied)]
      (if (every? sat (:proc/formal-review p)) :complete :deficient))))

(defn outstanding
  "未充足の形式審査項目。審査対象でなければ `[]`、手続き不明なら `nil`。"
  [p satisfied]
  (cond
    (nil? p) nil
    (not (procedure/reviewable? p)) []
    (nil? (:proc/formal-review p)) nil
    :else (let [sat (set satisfied)]
            (vec (remove sat (:proc/formal-review p))))))

(defn complete?
  "全項目充足か。**`:unknown` を false でなく nil で返す** —— 「未充足」と
  「判定できない」を同じ偽値にすると、知らないことが不備として通知される。"
  [p satisfied]
  (case (outcome p satisfied)
    :complete true
    :deficient false
    :not-reviewable true
    nil))

(defn blocking?
  "その結果が次の行政行為（許可・受理・登載）を止めるべきか。
  `:unknown` は止める —— 知らないまま進めない。"
  [o]
  (contains? #{:deficient :unknown} o))

(defn valid-outcome? [o] (contains? v/review-outcomes o))

(defn deficiency-notice
  "不備通知の**素材**を作る。通知そのものは行政庁の行為であって、この層は
  文面の材料しか持たない（誰に何をいつまでに補正させるかは処分性を帯びる）。"
  [iso3 proc-id p satisfied]
  (let [o (outcome p satisfied)]
    {:jurisdiction iso3
     :procedure-id proc-id
     :outcome o
     :outstanding (outstanding p satisfied)
     :legal-basis (:proc/legal-basis p)
     :note (case o
             :not-reviewable "この手続きは届出であり、形式審査の対象ではない（到達で義務は履行されている）。"
             :unknown "手続きが表に無いため未充足項目を列挙できない。要件を推測で作らないこと。"
             :complete "全項目充足。"
             :deficient "未充足項目がある。補正を求めうるが、求めるかどうかは行政庁の判断である。")}))
