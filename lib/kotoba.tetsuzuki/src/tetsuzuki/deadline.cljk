(ns tetsuzuki.deadline
  "期限の算法。**暦日ライブラリに依存しない**（epoch-day の整数で受け渡す）。

  ## 解けないことを解けたことにしない

  `resolve` の戻り値は 6 種類あり、それぞれ**別の理由で**解けていない:

  | 戻り値 | 意味 | 打つ手 |
  |---|---|---|
  | 整数 | 解けた | — |
  | `:no-deadline` | 期限の定めが無い（調べた結果） | 無し |
  | `:authority-published` | 数値は各行政庁が定めて公表する | 当該庁の公表を見る |
  | `:unknown-anchor` | 基準日が与えられていない | 基準日を渡す |
  | `:needs-business-calendar` | 営業日単位だが休日カレンダーが無い | カレンダーを渡す |
  | `:no-basis` | 手続きが表に無い | 表に足す（創作しない） |

  **これらを 1 つに畳まない。** `senkyo` は 3 種類（整数 / `:no-deadline` /
  `:unknown-anchor`）で足りたが、一般行政では『各庁が公表する数値』と
  『営業日カレンダーが要る』が加わる。畳むと「確認しなかった」が
  「確認すべきものが無かった」に化ける。

  ## 営業日を暦日で近似しない

  米国 FOIA は 20 **business days**、英国 FOIA は 20 **working days**。
  暦日 20 日として計算すると実際の期限より 8 日ほど早い日を返し、
  **行政庁が遅れていないのに遅れていると判定する**。休日カレンダーが
  無いなら `:needs-business-calendar` を返して止まる。

  カレンダーは `{:weekend #{5 6} :holidays #{epoch-day ...}}` の形で渡す
  （`:weekend` は epoch-day mod 7 の値の集合。1970-01-01 は木曜なので
  土曜=2、日曜=3。既定は `default-calendar` を参照）。"
  (:require [tetsuzuki.vocabulary :as v]))

;; ── 曜日 ────────────────────────────────────────────────────────────
;;
;; 1970-01-01 (epoch-day 0) は木曜。したがって
;;   epoch-day mod 7 = 0 -> 木, 1 -> 金, 2 -> 土, 3 -> 日, 4 -> 月, 5 -> 火, 6 -> 水

(def ^:const thursday-epoch-offset
  "epoch-day 0 が木曜であることの記録。曜日計算を読む人が毎回数え直さない
  ために定数にしてある。"
  0)

(def default-calendar
  "土日を休みとする既定カレンダー。**祝日は空** —— 祝日は法域ごとに違い、
  この repo は祝日データを持たない。祝日を含む正確な計算が要るなら
  `:holidays` を渡すこと。空の `:holidays` で計算した結果は**祝日ぶん
  早い日**になりうる。"
  {:weekend #{2 3} :holidays #{}})

(defn weekend?
  [{:keys [weekend] :or {weekend #{2 3}}} epoch-day]
  (contains? weekend (mod epoch-day 7)))

(defn business-day?
  [{:keys [holidays] :as cal} epoch-day]
  (and (not (weekend? cal epoch-day))
       (not (contains? (or holidays #{}) epoch-day))))

(defn add-business-days
  "`from` の**翌**営業日から数えて `n` 営業日後の epoch-day。
  n が 0 なら `from` をそのまま返す。"
  [cal from n]
  (loop [d from left n]
    (if (<= left 0)
      d
      (let [nxt (inc d)]
        (recur nxt (if (business-day? cal nxt) (dec left) left))))))

(defn add-months
  "暦月の加算。**暦月の長さを知らないので 30 日で近似せず**、
  1 か月 = 平均 30.436875 日ではなく、**日付演算が要ることを明示して
  `:needs-calendar-date` を返す**……のではなく、この repo は epoch-day
  しか持たないので `:months` は 1 か月 = 30 日として扱わない。

  代わりに `:months` の期限は `:needs-calendar-date` を返し、呼び出し側に
  実日付での計算を委ねる。**近似して静かに間違えるより、解けないと言う。**"
  [_from _n]
  :needs-calendar-date)

;; ── 解決 ────────────────────────────────────────────────────────────

(defn resolve-deadline
  "手続きの `:proc/deadline` を epoch-day へ解く。

  `deadline` は
  `{:anchor kw :offset n :unit kw :direction kw :source kw}`。
  `ctx` は `{:anchors {kw epoch-day} :calendar {...}}`。

  `:proc/deadline` が nil のときは `:no-deadline`。"
  [deadline {:keys [anchors calendar] :or {calendar default-calendar}}]
  (if (nil? deadline)
    :no-deadline
    (let [{:keys [anchor offset unit direction source]} deadline]
      (cond
        (= :authority-published source) :authority-published
        (= :none source) :no-deadline
        (nil? (get anchors anchor)) :unknown-anchor
        :else
        (let [base (get anchors anchor)]
          (case unit
            :calendar-days
            (case direction
              :after (+ base offset)
              :before (- base offset)
              (:on :at-least :before-or-on) base)

            (:business-days :working-days)
            (if (nil? calendar)
              :needs-business-calendar
              (case direction
                :after (add-business-days calendar base offset)
                :before (add-business-days calendar base (- offset))
                (:on :at-least :before-or-on) base))

            :months (add-months base offset)

            :unknown-unit))))))

(defn resolvable?
  "解けた（整数になった）か。"
  [r]
  (integer? r))

(def unresolved-reasons
  "解けなかったときの戻り値の集合。**`:no-deadline` もここに入れる** ——
  『期限が無い』は解けた答えではあるが、期限管理の対象から外れる点で
  整数とは扱いが違うため、呼び出し側が明示的に分岐せざるをえないように
  する。"
  #{:no-deadline :authority-published :unknown-anchor
    :needs-business-calendar :needs-calendar-date :no-basis :unknown-unit})

(defn status
  "提出日（または現在日）と期限を突き合わせた状態。

  - `:within`   期限内
  - `:lapsed`   期限を過ぎている
  - その他      `resolve-deadline` の未解決理由をそのまま返す

  **未解決理由を `:within` に丸めない。**"
  [deadline ctx observed-epoch-day]
  (let [d (resolve-deadline deadline ctx)]
    (cond
      (not (integer? d)) d
      (nil? observed-epoch-day) :unknown-observation
      (<= observed-epoch-day d) :within
      :else :lapsed)))

(defn lapse-consequence
  "期限を徒過したときに何が起きるか。`:proc/lapse-effect` をそのまま返す
  が、**手続きが徒過していない場合は nil** —— 効果は徒過して初めて生じる。"
  [{:keys [proc/lapse-effect proc/deadline]} ctx observed-epoch-day]
  (when (= :lapsed (status deadline ctx observed-epoch-day))
    (or lapse-effect :unknown)))

(defn binds
  "その期限が縛るのは提出側か行政庁か。定めが無ければ nil。"
  [{:keys [proc/deadline]}]
  (:binds deadline))

(defn authority-side?
  "行政庁を縛る期限か。**一般行政ではこちらが主役**（標準処理期間・
  FOIA・みなし許可）で、選挙の手続きには 1 つも無かった。"
  [procedure]
  (= :authority (binds procedure)))

(defn describe
  "人間向けの一行説明。"
  [{:keys [proc/deadline]}]
  (if (nil? deadline)
    "期限の定めなし"
    (let [{:keys [anchor offset unit direction source binds]} deadline]
      (str (name (or binds :filer)) " を縛る / "
           (case source
             :authority-published "数値は各行政庁が定めて公表（この表は持たない）"
             :none "定めなし"
             (str offset " " (name unit) " " (name direction)
                  " " (name anchor)))))))

(defn valid-deadline?
  "閉じた語彙に収まっているか。nil（期限なし）も valid。

  `anchor-set` は分野の基準点集合（既定は一般行政の `v/anchors`）。
  分野カタログは自分の集合を渡す —— `:poll-day` は一般行政に無い。"
  ([deadline] (valid-deadline? deadline v/anchors))
  ([deadline anchor-set]
  (or (nil? deadline)
      (let [{:keys [anchor unit direction source binds offset]} deadline]
        (and (contains? v/deadline-sources source)
             (contains? v/deadline-binds binds)
             (if (= :authority-published source)
               true
               (and (contains? anchor-set anchor)
                    (contains? v/day-units unit)
                    (contains? v/directions direction)
                    (integer? offset))))))))
