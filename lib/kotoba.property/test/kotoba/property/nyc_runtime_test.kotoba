(ns kotoba.property.nyc-runtime-test
  (:require [kotoba.property.nyc-runtime :as n])
  (:export [main]))

;; Returns the number of failed cases (0 = pass).
(defn main [] :i64
  (let [r (n/normalize-record "2026-01-01" true "1000220020.0" true "ELECT")
        none (n/normalize-record "2026-01-01" false "" true "ELECT")]
    (+ (if (option-match [:option [:record :kotoba.property.nyc-runtime/Claim [[:id :string] [:parcel :string] [:holder :string] [:holder-id :string] [:holder-kind :keyword] [:source :string] [:observed-at :string] [:licence :string] [:disclosure :keyword]]]] r false item true) 0 1)
       (+ (if (option-match [:option [:record :kotoba.property.nyc-runtime/Claim [[:id :string] [:parcel :string] [:holder :string] [:holder-id :string] [:holder-kind :keyword] [:source :string] [:observed-at :string] [:licence :string] [:disclosure :keyword]]]] none false item true) 1 0)
          (+ (if (= (option-match [:option [:record :kotoba.property.nyc-runtime/Claim [[:id :string] [:parcel :string] [:holder :string] [:holder-id :string] [:holder-kind :keyword] [:source :string] [:observed-at :string] [:licence :string] [:disclosure :keyword]]]] r "" item
                      (record-get [:record :kotoba.property.nyc-runtime/Claim [[:id :string] [:parcel :string] [:holder :string] [:holder-id :string] [:holder-kind :keyword] [:source :string] [:observed-at :string] [:licence :string] [:disclosure :keyword]]] item :id))
                    "nyc-owned-properties:1000220020.0:ELECT") 0 1)
             (if (= (option-match [:option [:record :kotoba.property.nyc-runtime/Claim [[:id :string] [:parcel :string] [:holder :string] [:holder-id :string] [:holder-kind :keyword] [:source :string] [:observed-at :string] [:licence :string] [:disclosure :keyword]]]] r "" item
                      (record-get [:record :kotoba.property.nyc-runtime/Claim [[:id :string] [:parcel :string] [:holder :string] [:holder-id :string] [:holder-kind :keyword] [:source :string] [:observed-at :string] [:licence :string] [:disclosure :keyword]]] item :holder))
                    "City of New York / ELECT") 0 1))))))
