(ns kotoba.property.gleif-projection-test (:export [main]) (:require [kotoba.property.gleif-projection :as p]))

(defn- crit [leis :document juris :document status :document] :document
  (document-map :leis leis :jurisdictions juris :status status))
(defn- rec [lei :document juris :document status :document] :document
  (document-map :company/lei lei :company/jurisdiction juris :company/lei-registration-status status))

(defn- s [d :document k :keyword] :string
  (option-or (document-string-value (option-or (document-get d k) (document-null))) "<none>"))
(defn- i [d :document k :keyword] :i64
  (option-or (document-i64-value (option-or (document-get d k) (document-null))) -1))
(defn- b [d :document k :keyword] :bool
  (option-or (document-bool-value (option-or (document-get d k) (document-null))) false))

(defn main [] :i64
  (let [corpus (document-map :corpus/source (document-string "gleif") :corpus/record-count (document-i64 1000))
        full (crit (document-vector (document-string "L1") (document-string "L2"))
                   (document-vector (document-string "US"))
                   (document-string "ISSUED"))
        pm (p/projection-manifest corpus full 42)
        pm0 (p/projection-manifest corpus (document-map) 0)
        r1 (rec (document-string "L1") (document-string "US-DE") (document-string "ISSUED"))
        blank (crit (document-null) (document-null) (document-string ""))
        only-leis-l9 (crit (document-vector (document-string "L9")) (document-null) (document-null))
        juris-u (crit (document-null) (document-vector (document-string "U")) (document-null))
        juris-de (crit (document-null) (document-vector (document-string "US-DE")) (document-null))
        status-lapsed (crit (document-null) (document-null) (document-string "LAPSED"))
        r-usa (rec (document-string "L1") (document-string "USA") (document-string "ISSUED"))
        r-nolei (rec (document-null) (document-string "US-DE") (document-string "ISSUED"))]
    (+ (if (b pm :corpus/manifest) 0 1)
       (if (b pm :corpus/projection) 0 1)
       (if (= (i pm :corpus/record-count) 42) 0 1)
       (if (string=? (s pm :corpus/source) "gleif") 0 1)
       (if (= (i pm :projection/lei-count) 2) 0 1)
       (if (string=? (s pm :projection/status) "ISSUED") 0 1)
       (if (document-contains pm :projection/jurisdictions) 0 1)
       (if (document-contains pm0 :projection/lei-count) 1 0)
       (if (document-contains pm0 :projection/status) 1 0)
       (if (= (i pm0 :corpus/record-count) 0) 0 1)
       (if (p/record-matches? full r1) 0 1)
       (if (p/record-matches? only-leis-l9 r1) 1 0)
       (if (p/record-matches? juris-u r1) 1 0)
       (if (p/record-matches? juris-de r1) 0 1)
       (if (p/record-matches? status-lapsed r1) 1 0)
       (if (p/record-matches? blank r1) 0 1)
       (if (p/record-matches? (document-map) r1) 0 1)
       (if (p/record-matches? juris-de r-usa) 1 0)
       (if (p/record-matches? full r-nolei) 1 0)
       (if (p/record-matches? (crit (document-null) (document-vector (document-string "US")) (document-null)) r-usa) 1 0))))
