(ns kotoba.hmlr-test
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.io :as kio]
            [kotoba.property.hmlr :as hmlr]))

(deftest normalize-corporate-hmlr-row
  (is (= {:ownership/id "hmlr-uk-corporate-property:AB123:00000006"
          :ownership/parcel "GB-HMLR:AB123"
          :ownership/holder "Example Holdings Ltd"
          :ownership/holder-id "00000006"
          :ownership/holder-kind :company
          :ownership/source "hmlr-uk-corporate-property"
          :ownership/observed-at "2026-07-10"
          :ownership/licence "HMLR dataset-specific licence"
          :ownership/disclosure :public}
         (hmlr/normalize-row
          "hmlr-uk-corporate-property" "2026-07-10"
          {"Title Number" "AB123"
           "Company Registration No. (Proprietor)" "00000006"
           "Proprietor Name (Company)" "Example Holdings Ltd"}))))

(deftest import-csv-parses-rfc-4180-quoting
  ;; csv.core (kotoba-lang/org-ietf-csv) replaced clojure.data.csv here: a
  ;; quoted field keeps its comma and its doubled quote, CRLF line ends leave
  ;; no trailing \r, and a final newline adds no empty record.
  (let [path (str "hmlr-import-test-" (rand-int 1000000000) ".csv")
        text (str "Title Number,Company Registration No. (Proprietor),Proprietor Name (Company)\r\n"
                  "AB123,00000006,\"Example, \"\"Quoted\"\" Holdings Ltd\"\r\n"
                  "CD456,00000007,Plain Ltd\r\n")]
    (spit path text)
    (try
      (let [state (hmlr/import-csv! {:ownership-records {} :source-state {}}
                                    "hmlr-uk-corporate-property" "2026-07-10" path)]
        (is (= 2 (get-in state [:source-state "hmlr-uk-corporate-property" :record-count])))
        (is (= "Example, \"Quoted\" Holdings Ltd"
               (get-in state [:ownership-records "hmlr-uk-corporate-property:AB123:00000006" :ownership/holder])))
        (is (= "Plain Ltd"
               (get-in state [:ownership-records "hmlr-uk-corporate-property:CD456:00000007" :ownership/holder]))))
      (finally (kio/delete-file path true)))))
