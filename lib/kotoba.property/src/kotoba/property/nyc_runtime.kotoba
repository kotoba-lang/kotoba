(ns kotoba.property.nyc-runtime
  (:export [source-id endpoint normalize-record]))

;; Kotoba port of lib/kotoba.property/src/kotoba/property/nyc_runtime.cljk.
;; Named divergences:
;;   * the API row is not a map: bbl and agency come as (has-flag, string)
;;     pairs, so the `(and bbl agency)` guard is exact even for "".
;;   * the claim map is the record Claim; normalize-record returns an option.
;;   * the id keys on the agency as well as the parcel (see the original note).
;;   * source-id and endpoint are zero-arg fns, not defs (a def cannot be
;;     exported, E2005).

(defn source-id [] :string "nyc-owned-properties")
(defn endpoint [] :string "https://data.cityofnewyork.us/resource/ynxg-k94i.json")

(defrecord Claim [id :string parcel :string holder :string holder-id :string
                  holder-kind :keyword source :string observed-at :string
                  licence :string disclosure :keyword])

(defn- cat2 [a :string b :string] :string
  (string-concat a b))

(defn- cat3 [a :string b :string c :string] :string
  (string-concat (string-concat a b) c))

(defn normalize-record [observed-at :string has-bbl :bool bbl :string has-agency :bool agency :string]
  [:option [:record :kotoba.property.nyc-runtime/Claim [[:id :string] [:parcel :string] [:holder :string] [:holder-id :string] [:holder-kind :keyword] [:source :string] [:observed-at :string] [:licence :string] [:disclosure :keyword]]]]
  (if (and has-bbl has-agency)
    (option-some-of [:option [:record :kotoba.property.nyc-runtime/Claim [[:id :string] [:parcel :string] [:holder :string] [:holder-id :string] [:holder-kind :keyword] [:source :string] [:observed-at :string] [:licence :string] [:disclosure :keyword]]]]
      (->Claim (cat3 (cat2 (source-id) ":") bbl (cat2 ":" agency))
               (cat2 "US-NY-NYC:BBL:" bbl)
               (cat2 "City of New York / " agency)
               (cat2 "US-NY-NYC:agency:" agency)
               :public-body
               (source-id)
               observed-at
               "NYC Open Data Terms of Use"
               :public))
    (option-none-of [:option [:record :kotoba.property.nyc-runtime/Claim [[:id :string] [:parcel :string] [:holder :string] [:holder-id :string] [:holder-kind :keyword] [:source :string] [:observed-at :string] [:licence :string] [:disclosure :keyword]]]])))
