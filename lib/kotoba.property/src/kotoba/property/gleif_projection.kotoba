;; Port of kotoba.property.gleif-projection (gleif_projection.cljk), Kotoba-native.
;;
;; The corpus manifest, the selection criteria and the records are :document
;; maps. :leis and :jurisdictions are :document vectors of strings; an absent or
;; null criterion is no filter (the source's nil).
;;
;; Named divergences from gleif_projection.cljk:
;;   - matcher returns a closure in the source, and Kotoba has no returned
;;     closures. matcher is not ported. Its predicate body is ported as the
;;     public function record-matches? (criteria, one record -> bool).
;;   - the jurisdiction prefix test (str/starts-with? j (str c "-")) is a
;;     string-substring comparison.
;;   - a blank :status (nil or "") is no status filter, as str/blank? is in the
;;     source.
;;   - the :require of kotoba.lang.text is not used; the helpers are local.

(ns kotoba.property.gleif-projection
  (:export [projection-manifest record-matches?]))

(defn- field [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn- null-doc? [d :document] :bool
  (string=? (document-edn-print d) (document-edn-print (document-null))))

(defn- present? [d :document] :bool
  (not (null-doc? d)))

(defn- seq-count [d :document] :i64
  (if (null-doc? d) 0 (document-count d)))

(defn- item-str [v :document i :i64] :string
  (option-or (document-string-value (option-or (document-vector-at v i) (document-null))) ""))

(defn- vec-has? [v :document s :string] :bool
  (let [n (seq-count v)]
    (loop [i 0]
      (if (>= i n)
        false
        (if (string=? (item-str v i) s)
          true
          (recur (+ i 1)))))))

(defn- starts-with-dash? [j :string c :string] :bool
  (let [n (+ (string-length c) 1)]
    (if (< (string-length j) n)
      false
      (string=? (string-substring j 0 n) (string-concat c "-")))))

(defn- jur-match? [j :string juris :document] :bool
  (let [n (seq-count juris)]
    (loop [i 0]
      (if (>= i n)
        false
        (let [c (item-str juris i)]
          (if (or (string=? j c) (starts-with-dash? j c))
            true
            (recur (+ i 1))))))))

(defn record-matches? [criteria :document rec :document] :bool
  (let [leis (field criteria :leis)
        juris (field criteria :jurisdictions)
        status (field criteria :status)
        lei-doc (field rec :company/lei)
        jur-doc (field rec :company/jurisdiction)
        rec-status (field rec :company/lei-registration-status)
        status-str (option-or (document-string-value status) "")
        status-blank (or (null-doc? status) (= (string-length status-str) 0))]
    (and (or (= (seq-count leis) 0)
             (and (present? lei-doc)
                  (vec-has? leis (option-or (document-string-value lei-doc) ""))))
         (or (= (seq-count juris) 0)
             (and (present? jur-doc)
                  (jur-match? (option-or (document-string-value jur-doc) "") juris)))
         (or status-blank
             (and (present? rec-status)
                  (string=? (option-or (document-string-value rec-status) "") status-str))))))

(defn projection-manifest [corpus-manifest :document criteria :document record-count :i64] :document
  (let [leis (field criteria :leis)
        juris (field criteria :jurisdictions)
        status (field criteria :status)
        m1 (document-assoc (document-dissoc corpus-manifest :corpus/record-count)
                           :corpus/manifest (document-bool true))
        m2 (document-assoc m1 :corpus/projection (document-bool true))
        m3 (document-assoc m2 :corpus/record-count (document-i64 record-count))
        m4 (if (> (seq-count leis) 0)
             (document-assoc m3 :projection/lei-count (document-i64 (seq-count leis)))
             m3)
        m5 (if (> (seq-count juris) 0)
             (document-assoc m4 :projection/jurisdictions juris)
             m4)]
    (if (present? status)
      (document-assoc m5 :projection/status status)
      m5)))
