<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gftd.gbizinfo-refresh</string>
  <!-- This one runs on the OPERATOR's machine, not on a fleet node — the
       opposite of the 官報 cell, and for the same rule: the API token registers
       the operator's identity with 経済産業省, and nodes hold no credentials.

       It reads the token from the environment, then from the Keychain item
       `gbizinfo-api-token` (a launchd agent does not see a shell's env). With no
       token it exits 3 and says why: exiting 0 would make "not run" and "ran and
       found nothing" the same line in the log.

       Install:
         cp deploy/com.gftd.gbizinfo-refresh.plist ~/Library/LaunchAgents/
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gftd.gbizinfo-refresh.plist -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/nbb</string>
    <string>-cp</string><string>src</string>
    <string>scripts/gbizinfo_refresh.cljk</string>
    <string>--plane</string>
    <string>/Users/junkawasaki/github/com-junkawasaki/orgs/com-junkawasaki/jp-go-nta-houjin-bangou/data,/Users/junkawasaki/github/com-junkawasaki/orgs/com-junkawasaki/jp-go-npb-kanpou/data</string>
    <string>--out</string>
    <string>/Users/junkawasaki/github/com-junkawasaki/orgs/com-junkawasaki/jp-go-gbiz-info/data/gbizinfo-joined.datoms.edn</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/junkawasaki/github/com-junkawasaki/orgs/kotoba-lang/property</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <!-- Weekly, not daily: gBizINFO aggregates ministry publications that move on
       the order of weeks, and a full pass is ~63k requests (8,972 companies x 7
       aspects). The 官報 cell is the daily one because its window closes. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>/Users/junkawasaki/.gftd/gbizinfo-refresh.log</string>
  <key>StandardErrorPath</key><string>/Users/junkawasaki/.gftd/gbizinfo-refresh.log</string>
</dict>
</plist>
