;; Port of oauth.model (model.cljk), Kotoba-native.
;;
;; Plain data constructors for OAuth requests, token results, introspection,
;; provider metadata and callbacks. Each takes an opts map; absent keys are the
;; document null (the source's nil).
;; Named divergences:
;;   - (set x) for the scope-like fields: a :vector or :list becomes a set of
;;     its items; a :set is kept; any other value (including nil) becomes the
;;     empty set. The source's set of a string yields characters; not ported.
;;   - grant-types is a zero-argument function (a def cannot be exported).
;;   - sets are built by set-of (sorted canonical text); see kotoba.set.index.
(ns oauth.model
  (:export [grant-types auth-request token-request token-result introspection-result
            provider-metadata callback]))

(defn- field [m :document k :keyword] :document
  (if (= (document-kind m) :map)
    (option-value-of [:option :document] (document-get m (document-keyword k)) (document-null))
    (document-null)))

(defn- item [v :document i :i64] :document
  (option-value-of [:option :document] (document-vector-at v i) (document-null)))

(defn- coll-items [v :document] :document
  (let [t (document-edn-print v)
        n (string-length t)]
    (if (= (document-kind v) :set)
      (document-edn-read (string-concat "[" (string-concat (string-substring t 2 (- n 1)) "]")))
      (document-edn-read (string-concat "[" (string-concat (string-substring t 1 (- n 1)) "]"))))))

;; Canonical set of the items of vector xs. Map keys are kept in canonical
;; text order and deduplicated by document-assoc, so the keys read back in
;; order give the set's canonical text.
(defn- key-at [m :document i :i64] :document
  (option-value-of [:option :document]
                   (document-vector-at (option-value-of [:option :document] (document-map-entry-at m i) (document-null)) 0)
                   (document-null)))

(defn- set-of [xs :document] :document
  (let [n (document-count xs)
        m (loop [i 0 acc (document-map)]
            (if (>= i n)
              acc
              (recur (+ i 1) (document-assoc acc (option-value-of [:option :document] (document-vector-at xs i) (document-null)) (document-null)))))
        k (document-count m)]
    (document-edn-read
     (loop [i 0 acc "#{"]
       (if (>= i k)
         (string-concat acc "}")
         (let [t (document-edn-print (key-at m i))]
           (recur (+ i 1) (if (string=? acc "#{")
                            (string-concat acc t)
                            (string-concat (string-concat acc " ") t)))))))))

(defn- as-set [v :document] :document
  (let [k (document-kind v)]
    (cond (= k :vector) (set-of v)
          (= k :list) (set-of (coll-items v))
          (= k :set) v
          :else (document-set))))

(defn grant-types [] :document
  (document-edn-read "#{:authorization-code :client-credentials :device-code :refresh-token}"))

(defn auth-request [id :document opts :document] :document
  (document-map :oauth.request/id id
                :oauth.request/client-id (field opts :client-id)
                :oauth.request/redirect-uri (field opts :redirect-uri)
                :oauth.request/scope (as-set (field opts :scope))
                :oauth.request/state (field opts :state)
                :oauth.request/code-challenge (field opts :code-challenge)
                :oauth.request/created-at (field opts :created-at)))

(defn token-request [grant-type :document opts :document] :document
  (document-map :oauth.token/grant-type grant-type
                :oauth.token/code (field opts :code)
                :oauth.token/refresh-token-ref (field opts :refresh-token-ref)
                :oauth.token/client-id (field opts :client-id)
                :oauth.token/redirect-uri (field opts :redirect-uri)
                :oauth.token/code-verifier-ref (field opts :code-verifier-ref)))

(defn token-result [ok? :bool opts :document] :document
  (document-map :oauth.result/ok? (document-bool ok?)
                :oauth.result/access-token-ref (field opts :access-token-ref)
                :oauth.result/refresh-token-ref (field opts :refresh-token-ref)
                :oauth.result/scope (as-set (field opts :scope))
                :oauth.result/expires-at (field opts :expires-at)))

(defn introspection-result [active? :bool opts :document] :document
  (document-map :oauth.introspection/active? (document-bool active?)
                :oauth.introspection/token-ref (field opts :token-ref)
                :oauth.introspection/client-id (field opts :client-id)
                :oauth.introspection/subject (field opts :subject)
                :oauth.introspection/scope (as-set (field opts :scope))
                :oauth.introspection/expires-at (field opts :expires-at)
                :oauth.introspection/issued-at (field opts :issued-at)))

(defn provider-metadata [issuer :document opts :document] :document
  (document-map :oauth.provider/issuer issuer
                :oauth.provider/authorization-endpoint (field opts :authorization-endpoint)
                :oauth.provider/token-endpoint (field opts :token-endpoint)
                :oauth.provider/introspection-endpoint (field opts :introspection-endpoint)
                :oauth.provider/jwks-uri (field opts :jwks-uri)
                :oauth.provider/scopes-supported (as-set (field opts :scopes-supported))
                :oauth.provider/grant-types-supported (as-set (field opts :grant-types-supported))
                :oauth.provider/fetched-at (field opts :fetched-at)))

(defn callback [opts :document] :document
  (document-map :oauth.callback/state (field opts :state)
                :oauth.callback/code (field opts :code)
                :oauth.callback/error (field opts :error)
                :oauth.callback/received-at (field opts :received-at)))
