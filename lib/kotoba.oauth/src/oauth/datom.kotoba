(ns oauth.datom
  "Kotoba guest: product semantics of oauth.datom as plain values.
  Parity source: src/oauth/datom.cljk (unchanged original).

  The Clojure original builds a 1-element vector of a fixed-key map per call.
  Here each request/result rides as a record (the struct-with-fixed-keys
  shape), declared once in the namespace :schemas and reached by [:ref].
  :ok? is :bool and lives as a record field; the string fields live in the
  record too. This is the shape examples/todo-app.kotoba uses for its model."
  (:export [auth-request-datom token-result-datom])
  (:schemas {:oauth/auth-request
             [:record :oauth/auth-request
              [[:id :string]
               [:client-id :string]
               [:redirect-uri :string]
               [:scope :string]
               [:state :string]
               [:code-challenge :string]
               [:created-at :string]]]
             :oauth/token-result
             [:record :oauth/token-result
              [[:db-id :string]
               [:ok? :bool]
               [:access-token-ref :string]
               [:refresh-token-ref :string]
               [:scope :string]
               [:expires-at :string]]]}))

(defn auth-request-datom [req :string] :string
  (let [parsed (record-new [:ref :oauth/auth-request]
                           req req req req req req req)]
    (record-get parsed :state)))

(defn token-result-datom [ok :bool ref :string] :string
  (let [rec (record-new [:ref :oauth/token-result]
                        (string-concat "oauth:token-result:" ref)
                        ok ref ref ref ref)]
    (record-get rec :db-id)))
