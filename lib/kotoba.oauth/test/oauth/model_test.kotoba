;; Test for oauth.model. main returns the number of failed cases.
(ns oauth.model-test
  (:export [main])
  (:require [oauth.model :as o]))

(defn- chk [ok :bool] :i64
  (if ok 0 1))

(defn- s [x :string] :document
  (document-string x))

(defn- opts [] :document
  (document-map :client-id (s "cli") :redirect-uri (s "https://app.example/cb")
                :scope (document-vector (s "read") (s "write"))
                :state (s "st") :code-challenge (s "cc") :created-at (document-i64 10)))

(defn- field-of [m :document k :keyword] :document
  (option-value-of [:option :document] (document-get m (document-keyword k)) (document-null)))

(defn- grants [] :i64
  (let [g (o/grant-types)]
    (+ (chk (= (document-count g) 4))
       (+ (chk (document-set-contains? g (document-keyword :device-code)))
          (chk (not (document-set-contains? g (document-keyword :password))))))))

(defn- request [] :i64
  (let [r (o/auth-request (s "req-1") (opts))]
    (+ (chk (document-equal? (field-of r :oauth.request/id) (s "req-1")))
       (+ (chk (document-equal? (field-of r :oauth.request/scope) (document-edn-read "#{\"read\" \"write\"}")))
          (+ (chk (document-equal? (field-of r :oauth.request/client-id) (s "cli")))
             (chk (document-equal? (field-of r :oauth.request/created-at) (document-i64 10))))))))

(defn- token-and-callback [] :i64
  (let [t (o/token-result true (opts))
        c (o/callback (opts))]
    (+ (chk (document-equal? (field-of t :oauth.result/ok?) (document-bool true)))
       (+ (chk (document-equal? (field-of (o/token-result false (document-map)) :oauth.result/ok?) (document-bool false)))
          (+ (chk (document-equal? (field-of c :oauth.callback/code) (document-null)))
             (chk (document-equal? (field-of c :oauth.callback/state) (s "st"))))))))

(defn- introspect-and-provider [] :i64
  (let [i (o/introspection-result false (document-map :scope (document-edn-read "#{}")))
        p (o/provider-metadata (s "https://issuer.example") (document-map :grant-types-supported (document-vector (document-keyword :refresh-token) (document-keyword :authorization-code))))]
    (+ (chk (document-equal? (field-of i :oauth.introspection/active?) (document-bool false)))
       (+ (chk (document-equal? (field-of i :oauth.introspection/scope) (document-edn-read "#{}")))
          (chk (document-equal? (field-of p :oauth.provider/grant-types-supported)
                                (document-edn-read "#{:authorization-code :refresh-token}")))))))

(defn main [] :i64
  (+ (grants) (+ (request) (+ (token-and-callback) (introspect-and-provider)))))
