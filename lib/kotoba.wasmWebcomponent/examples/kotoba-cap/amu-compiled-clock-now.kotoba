;; Provenance for amu-compiled-clock-now.wasm.
;; Woven by kotoba-lang/amu (`compile-source` :wasm32-kotoba-v1), the same
;; bytes kototama checks in as test/kototama/fixtures/amu-compiled-clock-now.wasm
;; (kototama main 41460163). amu elaborates `(clock/now seed)` to
;; `(typed-cap-call 7 :i64 :i64 seed)`; kotoba-wasm lowers that to import
;; `kotoba:cap`/`call` (i64, i64)->i64. This is the i64 seed ABI, not the
;; variant request/result in clock-v1.edn (`:wasm-aot` stays pending).
(ns demo-amu-clock-now
  (:capabilities #{:clock/now}))

(defn main []
  (clock/now 0))
