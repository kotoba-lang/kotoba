{
  "name": "wasm-webcomponent",
  "private": true,
  "type": "module",
  "devDependencies": {
    "shadow-cljs": "^2.28.20",
    "playwright": "^1.59.0"
  },
  "scripts": {
    "compile:kami-ecs": "amu compile --target wasm32-browser kami-ecs",
    "release:kami-ecs": "amu compile --target wasm32-browser kami-ecs",
    "compile:kami-engine-host": "amu compile --target wasm32-browser kami-engine-host",
    "release:kami-engine-host": "amu compile --target wasm32-browser kami-engine-host",
    "compile:gpu-clear-host": "amu compile --target wasm32-browser gpu-clear-host",
    "release:gpu-clear-host": "amu compile --target wasm32-browser gpu-clear-host",
    "compile:solar-render-host": "amu compile --target wasm32-browser solar-render-host",
    "release:solar-render-host": "amu compile --target wasm32-browser solar-render-host",
    "compile:kotoba-cap": "amu compile --target wasm32-browser kotoba-cap",
    "release:kotoba-cap": "amu compile --target wasm32-browser kotoba-cap",
    "test": "for f in test/verify-*.mjs; do node \"$f\" || exit 1; done",
    "test:kotoba-cap": "kbb --backend sci -cp src-cljs:test test/verify_kotoba_cap.cljk",
    "test:render": "for f in test/render/verify-*.mjs; do node \"$f\" || exit 1; done",
    "test:browser": "kbb --backend sci -cp test/browser test/browser/verify_actor_host_browser.cljk",
    "test:browser-http-sab": "node test/browser/verify-http-get-sab.mjs",
    "test:http-post-browser": "kbb --backend sci -cp test/browser test/browser/verify_http_post_browser.cljk",
    "test:llm-infer-browser": "kbb --backend sci -cp test/browser test/browser/verify_llm_infer_browser.cljk"
  }
}
