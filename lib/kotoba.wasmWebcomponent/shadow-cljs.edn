;; ClojureScript build for kami-engine-host (ADR-2607072715): a
;; kotoba-lang/kami-script-runtime-rs port authored once in ClojureScript and
;; compiled to a single ES module (`src/kami-engine-host.js`) that runs
;; identically in a browser `<script type="module">` and in Node — no
;; per-platform hand-written JS ports.
{:source-paths ["src-cljs" "src-cljs/vendor"]
 :dependencies []
 :builds
 {:kami-ecs
  {:target :esm
   :output-dir "src"
   :modules {:kami-ecs
             {:exports {createKamiEcs kotoba.kami-ecs/create-kami-ecs
                        kamiHostImports kotoba.kami-ecs/kami-host-imports}}}
   :release {:compiler-options {:optimizations :advanced}}}

  :kami-engine-host
  {:target :esm
   :output-dir "src"
   :modules {:kami-engine-host
             {:exports {createKamiEngineHost kotoba.kami-engine-host/create-kami-engine-host
                        orderedTickExports kotoba.kami-engine-host/ordered-tick-exports}}}
   :release {:compiler-options {:optimizations :advanced}}}

  :gpu-clear-host
  {:target :esm
   :output-dir "src"
   :modules {:gpu-clear-host
             {:exports {setupGpuClearHost kotoba.gpu-clear-host/setup-gpu-clear-host
                        unpackRgba8 kotoba.gpu-clear-host/unpack-rgba8}}}
   :release {:compiler-options {:optimizations :advanced}}}

  :kotoba-cap
  {:target :esm
   :output-dir "src"
   :modules {:kotoba-cap
             {:exports {kotobaCapImports kotoba.kotoba-cap/kotoba-cap-imports
                        amuCompileImports kotoba.kotoba-cap/amu-compile-imports
                        KOTOBA_CAP_MODULE kotoba.kotoba-cap/kotoba-cap-module
                        CLOCK_NOW_CAPABILITY_ID kotoba.kotoba-cap/clock-now-capability-id}}}
   :release {:compiler-options {:optimizations :advanced}}}

  :solar-render-host
  {:target :esm
   :output-dir "src"
   :modules {:solar-render-host
             {:exports {setupSolarRenderHost kotoba.solar-render-host/setup-solar-render-host
                        mat4Multiply kotoba.solar-render-host/mat4-multiply
                        mat4Perspective kotoba.solar-render-host/mat4-perspective
                        mat4LookAt kotoba.solar-render-host/mat4-look-at
                        mat4TranslationScale kotoba.solar-render-host/mat4-translation-scale
                        vec3Normalize kotoba.solar-render-host/vec3-normalize
                        vec3Sub kotoba.solar-render-host/vec3-sub
                        vec3Cross kotoba.solar-render-host/vec3-cross
                        vec3Dot kotoba.solar-render-host/vec3-dot
                        buildSphereMesh kotoba.solar-render-host/build-sphere-mesh
                        wrapNowDays kotoba.solar-render-host/wrap-now-days}}}
   :release {:compiler-options {:optimizations :advanced}}}}}
