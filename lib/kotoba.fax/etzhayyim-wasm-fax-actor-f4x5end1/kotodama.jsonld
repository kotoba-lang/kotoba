{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:fax.etzhayyim.com",
  "name": "fax",
  "nanoid": "f4x5end1",
  "project": "fax",
  "runtimeType": "worker",
  "performerType": "service",
  "uiType": "appview",
  "convoSystemPrompt": "You are the FAX transmission agent — you accept PDF documents + E.164 fax numbers, dispatch them via Dropbox Fax / Phaxio-compatible providers, and report delivery status. You never mutate document content; you only transport. Always log txId + providerFaxId + caseId for audit.",
  "duties": ["勤労の義務"],
  "kpi": ["FAX送達成功率", "配達証明取得数"],
  "profile": {
    "displayName": "FAX Gateway (Etzhayyim Japan)",
    "description": "FAX送受信AIエージェント — text/markdown/HTML を A4 PDF に render し、Dropbox Fax UI への manual-handoff で operator が送信。Mailer actor 経由で Teams 通知。Phaxio API path はコード残置 dead path。MCP-callable: composeAndSend / confirmManualSend / renderPdf / uploadDocument。内容証明・労基署・裁判所等の紙面行政対応。",
    "avatar": "FX",
    "category": "communication",
    "capabilities": ["fax-compose-and-send", "fax-confirm-manual-send", "fax-render-pdf", "fax-upload-document", "document-transport"],
    "isBot": true,
    "agentType": "semi-autonomous",
    "operator": "etzhayyim.com",
    "country": "jpn",
    "website": "https://fax.etzhayyim.com/",
    "sourceUrl": "https://app.hellofax.com/"
  },
  "entities": [
    {
      "category": "provider",
      "did": "did:web:fax.etzhayyim.com:source:hellofax",
      "name": "Dropbox Fax (HelloFax UI)",
      "sourceId": "src-hellofax",
      "url": "https://app.hellofax.com/",
      "role": "active-ui-provider",
      "note": "Primary transmission path. Operator uploads PDF + enters E.164 manually."
    },
    {
      "category": "provider",
      "did": "did:web:fax.etzhayyim.com:source:phaxio",
      "name": "Phaxio (Sinch Fax API) — DEAD PATH",
      "sourceId": "src-phaxio",
      "url": "https://www.phaxio.com/",
      "apiBase": "https://api.phaxio.com/v2.1",
      "role": "deprecated-api",
      "note": "Code retained for symmetry. Re-enable only if a paid programmatic provider is adopted (Sinch / Documo mFax / SRFax / Interfax)."
    },
    {
      "category": "notifier",
      "did": "did:web:mailer.etzhayyim.com",
      "sourceId": "src-mailer",
      "name": "Mailer actor (cross-actor invoke)",
      "url": "https://mailer.etzhayyim.com/",
      "role": "operator-notification",
      "note": "Used by composeAndSend (manual provider) to email operator + Teams channel with PDF link + send instructions."
    },
    {
      "category": "regulator-target",
      "did": "did:web:roukisho.etzhayyim.com:tokyo:chuo",
      "name": "中央労働基準監督署 (external — roukisho actor)",
      "sourceId": "ext-roukisho-chuo",
      "url": "https://jsite.mhlw.go.jp/tokyo-roudoukyoku/",
      "faxE164": "+81338188411",
      "role": "regulatory-target",
      "note": "External DID owned by did:web:roukisho.etzhayyim.com. fax actor dispatches and records communications via roukisho.recordCommunication."
    }
  ],
  "governance": {
    "raci": "responsible",
    "classification": "confidential",
    "complianceFrameworks": ["fax-provider-tos", "telecom-act-jpn"]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.fax.faxTx",
        "com.etzhayyim.apps.fax.inboundFax",
        "com.etzhayyim.apps.lawfirm.brief",
        "com.etzhayyim.apps.eyubin.postalItem",
        "app.bsky.feed.post",
        "app.bsky.graph.follow"
      ]
    }
  },
  "space": {
    "name": "FAX Gateway",
    "description": "FAX transmission activity feed",
    "joinRule": "invite",
    "historyVisibility": "shared",
    "channels": [
      {
        "default": true,
        "description": "FAX transmission activity (outbound/inbound)",
        "kind": "public",
        "name": "fax-feed"
      },
      {
        "description": "Audit log for legal / regulatory faxes",
        "kind": "private",
        "name": "fax-audit"
      }
    ]
  },
  "component": {
    "env": {
      "FAX_PROVIDER": "manual",
      "DROPBOX_FAX_UI_URL": "https://app.hellofax.com/",
      "CDN_PUBLIC_BASE_URL": "https://fax.etzhayyim.com/api/blob"
    }
  }
}
