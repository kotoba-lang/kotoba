// svelte-to-cljs migration (2026-09-08): the SvelteKit frontend at
// etzhayyim-wasm-fax-actor-f4x5end1/svelte was replaced by a static
// reagent + re-frame + jp-go-dds build at
// etzhayyim-wasm-fax-actor-f4x5end1/cljs/public. Changes below:
//   - "main" removed: src/app.ts does not call env.ASSETS.fetch(), so
//     pointing "main" at it would put a Worker in front of the assets and
//     nothing would serve static files. This Worker is now assets-only.
//   - "assets.directory" repointed at "./cljs/public" (the shadow-cljs
//     build output; run `npm run build` in cljs/ before deploying).
//   - "vars.APP_FRAMEWORK" changed from "sveltekit-edge-bff" to
//     "cljs-reagent-re-frame-jp-go-dds".
// ⚠ UNVERIFIED: `wrangler deploy` / `wrangler dev` were not run against this
// config as part of the migration. Deployment verification is a separate,
// later job — do not treat this edit as a confirmed-working deploy config.
{
  "name": "kotodama-f4x5end1",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_CAPABILITIES": "[\"fax-compose-and-send\",\"fax-confirm-manual-send\",\"fax-render-pdf\",\"fax-upload-document\",\"document-transport\"]",
    "APP_DESCRIPTION": "FAX送受信AIエージェント — text/markdown/HTML を A4 PDF に render し、Dropbox Fax UI への manual-handoff で operator が送信。Mailer actor 経由で Teams 通知。Phaxio API path はコード残置 dead path。MCP-callable: composeAndSend / confirmManualSend / renderPdf / uploadDocument。内容証明・労基署・裁判所等の紙面行政対応。",
    "APP_DISPLAY_NAME": "FAX Gateway (etzhayyim Japan)",
    "APP_EMBED_URL": "https://f4x5end1.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "f4x5end1",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview",
    "CDN_PUBLIC_BASE_URL": "https://fax.etzhayyim.com/api/blob",
    "DROPBOX_FAX_UI_URL": "https://app.hellofax.com/",
    "FAX_PROVIDER": "manual",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "f4x5end1.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "fax.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
