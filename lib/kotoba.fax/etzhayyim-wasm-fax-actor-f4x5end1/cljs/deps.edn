;; fax f4x5end1 appview frontend — reagent + re-frame, rendered with
;; jp-go-dds (デジタル庁デザインシステム). Migrated from
;; etzhayyim-wasm-fax-actor-f4x5end1/svelte (Svelte 5 + SvelteKit +
;; @sveltejs/adapter-cloudflare — a single `src/routes/+page.svelte` scaffold
;; card that displays this app's own name/kind/routes/vars metadata; no
;; compose/send UI existed in the frontend prior to this migration — see the
;; ns docstring in src/etzhayyim/wasm/fax/app.cljs for the full account).
;;
;; reagent/re-frame/clojurescript/shadow-cljs live under the :cljs alias
;; rather than top-level :deps (workspace convention — see
;; orgs/cloud-itonami/okaimono/appview/okaimono-shopping-mcp-component/cljs/deps.edn
;; for the same shape: "so library consumers don't inherit reagent/re-frame/
;; shadow-cljs"). jp-go-dds is a workspace git dep and stays top-level.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system.git"
         ;; Pinned to the same sha the landed okaimono migration uses — an
         ;; explicit floor proven by a landed repo (AGENTS.md "基盤ライブラリの
         ;; 定数倍は…" — deps.edn pins have no gate, so this comment is the
         ;; only record of why. Do not bump without checking it still builds.)
         :git/sha "dc4602dc17bce8f6e9ba038e92b3e95fcc411b49"}}
 :aliases {:cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                                thheller/shadow-cljs {:mvn/version "2.28.20"}
                                reagent/reagent {:mvn/version "1.2.0"}
                                re-frame/re-frame {:mvn/version "1.4.3"}}}
           :test {:extra-paths ["test"]}}}
