{:deps   {:aliases [:cljs :test]}
 :builds {:app  {:target :browser
                 ;; :asset-path is relative — this app is served under a path
                 ;; prefix (f4x5end1.etzhayyim.com/* and fax.etzhayyim.com/*
                 ;; both route to the same assets binding); an absolute path
                 ;; would break under a prefix.
                 :output-dir "public/js"
                 :asset-path "js"
                 :modules {:app {:init-fn etzhayyim.wasm.fax.app/main}}}
          :test {:target :node-test
                 :output-to "out/tests.js"
                 :ns-regexp "-test$"}}}
