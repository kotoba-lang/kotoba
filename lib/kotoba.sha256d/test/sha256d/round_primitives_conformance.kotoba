(ns sha256d.round-primitives-conformance
  (:require [sha256d.round-primitives :as round])
  (:export [main ch-value maj-value ch-check maj-check]))

(defn ch-value [x :i64 y :i64 z :i64] :i64
  (round/ch x y z))

(defn maj-value [x :i64 y :i64 z :i64] :i64
  (round/maj x y z))

(defn ch-check [x :i64 y :i64 z :i64] :i64
  (let [reference (round/ch x y z)]
    (if (= reference (round/ch-alt x y z))
      (if (= reference (round/ch-or x y z)) 42 2) 1)))

(defn maj-check [x :i64 y :i64 z :i64] :i64
  (let [reference (round/maj x y z)]
    (if (= reference (round/maj-alt x y z))
      (if (= reference (round/maj-or x y z)) 42 2) 1)))

(defn main [] :i64 42)
