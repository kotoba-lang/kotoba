;; sha256d -- portable .cljc SHA-256 / Bitcoin SHA-256d reference implementation,
;; plus an interchangeable "gene pool" of proven-equivalent round-primitive
;; formulations and a self-contained evolutionary benchmark tournament over them.
;; First-party kotoba-lang deps: kotoba.prng is the deterministic PRNG that
;; replaces java.util.Random (src/mitm.cljc run-mitm, test/core_test.cljc).
;; Zero THIRD-party deps remains true; prng is kotoba-lang's own portable lib.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/prng {:local/root "../kotoba.prng"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :kotoba {:replace-deps {io.github.kotoba-lang/amu
                          {:git/url "https://github.com/kotoba-lang/amu.git"
                           :git/sha "78f43e64125e9c4bbe2bfb3a9520ae4b767dc275"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}}}
