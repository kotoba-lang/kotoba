(ns sha256d.round-primitives
  (:export [ch ch-alt ch-or maj maj-alt maj-or]))

(defn or64 [a :i64 b :i64] :i64
  (bit-xor (bit-xor a b) (bit-and a b)))

(defn ch [x :i64 y :i64 z :i64] :i64
  (bit-xor (bit-and x y) (bit-and (bit-xor x -1) z)))

(defn ch-alt [x :i64 y :i64 z :i64] :i64
  (bit-xor z (bit-and x (bit-xor y z))))

(defn ch-or [x :i64 y :i64 z :i64] :i64
  (or64 (bit-and x y) (bit-and (bit-xor x -1) z)))

(defn maj [x :i64 y :i64 z :i64] :i64
  (bit-xor (bit-xor (bit-and x y) (bit-and x z)) (bit-and y z)))

(defn maj-alt [x :i64 y :i64 z :i64] :i64
  (or64 (bit-and x y) (bit-and z (or64 x y))))

(defn maj-or [x :i64 y :i64 z :i64] :i64
  (or64 (or64 (bit-and x y) (bit-and x z)) (bit-and y z)))
