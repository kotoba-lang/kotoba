(ns x.client
  "X (Twitter) API v2 client — mentions search + DM read/write + tweet reply,
  the operations a channel ingress/egress adapter needs. Portable `.cljc`,
  I/O injected (`:http-fn` `:json-write` `:json-read` `:creds`), same DI shape
  as `chatwork.client` / `tayori.channel.slack`.

  Auth is a Bearer token in `:creds {:bearer-token \"...\"}`. Two DIFFERENT
  token shapes exist upstream and this library does not distinguish them
  (the caller supplies whichever it has):
  - An App-only (OAuth 2.0 App Access Token / OAuth 2.0 Client Credentials)
    token works for `search-recent-mentions` (public data).
  - `list-dm-events`/`send-dm!` require a User-context OAuth 2.0 token
    (Authorization Code + PKCE flow, `dm.read`/`dm.write` scopes) — a DM is
    private to the authenticated user, no App-only token can read it.
  Acquiring either token (the OAuth app registration, the PKCE
  authorize/callback/refresh dance) is OUT OF SCOPE here, same non-goal
  `com-gmail` documents for its own Bearer token — callers supply a valid
  token (env or explicit `:bearer-token`).

  Cost note: meaningful read access (mentions search beyond a trivial
  sandbox, any DM access) requires a paid X API tier (Basic $200/mo or
  above as of this writing) — this library does not change that, it only
  avoids re-deriving the HTTP calls once a tier is purchased.")

(def ^:private base-url "https://api.twitter.com/2")

(defn- percent-encode
  "RFC 3986 percent-encoding for one query-param value (a search query can
  contain spaces/@/# — all must be escaped or the request URL is malformed)."
  [s]
  #?(:clj  (java.net.URLEncoder/encode (str s) "UTF-8")
     :cljs (.replace (js/encodeURIComponent (str s)) (js/RegExp. "%20" "g") "+")))

(defn- auth-header [creds]
  {"Authorization" (str "Bearer " (:bearer-token creds))})

(defn- get! [{:keys [http-fn json-read creds]} path]
  (let [resp (http-fn {:url (str base-url path) :method :get :headers (auth-header creds)})]
    (if (= 200 (:status resp))
      (json-read (:body resp))
      {:ok false :status (:status resp) :error (:body resp)})))

(defn- post! [{:keys [http-fn json-write json-read creds]} path payload]
  (let [resp (http-fn {:url (str base-url path) :method :post
                        :headers (assoc (auth-header creds) "Content-Type" "application/json")
                        :body (json-write payload)})]
    (if (#{200 201} (:status resp))
      (json-read (:body resp))
      {:ok false :status (:status resp) :error (:body resp)})))

(defn search-recent-mentions
  "GET /2/tweets/search/recent?query=@<handle> -- recent tweets mentioning
  `handle` (no leading @). App-only bearer token is sufficient (public
  data). Returns the raw `:data` vector, or [] if none/on failure."
  [io {:keys [handle max-results] :or {max-results 10}}]
  (or (:data (get! io (str "/tweets/search/recent?query=" (percent-encode (str "@" handle))
                            "&max_results=" (max 10 (min 100 max-results))
                            "&tweet.fields=author_id,created_at,conversation_id")))
      []))

(defn list-dm-events
  "GET /2/dm_events -- recent DM events across all the authenticated user's
  conversations. Requires a User-context token with `dm.read`. Returns the
  raw `:data` vector, or [] if none/on failure (including a 401 from an
  App-only token, which cannot read DMs)."
  [io]
  (or (:data (get! io (str "/dm_events?dm_event.fields=sender_id,created_at,"
                           "dm_conversation_id,text&max_results=20")))
      []))

(defn reply-tweet!
  "POST /2/tweets -- reply to `tweet-id` with `text`. Requires a
  User-context token with `tweet.write`."
  [io {:keys [tweet-id text]}]
  (post! io "/tweets" {:text text :reply {:in_reply_to_tweet_id tweet-id}}))

(defn send-dm!
  "POST /2/dm_conversations/with/:participant_id/messages -- send `text` to
  `participant-id` (a user id, not a @handle). Requires a User-context
  token with `dm.write`."
  [io {:keys [participant-id text]}]
  (post! io (str "/dm_conversations/with/" participant-id "/messages") {:text text}))
