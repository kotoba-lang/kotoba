(ns x.client-test
  (:require [clojure.test :refer [deftest is]]
            [kotoba.lang.text :as str]
            [x.client :as x]))

(defn- fake-io [responses]
  (let [calls (atom [])]
    {:calls calls
     :creds {:bearer-token "tok-abc"}
     :json-write pr-str
     :json-read  (fn [s] (read-string s))
     :http-fn
     (fn [{:keys [url method] :as req}]
       (swap! calls conj req)
       (or (some (fn [[[m path-sub] resp]]
                   (when (and (= m method) (str/includes? url path-sub))
                     resp))
                 responses)
           {:status 404 :body "(nil)"}))}))

(deftest search-recent-mentions-sends-bearer-and-encodes-query
  (let [io (fake-io {[:get "/tweets/search/recent"]
                      {:status 200 :body (pr-str {:data [{:id "1" :text "hi @acct"}]})}})
        out (x/search-recent-mentions io {:handle "acct"})]
    (is (= [{:id "1" :text "hi @acct"}] out))
    (is (= "Bearer tok-abc" (get-in (first @(:calls io)) [:headers "Authorization"])))
    (is (str/includes? (:url (first @(:calls io))) "%40acct"))))

(deftest search-recent-mentions-returns-empty-on-failure
  (let [io (fake-io {[:get "/tweets/search/recent"] {:status 401 :body "(nil)"}})]
    (is (= [] (x/search-recent-mentions io {:handle "acct"})))))

(deftest list-dm-events-returns-data-vector
  (let [io (fake-io {[:get "/dm_events"] {:status 200 :body (pr-str {:data [{:id "d1"}]})}})]
    (is (= [{:id "d1"}] (x/list-dm-events io)))))

(deftest list-dm-events-returns-empty-when-unauthorized
  (let [io (fake-io {[:get "/dm_events"] {:status 401 :body "(nil)"}})]
    (is (= [] (x/list-dm-events io)))))

(deftest reply-tweet-posts-in-reply-to
  (let [io (fake-io {[:post "/tweets"] {:status 201 :body (pr-str {:data {:id "99"}})}})
        out (x/reply-tweet! io {:tweet-id "42" :text "thanks"})]
    (is (= {:data {:id "99"}} out))
    (is (= {:text "thanks" :reply {:in_reply_to_tweet_id "42"}}
           (read-string (:body (first @(:calls io))))))))

(deftest send-dm-posts-to-participant-conversation
  (let [io (fake-io {[:post "/dm_conversations/with/"] {:status 201 :body (pr-str {:data {:dm_event_id "e1"}})}})
        out (x/send-dm! io {:participant-id "U9" :text "hey"})]
    (is (= {:data {:dm_event_id "e1"}} out))
    (is (str/includes? (:url (first @(:calls io))) "/dm_conversations/with/U9/messages"))))

;; Regression: post!/get! used to return bare `nil` on failure (no explicit
;; :ok key), and a naive `(if (false? (:ok res)) ... success)` caller-side
;; check treats `(false? nil)` => false as "not a failure" -- silently
;; reporting success for every failed call. Failure MUST be an explicit
;; {:ok false ...} map so callers checking (false? (:ok res)) work correctly
;; (found via local-manimani's channels.x wiring hitting exactly this bug).

(deftest reply-tweet-returns-explicit-failure-shape-on-non-2xx
  (let [io (fake-io {[:post "/tweets"] {:status 401 :body "unauthorized"}})
        out (x/reply-tweet! io {:tweet-id "42" :text "thanks"})]
    (is (false? (:ok out)))
    (is (= 401 (:status out)))))

(deftest send-dm-returns-explicit-failure-shape-on-non-2xx
  (let [io (fake-io {[:post "/dm_conversations/with/"] {:status 403 :body "forbidden"}})
        out (x/send-dm! io {:participant-id "U9" :text "hey"})]
    (is (false? (:ok out)))
    (is (= 403 (:status out)))))
