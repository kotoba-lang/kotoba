{:library/name kotoba-lang/haishin
 :library/version "0.1.0"
 :library/category :shared-lib
 :library/consumers :actor
 :library/schema "kotoba.repository-role-rules.v0"

 ;; No name prefix: a reusable library, not a `loop-*` orchestrator, a `skill-*`
 ;; instruction package, or an `action-*` adapter.
 ;; See manifest/repository-rules.edn :vocabulary/id :name-prefix.
 :repository/role :library
 :repository/execution :none

 :library/invariants
 #{;; No HTTP client, no JSON codec, no env read, no credential lookup, and no
   ;; dependency that could hide one. Effects come from caller-supplied :senders.
   :no-transport
   :no-credentials
   ;; planning reads no clock and touches no network; identical input, identical plan
   :pure-planning
   ;; execute! requires an explicit :grant; unauthorised targets are skipped, never sent
   :grant-fails-closed
   ;; every attempted target yields a receipt, including failures and skips
   :receipt-per-attempt
   ;; constraint values carry :constraint/checked-at and :constraint/provenance
   :auditable-limits}

 :library/targets #{:youtube :instagram :tiktok :x :vimeo :linkedin}

 :library/api
 [haishin.core/plan
  haishin.core/summary
  haishin.core/execute!
  haishin.core/dry-run
  haishin.core/syndicate!
  haishin.core/normalize
  haishin.core/artifact-problems
  haishin.core/tamaki-content->artifact
  haishin.core/plan->grant
  haishin.core/unverified-targets]

 ;; Deliberately NOT depended on. haishin emits request descriptions; a caller's
 ;; sender bridges to whichever client it wants. Recording the relationship here
 ;; instead of in deps.edn keeps a fresh checkout of this library working with
 ;; nothing else present.
 :library/companion-clients
 {:youtube kotoba-lang/com-youtube}

 :library/related
 {kotoba-lang/social-publication
  "dry-run-only observation-post membrane for governance actors; disjoint charter, unchanged"}}
