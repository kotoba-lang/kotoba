{:paths ["src"]
 ;; No runtime dependencies. This library builds request *descriptions* and
 ;; performs no I/O, so it needs neither an HTTP client nor a JSON codec — the
 ;; caller's sender already has both.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
