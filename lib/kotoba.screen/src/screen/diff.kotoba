;; screen.diff — what changed between two host observations.
;;
;; PURE. This is the judgment half of a rolling screen-context feed
;; (cloud-itonami's chronicle is one consumer): given two frames' digests
;; and names, decide whether anything a caller might care about moved.
;; The bytes never enter the guest -- the host digests them and passes
;; the digests. The digest itself is an i64 (the low word of the host's
;; hash) because content-addressing here only needs collision-detection
;; over a rolling window of at most a few hundred frames, and i64 crosses
;; every ABI the language has.
;;
;; digest 0 is reserved as NO DIGEST (a frame with no OCR text, or a
;; capture the host refused); a 0 against anything is "changed" except
;; 0-against-0, which is "same empty".

(ns screen.diff
  (:export [frame-changed? digest-same? app-changed? frame-same-or-empty
            combined-digest]))

(def empty-digest 0)

(defn digest-same? [a :i64 b :i64] :bool
  ;; Do two content digests name the same screen bytes? 0 against 0 is the same empty screen.
  (= a b))

(defn app-changed? [a :i64 b :i64] :bool
  ;; Did the frontmost application change? The app is the host's small integer code (0 = none/unknown).
  (not (= a b)))

(defn frame-changed? [digest-a :i64 app-a :i64 digest-b :i64 app-b :i64] :bool
  ;; True when the frontmost application OR the screen content moved. A caller that only cares about content ignores the app pair; the chronicle-style feed cares about both, because a new app with the same content digest is a new context.
  (if (not (= app-a app-b)) true
    (not (= digest-a digest-b))))

(defn frame-same-or-empty [digest-a :i64 digest-b :i64] :bool
  ;; Deduplicate rule: drop the new frame when it says the same thing as the one already retained, OR when both say nothing (two empty frames are the same empty screen).
  (= digest-a digest-b))

(defn combined-digest [content-digest :i64 app-code :i64] :i64
  ;; One i64 that changes iff the frame changed: content in the high 47 bits, app code in the low 16. Two frames with the same combined digest are the same context for retention purposes.
  (+ (* content-digest 65536) (- app-code (* 65536 (quot app-code 65536)))))
