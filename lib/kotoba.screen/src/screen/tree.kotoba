;; screen.tree — the normalized accessibility-tree rows the guest judges.
;;
;; PURE. A host observation arrives as bounded scalars; this module shapes
;; and judges them without knowing which desktop produced them.
;;
;; The host flattens its hierarchy into two SEQUENCES of equal length --
;; ref-ids and role-codes -- passed as the legacy i64 pair chain the
;; stdlib walks (terminated by 0, walked with pair-first/pair-second).
;; ref-id 0 is NOT-FOUND, never a real node. role-code is a small integer
;; from the host's role vocabulary in [1, 64], so a hostile host cannot
;; smuggle an unbounded integer past the quota checks.

(ns screen.tree
  (:export [depth-ok? node-quota-ok? find-first-ref
            nodes-with-role ref-of-role-at]))

(def max-depth 64)

(def max-nodes 4096)

(defn depth-ok? [depth :i64] :bool
  ;; A row's depth inside the bound.
  (< depth max-depth))

(defn node-quota-ok? [count :i64] :bool
  ;; The node count a caller may judge.
  (if (< count 0) false (<= count max-nodes)))

(defn find-first-ref [probe :i64 refs roles] :i64
  ;; The ref-id of the first node carrying the role, or 0 when none. 0 is not a valid ref-id, so 0 is safe as NOT-FOUND.
  (if (= refs 0) 0
    (if (= roles 0) 0
      (if (= (pair-first roles) probe)
        (pair-first refs)
        (find-first-ref probe (pair-second refs) (pair-second roles))))))

(defn nodes-with-role [probe :i64 refs roles] :i64
  ;; How many nodes carry the role -- the count a caller needs before it decides whether one press among many is ambiguous.
  (if (= refs 0) 0
    (if (= roles 0) 0
      (if (= (pair-first roles) probe)
        (+ 1 (nodes-with-role probe (pair-second refs) (pair-second roles)))
        (nodes-with-role probe (pair-second refs) (pair-second roles))))))

(defn ref-of-role-at [probe :i64 index :i64 refs roles] :i64
  ;; The index-th node with the role, 0 when there are fewer. The ambiguous-press problem, answered positionally: the host may offer several buttons; the caller names which one it means.
  (if (= index 0)
    (find-first-ref probe refs roles)
    (if (= refs 0) 0
      (if (= (pair-first roles) probe)
        (ref-of-role-at probe (- index 1) (pair-second refs) (pair-second roles))
        (ref-of-role-at probe index (pair-second refs) (pair-second roles))))))
