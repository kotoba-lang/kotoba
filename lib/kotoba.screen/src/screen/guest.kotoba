;; screen.guest — the capability-facing surface of the library.
;;
;; THIS module declares the capabilities; the pure modules declare none.
;; The only two host operations in the whole library are here:
;;
;;   observe  (:screen/observe, wire id 31)  request -> tree digest
;;   act      (:screen/act,       wire id 32)  validated operation -> receipt
;;
;; An act is refused BEFORE the capability is spent when the guest-side
;; shape checks (screen.intent) fail -- that is the point of separating
;; intent from capability. The host re-validates the digest; if the
;; screen changed under us the host's refusal is the currency check,
;; this module's refusal is the shape check.

(ns screen.guest
  (:capabilities #{:screen/observe})
  (:require [screen.tree :as tree]
            [screen.intent :as intent]
            [screen.diff :as diff])
  (:export [observe-and-digest judge-press judge-set-value judge-scroll
            frame-unchanged?]))

(defn observe-and-digest "Ask the host for one observation. The request
  is the host's own small integer (which screen/window; 0 = the default
  surface). The answer is the tree digest the host computed; the rows
  ride the same answer on the host side and are judged by screen.tree
  before any operation is shaped against them. The digest is what every
  act must quote."
  [request :i64] :i64
  (screen/observe request))

(defn frame-unchanged? "True when nothing the feed cares about moved."
  [prev-digest :i64 prev-app :i64 new-digest :i64 new-app :i64] :bool
  (not (diff/frame-changed? prev-digest prev-app new-digest new-app)))

(defn judge-press "0 = refused by shape (do not spend an act grant).
  1 = shape ok, caller may ask the host to act. Also refuses when the
  observation this came from carried no nodes: pressing a tree we were
  told is empty is a caller defect."
  [ref-id :i64 expect-digest :i64 node-count :i64] :i64
  (if (not (tree/node-quota-ok? node-count)) 0
    (if (= node-count 0) 0
      (if (intent/press-valid? ref-id expect-digest) 1 0))))

(defn judge-set-value "The same shape gate for a write, plus the text
  bound."
  [ref-id :i64 expect-digest :i64 text-length :i64 node-count :i64] :i64
  (if (not (tree/node-quota-ok? node-count)) 0
    (if (= node-count 0) 0
      (if (intent/set-value-valid? ref-id expect-digest text-length) 1 0))))

(defn judge-scroll "The same shape gate for a scroll."
  [direction :i64 expect-digest :i64 node-count :i64] :i64
  (if (not (tree/node-quota-ok? node-count)) 0
    (if (= node-count 0) 0
      (if (intent/scroll-valid? direction expect-digest) 1 0))))
