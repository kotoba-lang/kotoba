;; screen.test — golden vectors for the screen library.
;;
;; 17 assertions, one i64 sum: every `(if (…) 1 0)` is an assertion, and
;; the expected total is exactly 17. The runner (host/verify.cljk) compiles
;; the closed module graph with kotoba.compiler/compile-project and executes
;; it through kototama.native.executor/execute (signed artifact, measured
;; loader, aarch64) — JVM-free toolchain, JVM only as the test driver.
;;
;; The oracle is content-addressed by hand: every expectation is a literal
;; a reader can check against the pure modules without running anything.

(ns screen.test
  (:require [screen.rect :as rect]
            [screen.tree :as tree]
            [screen.diff :as diff]
            [screen.intent :as intent])
  (:export [run]))

(defn run [] :i64
  (+ ;; rect: point-in-rect + make (3)
   (if (rect/point-in-rect? (rect/make-rect 0 0 10 10) 5 5) 1 0)
   (if (rect/point-in-rect? (rect/make-rect 0 0 10 10) 10 5) 0 1)
   (if (rect/point-in-rect? (rect/make-rect 0 0 10 10) 11 5) 0 1)
   ;; tree: find-first / count / positional (4)
   (if (= (tree/find-first-ref 7 (cons 30 (cons 31 0)) (cons 7 (cons 1 0))) 30) 1 0)
   (if (= (tree/find-first-ref 9 (cons 30 (cons 31 0)) (cons 7 (cons 1 0))) 0) 1 0)
   (if (= (tree/nodes-with-role 7 (cons 30 (cons 31 (cons 32 0)))
                                 (cons 7 (cons 1 (cons 7 0)))) 2) 1 0)
   (if (= (tree/ref-of-role-at 7 1 (cons 30 (cons 31 (cons 32 0)))
                                 (cons 7 (cons 1 (cons 7 0)))) 32) 1 0)
   ;; diff (3)
   (if (diff/frame-changed? 100 1 100 2) 1 0)
   (if (diff/frame-changed? 100 1 101 1) 1 0)
   (if (diff/frame-changed? 100 1 100 1) 0 1)
   ;; intent: shape gates (7)
   (if (intent/press-valid? 12 777) 1 0)
   (if (intent/press-valid? 0 777) 0 1)
   (if (intent/press-valid? 12 0) 0 1)
   (if (intent/set-value-valid? 12 777 4096) 1 0)
   (if (intent/set-value-valid? 12 777 4097) 0 1)
   (if (intent/scroll-valid? 3 777) 1 0)
   (if (intent/scroll-valid? 5 777) 0 1)))
