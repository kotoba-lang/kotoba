(ns screen.gate
  (:require [screen.diff :as diff]
            [screen.intent :as intent]
            [screen.tree :as tree]
            [screen.rect :as rect])
  (:export [chronicle-keep? gate-frame-unchanged? gate-judge-press gate-version]))

(def screen-gate-version 1)

(defn chronicle-keep? "The chronicle dedup rule as the guest owns it: drop
  the new frame when its combined digest equals the retained one. Both
  digests are host-computed; 0 against 0 is the same empty screen. Returns
  1 = keep, 0 = drop."
  [prev-combined :i64 new-combined :i64] :i64
  (if (= prev-combined new-combined) 0 1))

(defn gate-frame-unchanged? "0 = changed (keep the frame), 1 = unchanged
  (drop). The content and app halves travel separately so a caller can
  watch only one."
  [prev-digest :i64 prev-app :i64 new-digest :i64 new-app :i64] :i64
  (if (diff/frame-changed? prev-digest prev-app new-digest new-app) 0 1))

(defn gate-judge-press "The act shape gate the host consults BEFORE
  spending an act grant. 1 = shape ok (ask the host to act), 0 = refused
  by shape (do not spend a capability, a quota tick, or an approval
  card). Same judgment screen.guest/judge-press makes; restated here so
  the compiled artifact carries it without the capability declaration."
  [ref-id :i64 expect-digest :i64 node-count :i64] :i64
  (if (not (tree/node-quota-ok? node-count)) 0
    (if (= node-count 0) 0
      (if (intent/press-valid? ref-id expect-digest) 1 0))))

(defn gate-version [] :i64 screen-gate-version)
