;; screen.rect — rectangles and points over a bounded coordinate space.
;;
;; PURE. No effects, no capabilities, no host calls. A rect is a record of
;; four i64 fields, passed as ONE argument so the native ABI's five-
;; parameter cap is respected: (rect, x, y) is three arguments.
;;
;; The coordinate space is bounded because a screen is: callers that hand
;; a host-produced snapshot to these predicates can never see a coordinate
;; outside [0, 100000) treated as valid, and these predicates refuse such
;; values rather than silently answering about a rect that cannot be
;; displayed.

(ns screen.rect
  (:export [make-rect rect-in-bounds? overlap? point-in-rect? center-x
            center-y rect-width rect-height]))

(def max-coordinate 100000)

(defn make-rect   [x :i64 y :i64 w :i64 h :i64]
  [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]]
  ;; Build the one rect value this module speaks.
  (record-new [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]]
              x y w h))

(defn rect-in-bounds? [r [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]]]:bool
  ;; A rect is displayable when every coordinate is non-negative and inside the bounded space.
(if (< (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :x) 0) false
    (if (< (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :y) 0) false
      (if (< (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :w) 0) false
        (if (< (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :h) 0) false
          (if (>= (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :x) max-coordinate) false
            (if (>= (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :y) max-coordinate) false
              true)))))))

(defn rect-width [r [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]]]:i64
  ;; The width field, named for readability at call sites.
(record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :w))

(defn rect-height [r [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]]]:i64
  ;; The height field, named for readability at call sites.
(record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :h))

(defn center-x [r [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]]]:i64
  ;; Horizontal center of a rect.
(+ (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :x)
     (quot (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :w) 2)))

(defn center-y [r [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]]]:i64
  ;; Vertical center of a rect.
(+ (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :y)
     (quot (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :h) 2)))

(defn point-in-rect?   [r [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]]
  ;; Is the point (px, py) inside rect r? Half-open: the right and bottom edges belong to the neighbor.
   px :i64 py :i64] :bool
  (if (< px (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :x)) false
    (if (>= px (+ (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :x)
                  (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :w))) false
      (if (< py (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :y)) false
        (if (>= py (+ (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :y)
                      (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] r :h))) false
          true)))))

(defn overlap?   [a [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]]
  ;; Do two rects overlap at all? (Half-open semantics: two rects sharing only an edge do not overlap.)
   b [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]]] :bool
  (if (<= (+ (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] a :x)
             (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] a :w))
          (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] b :x)) false
    (if (<= (+ (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] a :y)
               (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] a :h))
            (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] b :y)) false
      (if (<= (+ (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] b :x)
                 (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] b :w))
              (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] a :x)) false
        (if (<= (+ (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] b :y)
                   (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] b :h))
                (record-get [:record :screen/rect [[:x :i64] [:y :i64] [:w :i64] [:h :i64]]] a :y)) false
          true)))))
