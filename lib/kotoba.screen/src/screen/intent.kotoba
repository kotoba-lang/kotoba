;; screen.intent — the guest-side pre-check on an operation a model wants
;; to perform on a screen it read.
;;
;; PURE. The authority lives in the host (`:screen/act` capability, wire
;; id 32) and the host re-validates the tree digest before every effect.
;; What this module owns is the judgment the guest can make BEFORE
;; spending an act grant: is this request even shaped like an operation
;; this screen could accept? A caller that fails these checks does not
;; burn a capability, a quota tick, or an approval card.
;;
;; The expect digest is not optional anywhere: an operation that names a
;; ref but no digest of the tree it read is refused by TYPE here, and the
;; host refuses it again by authority. Two layers, different reasons --
;; the guest check is about shape, the host check is about permission
;; and currency.

(ns screen.intent
  (:export [press-valid? set-value-valid? scroll-valid? action-summary
            action-kind-ok?]))

(def max-action-text 4096)

;; action-kind codes: 1 = press, 2 = set-value, 3 = scroll-up, 4 = scroll-down.
;; Codes not in [1,4] are not actions this guest judges; the host's own
;; vocabulary can be wider but the guest refuses what it cannot judge.
(def ref-code-press 1)

(def ref-code-set-value 2)

(def ref-code-scroll-up 3)

(def ref-code-scroll-down 4)

(defn action-kind-ok?   [kind :i64] :bool
  ;; Is this one of the operation kinds the guest judges?
  (if (= kind 1) true
    (if (= kind 2) true
      (if (= kind 3) true
        (if (= kind 4) true false)))))

(defn press-valid?   [ref-id :i64 expect-digest :i64] :bool
  ;; A press names an element and quotes the digest of the tree it read. ref-id must be a real ref (>= 1) and the digest must be non-empty (a press against an unread screen is refused by shape).
  (if (< ref-id 1) false
    (if (= expect-digest 0) false
      true)))

(defn set-value-valid?   [ref-id :i64 expect-digest :i64 text-length :i64] :bool
  ;; A write additionally bounds its text: 4 KiB, the same bound the host applies to what it will hand to a widget.
  (if (< ref-id 1) false
    (if (= expect-digest 0) false
      (if (< text-length 0) false
        (if (> text-length max-action-text) false
          true)))))

(defn scroll-valid?   [direction :i64 expect-digest :i64] :bool
  ;; direction: 3 = up, 4 = down (the ref-code-scroll-* values).
  (if (= direction 3) (not (= expect-digest 0))
    (if (= direction 4) (not (= expect-digest 0))
      false)))

(defn action-summary   [kind :i64 ref-id :i64] :i64
  ;; A bounded code a log or an approval card can carry: kind in the high bits, ref in the low 40. Not a sentence -- the sentence is the host's approval-summary job, from this code plus its own labels.
  (+ (* kind 1099511627776) (- ref-id (* 1099511627776 (quot ref-id 1099511627776)))))
