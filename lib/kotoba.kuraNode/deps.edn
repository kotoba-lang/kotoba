        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/erasure {:local/root "../kotoba.erasure"}
        io.github.kotoba-lang/kura {:local/root "../kotoba.kura"}
        io.github.kotoba-lang/merkle-sum {:local/root "../kotoba.merkleSum"}
        io.github.kotoba-lang/sigv4 {:local/root "../kotoba.sigv4"}
        io.github.kotoba-lang/org-nist-sha2 {:local/root "../gov.nist.sha2"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
