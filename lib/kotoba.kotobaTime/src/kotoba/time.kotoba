(ns kotoba.time
  "Pure time core in Kotoba: civil-date arithmetic and ISO-8601 shape checks
  over i64. Clock reading is a host capability and is NOT here."
  (:export [days-in-month leap-year? valid-date? main]))

(defn divisible? [y n] :i64
  (if (= y (* n (quot y n))) 1 0))

(defn leap-year? [y] :i64
  (if (or (and (= 1 (divisible? y 4)) (= 0 (divisible? y 100)))
          (= 1 (divisible? y 400)))
    1 0))

(defn days-in-month [y m] :i64
  (cond
    (= m 2) (if (= 1 (leap-year? y)) 29 28)
    (or (= m 4) (= m 6) (= m 9) (= m 11)) 30
    :else 31))

(defn valid-date? [y m d] :i64
  (if (and (>= m 1) (<= m 12) (>= d 1) (<= d (days-in-month y m))) 1 0))

(defn self-check [] :i64
  (+ (+ (+ (+ (+ (if (= 1 (leap-year? 2024)) 0 1)
   (if (= 0 (leap-year? 2023)) 0 1))
   (if (= 1 (leap-year? 2000)) 0 1))
   (if (= 0 (leap-year? 1900)) 0 1))
   (if (= 29 (days-in-month 2024 2)) 0 1))
   (if (= 1 (valid-date? 2026 9 7)) 0 1)))

(defn main [] :i64 (self-check))
