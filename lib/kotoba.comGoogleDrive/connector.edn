{:schema "kotoba.connector.repository.v1",
 :connector/docs-url
 "https://developers.google.com/drive/api/v3/reference",
 :connector/origin-domain "google.com",
 :connector/base-scopes ["openid" "email"],
 :connector/id "com.google.drive",
 :connector/var "provider",
 :connector/scopes
 ["email"
  "https://www.googleapis.com/auth/drive.metadata.readonly"
  "https://www.googleapis.com/auth/drive.readonly"
  "openid"],
 :authority
 "90-docs/adr/2608097000-connector-plane-one-repo-per-connector.edn",
 :connector/namespace "google-drive.connector",
 :connector/auth-kind :oauth2,
 :connector/auth-pkce? true,
 :connector/summary
 "Search Drive, read file metadata and permissions, export a document as text.",
 :connector/name "Google Drive",
 :connector/client-id-env "GOOGLE_CLIENT_ID",
 :connector/tools
 [{:connector/name "google_drive_export_document",
   :connector/effect :read,
   :connector/scopes
   ["https://www.googleapis.com/auth/drive.readonly"],
   :connector/description
   "Export a Google Docs/Sheets/Slides file as text. Not for binary files — see this connector's README."}
  {:connector/name "google_drive_get_file",
   :connector/effect :read,
   :connector/scopes
   ["https://www.googleapis.com/auth/drive.metadata.readonly"],
   :connector/description "Metadata for one file."}
  {:connector/name "google_drive_list_permissions",
   :connector/effect :read,
   :connector/scopes
   ["https://www.googleapis.com/auth/drive.metadata.readonly"],
   :connector/description
   "Who can see a file. Answers 'is this shared outside the org' without reading the contents."}
  {:connector/name "google_drive_search_files",
   :connector/effect :read,
   :connector/scopes
   ["https://www.googleapis.com/auth/drive.metadata.readonly"],
   :connector/description
   "Search files by Drive query syntax, e.g. name contains 'budget' and mimeType != 'application/vnd.google-apps.folder'."}]}
