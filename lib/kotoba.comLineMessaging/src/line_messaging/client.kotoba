;; Port of line-messaging.client (client.cljk), Kotoba-native, :document values.
;;
;; PARTIAL. Ported: the message builders (`text-messages`, `push-payload`,
;; `reply-payload`). Not ported: `push!` and `reply!`, which take an injected
;; I/O map of functions (:http-fn, :json-write, :json-read). Kotoba has no
;; :fn values (E2105), so the HTTP round trip cannot be expressed here. The
;; caller performs the POST and handles the response.
;;
;; Named divergences:
;;   - text-messages wraps any non-vector body (including a string) as a single
;;     message. The source also wraps non-sequential values; lists are treated
;;     as a single message here.

(ns line-messaging.client
  (:export [text-messages push-payload reply-payload]))

(defn- vector-doc? [d :document] :bool
  (string=? (keyword-name (document-kind d)) "vector"))

(defn- text-message [t :document] :document
  (document-map :type (document-string "text")
                :text t))

(defn- text-loop [v :document i :i64 acc :document] :document
  (if (>= i (document-count v))
    acc
    (text-loop v (+ i 1)
               (document-vector-conj acc
                                     (text-message (option-or (document-vector-at v i) (document-null)))))))

(defn text-messages [body :document] :document
  (if (vector-doc? body)
    (text-loop body 0 (document-vector))
    (document-vector (text-message body))))

(defn push-payload [to :document body :document] :document
  (document-map :to to
                :messages (text-messages body)))

(defn reply-payload [reply-token :document body :document] :document
  (document-map :replyToken reply-token
                :messages (text-messages body)))
