(ns line-messaging.client-test (:export [main]) (:require [line-messaging.client :as p]))

(defn- ok [b :bool] :i64
  (if b 0 1))

(defn- msg [t :string] :document
  (document-map :type (document-string "text") :text (document-string t)))

(defn- text-checks [] :i64
  (+ (ok (document-equal? (p/text-messages (document-string "hi"))
                          (document-vector (msg "hi"))))
     (ok (document-equal? (p/text-messages (document-vector (document-string "a") (document-string "b")))
                          (document-vector (msg "a") (msg "b"))))))

(defn- payload-checks [] :i64
  (+ (ok (document-equal? (p/push-payload (document-string "U1") (document-string "hi"))
                          (document-map :to (document-string "U1") :messages (document-vector (msg "hi")))))
     (ok (document-equal? (p/reply-payload (document-string "tok")
                                           (document-vector (document-string "a") (document-string "b")))
                          (document-map :replyToken (document-string "tok")
                                        :messages (document-vector (msg "a") (msg "b")))))))

(defn main [] :i64
  (+ (text-checks) (payload-checks)))
