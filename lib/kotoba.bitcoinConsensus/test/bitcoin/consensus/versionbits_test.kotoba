;; Behaviour check for bitcoin.consensus.versionbits (JUN-829 batch 3).
;; main returns the number of failed cases; 0 means every case passed.
;; Argument order of next-state: start-time timeout min-activation-height
;; period threshold height parent-state parent-mtp signal-count.
;; Run: amu compile THIS --source-path <lib>/src -o OUT ; amu run OUT

(ns bitcoin.consensus.versionbits-test
  (:require [bitcoin.consensus.versionbits :as vb]))

(defn- fails [ok :bool] :i64
  (if ok 0 1))

(defn main [] :i64
  (+ (fails (vb/signals? 0x20000002 1))
     (fails (not (vb/signals? 0x20000002 0)))
     (fails (not (vb/signals? 0x00000002 1)))
     ;; defined -> started at a period boundary once parent MTP reaches start
     (fails (= :started (vb/next-state 100 200 300 4 3 8 :defined 100 0)))
     ;; not at a period boundary: unchanged
     (fails (= :defined (vb/next-state 100 200 300 4 3 9 :defined 100 0)))
     ;; height 0 is never a transition
     (fails (= :defined (vb/next-state 100 200 300 4 3 0 :defined 100 0)))
     ;; started -> locked-in when signal count reaches threshold
     (fails (= :locked-in (vb/next-state 100 200 300 4 3 8 :started 150 3)))
     ;; started -> failed when parent MTP reaches timeout without locking in
     (fails (= :failed (vb/next-state 100 200 300 4 3 8 :started 200 0)))
     ;; locked-in -> active once height reaches min-activation-height
     (fails (= :active (vb/next-state 100 200 12 4 3 12 :locked-in 150 0)))
     ;; locked-in stays locked-in before min-activation-height
     (fails (= :locked-in (vb/next-state 100 200 12 4 3 8 :locked-in 150 0)))
     ;; active and failed are terminal
     (fails (= :active (vb/next-state 100 200 300 4 3 8 :active 150 3)))
     (fails (= :failed (vb/next-state 100 200 300 4 3 8 :failed 150 3)))))
