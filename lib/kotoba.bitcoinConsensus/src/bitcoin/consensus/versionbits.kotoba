;; Kotoba port of bitcoin.consensus.versionbits (versionbits.cljk, the oracle).
;; JUN-829 batch 3. Checked with amu check (native).
;;
;; Named divergences from the .cljk oracle:
;;  1. next-state takes the deployment config as five positional i64 arguments
;;     (start-time timeout min-activation-height period threshold) ahead of the
;;     transition inputs, instead of one destructured config map. The checker
;;     has no :map parameter type, and a record schema as a def value or as a
;;     parameter type was refused (E2105 / E2116 / E2128) when probed on
;;     2026-11-04. Behaviour is unchanged; only the call shape differs.
;;  2. (bit-shift-left 1 bit) is pow2: bit-shift-left is not admitted (E2101).
;;  3. No :export list. A standalone ENTRY export is gated to i64/bool/string/
;;     vector/record/variant/fn, which refuses the keyword state; this is a
;;     library module, and every defn here is public (E6009 is satisfied).
;;  4. The deployment state stays a keyword (:defined :started :locked-in
;;     :active :failed), as in the oracle.

(ns bitcoin.consensus.versionbits)

(def versionbits-top-bits 0x20000000)
(def versionbits-top-mask 0xe0000000)

(defn pow2 [n :i64] :i64
  (if (<= n 0)
    1
    (* 2 (pow2 (- n 1)))))

(defn signals? [version :i64 bit :i64] :bool
  (and (= versionbits-top-bits (bit-and version versionbits-top-mask))
       (not (zero? (bit-and version (pow2 bit))))))

(defn next-state
  [start-time :i64 timeout :i64 min-activation-height :i64 period :i64 threshold :i64
   height :i64 parent-state :keyword parent-mtp :i64 signal-count :i64] :keyword
  (if (or (zero? height) (not (zero? (mod height period))))
    parent-state
    (case parent-state
      :defined (if (>= parent-mtp start-time) :started :defined)
      :started (cond
                 (>= signal-count threshold) :locked-in
                 (>= parent-mtp timeout) :failed
                 :else :started)
      :locked-in (if (>= height min-activation-height) :active :locked-in)
      :active :active
      :failed :failed
      parent-state)))
