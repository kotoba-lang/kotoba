;; sumitsubo 墨壺 — actor manifest
;; Cleanroom CAD interop (Vectorworks / Autodesk / AutoCAD) for modeling + export,
;; and kotoba Pregel-LangGraph generative / modeling assistance.
;; ADR-2606033600
{:actor/id        "sumitsubo"
 :actor/glyph     "墨壺"
 :actor/tier      :tier-b
 :actor/domain    "sumitsubo.etzhayyim.com"
 :actor/purpose   "Cleanroom CAD interop for kami-engine-sdk — a geometry kernel + open-format export/import (DXF/SVG/OBJ/glTF/IFC-subset/STEP-subset; DWG=proprietary fallback) + published-API-shape adapters mirroring Vectorworks (VectorScript) and Autodesk AutoCAD (ObjectARX/.NET). Plus kotoba Pregel-LangGraph generative modeling (NL → ModelOp plan → Datoms) and 2D drafting assistance. No vendor SDK/decompilation/trademark code; Murakumo-only LLM; kotoba-EAVT-native; no server key."
 :actor/status    :r0
 :actor/adr       "2606033600"

 :actor/charter-rider
 {:rider/version "2.0"
  :rider/applied true}

 :actor/gates
 [{:gate/id "G1"  :gate/name "cleanroom-invariant"          :gate/rule "no vendor SDK headers / decompilation / vendored sample / trademark code; only public format specs (DXF/IFC/STEP/glTF/OBJ) + published API shapes; vendor names nominative not endorsement"}
  {:gate/id "G2"  :gate/name "kotoba-eavt-native"           :gate/rule "drawings/entities/layers/model-requests are kotoba Datoms (:dwg.*); no RW/SQL/Lance canonical (ADR-2605262130/2605312345)"}
  {:gate/id "G3"  :gate/name "murakumo-only"                :gate/rule "generative/assist LLM via KotobaLLM 127.0.0.1:4000; no external LLM (ADR-2605215000)"}
  {:gate/id "G4"  :gate/name "open-format-fidelity-honesty" :gate/rule "per-format fidelity stated (full|subset|fallback); lossy/subset exports + skipped entities flagged; no claim of full vendor parity"}
  {:gate/id "G5"  :gate/name "dwg-proprietary-honesty"      :gate/rule "DWG never natively written; DWG_PROPRIETARY advisory + DXF fallback (N1)"}
  {:gate/id "G6"  :gate/name "no-server-key"                :gate/rule "no platform signing key; export/publish artifacts content-addressed, member/operator-signed (ADR-2605231525)"}
  {:gate/id "G7"  :gate/name "sourcing-honesty"             :gate/rule "generated geometry :representative unless dimensioned from authoritative input"}
  {:gate/id "G8"  :gate/name "charter-rider"                :gate/rule "Apache-2.0 + Charter Rider v2.0 on the SDK module (ADR-2605192200)"}
  {:gate/id "G9"  :gate/name "outward-gated"                :gate/rule "live ingestion of third-party drawing corpora / external CAD-cloud calls = Council + operator gated"}
  {:gate/id "G10" :gate/name "wellbecoming-tool"            :gate/rule "a maker's drafting instrument (labor-liberation, multi-gen design durability), never an engagement/lock-in surface"}
  {:gate/id "G11" :gate/name "wasm-sbom-attestation"        :gate/rule "the deployed langgraph wasm carries a CycloneDX SBOM bound to its kotoba program CID (KotobaCid::from_bytes(wasm)); deps purl↔CVE matchable via VulnMatch; version provenance honest (lock|pin|constraint) (ADR-2606036000)"}]

 :actor/cells
 [{:cell/id "model"    :cell/kind :langgraph :cell/runtime :wasm}
  {:cell/id "draft"    :cell/kind :langgraph :cell/runtime :wasm}
  {:cell/id "interop"  :cell/kind :langgraph :cell/runtime :wasm}
  {:cell/id "export"   :cell/kind :datalog   :cell/runtime :kotoba}
  {:cell/id "catalog"  :cell/kind :datalog   :cell/runtime :kotoba}]

 :actor/lexicons
 ["com.etzhayyim.sumitsubo.drawing"
  "com.etzhayyim.sumitsubo.entity"
  "com.etzhayyim.sumitsubo.modelRequest"
  "com.etzhayyim.sumitsubo.export"]

 ;; The TS cleanroom CAD-interop SDK module re-exported by kami-engine-sdk.
 :actor/sdk
 {:sdk/package "@etzhayyim/sumitsubo-cad"
  :sdk/repository "https://github.com/etzhayyim/com-etzhayyim-sumitsubo-cad"
  :sdk/revision "225cbf26faa1964e39366ecd69de5ba0ca7a6c7e"
  :sdk/reexport-from "kami-engine-sdk (export * from '@etzhayyim/sumitsubo-cad')"
  :sdk/formats ["dxf" "svg" "obj" "gltf" "ifc" "step" "dwg"]
  :sdk/adapters ["vectorworks" "autocad"]}

 ;; Shared ModelOp vocabulary is identical across the TS kernel and the py generative cell.
 :actor/integrates
 ["actor:tatekata" "actor:giemon" "actor:funadaiku" "actor:sarutahiko"  ;; consumers: construction/mfg modeling
  "engine:kami-app-cad" "engine:kami-app-bim"]                          ;; kami-engine viewers

 :actor/kotoba
 {:kotoba/schema "kotoba/schema.edn"
  :kotoba/seed   "kotoba/seed.edn"
  :kotoba/deploy "kotoba/deploy.edn"}

 ;; CycloneDX SBOM bound to the deployed wasm's kotoba program CID (G11).
 ;; Generated at deploy time by 70-tools/scripts/wasm-sbom/wasm_sbom_gen.py and
 ;; ingested into kotobase-kg-v1; deps join the same purl↔CVE VulnMatch surface
 ;; as the giemon hardware SBOMs (ADR-2605312330). See ADR-2606036000.
 :actor/sbom
 {:sbom/status :not-built
  :sbom/reason :no-component-binary-in-repository
  :sbom/required-before-deployment true
  :sbom/adr "2606036000"}}
