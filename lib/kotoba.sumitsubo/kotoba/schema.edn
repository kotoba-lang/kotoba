;; sumitsubo 墨壺 — kotoba EAVT schema
;; ADR-2606033600
;; Drawing / layer / entity / export / model-request, all kotoba Datoms (G2).
;; The pinned TS SDK and the Clojure cells
;; both write into this :dwg.* namespace. Canonical state per ADR-2605262130/2605312345.

[;; ───────────────────────────── :dwg/* — drawing ─────────────────────────────
 {:db/ident :dwg/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "stable drawing key, e.g. drawing-1 / proj.tatekata.floorplan-1"}
 {:db/ident :dwg/name
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/ident :dwg/unit
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":mm | :cm | :m | :in | :ft (storage is always mm)"}
 {:db/ident :dwg/sourcing
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":authoritative (dimensioned from real input) | :representative (generated) — G7"}

 ;; ───────────────────────────── :dwg.layer/* — layer ─────────────────────────────
 {:db/ident :dwg.layer/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :dwg.layer/name
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/ident :dwg.layer/of
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "ref to :dwg/id"}
 {:db/ident :dwg.layer/color
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "r,g,b 0..255"}

 ;; ───────────────────────────── :dwg.entity/* — geometry ─────────────────────────────
 {:db/ident :dwg.entity/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :dwg.entity/of
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "ref to :dwg/id"}
 {:db/ident :dwg.entity/kind
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":point | :line | :polyline | :circle | :arc | :mesh"}
 {:db/ident :dwg.entity/layer
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/ident :dwg.entity/geom
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "compact coordinate encoding (see the pinned Sumitsubo CAD SDK)"}
 {:db/ident :dwg.entity/closed
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "polyline only"}
 {:db/ident :dwg.entity/verts
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "mesh only — vertex count"}
 {:db/ident :dwg.entity/tris
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "mesh only — triangle count"}

 ;; ───────────────────────────── :dwg.suggestion/* — draft assist ─────────────────────────────
 {:db/ident :dwg.suggestion/kind
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":layer | :dimension | :constraint"}
 {:db/ident :dwg.suggestion/target
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/ident :dwg.suggestion/note
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}

 ;; ───────────────────────────── :dwg.export/* — export record ─────────────────────────────
 {:db/ident :dwg.export/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :dwg.export/of
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "ref to :dwg/id"}
 {:db/ident :dwg.export/format
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":dxf | :svg | :obj | :gltf | :ifc | :step | :dwg"}
 {:db/ident :dwg.export/fidelity
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":full | :subset | :fallback (G4)"}
 {:db/ident :dwg.export/native
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "false for :dwg (proprietary, G5)"}
 {:db/ident :dwg.export/advisory
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "e.g. DWG_PROPRIETARY"}

 ;; ───────────────────────────── :dwg.req/* — model-request (generative) ─────────────────────────────
 {:db/ident :dwg.req/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :dwg.req/prompt
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "NL modeling prompt"}
 {:db/ident :dwg.req/member
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "requesting member DID"}
 {:db/ident :dwg.req/produced
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "ref to produced :dwg/id"}]
