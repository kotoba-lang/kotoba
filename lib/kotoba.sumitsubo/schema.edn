;; schema.edn — Datomic/Datascript compatible schema
;; :db/ident attribute definitions. No Datomic-specific keys (:db.install/_attribute etc).
;; Do not hand-edit -- regenerating overwrites this file.
;;
;; wrap-map-keep-ns-transformed files (cells/*.edn) keep pre-existing idiomatic
;; namespaced keywords (:cell/id etc) as-is; lex/*.edn bare keys get a per-file
;; namespace matching the lexicon id's trailing camelCase segment. Non-scalar
;; values are pr-str "blob" strings (valueType=string) so type stays uniform.

[#:db{:ident :cell/doc, :valueType :db.type/string, :cardinality :db.cardinality/one} #:db{:ident :cell/gates, :valueType :db.type/string, :cardinality :db.cardinality/many} #:db{:ident :cell/glyph, :valueType :db.type/string, :cardinality :db.cardinality/one} #:db{:ident :cell/handler, :valueType :db.type/string, :cardinality :db.cardinality/one} #:db{:ident :cell/id, :valueType :db.type/string, :cardinality :db.cardinality/one} #:db{:ident :cell/kind, :valueType :db.type/keyword, :cardinality :db.cardinality/one} #:db{:ident :cell/kotoba, :valueType :db.type/string, :cardinality :db.cardinality/one} #:db{:ident :cell/runtime, :valueType :db.type/keyword, :cardinality :db.cardinality/one} #:db{:ident :drawing/defs, :valueType :db.type/string, :cardinality :db.cardinality/one} #:db{:ident :drawing/id, :valueType :db.type/string, :cardinality :db.cardinality/one} #:db{:ident :drawing/lexicon, :valueType :db.type/long, :cardinality :db.cardinality/one} #:db{:ident :entity/defs, :valueType :db.type/string, :cardinality :db.cardinality/one} #:db{:ident :entity/id, :valueType :db.type/string, :cardinality :db.cardinality/one} #:db{:ident :entity/lexicon, :valueType :db.type/long, :cardinality :db.cardinality/one} #:db{:ident :export/defs, :valueType :db.type/string, :cardinality :db.cardinality/one} #:db{:ident :export/id, :valueType :db.type/string, :cardinality :db.cardinality/one} #:db{:ident :export/lexicon, :valueType :db.type/long, :cardinality :db.cardinality/one} #:db{:ident :modelRequest/defs, :valueType :db.type/string, :cardinality :db.cardinality/one} #:db{:ident :modelRequest/id, :valueType :db.type/string, :cardinality :db.cardinality/one} #:db{:ident :modelRequest/lexicon, :valueType :db.type/long, :cardinality :db.cardinality/one}]
