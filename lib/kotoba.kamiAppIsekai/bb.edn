;; babashka task runner for kami-app-isekai. Only `render-test` lives here — the CLJC
;; kernels/data themselves are exercised by `kbb -M:test` (see deps.edn), which stays
;; free of any dependency on the render pipeline below.
{:deps {
        ;; kotoba.image replaced java.awt.image.BufferedImage / javax.imageio here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/image {:git/sha "ed0b4dc89268073384c9493bdc80fa72dc17500b"}
        ;; kotoba.bytes replaced java.util.Base64 here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "72dde04b4c32854d70d17a670b277f8f7957a784"}
        ;; kotoba.pprint replaced clojure.pprint here (2026-09-24): the same
        ;; bytes (cljs.pprint transcribed). An explicit floor; tools.deps takes the
        ;; NEWEST sha it is shown.
        io.github.kotoba-lang/pprint {:git/sha "5c9d4aea71d6caac529fffcf361aba0f87ee485e"}
        ;; kotoba.process replaced clojure.java.shell here (2026-09-24). An explicit
        ;; floor: kotoba.process/sh parses clojure.java.shell's options from db49ea9,
        ;; and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/process {:git/sha "db49ea936e53d0bc698be0db79bf96ad86b5f7d0"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}}
 :tasks
 {render-test
  {:doc "Pixel-verified proof (real headless-Chromium WebGL2 readPixels, not just \"compiles\")
         that kami-app-isekai.voxel-world/terrain-height — the extracted terrain-height kernel,
         a 2-octave value-noise ridge that was previously extracted with zero rendering
         integration — actually draws as a real top-down heightmap through kotoba-lang/webgpu's
         kami.sprite-gpu (the same GPU-instanced-quad pipeline other kami-* repos already draw
         through). Needs a sibling checkout of kotoba-lang/webgpu (+ ITS sibling kotoba-lang/expr,
         for kotoba.expr) next to this repo — i.e. orgs/kotoba-lang/{kami-app-isekai,webgpu,expr},
         the same layout the west-managed superproject already checks these out in. Shells `bb`
         back out with :dir set to the webgpu sibling because kami.playwright's bridge script and
         the sprite-SDF GLSL fixtures it draws are read via cwd-relative paths there (matching
         every other playwright_*_test.clj in that repo) — see
         render-test/render_pixel_test.cljk for the render + assertions themselves."
   :task (babashka.process/shell
          {:dir "../webgpu"}
          "bb" "--classpath" "../kami-app-isekai/src:../kami-app-isekai/render-test:src:../expr/src"
          "-f" (str (System/getProperty "user.dir") "/render-test/render_pixel_test.cljk"))}

  ;; スライムハント (Slime Hunt) — the playable game (ADR pending). Two steps, both dev-only
  ;; (like render-test above, needs sibling checkouts next to this repo — see deps.edn's
  ;; :gen-scene/:cljs-game aliases for exactly which ones):
  ;;   bb slime-hunt-scene  — (re)bake public/games/slime-hunt/scene.edn from the composers
  ;;   bb slime-hunt-build  — compile dev/slime_hunt/game.cljk -> dev/out/game.js
  ;; then serve the repo root (e.g. `python3 -m http.server 8931`) and open game.html.
  slime-hunt-scene
  {:doc "Bake public/games/slime-hunt/scene.edn from kami.isekai.chargen/monsters/status +
         this repo's own voxel-world/heightmap-color terrain kernel (scripts/gen_scene.cljk)."
   :task (babashka.process/shell "kbb" "-M:gen-scene")}

  slime-hunt-build
  {:doc "Compile dev/slime_hunt/game.cljk -> dev/out/game.js (plain cljs.main, :simple
         optimizations, no shadow-cljs/npm — same dev-only build shape kami-app-character-
         creator's :cljs-app alias uses)."
   :task (babashka.process/shell "kbb" "-M:cljs-game")}}}
