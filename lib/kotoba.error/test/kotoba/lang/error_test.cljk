(ns kotoba.lang.error-test
  "kotoba.lang.error against the host class it names -- the oracle for
  scripts/migrate-clojure-lang-exceptioninfo-to-kotoba-error.cljk
  (com-junkawasaki/root), which rewrites `clojure.lang.ExceptionInfo` in
  catch / thrown? / thrown-with-msg? / instance? positions to this
  namespace and so needs every such position to answer the same.

  This file names clojure.lang.ExceptionInfo ON PURPOSE (the oracle); the
  codemod refuses a file that names both.

  Both directions: every positive corpus value is caught / answered true and
  every negative one is not, and a different predicate
  (`(some? (ex-data x))`) is shown to DISAGREE with the class on this host,
  so the agreement below is a measurement, not a tautology."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.error :as err]))

(defrecord NotAnError [data])

(def positives
  [(ex-info "plain" {})
   (ex-info "with data" {:k 1})
   (ex-info "with cause" {:k 2} (ex-info "inner" {}))
   #?(:cljs (ex-info "nil data" nil))])

(def negatives
  [nil "a string" :kw 42 {:data {:k 1}} (->NotAnError {:k 1})
   #?(:clj (Exception. "plain") :cljs (js/Error. "plain"))
   #?(:clj (RuntimeException. "rt") :cljs (js/TypeError. "type"))])

(deftest the-class-is-the-host-class
  (is (identical? err/ExceptionInfo #?(:clj clojure.lang.ExceptionInfo :cljs cljs.core/ExceptionInfo)))
  ;; kbb maps the JVM spelling onto the same class; the oracle below relies on it
  (is (identical? err/ExceptionInfo clojure.lang.ExceptionInfo)))

(deftest ex-info?-agrees-with-instance?-on-every-value
  (doseq [x (concat (remove nil? positives) negatives)]
    (is (= (instance? clojure.lang.ExceptionInfo x) (err/ex-info? x)) (pr-str x)))
  (testing "both directions are exercised"
    (is (= (count (remove nil? positives)) (count (filter err/ex-info? (remove nil? positives)))))
    (is (not-any? err/ex-info? negatives))))

(deftest a-different-predicate-disagrees
  ;; (some? (ex-data x)) is NOT the class test: on ClojureScript an ex-info
  ;; may carry nil data. Pins that the corpus can tell the two apart.
  #?(:cljs (let [nil-data (ex-info "nil data" nil)]
             (is (err/ex-info? nil-data))
             (is (not (some? (ex-data nil-data))))))
  ;; the JVM (Clojure 1.12) stores {} for nil data, so the two agree there
  #?(:clj (is (= {} (ex-data (ex-info "nil data" nil))))))

(defn- caught-by-error-class [thrown]
  (try (throw thrown)
       (catch err/ExceptionInfo e [:ex-info (ex-message e)])
       (catch #?(:clj Throwable :cljs :default) e [:other (if (string? e) e (ex-message e))])))

(deftest catch-clause-catches-exactly-ex-info
  (doseq [x (remove nil? positives)]
    (is (= :ex-info (first (caught-by-error-class x))) (ex-message x)))
  (doseq [x (remove nil? negatives)]
    (is (= :other (first (caught-by-error-class x))) (pr-str x)))
  (testing "a clause that does not match lets the throwable reach the next clause"
    (is (= [:other "plain"] (caught-by-error-class #?(:clj (Exception. "plain") :cljs (js/Error. "plain")))))))

(deftest thrown?-and-thrown-with-msg?-positions
  (is (thrown? err/ExceptionInfo (throw (ex-info "boom" {:k 1}))))
  (is (thrown-with-msg? err/ExceptionInfo #"bo+m" (throw (ex-info "boom" {:k 1}))))
  (testing "negative direction: a non-ex-info escapes thrown? (the host's own behaviour)"
    (is (= :escaped
           (try (let [_ (try (throw #?(:clj (Exception. "plain") :cljs (js/Error. "plain")))
                             (catch err/ExceptionInfo _ :swallowed))]
                  :not-thrown)
                (catch #?(:clj Throwable :cljs :default) _ :escaped))))))
