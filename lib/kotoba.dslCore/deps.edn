{:paths ["src"]
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/process {:local/root "../kotoba.process"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; kotoba-lang/amu is a TEST-ONLY dependency, for the parity gate
         ;; that compiles src/kotoba/dsl/problem.kotoba and requires it to agree
         ;; with src/kotoba/dsl/problem.cljk (ADR 0001 as amended, and
         ;; ADR-2608130900 in com-junkawasaki/root). Consumers require only the
         ;; .cljc and must not be made to drag the compiler in behind it —
         ;; kotoba-lang/css sets the same boundary.
         :extra-deps {
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "c3be07fb38bf457a159a2b304152e18693f9b0b6"}}}
}}
