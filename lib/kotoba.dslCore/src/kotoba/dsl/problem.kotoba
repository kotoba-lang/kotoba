(ns kotoba.dsl.problem
  (:export [main severities domain-key problem problem-field severity error? warning? errors warnings valid?]))

(defn main [] :i64 0)

(defn fail-document [] :document
  (document-vector-assoc (document-vector) 0 (document-null)))

(defn fail-keyword [] :keyword
  (option-or (document-keyword-value (fail-document)) :invalid))

(defn required-at [value :document index :i64] :document
  (option-or (document-vector-at value index) (fail-document)))

(defn required-document [value :document key :keyword] :document
  (option-or (document-get value key) (fail-document)))

(defn required-keyword [value :document] :keyword
  (option-or (document-keyword-value value) (fail-keyword)))

(defn severities [] [:set :keyword]
  (typed-set [:set :keyword] :error :warn))

(defn supported-severity? [value :keyword] :bool
  (if (or (= value :error) (= value :warn)) true false))

(defn domain-key [domain :keyword key :keyword] :keyword
  (keyword-from-string
    (string-concat
      (string-concat (keyword-name domain) "/")
      (keyword-name key))))

(defn problem-field
  [domain :keyword severity-value :keyword code :keyword subject-field :document msg :string] :document
  (if (supported-severity? severity-value)
    (let [subject-key (required-keyword (required-at subject-field 0))
          subject (required-at subject-field 1)]
      (document-map
        (domain-key domain :severity) (document-keyword severity-value)
        (domain-key domain :code) (document-keyword code)
        (domain-key domain subject-key) subject
        (domain-key domain :msg) (document-string msg)))
    (fail-document)))

(defn problem
  [domain :keyword severity-value :keyword code :keyword subject :document msg :string] :document
  (problem-field domain severity-value code
    (document-vector (document-keyword :id) subject) msg))

(defn severity [domain :keyword value :document] :keyword
  (required-keyword
    (required-document value (domain-key domain :severity))))

(defn has-severity? [domain :keyword value :document wanted :keyword] :bool
  (let [key (domain-key domain :severity)]
    (if (document-contains value key)
      (if (= wanted (required-keyword (required-document value key))) true false)
      false)))

(defn error? [domain :keyword value :document] :bool
  (has-severity? domain value :error))

(defn warning? [domain :keyword value :document] :bool
  (has-severity? domain value :warn))

(defn select-severity-from
  [domain :keyword problems :document wanted :keyword index :i64 output :document] :document
  (if (< index (document-count problems))
    (let [current (required-at problems index)]
      (select-severity-from domain problems wanted (+ index 1)
        (if (has-severity? domain current wanted)
          (document-vector-conj output current)
          output)))
    output))

(defn errors [domain :keyword problems :document] :document
  (select-severity-from domain problems :error 0 (document-vector)))

(defn warnings [domain :keyword problems :document] :document
  (select-severity-from domain problems :warn 0 (document-vector)))

(defn valid? [domain :keyword problems :document] :bool
  (if (= 0 (document-count (errors domain problems))) true false))
