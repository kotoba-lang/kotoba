{:paths ["src"]
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/process {:local/root "../kotoba.process"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; kotoba-lang/amu is a TEST-ONLY dependency: it is needed by the
         ;; tests that compile src/kotoba/replicator.kotoba and require it to agree
         ;; with src/kotoba/replicator.cljk (ADR 0001 as amended, and ADR-2608134800
         ;; in com-junkawasaki/root). Consumers require only the .cljc and must not
         ;; be made to drag the compiler in behind it — kotoba-lang/css, /dsl-core,
         ;; /async and /postfx set the same boundary.
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "abf9e5b8125040b1c32956ed5af133f5f962298b"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
