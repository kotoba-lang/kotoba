;; kotoba.artifact.source-identity -- SourceCID in pure Kotoba.
;;
;; root ADR-2610082200 §16 (W1). kotoba.artifact.content-identity
;; (content_identity.cljk) keeps all four identities and stays the oracle. Of
;; them, SourceCID -- the raw-multicodec CIDv1 of the exact source bytes -- needs
;; only a sha2-256 and CIDv1 assembly, so it moves first: the digest from the
;; hash/sha256 capability (wire id 3; a guest declares [:cap/call 3]) and the
;; assembly from multiformats.cid (kotoba-lang/io-multiformats, pure).
;;
;; BuildCID and ArtifactCID address closed DAG-CBOR nodes built from arbitrary
;; Kotoba values. A guest cannot enumerate a document's keys today (the language
;; has document-get / document-kind but no traversal), so a general DAG-CBOR
;; encoder is not expressible yet; those two stay in the oracle (see
;; migration/source-identity-v1.edn).
;;
;; Only the bytes form is exported. A program may use one request type per
;; capability id: a module calling hash/sha256 with both :bytes and :string is
;; refused at link time ("typed capability id has conflicting contracts",
;; measured 2026-10-09). SourceCID addresses the exact bytes, so bytes it is.

(ns kotoba.artifact.source-identity
  (:require [multiformats.cid :as cid])
  (:export [source-cid]))

(defn source-cid [bytes :bytes] :string
  (cid/cidv1 85 (hash/sha256 bytes)))
