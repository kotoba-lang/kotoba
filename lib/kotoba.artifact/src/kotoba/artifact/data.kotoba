;; Compiler/build metadata is a typed Form tree, not a language :document.
;; The guest document limits stay unchanged. Typed-list/value/arena bounds
;; still apply, including the 8 MiB string/bytes value bound.
(ns kotoba.artifact.data
  (:require [kotoba.form :as form])
  (:schemas {:artifact.data/stats
             [:record :artifact.data/stats [[:nodes :i64] [:payload :i64] [:ok :bool]]]}))

(defn value-null [] [:ref :form/r] (form/nil-form))
(defn value-bool [value :bool] [:ref :form/r] (form/bool-form value))
(defn value-i64 [value :i64] [:ref :form/r] (form/int-form value))
(defn value-string [value :string] [:ref :form/r] (form/string-form value))
(defn value-keyword [value :keyword] [:ref :form/r] (form/keyword-form value))
(defn value-symbol [value :string] [:ref :form/r]
  (form/symbol-form (document-edn-print (document-symbol (symbol value)))))
(defn value-bytes [value :bytes] [:ref :form/r] (form/bytes-form value))
(defn value-vector [] [:ref :form/r] (form/form-vec (form/no-forms)))
(defn value-list [] [:ref :form/r] (form/form-seq (form/no-forms)))
(defn value-set [] [:ref :form/r] (form/form-set (form/no-forms)))
(defn value-map [] [:ref :form/r] (form/form-map (form/no-forms)))
(defn value-kind [value [:ref :form/r]] :keyword
  (case (form/tag-of value) 0 :null 1 :bool 2 :i64 3 :string 4 :keyword
    5 :symbol 6 :list 7 :vector 8 :set 9 :map 10 :f64 11 :bytes :unknown))
(defn value-count [value [:ref :form/r]] :i64
  (if (form/is-map? value) (quot (form/count-of value) 2) (form/count-of value)))
(defn value-equal? [left [:ref :form/r] right [:ref :form/r]] :bool (form/eq left right))
(defn- invalid [] :i64 (vector-at [0] 1))
(defn- invalid-form [] [:ref :form/r] (value-i64 (invalid)))

(defn value-vector-conj [value [:ref :form/r] item [:ref :form/r]] [:ref :form/r]
  (if (not (form/is-vec? value)) (invalid-form)
    (form/form-vec (form/append-form (form/kids-of value) item))))
(defn value-list-conj [value [:ref :form/r] item [:ref :form/r]] [:ref :form/r]
  (if (not (form/is-seq? value)) (invalid-form)
    (form/form-seq (form/append-form (form/kids-of value) item))))
(defn value-set-contains? [value [:ref :form/r] item [:ref :form/r]] :bool
  (if (not (form/is-set? value)) (= (invalid) 0)
    (loop [index 0]
      (if (= index (form/count-of value)) false
        (if (value-equal? (form/nth-of value index) item) true (recur (+ index 1)))))))
(defn value-set-conj [value [:ref :form/r] item [:ref :form/r]] [:ref :form/r]
  (if (value-set-contains? value item) value
    (form/form-set (form/append-form (form/kids-of value) item))))
(defn value-as-vector [value [:ref :form/r]] [:ref :form/r]
  (if (or (form/is-set? value) (form/is-seq? value) (form/is-vec? value))
    (form/form-vec (form/kids-of value)) (invalid-form)))
(defn- at [value [:ref :form/r] index :i64] [:option [:ref :form/r]]
  (if (or (< index 0) (>= index (form/count-of value)))
    (option-none-of [:option [:ref :form/r]])
    (option-some-of [:option [:ref :form/r]] (form/nth-of value index))))
(defn value-vector-at [value [:ref :form/r] index :i64] [:option [:ref :form/r]]
  (if (form/is-vec? value) (at value index)
    (option-some-of [:option [:ref :form/r]] (invalid-form))))
(defn value-list-at [value [:ref :form/r] index :i64] [:option [:ref :form/r]]
  (if (form/is-seq? value) (at value index)
    (option-some-of [:option [:ref :form/r]] (invalid-form))))
(defn value-map-entry-at [value [:ref :form/r] index :i64] [:option [:ref :form/r]]
  (if (not (form/is-map? value))
    (option-some-of [:option [:ref :form/r]] (invalid-form))
    (if (or (< index 0) (>= index (value-count value)))
      (option-none-of [:option [:ref :form/r]])
      (option-some-of [:option [:ref :form/r]]
        (form/vec2 (form/nth-of value (* index 2)) (form/nth-of value (+ (* index 2) 1)))))))
(defn value-contains [value [:ref :form/r] key [:ref :form/r]] :bool
  (if (form/is-map? value) (form/form-has? value key) (= (invalid) 0)))
(defn value-get [value [:ref :form/r] key [:ref :form/r]] [:option [:ref :form/r]]
  (if (value-contains value key) (option-some-of [:option [:ref :form/r]] (form/form-get value key))
    (option-none-of [:option [:ref :form/r]])))
(defn value-assoc [value [:ref :form/r] key [:ref :form/r] item [:ref :form/r]] [:ref :form/r]
  (if (not (form/is-map? value)) (invalid-form)
    ;; Metadata construction is deterministic across insertion order. The
    ;; runtime slot/ABI maps have keyword keys, matching their previous order.
    (let [text (value-edn-print key) existing? (value-contains value key)]
      (loop [index 0 inserted false out (form/no-forms)]
        (if (= index (form/count-of value))
          (form/form-map (if inserted out (form/append-form (form/append-form out key) item)))
          (let [old-key (form/nth-of value index) old-value (form/nth-of value (+ index 1))]
            (cond
              (value-equal? old-key key)
              (recur (+ index 2) true (form/append-form (form/append-form out key) item))
              (and (not existing?) (not inserted) (< (string-compare text (value-edn-print old-key)) 0))
              (recur index true (form/append-form (form/append-form out key) item))
              :else (recur (+ index 2) inserted (form/append-form (form/append-form out old-key) old-value)))))))))
(defn value-map-insert [value [:ref :form/r] key [:ref :form/r] item [:ref :form/r]] [:ref :form/r]
  (if (value-contains value key) (invalid-form) (value-assoc value key item)))
(defn value-dissoc [value [:ref :form/r] key [:ref :form/r]] [:ref :form/r]
  (if (form/is-map? value) (form/dissoc-form value key) (invalid-form)))
(defn value-merge [left [:ref :form/r] right [:ref :form/r]] [:ref :form/r]
  (if (or (not (form/is-map? left)) (not (form/is-map? right))) (invalid-form)
    (loop [index 0 out left]
      (if (= index (form/count-of right)) out
        (recur (+ index 2) (value-assoc out (form/nth-of right index) (form/nth-of right (+ index 1))))))))
(defn value-vector-remove [value [:ref :form/r] index :i64] [:ref :form/r]
  (if (or (not (form/is-vec? value)) (< index 0) (>= index (value-count value))) (invalid-form)
    (loop [at 0 out (form/no-forms)]
      (if (= at (value-count value)) (form/form-vec out)
        (recur (+ at 1) (if (= at index) out (form/append-form out (form/nth-of value at))))))))
(defn value-string-value [value [:ref :form/r]] [:option :string]
  (if (form/is-string? value) (option-some-of [:option :string] (form/string-value value))
    (option-none-of [:option :string])))
(defn value-keyword-value [value [:ref :form/r]] [:option :keyword]
  (if (form/is-keyword? value) (option-some-of [:option :keyword] (form/keyword-value value))
    (option-none-of [:option :keyword])))
(defn value-i64-value [value [:ref :form/r]] [:option :i64]
  (if (form/is-int? value) (option-some-of [:option :i64] (form/int-value value))
    (option-none-of [:option :i64])))
(defn value-bool-value [value [:ref :form/r]] [:option :bool]
  (if (form/is-bool? value) (option-some-of [:option :bool] (form/bool-value value))
    (option-none-of [:option :bool])))
(defn value-bytes-value [value [:ref :form/r]] [:option :bytes]
  (if (form/is-bytes? value) (option-some-of [:option :bytes] (form/bytes-of value))
    (option-none-of [:option :bytes])))

;; Render only metadata, never evaluate it. Allocate one fresh hex buffer so
;; multi-megabyte native code does not create a string prefix for every byte.
(defn- hex-digit [n :i64] :i64 (if (< n 10) (+ 48 n) (+ 87 n)))
(defn- bytes-text [value :bytes] :string
  (let [size (bytes-count value) prefix "#kotoba/bytes \""
        out (loop [i 0 v (vector-alloc (+ 16 (* 2 size)))]
              (if (= i 15) v (recur (+ i 1) (vector-assoc! v i (string-code-point-at prefix i)))))]
    (loop [i 0 v out]
      (if (= i size) (string-from-utf8 (bytes-from-vector-i64 (vector-assoc! v (+ 15 (* 2 size)) 34)))
        (let [byte (bytes-at value i) offset (+ 15 (* 2 i))]
          (recur (+ i 1) (vector-assoc! (vector-assoc! v offset (hex-digit (quot byte 16)))
                            (+ offset 1) (hex-digit (bit-and byte 15)))))))))
(defn- quote-text [text :string] :string
  ;; The scalar document conversion is deliberately bounded. Large source
  ;; text belongs in bytes/chunks; metadata keys and paths remain small.
  (if (> (string-byte-length text) 65536) (string-from-i64 (invalid))
    (document-edn-print (document-string text))))
(defn- children-text [value [:ref :form/r] open :string close :string] :string
  (loop [index 0 text open]
    (if (= index (form/count-of value)) (string-concat text close)
      (recur (+ index 1) (string-concat text
        (string-concat (if (= index 0) "" " ") (value-edn-print (form/nth-of value index))))))))
(defn value-edn-print [value [:ref :form/r]] :string
  (case (value-kind value)
    :null "nil" :bool (if (form/bool-value value) "true" "false")
    :i64 (string-from-i64 (form/int-value value))
    :string (quote-text (form/string-value value))
    :keyword (document-edn-print (document-keyword (form/keyword-value value)))
    :symbol (form/symbol-value value)
    :bytes (bytes-text (form/bytes-of value))
    :vector (children-text value "[" "]") :list (children-text value "(" ")")
    :set (children-text value "#{" "}") :map (children-text value "{" "}")
    (string-from-i64 (invalid))))

;; Explicit checked bridge for the owning object encoder's small header
;; records. Compiler metadata never goes through this language-value bridge.
(defn- document-stats [value [:ref :form/r] depth :i64] [:ref :artifact.data/stats]
  (let [k (value-kind value) children (form/kids-of value)
        payload (if (= k :bytes) (bytes-count (form/bytes-of value))
                  (if (or (= k :string) (= k :symbol)) (string-byte-length (form/string-value value))
                    (if (= k :keyword) (string-byte-length (document-edn-print (document-keyword (form/keyword-value value)))) 0)))
        collection (or (= k :map) (= k :vector) (= k :list) (= k :set))]
    (loop [index 0 nodes 1 total payload valid (and (<= depth 8) (<= payload 65536)
                                              (or (not collection) (<= (value-count value) 32)))]
      (if (= index (vector-count children))
        (record-new [:ref :artifact.data/stats] nodes total (and valid (<= nodes 4096) (<= total 65536)))
        (let [child (document-stats (typed-list-nth [:list [:ref :form/r]] children index) (+ depth 1))]
          (recur (+ index 1) (+ nodes (record-get [:ref :artifact.data/stats] child :nodes))
            (+ total (record-get [:ref :artifact.data/stats] child :payload))
            (and valid (record-get [:ref :artifact.data/stats] child :ok))))))))
(defn value-to-document [value [:ref :form/r]] :document
  (if (record-get [:ref :artifact.data/stats] (document-stats value 0) :ok)
    (document-edn-read (value-edn-print value))
    (document-i64 (invalid))))
