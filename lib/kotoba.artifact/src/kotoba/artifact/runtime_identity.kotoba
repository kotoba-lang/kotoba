;; kotoba.artifact.runtime-identity -- canonical literal leaf.
;;
;; AWAI-47: port the fixed lowercase SHA-256 hex predicate from the legacy
;; runtime identity module. This is a source slice only. The legacy module's
;; loader identity, admission, validation, and capability behavior remain
;; unported and must not be inferred from this predicate.

(ns kotoba.artifact.runtime-identity
  (:export [sha256?]))

(defn- ascii-digit? [byte :i64] :bool
  (and (>= byte 48) (<= byte 57)))

(defn- ascii-lower-hex? [byte :i64] :bool
  (or (ascii-digit? byte) (and (>= byte 97) (<= byte 102))))

(defn sha256? [value :string] :bool
  (if (not (= (string-byte-length value) 64)) false
    (let [bytes (string-to-utf8 value)]
      (loop [index 0]
        (if (= index 64) true
          (if (ascii-lower-hex? (bytes-at bytes index))
            (recur (+ index 1)) false))))))
