;; kotoba.artifact.runtime-identity -- canonical literal leaf.
;;
;; AWAI-47: port the fixed lowercase SHA-256 hex predicate from the legacy
;; runtime identity module. This is a source slice only. The legacy module's
;; loader identity, admission, validation, and capability behavior remain
;; unported and must not be inferred from this predicate.

(ns kotoba.artifact.runtime-identity
  (:export [sha256? posix-loader-source-sha256 windows-loader-source-sha256]))

;; These values preserve the legacy native-loader source pins. The POSIX pin
;; was measured from tools/kexe_loader.c on the Amu main merge of PR #1427.
;; The Windows pin was cross-compiled but not run on the original host.
(defn posix-loader-source-sha256 [] :string
  "d21ddf0396da35799702f88c90838d8c79d770458671361847fe237cce8f6f3f")

(defn windows-loader-source-sha256 [] :string
  "667418ba74336ab3a0012be4eacf0a9539cb8de242f662cc7617415055e9d716")

;; Private while the single-file export surface refuses this option result;
;; cross-module project-link callability remains unqualified.
(defn- loader-source-for-os [os :string] [:option :string]
  (cond
    (string=? os "windows")
      (option-some-of [:option :string] (windows-loader-source-sha256))
    (or (string=? os "linux") (string=? os "macos"))
      (option-some-of [:option :string] (posix-loader-source-sha256))
    :else (option-none-of [:option :string])))

(defn- ascii-digit? [byte :i64] :bool
  (and (>= byte 48) (<= byte 57)))

(defn- ascii-lower-hex? [byte :i64] :bool
  (or (ascii-digit? byte) (and (>= byte 97) (<= byte 102))))

(defn sha256? [value :string] :bool
  (if (not (= (string-byte-length value) 64)) false
    (let [bytes (string-to-utf8 value)]
      (loop [index 0]
        (if (= index 64) true
          (if (ascii-lower-hex? (bytes-at bytes index))
            (recur (+ index 1)) false))))))
