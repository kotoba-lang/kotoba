(ns execution-v2-test
  (:require #?(:clj [kotoba.test :refer [deftest is]]
               :cljs [cljs.test :refer [deftest is]])
            [kotoba.artifact.execution :as blocks]
            [kotoba.core.execution :as execution]
            [kotoba.abi.target :as target]))

(def cid "bafkreid4qjrk54dtbrpa4zx3b2umgsvevohcm7z436igajsdd34khleu2q")
(defn refused? [f]
  (try (f) false (catch #?(:clj Exception :cljs :default) _ true)))
(defn expected [target-id]
  (let [physical (get target/profiles target-id)]
    {:target target-id :profile :sync :artifact-cid cid :interface-cid cid
     :runtime-identity cid
     :layout (if (= :component (:family physical))
               {:component-cid cid :wit-world-cid cid :wasi-version "0.3.0"}
               (cond-> (:layout physical) (seq (:context-versions physical)) (assoc :context-version 11)))}))
(defn binding [context]
  (blocks/binding-block (:target context) (:profile context) (:artifact-cid context)
                        (:interface-cid context) (:runtime-identity context) (:layout context)))
(defn intent [binding-record]
  (assoc (zipmap execution/execution-intent-keys (repeat cid))
         :format :kotoba.execution-intent/v2 :grant-cids [cid] :approval-cids []
         :profile-binding-cid (:cid binding-record)))

(deftest each-target-binds-canonical-physical-contract
  (doseq [target-id (keys target/profiles)]
    (let [context (expected target-id) record (binding context)
          descriptor (blocks/verify-binding record context)]
      (is (= target-id (:target descriptor)))
      (is (= (:cid record) (:cid (blocks/block :binding (into {} (reverse descriptor))))))
      (doseq [k [:target :profile :artifact-cid :interface-cid :runtime-identity :layout]]
        (is (refused? #(blocks/verify-binding record (assoc context k nil)))))
      (is (refused? #(blocks/verify-block :intent record)))
      (is (refused? #(blocks/verify-block :binding (assoc record :verified true))))
      (is (refused? #(blocks/verify-binding
                     (blocks/block :binding (assoc descriptor :profile-contract-cid cid)) context))))))

(deftest changed-bytes-and-cid-are-not-evidence
  (let [a (blocks/block :input {:value 1}) b (blocks/block :input {:value 2})]
    (is (= {:value 1} (blocks/verify-block :input a)))
    (is (not= (:cid a) (:cid b)))
    (is (refused? #(blocks/verify-block :input (assoc a :bytes (:bytes b)))))
    (is (refused? #(blocks/verify-block :input (assoc a :cid (:cid b)))))
    (is (refused? #(blocks/block :unknown {})))
    (is (refused? #(blocks/block :input (apply str (repeat 65537 "x")))))))

(deftest issuance-and-completion-have-distinct-cids
  (let [context (expected :aarch64-kotoba-v1) b (binding context)
        i (blocks/intent-block b context (intent b))
        outcome (blocks/block :outcome {:value 42})
        body {:format :kotoba.execution-receipt/v2 :intent-cid (:cid i)
              :profile-binding-cid (:cid b) :artifact-cid cid :runtime-identity cid
              :outcome-cid (:cid outcome) :status :ok :sequence 0}
        receipt (blocks/block :receipt body)
        completed (blocks/complete-identity i outcome [receipt])]
    (is (not= (:cid i) (:cid completed)))
    (is (= (:cid outcome) (:outcome-cid (blocks/verify-block :identity completed))))
    (is (refused? #(blocks/complete-identity i outcome [])))
    (is (refused? #(blocks/complete-identity i outcome [receipt receipt])))
    (doseq [k [:intent-cid :profile-binding-cid :artifact-cid :runtime-identity :outcome-cid]]
      (is (refused? #(blocks/complete-identity i outcome
                                               [(blocks/block :receipt (assoc body k (:cid completed)))]))))
    (is (refused? #(blocks/block :receipt (assoc body :status :maybe))))
    (is (refused? #(blocks/block :receipt (assoc body :signature "fake"))))))

(deftest leases-never-become-component-or-bearer-descriptors
  (let [context (expected :js-kotoba-v1) b (binding context)
        i (blocks/intent-block b context (intent b))
        lease {:format :kotoba.capability-lease/v2 :capability-cid cid
               :execution-identity-cid (:cid i) :artifact-cid cid
               :profile-binding-cid (:cid b) :resource-cid cid :purpose :audit/append
               :expires-at "2026-10-11T01:00:00Z" :uses 1 :transfer :non-transferable
               :delegation-depth 0}]
    (is (= lease (blocks/verify-block :lease (blocks/lease-block i lease))))
    (doseq [[k v] [[:execution-identity-cid cid] [:artifact-cid (:cid i)]
                  [:profile-binding-cid cid] [:host-handle "42"] [:component-cid cid]]]
      (is (refused? #(blocks/lease-block i (assoc lease k v)))))))
