(ns artifact.form-canonical-parity
  (:require [kotoba.artifact.data :as meta]
            [kotoba.artifact.form-seal :as typed]
            [kotoba.artifact.core :as original])
  (:export [main]))

(defn- bytes=? [left :bytes right :bytes] :bool
  (and (= (bytes-count left) (bytes-count right))
    (loop [index 0]
      (if (= index (bytes-count left)) true
        (if (= (bytes-at left index) (bytes-at right index)) (recur (+ index 1)) false)))))
(defn- sample [index :i64] [:ref :form/r]
  (case index
    0 (-> (meta/value-map)
          (meta/value-map-insert (meta/value-keyword :b) (meta/value-string "x"))
          (meta/value-map-insert (meta/value-keyword :a)
            (-> (meta/value-vector) (meta/value-vector-conj (meta/value-i64 2))
                                   (meta/value-vector-conj (meta/value-i64 1)))))
    1 (-> (meta/value-map)
          (meta/value-map-insert (meta/value-keyword :a/b) (meta/value-i64 1))
          (meta/value-map-insert (meta/value-symbol "a/*x*") (meta/value-i64 2)))
    2 (-> (meta/value-set) (meta/value-set-conj (meta/value-i64 3))
                          (meta/value-set-conj (meta/value-i64 1)))
    3 (-> (meta/value-list) (meta/value-list-conj (meta/value-i64 1))
                           (meta/value-list-conj (meta/value-i64 2)))
    (meta/value-bytes (bytes-from-vector-i64 [0 255 16]))))
(defn- expected [index :i64] :string
  (case index 0 "{:a [2 1], :b \"x\"}" 1 "#:a{:b 1, *x* 2}"
    2 "[1 3]" 3 "[1 2]" "#kotoba/bytes \"00ff10\""))
(defn main [] :i64
  (loop [index 0]
    (if (= index 5) 0
      (let [value (sample index)
            actual (typed/canonical-bytes value)
            old (original/canonical-bytes (meta/value-to-document value))]
        (if (and (bytes=? actual old) (bytes=? actual (string-to-utf8 (expected index))))
          (recur (+ index 1)) (+ index 1))))))
