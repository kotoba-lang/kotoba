(ns artifact.native-metadata
  (:require [kotoba.artifact.data :as meta]
            [kotoba.form :as form])
  (:export [main]))

;; Compiler metadata has its own typed tree. A 51-field ABI is not a guest
;; document and does not change the guest's 32-item document container bound.
(defn main [] :i64
  (let [large (loop [index 0 out (meta/value-map)]
                (if (= index 51) out
                  (recur (+ index 1)
                    (meta/value-map-insert out (meta/value-i64 index) (meta/value-i64 index)))))
        left (meta/value-bytes (bytes-from-vector-i64 [0 255 16]))
        same (meta/value-bytes (bytes-from-vector-i64 [0 255 16]))
        changed (meta/value-bytes (bytes-from-vector-i64 [0 254 16]))
        shorter (meta/value-bytes (bytes-from-vector-i64 [0 255]))
        key (meta/value-keyword :code)
        a (meta/value-map-insert (meta/value-map) key left)
        b (meta/value-map-insert (meta/value-map) key changed)
        unsorted (form/form-map (form/append-many (form/two-forms
                     (meta/value-keyword :z) (meta/value-i64 1))
                     (form/two-forms (meta/value-keyword :a) (meta/value-i64 2))))
        replaced (meta/value-assoc unsorted (meta/value-keyword :a) (meta/value-i64 9))]
    (if (and (= (meta/value-count large) 51)
             (meta/value-equal? left same) (not (meta/value-equal? left changed))
             (not (meta/value-equal? left shorter)) (not (meta/value-equal? a b))
             (= (meta/value-count replaced) 2)
             (meta/value-equal? (option-value-of [:option [:ref :form/r]]
                (meta/value-get replaced (meta/value-keyword :a)) (meta/value-null)) (meta/value-i64 9))
             (string=? (meta/value-edn-print left) "#kotoba/bytes \"00ff10\"")) 0 1)))
