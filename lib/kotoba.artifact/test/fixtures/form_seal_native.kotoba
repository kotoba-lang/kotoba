(ns artifact.form-seal-native
  (:require [kotoba.artifact.data :as meta]
            [kotoba.artifact.form-seal :as seal])
  (:capabilities #{:hash/sha256})
  (:export [main]))

(defn main [] :i64
  (let [empty-hash (typed-cap-call :hash/sha256 :string :string "")
        abc-hash (typed-cap-call :hash/sha256 :string :string "abc")
        source (-> (meta/value-map)
                   (meta/value-map-insert (meta/value-keyword :format) (meta/value-keyword :fixture/v1))
                   (meta/value-map-insert (meta/value-keyword :code)
                     (meta/value-bytes (bytes-from-vector-i64 [0 255 16]))))
        signed (seal/seal source)
        changed (meta/value-assoc signed (meta/value-keyword :code)
                    (meta/value-bytes (bytes-from-vector-i64 [0 254 16])))]
    (if (and (string=? empty-hash "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
             (string=? abc-hash "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
             (seal/valid-seal? signed) (not (seal/valid-seal? changed))) 0 1)))
