(ns artifact-test
  (:require #?(:clj  [kotoba.test :refer [deftest is]]
               :cljs [cljs.test :refer [deftest is] :include-macros true])
            [kotoba.artifact.core :as artifact]
            [kotoba.artifact.runtime-identity :as runtime]
            [kotoba.kir.target :as target]))

;; Load gate: the split must not break namespace resolution. Each extracted
;; namespace must load standalone from this repo's own dependency closure.
(deftest every-extracted-namespace-loads
  (is (some? (find-ns 'kotoba.artifact.core)) "kotoba.artifact.core must load")
  (is (some? (find-ns 'kotoba.artifact.runtime-identity)) "kotoba.artifact.runtime-identity must load"))

(deftest canonical-seals-ignore-map-and-set-order-and-detect-tampering
  (let [left {:payload {:b 2 :a 1} :effects #{:write :read}}
        right {:effects #{:read :write} :payload (array-map :a 1 :b 2)}
        sealed (artifact/seal left)]
    (is (= (artifact/sha256 left) (artifact/sha256 right)))
    (is (artifact/valid-seal? sealed))
    (is (false? (artifact/valid-seal? (assoc-in sealed [:payload :a] 9))))))

(deftest native-profile-change-requires-new-identity-and-explicit-trust
  (let [profile (first (filter #(and (= :native (:execution %))
                                    (= :macos (:os %))) (vals target/profiles)))
        digest (apply str (repeat 64 "a"))
        identity {:format :kotoba.native-runtime/v6 :target-profile profile
                  :loader-source-sha256 runtime/loader-source-sha256
                  :loader-binary-sha256 digest :compiler-binary-sha256 digest
                  :compiler-version-sha256 digest :assembler-binary-sha256 digest
                  :linker-binary-sha256 digest :compiler-resource-sha256 digest
                  :system-header-closure-sha256 digest}
        old (assoc identity :loader-source-sha256
                   "67d66c3dd8aabcc81d301d9c44be23b590f3df5b2d75924e6b5ba78759308bfa")
        refused? (fn [f] (try (f) false (catch #?(:clj Exception :cljs :default) _ true)))
        id (runtime/identity-sha256 identity)]
    (is (some? profile))
    (is (= identity (runtime/validate! identity)))
    (is (refused? #(runtime/validate! old)))
    (is (refused? #(runtime/admit! identity {:trusted-runtime-sha256 #{}})))
    (is (= {:runtime-sha256 id :trusted? true}
           (runtime/admit! identity {:trusted-runtime-sha256 #{id}})))
    (is (refused? #(runtime/admit! identity {:trusted-runtime-sha256 #{id}
                                           :revoked-runtime-sha256 #{id}})))))
