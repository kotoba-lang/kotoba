(ns kotobase-peer.policy-authority-test
  "Equivalence of `policy/clearance-rank` before and after it moved onto
  kotoba-lang/authority (root adr-2609241800 step 7).

  `legacy-clearance-rank` below is the pre-authority implementation copied
  VERBATIM from src/kotobase_peer/policy.cljk at 575901df (lines 87-97): the
  local `starts-with?` over `kotoba://can/datom:read-classified/`. It is the
  oracle, kept here so the equivalence stays checkable after the src copy is
  gone. Every row of `cases` runs through both and must agree, and each row
  also pins the expected rank so an oracle that drifted with the src would
  still be caught."
  (:require #?(:clj [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.lang.text :as str]
            [kotoba.security.information-flow :as flow]
            [kotobase-peer.policy :as policy]))

(def ^:private top-rank (apply max (vals flow/ranks)))

(defn- legacy-clearance-rank
  "VERBATIM oracle -- see the ns docstring. Do not edit."
  [caps]
  (let [caps (set caps)]
    (if (contains? caps policy/read-protected-capability)
      top-rank
      (reduce (fn [best cap]
                (if (str/starts-with? (or cap "") policy/read-classified-capability-prefix)
                  (let [label (keyword (subs cap (count policy/read-classified-capability-prefix)))]
                    (max best (get flow/ranks (or (flow/canonical label) :public) 0)))
                  best))
              0
              caps))))

(def ^:private rc policy/read-classified-capability-prefix)

(def cases
  "[description caps expected-rank]"
  [["no caps" [] 0]
   ["nil caps" nil 0]
   ["public" [(str rc "public")] 0]
   ["internal" [(str rc "internal")] 1]
   ["confidential" [(str rc "confidential")] 2]
   ["personal ranks as confidential" [(str rc "personal")] 2]
   ["restricted" [(str rc "restricted")] 3]
   ["legacy read-protected is top" [policy/read-protected-capability] 3]
   ["legacy beside a low grant" [policy/read-protected-capability (str rc "internal")] 3]
   ["highest of several wins" [(str rc "internal") (str rc "confidential") (str rc "public")] 2]
   ["unknown label coerces down" [(str rc "administrator")] 0]
   ["nonsense label" [(str rc "nonsense")] 0]
   ["label is case-sensitive" [(str rc "RESTRICTED")] 0]
   ["empty label (trailing slash)" [rc] 0]
   ["prefix without its slash" ["kotoba://can/datom:read-classified"] 0]
   ["wildcard label" [(str rc "*")] 0]
   ["label with trailing star" [(str rc "restricted*")] 0]
   ["two segments under the prefix" [(str rc "restricted/x")] 0]
   ["label then trailing slash" [(str rc "restricted/")] 0]
   ["double slash before label" [(str rc "/restricted")] 0]
   ["prefix confusion: longer segment" ["kotoba://can/datom:read-classifiedX/restricted"] 0]
   ["prefix confusion: shorter segment" ["kotoba://can/datom:read-classifie/restricted"] 0]
   ["other scheme" ["kotoba-x://can/datom:read-classified/restricted"] 0]
   ["scheme case" ["KOTOBA://can/datom:read-classified/restricted"] 0]
   ["can wildcard grants no clearance" ["kotoba://can/*"] 0]
   ["datom wildcard grants no clearance" ["kotoba://can/datom:*"] 0]
   ["read-protected wildcard is not read-protected" ["kotoba://can/datom:read-protected/*"] 0]
   ["plain read cap" [policy/read-capability] 0]
   ["transact + admin caps" [policy/transact-capability policy/policy-admin-capability] 0]
   ["nil element" [nil] 0]
   ["nil element beside a grant" [nil (str rc "confidential")] 2]
   ["keyword element" [:kotoba/can] 0]
   ["number element" [42] 0]
   ["unrelated uri" ["https://example.com/datom:read-classified/restricted"] 0]
   ["graph scheme" ["kotoba://graph/alice"] 0]
   ["duplicates collapse" [(str rc "internal") (str rc "internal")] 1]])

(deftest oracle-and-authority-decider-agree-on-every-case
  (doseq [[desc caps expected] cases]
    (testing desc
      (is (= expected (legacy-clearance-rank caps)) "oracle pins the table")
      (is (= expected (policy/clearance-rank caps)) "authority decider matches the table")
      (is (= (legacy-clearance-rank caps) (policy/clearance-rank caps))
          "old and new agree"))))

(deftest the-grant-is-a-scope-in-the-authority-lattice
  (is (= ["kotoba" "can" "datom:read-classified" :*] policy/read-classified-scope)
      "the per-level read grant is decided as an authority.scope, not a string prefix"))

(deftest the-only-divergence-is-a-symbol-that-used-to-throw
  ;; `str/starts-with?` stringifies its argument, so a SYMBOL spelled like a
  ;; grant passed the old prefix test and then threw in `subs`. The authority
  ;; decider parses strings only, so the same input grants nothing. Recorded
  ;; rather than hidden: it is the single row where old and new differ, and
  ;; it differs from an exception to the fail-closed answer.
  (let [caps [(symbol (str rc "restricted"))]]
    (is (thrown? #?(:clj Throwable :cljs :default) (legacy-clearance-rank caps)))
    (is (= 0 (policy/clearance-rank caps)))))
