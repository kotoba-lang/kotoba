;; NETCONF's message layer is XML (RFC 6241 <rpc>/<rpc-reply>/<hello>) — the
;; hiccup<->XML codec is not this repo's job. It belongs to kotoba-lang/xml,
;; which already implements it dependency-free. This repo depends on it as a
;; workspace git dep (same pattern as org-ietf-snmp -> org-ietf-asn1) rather
;; than writing a second XML parser.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/xml {:local/root "../kotoba.xml"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
