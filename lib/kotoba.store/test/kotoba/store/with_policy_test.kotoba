(ns kotoba.store.with-policy-test (:export [main]) (:require [kotoba.store.with-policy :as p]))

(defn- g [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))

(defn- same [a :document b :document] :bool
  (string=? (document-edn-print a) (document-edn-print b)))

(defn main [] :i64
  (let [s (document-map :name (document-string "cache") :policy (document-keyword :old))
        pol (document-map :mode (document-keyword :strict))
        r (p/with-policy s pol)
        r2 (p/with-policy (document-map) pol)]
    (+ (if (same (g r :policy) pol) 0 1)
       (if (same (g r :name) (document-string "cache")) 0 1)
       (if (same (g r2 :policy) pol) 0 1)
       (if (same (g r2 :name) (document-null)) 0 1))))
