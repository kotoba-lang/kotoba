;; Kotoba port of lib/kotoba.store/src/kotoba/store/read_cap.cljk.
;;
;; Named divergence: the .cljk def read-cap is a constant. A cross-module
;; constant fails E6004 in the kotoba checker, so read-cap is a zero-arg fn.
(ns kotoba.store.read-cap
  (:export [read-cap]))

(defn read-cap [] :string "store:read")
