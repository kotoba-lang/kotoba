;; Port of kotoba.store.with-policy (with_policy.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from with_policy.cljk:
;;   - the store s and the policy pol are :document values; assoc becomes document-assoc.

(ns kotoba.store.with-policy
  (:export [with-policy]))

(defn with-policy [s :document pol :document] :document
  (document-assoc s :policy pol))
