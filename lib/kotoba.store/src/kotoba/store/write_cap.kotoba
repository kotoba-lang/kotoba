;; Port of kotoba.store.write-cap (write_cap.cljk), Kotoba-native.
;; Named divergences:
;;   - the source is a `def` of the constant "store:write". amu cannot export a
;;     def (E2005) and a cross-module constant fails (E6004), so the value is
;;     the zero-argument function write-cap.
(ns kotoba.store.write-cap
  (:export [write-cap]))

(defn write-cap [] :string
  "store:write")
