;; No dependencies, and that is the point. MessagePack already exists twice
;; in this workspace and neither copy can be shared: `checkpointer` has a
;; JVM-only codec with throwing ClojureScript stubs, and the same
;; repository's JavaScript side depends on npm `@msgpack/msgpack`. A leaf
;; that dragged an IO or crypto stack behind it would reintroduce exactly
;; the per-runtime split it exists to remove.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  ;; classpath only, no :main-opts — `kbb -A:cljs -Spath` resolves deps
  ;; for nbb without the deprecation warning `-A` prints when the alias
  ;; carries a main.
  :cljs {:extra-paths ["test"]}
}}
