;; Two dependencies, and this is the repo that exists to hold the second one.
;;
;;   io-filecoin  — addresses, messages, and the bytes a signature covers.
;;                  Its `src/` pins no curve on purpose, which is why signing
;;                  is a seam there and lives here.
;;   eth-crypto   — secp256k1. RFC-6979 deterministic nonces, EIP-2 low-s,
;;                  recovery, on both runtimes. Not "Ethereum crypto that
;;                  happens to work": secp256k1 is the same curve, and the
;;                  chains differ only in how they turn a public key into an
;;                  address.
;;
;; Still no BLS12-381, so `f3` accounts cannot sign here — there is no
;; implementation of that curve anywhere in this workspace.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/io-filecoin {:local/root "../kotoba.ioFilecoin"}
        io.github.kotoba-lang/eth-crypto {:local/root "../kotoba.ethCrypto"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}
}}
