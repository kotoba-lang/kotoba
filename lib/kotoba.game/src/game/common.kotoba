;; Port of game.common (common.cljk), Kotoba-native, PARTIAL.
;;
;; Ported: rng-new and rng-next-seed, the integer core of xorshift32.
;; The state is a :document map {:seed i64}, masked to unsigned 32 bits.
;;
;; Not ported: rng-next-f32, rng-range, rng-next-u32, rng-chance. Each one
;; turns the state into a float (a f32 division, abs and a float compare),
;; and a float value cannot be carried in a :document in the verified set.
;;
;; Named divergences from common.cljk:
;;   - rng-next-seed is new: it is the state advance that rng-next-f32 runs
;;     before its float conversion. It returns the new state map.
;;   - bit shifts are written as multiply and quot (no shift builtin used).

(ns game.common
  (:export [rng-new rng-next-seed]))

(defn- u32 [n :i64] :i64
  (rem (+ (rem n 4294967296) 4294967296) 4294967296))

(defn rng-new [seed :i64] :document
  (document-map :seed (document-i64 (u32 (if (= seed 0) 1 seed)))))

(defn rng-next-seed [rng :document] :document
  (let [seed (option-value-of [:option :i64]
                              (document-i64-value (option-or (document-get rng :seed) (document-null)))
                              0)
        s1 (u32 (bit-xor seed (u32 (* seed 8192))))
        s2 (u32 (bit-xor s1 (quot s1 131072)))
        s3 (u32 (bit-xor s2 (u32 (* s2 32))))]
    (document-map :seed (document-i64 s3))))
