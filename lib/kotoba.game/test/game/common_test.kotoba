(ns game.common-test (:export [main]) (:require [game.common :as p]))

(defn- seed-of [d :document] :i64
  (option-value-of [:option :i64]
                   (document-i64-value (option-or (document-get d :seed) (document-null)))
                   -1))

(defn main [] :i64
  (+ (if (= (seed-of (p/rng-new 0)) 1) 0 1)
     (if (= (seed-of (p/rng-new 5)) 5) 0 1)
     (if (= (seed-of (p/rng-new 4294967301)) 5) 0 1)
     (if (= (seed-of (p/rng-next-seed (p/rng-new 1))) 270369) 0 1)
     (if (= (seed-of (p/rng-next-seed (p/rng-new 0))) 270369) 0 1)
     (if (= (seed-of (p/rng-next-seed (p/rng-new 1))) 1) 1 0)))
