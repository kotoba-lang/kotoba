(ns game.sprite-test
  (:require [game.sprite :as s])
  (:export [main]))

;; Returns the number of failed cases (0 = pass).
(defn main [] :i64
  (let [sp (s/sprite2d-default)
        vp (s/viewport2d-default)]
    (+ (if (= (record-get [:record :game.sprite/Sprite2D [[:px :f64] [:py :f64] [:sw :f64] [:sh :f64] [:layer :f64] [:cr :f64] [:cg :f64] [:cb :f64] [:ca :f64] [:texture-key :string] [:flip-x :bool] [:frame :i64] [:frames-total :i64]]] sp :frames-total) 1) 0 1)
       (+ (if (f64-eq (record-get [:record :game.sprite/Viewport2D [[:width :f64] [:height :f64] [:pixels-per-unit :f64]]] vp :pixels-per-unit) 32.0) 0 1)
          (if (f64-eq (s/parallax-offset 10.0 4.0 0.5) 7.0) 0 1)))))
