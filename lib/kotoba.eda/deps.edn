{:paths ["src" "resources"]
 ;; kotoba-ui / appkit are the design-system paved road (kotoba-ui/docs/
 ;; agent-guide.md) — :local/root west siblings (orgs/kotoba-lang/*), same
 ;; convention as appkit's own deps. kotoba-ui itself pins shitsuke /
 ;; liquid-glass-ui as :local/root siblings, so those checkouts must also
 ;; sit next to this repo (CI checks them out — see .github/workflows).
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/org-synopsys-sdc {:local/root "../com.synopsys.sdc"}
        io.github.kotoba-lang/kotoba-ui {:local/root "../kotoba.kotobaUi"}
        io.github.kotoba-lang/appkit {:local/root "../kotoba.appkit"}}
 :aliases
 {
  :test {:extra-paths ["test"]}}}