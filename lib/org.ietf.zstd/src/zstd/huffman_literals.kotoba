;; Decode bounded Zstandard Huffman streams from a validated weight tree.
(ns zstd.huffman-literals
 (:require [zstd.huffman-tree :as t] [zstd.frame-header :as h])
 (:export [decode-four]))
(defn- make-table [ws :vector-i64 log :i64] :vector-i64
 (let [size (i64-shift-left 1 log)]
  (loop [weight 1 pos 0 table (vector-alloc (* size 2))]
   (if (> weight log) (if (= pos size) table (throw :invalid-tree))
    (let [r (loop [s 0 p pos out table]
              (if (= s (vector-count ws)) (vector-i64 p) 
               (let [w (vector-at ws s) count (if (= w weight) (i64-shift-left 1 (- w 1)) 0)]
                (loop [j 0] (if (= j count) 0 (do (vector-assoc! out (* 2 (+ p j)) s) (vector-assoc! out (+ 1 (* 2 (+ p j))) (+ 1 (- log weight))) (recur (+ j 1)))))
                (recur (+ s 1) (+ p count) out))))]
      (recur (+ weight 1) (vector-at r 0) table))))))
(defn- stream [b :vector-i64 start :i64 end :i64 n :i64 log :i64 table :vector-i64 out :vector-i64 offset :i64] :vector-i64
 (let [marker (h/reverse-start b start end) total (* 8 (- end start))]
  (if (not= (record-get [:ref :zstd/reverse] marker :error) :none) (throw :invalid-stream)
   (loop [i 0 p (record-get [:ref :zstd/reverse] marker :next) v out]
    (if (= i n) (if (= p total) v (throw :invalid-end))
     (let [r (h/reverse-read b start end p log) idx (record-get [:ref :zstd/reverse] r :value)
           w (vector-at table (+ (* idx 2) 1)) sym (vector-at table (* idx 2))]
      (if (or (not= (record-get [:ref :zstd/reverse] r :error) :none) (= w 0) (> (+ p w) total)) (throw :invalid-stream)
       (recur (+ i 1) (+ p w) (vector-assoc! v (+ offset i) sym)))))))))
(defn- u16 [b :vector-i64 p :i64] :i64 (+ (vector-at b p) (* 256 (vector-at b (+ p 1)))))
(defn- valid-jump? [b :vector-i64 p :i64] :bool
 (loop [i 0] (if (= i 6) true (let [x (vector-at b (+ p i))] (and (>= x 0) (<= x 255) (recur (+ i 1)))))))
(defn- valid-tree? [ws :vector-i64 log :i64] :bool
 (if (or (< log 1) (> log 12) (< (vector-count ws) 2) (> (vector-count ws) 256)) false
  (loop [i 0 sum 0] (if (= i (vector-count ws)) (= sum (i64-shift-left 1 log))
   (let [w (vector-at ws i)] (if (or (< w 0) (> w log)) false
    (recur (+ i 1) (+ sum (if (= w 0) 0 (i64-shift-left 1 (- w 1)))))))))))
(defn- decode! [b :vector-i64 start :i64 end :i64 n :i64 tree [:ref :zstd/huffman-tree]] :vector-i64
 (if (or (< start 0) (> end (vector-count b)) (< (- end start) 10) (< n 4) (> n 131072)) (throw :invalid-bound)
  (let [a (u16 b start) c (u16 b (+ start 2)) d (u16 b (+ start 4)) p (+ start 6) q (+ p a) r (+ q c) s (+ r d)
        part (quot (+ n 3) 4) last (- n (* 3 part)) log (record-get [:ref :zstd/huffman-tree] tree :log)]
   (if (or (not (valid-jump? b start)) (< a 1) (< c 1) (< d 1) (>= s end) (< last 0) (not (valid-tree? (record-get [:ref :zstd/huffman-tree] tree :weights) log))) (throw :invalid-bound)
    (let [table (make-table (record-get [:ref :zstd/huffman-tree] tree :weights) log)
          aout (stream b p q part log table (vector-alloc n) 0)
          bout (stream b q r part log table aout part)
          cout (stream b r s part log table bout (* 2 part))]
     (stream b s end last log table cout (* 3 part)))))))
(defn decode-four [b :vector-i64 start :i64 end :i64 n :i64 tree [:ref :zstd/huffman-tree]] [:result :vector-i64 :keyword]
 (try (result-ok-of [:result :vector-i64 :keyword] (decode! b start end n tree))
  (catch :keyword e (result-err-of [:result :vector-i64 :keyword] e))))
