;; Bounded two-state FSE stream for Zstandard Huffman weights.
(ns zstd.fse-weights
 (:require [zstd.frame-header :as h] [zstd.fse-description :as d])
 (:export [decode]))
(defn- trim [v :vector-i64 n :i64] :vector-i64
 (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v i))))))
(defn- next-value [b :vector-i64 start :i64 end :i64 p :i64 width :i64] [:ref :zstd/reverse]
 (let [r (h/reverse-read b start end p width)]
  (if (not= (record-get [:ref :zstd/reverse] r :error) :none) (throw :invalid-stream) r)))
(defn- walk [b :vector-i64 start :i64 end :i64 p :i64 table :vector-i64 a :i64 other :i64 out :vector-i64 n :i64] :vector-i64
 (if (>= n 254) (throw :output-limit)
  (let [j (* a 3) sym (vector-at table j) width (vector-at table (+ j 1)) base (vector-at table (+ j 2))
        bits (next-value b start end p width) next (+ base (record-get [:ref :zstd/reverse] bits :value))
        pos (record-get [:ref :zstd/reverse] bits :next) updated (vector-assoc! out n sym)]
   (if (>= next (quot (vector-count table) 3)) (throw :invalid-state)
    (if (> pos (* (- end start) 8))
     (trim (vector-assoc! updated (+ n 1) (vector-at table (* other 3))) (+ n 2))
     (walk b start end pos table other next updated (+ n 1)))))))
(defn- decode! [b :vector-i64 start :i64 end :i64] :vector-i64
 (let [description (d/parse-weights b start end)]
  (if (not (result-ok?-of [:result [:ref :zstd/fse-description] :keyword] description)) (throw :invalid-description)
   (let [desc (result-value-of [:result [:ref :zstd/fse-description] :keyword] description (record-new [:ref :zstd/fse-description] [] 0 0))
         s (record-get [:ref :zstd/fse-description] desc :next-byte) log (record-get [:ref :zstd/fse-description] desc :accuracy)
         table-result (h/fse-table (record-get [:ref :zstd/fse-description] desc :counts) log)
         marker (h/reverse-start b s end)]
    (if (or (not (result-ok?-of [:result :vector-i64 :keyword] table-result)) (not= (record-get [:ref :zstd/reverse] marker :error) :none)) (throw :invalid-stream)
     (let [p (record-get [:ref :zstd/reverse] marker :next) total (* (- end s) 8)]
      (if (> (+ p (* log 2)) total) (throw :truncated)
       (let [r1 (next-value b s end p log) r2 (next-value b s end (record-get [:ref :zstd/reverse] r1 :next) log)]
        (walk b s end (record-get [:ref :zstd/reverse] r2 :next) (result-value-of [:result :vector-i64 :keyword] table-result [])
         (record-get [:ref :zstd/reverse] r1 :value) (record-get [:ref :zstd/reverse] r2 :value) (vector-alloc 255) 0)))))))))
(defn decode [b :vector-i64 start :i64 end :i64] [:result :vector-i64 :keyword]
 (try (result-ok-of [:result :vector-i64 :keyword] (decode! b start end))
  (catch :keyword e (result-err-of [:result :vector-i64 :keyword] e))))
