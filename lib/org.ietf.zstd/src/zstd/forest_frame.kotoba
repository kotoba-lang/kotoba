;; Extended single-block Huffman frame path. Other frames use the existing decoder.
(ns zstd.forest-frame
 (:require [zstd.frame-header :as z] [zstd.literal-header :as lit]
           [zstd.fse-description :as desc] [zstd.fse-weights :as weights]
           [zstd.huffman-tree :as tree] [zstd.huffman-literals :as huff])
 (:export [decode-frame]))
(defn- fail [e :keyword] [:ref :zstd/frame-output] (record-new [:ref :zstd/frame-output] e 0 []))
(defn- prefix [b :vector-i64 pos :i64 n :i64] :vector-i64
 (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at b (+ pos i)))))))
(defn- extended [b :vector-i64 pos :i64 end :i64 max-window :i64 max-output :i64] [:ref :zstd/frame-output]
 (let [head (prefix b pos (if (< (- end pos) 18) (- end pos) 18))
       header (z/parse head max-window max-output) hp (+ pos (record-get [:ref :zstd/header] header :header-size))
       block (z/parse-block b hp (record-get [:ref :zstd/header] header :window-size))
       start (+ hp 3) stop (+ start (record-get [:ref :zstd/block-header] block :payload-size))]
  (cond (not= (record-get [:ref :zstd/header] header :error) :none) (fail (record-get [:ref :zstd/header] header :error))
        (not= (record-get [:ref :zstd/header] header :checksum) 0) (fail :checksum-unsupported)
        (not= (record-get [:ref :zstd/block-header] block :error) :none) (fail (record-get [:ref :zstd/block-header] block :error))
        (not= (record-get [:ref :zstd/block-header] block :kind) 2) (fail :block-type-unsupported)
        (> stop end) (fail :truncated)
        (and (= (record-get [:ref :zstd/block-header] block :last) 0)
             (or (not= (- end stop) 3) (not= (vector-at b stop) 1) (not= (vector-at b (+ stop 1)) 0) (not= (vector-at b (+ stop 2)) 0))) (fail :block-type-unsupported)
        :else
        (let [l (lit/parse b start stop max-output) e (record-get [:ref :zstd/literal-header] l :error)
              content (record-get [:ref :zstd/literal-header] l :content) size (record-get [:ref :zstd/literal-header] l :tree-bytes)
              seq-start (+ content (record-get [:ref :zstd/literal-header] l :compressed))]
         (cond (not= e :none) (fail e)
               (or (not= (record-get [:ref :zstd/literal-header] l :tree-mode) :fse) (not= (record-get [:ref :zstd/literal-header] l :streams) 4)) (fail :huffman-unsupported)
               :else (let [w (weights/decode b (+ content 1) (+ content 1 size))]
                (if (not (result-ok?-of [:result :vector-i64 :keyword] w)) (fail (result-error-of [:result :vector-i64 :keyword] w :invalid-stream))
                 (let [t (tree/complete (result-value-of [:result :vector-i64 :keyword] w []))]
                  (if (not (result-ok?-of [:result [:ref :zstd/huffman-tree] :keyword] t)) (fail (result-error-of [:result [:ref :zstd/huffman-tree] :keyword] t :invalid-tree))
                   (let [v (huff/decode-four b (+ content 1 size) seq-start (record-get [:ref :zstd/literal-header] l :regenerated) (result-value-of [:result [:ref :zstd/huffman-tree] :keyword] t (record-new [:ref :zstd/huffman-tree] [] 0)))
                         seqs (z/decode-predefined-sequences b seq-start stop (quot max-output 3))]
                    (cond (not (result-ok?-of [:result :vector-i64 :keyword] v)) (fail (result-error-of [:result :vector-i64 :keyword] v :invalid-stream))
                          (not (result-ok?-of [:result :vector-i64 :keyword] seqs)) (fail (result-error-of [:result :vector-i64 :keyword] seqs :invalid-sequences))
                          :else (let [out (z/execute-sequences [] (result-value-of [:result :vector-i64 :keyword] v []) (result-value-of [:result :vector-i64 :keyword] seqs []) (vector-i64 1 4 8) (record-get [:ref :zstd/header] header :window-size) max-output)
                                      bytes (record-get [:ref :zstd/execution] out :bytes) declared (record-get [:ref :zstd/header] header :content-size)]
                                  (cond (not= (record-get [:ref :zstd/execution] out :error) :none) (fail (record-get [:ref :zstd/execution] out :error))
                                        (and (not= declared -1) (not= declared (vector-count bytes))) (fail :size-mismatch)
                                        :else (record-new [:ref :zstd/frame-output] :none (if (= (record-get [:ref :zstd/block-header] block :last) 1) stop (+ stop 3)) bytes))))))))))))))
(defn decode-frame [b :vector-i64 pos :i64 end :i64 max-window :i64 max-output :i64] [:ref :zstd/frame-output]
 (let [base (z/decode-frame b pos end max-window max-output)]
  (if (= (record-get [:ref :zstd/frame-output] base :error) :huffman-unsupported)
   (extended b pos end max-window max-output) base)))
