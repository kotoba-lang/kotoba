;; RFC 8878 compressed/treeless literals header and tree-header bounds only.
;; This is not a Huffman, FSE, jump-table or payload decoder.
(ns zstd.literal-header
 (:export [parse])
 (:schemas {:zstd/literal-header [:record :zstd/literal-header
  [[:error :keyword] [:kind :i64] [:format :i64] [:header-size :i64]
   [:regenerated :i64] [:compressed :i64] [:streams :i64] [:content :i64]
   [:tree-mode :keyword] [:tree-bytes :i64]]]}))
(defn- fail [e :keyword] [:ref :zstd/literal-header]
 (record-new [:ref :zstd/literal-header] e 0 0 0 0 0 0 0 :none 0))
(defn- le [b :vector-i64 pos :i64 width :i64] :i64
 (loop [i 0 v 0] (if (= i width) v
  (recur (+ i 1) (bit-or v (i64-shift-left (vector-at b (+ pos i)) (* 8 i)))))))
(defn- valid-bytes? [b :vector-i64 pos :i64 width :i64] :bool
 (loop [i 0] (if (= i width) true
  (let [x (vector-at b (+ pos i))] (and (>= x 0) (<= x 255) (recur (+ i 1)))))))
(defn parse [b :vector-i64 pos :i64 end :i64 output-limit :i64] [:ref :zstd/literal-header]
 (let [n (vector-count b)]
  (cond (< output-limit 0) (fail :invalid-bound)
        (or (< pos 0) (< end pos) (> end n) (= pos end)) (fail :truncated)
        (or (< (vector-at b pos) 0) (> (vector-at b pos) 255)) (fail :invalid-byte)
        :else
        (let [first (vector-at b pos) kind (bit-and first 3) format (bit-and (u64-shift-right first 2) 3)
              width (if (< format 2) 3 (if (= format 2) 4 5)) bits (if (< format 2) 10 (if (= format 2) 14 18))]
         (cond (< kind 2) (fail :not-compressed)
               (< (- end pos) width) (fail :truncated)
               (not (valid-bytes? b pos width)) (fail :invalid-byte)
               :else
               (let [v (le b pos width) mask (- (i64-shift-left 1 bits) 1)
                     regenerated (bit-and (u64-shift-right v 4) mask)
                     compressed (bit-and (u64-shift-right v (+ 4 bits)) mask)
                     streams (if (= format 0) 1 4) content (+ pos width)]
                (cond (> regenerated 131072) (fail :block-limit)
                      (> regenerated output-limit) (fail :output-limit)
                      (> compressed (- end content)) (fail :truncated)
                      (= kind 3) (record-new [:ref :zstd/literal-header] :none kind format width regenerated compressed streams content :reuse 0)
                      (= compressed 0) (fail :truncated-tree)
                      :else
                       (let [x (vector-at b content)]
                        (if (or (< x 0) (> x 255)) (fail :invalid-byte)
                         (let [mode (if (< x 128) :fse :direct)
                               size (if (< x 128) x (quot (+ (- x 127) 1) 2))]
                          (if (> (+ 1 size) compressed) (fail :truncated-tree)
                           (record-new [:ref :zstd/literal-header] :none kind format width regenerated compressed streams content mode size))))))))))))
