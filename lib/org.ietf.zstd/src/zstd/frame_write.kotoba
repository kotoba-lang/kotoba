;; Bounded Zstandard single-segment frames containing raw or RLE blocks.
;; RFC 8878 sections 3.1.1.1 and 3.1.1.2; no dictionary/checksum/entropy coder.
(ns zstd.frame-write (:export [encode-frame]))
(defn- put-le [out :vector-i64 at :i64 n :i64 x :i64] :vector-i64
 (loop [i 0 v out] (if (= i n) v
  (recur (+ i 1) (vector-assoc! v (+ at i) (bit-and (u64-shift-right x (* 8 i)) 255))))))
(defn- repeat? [data :vector-i64 start :i64 n :i64] :bool
 (and (> n 1) (let [x (vector-at data start)]
  (loop [i 1] (if (= i n) true (if (= x (vector-at data (+ start i))) (recur (+ i 1)) false))))))
(defn- valid? [data :vector-i64] :bool
 (loop [i 0] (if (= i (vector-count data)) true
  (let [x (vector-at data i)] (if (or (< x 0) (> x 255)) false (recur (+ i 1)))))))
(defn encode-frame [data :vector-i64] [:result :vector-i64 :keyword]
 (let [n (vector-count data)]
  (cond (> n 2097152) (result-err-of [:result :vector-i64 :keyword] :content-limit)
        (not (valid? data)) (result-err-of [:result :vector-i64 :keyword] :invalid-byte)
        :else
        (let [size (if (= n 0) 12
                     (loop [p 0 total 9]
                      (if (= p n) total
                       (let [left (- n p) k (if (> left 131072) 131072 left)]
                        (recur (+ p k) (+ total 3 (if (repeat? data p k) 1 k)))))))
              header (-> (vector-alloc size) (vector-assoc! 0 40) (vector-assoc! 1 181)
                         (vector-assoc! 2 47) (vector-assoc! 3 253) (vector-assoc! 4 160)
                         (put-le 5 4 n))]
         (if (= n 0) (result-ok-of [:result :vector-i64 :keyword] (put-le header 9 3 1))
          (loop [p 0 at 9 out header]
           (if (= p n) (result-ok-of [:result :vector-i64 :keyword] out)
            (let [left (- n p) k (if (> left 131072) 131072 left) rle (repeat? data p k)
                  block (+ (* k 8) (if rle 2 0) (if (= (+ p k) n) 1 0))
                  framed (put-le out at 3 block)
                  next (if rle (vector-assoc! framed (+ at 3) (vector-at data p))
                        (loop [i 0 v framed] (if (= i k) v
                          (recur (+ i 1) (vector-assoc! v (+ at 3 i) (vector-at data (+ p i)))))))]
             (recur (+ p k) (+ at 3 (if rle 1 k)) next)))))))))
