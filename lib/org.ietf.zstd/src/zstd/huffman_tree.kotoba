;; Validate explicit Huffman weights and restore the implicit final weight.
(ns zstd.huffman-tree
 (:export [complete])
 (:schemas {:zstd/huffman-tree [:record :zstd/huffman-tree [[:weights :vector-i64] [:log :i64]]]}))
(defn- highbit [n :i64] :i64 (loop [x n i -1] (if (= x 0) i (recur (quot x 2) (+ i 1)))))
(defn- sum [xs :vector-i64] :i64
 (loop [i 0 total 0] (if (= i (vector-count xs)) total
  (let [w (vector-at xs i)] (if (or (< w 0) (> w 12)) (throw :invalid-weight)
   (recur (+ i 1) (+ total (if (= w 0) 0 (i64-shift-left 1 (- w 1))))))))))
(defn- complete! [xs :vector-i64] [:ref :zstd/huffman-tree]
 (let [n (vector-count xs)]
  (if (or (< n 1) (> n 255)) (throw :invalid-size)
   (let [total (sum xs)]
    (if (= total 0) (throw :empty-tree)
     (let [log (+ 1 (highbit total)) rest (- (i64-shift-left 1 log) total) last (+ 1 (highbit rest))]
      (if (or (> log 12) (not= (i64-shift-left 1 (- last 1)) rest)) (throw :invalid-tree)
       (let [all (loop [i 0 out (vector-alloc (+ n 1))]
                   (if (= i n) (vector-assoc! out n last) (recur (+ i 1) (vector-assoc! out i (vector-at xs i)))))
             rank (loop [i 0 c 0] (if (= i (+ n 1)) c (recur (+ i 1) (+ c (if (= (vector-at all i) 1) 1 0)))))]
        (if (or (< rank 2) (not= (rem rank 2) 0)) (throw :invalid-tree)
         (record-new [:ref :zstd/huffman-tree] all log))))))))))
(defn complete [xs :vector-i64] [:result [:ref :zstd/huffman-tree] :keyword]
 (try (result-ok-of [:result [:ref :zstd/huffman-tree] :keyword] (complete! xs))
  (catch :keyword e (result-err-of [:result [:ref :zstd/huffman-tree] :keyword] e))))
