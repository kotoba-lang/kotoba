;; RFC 8878 forward FSE normalized counts, for Huffman weight streams.
;; This parses the table description only; the reverse FSE stream is separate.
(ns zstd.fse-description
 (:export [parse-weights parse-offsets])
 (:schemas {:zstd/fse-description [:record :zstd/fse-description [[:counts :vector-i64] [:accuracy :i64] [:next-byte :i64]]]
            :zstd/fse-bits [:record :zstd/fse-bits [[:value :i64] [:next :i64]]]
            :zstd/fse-skip [:record :zstd/fse-skip [[:count :i64] [:next :i64]]]}))
(defn- read-bits [b :vector-i64 pos :i64 end :i64 width :i64] [:ref :zstd/fse-bits]
 (if (or (< pos 0) (< width 0) (> width 10) (> pos (* end 8)) (> width (- (* end 8) pos))) (throw :truncated)
  (loop [i 0 v 0]
   (if (= i width) (record-new [:ref :zstd/fse-bits] v (+ pos width))
    (let [p (+ pos i) x (vector-at b (quot p 8))]
     (if (or (< x 0) (> x 255)) (throw :invalid-byte)
      (recur (+ i 1) (bit-or v (i64-shift-left (bit-and 1 (u64-shift-right x (rem p 8))) i)))))))))
(defn- highbit [n :i64] :i64
 (loop [x n i -1] (if (= x 0) i (recur (quot x 2) (+ i 1)))))
(defn- trim [v :vector-i64 n :i64] :vector-i64
 (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v i))))))
(defn- skip-zeros [b :vector-i64 pos :i64 end :i64 total :i64] [:ref :zstd/fse-skip]
 (let [x (read-bits b pos end 2) n (+ total (record-get [:ref :zstd/fse-bits] x :value)) next (record-get [:ref :zstd/fse-bits] x :next)]
  (cond (> n 255) (throw :symbol-limit)
        (= (record-get [:ref :zstd/fse-bits] x :value) 3) (skip-zeros b next end n)
        :else (record-new [:ref :zstd/fse-skip] n next))))
(defn- scan [b :vector-i64 end :i64 pos :i64 remaining :i64 counts :vector-i64 idx :i64 previous-zero :bool nonzero :i64] [:ref :zstd/fse-description]
 (if (= remaining 1)
  (if (< nonzero 2) (throw :insufficient-symbols)
   (record-new [:ref :zstd/fse-description] (trim counts idx) 0 (quot (+ pos 7) 8)))
  (let [skip (if previous-zero (skip-zeros b pos end 0) (record-new [:ref :zstd/fse-skip] 0 pos))
        at (+ idx (record-get [:ref :zstd/fse-skip] skip :count)) p (record-get [:ref :zstd/fse-skip] skip :next)
        width (+ 1 (highbit remaining)) threshold (i64-shift-left 1 (- width 1)) maximum (- (- (* 2 threshold) 1) remaining)]
   (if (>= at 256) (throw :symbol-limit)
    (let [low (read-bits b p end (- width 1)) small (record-get [:ref :zstd/fse-bits] low :value)
          full (if (< small maximum) low (read-bits b p end width)) raw (record-get [:ref :zstd/fse-bits] full :value)
          decoded (if (and (>= small maximum) (>= raw threshold)) (- raw maximum) raw) count (- decoded 1)
          spent (if (= count -1) 1 count) rest (- remaining spent)]
     (if (or (< count -1) (<= rest 0)) (throw :invalid-distribution)
      (scan b end (record-get [:ref :zstd/fse-bits] full :next) rest (vector-assoc! counts at count) (+ at 1) (= count 0) (+ nonzero (if (= count 0) 0 1)))))))))
(defn- parse! [b :vector-i64 start :i64 end :i64 max-log :i64 max-symbols :i64] [:ref :zstd/fse-description]
 (if (or (< start 0) (< end start) (> end (vector-count b))) (throw :invalid-bound)
  (let [a (read-bits b (* start 8) end 4) log (+ 5 (record-get [:ref :zstd/fse-bits] a :value))]
   (if (> log max-log) (throw :accuracy-limit)
    (let [bound (if (> (- end start) 512) (+ start 512) end)
          r (scan b bound (record-get [:ref :zstd/fse-bits] a :next) (+ (i64-shift-left 1 log) 1) (vector-alloc 256) 0 false 0)
          counts (record-get [:ref :zstd/fse-description] r :counts)]
     (if (> (vector-count counts) max-symbols) (throw :symbol-limit)
      (record-new [:ref :zstd/fse-description] counts log (record-get [:ref :zstd/fse-description] r :next-byte))))))))
(defn parse-weights [b :vector-i64 start :i64 end :i64] [:result [:ref :zstd/fse-description] :keyword]
 (try (if (> (- end start) 127) (throw :invalid-bound) (result-ok-of [:result [:ref :zstd/fse-description] :keyword] (parse! b start end 6 256)))
  (catch :keyword e (result-err-of [:result [:ref :zstd/fse-description] :keyword] e))))
(defn parse-offsets [b :vector-i64 start :i64 end :i64] [:result [:ref :zstd/fse-description] :keyword]
 (try (result-ok-of [:result [:ref :zstd/fse-description] :keyword] (parse! b start end 8 32))
  (catch :keyword e (result-err-of [:result [:ref :zstd/fse-description] :keyword] e))))
