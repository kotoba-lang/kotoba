(ns zstd.fse-description-test (:require [zstd.fse-description :as f]) (:export [main]))
(defn- same? [a :vector-i64 b :vector-i64] :bool
 (and (= (vector-count a) (vector-count b)) (loop [i 0] (if (= i (vector-count a)) true (and (= (vector-at a i) (vector-at b i)) (recur (+ i 1)))))))
(defn main [] :i64
 (let [good (f/parse-weights (vector-i64 80 197 166 13) 0 4)
       short (f/parse-weights (vector-i64 80) 0 1)
       acc (f/parse-weights (vector-i64 2) 0 1)
       bounds (f/parse-weights (vector-i64 0) 0 2)
       two (f/parse-weights (vector-i64 16 63) 0 2)
       zeros (f/parse-weights (vector-i64 0 66 63) 0 3)
       tr (result-value-of [:result [:ref :zstd/fse-description] :keyword] two (record-new [:ref :zstd/fse-description] [] 0 0))
       zr (result-value-of [:result [:ref :zstd/fse-description] :keyword] zeros (record-new [:ref :zstd/fse-description] [] 0 0))
       r (result-value-of [:result [:ref :zstd/fse-description] :keyword] good (record-new [:ref :zstd/fse-description] [] 0 0))]
  (cond (not (result-ok?-of [:result [:ref :zstd/fse-description] :keyword] good)) 1
        (not= (record-get [:ref :zstd/fse-description] r :accuracy) 5) 2
        (not= (record-get [:ref :zstd/fse-description] r :next-byte) 4) 3
        (not (same? (record-get [:ref :zstd/fse-description] r :counts) (vector-i64 20 1 5 2 1 2 1))) 4
        (not= (result-error-of [:result [:ref :zstd/fse-description] :keyword] short :none) :truncated) 5
        (not= (result-error-of [:result [:ref :zstd/fse-description] :keyword] acc :none) :accuracy-limit) 6
        (not= (result-error-of [:result [:ref :zstd/fse-description] :keyword] bounds :none) :invalid-bound) 7
        (not (result-ok?-of [:result [:ref :zstd/fse-description] :keyword] two)) 8
        (not (same? (record-get [:ref :zstd/fse-description] tr :counts) (vector-i64 16 16))) 9
        (not (result-ok?-of [:result [:ref :zstd/fse-description] :keyword] zeros)) 10
        (not (same? (record-get [:ref :zstd/fse-description] zr :counts) (vector-i64 -1 0 0 31))) 11 :else 0)))
