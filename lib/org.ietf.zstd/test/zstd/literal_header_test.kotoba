(ns zstd.literal-header-test (:require [zstd.literal-header :as h]) (:export [main]))
(defn- err [v [:ref :zstd/literal-header]] :keyword (record-get [:ref :zstd/literal-header] v :error))
(defn main [] :i64
 (let [b (vector-alloc 261) _ (vector-assoc! b 0 230) _ (vector-assoc! b 1 144) _ (vector-assoc! b 2 64) _ (vector-assoc! b 3 56)
       a (h/parse b 0 261 131072) limit (h/parse b 0 261 269) trunc (h/parse b 0 260 131072)
       direct (h/parse (vector-i64 66 128 0 128 16) 0 5 4)
       reuse (h/parse (vector-i64 67 128 0 0 0) 0 5 4)
       wide (h/parse (vector-i64 138 62 12 0 128 16 0) 0 7 1000)
       widest (h/parse (vector-i64 14 106 216 0 0 128 16 0) 0 8 100000)
       badtree (h/parse (vector-i64 66 128 0 130 0) 0 5 4)
       raw (h/parse (vector-i64 0) 0 1 1)]
  (cond (not= (err a) :none) 1
        (or (not= (record-get [:ref :zstd/literal-header] a :regenerated) 270) (not= (record-get [:ref :zstd/literal-header] a :compressed) 258)
            (not= (record-get [:ref :zstd/literal-header] a :streams) 4) (not= (record-get [:ref :zstd/literal-header] a :tree-mode) :fse)
            (not= (record-get [:ref :zstd/literal-header] a :tree-bytes) 56)) 2
        (not= (err limit) :output-limit) 3 (not= (err trunc) :truncated) 4
        (or (not= (err direct) :none) (not= (record-get [:ref :zstd/literal-header] direct :tree-mode) :direct)
            (not= (record-get [:ref :zstd/literal-header] direct :streams) 1)) 5
        (or (not= (err reuse) :none) (not= (record-get [:ref :zstd/literal-header] reuse :tree-mode) :reuse)) 6
        (or (not= (err wide) :none) (not= (record-get [:ref :zstd/literal-header] wide :regenerated) 1000)) 7
        (or (not= (err widest) :none) (not= (record-get [:ref :zstd/literal-header] widest :regenerated) 100000)) 8
        (not= (err badtree) :truncated-tree) 9 (not= (err raw) :not-compressed) 10 :else 0)))
