(ns kotoba.security
  "Pure security primitives core in Kotoba. Hashing/signing hosts (ed25519,
  cacao) live in dedicated repos; this module holds pure byte helpers."
  (:export [const-eq xor-byte hex-nibble main test-self-check test-const-eq-upper-word]))

;; Constant-time-ish equality over two full i64 words (0/1). The whole XOR
;; is compared: masking to 32 bits made values differing only in the upper
;; word compare equal.
(defn const-eq [a b] :i64
  (let [diff (bit-xor a b)]
    (if (= 0 diff) 1 0)))

(defn xor-byte [a b] :i64
  (bit-and 255 (bit-xor a b)))

(defn hex-nibble [v] :i64
  (if (< v 10) (+ v 48) (+ v -10 65)))

(defn self-check [] :i64
  (+ (+ (+ (+ (+ (if (= 1 (const-eq 123 123)) 0 1)
   (if (= 0 (const-eq 123 124)) 0 1))
   (if (= 0 (const-eq 123 (+ 123 4294967296))) 0 1))
   (if (= 0 (xor-byte 255 255)) 0 1))
   (if (= 255 (xor-byte 240 15)) 0 1))
   (if (= 65 (hex-nibble 10)) 0 1)))

(defn main [] :i64 (self-check))

;; `kotoba -M test` exports: 1 = pass.
(defn test-self-check [] :i64 (if (= 0 (self-check)) 1 0))

(defn test-const-eq-upper-word [] :i64
  (if (= 0 (const-eq 5 (+ 5 4294967296))) 1 0))
