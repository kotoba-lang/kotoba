(ns vehicle.controls-test (:export [main]) (:require [vehicle.controls :as p]))

(defn- fedn [d :document k :keyword] :string
  (document-edn-print (option-or (document-get d k) (document-null))))

(defn main [] :i64
  (let [c (p/coast)]
    (+ (if (= (document-count c) 7) 0 1)
       (if (string=? (fedn c :throttle) "0.0") 0 1)
       (if (string=? (fedn c :steer) "0.0") 0 1)
       (if (string=? (fedn c :requested-gear) "1") 0 1)
       (if (string=? (fedn c :ignition) "true") 0 1)
       (if (string=? (fedn (p/default-controls) :clutch-pedal) "0.0") 0 1))))
