(ns vehicle.triangle-test
  (:require [vehicle.triangle :as t])
  (:export [main]))

;; Returns the number of failed cases (0 = pass).
(defn main [] :i64
  (let [tri (t/new-triangle 1 2 3 4)
        aero (t/with-aero tri 0.5 0.1)
        grp (t/with-group aero :wing)]
    (+ (if (= (record-get [:record :vehicle.triangle/Triangle [[:id :i64] [:n1 :i64] [:n2 :i64] [:n3 :i64] [:drag-coef :f64] [:lift-coef :f64] [:group :keyword]]] tri :n3) 4) 0 1)
       (+ (if (f64-eq (record-get [:record :vehicle.triangle/Triangle [[:id :i64] [:n1 :i64] [:n2 :i64] [:n3 :i64] [:drag-coef :f64] [:lift-coef :f64] [:group :keyword]]] tri :drag-coef) 0.30) 0 1)
          (+ (if (= (record-get [:record :vehicle.triangle/Triangle [[:id :i64] [:n1 :i64] [:n2 :i64] [:n3 :i64] [:drag-coef :f64] [:lift-coef :f64] [:group :keyword]]] tri :group) :body) 0 1)
             (+ (if (f64-eq (record-get [:record :vehicle.triangle/Triangle [[:id :i64] [:n1 :i64] [:n2 :i64] [:n3 :i64] [:drag-coef :f64] [:lift-coef :f64] [:group :keyword]]] aero :drag-coef) 0.5) 0 1)
                (+ (if (f64-eq (record-get [:record :vehicle.triangle/Triangle [[:id :i64] [:n1 :i64] [:n2 :i64] [:n3 :i64] [:drag-coef :f64] [:lift-coef :f64] [:group :keyword]]] grp :lift-coef) 0.1) 0 1)
                   (if (= (record-get [:record :vehicle.triangle/Triangle [[:id :i64] [:n1 :i64] [:n2 :i64] [:n3 :i64] [:drag-coef :f64] [:lift-coef :f64] [:group :keyword]]] grp :group) :wing) 0 1))))))))
