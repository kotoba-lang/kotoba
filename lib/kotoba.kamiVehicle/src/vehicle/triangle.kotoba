(ns vehicle.triangle
  (:export [new-triangle with-aero with-group]))

;; Kotoba port of lib/kotoba.kamiVehicle/src/vehicle/triangle.cljk.
;; Named divergence: the Clojure map is the record Triangle (map literals are
;; not in the language, E2116). Node references and ids are integers, as in
;; the builder that creates them (next-tri counter).
;; group is one of :body :wing :underbody :window.

(defrecord Triangle [id :i64 n1 :i64 n2 :i64 n3 :i64
                     drag-coef :f64 lift-coef :f64 group :keyword])

(defn new-triangle [id :i64 n1 :i64 n2 :i64 n3 :i64] [:record :vehicle.triangle/Triangle [[:id :i64] [:n1 :i64] [:n2 :i64] [:n3 :i64] [:drag-coef :f64] [:lift-coef :f64] [:group :keyword]]]
  (->Triangle id n1 n2 n3 0.30 0.0 :body))

(defn with-aero [tri [:record :vehicle.triangle/Triangle [[:id :i64] [:n1 :i64] [:n2 :i64] [:n3 :i64] [:drag-coef :f64] [:lift-coef :f64] [:group :keyword]]] drag :f64 lift :f64] [:record :vehicle.triangle/Triangle [[:id :i64] [:n1 :i64] [:n2 :i64] [:n3 :i64] [:drag-coef :f64] [:lift-coef :f64] [:group :keyword]]]
  (record-assoc [:record :vehicle.triangle/Triangle [[:id :i64] [:n1 :i64] [:n2 :i64] [:n3 :i64] [:drag-coef :f64] [:lift-coef :f64] [:group :keyword]]]
                (record-assoc [:record :vehicle.triangle/Triangle [[:id :i64] [:n1 :i64] [:n2 :i64] [:n3 :i64] [:drag-coef :f64] [:lift-coef :f64] [:group :keyword]]] tri :drag-coef drag)
                :lift-coef lift))

(defn with-group [tri [:record :vehicle.triangle/Triangle [[:id :i64] [:n1 :i64] [:n2 :i64] [:n3 :i64] [:drag-coef :f64] [:lift-coef :f64] [:group :keyword]]] g :keyword] [:record :vehicle.triangle/Triangle [[:id :i64] [:n1 :i64] [:n2 :i64] [:n3 :i64] [:drag-coef :f64] [:lift-coef :f64] [:group :keyword]]]
  (record-assoc [:record :vehicle.triangle/Triangle [[:id :i64] [:n1 :i64] [:n2 :i64] [:n3 :i64] [:drag-coef :f64] [:lift-coef :f64] [:group :keyword]]] tri :group g))
