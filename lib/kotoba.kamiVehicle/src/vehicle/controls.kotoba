;; Port of vehicle.controls (controls.cljk), Kotoba-native, :document maps.
;;
;; Ported: default-controls and coast (constant maps with f64 zeros).
;; NOT ported: clamp-inputs. It needs f64 comparison (min/max over the
;; normalised inputs), which the Kotoba subset does not provide. A clamp that
;; is not faithful is not offered as a substitute.

(ns vehicle.controls
  (:export [default-controls coast]))

(defn default-controls [] :document
  (document-map :throttle (document-f64 0.0)
                :brake (document-f64 0.0)
                :handbrake (document-f64 0.0)
                :clutch-pedal (document-f64 0.0)
                :steer (document-f64 0.0)
                :requested-gear (document-i64 1)
                :ignition (document-bool true)))

(defn coast [] :document
  (default-controls))
