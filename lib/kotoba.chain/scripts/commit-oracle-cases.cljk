;; scripts/commit-oracle-cases.cljk -- chain.commit (pure Kotoba) against
;; chain.core/commit! (the .cljk oracle).
;;
;;   NODE_PATH=<node_modules with @noble/hashes> \
;;     kbb --backend sci --classpath "src:$(kbb -Spath)" scripts/commit-oracle-cases.cljk
;;
;; Rebuilds the four commits src/chain/commit.kotoba's test-* encode, through the
;; oracle, and checks both the bytes (as hex) and the CIDs those tests and the
;; capability probe in migration/commit-v1.edn expect.

(require '[chain.core :as c] '[ipld.core :as ipld])

(def store (atom {}))
(defn put! [cid bytes] (swap! store assoc cid bytes))
(defn get-fn [cid] (get @store cid))
(defn hex [b] (apply str (map #(let [s (.toString (bit-and % 0xff) 16)] (if (= 1 (count s)) (str "0" s) s)) b)))

(def expected
  {
   :genesis ["bafyreifqadrc6zsb42yzhekvsxvaiab7shq4bdeh74elm62s5ntweuip74" "a363736571006470726576f66573746174656173"]
   :next ["bafyreiesvnd355et2umrfswrn5wuwcrblyskunzizbdagocrkj3wpotdpa" "a363736571016470726576d82a58250001711220b000e22f6641e6b193915595ea04003f91e1c08c87ff08b67b52eb6762510fff6573746174656174"]
   :link-state ["bafyreia22fwxrgrehz3uxm4sti7njora7m7fdxfdqqlmjfehmreqtudio4" "a363736571006470726576f6657374617465d82a58250001551220e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"]
   :causal ["bafyreihdd5i4tv7nms4j72z7oehwidygfckaj5if2g4lz3s5nokcvpmnqa" ""]
   })

(let [l "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
      g (c/commit! put! get-fn "s" nil)
      n (c/commit! put! get-fn "t" g)
      ls (c/commit! put! get-fn (ipld/link l) nil)
      x (c/commit! put! get-fn "u" n {:causes [g] :authority l :actor "did:key:z6Mk"})
      got {:genesis [g (hex (get-fn g))] :next [n (hex (get-fn n))]
           :link-state [ls (hex (get-fn ls))] :causal [x (hex (get-fn x))]}
      bad (remove (fn [[k v]] (= v (get got k))) expected)]
  (doseq [[k v] bad] (println "DISAGREE" k "expected" v "oracle" (get got k)))
  (println (str "SCANNED\t" (count expected) "\tcommits; " (- (count expected) (count bad)) " agree"))
  (when (or (empty? expected) (seq bad)) (js/process.exit 1)))
