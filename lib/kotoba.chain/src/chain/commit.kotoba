;; chain.commit -- encoding a chain commit in pure Kotoba.
;;
;; root ADR-2610082200 §16, plan C step A. chain.core (core.cljk) stays the
;; oracle. A commit is the DAG-CBOR map chain.core/encode-commit writes:
;;   "state"  the opaque state value          (always)
;;   "prev"   tag-42 link, or null at genesis (always)
;;   "seq"    integer                         (always)
;;   "causes" array of links    (only when there are causes)
;;   "authority" link           (only when given)
;;   "actor"  text              (only when given)
;;   "lamport" integer          (only when given)
;; Writing an optional field only when it is supplied is the oracle's rule, so
;; a plain commit and an old commit keep their bytes and their CIDs.
;;
;; Two shape changes, because a guest has no host storage and no document
;; traversal:
;; - state arrives ENCODED (its DAG-CBOR bytes): the commit never looks inside
;;   it, and a general encoder waits on step B
;; - lamport arrives computed (1 + max over the parents' clocks, next-lamport
;;   below); the oracle fetches the parents itself, here the conductor does
;; Absent is "" for a text or link field, an empty causes map, and -1 for
;; lamport. causes is a [:map :i64 :string] keyed 0..n-1 in order.

(ns chain.commit
  (:require [ipld.dag-cbor-write :as w]
            [multiformats.cid :as cid])
  (:export [encode-commit next-lamport
            main test-genesis test-next test-link-state test-causal test-next-lamport]))

(defn- link-or-null [c :string] :vector-i64
  (if (= (string-byte-length c) 0) (w/null-item) (w/link-item c)))

(defn- links [causes [:map :i64 :string]] :vector-i64
  (let [n (typed-map-count [:map :i64 :string] causes)]
    (loop [i 0 acc (w/array-head n)]
      (if (>= i n) acc (recur (+ i 1) (w/append acc (w/link-item (get causes i ""))))))))

(defn- put [m [:map :string :bytes] k :string v :vector-i64] [:map :string :bytes]
  (typed-map-assoc [:map :string :bytes] m k (bytes-from-vector-i64 v)))

(defn encode-commit [state :bytes prev :string seq :i64 causes [:map :i64 :string]
                     authority :string actor :string lamport :i64] :vector-i64
  (let [has-causes (> (typed-map-count [:map :i64 :string] causes) 0)
        has-authority (> (string-byte-length authority) 0)
        has-actor (> (string-byte-length actor) 0)
        has-lamport (>= lamport 0)
        k0 (typed-set-new [:set :string] "state" "prev" "seq")
        k1 (if has-causes (typed-set-conj [:set :string] k0 "causes") k0)
        k2 (if has-authority (typed-set-conj [:set :string] k1 "authority") k1)
        k3 (if has-actor (typed-set-conj [:set :string] k2 "actor") k2)
        keys (if has-lamport (typed-set-conj [:set :string] k3 "lamport") k3)
        v0 (typed-map-new [:map :string :bytes] "state" state
                          "prev" (bytes-from-vector-i64 (link-or-null prev))
                          "seq" (bytes-from-vector-i64 (w/int-item seq)))
        v1 (if has-causes (put v0 "causes" (links causes)) v0)
        v2 (if has-authority (put v1 "authority" (w/link-item authority)) v1)
        v3 (if has-actor (put v2 "actor" (w/text-item actor)) v2)
        values (if has-lamport (put v3 "lamport" (w/int-item lamport)) v3)]
    (w/map-item keys values)))

(defn next-lamport [clocks [:map :i64 :i64]] :i64
  ;; 1 + max over the parents' clocks (a pre-causal parent's clock is its seq);
  ;; 0 when there are no parents
  (let [n (typed-map-count [:map :i64 :i64] clocks)]
    (if (= n 0)
      0
      (loop [i 0 best 0]
        (if (>= i n) (+ best 1) (recur (+ i 1) (let [c (get clocks i 0)] (if (> c best) c best))))))))

;; --- tests: bytes written by chain.core/commit! on 2026-10-09 ---------------

(defn- pass [b :bool] :i64 (if b 1 0))
(defn- same? [a :vector-i64 b :vector-i64] :bool
  (let [n (vector-count a)]
    (if (not (= n (vector-count b)))
      false
      (loop [i 0] (if (>= i n) true (if (= (vector-at a i) (vector-at b i)) (recur (+ i 1)) false))))))
(defn- none [] [:map :i64 :string] (typed-map-new [:map :i64 :string]))
(defn- text-state [s :string] :bytes (bytes-from-vector-i64 (w/text-item s)))

(defn test-genesis [] :i64
  (pass (same? (encode-commit (text-state "s") "" 0 (none) "" "" -1)

               (cid/hex->bytes "a363736571006470726576f66573746174656173"))))

(defn test-next [] :i64
  (pass (same? (encode-commit (text-state "t") "bafyreifqadrc6zsb42yzhekvsxvaiab7shq4bdeh74elm62s5ntweuip74" 1 (none) "" "" -1)

               (cid/hex->bytes "a363736571016470726576d82a58250001711220b000e22f6641e6b193915595ea04003f91e1c08c87ff08b67b52eb6762510fff6573746174656174"))))

(defn test-link-state [] :i64
  (pass (same? (encode-commit (bytes-from-vector-i64 (w/link-item "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku")) "" 0 (none) "" "" -1)

               (cid/hex->bytes "a363736571006470726576f6657374617465d82a58250001551220e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))))

(defn test-causal [] :i64
  (pass (same? (encode-commit (text-state "u") "bafyreiesvnd355et2umrfswrn5wuwcrblyskunzizbdagocrkj3wpotdpa" 2 (typed-map-new [:map :i64 :string] 0 "bafyreifqadrc6zsb42yzhekvsxvaiab7shq4bdeh74elm62s5ntweuip74")
                              "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku" "did:key:z6Mk" 2)

               (cid/hex->bytes ""))))

(defn test-next-lamport [] :i64
  (pass (and (= 0 (next-lamport (typed-map-new [:map :i64 :i64])))
             (= 2 (next-lamport (typed-map-new [:map :i64 :i64] 0 1 1 0))))))

;; main: the number of test-* that pass (5 when all do).
(defn main [] :i64
  (+ (test-genesis) (test-next) (test-link-state) (test-causal) (test-next-lamport)))
