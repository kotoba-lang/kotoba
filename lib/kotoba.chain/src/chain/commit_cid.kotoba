;; chain.commit-cid -- the CID of an encoded commit: CIDv1, dag-cbor codec, over
;; sha2-256 from the hash/sha256 capability (wire id 3, a :bytes request; a
;; guest declares [:cap/call 3]). Kept apart from chain.commit so the encoder
;; stays effect-free and testable without a capability.

(ns chain.commit-cid
  (:require [multiformats.cid :as cid])
  (:export [commit-cid]))

(defn commit-cid [bytes :bytes] :string
  (cid/cidv1 113 (hash/sha256 bytes)))
