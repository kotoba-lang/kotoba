{:paths ["src"]
 ;; chain (renamed from commit-dag, ADR-2607050800 -- names the parent-linked
 ;; chain structure this repo actually is, without the collision `log` would
 ;; have had with the unrelated, already-existing kotoba-lang/log), Wave 1/2
 ;; of ADR-2607022600. Same one Wave-0 dep as prolly-tree, but independent of
 ;; it -- a commit wraps an opaque `state` value (typically a prolly-tree
 ;; root CID, or arrangement's 4-index roots as a map of {index-name cid}),
 ;; so this namespace has no compile-time dependency on prolly-tree or
 ;; arrangement.
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/io-ipld {:local/root "../kotoba.ioIpld"}}
 :aliases
 {:test {:extra-paths ["test"]}}}
