(defn- rg-doc [] :vector-i64 (rg-hex "7b22736368656d61223a312c226e6f646573223a5b7b226e6f6465223a22623730222c22646964223a226469643a6b65793a7a364d6b227d2c7b226e6f6465223a226b3136222c22647261696e223a747275657d5d2c226e616d65223a22615c22625c7530306539222c226e6567223a2d34322c22626967223a393030373139393235343734303939327d"))

(defn- rg-navigation [] :bool
  (let [b (rg-doc) nodes (json-member b 0 "nodes") n1 (json-element b nodes 1)]
    (and (json-valid? b) (= (json-kind b 0) 1) (= (json-count b 0) 5)
         (= (json-kind b nodes) 2) (= (json-count b nodes) 2) (= (json-element b nodes 2) -1)
         (= (json-kind b n1) 1) (= (json-string b (json-member b n1 "node")) "k16")
         (= (json-kind b (json-member b n1 "drain")) 5) (= (json-member b n1 "did") -1)
         (= (json-string b (json-member b (json-element b nodes 0) "did")) "did:key:z6Mk")
         (= (hex (json-string-bytes b (json-member b 0 "name"))) "612262c3a9")
         (= (json-int b (json-member b 0 "schema")) 1)
         (json-int-ok? b (json-member b 0 "neg")) (= (json-int b (json-member b 0 "neg")) -42)
         (not (json-int-ok? b (json-member b 0 "big")))
         (= (json-member b 0 "missing") -1) (= (json-member b nodes "node") -1))))

(defn- rg-reasons [] :bool
  (and (= (json-end (rg-hex "5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5b5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d5d") 0) -2)
       (= (json-end (rg-hex "7b2261223a312c2261223a327d") 0) -5)
       (= (json-end (rg-hex "7b225c7530303631223a317d") 0) -6)
       (= (json-end (rg-hex "22610122") 0) -3)
       (= (json-end (rg-hex "312e") 0) -4)
       (= (json-end (rg-hex "5b312c5d") 0) -1)))

(defn main [] :i64
  (let [n (rg-corpus) x (rg-say (string-concat "cases " (string-from-i64 n)))]
    (+ (if (rg-navigation) 1 0) (if (rg-reasons) 2 0))))
