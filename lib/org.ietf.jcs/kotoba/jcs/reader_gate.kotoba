;; jcs.reader-gate -- generated by docs/evidence/reader-corpus-20261023.py emit; do not edit.
;; One line per case: case <name> <valid 0|1> <end code> <canonical 0|1> <canonical bytes hex|-> [<decoded hex>|<int>].
(ns jcs.reader-gate (:export [main]))

(defn- rg-hex [s :string] :vector-i64
  (let [b (vector-i64-from-bytes (string-to-utf8 s)) n (quot (vector-count b) 2)]
    (loop [i 0 out (vector-alloc n)]
      (if (= i n) out
        (let [h (vector-at b (* 2 i)) l (vector-at b (+ (* 2 i) 1))
              v (+ (* 16 (if (< h 58) (- h 48) (- h 87))) (if (< l 58) (- l 48) (- l 87)))]
          (recur (+ i 1) (vector-assoc! out i v)))))))

(defn- rg-say [s :string] :i64 (let [x (typed-cap-call :io/write :string :string (string-concat s "\n"))] 0))

(defn- rg-case [name :string hx :string] :i64
  (let [b (rg-hex hx) s (loop [j 0] (if (and (< j (vector-count b)) (or (= (vector-at b j) 32) (= (vector-at b j) 9) (= (vector-at b j) 10) (= (vector-at b j) 13))) (recur (+ j 1)) j))
        e (json-end b s) ok (json-valid? b)
        canon (if ok (json-canonical? b) false)
        cb (if ok (json-canonical-bytes b s) (vector-alloc 0))
        extra (cond (and ok (= (json-kind b s) 3)) (string-concat " " (hex (json-string-bytes b s)))
                    (and ok (= (json-kind b s) 4) (json-int-ok? b s)) (string-concat " " (string-from-i64 (json-int b s)))
                    :else "")]
    (rg-say (str "case " name " " (if ok 1 0) " " e " " (if canon 1 0) " " (if (> (vector-count cb) 0) (hex cb) "-") extra))))

