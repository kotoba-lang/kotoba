  :service/t2-engine :browser-use
  :service/tier :t2-headless-browser
  :service/rate-limit "self-throttle; human-paced"
  :service/representative true}

 ;; ── ToS forbids automation → T2 refused by construction (G2 gate counter-example) ──
 {:service/id "noauto-saas"
