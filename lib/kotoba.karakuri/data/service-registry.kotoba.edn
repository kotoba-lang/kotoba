 ;; ── Google — official APIs sanctioned (Gmail / Drive / Calendar / Search Console via OAuth2),
 ;;    but CONSUMER-SURFACE browser automation is ToS-prohibited (no automated queries / scraping).
 ;;    → karakuri routes T1 (the API) and REFUSES T2 browser-use by construction (G2). The charter-
 ;;    clean reading of "browser-operate Google": don't — drive the official API on the member's own
 ;;    Google account instead. ──
 {:service/id "google"
  :service/name "Google (Workspace / consumer)"
  :service/category :productivity
  :service/official-api true
  :service/auth-model :oauth2
  :service/tos-stance :api-ok
  :service/t2-stance :prohibited
  :service/tier :t1-official-api
  :service/rate-limit "per-API quota (Gmail/Drive/Calendar)"
  :service/representative true}

 ;; ── Facebook / Meta — Graph API sanctioned for the member's OWN Pages/business assets (OAuth2),
 ;;    but personal-account browser automation / automated data collection is ToS-prohibited.
 ;;    → T1 (Graph API) for what it covers; T2 browser-use REFUSED by construction (G2). ──
 {:service/id "facebook"
  :service/name "Facebook / Meta"
  :service/category :social
  :service/official-api true
  :service/auth-model :oauth2
  :service/tos-stance :api-ok
  :service/t2-stance :prohibited
  :service/tier :t1-official-api
  :service/rate-limit "Graph API rate tier per app"
  :service/representative true}

 ;; ── No usable official API for the member's task → T2 browser-use, but ONLY if ToS permits ──
 {:service/id "legacy-portal"
  :service/name "Generic GUI-only portal (no API)"
  :service/category :productivity
  :service/official-api false
  :service/auth-model :session-cookie
