;; karakuri (絡繰) kotoba EAVT schema — web-service-to-CLI (R0)
;; Every planned + executed ServiceOp is a Datom (G7 audit; as-of, replayable; 非終末論 — no final state).
[;; ── service capability + ToS registry ─────────────────────────────────────────
 {:db/ident :service/id            :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :service/name          :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :service/category      :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}  ;; :site-builder :cms :commerce :payments :dev :productivity
 {:db/ident :service/official-api  :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}
 {:db/ident :service/auth-model    :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}  ;; :oauth2 :api-key :session-cookie :pat
 {:db/ident :service/tos-stance    :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}  ;; OFFICIAL-API stance: :api-ok :automation-allowed :automation-restricted :automation-prohibited
 {:db/ident :service/t2-stance     :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}  ;; BROWSER-AUTOMATION stance (G2): :permitted :restricted :prohibited (missing => :prohibited, default-deny). Google/Facebook = :prohibited even though :api-ok
 {:db/ident :service/t2-engine     :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}  ;; :browser-use (LangGraph browser agent over Playwright); present ONLY where t2-stance permits
 {:db/ident :service/tier          :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}  ;; :t1-official-api :t2-headless-browser :t3-structured-export
 {:db/ident :service/rate-limit    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :service/representative :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}  ;; G8

 ;; ── normalized ServiceOp (the uniform vocabulary) ─────────────────────────────
 {:db/ident :op/id                 :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :op/service            :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
 {:db/ident :op/noun               :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}   ;; pages / database / products / repos …
 {:db/ident :op/verb               :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}   ;; list / get / create / update / delete / export
 {:db/ident :op/safety             :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}   ;; :read :create :update :delete
 {:db/ident :op/destructive        :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}
 {:db/ident :op/adapter-tier       :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}   ;; :t1-official-api …
 {:db/ident :op/t2-engine          :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}   ;; :browser-use — set ONLY on a permitted T2 op (G2)
 {:db/ident :op/args               :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}   ;; serialized flags (kept; no secrets)
 {:db/ident :op/planned-at         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}   ;; as-of plan history (G7)
 {:db/ident :op/executed-at        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}   ;; as-of exec history (G7)
 {:db/ident :op/dry-run            :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}   ;; G6: R0 always true
 {:db/ident :op/tos-gate           :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}   ;; :ok :refused-automation-prohibited
 {:db/ident :op/mutate-gate        :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}   ;; :read-allowed :awaiting-member-sig :authorized

 ;; ── command plan (NL -> ServiceOp[]) ──────────────────────────────────────────
 {:db/ident :plan/id               :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :plan/brief            :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :plan/op               :db/valueType :db.type/ref     :db/cardinality :db.cardinality/many}
 {:db/ident :plan/charter-clean    :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}   ;; N6 / Charter-Rider scan

 ;; ── member session grant (NO secret material — only references; G3) ───────────
 {:db/ident :grant/id              :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :grant/principal       :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}   ;; G1 :member
 {:db/ident :grant/account-owner   :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}   ;; G1 :member (own account)
 {:db/ident :grant/server-held-key :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}   ;; G3 false
 {:db/ident :grant/secret-ref      :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}   ;; encrypted-envelope ref ONLY (ADR-2605181100); never plaintext
 {:db/ident :grant/authorized-by   :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}   ;; G3 :member
 {:db/ident :grant/server-signed   :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}   ;; G3 false

 ;; ── export artifact (data portability; T3) ────────────────────────────────────
 {:db/ident :export/id             :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :export/service        :db/valueType :db.type/ref     :db/cardinality :db.cardinality/one}
 {:db/ident :export/format         :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}   ;; :kotoba-edn :json :csv :markdown
 {:db/ident :export/owner          :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one}   ;; G9 :member (own data only)
 {:db/ident :export/encrypted      :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}   ;; G9
 {:db/ident :export/cid            :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}]
