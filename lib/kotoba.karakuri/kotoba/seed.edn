;; karakuri (絡繰) kotoba seed — :representative example ServiceOps + a member session grant (R0).
;; All ops are dry-run (G6) and never carry secret material (G3). Illustrates the gate classifications:
;;   read op  -> :read-allowed (ships at R0)
;;   mutate   -> :awaiting-member-sig (G5)
;;   T2 on an :automation-prohibited service -> :refused-automation-prohibited (G2)
[;; a member's own Squarespace site, read op — safe at R0
 {:op/id "op:squarespace:pages.list:0001"
  :op/noun "pages" :op/verb "list"
  :op/safety :read :op/destructive false
  :op/adapter-tier :t1-official-api
  :op/dry-run true
  :op/tos-gate :ok
  :op/mutate-gate :read-allowed
  :op/planned-at "2026-06-03T00:00:00Z"}

 ;; a member's own Notion DB, mutate op — gated on member signature (G5)
 {:op/id "op:notion:database.update:0002"
  :op/noun "database" :op/verb "update"
  :op/safety :update :op/destructive false
  :op/adapter-tier :t1-official-api
  :op/dry-run true
  :op/tos-gate :ok
  :op/mutate-gate :awaiting-member-sig
  :op/planned-at "2026-06-03T00:00:00Z"}

 ;; a destructive op — member-sig + explicit dry-run confirm required (G5)
 {:op/id "op:shopify:products.delete:0003"
  :op/noun "products" :op/verb "delete"
  :op/safety :delete :op/destructive true
  :op/adapter-tier :t1-official-api
  :op/dry-run true
  :op/tos-gate :ok
  :op/mutate-gate :awaiting-member-sig
  :op/planned-at "2026-06-03T00:00:00Z"}

 ;; T2 headless on a ToS-automation-prohibited service — refused by construction (G2)
 {:op/id "op:noauto-saas:records.list:0004"
  :op/noun "records" :op/verb "list"
  :op/safety :read :op/destructive false
  :op/adapter-tier :t2-headless-browser
  :op/dry-run true
  :op/tos-gate :refused-automation-prohibited
  :op/mutate-gate :read-allowed
  :op/planned-at "2026-06-03T00:00:00Z"}

 ;; a member's own Gmail, read op — :api-ok → routed to the official API (T1), NOT browser-automated
 {:op/id "op:google:messages.list:0005"
  :op/noun "messages" :op/verb "list"
  :op/safety :read :op/destructive false
  :op/adapter-tier :t1-official-api
  :op/dry-run true
  :op/tos-gate :ok
  :op/mutate-gate :read-allowed
  :op/planned-at "2026-06-04T00:00:00Z"}

 ;; Facebook browser automation FORCED to T2 — refused by construction (api-ok but browser-prohibited, G2)
 {:op/id "op:facebook:posts.list:0006"
  :op/noun "posts" :op/verb "list"
  :op/safety :read :op/destructive false
  :op/adapter-tier :t2-headless-browser
  :op/dry-run true
  :op/tos-gate :refused-automation-prohibited
  :op/mutate-gate :read-allowed
  :op/planned-at "2026-06-04T00:00:00Z"}

 ;; a GUI-only portal whose ToS permits automation → T2 via the browser-use engine (the legit T2 path)
 {:op/id "op:legacy-portal:records.list:0007"
  :op/noun "records" :op/verb "list"
  :op/safety :read :op/destructive false
  :op/adapter-tier :t2-headless-browser
  :op/t2-engine :browser-use
  :op/dry-run true
  :op/tos-gate :ok
  :op/mutate-gate :read-allowed
  :op/planned-at "2026-06-04T00:00:00Z"}

 ;; member session grant — NO secret, encrypted-envelope ref only, member-signed (G1/G3)
 {:grant/id "grant:member:squarespace:0001"
  :grant/principal :member
  :grant/account-owner :member
  :grant/server-held-key false
  :grant/secret-ref "encref:com.etzhayyim.encrypted/squarespace-session"
  :grant/authorized-by :member
  :grant/server-signed false}]
