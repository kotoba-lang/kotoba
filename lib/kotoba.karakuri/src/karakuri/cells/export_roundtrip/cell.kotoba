(ns karakuri.cells.export-roundtrip.cell
  ;; Parity port of src/karakuri/cells/export_roundtrip/cell.cljk — the
  ;; karakuri export_roundtrip (絡繰) cell scaffold (LangGraph Pregel wrapper,
  ;; unit_refactor stage 0). The original signals the R0 scaffold state with a
  ;; throw; here that failure is a value: [:result :string :string] whose :err
  ;; payload is the same message the ex-info carried. init stays the empty
  ;; state (an empty [:list :string]).
  (:export [export-roundtrip-cell-init export-roundtrip-cell-solve]))

(defn export-roundtrip-cell-init [] [:list :string]
  (list))

(defn export-roundtrip-cell-solve [this input-state] [:result :string :string]
  (result-err-of [:result :string :string]
                 "karakuri R0 scaffold: activate export_roundtrip via Council ADR (post-2606039200)"))
