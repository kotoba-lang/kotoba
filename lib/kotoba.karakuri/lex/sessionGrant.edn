[{:db/id -1, :sessionGrant/lexicon 1, :sessionGrant/id "com.etzhayyim.karakuri.sessionGrant", :sessionGrant/description "The defining karakuri record: a reference to the member's OWN service session, holding NO secret material — only an encrypted-envelope ref (ADR-2605181100). Member-principal (G1), no-server-key (G3).", :sessionGrant/defs "{:main {:type \"record\", :key \"tid\", :record {:type \"object\", :required [\"service\" \"principal\" \"accountOwner\" \"serverHeldKey\" \"secretRef\" \"authorizedBy\" \"serverSigned\" \"createdAt\"], :properties {:service {:type \"string\"}, :principal {:type \"string\", :const \"member\", :description \"G1 invariant — the member is the principal, never karakuri/the org\"}, :accountOwner {:type \"string\", :const \"member\", :description \"G1 invariant — karakuri drives only the member's OWN account; no third-party account\"}, :serverHeldKey {:type \"boolean\", :const false, :description \"G3 invariant — no platform-held credential/session (ADR-2605231525)\"}, :secretRef {:type \"string\", :description \"G3 — encrypted-envelope reference ONLY (com.etzhayyim.encrypted.*); plaintext credentials are NEVER stored\"}, :authorizedBy {:type \"string\", :enum [\"member\"], :description \"G3 — member signature authorizes; server signature refused\"}, :serverSigned {:type \"boolean\", :const false, :description \"G3 invariant — server signature refused\"}, :createdAt {:type \"string\", :format \"datetime\"}}}}}"}]
