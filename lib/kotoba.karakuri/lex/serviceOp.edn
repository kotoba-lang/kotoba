[{:db/id -1, :serviceOp/lexicon 1, :serviceOp/id "com.etzhayyim.karakuri.serviceOp", :serviceOp/defs "{:main {:type \"record\", :key \"tid\", :record {:type \"object\", :required [\"service\" \"noun\" \"verb\" \"safety\" \"destructive\" \"adapterTier\" \"dryRun\" \"tosGate\" \"mutateGate\"], :properties {:args {:type \"string\", :description \"serialized flags; never contains secret material (G3)\"}, :dryRun {:type \"boolean\", :const true, :description \"G6 invariant — R0 is plan/dry-run only; live execution Council Lv6+ + operator gated\"}, :tosGate {:type \"string\", :enum [\"ok\" \"refused-automation-prohibited\"], :description \"G2 — T2 on an :automation-prohibited service is refused by construction\"}, :service {:type \"string\", :description \"service id from the :representative registry\"}, :executedAt {:type \"string\", :format \"datetime\", :description \"G7 as-of exec history (gated)\"}, :verb {:type \"string\", :description \"list / get / create / update / delete / export\"}, :mutateGate {:type \"string\", :enum [\"read-allowed\" \"awaiting-member-sig\" \"authorized\"], :description \"G5 — read ships at R0; mutate requires member signature\"}, :adapterTier {:type \"string\", :enum [\"t1-official-api\" \"t2-headless-browser\" \"t3-structured-export\"], :description \"official-API-first (G2)\"}, :safety {:type \"string\", :enum [\"read\" \"create\" \"update\" \"delete\"], :description \"classified op safety\"}, :destructive {:type \"boolean\", :description \"true for delete / irreversible mutations\"}, :plannedAt {:type \"string\", :format \"datetime\", :description \"G7 as-of plan history\"}, :noun {:type \"string\", :description \"resource noun (pages / database / products / repos …)\"}}}}}"}]
