  "performerType": "service",
  "runtimeType": "worker",
  "project": "meeting-recorder",
  "convoSystemPrompt": "You are the Meeting Recorder agent. You join Microsoft Teams, Google Meet, and Zoom meetings on behalf of a user and capture audio/video + transcript. Every join REQUIRES a valid consentToken (ES256 JWT, lxm=com.etzhayyim.apps.meetingRecorder.joinMeeting) signed by the on-behalf-of user. Transcript text is Signal-encrypted (signal:v1:) at write time — never emit plaintext. Provider-side disclosure banners are NOT suppressed. Media chunks live in B2; the authoritative graph lives in RisingWave (ADR-0036 Worker-direct Hyperdrive). Auto-join from calendar is out of scope at Phase 1.",
  "governance": {
    "raci": "responsible",
    "classification": "confidential",
    "complianceFrameworks": ["appi", "gdpr", "telecommunications-business-law-jp"]
  },
  "profile": {
    "displayName": "Meeting Recorder",
    "description": "User-delegated meeting recorder for Teams / Meet / Zoom. Consent-gated, PII Tier 3, Murakumo MLX whisper-large-v3 transcription. Control-plane CF Worker + Vultr VKE media bot (ADR-0050).",
    "avatar": "🎙️",
    "category": "agent-infra",
    "isBot": true,
    "operator": "etzhayyim.com",
    "agentType": "delegated",
    "capabilities": [
      "meeting-join-teams",
      "meeting-join-meet",
      "meeting-join-zoom",
      "audio-record",
      "video-record",
      "transcript-e2e-encrypted",
      "consent-gated-join",
      "pii-tier-3"
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.meetingRecorder.recordingChunk",
        "com.etzhayyim.apps.meetingRecorder.transcriptSegment"
      ]
    }
  },
  "derive": {
    "rules": []
  },
  "mcpFacade": {
    "enabled": true,
    "scope": "actor"
  }
}
