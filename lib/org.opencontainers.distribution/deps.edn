{:paths ["src"]
 ;; kotobase (kotoba-lang/kotobase) provides the IStore/ITransactionalStore
 ;; seam (kotobase.store) and the LocalStore oracle (kotobase.local) this
 ;; library projects the OCI Distribution Spec surface over. Pinned to the
 ;; same SHA kotoba-lang/kotobase-protocols pins (verified current against
 ;; kotobase's default branch HEAD on 2026-07-17).
 :deps {
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/edn {:local/root "../kotoba.edn"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/kotobase
        {:git/sha "bbf57df9dde5c1869182012860129a598382e088"}}
 ;; First-class runtime is nbb/cljs (repo-wide runtime priority):
 ;;   kbb --backend sci --classpath "src:test:<kotobase>/src" bin/run_tests.cljk
 ;; The :test alias below is the :clj COMPAT suite only — not the
 ;; primary execution path.
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {
                      ;; The Kotoba compiler and KIR interpreter, so
                      ;; `kotoba/oci/reference.kotoba` is driven by the
                      ;; suite rather than described by it.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "2cb7d3f18205eadb3791441d3c3e09d9eb9b1a22"}
                      io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.osaho"}}}}}
