(ns kotoba.bangou
  "番号法 — whether you may hold a 個人番号 at all.

  ## The API does not take a 個人番号, and that is the design

  Every function here answers a question about a **purpose**. None of them
  accepts a number. A library with a `(valid? my-number)` in it has been
  handed the thing 第二十条 is about, and a caller who reached for it has
  already collected. So the number never crosses this boundary.

  What that costs: this library **cannot tell you whether a number is
  well-formed**. See `:not-read` below -- the check digit is defined in a
  総務省令 this catalog has not located, and a check digit written from
  memory would silently accept invalid numbers or reject valid ones. The
  cost is smaller than it looks: shape is the least of the questions here.

  ## The rule, read from source

  番号法 第二十条, retrieved 2026-08-19 from the e-Gov law API v2
  (`GET /api/2/law_data/425AC0000000027`):

      何人も、前条各号のいずれかに該当する場合を除き、特定個人情報（他人の
      個人番号を含むものに限る。）を収集し、又は保管してはならない。

  **何人も** -- anyone, not only an administrative organ. The default is
  prohibition, and the exceptions are 第十九条's seventeen 号. So the
  question a caller must answer is never *may I store this?* but *which 号
  am I acting under?*, and this library will not answer the first without
  the second.

  ## Coverage

  `[:jp]` only. `covered?` is false elsewhere and every answer is `:none`
  -- an uncatalogued jurisdiction has not been found permissive, it has not
  been looked at. Other jurisdictions have identifier regimes and this
  catalog has read none of them."
  (:require [kotoba.lang.text :as str]))

;; ---------------------------------------------------------------------------
;; sources
;; ---------------------------------------------------------------------------

(def sources
  "Primary sources, keyed by id. `:law/id` is the e-Gov law id, which is what
  makes a citation checkable against the corpus rather than merely
  reachable."
  {:jp/bangou-ho
   {:source/title "行政手続における特定の個人を識別するための番号の利用等に関する法律"
    :source/authority "日本国 / e-Gov 法令検索"
    :source/kind :statute
    :law/id "425AC0000000027"
    :source/url "https://laws.e-gov.go.jp/law/425AC0000000027"}

   :jp/bangou-rei
   {:source/title "行政手続における特定の個人を識別するための番号の利用等に関する法律施行令"
    :source/authority "日本国 / e-Gov 法令検索"
    :source/kind :statute
    :law/id "426CO0000000155"
    :source/url "https://laws.e-gov.go.jp/law/426CO0000000155"}})

(def catalog-verification
  "What was read verbatim, and what was looked for and not found. The second
  list is the load-bearing one: an absent citation that leaves no trace looks
  identical to one nobody thought of."
  {:catalog/corpus "kotoba-lang/jp.go.e-gov.elaws"
   :catalog/content-verified
   [{:claim :collection-and-retention-are-prohibited-by-default
     :source :jp/bangou-ho
     :provision "番号法 第二十条"
     :retrieved-via "e-Gov law API v2 GET /api/2/law_data/425AC0000000027"
     :retrieved-at "2026-08-19"
     :quote (str "何人も、前条各号のいずれかに該当する場合を除き、特定個人情報"
                 "（他人の個人番号を含むものに限る。）を収集し、又は保管しては"
                 "ならない。")}
    {:claim :specific-personal-information-is-defined-by-containing-the-number
     :source :jp/bangou-ho
     :provision "番号法 第二条第八項"
     :retrieved-via "e-Gov law API v2 GET /api/2/law_data/425AC0000000027"
     :retrieved-at "2026-08-19"
     :quote (str "この法律において「特定個人情報」とは、個人番号（個人番号に"
                 "対応し、当該個人番号に代わって用いられる番号、記号その他の"
                 "符号であって、住民票コード以外のものを含む。）をその内容に"
                 "含む個人情報をいう。")
     :quote-is-partial? true
     :quote-omits "the parenthetical list of provisions where the substitute-code inclusion does not apply"}
    {:claim :related-affairs-implementer-is-a-defined-role
     :source :jp/bangou-ho
     :provision "番号法 第二条第十二項・第十四項"
     :retrieved-via "e-Gov law API v2 GET /api/2/law_data/425AC0000000027"
     :retrieved-at "2026-08-19"
     :quote (str "この法律において「個人番号関係事務」とは、第九条第四項の規定"
                 "により個人番号利用事務に関して行われる他人の個人番号を必要な"
                 "限度で利用して行う事務をいう。…この法律において「個人番号関係"
                 "事務実施者」とは、個人番号関係事務を処理する者及び個人番号関係"
                 "事務の全部又は一部の委託を受けた者をいう。")
     :quote-is-partial? true
     :quote-omits "第十三項（個人番号利用事務実施者）, between the two sentences"}]

   :catalog/not-read
   [{:claim :check-digit
     :why (str "the 個人番号's twelfth digit is a check digit, and the formula "
               "is delegated to a 総務省令 this catalog has not located -- it "
               "is in neither 番号法 nor its 施行令 (第八条 there is about "
               "準法定事務 criteria). A check digit written from memory would "
               "silently accept invalid numbers or reject valid ones, so "
               "there is no shape check here at all.")
     :searched ["425AC0000000027" "426CO0000000155"]
     :searched-at "2026-08-19"}
    {:claim :the-seventeen-grounds-in-detail
     :why (str "第十九条 has seventeen 号 and this catalog has read their "
               "headline text, not their conditions. `ground` therefore "
               "answers WHICH 号 a caller named and whether it exists -- never "
               "whether the caller's facts satisfy it.")
     :searched ["425AC0000000027"]
     :searched-at "2026-08-19"}]})

;; ---------------------------------------------------------------------------
;; the grounds
;; ---------------------------------------------------------------------------

(def grounds
  "第十九条's 号, by number, with the headline of each as read.

  **This is a list of names, not a decision procedure.** Whether a caller's
  facts fall within a 号 is a question about the caller's facts, and this
  catalog has read the headlines rather than the conditions. `ground` says
  whether a 号 exists and what it is called. It does not say you are in it."
  {1  "個人番号利用事務実施者が個人番号利用事務を処理するために必要な限度で提供するとき"
   2  "個人番号関係事務実施者が個人番号関係事務を処理するために必要な限度で提供するとき"
   3  "本人又はその代理人が個人番号利用事務等実施者に対し提供するとき"
   4  "従業者等が転職した場合に、本人の同意を得て前の使用者等から提供するとき"
   5  "機構が第十四条第二項の規定により提供するとき"
   6  "委託・合併その他の事由による事業の承継に伴い提供するとき"
   7  "情報提供ネットワークシステムを通じて提供するとき"
   8  "国税庁長官・地方公共団体の長等が提供するとき"
   9  "地方公共団体情報システム機構が提供するとき"
   10 "委員会が提供を求めるとき"
   11 "訴訟手続その他の裁判所における手続のために必要なとき"
   12 "各議院・委員会等の調査のために必要なとき"
   13 "会計検査院が検査のために必要なとき"
   14 "公益上の必要があるとき"
   15 "人の生命、身体又は財産の保護のために必要があるとき"
   16 "特定個人情報保護評価等に関し必要なとき"
   17 "その他これらに準ずるものとして個人情報保護委員会規則で定めるとき"})

(def jurisdictions
  "Keyed by jurisdiction PATH, as in taxlaw and worklaw. `[:jp]` today."
  {[:jp]
   {:jurisdiction/path [:jp]
    :jurisdiction/label "日本"
    :jurisdiction/retention
    {:rule/default :prohibited
     :rule/review :read-from-source
     :rule/provision "番号法 第二十条"
     :rule/quote (str "何人も、前条各号のいずれかに該当する場合を除き、特定個人"
                      "情報（他人の個人番号を含むものに限る。）を収集し、又は"
                      "保管してはならない。")
     :rule/retrieved-at "2026-08-19"
     :rule/retrieved-via "e-Gov law API v2 GET /api/2/law_data/425AC0000000027"
     :rule/exceptions-in "番号法 第十九条"
     :rule/binds :anyone
     :rule/sources [:jp/bangou-ho]}}})

(defn- normalize
  "Accept `[:jp]` or `:jp`, as taxlaw and worklaw do. Making every call site
  convert is how a shared library stops being used."
  [j]
  (cond (vector? j) j (nil? j) nil :else [j]))

(defn covered? [j] (contains? jurisdictions (normalize j)))

(defn ground
  "第十九条's 号 `n`, or nil.

  nil means *this catalog has no such 号*, which for n outside 1..17 is a
  statement about the article and for a nil `n` is a statement about the
  caller."
  [n]
  (get grounds n))

(defn may-retain?
  "May the caller collect or retain 特定個人情報 in `j`?

  Four answers, and **none of them is an unqualified yes**:

    {:bangou/coverage :none}          uncatalogued jurisdiction
    {:bangou/coverage :not-declared}  no 第十九条 号 was named. **This is the
                                      answer the library exists to give.**
                                      第二十条 prohibits by default, so a
                                      caller who cannot name a 号 has its
                                      answer already.
    {:bangou/coverage :unknown-ground} a 号 was named and 第十九条 has no
                                      such number
    {:bangou/coverage :ground-named}  the 号 exists and is named back

  `:ground-named` is **not** permission. This catalog read the headlines of
  the seventeen 号, not their conditions, so whether the caller's facts fall
  within the one it named is a question about those facts. What the library
  can do is refuse to let the question go unasked."
  [j {:keys [ground-number]}]
  (let [path (normalize j)]
    (cond
      (not (covered? path))
      {:bangou/coverage :none :bangou/unchecked [path]}

      (nil? ground-number)
      {:bangou/coverage :not-declared
       :bangou/provision "番号法 第二十条"
       :bangou/why (str "第二十条 は「何人も…収集し、又は保管してはならない」と定め、"
                        "例外は前条（第十九条）各号に限られる。号を名指しできない"
                        "ということは、答えは既に出ている。")}

      (nil? (ground ground-number))
      {:bangou/coverage :unknown-ground
       :bangou/ground ground-number
       :bangou/provision "番号法 第十九条"
       :bangou/why (str "第十九条 に第" ground-number "号は無い（読んだのは一号から"
                        "十七号）。")}

      :else
      {:bangou/coverage :ground-named
       :bangou/jurisdiction path
       :bangou/ground ground-number
       :bangou/ground-headline (ground ground-number)
       :bangou/provision "番号法 第十九条"
       :bangou/conditions-not-read? true
       :bangou/why (str "第" ground-number "号 は存在する。この目録が読んだのは"
                        "各号の見出しであって要件ではないので、呼び出し側の事実が"
                        "その号に当たるかは答えていない。")})))

(defn permitted?
  "Convenience boolean over `may-retain?`, conservative like
  `taxlaw/supported?` and `worklaw/compliant?`.

  **Always false.** That is not a stub: `:ground-named` carries
  `:bangou/conditions-not-read? true`, so nothing this catalog holds can
  establish permission, and a boolean that said otherwise would be the
  library asserting what it just declined to read. It exists so that a
  caller reaching for the convenient answer gets the conservative one rather
  than writing its own truthy check over the map."
  [j opts]
  (and (= :ground-named (:bangou/coverage (may-retain? j opts)))
       (not (:bangou/conditions-not-read? (may-retain? j opts)))))
