(ns kotoba.bangou-test
  (:require [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.bangou :as bangou]))

(deftest the-api-never-takes-a-personal-number
  (testing "This is the design, so it is asserted rather than left to
            discipline. A library with `(valid? my-number)` in it has been
            handed the thing 第二十条 is about, and a caller who reached for
            it has already collected. Every public fn answers a question
            about a PURPOSE."
    (let [publics (ns-publics 'kotoba.bangou)
          arglists (mapcat #(:arglists (meta %)) (vals publics))
          ;; Destructuring forms are not flat symbols -- `{:keys [x]}` is a
          ;; map, not the symbol `x`. Flattening with tree-seq is the whole
          ;; reason this reads the way it does: the first version collected
          ;; `"{:keys [ground-number]}"` as one name, so the `not-any?` below
          ;; passed WITHOUT ever seeing an argument name. It measured nothing
          ;; and looked green.
          names (into #{}
                      (comp (mapcat #(tree-seq coll? seq %))
                            (filter symbol?)
                            (map str))
                      arglists)]
      (is (not-any? #(re-find #"(?i)^number|bangou|kojin|my-?number" %) names)
          (str "an argument looks like it takes a 個人番号: " (pr-str names)))
      (testing "and the two that do take a number take an ARTICLE number,
                which is why the pattern above is anchored rather than a
                bare `number` substring"
        (is (contains? names "n") (pr-str names))
        (is (contains? names "ground-number") (pr-str names))))))

(deftest naming-no-ground-is-the-answer-not-a-missing-input
  (testing "第二十条 prohibits by default and the exceptions are 第十九条's
            号. A caller who cannot name one has its answer already, so this
            is `:not-declared` and never a request for more information."
    (let [r (bangou/may-retain? [:jp] {})]
      (is (= :not-declared (:bangou/coverage r)))
      (is (= "番号法 第二十条" (:bangou/provision r)))
      (is (str/includes? (:bangou/why r) "何人も"))
      (is (false? (bangou/permitted? [:jp] {}))))))

(deftest naming-a-ground-is-not-permission
  (testing "the catalog read the seventeen headlines, not their conditions.
            Answering `yes` from a headline would be the library asserting
            what it just declined to read."
    (let [r (bangou/may-retain? [:jp] {:ground-number 2})]
      (is (= :ground-named (:bangou/coverage r)))
      (is (= 2 (:bangou/ground r)))
      (is (str/includes? (:bangou/ground-headline r) "個人番号関係事務実施者"))
      (is (true? (:bangou/conditions-not-read? r))
          "the map says so, in the map, not only in a docstring")
      (is (false? (bangou/permitted? [:jp] {:ground-number 2}))
          "and the convenience boolean is false BECAUSE of that flag"))))

(deftest the-convenience-boolean-is-false-for-every-input
  (testing "not a stub. Nothing this catalog holds can establish permission,
            so a boolean that ever said true would be asserting what was not
            read. It exists so a caller does not write its own truthy check
            over the map and get a different answer."
    (doseq [opts [{} {:ground-number 1} {:ground-number 2} {:ground-number 17}
                  {:ground-number 99} {:ground-number nil}]]
      (is (false? (bangou/permitted? [:jp] opts)) (pr-str opts)))
    (is (false? (bangou/permitted? [:us] {:ground-number 2})))))

(deftest a-ground-the-article-does-not-have-is-its-own-answer
  (testing "`unknown-ground` and `not-declared` are different findings: one
            is a caller citing something that is not there, the other is a
            caller citing nothing"
    (doseq [n [0 18 99 -1]]
      (let [r (bangou/may-retain? [:jp] {:ground-number n})]
        (is (= :unknown-ground (:bangou/coverage r)) (str "for " n))
        (is (= "番号法 第十九条" (:bangou/provision r)))))
    (testing "and all seventeen that exist are named"
      (doseq [n (range 1 18)]
        (is (some? (bangou/ground n)) (str "第" n "号"))
        (is (= :ground-named (:bangou/coverage
                              (bangou/may-retain? [:jp] {:ground-number n})))))
      (is (= 17 (count bangou/grounds))))))

(deftest an-uncatalogued-jurisdiction-is-not-permissive
  (testing "other jurisdictions have identifier regimes and this catalog has
            read none of them. `:none` is `nobody looked`, never `no rule`"
    (doseq [j [[:us] [:eu] [:eu :de] nil]]
      (let [r (bangou/may-retain? j {:ground-number 2})]
        (is (= :none (:bangou/coverage r)) (pr-str j))
        (is (not (bangou/covered? j)))))
    (is (bangou/covered? [:jp]))
    (is (bangou/covered? :jp) "bare keyword normalizes, as in taxlaw")))

(deftest what-was-searched-for-and-not-found-is-recorded
  (testing "an absent citation that leaves no trace looks identical to one
            nobody thought of. The check digit is the one that matters: it is
            delegated to a 総務省令 this catalog could not locate, so there is
            no shape check here at all rather than one written from memory"
    (let [not-read (:catalog/not-read bangou/catalog-verification)
          cd (first (filter #(= :check-digit (:claim %)) not-read))]
      (is (some? cd))
      (is (seq (:searched cd)))
      (is (str/includes? (:why cd) "総務省令"))
      (is (not (str/blank? (:searched-at cd)))))
    (testing "and nothing in the API offers to check a number's shape"
      (is (not-any? #(re-find #"(?i)valid|check-digit|format" (str %))
                    (keys (ns-publics 'kotoba.bangou)))))))

(deftest every-quote-is-the-articles-own-words
  (testing "and a partial quote says it is partial and says what it omits"
    (doseq [c (:catalog/content-verified bangou/catalog-verification)]
      (is (not (str/blank? (:quote c))) (str (:claim c)))
      (is (not (str/blank? (:retrieved-at c))))
      (is (str/starts-with? (:retrieved-via c) "e-Gov law API"))
      (when (:quote-is-partial? c)
        (is (not (str/blank? (:quote-omits c)))
            "quoting part of an article without saying which part is how a
             quote stops being evidence")))
    (testing "第二十条's quote carries the word that makes it bind everyone"
      (let [q (:rule/quote (get-in bangou/jurisdictions
                                   [[:jp] :jurisdiction/retention]))]
        (is (str/includes? q "何人も"))
        (is (= :anyone (:rule/binds (get-in bangou/jurisdictions
                                            [[:jp] :jurisdiction/retention]))))))))
