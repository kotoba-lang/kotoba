;; mlkem.native-gate -- FIPS 203 ML-KEM-768 known answers from the ACVP vectors in
;; test/mlkem/acvp/, run by a loaderless static image built from
;; kotoba/sha3/core.kotoba and kotoba/mlkem/core.kotoba (README "Native gate"
;; composes the three bodies; JUN-352 P1b).
;;
;; main returns a bitmask, 63 is a pass:
;;   1 keyGen tc 26, 27: SHA3-256 of ek ++ dk equals that of the ACVP ek ++ dk
;;   2 encapsulation tc 26, 27: K equals, SHA3-256 of c equals that of the ACVP c
;;   4 decapsulation tc 86 (valid) and 88 (modified ciphertext, implicit rejection)
;;   8 key checks: ek tc 136 passes, 137 fails (coefficient >= q); dk tc 126
;;     passes, 128 fails (modified H)
;;  16 the NTT tables are 17^BitRev7(i) and 17^(2 BitRev7(i) + 1) mod q; a keyGen /
;;     encaps / decaps round trip agrees, and a changed ciphertext decapsulates to
;;     SHAKE256(z || c, 32), not K
;;  32 wrong lengths and non-byte values are refused with an empty vector
;; The digests of long outputs are SHA3-256, so this gate relies on the SHA-3 gate.
(ns mlkem.native-gate
  (:export [main]))

(defn- g-nib [c :i64] :i64 (if (<= c 57) (- c 48) (- c 87)))
(defn- g-unhex [s :string] :vector-i64
  (let [b (vector-i64-from-bytes (string-to-utf8 s)) n (quot (vector-count b) 2)]
    (loop [i 0 out (vector-alloc n)]
      (if (= i n) out
        (recur (+ i 1) (vector-assoc! out i (+ (* 16 (g-nib (vector-at b (* 2 i)))) (g-nib (vector-at b (+ (* 2 i) 1))))))))))
(defn- g-digest [v :vector-i64] :string (hex (sha3-256 v)))
(defn- g-slice [v :vector-i64 start :i64 n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ start i)))))))
(defn- g-set [v :vector-i64 at :i64 x :i64] :vector-i64
  (let [out (g-slice v 0 (vector-count v))] (vector-assoc! out at x)))
(defn- g-empty? [v :vector-i64] :bool (= (vector-count v) 0))

(defn- g-kg26-d [] :string "e582b7d75e6c80b05ae392a1fc9f7153b12390fd99930368cc67a768baebc8a0")
(defn- g-kg26-z [] :string "1cdacb8740c0b87c4a379575f187b367cbfa3b300bf591b109f79816e9cbe8f0")
(defn- g-kg26-h [] :string "ed7108e524c6ccbdb5e4b856351c64691c33c7078f1385b080b64f4507442d70")
(defn- g-kg27-d [] :string "3e5848db624613f7ac144457cc1375f006fa8cb953e767dc9e7428d00f5dad8b")
(defn- g-kg27-z [] :string "012dd6c2f0918b9eb6182474eb86d848f65974759d59ce151a396deee4ca10d1")
(defn- g-kg27-h [] :string "00da37f683f135da3dca44522e5ab97947e0209b1c8c3ac4db0d005c342d1121")
(defn- g-en26-ek [] :string "")
(defn- g-en26-m [] :string "4e77596168711e913965d8175ac3bd76aab08b7f9385a02ae883cf6c6e17dd81")
(defn- g-en26-k [] :string "79d74f6c6c2d916bec47bd828fd9b67295a37f54927fab1263c0d122f1c6f1ed")
(defn- g-en26-hc [] :string "684da17d93e27520cb78ae6169c020d73ef770e6fa89589cc7d653a76a8b1751")
(defn- g-en27-ek [] :string "")
(defn- g-en27-m [] :string "c465031f7464614109c7ddb28ab216181db5002ae54eaf6c5d6a6eefc4f72b9e")
(defn- g-en27-k [] :string "3d58d95a3556fc5f5784b5b537f4a99c3d83cb0c9d80b1e4fa96f8d1ab08554e")
(defn- g-en27-hc [] :string "fac643f5c1cfbb70f7ab7bb2bfd1d7af4443116c7f1e941a9dd81faf42fd64a7")
(defn- g-de86-dk [] :string "")
(defn- g-de86-c [] :string "")
(defn- g-de86-k [] :string "34cfae7f2ca3b0b9c3e06afeed554c053f6e51d875d3bd3ff0eda2086ee79f3a")
(defn- g-de88-dk [] :string "")
(defn- g-de88-c [] :string "")
(defn- g-de88-k [] :string "2cfb695710a6c4377f46c20c13480aef7ac56030d47a0ab5af07ddd6062c28f4")
(defn- g-ek136 [] :string "")
(defn- g-ek137 [] :string "")
(defn- g-dk126 [] :string "")
(defn- g-dk128 [] :string "")

(defn- g-keygen [] :bool
  (and (= (g-digest (keygen (g-unhex (g-kg26-d)) (g-unhex (g-kg26-z)))) (g-kg26-h))
       (= (g-digest (keygen (g-unhex (g-kg27-d)) (g-unhex (g-kg27-z)))) (g-kg27-h))))

(defn- g-encaps-one [ek :string m :string k :string hc :string] :bool
  (let [out (encaps (g-unhex ek) (g-unhex m))]
    (and (= (vector-count out) 1120) (= (hex (g-slice out 0 32)) k) (= (g-digest (g-slice out 32 1088)) hc))))
(defn- g-encaps [] :bool
  (and (g-encaps-one (g-en26-ek) (g-en26-m) (g-en26-k) (g-en26-hc))
       (g-encaps-one (g-en27-ek) (g-en27-m) (g-en27-k) (g-en27-hc))))

(defn- g-decaps [] :bool
  (and (= (hex (decaps (g-unhex (g-de86-dk)) (g-unhex (g-de86-c)))) (g-de86-k))
       (= (hex (decaps (g-unhex (g-de88-dk)) (g-unhex (g-de88-c)))) (g-de88-k))))

(defn- g-checks [] :bool
  (and (valid-ek? (g-unhex (g-ek136))) (not (valid-ek? (g-unhex (g-ek137))))
       (valid-dk? (g-unhex (g-dk126))) (not (valid-dk? (g-unhex (g-dk128))))))

(defn- g-br7 [i :i64] :i64
  (loop [k 0 x i r 0] (if (= k 7) r (recur (+ k 1) (quot x 2) (+ (* 2 r) (rem x 2))))))
(defn- g-pow17 [e :i64] :i64
  (loop [k 0 r 1] (if (= k e) r (recur (+ k 1) (rem (* r 17) 3329)))))
(defn- g-round-trip [] :bool
  (let [z (g-unhex (g-kg26-z))
        kp (keygen (g-unhex (g-kg26-d)) z)
        ek (g-slice kp 0 1184) dk (g-slice kp 1184 2400)
        kc (encaps ek (g-unhex (g-en26-m))) k (g-slice kc 0 32) c (g-slice kc 32 1088)
        c2 (g-set c 500 (bit-xor (vector-at c 500) 1))
        k2 (decaps dk c2)]
    (and (= (hex (decaps dk c)) (hex k))
         (= (hex k2) (hex (shake256 (loop [i 0 out (vector-alloc 1120)]
                                      (if (= i 1120) out
                                        (recur (+ i 1) (vector-assoc! out i (if (< i 32) (vector-at z i) (vector-at c2 (- i 32)))))))
                                    32)))
         (not (= (hex k2) (hex k))))))
(defn- g-tables [] :bool
  (and (loop [i 0] (if (= i 128) true
                      (if (and (= (vector-at (zetas) i) (g-pow17 (g-br7 i)))
                               (= (vector-at (gammas) i) (g-pow17 (+ (* 2 (g-br7 i)) 1))))
                        (recur (+ i 1)) false)))
       (g-round-trip)))

(defn- g-refusals [] :bool
  (let [d (g-unhex (g-kg26-d)) z (g-unhex (g-kg26-z)) ek (g-unhex (g-en26-ek)) m (g-unhex (g-en26-m))
        dk (g-unhex (g-de86-dk)) c (g-unhex (g-de86-c))]
    (and (g-empty? (keygen (g-slice d 0 31) z)) (g-empty? (keygen d (g-slice z 0 31)))
         (g-empty? (encaps (g-slice ek 0 1183) m)) (g-empty? (encaps ek (g-slice m 0 31)))
         (g-empty? (encaps ek (g-set m 5 256))) (g-empty? (keygen (g-set d 0 -1) z))
         (g-empty? (decaps (g-slice dk 0 2399) c)) (g-empty? (decaps dk (g-slice c 0 1087)))
         (not (g-empty? (decaps dk c))))))

(defn main [] :i64
  (+ (if (g-keygen) 1 0) (if (g-encaps) 2 0) (if (g-decaps) 4 0)
     (if (g-checks) 8 0) (if (g-tables) 16 0) (if (g-refusals) 32 0)))
