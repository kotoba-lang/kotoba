(ns mlkem.test-util
  "Helpers shared by the suites. Test code only."
  (:require [sha3.core :as sha3]))

(defn hex->bytes
  "\"0a1b\" => [10 27]  (either case)"
  [s]
  (vec (for [i (range 0 (count s) 2)]
         #?(:clj  (Integer/parseInt (subs s i (+ i 2)) 16)
            :cljs (js/parseInt (subs s i (+ i 2)) 16)))))

(defn bytes->hex [bytes] (sha3/hex bytes))

(defn seed
  "A deterministic 32-byte seed, so that tests need no random source."
  [n]
  (vec (take 32 (map #(mod (+ (* % 31) (* n 17) 5) 256) (range)))))
