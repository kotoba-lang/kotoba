(ns mlkem.acvp-test
  "NIST ACVP known-answer tests for ML-KEM-768 (FIPS 203).

   Where the vectors come from: test/acvp/PROVENANCE.md. The data namespaces are
   generated by tools/import_acvp.py and are not edited by hand."
  (:require [mlkem.core :as mlkem]
            [sha3.core :as sha3]
            [mlkem.test-util :refer [hex->bytes bytes->hex]]
            [mlkem.acvp.keygen :as keygen]
            [mlkem.acvp.encaps :as encaps]
            [mlkem.acvp.decaps :as decaps]
            [mlkem.acvp.dk-check :as dk-check]
            [mlkem.acvp.ek-check :as ek-check]
            #?(:clj  [clojure.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing]])))

(deftest keygen-vectors
  (is (= 25 (count keygen/vectors)))
  (doseq [[id d z ek dk] keygen/vectors]
    (let [r (mlkem/keygen (hex->bytes d) (hex->bytes z))]
      (is (= ek (bytes->hex (:ek r))) (str "keyGen tc " id " ek"))
      (is (= dk (bytes->hex (:dk r))) (str "keyGen tc " id " dk")))))

(deftest encapsulation-vectors
  (is (= 25 (count encaps/vectors)))
  (doseq [[id ek m c k] encaps/vectors]
    (let [r (mlkem/encaps (hex->bytes ek) (hex->bytes m))]
      (is (= c (bytes->hex (:c r))) (str "encaps tc " id " ciphertext"))
      (is (= k (bytes->hex (:k r))) (str "encaps tc " id " shared key")))))

(deftest decapsulation-vectors
  (is (= 10 (count decaps/vectors)))
  (testing "valid ciphertexts give the encapsulator's key"
    (doseq [[id dk c k reason] decaps/vectors :when (= "valid decapsulation" reason)]
      (is (= k (bytes->hex (mlkem/decaps (hex->bytes dk) (hex->bytes c)))) (str "decaps tc " id))))
  (testing "modified ciphertexts are rejected implicitly: no exception, the key J(z || c)"
    (let [modified (filter (fn [[_ _ _ _ reason]] (= "modified ciphertext" reason)) decaps/vectors)]
      (is (pos? (count modified)))
      (doseq [[id dk c k _] modified]
        (let [dk-bytes (hex->bytes dk) c-bytes (hex->bytes c)
              got (mlkem/decaps dk-bytes c-bytes)
              z (subvec dk-bytes (- (count dk-bytes) 32))]
          (is (= k (bytes->hex got)) (str "decaps tc " id " matches the NIST key"))
          (is (= (sha3/shake256 (into z c-bytes) 32) got)
              (str "decaps tc " id " is J(z || c)")))))))

(deftest decapsulation-key-check-vectors
  (doseq [[id dk passed reason] dk-check/vectors]
    (is (= passed (mlkem/valid-decapsulation-key? (hex->bytes dk))) (str "dk check tc " id " " reason))))

(deftest encapsulation-key-check-vectors
  (doseq [[id ek passed reason] ek-check/vectors]
    (is (= passed (mlkem/valid-encapsulation-key? (hex->bytes ek))) (str "ek check tc " id " " reason))))
