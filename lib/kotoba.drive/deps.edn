 ;; drive.object's docstring. kotoba.bytes owns the word and states the
 ;; contract; this is drive saying it means the same thing by it.
 :deps {
        io.github.kotoba-lang/error {:local/root "../kotoba.error"}
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/bytes {:local/root "../kotoba.bytes"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :kotoba {:extra-deps {io.github.kotoba-lang/compiler
                        {:git/url "https://github.com/kotoba-lang/compiler.git"
                         :git/sha "bef32b78852212bc096849d1ff9779c8afae4796"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}}}
