;; wallet — non-custodial multi-chain wallet (MetaMask/Coinbase Wallet-shaped):
;; a single BIP-32/39/44 seed, a ChainDriver registry (:eth, :btc), real
;; SIWE/EIP-4361 (personal_sign + ecrecover, verifiable by real Ethereum
;; tooling), and a local encrypted-keystore shape. Builds on btc-crypto
;; (shared secp256k1 HD tree + BTC addresses/tx) and eth-crypto (ETH
;; addresses/tx/keccak) rather than re-deriving them.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/btc-crypto {:local/root "../kotoba.btcCrypto"}
        io.github.kotoba-lang/eth-crypto {:local/root "../kotoba.ethCrypto"}
        io.github.kotoba-lang/crypto {:local/root "../kotoba.crypto"}}
 :aliases
 {:test {:extra-paths ["test"]}
}}
