;; This repository's entry in the kotoba.repository-role-rules taxonomy.
;; ADR-2607266000 / ADR-2607299000.
{:schema "kotoba.repository-role-rules.v0"
 :this-repo
 {:name "perfgate"
  :tier :t5
  :role :assurance
  ;; An assurance repo that ran its own benchmarks would be grading its own
  ;; homework; it takes observations and judges them. And it must not claim
  ;; statistical machinery it does not implement -- the separation test is a
  ;; stated heuristic, not a significance test.
  :must-not [:run-benchmarks :perform-io :claim-unimplemented-statistics]
  :depends-on ["kotoba-lang/machine"]}}
