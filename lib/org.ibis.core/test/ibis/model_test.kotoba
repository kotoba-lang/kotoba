(ns ibis.model-test (:export [main]) (:require [ibis.model :as p]))

(defn- fedn [d :document k :keyword] :string
  (document-edn-print (option-or (document-get d k) (document-null))))

(defn- fcount [d :document k :keyword] :i64
  (document-count (option-or (document-get d k) (document-null))))

(defn main [] :i64
  (let [m0 (p/model (document-map :name (document-string "IN1") :model-type (document-keyword :input)))
        m1 (p/add-point m0 :pulldown (document-i64 0) (document-i64 1))
        m2 (p/add-point m1 :pulldown (document-i64 2) (document-i64 3))]
    (+ (if (string=? (fedn m0 :name) "\"IN1\"") 0 1)
       (if (string=? (fedn m0 :model-type) ":input") 0 1)
       (if (= (fcount m0 :pulldown) 0) 0 1)
       (if (= (fcount m0 :pullup) 0) 0 1)
       (if (= (fcount m2 :pulldown) 2) 0 1)
       (if (string=? (fedn m2 :pulldown) "[[0 1] [2 3]]") 0 1)
       (if (= (fcount m2 :pullup) 0) 0 1)
       (if (document-set-contains? (p/model-types) (document-keyword :3-state)) 0 1)
       (if (document-set-contains? (p/model-types) (document-keyword :open-drain)) 0 1)
       (if (= (document-count (p/model-types)) 5) 0 1))))
