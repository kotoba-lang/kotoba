;; Port of ibis.model (model.cljk), Kotoba-native, :document values.
;;
;; Named divergences from model.cljk:
;;   - model-types is a zero-arg function returning a :document set.
;;   - :or defaults apply when the key is absent or nil.
;;   - add-point takes the table key as a keyword.
;;   - ramp-rate and interpolate-current are NOT ported: they need f64
;;     division and comparison, which the Kotoba subset does not provide.

(ns ibis.model
  (:export [model-types model add-point]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- null-doc? [d :document] :bool
  (string=? (document-edn-print d) (document-edn-print (document-null))))

(defn- or-empty [v :document] :document
  (if (null-doc? v) (document-vector) v))

(defn- lib-base [m :document] :document
  (if (map? m) m (document-map)))

(defn model-types [] :document
  (document-set (document-keyword :input) (document-keyword :output)
                (document-keyword :io) (document-keyword :3-state)
                (document-keyword :open-drain)))

(defn model [opts :document] :document
  (document-map :name (field opts :name)
                :model-type (field opts :model-type)
                :pulldown (or-empty (field opts :pulldown))
                :pullup (or-empty (field opts :pullup))
                :power-clamp (or-empty (field opts :power-clamp))
                :gnd-clamp (or-empty (field opts :gnd-clamp))
                :ramp (field opts :ramp)))

(defn add-point [m :document table-key :keyword voltage :document current :document] :document
  (let [base (lib-base m)
        existing (or-empty (field base table-key))]
    (document-assoc base (document-keyword table-key)
                    (document-vector-conj existing (document-vector voltage current)))))
