;; No dependencies. ARINC 429 is a 32-bit word and a handful of pure bit
;; operations — a leaf that dragged in an ARINC 717/629 stack, a serial
;; driver, or a device SDK would defeat the point, which is that this
;; codec has to run correctly on both the JVM and ClojureScript, and the
;; only way to be sure of that is to keep it dependency-free and testable
;; on both.
{:deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}}
 :paths ["src"]
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
