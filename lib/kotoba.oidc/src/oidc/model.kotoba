(ns oidc.model-kotoba
  ;; Parity migration of oidc.model (portable pure: maps and strings only).
  ;; Same contract as the original .cljc.
  (:export [auth-request id-token-result]))

(defn opt-str [opts :document k :keyword] :string
  (option-value-of [:option :string]
    (document-string-value
      (option-value-of [:option :document]
        (document-get opts k) (document-null)))
    ""))

(defn auth-request [id opts :document] :document
  (document-map
   :oidc.request/id (document-string id)
   :oidc.request/issuer (document-string (opt-str opts :issuer))
   :oidc.request/client-id (document-string (opt-str opts :client-id))
   :oidc.request/redirect-uri (document-string (opt-str opts :redirect-uri))
   :oidc.request/scope (document-vector)
   :oidc.request/state (document-string (opt-str opts :state))
   :oidc.request/nonce (document-string (opt-str opts :nonce))))

(defn id-token-result [ok? opts :document] :document
  (document-map
   :oidc.id-token/ok? (document-bool ok?)
   :oidc.id-token/issuer (document-string (opt-str opts :issuer))
   :oidc.id-token/audience (document-string (opt-str opts :audience))
   :oidc.id-token/subject (document-string (opt-str opts :subject))
   :oidc.id-token/nonce (document-string (opt-str opts :nonce))
   :oidc.id-token/evidence-ref (document-string (opt-str opts :evidence-ref))))
