;; Port of oidc.datom (datom.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from datom.cljk:
;;   - each emitter returns a :document vector of one map, as the source does.
;;   - absent keys are document-null, as nil is in the source.
;;   - the id-token :db/id text is (str "oidc:id-token:" issuer ":" subject). A
;;     null part is "", a string part is itself, and any other part is its
;;     canonical EDN text (document-edn-print), as the source's str renders it.

(ns oidc.datom
  (:export [auth-request-datoms id-token-result-datoms]))

(defn- field [d :document k :keyword] :document
  (option-or (document-get d k) (document-null)))

(defn- null-doc? [d :document] :bool
  (string=? (keyword-name (document-kind d)) "null"))

(defn- text [d :document] :string
  (if (null-doc? d)
    ""
    (option-or (document-string-value d) (document-edn-print d))))

(defn- token-id [result :document] :string
  (string-concat (string-concat (string-concat "oidc:id-token:" (text (field result :oidc.id-token/issuer)))
                                ":")
                 (text (field result :oidc.id-token/subject))))

(defn auth-request-datoms [request :document] :document
  (document-vector
   (document-map :db/id (field request :oidc.request/id)
                 :oidc.request/issuer (field request :oidc.request/issuer)
                 :oidc.request/client-id (field request :oidc.request/client-id)
                 :oidc.request/redirect-uri (field request :oidc.request/redirect-uri)
                 :oidc.request/scope (field request :oidc.request/scope)
                 :oidc.request/state (field request :oidc.request/state)
                 :oidc.request/nonce (field request :oidc.request/nonce))))

(defn id-token-result-datoms [result :document] :document
  (document-vector
   (document-map :db/id (document-string (token-id result))
                 :oidc.id-token/ok? (field result :oidc.id-token/ok?)
                 :oidc.id-token/issuer (field result :oidc.id-token/issuer)
                 :oidc.id-token/audience (field result :oidc.id-token/audience)
                 :oidc.id-token/subject (field result :oidc.id-token/subject)
                 :oidc.id-token/nonce (field result :oidc.id-token/nonce)
                 :oidc.id-token/evidence-ref (field result :oidc.id-token/evidence-ref))))
