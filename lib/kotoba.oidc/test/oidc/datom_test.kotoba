(ns oidc.datom-test
  (:export [main])
  (:require [oidc.datom :as o]))

(defn- at [xs :document i :i64] :document
  (option-or (document-vector-at xs i) (document-null)))

(defn- str-at [d :document k :keyword] :string
  (option-or (document-string-value (option-or (document-get d k) (document-null))) "<none>"))

(defn main [] :i64
  (let [req (document-map :oidc.request/id (document-string "req-1")
                          :oidc.request/issuer (document-string "https://idp.example")
                          :oidc.request/client-id (document-string "cid")
                          :oidc.request/redirect-uri (document-string "https://app.example/cb")
                          :oidc.request/scope (document-string "openid")
                          :oidc.request/state (document-string "st")
                          :oidc.request/nonce (document-string "n"))
        ad (at (o/auth-request-datoms req) 0)
        res (document-map :oidc.id-token/ok? (document-bool true)
                          :oidc.id-token/issuer (document-string "iss")
                          :oidc.id-token/audience (document-string "aud")
                          :oidc.id-token/subject (document-string "sub")
                          :oidc.id-token/nonce (document-string "n")
                          :oidc.id-token/evidence-ref (document-string "ev"))
        idt (at (o/id-token-result-datoms res) 0)]
    (+ (if (string=? (str-at ad :db/id) "req-1") 0 1)
       (if (string=? (str-at ad :oidc.request/issuer) "https://idp.example") 0 1)
       (if (string=? (str-at ad :oidc.request/state) "st") 0 1)
       (if (string=? (str-at idt :db/id) "oidc:id-token:iss:sub") 0 1)
       (if (string=? (str-at idt :oidc.id-token/audience) "aud") 0 1)
       (if (string=? (str-at idt :oidc.id-token/evidence-ref) "ev") 0 1))))
