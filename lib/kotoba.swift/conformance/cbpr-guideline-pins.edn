 [
  {:id "CBPR-001"
   :guideline "CBPR+ Usage Guideline (pacs.008.001.08)"
   :locator "GrpHdr/NbOfTxs"
   :note "GrpHdr/NbOfTxs must equal the actual CdtTrfTxInf count."}
  {:id "CBPR-002"
   :guideline "CBPR+ Usage Guideline (pacs.008.001.08)"
   :locator "CdtTrfTxInf/PmtId/UETR"
   :note "UETR is mandatory on every transaction."}
  {:id "CBPR-003"
   :guideline "CBPR+ Usage Guideline (pacs.008.001.08)"
   :locator "CdtTrfTxInf/PmtId/UETR"
   :note "UETR must be a lowercase UUIDv4."}
  {:id "CBPR-004"
   :guideline "CBPR+ Usage Guideline (pacs.008.001.08)"
   :locator "CdtTrfTxInf/IntrBkSttlmAmt"
   :note "IntrBkSttlmAmt mandatory, with a valid ISO 4217 amount."}
  {:id "CBPR-005"
   :guideline "CBPR+ Usage Guideline (pacs.008.001.08)"
   :locator "CdtTrfTxInf/ChrgBr"
   :note "ChrgBr ∈ {DEBT, CRED, SHAR} (SLEV is SEPA, not CBPR+)."}
  {:id "CBPR-006"
   :guideline "CBPR+ Usage Guideline (pacs.008.001.08)"
   :locator "CdtTrfTxInf/DbtrAgt"
   :note "DbtrAgt and CdtrAgt each require a valid BICFI."}
  {:id "CBPR-007"
   :guideline "CBPR+ Usage Guideline (pacs.008.001.08)"
   :locator "CdtTrfTxInf/DbtrAgt"
   :note "if an Agent BICFI is present, its Name is not allowed."}
  {:id "CBPR-008"
   :guideline "CBPR+ Usage Guideline (pacs.008.001.08)"
   :locator "GrpHdr/CtrlSum"
   :note "CtrlSum, if present, must equal the sum of settlement amounts."}
  {:id "CBPR-009"
   :guideline "CBPR+ Usage Guideline (pacs.008.001.08)"
   :locator "CdtTrfTxInf/Dbtr"
   :note "Debtor and Creditor names are mandatory."}
  {:id "CBPR-010"
   :guideline "CBPR+ Usage Guideline (pacs.008.001.08)"
   :locator "AppHdr/MsgDefIdr"
   :note "BAH MsgDefIdr must match the message definition."}
  {:id "CBPR-011"
   :guideline "CBPR+ Usage Guideline (pacs.008.001.08)"
   :locator "AppHdr/BizSvc"
   :note "BAH BizSvc should be a swift.cbprplus.* service (warning)."}
 ]
