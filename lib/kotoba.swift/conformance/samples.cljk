;; Writes one pain.001.001.09 and one pacs.008.001.08 document built by
;; kotoba.swift.iso20022 into the directory given as the first argument, and
;; prints whether each one parses back to the same tree.
;;
;; All parties, accounts and identifiers are fictional test values.
;; Run through check.sh, which sets up the classpath.
(require '[kotoba.swift.iso20022 :as iso])

(def out-dir (first *command-line-args*))

(def pain
  (iso/pain001-doc
   {:msg-id "MSG-1" :creation-date-time "2026-11-18T09:00:00Z"
    :initiating-party-name "Example Co" :payment-info-id "PMT-1"
    :requested-execution-date "2026-11-19"
    :debtor-name "Example Co" :debtor-iban "DE89370400440532013000" :debtor-bic "DEUTDEFFXXX"
    :transactions [{:end-to-end-id "E2E-1" :uetr "eb6305c9-1f7f-49de-aed0-16487c27b42d"
                    :amount-minor 100050 :currency "EUR"
                    :creditor-name "Beispiel GmbH" :creditor-iban "FR1420041010050500013M02606"
                    :creditor-bic "BNPAFRPPXXX" :remittance-information "INV 42"}]}))

(def pacs
  (iso/pacs008-doc
   {:msg-id "MSG-2" :creation-date-time "2026-11-18T09:00:00Z"
    :transactions [{:end-to-end-id "E2E-2" :uetr "eb6305c9-1f7f-49de-aed0-16487c27b42d"
                    :amount-minor 100050 :currency "EUR"
                    :debtor-name "Example Co" :debtor-iban "DE89370400440532013000" :debtor-bic "DEUTDEFFXXX"
                    :creditor-agent-bic "BNPAFRPPXXX" :creditor-name "Beispiel GmbH"
                    :creditor-iban "FR1420041010050500013M02606"}]}))

;; Two transactions, an instruction id, a non-two-decimal currency and a name
;; that needs XML escaping.
(def pain-multi
  (iso/pain001-doc
   {:msg-id "MSG-3" :creation-date-time "2026-11-18T09:00:00.123+09:00"
    :initiating-party-name "Example Co" :payment-info-id "PMT-3"
    :requested-execution-date "2028-02-29" :charge-bearer "SHAR"
    :debtor-name "Example Co" :debtor-iban "DE89370400440532013000" :debtor-bic "DEUTDEFF"
    :transactions [{:end-to-end-id "E2E-3a" :instruction-id "INSTR-3a" :amount-minor 1500 :decimals 0
                    :currency "JPY" :creditor-name "Smith & Jones <Ltd>"
                    :creditor-iban "GB82WEST12345698765432" :creditor-bic "NWBKGB2LXXX"}
                   {:end-to-end-id "E2E-3b" :amount-minor 1 :currency "EUR"
                    :creditor-name "Beispiel GmbH" :creditor-iban "FR1420041010050500013M02606"
                    :creditor-bic "BNPAFRPPXXX"}]}))

(def pacs-multi
  (iso/pacs008-doc
   {:msg-id "MSG-4" :creation-date-time "2026-11-18T09:00:00Z" :settlement-method "CLRG"
    :transactions (vec (for [[i bearer] [[1 "DEBT"] [2 "CRED"]]]
                         {:end-to-end-id (str "E2E-4-" i) :instruction-id (str "INSTR-4-" i)
                          :amount-minor (* i 12345) :currency "USD" :charge-bearer bearer
                          :debtor-name "Example Co" :debtor-iban "DE89370400440532013000" :debtor-bic "DEUTDEFFXXX"
                          :creditor-agent-bic "CHASUS33XXX" :creditor-name "Global Supplies Inc"
                          :creditor-iban "GB82WEST12345698765432"}))}))

(doseq [[file doc] [["kotoba-swift-pain.001.001.09.xml" pain]
                    ["kotoba-swift-pacs.008.001.08.xml" pacs]
                    ["kotoba-swift-multi-pain.001.001.09.xml" pain-multi]
                    ["kotoba-swift-multi-pacs.008.001.08.xml" pacs-multi]]]
  (when-not doc (throw (ex-info "sample was not built" {:file file})))
  (spit (str out-dir "/" file) (iso/xml->str doc)))
(println "roundtrip multi pain.001.001.09" (= pain-multi (iso/parse-xml (iso/xml->str pain-multi))))
(println "roundtrip multi pacs.008.001.08" (= pacs-multi (iso/parse-xml (iso/xml->str pacs-multi))))
(println "roundtrip pain.001.001.09" (= pain (iso/parse-xml (iso/xml->str pain))))
(println "roundtrip pacs.008.001.08" (= pacs (iso/parse-xml (iso/xml->str pacs))))
