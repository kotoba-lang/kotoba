(ns kotoba.swift.mt5xx-test
  (:require [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.swift :as swift]
            [kotoba.swift.mt5xx :as mt]))

;; Fictional references and accounts; the ISIN and BICs are published identifiers.
(def instruction
  {:sender-bic "COBADEFFXXX" :receiver-bic "CHASUS33XXX" :reference "AWAISEC0001"
   :settlement-date "2026-11-20" :isin "US0378331005" :description "EXAMPLE EQUITY" :quantity "100"
   :safekeeping-account "SAFE-0001" :transaction-type "TRAD" :place-of-settlement "DTCYUS33XXX" :agent "CHASUS33XXX"})

(defn- request [kind direction payment]
  (cond-> (assoc instruction :direction direction :payment-type payment)
    (= payment :against-payment) (assoc :amount {:currency "USD" :value "18950.5"})
    (= kind :confirmation) (-> (dissoc :settlement-date)
                               (assoc :reference "AWAICONF0001" :related-reference "AWAISEC0001"
                                      :effective-settlement-date "2026-11-20"))))

(defn- over-the-wire [r] (swift/parse-mt-wire (swift/mt->wire r)))

(deftest all-eight-settlement-types-test
  (doseq [[[kind direction payment] mt] mt/message-types]
    (testing mt
      (let [m (request kind direction payment)
            r ((if (= kind :instruction) mt/settlement-instruction mt/settlement-confirmation) m)]
        (is (= mt (:swift/mt r)))
        (is (= {:swift/valid? true :swift/mt mt} (mt/validate (over-the-wire r))))
        (is (= {:mt mt :data m} (mt/read-message (over-the-wire r))) "reading gives the builder's data back")))))

(deftest mt541-wire-test
  (let [w (swift/mt->wire (mt/settlement-instruction (request :instruction :receive :against-payment)))]
    (is (str/starts-with? w "{1:F01COBADEFFXXXX0001000001}{2:I541CHASUS33XXXXN}{4:\r\n:16R:GENL\r\n:20C::SEME//AWAISEC0001\r\n:23G:NEWM\r\n:16S:GENL\r\n"))
    (doseq [line [":98A::SETT//20261120" ":35B:ISIN US0378331005\r\nEXAMPLE EQUITY" ":36B::SETT//UNIT/100,"
                  ":97A::SAFE//SAFE-0001" ":22F::SETR//TRAD" ":95P::DEAG//CHASUS33XXX" ":95P::PSET//DTCYUS33XXX"
                  ":19A::SETT//USD18950,5"]]
      (is (str/includes? w line) line))
    (is (str/ends-with? w ":16S:AMT\r\n:16S:SETDET\r\n-}"))))

(deftest mt548-test
  (let [m {:sender-bic "CHASUS33XXX" :receiver-bic "COBADEFFXXX" :reference "STAT0001" :related-reference "AWAISEC0001"
           :processing :rejected :matching :unmatched :settlement :failing}
        r (mt/status-advice m)
        w (swift/mt->wire r)]
    (is (= {:swift/valid? true :swift/mt "548"} (mt/validate (over-the-wire r))))
    (is (= {:mt "548" :data m} (mt/read-message (over-the-wire r))))
    (doseq [s [":25D::IPRC//REJT" ":25D::MTCH//NMAT" ":25D::SETT//PENF" ":23G:INST" ":20C::RELA//AWAISEC0001"]]
      (is (str/includes? w s) s))
    (is (nil? (mt/status-advice (dissoc m :processing :matching :settlement))) "at least one status")))

(deftest builders-refuse-bad-input-test
  (doseq [[label r] [["bad ISIN" (mt/settlement-instruction (assoc (request :instruction :receive :free) :isin "US0378331006"))]
                     ["impossible date" (mt/settlement-instruction (assoc (request :instruction :receive :free) :settlement-date "2026-02-30"))]
                     ["reference with //" (mt/settlement-instruction (assoc (request :instruction :receive :free) :reference "A//B"))]
                     ["17-character reference" (mt/settlement-instruction (assoc (request :instruction :receive :free) :reference (apply str (repeat 17 "R"))))]
                     ["amount on free" (mt/settlement-instruction (assoc (request :instruction :receive :free) :amount {:currency "USD" :value "1"}))]
                     ["no amount against payment" (mt/settlement-instruction (dissoc (request :instruction :receive :against-payment) :amount))]
                     ["confirmation without related reference" (mt/settlement-confirmation (dissoc (request :confirmation :receive :free) :related-reference))]
                     ["bad BIC" (mt/settlement-instruction (assoc (request :instruction :receive :free) :agent "CHASE"))]
                     ["zero quantity" (mt/settlement-instruction (assoc (request :instruction :receive :free) :quantity "0"))]]]
    (testing label (is (nil? r)))))

(deftest validate-rejects-broken-layouts-test
  (let [r (mt/settlement-instruction (request :instruction :receive :against-payment))
        w (swift/mt->wire r)
        bad (fn [from to] (mt/validate (swift/parse-mt-wire (str/replace w from to))))]
    (is (false? (:swift/valid? (bad ":16S:FIAC\r\n" ""))) "unclosed sequence")
    (is (false? (:swift/valid? (bad ":95P::DEAG//" ":95P::REAG//"))) "a receipt names the delivering agent")
    (is (false? (:swift/valid? (bad ":16R:AMT\r\n:19A::SETT//USD18950,5\r\n:16S:AMT\r\n" ""))) "MT541 needs the amount")
    (is (false? (:swift/valid? (bad "UNIT/100," "UNIT/100"))) "a quantity needs its decimal comma")
    (is (false? (:swift/valid? (bad ":98A::SETT//20261120" ":98A::SETT//20260230"))) "calendar date")
    (is (false? (:swift/valid? (bad ":22F::SETR//TRAD\r\n" ":22F::SETR//TRAD\r\n:70E::SPRO//X\r\n"))) "unmodeled field")
    (is (= [{:error :unsupported-mt-type :mt "103"}]
           (:swift/errors (mt/validate (assoc-in r [:swift/block-2 :swift/message-type] "103")))))))
