(ns kotoba.swift.securities
  "ISO 20022 securities settlement messages (AWAI-3154, network-awai-apex
  ADR 0042 D1): build, read and validate four message definitions.

    sese.023.001.09  SecuritiesSettlementTransactionInstruction
    sese.024.001.10  SecuritiesSettlementTransactionStatusAdvice
    sese.025.001.09  SecuritiesSettlementTransactionConfirmation
    semt.002.001.10  SecuritiesBalanceCustodyReport

  No network, no I/O. Each builder takes data, returns a Hiccup document for
  kotoba.swift.iso20022/xml->str, and returns nil for input it cannot turn
  into a document the validator accepts. Each reader takes a parsed document
  (kotoba.swift.iso20022/parse-xml) and returns the same data back.

  Scope, stated honestly: only the element subset below is modeled. The
  instruction and confirmation carry one ISIN, a unit quantity, a
  safekeeping account, a transaction type code, the counterparty side's place
  of settlement and agent (both BIC), and, for against-payment, the amount.
  The status advice carries the acknowledgement, matching and settlement
  status without reason codes. The statement carries one page of aggregate
  long/short unit balances per ISIN. Element order, occurrence and value
  facets follow the published XSDs (digests in conformance/xsd-pins.edn);
  conformance/check.sh validates the emitted samples against them. This is
  ADR 0042 level L1 for this subset. Market practice (SMPG, T2S) is L2 and
  is not checked."
  (:require [kotoba.swift.iso20022 :as iso]
            [kotoba.securities.isin :as isin]))

(def namespaces
  {:sese023 "urn:iso:std:iso:20022:tech:xsd:sese.023.001.09"
   :sese024 "urn:iso:std:iso:20022:tech:xsd:sese.024.001.10"
   :sese025 "urn:iso:std:iso:20022:tech:xsd:sese.025.001.09"
   :semt002 "urn:iso:std:iso:20022:tech:xsd:semt.002.001.10"})

(def message-ids
  {:sese023 "sese.023.001.09" :sese024 "sese.024.001.10"
   :sese025 "sese.025.001.09" :semt002 "semt.002.001.10"})

;; ---------------------------------------------------------------------------
;; Code lists (from the XSDs)
;; ---------------------------------------------------------------------------

(def transaction-types
  "SecuritiesTransactionType codes accepted by both sese.023.001.09 (Type23)
  and sese.025.001.09 (Type25): the intersection of the two lists."
  #{"BSBK" "BYIY" "CNCB" "COLI" "COLO" "CONV" "FCTA" "INSP" "ISSU" "MKDW" "MKUP"
    "NETT" "NSYN" "OWNE" "OWNI" "PAIR" "PLAC" "PORT" "REAL" "REDI" "REDM" "RELE"
    "REPU" "RODE" "RVPO" "SBBK" "SBRE" "SECB" "SECL" "SLRE" "SUBS" "SYND" "TBAC"
    "TRAD" "TRPO" "TRVO" "TURN" "CLAI" "CORP" "AUTO" "SWIF" "SWIT" "ETFT"})

(def frequencies #{"YEAR" "ADHO" "MNTH" "DAIL" "INDA" "WEEK" "SEMI" "QUTR" "TOMN" "TOWK" "TWMN" "OVNG" "ONDE"})
(def update-types #{"COMP" "DELT"})
(def statement-bases #{"CONT" "SETT" "TRAD"})

;; ---------------------------------------------------------------------------
;; Field checks
;; ---------------------------------------------------------------------------

(def ^:private f iso/facets)
(def ^:private max35 (:max35 f))
(def ^:private max140 (:max140 f))
(def ^:private bic (:bicfi f))
(def ^:private xs-date (:xs-date f))
(def ^:private xs-date-time (:xs-date-time f))
(def ^:private decimal-number (:decimal-number f))
(def ^:private currency-amount (:currency-amount f))
(def ^:private currency-code (:currency-code f))
(def ^:private yes-no #{"true" "false" "1" "0"})
(def ^:private page-number ((:pattern f) #"[0-9]{1,5}"))
(defn- code [codes] ((:one-of f) codes))

(defn quantity-valid?
  "A positive unit quantity as a plain decimal string within DecimalNumber
  (18 digits, 17 after the point), e.g. \"100\" or \"2.5\"."
  [s]
  (boolean (and (string? s) (re-matches #"[0-9]+(\.[0-9]+)?" s)
                (decimal-number s) (re-find #"[1-9]" s))))

(defn amount-valid?
  "A positive amount as a plain decimal string within ActiveCurrencyAndAmount."
  [s]
  (boolean (and (string? s) (re-matches #"[0-9]+(\.[0-9]+)?" s)
                (currency-amount s) (re-find #"[1-9]" s))))

;; ---------------------------------------------------------------------------
;; Element tables (keys: a tag, or a vector naming the tag's path suffix)
;; ---------------------------------------------------------------------------

(defn- document [k body-tag]
  {:Document {:seq [[body-tag 1 1]] :attrs {:xmlns #(= % (namespaces k))}}})

(def ^:private settlement-common
  {:FinInstrmId {:seq [[:ISIN 1 1] [:Desc 0 1]]}
   :ISIN {:text isin/isin-valid?}
   :Desc {:text max140}
   :Qty {:choice [:Unit]}
   :Unit {:text decimal-number}
   :SfkpgAcct {:seq [[:Id 1 1]]}
   [:SfkpgAcct :Id] {:text max35}
   :SctiesTxTp {:choice [:Cd]}
   [:SctiesTxTp :Cd] {:text (code transaction-types)}
   :DlvrgSttlmPties {:seq [[:Dpstry 1 1] [:Pty1 1 1]]}
   :RcvgSttlmPties {:seq [[:Dpstry 1 1] [:Pty1 1 1]]}
   :Dpstry {:seq [[:Id 1 1]]}
   :Pty1 {:seq [[:Id 1 1]]}
   [:Dpstry :Id] {:choice [:AnyBIC]}
   [:Pty1 :Id] {:choice [:AnyBIC]}
   :AnyBIC {:text bic}
   :Amt {:text currency-amount :attrs {:Ccy currency-code}}
   :CdtDbtInd {:text (code #{"CRDT" "DBIT"})}
   :SctiesMvmntTp {:text (code #{"DELI" "RECE"})}
   :Pmt {:text (code #{"FREE" "APMT"})}
   ;; DateAndDateTime2Choice under a settlement date choice
   [:Dt :Dt] {:text xs-date}
   [:Dt :DtTm] {:text xs-date-time}})

(def ^:private sese023-elements
  (merge settlement-common (document :sese023 :SctiesSttlmTxInstr)
         {:SctiesSttlmTxInstr {:seq [[:TxId 1 1] [:SttlmTpAndAddtlParams 1 1] [:TradDtls 1 1] [:FinInstrmId 1 1]
                                     [:QtyAndAcctDtls 1 1] [:SttlmParams 1 1] [:DlvrgSttlmPties 0 1]
                                     [:RcvgSttlmPties 0 1] [:SttlmAmt 0 1]]}
          :TxId {:text max35}
          :SttlmTpAndAddtlParams {:seq [[:SctiesMvmntTp 1 1] [:Pmt 1 1]]}
          :TradDtls {:seq [[:SttlmDt 1 1]]}
          :SttlmDt {:choice [:Dt]}
          [:SttlmDt :Dt] {:choice [:Dt :DtTm]}
          :QtyAndAcctDtls {:seq [[:SttlmQty 1 1] [:SfkpgAcct 1 1]]}
          :SttlmQty {:choice [:Qty]}
          :SttlmParams {:seq [[:SctiesTxTp 1 1]]}
          :SttlmAmt {:seq [[:Amt 1 1] [:CdtDbtInd 1 1]]}}))

(def ^:private sese025-elements
  (merge settlement-common (document :sese025 :SctiesSttlmTxConf)
         {:SctiesSttlmTxConf {:seq [[:TxIdDtls 1 1] [:TradDtls 1 1] [:FinInstrmId 1 1] [:QtyAndAcctDtls 1 1]
                                    [:SttlmParams 1 1] [:DlvrgSttlmPties 0 1] [:RcvgSttlmPties 0 1]
                                    [:SttldAmt 0 1]]}
          :TxIdDtls {:seq [[:AcctOwnrTxId 1 1] [:AcctSvcrTxId 0 1] [:SctiesMvmntTp 1 1] [:Pmt 1 1]]}
          :AcctOwnrTxId {:text max35}
          :AcctSvcrTxId {:text max35}
          :TradDtls {:seq [[:FctvSttlmDt 1 1]]}
          :FctvSttlmDt {:choice [:Dt]}
          [:FctvSttlmDt :Dt] {:choice [:Dt :DtTm]}
          :QtyAndAcctDtls {:seq [[:SttldQty 1 1] [:SfkpgAcct 1 1]]}
          :SttldQty {:choice [:Qty]}
          :SttlmParams {:seq [[:SctiesTxTp 1 1]]}
          :SttldAmt {:seq [[:Amt 1 1] [:CdtDbtInd 1 1]]}}))

(def ^:private no-reason {:choice [:NoSpcfdRsn]})

(def ^:private sese024-elements
  (merge (document :sese024 :SctiesSttlmTxStsAdvc)
         {:SctiesSttlmTxStsAdvc {:seq [[:TxId 1 1] [:PrcgSts 0 1] [:MtchgSts 0 1] [:SttlmSts 0 1]]}
          :TxId {:seq [[:AcctOwnrTxId 1 1] [:AcctSvcrTxId 0 1]]}
          :AcctOwnrTxId {:text max35}
          :AcctSvcrTxId {:text max35}
          :PrcgSts {:choice [:AckdAccptd :Rjctd]}
          :AckdAccptd no-reason
          :Rjctd no-reason
          :MtchgSts {:choice [:Mtchd :Umtchd]}
          :Mtchd {:seq []}
          :Umtchd no-reason
          :SttlmSts {:choice [:Pdg :Flng]}
          :Pdg no-reason
          :Flng no-reason
          :NoSpcfdRsn {:text (code #{"NORE"})}}))

(def ^:private semt002-elements
  (merge (document :semt002 :SctiesBalCtdyRpt)
         {:SctiesBalCtdyRpt {:seq [[:Pgntn 1 1] [:StmtGnlDtls 1 1] [:SfkpgAcct 1 1] [:BalForAcct 0 :n]]}
          :Pgntn {:seq [[:PgNb 1 1] [:LastPgInd 1 1]]}
          :PgNb {:text page-number}
          :LastPgInd {:text yes-no}
          :StmtGnlDtls {:seq [[:StmtDtTm 1 1] [:Frqcy 1 1] [:UpdTp 1 1] [:StmtBsis 1 1] [:ActvtyInd 1 1] [:SubAcctInd 1 1]]}
          :StmtDtTm {:choice [:Dt :DtTm]}
          [:StmtDtTm :Dt] {:text xs-date}
          [:StmtDtTm :DtTm] {:text xs-date-time}
          :Frqcy {:choice [:Cd]}
          [:Frqcy :Cd] {:text (code frequencies)}
          :UpdTp {:choice [:Cd]}
          [:UpdTp :Cd] {:text (code update-types)}
          :StmtBsis {:choice [:Cd]}
          [:StmtBsis :Cd] {:text (code statement-bases)}
          :ActvtyInd {:text yes-no}
          :SubAcctInd {:text yes-no}
          :SfkpgAcct {:seq [[:Id 1 1]]}
          [:SfkpgAcct :Id] {:text max35}
          :BalForAcct {:seq [[:FinInstrmId 1 1] [:AggtBal 1 1]]}
          :FinInstrmId {:seq [[:ISIN 1 1]]}
          :ISIN {:text isin/isin-valid?}
          :AggtBal {:seq [[:ShrtLngInd 1 1] [:Qty 1 1]]}
          :ShrtLngInd {:text (code #{"SHOR" "LONG"})}
          ;; BalanceQuantity9Choice > Quantity6Choice > FinancialInstrumentQuantity1Choice
          [:AggtBal :Qty] {:choice [:Qty]}
          [:AggtBal :Qty :Qty] {:choice [:Qty]}
          [:AggtBal :Qty :Qty :Qty] {:choice [:Unit]}
          :Unit {:text decimal-number}}))

(def ^:private tables
  {(namespaces :sese023) [sese023-elements :sese023]
   (namespaces :sese024) [sese024-elements :sese024]
   (namespaces :sese025) [sese025-elements :sese025]
   (namespaces :semt002) [semt002-elements :semt002]})

(defn validate
  "Validate a parsed or built securities document against the XSD
  constraints of the modeled subset. Same result shape as
  kotoba.swift.iso20022/validate-iso20022."
  [doc]
  (cond
    (not (vector? doc)) {:swift/valid? false :swift/error :not-xml}
    (not= :Document (iso/xml-tag doc)) {:swift/valid? false :swift/error :missing-document-root}
    :else
    (if-let [[elements k] (tables (:xmlns (iso/xml-attrs doc)))]
      (iso/validate-with elements (message-ids k) doc)
      {:swift/valid? false :swift/error :unsupported-namespace})))

;; ---------------------------------------------------------------------------
;; Builders
;; ---------------------------------------------------------------------------

(defn- el [tag & kids]
  (let [[attrs kids] (if (map? (first kids)) [(first kids) (rest kids)] [nil kids])
        kids (remove nil? kids)]
    (cond-> [tag] attrs (conj attrs) true (into kids))))

(defn- checked [doc] (when (and doc (:swift/valid? (validate doc))) doc))

(def ^:private movement {:receive "RECE" :deliver "DELI"})
(def ^:private payment {:free "FREE" :against-payment "APMT"})

(defn- parties
  "The counterparty side: for a receipt the delivering side, for a delivery
  the receiving side. Dpstry is the place of settlement, Pty1 the agent."
  [direction place-of-settlement agent]
  (el (if (= direction :receive) :DlvrgSttlmPties :RcvgSttlmPties)
      (el :Dpstry (el :Id (el :AnyBIC place-of-settlement)))
      (el :Pty1 (el :Id (el :AnyBIC agent)))))

(defn- amount-el [tag direction {:keys [currency value]}]
  ;; Receiving securities against payment means paying cash (debit), delivering means receiving it (credit).
  (el tag (el :Amt {:Ccy currency} value) (el :CdtDbtInd (if (= direction :receive) "DBIT" "CRDT"))))

(defn- settlement-input-ok? [{:keys [direction payment-type isin quantity safekeeping-account
                                      transaction-type place-of-settlement agent amount]}]
  (and (movement direction) (payment payment-type) (isin/isin-valid? isin) (quantity-valid? quantity)
       (seq safekeeping-account) (contains? transaction-types transaction-type)
       (string? place-of-settlement) (string? agent)
       (if (= payment-type :against-payment)
         (and (map? amount) (amount-valid? (:value amount)) (string? (:currency amount)))
         (nil? amount))))

(defn settlement-instruction
  "sese.023.001.09. `m`: {:tx-id :direction (:receive|:deliver)
  :payment-type (:free|:against-payment) :settlement-date \"YYYY-MM-DD\"
  :isin :description? :quantity \"100\" :safekeeping-account
  :transaction-type \"TRAD\" :place-of-settlement BIC :agent BIC
  :amount {:currency :value} (against-payment only)}. Returns nil when the
  input is incomplete or the document fails validation."
  [{:keys [tx-id direction payment-type settlement-date isin description quantity
           safekeeping-account transaction-type place-of-settlement agent amount] :as m}]
  (when (settlement-input-ok? m)
    (checked
     (el :Document {:xmlns (namespaces :sese023)}
         (el :SctiesSttlmTxInstr
             (el :TxId tx-id)
             (el :SttlmTpAndAddtlParams (el :SctiesMvmntTp (movement direction)) (el :Pmt (payment payment-type)))
             (el :TradDtls (el :SttlmDt (el :Dt (el :Dt settlement-date))))
             (el :FinInstrmId (el :ISIN isin) (when description (el :Desc description)))
             (el :QtyAndAcctDtls (el :SttlmQty (el :Qty (el :Unit quantity))) (el :SfkpgAcct (el :Id safekeeping-account)))
             (el :SttlmParams (el :SctiesTxTp (el :Cd transaction-type)))
             (parties direction place-of-settlement agent)
             (when amount (amount-el :SttlmAmt direction amount)))))))

(defn settlement-confirmation
  "sese.025.001.09. Same keys as settlement-instruction, with
  :account-owner-tx-id (the instruction's TxId) and :account-servicer-tx-id?
  in place of :tx-id, and :effective-settlement-date in place of
  :settlement-date."
  [{:keys [account-owner-tx-id account-servicer-tx-id direction payment-type effective-settlement-date
           isin description quantity safekeeping-account transaction-type place-of-settlement agent amount] :as m}]
  (when (settlement-input-ok? m)
    (checked
     (el :Document {:xmlns (namespaces :sese025)}
         (el :SctiesSttlmTxConf
             (el :TxIdDtls (el :AcctOwnrTxId account-owner-tx-id)
                 (when account-servicer-tx-id (el :AcctSvcrTxId account-servicer-tx-id))
                 (el :SctiesMvmntTp (movement direction)) (el :Pmt (payment payment-type)))
             (el :TradDtls (el :FctvSttlmDt (el :Dt (el :Dt effective-settlement-date))))
             (el :FinInstrmId (el :ISIN isin) (when description (el :Desc description)))
             (el :QtyAndAcctDtls (el :SttldQty (el :Qty (el :Unit quantity))) (el :SfkpgAcct (el :Id safekeeping-account)))
             (el :SttlmParams (el :SctiesTxTp (el :Cd transaction-type)))
             (parties direction place-of-settlement agent)
             (when amount (amount-el :SttldAmt direction amount)))))))

(def ^:private processing-tags {:acknowledged :AckdAccptd :rejected :Rjctd})
(def ^:private matching-tags {:matched :Mtchd :unmatched :Umtchd})
(def ^:private settlement-tags {:pending :Pdg :failing :Flng})

(defn status-advice
  "sese.024.001.10. `m`: {:account-owner-tx-id :account-servicer-tx-id?
  :processing (:acknowledged|:rejected)? :matching (:matched|:unmatched)?
  :settlement (:pending|:failing)?}, at least one status. No reason codes
  are modeled: every status carries NoSpcfdRsn NORE (Mtchd has none)."
  [{:keys [account-owner-tx-id account-servicer-tx-id processing matching settlement]}]
  (when (and (or processing matching settlement)
             (or (nil? processing) (processing-tags processing))
             (or (nil? matching) (matching-tags matching))
             (or (nil? settlement) (settlement-tags settlement)))
    (let [nore (el :NoSpcfdRsn "NORE")]
      (checked
       (el :Document {:xmlns (namespaces :sese024)}
           (el :SctiesSttlmTxStsAdvc
               (el :TxId (el :AcctOwnrTxId account-owner-tx-id)
                   (when account-servicer-tx-id (el :AcctSvcrTxId account-servicer-tx-id)))
               (when processing (el :PrcgSts (el (processing-tags processing) nore)))
               (when matching (el :MtchgSts (if (= matching :matched) (el :Mtchd) (el :Umtchd nore))))
               (when settlement (el :SttlmSts (el (settlement-tags settlement) nore)))))))))

(defn custody-statement
  "semt.002.001.10, one page. `m`: {:statement-date \"YYYY-MM-DD\"
  :frequency \"DAIL\" :update-type \"COMP\" :basis \"SETT\" :activity? bool
  :safekeeping-account :balances [{:isin :quantity \"100\" :short? bool}]}."
  [{:keys [statement-date frequency update-type basis activity? safekeeping-account balances]}]
  (when (and (every? #(and (isin/isin-valid? (:isin %)) (quantity-valid? (:quantity %))) balances)
             (boolean? activity?))
    (checked
     (el :Document {:xmlns (namespaces :semt002)}
         (apply el :SctiesBalCtdyRpt
                (el :Pgntn (el :PgNb "1") (el :LastPgInd "true"))
                (el :StmtGnlDtls (el :StmtDtTm (el :Dt statement-date)) (el :Frqcy (el :Cd frequency))
                    (el :UpdTp (el :Cd update-type)) (el :StmtBsis (el :Cd basis))
                    (el :ActvtyInd (str activity?)) (el :SubAcctInd "false"))
                (el :SfkpgAcct (el :Id safekeeping-account))
                (for [{:keys [isin quantity short?]} balances]
                  (el :BalForAcct (el :FinInstrmId (el :ISIN isin))
                      (el :AggtBal (el :ShrtLngInd (if short? "SHOR" "LONG"))
                          (el :Qty (el :Qty (el :Qty (el :Unit quantity))))))))))))

;; ---------------------------------------------------------------------------
;; Readers (parsed document -> the builder's data)
;; ---------------------------------------------------------------------------

(defn- at [node & tags] (reduce (fn [n t] (some-> n (iso/xml-find t))) node tags))
(defn- text-at [node & tags] (some-> (apply at node tags) iso/xml-text))
(def ^:private movement-of {"RECE" :receive "DELI" :deliver})
(def ^:private payment-of {"FREE" :free "APMT" :against-payment})

(defn- read-settlement [body ids-tag date-tag qty-tag amount-tag]
  (let [ids (at body ids-tag)
        direction (movement-of (text-at body (if (= ids-tag :TxIdDtls) :TxIdDtls :SttlmTpAndAddtlParams) :SctiesMvmntTp))
        pay (payment-of (text-at body (if (= ids-tag :TxIdDtls) :TxIdDtls :SttlmTpAndAddtlParams) :Pmt))
        side (at body (if (= direction :receive) :DlvrgSttlmPties :RcvgSttlmPties))
        amt (at body amount-tag)]
    (cond-> {:direction direction :payment-type pay
             :isin (text-at body :FinInstrmId :ISIN)
             :quantity (text-at body :QtyAndAcctDtls qty-tag :Qty :Unit)
             :safekeeping-account (text-at body :QtyAndAcctDtls :SfkpgAcct :Id)
             :transaction-type (text-at body :SttlmParams :SctiesTxTp :Cd)
             :place-of-settlement (text-at side :Dpstry :Id :AnyBIC)
             :agent (text-at side :Pty1 :Id :AnyBIC)}
      (text-at body :FinInstrmId :Desc) (assoc :description (text-at body :FinInstrmId :Desc))
      amt (assoc :amount {:currency (:Ccy (iso/xml-attrs (at amt :Amt))) :value (text-at amt :Amt)})
      true (assoc date-tag (text-at body :TradDtls (if (= date-tag :settlement-date) :SttlmDt :FctvSttlmDt) :Dt :Dt))
      (not= ids-tag :TxIdDtls) (assoc :tx-id (text-at body :TxId))
      (= ids-tag :TxIdDtls) (assoc :account-owner-tx-id (text-at ids :AcctOwnrTxId))
      (and (= ids-tag :TxIdDtls) (text-at ids :AcctSvcrTxId)) (assoc :account-servicer-tx-id (text-at ids :AcctSvcrTxId)))))

(defn read-message
  "Read a valid securities document back into the data its builder takes:
  {:message \"sese.023.001.09\" :data {...}}, or nil when the document does
  not validate."
  [doc]
  (when (:swift/valid? (validate doc))
    (let [ns' (:xmlns (iso/xml-attrs doc))
          k (some (fn [[k v]] (when (= v ns') k)) namespaces)
          data
          (case k
            :sese023 (read-settlement (at doc :SctiesSttlmTxInstr) :TxId :settlement-date :SttlmQty :SttlmAmt)
            :sese025 (read-settlement (at doc :SctiesSttlmTxConf) :TxIdDtls :effective-settlement-date :SttldQty :SttldAmt)
            :sese024 (let [body (at doc :SctiesSttlmTxStsAdvc)
                           first-tag (fn [tag] (some-> (at body tag) iso/xml-children first iso/xml-tag))]
                       (cond-> {:account-owner-tx-id (text-at body :TxId :AcctOwnrTxId)}
                         (text-at body :TxId :AcctSvcrTxId) (assoc :account-servicer-tx-id (text-at body :TxId :AcctSvcrTxId))
                         (first-tag :PrcgSts) (assoc :processing ({:AckdAccptd :acknowledged :Rjctd :rejected} (first-tag :PrcgSts)))
                         (first-tag :MtchgSts) (assoc :matching ({:Mtchd :matched :Umtchd :unmatched} (first-tag :MtchgSts)))
                         (first-tag :SttlmSts) (assoc :settlement ({:Pdg :pending :Flng :failing} (first-tag :SttlmSts)))))
            :semt002 (let [body (at doc :SctiesBalCtdyRpt) g (at body :StmtGnlDtls)]
                       {:statement-date (text-at g :StmtDtTm :Dt) :frequency (text-at g :Frqcy :Cd)
                        :update-type (text-at g :UpdTp :Cd) :basis (text-at g :StmtBsis :Cd)
                        :activity? (contains? #{"true" "1"} (text-at g :ActvtyInd))
                        :safekeeping-account (text-at body :SfkpgAcct :Id)
                        :balances (vec (for [b (iso/xml-find-all body :BalForAcct)]
                                         {:isin (text-at b :FinInstrmId :ISIN)
                                          :quantity (text-at b :AggtBal :Qty :Qty :Qty :Unit)
                                          :short? (= "SHOR" (text-at b :AggtBal :ShrtLngInd))}))}))]
      {:message (message-ids k) :data data})))
