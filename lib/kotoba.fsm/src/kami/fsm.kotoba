(ns kami.fsm
  (:export [idle-state move-state jump-state advance-player-v1]))

(def player-state-type
  [:variant :kami.fsm/player-state-v1
   [[:idle :i64] [:move :i64] [:jump :i64]]])

(defn idle-state [] [:alias player-state-type]
  (variant-new player-state-type :idle 0))

(defn move-state [] [:alias player-state-type]
  (variant-new player-state-type :move 0))

(defn jump-state [] [:alias player-state-type]
  (variant-new player-state-type :jump 0))

(defn advance-player-v1
  "Bounded transition profile for the package's default player FSM. The
   generic EDN FSM remains in CLJC; this profile admits only its reviewed
   state/event contract and has no host capabilities."
  [state [:alias player-state-type] events [:set :keyword]]
  [:alias player-state-type]
  (if (typed-set-contains [:set :keyword] events :jumping)
    (jump-state)
    (match-variant state player-state-type
      (:idle ignored
        (if (typed-set-contains [:set :keyword] events :moving)
          (move-state)
          (idle-state)))
      (:move ignored
        (if (typed-set-contains [:set :keyword] events :still)
          (idle-state)
          (move-state)))
      (:jump ignored
        (if (typed-set-contains [:set :keyword] events :moving)
          (move-state)
          (if (typed-set-contains [:set :keyword] events :still)
            (idle-state)
            (jump-state)))))))
