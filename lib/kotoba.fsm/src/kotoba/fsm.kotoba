(ns kotoba.fsm
  (:require [kami.fsm :as impl])
  (:export [idle-state move-state jump-state advance-player-v1]))

(def player-state-type
  [:variant :kami.fsm/player-state-v1
   [[:idle :i64] [:move :i64] [:jump :i64]]])

(defn idle-state [] [:alias player-state-type] (impl/idle-state))
(defn move-state [] [:alias player-state-type] (impl/move-state))
(defn jump-state [] [:alias player-state-type] (impl/jump-state))

(defn advance-player-v1
  [state [:alias player-state-type] events [:set :keyword]]
  [:alias player-state-type]
  (impl/advance-player-v1 state events))
