{:schema "kotoba-fsm-migration/v1"
 :profile :kami.fsm/player-v1
 :legacy
 {:implementation "src/kami/fsm.cljk"
  :facade "src/kotoba/fsm.cljk"
  :domain :generic-edn-fsm
  ;; Was :retained-semantic-oracle, i.e. the thing that RAN while the profile
  ;; was a checked replica. It is now the generic engine only: for
  ;; default-player-fsm within the profile's expressible domain the .cljc runs
  ;; the shipped KIR (see :runtime), and every other machine, state and event
  ;; collection is answered here, unchanged.
  :status :retained-generic-engine
  :delegates-to :kami.fsm/player-v1
  :unmodelled-api [:params :initial]}
 ;; The authority moved: the .kotoba is what executes, not what a test compares
 ;; against. The seam is deliberately thin and refuses rather than falling back.
 :runtime
 {:seam "src/kami/fsm_oracle.cljk"
  :artifact "resources/kami/fsm/oracle/player.kir.edn"
  :generator "test/kami/fsm_oracle_gen.cljk"
  :regenerate "kbb -M:test:gen"
  :artifact-target :js-kotoba-v1
  :interpreter {:dep "io.github.kotoba-lang/osaho"
                :sha "d58972da61758584a5bec0e863bcb3ea6fdd6c64"
                :namespace "kotoba.kir"
                :scope :runtime}
  :compiler-scope :test-only
  ;; Read off the artifact, never written down in the host: the variant's
  ;; declared cases and payload types, and the events parameter's member type.
  :delegation-conditions
  [[:machine :equals :default-player-fsm]
   [:state :declared-case-of :kami.fsm/player-state-v1 :with-payload :i64]
   [:events :set-of :keyword :at-most 32]]
  :fallback :generic-engine-unchanged
  :missing-artifact :throws
  :cljs-requires-register-kir true
  ;; The two checks the parity gate structurally cannot make.
  :checks {:drift "kami.fsm-oracle-test/the-shipped-artifact-is-the-current-source-compiled"
           :delegation "kami.fsm-oracle-test/the-host-reads-the-artifact-rather-than-keeping-a-copy"
           :fallback "kami.fsm-oracle-test/the-generic-engine-does-not-reach-the-guest"}
  :measured {:typed-set-max-items 32
             :typed-set-refused-at 33
             :profile-alphabet-size 3}}
 :canonical
 {:implementation "src/kami/fsm.kotoba"
  :facade "src/kotoba/fsm.kotoba"
  :conformance "test/kotoba/fsm_conformance.kotoba"
  :domain {:states [:idle :move :jump]
           :events [:moving :still :jumping]
           :transition-profile :default-player-fsm}}
 :safety
 {:ambient-authority false
  :host-capabilities []
  :general-callback-lowering false
  :generic-map-narrowed false
  :legacy-generic-api-retained true}
 :verification
 ;; The commit that COMPILED the shipped artifact and that the :test alias
 ;; pins. Advanced from 94f29b24 (release v0.6.29): there the KIR interpreter
 ;; still lived inside the compiler as kotoba.compiler.ir, so running the
 ;; artifact would have put the whole compiler on the runtime classpath.
 {:compiler-commit "806f5cef7d5bc11ad8ec8514ad6121efc73be6c7"
  :previous-compiler-commit "94f29b24cdf5c5aa92b35cf2dd41c1d56b8205c1"
  ;; Independent of the above: .github/workflows/ci.yml downloads this release
  ;; binary to compile test/kotoba/fsm_conformance.kotoba for the web/wasm
  ;; smoke below. It does not produce the shipped artifact. (Workflow left
  ;; untouched — Actions are disabled repo-wide, ADR-2607300900.)
  :installed-release "v0.6.29"
  :release-checksum-verified true
  :legacy {:tests 1 :assertions 5 :failures 0 :errors 0}
  ;; The canonical profile and the retained semantic oracle are bound to each
  ;; other by an in-process gate, not merely asserted to be equivalent. Before
  ;; it existed, :reference/:web/:wasm below only showed the Kotoba graph links
  ;; and executes -- its `main` hard-codes its own expectations, so it never
  ;; observes the .cljc at all.
  :parity {:gate "test/fsm_parity_test.cljk"
           ;; The oracle can no longer be default-player-fsm: that machine now
           ;; RUNS the shipped artifact, so the gate would compare a fresh
           ;; compile against the artifact compiled from the same source. It is
           ;; the same transition table under a map `advance` cannot recognise
           ;; as the profile's, which keeps a generic-engine answer on the
           ;; oracle side of every comparison.
           :oracle "kami.fsm/advance over fsm-parity-test/generic-oracle"
           :oracle-was "kami.fsm/advance over kami.fsm/default-player-fsm"
           :canonical "kami.fsm/advance-player-v1"
           :domain-cases 24
           :coverage :exhaustive-over-declared-domain
           :out-of-alphabet-events-checked true
           :two-step-sequences-checked true
           :unbound-exports []
           :unmodelled-legacy-api [:params]
           :suite {:tests 14 :assertions 488 :failures 0 :errors 0}
           :suite-before-delegation {:tests 7 :assertions 442 :failures 0 :errors 0}
           ;; Each new check was verified by breaking it. A source edit that
           ;; changes the KIR but not the semantics fails drift ALONE; turning
           ;; delegation off fails the delegation check while parity stays
           ;; green (which is the point: a host copy is what parity compares
           ;; against); loosening the machine test to :transitions equality
           ;; fails the fallback check alone.
           :mutation-verified
           {:drift {:mutation "rename the ignored variant-match binding"
                    :failures 1 :parity-still-green true}
            :delegation {:mutation "advance never delegates"
                         :failures 9 :parity-still-green true}
            :fallback {:mutation "delegate on :transitions equality"
                       :failures 2 :parity-still-green true}}}
  :reference {:runtime-main 42}
  :web {:runtime-main 42
        :project-digest "77dd631d462c0b7e3f8dad33d8eee00b6337f5b26e41efeb8c1a35adade6cf40"
        :required-capabilities []
        :artifact-sha256 "d12dd650083472a48e671a57dd971729fcdfcd3c37194765f669a1829c30f7fc"}
  :wasm {:runtime-main 42
         :project-digest "77dd631d462c0b7e3f8dad33d8eee00b6337f5b26e41efeb8c1a35adade6cf40"
         :value-abi :externref-v1
         :artifact-sha256 "d088e3da01419c8c8a6e16c4addaef74f8515a5a41bb0f7d3bd58a864f24088c"
         :browser-host-heap-used 0}}
 :cutover
 {:profile-authorized true
  ;; Still false, and no longer only a statement: delegation is conditional on
  ;; the values, and the fallback is asserted in the direction that can fail.
  :generic-api-authorized false
  :enforced-by "kami.fsm-oracle-test/the-generic-engine-does-not-reach-the-guest"
  :consumer-cutover :new-profile-only}}
