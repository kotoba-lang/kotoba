(ns kotoba.fsm-conformance
  (:require [kotoba.fsm :as fsm])
  (:export [main]))

(def player-state-type
  [:variant :kami.fsm/player-state-v1
   [[:idle :i64] [:move :i64] [:jump :i64]]])

(defn events [event :keyword] [:set :keyword]
  (typed-set [:set :keyword] event))

(defn no-events [] [:set :keyword]
  (typed-set [:set :keyword]))

(defn idle? [state [:alias player-state-type]] :bool
  (match-variant state player-state-type
    (:idle ignored true) (:move ignored false) (:jump ignored false)))

(defn move? [state [:alias player-state-type]] :bool
  (match-variant state player-state-type
    (:idle ignored false) (:move ignored true) (:jump ignored false)))

(defn jump? [state [:alias player-state-type]] :bool
  (match-variant state player-state-type
    (:idle ignored false) (:move ignored false) (:jump ignored true)))

(defn main
  [] :i64
  (if (move? (fsm/advance-player-v1 (fsm/idle-state) (events :moving)))
    (if (idle? (fsm/advance-player-v1 (fsm/move-state) (events :still)))
      (if (jump? (fsm/advance-player-v1 (fsm/idle-state) (events :jumping)))
        (if (idle? (fsm/advance-player-v1 (fsm/idle-state) (no-events)))
          (if (move? (fsm/advance-player-v1 (fsm/jump-state) (events :moving))) 42 5)
          4)
        3)
      2)
    1))
