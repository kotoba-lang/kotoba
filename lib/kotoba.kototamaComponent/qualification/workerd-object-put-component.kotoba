(ns qualification.workerd-object-put
  (:capabilities #{:object/put-block}))

(defn main []
  (typed-cap-call
   :object/put-block
   [:record :object/put [[:key :string] [:bytes :string]]]
   :i64
   (record
    [:record :object/put [[:key :string] [:bytes :string]]]
    "blocks/hash"
    "payload")))
