(ns qualification.workerd-log-read
  (:capabilities #{:log/read}))

(defn main []
  (log-read-byte-count
   (typed-cap-call
    :log/read
    [:record :log/read-request [[:cursor :i64] [:max-bytes :i64]]]
    [:record :log/read-response [[:next-cursor :i64] [:bytes :string]]]
    (record
     [:record :log/read-request [[:cursor :i64] [:max-bytes :i64]]]
     0 128))))
