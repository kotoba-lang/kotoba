(ns qualification.workerd-object-cas
  (:capabilities #{:object/compare-and-set-ref}))

(defn main []
  (object-cas-won
   (typed-cap-call
    :object/compare-and-set-ref
    [:record :object/cas
     [[:key :string] [:expected-etag :string] [:bytes :string]]]
    [:record :object/cas-response [[:won :bool] [:etag :string]]]
    (record
     [:record :object/cas
      [[:key :string] [:expected-etag :string] [:bytes :string]]]
     "refs/main"
     "etag-1"
     "next"))))
