(ns qualification.workerd-hash
  (:capabilities #{:hash/sha256}))

(defn main []
  (bytes-response-byte-count
   (typed-cap-call
    :hash/sha256
    [:record :cap/bytes-request [[:bytes :string]]]
    [:record :cap/bytes-response [[:bytes :string]]]
    (record [:record :cap/bytes-request [[:bytes :string]]] "payload"))))
