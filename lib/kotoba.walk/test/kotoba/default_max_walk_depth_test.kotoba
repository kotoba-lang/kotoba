;; Entry test for kotoba.walk.default-max-walk-depth (JUN-829). Returns the
;; failed-case count.
(ns kotoba.walk.default-max-walk-depth-test
  (:require [kotoba.walk.default-max-walk-depth :as d]))

(defn main [] :i64
  (+ (if (= (d/default-max-walk-depth) 1024) 0 1)
     (if (> (d/default-max-walk-depth) 0) 0 1)))
