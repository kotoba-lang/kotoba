;; Kotoba port of lib/kotoba.walk/src/kotoba/walk/default_max_walk_depth.cljk
;; (JUN-829).
;;
;; Named divergence: the Clojure constant `(def default-max-walk-depth 1024)`
;; is exposed as the zero-argument fn `default-max-walk-depth`, returning 1024.
;; amu admits only exported fns across modules (a qualified constant reference
;; is E6004). Callers write `(default-max-walk-depth)` where the original reads
;; `default-max-walk-depth`.
(ns kotoba.walk.default-max-walk-depth
  (:export [default-max-walk-depth]))

(defn default-max-walk-depth [] :i64 1024)
