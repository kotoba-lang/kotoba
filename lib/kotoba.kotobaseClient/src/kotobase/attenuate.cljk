(ns kotobase.attenuate
  "Offline attenuation of an Authn-minted Biscuit (ADR-2609241800 decision 2,
  build-actor skill: 下位の作業に渡すときは Biscuit に block を足して offline で絞る).

  An unsealed Biscuit carries the proof secret for its last block, so whoever
  holds it can append one more block — no call to Authn, no issuer key.
  Verifiers fold later blocks as narrowing only (`biscuit.kotoba/->delegated`:
  `cap` resources meet, the earliest `before` wins, `holder` may address a
  bearer token but never re-address one), so an appended block can remove
  authority and cannot add it.

  The block writer is `biscuit.wire/append-block` from kotoba-lang/
  org-biscuitsec; this namespace adds only the host crypto it injects
  (@noble/curves Ed25519, Web Crypto randomness) and the base64url text form
  HTTP uses. It never talks to the network.

  Kept out of `kotobase.client` on purpose: requiring it pulls
  org-biscuitsec (and its dev-protobuf codec) onto the consumer's source
  path, which a consumer that never attenuates should not have to carry."
  (:require ["@noble/curves/ed25519.js" :refer [ed25519]]
            [biscuit.wire :as wire]
            [kotoba.lang.text :as str]))

(defn- ->u8 [xs] (js/Uint8Array.from (clj->js (vec xs))))
(defn- byte-vec [xs] (vec (js/Array.from xs)))

(defn b64url->bytes [s]
  (let [pad (case (mod (count s) 4) 2 "==" 3 "=" "")
        b64 (str (-> s (str/replace "-" "+") (str/replace "_" "/")) pad)
        bin (js/atob b64)]
    (vec (map #(.charCodeAt bin %) (range (count bin))))))

(defn bytes->b64url [xs]
  (-> (js/btoa (apply str (map #(js/String.fromCharCode %) xs)))
      (str/replace "+" "-")
      (str/replace "/" "_")
      (str/replace #"=+$" "")))

(defn- sign [secret payload]
  (byte-vec (.sign ed25519 (->u8 payload) (->u8 secret))))

(defn append-facts
  "Append one facts-only block (`[[pred term …] …]`, e.g.
  `'[[before \"2026-09-24T10:05:00Z\"] [holder \"did:key:z6Mk…\"]]`) to the
  base64url token `token`. Returns the new base64url token."
  [token facts]
  (let [next-secret (byte-vec (.getRandomValues js/crypto (js/Uint8Array. 32)))
        next-public (byte-vec (.getPublicKey ed25519 (->u8 next-secret)))]
    (bytes->b64url
     (wire/append-block (b64url->bytes token)
                        {:facts (vec facts)
                         :next-secret next-secret
                         :next-public-key next-public
                         :sign-fn sign}))))

(defn attenuate
  "Narrow `token` for a sub-task. opts (all optional, at least one):
    :before  ISO instant — an earlier expiry than the token's own
    :holder  did — address the token to the delegate that will present it
    :caps    [[kind resource] …] — `[cap kind resource]` facts; a verifier
             meets them with the earlier blocks' caps
    :facts   extra raw facts, appended as given"
  [token {:keys [before holder caps facts]}]
  (let [fs (cond-> []
             before (conj ['before before])
             holder (conj ['holder holder])
             (seq caps) (into (map (fn [[k r]] ['cap k r]) caps))
             (seq facts) (into facts))]
    (when (empty? fs)
      (throw (ex-info "attenuate needs at least one of :before :holder :caps :facts"
                      {:type ::nothing-to-narrow})))
    (append-facts token fs)))

(defn blocks
  "The token's blocks with their decoded facts (no signature check) — for a
  holder inspecting what it holds."
  [token]
  (mapv #(select-keys % [:facts]) (wire/blocks-with-facts
                                   (wire/decode-token (b64url->bytes token)))))
