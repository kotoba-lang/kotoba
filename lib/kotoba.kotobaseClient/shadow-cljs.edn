;; Standalone test build for the canonical kotobase-client library.
;; Consumers (aozora PDS/AppView/SPA, kami-genko) add "src" to their own
;; :source-paths instead of depending on this build.
{;; kotoba-lang/datom-source is the IPatternSource contract + its
 ;; conformance suite (kotobase.datom-source implements it). Consumed as a
 ;; source-path, same way consumers consume this library — it has zero
 ;; dependencies of its own, so nothing else comes with it. `.deps/<name>`,
 ;; not `../<name>`: actions/checkout refuses a path outside the workspace,
 ;; and the sibling-path form failed CI for exactly that reason.
 :source-paths ["src" "test"
                ".deps/datom-source/src" ".deps/datom-source/test"
                ".deps/org-nist-sha2/src"
                ;; kotobase.authn / kotobase.attenuate (ADR-2609241800 step 4)
                ".deps/org-chainagnostic-cacao/src"
                ".deps/org-biscuitsec/src"
                ".deps/dev-protobuf/src"]
 :dependencies []
 :builds
 {:test {:target :node-test
         :output-to "out/node-tests.js"
         :ns-regexp "-test$"}
  :live-e2e {:target :node-script
             :output-to "out/live-e2e.js"
             :main kotobase.live-e2e/main}
  ;; Reads only, no credential — the acceptance for kotobase.blocks.
  :live-blocks {:target :node-script
                :output-to "out/live-blocks.js"
                :main kotobase.live-blocks/main}}}
