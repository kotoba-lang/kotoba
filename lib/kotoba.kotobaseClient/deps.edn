{:paths ["src"]
 ;; cljs-only (no reader-conditionals) -- consumed as a shadow-cljs
 ;; :source-path by the aozora PDS / AppView / SPA workers and by
 ;; kami-genko. No JVM deps; npm deps (@noble/curves, @ipld/dag-cbor)
 ;; are provided by the consumer's package.json (see this repo's package.json
 ;; for the standalone test build). SHA-256 is org-nist-sha2 via source-path.
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {;; **Test-scoped, and that placement is the point.** This repo is consumed as
  ;; a shadow-cljs `:source-path`, so a consumer supplies `datom.source` at
  ;; build time and never reads this alias -- putting it in `:deps` would
  ;; change what every consumer resolves, which is a decision with blast
  ;; radius. Here it changes nothing for them and lets the suite run ALONE.
  ;;
  ;; Without it there was no way to run these tests outside a consumer:
  ;; measured 2026-08-18, `Could not find namespace: datom.source` before any
  ;; assertion, which is why this repo had no fleet gate of any kind.
  ;; org-nist-sha2 joined datom-source here on 2026-09-06, for the same
  ;; reason and with the same placement. `kotobase.cid` moved SHA-256 from
  ;; @noble/hashes to `sha2.core`, and `kotobase.blocks` reads it too; the
  ;; suite had been resolving it through a `.deps/org-nist-sha2` symlink,
  ;; which exists on a developer's machine and nowhere else. `git-deps-of`
  ;; scans this whole file for `:git/sha`, aliases included, so a test-scoped
  ;; entry is shipped to a fleet node exactly like a top-level one would be —
  ;; without changing what a consumer resolves, which is what keeps this out
  ;; of `:deps`.
  :test {:extra-paths ["test"]
         :extra-deps {io.github.kotoba-lang/datom-source
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.datomSource"}
                      io.github.kotoba-lang/org-nist-sha2
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/gov.nist.sha2"}
                      ;; kotobase.authn / kotobase.attenuate (ADR-2609241800
                      ;; step 4) and their suite. Same placement and reason as
                      ;; above: `kotobase.client` does not require them, so a
                      ;; consumer that never exchanges resolves nothing new.
                      ;; Both are main tips on 2026-09-24 (gh api
                      ;; repos/kotoba-lang/<repo>/commits/main). dev-protobuf
                      ;; is org-biscuitsec's own pin, named here because
                      ;; `git-deps-of` ships only what this file names.
                      io.github.kotoba-lang/org-chainagnostic-cacao
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/org.chainagnostic.cacao"}
                      io.github.kotoba-lang/org-biscuitsec
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/org.biscuitsec.biscuit"}
                      io.github.kotoba-lang/dev-protobuf
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.devProtobuf"}}}
  ;; What a CONSUMER of `kotobase.authn` (the Authn -> Biscuit exchange) and
  ;; `kotobase.attenuate` (offline narrowing) adds. Kept out of `:deps` on
  ;; purpose: git-dep consumers such as kotobase-control-plane's authn pin
  ;; their own org-chainagnostic-cacao, and tools.deps would silently move it
  ;; to the newest sha named anywhere. Source-path consumers add the same
  ;; three `src` dirs to their :source-paths.
  :authn {:extra-deps {io.github.kotoba-lang/org-chainagnostic-cacao
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/org.chainagnostic.cacao"}
                       io.github.kotoba-lang/org-biscuitsec
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/org.biscuitsec.biscuit"}
                       io.github.kotoba-lang/dev-protobuf
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.devProtobuf"}}}}}
