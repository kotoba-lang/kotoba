#!/usr/bin/env kbb
;; Snapshot a real Filecoin mainnet tipset — every block header in it, the CID
;; the chain gave each one, and the tipset key in the order the chain put it
;; in — into test/filecoin/node/block_vectors.cljk.
;;
;; This is the check that proves the header codec, and it proves two separate
;; things at once:
;;
;;   - Recomputing each header's CID exercises the whole 16-field array: the
;;     nullable slots, the tag-42 links with their 0x00 prefix, the
;;     sign-magnitude ParentWeight and ParentBaseFee, the signature byte
;;     strings, the beacon and PoSt sub-arrays. One byte wrong anywhere and
;;     the CID is different.
;;
;;   - `Cids` comes back in ticket order, so reproducing that vector proves
;;     the tipset ordering — including that the comparison is over BLAKE2b-256
;;     of the VRF proof and over binary CIDs, neither of which is checkable
;;     from a single header.
;;
;; A mainnet tipset has several blocks from different miners with different
;; win counts, so the sample covers the optional fields in both states without
;; anyone having to construct a header by hand.
;;
;; NOT re-run in CI: the chain moves and a diff would always fail. This is a
;; permanent snapshot — mainnet history does not change.
;;
;;   kbb --backend sci testdata/gen_block_vectors.cljk > test/filecoin/node/block_vectors.cljk
(ns gen-block-vectors
  (:require [kotoba.lang.text :as str]))

(def endpoint "https://api.node.glif.io/rpc/v1")

(defn- parse-first-document
  "Glif's public endpoint answers with the response repeated, newline
  separated — two identical JSON documents in one body. `JSON.parse` and
  `Response.json()` both reject that (\"Unexpected non-whitespace character
  after JSON\"), so take the first line rather than the whole body. Observed
  2026-07-29; it is a property of that proxy, not of JSON-RPC."
  [text]
  (js/JSON.parse (first (remove str/blank? (str/split-lines text)))))

(defn- rpc [method params]
  (-> (js/fetch endpoint
                #js {:method "POST"
                     :headers #js {"content-type" "application/json"}
                     :body (js/JSON.stringify
                            (clj->js {:jsonrpc "2.0" :method method
                                      :params params :id 1}))})
      (.then #(.text %))
      (.then (fn [t]
               (let [r (parse-first-document t)]
                 (if-let [e (aget r "error")]
                   (throw (ex-info (str "rpc: " (js/JSON.stringify e)) {}))
                   (aget r "result")))))))

(defn- edn-str
  "A JS value as EDN, with string keys — the shape
  `filecoin.node.rpc/json->block-header` consumes."
  [x]
  (cond
    (nil? x) "nil"
    (string? x) (pr-str x)
    (number? x) (str x)
    (boolean? x) (str x)
    (array? x) (str "[" (str/join " " (map edn-str (array-seq x))) "]")
    (object? x) (str "{"
                     (str/join " " (mapcat (fn [k] [(pr-str k)
                                                    (edn-str (aget x k))])
                                           (js/Object.keys x)))
                     "}")
    :else (pr-str x)))

(defn -main []
  (-> (rpc "Filecoin.ChainHead" [])
      (.then
       (fn [head]
         (let [height (aget head "Height")
               cids (mapv #(aget % "/") (array-seq (aget head "Cids")))
               blocks (array-seq (aget head "Blocks"))]
           (println
            (str
             ";; GENERATED by testdata/gen_block_vectors.cljk — do not edit by hand.\n"
             ";; Filecoin mainnet tipset at height " height ", "
             (count blocks) " blocks.\n"
             ";; `tipset-cids` is the order the chain returned, which is ticket order.\n"
             ";; NOT regenerated in CI: the chain moves, but this is history.\n"
             "(ns filecoin.node.block-vectors)\n\n"
             "(def height " height ")\n\n"
             "(def tipset-cids\n  " (pr-str cids) ")\n\n"
             ";; Each entry pairs the header JSON as Lotus served it with the CID\n"
             ";; the chain addresses that block by.\n"
             "(def headers\n [\n"
             (str/join
              "\n"
              (map (fn [b c]
                     (str "  {:cid " (pr-str c) "\n   :json " (edn-str b) "}"))
                   blocks cids))
             "\n ])\n")))))
      (.catch (fn [e]
                (js/console.error (str e))
                (js/process.exit 1)))))

(-main)
