;; Zero dependencies. AES is a self-contained permutation and GCM is that
;; permutation plus a field multiplication; anything either of them needed
;; from elsewhere would be a seam.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}

}}
