(ns extract-wycheproof
  "Turn Project Wycheproof's `aes_gcm_test.json` into `test/aes/wycheproof_gcm.cljk`.

  Wycheproof is a corpus of cases chosen to break implementations rather than
  to demonstrate them — modified tags, IVs from 8 bits to 2056, and counter
  values that wrap the 32-bit field inside the block. NIST's own vectors
  demonstrate; these attack.

  ## Why a generator and not a copy

  Same reason as everywhere else in this workspace: the input is pinned by
  sha256 and re-extraction is a program, so a fixture rebuilt from a
  different corpus announces itself rather than quietly becoming a different
  claim. The whole corpus is emitted — no sampling, no top-N — because a
  truncated adversarial corpus is the subset that happened to pass.

      curl -sSo aes_gcm_test.json \\
        https://raw.githubusercontent.com/C2SP/wycheproof/master/testvectors_v1/aes_gcm_test.json
      kbb --backend sci scripts/extract_wycheproof.cljk aes_gcm_test.json"
  (:require ["fs" :as fs]
            ["crypto" :as crypto]
            [kotoba.lang.text :as str]))

(def source-url
  "https://raw.githubusercontent.com/C2SP/wycheproof/master/testvectors_v1/aes_gcm_test.json")

(def source-sha256
  "sha256 of the corpus, measured 2026-08-27."
  "985e5ecc172e181eaf49e89508b9470dcf478002eb7e8559c707eb42dc97dfe7")

(defn- sha256-hex [s]
  (-> (crypto/createHash "sha256") (.update s "utf8") (.digest "hex")))

(defn -main [& args]
  (let [path (first args)
        _ (when-not path
            (println "usage: kbb --backend sci scripts/extract_wycheproof.cljk <aes_gcm_test.json>")
            (println "  curl -sSo aes_gcm_test.json" source-url)
            (js/process.exit 2))
        text (str (fs/readFileSync path "utf8"))
        got (sha256-hex text)]
    (when (not= got source-sha256)
      (println "REFUSING: corpus sha256 mismatch")
      (println "  expected" source-sha256)
      (println "  got     " got)
      (js/process.exit 2))
    (let [j (js->clj (js/JSON.parse text) :keywordize-keys true)
          cases (vec (for [g (:testGroups j)
                           t (:tests g)]
                       {:id (:tcId t)
                        :key (:key t) :iv (:iv t) :aad (:aad t)
                        :msg (:msg t) :ct (:ct t) :tag (:tag t)
                        :result (keyword (:result t))
                        :flags (set (map keyword (:flags t)))}))
          declared (:numberOfTests j)]
      (when (not= declared (count cases))
        (println "REFUSING: corpus declares" declared "tests, extracted" (count cases))
        (js/process.exit 2))
      (println "cases" (count cases)
               "valid" (count (filter #(= :valid (:result %)) cases))
               "invalid" (count (filter #(= :invalid (:result %)) cases)))
      (let [out (str ";; GENERATED by scripts/extract_wycheproof.cljk — do not edit.\n"
                     ";;\n"
                     ";; Project Wycheproof AES-GCM, complete: " (count cases) " cases,\n"
                     ";; every group, no sampling.\n"
                     ";;\n"
                     ";; Source:  " source-url "\n"
                     ";; sha256:  " source-sha256 "\n"
                     "(ns aes.wycheproof-gcm)\n\n"
                     "(def declared-count " declared ")\n\n"
                     "(def cases\n  ["
                     (str/join "\n   " (map pr-str cases))
                     "])\n")]
        (fs/mkdirSync "test/aes" #js {:recursive true})
        (fs/writeFileSync "test/aes/wycheproof_gcm.cljk" out)
        (println "wrote test/aes/wycheproof_gcm.cljk" (count out) "bytes")))))

(apply -main *command-line-args*)
