#!/usr/bin/env kbb
;; Run the suite on the ClojureScript side.
;;
;; Not a formality. AES is byte arithmetic and GF(2^128) is bit arithmetic,
;; and both are places where the two runtimes differ: `bit-shift-right` on a
;; JVM long and on a ClojureScript number are not the same function once a
;; value is wide enough, and the GCM length fields are 64-bit counts that
;; `u64be` builds by division for exactly that reason.
;;
;;   kbb --backend sci --classpath "$(kbb -A:cljs -Spath)" scripts/verify-cljs.cljk
(ns verify-cljs
  (:require [kotoba.test :as t]
            [aes.core-test]
            [aes.gcm-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println)
  (if (t/successful? m)
    (println "all checks passed on the ClojureScript path")
    (do (println "FAILED on the ClojureScript path")
        (js/process.exit 1))))

(t/run-tests 'aes.core-test 'aes.gcm-test)
