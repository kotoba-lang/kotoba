;; aes.core -- the AES block cipher (FIPS 197) in native .kotoba (JUN-352, AWAI-61).
;; Bytes are :vector-i64 of 0..255.
;;   schedule key   -> the expanded round keys, 16 (nr + 1) bytes; empty unless the key
;;                     is 16, 24 or 32 bytes
;;   encrypt sched block -> the 16-byte ciphertext block
;; Only the forward cipher: GCM and CTR need no decryption. The S-box is the FIPS 197
;; table; the native gate checks it against its definition (multiplicative inverse in
;; GF(2^8), then the affine map). Not constant time: the S-box is a table lookup.
(ns aes.core
  (:export [sbox schedule encrypt]))

(defn- cat [a :vector-i64 b :vector-i64] :vector-i64
  (let [na (vector-count a) out (vector-alloc (+ na (vector-count b)))]
    (loop [i 0] (if (= i (vector-count out)) out
      (let [z (vector-assoc! out i (if (< i na) (vector-at a i) (vector-at b (- i na))))] (recur (+ i 1)))))))
(defn sbox [] :vector-i64
  ;; four literals: a vector literal holds at most 64 items
  (cat (cat (vector-i64 99 124 119 123 242 107 111 197 48 1 103 43 254 215 171 118 202 130 201 125 250 89 71 240 173 212 162 175 156 164 114 192 183 253 147 38 54 63 247 204 52 165 229 241 113 216 49 21 4 199 35 195 24 150 5 154 7 18 128 226 235 39 178 117)
            (vector-i64 9 131 44 26 27 110 90 160 82 59 214 179 41 227 47 132 83 209 0 237 32 252 177 91 106 203 190 57 74 76 88 207 208 239 170 251 67 77 51 133 69 249 2 127 80 60 159 168 81 163 64 143 146 157 56 245 188 182 218 33 16 255 243 210))
       (cat (vector-i64 205 12 19 236 95 151 68 23 196 167 126 61 100 93 25 115 96 129 79 220 34 42 144 136 70 238 184 20 222 94 11 219 224 50 58 10 73 6 36 92 194 211 172 98 145 149 228 121 231 200 55 109 141 213 78 169 108 86 244 234 101 122 174 8)
            (vector-i64 186 120 37 46 28 166 180 198 232 221 116 31 75 189 139 138 112 62 181 102 72 3 246 14 97 53 87 185 134 193 29 158 225 248 152 17 105 217 142 148 155 30 135 233 206 85 40 223 140 161 137 13 191 230 66 104 65 153 45 15 176 84 187 22))))
(defn- xtime [a :i64] :i64 (if (>= a 128) (bit-xor (bit-and (* a 2) 255) 27) (* a 2)))

(defn schedule [key :vector-i64] :vector-i64
  ;; FIPS 197 section 5.2
  (let [nk (quot (vector-count key) 4)]
    (if (or (not (or (= nk 4) (= nk 6) (= nk 8))) (not (= (* 4 nk) (vector-count key)))) (vector-i64)
      (let [nr (+ nk 6) s (sbox) total (* 16 (+ nr 1)) w (vector-alloc total)
            a (loop [i 0] (if (= i (* 4 nk)) 0 (let [x (vector-assoc! w i (vector-at key i))] (recur (+ i 1)))))]
        (loop [i nk rcon 1]
          (if (= (* 4 i) total) w
            (let [p (* 4 (- i 1))
                  t0 (vector-at w p) t1 (vector-at w (+ p 1)) t2 (vector-at w (+ p 2)) t3 (vector-at w (+ p 3))
                  rot (= (rem i nk) 0)
                  sub (and (> nk 6) (= (rem i nk) 4))
                  u0 (cond rot (bit-xor (vector-at s t1) rcon) sub (vector-at s t0) :else t0)
                  u1 (cond rot (vector-at s t2) sub (vector-at s t1) :else t1)
                  u2 (cond rot (vector-at s t3) sub (vector-at s t2) :else t2)
                  u3 (cond rot (vector-at s t0) sub (vector-at s t3) :else t3)
                  q (* 4 (- i nk))
                  b (vector-assoc! w (* 4 i) (bit-xor (vector-at w q) u0))
                  c (vector-assoc! w (+ (* 4 i) 1) (bit-xor (vector-at w (+ q 1)) u1))
                  d (vector-assoc! w (+ (* 4 i) 2) (bit-xor (vector-at w (+ q 2)) u2))
                  e (vector-assoc! w (+ (* 4 i) 3) (bit-xor (vector-at w (+ q 3)) u3))]
              (recur (+ i 1) (if rot (xtime rcon) rcon)))))))))

(defn encrypt [sched :vector-i64 block :vector-i64] :vector-i64
  ;; FIPS 197 section 5.1; the state is column-major: byte i is row (rem i 4), column (quot i 4)
  (let [nr (- (quot (vector-count sched) 16) 1) s (sbox)
        st (loop [i 0 out (vector-alloc 16)] (if (= i 16) out (recur (+ i 1) (vector-assoc! out i (bit-xor (vector-at block i) (vector-at sched i))))))]
    (loop [r 1 st st]
      (if (> r nr) st
        (let [;; SubBytes and ShiftRows together: row k of column c comes from column c + k
              sr (loop [i 0 out (vector-alloc 16)]
                   (if (= i 16) out
                     (recur (+ i 1) (vector-assoc! out i (vector-at s (vector-at st (rem (+ i (* 4 (rem i 4))) 16)))))))
              mc (if (= r nr) sr
                   (loop [c 0 out (vector-alloc 16)]
                     (if (= c 4) out
                       (let [a0 (vector-at sr (* 4 c)) a1 (vector-at sr (+ (* 4 c) 1))
                             a2 (vector-at sr (+ (* 4 c) 2)) a3 (vector-at sr (+ (* 4 c) 3))
                             x0 (xtime a0) x1 (xtime a1) x2 (xtime a2) x3 (xtime a3)
                             b (vector-assoc! out (* 4 c) (bit-xor (bit-xor x0 (bit-xor x1 a1)) (bit-xor a2 a3)))
                             d (vector-assoc! out (+ (* 4 c) 1) (bit-xor (bit-xor a0 x1) (bit-xor (bit-xor x2 a2) a3)))
                             e (vector-assoc! out (+ (* 4 c) 2) (bit-xor (bit-xor a0 a1) (bit-xor x2 (bit-xor x3 a3))))]
                         (recur (+ c 1) (vector-assoc! out (+ (* 4 c) 3) (bit-xor (bit-xor (bit-xor x0 a0) a1) (bit-xor a2 x3))))))))]
          (recur (+ r 1)
                 (loop [i 0 out (vector-alloc 16)]
                   (if (= i 16) out (recur (+ i 1) (vector-assoc! out i (bit-xor (vector-at mc i) (vector-at sched (+ (* 16 r) i)))))))))))))
