(ns aes.oracle-test
  "AES and AES-GCM against the JVM's own implementations, over sweeps the
  fixed corpus does not cover.

  Wycheproof says this agrees with the world on 316 chosen inputs. It does
  not say the two agree on message lengths 0..200, or on AAD lengths that
  straddle the sixteen-byte GHASH block, or on IV lengths in between the ones
  it happens to name. That is what a sweep is for: the corpus attacks, the
  oracle covers."
  (:require [kotoba.test :refer [deftest is testing]]
            [aes.core :as aes]
            [aes.gcm :as gcm])
  (:import [javax.crypto Cipher]
           [javax.crypto.spec SecretKeySpec GCMParameterSpec]))

(defn- ->bytes ^bytes [v] (byte-array (map unchecked-byte v)))
(defn- <-bytes [^bytes b] (mapv #(bit-and (int %) 0xff) b))

(defn- jvm-ecb [key block]
  (let [c (Cipher/getInstance "AES/ECB/NoPadding")]
    (.init c Cipher/ENCRYPT_MODE (SecretKeySpec. (->bytes key) "AES"))
    (<-bytes (.doFinal c (->bytes block)))))

(defn- jvm-gcm-seal [key iv aad pt]
  (let [c (Cipher/getInstance "AES/GCM/NoPadding")]
    (.init c Cipher/ENCRYPT_MODE (SecretKeySpec. (->bytes key) "AES")
           (GCMParameterSpec. 128 (->bytes iv)))
    (when (seq aad) (.updateAAD c (->bytes aad)))
    (<-bytes (.doFinal c (->bytes pt)))))

(defn- pseudo [n seed] (mapv #(mod (* seed (inc %)) 251) (range n)))

(deftest the-block-cipher-agrees-across-every-key-size
  (doseq [ks [16 24 32]
          i (range 40)]
    (let [k (pseudo ks (+ 3 i))
          b (pseudo 16 (+ 11 i))]
      (is (= (jvm-ecb k b) (aes/encrypt-block (aes/expand-key! k) b))
           (str "key " ks " case " i)))))

(deftest gcm-agrees-over-a-sweep-of-message-and-aad-lengths
  (doseq [ks [16 24 32]
          mn [0 1 15 16 17 31 32 33 64 100 200]
          an [0 1 16 17 48]]
    (let [k (pseudo ks 5) iv (pseudo 12 7)
          m (pseudo mn 13) a (pseudo an 17)
          mine (gcm/seal k iv a m)]
      (is (= (jvm-gcm-seal k iv a m) (:bytes mine))
          (str "key " ks " msg " mn " aad " an)))))

(deftest gcm-agrees-on-iv-lengths-either-side-of-the-special-case
  ;; Twelve bytes takes one path and everything else takes another. The
  ;; boundary is where an implementation that special-cases the wrong length,
  ;; or forgets that the general path exists, still passes every ordinary
  ;; test.
  (doseq [ivn [1 8 11 12 13 15 16 17 32 64 129]]
    (let [k (pseudo 32 19) iv (pseudo ivn 23) m (pseudo 40 29) a (pseudo 20 31)]
      (is (= (jvm-gcm-seal k iv a m) (:bytes (gcm/seal k iv a m)))
          (str "iv " ivn)))))

(deftest the-oracle-can-fail
  (testing "a differential test that cannot report a difference proves nothing"
    (is (not= (jvm-ecb (vec (repeat 16 0)) (vec (repeat 16 0)))
              (jvm-ecb (vec (repeat 16 0)) (assoc (vec (repeat 16 0)) 0 1))))
    (is (not= (jvm-gcm-seal (vec (repeat 16 0)) (vec (repeat 12 0)) [] [1])
              (jvm-gcm-seal (vec (repeat 16 0)) (vec (repeat 12 1)) [] [1])))
    (testing "and the 12-byte IV really does take a different path"
      (let [k (pseudo 16 3) m (pseudo 16 5)]
        (is (not= (jvm-gcm-seal k (vec (repeat 12 1)) [] m)
                  (jvm-gcm-seal k (vec (repeat 13 1)) [] m)))))))
