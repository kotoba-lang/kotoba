(ns aes.core-test
  "The block cipher on its own.

  The correctness evidence for AES itself is in `aes.gcm-test`: every one of
  the 316 Wycheproof cases runs the forward cipher, across all three key
  sizes, and a single wrong S-box entry or round-constant would break them.
  What is here is what that corpus does *not* say — the shape of the key
  schedule, and that the derived tables are self-consistent."
  (:require [kotoba.test :refer [deftest is testing]]
            [aes.core :as aes]))

(deftest the-schedule-has-the-length-fips-197-gives-it
  (doseq [[bytes rounds] {16 10, 24 12, 32 14}]
    (let [s (aes/expand-key (vec (repeat bytes 0)))]
      (is (= :ok (:status s)))
      (is (= rounds (:rounds s)) (str bytes "-byte key"))
      (is (= (* 16 (inc rounds)) (count (:round-keys s)))
          "one block of round key per AddRoundKey, including the initial one"))))

(deftest the-first-round-key-is-the-key
  (doseq [n [16 24 32]]
    (let [k (vec (map #(mod (* 7 (inc %)) 256) (range n)))]
      (is (= (take 16 k) (take 16 (:round-keys (aes/expand-key k))))))))

(deftest key-lengths-outside-the-three-are-refused
  (doseq [n [0 1 15 17 20 31 33 64]]
    (is (= :bad-key-length (:reason (aes/expand-key (vec (repeat n 0)))))
        (str n " bytes")))
  (is (thrown? js/Error
               (aes/expand-key! (vec (repeat 20 0))))))

(deftest the-derived-tables-are-a-permutation
  ;; The S-box is computed, not copied. A derivation can still be wrong, and
  ;; the one failure that would not show up as a wrong ciphertext for *some*
  ;; input is a table that is not a bijection -- so it is checked directly.
  (let [sched (aes/expand-key! (vec (repeat 16 0)))
        outputs (map (fn [b]
                       ;; one byte through the cipher in isolation is not the
                       ;; S-box, but a collision in the S-box shows up as a
                       ;; collision here across single-byte differences
                       (aes/encrypt-block sched (assoc (vec (repeat 16 0)) 0 b)))
                     (range 256))]
    (is (= 256 (count (set outputs)))
        "256 distinct inputs give 256 distinct blocks — the cipher is a permutation")))

(deftest a-block-is-sixteen-bytes-of-unsigned-values
  (let [sched (aes/expand-key! (vec (repeat 32 9)))
        out (aes/encrypt-block sched (vec (range 16)))]
    (is (= 16 (count out)))
    (is (every? #(<= 0 % 255) out))
    (testing "and it is deterministic"
      (is (= out (aes/encrypt-block sched (vec (range 16))))))
    (testing "and it depends on the whole key"
      (is (not= out (aes/encrypt-block (aes/expand-key! (assoc (vec (repeat 32 9)) 31 8))
                                       (vec (range 16))))))))
