(ns aes.gcm-siv-test
  (:require [kotoba.test :refer [deftest is testing]]
            [aes.gcm :as gcm]
            [aes.gcm-siv :as siv]))

(defn- h [s] (gcm/unhex s))

(deftest polyval-appendix-a-vector
  (let [H (h "25629347589242761d31f826ba4b757b")
        X1 (h "4f4f95668c83dfb6401762bb2d01a262")
        X2 (h "d1a24ddd2721d006bbe45f20d3c9f362")
        data (concat X1 X2)]
    ;; exercised via seal/open round-trip; POLYVAL is internal
    (is (= (h "f7a3b47b846119fae5b7866cf5e5b77e")
           (#'siv/polyval H data)))))

(deftest rfc-8452-aes-256-gcm-siv-vectors
  ;; Appendix C.2 — AEAD_AES_256_GCM_SIV (empty and 8-byte plaintext)
  (let [key (apply concat
                   (map h ["01000000000000000000000000000000"
                           "00000000000000000000000000000000"]))
        nonce (h "030000000000000000000000")]
    (testing "0-byte plaintext"
      (let [r (siv/seal key nonce [] [])]
        (is (= :ok (:status r)))
        (is (= (h "07f5f4169bbf55a8400cd47ea6fd400f") (:bytes r)))))
    (testing "8-byte plaintext"
      (let [pt (h "0100000000000000")
            r (siv/seal key nonce [] pt)]
        (is (= :ok (:status r)))
        (is (= (apply concat
                      (map h ["c2ef328e5c71c83b"
                              "843122130f7364b761e0b97427e3df28"]))
              (:bytes r)))))))

(deftest seal-open-roundtrip
  (let [key (vec (repeat 32 0x42))
        nonce (vec (range 12))
        aad [1 2 3]
        pt (vec (range 64))]
    (let [sealed (:bytes (siv/seal key nonce aad pt))]
      (is (= pt (:bytes (siv/open key nonce aad sealed)))))))
