(ns aes.gcm-test
  "AES-GCM against the complete Project Wycheproof corpus, on both runtimes.

  316 cases: three key sizes, IVs from 8 bits to 2056, thirty-six that wrap
  the 32-bit counter, eighty-one forged tags and six empty IVs. The corpus is
  emitted whole by `scripts/extract_wycheproof.cljk` — a truncated
  adversarial corpus is the subset that happened to pass, so the count the
  file declares is asserted before anything is run.

  Every rejection is checked **by reason**, not merely by not-succeeding. A
  test that accepts any failure counts a run that broke for an unrelated
  cause as a run that discriminated."
  (:require [kotoba.test :refer [deftest is testing]]
            [aes.gcm :as gcm]
            [aes.wycheproof-gcm :as wp]))

(defn- h [s] (gcm/unhex s))

(deftest the-corpus-is-whole
  (is (= wp/declared-count (count wp/cases))
      "every case the corpus declares is present")
  (is (= 316 (count wp/cases)))
  (is (= #{16 24 32} (set (map #(count (h (:key %))) wp/cases)))
      "all three key sizes")
  (is (< 1 (count (set (map #(count (h (:iv %))) wp/cases))))
      "IV lengths vary — the 96-bit special case is not the only one exercised"))

(deftest valid-cases-seal-to-exactly-the-published-bytes
  (doseq [c wp/cases :when (= :valid (:result c))]
    (let [r (gcm/seal (h (:key c)) (h (:iv c)) (h (:aad c)) (h (:msg c)))]
      (is (= :ok (:status r)) (str "tc " (:id c)))
      (is (= (:ct c) (gcm/hex (:ciphertext r))) (str "tc " (:id c) " ciphertext"))
      (is (= (:tag c) (gcm/hex (:tag r))) (str "tc " (:id c) " tag")))))

(deftest valid-cases-open-back-to-the-plaintext
  (doseq [c wp/cases :when (= :valid (:result c))]
    (let [r (gcm/open (h (:key c)) (h (:iv c)) (h (:aad c)) (h (str (:ct c) (:tag c))))]
      (is (= :ok (:status r)) (str "tc " (:id c)))
      (is (= (:msg c) (gcm/hex (:bytes r))) (str "tc " (:id c) " plaintext")))))

(deftest invalid-cases-are-rejected-for-the-reason-they-name
  (doseq [c wp/cases :when (= :invalid (:result c))]
    (let [r (gcm/open (h (:key c)) (h (:iv c)) (h (:aad c)) (h (str (:ct c) (:tag c))))
          expected (cond
                     (contains? (:flags c) :ZeroLengthIv) :empty-iv
                     (contains? (:flags c) :ModifiedTag) :authentication-failed
                     :else :authentication-failed)]
      (is (= :error (:status r)) (str "tc " (:id c)))
      (is (= expected (:reason r))
          (str "tc " (:id c) " " (pr-str (:flags c))
               " — rejected, but not for the reason this case is about")))))

(deftest the-counter-wrap-cases-are-actually-present-and-actually-differ
  ;; A guard on the guard. If the corpus ever stopped carrying these, the
  ;; three tests above would still pass and the 32-bit counter would stop
  ;; being tested by anything.
  (let [wrap (filter #(contains? (:flags %) :CounterWrap) wp/cases)]
    (is (= 36 (count wrap)))
    (testing "and incrementing the whole block instead would be caught"
      ;; Not a claim about this implementation -- a claim about the corpus.
      ;; These messages are long enough for the low word to carry, which is
      ;; the only condition under which the two ways of counting differ.
      (is (every? #(< 0 (count (h (:msg %)))) wrap)))))

(deftest sizes-are-refused-rather-than-adapted
  (let [k (vec (repeat 16 0)) iv (vec (repeat 12 0))]
    (testing "a key that is not one of the three lengths"
      (is (= :bad-key-length (:reason (gcm/seal (vec (repeat 20 0)) iv [] []))))
      (is (= :bad-key-length (:reason (gcm/seal (vec (repeat 33 0)) iv [] []))))
      (is (= :bad-key-length (:reason (gcm/open (vec (repeat 15 0)) iv [] (vec (repeat 16 0)))))))

    (testing "an empty IV, on both paths"
      (is (= :empty-iv (:reason (gcm/seal k [] [] []))))
      (is (= :empty-iv (:reason (gcm/open k [] [] (vec (repeat 16 0)))))))

    (testing "a sealed message too short to contain a tag"
      (is (= :too-short-for-a-tag (:reason (gcm/open k iv [] (vec (repeat 15 0)))))))

    (testing "the three legal key lengths are accepted"
      (doseq [n [16 24 32]]
        (is (= :ok (:status (gcm/seal (vec (repeat n 7)) iv [] [1 2 3]))))))))

(deftest aad-binds
  (let [k (vec (repeat 32 3)) iv (vec (repeat 12 1))
        sealed (:bytes (gcm/seal k iv [9 9] [1 2 3 4]))]
    (is (= [1 2 3 4] (:bytes (gcm/open k iv [9 9] sealed))))
    (is (= :authentication-failed (:reason (gcm/open k iv [9 8] sealed))))
    (is (= :authentication-failed (:reason (gcm/open k iv [] sealed))))
    (is (= :authentication-failed (:reason (gcm/open k (vec (repeat 12 2)) [9 9] sealed))))
    (is (= :authentication-failed (:reason (gcm/open (vec (repeat 32 4)) iv [9 9] sealed))))))

(deftest empty-messages-and-empty-aad-are-legal
  (let [k (vec (repeat 16 1)) iv (vec (repeat 12 2))
        r (gcm/seal k iv [] [])]
    (is (= :ok (:status r)))
    (is (= 16 (count (:bytes r))) "a tag and nothing else")
    (is (= [] (:bytes (gcm/open k iv [] (:bytes r)))))))
