;; etzhayyim-project-common-crawl — scoped bb config for the clj/cljc port
;; (ADR-2606280030). The ported namespaces are pure + bb-batteries only
;; (cheshire + babashka.http-client are bundled in bb), so no external deps are
;; pinned here and the repo-root bb.edn is untouched.
{:paths ["clj"]
 :deps {
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "64b3ffb2099e6911827c1fe8858bad31236b18ff"
         :deps/root "lib/kotoba.bytes"}}
 :tasks
 {test {:doc "Run the common-crawl clj/cljc test suites under bb."
        :task (load-file "run_tests.cljk")}}}
