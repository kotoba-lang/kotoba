;; Common Crawl (cc26m4x1) appview frontend — reagent + re-frame, rendered
;; with jp-go-dds (デジタル庁デザインシステム). Migrated from
;; appview/etzhayyim-wasm-common-crawl-cc26m4x1/svelte (Svelte 5 + SvelteKit +
;; @sveltejs/adapter-cloudflare — a single src/routes/+page.svelte, an
;; auto-generated appview status scaffold with no interactivity).
;;
;; reagent/re-frame/clojurescript/shadow-cljs live under the :cljs alias
;; rather than top-level :deps (workspace convention enforced by the
;; jvm-new-surface-guard PreToolUse hook — see
;; orgs/cloud-itonami/okaimono/appview/okaimono-shopping-mcp-component/cljs/deps.edn
;; for the same shape, which landed and builds). jp-go-dds is a workspace git
;; dep and stays top-level.
;;
;; The jp-go-dds :git/sha below is an explicit floor, not an arbitrary pin —
;; it is the exact sha the okaimono cljs frontend (linked above) already
;; builds against in this workspace, so it is proven rather than assumed.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system.git"
         :git/sha "dc4602dc17bce8f6e9ba038e92b3e95fcc411b49"}}
 :aliases {:cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                                thheller/shadow-cljs {:mvn/version "2.28.20"}
                                reagent/reagent {:mvn/version "1.2.0"}
                                re-frame/re-frame {:mvn/version "1.4.3"}}}
           :test {:extra-paths ["test"]}}}
