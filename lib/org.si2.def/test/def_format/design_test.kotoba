;; Test for def-format.design. main returns the number of failed cases.
(ns def-format.design-test
  (:export [main])
  (:require [def-format.design :as d]))

(defn- chk-i64 [got :i64 want :i64] :i64
  (if (= got want) 0 1))
(defn- chk-str [got :string want :string] :i64
  (if (string=? got want) 0 1))

(defn main [] :i64
  (let [des (d/design "top" 1000 (document-vector (document-i64 0) (document-i64 0)
                                                  (document-i64 100) (document-i64 200)))
        c1 (chk-str (option-value-of [:option :string]
                                     (document-string-value (option-value-of [:option :document] (document-get des (document-keyword :name)) (document-null)))
                                     "<none>")
                    "top")
        c2 (chk-i64 (option-value-of [:option :i64]
                                     (document-i64-value (option-value-of [:option :document] (document-get des (document-keyword :units-distance-microns)) (document-null)))
                                     -1)
                    1000)
        area (option-value-of [:option :document] (document-get des (document-keyword :die-area)) (document-null))
        c3 (chk-i64 (document-count area) 4)
        c4 (chk-i64 (option-value-of [:option :i64]
                                     (document-i64-value (option-value-of [:option :document] (document-vector-at area 3) (document-null)))
                                     -1)
                    200)]
    (+ c1 (+ c2 (+ c3 c4)))))
