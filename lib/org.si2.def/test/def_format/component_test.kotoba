(ns def-format.component-test (:export [main]) (:require [def-format.component :as p]))

(defn- ok [b :bool] :i64
  (if b 0 1))

(defn- comp [st :document] :document
  (p/component (document-string "U1") (document-string "INV") st
               (document-string "10 20") (document-string "N")))

(defn- placed-checks [] :i64
  (+ (ok (p/placed? (comp (document-keyword :placed))))
     (ok (p/placed? (comp (document-keyword :fixed))))
     (ok (not (p/placed? (comp (document-keyword :unplaced)))))
     (ok (not (p/placed? (comp (document-keyword :cover)))))))

(defn- filter-checks [] :i64
  (let [v (document-vector (comp (document-keyword :placed))
                           (comp (document-keyword :unplaced))
                           (comp (document-keyword :fixed))
                           (comp (document-keyword :cover)))
        pc (p/placed-components v)]
    (+ (ok (= (document-count pc) 2))
       (ok (document-equal? (option-or (document-vector-at pc 1) (document-null))
                            (comp (document-keyword :fixed)))))))

(defn main [] :i64
  (+ (placed-checks) (filter-checks)))
