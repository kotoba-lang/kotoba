;; Entry test for def-format.row (JUN-829). Returns the failed-case count.
(ns def-format.row-test
  (:require [def-format.row :as r]))

(defn main [] :i64
  (let [rw (r/row "R1" "core" "0 0" "N" 10 4)
        tr (r/track "M1" "X" 0 100 5)]
    (+ (if (= (r/row-total-width rw) 40) 0 1)
       (if (= (:name rw) "R1") 0 1)
       (if (= (:num-x rw) 10) 0 1)
       (if (= (:count tr) 5) 0 1)
       (if (= (:layer tr) "M1") 0 1))))
