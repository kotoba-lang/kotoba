;; Port of def-format.design (design.cljk), Kotoba-native. PARTIAL port.
;; Ported: design (the DESIGN map builder).
;; Not ported: die-area-um2. It takes a quotient of doubles and Math/abs on
;; doubles. amu's :f64 is an opaque IEEE bit carrier with no arithmetic,
;; comparison or division (seed HEADS, R6C), so the result cannot be computed.
;; Named divergences in design:
;;   - name is a :string; units-distance-microns is an :i64 (DEF database
;;     units are integers); die-area is a :document vector [x1 y1 x2 y2] of i64.
(ns def-format.design
  (:export [design]))

(defn design [nm :string units :i64 die-area :document] :document
  (document-map :name (document-string nm)
                :units-distance-microns (document-i64 units)
                :die-area die-area))
