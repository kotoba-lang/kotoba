(ns def-format.net
  "Parity port of def-format.net (DEF NETS section: net connectivity and
   simplified routed-wire geometry for a placed-and-routed design, Si2 DEF).

   Classification: portable pure -- maps, strings, vectors, one `count`;
   no interop, no throw, no host boundary (ADR-2608261100).

   The Clojure original's `net` coerces a nil `routed` to `[]` with `or`.
   The port types every parameter as a required `:document`, so the nil->[]
   coercion stays at the caller: the parity test passes an explicit empty
   vector where the JVM original would have received nil. Everything else
   maps one-to-one onto `:document` values."
  (:export [net connection routed-wire net-fanout]))

(defn net [name :string connections :document routed :document] :document
  (document-map :name (document-string name)
                :connections connections
                :routed routed))

(defn connection [instance :string pin :string] :document
  (document-map :instance (document-string instance)
                :pin (document-string pin)))

(defn routed-wire [layer :string points :document] :document
  (document-map :layer (document-string layer)
                :points points))

(defn net-fanout [n :document] :i64
  ;; Number of instance/pin connections on a net, i.e. how many component
  ;; pins this net fans out to.
  (document-count
   (option-value-of [:option :document]
                    (document-get n :connections)
                    (document-null))))
