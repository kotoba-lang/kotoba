;; Port of def-format.component (component.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from component.cljk:
;;   - `placement-statuses` is a zero-arg function (set).
;;   - `placed-components` filters a :document vector and returns a vector;
;;     the source's filterv on a non-vector is not reproduced (it reads as
;;     an empty result).

(ns def-format.component
  (:export [placement-statuses component placed? placed-components]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn placement-statuses [] :document
  (document-set (document-keyword :placed)
                (document-keyword :fixed)
                (document-keyword :unplaced)
                (document-keyword :cover)))

(defn component [instance-name :document cell-ref :document status :document location :document orientation :document] :document
  (document-map :instance-name instance-name
                :cell-ref cell-ref
                :status status
                :location location
                :orientation orientation))

(defn placed? [c :document] :bool
  (let [s (field c :status)]
    (or (document-equal? s (document-keyword :placed))
        (document-equal? s (document-keyword :fixed)))))

(defn- placed-from [v :document i :i64 acc :document] :document
  (if (>= i (document-count v))
    acc
    (let [c (option-or (document-vector-at v i) (document-null))]
      (placed-from v (+ i 1) (if (placed? c) (document-vector-conj acc c) acc)))))

(defn placed-components [components :document] :document
  (placed-from components 0 (document-vector)))
