;; Kotoba port of lib/org.si2.def/src/def_format/row.cljk (JUN-829).
;; DEF ROWS/TRACKS section: placement-site grid (ROW) and routing track grid
;; (TRACKS), Si2 DEF.
;;
;; Named divergences:
;; - The Clojure maps returned by `row` and `track` become typed defrecords
;;   `Row` and `Track`, whose field names are the original map keys. Each fn
;;   returns its record via an explicit [:record ...] type.
;; - `row-total-width` takes a Row record (the original takes a map).
;; - No :document (host map) representation: this checker build rejects
;;   :document-typed returns (E2104), so the map shape is not carried as
;;   document values.
(ns def-format.row
  (:export [row track row-total-width]))

(defrecord Row [name :string site :string origin :string orientation :string num-x :i64 step-x :i64])

(defrecord Track [layer :string direction :string start :i64 step :i64 count :i64])

(defn row [name :string site :string origin :string orientation :string num-x :i64 step-x :i64]
  [:record :def-format.row/Row [[:name :string] [:site :string] [:origin :string] [:orientation :string] [:num-x :i64] [:step-x :i64]]]
  (->Row name site origin orientation num-x step-x))

(defn track [layer :string direction :string start :i64 step :i64 count :i64]
  [:record :def-format.row/Track [[:layer :string] [:direction :string] [:start :i64] [:step :i64] [:count :i64]]]
  (->Track layer direction start step count))

(defn row-total-width
  "Total x-extent spanned by a row's repeated placement sites: num-x * step-x,
   in DEF database units."
  [r [:record :def-format.row/Row [[:name :string] [:site :string] [:origin :string] [:orientation :string] [:num-x :i64] [:step-x :i64]]]] :i64
  (* (:num-x r) (:step-x r)))
