;; org-w3-webaudio — raw W3C Web Audio API thin wrapper (browser-only for the
;; AudioContext/AudioWorkletNode binding layer) + a portable, testable
;; message-protocol namespace for the worklet MessagePort boundary. DSP
;; (synthesis/effects/mixer bus) lives in kotoba-lang/audio, which is meant
;; to consume this the way kami-webgpu consumes org-w3-webgpu.
{:paths ["src"]
 :deps  {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       }
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts   ["-m" "cognitect.test-runner"]}
  ;; Real-browser AudioWorkletProcessor E2E (scripts/build-e2e-bundles.sh +
  ;; test/e2e/run_e2e.cljk). Only this alias needs the ClojureScript compiler
  ;; and a (pinned-SHA, test-only) dependency on kotoba-lang/audio's own
  ;; audio.synth -- the E2E worklet bundle requires it directly so the
  ;; worklet-side DSP is genuinely audio.cljc's code, not a reimplementation.
  ;; Bump AUDIO_GIT_SHA (or override via `-Sdeps` at build time) when
  ;; kotoba-lang/audio advances.
  :e2e {:extra-paths ["test/e2e/src"]
        :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                     io.github.kotoba-lang/audio
                     {:git/sha "cf2f56a4b417b5e7a46100aff0a23f65d30963d6"}}}}}
