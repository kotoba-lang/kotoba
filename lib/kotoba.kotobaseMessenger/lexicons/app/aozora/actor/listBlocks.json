{
  "lexicon": 1,
  "id": "app.aozora.actor.listBlocks",
  "description": "List the caller's OWN blocked actors. did is required — this is never a way to see who blocked someone else, only your own outgoing blocks (the AppView projection filters by did the same way aozora.appview.convo's preference records are author-scoped).",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "did": { "type": "string" },
        "limit": { "type": "integer" }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "blocks": {
              "type": "array",
              "items": { "type": "ref", "ref": "#blockView" }
            }
          },
          "required": ["blocks"]
        }
      }
    },
    "blockView": {
      "type": "object",
      "properties": {
        "blockedDid": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  }
}
