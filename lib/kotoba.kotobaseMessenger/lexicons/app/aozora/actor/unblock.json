{
  "lexicon": 1,
  "id": "app.aozora.actor.unblock",
  "description": "Remove a previously-created app.aozora.actor.block record.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "blockedDid": { "type": "string" }
          },
          "required": ["blockedDid"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "did": { "type": "string" },
            "blockedDid": { "type": "string" }
          },
          "required": ["did", "blockedDid"]
        }
      }
    }
  }
}
