{
  "lexicon": 1,
  "id": "app.aozora.convo.addMember",
  "description": "Add a member to an aozora conversation. Only the convo's creator may call this — the caller's session DID must match the convo's creatorDid, or the call fails with AuthRequired.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convoId": { "type": "string" },
            "did": { "type": "string" },
            "role": { "type": "string" },
            "joinedAt": { "type": "string" }
          },
          "required": ["convoId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convoId": { "type": "string" },
            "did": { "type": "string" },
            "uri": { "type": "string", "format": "at-uri" },
            "cid": { "type": "string", "format": "cid" },
            "rkey": { "type": "string" }
          },
          "required": ["convoId", "did", "uri", "cid", "rkey"]
        }
      }
    }
  }
}
