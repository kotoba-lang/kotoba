{
  "lexicon": 1,
  "id": "app.aozora.convo.listMembers",
  "description": "List members of an aozora conversation.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "convoId": { "type": "string" },
        "limit": { "type": "integer" }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "members": {
              "type": "array",
              "items": { "type": "ref", "ref": "#memberView" }
            }
          },
          "required": ["members"]
        }
      }
    },
    "memberView": {
      "type": "object",
      "properties": {
        "convoId": { "type": "string" },
        "did": { "type": "string" },
        "role": { "type": "string" },
        "joinedAt": { "type": "string" }
      }
    }
  }
}
