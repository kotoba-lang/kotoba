{
  "lexicon": 1,
  "id": "app.aozora.convo.listUnreadCounts",
  "description": "List unread counts for aozora conversations.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "did": { "type": "string" },
        "limit": { "type": "integer" }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": { "type": "ref", "ref": "#unreadView" }
            }
          },
          "required": ["items"]
        }
      }
    },
    "unreadView": {
      "type": "object",
      "properties": {
        "convoId": { "type": "string" },
        "unreadCount": { "type": "integer" },
        "lastMessageAt": { "type": "string" }
      }
    }
  }
}
