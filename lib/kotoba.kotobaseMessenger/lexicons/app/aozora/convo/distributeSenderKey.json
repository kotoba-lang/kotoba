{
  "lexicon": 1,
  "id": "app.aozora.convo.distributeSenderKey",
  "description": "Deliver a group sender-key distribution to one member, over an existing 1:1 Signal session. Not a chat message — a separate collection so it never renders as one.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convoId": { "type": "string" },
            "toDid": { "type": "string" },
            "text": {
              "type": "string",
              "description": "aozora extension: 1:1 Signal-v2-encrypted JSON envelope carrying the sender-key"
            },
            "contentType": { "type": "string" },
            "encryption": { "type": "string" },
            "createdAt": { "type": "string" }
          },
          "required": ["convoId", "toDid", "text"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convoId": { "type": "string" },
            "toDid": { "type": "string" },
            "did": { "type": "string" },
            "uri": { "type": "string", "format": "at-uri" },
            "cid": { "type": "string", "format": "cid" },
            "rkey": { "type": "string" }
          },
          "required": ["convoId", "toDid", "did", "uri", "cid", "rkey"]
        }
      }
    }
  }
}
