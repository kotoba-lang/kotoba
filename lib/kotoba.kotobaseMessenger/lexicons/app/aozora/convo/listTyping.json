{
  "lexicon": 1,
  "id": "app.aozora.convo.listTyping",
  "description": "List the OTHER members of a conversation currently believed to be typing (fresh setTyping heartbeat within the staleness window). Pass did (the caller's own DID) to exclude your own heartbeat from the results — meant to be polled every few seconds while a conversation is open, not held open as a stream.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "convoId": { "type": "string" },
        "did": { "type": "string" }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "typing": {
              "type": "array",
              "items": { "type": "ref", "ref": "#typingView" }
            }
          },
          "required": ["typing"]
        }
      }
    },
    "typingView": {
      "type": "object",
      "properties": {
        "convoId": { "type": "string" },
        "did": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  }
}
