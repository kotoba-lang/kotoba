{
  "lexicon": 1,
  "id": "app.aozora.convo.createConvo",
  "description": "Create a conversation container for aozora messenger.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convoId": { "type": "string" },
            "kind": { "type": "string" },
            "title": { "type": "string" },
            "encryption": {
              "type": "string",
              "description": "aozora extension: conversation encryption mode"
            },
            "members": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convoId": { "type": "string" },
            "uri": { "type": "string", "format": "at-uri" },
            "cid": { "type": "string", "format": "cid" },
            "rkey": { "type": "string" }
          },
          "required": ["convoId", "uri", "cid", "rkey"]
        }
      }
    }
  }
}
