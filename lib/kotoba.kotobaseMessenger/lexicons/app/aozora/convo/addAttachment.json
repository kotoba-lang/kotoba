{
  "lexicon": 1,
  "id": "app.aozora.convo.addAttachment",
  "description": "Attach a record or blob reference to an aozora conversation message.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convoId": { "type": "string" },
            "messageRkey": { "type": "string" },
            "uri": { "type": "string" },
            "cid": { "type": "string" },
            "contentType": { "type": "string" },
            "createdAt": { "type": "string" }
          },
          "required": ["convoId", "messageRkey"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convoId": { "type": "string" },
            "did": { "type": "string" },
            "uri": { "type": "string", "format": "at-uri" },
            "cid": { "type": "string", "format": "cid" },
            "rkey": { "type": "string" }
          },
          "required": ["convoId", "did", "uri", "cid", "rkey"]
        }
      }
    }
  }
}
