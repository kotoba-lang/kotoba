{
  "lexicon": 1,
  "id": "app.aozora.convo.listConvos",
  "description": "List conversations for the current aozora messenger surface.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "convoId": {
          "type": "string"
        },
        "limit": {
          "type": "integer"
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convos": {
              "type": "array",
              "items": { "type": "ref", "ref": "#convoView" }
            }
          },
          "required": ["convos"]
        }
      }
    },
    "convoView": {
      "type": "object",
      "properties": {
        "convoId": { "type": "string" },
        "kind": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string" },
        "creatorDid": { "type": "string" },
        "lastMessageAt": { "type": "string" },
        "lastSeenRkey": { "type": "string" }
      }
    }
  }
}
