{
  "lexicon": 1,
  "id": "app.aozora.convo.listAttachments",
  "description": "List attachments for an aozora conversation message.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "convoId": { "type": "string" },
        "messageRkey": { "type": "string" },
        "did": { "type": "string" },
        "limit": { "type": "integer" }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "attachments": {
              "type": "array",
              "items": { "type": "ref", "ref": "#attachmentView" }
            }
          },
          "required": ["attachments"]
        }
      }
    },
    "attachmentView": {
      "type": "object",
      "properties": {
        "convoId": { "type": "string" },
        "messageRkey": { "type": "string" },
        "did": { "type": "string" },
        "uri": { "type": "string" },
        "cid": { "type": "string" },
        "contentType": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  }
}
