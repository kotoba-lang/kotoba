{
  "lexicon": 1,
  "id": "app.aozora.convo.listReceipts",
  "description": "List read receipts for an aozora conversation.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "convoId": { "type": "string" },
        "did": { "type": "string" },
        "limit": { "type": "integer" }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "receipts": {
              "type": "array",
              "items": { "type": "ref", "ref": "#receiptView" }
            }
          },
          "required": ["receipts"]
        }
      }
    },
    "receiptView": {
      "type": "object",
      "properties": {
        "convoId": { "type": "string" },
        "did": { "type": "string" },
        "lastSeenRkey": { "type": "string" },
        "seenAt": { "type": "string" }
      }
    }
  }
}
