{
  "lexicon": 1,
  "id": "app.aozora.convo.listReactions",
  "description": "List reactions for an aozora conversation message.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "convoId": { "type": "string" },
        "messageRkey": { "type": "string" },
        "did": { "type": "string" },
        "limit": { "type": "integer" }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "reactions": {
              "type": "array",
              "items": { "type": "ref", "ref": "#reactionView" }
            }
          },
          "required": ["reactions"]
        }
      }
    },
    "reactionView": {
      "type": "object",
      "properties": {
        "convoId": { "type": "string" },
        "messageRkey": { "type": "string" },
        "did": { "type": "string" },
        "emoji": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  }
}
