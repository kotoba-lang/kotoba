{
  "lexicon": 1,
  "id": "app.aozora.convo.updateConvo",
  "description": "Rename a conversation (title only, for now). Only the creator may call this — same authorization as addMember/removeMember. Every other field (kind/createdAt/creatorDid/encryption/members) is preserved from the existing record.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convoId": { "type": "string" },
            "title": { "type": "string" }
          },
          "required": ["convoId", "title"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convoId": { "type": "string" },
            "title": { "type": "string" },
            "did": { "type": "string" },
            "uri": { "type": "string", "format": "at-uri" }
          },
          "required": ["convoId", "title", "did", "uri"]
        }
      }
    }
  }
}
