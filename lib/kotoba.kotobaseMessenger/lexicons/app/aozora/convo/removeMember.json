{
  "lexicon": 1,
  "id": "app.aozora.convo.removeMember",
  "description": "Remove a member from an aozora conversation. Removing yourself (did == caller) always succeeds (leave). Removing anyone else requires the caller to be the convo's creator, or the call fails with AuthRequired.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convoId": { "type": "string" },
            "did": { "type": "string" }
          },
          "required": ["convoId"]
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convoId": { "type": "string" },
            "did": { "type": "string" }
          },
          "required": ["convoId", "did"]
        }
      }
    }
  }
}
