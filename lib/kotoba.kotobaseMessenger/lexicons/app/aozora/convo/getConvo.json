{
  "lexicon": 1,
  "id": "app.aozora.convo.getConvo",
  "description": "Fetch one conversation with a page of its message history. messages is always the newest page first when before is omitted; pass before=cursor from a prior response to page backward (older). convo's own lastMessageAt/lastMessage always reflect the true latest message regardless of paging.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "convoId": { "type": "string" },
        "limit": { "type": "integer" },
        "before": { "type": "string", "description": "Cursor: the rkey of the oldest message already loaded client-side. Fetches the next (older) page." }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "convo": { "type": "ref", "ref": "#convoView" },
            "messages": {
              "type": "array",
              "items": { "type": "ref", "ref": "#messageView" }
            },
            "cursor": { "type": "string", "description": "Pass as `before` to fetch the next older page. Absent when there's nothing older left." },
            "hasMore": { "type": "boolean" }
          }
        }
      }
    },
    "convoView": {
      "type": "object",
      "properties": {
        "convoId": { "type": "string" },
        "kind": { "type": "string" },
        "title": { "type": "string" },
        "encryption": { "type": "string" },
        "createdAt": { "type": "string" },
        "creatorDid": { "type": "string" },
        "lastMessageAt": { "type": "string" }
      }
    },
    "messageView": {
      "type": "object",
      "properties": {
        "convoId": { "type": "string" },
        "rkey": { "type": "string" },
        "senderDid": { "type": "string" },
        "text": { "type": "string" },
        "encryption": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  }
}
