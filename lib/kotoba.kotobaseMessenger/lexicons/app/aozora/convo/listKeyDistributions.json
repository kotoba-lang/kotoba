{
  "lexicon": 1,
  "id": "app.aozora.convo.listKeyDistributions",
  "description": "List group sender-key distributions addressed to one member of a conversation.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "convoId": { "type": "string" },
        "toDid": { "type": "string" },
        "limit": { "type": "integer" }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "distributions": {
              "type": "array",
              "items": { "type": "ref", "ref": "#distributionView" }
            }
          },
          "required": ["distributions"]
        }
      }
    },
    "distributionView": {
      "type": "object",
      "properties": {
        "convoId": { "type": "string" },
        "toDid": { "type": "string" },
        "fromDid": { "type": "string" },
        "text": { "type": "string" },
        "contentType": { "type": "string" },
        "encryption": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  }
}
