(ns kotoba.kir.compatibility
  {:kotoba/export [compiler-version descriptor language-version schema tender-role]})

;; Canonical Kotoba compatibility metadata derivation. The .cljk sibling keeps
;; the historical host/oracle branch; native project graphs resolve this file.
(defn- dgk [value :document key :keyword] :document
  (option-value-of [:option :document] (document-get value key) (document-null)))

(defn schema [] :keyword :kotoba.compatibility/v1)
(defn compiler-version [] :string "kotoba-compiler/1")
(defn language-version [] :keyword :kotoba.language/safe-v1)
(defn tender-role [] :keyword :kototama/component-tender-v1)

(defn descriptor [value :document] [:map :keyword :document]
  (let [hir-format (dgk value :hir-format)
        kir-format (dgk value :kir-format)
        target (dgk value :target)
        value-abi (dgk value :value-abi)
        target-profile (dgk value :target-profile)
        runtime (dgk target-profile :runtime)
        execution (dgk target-profile :execution)
        tender-contract
        (if (document-equal? runtime (document-keyword :kotoba-linux-static-prelude-v1))
          (document-keyword :kotoba.linux-static/v1)
          (cond
            (document-equal? execution (document-keyword :javascript)) (document-keyword :kotoba.restricted-esm/v1)
            (document-equal? execution (document-keyword :wasm)) (document-keyword :kotoba.capability-host/v1)
            (document-equal? execution (document-keyword :native)) (document-keyword :kotoba.supervisor/v1)
            (document-equal? execution (document-keyword :process)) (document-keyword :kotoba.aiueos-process/v1)
            (document-equal? execution (document-keyword :kernel)) (document-keyword :kotoba.aiueos-kernel/v1)
            (document-equal? execution (document-keyword :firmware)) (document-keyword :kotoba.aiueos-firmware/v1)
            (document-equal? execution (document-keyword :cljs)) (document-keyword :kotoba.cljs-host/v1)
            :else (document-keyword :kotoba.unsupported/v1)))]
    (typed-map-new [:map :keyword :document]
      :format (document-keyword :kotoba.compatibility/v1)
      :compiler (document-string "kotoba-compiler/1")
      :language (document-keyword :kotoba.language/safe-v1)
      :hir hir-format
      :kir kir-format
      :target target
      :runtime runtime
      :value-abi value-abi
      :tender-role (document-keyword :kototama/component-tender-v1)
      :tender-contract tender-contract)))
