(ns kotoba.kir.interp
  "The KIR reference interpreter of the Kotoba route, first families: a pure
  :i64 / :bool module (integer arithmetic and comparison, bit and shift
  operations, i32 wrapping operations, let / if / do, function calls and the
  frontend's `__kotoba_loop_N` self-tail loops) executed over `kotoba.kir.kvalue`,
  and since then strings, options/results/lists/i64 vectors, bytes, floats,
  documents, the pair heap (pair / pair-first / pair-second and the closure and
  pair-chain refinements of `invoke-function`), records, variants,
  heterogeneous vectors, typed sets of :i64 / :keyword (new and count), f64
  vectors and the text heads string-from-utf8 / -compare-lines / -find-byte /
  -append-range / -find-blank / -skip-blank.

  It answers what the host `kotoba.kir/execute` answers for such a module, and
  refuses (`ported?` is false) every module that uses anything else, so a caller
  falls back to its named refusal instead of a wrong answer. Design and the
  inventory of what is not ported yet: docs/selfhost-kir-interpreter-design.md
  in amu-measure.

  Traps are VALUES (a Kotoba abort cannot be caught): every evaluation answers a
  `:kir.interp/out` record whose kind is 0 value, 1 trap, 2 self-tail call, and
  whose state is the fuel left and the pair heap (the exported `run` / `eval-form`
  answer `:kir.interp/res`, the fuel left in place of the state). Fuel is charged once per function entry (a
  loop-helper self-tail re-entry is free) and once per evaluated constructor form
  (the host's `cell-constructor-ops`), depth is bounded by `frames`, and a
  trap carries the host's full trap name (\"budget/fuel\", \"division-by-zero\",
  ...). Host recursion is bounded: it is at most (frames * expression depth),
  never the number of loop iterations.

  Kotoba-only, like kotoba.kir.kvalue."
  {:kotoba/export [run eval-form ported? form-ported? host-op-name?
                   res-kind res-value res-fuel res-trap res-ok?]}
  (:require [kotoba.form :as form]
            [kotoba.kir.kvalue :as kv])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                       [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
             :kir/v [:record :kir/v [[:tag :i64] [:n :i64] [:s :string] [:k :keyword]
                                     [:b :bytes] [:kids [:list [:ref :kir/v]]]]]
             :kir.interp/st [:record :kir.interp/st [[:fuel :i64] [:heap [:list [:ref :kir/v]]]]]
             :kir.interp/out [:record :kir.interp/out
                              [[:kind :i64] [:v [:ref :kir/v]] [:st [:ref :kir.interp/st]] [:trap :string]]]
             :kir.interp/res [:record :kir.interp/res
                              [[:kind :i64] [:v [:ref :kir/v]] [:fuel :i64] [:trap :string]]]
             :kir.interp/cx [:record :kir.interp/cx
                             [[:fns [:ref :form/r]] [:schemas [:ref :form/r]] [:frames :i64]
                              [:fname :string] [:depth :i64]]]}))

;; ---- results ----

;; The run state threaded through evaluation: fuel left and the pair heap (the
;; host's `{:cells ...}`: pair H is items 2(H-1) and 2(H-1)+1, allocated in
;; evaluation order, so a handle a program observes is the host's handle).
(defn- mk-st [fuel :i64 heap [:list [:ref :kir/v]]] [:ref :kir.interp/st]
  (record-new [:ref :kir.interp/st] fuel heap))

(defn- st-fuel [st [:ref :kir.interp/st]] :i64 (record-get [:ref :kir.interp/st] st :fuel))
(defn- st-heap [st [:ref :kir.interp/st]] [:list [:ref :kir/v]] (record-get [:ref :kir.interp/st] st :heap))

;; One function entry charged.
(defn- st-charge [st [:ref :kir.interp/st]] [:ref :kir.interp/st]
  (mk-st (- (st-fuel st) 1) (st-heap st)))

(defn- mk-res [kind :i64 v [:ref :kir/v] fuel [:ref :kir.interp/st] trap :string] [:ref :kir.interp/out]
  (record-new [:ref :kir.interp/out] kind v fuel trap))

(defn- r-val [v [:ref :kir/v] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (mk-res 0 v fuel ""))

(defn- r-trap [fuel [:ref :kir.interp/st] name :string] [:ref :kir.interp/out]
  (mk-res 1 (kv/nil-value) fuel name))

;; Internal results (:kir.interp/out) carry the run state; the exported result
;; (:kir.interp/res, whose schema kotoba.kir declares too) carries the fuel left.
(defn- o-kind [r [:ref :kir.interp/out]] :i64 (record-get [:ref :kir.interp/out] r :kind))
(defn- o-value [r [:ref :kir.interp/out]] [:ref :kir/v] (record-get [:ref :kir.interp/out] r :v))
(defn- o-st [r [:ref :kir.interp/out]] [:ref :kir.interp/st] (record-get [:ref :kir.interp/out] r :st))
(defn- o-trap [r [:ref :kir.interp/out]] :string (record-get [:ref :kir.interp/out] r :trap))

(defn- public-res [r [:ref :kir.interp/out]] [:ref :kir.interp/res]
  (record-new [:ref :kir.interp/res] (o-kind r) (o-value r) (st-fuel (o-st r)) (o-trap r)))

(defn res-kind [r [:ref :kir.interp/res]] :i64 (record-get [:ref :kir.interp/res] r :kind))
(defn res-value [r [:ref :kir.interp/res]] [:ref :kir/v] (record-get [:ref :kir.interp/res] r :v))
(defn res-fuel [r [:ref :kir.interp/res]] :i64 (record-get [:ref :kir.interp/res] r :fuel))
(defn res-trap [r [:ref :kir.interp/res]] :string (record-get [:ref :kir.interp/res] r :trap))
(defn res-ok? [r [:ref :kir.interp/res]] :bool (= 0 (res-kind r)))
(defn- o-ok? [r [:ref :kir.interp/out]] :bool (= 0 (o-kind r)))

(defn- mk-cx [fns [:ref :form/r] schemas [:ref :form/r] frames :i64 fname :string depth :i64] [:ref :kir.interp/cx]
  (record-new [:ref :kir.interp/cx] fns schemas frames fname depth))

(defn- cx-fns [c [:ref :kir.interp/cx]] [:ref :form/r] (record-get [:ref :kir.interp/cx] c :fns))
(defn- cx-schemas [c [:ref :kir.interp/cx]] [:ref :form/r] (record-get [:ref :kir.interp/cx] c :schemas))
(defn- cx-frames [c [:ref :kir.interp/cx]] :i64 (record-get [:ref :kir.interp/cx] c :frames))
(defn- cx-fname [c [:ref :kir.interp/cx]] :string (record-get [:ref :kir.interp/cx] c :fname))
(defn- cx-depth [c [:ref :kir.interp/cx]] :i64 (record-get [:ref :kir.interp/cx] c :depth))

;; ---- names ----

(defn- kw [k :keyword] [:ref :form/r] (form/keyword-form k))

(defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r] (form/form-get m (kw k)))

(defn- min-i64 [] :i64 (- 0 (+ 9223372036854775807 1)))

;; The operation heads this interpreter implements, as small codes (0 = not one of
;; them). Dispatch is on the first character and then a handful of string
;; compares, not a linear chain: a call to a user function costs one compare per
;; head sharing its first letter. Everything else the host eval-expr dispatches
;; on is `host-op-name?` (generated) and is not ported.
;;   1 +  2 -  3 *  4 quot  5 bit-xor  6 bit-and  7 bit-or  8 min  9 max
;;   10 =  11 <  12 >  13 <=  14 >=            (arith 1-9, compare 10-14)
;;   15 bit-not  16 i64-shift-left  17 i64-shift-right  18 u64-shift-right
;;   19 i32-wrap  20 u32-wrap  21 i32-wrapping-add  22 i32-wrapping-mul  23 i32-xor
;;   24 i32-shift-left  25 i32-shift-right  26 u32-shift-right  27 xorshift32
;;   28 bool-not  29 let  30 if  31 do  32 arena-scope
;;   strings: 40 string-byte-length  41 string-length  42 string-concat  43 string=?
;;   44 string-substring  45 string-code-point-at  46 string-from-i64  47 string-contains?
;;   48 string-index-of  49 string-replace-all  50 string-split-count  51 string-compare
;;   52 string-fold-ascii  53 string-index-of-from
(defn- string-op-code [s :string] :i64
  (cond
    (string=? s "string-byte-length") 40
    (string=? s "string-length") 41
    (string=? s "string-concat") 42
    (string=? s "string=?") 43
    (string=? s "string-substring") 44
    (string=? s "string-code-point-at") 45
    (string=? s "string-from-i64") 46
    (string=? s "string-contains?") 47
    (string=? s "string-index-of") 48
    (string=? s "string-replace-all") 49
    (string=? s "string-split-count") 50
    (string=? s "string-compare") 51
    (string=? s "string-fold-ascii") 52
    (string=? s "string-index-of-from") 53
    (string=? s "string-compare-lines") 54
    (string=? s "string-find-byte") 55
    (string=? s "string-append-range") 56
    (string=? s "string-find-blank") 57
    (string=? s "string-skip-blank") 58
    :else 0))

;;   aggregates (typed ops take a type descriptor as argument 1):
;;   60 option-some-of 61 option-none-of 62 option-some?-of 63 option-value-of 64 option-match
;;   65 result-ok-of 66 result-err-of 67 result-ok?-of 68 result-value-of 69 result-error-of
;;   70 result-match-of 71 typed-list-new 72 typed-list-conj 73 typed-list-nth
;;   74 vector-new 75 vector-count 76 vector-at 77 vector-get 78 vector-drop 79 vector-take
;;   80 vector-alloc 81 vector-assoc 82 vector-assoc! 83 vector-conj
;;   84 option-some 85 option-none 86 option-some? 87 option-value
;;   88 result-ok 89 result-err 90 result-ok? 91 result-value 92 result-error
(defn- option-op-code [s :string] :i64
  (cond
    (string=? s "option-some-of") 60
    (string=? s "option-none-of") 61
    (string=? s "option-some?-of") 62
    (string=? s "option-value-of") 63
    (string=? s "option-match") 64
    (string=? s "option-some") 84
    (string=? s "option-none") 85
    (string=? s "option-some?") 86
    (string=? s "option-value") 87
    :else 0))

(defn- result-op-code [s :string] :i64
  (cond
    (string=? s "result-ok-of") 65
    (string=? s "result-err-of") 66
    (string=? s "result-ok?-of") 67
    (string=? s "result-value-of") 68
    (string=? s "result-error-of") 69
    (string=? s "result-match-of") 70
    (string=? s "result-ok") 88
    (string=? s "result-err") 89
    (string=? s "result-ok?") 90
    (string=? s "result-value") 91
    (string=? s "result-error") 92
    (string=? s "record-new") 310
    (string=? s "record-get") 311
    :else 0))

(defn- vector-op-code [s :string] :i64
  (cond
    (string=? s "vector-new") 74
    (string=? s "vector-count") 75
    (string=? s "vector-at") 76
    (string=? s "vector-get") 77
    (string=? s "vector-drop") 78
    (string=? s "vector-take") 79
    (string=? s "vector-alloc") 80
    (string=? s "vector-assoc") 81
    (string=? s "vector-assoc!") 82
    (string=? s "vector-conj") 83
    (string=? s "vector-i64-from-bytes") 106
    (string=? s "variant-new") 312
    (string=? s "variant-match") 313
    (string=? s "vector-f64-new") 320
    (string=? s "vector-f64-count") 321
    (string=? s "vector-f64-get") 322
    (string=? s "vector-f64-at") 323
    (string=? s "vector-f64-drop") 324
    (string=? s "vector-f64-take") 325
    (string=? s "vector-f64-assoc") 326
    (string=? s "vector-f64-conj") 327
    :else 0))

(defn- list-op-code [s :string] :i64
  (cond
    (string=? s "typed-list-new") 71
    (string=? s "typed-list-conj") 72
    (string=? s "typed-list-nth") 73
    (string=? s "typed-set-new") 316
    (string=? s "typed-set-count") 317
    :else 0))

(defn- bytes-op-code [s :string] :i64
  (cond
    (string=? s "bytes-empty") 100
    (string=? s "bytes-count") 101
    (string=? s "bytes-at") 102
    (string=? s "bytes-slice") 103
    (string=? s "bytes-concat") 104
    (string=? s "bytes-from-vector-i64") 105
    :else 0))

;;   300 pair 301 pair-first 302 pair-second (the pair heap)
;;   310 record-new 311 record-get 312 variant-new 313 variant-match
;;   314 hetero-vector-new 315 hetero-vector-at 316 typed-set-new 317 typed-set-count
;;   318 hetero-vector-assoc
;;   320-327 vector-f64-{new count get at drop take assoc conj}
;;   107 string-from-utf8 (a :bytes operand)
(defn- pair-op-code [s :string] :i64
  (cond
    (string=? s "pair") 300
    (string=? s "pair-first") 301
    (string=? s "pair-second") 302
    :else 0))

(defn- hetero-op-code [s :string] :i64
  (cond
    (string=? s "hetero-vector-new") 314
    (string=? s "hetero-vector-at") 315
    (string=? s "hetero-vector-assoc") 318
    :else 0))

(defn- float-op-code [s :string] :i64
  (cond
    (string=? s "f64-from-bits") 120
    (string=? s "f64-to-bits") 121
    (string=? s "f64-add") 122
    (string=? s "f64-sub") 123
    (string=? s "f64-mul") 124
    (string=? s "f64-div") 125
    (string=? s "f64-min") 126
    (string=? s "f64-max") 127
    (string=? s "f64-neg") 128
    (string=? s "f64-abs") 129
    (string=? s "f64-sqrt") 130
    (string=? s "f64-eq") 131
    (string=? s "f64-lt") 132
    (string=? s "f64-le") 133
    (string=? s "f64-gt") 134
    (string=? s "f64-ge") 135
    (string=? s "f64-unordered") 136
    (string=? s "f32-from-bits") 140
    (string=? s "f32-to-bits") 141
    (string=? s "f32-add") 142
    (string=? s "f32-sub") 143
    (string=? s "f32-mul") 144
    (string=? s "f32-div") 145
    (string=? s "f32-min") 146
    (string=? s "f32-max") 147
    (string=? s "f32-neg") 148
    (string=? s "f32-abs") 149
    (string=? s "f32-sqrt") 150
    (string=? s "f32-eq") 151
    (string=? s "f32-lt") 152
    (string=? s "f32-le") 153
    (string=? s "f32-gt") 154
    (string=? s "f32-ge") 155
    (string=? s "f32-unordered") 156
    (string=? s "i64-to-f64-checked") 160
    (string=? s "i64-to-f64-rounded") 161
    (string=? s "f64-to-i64-checked") 162
    (string=? s "f64-to-i64-truncating") 163
    (string=? s "f64-to-f32-rounded") 164
    (string=? s "f32-to-f64-exact") 165
    (string=? s "i64-to-f32-checked") 166
    (string=? s "i64-to-f32-rounded") 167
    (string=? s "f32-to-i64-checked") 168
    (string=? s "f32-to-i64-truncating") 169
    :else 0))

(defn- document-op-code [s :string] :i64
  (cond
    (string=? s "document-null") 200
    (string=? s "document-bool") 201
    (string=? s "document-i64") 202
    (string=? s "document-f64") 203
    (string=? s "document-string") 204
    (string=? s "document-keyword") 205
    (string=? s "document-vector") 206
    (string=? s "document-list") 207
    (string=? s "document-map") 208
    (string=? s "document-count") 209
    (string=? s "document-kind") 210
    (string=? s "document-vector-at") 211
    (string=? s "document-list-at") 212
    (string=? s "document-vector-assoc") 213
    (string=? s "document-vector-conj") 214
    (string=? s "document-vector-drop") 215
    (string=? s "document-vector-remove") 216
    (string=? s "document-map-entry-at") 217
    (string=? s "document-equal?") 218
    (string=? s "document-contains") 219
    (string=? s "document-get") 220
    (string=? s "document-assoc") 221
    (string=? s "document-dissoc") 222
    (string=? s "document-merge") 223
    (string=? s "document-string-value") 224
    (string=? s "document-keyword-value") 225
    (string=? s "document-bool-value") 226
    (string=? s "document-i64-value") 227
    (string=? s "document-f64-value") 228
    :else 0))

(defn- op-code [s :string] :i64
  (let [c (string-code-point-at s 0)
        n (string-byte-length s)]
    (cond
      (= c 43) (if (= n 1) 1 0)
      (= c 45) (if (= n 1) 2 0)
      (= c 42) (if (= n 1) 3 0)
      (= c 61) (if (= n 1) 10 0)
      (= c 60) (if (= n 1) 11 (if (string=? s "<=") 13 0))
      (= c 62) (if (= n 1) 12 (if (string=? s ">=") 14 0))
      (= c 113) (if (string=? s "quot") 4 0)
      (= c 108) (if (string=? s "let") 29 0)
      (= c 97) (if (string=? s "arena-scope") 32 0)
      (= c 109) (cond (string=? s "min") 8 (string=? s "max") 9 :else 0)
      (= c 120) (if (string=? s "xorshift32") 27 0)
      (= c 115) (if (string=? s "string-from-utf8") 107 (string-op-code s))
      (= c 112) (pair-op-code s)
      (= c 104) (hetero-op-code s)
      (= c 111) (option-op-code s)
      (= c 114) (result-op-code s)
      (= c 118) (vector-op-code s)
      (= c 116) (list-op-code s)
      (= c 98) (cond (string=? s "bit-xor") 5 (and (> n 1) (= (string-code-point-at s 1) 121)) (bytes-op-code s) (string=? s "bit-and") 6 (string=? s "bit-or") 7
                     (string=? s "bit-not") 15 (string=? s "bool-not") 28 :else 0)
      (= c 117) (cond (string=? s "u64-shift-right") 18 (string=? s "u32-wrap") 20
                      (string=? s "u32-shift-right") 26 :else 0)
      (= c 105) (cond (string=? s "if") 30 (string=? s "i64-shift-left") 16 (string=? s "i64-shift-right") 17
                      (string=? s "i32-wrap") 19 (string=? s "i32-wrapping-add") 21
                      (string=? s "i32-wrapping-mul") 22 (string=? s "i32-xor") 23
                      (string=? s "i32-shift-left") 24 (string=? s "i32-shift-right") 25
                      (and (> n 8) (= (string-code-point-at s 4) 116)) (float-op-code s) :else 0)
      (= c 100) (cond (string=? s "do") 31 (and (> n 9) (= (string-code-point-at s 7) 116)) (document-op-code s) :else 0)
      (= c 102) (if (and (> n 4) (= (string-code-point-at s 3) 45)) (float-op-code s) 0)
      :else 0)))

(defn- ported-op? [s :string] :bool (> (op-code s) 0))

;; GENERATED by tools/gen_host_ops.py -- do not edit by hand
(defn- host-op-group-0? [s :string] :bool
  (or (string=? s "*") (string=? s "+") (string=? s "-") (string=? s "<") (string=? s "<=") (string=? s "=") (string=? s ">") (string=? s ">=") (string=? s "arena-scope") (string=? s "bit-and") (string=? s "bit-not") (string=? s "bit-or") (string=? s "bit-xor") (string=? s "bool-not") (string=? s "bytes-at") (string=? s "bytes-concat")))

(defn- host-op-group-1? [s :string] :bool
  (or (string=? s "bytes-count") (string=? s "bytes-empty") (string=? s "bytes-from-vector-i64") (string=? s "bytes-literal") (string=? s "bytes-literal-length") (string=? s "bytes-slice") (string=? s "bytes-task-byte-count") (string=? s "cap-call") (string=? s "decimal-f64-parse") (string=? s "decimal-f64x3-parse") (string=? s "disjoint-set-i64-count") (string=? s "disjoint-set-i64-new") (string=? s "disjoint-set-i64-union") (string=? s "do") (string=? s "document-assoc") (string=? s "document-bool")))

(defn- host-op-group-2? [s :string] :bool
  (or (string=? s "document-bool-value") (string=? s "document-bytes") (string=? s "document-bytes-value") (string=? s "document-contains") (string=? s "document-count") (string=? s "document-dissoc") (string=? s "document-edn-print") (string=? s "document-edn-read") (string=? s "document-equal?") (string=? s "document-f64") (string=? s "document-f64-value") (string=? s "document-get") (string=? s "document-i64") (string=? s "document-i64-value") (string=? s "document-keyword") (string=? s "document-keyword-value")))

(defn- host-op-group-3? [s :string] :bool
  (or (string=? s "document-kind") (string=? s "document-link") (string=? s "document-link-value") (string=? s "document-list") (string=? s "document-list-at") (string=? s "document-map") (string=? s "document-map-entry-at") (string=? s "document-merge") (string=? s "document-null") (string=? s "document-print") (string=? s "document-read") (string=? s "document-set") (string=? s "document-set-contains?") (string=? s "document-sha256") (string=? s "document-string") (string=? s "document-string-value")))

(defn- host-op-group-4? [s :string] :bool
  (or (string=? s "document-symbol") (string=? s "document-symbol-value") (string=? s "document-vector") (string=? s "document-vector-assoc") (string=? s "document-vector-at") (string=? s "document-vector-conj") (string=? s "document-vector-drop") (string=? s "document-vector-remove") (string=? s "document-vector-sort") (string=? s "f32-abs") (string=? s "f32-add") (string=? s "f32-div") (string=? s "f32-eq") (string=? s "f32-from-bits") (string=? s "f32-ge") (string=? s "f32-gt")))

(defn- host-op-group-5? [s :string] :bool
