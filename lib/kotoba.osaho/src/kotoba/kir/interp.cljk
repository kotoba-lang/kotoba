;; END GENERATED

;; ---- function table ----

(defn- find-fn-from [fns [:list [:ref :form/r]] name :string i :i64] :i64
  (let [n (vector-count fns)]
    (loop [j i]
      (if (>= j n) -1
        (if (string=? (form/symbol-value (fget (typed-list-nth [:list [:ref :form/r]] fns j) :name)) name)
          j
          (recur (inc j)))))))

(defn- find-fn [fns [:ref :form/r] name :string] :i64
  (find-fn-from (form/kids-of fns) name 0))

;; ---- environment: alternating name (a string value) and value ----

(defn- env-index [env [:list [:ref :kir/v]] name :string] :i64
  (loop [j (- (vector-count env) 2)]
    (if (< j 0) -1
      (if (string=? (kv/s-of (typed-list-nth [:list [:ref :kir/v]] env j)) name)
        j
        (recur (- j 2))))))

(defn- env-bind [env [:list [:ref :kir/v]] name :string v [:ref :kir/v]] [:list [:ref :kir/v]]
  (kv/append-value (kv/append-value env (kv/string-value name)) v))

;; ---- truth, types ----

;; The host's single truth convention: a boolean is false when false, a word is
;; false when zero (`kotoba-false?`). Only these two shapes exist in this subset.
(defn- false-value? [v [:ref :kir/v]] :bool
  (= 0 (kv/n-of v)))

(defn- i64? [v [:ref :kir/v]] :bool (= 2 (kv/tag-of v)))

(defn- bool-word-true? [v [:ref :kir/v]] :bool (not (= 0 (kv/n-of v))))

(defn- doc? [v [:ref :kir/v]] :bool (and (= 13 (kv/tag-of v)) (= (kv/k-of v) :document)))

(defn- bool-word? [v [:ref :kir/v]] :bool
  (or (= 1 (kv/tag-of v))
      (and (= 2 (kv/tag-of v)) (or (= 0 (kv/n-of v)) (= 1 (kv/n-of v))))))

;; A declared type descriptor (a Form). Only the tag is checked, as the host's
;; `operand-tag?` does for a value inside a typed program.
(defn- desc-head [ty [:ref :form/r]] :keyword
  (if (and (form/is-vec? ty) (> (form/count-of ty) 0) (form/is-keyword? (form/nth-of ty 0)))
    (form/keyword-value (form/nth-of ty 0))
    :none))

(defn- type-ok? [ty [:ref :form/r] v [:ref :kir/v]] :bool
  (if (form/is-keyword? ty)
    (let [k (form/keyword-value ty)]
      (cond
        (= k :bool) (bool-word? v)
        (= k :string) (= 4 (kv/tag-of v))
        (= k :bytes) (= 7 (kv/tag-of v))
        (= k :keyword) (= 5 (kv/tag-of v))
        (= k :document) (doc? v)
        (or (= k :f64) (= k :f32)) (= 3 (kv/tag-of v))
        (= k :vector-i64) (= 9 (kv/tag-of v))
        (= k :vector-f64) (= 9 (kv/tag-of v))
        (= k :option-i64) (= 14 (kv/tag-of v))
        (= k :result-i64) (= 15 (kv/tag-of v))
        :else (i64? v)))
    (let [h (desc-head ty)]
      (cond
        (= h :option) (= 14 (kv/tag-of v))
        (= h :result) (= 15 (kv/tag-of v))
        (= h :list) (= 8 (kv/tag-of v))
        :else (typed-tag-ok? ty v)))))

;; ---- typed aggregates: records, variants, heterogeneous vectors, typed sets ----
;; The host value is a vector whose slot 0 is the full type descriptor
;; ([type f1 .. fn], [type tag payload], [type x1 .. xn], [type items]). Here it is
;; a variant Value marked k = :typed, s the kind ("record" "variant" "hvec" "set"),
;; kids the descriptor (as a Value, `kv/from-form`) and then the host vector's
;; remaining slots, so `kv/value-eq` is the host's `=` on the vector.

(defn- typed-v [kind :string ty [:ref :form/r] items [:list [:ref :kir/v]]] [:ref :kir/v]
  (record-new [:ref :kir/v] 13 0 kind :typed (bytes-empty)
              (concat-values (kv/one-value (kv/from-form ty)) items)))

(defn- typed? [v [:ref :kir/v]] :bool (and (= 13 (kv/tag-of v)) (= (kv/k-of v) :typed)))

(defn- typed-desc [v [:ref :kir/v]] [:ref :kir/v] (kv/nth-of v 0))

;; the host vector's slots after the descriptor
(defn- typed-items [v [:ref :kir/v]] [:list [:ref :kir/v]]
  (slice-values (kv/kids-of v) 1 (kv/count-of v)))

;; A descriptor Form against a descriptor Value: the host's `=` on the two.
(defn- desc-eq? [ty [:ref :form/r] dv [:ref :kir/v]] :bool
  (let [t (form/tag-of ty)]
    (cond
      (= t 4) (and (= 5 (kv/tag-of dv)) (= (form/keyword-value ty) (kv/k-of dv)))
      (= t 7)
      (and (= 9 (kv/tag-of dv))
           (= (form/count-of ty) (kv/count-of dv))
           (loop [i 0]
             (if (>= i (form/count-of ty)) true
               (if (desc-eq? (form/nth-of ty i) (kv/nth-of dv i)) (recur (inc i)) false))))
      :else (kv/value-eq (kv/from-form ty) dv))))

;; `operand-tag?` for a vector descriptor the aggregates below build: the value
;; carries this exact descriptor; a `[:ref S]` only names its nominal type.
(defn- typed-tag-ok? [ty [:ref :form/r] v [:ref :kir/v]] :bool
  (let [h (desc-head ty)]
    (cond
      (not (typed? v)) false
      (= h :ref)
      (let [d (typed-desc v)]
        (and (= 9 (kv/tag-of d)) (>= (kv/count-of d) 2)
             (or (= (kv/k-of (kv/nth-of d 0)) :record) (= (kv/k-of (kv/nth-of d 0)) :variant))
             (= (kv/k-of (kv/nth-of d 1)) (form/keyword-value (form/nth-of ty 1)))))
      (or (= h :record) (or (= h :variant) (or (= h :vector) (= h :set)))) (desc-eq? ty (typed-desc v))
      :else false)))

;; A host vector: every aggregate the host builds is one.
(defn- host-vector? [v [:ref :kir/v]] :bool
  (let [t (kv/tag-of v)] (or (= t 8) (or (= t 9) (or (= t 13) (or (= t 14) (= t 15)))))))

;; `operand-tag?` exactly where the leaf tags are concerned (a :bool operand is a
;; boolean, not a 0/1 word): the constructor check of the aggregates below.
(defn- operand-ok? [ty [:ref :form/r] v [:ref :kir/v]] :bool
  (if (form/is-keyword? ty)
    (let [k (form/keyword-value ty)]
      (cond
        (= k :i64) (i64? v)
        (= k :bool) (= 1 (kv/tag-of v))
        (or (= k :f64) (= k :f32)) (= 3 (kv/tag-of v))
        (= k :string) (= 4 (kv/tag-of v))
        (= k :keyword) (= 5 (kv/tag-of v))
        (= k :bytes) (= 7 (kv/tag-of v))
        (or (= k :vector-i64) (or (= k :vector-f64) (or (= k :option-i64) (or (= k :result-i64) (= k :document)))))
        (host-vector? v)
        :else false))
    (type-ok? ty v)))

(defn- all-operands-ok? [tys [:ref :form/r] xs [:list [:ref :kir/v]]] :bool
  (and (= (form/count-of tys) (vector-count xs))
       (loop [i 0]
         (if (>= i (vector-count xs)) true
           (if (operand-ok? (form/nth-of tys i) (typed-list-nth [:list [:ref :kir/v]] xs i)) (recur (inc i)) false)))))

;; [:record N [[f T] ..]] field types, as a Form vector of the Ts
(defn- field-types [ty [:ref :form/r]] [:ref :form/r]
  (let [fs (form/nth-of ty 2)]
    (form/form-vec
     (loop [i 0 acc (form/no-forms)]
       (if (>= i (form/count-of fs)) acc
         (recur (inc i) (form/append-form acc (form/nth-of (form/nth-of fs i) 1))))))))

;; index of the entry of FIELDS ([[k T] ..]) keyed K, or -1
(defn- entry-index [fs [:ref :form/r] k [:ref :form/r]] :i64
  (loop [i 0]
    (cond
      (>= i (form/count-of fs)) -1
      (form/eq (form/nth-of (form/nth-of fs i) 0) k) i
      :else (recur (inc i)))))

;; `shallow-typed-value!` of a value that must already carry descriptor TY
;; (record, heterogeneous vector, typed set): the node, then its operands.
(defn- typed-node-ok? [ty [:ref :form/r] v [:ref :kir/v]] :bool
  (let [h (desc-head ty)]
    (and (typed? v)
         (desc-eq? ty (typed-desc v))
         (cond
           (= h :record) (all-operands-ok? (field-types ty) (typed-items v))
           (= h :vector) (all-operands-ok? (form/nth-of ty 1) (typed-items v))
           (= h :set) (and (<= (- (kv/count-of v) 1) (set-limit))
                           (all-same-operand-ok? (form/nth-of ty 1) (typed-items v)))
           (= h :variant)
           (let [at (entry-index (form/nth-of ty 2) (kw-form-of (kv/nth-of v 1)))]
             (and (= 3 (kv/count-of v)) (= 5 (kv/tag-of (kv/nth-of v 1))) (>= at 0)
                  (operand-ok? (form/nth-of (form/nth-of (form/nth-of ty 2) at) 1) (kv/nth-of v 2))))
           :else false))))

(defn- kw-form-of [v [:ref :kir/v]] [:ref :form/r]
  (if (= 5 (kv/tag-of v)) (form/keyword-form (kv/k-of v)) (form/nil-form)))

(defn- all-same-operand-ok? [ty [:ref :form/r] xs [:list [:ref :kir/v]]] :bool
  (loop [i 0]
    (if (>= i (vector-count xs)) true
      (if (operand-ok? ty (typed-list-nth [:list [:ref :kir/v]] xs i)) (recur (inc i)) false))))

(defn- set-limit [] :i64 32)  ; kotoba.kir.value/typed-set-item-limit

;; ---- evaluation ----

;; An operand may not be a self-tail call marker: it is only valid as the whole
;; result of a function body (`lower` rejects the off-tail source forms).
(defn- ev-operand [form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [r (ev form env cx fuel)]
    (if (= 2 (o-kind r)) (r-trap (o-st r) "trampoline-off-tail") r)))

;; Arguments 1.. of a call form, left to right, as a vector value in a result.
(defn- ev-args-range [form [:ref :form/r] from :i64 to :i64 env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (loop [i from acc (kv/no-values) fu fuel]
    (if (>= i to)
      (r-val (kv/vector-value acc) fu)
      (let [r (ev-operand (form/nth-of form i) env cx fu)]
        (if (= 0 (o-kind r))
          (recur (inc i) (kv/append-value acc (o-value r)) (o-st r))
          r)))))

(defn- ev-args [form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (ev-args-range form 1 (form/count-of form) env cx fuel))

(defn- ev-let-from [bs [:ref :form/r] i :i64 env [:list [:ref :kir/v]] body [:ref :form/r]
                    cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (if (>= (+ i 1) (form/count-of bs))
    (ev body env cx fuel)
    (let [name (form/symbol-value (form/nth-of bs i))
          r (ev-operand (form/nth-of bs (+ i 1)) env cx fuel)]
      (if (= 0 (o-kind r))
        (ev-let-from bs (+ i 2) (env-bind env name (o-value r)) body cx (o-st r))
        r))))

(defn- ev-do-from [form [:ref :form/r] i :i64 env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (if (>= i (- (form/count-of form) 1))
    (ev (form/nth-of form i) env cx fuel)
    (let [r (ev-operand (form/nth-of form i) env cx fuel)]
      (if (= 0 (o-kind r))
        (ev-do-from form (inc i) env cx (o-st r))
        r))))

;; ---- integer operations over the evaluated arguments ----

(defn- all-i64-from? [xs [:list [:ref :kir/v]] i :i64] :bool
  (loop [j i]
    (if (>= j (vector-count xs)) true
      (if (i64? (typed-list-nth [:list [:ref :kir/v]] xs j)) (recur (inc j)) false))))

(defn- arg-n [xs [:list [:ref :kir/v]] i :i64] :i64
  (kv/n-of (typed-list-nth [:list [:ref :kir/v]] xs i)))

;; 1 + 2 - 3 * 5 xor 6 and 7 or 8 min 9 max
(defn- fold-arith [op :i64 xs [:list [:ref :kir/v]]] :i64
  (let [n (vector-count xs)]
    (loop [i 1 acc (arg-n xs 0)]
      (if (>= i n) acc
        (let [y (arg-n xs i)]
          (recur (inc i)
                 (cond
                   (= op 1) (+ acc y)
                   (= op 2) (- acc y)
                   (= op 3) (* acc y)
                   (= op 5) (bit-xor acc y)
                   (= op 6) (bit-and acc y)
                   (= op 7) (bit-or acc y)
                   (= op 8) (if (<= acc y) acc y)
                   :else (if (>= acc y) acc y))))))))

(defn- ev-arith [op :i64 xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [n (vector-count xs)]
    (cond
      (= n 0) (r-trap fuel "arity-mismatch")
      (not (all-i64-from? xs 0)) (r-trap fuel "value-type-mismatch")
      (= op 4)
      (if (not (= n 2)) (r-trap fuel "arity-mismatch")
        (let [x (arg-n xs 0)
              y (arg-n xs 1)]
          (cond
            (= y 0) (r-trap fuel "division-by-zero")
            (and (= x (min-i64)) (= y -1)) (r-trap fuel "signed-division-overflow")
            :else (r-val (kv/i64-value (quot x y)) fuel))))
      (and (= op 2) (= n 1))
      (r-val (kv/i64-value (- 0 (arg-n xs 0))) fuel)
      (and (or (= op 5) (or (= op 6) (= op 7))) (= n 1))
      (r-trap fuel "arity-mismatch")
      :else (r-val (kv/i64-value (fold-arith op xs)) fuel))))

;; 10 = 11 < 12 > 13 <= 14 >=
(defn- cmp-pair [op :i64 a [:ref :kir/v] b [:ref :kir/v]] :bool
  (cond
    (= op 10) (kv/value-eq a b)
    (= op 11) (< (kv/n-of a) (kv/n-of b))
    (= op 12) (> (kv/n-of a) (kv/n-of b))
    (= op 13) (<= (kv/n-of a) (kv/n-of b))
    :else (>= (kv/n-of a) (kv/n-of b))))

(defn- cmp-chain [op :i64 xs [:list [:ref :kir/v]]] :bool
  (let [n (vector-count xs)]
    (loop [i 0]
      (if (>= (+ i 1) n) true
        (if (cmp-pair op (typed-list-nth [:list [:ref :kir/v]] xs i) (typed-list-nth [:list [:ref :kir/v]] xs (+ i 1)))
          (recur (inc i))
          false)))))

(defn- ev-compare [op :i64 xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (cond
    (= (vector-count xs) 0) (r-trap fuel "arity-mismatch")
    (and (not (= op 10)) (not (all-i64-from? xs 0))) (r-trap fuel "value-type-mismatch")
    :else (r-val (kv/i64-value (if (cmp-chain op xs) 1 0)) fuel)))

;; 32-bit wrapping, spelled on i64 words.
(defn- wrap32 [x :i64] :i64
  (i64-shift-right (i64-shift-left x 32) 32))

(defn- uwrap32 [x :i64] :i64
  (bit-and x 4294967295))

(defn- shift-in? [c :i64 limit :i64] :bool
  (and (>= c 0) (<= c limit)))

(defn- xorshift32-of [v :i64] :i64
  (let [x0 (uwrap32 v)
        x1 (uwrap32 (bit-xor x0 (i64-shift-left x0 13)))
        x2 (uwrap32 (bit-xor x1 (i64-shift-right x1 17)))]
    (uwrap32 (bit-xor x2 (i64-shift-left x2 5)))))

;; 15-27: bit-not, the i64 shifts, the i32 family
(defn- ev-unary-or-shift [op :i64 xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [n (vector-count xs)
        want (if (or (= op 15) (or (= op 19) (or (= op 20) (= op 27)))) 1 2)]
    (cond
      (not (= n want)) (r-trap fuel "arity-mismatch")
      (not (all-i64-from? xs 0)) (r-trap fuel "value-type-mismatch")
      :else
      (let [x (arg-n xs 0)
            c (if (= want 2) (arg-n xs 1) 0)]
        (cond
          (= op 15) (r-val (kv/i64-value (bit-xor x -1)) fuel)
          (= op 19) (r-val (kv/i64-value (wrap32 x)) fuel)
          (= op 20) (r-val (kv/i64-value (uwrap32 x)) fuel)
          (= op 27) (r-val (kv/i64-value (xorshift32-of x)) fuel)
          (= op 21) (r-val (kv/i64-value (wrap32 (+ x c))) fuel)
          (= op 22) (r-val (kv/i64-value (wrap32 (* x c))) fuel)
          (= op 23) (r-val (kv/i64-value (wrap32 (bit-xor x c))) fuel)
          (and (>= op 24) (<= op 26))
          (if (not (shift-in? c 31)) (r-trap fuel "i32-shift-count-out-of-range")
            (cond
              (= op 24) (r-val (kv/i64-value (wrap32 (i64-shift-left (wrap32 x) c))) fuel)
              (= op 25) (r-val (kv/i64-value (i64-shift-right (wrap32 x) c)) fuel)
              :else (r-val (kv/i64-value (i64-shift-right (uwrap32 x) c)) fuel)))
          :else
          (if (not (shift-in? c 63)) (r-trap fuel "i64-shift-count-out-of-range")
            (cond
              (= op 16) (r-val (kv/i64-value (i64-shift-left x c)) fuel)
              (= op 17) (r-val (kv/i64-value (i64-shift-right x c)) fuel)
              :else (r-val (kv/i64-value (u64-shift-right x c)) fuel))))))))

;; ---- strings ----
;; Strings are UTF-8 on the Kotoba route as on the host contract (offsets are byte
;; offsets). A Kotoba builtin ABORTS on a bad offset, so every precondition the
;; host checks is checked here first and answered as a trap VALUE.

(defn- str-limit [] :i64 8388608)  ; kotoba.kir.value/string-value-byte-limit (amu ADR 0362)

(defn- str-arg [xs [:list [:ref :kir/v]] i :i64] :string
  (kv/s-of (typed-list-nth [:list [:ref :kir/v]] xs i)))

(defn- op-sig [op :i64] :string
  (cond
    (or (= op 40) (or (= op 41) (= op 52))) "s"
    (= op 46) "i"
    (or (= op 42) (or (= op 43) (or (= op 47) (or (= op 48) (or (= op 50) (= op 51)))))) "ss"
    (= op 49) "sss"
    (or (= op 44) (= op 55)) "sii"
    (or (= op 45) (or (= op 57) (= op 58))) "si"
    (= op 54) "sisi"
    (= op 56) "ssii"
    :else "ssi"))

(defn- sig-ok? [sig :string xs [:list [:ref :kir/v]]] :bool
  (loop [j 0]
    (if (>= j (string-byte-length sig)) true
      (let [want (if (= (string-code-point-at sig j) 115) 4 2)]
        (if (= want (kv/tag-of (typed-list-nth [:list [:ref :kir/v]] xs j))) (recur (inc j)) false)))))

(defn- cp-width [cp :i64] :i64
  (cond (< cp 128) 1 (< cp 2048) 2 (< cp 65536) 3 :else 4))

;; OFF in [0, byte-length]: is it the start of a code point (or the end)?
(defn- utf8-boundary? [s :string off :i64] :bool
  (let [n (string-byte-length s)]
    (loop [i 0]
      (cond
        (= i off) true
        (> i off) false
        (>= i n) false
        :else (recur (+ i (cp-width (string-code-point-at s i))))))))

;; string-split-count over string-index-of-from (non-overlapping, as kotoba.kir's
;; evaluator counts): the seed's source route has no string-split-count. SEP non-empty.
(defn- split-count [s :string sep :string] :i64
  (let [m (string-byte-length sep)]
    (loop [from 0 k 1]
      (let [p (string-index-of-from s sep from)]
        (if (< p 0) k (recur (+ p m) (+ k 1)))))))

;; string-replace-all over string-index-of-from + string-append-range (left to right,
;; non-overlapping): the seed's source route has no string-replace-all. NEEDLE non-empty.
(defn- replace-all [s :string needle :string rep :string] :string
  (let [m (string-byte-length needle)
        n (string-byte-length s)]
    (loop [from 0 acc ""]
      (let [p (string-index-of-from s needle from)]
        (if (< p 0)
          (string-append-range acc s from n)
          (recur (+ p m) (string-concat (string-append-range acc s from p) rep)))))))

(defn- count-str [s :string needle :string] :i64
  (- (split-count s needle) 1))

(defn- str-val [s :string fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (r-val (kv/string-value s) fuel))

(defn- int-val [n :i64 fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (r-val (kv/i64-value n) fuel))

(defn- i64->str [n :i64] :string (string-from-i64 n))

(defn- ev-string-concat [a :string b :string fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (if (> (+ (string-byte-length a) (string-byte-length b)) (str-limit))
    (r-trap fuel "string-too-large")
    (str-val (string-concat a b) fuel)))

(defn- ev-substring [s :string start :i64 end :i64 fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [n (string-byte-length s)]
    (cond
      (or (< start 0) (or (> start end) (> end n))) (r-trap fuel "string-index-out-of-bounds")
      (not (and (utf8-boundary? s start) (utf8-boundary? s end))) (r-trap fuel "string-splits-code-point")
      :else (str-val (string-substring s start end) fuel))))

(defn- ev-code-point-at [s :string off :i64 fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (cond
    (or (< off 0) (>= off (string-byte-length s))) (r-trap fuel "string-index-out-of-bounds")
    (not (utf8-boundary? s off)) (r-trap fuel "string-splits-code-point")
    :else (int-val (string-code-point-at s off) fuel)))

(defn- ev-replace-all [s :string needle :string rep :string fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (if (= 0 (string-byte-length needle))
    (r-trap fuel "empty-string-replacement-needle")
    (let [total (+ (string-byte-length s)
                   (* (count-str s needle) (- (string-byte-length rep) (string-byte-length needle))))]
      (if (> total (str-limit))
        (r-trap fuel "string-too-large")
        (str-val (replace-all s needle rep) fuel)))))

(defn- ev-index-of-from [h :string needle :string from :i64 fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (cond
    (= 0 (string-byte-length needle)) (r-trap fuel "empty-string-search-needle")
    (or (< from 0) (> from (string-byte-length h))) (r-trap fuel "string-index-out-of-bounds")
    (not (utf8-boundary? h from)) (r-trap fuel "string-splits-code-point")
    :else (int-val (string-index-of-from h needle from) fuel)))

;; FROM a code-point boundary in [0, byte-length]: "" or the trap (the host's
;; `unit-index-of-byte-offset!` / `utf8-scan-blank!` preconditions).
(defn- offset-trap [s :string from :i64] :string
  (cond
    (or (< from 0) (> from (string-byte-length s))) "string-index-out-of-bounds"
    (not (utf8-boundary? s from)) "string-splits-code-point"
    :else ""))

(defn- blank-cp? [c :i64] :bool
  (or (= c 32) (or (= c 9) (or (= c 10) (or (= c 11) (or (= c 12) (= c 13)))))))

;; string-find-blank (WANT true: first blank at/after FROM, or -1) and
;; string-skip-blank (WANT false: first non-blank, or the byte length).
(defn- ev-scan-blank [s :string from :i64 want :bool fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [t (offset-trap s from)
        n (string-byte-length s)]
    (if (not (string=? t ""))
      (r-trap fuel t)
      (int-val (loop [i from]
                 (if (>= i n)
                   (if want -1 n)
                   (let [c (string-code-point-at s i)]
                     (if (= want (blank-cp? c)) i (recur (+ i (cp-width c)))))))
               fuel))))

;; the end of the line starting at byte offset I: the first newline at or after I, or the end
(defn- line-end [s :string i :i64] :i64
  (let [p (if (>= i (string-byte-length s)) -1 (string-index-of-from s "\n" i))]
    (if (< p 0) (string-byte-length s) p)))

(defn- ev-compare-lines [a :string i :i64 b :string j :i64 fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [ta (offset-trap a i)
        tb (offset-trap b j)]
    (cond
      (not (string=? ta "")) (r-trap fuel ta)
      (not (string=? tb "")) (r-trap fuel tb)
      :else (int-val (string-compare (string-substring a i (line-end a i))
                                     (string-substring b j (line-end b j)))
                     fuel))))

;; string-find-byte: B an ASCII byte, so a match is a code point equal to B.
(defn- ev-find-byte [s :string b :i64 from :i64 fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [t (offset-trap s from)
        n (string-byte-length s)]
    (cond
      (not (and (>= b 0) (<= b 127))) (r-trap fuel "string-find-byte-not-ascii")
      (not (string=? t "")) (r-trap fuel t)
      :else (int-val (loop [i from]
                       (if (>= i n) -1
                         (let [c (string-code-point-at s i)]
                           (if (= c b) i (recur (+ i (cp-width c)))))))
                     fuel))))

;; string-append-range: ACC then bytes [START, END) of S (`utf8-substring!`'s checks).
(defn- ev-append-range [acc :string s :string start :i64 end :i64 fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [n (string-byte-length s)]
    (cond
      (or (< start 0) (or (> start end) (> end n))) (r-trap fuel "string-index-out-of-bounds")
      (not (and (utf8-boundary? s start) (utf8-boundary? s end))) (r-trap fuel "string-splits-code-point")
      :else (str-val (string-append-range acc s start end) fuel))))

(defn- ev-string2 [op :i64 a :string b :string fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (cond
    (= op 42) (ev-string-concat a b fuel)
    (= op 43) (r-val (kv/bool-value (string=? a b)) fuel)
    (= op 51) (int-val (string-compare a b) fuel)
    (= 0 (string-byte-length b))
    (r-trap fuel (if (= op 50) "empty-string-split-separator" "empty-string-search-needle"))
    (= op 47) (r-val (kv/bool-value (>= (string-index-of a b) 0)) fuel)
    (= op 48) (int-val (string-index-of a b) fuel)
    :else (int-val (split-count a b) fuel)))

;; 40-53 over the evaluated arguments
(defn- ev-string [op :i64 xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [sig (op-sig op)]
    (cond
      (not (= (vector-count xs) (string-byte-length sig))) (r-trap fuel "arity-mismatch")
      (not (sig-ok? sig xs)) (r-trap fuel "value-type-mismatch")
      (or (= op 40) (= op 41)) (int-val (string-byte-length (str-arg xs 0)) fuel)
      (= op 52) (str-val (string-fold-ascii (str-arg xs 0)) fuel)
      (= op 46) (let [n (arg-n xs 0)]
                  (str-val (if (= n (min-i64)) "-9223372036854775808" (i64->str n)) fuel))
      (= op 44) (ev-substring (str-arg xs 0) (arg-n xs 1) (arg-n xs 2) fuel)
      (= op 45) (ev-code-point-at (str-arg xs 0) (arg-n xs 1) fuel)
      (= op 49) (ev-replace-all (str-arg xs 0) (str-arg xs 1) (str-arg xs 2) fuel)
      (= op 53) (ev-index-of-from (str-arg xs 0) (str-arg xs 1) (arg-n xs 2) fuel)
      (= op 54) (ev-compare-lines (str-arg xs 0) (arg-n xs 1) (str-arg xs 2) (arg-n xs 3) fuel)
      (= op 55) (ev-find-byte (str-arg xs 0) (arg-n xs 1) (arg-n xs 2) fuel)
      (= op 56) (ev-append-range (str-arg xs 0) (str-arg xs 1) (arg-n xs 2) (arg-n xs 3) fuel)
      (or (= op 57) (= op 58)) (ev-scan-blank (str-arg xs 0) (arg-n xs 1) (= op 57) fuel)
      :else (ev-string2 op (str-arg xs 0) (str-arg xs 1) fuel))))

;; ---- aggregates: options, results, typed lists, i64 vectors ----

(defn- arg-v [xs [:list [:ref :kir/v]] i :i64] [:ref :kir/v]
  (typed-list-nth [:list [:ref :kir/v]] xs i))

(defn- desc-arg [ty [:ref :form/r] i :i64] [:ref :form/r]
  (if (and (form/is-vec? ty) (< i (form/count-of ty))) (form/nth-of ty i) (kw :i64)))

(defn- mismatch [fuel [:ref :kir.interp/st]] [:ref :kir.interp/out] (r-trap fuel "value-type-mismatch"))

(defn- agg-typed? [op :i64] :bool (and (>= op 60) (<= op 73)))

(defn- agg-lazy? [op :i64] :bool
  (or (= op 63) (or (= op 68) (or (= op 69) (or (= op 77) (or (= op 87) (or (= op 91) (= op 92))))))))

;; Number of evaluated (eager) arguments of an aggregate op, -1 when variadic.
(defn- agg-arity [op :i64] :i64
  (cond
    (or (= op 61) (= op 85)) 0
    (or (= op 60) (or (= op 62) (or (= op 65) (or (= op 66) (or (= op 67) (or (= op 75) (or (= op 80)
        (or (= op 84) (or (= op 86) (or (= op 88) (or (= op 89) (= op 90)))))))))))) 1
    (or (= op 72) (or (= op 73) (or (= op 76) (or (= op 78) (or (= op 79) (= op 83)))))) 2
    (or (= op 81) (= op 82)) 3
    :else -1))

(defn- slice-values [xs [:list [:ref :kir/v]] from :i64 to :i64] [:list [:ref :kir/v]]
  (loop [i from acc (kv/no-values)]
    (if (>= i to) acc (recur (inc i) (kv/append-value acc (arg-v xs i))))))

(defn- all-ty-from? [ty [:ref :form/r] xs [:list [:ref :kir/v]] i :i64] :bool
  (loop [j i]
    (if (>= j (vector-count xs)) true
      (if (type-ok? ty (arg-v xs j)) (recur (inc j)) false))))

(defn- replace-at [xs [:list [:ref :kir/v]] at :i64 v [:ref :kir/v]] [:list [:ref :kir/v]]
  (loop [i 0 acc (kv/no-values)]
    (if (>= i (vector-count xs)) acc
      (recur (inc i) (kv/append-value acc (if (= i at) v (arg-v xs i)))))))

(defn- zeros [n :i64] [:list [:ref :kir/v]]
  (loop [i 0 acc (kv/no-values)]
    (if (>= i n) acc (recur (inc i) (kv/append-value acc (kv/i64-value 0))))))

(defn- vec-limit [] :i64 16777216)
(defn- list-limit [] :i64 16384)

(defn- agg-vector [op :i64 xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (cond
    (= op 74) (if (all-i64-from? xs 0) (r-val (kv/vector-value xs) fuel) (mismatch fuel))
    (= op 75)
    (let [v (arg-v xs 0)]
      (if (or (= 8 (kv/tag-of v)) (i64vec? v)) (int-val (kv/count-of v) fuel) (mismatch fuel)))
    (= op 80)
    (let [n (arg-n xs 0)]
      (cond
        (not (i64? (arg-v xs 0))) (mismatch fuel)
        (or (< n 0) (> n (vec-limit))) (r-trap fuel "vector-alloc-out-of-range")
        (> n 65536) (r-trap fuel "interpreter-limit")
        :else (r-val (kv/vector-value (zeros n)) fuel)))
    (not (i64vec? (arg-v xs 0))) (mismatch fuel)
    :else
    (let [items (kv/kids-of (arg-v xs 0))
          cnt (vector-count items)]
      (cond
        (= op 83)
        (cond
          (not (i64? (arg-v xs 1))) (mismatch fuel)
          (>= cnt (vec-limit)) (r-trap fuel "vector-too-large")
          :else (r-val (kv/vector-value (kv/append-value items (arg-v xs 1))) fuel))
        (not (i64? (arg-v xs 1))) (mismatch fuel)
        (= op 76)
        (let [i (arg-n xs 1)]
          (if (and (>= i 0) (< i cnt)) (r-val (arg-v items i) fuel) (r-trap fuel "vector-index-out-of-range")))
        (= op 78)
        (let [k (arg-n xs 1)]
          (if (and (>= k 0) (<= k cnt))
            (r-val (kv/vector-value (slice-values items k cnt)) fuel)
            (r-trap fuel "vector-drop-out-of-range")))
        (= op 79)
        (let [k (arg-n xs 1)]
          (if (and (>= k 0) (<= k cnt))
            (r-val (kv/vector-value (slice-values items 0 k)) fuel)
            (r-trap fuel "vector-take-out-of-range")))
        :else
        (let [i (arg-n xs 1)]
          (cond
            (not (i64? (arg-v xs 2))) (mismatch fuel)
            (and (>= i 0) (< i cnt)) (r-val (kv/vector-value (replace-at items i (arg-v xs 2))) fuel)
            :else (r-trap fuel "vector-index-out-of-range")))))))

(defn- agg-list [op :i64 ty [:ref :form/r] xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [ety (desc-arg ty 1)]
    (cond
      (= op 71) (if (all-ty-from? ety xs 0) (r-val (kv/list-value xs) fuel) (mismatch fuel))
      (not (= 8 (kv/tag-of (arg-v xs 0)))) (mismatch fuel)
      (= op 72)
      (cond
        (not (type-ok? ety (arg-v xs 1))) (mismatch fuel)
        (>= (kv/count-of (arg-v xs 0)) (list-limit)) (r-trap fuel "list-too-large")
        :else (r-val (kv/list-value (kv/append-value (kv/kids-of (arg-v xs 0)) (arg-v xs 1))) fuel))
      :else
      (let [i (arg-n xs 1)
            items (kv/kids-of (arg-v xs 0))]
        (cond
          (not (i64? (arg-v xs 1))) (mismatch fuel)
          (or (< i 0) (>= i (vector-count items))) (r-trap fuel "list-index-out-of-bounds")
          :else (r-val (arg-v items i) fuel))))))

;; options and results (typed descriptor TY, or the untyped i64 forms)
(defn- agg-sum [op :i64 ty [:ref :form/r] xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (cond
    (or (= op 60) (= op 84))
    (if (type-ok? (if (= op 60) (desc-arg ty 1) (kw :i64)) (arg-v xs 0))
      (r-val (kv/some-value (arg-v xs 0)) fuel) (mismatch fuel))
    (or (= op 61) (= op 85)) (r-val (kv/none-value) fuel)
    (or (= op 62) (= op 86))
    (if (= 14 (kv/tag-of (arg-v xs 0)))
      (r-val (kv/bool-value (= 1 (kv/n-of (arg-v xs 0)))) fuel) (mismatch fuel))
    (or (= op 65) (= op 88))
    (if (type-ok? (if (= op 65) (desc-arg ty 1) (kw :i64)) (arg-v xs 0))
      (r-val (kv/ok-value (arg-v xs 0)) fuel) (mismatch fuel))
    (or (= op 66) (= op 89))
    (if (type-ok? (if (= op 66) (desc-arg ty 2) (kw :i64)) (arg-v xs 0))
      (r-val (kv/err-value (arg-v xs 0)) fuel) (mismatch fuel))
    :else
    (if (= 15 (kv/tag-of (arg-v xs 0)))
      (r-val (kv/bool-value (= 0 (kv/n-of (arg-v xs 0)))) fuel) (mismatch fuel))))

(defn- agg-apply [op :i64 ty [:ref :form/r] xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [want (agg-arity op)]
    (cond
      (and (>= want 0) (not (= want (vector-count xs)))) (r-trap fuel "arity-mismatch")
      (or (= op 71) (or (= op 72) (= op 73))) (agg-list op ty xs fuel)
      (>= op 74) (if (<= op 83) (agg-vector op xs fuel) (agg-sum op ty xs fuel))
      :else (agg-sum op ty xs fuel))))

;; The payload of an option/result when the fallback is not needed, else -1 / 0 / 1:
;; 1 selected (payload), 0 fallback, -1 type mismatch.
(defn- lazy-select [op :i64 xs [:list [:ref :kir/v]]] :i64
  (let [v (arg-v xs 0)]
    (cond
      (or (= op 63) (= op 87)) (if (= 14 (kv/tag-of v)) (if (= 1 (kv/n-of v)) 1 0) -1)
      (or (= op 68) (= op 91)) (if (= 15 (kv/tag-of v)) (if (= 0 (kv/n-of v)) 1 0) -1)
      (or (= op 69) (= op 92)) (if (= 15 (kv/tag-of v)) (if (= 1 (kv/n-of v)) 1 0) -1)
      :else
      (if (and (i64vec? v) (i64? (arg-v xs 1)))
        (if (and (>= (arg-n xs 1) 0) (< (arg-n xs 1) (kv/count-of v))) 1 0)
        -1))))

(defn- lazy-payload [op :i64 xs [:list [:ref :kir/v]]] [:ref :kir/v]
  (if (= op 77)
    (kv/nth-of (arg-v xs 0) (arg-n xs 1))
    (kv/nth-of (arg-v xs 0) 0)))

(defn- lazy-fb-type [op :i64 ty [:ref :form/r]] [:ref :form/r]
  (cond
    (or (= op 63) (= op 68)) (desc-arg ty 1)
    (= op 69) (desc-arg ty 2)
    :else (kw :i64)))

(defn- ev-lazy [op :i64 form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [base (if (agg-typed? op) 2 1)
        nfirst (if (= op 77) 2 1)
        ty (if (agg-typed? op) (form/nth-of form 1) (kw :i64))]
    (if (not (= (form/count-of form) (+ base (+ nfirst 1))))
      (r-trap fuel "arity-mismatch")
      (let [ar (ev-args-range form base (+ base nfirst) env cx fuel)]
        (if (not (= 0 (o-kind ar)))
          ar
          (let [xs (kv/kids-of (o-value ar))
                fu (o-st ar)
                sel (lazy-select op xs)]
            (cond
              (< sel 0) (mismatch fu)
              (= sel 1) (r-val (lazy-payload op xs) fu)
              :else
              (let [fb (ev-operand (form/nth-of form (+ base nfirst)) env cx fu)]
                (if (and (= 0 (o-kind fb)) (not (type-ok? (lazy-fb-type op ty) (o-value fb))))
                  (mismatch (o-st fb))
                  fb)))))))))

(defn- ev-option-match [form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (if (not (= 6 (form/count-of form)))
    (r-trap fuel "arity-mismatch")
    (let [r (ev-operand (form/nth-of form 2) env cx fuel)]
      (cond
        (not (= 0 (o-kind r))) r
        (not (= 14 (kv/tag-of (o-value r)))) (mismatch (o-st r))
        (= 1 (kv/n-of (o-value r)))
        (ev (form/nth-of form 5)
            (env-bind env (form/symbol-value (form/nth-of form 4)) (kv/nth-of (o-value r) 0))
            cx (o-st r))
        :else (ev (form/nth-of form 3) env cx (o-st r))))))

(defn- ev-result-match [form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (if (not (= 7 (form/count-of form)))
    (r-trap fuel "arity-mismatch")
    (let [r (ev-operand (form/nth-of form 2) env cx fuel)]
      (cond
        (not (= 0 (o-kind r))) r
        (not (= 15 (kv/tag-of (o-value r)))) (mismatch (o-st r))
        (= 0 (kv/n-of (o-value r)))
        (ev (form/nth-of form 4)
            (env-bind env (form/symbol-value (form/nth-of form 3)) (kv/nth-of (o-value r) 0))
            cx (o-st r))
        :else
        (ev (form/nth-of form 6)
            (env-bind env (form/symbol-value (form/nth-of form 5)) (kv/nth-of (o-value r) 0))
            cx (o-st r))))))

(defn- ev-agg [op :i64 form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (cond
    (= op 64) (ev-option-match form env cx fuel)
    (= op 70) (ev-result-match form env cx fuel)
    (agg-lazy? op) (ev-lazy op form env cx fuel)
    :else
    (let [ar (ev-args-range form (if (agg-typed? op) 2 1) (form/count-of form) env cx fuel)]
      (if (not (= 0 (o-kind ar)))
        ar
        (agg-apply op (if (agg-typed? op) (form/nth-of form 1) (kw :i64)) (kv/kids-of (o-value ar)) (o-st ar))))))


;; ---- :bytes (100-106) ----

(defn- bytes-limit [] :i64 8388608)  ; kotoba.kir.value/bytes-value-byte-limit (amu ADR 0362)

(defn- bytes-of-v [xs [:list [:ref :kir/v]] i :i64] :bytes (kv/b-of (arg-v xs i)))

(defn- bytes-val [b :bytes fuel [:ref :kir.interp/st]] [:ref :kir.interp/out] (r-val (kv/bytes-value b) fuel))

(defn- items-in-range? [items [:list [:ref :kir/v]] i :i64] :bool
  (loop [j i]
    (if (>= j (vector-count items)) true
      (let [n (kv/n-of (arg-v items j))]
        (if (and (>= n 0) (<= n 255)) (recur (inc j)) false)))))

(defn- fill-vector [v :vector-i64 items [:list [:ref :kir/v]] i :i64] :vector-i64
  (if (>= i (vector-count items)) v
    (fill-vector (vector-assoc! v i (kv/n-of (arg-v items i))) items (inc i))))

(defn- bytes->items [b :bytes i :i64 n :i64 acc [:list [:ref :kir/v]]] [:list [:ref :kir/v]]
  (if (>= i n) acc
    (bytes->items b (inc i) n (kv/append-value acc (kv/i64-value (bytes-at b i))))))

;; `utf8-invalid-at`: "" when B is canonical UTF-8, else the trap naming the first
;; sequence that is not (decided in the host's order).
(defn- cont? [b :bytes i :i64] :bool (= 128 (bit-and (bytes-at b i) 192)))

(defn- utf8-invalid [b :bytes] :string
  (let [n (bytes-count b)]
    (loop [i 0]
      (if (>= i n) ""
        (let [b0 (bytes-at b i)]
          (cond
            (< b0 128) (recur (inc i))
            (< b0 192) "utf8/unexpected-continuation"
            (< b0 194) "utf8/overlong"
            (> b0 244) "utf8/invalid-byte"
            (>= (inc i) n) "utf8/truncated"
            :else
            (let [b1 (bytes-at b (inc i))
                  k (cond (< b0 224) 1 (< b0 240) 2 :else 3)]
              (cond
                (not (cont? b (inc i))) "utf8/bad-continuation"
                (and (= b0 224) (< b1 160)) "utf8/overlong"
                (and (= b0 240) (< b1 144)) "utf8/overlong"
                (and (= b0 237) (>= b1 160)) "utf8/surrogate"
                (and (= b0 244) (>= b1 144)) "utf8/above-max"
                :else
                (let [bad (loop [j 2]
                            (cond (> j k) ""
                                  (>= (+ i j) n) "utf8/truncated"
                                  (not (cont? b (+ i j))) "utf8/bad-continuation"
                                  :else (recur (inc j))))]
                  (if (string=? bad "") (recur (+ i (+ k 1))) bad))))))))))

(defn- ev-from-utf8 [b :bytes fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [bad (if (> (bytes-count b) (str-limit)) "" (utf8-invalid b))]
    (cond
      (> (bytes-count b) (str-limit)) (r-trap fuel "string/too-large")
      (not (string=? bad "")) (r-trap fuel bad)
      :else (str-val (string-from-utf8 b) fuel))))

(defn- bytes-arity [op :i64] :i64
  (cond (= op 100) 0 (or (= op 101) (or (= op 105) (or (= op 106) (= op 107)))) 1 (= op 103) 3 :else 2))

(defn- bytes-sig-ok? [op :i64 xs [:list [:ref :kir/v]]] :bool
  (cond
    (= op 101) (= 7 (kv/tag-of (arg-v xs 0)))
    (= op 102) (and (= 7 (kv/tag-of (arg-v xs 0))) (i64? (arg-v xs 1)))
    (= op 103) (and (= 7 (kv/tag-of (arg-v xs 0))) (and (i64? (arg-v xs 1)) (i64? (arg-v xs 2))))
    (= op 104) (and (= 7 (kv/tag-of (arg-v xs 0))) (= 7 (kv/tag-of (arg-v xs 1))))
    (= op 105) (i64vec? (arg-v xs 0))
    (or (= op 106) (= op 107)) (= 7 (kv/tag-of (arg-v xs 0)))
    :else true))

(defn- ev-bytes [op :i64 xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (cond
    (not (= (bytes-arity op) (vector-count xs))) (r-trap fuel "arity-mismatch")
    (not (bytes-sig-ok? op xs)) (mismatch fuel)
    (= op 100) (bytes-val (bytes-empty) fuel)
    (= op 101) (int-val (bytes-count (bytes-of-v xs 0)) fuel)
    (= op 102)
    (let [b (bytes-of-v xs 0) i (arg-n xs 1)]
      (if (and (>= i 0) (< i (bytes-count b))) (int-val (bytes-at b i) fuel) (r-trap fuel "bytes/index-out-of-range")))
    (= op 103)
    (let [b (bytes-of-v xs 0) s (arg-n xs 1) e (arg-n xs 2)]
      (if (and (>= s 0) (and (<= s e) (<= e (bytes-count b))))
        (bytes-val (bytes-slice b s e) fuel)
        (r-trap fuel "bytes/slice-bounds")))
    (= op 104)
    (let [a (bytes-of-v xs 0) b (bytes-of-v xs 1)]
      (if (> (+ (bytes-count a) (bytes-count b)) (bytes-limit))
        (r-trap fuel "bytes/too-large")
        (bytes-val (bytes-concat a b) fuel)))
    (= op 107) (ev-from-utf8 (bytes-of-v xs 0) fuel)
    (= op 105)
    (let [items (kv/kids-of (arg-v xs 0))]
      (cond
        (> (vector-count items) (bytes-limit)) (r-trap fuel "bytes/too-large")
        (not (items-in-range? items 0)) (r-trap fuel "bytes/item-out-of-range")
        :else (bytes-val (bytes-from-vector-i64 (fill-vector (vector-alloc (vector-count items)) items 0)) fuel)))
    :else
    (let [b (bytes-of-v xs 0)]
      (r-val (kv/vector-value (bytes->items b 0 (bytes-count b) (kv/no-values))) fuel))))


;; ---- f64 / f32 (120-169): a float Value is tag 3 with n = the IEEE bits (f32: signed i32 bits) ----
;;   120+k f64-{from-bits to-bits add sub mul div min max neg abs sqrt eq lt le gt ge unordered}
;;   140+k the same for f32
;;   160 i64-to-f64-checked 161 i64-to-f64-rounded 162 f64-to-i64-checked 163 f64-to-i64-truncating
;;   164 f64-to-f32-rounded 165 f32-to-f64-exact 166 i64-to-f32-checked 167 i64-to-f32-rounded
;;   168 f32-to-i64-checked 169 f32-to-i64-truncating
;; Conversions that the host answers with an untyped error have no oracle outcome; they are
;; answered as the named traps below.

(defn- fl-kind [op :i64] :i64 (if (< op 140) 64 (if (< op 160) 32 0)))

(defn- two-pow-63 [] :f64 (f64-from-bits 4890909195324358656))

(defn- neg-two-pow-63 [] :f64 (f64-neg (two-pow-63)))

(defn- fw [v [:ref :kir/v]] :f64 (f64-from-bits (kv/n-of v)))
(defn- fx [v [:ref :kir/v]] :f32 (f32-from-bits (kv/n-of v)))

(defn- f64-res [x :f64 fuel [:ref :kir.interp/st]] [:ref :kir.interp/out] (r-val (kv/f64-value (f64-to-bits x)) fuel))
(defn- f32-res [x :f32 fuel [:ref :kir.interp/st]] [:ref :kir.interp/out] (r-val (kv/f64-value (f32-to-bits x)) fuel))
(defn- bool-res [b :bool fuel [:ref :kir.interp/st]] [:ref :kir.interp/out] (r-val (kv/bool-value b) fuel))

(defn- f64-finite? [x :f64] :bool (f64-eq (f64-sub x x) (f64-from-bits 0)))

(defn- f64-in-i64? [x :f64] :bool
  (and (f64-ge x (neg-two-pow-63)) (f64-lt x (two-pow-63))))

;; x finite and inside the i64 range: truncation is defined
(defn- f64-truncatable? [x :f64] :bool (and (f64-finite? x) (f64-in-i64? x)))

(defn- f64-integral? [x :f64] :bool
  (f64-eq (i64-to-f64-rounded (f64-to-i64-truncating x)) x))

(defn- i64-exact-f64? [n :i64 r :f64] :bool
  (and (f64-lt r (two-pow-63)) (= (f64-to-i64-truncating r) n)))

;; arity and operand tags. 0 bits-in (i64), 1 float in, 2 two floats, 3 one i64
(defn- fl-shape [op :i64] :i64
  (let [k (if (< op 160) (rem op 20) op)]
    (cond
      (< op 160)
      (cond (= k 0) 3
            (or (= k 1) (or (= k 8) (or (= k 9) (= k 10)))) 1
            :else 2)
      (or (= op 160) (or (= op 161) (or (= op 166) (= op 167)))) 3
      :else 1)))

(defn- fl-tags-ok? [shape :i64 xs [:list [:ref :kir/v]]] :bool
  (cond
    (= shape 3) (i64? (arg-v xs 0))
    (= shape 1) (= 3 (kv/tag-of (arg-v xs 0)))
    :else (and (= 3 (kv/tag-of (arg-v xs 0))) (= 3 (kv/tag-of (arg-v xs 1))))))

(defn- ev-f64-op [k :i64 xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [a (fw (arg-v xs 0))]
    (cond
      (= k 0) (f64-res (f64-from-bits (arg-n xs 0)) fuel)
      (= k 1) (int-val (f64-to-bits a) fuel)
      (= k 8) (f64-res (f64-neg a) fuel)
      (= k 9) (f64-res (f64-abs a) fuel)
      (= k 10) (f64-res (f64-sqrt a) fuel)
      :else
      (let [b (fw (arg-v xs 1))]
        (cond
          (= k 2) (f64-res (f64-add a b) fuel)
          (= k 3) (f64-res (f64-sub a b) fuel)
          (= k 4) (f64-res (f64-mul a b) fuel)
          (= k 5) (f64-res (f64-div a b) fuel)
          (= k 6) (f64-res (f64-min a b) fuel)
          (= k 7) (f64-res (f64-max a b) fuel)
          (= k 11) (bool-res (f64-eq a b) fuel)
          (= k 12) (bool-res (f64-lt a b) fuel)
          (= k 13) (bool-res (f64-le a b) fuel)
          (= k 14) (bool-res (f64-gt a b) fuel)
          (= k 15) (bool-res (f64-ge a b) fuel)
          :else (bool-res (f64-unordered a b) fuel))))))

(defn- ev-f32-op [k :i64 xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (if (and (= k 0) (or (< (arg-n xs 0) (- 0 2147483648)) (> (arg-n xs 0) 2147483647)))
    (r-trap fuel "f32-bit-pattern-out-of-range")
    (if (= k 0)
      (f32-res (f32-from-bits (arg-n xs 0)) fuel)
      (let [a (fx (arg-v xs 0))]
        (cond
          (= k 1) (int-val (f32-to-bits a) fuel)
          (= k 8) (f32-res (f32-neg a) fuel)
          (= k 9) (f32-res (f32-abs a) fuel)
          (= k 10) (f32-res (f32-sqrt a) fuel)
          :else
          (let [b (fx (arg-v xs 1))]
            (cond
              (= k 2) (f32-res (f32-add a b) fuel)
              (= k 3) (f32-res (f32-sub a b) fuel)
              (= k 4) (f32-res (f32-mul a b) fuel)
              (= k 5) (f32-res (f32-div a b) fuel)
              (= k 6) (f32-res (f32-min a b) fuel)
              (= k 7) (f32-res (f32-max a b) fuel)
              (= k 11) (bool-res (f32-eq a b) fuel)
              (= k 12) (bool-res (f32-lt a b) fuel)
              (= k 13) (bool-res (f32-le a b) fuel)
              (= k 14) (bool-res (f32-gt a b) fuel)
              (= k 15) (bool-res (f32-ge a b) fuel)
              :else (bool-res (f32-unordered a b) fuel))))))))

;; f64 -> i64 after the host's conversion contract (finite, in range, and integral when checked)
(defn- ev-f64-to-i64 [x :f64 checked? :bool fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (cond
    (not (f64-truncatable? x)) (r-trap fuel "f64-conversion-out-of-range")
    (and checked? (not (f64-integral? x))) (r-trap fuel "f64-not-integral")
    :else (int-val (f64-to-i64-truncating x) fuel)))

(defn- ev-float-conv [op :i64 xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (cond
    (= op 160)
    (let [n (arg-n xs 0) r (i64-to-f64-rounded n)]
      (if (i64-exact-f64? n r) (f64-res r fuel) (r-trap fuel "i64-not-exact-f64")))
    (= op 161) (f64-res (i64-to-f64-rounded (arg-n xs 0)) fuel)
    (= op 162) (ev-f64-to-i64 (fw (arg-v xs 0)) true fuel)
    (= op 163) (ev-f64-to-i64 (fw (arg-v xs 0)) false fuel)
    (= op 164) (f32-res (f64-to-f32-rounded (fw (arg-v xs 0))) fuel)
    (= op 165) (f64-res (f32-to-f64-exact (fx (arg-v xs 0))) fuel)
    (= op 166)
    (let [n (arg-n xs 0) r (i64-to-f32-rounded n)]
      (if (i64-exact-f64? n (f32-to-f64-exact r)) (f32-res r fuel) (r-trap fuel "i64-not-exact-f32")))
    (= op 167) (f32-res (i64-to-f32-rounded (arg-n xs 0)) fuel)
    (= op 168) (ev-f64-to-i64 (f32-to-f64-exact (fx (arg-v xs 0))) true fuel)
    :else (ev-f64-to-i64 (f32-to-f64-exact (fx (arg-v xs 0))) false fuel)))

(defn- ev-float [op :i64 xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [shape (fl-shape op)
        want (if (= shape 2) 2 1)]
    (cond
      (not (= want (vector-count xs))) (r-trap fuel "arity-mismatch")
      (not (fl-tags-ok? shape xs)) (mismatch fuel)
      (>= op 160) (ev-float-conv op xs fuel)
      (< op 140) (ev-f64-op (- op 120) xs fuel)
      :else (ev-f32-op (- op 140) xs fuel))))


;; ---- documents (200-228) ----
;; A document is a variant Value (tag 13) marked with k = :document: s is the document tag
;; ("null" "bool" "i64" "f64" "string" "keyword" "vector" "list" "map"), kids the payload (one
;; leaf Value, the items, or a map's flat key/value pairs with every key a "keyword" node, kept
;; sorted by keyword text). Sets, non-keyword map keys, sha256, print and read are not ported.

(defn- doc-v [tag :string kids [:list [:ref :kir/v]]] [:ref :kir/v]
  (record-new [:ref :kir/v] 13 0 tag :document (bytes-empty) kids))

(defn- doc-leaf [tag :string x [:ref :kir/v]] [:ref :kir/v] (doc-v tag (kv/one-value x)))

(defn- doc-tag? [v [:ref :kir/v] tag :string] :bool (string=? (kv/s-of v) tag))

(defn- doc-limit [] :i64 32)

(defn- kw-text [k :keyword] :string (document-edn-print (document-keyword k)))

(defn- key-text [kd [:ref :kir/v]] :string (kw-text (kv/k-of (kv/nth-of kd 0))))

(defn- concat-values [xs [:list [:ref :kir/v]] ys [:list [:ref :kir/v]]] [:list [:ref :kir/v]]
  (loop [j 0 acc xs]
    (if (>= j (vector-count ys)) acc (recur (inc j) (kv/append-value acc (arg-v ys j))))))

;; position (even index into the flat kids) of the pair keyed TEXT, or -1
(defn- map-find [kids [:list [:ref :kir/v]] text :string] :i64
  (let [n (vector-count kids)]
    (loop [j 0]
      (cond
        (>= j n) -1
        (string=? (key-text (arg-v kids j)) text) j
        :else (recur (+ j 2))))))

(defn- put-pair [acc [:list [:ref :kir/v]] kd [:ref :kir/v] x [:ref :kir/v]] [:list [:ref :kir/v]]
  (kv/append-value (kv/append-value acc kd) x))

;; KIDS with (KD, X) inserted in key order, or replacing the pair with the same key
(defn- map-put [kids [:list [:ref :kir/v]] kd [:ref :kir/v] x [:ref :kir/v]] [:list [:ref :kir/v]]
  (let [n (vector-count kids)
        text (key-text kd)]
    (loop [j 0 acc (kv/no-values) placed false]
      (cond
        (>= j n) (if placed acc (put-pair acc kd x))
        (and (not placed) (string=? (key-text (arg-v kids j)) text))
        (recur (+ j 2) (put-pair acc kd x) true)
        (and (not placed) (> (string-compare (key-text (arg-v kids j)) text) 0))
        (recur j (put-pair acc kd x) true)
        :else
        (recur (+ j 2) (put-pair acc (arg-v kids j) (arg-v kids (+ j 1))) placed)))))

(defn- map-drop [kids [:list [:ref :kir/v]] at :i64] [:list [:ref :kir/v]]
  (let [n (vector-count kids)]
    (loop [j 0 acc (kv/no-values)]
      (cond
        (>= j n) acc
        (= j at) (recur (+ j 2) acc)
        :else (recur (+ j 2) (put-pair acc (arg-v kids j) (arg-v kids (+ j 1))))))))

(defn- key-node [k [:ref :kir/v]] [:ref :kir/v] (doc-leaf "keyword" k))

(defn- all-docs? [xs [:list [:ref :kir/v]]] :bool
  (loop [j 0]
    (if (>= j (vector-count xs)) true
      (if (doc? (arg-v xs j)) (recur (inc j)) false))))

(defn- map-args-ok? [xs [:list [:ref :kir/v]]] :bool
  (and (= 0 (rem (vector-count xs) 2))
       (loop [j 0]
         (if (>= j (vector-count xs)) true
           (if (and (= 5 (kv/tag-of (arg-v xs j))) (doc? (arg-v xs (+ j 1)))) (recur (+ j 2)) false)))))

(defn- build-map [xs [:list [:ref :kir/v]]] [:list [:ref :kir/v]]
  (loop [j 0 acc (kv/no-values)]
    (if (>= j (vector-count xs)) acc
      (recur (+ j 2) (map-put acc (key-node (arg-v xs j)) (arg-v xs (+ j 1)))))))

(defn- doc-arity [op :i64] :i64
  (cond
    (= op 200) 0
    (or (= op 206) (or (= op 207) (or (= op 208) (= op 223)))) -1
    (or (= op 213) (= op 221)) 3
    (or (= op 211) (or (= op 212) (or (= op 214) (or (= op 215) (or (= op 216) (or (= op 217)
      (or (= op 218) (or (= op 219) (or (= op 220) (= op 222)))))))))) 2
    :else 1))

;; operand tags for the fixed-arity operations
(defn- doc-sig-ok? [op :i64 xs [:list [:ref :kir/v]]] :bool
  (cond
    (= op 201) (bool-word? (arg-v xs 0))
    (= op 202) (i64? (arg-v xs 0))
    (= op 203) (= 3 (kv/tag-of (arg-v xs 0)))
    (= op 204) (= 4 (kv/tag-of (arg-v xs 0)))
    (= op 205) (= 5 (kv/tag-of (arg-v xs 0)))
    (or (= op 209) (or (= op 210) (>= op 224))) (doc? (arg-v xs 0))
    (or (= op 211) (or (= op 212) (or (= op 215) (or (= op 216) (= op 217)))))
    (and (doc? (arg-v xs 0)) (i64? (arg-v xs 1)))
    (= op 213) (and (doc? (arg-v xs 0)) (and (i64? (arg-v xs 1)) (doc? (arg-v xs 2))))
    (or (= op 214) (= op 218)) (and (doc? (arg-v xs 0)) (doc? (arg-v xs 1)))
    (or (= op 219) (or (= op 220) (= op 222))) (and (doc? (arg-v xs 0)) (= 5 (kv/tag-of (arg-v xs 1))))
    (= op 221) (and (doc? (arg-v xs 0)) (and (= 5 (kv/tag-of (arg-v xs 1))) (doc? (arg-v xs 2))))
    (or (= op 206) (or (= op 207) (= op 223))) (all-docs? xs)
    (= op 208) (map-args-ok? xs)
    :else true))

(defn- doc-opt [ok? :bool x [:ref :kir/v] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (r-val (if ok? (kv/some-value x) (kv/none-value)) fuel))

(defn- doc-container? [v [:ref :kir/v]] :bool
  (or (doc-tag? v "vector") (or (doc-tag? v "list") (doc-tag? v "map"))))

(defn- doc-count [d [:ref :kir/v] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (cond
    (not (doc-container? d)) (r-trap fuel "document-container-required")
    (doc-tag? d "map") (int-val (quot (kv/count-of d) 2) fuel)
    :else (int-val (kv/count-of d) fuel)))

(defn- doc-vec-op [op :i64 d [:ref :kir/v] xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [items (kv/kids-of d)
        cnt (vector-count items)
        i (if (= op 214) 0 (arg-n xs 1))]
    (cond
      (not (doc-tag? d (if (= op 212) "list" "vector")))
      (r-trap fuel (if (= op 212) "document-list-required" "document-vector-required"))
      (or (= op 211) (= op 212))
      (doc-opt (and (>= i 0) (< i cnt)) (if (and (>= i 0) (< i cnt)) (arg-v items i) (kv/nil-value)) fuel)
      (= op 214)
      (if (>= cnt (doc-limit)) (r-trap fuel "document-vector-too-large")
        (r-val (doc-v "vector" (kv/append-value items (arg-v xs 1))) fuel))
      (= op 215)
      (if (and (>= i 0) (<= i cnt)) (r-val (doc-v "vector" (slice-values items i cnt)) fuel)
        (r-trap fuel "document-vector-drop-out-of-range"))
      (not (and (>= i 0) (< i cnt))) (r-trap fuel "document-vector-index-out-of-range")
      (= op 213) (r-val (doc-v "vector" (replace-at items i (arg-v xs 2))) fuel)
      :else (r-val (doc-v "vector" (concat-values (slice-values items 0 i) (slice-values items (+ i 1) cnt))) fuel))))

(defn- doc-map-op [op :i64 d [:ref :kir/v] xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [kids (kv/kids-of d)]
    (cond
      (not (doc-tag? d "map")) (r-trap fuel "document-map-required")
      (= op 217)
      (let [i (arg-n xs 1)]
        (if (and (>= i 0) (< (* 2 i) (vector-count kids)))
          (doc-opt true (doc-v "vector" (kv/two-values (arg-v kids (* 2 i)) (arg-v kids (+ (* 2 i) 1)))) fuel)
          (doc-opt false (kv/nil-value) fuel)))
      :else
      (let [at (map-find kids (kw-text (kv/k-of (arg-v xs 1))))]
        (cond
          (= op 219) (r-val (kv/bool-value (>= at 0)) fuel)
          (= op 220) (doc-opt (>= at 0) (if (>= at 0) (arg-v kids (+ at 1)) (kv/nil-value)) fuel)
          (= op 222) (r-val (if (>= at 0) (doc-v "map" (map-drop kids at)) d) fuel)
          (and (< at 0) (>= (quot (vector-count kids) 2) (doc-limit))) (r-trap fuel "document-map-too-large")
          :else (r-val (doc-v "map" (map-put kids (key-node (arg-v xs 1)) (arg-v xs 2))) fuel))))))

(defn- merge-into [acc [:list [:ref :kir/v]] xs [:list [:ref :kir/v]] i :i64] [:list [:ref :kir/v]]
  (if (>= i (vector-count xs)) acc
    (let [kids (kv/kids-of (arg-v xs i))]
      (merge-into
        (loop [j 0 a acc]
          (if (>= j (vector-count kids)) a
            (recur (+ j 2) (map-put a (arg-v kids j) (arg-v kids (+ j 1))))))
        xs (inc i)))))

(defn- all-maps? [xs [:list [:ref :kir/v]]] :bool
  (loop [j 0]
    (if (>= j (vector-count xs)) true
      (if (doc-tag? (arg-v xs j) "map") (recur (inc j)) false))))

(defn- doc-kind-name [d [:ref :kir/v]] :keyword (keyword-from-string (kv/s-of d)))

(defn- ev-document [op :i64 xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [want (doc-arity op)]
    (cond
      (and (>= want 0) (not (= want (vector-count xs)))) (r-trap fuel "arity-mismatch")
      (not (doc-sig-ok? op xs)) (mismatch fuel)
      (= op 200) (r-val (doc-v "null" (kv/no-values)) fuel)
      (= op 201) (r-val (doc-leaf "bool" (kv/bool-value (bool-word-true? (arg-v xs 0)))) fuel)
      (= op 202) (r-val (doc-leaf "i64" (arg-v xs 0)) fuel)
      (= op 203)
      (if (f64-finite? (fw (arg-v xs 0))) (r-val (doc-leaf "f64" (arg-v xs 0)) fuel) (r-trap fuel "document-f64-not-finite"))
      (= op 204) (r-val (doc-leaf "string" (arg-v xs 0)) fuel)
      (= op 205) (r-val (doc-leaf "keyword" (arg-v xs 0)) fuel)
      (or (= op 206) (= op 207))
      (if (> (vector-count xs) (doc-limit)) (r-trap fuel "document-vector-too-large")
        (r-val (doc-v (if (= op 206) "vector" "list") xs) fuel))
      (= op 208)
      (cond
        (> (quot (vector-count xs) 2) (doc-limit)) (r-trap fuel "document-map-too-large")
        ;; the host's `bounded-document!` refuses a map whose keys repeat
        (< (quot (vector-count (build-map xs)) 2) (quot (vector-count xs) 2)) (r-trap fuel "document-map-duplicate-key")
        :else (r-val (doc-v "map" (build-map xs)) fuel))
      (= op 209) (doc-count (arg-v xs 0) fuel)
      (= op 210) (r-val (kv/keyword-value (doc-kind-name (arg-v xs 0))) fuel)
      (= op 218) (r-val (kv/bool-value (kv/value-eq (arg-v xs 0) (arg-v xs 1))) fuel)
      (= op 223)
      (if (not (all-maps? xs)) (r-trap fuel "document-map-required")
        (let [m (merge-into (kv/no-values) xs 0)]
          (if (> (quot (vector-count m) 2) (doc-limit)) (r-trap fuel "document-map-too-large")
            (r-val (doc-v "map" m) fuel))))
      (>= op 224)
      (let [d (arg-v xs 0)
            tag (cond (= op 224) "string" (= op 225) "keyword" (= op 226) "bool" (= op 227) "i64" :else "f64")]
        (doc-opt (doc-tag? d tag) (if (doc-tag? d tag) (kv/nth-of d 0) (kv/nil-value)) fuel))
      (or (= op 217) (or (= op 219) (or (= op 220) (or (= op 221) (= op 222)))))
      (doc-map-op op (arg-v xs 0) xs fuel)
      :else (doc-vec-op op (arg-v xs 0) xs fuel))))

;; ---- pairs, typed aggregates and f64 vectors (300-327) ----

(defn- ev-pair [op :i64 xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (cond
    (not (= (vector-count xs) (if (= op 300) 2 1))) (r-trap fuel "arity-mismatch")
    (= op 300) (allocate-pair fuel (arg-v xs 0) (arg-v xs 1))
    :else (read-pair fuel (arg-v xs 0) (if (= op 301) 0 1))))

;; A typed-set item order (`compare-typed-values`) for the two ported item types.
;; A keyword compares by its printed text in UTF-16 order on the host; below
;; U+D800 that is byte order, which `string-compare` answers.
(defn- set-before? [a [:ref :kir/v] b [:ref :kir/v]] :bool
  (if (i64? a)
    (< (kv/n-of a) (kv/n-of b))
    (< (string-compare (kw-text (kv/k-of a)) (kw-text (kv/k-of b))) 0)))

(defn- set-same? [a [:ref :kir/v] b [:ref :kir/v]] :bool
  (if (i64? a) (= (kv/n-of a) (kv/n-of b)) (= (kv/k-of a) (kv/k-of b))))

(defn- bmp-text? [t :string] :bool
  (loop [i 0]
    (if (>= i (string-byte-length t)) true
      (let [c (string-code-point-at t i)]
        (if (< c 55296) (recur (+ i (cp-width c))) false)))))

(defn- insert-sorted [acc [:list [:ref :kir/v]] x [:ref :kir/v]] [:list [:ref :kir/v]]
  (let [n (vector-count acc)]
    (loop [i 0 out (kv/no-values) placed false]
      (cond
        (>= i n) (if placed out (kv/append-value out x))
        (and (not placed) (set-before? x (arg-v acc i))) (recur i (kv/append-value out x) true)
        :else (recur (inc i) (kv/append-value out (arg-v acc i)) placed)))))

(defn- sort-items [xs [:list [:ref :kir/v]]] [:list [:ref :kir/v]]
  (loop [i 0 acc (kv/no-values)]
    (if (>= i (vector-count xs)) acc (recur (inc i) (insert-sorted acc (arg-v xs i))))))

(defn- has-adjacent-same? [xs [:list [:ref :kir/v]]] :bool
  (loop [i 1]
    (if (>= i (vector-count xs)) false
      (if (set-same? (arg-v xs (- i 1)) (arg-v xs i)) true (recur (inc i))))))

(defn- all-bmp-keywords? [xs [:list [:ref :kir/v]]] :bool
  (loop [i 0]
    (if (>= i (vector-count xs)) true
      (let [x (arg-v xs i)]
        (if (or (not (= 5 (kv/tag-of x))) (bmp-text? (kw-text (kv/k-of x)))) (recur (inc i)) false)))))

;; typed-set-new: the operands, the bound, the canonical order, no duplicate.
(defn- set-new [ty [:ref :form/r] xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (cond
    (> (vector-count xs) (set-limit)) (r-trap fuel "typed-set-too-large")
    (not (all-same-operand-ok? (form/nth-of ty 1) xs)) (mismatch fuel)
    (not (all-bmp-keywords? xs)) (r-trap fuel "interpreter-limit")
    :else
    (let [sorted (sort-items xs)]
      (if (has-adjacent-same? sorted)
        (r-trap fuel "typed-set-duplicate-item")
        (r-val (typed-v "set" ty sorted) fuel)))))

(defn- mk-record [ty [:ref :form/r] xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (if (all-operands-ok? (field-types ty) xs)
    (r-val (typed-v "record" ty xs) fuel)
    (mismatch fuel)))

(defn- hetero-new [ty [:ref :form/r] xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (if (all-operands-ok? (form/nth-of ty 1) xs)
    (r-val (typed-v "hvec" ty xs) fuel)
    (mismatch fuel)))

;; variant-new: TAG is the raw keyword of the form (not evaluated).
(defn- mk-variant [ty [:ref :form/r] tag [:ref :form/r] x [:ref :kir/v] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [cases (form/nth-of ty 2)
        at (entry-index cases tag)]
    (cond
      (< at 0) (r-trap fuel "variant-case-undeclared")
      (not (operand-ok? (form/nth-of (form/nth-of cases at) 1) x)) (mismatch fuel)
      :else (r-val (typed-v "variant" ty (kv/two-values (kv/keyword-value (form/keyword-value tag)) x)) fuel))))

(defn- branch-for [bs [:ref :form/r] tag [:ref :kir/v]] :i64
  (loop [i 0]
    (cond
      (>= i (form/count-of bs)) -1
      (= (form/keyword-value (form/nth-of (form/nth-of bs i) 0)) (kv/k-of tag)) i
      :else (recur (inc i)))))

(defn- ev-variant-match [form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [ty (form/nth-of form 1)
        r (ev-operand (form/nth-of form 2) env cx fuel)]
    (cond
      (not (= 0 (o-kind r))) r
      (not (typed-node-ok? ty (o-value r))) (mismatch (o-st r))
      :else
      (let [v (o-value r)
            bs (form/nth-of form 3)
            at (branch-for bs (kv/nth-of v 1))]
        (if (< at 0)
          (r-trap (o-st r) "unknown-variant-case")
          (let [b (form/nth-of bs at)]
            (ev (form/nth-of b 2) (env-bind env (form/symbol-value (form/nth-of b 1)) (kv/nth-of v 2))
                cx (o-st r))))))))

;; record-get / hetero-vector-at / typed-set-count over the evaluated operand V.
(defn- typed-read [op :i64 form [:ref :form/r] v [:ref :kir/v] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [ty (form/nth-of form 1)]
    (cond
      (not (typed-node-ok? ty v)) (mismatch fuel)
      (= op 317) (int-val (- (kv/count-of v) 1) fuel)
      (= op 315)
      (let [i (form/int-value (form/nth-of form 3))]
        (if (< (+ i 1) (kv/count-of v)) (r-val (kv/nth-of v (+ i 1)) fuel) (r-trap fuel "hetero-vector-index-out-of-range")))
      :else
      (let [at (entry-index (form/nth-of ty 2) (form/nth-of form 3))]
        (if (< at 0) (r-trap fuel "unknown-record-field") (r-val (kv/nth-of v (+ at 1)) fuel))))))

;; ---- f64 vectors: a vector Value with s = "f64" (the host's is a plain vector of
;; f64 values, so an empty one is also an empty :vector-i64, and the reverse) ----

(defn- f64-vector [items [:list [:ref :kir/v]]] [:ref :kir/v]
  (record-new [:ref :kir/v] 9 0 "f64" :none (bytes-empty) items))

(defn- f64vec? [v [:ref :kir/v]] :bool
  (and (= 9 (kv/tag-of v)) (or (string=? (kv/s-of v) "f64") (= 0 (kv/count-of v)))))

(defn- i64vec? [v [:ref :kir/v]] :bool
  (and (= 9 (kv/tag-of v)) (or (string=? (kv/s-of v) "") (= 0 (kv/count-of v)))))

(defn- all-f64? [xs [:list [:ref :kir/v]]] :bool
  (loop [i 0]
    (if (>= i (vector-count xs)) true
      (if (= 3 (kv/tag-of (arg-v xs i))) (recur (inc i)) false))))

(defn- vf-arity [op :i64] :i64
  (cond (= op 320) -1 (= op 321) 1 (or (= op 322) (= op 326)) 3 :else 2))

(defn- ev-vector-f64 [op :i64 xs [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (cond
    (= op 320)
    (cond
      (not (all-f64? xs)) (mismatch fuel)
      (> (vector-count xs) (vec-limit)) (r-trap fuel "vector-too-large")
      :else (r-val (f64-vector xs) fuel))
    (not (f64vec? (arg-v xs 0))) (mismatch fuel)
    (= op 321) (int-val (kv/count-of (arg-v xs 0)) fuel)
    :else
    (let [items (kv/kids-of (arg-v xs 0))
          cnt (vector-count items)]
      (cond
        (= op 327)
        (cond
          (not (= 3 (kv/tag-of (arg-v xs 1)))) (mismatch fuel)
          (>= cnt (vec-limit)) (r-trap fuel "vector-f64-too-large")
          :else (r-val (f64-vector (kv/append-value items (arg-v xs 1))) fuel))
        (and (= op 326) (not (= 3 (kv/tag-of (arg-v xs 2))))) (mismatch fuel)
        :else
        (let [i (arg-n xs 1)
              int? (i64? (arg-v xs 1))]
          (cond
            (or (= op 323) (= op 326))
            (cond
              (not (and int? (and (>= i 0) (< i cnt)))) (r-trap fuel "vector-f64-index-out-of-range")
              (= op 323) (r-val (arg-v items i) fuel)
              :else (r-val (f64-vector (replace-at items i (arg-v xs 2))) fuel))
            (= op 324)
            (if (and int? (and (>= i 0) (<= i cnt)))
              (r-val (f64-vector (slice-values items i cnt)) fuel)
              (r-trap fuel "vector-f64-drop-out-of-range"))
            :else
            (if (and int? (and (>= i 0) (<= i cnt)))
              (r-val (f64-vector (slice-values items 0 i)) fuel)
              (r-trap fuel "vector-f64-take-out-of-range"))))))))

;; vector-f64-get: the fallback (argument 3) is evaluated only when the index misses.
(defn- ev-vector-f64-get [form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (if (not (= 4 (form/count-of form)))
    (r-trap fuel "arity-mismatch")
    (let [ar (ev-args-range form 1 3 env cx fuel)]
      (if (not (= 0 (o-kind ar)))
        ar
        (let [xs (kv/kids-of (o-value ar))
              fu (o-st ar)
              v (arg-v xs 0)
              i (arg-n xs 1)]
          (cond
            (not (f64vec? v)) (mismatch fu)
            (and (i64? (arg-v xs 1)) (and (>= i 0) (< i (kv/count-of v)))) (r-val (kv/nth-of v i) fu)
            :else
            (let [fb (ev-operand (form/nth-of form 3) env cx fu)]
              (if (and (= 0 (o-kind fb)) (not (= 3 (kv/tag-of (o-value fb)))))
                (mismatch (o-st fb))
                fb))))))))

;; hetero-vector-assoc: V carries TYPE, the item at literal index I (the host's
;; `assoc` at I+1) is replaced, and the rebuilt node is checked again.
(defn- hetero-assoc [form [:ref :form/r] v [:ref :kir/v] x [:ref :kir/v] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [ty (form/nth-of form 1)
        i (form/int-value (form/nth-of form 3))]
    (cond
      (not (typed-node-ok? ty v)) (mismatch fuel)
      (not (< (+ i 1) (kv/count-of v))) (r-trap fuel "hetero-vector-index-out-of-range")
      (not (operand-ok? (form/nth-of (form/nth-of ty 1) i) x)) (mismatch fuel)
      :else (r-val (typed-v "hvec" ty (replace-at (typed-items v) i x)) fuel))))

(defn- ev-typed [op :i64 form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (cond
    (= op 313) (ev-variant-match form env cx fuel)
    (= op 322) (ev-vector-f64-get form env cx fuel)
    :else
    (let [base (cond (or (< op 310) (>= op 320)) 1 (= op 312) 3 :else 2)
          ;; hetero-vector-assoc evaluates arguments 2 and 4 (3 is the literal index):
          ;; argument 3 is evaluated too (an integer literal: no fuel, no trap)
          to (cond (= op 312) 4 (or (= op 311) (or (= op 315) (= op 317))) 3 :else (form/count-of form))
          ar (ev-args-range form base to env cx fuel)]
      (if (not (= 0 (o-kind ar)))
        ar
        (let [xs (kv/kids-of (o-value ar))
              fu (o-st ar)]
          (cond
            (< op 310) (ev-pair op xs fu)
            (>= op 320)
            (if (and (>= (vf-arity op) 0) (not (= (vf-arity op) (vector-count xs))))
              (r-trap fu "arity-mismatch")
              (ev-vector-f64 op xs fu))
            (= op 310) (mk-record (form/nth-of form 1) xs fu)
            (= op 314) (hetero-new (form/nth-of form 1) xs fu)
            (= op 316) (set-new (form/nth-of form 1) xs fu)
            (= op 312) (mk-variant (form/nth-of form 1) (form/nth-of form 2) (arg-v xs 0) fu)
            (= op 318) (hetero-assoc form (arg-v xs 0) (arg-v xs 2) fu)
            :else (typed-read op form (arg-v xs 0) fu)))))))

;; ---- calls ----

(defn- loop-helper-name? [s :string] :bool
  (let [n (string-byte-length s)]
    (and (> n 14)
         (string=? (string-substring s 0 14) "__kotoba_loop_")
         (loop [i 14]
           (if (>= i n) true
             (let [c (string-code-point-at s i)]
               (if (and (>= c 48) (<= c 57)) (recur (inc i)) false)))))))

(defn- env-of-params [params [:ref :form/r] vals [:list [:ref :kir/v]]] [:list [:ref :kir/v]]
  (let [n (form/count-of params)]
    (loop [i 0 env (kv/no-values)]
      (if (>= i n) env
        (recur (inc i) (env-bind env (form/symbol-value (form/nth-of params i))
                                 (typed-list-nth [:list [:ref :kir/v]] vals i)))))))

;; ---- pairs (the host's `allocate-pair!` / `read-pair` over the run's heap) ----

(defn- pair-capacity [] :i64 4096)  ; kotoba.kir default-pair-capacity

(defn- pair-handle-ok? [st [:ref :kir.interp/st] h [:ref :kir/v]] :bool
  (and (i64? h) (and (> (kv/n-of h) 0) (<= (kv/n-of h) (quot (vector-count (st-heap st)) 2)))))

;; Slot 0 or 1 of pair H; the caller has checked the handle.
(defn- pair-slot [st [:ref :kir.interp/st] h [:ref :kir/v] slot :i64] [:ref :kir/v]
  (typed-list-nth [:list [:ref :kir/v]] (st-heap st) (+ (* 2 (- (kv/n-of h) 1)) slot)))

(defn- read-pair [st [:ref :kir.interp/st] h [:ref :kir/v] slot :i64] [:ref :kir.interp/out]
  (if (pair-handle-ok? st h)
    (r-val (pair-slot st h slot) st)
    (r-trap st "invalid-pair-handle")))

(defn- allocate-pair [st [:ref :kir.interp/st] left [:ref :kir/v] right [:ref :kir/v]] [:ref :kir.interp/out]
  (let [heap (st-heap st)
        index (quot (vector-count heap) 2)]
    (if (>= index (pair-capacity))
      (r-trap st "budget/cells")
      (let [st1 (mk-st (st-fuel st) (kv/append-value (kv/append-value heap left) right))]
        (r-val (kv/i64-value (+ index 1)) st1)))))

;; i64 zero: the end of a capture chain / pair chain (the host's `k-zero?`).
(defn- chain-end? [v [:ref :kir/v]] :bool (and (i64? v) (= 0 (kv/n-of v))))

;; `validate-closure-handle!`: "" or the trap name.
(defn- closure-trap [st [:ref :kir.interp/st] h [:ref :kir/v]] :string
  (cond
    (not (pair-handle-ok? st h)) "invalid-pair-handle"
    (not (i64? (pair-slot st h 0))) "value-type-mismatch"
    :else
    (loop [chain (pair-slot st h 1) k 0]
      (cond
        (chain-end? chain) ""
        (>= k 5) "invalid-closure-capture-chain"
        (not (pair-handle-ok? st chain)) "invalid-pair-handle"
        :else (recur (pair-slot st chain 1) (inc k))))))

;; `validate-i64-pair-chain!`: "" or the trap name.
(defn- pair-chain-trap [st [:ref :kir.interp/st] h [:ref :kir/v]] :string
  (loop [chain h k 0]
    (cond
      (chain-end? chain) ""
      (>= k 4) "i64-pair-chain-limit"
      (not (pair-handle-ok? st chain)) "invalid-pair-handle"
      (not (i64? (pair-slot st chain 0))) "value-type-mismatch"
      :else (recur (pair-slot st chain 1) (inc k)))))

(defn- index-listed? [ixs [:ref :form/r] i :i64] :bool
  (and (form/is-vec? ixs)
       (loop [j 0]
         (if (>= j (form/count-of ixs)) false
           (if (= i (form/int-value (form/nth-of ixs j))) true (recur (inc j)))))))

;; `validate-runtime-value!`: "" or the trap name. A `[:ref S]` names a schema of
;; the module (else unknown-schema-reference) and the value's own nominal type.
(defn- runtime-trap [ty [:ref :form/r] v [:ref :kir/v] cx [:ref :kir.interp/cx]] :string
  (cond
    (and (= (desc-head ty) :ref) (not (form/form-has? (cx-schemas cx) (form/nth-of ty 1))))
    "unknown-schema-reference"
    (type-ok? ty v) ""
    :else "value-type-mismatch"))

;; The parameter checks of `invoke-function`, parameter by parameter in order:
;; the declared type, then a closure handle, then an i64 pair chain. "" or the trap.
(defn- params-trap [f [:ref :form/r] pts [:ref :form/r] vals [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] st [:ref :kir.interp/st]] :string
  (let [n (vector-count vals)
        typed? (form/is-vec? pts)
        cl (fget f :closure-param-indexes)
        pc (fget f :i64-pair-chain-param-indexes)]
    (loop [i 0]
      (if (>= i n) ""
        (let [v (typed-list-nth [:list [:ref :kir/v]] vals i)
              t1 (runtime-trap (if typed? (form/nth-of pts i) (kw :i64)) v cx)
              t2 (if (and (string=? t1 "") (index-listed? cl i)) (closure-trap st v) t1)
              t3 (if (and (string=? t2 "") (index-listed? pc i)) (pair-chain-trap st v) t2)]
          (if (string=? t3 "") (recur (inc i)) t3))))))

(defn- result-type [f [:ref :form/r]] [:ref :form/r]
  (let [r (fget f :result)]
    (if (form/is-nil? r) (kw :i64) r)))

(defn- closure-result? [f [:ref :form/r]] :bool
  (form/is-true? (fget f :closure-result?)))

;; One interpreted call (the host `invoke-function`): arity, parameter checks,
;; frame budget, fuel (once, on first entry), the body, then the result checks.
;; A self-tail call of a loop helper re-enters this loop at the same depth and
;; without charging fuel. The function never changes across the loop (only a
;; self-tail call re-enters), so its parts are read once.
(defn- invoke [f [:ref :form/r] args0 [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel0 [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [fname (form/symbol-value (fget f :name))
        params (fget f :params)
        pts (fget f :param-types)
        body (fget f :body)
        rty (result-type f)
        cres? (closure-result? f)
        depth (+ 1 (cx-depth cx))
        cx1 (mk-cx (cx-fns cx) (cx-schemas cx) (cx-frames cx) fname depth)]
    (loop [vals args0 fu fuel0 charge? true]
      (let [pt (if (= (form/count-of params) (vector-count vals)) (params-trap f pts vals cx fu) "")]
        (cond
          (not (= (form/count-of params) (vector-count vals))) (r-trap fu "arity-mismatch")
          (not (string=? pt "")) (r-trap fu pt)
          (> depth (cx-frames cx)) (r-trap fu "budget/frames")
          (and charge? (< (- (st-fuel fu) 1) 0)) (r-trap (st-charge fu) "budget/fuel")
          :else
          (let [r (ev body (env-of-params params vals) cx1 (if charge? (st-charge fu) fu))]
            (cond
              (= 2 (o-kind r)) (recur (kv/kids-of (o-value r)) (o-st r) false)
              (= 1 (o-kind r)) r
              :else
              (let [rt (runtime-trap rty (o-value r) cx)
                    rt2 (if (and (string=? rt "") cres?) (closure-trap (o-st r) (o-value r)) rt)]
                (if (string=? rt2 "") r (r-trap (o-st r) rt2))))))))))

(defn- ev-call [name :string form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [ar (ev-args form env cx fuel)]
    (if (not (= 0 (o-kind ar)))
      ar
      (let [vals (kv/kids-of (o-value ar))
            fu (o-st ar)
            at (find-fn (cx-fns cx) name)]
        (cond
          (< at 0) (r-trap fu "unknown-function")
          (and (string=? name (cx-fname cx)) (loop-helper-name? name))
          (mk-res 2 (kv/vector-value vals) fu "")
          :else (invoke (typed-list-nth [:list [:ref :form/r]] (form/kids-of (cx-fns cx)) at) vals cx fu))))))

;; Arguments then the operation, for the operations that are functions of their
;; evaluated arguments.
(defn- ev-builtin [op :i64 form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [ar (ev-args form env cx fuel)]
    (if (not (= 0 (o-kind ar)))
      ar
      (let [xs (kv/kids-of (o-value ar))
            fu (o-st ar)]
        (cond
          (<= op 9) (ev-arith op xs fu)
          (<= op 14) (ev-compare op xs fu)
          (>= op 40) (ev-string op xs fu)
          (= op 28)
          (if (= 1 (vector-count xs))
            (r-val (kv/bool-value (false-value? (typed-list-nth [:list [:ref :kir/v]] xs 0))) fu)
            (r-trap fu "arity-mismatch"))
          :else (ev-unary-or-shift op xs fu))))))

(defn- ev-bytes-call [op :i64 form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [ar (ev-args form env cx fuel)]
    (if (not (= 0 (o-kind ar)))
      ar
      (ev-bytes op (kv/kids-of (o-value ar)) (o-st ar)))))

(defn- ev-float-call [op :i64 form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [ar (ev-args form env cx fuel)]
    (if (not (= 0 (o-kind ar)))
      ar
      (ev-float op (kv/kids-of (o-value ar)) (o-st ar)))))

;; A map key as the host takes it: a keyword, or a document (a keyword node is
;; the same key). 0 the key is a keyword (KV), 1 a keyword node, 2 another
;; document (its order is `document-map-key-compare`, not ported: refused),
;; 3 not a document (the host's `bounded-document!` throws).
(defn- key-kind [v [:ref :kir/v]] :i64
  (cond
    (= 5 (kv/tag-of v)) 0
    (and (doc? v) (doc-tag? v "keyword")) 1
    (doc? v) 2
    :else 3))

(defn- as-key [v [:ref :kir/v]] [:ref :kir/v] (if (= 1 (key-kind v)) (kv/nth-of v 0) v))

;; "" when every key of a document-map operand list is a keyword or a keyword node
(defn- map-keys-trap [xs [:list [:ref :kir/v]]] :string
  (loop [j 0]
    (if (>= j (vector-count xs)) ""
      (let [k (key-kind (arg-v xs j))]
        (cond (= k 2) "interpreter-limit"
              (= k 3) "value-type-mismatch"
              :else (recur (+ j 2)))))))

(defn- keys-normalised [xs [:list [:ref :kir/v]]] [:list [:ref :kir/v]]
  (loop [j 0 acc (kv/no-values)]
    (if (>= j (vector-count xs)) acc
      (recur (inc j) (kv/append-value acc (if (= 0 (rem j 2)) (as-key (arg-v xs j)) (arg-v xs j)))))))

;; document-contains / -get / -assoc / -dissoc in the host's order: the document,
;; the map check, then the key, then (assoc) the item.
(defn- ev-document-keyed [op :i64 form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (if (not (= (form/count-of form) (+ 1 (doc-arity op))))
    (r-trap fuel "arity-mismatch")
    (let [dr (ev-operand (form/nth-of form 1) env cx fuel)]
      (cond
        (not (= 0 (o-kind dr))) dr
        (not (doc? (o-value dr))) (mismatch (o-st dr))
        (not (doc-tag? (o-value dr) "map")) (r-trap (o-st dr) "document-map-required")
        :else
        (let [kr (ev-operand (form/nth-of form 2) env cx (o-st dr))]
          (cond
            (not (= 0 (o-kind kr))) kr
            (= 2 (key-kind (o-value kr))) (r-trap (o-st kr) "interpreter-limit")
            (= 3 (key-kind (o-value kr))) (mismatch (o-st kr))
            (not (= op 221))
            (ev-document op (kv/two-values (o-value dr) (as-key (o-value kr))) (o-st kr))
            :else
            (let [ir (ev-operand (form/nth-of form 3) env cx (o-st kr))]
              (if (not (= 0 (o-kind ir)))
                ir
                (ev-document op (kv/append-value (kv/two-values (o-value dr) (as-key (o-value kr))) (o-value ir))
                             (o-st ir))))))))))

(defn- ev-document-call [op :i64 form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (if (doc-key-op? op)
    (if (= op 208)
      (let [ar (ev-args form env cx fuel)]
        (if (not (= 0 (o-kind ar)))
          ar
          (let [xs (kv/kids-of (o-value ar))
                t (if (= 0 (rem (vector-count xs) 2)) (map-keys-trap xs) "")]
            (if (string=? t "")
              (ev-document op (if (= 0 (rem (vector-count xs) 2)) (keys-normalised xs) xs) (o-st ar))
              (r-trap (o-st ar) t)))))
      (ev-document-keyed op form env cx fuel))
    (let [ar (ev-args form env cx fuel)]
      (if (not (= 0 (o-kind ar)))
        ar
        (ev-document op (kv/kids-of (o-value ar)) (o-st ar))))))

(defn- ev-list [form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [head (form/first-of form)]
    (if (not (form/is-symbol? head))
      (r-trap fuel "unknown-function")
      (let [name (form/symbol-value head)]
        ;; A constructor (the host's `cell-constructor-ops`, generated as
        ;; `constructor-op-name?`) debits one unit of fuel before its operands
        ;; are evaluated, as the host's `eval-expr` does (amu ADR 0353 point 7).
        (if (constructor-op-name? name)
          (if (< (- (st-fuel fuel) 1) 0)
            (r-trap (st-charge fuel) "budget/fuel")
            (ev-head name (op-code name) form env cx (st-charge fuel)))
          (ev-head name (op-code name) form env cx fuel))))))

(defn- ev-head [name :string op :i64 form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
        (cond
          (= op 29) (ev-let-from (form/nth-of form 1) 0 env (form/nth-of form 2) cx fuel)
          (= op 30)
          (let [t (ev-operand (form/nth-of form 1) env cx fuel)]
            (if (= 0 (o-kind t))
              (ev (if (false-value? (o-value t)) (form/nth-of form 3) (form/nth-of form 2)) env cx (o-st t))
              t))
          (= op 31) (ev-do-from form 1 env cx fuel)
          (= op 32) (ev (form/nth-of form 1) env cx fuel)
          (>= op 300) (ev-typed op form env cx fuel)
          (>= op 200) (ev-document-call op form env cx fuel)
          (>= op 120) (ev-float-call op form env cx fuel)
          (>= op 100) (ev-bytes-call op form env cx fuel)
          (>= op 60) (ev-agg op form env cx fuel)
          (> op 0) (ev-builtin op form env cx fuel)
          :else (ev-call name form env cx fuel)))

(defn- ev-symbol [form [:ref :form/r] env [:list [:ref :kir/v]] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [at (env-index env (form/symbol-value form))]
    (if (< at 0)
      (r-trap fuel "unbound-symbol")
      (r-val (typed-list-nth [:list [:ref :kir/v]] env (+ at 1)) fuel))))

(defn- ev [form [:ref :form/r] env [:list [:ref :kir/v]] cx [:ref :kir.interp/cx] fuel [:ref :kir.interp/st]] [:ref :kir.interp/out]
  (let [t (form/tag-of form)]
    (cond
      (= t 2) (r-val (kv/i64-value (form/int-value form)) fuel)
      (= t 1) (r-val (kv/bool-value (form/bool-value form)) fuel)
      (= t 3) (r-val (kv/string-value (form/string-value form)) fuel)
      (= t 5) (ev-symbol form env fuel)
      (= t 4) (r-val (kv/keyword-value (form/keyword-value form)) fuel)
      (= t 10) (r-val (kv/f64-value (form/bits-of form)) fuel)
      (= t 6) (if (= 0 (form/count-of form)) (r-trap fuel "unknown-function") (ev-list form env cx fuel))
      :else (r-trap fuel "unsupported-form"))))

;; ---- entry points ----

;; `box-bool`: the value that leaves a :bool function is a boolean.
(defn- boxed [f [:ref :form/r] r [:ref :kir.interp/out]] [:ref :kir.interp/out]
  (if (and (= 0 (o-kind r))
           (form/eq (result-type f) (kw :bool))
           (i64? (o-value r)))
    (r-val (kv/bool-value (not (= 0 (kv/n-of (o-value r))))) (o-st r))
    r))

;; An entry result that is a typed aggregate has no Form the host would recognise
;; (its value is the host's own tagged vector): refused, never answered.
(defn- unboxable [r [:ref :kir.interp/out]] [:ref :kir.interp/out]
  (if (and (= 0 (o-kind r)) (typed? (o-value r)))
    (r-trap (o-st r) "interpreter-limit")
    r))

(defn run
  "Execute function NAME of the KIR module KIR (a Form) over ARGS (Values) with
  FUEL function entries and FRAMES call depth. Answers the result record."
  [kir [:ref :form/r] name :string args [:list [:ref :kir/v]] fuel :i64 frames :i64] [:ref :kir.interp/res]
  (let [fns (fget kir :functions)
        at (find-fn fns name)]
    (public-res
     (if (< at 0)
       (r-trap (mk-st fuel (kv/no-values)) "unknown-function")
       (let [f (typed-list-nth [:list [:ref :form/r]] (form/kids-of fns) at)]
         (unboxable (boxed f (invoke f args (mk-cx fns (fget kir :schemas) frames "" 0) (mk-st fuel (kv/no-values))))))))))

(defn eval-form
  "Evaluate one closed KIR form (no functions, no bindings)."
  [form [:ref :form/r] fuel :i64 frames :i64] [:ref :kir.interp/res]
  (public-res (unboxable (ev-operand form (kv/no-values) (mk-cx (form/form-vec (form/no-forms)) (form/nil-form) frames "" 0)
                                     (mk-st fuel (kv/no-values))))))

;; ---- which modules this interpreter answers ----

(defn- fn-name-in? [fns [:ref :form/r] name :string] :bool
  (>= (find-fn fns name) 0))

(defn- all-expr-ok? [form [:ref :form/r] from :i64 fns [:ref :form/r]] :bool
  (let [n (form/count-of form)]
    (loop [i from]
      (if (>= i n) true
        (if (expr-ok? (form/nth-of form i) fns) (recur (inc i)) false)))))

(defn- let-ok? [form [:ref :form/r] fns [:ref :form/r]] :bool
  (let [bs (form/nth-of form 1)]
    (and (= 3 (form/count-of form))
         (form/is-vec? bs)
         (= 0 (rem (form/count-of bs) 2))
         (loop [i 0]
           (if (>= i (form/count-of bs)) true
             (if (and (form/is-symbol? (form/nth-of bs i)) (expr-ok? (form/nth-of bs (+ i 1)) fns))
               (recur (+ i 2))
               false)))
         (expr-ok? (form/nth-of form 2) fns))))

(defn- doc-key-op? [op :i64] :bool
  (or (= op 208) (or (= op 219) (or (= op 220) (or (= op 221) (= op 222))))))

;; An f64 literal is ported only when it has a fractional part. The host on nbb
;; reads an integral float literal (2.0, 1e20, -0.0) as an INTEGER (its
;; `integer?` admits it before `f64-value?` is asked), which this route cannot
;; follow without a decision; such a module stays unported.
(defn- fraction-literal? [bits :i64] :bool
  (let [x (f64-from-bits bits)]
    (and (f64-truncatable? x) (not (f64-integral? x)))))

(defn- expr-ok? [form [:ref :form/r] fns [:ref :form/r]] :bool
  (let [t (form/tag-of form)]
    (cond
      (or (= t 1) (or (= t 2) (or (= t 3) (or (= t 4) (= t 5))))) true
      (= t 10) (fraction-literal? (form/bits-of form))
      (= t 6)
      (if (and (> (form/count-of form) 0) (form/is-symbol? (form/first-of form)))
        (let [name (form/symbol-value (form/first-of form))]
          (cond
            (string=? name "let") (let-ok? form fns)
            (string=? name "if") (and (= 4 (form/count-of form)) (all-expr-ok? form 1 fns))
            (string=? name "do") (and (> (form/count-of form) 1) (all-expr-ok? form 1 fns))
            (string=? name "arena-scope") (and (= 2 (form/count-of form)) (all-expr-ok? form 1 fns))
            (and (ported-op? name) (agg-typed? (op-code name)))
            (and (> (form/count-of form) 1)
                 (desc-ok? (form/nth-of form 1))
                 (desc-shape-ok? (op-code name) (form/nth-of form 1))
                 (all-expr-ok? form 2 fns))
            (>= (op-code name) 310) (typed-form-ok? (op-code name) form fns)
            (ported-op? name) (all-expr-ok? form 1 fns)
            :else (and (fn-name-in? fns name) (all-expr-ok? form 1 fns))))
        false)
      :else false)))

(defn- desc-ok? [ty [:ref :form/r]] :bool
  (if (form/is-keyword? ty)
    (let [k (form/keyword-value ty)]
      (or (= k :i64) (or (= k :bool) (or (= k :string) (or (= k :bytes) (or (= k :keyword) (or (= k :document) (or (= k :f64) (or (= k :f32) (or (= k :vector-i64) (or (= k :option-i64) (or (= k :result-i64) (= k :vector-f64)))))))))))))
    (let [h (desc-head ty)
          n (form/count-of ty)]
      (cond
        (= h :option) (and (= n 2) (desc-ok? (form/nth-of ty 1)))
        (= h :list) (and (= n 2) (desc-ok? (form/nth-of ty 1)))
        (= h :result) (and (= n 3) (and (desc-ok? (form/nth-of ty 1)) (desc-ok? (form/nth-of ty 2))))
        (= h :ref) (and (= n 2) (nominal-name? (form/nth-of ty 1)))
        (or (= h :record) (= h :variant))
        (and (= n 3) (nominal-name? (form/nth-of ty 1)) (entries-ok? (form/nth-of ty 2)))
        (= h :vector)
        (and (= n 2) (form/is-vec? (form/nth-of ty 1)) (all-desc-ok? (form/nth-of ty 1)))
        (= h :set)
        (and (= n 2) (form/is-keyword? (form/nth-of ty 1))
             (or (= (form/keyword-value (form/nth-of ty 1)) :i64) (= (form/keyword-value (form/nth-of ty 1)) :keyword)))
        :else false))))

;; a namespaced keyword (the host's `schema-ref-type?` / nominal descriptor name)
(defn- nominal-name? [k [:ref :form/r]] :bool
  (and (form/is-keyword? k) (form/keyword-has-namespace? k)))

(defn- all-desc-ok? [tys [:ref :form/r]] :bool
  (loop [i 0]
    (if (>= i (form/count-of tys)) true
      (if (desc-ok? (form/nth-of tys i)) (recur (inc i)) false))))

;; [[k T] ..] with keyword keys, each T a ported descriptor
(defn- entries-ok? [es [:ref :form/r]] :bool
  (and (form/is-vec? es)
       (loop [i 0]
         (if (>= i (form/count-of es)) true
           (let [e (form/nth-of es i)]
             (if (and (form/is-vec? e) (= 2 (form/count-of e)) (form/is-keyword? (form/nth-of e 0))
                      (desc-ok? (form/nth-of e 1)))
               (recur (inc i))
               false))))))

;; The forms of operations 310-327: the descriptor (argument 1) has the kind the
;; operation reads, raw operands are literals of the right kind, the rest are
;; ported expressions. vector-f64-* take no descriptor.
(defn- typed-form-ok? [op :i64 form [:ref :form/r] fns [:ref :form/r]] :bool
  (let [n (form/count-of form)
        ty (if (> n 1) (form/nth-of form 1) (form/nil-form))
        h (desc-head ty)]
    (cond
      (>= op 320) (all-expr-ok? form 1 fns)
      (not (desc-ok? ty)) false
      (= op 310) (and (= h :record) (all-expr-ok? form 2 fns))
      (= op 311) (and (= h :record) (= n 4) (expr-ok? (form/nth-of form 2) fns) (form/is-keyword? (form/nth-of form 3)))
      (= op 312) (and (= h :variant) (= n 4) (form/is-keyword? (form/nth-of form 2)) (expr-ok? (form/nth-of form 3) fns))
      (= op 313) (and (= h :variant) (= n 4) (expr-ok? (form/nth-of form 2) fns) (branches-ok? (form/nth-of form 3) fns))
      (= op 314) (and (= h :vector) (all-expr-ok? form 2 fns))
      (= op 315) (and (= h :vector) (= n 4) (expr-ok? (form/nth-of form 2) fns)
                      (form/is-int? (form/nth-of form 3)) (>= (form/int-value (form/nth-of form 3)) 0))
      (= op 316) (and (= h :set) (all-expr-ok? form 2 fns))
      (= op 318) (and (= h :vector) (= n 5) (expr-ok? (form/nth-of form 2) fns)
                      (form/is-int? (form/nth-of form 3)) (>= (form/int-value (form/nth-of form 3)) 0)
                      (expr-ok? (form/nth-of form 4) fns))
      (= op 317) (and (= h :set) (= n 3) (expr-ok? (form/nth-of form 2) fns))
      :else false)))

;; variant-match branches: a vector of [tag binder body]
(defn- branches-ok? [bs [:ref :form/r] fns [:ref :form/r]] :bool
  (and (form/is-vec? bs)
       (loop [i 0]
         (if (>= i (form/count-of bs)) true
           (let [b (form/nth-of bs i)]
             (if (and (form/is-vec? b) (= 3 (form/count-of b)) (form/is-keyword? (form/nth-of b 0))
                      (form/is-symbol? (form/nth-of b 1)) (expr-ok? (form/nth-of b 2) fns))
               (recur (inc i))
               false))))))

(defn- desc-shape-ok? [op :i64 ty [:ref :form/r]] :bool
  (let [h (desc-head ty)]
    (cond
      (<= op 64) (= h :option)
      (<= op 70) (= h :result)
      :else (= h :list))))

(defn- type-word-ok? [ty [:ref :form/r]] :bool (desc-ok? ty))

(defn- types-ok? [pts [:ref :form/r]] :bool
  (or (form/is-nil? pts)
      (and (form/is-vec? pts)
           (loop [i 0]
             (if (>= i (form/count-of pts)) true
               (if (type-word-ok? (form/nth-of pts i)) (recur (inc i)) false))))))

(defn- params-ok? [ps [:ref :form/r]] :bool
  (and (form/is-list-like? ps)
       (loop [i 0]
         (if (>= i (form/count-of ps)) true
           (if (form/is-symbol? (form/nth-of ps i)) (recur (inc i)) false)))))

(defn- fn-name-ok? [f [:ref :form/r]] :bool
  (and (form/is-symbol? (fget f :name))
       (not (ported-op? (form/symbol-value (fget f :name))))
       (not (host-op-name? (form/symbol-value (fget f :name))))))

(defn- all-names-ok? [fns [:ref :form/r]] :bool
  (let [n (form/count-of fns)]
    (loop [j 0]
      (if (>= j n) true
        (if (fn-name-ok? (form/nth-of fns j)) (recur (inc j)) false)))))

(defn- fn-ok? [f [:ref :form/r] fns [:ref :form/r]] :bool
  (and (params-ok? (fget f :params))
       (types-ok? (fget f :param-types))
       (or (form/is-nil? (fget f :result)) (type-word-ok? (fget f :result)))
       (or (not (form/form-has? f (kw :closure-param-indexes))) (index-vector-ok? (fget f :closure-param-indexes)))
       (or (not (form/form-has? f (kw :i64-pair-chain-param-indexes))) (index-vector-ok? (fget f :i64-pair-chain-param-indexes)))
       (or (not (form/form-has? f (kw :closure-result?))) (form/is-true? (fget f :closure-result?)))
       (expr-ok? (fget f :body) fns)))

;; A refinement index vector (validated by `lower` before the oracle runs).
(defn- index-vector-ok? [ixs [:ref :form/r]] :bool
  (and (form/is-vec? ixs)
       (loop [i 0]
         (if (>= i (form/count-of ixs)) true
           (if (form/is-int? (form/nth-of ixs i)) (recur (inc i)) false)))))

(defn- all-fns-ok? [fns [:ref :form/r] i :i64] :bool
  (let [n (form/count-of fns)]
    (loop [j i]
      (if (>= j n) true
        (if (fn-ok? (form/nth-of fns j) fns) (recur (inc j)) false)))))

(defn ported?
  "True when every function of the KIR module KIR (a Form) is inside the ported
  subset: :i64 / :bool parameters and result, bodies built only from integer
  and boolean literals, symbols, the operations this file implements, and calls
  of the module's own functions. Anything else is answered by the caller's
  named refusal, never by this interpreter."
  [kir [:ref :form/r]] :bool
  (let [fns (fget kir :functions)]
    (and (form/is-vec? fns) (all-names-ok? fns) (all-fns-ok? fns 0))))

(defn form-ported?
  "True when the closed KIR form FORM (no functions in scope) is inside the ported subset."
  [form [:ref :form/r]] :bool
  (expr-ok? form (form/form-vec (form/no-forms))))
