(ns kotoba.kir.float-usage
  {:kotoba/export [float-use-mask uses-f32? uses-f64?]})

;; This is the bounded Kotoba port of kotoba.kir/uses-f32? and uses-f64?.
;; A negative mask means the KIR body exceeded the scan budget and the caller
;; must refuse instead of guessing a value ABI.
(def float-scan-node-limit 262144)

(def f64-operations
  (document-set
    (document-symbol (symbol "f64-to-bits"))
    (document-symbol (symbol "f64-from-bits"))
    (document-symbol (symbol "f64-add"))
    (document-symbol (symbol "f64-sub"))
    (document-symbol (symbol "f64-mul"))
    (document-symbol (symbol "f64-div"))
    (document-symbol (symbol "f64-min"))
    (document-symbol (symbol "f64-max"))
    (document-symbol (symbol "f64-neg"))
    (document-symbol (symbol "f64-abs"))
    (document-symbol (symbol "f64-sqrt"))
    (document-symbol (symbol "f64-sin-quarter-turn"))
    (document-symbol (symbol "f64-cos-quarter-turn"))
    (document-symbol (symbol "f64-sin-bounded"))
    (document-symbol (symbol "f64-cos-bounded"))
    (document-symbol (symbol "f64-exp-near-zero"))
    (document-symbol (symbol "f64-log-near-one"))
    (document-symbol (symbol "f64-atan2-bounded"))
    (document-symbol (symbol "f64-exp-bounded"))
    (document-symbol (symbol "f64-log-bounded"))
    (document-symbol (symbol "f64-eq"))
    (document-symbol (symbol "f64-lt"))
    (document-symbol (symbol "f64-le"))
    (document-symbol (symbol "f64-gt"))
    (document-symbol (symbol "f64-ge"))
    (document-symbol (symbol "f64-unordered"))
    (document-symbol (symbol "i64-to-f64-checked"))
    (document-symbol (symbol "i64-to-f64-rounded"))
    (document-symbol (symbol "f64-to-i64-checked"))
    (document-symbol (symbol "f64-to-i64-truncating"))))

(def f32-operations
  (document-set
    (document-symbol (symbol "f32-to-bits"))
    (document-symbol (symbol "f32-from-bits"))
    (document-symbol (symbol "f64-to-f32-rounded"))
    (document-symbol (symbol "f32-to-f64-exact"))
    (document-symbol (symbol "f32-add"))
    (document-symbol (symbol "f32-sub"))
    (document-symbol (symbol "f32-mul"))
    (document-symbol (symbol "f32-div"))
    (document-symbol (symbol "f32-min"))
    (document-symbol (symbol "f32-max"))
    (document-symbol (symbol "f32-neg"))
    (document-symbol (symbol "f32-abs"))
    (document-symbol (symbol "f32-sqrt"))
    (document-symbol (symbol "f32-eq"))
    (document-symbol (symbol "f32-lt"))
    (document-symbol (symbol "f32-le"))
    (document-symbol (symbol "f32-gt"))
    (document-symbol (symbol "f32-ge"))
    (document-symbol (symbol "f32-unordered"))
    (document-symbol (symbol "i64-to-f32-checked"))
    (document-symbol (symbol "i64-to-f32-rounded"))
    (document-symbol (symbol "f32-to-i64-checked"))
    (document-symbol (symbol "f32-to-i64-truncating"))))

(defn- field [value :document key :keyword] :document
  (option-value-of [:option :document] (document-get value key) (document-null)))

(defn- set-contains? [values :document value :document] :bool
  (loop [index 0]
    (if (= index (document-count values)) false
      (if (document-equal? (option-value-of [:option :document]
                              (document-set-at values index) (document-null)) value)
        true
        (recur (+ index 1))))))

(defn- merge-mask [left :i64 right :i64] :i64
  (if (or (< left 0) (< right 0)) -1
    (if (or (= left 3) (= right 3)) 3
      (if (= left 0) right
        (if (= right 0) left
          (if (= left right) left 3))))))

(defn- type-mask [value :document] :i64
  (if (document-equal? value (document-keyword :f32)) 1
    (if (document-equal? value (document-keyword :f64)) 2 0)))

(defn- param-type-mask [values :document] :i64
  (if (not (= (document-kind values) :vector)) 0
    (loop [index 0 mask 0]
      (if (= index (document-count values)) mask
        (recur (+ index 1)
          (merge-mask mask
            (type-mask (option-value-of [:option :document]
                         (document-vector-at values index) (document-null)))))))))

(defn- collection-child-count [value :document] :i64
  (let [kind (document-kind value)]
    (if (or (= kind :vector) (= kind :list) (= kind :set) (= kind :map))
      (document-count value)
      0)))

(defn- collection-child-at [value :document index :i64] :document
  (let [kind (document-kind value)]
    (if (= kind :vector)
      (option-value-of [:option :document] (document-vector-at value index) (document-null))
      (if (= kind :list)
        (option-value-of [:option :document] (document-list-at value index) (document-null))
        (if (= kind :set)
          (option-value-of [:option :document] (document-set-at value index) (document-null))
          (if (= kind :map)
            (option-value-of [:option :document] (document-map-entry-at value index) (document-null))
            (document-null)))))))

(defn- form-operation-mask [value :document] :i64
  (if (not (= (document-kind value) :list)) 0
    (if (= (document-count value) 0) 0
      (let [operation (option-value-of [:option :document]
                        (document-list-at value 0) (document-null))]
        (if (set-contains? f32-operations operation) 1
          (if (set-contains? f64-operations operation) 2 0))))))

(defn- body-operation-mask [body :document] :i64
  (loop [work (document-vector body) cursor 0 mask 0]
    (if (= cursor (document-count work)) mask
      (if (>= cursor float-scan-node-limit) -1
        (let [node (option-value-of [:option :document]
                     (document-vector-at work cursor) (document-null))
              child-count (collection-child-count node)
              operation-mask (form-operation-mask node)
              next-mask (merge-mask mask operation-mask)]
          (if (= next-mask 3) 3
            (if (> (+ (document-count work) child-count) float-scan-node-limit) -1
              (let [next-work
                    (loop [child-index 0 acc work]
                      (if (= child-index child-count) acc
                        (recur (+ child-index 1)
                          (document-vector-conj acc (collection-child-at node child-index)))))]
                (recur next-work (+ cursor 1) next-mask)))))))))

(defn float-use-mask [program :document] :i64
  (let [functions (field program :functions)]
    (if (not (= (document-kind functions) :vector)) 0
      (if (> (document-count functions) 65536) -1
        (loop [index 0 mask 0]
          (if (= index (document-count functions)) mask
            (let [function (option-value-of [:option :document]
                             (document-vector-at functions index) (document-null))
                  types (merge-mask (param-type-mask (field function :param-types))
                                    (type-mask (field function :result)))
                  body (body-operation-mask (field function :body))
                  next-mask (merge-mask mask (merge-mask types body))]
              (if (or (< next-mask 0) (= next-mask 3)) next-mask
                (recur (+ index 1) next-mask)))))))))

(defn uses-f32? [program :document] :bool
  (let [mask (float-use-mask program)]
    (or (= mask 1) (= mask 3))))

(defn uses-f64? [program :document] :bool
  (let [mask (float-use-mask program)]
    (or (= mask 2) (= mask 3))))
