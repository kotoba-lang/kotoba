(ns kotoba.kir.kvalue
  "The typed dynamic Value of the Kotoba route: what the KIR interpreter and the
  lowering walk, as ONE closed nominal record that refers to itself, so it is
  unbounded in depth and in width and needs no host.

  It is the sibling of `kotoba.form`. A Form is untyped s-expression SYNTAX
  (nil bool int string keyword symbol list vector set map, plus f64/bytes
  leaves). A Value is the interpreter's RUNTIME domain, which also has the
  typed aggregates a program builds: record, variant, option, result, and the
  heap handles (pair / closure / kgraph cells) that KIR passes as i64 words.
  `from-form` injects plain data (a Form) into a Value; `to-form` erases a Value
  back to a Form (typed aggregates become tagged vectors, see `to-form`).

  Kotoba-only, like kotoba.form: the host interpreter walks real Clojure
  values (maps, bigints, atoms), so a module that wants this requires it under
  `#?(:kotoba ...)` and declares the same `:kir/v` schema (one type, because
  schemas compare structurally).

  Fields: tag (below), n (bool 0/1, i64, f64 bits, option/result arm, handle
  id), s (string / symbol / record type / variant tag / handle arena), k
  (keyword), b (bytes), kids (list / vector / set items, map k v k v ..., record
  field-key/value pairs, variant payload items, option/result payload).

  Tags: 0 nil, 1 bool, 2 i64, 3 f64 (n holds the IEEE-754 bits), 4 string,
  5 keyword, 6 symbol, 7 bytes, 8 list, 9 vector, 10 map, 11 set, 12 record
  (s = type name, kids = key value key value ...), 13 variant (s = case name,
  kids = payload), 14 option (n = 0 none / 1 some, kids = [] / [x]),
  15 result (n = 0 ok / 1 err, kids = [x]), 16 handle (n = id, s = arena)."
  {:kotoba/export [tag-nil tag-bool tag-i64 tag-f64 tag-string tag-keyword tag-symbol
                   tag-bytes tag-list tag-vector tag-map tag-set tag-record tag-variant
                   tag-option tag-result tag-handle
                   no-values one-value two-values append-value
                   nil-value bool-value i64-value f64-value string-value keyword-value
                   symbol-value bytes-value list-value vector-value map-value set-value
                   record-value variant-value none-value some-value ok-value err-value
                   handle-value
                   tag-of n-of s-of k-of b-of kids-of count-of nth-of
                   is-nil? is-bool? is-i64? is-f64? is-string? is-keyword? is-symbol?
                   is-bytes? is-list? is-vector? is-map? is-set? is-record? is-variant?
                   is-option? is-result? is-handle? is-some? is-ok? is-truthy?
                   value-eq value-get value-has? record-get-field
                   value-problem well-formed? from-form to-form tag-name]}
  (:require [kotoba.form :as form])
  (:schemas {:kir/v [:record :kir/v [[:tag :i64] [:n :i64] [:s :string] [:k :keyword]
                                     [:b :bytes] [:kids [:list [:ref :kir/v]]]]]
             :form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                       [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

;; ---- tags (exported constants must be functions) ----

(defn tag-nil [] :i64 0)
(defn tag-bool [] :i64 1)
(defn tag-i64 [] :i64 2)
(defn tag-f64 [] :i64 3)
(defn tag-string [] :i64 4)
(defn tag-keyword [] :i64 5)
(defn tag-symbol [] :i64 6)
(defn tag-bytes [] :i64 7)
(defn tag-list [] :i64 8)
(defn tag-vector [] :i64 9)
(defn tag-map [] :i64 10)
(defn tag-set [] :i64 11)
(defn tag-record [] :i64 12)
(defn tag-variant [] :i64 13)
(defn tag-option [] :i64 14)
(defn tag-result [] :i64 15)
(defn tag-handle [] :i64 16)

(defn tag-name [t :i64] :keyword
  (cond
    (= t 0) :nil
    (= t 1) :bool
    (= t 2) :i64
    (= t 3) :f64
    (= t 4) :string
    (= t 5) :keyword
    (= t 6) :symbol
    (= t 7) :bytes
    (= t 8) :list
    (= t 9) :vector
    (= t 10) :map
    (= t 11) :set
    (= t 12) :record
    (= t 13) :variant
    (= t 14) :option
    (= t 15) :result
    (= t 16) :handle
    :else :unknown))

;; ---- lists of values ----

(defn no-values [] [:list [:ref :kir/v]]
  (typed-list-new [:list [:ref :kir/v]]))

(defn one-value [a [:ref :kir/v]] [:list [:ref :kir/v]]
  (typed-list-new [:list [:ref :kir/v]] a))

(defn two-values [a [:ref :kir/v] b [:ref :kir/v]] [:list [:ref :kir/v]]
  (typed-list-new [:list [:ref :kir/v]] a b))

(defn append-value [xs [:list [:ref :kir/v]] x [:ref :kir/v]] [:list [:ref :kir/v]]
  (typed-list-conj [:list [:ref :kir/v]] xs x))

;; ---- constructors ----

(defn- mk [t :i64 n :i64 s :string k :keyword b :bytes kids [:list [:ref :kir/v]]] [:ref :kir/v]
  (record-new [:ref :kir/v] t n s k b kids))

(defn nil-value [] [:ref :kir/v] (mk 0 0 "" :none (bytes-empty) (no-values)))
(defn bool-value [x :bool] [:ref :kir/v] (mk 1 (if x 1 0) "" :none (bytes-empty) (no-values)))
(defn i64-value [n :i64] [:ref :kir/v] (mk 2 n "" :none (bytes-empty) (no-values)))
(defn f64-value [bits :i64] [:ref :kir/v] (mk 3 bits "" :none (bytes-empty) (no-values)))
(defn string-value [s :string] [:ref :kir/v] (mk 4 0 s :none (bytes-empty) (no-values)))
(defn keyword-value [k :keyword] [:ref :kir/v] (mk 5 0 "" k (bytes-empty) (no-values)))
(defn symbol-value [s :string] [:ref :kir/v] (mk 6 0 s :none (bytes-empty) (no-values)))
(defn bytes-value [b :bytes] [:ref :kir/v] (mk 7 0 "" :none b (no-values)))
(defn list-value [kids [:list [:ref :kir/v]]] [:ref :kir/v] (mk 8 0 "" :none (bytes-empty) kids))
(defn vector-value [kids [:list [:ref :kir/v]]] [:ref :kir/v] (mk 9 0 "" :none (bytes-empty) kids))
(defn map-value [kids [:list [:ref :kir/v]]] [:ref :kir/v] (mk 10 0 "" :none (bytes-empty) kids))
(defn set-value [kids [:list [:ref :kir/v]]] [:ref :kir/v] (mk 11 0 "" :none (bytes-empty) kids))
(defn record-value [type-name :string kids [:list [:ref :kir/v]]] [:ref :kir/v]
  (mk 12 0 type-name :none (bytes-empty) kids))
(defn variant-value [case-name :string kids [:list [:ref :kir/v]]] [:ref :kir/v]
  (mk 13 0 case-name :none (bytes-empty) kids))
(defn none-value [] [:ref :kir/v] (mk 14 0 "" :none (bytes-empty) (no-values)))
(defn some-value [x [:ref :kir/v]] [:ref :kir/v] (mk 14 1 "" :none (bytes-empty) (one-value x)))
(defn ok-value [x [:ref :kir/v]] [:ref :kir/v] (mk 15 0 "" :none (bytes-empty) (one-value x)))
(defn err-value [x [:ref :kir/v]] [:ref :kir/v] (mk 15 1 "" :none (bytes-empty) (one-value x)))
(defn handle-value [arena :string id :i64] [:ref :kir/v] (mk 16 id arena :none (bytes-empty) (no-values)))

;; ---- accessors ----

(defn tag-of [v [:ref :kir/v]] :i64 (record-get [:ref :kir/v] v :tag))
(defn n-of [v [:ref :kir/v]] :i64 (record-get [:ref :kir/v] v :n))
(defn s-of [v [:ref :kir/v]] :string (record-get [:ref :kir/v] v :s))
(defn k-of [v [:ref :kir/v]] :keyword (record-get [:ref :kir/v] v :k))
(defn b-of [v [:ref :kir/v]] :bytes (record-get [:ref :kir/v] v :b))
(defn kids-of [v [:ref :kir/v]] [:list [:ref :kir/v]] (record-get [:ref :kir/v] v :kids))
(defn count-of [v [:ref :kir/v]] :i64 (vector-count (kids-of v)))

(defn nth-of [v [:ref :kir/v] i :i64] [:ref :kir/v]
  (if (and (>= i 0) (< i (count-of v)))
    (typed-list-nth [:list [:ref :kir/v]] (kids-of v) i)
    (nil-value)))

(defn is-nil? [v [:ref :kir/v]] :bool (= 0 (tag-of v)))
(defn is-bool? [v [:ref :kir/v]] :bool (= 1 (tag-of v)))
(defn is-i64? [v [:ref :kir/v]] :bool (= 2 (tag-of v)))
(defn is-f64? [v [:ref :kir/v]] :bool (= 3 (tag-of v)))
(defn is-string? [v [:ref :kir/v]] :bool (= 4 (tag-of v)))
(defn is-keyword? [v [:ref :kir/v]] :bool (= 5 (tag-of v)))
(defn is-symbol? [v [:ref :kir/v]] :bool (= 6 (tag-of v)))
(defn is-bytes? [v [:ref :kir/v]] :bool (= 7 (tag-of v)))
(defn is-list? [v [:ref :kir/v]] :bool (= 8 (tag-of v)))
(defn is-vector? [v [:ref :kir/v]] :bool (= 9 (tag-of v)))
(defn is-map? [v [:ref :kir/v]] :bool (= 10 (tag-of v)))
(defn is-set? [v [:ref :kir/v]] :bool (= 11 (tag-of v)))
(defn is-record? [v [:ref :kir/v]] :bool (= 12 (tag-of v)))
(defn is-variant? [v [:ref :kir/v]] :bool (= 13 (tag-of v)))
(defn is-option? [v [:ref :kir/v]] :bool (= 14 (tag-of v)))
(defn is-result? [v [:ref :kir/v]] :bool (= 15 (tag-of v)))
(defn is-handle? [v [:ref :kir/v]] :bool (= 16 (tag-of v)))
(defn is-some? [v [:ref :kir/v]] :bool (and (= 14 (tag-of v)) (= 1 (n-of v))))
(defn is-ok? [v [:ref :kir/v]] :bool (and (= 15 (tag-of v)) (= 0 (n-of v))))

;; Clojure truthiness: only nil and false are falsy.
(defn is-truthy? [v [:ref :kir/v]] :bool
  (let [t (tag-of v)]
    (not (or (= t 0) (and (= t 1) (= 0 (n-of v)))))))

;; ---- equality ----

(defn- bytes-eq [a :bytes b :bytes] :bool
  (let [n (bytes-count a)]
    (if (= n (bytes-count b))
      (loop [i 0]
        (if (>= i n) true
          (if (= (bytes-at a i) (bytes-at b i)) (recur (inc i)) false)))
      false)))

(defn- member? [xs [:list [:ref :kir/v]] x [:ref :kir/v]] :bool
  (let [n (vector-count xs)]
    (loop [i 0]
      (if (>= i n) false
        (if (value-eq (typed-list-nth [:list [:ref :kir/v]] xs i) x) true (recur (inc i)))))))

(defn- ordered-eq [xs [:list [:ref :kir/v]] ys [:list [:ref :kir/v]]] :bool
  (let [n (vector-count xs)]
    (if (= n (vector-count ys))
      (loop [i 0]
        (if (>= i n) true
          (if (value-eq (typed-list-nth [:list [:ref :kir/v]] xs i) (typed-list-nth [:list [:ref :kir/v]] ys i))
            (recur (inc i))
            false)))
      false)))

(defn- set-eq [xs [:list [:ref :kir/v]] ys [:list [:ref :kir/v]]] :bool
  (let [n (vector-count xs)]
    (if (= n (vector-count ys))
      (loop [i 0]
        (if (>= i n) true
          (if (member? ys (typed-list-nth [:list [:ref :kir/v]] xs i)) (recur (inc i)) false)))
      false)))

(defn- lookup-index [kids [:list [:ref :kir/v]] key [:ref :kir/v]] :i64
  (let [n (vector-count kids)]
    (loop [j 0]
      (if (>= (+ j 1) n)
        -1
        (if (value-eq (typed-list-nth [:list [:ref :kir/v]] kids j) key)
          j
          (recur (+ j 2)))))))

(defn- map-eq [xs [:list [:ref :kir/v]] ys [:list [:ref :kir/v]]] :bool
  (let [n (vector-count xs)]
    (if (= n (vector-count ys))
      (loop [j 0]
        (if (>= (+ j 1) n) true
          (let [at (lookup-index ys (typed-list-nth [:list [:ref :kir/v]] xs j))]
            (if (and (>= at 0)
                     (value-eq (typed-list-nth [:list [:ref :kir/v]] xs (+ j 1))
                               (typed-list-nth [:list [:ref :kir/v]] ys (+ at 1))))
              (recur (+ j 2))
              false))))
      false)))

(defn value-eq
  "Structural equality. A list and a vector are different kinds; sets and maps
  (and a record's field entries) compare without order; an f64 compares by
  bits (so NaN equals itself and 0.0 differs from -0.0: the sealed-oracle
  comparison, not IEEE `=`)."
  [a [:ref :kir/v] b [:ref :kir/v]] :bool
  (let [t (tag-of a)]
    (and (= t (tag-of b))
         (cond
           (= t 0) true
           (= t 1) (= (n-of a) (n-of b))
           (= t 2) (= (n-of a) (n-of b))
           (= t 3) (= (n-of a) (n-of b))
           (= t 4) (string=? (s-of a) (s-of b))
           (= t 5) (= (k-of a) (k-of b))
           (= t 6) (string=? (s-of a) (s-of b))
           (= t 7) (bytes-eq (b-of a) (b-of b))
           (= t 10) (map-eq (kids-of a) (kids-of b))
           (= t 11) (set-eq (kids-of a) (kids-of b))
           (= t 12) (and (string=? (s-of a) (s-of b)) (map-eq (kids-of a) (kids-of b)))
           (= t 13) (and (string=? (s-of a) (s-of b)) (ordered-eq (kids-of a) (kids-of b)))
           (= t 14) (and (= (n-of a) (n-of b)) (ordered-eq (kids-of a) (kids-of b)))
           (= t 15) (and (= (n-of a) (n-of b)) (ordered-eq (kids-of a) (kids-of b)))
           (= t 16) (and (= (n-of a) (n-of b)) (string=? (s-of a) (s-of b)))
           :else (ordered-eq (kids-of a) (kids-of b))))))

;; ---- map / record lookup ----

(defn value-has? [m [:ref :kir/v] key [:ref :kir/v]] :bool
  (>= (lookup-index (kids-of m) key) 0))

(defn value-get
  "The value bound to KEY in a map (or record), or nil."
  [m [:ref :kir/v] key [:ref :kir/v]] [:ref :kir/v]
  (let [at (lookup-index (kids-of m) key)]
    (if (>= at 0)
      (typed-list-nth [:list [:ref :kir/v]] (kids-of m) (+ at 1))
      (nil-value))))

(defn record-get-field
  "Field FIELD of a record value, or nil."
  [r [:ref :kir/v] field :keyword] [:ref :kir/v]
  (value-get r (keyword-value field)))

;; ---- shape ----

(defn- first-problem [xs [:list [:ref :kir/v]]] :keyword
  (let [n (vector-count xs)]
    (loop [i 0]
      (if (>= i n) :ok
        (let [p (value-problem (typed-list-nth [:list [:ref :kir/v]] xs i))]
          (if (= p :ok) (recur (inc i)) p))))))

(defn- record-keys-ok? [xs [:list [:ref :kir/v]]] :bool
  (let [n (vector-count xs)]
    (loop [j 0]
      (if (>= j n) true
        (if (= 5 (tag-of (typed-list-nth [:list [:ref :kir/v]] xs j))) (recur (+ j 2)) false)))))

(defn value-problem
  "The first structural problem of a Value (a keyword), or :ok. Leaves carry no
  kids, a bool/option/result arm is 0 or 1, a map/record has an even number of
  kids (a record's keys are keywords), an option holds n kids, a result one, a
  handle a non-negative id, and every nested value is itself well-formed."
  [v [:ref :kir/v]] :keyword
  (let [t (tag-of v)
        c (count-of v)
        n (n-of v)]
    (cond
      (or (< t 0) (> t 16)) :unknown-tag
      (and (<= t 7) (> c 0)) :leaf-with-kids
      (and (= t 1) (not (or (= n 0) (= n 1)))) :bad-bool
      (and (or (= t 10) (= t 12)) (not (= 0 (rem c 2)))) :odd-entries
      (and (= t 12) (not (record-keys-ok? (kids-of v)))) :record-key-not-keyword
      (and (= t 14) (not (or (= n 0) (= n 1)))) :bad-option-arm
      (and (= t 14) (not (= c n))) :option-arity
      (and (= t 15) (not (or (= n 0) (= n 1)))) :bad-result-arm
      (and (= t 15) (not (= c 1))) :result-arity
      (and (= t 16) (< n 0)) :bad-handle
      (and (= t 16) (> c 0)) :handle-with-kids
      :else (first-problem (kids-of v)))))

(defn well-formed? [v [:ref :kir/v]] :bool
  (= :ok (value-problem v)))

;; ---- Form <-> Value ----

(defn- map-forms [xs [:list [:ref :form/r]]] [:list [:ref :kir/v]]
  (let [n (vector-count xs)]
    (loop [i 0 acc (no-values)]
      (if (>= i n) acc
        (recur (inc i) (append-value acc (from-form (typed-list-nth [:list [:ref :form/r]] xs i))))))))

(defn from-form
  "Plain data (a Form) as a Value. A Form has no typed aggregates, so the result
  uses only tags 0..11."
  [f [:ref :form/r]] [:ref :kir/v]
  (let [t (form/tag-of f)]
    (cond
      (= t 0) (nil-value)
      (= t 1) (mk 1 (form/int-value f) "" :none (bytes-empty) (no-values))
      (= t 2) (i64-value (form/int-value f))
      (= t 3) (string-value (form/string-value f))
      (= t 4) (keyword-value (form/keyword-value f))
      (= t 5) (symbol-value (form/symbol-value f))
      (= t 6) (list-value (map-forms (form/kids-of f)))
      (= t 7) (vector-value (map-forms (form/kids-of f)))
      (= t 8) (set-value (map-forms (form/kids-of f)))
      (= t 9) (map-value (map-forms (form/kids-of f)))
      (= t 10) (f64-value (form/bits-of f))
      (= t 11) (bytes-value (form/bytes-of f))
      :else (nil-value))))

(defn- map-values [xs [:list [:ref :kir/v]]] [:list [:ref :form/r]]
  (let [n (vector-count xs)]
    (loop [i 0 acc (form/no-forms)]
      (if (>= i n) acc
        (recur (inc i) (form/append-form acc (to-form (typed-list-nth [:list [:ref :kir/v]] xs i))))))))

(defn- tagged [head :keyword rest-forms [:list [:ref :form/r]]] [:ref :form/r]
  (form/form-vec (form/cons-onto (form/keyword-form head) rest-forms)))

(defn to-form
  "A Value erased to a Form. Plain data maps to its own Form; the typed
  aggregates become tagged vectors: record [:kir/record \"T\" k v ..],
  variant [:kir/variant \"case\" x ..], option [:kir/none] / [:kir/some x],
  result [:kir/ok x] / [:kir/err x], handle [:kir/handle \"arena\" id]."
  [v [:ref :kir/v]] [:ref :form/r]
  (let [t (tag-of v)]
    (cond
      (= t 0) (form/nil-form)
      (= t 1) (form/bool-form (= 1 (n-of v)))
      (= t 2) (form/int-form (n-of v))
      (= t 3) (form/f64-form (n-of v))
      (= t 4) (form/string-form (s-of v))
      (= t 5) (form/keyword-form (k-of v))
      (= t 6) (form/symbol-form (s-of v))
      (= t 7) (form/bytes-form (b-of v))
      (= t 8) (form/form-seq (map-values (kids-of v)))
      (= t 9) (form/form-vec (map-values (kids-of v)))
      (= t 10) (form/form-map (map-values (kids-of v)))
      (= t 11) (form/form-set (map-values (kids-of v)))
      (= t 12) (tagged :kir/record (form/cons-onto (form/string-form (s-of v)) (map-values (kids-of v))))
      (= t 13) (tagged :kir/variant (form/cons-onto (form/string-form (s-of v)) (map-values (kids-of v))))
      (= t 14) (if (= 1 (n-of v))
                 (tagged :kir/some (map-values (kids-of v)))
                 (tagged :kir/none (form/no-forms)))
      (= t 15) (if (= 0 (n-of v))
                 (tagged :kir/ok (map-values (kids-of v)))
                 (tagged :kir/err (map-values (kids-of v))))
      (= t 16) (tagged :kir/handle (form/two-forms (form/string-form (s-of v)) (form/int-form (n-of v))))
      :else (form/nil-form))))
