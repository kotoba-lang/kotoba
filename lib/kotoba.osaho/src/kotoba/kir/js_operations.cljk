(ns kotoba.kir.js-operations
  "Pure observations of opaque JS values. No coercion or property access."
  {:kotoba/export [nullish? truthy? strict-equal? type-of array? bool-value undefined-value]}
  #?(:cljs (:require ["./js_host.mjs" :as host])))

;; R6QW3: the Kotoba reading (W3: the scan refused this module E2119 at require-js-host!).
;; This module observes opaque JS values; a non-JS host is the oracle's own :clj arm, which
;; refuses by throwing at require-js-host!. The Kotoba reading is that arm: every call
;; answers the same fail-closed refusal (the ex-info's map literal is the desugar's case).
;; The host reading is byte-for-byte.
#?(:kotoba
   (defn- require-js-host! [] :bool
     (throw (ex-info "opaque JS operations require a JS host"
                     {:phase :value :trap :js-value-host})))
   :default
(defn- require-js-host! []
  #?(:clj (throw (ex-info "opaque JS operations require a JS host"
                         {:phase :value :trap :js-value-host}))
     :cljs nil)))
#?(:kotoba
   (defn nullish? [value :document]
     (require-js-host!))
   :default
(defn nullish? [value]
  (require-js-host!)
  #?(:cljs (or (identical? value nil) (identical? value js/undefined)) :clj nil)))
#?(:kotoba
   (defn truthy? [value :document]
     (require-js-host!))
   :default
(defn truthy? [value]
  (require-js-host!)
  #?(:cljs (js/Boolean value) :clj nil)))
#?(:kotoba
   (defn strict-equal? [left :document right :document]
     (require-js-host!))
   :default
(defn strict-equal? [left right]
  (require-js-host!)
  #?(:cljs (identical? left right) :clj nil)))
#?(:kotoba
   (defn type-of [value :document]
     (require-js-host!))
   :default
(defn type-of [value]
  (require-js-host!)
  #?(:cljs (host/typeOf value) :clj nil)))
#?(:kotoba
   (defn array? [value :document]
     (require-js-host!))
   :default
(defn array? [value]
  (require-js-host!)
  #?(:cljs (host/arrayBrand value) :clj nil)))
#?(:kotoba
   (defn bool-value [value :document]
     (require-js-host!))
   :default
(defn bool-value [value]
  (require-js-host!)
  #?(:cljs (if (boolean? value)
             value
             (throw (ex-info "bool-value requires an actual boolean"
                             {:phase :value :trap :js-operation-type})))
     :clj nil)))
#?(:kotoba
   (defn undefined-value []
     (require-js-host!))
   :default
(defn undefined-value []
  (require-js-host!)
  #?(:cljs js/undefined :clj nil)))
