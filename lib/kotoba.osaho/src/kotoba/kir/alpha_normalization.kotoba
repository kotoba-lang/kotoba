;; Native owner of positional KIR alpha normalization. One counter per
;; function, lexical scopes restored after every binder body; no host state.
(ns kotoba.kir.alpha-normalization
 (:export [alpha-normalize alpha-normalize-with-scalar binding-forms canonical-binder contract handles? normalize-function symbols-in verify-normalized! verify-normalized-with-problem])
 (:require [kotoba.form :as f])
 (:schemas {:alpha/state [:record :alpha/state [[:counter :i64] [:scope [:ref :form/r]] [:bound [:ref :form/r]]
   [:scalar [:fn [[[:ref :form/r]] [:ref :form/r]]]]]]
  :alpha/walk [:record :alpha/walk [[:form [:ref :form/r]] [:state [:ref :alpha/state]]]]}))
(defn contract [] :keyword :kotoba.kir.alpha-normalization/v1)
(defn binding-forms [] [:ref :form/r]
 (f/form-set (f/append-form (f/three-forms (f/symbol-form "let") (f/symbol-form "result-match-of")
  (f/symbol-form "variant-match")) (f/symbol-form "option-match"))))
(defn handles? [op :string] :bool
 (or (string=? op "let") (string=? op "result-match-of") (string=? op "variant-match") (string=? op "option-match")))
(defn canonical-binder [index :i64] [:ref :form/r]
 (f/symbol-form (string-concat "k" (string-from-i64 index))))
(defn- get [m [:ref :form/r] key :keyword] [:ref :form/r] (f/form-get m (f/keyword-form key)))
(defn- has [s [:ref :form/r] x [:ref :form/r]] :bool
 (loop [i 0] (cond (= i (f/count-of s)) false (f/eq x (f/nth-of s i)) true :else (recur (+ i 1)))))
(defn- add [s [:ref :form/r] x [:ref :form/r]] [:ref :form/r]
 (if (has s x) s (f/form-set (f/append-form (f/kids-of s) x))))
(defn- answer [form [:ref :form/r] state [:ref :alpha/state]] [:ref :alpha/walk] (record-new [:ref :alpha/walk] form state))
(defn- node [r [:ref :alpha/walk]] [:ref :form/r] (record-get [:ref :alpha/walk] r :form))
(defn- state [r [:ref :alpha/walk]] [:ref :alpha/state] (record-get [:ref :alpha/walk] r :state))
(defn- scope [s [:ref :alpha/state]] [:ref :form/r] (record-get [:ref :alpha/state] s :scope))
(defn- restore [r [:ref :alpha/walk] outer [:ref :alpha/state]] [:ref :alpha/walk]
 (let [next (state r)] (answer (node r) (record-new [:ref :alpha/state]
  (record-get [:ref :alpha/state] next :counter) (scope outer) (record-get [:ref :alpha/state] next :bound)
  (record-get [:ref :alpha/state] next :scalar)))))
(defn- bind [s [:ref :alpha/state] name [:ref :form/r]] [:ref :alpha/walk]
 (if (not (f/is-symbol? name)) (throw :kotoba.kir.alpha-normalization/binder-shape)
  (let [counter (record-get [:ref :alpha/state] s :counter) renamed (canonical-binder counter)]
   (answer renamed (record-new [:ref :alpha/state] (+ counter 1) (f/assoc-form (scope s) name renamed)
    (add (record-get [:ref :alpha/state] s :bound) name) (record-get [:ref :alpha/state] s :scalar))))))
(defn- checked-walk [form [:ref :form/r] s [:ref :alpha/state] depth :i64] [:result [:ref :alpha/walk] :keyword]
 (try (result-ok-of [:result [:ref :alpha/walk] :keyword] (walk form s depth))
  (catch :keyword reason (result-err-of [:result [:ref :alpha/walk] :keyword] reason))))
(defn- empty-result [s [:ref :alpha/state]] [:ref :alpha/walk] (answer (f/nil-form) s))
(defn- sequence [form [:ref :form/r] start :i64 s [:ref :alpha/state] depth :i64] [:ref :alpha/walk]
 (loop [i start current s out (f/no-forms)]
  (if (= i (f/count-of form)) (answer (f/form-vec out) current)
   (let [r (checked-walk (f/nth-of form i) current (+ depth 1))]
    (if (result-ok?-of [:result [:ref :alpha/walk] :keyword] r)
     (let [value (result-value-of [:result [:ref :alpha/walk] :keyword] r (empty-result current))]
      (recur (+ i 1) (state value) (f/append-form out (node value))))
     (throw (result-error-of [:result [:ref :alpha/walk] :keyword] r :kotoba.kir.alpha-normalization/form)))))))
(defn- scoped [name [:ref :form/r] body [:ref :form/r] s [:ref :alpha/state] depth :i64] [:ref :alpha/walk]
 (let [bound (bind s name) value (walk body (state bound) (+ depth 1))]
  (restore (answer (f/form-vec (f/two-forms (node bound) (node value))) (state value)) s)))
(defn- pair [bindings [:ref :form/r] i :i64 s [:ref :alpha/state] depth :i64] [:result [:ref :alpha/walk] :keyword]
 (try (let [value (walk (f/nth-of bindings (+ i 1)) s (+ depth 1))
            bound (bind (state value) (f/nth-of bindings i))]
  (result-ok-of [:result [:ref :alpha/walk] :keyword]
   (answer (f/form-vec (f/two-forms (node bound) (node value))) (state bound))))
  (catch :keyword reason (result-err-of [:result [:ref :alpha/walk] :keyword] reason))))
(defn- let-walk [form [:ref :form/r] s [:ref :alpha/state] depth :i64] [:ref :alpha/walk]
 (let [bindings (f/nth-of form 1)]
  (if (or (not= (f/count-of form) 3) (not (f/is-vec? bindings)) (not= (bit-and (f/count-of bindings) 1) 0))
   (throw :kotoba.kir.alpha-normalization/let-shape)
   (let [pairs (loop [i 0 current s out (f/no-forms)]
    (if (= i (f/count-of bindings)) (answer (f/form-vec out) current)
     (let [r (pair bindings i current depth)]
      (if (result-ok?-of [:result [:ref :alpha/walk] :keyword] r)
       (let [value (result-value-of [:result [:ref :alpha/walk] :keyword] r (empty-result current))]
        (recur (+ i 2) (state value) (f/append-many out (f/kids-of (node value)))))
       (throw (result-error-of [:result [:ref :alpha/walk] :keyword] r :kotoba.kir.alpha-normalization/form))))))
         body (walk (f/nth-of form 2) (state pairs) (+ depth 1))]
    (restore (answer (f/call2 "let" (node pairs) (node body)) (state body)) s)))))
(defn- branch [b [:ref :form/r] s [:ref :alpha/state] depth :i64] [:result [:ref :alpha/walk] :keyword]
 (try
  (if (not= (f/count-of b) 3) (throw :kotoba.kir.alpha-normalization/variant-shape)
   (let [part (scoped (f/nth-of b 1) (f/nth-of b 2) s depth)]
    (result-ok-of [:result [:ref :alpha/walk] :keyword]
     (answer (f/form-vec (f/three-forms (f/nth-of b 0) (f/nth-of (node part) 0) (f/nth-of (node part) 1))) (state part)))))
  (catch :keyword reason (result-err-of [:result [:ref :alpha/walk] :keyword] reason))))
(defn- variant-walk [form [:ref :form/r] s [:ref :alpha/state] depth :i64] [:ref :alpha/walk]
 (if (not= (f/count-of form) 4) (throw :kotoba.kir.alpha-normalization/variant-shape)
  (let [value (walk (f/nth-of form 2) s (+ depth 1)) branches (f/nth-of form 3)
        all (loop [i 0 current (state value) out (f/no-forms)]
         (if (= i (f/count-of branches)) (answer (f/form-vec out) current)
          (let [r (branch (f/nth-of branches i) current depth)]
           (if (result-ok?-of [:result [:ref :alpha/walk] :keyword] r)
            (let [b (result-value-of [:result [:ref :alpha/walk] :keyword] r (empty-result current))]
             (recur (+ i 1) (state b) (f/append-form out (node b))))
            (throw (result-error-of [:result [:ref :alpha/walk] :keyword] r :kotoba.kir.alpha-normalization/form))))))]
   (answer (f/call3 "variant-match" (f/nth-of form 1) (node value) (node all)) (state all)))))
(defn- walk [form [:ref :form/r] s [:ref :alpha/state] depth :i64] [:ref :alpha/walk]
 (if (> depth 512) (throw :kotoba.kir.alpha-normalization/depth)
  (cond (f/is-symbol? form) (answer (if (f/form-has? (scope s) form) (f/form-get (scope s) form) form) s)
   (and (f/is-vec? form) (= (f/count-of form) 2) (f/eq (f/nth-of form 0) (f/keyword-form :ref))) (answer form s)
   (or (f/is-map? form) (f/is-vec? form) (f/is-set? form))
    (let [r (sequence form 0 s depth)] (answer (f/with-children form (f/kids-of (node r))) (state r)))
   (f/is-seq? form) (let [op (f/nth-of form 0) name (if (f/is-symbol? op) (f/symbol-value op) "")]
    (cond (string=? name "let") (let-walk form s depth)
     (string=? name "result-match-of")
      (if (not= (f/count-of form) 7) (throw :kotoba.kir.alpha-normalization/result-shape)
       (let [value (walk (f/nth-of form 2) s (+ depth 1))
             ok (scoped (f/nth-of form 3) (f/nth-of form 4) (state value) depth)
             err (scoped (f/nth-of form 5) (f/nth-of form 6) (state ok) depth)]
        (answer (f/call6 "result-match-of" (f/nth-of form 1) (node value)
         (f/nth-of (node ok) 0) (f/nth-of (node ok) 1) (f/nth-of (node err) 0) (f/nth-of (node err) 1)) (state err))))
     (string=? name "variant-match") (variant-walk form s depth)
     (string=? name "option-match")
      (if (not= (f/count-of form) 6) (throw :kotoba.kir.alpha-normalization/option-shape)
       (let [value (walk (f/nth-of form 2) s (+ depth 1)) none (walk (f/nth-of form 3) (state value) (+ depth 1))
             some (scoped (f/nth-of form 4) (f/nth-of form 5) (state none) depth)]
        (answer (f/call5 "option-match" (f/nth-of form 1) (node value) (node none)
         (f/nth-of (node some) 0) (f/nth-of (node some) 1)) (state some))))
     :else (let [args (sequence form 1 s depth)
                 renamed (if (f/form-has? (scope s) op) (f/form-get (scope s) op) op)]
      (answer (f/form-seq (f/cons-onto renamed (f/kids-of (node args)))) (state args)))))
   :else (let [scalar (record-get [:ref :alpha/state] s :scalar)] (answer (scalar form) s)))))
(defn- scalar-identity [form [:ref :form/r]] [:ref :form/r] form)
(defn- parameters [params [:ref :form/r] s [:ref :alpha/state]] [:result [:ref :alpha/walk] :keyword]
 (try
  (let [bound (loop [i 0 current s]
   (if (= i (f/count-of params)) current
    (let [r (try (result-ok-of [:result [:ref :alpha/walk] :keyword] (bind current (f/nth-of params i)))
             (catch :keyword reason (result-err-of [:result [:ref :alpha/walk] :keyword] reason)))]
     (if (result-ok?-of [:result [:ref :alpha/walk] :keyword] r)
      (let [value (result-value-of [:result [:ref :alpha/walk] :keyword] r (empty-result current))]
       (recur (+ i 1) (state value)))
      (throw (result-error-of [:result [:ref :alpha/walk] :keyword] r :kotoba.kir.alpha-normalization/form))))))
        names (loop [i 0 out (f/no-forms)] (if (= i (f/count-of params)) out
         (recur (+ i 1) (f/append-form out (f/form-get (scope bound) (f/nth-of params i))))))]
   (result-ok-of [:result [:ref :alpha/walk] :keyword] (answer (f/form-vec names) bound)))
  (catch :keyword reason (result-err-of [:result [:ref :alpha/walk] :keyword] reason))))
(defn alpha-normalize-with-scalar [function [:ref :form/r] scalar [:fn [[[:ref :form/r]] [:ref :form/r]]]] [:ref :form/r]
 (let [initial (record-new [:ref :alpha/state] 0 (f/form-map (f/no-forms)) (f/form-set (f/no-forms)) scalar)
       p (parameters (get function :params) initial)]
  (if (result-ok?-of [:result [:ref :alpha/walk] :keyword] p)
   (let [params (result-value-of [:result [:ref :alpha/walk] :keyword] p (empty-result initial))
         body (walk (get function :body) (state params) 0)]
    (f/form-map (f/append-many (f/two-forms (f/keyword-form :params) (node params))
     (f/append-many (f/two-forms (f/keyword-form :body) (node body))
      (f/two-forms (f/keyword-form :bound) (record-get [:ref :alpha/state] (state body) :bound))))))
   (throw (result-error-of [:result [:ref :alpha/walk] :keyword] p :kotoba.kir.alpha-normalization/form)))))
(defn alpha-normalize [function [:ref :form/r]] [:ref :form/r] (alpha-normalize-with-scalar function (fn-ref scalar-identity)))
(defn- symbols-at [form [:ref :form/r] out [:ref :form/r]] [:ref :form/r]
 (if (f/is-symbol? form) (add out form)
  (loop [i 0 current out] (if (= i (f/count-of form)) current
   (recur (+ i 1) (symbols-at (f/nth-of form i) current))))))
(defn symbols-in [form [:ref :form/r]] [:ref :form/r] (symbols-at form (f/form-set (f/no-forms))))
(defn verify-normalized-with-problem [normalized [:ref :form/r] targets [:ref :form/r] problem :keyword] [:ref :form/r]
 (let [present (symbols-in (get normalized :body)) bound (get normalized :bound)
       clean (loop [i 0] (cond (= i (f/count-of bound)) true
        (and (has present (f/nth-of bound i)) (not (has targets (f/nth-of bound i)))) false :else (recur (+ i 1))))]
  (if clean normalized (throw problem))))
(defn verify-normalized! [normalized [:ref :form/r] targets [:ref :form/r]] [:ref :form/r]
 (verify-normalized-with-problem normalized targets :kotoba.kir.alpha-normalization/binder-not-normalized))
(defn normalize-function [function [:ref :form/r] targets [:ref :form/r]] [:ref :form/r]
 (verify-normalized! (alpha-normalize function) targets))
