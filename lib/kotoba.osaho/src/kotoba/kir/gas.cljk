(ns kotoba.kir.gas
  "Consensus gas for KIR: a versioned schedule of weights, charged on the
  reference interpreter once per evaluated KIR form (superproject
  adr-2610092340 D3 / D12).

  Gas is NOT fuel. Fuel is the run's boundedness ceiling (function entries,
  one unit each) and its counting differs by backend family on purpose
  (`kotoba.kir`'s `budget-traps`; measured 2026-10-09 by kotoba-lang/amu
  `scripts/test-fuel-differential.cljk`: a 1,000-iteration loop costs 2 fuel
  on this interpreter, 1 on wasm32 and 1,002 on native). Gas is the price
  table a validator set agrees on, so it is defined here, once, over the IR
  every backend reads:

    gas used by a run that answers =
      the sum, over every KIR application form the run evaluates,
      of the weight the schedule gives that form's head

  - a head that names a function of the module weighs `:call`;
  - any other head weighs `(get :weights head)`, else `:default`;
  - literals and symbol references weigh nothing.

  A run that exhausts its gas traps `:budget/gas`. A consensus caller treats
  that as `revert, charge the whole limit` (the EVM's out-of-gas rule), which
  is what lets a backend charge a straight-line segment's sum at the
  segment's entry instead of form by form: for a run that ANSWERS, the two
  orders charge the same total, so only the reference's per-form definition
  is normative.

  `schedule-v0-draft` weighs every form 1. It is a placeholder that makes the
  counting testable before the weights are measured (adr-2610092340 O2:
  schedule v1's weights come from benchmarks on a published reference
  machine). Nothing should be priced on it."
  {:kotoba/export [schedule-v0-draft validate-schedule! form-weight]})

;; -- Kotoba reading (W3: JUN-202 selfbuild scan refused this module E2139
;; "a fn literal parameter takes its type from the context, not from an
;; annotation" -- the (fn [[k v]] ...) destructured pair in validate-schedule!).
;; The host reading below is kept byte-for-byte as :default.
;;
;; Port decisions (oracle semantics preserved; the oracle's ex-info sites
;; become returned :error status documents, per the migration contract):
;; - The schedule is one :document. Absent fields fail their checks exactly
;;   where the host's nil?/keyword?/integer? did (a (document-null) default
;;   is never :keyword/:i64-kind).
;; - validate-schedule! returns the schedule, or an :error status document
;;   carrying the oracle's ex-info data fields verbatim (:phase :ir, :reason,
;;   :schedule) with :error :gas-schedule-refused standing for the oracle's
;;   "gas schedule refused: <reason>" message. Checks run in the oracle's
;;   order and the FIRST refusal is returned, matching the throw order.
;; - schedule-v0-draft is a nullary fn here: a module export names a public
;;   function (the constant-export interface wall), so the constant travels
;;   as (schedule-v0-draft).
;; - weights entries are [key value] pair documents walked with
;;   document-map-entry-at (the oracle's every? + destructured fn literal).
;; Measured (seed r6n b3f46d32a01780fe, compile --emit-module): recorded on
;; Linear AWAI-77.

#?(:kotoba
   (defn- dgk [d :document k :keyword] :document
     (option-value-of [:option :document] (document-get d k) (document-null))))

#?(:kotoba
   (defn- doc-i64 [d :document] :i64
     (option-value-of [:option :i64] (document-i64-value d) 0)))

#?(:kotoba
   (defn- positive-int? [x :document] :bool
     (and (= (document-kind x) :i64) (> (doc-i64 x) 0)))
   :default
(defn- positive-int? [x] (and (integer? x) (pos? x))))

#?(:kotoba
   (defn- natural-int? [x :document] :bool
     (and (= (document-kind x) :i64) (>= (doc-i64 x) 0)))
   :default
(defn- natural-int? [x] (and (integer? x) (not (neg? x)))))

#?(:kotoba
   (defn- entry-ok? [e :document] :bool
     (and (= (document-kind (option-value-of [:option :document] (document-list-at e 0) (document-null))) :symbol)
          (natural-int? (option-value-of [:option :document] (document-list-at e 1) (document-null))))))

#?(:kotoba
   (defn- weights-ok? [w :document i :i64 n :i64] :bool
     (if (>= i n)
       true
       (if (entry-ok? (option-value-of [:option :document] (document-map-entry-at w i) (document-null)))
         (weights-ok? w (+ i 1) n)
         false))))

#?(:kotoba
   (defn- gas-err [reason :keyword schedule :document] :document
     (document-map (document-keyword :error) (document-keyword :gas-schedule-refused)
                   (document-keyword :phase) (document-keyword :ir)
                   (document-keyword :reason) (document-keyword reason)
                   (document-keyword :schedule) schedule)))

#?(:kotoba
   (defn schedule-v0-draft [] :document
     (document-map (document-keyword :gas-schedule/id) (document-keyword :kotoba.gas/v0-draft)
                   (document-keyword :gas-schedule/version) (document-i64 0)
                   (document-keyword :call) (document-i64 1)
                   (document-keyword :default) (document-i64 1)
                   (document-keyword :weights) (document-map)))
   :default
(def schedule-v0-draft
  {:gas-schedule/id :kotoba.gas/v0-draft
   :gas-schedule/version 0
   :call 1
   :default 1
   :weights {}}))

#?(:kotoba
   (defn validate-schedule! [schedule :document] :document
     (if (not (= (document-kind schedule) :map))
       (gas-err :gas-schedule-not-a-map schedule)
       (if (not (= (document-kind (dgk schedule :gas-schedule/id)) :keyword))
         (gas-err :gas-schedule-id schedule)
         (if (not (natural-int? (dgk schedule :gas-schedule/version)))
           (gas-err :gas-schedule-version schedule)
           (if (not (positive-int? (dgk schedule :default)))
             (gas-err :gas-schedule-default schedule)
             (if (not (positive-int? (dgk schedule :call)))
               (gas-err :gas-schedule-call schedule)
               (if (not (and (= (document-kind (dgk schedule :weights)) :map)
                             (weights-ok? (dgk schedule :weights) 0 (document-count (dgk schedule :weights)))))
                 (gas-err :gas-schedule-weights schedule)
                 schedule)))))))
   :default
(defn validate-schedule!
  "Refuse a schedule a run could not be priced by. `:default` and `:call` must
  be positive: a zero default would make every unlisted head free, and gas
  that can be zero everywhere stops nothing. A listed weight may be zero
  (a form deliberately priced into its parent), never negative."
  [schedule]
  (let [refuse (fn [reason]
                 (throw (ex-info (str "gas schedule refused: " (name reason))
                                 {:phase :ir :reason reason :schedule schedule})))]
    (when-not (map? schedule) (refuse :gas-schedule-not-a-map))
    (when-not (keyword? (:gas-schedule/id schedule)) (refuse :gas-schedule-id))
    (when-not (natural-int? (:gas-schedule/version schedule)) (refuse :gas-schedule-version))
    (when-not (positive-int? (:default schedule)) (refuse :gas-schedule-default))
    (when-not (positive-int? (:call schedule)) (refuse :gas-schedule-call))
    (when-not (and (map? (:weights schedule))
                   (every? (fn [[k v]] (and (symbol? k) (natural-int? v))) (:weights schedule)))
      (refuse :gas-schedule-weights))
    schedule)))

#?(:kotoba
   (defn form-weight [schedule :document op :document function? :bool] :i64
     (if function?
       (doc-i64 (dgk schedule :call))
       (doc-i64 (option-value-of [:option :document]
                                 (document-get (dgk schedule :weights) op)
                                 (dgk schedule :default)))))
   :default
(defn form-weight
  "The weight of one evaluated application form whose head is `op`.
  `function?` is whether `op` names a function of the module."
  [schedule op function?]
  (if function?
    (:call schedule)
    (get (:weights schedule) op (:default schedule)))))
