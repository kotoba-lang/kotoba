(ns kotoba.kir.compatibility
  {:kotoba/export [compiler-version descriptor language-version schema tender-role]})

;; R6QW3: the Kotoba reading (W3: the scan refused this module E2119 at the destructured
;; descriptor parameter). The exported constants are 0-argument functions -- which is exactly
;; how kotoba.wasm.core (the typed guest, the interface authority) calls them
;; ((compat/compiler-version) etc.). descriptor's map is typed-map-new over :document values;
;; its {:keys [...]} parameter is :document with dgk pulls.
#?(:kotoba
   (defn- dgk [d :document k :keyword] :document
     (option-value-of [:option :document] (document-get d k) (document-null))))

#?(:kotoba
   (defn schema [] :keyword :kotoba.compatibility/v1)
   :default
(def schema :kotoba.compatibility/v1))
#?(:kotoba
   (defn compiler-version [] :string "kotoba-compiler/1")
   :default
(def compiler-version "kotoba-compiler/1"))
#?(:kotoba
   (defn language-version [] :keyword :kotoba.language/safe-v1)
   :default
(def language-version :kotoba.language/safe-v1))
#?(:kotoba
   (defn tender-role [] :keyword :kototama/component-tender-v1)
   :default
(def tender-role :kototama/component-tender-v1))
#?(:kotoba
   (defn descriptor [m :document] [:map :keyword :document]
     (let [hir-format (dgk m :hir-format)
           kir-format (dgk m :kir-format)
           target (dgk m :target)
           value-abi (dgk m :value-abi)
           target-profile (dgk m :target-profile)
           runtime (dgk target-profile :runtime)
           execution (dgk target-profile :execution)
           tender-contract
           (if (document-equal? runtime (document-keyword :kotoba-linux-static-prelude-v1))
             (document-keyword :kotoba.linux-static/v1)
             (cond (document-equal? execution (document-keyword :javascript)) (document-keyword :kotoba.restricted-esm/v1)
                   (document-equal? execution (document-keyword :wasm)) (document-keyword :kotoba.capability-host/v1)
                   (document-equal? execution (document-keyword :native)) (document-keyword :kotoba.supervisor/v1)
                   (document-equal? execution (document-keyword :process)) (document-keyword :kotoba.aiueos-process/v1)
                   (document-equal? execution (document-keyword :kernel)) (document-keyword :kotoba.aiueos-kernel/v1)
                   (document-equal? execution (document-keyword :firmware)) (document-keyword :kotoba.aiueos-firmware/v1)
                   (document-equal? execution (document-keyword :cljs)) (document-keyword :kotoba.cljs-host/v1)
                   :else (document-keyword :kotoba.unsupported/v1)))]
       (typed-map-new [:map :keyword :document]
                      :format (document-keyword :kotoba.compatibility/v1)
                      :compiler (document-string "kotoba-compiler/1")
                      :language (document-keyword :kotoba.language/safe-v1)
                      :hir hir-format
                      :kir kir-format
                      :target target
                      :runtime runtime
                      :value-abi value-abi
                      :tender-role (document-keyword :kototama/component-tender-v1)
                      :tender-contract tender-contract)))
   :default
(defn descriptor [{:keys [hir-format kir-format target target-profile value-abi]}]
  {:format schema
   :compiler compiler-version
   :language language-version
   :hir hir-format
   :kir kir-format
   :target target
   :runtime (:runtime target-profile)
   :value-abi value-abi
   :tender-role tender-role
   ;; adr-2609251400 C2: a `:native` profile whose runtime is the in-image
   ;; prelude is not tendered by the kexe supervisor.
   :tender-contract (if (= :kotoba-linux-static-prelude-v1 (:runtime target-profile))
                      :kotoba.linux-static/v1
                      (case (:execution target-profile)
                        :javascript :kotoba.restricted-esm/v1
                        :wasm :kotoba.capability-host/v1
                        :native :kotoba.supervisor/v1
                        :process :kotoba.aiueos-process/v1
                        :kernel :kotoba.aiueos-kernel/v1
                        :firmware :kotoba.aiueos-firmware/v1
                        :cljs :kotoba.cljs-host/v1
                        :kotoba.unsupported/v1))}))
