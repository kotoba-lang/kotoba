(ns kotoba.kir.value
  {:kotoba/export [string-value-byte-limit string-literal-byte-limit bytes-value-byte-limit
                  keyword-value-byte-limit symbol-value-byte-limit map-entry-limit
                  vector-literal-item-limit document-depth-limit document-node-limit
                  document-container-item-limit document-utf8-byte-limit utf8-byte-count!]})

;; Native Kotoba frontend limits shared with the host compatibility module.
;; Keep values in sync with osaho/src/kotoba/kir/value.cljk until the language
;; limit table is the single generated source for both readers.
(defn string-value-byte-limit [] :i64 65536)
(defn string-literal-byte-limit [] :i64 (string-value-byte-limit))
(defn bytes-value-byte-limit [] :i64 65536)
(defn keyword-value-byte-limit [] :i64 512)
(defn symbol-value-byte-limit [] :i64 512)
(defn map-entry-limit [] :i64 128)
(defn vector-literal-item-limit [] :i64 128)
(defn document-depth-limit [] :i64 8)
(defn document-node-limit [] :i64 4096)
(defn document-container-item-limit [] :i64 32)
(defn document-utf8-byte-limit [] :i64 65536)

;; Kotoba strings are valid UTF-8 values and this primitive reports their byte
;; length, which is the host helper's result for every well-formed string.
(defn utf8-byte-count! [value :string] :i64
  (string-byte-length value))
