(ns kotoba.kir-native-record-update-admission-test
  "`record-assoc` at the native gate (amu ADR 0353 floor
  :native-record-operations).

  kotoba-sema elaborates `(assoc m :f v)` of a field a record has to
  `record-assoc`. `only-native-word-typed-features?` had a case for
  `record-new` and `record-get` and none for the update, so a row operation
  keeping its record's type was refused before any native backend saw it, as
  \"typed values currently require the kotoba-script web target, ...\". Both
  native backends now lower it (kotoba-native), so it is admitted here with
  `record-get`'s own checks: a well-formed record type, a declared keyword
  field, and both operands walked."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.kir :as kir]))

(def ^:private rec '[:record :t/r [[:a :i64] [:b :i64]]])

(defn- typed-hir [body]
  {:format :kotoba.hir/v3
   :functions [{:name 'main :params [] :param-types [] :result :i64 :body body}]})

(deftest a-record-update-is-admitted-natively
  (is (kir/only-native-word-typed-features?
       (typed-hir (list 'record-get rec (list 'record-assoc rec (list 'record-new rec 1 2) :a 7) :a)))))

(deftest a-malformed-record-update-is-refused
  (testing "a field the record does not declare"
    (is (not (kir/only-native-word-typed-features?
              (typed-hir (list 'record-get rec (list 'record-assoc rec (list 'record-new rec 1 2) :z 7) :a))))))
  (testing "a computed field"
    (is (not (kir/only-native-word-typed-features?
              (typed-hir (list 'record-get rec (list 'record-assoc rec (list 'record-new rec 1 2) 'k 7) :a))))))
  (testing "an operand the gate refuses is still refused inside an update"
    (is (not (kir/only-native-word-typed-features?
              (typed-hir (list 'record-get rec (list 'record-assoc rec (list 'record-new rec 1 2) :a
                                                     '(map-new)) :a))))))
  (testing "the wrong arity"
    (is (not (kir/only-native-word-typed-features?
              (typed-hir (list 'record-get rec (list 'record-assoc rec (list 'record-new rec 1 2) :a) :a)))))))
