(ns kotoba.kir-dequant-ptq1-test
  "The oracle for PTQ1_0, Prism's group-128 ternary (kotoba-gmir ADR 0031).

  402 of the Ternary Bonsai 2 27B artifact's 851 tensors are PTQ1_0. A block
  is 28 bytes: `qs[24]` holding five base-3 digits per byte, `qh[2]` holding
  four, then `d` as fp16. A weight is `(digit - 1) * d`.

  WHAT IS INDEPENDENT HERE. The reference below is a transcription of
  `dequantize_row_ptq1_0` (PrismML-Eng/llama.cpp @9a9394a8,
  `ggml/src/ggml-quants.c:2255`) written with the C's own three nested stage
  loops and a mutable output cursor, where the oracle derives each element's
  byte and digit from its index. An off-by-one in one is not an off-by-one in
  the other. The half-precision scale is decoded here by its definition
  (normal halves only, which is all the fixtures use), not by the oracle's
  transcription of `fp16_to_f32`.

  The comparison is ELEMENT BY ELEMENT through one-hot folds, then a whole
  multi-block row against `dot_scalar`'s tree. NO REAL MODEL BYTES: the
  fixtures are synthesised so every byte differs from its neighbours."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.kir :as kir]
            [kotoba.kir.value :as value]))

(defn- f32 [x] #?(:clj (float x) :cljs (js/Math.fround x)))
(defn- fmul [x y] #?(:clj (float (* (float x) (float y))) :cljs (js/Math.fround (* x y))))
(defn- fadd [x y] #?(:clj (float (+ (float x) (float y))) :cljs (js/Math.fround (+ x y))))

(defn- bits [x]
  #?(:clj (long (value/f32-to-i64-bits (f32 x)))
     :cljs (js/Number (value/f32-to-i64-bits (f32 x)))))

(defn- f32-le-bytes [x]
  (let [b (bits x)]
    (mapv #(bit-and (bit-shift-right b (* 8 %)) 255) (range 4))))

(defn- w [x] #?(:clj x :cljs (js/Number x)))

(defn- signless-zero
  "A -0.0 weight comes back from a one-hot fold as +0.0 (`+0.0 + -0.0`), so
  both sides are normalised as bit patterns."
  [pattern] (if (= pattern -2147483648) 0 pattern))

(defn- half->f32
  "A NORMAL binary16 by its definition: (-1)^s * 2^(e-15) * (1 + m/1024)."
  [h]
  (let [s (if (zero? (bit-and h 0x8000)) 1 -1)
        e (bit-and (bit-shift-right h 10) 0x1f)
        m (bit-and h 0x3ff)]
    (assert (< 0 e 31) "the fixtures use normal halves only")
    (f32 (* s (Math/pow 2 (- e 15)) (+ 1 (/ m 1024.0))))))

;; ---------------------------------------------------------------------------
;; the reference: the C's loops
;; ---------------------------------------------------------------------------

(def ^:private pow3 [1 3 9 27 81])

(defn- reference-ptq1-0
  "`dequantize_row_ptq1_0` for ONE block, with the C's loop nest."
  [b]
  (let [d (half->f32 (+ (nth b 26) (* 256 (nth b 27))))
        out (atom [])
        emit! (fn [byte n]
                (let [q (bit-and (* byte (nth pow3 n)) 255)
                      xi (bit-shift-right (* q 3) 8)]
                  (swap! out conj (fmul (f32 (- xi 1)) d))))]
    (dotimes [n 5] (dotimes [m 16] (emit! (nth b m) n)))
    (dotimes [n 5] (dotimes [m 8] (emit! (nth b (+ 16 m)) n)))
    (dotimes [n 4] (dotimes [h 2] (emit! (nth b (+ 24 h)) n)))
    @out))

(defn- block
  "A 28-byte block whose code bytes all differ, with scale HALF."
  [seed half]
  (vec (concat (mapv #(bit-and (+ (* 37 %) (* 101 seed) 11) 255) (range 26))
               [(bit-and half 255) (bit-shift-right half 8)])))

;; ---------------------------------------------------------------------------
;; the module under test
;; ---------------------------------------------------------------------------

(def ^:private head 'kernel-dequant-dot-ptq1-0)

(defn- module []
  {:format :kotoba.kir/v4
   :entry 'main
   :effects #{}
   :functions [{:name 'main
                :params '[w-base w-length x-base x-length blocks]
                :param-types [:i64 :i64 :i64 :i64 :i64]
                :result :i64 :effects #{}
                :body (list head 'w-base 'w-length 'x-base 'x-length 'blocks)}]})

(def ^:private image-base 4096)

(defn- run [packed activations blocks]
  (let [image {:base image-base
               :bytes (volatile! (vec (concat packed (mapcat f32-le-bytes activations))))}]
    (w (kir/execute (module) 'main
                    [image-base (count packed)
                     (+ image-base (count packed)) (* 4 (count activations)) blocks]
                    {:memory image :fuel 40000000}))))

(defn- one-hot [n i] (mapv (fn [j] (if (= i j) (f32 1.0) (f32 0.0))) (range n)))

(defn- dot-scalar
  "`dot_scalar`'s tree: four accumulators, lower half of each group of eight
  before its upper half, `(s0+s1)+(s2+s3)` at the end."
  [ws xs]
  (let [p (fn [i] (fmul (nth ws i) (nth xs i)))
        [s0 s1 s2 s3] (reduce (fn [[a0 a1 a2 a3] g]
                                (let [i (* 8 g)]
                                  [(fadd (fadd a0 (p i)) (p (+ i 4)))
                                   (fadd (fadd a1 (p (+ i 1))) (p (+ i 5)))
                                   (fadd (fadd a2 (p (+ i 2))) (p (+ i 6)))
                                   (fadd (fadd a3 (p (+ i 3))) (p (+ i 7)))]))
                              (mapv f32 [0 0 0 0])
                              (range (quot (count ws) 8)))]
    (fadd (fadd s0 s1) (fadd s2 s3))))

;; 0x3555 ~ 0.33325, 0xB8CD = -0.60009765625, 0x4C00 = 16.0
(def ^:private halves [0x3555 0xB8CD 0x4C00])

;; ---------------------------------------------------------------------------

(deftest ptq1-0-dequantizes-what-the-c-dequantizes
  (doseq [[seed half] (map vector (range) halves)]
    (let [b (block seed half)
          expected (reference-ptq1-0 b)
          disagreements (filterv
                         (fn [i]
                           (not= (signless-zero (bits (nth expected i)))
                                 (signless-zero (run b (one-hot 128 i) 1))))
                         (range 128))]
      (println (str "SCANNED\t128\tDISAGREEMENTS\t" (count disagreements)
                    "\t" head "\td=" half))
      (is (= 128 (count expected)))
      (is (empty? disagreements) (str "disagrees at " (take 4 disagreements))))))

(deftest the-synthesised-blocks-reach-all-three-digits
  ;; A comparison of two all-zero rows sees nothing. Every block must produce
  ;; -d, 0 and +d, and in more than one stage.
  (doseq [[seed half] (map vector (range) halves)]
    (let [values (reference-ptq1-0 (block seed half))
          d (half->f32 half)]
      (is (= #{(fmul (f32 -1) d) (fmul (f32 0) d) d} (set values)) (str "d=" half))
      (doseq [[lo hi] [[0 80] [80 120] [120 128]]]
        (is (< 1 (count (distinct (subvec values lo hi))))
            (str "stage " lo ".." hi " is not constant"))))))

(deftest a-whole-row-folds-with-dot-scalars-tree
  ;; Three blocks, 384 elements, activations that differ everywhere: the
  ;; accumulators carry ACROSS blocks, which a one-block test cannot see.
  (let [packed (vec (mapcat (fn [[seed half]] (block seed half))
                            (map vector (range) halves)))
        ws (vec (mapcat (fn [[seed half]] (reference-ptq1-0 (block seed half)))
                        (map vector (range) halves)))
        ;; Seven binades and a non-dyadic mantissa, so that summation order
        ;; changes the rounding (asserted below, not assumed).
        xs (mapv #(f32 (* (/ (- (mod (* 7919 %) 1000) 500) 97.0)
                          (Math/pow 2 (- (mod % 7) 3))))
                 (range 384))
        expected (dot-scalar ws xs)]
    (is (= (bits expected) (run packed xs 3)))
    (testing "and a different tree is a different answer here"
      ;; Left to right is the other order a port writes. If it agreed on this
      ;; fixture the assertion above could not tell the trees apart.
      (is (not= (bits expected)
                (bits (reduce fadd (f32 0) (map fmul ws xs))))))))

(deftest a-perturbed-reference-disagrees-with-the-oracle
  (testing "the qh stage reads qh[h] with n = q/2, not n = q mod 4"
    (let [b (block 0 0x3555)
          right (reference-ptq1-0 b)
          d (half->f32 0x3555)
          wrong-tail (vec (for [q (range 8)]
                            (let [byte (nth b (+ 24 (mod q 2)))
                                  n (mod q 4)]
                              (fmul (f32 (- (bit-shift-right
                                             (* (bit-and (* byte (nth pow3 n)) 255) 3) 8)
                                            1))
                                    d))))]
      (is (not= (subvec right 120 128) wrong-tail))))
  (testing "a block count past the ceiling traps rather than reading"
    ;; 129 blocks is one past the derived limit of 128.
    (is (= :block-count-above-limit
           (:check (try (run (vec (repeat 28 0)) (one-hot 128 0) 129) nil
                        (catch :default e (ex-data e))))))
    (testing "and 128, the limit itself, is admitted as far as the spans"
      ;; 128 blocks against a 28-byte window: the span check, not the limit.
      (is (= :blocks-outside-window
             (:check (try (run (vec (repeat 28 0)) (one-hot 128 0) 128) nil
                          (catch :default e (ex-data e)))))))))
