(ns kotoba.kir-native-document-symbol-test
  "`(document-symbol (symbol text))` is the one position where native admits the
  `symbol` operation (a symbol is the text of its name; the document helper
  validates the name). `symbol` anywhere else stays refused."
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.kir :as kir]))

(defn- hir [body]
  {:format :kotoba.hir/v3 :entry 'main :exports ['main]
   :functions [{:name 'main :params ['s] :param-types [:string] :result :i64
                      :body (list 'let ['d body] 0)}]})

(deftest document-symbol-of-symbol-is-admitted
  (is (true? (kir/only-native-word-typed-features?
              (hir (list 'document-symbol (list 'symbol 's)))))))

(deftest symbol-outside-document-symbol-is-refused
  (is (false? (kir/only-native-word-typed-features?
               (hir (list 'document-vector (list 'document-symbol 's) (list 'symbol 's)))))))
