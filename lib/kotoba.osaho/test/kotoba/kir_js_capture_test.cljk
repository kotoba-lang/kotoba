(ns kotoba.kir-js-capture-test
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.kir :as kir]
            [kotoba.test-hir :as fixture]))

(defn program [body]
  (kir/lower
    (fixture/module
      {:format :kotoba.hir/v3 :entry nil :exports ['keep] :result nil
       :functions [{:name 'keep :params ['v] :param-types [:js-value]
                    :result :js-value :body body}
                   {:name 'dispatch :params ['closure] :param-types [:i64]
                    :closure-param-indexes [0] :result :js-value
                    :body '(if (= (pair-first closure) 7)
                             (js-capture-value (pair-second (pair-second closure)))
                             (js-undefined))}]})))

(defn trap-of [thunk]
  (try (thunk) :no-trap
       (catch #?(:clj Throwable :cljs :default) e (:trap (ex-data e)))))

#?(:cljs
   (deftest opaque-cells-retain-identity-and-mixed-closure-chains
     (let [reads (atom 0)
           proxy (js/Proxy. #js {} #js {:get (fn [& _] (swap! reads inc) (throw (js/Error. "get")))
                                      :getPrototypeOf (fn [& _] (swap! reads inc) (throw (js/Error. "prototype")))})
           revoked (.revocable js/Proxy #js {} #js {})
           _ ((.-revoke revoked))
           values [nil js/undefined false true 0 (- 0.0) js/NaN (js/BigInt "0") "" (js/Symbol "x") #js {} #js [] proxy (.-proxy revoked)]]
       (doseq [body ['(js-capture-value (js-capture-new v 0))
                    '(dispatch (pair 7 (pair 5 (js-capture-new v 0))))]
               :let [p (program body)]
               v values]
         (is (js/Object.is v (kir/execute p 'keep [v] {}))))
       (is (= 0 @reads)))))

#?(:cljs
   (deftest opaque-cell-projections-refuse-integer-and-forged-cells
     (doseq [[body trap]
             [['(js-capture-value 0) :invalid-js-capture-cell]
              ['(js-capture-value (pair 9 0)) :invalid-js-capture-cell]
              ['(pair-first (js-capture-new v 0)) :js-capture-projection]
              ['(js-capture-new v) :js-operation-arity]
              ['(js-capture-value 0 0) :js-operation-arity]
              ['(js-capture-value -1) :invalid-js-capture-cell]
              ['(js-capture-new v v) :value-type-mismatch]]]
       (is (= trap (trap-of #(kir/execute (program body) 'keep [js/undefined] {})))))))

#?(:cljs
   (deftest opaque-cells-use-existing-allocation-budgets
     (let [p (program '(let [unused (js-capture-new v 0)]
                        (js-capture-value (js-capture-new v 0))))]
       (is (js/Object.is js/undefined (kir/execute p 'keep [js/undefined] {:fuel 3 :cells 2})))
       (is (= :budget/fuel (trap-of #(kir/execute p 'keep [js/undefined] {:fuel 2}))))
       (is (= :budget/cells (trap-of #(kir/execute p 'keep [js/undefined] {:cells 1}))))
       (is (js/Object.is js/undefined (kir/execute p 'keep [js/undefined] {:pair-capacity 2})))
       (is (= :budget/cells (trap-of #(kir/execute p 'keep [js/undefined] {:pair-capacity 1})))))))

#?(:cljs
   (deftest opaque-cells-do-not-widen-the-closure-capture-limit
     (let [chain (fn [n] (reduce (fn [tail _] (list 'js-capture-new 'v tail)) 0 (range n)))]
       (is (js/Object.is js/undefined
                         (kir/execute (program (list 'dispatch (list 'pair 7 (list 'pair 5 (chain 4)))))
                                      'keep [js/undefined] {})))
       (is (= :invalid-closure-capture-chain
              (trap-of #(kir/execute (program (list 'dispatch (list 'pair 7 (list 'pair 5 (chain 5)))))
                                     'keep [js/undefined] {})))))))

#?(:clj
   (deftest opaque-cell-operations-require-the-js-host
     (doseq [body ['(js-capture-new (js-undefined) 0) '(js-capture-value 0)]]
       (let [p {:format :kotoba.kir/v4 :entry 'main :exports ['main]
                :functions [{:name 'main :params [] :param-types [] :result :i64
                             :body (list 'do body 0)}]}]
         (is (= :js-value-host (trap-of #(kir/execute p 'main [] {}))))))))

#?(:cljs
   (deftest malformed-opaque-handles-refuse-without-property-observation
     (let [reads (atom 0)
           proxy (js/Proxy. #js {} #js {:get (fn [& _] (swap! reads inc) (throw (js/Error. "get")))
                                      :getPrototypeOf (fn [& _] (swap! reads inc) (throw (js/Error. "prototype")))})
           revoked (.revocable js/Proxy #js {} #js {})
           _ ((.-revoke revoked))
           p (program '(js-capture-value v))
           bad-tail (program '(js-capture-new v v))]
       (doseq [v [proxy (.-proxy revoked)]]
         (is (= :invalid-js-capture-cell (trap-of #(kir/execute p 'keep [v] {}))))
         (is (= :value-type-mismatch (trap-of #(kir/execute bad-tail 'keep [v] {})))))
       (is (= 0 @reads)))))
