(ns kotoba.kir-text-slots-test
  "The ABI v7 text heads at the KIR level -- `string-compare`,
  `string-fold-ascii`, `string-find-blank`, `string-skip-blank` -- pinned
  here as reference semantics, in UTF-8 byte coordinates, on both hosts
  (i64 answers are BigInts on cljs, compared as text)."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.kir :as ir]
            [kotoba.test-hir :as test-hir]))

(defn- module [result body]
  (test-hir/module
   {:format :kotoba.hir/v3
    :entry 'main
    :exports '[main]
    :result result
    :schemas {}
    :schema-identities {}
    :functions [{:name 'main :params [] :param-types [] :result result
                 :body body}]}))

(defn- run [result body] (ir/execute (ir/lower (module result body)) 'main []))
(defn- n [body] (str (run :i64 body)))

(deftest string-compare-is-byte-order
  (is (= "-1" (n '(string-compare "a" "b"))))
  (is (= "1" (n '(string-compare "b" "a"))))
  (is (= "0" (n '(string-compare "abc" "abc"))))
  (is (= "-1" (n '(string-compare "ab" "abc"))) "a proper prefix is less")
  (is (= "-1" (n '(string-compare "" "a"))))
  (is (= "-1" (n '(string-compare "z" "é"))) "z (0x7a) before é (0xc3 0xa9) in byte order")
  (is (= "-1" (n '(string-compare "é" "日"))))
  (is (= "-1" (n '(string-compare "日" "𝄞"))) "an astral code point sorts after a BMP one, as its bytes do")
  (is (= "-1" (n '(string-compare "a\tb" "a\nb"))) "tab (9) before newline (10)"))

(deftest string-fold-ascii-lowers-only-a-to-z
  (is (= "abc" (run :string '(string-fold-ascii "AbC"))))
  (is (= "éclair" (run :string '(string-fold-ascii "éclair"))))
  (is (= "Éclair" (run :string '(string-fold-ascii "Éclair"))) "U+00C9 is not ASCII and is kept")
  (is (= "日本語 abc" (run :string '(string-fold-ascii "日本語 ABC"))))
  (is (= "" (run :string '(string-fold-ascii "")))))

(deftest string-find-blank-and-skip-blank-walk-bytes
  (is (= "1" (n '(string-find-blank "a b" 0))))
  (is (= "-1" (n '(string-find-blank "abc" 0))))
  (is (= "3" (n '(string-find-blank "abc\td" 0))))
  (is (= "9" (n '(string-find-blank "日本語 a" 0))) "byte offset (three 3-byte code points), not code point index")
  (is (= "2" (n '(string-skip-blank "  a" 0))))
  (is (= "3" (n '(string-skip-blank "a  " 1))) "the byte length when the rest is blank")
  (is (= "0" (n '(string-skip-blank "abc" 0))))
  (is (= "-1" (n '(string-find-blank "abc" 3))) "from the end: nothing")
  (is (= "3" (n '(string-find-blank "a b c" 2))))
  (is (= "-1" (n '(string-find-blank "日本語" 3))) "from a boundary inside multi-byte text"))
