(ns kotoba.kir-native-fs-bytes-test
  "fs/app-data-bytes (wire 35) on native: the `:bytes` payload of the file wire. Two
  type pairs, one wire id: `[:string :bytes]` (READ / RANGE) and `[:bytes :bytes]`
  (WRITE / APPEND, the request is the frame <path><TOKEN> then the content bytes).
  Every other id or pair stays refused."
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.kir :as kir]))

(defn- hir [cap request-type result-type request]
  {:format :kotoba.hir/v3 :entry 'main :exports ['main]
   :functions [{:name 'main :params [] :param-types [] :result :i64
                :body (list 'let ['b (list 'typed-cap-call cap request-type result-type request)]
                            (list 'bytes-count 'b))}]})

(deftest a-bytes-read-and-a-bytes-write-are-admitted
  (is (true? (kir/only-native-word-typed-features? (hir 35 :string :bytes "/tmp/a"))))
  (is (true? (kir/only-native-word-typed-features?
              (hir 35 :bytes :bytes (list 'bytes-concat (list 'bytes-empty) (list 'bytes-empty)))))))

(deftest other-ids-and-pairs-are-refused
  (is (false? (kir/only-native-word-typed-features? (hir 34 :string :bytes "/tmp/a"))))
  (is (false? (kir/only-native-word-typed-features? (hir 36 :bytes :bytes '(bytes-empty)))))
  (is (false? (kir/only-native-word-typed-features? (hir 35 :bytes :string '(bytes-empty)))))
  (is (false? (kir/only-native-word-typed-features? (hir 35 :i64 :bytes 1)))))

#?(:cljs
   (deftest an-i64-literal-capability-id-is-compared-as-a-number
     ;; nbb reads every KIR integer token as a BigInt, and (= 35 35n) is false: the id of
     ;; a real compile must reach the same decision as the host number in the tests above.
     (is (true? (kir/only-native-word-typed-features?
                 (hir (js/BigInt 35) :string :bytes "/tmp/a"))))
     (is (false? (kir/only-native-word-typed-features?
                  (hir (js/BigInt 34) :string :bytes "/tmp/a"))))))
