(ns kotoba.kir-native-recursive-adt-test
  "Aggregate ABI v8: recursive and generic ADTs as one-word native handles.

  A record, a variant and a heterogeneous vector are each one machine word on
  native (a pair chain, pair(ordinal,payload), a pair chain), so their members
  are admissible whenever they are words too -- including `[:ref q]`, the only
  way a type names itself. The positives are shapes the gate refused before
  v8; the negatives pin that exports, handle equality and undeclared or
  out-of-range references stay refused, each for its own reason."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.kir :as kir]))

(def node
  [:variant :app/node [[:leaf :i64]
                       [:branch [:vector [[:ref :app/node] [:ref :app/node]]]]]])
(def pair [:vector [[:ref :app/node] [:ref :app/node]]])
(def schemas {:app/node node})

(def sum-body
  (list 'variant-match node 'n
        [[:leaf 'x 'x]
         [:branch 'p (list '+ (list 'sum (list 'hetero-vector-at pair 'p 0))
                           (list 'sum (list 'hetero-vector-at pair 'p 1)))]]))

(defn- hir [& {:keys [exports functions schemas] :or {schemas schemas}}]
  {:format :kotoba.hir/v3 :entry 'main :exports (or exports ['main])
   :schemas schemas
   :functions (into [{:name 'main :params [] :param-types [] :result :i64
                      :body (list 'sum (list 'variant-new node :branch
                                             (list 'hetero-vector-new pair
                                                   (list 'variant-new node :leaf 1)
                                                   (list 'variant-new node :leaf 2))))}]
                    functions)})

(def sum-fn {:name 'sum :params ['n] :param-types [node] :result :i64 :body sum-body})

(deftest recursive-variant-through-a-heterogeneous-vector-is-admitted
  (is (true? (kir/only-native-word-typed-features? (hir :functions [sum-fn])))))

(deftest a-reference-parameter-and-a-generic-option-over-it-are-admitted
  (let [option [:option [:ref :app/node]]
        left {:name 'left :params ['n] :param-types [[:ref :app/node]] :result option
              :body (list 'variant-match node 'n
                          [[:leaf '_ (list 'option-none-of option)]
                           [:branch 'p (list 'option-some-of option
                                             (list 'hetero-vector-at pair 'p 0))]])}]
    (is (true? (kir/only-native-word-typed-features? (hir :functions [sum-fn left]))))))

(deftest refusals-keep-their-reasons
  (testing "an EXPORTED function stays on the host-validated boundary set"
    (is (false? (kir/only-native-word-typed-features?
                 (hir :exports ['main 'sum] :functions [sum-fn])))))
  (testing "structural equality over handles compares cells, not values"
    (is (false? (kir/only-native-word-typed-features?
                 (hir :functions
                      [sum-fn {:name 'same :params ['a] :param-types [pair] :result :bool
                               :body (list 'hetero-vector-equal pair 'a 'a)}])))))
  (testing "a reference the schema table does not declare"
    (is (false? (kir/only-native-word-typed-features?
                 (hir :schemas {} :functions [sum-fn])))))
  (testing "an index outside the declared positions"
    (is (false? (kir/only-native-word-typed-features?
                 (hir :functions
                      [{:name 'sum :params ['n] :param-types [node] :result :i64
                        :body (list 'variant-match node 'n
                                    [[:leaf 'x 'x]
                                     [:branch 'p (list 'sum (list 'hetero-vector-at pair 'p 2))]])}]))))))

(deftest only-a-recursive-schema-table-joins-the-native-program
  (is (true? (kir/recursive-schema-table? schemas)))
  (is (false? (kir/recursive-schema-table?
               {:app/point [:record :app/point [[:x :i64] [:y :i64]]]})))
  (let [kir* {:format :kotoba.kir/v4 :entry 'main :exports ['main] :signature nil
              :effects #{} :functions [] :schemas schemas :schema-identities {}}]
    (is (= schemas (:schemas (kir/native-program kir*))))
    (is (not (contains? (kir/native-program (assoc kir* :schemas {:app/point [:record :app/point [[:x :i64]]]}))
                        :schemas)))))

(deftest a-signature-reference-carries-its-table-into-the-native-program
  ;; amu ADR 0353 floor :native-record-boundary: a declared, non-recursive
  ;; record as a parameter or result. The oracle resolves the reference
  ;; through the table; without it the artifact is refused as
  ;; `:unknown-schema-reference`.
  (let [point [:record :app/point [[:x :i64]]]
        table {:app/point point}
        x-of {:name 'x-of :params ['p] :param-types [[:ref :app/point]] :result :i64
              :effects #{} :body (list 'record-get point 'p :x)}
        make {:name 'make :params [] :param-types [] :result [:ref :app/point]
              :effects #{} :body (list 'record-new point 7)}
        kir* {:format :kotoba.kir/v4 :entry 'main :exports ['main]
              :signature {:params [] :result :i64} :effects #{}
              :schemas table :schema-identities {}}]
    (testing "a reference parameter"
      (let [program (kir/native-program
                     (assoc kir* :functions [x-of {:name 'main :params [] :param-types [] :result :i64
                                                   :effects #{} :body (list 'x-of (list 'record-new point 7))}]))]
        (is (= table (:schemas program)))
        (is (= "7" (str (kir/execute program 'main []))))))
    (testing "a reference result"
      (let [program (kir/native-program
                     (assoc kir* :functions [make {:name 'main :params [] :param-types [] :result :i64
                                                   :effects #{} :body (list 'record-get point (list 'make) :x)}]))]
        (is (= table (:schemas program)))
        (is (= "7" (str (kir/execute program 'main []))))))
    (testing "refused without the table, as the oracle refused it before"
      (is (= :unknown-schema-reference
             (try (kir/execute (dissoc (kir/native-program (assoc kir* :functions [make {:name 'main :params [] :param-types [] :result :i64
                                                                                         :effects #{} :body (list 'record-get point (list 'make) :x)}]))
                                       :schemas)
                               'main [])
                  nil
                  (catch #?(:clj Throwable :cljs :default) e
                    (loop [x e]
                      (or (:trap (ex-data x))
                          (when-let [c (ex-cause x)] (recur c)))))))))))
