(ns kotoba.kir.interp-corpus
  "Shared by interp_diff and interp_lower_diff: EDN of a host value, the host oracle
  outcome of a module, and the corpus (sema test strings, generated programs,
  hand-written probes). Run with the test directory on the classpath."
  (:require ["node:fs" :as fs]
            [cljs.reader]
            [clojure.string :as str]
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]))

(defn ->edn [x]
  (cond
    (nil? x) "nil"
    (boolean? x) (str x)
    (integer? x) (str x)
    (and (exists? js/BigInt) (= js/BigInt (.-constructor x))) (str x)
    (string? x) (pr-str x)
    (keyword? x) (str x)
    (symbol? x) (str x)
    (seq? x) (str "(" (str/join " " (map ->edn x)) ")")
    (vector? x) (str "[" (str/join " " (map ->edn x)) "]")
    (set? x) (str "#{" (str/join " " (map ->edn x)) "}")
    (map? x) (str "{" (str/join " " (mapcat (fn [[k v]] [(->edn k) (->edn v)]) x)) "}")
    :else (throw (ex-info "no-edn" {:x (pr-str x)}))))

;; ---- host side ----

(defn trap-name [e]
  (loop [x e]
    (when x
      (let [t (:trap (ex-data x))]
        (cond t (subs (str t) 1)
              :else (recur (.-cause x)))))))

(defn fmt-value
  "V:<hi>:<lo> (arithmetic high word, unsigned low word): the Kotoba route cannot
  print an i64 minimum with string-from-i64, so values are compared in halves."
  [v]
  (if (boolean? v)
    (str "B:" v)
    (let [b (js/BigInt v)
          lo (js/BigInt.asUintN 32 b)
          hi (/ (- b lo) (js/BigInt 4294967296))]
      (str "V:" hi ":" lo))))

(defn host-outcome
  "V:/B:/T: for a module host `lower` oracles, nil when it does not (or rejects).
  X when the oracle run itself throws an error that names no trap (a value check
  of kotoba.kir.value): `lower` refuses the module, so the Kotoba side must answer
  a non-resource trap (or N), never a value."
  [hir fuel frames]
  (try
    (let [r (kir/lower hir {:oracle-fuel fuel :oracle-frames frames})]
      (cond (some? (:oracle-value r)) (fmt-value (:oracle-value r))
            (:oracle-inconclusive r) (str "T:" (subs (str (:oracle-inconclusive r)) 1))
            :else nil))
    (catch :default e
      (if-let [t (trap-name e)]
        (str "T:" t)
        ;; a value check of the run (kotoba.kir.value throws {:phase :value})
        (when (loop [x e] (cond (nil? x) false (= :value (:phase (ex-data x))) true :else (recur (.-cause x))))
          "X")))))

(def resource-traps #{"T:budget/fuel" "T:budget/cells" "T:budget/bytes" "T:budget/frames" "T:host/stack-exhausted"})

(defn agree?
  "The Kotoba outcome GOT answers the host outcome EXP."
  [exp got]
  (or (= exp got)
      (and (= exp "X") (string? got) (str/starts-with? got "T:") (not (resource-traps got)))))

(def ported-ops
  '#{let if do arena-scope bool-not + - * quot bit-xor bit-and bit-or min max = < > <= >=
     bit-not i64-shift-left i64-shift-right u64-shift-right i32-wrap u32-wrap i32-wrapping-add
     i32-wrapping-mul i32-xor i32-shift-left i32-shift-right u32-shift-right xorshift32
     string-byte-length string-length string-concat string=? string-substring string-code-point-at
     string-from-i64 string-contains? string-index-of string-replace-all string-split-count
     string-compare string-fold-ascii string-index-of-from
     option-some-of option-none-of option-some?-of option-value-of option-match result-ok-of
     result-err-of result-ok?-of result-value-of result-error-of result-match-of typed-list-new
     typed-list-conj typed-list-nth vector-new vector-count vector-at vector-get vector-drop
     vector-take vector-alloc vector-assoc vector-assoc! vector-conj option-some option-none
     option-some? option-value result-ok result-err result-ok? result-value result-error
     bytes-empty bytes-count bytes-at bytes-slice bytes-concat bytes-from-vector-i64 vector-i64-from-bytes
     f64-from-bits f64-to-bits f64-add f64-sub f64-mul f64-div f64-min f64-max f64-neg f64-abs f64-sqrt f64-eq f64-lt f64-le f64-gt f64-ge f64-unordered f32-from-bits f32-to-bits f32-add f32-sub f32-mul f32-div f32-min f32-max f32-neg f32-abs f32-sqrt f32-eq f32-lt f32-le f32-gt f32-ge f32-unordered i64-to-f64-checked i64-to-f64-rounded f64-to-i64-checked f64-to-i64-truncating f64-to-f32-rounded f32-to-f64-exact i64-to-f32-checked i64-to-f32-rounded f32-to-i64-checked f32-to-i64-truncating
     document-null document-bool document-i64 document-f64 document-string document-keyword document-vector document-list document-map document-count document-kind document-vector-at document-list-at document-vector-assoc document-vector-conj document-vector-drop document-vector-remove document-map-entry-at document-equal? document-contains document-get document-assoc document-dissoc document-merge document-string-value document-keyword-value document-bool-value document-i64-value document-f64-value
     pair pair-first pair-second record-new record-get variant-new variant-match hetero-vector-new hetero-vector-at hetero-vector-assoc
     typed-set-new typed-set-count vector-f64-new vector-f64-count vector-f64-get vector-f64-at vector-f64-drop
     vector-f64-take vector-f64-assoc vector-f64-conj string-from-utf8 string-compare-lines string-find-byte
     string-append-range string-find-blank string-skip-blank})

(defn heads [body]
  (->> (tree-seq coll? seq body)
       (filter #(and (seq? %) (symbol? (first %))))
       (map first)))

(defn unported-heads [hir]
  (let [fns (set (map :name (:functions hir)))]
    (->> (:functions hir) (mapcat (comp heads :body))
         (remove #(or (ported-ops %) (fns %))))))

(defn slim
  "Only what the interpreter reads: the entry and each function's name, parameters,
  types, result, body and refinements (a smaller text to parse on the Kotoba side)."
  [hir]
  (cond-> {:entry (:entry hir)
           :functions (mapv #(select-keys % [:name :params :param-types :result :body :closure-param-indexes
                                             :i64-pair-chain-param-indexes :closure-result?])
                            (:functions hir))}
    (seq (:schemas hir)) (assoc :schemas (:schemas hir))))

(defn oracle-module? [hir]
  (and (:entry hir) (contains? #{:i64 :bool} (:result hir)) (every? #{:state :abort} (:effects hir))))

;; ---- corpus ----

(defn strings-in [file]
  (let [text (.readFileSync fs file "utf8")]
    (keep (fn [m] (try (js/JSON.parse (str "\"" (second m) "\"")) (catch :default _ nil)))
          (re-seq #"\"((?:[^\"\\\\]|\\\\.)*)\"" text))))

(defn try-analyze [s]
  (or (try (sema/analyze s) (catch :default _ nil))
      (try (sema/analyze (str s "\n(defn main [] :i64 0)")) (catch :default _ nil))))

(defn corpus-hirs [dirs]
  (let [files (mapcat (fn [d] (->> (.readdirSync fs d)
                                   (filter #(str/ends-with? % ".cljk"))
                                   (map #(str d "/" %))))
                      dirs)
        cands (->> files (mapcat strings-in)
                   (filter #(and (str/starts-with? (str/triml %) "(") (re-find #"\(defn?\b" %)))
                   distinct)]
    (keep try-analyze cands)))

;; ---- generated programs ----

(defn make-rng [seed]
  (let [s (atom (bit-or 1 (js/Math.abs (or seed 1))))]
    (fn [n] ;; xorshift on 31 bits, plenty for a fuzzer
      (let [x @s
            x (bit-and (bit-xor x (bit-shift-left x 13)) 0x7fffffff)
            x (bit-xor x (bit-shift-right x 17))
            x (bit-and (bit-xor x (bit-shift-left x 5)) 0x7fffffff)]
        (reset! s (if (zero? x) 12345 x))
        (mod @s n)))))

(def lits ["0" "1" "2" "3" "7" "10" "31" "32" "63" "64" "-1" "-2" "100" "255" "4294967295" "4294967296"
           "9223372036854775807" "-9223372036854775807" "1000003"])

(def str-lits ["" "a" "abc" "abcabc" "Hello, World" "h\u00e9llo w\u00f6rld" "\ud834\udd1e" "\ud834\udd1eab" "\u65e5\u672c\u8a9e" "aXbXc" "-" "  x  " "ABCxyz"])

(declare gen-expr)

(defn gen-str [rnd depth vars fns]
  (let [pick (fn [xs] (nth xs (rnd (count xs))))
        lit (fn [] (pr-str (pick str-lits)))]
    (if (<= depth 0)
      (lit)
      (let [ss #(gen-str rnd (dec depth) vars fns)
            ii #(if (< (rnd 3) 2) (str (rnd 12)) (gen-expr rnd (dec depth) vars fns))]
        (case (rnd 9)
          (0 1) (lit)
          2 (str "(string-concat " (ss) " " (ss) ")")
          3 (str "(string-substring " (ss) " " (ii) " " (ii) ")")
          4 (str "(string-from-i64 " (ii) ")")
          5 (str "(string-replace-all " (ss) " " (ss) " " (ss) ")")
          6 (str "(string-fold-ascii " (ss) ")")
          7 (str "(let [sv " (ss) "] (string-concat sv sv))")
          8 (str "(if (string=? " (ss) " " (ss) ") " (ss) " " (ss) ")"))))))

(defn gen-str-int [rnd depth vars fns]
  (let [pick (fn [xs] (nth xs (rnd (count xs))))
        ss #(gen-str rnd (max 0 (dec depth)) vars fns)
        ii #(if (< (rnd 3) 2) (str (rnd 12)) (gen-expr rnd (dec depth) vars fns))]
    (case (rnd 9)
      0 (str "(string-byte-length " (ss) ")")
      1 (str "(string-code-point-at " (ss) " " (ii) ")")
      2 (str "(string-index-of " (ss) " " (ss) ")")
      3 (str "(string-compare " (ss) " " (ss) ")")
      4 (str "(if (string=? " (ss) " " (ss) ") " (ii) " " (ii) ")")
      5 (str "(if (string-contains? " (ss) " " (ss) ") " (ii) " " (ii) ")")
      6 (str "(string-index-of-from " (ss) " " (ss) " " (ii) ")")
      7 (str "(string-split-count " (ss) " " (ss) ")")
      8 (str "(string-length " (ss) ")"))))

(defn gen-agg-int [rnd depth vars fns]
  (let [ii #(if (< (rnd 3) 2) (str (- (rnd 8) 1)) (gen-expr rnd (max 0 (dec depth)) vars fns))
        vec3 #(str "(vector-new " (ii) " " (ii) " " (ii) ")")
        OI "[:option :i64]" RI "[:result :i64 :i64]" LI "[:list :i64]"
        opt #(if (zero? (rnd 2)) (str "(option-some-of " OI " " (ii) ")") (str "(option-none-of " OI ")"))
        res #(if (zero? (rnd 2)) (str "(result-ok-of " RI " " (ii) ")") (str "(result-err-of " RI " " (ii) ")"))]
    (case (rnd 14)
      0 (str "(vector-at " (vec3) " " (ii) ")")
      1 (str "(vector-count (vector-conj " (vec3) " " (ii) "))")
      2 (str "(vector-get " (vec3) " " (ii) " " (ii) ")")
      3 (str "(vector-at (vector-assoc " (vec3) " " (ii) " " (ii) ") " (ii) ")")
      4 (str "(vector-count (vector-drop " (vec3) " " (ii) "))")
      5 (str "(vector-count (vector-take " (vec3) " " (ii) "))")
      6 (str "(typed-list-nth " LI " (typed-list-conj " LI " (typed-list-new " LI " " (ii) " " (ii) ") " (ii) ") " (ii) ")")
      7 (str "(option-value-of " OI " " (opt) " " (ii) ")")
      8 (str "(option-match " OI " " (opt) " " (ii) " x (+ x " (ii) "))")
      9 (str "(result-value-of " RI " " (res) " " (ii) ")")
      10 (str "(result-error-of " RI " " (res) " " (ii) ")")
      11 (str "(result-match-of " RI " " (res) " a (+ a " (ii) ") b (* b " (ii) "))")
      12 (str "(if (option-some?-of " OI " " (opt) ") " (ii) " " (ii) ")")
      13 (str "(if (result-ok?-of " RI " " (res) ") " (ii) " " (ii) ")"))))

(defn gen-expr [rnd depth vars fns]
  (let [pick (fn [xs] (nth xs (rnd (count xs))))
        atom-expr (fn [] (if (and (seq vars) (< (rnd 10) 7)) (pick vars) (pick lits)))]
    (if (<= depth 0)
      (atom-expr)
      (let [sub #(gen-expr rnd (dec depth) vars fns)
            c (rnd 37)]
        (case c
          (0 1 2) (str "(" (pick ["+" "-" "*"]) " " (sub) " " (sub) ")")
          3 (str "(" (pick ["bit-and" "bit-or" "bit-xor" "min" "max"]) " " (sub) " " (sub) ")")
          4 (str "(quot " (sub) " " (sub) ")")
          5 (str "(rem " (sub) " " (sub) ")")
          6 (str "(" (pick ["i64-shift-left" "i64-shift-right" "u64-shift-right"]) " " (sub) " "
                 (if (< (rnd 4) 3) (str (rnd 64)) (sub)) ")")
          7 (str "(if " (str "(" (pick ["<" ">" "<=" ">=" "="]) " " (sub) " " (sub) ")") " " (sub) " " (sub) ")")
          8 (let [v (str "v" (rnd 3))]
              (str "(let [" v " " (sub) "] " (gen-expr rnd (dec depth) (conj vars v) fns) ")"))
          9 (str "(bit-not " (sub) ")")
          10 (if (seq fns)
               (let [[f n] (pick fns)]
                 (str "(" f " " (str/join " " (repeatedly n sub)) ")"))
               (atom-expr))
          11 (str "(when-not (< " (sub) " " (sub) ") " (sub) ")")
          12 (str "(cond (< " (sub) " " (sub) ") " (sub) " (> " (sub) " 5) " (sub) " :else " (sub) ")")
          13 (str "(mod " (sub) " " (sub) ")")
          14 (str "(inc " (sub) ")")
          15 (str "(dec " (sub) ")")
          16 (str "(if (zero? " (sub) ") " (sub) " " (sub) ")")
          17 (str "(if (and (< " (sub) " " (sub) ") (> " (sub) " 0)) " (sub) " " (sub) ")")
          18 (str "(if (or (< " (sub) " 3) (even? " (sub) ")) " (sub) " " (sub) ")")
          19 (str "(loop [i 0 acc " (sub) "] (if (< i " (inc (rnd 6)) ") (recur (inc i) (+ acc (* i " (sub) "))) acc))")
          20 (str "(" (pick ["i32-wrap" "u32-wrap" "xorshift32"]) " " (sub) ")")
          21 (str "(" (pick ["i32-wrapping-add" "i32-wrapping-mul" "i32-xor" "i32-shift-left" "i32-shift-right" "u32-shift-right"]) " "
                  (sub) " " (if (< (rnd 3) 2) (str (rnd 32)) (sub)) ")")
          (22 23 24 25 26 27 28 29) (gen-str-int rnd depth vars fns)
          (30 31 32 33 34 35 36) (gen-agg-int rnd depth vars fns))))))

(defn gen-program [rnd]
  (let [nf (inc (rnd 4))
        defs (loop [i 0 fns [] out []]
               (if (= i nf)
                 [fns out]
                 (let [arity (inc (rnd 3))
                       ps (mapv #(str "p" %) (range arity))
                       body (gen-expr rnd (+ 1 (rnd 4)) ps fns)
                       name (str "f" i)]
                   (recur (inc i) (conj fns [name arity])
                          (conj out (str "(defn " name " [" (str/join " " (map #(str % " :i64") ps)) "] :i64 " body ")"))))))
        [fns out] defs
        bool? (zero? (rnd 5))
        call (fn [] (let [[f n] (nth fns (rnd (count fns)))]
                      (str "(" f " " (str/join " " (repeatedly n #(nth lits (rnd (count lits))))) ")")))
        main (if bool?
               (str "(defn main [] :bool (" (nth ["<" ">" "=" "<=" ">="] (rnd 5)) " " (call) " " (call) "))")
               (str "(defn main [] :i64 " (if (zero? (rnd 3)) (str "(+ " (call) " " (call) ")") (call)) ")"))]
    (str (str/join "\n" out) "\n" main)))

(def hand-src
  ["(defn main [] :i64 (+ 1 2))"
   "(defn main [] :i64 (quot 7 0))"
   "(defn main [] :i64 (quot -9223372036854775808 -1))"
   "(defn main [] :i64 (rem 9 0))"
   "(defn main [] :i64 (i64-shift-left 1 64))"
   "(defn main [] :i64 (i64-shift-right -8 1))"
   "(defn main [] :i64 (u64-shift-right -8 1))"
   "(defn main [] :i64 (i64-shift-left 1 -1))"
   "(defn main [] :i64 (i32-shift-left 1 32))"
   "(defn main [] :i64 (i32-shift-left 1 31))"
   "(defn main [] :i64 (u32-shift-right -1 4))"
   "(defn main [] :i64 (xorshift32 2463534242))"
   "(defn main [] :i64 (i32-wrapping-mul 65536 65536))"
   "(defn main [] :i64 (i32-wrapping-add 2147483647 1))"
   "(defn main [] :i64 (* 9223372036854775807 9223372036854775807))"
   "(defn main [] :i64 (+ 9223372036854775807 1))"
   "(defn main [] :i64 (- -9223372036854775807 2))"
   "(defn main [] :i64 (string-byte-length \"h\u00e9llo\"))"
   "(defn main [] :i64 (string-byte-length (string-concat \"ab\" \"cd\")))"
   "(defn main [] :i64 (string-code-point-at \"h\u00e9llo\" 1))"
   "(defn main [] :i64 (string-code-point-at \"h\u00e9llo\" 2))"
   "(defn main [] :i64 (string-code-point-at \"abc\" 3))"
   "(defn main [] :i64 (string-byte-length (string-substring \"abcdef\" 2 4)))"
   "(defn main [] :i64 (string-byte-length (string-substring \"abcdef\" 4 2)))"
   "(defn main [] :i64 (string-byte-length (string-substring \"h\u00e9llo\" 2 4)))"
   "(defn main [] :bool (string=? (string-from-i64 -42) \"-42\"))"
   "(defn main [] :bool (string=? (string-from-i64 -9223372036854775808) \"-9223372036854775808\"))"
   "(defn main [] :i64 (string-index-of \"h\u00e9llo w\u00f6rld\" \"w\u00f6\"))"
   "(defn main [] :i64 (string-index-of \"abc\" \"\"))"
   "(defn main [] :bool (string-contains? \"abc\" \"bc\"))"
   "(defn main [] :bool (string-contains? \"abc\" \"\"))"
   "(defn main [] :i64 (string-split-count \"a,b,c\" \",\"))"
   "(defn main [] :i64 (string-split-count \"a,b,c\" \"\"))"
   "(defn main [] :bool (string=? (string-replace-all \"a-b-c\" \"-\" \"++\") \"a++b++c\"))"
   "(defn main [] :i64 (string-byte-length (string-replace-all \"abc\" \"\" \"x\")))"
   "(defn main [] :i64 (string-compare \"abc\" \"abd\"))"
   "(defn main [] :i64 (string-compare \"b\" \"abd\"))"
   "(defn main [] :bool (string=? (string-fold-ascii \"ABCxyz\\u00c9\") \"abcxyz\\u00c9\"))"
   "(defn rep [s :string n :i64] :string (if (<= n 0) s (rep (string-concat s s) (- n 1))))\n(defn main [] :i64 (string-byte-length (rep \"abcd\" 12)))"
   "(defn rep [s :string n :i64] :string (if (<= n 0) s (rep (string-concat s s) (- n 1))))\n(defn main [] :i64 (string-byte-length (rep \"abcd\" 20)))"
   "(defn f [s :string] :i64 (string-byte-length s))\n(defn main [] :i64 (f \"hello\"))"
   "(defn f [s :string i :i64] :string (string-substring s i (+ i 1)))\n(defn main [] :bool (string=? (f \"hello\" 1) \"e\"))"
   "(defn count-a [s :string] :i64 (loop [i 0 n 0] (if (>= i (string-byte-length s)) n (recur (+ i 1) (if (= (string-code-point-at s i) 97) (+ n 1) n)))))\n(defn main [] :i64 (count-a \"banana bandana\"))"
   "(defn main [] :i64 (let [o (option-some-of [:option :i64] 5)] (if (option-some?-of [:option :i64] o) (option-value-of [:option :i64] o 0) 1)))"
   "(defn main [] :i64 (option-value-of [:option :i64] (option-none-of [:option :i64]) 77))"
   "(defn main [] :i64 (option-match [:option :i64] (option-some-of [:option :i64] 5) 0 x (+ x 100)))"
   "(defn main [] :i64 (option-match [:option :i64] (option-none-of [:option :i64]) 9 x (+ x 100)))"
   "(defn main [] :i64 (result-value-of [:result :i64 :i64] (result-ok-of [:result :i64 :i64] 4) 0))"
   "(defn main [] :i64 (result-error-of [:result :i64 :i64] (result-err-of [:result :i64 :i64] 4) 0))"
   "(defn main [] :i64 (result-value-of [:result :i64 :i64] (result-err-of [:result :i64 :i64] 4) 55))"
   "(defn main [] :bool (result-ok?-of [:result :i64 :i64] (result-err-of [:result :i64 :i64] 4)))"
   "(defn main [] :i64 (result-match-of [:result :i64 :i64] (result-err-of [:result :i64 :i64] 4) v (+ v 1) e (* e 10)))"
   "(defn main [] :i64 (typed-list-nth [:list :i64] (typed-list-conj [:list :i64] (typed-list-new [:list :i64] 1 2 3) 9) 3))"
   "(defn main [] :i64 (typed-list-nth [:list :i64] (typed-list-new [:list :i64] 1 2 3) 3))"
   "(defn main [] :i64 (vector-count (typed-list-new [:list :string] \"a\" \"b\")))"
   "(defn main [] :i64 (let [v (vector-new 1 2 3)] (+ (vector-count v) (vector-at (vector-conj v 7) 3))))"
   "(defn main [] :i64 (vector-at (vector-new 1 2 3) 3))"
   "(defn main [] :i64 (vector-get (vector-new 1 2 3) 5 -1))"
   "(defn main [] :i64 (vector-get (vector-new 1 2 3) 2 -1))"
   "(defn main [] :i64 (vector-count (vector-drop (vector-new 1 2 3) 1)))"
   "(defn main [] :i64 (vector-at (vector-take (vector-new 1 2 3) 2) 1))"
   "(defn main [] :i64 (vector-count (vector-take (vector-new 1 2 3) 4)))"
   "(defn main [] :i64 (vector-at (vector-assoc (vector-new 1 2 3) 1 50) 1))"
   "(defn main [] :i64 (vector-at (vector-alloc 4) 3))"
   "(defn main [] :i64 (vector-count (vector-alloc -1)))"
   "(defn main [] :i64 (let [o (option-some 5)] (if (option-some? o) (option-value o 0) 1)))"
   "(defn main [] :i64 (let [r (result-err 6)] (if (result-ok? r) (result-value r 0) (result-error r 0))))"
