(defn hirs-of-sources [srcs]
  (keep try-analyze srcs))

(defn file-hirs
  "DIFF_FILES=<list file>: one program path per line, relative to DIFF_FILES_ROOT
  (default the list file's directory) unless absolute."
  []
  (if-let [lf (.-DIFF_FILES js/process.env)]
    (let [root (or (.-DIFF_FILES_ROOT js/process.env) (subs lf 0 (str/last-index-of lf "/")))]
      (vec (keep (fn [f]
                   (let [p (if (str/starts-with? f "/") f (str root "/" f))]
                     (try (sema/analyze (.readFileSync fs p "utf8")) (catch :default _ nil))))
                 (remove empty? (str/split-lines (.readFileSync fs lf "utf8"))))))
    []))


(defn candidates
  "The deterministic list of (module, budget) cases: sema corpus, generated, hand."
  [dirs]
  (let [corpus (vec (if (= dirs ["none"]) [] (corpus-hirs dirs)))
        rnd (make-rng (js/parseInt (or (.-DIFF_SEED js/process.env) "20260930")))
        gen-srcs (vec (repeatedly (js/parseInt (or (.-DIFF_GEN js/process.env) "400")) #(gen-program rnd)))
        gen (vec (hirs-of-sources gen-srcs))
        hand (vec (hirs-of-sources hand-src))
        files (file-hirs)
        _ (println "corpus" (count corpus) "generated" (count gen) "/" (count gen-srcs) "hand" (count hand) "/" (count hand-src) "files" (count files))
        groups [["sema" corpus] ["gen" gen] ["hand" hand] ["files" files]]
        budgets (if-let [f (.-DIFF_FUEL js/process.env)] [[(js/parseInt f) 32] [60 5] [50 32]] [[100000 32] [60 5] [50 32]])
        ;; DIFF_BUDGETS=<n>: only the first n budgets; DIFF_FILTER=<text>: only modules whose EDN contains it
        budgets (vec (take (js/parseInt (or (.-DIFF_BUDGETS js/process.env) "3")) budgets))
        flt (.-DIFF_FILTER js/process.env)]
    (vec (for [[g hs] groups
               h hs
               :when (oracle-module? h)
               :let [edn (try (->edn (slim h)) (catch :default _ nil))]
               :when (and edn (< (count edn) (if (= g "files") 200000 12000)) (or (not flt) (some #(str/includes? edn %) (str/split flt #"[|]"))))
               [fuel frames] budgets]
           {:group g :fuel fuel :frames frames :edn edn :hir h}))))


(defn stalled-edns
  "The EDN of every candidate whose host outcome stalled (a :begin row with no result)
  in the cache tools/interp_diff.sh wrote; a module with such a case is excluded."
  [cands cache]
  (let [rows (->> (str/split-lines (.readFileSync fs cache "utf8")) (remove empty?) (map cljs.reader/read-string))
        done (set (keep (fn [[i v]] (when-not (= v :begin) i)) rows))]
    (set (keep (fn [[i v]] (when (and (= v :begin) (not (done i))) (:edn (nth cands i)))) rows))))
