;; The Kotoba side of test/kotoba/kir/admission_diff.cljk, built and run on the seed route
;; (tools/admission_diff.sh): `main` reads the EDN vector of [hir policy] cases at argument 1,
;; runs `kotoba.kir.admission/check` (the Kotoba reading, over `:form/r`) on each, and writes
;; one outcome per case to argument 2, separated by a line "|~|":
;;   OK:<answer>                 the answer, printed as EDN (sets in their Form order)
;;   THROW:<phase> <message>     a refusal (phase :internal when its data names none)
(ns probe.adm-diff-main
  {:kotoba/export [main]}
  (:require [kotoba.form :as form]
            [kotoba.kir.admission :as adm]
            [kotoba.compiler.nbb.io :as io]
            [kotoba.compiler.nbb.cli-support :as support])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                       [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]}))

(defn- pr-items [xs [:list [:ref :form/r]] i :i64 acc :string] :string
  (if (>= i (vector-count xs))
    acc
    (pr-items xs (+ i 1) (string-concat acc (string-concat (if (= i 0) "" " ")
                                                            (pr-form (typed-list-nth [:list [:ref :form/r]] xs i)))))))

(defn- wrap [open :string f [:ref :form/r] close :string] :string
  (string-concat open (string-concat (pr-items (form/kids-of f) 0 "") close)))

(defn pr-form [f [:ref :form/r]] :string
  (cond
    (form/is-nil? f) "nil"
    (form/is-bool? f) (if (form/bool-value f) "true" "false")
    (form/is-int? f) (string-from-i64 (form/int-value f))
    (form/is-string? f) (document-edn-print (document-string (form/string-value f)))
    (form/is-keyword? f) (document-edn-print (document-keyword (form/keyword-value f)))
    (form/is-symbol? f) (form/symbol-value f)
    (form/is-seq? f) (wrap "(" f ")")
    (form/is-vec? f) (wrap "[" f "]")
    (form/is-set? f) (wrap "#{" f "}")
    (form/is-map? f) (wrap "{" f "}")
    :else "nil"))

(defn- phase-of [e :document] :string
  (document-edn-print
   (document-keyword (option-or (document-keyword-value (option-or (document-get (ex-data e) (document-keyword :phase))
                                                                   (document-null)))
                                :internal))))

(defn- one [c [:ref :form/r]] :string
  (try (string-concat "OK:" (pr-form (adm/check (form/nth-of c 0) (form/nth-of c 1))))
       (catch e (string-concat "THROW:" (string-concat (phase-of e) (string-concat " " (ex-message e)))))))

(defn- each [cs [:ref :form/r] i :i64 acc :string] :string
  (if (>= i (form/count-of cs))
    acc
    (each cs (+ i 1) (string-concat acc (string-concat (one (form/nth-of cs i)) "\n|~|\n")))))

(defn main [] :i64
  (try (let [args (support/command-line-args)
             text (io/read-text-file (typed-list-nth [:list :string] args 0))
             out (each (form/edn-form text) 0 "")]
         (io/write-text! (typed-list-nth [:list :string] args 1) out))
       (catch e 1)))
