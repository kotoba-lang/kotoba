;; Probe for `kotoba.kir.kvalue` (Kotoba-only): a Kotoba `main` exercises the
;; Value record and returns a string of check results, run here by the host KIR
;; interpreter through the project route.
;;   KROOTS=<src roots> node --stack-size=8192 nbb/cli.js --classpath <cp> \
;;     test/kotoba/kir/kvalue_probe.cljk
(ns kotoba.kir.kvalue-probe
  (:require ["node:fs" :as fs]
            [clojure.string :as str]
            [kotoba.sema :as sema]
            [kotoba.kir :as kir]
            [kotoba.compiler.project :as project]
            [kotoba.compiler.project-files :as pf]))

(def roots (vec (str/split (.-KROOTS js/process.env) #":")))

(def src
  "(ns probe.kv-main
  {:kotoba/export [main]}
  (:require [kotoba.form :as form] [kotoba.kir.kvalue :as kv])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword] [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
             :kir/v [:record :kir/v [[:tag :i64] [:n :i64] [:s :string] [:k :keyword] [:b :bytes] [:kids [:list [:ref :kir/v]]]]]}))

(defn ck [ok :bool] :string (if ok \"1\" \"0\"))

(defn deep [n :i64] [:ref :kir/v]
  (if (<= n 0) (kv/i64-value 7) (kv/vector-value (kv/one-value (deep (- n 1))))))

(defn depth-of [v [:ref :kir/v]] :i64
  (if (kv/is-vector? v) (+ 1 (depth-of (kv/nth-of v 0))) 0))

(defn main [] :string
  (let [f (form/edn-form \"{:a [1 2 (x y)] :b #{1 2 3} :c \\\"s\\\" :d nil :e true}\")
        v (kv/from-form f)
        g (form/edn-form \"{:e true :d nil :c \\\"s\\\" :b #{3 2 1} :a [1 2 (x y)]}\")
        w (kv/from-form g)
        r1 (kv/record-value \"P\" (kv/two-values (kv/keyword-value :x) (kv/i64-value 1)))
        r2 (kv/record-value \"P\" (kv/two-values (kv/keyword-value :x) (kv/i64-value 1)))
        r3 (kv/record-value \"P\" (kv/two-values (kv/keyword-value :x) (kv/i64-value 2)))]
    (str (ck (kv/well-formed? v))
         (ck (kv/value-eq v w))
         (ck (form/eq f (kv/to-form v)))
         (ck (kv/value-eq r1 r2))
         (ck (not (kv/value-eq r1 r3)))
         (ck (not (kv/value-eq (kv/list-value (kv/no-values)) (kv/vector-value (kv/no-values)))))
         (ck (kv/value-eq (kv/some-value (kv/i64-value 1)) (kv/some-value (kv/i64-value 1))))
         (ck (not (kv/value-eq (kv/none-value) (kv/some-value (kv/nil-value)))))
         (ck (kv/is-ok? (kv/ok-value (kv/nil-value))))
         (ck (not (kv/is-ok? (kv/err-value (kv/nil-value)))))
         (ck (kv/value-eq (kv/f64-value 4611686018427387904) (kv/f64-value 4611686018427387904)))
         (ck (not (kv/value-eq (kv/i64-value 1) (kv/f64-value 1))))
         (ck (not (kv/is-truthy? (kv/nil-value))))
         (ck (not (kv/is-truthy? (kv/bool-value false))))
         (ck (kv/is-truthy? (kv/i64-value 0)))
         (ck (kv/value-eq (kv/value-get v (kv/keyword-value :c)) (kv/string-value \"s\")))
         (ck (kv/value-has? v (kv/keyword-value :d)))
         (ck (kv/value-eq (kv/record-get-field r1 :x) (kv/i64-value 1)))
         (ck (kv/well-formed? (kv/handle-value \"pair\" 3)))
         (ck (not (kv/well-formed? (kv/handle-value \"pair\" -1))))
         (ck (= :odd-entries (kv/value-problem (kv/map-value (kv/one-value (kv/nil-value))))))
         (ck (= :record-key-not-keyword (kv/value-problem (kv/record-value \"R\" (kv/two-values (kv/i64-value 1) (kv/nil-value))))))
         (ck (= 150 (depth-of (deep 150))))
         (ck (kv/well-formed? (deep 150)))
         (ck (kv/value-eq (deep 60) (deep 60))))))
")

(defn run []
  (let [root "/private/tmp/scratch/probe_kv_main.cljk"]
    (.writeFileSync fs root src)
    (let [graph (pf/load-closed-graph root roots)
          linked (project/link-source (:sources graph) (:root graph))
          hir (sema/analyze (:source linked) {:admit-linked-synthetics? true})]
      (kir/execute (kir/lower hir) 'main [] {:fuel 2000000000 :frames 100000 :cells 200000000 :bytes 200000000}))))

(let [out (run)]
  (println "kvalue checks:" out)
  (js/process.exit (if (every? #(= \1 %) out) 0 1)))
