(ns kotoba.kir.native-definition-identity (:export [main])
 (:require [kotoba.kir.definition-identity :as id] [kotoba.form :as f]
           [kotoba.compiler.kotoba-reader :as reader] [kotoba.kir.alpha-normalization :as alpha]))
(defn- get [m [:ref :form/r] k :keyword] [:ref :form/r] (f/form-get m (f/keyword-form k)))
(defn- put [m [:ref :form/r] k :keyword v [:ref :form/r]] [:ref :form/r] (f/assoc-form m (f/keyword-form k) v))
(defn- map1 [key :keyword value [:ref :form/r]] [:ref :form/r] (f/form-map (f/two-forms (f/keyword-form key) value)))
(defn- assert [ok :bool reason :keyword] :i64 (if ok 0 (throw reason)))
(defn- parse [source :string] [:ref :form/r]
 (let [r (reader/read-forms-bounded source 512 131072) error (record-get [:ref :kotoba.reader/out] r :err)
       forms (record-get [:ref :kotoba.reader/out] r :forms)]
  (if (and (string=? error "") (= (vector-count forms) 1))
   (typed-list-nth [:list [:ref :form/r]] forms 0) (throw :test/parse))))
(defn- refusal [definition [:ref :form/r]] :keyword
 (try (let [cid (id/definition-cid definition)] :test/unexpected-success) (catch :keyword reason reason)))
(defn- bridge-refusal [hir [:ref :form/r] opts [:ref :form/r]] :keyword
 (try (let [r (id/effect-row-from-hir hir opts)] :test/unexpected-success) (catch :keyword reason reason)))
(defn- one-vector [vector [:ref :form/r]] :bool
 (try
  (let [definition (get vector :definition) hex (id/canonical-hex definition) cid (id/definition-cid definition)]
   (if (and (string=? hex (f/string-value (get vector :canonical-hex)))
        (string=? cid (f/string-value (get vector :definition-cid)))) true
    (let [p (typed-cap-call :io/write :string :string (string-concat hex (string-concat "\n" (string-concat cid "\n"))))] false)))
  (catch :keyword reason (let [p (typed-cap-call :io/write :string :string (string-concat (keyword-name reason) "\n"))] false))))
(defn- vectors [values [:ref :form/r]] :i64
 (if (not= (f/count-of values) 10) 10
  (loop [i 0]
   (if (= i (f/count-of values)) 0
    (let [vector (f/nth-of values i)]
     (if (one-vector vector) (recur (+ i 1))
      (let [p (typed-cap-call :io/write :string :string (string-concat "frozen-vector-failed "
       (string-concat (keyword-name (f/keyword-value (get vector :id))) "\n")))] (+ i 100))))))))
(defn- admission [definition [:ref :form/r] expected :string] :i64
 (let [dep (put (map1 :dep/name (f/string-form "core")) :dep/definition-cids (f/form-vec (f/one-form (f/string-form expected))))
       lock (map1 :deps (f/form-vec (f/one-form dep)))
       entry (put (put (map1 :dep/name (f/string-form "core")) :definition definition) :definition-cid (f/string-form expected))
       resolved (f/form-vec (f/one-form entry)) empty (f/form-vec (f/no-forms))
       a (assert (f/is-true? (get (id/admit-build lock resolved) :ok?)) :test/admission-positive)
       b (assert (f/is-true? (get (id/verify-locked-definitions lock empty) :ok?)) :test/verify-empty)
       c (assert (f/eq (get (id/admit-build lock empty) :reason) (f/keyword-form :definition/unresolved-dependency)) :test/coverage-empty)
       bad-name (f/form-vec (f/one-form (put entry :dep/name (f/string-form "unknown"))))
       d (assert (f/eq (get (id/admit-build lock bad-name) :reason) (f/keyword-form :definition/unknown-dependency)) :test/unknown-dep)
       other (put definition :definition/profile-version (f/int-form 5))
       wrong (f/form-vec (f/one-form (put entry :definition other)))
       e (assert (f/eq (get (id/admit-build lock wrong) :reason) (f/keyword-form :definition/hash-mismatch)) :test/mismatch)
       invalid (f/form-vec (f/one-form (put entry :definition-cid (f/string-form "bafyreix"))))
       g (assert (f/eq (get (id/admit-build lock invalid) :reason) (f/keyword-form :definition/cid-invalid)) :test/cid-invalid)
       unlocked (map1 :deps (f/form-vec (f/one-form (put dep :dep/definition-cids empty))))
       h (assert (f/eq (get (id/admit-build unlocked resolved) :reason) (f/keyword-form :definition/not-locked)) :test/unlocked)
       extra (id/definition-cid other)
       partial (map1 :deps (f/form-vec (f/one-form (put dep :dep/definition-cids
        (f/form-vec (f/two-forms (f/string-form expected) (f/string-form extra)))))))
       j (assert (f/eq (get (id/admit-build partial resolved) :reason) (f/keyword-form :definition/unresolved-definition)) :test/coverage-partial)
       malformed (f/form-vec (f/one-form (put entry :definition (f/nil-form))))
       k (assert (f/eq (get (id/admit-build partial malformed) :reason) (f/keyword-form :definition/invalid)) :test/verify-before-coverage)] 0))
(defn- bridge [] :i64
 (let [opts (parse "{:id->name {8 :state/transact 10 :clock/now}}")
       hir (parse "{:effects #{[:cap/call 8] :abort :state} :named-operations #{:clock/now}}")
       row (id/effect-row-from-hir hir opts)
       a (assert (f/eq row (parse "#{:state/transact :abort :state}")) :test/bridge)
       b (assert (= (bridge-refusal (parse "{:effects #{[:cap/call 999]}}") opts) :definition/effect-row-unbridged) :test/bridge-unknown)
       c (assert (= (bridge-refusal (parse "{:effects #{:host/http}}") opts) :definition/effect-row-unbridged) :test/bridge-bare)
       d (assert (= (bridge-refusal hir (parse "{:id->name {8 :state/transact 9 :state/transact}}")) :definition/effect-row-unbridged) :test/bridge-conflation)
       e (assert (= (bridge-refusal (parse "{:effects #{} :named-operations #{:unlisted/op}}") opts) :definition/effect-row-unbridged) :test/bridge-provenance)
       g (assert (= (bridge-refusal (parse "{:effects []}") opts) :definition/effect-row-unbridged) :test/bridge-shape)] 0))
(defn- domain [definition [:ref :form/r]] :i64
 (let [a (assert (f/eq (id/normalize (f/int-form 9223372036854775807)) (id/normalize (id/i64 9223372036854775807))) :test/exact-i64-max)
       b (assert (f/eq (id/normalize (f/int-form -9223372036854775808)) (id/normalize (id/i64 -9223372036854775808))) :test/exact-i64-min)
       c (assert (f/eq (id/normalize (id/f64 (f64-from-bits -9223372036854775808)))
          (parse "[\"f64\" \"8000000000000000\"]")) :test/negative-zero)
       d (assert (f/eq (id/normalize (f/bytes-form (bytes-from-vector-i64 [0 255 128]))) (parse "[\"bytes\" \"00ff80\"]")) :test/bytes)
       e (assert (= (refusal (put definition :definition/kir (parse "{:op :const :value 1.5}"))) :definition/unencodable-float) :test/raw-float)
       g (assert (= (refusal (put definition :definition/effect-row (parse "#{[:cap/call 8]}"))) :definition/invalid) :test/unbridged-row)
       h (assert (= (refusal (put definition :definition/kir (parse "{:body 1}"))) :definition/invalid) :test/not-ir)
       j (assert (= (refusal (put definition :definition/profile-version (f/int-form 0))) :definition/invalid) :test/profile)
       k (assert (string=? (id/definition-cid definition)
           (id/definition-cid (put definition :definition/name (f/string-form "another-alias")))) :test/alias)
       l (assert (f/eq (id/normalize (parse "#{\"\" \"𐀀\"}"))
          (parse "[\"set\" [[\"str\" \"𐀀\"] [\"str\" \"\"]]]")) :test/utf16-order)] 0))
(defn- alpha-body [source :string] [:ref :form/r] (get (alpha/alpha-normalize (parse source)) :body))
(defn- scalar-text [value [:ref :form/r]] [:ref :form/r]
 (if (f/is-int? value) (f/string-form (string-from-i64 (f/int-value value))) value))
(defn- alpha-tests [] :i64
 (let [a (assert (f/eq (alpha/alpha-normalize (parse "{:params [x y] :body (+ x y)}"))
          (parse "{:params [k0 k1] :body (+ k0 k1) :bound #{x y}}")) :test/alpha-params)
       b (assert (f/eq (alpha-body "{:params [x] :body (let [x x] x)}")
          (parse "(let [k1 k0] k1)")) :test/alpha-let)
       c (assert (f/eq (alpha-body "{:params [r] :body (result-match-of :i64 r ok (+ ok 1) err (- err 1))}")
          (parse "(result-match-of :i64 k0 k1 (+ k1 1) k2 (- k2 1))")) :test/alpha-result)
       d (assert (f/eq (alpha-body "{:params [v] :body (variant-match :v v [[:a x (+ x 1)] [:b y (- y 1)]])}")
          (parse "(variant-match :v k0 [[:a k1 (+ k1 1)] [:b k2 (- k2 1)]])")) :test/alpha-variant)
       e (assert (f/eq (alpha-body "{:params [o] :body (option-match :i64 o 0 x (+ x 1))}")
          (parse "(option-match :i64 k0 0 k1 (+ k1 1))")) :test/alpha-option)
       g (assert (f/eq (alpha-body "{:params [] :body (pair (let [a 1] a) (option-match :i64 z 0 b (+ b 1)))}")
          (parse "(pair (let [k0 1] k0) (option-match :i64 z 0 k1 (+ k1 1)))")) :test/alpha-counter)
       h (assert (f/eq (alpha-body "{:params [] :body (let [a 1] (let [b (let [c 2] c)] b))}")
          (parse "(let [k0 1] (let [k2 (let [k1 2] k1)] k2))")) :test/alpha-nesting)
       j (assert (f/eq (alpha-body "{:params [x] :body #{x}}") (parse "#{k0}")) :test/alpha-set)
       k (assert (f/eq (alpha-body "{:params [x] :body (cast [:ref x] x)}")
          (parse "(cast [:ref x] k0)")) :test/alpha-schema)
       l (assert (f/eq (get (alpha/alpha-normalize-with-scalar (parse "{:params [x] :body (+ x 1)}") (fn-ref scalar-text)) :body)
          (parse "(+ k0 \"1\")")) :test/alpha-scalar)
       m (assert (f/eq (alpha/symbols-in (parse "(f {:key x} #{y} [:ref z])")) (parse "#{f x y z}")) :test/alpha-symbols)
       n (assert (and (alpha/handles? "let") (not (alpha/handles? "loop"))
          (f/eq (alpha/binding-forms) (parse "#{let result-match-of variant-match option-match}"))) :test/alpha-vocabulary)
       leak (try (let [r (alpha/normalize-function (parse "{:params [] :body (pair (let [a 1] a) a)}")
                         (parse "#{}"))] :unexpected-success)
              (catch :keyword reason reason))
       o (assert (= leak :kotoba.kir.alpha-normalization/binder-not-normalized) :test/alpha-leak)
       chosen (try (let [r (alpha/verify-normalized-with-problem
                       (alpha/alpha-normalize (parse "{:params [] :body (pair (let [a 1] a) a)}"))
                       (parse "#{}") :typed-code/binder-not-normalized)] :unexpected-success)
                  (catch :keyword reason reason))
       p (assert (= chosen :typed-code/binder-not-normalized) :test/alpha-chosen-refusal)
       target (alpha/normalize-function (parse "{:params [x] :body (callee x)}") (parse "#{callee}"))
       q (assert (f/eq (get target :body) (parse "(callee k0)")) :test/alpha-free-target)
       unhandled (alpha/normalize-function (parse "{:params [] :body (loop [i 0] (+ i 1))}") (parse "#{}"))
       r (assert (f/eq (get unhandled :body) (parse "(loop [i 0] (+ i 1))")) :test/alpha-unhandled-measured-limit)] 0))
(defn- public-checkers [definition [:ref :form/r] expected :string] :i64
 (let [accept (put (parse "{:type :identity :kind :accept}") :expected-cid (f/string-form expected))
       a (assert (f/is-true? (get (id/check-case accept definition) :ok?)) :test/check-case-positive)
       b (assert (f/is-true? (get (id/check-case (parse "{:type :identity :kind :reject :expected-problem :definition/invalid}")
                                     (f/nil-form)) :ok?)) :test/check-case-refusal)
       c (assert (not (f/is-true? (get (id/check-case (parse "{:type :unknown}") definition) :ok?))) :test/check-case-unknown)
       d (assert (= (refusal (put definition :definition/dependencies (parse "[\"not-a-cid\"]"))) :definition/invalid) :test/dependency-invalid)
       duplicates (f/form-vec (f/two-forms (f/string-form expected) (f/string-form expected)))
       e (assert (= (refusal (put definition :definition/dependencies duplicates)) :definition/invalid) :test/dependency-duplicates)
       g (assert (= (refusal (put definition :definition/interface (f/form-vec (f/no-forms)))) :definition/invalid) :test/interface-invalid)
       h (assert (f/eq (id/normalize (parse "{:kotoba.lang.code-identity/f64 \"ABCDEF0123456789\"}"))
          (parse "[\"f64\" \"abcdef0123456789\"]")) :test/f64-wrapper-case)
       j (assert (f/eq (id/control-effects) (parse "#{:abort :state}")) :test/control-vocabulary)
       k (assert (= (f/count-of (id/definition-required)) 6) :test/required-vocabulary)] 0))
(defn- run [] :i64
 (let [path (typed-cap-call :cli/args :string :string "0") text (typed-cap-call :fs/app-data :string :string path)
       document (parse text) all (get document :vectors) result (vectors all)]
  (if (not= result 0) result
   (let [first (f/nth-of all 0) definition (get first :definition) expected (f/string-value (get first :definition-cid))
         a (domain definition) b (bridge) c (admission definition expected) d (alpha-tests) e (public-checkers definition expected)
         p (typed-cap-call :io/write :string :string "PASS_NATIVE_DEFINITION_CID_V2_ALL_10_FROZEN_BRIDGE_ADMISSION\n")] 0))))
(defn main [] :i64
 (try (run) (catch :keyword reason
  (let [p (typed-cap-call :io/write :string :string (string-concat (keyword-name reason) "\n"))] 90))))
