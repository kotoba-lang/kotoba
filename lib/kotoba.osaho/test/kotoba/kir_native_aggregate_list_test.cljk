(ns kotoba.kir-native-aggregate-list-test
  "Native lists of aggregate handles (docs/selfhost-native-aggregate-lists-design.md
  in amu-measure). A `[:list T]` is a vector-arena handle whose items are machine
  words, and a record / variant / option / `[:ref q]` handle IS one word, so a
  list of them needs no representation of its own -- only the admission that
  withheld it. The shape that matters is the recursive Form record every
  selfhost guest walks: `[:kids [:list [:ref :form/r]]]` beside a `:bytes` member.
  The negatives pin what stays refused, each for its own reason."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.kir :as kir]))

(def tree
  [:record :app/tree [[:v :i64] [:kids [:list [:ref :app/tree]]] [:data :bytes]]])
(def kids [:list [:ref :app/tree]])
(def schemas {:app/tree tree})

(def leaf-fn
  {:name 'leaf :params ['v] :param-types [:i64] :result [:ref :app/tree]
   :body (list 'record-new tree 'v (list 'typed-list-new kids) (list 'bytes-empty))})
(def node-fn
  {:name 'node :params ['v 'a] :param-types [:i64 [:ref :app/tree]] :result [:ref :app/tree]
   :body (list 'record-new tree 'v (list 'typed-list-new kids 'a) (list 'bytes-empty))})
(def grow-fn
  {:name 'grow :params ['n 'k] :param-types [[:ref :app/tree] [:ref :app/tree]]
   :result [:ref :app/tree]
   :body (list 'record-assoc tree 'n :kids
               (list 'typed-list-conj kids (list 'record-get tree 'n :kids) 'k))})
(def first-kid-fn
  {:name 'first-kid :params ['n] :param-types [[:ref :app/tree]] :result :i64
   :body (list 'record-get tree
               (list 'typed-list-nth kids (list 'record-get tree 'n :kids) 0) :v)})

(defn- hir [& {:keys [exports functions schemas] :or {schemas schemas}}]
  {:format :kotoba.hir/v3 :entry 'main :exports (or exports ['main])
   :schemas schemas
   :functions (into [{:name 'main :params [] :param-types [] :result :i64
                      :body (list 'first-kid (list 'grow (list 'leaf 1) (list 'leaf 41)))}]
                    functions)})

(def base [leaf-fn node-fn grow-fn first-kid-fn])

(deftest a-recursive-record-holding-a-list-of-itself-and-bytes-is-admitted
  (is (true? (kir/only-native-word-typed-features? (hir :functions base)))))

(deftest a-list-of-handles-crosses-an-internal-call
  (let [count-fn {:name 'width :params ['ks] :param-types [kids] :result :i64
                  :body (list 'vector-count 'ks)}]
    (is (true? (kir/only-native-word-typed-features? (hir :functions (conj base count-fn)))))))

(deftest a-list-of-options-of-handles-is-admitted-too
  (let [item [:option [:ref :app/tree]]
        ks [:list item]
        f {:name 'maybe :params ['n] :param-types [[:ref :app/tree]] :result ks
           :body (list 'typed-list-new ks (list 'option-some-of item 'n))}]
    (is (true? (kir/only-native-word-typed-features? (hir :functions (conj base f)))))))

(deftest refusals-keep-their-reasons
  (testing "a set of handles would compare cells, not values"
    (is (false? (kir/only-native-word-typed-features?
                 (hir :functions
                      (conj base {:name 'bag :params ['n] :param-types [[:ref :app/tree]]
                                  :result :i64
                                  :body (list 'typed-set-count [:set [:ref :app/tree]]
                                              (list 'typed-set-new [:set [:ref :app/tree]] 'n))}))))))
  (testing "an EXPORT stays on the host-validated boundary: the loader cannot build the list"
    (is (false? (kir/only-native-word-typed-features?
                 (hir :exports ['main 'first-kid] :functions base)))))
  (testing "a reference the schema table does not declare"
    (is (false? (kir/only-native-word-typed-features?
                 (hir :schemas {} :functions base)))))
  (testing "an item that is not one word"
    (is (false? (kir/only-native-word-typed-features?
                 (hir :functions
                      (conj base {:name 'slices :params [] :param-types [] :result :i64
                                  :body (list 'vector-count
                                              (list 'typed-list-new [:list [:slice :u8]]))})))))))

(deftest a-record-update-needs-a-declared-field
  (is (false? (kir/only-native-word-typed-features?
               (hir :functions
                    [leaf-fn first-kid-fn
                     {:name 'grow :params ['n] :param-types [[:ref :app/tree]]
                      :result [:ref :app/tree]
                      :body (list 'record-assoc tree 'n :nope 1)}])))))
