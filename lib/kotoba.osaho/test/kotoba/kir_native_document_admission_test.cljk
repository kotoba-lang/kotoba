(ns kotoba.kir-native-document-admission-test
  "Native `:document` operations (gap 2 of the selfhost foundation, superproject
  adr-2609242330): admitted by the native gate exactly where kotoba-native
  lowers them (`kotoba.native.document`), with their arities, and refused by
  name where it does not. The :bytes / :link four (root ADR-2610092310 S4)
  joined once kotoba-native wrote them as EDN tagged literals; their two
  readers answer `[:option :bytes]`, admitted as an option over one word."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.kir :as kir]))

(defn- hir [body]
  {:format :kotoba.hir/v3 :entry 'main :exports ['main]
   :functions [{:name 'main :params [] :param-types [] :result :i64
                :body (list 'let ['d body] 0)}]})

(defn- admitted? [body] (kir/only-native-word-typed-features? (hir body)))

(def ^:private m '(document-map :a (document-i64 1)))
(def ^:private v '(document-vector (document-i64 1)))
(def ^:private bs '(bytes-from-vector-i64 (vector-new 1 2)))

(deftest native-admits-the-document-operations-it-lowers
  (doseq [body ['(document-null) '(document-bool true) '(document-i64 3)
                '(document-string "s") '(document-keyword :k)
                v '(document-list) '(document-set (document-i64 1)) m
                (list 'document-count m) (list 'document-kind v)
                (list 'document-equal? m m)
                '(document-set-contains? (document-set) (document-null))
                (list 'document-contains m :a) (list 'document-get m :a)
                (list 'document-vector-at v 0) '(document-list-at (document-list) 0)
                (list 'document-map-entry-at m 0)
                (list 'document-vector-assoc v 0 '(document-null))
                (list 'document-vector-conj v '(document-null))
                (list 'document-vector-drop v 1) (list 'document-vector-remove v 0)
                (list 'document-vector-sort v)
                (list 'document-assoc m :b '(document-null)) (list 'document-dissoc m :a)
                (list 'document-merge m m m)
                '(document-string-value (document-string "s"))
                '(document-keyword-value (document-keyword :k))
                '(document-bool-value (document-bool true))
                '(document-i64-value (document-i64 1))
                (list 'document-edn-print m) '(document-edn-read "[]")
                ;; :bytes and :link (root ADR-2610092310 S4)
                (list 'document-bytes bs) (list 'document-link bs)
                (list 'option-value-of [:option :bytes]
                      (list 'document-bytes-value (list 'document-bytes bs)) '(bytes-empty))
                (list 'option-value-of [:option :bytes]
                      (list 'document-link-value (list 'document-bytes bs)) '(bytes-empty))]]
    (is (true? (admitted? body)) (pr-str body))))

(deftest the-bytes-and-link-operations-have-arity-one
  (doseq [body ['(document-bytes) '(document-link) '(document-bytes-value)
                (list 'document-link-value '(document-null) '(document-null))]]
    (is (false? (admitted? body)) (pr-str body))))

(deftest native-refuses-what-it-does-not-lower
  (testing "f64 (no f64 text), the digest and the hex codec"
    (doseq [body ['(document-f64 1.5) '(document-f64-value (document-null))
                  '(document-sha256 (document-null)) '(document-print (document-null))
                  '(document-read "6e")]]
      (is (false? (admitted? body)) (pr-str body))))
  (testing "a wrong arity"
    (is (false? (admitted? '(document-map :a))))
    (is (false? (admitted? '(document-count))))
    (is (false? (admitted? '(document-merge))))))
