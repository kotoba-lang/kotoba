(ns kotoba.kir-range-slots-test
  "The ABI v10 range heads at the KIR level -- `string-find-byte`,
  `string-append-range` -- pinned as reference semantics in UTF-8 byte
  coordinates on both hosts."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.kir :as ir]
            [kotoba.test-hir :as test-hir]))

(defn- module [result body]
  (test-hir/module
   {:format :kotoba.hir/v3 :entry 'main :exports '[main] :result result
    :schemas {} :schema-identities {}
    :functions [{:name 'main :params [] :param-types [] :result result :body body}]}))

(defn- run [result body] (ir/execute (ir/lower (module result body)) 'main []))
(defn- n [body] (str (run :i64 body)))
(defn- refused [body]
  (try (do (run :i64 body) nil)
       (catch #?(:clj Throwable :cljs :default) e (or (:kind (ex-data e)) (ex-message e)))))

(deftest string-find-byte-is-absolute-and-ascii
  (is (= "1" (n '(string-find-byte "a\nb\n" 10 0))))
  (is (= "3" (n '(string-find-byte "a\nb\n" 10 2))) "absolute, from an offset")
  (is (= "-1" (n '(string-find-byte "abc" 10 0))))
  (is (= "-1" (n '(string-find-byte "abc" 99 3))) "from the end: nothing")
  (is (= "9" (n '(string-find-byte "日本語 a" 32 3))) "byte offsets across multi-byte text")
  (is (some? (refused '(string-find-byte "abc" 200 0))) "a non-ASCII byte is refused")
  (is (some? (refused '(string-find-byte "日本" 10 1))) "inside a code point is refused"))

(deftest string-append-range-is-concat-of-a-view
  (is (= "xbc" (run :string '(string-append-range "x" "abc" 1 3))))
  (is (= "x" (run :string '(string-append-range "x" "abc" 3 3))) "the empty range")
  (is (= "本" (run :string '(string-append-range "" "日本語" 3 6))) "byte offsets on boundaries")
  (is (some? (refused '(string-append-range "" "日本" 1 3))) "inside a code point is refused")
  (is (some? (refused '(string-append-range "" "abc" 2 1))) "start past end is refused"))
