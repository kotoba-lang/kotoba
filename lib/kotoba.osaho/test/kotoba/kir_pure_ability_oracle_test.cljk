(ns kotoba.kir-pure-ability-oracle-test
  "A module whose only effect-row member is the pure ability `:state`
  (kotoba-lang `lang/state-ability.edn`, slice 1) is oracled like a pure one.

  The frontend lowers the ability to state passing before KIR exists, and the
  handler is ordinary functions of the program, so re-executing the entry at
  compile time touches no host. Before this, `lower` sealed no value for such
  a module because its row was not empty, and the native artifact went out
  without the reference answer to be checked against. A capability row still
  seals nothing."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.kir :as ir]
            [kotoba.test-hir :as test-hir]))

(defn- module [tick-effects]
  ;; `tick` is shaped like a handler specialization: the state in, the next
  ;; state out (the record pair is not needed to exercise the row rule).
  (test-hir/module
   {:format :kotoba.hir/v2
    :entry 'main
    :exports ['main]
    :result :i64
    :functions
    [{:name 'tick :params ['s] :result :i64 :effects tick-effects
      :body '(+ s 1)}
     {:name 'main :params [] :result :i64
      :body '(tick (tick 40))}]}))

(defn- sealed [m] (some-> (:oracle-value (ir/lower m)) str))

(deftest a-state-only-row-is-oracled
  (is (= #{:state} (:effects (module #{:state}))))
  (is (= "42" (sealed (module #{:state}))))
  (testing "the pure control seals the same value"
    (is (= "42" (sealed (module #{}))))))

(deftest an-abort-row-is-oracled
  ;; lang/abort-ability.edn: throw / try are result values before KIR, so a
  ;; module whose row carries :abort is as deterministic as a pure one
  ;; (gap 4 of the selfhost foundation, superproject adr-2609242330).
  (is (= "42" (sealed (module #{:abort}))))
  (is (= "42" (sealed (module #{:state :abort})))))

(deftest a-capability-row-is-still-not-oracled
  (is (nil? (sealed (module #{[:cap/call 7]}))))
  (testing "beside a pure ability too"
    (is (nil? (sealed (module #{:abort [:cap/call 7]}))))))
