(ns kotoba.kir-value-js-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.kir.value :as value]))

(deftest opaque-type-has-no-canonical-order
  (is (= :js-value (value/validate-value-type! :js-value)))
  (doseq [type [[:set :js-value] [:set [:list :js-value]]
               [:map :js-value :i64] [:map [:option :js-value] :string]]]
    (is (thrown? #?(:clj Exception :cljs js/Error)
                 (value/validate-value-type! type))))
  (let [type [:set [:record :app/label [[:js-value :string]]]]]
    (is (= type (value/validate-value-type! type))))
  (is (= [:map :string :js-value]
         (value/validate-value-type! [:map :string :js-value])))
  (is (thrown? #?(:clj Exception :cljs js/Error)
               (value/compare-typed-values :js-value nil nil))))

#?(:cljs
   (deftest every-js-value-crosses-as-one-opaque-leaf
     (let [reads (atom 0)
           object #js {}
           getter #js {}
           proxy (js/Proxy. #js {} #js {:get (fn [& _] (swap! reads inc)
                                              (throw (js/Error. "unexpected read")))})
           revoked (.revocable js/Proxy #js {} #js {})
           view (js/Uint8Array. (js/ArrayBuffer. 12) 2 3)
           _ (aset object "self" object)
           _ (.defineProperty js/Object getter "property"
                              #js {:get (fn [] (swap! reads inc)
                                          (throw (js/Error. "unexpected getter")))})
           _ ((.-revoke revoked))
           cases [js/undefined nil js/NaN (- 0.0) js/Infinity 1.5 7
                  (js/BigInt "7") "foo" true (fn [] nil) (js/Symbol "x")
                  object getter proxy (.-proxy revoked) view (js/Date.)
                  (js/RegExp. "x") (js/Map.) (js/Set.) (js/Array. 5)
                  (.freeze js/Object #js [7])]]
       (doseq [input cases]
         (is (.is js/Object input (value/bounded-typed-value! :js-value input
                                                               {:nodes 1 :bytes 0})))
         (is (.is js/Object input (value/shallow-typed-value! :js-value input)))
         (is (true? (value/operand-tag? :js-value input))))
       (is (zero? @reads))
       (is (thrown? js/Error (value/bounded-typed-value! :js-value object {:nodes 0}))))))

#?(:clj
   (deftest other-hosts-refuse-opaque-js-values
     (is (false? (value/operand-tag? :js-value nil)))
     (is (thrown-with-msg? Exception #"require a JS host"
                          (value/bounded-typed-value! :js-value nil)))
     (is (thrown-with-msg? Exception #"require a JS host"
                          (value/shallow-typed-value! :js-value nil)))))
