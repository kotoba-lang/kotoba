(ns kotoba.kir-string-split-count-test
  "T4.2: string-split-count segment arithmetic."
  (:require [kotoba.lang.error :as kerror] [kotoba.test :refer [deftest is]]
            [kotoba.kir :as ir]))

(defn- run [haystack sep]
  (ir/execute
   {:format :kotoba.kir/v4
    :entry 'main
    :exports ['main]
    :effects #{}
    :functions
    [{:name 'main
      :params []
      :param-types []
      :result :i64
      :effects #{}
      :body (list 'string-split-count haystack sep)}]}
   'main
   []))

(deftest split-count-basics
  (is (= 3 (run "a,b,c" ",")))
  (is (= 1 (run "solo" ",")))
  (is (= 3 (run "x--y--z" "--")))
  (is (= 1 (run "" ",")))
  (is (= 2 (run "a," ","))))

(deftest empty-sep-traps
  (try
    (run "abc" "")
    (is false "expected trap")
    (catch kerror/ExceptionInfo e
      (is (= :empty-string-split-separator (:trap (ex-data e)))))))
