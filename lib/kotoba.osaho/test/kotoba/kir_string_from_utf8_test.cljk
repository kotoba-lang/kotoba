(ns kotoba.kir-string-from-utf8-test
  "`:bytes` as a guest value and the string constructor at the KIR level
  (2026-09-25, superproject adr-2609242330): `bytes-from-vector-i64`,
  `vector-i64-from-bytes`, `string-from-utf8`, and the four bytes reads the
  reference interpreter did not run before. Every refusal is pinned by its
  trap NAME, the literal the ESM prelude, the Wasm host and the native loader
  repeat."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.kir :as ir]
            [kotoba.kir.value :as value]
            [kotoba.test-hir :as test-hir]))

(defn- module [result body]
  (test-hir/module
   {:format :kotoba.hir/v3 :entry 'main :exports '[main] :result result
    :schemas {} :schema-identities {}
    :functions [{:name 'main :params [] :param-types [] :result result :body body}]}))

(defn- run
  ([result body] (run result body {}))
  ([result body opts] (ir/execute (ir/lower (module result body)) 'main [] opts)))
(defn- trap [body]
  (try (do (run :string body) :no-trap)
       (catch #?(:clj Throwable :cljs :default) e (:trap (ex-data e)))))
(defn- utf8 [& bytes] (list 'string-from-utf8 (list 'bytes-from-vector-i64 (cons 'vector-new bytes))))
(defn- w [x] #?(:clj x :cljs (js/Number x)))

(deftest canonical-utf8-of-every-width-builds-the-string
  (is (= "A" (run :string (utf8 0x41))))
  (is (= "Я" (run :string (utf8 0xd0 0xaf))))
  (is (= "あ" (run :string (utf8 0xe3 0x81 0x82))))
  (is (= "😀" (run :string (utf8 0xf0 0x9f 0x98 0x80))))
  (is (= "\u0080߿ࠀ￿" (run :string (utf8 0xc2 0x80 0xdf 0xbf 0xe0 0xa0 0x80 0xef 0xbf 0xbf))))
  (is (= "퟿" (run :string (utf8 0xed 0x9f 0xbf 0xee 0x80 0x80))) "either side of the surrogates")
  (is (= "􏿿" (run :string (utf8 0xf4 0x8f 0xbf 0xbf))) "U+10FFFF, the last scalar value")
  (is (= "" (run :string '(string-from-utf8 (bytes-empty))))))

(deftest every-class-of-invalid-utf8-is-refused-by-name
  (is (= :utf8/unexpected-continuation (trap (utf8 0x80))))
  (is (= :utf8/overlong (trap (utf8 0xc0 0x80))) "C0 80, the overlong NUL")
  (is (= :utf8/overlong (trap (utf8 0xc1 0xbf))))
  (is (= :utf8/overlong (trap (utf8 0xe0 0x80 0xaf))) "E0 80 AF, the overlong /")
  (is (= :utf8/overlong (trap (utf8 0xe0 0x80))) "decided at byte 2, before truncation")
  (is (= :utf8/overlong (trap (utf8 0xf0 0x8f 0xbf 0xbf))))
  (is (= :utf8/surrogate (trap (utf8 0xed 0xa0 0x80))))
  (is (= :utf8/surrogate (trap (utf8 0xed 0xbf 0xbf))))
  (is (= :utf8/above-max (trap (utf8 0xf4 0x90 0x80 0x80))))
  (is (= :utf8/invalid-byte (trap (utf8 0xf5 0x80 0x80 0x80))))
  (is (= :utf8/invalid-byte (trap (utf8 0xff))))
  (is (= :utf8/truncated (trap (utf8 0xe3 0x81))))
  (is (= :utf8/truncated (trap (utf8 0x41 0xf0 0x9f 0x98))))
  (is (= :utf8/bad-continuation (trap (utf8 0xe3 0x41 0x82))))
  (is (= :utf8/bad-continuation (trap (utf8 0xf0 0x9f 0x98 0x41))))
  (testing "the FIRST bad sequence names the trap"
    (is (= :utf8/surrogate (trap (utf8 0x41 0xed 0xa0 0x80 0xc0 0x80))))))

(deftest the-trap-names-are-the-published-set
  (is (= [:utf8/unexpected-continuation :utf8/overlong :utf8/invalid-byte
          :utf8/truncated :utf8/bad-continuation :utf8/surrogate :utf8/above-max]
         value/utf8-invalid-traps)))

(deftest bytes-are-built-from-items-in-range-only
  (is (= :bytes/item-out-of-range (trap (utf8 256))))
  (is (= :bytes/item-out-of-range (trap (utf8 0x41 -1))))
  (is (= 3 (w (run :i64 '(bytes-count (bytes-from-vector-i64 (vector-new 1 2 3)))))))
  (is (= [1 2 255] (mapv w (run :vector-i64 '(vector-i64-from-bytes (bytes-from-vector-i64 (vector-new 1 2 255))))))))
  (testing "bytes-value-byte-limit items is the bound (8 MiB, amu ADR 0362); one more is refused by name"
    (let [limit value/bytes-value-byte-limit]
      (is (= 8388608 limit))
      (is (= limit (w (run :i64 (list 'bytes-count (list 'bytes-from-vector-i64 (list 'vector-alloc limit)))))))
      (is (= :bytes/too-large
             (try (run :i64 (list 'bytes-count (list 'bytes-from-vector-i64 (list 'vector-alloc (inc limit))))) nil
                  (catch #?(:clj Throwable :cljs :default) e (:trap (ex-data e))))))))

(deftest the-bytes-reads-run-on-the-reference
  (is (= 200 (w (run :i64 '(bytes-at (bytes-from-vector-i64 (vector-new 7 200)) 1)))))
  (is (= 2 (w (run :i64 '(bytes-count (bytes-slice (bytes-from-vector-i64 (vector-new 1 2 3)) 1 3))))))
  (is (= "hi" (run :string '(string-from-utf8 (bytes-concat (bytes-from-vector-i64 (vector-new 104))
                                                            (bytes-from-vector-i64 (vector-new 105)))))))
  (let [refused (fn [body] (try (run :i64 body) nil
                                (catch #?(:clj Throwable :cljs :default) e (:trap (ex-data e)))))]
    (is (= :bytes/index-out-of-range (refused '(bytes-at (bytes-from-vector-i64 (vector-new 1)) 1))))
    (is (= :bytes/slice-bounds (refused '(bytes-count (bytes-slice (bytes-from-vector-i64 (vector-new 1 2)) 2 1)))))
    (is (= :bytes/too-large (refused (list 'bytes-count
                                           (list 'bytes-concat
                                                 (list 'bytes-from-vector-i64 (list 'vector-alloc value/bytes-value-byte-limit))
                                                 '(bytes-from-vector-i64 (vector-new 0)))))))))

(deftest the-string-is-charged-to-the-bytes-budget
  (is (= "abc" (run :string (utf8 0x61 0x62 0x63) {:bytes 3})))
  (is (= :budget/bytes
         (try (run :string (utf8 0x61 0x62 0x63) {:bytes 2}) nil
              (catch #?(:clj Throwable :cljs :default) e (:trap (ex-data e)))))))
