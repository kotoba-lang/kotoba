(ns kotoba.kir-js-operations-test
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.kir :as kir]
            [kotoba.kir.js-operations :as operations]))

(defn evaluate [op values]
  (let [names (mapv #(symbol (str "arg" %)) (range (count values)))]
    (kir/eval-expr (apply list op names) (zipmap names values) {}
                   (volatile! 100) (atom {}) [] nil)))

#?(:cljs
   (deftest opaque-js-predicates-do-not-coerce-or-read-host-values
     (let [reads (atom 0)
           object #js {}
           getter #js {}
           proxy (js/Proxy. #js {} #js {:get (fn [& _] (swap! reads inc)
                                               (throw (js/Error. "unexpected read")))})
           revoked (.revocable js/Proxy #js {} #js {})
           _ ((.-revoke revoked))
           _ (.defineProperty js/Object getter "valueOf"
                              #js {:get (fn [] (swap! reads inc)
                                           (throw (js/Error. "unexpected getter")))})
           cases [[nil true false] [js/undefined true false]
                  [false false false] [true false true]
                  [0 false false] [(- 0.0) false false] [js/NaN false false]
                  [(js/BigInt "0") false false] [(js/BigInt "1") false true]
                  ["" false false] ["0" false true] [js/Infinity false true]
                  [object false true] [getter false true] [proxy false true]
                  [(.-proxy revoked) false true] [(js/Symbol "x") false true]
                  [(fn [] nil) false true] [(js/Array. 3) false true]
                  [(js/Uint8Array. 3) false true] [(js/Map.) false true]]]
       (doseq [[value nullable truthy] cases]
         (is (= nullable (operations/nullish? value)))
         (is (= truthy (operations/truthy? value)))
         (is (= nullable (evaluate 'js-nullish? [value])))
         (is (= truthy (evaluate 'js-truthy? [value]))))
       (doseq [[left right expected] [[nil js/undefined false] [js/NaN js/NaN false]
                                     [0 (- 0.0) true] [1 (js/BigInt "1") false]
                                     ["1" 1 false] [object object true]
                                     [#js {} #js {} false] [proxy proxy true]
                                     [(.-proxy revoked) (.-proxy revoked) true]]]
         (is (= expected (operations/strict-equal? left right)))
         (is (= expected (evaluate 'js-strict-equal? [left right]))))
       (is (zero? @reads)))))

(deftest malformed-opaque-js-operation-arities-are-refused
  (doseq [[op args] [['js-nullish? []] ['js-nullish? [nil nil]]
                     ['js-truthy? []] ['js-strict-equal? [nil]]
                     ['js-strict-equal? [nil nil nil]]]]
    (is (= :js-operation-arity
           (try (evaluate op args) nil
                (catch #?(:clj Exception :cljs :default) e (:trap (ex-data e))))))))

#?(:clj
   (deftest other-hosts-refuse-opaque-js-predicates
     (doseq [f [#(operations/nullish? nil) #(operations/truthy? false)
                 #(operations/strict-equal? nil nil) #(operations/undefined-value)]]
       (is (= :js-value-host
              (try (f) nil (catch Exception e (:trap (ex-data e)))))))))

#?(:cljs
   (deftest explicit-js-undefined-is-a-raw-opaque-result
     (let [direct (operations/undefined-value)
           interpreted (evaluate 'js-undefined [])]
       (is (js/Object.is direct js/undefined))
       (is (not (js/Object.is direct nil)))
       (is (js/Object.is interpreted js/undefined))
       (is (= "undefined" (operations/type-of interpreted)))
       (is (true? (evaluate 'js-nullish? [interpreted])))
       (is (true? (evaluate 'js-strict-equal? [interpreted js/undefined]))))))

(deftest js-undefined-refuses-arguments-before-operand-evaluation
  (doseq [args [['unbound] ['unbound 'unbound]]]
    (is (= :js-operation-arity
           (try (kir/eval-expr (apply list 'js-undefined args) {} {}
                               (volatile! 100) (atom {}) [] nil)
                nil
                (catch #?(:clj Exception :cljs :default) e (:trap (ex-data e)))))))
  (is (contains? kir/non-string-typed-ops 'js-undefined)))
