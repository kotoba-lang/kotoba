(ns kotoba.kir-js-trampoline-test
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.kir :as kir]
            [kotoba.test-hir :as fixture]))

(defn opaque-program [body]
  (kir/lower
    (fixture/module
      {:format :kotoba.hir/v3 :entry nil :exports ['keep] :result nil
       :functions [{:name 'keep :params ['v] :param-types [:js-value]
                    :result :js-value :body body}
                   {:name 'dispatch :params ['closure 'v] :param-types [:i64 :js-value]
                    :closure-param-indexes [0] :result :js-value
                    :body '(if (= (pair-first closure) 7) v (js-undefined))}]})))

#?(:cljs
   (deftest opaque-results-do-not-trigger-trampoline-property-observations
     (let [reads (atom 0)
           proxy (js/Proxy. #js {} #js {:get (fn [& _] (swap! reads inc) (throw (js/Error. "get")))
                                      :getPrototypeOf (fn [& _] (swap! reads inc) (throw (js/Error. "prototype")))})
           revoked (.revocable js/Proxy #js {} #js {})
           _ ((.-revoke revoked))
           spoof {:kotoba.kir/trampoline true :function 'missing :values []}
           values [nil js/undefined false true 0 (- 0.0) js/NaN (js/BigInt "0") "" (js/Symbol "x") #js {} #js [] proxy (.-proxy revoked) spoof]]
       (doseq [body ['v '(dispatch (pair 7 0) v)]
               :let [program (opaque-program body)]
               v values]
         (is (js/Object.is v (kir/execute program 'keep [v] {}))))
       (is (= 0 @reads)))))

#?(:cljs
   (deftest tail-reentry-keeps-opaque-data-separate-from-private-controls
     (let [program (kir/lower
                     (fixture/module
                       {:format :kotoba.hir/v3 :entry nil :exports ['keep] :result nil
                        :functions [{:name 'keep :params ['v] :param-types [:js-value]
                                     :result :js-value :body '(__kotoba_loop_1 2000 v)}
                                    {:name '__kotoba_loop_1 :params ['n 'v] :param-types [:i64 :js-value]
                                     :result :js-value
                                     :body '(if (<= n 0) v (__kotoba_loop_1 (- n 1) v))}]}))
           revoked (.revocable js/Proxy #js {} #js {})
           _ ((.-revoke revoked))
           spoof {:kotoba.kir/trampoline true :function 'missing :values []}]
       (is (identical? spoof (kir/execute program 'keep [spoof] {})))
       (is (js/Object.is (.-proxy revoked) (kir/execute program 'keep [(.-proxy revoked)] {})))
       (is (js/Object.is js/undefined (kir/execute program 'keep [js/undefined] {}))))))
