(ns kotoba.kir-trap-source-test
  "T3.3: fuel-exhausted traps cite function + call-stack tip."
  (:require [kotoba.lang.error :as kerror] [kotoba.test :refer [deftest is]]
            [kotoba.kir :as kir]))

(defn- deep-loop-kir
  "Self-recursive helper that never bottoms out within default fuel."
  []
  {:format :kotoba.kir/v4
   :exports ['main]
   :entry 'main
   :effects #{}
   :functions
   [{:name 'main
     :params []
     :body (list 'spin 0)}
    {:name 'spin
     :params ['n]
     :body (list 'spin (list '+ 'n 1))}]})

(deftest fuel-exhausted-cites-function-and-call-stack
  (try
    ;; fuel 3, not the default 512: `spin` is not a self-tail loop helper, so
    ;; the interpreter nests, and on nbb the host stack runs out within about
    ;; ten interpreted calls -- which since P2 of adr-2609242100 is its own
    ;; trap, :host/stack-exhausted, and no longer passes for fuel.
    (kir/execute (deep-loop-kir) 'main [] {:fuel 3})
    (is false "expected fuel trap")
    (catch kerror/ExceptionInfo e
      (let [d (ex-data e)]
        (is (= :budget/fuel (:trap d)))
        (is (= :ir (:phase d)))
        (is (= 'spin (:function d)))
        (is (vector? (:call-stack d)))
        (is (some #{'spin} (:call-stack d)))
        (is (string? (:hint d)))))))
