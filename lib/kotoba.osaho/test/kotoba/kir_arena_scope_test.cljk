(ns kotoba.kir-arena-scope-test
  "`(arena-scope body)` -- superproject ADR-2609160044, context ABI v6.

  On native the head releases every handle and byte allocated while its body
  ran; here it is the identity on its one operand, and that is the whole
  claim this file pins: the VALUE is the same on every host, only the native
  arena accounting differs. Three things:

  1. Evaluation and the constant oracle both answer the body's value, on
     scalar bodies of every admitted kind.
  2. The native admission gate admits the head exactly when it admits the
     body -- it must not launder an operand the slice cannot emit.
  3. A self-call INSIDE the scope is not a tail call: the leave follows it,
     so the loop-helper walker must report it as non-tail."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.kir :as ir]
            [kotoba.test-hir :as test-hir]))

(defn- module [body]
  (test-hir/module
   {:format :kotoba.hir/v3
    :entry 'main
    :exports '[main]
    :result :i64
    :schemas {}
    :schema-identities {}
    :functions [{:name 'main :params [] :param-types [] :result :i64
                 :body body}]}))

(defn- run [body] (ir/execute (ir/lower (module body)) 'main []))
(defn- fold [body] (:oracle-value (ir/lower (module body))))
(defn- w [x] #?(:clj x :cljs (js/Number x)))

(deftest the-scope-is-the-identity-on-its-body
  (is (= 42 (w (run '(arena-scope 42)))))
  (is (= 42 (w (fold '(arena-scope 42)))))
  (is (= 6 (w (run '(arena-scope (string-byte-length (string-concat "abc" "def")))))))
  (is (= 6 (w (fold '(arena-scope (string-byte-length (string-concat "abc" "def")))))))
  (is (= 3 (w (run '(+ 1 (arena-scope (+ 1 1)))))) "nested in arithmetic")
  (is (= 7 (w (run '(arena-scope (arena-scope (+ 3 4)))))) "nested scopes"))

(defn- hir [body]
  {:format :kotoba.hir/v3
   :functions [{:name 'main :params [] :param-types [] :result :i64 :body body}]})

(deftest the-native-gate-admits-the-head-exactly-when-it-admits-the-body
  (is (true? (ir/only-native-word-typed-features?
              (hir '(arena-scope (string-byte-length "abc"))))))
  (is (true? (ir/only-native-word-typed-features?
              (hir '(let [a (arena-scope 1)] a)))))
  (is (false? (ir/only-native-word-typed-features?
               (hir '(arena-scope (map-new)))))
      "the operand is walked, not waved through")
  ;; Arity is not this gate's question (a wrong-arity head of any family
  ;; falls to its `:else` and is refused later, by the verifier's table);
  ;; the verifier pins `arena-scope 1` by name.
  )
