(ns kotoba.kir-js-branding-test
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.kir :as kir]
            [kotoba.kir.js-operations :as operations]
            [kotoba.kir-js-operations-test :refer [evaluate]]
            #?(:cljs ["node:vm" :as vm])
            #?(:cljs ["node:child_process" :as child])
            #?(:cljs ["node:path" :as path])))

#?(:cljs
   (deftest branding-and-typeof-preserve-raw-host-semantics
     (let [reads (atom 0)
           object #js {}
           getter #js {}
           proxy (js/Proxy. #js {} #js {:get (fn [& _] (swap! reads inc) (throw (js/Error. "read")))})
           array-proxy (js/Proxy. #js [] #js {:get (fn [& _] (swap! reads inc) (throw (js/Error. "array read")))})
           callable-proxy (js/Proxy. (fn [] nil) #js {:get (fn [& _] (swap! reads inc) (throw (js/Error. "callable read")))})
           revoked (.revocable js/Proxy #js {} #js {})
           _ ((.-revoke revoked))
           _ (aset object "self" object)
           _ (.defineProperty js/Object getter "valueOf" #js {:get (fn [] (swap! reads inc) (throw (js/Error. "getter")))})
           _ (.defineProperty js/Object getter js/Symbol.toStringTag #js {:get (fn [] (swap! reads inc) (throw (js/Error. "tag")))})
           ;; A fixed trusted fixture from a different realm exercises branding,
           ;; rather than a same-realm instanceof approximation.
           foreign-array (.runInNewContext vm "[]")
           cases [[nil "object" false] [js/undefined "undefined" false]
                  [false "boolean" false] [true "boolean" false]
                  [0 "number" false] [(- 0.0) "number" false] [js/NaN "number" false]
                  [(js/BigInt "0") "bigint" false] [(js/BigInt "1") "bigint" false]
                  ["" "string" false] ["0" "string" false] [js/Infinity "number" false]
                  [object "object" false] [getter "object" false] [proxy "object" false]
                  [(js/Symbol "x") "symbol" false] [(fn [] nil) "function" false]
                  [(js/Array. 3) "object" true] [(js/Uint8Array. 3) "object" false]
                  [(js/Map.) "object" false] [(js/Object true) "object" false]
                  [(js/Object "x") "object" false] [(js/Object (js/BigInt "1")) "object" false]
                  [array-proxy "object" true] [callable-proxy "function" false]
                  [foreign-array "object" true]]]
       (doseq [[value type array] cases]
         (is (= type (operations/type-of value)))
         (is (= type (evaluate 'js-typeof [value])))
         (is (= array (operations/array? value)))
         (is (= array (evaluate 'js-array? [value]))))
       (is (= "object" (operations/type-of (.-proxy revoked))))
       (is (= "object" (evaluate 'js-typeof [(.-proxy revoked)])))
       (doseq [f [#(operations/array? (.-proxy revoked))
                  #(evaluate 'js-array? [(.-proxy revoked)])]]
         (is (try (f) false (catch :default e (instance? js/TypeError e)))))
       (doseq [value [true false]]
         (is (identical? value (operations/bool-value value)))
         (is (identical? value (evaluate 'js-bool-value [value]))))
       (doseq [[value] (remove (fn [[value]] (boolean? value)) cases)]
         (doseq [f [#(operations/bool-value value) #(evaluate 'js-bool-value [value])]]
           (is (= :js-operation-type
                  (try (f) nil (catch :default e (:trap (ex-data e))))))))
       (is (zero? @reads)))))

(deftest branding-arities-refuse-before-evaluating-operands
  (doseq [op ['js-typeof 'js-array? 'js-bool-value]
          args [[] [nil nil]]]
    (is (= :js-operation-arity
           (try (evaluate op args) nil
                (catch #?(:clj Exception :cljs :default) e (:trap (ex-data e)))))))
  (doseq [op ['js-typeof 'js-array? 'js-bool-value]]
    (is (= :js-operation-arity
           (try (kir/eval-expr (list op 'unbound 'unbound) {} {}
                               (volatile! 100) (atom {}) [] nil)
                nil
                (catch #?(:clj Exception :cljs :default) e (:trap (ex-data e))))))))

#?(:clj
   (deftest other-hosts-refuse-branding-and-injection
     (doseq [f [#(operations/type-of nil) #(operations/array? nil)
                #(operations/bool-value true) #(operations/bool-value 0)]]
       (is (= :js-value-host (try (f) nil (catch Exception e (:trap (ex-data e)))))))))

#?(:cljs
   (deftest array-observation-normalizes-overrides-without-return-hooks
     ;; Mutate the ambient Array in a separate JS process, preserving the
     ;; interpreter/test runner's own collection machinery. Exercise the
     ;; static host primitive used directly by operations/array?.
     (let [probe "const host=await import(process.argv[1]);
const saved=Array.isArray;const input={};let calls=0,reads=0;const value={};
Object.defineProperty(value,'valueOf',{get(){reads++;throw Error('coercion');}});
Object.defineProperty(value,Symbol.toPrimitive,{get(){reads++;throw Error('coercion');}});
const cases=[false,true,0,-0,NaN,0n,'',null,undefined,42,'x',value];
try{for(const result of cases){Array.isArray=v=>{calls++;if(v!==input)throw Error('identity');return result;};if(host.arrayBrand(input)!==!!result)throw Error('boolean observation');}
const error=Error('host error');Array.isArray=()=>{calls++;throw error;};let caught;try{host.arrayBrand(input)}catch(e){caught=e}if(caught!==error)throw Error('error identity');
}finally{Array.isArray=saved;}if(calls!==13||reads!==0)throw Error('evaluation count or return hook');console.log(JSON.stringify({cases:cases.length,calls,reads}));"
           result (.spawnSync child js/process.execPath
                              #js ["--input-type=module" "-e" probe
                                   (.resolve path "lib/kotoba.osaho/src/kotoba/kir/js_host.mjs")]
                              #js {:encoding "utf8" :timeout 10000})]
       (is (= 0 (.-status result)) (.-stderr result))
       (when (= 0 (.-status result))
         (let [metrics (js->clj (js/JSON.parse (.-stdout result)) :keywordize-keys true)]
           (is (= 12 (:cases metrics)))
           (is (= 13 (:calls metrics)))
           (is (= 0 (:reads metrics))))))))
