(ns kotoba.kir-line-slots-test
  "The ABI v8 line heads at the KIR level -- `string-index-of-from`,
  `string-compare-lines` -- pinned here as reference semantics, in UTF-8
  byte coordinates, on both hosts (i64 answers are BigInts on cljs,
  compared as text)."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.kir :as ir]
            [kotoba.test-hir :as test-hir]))

(defn- module [result body]
  (test-hir/module
   {:format :kotoba.hir/v3
    :entry 'main
    :exports '[main]
    :result result
    :schemas {}
    :schema-identities {}
    :functions [{:name 'main :params [] :param-types [] :result result
                 :body body}]}))

(defn- run [result body] (ir/execute (ir/lower (module result body)) 'main []))
(defn- n [body] (str (run :i64 body)))
(defn- refused [body]
  (try (do (run :i64 body) nil)
       (catch #?(:clj Throwable :cljs :default) e (or (:kind (ex-data e)) (ex-message e)))))

(deftest string-index-of-from-is-absolute
  (is (= "0" (n '(string-index-of-from "xaxab" "x" 0))))
  (is (= "2" (n '(string-index-of-from "xaxab" "x" 1))) "absolute, not relative to FROM")
  (is (= "2" (n '(string-index-of-from "xaxab" "xab" 0))))
  (is (= "-1" (n '(string-index-of-from "xaxab" "xab" 3))))
  (is (= "-1" (n '(string-index-of-from "abc" "c" 3))) "from the end: nothing")
  (is (= "9" (n '(string-index-of-from "日本語 a" " " 3))) "byte offsets: from the second code point (byte 3) to the blank at 9")
  (is (= "10" (n '(string-index-of-from "𝄞ab𝄞ab" "ab" 6))) "byte offsets: each astral code point is four bytes, so the second ab is at 10")
  (is (some? (refused '(string-index-of-from "abc" "c" 4))) "past the end is refused")
  (is (some? (refused '(string-index-of-from "日本" "本" 1))) "inside a code point is refused")
  (is (some? (refused '(string-index-of-from "abc" "" 0))) "the empty needle is refused"))

(deftest string-compare-lines-compares-newline-terminated-lines
  (is (= "-1" (n '(string-compare-lines "a\nb\n" 0 "a\nb\n" 2))) "a before b")
  (is (= "1" (n '(string-compare-lines "a\nb\n" 2 "a\nb\n" 0))))
  (is (= "0" (n '(string-compare-lines "ab\nab\n" 0 "ab\nab\n" 3))) "equal lines at different offsets")
  (is (= "-1" (n '(string-compare-lines "ab\nabc\n" 0 "ab\nabc\n" 3))) "a proper prefix is less")
  (is (= "0" (n '(string-compare-lines "ab\n" 0 "ab" 0))) "a last line without its newline is the same line")
  (is (= "-1" (n '(string-compare-lines "\nx" 0 "a" 0))) "the empty line before any other")
  (is (= "0" (n '(string-compare-lines "a\n" 2 "b\n" 2))) "the byte length is the empty line, on both sides")
  (is (= "1" (n '(string-compare-lines "a\tb\n" 0 "a\n" 0))) "a tab does not end a line; the longer line is greater")
  (is (= "-1" (n '(string-compare-lines "z\n" 0 "é\n" 0))) "byte order: z before é")
  (is (some? (refused '(string-compare-lines "日本" 1 "a" 0))) "inside a code point is refused"))
