(ns kotoba.kir-document-bytes-link-test
  "The :bytes and :link document kinds (root ADR-2610092310 S1).

  Pinned here, on both hosts:
  - canonical bytes `x<len>:<bytes>` and `c<len>:<binary CIDv1>`, read back by
    document-read; every digest below was taken outside this repository
    (Python hashlib over the same bytes, 2026-10-09);
  - textual EDN `#kotoba/bytes \"<lowercase hex>\"` and
    `#kotoba/cid \"b<base32>\"`, refusing any other spelling;
  - a link is one binary CIDv1 (version 1, four minimal varints, the digest
    length exact, at most 128 bytes): the KIR operation answers none for
    anything else, the value layer refuses it;
  - the documents that existed before keep their canonical bytes: three of
    kotoba-lang's lang/conformance/document/sha256_anchors.kotoba cases are
    re-checked here."
  (:require #?(:clj  [kotoba.test :refer [deftest is testing]]
               :cljs [cljs.test :refer [deftest is testing] :include-macros true])
            [kotoba.kir :as ir]
            [kotoba.kir.value :as value]
            [kotoba.test-hir :as test-hir]))

;; bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku: CIDv1 raw
;; sha2-256 of the empty string, in binary.
(def ^:private cid-items
  [1 85 18 32 227 176 196 66 152 252 28 20 154 251 244 200 153 111 185 36 39
   174 65 228 100 155 147 76 164 149 153 27 120 82 184 85])
(def ^:private cid-text "bafkreihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku")
(def ^:private cid-hex
  "01551220e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")

(defn- i64 [n] #?(:clj n :cljs (js/BigInt n)))

(def ^:private record
  ["map" [[:cid ["link" cid-items]] [:data ["bytes" [0 255 16]]]]])

(deftest canonical-bytes-and-digest-of-the-new-kinds
  (is (= "78333a00ff10" (value/document-print ["bytes" [0 255 16]])))
  (is (= "9a20ad21716d8ac7de1ab4e20a18e918538e89e094cb7561fb0abdab0f36a2b8"
         (value/document-sha256-hex ["bytes" [0 255 16]])))
  (is (= "78303a" (value/document-print ["bytes" []])))
  (is (= "5c5fc7941f031046baedb27ef5a3637fa70eb74e22892886eb516d33b84e4dba"
         (value/document-sha256-hex ["bytes" []])))
  (is (= (str "6333363a" cid-hex) (value/document-print ["link" cid-items])))
  (is (= "5b4949ac593035225cbf5f6c4137dd7771b8a4a80383633581ba30e81cd69139"
         (value/document-sha256-hex ["link" cid-items])))
  (is (= "20f76498d89ac2d9470b1c23ee03935e798afecaf61a2fd3e2fc7154c080d165"
         (value/document-sha256-hex record))))

(deftest canonical-bytes-read-back
  (doseq [doc [["bytes" [0 255 16]] ["bytes" []] ["link" cid-items] record]]
    (is (= (value/bounded-document! doc)
           (value/document-read (value/document-print doc))))))

(deftest existing-documents-keep-their-identity
  ;; values from kotoba-lang lang/conformance/document/sha256_anchors.kotoba
  (is (= "1b16b1df538ba12dc3f97edbb85caa7050d46c148134290feba80f8236c83db9"
         (value/document-sha256-hex ["null"])))
  (is (= "dd0e557677d6f5396976dd73f789b89ded541157a6d9de65360c37c6cd1d082a"
         (value/document-sha256-hex
          ["map" [[:a ["vector" [["bool" true]]]] [:bb ["null"]] [:zeta ["i64" (i64 1)]]]])))
  (is (= "74159aad14c30e8d381601e0787fd3ce45c063d831df9ad6402df94a5d4d5796"
         (value/document-sha256-hex
          ["map" [[["string" "aaaaaaaaaa"] ["i64" (i64 2)]] [["string" "b"] ["i64" (i64 1)]]]]))))

(deftest textual-edn-of-the-new-kinds
  (let [text (str "{:cid #kotoba/cid \"" cid-text "\" :data #kotoba/bytes \"00ff10\"}")]
    (is (= text (value/document-edn-print record)))
    (is (= (value/bounded-document! record) (value/document-edn-read text))))
  (is (= "#kotoba/bytes \"\"" (value/document-edn-print ["bytes" []])))
  (is (= ["bytes" []] (value/document-edn-read "#kotoba/bytes \"\"")))
  (testing "only the canonical spelling reads"
    (doseq [bad ["#kotoba/bytes \"00FF\"" "#kotoba/bytes \"0\"" "#kotoba/bytes 1"
                 "#kotoba/bytes  \"00\"" "#kotoba/blob \"00\"" "#inst \"2026\""
                 (str "#kotoba/cid \"" (subs cid-text 1) "\"")
                 (str "#kotoba/cid \"B" (subs cid-text 1) "\"")
                 "#kotoba/cid \"bafy\""]]
      (is (thrown? #?(:clj Exception :cljs :default) (value/document-edn-read bad)) bad))))

(deftest a-link-is-one-binary-cidv1
  (is (value/cidv1-binary-items? cid-items))
  (is (not (value/cidv1-binary-items? [])))
  (is (not (value/cidv1-binary-items? (assoc cid-items 0 0))) "version 0")
  (is (not (value/cidv1-binary-items? (pop cid-items))) "digest shorter than its length")
  (is (not (value/cidv1-binary-items? (conj cid-items 0))) "a trailing byte")
  (is (not (value/cidv1-binary-items? (into [1 85 18 128 0] (repeat 0 0)))) "non-minimal varint")
  (is (not (value/cidv1-binary-items? (into [1 85 18 125] (repeat 125 7)))) "129 bytes in all")
  (is (value/cidv1-binary-items? (into [1 85 18 124] (repeat 124 7))) "128 bytes in all")
  (is (thrown? #?(:clj Exception :cljs :default) (value/bounded-document! ["link" [1 2 3]])))
  (is (thrown? #?(:clj Exception :cljs :default) (value/bounded-document! ["bytes" [256]]))))

(deftest new-kinds-order-and-equal-by-canonical-bytes
  (is (= [["bytes" [1]] ["bytes" [2]]]
         (second (value/bounded-document! ["set" [["bytes" [1]] ["bytes" [2]]]]))))
  (is (thrown? #?(:clj Exception :cljs :default)
               (value/bounded-document! ["set" [["bytes" [1]] ["bytes" [1]]]]))))

;; --- the four KIR operations -------------------------------------------------

(defn- module [result body]
  (test-hir/module
   {:format :kotoba.hir/v3 :entry 'main :exports '[main] :result result
    :schemas {} :schema-identities {}
    :functions [{:name 'main :params [] :param-types [] :result result :body body}]}))

(defn- run [result body] (ir/execute (ir/lower (module result body)) 'main [] {}))
(defn- w [x] #?(:clj x :cljs (js/Number x)))
(defn- bytes-of [items] (list 'bytes-from-vector-i64 (cons 'vector-new items)))
(defn- link-of [items]
  (list 'option-value-of [:option :document] (list 'document-link (bytes-of items))
        (list 'document-null)))

(deftest the-kir-operations
  (testing "document-bytes and document-bytes-value round-trip"
    (is (= [0 255 16]
           (mapv w (run :vector-i64
                        (list 'vector-i64-from-bytes
                              (list 'option-value-of [:option :bytes]
                                    (list 'document-bytes-value (list 'document-bytes (bytes-of [0 255 16])))
                                    '(bytes-empty))))))))
  (testing "document-kind answers the new kinds"
    (is (= :bytes (run :keyword (list 'document-kind (list 'document-bytes (bytes-of [1]))))))
    (is (= :link (run :keyword (list 'document-kind (link-of cid-items))))))
  (testing "document-link answers none for bytes that are not one binary CIDv1"
    (is (= :null (run :keyword (list 'document-kind (link-of [1 2 3]))))))
  (testing "document-link-value reads the binary CID back"
    (is (= 36 (w (run :i64 (list 'bytes-count
                                 (list 'option-value-of [:option :bytes]
                                       (list 'document-link-value (link-of cid-items))
                                       '(bytes-empty))))))))
  (testing "a reader of the other kind answers none"
    (is (= 0 (w (run :i64 (list 'bytes-count
                                (list 'option-value-of [:option :bytes]
                                      (list 'document-link-value (list 'document-bytes (bytes-of [1])))
                                      '(bytes-empty))))))))
  (testing "document-sha256 of a document built by the operations"
    (is (= "9a20ad21716d8ac7de1ab4e20a18e918538e89e094cb7561fb0abdab0f36a2b8"
           (run :string (list 'document-sha256 (list 'document-bytes (bytes-of [0 255 16]))))))))
