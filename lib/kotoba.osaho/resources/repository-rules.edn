;; This repository's entry in the kotoba.repository-role-rules taxonomy.
;; Declared here (not merely inherited) so a reader of THIS repo alone can
;; verify which contract it claims to satisfy. ADR-2607266000.
{:schema "kotoba.repository-role-rules.v0"
 :this-repo
 {:name "osaho"
  ;; Renamed from "kotoba-kir" 2026-09-07 (owner decision). The
  ;; `kotoba.kir.*` namespaces are deliberately unchanged: names are not in a
  ;; DefCID, so no identity moved, and every consumer's require still resolves.
  :tier :t0
  :role :contract
  :must-not [:parse-kotoba-source :emit-machine-code-or-wasm :decide-policy]
  :depends-on ["kotoba-lang/security"
               ;; 2026-08-10 の IR 境界抽出で production 依存に入ったが宣言が
               ;; 追従していなかった。fleet の root-repository-roles gate が
               ;; missing-from-rule で赤にしていた（amu も同じ形で、そちらは
               ;; c2ff8799 で解消済み）。
               "kotoba-lang/org-ietf-cbor"
               "kotoba-lang/io-multiformats"
               "kotoba-lang/kotoba-hir"]}}
