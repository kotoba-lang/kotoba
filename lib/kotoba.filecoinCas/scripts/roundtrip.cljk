(ns roundtrip
  "Stage 1 acceptance: upload N random bytes to Filecoin Onchain Cloud on the
  calibration testnet and download them back, checking sha-256 equality.

    kbb --backend sci scripts/roundtrip.cljk [--bytes 1048576] [--fund]

  Uses a throwaway key kept in .filecoin-cas/calibration.key (gitignored,
  mode 0600); it is created on first run and never printed. --fund claims
  testnet FIL/USDFC from the public faucet for that address first."
  (:require ["node:fs" :as fs]
            ["node:path" :as path]
            ["node:crypto" :as crypto]
            ["@filoz/synapse-core/utils" :as core-utils]
            [promesa.core :as p]
            [filecoin-cas.synapse :as fc]))

(def key-file (.resolve path ".filecoin-cas/calibration.key"))

(defn load-or-create-key []
  (if (.existsSync fs key-file)
    (.trim (.readFileSync fs key-file "utf8"))
    (let [k (fc/generate-private-key)]
      (.mkdirSync fs (.dirname path key-file) #js {:recursive true})
      (.writeFileSync fs key-file (str k "\n") #js {:mode 0600})
      k)))

(defn arg [args flag default]
  (let [i (.indexOf (to-array args) flag)]
    (if (neg? i) default (nth args (inc i)))))

(defn sha256-hex [bytes]
  (-> (.createHash crypto "sha256") (.update bytes) (.digest "hex")))

(defn wait-for-usdfc
  "The faucet returns before its txs are indexed, so waiting on the receipt
  races; poll the wallet balance instead."
  [synapse tries]
  (p/let [{:keys [usdfc]} (fc/wallet-balances synapse)]
    (cond
      (not= "0" usdfc) :funded
      (zero? tries) (throw (ex-info "faucet funds did not arrive" {}))
      :else (p/do (p/delay 3000) (wait-for-usdfc synapse (dec tries))))))

(defn claim-faucet! [synapse]
  (p/do (core-utils/claimTokens #js {:address (fc/address synapse)})
        (wait-for-usdfc synapse 40)))

(defn -main [args]
  (let [n (js/Number (arg args "--bytes" "1048576"))
        fund? (some #{"--fund"} args)
        synapse (fc/make-synapse {:chain :calibration
                                  :private-key (load-or-create-key)
                                  :source "filecoin-cas-roundtrip"})
        data (js/Uint8Array. (.randomBytes crypto n))
        want (sha256-hex data)]
    (println "chain: calibration  address:" (fc/address synapse))
    (-> (p/let [_ (when fund?
                    (println "claiming faucet ...")
                    (claim-faucet! synapse))
                bal (fc/wallet-balances synapse)
                _ (println "wallet balances (base units):" (pr-str bal))
                prep (fc/prepare! synapse [n])
                _ (println "prepare:" (pr-str prep))
                up (fc/upload! synapse data {"kind" "roundtrip" "sha256" want})
                _ (println "uploaded:" (pr-str up))
                back (fc/download synapse (:piece-cid up))
                got (sha256-hex back)]
          (println "downloaded" (.-length back) "bytes")
          (if (= want got)
            (println "OK  sha256 match" want)
            (do (println "MISMATCH want" want "got" got)
                (js/process.exit 1))))
        (.catch (fn [e]
                  (println "FAILED:" (or (.-shortMessage e) (.-message e) (str e)))
                  (js/process.exit 1))))))

(-main (vec (drop 1 (seq js/process.argv))))
