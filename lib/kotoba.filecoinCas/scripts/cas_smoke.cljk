(ns cas-smoke
  "Stage 2 acceptance on the calibration testnet, through the real engine:
  put a CIDv1-raw object, drain it to Filecoin, reopen the tier from disk (a
  restart), fetch it back by CID with the spool gone, and verify.

    kbb --backend sci scripts/cas_smoke.cljk [--bytes 200000]

  Uses the throwaway key from scripts/roundtrip.cljk (.filecoin-cas/calibration.key)."
  (:require ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]
            ["node:crypto" :as crypto]
            [promesa.core :as p]
            [multiformats.core :as mf]
            [filecoin-cas.cid :as cid]
            [filecoin-cas.engine :as eng]
            [filecoin-cas.state :as state]
            [filecoin-cas.synapse :as fc]))

(defn arg [args flag default]
  (let [i (.indexOf (to-array args) flag)]
    (if (neg? i) default (nth args (inc i)))))

(defn- fail [msg] (println "FAIL:" msg) (js/process.exit 1))

(defn -main [args]
  (cid/install-fast-sha256!)
  (let [n (js/Number (arg args "--bytes" "200000"))
        key (.trim (.readFileSync fs (.resolve path ".filecoin-cas/calibration.key") "utf8"))
        synapse (fc/make-synapse {:chain :calibration :private-key key
                                  :source "filecoin-cas-smoke"})
        dir (.mkdtempSync fs (.join path (.tmpdir os) "fcas-smoke-"))
        open-tier #(eng/open {:dir dir
                              :upload! (fn [b m] (fc/upload! synapse b m))
                              :download (fn [pc] (fc/download synapse pc))})
        data (js/Uint8Array. (.randomBytes crypto n))
        c (mf/cidv1-raw data)]
    (println "state dir:" dir "\ncid:" c "bytes:" n)
    (-> (p/let [_ (fc/prepare! synapse [n])
                tier1 (open-tier)
                _ (eng/enqueue! tier1 c data)
                _ (println "queued:" (pr-str (eng/status tier1 c)))
                res (eng/drain! tier1)
                _ (println "drain:" (pr-str res))
                _ (when-not (every? :ok res) (fail "upload failed"))
                _ (when (state/spool-get dir c) (fail "spool not freed"))
                tier2 (open-tier)                     ; restart from disk
                _ (println "after restart:" (pr-str (dissoc (eng/status tier2 c) :copies)))
                back (eng/fetch tier2 c)]
          (cond
            (nil? back) (fail "fetch returned nil")
            (not= (vec data) (vec back)) (fail "bytes differ")
            :else (println "OK  cid" c "round-tripped through Filecoin, restart included")))
        (.catch (fn [e] (fail (or (.-shortMessage e) (.-message e) (str e))))))))

(-main (vec (drop 1 (seq js/process.argv))))
