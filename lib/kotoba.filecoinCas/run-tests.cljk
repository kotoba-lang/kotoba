;; Entry: kbb --backend sci run-tests.cljk
;; Exits non-zero when a suite fails.
(ns run-tests
  (:require [kotoba.test :as t]
            [filecoin-cas.cid-test]
            [filecoin-cas.index-test]
            [filecoin-cas.engine-test]
            [filecoin-cas.server-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (when-not (t/successful? m) (js/process.exit 1)))

(t/run-tests 'filecoin-cas.cid-test 'filecoin-cas.index-test 'filecoin-cas.engine-test
              'filecoin-cas.server-test)
