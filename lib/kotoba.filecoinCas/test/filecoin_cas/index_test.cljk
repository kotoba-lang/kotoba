(ns filecoin-cas.index-test
  (:require [kotoba.test :refer [deftest is testing]]
            [filecoin-cas.index :as ix]))

(def c1 "bafkreiaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
(def c2 "bafkreibbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")

(deftest enqueue-is-idempotent
  (let [i1 (ix/enqueue (ix/empty-index) c1 10 100)
        i2 (ix/enqueue i1 c1 999 200)]
    (is (= i1 i2))
    (is (= {:queued 1 :stored 0 :bytes-queued 10} (ix/stats i2)))))

(deftest stored-objects-are-never-requeued
  (let [i (-> (ix/empty-index) (ix/enqueue c1 10 100)
              (ix/mark-stored c1 {:piece-cid "p1" :complete? true :copies [{}]} 150)
              (ix/enqueue c1 10 300))]
    (is (= :stored (:state (ix/lookup i c1))))
    (is (empty? (ix/due i 9999999 10)))))

(deftest due-respects-backoff-order-and-limit
  (let [i (-> (ix/empty-index) (ix/enqueue c2 1 200) (ix/enqueue c1 1 100))]
    (is (= [c1 c2] (ix/due i 1000 10)) "oldest first")
    (is (= [c1] (ix/due i 1000 1)) "limit")
    (let [f (ix/mark-failed i c1 "boom" 1000)]
      (is (= [c2] (ix/due f 1000 10)) "failed one waits for its backoff")
      (is (= [c1 c2] (ix/due f (+ 1000 ix/base-backoff-ms) 10))
          "and is due again after it, still ordered by queued-at"))))

(deftest backoff-doubles-and-caps
  (is (= 5000 (ix/backoff-ms 1)))
  (is (= 10000 (ix/backoff-ms 2)))
  (is (= 20000 (ix/backoff-ms 3)))
  (is (= ix/max-backoff-ms (ix/backoff-ms 40))))

(deftest failure-keeps-the-object-queued-and-counts-attempts
  (let [i (-> (ix/empty-index) (ix/enqueue c1 5 0)
              (ix/mark-failed c1 "e1" 10) (ix/mark-failed c1 "e2" 20))
        o (ix/lookup i c1)]
    (is (= :queued (:state o)))
    (is (= 2 (:attempts o)))
    (is (= "e2" (:error o)))
    (is (= (+ 20 (ix/backoff-ms 2)) (:next-at o)))))

(deftest stored-records-piece-and-clears-error
  (let [i (-> (ix/empty-index) (ix/enqueue c1 5 0) (ix/mark-failed c1 "e" 10)
              (ix/mark-stored c1 {:piece-cid "pc" :complete? false
                                  :copies [{:provider-id "9"}]} 99))
        o (ix/lookup i c1)]
    (is (= :stored (:state o)))
    (is (nil? (:error o)))
    (is (= false (:complete? o)))
    (is (= c1 (ix/cid-for-piece i "pc")))
    (is (= {:queued 0 :stored 1 :bytes-queued 0} (ix/stats i)))))
