(ns filecoin-cas.cid-test
  (:require ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as nodepath]
            [kotoba.test :refer [deftest is testing async]]
            [multiformats.core :as mf]
            [filecoin-cas.cid :as cid]))

(defn- bytes-of [s] (.encode (js/TextEncoder.) s))

(deftest fast-sha256-installs-and-agrees
  (testing "the host digest is installed and yields the same CID as portable"
    (let [b (bytes-of "hello filecoin")
          portable (mf/cidv1-raw b)]
      (is (= :installed (cid/install-fast-sha256!)))
      (is (= portable (mf/cidv1-raw b))))))

(deftest matches-raw-and-dag-cbor
  (let [b (bytes-of "artifact bytes")]
    (cid/install-fast-sha256!)
    (is (cid/matches? (mf/cidv1-raw b) b))
    (is (cid/matches? (mf/cidv1-dag-cbor b) b))))

(deftest rejects-wrong-bytes-and-malformed-cids
  (let [b (bytes-of "one") c (mf/cidv1-raw b)]
    (cid/install-fast-sha256!)
    (is (not (cid/matches? c (bytes-of "two"))))
    (is (not (cid/matches? "Qm123" b)))
    (is (not (cid/matches? nil b)))
    (is (not (cid/matches? "../etc/passwd" b)))))

(deftest verify-throws-with-reason
  (let [b (bytes-of "x")]
    (cid/install-fast-sha256!)
    (is (= b (cid/verify! (mf/cidv1-raw b) b)))
    (is (= :cid-mismatch
           (try (cid/verify! (mf/cidv1-raw b) (bytes-of "y"))
                (catch :default e (:reason (ex-data e))))))
    (is (= :spool-corrupt
           (try (cid/verify! (mf/cidv1-raw b) (bytes-of "y") :spool-corrupt)
                (catch :default e (:reason (ex-data e))))))))

(defn- temp-file-with [bytes]
  (let [d (.mkdtempSync fs (.join nodepath (.tmpdir os) "fcas-cid-"))
        f (.join nodepath d "obj")]
    (.writeFileSync fs f bytes)
    f))

(deftest digest-based-checks-agree-with-byte-checks
  (cid/install-fast-sha256!)
  (let [b (bytes-of "hash me by digest")
        h (.digest (.update (.createHash (js/require "node:crypto") "sha256") b))
        digest (js/Uint8Array. h)]
    (is (= #{(mf/cidv1-raw b) (mf/cidv1-dag-cbor b)} (cid/digest->cids digest)))
    (is (cid/matches-digest? (mf/cidv1-raw b) digest))
    (is (cid/matches-digest? (mf/cidv1-dag-cbor b) digest))
    (is (not (cid/matches-digest? (mf/cidv1-raw (bytes-of "other")) digest)))
    (is (not (cid/matches-digest? "not-a-cid" digest)))))

(deftest hashing-a-file-streams-and-matches
  (async done
    (cid/install-fast-sha256!)
    (let [;; bigger than one 1 MiB read, so the chunk loop runs more than once
          b (js/Buffer.alloc (+ (* 3 1024 1024) 17))
          _ (dotimes [i (.-length b)] (aset b i (mod (* i 7) 251)))
          file (temp-file-with b)
          c (mf/cidv1-raw b)]
      (-> (js/Promise.all #js [(cid/hash-file file)
                               (cid/verify-file! c file)
                               (-> (cid/verify-file! (mf/cidv1-raw (bytes-of "x")) file :spool-corrupt)
                                   (.then (fn [_] :accepted))
                                   (.catch (fn [e] (cid/error-reason e))))])
          (.then (fn [rs]
                   (let [hashed (aget rs 0)]
                     (is (= (+ (* 3 1024 1024) 17) (:bytes hashed)))
                     (is (cid/matches-digest? c (:digest hashed)))
                     (is (= (+ (* 3 1024 1024) 17) (aget rs 1)))
                     (is (= :spool-corrupt (aget rs 2)) "a mismatch rejects with the given reason")
                     (is (= (:bytes hashed) (:bytes (cid/hash-file-sync file))))
                     (is (= (vec (:digest hashed)) (vec (:digest (cid/hash-file-sync file))))
                         "sync and streaming hashes agree"))))
          (.catch (fn [e] (is (nil? e) (str "unexpected: " (.-message e)))))
          (.finally done)))))
