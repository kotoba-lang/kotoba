(ns filecoin-cas.state
  "Filesystem persistence for the Filecoin tier under one state directory:

    <dir>/index.edn         the filecoin-cas.index value, written atomically
    <dir>/spool/<cid>       bytes awaiting upload, kept until the object is stored
    <dir>/spool/.tmp-*      a PUT being received (never mistaken for a spool file)
    <dir>/fetch/.tmp-*      an object being downloaded for a GET

  The spool file is written before the index says :queued, and removed only
  after it says :stored, so a crash at any point leaves either a retryable
  queued object or an orphan spool file that `orphans` finds."
  (:require ["node:fs" :as fs]
            ["node:crypto" :as crypto]
            ["node:path" :as path]
            [clojure.edn :as edn]
            [filecoin-cas.index :as index]))

(defn- index-file [dir] (.join path dir "index.edn"))
(defn- spool-dir [dir] (.join path dir "spool"))

(defn spool-path
  "Spool file for `cid`. The CID is checked because it becomes a file name."
  [dir cid]
  (when-not (re-matches #"baf[a-z2-7]+" (str cid))
    (throw (ex-info "filecoin-cas: invalid CID for spool" {:reason :invalid-cid})))
  (.join path (spool-dir dir) cid))

(defn- write-atomic! [file data]
  (.mkdirSync fs (.dirname path file) #js {:recursive true})
  (let [tmp (str file "." (.-pid js/process) ".tmp")
        fd (.openSync fs tmp "w" 0600)]
    (try (.writeSync fs fd data)
         (.fsyncSync fs fd)
         (finally (.closeSync fs fd)))
    (.renameSync fs tmp file)))

(defn load-index [dir]
  (let [f (index-file dir)]
    (if (.existsSync fs f)
      (edn/read-string (.readFileSync fs f "utf8"))
      (index/empty-index))))

(defn save-index! [dir idx]
  (write-atomic! (index-file dir) (pr-str idx)))

(defn spool-put! [dir cid bytes]
  (write-atomic! (spool-path dir cid) bytes))

(defn spool-get
  "Spooled bytes as a Uint8Array, or nil when absent."
  [dir cid]
  (let [f (spool-path dir cid)]
    (when (.existsSync fs f)
      (js/Uint8Array. (.readFileSync fs f)))))

(defn spool-file
  "Path of the spool file for `cid` when it exists, else nil (nothing is read)."
  [dir cid]
  (let [f (spool-path dir cid)] (when (.existsSync fs f) f)))

(defn- tmp-file [parent]
  (.mkdirSync fs parent #js {:recursive true})
  (.join path parent (str ".tmp-" (.randomUUID crypto))))

(defn spool-tmp-path
  "A fresh temp path inside the spool directory (same filesystem as the final
  spool path, so `spool-adopt!` is an atomic rename)."
  [dir]
  (tmp-file (spool-dir dir)))

(defn fetch-tmp-path
  "A fresh temp path for an object being downloaded."
  [dir]
  (tmp-file (.join path dir "fetch")))

(defn spool-adopt!
  "Move a fully received, already verified temp file into place as the spool
  file for `cid`."
  [dir cid tmp]
  (.renameSync fs tmp (spool-path dir cid)))

(defn remove-file! [file]
  (try (when (.existsSync fs file) (.unlinkSync fs file)) (catch :default _ nil)))

(defn sweep-temp!
  "Delete leftovers of interrupted PUTs and GETs (.tmp-* files) under `dir`."
  [dir]
  (doseq [sub ["spool" "fetch"]
          :let [d (.join path dir sub)]
          :when (.existsSync fs d)
          f (.readdirSync fs d)
          :when (.startsWith f ".tmp-")]
    (remove-file! (.join path d f))))

(defn spool-delete! [dir cid]
  (let [f (spool-path dir cid)]
    (when (.existsSync fs f) (.unlinkSync fs f))))

(defn spooled-cids
  "CIDs that currently have a spool file (temp files are ignored)."
  [dir]
  (let [d (spool-dir dir)]
    (if (.existsSync fs d)
      (vec (filter #(re-matches #"baf[a-z2-7]+" %) (.readdirSync fs d)))
      [])))
