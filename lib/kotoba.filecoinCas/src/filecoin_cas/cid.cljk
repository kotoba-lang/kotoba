(ns filecoin-cas.cid
  "CID verification for objects that pass through the Filecoin tier.

  Synapse only proves bytes against a PieceCID (CommP). The identity murakumo
  and yataverse use is a CIDv1 (`baf...`, raw or dag-cbor, sha2-256), so every
  byte that enters or leaves this tier is re-checked against that CID here.
  Same acceptance rule as murakumo.artifact-store."
  (:require ["node:crypto" :as crypto]
            ["node:fs" :as fs]
            [multiformats.core :as mf]))

(defn valid-cid? [cid]
  (boolean (and (string? cid) (re-matches #"baf[a-z2-7]+" cid))))

(defn install-fast-sha256!
  "On ClojureScript multiformats defaults to a portable SHA-256 that is orders
  of magnitude slower than the host's. Install node:crypto's, once. The seam
  proves the candidate against the portable digest before accepting it."
  []
  (when (= :portable (mf/sha256-provider))
    (mf/install-sha256!
      (fn [b]
        (js/Uint8Array. (.digest (.update (.createHash crypto "sha256") b))))))
  (mf/sha256-provider))

(defn matches?
  "True when `cid` is the raw or dag-cbor CIDv1 of `bytes`. Hashes once."
  [cid bytes]
  (and (valid-cid? cid)
       (let [mh (mf/multihash-sha256 bytes)]
         (or (= cid (mf/cidv1 mf/codec-raw mh))
             (= cid (mf/cidv1 mf/codec-dag-cbor mh))))))

(defn digest->cids
  "The two CIDv1 strings (raw, dag-cbor) whose sha2-256 multihash is `digest`
  (32 bytes). Lets a caller that hashed a stream compare without holding the
  bytes."
  [digest]
  (let [mh (js/Uint8Array.from (clj->js (into [0x12 0x20] (array-seq digest))))]
    #{(mf/cidv1 mf/codec-raw mh) (mf/cidv1 mf/codec-dag-cbor mh)}))

(defn matches-digest?
  "True when `cid` is the raw or dag-cbor CIDv1 of content whose sha-256 is
  `digest`."
  [cid digest]
  (and (valid-cid? cid) (contains? (digest->cids digest) cid)))

(defn hash-file
  "Stream `path` through sha-256 without holding it in memory. Promise of
  {:digest Uint8Array :bytes n}."
  [path]
  (js/Promise.
    (fn [resolve reject]
      (let [h (.createHash crypto "sha256")
            n (atom 0)
            stream (.createReadStream fs path #js {:highWaterMark (* 1024 1024)})]
        (.on stream "data" (fn [chunk] (swap! n + (.-length chunk)) (.update h chunk)))
        (.on stream "error" reject)
        (.on stream "end" #(resolve {:digest (js/Uint8Array. (.digest h)) :bytes @n}))))))

(defn hash-file-sync
  "Like `hash-file` but blocking, in 1 MiB reads. For startup recovery only."
  [path]
  (let [fd (.openSync fs path "r")
        h (.createHash crypto "sha256")
        buf (js/Buffer.alloc (* 1024 1024))]
    (try
      (loop [total 0]
        (let [n (.readSync fs fd buf 0 (.-length buf) nil)]
          (if (zero? n)
            {:digest (js/Uint8Array. (.digest h)) :bytes total}
            (do (.update h (.subarray buf 0 n)) (recur (+ total n))))))
      (finally (.closeSync fs fd)))))

(defn verify-file!
  "Promise of the byte count when the file at `path` hashes to `cid`; rejects
  with `reason` (default :cid-mismatch) otherwise."
  ([cid path] (verify-file! cid path :cid-mismatch))
  ([cid path reason]
   (.then (hash-file path)
          (fn [{:keys [digest bytes]}]
            (when-not (matches-digest? cid digest)
              (throw (ex-info (str "filecoin-cas: " (name reason)) {:reason reason :cid cid})))
            bytes))))

(defn verify!
  "Return `bytes` when they match `cid`; otherwise throw with `reason`
  (default :cid-mismatch) so callers can tell inbound from outbound faults."
  ([cid bytes] (verify! cid bytes :cid-mismatch))
  ([cid bytes reason]
   (when-not (matches? cid bytes)
     (throw (ex-info (str "filecoin-cas: " (name reason)) {:reason reason :cid cid})))
   bytes))

(defn error-reason
  "The :reason of a filecoin-cas failure, however it arrived. Under nbb/SCI an
  ex-info thrown inside a promise callback is re-wrapped as a :sci/error whose
  original is the ex-cause, so walk the cause chain instead of reading
  ex-data once."
  [e]
  (->> (iterate ex-cause e)
       (take-while some?)
       (some #(:reason (ex-data %)))))
