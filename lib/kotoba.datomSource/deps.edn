{:paths ["src"]
 :deps {
        io.github.kotoba-lang/coll {:local/root "../kotoba.coll"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; PRIMARY gate: the same portable suite under real ClojureScript. No npm
  ;; and no shadow-cljs, because this library has zero runtime deps and
  ;; `cljs.main --target node` needs neither -- same shape `merkle-sum` uses.
  ;;   kbb -Sdeps '{:paths ["src" "test"]}' -M:cljs \
  ;;     -m cljs.main --target node -m datom.cljs-runner
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed). It earns
  ;; its place here: lint is what caught the JVM-only-function-in-.cljc defect
  ;; in two sibling repos this month, before any test could.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
