{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotoba-lang.github.io/mail-a2a/schema/envelope-v1.schema.json",
  "title": "MailA2A protected envelope 1.0",
  "type": "object",
  "required": [
    "bindingVersion", "a2aVersion", "kind", "operation", "messageId",
    "sequence", "final", "payload"
  ],
  "properties": {
    "bindingVersion": {"const": "1.0"},
    "a2aVersion": {"type": "string", "minLength": 1},
    "kind": {"enum": ["request", "response", "event", "error"]},
    "operation": {
      "enum": [
        "message/send", "message/stream", "tasks/get", "tasks/list",
        "tasks/cancel", "tasks/subscribe", "push/create", "push/get",
        "push/list", "push/delete", "agent-card/get-extended"
      ]
    },
    "messageId": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1},
    "taskId": {"type": ["string", "null"]},
    "contextId": {"type": ["string", "null"]},
    "sequence": {"type": "integer", "minimum": 0},
    "final": {"type": "boolean"},
    "createdAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "idempotencyKey": {"type": "string", "minLength": 1},
    "serviceParameters": {"type": "object"},
    "payload": {"type": "object"},
    "error": {"type": "object"},
    "payment": {
      "type": "object",
      "required": ["kind", "x402Version", "object"],
      "properties": {
        "kind": {"enum": ["required", "payload", "response"]},
        "x402Version": {"const": 2},
        "object": {"type": "object"}
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "epoch", "generation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "epoch": {"type": "integer", "minimum": 0},
        "generation": {"type": "integer", "minimum": 0}
      }
    }
  },
  "additionalProperties": true
}
