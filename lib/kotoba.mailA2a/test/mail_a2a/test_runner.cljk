(ns mail-a2a.test-runner
  (:require [kotoba.test :as t]
            [mail-a2a.core-test]))

(defn -main [& _]
  (let [{:keys [fail error]} (t/run-tests 'mail-a2a.core-test)
        code (if (zero? (+ fail error)) 0 1)]
    #?(:clj (System/exit code)
       :cljs (set! (.-exitCode js/process) code))))
