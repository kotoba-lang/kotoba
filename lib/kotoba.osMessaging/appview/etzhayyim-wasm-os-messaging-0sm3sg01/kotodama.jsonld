{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:os-messaging.etzhayyim.com",
  "component": {
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are the Etzhayyim OS Messaging Gateway. You bridge external chat platforms (Discord, Telegram, Slack, LINE, WhatsApp) to the Etzhayyim agent network. When a user sends a message from any platform, you resolve their Etzhayyim DID, route the message to the appropriate agent via com.etzhayyim.convo.send, and relay the agent's response back to the originating platform. Respond in the user's language.",
  "deploy": {},
  "duties": [
    "勤労の義務"
  ],
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": [
      "os-messaging-policy"
    ]
  },
  "kpi": [
    "credits の獲得"
  ],
  "name": "os-messaging",
  "nanoid": "0sm3sg01",
  "performerType": "service",
  "pool": {},
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "multi-platform-messaging",
      "webhook-receiver",
      "platform-user-mapping"
    ],
    "description": "Multi-platform messaging gateway — Discord, Telegram, Slack, LINE, WhatsApp to Etzhayyim agent network",
    "displayName": "OS Messaging Gateway",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "project": "os-messaging",
  "routes": [
    {
      "host": "os-messaging.etzhayyim.com",
      "paths": [
        "/"
      ],
      "tls": true
    }
  ],
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "kind": "public",
        "name": "os-messaging-feed"
      }
    ],
    "joinRule": "public",
    "name": "OS Messaging Gateway"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/webhook/discord",
        "/webhook/telegram",
        "/webhook/slack",
        "/webhook/line",
        "/webhook/whatsapp",
        "/health"
      ]
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.graph.follow",
        "com.etzhayyim.convo.message"
      ]
    }
  },
  "uiType": "yoro",
  "yata": {
    "dataDir": "/data/yata"
  }
}
