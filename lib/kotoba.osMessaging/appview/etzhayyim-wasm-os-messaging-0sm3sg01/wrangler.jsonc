{
  // NOTE: this app used to be built by SvelteKit's @sveltejs/adapter-cloudflare,
  // which emitted both a server-rendering Worker script (`main`, pointed at
  // the SvelteKit Cloudflare adapter build output) and a static client bundle
  // (`assets.directory`, the +page.svelte status page). The deployed XRPC
  // handler behind that build was svelte/src/routes/xrpc/[...path]/+server.ts
  // — moved (not deleted) to src/xrpc-proxy.ts, see that file's header.
  //
  // The frontend was migrated to a plain ClojureScript (shadow-cljs + reagent
  // + re-frame + jp-go-dds) static bundle with no server-rendering step — see
  // cljs/ and the repo README. `assets.directory` now points at the cljs
  // build output.
  //
  // Unlike the gmail appview's migration, `main` is DROPPED here entirely,
  // not repointed at src/app.ts: src/app.ts (this repo's
  // @etzhayyim/kotodama-host-sdk actor facade, registering NSID commands
  // such as com.etzhayyim.apps.osMessaging.webhookDiscord) does NOT call
  // env.ASSETS.fetch(...) anywhere — it has no fallback branch that would
  // serve the static bundle. Placing a Worker in front of `assets` that
  // never falls through to them would mean nothing serves the static
  // files, so per this migration's rule, `main` is removed instead of
  // being repointed. This is also consistent with this repo's
  // kotodama.jsonld, whose `component.path` is `component.wasm` — src/app.ts
  // is compiled/run as a separate actor component elsewhere, not as this
  // Cloudflare Worker's `main`. With no `main`, this deploy target becomes
  // an assets-only Worker: Cloudflare serves `assets.directory` directly.
  // src/xrpc-proxy.ts (the moved +server.ts) is likewise NOT wired as
  // `main` — it duplicates a subset of what src/app.ts's own NSID commands
  // do, via a different mechanism (raw HTTP proxy to
  // AGENTGATEWAY_MCP_ROUTER_URL vs. the host SDK's command/query dispatch),
  // and reviving/reconciling either of them into this wrangler.jsonc is an
  // open product decision, not made here.
  //
  // This edit is unverified: `wrangler deploy`/`wrangler dev` were not run
  // against it.
  "name": "kotodama-0sm3sg01",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"multi-platform-messaging\",\"webhook-receiver\",\"platform-user-mapping\"]",
    "APP_DESCRIPTION": "Multi-platform messaging gateway — Discord, Telegram, Slack, LINE, WhatsApp to etzhayyim agent network",
    "APP_DISPLAY_NAME": "OS Messaging Gateway",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "0sm3sg01",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "MURAKUMO_URL": "https://murakumo.etzhayyim.com/api/openai/v1/chat/completions",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "0sm3sg01.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "os-messaging.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
