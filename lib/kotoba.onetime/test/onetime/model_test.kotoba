(ns onetime.model-test (:export [main]) (:require [onetime.model :as p]))

(defn- fstr [d :document k :keyword] :string
  (option-or (document-string-value (option-or (document-get d k) (document-null))) "?"))

(defn- fedn [d :document k :keyword] :string
  (document-edn-print (option-or (document-get d k) (document-null))))

(defn- main-case [] :i64
  (let [c (p/challenge (document-string "O1") (document-keyword :totp)
                       (document-map :subject (document-string "u") :digest-ref (document-string "d")))
        ok (p/result c true (document-map :attempts (document-i64 1)))
        bad (p/result c false (document-map))]
    (+ (if (string=? (fstr c :onetime/id) "O1") 0 1)
       (if (string=? (fedn c :onetime/kind) ":totp") 0 1)
       (if (string=? (fstr c :onetime/digest-ref) "d") 0 1)
       (if (string=? (fedn c :onetime/expires-at) "nil") 0 1)
       (if (string=? (fstr ok :onetime/id) "O1") 0 1)
       (if (string=? (fedn ok :onetime/ok?) "true") 0 1)
       (if (string=? (fedn ok :onetime/attempts) "1") 0 1)
       (if (string=? (fedn ok :onetime/verified-at) "nil") 0 1)
       (if (string=? (fedn bad :onetime/ok?) "false") 0 1))))

(defn main [] :i64
  (+ (main-case)
     (if (= (document-count (p/kinds)) 6) 0 1)))
