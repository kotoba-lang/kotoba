;; Test for onetime.datom. main returns the number of failed cases (0 = pass).
(ns onetime.datom-test
  (:export [main])
  (:require [onetime.datom :as d]))

(defn- g [m :document k :keyword] :document
  (option-value-of [:option :document] (document-get m k) (document-null)))
(defn- sv [m :document k :keyword] :string
  (option-value-of [:option :string] (document-string-value (g m k)) "<none>"))
(defn- bv [m :document k :keyword] :bool
  (option-value-of [:option :bool] (document-bool-value (g m k)) false))
(defn- first-of [v :document] :document
  (option-value-of [:option :document] (document-vector-at v 0) (document-null)))
(defn- chk-str [got :string want :string] :i64
  (if (string=? got want) 0 1))
(defn- chk-bool [got :bool want :bool] :i64
  (if (= got want) 0 1))
(defn- chk-i64 [got :i64 want :i64] :i64
  (if (= got want) 0 1))

(defn main [] :i64
  (let [ch (document-map :onetime/id (document-string "c1")
                         :onetime/kind (document-string "totp")
                         :onetime/subject (document-string "alice")
                         :onetime/purpose (document-string "login")
                         :onetime/digest-ref (document-string "sha:1")
                         :onetime/created-at (document-string "t0")
                         :onetime/expires-at (document-string "t1"))
        cds (d/challenge-datoms ch)
        cd (first-of cds)
        a (chk-i64 (document-count cds) 1)
        b (chk-str (sv cd :db/id) "c1")
        c (chk-str (sv cd :onetime/kind) "totp")
        e (chk-str (sv cd :onetime/expires-at) "t1")
        rs (document-map :onetime/id (document-string "r1")
                         :onetime/kind (document-string "totp")
                         :onetime/ok? (document-bool true)
                         :onetime/attempts (document-i64 2)
                         :onetime/verified-at (document-string "t2"))
        rd (first-of (d/result-datoms rs))
        f (chk-str (sv rd :db/id) "r1:result")
        k (chk-bool (bv rd :onetime/ok?) true)
        h (chk-str (sv rd :onetime/verified-at) "t2")]
    (+ a (+ b (+ c (+ e (+ f (+ k h))))))))
