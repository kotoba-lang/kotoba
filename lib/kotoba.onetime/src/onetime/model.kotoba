;; Port of onetime.model (model.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from model.cljk:
;;   - kinds is a set in the source. It is a zero-arg function returning the
;;     members as a :document vector of keywords (cross-module constants are
;;     not exportable in amu).
;;   - result's ok? is a :bool here. The source applies clojure boolean, so
;;     any truthy value gives true; the caller must pass a bool.
;;   - a non-map opts or challenge reads every field as document-null.

(ns onetime.model
  (:export [kinds challenge result]))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn kinds [] :document
  (document-vector (document-keyword :totp)
                   (document-keyword :hotp)
                   (document-keyword :email-code)
                   (document-keyword :sms-code)
                   (document-keyword :recovery-code)
                   (document-keyword :transaction-code)))

(defn challenge [id :document kind :document opts :document] :document
  (document-map :onetime/id id
                :onetime/kind kind
                :onetime/subject (field opts :subject)
                :onetime/purpose (field opts :purpose)
                :onetime/digest-ref (field opts :digest-ref)
                :onetime/created-at (field opts :created-at)
                :onetime/expires-at (field opts :expires-at)))

(defn result [challenge :document ok? :bool opts :document] :document
  (document-map :onetime/id (field challenge :onetime/id)
                :onetime/kind (field challenge :onetime/kind)
                :onetime/ok? (document-bool ok?)
                :onetime/attempts (field opts :attempts)
                :onetime/verified-at (field opts :verified-at)))
