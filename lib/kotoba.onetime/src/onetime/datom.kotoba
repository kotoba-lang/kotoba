;; Port of onetime.datom (datom.cljk), Kotoba-native.
;;
;; Records are :document maps. Named divergences:
;;   - a missing field (nil in the source) is the document null, kept as a
;;     key with a null value (same shape as the source map).
;;   - the :db/id of a result datom is (str id ":result"); a missing or
;;     non-string id contributes "" (the source would print its str form).
(ns onetime.datom
  (:export [challenge-datoms result-datoms]))

(defn- doc-get [m :document k :keyword] :document
  (option-value-of [:option :document] (document-get m k) (document-null)))

(defn- str-of [d :document] :string
  (option-value-of [:option :string] (document-string-value d) ""))

(defn challenge-datoms [challenge :document] :document
  (document-vector
   (document-map :db/id (doc-get challenge :onetime/id)
                 :onetime/kind (doc-get challenge :onetime/kind)
                 :onetime/subject (doc-get challenge :onetime/subject)
                 :onetime/purpose (doc-get challenge :onetime/purpose)
                 :onetime/digest-ref (doc-get challenge :onetime/digest-ref)
                 :onetime/created-at (doc-get challenge :onetime/created-at)
                 :onetime/expires-at (doc-get challenge :onetime/expires-at))))

(defn result-datoms [result :document] :document
  (document-vector
   (document-map :db/id (document-string (string-concat (str-of (doc-get result :onetime/id)) ":result"))
                 :onetime/id (doc-get result :onetime/id)
                 :onetime/kind (doc-get result :onetime/kind)
                 :onetime/ok? (doc-get result :onetime/ok?)
                 :onetime/attempts (doc-get result :onetime/attempts)
                 :onetime/verified-at (doc-get result :onetime/verified-at))))
