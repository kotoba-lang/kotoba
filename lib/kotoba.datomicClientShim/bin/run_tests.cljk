;; nbb test runner — first-class runtime per repo rule (kotoba wasm >
;; clojurewasm > cljs > nbb > (jvm/bb)). Run from the repo root:
;;
;;   kbb --backend sci --classpath "src:test:.deps/kotobase/src:.deps/ayatori/src:.deps/arrangement/src:.deps/prolly-tree/src:.deps/io-ipld/src:.deps/io-multiformats/src:.deps/org-nist-sha2/src:.deps/org-ietf-cbor/src:.deps/dev-protobuf/src:.deps/datom-source/src:.deps/datalog/src:.deps/io-ipni-specs/src" bin/run_tests.cljk
;;
;; where every .deps/<name> is a checkout of the matching kotoba-lang repo
;; at the SHA pinned in deps.edn (kotobase, ayatori) or in ayatori's own
;; deps.edn transitively (arrangement, prolly-tree, io-ipld, io-multiformats,
;; org-ietf-cbor, dev-protobuf, datom-source, datalog, io-ipni-specs).
;; CI pins every one of them to the same SHAs -- see .github/workflows/ci.yml.
(ns run-tests
  (:require [cljs.test :as t]
            [kotobase.protocols.datomic-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (when-not (t/successful? m)
    (set! (.-exitCode js/process) 1)))

(t/run-tests 'kotobase.protocols.datomic-test)
