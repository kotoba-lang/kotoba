(ns kotoba.bencode)

(defn bencode-digit? [b]
  (if (and (>= b 48) (<= b 57)) 1 0))

(defn bencode-parse-decimal [ptr end index value digits max-value]
  (if (or (>= index end) (>= digits 10))
    -1
    (let [b (mem-byte-at ptr index)]
      (if (= b 58)
        (if (> digits 0) (+ index 1) -1)
        (if (= (bencode-digit? b) 0)
          -1
          (let [next (+ (* value 10) (- b 48))]
            (if (> next max-value)
              -1
              (bencode-parse-decimal ptr end (+ index 1) next
                                     (+ digits 1) max-value))))))))

(defn bencode-decimal-value [ptr colon-index index value]
  (if (= index colon-index)
    value
    (bencode-decimal-value ptr colon-index (+ index 1)
                           (+ (* value 10) (- (mem-byte-at ptr index) 48)))))

(defn bencode-string-data-start [ptr end index max-string-bytes]
  (bencode-parse-decimal ptr end index 0 0 max-string-bytes))

(defn bencode-skip-string [ptr end index max-string-bytes]
  (let [data-start (bencode-string-data-start ptr end index max-string-bytes)]
    (if (< data-start 0)
      -1
      (let [length (bencode-decimal-value ptr (- data-start 1) index 0)
            next (+ data-start length)]
        (if (<= next end) next -1)))))

(defn bencode-skip-integer-digits [ptr end index digits]
  (if (>= index end)
    -1
    (let [b (mem-byte-at ptr index)]
      (if (= b 101)
        (if (> digits 0) (+ index 1) -1)
        (if (= (bencode-digit? b) 1)
          (bencode-skip-integer-digits ptr end (+ index 1) (+ digits 1))
          -1)))))

(defn bencode-skip-integer [ptr end index]
  (if (>= (+ index 2) end)
    -1
    (let [first (mem-byte-at ptr (+ index 1))]
      (if (= first 45)
        (if (and (< (+ index 2) end)
                 (not (= (mem-byte-at ptr (+ index 2)) 48)))
          (bencode-skip-integer-digits ptr end (+ index 2) 0)
          -1)
        (if (and (= first 48)
                 (not (= (mem-byte-at ptr (+ index 2)) 101)))
          -1
          (bencode-skip-integer-digits ptr end (+ index 1) 0))))))

(defn bencode-skip-list [ptr end index fuel max-string-bytes]
  (if (or (<= fuel 0) (>= index end))
    -1
    (if (= (mem-byte-at ptr index) 101)
      (+ index 1)
      (let [next (bencode-skip-value ptr end index (- fuel 1) max-string-bytes)]
        (if (< next 0)
          -1
          (bencode-skip-list ptr end next (- fuel 1) max-string-bytes))))))

(defn bencode-skip-dict [ptr end index fuel max-string-bytes]
  (if (or (<= fuel 0) (>= index end))
    -1
    (if (= (mem-byte-at ptr index) 101)
      (+ index 1)
      (let [value-start (bencode-skip-string ptr end index max-string-bytes)]
        (if (< value-start 0)
          -1
          (let [next (bencode-skip-value ptr end value-start (- fuel 1)
                                         max-string-bytes)]
            (if (< next 0)
              -1
              (bencode-skip-dict ptr end next (- fuel 1)
                                 max-string-bytes))))))))

(defn bencode-skip-value [ptr end index fuel max-string-bytes]
  (if (or (<= fuel 0) (>= index end))
    -1
    (let [tag (mem-byte-at ptr index)]
      (if (= tag 105)
        (bencode-skip-integer ptr end index)
        (if (= tag 108)
          (bencode-skip-list ptr end (+ index 1) (- fuel 1) max-string-bytes)
          (if (= tag 100)
            (bencode-skip-dict ptr end (+ index 1) (- fuel 1) max-string-bytes)
            (if (= (bencode-digit? tag) 1)
              (bencode-skip-string ptr end index max-string-bytes)
              -1)))))))

(defn bencode-valid? [ptr length fuel max-string-bytes]
  (if (or (<= length 0) (<= fuel 0) (<= max-string-bytes 0))
    0
    (if (= (bencode-skip-value ptr length 0 fuel max-string-bytes) length) 1 0)))
