;; Apply metadata from one verified held archive to a caller-owned plan.
;; No archive contents are written and no image is executed.
(ns fune.rootfs-snapshot-plan
  (:export [verify-layer-plan-hold])
  (:capabilities [:fs/app-data])
  (:require [fune.snapshot-archive :as archive] [fune.snapshot :as snapshot]
            [fune.image-manifest :as manifest] [fune.rootfs-plan :as plan]))

;; On success, the verified source snapshot remains held for consumption;
;; caller must close it. On planner refusal, close it and discard the entire
;; plan: preceding entries may already have been incorporated. Caller must
;; process layers in manifest order, once each, under the same admission scope.
;; The cursor begins at zero and follows only returned offsets. The archive
;; verifier has already validated every header and the zero terminator in the
;; same sealed snapshot; no cursor is accepted from an external caller.
(defn verify-layer-plan-hold [state :vector-i64 path :string m :vector-i64 expected :string index :i64 layer :i64] :string
  (let [opened (archive/verify-archive-and-hold path m expected index)]
    (if (not (= opened "ok")) opened
      (let [size (manifest/layer-size m expected index)
            result (loop [offset 0]
              (let [entry (archive/snapshot-entry path offset size)]
                (if (= (vector-count entry) 1)
                  (if (archive/snapshot-terminator? path offset size) "ok" "fune/snapshot-cursor")
                  (if (= (plan/rootfs-plan-add state layer entry) 0)
                    (recur (vector-at entry 0)) "fune/rootfs-plan"))))]
        (if (= result "ok") "ok"
          (if (snapshot/close-snapshot path) result "fune/snapshot-close"))))))
