;; OCI image manifest envelope and referenced-byte verification (JUN-776).
;; This is not a config policy, unpacker, image admission or execution grant.
;; `ok` applies only to the operation named by the called function.
(ns fune.image-manifest
  (:export [manifest-problem config-bytes-problem layer-bytes-problem layer-segments-problem])
  (:require [jcs.reader :as json] [sha2.core :as sha]))

(defn- fune-ws? [c :i64] :bool
  (or (= c 32) (= c 9) (= c 10) (= c 13)))

(defn- fune-start [b :vector-i64] :i64
  (loop [i 0]
    (if (and (< i (vector-count b)) (fune-ws? (vector-at b i)))
      (recur (+ i 1)) i)))

(defn- fune-octets? [b :vector-i64] :bool
  (loop [i 0]
    (if (= i (vector-count b)) true
      (let [v (vector-at b i)]
        (if (and (>= v 0) (<= v 255)) (recur (+ i 1)) false)))))

(defn- fune-str= [b :vector-i64 i :i64 s :string] :bool
  (if (= (json/json-kind b i) 3) (= (json/json-string b i) s) false))

(defn- fune-skip [b :vector-i64 i :i64] :i64
  (loop [j i]
    (if (and (< j (vector-count b)) (fune-ws? (vector-at b j))) (recur (+ j 1)) j)))

;; Called only after strict whole-document validation. OCI annotations are
;; uninterpreted metadata, but still must be bounded string-to-string maps.
(defn- fune-annotations-ok? [b :vector-i64 i :i64] :bool
  (if (not (= (json/json-kind b i) 1)) false
    (if (> (json/json-count b i) 128) false
      (loop [j (fune-skip b (+ i 1))]
        (if (= (vector-at b j) 125) true
          (let [end-key (json/json-end b j)
                colon (fune-skip b end-key)
                value (fune-skip b (+ colon 1))]
            (if (or (not (= (json/json-kind b value) 3))
                    (> (vector-count (json/json-string-bytes b value)) 4096)) false
              (let [after (fune-skip b (json/json-end b value))]
                (if (= (vector-at b after) 44) (recur (fune-skip b (+ after 1))) true)))))))))

(defn- fune-digest? [s :string] :bool
  (let [b (vector-i64-from-bytes (string-to-utf8 s))]
    (if (not (= (vector-count b) 71)) false
      (if (not (and (= (vector-at b 0) 115) (= (vector-at b 1) 104)
                    (= (vector-at b 2) 97) (= (vector-at b 3) 50)
                    (= (vector-at b 4) 53) (= (vector-at b 5) 54)
                    (= (vector-at b 6) 58))) false
        (loop [i 7]
          (if (= i 71) true
            (let [c (vector-at b i)]
              (if (or (and (>= c 48) (<= c 57)) (and (>= c 97) (<= c 102)))
                (recur (+ i 1)) false))))))))

;; Admit the three fields checked here and optional inert annotations.
(defn- fune-descriptor-problem [b :vector-i64 i :i64 media :string max-size :i64] :string
  (if (not (= (json/json-kind b i) 1)) "fune/descriptor-type"
    (let [m (json/json-member b i "mediaType")
          d (json/json-member b i "digest")
          s (json/json-member b i "size")
          a (json/json-member b i "annotations")]
      (cond (not (= (json/json-count b i) (if (< a 0) 3 4))) "fune/descriptor-fields"
            (and (>= a 0) (not (fune-annotations-ok? b a))) "fune/descriptor-annotations"
            (not (fune-str= b m media)) "fune/descriptor-media-type"
            (not (= (json/json-kind b d) 3)) "fune/descriptor-digest"
            (not (fune-digest? (json/json-string b d))) "fune/descriptor-digest"
            (not (= (json/json-kind b s) 4)) "fune/descriptor-size"
            (not (json/json-int-ok? b s)) "fune/descriptor-size"
            (or (< (json/json-int b s) 0) (> (json/json-int b s) max-size)) "fune/descriptor-size"
            :else "ok"))))

(defn- fune-layers-problem [b :vector-i64 arr :i64] :string
  (if (not (= (json/json-kind b arr) 2)) "fune/layers-type"
    (let [n (json/json-count b arr)]
      (if (or (< n 1) (> n 32)) "fune/layers-count"
        (loop [i 0]
          (if (= i n) "ok"
            (let [p (fune-descriptor-problem b (json/json-element b arr i)
                      "application/vnd.oci.image.layer.v1.tar" 268435456)]
              (if (= p "ok") (recur (+ i 1)) p))))))))

(defn manifest-problem [b :vector-i64 expected :string] :string
  (cond (> (vector-count b) 1048576) "fune/manifest-size"
        (not (fune-octets? b)) "fune/non-octet"
        (not (fune-digest? expected)) "fune/expected-digest"
        (not (= (string-concat "sha256:" (sha/sha256-hex b)) expected)) "fune/manifest-digest"
        (not (json/json-valid? b)) "fune/manifest-json"
        :else (let [root (fune-start b)]
          (if (not (= (json/json-kind b root) 1)) "fune/manifest-type"
            (let [v (json/json-member b root "schemaVersion")
                  m (json/json-member b root "mediaType")
                  c (json/json-member b root "config")
                  l (json/json-member b root "layers")
                  a (json/json-member b root "annotations")]
              (cond (not (= (json/json-count b root) (if (< a 0) 4 5))) "fune/manifest-fields"
                    (and (>= a 0) (not (fune-annotations-ok? b a))) "fune/manifest-annotations"
                    (not (= (json/json-kind b v) 4)) "fune/schema-version"
                    (not (json/json-int-ok? b v)) "fune/schema-version"
                    (not (= (json/json-int b v) 2)) "fune/schema-version"
                    (not (fune-str= b m "application/vnd.oci.image.manifest.v1+json")) "fune/manifest-media-type"
                    :else (let [p (fune-descriptor-problem b c "application/vnd.oci.image.config.v1+json" 1048576)]
                            (if (= p "ok") (fune-layers-problem b l) p))))))))

;; Revalidates the manifest before taking descriptor facts from its bytes.
(defn- fune-blob-problem [manifest :vector-i64 blob :vector-i64 descriptor :i64] :string
  (let [size (json/json-member manifest descriptor "size")
        digest (json/json-member manifest descriptor "digest")]
    (cond (not (= (vector-count blob) (json/json-int manifest size))) "fune/blob-size"
          (not (fune-octets? blob)) "fune/non-octet"
          (not (= (string-concat "sha256:" (sha/sha256-hex blob)) (json/json-string manifest digest))) "fune/blob-digest"
          :else "ok")))

(defn config-bytes-problem [manifest :vector-i64 expected :string blob :vector-i64] :string
  (let [p (manifest-problem manifest expected)]
    (if (not (= p "ok")) p
      (let [root (fune-start manifest)]
        (fune-blob-problem manifest blob (json/json-member manifest root "config"))))))

(defn layer-bytes-problem [manifest :vector-i64 expected :string index :i64 blob :vector-i64] :string
  (let [p (manifest-problem manifest expected)]
    (if (not (= p "ok")) p
      (let [root (fune-start manifest) layers (json/json-member manifest root "layers")]
        (if (or (< index 0) (>= index (json/json-count manifest layers))) "fune/layer-index"
          (fune-blob-problem manifest blob (json/json-element manifest layers index)))))))

;; Segments are already in memory and contain only blob bytes, without any
;; transport framing. This avoids flattening but is not a streaming provider.
(defn- fune-segments-size [chunks [:list :bytes]] :i64
  (loop [i 0 total 0]
    (if (= i (vector-count chunks)) total
      (let [n (bytes-count (typed-list-nth [:list :bytes] chunks i))]
        (if (> n (- 268435456 total)) -1 (recur (+ i 1) (+ total n)))))))

(defn layer-segments-problem [manifest :vector-i64 expected :string index :i64 chunks [:list :bytes]] :string
  (let [p (manifest-problem manifest expected)]
    (if (not (= p "ok")) p
      (let [root (fune-start manifest) layers (json/json-member manifest root "layers")]
        (if (or (< index 0) (>= index (json/json-count manifest layers))) "fune/layer-index"
          (let [d (json/json-element manifest layers index)
                size (json/json-member manifest d "size") digest (json/json-member manifest d "digest")
                total (fune-segments-size chunks)]
            (cond (not (= total (json/json-int manifest size))) "fune/blob-size"
                  (not (= (string-concat "sha256:" (sha/sha256-segments-hex chunks 0)) (json/json-string manifest digest))) "fune/blob-digest"
                  :else "ok")))))))
