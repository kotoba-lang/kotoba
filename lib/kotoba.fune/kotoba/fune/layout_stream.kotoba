;; Diagnostic OCI layout-to-worker stream. No production supervisor or launch.
(ns fune.layout-stream
  (:export [emit-layout-hex emit-runnable-layout-hex])
  (:capabilities [:fs/app-data :io/write])
  (:require [fune.layout-check :as layout] [fune.image-manifest :as manifest]
            [fune.rootfs-plan :as plan] [fune.rootfs-stream :as stream]
            [fune.process-rootfs :as process]))

(defn- ls-blob [root :string digest :string] :string
  (str root "/blobs/sha256/" (string-substring digest 7 71)))

;; Validate bounded layout metadata, config and every layer without emitting
;; bytes. Read the manifest again through a bounded snapshot and reverify its
;; digest; each layer is verified again and streamed from its held snapshot.
;; On any failure the supervisor must kill/discard the worker, as earlier
;; commands may already have been sent during the second pass. Success is not
;; proof of worker acknowledgment, a persisted tree or launch authorization.
(defn- ls-emit [root :string expected :string runnable :bool] :string
  (let [preflight (layout/verify-layout-plan root expected)]
    (if (not (= preflight "ok")) preflight
      (let [m (layout/read-verified-layout-manifest root expected)
            p (manifest/manifest-problem m expected)]
        (if (not (= p "ok")) p
          (let [cfg (if runnable (layout/read-verified-layout-config root expected m) (vector-alloc 0))
                n (manifest/layer-count m expected) state (plan/rootfs-plan-new)]
            (if (and runnable (= (vector-count cfg) 0)) "fune/config-invalid"
              (let [started (stream/rootfs-stream-start)]
                (loop [i 0]
              (if (= i n)
                (let [check (if runnable (process/process-rootfs-problem state m expected cfg) "ok")]
                  (if (not (= check "ok")) check
                    (let [spec (if runnable (process/process-launch-spec state m expected cfg) (vector-alloc 0))]
                      (if (and runnable (< (vector-count spec) 10)) "fune/process-spec"
                        (let [finalized (stream/rootfs-stream-finalize state)
                              commands (+ (plan/rootfs-plan-commands state) finalized)
                              result (if (< finalized 0) -1
                                       (if runnable (stream/rootfs-stream-runnable-finish commands spec)
                                         (stream/rootfs-stream-finish commands)))]
                          (if (= result 0) "ok" "fune/stream-finish"))))))
                (let [digest (manifest/layer-digest m expected i)
                      result (stream/emit-layer-hex state (ls-blob root digest) m expected i)]
                  (if (= result "ok") (recur (+ i 1)) result))))))))))))

;; Extraction-only profile preserves support for data-only images.
(defn emit-layout-hex [root :string expected :string] :string (ls-emit root expected false))
;; The runnable profile binds the config check to the same final plan that
;; emitted worker commands. Later execution still needs its own isolation,
;; identity, UID/GID, executable/interpreter and immutable handoff checks.
(defn emit-runnable-layout-hex [root :string expected :string] :string (ls-emit root expected true))
