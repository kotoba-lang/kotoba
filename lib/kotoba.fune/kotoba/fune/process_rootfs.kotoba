;; Bounded process/rootfs consistency check; this does not authorize execution.
;; The caller must supply the final plan derived from every verified layer and
;; the exact config bytes bound to the manifest. The plan is mutable and trusted.
(ns fune.process-rootfs
  (:export [process-rootfs-problem process-launch-spec])
  (:require [fune.image-config :as config] [fune.rootfs-plan :as plan] [jcs.reader :as json]))

;; Match the planner's relative ASCII path subset. No normalization or links.
(defn- pr-path-ok? [p :vector-i64 root-ok :bool] :bool
  (let [n (vector-count p)]
    (if (or (= n 0) (> n 256) (not (= (vector-at p 0) 47))) false
      (if (= n 1) root-ok
        (loop [i 1 start 1]
          (if (or (= i n) (= (vector-at p i) 47))
            (let [len (- i start)]
              (cond (= len 0) false
                    (and (= len 1) (= (vector-at p start) 46)) false
                    (and (= len 2) (= (vector-at p start) 46) (= (vector-at p (+ start 1)) 46)) false
                    (= i n) true :else (recur (+ i 1) (+ i 1))))
            (let [c (vector-at p i)]
              (if (or (< c 32) (> c 126)) false (recur (+ i 1) start)))))))))

;; Returns [kind mode path...] from the final plan, or [-1] if absent.
(defn- pr-find [state :vector-i64 p :vector-i64] :vector-i64
  (let [n (vector-count p) count (plan/rootfs-plan-count state)]
    (loop [i 0]
      (if (>= i count) [-1]
        (let [e (plan/rootfs-plan-entry state i)]
          (if (= (vector-count e) (+ n 1))
            (let [matches (loop [j 1]
                            (if (= j n) true
                              (if (= (vector-at p j) (vector-at e (+ j 1))) (recur (+ j 1)) false)))]
              (if matches e (recur (+ i 1))))
            (recur (+ i 1))))))))

(defn- pr-start [b :vector-i64] :i64
  (loop [i 0]
    (let [c (vector-at b i)]
      (if (or (= c 32) (= c 9) (= c 10) (= c 13)) (recur (+ i 1)) i))))

(defn- pr-cwd [cfg :vector-i64 proc :i64] :vector-i64
  (let [index (json/json-member cfg proc "WorkingDir")]
    (if (< index 0) [47]
      (let [v (json/json-string-bytes cfg index)] (if (= (vector-count v) 0) [47] v)))))

;; Verifies config digest and policy before reading executable and cwd bytes.
;; The root working directory is implicit. A non-root cwd must be an explicit
;; directory; the executable must be a regular file with at least one execute bit.
;; UID/GID access, interpreters, mount flags, bytes at execution time and all
;; isolation/launch decisions remain the future runtime's responsibility.
(defn process-rootfs-problem [state :vector-i64 manifest :vector-i64 expected :string cfg :vector-i64] :string
  (let [problem (config/config-policy-problem manifest expected cfg)]
    (if (not (= problem "ok")) problem
      (let [root (pr-start cfg) proc (json/json-member cfg root "config")
            ep (json/json-member cfg proc "Entrypoint") cmd (json/json-member cfg proc "Cmd")
            chosen (if (and (>= ep 0) (> (json/json-count cfg ep) 0)) ep cmd)
            executable (json/json-string-bytes cfg (json/json-element cfg chosen 0))
            cwd (pr-cwd cfg proc)]
        (cond (not (pr-path-ok? executable false)) "fune/process-executable-path"
              (not (pr-path-ok? cwd true)) "fune/process-working-dir-path"
              :else (let [file (pr-find state executable)]
                (cond (or (= (vector-count file) 1) (not (= (vector-at file 0) 0))) "fune/process-executable-missing"
                      (= (bit-and (vector-at file 1) 73) 0) "fune/process-executable-mode"
                      (= (vector-count cwd) 1) "ok"
                      :else (let [dir (pr-find state cwd)]
                        (if (and (> (vector-count dir) 1) (= (vector-at dir 0) 1)) "ok" "fune/process-working-dir-missing")))))))))

(defn- ps-count [cfg :vector-i64 index :i64] :i64
  (if (< index 0) 0 (json/json-count cfg index)))
(defn- ps-array-size [cfg :vector-i64 index :i64] :i64
  (let [n (ps-count cfg index)]
    (loop [i 0 total 0]
      (if (= i n) total
        (recur (+ i 1) (+ total 4 (vector-count (json/json-string-bytes cfg (json/json-element cfg index i)))))))))
(defn- ps-copy [out :vector-i64 offset :i64 bytes :vector-i64] :i64
  (let [n (vector-count bytes)]
    (loop [i 0]
      (if (= i n) (+ offset n)
        (let [a (vector-assoc! out (+ offset i) (vector-at bytes i))] (recur (+ i 1)))))))
(defn- ps-u16 [out :vector-i64 offset :i64 n :i64] :i64
  (let [a (vector-assoc! out offset (quot n 256)) b (vector-assoc! a (+ offset 1) (rem n 256))] (+ offset 2)))
(defn- ps-u32 [out :vector-i64 offset :i64 n :i64] :i64
  (let [a (vector-assoc! out offset (rem (quot n 16777216) 256))
        b (vector-assoc! a (+ offset 1) (rem (quot n 65536) 256))
        c (vector-assoc! b (+ offset 2) (rem (quot n 256) 256))
        d (vector-assoc! c (+ offset 3) (rem n 256))] (+ offset 4)))
(defn- ps-array-write [cfg :vector-i64 index :i64 out :vector-i64 offset :i64] :i64
  (let [n (ps-count cfg index)]
    (loop [i 0 pos offset]
      (if (= i n) pos
        (let [v (json/json-string-bytes cfg (json/json-element cfg index i))
              next (ps-u32 out pos (vector-count v)) end (ps-copy out next v)]
          (recur (+ i 1) end))))))

;; Return [F P S 1 argc:u16 envc:u16 cwdlen:u16 cwd (len:u32 bytes)*].
;; argv is Entrypoint ++ Cmd, with an empty/missing Entrypoint using Cmd.
;; Both counts and bytes were bounded and validated by config-policy-problem.
;; [-1] is refusal. This mutable vector is not an execution grant; a future
;; consumer must authenticate and revalidate its own handoff and isolation.
(defn process-launch-spec [state :vector-i64 manifest :vector-i64 expected :string cfg :vector-i64] :vector-i64
  (if (not (= (process-rootfs-problem state manifest expected cfg) "ok")) [-1]
    (let [proc (json/json-member cfg (pr-start cfg) "config") ep (json/json-member cfg proc "Entrypoint")
          cmd (json/json-member cfg proc "Cmd") env (json/json-member cfg proc "Env") cwd (pr-cwd cfg proc)
          argc (+ (ps-count cfg ep) (ps-count cfg cmd)) envc (ps-count cfg env)
          total (+ 10 (vector-count cwd) (ps-array-size cfg ep) (ps-array-size cfg cmd) (ps-array-size cfg env))
          payload (- total (+ 10 (* 4 (+ argc envc))))]
      (if (or (> argc 256) (> envc 128) (> payload 65536) (> total 67500)) [-1]
        (let [v (vector-alloc total) a (vector-assoc! v 0 70) b (vector-assoc! a 1 80)
              c (vector-assoc! b 2 83) d (vector-assoc! c 3 1)
              p1 (ps-u16 d 4 argc) p2 (ps-u16 d p1 envc) p3 (ps-u16 d p2 (vector-count cwd))
              p4 (ps-copy d p3 cwd) p5 (ps-array-write cfg ep d p4)
              p6 (ps-array-write cfg cmd d p5) p7 (ps-array-write cfg env d p6)]
          (if (= p7 total) d [-1]))))))
