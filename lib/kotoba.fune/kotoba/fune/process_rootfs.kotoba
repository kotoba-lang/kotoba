;; Bounded process/rootfs consistency check; this does not authorize execution.
;; The caller must supply the final plan derived from every verified layer and
;; the exact config bytes bound to the manifest. The plan is mutable and trusted.
(ns fune.process-rootfs
  (:export [process-rootfs-problem])
  (:require [fune.image-config :as config] [fune.rootfs-plan :as plan] [jcs.reader :as json]))

;; Match the planner's relative ASCII path subset. No normalization or links.
(defn- pr-path-ok? [p :vector-i64 root-ok :bool] :bool
  (let [n (vector-count p)]
    (if (or (= n 0) (> n 256) (not (= (vector-at p 0) 47))) false
      (if (= n 1) root-ok
        (loop [i 1 start 1]
          (if (or (= i n) (= (vector-at p i) 47))
            (let [len (- i start)]
              (cond (= len 0) false
                    (and (= len 1) (= (vector-at p start) 46)) false
                    (and (= len 2) (= (vector-at p start) 46) (= (vector-at p (+ start 1)) 46)) false
                    (= i n) true :else (recur (+ i 1) (+ i 1))))
            (let [c (vector-at p i)]
              (if (or (< c 32) (> c 126)) false (recur (+ i 1) start)))))))))

;; Returns [kind mode path...] from the final plan, or [-1] if absent.
(defn- pr-find [state :vector-i64 p :vector-i64] :vector-i64
  (let [n (vector-count p) count (plan/rootfs-plan-count state)]
    (loop [i 0]
      (if (>= i count) [-1]
        (let [e (plan/rootfs-plan-entry state i)]
          (if (= (vector-count e) (+ n 1))
            (let [matches (loop [j 1]
                            (if (= j n) true
                              (if (= (vector-at p j) (vector-at e (+ j 1))) (recur (+ j 1)) false)))]
              (if matches e (recur (+ i 1))))
            (recur (+ i 1))))))))

(defn- pr-start [b :vector-i64] :i64
  (loop [i 0]
    (let [c (vector-at b i)]
      (if (or (= c 32) (= c 9) (= c 10) (= c 13)) (recur (+ i 1)) i))))

;; Verifies config digest and policy before reading executable and cwd bytes.
;; The root working directory is implicit. A non-root cwd must be an explicit
;; directory; the executable must be a regular file with at least one execute bit.
;; UID/GID access, interpreters, mount flags, bytes at execution time and all
;; isolation/launch decisions remain the future runtime's responsibility.
(defn process-rootfs-problem [state :vector-i64 manifest :vector-i64 expected :string cfg :vector-i64] :string
  (let [problem (config/config-policy-problem manifest expected cfg)]
    (if (not (= problem "ok")) problem
      (let [root (pr-start cfg) proc (json/json-member cfg root "config")
            ep (json/json-member cfg proc "Entrypoint") cmd (json/json-member cfg proc "Cmd")
            chosen (if (and (>= ep 0) (> (json/json-count cfg ep) 0)) ep cmd)
            executable (json/json-string-bytes cfg (json/json-element cfg chosen 0))
            cwd-index (json/json-member cfg proc "WorkingDir")
            cwd (if (< cwd-index 0) [47] (let [v (json/json-string-bytes cfg cwd-index)] (if (= (vector-count v) 0) [47] v)))]
        (cond (not (pr-path-ok? executable false)) "fune/process-executable-path"
              (not (pr-path-ok? cwd true)) "fune/process-working-dir-path"
              :else (let [file (pr-find state executable)]
                (cond (or (= (vector-count file) 1) (not (= (vector-at file 0) 0))) "fune/process-executable-missing"
                      (= (bit-and (vector-at file 1) 73) 0) "fune/process-executable-mode"
                      (= (vector-count cwd) 1) "ok"
                      :else (let [dir (pr-find state cwd)]
                        (if (and (> (vector-count dir) 1) (= (vector-at dir 0) 1)) "ok" "fune/process-working-dir-missing")))))))))
