;; Bounded, in-memory rootfs entry planner candidate (JUN-776).
;; This performs no filesystem writes and does not authorize execution.
(ns fune.rootfs-plan (:export [rootfs-plan-new rootfs-plan-add rootfs-plan-count rootfs-plan-bytes rootfs-plan-existing-kind]))

;; Fixed rows: length, kind, size, last-layer, then at most 255 ASCII bytes.
;; 128 explicit entries, 64 MiB of regular-file payload. All arithmetic below
;; is bounded before mutation. State is trusted and caller-owned; discard it after refusal.
(defn rootfs-plan-new [] :vector-i64
  (let [v (vector-alloc (+ 4 (* 128 259)))] (vector-assoc! v 2 -1)))
(defn rootfs-plan-count [s :vector-i64] :i64 (vector-at s 0))
(defn rootfs-plan-bytes [s :vector-i64] :i64 (vector-at s 1))
(defn- rp-base [i :i64] :i64 (+ 4 (* i 259)))
(defn- rp-path-valid? [e :vector-i64 n :i64] :bool
  (if (or (<= n 0) (> n 255)) false
    (loop [i 0 start 0]
      (if (or (= i n) (= (vector-at e (+ 5 i)) 47))
        (let [len (- i start)]
          (cond (= len 0) false
                (and (= len 1) (= (vector-at e (+ 5 start)) 46)) false
                (and (= len 2) (= (vector-at e (+ 5 start)) 46) (= (vector-at e (+ 6 start)) 46)) false
                (and (>= len 4) (= (vector-at e (+ 5 start)) 46) (= (vector-at e (+ 6 start)) 119)
                     (= (vector-at e (+ 7 start)) 104) (= (vector-at e (+ 8 start)) 46)) false
                (= i n) true
                :else (recur (+ i 1) (+ i 1))))
        (let [c (vector-at e (+ 5 i))]
          (if (or (< c 32) (> c 126)) false (recur (+ i 1) start)))))))
(defn- rp-match? [s :vector-i64 row :i64 e :vector-i64 len :i64] :bool
  (let [b (rp-base row)]
    (and (= (vector-at s b) len)
      (loop [i 0]
        (if (= i len) true
          (if (= (vector-at s (+ (+ b 4) i)) (vector-at e (+ 5 i))) (recur (+ i 1)) false))))))
(defn- rp-find [s :vector-i64 e :vector-i64 len :i64] :i64
  (let [n (vector-at s 0)]
    (loop [i 0] (if (= i n) -1 (if (rp-match? s i e len) i (recur (+ i 1)))))))
;; Query before adding a verified cursor entry: -1 absent, 0 file, 1 directory.
;; This is a diagnostic view of trusted caller-owned state, not authorization.
(defn rootfs-plan-existing-kind [s :vector-i64 e :vector-i64] :i64
  (let [n (vector-count e)]
    (if (or (not (= (vector-count s) (+ 4 (* 128 259)))) (< n 6)) -1
      (let [row (rp-find s e (- n 5))]
        (if (< row 0) -1 (vector-at s (+ (rp-base row) 1)))))))
(defn- rp-parents? [s :vector-i64 e :vector-i64 len :i64] :bool
  (loop [i 0]
    (if (= i len) true
      (if (= (vector-at e (+ i 5)) 47)
        (let [row (rp-find s e i)]
          (if (or (< row 0) (not (= (vector-at s (+ (rp-base row) 1)) 1))) false (recur (+ i 1))))
        (recur (+ i 1))))))

;; Entry is snapshot-entry's [next data kind size mode path-byte...]. Returns
;; 0 on success, negative on refusal; refusal leaves the entire state unchanged.
;; Caller must supply entries from the held verified archive, in layer order.
;; Directory-to-directory and file-to-file replacement across layers are
;; supported. Type replacement, duplicate same-layer entries, implicit parents,
;; whiteouts, links and deletion are deliberately unsupported.
(defn rootfs-plan-add [s :vector-i64 layer :i64 e :vector-i64] :i64
  (if (not (= (vector-count s) (+ 4 (* 128 259)))) -1
    (let [en (vector-count e) count (vector-at s 0) total (vector-at s 1)]
      (cond (< en 6) -2
          (or (< layer 0) (< layer (vector-at s 2))) -3
          :else (let [len (- en 5) kind (vector-at e 2) size (vector-at e 3) mode (vector-at e 4)]
            (cond (not (rp-path-valid? e len)) -4
                  (or (not (or (= kind 0) (= kind 1))) (< size 0) (> size 67108864)
                      (and (= kind 1) (not (= size 0))) (< mode 0) (> mode 511)) -5
                  (not (rp-parents? s e len)) -6
                  :else (let [row (rp-find s e len) exists (>= row 0)
                              base (if exists (rp-base row) (rp-base count))
                              old (if exists (vector-at s (+ base 2)) 0)]
                    (cond (and (not exists) (>= count 128)) -7
                          (and exists (= (vector-at s (+ base 3)) layer)) -8
                          (and exists (not (= (vector-at s (+ base 1)) kind))) -9
                          (> (+ (- total old) size) 67108864) -10
                          :else (let [a (vector-assoc! s base len)
                                      b (vector-assoc! a (+ base 1) kind)
                                      c (vector-assoc! b (+ base 2) size)
                                      d (vector-assoc! c (+ base 3) layer)
                                      v (loop [i 0 out d]
                                          (if (= i len) out (recur (+ i 1) (vector-assoc! out (+ (+ base 4) i) (vector-at e (+ 5 i))))))
                                      f (vector-assoc! v 0 (if exists count (+ count 1)))
                                      g (vector-assoc! f 1 (+ (- total old) size))
                                      h (vector-assoc! g 2 layer)] 0)))))))))
