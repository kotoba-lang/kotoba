;; Read-only config-to-final-plan consistency check; not a launch authorization.
(ns fune.layout-process
  (:export [verify-layout-process])
  (:capabilities [:fs/app-data])
  (:require [fune.layout-check :as layout] [fune.image-manifest :as manifest]
            [fune.rootfs-plan :as plan] [fune.rootfs-snapshot-plan :as rootfs]
            [fune.snapshot :as snapshot] [fune.process-rootfs :as process]))

(defn- lp-blob [root :string digest :string] :string
  (str root "/blobs/sha256/" (string-substring digest 7 71)))

;; Preflight layout identity, then re-read digest-bound metadata and re-plan
;; every verified layer. No state returned by this function survives it.
;; Every later consumer must independently bind its own state to the snapshots;
;; "ok" does not authorize execution and does not guarantee UID access.
(defn verify-layout-process [root :string expected :string] :string
  (let [preflight (layout/verify-layout-plan root expected)]
    (if (not (= preflight "ok")) preflight
      (let [m (layout/read-verified-layout-manifest root expected)
            p (manifest/manifest-problem m expected)]
        (if (not (= p "ok")) p
          (let [cfg (layout/read-verified-layout-config root expected m)
                n (manifest/layer-count m expected) state (plan/rootfs-plan-new)]
            (if (= (vector-count cfg) 0) "fune/config-invalid"
              (loop [i 0]
                (if (= i n) (process/process-rootfs-problem state m expected cfg)
                  (let [digest (manifest/layer-digest m expected i) path (lp-blob root digest)
                        result (rootfs/verify-layer-plan-hold state path m expected i i)]
                    (if (not (= result "ok")) result
                      (if (snapshot/close-snapshot path) (recur (+ i 1)) "fune/snapshot-close"))))))))))))
