;; Test only: Linux static OS status requires KEXE_COMMAND=1 without structured report.
(ns fune.layout-snapshot-runner (:export [main]) (:require [fune.layout-check :as layout]))
(defn main [] :i64
  (let [argc (typed-cap-call :cli/args :string :string "")
        root (typed-cap-call :cli/args :string :string "0")
        digest (typed-cap-call :cli/args :string :string "1")
        result (if (= argc "2") (layout/verify-layout-snapshots root digest) "fune/usage")
        sent (typed-cap-call :io/write :string :string (string-concat result "\n"))]
    (if (= result "ok") 0 1)))
