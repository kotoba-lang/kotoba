;; Read-only native OCI layout/process checks; arguments are staged digests.
(ns fune.layout-process-gate (:export [main])
  (:capabilities [:fs/app-data :cli/args])
  (:require [fune.layout-process :as process] [fune.layout-check :as layout]))
(defn- arg [i :string] :string (typed-cap-call :cli/args :string :string i))
(defn main [] :i64
  (let [root (arg "0")]
    (cond (not (= (process/verify-layout-process (str root "/good") (arg "1")) "ok")) 1
          (not (= (process/verify-layout-process (str root "/noexec") (arg "2")) "fune/process-executable-mode")) 2
          (not (= (process/verify-layout-process (str root "/missing") (arg "3")) "fune/process-executable-missing")) 3
          (not (= (process/verify-layout-process (str root "/badcwd") (arg "4")) "fune/process-working-dir-missing")) 4
          (not (= (process/verify-layout-process (str root "/replaced") (arg "5")) "fune/process-executable-mode")) 5
          (not (= (process/verify-layout-process (str root "/corrupt") (arg "6")) "fune/blob-digest")) 6
          (not (= (layout/verify-layout-plan (str root "/noexec") (arg "2")) "ok")) 7
          :else 0)))
