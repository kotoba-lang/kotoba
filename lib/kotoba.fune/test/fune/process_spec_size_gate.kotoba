;; Native test of the normalized-cwd contribution to the 65536-byte limit.
(ns fune.process-spec-size-gate (:export [main]) (:require [fune.process-rootfs :as process] [fune.rootfs-plan :as plan]))
(defn- tb [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- fill [n :i64] :string
  (let [v (loop [i 0 a (vector-alloc n)] (if (= i n) a (recur (+ i 1) (vector-assoc! a i 120))))]
    (string-from-utf8 (bytes-from-vector-i64 v))))
(defn- entry [kind :i64 mode :i64 path :string] :vector-i64
  (let [p (tb path) n (vector-count p) a (vector-assoc! (vector-alloc (+ n 5)) 2 kind)
        b (vector-assoc! a 3 0) c (vector-assoc! b 4 mode)]
    (loop [i 0 v c] (if (= i n) v (recur (+ i 1) (vector-assoc! v (+ i 5) (vector-at p i)))))))
(defn main [] :i64
  (let [s (plan/rootfs-plan-new) a (plan/rootfs-plan-add s 0 (entry 1 493 "bin"))
        b (plan/rootfs-plan-add s 0 (entry 0 493 "bin/app"))
        c0 (tb (str "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/app\"],\"Cmd\":[\"" (fill 65527) "\"]}}"))
        m0 (tb "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:cd35f2124c3a16f2118c27a649793d13b24b3c417f068399871022af9389c636\",\"size\":65726},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}")
        v0 (process/process-launch-spec s m0 "sha256:e9daab1e84057bca18a744b3669eb5032623564a53e126ba956fc5dbcdb28dad" c0)
        c1 (tb (str "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/app\"],\"Cmd\":[\"" (fill 65528) "\"]}}"))
        m1 (tb "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:7c22c89619adbc505a61c35af89782a2f4242dd2c50cbdb39a7001bec42ca12d\",\"size\":65727},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}")
        v1 (process/process-launch-spec s m1 "sha256:9f69212a90e8a5438ab280b3e7b48f6569c6dc1d5bd656e61f8d6716906e1667" c1)
        ]
    (if (and (= a 0) (= b 0) (= (vector-count v0) 65554) (= (vector-at v0 9) 1)
             (= (vector-at v0 10) 47) (= (vector-at v0 65553) 120)
             (= (vector-count v1) 1) (= (vector-at v1 0) -1)) 0 1)))
