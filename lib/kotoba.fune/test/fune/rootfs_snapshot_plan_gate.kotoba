;; Test-only native integration of planner with the held sealed layer snapshot.
(ns fune.rootfs-snapshot-plan-gate (:export [main])
  (:require [fune.rootfs-plan :as plan] [fune.rootfs-snapshot-plan :as rp]
            [fune.snapshot-archive :as archive] [fune.snapshot :as snapshot]))
(defn- arg [i :string] :string (typed-cap-call :cli/args :string :string i))
(defn- read-manifest [path :string] :vector-i64
  (let [b (typed-cap-call :fs/app-data :string :bytes (str "\u0000FS2\u0000A" path "\u0000")) n (bytes-count b)]
    (if (< n 5) (vector-alloc 0) (vector-i64-from-bytes (bytes-slice b 5 n)))))
(defn main [] :i64
  (let [dir-path (arg "0") dir-m (read-manifest (arg "1")) dir-d (arg "2")
        file-path (arg "3") file-m (read-manifest (arg "4")) file-d (arg "5")
        duplicate-path (arg "6") duplicate-m (read-manifest (arg "7")) duplicate-d (arg "8")
        s (plan/rootfs-plan-new)
        missing (rp/verify-layer-plan-hold s file-path file-m file-d 0 0)
        dir (rp/verify-layer-plan-hold s dir-path dir-m dir-d 0 0)
        dir-end (and (not (archive/snapshot-terminator? dir-path 0 1536))
                     (archive/snapshot-terminator? dir-path 512 1536)
                     (not (archive/snapshot-terminator? dir-path 1024 1536)))
        close-dir (snapshot/close-snapshot dir-path)
        file (rp/verify-layer-plan-hold s file-path file-m file-d 0 1)
        file-end (and (not (archive/snapshot-terminator? file-path 0 2048))
                      (archive/snapshot-terminator? file-path 1024 2048))
        close-file (snapshot/close-snapshot file-path)
        bad1 (rp/verify-layer-plan-hold (plan/rootfs-plan-new) duplicate-path duplicate-m duplicate-d 0 0)
        bad2 (rp/verify-layer-plan-hold (plan/rootfs-plan-new) duplicate-path duplicate-m duplicate-d 0 0)]
    (if (and (= missing "fune/rootfs-plan") (= dir "ok") dir-end close-dir (= file "ok") file-end close-file
             (= bad1 "fune/rootfs-plan") (= bad2 "fune/rootfs-plan")
             (= (plan/rootfs-plan-count s) 2) (= (plan/rootfs-plan-bytes s) 3)) 0 1)))
