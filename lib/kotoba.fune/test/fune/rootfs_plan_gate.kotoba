;; In-process native verdicts for the pure rootfs planner candidate.
(ns fune.rootfs-plan-gate (:export [main]) (:require [fune.rootfs-plan :as plan]))
(defn- entry [kind :i64 size :i64 mode :i64 path :string] :vector-i64
  (let [p (vector-i64-from-bytes (string-to-utf8 path)) n (vector-count p)
        v (vector-alloc (+ n 5)) a (vector-assoc! v 2 kind) b (vector-assoc! a 3 size) c (vector-assoc! b 4 mode)]
    (loop [i 0 out c] (if (= i n) out (recur (+ i 1) (vector-assoc! out (+ i 5) (vector-at p i)))))))
(defn- same? [a :vector-i64 b :vector-i64] :bool
  (if (not (= (vector-count a) (vector-count b))) false
    (loop [i 0] (if (= i (vector-count a)) true
      (if (= (vector-at a i) (vector-at b i)) (recur (+ i 1)) false)))))
(defn- copy [a :vector-i64] :vector-i64
  (let [n (vector-count a)] (loop [i 0 out (vector-alloc n)]
    (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at a i)))))))
(defn- refuse-unchanged? [s :vector-i64 layer :i64 e :vector-i64 code :i64] :bool
  (let [before (copy s) result (plan/rootfs-plan-add s layer e)]
    (and (= result code) (same? s before))))
(defn- numbered [i :i64] :string
  (string-from-utf8 (bytes-from-vector-i64
    [112 (+ 48 (quot i 100)) (+ 48 (rem (quot i 10) 10)) (+ 48 (rem i 10))])))
(defn- entry-limit? [] :bool
  (let [s (plan/rootfs-plan-new)
        filled (loop [i 0]
          (if (= i 128) true
            (if (= (plan/rootfs-plan-add s 0 (entry 0 0 420 (numbered i))) 0)
              (recur (+ i 1)) false)))]
    (and filled (= (plan/rootfs-plan-count s) 128)
         (refuse-unchanged? s 0 (entry 0 0 420 "extra") -7))))
(defn- command-limit? [] :bool
  (let [s (plan/rootfs-plan-new) e (entry 0 0 420 "same")
        filled (loop [i 0]
          (if (= i 512) true
            (if (= (plan/rootfs-plan-add s i e) 0) (recur (+ i 1)) false)))]
    (and filled (= (plan/rootfs-plan-commands s) 512)
         (refuse-unchanged? s 512 e -11))))
(defn- repeated-directory? [] :bool
  (let [s (plan/rootfs-plan-new) d (entry 1 0 493 "dir")]
    (and (= (plan/rootfs-plan-add s 0 d) 0) (= (plan/rootfs-plan-add s 1 d) 0)
         (= (plan/rootfs-plan-commands s) 1))))
(defn main [] :i64
  (let [s (plan/rootfs-plan-new)
        missing (refuse-unchanged? s 0 (entry 0 1 420 "bin/a") -6)
        dir (= (plan/rootfs-plan-add s 0 (entry 1 0 493 "bin")) 0)
        file (= (plan/rootfs-plan-add s 0 (entry 0 7 420 "bin/a")) 0)
        duplicate (refuse-unchanged? s 0 (entry 0 3 420 "bin/a") -8)
        traversal (refuse-unchanged? s 1 (entry 0 0 420 "bin/../a") -4)
        whiteout (refuse-unchanged? s 1 (entry 0 0 420 "bin/.wh.a") -4)
        special (refuse-unchanged? s 1 (entry 0 0 2048 "bin/b") -5)
        typed (refuse-unchanged? s 1 (entry 0 0 420 "bin") -9)
        replace (= (plan/rootfs-plan-add s 1 (entry 0 10 420 "bin/a")) 0)
        old (refuse-unchanged? s 0 (entry 0 0 420 "x") -3)
        full (= (plan/rootfs-plan-add s 1 (entry 0 67108854 420 "bin/b")) 0)
        quota (refuse-unchanged? s 2 (entry 0 1 420 "bin/c") -10)
        stats (and (= (plan/rootfs-plan-count s) 3) (= (plan/rootfs-plan-bytes s) 67108864))
        malformed (= (plan/rootfs-plan-add (vector-alloc 0) 0 (entry 0 0 420 "x")) -1)
        limit (entry-limit?) commands (command-limit?) repeated (repeated-directory?)]
    (if (and missing dir file duplicate traversal whiteout special typed replace old full quota stats malformed limit commands repeated) 0 1)))
