;; Golden byte vectors are independently encoded in Python; native verdicts.
(ns fune.process-spec-gate (:export [main]) (:require [fune.process-rootfs :as process] [fune.rootfs-plan :as plan]))
(defn- t-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- nibble [c :i64] :i64 (if (<= c 57) (- c 48) (+ 10 (- c 97))))
(defn- t-hex [s :string] :vector-i64
  (let [v (t-bytes s) n (quot (vector-count v) 2)]
    (loop [i 0 out (vector-alloc n)]
      (if (= i n) out (recur (+ i 1) (vector-assoc! out i (+ (* 16 (nibble (vector-at v (* i 2)))) (nibble (vector-at v (+ (* i 2) 1))))))))))
(defn- same? [a :vector-i64 b :vector-i64] :bool
  (if (not (= (vector-count a) (vector-count b))) false
    (loop [i 0] (if (= i (vector-count a)) true (if (= (vector-at a i) (vector-at b i)) (recur (+ i 1)) false)))))
(defn- entry [kind :i64 mode :i64 path :string] :vector-i64
  (let [p (t-bytes path) n (vector-count p) a (vector-assoc! (vector-alloc (+ n 5)) 2 kind)
        b (vector-assoc! a 3 0) c (vector-assoc! b 4 mode)]
    (loop [i 0 v c] (if (= i n) v (recur (+ i 1) (vector-assoc! v (+ i 5) (vector-at p i)))))))
(defn main [] :i64
  (let [s (plan/rootfs-plan-new) a (plan/rootfs-plan-add s 0 (entry 1 493 "bin"))
        b (plan/rootfs-plan-add s 0 (entry 0 493 "bin/app"))
        c (plan/rootfs-plan-add s 0 (entry 0 420 "bin/noexec"))]
    (cond (or (not (= a 0)) (not (= b 0)) (not (= c 0))) 1
      (not (same? (process/process-launch-spec s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:b0e6f57745aa3d404517da2d80b62df092667fa389a0edac5319cd01093c5b34\",\"size\":254},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:9eb24d3fe15ac44397a3f76c8a98040d4e9c22437eeb7d86c3092b6e9481f337" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/app\",\"--x\"],\"Cmd\":[\"\",\"y\"],\"Env\":[\"A=1\",\"Z=\\u96ea\"],\"WorkingDir\":\"/bin\"}}")) (t-hex "465053010004000200042f62696e000000082f62696e2f617070000000032d2d7800000000000000017900000003413d31000000055a3de99baa"))) 2 ;; entrypoint-cmd-env
      (not (same? (process/process-launch-spec s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:b0e6f57745aa3d404517da2d80b62df092667fa389a0edac5319cd01093c5b34\",\"size\":254},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:9eb24d3fe15ac44397a3f76c8a98040d4e9c22437eeb7d86c3092b6e9481f337" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/xxx\",\"--x\"],\"Cmd\":[\"\",\"y\"],\"Env\":[\"A=1\",\"Z=\\u96ea\"],\"WorkingDir\":\"/bin\"}}")) [-1])) 99 ;; digest tamper
      (not (same? (process/process-launch-spec s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:2a8b55633be6be225bbaebe9226eed7bf6e61f4a1ed246b93e991fe65a928ca5\",\"size\":201},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:ec459ef07d599b9a5a9cd3f30311764277f66f7a971c38f7081cdebbae622f67" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[],\"Cmd\":[\"/bin/app\",\"z\"]}}")) (t-hex "465053010002000000012f000000082f62696e2f617070000000017a"))) 3 ;; cmd-fallback
      (not (same? (process/process-launch-spec s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:06a4ea16ef1644b26f514fad9d6665a68ebf192f4f12c913cf7e6e104b0470a5\",\"size\":191},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:05f794e0c57ccca4a1645f38bab855cc450d5581431ee2473331ac5f6b1a9e3e" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/noexec\"]}}")) [-1])) 4 ;; noexec
      (not (same? (process/process-launch-spec s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:1642c003d5370333a44f94374be2abaa2963c8c28a38ed25b9e27df403588162\",\"size\":208},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:a82eef3181b61d6349e2fcb174cef0d6145f5c4ad67ae0d5181b2688bb642999" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/app\"],\"Env\":[\"A=1\",\"A=2\"]}}")) [-1])) 5 ;; bad-env
      (not (same? (process/process-launch-spec s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:c3c016d1733d3958c0c6e14bed51497a33551c24e763533db0d0225725454337\",\"size\":191},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:07c4d4ddf99596ec51453f0763a593671745e1023093506165b4dc696cdb50a1" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/../app\"]}}")) [-1])) 6 ;; bad-path
