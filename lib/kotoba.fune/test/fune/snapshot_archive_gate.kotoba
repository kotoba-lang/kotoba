;; Test only: the hold check intentionally overwrites the supplied layer path.
(ns fune.snapshot-archive-gate (:export [main]) (:require [fune.snapshot-archive :as archive] [fune.snapshot :as snapshot]))
(defn- arg [i :string] :string (typed-cap-call :cli/args :string :string i))
(defn- frame [op :string path :string tail :string] :string (str "\u0000FS2\u0000" op path "\u0000" tail))
(defn- read-manifest [path :string] :vector-i64
  (let [b (typed-cap-call :fs/app-data :string :bytes (frame "A" path "")) n (bytes-count b)]
    (if (< n 5) (vector-alloc 0) (vector-i64-from-bytes (bytes-slice b 5 n)))))
(defn- equal-bytes? [a :bytes b :bytes] :bool
  (and (= (bytes-count a) (bytes-count b))
       (loop [i 0] (if (= i (bytes-count a)) true
         (if (= (bytes-at a i) (bytes-at b i)) (recur (+ i 1)) false)))))
(defn main [] :i64
  (let [mode (arg "0") path (arg "1") m (read-manifest (arg "2")) digest (arg "3") expected (arg "4")
        result (archive/verify-archive-and-hold path m digest 0)]
    (cond (not (= result expected)) 1
          (= mode "hold")
            (if (not (= result "ok")) 2
              (let [a (typed-cap-call :fs/app-data :string :bytes (frame "W" path "0:10"))
                    changed (typed-cap-call :fs/app-data :string :string (frame "B" path "changed"))
                    b (typed-cap-call :fs/app-data :string :bytes (frame "W" path "0:10"))
                    closed (snapshot/close-snapshot path)]
                (if (and (= (bytes-count a) 15) (equal-bytes? a b) closed) 0 3)))
          (= result "ok") (if (snapshot/close-snapshot path) 0 4)
          :else 0)))
