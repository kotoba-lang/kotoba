;; Test-only stdout is exclusively the worker stream, with no textual report.
(ns fune.layout-stream-runner (:export [main]) (:require [fune.layout-stream :as layout]))
(defn main [] :i64
  (let [argc (typed-cap-call :cli/args :string :string "")
        root (typed-cap-call :cli/args :string :string "0")
        digest (typed-cap-call :cli/args :string :string "1")
        result (if (= argc "2") (layout/emit-layout-hex root digest) "fune/usage")]
    (if (= result "ok") 0
      (let [sent (typed-cap-call :io/write-error :string :string (str result "\n"))] 1))))
