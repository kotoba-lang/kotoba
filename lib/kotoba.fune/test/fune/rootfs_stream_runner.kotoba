;; Test only: emits a worker protocol stream, never a detached authorization.
(ns fune.rootfs-stream-runner (:export [main])
  (:require [fune.rootfs-plan :as plan] [fune.rootfs-stream :as stream]
            [fune.image-manifest :as manifest]))
(defn- arg [i :string] :string (typed-cap-call :cli/args :string :string i))
(defn- blob [root :string digest :string] :string
  (str root "/blobs/sha256/" (string-substring digest 7 71)))
(defn- read-manifest [path :string] :vector-i64
  (let [b (typed-cap-call :fs/app-data :string :bytes (str "\u0000FS2\u0000A" path "\u0000")) n (bytes-count b)]
    (if (< n 5) (vector-alloc 0) (vector-i64-from-bytes (bytes-slice b 5 n)))))
(defn main [] :i64
  (let [root (arg "0") expected (arg "1") m (read-manifest (blob root expected))
        n (manifest/layer-count m expected) state (plan/rootfs-plan-new)]
    (if (< n 0) 1
      (let [started (stream/rootfs-stream-start)
            result (loop [i 0]
              (if (= i n) "ok"
                (let [digest (manifest/layer-digest m expected i)
                      p (stream/emit-layer-hex state (blob root digest) m expected i)]
                  (if (= p "ok") (recur (+ i 1)) p))))]
        (if (= result "ok") 0
          (let [w (typed-cap-call :io/write-error :string :string (str result "\n"))] 1))))))
