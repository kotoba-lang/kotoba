;; Local feasibility probe for a pinned real OCI blob, not a streaming loader.
;; FS2 reads a single file descriptor into segments, then this probe flattens
;; them into one vector to exercise the present vector-only hash and tar code.
(ns fune.large-layer-probe
  (:export [main])
  (:require [fune.layer-tar :as layer] [fune.image-manifest :as manifest]))

(defn- large-frame [path :string] :string
  (let [prefix (string-from-utf8 (bytes-from-vector-i64 [0 70 83 50 0 65]))
        nul (string-from-utf8 (bytes-from-vector-i64 [0]))]
    (string-concat prefix (string-concat path nul))))

(defn- large-chunks-size [chunks [:list :bytes]] :i64
  (loop [i 0 total 0]
    (if (= i (vector-count chunks)) total
      (recur (+ i 1) (+ total (bytes-count (typed-list-nth [:list :bytes] chunks i)))))))

(defn- large-copy [chunks [:list :bytes] payload-size :i64] :vector-i64
  (let [out (vector-alloc payload-size)]
    (loop [i 0 pos 0 v out]
      (if (= i (vector-count chunks)) v
        (let [chunk (typed-list-nth [:list :bytes] chunks i)
              next (loop [j 0 vv v]
                (if (= j (bytes-count chunk)) vv
                  (let [at (+ pos j)]
                    (recur (+ j 1) (if (< at 5) vv (vector-assoc! vv (- at 5) (bytes-at chunk j)))))))]
          (recur (+ i 1) (+ pos (bytes-count chunk)) next))))))

(defn- large-read [path :string expected-size :i64] :vector-i64
  (let [chunks (typed-cap-call :fs/app-data :string [:list :bytes] (large-frame path))
        n (large-chunks-size chunks)]
    (if (or (= (vector-count chunks) 0) (not (= n (+ expected-size 5)))) (vector-alloc 0)
      (let [first (typed-list-nth [:list :bytes] chunks 0)]
        (if (or (< (bytes-count first) 5) (not (= (bytes-at first 0) 0)) (not (= (bytes-at first 1) 70))
                (not (= (bytes-at first 2) 83)) (not (= (bytes-at first 3) 50)) (not (= (bytes-at first 4) 0)))
          (vector-alloc 0) (large-copy chunks expected-size))))))

(defn main [] :i64
  (let [m (large-read "/gate/fixtures/alpine-uncompressed.manifest" 896)
        b (large-read "/gate/fixtures/alpine-uncompressed.layer" 8939008)
        expected "sha256:0f1b6d241d7a58b1ed5843016248dbb42d6a8d94122e3186ccd263cd67c09971"]
    (cond (not (= (vector-count m) 896)) 1
          (not (= (vector-count b) 8939008)) 2
          ;; Alpine's bin/arch is a symlink, outside the present tar profile.
          (not (= (layer/layer-archive-problem m expected 0 b) "fune/tar-type")) 3
          :else (let [altered (vector-assoc! b (- (vector-count b) 1) 1)]
            (if (= (manifest/layer-bytes-problem m expected 0 altered) "fune/blob-digest") 1000 4)))))
