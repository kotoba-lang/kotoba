;; Expected hashes were generated independently; verdicts execute in native Kotoba.
(ns fune.sha-segments-gate (:export [main]) (:require [sha2.core :as sha]))

(defn- t-segments [total :i64 width :i64] [:list :bytes]
  (loop [offset 0 out (typed-list-new [:list :bytes])]
    (if (= offset total) out
      (let [remaining (- total offset) n (if (< remaining width) remaining width)
            data (loop [i 0 v (vector-alloc n)]
              (if (= i n) v (recur (+ i 1) (vector-assoc! v i (rem (+ (* (+ offset i) 17) 3) 256)))))]
        (recur (+ offset n) (typed-list-conj [:list :bytes] out (bytes-from-vector-i64 data)))))))

(defn- t-check [total :i64 width :i64 skip :i64 expected :string] :bool
  (= (sha/sha256-segments-hex (t-segments total width) skip) expected))

(defn main [] :i64
  (cond
    (not (t-check 0 7 0 "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")) 1
    (not (t-check 1 7 0 "084fed08b978af4d7d196a7446a86b58009e636b611db16211b65a9aadff29c5")) 2
    (not (t-check 55 7 0 "c40dbcd18dfdb34a5c52a791f09286986b5e9d61f867278c03adda227684e897")) 3
    (not (t-check 56 7 0 "ca6c4804e2170c368f94d2da606adf4552eb0b1d35bc2ad1dc12887627a028eb")) 4
    (not (t-check 63 7 0 "7f963102afccacb03458e0e3ee8f51a234359aed99cb7ebfd33d5e47a095fcba")) 5
    (not (t-check 64 7 0 "30a1b375b49e0f1d5e00b6868bbfd471cbe5387806456cc11fd153c689bfe747")) 6
    (not (t-check 65 7 0 "ce4c5c9097270aaca5630ec6ca4b48c145a1bb24462589a0ec3f69cd5c9b2a5c")) 7
    (not (t-check 119 7 0 "c9b7b15a882bf470dc6a27daf5486f9222f0ec5193069462d1ae5d729bbcc3eb")) 8
    (not (t-check 120 7 0 "53416ddca73fa04063bbedf24baf10637cde9f47c447586231115c0cc944645d")) 9
    (not (t-check 127 7 0 "fc7d260501b641289fe7df7d943df65d93c782f2f3a1e2a4e69c6f763d88f8c5")) 10
    (not (t-check 128 7 0 "5a878aab98a988c5479b48c00d8e2bef988c946dc648583ffe7ac598d76bacd5")) 11
    (not (t-check 129 7 0 "a1253e220a0a60177ba22d6f1ae079f6b8f0b8fa598b0adc1390b0d7c81756fa")) 12
    (not (t-check 1000 7 0 "e4d3b01e45b440696850bf3edccfe3544e44122ee8fc64a4fa62392fee7dc62a")) 13
    (not (t-check 129 17 1 "fcb6745044780e34f0df7a4109dc51ad81009059223c7eae65ac54cbdb8fb190")) 14
    (not (t-check 129 17 3 "ea76f19b1ee0ddffbd33a2f26e1de0cfe96e0f435b335e7c052b71a8b2415842")) 15
    (not (t-check 129 17 63 "8ec923bc83fa0c536257b0c0691a02483357a17772d65d281dc6288ad7e6e7dd")) 16
    (not (t-check 129 17 64 "f8878014c399c09ad633ff89f1c3cfbe1319d5bdc2754b2f6a592a5814a56d9c")) 17
    (not (t-check 129 17 65 "afb57ccf51a0f54c8f91a7beafa87cfd0912bad5b3d904d0224f1bd0a8d0703f")) 18
    (not (t-check 129 17 129 "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")) 19
    (not (t-check 1048576 4096 0 "470952a05336a638e11755d028432cb890c3240d0b33668038a975e7e3b5b4ef")) 20
    (not (= (sha/sha256-segments-hex (t-segments 3 1) -1) "")) 21
    (not (= (sha/sha256-segments-hex (t-segments 3 1) 4) "")) 22
    (not (= (sha/sha256-segments-hex (typed-list-conj [:list :bytes] (t-segments 0 1) (bytes-empty)) 0) "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")) 23
    (not (= (sha/sha256-segments-hex
      (typed-list-conj [:list :bytes]
        (typed-list-conj [:list :bytes]
          (typed-list-conj [:list :bytes] (typed-list-new [:list :bytes]) (bytes-empty))
          (string-to-utf8 "abc")) (string-to-utf8 "def")) 2)
      "9727bc3a31f5a09994a8408791a22db4b12502452e6e5d00a59a0ef8342b41cf")) 24
    :else 1000))
