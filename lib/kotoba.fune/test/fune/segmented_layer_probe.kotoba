;; Test-only one-descriptor FS2 read, without flattening layer bytes into i64.
;; The provider still materializes the full response; this is not streaming I/O.
(ns fune.segmented-layer-probe
  (:export [main])
  (:require [fune.image-manifest :as manifest] [fune.layer-tar :as layer]))

(defn- seg-frame [path :string] :string
  (let [prefix (string-from-utf8 (bytes-from-vector-i64 [0 70 83 50 0 65]))
        nul (string-from-utf8 (bytes-from-vector-i64 [0]))]
    (string-concat prefix (string-concat path nul))))

(defn- seg-small-read [path :string] :vector-i64
  (let [r (vector-i64-from-bytes (typed-cap-call :fs/app-data :string :bytes (seg-frame path)))
        n (vector-count r)]
    (if (and (>= n 5) (= (vector-at r 0) 0) (= (vector-at r 1) 70) (= (vector-at r 2) 83)
             (= (vector-at r 3) 50) (= (vector-at r 4) 0))
      (loop [i 5 v (vector-alloc (- n 5))] (if (= i n) v (recur (+ i 1) (vector-assoc! v (- i 5) (vector-at r i)))))
      (vector-alloc 0))))

(defn- seg-payload [chunks [:list :bytes]] [:list :bytes]
  (if (= (vector-count chunks) 0) (typed-list-new [:list :bytes])
    (let [head (typed-list-nth [:list :bytes] chunks 0) n (bytes-count head)]
      (if (or (< n 5) (not (= (bytes-at head 0) 0)) (not (= (bytes-at head 1) 70))
              (not (= (bytes-at head 2) 83)) (not (= (bytes-at head 3) 50)) (not (= (bytes-at head 4) 0)))
        (typed-list-new [:list :bytes])
        (loop [i 1 out (typed-list-conj [:list :bytes] (typed-list-new [:list :bytes]) (bytes-slice head 5 n))]
          (if (= i (vector-count chunks)) out
            (recur (+ i 1) (typed-list-conj [:list :bytes] out (typed-list-nth [:list :bytes] chunks i)))))))))

(defn- seg-mutated [chunks [:list :bytes]] [:list :bytes]
  (let [n (vector-count chunks)]
    (loop [i 0 out (typed-list-new [:list :bytes])]
      (if (= i n) out
        (let [chunk (typed-list-nth [:list :bytes] chunks i) size (bytes-count chunk)
              next (if (and (= i (- n 1)) (> size 0))
                     (bytes-concat (bytes-slice chunk 0 (- size 1)) (bytes-from-vector-i64 [1])) chunk)]
          (recur (+ i 1) (typed-list-conj [:list :bytes] out next)))))))

(defn main [] :i64
  (let [m (seg-small-read "/gate/fixtures/alpine-uncompressed.manifest")
        raw (typed-cap-call :fs/app-data :string [:list :bytes] (seg-frame "/gate/fixtures/alpine-uncompressed.layer"))
        chunks (seg-payload raw) expected "sha256:0f1b6d241d7a58b1ed5843016248dbb42d6a8d94122e3186ccd263cd67c09971"]
    (cond (not (= (vector-count m) 896)) 1
          (< (vector-count chunks) 2) 2
          ;; The real Alpine layer begins with an unsupported symlink.
          (not (= (layer/layer-segments-archive-problem m expected 0 chunks) "fune/tar-type")) 3
          (not (= (manifest/layer-segments-problem m expected 0 (seg-mutated chunks)) "fune/blob-digest")) 4
          :else 1000)))
