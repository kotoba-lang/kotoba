;; Independently generated config/manifest byte fixtures; native verdicts.
(ns fune.process-rootfs-gate (:export [main]) (:require [fune.process-rootfs :as process] [fune.rootfs-plan :as plan]))
(defn- t-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- entry [kind :i64 mode :i64 path :string] :vector-i64
  (let [p (t-bytes path) n (vector-count p) a (vector-assoc! (vector-alloc (+ n 5)) 2 kind)
        b (vector-assoc! a 3 0) c (vector-assoc! b 4 mode)]
    (loop [i 0 v c] (if (= i n) v (recur (+ i 1) (vector-assoc! v (+ i 5) (vector-at p i)))))))
(defn main [] :i64
  (let [s (plan/rootfs-plan-new) a (plan/rootfs-plan-add s 0 (entry 1 493 "bin"))
        b (plan/rootfs-plan-add s 0 (entry 0 493 "bin/app"))
        c (plan/rootfs-plan-add s 0 (entry 0 420 "bin/noexec"))]
    (cond (or (not (= a 0)) (not (= b 0)) (not (= c 0))) 1
      (not (= (process/process-rootfs-problem s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:b39881cb028cf9f913e0bef6314c982cae33a6821e79b7e7985c0ed4dc0e9c7d\",\"size\":226},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:464013f10370c47a7395eee895ed2196331b057c1d14e9835a5eb0ce85ef793a" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/app\"],\"Cmd\":[\"ignored\"],\"WorkingDir\":\"/bin\"}}")) "ok")) 2 ;; normal
      (not (= (process/process-rootfs-problem s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:b39881cb028cf9f913e0bef6314c982cae33a6821e79b7e7985c0ed4dc0e9c7d\",\"size\":226},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:464013f10370c47a7395eee895ed2196331b057c1d14e9835a5eb0ce85ef793a" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/xxx\"],\"Cmd\":[\"ignored\"],\"WorkingDir\":\"/bin\"}}")) "fune/blob-digest")) 99 ;; modified config
      (not (= (process/process-rootfs-problem s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:fbaed54121a749e3057cd4a2edd396a956f6646bdaf98956cd6f5ebcb5b549b0\",\"size\":181},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:026ba2478b42beb14f5bd6766fdcfdf09ed8bf8d8d8f2f43b3767cec73cb1563" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Cmd\":[\"/bin/app\"]}}")) "ok")) 3 ;; fallback
      (not (= (process/process-rootfs-problem s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:3344bc7a5af023b4236ebe8d063067ad720572073cd043f73436da4e602e0e00\",\"size\":204},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:65d25a0a9b2350b0c456f2e7fa391cc2a9752455596eb745b6563e13f3b92331" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/app\"],\"WorkingDir\":\"\"}}")) "ok")) 4 ;; empty-cwd
      (not (= (process/process-rootfs-problem s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:44f9a6b60f94baab1f204ffc300e739cec12174cdfb8ad7546da71ab8486d58f\",\"size\":192},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:61316a149ec0757156a7359994ca7a2bbcc4dcad349eaad2c56c7bab964287e5" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/missing\"]}}")) "fune/process-executable-missing")) 5 ;; missing
      (not (= (process/process-rootfs-problem s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:7c4c36c1b0ce0252bf79feaaca65ba66db6f153397b68d7add04b98c19af55ed\",\"size\":184},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:6f61ad879bfcf04aa82379a5f60625bdea34e3761f9a07e5f13afc7718db54d5" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin\"]}}")) "fune/process-executable-missing")) 6 ;; directory
      (not (= (process/process-rootfs-problem s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:06a4ea16ef1644b26f514fad9d6665a68ebf192f4f12c913cf7e6e104b0470a5\",\"size\":191},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:05f794e0c57ccca4a1645f38bab855cc450d5581431ee2473331ac5f6b1a9e3e" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/noexec\"]}}")) "fune/process-executable-mode")) 7 ;; not-executable
      (not (= (process/process-rootfs-problem s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:c3c016d1733d3958c0c6e14bed51497a33551c24e763533db0d0225725454337\",\"size\":191},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:07c4d4ddf99596ec51453f0763a593671745e1023093506165b4dc696cdb50a1" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/../app\"]}}")) "fune/process-executable-path")) 8 ;; traversal
      (not (= (process/process-rootfs-problem s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:ab291fd29e8f94ff832cd2d9852afc8b78edb29a89bc24c5144713c2fe4fff5e\",\"size\":189},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:a8094fd3052f49095521d4c6abe16045cf3885fc7af595597a5ceacc8c46f875" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin//app\"]}}")) "fune/process-executable-path")) 9 ;; double-slash
      (not (= (process/process-rootfs-problem s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:648102397c972d13c408f58280b1c56ee0baf4bcedd948381dc140090bd88ea9\",\"size\":181},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:0d829c25f111cc3380fc3c1248fd0490fced9add53f81a5dca514e965c156fe1" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/\"]}}")) "fune/process-executable-path")) 10 ;; root-executable
      (not (= (process/process-rootfs-problem s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:0097412194a699154400d922ea950807645fd9dda7f89060e7aff7bbc5d46923\",\"size\":211},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:9949bdfec0db5b62db55d46199694c88ae632a460497ae5518112f0760a328bd" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/app\"],\"WorkingDir\":\"/bin/..\"}}")) "fune/process-working-dir-path")) 11 ;; bad-workdir-path
      (not (= (process/process-rootfs-problem s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:5d11456edcfb839603c599d032d2df758c06a9e4374cec21ddf5bdf6fc0c1327\",\"size\":212},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:919614314c748dc09d962c6ea213c9078dce89752df4a0cb40d2bc5fa8a34a13" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/app\"],\"WorkingDir\":\"/missing\"}}")) "fune/process-working-dir-missing")) 12 ;; missing-workdir
      (not (= (process/process-rootfs-problem s (t-bytes "{\"schemaVersion\":2,\"mediaType\":\"application/vnd.oci.image.manifest.v1+json\",\"config\":{\"mediaType\":\"application/vnd.oci.image.config.v1+json\",\"digest\":\"sha256:7dde4d15ad1cf18b61418019175882be2e87151150f2c7ce9946976db794a9c2\",\"size\":212},\"layers\":[{\"mediaType\":\"application/vnd.oci.image.layer.v1.tar\",\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"size\":3}]}") "sha256:a67a7f2ad327003123f435650dc1f6cdaae0c3423834d59516b19b891878d8f1" (t-bytes "{\"architecture\":\"arm64\",\"os\":\"linux\",\"rootfs\":{\"type\":\"layers\",\"diff_ids\":[\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\"]},\"config\":{\"Entrypoint\":[\"/bin/app\"],\"WorkingDir\":\"/bin/app\"}}")) "fune/process-working-dir-missing")) 13 ;; file-workdir
      :else 0)))
