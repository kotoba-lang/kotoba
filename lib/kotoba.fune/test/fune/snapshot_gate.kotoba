(ns fune.snapshot-gate (:export [main]) (:require [fune.snapshot :as snapshot] [sha2.core :as sha]))
(defn- arg [i :string] :string (typed-cap-call :cli/args :string :string i))
(defn- frame [op :string path :string tail :string] :string
  (str "\u0000FS2\u0000" op path "\u0000" tail))
(defn- text-call [op :string path :string tail :string] :string
  (typed-cap-call :fs/app-data :string :string (frame op path tail)))
(defn- read-manifest [path :string] :vector-i64
  (let [b (typed-cap-call :fs/app-data :string :bytes (frame "A" path "")) n (bytes-count b)]
    (if (< n 5) (vector-alloc 0) (vector-i64-from-bytes (bytes-slice b 5 n)))))
(defn- eq-bytes? [a :bytes b :bytes] :bool
  (and (= (bytes-count a) (bytes-count b))
       (loop [i 0] (if (= i (bytes-count a)) true
         (if (= (bytes-at a i) (bytes-at b i)) (recur (+ i 1)) false)))))
(defn- sha-check [] :bool
  (let [w (sha/sha256-stream-work) b (sha/sha256-stream-block) k (sha/sha256-stream-constants)
        first (sha/sha256-stream-update w b k (string-to-utf8 "a") 0 0)
        second (sha/sha256-stream-update w b k (string-to-utf8 "bc") 0 first)]
    (and (= second 3)
         (= (sha/sha256-stream-final-hex w b k second 3)
            "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"))))
(defn- sha-boundary-one [n :i64 width :i64] :bool
  (let [v (loop [i 0 out (vector-alloc n)]
            (if (= i n) out (recur (+ i 1) (vector-assoc! out i (rem (* i 37) 256)))))
        bytes (bytes-from-vector-i64 v) w (sha/sha256-stream-work)
        block (sha/sha256-stream-block) k (sha/sha256-stream-constants)
        used (loop [offset 0 pending 0]
               (if (= offset n) pending
                 (let [left (- n offset) count (if (< left width) left width)
                       next (sha/sha256-stream-update w block k (bytes-slice bytes offset (+ offset count)) 0 pending)]
                   (if (< next 0) -1 (recur (+ offset count) next))))) ]
    (= (sha/sha256-stream-final-hex w block k used n) (sha/sha256-hex v))))
(defn- sha-boundaries [] :bool
  (loop [n 0]
    (if (> n 130) true
      (if (and (sha-boundary-one n 1) (sha-boundary-one n 13) (sha-boundary-one n 64))
        (recur (+ n 1)) false))))
(defn main [] :i64
  (let [mode (arg "0") path (arg "1") manifest-path (arg "2") digest (arg "3")
        result (snapshot/verify-layer-and-hold path (read-manifest manifest-path) digest 0)]
    (cond (not (and (sha-check) (sha-boundaries))) 1
          (= mode "good")
            (if (not (= result "ok")) 2
              (let [before (typed-cap-call :fs/app-data :string :bytes (frame "W" path "0:10"))
                    changed (text-call "B" path "changed")
                    after (typed-cap-call :fs/app-data :string :bytes (frame "W" path "0:10"))
                    closed (snapshot/close-snapshot path)]
                (if (and (eq-bytes? before after) (= (bytes-count after) 15) closed) 0 3)))
          (= mode "bad") (if (not (= result "fune/blob-digest")) 4
            (let [reopened (text-call "V" path "2048") closed (snapshot/close-snapshot path)]
              (if (and (= reopened "\u0000FS2\u00001") closed) 0 7)))
          (= mode "invalid-manifest") (if (= result "fune/manifest-invalid") 0 8)
          (= mode "alpine") (if (and (= result "ok") (snapshot/close-snapshot path)) 0 5)
          :else 6)))
