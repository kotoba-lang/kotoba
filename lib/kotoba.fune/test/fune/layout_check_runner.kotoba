;; Test-only adapter. With Linux static images, use KEXE_COMMAND=1 without
;; KEXE_STRUCTURED_REPORT to map a returned failure to the process exit code.
;; Production must use a qualified controller, not this adapter.
(ns fune.layout-check-runner (:export [main]) (:require [fune.layout-check :as layout]))
(defn main [] :i64
  (let [argc (typed-cap-call :cli/args :string :string "")
        root (typed-cap-call :cli/args :string :string "0")
        digest (typed-cap-call :cli/args :string :string "1")
        result (if (= argc "2") (layout/verify-layout root digest) "fune/usage")
        sent (typed-cap-call :io/write :string :string (string-concat result "\n"))]
    (if (= result "ok") 0 1)))
