;; Test only: the good case overwrites its disposable source layer.
(ns fune.snapshot-entry-gate (:export [main]) (:require [fune.snapshot-archive :as archive] [fune.snapshot :as snapshot]))
(defn- arg [i :string] :string (typed-cap-call :cli/args :string :string i))
(defn- frame [op :string path :string tail :string] :string (str "\u0000FS2\u0000" op path "\u0000" tail))
(defn- read-manifest [path :string] :vector-i64
  (let [b (typed-cap-call :fs/app-data :string :bytes (frame "A" path "")) n (bytes-count b)]
    (if (< n 5) (vector-alloc 0) (vector-i64-from-bytes (bytes-slice b 5 n)))))
(defn- entry? [v :vector-i64 next :i64 data :i64 kind :i64 size :i64 mode :i64 path :string] :bool
  (let [p (vector-i64-from-bytes (string-to-utf8 path)) n (vector-count p)]
    (and (= (vector-count v) (+ n 5)) (= (vector-at v 0) next) (= (vector-at v 1) data)
         (= (vector-at v 2) kind) (= (vector-at v 3) size) (= (vector-at v 4) mode)
         (loop [i 0] (if (= i n) true
           (if (= (vector-at v (+ i 5)) (vector-at p i)) (recur (+ i 1)) false))))))
(defn- refused? [v :vector-i64] :bool (and (= (vector-count v) 1) (= (vector-at v 0) -1)))
(defn- repeat-text [s :string n :i64] :string
  (loop [i 0 out ""] (if (= i n) out (recur (+ i 1) (string-concat out s)))))
(defn main [] :i64
  (let [mode (arg "0") path (arg "1") m (read-manifest (arg "2")) digest (arg "3")
        opened (archive/verify-archive-and-hold path m digest 0)]
    (if (not (= opened "ok")) 1
      (let [size (cond (= mode "multi") 3072 (= mode "directory") 1536 :else 2048)
            e (archive/snapshot-entry path 0 size)
            checked (cond (= mode "good")
                      (let [changed (typed-cap-call :fs/app-data :string :string (frame "B" path "changed"))
                            payload (typed-cap-call :fs/app-data :string :bytes (frame "W" path "512:3"))]
                        (and (entry? e 1024 512 0 3 420 "bin/hello")
                             (= (bytes-count payload) 8) (= (bytes-at payload 5) 97)
                             (= (bytes-at payload 6) 98) (= (bytes-at payload 7) 99)))
                      (= mode "multi")
                      (let [second (archive/snapshot-entry path 1024 size)]
                        (and (entry? e 1024 512 0 1 420 "one")
                             (entry? second 2048 1536 0 2 420 "two")))
                      (= mode "directory") (entry? e 512 512 1 0 493 "bin")
                      (= mode "prefix") (entry? e 1024 512 0 3 420 (str (repeat-text "a" 90) "/" (repeat-text "b" 40)))
                      :else false)
            bad1 (archive/snapshot-entry path 1 size)
            bad2 (archive/snapshot-entry path 9223372036854775807 size)
            bad3 (archive/snapshot-entry path (- size 512) size)
            closed (snapshot/close-snapshot path)]
        (if (and checked (refused? bad1) (refused? bad2) (refused? bad3) closed) 0 2)))))
