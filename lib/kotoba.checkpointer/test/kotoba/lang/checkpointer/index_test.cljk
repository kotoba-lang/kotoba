(ns kotoba.lang.checkpointer.index-test
  "`index-key`/`latest-for`/`list-rows` are portable, tested identically on
  both platforms. `load-persist-round-trip-test` exercises the `:clj`-only
  JSON-file I/O (`load-index!`/`persist-index!`) and is gated accordingly."
  (:require [kotoba.io :as kio] [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.checkpointer.index :as index]))

(defn- row [cell-did thread-id ns- checkpoint-id projected-at]
  {"cell_did" cell-did "thread_id" thread-id "checkpoint_ns" ns-
   "checkpoint_id" checkpoint-id "mst_root_cid" (str "cid-" checkpoint-id)
   "car_size_bytes" 10 "car_blob_count" 0 "mst_projected_at" projected-at
   "ipfs_pinned_at" nil "ipfs_pin_service" nil "ipfs_pin_id" nil
   "anchor_tx_hash" nil "anchor_block_number" nil "anchor_log_index" nil
   "anchor_chain_id" 8453 "anchored_at" nil})

(deftest index-key-test
  (testing "composite key is NUL-separated (matches checkpointer.ts's indexKey)"
    (is (= "c\u0000t\u0000ns\u0000id" (index/index-key {"cell_did" "c" "thread_id" "t" "checkpoint_ns" "ns" "checkpoint_id" "id"})))))

(deftest latest-for-test
  (let [rows [(row "c1" "t1" "" "a" 100) (row "c1" "t1" "" "b" 200) (row "c1" "t2" "" "z" 300) (row "c2" "t1" "" "q" 400)]
        idx (into {} (map (fn [r] [(index/index-key r) r])) rows)]
    (testing "picks the greatest mst_projected_at among matching rows"
      (is (= "b" (get (index/latest-for idx "c1" "t1" "") "checkpoint_id"))))
    (testing "nil when nothing matches"
      (is (nil? (index/latest-for idx "c1" "t1" "no-such-ns"))))
    (testing "ties broken by checkpoint_id descending"
      (let [tie-rows [(row "c3" "t" "" "aaa" 500) (row "c3" "t" "" "zzz" 500)]
            tie-idx (into {} (map (fn [r] [(index/index-key r) r])) tie-rows)]
        (is (= "zzz" (get (index/latest-for tie-idx "c3" "t" "") "checkpoint_id")))))))

(deftest list-rows-test
  (let [rows [(row "c1" "t1" "" "a" 100) (row "c1" "t1" "" "b" 200) (row "c1" "t2" "" "z" 300)]
        idx (into {} (map (fn [r] [(index/index-key r) r])) rows)]
    (testing "newest-first"
      (is (= ["b" "a"] (mapv #(get % "checkpoint_id") (index/list-rows idx "c1" "t1" "")))))))

#?(:clj
(deftest load-persist-round-trip-test
  (let [dir (str (kio/temp-dir "checkpointer-index-test"))
        rows [(row "c1" "t1" "" "a" 100)]
        idx (into {} (map (fn [r] [(index/index-key r) r])) rows)]
    (testing "no index.json yet -> {}"
      (is (= {} (index/load-index! dir))))
    (index/persist-index! dir idx)
    (testing "round-trips through JSON"
      (is (= idx (index/load-index! dir)))))))
