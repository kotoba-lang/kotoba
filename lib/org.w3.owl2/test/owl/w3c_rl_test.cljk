(ns owl.w3c-rl-test
  "The W3C OWL 2 conformance test cases for the RL profile, run through
  `owl.rl`.

  Source: https://www.w3.org/2009/11/owl-test/profile-RL.rdf (the export of
  every non-rejected test case tagged profile RL), vendored byte for byte
  under test-resources/w3c-owl2/ (see the README there).

  What \"pass\" means per test type:
    PositiveEntailmentTest  the conclusion graph maps into the closure
                            (its blank nodes are existential variables);
                            ontology-header triples are not compared
    NegativeEntailmentTest  the non-conclusion graph does NOT map in
    InconsistencyTest       at least one inconsistency is reported
    ConsistencyTest         no inconsistency is reported

  A test whose ontologies are given only in functional syntax, or that
  imports another ontology, cannot run here (there is no functional-syntax
  text parser and no import resolution). Those are counted as `:not-run`
  with the reason -- never as passes. The expected outcome of every test
  that does run is pinned in `expected`, failures included, so a change in
  either direction shows up as a diff rather than as a count."
  (:require [kotoba.test :refer [deftest is testing]]
            [owl.rl :as rl]
            [owl.rules :as rules]
            [owl.w3c-rdfxml :as rdfxml]))

(def manifest-path "lib/org.w3.owl2/test-resources/w3c-owl2/profile-RL.rdf")

(defn- slurp* [p]
  #?(:clj (slurp p) :cljs (.readFileSync (js/require "fs") p "utf8")))

(def test-ns "http://www.w3.org/2007/OWL/testOntology#")
(def rdf-type "http://www.w3.org/1999/02/22-rdf-syntax-ns#type")

(defn- tq [local] (str test-ns local))

(defn test-cases
  "Every test:TestCase in the manifest as a map."
  [manifest-text]
  (let [triples (rdfxml/parse manifest-text "m")
        by-s (group-by :s triples)
        vals (fn [s p] (keep #(when (= p (:p %)) (:o %)) (get by-s s)))
        text (fn [s p] (some-> (first (vals s p)) :literal))]
    (for [s (distinct (keep #(when (and (= rdf-type (:p %)) (= (tq "TestCase") (:o %))) (:s %)) triples))]
      {:id (text s (tq "identifier"))
       :types (set (keep #(when (.startsWith % test-ns) (subs % (count test-ns))) (vals s rdf-type)))
       :semantics (set (map #(subs % (count test-ns)) (vals s (tq "semantics"))))
       :premise (text s (tq "rdfXmlPremiseOntology"))
       :conclusion (text s (tq "rdfXmlConclusionOntology"))
       :non-conclusion (text s (tq "rdfXmlNonConclusionOntology"))
       :fs-only? (and (nil? (text s (tq "rdfXmlPremiseOntology")))
                      (some? (text s (tq "fsPremiseOntology"))))
       :imports? (seq (vals s (tq "importedOntology")))})))

(def ^:private owl "http://www.w3.org/2002/07/owl#")

(defn- header? [{:keys [p o]}]
  (or (= o (str owl "Ontology")) (= p (str owl "imports")) (= p (str owl "versionIRI"))))

(defn- maps-into?
  "Is there a mapping of `pattern`'s blank nodes to terms under which every
  pattern triple is in `graph`?"
  [pattern graph]
  (let [by-p (group-by :p graph)
        pattern (sort-by #(count (filter rdfxml/blank? [(:s %) (:o %)])) pattern)
        step (fn step [[t & more] m]
               (if (nil? t)
                 true
                 (some (fn [g]
                         (let [m' (reduce (fn [m [pt gt]]
                                            (cond (nil? m) nil
                                                  (rdfxml/blank? pt) (let [b (get m pt ::none)]
                                                                       (cond (= b ::none) (assoc m pt gt)
                                                                             (= b gt) m
                                                                             :else nil))
                                                  (= pt gt) m
                                                  :else nil))
                                          m [[(:s t) (:s g)] [(:o t) (:o g)]])]
                           (when m' (step more m'))))
                       (get by-p (:p t)))))]
    (boolean (step pattern {}))))

(defn run-case
  "[outcome detail] for one test case: :pass, :fail or :not-run. `opts` go
  to `owl.rl/entail` (the controls below pass `:rules`)."
  ([c] (run-case c {}))
  ([c opts]
  (cond
    (:imports? c) [:not-run "imports another ontology"]
    (:fs-only? c) [:not-run "functional syntax only"]
    (nil? (:premise c)) [:not-run "no premise ontology"]
    :else
    (let [r (rl/entail (rdfxml/parse (:premise c) "p") (assoc opts :vocabulary rules/rl-iri-vocabulary))
          graph (:graph r)
          checks (cond-> []
                   (contains? (:types c) "InconsistencyTest")
                   (conj [:inconsistency (not (:consistent? r))])
                   (contains? (:types c) "ConsistencyTest")
                   (conj [:consistency (:consistent? r)])
                   (and (contains? (:types c) "PositiveEntailmentTest") (:conclusion c))
                   (conj [:positive (maps-into? (remove header? (rdfxml/parse (:conclusion c) "c")) graph)])
                   (and (contains? (:types c) "NegativeEntailmentTest") (:non-conclusion c))
                   (conj [:negative (not (maps-into? (remove header? (rdfxml/parse (:non-conclusion c) "n")) graph))]))]
      (cond
        (empty? checks) [:not-run "no RDF/XML conclusion for its test type"]
        (every? second checks) [:pass (cond-> (mapv first checks)
                                        (not (:consistent? r)) (conj (set (map :rule (:inconsistencies r)))))]
        :else [:fail (vec (keep (fn [[k ok]] (when-not ok k)) checks))])))))

(defn results
  ([] (results {}))
  ([opts]
   (into (sorted-map)
         (map (fn [c] [(:id c) (run-case c opts)]))
         (test-cases (slurp* manifest-path)))))

(def expected
  "Every test case's outcome, pinned. The `:fail` rows are entailments the
  OWL 2 RL/RDF rules do not derive -- the rule set is complete only for the
  conclusions Theorem PR1 names (assertions about named individuals), and
  each comment says which boundary the test crosses."
  {
   "DisjointClasses-001" [:fail [:positive]]
    ;; conclusion is a ClassAssertion of an anonymous complementOf class -- outside Theorem PR1's ground-atom conclusions
   "DisjointClasses-002" [:pass [:inconsistency #{:cax-dw}]]
   "DisjointClasses-003" [:fail [:positive]]
    ;; as DisjointClasses-001
   "FS2RDF-different-individuals-2-annotation-ar" [:pass [:consistency]]
   "FS2RDF-different-individuals-2-ar" [:pass [:consistency]]
   "FS2RDF-different-individuals-3-annotation-ar" [:pass [:consistency]]
   "FS2RDF-different-individuals-3-ar" [:pass [:consistency]]
   "FS2RDF-disjoint-classes-2-annotation-ar" [:pass [:consistency]]
   "FS2RDF-disjoint-classes-2-ar" [:pass [:consistency]]
   "FS2RDF-disjoint-classes-3-annotation-ar" [:pass [:consistency]]
   "FS2RDF-disjoint-classes-3-ar" [:pass [:consistency]]
   "FS2RDF-domain-range-simple-ar" [:pass [:consistency]]
   "FS2RDF-equivalent-classes-2-annotation-ar" [:pass [:consistency]]
   "FS2RDF-equivalent-classes-2-ar" [:pass [:consistency]]
   "FS2RDF-equivalent-classes-3-annotation-ar" [:pass [:consistency]]
   "FS2RDF-equivalent-classes-3-ar" [:pass [:consistency]]
   "FS2RDF-no-builtin-prefixes-ar" [:pass [:consistency]]
   "FS2RDF-ontology-annotation-annotation-ar" [:pass [:consistency]]
   "FS2RDF-propertychain-2-annotated-ar" [:pass [:consistency]]
   "FS2RDF-propertychain-2-ar" [:pass [:consistency]]
   "FS2RDF-same-individual-2-annotation-ar" [:pass [:consistency]]
   "FS2RDF-same-individual-2-ar" [:pass [:consistency]]
   "FS2RDF-same-individual-3-annotation-ar" [:pass [:consistency]]
   "New-Feature-AnnotationAnnotations-001" [:pass [:consistency]]
   "New-Feature-AsymmetricProperty-001" [:pass [:inconsistency #{:prp-asyp}]]
   "New-Feature-AxiomAnnotations-001" [:pass [:consistency]]
   "New-Feature-DisjointDataProperties-001" [:pass [:inconsistency #{:prp-pdw}]]
   "New-Feature-DisjointDataProperties-002" [:fail [:positive]]
    ;; conclusion is an AllDifferent axiom; RL materializes no owl:differentFrom
   "New-Feature-DisjointObjectProperties-001" [:fail [:positive]]
    ;; conclusion is owl:differentFrom; RL materializes no owl:differentFrom
   "New-Feature-DisjointObjectProperties-002" [:fail [:positive]]
    ;; conclusion is an AllDifferent axiom
   "New-Feature-IrreflexiveProperty-001" [:pass [:inconsistency #{:prp-irp}]]
   "New-Feature-Keys-003" [:pass [:consistency :positive]]
   "New-Feature-Keys-004" [:pass [:consistency :negative]]
   "New-Feature-Keys-005" [:pass [:consistency]]
   "New-Feature-Keys-006" [:pass [:inconsistency #{:dt-diff}]]
   "New-Feature-NegativeDataPropertyAssertion-001" [:pass [:inconsistency #{:prp-npa2}]]
   "New-Feature-NegativeObjectPropertyAssertion-001" [:pass [:inconsistency #{:prp-npa1}]]
   "New-Feature-ObjectPropertyChain-001" [:pass [:consistency :positive]]
   "New-Feature-ObjectPropertyChain-BJP-002" [:not-run "functional syntax only"]
   "New-Feature-ObjectPropertyChain-BJP-003" [:pass [:consistency :positive]]
   "New-Feature-ObjectPropertyChain-BJP-004" [:pass [:consistency :negative]]
   "New-Feature-ObjectQCR-002" [:fail [:positive]]
    ;; conclusion is a complementOf ClassAssertion
   "New-Feature-ReflexiveProperty-001" [:fail [:positive]]
    ;; owl:ReflexiveProperty has no RL rule (vocabulary-status :unsupported)
   "Plus and Minus Zero are Distinct" [:not-run "functional syntax only"]
   "WebOnt-AnnotationProperty-003" [:pass [:consistency]]
   "WebOnt-AnnotationProperty-004" [:pass [:consistency]]
   "WebOnt-I4.6-003" [:pass [:consistency :positive]]
   "WebOnt-I4.6-004" [:pass [:consistency :negative]]
   "WebOnt-I4.6-005" [:pass [:consistency :negative]]
   "WebOnt-I4.6-005-Direct" [:fail [:positive]]
    ;; DIRECT-semantics-only annotation entailment; the RL/RDF rules are RDF-based
   "WebOnt-I5.26-001" [:pass [:consistency]]
   "WebOnt-I5.26-002" [:pass [:consistency]]
   "WebOnt-I5.26-005" [:pass [:consistency]]
   "WebOnt-I5.26-010" [:fail [:positive]]
    ;; conclusion uses owl:minCardinality (no RL rule)
   "WebOnt-I5.5-005" [:fail [:positive]]
    ;; conclusion is an anonymous unionOf class declaration (and rdf:List typing)
   "WebOnt-I5.8-006" [:fail [:positive]]
    ;; datatype subsumption (byte within short) for rdfs:range: RL has no datatype-hierarchy rule
   "WebOnt-I5.8-007" [:pass [:consistency :negative]]
   "WebOnt-I5.8-008" [:fail [:positive]]
    ;; datatype subsumption for rdfs:range
   "WebOnt-I5.8-009" [:fail [:positive]]
    ;; datatype subsumption for rdfs:range
   "WebOnt-I5.8-011" [:pass [:consistency :positive]]
   "WebOnt-Nothing-001" [:pass [:inconsistency #{:cls-nothing2}]]
   "WebOnt-backwardCompatibleWith-002" [:pass [:consistency]]
   "WebOnt-description-logic-101" [:pass [:inconsistency #{:cls-com}]]
   "WebOnt-description-logic-103" [:pass [:inconsistency #{:cls-com}]]
   "WebOnt-description-logic-104" [:pass [:inconsistency #{:cls-com}]]
   "WebOnt-differentFrom-001" [:fail [:positive]]
    ;; owl:differentFrom symmetry is not materialized by any RL rule
   "WebOnt-disjointWith-003" [:pass [:consistency]]
   "WebOnt-disjointWith-004" [:pass [:consistency]]
   "WebOnt-disjointWith-005" [:pass [:consistency]]
   "WebOnt-disjointWith-006" [:pass [:consistency]]
   "WebOnt-disjointWith-007" [:pass [:consistency]]
   "WebOnt-disjointWith-008" [:pass [:consistency]]
   "WebOnt-disjointWith-009" [:pass [:consistency]]
   "WebOnt-equivalentClass-002" [:pass [:consistency :positive]]
   "WebOnt-equivalentClass-003" [:pass [:consistency :positive]]
   "WebOnt-equivalentClass-008" [:pass [:consistency :negative]]
   "WebOnt-equivalentClass-008-Direct" [:fail [:positive]]
    ;; DIRECT-semantics-only annotation entailment
   "WebOnt-equivalentProperty-002" [:pass [:consistency :positive]]
   "WebOnt-equivalentProperty-003" [:pass [:consistency :positive]]
   "WebOnt-imports-011" [:not-run "imports another ontology"]
   "WebOnt-imports-013" [:not-run "imports another ontology"]
   "WebOnt-miscellaneous-303" [:pass [:consistency]]
   "WebOnt-sameAs-001" [:pass [:consistency :positive]]
   "chain2trans1" [:fail [:positive]]
    ;; schema conclusion (p TransitiveProperty from p o p -> p): RL rules derive no property characteristics
   "functionality-clash" [:not-run "functional syntax only"]
   "owl2-rl-anonymous-individual" [:pass [:consistency]]
   "owl2-rl-rules-fp-differentFrom" [:fail [:positive]]
    ;; conclusion is owl:differentFrom (needs reasoning by contradiction)
   "owl2-rl-rules-ifp-differentFrom" [:fail [:positive]]
    ;; conclusion is owl:differentFrom (needs reasoning by contradiction)
   "owl2-rl-valid-oneof" [:pass [:consistency]]
   "owl2-rl-valid-rightside-allvaluesfrom" [:pass [:consistency]]
   "string-integer-clash" [:not-run "functional syntax only"]})

(deftest the-w3c-rl-suite-runs-as-pinned
  (let [r (results)]
    (is (= 91 (count r)) "every non-rejected RL test case was read from the manifest")
    (is (= expected r))
    (is (= {:pass 67 :fail 18 :not-run 6} (frequencies (map first (vals r)))))))

(deftest the-passes-come-from-the-rules
  (testing "with no rule evaluated, every inconsistency test fails and no positive entailment passes"
    (let [with (results)
          without (results {:rules #{}})
          passed (fn [r kind] (set (for [[id [o d]] r :when (and (= o :pass) (some #{kind} d))] id)))]
      (is (= 11 (count (passed with :inconsistency))))
      (is (= #{} (passed without :inconsistency)))
      (is (= 10 (count (passed with :positive))))
      (is (= #{} (passed without :positive))))))
