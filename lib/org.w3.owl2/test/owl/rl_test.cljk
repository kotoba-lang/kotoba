(ns owl.rl-test
  "Every rule of `owl.rules/owl2-rl-rules`, evaluated by `owl.rl`.

  Each case is checked three ways, because a conclusion that is present
  proves only that SOMETHING derived it:

  1. positive      -- the fixture entails the conclusion (or, for a rule
                      concluding `false`, is reported inconsistent BY THAT
                      RULE, naming the premise triples);
  2. premise drop  -- removing ANY ONE fixture triple makes the conclusion
                      absent (every premise is load-bearing);
  3. rule drop     -- evaluating without the rule (and without the named
                      rules that derive the same thing another way) makes
                      the conclusion absent, so it was this rule.

  `coverage` fails when an implemented rule has no case here."
  (:require [kotoba.test :refer [deftest is testing]]
            [owl.rl :as rl]
            [owl.rules :as rules]
            [datalog.core :as dc]
            [datom.source :as src]))

(defn- t [s p o] {:s s :p p :o o})

(defn- lst
  "RDF list triples for `members` headed by node `head`."
  [head members]
  (let [nodes (vec (cons head (map #(str head "-" %) (range 1 (count members)))))]
    (vec (mapcat (fn [i m]
                   [(t (nth nodes i) :rdf/first m)
                    (t (nth nodes i) :rdf/rest (if (< (inc i) (count members)) (nth nodes (inc i)) :rdf/nil))])
                 (range) members))))

(defn- lit [lex dt] {:literal lex :datatype dt})

(def cases
  "{:rule id :given [triples] :expect [triples] | :false true, :without #{ids}}"
  [;; ── Table 4 ─────────────────────────────────────────────────────────
   {:rule :eq-sym :given [(t "a" :owl/sameAs "b")] :expect [(t "b" :owl/sameAs "a")]}
   {:rule :eq-trans :given [(t "a" :owl/sameAs "b") (t "b" :owl/sameAs "c")]
    :expect [(t "a" :owl/sameAs "c")] :without #{:eq-trans :eq-rep-o :eq-rep-s}}
   {:rule :eq-rep-s :given [(t "a" :owl/sameAs "b") (t "a" "p" "o")] :expect [(t "b" "p" "o")]}
   {:rule :eq-rep-p :given [(t "p" :owl/sameAs "q") (t "a" "p" "o")] :expect [(t "a" "q" "o")]}
   {:rule :eq-rep-o :given [(t "o" :owl/sameAs "o2") (t "a" "p" "o")] :expect [(t "a" "p" "o2")]}
   {:rule :eq-diff1 :given [(t "a" :owl/sameAs "b") (t "a" :owl/differentFrom "b")] :false true}
   {:rule :eq-diff2 :false true
    :given (into [(t "x" :rdf/type :owl/AllDifferent) (t "x" :owl/members "l") (t "a" :owl/sameAs "b")]
                 (lst "l" ["a" "b"]))}
   {:rule :eq-diff3 :false true
    :given (into [(t "x" :rdf/type :owl/AllDifferent) (t "x" :owl/distinctMembers "l") (t "a" :owl/sameAs "b")]
                 (lst "l" ["a" "b"]))}
   ;; ── Table 5 ─────────────────────────────────────────────────────────
   {:rule :prp-ap :given [] :expect [(t :rdfs/label :rdf/type :owl/AnnotationProperty)
                                     (t :owl/deprecated :rdf/type :owl/AnnotationProperty)]}
   {:rule :prp-dom :given [(t "p" :rdfs/domain "C") (t "a" "p" "b")] :expect [(t "a" :rdf/type "C")]}
   {:rule :prp-rng :given [(t "p" :rdfs/range "C") (t "a" "p" "b")] :expect [(t "b" :rdf/type "C")]}
   {:rule :prp-fp :given [(t "p" :rdf/type :owl/FunctionalProperty) (t "a" "p" "b") (t "a" "p" "c")]
    :expect [(t "b" :owl/sameAs "c") (t "c" :owl/sameAs "b")]}
   {:rule :prp-ifp :given [(t "p" :rdf/type :owl/InverseFunctionalProperty) (t "a" "p" "c") (t "b" "p" "c")]
    :expect [(t "a" :owl/sameAs "b")]}
   {:rule :prp-irp :given [(t "p" :rdf/type :owl/IrreflexiveProperty) (t "a" "p" "a")] :false true}
   {:rule :prp-symp :given [(t "p" :rdf/type :owl/SymmetricProperty) (t "a" "p" "b")] :expect [(t "b" "p" "a")]}
   {:rule :prp-asyp :given [(t "p" :rdf/type :owl/AsymmetricProperty) (t "a" "p" "b") (t "b" "p" "a")] :false true}
   {:rule :prp-trp :given [(t "p" :rdf/type :owl/TransitiveProperty) (t "a" "p" "b") (t "b" "p" "c")]
    :expect [(t "a" "p" "c")]}
   {:rule :prp-spo1 :given [(t "p" :rdfs/subPropertyOf "q") (t "a" "p" "b")] :expect [(t "a" "q" "b")]}
   {:rule :prp-spo2 :given (into [(t "p" :owl/propertyChainAxiom "l") (t "a" "p1" "b") (t "b" "p2" "c")]
                                 (lst "l" ["p1" "p2"]))
    :expect [(t "a" "p" "c")]}
   {:rule :prp-eqp1 :given [(t "p" :owl/equivalentProperty "q") (t "a" "p" "b")] :expect [(t "a" "q" "b")]
    :without #{:prp-eqp1 :scm-eqp1}}
   {:rule :prp-eqp2 :given [(t "p" :owl/equivalentProperty "q") (t "a" "q" "b")] :expect [(t "a" "p" "b")]
    :without #{:prp-eqp2 :scm-eqp1}}
   {:rule :prp-pdw :given [(t "p" :owl/propertyDisjointWith "q") (t "a" "p" "b") (t "a" "q" "b")] :false true}
   {:rule :prp-adp :false true
    :given (into [(t "x" :rdf/type :owl/AllDisjointProperties) (t "x" :owl/members "l")
                  (t "a" "p" "b") (t "a" "q" "b")]
                 (lst "l" ["p" "q"]))}
   {:rule :prp-inv1 :given [(t "p" :owl/inverseOf "q") (t "a" "p" "b")] :expect [(t "b" "q" "a")]}
   {:rule :prp-inv2 :given [(t "p" :owl/inverseOf "q") (t "a" "q" "b")] :expect [(t "b" "p" "a")]}
   {:rule :prp-key
    :given (into [(t "C" :owl/hasKey "l") (t "a" :rdf/type "C") (t "b" :rdf/type "C")
                  (t "a" "p" "v") (t "b" "p" "v") (t "a" "q" "w") (t "b" "q" "w")]
                 (lst "l" ["p" "q"]))
    :expect [(t "a" :owl/sameAs "b")]}
   {:rule :prp-npa1 :false true
    :given [(t "x" :owl/sourceIndividual "a") (t "x" :owl/assertionProperty "p")
            (t "x" :owl/targetIndividual "b") (t "a" "p" "b")]}
   {:rule :prp-npa2 :false true
    :given [(t "x" :owl/sourceIndividual "a") (t "x" :owl/assertionProperty "p")
            (t "x" :owl/targetValue (lit "7" :xsd/integer)) (t "a" "p" (lit "7" :xsd/integer))]}
   ;; ── Table 6 ─────────────────────────────────────────────────────────
   {:rule :cls-thing :given [] :expect [(t :owl/Thing :rdf/type :owl/Class)]}
   {:rule :cls-nothing1 :given [] :expect [(t :owl/Nothing :rdf/type :owl/Class)]}
   {:rule :cls-nothing2 :given [(t "a" :rdf/type :owl/Nothing)] :false true}
   {:rule :cls-int1 :given (into [(t "C" :owl/intersectionOf "l") (t "x" :rdf/type "A") (t "x" :rdf/type "B")]
                                 (lst "l" ["A" "B"]))
    :expect [(t "x" :rdf/type "C")]}
   {:rule :cls-int2 :given (into [(t "C" :owl/intersectionOf "l") (t "x" :rdf/type "C")] (lst "l" ["A" "B"]))
    :expect [(t "x" :rdf/type "A") (t "x" :rdf/type "B")] :without #{:cls-int2 :scm-int}}
   {:rule :cls-uni :given (into [(t "C" :owl/unionOf "l") (t "x" :rdf/type "B")] (lst "l" ["A" "B"]))
    :expect [(t "x" :rdf/type "C")] :without #{:cls-uni :scm-uni}}
   {:rule :cls-com :given [(t "A" :owl/complementOf "B") (t "x" :rdf/type "A") (t "x" :rdf/type "B")] :false true}
   {:rule :cls-svf1 :given [(t "R" :owl/someValuesFrom "C") (t "R" :owl/onProperty "p")
                            (t "a" "p" "b") (t "b" :rdf/type "C")]
    :expect [(t "a" :rdf/type "R")]}
   {:rule :cls-svf2 :given [(t "R" :owl/someValuesFrom :owl/Thing) (t "R" :owl/onProperty "p") (t "a" "p" "b")]
    :expect [(t "a" :rdf/type "R")]}
   {:rule :cls-avf :given [(t "R" :owl/allValuesFrom "C") (t "R" :owl/onProperty "p")
                           (t "a" :rdf/type "R") (t "a" "p" "b")]
    :expect [(t "b" :rdf/type "C")]}
   {:rule :cls-hv1 :given [(t "R" :owl/hasValue "v") (t "R" :owl/onProperty "p") (t "a" :rdf/type "R")]
    :expect [(t "a" "p" "v")]}
   {:rule :cls-hv2 :given [(t "R" :owl/hasValue "v") (t "R" :owl/onProperty "p") (t "a" "p" "v")]
    :expect [(t "a" :rdf/type "R")]}
   {:rule :cls-maxc1 :false true
    :given [(t "R" :owl/maxCardinality 0) (t "R" :owl/onProperty "p") (t "a" :rdf/type "R") (t "a" "p" "b")]}
   {:rule :cls-maxc2
    :given [(t "R" :owl/maxCardinality (lit "1" :xsd/nonNegativeInteger)) (t "R" :owl/onProperty "p")
            (t "a" :rdf/type "R") (t "a" "p" "b") (t "a" "p" "c")]
    :expect [(t "b" :owl/sameAs "c")]}
   {:rule :cls-maxqc1 :false true
    :given [(t "R" :owl/maxQualifiedCardinality 0) (t "R" :owl/onProperty "p") (t "R" :owl/onClass "C")
            (t "a" :rdf/type "R") (t "a" "p" "b") (t "b" :rdf/type "C")]}
   {:rule :cls-maxqc2 :false true
    :given [(t "R" :owl/maxQualifiedCardinality 0) (t "R" :owl/onProperty "p") (t "R" :owl/onClass :owl/Thing)
            (t "a" :rdf/type "R") (t "a" "p" "b")]}
   {:rule :cls-maxqc3
    :given [(t "R" :owl/maxQualifiedCardinality 1) (t "R" :owl/onProperty "p") (t "R" :owl/onClass "C")
            (t "a" :rdf/type "R") (t "a" "p" "b") (t "b" :rdf/type "C") (t "a" "p" "c") (t "c" :rdf/type "C")]
    :expect [(t "b" :owl/sameAs "c")]}
   {:rule :cls-maxqc4
    :given [(t "R" :owl/maxQualifiedCardinality 1) (t "R" :owl/onProperty "p") (t "R" :owl/onClass :owl/Thing)
            (t "a" :rdf/type "R") (t "a" "p" "b") (t "a" "p" "c")]
    :expect [(t "b" :owl/sameAs "c")]}
   {:rule :cls-oo :given (into [(t "C" :owl/oneOf "l")] (lst "l" ["a" "b"]))
    :expect [(t "a" :rdf/type "C") (t "b" :rdf/type "C")]}
   ;; ── Table 7 ─────────────────────────────────────────────────────────
   {:rule :cax-sco :given [(t "A" :rdfs/subClassOf "B") (t "x" :rdf/type "A")] :expect [(t "x" :rdf/type "B")]}
   {:rule :cax-eqc1 :given [(t "A" :owl/equivalentClass "B") (t "x" :rdf/type "A")] :expect [(t "x" :rdf/type "B")]
    :without #{:cax-eqc1 :scm-eqc1}}
   {:rule :cax-eqc2 :given [(t "A" :owl/equivalentClass "B") (t "x" :rdf/type "B")] :expect [(t "x" :rdf/type "A")]
    :without #{:cax-eqc2 :scm-eqc1}}
   {:rule :cax-dw :given [(t "A" :owl/disjointWith "B") (t "x" :rdf/type "A") (t "x" :rdf/type "B")] :false true}
   {:rule :cax-adc :false true
    :given (into [(t "z" :rdf/type :owl/AllDisjointClasses) (t "z" :owl/members "l")
                  (t "x" :rdf/type "A") (t "x" :rdf/type "B")]
                 (lst "l" ["A" "B"]))}
   ;; ── Table 8 ─────────────────────────────────────────────────────────
   {:rule :dt-type1 :given [] :expect [(t :xsd/integer :rdf/type :rdfs/Datatype)
                                       (t :xsd/dateTime :rdf/type :rdfs/Datatype)]}
   {:rule :dt-type2 :given [(t "a" "p" (lit "5" :xsd/integer))]
    :expect [(t (lit "5" :xsd/integer) :rdf/type :xsd/integer)
             (t (lit "5" :xsd/integer) :rdf/type :xsd/decimal)
             (t (lit "5" :xsd/integer) :rdf/type :xsd/byte)]}
   {:rule :dt-eq :given [(t "a" "p" (lit "01" :xsd/integer)) (t "b" "p" (lit "1.0" :xsd/decimal))]
    :expect [(t (lit "01" :xsd/integer) :owl/sameAs (lit "1.0" :xsd/decimal))]}
   {:rule :dt-diff :false true
    :given [(t "age" :rdf/type :owl/FunctionalProperty)
            (t "a" "age" (lit "5" :xsd/integer)) (t "a" "age" (lit "6" :xsd/integer))]}
   {:rule :dt-not-type :false true
    :given [(t "p" :rdfs/range :xsd/integer) (t "a" "p" (lit "abc" :xsd/string))]}
   ;; ── Table 9 ─────────────────────────────────────────────────────────
   {:rule :scm-cls :given [(t "C" :rdf/type :owl/Class)]
    :expect [(t "C" :rdfs/subClassOf "C") (t "C" :owl/equivalentClass "C")
             (t "C" :rdfs/subClassOf :owl/Thing) (t :owl/Nothing :rdfs/subClassOf "C")]}
   {:rule :scm-sco :given [(t "A" :rdfs/subClassOf "B") (t "B" :rdfs/subClassOf "C")]
    :expect [(t "A" :rdfs/subClassOf "C")]}
   {:rule :scm-eqc1 :given [(t "A" :owl/equivalentClass "B")]
    :expect [(t "A" :rdfs/subClassOf "B") (t "B" :rdfs/subClassOf "A")]}
   {:rule :scm-eqc2 :given [(t "A" :rdfs/subClassOf "B") (t "B" :rdfs/subClassOf "A")]
    :expect [(t "A" :owl/equivalentClass "B")]}
   {:rule :scm-op :given [(t "p" :rdf/type :owl/ObjectProperty)]
    :expect [(t "p" :rdfs/subPropertyOf "p") (t "p" :owl/equivalentProperty "p")]}
   {:rule :scm-dp :given [(t "p" :rdf/type :owl/DatatypeProperty)]
    :expect [(t "p" :rdfs/subPropertyOf "p") (t "p" :owl/equivalentProperty "p")]}
   {:rule :scm-spo :given [(t "p" :rdfs/subPropertyOf "q") (t "q" :rdfs/subPropertyOf "r")]
    :expect [(t "p" :rdfs/subPropertyOf "r")]}
   {:rule :scm-eqp1 :given [(t "p" :owl/equivalentProperty "q")]
    :expect [(t "p" :rdfs/subPropertyOf "q") (t "q" :rdfs/subPropertyOf "p")]}
   {:rule :scm-eqp2 :given [(t "p" :rdfs/subPropertyOf "q") (t "q" :rdfs/subPropertyOf "p")]
    :expect [(t "p" :owl/equivalentProperty "q")]}
   {:rule :scm-dom1 :given [(t "p" :rdfs/domain "A") (t "A" :rdfs/subClassOf "B")] :expect [(t "p" :rdfs/domain "B")]}
   {:rule :scm-dom2 :given [(t "q" :rdfs/domain "A") (t "p" :rdfs/subPropertyOf "q")] :expect [(t "p" :rdfs/domain "A")]}
   {:rule :scm-rng1 :given [(t "p" :rdfs/range "A") (t "A" :rdfs/subClassOf "B")] :expect [(t "p" :rdfs/range "B")]}
   {:rule :scm-rng2 :given [(t "q" :rdfs/range "A") (t "p" :rdfs/subPropertyOf "q")] :expect [(t "p" :rdfs/range "A")]}
   {:rule :scm-hv :given [(t "R1" :owl/hasValue "v") (t "R1" :owl/onProperty "p")
                          (t "R2" :owl/hasValue "v") (t "R2" :owl/onProperty "q") (t "p" :rdfs/subPropertyOf "q")]
    :expect [(t "R1" :rdfs/subClassOf "R2")]}
   {:rule :scm-svf1 :given [(t "R1" :owl/someValuesFrom "A") (t "R1" :owl/onProperty "p")
                            (t "R2" :owl/someValuesFrom "B") (t "R2" :owl/onProperty "p") (t "A" :rdfs/subClassOf "B")]
    :expect [(t "R1" :rdfs/subClassOf "R2")]}
   {:rule :scm-svf2 :given [(t "R1" :owl/someValuesFrom "A") (t "R1" :owl/onProperty "p")
                            (t "R2" :owl/someValuesFrom "A") (t "R2" :owl/onProperty "q") (t "p" :rdfs/subPropertyOf "q")]
    :expect [(t "R1" :rdfs/subClassOf "R2")]}
   {:rule :scm-avf1 :given [(t "R1" :owl/allValuesFrom "A") (t "R1" :owl/onProperty "p")
                            (t "R2" :owl/allValuesFrom "B") (t "R2" :owl/onProperty "p") (t "A" :rdfs/subClassOf "B")]
    :expect [(t "R1" :rdfs/subClassOf "R2")]}
   {:rule :scm-avf2 :given [(t "R1" :owl/allValuesFrom "A") (t "R1" :owl/onProperty "p")
                            (t "R2" :owl/allValuesFrom "A") (t "R2" :owl/onProperty "q") (t "p" :rdfs/subPropertyOf "q")]
    :expect [(t "R2" :rdfs/subClassOf "R1")]}
   {:rule :scm-int :given (into [(t "C" :owl/intersectionOf "l")] (lst "l" ["A" "B"]))
    :expect [(t "C" :rdfs/subClassOf "A") (t "C" :rdfs/subClassOf "B")]}
   {:rule :scm-uni :given (into [(t "C" :owl/unionOf "l")] (lst "l" ["A" "B"]))
    :expect [(t "A" :rdfs/subClassOf "C") (t "B" :rdfs/subClassOf "C")]}])

(defn- holds?
  "Does the case's conclusion hold in the result `r`?"
  [c r]
  (if (:false c)
    (boolean (some #(= (:rule c) (:rule %)) (:inconsistencies r)))
    (every? #(contains? (:graph r) %) (:expect c))))

(defn- run [triples opts] (rl/entail triples opts))

(deftest every-rule-positive-and-both-controls
  (doseq [c cases]
    (testing (name (:rule c))
      (let [r (run (:given c) {})]
        (is (holds? c r) (str (:rule c) ": positive fixture"))
        (when (:false c)
          (let [hit (first (filter #(= (:rule c) (:rule %)) (:inconsistencies r)))]
            (is (false? (:consistent? r)))
            (is (seq (:triples hit)) (str (:rule c) ": names its premise triples"))
            (is (every? #(and (contains? % :s) (contains? % :p) (contains? % :o)) (:triples hit))))))
      (doseq [drop-i (range (count (:given c)))]
        (let [given (vec (concat (subvec (vec (:given c)) 0 drop-i) (subvec (vec (:given c)) (inc drop-i))))]
          (is (not (holds? c (run given {})))
              (str (:rule c) ": still holds without premise " (pr-str (nth (:given c) drop-i))))))
      (let [without (or (:without c) #{(:rule c)})]
        (is (not (holds? c (run (:given c) {:rules (apply disj rules/supported-rules without)})))
            (str (:rule c) ": still holds without rules " (pr-str without)))))))

(deftest coverage
  (testing "every evaluated rule has a case; every other rule says why"
    (let [covered (set (map :rule cases))]
      (is (= #{} (reduce disj rules/supported-rules covered)) "supported rules with no case")
      (doseq [r rules/owl2-rl-rules :when (not= :implemented (:status r))]
        (is (string? (:reason r)) (str (:id r) " has no :reason")))
      (is (= #{:eq-ref} (set (keep #(when (= :omitted (:status %)) (:id %)) rules/owl2-rl-rules)))))))

;; ── rule-specific edges ─────────────────────────────────────────────────

(deftest eq-ref-is-not-materialized-but-its-violation-is-reported
  (let [r (run [(t "a" :owl/differentFrom "a")] {})]
    (is (not (contains? (:graph r) (t "a" :owl/sameAs "a"))))
    (is (= [:eq-diff1] (map :rule (:inconsistencies r)))))
  (testing "a member listed twice in AllDifferent"
    (let [r (run (into [(t "x" :rdf/type :owl/AllDifferent) (t "x" :owl/members "l")] (lst "l" ["a" "a"])) {})]
      (is (= [:eq-diff2] (map :rule (:inconsistencies r)))))))

(deftest no-reflexive-sameas-is-derived
  (testing "eq-ref is omitted, so prp-fp/ifp/key and cls-maxc2/maxqc3/4 never conclude x sameAs x"
    (doseq [c cases]
      (is (= [] (filter #(and (= :owl/sameAs (:p %)) (= (:s %) (:o %))) (:inferred (run (:given c) {}))))
          (str (:rule c))))))

(deftest cardinality-other-than-0-or-1-derives-nothing
  (let [r (run [(t "R" :owl/maxCardinality 2) (t "R" :owl/onProperty "p")
                (t "a" :rdf/type "R") (t "a" "p" "b") (t "a" "p" "c")] {})]
    (is (not (contains? (:graph r) (t "b" :owl/sameAs "c"))))
    (is (:consistent? r)))
  (testing "maxCardinality 0 as a typed literal"
    (is (false? (:consistent? (run [(t "R" :owl/maxCardinality (lit "0" :xsd/nonNegativeInteger))
                                    (t "R" :owl/onProperty "p") (t "a" :rdf/type "R") (t "a" "p" "b")] {}))))))

(deftest datatypes
  (testing "an ill-typed lexical form is reported, a well-typed one is not"
    (is (= [:dt-not-type] (map :rule (:inconsistencies (run [(t "a" "p" (lit "abc" :xsd/integer))] {})))))
    (is (:consistent? (run [(t "a" "p" (lit "-0042" :xsd/integer))] {}))))
  (testing "value space membership, not datatype name"
    (let [g (:graph (run [(t "a" "p" (lit "300" :xsd/integer))] {}))
          l (lit "300" :xsd/integer)]
      (is (contains? g (t l :rdf/type :xsd/short)))
      (is (not (contains? g (t l :rdf/type :xsd/byte))) "300 is outside xsd:byte")
      (is (not (contains? g (t l :rdf/type :xsd/string))))))
  (testing "dateTime: equal instants in different zones are one value"
    (let [a (lit "2026-09-25T09:00:00+09:00" :xsd/dateTime)
          b (lit "2026-09-25T00:00:00Z" :xsd/dateTime)
          g (:graph (run [(t "x" "at" a) (t "y" "at" b)] {}))]
      (is (contains? g (t a :owl/sameAs b)))))
  (testing "a zoned and a local dateTime are different values"
    (let [r (run [(t "age" :rdf/type :owl/FunctionalProperty)
                  (t "x" "age" (lit "2026-09-25T00:00:00Z" :xsd/dateTime))
                  (t "x" "age" (lit "2026-09-25T00:00:00" :xsd/dateTime))] {})]
      (is (some #{:dt-diff} (map :rule (:inconsistencies r))))))
  (testing "Feb 29 only in a leap year"
    (is (:consistent? (run [(t "a" "p" (lit "2024-02-29T00:00:00Z" :xsd/dateTime))] {})))
    (is (not (:consistent? (run [(t "a" "p" (lit "2026-02-29T00:00:00Z" :xsd/dateTime))] {})))))
  (testing "IRI datatypes are the same datatypes"
    (let [l (lit "5" "http://www.w3.org/2001/XMLSchema#integer")]
      (is (contains? (:graph (run [(t "a" "p" l)] {})) (t l :rdf/type :xsd/integer))))))

(deftest malformed-lists-are-diagnosed-not-silently-empty
  (let [r (run [(t "C" :owl/intersectionOf "l") (t "l" :rdf/first "A")] {})]
    (is (= 1 (count (distinct (map :list (get-in r [:diagnostics :malformed-lists]))))))
    (is (= "l" (:list (first (get-in r [:diagnostics :malformed-lists])))))))

(deftest schema-entailments-are-emitted-and-can-be-switched-off
  (let [triples [(t "Cat" :rdfs/subClassOf "Mammal") (t "Mammal" :rdfs/subClassOf "Animal")
                 (t "hasMother" :rdfs/subPropertyOf "hasParent") (t "hasParent" :rdfs/domain "Mammal")]
        on (:graph (run triples {}))
        off (:graph (run triples {:schema? false}))]
    (is (contains? on (t "Cat" :rdfs/subClassOf "Animal")) "scm-sco closure is in the graph")
    (is (contains? on (t "hasMother" :rdfs/domain "Mammal")) "scm-dom2")
    (is (contains? on (t "hasParent" :rdfs/domain "Animal")) "scm-dom1")
    (is (not (contains? off (t "Cat" :rdfs/subClassOf "Animal"))))))

(deftest vocabulary
  (testing "the IRI vocabulary answers the same and returns IRIs"
    (let [iri rules/term-iri
          r (run [(t "Cat" (iri :rdfs/subClassOf) "Animal") (t "Felix" (iri :rdf/type) "Cat")]
                 {:vocabulary rules/rl-iri-vocabulary})]
      (is (contains? (:graph r) (t "Felix" (iri :rdf/type) "Animal")))
      (is (not-any? #(= :rdf/type (:p %)) (:graph r)) "no keyword leaks into an IRI graph")))
  (testing "a mixed vocabulary (keywords for some terms, IRIs for the rest)"
    (let [v (merge rules/rl-iri-vocabulary {:rdf/type :rdf/type :rdfs/subClassOf :rdfs/subClassOf})
          r (run (into [(t "C" (rules/term-iri :owl/intersectionOf) "l") (t "x" :rdf/type "A") (t "x" :rdf/type "B")]
                       (map (fn [{:keys [s p o]}] (t s (rules/term-iri p) (if (= o :rdf/nil) (rules/term-iri :rdf/nil) o)))
                            (lst "l" ["A" "B"])))
                 {:vocabulary v})]
      (is (contains? (:graph r) (t "x" :rdf/type "C")))))
  (testing "a vocabulary that maps two terms to one is refused"
    (is (thrown? #?(:clj clojure.lang.ExceptionInfo :cljs js/Error)
                 (run [] {:vocabulary (assoc rules/rl-keyword-vocabulary :owl/sameAs :rdf/type)}))))
  (testing "an unsupported rule id is refused, not ignored"
    (is (thrown? #?(:clj clojure.lang.ExceptionInfo :cljs js/Error)
                 (run [] {:rules #{:eq-ref}})))))

(deftest materialize-throws-structured-on-inconsistency
  (is (= #{(t "x" :rdf/type "A") (t "x" :rdf/type "B")}
         (set (filter #(= "x" (:s %)) (rl/materialize [(t "A" :rdfs/subClassOf "B") (t "x" :rdf/type "A")]))))
      "consistent: the asserted type plus the derived one")
  (let [e (try (rl/materialize [(t "x" :rdf/type :owl/Nothing)]) nil
               (catch #?(:clj clojure.lang.ExceptionInfo :cljs :default) e e))]
    (is (some? e))
    (is (= [:cls-nothing2] (map :rule (:inconsistencies (ex-data e)))))))

(deftest capability-lists
  (is (contains? rules/supported-vocabulary "http://www.w3.org/2002/07/owl#propertyChainAxiom"))
  (is (not (contains? rules/supported-vocabulary "http://www.w3.org/2002/07/owl#minCardinality")))
  (is (= {:unsupported "no RL rule (existential; outside the RL profile)"}
         (get rules/vocabulary-status "http://www.w3.org/2002/07/owl#minCardinality")))
  (is (contains? rules/supported-rules :prp-spo2))
  (is (not (contains? rules/supported-rules :eq-ref)))
  (is (= [9 20 19 5 5 20] (map #(count (filter (fn [r] (= % (:table r))) rules/owl2-rl-rules)) [4 5 6 7 8 9])) "Tables 4-9 of OWL 2 Profiles §4.3: 78 rules"))

;; ── cross-engine: the legacy Datalog rules are a subset of the RL closure ──

(defn- legacy-closure
  "What oak's 2-arity materialize returns: triple-rules through Datalog."
  [triples]
  (let [db (src/of-quads (set triples))
        rs (rules/triple-rules)
        q (fn [query] (dc/q db (assoc query :rules rs) (constantly true)))]
    (into (set triples)
          (concat (map (fn [[s p o]] (t s p o)) (q '{:find [?s ?p ?o] :where [(owl-triple ?s ?p ?o)]}))
                  (map (fn [[s c]] (t s :rdf/type c)) (q '{:find [?s ?c] :where [(owl-type ?s ?c)]}))))))

(deftest legacy-datalog-closure-is-contained-in-the-rl-closure
  (let [fixture [(t "partOf" :rdf/type :owl/TransitiveProperty) (t "partOf" :owl/inverseOf "hasPart")
                 (t "Wheel" "partOf" "Car") (t "Car" "partOf" "Fleet") (t "Fleet" "partOf" "Company")
                 (t "knows" :rdf/type :owl/SymmetricProperty) (t "Alice" "knows" "Beth")
                 (t "hasMother" :rdfs/subPropertyOf "hasParent") (t "hasParent" :rdfs/domain "Person")
                 (t "hasParent" :rdfs/range "Person") (t "Person" :rdfs/subClassOf "Agent")
                 (t "Feline" :owl/equivalentClass "Cat") (t "Cat" :rdfs/subClassOf "Mammal")
                 (t "Alice" "hasMother" "Carol") (t "Felix" :rdf/type "Feline")]
        legacy (legacy-closure fixture)
        full (:graph (run fixture {}))]
    (is (< 15 (count legacy)) "the legacy closure derived something")
    (is (= #{} (reduce disj legacy full)) "legacy triples missing from the RL closure")
    (is (= legacy (reduce disj (:graph (run fixture {:schema? false
                                                     :rules #{:prp-spo1 :prp-dom :prp-rng :prp-trp :prp-symp
                                                              :prp-inv1 :prp-inv2 :cax-sco :cax-eqc1 :cax-eqc2}}))
                          []))
        "restricted to the legacy rules, the RL evaluator reproduces the legacy closure exactly")))
