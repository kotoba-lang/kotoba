{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:repository.etzhayyim.com",
  "name": "repository",
  "nanoid": "r3p0s1t0",
  "performerType": "service",
  "runtimeType": "worker",
  "sensitivity": "internal",
  "source": "custom",
  "version": "0.1.0",
  "build": { "guestLanguage": "ts" },
  "component": { "path": "src/app.ts" },
  "profile": {
    "displayName": "Repository — Git Object Graph + FaaS Dispatch",
    "description": "ADR-0039 git object model over Actor DID. Content-addressed blob/tree/commit storage + ref dispatch + commit ES256 signature verify. FaaS build trigger for Cloudflare Workers for Platforms. 12 XRPC methods + 1 firehose record type (com.etzhayyim.repository.*).",
    "isBot": true,
    "agentType": "autonomous",
    "operator": "etzhayyim.com",
    "capabilities": [
      "repository-object-store",
      "repository-ref-dispatch",
      "repository-history-query",
      "commit-es256-verify",
      "faas-build-dispatch"
    ]
  },
  "interfaces": {
    "package": "etzhayyim:repository@0.1.0",
    "requires": [
      "etzhayyim:collection/collection@1.0.0"
    ]
  },
  "governance": {
    "raci": "responsible",
    "classification": "internal",
    "complianceFrameworks": ["repository-policy"]
  },
  "convoSystemPrompt": "You are the Repository actor — a git object-model graph over Actor DID. You accept blob / tree / commit writes (content-addressed, signed ES256) and expose ref dispatch as the only mutable write point. Every updateRef emits an com.etzhayyim.repository.refUpdate record to firehose and triggers the FaaS build runner for Cloudflare Workers for Platforms. You never serve user-script bytes yourself — that is the WFP dispatcher's role. You are the SSoT of source code in the etzhayyim graph.",
  "duties": ["勤労の義務", "content-hash-integrity", "signature-verification"],
  "kpi": ["credits の獲得", "ref-update-success-rate", "signature-verify-rate"],
  "deploy": {},
  "routes": [
    { "host": "repository.etzhayyim.com", "paths": ["/"], "tls": true }
  ],
  "space": {
    "name": "Repository Graph",
    "description": "Git object model (blob/tree/commit/ref) over Actor DID — code SSoT for FaaS dispatch",
    "joinRule": "public",
    "historyVisibility": "world-readable",
    "channels": [
      { "name": "ref-updates", "kind": "public", "default": true, "description": "Ref fast-forward / rollback / force-push events (firehose)" },
      { "name": "build-dispatch", "kind": "public", "description": "CF Workers for Platforms build + upload events" }
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow",
        "com.etzhayyim.repository.refUpdate"
      ]
    }
  },
  "ui": {
    "accent": "#475569",
    "icon": "📦",
    "ssrRoutes": {}
  },
  "uiType": "appview"
}
