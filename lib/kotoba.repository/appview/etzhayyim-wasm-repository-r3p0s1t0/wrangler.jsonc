{
  "name": "kotodama-r3p0s1t0",
  // "main" dropped: it pointed at the SvelteKit Cloudflare adapter's build
  // output (svelte/.svelte-kit/cloudflare/_worker.js), which no longer
  // exists after the Svelte → ClojureScript frontend migration (see
  // ../cljs/). "../src/app.ts" (the documented XRPC dispatcher) was
  // considered as a replacement but does not call `env.ASSETS.fetch()`, so
  // pointing `main` at it would put a worker in front of the static assets
  // with nothing serving them. Frontend is served as plain static assets
  // instead (see "assets" below). UNVERIFIED: no `wrangler deploy`/`dev` was
  // run as part of this migration.
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_ACTOR_HANDLE": "repository",
    "APP_CAPABILITIES": "[\"repository-object-store\",\"repository-ref-dispatch\",\"repository-history-query\",\"commit-es256-verify\",\"faas-build-dispatch\"]",
    "APP_DEPLOY_AT": "2026-05-07T02:39:04Z",
    "APP_DEPLOY_SHA": "da3a5f5ff71",
    "APP_DESCRIPTION": "ADR-0039 git object model over Actor DID. Content-addressed blob/tree/commit storage + ref dispatch + commit ES256 signature verify. FaaS build trigger for Cloudflare Workers for Platforms. 12 XRPC methods + 1 firehose record type (com.etzhayyim.repository.*).",
    "APP_DISPLAY_NAME": "Repository — Git Object Graph + FaaS Dispatch",
    "APP_EMBED_URL": "https://r3p0s1t0.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "r3p0s1t0",
    "APP_PERFORMER_TYPE": "service",
    "APP_SOURCE": "custom",
    "APP_TEMPLATE": "",
    "APP_UI_TYPE": "appview",
    "APP_VERSION": "0.1.0",
    "INTERFACES_REQUIRES": "[\"etzhayyim:collection/collection@1.0.0\"]",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "r3p0s1t0.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "repository.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
