{
  "@context": [
    "https://schema.org/",
    {
      "etzhayyim": "https://etzhayyim.com/schemas/",
      "capabilities": "etzhayyim:capabilities",
      "survivalIndicators": "etzhayyim:survivalIndicators",
      "scheduler": "etzhayyim:scheduler",
      "dependsOn": { "@id": "etzhayyim:dependsOn", "@type": "@id" },
      "ingestKey": "etzhayyim:ingestKey",
      "window": "etzhayyim:window",
      "valueUpdatedAt": "etzhayyim:valueUpdatedAt"
    }
  ],
  "@type": "Project",
  "identifier": "etzhayyim-project-repository",
  "name": "etzhayyim project repository",
  "status": "Proposed",
  "description": "ADR-0039 Repository-in-Graph — git object model (blob/tree/commit/ref) over Actor DID. Backs repository.etzhayyim.com. Source code + actor manifest FaaS via Cloudflare Workers for Platforms.",
  "capabilities": {
    "@type": "DefinedTermSet",
    "name": "Capabilities",
    "description": "Capabilities owned by this project (CV-1).",
    "terms": [
      { "@type": "DefinedTerm", "identifier": "repository-object-store", "name": "Repository Object Store", "description": "Content-addressed blob / tree / commit ingest and retrieval." },
      { "@type": "DefinedTerm", "identifier": "repository-ref-dispatch", "name": "Repository Ref Dispatch", "description": "Mutable ref pointer — sole atomic write point for rollback / fast-forward / force." },
      { "@type": "DefinedTerm", "identifier": "repository-history-query", "name": "Repository History Query", "description": "log / diff / blame over the commit DAG." },
      { "@type": "DefinedTerm", "identifier": "commit-es256-verify", "name": "Commit ES256 Verification", "description": "Author DID signature verify on createCommit and getCommit." },
      { "@type": "DefinedTerm", "identifier": "faas-build-dispatch", "name": "FaaS Build Dispatch", "description": "ref update → CF Container build runner → Workers for Platforms user-script upload." }
    ]
  },
  "survivalIndicators": [
    { "@type": "PropertyValue", "identifier": "requests", "name": "Requests", "description": "Request count (traffic) as a basic survival indicator.", "unitText": "count", "value": null, "ingestKey": "requests", "window": "1d", "valueUpdatedAt": null },
    { "@type": "PropertyValue", "identifier": "gccCredit", "name": "GCC Credit", "description": "GCC credit balance as a basic survival indicator.", "unitText": "GCC", "value": null, "ingestKey": "gccCredit", "window": "1d", "valueUpdatedAt": null }
  ],
  "dependsOn": [
    "90-docs/adr/0039-repository-in-graph-faas.md",
    "90-docs/adr/0019-atproto-native-identifier-topology.md",
    "90-docs/adr/0010-per-did-signing-key-custody.md",
    "90-docs/adr/0002-persistence-risingwave-graphar.md",
    "00-contracts/lexicons/com/etzhayyim/repository/"
  ]
}
