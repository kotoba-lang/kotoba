{
  "schema_version": "kotoba.eval.suite.v1",
  "suite_id": "kotoba-agent-code-v1",
  "task_id": "turn-loop-remaining-budget",
  "baseline_revision": "03094b7ebd6e00f4bd8a0b8a1b4acba7e880bcd6",
  "task_file": "eval/v1/tasks/turn-loop-remaining-budget.md",
  "required_stages": 2,
  "required_session_behavior": "resume the same session for stage 2",
  "acceptance": {
    "verifier": "scripts/verify-turn-loop-parity.cljk",
    "targets": ["js-browser", "wasm32-browser"],
    "oracle_vectors": 10,
    "exact_all_cases_required": true,
    "forbidden_forms_allowed": false
  },
  "budgets": {
    "elapsed_ms": 300000,
    "total_tokens": 24000
  },
  "reward": {
    "correctness_gate": "syntax_pass && compile_pass && acceptance_passed == acceptance_total && no_forbidden_forms",
    "incorrect_reward": 0,
    "formula": "60 + 20 * max(0, 1 - elapsed_ms / 300000) + 10 * max(0, 1 - (input_tokens + output_tokens) / 24000) + 10 * session_continuity",
    "session_continuity": "1 when session_count == 1 and same_session_resume == true; otherwise 0"
  },
  "privacy": {
    "persist_aggregate_metrics_only": true,
    "never_include": ["prompt", "response", "transcript", "patch", "source_dump", "session_id", "credentials"]
  }
}
