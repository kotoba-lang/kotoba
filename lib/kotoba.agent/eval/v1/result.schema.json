{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kotoba-lang.org/schemas/kotoba.eval.result.v1.json",
  "title": "Kotoba coding evaluation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite", "task", "agent", "environment", "verification", "metrics"],
  "properties": {
    "schema_version": { "const": "kotoba.eval.result.v1" },
    "suite": { "const": "kotoba-agent-code-v1" },
    "task": { "const": "turn-loop-remaining-budget" },
    "run_id": { "type": "string", "maxLength": 80 },
    "run_status": { "enum": ["completed", "agent_incomplete", "infrastructure_failure", "timed_out", "telemetry_incomplete"] },
    "failure_stage": { "type": ["string", "null"] },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "model"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "compiler_revision", "task_sha256", "skill_sha256", "host_class", "os", "arch"],
      "properties": {
        "source_revision": { "type": "string", "minLength": 1 },
        "baseline_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "compiler_revision": { "type": "string", "minLength": 1 },
        "task_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "skill_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "verifier_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evaluation_readme_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "host_class": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syntax_pass", "compile_pass", "acceptance_passed", "acceptance_total", "no_forbidden_forms", "verifier", "targets"],
      "properties": {
        "syntax_pass": { "type": "boolean" },
        "compile_pass": { "type": "boolean" },
        "acceptance_passed": { "type": "integer", "minimum": 0 },
        "acceptance_total": { "const": 10 },
        "no_forbidden_forms": { "type": "boolean" },
        "verifier": { "const": "scripts/verify-turn-loop-parity.cljk" },
        "targets": { "const": ["js-browser", "wasm32-browser"] }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsed_ms", "input_tokens", "output_tokens", "session_count", "same_session_resume", "turn_count", "shell_command_calls", "retry_count", "infrastructure_failures", "preflight_failures", "telemetry_source"],
      "properties": {
        "elapsed_ms": { "type": ["integer", "null"], "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "session_count": { "type": ["integer", "null"], "minimum": 1 },
        "same_session_resume": { "type": ["boolean", "null"] },
        "turn_count": { "type": "integer", "minimum": 0 },
        "shell_command_calls": { "type": "integer", "minimum": 0 },
        "api_calls": { "type": ["integer", "null"], "minimum": 0 },
        "retry_count": { "type": "integer", "minimum": 0 },
        "infrastructure_failures": { "type": "integer", "minimum": 0 },
        "preflight_failures": { "type": "integer", "minimum": 0 },
        "telemetry_source": { "type": "string", "minLength": 1 }
      }
    }
  },
  "not": {
    "anyOf": [
      { "required": ["transcript"] },
      { "required": ["prompt"] },
      { "required": ["response"] },
      { "required": ["session_id"] },
      { "required": ["patch"] }
    ]
  }
}
