(ns agent.bounded-run
  (:export [valid-goal? new-run transition-allowed? advance
            active? terminal? resumable? main])
  (:schemas
   {:agent/run
    [:record :agent/run
     [[:goal :string]
      [:status :keyword]
      [:created-at :i64]
      [:updated-at :i64]
      [:attempt :i64]]]}))

;; Sovereign lifecycle kernel. IDs, clocks, storage, execution, and capability
;; grants are inputs owned by providers; this module only owns deterministic
;; run state and its legal transitions.

(defn- code-point-width [value :i64] :i64
  (if (< value 128) 1
    (if (< value 2048) 2
      (if (< value 65536) 3 4))))

;; Matches the whitespace family used by JVM Character/isWhitespace and
;; clojure.string/blank?: ASCII controls, Unicode separators, line/paragraph
;; separators, medium mathematical space, and ideographic space. Deliberately
;; excludes non-breaking spaces, as the JVM oracle does.
(defn- whitespace-code-point? [value :i64] :bool
  (if (or (and (>= value 9) (<= value 13))
          (and (>= value 28) (<= value 32))
          (= value 5760)
          (and (>= value 8192) (<= value 8198))
          (and (>= value 8200) (<= value 8202))
          (= value 8232)
          (= value 8233)
          (= value 8287)
          (= value 12288)) true false))

(defn- nonblank-from [goal :string offset :i64 size :i64] :i64
  (if (>= offset size)
    0
    (let [value (string-code-point-at goal offset)]
      (if (whitespace-code-point? value)
        (nonblank-from goal (+ offset (code-point-width value)) size)
        1))))

(defn valid-goal? [goal :string] :bool
  (if (= 1 (nonblank-from goal 0 (string-byte-length goal))) true false))

(defn new-run [goal :string now-ms :i64] [:ref :agent/run]
  (record-new [:ref :agent/run] goal :queued now-ms now-ms 0))

(defn transition-allowed? [from :keyword to :keyword] :bool
  (if (= from :queued)
    (if (or (= to :leased) (= to :cancelled)) true false)
    (if (= from :leased)
      (if (or (= to :running)
              (= to :queued)
              (= to :failed)
              (= to :cancelled)) true false)
      (if (= from :running)
        (if (or (= to :checkpointed)
                (= to :held)
                (= to :succeeded)
                (= to :failed)
                (= to :cancelled)) true false)
        (if (= from :checkpointed)
          (if (or (= to :leased)
                  (= to :running)
                  (= to :held)
                  (= to :succeeded)
                  (= to :failed)
                  (= to :cancelled)) true false)
          (if (= from :held)
            (if (or (= to :leased)
                    (= to :running)
                    (= to :rejected)
                    (= to :cancelled)) true false)
            (if (= from :failed)
              (if (= to :queued) true false)
              false)))))))

(defn advance [run [:ref :agent/run] to :keyword now-ms :i64]
  [:ref :agent/run]
  (let [from (record-get [:ref :agent/run] run :status)
        allowed (transition-allowed? from to)
        next-status (if allowed to from)
        next-time (if allowed
                    now-ms
                    (record-get [:ref :agent/run] run :updated-at))
        attempt (record-get [:ref :agent/run] run :attempt)
        next-attempt (if (and allowed (= to :leased))
                       (+ attempt 1)
                       attempt)]
    (record-new
     [:ref :agent/run]
     (record-get [:ref :agent/run] run :goal)
     next-status
     (record-get [:ref :agent/run] run :created-at)
     next-time
     next-attempt)))

(defn active? [run [:ref :agent/run]] :bool
  (let [status (record-get [:ref :agent/run] run :status)]
    (if (or (= status :queued)
            (= status :leased)
            (= status :running)
            (= status :checkpointed)
            (= status :held)) true false)))

(defn terminal? [run [:ref :agent/run]] :bool
  (let [status (record-get [:ref :agent/run] run :status)]
    (if (or (= status :succeeded)
            (= status :failed)
            (= status :rejected)
            (= status :cancelled)) true false)))

(defn resumable? [run [:ref :agent/run]] :bool
  (let [status (record-get [:ref :agent/run] run :status)]
    (if (or (= status :failed)
            (= status :checkpointed)
            (= status :held)) true false)))

(defn main [] :i64
  (let [r0 (new-run "finish bounded migration" 1000)
        r1 (advance r0 :leased 1010)
        r2 (advance r1 :running 1020)
        r3 (advance r2 :succeeded 1100)
        r4 (advance r3 :queued 1200)]
    (if (valid-goal? " \t\n")
      5
      (if (valid-goal? (record-get [:ref :agent/run] r4 :goal))
        (if (= (record-get [:ref :agent/run] r4 :attempt) 1)
          (if (terminal? r4)
            (if (= (record-get [:ref :agent/run] r4 :status) :succeeded) 42 4)
            3)
          2)
        1))))
