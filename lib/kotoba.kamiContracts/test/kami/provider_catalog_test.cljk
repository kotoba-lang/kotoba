(ns kami.provider-catalog-test
  (:require [kotoba.lang.edn :as edn]
            [clojure.java.io :as io]
            [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]]
            [kami.provider-catalog :as catalog]))

(defn- file-exists? [& parts]
  (.exists (apply io/file parts)))

(defn- local-split-contract-file [split-to]
  (io/file ".." (last (str/split split-to #"/"))
           "resources" "kami" "provider" "split_contract.edn"))

(def materialized-split-kinds
  #{:wasm-component-provider :component-runtime-provider :edn-fixture-provider})

(deftest provider-catalog-contract
  (testing "validates Kotoba CLJ provider families as Wasm Component components"
    (let [provider-catalog (catalog/load-provider-catalog)]
      (is (catalog/provider-catalog? provider-catalog))
      (is (= {:valid? true :errors []}
             (catalog/validate-provider-catalog provider-catalog)))))
  (testing "rejects catalogs that make Rust or WIT authority"
    (let [result (catalog/validate-provider-catalog
	                  {:kami/catalog :provider-catalog
	                   :kami/authority [:rust]
	                   :kami/adapter :native
	                   :kami/runtime :rust-adapters
	                   :kami/provider-families
	                   [{:kami/family :render
	                     :kami/world :kami/render
	                     :kami/authority-repo ""
	                     :kami/split-to "orgs/kotoba-lang/kami-engine"
	                     :kami/provider-namespaces []}]})]
      (is (false? (:valid? result)))
      (is (some #(= [:kami/authority] (:path %)) (:errors result)))
      (is (some #(= [:kami/adapter] (:path %)) (:errors result)))
      (is (some #(= [:kami/runtime] (:path %)) (:errors result)))
      (is (some #(= [:kami/provider-families 0 :kami/authority-repo] (:path %)) (:errors result)))
      (is (some #(= [:kami/provider-families 0 :kami/provider-namespaces] (:path %))
                (:errors result))))))

(deftest provider-catalog-workspace-coverage
  (testing "current Cargo workspace members are tracked only as legacy Rust debt"
    (let [provider-catalog (catalog/load-provider-catalog)]
      (is (= {:valid? true :errors []}
             (catalog/validate-workspace-coverage provider-catalog)))))
  (testing "app fixture players are fixture-repo consumers, not kami-engine workspace members"
    (let [members (catalog/cargo-workspace-members)]
      (is (not (contains? members "kami-clj-play")))
      (is (not (contains? members "kami-clj-play3d")))))
  (testing "missing Cargo workspace is the desired Kotoba CLJ-only state"
    (is (= #{} (catalog/cargo-workspace-members "../kami-engine/Cargo.toml")))))

(deftest provider-boundary-artifacts
  (testing "provider family boundaries are generated from catalog plus component worlds"
    (let [provider-catalog (catalog/load-provider-catalog)
          boundaries (catalog/load-provider-boundaries)]
      (is (= boundaries (catalog/provider-boundaries provider-catalog)))
      (is (catalog/provider-boundaries? boundaries provider-catalog))
      (is (= {:valid? true :errors []}
             (catalog/validate-provider-boundaries boundaries provider-catalog)))))
  (testing "rejects Rust-owned or drifted provider boundaries"
    (let [provider-catalog (catalog/load-provider-catalog)
          result (catalog/validate-provider-boundaries
                  [{:kami/family :render
                    :kami/world :kami/render
	                    :kami/authority :rust
	                    :kami/adapter :native
	                    :kami/imports []
	                    :kami/exports []
	                    :kami/provider-namespaces ["kami.providers.render"]}]
                  provider-catalog)]
      (is (false? (:valid? result)))
      (is (some #(= [:kami/provider-boundaries 0 :kami/authority] (:path %)) (:errors result)))
      (is (some #(= [:kami/provider-boundaries 0 :kami/adapter] (:path %)) (:errors result)))
      (is (some #(= [:kami/provider-boundaries 0 :kami/imports] (:path %)) (:errors result)))
      (is (some #(= [:kami/provider-boundaries 0 :kami/exports] (:path %)) (:errors result)))
      (is (some #(= [] (:path %)) (:errors result))))))

(deftest provider-split-repo-artifacts
  (testing "provider split repos are generated from the provider catalog"
    (let [provider-catalog (catalog/load-provider-catalog)
          split-repos (catalog/load-provider-split-repos)]
      (is (= split-repos (catalog/provider-split-repos provider-catalog)))
      (is (catalog/provider-split-repos? split-repos provider-catalog))
      (is (= {:valid? true :errors []}
             (catalog/validate-provider-split-repos split-repos provider-catalog)))))
  (testing "rejects native authority or drifted split repo plans"
    (let [provider-catalog (catalog/load-provider-catalog)
          split-repos (catalog/load-provider-split-repos)
          result (catalog/validate-provider-split-repos
	                  (-> split-repos
	                      (assoc-in [0 :kami/authority] [:rust])
	                      (assoc-in [0 :kami/adapter] :native)
	                      (update-in [0 :kami/provider-namespaces] pop))
                  provider-catalog)]
      (is (false? (:valid? result)))
      (is (some #(= [:kami/provider-split-repos 0 :kami/authority] (:path %)) (:errors result)))
      (is (some #(= [:kami/provider-split-repos 0 :kami/adapter] (:path %)) (:errors result)))
      (is (some #(= [] (:path %)) (:errors result))))))

(deftest provider-split-repo-local-contracts
  (testing "materialized split provider repos mirror the central split contract"
    (let [provider-catalog (catalog/load-provider-catalog)
          split-repos (filter #(contains? materialized-split-kinds (:kami/kind %))
                              (catalog/provider-split-repos provider-catalog))]
      (doseq [split-repo split-repos
              :let [file (local-split-contract-file (:kami/split-to split-repo))]]
        (is (.exists file) (str "missing local split contract: " (.getPath file)))
        (when (.exists file)
          (is (= split-repo (edn/read-string (slurp file)))
              (str "local split contract drifted: " (.getPath file))))))))
