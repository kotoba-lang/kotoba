(ns kami.component-test
  (:require #?(:clj [kotoba.lang.edn :as edn])
            #?(:clj [kotoba.io :as io])
            [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is testing]]
            [kami.component :as component]
            [kami.contracts.wit :as wit]
            [kami.scene :as scene]))

(def cam-eid #uuid "00000000-0000-0000-0000-0000000000ca")
(def tree-eid #uuid "00000000-0000-0000-0000-00000000000a")

(def assets
  [{:asset/id "mesh/conifer" :asset/kind :mesh :asset/uri "b2://m/conifer"}
   {:asset/id "mat/bark" :asset/kind :material :asset/uri "b2://m/bark"}])

(def entities
  [{:kami/eid cam-eid
    :kami/name "cam"
    :camera/active? true
    :camera/fov 60.0
    :camera/near 0.1
    :camera/far 100.0
    :transform/translation [0.0 0.0 5.0]}
   {:kami/eid tree-eid
    :kami/name "tree"
    :transform/translation [0.0 0.0 0.0]
    :mesh/asset [:asset/id "mesh/conifer"]
    :material/asset [:asset/id "mat/bark"]}])

(def snapshot
  (scene/build-snapshot entities assets {:t 1 :scene "component-test" :env {}}))

(deftest component-boundaries
  (testing "known worlds validate with kotoba-clj authority"
    (is (component/boundary? (component/boundary-for :kami/scene)))
    (is (component/boundary? (component/boundary-for :kami/physics)))
    (is (component/boundary? (component/boundary-for :kami/render)))
    (is (component/boundary? (component/boundary-for :kami/robotics))))
  (testing "non-kotoba authority is rejected"
    (is (false?
         (:ok? (component/validate-boundary
                (assoc (component/boundary-for :kami/render) :authority :rust))))))
  (testing "WIT cannot become the authority"
    (is (false?
         (:ok? (component/validate-boundary
                (assoc (component/boundary-for :kami/render) :wit :authority)))))))

#?(:clj
   (defn- unblob
     "resources/kami/component_worlds.edn is Datomic/Datascript tx-data
     ([{:db/id -1 :kami.component-worlds/schema ... :kami.component-worlds/worlds \"...\"}]);
     the nested :worlds map is stored as a pr-str'd blob string. Parse it back."
     [v]
     (if (string? v)
       (try (let [parsed (edn/read-string v)] (if (coll? parsed) parsed v))
            (catch Exception _ v))
       v)))

#?(:clj
   (defn- reconstitute-component-worlds
     "Reverse the tx-data wrap: drop :db/id, strip the file-level
     kami.component-worlds/ namespace back to the original bare keys, and
     unblob every attribute value, recovering the exact original map."
     [tx-data]
     (into {} (map (fn [[k v]] [(keyword (name k)) (unblob v)]))
           (dissoc (first tx-data) :db/id))))

#?(:clj
   (deftest component-worlds-edn-is-authority-artifact
     (let [resource-worlds (-> "kami/component_worlds.edn"
                               io/resource
                               slurp
                               edn/read-string
                               reconstitute-component-worlds)]
       (testing "resource EDN matches the CLJC component world map"
         (is (= component/component-worlds resource-worlds)))
       (testing "WIT is generated-or-checked from the EDN, not authority"
         (is (wit/generated-artifact? resource-worlds))
         (let [wit-text (wit/emit-package resource-worlds)]
           (is (= wit-text (slurp "lib/kotoba.kamiContracts/wit/kami-component-worlds.wit")))
           (is (str/includes? wit-text "world kami-render"))
           (is (str/includes? wit-text "import host-gpu: func();"))
           (is (str/includes? wit-text "export render-frame: func();")))))))

(deftest scene-and-render-contracts
  (testing "scene snapshot validates before providers see it"
    (is (component/scene-snapshot? snapshot)))
  (testing "dangling references are rejected at the contract boundary"
    (let [bad-snapshot (scene/build-snapshot
                        [{:kami/eid tree-eid :mesh/asset [:asset/id "missing"]}]
                        []
                        {})]
      (is (false? (:ok? (component/validate-scene-snapshot bad-snapshot))))))
  (testing "render frame emitted from CLJC world validates"
    (let [frame {:frame/n 1
                 :frame/clear [1.0 1.0 1.0 1.0]
                 :frame/camera {:view (vec (repeat 16 0.0))
                                :proj (vec (repeat 16 0.0))}
                 :frame/passes [{:pass/id :main
                                 :pass/target :swapchain
                                 :pass/draws [{:draw/pipeline :pbr
                                               :draw/mesh "mesh/conifer"
                                               :draw/instances {:count 1
                                                                :model (vec (repeat 16 0.0))}}]}]}]
      (is (component/render-frame? frame))))
  (testing "malformed draw payloads are rejected"
    (let [bad-frame {:frame/n 0
                     :frame/clear [1.0 1.0 1.0 1.0]
                     :frame/camera {:view (vec (repeat 16 0.0))
                                    :proj (vec (repeat 16 0.0))}
                     :frame/passes [{:pass/id :main
                                     :pass/target :swapchain
                                     :pass/draws [{:draw/pipeline :pbr
                                                   :draw/mesh "mesh/conifer"
                                                   :draw/instances {:count 2
                                                                    :model [1.0]}}]}]}]
      (is (false? (:ok? (component/validate-render-frame bad-frame)))))))

(deftest physics-step-contract
  (testing "physics step request is EDN authority independent of provider"
    (is (component/physics-step?
         {:physics/world :kami/physics
          :physics/solver :rigid
          :physics/dt (/ 1.0 60.0)
          :physics/input {:bodies [] :constraints []}
          :physics/output #{:transforms :contacts}})))
  (testing "provider implementation names are not solver authority"
    (is (false?
         (:ok? (component/validate-physics-step
                {:physics/world :kami/physics
                 :physics/solver :rust
                 :physics/dt (/ 1.0 60.0)
                 :physics/input {}
                 :physics/output #{:transforms}}))))))
