(ns kami.contracts-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kami.contracts.gpu :as gpu]
            [kami.contracts.ipc :as ipc]
            [kami.contracts.render :as render]
            [kami.contracts.rt :as rt]
            [kami.contracts.sim :as sim]))

(def mat4 (vec (repeat 16 0.0)))

(def frame
  {:frame/n 1
   :frame/clear [1.0 1.0 1.0 1.0]
   :frame/camera {:view mat4 :proj mat4}
   :frame/passes [{:pass/id :main
                   :pass/target :swapchain
                   :pass/draws [{:draw/pipeline :pbr
                                 :draw/mesh "mesh/conifer"
                                 :draw/instances {:count 1 :model mat4}}]}]})

(deftest render-contract
  (testing "valid render-IR is accepted"
    (is (render/frame? frame)))
  (testing "malformed draw matrix count is rejected"
    (is (false?
         (:ok? (render/validate-frame
                (assoc-in frame [:frame/passes 0 :pass/draws 0 :draw/instances :model] [1.0])))))))

(deftest ipc-contract
  (testing "packed layout validates independent from producer implementation"
    (is (ipc/layout?
         {:buffer (vec (repeat 32 0))
          :len 32
          :ncols 1
          :layout [{:dtype :mat4 :len 1 :stride 1 :offset 16}]
          :meta {:n 1}})))
  (testing "unknown dtype is rejected"
    (is (false?
         (:ok? (ipc/validate-layout
                {:buffer (vec (repeat 32 0))
                 :len 32
                 :ncols 1
                 :layout [{:dtype :bogus :len 1 :stride 1 :offset 16}]
                 :meta {}}))))))

(deftest gpu-contract
  (testing "snapshot assets are EDN provider requests"
    (is (:ok? (gpu/validate-snapshot-assets
               {:snapshot/assets [{:asset/id "mesh/conifer"
                                   :asset/kind :mesh
                                   :asset/data {:vertices [0.0] :indices [0]}}]}))))
  (testing "unknown asset provider kind is rejected"
    (is (false?
         (:ok? (gpu/validate-snapshot-assets
                {:snapshot/assets [{:asset/id "x" :asset/kind :rust}]}))))))

(deftest rt-contract
  (testing "rt recipes validate as EDN authority"
    (is (rt/recipe? {:rt/name "gi" :rt/integrator {:spp 8}})))
  (testing "provider backend plan is checked against target table"
    (is (:ok? (rt/validate-backend-plan
               {:backend :metal
                :api :metal-rt
                :status :delegate
                :passes [{:pass/id :primary}]}))))
  (testing "provider names cannot invent new backends"
    (is (false?
         (:ok? (rt/validate-backend-plan
                {:backend :rust
                 :api :native
                 :status :authority
                 :passes [{:pass/id :primary}]}))))))

(deftest sim-contract
  (testing "runtime config validates without owning provider implementation"
    (is (sim/run-config?
         {:snapshot {:snapshot/entities [] :snapshot/assets []}
          :backend :mock
          :systems [:spin]
          :aspect 1.0
          :hz 60})))
  (testing "step receipt has deterministic envelope"
    (is (:ok? (sim/validate-step-receipt
               {:sim/world {}
                :sim/dt (/ 1.0 60.0)
                :sim/systems [:spin]
                :sim/frame 1})))))
