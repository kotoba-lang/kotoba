(ns kami.app-state-machines-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kami.app-state-machines :as appsm]))

(deftest app-state-machine-contract
  (testing "validates app state machines as CLJC/EDN authority"
    (let [catalog (appsm/load-app-state-machines)]
      (is (appsm/app-state-machines? catalog))
      (is (= {:valid? true :errors []}
             (appsm/validate-app-state-machines catalog)))
      (is (= #{:tatekata-construction-process
               :sarutahiko-loader-cycle
               :sarutahiko-production-line}
             (set (map :kami.appsm/id catalog))))))
  (testing "rejects Rust-owned app state machines"
    (let [result (appsm/validate-app-state-machines
                  [{:kami.appsm/id :bad
                    :kami.appsm/provider-crate "kami-app"
                    :kami.appsm/world :wgpu
                    :kami.appsm/kind :rust-enum
                    :kami.appsm/authority [:rust]
                    :kami.appsm/source-files ["kami-app/src/lib.rs"]
                    :kami.appsm/states [:running]
                    :kami.appsm/initial :running
                    :kami.appsm/terminal #{:running}
                    :kami.appsm/transitions
                    [{:kami.appsm/from :running
                      :kami.appsm/event "tick"
                      :kami.appsm/to :missing}]}])]
      (is (false? (:valid? result)))
      (is (some #(= [:kami/app-state-machines 0 :kami.appsm/world] (:path %)) (:errors result)))
      (is (some #(= [:kami/app-state-machines 0 :kami.appsm/kind] (:path %)) (:errors result)))
      (is (some #(= [:kami/app-state-machines 0 :kami.appsm/authority] (:path %)) (:errors result)))
      (is (some #(= [:kami/app-state-machines 0 :kami.appsm/initial] (:path %)) (:errors result)))
      (is (some #(= [:kami/app-state-machines 0 :kami.appsm/transitions 0 :kami.appsm/event] (:path %)) (:errors result)))
      (is (some #(= [:kami/app-state-machines 0 :kami.appsm/transitions 0 :kami.appsm/to] (:path %)) (:errors result))))))

(deftest engine-state-machine-filesystem-conformance
  (testing "cataloged app state-machine source paths are provenance, not engine files"
    (let [catalog (appsm/load-app-state-machines)]
      (is (= {:valid? true :errors []}
             (appsm/validate-engine-files catalog "../kami-engine"))))))
