(ns kami.app-fixtures-test
  (:require [kotoba.test :refer [deftest is testing]]
            [kami.app-fixtures :as fixtures]))

(deftest app-fixture-contract
  (testing "validates CLJ/EDN app fixtures as content authority"
    (let [catalog (fixtures/load-app-fixtures)]
      (is (fixtures/app-fixtures? catalog))
      (is (= {:valid? true :errors []}
             (fixtures/validate-app-fixtures catalog)))
      (is (= #{:survivors :waves :dance :royale :rt-audio-demo}
             (set (map :kami.fixture/id catalog))))))
  (testing "rejects native-player-owned fixture declarations"
    (let [result (fixtures/validate-app-fixtures
                  [{:kami.fixture/id :bad
                    :kami.fixture/provider-crate "kami-clj-play"
                    :kami.fixture/kind :rust-game
                    :kami.fixture/world :wgpu
                    :kami.fixture/scene ""
                    :kami.fixture/logic "src/main.rs"}])]
      (is (false? (:valid? result)))
      (is (some #(= [:kami/app-fixtures 0 :kami.fixture/kind] (:path %)) (:errors result)))
      (is (some #(= [:kami/app-fixtures 0 :kami.fixture/world] (:path %)) (:errors result)))
      (is (some #(= [:kami/app-fixtures 0 :kami.fixture/scene] (:path %)) (:errors result))))))

(deftest fixture-filesystem-conformance
  (testing "cataloged fixtures exist in kami-app-fixtures and scene.edn parses"
    (let [catalog (fixtures/load-app-fixtures)]
      (is (= {:valid? true :errors []}
             (fixtures/validate-fixture-files catalog "../kami-app-fixtures/resources/kami/app"))))))
