(ns kami.component
  "KAMI Engine component contracts.

  This namespace is the kotoba-clj authority for the engine boundary. Rust/wgpu,
  WebGPU, JS, and native hosts are providers that execute these EDN contracts;
  WIT is generated from, or checked against, this data and is not authoritative."
  (:require [kotoba.lang.coll :as set]
            [kami.contracts.render :as render-contract]
            [kami.scene :as scene]))

(def component-worlds
  {:schema :kami/component-worlds.v0
   :authority :kotoba-clj
   :wit :generated-or-checked
   :worlds
   {:kami/scene
    {:exports [:scene/validate :scene/snapshot :scene/query]
     :imports [:host/assets :host/clock]}

    :kami/physics
    {:exports [:physics/step :physics/plan :physics/inspect]
     :imports [:host/time :host/device :host/compute]}

    :kami/render
    {:exports [:render/frame :render/submit :render/inspect]
     :imports [:host/gpu :host/assets :host/window :host/clock]}

    :kami/robotics
    {:exports [:robotics/observe :robotics/act :robotics/plan]
     :imports [:host/device :host/sensors :host/actuators :host/clock]}}})

(def worlds
  (set (keys (:worlds component-worlds))))

(def exports
  (update-vals (:worlds component-worlds) (comp set :exports)))

(def imports
  (update-vals (:worlds component-worlds) (comp set :imports)))

(def forbidden-authorities
  #{:wit :typescript :rust :javascript :python :wgpu :webgpu :kami/env})

(defn- failure [message data]
  {:ok? false :error message :data data})

(defn- success [value]
  {:ok? true :value value})

(defn- subset-of? [required xs]
  (set/subset? required (set xs)))

(defn validate-boundary
  "Validate a Wasm Component Model boundary map:

    {:world :kami/render
     :authority :kotoba-clj
     :wit :generated-or-checked
     :exports [...]
     :imports [...]}

  The world must be known, required imports/exports must be present, and no
  non-kotoba source may claim semantic authority."
  [boundary]
  (let [{:keys [world authority wit]} boundary
        actual-exports (:exports boundary)
        actual-imports (:imports boundary)
        required-exports (get exports world)
        required-imports (get imports world)]
    (cond
      (not (worlds world))
      (failure "unknown KAMI component world" {:world world :known worlds})

      (forbidden-authorities authority)
      (failure "non-kotoba authority is forbidden" {:authority authority})

      (not= :kotoba-clj authority)
      (failure "component authority must be :kotoba-clj" {:authority authority})

      (= :authority wit)
      (failure "WIT is generated-or-checked, not authority" {:wit wit})

      (not (subset-of? required-exports actual-exports))
      (failure "missing required exports" {:world world :required required-exports :actual actual-exports})

      (not (subset-of? required-imports actual-imports))
      (failure "missing required imports" {:world world :required required-imports :actual actual-imports})

      :else
      (success boundary))))

(defn boundary? [boundary]
  (true? (:ok? (validate-boundary boundary))))

(defn boundary-for [world]
  {:world world
   :authority :kotoba-clj
   :wit :generated-or-checked
   :exports (vec (sort (exports world)))
   :imports (vec (sort (imports world)))})

(defn validate-scene-snapshot
  "Validate the portable scene snapshot that feeds ECS/render/physics. This pins
  the scene graph as EDN data before any Rust or GPU provider sees it."
  [snapshot]
  (try
    (scene/valid? snapshot)
    (if (and (contains? snapshot :snapshot/entities)
             (contains? snapshot :snapshot/assets))
      (success snapshot)
      (failure "snapshot must include entities and assets" {:keys (set (keys snapshot))}))
    (catch #?(:clj Exception :cljs js/Error) e
      (failure "invalid scene snapshot" {:message (ex-message e)
                                         :data (ex-data e)}))))

(defn scene-snapshot? [snapshot]
  (true? (:ok? (validate-scene-snapshot snapshot))))

(defn validate-render-frame
  "Validate render-IR before it is submitted to a GPU provider."
  [frame]
  (render-contract/validate-frame frame))

(defn render-frame? [frame]
  (true? (:ok? (validate-render-frame frame))))

(def physics-solvers
  #{:rigid :xpbd :mpm :sph :fem :pbd :vehicle :articulation :cartpole})

(defn validate-physics-step
  "Validate the physics provider request. The solver implementation can be Rust,
  WGSL, Genesis, Rapier, or another provider, but the timestep request is EDN."
  [{:keys [physics/world physics/solver physics/dt physics/input physics/output] :as plan}]
  (cond
    (not= :kami/physics world)
    (failure "physics plan must target :kami/physics" {:physics/world world})

    (not (physics-solvers solver))
    (failure "unknown physics solver" {:physics/solver solver :known physics-solvers})

    (not (and (number? dt) (pos? dt)))
    (failure "physics dt must be positive" {:physics/dt dt})

    (not (map? input))
    (failure "physics input must be an EDN map" {:physics/input input})

    (not (set? output))
    (failure "physics output must be a set of requested channels" {:physics/output output})

    :else
    (success plan)))

(defn physics-step? [plan]
  (true? (:ok? (validate-physics-step plan))))
