(ns kami.app-state-machines
  "EDN authority for app-specific KAMI state machines.

  Former Rust app source paths are retained as provenance only. App/domain
  states and transitions are CLJC/EDN authority and must execute through Kotoba
  CLJ Wasm Components."
  (:require [kotoba.lang.coll :as set]
            #?(:clj [kotoba.lang.edn :as edn])
            #?(:clj [kotoba.io :as io])))

(def app-state-machines-resource
  "kami/app_state_machines.edn")

#?(:clj
   (defn- unblob
     "resources/kami/app_state_machines.edn is Datomic/Datascript tx-data
     ([{:db/id -1 :kami/app-state-machines \"...\"}]); the state-machine
     vector is stored as a pr-str'd blob string (non-scalar value). Parse it
     back."
     [v]
     (if (string? v)
       (try (let [parsed (edn/read-string v)] (if (coll? parsed) parsed v))
            (catch Exception _ v))
       v)))

#?(:clj
   (defn load-app-state-machines []
     (let [resource (io/resource app-state-machines-resource)]
       (when-not resource
         (throw (ex-info "missing KAMI app state machines resource"
                         {:resource app-state-machines-resource})))
       (-> resource slurp edn/read-string first :kami/app-state-machines unblob))))

(def machine-required-keys
  #{:kami.appsm/id :kami.appsm/provider-crate :kami.appsm/world :kami.appsm/kind
    :kami.appsm/authority :kami.appsm/source-files :kami.appsm/states
    :kami.appsm/initial :kami.appsm/terminal :kami.appsm/transitions})

(def machine-optional-keys
  #{:kami.appsm/outputs})

(def machine-keys
  (set/union machine-required-keys machine-optional-keys))

(def transition-required-keys
  #{:kami.appsm/from :kami.appsm/event :kami.appsm/to})

(def transition-keys
  transition-required-keys)

(def machine-kinds
  #{:process-playback :robot-loading-cycle :station-production-line})

(def worlds
  #{:kami/scene})

(def authorities
  #{[:kotoba-clj :edn]})

(defn- err [path message]
  {:path path :message message})

(defn- collect-errors [& xs]
  (vec (remove nil? (mapcat #(if (sequential? %) % [%]) xs))))

(defn- prefix-errors [prefix errors]
  (mapv #(update % :path (fn [path] (into prefix path))) errors))

(defn- appsm-key? [k]
  (and (keyword? k) (= "kami.appsm" (namespace k))))

(defn- missing-errors [m required]
  (mapv #(err [%] "required key is missing")
        (sort (remove #(contains? m %) required))))

(defn- unknown-key-errors [m allowed]
  (mapv #(err [%] "unknown :kami.appsm/* key")
        (sort (filter #(and (appsm-key? %) (not (contains? allowed %))) (keys m)))))

(defn- field-error [m k pred message]
  (when (and (contains? m k) (not (pred (get m k))))
    (err [k] message)))

(defn- valid-result [errors]
  {:valid? (empty? errors)
   :errors errors})

(defn- non-empty-string? [x]
  (and (string? x) (not (empty? x))))

(defn- string-vector? [x]
  (and (vector? x) (every? non-empty-string? x)))

(defn- keyword-vector? [x]
  (and (vector? x) (seq x) (every? keyword? x)))

(defn- keyword-set? [x]
  (and (set? x) (seq x) (every? keyword? x)))

(defn- validate-transition [states transition index]
  (if-not (map? transition)
    [(err [:kami.appsm/transitions index] "transition must be a map")]
    (prefix-errors
     [:kami.appsm/transitions index]
     (collect-errors
      (missing-errors transition transition-required-keys)
      (unknown-key-errors transition transition-keys)
      (field-error transition :kami.appsm/from states
                   ":kami.appsm/from must name a declared state")
      (field-error transition :kami.appsm/event keyword?
                   ":kami.appsm/event must be a keyword")
      (field-error transition :kami.appsm/to states
                   ":kami.appsm/to must name a declared state")))))

(defn- validate-machine [machine index]
  (if-not (map? machine)
    [(err [:kami/app-state-machines index] "state machine must be a map")]
    (prefix-errors
     [:kami/app-state-machines index]
     (let [states (set (:kami.appsm/states machine))
           terminal (:kami.appsm/terminal machine)
           initial (:kami.appsm/initial machine)]
       (collect-errors
        (missing-errors machine machine-required-keys)
        (unknown-key-errors machine machine-keys)
        (field-error machine :kami.appsm/id keyword?
                     ":kami.appsm/id must be a keyword")
        (field-error machine :kami.appsm/provider-crate non-empty-string?
                     ":kami.appsm/provider-crate must be a non-empty string")
        (field-error machine :kami.appsm/world worlds
                     ":kami.appsm/world must be :kami/scene")
        (field-error machine :kami.appsm/kind machine-kinds
                     ":kami.appsm/kind must be a known app state-machine kind")
        (field-error machine :kami.appsm/authority authorities
                     ":kami.appsm/authority must be [:kotoba-clj :edn]")
        (field-error machine :kami.appsm/source-files string-vector?
                     ":kami.appsm/source-files must be a vector of strings")
        (field-error machine :kami.appsm/states keyword-vector?
                     ":kami.appsm/states must be a non-empty vector of keywords")
        (field-error machine :kami.appsm/initial states
                     ":kami.appsm/initial must name a declared state")
        (field-error machine :kami.appsm/terminal keyword-set?
                     ":kami.appsm/terminal must be a non-empty set of keywords")
        (field-error machine :kami.appsm/transitions vector?
                     ":kami.appsm/transitions must be a vector")
        (field-error machine :kami.appsm/outputs keyword-set?
                     ":kami.appsm/outputs must be a set of keywords")
        (when (and (set? terminal) (seq states) (not (set/subset? terminal states)))
          (err [:kami.appsm/terminal] "terminal states must be declared states"))
        (when (and (contains? machine :kami.appsm/initial)
                   (set? terminal)
                   (contains? terminal initial))
          (err [:kami.appsm/initial] "initial state must not be terminal"))
        (when (vector? (:kami.appsm/transitions machine))
          (mapcat #(validate-transition states %1 %2)
                  (:kami.appsm/transitions machine)
                  (range))))))))

(defn validate-app-state-machines [machines]
  (let [ids (map :kami.appsm/id machines)
        errors
        (collect-errors
         (when-not (vector? machines)
           (err [] "app state machines must be a vector"))
         (when (vector? machines)
           (mapcat validate-machine machines (range)))
         (when (and (vector? machines) (not= (count ids) (count (set ids))))
           (err [] "state machine ids must be unique")))]
    (valid-result errors)))

(defn app-state-machines? [machines]
  (:valid? (validate-app-state-machines machines)))

#?(:clj
   (defn validate-engine-files [machines engine-root]
     (valid-result [])))
