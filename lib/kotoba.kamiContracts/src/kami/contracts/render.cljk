(ns kami.contracts.render
  "Render-IR contract authority for KAMI providers.")

(def pipelines
  #{:pbr :sky :terrain :vegetation :character :water :voxel :particle :atlas})

(def targets
  #{:swapchain :texture :offscreen})

(defn- failure [message data]
  {:ok? false :error message :data data})

(defn- success [value]
  {:ok? true :value value})

(defn mat4? [xs]
  (and (vector? xs)
       (= 16 (count xs))
       (every? number? xs)))

(defn rgba? [xs]
  (and (vector? xs)
       (= 4 (count xs))
       (every? number? xs)))

(defn draw? [{:keys [draw/pipeline draw/mesh draw/instances]}]
  (and (or (pipelines pipeline) (string? pipeline) (keyword? pipeline))
       (some? mesh)
       (map? instances)
       (pos-int? (:count instances))
       (vector? (:model instances))
       (= (* 16 (:count instances)) (count (:model instances)))
       (every? number? (:model instances))))

(defn validate-frame
  "Validate render-IR before a GPU/native provider receives it."
  [frame]
  (let [{:keys [frame/n frame/clear frame/camera frame/passes]} frame]
    (cond
      (not (nat-int? n))
      (failure "frame number must be a natural integer" {:frame/n n})

      (not (rgba? clear))
      (failure "frame clear must be RGBA" {:frame/clear clear})

      (not (and (mat4? (:view camera)) (mat4? (:proj camera))))
      (failure "frame camera must contain view/proj mat4 vectors" {:frame/camera camera})

      (not (and (vector? passes) (seq passes)))
      (failure "frame must include at least one pass" {:frame/passes passes})

      (not (every? #(targets (:pass/target %)) passes))
      (failure "render pass target is unknown" {:targets (mapv :pass/target passes)})

      (not (every? #(every? draw? (:pass/draws % [])) passes))
      (failure "render pass contains malformed draw" {:passes passes})

      :else
      (success frame))))

(defn frame? [frame]
  (true? (:ok? (validate-frame frame))))

