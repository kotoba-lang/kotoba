(ns kami.contracts.sim
  "Simulation loop contract authority.")

(defn- failure [message data]
  {:ok? false :error message :data data})

(defn- success [value]
  {:ok? true :value value})

(defn validate-run-config [{:keys [snapshot backend systems aspect hz] :as config}]
  (cond
    (not (map? snapshot))
    (failure "run config must include a scene snapshot map" {:snapshot snapshot})

    (nil? backend)
    (failure "run config must include a provider backend" {:backend backend})

    (and systems (not (sequential? systems)))
    (failure "systems must be a sequence of identifiers" {:systems systems})

    (not (and (number? (or aspect 1.7777778)) (pos? (or aspect 1.7777778))))
    (failure "aspect must be positive" {:aspect aspect})

    (not (and (number? (or hz 30)) (pos? (or hz 30))))
    (failure "hz must be positive" {:hz hz})

    :else
    (success config)))

(defn run-config? [config]
  (true? (:ok? (validate-run-config config))))

(defn validate-step-receipt [{:keys [sim/world sim/dt sim/systems sim/frame] :as receipt}]
  (cond
    (nil? world)
    (failure "step receipt must include resulting world" {:receipt receipt})

    (not (and (number? dt) (pos? dt)))
    (failure "step receipt dt must be positive" {:sim/dt dt})

    (and systems (not (sequential? systems)))
    (failure "step receipt systems must be sequential" {:sim/systems systems})

    (and frame (not (nat-int? frame)))
    (failure "step receipt frame must be natural integer" {:sim/frame frame})

    :else
    (success receipt)))

