(ns kami.contracts.ipc
  "KAMI columnar frame contract authority.")

(def dtype
  {:f32  {:enum 0 :elsize 4}
   :f16  {:enum 1 :elsize 2}
   :u32  {:enum 2 :elsize 4}
   :u16  {:enum 3 :elsize 2}
   :u8   {:enum 4 :elsize 1}
   :i16  {:enum 5 :elsize 2}
   :mat4 {:enum 6 :elsize 64}
   :quat {:enum 7 :elsize 8}})

(def magic 0x494D414B)
(def version 1)
(def header-bytes 16)
(def column-header-bytes 16)

(defn- failure [message data]
  {:ok? false :error message :data data})

(defn- success [value]
  {:ok? true :value value})

(defn aligned16? [n]
  (and (nat-int? n) (zero? (mod n 16))))

(defn byte-len [dt n stride]
  (when-let [{:keys [elsize]} (dtype dt)]
    (* (long elsize) (long n) (long stride))))

(defn validate-layout
  "Validate the light-weight IPC pack result emitted by `kami.ipc/pack`."
  [{:keys [buffer len ncols layout meta] :as packed}]
  (cond
    (not (and (vector? buffer) (every? #(<= 0 % 255) buffer)))
    (failure "buffer must be a vector of u8 values" {:buffer-type (type buffer)})

    (not= len (count buffer))
    (failure "declared len must match buffer length" {:len len :actual (count buffer)})

    (not (aligned16? len))
    (failure "buffer length must be 16-byte aligned" {:len len})

    (not= ncols (count layout))
    (failure "ncols must match layout count" {:ncols ncols :layout-count (count layout)})

    (not (every? #(and (dtype (:dtype %))
                       (pos-int? (:len %))
                       (pos-int? (:stride %))
                       (aligned16? (:offset %)))
                 layout))
    (failure "layout columns must use known dtype and aligned offsets" {:layout layout})

    (not (map? meta))
    (failure "packed frame must include metadata sidecar" {:meta meta})

    :else
    (success packed)))

(defn layout? [packed]
  (true? (:ok? (validate-layout packed))))

