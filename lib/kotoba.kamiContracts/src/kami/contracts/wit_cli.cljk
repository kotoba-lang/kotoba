(ns kami.contracts.wit-cli
  "CLI for generating/checking WIT artifacts from KAMI component-world EDN."
  (:require [kotoba.bytes :as kbytes] [kotoba.lang.edn :as edn]
            [kotoba.io :as io]
            [kotoba.lang.text :as str]
            [kami.contracts.wit :as wit]))

(def default-resource "kami/component_worlds.edn")

(defn- unblob
  "resources/kami/component_worlds.edn is Datomic/Datascript tx-data
  ([{:db/id -1 :kami.component-worlds/schema ... :kami.component-worlds/worlds \"...\"}]);
  the nested :worlds map is stored as a pr-str'd blob string. Parse it back."
  [v]
  (if (string? v)
    (try (let [parsed (edn/read-string v)] (if (coll? parsed) parsed v))
         (catch Exception _ v))
    v))

(defn- reconstitute-entity
  "Reverse the tx-data wrap: drop :db/id, strip the file-level
  kami.component-worlds/ namespace back to the original bare keys, and unblob
  every attribute value, recovering the exact original map."
  [tx-data]
  (into {} (map (fn [[k v]] [(keyword (name k)) (unblob v)]))
        (dissoc (first tx-data) :db/id)))

(defn component-worlds []
  (-> default-resource io/resource slurp edn/read-string reconstitute-entity))

(defn usage []
  (str "Usage:\n"
       "  kbb -M:gen-wit --print\n"
       "  kbb -M:gen-wit --write <path>\n"
       "  kbb -M:check-wit <path>\n"))

(defn generated-wit []
  (wit/emit-package (component-worlds)))

(defn -main [& args]
  (case (first args)
    "--print"
    (print (generated-wit))

    "--write"
    (let [path (second args)]
      (when-not path
        (binding [*out* *err*] (print (usage)))
        (System/exit 2))
      (spit path (generated-wit))
      (println "wrote" path))

    "--check"
    (let [path (second args)
          expected (generated-wit)
          actual (some-> path slurp)]
      (cond
        (nil? path)
        (do
          (binding [*out* *err*] (print (usage)))
          (System/exit 2))

        (= expected actual)
        (println "wit-ok" path)

        :else
        (do
          (binding [*out* *err*]
            (println "WIT artifact is stale:" path)
            (println "expected bytes:" (count (kbytes/utf8-bytes expected)))
            (println "actual bytes:" (count (kbytes/utf8-bytes (or actual ""))))
            (when-not (str/blank? actual)
              (println "hint: kbb -M:gen-wit --write" path)))
          (System/exit 1))))

    (do
      (binding [*out* *err*] (print (usage)))
      (System/exit 2))))
