(ns kami.contracts.wit
  "Generate/check WIT text from KAMI EDN component worlds.

  WIT emitted here is an adapter artifact. The EDN/CLJC contract remains the
  authority."
  (:require [kotoba.lang.text :as str]))

(defn wit-ident [k]
  (-> (if (keyword? k)
        (str (namespace k) "-" (name k))
        (str k))
      (str/replace #"[^A-Za-z0-9_-]" "-")))

(defn world-ident [world]
  (wit-ident world))

(defn- fn-name [k]
  (wit-ident k))

(defn- import-line [k]
  (str "  import " (fn-name k) ": func();"))

(defn- export-line [k]
  (str "  export " (fn-name k) ": func();"))

(defn emit-world
  "Emit a minimal WIT world stub for one EDN world descriptor."
  [world {:keys [imports exports]}]
  (str "world " (world-ident world) " {\n"
       (str/join "\n" (map import-line imports))
       (when (seq imports) "\n")
       (str/join "\n" (map export-line exports))
       (when (seq exports) "\n")
       "}\n"))

(defn emit-package
  "Emit WIT for all worlds in a component-worlds EDN document."
  [{:keys [worlds]}]
  (str/join "\n" (for [[world descriptor] (sort-by (comp str key) worlds)]
                   (emit-world world descriptor))))

(defn generated-artifact?
  "True when an artifact carries the expected generated/check-only metadata."
  [component-worlds]
  (and (= :kotoba-clj (:authority component-worlds))
       (= :generated-or-checked (:wit component-worlds))))
