(ns kami.contracts.gpu
  "GPU provider boundary contract authority."
  (:require [kami.contracts.ipc :as ipc]))

(def asset-kinds
  #{:mesh :material :shader :texture :text})

(defn- failure [message data]
  {:ok? false :error message :data data})

(defn- success [value]
  {:ok? true :value value})

(defn validate-asset [{:keys [asset/id asset/kind asset/data] :as asset}]
  (cond
    (not (some? id))
    (failure "asset must include :asset/id" {:asset asset})

    (not (asset-kinds kind))
    (failure "unknown GPU asset kind" {:asset/kind kind :known asset-kinds})

    (and data (not (map? data)))
    (failure "asset data must be an EDN map" {:asset/data data})

    :else
    (success asset)))

(defn validate-snapshot-assets [snapshot]
  (let [assets (:snapshot/assets snapshot)
        problems (->> assets
                      (map validate-asset)
                      (remove :ok?)
                      vec)]
    (cond
      (not (vector? assets))
      (failure "snapshot assets must be a vector" {:snapshot/assets assets})

      (seq problems)
      (failure "snapshot contains malformed GPU assets" {:problems problems})

      :else
      (success snapshot))))

(defn validate-packed-frame [packed]
  (ipc/validate-layout packed))

(defn packed-frame? [packed]
  (true? (:ok? (validate-packed-frame packed))))
