(ns kami.contracts.rt
  "Ray-tracing recipe and backend-plan contract authority.")

(def accel-kinds #{:bvh :lbvh :kd-tree})
(def integrator-kinds #{:path :ao :whitted :primary})
(def sampler-kinds #{:sobol :halton :random :stratified})
(def output-formats #{:rgba8 :rgba16f :rgba32f})
(def denoisers #{:none :svgf :atrous :oidn})

(def default-accel {:kind :bvh :builder :sah :refit :per-frame})
(def default-integrator {:kind :path :max-bounces 4 :rr-start 2 :spp 8 :clamp 10.0})
(def default-sampler {:kind :sobol :seed 0})
(def default-camera {:fov 60.0 :aperture 0.0 :focus-dist 5.0})
(def default-output {:width 1280 :height 720 :format :rgba16f :denoise :svgf})

(def targets
  {:wgsl   {:api :webgpu-ray-query :status :emit :notes "WebGPU ray-query (EXT) + WGSL LBVH fallback"}
   :metal  {:api :metal-rt :status :delegate :notes "MPSRayIntersector / Metal ray tracing (iOS/macOS)"}
   :vulkan {:api :khr-ray-tracing :status :delegate :notes "VK_KHR_ray_tracing_pipeline (Android/desktop)"}
   :dx12   {:api :dxr :status :delegate :notes "DirectX Raytracing (Windows)"}
   :ps5    {:api :agc-rt :status :nda :notes "PS5 AGC ray tracing; NDA, plan only"}
   :switch {:api :nvn-rt :status :nda :notes "Switch NVN; NDA, plan only"}
   :unity  {:api :hdrp-dxr :status :delegate :notes "Unity HDRP ray tracing bridge"}
   :unreal {:api :lumen :status :delegate :notes "Unreal Lumen / hardware RT bridge"}})

(defn- failure [message data]
  {:ok? false :error message :data data})

(defn- success [value]
  {:ok? true :value value})

(defn validate-recipe [recipe]
  (let [{:keys [rt/name rt/accel rt/integrator rt/sampler rt/output]} recipe]
    (cond
      (not (string? name))
      (failure "rt recipe name must be a string" {:rt/name name})

      (and (:kind accel) (not (accel-kinds (:kind accel))))
      (failure "unknown accel kind" {:kind (:kind accel) :known accel-kinds})

      (and (:kind integrator) (not (integrator-kinds (:kind integrator))))
      (failure "unknown integrator kind" {:kind (:kind integrator) :known integrator-kinds})

      (neg? (:max-bounces integrator 0))
      (failure "max-bounces must be >= 0" {:integrator integrator})

      (< (:spp integrator 1) 1)
      (failure "spp must be >= 1" {:integrator integrator})

      (and (:kind sampler) (not (sampler-kinds (:kind sampler))))
      (failure "unknown sampler kind" {:kind (:kind sampler) :known sampler-kinds})

      (and (:format output) (not (output-formats (:format output))))
      (failure "unknown output format" {:format (:format output) :known output-formats})

      (and (:denoise output) (not (denoisers (:denoise output))))
      (failure "unknown denoiser" {:denoise (:denoise output) :known denoisers})

      :else
      (success recipe))))

(defn recipe? [recipe]
  (true? (:ok? (validate-recipe recipe))))

(defn validate-backend-plan [{:keys [backend api status passes] :as plan}]
  (let [target (get targets backend)]
    (cond
      (nil? target)
      (failure "unknown RT backend" {:backend backend :known (keys targets)})

      (not= api (:api target))
      (failure "backend API does not match contract" {:backend backend :api api :expected (:api target)})

      (not= status (:status target))
      (failure "backend status does not match contract" {:backend backend :status status :expected (:status target)})

      (not (and (vector? passes) (seq passes)))
      (failure "backend plan must include ordered passes" {:passes passes})

      :else
      (success plan))))
