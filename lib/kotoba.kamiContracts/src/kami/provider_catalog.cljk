(ns kami.provider-catalog
  "EDN authority for KAMI Kotoba CLJ provider families."
  (:require [kotoba.lang.coll :as set]
            [kotoba.lang.text :as string]
            [kami.component :as component]
            #?(:clj [kotoba.lang.edn :as edn])
            #?(:clj [kotoba.io :as io])))

(def provider-catalog-resource
  "kami/provider_catalog.edn")

(def provider-boundaries-resource
  "kami/provider_boundaries.edn")

(def provider-split-repos-resource
  "kami/provider_split_repos.edn")

#?(:clj
   (defn- unblob
     "The resource files are Datomic/Datascript tx-data ([{:db/id -1 ...}]);
     nested collections (maps/vectors-of-maps) are stored as pr-str'd blob
     strings. Parse them back."
     [v]
     (if (string? v)
       (try (let [parsed (edn/read-string v)] (if (coll? parsed) parsed v))
            (catch Exception _ v))
       v)))

#?(:clj
   (defn- reconstitute-entity
     "Reverse the tx-data wrap: drop :db/id and unblob every attribute value,
     recovering the original map (keys were kept as-is, already meaningfully
     namespaced, so no key renaming is needed)."
     [tx-data]
     (into {} (map (fn [[k v]] [k (unblob v)]))
           (dissoc (first tx-data) :db/id))))

#?(:clj
   (defn load-provider-catalog []
     (let [resource (io/resource provider-catalog-resource)]
       (when-not resource
         (throw (ex-info "missing KAMI provider catalog resource"
                         {:resource provider-catalog-resource})))
       (-> resource slurp edn/read-string reconstitute-entity))))

#?(:clj
   (defn load-provider-boundaries []
     (let [resource (io/resource provider-boundaries-resource)]
       (when-not resource
         (throw (ex-info "missing KAMI provider boundaries resource"
                         {:resource provider-boundaries-resource})))
       (-> resource slurp edn/read-string reconstitute-entity :kami/provider-boundaries))))

#?(:clj
   (defn load-provider-split-repos []
     (let [resource (io/resource provider-split-repos-resource)]
       (when-not resource
         (throw (ex-info "missing KAMI provider split repos resource"
                         {:resource provider-split-repos-resource})))
       (-> resource slurp edn/read-string reconstitute-entity :kami/provider-split-repos))))

(def worlds
  #{:kami/scene :kami/physics :kami/render :kami/robotics})

(def catalog-required-keys
  #{:kami/catalog :kami/authority :kami/adapter :kami/runtime :kami/provider-families})

(def catalog-keys
  catalog-required-keys)

(def family-required-keys
  #{:kami/family :kami/world :kami/authority-repo :kami/split-to
    :kami/provider-namespaces})

(def family-optional-keys
  #{:kami/status :kami/rule :kami/legacy-crates})

(def family-keys
  (set/union family-required-keys family-optional-keys))

(def boundary-required-keys
  #{:kami/family :kami/world :kami/authority :kami/adapter :kami/imports :kami/exports
    :kami/provider-namespaces})

(def boundary-optional-keys
  #{:kami/legacy-crates})

(def boundary-keys
  (set/union boundary-required-keys boundary-optional-keys))

(def split-repo-required-keys
  #{:kami/split-to :kami/kind :kami/authority :kami/adapter :kami/families
    :kami/worlds :kami/provider-namespaces :kami/authority-repos :kami/exit-criteria})

(def split-repo-optional-keys
  #{:kami/dependency-repos :kami/legacy-crates})

(def split-repo-keys
  (set/union split-repo-required-keys split-repo-optional-keys))

(def split-repo-kinds
  #{:wasm-component-provider :edn-domain-authority :edn-fixture-provider
    :component-runtime-provider :game-engine})

(defn- err [path message]
  {:path path :message message})

(defn- collect-errors [& xs]
  (vec (remove nil? (mapcat #(if (sequential? %) % [%]) xs))))

(defn- prefix-errors [prefix errors]
  (mapv #(update % :path (fn [path] (into prefix path))) errors))

(defn- kami-key? [k]
  (and (keyword? k) (= "kami" (namespace k))))

(defn- missing-errors [m required]
  (mapv #(err [%] "required key is missing")
        (sort (remove #(contains? m %) required))))

(defn- unknown-key-errors [m allowed]
  (mapv #(err [%] "unknown :kami/* key")
        (sort (filter #(and (kami-key? %) (not (contains? allowed %))) (keys m)))))

(defn- field-error [m k pred message]
  (when (and (contains? m k) (not (pred (get m k))))
    (err [k] message)))

(defn- valid-result [errors]
  {:valid? (empty? errors)
   :errors errors})

(defn- non-empty-string? [x]
  (and (string? x) (not (empty? x))))

(defn- non-empty-string-vector? [x]
  (and (vector? x) (seq x) (every? non-empty-string? x)))

(defn- keyword-vector? [x]
  (and (vector? x) (every? keyword? x)))

(defn- non-empty-keyword-vector? [x]
  (and (keyword-vector? x) (seq x)))

(def family-statuses
  #{:active :pending-classification})

(defn- validate-family [family index]
  (if-not (map? family)
    [(err [:kami/provider-families index] "provider family must be a map")]
    (prefix-errors
     [:kami/provider-families index]
     (collect-errors
      (missing-errors family family-required-keys)
      (unknown-key-errors family family-keys)
      (field-error family :kami/family keyword?
                   ":kami/family must be a keyword")
      (field-error family :kami/world worlds
                   ":kami/world must be a known KAMI component world")
      (field-error family :kami/authority-repo non-empty-string?
                   ":kami/authority-repo must be a non-empty string")
      (field-error family :kami/split-to non-empty-string?
                   ":kami/split-to must be a non-empty string")
      (field-error family :kami/provider-namespaces non-empty-string-vector?
                   ":kami/provider-namespaces must be a non-empty vector of strings")
      (field-error family :kami/legacy-crates non-empty-string-vector?
                   ":kami/legacy-crates must be a non-empty vector of strings")
      (field-error family :kami/status family-statuses
                   ":kami/status must be a known family status")
      (field-error family :kami/rule keyword?
                   ":kami/rule must be a keyword")))))

(defn validate-provider-catalog [catalog]
  (let [errors
        (if-not (map? catalog)
          [(err [] "provider catalog must be a map")]
          (collect-errors
           (missing-errors catalog catalog-required-keys)
           (unknown-key-errors catalog catalog-keys)
           (field-error catalog :kami/catalog #{:provider-catalog}
                        ":kami/catalog must be :provider-catalog")
           (field-error catalog :kami/authority #{[:kotoba-clj :edn]}
                        ":kami/authority must be [:kotoba-clj :edn]")
           (field-error catalog :kami/adapter #{:wasm-component-model}
                        ":kami/adapter must be :wasm-component-model")
           (field-error catalog :kami/runtime #{:kotoba-clj-wasm-components}
                        ":kami/runtime must be :kotoba-clj-wasm-components")
           (field-error catalog :kami/provider-families vector?
                        ":kami/provider-families must be a vector")
           (when (vector? (:kami/provider-families catalog))
             (mapcat validate-family (:kami/provider-families catalog) (range)))))]
    (valid-result errors)))

(defn provider-catalog? [catalog]
  (:valid? (validate-provider-catalog catalog)))

(defn provider-boundary-for [family]
  (let [world (:kami/world family)
        boundary (component/boundary-for world)]
    {:kami/family (:kami/family family)
     :kami/world world
     :kami/authority :kotoba-clj
     :kami/adapter :wasm-component-model
     :kami/imports (:imports boundary)
     :kami/exports (:exports boundary)
     :kami/provider-namespaces (:kami/provider-namespaces family)
     :kami/legacy-crates (:kami/legacy-crates family)}))

(defn provider-boundaries [catalog]
  (mapv provider-boundary-for
        (remove #(= :pending-classification (:kami/status %))
                (:kami/provider-families catalog))))

(defn- validate-provider-boundary [catalog-families boundary index]
  (if-not (map? boundary)
    [(err [:kami/provider-boundaries index] "provider boundary must be a map")]
    (let [family (:kami/family boundary)
          catalog-family (get catalog-families family)
          component-boundary (when (:kami/world boundary)
                               (component/boundary-for (:kami/world boundary)))]
      (prefix-errors
       [:kami/provider-boundaries index]
       (collect-errors
        (missing-errors boundary boundary-required-keys)
        (unknown-key-errors boundary boundary-keys)
        (field-error boundary :kami/family keyword?
                     ":kami/family must be a keyword")
        (field-error boundary :kami/world worlds
                     ":kami/world must be a known KAMI component world")
        (field-error boundary :kami/authority #{:kotoba-clj}
                     ":kami/authority must be :kotoba-clj")
        (field-error boundary :kami/adapter #{:wasm-component-model}
                     ":kami/adapter must be :wasm-component-model")
        (field-error boundary :kami/imports vector?
                     ":kami/imports must be a vector")
        (field-error boundary :kami/exports vector?
                     ":kami/exports must be a vector")
        (field-error boundary :kami/provider-namespaces non-empty-string-vector?
                     ":kami/provider-namespaces must be a non-empty vector of strings")
        (field-error boundary :kami/legacy-crates non-empty-string-vector?
                     ":kami/legacy-crates must be a non-empty vector of strings")
        (when-not catalog-family
          (err [:kami/family] "provider boundary family is not in the provider catalog"))
        (when (and catalog-family (not= (:kami/world catalog-family) (:kami/world boundary)))
          (err [:kami/world] "provider boundary world must match provider catalog"))
        (when (and catalog-family (not= (:kami/provider-namespaces catalog-family)
                                        (:kami/provider-namespaces boundary)))
          (err [:kami/provider-namespaces] "provider boundary namespaces must match provider catalog"))
        (when (and catalog-family (not= (:kami/legacy-crates catalog-family)
                                        (:kami/legacy-crates boundary)))
          (err [:kami/legacy-crates] "provider boundary legacy crates must match provider catalog"))
        (when (and component-boundary (not= (:imports component-boundary) (:kami/imports boundary)))
          (err [:kami/imports] "provider boundary imports must match component world"))
        (when (and component-boundary (not= (:exports component-boundary) (:kami/exports boundary)))
          (err [:kami/exports] "provider boundary exports must match component world")))))))

(defn validate-provider-boundaries [boundaries catalog]
  (let [active-families (remove #(= :pending-classification (:kami/status %))
                                (:kami/provider-families catalog))
        catalog-families (into {} (map (juxt :kami/family identity)
                                       active-families))
        catalog-family-names (set (keys catalog-families))
        boundary-family-names (set (map :kami/family boundaries))
        errors
        (collect-errors
         (when-not (vector? boundaries)
           (err [] "provider boundaries must be a vector"))
         (when (vector? boundaries)
           (mapcat #(validate-provider-boundary catalog-families %1 %2) boundaries (range)))
         (when (and (vector? boundaries)
                    (not= catalog-family-names boundary-family-names))
           (err [] "provider boundary families must exactly match provider catalog families")))]
    (valid-result errors)))

(defn provider-boundaries? [boundaries catalog]
  (:valid? (validate-provider-boundaries boundaries catalog)))

(defn- distinct-in-order [xs]
  (vec (distinct xs)))

(defn- split-repo-kind [split-to]
  (cond
    (string/includes? split-to "scene-contracts") :edn-domain-authority
    (string/includes? split-to "app-fixtures") :edn-fixture-provider
    (string/includes? split-to "kami-engine") :game-engine
    (string/includes? split-to "runtime-provider") :component-runtime-provider
    :else :wasm-component-provider))

(def stdlib-dependency-repos
  {"orgs/kotoba-lang/kami-engine"
   ["orgs/kotoba-lang/io"
    "orgs/kotoba-lang/gpu"
    "orgs/kotoba-lang/host"
    "orgs/kotoba-lang/input"
    "orgs/kotoba-lang/audio"
    "orgs/kotoba-lang/physics"
    "orgs/kotoba-lang/webgpu"]
   "orgs/kotoba-lang/giemon"
   ["orgs/kotoba-lang/robotics"]})

(defn provider-split-repos [catalog]
  (let [active-families (vec (remove #(= :pending-classification (:kami/status %))
                                     (:kami/provider-families catalog)))
        split-targets (distinct-in-order (map :kami/split-to active-families))]
    (mapv
     (fn [split-to]
       (let [families (filter #(= split-to (:kami/split-to %)) active-families)]
         {:kami/split-to split-to
          :kami/kind (split-repo-kind split-to)
          :kami/authority (:kami/authority catalog)
          :kami/adapter (:kami/adapter catalog)
          :kami/families (mapv :kami/family families)
          :kami/worlds (distinct-in-order (map :kami/world families))
          :kami/provider-namespaces (vec (mapcat :kami/provider-namespaces families))
          :kami/legacy-crates (vec (mapcat :kami/legacy-crates families))
          :kami/authority-repos (distinct-in-order (map :kami/authority-repo families))
          :kami/exit-criteria (mapv :kami/rule families)
          :kami/dependency-repos (get stdlib-dependency-repos split-to [])}))
     split-targets)))

(defn- validate-provider-split-repo [repo index]
  (if-not (map? repo)
    [(err [:kami/provider-split-repos index] "provider split repo must be a map")]
    (prefix-errors
     [:kami/provider-split-repos index]
     (collect-errors
      (missing-errors repo split-repo-required-keys)
      (unknown-key-errors repo split-repo-keys)
      (field-error repo :kami/split-to non-empty-string?
                   ":kami/split-to must be a non-empty string")
      (field-error repo :kami/kind split-repo-kinds
                   ":kami/kind must be a known provider split repo kind")
      (field-error repo :kami/authority #{[:kotoba-clj :edn]}
                   ":kami/authority must be [:kotoba-clj :edn]")
      (field-error repo :kami/adapter #{:wasm-component-model}
                   ":kami/adapter must be :wasm-component-model")
      (field-error repo :kami/families non-empty-keyword-vector?
                   ":kami/families must be a non-empty vector of keywords")
      (field-error repo :kami/worlds non-empty-keyword-vector?
                   ":kami/worlds must be a non-empty vector of keywords")
      (field-error repo :kami/provider-namespaces non-empty-string-vector?
                   ":kami/provider-namespaces must be a non-empty vector of strings")
      (field-error repo :kami/legacy-crates non-empty-string-vector?
                   ":kami/legacy-crates must be a non-empty vector of strings")
      (field-error repo :kami/authority-repos non-empty-string-vector?
                   ":kami/authority-repos must be a non-empty vector of strings")
      (field-error repo :kami/exit-criteria non-empty-keyword-vector?
                   ":kami/exit-criteria must be a non-empty vector of keywords")
      (field-error repo :kami/dependency-repos #(and (vector? %) (every? non-empty-string? %))
                   ":kami/dependency-repos must be a vector of strings")))))

(defn validate-provider-split-repos [repos catalog]
  (let [expected (provider-split-repos catalog)
        errors
        (collect-errors
         (when-not (vector? repos)
           (err [] "provider split repos must be a vector"))
         (when (vector? repos)
           (mapcat validate-provider-split-repo repos (range)))
         (when (and (vector? repos) (not= expected repos))
           (err [] "provider split repos must exactly match provider catalog split targets")))]
    (valid-result errors)))

(defn provider-split-repos? [repos catalog]
  (:valid? (validate-provider-split-repos repos catalog)))

#?(:clj
   (defn cargo-workspace-members
     "Read current kami-engine Cargo workspace members when a legacy Cargo.toml is present.

     This is a deletion-debt check. Once kami-engine is Kotoba CLJ only, the
     Cargo.toml is absent and the legacy member set is empty."
     ([]
      (cargo-workspace-members "../kami-engine/Cargo.toml"))
     ([cargo-toml]
      (let [file (io/file cargo-toml)]
        (if-not (io/exists? file)
          #{}
          (let [lines (string/split-lines (slurp file))
                member-lines (->> lines
                                  (drop-while #(not (string/includes? % "members = [")))
                                  rest
                                  (take-while #(not (string/includes? % "]"))))]
            (->> member-lines
                 (keep #(second (re-find #"\"([^\"]+)\"" %)))
                 set)))))))

(defn catalog-legacy-crates [catalog]
  (->> (:kami/provider-families catalog)
       (mapcat :kami/legacy-crates)
       set))

#?(:clj
   (defn validate-workspace-coverage
     ([catalog] (validate-workspace-coverage catalog "../kami-engine/Cargo.toml"))
     ([catalog cargo-toml]
      (let [workspace-members (cargo-workspace-members cargo-toml)
            classified (catalog-legacy-crates catalog)
            missing (sort (set/difference workspace-members classified))]
        (valid-result
         (for [crate missing]
           (err [:kami/provider-families] (str "workspace crate is not tracked as legacy Rust debt: " crate))))))))
