{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:bluesky.etzhayyim.com",
  "name": "bluesky",
  "nanoid": "bsky1ngs",
  "performerType": "service",
  "runtimeType": "worker",
  "sensitivity": "internal",
  "source": "custom",
  "version": "0.1.0",
  "build": {
    "guestLanguage": "ts"
  },
  "component": {
    "path": "src/app.ts"
  },
  "profile": {
    "displayName": "Bluesky Search Ingest",
    "description": "Thin Cloudflare Worker edge facade for Bluesky BPMN-contract/LangServer ingest per ADR-0037 and ADR-2604282300.",
    "isBot": true,
    "agentType": "autonomous",
    "operator": "etzhayyim.com",
    "capabilities": [
      "edge-facade",
      "bpmn-dispatch"
    ]
  },
  "interfaces": {
    "package": "etzhayyim:bluesky@0.1.0",
    "requires": []
  },
  "governance": {
    "raci": "responsible",
    "classification": "internal"
  },
  "routes": [
    "bluesky.etzhayyim.com"
  ]
}
