;; Bluesky bsky1ngs appview frontend — reagent + re-frame, rendered with
;; jp-go-dds (デジタル庁デザインシステム). Migrated from
;; appview/etzhayyim-wasm-bluesky-bsky1ngs/svelte (Svelte 5 + SvelteKit +
;; @sveltejs/adapter-cloudflare — one route file, routes/+page.svelte, a
;; static status/facts page with no interactivity and no data fetching).
;;
;; The SvelteKit XRPC proxy route (svelte/src/routes/xrpc/[...path]/+server.ts)
;; was backend, not frontend — it moved to ../src/xrpc-proxy.ts, unwired, not
;; part of this migration. See that file's header.
;;
;; reagent/re-frame/clojurescript/shadow-cljs live under the :cljs alias
;; rather than top-level :deps (workspace convention, and required — a
;; PreToolUse hook rejects new top-level JVM deps of this shape). jp-go-dds is
;; a workspace git dep and stays top-level.
;;
;; jp-go-dds :git/sha below is pinned to the exact commit
;; cloud-itonami/okaimono's landed, building appview/okaimono-shopping-mcp-component/cljs
;; uses — kept identical here as a proven floor, not re-derived.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system.git"
         :git/sha "dc4602dc17bce8f6e9ba038e92b3e95fcc411b49"}}
 :aliases {:cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                                thheller/shadow-cljs {:mvn/version "2.28.20"}
                                reagent/reagent {:mvn/version "1.2.0"}
                                re-frame/re-frame {:mvn/version "1.4.3"}}}
           :test {:extra-paths ["test"]}}}
