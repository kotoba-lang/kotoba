// svelte-to-cljs migration (2026-09-08): the `svelte/` directory (SvelteKit +
// @sveltejs/adapter-cloudflare) was removed. Its one route,
// `src/routes/+page.svelte`, is now `cljs/` (reagent + re-frame +
// jp-go-dds), built by shadow-cljs into `cljs/public`. `main` is deleted —
// `src/app.ts` (unchanged, still the live Worker) does not call
// `env.ASSETS.fetch()`, so this Worker is assets-only; repointing `main` at
// it would put a worker in front of the assets and nothing would serve
// static files. `assets.directory` now points at the cljs build output.
// UNVERIFIED: `wrangler deploy` / `wrangler dev` were not run against this
// change. Deployment verification is a separate job.
{
  "name": "kotodama-bsky1ngs",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"edge-facade\",\"bpmn-dispatch\"]",
    "APP_DEPLOY_AT": "2026-04-20T00:00:00Z",
    "APP_DESCRIPTION": "Bluesky AT Protocol search-purpose ingest (ADR-0037)",
    "APP_DISPLAY_NAME": "Bluesky Search Ingest",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "bsky1ngs",
    "APP_PERFORMER_TYPE": "service",
    "APP_SOURCE": "custom",
    "APP_UI_TYPE": "appview",
    "APP_VERSION": "0.1.0",
    "BLUESKY_APPVIEW": "https://public.api.bsky.app",
    "INGEST_ENABLED": "1",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
