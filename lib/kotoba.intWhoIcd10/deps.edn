;; org.clojure/clojure + one workspace-local git dep: kotoba-lang/xml, for
;; the ClaML (WHO's classification-release XML format) parser only --
;; icd10.code/icd10.chapters/icd10.compare are plain string/EDN logic and
;; do not touch it. Pin is kotoba-lang/xml's `main` HEAD as of this repo's
;; creation, verified reachable via `gh api repos/kotoba-lang/xml/commits/HEAD`.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/xml {:local/root "../kotoba.xml"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
