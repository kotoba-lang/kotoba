;; KAMI pkg — package geometry & thermal-model registry.
;;
;; Canonical, swappable configuration for kotoba.pkg.package /
;; kotoba.pkg.thermal estimation formulas. Ported verbatim (same numeric
;; values) from the empirical constants hardcoded in kami-pkg (Rust)
;; src/package.rs and src/thermal.rs. A process/technology-specific
;; deployment may load an override map with the same shape and pass it
;; explicitly to estimate-package / calculate-thermal.
{:qfp   {:body-clearance-mm 2.0
         :body-z-mm 1.4}
 :bga   {:body-clearance-mm 1.0
         :body-z-mm 1.2}
 :csp   {:body-clearance-mm 0.5
         :body-z-mm 0.8}
 :wlcsp {:body-z-mm 0.5}

 ;; SiP / chiplet packages: body size scales off die size (no pin/pitch
 ;; input in the source model), and pin count is a fixed placeholder.
 :sip          {:die-multiplier-x 2.5
                :die-multiplier-y 2.5
                :body-z-mm 2.0
                :fixed-pin-count 256}
 :chiplet-2-5d {:die-multiplier-x 3.0
                :die-multiplier-y 2.0
                :body-z-mm 1.5
                :fixed-pin-count 512}
 :chiplet-3d   {:die-multiplier-x 1.5
                :die-multiplier-y 1.5
                :body-z-mm 2.5
                :fixed-pin-count 1024}

 ;; Simplified empirical thermal-resistance-from-area model used by
 ;; estimate-package: theta_jc = base-theta-jc + area-coeff-jc / area
 ;;                   theta_ja = theta_jc     + area-coeff-ca / area
 :thermal-estimation {:base-theta-jc 0.5
                       :area-coeff-jc 20.0
                       :area-coeff-ca 30.0}

 ;; Forced-airflow theta_ca reduction used by calculate-thermal:
 ;; theta_ca_effective = theta_ca / (1 + airflow_m_per_s) ^ reduction-exponent
 :airflow-model {:reduction-exponent 0.5}}
