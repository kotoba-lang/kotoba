(ns kotoba.groot.types-test
  (:export [main])
  (:require [kotoba.groot.types :as t]))

(defn- expect [got :bool want :bool] :i64
  (if (= got want) 0 1))

(defn- edn-is [d :document want :string] :i64
  (if (string=? (document-edn-print d) want) 0 1))

(defn- field [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn main [] :i64
  (let [fr (t/frame (document-string "front") (document-i64 640) (document-i64 480) (document-null))
        ob (t/observation (document-vector (document-i64 1) (document-i64 2) (document-i64 3))
                          (document-null) (document-string "pick"))
        ac (t/action (document-i64 2) (document-i64 3)
                     (document-vector (document-i64 1) (document-i64 2) (document-i64 3)
                                      (document-i64 4) (document-i64 5) (document-i64 6)))
        bare (t/observation (document-vector) (document-null) (document-null))]
    (+ (edn-is (field fr :frame/camera) "\"front\"")
       (edn-is (field fr :frame/width) "640")
       (edn-is (field fr :frame/height) "480")
       (expect (= (document-count (field fr :frame/pixels)) 0) true)
       (edn-is (field ob :obs/state) "[1 2 3]")
       (expect (= (document-count (field ob :obs/video)) 0) true)
       (edn-is (field ob :obs/language) "\"pick\"")
       (expect (= (document-kind (field bare :obs/language)) :null) true)
       (edn-is (t/action-step ac 0) "[1 2 3]")
       (edn-is (t/action-step ac 1) "[4 5 6]")
       (edn-is (t/action-first ac) "[1 2 3]")
       (edn-is (t/action-step ac 2) "[]"))))
