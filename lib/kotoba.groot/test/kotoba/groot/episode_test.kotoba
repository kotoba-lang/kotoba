(ns kotoba.groot.episode-test
  (:export [main])
  (:require [kotoba.groot.episode :as e]))

(defn- step-at [ep :document i :i64] :document
  (option-or (document-vector-at (option-or (document-get ep :episode/steps) (document-null)) i)
             (document-null)))

(defn- str-at [d :document k :keyword] :string
  (option-or (document-string-value (option-or (document-get d k) (document-null))) "<none>"))

(defn main [] :i64
  (let [ep0 (e/episode (document-string "franka"))
        ep1 (e/push ep0 (document-vector (document-i64 1) (document-i64 2)) (document-vector (document-i64 3)) (document-string "pick"))
        ep2 (e/push ep1 (document-vector (document-i64 4)) (document-vector (document-i64 5)) (document-string "place"))]
    (+ (if (e/empty? ep0) 0 1)
       (if (= (e/step-count ep2) 2) 0 1)
       (if (e/empty? ep1) 1 0)
       (if (string=? (str-at (step-at ep2 0) :step/language) "pick") 0 1)
       (if (string=? (str-at (step-at ep2 1) :step/language) "place") 0 1)
       (if (string=? (str-at ep2 :episode/embodiment) "franka") 0 1))))
