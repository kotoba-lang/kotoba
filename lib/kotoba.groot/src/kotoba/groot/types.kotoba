;; Port of kotoba.groot.types (types.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from types.cljk:
;;   - keyword arguments are positional. The optional arguments take
;;     document-null for "absent": frame pixels, observation video and
;;     observation language. (or pixels []) is document-null -> empty vector.
;;   - (vec state) and (vec joint-targets) are not applied: the caller passes
;;     a :document vector.
;;   - action-step: Clojure subvec throws when the range is out of bounds. Here
;;     the slice is clamped to the vector's end and never throws.

(ns kotoba.groot.types
  (:export [frame observation action action-step action-first]))

(defn- null-or [v :document d :document] :document
  (if (= (document-kind v) :null) d v))

(defn- field [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn- field-i64 [m :document k :keyword] :i64
  (option-or (document-i64-value (field m k)) 0))

(defn frame [camera :document width :document height :document pixels :document] :document
  (document-map :frame/camera camera
                :frame/width width
                :frame/height height
                :frame/pixels (null-or pixels (document-vector))))

(defn observation [state :document video :document language :document] :document
  (document-map :obs/state state
                :obs/video (null-or video (document-vector))
                :obs/language language))

(defn action [horizon :document n-dof :document joint-targets :document] :document
  (document-map :action/horizon horizon
                :action/n-dof n-dof
                :action/joint-targets joint-targets))

(defn- slice [v :document from :i64 to :i64] :document
  (loop [i from acc (document-vector)]
    (if (or (>= i to) (>= i (document-count v)))
      acc
      (recur (+ i 1) (document-vector-conj acc (option-or (document-vector-at v i) (document-null)))))))

(defn action-step [a :document i :i64] :document
  (let [n (field-i64 a :action/n-dof)]
    (slice (field a :action/joint-targets) (* i n) (* (+ i 1) n))))

(defn action-first [a :document] :document
  (action-step a 0))
