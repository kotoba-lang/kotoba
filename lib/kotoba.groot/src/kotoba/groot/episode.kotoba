;; Port of kotoba.groot.episode (episode.cljk), Kotoba-native, :document maps.
;;
;; A LeRobot-shaped episode record: {:episode/embodiment e :episode/steps [...]},
;; each step {:step/state s :step/action a :step/language l}.
;;
;; Named divergences from episode.cljk:
;;   - (vec state) is not applied: state and action are :document values that the
;;     caller passes as vectors.
;;   - empty? keeps the source name; it compares the step count.

(ns kotoba.groot.episode
  (:export [episode-step episode push step-count empty?]))

(defn episode-step [state :document action :document language :document] :document
  (document-map :step/state state
                :step/action action
                :step/language language))

(defn episode [embodiment-name :document] :document
  (document-map :episode/embodiment embodiment-name
                :episode/steps (document-vector)))

(defn- steps [ep :document] :document
  (option-or (document-get ep :episode/steps) (document-vector)))

(defn push [ep :document state :document action :document language :document] :document
  (document-assoc ep :episode/steps
                  (document-vector-conj (steps ep) (episode-step state action language))))

(defn step-count [ep :document] :i64
  (document-count (steps ep)))

(defn empty? [ep :document] :bool
  (= (step-count ep) 0))
