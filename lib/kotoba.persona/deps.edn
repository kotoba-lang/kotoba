;; persona —— 1 人が持つ複数の公開の顔。
;;
;; 依存は word-id 1 本だけ。alias の local part を『電話で読み上げられる 4 語』
;; にするために要る（Apple の privaterelay が k7x9m2p4@... にできないこと）。
;; それ以外の IO・crypto・SMTP は持たない。
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/word-id {:local/root "../kotoba.wordId"}}
 :aliases
 {;; west checkout の中で開発するとき。
  :local {:override-deps
          {io.github.kotoba-lang/word-id {:local/root "../word-id"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
