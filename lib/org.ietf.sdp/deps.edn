;; No dependencies. SDP (RFC 4566) is a line grammar with fixed field
;; ordering and a handful of parameter sub-grammars (rtpmap/fmtp/rtcp-fb/
;; ssrc) — string splitting and a position cursor, nothing a library
;; would improve on.
{:paths ["src"]
 :deps {
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}}
 :aliases
 {:test {:extra-paths ["test"]}
  :cljs {:extra-paths ["test"]}}}
