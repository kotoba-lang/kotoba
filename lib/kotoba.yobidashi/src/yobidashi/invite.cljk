(ns yobidashi.invite
  "The caller's request to ring someone, as the callee's home node receives it.

  An invite is a nafuda statement signed by the caller's **device**, plus the
  attachments that let a home node that has never heard of the caller decide
  about them offline:

      {:invite      signed {:nafuda/kind :invite
                            :yobidashi/call-id  hex (8 bytes)
                            :yobidashi/callee   callee root public hex
                            :yobidashi/caller   caller root public hex
                            :yobidashi/callback caller device's denwa.call destination hex
                            :yobidashi/bearers  #{:mesh :wifi …}
                            :yobidashi/stamp    hex (optional)
                            :nafuda/not-after   seconds}
       :attachments [caller's device certificate, root continuity statements,
                     introductions, community name claims …]}

  The stamp, if any, is bound to this call id, this callee and this expiry —
  see `stamp-target`."
  (:require [nafuda.statement :as st]
            [monban.stamp :as stamp]
            [kotoba.lang.edn :as edn]
            [tsunagi.crypto :as c]
            [tsunagi.wire :as w]))

(defn stamp-target [call-id-hex callee-hex expires]
  (c/sha256 (w/cat-bytes (w/utf8 "yobidashi/invite") (w/unhex call-id-hex)
                         (w/utf8 callee-hex) (w/u32 expires))))

(defn invite
  "A signed invite bundle. `stamp-cost` > 0 mints a stamp of that many bits."
  [caller-device {:keys [call-id callee caller callback bearers expires stamp-cost attachments]
                  :or {bearers #{:mesh} stamp-cost 0 attachments []}}]
  (let [cid (if (string? call-id) call-id (w/hex call-id))
        stamp (when (pos? stamp-cost)
                (stamp/mint (stamp-target cid callee expires) stamp-cost))]
    {:invite (st/sign caller-device
                      (cond-> {:nafuda/kind :invite
                               :yobidashi/call-id cid
                               :yobidashi/callee callee
                               :yobidashi/caller caller
                               :yobidashi/callback (if (string? callback) callback (w/hex callback))
                               :yobidashi/bearers (set bearers)
                               :nafuda/not-after expires}
                        stamp (assoc :yobidashi/stamp (w/hex stamp))))
     :attachments (vec attachments)}))

(defn encode [bundle] (w/utf8 (pr-str (st/canonical bundle))))

(defn decode [bs]
  (try
    (let [v (edn/read-string (w/utf8-str bs))]
      (when (and (map? v) (map? (:invite v)) (vector? (:attachments v))) v))
    (catch #?(:clj Exception :cljs :default :default :default) _ nil)))

(defn fields
  "The invite's fields with the stamp decoded, or nil if the signature fails."
  [{:keys [invite]}]
  (when (and (st/valid? invite) (= :invite (get-in invite [:statement :nafuda/kind])))
    (let [m (:statement invite)]
      {:call-id (:yobidashi/call-id m)
       :callee (:yobidashi/callee m)
       :caller (:yobidashi/caller m)
       :caller-device (:nafuda/signer m)
       :callback (:yobidashi/callback m)
       :bearers (:yobidashi/bearers m)
       :expires (:nafuda/not-after m)
       :stamp (some-> (:yobidashi/stamp m) w/unhex)})))
