(ns yobidashi.schedule
  "When a sleeping device listens.

  The cellular trick (DRX paging), without a network operator: time is cut
  into cycles of `slots` slots; a device listens only during its own slot,
  for `listen-ms`, once per cycle, and sleeps otherwise. Its slot is derived
  from its page destination, so the home node computes the same slot without
  being told:

      slot(device)      = first two bytes of SHA-256(\"yobidashi/slot\" ++ page destination) mod slots
      wake(device, t)   = the next start of that slot at or after t

  Clocks drift, so the device opens its window `guard-ms` early and the home
  node transmits in the middle of it. Worst-case ring latency is one cycle;
  the battery cost is `listen-ms / cycle-ms` of receive current.

  Profiles are data. `:lora` suits a companion radio on a coin of current;
  `:wifi` suits a phone already on a mesh where waking is cheap."
  (:require [tsunagi.crypto :as c]
            [tsunagi.wire :as w]))

(def profiles
  {:lora {:cycle-ms 2560 :slots 8 :listen-ms 60 :guard-ms 20}
   :lora-eco {:cycle-ms 10240 :slots 32 :listen-ms 60 :guard-ms 40}
   :wifi {:cycle-ms 1024 :slots 4 :listen-ms 40 :guard-ms 10}})

(defn slot-ms [{:keys [cycle-ms slots]}] (quot cycle-ms slots))

(defn slot-of [profile page-destination]
  (let [[a b] (c/sha256 (w/cat-bytes (w/utf8 "yobidashi/slot") page-destination))]
    (rem (+ (* a 256) b) (:slots profile))))

(defn next-wake
  "Start (ms) of the device's next listening window at or after `now-ms`,
  guard included."
  [profile page-destination now-ms]
  (let [{:keys [cycle-ms guard-ms]} profile
        offset (* (slot-of profile page-destination) (slot-ms profile))
        cycle-start (* cycle-ms (quot now-ms cycle-ms))
        candidate (- (+ cycle-start offset) guard-ms)]
    (if (>= candidate now-ms) candidate (+ candidate cycle-ms))))

(defn transmit-at
  "When the home node should send a ring so it lands mid-window."
  [profile page-destination now-ms]
  (+ (next-wake profile page-destination now-ms)
     (:guard-ms profile)
     (quot (:listen-ms profile) 2)))

(defn listening?
  "Whether the device is in its window at `t-ms`."
  [profile page-destination t-ms]
  (let [{:keys [cycle-ms guard-ms listen-ms]} profile
        start (rem (- (* (slot-of profile page-destination) (slot-ms profile)) guard-ms) cycle-ms)
        start (if (neg? start) (+ start cycle-ms) start)
        phase (rem t-ms cycle-ms)
        len (+ guard-ms listen-ms)]
    (or (and (>= phase start) (< phase (+ start len)))
        (< (+ phase cycle-ms) (+ start len)))))

(defn average-current-ma
  "Mean draw for a profile: receive current during windows, sleep otherwise."
  [{:keys [cycle-ms listen-ms guard-ms]} rx-ma sleep-ma]
  (let [on (+ listen-ms guard-ms)]
    (+ (* rx-ma (/ on cycle-ms)) (* sleep-ma (/ (- cycle-ms on) cycle-ms)))))

(defn battery-days
  "Days a battery of `capacity-mah` lasts on paging alone."
  [profile capacity-mah rx-ma sleep-ma]
  (/ capacity-mah (average-current-ma profile rx-ma sleep-ma) 24))
