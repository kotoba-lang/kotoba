{:paths ["src"]
 ;; kotobase (kotoba-lang/kotobase) provides the IStore/ITransactionalStore
 ;; seam (kotobase.store) and the LocalStore oracle (kotobase.local) this
 ;; library projects nostr.relay/nostr.blossom's storage over. Pinned to the
 ;; same SHA kotoba-lang/kotobase-protocols pins (verified current against
 ;; kotobase's default-branch HEAD when this repo was created).
 :deps {
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/kotobase
        {:git/sha "bbf57df9dde5c1869182012860129a598382e088"}}
 ;; First-class runtime is nbb/cljs (repo-wide runtime priority):
 ;;   kbb --backend sci --classpath "src:test:<kotobase>/src" bin/run_tests.cljk
 ;;   kbb --backend sci --classpath "src:test:<kotobase>/src" test/nostr/relay_transport_test.cljk
 ;; The :test alias below is the :clj COMPAT suite (pure .cljc namespaces
 ;; only — nostr.relay.transport is .cljs-only and is NEVER loaded here,
 ;; same isolation kotoba-lang/dtn's transport uses) — not the primary
 ;; execution path.
 :aliases
 {:test {:extra-paths ["test"]}}}
