{
  "name": "kotodama-t3ns0f1l",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "APP_CAPABILITIES": "[\"create-transfer\",\"accept-transfer\",\"download-chunk\",\"revoke-transfer\",\"list-transfers\",\"init-signal-session\"]",
    "APP_DESCRIPTION": "Signal E2E Secure File Transfer - zero-knowledge encrypted file transfer with X3DH key exchange, AES-256-GCM per-transfer keys, chunked R2 storage",
    "APP_DISPLAY_NAME": "Tenso",
    "APP_EMBED_URL": "https://t3ns0f1l.etzhayyim.com/?embed=1",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "t3ns0f1l",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "appview",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "t3ns0f1l.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "tenso.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
