{
  "@context": "https://etzhayyim.com/ns/kotodama/v1",
  "@id": "did:web:tenso.etzhayyim.com",
  "component": {
    "path": "component.wasm"
  },
  "convoSystemPrompt": "You are Tenso, a secure file transfer agent. You help users send and receive files with end-to-end encryption via Signal Protocol. Files are encrypted client-side with per-transfer AES-256-GCM keys; the server stores only ciphertext. You can create transfers, check status, list transfers, and help recipients decrypt files. Respond helpfully in the user's language.",
  "governance": {
    "raci": "responsible",
    "classification": "confidential",
    "complianceFrameworks": [
      "signal-protocol-e2e",
      "zero-knowledge-storage"
    ]
  },
  "name": "tenso",
  "nanoid": "t3ns0f1l",
  "performerType": "service",
  "pool": {},
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "create-transfer",
      "accept-transfer",
      "download-chunk",
      "revoke-transfer",
      "list-transfers",
      "init-signal-session"
    ],
    "description": "Signal E2E Secure File Transfer - zero-knowledge encrypted file transfer with X3DH key exchange, AES-256-GCM per-transfer keys, chunked B2 storage",
    "displayName": "Tenso",
    "isBot": true,
    "operator": "etzhayyim.com"
  },
  "project": "tenso",
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "kind": "public",
        "name": "t3ns0f1l-feed"
      }
    ],
    "joinRule": "public",
    "name": "Tenso"
  },
  "triggers": {
    "http": {
      "listen": "0.0.0.0:8080",
      "routes": [
        "/api/grpc/...",
        "/health",
        "/healthz",
        "/readyz",
        "/..."
      ],
      "spa": true,
      "staticDir": "/wasm/cljs/public"
    },
    "subscribeRepos": {
      "collections": [
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.graph.follow",
        "com.etzhayyim.apps.tenso.transferRequest",
        "com.etzhayyim.apps.tenso.fileManifest",
        "com.etzhayyim.apps.tenso.transferLog",
        "com.etzhayyim.apps.tenso.accessControl"
      ]
    }
  },
  "uiType": "appview",
  "derive": {
    "social": [
      {
        "on": "com.etzhayyim.apps.tenso.transferRequest",
        "when": { "status": "completed" },
        "template": "File transfer completed: {{filename}} ({{sizeBytes}} bytes)"
      }
    ],
    "invoke": [
      {
        "on": "com.etzhayyim.apps.tenso.transferLog",
        "when": { "eventType": "error" },
        "target": "did:web:yabai.etzhayyim.com",
        "method": "com.etzhayyim.apps.yabai.assessRisk",
        "map": {
          "entityDid": "{{actorDid}}",
          "event": "transfer_error",
          "transferId": "{{transferId}}"
        }
      }
    ]
  }
}
