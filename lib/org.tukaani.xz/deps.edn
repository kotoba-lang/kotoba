{:paths ["src"]
 ;; org-ietf-deflate supplies CRC-32, which .xz uses for every structural field
 ;; (stream flags, block header, index, footer). One CRC-32 in the workspace.
 :deps {
        io.github.kotoba-lang/io {:local/root "../kotoba.io"}
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        io.github.kotoba-lang/text {:local/root "../kotoba.text"}
        io.github.kotoba-lang/org-ietf-deflate {:local/root "../org.ietf.deflate"}
        io.github.kotoba-lang/org-nist-sha2 {:local/root "../gov.nist.sha2"}}
 :aliases
 {:local {:override-deps {io.github.kotoba-lang/org-ietf-deflate {:local/root "../org-ietf-deflate"}
                          io.github.kotoba-lang/org-nist-sha2 {:local/root "../org-nist-sha2"}}}
  :test {:extra-paths ["test"]}}}
