"Measurements for the wiki-standards-crawl bot (world-standards corpus).\n\nDecision-free, same contract as wiki_news_evidence.py: syncs the dedicated\nworktree (~/.gftd/worktrees/wiki-standards-crawl, an app-hyakka checkout) to\norigin/main, runs the repo's own growth-evidence collector (kbb +\nwiki_growth_evidence.cljk), and reports standards-body coverage: which\nstandards bodies (ISO/IEC/IEEE/ITU/IETF...) are configured, which source\nclasses, and whether live-plane items land for standards. REFUSED banner on\nany failure so the bot is told it is blind, never that the standards plane is\ncomplete.\n\n2026-09-13: collector is kbb cutover — wiki_growth_evidence.cljk via\n`kbb --backend sci` with kotoba-lang/text on the classpath.\n"
(import os)
(import re)
(import subprocess)
(import sys)
(import urllib.request)
(setv WORKTREE ((. os.environ get) "HYAKKA_BOT_WORKTREE" ((. os.path expanduser) "~/.gftd/worktrees/wiki-standards-crawl")))
(setv KBB ((. os.environ get) "HYAKKA_KBB" "/opt/homebrew/bin/kbb"))
(setv TEXT_SRC ((. os.environ get) "HYAKKA_TEXT_SRC" "~/github/com-junkawasaki/orgs/kotoba-lang/text/src"))
(setv DAYS ((. os.environ get) "HYAKKA_EVIDENCE_DAYS" "14"))
(setv WIKI_ROOT ((. os.environ get) "HYAKKA_WIKI_ROOT" "https://wiki.yataverse.com"))
(setv CORPUS "world-standards")
(setv BODIES ["iso" "iec" "ieee" "itu" "ietf" "ansi" "jis" "astm" "ul"])
(defn refuse [why] (print "REFUSED — no evidence was gathered this run.") (print why) (print) (print "Do not propose anything. A standards proposal built on an unread tree is a proposal built on nothing. Report this refusal and stop.") (sys.exit 0))
(defn git [#* args] (return (subprocess.run (+ #("git" "-C" WORKTREE) args) :capture_output True :text True :timeout 300)))
(defn require-clean-worktree []
  (setv status (git "status" "--porcelain" "--untracked-files=all"))
  (when (!= status.returncode 0)
    (refuse f"could not inspect worktree status before checkout (git status exit {status.returncode})"))
  (when (. status.stdout strip)
    (refuse "worktree has local changes; refusing checkout to preserve tracked and untracked work")))

(defn main [] (when (not (or ((. os.path isdir) ((. os.path join) WORKTREE ".git")) ((. os.path exists) ((. os.path join) WORKTREE ".git")))) (refuse f"no git worktree at {WORKTREE}")) (setv fetch (git "fetch" "--quiet" "origin" "main")) (when (!= fetch.returncode 0) (refuse f"git fetch failed: {(cut ((. fetch.stderr strip)) 400)}")) (require-clean-worktree) (setv reset (git "checkout" "--quiet" "--detach" "FETCH_HEAD")) (when (!= reset.returncode 0) (refuse f"could not move to origin/main: {(cut ((. reset.stderr strip)) 400)}")) (setv head ((. (. (git "rev-parse" "--short" "HEAD") stdout) strip))) (setv collector ((. os.path join) WORKTREE "scripts" "wiki_growth_evidence.cljk")) (when (not ((. os.path exists) collector)) (refuse f"collector missing on main checkout: {collector}")) (when (not ((. os.path isdir) TEXT_SRC)) (refuse f"kotoba-lang/text src missing: {TEXT_SRC}")) (setv proc (subprocess.run [KBB "--backend" "sci" "--classpath" f"src:{TEXT_SRC}" collector "--summary" "--root" "." "--days" DAYS] :cwd WORKTREE :capture_output True :text True :timeout 600)) (when (= proc.returncode 2) (refuse (+ "the evidence collector refused:\n" (cut ((. proc.stderr strip)) 800)))) (when (!= proc.returncode 0) (refuse (+ f"the evidence collector exited {proc.returncode}:\n" (cut (or ((. proc.stderr strip)) ((. proc.stdout strip))) 800)))) (when (not-in "SCANNED\t" proc.stdout) (refuse "the collector produced no SCANNED line")) (setv cfg ((. os.path join) WORKTREE "config" "knowledge-ingest.edn")) (try (setv config ((. (open cfg :encoding "utf-8") read))) (except [e OSError] (refuse f"cannot read ingest config: {e}"))) (setv ids (re.findall ":id \"([^\"]+)\"" config)) (setv by_body {}) (for [bid BODIES] (setv hits (lfor i ids :if (and (in bid (i.lower)) (or (in "standard" (i.lower)) (in "spec" (i.lower)) (in "rfc" (i.lower)) (= bid (get ((. (i.lower) split) "-") 0)))) i)) (setv (get by_body bid) (len hits))) (setv n_standard (sum (gfor i ids :if (any (gfor k #("standard" "rfc" "spec-") (in k (i.lower)))) 1))) (setv live "unmeasured") (try (setv req ((. urllib.request Request) (+ WIKI_ROOT "/search?q=ISO%20standard") :headers {"Accept" "text/html"  "User-Agent" "wiki-standards-crawl/0.1"})) (with [r ((. urllib.request urlopen) req :timeout 20)] (setv body ((. (r.read) decode) "utf-8" "replace"))) (setv m (re.search "Search results \\((\\d+) results\\)" body)) (setv live (if m (m.group 1) "unparseable")) (except [e Exception] (setv live f"unmeasured ({(. (type e) __name__)})"))) (print f"worktree\t{WORKTREE}") (print f"head\t{head}") (print ((. proc.stdout strip))) (print f"## STANDARDS COVERAGE — corpus {CORPUS}") (print f"standards-sources-configured\t{n_standard}") (for [#(bid n) (by_body.items)] (print f"body-{bid}-sources\t{n}")) (print f"live-plane-iso-search-results\t{live}"))
(when (= __name__ "__main__") (main))
