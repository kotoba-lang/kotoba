{:paths ["src"]
 :version "0.1.0"
 ;; kotoba-lang/text — string/regex/unicode helpers. The stdlib gap every lib
 ;; re-rolls (json/lint/time hand-roll string ops). Zero third-party deps; .cljc.
 ;; Regex uses the host's #"..."; pure string ops are portable. Runs on
 ;; JVM/SCI/CLJS/GraalVM/kotoba-WASM. See ADR-kotoba-lang-foundational-stdlib.md.
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:local/root "../kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.

       }
 :aliases
 {:test {:extra-paths ["test"]}
}}
