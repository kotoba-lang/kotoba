;; JUN-718 (kami upstream port 1/4): kotoba.lang.text gains the literal-string
;; split / split-lines / replace that kami-engine uses; bounded_text drops the
;; string-split-count primitive the pinned single-file Amu CLI refuses.
;; Evidence recorded 2026-10-31. Python only staged bytes and read exit codes;
;; Amu checked, compiled and ran every program; Kotoba main owns each verdict.
{:schema :kotoba.text-migration/v1
 :issue "JUN-718"
 :date "2026-10-31"
 :amu {:repo "kotoba-lang/amu"
       :rev "f7c07dff86d7fb5e89219a0f9ad4a83b2a83c82e"
       :pinned-in "kotoba-lang/kami-engine .github/workflows/ci.yml"
       :image "seed/bootstrap/aarch64-macos/amu-cli.macho"
       :image-sha256 "e4f63a6cd0f8a1ea802aebfdab225dffea1b33ae53ce49dc6fc7237644207aff"
       :compiler-sha256 "c527540c20686e02e2211a500a1edd24fe999a4caf6a9576e19e1bb13acde23f"
       :host "macOS arm64"
       :note "Single-file CLI: `amu check FILE`, `amu run FILE`; no
              --source-path, so any :require is E6002, and every :export is
              checked as a native ABI export (scalar, single arity)."}
 :repo-gate "native-shared.yml case text (amu 6a77cd91, multi-module
             --source-path, ARM + x86 Linux) runs test/native/text.kotoba;
             it is older than the pinned CLI and is the gate that executes
             the new goldens 33-73."
 :amu-check
 ;; `amu check lib/kotoba.text/<path>` with the pinned CLI, before = origin/main 0dd4355673e1
 [{:path "src/kotoba/lang/text.kotoba"
   :before "E2104 type mismatch in 'join': expected :i64"
   :after "E2104 type mismatch in 'join': expected :i64"
   :refused-exports {:join :E2104 :index-of :E2104 :split :E2104 :split-lines :E2104}
   :without-refused-exports :ok
   :blocked "Exports whose types are [:list :string] / [:option :i64] (or
             multi-arity) are refused at the single-file export boundary.
             The repo contract (AGENTS.md JUN-93: typed string-list join,
             option index-of with both arities) keeps them, so this file
             cannot pass this CLI without changing its public API."}
  {:path "src/kotoba/lang/bounded_text.kotoba"
   :before "E2101 unknown or unsupported form 'string-split-count'"
   :after :ok
   :run {:command "amu run src/kotoba/lang/bounded_text.kotoba" :main 42}
   :negative-control "segment-count-text counting 2 per separator: main 8"}
  {:path "src/kotoba/lang/bounded_regex.kotoba"
   :before "E2104 type mismatch in 'regex-contains': expected :i64"
   :after "E2104 type mismatch in 'regex-contains': expected :i64"
   :refused-exports {:regex-contains :E2104 :regex-match :E2104
                     :regex-find-index :E2104 :regex-match-end :E2104
                     :regex-count :E2104}
   :without-refused-exports {:check :ok :run-main 47}
   :blocked "[:result :i64 :string] exports are refused at the export
             boundary; unchanged."}
  {:path "src/kotoba/text.kotoba"
   :before "E6002 required module kotoba.lang.text is missing"
   :after "E6002 required module kotoba.lang.text is missing"
   :blocked "The facade exists to forward to kotoba.lang.text; a
             single-file CLI cannot resolve the require. Not inlined."}]
 :ported
 {:split "literal string separator, arities [text sep] and [text sep limit];
          Pattern/split limit semantics as text.cljk reimplements them"
  :split-lines "text.cljk (split s #\"\\r?\\n\") without a regex"
  :replace "literal string match and literal replacement"}
 :divergences
 {:split-empty-separator-astral "JVM splits a non-BMP code point into two
   UTF-16 surrogate halves (bb: (split \"a😀b\" \"\") => [\"a\" \"?\" \"?\" \"b\"]);
   a UTF-8 string cannot hold a lone surrogate, so the native answer keeps
   the code point: [\"a\" \"😀\" \"b\"] (golden 44)."}
 :not-ported
 {:regex-arguments "split / replace with a regex separator or match, and
   replace with a function replacement, have no .kotoba value type; they
   stay in text.cljk. bounded_regex is group-free, and kami's patterns
   (e.g. #\"(^-|-$)\") use groups."
  :upper "full Unicode case mapping (host toUpperCase); AGENTS.md JUN-93
          keeps full Unicode case a separate qualification and forbids
          aliasing the ASCII kernel to the full API."
  :lower "same as :upper (final sigma, dotted I)."
  :capitalize "composed from :upper / :lower."}
 :local-native-run
 {:what "single-file probe: src/kotoba/lang/text.kotoba definitions plus the
         test/native/text.kotoba helpers and main (text/ and alias/ prefixes
         dropped), exports [main]"
  :command "amu check probe.kotoba; amu run probe.kotoba"
  :result {:check :ok :main 0 :cases "1-73"}
  :negative-controls
  [{:mutation "split limit 0 keeps trailing empties" :main 34}
   {:mutation "split-lines ignores CR before LF" :main 53}
   {:mutation "replace stops after the first hit" :main 61}
   {:mutation "split ignores a positive limit" :main 45}
   {:mutation "empty separator keeps the leading zero-width part" :main 42}]}
 :oracle
 {:route "hand-run reference only; not CI, gate or fallback"
  :command "bb oracle.clj src/kotoba/lang/text.cljk"
  :tool "babashka v1.12.218"
  :inputs-and-outputs "the 37 split / split-lines / replace cases are the
    expected values of test/native/text.kotoba goldens 33-69, copied from
    this run except the named divergence 44; segment-count-text [\"a,b,c\" \",\"] [\",,\" \",\"]
    [\"x日本日\" \"日\"] [\"abc\" \"\"] => (3 3 3 0)"}}
