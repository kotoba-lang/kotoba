(ns kotoba.lang.native-text-test
  (:require [kotoba.lang.text :as text] [kotoba.text :as alias])
  (:export [main]))

;; JUN-718: list equality for the split goldens (count, then each part).
(defn- parts= [got [:list :string] want [:list :string]] :bool
  (and (= (count got) (count want))
       (loop [i 0]
         (cond (>= i (count want)) true
               (not (string=? (typed-list-nth [:list :string] got i)
                              (typed-list-nth [:list :string] want i))) false
               :else (recur (inc i))))))

(defn- strs [] [:list :string] (typed-list-new [:list :string]))

(defn main [] :i64
  (cond (not (string=? (text/ascii-lower "ABC-Σ-あ-İ") "abc-Σ-あ-İ")) 1
        (not (text/starts-with? "あいう" "あ")) 2
        (text/starts-with? "あ" "あい") 3
        (not (text/ends-with? "あいう" "う")) 4
        (text/ends-with? "あ" "いあ") 5
        (not (text/includes? "あ😀う" "😀")) 6
        (not (text/includes? "" "")) 7
        (not (string=? (text/trim "　\t hello 　") "hello")) 8
        (not (string=? (text/trim " hello ") " hello ")) 9
        (not (string=? (text/trim " hello ") " hello ")) 10
        (not (string=? (text/triml "　あ　") "あ　")) 11
        (not (string=? (text/trimr "　あ　") "　あ")) 12
        (not (text/blank? "　\n\t")) 13
        (text/blank? " ") 14
        (not (string=? (text/trim "") "")) 15
        (not (string=? (text/trim "😀") "😀")) 16
        (not (alias/ends-with? "共有😀" "😀")) 17
        (not (string=? (alias/trim "　共有　") "共有")) 18
        (not (string=? (alias/triml "　共有　") "共有　")) 19
        (not (string=? (alias/trimr "　共有　") "　共有")) 20
        (not= (option-value-of [:option :i64] (text/index-of "あ😀a😀" "😀") -1) 1) 21
        (not= (option-value-of [:option :i64] (text/index-of "あ😀a😀" "😀" 2) -1) 4) 22
        (not= (option-value-of [:option :i64] (text/index-of "あ😀a😀" "a") -1) 3) 23
        (not= (option-value-of [:option :i64] (text/index-of "あ😀" "" 999) -1) 3) 24
        (not= (option-value-of [:option :i64] (text/index-of "あ😀" "" -9) -1) 0) 25
        (option-some?-of [:option :i64] (text/index-of "あ" "い")) 26
        (not= (option-value-of [:option :i64] (alias/index-of "😀a" "a") -1) 2) 27
        (not= (option-value-of [:option :i64] (alias/index-of "😀a😀" "😀" 1) -1) 3) 28
        (not (string=? (text/join "|" (typed-list-new [:list :string] "あ" "" "😀")) "あ||😀")) 29
        (not (string=? (text/join (typed-list-new [:list :string] "あ" "" "😀")) "あ😀")) 30
        (not (string=? (text/join "," (typed-list-new [:list :string])) "")) 31
        (not (string=? (alias/join "/" (typed-list-new [:list :string] "a" "b")) "a/b")) 32
        ;; JUN-718 goldens: text.cljk answers (bb 1.12.218, 2026-10-31).
        (not (parts= (text/split "a,b,,c" ",") (typed-list-new [:list :string] "a" "b" "" "c"))) 33
        (not (parts= (text/split "a,b,c,," ",") (typed-list-new [:list :string] "a" "b" "c"))) 34
        (not (parts= (text/split ",a,b" ",") (typed-list-new [:list :string] "" "a" "b"))) 35
        (not (parts= (text/split "" ",") (typed-list-new [:list :string] ""))) 36
        (not (parts= (text/split "abc" ",") (typed-list-new [:list :string] "abc"))) 37
        (not (parts= (text/split ",,," ",") (strs))) 38
        (not (parts= (text/split "a::b::c" "::") (typed-list-new [:list :string] "a" "b" "c"))) 39
        (not (parts= (text/split "あ、い、う" "、") (typed-list-new [:list :string] "あ" "い" "う"))) 40
        (not (parts= (text/split "x😀y😀" "😀") (typed-list-new [:list :string] "x" "y"))) 41
        (not (parts= (text/split "abc" "") (typed-list-new [:list :string] "a" "b" "c"))) 42
        (not (parts= (text/split "" "") (typed-list-new [:list :string] ""))) 43
        ;; 44 is the named divergence: the JVM answers ["a" "\uD83D" "\uDE00" "b"].
        (not (parts= (text/split "a😀b" "") (typed-list-new [:list :string] "a" "😀" "b"))) 44
        (not (parts= (text/split "a,b,c" "," 2) (typed-list-new [:list :string] "a" "b,c"))) 45
        (not (parts= (text/split "a,b,c" "," 1) (typed-list-new [:list :string] "a,b,c"))) 46
        (not (parts= (text/split "a,b,," "," -1) (typed-list-new [:list :string] "a" "b" "" ""))) 47
        (not (parts= (text/split "a,b,," "," 0) (typed-list-new [:list :string] "a" "b"))) 48
        (not (parts= (text/split "a,b,," "," 9) (typed-list-new [:list :string] "a" "b" "" ""))) 49
        (not (parts= (text/split "a" "," 3) (typed-list-new [:list :string] "a"))) 50
        (not (parts= (text/split "abc" "" 2) (typed-list-new [:list :string] "a" "bc"))) 51
        (not (parts= (text/split "key: value: x" ":" 2) (typed-list-new [:list :string] "key" " value: x"))) 52
        (not (parts= (text/split-lines "a\nb\r\nc") (typed-list-new [:list :string] "a" "b" "c"))) 53
        (not (parts= (text/split-lines "a\n\n") (typed-list-new [:list :string] "a"))) 54
        (not (parts= (text/split-lines "") (typed-list-new [:list :string] ""))) 55
        (not (parts= (text/split-lines "\n") (strs))) 56
        (not (parts= (text/split-lines "a\rb") (typed-list-new [:list :string] "a\rb"))) 57
        (not (parts= (text/split-lines "a\r\r\nb") (typed-list-new [:list :string] "a\r" "b"))) 58
        (not (parts= (text/split-lines "\r\n\r\nx\r") (typed-list-new [:list :string] "" "" "x\r"))) 59
        (not (parts= (text/split-lines "一\n二") (typed-list-new [:list :string] "一" "二"))) 60
        (not (string=? (text/replace "a_b_c" "_" "-") "a-b-c")) 61
        (not (string=? (text/replace "aaa" "aa" "b") "ba")) 62
        (not (string=? (text/replace "abc" "" "x") "abc")) 63
        (not (string=? (text/replace "a$1b" "$1" "\\") "a\\b")) 64
        (not (string=? (text/replace "x&y<z>" "&" "&amp;") "x&amp;y<z>")) 65
        (not (string=? (text/replace "a—b" "—" "--") "a--b")) 66
        (not (string=? (text/replace "abc" "z" "q") "abc")) 67
        (not (string=? (text/replace "😀a😀" "😀" "") "a")) 68
        (not (string=? (text/replace "ab" "b" "$0") "a$0")) 69
        (not (parts= (alias/split "a,b" ",") (typed-list-new [:list :string] "a" "b"))) 70
        (not (parts= (alias/split "a,b,c" "," 2) (typed-list-new [:list :string] "a" "b,c"))) 71
        (not (parts= (alias/split-lines "a\r\nb") (typed-list-new [:list :string] "a" "b"))) 72
        (not (string=? (alias/replace "a_b" "_" "-") "a-b")) 73
        :else 0))
