(ns kotoba.lang.native-text-test
  (:require [kotoba.lang.text :as text] [kotoba.text :as alias])
  (:export [main]))

(defn main [] :i64
  (cond (not (string=? (text/ascii-lower "ABC-Σ-あ-İ") "abc-Σ-あ-İ")) 1
        (not (text/starts-with? "あいう" "あ")) 2
        (text/starts-with? "あ" "あい") 3
        (not (text/ends-with? "あいう" "う")) 4
        (text/ends-with? "あ" "いあ") 5
        (not (text/includes? "あ😀う" "😀")) 6
        (not (text/includes? "" "")) 7
        (not (string=? (text/trim "　\t hello 　") "hello")) 8
        (not (string=? (text/trim " hello ") " hello ")) 9
        (not (string=? (text/trim " hello ") " hello ")) 10
        (not (string=? (text/triml "　あ　") "あ　")) 11
        (not (string=? (text/trimr "　あ　") "　あ")) 12
        (not (text/blank? "　\n\t")) 13
        (text/blank? " ") 14
        (not (string=? (text/trim "") "")) 15
        (not (string=? (text/trim "😀") "😀")) 16
        (not (alias/ends-with? "共有😀" "😀")) 17
        (not (string=? (alias/trim "　共有　") "共有")) 18
        (not (string=? (alias/triml "　共有　") "共有　")) 19
        (not (string=? (alias/trimr "　共有　") "　共有")) 20
        :else 0))
