(ns kotoba.lang.ns-attr-map-test
  "Every src module's ns attr-map export list is QUOTED: `{:kotoba/export '[...]}`.

  JVM Clojure's `ns` EVALUATES the attr-map (`(.resetMeta (Namespace/find 'n)
  {...})`, right after `in-ns`, before anything is referred), so the bare
  `{:kotoba/export [blank-text? ...]}` this repository carried from 3b57274
  (2026-09-11) to 2026-09-25 failed to load on the JVM with `Unable to resolve
  symbol: blank-text?` -- while SCI stores the map unevaluated, so nothing run
  here ever showed it. The quoted vector loads on both, and amu reads it as the
  unquoted one (kotoba-sema 7e8036a). This test reads the source as data and
  refuses a bare vector, so the JVM failure cannot come back unseen; the
  exports must also be exactly the namespace's public vars."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.lang.text]
            [kotoba.text]
            [kotoba.string]))

(def ^:private fs (js/require "node:fs"))

(def ^:private modules
  {'kotoba.lang.text "lib/kotoba.text/src/kotoba/lang/text.cljk"
   'kotoba.text "lib/kotoba.text/src/kotoba/text.cljk"})

(defn- attr-map [path]
  (let [form (read-string (str (.readFileSync fs path "utf8")))
        tail (drop 2 form)
        tail (if (string? (first tail)) (rest tail) tail)]
    (when (map? (first tail)) (first tail))))

(deftest export-lists-are-quoted-and-exact
  (is (= 2 (count modules)))
  (doseq [[n path] modules]
    (testing (str n)
      (let [v (:kotoba/export (attr-map path))]
        (is (and (seq? v) (= 'quote (first v)) (vector? (second v)))
            (str path ": :kotoba/export must be spelled '[...] (JVM ns evaluates the attr-map)"))
        (is (= (set (keys (ns-publics n))) (set (second v)))
            (str path ": the export list is the namespace's public vars"))))))
