;; Native facade; host aliases retain their existing .cljk implementation.
(ns kotoba.text
  (:export [starts-with? ends-with? includes? blank? ascii-lower trim triml trimr index-of join
            split split-lines replace])
  (:require [kotoba.lang.text :as impl]))

(defn starts-with? [text :string prefix :string] :bool
  (impl/starts-with? text prefix))

(defn includes? [text :string part :string] :bool
  (impl/includes? text part))

(defn blank? [text :string] :bool
  (impl/blank? text))

(defn ascii-lower [text :string] :string
  (impl/ascii-lower text))

(defn ends-with? [text :string suffix :string] :bool
  (impl/ends-with? text suffix))

(defn trim [text :string] :string (impl/trim text))
(defn triml [text :string] :string (impl/triml text))
(defn trimr [text :string] :string (impl/trimr text))

(defn index-of
  ([text :string needle :string] [:option :i64] (impl/index-of text needle))
  ([text :string needle :string from-index :i64] [:option :i64]
   (impl/index-of text needle from-index)))

(defn join
  ([parts [:list :string]] :string (impl/join parts))
  ([separator :string parts [:list :string]] :string (impl/join separator parts)))

(defn split
  ([text :string separator :string] [:list :string] (impl/split text separator))
  ([text :string separator :string limit :i64] [:list :string]
   (impl/split text separator limit)))

(defn split-lines [text :string] [:list :string] (impl/split-lines text))

(defn replace [text :string match :string replacement :string] :string
  (impl/replace text match replacement))
