;; Kotoba-native string operations used by compiler and analyzer modules.
;; The host-compatible implementation remains in text.cljk.
(ns kotoba.lang.text
  (:export [starts-with? ends-with? includes? blank? ascii-lower trim triml trimr index-of join
            split split-lines replace]))

(defn starts-with? [text :string prefix :string] :bool
  (let [prefix-bytes (string-byte-length prefix)]
    (and (<= prefix-bytes (string-byte-length text))
         (string=? (string-substring text 0 prefix-bytes) prefix))))

(defn includes? [text :string part :string] :bool
  (or (= (string-byte-length part) 0) (string-contains? text part)))

(defn ends-with? [text :string suffix :string] :bool
  (let [size (string-byte-length text) suffix-size (string-byte-length suffix)]
    (and (<= suffix-size size)
         (string=? (string-substring text (- size suffix-size) size) suffix))))

;; Match the host oracle's Character/isWhitespace class. Nonbreaking spaces
;; (U+00A0, U+2007, U+202F) remain nonblank on both readings.
(defn- whitespace? [cp :i64] :bool
  (or (and (>= cp 9) (<= cp 13))
      (and (>= cp 28) (<= cp 32))
      (= cp 5760)
      (and (>= cp 8192) (<= cp 8198))
      (and (>= cp 8200) (<= cp 8202))
      (= cp 8232) (= cp 8233) (= cp 8287) (= cp 12288)))

(defn blank? [text :string] :bool
  (loop [i 0]
    (if (>= i (string-byte-length text))
      true
      (let [cp (string-code-point-at text i)
            width (cond (< cp 128) 1 (< cp 2048) 2 (< cp 65536) 3 :else 4)]
        (if (whitespace? cp) (recur (+ i width)) false)))))

(defn ascii-lower [text :string] :string
  (string-fold-ascii text))

(defn- width [cp :i64] :i64
  (cond (< cp 128) 1 (< cp 2048) 2 (< cp 65536) 3 :else 4))

(defn triml [text :string] :string
  (let [size (string-byte-length text)]
    (loop [at 0]
      (if (>= at size) ""
        (let [cp (string-code-point-at text at)]
          (if (whitespace? cp)
            (recur (+ at (width cp)))
            (string-substring text at size)))))))

(defn trimr [text :string] :string
  (let [size (string-byte-length text)]
    (loop [at 0 keep 0]
      (if (>= at size) (string-substring text 0 keep)
        (let [cp (string-code-point-at text at) next (+ at (width cp))]
          (recur next (if (whitespace? cp) keep next)))))))

(defn trim [text :string] :string
  (trimr (triml text)))

;; The typed native reading joins string lists. It does not silently stringify
;; arbitrary host objects or erase empty fields between separators.
(defn join
  ([parts [:list :string]] :string (join "" parts))
  ([separator :string parts [:list :string]] :string
   (loop [index 0 out ""]
     (if (>= index (count parts)) out
       (let [item (typed-list-nth [:list :string] parts index)]
         (recur (inc index)
                (string-concat (if (= index 0) out (string-concat out separator)) item)))))))

;; Match the host index-of contract: a UTF-16 code-unit position or none.
;; The differently named bounded index-of-text returns UTF-8 bytes/-1.
(defn- utf16-length [text :string] :i64
  (loop [at 0 units 0]
    (if (>= at (string-byte-length text)) units
      (let [cp (string-code-point-at text at)]
        (recur (+ at (width cp)) (+ units (if (> cp 65535) 2 1)))))))

(defn- window-matches? [text :string at :i64 needle :string] :bool
  (loop [ti at ni 0]
    (cond (>= ni (string-byte-length needle)) true
          (>= ti (string-byte-length text)) false
          :else
          (let [cp (string-code-point-at text ti)
                nc (string-code-point-at needle ni)]
            (if (not= cp nc) false
              (recur (+ ti (width cp)) (+ ni (width nc))))))))

(defn index-of
  ([text :string needle :string] [:option :i64] (index-of text needle 0))
  ([text :string needle :string from-index :i64] [:option :i64]
   (if (= (string-byte-length needle) 0)
     (option-some-of [:option :i64] (min (max from-index 0) (utf16-length text)))
     (loop [at 0 units 0]
       (cond (and (>= units from-index) (window-matches? text at needle))
               (option-some-of [:option :i64] units)
             (>= at (string-byte-length text)) (option-none-of [:option :i64])
             :else
             (let [cp (string-code-point-at text at)]
               (recur (+ at (width cp)) (+ units (if (> cp 65535) 2 1)))))))))

;; JUN-718: the literal-string half of text.cljk's split / split-lines /
;; replace. A regex has no .kotoba value, so a regex separator or match (and a
;; function replacement) stays with the host oracle; a STRING argument is
;; literal there too (split re-quotes it, replace never expands $N), so these
;; give the oracle's answer for the same strings. Offsets are UTF-8 bytes;
;; a non-empty needle can only match on a code-point boundary, so the parts
;; are the oracle's parts.

(defn- find-from [text :string needle :string from :i64] :i64
  ;; Leftmost byte offset >= from where needle starts, or -1. Compares code
  ;; points (window-matches?), never a byte slice that could end inside one.
  (let [size (string-byte-length text) n (string-byte-length needle)]
    (loop [at from]
      (cond (> (+ at n) size) -1
            (window-matches? text at needle) at
            :else (recur (+ at (width (string-code-point-at text at))))))))

(defn- drop-trailing-empty [parts [:list :string]] [:list :string]
  (let [keep (loop [k (count parts)]
               (if (= k 0) 0
                 (if (= (string-byte-length (typed-list-nth [:list :string] parts (- k 1))) 0)
                   (recur (- k 1))
                   k)))]
    (loop [i 0 out (typed-list-new [:list :string])]
      (if (>= i keep) out
        (recur (inc i) (typed-list-conj [:list :string] out (typed-list-nth [:list :string] parts i)))))))

;; java.util.regex.Pattern/split limit semantics, as text.cljk reimplements
;; them: limit 0 drops trailing empty parts, a positive limit caps the part
;; count (the last part is the unsplit remainder), a negative limit keeps
;; everything, and no separator anywhere answers [text]. An empty separator
;; splits between code points. Named divergence: the JVM splits a non-BMP
;; code point into its two UTF-16 surrogate halves there, which a UTF-8
;; string cannot hold; this keeps the code point whole.
(defn split
  ([text :string separator :string] [:list :string] (split text separator 0))
  ([text :string separator :string limit :i64] [:list :string]
   (let [size (string-byte-length text)
         sep-size (string-byte-length separator)]
     (loop [search 0 index 0 parts (typed-list-new [:list :string])]
       (let [hit (if (= sep-size 0)
                   (if (> search size) -1 search)
                   (find-from text separator search))
             step (cond (= hit -1) -1
                        (> sep-size 0) (+ hit sep-size)
                        (>= hit size) (+ size 1)
                        :else (+ hit (width (string-code-point-at text hit))))]
         (cond
           (= hit -1)
           (if (and (= index 0) (= (count parts) 0))
             (typed-list-new [:list :string] text)
             (let [all (typed-list-conj [:list :string] parts (string-substring text index size))]
               (if (= limit 0) (drop-trailing-empty all) all)))
           ;; a zero-width match at the very beginning contributes nothing
           (and (= index 0) (= hit 0) (= sep-size 0))
           (recur step index parts)
           (and (> limit 0) (>= (count parts) (- limit 1)))
           (if (and (= index 0) (= (count parts) 0))
             (typed-list-new [:list :string] text)
             (typed-list-conj [:list :string] parts (string-substring text index size)))
           :else
           (recur step (+ hit sep-size)
                  (typed-list-conj [:list :string] parts (string-substring text index hit)))))))))

;; text.cljk's (split s #"\r?\n"): a lone carriage return is not a separator,
;; a CR directly before LF is part of it, and trailing empty lines are dropped.
(defn split-lines [text :string] [:list :string]
  ;; One code-point walk: LF ends a line, and so does CR when the next code
  ;; point is LF (the pair is one separator).
  (let [size (string-byte-length text)]
    (loop [at 0 index 0 parts (typed-list-new [:list :string])]
      (if (>= at size)
        (if (= (count parts) 0)
          (typed-list-new [:list :string] text)
          (drop-trailing-empty
           (typed-list-conj [:list :string] parts (string-substring text index size))))
        (let [cp (string-code-point-at text at)]
          (cond (= cp 10)
                (recur (+ at 1) (+ at 1)
                       (typed-list-conj [:list :string] parts (string-substring text index at)))
                (and (= cp 13) (< (+ at 1) size) (= (string-code-point-at text (+ at 1)) 10))
                (recur (+ at 2) (+ at 2)
                       (typed-list-conj [:list :string] parts (string-substring text index at)))
                :else (recur (+ at (width cp)) index parts)))))))

;; Every non-overlapping LITERAL occurrence of match, left to right. The
;; replacement is literal too ($1 is a dollar and a one), and an empty match
;; answers the text unchanged -- text.cljk's string-match reading.
(defn replace [text :string match :string replacement :string] :string
  (let [size (string-byte-length text) n (string-byte-length match)]
    (if (= n 0)
      text
      (loop [index 0 out ""]
        (let [hit (find-from text match index)]
          (if (= hit -1)
            (string-concat out (string-substring text index size))
            (recur (+ hit n)
                   (string-concat (string-concat out (string-substring text index hit))
                                  replacement))))))))
