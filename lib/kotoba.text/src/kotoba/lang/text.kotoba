;; Kotoba-native string operations used by compiler and analyzer modules.
;; The host-compatible implementation remains in text.cljk.
(ns kotoba.lang.text
  (:export [starts-with?]))

(defn starts-with? [text :string prefix :string] :bool
  (let [prefix-bytes (string-byte-length prefix)]
    (and (<= prefix-bytes (string-byte-length text))
         (string=? (string-substring text 0 prefix-bytes) prefix))))
