;; Port of uvm.sequence (sequence.cljk), Kotoba-native, :document maps.
;;
;; Ported: sequence-item, uvm-sequence, append-item, concat-sequences.
;; NOT ported: apply-sequence and apply-sequence-indexed. Both take a driver
;; function as an argument, and function values are unavailable in Kotoba
;; (E2105). The module's public API is therefore partial.
;;
;; Named divergences from sequence.cljk:
;;   - (vec items) and (update seq :items conj item) use :document vectors; a
;;     seq without :items gets a vector where Clojure's conj on nil gives a
;;     list (the printed form differs, the sequence of elements does not).
;;   - (merge {:kind ...} fields) with fields nil is the kind map alone.

(ns uvm.sequence
  (:export [sequence-item uvm-sequence append-item concat-sequences]))

(defn- nil-doc? [d :document] :bool
  (string=? (document-edn-print d) "nil"))

(defn- field [m :document k :keyword] :document
  (if (map? m)
    (option-or (document-get m k) (document-null))
    (document-null)))

(defn- vec-at [v :document i :i64] :document
  (option-or (document-vector-at v i) (document-null)))

;; elements of a collection as a :document vector (set/list re-read from EDN)
(defn- elems [d :document] :document
  (let [t (document-edn-print d)]
    (if (string=? t "nil")
      (document-vector)
      (if (string=? (string-substring t 0 1) "[")
        d
        (if (string=? (string-substring t 0 1) "#")
          (document-edn-read (string-concat "[" (string-concat (string-substring t 2 (- (string-length t) 1)) "]")))
          (if (string=? (string-substring t 0 1) "(")
            (document-edn-read (string-concat "[" (string-concat (string-substring t 1 (- (string-length t) 1)) "]")))
            (document-vector)))))))

(defn sequence-item
  "A sequence-item (transaction) is just a plain map tagged
  :kind :sequence-item, e.g. `(sequence-item {:addr 0x10 :data 0xff})`."
  [fields :document] :document
  (if (map? fields)
    (document-merge (document-map :kind (document-keyword :sequence-item)) fields)
    (document-map :kind (document-keyword :sequence-item))))

(defn uvm-sequence
  "A sequence is a named, ordered collection of sequence-items:
  `{:name name :items [item ...]}`."
  [name :document items :document] :document
  (document-map :name name :items (elems items)))

(defn append-item
  "Return `seq-map` with `item` appended to its :items."
  [seq-map :document item :document] :document
  (document-assoc seq-map (document-keyword :items)
                  (document-vector-conj (elems (field seq-map :items)) item)))

(defn concat-sequences
  "Compose several sequences into one, concatenating their :items in
  order under `name`."
  [name :document seqs :document] :document
  (let [ss (elems seqs)
        n (document-count ss)]
    (loop [i 0 items (document-vector)]
      (if (= i n)
        (uvm-sequence name items)
        (let [its (elems (field (vec-at ss i) :items))
              m (document-count its)]
          (recur (+ i 1)
                 (loop [j 0 acc items]
                   (if (= j m)
                     acc
                     (recur (+ j 1) (document-vector-conj acc (vec-at its j)))))))))))
