(ns uvm.sequence-test (:export [main]) (:require [uvm.sequence :as p]))

(defn- kw [k :keyword] :document (document-keyword k))
(defn- str [s :string] :document (document-string s))
(defn- get-or-null [m :document k :keyword] :document
  (option-or (document-get m k) (document-null)))

(defn- item [addr :i64] :document
  (p/sequence-item (document-map :addr (document-i64 addr) :data (document-i64 255))))

(defn- case-item [] :i64
  (let [it (item 16)]
    (+ (if (document-equal? (get-or-null it :kind) (kw :sequence-item)) 0 1)
       (if (document-equal? (get-or-null it :addr) (document-i64 16)) 0 1)
       (if (document-equal? (get-or-null it :data) (document-i64 255)) 0 1)
       (if (document-equal? (p/sequence-item (document-null)) (document-map :kind (kw :sequence-item))) 0 1)
       (if (document-equal? (get-or-null (p/sequence-item (document-map :kind (kw :other))) :kind) (kw :other)) 0 1))))

(defn- case-sequence [] :i64
  (let [s (p/uvm-sequence (str "s1") (document-vector (item 1) (item 2)))
        e (p/uvm-sequence (str "empty") (document-null))]
    (+ (if (document-equal? (get-or-null s :name) (str "s1")) 0 1)
       (if (= (document-count (get-or-null s :items)) 2) 0 1)
       (if (document-equal? (get-or-null s :items) (document-vector (item 1) (item 2))) 0 1)
       (if (= (document-count (get-or-null e :items)) 0) 0 1))))

(defn- case-append [] :i64
  (let [s (p/append-item (p/uvm-sequence (str "s1") (document-vector)) (item 7))
        t (p/append-item s (item 8))]
    (+ (if (= (document-count (get-or-null s :items)) 1) 0 1)
       (if (document-equal? (option-or (document-vector-at (get-or-null t :items) 1) (document-null)) (item 8)) 0 1)
       (if (document-equal? (option-or (document-vector-at (get-or-null t :items) 0) (document-null)) (item 7)) 0 1))))

(defn- case-concat [] :i64
  (let [a (p/uvm-sequence (str "a") (document-vector (item 1)))
        b (p/uvm-sequence (str "b") (document-vector (item 2) (item 3)))
        c (p/concat-sequences (str "ab") (document-vector a b))]
    (+ (if (document-equal? (get-or-null c :name) (str "ab")) 0 1)
       (if (document-equal? (get-or-null c :items) (document-vector (item 1) (item 2) (item 3))) 0 1)
       (if (= (document-count (get-or-null (p/concat-sequences (str "none") (document-vector)) :items)) 0) 0 1))))

(defn main [] :i64
  (+ (case-item) (case-sequence) (case-append) (case-concat)))
