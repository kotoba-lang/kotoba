;; One mutation per decision this change makes. `:find` must occur EXACTLY
;; ONCE in `:file` — `tools/mutate.cljk` refuses otherwise, because a
;; mutation that landed in a comment or in a second call site produces a red
;; suite that proves nothing.
;;
;; SCOPE: this table covers ONLY what agent/tax-categories added — the tax
;; category on a rate card, `card-key`, the per-category subtotals on an
;; invoice and their refusal, and `describe-tax-gap`. It does NOT measure the
;; rest of kotoba.psa. The four pre-existing invariants (no rate no line,
;; margin needs both sides, utilization needs a denominator, no rate no
;; conversion) have their own tests and are not mutated here, so a clean run
;; of this table says nothing about them.
;;
;; Read the pair before trusting a red: the thing broken and the thing
;; reported must be the same thing.
[{:id :partial-map-emitted
  :invariant "an incomplete subtotal map is :unknown, never a partial map"
  :file "src/kotoba/psa.cljk"
  :find "(if complete?\n       (reduce (fn [acc l]"
  :replace "(if true\n       (reduce (fn [acc l]"}

 {:id :complete-flag-always-true
  :invariant "the completeness flag tracks the gaps"
  :file "src/kotoba/psa.cljk"
  :find ":invoice/subtotals-complete? complete?"
  :replace ":invoice/subtotals-complete? true"}

 {:id :uncategorised-not-named
  :invariant "the cards missing a category are named, like :invoice/unpriced"
  :file "src/kotoba/psa.cljk"
  :find ":invoice/uncategorised       uncategorised"
  :replace ":invoice/uncategorised       []"}

 {:id :gaps-set-always-empty
  :invariant "the reason set reports why the subtotals were refused"
  :file "src/kotoba/psa.cljk"
  :find ":invoice/subtotals-gaps      gaps"
  :replace ":invoice/subtotals-gaps      #{}"}

 {:id :gap-reason-renamed
  :invariant "the reason keyword is part of the contract, not a label"
  :file "src/kotoba/psa.cljk"
  :find "(conj :uncategorised-cards)"
  :replace "(conj :cards-uncategorised)"}

 {:id :mixed-currency-undetected
  :invariant "contributing cards that disagree on a currency refuse"
  :file "src/kotoba/psa.cljk"
  :find "mixed? (> (count currencies) 1)"
  :replace "mixed? (> (count currencies) 99)"}

 {:id :subtotals-currency-not-stated
  :invariant "the subtotals state the unit they are in"
  :file "src/kotoba/psa.cljk"
  :find "(if mixed? :unknown (first currencies))"
  :replace "(if mixed? :unknown nil)"}

 {:id :cards-used-includes-unpriced
  :invariant "subtotals partition the LINES; unpriced entries are not lines"
  :file "src/kotoba/psa.cljk"
  :find "cards-used (vec (distinct (map :priced/rate billable)))"
  :replace "cards-used (vec (distinct (map :priced/rate priced)))"}

 {:id :line-category-is-the-role
  :invariant "a line carries its tax category, not something else"
  :file "src/kotoba/psa.cljk"
  :find "[:priced/rate :rate/tax-category])}))"
  :replace "[:priced/rate :rate/role])}))"}

 {:id :card-key-drops-role
  :invariant "a card is identified by [project role], so two roles differ"
  :file "src/kotoba/psa.cljk"
  :find "[(:rate/project c) (:rate/role c)])"
  :replace "[(:rate/project c)])"}

 {:id :subtotals-max-not-sum
  :invariant "two roles in one category ADD; one does not win"
  :file "src/kotoba/psa.cljk"
  :find "(fnil + 0)"
  :replace "(fnil max 0)"}

 {:id :rate-card-drops-category
  :invariant "the declared category survives onto the card"
  :file "src/kotoba/psa.cljk"
  :find ":rate/tax-category tax-category})"
  :replace ":rate/tax-category nil})"}

 {:id :tax-gap-text-when-clean
  :invariant "describe-tax-gap is empty when there is nothing to say"
  :file "src/kotoba/psa.cljk"
  :find "(contains? gaps :uncategorised-cards)"
  :replace "(some? gaps)"}

 {:id :empty-invoice-refuses
  :invariant "an invoice with no lines owes no tax; {} is a real answer"
  :file "src/kotoba/psa.cljk"
  :find "complete? (empty? gaps)"
  :replace "complete? (and (seq lines) (empty? gaps))"}

 ;; --- second batch, written against the source AFTER the first table came
 ;; back 14/14. A clean first run usually means the mutations tracked the
 ;; tests, so these deliberately aim at decisions no test was written for.

 {:id :uncategorised-order-unstable
  :invariant "the named cards come back in a stable order"
  :file "src/kotoba/psa.cljk"
  :find "(sort-by str)"
  :replace "reverse"}

 {:id :cards-used-not-deduplicated
  :invariant "a card that priced two entries is named once, not twice"
  :file "src/kotoba/psa.cljk"
  :find "(vec (distinct (map :priced/rate billable)))"
  :replace "(vec (map :priced/rate billable))"}

 {:id :currencies-not-deduplicated
  :invariant "three cards all in JPY agree on a currency"
  :file "src/kotoba/psa.cljk"
  :find "currencies (vec (distinct (map :rate/currency cards-used)))"
  :replace "currencies (vec (map :rate/currency cards-used))"}

 {:id :subtotals-sum-hours-not-money
  :invariant "a subtotal is an amount, not an hour count"
  :file "src/kotoba/psa.cljk"
  :find "(fnil + 0) (:line/amount l)"
  :replace "(fnil + 0) (:line/hours l)"}

 {:id :tax-gap-count-hardcoded
  :invariant "describe-tax-gap counts the cards it is describing"
  :file "src/kotoba/psa.cljk"
  :find "(count (:invoice/uncategorised inv))"
  :replace "1"}

 {:id :no-lines-counts-as-mixed
  :invariant "no contributing card is not the same as two disagreeing ones"
  :file "src/kotoba/psa.cljk"
  :find "mixed? (> (count currencies) 1)"
  :replace "mixed? (not= (count currencies) 1)"}

 ;; --- `:invoice/total` and the currencies it may have added together
 ;; (2026-08-18). The total's wrongness on a mixed invoice is NOT fixed here
 ;; and these mutations do not pretend it is; they measure the detector. ---

 {:id :a-mixed-total-is-not-marked-single
  :invariant "the total can no longer be read as one currency without checking"
  :file "src/kotoba/psa.cljk"
  :find "       (<= (count (distinct (keep :rate/currency cards-used))) 1)"
  :replace "       true"}

 {:id :the-currencies-are-not-named
  :invariant "which currencies, not just how many — named, not counted"
  :file "src/kotoba/psa.cljk"
  :find "       :invoice/currencies (vec (sort (distinct (keep :rate/currency cards-used))))"
  :replace "       :invoice/currencies []"}

 {:id :one-currency-is-not-two
  :invariant "a single-currency invoice is not reported as mixed"
  :file "src/kotoba/psa.cljk"
  :find "(keep :rate/currency cards-used))) 1)"
  :replace "(keep :rate/currency cards-used))) 0)"}

 {:id :offered-cards-are-not-used-cards
  :invariant "a card that priced nothing must not make the total look mixed"
  :file "src/kotoba/psa.cljk"
  :find "       :invoice/total-is-one-currency?\n       (<= (count (distinct (keep :rate/currency cards-used))) 1)"
  :replace "       :invoice/total-is-one-currency?\n       (<= (count (distinct (keep :rate/currency cards))) 1)"}

 {:id :the-total-itself-is-untouched
  :invariant "this change adds a detector and does NOT redefine the total"
  :file "src/kotoba/psa.cljk"
  :find "       :invoice/total    (reduce + 0 (map :line/amount lines))"
  :replace "       :invoice/total    (reduce + 0 (map :line/hours lines))"}]