(ns org-threejs.core-test
  (:require [org-threejs.core :as t]
            [org-threejs.interop :as i]
            [org-threejs.gltf]
            [org-threejs.vrm :as vrm]
            [org-threejs.webgpu]))

(defn main []
  (let [scene (t/scene)
        v (i/vec3 [1 2 3])]
    (assert (string? t/revision))
    (assert (= [1 2 3] [(.-x v) (.-y v) (.-z v)]))
    (assert (vrm/loader))
    (assert scene)
    (println "org-threejs CLJS bindings: passed · Three revision" t/revision)))
