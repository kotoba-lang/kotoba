(ns org-threejs.core
  "Small, idiomatic CLJS surface over Three.js. Owns no kami render-IR and
  deliberately does not depend on kami.webgpu or kami.webgl."
  (:require ["three" :as three]))

(def revision three/REVISION)
(defn scene [] (three/Scene.))
(defn perspective-camera
  ([aspect] (perspective-camera 50 aspect 0.1 2000))
  ([fov aspect near far] (three/PerspectiveCamera. fov aspect near far)))
(defn webgl-renderer
  ([canvas] (webgl-renderer canvas {}))
  ([canvas {:keys [antialias alpha power-preference]
            :or {antialias true alpha false power-preference "high-performance"}}]
   (three/WebGLRenderer.
    #js {:canvas canvas :antialias antialias :alpha alpha :powerPreference power-preference})))
(defn clock [] (three/Clock.))
(defn ambient-light [color intensity] (three/AmbientLight. color intensity))
(defn directional-light [color intensity] (three/DirectionalLight. color intensity))
(defn hemisphere-light [sky ground intensity] (three/HemisphereLight. sky ground intensity))
(defn box-geometry [] (three/BoxGeometry. 1 1 1))
(defn sphere-geometry [] (three/SphereGeometry. 0.5 20 14))
(defn cylinder-geometry [] (three/CylinderGeometry. 0.5 0.5 1 16))
(defn standard-material
  [{:keys [color metallic roughness emissive transparent opacity]
    :or {color 0xffffff metallic 0.0 roughness 0.7 emissive 0.0 opacity 1.0}}]
  (three/MeshStandardMaterial.
   #js {:color color :metalness metallic :roughness roughness
        :emissive color :emissiveIntensity emissive
        :transparent (boolean transparent) :opacity opacity}))
(defn mesh [geometry material] (three/Mesh. geometry material))
(defn group [] (three/Group.))
(defn grid-helper [size divisions color-center color-grid]
  (three/GridHelper. size divisions color-center color-grid))
(defn color [hex] (three/Color. hex))
(defn set-fog! [scene color near far]
  (set! (.-fog scene) (three/Fog. color near far)) scene)
(defn set-position! [object x y z] (.set (.-position object) x y z) object)
(defn set-scale! [object x y z] (.set (.-scale object) x y z) object)
(defn set-rotation-x! [object x] (set! (.. object -rotation -x) x) object)
(defn set-rotation-y! [object y] (set! (.. object -rotation -y) y) object)
(defn set-rotation-z! [object z] (set! (.. object -rotation -z) z) object)
(defn look-at! [camera x y z] (.lookAt camera x y z) camera)
(defn add! [parent child] (.add parent child) child)
(defn remove! [parent child] (.remove parent child) child)
(defn visible! [object visible?] (set! (.-visible object) visible?) object)
(defn set-material! [object {:keys [color metallic roughness emissive]}]
  (let [m (.-material object)]
    (when color (.setHex (.-color m) color))
    (when (some? metallic) (set! (.-metalness m) metallic))
    (when (some? roughness) (set! (.-roughness m) roughness))
    (when color (.setHex (.-emissive m) color))
    (set! (.-emissiveIntensity m) (or emissive 0.0)))
  object)
(defn dispose-object! [object]
  (when-let [g (.-geometry object)] (.dispose g))
  (when-let [m (.-material object)] (.dispose m))
  object)
(defn set-size! [renderer width height & [update-style?]]
  (.setSize renderer width height (if (nil? update-style?) true update-style?)) renderer)
(defn set-pixel-ratio! [renderer ratio] (.setPixelRatio renderer ratio) renderer)
(defn set-clear-color! [renderer color alpha] (.setClearColor renderer color alpha) renderer)
(defn render! [renderer scene camera] (.render renderer scene camera) renderer)
(defn dispose! [renderer] (.dispose renderer))

(defn start-loop!
  "Run tick with {:time seconds :delta seconds}, then render. Returns stop!."
  [renderer scene camera tick]
  (let [running? (atom true) timer (clock)]
    (letfn [(frame [time-ms]
              (when @running?
                (tick {:time (/ time-ms 1000.0) :delta (.getDelta timer)})
                (render! renderer scene camera)
                (js/requestAnimationFrame frame)))]
      (js/requestAnimationFrame frame)
      (fn stop! [] (reset! running? false)))))
