(ns org-threejs.interop
  "Plain-data helpers at the CLJS/Three.js boundary."
  (:require ["three" :as three]))

(defn vec3 [[x y z]] (three/Vector3. x y z))
(defn quat [[x y z w]] (three/Quaternion. x y z w))
(defn set-vec3! [target [x y z]] (.set target x y z) target)
(defn set-quat! [target [x y z w]] (.set target x y z w) target)
(defn object-by-name [root object-name] (.getObjectByName root object-name))
(defn add! [parent child] (.add parent child) parent)
(defn remove! [parent child] (.remove parent child) parent)
