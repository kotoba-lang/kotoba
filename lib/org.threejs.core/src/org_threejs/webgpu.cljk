(ns org-threejs.webgpu
  "Optional Three.js WebGPURenderer path; import only when an application wants it."
  (:require ["three/webgpu" :as three-webgpu]))

(defn renderer
  ([canvas] (renderer canvas {}))
  ([canvas {:keys [antialias alpha] :or {antialias true alpha false}}]
   (three-webgpu/WebGPURenderer. #js {:canvas canvas :antialias antialias :alpha alpha})))

(defn init! [renderer] (.init renderer))
(defn render-async! [renderer scene camera] (.renderAsync renderer scene camera))
