(ns org-threejs.vrm
  "VRM lifecycle helpers built on the official @pixiv/three-vrm plugin."
  (:require ["three/addons/loaders/GLTFLoader.js" :refer [GLTFLoader]]
            ["@pixiv/three-vrm" :as three-vrm]))

(defn loader
  "Create a GLTFLoader registered for VRM 0.x and VRM 1.0 files."
  []
  (doto (GLTFLoader.)
    (.register (fn [parser] (three-vrm/VRMLoaderPlugin. parser)))))

(defn vrm-from-gltf
  "Return the VRM instance installed by VRMLoaderPlugin, or nil."
  [gltf]
  (some-> gltf .-userData .-vrm))

(defn load!
  "Load a VRM URL and resolve to the VRM instance rather than the raw GLTF."
  ([url] (load! (loader) url))
  ([vrm-loader url]
   (js/Promise.
    (fn [resolve reject]
      (.load vrm-loader
             url
             (fn [gltf]
               (if-let [vrm (vrm-from-gltf gltf)]
                 (resolve vrm)
                 (reject (js/Error. (str "No VRM payload in " url)))))
             nil
             reject)))))

(defn scene [vrm] (.-scene vrm))

(defn normalized-bone
  "Return a normalized humanoid bone node by VRM 1.0 bone name, or nil.
   Keeping this lookup here prevents application CLJS from reaching through the
   three-vrm object graph and gives VRM 0.x/1.0 the same posing surface."
  [vrm bone-name]
  (some-> vrm .-humanoid (.getNormalizedBoneNode bone-name)))

(defn set-humanoid-pose!
  "Apply a small normalized-humanoid pose map. Values are Euler XYZ radians.
   Unknown/optional bones are ignored, so a valid partial humanoid remains
   renderable instead of failing the whole frame."
  [vrm pose]
  (doseq [[bone-name [x y z]] pose]
    (when-let [bone (normalized-bone vrm (name bone-name))]
      (.set (.-rotation bone) x y z)))
  vrm)

(defn update!
  "Advance spring bones, constraints, expressions, and look-at state."
  [vrm delta-seconds]
  (.update vrm delta-seconds)
  vrm)

(defn rotate-vrm0!
  "Normalize legacy VRM 0.x forward direction when its metadata requires it."
  [vrm]
  (.rotateVRM0 three-vrm/VRMUtils vrm)
  vrm)

(defn remove-unnecessary-joints!
  "Combine compatible skeletons after load; retained under the original public
   name so existing CLJS callers gain the current three-vrm optimization."
  [vrm]
  (.combineSkeletons three-vrm/VRMUtils (scene vrm))
  vrm)

(defn dispose!
  "Release geometries, materials, and textures owned by this VRM scene."
  [vrm]
  (when-let [root (scene vrm)]
    (.deepDispose three-vrm/VRMUtils root))
  nil)
