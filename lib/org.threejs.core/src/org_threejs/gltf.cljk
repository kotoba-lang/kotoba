(ns org-threejs.gltf
  "Promise-based CLJS wrapper for the official Three.js GLTFLoader addon."
  (:require ["three/addons/loaders/GLTFLoader.js" :refer [GLTFLoader]]))

(defn loader [] (GLTFLoader.))
(defn load!
  ([url] (load! (loader) url))
  ([loader url]
   (js/Promise.
    (fn [resolve reject]
      (.load loader url resolve nil reject)))))
