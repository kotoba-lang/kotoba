  import http: func(request: string) -> string;
  import stdio: func(request: string) -> string;
  import filesystem: func(request: string) -> string;
  import clock: func(request: string) -> string;

  export initialize: func(request: string) -> string;
  export tools-list: func(request: string) -> string;
  export tools-call: func(request: string) -> string;
  export resources-list: func(request: string) -> string;
  export prompts-list: func(request: string) -> string;
}
