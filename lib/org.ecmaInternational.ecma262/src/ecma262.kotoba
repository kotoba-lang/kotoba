(ns ecma262
  ;; A JavaScript (ECMA-262 subset) interpreter written in Kotoba.
  ;;
  ;; JavaScript source is RUNTIME INPUT to this program -- a string. amu never
  ;; sees it. amu compiles THIS program, and the compiled program then reads
  ;; and evaluates the JavaScript. That is the same shape QuickJS has (a C
  ;; program compiled to Wasm by emcc); the C is replaced by Kotoba and emcc
  ;; by amu, and the host slot in `kotoba-lang/browser` does not move.
  ;;
  ;; ## Why there is no AST, and when that should change
  ;;
  ;; This is a DIRECT scannerless evaluator: it parses and evaluates in one
  ;; pass over the source string, and re-reads a loop body or a function body
  ;; from its source index each time it runs. That is not the natural way to
  ;; write an interpreter and it is not a claim about how Kotoba programs
  ;; should be written. It is forced by two limits measured on 2026-08-29:
  ;;
  ;;   * A typed ADT value is capped at 64 nodes and depth 12
  ;;     (`kotoba-kir`'s `adt-node-limit` / `adt-depth-limit`, enforced at
  ;;     RUNTIME by the emitted `assertTypedValue`). A record with four
  ;;     `[:option [:ref :js/node]]` child slots costs about eight nodes per
  ;;     AST node, so an AST tops out near SIX nodes -- `(1 + 2) * 3` already
  ;;     exceeds it. There is no CLI knob; both are constants.
  ;;   * `[:vector [:ref :js/node]]` is rejected as `value type is outside
  ;;     the safe profile`, so a flat node arena cannot be a vector of
  ;;     records either, and `[:map :i64 [:ref :js/node]]` holds 31 entries.
  ;;
  ;; REMOVE THIS DESIGN when either limit moves: an AST is better in every
  ;; other way. The engine keeps its public entry points, so the change is
  ;; internal.
  ;;
  ;; ## Environment
  ;;
  ;; The environment is a STRING for the same reason: a record holding both a
  ;; value and a collection blows the same 64-node budget. Entries are
  ;; length-prefixed so a value may contain any character:
  ;;
  ;;     <name>=<type-char><text-length>:<text>\n
  ;;
  ;; and a new binding is PREPENDED, so lookup finds the newest first and
  ;; assignment costs nothing. Bound by the 64 KiB string ceiling rather than
  ;; the 31-entry typed-map ceiling.
  ;;
  ;; ## Errors
  ;;
  ;; `throw` is permanently absent from Kotoba (:intentional-security-
  ;; constraint), so a syntax or evaluation failure is a `:error` VALUE
  ;; carrying its message, and callers test for it.
  (:export [main eval-number eval-string eval-typeof eval-ok
            eval-dom eval-dom-value eval-dom-event eval-dom-event-arg
            dom-entry dom-node dom-node-attr dom-node-prop dom-put
            test-number test-arith test-precedence test-parens
            test-negative test-modulo test-division test-nested-parens
            test-string-literal test-string-concat test-string-number
            test-boolean test-comparison test-equality test-inequality
            test-strict-equality test-strict-inequality
            test-logical-or test-logical-and test-not test-truthiness
            test-var test-let-const test-assign test-reassign
            test-multiple-vars test-var-in-expression
            test-if test-if-else test-if-false-skips test-nested-if
            test-while test-while-never-runs test-while-accumulate
            test-block test-empty-program test-semicolons test-comments
            test-string-compare test-typeof-number test-typeof-string
            test-typeof-boolean test-typeof-undefined
            test-syntax-error test-unterminated-string test-undefined-variable
            test-unbalanced-paren test-error-propagates
            test-function test-function-args test-function-expression-value
            test-nested-call test-recursion test-early-return
            test-hoisted-call test-mutual-recursion
            test-missing-argument test-extra-argument
            test-typeof-function test-calling-a-non-function
            test-parameters-do-not-leak test-function-sees-globals
            test-return-without-value test-string-returning-function
            test-array-literal test-array-index test-array-length
            test-array-assign test-array-grow test-array-of-strings
            test-array-in-loop test-empty-array test-nested-array
            test-object-literal test-object-dot test-object-bracket
            test-object-assign test-object-new-key test-object-missing-key
            test-nested-object test-object-in-array test-array-in-object
            test-typeof-object test-typeof-array test-string-length
            test-array-string-render test-object-string-render
            test-array-from-function test-object-holds-function
            test-for-loop test-for-sum test-for-no-iterations
            test-for-over-array test-for-nested test-for-return
            test-method-call test-method-with-args test-call-from-array
            test-chained-call test-method-on-nested-object
            test-closure-captures-parameter test-closure-outlives-its-frame
            test-closure-shadows-caller test-closure-sees-outer-var
            test-nested-function-declaration test-nested-mutual-recursion
            test-this-on-object test-this-reads-sibling-property
            test-plain-call-this-is-the-global-object
            test-array-join test-array-join-default test-array-index-of
            test-array-index-of-missing test-array-includes test-array-slice
            test-string-char-at test-string-index-of test-string-substring
            test-string-lower test-string-split test-string-split-length
            test-string-includes test-own-property-beats-builtin
            test-throw-string test-throw-number test-catch-binds-value
            test-try-without-throw test-catch-reference-error
            test-catch-type-error test-try-continues-after
            test-throw-from-function test-catch-inside-function
            test-nested-try test-throw-object
            test-counter-keeps-state test-two-closures-share-one-cell
            test-callee-mutates-callers-variable test-loop-closures-share-var
            test-function-expression test-function-expression-immediate
            test-function-expression-in-array test-named-function-expression
            test-declaration-needs-a-name
            test-break-in-while test-break-in-for test-continue-in-for
            test-break-only-leaves-the-inner-loop test-break-inside-if
            test-finally-runs test-finally-after-throw test-finally-without-catch
            test-finally-return-wins test-finally-sees-catch-binding
            test-typeof-undeclared test-typeof-member-of-undeclared-throws
            test-typeof-declared-still-reports-its-type
            test-string-upper test-method-reference-is-truthy
            test-property-of-null-throws test-property-of-undefined-throws
            test-new-error-message test-new-error-name test-new-error-no-args
            test-new-unknown-constructor test-thrown-new-error-is-an-object
            test-plus-equals test-plus-equals-string test-minus-equals
            test-times-equals test-postfix-increment test-postfix-in-for
