;; --- callbacks -------------------------------------------------------------
(defn test-filter [] (num-is "[1, 2, 3, 4].filter(function(x) { return x > 2; }).length" 2))
(defn test-filter-none [] (num-is "[1, 2].filter(function(x) { return x > 9; }).length" 0))
(defn test-filter-all [] (num-is "[1, 2].filter(function(x) { return true; }).length" 2))
(defn test-map [] (str-is "[1, 2, 3].map(function(x) { return x * 2; }).join(',')" "2,4,6"))
(defn test-map-to-strings []
  (str-is "[1, 2].map(function(x) { return 'n' + x; }).join('-')" "n1-n2"))
(defn test-for-each-side-effect []
  (num-is "var t = 0; [1, 2, 3].forEach(function(x) { t = t + x; }); t" 6))
;; The callback runs in the environment it was written in, and its writes are
;; seen by the caller -- the same cells, not a copy.
(defn test-callback-sees-outer []
  (num-is "var k = 10; var r = [1, 2].map(function(x) { return x + k; }); r[1]" 12))
(defn test-filter-then-join []
  (str-is "[1, 2, 3, 4].filter(function(x) { return x % 2 == 0; }).join('|')" "2|4"))
;; The exact shape every smoke test in kotoba-lang/browser is written in.
(defn test-smoke-suite-shape []
  (str-is "var r = []; r.push(1 === 1 ? 1 : 'a-failed'); r.push(2 > 1 ? 1 : 'b-failed'); var bad = r.filter(function(x) { return x !== 1; }); bad.length === 0 ? 'PASS' : 'FAIL:' + bad.join(';')" "PASS"))

;; --- Error objects ---------------------------------------------------------
(defn test-error-message [] (str-is "try { nope } catch (e) { e.message }" "nope is not defined"))
(defn test-error-name [] (str-is "try { nope } catch (e) { e.name }" "ReferenceError"))
(defn test-error-is-an-object [] (str-is "try { nope } catch (e) { typeof e }" "object"))
;; A thrown value is handed back untouched -- it is not wrapped in an Error.
(defn test-thrown-value-is-not-wrapped []
  (str-is "try { throw 5; } catch (e) { typeof e }" "number"))
(defn test-type-error-name []
  (str-is "var x = 1; try { x() } catch (e) { e.name }" "TypeError"))

;; --- break / continue ------------------------------------------------------
(defn test-break-in-while []
  (num-is "var i = 0; while (i < 10) { if (i == 3) { break; } i = i + 1; } i" 3))
(defn test-break-in-for []
  (num-is "var t = 0; for (var i = 0; i < 10; i = i + 1) { if (i == 4) { break; } t = t + 1; } t" 4))
;; `continue` must still run the update, or the loop never terminates.
(defn test-continue-in-for []
  (num-is "var t = 0; for (var i = 0; i < 5; i = i + 1) { if (i == 2) { continue; } t = t + 1; } t" 4))
(defn test-break-only-leaves-the-inner-loop []
  (num-is "var t = 0; for (var i = 0; i < 3; i = i + 1) { for (var j = 0; j < 5; j = j + 1) { if (j == 1) { break; } t = t + 1; } } t" 3))
(defn test-break-inside-if []
  (num-is "var i = 0; while (true) { if (i >= 2) { break; } i = i + 1; } i" 2))

;; --- finally ---------------------------------------------------------------
(defn test-finally-runs []
  (num-is "var t = 0; try { t = 1; } catch (e) { t = 2; } finally { t = t + 10; } t" 11))
(defn test-finally-after-throw []
  (num-is "var t = 0; try { throw 1; } catch (e) { t = 5; } finally { t = t + 10; } t" 15))
(defn test-finally-without-catch []
  (num-is "var t = 0; try { t = 1; } finally { t = t + 10; } t" 11))
;; A `return` inside finally wins over the one the try was carrying.
(defn test-finally-return-wins []
  (num-is "function f() { try { return 1; } finally { return 2; } } f()" 2))
(defn test-finally-sees-catch-binding []
  (num-is "var t = 0; try { throw 3; } catch (e) { t = e; } finally { t = t + 1; } t" 4))

;; --- the five gaps the quickjs differential found -------------------------
;; Each of these agreed with nothing until it was fixed; they are the reason
;; `browser`'s test/runtime-differential.cljs exists.
(defn test-typeof-undeclared [] (str-is "typeof nope" "undefined"))
(defn test-typeof-member-of-undeclared-throws []
  (str-is "try { typeof nope.x } catch (e) { e.name }" "ReferenceError"))
(defn test-typeof-declared-still-reports-its-type []
  (str-is "var nope = 1; typeof nope" "number"))
(defn test-string-upper [] (str-is "'abc'.toUpperCase()" "ABC"))
;; The feature-detection idiom: the METHOD, not a call of it.
(defn test-method-reference-is-truthy []
  (str-is "'x'.toUpperCase ? 'has' : 'lacks'" "has"))
(defn test-property-of-null-throws []
  (str-is "try { null.x; 'no-throw' } catch (e) { e.name }" "TypeError"))
(defn test-property-of-undefined-throws []
  (str-is "try { undefined.x; 'no-throw' } catch (e) { 'caught' }" "caught"))
(defn test-new-error-message []
  (str-is "try { throw new Error('boom'); } catch (e) { e.message }" "boom"))
(defn test-new-error-name [] (str-is "new TypeError('x').name" "TypeError"))
(defn test-new-error-no-args [] (str-is "'[' + new Error().message + ']'" "[]"))
(defn test-new-unknown-constructor []
  (str-is "try { new Widget(); 'no-throw' } catch (e) { 'caught' }" "caught"))
(defn test-thrown-new-error-is-an-object []
  (str-is "try { throw new Error('x'); } catch (e) { typeof e }" "object"))

;; --- compound assignment and ++/-- ---------------------------------------
(defn test-plus-equals [] (num-is "var x = 1; x += 2; x" 3))
(defn test-plus-equals-string [] (str-is "var s = 'a'; s += 'b'; s" "ab"))
(defn test-minus-equals [] (num-is "var x = 10; x -= 4; x" 6))
(defn test-times-equals [] (num-is "var x = 3; x *= 4; x" 12))
(defn test-postfix-increment [] (num-is "var x = 1; x++; x" 2))
;; The form every real `for` loop is written in.
(defn test-postfix-in-for []
  (num-is "var t = 0; for (var i = 0; i < 5; i++) { t += i; } t" 10))
(defn test-postfix-answers-the-old-value [] (num-is "var x = 5; var y = x++; y" 5))
(defn test-prefix-increment [] (num-is "var x = 1; ++x; x" 2))
(defn test-prefix-answers-the-new-value [] (num-is "var x = 5; var y = ++x; y" 6))
(defn test-postfix-decrement [] (num-is "var x = 5; x--; x" 4))
(defn test-compound-on-undeclared-throws []
  (str-is "try { nope += 1; 'no-throw' } catch (e) { e.name }" "ReferenceError"))

;; --- for...of / for...in --------------------------------------------------
(defn test-for-of-array []
  (str-is "var out = ''; for (var x of [1, 2, 3]) { out = out + x; } out" "123"))
(defn test-for-of-sum []
  (num-is "var t = 0; for (var x of [4, 5, 6]) { t += x; } t" 15))
(defn test-for-of-empty []
  (str-is "var out = 'n'; for (var x of []) { out = 'y'; } out" "n"))
(defn test-for-of-strings []
  (str-is "var out = ''; for (var s of ['a', 'b']) { out += s; } out" "ab"))
(defn test-for-of-break []
  (num-is "var t = 0; for (var x of [1, 2, 3, 4]) { if (x == 3) { break; } t += x; } t" 3))
(defn test-for-of-not-an-array []
  (str-is "try { for (var x of 5) { } 'no-throw' } catch (e) { e.name }" "TypeError"))
;; `for...in` yields KEYS, oldest first, without duplicates.
(defn test-for-in-object []
  (str-is "var o = {a: 1, b: 2}; var out = ''; for (var k in o) { out += k; } out" "ab"))
(defn test-for-in-object-order []
  (str-is "var o = {}; o.x = 1; o.y = 2; o.z = 3; var out = ''; for (var k in o) { out += k; } out" "xyz"))
(defn test-for-in-array-indices []
  (str-is "var out = ''; for (var i in ['a', 'b']) { out += i; } out" "01"))
(defn test-for-in-skips-reassigned-duplicates []
  (str-is "var o = {a: 1, b: 2}; o.a = 9; var out = ''; for (var k in o) { out += k; } out" "ab"))

;; --- the DOM bridge -------------------------------------------------------
;; The log is <proplen>:<prop><idlen>:<id><vallen>:<value>, appended in order.
(defn test-dom-set-text []
  (dom-is "document.getElementById('ws-proof').textContent = 'hello';"
          (dom-entry "" "ws-proof" "")
          "11:textContent8:ws-proof5:hello"))
(defn test-dom-read-text []
  (if (string=? (eval-dom-value "document.getElementById('t').textContent"
                                (dom-entry "" "t" "abc"))
                "abc") 1 0))
;; A missing id answers null, as a real document does.
(defn test-dom-missing-id-is-null []
  (if (string=? (eval-dom-value "document.getElementById('nope')"
                                (dom-entry "" "t" "abc"))
                "null") 1 0))
(defn test-dom-missing-id-is-falsy []
  (if (string=? (eval-dom-value "document.getElementById('nope') ? 'y' : 'n'"
                                (dom-entry "" "t" "abc"))
                "n") 1 0))
(defn test-dom-via-a-variable []
  (dom-is "var el = document.getElementById('t'); el.textContent = 'z';"
          (dom-entry "" "t" "")
          "11:textContent1:t1:z"))
(defn test-dom-compound-append []
  (dom-is "document.getElementById('t').textContent += 'B';"
          (dom-entry "" "t" "A")
          "11:textContent1:t2:AB"))
(defn test-dom-two-effects-keep-their-order []
  (dom-is "document.getElementById('a').textContent = '1'; document.getElementById('b').textContent = '2';"
          (dom-entry (dom-entry "" "a" "") "b" "")
          "11:textContent1:a1:111:textContent1:b1:2"))
(defn test-dom-no-effects-is-empty []
  (dom-is "1 + 1" (dom-entry "" "t" "") ""))
;; The guest cannot see its own writes: the snapshot is what the host injected
;; and this engine does not pretend to have applied anything.
(defn test-dom-writes-are-not-readable []
  (if (string=? (eval-dom-value "var el = document.getElementById('t'); el.textContent = 'new'; el.textContent"
                                (dom-entry "" "t" "old"))
                "old") 1 0))
;; Without a document binding the name is simply unresolvable, so a page
;; script's feature detection still works.
(defn test-dom-without-a-document []
  (str-is "typeof document" "undefined"))

;; --- event handlers -------------------------------------------------------
(defn test-dom-listener-registration []
  (dom-is "document.getElementById('btn').addEventListener('click', function () { });"
          (dom-entry (dom-entry "" "btn" "") "out" "before")
          "16:addEventListener3:btn10:5:click1:0"))
;; Firing answers with the handler's OWN effects: the log is cleared after the
;; replay, so the registration is not reported a second time.
(defn test-dom-fire-handler []
  (if (string=? (eval-dom-event
                 "var r = document.getElementById('out'); document.getElementById('btn').addEventListener('click', function () { r.textContent = 'fired'; });"
                 (dom-entry (dom-entry "" "btn" "") "out" "before")
                 0)
                "11:textContent3:out5:fired") 1 0))
(defn test-dom-two-listeners-get-different-numbers []
  (dom-is "var b = document.getElementById('btn'); b.addEventListener('click', function () { }); b.addEventListener('blur', function () { });"
          (dom-entry (dom-entry "" "btn" "") "out" "before")
          "16:addEventListener3:btn10:5:click1:016:addEventListener3:btn9:4:blur1:1"))
(defn test-dom-fire-the-second-handler []
  (if (string=? (eval-dom-event
                 "var r = document.getElementById('out'); var b = document.getElementById('btn'); b.addEventListener('click', function () { r.textContent = 'A'; }); b.addEventListener('blur', function () { r.textContent = 'B'; });"
                 (dom-entry (dom-entry "" "btn" "") "out" "before")
                 1)
                "11:textContent3:out1:B") 1 0))
;; The handler reaches a variable the script closed over, which is the whole
;; reason the function has to stay inside the guest.
(defn test-dom-handler-sees-its-capture []
  (if (string=? (eval-dom-event
                 "var msg = 'from the capture'; var r = document.getElementById('out'); document.getElementById('btn').addEventListener('click', function () { r.textContent = msg; });"
                 (dom-entry (dom-entry "" "btn" "") "out" "before")
                 0)
                "11:textContent3:out16:from the capture") 1 0))
(defn test-dom-unknown-handler-is-an-error []
  (if (string=? (eval-dom-event "1 + 1"
                                (dom-entry (dom-entry "" "btn" "") "out" "before")
                                7)
                "ERROR ReferenceError: no such handler") 1 0))
;; A script that only registers produces no textContent effect.
(defn test-dom-registration-is-not-the-handlers-effect []
  (if (string=? (eval-dom-event
                 "var r = document.getElementById('out'); document.getElementById('btn').addEventListener('click', function () { });"
                 (dom-entry (dom-entry "" "btn" "") "out" "before")
                 0)
                "") 1 0))

;; --- switch ---------------------------------------------------------------
(defn test-switch-matches []
  (num-is "var t = 0; switch (2) { case 1: t = 10; break; case 2: t = 20; break; } t" 20))
;; No `break` means the next clause runs too. That is the behaviour, not a bug.
(defn test-switch-falls-through []
  (num-is "var t = 0; switch (1) { case 1: t = t + 1; case 2: t = t + 10; break; case 3: t = t + 100; } t" 11))
(defn test-switch-break-stops []
  (num-is "var t = 0; switch (1) { case 1: t = 1; break; case 2: t = 2; } t" 1))
(defn test-switch-default []
  (num-is "var t = 0; switch (9) { case 1: t = 1; break; default: t = 99; } t" 99))
;; `default` is used only when nothing matched, wherever it sits.
(defn test-switch-default-in-the-middle []
  (num-is "var t = 0; switch (3) { case 1: t = 1; break; default: t = 99; break; case 3: t = 3; break; } t" 3))
;; Matching is `===`, so a string does not match a number.
(defn test-switch-is-strict []
  (num-is "var t = 0; switch ('1') { case 1: t = 1; break; default: t = 2; } t" 2))
(defn test-switch-no-match-no-default []
  (num-is "var t = 7; switch (5) { case 1: t = 1; break; } t" 7))
;; `break` inside a switch leaves the SWITCH; the loop keeps going.
(defn test-switch-break-leaves-only-the-switch []
  (num-is "var t = 0; for (var i = 0; i < 3; i++) { switch (i) { case 1: break; } t++; } t" 3))
(defn test-switch-return []
  (str-is "function f(x) { switch (x) { case 1: return 'one'; default: return 'other'; } } f(1) + f(2)" "oneother"))
(defn test-switch-on-strings []
  (str-is "var o = ''; switch ('b') { case 'a': o = 'A'; break; case 'b': o = 'B'; break; } o" "B"))

;; --- attributes -----------------------------------------------------------
(defn test-dom-get-attribute []
  (if (string=? (eval-dom-value "document.getElementById('a').getAttribute('title')"
                                (dom-put "" "a" (dom-node-attr (dom-node "text") "title" "hi")))
                "hi") 1 0))
;; A missing attribute is null, not undefined -- that is what a real one does.
(defn test-dom-get-missing-attribute-is-null []
  (if (string=? (eval-dom-value "document.getElementById('a').getAttribute('nope')"
                                (dom-put "" "a" (dom-node-attr (dom-node "text") "title" "hi")))
                "null") 1 0))
;; An attribute called textContent must not become the property.
(defn test-dom-attribute-does-not-shadow-text-content []
  (if (string=? (eval-dom-value "document.getElementById('a').textContent"
                                (dom-put "" "a" (dom-node-attr (dom-node "real") "textContent" "fake")))
                "real") 1 0))
(defn test-dom-set-attribute []
  (dom-is "document.getElementById('a').setAttribute('class', 'on');"
          (dom-entry "" "a" "")
          "12:setAttribute1:a11:5:class2:on"))
;; Writing does not change what a later read sees, the same as textContent.
(defn test-dom-set-attribute-is-not-a-read []
  (if (string=? (eval-dom-value "var e = document.getElementById('a'); e.setAttribute('title', 'new'); e.getAttribute('title')"
                                (dom-put "" "a" (dom-node-attr (dom-node "t") "title" "old")))
                "old") 1 0))

;; --- document.title and console.log ---------------------------------------
;; `document` and `console` are nodes under reserved ids, so neither needs a
;; rule of its own in the assignment or call paths.
(defn test-dom-title-read []
  (if (string=? (eval-dom-value "document.title"
                                (dom-put "" "#document" (dom-node-prop "" "title" "Hello")))
                "Hello") 1 0))
(defn test-dom-title-write []
  (dom-is "document.title = 'New';"
          (dom-put "" "#document" (dom-node-prop "" "title" "Old"))
          "5:title9:#document3:New"))
;; A document whose title the host did not send reads as undefined, not as an
;; error: the guest is told what the host chose to tell it.
(defn test-dom-title-default []
  (str-is "typeof document" "undefined"))
(defn test-console-log []
  (dom-is "console.log('hi');" (dom-entry "" "a" "") "3:log8:#console2:hi"))
(defn test-console-log-two-arguments []
  (dom-is "console.log('a', 'b');" (dom-entry "" "a" "") "3:log8:#console3:a b"))
(defn test-console-is-not-an-element []
  (if (string=? (eval-dom-value "console.getAttribute ? 'has' : 'lacks'"
                                (dom-entry "" "a" ""))
                "has") 1 0))

;; --- instanceof -----------------------------------------------------------
;; No prototype chain, so this answers the question a `catch` actually asks.
(defn test-instanceof-error []
  (str-is "try { nope } catch (e) { e instanceof Error ? 'yes' : 'no' }" "yes"))
(defn test-instanceof-type-error []
  (str-is "var x = 1; try { x() } catch (e) { e instanceof TypeError ? 'yes' : 'no' }" "yes"))
(defn test-instanceof-the-wrong-error []
  (str-is "try { nope } catch (e) { e instanceof TypeError ? 'yes' : 'no' }" "no"))
(defn test-instanceof-a-plain-object []
  (str-is "var o = {a: 1}; o instanceof Error ? 'yes' : 'no'" "no"))
(defn test-instanceof-a-number []
  (str-is "1 instanceof Error ? 'yes' : 'no'" "no"))
;; A constructor this engine does not have answers false -- which is a real
;; answer, since nothing here is an instance of it.
(defn test-instanceof-an-unknown-constructor []
  (str-is "var o = {a: 1}; o instanceof Widget ? 'yes' : 'no'" "no"))
(defn test-instanceof-new-error []
  (str-is "new RangeError('x') instanceof Error ? 'yes' : 'no'" "yes"))

;; --- setTimeout -----------------------------------------------------------
;; The same shape as addEventListener: register, then fire through the same
;; second entry point. A guest with no capabilities has no clock.
(defn test-set-timeout-registration []
  (dom-is "setTimeout(function () { }, 250);" (dom-entry "" "a" "")
          "10:setTimeout7:#window8:3:2501:0"))
(defn test-set-timeout-fires []
  (if (string=? (eval-dom-event
                 "var r = document.getElementById('a'); setTimeout(function () { r.textContent = 'late'; }, 10);"
                 (dom-entry "" "a" "now")
                 0)
                "11:textContent1:a4:late") 1 0))
(defn test-set-timeout-answers-an-id []
  (if (string=? (eval-dom-value "setTimeout(function () { }, 5)" (dom-entry "" "a" ""))
                "0") 1 0))
;; Timers and listeners share one registry, so their numbers do not collide.
(defn test-set-timeout-shares-the-registry []
  (if (string=? (eval-dom-event
                 "var r = document.getElementById('a'); document.getElementById('a').addEventListener('click', function () { r.textContent = 'click'; }); setTimeout(function () { r.textContent = 'timer'; }, 1);"
                 (dom-entry "" "a" "now")
                 1)
                "11:textContent1:a5:timer") 1 0))

;; --- fetch ----------------------------------------------------------------
;; The case that tests the whole design, because it answers a promise. What
;; comes back is a pending request; the host performs it and fires the slot
;; with the response, which is why a handler can take an argument at all.
(defn test-fetch-registration []
  (dom-is "fetch('/api/data');" (dom-entry "" "a" "")
          "5:fetch7:#window14:9:/api/data1:0"))
(defn test-fetch-then-fires-with-the-response []
  (if (string=? (eval-dom-event-arg
                 "var r = document.getElementById('a'); fetch('/api/data').then(function (body) { r.textContent = body; });"
                 (dom-entry "" "a" "old")
                 0
                 "the response")
                "11:textContent1:a12:the response") 1 0))
;; `.then` answers the same pending request, so it can be chained.
(defn test-fetch-then-answers-the-request []
  (if (string=? (eval-dom-value "typeof fetch('/x').then(function (b) { })"
                                (dom-entry "" "a" ""))
                "object") 1 0))
(defn test-fetch-two-requests []
  (dom-is "fetch('/one'); fetch('/two');" (dom-entry "" "a" "")
          "5:fetch7:#window9:4:/one1:05:fetch7:#window9:4:/two1:1"))
;; A handler that declares no parameter is called anyway.
(defn test-handler-argument-is-optional []
  (if (string=? (eval-dom-event-arg
                 "var r = document.getElementById('a'); fetch('/x').then(function () { r.textContent = 'done'; });"
                 (dom-entry "" "a" "old")
                 0
                 "ignored")
                "11:textContent1:a4:done") 1 0))

;; --- workers and sockets --------------------------------------------------
;; The same shape a third and fourth time: a handle under a reserved id, and
;; the number in it is the registry slot.
(defn test-new-worker []
  (dom-is "var w = new Worker('/w.js');" (dom-entry "" "a" "")
          "9:newWorker7:#window10:5:/w.js1:0"))
(defn test-new-websocket []
  (dom-is "var s = new WebSocket('ws://x');" (dom-entry "" "a" "")
          "12:newWebSocket7:#window11:6:ws://x1:0"))
(defn test-post-message []
  (dom-is "var w = new Worker('/w.js'); w.postMessage('hi');" (dom-entry "" "a" "")
          "9:newWorker7:#window10:5:/w.js1:011:postMessage5:#wrk02:hi"))
(defn test-socket-send []
  (dom-is "var s = new WebSocket('ws://x'); s.send('data');" (dom-entry "" "a" "")
          "12:newWebSocket7:#window11:6:ws://x1:04:send6:#sock04:data"))
;; `onmessage =` is the property form of addEventListener, and is reported as
;; one, so the host has a single rule to replay.
(defn test-onmessage-registers []
  (dom-is "var w = new Worker('/w.js'); w.onmessage = function (e) { };"
          (dom-entry "" "a" "")
          "9:newWorker7:#window10:5:/w.js1:016:addEventListener5:#wrk012:7:message1:1"))
(defn test-onclick-registers []
  (dom-is "document.getElementById('a').onclick = function () { };" (dom-entry "" "a" "")
          "16:addEventListener1:a10:5:click1:0"))
(defn test-onmessage-fires-with-the-message []
  (if (string=? (eval-dom-event-arg
                 "var r = document.getElementById('a'); var w = new Worker('/w.js'); w.onmessage = function (e) { r.textContent = e; };"
                 (dom-entry "" "a" "old")
                 1
                 "from the worker")
                "11:textContent1:a15:from the worker") 1 0))
;; A property starting with `on` that is NOT a function is still a write.
(defn test-on-non-function-is-a-write []
  (dom-is "document.getElementById('a').once = 'x';" (dom-entry "" "a" "")
          "4:once1:a1:x"))

;; --- user constructors ----------------------------------------------------
;; No prototype chain: the object remembers the name it was built with, which
;; is enough for the question `instanceof` is actually asked.
(defn test-user-constructor []
  (str-is "function Point(x) { this.x = x; } typeof new Point(1)" "object"))
(defn test-constructor-sets-this []
  (num-is "function Point(x) { this.x = x; } new Point(7).x" 7))
(defn test-constructor-with-two-fields []
  (str-is "function P(x, y) { this.x = x; this.y = y; } var p = new P('a', 'b'); p.x + p.y" "ab"))
(defn test-constructor-instanceof []
  (str-is "function P() { } new P() instanceof P ? 'yes' : 'no'" "yes"))
(defn test-constructor-is-not-another []
  (str-is "function P() { } function Q() { } new P() instanceof Q ? 'yes' : 'no'" "no"))
;; A constructor that returns an object answers with it, as a real one does.
(defn test-constructor-returning-an-object []
  (num-is "function P() { this.x = 1; return {x: 9}; } new P().x" 9))
(defn test-constructor-method []
  (num-is "function C() { this.n = 3; this.twice = function () { return this.n * 2; }; } new C().twice()" 6))
;; Called without `new` it is an ordinary function, so the field lands nowhere
;; the caller can see and the call answers undefined.
(defn test-calling-a-constructor-without-new []
  (str-is "function P(x) { this.x = x; } typeof P(1)" "undefined"))
