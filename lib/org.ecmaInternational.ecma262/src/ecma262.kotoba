;; --- this ------------------------------------------------------------------
(defn test-this-on-object []
  (num-is "function get() { return this.v; } var o = {v: 7, m: get}; o.m()" 7))
(defn test-this-reads-sibling-property []
  (num-is "function sum() { return this.a + this.b; } var o = {a: 2, b: 3, go: sum}; o.go()" 5))
;; A real engine in sloppy mode substitutes the GLOBAL object for a plain
;; call's `this`. This engine has no global object to substitute, so `this`
;; stays undefined -- a divergence, recorded as one in the differential corpus.
(defn test-plain-call-this-is-the-global-object []
  (str-is "function f() { return typeof this; } f()" "object"))

