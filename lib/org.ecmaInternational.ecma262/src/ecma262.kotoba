;; --- try / catch / throw ---------------------------------------------------
(defn test-throw-string [] (str-is "try { throw 'boom'; } catch (e) { e }" "boom"))
(defn test-throw-number [] (num-is "try { throw 42; } catch (e) { e }" 42))
(defn test-catch-binds-value [] (str-is "try { throw 7; } catch (e) { typeof e }" "number"))
(defn test-try-without-throw [] (num-is "try { 5 } catch (e) { 9 }" 5))
(defn test-catch-reference-error [] (str-is "try { nope } catch (e) { typeof e }" "object"))
(defn test-catch-type-error [] (num-is "var x = 1; try { x() } catch (e) { 3 }" 3))
(defn test-try-continues-after []
