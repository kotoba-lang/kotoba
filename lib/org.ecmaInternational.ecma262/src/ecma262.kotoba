(defn test-undefined-variable [] (type-is "nope" "error"))
(defn test-unbalanced-paren [] (type-is "(1 + 2" "error"))
(defn test-error-propagates [] (type-is "var x = nope; x + 1" "error"))

(defn test-function [] (num-is "function f() { return 7; } f()" 7))
