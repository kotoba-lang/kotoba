  (num-is "var a = []; for (var i = 0; i < 4; i = i + 1) { a.push(i); } a.length" 4))
(defn test-pop [] (num-is "var a = [1, 2, 3]; a.pop(); a.length" 2))
(defn test-pop-returns-last [] (num-is "var a = [1, 2, 3]; a.pop()" 3))
;; A cell is shared, so a push inside a function is seen by the caller.
