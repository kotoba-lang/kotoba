;; Decoder for the four-TEXT-column Itonami cron_notepad record shape.
;; Returns four [offset length] pairs into the input record payload. It does
;; not decode UTF-8 or admit arbitrary SQLite serial types.

(ns kotoba.sqlite.notepad-record
  {:kotoba/export [decode]}
  (:require [kotoba.sqlite.varint :as varint]))

(defn- failed [] :vector-i64
  (vector-i64 -1 -1 -1 -1 -1 -1 -1 -1))

(defn- text-serial? [serial :i64] :bool
  (and (>= serial 13)
       (not= (- serial (* (quot serial 2) 2)) 0)))

(defn- serial-length [serial :i64] :i64
  (quot (- serial 13) 2))

(defn- read-serials [data :bytes header-size :i64 position :i64 count :i64 values :vector-i64] :vector-i64
  (if (= count 4)
    (if (= position header-size)
      (vector-conj values header-size)
      (failed))
    (let [decoded (varint/decode data position)
          serial (vector-at decoded 0)
          next-position (vector-at decoded 1)]
      (if (or (< serial 13)
              (not (text-serial? serial))
              (<= next-position position)
              (> next-position header-size))
        (failed)
        (read-serials data header-size next-position (+ count 1)
                      (vector-conj values serial)))))

(defn- append-span [total position serials index spans] :vector-i64
  (if (= index 4)
    (if (= position total) spans (failed))
    (let [serial (vector-at serials index)
          length (serial-length serial)]
      (if (> length (- total position))
        (failed)
        (append-span total (+ position length) serials (+ index 1)
                     (vector-conj (vector-conj spans position) length)))))

(defn decode [payload :bytes] :vector-i64
  (if (< (bytes-count payload) 5)
    (failed)
    (let [header-varint (varint/decode payload 0)
          header-size (vector-at header-varint 0)
          serial-start (vector-at header-varint 1)
          total (bytes-count payload)]
      (if (or (< header-size 5)
              (<= serial-start 0)
              (> header-size total))
        (failed)
        (let [serials (read-serials payload header-size serial-start 0 (vector-i64))]
          (if (< (vector-at serials 0) 0)
            (failed)
            (append-span total header-size
                         (vector-i64 (vector-at serials 0)
                                     (vector-at serials 1)
                                     (vector-at serials 2)
                                     (vector-at serials 3))
                         0 (vector-i64)))))))
