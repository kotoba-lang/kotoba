;; SQLite file-format varints for the bounded native engine.
;; This codec accepts nonnegative signed-i64 values. SQLite rowid encodings
;; whose unsigned value exceeds i64 are deliberately refused until the
;; caller has an explicit two-word integer representation.

(ns kotoba.sqlite.varint
  {:kotoba/export [encode decode]})

(def max-i64 9223372036854775807)
(def max-eight-byte-varint 72057594037927935)

(defn- remainder [x :i64 divisor :i64] :i64
  (- x (* (quot x divisor) divisor)))

(defn- collect-short-groups [value :i64 reversed :vector-i64] :vector-i64
  (if (< value 128)
    (vector-conj reversed value)
    (collect-short-groups (quot value 128)
                          (vector-conj reversed (remainder value 128)))))

(defn- emit-short-groups [reversed :vector-i64 index :i64 out :vector-i64] :vector-i64
  (if (< index 0)
    out
    (let [payload (vector-at reversed index)
          byte (if (= index 0) payload (+ payload 128))]
      (emit-short-groups reversed (- index 1) (vector-conj out byte)))))

(defn- encode-short [value :i64] :bytes
  (let [groups (collect-short-groups value (vector-i64))
        bytes (emit-short-groups groups (- (vector-count groups) 1) (vector-i64))]
    (bytes-from-vector-i64 bytes)))

(defn- collect-nine-prefix [value :i64 remaining :i64 reversed :vector-i64] :vector-i64
  (if (= remaining 0)
    reversed
    (collect-nine-prefix (quot value 128) (- remaining 1)
                         (vector-conj reversed (remainder value 128)))))

(defn- emit-nine-prefix [reversed :vector-i64 index :i64 out :vector-i64] :vector-i64
  (if (< index 0)
    out
    (emit-nine-prefix reversed (- index 1)
                      (vector-conj out (+ 128 (vector-at reversed index))))))

(defn- encode-nine [value :i64] :bytes
  (let [high (quot value 256)
        low (remainder value 256)
        groups (collect-nine-prefix high 8 (vector-i64))
        prefix (emit-nine-prefix groups 7 (vector-i64))]
    (bytes-from-vector-i64 (vector-conj prefix low))))

;; Encode a nonnegative signed-i64 SQLite varint. Negative inputs return empty bytes.
(defn encode [value :i64] :bytes
  (if (< value 0)
    (bytes-empty)
    (if (> value max-eight-byte-varint)
      (encode-nine value)
      (encode-short value))))

(defn- failed-decode [] :vector-i64
  (vector-i64 -1 -1))

(defn- decode-run [data :bytes index :i64 count :i64 accumulator :i64] :vector-i64
  (let [length (bytes-count data)]
    (if (or (< index 0) (>= index length))
      (failed-decode)
      (let [byte (bytes-at data index)]
        (if (= count 8)
          (if (> accumulator (quot (- max-i64 byte) 256))
            (failed-decode)
            (vector-i64 (+ (* accumulator 256) byte) (+ index 1)))
          (let [payload (if (>= byte 128) (- byte 128) byte)]
            (if (> accumulator (quot (- max-i64 payload) 128))
              (failed-decode)
              (let [next-value (+ (* accumulator 128) payload)]
                (if (< byte 128)
                  (vector-i64 next-value (+ index 1))
                  (decode-run data (+ index 1) (+ count 1) next-value))))))))))

;; Decode one varint at offset. Return [value next-offset], or [-1 -1] on refusal.
(defn decode [data :bytes offset :i64] :vector-i64
  (decode-run data offset 0 0))

