;; Bounded SQLite v3 record-layout decoder. Values remain byte spans so a
;; caller can interpret each value using its serial type without text coercion.

(ns kotoba.sqlite.record
  {:kotoba/export [decode encode]}
  (:require [kotoba.sqlite.varint :as varint]))

(def max-columns 64)

(defn- invalid-record [] :vector-i64
  (vector-i64 -1))

(defn- empty-bytes [] :bytes
  (bytes-from-vector-i64 (vector-i64)))

(defn- remainder [value :i64 divisor :i64] :i64
  (- value (* (quot value divisor) divisor)))

(defn- serial-length [serial :i64] :i64
  (cond
    (= serial 0) 0
    (= serial 1) 1
    (= serial 2) 2
    (= serial 3) 3
    (= serial 4) 4
    (= serial 5) 6
    (or (= serial 6) (= serial 7)) 8
    (or (= serial 8) (= serial 9)) 0
    (or (= serial 10) (= serial 11)) -1
    (= (remainder serial 2) 0) (quot (- serial 12) 2)
    :else (quot (- serial 13) 2)))

(defn- serial-data-length [serials :vector-i64 index :i64 total :i64] :i64
  (if (= index (vector-count serials))
    total
    (let [length (serial-length (vector-at serials index))]
      (if (< length 0)
        -1
        (serial-data-length serials (+ index 1) (+ total length))))))

(defn- encode-serials [serials :vector-i64 index :i64 out :bytes] :bytes
  (if (= index (vector-count serials))
    out
    (let [serial (vector-at serials index)]
      (if (< (serial-length serial) 0)
        (empty-bytes)
        (encode-serials serials (+ index 1)
                        (bytes-concat out (varint/encode serial)))))))

(defn- fixed-header-size [serial-bytes :i64] :i64
  (loop [size (+ serial-bytes 1)]
    (let [next-size (+ serial-bytes (bytes-count (varint/encode size)))]
      (if (= size next-size)
        size
        (recur next-size)))))

;; Encode a generic record from serial types and their concatenated raw values.
;; Reserved serial types, invalid widths, and mismatched data lengths refuse.
(defn encode [serials :vector-i64 data :bytes] :bytes
  (let [count (vector-count serials)]
    (if (or (= count 0) (> count max-columns))
      (empty-bytes)
      (let [data-size (serial-data-length serials 0 0)
            serial-data (encode-serials serials 0 (empty-bytes))]
        (if (or (< data-size 0)
                (not= data-size (bytes-count data))
                (= (bytes-count serial-data) 0))
          (empty-bytes)
          (let [header-size (fixed-header-size (bytes-count serial-data))
                header (bytes-concat (varint/encode header-size) serial-data)]
            (bytes-concat header data)))))))

(defn- read-serials [data :bytes header-size :i64 position :i64 types :vector-i64] :vector-i64
  (if (= position header-size)
    types
    (if (or (>= (vector-count types) max-columns)
            (> position header-size))
      (invalid-record)
      (let [decoded (varint/decode data position)
            serial (vector-at decoded 0)
            next-position (vector-at decoded 1)]
        (if (or (< serial 0)
                (< (serial-length serial) 0)
                (<= next-position position)
                (> next-position header-size))
          (invalid-record)
          (read-serials data header-size next-position
                        (vector-conj types serial)))))))

(defn- append-spans [total :i64 position :i64 types :vector-i64
                    index :i64 result :vector-i64] :vector-i64
  (if (= index (vector-count types))
    (if (= position total) result (invalid-record))
    (let [serial (vector-at types index)
          length (serial-length serial)]
      (if (> length (- total position))
        (invalid-record)
        (append-spans total (+ position length) types (+ index 1)
                      (vector-conj
                        (vector-conj
                          (vector-conj result serial)
                          position)
                        length))))))

;; Returns [column-count serial-type offset length ...].
;; Reserved serial types 10 and 11, truncated headers, and trailing data refuse.
(defn decode [payload :bytes] :vector-i64
  (if (= (bytes-count payload) 0)
    (invalid-record)
    (let [header-varint (varint/decode payload 0)
          header-size (vector-at header-varint 0)
          serial-start (vector-at header-varint 1)
          total (bytes-count payload)]
      (if (or (< header-size 2)
              (<= serial-start 0)
              (>= serial-start header-size)
              (> header-size total))
        (invalid-record)
        (let [types (read-serials payload header-size serial-start (vector-i64))]
          (if (< (vector-at types 0) 0)
            (invalid-record)
            (append-spans total header-size types 0
                          (vector-i64 (vector-count types)))))))))
