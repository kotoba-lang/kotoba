;; SQLite v3 B-tree page-header and cell-pointer admission.
;; This does not walk page trees, freelist chains, or overflow pages.

(ns kotoba.sqlite.page
  {:kotoba/export [decode-header cell-pointer decode-table-leaf-cell decode-table-interior-cell
                   encode-table-leaf-cell encode-table-leaf-page encode-empty-leaf-page
                   append-table-leaf-cell encode-index-leaf-cell
                   encode-index-leaf-page]}
  (:require [kotoba.sqlite.varint :as varint]))

(defn- u16-be [data :bytes offset :i64] :i64
  (+ (* (bytes-at data offset) 256)
     (bytes-at data (+ offset 1))))

(defn- u32-be [data :bytes offset :i64] :i64
  (+ (* (bytes-at data offset) 16777216)
     (* (bytes-at data (+ offset 1)) 65536)
     (* (bytes-at data (+ offset 2)) 256)
     (bytes-at data (+ offset 3))))

(defn- remainder [value :i64 divisor :i64] :i64
  (- value (* (quot value divisor) divisor)))

(defn- interior-page? [page-type :i64] :bool
  (or (= page-type 2) (= page-type 5)))

(defn- valid-page-type? [page-type :i64] :bool
  (or (= page-type 2) (= page-type 5)
      (= page-type 10) (= page-type 13)))

(defn- power-of-two-page-size? [page-size :i64] :bool
  (if (= page-size 512)
    true
    (if (or (< page-size 512)
            (not= (- page-size (* (quot page-size 2) 2)) 0))
      false
      (power-of-two-page-size? (quot page-size 2)))))

(defn- valid-page-size? [page-size :i64] :bool
  (or (= page-size 65536)
      (and (>= page-size 512)
           (<= page-size 32768)
           (power-of-two-page-size? page-size))))

(defn- invalid-header [] :vector-i64
  (vector-i64 -1 -1 -1 -1 -1 -1 -1 -1))

;; Returns [type header-offset header-size cell-count content-start first-freeblock fragments right-child].
(defn decode-header [page :bytes page-size :i64 page-number :i64 reserved :i64] :vector-i64
  (if (or (<= page-number 0)
          (not (valid-page-size? page-size))
          (< reserved 0)
          (< (- page-size reserved) 480)
          (not= (bytes-count page) page-size))
    (invalid-header)
    (let [offset (if (= page-number 1) 100 0)
          page-type (bytes-at page offset)]
      (if (not (valid-page-type? page-type))
        (invalid-header)
        (let [header-size (if (interior-page? page-type) 12 8)
              freeblock (u16-be page (+ offset 1))
              cell-count (u16-be page (+ offset 3))
              raw-content-start (u16-be page (+ offset 5))
              content-start (if (= raw-content-start 0) 65536 raw-content-start)
              fragments (bytes-at page (+ offset 7))
              usable-size (- page-size reserved)
              pointer-array-end (+ offset header-size (* cell-count 2))
              right-child (if (interior-page? page-type)
                            (u32-be page (+ offset 8))
                            0)]
          (if (or (and (= page-number 1)
                       (not (or (= page-type 5) (= page-type 13))))
                  (> pointer-array-end usable-size)
                  (< content-start pointer-array-end)
                  (> content-start usable-size)
                  (> fragments 60)
                  (and (not= freeblock 0)
                       (or (< freeblock content-start)
                           (>= freeblock usable-size)))
                  (and (interior-page? page-type) (= right-child 0)))
            (invalid-header)
            (vector-i64 page-type offset header-size cell-count content-start
                        freeblock fragments right-child)))))))

;; Returns the page-relative cell offset, or -1 when the header/index is invalid.
(defn cell-pointer [page :bytes page-size :i64 page-number :i64
                    reserved :i64 cell-index :i64] :i64
  (let [header (decode-header page page-size page-number reserved)
        cell-count (vector-at header 3)]
    (if (or (< cell-count 0) (< cell-index 0) (>= cell-index cell-count))
      -1
      (let [offset (+ (vector-at header 1) (vector-at header 2) (* cell-index 2))
            cell-offset (u16-be page offset)
            usable-size (- page-size reserved)]
        (if (or (< cell-offset (vector-at header 4))
                (>= cell-offset usable-size))
          -1
          cell-offset)))))

(defn- invalid-cell [] :vector-i64
  (vector-i64 -1 -1 -1 -1 -1 -1))

(defn- empty-bytes [] :bytes
  (bytes-from-vector-i64 (vector-i64)))

(defn- append-u16 [out :vector-i64 value :i64] :vector-i64
  (vector-conj (vector-conj out (quot value 256)) (remainder value 256)))

(defn- append-zeroes [out :vector-i64 count :i64] :vector-i64
  (loop [result out index 0]
    (if (= index count)
      result
      (recur (vector-conj result 0) (+ index 1)))))

(defn- zero-bytes [count :i64] :bytes
  (loop [result (empty-bytes) index 0]
    (if (= index count)
      result
      (let [remaining (- count index)
            chunk-size (if (> remaining 1024) 1024 remaining)
            chunk (bytes-from-vector-i64
                    (append-zeroes (vector-i64) chunk-size))]
        (recur (bytes-concat result chunk) (+ index chunk-size))))))

;; Encode one table-leaf cell when the entire payload fits locally. Overflow
;; payloads and negative rowids are refused until their writer paths exist.
(defn encode-table-leaf-cell [payload :bytes rowid :i64 page-size :i64
                              reserved :i64] :bytes
  (let [payload-size (bytes-count payload)
        usable-size (- page-size reserved)
        maximum-local (- usable-size 35)]
    (if (or (not (valid-page-size? page-size))
            (< reserved 0)
            (< usable-size 480)
            (< rowid 0)
            (> payload-size maximum-local))
      (empty-bytes)
      (bytes-concat
        (bytes-concat (varint/encode payload-size) (varint/encode rowid))
        payload))))

;; Build a leaf page around zero or one already encoded cell. Page images
;; exclude the 100-byte database header even when page-number is 1.
(defn- encode-leaf-page [page-type :i64 cell :bytes page-size :i64
                        page-number :i64 reserved :i64] :bytes
  (let [cell-size (bytes-count cell)
        usable-size (- page-size reserved)
        header-offset (if (= page-number 1) 100 0)
        cell-offset (- usable-size cell-size)
        cell-count (if (= cell-size 0) 0 1)
        pointer-end (+ header-offset 8 (* cell-count 2))]
    (if (or (not (valid-page-size? page-size))
            (not (or (= page-type 10) (= page-type 13)))
            (<= page-number 0)
            (and (= page-number 1) (not= page-type 13))
            (< reserved 0)
            (< usable-size 480)
            (< cell-offset pointer-end)
            (> cell-offset 65535))
      (empty-bytes)
      (let [content-start (if (= cell-offset 65536) 0 cell-offset)
            page-header (-> (vector-i64 page-type)
                            (append-u16 0)
                            (append-u16 cell-count)
                            (append-u16 content-start)
                            (vector-conj 0))
            pointer (if (= cell-count 0)
                      (empty-bytes)
                      (bytes-from-vector-i64
                        (append-u16 (vector-i64) cell-offset)))
            prefix (bytes-concat
                     (zero-bytes header-offset)
                     (bytes-concat (bytes-from-vector-i64 page-header) pointer))
            gap-size (- cell-offset pointer-end)]
        (bytes-concat
          (bytes-concat
            (bytes-concat prefix (zero-bytes gap-size))
            cell)
          (zero-bytes reserved))))))

(defn encode-table-leaf-page [cell :bytes page-size :i64 page-number :i64
                              reserved :i64] :bytes
  (encode-leaf-page 13 cell page-size page-number reserved))

;; Create an empty leaf page for a table (0x0d) or index (0x0a) B-tree.
(defn encode-empty-leaf-page [page-type :i64 page-size :i64 page-number :i64
                              reserved :i64] :bytes
  (encode-leaf-page page-type (empty-bytes) page-size page-number reserved))

;; Encode one index-leaf cell without an overflow payload. The caller supplies
;; the SQLite record key, which includes the indexed columns and rowid suffix.
(defn encode-index-leaf-cell [payload :bytes page-size :i64 reserved :i64] :bytes
  (let [usable-size (- page-size reserved)
        payload-size (bytes-count payload)]
    (if (or (not (valid-page-size? page-size))
            (< reserved 0)
            (< usable-size 480)
            (= payload-size 0)
            (> payload-size (- usable-size 12)))
      (empty-bytes)
      (bytes-concat (varint/encode payload-size) payload))))

(defn encode-index-leaf-page [cell :bytes page-size :i64 page-number :i64
                              reserved :i64] :bytes
  (encode-leaf-page 10 cell page-size page-number reserved))

(defn- appended-page-byte [page :bytes header-offset :i64 old-count :i64
                           new-count :i64 content-start :i64 cell-offset :i64
                           cell :bytes index :i64] :i64
  (cond
    (= index (+ header-offset 3)) (quot new-count 256)
    (= index (+ header-offset 4)) (remainder new-count 256)
    (= index (+ header-offset 5)) (quot content-start 256)
    (= index (+ header-offset 6)) (remainder content-start 256)
    (= index (+ header-offset 8 (* old-count 2))) (quot cell-offset 256)
    (= index (+ header-offset 9 (* old-count 2))) (remainder cell-offset 256)
    (and (>= index cell-offset)
         (< index (+ cell-offset (bytes-count cell))))
    (bytes-at cell (- index cell-offset))
    :else (bytes-at page index)))

(defn- copy-appended-page [page :bytes page-size :i64 header-offset :i64
                           old-count :i64 new-count :i64 content-start :i64
                           cell-offset :i64 cell :bytes index :i64
                           chunk :vector-i64 out :bytes] :bytes
  (if (= index page-size)
    (bytes-concat out (bytes-from-vector-i64 chunk))
    (let [next-chunk (vector-conj
                       chunk
                       (appended-page-byte page header-offset old-count new-count
                                          content-start cell-offset cell index))
          next-index (+ index 1)]
      (if (= (vector-count next-chunk) 1024)
        (copy-appended-page page page-size header-offset old-count new-count
                            content-start cell-offset cell next-index
                            (vector-i64)
                            (bytes-concat out (bytes-from-vector-i64 next-chunk)))
        (copy-appended-page page page-size header-offset old-count new-count
                            content-start cell-offset cell next-index
                            next-chunk out)))))

;; Append a row to a table-leaf page, preserving existing cells. Rowids must
;; be strictly increasing because cell pointers are stored in key order.
;; This does not compact freeblocks or split full pages; those cases refuse.
(defn append-table-leaf-cell [page :bytes payload :bytes rowid :i64
                              page-size :i64 page-number :i64
                              reserved :i64] :bytes
  (let [header (decode-header page page-size page-number reserved)
        cell-count (vector-at header 3)
        cell (encode-table-leaf-cell payload rowid page-size reserved)
        cell-size (bytes-count cell)
        header-offset (vector-at header 1)
        content-start (vector-at header 4)
        pointer-end (+ header-offset 8 (* (+ cell-count 1) 2))
        cell-offset (- content-start cell-size)
        prior-rowid (if (= cell-count 0)
                      -1
                      (let [prior-offset
                              (cell-pointer page page-size page-number reserved
                                            (- cell-count 1))]
                        (vector-at
                          (decode-table-leaf-cell page page-size page-number
                                                  reserved prior-offset)
                          1)))]
    (if (or (not= (vector-at header 0) 13)
            (< cell-count 0)
            (< rowid 0)
            (= cell-size 0)
            (<= rowid prior-rowid)
            (< cell-offset pointer-end))
      (empty-bytes)
      (copy-appended-page page page-size header-offset cell-count
                          (+ cell-count 1) cell-offset cell-offset cell 0
                          (vector-i64) (empty-bytes)))))

(defn- table-leaf-local-size [payload-size :i64 usable-size :i64] :i64
  (let [maximum-local (- usable-size 35)]
    (if (<= payload-size maximum-local)
      payload-size
      (let [minimum-local (- (quot (* (- usable-size 12) 32) 255) 23)
            candidate (+ minimum-local
                         (remainder (- payload-size minimum-local) (- usable-size 4)))]
        (if (<= candidate maximum-local) candidate minimum-local)))))

;; Returns [payload-size rowid payload-offset local-size overflow-page end-offset].
;; Overflow chains and unsigned rowids beyond signed-i64 are deliberately refused.
(defn decode-table-leaf-cell [page :bytes page-size :i64 page-number :i64
                              reserved :i64 cell-offset :i64] :vector-i64
  (let [header (decode-header page page-size page-number reserved)
        page-type (vector-at header 0)
        usable-size (- page-size reserved)]
    (if (or (not= page-type 13)
            (< cell-offset (vector-at header 4))
            (>= cell-offset usable-size))
      (invalid-cell)
      (let [payload-varint (varint/decode page cell-offset)
            payload-size (vector-at payload-varint 0)
            rowid-offset (vector-at payload-varint 1)]
        (if (or (< payload-size 0)
                (<= rowid-offset cell-offset)
                (> rowid-offset usable-size))
          (invalid-cell)
          (let [rowid-varint (varint/decode page rowid-offset)
                rowid (vector-at rowid-varint 0)
                payload-offset (vector-at rowid-varint 1)]
            (if (or (< rowid 0)
                    (<= payload-offset rowid-offset)
                    (> payload-offset usable-size))
              (invalid-cell)
              (let [local-size (table-leaf-local-size payload-size usable-size)
                    overflow? (> payload-size local-size)
                    overflow-bytes (if overflow? 4 0)
                    remaining (- usable-size payload-offset)]
                (if (or (< local-size 0)
                        (> local-size remaining)
                        (> overflow-bytes (- remaining local-size)))
                  (invalid-cell)
                  (let [overflow-page (if overflow?
                                        (u32-be page (+ payload-offset local-size))
                                        0)
                        end-offset (+ payload-offset local-size overflow-bytes)]
                    (if (and overflow? (= overflow-page 0))
                      (invalid-cell)
                      (vector-i64 payload-size rowid payload-offset local-size
                                  overflow-page end-offset))))))))))))

;; Returns [left-child-page rowid end-offset] for a table-interior (0x05) cell.
;; The page-number range and tree-cycle checks belong to the future page walker.
(defn decode-table-interior-cell [page :bytes page-size :i64 page-number :i64
                                 reserved :i64 cell-offset :i64] :vector-i64
  (let [header (decode-header page page-size page-number reserved)
        usable-size (- page-size reserved)]
    (if (or (not= (vector-at header 0) 5)
            (< cell-offset (vector-at header 4))
            (> (+ cell-offset 4) usable-size))
      (invalid-cell)
      (let [left-child (u32-be page cell-offset)
            key-varint (varint/decode page (+ cell-offset 4))
            rowid (vector-at key-varint 0)
            end-offset (vector-at key-varint 1)]
        (if (or (= left-child 0)
                (< rowid 0)
                (<= end-offset (+ cell-offset 4))
                (> end-offset usable-size))
          (invalid-cell)
          (vector-i64 left-child rowid end-offset))))))
