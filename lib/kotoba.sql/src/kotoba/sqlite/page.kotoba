;; SQLite v3 B-tree page-header and cell-pointer admission.
;; This does not decode cells, freelist chains, overflow pages, or page trees.

(ns kotoba.sqlite.page
  {:kotoba/export [decode-header cell-pointer]})

(defn- u16-be [data :bytes offset :i64] :i64
  (+ (* (bytes-at data offset) 256)
     (bytes-at data (+ offset 1))))

(defn- u32-be [data :bytes offset :i64] :i64
  (+ (* (bytes-at data offset) 16777216)
     (* (bytes-at data (+ offset 1)) 65536)
     (* (bytes-at data (+ offset 2)) 256)
     (bytes-at data (+ offset 3))))

(defn- interior-page? [page-type :i64] :bool
  (or (= page-type 2) (= page-type 5)))

(defn- valid-page-type? [page-type :i64] :bool
  (or (= page-type 2) (= page-type 5)
      (= page-type 10) (= page-type 13)))

(defn- power-of-two-page-size? [page-size :i64] :bool
  (if (= page-size 512)
    true
    (if (or (< page-size 512)
            (not= (- page-size (* (quot page-size 2) 2)) 0))
      false
      (power-of-two-page-size? (quot page-size 2)))))

(defn- valid-page-size? [page-size :i64] :bool
  (or (= page-size 65536)
      (and (>= page-size 512)
           (<= page-size 32768)
           (power-of-two-page-size? page-size))))

(defn- invalid-header [] :vector-i64
  (vector-i64 -1 -1 -1 -1 -1 -1 -1 -1))

;; Returns [type header-offset header-size cell-count content-start first-freeblock fragments right-child].
(defn decode-header [page :bytes page-size :i64 page-number :i64 reserved :i64] :vector-i64
  (if (or (<= page-number 0)
          (not (valid-page-size? page-size))
          (< reserved 0)
          (< (- page-size reserved) 480)
          (not= (bytes-count page) page-size))
    (invalid-header)
    (let [offset (if (= page-number 1) 100 0)
          page-type (bytes-at page offset)]
      (if (not (valid-page-type? page-type))
        (invalid-header)
        (let [header-size (if (interior-page? page-type) 12 8)
              freeblock (u16-be page (+ offset 1))
              cell-count (u16-be page (+ offset 3))
              raw-content-start (u16-be page (+ offset 5))
              content-start (if (= raw-content-start 0) 65536 raw-content-start)
              fragments (bytes-at page (+ offset 7))
              usable-size (- page-size reserved)
              pointer-array-end (+ offset header-size (* cell-count 2))
              right-child (if (interior-page? page-type)
                            (u32-be page (+ offset 8))
                            0)]
          (if (or (and (= page-number 1)
                       (not (or (= page-type 5) (= page-type 13))))
                  (> pointer-array-end usable-size)
                  (< content-start pointer-array-end)
                  (> content-start usable-size)
                  (> fragments 60)
                  (and (not= freeblock 0)
                       (or (< freeblock content-start)
                           (>= freeblock usable-size)))
                  (and (interior-page? page-type) (= right-child 0)))
            (invalid-header)
            (vector-i64 page-type offset header-size cell-count content-start
                        freeblock fragments right-child))))))

;; Returns the page-relative cell offset, or -1 when the header/index is invalid.
(defn cell-pointer [page :bytes page-size :i64 page-number :i64
                    reserved :i64 cell-index :i64] :i64
  (let [header (decode-header page page-size page-number reserved)
        cell-count (vector-at header 3)]
    (if (or (< cell-count 0) (< cell-index 0) (>= cell-index cell-count))
      -1
      (let [offset (+ (vector-at header 1) (vector-at header 2) (* cell-index 2))
            cell-offset (u16-be page offset)
            usable-size (- page-size reserved)]
        (if (or (< cell-offset (vector-at header 4))
                (>= cell-offset usable-size))
          -1
          cell-offset))))
