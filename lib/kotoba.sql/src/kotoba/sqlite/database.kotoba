;; Initial three-page SQLite file for Itonami's cron_notepad table.
;; This writes only the schema roots and empty table/index leaves; it is not a
;; general SQL executor and does not open or mutate existing database files.

(ns kotoba.sqlite.database
  {:kotoba/export [create-cron-notepad]}
  (:require [kotoba.sqlite.header :as header]
            [kotoba.sqlite.page :as page]
            [kotoba.sqlite.schema :as schema]))

(def table-name
  (bytes-from-vector-i64
    (vector-i64 99 114 111 110 95 110 111 116 101 112 97 100)))

(def index-prefix
  (bytes-from-vector-i64
    (vector-i64 115 113 108 105 116 101 95 97 117 116 111 105 110 100 101 120 95)))

(def index-suffix
  (bytes-from-vector-i64 (vector-i64 95 49)))

(def create-table-sql
  (bytes-concat
    (bytes-concat
    (bytes-from-vector-i64
      (vector-i64 67 82 69 65 84 69 32 84 65 66 76 69 32 73 70 32 78 79 84 32 69 88 73 83 84 83 32 99 114 111 110 95 110 111 116 101 112 97 100 32 40 106 111 98 95 105 100 32 84 69 88 84 32 78 79 84 32 78 85 76 76 44 32 107))
    (bytes-from-vector-i64
      (vector-i64 101 121 32 84 69 88 84 32 78 79 84 32 78 85 76 76 44 32 118 97 108 117 101 32 84 69 88 84 32 78 79 84 32 78 85 76 76 44 32 117 112 100 97 116 101 100 95 97 116 32 84 69 88 84 32 78 79 84 32 78 85 76 76 44)))
    (bytes-from-vector-i64
      (vector-i64 32 80 82 73 77 65 82 89 32 75 69 89 32 40 106 111 98 95 105 100 44 32 107 101 121 41 41))))

(defn- empty-bytes [] :bytes
  (bytes-from-vector-i64 (vector-i64)))

(defn- suffix [data :bytes offset :i64] :bytes
  (loop [index offset out (empty-bytes) chunk (vector-i64)]
    (if (= index (bytes-count data))
      (bytes-concat out (bytes-from-vector-i64 chunk))
      (let [next-chunk (vector-conj chunk (bytes-at data index))]
        (if (= (vector-count next-chunk) 1024)
          (recur (+ index 1)
                 (bytes-concat out (bytes-from-vector-i64 next-chunk))
                 (vector-i64))
          (recur (+ index 1) out next-chunk))))))

;; Build page 1 sqlite_schema, page 2 cron_notepad, page 3 its PK autoindex.
;; The returned bytes are a complete initial database image, not a mutation.
(defn create-cron-notepad [page-size :i64] :bytes
  (let [table-record (schema/encode-table-entry table-name 2 create-table-sql)
        index-name (bytes-concat (bytes-concat index-prefix table-name) index-suffix)
        index-record (schema/encode-index-entry index-name table-name 3)
        table-cell (page/encode-table-leaf-cell table-record 1 page-size 0)
        index-cell (page/encode-table-leaf-cell index-record 2 page-size 0)
        root-first (page/encode-table-leaf-page table-cell page-size 1 0)
        root-page (page/append-table-leaf-cell root-first index-record 2
                                               page-size 1 0)
        table-page (page/encode-empty-leaf-page 13 page-size 2 0)
        index-page (page/encode-empty-leaf-page 10 page-size 3 0)
        db-header (header/create-header page-size 3 4)
        page-one-header (page/decode-header root-page page-size 1 0)
        ]
    (if (or (= (bytes-count table-record) 0)
            (= (bytes-count index-record) 0)
            (= (bytes-count table-cell) 0)
            (= (bytes-count index-cell) 0)
            (not= (vector-at page-one-header 0) 13)
            (not= (vector-at page-one-header 3) 2)
            (not= (bytes-count table-page) page-size)
            (not= (bytes-count index-page) page-size)
            (not= (bytes-count db-header) 100))
      (empty-bytes)
      (bytes-concat
        (bytes-concat
          db-header
          (bytes-concat (suffix root-page 100) table-page))
        index-page))))
