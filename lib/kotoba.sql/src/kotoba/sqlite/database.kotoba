;; Initial three-page SQLite file for Itonami's cron_notepad table.
;; This writes only the schema roots and empty table/index leaves; it is not a
;; general SQL executor and does not open or mutate existing database files.

(ns kotoba.sqlite.database
  {:kotoba/export [create-cron-notepad validate-cron-notepad-image
                   insert-first-notepad-row]}
  (:require [kotoba.sqlite.header :as header]
            [kotoba.sqlite.notepad-record :as notepad-record]
            [kotoba.sqlite.page :as page]
            [kotoba.sqlite.record :as record]
            [kotoba.sqlite.schema :as schema]))

(def table-name
  (bytes-from-vector-i64
    (vector-i64 99 114 111 110 95 110 111 116 101 112 97 100)))

(def index-prefix
  (bytes-from-vector-i64
    (vector-i64 115 113 108 105 116 101 95 97 117 116 111 105 110 100 101 120 95)))

(def index-suffix
  (bytes-from-vector-i64 (vector-i64 95 49)))

(def create-table-sql
  (bytes-concat
    (bytes-concat
    (bytes-from-vector-i64
      (vector-i64 67 82 69 65 84 69 32 84 65 66 76 69 32 73 70 32 78 79 84 32 69 88 73 83 84 83 32 99 114 111 110 95 110 111 116 101 112 97 100 32 40 106 111 98 95 105 100 32 84 69 88 84 32 78 79 84 32 78 85 76 76 44 32 107))
    (bytes-from-vector-i64
      (vector-i64 101 121 32 84 69 88 84 32 78 79 84 32 78 85 76 76 44 32 118 97 108 117 101 32 84 69 88 84 32 78 79 84 32 78 85 76 76 44 32 117 112 100 97 116 101 100 95 97 116 32 84 69 88 84 32 78 79 84 32 78 85 76 76 44)))
    (bytes-from-vector-i64
      (vector-i64 32 80 82 73 77 65 82 89 32 75 69 89 32 40 106 111 98 95 105 100 44 32 107 101 121 41 41))))

(defn- bytes-equal? [left :bytes right :bytes index :i64] :bool
  (if (= index (bytes-count right))
    (= (bytes-count left) (bytes-count right))
    (and (= (bytes-at left index) (bytes-at right index))
         (bytes-equal? left right (+ index 1)))))

(defn- field-matches? [payload :bytes layout :vector-i64 field :i64
                      expected :bytes] :bool
  (let [serial-index (+ 1 (* field 3))
        offset-index (+ serial-index 1)
        length-index (+ serial-index 2)
        offset (vector-at layout offset-index)
        length (vector-at layout length-index)]
    (and (>= (vector-at layout 0) (+ field 1))
         (>= (vector-at layout serial-index) 13)
         (= length (bytes-count expected))
         (bytes-equal? (bytes-slice payload offset (+ offset length))
                       expected 0))))

(defn- field-root-page? [payload :bytes layout :vector-i64 field :i64
                         root-page :i64] :bool
  (let [serial-index (+ 1 (* field 3))
        offset-index (+ serial-index 1)
        length-index (+ serial-index 2)
        offset (vector-at layout offset-index)]
    (and (>= (vector-at layout 0) (+ field 1))
         (= (vector-at layout serial-index) 1)
         (= (vector-at layout length-index) 1)
         (= (bytes-at payload offset) root-page))))

(defn- table-schema-record? [payload :bytes] :bool
  (let [layout (record/decode payload)]
    (and (= (vector-at layout 0) 5)
         (field-matches? payload layout 0
                         (bytes-from-vector-i64 (vector-i64 116 97 98 108 101)))
         (field-matches? payload layout 1 table-name)
         (field-matches? payload layout 2 table-name)
         (field-root-page? payload layout 3 2)
         (field-matches? payload layout 4 create-table-sql))))

(defn- index-schema-record? [payload :bytes] :bool
  (let [layout (record/decode payload)
        index-name (bytes-concat (bytes-concat index-prefix table-name)
                                 index-suffix)]
    (and (= (vector-at layout 0) 5)
         (field-matches? payload layout 0
                         (bytes-from-vector-i64 (vector-i64 105 110 100 101 120)))
         (field-matches? payload layout 1 index-name)
         (field-matches? payload layout 2 table-name)
         (field-root-page? payload layout 3 3)
         (= (vector-at layout 13) 0))))

(defn- schema-row-valid? [page-image :bytes page-size :i64 cell-index :i64
                          rowid :i64 table-row? :bool] :bool
  (let [cell-offset (page/cell-pointer page-image page-size 1 0 cell-index)]
    (if (< cell-offset 0)
      false
      (let [cell (page/decode-table-leaf-cell page-image page-size 1 0 cell-offset)
            payload-size (vector-at cell 0)
            payload-offset (vector-at cell 2)
            local-size (vector-at cell 3)
            overflow-page (vector-at cell 4)]
        (if (or (< payload-size 0)
                (not= payload-size local-size)
                (not= overflow-page 0)
                (> (+ payload-offset payload-size) page-size))
          false
          (let [payload (bytes-slice page-image payload-offset
                                     (+ payload-offset payload-size))]
            (and (= (vector-at cell 1) rowid)
                 (if table-row?
                   (table-schema-record? payload)
                   (index-schema-record? payload)))))))))

(defn- empty-root? [image :bytes page-size :i64 page-number :i64
                    expected-type :i64] :bool
  (let [start (* (- page-number 1) page-size)
        page-image (bytes-slice image start (+ start page-size))
        fields (page/decode-header page-image page-size page-number 0)]
    (and (= (vector-at fields 0) expected-type)
         (= (vector-at fields 3) 0))))

(defn- empty-bytes [] :bytes
  (bytes-from-vector-i64 (vector-i64)))

(defn- suffix [data :bytes offset :i64] :bytes
  (loop [index offset out (empty-bytes) chunk (vector-i64)]
    (if (= index (bytes-count data))
      (bytes-concat out (bytes-from-vector-i64 chunk))
      (let [next-chunk (vector-conj chunk (bytes-at data index))]
        (if (= (vector-count next-chunk) 1024)
          (recur (+ index 1)
                 (bytes-concat out (bytes-from-vector-i64 next-chunk))
                 (vector-i64))
          (recur (+ index 1) out next-chunk))))))

;; Build page 1 sqlite_schema, page 2 cron_notepad, page 3 its PK autoindex.
;; The returned bytes are a complete initial database image, not a mutation.
(defn create-cron-notepad [page-size :i64] :bytes
  (let [table-record (schema/encode-table-entry table-name 2 create-table-sql)
        index-name (bytes-concat (bytes-concat index-prefix table-name) index-suffix)
        index-record (schema/encode-index-entry index-name table-name 3)
        table-cell (page/encode-table-leaf-cell table-record 1 page-size 0)
        index-cell (page/encode-table-leaf-cell index-record 2 page-size 0)
        root-first (page/encode-table-leaf-page table-cell page-size 1 0)
        root-page (page/append-table-leaf-cell root-first index-record 2
                                               page-size 1 0)
        table-page (page/encode-empty-leaf-page 13 page-size 2 0)
        index-page (page/encode-empty-leaf-page 10 page-size 3 0)
        db-header (header/create-header page-size 3 4)
        page-one-header (page/decode-header root-page page-size 1 0)
        ]
    (if (or (= (bytes-count table-record) 0)
            (= (bytes-count index-record) 0)
            (= (bytes-count table-cell) 0)
            (= (bytes-count index-cell) 0)
            (not= (vector-at page-one-header 0) 13)
            (not= (vector-at page-one-header 3) 2)
            (not= (bytes-count table-page) page-size)
            (not= (bytes-count index-page) page-size)
            (not= (bytes-count db-header) 100))
      (empty-bytes)
      (bytes-concat
        (bytes-concat
          db-header
          (bytes-concat (suffix root-page 100) table-page))
        index-page))))

;; Validate this exact admitted initial schema image. This is not a general
;; sqlite_schema lookup or a page-tree walker.
(defn validate-cron-notepad-image [image :bytes] :bool
  (let [fields (header/decode image)
        page-size (vector-at fields 0)
        page-count (vector-at fields 5)]
    (if (or (< page-size 512)
            (= page-size -1)
            (not= page-count 3)
            (not= (bytes-count image) (* page-size page-count))
            (not= (vector-at fields 1) 1)
            (not= (vector-at fields 2) 1)
            (not= (vector-at fields 4) 1)
            (not= (bytes-at image 47) 4))
      false
      (let [first-page (bytes-slice image 0 page-size)
            first-fields (page/decode-header first-page page-size 1 0)]
        (and (= (vector-at first-fields 0) 13)
             (= (vector-at first-fields 3) 2)
             (schema-row-valid? first-page page-size 0 1 true)
             (schema-row-valid? first-page page-size 1 2 false)
             (empty-root? image page-size 2 13)
             (empty-root? image page-size 3 10))))))

(defn- text-serial [value :bytes] :i64
  (+ 13 (* (bytes-count value) 2)))

;; Bounded first-row writer for the exact three-page empty image above. It
;; refuses nonempty databases, overflow payloads, and cells that do not fit
;; their existing table/index root pages. It is an image builder, not a
;; durable transaction or general upsert implementation.
(defn insert-first-notepad-row [image :bytes page-size :i64
                                job-id :bytes key :bytes value :bytes
                                updated-at :bytes] :bytes
  (let [header-fields (header/decode image)
        table-payload (notepad-record/encode job-id key value updated-at)
        index-data (bytes-concat job-id key)
        index-payload (record/encode
                        (vector-i64 (text-serial job-id) (text-serial key) 9)
                        index-data)
        table-start page-size
        table-root (bytes-slice image table-start (* page-size 2))
        table-page (page/append-table-leaf-cell table-root table-payload 1
                                                page-size 2 0)
        index-cell (page/encode-index-leaf-cell index-payload page-size 0)
        index-page (page/encode-index-leaf-page index-cell page-size 3 0)
        next-header (header/advance-change-counter (bytes-slice image 0 100))]
    (if (or (not (validate-cron-notepad-image image))
            (not= (vector-at header-fields 0) page-size)
            (= (bytes-count table-payload) 0)
            (= (bytes-count index-payload) 0)
            (= (bytes-count table-page) 0)
            (= (bytes-count index-cell) 0)
            (= (bytes-count index-page) 0)
            (= (bytes-count next-header) 0))
      (empty-bytes)
      (bytes-concat
        (bytes-concat
          (bytes-concat next-header (bytes-slice image 100 page-size))
          (bytes-concat table-page index-page))
        (bytes-slice image (* page-size 3) (bytes-count image))))))
