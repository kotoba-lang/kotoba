;; SQLite database header codecs for the bounded native engine.
;; This reads/writes the fixed v3 header and creates an empty one-page image;
;; it does not imply page-tree or WAL support. Invalid input refuses.

(ns kotoba.sqlite.header
  {:kotoba/export [decode create-empty]})

(def magic
  (bytes-from-vector-i64
    (vector-i64 83 81 76 105 116 101 32 102 111 114 109 97 116 32 51 0)))

(defn- bytes-equal-at? [left :bytes right :bytes offset :i64 index :i64] :bool
  (if (= index (bytes-count right))
    true
    (and (= (bytes-at left (+ offset index)) (bytes-at right index))
         (bytes-equal-at? left right offset (+ index 1)))))

(defn- u16-be [data :bytes offset :i64] :i64
  (+ (* (bytes-at data offset) 256)
     (bytes-at data (+ offset 1))))

(defn- u32-be [data :bytes offset :i64] :i64
  (+ (* (bytes-at data offset) 16777216)
     (* (bytes-at data (+ offset 1)) 65536)
     (* (bytes-at data (+ offset 2)) 256)
     (bytes-at data (+ offset 3))))

(defn- remainder [value :i64 divisor :i64] :i64
  (- value (* (quot value divisor) divisor)))

(defn- append-u16 [out :vector-i64 value :i64] :vector-i64
  (vector-conj (vector-conj out (quot value 256)) (remainder value 256)))

(defn- append-u32 [out :vector-i64 value :i64] :vector-i64
  (-> out
      (vector-conj (quot value 16777216))
      (vector-conj (remainder (quot value 65536) 256))
      (vector-conj (remainder (quot value 256) 256))
      (vector-conj (remainder value 256))))

(defn- append-zeroes [out :vector-i64 count :i64] :vector-i64
  (loop [result out index 0]
    (if (= index count)
      result
      (recur (vector-conj result 0) (+ index 1)))))

(defn- append-bytes [out :vector-i64 data :bytes] :vector-i64
  (loop [result out index 0]
    (if (= index (bytes-count data))
      result
      (recur (vector-conj result (bytes-at data index)) (+ index 1)))))

(defn- zero-bytes [count :i64] :bytes
  (loop [result (bytes-from-vector-i64 (vector-i64)) index 0]
    (if (= index count)
      result
      (let [remaining (- count index)
            chunk-size (if (> remaining 1024) 1024 remaining)
            chunk (bytes-from-vector-i64
                    (append-zeroes (vector-i64) chunk-size))]
        (recur (bytes-concat result chunk) (+ index chunk-size))))))

(defn- power-of-two? [value :i64] :bool
  (if (= value 1)
    true
    (if (or (< value 1) (not= (- value (* (quot value 2) 2)) 0))
      false
      (power-of-two? (quot value 2)))))

(defn- supported-page-size? [page-size :i64] :bool
  (or (= page-size 65536)
      (and (>= page-size 512)
           (<= page-size 32768)
           (power-of-two? page-size))))

(defn- invalid-header [] :vector-i64
  (vector-i64 -1 -1 -1 -1 -1 -1))

(defn- empty-page-size? [page-size :i64] :bool
  (or (= page-size 65536)
      (and (>= page-size 512)
           (<= page-size 32768)
           (power-of-two? page-size))))

;; Create a one-page, empty SQLite v3 database. Page 1 is the empty leaf
;; table-btree root for sqlite_schema. Invalid page sizes return empty bytes.
(defn create-empty [page-size :i64] :bytes
  (if (not (empty-page-size? page-size))
    (bytes-from-vector-i64 (vector-i64))
    (let [raw-page-size (if (= page-size 65536) 1 page-size)
          header (-> (append-bytes (vector-i64) magic)
                     (append-u16 raw-page-size)
                     (vector-conj 1)
                     (vector-conj 1)
                     (vector-conj 0)
                     (vector-conj 64)
                     (vector-conj 32)
                     (vector-conj 32)
                     (append-u32 1)
                     (append-u32 1)
                     (append-u32 0)
                     (append-u32 0)
                     (append-u32 0)
                     (append-u32 0)
                     (append-u32 0)
                     (append-u32 0)
                     (append-u32 1)
                     (append-u32 0)
                     (append-u32 0)
                     (append-u32 0)
                     (append-zeroes 20)
                     (append-u32 1)
                     (append-u32 0))
          content-start (if (= page-size 65536) 0 page-size)
          page-one (-> (vector-i64 13)
                       (append-u16 0)
                       (append-u16 0)
                       (append-u16 content-start)
                       (vector-conj 0))
          header-bytes (bytes-from-vector-i64 header)
          page-one-bytes (bytes-from-vector-i64 page-one)
          prefix (bytes-concat header-bytes page-one-bytes)]
      (bytes-concat prefix (zero-bytes (- page-size 108))))))

;; Returns [page-size read-version write-version reserved-bytes encoding page-count].
;; Page size 1 in the file format denotes 65536 bytes.
(defn decode [data :bytes] :vector-i64
  (if (< (bytes-count data) 100)
    (invalid-header)
    (if (not (bytes-equal-at? data magic 0 0))
      (invalid-header)
      (let [raw-page-size (u16-be data 16)
            page-size (if (= raw-page-size 1) 65536 raw-page-size)
            read-version (bytes-at data 18)
            write-version (bytes-at data 19)
            reserved (bytes-at data 20)
            encoding (u32-be data 56)
            page-count (u32-be data 28)]
        (if (or (not (supported-page-size? page-size))
                (>= reserved page-size)
                (< (- page-size reserved) 480)
                (and (not= read-version 1) (not= read-version 2))
                (and (not= write-version 1) (not= write-version 2))
                (not= (bytes-at data 21) 64)
                (not= (bytes-at data 22) 32)
                (not= (bytes-at data 23) 32)
                (< encoding 1)
                (> encoding 3))
          (invalid-header)
          (vector-i64 page-size read-version write-version reserved encoding page-count))))))
