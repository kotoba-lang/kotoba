;; Narrow sqlite_schema record encoders for table and autoindex entries.
;; The returned records still need B-tree cell/page placement by the caller.

(ns kotoba.sqlite.schema
  {:kotoba/export [encode-table-entry encode-index-entry]}
  (:require [kotoba.sqlite.record :as record]))

(def table-type
  (bytes-from-vector-i64 (vector-i64 116 97 98 108 101)))

(def index-type
  (bytes-from-vector-i64 (vector-i64 105 110 100 101 120)))

(defn- remainder [value :i64 divisor :i64] :i64
  (- value (* (quot value divisor) divisor)))

(defn- text-serial [value :bytes] :i64
  (+ 13 (* (bytes-count value) 2)))

(defn- root-page-width [root-page :i64] :i64
  (cond
    (or (< root-page 2) (> root-page 2147483647)) 0
    (<= root-page 127) 1
    (<= root-page 32767) 2
    (<= root-page 8388607) 3
    :else 4))

(defn- root-page-bytes [root-page :i64 width :i64] :bytes
  (cond
    (= width 1) (bytes-from-vector-i64 (vector-i64 root-page))
    (= width 2)
    (bytes-from-vector-i64
      (vector-i64 (quot root-page 256) (remainder root-page 256)))
    (= width 3)
    (bytes-from-vector-i64
      (vector-i64 (quot root-page 65536)
                  (remainder (quot root-page 256) 256)
                  (remainder root-page 256)))
    (= width 4)
    (bytes-from-vector-i64
      (vector-i64 (quot root-page 16777216)
                  (remainder (quot root-page 65536) 256)
                  (remainder (quot root-page 256) 256)
                  (remainder root-page 256)))
    :else (bytes-from-vector-i64 (vector-i64))))

(defn- table-entry [type :bytes name :bytes root-page :i64 sql :bytes] :bytes
  (let [width (root-page-width root-page)]
    (if (or (= width 0)
            (= (bytes-count name) 0)
            (= (bytes-count sql) 0))
      (bytes-from-vector-i64 (vector-i64))
      (let [root-value (root-page-bytes root-page width)
            root-serial width
            values (bytes-concat type
                     (bytes-concat name
                       (bytes-concat name
                         (bytes-concat root-value sql))))]
        (record/encode
          (vector-i64 (text-serial type)
                      (text-serial name)
                      (text-serial name)
                      root-serial
                      (text-serial sql))
          values)))))

;; Encode sqlite_schema(type='table', name, tbl_name, rootpage, sql).
(defn encode-table-entry [name :bytes root-page :i64 sql :bytes] :bytes
  (table-entry table-type name root-page sql))

;; Encode a primary-key autoindex sqlite_schema row (sql is NULL).
(defn encode-index-entry [index-name :bytes table-name :bytes
                          root-page :i64] :bytes
  (let [width (root-page-width root-page)]
    (if (or (= width 0)
            (= (bytes-count index-name) 0)
            (= (bytes-count table-name) 0))
      (bytes-from-vector-i64 (vector-i64))
      (let [root-value (root-page-bytes root-page width)
            values (bytes-concat index-type
                     (bytes-concat index-name
                       (bytes-concat table-name root-value)))]
        (record/encode
          (vector-i64 (text-serial index-type)
                      (text-serial index-name)
                      (text-serial table-name)
                      width
                      0)
          values)))))
