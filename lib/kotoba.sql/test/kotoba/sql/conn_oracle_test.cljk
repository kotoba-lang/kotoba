(ns kotoba.sql.conn-oracle-test
  "JVM ORACLE (runs only on the JVM: scripts/jvm_test.cljk with the
  sqlite-jdbc jar). The same scripted workload runs through raw JDBC interop
  and through kotoba.sql.conn; every observation must be identical, and both
  must equal the literal `expected` the portable test holds kbb to."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.sql.conn :as conn]
            [kotoba.sql.conn-workload :as w])
  #?(:clj (:import [java.sql Connection PreparedStatement ResultSet Statement]
                   [org.sqlite SQLiteDataSource])))

#?(:clj
   (do
     (def raw-ops
       "Raw JDBC interop: the thing kotoba.sql.conn replaces."
       {:connection (fn [ds] (.getConnection ^javax.sql.DataSource ds))
        :create-statement (fn [^Connection c] (.createStatement c))
        :execute! (fn [^Statement st ^String sql] (.execute st sql))
        :prepare (fn [^Connection c ^String sql] (.prepareStatement c sql))
        :set-object! (fn [^PreparedStatement st i v] (.setObject st (int i) v))
        :set-bytes! (fn [^PreparedStatement st i v] (.setBytes st (int i) ^bytes v))
        :set-long! (fn [^PreparedStatement st i v] (.setLong st (int i) (long v)))
        :set-int! (fn [^PreparedStatement st i v] (.setInt st (int i) (int v)))
        :set-string! (fn [^PreparedStatement st i v] (.setString st (int i) ^String v))
        :set-null! (fn [^PreparedStatement st i t] (.setNull st (int i) (int t)))
        :execute-update! (fn [^PreparedStatement st] (.executeUpdate st))
        :execute-statement! (fn [^PreparedStatement st] (.execute st))
        :execute-query (fn [^PreparedStatement st] (.executeQuery st))
        :next! (fn [^ResultSet rs] (.next rs))
        :get-string (fn [^ResultSet rs col] (if (string? col) (.getString rs ^String col) (.getString rs (int col))))
        :get-bytes (fn [^ResultSet rs col] (if (string? col) (.getBytes rs ^String col) (.getBytes rs (int col))))
        :get-long (fn [^ResultSet rs col] (if (string? col) (.getLong rs ^String col) (.getLong rs (int col))))
        :get-int (fn [^ResultSet rs col] (if (string? col) (.getInt rs ^String col) (.getInt rs (int col))))
        :get-object (fn [^ResultSet rs col] (if (string? col) (.getObject rs ^String col) (.getObject rs (int col))))
        :was-null? (fn [^ResultSet rs] (.wasNull rs))
        :auto-commit? (fn [^Connection c] (.getAutoCommit c))
        :set-auto-commit! (fn [^Connection c b] (.setAutoCommit c (boolean b)))
        :commit! (fn [^Connection c] (.commit c))
        :rollback! (fn [^Connection c] (.rollback c))
        :close! (fn [^java.lang.AutoCloseable x] (.close x))
        :closed? (fn [^Connection c] (.isClosed c))
        :add-batch! (fn [^PreparedStatement st] (.addBatch st))
        :execute-batch! (fn [^PreparedStatement st] (.executeBatch st))
        :clear-batch! (fn [^PreparedStatement st] (.clearBatch st))})

     (defn- raw-ds [path]
       (doto (SQLiteDataSource.) (.setUrl (str "jdbc:sqlite:" path))))

     (deftest oracle-raw-jdbc-vs-kotoba-sql-conn
       (let [raw (w/workload raw-ops raw-ds)
             via (w/workload w/conn-ops conn/sqlite-datasource)
             expected w/expected]
         (when-let [out (System/getenv "KOTOBA_SQL_ORACLE_OUT")]
           (spit out (pr-str raw)))
         (testing "the workload measured something"
           (is (< 60 (count raw))))
         (testing "same labels in the same order"
           (is (= (mapv first raw) (mapv first via))))
         (doseq [[[label r] [_ v]] (map vector raw via)]
           (is (= r v) (str "raw JDBC vs kotoba.sql.conn at " label)))
         (testing "the recorded literal is exactly the raw JDBC answer"
           (is (= (count expected) (count raw)))
           (doseq [[[label r] [_ e]] (map vector raw expected)]
             (is (= e r) (str "recorded expectation vs raw JDBC at " label))))))

     (deftest driver-manager-fallback-datasource
       (testing "the DriverManager-backed DataSource opens sqlite the same way"
         (let [ds (conn/driver-manager-datasource "jdbc:sqlite::memory:")]
           (is (conn/datasource? ds))
           (with-open [c (conn/connection ds)]
             (is (= [[5 "x"]] (conn/query c "SELECT ?, ?" [5 "x"]
                                          (fn [rs] [(conn/get-long rs 1) (conn/get-string rs 2)]))))))))))
