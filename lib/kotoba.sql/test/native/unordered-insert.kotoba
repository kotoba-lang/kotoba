(ns sqlite.notepad-unordered-writer-compile
  {:kotoba/export [main]}
  (:capabilities #{:fs/app-data-bytes})
  (:require [kotoba.sqlite.database :as database]
            [kotoba.sqlite.reader :as reader]))

(defn- text [values :vector-i64] :bytes (bytes-from-vector-i64 values))

(defn main [] :i64
  (let [page-size 4096
        image (database/create-cron-notepad page-size)
        job-b (text (vector-i64 106 111 98 45 98))
        job-a (text (vector-i64 106 111 98 45 97))
        key-z (text (vector-i64 122))
        key-a (text (vector-i64 97))
        value-b (text (vector-i64 98 114 97 118 111))
        value-a (text (vector-i64 97 108 112 104 97))
        updated-one (text (vector-i64 116 49))
        updated-two (text (vector-i64 116 50))
        updated-three (text (vector-i64 116 51))
        first (database/insert-first-notepad-row image page-size
                 job-b key-z value-b updated-one)
        unordered (database/append-notepad-row first page-size
                    job-a key-a value-a updated-two)
        duplicate (database/append-notepad-row unordered page-size
                    job-a key-a value-a updated-two)
        key-b (text (vector-i64 98))
        value-c (text (vector-i64 99 97 110 97 114 121))
        inserted-three (database/append-notepad-row unordered page-size
                         job-a key-b value-c updated-three)
        deleted (database/delete-notepad-key inserted-three page-size job-a key-a)
        read-a (reader/lookup-notepad-value deleted page-size job-a key-b)
        read-b (reader/lookup-notepad-value deleted page-size job-b key-z)
        missing (reader/lookup-notepad-value deleted page-size job-a key-a)
        header (text (vector-i64 0 70 83 50 0 66))
        path (text (vector-i64 119 114 105 116 116 101 110 46 100 98))
        request (bytes-concat
                  (bytes-concat (bytes-concat header path) (text (vector-i64 0)))
                  deleted)
        response (typed-cap-call :fs/app-data-bytes :bytes :bytes request)]
    (cond
      (not= (bytes-count first) (* page-size 3)) 1
      (not= (bytes-count unordered) (* page-size 3)) 2
      (not= (bytes-count duplicate) 0) 3
      (not= (bytes-count inserted-three) (* page-size 3)) 4
      (not= (bytes-count deleted) (* page-size 3)) 5
      (not= (bytes-count read-a) 12) 6
      (not= (bytes-at read-a 4) 1) 7
      (not= (bytes-at read-a 6) 99) 8
      (not= (bytes-count read-b) 11) 9
      (not= (bytes-at read-b 4) 1) 10
      (not= (bytes-at read-b 6) 98) 11
      (not= (bytes-count missing) 5) 12
      (not= (bytes-at missing 4) 0) 13
      (not= (bytes-at response 0) 0) 14
      (not= (bytes-at response 1) 70) 15
      (not= (bytes-at response 2) 83) 16
      (not= (bytes-at response 3) 50) 17
      (not= (bytes-at response 4) 0) 18
      :else 0)))
