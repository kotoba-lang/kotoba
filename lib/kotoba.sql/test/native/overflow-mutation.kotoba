(ns sqlite.notepad-overflow-mutation
  {:kotoba/export [main]}
  (:capabilities #{:fs/app-data-bytes})
  (:require [kotoba.sqlite.database :as database]
            [kotoba.sqlite.header :as header]
            [kotoba.sqlite.reader :as reader]))

(defn- text [values :vector-i64] :bytes
  (bytes-from-vector-i64 values))

(defn- repeat-chunk [value :i64 count :i64] :bytes
  (loop [index 0 out (vector-i64)]
    (if (= index count)
      (bytes-from-vector-i64 out)
      (recur (+ index 1) (vector-conj out value)))))

(defn- repeated-byte [value :i64 count :i64] :bytes
  (loop [remaining count out (text (vector-i64))]
    (if (= remaining 0)
      out
      (let [chunk-size (if (> remaining 1024) 1024 remaining)]
        (recur (- remaining chunk-size)
               (bytes-concat out (repeat-chunk value chunk-size)))))))

(defn- all-byte? [data :bytes offset :i64 value :i64] :bool
  (if (= offset (bytes-count data))
    true
    (and (= (bytes-at data offset) value)
         (all-byte? data (+ offset 1) value))))

(defn main [] :i64
  (let [page-size 4096
        image (database/create-cron-notepad page-size)
        job-a (text (vector-i64 106 111 98 45 97))
        key-a (text (vector-i64 99 117 114 115 111 114))
        job-b (text (vector-i64 106 111 98 45 98))
        key-b (text (vector-i64 100 101 108 101 116 101))
        large-value (repeated-byte 120 16384)
        updated-a (text (vector-i64 116 49))
        small-value (text (vector-i64 107 101 101 112))
        updated-b (text (vector-i64 116 50))
        inserted (database/insert-first-notepad-row image page-size job-a key-a
                   large-value updated-a)
        appended (database/append-notepad-row inserted page-size job-b key-b
                   small-value updated-b)
        changed-value (repeated-byte 121 16384)
        changed-at (text (vector-i64 116 51))
        updated (database/update-notepad-row appended page-size job-a key-a
                  changed-value changed-at)
        deleted (database/delete-notepad-key updated page-size job-b key-b)
        deleted-again (reader/lookup-notepad-value deleted page-size job-b key-b)
        kept (reader/lookup-notepad-value deleted page-size job-a key-a)
        fields (header/decode deleted)
        fs2-header (text (vector-i64 0 70 83 50 0 66))
        path (text (vector-i64 111 118 101 114 102 108 111 119 46 100 98))
        request (bytes-concat
                  (bytes-concat (bytes-concat fs2-header path)
                                (text (vector-i64 0)))
                  deleted)
        response (typed-cap-call :fs/app-data-bytes :bytes :bytes request)]
    (if (and (= (bytes-count inserted) (* page-size 7))
             (= (bytes-count appended) (* page-size 7))
             (= (bytes-count updated) (* page-size 7))
             (= (bytes-count deleted) (* page-size 7))
             (= (vector-at fields 5) 7)
             (= (bytes-count kept) 16392)
             (= (bytes-at kept 4) 1)
             (all-byte? (bytes-slice kept 8 (bytes-count kept)) 0 121)
             (= (bytes-count deleted-again) 5)
             (= (bytes-at deleted-again 4) 0)
             (= (bytes-at response 0) 0)
             (= (bytes-at response 1) 70)
             (= (bytes-at response 2) 83)
             (= (bytes-at response 3) 50)
             (= (bytes-at response 4) 0))
      0
      1)))
