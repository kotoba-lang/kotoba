(ns sqlite.notepad-unsupported-schema-refusal
  {:kotoba/export [main]}
  (:capabilities #{:cli/args :fs/app-data :fs/app-data-bytes})
  (:require [kotoba.sqlite.database :as database]))

(defn- text [values :vector-i64] :bytes
  (bytes-from-vector-i64 values))

(defn main [] :i64
  (let [page-size 4096
        path (string-to-utf8 (typed-cap-call :cli/args :string :string "0"))
        job (text (vector-i64 106 111 98 45 110 101 119))
        key (text (vector-i64 110 111 116 101))
        value (text (vector-i64 115 104 111 117 108 100 45 110 111 116 45 119 114 105 116 101))
        updated-at (text (vector-i64 116 49))
        read-result (database/read-cron-notepad-image path page-size)]
    (if (not= (bytes-at read-result 0) 1)
      10
      (let [image (bytes-slice read-result 1 (bytes-count read-result))
            mutated (database/upsert-notepad-row image page-size job key value updated-at)]
        (if (not= (bytes-count mutated) 0)
          11
          (let [write-result (database/write-cron-notepad-image path mutated page-size)]
            (if (and (= (bytes-count write-result) 1)
                     (= (bytes-at write-result 0) 1))
              0
              12)))))))
