(ns sqlite.interior-root-job-delete
  {:kotoba/export [main]}
  (:capabilities #{:cli/args :fs/app-data :fs/app-data-bytes})
  (:require [kotoba.sqlite.database :as database]
            [kotoba.sqlite.header :as header]
            [kotoba.sqlite.reader :as reader]))

(defn- text [values :vector-i64] :bytes
  (bytes-from-vector-i64 values))

(defn- repeated-byte [count :i64 value :i64] :bytes
  (loop [remaining count out (vector-i64)]
    (if (= remaining 0)
      (bytes-from-vector-i64 out)
      (recur (- remaining 1) (vector-conj out value)))))

(defn- key-at [index :i64] :bytes
  (text (vector-i64 106 111 98 45 107 101 121 45
                    (quot index 256) (mod index 256))))

(defn- fill-until-interior-root [image :bytes page-size :i64
                                 index :i64 value :bytes] :bytes
  (if (>= index 8)
    (bytes-from-vector-i64 (vector-i64))
    (let [next (database/upsert-notepad-row image page-size
                 (text (vector-i64 106 111 98)) (key-at index)
                 value (text (vector-i64 116 49)))]
      (if (= (bytes-count next) 0)
        (bytes-from-vector-i64 (vector-i64))
        (if (= (vector-at (header/decode next) 5) 7)
          next
          (fill-until-interior-root next page-size (+ index 1) value)))))

(defn main [] :i64
  (let [page-size 4096
        path (string-to-utf8 (typed-cap-call :cli/args :string :string "0"))
        job-id (text (vector-i64 106 111 98))
        value (repeated-byte 970 118)
        initial (database/create-cron-notepad page-size)
        interior (fill-until-interior-root initial page-size 0 value)]
    (if (or (= (bytes-count interior) 0)
            (not= (bytes-count interior) (* page-size 7)))
      10
      (let [deleted (database/delete-notepad-job interior page-size job-id)
            written (database/write-cron-notepad-image path deleted page-size)]
        (if (or (not= (bytes-count deleted) (* page-size 3))
                (not= (bytes-count written) 1)
                (not= (bytes-at written 0) 0))
          11
          (let [reopened (database/read-cron-notepad-image path page-size)
                image (bytes-slice reopened 1 (bytes-count reopened))
                missing (reader/lookup-notepad-value image page-size job-id (key-at 0))
                page-count (vector-at (header/decode image) 5)]
            (if (and (= (bytes-at reopened 0) 1)
                     (= page-count 3)
                     (= (bytes-at missing 4) 0))
              0
              12))))))
