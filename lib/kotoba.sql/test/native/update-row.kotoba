(ns sqlite.notepad-update-compile
  {:kotoba/export [main]}
  (:capabilities #{:fs/app-data-bytes})
  (:require [kotoba.sqlite.database :as database]
            [kotoba.sqlite.reader :as reader]))
(defn- text [values :vector-i64] :bytes (bytes-from-vector-i64 values))
(defn main [] :i64
  (let [page-size 4096
        image (database/create-cron-notepad page-size)
        job-id (text (vector-i64 106 111 98 45 97))
        key-one (text (vector-i64 99 117 114 115 111 114))
        key-two (text (vector-i64 99 117 114 115 111 114 45 50))
        key-three (text (vector-i64 99 117 114 115 111 114 45 51))
        value-one (text (vector-i64 104 101 108 108 111))
        value-two (text (vector-i64 119 111 114 108 100))
        value-three (text (vector-i64 97 103 97 105 110))
        updated-one (text (vector-i64 116 49))
        updated-two (text (vector-i64 116 50))
        updated-three (text (vector-i64 116 51))
        new-value (text (vector-i64 117 112 100 97 116 101 100 45 118 97 108 117 101))
        new-updated (text (vector-i64 116 50 45 117 112 100 97 116 101 100))
        first (database/insert-first-notepad-row image page-size job-id key-one
                value-one updated-one)
        second (database/append-notepad-row first page-size job-id key-two
                 value-two updated-two)
        third (database/append-notepad-row second page-size job-id key-three
                value-three updated-three)
        changed (database/update-notepad-row third page-size job-id key-two
                  new-value new-updated)
        unchanged (database/update-notepad-row changed page-size job-id
                    (text (vector-i64 109 105 115 115 105 110 103))
                    value-two updated-two)
        read-one (reader/lookup-notepad-value unchanged page-size job-id key-one)
        read-two (reader/lookup-notepad-value unchanged page-size job-id key-two)
        read-three (reader/lookup-notepad-value unchanged page-size job-id key-three)
        header (text (vector-i64 0 70 83 50 0 66))
        path (text (vector-i64 119 114 105 116 116 101 110 46 100 98))
        request (bytes-concat
                  (bytes-concat (bytes-concat header path) (text (vector-i64 0)))
                  unchanged)
        response (typed-cap-call :fs/app-data-bytes :bytes :bytes request)]
    (if (and (= (bytes-count first) (* page-size 3))
             (= (bytes-count second) (* page-size 3))
             (= (bytes-count third) (* page-size 3))
             (= (bytes-count changed) (* page-size 3))
             (= (bytes-count unchanged) (* page-size 3))
             (= (bytes-count read-one) 11)
             (= (bytes-at read-one 4) 1)
             (= (bytes-count read-two) 19)
             (= (bytes-at read-two 4) 1)
             (= (bytes-at read-two 6) 117)
             (= (bytes-count read-three) 11)
             (= (bytes-at read-three 4) 1)
             (= (bytes-at response 0) 0)
             (= (bytes-at response 1) 70)
             (= (bytes-at response 2) 83)
             (= (bytes-at response 3) 50)
             (= (bytes-at response 4) 0)) 0 1)))
