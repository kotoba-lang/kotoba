(ns sqlite.interior-root-image
  {:kotoba/export [main]}
  (:capabilities #{:cli/args :fs/app-data :fs/app-data-bytes})
  (:require [kotoba.sqlite.database :as database]
            [kotoba.sqlite.header :as header]
            [kotoba.sqlite.notepad-record :as notepad-record]
            [kotoba.sqlite.page :as page]
            [kotoba.sqlite.reader :as reader]
            [kotoba.sqlite.record :as record]))

(defn- text [values :vector-i64] :bytes
  (bytes-from-vector-i64 values))

(defn- text-serial [data :bytes] :i64
  (+ 13 (* (bytes-count data) 2)))

(defn- index-record [job-id :bytes key :bytes rowid :i64] :bytes
  (let [rowid-type (if (= rowid 1) 9 1)
        rowid-data (if (= rowid 1) (text (vector-i64))
                       (text (vector-i64 rowid)))]
    (record/encode
      (vector-i64 (text-serial job-id) (text-serial key) rowid-type)
      (bytes-concat (bytes-concat job-id key) rowid-data))))

(defn- join-pages [header-page :bytes table-root :bytes index-root :bytes
                   table-left :bytes table-right :bytes
                   index-left :bytes index-right :bytes] :bytes
  (bytes-concat
    (bytes-concat
      (bytes-concat
        (bytes-concat
          (bytes-concat
            (bytes-concat header-page table-root)
            index-root)
          table-left)
        table-right)
      index-left)
    index-right))

(defn main [] :i64
  (let [page-size 4096
        path (string-to-utf8 (typed-cap-call :cli/args :string :string "0"))
        job-a (text (vector-i64 106 111 98 45 97))
        job-b (text (vector-i64 106 111 98 45 98))
        key (text (vector-i64 99 117 114 115 111 114))
        value-a (text (vector-i64 97))
        value-b (text (vector-i64 98))
        updated (text (vector-i64 116 49))
        base (database/create-cron-notepad page-size)
        table-record-a (notepad-record/encode job-a key value-a updated)
        table-record-b (notepad-record/encode job-b key value-b updated)
        table-cell-a (page/encode-table-leaf-cell table-record-a 1 page-size 0)
        table-cell-b (page/encode-table-leaf-cell table-record-b 2 page-size 0)
        table-left (page/encode-table-leaf-page table-cell-a page-size 4 0)
        table-right (page/encode-table-leaf-page table-cell-b page-size 5 0)
        table-root-cell (page/encode-table-interior-cell 4 1)
        table-root (page/encode-table-interior-page table-root-cell page-size 2 0 5)
        index-record-a (index-record job-a key 1)
        index-record-b (index-record job-b key 2)
        index-leaf-cell-b (page/encode-index-leaf-cell index-record-b page-size 0)
        index-left (page/encode-empty-leaf-page 10 page-size 6 0)
        index-right (page/encode-index-leaf-page index-leaf-cell-b page-size 7 0)
        index-root-cell (page/encode-index-interior-cell 6 index-record-a page-size 0)
        index-root (page/encode-index-interior-page index-root-cell page-size 3 0 7)
        resized-header (header/set-page-count (bytes-slice base 0 100) 7)
        next-header (header/advance-change-counter resized-header)
        schema-page (bytes-concat next-header (bytes-slice base 100 page-size))
        image (join-pages schema-page table-root index-root table-left table-right
                          index-left index-right)
        written (database/write-cron-notepad-image path image page-size)]
    (if (or (not= (bytes-count image) (* page-size 7))
            (not= (bytes-count written) 1)
            (not= (bytes-at written 0) 0))
      10
      (let [reopened (database/read-cron-notepad-image path page-size)
            reopened-image (bytes-slice reopened 1 (bytes-count reopened))
            first-value (reader/lookup-notepad-value reopened-image page-size job-a key)
            second-value (reader/lookup-notepad-value reopened-image page-size job-b key)
            refused (database/upsert-notepad-row reopened-image page-size job-a key
                      value-b updated)]
        (if (and (= (bytes-at reopened 0) 1)
                 (= (bytes-at first-value 4) 1)
                 (= (bytes-at first-value 6) 97)
                 (= (bytes-at second-value 4) 1)
                 (= (bytes-at second-value 6) 98)
                 (= (bytes-count refused) 0))
          0
          11)))))
