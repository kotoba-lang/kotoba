(ns sqlite.interior-page-encoder
  {:kotoba/export [main]}
  (:require [kotoba.sqlite.database :as database]
            [kotoba.sqlite.page :as page]))

(defn- text [values :vector-i64] :bytes
  (bytes-from-vector-i64 values))

(defn main [] :i64
  (let [page-size 4096
        base-image (database/create-cron-notepad page-size)
        table-cell (page/encode-table-interior-cell 4 1)
        table-page (page/encode-table-interior-page table-cell page-size 2 0 5)
        table-header (page/decode-header table-page page-size 2 0)
        table-offset (page/cell-pointer table-page page-size 2 0 0)
        table-decoded (page/decode-table-interior-cell
                        table-page page-size 2 0 table-offset)
        key-payload (text (vector-i64 77 78 79 80))
        index-cell (page/encode-index-interior-cell 6 key-payload page-size 0)
        index-page (page/encode-index-interior-page index-cell page-size 3 0 7)
        index-header (page/decode-header index-page page-size 3 0)
        index-offset (page/cell-pointer index-page page-size 3 0 0)
        bad-child (page/encode-table-interior-cell 1 1)
        bad-rowid (page/encode-table-interior-cell 4 -1)
        bad-index-child (page/encode-index-interior-cell 1 key-payload page-size 0)
        bad-page (page/encode-index-interior-page index-cell page-size 1 0 7)]
    (if (or (not= (bytes-count base-image) (* page-size 3))
            (= (bytes-count table-cell) 0)
            (= (bytes-count table-page) 0)
            (not= (vector-at table-header 0) 5)
            (not= (vector-at table-header 3) 1)
            (not= (vector-at table-header 7) 5)
            (not= (vector-at table-decoded 0) 4)
            (not= (vector-at table-decoded 1) 1)
            (= (bytes-count index-cell) 0)
            (= (bytes-count index-page) 0)
            (not= (vector-at index-header 0) 2)
            (not= (vector-at index-header 3) 1)
            (not= (vector-at index-header 7) 7)
            (< index-offset 0)
            (not= (bytes-at index-page index-offset) 0)
            (not= (bytes-at index-page (+ index-offset 4)) 4)
            (not= (bytes-at index-page (+ index-offset 5)) 77)
            (not= (bytes-count bad-child) 0)
            (not= (bytes-count bad-rowid) 0)
            (not= (bytes-count bad-index-child) 0)
            (not= (bytes-count bad-page) 0))
      1
      0)))
