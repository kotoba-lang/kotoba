(ns sqlite.notepad-writer-compile
  {:kotoba/export [main]}
  (:capabilities #{:fs/app-data-bytes})
  (:require [kotoba.sqlite.database :as database]
            [kotoba.sqlite.reader :as reader]))
(defn- text [values :vector-i64] :bytes (bytes-from-vector-i64 values))
(defn main [] :i64
  (let [page-size 4096
        image (database/create-cron-notepad page-size)
        job-id (text (vector-i64 106 111 98 45 97))
        key (text (vector-i64 99 117 114 115 111 114))
        value (text (vector-i64 104 101 108 108 111))
        updated (text (vector-i64 116 49))
        inserted (database/insert-first-notepad-row image page-size job-id key value updated)
        reinserted (database/insert-first-notepad-row inserted page-size job-id key value updated)
        next-key (text (vector-i64 99 117 114 115 111 114 45 50))
        next-value (text (vector-i64 119 111 114 108 100))
        next-updated (text (vector-i64 116 50))
        second (database/insert-second-notepad-row inserted page-size
                 job-id next-key next-value next-updated)
        duplicate-second (database/insert-second-notepad-row second page-size
                           job-id next-key next-value next-updated)
        out-of-order (database/insert-second-notepad-row inserted page-size
                       job-id (text (vector-i64 97 97 97)) next-value next-updated)
        third-key (text (vector-i64 99 117 114 115 111 114 45 51))
        third-value (text (vector-i64 97 103 97 105 110))
        third-updated (text (vector-i64 116 51))
        third (database/append-notepad-row second page-size job-id third-key
                 third-value third-updated)
        duplicate-third (database/append-notepad-row third page-size job-id
                           third-key third-value third-updated)
        readback (reader/lookup-notepad-value third page-size job-id key)
        readback-next (reader/lookup-notepad-value third page-size job-id next-key)
        readback-third (reader/lookup-notepad-value third page-size job-id third-key)
        header (text (vector-i64 0 70 83 50 0 66))
        path (text (vector-i64 119 114 105 116 116 101 110 46 100 98))
        request (bytes-concat
                  (bytes-concat (bytes-concat header path) (text (vector-i64 0)))
                  third)
        response (typed-cap-call :fs/app-data-bytes :bytes :bytes request)]
    (if (and (= (bytes-count inserted) (* page-size 3))
             (= (bytes-count reinserted) 0)
             (= (bytes-count second) (* page-size 3))
             (= (bytes-count duplicate-second) 0)
             (= (bytes-count out-of-order) 0)
             (= (bytes-count third) (* page-size 3))
             (= (bytes-count duplicate-third) 0)
             (= (bytes-count readback) 11)
             (= (bytes-at readback 4) 1)
             (= (bytes-at readback 6) 104)
             (= (bytes-count readback-next) 11)
             (= (bytes-at readback-next 4) 1)
             (= (bytes-at readback-next 6) 119)
             (= (bytes-count readback-third) 11)
             (= (bytes-at readback-third 4) 1)
             (= (bytes-at readback-third 6) 97)
             (= (bytes-at response 0) 0)
             (= (bytes-at response 1) 70)
             (= (bytes-at response 2) 83)
             (= (bytes-at response 3) 50)
             (= (bytes-at response 4) 0)) 0 1)))
