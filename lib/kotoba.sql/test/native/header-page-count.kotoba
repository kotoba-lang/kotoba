(ns sqlite.header-page-count
  {:kotoba/export [main]}
  (:capabilities #{:fs/app-data-bytes})
  (:require [kotoba.sqlite.header :as header]))

(defn main [] :i64
  (let [initial (header/create-header 4096 3 4)
        resized (header/set-page-count initial 7)
        advanced (header/advance-change-counter resized)
        fields (header/decode advanced)
        refused-zero (header/set-page-count initial 0)
        refused-large (header/set-page-count initial 2147483648)
        malformed (header/set-page-count (bytes-slice initial 0 99) 4)]
    (if (and (= (bytes-count initial) 100)
             (= (bytes-count resized) 100)
             (= (bytes-count advanced) 100)
             (= (vector-at fields 5) 7)
             (= (bytes-at advanced 27) 2)
             (= (bytes-at advanced 28) 0)
             (= (bytes-at advanced 29) 0)
             (= (bytes-at advanced 30) 0)
             (= (bytes-at advanced 31) 7)
             (= (bytes-at advanced 24) 0)
             (= (bytes-at advanced 27) (bytes-at advanced 95))
             (= (bytes-count refused-zero) 0)
             (= (bytes-count refused-large) 0)
             (= (bytes-count malformed) 0))
      0
      1)))
