(ns sqlite.notepad-job-delete-compile
  {:kotoba/export [main]}
  (:capabilities #{:fs/app-data-bytes})
  (:require [kotoba.sqlite.database :as database]
            [kotoba.sqlite.reader :as reader]))
(defn- text [values :vector-i64] :bytes (bytes-from-vector-i64 values))
(defn main [] :i64
  (let [page-size 4096
        image (database/create-cron-notepad page-size)
        job-a (text (vector-i64 106 111 98 45 97))
        job-b (text (vector-i64 106 111 98 45 98))
        key-one (text (vector-i64 99 117 114 115 111 114))
        key-two (text (vector-i64 99 117 114 115 111 114 45 50))
        value-one (text (vector-i64 111 110 101))
        value-two (text (vector-i64 116 119 111))
        value-three (text (vector-i64 116 104 114 101 101))
        updated (text (vector-i64 116))
        first (database/insert-first-notepad-row image page-size job-a key-one
                value-one updated)
        second (database/append-notepad-row first page-size job-a key-two
                 value-two updated)
        third (database/append-notepad-row second page-size job-b key-one
                value-three updated)
        deleted (database/delete-notepad-job third page-size job-a)
        a-one (reader/lookup-notepad-value deleted page-size job-a key-one)
        a-two (reader/lookup-notepad-value deleted page-size job-a key-two)
        b-one (reader/lookup-notepad-value deleted page-size job-b key-one)
        header (text (vector-i64 0 70 83 50 0 66))
        path (text (vector-i64 119 114 105 116 116 101 110 46 100 98))
        request (bytes-concat
                  (bytes-concat (bytes-concat header path) (text (vector-i64 0)))
                  deleted)
        response (typed-cap-call :fs/app-data-bytes :bytes :bytes request)]
    (if (not= (bytes-count first) (* page-size 3)) 10
      (if (not= (bytes-count second) (* page-size 3)) 11
        (if (not= (bytes-count third) (* page-size 3)) 12
          (if (not= (bytes-count deleted) (* page-size 3)) 13
            (if (not= (bytes-count a-one) 5) 14
              (if (not= (bytes-at a-one 4) 0) 15
                (if (not= (bytes-count a-two) 5) 16
                  (if (not= (bytes-at a-two 4) 0) 17
                    (if (not= (bytes-count b-one) 11) 18
                      (if (not= (bytes-at b-one 4) 1) 19
                        (if (or (not= (bytes-at response 0) 0)
                                (not= (bytes-at response 1) 70)
                                (not= (bytes-at response 2) 83)
                                (not= (bytes-at response 3) 50)
                                (not= (bytes-at response 4) 0)) 20 0)))))))))))))
