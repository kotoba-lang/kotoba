(ns sqlite.notepad-linux-storage
  {:kotoba/export [main]}
  (:capabilities #{:cli/args :fs/app-data :fs/app-data-bytes})
  (:require [kotoba.sqlite.database :as database]
            [kotoba.sqlite.reader :as reader]))

(defn- text [values :vector-i64] :bytes
  (bytes-from-vector-i64 values))

(defn main [] :i64
  (let [page-size 4096
        path (string-to-utf8 (typed-cap-call :cli/args :string :string "0"))
        job (text (vector-i64 106 111 98 45 108 105 110 117 120))
        key (text (vector-i64 99 117 114 115 111 114))
        value (text (vector-i64 110 97 116 105 118 101))
        updated (text (vector-i64 116 49))
        image (database/create-cron-notepad page-size)
        row (database/upsert-notepad-row image page-size job key value updated)
        write-result (database/write-cron-notepad-image path row page-size)]
    (if (not= (bytes-at write-result 0) 0)
      (+ 20 (bytes-at write-result 0))
      (let [read-result (database/read-cron-notepad-image path page-size)
            reopened (bytes-slice read-result 1 (bytes-count read-result))
            found (reader/lookup-notepad-value reopened page-size job key)]
        (if (and (= (bytes-at read-result 0) 1)
                 (= (bytes-count found) 12)
                 (= (bytes-at found 4) 1)
                 (= (bytes-at found 6) 110)
                 (= (bytes-at found 7) 97)
                 (= (bytes-at found 8) 116)
                 (= (bytes-at found 9) 105)
                 (= (bytes-at found 10) 118)
                 (= (bytes-at found 11) 101))
          0
          1)))))
