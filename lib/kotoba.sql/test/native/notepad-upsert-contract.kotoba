(ns sqlite.notepad-upsert-contract
  {:kotoba/export [main refuse-sidecar]}
  (:capabilities #{:fs/app-data :fs/app-data-bytes})
  (:require [kotoba.sqlite.database :as database]
            [kotoba.sqlite.page :as page]
            [kotoba.sqlite.reader :as reader]))

(defn- text [values :vector-i64] :bytes
  (bytes-from-vector-i64 values))

(defn- repeat-chunk [value :i64 count :i64] :bytes
  (loop [index 0 out (vector-i64)]
    (if (= index count)
      (bytes-from-vector-i64 out)
      (recur (+ index 1) (vector-conj out value)))))

(defn- repeated-byte [value :i64 count :i64] :bytes
  (loop [remaining count out (text (vector-i64))]
    (if (= remaining 0)
      out
      (let [chunk-size (if (> remaining 1024) 1024 remaining)]
        (recur (- remaining chunk-size)
               (bytes-concat out (repeat-chunk value chunk-size)))))))

(defn- repeated-japanese [count :i64] :bytes
  (loop [index 0 out (text (vector-i64))]
    (if (= index count)
      out
      (recur (+ index 1)
             (bytes-concat out (text (vector-i64 230 151 165)))))))

(defn- all-byte? [data :bytes offset :i64 value :i64] :bool
  (if (= offset (bytes-count data))
    true
    (and (= (bytes-at data offset) value)
         (all-byte? data (+ offset 1) value))))

(defn main [] :i64
  (let [page-size 4096
        job (text (vector-i64 106 111 98 45 97))
        cursor (text (vector-i64 99 117 114 115 111 114))
        old-value (text (vector-i64 111 108 100))
        new-value (text (vector-i64 110 101 119))
        updated-one (text (vector-i64 116 49))
        updated-two (text (vector-i64 116 50))
        empty (database/create-cron-notepad page-size)
        first (database/upsert-notepad-row empty page-size job cursor old-value updated-one)
        replaced (database/upsert-notepad-row first page-size job cursor new-value updated-two)
        replacement (reader/lookup-notepad-value replaced page-size job cursor)
        japanese-key (repeated-japanese 128)
        japanese-row (database/upsert-notepad-row replaced page-size job japanese-key
                       (text (vector-i64 121)) updated-two)
        japanese-value (reader/lookup-notepad-value japanese-row page-size job japanese-key)
        large-key (text (vector-i64 118))
        value-16384 (repeated-byte 120 16384)
        large-row (database/upsert-notepad-row japanese-row page-size job large-key
                     value-16384 updated-two)
        large-value (reader/lookup-notepad-value large-row page-size job large-key)
        over-value (database/upsert-notepad-row large-row page-size job large-key
                      (repeated-byte 120 16385) updated-two)
        oversized-key (database/upsert-notepad-row large-row page-size job
                         (repeated-japanese 129) (text (vector-i64 120)) updated-two)
        blank-key (database/upsert-notepad-row large-row page-size job
                     (text (vector-i64 32 32)) (text (vector-i64 120)) updated-two)
        still-large (reader/lookup-notepad-value large-row page-size job large-key)
        cursor-final (reader/lookup-notepad-value large-row page-size job cursor)
        table-page (bytes-slice large-row page-size (* page-size 2))
        table-header (page/decode-header table-page page-size 2 0)
        path (text (vector-i64 100 97 116 97 47 111 118 101 114 102 108 111 119 46 100 98))
        first-write-result (database/write-cron-notepad-image path replaced page-size)
        write-result (database/write-cron-notepad-image path large-row page-size)
        read-result (database/read-cron-notepad-image path page-size)
        read-image (bytes-slice read-result 1 (bytes-count read-result))
        read-large (reader/lookup-notepad-value read-image page-size job large-key)]
    (if (and (= (bytes-count first) (* page-size 3))
             (= (bytes-count replaced) (* page-size 3))
             (= (bytes-count replacement) 9)
             (= (bytes-at replacement 4) 1)
             (= (bytes-at replacement 6) 110)
             (= (bytes-count japanese-row) (* page-size 3))
             (= (bytes-at japanese-value 4) 1)
             (= (bytes-count large-row) (* page-size 7))
             (= (bytes-at large-value 4) 1)
             (= (bytes-count large-value) 16392)
             (all-byte? (bytes-slice large-value 8 (bytes-count large-value)) 0 120)
             (= (bytes-count over-value) 0)
             (= (bytes-count oversized-key) 0)
             (= (bytes-count blank-key) 0)
             (= (bytes-count still-large) 16392)
             (= (bytes-at still-large 4) 1)
             (= (bytes-at cursor-final 6) 110)
             (= (vector-at table-header 3) 3)
             (= (bytes-at first-write-result 0) 0)
             (= (bytes-at write-result 0) 0)
             (= (bytes-at read-result 0) 1)
             (= (bytes-count read-large) 16392)
             (= (bytes-at read-large 4) 1)
             (= (bytes-at read-large 8) 120)
             (all-byte? (bytes-slice read-large 8 (bytes-count read-large)) 0 120))
      0
      1)))

;; Called against an already-published database after the harness creates one
;; SQLite sidecar at a time. Replacing only the main image must refuse.
(defn refuse-sidecar [] :i64
  (let [page-size 4096
        image (database/create-cron-notepad page-size)
        path (text (vector-i64 100 97 116 97 47 111 118 101 114 102 108 111 119 46 100 98))
        result (database/write-cron-notepad-image path image page-size)]
    (if (and (= (bytes-count result) 1)
             (= (bytes-at result 0) 6))
      0
      1)))
