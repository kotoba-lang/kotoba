(ns sqlite.notepad-existing-file-mutation
  {:kotoba/export [main]}
  (:capabilities #{:cli/args :fs/app-data :fs/app-data-bytes :hash/sha256})
  (:require [kotoba.sqlite.database :as database]
            [kotoba.sqlite.reader :as reader]))

(defn- text [values :vector-i64] :bytes
  (bytes-from-vector-i64 values))

(defn main [] :i64
  (let [page-size 4096
        path (string-to-utf8 (typed-cap-call :cli/args :string :string "0"))
        keep-job (text (vector-i64 106 111 98 45 107 101 101 112))
        delete-job (text (vector-i64 106 111 98 45 100 101 108 101 116 101))
        update-job (text (vector-i64 106 111 98 45 117 112 100 97 116 101))
        cursor (text (vector-i64 99 117 114 115 111 114))
        note-key (text (vector-i64 110 111 116 101))
        updated-at (text (vector-i64 116 49))
        read-result (database/read-cron-notepad-image path page-size)
        ]
    (if (not= (bytes-at read-result 0) 1)
      10
      (let [image (bytes-slice read-result 1 (bytes-count read-result))
            original (reader/lookup-notepad-value image page-size keep-job cursor)]
        (if (or (not= (bytes-at original 4) 1)
                (not= (bytes-at original 6) 107))
          11
          (let [updated (database/upsert-notepad-row image page-size update-job cursor
                           (text (vector-i64 110 101 119)) updated-at)]
            (if (= (bytes-count updated) 0)
              12
              (let [inserted (database/upsert-notepad-row updated page-size keep-job note-key
                               (text (vector-i64 115 116 97 121)) updated-at)]
                (if (= (bytes-count inserted) 0)
                  13
                  (let [deleted (database/delete-notepad-job inserted page-size delete-job)]
                    (if (= (bytes-count deleted) 0)
                      14
                      (let [write-result (database/write-cron-notepad-image path deleted page-size)]
                        (if (not= (bytes-at write-result 0) 0)
                          (+ 20 (bytes-at write-result 0))
                          (let [reopen-result (database/read-cron-notepad-image path page-size)
                                reopened (bytes-slice reopen-result 1 (bytes-count reopen-result))
                                keep-value (reader/lookup-notepad-value reopened page-size keep-job cursor)
                                inserted-value (reader/lookup-notepad-value reopened page-size keep-job note-key)
                                update-value (reader/lookup-notepad-value reopened page-size update-job cursor)
                                deleted-value (reader/lookup-notepad-value reopened page-size delete-job cursor)]
                            (if (and (= (bytes-at reopen-result 0) 1)
                                     (= (bytes-count keep-value) 13)
                                     (= (bytes-at keep-value 4) 1)
                                     (= (bytes-at keep-value 6) 107)
                                     (= (bytes-count inserted-value) 10)
                                     (= (bytes-at inserted-value 4) 1)
                                     (= (bytes-at inserted-value 6) 115)
                                     (= (bytes-count update-value) 9)
                                     (= (bytes-at update-value 4) 1)
                                     (= (bytes-at update-value 6) 110)
                                     (= (bytes-count deleted-value) 5)
                                     (= (bytes-at deleted-value 4) 0))
                              0
                              16)))))))))))))))
