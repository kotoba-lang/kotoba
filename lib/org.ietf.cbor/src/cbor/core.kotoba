;; Canonical native CBOR public facade. Generic input/output uses explicit
;; cbor.value records; typed fragment APIs preserve their existing byte output.
(ns cbor.core (:export [encode encode-ordered decode encode-checked decode-checked ordered tagged tagged? tag-number tag-value
 encode-null encode-bool encode-uint encode-nint encode-int encode-f64 encode-text encode-bytes encode-tag
 array-items array-item encode-array map-entries map-entry encode-map encode-map-ordered fragment-bytes])
 (:require [cbor.fragment :as fragment] [cbor.codec :as codec] [cbor.value :as value]))
(defn encode [v [:ref :cbor/value]] :vector-i64 (codec/encode v))
(defn encode-ordered [pairs [:list [:ref :cbor/value]]] :vector-i64 (codec/encode-ordered pairs))
(defn decode [bytes :vector-i64] [:ref :cbor/value] (codec/decode bytes))
(defn encode-checked [v [:ref :cbor/value]] [:result :vector-i64 :keyword] (codec/encode-checked v))
(defn decode-checked [bytes :vector-i64] [:result [:ref :cbor/value] :keyword] (codec/decode-checked bytes))
(defn ordered [pairs [:list [:ref :cbor/value]]] [:ref :cbor/value] (value/ordered pairs))
(defn tagged [bits :i64 v [:ref :cbor/value]] [:ref :cbor/value] (value/tagged bits v))
(defn tagged? [v [:ref :cbor/value]] :bool (= (value/kind v) :tag))
(defn tag-number [v [:ref :cbor/value]] :i64
 (if (tagged? v) (value/number v) (throw :cbor/not-tag)))
(defn tag-value [v [:ref :cbor/value]] [:ref :cbor/value]
 (if (and (tagged? v) (= (vector-count (value/children v)) 1))
  (typed-list-nth [:list [:ref :cbor/value]] (value/children v) 0) (throw :cbor/not-tag)))
(defn encode-null [] :vector-i64 (fragment/encode-null))
(defn encode-bool [b :bool] :vector-i64 (fragment/encode-bool b))
(defn encode-uint [n :i64] :vector-i64 (fragment/encode-uint n))
(defn encode-nint [n :i64] :vector-i64 (fragment/encode-nint n))
(defn encode-int [n :i64] :vector-i64 (fragment/encode-int n))
(defn encode-f64 [n :f64] :vector-i64 (fragment/encode-f64 n))
(defn encode-text [s :string] :vector-i64 (fragment/encode-text s))
(defn encode-bytes [b :vector-i64] :vector-i64 (fragment/encode-bytes b))
(defn encode-tag [n :i64 b :vector-i64] :vector-i64 (fragment/encode-tag n b))
(defn array-items [] :vector-i64 (fragment/array-items))
(defn array-item [items :vector-i64 item :vector-i64] :vector-i64 (fragment/array-item items item))
(defn encode-array [items :vector-i64] :vector-i64 (fragment/encode-array items))
(defn map-entries [] :vector-i64 (fragment/map-entries))
(defn map-entry [items :vector-i64 key :string item :vector-i64] :vector-i64 (fragment/map-entry items key item))
(defn encode-map [items :vector-i64] :vector-i64 (fragment/encode-map items))
(defn encode-map-ordered [items :vector-i64] :vector-i64 (fragment/encode-map-ordered items))
(defn fragment-bytes [items :vector-i64] :vector-i64 (fragment/fragment-bytes items))
