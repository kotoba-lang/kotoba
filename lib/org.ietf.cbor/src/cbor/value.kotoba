;; Explicit native value domain for generic CBOR. Unsigned and negative
;; 64-bit arguments retain their complete bit pattern; no host number coercion.
(ns cbor.value (:export [make null-value bool-value int-value uint-bits negative-bits
 f64-bits text-value bytes-value array-value map-value ordered tagged kind number text data children])
 (:schemas {:cbor/value [:record :cbor/value [[:kind :keyword] [:number :i64]
  [:text :string] [:data :vector-i64] [:children [:list [:ref :cbor/value]]]]]}))
(defn make [kind :keyword number :i64 text :string data :vector-i64 children [:list [:ref :cbor/value]]] [:ref :cbor/value]
 (record-new [:ref :cbor/value] kind number text data children))
(defn- empty [] [:list [:ref :cbor/value]] (typed-list-new [:list [:ref :cbor/value]]))
(defn null-value [] [:ref :cbor/value] (make :null 0 "" [] (empty)))
(defn bool-value [b :bool] [:ref :cbor/value] (make :bool (if b 1 0) "" [] (empty)))
(defn int-value [n :i64] [:ref :cbor/value] (make :int n "" [] (empty)))
(defn uint-bits [bits :i64] [:ref :cbor/value] (make :uint bits "" [] (empty)))
(defn negative-bits [bits :i64] [:ref :cbor/value] (make :negative bits "" [] (empty)))
(defn f64-bits [bits :i64] [:ref :cbor/value] (make :f64 bits "" [] (empty)))
(defn text-value [s :string] [:ref :cbor/value] (make :text 0 s [] (empty)))
(defn bytes-value [v :vector-i64] [:ref :cbor/value] (make :bytes 0 "" v (empty)))
(defn array-value [v [:list [:ref :cbor/value]]] [:ref :cbor/value] (make :array 0 "" [] v))
(defn map-value [v [:list [:ref :cbor/value]]] [:ref :cbor/value] (make :map 0 "" [] v))
(defn ordered [pairs [:list [:ref :cbor/value]]] [:ref :cbor/value] (make :ordered 0 "" [] pairs))
(defn tagged [bits :i64 value [:ref :cbor/value]] [:ref :cbor/value]
 (make :tag bits "" [] (typed-list-conj [:list [:ref :cbor/value]] (empty) value)))
(defn kind [v [:ref :cbor/value]] :keyword (record-get [:ref :cbor/value] v :kind))
(defn number [v [:ref :cbor/value]] :i64 (record-get [:ref :cbor/value] v :number))
(defn text [v [:ref :cbor/value]] :string (record-get [:ref :cbor/value] v :text))
(defn data [v [:ref :cbor/value]] :vector-i64 (record-get [:ref :cbor/value] v :data))
(defn children [v [:ref :cbor/value]] [:list [:ref :cbor/value]] (record-get [:ref :cbor/value] v :children))
