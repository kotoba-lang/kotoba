;; Native compiler Form adapter. Generic CBOR itself has no compiler dependency.
(ns cbor.form (:export [from-form from-form-checked encode-form])
 (:require [kotoba.form :as form] [cbor.value :as value] [cbor.codec :as codec]))
(defn- children [f [:ref :form/r] depth :i64] [:list [:ref :cbor/value]]
 (let [kids (form/kids-of f)]
  (loop [i 0 out (typed-list-new [:list [:ref :cbor/value]])]
   (if (= i (vector-count kids)) out
    (let [result (checked-at (typed-list-nth [:list [:ref :form/r]] kids i) (+ depth 1))]
     (if (result-ok?-of [:result [:ref :cbor/value] :keyword] result)
      (let [item (result-value-of [:result [:ref :cbor/value] :keyword] result (value/null-value))]
       (recur (+ i 1) (typed-list-conj [:list [:ref :cbor/value]] out item)))
      (throw (result-error-of [:result [:ref :cbor/value] :keyword] result :cbor/form-kind))))))))
(defn- from-at [f [:ref :form/r] depth :i64] [:ref :cbor/value]
 (if (> depth 512) (throw :cbor/depth)
 (case (form/tag-of f)
  0 (value/null-value) 1 (value/bool-value (form/bool-value f)) 2 (value/int-value (form/int-value f))
  3 (value/text-value (form/string-value f)) 4 (value/text-value (keyword-name (form/keyword-value f)))
  6 (value/array-value (children f depth)) 7 (value/array-value (children f depth)) 9 (value/map-value (children f depth))
  10 (value/f64-bits (form/bits-of f)) 11 (value/bytes-value (vector-i64-from-bytes (form/bytes-of f)))
  (throw :cbor/form-kind))))
(defn- checked-at [f [:ref :form/r] depth :i64] [:result [:ref :cbor/value] :keyword]
 (try (result-ok-of [:result [:ref :cbor/value] :keyword] (from-at f depth))
  (catch :keyword error (result-err-of [:result [:ref :cbor/value] :keyword] error))))
(defn from-form [f [:ref :form/r]] [:ref :cbor/value] (from-at f 0))
(defn from-form-checked [f [:ref :form/r]] [:result [:ref :cbor/value] :keyword] (checked-at f 0))
(defn encode-form [f [:ref :form/r]] :vector-i64 (codec/encode (from-form f)))
