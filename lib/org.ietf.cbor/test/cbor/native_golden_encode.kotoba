(ns cbor.native-golden-encode (:export [main])
 (:require [kotoba.form :as f] [kotoba.compiler.kotoba-reader :as reader]
           [cbor.native-golden-values :as values] [cbor.codec :as codec] [cbor.value :as v]
           [multiformats.cid :as cid]))
(defn- same? [a :vector-i64 b :vector-i64] :bool
 (and (= (vector-count a) (vector-count b))
  (loop [i 0] (cond (= i (vector-count a)) true (not= (vector-at a i) (vector-at b i)) false :else (recur (+ i 1))))))
(defn- hex [bytes :vector-i64] :string
 (let [digits "0123456789abcdef" n (min (vector-count bytes) 128)]
  (loop [i 0 out ""] (if (= i n) out
   (let [b (vector-at bytes i) hi (quot b 16) lo (bit-and b 15)]
    (recur (+ i 1) (string-concat out (string-concat (string-substring digits hi (+ hi 1))
     (string-substring digits lo (+ lo 1))))))))))
(defn- native-correction [index :i64] :string
 (case index 13 "1b0020000000000001" 26 "1b7fffffffffffffff" 27 "3b7fffffffffffffff"
  295 "1b0020000000000001" 297 "3b0020000000000000" 302 "fb8000000000000000"
  314 "fb4340000000000001" 363 "dbffffffffffffffff01" ""))
(defn- compare [value [:ref :cbor/value] index :i64 want :string] :i64
 (try
  (let [bytes (codec/encode value) correction (native-correction index)]
   (if (string=? correction "")
    (if (same? bytes (cid/hex->bytes want)) 0
     (let [p (typed-cap-call :io/write :string :string (string-concat "mismatch " (string-concat (string-from-i64 index)
      (string-concat " old=" (string-concat (if (> (string-length want) 256) (string-substring want 0 256) want)
       (string-concat " native=" (string-concat (hex bytes) "\n")))))))] 1))
    (if (and (same? bytes (cid/hex->bytes correction)) (not (string=? correction want)))
     (let [p (typed-cap-call :io/write :string :string (string-concat "classified-native-domain " (string-concat (string-from-i64 index)
      (string-concat " old=" (string-concat want (string-concat " native=" (string-concat correction "\n")))))))] 0)
     (let [p (typed-cap-call :io/write :string :string (string-concat "wrong-correction " (string-concat (string-from-i64 index)
      (string-concat " old=" (string-concat want (string-concat " native=" (string-concat (hex bytes) "\n")))))))] 2))))
  (catch :keyword reason (let [p (typed-cap-call :io/write :string :string (string-concat "encode-refused "
    (string-concat (string-from-i64 index) (string-concat " " (string-concat (keyword-name reason) "\n")))))] 3))))
(defn- run [] :i64
 (let [path (typed-cap-call :cli/args :string :string "0") text (typed-cap-call :fs/app-data :string :string path)
       read (reader/read-forms-bounded text 512 524288) error (record-get [:ref :kotoba.reader/out] read :err)
       forms (record-get [:ref :kotoba.reader/out] read :forms) d (values/draws)]
  (if (or (not (string=? error "")) (not= (vector-count forms) 1)) 5
   (let [golden (typed-list-nth [:list [:ref :form/r]] forms 0)]
    (if (not= (f/count-of golden) 2367) 6
     (loop [index 0 next 0 bad 0]
      (if (= index 2367)
       (let [p (typed-cap-call :io/write :string :string (string-concat "full-value-encode-count 2367 failures "
          (string-concat (string-from-i64 bad) "\n")))] (if (= bad 0) 0 7))
       (let [packed (arena-scope
          (let [draw (if (< index 367)
                       (record-new [:ref :cbor/golden-draw] (values/edge index) next)
                       (values/random-value d next 0))
                status (compare (record-get [:ref :cbor/golden-draw] draw :value) index (f/string-value (f/nth-of golden index)))]
           (+ (* (record-get [:ref :cbor/golden-draw] draw :next) 8) status)))
             status (mod packed 8)]
        (recur (+ index 1) (quot packed 8) (+ bad (if (= status 0) 0 1)))))))))))
(defn main [] :i64 (run))
