(ns cbor.core-golden-test
  "The bytes `cbor/encode` answers for a fixed corpus, pinned against the
  pre-S1 host-plumbing encoder (see cbor.golden-values). A content address
  is a hash of these bytes: one differing byte is a different CID."
  (:require #?(:clj [kotoba.test :refer [deftest is]]
               :cljs [cljs.test :refer [deftest is] :include-macros true])
            #?(:cljs ["node:fs" :as fs])
            [kotoba.lang.edn :as edn]
            [cbor.core :as cbor]
            [cbor.golden-values :as g]))

(defn- hex [b]
  (apply str (map #(let [v (bit-and % 255)]
                     (str (when (< v 16) "0") #?(:clj (Integer/toString v 16) :cljs (.toString v 16))))
                  #?(:clj (seq b) :cljs (array-seq b)))))

(defn- golden []
  (edn/read-string #?(:clj (slurp "lib/org.ietf.cbor/test/cbor/golden.edn")
                      :cljs (str (fs/readFileSync "lib/org.ietf.cbor/test/cbor/golden.edn" "utf8")))))

(deftest encode-matches-the-golden-corpus-byte-for-byte
  (let [values (g/corpus)
        want (golden)
        got (mapv #(hex (cbor/encode %)) values)
        bad (keep-indexed (fn [i [w h]] (when (not= w h) i)) (map vector want got))]
    ;; the corpus and the golden file must be the same length, or a shortened
    ;; corpus would pass by comparing nothing
    (is (= 2367 (count values) (count want)))
    (is (empty? bad) (str "first differing indexes: " (vec (take 10 bad))))))

(deftest decode-then-encode-is-the-identity-on-the-golden-bytes
  (let [values (g/corpus)
        bad (keep-indexed (fn [i v]
                            (let [b (cbor/encode v)]
                              (when (not= (hex b) (hex (cbor/encode (cbor/decode b)))) i)))
                          values)]
    ;; Exactly two values are not canonical by construction, and the
    ;; pre-S1 encoder answered the same for both: 360 is an OrderedMap (its
    ;; keys come back sorted) and 363 is tag 2^64-1, which a double rounds
    ;; to 2^64 and whose 8-byte head then reads back as 0.
    (is (= [360 363] (vec bad)))))
