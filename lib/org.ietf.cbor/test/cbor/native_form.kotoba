(ns cbor.native-form (:export [main])
 (:require [cbor.form :as cbor] [cbor.value :as value] [kotoba.form :as f]))
(defn- same? [a :vector-i64 b :vector-i64] :bool
 (and (= (vector-count a) (vector-count b))
  (loop [i 0] (cond (= i (vector-count a)) true (not= (vector-at a i) (vector-at b i)) false :else (recur (+ i 1))))))
(defn- nested [depth :i64] [:ref :form/r]
 (loop [i 0 out (f/int-form 0)] (if (= i depth) out
  (recur (+ i 1) (f/form-vec (f/one-form out))))))
(defn- run [] :i64
 (let [bytes (f/bytes-form (bytes-from-vector-i64 [0 255 128]))
       binary (cbor/encode-form bytes)
       kw (cbor/encode-form (f/keyword-form :host/http))
       positive (cbor/encode-form (nested 512))
       negative (cbor/from-form-checked (nested 513))
       symbol (cbor/from-form-checked (f/symbol-form "unencoded-symbol"))
       set (cbor/from-form-checked (f/form-set (f/no-forms)))]
  (cond (not (same? binary [67 0 255 128])) 1 (not (same? kw [100 104 116 116 112])) 2
   (not= (vector-count positive) 513) 3
   (or (result-ok?-of [:result [:ref :cbor/value] :keyword] negative)
       (not= (result-error-of [:result [:ref :cbor/value] :keyword] negative :none) :cbor/depth)) 4
   (or (result-ok?-of [:result [:ref :cbor/value] :keyword] symbol)
       (not= (result-error-of [:result [:ref :cbor/value] :keyword] symbol :none) :cbor/form-kind)) 5
   (or (result-ok?-of [:result [:ref :cbor/value] :keyword] set)
       (not= (result-error-of [:result [:ref :cbor/value] :keyword] set :none) :cbor/form-kind)) 6 :else 0)))
(defn main [] :i64 (try (run) (catch :keyword reason 90)))
