(ns cbor.golden-values
  "A fixed, deterministic corpus of values for `cbor.core-golden-test`.

  `test/cbor/golden.edn` holds the hex of `(cbor/encode v)` for every value
  here, written by the host-plumbing encoder that `cbor.core` had before its
  byte plumbing became pure (org-ietf-cbor 8ddc27d, 2026-09-24,
  adr-2609242330 S1). Content addresses are computed over these bytes, so
  the test pins them: any change to the corpus below must regenerate the
  golden file from a known-good encoder, never from the one under test.

  The corpus is edge cases first (head-width boundaries, 2^32, 2^53, the i64
  bounds as a double can hold them, -0.0, subnormals, empty and 64 KiB byte
  and text strings, non-ASCII and lone surrogates, dag-cbor key order, tags,
  ordered maps) and then values drawn from a seeded linear congruential
  generator, so a run is the same on every host."
  (:require [cbor.core :as cbor]))

(defn- lcg
  "The next state of a 31-bit Park-Miller generator. Arithmetic only (no
  bit ops), exact in a double, so the sequence is the same on every host."
  [s]
  (mod (* s 48271) 2147483647))

(defn- draws
  "N pseudo-random ints in [0, 2^31-1) from SEED."
  [seed n]
  (vec (take n (rest (iterate lcg seed)))))

(defn- byte-string
  ([xs] #?(:clj (byte-array (map unchecked-byte xs))
           :cljs (js/Uint8Array.from (clj->js (vec xs)))
           :default (vec xs)))
  ([signed? xs] #?(:clj (byte-array (map unchecked-byte xs))
                   :cljs (if signed?
                           (js/Int8Array.from (clj->js (mapv #(if (> % 127) (- % 256) %) xs)))
                           (js/Uint8Array.from (clj->js (vec xs))))
                   :default (vec xs))))

(def ^:private pow2 [1 2 4 8 16 32 64 128 256 512 1024 2048 4096 8192 16384 32768
                     65536 131072 262144 524288 1048576 2097152 4194304 8388608
                     16777216 33554432 67108864 134217728 268435456 536870912
                     1073741824 2147483648 4294967296 8589934592 17179869184
                     34359738368 68719476736 137438953472 274877906944
                     549755813888 1099511627776 2199023255552 4398046511104
                     8796093022208 17592186044416 35184372088832 70368744177664
                     140737488355328 281474976710656 562949953421312
                     1125899906842624 2251799813685248 4503599627370496
                     9007199254740992])

(def edge-ints
  (vec (concat
        [0 1 23 24 25 255 256 65535 65536 4294967295 4294967296
         9007199254740991 9007199254740992 9007199254740993
         -1 -23 -24 -25 -256 -257 -65536 -65537 -4294967296 -4294967297
         -9007199254740991 -9007199254740992
         ;; the i64 bounds as literals; a double rounds them to +/-2^63
         9223372036854775807 -9223372036854775808]
        (mapcat (fn [p] [(dec p) p (inc p) (- p) (- -1 p)]) pow2))))

(def edge-floats
  [0.5 -0.5 1.5 -2.5 -0.0 0.1 1e300 -1e300 5e-324 -5e-324 2.2250738585072014E-308
   1.7976931348623157E308 -1.7976931348623157E308 3.141592653589793 1e-7 123456.789
   9007199254740993.5])

(def edge-strings
  ["" "a" "IETF" "\"\\" "ü" "水" "𐅑" "été" "日本語"
   "😀 emoji" "\ud800" "\udc00x" "x\ud800" "\ud800\ud800" "􏿿" "\u0000" "\u007f\u0080"
   "߿ࠀ" "￿" (apply str (repeat 23 "a")) (apply str (repeat 24 "b"))
   (apply str (repeat 255 "c")) (apply str (repeat 256 "d")) (apply str (repeat 70000 "e"))
   (apply str (repeat 1000 "é水😀"))])

(defn edge-bytes []
  [(byte-string []) (byte-string [0]) (byte-string (range 23)) (byte-string (range 24))
   (byte-string (map #(mod % 256) (range 256))) (byte-string (map #(mod % 256) (range 65536)))
   (byte-string [255 254 128 127 0]) (byte-string true [255 254 128 127 0 1])])

(defn edge-structures []
  [nil true false [] {} [nil true false] [[[]]] {"a" 1} {:a 1 :b [1 2]}
   {"aa" 1 "b" 2 "a" 3 "ab" 4 "" 5} {1 "one" 10 "ten" 2 "two"}
   {:z {:y {:x [1 2.5 "s"]}}}
   (cbor/ordered [["z" 1] ["a" 2] [:m (cbor/ordered [["y" 1] ["b" 2]])]])
   (cbor/tagged 42 (byte-string [0 1 113 18 32]))
   (cbor/tagged 0 "2013-03-21T20:04:00Z")
   (cbor/tagged 18446744073709551615 1)
   (cbor/tagged 1 [(cbor/tagged 2 {"k" nil})])
   (vec (range 300))
   (into {} (map (fn [i] [(str "k" i) i]) (range 40)))])

(defn- random-value
  "A value built from draws D starting at index I; answers [value next-i]."
  [d i depth]
  (let [r (nth d (mod i (count d)))
        i (inc i)
        kind (mod r (if (< depth 3) 9 6))]
    (case kind
      0 [(- (mod r 100000) 50000) i]
      1 [(* (nth d (mod i (count d))) (inc (mod r 4194304))) (inc i)]
      2 [(- -1 (* (nth d (mod i (count d))) (inc (mod r 4194304)))) (inc i)]
      3 [(/ (double (- r 1073741823)) (inc (nth d (mod i (count d))))) (inc i)]
      4 [(apply str (map #(char (+ 32 (mod % 95))) (take (mod r 40) (drop i d)))) (+ i (mod r 40))]
      5 [(byte-string (map #(mod % 256) (take (mod r 60) (drop i d)))) (+ i (mod r 60))]
      6 (loop [n (mod r 6) i i acc []]
          (if (zero? n) [acc i]
              (let [[v i] (random-value d i (inc depth))] (recur (dec n) i (conj acc v)))))
      7 (loop [n (mod r 6) i i acc {}]
          (if (zero? n) [acc i]
              (let [k (str (char (+ 97 (mod (nth d (mod i (count d))) 26))) (mod (nth d (mod (inc i) (count d))) 7))
                    [v i] (random-value d (+ i 2) (inc depth))]
                (recur (dec n) i (assoc acc k v)))))
      8 (let [[v i] (random-value d i (inc depth))] [(cbor/tagged (mod r 1000) v) i]))))

(defn random-values [n]
  (let [d (draws 20260924 4096)]
    (loop [k 0 i 0 acc []]
      (if (= k n) acc
          (let [[v i] (random-value d i 0)] (recur (inc k) i (conj acc v)))))))

(defn corpus
  "Every value in order. Non-finite floats are not here: `encode` refuses
  them, and `cbor.core-test` pins that refusal."
  []
  (vec (concat edge-ints edge-floats edge-strings (edge-bytes) (edge-structures)
               (random-values 2000))))
