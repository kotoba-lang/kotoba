;; Read the unmodified frozen bytes with the canonical native repository reader.
;; This covers decoder/re-encoder parity, separately from source-value encoding.
(ns cbor.native-golden-roundtrip (:export [main])
 (:require [kotoba.form :as f] [kotoba.compiler.kotoba-reader :as reader]
           [cbor.codec :as codec] [cbor.value :as value] [multiformats.cid :as cid]))
(defn- same? [a :vector-i64 b :vector-i64] :bool
 (and (= (vector-count a) (vector-count b))
  (loop [i 0] (cond (= i (vector-count a)) true (not= (vector-at a i) (vector-at b i)) false :else (recur (+ i 1))))))
(defn- check [hex :string index :i64] :i64
 (try
  (if (not (cid/hex-valid? hex)) 1
   (let [bytes (cid/hex->bytes hex) decoded (codec/decode bytes) encoded (codec/encode decoded)]
    (if (= index 360)
     ;; OrderedMap decoding intentionally returns a canonical map. Pin both
     ;; the original noncanonical order and the independently stated result.
     (let [expected (cid/hex->bytes "a3616102616da2616202617901617a01")]
      (if (and (not (same? bytes encoded)) (same? encoded expected)) 0 2))
     (if (= index 363)
      ;; Historical double-rounded tag 2^64 was written as an overwide zero.
      ;; Preserve this frozen input and pin its minimal canonical tag-zero form.
      (if (and (same? bytes (cid/hex->bytes "db000000000000000001"))
               (same? encoded (cid/hex->bytes "c001"))) 0 5)
      (if (same? bytes encoded) 0 3)))))
  (catch :keyword error 4)))
(defn- run [] :i64
 (let [path (typed-cap-call :cli/args :string :string "0")
       text (typed-cap-call :fs/app-data :string :string path)
       parsed (reader/read-forms-bounded text 512 524288)
       error (record-get [:ref :kotoba.reader/out] parsed :err)
       forms (record-get [:ref :kotoba.reader/out] parsed :forms)]
  (cond (not (string=? error "")) 5 (not= (vector-count forms) 1) 6
   :else (let [golden (typed-list-nth [:list [:ref :form/r]] forms 0)]
    (if (not= (f/count-of golden) 2367) 7
     (loop [i 0]
      (if (= i 2367)
       (let [p (typed-cap-call :io/write :string :string "PASS_NATIVE_CBOR_ALL_2367_FROZEN_DECODE_REENCODE_ORDERED360_ROUNDEDTAG363_CLASSIFIED\n")] 0)
       (let [result (arena-scope (check (f/string-value (f/nth-of golden i)) i))]
        (if (= result 0) (recur (+ i 1))
         (let [p (typed-cap-call :io/write :string :string (string-concat "golden-failed "
          (string-concat (string-from-i64 i) (string-concat " code " (string-concat (string-from-i64 result) "\n")))))] 8))))))))))
(defn main [] :i64 (run))
