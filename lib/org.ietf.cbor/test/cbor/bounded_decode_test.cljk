(ns cbor.bounded-decode-test
  (:require #?(:clj [clojure.test :refer [deftest is]]
               :cljs [cljs.test :refer [deftest is] :include-macros true])
            [cbor.core :as cbor]))

(defn bytes-of [xs]
  #?(:clj (byte-array (map unchecked-byte xs))
     :cljs (js/Uint8Array. (clj->js xs))))
(defn length-of [x] #?(:clj (alength ^bytes x) :cljs (.-length x)))
(defn kind [f] (try (f) nil (catch #?(:clj Exception :cljs :default) e (:type (ex-data e)))))
(def defaults {:max-bytes 16384 :max-depth 32 :max-items 1000})

(deftest supported-values-remain-identical
  (doseq [v [nil true false 0 -3 123456 "text" [] [1 [2]] {"a" [1 true nil]}]]
    (let [b (cbor/encode v)]
      (is (= v (cbor/decode b) (cbor/decode-bounded b defaults))))))

(deftest exact-limits-count-container-keys-and-values
  (let [v {"a" [1 true nil]} b (cbor/encode v)]
    ;; root map, key, array and three children = six items; deepest = two.
    (is (= v (cbor/decode-bounded b {:max-bytes (length-of b) :max-depth 2 :max-items 6})))
    (is (= :cbor/resource-limit (kind #(cbor/decode-bounded b {:max-bytes (dec (length-of b)) :max-depth 2 :max-items 6}))))
    (is (= :cbor/resource-limit (kind #(cbor/decode-bounded b {:max-bytes 100 :max-depth 1 :max-items 6}))))
    (is (= :cbor/resource-limit (kind #(cbor/decode-bounded b {:max-bytes 100 :max-depth 2 :max-items 5})))))
  (is (= [] (cbor/decode-bounded (cbor/encode []) {:max-bytes 1 :max-depth 0 :max-items 1})))
  (is (= :cbor/resource-limit (kind #(cbor/decode-bounded (cbor/encode [0]) {:max-bytes 2 :max-depth 0 :max-items 2}))))
  (is (= :cbor/resource-limit (kind #(cbor/decode-bounded (cbor/encode (cbor/tagged 42 0)) {:max-bytes 8 :max-depth 0 :max-items 2})))))

(deftest rejects-adversarial-nesting-and-collection-claims
  (let [deep (bytes-of (concat (repeat 10000 0x81) [0xf6]))
        huge-array (bytes-of [0x9a 0xff 0xff 0xff 0xff])
        huge-map (bytes-of [0xba 0xff 0xff 0xff 0xff])]
    (is (= :cbor/resource-limit (kind #(cbor/decode-bounded deep defaults))))
    (is (= :cbor/resource-limit (kind #(cbor/decode-bounded huge-array defaults))))
    (is (= :cbor/resource-limit (kind #(cbor/decode-bounded huge-map defaults)))))
  (doseq [limits [{} (assoc defaults :max-depth 65) (assoc defaults :max-items 0)
                  (assoc defaults :max-bytes 16777217) (assoc defaults :extra 1)]]
    (is (= :cbor/invalid-limit (kind #(cbor/decode-bounded (cbor/encode 1) limits)))))
  (is (thrown? #?(:clj Exception :cljs js/Error) (cbor/decode-bounded (bytes-of [0x82 0x01]) defaults)))
  (is (thrown? #?(:clj Exception :cljs js/Error) (cbor/decode-bounded (bytes-of [0x01 0x02]) defaults))))
