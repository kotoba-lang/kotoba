(ns cbor.native-codec (:export [main]) (:require [cbor.core :as c] [cbor.value :as v]))
(defn- same? [a :vector-i64 b :vector-i64] :bool
 (and (= (vector-count a) (vector-count b))
  (loop [i 0] (cond (= i (vector-count a)) true (not= (vector-at a i) (vector-at b i)) false :else (recur (+ i 1))))))
(defn- one [value [:ref :cbor/value]] [:list [:ref :cbor/value]]
 (typed-list-conj [:list [:ref :cbor/value]] (typed-list-new [:list [:ref :cbor/value]]) value))
(defn- pair [a [:ref :cbor/value] b [:ref :cbor/value]] [:list [:ref :cbor/value]]
 (typed-list-conj [:list [:ref :cbor/value]] (one a) b))
(defn- roundtrip [bytes :vector-i64] :bool (same? (c/encode (c/decode bytes)) bytes))
(defn- error? [bytes :vector-i64 wanted :keyword] :bool
 (let [r (c/decode-checked bytes)]
  (and (not (result-ok?-of [:result [:ref :cbor/value] :keyword] r))
   (= (result-error-of [:result [:ref :cbor/value] :keyword] r :none) wanted))))
(defn- fragment-tests [] :bool
 (and (same? (c/encode-null) [246]) (same? (c/encode-bool true) [245])
  (same? (c/encode-uint 23) [23]) (same? (c/encode-uint 24) [24 24])
  (same? (c/encode-uint 256) [25 1 0]) (same? (c/encode-uint 65536) [26 0 1 0 0])
  (same? (c/encode-uint 4294967296) [27 0 0 0 1 0 0 0 0])
  (same? (c/encode-int -9223372036854775808) [59 127 255 255 255 255 255 255 255])
  (same? (c/encode-int 9223372036854775807) [27 127 255 255 255 255 255 255 255])
  (same? (c/encode-text "水") [99 230 176 180]) (same? (c/encode-bytes [255 0]) [66 255 0])
  (same? (c/encode-f64 1.5) [251 63 248 0 0 0 0 0 0])))
(defn- generic-tests [] :bool
 (let [pairs (typed-list-conj [:list [:ref :cbor/value]]
       (typed-list-conj [:list [:ref :cbor/value]] (pair (v/text-value "z") (v/int-value 1)) (v/text-value "a")) (v/int-value 2))]
  (and (same? (c/encode (v/map-value pairs)) [162 97 97 2 97 122 1])
       (same? (c/encode-ordered pairs) [162 97 122 1 97 97 2])
       (roundtrip [216 42 69 0 1 113 18 32])
       (roundtrip [27 255 255 255 255 255 255 255 255])
       (roundtrip [59 255 255 255 255 255 255 255 255])
       (roundtrip [219 255 255 255 255 255 255 255 255 1])
       (roundtrip [251 128 0 0 0 0 0 0 0])
       (same? (c/encode (c/decode [24 0])) [0])
       (same? (c/encode (c/decode [162 97 97 1 97 97 2])) [161 97 97 2])
       (c/tagged? (c/tagged 42 (v/int-value 1)))
       (= (c/tag-number (c/tagged -1 (v/int-value 1))) -1)
       (= (v/number (c/tag-value (c/tagged 42 (v/int-value 7)))) 7)
       (not (c/tagged? (v/int-value 1))))))
(defn- refusal-tests [] :bool
 (and (error? [] :cbor/eof) (error? [24] :cbor/eof) (error? [98 97] :cbor/eof)
  (error? [159] :cbor/indefinite) (error? [247] :cbor/simple) (error? [249 0 0] :cbor/simple)
  (error? [0 0] :cbor/trailing) (error? [256] :cbor/byte)
  (error? [98 192 128] :cbor/utf8) (error? [99 237 160 128] :cbor/utf8)
  (error? [251 127 240 0 0 0 0 0 0] :cbor/non-finite)
  (try (do (c/encode-uint -1) false) (catch :keyword e (= e :cbor/negative-uint)))
  (try (do (c/encode-nint 0) false) (catch :keyword e (= e :cbor/nonnegative-nint)))
  (try (do (c/encode-tag -1 [0]) false) (catch :keyword e (= e :cbor/negative-tag)))
  (try (do (c/encode-bytes [256]) false) (catch :keyword e (= e :cbor/byte)))
  (try (do (c/tag-number (v/int-value 1)) false) (catch :keyword e (= e :cbor/not-tag)))
  (try (do (c/tag-value (v/int-value 1)) false) (catch :keyword e (= e :cbor/not-tag)))))
(defn- depth-value [count :i64] [:ref :cbor/value]
 (loop [i 0 value (v/null-value)]
  (if (= i count) value (recur (+ i 1) (v/array-value (one value))))))
(defn- depth-tests [] :bool
 (let [positive (c/encode (depth-value 512)) negative (c/encode-checked (depth-value 513))]
  (and (roundtrip positive) (not (result-ok?-of [:result :vector-i64 :keyword] negative))
   (= (result-error-of [:result :vector-i64 :keyword] negative :none) :cbor/depth))))
(defn main [] :i64
 (try (cond (not (fragment-tests)) 1 (not (generic-tests)) 2 (not (refusal-tests)) 3
             (not (depth-tests)) 4 :else 0)
  (catch :keyword error 10)))
