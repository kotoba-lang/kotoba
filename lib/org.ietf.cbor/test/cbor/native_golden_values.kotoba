;; Native transcription of the entire original 2367-value corpus. PRNG state,
;; recursive shape, truncating drop/take and map replacement stay explicit.
(ns cbor.native-golden-values (:export [edge random-value draws])
 (:require [cbor.value :as v])
 (:schemas {:cbor/golden-draw [:record :cbor/golden-draw [[:value [:ref :cbor/value]] [:next :i64]]]}))
(defn- empty [] [:list [:ref :cbor/value]] (typed-list-new [:list [:ref :cbor/value]]))
(defn- add [xs [:list [:ref :cbor/value]] x [:ref :cbor/value]] [:list [:ref :cbor/value]]
 (typed-list-conj [:list [:ref :cbor/value]] xs x))
(defn- one [a [:ref :cbor/value]] [:ref :cbor/value] (v/array-value (add (empty) a)))
(defn- two [a [:ref :cbor/value] b [:ref :cbor/value]] [:ref :cbor/value] (v/array-value (add (add (empty) a) b)))
(defn- three [a [:ref :cbor/value] b [:ref :cbor/value] c [:ref :cbor/value]] [:ref :cbor/value]
 (v/array-value (add (add (add (empty) a) b) c)))
(defn- map1 [a [:ref :cbor/value] b [:ref :cbor/value]] [:ref :cbor/value] (v/map-value (add (add (empty) a) b)))
(defn- map-put [pairs [:list [:ref :cbor/value]] key [:ref :cbor/value] val [:ref :cbor/value]] [:list [:ref :cbor/value]]
 (loop [i 0 found false out (empty)]
  (if (= i (vector-count pairs)) (if found out (add (add out key) val))
   (let [old (typed-list-nth [:list [:ref :cbor/value]] pairs i) same (string=? (v/text old) (v/text key))]
    (recur (+ i 2) (or found same) (add (add out old) (if same val (typed-list-nth [:list [:ref :cbor/value]] pairs (+ i 1)))))))))
(defn- repeat-text [text :string count :i64] :string
 (loop [n count power text out ""]
  (if (= n 0) out (let [next (quot n 2)]
   (recur next (if (= next 0) power (string-concat power power))
    (if (= (bit-and n 1) 1) (string-concat out power) out))))))
(defn- bytes-range [count :i64] :vector-i64
 (loop [i 0 out (vector-i64)] (if (= i count) out (recur (+ i 1) (vector-conj out (mod i 256))))))
(defn- edge-int [i :i64] [:ref :cbor/value]
 (if (< i 28)
  (v/int-value (vector-at [0 1 23 24 25 255 256 65535 65536 4294967295 4294967296
   9007199254740991 9007199254740992 9007199254740993 -1 -23 -24 -25 -256 -257 -65536 -65537
   -4294967296 -4294967297 -9007199254740991 -9007199254740992 9223372036854775807 -9223372036854775808] i))
  (let [index (- i 28) p (i64-shift-left 1 (quot index 5)) which (mod index 5)]
   (v/int-value (case which 0 (- p 1) 1 p 2 (+ p 1) 3 (- 0 p) (- -1 p))))))
(defn- edge-float [i :i64] [:ref :cbor/value]
 (v/f64-bits (case i
  0 (f64-to-bits 0.5) 1 (f64-to-bits -0.5) 2 (f64-to-bits 1.5) 3 (f64-to-bits -2.5)
  4 -9223372036854775808 5 (f64-to-bits 0.1) 6 0x7e37e43c8800759c 7 (bit-or -9223372036854775808 0x7e37e43c8800759c)
  8 1 9 -9223372036854775807 10 4503599627370496
  11 9218868437227405311 12 -4503599627370497 13 0x400921fb54442d18
  14 0x3e7ad7f29abcaf48 15 0x40fe240c9fbe76c9 0x4340000000000001)))
(defn- edge-string [i :i64] [:ref :cbor/value]
 (v/text-value (case i 0 "" 1 "a" 2 "IETF" 3 "\"\\" 4 "ü" 5 "水" 6 "𐅑" 7 "été" 8 "日本語"
  9 "😀 emoji"
  ;; A canonical native string cannot contain a lone UTF-16 surrogate. The
  ;; historical corpus's four inputs produced these replacement UTF-8 bytes.
  10 "�" 11 "�x" 12 "x�" 13 "��" 14 "􏿿" 15 "\u0000" 16 "\u007f\u0080" 17 "߿ࠀ" 18 "￿"
  19 (repeat-text "a" 23) 20 (repeat-text "b" 24) 21 (repeat-text "c" 255) 22 (repeat-text "d" 256)
  23 (repeat-text "e" 70000) (repeat-text "é水😀" 1000))))
(defn- edge-bytes [i :i64] [:ref :cbor/value]
 (v/bytes-value (case i 0 [] 1 [0] 2 (bytes-range 23) 3 (bytes-range 24) 4 (bytes-range 256)
  5 (bytes-range 65536) 6 [255 254 128 127 0] [255 254 128 127 0 1])))
(defn- edge-structure [i :i64] [:ref :cbor/value]
 (case i
  0 (v/null-value) 1 (v/bool-value true) 2 (v/bool-value false) 3 (v/array-value (empty)) 4 (v/map-value (empty))
  5 (three (v/null-value) (v/bool-value true) (v/bool-value false)) 6 (one (one (v/array-value (empty))))
  7 (map1 (v/text-value "a") (v/int-value 1))
  8 (v/map-value (add (add (add (add (empty) (v/text-value "a")) (v/int-value 1)) (v/text-value "b")) (two (v/int-value 1) (v/int-value 2))))
  9 (v/map-value (loop [j 0 out (empty)] (if (= j 5) out
      (let [keys "aa b a ab "]
       (recur (+ j 1) (add (add out (v/text-value (case j 0 "aa" 1 "b" 2 "a" 3 "ab" ""))) (v/int-value (+ j 1))))))))
  10 (v/map-value (add (add (add (add (add (add (empty) (v/int-value 1)) (v/text-value "one")) (v/int-value 10))
    (v/text-value "ten")) (v/int-value 2)) (v/text-value "two")))
  11 (map1 (v/text-value "z") (map1 (v/text-value "y") (map1 (v/text-value "x")
    (three (v/int-value 1) (v/f64-bits (f64-to-bits 2.5)) (v/text-value "s")))))
  12 (let [inner (v/ordered (add (add (add (add (empty) (v/text-value "y")) (v/int-value 1)) (v/text-value "b")) (v/int-value 2)))
           pairs (add (add (add (add (empty) (v/text-value "z")) (v/int-value 1)) (v/text-value "a")) (v/int-value 2))]
       (v/ordered (add (add pairs (v/text-value "m")) inner)))
  13 (v/tagged 42 (v/bytes-value [0 1 113 18 32])) 14 (v/tagged 0 (v/text-value "2013-03-21T20:04:00Z"))
  15 (v/tagged -1 (v/int-value 1)) 16 (v/tagged 1 (one (v/tagged 2 (map1 (v/text-value "k") (v/null-value)))))
  17 (v/array-value (loop [j 0 out (empty)] (if (= j 300) out (recur (+ j 1) (add out (v/int-value j))))))
  (v/map-value (loop [j 0 out (empty)] (if (= j 40) out
   (recur (+ j 1) (add (add out (v/text-value (string-concat "k" (string-from-i64 j)))) (v/int-value j))))))))
(defn edge [index :i64] [:ref :cbor/value]
 (cond (< index 298) (edge-int index) (< index 315) (edge-float (- index 298))
  (< index 340) (edge-string (- index 315)) (< index 348) (edge-bytes (- index 340)) :else (edge-structure (- index 348))))
(defn draws [] :vector-i64
 (loop [i 0 s 20260924 out (vector-i64)] (if (= i 4096) out
  (let [next (mod (* s 48271) 2147483647)] (recur (+ i 1) next (vector-conj out next))))))
(defn- at [d :vector-i64 i :i64] :i64 (vector-at d (mod i (vector-count d))))
(defn- result [value [:ref :cbor/value] next :i64] [:ref :cbor/golden-draw] (record-new [:ref :cbor/golden-draw] value next))
(defn random-value [d :vector-i64 index :i64 depth :i64] [:ref :cbor/golden-draw]
 (let [r (at d index) i (+ index 1) kind (mod r (if (< depth 3) 9 6))]
  (case kind
   0 (result (v/int-value (- (mod r 100000) 50000)) i)
   1 (result (v/int-value (* (at d i) (+ 1 (mod r 4194304)))) (+ i 1))
   2 (result (v/int-value (- -1 (* (at d i) (+ 1 (mod r 4194304))))) (+ i 1))
   3 (result (v/f64-bits (f64-to-bits (f64-div (i64-to-f64-rounded (- r 1073741823))
          (i64-to-f64-rounded (+ 1 (at d i)))))) (+ i 1))
   4 (let [count (mod r 40) data (loop [j 0 out (vector-i64)]
       (if (or (= j count) (>= (+ i j) (vector-count d))) out
        (recur (+ j 1) (vector-conj out (+ 32 (mod (vector-at d (+ i j)) 95))))))]
      (result (v/text-value (string-from-utf8 (bytes-from-vector-i64 data))) (+ i count)))
   5 (let [count (mod r 60) data (loop [j 0 out (vector-i64)]
       (if (or (= j count) (>= (+ i j) (vector-count d))) out
        (recur (+ j 1) (vector-conj out (mod (vector-at d (+ i j)) 256)))))]
      (result (v/bytes-value data) (+ i count)))
   6 (loop [remaining (mod r 6) j i out (empty)]
       (if (= remaining 0) (result (v/array-value out) j)
        (let [next (random-value d j (+ depth 1))]
         (recur (- remaining 1) (record-get [:ref :cbor/golden-draw] next :next)
          (add out (record-get [:ref :cbor/golden-draw] next :value))))))
   7 (loop [remaining (mod r 6) j i out (empty)]
       (if (= remaining 0) (result (v/map-value out) j)
        (let [letter (mod (at d j) 26) key (v/text-value (string-concat (string-substring "abcdefghijklmnopqrstuvwxyz" letter (+ letter 1))
              (string-from-i64 (mod (at d (+ j 1)) 7))))
              next (random-value d (+ j 2) (+ depth 1))]
         (recur (- remaining 1) (record-get [:ref :cbor/golden-draw] next :next)
          (map-put out key (record-get [:ref :cbor/golden-draw] next :value))))))
   (let [next (random-value d i (+ depth 1))]
    (result (v/tagged (mod r 1000) (record-get [:ref :cbor/golden-draw] next :value))
     (record-get [:ref :cbor/golden-draw] next :next))))))
