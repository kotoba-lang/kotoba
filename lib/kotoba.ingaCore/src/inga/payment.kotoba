;; Port of inga.payment (payment.cljk), Kotoba-native, :document maps.
;;
;; Named divergences from payment.cljk:
;;   - reserve-verdict takes a :document request map; a missing or non-i64 field
;;     is read as -1, which fails the valid-micros? check, the same verdict the
;;     source reaches for nil (its integer? guard).
;;   - valid-micros? takes an :i64 (the source accepts any value; non-integers
;;     are not representable here).
;;   - the clojure.spec s/fdef is dropped (no spec in Kotoba); the verdict is unchanged.
;;   - max-safe-micros is a zero-arg fn (def cannot be exported).

(ns inga.payment
  (:export [max-safe-micros valid-micros? reserve-verdict]))

(defn max-safe-micros [] :i64 9007199254740991)

(defn valid-micros? [n :i64] :bool
  (and (<= 0 n) (<= n (max-safe-micros))))

(defn- deny [reason :keyword] :document
  (document-map :allow? (document-bool false) :reason (document-keyword reason)))

(defn- field [req :document k :keyword] :i64
  (option-or (document-i64-value (option-or (document-get req k) (document-null))) -1))

(defn reserve-verdict [req :document] :document
  (let [paid (field req :paid-micros)
        consumed (field req :consumed-micros)
        price (field req :price-micros)]
    (if (not (valid-micros? paid))
      (deny :invalid-paid-micros)
      (if (not (valid-micros? consumed))
        (deny :invalid-consumed-micros)
        (if (or (not (valid-micros? price)) (= price 0))
          (deny :invalid-price-micros)
          (if (> consumed paid)
            (deny :invalid-consumed-state)
            (if (> price (- paid consumed))
              (document-map :allow? (document-bool false) :reason (document-keyword :insufficient-balance)
                            :paid-micros (document-i64 paid) :consumed-micros (document-i64 consumed))
              (document-map :allow? (document-bool true) :reason (document-keyword :reserved)
                            :paid-micros (document-i64 paid)
                            :previous-consumed-micros (document-i64 consumed)
                            :consumed-micros (document-i64 (+ consumed price))
                            :remaining-micros (document-i64 (- (- paid consumed) price))))))))))
