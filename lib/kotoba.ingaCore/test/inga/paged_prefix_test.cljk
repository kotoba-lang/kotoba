(ns inga.paged-prefix-test
  (:require [kotoba.test :refer [deftest is]]
            [inga.attest :as att]
            [inga.consensus :as c]
            [inga.paged-prefix :as paged]
            [inga.prefix :as prefix]
            [inga.reservation-test :as fixture]
            [inga-node.seams :as seams]))

(defn bundle [proof width]
  (let [blocks (:blocks proof)
        h (- (count blocks) 3)
        archived (subvec blocks 0 (inc h))]
    {:pages (vec (for [from (range 0 (count archived) width)
                       :let [bs (subvec archived from (min (count archived) (+ from width)))]]
                   {:chain-id fixture/chain-id :from from
                    :to (+ from (dec (count bs))) :blocks bs}))
     :checkpoint {:chain-id fixture/chain-id :committed-height h
                  :blocks (subvec blocks h) :tip-qc (:tip-qc proof)}}))

(defn verify [{:keys [pages checkpoint]} context]
  (paged/finish (reduce paged/append-page (paged/begin context) pages) checkpoint))

(deftest paged-proof-matches-bounded-complete-prefix
  (let [proof (fixture/proof [[fixture/a] [] [] [] [] [] []])]
    (doseq [width [1 2 3 4 128]]
      (let [b (bundle proof width)
            expected (prefix/verify proof fixture/context)
            actual (verify b fixture/context)]
        (is (= :finalized (:status actual)))
        (is (= (:height expected) (:height actual)))
        (is (= (:tip-hash expected) (:tip-hash actual)))
        (is (= (count (:pages b)) (:pages actual)))))))

(deftest missing-repeated-mutated-and-wrong-checkpoint-refuse
  (let [b (bundle (fixture/proof [[fixture/a] [] [] [] [] [] [] []]) 2)
        pages (:pages b)
        cp (:checkpoint b)]
    (is (= :finalized (:status (verify b fixture/context))))
    (is (= :rejected (:status (verify (assoc b :pages (vec (rest pages))) fixture/context))))
    (is (= :rejected (:status (verify (assoc b :pages (vec (concat [(first pages)] pages)))
                                     fixture/context))))
    (is (= :rejected (:status (verify (assoc-in b [:pages 1 :blocks 0 :inga.block/ts] 999)
                                     fixture/context))))
    (is (= :rejected (:status (verify (assoc-in b [:pages 1 :blocks 0 :inga.block/justify
                                                  :inga.qc/sigs "w1"] "bad")
                                     fixture/context))))
    (is (= :rejected (:status (verify (assoc b :checkpoint
                                             (assoc cp :committed-height (dec (:committed-height cp))))
                                     fixture/context))))
    (is (= :rejected (:status (verify (assoc-in b [:checkpoint :tip-qc
                                                  :inga.qc/sigs "w1"] "bad")
                                     fixture/context))))
    (is (= :rejected (:status (verify b (assoc fixture/context :chain-id "other")))))
    (is (= :rejected (:status (verify (assoc-in b [:pages 0 :blocks 0]
                                             (assoc fixture/genesis :inga.block/ts 1))
                                     fixture/context))))))

(defn fake-qc [block]
  ;; This cheap seam tests the >8192 state/boundary path. The tests above use
  ;; real Ed25519 signatures for cryptographic behavior.
  (let [h (:inga.block/height block)
        votes (mapv (fn [w]
                      (att/sign-vote (c/make-vote w (seams/hash-fn block) h)
                                     fixture/chain-id h (fn [_] "synthetic")))
                    (take 3 fixture/witnesses))]
    (att/certify (c/qc votes 4 h) votes)))

(deftest more-than-8192-blocks-need-only-bounded-page-state
  (let [h 8200
        blocks (reduce (fn [bs height]
                         (let [parent (peek bs)]
                           (conj bs (assoc (c/make-block
                                            {:height height
                                             :parent-hash (seams/hash-fn parent)
                                             :proposals []
                                             :proposer (c/led-by fixture/witnesses height)
                                             :ts height
                                             :justify (fake-qc parent)})
                                           :inga.block/round height))))
                       [fixture/genesis] (range 1 (+ h 3)))
        proof {:blocks blocks :tip-qc (fake-qc (peek blocks))}
        b (bundle proof 128)
        context (assoc fixture/context :verify-fn (fn [_ _ _] true))
        after-pages (reduce paged/append-page (paged/begin context) (:pages b))
        result (paged/finish after-pages (:checkpoint b))]
    (is (= 65 (count (:pages b))))
    (is (= :collecting (:status after-pages)))
    (is (<= (count (:pending after-pages)) 2))
    (is (= 8201 (:next-height after-pages)))
    (is (= :finalized (:status result)))
    (is (= h (:height result)))))
