(ns inga.sync-proof-test
  (:require [kotoba.test :refer [deftest is]]
            [inga.consensus :as c]
            [inga.replica :as r]))

(def witnesses ["w1" "w2" "w3" "w4"])
(defn- hash-fn [block] (str "h:" (c/canonical-block block)))
(defn- witness [id]
  (r/replica {:witness id :witnesses witnesses
              :quorum (c/quorum-size 4) :hash-fn hash-fn}))

(defn- qc-for [block view]
  {:inga.qc/block-hash (hash-fn block)
   :inga.qc/height (:inga.block/height block)
   :inga.qc/witnesses #{"w1" "w2" "w3"}
   :inga.qc/vote-count 3
   :inga.qc/view view})

(deftest sync-imports-the-verified-parent-certificates
  (let [leader (c/leader-for witnesses 1)
        [started _] (r/start (r/submit (witness leader) "synthetic-record") 1000)
        b1 (r/tip started)
        b2 (c/make-block {:height 2 :parent-hash (hash-fn b1)
                          :proposals [] :proposer (c/leader-for witnesses 2)
                          :round 2 :ts (+ 100 (:inga.block/ts b1))
                          :justify (qc-for b1 1)})
        b3 (c/make-block {:height 3 :parent-hash (hash-fn b2)
                          :proposals [] :proposer (c/leader-for witnesses 3)
                          :round 3 :ts (+ 100 (:inga.block/ts b2))
                          :justify (qc-for b2 2)})
        [caught _] (r/on-message (witness "w1")
                                 {:type :sync-response :blocks [b1 b2 b3]} 2000)]
    (is (= 3 (r/height caught)) (pr-str (:last-sync caught)))
    (is (= 3 (get-in caught [:last-sync :adopted])))
    (is (= (qc-for b1 1) (get-in caught [:qcs (hash-fn b1)]))
        "a restarted witness must retain the QC for a synced record block")
    (is (= (qc-for b2 2) (get-in caught [:qcs (hash-fn b2)])))
    (is (= (hash-fn b1) (hash-fn (peek (:committed caught))))
        "the newly committed record and its certificate arrive together")))
