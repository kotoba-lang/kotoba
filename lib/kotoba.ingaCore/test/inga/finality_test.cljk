(ns inga.finality-test
  (:require [kotoba.test :refer [deftest is]]
            [inga.consensus :as c]
            [inga.replica :as r]))

(def witnesses ["w1" "w2" "w3" "w4"])

(defn- hash-fn [block]
  (str "h:" (c/canonical-block block)))

(deftest a-finalized-height-cannot-acquire-a-competing-vote
  (let [leader (c/leader-for witnesses 1)
        s (r/replica {:witness leader :witnesses witnesses
                      :quorum (c/quorum-size 4) :hash-fn hash-fn})
        [started _] (r/start s 1000)
        finalized (r/tip started)
        h (:inga.block/height finalized)
        rival (assoc finalized :inga.block/ts (inc (:inga.block/ts finalized)))
        rival-hash (hash-fn rival)
        ;; Model a block that the three-chain transition has finalized.
        final-state (-> started
                        (assoc :committed [finalized])
                        (assoc-in [:pm :view] (+ 100 (r/voted-view started))))
        [after-proposal emitted] (r/on-message final-state
                                               {:type :proposal :block rival} 4000)
        [after-vote vote-out] (r/on-message final-state
                                           {:type :vote :witness "w3"
                                            :height h :view 400
                                            :block-hash rival-hash} 4001)]
    (is (= 1 h))
    (is (not= (hash-fn finalized) rival-hash))
    (is (= :conflicts-with-committed
           (get-in after-proposal [:last-proposal :outcome]))
        "the proposal is refused for finality, before a later-view re-vote")
    (is (empty? emitted))
    (is (empty? vote-out))
    (is (= 1 (get-in after-vote [:dropped-votes :conflicts-with-committed])))
    (is (nil? (get-in after-vote [:votes rival-hash])))))

(deftest an-unfinalized-height-still-accepts-a-later-view-rival
  (let [leader (c/leader-for witnesses 1)
        s (r/replica {:witness leader :witnesses witnesses
                      :quorum (c/quorum-size 4) :hash-fn hash-fn})
        [started _] (r/start s 1000)
        rival (update (r/tip started) :inga.block/ts inc)
        ahead (assoc-in started [:pm :view] (+ 100 (r/voted-view started)))
        [after emitted] (r/on-message ahead {:type :proposal :block rival} 4000)]
    (is (= -1 (r/committed-height started)))
    (is (= :voted (get-in after [:last-proposal :outcome])))
    (is (some #(= :vote (:type (:msg %))) emitted)
        "the finality guard must leave higher-view recovery available")))
