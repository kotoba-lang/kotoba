(ns inga.payment-test (:export [main]) (:require [inga.payment :as p]))

(defn- deny-doc [reason :keyword] :document
  (document-map :allow? (document-bool false) :reason (document-keyword reason)))

(defn- same [a :document b :document] :bool
  (string=? (document-edn-print a) (document-edn-print b)))

(defn- req [paid :i64 consumed :i64 price :i64] :document
  (document-map :paid-micros (document-i64 paid) :consumed-micros (document-i64 consumed)
                :price-micros (document-i64 price)))

(defn main [] :i64
  (let [ok1 (p/reserve-verdict (req 1000 0 300))
        exact (p/reserve-verdict (req 1000 700 300))
        short (p/reserve-verdict (req 1000 800 300))
        neg (p/reserve-verdict (req -1 0 1))
        over (p/reserve-verdict (req 1000 1001 1))
        zero (p/reserve-verdict (req 1000 0 0))
        missing (p/reserve-verdict (document-map :paid-micros (document-i64 5) :consumed-micros (document-i64 0)))
        big (p/reserve-verdict (req 9007199254740991 0 9007199254740991))
        exp-ok1 (document-map :allow? (document-bool true) :reason (document-keyword :reserved)
                              :paid-micros (document-i64 1000) :previous-consumed-micros (document-i64 0)
                              :consumed-micros (document-i64 300) :remaining-micros (document-i64 700))
        exp-short (document-map :allow? (document-bool false) :reason (document-keyword :insufficient-balance)
                                :paid-micros (document-i64 1000) :consumed-micros (document-i64 800))]
    (+ (if (same ok1 exp-ok1) 0 1)
       (if (= (p/valid-micros? 0) true) 0 1)
       (if (p/valid-micros? (p/max-safe-micros)) 0 1)
       (if (p/valid-micros? -1) 1 0)
       (if (same short exp-short) 0 1)
       (if (same exact (document-map :allow? (document-bool true) :reason (document-keyword :reserved)
                                     :paid-micros (document-i64 1000) :previous-consumed-micros (document-i64 700)
                                     :consumed-micros (document-i64 1000) :remaining-micros (document-i64 0))) 0 1)
       (if (same neg (deny-doc :invalid-paid-micros)) 0 1)
       (if (same over (deny-doc :invalid-consumed-state)) 0 1)
       (if (same zero (deny-doc :invalid-price-micros)) 0 1)
       (if (same missing (deny-doc :invalid-price-micros)) 0 1)
       (if (same big (document-map :allow? (document-bool true) :reason (document-keyword :reserved)
                                   :paid-micros (document-i64 9007199254740991)
                                   :previous-consumed-micros (document-i64 0)
                                   :consumed-micros (document-i64 9007199254740991)
                                   :remaining-micros (document-i64 0))) 0 1))))
